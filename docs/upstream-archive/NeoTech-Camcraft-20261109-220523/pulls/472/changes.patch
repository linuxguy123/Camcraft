From 9d9ac93dd3ca5a37a6319763e3d58cc764e14c56 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mikekinney@Mikes-MacBook-Pro.local>
Date: Sun, 8 Nov 2026 19:57:31 -0800
Subject: [PATCH] fix(post): judge the tool-number clash per machine, not over
 the whole program

Two setups on different machines are two tool tables: the same T number
on each now posts as two files. Within one machine (even across two
posts) a shared number still refuses by name, prefixed with the mount.
A single-machine program refuses with the unchanged #221 message.

Fixes #438

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/posting.rs             |  9 +++----
 crates/app/src/tool_numbers.rs        | 34 +++++++++++++++++++++++++
 crates/app/tests/setup_mounts_post.rs | 36 ++++++++++++++++++++++++++-
 docs/decisions/388-per-setup-mount.md | 16 ++++++++++++
 4 files changed, 88 insertions(+), 7 deletions(-)

diff --git a/crates/app/src/posting.rs b/crates/app/src/posting.rs
index 2f68bff1..a4e4a54f 100644
--- a/crates/app/src/posting.rs
+++ b/crates/app/src/posting.rs
@@ -675,13 +675,10 @@ pub fn op_streams(world: &World) -> Result<Vec<(String, Vec<cnc::Record>)>, Stri
 
     // The T../H.. law (#221): a tool's own number when it has one, else
     // its 1-based position among the named tools in document order - and
-    // two tools of one program posting the same number refuse by name.
+    // two tools of one machine posting the same number refuse by name.
     let tool_numbers = crate::tool_numbers::numbers(world);
-    let used: Vec<String> = ops
-        .iter()
-        .filter_map(|(_, e)| model::operation_of(world, e).map(|op| op.tool))
-        .collect();
-    if let Some(msg) = crate::tool_numbers::clash(world, &used) {
+    // Judged per machine (#438): two machines are two tool tables.
+    if let Some(msg) = crate::tool_numbers::clash_per_machine(world, &ops) {
         return Err(msg);
     }
 
diff --git a/crates/app/src/tool_numbers.rs b/crates/app/src/tool_numbers.rs
index 5d6bf0d9..7e46acf4 100644
--- a/crates/app/src/tool_numbers.rs
+++ b/crates/app/src/tool_numbers.rs
@@ -76,3 +76,37 @@ pub fn clash(world: &World, used: &[String]) -> Option<String> {
     }
     None
 }
+
+/// The clash law per machine (#438): `ops` (program operations as
+/// `(name, entity)`) are grouped by the machine their setup mounts -
+/// `setup_mount::program_mounts` grouped by machine alone - and each
+/// group's tools are judged on their own. Two tools sharing a number on
+/// two different machines are two tool tables and never clash; on one
+/// machine they clash even across two posts (one carousel). A program on
+/// one machine refuses with the exact #221 message; a multi-machine one
+/// prefixes the mount it found the clash on.
+#[must_use]
+pub fn clash_per_machine(world: &World, ops: &[(String, flecs_ecs::prelude::Entity)]) -> Option<String> {
+    let mounts = crate::setup_mount::program_mounts(world, false);
+    let setup_of = |e: &flecs_ecs::prelude::Entity| {
+        model::operation_of(world, e).map(|op| {
+            (crate::setup::effective(world, op.setup.as_deref()).unwrap_or_default(), op.tool)
+        })
+    };
+    if mounts.len() <= 1 {
+        let used: Vec<String> = ops.iter().filter_map(|(_, e)| setup_of(e).map(|(_, t)| t)).collect();
+        return clash(world, &used);
+    }
+    for m in &mounts {
+        let used: Vec<String> = ops
+            .iter()
+            .filter_map(|(_, e)| setup_of(e))
+            .filter(|(s, _)| m.setups.contains(s))
+            .map(|(_, t)| t)
+            .collect();
+        if let Some(msg) = clash(world, &used) {
+            return Some(format!("{}: {msg}", m.label()));
+        }
+    }
+    None
+}
