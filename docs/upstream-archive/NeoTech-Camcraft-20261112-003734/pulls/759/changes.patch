diff --git a/crates/ui/src/state_wcs.rs b/crates/ui/src/state_wcs.rs
new file mode 100644
index 000000000..e2f0f5891
--- /dev/null
+++ b/crates/ui/src/state_wcs.rs
@@ -0,0 +1,78 @@
+//! The WCS dispatch arms: `CommandKind::SetWcs` (an origin and angles the
+//! pane, the anchor grid or a pick chip queued) lands as one undoable
+//! `SetWcsOrigin`; `CommandKind::SetWcsCircle` (#739, the "Circle centre"
+//! anchor) as one `SetWcsAtCircleCentre` on a picked circular edge. A
+//! refusal names itself on the status line and lands nothing.
+//! Provenance: our own routing over our own commands; no vendor material.
+
+use camcraft_app::commands::{SetWcsAtCircleCentre, SetWcsOrigin};
+use camcraft_app::geometry::{Point3, quat_from_euler};
+use camcraft_app::operation::GeoSel;
+use camcraft_app::schema::Location;
+use camcraft_app::units;
+
+use super::{ErrorScope, State};
+
+/// Roll, pitch, yaw degrees as the world's quaternion; `None` when any
+/// angle is not finite (the axis-angle builders would quietly substitute
+/// identity - refused instead, Prime Directive).
+fn rotation(rpy_deg: [f64; 3]) -> Option<[f64; 4]> {
+    let [r, p, y] = rpy_deg;
+    (r.is_finite() && p.is_finite() && y.is_finite())
+        .then(|| quat_from_euler(r.to_radians(), p.to_radians(), y.to_radians()))
+}
+
+impl State {
+    fn wcs_placed_status(&mut self) {
+        self.doc_version += 1;
+        let active = camcraft_app::setup::active(&self.world);
+        self.status = format!("{} origin set", camcraft_app::setup::wcs_label(&self.world, active.as_deref()));
+    }
+
+    pub(super) fn dispatch_set_wcs(&mut self, pos: [f64; 3], rpy_deg: [f64; 3]) {
+        let Some(rot) = rotation(rpy_deg) else {
+            self.refuse(ErrorScope::Setup, "WCS not set: rotation angles must be finite".to_owned());
+            return;
+        };
+        let location = Location { pos: Point3::new(pos[0], pos[1], pos[2]), rot };
+        match SetWcsOrigin::new(&self.world, location) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.wcs_placed_status();
+            }
+            Err(err) => self.refuse(ErrorScope::Setup, format!("WCS not set: {err}")),
+        }
+    }
+
+    pub(super) fn dispatch_set_wcs_circle(&mut self, pick: &GeoSel, rpy_deg: [f64; 3]) {
+        let Some(rot) = rotation(rpy_deg) else {
+            self.refuse(ErrorScope::Setup, "WCS not set: rotation angles must be finite".to_owned());
+            return;
+        };
+        match SetWcsAtCircleCentre::new(&self.world, pick, rot) {
+            Ok(command) => {
+                let c = command.circle().clone();
+                self.wcs_ui.circle = Some(Ok(c.clone()));
+                self.wcs_ui.pick_circle = false; // done: the viewport picks normally again
+                self.history.execute(&self.world, command);
+                self.wcs_placed_status();
+                let u = self.units();
+                self.status = format!(
+                    "{} on the centre of {} {} {}",
+                    self.status,
+                    if c.closed { "circle Ø" } else { "arc Ø" },
+                    units::len(c.diameter(), u, 2),
+                    u.suffix()
+                );
+            }
+            Err(err) => {
+                let why = match err {
+                    camcraft_app::commands::CommandError::Invalid(why) => why,
+                    other => other.to_string(),
+                };
+                self.wcs_ui.circle = Some(Err(why.clone()));
+                self.refuse(ErrorScope::Setup, format!("WCS not set: {why}"));
+            }
+        }
+    }
+}
diff --git a/crates/ui/src/wcs_pick.rs b/crates/ui/src/wcs_pick.rs
new file mode 100644
index 000000000..a39cc9533
--- /dev/null
+++ b/crates/ui/src/wcs_pick.rs
@@ -0,0 +1,74 @@
+//! The WCS page's viewport picks: a click on an anchor marker (the box
+//! points of the "Anchor on" grid) and, #739, a click on a circular edge
+//! for the "Circle centre" anchor. Both win over the pick mode while
+//! armed. The edge resolves through the one pick rule
+//! (`feature_click`, edges only, one run per click); the circle itself is
+//! the app's shared `pick::circle_centre`, read by the command the click
+//! queues - nothing here measures geometry.
+//!
+//! Provenance: our own routing over our own pick API and commands; no
+//! vendor material consulted.
+
+use camcraft_app::operation::GeoSel;
+use camcraft_app::pick::{EdgeUnit, PickKinds};
+
+use crate::feature_click::{Ask, feature_at};
+use crate::state::{CommandKind, State};
+
+/// What a circle-centre click takes: feature edges, one run (an arc or a
+/// whole round rim) per click.
+pub(crate) const CIRCLE_ASK: Ask = Ask { kinds: PickKinds::EDGES, unit: EdgeUnit::Run };
+
+/// Anchor-marker hit radius, logical px.
+const MARKER_PX: f32 = 12.0;
+
+/// A viewport click the WCS page takes; `false` leaves it to the pick
+/// mode. A circle pick takes every click while armed; anchor markers
+/// only a click ON a marker (beside one, the viewport picks normally).
+pub(crate) fn take_click(state: &mut State, p: [f32; 2]) -> bool {
+    if state.wcs_ui.pick_circle {
+        circle_click(state, p);
+        return true;
+    }
+    if state.wcs_ui.pick_anchor
+        && let Some((k, pos)) = crate::interact::anchor_hit(state, p, MARKER_PX)
+    {
+        state.wcs_ui.anchor_xy = k;
+        queue_origin(state, pos);
+        return true;
+    }
+    false
+}
+
+/// The pane's angles with a new origin, as the one `SetWcs` command.
+fn queue_origin(state: &mut State, pos: [f64; 3]) {
+    state.pending.push_back(CommandKind::SetWcs {
+        pos,
+        roll_deg: state.wcs_ui.roll_deg,
+        pitch_deg: state.wcs_ui.pitch_deg,
+        yaw_deg: state.wcs_ui.yaw_deg,
+    });
+}
+
+fn circle_click(state: &mut State, p: [f32; 2]) {
+    let Some((found, sel)) = feature_at(state, p, CIRCLE_ASK) else {
+        state.status = String::from("no edge under the cursor - pick a circular edge");
+        return;
+    };
+    let Some(feature) = sel else {
+        state.status = format!("the pick on '{}' names no edge - try beside it", found.entity);
+        return;
+    };
+    queue_circle(state, GeoSel { entity: found.entity, feature });
+}
+
+/// Queue the origin onto a picked edge's circle centre at the pane's
+/// angles; the command refuses a non-circular edge by name.
+pub fn queue_circle(state: &mut State, pick: GeoSel) {
+    state.pending.push_back(CommandKind::SetWcsCircle {
+        pick,
+        roll_deg: state.wcs_ui.roll_deg,
+        pitch_deg: state.wcs_ui.pitch_deg,
+        yaw_deg: state.wcs_ui.yaw_deg,
+    });
+}
