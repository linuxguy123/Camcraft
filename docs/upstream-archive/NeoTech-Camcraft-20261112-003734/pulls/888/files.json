  {
    "sha": "34eece2f2e663abb850f1dac296567bbd00007bc",
    "filename": "Cargo.toml",
    "status": "modified",
    "additions": 13,
    "deletions": 0,
    "changes": 13,
    "blob_url": "https://github.com/NeoTech/Camcraft/blob/7bc45283c08b314daaabfa44536c65cdf2e3037f/Cargo.toml",
    "raw_url": "https://github.com/NeoTech/Camcraft/raw/7bc45283c08b314daaabfa44536c65cdf2e3037f/Cargo.toml",
    "contents_url": "https://api.github.com/repos/NeoTech/Camcraft/contents/Cargo.toml?ref=7bc45283c08b314daaabfa44536c65cdf2e3037f",
    "patch": "@@ -94,6 +94,19 @@ truck-polymesh = \"=0.6.0\"\n truck-meshalgo = { version = \"=0.4.0\", default-features = false, features = [\"tessellation\"] }\n ruststep = \"=0.4.0\"\n \n+# #887: ruststep 0.4.0 - the newest crates.io release (Sept 2024) - cannot\n+# parse the empty parameter list `()`, which ISO 10303-21 allows, so HOOPS\n+# Exchange exports (one `DRAUGHTING_MODEL('',(),...)` entity) are rejected\n+# as corrupt. The fix is merged upstream but unreleased (ricosjp/ruststep#256\n+# asks for a release), so pin the fix commit via [patch.crates-io]. Upstream\n+# still declares version = \"0.4.0\", so camcraft-app's `=0.4.0` and\n+# truck-stepio's `0.4` both resolve to the patched crate unchanged, and\n+# ruststep-derive comes from the same tree. This is deliberately the only\n+# git dependency in the workspace (policy elsewhere: crates.io pins) and\n+# should be dropped once a ruststep release contains the fix.\n+[patch.crates-io]\n+ruststep = { git = \"https://github.com/ricosjp/ruststep\", rev = \"90fdc9351746f1f1d1e435b88f15371edaaaa14d\" }\n+\n # Third-party code is optimized even in dev builds: an unoptimized truck\n # tessellation or wgpu pass is 5-20x slower and makes imports feel like\n # freezes. Our own crates keep full debug settings. One-time rebuild cost."
  },
