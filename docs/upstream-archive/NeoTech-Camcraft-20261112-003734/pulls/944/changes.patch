 ## 2. Fix
 - Smallest change that meets the issue's "Done means". Follow AGENTS.md:
diff --git a/AGENTS.md b/AGENTS.md
index e420b02db..d9bd5a984 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -598,7 +598,7 @@ worktrees. `cargo xtask gate` sets `RUSTC_WRAPPER=sccache` and
 `SCCACHE_CACHE_SIZE=20G` for its cargo calls when `sccache` is on PATH (an
 existing `RUSTC_WRAPPER`, or `CAMCRAFT_NO_SCCACHE=1`, wins); a machine without
 it builds as before, and release packaging never uses it. For plain `cargo`
-set `RUSTC_WRAPPER=sccache` in the shell. The cache lives in the sccache
+set `RUSTC_WRAPPER=sccache` only when `sccache` is on PATH (cargo fails if the wrapper is missing), and never export `CARGO_TARGET_DIR`; `cargo xtask release` clears any wrapper for the packaging build. The cache lives in the sccache
 default dir (Windows `%LOCALAPPDATA%\Mozilla\sccache\cache`, Linux
 `~/.cache/sccache`; `SCCACHE_DIR` moves it). Hits need each worktree's default
 `target/`: sccache hashes `CARGO_*` env vars, so a `CARGO_TARGET_DIR` env var
diff --git a/xtask/src/exec.rs b/xtask/src/exec.rs
index de80c38a6..019cc4ed5 100644
--- a/xtask/src/exec.rs
+++ b/xtask/src/exec.rs
@@ -37,17 +37,25 @@ pub fn cargo() -> String {
 /// builds exactly as before. Release packaging never goes through this (it builds the shipped binary).
 pub fn cache_env(sccache: Option<&str>, wrapper_set: bool, opted_out: bool, size_set: bool) -> Vec<(&'static str, String)> {
     let mut env = Vec::new();
-    if let Some(path) = sccache {
-        if !wrapper_set && !opted_out {
-            env.push(("RUSTC_WRAPPER", path.to_string()));
-            if !size_set {
-                env.push(("SCCACHE_CACHE_SIZE", "20G".to_string()));
-            }
+    if let Some(path) = sccache
+        && !wrapper_set
+        && !opted_out
+    {
+        env.push(("RUSTC_WRAPPER", path.to_string()));
+        if !size_set {
+            env.push(("SCCACHE_CACHE_SIZE", "20G".to_string()));
         }
     }
     env
 }
 
+/// Compiler-wrapper variables the release packaging build must not inherit (#935): the shipped binary never
+/// depends on a compile cache, even when the maintainer sets `RUSTC_WRAPPER` machine-wide. Returns the ones
+/// present (`is_set` asks the environment); the release GATE tier may still use the cache, only packaging clears it.
+pub fn packaging_env_clear(is_set: impl Fn(&str) -> bool) -> Vec<&'static str> {
+    ["RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WRAPPER"].into_iter().filter(|v| is_set(v)).collect()
+}
+
 /// The first `sccache` (or `sccache.exe`) file on PATH, as a path string.
 pub fn find_sccache() -> Option<String> {
     let path = std::env::var_os("PATH")?;
diff --git a/xtask/src/release.rs b/xtask/src/release.rs
index 8c011360b..89ca56cae 100644
--- a/xtask/src/release.rs
+++ b/xtask/src/release.rs
@@ -75,6 +75,11 @@ impl Cut {
 
     /// Runs a command at the root (or `cwd`); a dry run prints it instead. Non-zero exit fails the cut.
     fn run(&mut self, exe: &str, args: &[String], env: &[(&str, &Path)]) -> Result<(), String> {
+        self.run_clearing(exe, args, env, &[])
+    }
+
+    /// `run`, with `clear` removed from the child's environment.
+    fn run_clearing(&mut self, exe: &str, args: &[String], env: &[(&str, &Path)], clear: &[&str]) -> Result<(), String> {
         let line = format!("{exe} {}", args.join(" "));
         if self.a.dry {
             self.say(format!("[dry-run] {line}"));
@@ -84,6 +89,9 @@ impl Cut {
         let program = if exe == "cargo" { exec::cargo() } else { exe.to_string() };
         let mut c = Command::new(program);
         c.args(args).current_dir(&self.root).stdin(Stdio::null());
+        for k in clear {
+            c.env_remove(k);
+        }
         for (k, v) in env {
             c.env(k, v);
         }
@@ -243,8 +251,11 @@ impl Cut {
             self.say("skipped (--skip-build)");
             return Ok(());
         }
+        // The shipped binary never depends on a compile cache: drop any compiler wrapper the environment sets
+        // (a maintainer may set RUSTC_WRAPPER machine-wide). The release GATE tier may still use sccache.
+        let clear = exec::packaging_env_clear(|v| std::env::var_os(v).is_some());
         for args in pack::build_steps(self.os) {
-            self.run("cargo", &args, &[])?;
+            self.run_clearing("cargo", &args, &[], &clear)?;
         }
         Ok(())
     }
diff --git a/xtask/src/tests.rs b/xtask/src/tests.rs
index 9530e0b44..7e8f096c0 100644
--- a/xtask/src/tests.rs
+++ b/xtask/src/tests.rs
@@ -291,3 +291,13 @@ fn the_compile_cache_is_enabled_only_when_sccache_exists_and_nobody_chose_otherw
     // A size the caller chose is not overridden.
     assert_eq!(exec::cache_env(Some("/bin/sccache"), false, false, true), [("RUSTC_WRAPPER", "/bin/sccache".to_string())]);
 }
+
+#[test]
+fn packaging_build_clears_compiler_wrappers() {
+    // Both wrapper variables set: both are removed from the packaging build's environment (#935).
+    let both = exec::packaging_env_clear(|_| true);
+    assert_eq!(both, ["RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WRAPPER"]);
+    // Only the one that is set is named; none set, nothing to clear.
+    assert_eq!(exec::packaging_env_clear(|v| v == "CARGO_BUILD_RUSTC_WRAPPER"), ["CARGO_BUILD_RUSTC_WRAPPER"]);
+    assert!(exec::packaging_env_clear(|_| false).is_empty());
+}
