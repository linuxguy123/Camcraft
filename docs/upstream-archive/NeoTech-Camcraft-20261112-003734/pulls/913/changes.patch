+++ b/AGENTS.md
@@ -590,6 +590,21 @@ gate <tier>`, from the workspace's `xtask/` crate. `scripts/gate.ps1`
 Any tier takes `--dry-run` to print its plan without running it; logs go
 to `gate-logs/<tier>-<timestamp>/`.
 
+**Shared compile cache (optional, #900).** Every worktree has its own
+`target/`, so a fresh one recompiles every third-party crate. With
+[sccache](https://github.com/mozilla/sccache) (`cargo install sccache
+--locked`, user account only) those compilations are cache hits across
+worktrees. `cargo xtask gate` sets `RUSTC_WRAPPER=sccache` and
+`SCCACHE_CACHE_SIZE=20G` for its cargo calls when `sccache` is on PATH (an
+existing `RUSTC_WRAPPER`, or `CAMCRAFT_NO_SCCACHE=1`, wins); a machine without
+it builds as before, and release packaging never uses it. For plain `cargo`
+set `RUSTC_WRAPPER=sccache` in the shell. The cache lives in the sccache
+default dir (Windows `%LOCALAPPDATA%\Mozilla\sccache\cache`, Linux
+`~/.cache/sccache`; `SCCACHE_DIR` moves it). Hits need each worktree's default
+`target/`: sccache hashes `CARGO_*` env vars, so a `CARGO_TARGET_DIR` env var
+makes every worktree miss. Dev builds carry line tables only (no variable
+debug info; `--config profile.dev.debug=true` restores it for a debugger).
+
 **GitHub Actions minutes are budgeted** (3000/month; Windows bills 2x,
 macOS 10x). Nothing runs on push or PR: every gate tier runs locally
 through `cargo xtask gate`. GitHub runs only `release.yml` on a pushed tag
diff --git a/Cargo.toml b/Cargo.toml
index 069582df0..61fe46ade 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -106,6 +106,14 @@ ruststep = "=0.4.0"
 
 # Third-party code is optimized even in dev builds: an unoptimized truck
 # tessellation or wgpu pass is 5-20x slower and makes imports feel like
-# freezes. Our own crates keep full debug settings. One-time rebuild cost.
+# freezes. opt-level 1 is as fast as 2 on the compute-heavy suites (motion finish3d: 48.7 s vs 46.7 s;
+# opt-level 0 is 3x slower) and cuts the cold dependency build (#900).
+# Debug info is line tables only (file:line in panics and backtraces) and none for dependencies: the
+# target/ is ~43% smaller. `--config profile.dev.debug=true` restores full info for a debugger session.
+# Release is untouched.
+[profile.dev]
+debug = "line-tables-only"
+
 [profile.dev.package."*"]
-opt-level = 2
+opt-level = 1
+debug = false
diff --git a/xtask/src/exec.rs b/xtask/src/exec.rs
index 60344e7ae..de80c38a6 100644
--- a/xtask/src/exec.rs
+++ b/xtask/src/exec.rs
@@ -31,6 +31,41 @@ pub fn cargo() -> String {
     std::env::var("CARGO").unwrap_or_else(|_| "cargo".into())
 }
 
+/// The compile-cache environment for a gate's cargo calls (#900): `RUSTC_WRAPPER=sccache` and a cache size
+/// cap, but only when `sccache` is on PATH and the caller has not chosen a wrapper (an existing
+/// `RUSTC_WRAPPER`, even an empty one, wins; `CAMCRAFT_NO_SCCACHE=1` opts out). A machine without sccache
+/// builds exactly as before. Release packaging never goes through this (it builds the shipped binary).
+pub fn cache_env(sccache: Option<&str>, wrapper_set: bool, opted_out: bool, size_set: bool) -> Vec<(&'static str, String)> {
+    let mut env = Vec::new();
+    if let Some(path) = sccache {
+        if !wrapper_set && !opted_out {
+            env.push(("RUSTC_WRAPPER", path.to_string()));
+            if !size_set {
+                env.push(("SCCACHE_CACHE_SIZE", "20G".to_string()));
+            }
+        }
+    }
+    env
+}
+
+/// The first `sccache` (or `sccache.exe`) file on PATH, as a path string.
+pub fn find_sccache() -> Option<String> {
+    let path = std::env::var_os("PATH")?;
+    std::env::split_paths(&path)
+        .flat_map(|d| [d.join("sccache"), d.join("sccache.exe")])
+        .find(|p| p.is_file())
+        .map(|p| p.to_string_lossy().into_owned())
+}
+
+fn gate_cache_env() -> Vec<(&'static str, String)> {
+    cache_env(
+        find_sccache().as_deref(),
+        std::env::var_os("RUSTC_WRAPPER").is_some(),
+        std::env::var_os("CAMCRAFT_NO_SCCACHE").is_some_and(|v| v == "1"),
+        std::env::var_os("SCCACHE_CACHE_SIZE").is_some(),
+    )
+}
+
