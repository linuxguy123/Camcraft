From 3c6e6204487db256376ed56babac8792fe3d7ea4 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Wed, 11 Nov 2026 14:23:31 +0100
Subject: [PATCH 05/11] test: recorded verdicts follow the #689 closed-ring fit

- wall_arc_entry: on the capped mesh a proved arc fits beside the bore
  wall; bore entries must land on bore levels, and the plunge count
  follows (outer 5 + bore arcs past the second + grazes).
- solid_law_goldens: the R6 bore's r = 3 ring and its 3 mm leads share
  one circle, so the program stays refused by law (a); with the ring
  closing on arcs the leads meet its arcs too - the recorded crossing
  pairs grow, the refusal is the same.

Refs #689

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/solid_law_goldens.rs | 24 +++++++++++++++++++-----
 crates/app/tests/wall_arc_entry.rs    | 20 +++++++++++++++-----
 2 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/crates/app/tests/solid_law_goldens.rs b/crates/app/tests/solid_law_goldens.rs
index 1bb46a854..75ed07e6d 100644
--- a/crates/app/tests/solid_law_goldens.rs
+++ b/crates/app/tests/solid_law_goldens.rs
@@ -379,11 +379,25 @@ fn every_depth_law_golden_verifies_exactly_as_before() {
     // before the solid law - and unchanged by it, warning for warning.
     for (name, w) in got {
         let want: Vec<Warning> = match name {
-            // Law (a), the XY crossing law the solid law never touches:
-            // the same three move pairs before and after.
-            "contour_disc_hole.cl" | "contour_tangential_lead.cl" => {
-                [[17, 19], [40, 42], [63, 65]].into_iter().map(|moves| Warning::Crossing { moves }).collect()
-            }
+            // Law (a), the XY crossing law the solid law never touches.
+            // The R6 bore's r = 3 cutter-centre ring and the 3 mm leads
+            // share one circle, so the leads cross the ring and the
+            // program stays refused. Since #689 the ring closes on arcs
+            // and the lead-out leaves on its true tangent, so the leads
+            // meet the ring's arcs as well as each other: more pairs,
+            // the same refusal.
+            "contour_disc_hole.cl" => [[17, 20], [18, 21], [40, 43], [41, 44], [63, 66], [64, 67]]
+                .into_iter()
+                .map(|moves| Warning::Crossing { moves })
+                .collect(),
+            "contour_tangential_lead.cl" => [
+                [17, 19], [17, 20], [18, 21], [19, 21],
+                [40, 42], [40, 43], [41, 44], [42, 44],
+                [63, 65], [63, 66], [64, 67], [65, 67],
+            ]
+            .into_iter()
+            .map(|moves| Warning::Crossing { moves })
+            .collect(),
             _ => Vec::new(),
         };
         assert_eq!(w, want, "{name}");
