From 814182c289ff2fcae2f059480635d0fd0d00e81b Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Thu, 12 Nov 2026 00:09:42 +0100
Subject: [PATCH] fix(cl): headless_bin expects the 33 arcs of the regenerated
 contour_disc_hole golden

PR #839 (arc fitting) regenerated crates/app/tests/golden/contour_disc_hole.cl
to 33 arcs with the same 69 moves; the cl test still asserted 30 arcs.
Only the arc count in the expected move-stats line changes.

Fixes #936

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 crates/cl/tests/headless_bin.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/cl/tests/headless_bin.rs b/crates/cl/tests/headless_bin.rs
index 58f67df64..cccc1cf05 100644
--- a/crates/cl/tests/headless_bin.rs
+++ b/crates/cl/tests/headless_bin.rs
@@ -46,7 +46,7 @@ fn cl_bin_prints_move_stats() {
     let o = run(&[p.as_os_str()]);
     let out = String::from_utf8_lossy(&o.stdout);
     assert!(o.status.success(), "{out}{}", String::from_utf8_lossy(&o.stderr));
-    assert!(out.contains("moves: 69 (rapid 12, feed 51, plunge 6, arcs 30)"), "{out}");
+    assert!(out.contains("moves: 69 (rapid 12, feed 51, plunge 6, arcs 33)"), "{out}");
     assert!(out.contains("chained: true"), "{out}");
 }
 
