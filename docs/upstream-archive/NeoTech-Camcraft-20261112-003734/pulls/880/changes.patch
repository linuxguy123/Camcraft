+    let g = crate::tools::Tool { holder_len: 0.0, ..t.clone() }.geom();
+    assert_eq!(real.floored(&g), real);
+    let g = ToolGeom { holder_radius: f64::NAN, ..t.geom() };
+    assert_eq!(real.floored(&g), real);
+}
