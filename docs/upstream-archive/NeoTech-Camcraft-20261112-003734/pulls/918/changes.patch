 // Cutter radius compensation in the control (#39; RS-274 / ISO 6983
diff --git a/assets/posts/mazak.cps b/assets/posts/mazak.cps
index a1670b2ff..1e3ab7180 100644
--- a/assets/posts/mazak.cps
+++ b/assets/posts/mazak.cps
@@ -220,12 +220,23 @@ function toolNote() {  // just before the tool change it describes
   toolKind = ""; toolCr = 0;
 }
 
+// #901: the unit this post writes - millimetres - stated in a block of
+// its own before any motion, so a control left in inch by power-on or
+// the last program never reads mm numbers as inches (RS-274 / ISO 6983:
+// G20 inch, G21 mm; the family's EIA/ISO conventions follow the Fanuc
+// words, G21 in a block of its own at the program's start). Where the
+// program's unit is chosen, and inch output, is #902.
+function unitBlock() {
+  block(["G21"]);
+}
+
 function onOpen() {
   var nm = (typeof machine !== "undefined" && machine.name) || "CAMCRAFT";
   writeln("%");
   // #594: the name is user text from the machine file - cleaned like
   // every other comment text, so `Tormach 770MX (ML)` never nests.
   block([oWord(), "(" + (clean(nm) || "CAMCRAFT") + ")"]);
+  unitBlock();
 }
 
 // Cutter radius compensation in the control (#39; RS-274 / ISO 6983
diff --git a/assets/posts/sinumerik.cps b/assets/posts/sinumerik.cps
index 5290a5f4f..b9b075cd7 100644
--- a/assets/posts/sinumerik.cps
+++ b/assets/posts/sinumerik.cps
@@ -342,7 +342,13 @@ function startPreamble() {
   // stopped before its first move, whatever the tool change did.
   var probeStop = spindleWait && !(sRpm > 0);
   opNotes();
-  block(["G17", "G90", wcsWord, "G40", "G80"]);
+  // #901: G710 - metric for lengths AND feeds (the family's published
+  // programming manual: G71 switches only geometric data, so F would
+  // still read in the basic system's unit; G710 switches both). Stated
+  // in the opening block before any motion, whatever the control's
+  // basic system or the last program left modal. Where the program's
+  // unit is chosen, and inch output, is #902.
+  block(["G17", "G710", "G90", wcsWord, "G40", "G80"]);
   planeG = 17;              // the preamble states the plane
   if (toolWait) {
     toolNote();
