new file mode 100644
index 000000000..563d52146
--- /dev/null
+++ b/docs/decisions/3271-site-redeploy.md
@@ -0,0 +1,45 @@
+## #3276 - Redeploy the 0.25.0 site with a `site_only` dispatch of release.yml
+
+**Decided:** `release.yml` gets a boolean input `site_only` (default false)
+on its existing `workflow_dispatch`. With `site_only: true`, only the `site`
+and `pages` jobs run, from the dispatched ref. The `linux`, `macos`,
+`windows` and `wasm` jobs are skipped by their own condition; `aur`, `snap`
+and `flatpak` follow `linux`. `publish` stays tag-only and is not changed.
+`pages` deploys on that path only when the ref is a `site/*` branch. The
+site version comes from the `[workspace.package]` version of the
+dispatched tree's `Cargo.toml`, as on a tag run. With `wasm` skipped, the
+site goes out with app/ as its "not part of this copy" page.
+
+The 0.25.0 site is redeployed from the branch `site/v0.25.0`: the tag
+v0.25.0 plus only the site and docs part of PR #3274 that applies to that
+tree (the V-Carve section, its icon, its diagram and its reference entry
+are left out, because V-Carve (#3151) merged after the tag). The dispatch
+is `gh workflow run release.yml --ref site/v0.25.0 -f site_only=true`.
+
+**Why:** the `site` job of the v0.25.0 tag run failed on site tests that
+had drifted from the shipped app (#3271), so `pages` did not deploy. A
+re-run of the tag run builds the same tree and fails again. The input adds
+no trigger (AGENTS.md "GitHub Actions minutes are budgeted"): only a
+collaborator can dispatch, a fork PR cannot start it, and a site-only run
+bills only two short Linux jobs. The `site/*` guard on `pages` keeps a
+dispatch from `main` from deploying a site that names a version that is
+not released.
+
+**Owner action (a settings change, not done by an agent):** the
+`github-pages` environment must permit deployments from branches named
+`site/*` (Settings > Environments > github-pages > Deployment branches and
+tags). Without that policy the `pages` job of the dispatch is refused, and
+the 0.25.0 site content ships with the v0.26.0 deploy.
+
+**Dropped:**
+- A site build from `main`: it documents features after 0.25.0 (V-Carve)
+  and names a version that is not released.
+- A moved or re-pushed tag v0.25.0: AGENTS.md forbids moving an existing
+  tag, and a tag push also starts the full platform build and publish.
+- A patch cut v0.25.1: there are no patch cuts, and `release.yml` builds
+  nothing for a patch tag.
+- A separate site workflow: a second copy of the site and pages jobs that
+  can drift from the release copy.
+
+**Cost to change later:** remove the input and the four `if:` lines; the
+tag path does not depend on them.
diff --git a/xtask/tests/release_site_tests.rs b/xtask/tests/release_site_tests.rs
index 5a4a7e312..266a5a16f 100644
--- a/xtask/tests/release_site_tests.rs
+++ b/xtask/tests/release_site_tests.rs
@@ -1,18 +1,36 @@
-// Provenance: issue #1832 and the repository's release workflow contract.
+// Provenance: issues #1832 and #3276 and the repository's release workflow contract.
 use std::{fs, path::Path};
 
-/// The `site` job of release.yml: from its `  site:` line up to the next
-/// job (a line indented two spaces) or the end of the file.
-fn site_job() -> String {
+fn workflow() -> String {
     let path = Path::new(env!("CARGO_MANIFEST_DIR")).join("../.github/workflows/release.yml");
-    let workflow = fs::read_to_string(path).expect("read the release workflow");
-    let body = workflow.split_once("\n  site:\n").expect("release.yml has a site job").1;
+    fs::read_to_string(path).expect("read the release workflow")
+}
+
+/// One job of release.yml: from its `  <name>:` line up to the next job (a
+/// line indented two spaces) or the end of the file.
+fn job(name: &str) -> String {
+    let workflow = workflow();
+    let body = workflow
+        .split_once(&format!("\n  {name}:\n"))
+        .unwrap_or_else(|| panic!("release.yml has a {name} job"))
+        .1;
     body.lines()
         .take_while(|line| line.is_empty() || line.starts_with("   ") || line.starts_with("  #"))
         .collect::<Vec<_>>()
         .join("\n")
 }
 
+/// The job's own `if:` condition, trimmed (None when it has none).
+fn condition(name: &str) -> Option<String> {
+    job(name)
+        .lines()
+        .find_map(|l| l.strip_prefix("    if: ").map(|c| c.trim().to_string()))
+}
+
+fn site_job() -> String {
+    job("site")
+}
+
 #[test]
 fn the_site_job_runs_the_site_tests_with_its_pinned_zola() {
     let job = site_job();
@@ -28,3 +46,43 @@ fn the_site_job_runs_the_site_tests_with_its_pinned_zola() {
     assert!(step.lines().any(|l| l.trim() == "ZOLA: /tmp/zola"), "the tests build with the pinned Zola:\n{step}");
     assert!(!step.contains("continue-on-error"), "a red site test fails the site job:\n{step}");
 }
+
+#[test]
+fn site_only_dispatch_runs_only_site_and_pages() {
+    // #3276: the input lives on the existing workflow_dispatch; no trigger is added.
+    let wf = workflow();
+    let on = wf.split_once("\non:\n").expect("release.yml has an on: block").1;
+    let on = on.split_once("\n\n").map_or(on, |(head, _)| head);
+    let triggers: Vec<&str> =
+        on.lines().filter(|l| l.starts_with("  ") && !l.starts_with("   ")).map(str::trim).collect();
+    assert_eq!(triggers, ["push:", "workflow_dispatch:"], "release.yml triggers:\n{on}");
+    assert!(on.contains("      site_only:\n"), "workflow_dispatch has the site_only input:\n{on}");
+    assert!(on.contains("        type: boolean\n        default: false"), "site_only is a boolean, off by default:\n{on}");
+
+    // Every build job is skipped on a site_only run; aur, snap and flatpak follow linux.
+    for name in ["linux", "macos", "windows", "wasm"] {
+        assert_eq!(condition(name).as_deref(), Some("${{ !inputs.site_only }}"), "{name} skips on site_only");
+    }
+    for name in ["aur", "snap", "flatpak"] {
+        assert!(job(name).contains("    needs: linux"), "{name} follows linux");
+        assert_eq!(condition(name), None, "{name} has no condition of its own");
+    }
+
+    // publish stays tag-only; the site still builds without the wasm job.
+    assert_eq!(condition("publish").as_deref(), Some("${{ !cancelled() && startsWith(github.ref, 'refs/tags/') }}"));
+    assert_eq!(condition("site").as_deref(), Some("${{ !cancelled() }}"));
+
+    // pages: the tag path as before, or a site_only dispatch from a site/* branch.
+    let pages = condition("pages").expect("pages has a condition");
+    assert!(pages.contains("needs.site.result == 'success'"), "{pages}");
+    assert!(
+        pages.contains("(startsWith(github.ref, 'refs/tags/') && needs.publish.result == 'success')"),
+        "the tag path still waits for publish: {pages}"
+    );
+    assert!(
+        pages.contains(
+            "(github.event_name == 'workflow_dispatch' && inputs.site_only && startsWith(github.ref, 'refs/heads/site/'))"
+        ),
+        "a site_only dispatch deploys only from a site/* branch: {pages}"
+    );
+}

