+[package]
+name = "camcraft-gpu"
+description = "Headless GPU compute seam: device policy, capability probe, CPU fallback rule, facet binning kernel."
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+
+[dependencies]
+# #2620: the one direct wgpu user, pinned to the egui set's version (root
+# Cargo.toml) so the lock keeps one wgpu.
+wgpu = { workspace = true }
+# #163: the fallback reason is a `tracing` event, printed by the
+# subscriber that each binary installs.
+tracing = { workspace = true }
+
+# Blocking on a GPU future is native-only: a browser answers from its
+# event loop, so the wasm32 build has the `*_async` twins only.
+[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
+pollster = { workspace = true }
diff --git a/crates/gpu/src/adapter.rs b/crates/gpu/src/adapter.rs
new file mode 100644
index 000000000..cbc063202
--- /dev/null
+++ b/crates/gpu/src/adapter.rs
@@ -0,0 +1,112 @@
+//! Windowless wgpu device for the headless run, the compute seam and the
+//! GPU test suites: the software adapter first (deterministic on CI:
+//! lavapipe / WARP), then the platform's hardware adapter (Metal has no
+//! software fallback, so on macOS this is the only way to render at all -
+//! #615). Moved down from camcraft-ui's `headless_gpu` (#2620), unchanged
+//! but for the compute probe that each device now carries.
+//! Provenance: our own adapter policy over wgpu's public
+//! `RequestAdapterOptions` API.
+
+use crate::probe::{probe, Compute};
+
+/// Which adapter the device came from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AdapterKind {
+    /// wgpu's fallback (software rasterizer) adapter.
+    Software,
+    /// The platform default hardware adapter.
+    Hardware,
+}
+
+impl AdapterKind {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Software => "software",
+            Self::Hardware => "hardware",
+        }
+    }
+}
+
+/// A device with no surface, and where it came from.
+pub struct HeadlessGpu {
+    pub device: wgpu::Device,
+    pub queue: wgpu::Queue,
+    pub kind: AdapterKind,
+    /// `"<adapter name> via <backend>"`, for logs.
+    pub name: String,
+    /// What the device can compute, or why it cannot (#2620): read from
+    /// the adapter's downlevel flags and the device's own limits.
+    pub compute: Result<Compute, String>,
+}
+
+/// The env var that turns a test's "no adapter" skip into a failure.
+pub const REQUIRE_GPU_ENV: &str = "CAMCRAFT_REQUIRE_GPU";
+
+async fn try_kind(instance: &wgpu::Instance, kind: AdapterKind) -> Result<HeadlessGpu, String> {
+    let options = wgpu::RequestAdapterOptions {
+        force_fallback_adapter: kind == AdapterKind::Software,
+        power_preference: wgpu::PowerPreference::LowPower,
+        compatible_surface: None,
+        ..Default::default()
+    };
+    let adapter = instance
+        .request_adapter(&options)
+        .await
+        .map_err(|err| format!("{} adapter: {err}", kind.label()))?;
+    let info = adapter.get_info();
+    let name = format!("\"{}\" via {:?}", info.name, info.backend);
+    let (device, queue) = adapter
+        .request_device(&wgpu::DeviceDescriptor::default())
+        .await
+        .map_err(|err| format!("{} device {name}: {err}", kind.label()))?;
+    let compute = probe(info.backend, &adapter.get_downlevel_capabilities(), &device.limits());
+    Ok(HeadlessGpu { device, queue, kind, name, compute })
+}
+
+/// Software adapter first, then hardware. The error names why each failed.
+/// Native only: it blocks on the adapter, which a browser cannot (#31) -
+/// `device_async` is the same choice, awaited.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn device() -> Result<HeadlessGpu, String> {
+    pollster::block_on(device_async())
+}
+
+/// `device`, awaiting the adapter and device requests instead of blocking.
+pub async fn device_async() -> Result<HeadlessGpu, String> {
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::new_without_display_handle());
+    let mut why = Vec::new();
+    for kind in [AdapterKind::Software, AdapterKind::Hardware] {
+        match try_kind(&instance, kind).await {
+            Ok(gpu) => return Ok(gpu),
+            Err(err) => why.push(err),
+        }
+    }
+    Err(format!("no graphics adapter: {}", why.join("; ")))
+}
+
+/// For GPU tests: the device, or `Ok(None)` after printing a loud SKIP
+/// line to stderr when the machine has no adapter at all. With
+/// `CAMCRAFT_REQUIRE_GPU=1` a missing adapter is `Err` instead, so a lane
+/// that must render can't pass by skipping.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn device_for_test(suite: &str) -> Result<Option<HeadlessGpu>, String> {
+    match device() {
+        Ok(gpu) => {
+            eprintln!("{suite}: rendering on the {} adapter {}", gpu.kind.label(), gpu.name);
+            Ok(Some(gpu))
+        }
+        Err(err) => {
+            if gpu_required() {
+                Err(format!("{suite}: {REQUIRE_GPU_ENV}=1 but {err}"))
+            } else {
+                eprintln!("*** {suite}: SKIPPED (no adapter) - NOT a pass: {err} ***");
+                Ok(None)
+            }
+        }
+    }
+}
+
+/// `CAMCRAFT_REQUIRE_GPU=1` is set: a skip must fail instead.
+pub fn gpu_required() -> bool {
+    std::env::var(REQUIRE_GPU_ENV).is_ok_and(|v| v.trim() == "1")
+}
diff --git a/crates/gpu/src/binning.rs b/crates/gpu/src/binning.rs
new file mode 100644
index 000000000..da0520954
--- /dev/null
+++ b/crates/gpu/src/binning.rs
@@ -0,0 +1,221 @@
+//! Conservative facet binning (#2620), the host half: the grid spec, the
+//! tile-relative f32 boxes with an outward margin, the buffer plan against
+//! the device limits, the cell lists, and the CPU twin of the WGSL kernel.
+//! The law is a SUPERSET of the f64 grid of #2619 (`camcraft-motion`'s
+//! `SupSet`): each facet that the f64 cell map puts in a cell is in that
+//! cell here too; extra entries are permitted. Provenance: uniform-grid
+//! partitioning from C. Ericson, "Real-Time Collision Detection" (2005),
+//! ch. 7; the rounding margin is our own bound on f32 error.
+
+use crate::probe::{Compute, WORKGROUP};
+
+/// Most cells along one axis that the kernel takes (f32 holds every index
+/// below 2^24 exactly; this stays far under it).
+pub const MAX_AXIS: u32 = 1 << 16;
+/// Most binned entries (facet-cell pairs) for one dispatch: bounds the
+/// kernel's loop work, so one call cannot stall the device.
+pub const MAX_ENTRIES: u64 = 1 << 26;
+/// Largest tile-relative coordinate: past it f32 loses the cell.
+const MAX_REL: f64 = 1.0e12;
+/// Relative rounding margin: 2^-18, far above the f32 cast (2^-24) and
+/// WGSL's 2.5 ULP division error together.
+const MARGIN: f64 = 1.0 / 262_144.0;
+
+/// The f64 grid: origin, cell size and cell counts, as the CPU grid has them.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct GridSpec {
+    pub x0: f64,
+    pub y0: f64,
+    pub s: f64,
+    pub nx: u32,
+    pub ny: u32,
+}
+
+/// Facet boxes in tile-relative f32 (`[xmin, ymin, xmax, ymax]`), each
+/// corner moved outward by the margin; the cell size in f32.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PaddedBoxes {
+    pub boxes: Vec<[f32; 4]>,
+    pub s: f32,
+    pub nx: u32,
+    pub ny: u32,
+}
+
+/// The buffers and the dispatch of one binning call.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Plan {
+    pub n: u32,
+    /// `u32` words of one cell's facet bit set.
+    pub words: u32,
+    pub cells: u32,
+    pub in_bytes: u64,
+    pub out_bytes: u64,
+    pub groups: u32,
+}
+
+/// One list of facet indices for each cell, in ascending index, once each
+/// (CSR: `start` is `cells + 1` long).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CellLists {
+    pub nx: u32,
+    pub ny: u32,
+    start: Vec<usize>,
+    idx: Vec<u32>,
+}
+
+impl CellLists {
+    /// The facets of cell `c = cy * nx + cx`; empty past the grid.
+    pub fn cell(&self, c: usize) -> &[u32] {
+        match (self.start.get(c), self.start.get(c.saturating_add(1))) {
+            (Some(&a), Some(&b)) => self.idx.get(a..b).unwrap_or(&[]),
+            _ => &[],
+        }
+    }
+
+    pub fn cells(&self) -> usize {
+        self.start.len().saturating_sub(1)
+    }
+
+    pub(crate) fn from_lists(nx: u32, ny: u32, lists: Vec<Vec<u32>>) -> Self {
+        let mut start = Vec::with_capacity(lists.len().saturating_add(1));
+        let mut idx = Vec::new();
+        start.push(0);
+        for l in lists {
+            idx.extend(l);
+            start.push(idx.len());
+        }
+        CellLists { nx, ny, start, idx }
+    }
+
+    /// The kernel's output: `words` bit-set words for each cell.
+    #[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+    pub(crate) fn from_bits(p: &Plan, nx: u32, ny: u32, bits: &[u32]) -> Self {
+        let words = p.words as usize;
+        let mut lists = Vec::with_capacity(p.cells as usize);
+        for c in 0..p.cells as usize {
+            let mut l = Vec::new();
+            let row = bits.get(c * words..(c + 1) * words).unwrap_or(&[]);
+            for (w, &word) in row.iter().enumerate() {
+                let mut m = word;
+                while m != 0 {
+                    let b = m.trailing_zeros();
+                    let i = (w as u64) * 32 + u64::from(b);
+                    if i < u64::from(p.n) {
+                        l.push(i as u32);
+                    }
+                    m &= m - 1;
+                }
+            }
+            lists.push(l);
+        }
+        Self::from_lists(nx, ny, lists)
+    }
+}
+
+/// The f64 boxes (already padded by the tool radius, as the caller's grid
+/// has them) as tile-relative f32 with the outward margin. Refuses by
+/// name a non-finite box or spec, a cell size f32 cannot hold, or a grid
+/// past `MAX_AXIS`.
+pub fn pad_boxes(boxes: &[[f64; 4]], spec: &GridSpec) -> Result<PaddedBoxes, String> {
+    let GridSpec { x0, y0, s, nx, ny } = *spec;
+    if !(x0.is_finite() && y0.is_finite() && s.is_finite() && s > 0.0) {
+        return Err(format!("binning: the grid origin or cell size is not finite and positive ({spec:?})"));
+    }
+    if nx == 0 || ny == 0 || nx > MAX_AXIS || ny > MAX_AXIS {
+        return Err(format!("binning: the grid is {nx} x {ny} cells; each axis must be 1..={MAX_AXIS}"));
+    }
+    let s32 = s as f32;
+    if !(s32.is_normal() && s32 > 0.0) {
+        return Err(format!("binning: the cell size {s} has no normal f32 value"));
+    }
+    let mut ext = s * f64::from(nx.max(ny));
+    for (i, b) in boxes.iter().enumerate() {
+        if !b.iter().all(|v| v.is_finite()) {
+            return Err(format!("binning: facet box {i} is not finite"));
+        }
+        for v in [b[0] - x0, b[2] - x0, b[1] - y0, b[3] - y0] {
+            ext = ext.max(v.abs());
+        }
+    }
+    if !(ext.is_finite() && ext < MAX_REL) {
+        return Err(format!("binning: a tile-relative coordinate ({ext}) is past f32 range for the grid"));
+    }
+    let m = (ext + s) * MARGIN;
+    let lo = |v: f64| ((v - m) as f32).next_down();
+    let hi = |v: f64| ((v + m) as f32).next_up();
+    let out = boxes.iter().map(|b| [lo(b[0] - x0), lo(b[1] - y0), hi(b[2] - x0), hi(b[3] - y0)]).collect();
+    Ok(PaddedBoxes { boxes: out, s: s32, nx, ny })
+}
+
+/// The kernel's cell map, in f32, as `cell` in binning.wgsl: floor, then
+/// clamp to `0..=n-1`; a NaN or negative quotient is cell 0.
+pub(crate) fn cell32(v: f32, s: f32, n: u32) -> u32 {
+    let t = (v / s).floor();
+    if t.is_nan() || t <= 0.0 {
+        return 0;
+    }
+    t.min(n.saturating_sub(1) as f32) as u32
+}
+
+fn ranges(b: &[f32; 4], p: &PaddedBoxes) -> (u32, u32, u32, u32) {
+    (cell32(b[0], p.s, p.nx), cell32(b[2], p.s, p.nx), cell32(b[1], p.s, p.ny), cell32(b[3], p.s, p.ny))
+}
+
+/// The buffers and dispatch for `p` on a device with `c`. Refuses by name
+/// a buffer past the device's storage binding or buffer size, a dispatch
+/// past the workgroup count, or more than `MAX_ENTRIES` binned entries.
+pub fn plan(p: &PaddedBoxes, c: &Compute) -> Result<Plan, String> {
+    let n = u32::try_from(p.boxes.len()).map_err(|_| "binning: more facets than u32 holds".to_string())?;
+    let words = n.div_ceil(32);
+    let cells = p.nx.checked_mul(p.ny).ok_or("binning: the cell count overflows u32")?;
+    let in_bytes = u64::from(n) * 16;
+    let out_words = u64::from(cells) * u64::from(words);
+    let out_bytes = out_words * 4;
+    let limit = c.max_storage_buffer_binding_size.min(c.max_buffer_size);
+    for (what, bytes) in [("facet box", in_bytes), ("cell bit set", out_bytes)] {
+        if bytes > limit {
+            return Err(format!("binning: the {what} buffer ({bytes} bytes) is past the device limit ({limit} bytes)"));
+        }
+    }
+    if out_words > u64::from(u32::MAX) {
+        return Err("binning: the cell bit set has more words than a u32 index holds".into());
+    }
+    let groups = n.div_ceil(WORKGROUP);
+    if groups > c.max_compute_workgroups_per_dimension {
+        return Err(format!(
+            "binning: {groups} workgroups are past the device limit {}",
+            c.max_compute_workgroups_per_dimension
+        ));
+    }
+    let mut entries = 0u64;
+    for b in &p.boxes {
+        let (x0, x1, y0, y1) = ranges(b, p);
+        if x0 <= x1 && y0 <= y1 {
+            entries = entries.saturating_add(u64::from(x1 - x0 + 1) * u64::from(y1 - y0 + 1));
+        }
+    }
+    if entries > MAX_ENTRIES {
+        return Err(format!("binning: {entries} facet-cell entries are past the limit {MAX_ENTRIES}"));
+    }
+    Ok(Plan { n, words, cells, in_bytes, out_bytes, groups })
+}
+
+/// The CPU twin of the kernel: the same f32 cell map, the same lists.
+/// The test oracle of the shader math on a machine without a GPU; never
+/// the fallback (the caller's f64 grid is the fallback).
+pub fn bin_twin(p: &PaddedBoxes) -> CellLists {
+    let cells = (p.nx as usize).saturating_mul(p.ny as usize);
+    let mut lists: Vec<Vec<u32>> = vec![Vec::new(); cells];
+    for (i, b) in p.boxes.iter().enumerate() {
+        let (x0, x1, y0, y1) = ranges(b, p);
+        for cy in y0..=y1 {
+            for cx in x0..=x1 {
+                let c = (cy as usize).saturating_mul(p.nx as usize).saturating_add(cx as usize);
+                if let Some(l) = lists.get_mut(c) {
+                    l.push(i as u32);
+                }
+            }
+        }
+    }
+    CellLists::from_lists(p.nx, p.ny, lists)
+}
diff --git a/crates/gpu/src/binning.wgsl b/crates/gpu/src/binning.wgsl
new file mode 100644
index 000000000..42b338746
--- /dev/null
+++ b/crates/gpu/src/binning.wgsl
@@ -0,0 +1,48 @@
+// Conservative facet binning (#2620): one invocation per facet box sets the
+// facet's bit in every cell its box touches. Bit sets give each cell its
+// facets once each, in ascending index, with no sort. The cell map is the
+// f32 twin `cell32` in binning.rs. Provenance: uniform-grid partitioning
+// from C. Ericson, "Real-Time Collision Detection" (2005), ch. 7.
+
+struct Params {
+    nx: u32,
+    ny: u32,
+    n: u32,
+    words: u32,
+    s: f32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+}
+
+@group(0) @binding(0) var<uniform> params: Params;
+@group(0) @binding(1) var<storage, read> boxes: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> bits: array<atomic<u32>>;
+
+fn cell(v: f32, n: u32) -> u32 {
+    let t = floor(v / params.s);
+    if (!(t > 0.0)) {
+        return 0u;
+    }
+    return u32(min(t, f32(n - 1u)));
+}
+
+@compute @workgroup_size(64)
+fn cs_bin(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let i = gid.x;
+    if (i >= params.n) {
+        return;
+    }
+    let b = boxes[i];
+    let x0 = cell(b.x, params.nx);
+    let x1 = cell(b.z, params.nx);
+    let y0 = cell(b.y, params.ny);
+    let y1 = cell(b.w, params.ny);
+    let w = i / 32u;
+    let m = 1u << (i % 32u);
+    for (var cy = y0; cy <= y1; cy = cy + 1u) {
+        for (var cx = x0; cx <= x1; cx = cx + 1u) {
+            atomicOr(&bits[(cy * params.nx + cx) * params.words + w], m);
+        }
+    }
+}
diff --git a/crates/gpu/src/binning_gpu.rs b/crates/gpu/src/binning_gpu.rs
new file mode 100644
index 000000000..06b13cd6f
--- /dev/null
+++ b/crates/gpu/src/binning_gpu.rs
@@ -0,0 +1,167 @@
+//! The GPU half of conservative facet binning (#2620): upload the padded
+//! boxes, dispatch `binning.wgsl`, read the cell bit sets back. Every
+//! failure (a plan past the device limits, a validation error, a failed
+//! map, a lost device) is an `Err` with the reason, and the caller keeps
+//! its CPU f64 grid. The result is only a filter: the caller's exact f64
+//! test still decides every facet. Provenance: our own dispatch over
+//! wgpu's public compute API.
+
+use std::sync::mpsc;
+
+use crate::adapter::HeadlessGpu;
+use crate::binning::{pad_boxes, plan, CellLists, GridSpec, PaddedBoxes, Plan};
+use crate::shared::shared_device;
+use crate::switch::{env_switch, log_fallback_once};
+
+const SHADER: &str = include_str!("binning.wgsl");
+
+/// Bin `boxes` (f64, tool radius already added) on the process's shared
+/// device. `Err` names why the GPU did not run; that reason is logged one
+/// time for each process, and the caller runs its CPU grid.
+pub fn bin_facets(boxes: &[[f64; 4]], spec: &GridSpec) -> Result<CellLists, String> {
+    let run = || -> Result<CellLists, String> {
+        env_switch()?;
+        let padded = pad_boxes(boxes, spec)?;
+        let gpu = shared_device()?;
+        bin_on(gpu, &padded)
+    };
+    run().inspect_err(|e| log_fallback_once(e))
+}
+
+/// Bin the padded boxes on `gpu`. Blocks until the read-back is done.
+pub fn bin_on(gpu: &HeadlessGpu, boxes: &PaddedBoxes) -> Result<CellLists, String> {
+    let compute = gpu.compute.as_ref().map_err(Clone::clone)?;
+    let p = plan(boxes, compute)?;
+    if p.n == 0 {
+        return Ok(CellLists::from_lists(boxes.nx, boxes.ny, vec![Vec::new(); p.cells as usize]));
+    }
+    let scope = gpu.device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let read = dispatch(gpu, boxes, &p);
+    if let Some(err) = pollster::block_on(scope.pop()) {
+        return Err(format!("binning: GPU validation error: {err}"));
+    }
+    let bits = read_back(gpu, &read?, &p)?;
+    Ok(CellLists::from_bits(&p, boxes.nx, boxes.ny, &bits))
+}
+
+fn params_bytes(boxes: &PaddedBoxes, p: &Plan) -> Vec<u8> {
+    let mut v = Vec::with_capacity(32);
+    for w in [boxes.nx, boxes.ny, p.n, p.words] {
+        v.extend_from_slice(&w.to_le_bytes());
+    }
+    v.extend_from_slice(&boxes.s.to_le_bytes());
+    v.extend_from_slice(&[0u8; 12]);
+    v
+}
+
+fn box_bytes(boxes: &PaddedBoxes) -> Vec<u8> {
+    let mut v = Vec::with_capacity(boxes.boxes.len().saturating_mul(16));
+    for b in &boxes.boxes {
+        for f in b {
+            v.extend_from_slice(&f.to_le_bytes());
+        }
+    }
+    v
+}
+
+fn storage_entry(binding: u32, read_only: bool) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::COMPUTE,
+        ty: wgpu::BindingType::Buffer {
+            ty: wgpu::BufferBindingType::Storage { read_only },
+            has_dynamic_offset: false,
+            min_binding_size: None,
+        },
+        count: None,
+    }
+}
+
+/// Record and submit the dispatch; the staging buffer to read.
+fn dispatch(gpu: &HeadlessGpu, boxes: &PaddedBoxes, p: &Plan) -> Result<wgpu::Buffer, String> {
+    let dev = &gpu.device;
+    let shader = dev.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: Some("camcraft-gpu binning"),
+        source: wgpu::ShaderSource::Wgsl(SHADER.into()),
+    });
+    let uniform = wgpu::BindGroupLayoutEntry {
+        binding: 0,
+        visibility: wgpu::ShaderStages::COMPUTE,
+        ty: wgpu::BindingType::Buffer {
+            ty: wgpu::BufferBindingType::Uniform,
+            has_dynamic_offset: false,
+            min_binding_size: None,
+        },
+        count: None,
+    };
+    let bgl = dev.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("camcraft-gpu binning"),
+        entries: &[uniform, storage_entry(1, true), storage_entry(2, false)],
+    });
+    let layout = dev.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+        label: Some("camcraft-gpu binning"),
+        bind_group_layouts: &[Some(&bgl)],
+        immediate_size: 0,
+    });
+    let pipeline = dev.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+        label: Some("camcraft-gpu binning"),
+        layout: Some(&layout),
+        module: &shader,
+        entry_point: Some("cs_bin"),
+        compilation_options: Default::default(),
+        cache: None,
+    });
+    let buf = |label, size, usage| {
+        dev.create_buffer(&wgpu::BufferDescriptor { label: Some(label), size, usage, mapped_at_creation: false })
+    };
+    use wgpu::BufferUsages as U;
+    let params = buf("binning params", 32, U::UNIFORM | U::COPY_DST);
+    let input = buf("binning boxes", p.in_bytes, U::STORAGE | U::COPY_DST);
+    let bits = buf("binning bits", p.out_bytes, U::STORAGE | U::COPY_SRC);
+    let read = buf("binning read", p.out_bytes, U::MAP_READ | U::COPY_DST);
+    gpu.queue.write_buffer(&params, 0, &params_bytes(boxes, p));
+    gpu.queue.write_buffer(&input, 0, &box_bytes(boxes));
+    let group = dev.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: Some("camcraft-gpu binning"),
+        layout: &bgl,
+        entries: &[
+            wgpu::BindGroupEntry { binding: 0, resource: params.as_entire_binding() },
+            wgpu::BindGroupEntry { binding: 1, resource: input.as_entire_binding() },
+            wgpu::BindGroupEntry { binding: 2, resource: bits.as_entire_binding() },
+        ],
+    });
+    let mut enc = dev.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("camcraft-gpu binning") });
+    {
+        let mut pass = enc.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Some("binning"), timestamp_writes: None });
+        pass.set_pipeline(&pipeline);
+        pass.set_bind_group(0, &group, &[]);
+        pass.dispatch_workgroups(p.groups, 1, 1);
+    }
+    enc.copy_buffer_to_buffer(&bits, 0, &read, 0, p.out_bytes);
+    gpu.queue.submit([enc.finish()]);
+    Ok(read)
+}
+
+fn read_back(gpu: &HeadlessGpu, read: &wgpu::Buffer, p: &Plan) -> Result<Vec<u32>, String> {
+    let (tx, rx) = mpsc::channel();
+    read.slice(..).map_async(wgpu::MapMode::Read, move |r| {
+        let _ = tx.send(r);
+    });
+    gpu.device
+        .poll(wgpu::PollType::wait_indefinitely())
+        .map_err(|e| format!("binning: the GPU poll failed: {e}"))?;
+    match rx.recv() {
+        Ok(Ok(())) => {}
+        Ok(Err(e)) => return Err(format!("binning: the read-back map failed: {e}")),
+        Err(_) => return Err("binning: the read-back map never completed".into()),
+    }
+    let words = {
+        let view = read.get_mapped_range(..).map_err(|e| format!("binning: the read-back range failed: {e:?}"))?;
+        if view.len() as u64 != p.out_bytes {
+            return Err(format!("binning: the read-back has {} bytes, not {}", view.len(), p.out_bytes));
+        }
+        view.as_chunks::<4>().0.iter().map(|c| u32::from_le_bytes(*c)).collect()
+    };
+    read.unmap();
+    Ok(words)
+}
diff --git a/crates/gpu/src/lib.rs b/crates/gpu/src/lib.rs
new file mode 100644
index 000000000..46641ca51
--- /dev/null
+++ b/crates/gpu/src/lib.rs
@@ -0,0 +1,32 @@
+//! camcraft-gpu: the headless GPU compute seam (#2620). One windowless
+//! device for each process, a capability probe, the off switch and the
+//! CPU fallback rule, and the first kernel (conservative facet binning).
+//! Provenance: our own seam over wgpu's public API; the binning law is
+//! uniform-grid partitioning from C. Ericson, "Real-Time Collision
+//! Detection" (2005), ch. 7.
+//!
+//! The fallback rule: every entry answers `Result`. An `Err` names the
+//! reason (no adapter, no compute, the switch is off, a lost device, a
+//! buffer past the limit, a failed kernel or read-back), and the caller
+//! runs its own CPU code. A GPU answer is only a filter: the caller's f64
+//! law stays the judge, so no posted output depends on this crate.
+
+mod adapter;
+pub mod binning;
+#[cfg(not(target_arch = "wasm32"))]
+mod binning_gpu;
+pub mod probe;
+#[cfg(not(target_arch = "wasm32"))]
+mod shared;
+pub mod switch;
+
+pub use adapter::{device_async, gpu_required, AdapterKind, HeadlessGpu, REQUIRE_GPU_ENV};
+#[cfg(not(target_arch = "wasm32"))]
+pub use adapter::{device, device_for_test};
+pub use binning::{bin_twin, pad_boxes, plan, CellLists, GridSpec, PaddedBoxes, Plan};
+#[cfg(not(target_arch = "wasm32"))]
+pub use binning_gpu::{bin_facets, bin_on};
+pub use probe::{probe, Compute};
+#[cfg(not(target_arch = "wasm32"))]
+pub use shared::shared_device;
+pub use switch::{compute_switch, COMPUTE_ENV};
diff --git a/crates/gpu/src/probe.rs b/crates/gpu/src/probe.rs
new file mode 100644
index 000000000..f70210790
--- /dev/null
+++ b/crates/gpu/src/probe.rs
@@ -0,0 +1,92 @@
+//! The compute capability probe (#2620): can this device run our kernels,
+//! and within which limits. WebGL2 and GL below ES 3.1 have no compute
+//! shaders; the probe says "no compute" by name, and the caller runs its
+//! CPU code. Provenance: our own rule over wgpu's public
+//! `DownlevelFlags` and `Limits` fields.
+
+/// Workgroup width of every kernel in this crate (`@workgroup_size(64)`).
+pub const WORKGROUP: u32 = 64;
+
+/// The limits a kernel plans against: read from the device, never assumed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Compute {
+    pub max_storage_buffer_binding_size: u64,
+    pub max_buffer_size: u64,
+    pub max_compute_workgroup_storage_size: u32,
+    pub max_compute_workgroups_per_dimension: u32,
+}
+
+/// What the device can compute, or why it cannot. `backend` and
+/// `downlevel` come from the adapter, `limits` from the device (the limits
+/// that it was made with, which can be lower than the adapter's).
+pub fn probe(
+    backend: wgpu::Backend,
+    downlevel: &wgpu::DownlevelCapabilities,
+    limits: &wgpu::Limits,
+) -> Result<Compute, String> {
+    if !downlevel.flags.contains(wgpu::DownlevelFlags::COMPUTE_SHADERS) {
+        return Err(if backend == wgpu::Backend::Gl {
+            "no compute: WebGL2 or GL below ES 3.1 (the Gl adapter has no compute shaders)".into()
+        } else {
+            format!("no compute: the {backend:?} adapter has no compute shaders")
+        });
+    }
+    let need = [
+        ("max_compute_workgroup_storage_size", u64::from(limits.max_compute_workgroup_storage_size), 1),
+        ("max_compute_workgroups_per_dimension", u64::from(limits.max_compute_workgroups_per_dimension), 1),
+        ("max_compute_invocations_per_workgroup", u64::from(limits.max_compute_invocations_per_workgroup), u64::from(WORKGROUP)),
+        ("max_compute_workgroup_size_x", u64::from(limits.max_compute_workgroup_size_x), u64::from(WORKGROUP)),
+        ("max_storage_buffers_per_shader_stage", u64::from(limits.max_storage_buffers_per_shader_stage), 2),
+        ("max_storage_buffer_binding_size", limits.max_storage_buffer_binding_size, 4),
+        ("max_buffer_size", limits.max_buffer_size, 4),
+    ];
+    for (name, have, min) in need {
+        if have < min {
+            return Err(format!("no compute: the device limit {name} is {have}, the kernels need {min}"));
+        }
+    }
+    Ok(Compute {
+        max_storage_buffer_binding_size: limits.max_storage_buffer_binding_size,
+        max_buffer_size: limits.max_buffer_size,
+        max_compute_workgroup_storage_size: limits.max_compute_workgroup_storage_size,
+        max_compute_workgroups_per_dimension: limits.max_compute_workgroups_per_dimension,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn full() -> wgpu::DownlevelCapabilities {
+        wgpu::DownlevelCapabilities::default()
+    }
+
+    #[test]
+    fn webgl2_like_downlevel_set_says_no_compute_by_name() {
+        let gl = wgpu::DownlevelCapabilities { flags: wgpu::DownlevelFlags::empty(), ..full() };
+        let lim = wgpu::Limits::downlevel_webgl2_defaults();
+        let err = probe(wgpu::Backend::Gl, &gl, &lim).err().unwrap_or_default();
+        assert!(err.contains("no compute") && err.contains("WebGL2"), "{err}");
+    }
+
+    #[test]
+    fn missing_compute_flag_on_another_backend_names_the_backend() {
+        let caps = wgpu::DownlevelCapabilities { flags: wgpu::DownlevelFlags::empty(), ..full() };
+        let err = probe(wgpu::Backend::Vulkan, &caps, &wgpu::Limits::default()).err().unwrap_or_default();
+        assert!(err.contains("no compute") && err.contains("Vulkan"), "{err}");
+    }
+
+    #[test]
+    fn zero_workgroup_storage_is_no_compute() {
+        let lim = wgpu::Limits { max_compute_workgroup_storage_size: 0, ..wgpu::Limits::default() };
+        let err = probe(wgpu::Backend::Vulkan, &full(), &lim).err().unwrap_or_default();
+        assert!(err.contains("max_compute_workgroup_storage_size"), "{err}");
+    }
+
+    #[test]
+    fn default_limits_with_compute_pass_the_probe() {
+        let c = probe(wgpu::Backend::Vulkan, &full(), &wgpu::Limits::default());
+        let lim = wgpu::Limits::default();
+        assert_eq!(c.map(|c| c.max_storage_buffer_binding_size), Ok(lim.max_storage_buffer_binding_size));
+    }
+}
diff --git a/crates/gpu/src/shared.rs b/crates/gpu/src/shared.rs
new file mode 100644
index 000000000..e55eafcff
--- /dev/null
+++ b/crates/gpu/src/shared.rs
@@ -0,0 +1,36 @@
+//! The one compute device of the process (#2620): made on the first
+//! request, cached for the life of the process, never made for each
+//! operation or each frame. It is never dropped: a device made and dropped
+//! in one process can race its sibling processes in the driver
+//! (`crates/ui/tests/gpu_render.rs`, the shared device note).
+//! Provenance: our own policy over wgpu's public device API.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+
+use crate::adapter::{device, HeadlessGpu};
+use crate::switch::env_switch;
+
+static SHARED: OnceLock<Result<HeadlessGpu, String>> = OnceLock::new();
+static LOST: AtomicBool = AtomicBool::new(false);
+
+/// The process's compute device, or why there is none: the switch is off,
+/// no adapter, the probe found no compute, or the device was lost. A lost
+/// device is not made again: the CPU path runs for the rest of the process.
+pub fn shared_device() -> Result<&'static HeadlessGpu, String> {
+    env_switch()?;
+    let made = SHARED.get_or_init(|| {
+        let gpu = device()?;
+        gpu.device.set_device_lost_callback(|reason, msg| {
+            LOST.store(true, Ordering::SeqCst);
+            tracing::warn!(target: "camcraft::gpu", "GPU compute device lost ({reason:?}): {msg}");
+        });
+        Ok(gpu)
+    });
+    let gpu = made.as_ref().map_err(Clone::clone)?;
+    if LOST.load(Ordering::SeqCst) {
+        return Err(format!("the GPU device {} was lost", gpu.name));
+    }
+    gpu.compute.as_ref().map_err(|e| format!("{e} ({})", gpu.name))?;
+    Ok(gpu)
+}
diff --git a/crates/gpu/src/switch.rs b/crates/gpu/src/switch.rs
new file mode 100644
index 000000000..92f4f80d4
--- /dev/null
+++ b/crates/gpu/src/switch.rs
@@ -0,0 +1,74 @@
+//! The GPU compute off switch and the once-only fallback log (#2620).
+//! `CAMCRAFT_GPU_COMPUTE=off` keeps every kernel on the CPU path: for
+//! tests, and for machines with bad drivers (#2424, #74). It does not
+//! touch the window's adapter choice (`CAMCRAFT_GPU`, `CAMCRAFT_GPU_BACKEND`).
+//! Provenance: our own rule.
+
+use std::sync::Mutex;
+
+/// The env var of the switch.
+pub const COMPUTE_ENV: &str = "CAMCRAFT_GPU_COMPUTE";
+
+/// The switch for one value of `CAMCRAFT_GPU_COMPUTE`: `Err` (the reason)
+/// for `off`, `0`, `false` or `no` in any case; `Ok` when unset or any
+/// other value.
+pub fn compute_switch(value: Option<&str>) -> Result<(), String> {
+    let off = value.map(|v| v.trim().to_ascii_lowercase()).is_some_and(|v| {
+        matches!(v.as_str(), "off" | "0" | "false" | "no")
+    });
+    if off {
+        Err(format!("GPU compute is off ({COMPUTE_ENV}=off)"))
+    } else {
+        Ok(())
+    }
+}
+
+/// The switch as the process environment sets it.
+#[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+pub(crate) fn env_switch() -> Result<(), String> {
+    compute_switch(std::env::var(COMPUTE_ENV).ok().as_deref())
+}
+
+/// Reasons already logged; bounded, so a stream of distinct reasons cannot grow it.
+#[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+static LOGGED: Mutex<Vec<String>> = Mutex::new(Vec::new());
+#[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+const LOG_CAP: usize = 32;
+
+/// Log a fallback reason one time for each process. A poisoned lock still
+/// logs: a lost diagnostic is worse than a repeated one.
+#[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+pub(crate) fn log_fallback_once(reason: &str) {
+    let first = match LOGGED.lock() {
+        Ok(mut seen) => {
+            if seen.iter().any(|s| s == reason) {
+                false
+            } else {
+                if seen.len() < LOG_CAP {
+                    seen.push(reason.to_string());
+                }
+                true
+            }
+        }
+        Err(_) => true,
+    };
+    if first {
+        tracing::warn!(target: "camcraft::gpu", "GPU compute not used, the CPU path runs: {reason}");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn off_values_turn_compute_off_by_name() {
+        for v in ["off", "OFF", " 0 ", "false", "No"] {
+            let err = compute_switch(Some(v)).err().unwrap_or_default();
+            assert!(err.contains(COMPUTE_ENV), "{v}: {err}");
+        }
+        for v in [None, Some("on"), Some("1"), Some("")] {
+            assert_eq!(compute_switch(v), Ok(()), "{v:?}");
+        }
+    }
+}
diff --git a/crates/gpu/tests/bin_parity.rs b/crates/gpu/tests/bin_parity.rs
new file mode 100644
index 000000000..85bfaac65
--- /dev/null
+++ b/crates/gpu/tests/bin_parity.rs
@@ -0,0 +1,97 @@
+//! Parity of the conservative binning (#2620) with the f64 support facet
+//! grid of #2619, read from the fixture that camcraft-motion records
+//! (`fixtures/facet_grid_2619.grid`). The law: each facet that the f64
+//! grid puts in a cell is in that cell's GPU (or twin) list too.
+//! The CPU twin always runs; the GPU path runs when the machine has an
+//! adapter with compute, and the test prints which path ran.
+//! Gate map: covers camcraft_gpu::binning, camcraft_gpu::binning_gpu,
+//! camcraft_gpu::shared. Our own tests.
+
+use camcraft_gpu::{
+    bin_facets, bin_on, bin_twin, gpu_required, pad_boxes, shared_device, CellLists, GridSpec,
+};
+
+const FIXTURE: &str = include_str!("fixtures/facet_grid_2619.grid");
+
+struct Fixture {
+    spec: GridSpec,
+    boxes: Vec<[f64; 4]>,
+    cells: Vec<Vec<u32>>,
+}
+
+fn nums<T: std::str::FromStr>(it: std::str::SplitWhitespace<'_>, line: &str) -> Vec<T> {
+    it.map(|t| t.parse().unwrap_or_else(|_| panic!("bad number in fixture line: {line}"))).collect()
+}
+
+fn fixture() -> Fixture {
+    let mut spec = None;
+    let mut boxes = Vec::new();
+    let mut cells = Vec::new();
+    for line in FIXTURE.lines().map(str::trim).filter(|l| !l.is_empty() && !l.starts_with('#')) {
+        let mut it = line.split_whitespace();
+        match it.next() {
+            Some("grid") => {
+                let v: Vec<f64> = nums(it, line);
+                assert_eq!(v.len(), 5, "{line}");
+                let (nx, ny) = (v[3] as u32, v[4] as u32);
+                spec = Some(GridSpec { x0: v[0], y0: v[1], s: v[2], nx, ny });
+                cells = vec![Vec::new(); (nx * ny) as usize];
+            }
+            Some("box") => {
+                let v: Vec<f64> = nums(it, line);
+                boxes.push([v[0], v[1], v[2], v[3]]);
+            }
+            Some("cell") => {
+                let v: Vec<u32> = nums(it, line);
+                cells[v[0] as usize] = v[1..].to_vec();
+            }
+            _ => panic!("unknown fixture line: {line}"),
+        }
+    }
+    Fixture { spec: spec.expect("the fixture has a grid line"), boxes, cells }
+}
+
+/// Each f64 entry is in the binned list; the lists ascend with no repeat.
+fn assert_superset(f: &Fixture, got: &CellLists, path: &str) -> (usize, usize) {
+    assert_eq!(got.cells(), f.cells.len(), "{path}: cell count");
+    let (mut want, mut have) = (0, 0);
+    for (c, cpu) in f.cells.iter().enumerate() {
+        let g = got.cell(c);
+        assert!(g.windows(2).all(|w| w[0] < w[1]), "{path}: cell {c} not strictly ascending: {g:?}");
+        for i in cpu {
+            assert!(g.binary_search(i).is_ok(), "{path}: facet {i} missing from cell {c} (f64 {cpu:?}, got {g:?})");
+        }
+        want += cpu.len();
+        have += g.len();
+    }
+    (want, have)
+}
+
+#[test]
+fn twin_bins_hold_every_f64_grid_entry() {
+    let f = fixture();
+    assert!(f.boxes.len() > 32 && f.cells.iter().any(|c| c.len() > 1), "the fixture is not trivial");
+    let padded = pad_boxes(&f.boxes, &f.spec).expect("the fixture pads");
+    let (want, have) = assert_superset(&f, &bin_twin(&padded), "CPU twin");
+    eprintln!("bin_parity: CPU twin path ran ({want} f64 entries, {have} binned)");
+}
+
+#[test]
+fn gpu_bins_hold_every_f64_grid_entry_when_an_adapter_exists() {
+    let f = fixture();
+    let padded = pad_boxes(&f.boxes, &f.spec).expect("the fixture pads");
+    let gpu = match shared_device() {
+        Ok(gpu) => gpu,
+        Err(why) => {
+            assert!(!gpu_required() || why.contains("off"), "CAMCRAFT_REQUIRE_GPU=1 but {why}");
+            assert!(bin_facets(&f.boxes, &f.spec).is_err(), "no device: bin_facets must fall back");
+            eprintln!("*** bin_parity: GPU path SKIPPED - NOT a pass: {why} ***");
+            return;
+        }
+    };
+    let got = bin_on(gpu, &padded).unwrap_or_else(|e| panic!("GPU binning on {}: {e}", gpu.name));
+    let (want, have) = assert_superset(&f, &got, "GPU");
+    let via = bin_facets(&f.boxes, &f.spec).unwrap_or_else(|e| panic!("bin_facets on {}: {e}", gpu.name));
+    assert_eq!(via, got, "bin_facets and bin_on agree on one device");
+    eprintln!("bin_parity: GPU path ran on the {} adapter {} ({want} f64 entries, {have} binned)", gpu.kind.label(), gpu.name);
+}
