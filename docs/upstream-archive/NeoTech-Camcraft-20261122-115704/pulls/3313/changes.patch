diff --git a/docs/decisions/3276-site-app-artifact.md b/docs/decisions/3276-site-app-artifact.md
new file mode 100644
index 000000000..f07250762
--- /dev/null
+++ b/docs/decisions/3276-site-app-artifact.md
@@ -0,0 +1,50 @@
+## #3276 - A `site_only` dispatch takes the browser build of an earlier run
+
+**Decided:** `release.yml` gets a second optional input on its existing
+`workflow_dispatch`: `app_run_id` (string, default empty). When
+`site_only` is true and `app_run_id` is not empty, the `site` job:
+
+- checks that the id has only digits, and stops the job if not;
+- downloads the `wasm-app` artifact of that run
+  (`actions/download-artifact@v4` with `run-id` and `github-token:
+  ${{ github.token }}`), with no `continue-on-error`;
+- runs `web/check-app-page.sh` on the download and again on its copy at
+  app/, as before. On this path a failed download or check is an error,
+  so the site job fails and `pages` deploys nothing.
+
+The `site` job gets the permission `actions: read`, and nothing more, so
+that the job token can read the artifacts of the other run. The input
+goes to scripts only through `env:`, never through `${{ }}` in a `run:`
+script. The tag path, a plain dispatch and a `site_only` dispatch
+without `app_run_id` keep their behaviour: the same download step from
+this run, the same warnings, the same "not part of this copy" page.
+
+The 0.25.0 dispatch is `gh workflow run release.yml --ref site/v0.25.0
+-f site_only=true -f app_run_id=44976953856`. The run 44976953856 is the
+v0.25.0 tag run. As before, the same `release.yml` goes on
+`site/v0.25.0` as one commit, byte-identical to the one on `main`,
+because a dispatch uses the workflow file of the dispatched ref.
+
+**Why:** a `site_only` run skips the `wasm` job, so run 45004413935
+deployed app/ as the "not part of this copy" page. The `wasm-app`
+artifact of the tag run is the exact 0.25.0 browser build: it was built
+from the tagged tree and passed `web/check-app-page.sh` in that run. The
+site job is strict on this path because the dispatcher asked for that
+app by name: a site without it is not what was asked, and a failed job
+leaves the deployed site as it is.
+
+**Dropped:**
+- A `wasm` build in the `site_only` run, from the site branch: it is a
+  new build of a tree that is not the tag (the site branch has site and
+  docs commits on top), it costs up to 45 minutes of runner time, and it
+  can differ from the shipped app.
+- A re-run of the tag run 44976953856: it runs the full platform build
+  again and its `publish` job again on the existing release.
+- The same warnings as the own-run path on a failed download: a deploy
+  without the asked-for app would hide the failure in a green run.
+
+**Cost to change later:** remove the input, the two steps that the
+`app_run_id` condition guards, the `APP_RUN_ID` env lines and their two
+`if [ -n "$APP_RUN_ID" ]` branches, and `actions: read`. The artifact of a
+run expires after the retention period (90 days by default); after that,
+the input cannot bring that app back.
diff --git a/xtask/tests/release_site_tests.rs b/xtask/tests/release_site_tests.rs
index 53097993c..3932cafcd 100644
--- a/xtask/tests/release_site_tests.rs
+++ b/xtask/tests/release_site_tests.rs
@@ -91,3 +91,71 @@ fn site_only_dispatch_runs_only_site_and_pages() {
         "a site_only dispatch deploys only from a site/* branch: {pages}"
     );
 }
+
+/// The steps of the site job, each from its `      - ` line to the next.
+fn site_steps() -> Vec<String> {
+    let job = site_job();
+    let steps = job.split_once("\n    steps:\n").expect("the site job has steps").1;
+    steps.split("\n      - ").map(|s| s.trim_start_matches("      - ").to_string()).collect()
+}
+
+#[test]
+fn site_only_dispatch_can_take_the_app_of_an_earlier_run() {
+    // #3276: an optional string input on the same workflow_dispatch, empty by default.
+    let wf = workflow();
+    let on = wf.split_once("\non:\n").expect("release.yml has an on: block").1;
+    let on = on.split_once("\n\n").map_or(on, |(head, _)| head);
+    let input = on.split_once("      app_run_id:\n").expect("workflow_dispatch has the app_run_id input").1;
+    assert!(input.contains("        type: string\n        default: ''"), "app_run_id is a string, empty by default:\n{on}");
+
+    // The site job may read the artifacts of another run: actions: read, and nothing more.
+    let job = site_job();
+    let perms = job.split_once("\n    permissions:\n").expect("the site job has permissions").1;
+    let perms: Vec<&str> = perms.lines().take_while(|l| l.starts_with("      ")).map(str::trim).collect();
+    assert_eq!(perms, ["contents: read", "actions: read"], "site job permissions");
+
+    let steps = site_steps();
+    let downloads: Vec<&String> =
+        steps.iter().filter(|s| s.starts_with("uses: actions/download-artifact@v4")).collect();
+    assert_eq!(downloads.len(), 2, "one download from this run, one from app_run_id");
+
+    // The download from this run is unchanged: only after a successful wasm job.
+    let own = downloads[0];
+    assert!(own.contains("if: ${{ needs.wasm.result == 'success' }}"), "{own}");
+    assert!(own.contains("continue-on-error: true"), "{own}");
+    assert!(!own.contains("run-id:"), "{own}");
+
+    // The earlier run's download: only on site_only with an id, with the job token, strict.
+    let earlier = downloads[1];
+    assert!(earlier.contains("if: ${{ inputs.site_only && inputs.app_run_id != '' }}"), "{earlier}");
+    assert!(earlier.contains("name: wasm-app"), "{earlier}");
+    assert!(earlier.contains("path: /tmp/wasm-app"), "{earlier}");
+    assert!(earlier.contains("run-id: ${{ inputs.app_run_id }}"), "{earlier}");
+    assert!(earlier.contains("github-token: ${{ github.token }}"), "{earlier}");
+    assert!(
+        !earlier.lines().any(|l| l.trim().starts_with("continue-on-error:")),
+        "a failed download of the asked-for app fails the site:\n{earlier}"
+    );
+
+    // The id is checked before the download, through env:.
+    let check = steps.iter().position(|s| s.starts_with("name: Earlier run of the browser build"));
+    let check = check.expect("a step checks app_run_id");
+    let download_at = steps.iter().position(|s| std::ptr::eq(s, earlier)).expect("the download is a step");
+    assert!(check < download_at, "the id is checked before the download");
+
+    // The downloaded app still passes web/check-app-page.sh, and a failure is an error.
+    let is_app = steps
+        .iter()
+        .find(|s| s.starts_with("name: Is there a browser build to publish"))
+        .expect("the site job decides if there is an app");
+    assert!(is_app.contains("APP_RUN_ID: ${{ inputs.site_only && inputs.app_run_id || '' }}"), "{is_app}");
+    assert!(is_app.contains("bash web/check-app-page.sh /tmp/wasm-app"), "{is_app}");
+    assert!(is_app.contains("::error::the wasm-app artifact of run $APP_RUN_ID"), "{is_app}");
+
+    // No input is interpolated into a run: script; inputs go through env:.
+    for step in &steps {
+        if let Some((_, script)) = step.split_once("run: |") {
+            assert!(!script.contains("${{ inputs."), "an input is interpolated in a script:\n{step}");
+        }
+    }
+}
