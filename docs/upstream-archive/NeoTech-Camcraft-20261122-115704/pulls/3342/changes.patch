From 7d3077d52ad788eab7b2a08754d052831fac3b47 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 22 Nov 2026 11:11:04 +0100
Subject: [PATCH] fix(ui): hiding the world axes no longer hides the ground
 grid

The guard in ground_grid_lines read both show_world_axes and show_grid.
The grid now follows show_grid alone, and the axes follow show_world_axes
alone. The hover texts, the doc comments and the law test change with it.
The Display menu test gets the missing direction: axes off, grid on.

Fixes #3322

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/display_menu.rs       | 4 ++--
 crates/ui/src/egui_app/tests/display_menu.rs | 2 ++
 crates/ui/src/interact.rs                    | 8 ++++----
 crates/ui/src/law_tests.rs                   | 9 +++++++--
 crates/ui/src/state.rs                       | 2 +-
 5 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/crates/ui/src/egui_app/display_menu.rs b/crates/ui/src/egui_app/display_menu.rs
index 07d717d34..48dd3cee9 100644
--- a/crates/ui/src/egui_app/display_menu.rs
+++ b/crates/ui/src/egui_app/display_menu.rs
@@ -107,10 +107,10 @@ fn entries(ui: &mut egui::Ui, state: &mut State) {
     ui.strong(GROUP_GRAPHICS);
     kept |= ui
         .checkbox(&mut state.show_grid, SHOW_GRID)
-        .on_hover_text("Show the ground grid below the model. The grid needs the origin axes.")
+        .on_hover_text("Show the ground grid below the model. The origin axes do not change it.")
         .changed();
     ui.checkbox(&mut state.show_world_axes, SHOW_AXES)
-        .on_hover_text("Show the axes of the world origin, and the ground grid with them.");
+        .on_hover_text("Show the axes of the world origin. The ground grid stays as it is.");
     ui.radio_value(&mut state.cam.projection, ProjectionMode::Perspective, PERSPECTIVE)
         .on_hover_text("Far objects look smaller, as the eye sees them.");
     ui.radio_value(&mut state.cam.projection, ProjectionMode::Orthographic, ORTHOGRAPHIC)
diff --git a/crates/ui/src/egui_app/tests/display_menu.rs b/crates/ui/src/egui_app/tests/display_menu.rs
index 3ec2d0d77..df7cf8186 100644
--- a/crates/ui/src/egui_app/tests/display_menu.rs
+++ b/crates/ui/src/egui_app/tests/display_menu.rs
@@ -86,6 +86,8 @@ fn the_graphics_entries_set_their_fields() {
     h.run_steps(2);
     assert!(!h.state().state.show_world_axes);
     assert_eq!(checked(&h, menu::SHOW_AXES), Some(Toggled::False));
+    assert!(h.state().state.show_grid, "the Origin axes box leaves the grid switch alone");
+    assert!(grid_lines(&h) > 0, "the grid still draws with the axes off (#3322)");
     // Projection: one choice of two.
     assert_eq!(h.state().state.cam.projection, ProjectionMode::Perspective);
     assert_eq!(checked(&h, menu::PERSPECTIVE), Some(Toggled::True));
diff --git a/crates/ui/src/interact.rs b/crates/ui/src/interact.rs
index 38cdf56c0..6d2d355ad 100644
--- a/crates/ui/src/interact.rs
+++ b/crates/ui/src/interact.rs
@@ -849,12 +849,12 @@ const GRID_MAJOR_EVERY: i64 = 5;
 /// at any zoom. World-space geometry in the overlay buffer, not a
 /// screen-space overlay, so the part occludes it like a real table.
 ///
-/// The same switch as the triads (`show_world_axes`): the grid is
-/// reference furniture, and hiding the axes hides it too. The Display
-/// menu's "Grid" box (`show_grid`, #2818) hides the grid alone. It fades
+/// Its own switch: the Display menu's "Grid" box (`show_grid`, #2818)
+/// hides the grid alone. The axes switch (`show_world_axes`) hides the axes
+/// alone and does not change the grid (#3322). It fades
 /// toward the viewport ground at the rim rather than stopping on a rectangle.
 pub(crate) fn ground_grid_lines(state: &State) -> Vec<[f32; 6]> {
-    if !state.show_world_axes || !state.show_grid {
+    if !state.show_grid {
         return Vec::new();
     }
     let step = nice_step(state.cam.dist / 10.0);
diff --git a/crates/ui/src/law_tests.rs b/crates/ui/src/law_tests.rs
index d490b374d..1e8a968bc 100644
--- a/crates/ui/src/law_tests.rs
+++ b/crates/ui/src/law_tests.rs
@@ -51,7 +51,7 @@ mod gizmo_tests {
 
     /// The Z=0 ground grid: the floor the empty viewport was missing. It is
     /// world-space overlay geometry on the table plane, spaced in 1-2-5
-    /// decades that follow the zoom, and it obeys the axes switch.
+    /// decades that follow the zoom, and only the Grid switch hides it.
     #[test]
     fn the_ground_grid_is_a_round_spaced_floor() {
         let mut state = State::new();
@@ -72,8 +72,13 @@ mod gizmo_tests {
             "the step follows the zoom: {:?}",
             coarse[0]
         );
+        // #3322: the axes switch hides the axes alone; the Grid switch hides the grid alone.
         state.show_world_axes = false;
-        assert!(ground_grid_lines(&state).is_empty(), "hiding the axes hides the floor");
+        assert!(!ground_grid_lines(&state).is_empty(), "hiding the axes leaves the floor");
+        state.show_grid = false;
+        assert!(ground_grid_lines(&state).is_empty(), "the Grid switch hides the floor");
+        state.show_world_axes = true;
+        assert!(ground_grid_lines(&state).is_empty(), "axes on does not bring the floor back");
     }
 
     /// #948: a non-finite or absurd camera must not stretch the grid's
diff --git a/crates/ui/src/state.rs b/crates/ui/src/state.rs
index 4e4e3a06a..2a44120d9 100644
--- a/crates/ui/src/state.rs
+++ b/crates/ui/src/state.rs
@@ -1813,7 +1813,7 @@ pub struct State {
     /// kept preference (`state_view`).
     pub ambient_occlusion: bool,
     /// Show the ground grid (#2818). View state and a kept preference;
-    /// the grid also needs `show_world_axes`.
+    /// the grid does not depend on `show_world_axes` (#3322).
     pub show_grid: bool,
     /// M1.7c move simulation: None while off, [`Sim`] while the
     /// transport bar is up. View state like the camera - what it holds
