From 1fc20d3d0e920d5d5c8901252e7e4c046e7be473 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 22 Nov 2026 12:26:30 +0100
Subject: [PATCH 2/2] test(app): accept only the advisory rings fallback in two
 Adaptive tests

PR #3108 makes an Adaptive fallback to the Offset rings an advisory
StrategyFallback warning. blind_slot and corner_relief_safety still
expected zero warnings. They now accept only that warning, with the
area count of the fallback notes, and require that it does not hold
the post; all other checks stay.

Fixes #3384

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/blind_slot.rs           | 12 ++++++++++--
 crates/app/tests/corner_relief_safety.rs | 13 ++++++++++++-
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/crates/app/tests/blind_slot.rs b/crates/app/tests/blind_slot.rs
index 40548ed4d..c6aed0384 100644
--- a/crates/app/tests/blind_slot.rs
+++ b/crates/app/tests/blind_slot.rs
@@ -137,9 +137,17 @@ fn blind_slot_pocket_family_cuts_from_end_wall_to_stock_edge() {
                 extension,
                 ..Default::default()
             };
-            let (path, warnings) = run(&world, &op(SrcRef::Selection(picks), params(kind), area))
+            let (path, warnings) = operation::generate(&world, &op(SrcRef::Selection(picks), params(kind), area), "")
                 .unwrap_or_else(|e| panic!("{kind:?}, extension {extension}: {e}"));
-            assert_eq!(warnings, 0, "{kind:?}");
+            // #3035: an Adaptive area that rides the Offset rings is one
+            // advisory warning (it does not hold the post); nothing else.
+            let fell = camcraft_app::machining2d::rings_fallbacks(&path.notes);
+            assert_eq!(warnings.len(), usize::from(fell > 0), "{kind:?}: {warnings:?}");
+            assert!(
+                warnings.iter().all(|w| matches!(w, Warning::StrategyFallback { areas, .. } if *areas == fell) && !w.blocks_post()),
+                "{kind:?}: only the advisory fallback: {warnings:?}\nnotes {:?}",
+                path.notes
+            );
             let cuts: Vec<_> = feeds(&path)
                 .into_iter()
                 .filter(|p| p.z < 20.0 - EPS)
diff --git a/crates/app/tests/corner_relief_safety.rs b/crates/app/tests/corner_relief_safety.rs
index ae4c785f6..0d0da17cd 100644
