From 4c11e92b73018b449e4b9602e2772544b3256d54 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 22 Nov 2026 05:37:10 +0100
Subject: [PATCH 1/2] fix(slot): regenerate the DXF-outline slot golden for the
 #2906 wall lap

#3136 (#2906) adds a wall lap that cuts the round ends of a slot wider
than the tool. Its branch did not contain #2920, so it did not regenerate
slot_dxf_outline.cl, and the post-merge gate went red on
a_slot_outline_seeds_the_slot_and_cuts_it_to_size from 6cd4f3e01 on.

The generator is correct: the golden is regenerated by the test's own
WRITE_GOLDEN path. The test now also asserts that each round end is cut
on its 3 mm cutter-centre arc and that no cutting move leaves the outline
at the tool radius.

Fixes #3278

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/golden/slot_dxf_outline.cl |  8 ++++-
 crates/app/tests/slot_dxf_sketch.rs         | 23 ++++++++++++++
 docs/decisions/3278-slot-dxf-golden.md      | 33 +++++++++++++++++++++
 3 files changed, 63 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/3278-slot-dxf-golden.md

diff --git a/crates/app/tests/golden/slot_dxf_outline.cl b/crates/app/tests/golden/slot_dxf_outline.cl
index 56e0347ac..1e97c910f 100644
--- a/crates/app/tests/golden/slot_dxf_outline.cl
+++ b/crates/app/tests/golden/slot_dxf_outline.cl
@@ -1,4 +1,4 @@
-; HSMW-CL v1 scale=0.001mm moves=9
+; HSMW-CL v2 scale=0.001mm moves=15
 START 45000 22000 20000
 Rapid 45000 22000 20000
 Rapid 45000 22000 12000
@@ -8,4 +8,10 @@ Feed 78000 25000 8000 F1200000
 Feed 42000 25000 8000 F1200000
 Feed 45000 28000 8000 F1200000
 Feed 75000 28000 8000 F1200000
+Feed 45000 28000 8000 F1200000
+Arc 42000 25000 8000 F1200000 I45000 J25000 S1
+Arc 45000 22000 8000 F1200000 I45000 J25000 S1
+Feed 75000 22000 8000 F1200000
+Arc 78000 25000 8000 F1200000 I75000 J25000 S1
+Arc 75000 28000 8000 F1200000 I75000 J25000 S1
 Rapid 75000 28000 20000
diff --git a/crates/app/tests/slot_dxf_sketch.rs b/crates/app/tests/slot_dxf_sketch.rs
index ffde4fc2d..3957637f3 100644
--- a/crates/app/tests/slot_dxf_sketch.rs
+++ b/crates/app/tests/slot_dxf_sketch.rs
@@ -156,6 +156,29 @@ fn a_slot_outline_seeds_the_slot_and_cuts_it_to_size() {
     let (x0, x1, y0, y1) = cut_box(&path, 10.0);
     assert!((x0 - 42.0).abs() < 0.02 && (x1 - 78.0).abs() < 0.02, "length to size: {x0}..{x1}");
     assert!((y0 - 22.0).abs() < 0.02 && (y1 - 28.0).abs() < 0.02, "width to size: {y0}..{y1}");
+    // #2906 / #3278: the 10 mm ends are wider than the 4 mm tool, so a wall lap rides
+    // each round end on the 3 mm cutter-centre arc about its arc centre.
+    for (cx, cy) in [(45.0, 25.0), (75.0, 25.0)] {
+        let on_end = path.moves.iter().any(|m| {
+            m.arc.is_some_and(|c| near(c.center, cx, cy))
+                && [m.from, m.to].iter().all(|p| ((p.x - cx).hypot(p.y - cy) - 3.0).abs() < 1e-3)
+        });
+        assert!(on_end, "the round end about ({cx}, {cy}) is cut on its wall arc");
+    }
+    // No cutting move leaves the outline at the tool radius: each end point lies in the
+    // cutter-centre stadium (3 mm about the axis (45, 25) -> (75, 25)), which is convex, so
+    // each line stays in it; each arc turns on a 3 mm circle about an axis end.
+    for m in path.moves.iter().filter(|m| m.kind != MoveKind::Rapid && m.to.z < 10.0 - 1e-6 && m.from.z < 10.0 - 1e-6) {
+        for p in [m.from, m.to] {
+            let off = (p.x.clamp(45.0, 75.0) - p.x).hypot(p.y - 25.0);
+            assert!(off < 3.0 + 1e-3, "{m:?} leaves the outline: {off} mm off the axis");
+        }
+        if let Some(c) = m.arc {
+            let r = (m.from.x - c.center.x).hypot(m.from.y - c.center.y);
+            assert!(near(c.center, 45.0, 25.0) || near(c.center, 75.0, 25.0), "{m:?}: an arc off the round ends");
+            assert!(r < 3.0 + 1e-3, "{m:?}: an arc of radius {r} leaves the outline");
+        }
+    }
     write_golden("slot_dxf_outline.cl", &gen_to_cltext(&path));
 
     let sim = simulate_document(&world).expect("simulate on the stock, with no solid model");
diff --git a/docs/decisions/3278-slot-dxf-golden.md b/docs/decisions/3278-slot-dxf-golden.md
new file mode 100644
index 000000000..53f9784b3
--- /dev/null
+++ b/docs/decisions/3278-slot-dxf-golden.md
@@ -0,0 +1,33 @@
+## #3278 - the DXF-outline slot golden follows the #2906 wall lap
+
+**What was decided.** `a_slot_outline_seeds_the_slot_and_cuts_it_to_size`
+(`crates/app/tests/slot_dxf_sketch.rs`, from #2920) failed on main after
+#3136 (#2906, "cut the round ends of a slot wider than the tool") merged.
+The code stays as #3136 made it. The golden `slot_dxf_outline.cl` is
+regenerated, and the test gets one more assert: each round end has an arc
+move on the 3 mm cutter-centre circle about its arc centre.
+
+**Why.** The two PRs were open at the same time. The branch of #3136 did
+not contain #2920, so #3136 regenerated the slot goldens that it knew
+(`slot_wide_channel_rows`) but not `slot_dxf_outline.cl`. The post-merge
+runs show the culprit: 5bc0b7129 is green (run 44977365067), 6cd4f3e01 (the
+merge of #3136) is red (run 44977387120) on this one test. Every assert of
+the test before the golden passed on main: the ends, the width, and the
+cut box 42..78 x 22..28. Only the golden compare failed.
+
+The new path is the old three rows (d = -3, 0, 3) plus one lap of the
+cutter-centre stadium: back along y = 28, a CCW arc about (45, 25) through
+the tip (42, 25) to (45, 22), along y = 22, a CCW arc about (75, 25)
+through (78, 25) to (75, 28). Each lap point is 3 mm (slot radius 5 minus
+tool radius 2) from its arc centre, so the lap cuts the wall to size and
+never leaves the outline. The old golden pinned rows that touch each round
+end only at their end points; that left up to h (1 - cos 45 deg) = 0.88 mm
+of material between them on each end. The old shape was the wrong one.
+The stock simulation of the test (`gouge_cells == 0`) passes on the new
+path.
+
+**Dropped.** A change to the slot generator: nothing in it was wrong for
+the DXF-outline slot. A wider tolerance on the golden: the golden is
+byte-exact by design.
+
+**Cost to change later.** None; one golden and one assert.

