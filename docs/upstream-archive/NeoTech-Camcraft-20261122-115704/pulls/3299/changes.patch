+    /// is not turned is not supported yet, and points at the 5-Axis kinds; a
     /// part lying flat on its axis points at Rotary Parallel.
     RotaryContour {
         tolerance: f64,
diff --git a/crates/motion/src/multiaxis/axis.rs b/crates/motion/src/multiaxis/axis.rs
index 75fcdc47f..38d820a3e 100644
--- a/crates/motion/src/multiaxis/axis.rs
+++ b/crates/motion/src/multiaxis/axis.rs
@@ -212,7 +212,7 @@ fn refusal(iso: bool) -> Result<Fit, GenError> {
     Err(GenError::Invalid(if iso {
         "every axis fits this model equally - it curves the same the world around; domed ground is 5-Axis Contour or Parallel work".into()
     } else {
-        "the model's normals share no rotation axis - a turned workpiece is rotary work; finish a freeform with the 5-Axis kinds".into()
+        "the model's normals share no rotation axis - it is not a shape of revolution, and the rotary kinds need one today; 4-axis work on a part clamped on A that is not turned (helical lobes, a carving) is not supported yet (#2772); on a 5-axis machine, finish a freeform with the 5-Axis kinds".into()
     }))
 }
 
diff --git a/crates/motion/src/multiaxis/axis_consensus_tests.rs b/crates/motion/src/multiaxis/axis_consensus_tests.rs
index ea90ffb05..a37b5993b 100644
--- a/crates/motion/src/multiaxis/axis_consensus_tests.rs
+++ b/crates/motion/src/multiaxis/axis_consensus_tests.rs
@@ -106,3 +106,16 @@ fn a_box_is_still_refused_by_name() {
     let e = fit_report(&f).expect_err("a box is not a surface of revolution");
     assert!(e.to_string().contains("share no rotation axis"), "{e}");
 }
+
+#[test]
+fn the_freeform_refusal_names_the_4_axis_case() {
+    // #2772: a 4-axis machine has no 5-axis kinds to turn to, so the
+    // refusal must say that a part clamped on A that is not turned is
+    // not supported yet, and name the issue that tracks it.
+    let mut f = Vec::new();
+    block(&mut f, (-5.0, 5.0), (-10.0, 10.0), (-30.0, 30.0));
+    let e = fit_report(&f).expect_err("a box is not a surface of revolution").to_string();
+    assert!(e.contains("not a shape of revolution"), "{e}");
+    assert!(e.contains("4-axis") && e.contains("#2772"), "{e}");
+    assert!(e.contains("5-Axis kinds"), "the 5-axis pointer stays: {e}");
+}
