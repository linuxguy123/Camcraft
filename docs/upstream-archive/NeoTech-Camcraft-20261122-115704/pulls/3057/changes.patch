diff --git a/crates/ui/src/egui_app/dxf_drop.rs b/crates/ui/src/egui_app/dxf_drop.rs
new file mode 100644
index 000000000..c8129020a
--- /dev/null
+++ b/crates/ui/src/egui_app/dxf_drop.rs
@@ -0,0 +1,64 @@
+//! A `.dxf` dropped on the window (#1863): the drawing is placed as a
+//! profile on the active setup's stock through the Stock page's own
+//! `ImportDxf` path (the units prompt included), not loaded like a model.
+//! With no stock the drop is refused by name and tells the user to make a
+//! stock first; nothing changes in the document.
+//!
+//! Provenance: our own code over egui's public dropped-file fields and
+//! this repo's #1862 commands; no vendor material consulted.
+
+use std::path::Path;
+
+use camcraft_app::{setup, sketch};
+
+use crate::state::{DxfSource, State};
+
+/// Is this a DXF drawing by its extension (any case)?
+pub(super) fn is_dxf(path: &Path) -> bool {
+    path.extension().and_then(|e| e.to_str()).is_some_and(|e| e.eq_ignore_ascii_case("dxf"))
+}
+
+fn label(path: &Path) -> String {
+    path.file_name().map_or_else(|| path.display().to_string(), |n| n.to_string_lossy().into_owned())
+}
+
+/// Place the one dropped `.dxf`, or refuse it by name.
+pub(super) fn take(state: &mut State, file: &std::sync::Arc<dyn egui::DroppedFile + Send + Sync>) {
+    let path = file.path().to_path_buf();
+    let name = label(&path);
+    let active = setup::active(&state.world);
+    if sketch::face_frame(&state.world, active.as_deref()).is_none() {
+        state.refuse_drop(format!(
+            "drop refused: {name} is a DXF profile - make a stock first (Setup > Stock), then drop it to place it on the stock top"
+        ));
+        return;
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        if path.is_file() {
+            state.import_dxf(DxfSource::Path(path), None);
+            return;
+        }
+        match file.bytes() {
+            Ok(data) => state.import_dxf(DxfSource::Bytes { name, data: data.into() }, None),
+            Err(why) => state.refuse_drop(format!("drop refused: {name} is not a readable file ({why})")),
+        }
+    }
+    #[cfg(target_arch = "wasm32")]
+    state.refuse_drop(format!(
+        "drop refused: {name} - placing a dropped DXF profile is not supported in the browser yet; use Setup > Stock > Add DXF profile in the desktop app"
+    ));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dxf_by_extension_in_any_case() {
+        assert!(is_dxf(Path::new("a/plate.dxf")));
+        assert!(is_dxf(Path::new("PLATE.DXF")));
+        assert!(!is_dxf(Path::new("plate.stl")));
+        assert!(!is_dxf(Path::new("dxf")));
+    }
+}
diff --git a/crates/ui/src/egui_app/dxf_units_dialog.rs b/crates/ui/src/egui_app/dxf_units_dialog.rs
new file mode 100644
index 000000000..a1e5a92e7
--- /dev/null
+++ b/crates/ui/src/egui_app/dxf_units_dialog.rs
@@ -0,0 +1,92 @@
+//! The DXF units prompt (#1863): a modal over the shell while a drawing
+//! that states no unit waits on `state.dxf_units_prompt`. It shows the
+//! drawing's size read each way, in millimeters and in inches, and asks
+//! the user to choose. Millimeters and Inches answer through the command
+//! queue; Cancel, Escape or a click on the backdrop places nothing. The
+//! unit is never guessed.
+//!
+//! Provenance: our own layout over egui's `Modal`, after the unsaved
+//! prompt (#107); no vendor material consulted.
+
+use egui::{Id, Modal};
+
+use camcraft_app::units::Unit;
+
+use crate::state::{CommandKind, State};
+
+/// Millimeters per inch.
+const MM_PER_IN: f64 = 25.4;
+
+/// A size number for the prompt: at most four decimals, no trailing zeros.
+fn fmt(v: f64) -> String {
+    let s = format!("{v:.4}");
+    s.trim_end_matches('0').trim_end_matches('.').to_owned()
+}
+
+/// The two readings of a `width` x `height` drawing: as millimeters and as
+/// inches, each with its size in the other unit.
+pub(crate) fn readings(width: f64, height: f64) -> [String; 2] {
+    [
+        format!(
+            "Read in millimeters: {} x {} mm ({} x {} in)",
+            fmt(width),
+            fmt(height),
+            fmt(width / MM_PER_IN),
+            fmt(height / MM_PER_IN)
+        ),
+        format!(
+            "Read in inches: {} x {} in ({} x {} mm)",
+            fmt(width),
+            fmt(height),
+            fmt(width * MM_PER_IN),
+            fmt(height * MM_PER_IN)
+        ),
+    ]
+}
+
+pub(crate) fn window(ctx: &egui::Context, state: &mut State) {
+    let Some(prompt) = state.dxf_units_prompt.as_ref() else {
+        return;
+    };
+    let file = prompt.source.label();
+    let [mm, inch] = readings(prompt.width, prompt.height);
+    let mut answer: Option<Option<Unit>> = None;
+    let response = Modal::new(Id::new("dxf-units-prompt")).show(ctx, |ui| {
+        ui.set_max_width(420.0);
+        ui.heading("DXF units");
+        ui.label(format!("{file} does not state its units. Choose the unit of its coordinates."));
+        ui.add_space(4.0);
+        ui.label(mm);
+        ui.label(inch);
+        ui.add_space(8.0);
+        ui.horizontal(|ui| {
+            if ui.button("Millimeters").clicked() {
+                answer = Some(Some(Unit::Millimeters));
+            }
+            if ui.button("Inches").clicked() {
+                answer = Some(Some(Unit::Inches));
+            }
+            if ui.button("Cancel").clicked() {
+                answer = Some(None);
+            }
+        });
+    });
+    if answer.is_none() && response.should_close() {
+        answer = Some(None);
+    }
+    if let Some(units) = answer {
+        state.pending.push_back(CommandKind::ResolveDxfUnits(units));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn readings_state_both_units_both_ways() {
+        let [mm, inch] = readings(80.0, 20.0);
+        assert_eq!(mm, "Read in millimeters: 80 x 20 mm (3.1496 x 0.7874 in)");
+        assert_eq!(inch, "Read in inches: 80 x 20 in (2032 x 508 mm)");
+    }
+}
