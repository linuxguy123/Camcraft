+# Original 100 x 60 x 12 mm block, Z0 to Z12.
+v -50 -30 0
+v 50 -30 0
+v 50 30 0
+v -50 30 0
+v -50 -30 12
+v 50 -30 12
+v 50 30 12
+v -50 30 12
+f 1 4 3 2
+f 5 6 7 8
+f 1 2 6 5
+f 2 3 7 6
+f 3 4 8 7
+f 4 1 5 8
