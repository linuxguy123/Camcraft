+++ b/crates/app/tests/example_catalog/case_probe_face.rs
@@ -0,0 +1,45 @@
+// Provenance: original CamCraft Probe-before-Face catalog contract (#2874).
+mod catalog_probing_probe_face {
+    use super::*;
+    use camcraft_app::{model, operation::OpType, project, setup, world};
+
+    #[test]
+    fn probes_before_first_cut() {
+        let dir = repo("examples/catalog/probing/probe-face");
+        assert!(dir.is_dir(), "catalog case probing/probe-face is missing");
+        let w = world::new_world();
+        let notes = project::load_noted(&w, &dir.join("probe-face.camproj"))
+            .expect("load probe-face project");
+        assert!(notes.is_empty(), "unexpected load notes: {notes:?}");
+        let kinds: Vec<_> = setup::operation_order(&w)
+            .iter()
+            .map(|(_, entity)| model::operation_of(&w, entity).expect("operation").params.kind())
+            .collect();
+        assert_eq!(kinds, [OpType::Probe, OpType::Face]);
+        let part = model::find_by_name(&w, "probe-face").expect("embedded block");
+        assert!(camcraft_app::model_source::of(&w, &part).is_none());
+        assert!(model::facets_of(&w, &part).is_some_and(|facets| !facets.is_empty()));
+
+        let nc = fs::read_to_string(dir.join("probe-face.nc")).expect("read probe-face NC");
+        let sections: Vec<_> = nc.split("(OPERATION: ").skip(1).collect();
+        assert_eq!(sections.len(), 2, "both operations must reach the program");
+        assert!(sections[0].starts_with("Probe1 - PROBE"));
+        assert!(sections[1].starts_with("Face1 - FACE"));
+        assert!(sections[0].lines().any(|line| line.starts_with("G31 ")),
+            "the probe cycle must precede the first cut");
+        assert!(!sections[0].lines().any(|line| line.starts_with("G01 ")),
+            "no cutting motion before the probe cycle finishes");
+        assert!(sections[1].lines().any(|line| line.starts_with("G01 ")),
+            "the Face operation must cut");
+    }
+
+    #[test]
+    fn regenerates() {
+        run_case("probing", "probe-face", "regenerates", regenerate);
+    }
+
+    #[test]
+    fn rebuilds() {
+        run_case("probing", "probe-face", "rebuilds", rebuild);
+    }
+}
diff --git a/docs/decisions/2874-probe-face.md b/docs/decisions/2874-probe-face.md
new file mode 100644
index 000000000..f43b960f8
--- /dev/null
+++ b/docs/decisions/2874-probe-face.md
@@ -0,0 +1,20 @@
+## #2874 - Probe before Face catalog case
+
+**Decided:** Add one small case with Probe followed by Face. Use an original
+100 x 60 x 12 mm block in 100 x 60 x 13 mm stock. Probe the nominal stock top
+at Z13 with `PRB-0400`, select G54, then face to Z12 with `EM-1000-4FL`.
+Use the default 3-axis mill and the generic Fanuc post. Embed the model in
+the project. Keep the two catalog rebuild checks and pin the operation order
+and the probe cycle before the first cut.
+
+**Why:** A plain block makes the sequence and the 1 mm facing allowance easy
+to inspect. Existing tools and the default machine keep the case focused on
+the Probe-before-Face workflow. The embedded mesh keeps the project portable.
+
+**Dropped:** More complex geometry, other probing modes, and machine changes.
+They do not help show this sequence and would add unrelated setup work.
+This case uses nominal stock contact; it does not simulate a measured offset.
+
+**Cost to change later:** Change the generator or the script, regenerate the
+case, and update its program pin and explanation. No new dependency or
+production behavior is required.
diff --git a/examples/catalog/probing/probe-face/README.md b/examples/catalog/probing/probe-face/README.md
new file mode 100644
index 000000000..58fd38461
--- /dev/null
+++ b/examples/catalog/probing/probe-face/README.md
@@ -0,0 +1,37 @@
+# Probe before Face
+
+An original 100 x 60 x 12 mm block sits in 100 x 60 x 13 mm stock.
+The program probes the stock top before it faces the block to its final height.
+The case uses the default 3-axis mill and the generic Fanuc post.
+
+## What it shows
+
+1. **Probe (`Probe1`, `PRB-0400`):** Touches the stock top at `[0, 0, 13]` in the negative Z direction. The 4 mm probe uses a fast touch and a slow touch. The operation selects the `G54` work offset.
+2. **Face (`Face1`, `EM-1000-4FL`):** Faces the stock at `Z12` with a 10 mm end mill. It removes the 1 mm allowance above the model.
+
+## What to look at
+
+- In `probe-face.nc`, the `Probe1` section comes before the `Face1` section.
+- The probe section contains `G31` touches at `F300` and `F30`. Its `G91 G01` moves retract the probe.
+- `G10 L2 P1 Z[#5223+#190]` updates the G54 Z offset before the Face section starts.
+- The tool changes from the probe to the end mill before the Face operation starts.
+- The Face section contains `G01` cutting moves at `Z12`.
+- The project embeds the model. It opens without a link to the generator's working directory.
+
+## Files
+
+- `model/generate.py` creates the original block mesh in `model/probe-face.obj`.
+- `build.camscript` creates the operations through undoable commands, generates them, verifies the result, saves the project, and posts the program.
+- `case.toml` links the case to the Probe and Face guide entries.
+- `probe-face.camproj` holds the project and the generated toolpaths.
+- `probe-face.nc` holds the committed program.
+
+## Rebuild and verify
+
+From the repository root:
+
+```sh
+cargo xtask catalog --case probing/probe-face
+cargo xtask catalog --check
+cargo test -p camcraft-app --test example_catalog
+```
diff --git a/examples/catalog/probing/probe-face/build.camscript b/examples/catalog/probing/probe-face/build.camscript
new file mode 100644
index 000000000..a9a445d5a
--- /dev/null
+++ b/examples/catalog/probing/probe-face/build.camscript
@@ -0,0 +1,52 @@
+// Provenance: original CamCraft stock-top probing and facing example (#2874).
+// Run from this case directory with camcraft-cli script build.camscript.
+cam.import("model/probe-face.obj", "probe-face");
+cam.call("set_model_link", { model: "probe-face", path: null });
+cam.call("set_stock", { box: { dx: 100.0, dy: 60.0, dz: 13.0 } });
+
+cam.call("add_tool", { catalog: "PRB-0400", holder: "none" });
+cam.call("add_tool", { catalog: "EM-1000-4FL", holder: "none" });
+
+cam.call("add_operation", {
+  kind: "Probe",
+  name: "Probe1",
+  tool: "PRB-0400",
+  source: "stock",
+  params: {
+    mode: "face",
+    dir: "z_neg",
+    target: [0.0, 0.0, 13.0],
+    clearance_z: { reference: "top_of_stock", offset: 25.0 },
+    approach: 5.0,
+    overtravel: 1.0,
+    backoff: 1.0,
+    fast_feed: 300.0,
+    slow_feed: 30.0,
+    set_wcs: 0,
+    tolerance: 0.5
+  }
+});
+
+cam.call("add_operation", {
+  kind: "Face",
+  name: "Face1",
+  tool: "EM-1000-4FL",
+  source: "stock",
+  params: {
+    stepover: 3.0,
+    clearance_z: { reference: "top_of_stock", offset: 25.0 },
+    cut_z: { reference: "top_of_model", offset: 0.0 },
+    feed: 1200.0,
+    plunge_feed: 300.0,
+    climb: true
+  }
+});
+
+cam.generate();
+var verdict = cam.verify();
+if (!verdict.ok) {
+  throw new Error("catalog verify failed: " + JSON.stringify(verdict));
+}
+cam.save("probe-face.camproj");
+cam.post({ to: "probe-face.nc" });
+cam.report();
