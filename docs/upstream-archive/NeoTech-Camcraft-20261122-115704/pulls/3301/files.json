    "blob_url": "https://github.com/NeoTech/Camcraft/blob/ef0d502da087de05b59175ccc46877f8719d17bf/examples%2Fcatalog%2Fprobing%2Fprobe-face%2Fmodel%2Fgenerate.py",
    "raw_url": "https://github.com/NeoTech/Camcraft/raw/ef0d502da087de05b59175ccc46877f8719d17bf/examples%2Fcatalog%2Fprobing%2Fprobe-face%2Fmodel%2Fgenerate.py",
    "contents_url": "https://api.github.com/repos/NeoTech/Camcraft/contents/examples%2Fcatalog%2Fprobing%2Fprobe-face%2Fmodel%2Fgenerate.py?ref=ef0d502da087de05b59175ccc46877f8719d17bf",
    "patch": "@@ -0,0 +1,21 @@\n+\"\"\"Provenance: original rectangular block from its dimensions; no external model.\"\"\"\n+from pathlib import Path\n+\n+\n+def main():\n+    vertices = [\n+        (-50, -30, 0), (50, -30, 0), (50, 30, 0), (-50, 30, 0),\n+        (-50, -30, 12), (50, -30, 12), (50, 30, 12), (-50, 30, 12),\n+    ]\n+    faces = [\n+        (1, 4, 3, 2), (5, 6, 7, 8), (1, 2, 6, 5),\n+        (2, 3, 7, 6), (3, 4, 8, 7), (4, 1, 5, 8),\n+    ]\n+    lines = [\"# Original 100 x 60 x 12 mm block, Z0 to Z12.\"]\n+    lines += [\"v \" + \" \".join(map(str, vertex)) for vertex in vertices]\n+    lines += [\"f \" + \" \".join(map(str, face)) for face in faces]\n+    Path(__file__).with_name(\"probe-face.obj\").write_text(\"\\n\".join(lines) + \"\\n\")\n+\n+\n+if __name__ == \"__main__\":\n+    main()"
  },
