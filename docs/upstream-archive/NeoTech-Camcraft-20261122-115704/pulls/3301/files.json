    "patch": "@@ -0,0 +1,1058 @@\n+{\n+  \"version\": 76,\n+  \"entities\": [\n+    {\n+      \"name\": \"EM-1000-4FL\",\n+      \"translation\": [\n+        0.0,\n+        0.0,\n+        0.0\n+      ],\n+      \"rotation\": [\n+        0.0,\n+        0.0,\n+        0.0,\n+        1.0\n+      ],\n+      \"kind\": \"tool\",\n+      \"tool\": {\n+        \"kind\": \"end_mill\",\n+        \"diameter\": 10.0,\n+        \"corner_r\": 0.0,\n+        \"tip_angle\": 0.0,\n+        \"pitch\": 0.0,\n+        \"nose_radius\": 0.0,\n+        \"width\": 0.0,\n+        \"flute_len\": 22.0,\n+        \"shank_d\": 10.0,\n+        \"shank_len\": 40.0,\n+        \"holder_d\": 44.0,\n+        \"holder_len\": 35.0,\n+        \"material_group\": \"aluminum\",\n+        \"rpm\": 5800.0,\n+        \"feed\": 3000.0,\n+        \"tool_material\": \"carbide\",\n+        \"flutes\": 4,\n+        \"number\": 2\n+      }\n+    },\n+    {\n+      \"name\": \"Face1\",\n+      \"translation\": [\n+        0.0,\n+        0.0,\n+        0.0\n+      ],\n+      \"rotation\": [\n+        0.0,\n+        0.0,\n+        0.0,\n+        1.0\n+      ],\n+      \"kind\": \"operation\",\n+      \"operation\": {\n+        \"order\": 1,\n+        \"tool\": \"EM-1000-4FL\",\n+        \"src\": \"stock\",\n+        \"params\": {\n+          \"face\": {\n+            \"stepover\": 3.0,\n+            \"clearance_z\": {\n+              \"reference\": \"top_of_stock\",\n+              \"offset\": 25.0\n+            },\n+            \"cut_z\": {\n+              \"reference\": \"top_of_model\",\n+              \"offset\": 0.0\n+            },\n+            \"feed\": 1200.0,\n+            \"plunge_feed\": 300.0,\n+            \"climb\": true\n+          }\n+        },\n+        \"stamp\": 6253425974392842042,\n+        \"cache\": {\n+          \"moves\": [\n+            {\n+              \"kind\": \"rapid\",\n+              \"from\": [\n+                -55.0,\n+                -25.0,\n+                38.0\n+             