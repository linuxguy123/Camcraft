  {
    "sha": "b4d5c4058994920331d68e5aa8eee7587aa9142b",
    "filename": "crates/app/tests/example_catalog/case_probe_face.rs",
    "status": "added",
    "additions": 45,
    "deletions": 0,
    "changes": 45,
    "blob_url": "https://github.com/NeoTech/Camcraft/blob/ef0d502da087de05b59175ccc46877f8719d17bf/crates%2Fapp%2Ftests%2Fexample_catalog%2Fcase_probe_face.rs",
    "raw_url": "https://github.com/NeoTech/Camcraft/raw/ef0d502da087de05b59175ccc46877f8719d17bf/crates%2Fapp%2Ftests%2Fexample_catalog%2Fcase_probe_face.rs",
    "contents_url": "https://api.github.com/repos/NeoTech/Camcraft/contents/crates%2Fapp%2Ftests%2Fexample_catalog%2Fcase_probe_face.rs?ref=ef0d502da087de05b59175ccc46877f8719d17bf",
    "patch": "@@ -0,0 +1,45 @@\n+// Provenance: original CamCraft Probe-before-Face catalog contract (#2874).\n+mod catalog_probing_probe_face {\n+    use super::*;\n+    use camcraft_app::{model, operation::OpType, project, setup, world};\n+\n+    #[test]\n+    fn probes_before_first_cut() {\n+        let dir = repo(\"examples/catalog/probing/probe-face\");\n+        assert!(dir.is_dir(), \"catalog case probing/probe-face is missing\");\n+        let w = world::new_world();\n+        let notes = project::load_noted(&w, &dir.join(\"probe-face.camproj\"))\n+            .expect(\"load probe-face project\");\n+        assert!(notes.is_empty(), \"unexpected load notes: {notes:?}\");\n+        let kinds: Vec<_> = setup::operation_order(&w)\n+            .iter()\n+            .map(|(_, entity)| model::operation_of(&w, entity).expect(\"operation\").params.kind())\n+            .collect();\n+        assert_eq!(kinds, [OpType::Probe, OpType::Face]);\n+        let part = model::find_by_name(&w, \"probe-face\").expect(\"embedded block\");\n+        assert!(camcraft_app::model_source::of(&w, &part).is_none());\n+        assert!(model::facets_of(&w, &part).is_some_and(|facets| !facets.is_empty()));\n+\n+        let nc = fs::read_to_string(dir.join(\"probe-face.nc\")).expect(\"read probe-face NC\");\n+        let sections: Vec<_> = nc.split(\"(OPERATION: \").skip(1).collect();\n+        assert_eq!(sections.len(), 2, \"both operations must reach the program\");\n+        assert!(sections[0].starts_with(\"Probe1 - PROBE\"));\n+        assert!(sections[1].starts_with(\"Face1 - FACE\"));\n+        assert!(sections[0].lines().any(|line| line.starts_with(\"G31 \")),\n+            \"the probe cycle must precede the first cut\");\n+        assert!(!sections[0].lines().any(|line| line.starts_with(\"G01 \")),\n+            \"no cutting motion before the probe cycle finishes\");\n+        assert!(sections[1].lines().any(|line| line.starts_with(\"G01 \")),\n+            \"the Face operation must cut\");\n+    }\n+\n+    #[test]\n+    fn regenerates() {\n+        run_case(\"probing\", \"probe-face\", \"regenerates\", regenerate);\n+    }\n+\n+    #[test]\n+    fn rebuilds() {\n+        run_case(\"probing\", \"probe-face\", \"rebuilds\", rebuild);\n+    }\n+}"
  },
  {
    "sha": "f43b960f8af50d0244547878bfa7104b5e99312b",
    "filename": "docs/decisions/2874-probe-face.md",
    "status": "added",
    "additions": 20,
    "deletions": 0,
    "changes": 20,
    "blob_url": "https://github.com/NeoTech/Camcraft/blob/ef0d502da087de05b59175ccc46877f8719d17bf/docs%2Fdecisions%2F2874-probe-face.md",
    "raw_url": "https://github.com/NeoTech/Camcraft/raw/ef0d502da087de05b59175ccc46877f8719d17bf/docs%2Fdecisions%2F2874-probe-face.md",
    "contents_url": "https://api.github.com/repos/NeoTech/Camcraft/contents/docs%2Fdecisions%2F2874-probe-face.md?ref=ef0d502da087de05b59175ccc46877f8719d17bf",
    "patch": "@@ -0,0 +1,20 @@\n+## #2874 - Probe before Face catalog case\n+\n+**Decided:** Add one small case with Probe followed by Face. Use an original\n+100 x 60 x 12 mm block in 100 x 60 x 13 mm stock. Probe the nominal stock top\n+at Z13 with `PRB-0400`, select G54, then face to Z12 with `EM-1000-4FL`.\n+Use the default 3-axis mill and the generic Fanuc post. Embed the model in\n+the project. Keep the two catalog rebuild checks and pin the operation order\n+and the probe cycle before the first cut.\n+\n+**Why:** A plain block makes the sequence and the 1 mm facing allowance easy\n+to inspect. Existing tools and the default machine keep the case focused on\n+the Probe-before-Face workflow. The embedded mesh keeps the project portable.\n+\n+**Dropped:** More complex geometry, other probing modes, and machine changes.\n+They do not help show this sequence and would add unrelated setup work.\n+This case uses nominal stock contact; it does not simulate a measured offset.\n+\n+**Cost to change later:** Change the generator or the script, regenerate the\n+case, and update its program pin and explanation. No new dependency or\n+production behavior is required."
  },
  {
    "sha": "58fd38461bc3672fce83e3c5d9a0aa9d58533912",
    "filename": "examples/catalog/probing/probe-face/README.md",
    "status": "added",
    "additions": 37,
    "deletions": 0,
    "changes": 37,
    "blob_url": "https://github.com/NeoTech/Camcraft/blob/ef0d502da087de05b59175ccc46877f8719d17bf/examples%2Fcatalog%2Fprobing%2Fprobe-face%2FREADME.md",
    "raw_url": "https://github.com/NeoTech/Camcraft/raw/ef0d502da087de05b59175ccc46877f8719d17bf/examples%2Fcatalog%2Fprobing%2Fprobe-face%2FREADME.md",
    "contents_url": "https://api.github.com/repos/NeoTech/Camcraft/contents/examples%2Fcatalog%2Fprobing%2Fprobe-face%2FREADME.md?ref=ef0d502da087de05b59175ccc46877f8719d17bf",
    "patch": "@@ -0,0 +1,37 @@\n+# Probe before Face\n+\n+An original 100 x 60 x 12 mm block sits in 100 x 60 x 13 mm stock.\n+The program probes the stock top before it faces the block to its final height.\n+The case uses the default 3-axis mill and the generic Fanuc post.\n+\n+## What it shows\n+\n+1. **Probe (`Probe1`, `PRB-0400`):** Touches the stock top at `[0, 0, 13]` in the negative Z direction. The 4 mm probe uses a fast touch and a slow touch. The operation selects the `G54` work offset.\n+2. **Face (`Face1`, `EM-1000-4FL`):** Faces the stock at `Z12` with a 10 mm end mill. It removes the 1 mm allowance above the model.\n+\n+## What to look at\n+\n+- In `probe-face.nc`, the `Probe1` section comes before the `Face1` section.\n+- The probe section contains `G31` touches at `F300` and `F30`. Its `G91 G01` moves retract the probe.\n+- `G10 L2 P1 Z[#5223+#190]` updates the G54 Z offset before the Face section starts.\n+- The tool changes from the probe to the end mill before the Face operation starts.\n+- The Face section contains `G01` cutting moves at `Z12`.\n+- The project embeds the model. It opens without a link to the generator's working directory.\n+\n+## Files\n+\n+- `model/generate.py` creates the original block mesh in `model/probe-face.obj`.\n+- `build.camscript` creates the operations through undoable commands, generates them, verifies the result, saves the project, and posts the program.\n+- `case.toml` links the case to the Probe and Face guide entries.\n+- `probe-face.camproj` holds the project and the generated toolpaths.\n+- `probe-face.nc` holds the committed program.\n+\n+## Rebuild and verify\n+\n+From the repository root:\n+\n+```sh\n+cargo xtask catalog --case probing/probe-face\n+cargo xtask catalog --check\n+cargo test -p camcraft-app --test example_catalog\n+```"
  },
  {
    "sha": "a9a445d5a52e8805d9a68ad1d58caf8ed8bc3b34",
    "filename": "examples/catalog/probing/probe-face/build.camscript",
    "status": "added",
    "additions": 52,
    "deletions": 0,
    "changes": 52,
    "blob_url": "https://github.com/NeoTech/Camcraft/blob/ef0d502da087de05b59175ccc46877f8719d17bf/examples%2Fcatalog%2Fprobing%2Fprobe-face%2Fbuild.camscript",
    "raw_url": "https://github.com/NeoTech/Camcraft/raw/ef0d502da087de05b59175ccc46877f8719d17bf/examples%2Fcatalog%2Fprobing%2Fprobe-face%2Fbuild.camscript",
    "contents_url": "https://api.github.com/repos/NeoTech/Camcraft/contents/examples%2Fcatalog%2Fprobing%2Fprobe-face%2Fbuild.camscript?ref=ef0d502da087de05b59175ccc46877f8719d17bf",
    "patch": "@@ -0,0 +1,52 @@\n+// Provenance: original CamCraft stock-top probing and facing example (#2874).\n+// Run from this case directory with camcraft-cli script build.camscript.\n+cam.import(\"model/probe-face.obj\", \"probe-face\");\n+cam.call(\"set_model_link\", { model: \"probe-face\", path: null });\n+cam.call(\"set_stock\", { box: { dx: 100.0, dy: 60.0, dz: 13.0 } });\n+\n+cam.call(\"add_tool\", { catalog: \"PRB-0400\", holder: \"none\" });\n+cam.call(\"add_tool\", { catalog: \"EM-1000-4FL\", holder: \"none\" });\n+\n+cam.call(\"add_operation\", {\n+  kind: \"Probe\",\n+  name: \"Probe1\",\n+  tool: \"PRB-0400\",\n+  source: \"stock\",\n+  params: {\n+    mode: \"face\",\n+    dir: \"z_neg\",\n+    target: [0.0, 0.0, 13.0],\n+    clearance_z: { reference: \"top_of_stock\", offset: 25.0 },\n+    approach: 5.0,\n+    overtravel: 1.0,\n+    backoff: 1.0,\n+    fast_feed: 300.0,\n+    slow_feed: 30.0,\n+    set_wcs: 0,\n+    tolerance: 0.5\n+  }\n+});\n+\n+cam.call(\"add_operation\", {\n+  kind: \"Face\",\n+  name: \"Face1\",\n+  tool: \"EM-1000-4FL\",\n+  source: \"stock\",\n+  params: {\n+    stepover: 3.0,\n+    clearance_z: { reference: \"top_of_stock\", offset: 25.0 },\n+    cut_z: { reference: \"top_of_model\", offset: 0.0 },\n+    feed: 1200.0,\n+    plunge_feed: 300.0,\n+    climb: true\n+  }\n+});\n+\n+cam.generate();\n+var verdict = cam.verify();\n+if (!verdict.ok) {\n+  throw new Error(\"catalog verify failed: \" + JSON.stringify(verdict));\n+}\n+cam.save(\"probe-face.camproj\");\n+cam.post({ to: \"probe-face.nc\" });\n+cam.report();"
  },
