+fn two_lobe_waist() -> (Region, Region, Region, Region) {
+    let part = region(vec![lobe(-36.0, 32.5)])
+        .union(&region(vec![lobe(36.0, 32.5)]))
+        .and_then(|p| p.union(&region(vec![rect(-1.5, -36.0, 1.5, 36.0)])))
+        .expect("part");
