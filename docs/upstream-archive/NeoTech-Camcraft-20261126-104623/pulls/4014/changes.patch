+        let off_wall: Vec<Point2> = match start {
+            PassStart::Inside => full.into_iter().filter(|&q| !on_wall(q)).collect(),
+            _ => full,
+        };
+        assert!(
+            off_wall.is_empty(),
+            "{start:?}: {} off-wall full-width point(s) at merge, first {:?}; notes={:?}",
+            off_wall.len(),
