+fn tail_extension(band: &Band<'_>, walk: &[Point2], near: &Region) -> Result<Vec<Vec<Point2>>, GenError> {
+    let mut tails = Vec::new();
+    let RingClip::Pieces(cands) = band.c.clip_ring(walk, true)? else {
+        return Ok(tails);
