diff --git a/crates/tools/src/component.rs b/crates/tools/src/component.rs
new file mode 100644
index 000000000..8145eec48
--- /dev/null
+++ b/crates/tools/src/component.rs
@@ -0,0 +1,218 @@
+//! #3642: a reusable tool component, in the three kinds of the
+//! ISO 13399 tool model - a cutting item (an insert, or a solid
+//! tool), a tool item (a holder or cutter body with insert seats) and
+//! an adaptive item (a spindle holder, chuck, collet, adapter or
+//! extension). Each kind states its machine-side connection (MCS) and
+//! its workpiece-side ports (CSW). Our own record over the public
+//! ISO 13399 concepts; pure data, no ECS and no file I/O. Assemblies
+//! (#3643), the document table (#3644) and the stores (#3645) build on
+//! this.
+//!
+//! The law: a component is checked when it is made
+//! ([`ToolComponent::new`]), and each refusal names the component.
+
+use crate::connection_code::{ConnectionCode, ConnectionError};
+use crate::holder_library::BORE_SLACK;
+use crate::insert_iso1832::InsertSpec;
+use crate::insert_seat::InsertSeatSpec;
+use crate::tools::Tool;
+
+/// The one workpiece-side port of an adaptive item.
+pub const ADAPTIVE_PORT: &str = "CSW";
+
+/// What cuts.
+#[derive(Clone, Debug, PartialEq)]
+pub enum CuttingItem {
+    /// An indexable insert. It has no machine side: it sits in a seat.
+    Insert(InsertSpec),
+    /// A solid tool (an end mill, a drill) and its shank connection.
+    Solid { tool: Box<Tool>, mcs: ConnectionCode },
+}
+
+/// One insert seat of a tool item, under its port name ("CSW1",
+/// "CSW1_2").
+#[derive(Clone, Debug, PartialEq)]
+pub struct InsertSeat {
+    pub port: String,
+    pub spec: InsertSeatSpec,
+}
+
+/// The three component kinds.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ComponentKind {
+    CuttingItem(CuttingItem),
+    /// A turning holder, a boring bar body or an indexable cutter
+    /// body: one machine side and one or more insert seats.
+    ToolItem { mcs: ConnectionCode, seats: Vec<InsertSeat> },
+    /// A spindle holder, collet chuck, collet, adapter, extension or
+    /// clamping unit: one machine side and one workpiece side.
+    AdaptiveItem { mcs: ConnectionCode, csw: ConnectionCode },
+}
+
+/// Why a component is refused when it is made.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ComponentError {
+    EmptyId,
+    EmptyName { id: String },
+    NoSeat { name: String },
+    BadPort { name: String, port: String },
+    DuplicatePort { name: String, port: String },
+    Connection { name: String, side: &'static str, err: ConnectionError },
+    Tool { name: String, why: String },
+    ShankMismatch { name: String, shank_d: f64, mcs: String },
+}
+
+impl core::fmt::Display for ComponentError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::EmptyId => write!(f, "a tool component needs an id"),
+            Self::EmptyName { id } => write!(f, "the tool component '{id}' needs a name"),
+            Self::NoSeat { name } => write!(f, "the tool item '{name}' has no insert seat - it needs one at least"),
+            Self::BadPort { name, port } => write!(
+                f,
+                "the tool item '{name}' has a seat port '{port}' - a seat port is CSW and a number (CSW1, CSW1_2)"
+            ),
+            Self::DuplicatePort { name, port } => write!(f, "the tool item '{name}' has two seats named '{port}'"),
+            Self::Connection { name, side, err } => write!(f, "the component '{name}' {side}: {err}"),
+            Self::Tool { name, why } => write!(f, "the solid tool '{name}' is refused: {why}"),
+            Self::ShankMismatch { name, shank_d, mcs } => write!(
+                f,
+                "the solid tool '{name}' has a Ø{shank_d} mm shank, but its machine side says {mcs}"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for ComponentError {}
+
+/// One reusable tool component.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ToolComponent {
+    id: String,
+    name: String,
+    kind: ComponentKind,
+}
+
+impl ToolComponent {
+    /// A checked component: a non-empty id and name, valid connection
+    /// codes, at least one seat on a tool item with unique `CSW<n>`
+    /// port names, and a sane solid tool whose shank matches its
+    /// machine side.
+    pub fn new(id: &str, name: &str, kind: ComponentKind) -> Result<Self, ComponentError> {
+        let id = id.trim();
+        let name = name.trim();
+        if id.is_empty() {
+            return Err(ComponentError::EmptyId);
+        }
+        if name.is_empty() {
+            return Err(ComponentError::EmptyName { id: id.to_owned() });
+        }
+        let named = name.to_owned();
+        let conn = |side: &'static str, code: &ConnectionCode| {
+            code.check().map_err(|err| ComponentError::Connection { name: named.clone(), side, err })
+        };
+        match &kind {
+            ComponentKind::CuttingItem(CuttingItem::Insert(_)) => {}
+            ComponentKind::CuttingItem(CuttingItem::Solid { tool, mcs }) => {
+                conn("machine side", mcs)?;
+                if let Some(why) = tool.why_not_sane() {
+                    return Err(ComponentError::Tool { name: named, why });
+                }
+                if let ConnectionCode::Cylindrical { d } | ConnectionCode::Weldon { d } = mcs {
+                    if (d - tool.shank_d).abs() > BORE_SLACK {
+                        return Err(ComponentError::ShankMismatch {
+                            name: named,
+                            shank_d: tool.shank_d,
+                            mcs: mcs.to_string(),
+                        });
+                    }
+                }
+            }
+            ComponentKind::ToolItem { mcs, seats } => {
+                conn("machine side", mcs)?;
+                if seats.is_empty() {
+                    return Err(ComponentError::NoSeat { name: named });
+                }
+                for (i, seat) in seats.iter().enumerate() {
+                    if !is_seat_port(&seat.port) {
+                        return Err(ComponentError::BadPort { name: named, port: seat.port.clone() });
+                    }
+                    if seats[..i].iter().any(|s| s.port == seat.port) {
+                        return Err(ComponentError::DuplicatePort { name: named, port: seat.port.clone() });
+                    }
+                }
+            }
+            ComponentKind::AdaptiveItem { mcs, csw } => {
+                conn("machine side", mcs)?;
+                conn("workpiece side", csw)?;
+            }
+        }
+        Ok(Self { id: id.to_owned(), name: name.to_owned(), kind })
+    }
+
+    #[must_use]
+    pub fn id(&self) -> &str {
+        &self.id
+    }
+
+    #[must_use]
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    #[must_use]
+    pub fn kind(&self) -> &ComponentKind {
+        &self.kind
+    }
+
+    /// The machine-side connection; `None` for an insert.
+    #[must_use]
+    pub fn mcs(&self) -> Option<&ConnectionCode> {
+        match &self.kind {
+            ComponentKind::CuttingItem(CuttingItem::Insert(_)) => None,
+            ComponentKind::CuttingItem(CuttingItem::Solid { mcs, .. })
+            | ComponentKind::ToolItem { mcs, .. }
+            | ComponentKind::AdaptiveItem { mcs, .. } => Some(mcs),
+        }
+    }
+
+    /// The insert, when this is one.
+    #[must_use]
+    pub fn insert(&self) -> Option<&InsertSpec> {
+        match &self.kind {
+            ComponentKind::CuttingItem(CuttingItem::Insert(spec)) => Some(spec),
+            _ => None,
+        }
+    }
+
+    /// The seat behind a port name, when this is a tool item that has
+    /// it.
+    #[must_use]
+    pub fn seat(&self, port: &str) -> Option<&InsertSeatSpec> {
+        match &self.kind {
+            ComponentKind::ToolItem { seats, .. } => seats.iter().find(|s| s.port == port).map(|s| &s.spec),
+            _ => None,
+        }
+    }
+
+    /// The workpiece-side port names, in order: the seats of a tool
+    /// item, the one `CSW` of an adaptive item, none for a cutting item.
+    #[must_use]
+    pub fn ports(&self) -> Vec<&str> {
+        match &self.kind {
+            ComponentKind::CuttingItem(_) => Vec::new(),
+            ComponentKind::ToolItem { seats, .. } => seats.iter().map(|s| s.port.as_str()).collect(),
+            ComponentKind::AdaptiveItem { .. } => vec![ADAPTIVE_PORT],
+        }
+    }
+}
+
+/// "CSW", then a number, then optionally "_" and a number.
+fn is_seat_port(port: &str) -> bool {
+    let Some(rest) = port.strip_prefix(ADAPTIVE_PORT) else { return false };
+    let digits = |s: &str| !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit());
+    match rest.split_once('_') {
+        Some((a, b)) => digits(a) && digits(b),
+        None => digits(rest),
+    }
+}
diff --git a/crates/tools/src/component_fit.rs b/crates/tools/src/component_fit.rs
new file mode 100644
index 000000000..e7c0ed641
--- /dev/null
+++ b/crates/tools/src/component_fit.rs
@@ -0,0 +1,217 @@
+//! #3642: does one tool component fit another? An insert in a holder's
+//! seat (shape, clearance, size, thickness, clamping against the
+//! fixing hole, hand), and a child's machine side on a parent's
+//! workpiece side (the connection codes). Plus the two library
+//! queries a browser asks: what this component can sit in, and what
+//! can sit in it. Our own rules from general machining practice over
+//! the ISO 1832, ISO 5608 and ISO 13399 codes; pure functions.
+//!
+//! The law: each mismatch is refused by name - both components, the
+//! property, the expected value and the actual value.
+
+use crate::component::{ComponentKind, CuttingItem, ToolComponent, ADAPTIVE_PORT};
+use crate::insert_codes::{FixingHole, Hand};
+
+/// The property a fit check found wrong.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum FitProperty {
+    Kind,
+    Port,
+    Shape,
+    Clearance,
+    Size,
+    Thickness,
+    Fixing,
+    Hand,
+    Coupling,
+}
+
+impl FitProperty {
+    #[must_use]
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Kind => "kind",
+            Self::Port => "port",
+            Self::Shape => "shape",
+            Self::Clearance => "clearance",
+            Self::Size => "size",
+            Self::Thickness => "thickness",
+            Self::Fixing => "clamping and fixing",
+            Self::Hand => "hand",
+            Self::Coupling => "coupling",
+        }
+    }
+}
+
+/// One refused fit.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FitError {
+    pub parent: String,
+    pub child: String,
+    pub property: FitProperty,
+    pub expected: String,
+    pub actual: String,
+}
+
+impl core::fmt::Display for FitError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(
+            f,
+            "'{}' does not fit '{}': {} - expected {}, actual {}",
+            self.child,
+            self.parent,
+            self.property.name(),
+            self.expected,
+            self.actual
+        )
+    }
+}
+
+impl std::error::Error for FitError {}
+
+/// A match a library query found: the component, and the parent's
+/// port the pair meets at.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Fit<'a> {
+    pub component: &'a ToolComponent,
+    pub port: String,
+}
+
+fn refuse(
+    parent: &ToolComponent,
+    child: &ToolComponent,
+    property: FitProperty,
+    expected: String,
+    actual: String,
+) -> FitError {
+    FitError { parent: parent.name().to_owned(), child: child.name().to_owned(), property, expected, actual }
+}
+
+fn kind_name(c: &ToolComponent) -> &'static str {
+    match c.kind() {
+        ComponentKind::CuttingItem(CuttingItem::Insert(_)) => "an insert",
+        ComponentKind::CuttingItem(CuttingItem::Solid { .. }) => "a solid tool",
+        ComponentKind::ToolItem { .. } => "a tool item",
+        ComponentKind::AdaptiveItem { .. } => "an adaptive item",
+    }
+}
+
+fn hole_name(h: FixingHole) -> &'static str {
+    match h {
+        FixingHole::None => "no hole",
+        FixingHole::Cylindrical => "a cylindrical hole",
+        FixingHole::Countersunk => "a countersunk hole",
+        FixingHole::Special => "a special fixing",
+    }
+}
+
+/// Does `insert` sit in the seat `port` of `holder`?
+pub fn check_insert_fit(holder: &ToolComponent, port: &str, insert: &ToolComponent) -> Result<(), FitError> {
+    let no = |p, e: String, a: String| Err(refuse(holder, insert, p, e, a));
+    let Some(ins) = insert.insert() else {
+        return no(FitProperty::Kind, "an insert".into(), kind_name(insert).into());
+    };
+    let Some(seat) = holder.seat(port) else {
+        return if matches!(holder.kind(), ComponentKind::ToolItem { .. }) {
+            no(FitProperty::Port, format!("a seat of {}", holder.ports().join(", ")), port.into())
+        } else {
+            no(FitProperty::Kind, "a tool item with insert seats".into(), kind_name(holder).into())
+        };
+    };
+    if seat.shape != ins.shape {
+        return no(FitProperty::Shape, seat.shape.letter().into(), ins.shape.letter().into());
+    }
+    if seat.clearance != ins.clearance {
+        return no(FitProperty::Clearance, seat.clearance.letter().into(), ins.clearance.letter().into());
+    }
+    if seat.size != ins.size {
+        return no(FitProperty::Size, format!("{:02}", seat.size), format!("{:02}", ins.size));
+    }
+    if let Some(t) = seat.thickness {
+        if t != ins.thickness {
+            return no(FitProperty::Thickness, t.code(), ins.thickness.code());
+        }
+    }
+    let takes = seat.clamping.takes();
+    let has = ins.fixing.hole();
+    if takes != has {
+        return no(
+            FitProperty::Fixing,
+            format!("{} (clamping {})", hole_name(takes), seat.clamping.letter()),
+            format!("{} (fixing {})", hole_name(has), ins.fixing.letter()),
+        );
+    }
+    if let Some(h @ (Hand::R | Hand::L)) = ins.hand {
+        if h != seat.hand {
+            return no(FitProperty::Hand, seat.hand.letter().into(), h.letter().into());
+        }
+    }
+    Ok(())
+}
+
+const COUPLING_PARENT: &str = "a component with a workpiece-side coupling";
+
+/// Does `child`'s machine side mate with the workpiece side `port` of
+/// `parent`? An insert seat is not a coupling: an insert fits by
+/// [`check_insert_fit`].
+pub fn check_coupling_fit(parent: &ToolComponent, port: &str, child: &ToolComponent) -> Result<(), FitError> {
+    let no = |p, e: String, a: String| Err(refuse(parent, child, p, e, a));
+    let csw = match parent.kind() {
+        ComponentKind::AdaptiveItem { csw, .. } if port == ADAPTIVE_PORT => csw,
+        ComponentKind::AdaptiveItem { .. } => return no(FitProperty::Port, ADAPTIVE_PORT.into(), port.into()),
+        ComponentKind::ToolItem { .. } => {
+            let actual = "a tool item (its ports are insert seats)";
+            return no(FitProperty::Kind, COUPLING_PARENT.into(), actual.into());
+        }
+        ComponentKind::CuttingItem(_) => return no(FitProperty::Kind, COUPLING_PARENT.into(), kind_name(parent).into()),
+    };
+    let Some(mcs) = child.mcs() else {
+        return no(FitProperty::Kind, "a component with a machine side".into(), kind_name(child).into());
+    };
+    if csw.takes(mcs) { Ok(()) } else { no(FitProperty::Coupling, csw.to_string(), mcs.to_string()) }
+}
+
+/// Either check, by what the child is.
+pub fn check_fit(parent: &ToolComponent, port: &str, child: &ToolComponent) -> Result<(), FitError> {
+    if child.insert().is_some() { check_insert_fit(parent, port, child) } else { check_coupling_fit(parent, port, child) }
+}
+
+/// The components of `library` that `child` fits in, with the port:
+/// "the holders that take this insert". The child itself (by id) is
+/// left out.
+pub fn compatible_parents<'a>(
+    child: &ToolComponent,
+    library: impl IntoIterator<Item = &'a ToolComponent>,
+) -> Vec<Fit<'a>> {
+    let mut out = Vec::new();
+    for parent in library {
+        if parent.id() == child.id() {
+            continue;
+        }
+        for port in parent.ports() {
+            if check_fit(parent, port, child).is_ok() {
+                out.push(Fit { component: parent, port: port.to_owned() });
+            }
+        }
+    }
+    out
+}
+
+/// The components of `library` that fit in `parent`, port by port:
+/// "the inserts this holder takes". The parent itself (by id) is left
+/// out.
+pub fn compatible_children<'a>(
+    parent: &ToolComponent,
+    library: impl IntoIterator<Item = &'a ToolComponent>,
+) -> Vec<Fit<'a>> {
+    let library: Vec<&ToolComponent> = library.into_iter().filter(|c| c.id() != parent.id()).collect();
+    let mut out = Vec::new();
+    for port in parent.ports() {
+        for &child in &library {
+            if check_fit(parent, port, child).is_ok() {
+                out.push(Fit { component: child, port: port.to_owned() });
+            }
+        }
+    }
+    out
+}
diff --git a/crates/tools/src/component_fit_tests.rs b/crates/tools/src/component_fit_tests.rs
new file mode 100644
index 000000000..265f7a6de
--- /dev/null
+++ b/crates/tools/src/component_fit_tests.rs
@@ -0,0 +1,183 @@
+//! #3642: tool components - made and checked, fitted insert to seat
+//! and shank to coupling, queried both ways, and refused by name.
+
+use crate::component::{ComponentError, ComponentKind, CuttingItem, InsertSeat, ToolComponent};
+use crate::component_fit::{
+    check_coupling_fit, check_insert_fit, compatible_children, compatible_parents, FitError, FitProperty,
+};
+use crate::connection_code::ConnectionCode;
+use crate::insert_iso1832::{InsertSpec, Thickness};
+use crate::insert_seat::HolderDesignation;
+use crate::tools::{catalog, Tool};
+
+fn made(id: &str, kind: ComponentKind) -> ToolComponent {
+    match ToolComponent::new(id, id, kind) {
+        Ok(c) => c,
+        Err(e) => panic!("{id}: {e}"),
+    }
+}
+
+fn insert(code: &str) -> ToolComponent {
+    let Ok(spec) = InsertSpec::parse(code) else { panic!("{code}") };
+    made(code, ComponentKind::CuttingItem(CuttingItem::Insert(spec)))
+}
+
+/// A turning holder from its ISO 5608 code: a rectangular shank and
+/// one seat, `CSW1`, of the stated thickness.
+fn holder(code: &str, thickness: Option<&str>) -> ToolComponent {
+    let Ok(h) = HolderDesignation::parse(code) else { panic!("{code}") };
+    let mut spec = h.seat;
+    spec.thickness = thickness.and_then(Thickness::from_code);
+    let mcs = ConnectionCode::RectShank { h: u16::from(h.shank_h), b: u16::from(h.shank_b) };
+    made(code, ComponentKind::ToolItem { mcs, seats: vec![InsertSeat { port: "CSW1".into(), spec }] })
+}
+
+fn code(text: &str) -> ConnectionCode {
+    let Ok(c) = ConnectionCode::parse(text) else { panic!("{text}") };
+    c
+}
+
+fn adaptive(id: &str, mcs: &str, csw: &str) -> ToolComponent {
+    made(id, ComponentKind::AdaptiveItem { mcs: code(mcs), csw: code(csw) })
+}
+
+fn end_mill() -> Tool {
+    let Some((_, t)) = catalog().into_iter().next() else { panic!("the catalog is empty") };
+    t
+}
+
+fn solid(id: &str, tool: Tool, mcs: ConnectionCode) -> Result<ToolComponent, ComponentError> {
+    ToolComponent::new(id, id, ComponentKind::CuttingItem(CuttingItem::Solid { tool: Box::new(tool), mcs }))
+}
+
+fn refusal(r: Result<(), FitError>) -> FitError {
+    match r {
+        Ok(()) => panic!("the fit was accepted"),
+        Err(e) => e,
+    }
+}
+
+#[test]
+fn inserts_fit_the_holders_made_for_them() {
+    let pairs = [
+        ("PCLNR2525M12", "CNMG120408"),
+        ("DDJNR2525M15", "DNMG150608"),
+        ("SCLCR2020K09", "CCMT09T304"),
+        ("SVJBL2020K16", "VBMT160404"),
+        ("CSSPR2525M12", "SPKN1203EDR"),
+    ];
+    for (h, i) in pairs {
+        assert_eq!(check_insert_fit(&holder(h, None), "CSW1", &insert(i)), Ok(()), "{i} in {h}");
+    }
+    assert_eq!(check_insert_fit(&holder("PCLNR2525M12", Some("04")), "CSW1", &insert("CNMG120408")), Ok(()));
+}
+
+#[test]
+fn insert_mismatches_are_refused_by_name() {
+    let pclnr = holder("PCLNR2525M12", None);
+    let cases = [
+        (&pclnr, "DNMG150608", FitProperty::Shape, "C", "D"),
+        (&pclnr, "CCMT09T304", FitProperty::Clearance, "N", "C"),
+        (&pclnr, "CNMG090308", FitProperty::Size, "12", "09"),
+        (&pclnr, "CNMN120408", FitProperty::Fixing, "a cylindrical hole (clamping P)", "no hole (fixing N)"),
+    ];
+    for (h, i, property, expected, actual) in cases {
+        let e = refusal(check_insert_fit(h, "CSW1", &insert(i)));
+        assert_eq!((e.property, e.expected.as_str(), e.actual.as_str()), (property, expected, actual), "{i}");
+        assert_eq!((e.parent.as_str(), e.child.as_str()), ("PCLNR2525M12", i));
+    }
+    let thick = refusal(check_insert_fit(&holder("PCLNR2525M12", Some("04")), "CSW1", &insert("CNMG120608")));
+    assert_eq!((thick.property, thick.expected.as_str(), thick.actual.as_str()), (FitProperty::Thickness, "04", "06"));
+    let hand = refusal(check_insert_fit(&holder("CSSPR2525M12", None), "CSW1", &insert("SPKN1203EDL")));
+    assert_eq!((hand.property, hand.expected.as_str(), hand.actual.as_str()), (FitProperty::Hand, "R", "L"));
+    let text = hand.to_string();
+    assert_eq!(text, "'SPKN1203EDL' does not fit 'CSSPR2525M12': hand - expected R, actual L");
+    let port = refusal(check_insert_fit(&pclnr, "CSW9", &insert("CNMG120408")));
+    assert_eq!((port.property, port.actual.as_str()), (FitProperty::Port, "CSW9"));
+    let kind = refusal(check_insert_fit(&pclnr, "CSW1", &adaptive("ER32 collet 10", "ER32", "CYL 10")));
+    assert_eq!(kind.property, FitProperty::Kind);
+}
+
+#[test]
+fn couplings_match_by_connection_code() {
+    let chuck = adaptive("BT40 ER32 chuck", "BT40", "ER32");
+    let collet = adaptive("ER32 collet 4", "ER32", "CYL 4");
+    let tool = end_mill();
+    let mill = match solid("EM 4 mm shank", tool.clone(), ConnectionCode::Cylindrical { d: tool.shank_d }) {
+        Ok(m) => m,
+        Err(e) => panic!("{e}"),
+    };
+    assert_eq!(check_coupling_fit(&chuck, "CSW", &collet), Ok(()));
+    assert_eq!(check_coupling_fit(&collet, "CSW", &mill), Ok(()));
+    let er25 = adaptive("ER25 collet 4", "ER25", "CYL 4");
+    let e = refusal(check_coupling_fit(&chuck, "CSW", &er25));
+    assert_eq!((e.property, e.expected.as_str(), e.actual.as_str()), (FitProperty::Coupling, "ER32", "ER25"));
+    assert_eq!((e.parent.as_str(), e.child.as_str()), ("BT40 ER32 chuck", "ER25 collet 4"));
+    // A Weldon bore needs the flat; a plain bore takes a Weldon shank.
+    let weldon_bore = adaptive("BT40 Weldon 12", "BT40", "WELDON 12");
+    let plain_shank = adaptive("Extension 12", "CYL 12", "ER16");
+    let flat_shank = adaptive("Extension 12 W", "WELDON 12", "ER16");
+    let w = refusal(check_coupling_fit(&weldon_bore, "CSW", &plain_shank));
+    assert_eq!((w.property, w.expected.as_str(), w.actual.as_str()), (FitProperty::Coupling, "WELDON 12", "CYL 12"));
+    assert_eq!(check_coupling_fit(&weldon_bore, "CSW", &flat_shank), Ok(()));
+    assert_eq!(check_coupling_fit(&adaptive("Collet 12", "ER25", "CYL 12"), "CSW", &flat_shank), Ok(()));
+    // An insert has no machine side, and a seat is not a coupling.
+    assert_eq!(refusal(check_coupling_fit(&chuck, "CSW", &insert("CNMG120408"))).property, FitProperty::Kind);
+    let seat = refusal(check_coupling_fit(&holder("PCLNR2525M12", None), "CSW1", &collet));
+    assert_eq!(seat.property, FitProperty::Kind);
+    assert_eq!(refusal(check_coupling_fit(&chuck, "CSW2", &collet)).property, FitProperty::Port);
+}
+
+#[test]
+fn the_library_queries_find_parents_and_children() {
+    let library = vec![
+        holder("PCLNR2525M12", None),
+        holder("PCLNL2525M12", None),
+        holder("DDJNR2525M15", None),
+        holder("SCLCR2020K09", None),
+        insert("CNMG120408"),
+        insert("DNMG150608"),
+        insert("CCMT09T304"),
+        adaptive("BT40 ER32 chuck", "BT40", "ER32"),
+        adaptive("ER32 collet 4", "ER32", "CYL 4"),
+        adaptive("ER25 collet 4", "ER25", "CYL 4"),
+    ];
+    let names = |fits: Vec<crate::component_fit::Fit<'_>>| -> Vec<String> {
+        fits.iter().map(|f| format!("{}@{}", f.component.name(), f.port)).collect()
+    };
+    let cnmg = insert("CNMG120408");
+    assert_eq!(names(compatible_parents(&cnmg, &library)), ["PCLNR2525M12@CSW1", "PCLNL2525M12@CSW1"]);
+    assert_eq!(names(compatible_children(&holder("PCLNR2525M12", None), &library)), ["CNMG120408@CSW1"]);
+    assert_eq!(names(compatible_children(&library[3], &library)), ["CCMT09T304@CSW1"]);
+    let collet = adaptive("ER32 collet 4", "ER32", "CYL 4");
+    assert_eq!(names(compatible_parents(&collet, &library)), ["BT40 ER32 chuck@CSW"]);
+    assert_eq!(names(compatible_children(&library[7], &library)), ["ER32 collet 4@CSW"]);
+    let tool = end_mill();
+    let Ok(mill) = solid("EM", tool.clone(), ConnectionCode::Cylindrical { d: tool.shank_d }) else { panic!("EM") };
+    assert_eq!(names(compatible_parents(&mill, &library)), ["ER32 collet 4@CSW", "ER25 collet 4@CSW"]);
+}
+
+#[test]
+fn malformed_components_are_refused_by_name() {
+    let rect = ConnectionCode::RectShank { h: 25, b: 25 };
+    let Ok(h) = HolderDesignation::parse("PCLNR2525M12") else { panic!("holder") };
+    let seat = |port: &str| InsertSeat { port: port.into(), spec: h.seat };
+    let tool_item = |seats| ComponentKind::ToolItem { mcs: rect.clone(), seats };
+    assert_eq!(ToolComponent::new(" ", "x", tool_item(vec![seat("CSW1")])), Err(ComponentError::EmptyId));
+    assert!(matches!(ToolComponent::new("h", "", tool_item(vec![seat("CSW1")])), Err(ComponentError::EmptyName { .. })));
+    assert!(matches!(ToolComponent::new("h", "H", tool_item(vec![])), Err(ComponentError::NoSeat { .. })));
+    for bad in ["SEAT1", "CSW", "CSW1_", "CSWa"] {
+        assert!(matches!(ToolComponent::new("h", "H", tool_item(vec![seat(bad)])), Err(ComponentError::BadPort { .. })), "{bad}");
+    }
+    let dup = ToolComponent::new("h", "H", tool_item(vec![seat("CSW1_1"), seat("CSW1_1")]));
+    assert!(matches!(dup, Err(ComponentError::DuplicatePort { .. })));
+    let bad_hsk = ComponentKind::AdaptiveItem { mcs: ConnectionCode::Hsk { form: 'Z', size: 63 }, csw: code("ER32") };
+    let Err(e) = ToolComponent::new("a", "Chuck", bad_hsk) else { panic!("HSK-Z63 accepted") };
+    assert!(e.to_string().starts_with("the component 'Chuck' machine side"), "{e}");
+    let tool = end_mill();
+    let wrong = solid("EM", tool.clone(), ConnectionCode::Cylindrical { d: tool.shank_d + 2.0 });
+    assert!(matches!(wrong, Err(ComponentError::ShankMismatch { .. })));
+    let mut broken = tool;
+    broken.diameter = f64::NAN;
+    assert!(matches!(solid("EM", broken, ConnectionCode::Tts), Err(ComponentError::Tool { .. })));
+}
diff --git a/crates/tools/src/connection_code.rs b/crates/tools/src/connection_code.rs
new file mode 100644
index 000000000..4e3bf0b5a
--- /dev/null
+++ b/crates/tools/src/connection_code.rs
@@ -0,0 +1,200 @@
+//! #3642: the connection code of one side of a tool component - the
+//! machine side (ISO 13399 property ADINTMS) or the workpiece side
+//! (ADINTWS). One normalized type for both, so a parent's workpiece
+//! side and a child's machine side compare directly. The families and
+//! their size series are from the published standards: steep tapers
+//! (JIS B 6339 BT, ASME B5.50 CAT, ISO 7388-1 SK), HSK (ISO 12164),
+//! polygon taper (ISO 26623), KM (ISO 26622), ER collets (ISO 15488),
+//! Weldon and plain shanks (DIN 1835), TTS, rectangular shanks
+//! (ISO 5608), VDI (ISO 10889), BMT and shell mill arbors. The text
+//! form is our own.
+
+use crate::holder_library::BORE_SLACK;
+
+/// The steep taper families.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SteepTaper {
+    /// JIS B 6339 / MAS 403.
+    Bt,
+    /// ASME B5.50.
+    Cat,
+    /// ISO 7388-1 / DIN 69871.
+    Sk,
+}
+
+/// One normalized connection.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ConnectionCode {
+    SteepTaper { family: SteepTaper, size: u16 },
+    /// HSK, form A to F, by its flange size.
+    Hsk { form: char, size: u16 },
+    /// The polygon taper of ISO 26623, by its flange size.
+    Psc { size: u16 },
+    /// ISO 26622, by its flange size.
+    Km { size: u16 },
+    /// An ER collet seat (ISO 15488).
+    Er { size: u16 },
+    /// A shank with a Weldon flat (DIN 1835 form B), diameter in mm.
+    Weldon { d: f64 },
+    /// A plain cylindrical shank or bore, diameter in mm.
+    Cylindrical { d: f64 },
+    /// The Tormach tooling system's 3/4 in straight shank.
+    Tts,
+    /// A rectangular turning shank (ISO 5608), height x width in mm.
+    RectShank { h: u16, b: u16 },
+    /// A VDI turret shank (ISO 10889), diameter in mm.
+    Vdi { d: u16 },
+    /// A bolted turret mount, by its size.
+    Bmt { size: u16 },
+    /// A shell mill arbor, pilot diameter in mm.
+    ShellMillArbor { d: f64 },
+    /// Any other connection, by its own name. Matches only the same
+    /// name.
+    Custom(String),
+}
+
+const BT: &[u16] = &[30, 40, 50];
+const CAT_SK: &[u16] = &[30, 40, 45, 50, 60];
+const HSK: &[u16] = &[25, 32, 40, 50, 63, 80, 100, 125, 160];
+const PSC_KM: &[u16] = &[32, 40, 50, 63, 80, 100];
+const ER: &[u16] = &[8, 11, 16, 20, 25, 32, 40, 50];
+const VDI: &[u16] = &[16, 20, 25, 30, 40, 50, 60, 80];
+const BMT: &[u16] = &[40, 45, 55, 65, 75, 85];
+/// The largest shank or arbor diameter (mm) a code takes.
+pub const MAX_D: f64 = 200.0;
+
+/// Why a connection code text is refused.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ConnectionError {
+    pub text: String,
+    pub why: String,
+}
+
+impl core::fmt::Display for ConnectionError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "the connection code '{}' is refused: {}", self.text, self.why)
+    }
+}
+
+impl std::error::Error for ConnectionError {}
+
+impl ConnectionCode {
+    /// Parse the text form that [`Display`](core::fmt::Display)
+    /// writes. Case and spaces are ignored, except in a custom name.
+    pub fn parse(text: &str) -> Result<Self, ConnectionError> {
+        let t = text.trim();
+        let err = |why: &str| ConnectionError { text: t.to_owned(), why: why.to_owned() };
+        if t.is_empty() {
+            return Err(err("it is empty"));
+        }
+        if !t.is_ascii() {
+            return Err(err("it has a character that is not ASCII"));
+        }
+        if t.len() > 7 && t[..7].eq_ignore_ascii_case("CUSTOM:") {
+            let name = t[7..].trim();
+            return if name.is_empty() { Err(err("a custom code needs a name")) } else { Ok(Self::Custom(name.to_owned())) };
+        }
+        let u: String = t.chars().filter(|c| !c.is_ascii_whitespace()).map(|c| c.to_ascii_uppercase()).collect();
+        let series = |rest: &str, set: &[u16], what: &str| -> Result<u16, ConnectionError> {
+            rest.parse::<u16>().ok().filter(|n| set.contains(n)).ok_or_else(|| err(&format!("{what} takes {set:?}")))
+        };
+        let diameter = |rest: &str, what: &str| -> Result<f64, ConnectionError> {
+            rest.parse::<f64>()
+                .ok()
+                .filter(|d| d.is_finite() && *d > 0.0 && *d <= MAX_D)
+                .ok_or_else(|| err(&format!("{what} takes a diameter above 0 and up to {MAX_D} mm")))
+        };
+        // Longer prefixes first, so "CAT" is not read as a custom code
+        // and "HSK" not as "H".
+        let code = if u == "TTS" {
+            Self::Tts
+        } else if let Some(r) = u.strip_prefix("HSK-") {
+            let mut c = r.chars();
+            let form = c.next().filter(|f| ('A'..='F').contains(f)).ok_or_else(|| err("HSK takes a form A to F"))?;
+            Self::Hsk { form, size: series(c.as_str(), HSK, "HSK")? }
+        } else if let Some(r) = u.strip_prefix("BT") {
+            Self::SteepTaper { family: SteepTaper::Bt, size: series(r, BT, "BT")? }
+        } else if let Some(r) = u.strip_prefix("CAT") {
+            Self::SteepTaper { family: SteepTaper::Cat, size: series(r, CAT_SK, "CAT")? }
+        } else if let Some(r) = u.strip_prefix("SK") {
+            Self::SteepTaper { family: SteepTaper::Sk, size: series(r, CAT_SK, "SK")? }
+        } else if let Some(r) = u.strip_prefix("PSC") {
+            Self::Psc { size: series(r, PSC_KM, "PSC")? }
+        } else if let Some(r) = u.strip_prefix("KM") {
+            Self::Km { size: series(r, PSC_KM, "KM")? }
+        } else if let Some(r) = u.strip_prefix("ER") {
+            Self::Er { size: series(r, ER, "ER")? }
+        } else if let Some(r) = u.strip_prefix("VDI") {
+            Self::Vdi { d: series(r, VDI, "VDI")? }
+        } else if let Some(r) = u.strip_prefix("BMT") {
+            Self::Bmt { size: series(r, BMT, "BMT")? }
+        } else if let Some(r) = u.strip_prefix("WELDON") {
+            Self::Weldon { d: diameter(r, "a Weldon shank")? }
+        } else if let Some(r) = u.strip_prefix("CYL") {
+            Self::Cylindrical { d: diameter(r, "a cylindrical shank")? }
+        } else if let Some(r) = u.strip_prefix("ARBOR") {
+            Self::ShellMillArbor { d: diameter(r, "a shell mill arbor")? }
+        } else if let Some(r) = u.strip_prefix("RECT") {
+            let (h, b) = r.split_once('X').ok_or_else(|| err("a rectangular shank is RECT <h>x<b>"))?;
+            let mm = |s: &str| s.parse::<u16>().ok().filter(|n| (1..=100).contains(n));
+            match (mm(h), mm(b)) {
+                (Some(h), Some(b)) => Self::RectShank { h, b },
+                _ => return Err(err("a rectangular shank takes a height and a width of 1 to 100 mm")),
+            }
+        } else {
+            return Err(err("it names no known connection (write CUSTOM:<name> for another one)"));
+        };
+        Ok(code)
+    }
+
+    /// Refuse a code built in code (not parsed) that its text form
+    /// would refuse: a size off its series, a non-finite diameter, an
+    /// HSK form outside A to F.
+    pub fn check(&self) -> Result<(), ConnectionError> {
+        Self::parse(&self.to_string()).map(|_| ())
+    }
+
+    /// Does a child whose machine side is `child` mate with this
+    /// workpiece side? The same code mates (diameters within
+    /// [`BORE_SLACK`]); a plain bore or collet also takes a Weldon
+    /// shank of its size, a Weldon bore takes only a Weldon shank (its
+    /// screw needs the flat).
+    #[must_use]
+    pub fn takes(&self, child: &Self) -> bool {
+        let same_d = |a: f64, b: f64| (a - b).abs() <= BORE_SLACK;
+        match (self, child) {
+            (Self::Weldon { d: a }, Self::Weldon { d: b })
+            | (Self::Cylindrical { d: a }, Self::Cylindrical { d: b } | Self::Weldon { d: b })
+            | (Self::ShellMillArbor { d: a }, Self::ShellMillArbor { d: b }) => same_d(*a, *b),
+            (Self::Custom(a), Self::Custom(b)) => a == b,
+            _ => self == child,
+        }
+    }
+}
+
+impl core::fmt::Display for ConnectionCode {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::SteepTaper { family, size } => {
+                let name = match family {
+                    SteepTaper::Bt => "BT",
+                    SteepTaper::Cat => "CAT",
+                    SteepTaper::Sk => "SK",
+                };
+                write!(f, "{name}{size}")
+            }
+            Self::Hsk { form, size } => write!(f, "HSK-{form}{size}"),
+            Self::Psc { size } => write!(f, "PSC{size}"),
+            Self::Km { size } => write!(f, "KM{size}"),
+            Self::Er { size } => write!(f, "ER{size}"),
+            Self::Weldon { d } => write!(f, "WELDON {d}"),
+            Self::Cylindrical { d } => write!(f, "CYL {d}"),
+            Self::Tts => write!(f, "TTS"),
+            Self::RectShank { h, b } => write!(f, "RECT {h}x{b}"),
+            Self::Vdi { d } => write!(f, "VDI{d}"),
+            Self::Bmt { size } => write!(f, "BMT{size}"),
+            Self::ShellMillArbor { d } => write!(f, "ARBOR {d}"),
+            Self::Custom(name) => write!(f, "CUSTOM:{name}"),
+        }
+    }
+}
diff --git a/crates/tools/src/insert_codes.rs b/crates/tools/src/insert_codes.rs
new file mode 100644
index 000000000..83f7262a0
--- /dev/null
+++ b/crates/tools/src/insert_codes.rs
@@ -0,0 +1,347 @@
+//! #3642: the letter codes an indexable insert designation is built
+//! from - shape, clearance, tolerance class and fixing - as typed
+//! values with their letters. Our own tables of the code meanings that
+//! the ISO 1832 designation system publishes and that tool vendors
+//! print in their catalogs; no standard text is copied.
+
+/// Position 1: the insert's shape, read by its corner angle.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum InsertShape {
+    /// Parallelogram, 85 degrees.
+    A,
+    /// Parallelogram, 82 degrees.
+    B,
+    /// Rhombic, 80 degrees.
+    C,
+    /// Rhombic, 55 degrees.
+    D,
+    /// Rhombic, 75 degrees.
+    E,
+    /// Hexagon, 120 degrees.
+    H,
+    /// Parallelogram, 55 degrees.
+    K,
+    /// Rectangle, 90 degrees.
+    L,
+    /// Rhombic, 86 degrees.
+    M,
+    /// Octagon, 135 degrees.
+    O,
+    /// Pentagon, 108 degrees.
+    P,
+    /// Round.
+    R,
+    /// Square, 90 degrees.
+    S,
+    /// Triangle, 60 degrees.
+    T,
+    /// Rhombic, 35 degrees.
+    V,
+    /// Trigon, 80 degrees.
+    W,
+}
+
+/// The shape letters in one place, for the parsers' refusals.
+pub const SHAPE_LETTERS: &str = "A B C D E H K L M O P R S T V W";
+
+impl InsertShape {
+    /// The shape for its letter; `None` for a letter that is not one.
+    #[must_use]
+    pub fn from_letter(c: char) -> Option<Self> {
+        Some(match c {
+            'A' => Self::A,
+            'B' => Self::B,
+            'C' => Self::C,
+            'D' => Self::D,
+            'E' => Self::E,
+            'H' => Self::H,
+            'K' => Self::K,
+            'L' => Self::L,
+            'M' => Self::M,
+            'O' => Self::O,
+            'P' => Self::P,
+            'R' => Self::R,
+            'S' => Self::S,
+            'T' => Self::T,
+            'V' => Self::V,
+            'W' => Self::W,
+            _ => return None,
+        })
+    }
+
+    #[must_use]
+    pub fn letter(self) -> char {
+        match self {
+            Self::A => 'A',
+            Self::B => 'B',
+            Self::C => 'C',
+            Self::D => 'D',
+            Self::E => 'E',
+            Self::H => 'H',
+            Self::K => 'K',
+            Self::L => 'L',
+            Self::M => 'M',
+            Self::O => 'O',
+            Self::P => 'P',
+            Self::R => 'R',
+            Self::S => 'S',
+            Self::T => 'T',
+            Self::V => 'V',
+            Self::W => 'W',
+        }
+    }
+
+    /// The corner angle in degrees; `None` for a round insert.
+    #[must_use]
+    pub fn corner_deg(self) -> Option<f64> {
+        Some(match self {
+            Self::A => 85.0,
+            Self::B => 82.0,
+            Self::C | Self::W => 80.0,
+            Self::D | Self::K => 55.0,
+            Self::E => 75.0,
+            Self::H => 120.0,
+            Self::L | Self::S => 90.0,
+            Self::M => 86.0,
+            Self::O => 135.0,
+            Self::P => 108.0,
+            Self::T => 60.0,
+            Self::V => 35.0,
+            Self::R => return None,
+        })
+    }
+
+    /// The edge length over the inscribed circle's diameter, for the
+    /// shapes whose every edge touches that circle. Each edge is the
+    /// two tangent lengths from its end corners, `r / tan(a / 2)`. A
+    /// trigon alternates 80 and 160 degree corners. `None` for a
+    /// parallelogram or a rectangle (no circle touches all four
+    /// edges) and for a round insert (its size is its diameter).
+    #[must_use]
+    pub fn edge_per_ic(self) -> Option<f64> {
+        let cot_half = |deg: f64| 1.0 / (deg.to_radians() * 0.5).tan();
+        // The edge in units of the radius, halved to units of the diameter.
+        let per_r = match self {
+            Self::C | Self::D | Self::E | Self::M | Self::V => {
+                let a = self.corner_deg()?;
+                cot_half(a) + cot_half(180.0 - a)
+            }
+            Self::S | Self::T | Self::H | Self::O | Self::P => 2.0 * cot_half(self.corner_deg()?),
+            Self::W => cot_half(80.0) + cot_half(160.0),
+            Self::A | Self::B | Self::K | Self::L | Self::R => return None,
+        };
+        Some(per_r * 0.5)
+    }
+}
+
+/// Position 2 (and position 4 of a holder): the clearance angle under
+/// the cutting edge.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Clearance {
+    A,
+    B,
+    C,
+    D,
+    E,
+    F,
+    G,
+    N,
+    P,
+    /// Another clearance, stated in the catalog.
+    O,
+}
+
+pub const CLEARANCE_LETTERS: &str = "A B C D E F G N P O";
+
+impl Clearance {
+    #[must_use]
+    pub fn from_letter(c: char) -> Option<Self> {
+        Some(match c {
+            'A' => Self::A,
+            'B' => Self::B,
+            'C' => Self::C,
+            'D' => Self::D,
+            'E' => Self::E,
+            'F' => Self::F,
+            'G' => Self::G,
+            'N' => Self::N,
+            'P' => Self::P,
+            'O' => Self::O,
+            _ => return None,
+        })
+    }
+
+    #[must_use]
+    pub fn letter(self) -> char {
+        match self {
+            Self::A => 'A',
+            Self::B => 'B',
+            Self::C => 'C',
+            Self::D => 'D',
+            Self::E => 'E',
+            Self::F => 'F',
+            Self::G => 'G',
+            Self::N => 'N',
+            Self::P => 'P',
+            Self::O => 'O',
+        }
+    }
+
+    /// The angle in degrees; `None` for "another clearance".
+    #[must_use]
+    pub fn degrees(self) -> Option<f64> {
+        Some(match self {
+            Self::A => 3.0,
+            Self::B => 5.0,
+            Self::C => 7.0,
+            Self::D => 15.0,
+            Self::E => 20.0,
+            Self::F => 25.0,
+            Self::G => 30.0,
+            Self::N => 0.0,
+            Self::P => 11.0,
+            Self::O => return None,
+        })
+    }
+}
+
+/// Position 3: the tolerance class letters. Kept as its letter: no
+/// fit check reads it.
+pub const TOLERANCE_LETTERS: &str = "A C E F G H J K L M N U";
+
+/// Position 4: how the insert is held and whether it has a chip
+/// breaker - the fixing hole is what a holder's clamping must match.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Fixing {
+    /// No hole, no chip breaker.
+    N,
+    /// No hole, chip breaker on one face.
+    R,
+    /// No hole, chip breakers on both faces.
+    F,
+    /// Cylindrical hole, no chip breaker.
+    A,
+    /// Cylindrical hole, chip breaker on one face.
+    M,
+    /// Cylindrical hole, chip breakers on both faces.
+    G,
+    /// Hole countersunk on one face (40-60 degrees), no chip breaker.
+    W,
+    /// Hole countersunk on one face (40-60 degrees), chip breaker.
+    T,
+    /// Hole countersunk on both faces (40-60 degrees), no chip breaker.
+    Q,
+    /// Hole countersunk on both faces (40-60 degrees), chip breakers.
+    U,
+    /// Hole countersunk on one face (70-90 degrees), no chip breaker.
+    B,
+    /// Hole countersunk on one face (70-90 degrees), chip breaker.
+    H,
+    /// Hole countersunk on both faces (70-90 degrees), no chip breaker.
+    C,
+    /// Hole countersunk on both faces (70-90 degrees), chip breakers.
+    J,
+    /// A special form, stated in the catalog.
+    X,
+}
+
+pub const FIXING_LETTERS: &str = "N R F A M G W T Q U B H C J X";
+
+/// What holds the insert in place, as a clamp reads it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum FixingHole {
+    /// A plain insert: a clamp from the top holds it.
+    None,
+    /// A straight hole: a pin or lever pulls it into the pocket.
+    Cylindrical,
+    /// A countersunk hole: a screw holds it.
+    Countersunk,
+    /// A special form: no standard clamp takes it.
+    Special,
+}
+
+impl Fixing {
+    #[must_use]
+    pub fn from_letter(c: char) -> Option<Self> {
+        Some(match c {
+            'N' => Self::N,
+            'R' => Self::R,
+            'F' => Self::F,
+            'A' => Self::A,
+            'M' => Self::M,
+            'G' => Self::G,
+            'W' => Self::W,
+            'T' => Self::T,
+            'Q' => Self::Q,
+            'U' => Self::U,
+            'B' => Self::B,
+            'H' => Self::H,
+            'C' => Self::C,
+            'J' => Self::J,
+            'X' => Self::X,
+            _ => return None,
+        })
+    }
+
+    #[must_use]
+    pub fn letter(self) -> char {
+        match self {
+            Self::N => 'N',
+            Self::R => 'R',
+            Self::F => 'F',
+            Self::A => 'A',
+            Self::M => 'M',
+            Self::G => 'G',
+            Self::W => 'W',
+            Self::T => 'T',
+            Self::Q => 'Q',
+            Self::U => 'U',
+            Self::B => 'B',
+            Self::H => 'H',
+            Self::C => 'C',
+            Self::J => 'J',
+            Self::X => 'X',
+        }
+    }
+
+    /// The hole that the clamp must match.
+    #[must_use]
+    pub fn hole(self) -> FixingHole {
+        match self {
+            Self::N | Self::R | Self::F => FixingHole::None,
+            Self::A | Self::M | Self::G => FixingHole::Cylindrical,
+            Self::W | Self::T | Self::Q | Self::U | Self::B | Self::H | Self::C | Self::J => FixingHole::Countersunk,
+            Self::X => FixingHole::Special,
+        }
+    }
+}
+
+/// The cutting direction of an insert or a holder.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Hand {
+    R,
+    L,
+    /// Neutral: cuts in both directions.
+    N,
+}
+
+impl Hand {
+    #[must_use]
+    pub fn from_letter(c: char) -> Option<Self> {
+        Some(match c {
+            'R' => Self::R,
+            'L' => Self::L,
+            'N' => Self::N,
+            _ => return None,
+        })
+    }
+
+    #[must_use]
+    pub fn letter(self) -> char {
+        match self {
+            Self::R => 'R',
+            Self::L => 'L',
+            Self::N => 'N',
+        }
+    }
+}
diff --git a/crates/tools/src/insert_designation_tests.rs b/crates/tools/src/insert_designation_tests.rs
new file mode 100644
index 000000000..e70abb97e
--- /dev/null
+++ b/crates/tools/src/insert_designation_tests.rs
@@ -0,0 +1,199 @@
+//! #3642: the ISO 1832 insert code, the ISO 5608 holder code and the
+//! connection codes - parsed, written back, and refused by name.
+
+use crate::connection_code::{ConnectionCode, SteepTaper};
+use crate::insert_codes::{Clearance, Fixing, Hand, InsertShape};
+use crate::insert_iso1832::{Corner, DesignationError, InsertSpec};
+use crate::insert_seat::{Clamping, HolderDesignation};
+
+fn ok(code: &str) -> InsertSpec {
+    match InsertSpec::parse(code) {
+        Ok(s) => s,
+        Err(e) => panic!("{code}: {e}"),
+    }
+}
+
+fn close(a: Option<f64>, b: f64) -> bool {
+    a.is_some_and(|a| (a - b).abs() < 1e-9)
+}
+
+#[test]
+fn common_turning_inserts_parse() {
+    let c = ok("CNMG120408");
+    assert_eq!((c.shape, c.clearance, c.tolerance, c.fixing, c.size), (InsertShape::C, Clearance::N, 'M', Fixing::G, 12));
+    assert_eq!(c.thickness.code(), "04");
+    assert!(close(c.thickness.nominal_mm(), 4.76));
+    assert!(close(c.corner.nose_radius_mm(), 0.8));
+    assert!(close(c.inscribed_circle_mm(), 12.7));
+    assert_eq!(c.hand, None);
+
+    // Each shape's edge length maps back to its inscribed circle.
+    for (code, ic) in [
+        ("DNMG150608", 12.7),
+        ("VBMT160404", 9.525),
+        ("TNMG160408", 9.525),
+        ("WNMG080408", 12.7),
+        ("SNMG120408", 12.7),
+        ("CCMT09T304", 9.525),
+        ("TCMT110204", 6.35),
+    ] {
+        assert!(close(ok(code).inscribed_circle_mm(), ic), "{code}");
+    }
+    let cc = ok("CCMT09T304");
+    assert_eq!(cc.thickness.code(), "T3");
+    assert!(close(cc.thickness.nominal_mm(), 3.97));
+    let round = ok("RCMT1204M0");
+    assert_eq!(round.corner, Corner::Round);
+    assert_eq!(round.inscribed_circle_mm(), None);
+}
+
+#[test]
+fn common_milling_inserts_parse() {
+    let s = ok("SEKN1203AFTN");
+    assert_eq!((s.shape, s.clearance, s.fixing), (InsertShape::S, Clearance::E, Fixing::N));
+    assert_eq!(s.corner, Corner::Facet { angle: 'A', clearance: Clearance::F });
+    assert_eq!(s.hand, Some(Hand::N));
+    assert_eq!(s.tail, "TN");
+    assert_eq!(ok("SPKN1203EDR").hand, Some(Hand::R));
+    assert_eq!(ok("TPKN1603PDL").hand, Some(Hand::L));
+    assert_eq!(ok("RPMT10T3M0").corner, Corner::Round);
+}
+
+#[test]
+fn designations_round_trip_through_their_text() {
+    let spaced = ok("cnmg 12 04 08-pm");
+    assert_eq!(spaced.to_string(), "CNMG120408-PM");
+    assert_eq!(spaced.hand, None);
+    for code in ["CNMG120408", "CNMG120408-PM", "SEKN1203AFTN", "RCMT1204M0", "CCMT09T304", "VBMT160400"] {
+        let s = ok(code);
+        assert_eq!(s.to_string(), code);
+        assert_eq!(ok(&s.to_string()), s);
+    }
+    assert_eq!(ok("VBMT160400").corner, Corner::Sharp);
+}
+
+fn refused(code: &str) -> DesignationError {
+    match InsertSpec::parse(code) {
+        Ok(s) => panic!("{code} parsed as {s}"),
+        Err(e) => e,
+    }
+}
+
+fn position(code: &str) -> u8 {
+    match refused(code) {
+        DesignationError::Position { pos, standard, .. } => {
+            assert_eq!(standard, "ISO 1832");
+            pos
+        }
+        e => panic!("{code}: {e}"),
+    }
+}
+
+#[test]
+fn malformed_insert_codes_are_refused_by_position() {
+    assert_eq!(refused(""), DesignationError::Empty { standard: "ISO 1832" });
+    assert_eq!(refused("   "), DesignationError::Empty { standard: "ISO 1832" });
+    assert!(matches!(refused("CNMG12"), DesignationError::TooShort { len: 6, need: 10, .. }));
+    // An inch code is too short for the metric layout.
+    assert!(matches!(refused("CNMG432"), DesignationError::TooShort { .. }));
+    assert!(matches!(refused("CNMG\u{e9}20408"), DesignationError::NonAscii { .. }));
+    assert_eq!(position("QNMG120408"), 1);
+    assert_eq!(position("CZMG120408"), 2);
+    assert_eq!(position("CNBG120408"), 3);
+    assert_eq!(position("CNMZ120408"), 4);
+    assert_eq!(position("CNMG000408"), 5);
+    assert_eq!(position("CNMGAB0408"), 5);
+    assert_eq!(position("CNMG12XX08"), 6);
+    assert_eq!(position("CNMG120000"), 6);
+    assert_eq!(position("CNMG1204M0"), 7);
+    assert_eq!(position("RCMT120408"), 7);
+    assert_eq!(position("SEKN1203QFTN"), 7);
+    assert_eq!(position("CNMG120408#"), 8);
+    let text = refused("QNMG120408").to_string();
+    assert!(text.contains("ISO 1832 position 1 (shape): 'Q'"), "{text}");
+}
+
+#[test]
+fn turning_holder_codes_parse_and_round_trip() {
+    let Ok(h) = HolderDesignation::parse("PCLNR2525M12") else { panic!("PCLNR2525M12") };
+    let s = h.seat;
+    assert_eq!((s.clamping, s.shape, s.clearance, s.hand, s.size), (Clamping::P, InsertShape::C, Clearance::N, Hand::R, 12));
+    assert_eq!(s.style.approach_deg(), Some(95.0));
+    assert_eq!((h.shank_h, h.shank_b, h.length_mm()), (25, 25, Some(150.0)));
+    assert_eq!(h.to_string(), "PCLNR2525M12");
+    let Ok(v) = HolderDesignation::parse("svjbl 2020 k16") else { panic!("svjbl") };
+    assert_eq!((v.seat.clamping, v.seat.style.approach_deg(), v.seat.hand), (Clamping::S, Some(93.0), Hand::L));
+    assert_eq!(v.to_string(), "SVJBL2020K16");
+    assert_eq!(HolderDesignation::parse(&v.to_string()), Ok(v));
+}
+
+#[test]
+fn malformed_holder_codes_are_refused_by_position() {
+    let pos = |code: &str| match HolderDesignation::parse(code) {
+        Err(DesignationError::Position { pos, standard: "ISO 5608", .. }) => pos,
+        other => panic!("{code}: {other:?}"),
+    };
+    assert_eq!(pos("ZCLNR2525M12"), 1);
+    assert_eq!(pos("PQLNR2525M12"), 2);
+    assert_eq!(pos("PCINR2525M12"), 3);
+    assert_eq!(pos("PCLZR2525M12"), 4);
+    assert_eq!(pos("PCLNX2525M12"), 5);
+    assert_eq!(pos("PCLNR0025M12"), 6);
+    assert_eq!(pos("PCLNR25A5M12"), 7);
+    assert_eq!(pos("PCLNR2525I12"), 8);
+    assert_eq!(pos("PCLNR2525M1A"), 9);
+    assert!(matches!(HolderDesignation::parse("PCLNR25"), Err(DesignationError::TooShort { need: 12, .. })));
+    assert!(matches!(HolderDesignation::parse(""), Err(DesignationError::Empty { .. })));
+}
+
+#[test]
+fn connection_codes_round_trip_and_refuse_by_name() {
+    for code in [
+        "BT40", "CAT40", "SK50", "HSK-A63", "PSC63", "KM63", "ER32", "WELDON 12", "CYL 12.7", "TTS", "RECT 25x25",
+        "VDI40", "BMT65", "ARBOR 22", "CUSTOM:Shop pallet",
+    ] {
+        let Ok(c) = ConnectionCode::parse(code) else { panic!("{code}") };
+        assert_eq!(c.to_string(), code);
+        assert_eq!(c.check(), Ok(()));
+    }
+    assert_eq!(ConnectionCode::parse(" hsk-a 63 "), Ok(ConnectionCode::Hsk { form: 'A', size: 63 }));
+    assert_eq!(ConnectionCode::parse("bt 40"), Ok(ConnectionCode::SteepTaper { family: SteepTaper::Bt, size: 40 }));
+    for bad in ["", "BT45", "HSK-Z63", "ER33", "CYL 0", "CYL nan", "CYL 900", "XYZ", "CUSTOM:", "RECT 25", "ER32\u{e9}"] {
+        let Err(e) = ConnectionCode::parse(bad) else { panic!("{bad} parsed") };
+        assert!(e.to_string().starts_with("the connection code"), "{e}");
+    }
+    assert!(ConnectionCode::Hsk { form: 'Z', size: 63 }.check().is_err());
+    assert!(ConnectionCode::Cylindrical { d: f64::NAN }.check().is_err());
+}
+
+#[test]
+fn a_plain_bore_takes_a_weldon_shank_but_not_the_reverse() {
+    let cyl = |d| ConnectionCode::Cylindrical { d };
+    let weldon = |d| ConnectionCode::Weldon { d };
+    assert!(cyl(12.0).takes(&weldon(12.0)));
+    assert!(cyl(12.0).takes(&cyl(12.01)));
+    assert!(!cyl(12.0).takes(&cyl(12.5)));
+    assert!(!weldon(12.0).takes(&cyl(12.0)));
+    assert!(!ConnectionCode::Er { size: 32 }.takes(&ConnectionCode::Er { size: 25 }));
+}
+
+/// Degenerate text never panics: a fixed pseudo-random walk over an
+/// alphabet with digits, letters, separators and non-ASCII characters.
+#[test]
+fn degenerate_codes_never_panic() {
+    let alphabet: Vec<char> = "CNMGRTSVDW0123456789-TXM: ._\u{e9}\u{0}\u{1F600}x".chars().collect();
+    let mut seed: u64 = 0x3642;
+    let mut next = || {
+        seed = seed.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);
+        (seed >> 33) as usize
+    };
+    for _ in 0..5000 {
+        let len = next() % 24;
+        let text: String = (0..len).map(|_| alphabet[next() % alphabet.len()]).collect();
+        if let Ok(s) = InsertSpec::parse(&text) {
+            assert_eq!(InsertSpec::parse(&s.to_string()), Ok(s.clone()), "{text}");
+        }
+        let _ = HolderDesignation::parse(&text);
+        let _ = ConnectionCode::parse(&text);
+    }
+}
diff --git a/crates/tools/src/insert_iso1832.rs b/crates/tools/src/insert_iso1832.rs
new file mode 100644
index 000000000..2969e54ad
--- /dev/null
+++ b/crates/tools/src/insert_iso1832.rs
@@ -0,0 +1,278 @@
+//! #3642: an indexable insert's designation code (ISO 1832, metric
+//! form) parsed into a typed [`InsertSpec`]: positions 1 to 7 are
+//! shape, clearance, tolerance class, fixing, size, thickness and the
+//! corner; what follows (edge condition, hand, the maker's chip
+//! breaker) is kept as written. Our own parser over the position
+//! layout that tool vendors publish with their catalogs; no standard
+//! text is copied.
+//!
+//! The law: every malformed code is refused by name - the standard,
+//! the position, what was found and what that position takes. An
+//! empty, short, non-ASCII or inch-form code is a clean error, never a
+//! panic.
+
+use crate::insert_codes::{
+    Clearance, Fixing, Hand, InsertShape, CLEARANCE_LETTERS, FIXING_LETTERS, SHAPE_LETTERS, TOLERANCE_LETTERS,
+};
+
+/// Why a designation code is refused. Each refusal names the standard
+/// and, where it can, the position.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DesignationError {
+    Empty { standard: &'static str },
+    NonAscii { standard: &'static str, text: String },
+    TooShort { standard: &'static str, text: String, len: usize, need: usize },
+    Position { standard: &'static str, pos: u8, name: &'static str, found: String, expected: String },
+}
+
+impl core::fmt::Display for DesignationError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::Empty { standard } => write!(f, "the {standard} designation is empty"),
+            Self::NonAscii { standard, text } => {
+                write!(f, "the {standard} designation '{text}' has a character that is not ASCII")
+            }
+            Self::TooShort { standard, text, len, need } => write!(
+                f,
+                "the {standard} designation '{text}' has {len} characters - it needs {need} at least"
+            ),
+            Self::Position { standard, pos, name, found, expected } => {
+                write!(f, "{standard} position {pos} ({name}): '{found}' is not valid - it takes {expected}")
+            }
+        }
+    }
+}
+
+impl std::error::Error for DesignationError {}
+
+const STD: &str = "ISO 1832";
+
+/// Position 6: the thickness code, two characters. Digits are the
+/// thickness in whole mm; a `T` and a digit is a size between two
+/// whole mm.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct Thickness([u8; 2]);
+
+impl Thickness {
+    /// The code for its two characters; `None` if they are not one.
+    #[must_use]
+    pub fn from_code(code: &str) -> Option<Self> {
+        let b = code.as_bytes();
+        let &[a, d] = b else { return None };
+        let ok = (a.is_ascii_digit() || a == b'T') && d.is_ascii_digit() && !(a == b'0' && d == b'0');
+        ok.then_some(Self([a, d]))
+    }
+
+    #[must_use]
+    pub fn code(self) -> String {
+        self.0.iter().map(|&b| char::from(b)).collect()
+    }
+
+    /// The nominal thickness (mm) of the common codes; `None` for a
+    /// code this table does not hold.
+    #[must_use]
+    pub fn nominal_mm(self) -> Option<f64> {
+        Some(match &self.0 {
+            b"01" => 1.59,
+            b"T1" => 1.98,
+            b"02" => 2.38,
+            b"T2" => 2.78,
+            b"03" => 3.18,
+            b"T3" => 3.97,
+            b"04" => 4.76,
+            b"05" => 5.56,
+            b"06" => 6.35,
+            b"07" => 7.94,
+            b"09" => 9.52,
+            _ => return None,
+        })
+    }
+}
+
+/// Position 7: the corner.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Corner {
+    /// A nose radius in tenths of a mm ("08" is 0.8 mm).
+    Radius(u8),
+    /// A sharp corner ("00" on an insert that is not round).
+    Sharp,
+    /// A round insert ("M0" or "00").
+    Round,
+    /// A milling insert's wiper facet: the letter of its edge angle
+    /// (A, D, E, F, P or Z) and its clearance letter.
+    Facet { angle: char, clearance: Clearance },
+}
+
+impl Corner {
+    /// The nose radius in mm; `None` for a round insert or a facet.
+    #[must_use]
+    pub fn nose_radius_mm(self) -> Option<f64> {
+        match self {
+            Self::Radius(t) => Some(f64::from(t) / 10.0),
+            Self::Sharp => Some(0.0),
+            Self::Round | Self::Facet { .. } => None,
+        }
+    }
+
+    fn code(self) -> String {
+        match self {
+            Self::Radius(t) => format!("{t:02}"),
+            Self::Sharp => "00".to_owned(),
+            Self::Round => "M0".to_owned(),
+            Self::Facet { angle, clearance } => format!("{angle}{}", clearance.letter()),
+        }
+    }
+}
+
+/// The inscribed-circle diameters (mm) of the common metric and inch
+/// insert sizes, smallest first.
+pub const IC_SERIES: [f64; 11] = [3.97, 4.76, 5.56, 6.35, 7.94, 9.525, 12.7, 15.875, 19.05, 25.4, 31.75];
+
+/// The edge length is cut to whole mm after this much (mm) is added:
+/// a 6.35 mm triangle's edge works out to 10.998 mm, and its code is 11.
+const EDGE_SLACK: f64 = 0.02;
+
+/// One insert, as its designation code states it.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct InsertSpec {
+    pub shape: InsertShape,
+    pub clearance: Clearance,
+    /// Position 3, kept as its letter.
+    pub tolerance: char,
+    pub fixing: Fixing,
+    /// Position 5: the edge length in whole mm (the diameter of a
+    /// round insert).
+    pub size: u8,
+    pub thickness: Thickness,
+    pub corner: Corner,
+    /// The cutting direction, when the code states one after
+    /// position 7; `None` when it does not.
+    pub hand: Option<Hand>,
+    /// All that follows position 7, as written (upper case, no
+    /// spaces): the edge condition, the hand, the maker's chip breaker.
+    pub tail: String,
+}
+
+impl InsertSpec {
+    /// Parse a metric designation. Spaces are ignored and letters are
+    /// read in upper case: "cnmg 12 04 08-pm" is "CNMG120408-PM".
+    pub fn parse(text: &str) -> Result<Self, DesignationError> {
+        let core = normalize(STD, text, 10)?;
+        let b = core.as_bytes();
+        let at = |i: usize| char::from(b[i]);
+        let pos = |pos: u8, name, found: String, expected: &str| DesignationError::Position {
+            standard: STD,
+            pos,
+            name,
+            found,
+            expected: expected.to_owned(),
+        };
+        let shape = InsertShape::from_letter(at(0)).ok_or_else(|| pos(1, "shape", at(0).into(), SHAPE_LETTERS))?;
+        let clearance =
+            Clearance::from_letter(at(1)).ok_or_else(|| pos(2, "clearance", at(1).into(), CLEARANCE_LETTERS))?;
+        let tolerance = at(2);
+        if !(tolerance.is_ascii_uppercase() && TOLERANCE_LETTERS.contains(tolerance)) {
+            return Err(pos(3, "tolerance class", tolerance.into(), TOLERANCE_LETTERS));
+        }
+        let fixing = Fixing::from_letter(at(3)).ok_or_else(|| pos(4, "fixing", at(3).into(), FIXING_LETTERS))?;
+        let size = two_digits(&core[4..6])
+            .filter(|&n| n > 0)
+            .ok_or_else(|| pos(5, "size", core[4..6].to_owned(), "two digits, 01 to 99 (an inch code is not read)"))?;
+        let thickness = Thickness::from_code(&core[6..8])
+            .ok_or_else(|| pos(6, "thickness", core[6..8].to_owned(), "two digits, or T and a digit"))?;
+        let corner = parse_corner(shape, &core[8..10]).ok_or_else(|| {
+            let expected = if shape == InsertShape::R {
+                "M0 or 00 on a round insert"
+            } else {
+                "two digits (radius in 0.1 mm), or a facet: A D E F P Z and a clearance letter"
+            };
+            pos(7, "corner", core[8..10].to_owned(), expected)
+        })?;
+        let tail = core[10..].to_owned();
+        if let Some(bad) = tail.chars().find(|c| !(c.is_ascii_alphanumeric() || matches!(c, '-' | '.' | '/'))) {
+            return Err(pos(8, "suffix", bad.into(), "letters, digits, '-', '.' or '/'"));
+        }
+        Ok(Self { shape, clearance, tolerance, fixing, size, thickness, corner, hand: tail_hand(&tail), tail })
+    }
+
+    /// The inscribed circle (mm): the series size whose edge, cut to
+    /// whole mm (after [`EDGE_SLACK`]), is the size code. `None` for a parallelogram, a
+    /// rectangle or a round insert, and for a size off the series.
+    #[must_use]
+    pub fn inscribed_circle_mm(&self) -> Option<f64> {
+        let k = self.shape.edge_per_ic()?;
+        IC_SERIES.iter().copied().find(|ic| (ic * k + EDGE_SLACK).floor() == f64::from(self.size))
+    }
+}
+
+impl core::fmt::Display for InsertSpec {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(
+            f,
+            "{}{}{}{}{:02}{}{}{}",
+            self.shape.letter(),
+            self.clearance.letter(),
+            self.tolerance,
+            self.fixing.letter(),
+            self.size,
+            self.thickness.code(),
+            self.corner.code(),
+            self.tail
+        )
+    }
+}
+
+/// Trim, refuse empty and non-ASCII text, drop the spaces, read upper
+/// case, and refuse a code shorter than `need`.
+pub(crate) fn normalize(standard: &'static str, text: &str, need: usize) -> Result<String, DesignationError> {
+    let trimmed = text.trim();
+    if trimmed.is_empty() {
+        return Err(DesignationError::Empty { standard });
+    }
+    if !trimmed.is_ascii() {
+        return Err(DesignationError::NonAscii { standard, text: trimmed.to_owned() });
+    }
+    let core: String = trimmed.chars().filter(|c| !c.is_ascii_whitespace()).map(|c| c.to_ascii_uppercase()).collect();
+    if core.len() < need {
+        return Err(DesignationError::TooShort { standard, text: trimmed.to_owned(), len: core.len(), need });
+    }
+    Ok(core)
+}
+
+/// Two ASCII digits as a number.
+pub(crate) fn two_digits(s: &str) -> Option<u8> {
+    match s.as_bytes() {
+        &[a, b] if a.is_ascii_digit() && b.is_ascii_digit() => Some((a - b'0') * 10 + (b - b'0')),
+        _ => None,
+    }
+}
+
+fn parse_corner(shape: InsertShape, s: &str) -> Option<Corner> {
+    let round = shape == InsertShape::R;
+    if s == "M0" || (round && s == "00") {
+        return round.then_some(Corner::Round);
+    }
+    if round {
+        return None;
+    }
+    if let Some(t) = two_digits(s) {
+        return Some(if t == 0 { Corner::Sharp } else { Corner::Radius(t) });
+    }
+    let mut c = s.chars();
+    let (angle, clr) = (c.next()?, c.next()?);
+    let clearance = Clearance::from_letter(clr)?;
+    "ADEFPZ".contains(angle).then_some(Corner::Facet { angle, clearance })
+}
+
+/// The hand a code states after position 7: one letter (R, L, N), or
+/// an edge condition letter (F, E, T, S, K, P) and then the hand.
+/// Anything else (a maker's chip breaker) states no hand.
+fn tail_hand(tail: &str) -> Option<Hand> {
+    let head = tail.split('-').next().unwrap_or("");
+    let b = head.as_bytes();
+    match b {
+        &[h] => Hand::from_letter(char::from(h)),
+        &[e, h] if b"FETSKP".contains(&e) => Hand::from_letter(char::from(h)),
+        _ => None,
+    }
+}
diff --git a/crates/tools/src/insert_seat.rs b/crates/tools/src/insert_seat.rs
