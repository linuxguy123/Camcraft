+    let in_keep = |m: &camcraft_motion::cl::Move| m.to.z == CUT_Z && m.to.y == -1.0 && m.to.x.abs() < 4.0;
+    assert!(!t.moves.iter().any(in_keep), "the keep-out stays clear");
+}
