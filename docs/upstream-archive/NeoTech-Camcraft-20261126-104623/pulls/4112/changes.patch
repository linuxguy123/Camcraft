+    let chain = el();
+    // The L's inside corner keeps the wire radius (#3207).
+    let prm = WireParams { sharp_corners: true, ..params(WireSide::Punch, (25.0, 6.0)) };
+    let a = wire_contour_arcs(&chain, &prm).unwrap();
