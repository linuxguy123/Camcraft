+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+    }
+}
+
+#[test]
+fn kernel_baseline_circular() {
+    let reg = region(vec![rect(-20.0, -20.0, 20.0, 20.0)]);
+    let cases: [(&str, CircularParams); 9] = [
+        ("auto", params()),
