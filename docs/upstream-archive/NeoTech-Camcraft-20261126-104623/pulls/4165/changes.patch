+        ("vault_outside", CircularParams { vault: true, top_z: 0.0, bottom_z: -6.0, pass_start: PassStart::Outside, ..params() }),
+    ];
+    for (case, p) in cases {
+        pin("circular", case, &circular(&reg, &p).unwrap_or_else(|e| panic!("{case}: {e}")));
