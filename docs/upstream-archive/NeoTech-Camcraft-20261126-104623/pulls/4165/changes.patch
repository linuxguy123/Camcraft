+fn params() -> CircularParams {
+    CircularParams {
+        pass_start: PassStart::Auto,
+        links: Links::PLANAR,
+        center: Point2::new(0.0, 0.0),
+        radius: 15.0,
+        vault: false,
+        bottom_z: -4.0,
+        top_z: 0.0,
+        tool_diameter: 8.0,
+        stock_to_leave: 0.0,
+        stepover: 3.0,
+        stepdown: 2.0,
