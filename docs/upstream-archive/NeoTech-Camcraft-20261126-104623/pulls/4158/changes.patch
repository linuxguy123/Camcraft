From c2baa58a9441d459b6668d28fdc4744f3d048ebf Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Thu, 26 Nov 2026 03:42:38 -0500
Subject: [PATCH] fix(post): write G04 F dwell for iTNC 530 in heidenhain
 DIN/ISO post

---
 assets/posts/heidenhain.cps                | 35 ++++++++-
 crates/post/tests/heidenhain_block_form.rs | 82 ++++++++++++++++++++++
 crates/post/tests/heidenhain_cycles.rs     |  2 +-
 3 files changed, 117 insertions(+), 2 deletions(-)

diff --git a/assets/posts/heidenhain.cps b/assets/posts/heidenhain.cps
index 5933acf8b..9b94f7617 100644
--- a/assets/posts/heidenhain.cps
+++ b/assets/posts/heidenhain.cps
@@ -815,9 +815,42 @@ function onCycle() {
   if (!xyFirst(p.X, p.Y, p.R, false)) return;  // #1633: refused - the move is not written
   motion("G00", [wo("X", p.X, orgX), wo("Y", p.Y, orgY), wo("Z", p.R, orgZ), "M99"]);
 }
+function supportsFunctionDwell() {
+  if (typeof machine === "undefined" || !machine) return true;
+  var id = machine.controllerIdentity;
+  if (!id || !id.model) return true;
+  var m = String(id.model).trim();
+  // iTNC 530 has no version that supports FUNCTION DWELL (it uses cycle 9 G04 F).
+  if (m === "iTNC 530" || m.indexOf("iTNC 530") >= 0) return false;
+  var nc = id.nc_software ? String(id.nc_software).trim() : "";
+  // Check known minimum NC software versions for FUNCTION DWELL:
+  // TNC 640: 34059x-07
+  // TNC 620: 81760x-04
+  // TNC 320: 77185x-04
+  // TNC 128: 77184x-05
+  // TNC7: all versions
+  if (m === "TNC7" || m.indexOf("TNC7") >= 0) return true;
+  var match = nc.match(/^(\d{5})\d-(\d{2})/);
+  if (match) {
+    var prefix = match[1];
+    var rel = parseInt(match[2], 10);
+    if (prefix === "34059") return rel >= 7;
+    if (prefix === "81760") return rel >= 4;
+    if (prefix === "77185") return rel >= 4;
+    if (prefix === "77184") return rel >= 5;
+    // Any older software family (e.g. 34049, 60642, 34055, 34056, 73498, 28047, etc.)
+    return false;
+  }
+  return true;
+}
+
 function dwellAtBottom(z) {
   if (pendingDwell === null || !has(z) || Math.abs(z - pendingDwell.z) > DWELL_TOL) return;
-  block(["FUNCTION DWELL TIME" + fu(pendingDwell.s)]);
+  if (supportsFunctionDwell()) {
+    block(["FUNCTION DWELL TIME " + fu(pendingDwell.s)]);
+  } else {
+    block(["G04", "F" + fu(pendingDwell.s)]);
+  }
   pendingDwell = null;
 }
 // A dwell whose chain never reached its bottom is refused, never lost.
diff --git a/crates/post/tests/heidenhain_block_form.rs b/crates/post/tests/heidenhain_block_form.rs
index e7af054d2..caeaf229d 100644
--- a/crates/post/tests/heidenhain_block_form.rs
+++ b/crates/post/tests/heidenhain_block_form.rs
@@ -276,3 +276,85 @@ fn heidenhain_keeps_the_legacy_no_spindle_tap_refusal_and_maps_presets() {
     assert!(out.warnings.is_empty(), "{:?}", out.warnings);
     assert!(!out.program.contains("G247"), "no WorkOffset keeps the control's active preset: {}", out.program);
 }
+
+#[test]
+fn heidenhain_dwell_writes_g04_f_for_itnc_and_function_dwell_for_newer() {
+    let make_stream = || {
+        use cnc::CycleRec;
+        use cnc::Record as R;
+        let rs = vec![
+            R::Param { name: "OperationName".into(), value: json!("Ream") },
+            R::Param { name: "SpindleSpeed".into(), value: json!(1000.0) },
+            R::Param { name: "ClearancePlane".into(), value: json!(10.0) },
+            R::Tool { number: 1, name: "Reamer".into() },
+            R::Section { begin: true },
+            R::Cycle(CycleRec {
+                kind: CycleKind::Ream,
+                x: 0.0,
+                y: 0.0,
+                r_z: 2.0,
+                bottom_z: -10.0,
+                entry_z: 0.0,
+                peck: 0.0,
+                dwell: 0.5,
+                first_move: 0,
+                feed: Some(100.0),
+            }),
+            mv(MoveKind::Rapid, 0.0, 0.0, 2.0, None),
+            mv(MoveKind::Feed, 0.0, 0.0, -10.0, Some(100.0)),
+            mv(MoveKind::Feed, 0.0, 0.0, 2.0, Some(100.0)),
+            mv(MoveKind::Rapid, 0.0, 0.0, 10.0, None),
+            R::Section { begin: false },
+        ];
+        cnc::serialize(&rs)
+    };
+    let cps = read("assets/posts/heidenhain.cps");
+    let stream = make_stream();
+
+    // 1. Fehlmann Picomax 55 (iTNC 530 NC 340490-03) machine file
+    let fehlmann = serde_json::from_str::<serde_json::Value>(
+        &read("assets/machines/fehlmann-picomax55.mch"),
+    ).expect("fehlmann machine");
+    let out = engine::run(&cps, &fehlmann, &stream).expect("posts with fehlmann");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(out.program.contains("G04 F0.5*"), "iTNC 530 writes G04 F: {}", out.program);
+    assert!(!out.program.contains("FUNCTION DWELL"), "iTNC 530 must not write FUNCTION DWELL: {}", out.program);
+
+    // 2. Generic machine stating iTNC 530
+    let mut itnc_mch: serde_json::Value =
+        serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("vmc");
+    itnc_mch["controller"] = json!({
+        "identity": { "model": "iTNC 530", "nc_software": "606425-04" }
+    });
+    let out = engine::run(&cps, &itnc_mch, &stream).expect("posts with itnc 606425");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(out.program.contains("G04 F0.5*"), "iTNC 606425 writes G04 F: {}", out.program);
+    assert!(!out.program.contains("FUNCTION DWELL"), "iTNC 606425 must not write FUNCTION DWELL");
+
+    // 3. TNC 640 before -07 (e.g. 340590-06) writes G04 F
+    let mut tnc640_old = itnc_mch.clone();
+    tnc640_old["controller"] = json!({
+        "identity": { "model": "TNC 640", "nc_software": "340590-06" }
+    });
+    let out = engine::run(&cps, &tnc640_old, &stream).expect("posts with tnc 640 -06");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(out.program.contains("G04 F0.5*"), "TNC 640 -06 writes G04 F: {}", out.program);
+    assert!(!out.program.contains("FUNCTION DWELL"));
+
+    // 4. TNC 640 with -07 writes FUNCTION DWELL TIME with space
+    let mut tnc640_new = itnc_mch.clone();
+    tnc640_new["controller"] = json!({
+        "identity": { "model": "TNC 640", "nc_software": "340590-07" }
+    });
+    let out = engine::run(&cps, &tnc640_new, &stream).expect("posts with tnc 640 -07");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(out.program.contains("FUNCTION DWELL TIME 0.5*"), "TNC 640 -07 writes FUNCTION DWELL TIME with space: {}", out.program);
+    assert!(!out.program.contains("G04 F"));
+
+    // 5. Default/generic machine without controller identity writes FUNCTION DWELL TIME with space
+    let base_mch: serde_json::Value =
+        serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("vmc");
+    let out = engine::run(&cps, &base_mch, &stream).expect("posts with base machine");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(out.program.contains("FUNCTION DWELL TIME 0.5*"), "Default machine writes FUNCTION DWELL TIME with space: {}", out.program);
+}
diff --git a/crates/post/tests/heidenhain_cycles.rs b/crates/post/tests/heidenhain_cycles.rs
index 2dab09e1d..e1b96f9d8 100644
--- a/crates/post/tests/heidenhain_cycles.rs
+++ b/crates/post/tests/heidenhain_cycles.rs
@@ -370,7 +370,7 @@ fn nonzero_entry_peck_and_deep_and_backbore_keep_the_expanded_chain() {
     let cuts: Vec<_> = bs.iter().filter(|b| b.starts_with("G01 ")).collect();
     assert_eq!(cuts.len(), 6, "both nonzero-R peck chains and the backbore chain stay explicit: {cuts:?}");
     assert!(cuts.iter().any(|b| b.contains("Z-3 F100")) && cuts.iter().any(|b| b.contains("Z-8 F100")), "the from-R infeed chain is preserved: {cuts:?}");
-    assert_eq!(bs.iter().filter(|b| b.starts_with("FUNCTION DWELL TIME")).count(), 1);
+    assert_eq!(bs.iter().filter(|b| b.starts_with("FUNCTION DWELL TIME ")).count(), 1);
 }
 
 #[test]
