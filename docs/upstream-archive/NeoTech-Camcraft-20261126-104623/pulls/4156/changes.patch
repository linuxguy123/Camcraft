From 5cf0aa9533ae7374a36482f6fdf965474354403a Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 26 Nov 2026 00:40:12 -0800
Subject: [PATCH] test(app): state the Bore entry in the hole-order test

The hole-order test (#3328, merge a796aa1c9) builds an OpParams::Bore
without the `entry` field that the Bore entry feature (#3828, merge
c04c762b8) added. Each PR was green alone; together the app test build
fails ("missing field `entry`"), so the post-merge gate is red on main.

The test now states `Entry3D::Plunge`, the entry that the other Bore
tests use. No production code changes.

Fixes #4155

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/tests/start_exit_shared/hole_order.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/crates/app/tests/start_exit_shared/hole_order.rs b/crates/app/tests/start_exit_shared/hole_order.rs
index 46a828dd7..2c7adf688 100644
--- a/crates/app/tests/start_exit_shared/hole_order.rs
+++ b/crates/app/tests/start_exit_shared/hole_order.rs
@@ -72,6 +72,7 @@ fn drill(picks: PathPicks) -> OpParams {
 
 fn bore(picks: PathPicks) -> OpParams {
     OpParams::Bore {
+        entry: camcraft_app::machining3d::Entry3D::Plunge,
         pass_start: PassStart::Auto,
         break_through: None,
         links: camcraft_app::links::Links::PLANAR,
