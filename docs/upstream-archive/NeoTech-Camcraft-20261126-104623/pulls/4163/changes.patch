From 2493d1a6f7daa122b56c1696a9cdb2fe9eb46e1b Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Thu, 26 Nov 2026 04:31:51 -0500
Subject: [PATCH] fix(post): post G85 for zero dwell back-bore in Mach4 post

---
 assets/posts/mach4.cps          |  4 +++-
 crates/post/tests/mach4_post.rs | 25 +++++++++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/assets/posts/mach4.cps b/assets/posts/mach4.cps
index 26a6d82c2..c180dfa11 100644
--- a/assets/posts/mach4.cps
+++ b/assets/posts/mach4.cps
@@ -809,7 +809,9 @@ function onCycle() {
     }
     g = "G84";
   } else if (p.CycleType === "BORE") g = "G86";
-  else if (p.CycleType === "BACKBORE") g = "G89";
+  // #4142: a back-bore with no dwell is G85 (feed in, feed out): a G89
+  // with no P word would leave the dwell to the control's modal P.
+  else if (p.CycleType === "BACKBORE") g = secDwell > 0 ? "G89" : "G85";
   else if (p.CycleType === "REAM") g = "G85";
   else { msg(who() + "canned cycle " + p.CycleType + " is not supported by Mach4 post"); return; }
 
diff --git a/crates/post/tests/mach4_post.rs b/crates/post/tests/mach4_post.rs
index af9ffe73d..a658dee0c 100644
--- a/crates/post/tests/mach4_post.rs
+++ b/crates/post/tests/mach4_post.rs
@@ -281,3 +281,28 @@ fn mach4_supported_cycle_dwells_use_seconds_on_g82_and_g89_only() {
         );
     }
 }
+
+#[test]
+fn mach4_zero_dwell_backbore_posts_g85() {
+    let cps = mach4_post();
+    let mch = default_vmc();
+    let out = engine::run(&cps, &mch, &cycle_stream("BACKBORE", 0)).expect("zero dwell backbore");
+    assert!(out.warnings.is_empty(), "warnings: {:?}", out.warnings);
+    let line = out
+        .program
+        .lines()
+        .find(|line| line.split_whitespace().any(|w| w == "G85"))
+        .unwrap_or_else(|| panic!("missing G85 for zero-dwell BACKBORE:\n{}", out.program));
+    assert!(
+        !line.split_whitespace().any(|w| w.starts_with('P')),
+        "G85 must not write P: {line}"
+    );
+    assert!(
+        !out.program
+            .lines()
+            .any(|line| line.split_whitespace().any(|w| w == "G89")),
+        "G89 must not be emitted for zero-dwell BACKBORE:\n{}",
+        out.program
+    );
+}
+
