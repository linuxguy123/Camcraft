From 39ffe9606ac51f1c5936df102d36de942070653a Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Thu, 26 Nov 2026 05:31:27 -0500
Subject: [PATCH] fix(post): avoid G64 P0 on small blend tolerance in LinuxCNC
 and Tormach posts

---
 assets/posts/linuxcnc.cps         | 12 ++++++++++--
 assets/posts/tormach.cps          |  9 ++++++++-
 crates/app/tests/linuxcnc_post.rs | 18 ++++++++++++++++++
 crates/app/tests/smoothing.rs     | 13 +++++++++++++
 4 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/assets/posts/linuxcnc.cps b/assets/posts/linuxcnc.cps
index e1fec38bc6..3c9054a9d9 100644
--- a/assets/posts/linuxcnc.cps
+++ b/assets/posts/linuxcnc.cps
@@ -391,9 +391,17 @@ function toolNote() {  // just before the tool change it describes
 // feed per minute, compensation, tool length and cycle cancelled. Path
 // control on its own line: G64 with a stated P (a bare G64 is "best
 // possible speed, no tolerance"), or G61 exact path.
+// #4147: LinuxCNC reads G64 P0 as G64 with no deviation limit.
+// Clamp positive tolerances that round to zero under fu() to the smallest
+// positive value (0.001 mm, 0.0001 in). Never write P0.
+function tolP(tol) {
+  var s = fu(tol);
+  return (s === "0" || s === "-0") ? (inch ? "P0.0001" : "P0.001") : "P" + s;
+}
+
 function pathWords() {
   if (optStr("pathControl", "blend") === "exact") return ["G61"];
-  return ["G64", "P" + fu(optNum("blendTolerance", 0.025))];
+  return ["G64", tolP(optNum("blendTolerance", 0.025))];
 }
 // The machine's inverted linear axes (#375): the engine has mirrored the
 // stream into the controller's frame, and the header says so, one note
@@ -537,7 +545,7 @@ function onToolChange(number, name) {
 // tolerance leaks into the next operation.
 function smoothOn() {
   if (!(smoothTol > 0)) return;
-  block(["G64", "P" + fu(smoothTol)]);
+  block(["G64", tolP(smoothTol)]);
   smoothActive = true;
 }
 function smoothOff() {
diff --git a/assets/posts/tormach.cps b/assets/posts/tormach.cps
index ca5d1287c9..2e51a39755 100644
--- a/assets/posts/tormach.cps
+++ b/assets/posts/tormach.cps
@@ -557,9 +557,16 @@ function beltNote(rpm) {
 // The header's path-blending tolerance (#616: shared by the header and
 // the per-section reset, one constant).
 function blendP() { return inch ? "P0.001" : "P0.025"; }
+// #4147: PathPilot / LinuxCNC reads G64 P0 as G64 with no deviation limit.
+// Clamp positive tolerances that round to zero under fu() to the smallest
+// positive value (0.001 mm, 0.0001 in). Never write P0.
+function tolP(tol) {
+  var s = fu(tol);
+  return (s === "0" || s === "-0") ? (inch ? "P0.0001" : "P0.001") : "P" + s;
+}
 function smoothOn() {
   if (!(smoothTol > 0)) return;
-  block(["G64", "P" + fu(smoothTol)]);
+  block(["G64", tolP(smoothTol)]);
   smoothActive = true;
 }
 function smoothOff() {
diff --git a/crates/app/tests/linuxcnc_post.rs b/crates/app/tests/linuxcnc_post.rs
index 46e75eade9..9c960895af 100644
--- a/crates/app/tests/linuxcnc_post.rs
+++ b/crates/app/tests/linuxcnc_post.rs
@@ -211,3 +211,21 @@ fn tilted_moves_and_control_comp_are_refused_by_name() {
     let (_, warnings) = run(&m, comp, &Value::Null);
     assert!(warnings.iter().any(|w| w.contains("G41/G42")), "{warnings:?}");
 }
+
+#[test]
+fn blend_tolerance_never_writes_g64_p0() {
+    // #4147: LinuxCNC reads G64 P0 as G64 with no deviation limit.
+    // When a tolerance rounds to zero under fu() resolution (0.001 mm or 0.0001 in),
+    // the post must clamp to the smallest positive value and never write P0.
+    let m = stated(Some(0.0), false);
+
+    // Header blend tolerance: 0.001 mm in inch is ~0.000039 in, which rounds to 0.0000 in.
+    let nc_inch = post(&m, STREAM, &json!({ "Units": "inch", "blendTolerance": 0.001 }));
+    assert!(nc_inch.contains("\nG64 P0.0001\n"), "inch header clamped: {nc_inch}");
+    assert!(!nc_inch.contains("P0\n") && !nc_inch.contains("P0.0000\n"), "never P0: {nc_inch}");
+
+    // Header blend tolerance: smallest metric value 0.001 mm writes P0.001.
+    let nc_mm = post(&m, STREAM, &json!({ "blendTolerance": 0.001 }));
+    assert!(nc_mm.contains("\nG64 P0.001\n"), "mm header clamped: {nc_mm}");
+    assert!(!nc_mm.contains("P0\n"), "never P0: {nc_mm}");
+}
diff --git a/crates/app/tests/smoothing.rs b/crates/app/tests/smoothing.rs
index 6d51368da0..69d8c00b4b 100644
--- a/crates/app/tests/smoothing.rs
+++ b/crates/app/tests/smoothing.rs
@@ -235,3 +235,16 @@ fn the_switch_undoes_redoes_and_round_trips_the_project_file() {
     assert!(!off.contains("smoothing"), "off writes no key");
     let _ = std::fs::remove_file(&path);
 }
+
+#[test]
+fn linuxcnc_and_tormach_smoothing_tolerance_never_writes_g64_p0() {
+    // #4147: PathPilot / LinuxCNC reads G64 P0 as G64 with no deviation limit.
+    // When a smoothing tolerance is under the written format resolution,
+    // the post must clamp to the smallest positive value and never write P0.
+    let small_smooth = Some(Smoothing { tol_mm: 0.0001, finish: true });
+    for post in ["Tormach PathPilot", "LinuxCNC"] {
+        let prog = program(post, small_smooth);
+        assert!(prog.contains("\nG64 P0.001\n"), "{post} clamped to smallest positive mm: {prog}");
+        assert!(!prog.contains("G64 P0\n") && !prog.contains("G64 P0.000\n"), "{post} never P0: {prog}");
+    }
+}
