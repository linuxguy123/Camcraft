diff --git a/crates/motion/tests/common/law_measure/engage.rs b/crates/motion/tests/common/law_measure/engage.rs
new file mode 100644
index 0000000000..d30738e2c7
--- /dev/null
+++ b/crates/motion/tests/common/law_measure/engage.rs
@@ -0,0 +1,95 @@
+//! One walk of a toolpath over the stock grid: the entries (L5) and the
+//! engagement of each planar feed against the stock that is left (L6).
+//! Provenance: the radial engagement angle (the contact angle of the
+//! cutter rim with the uncut stock, Altintas, "Manufacturing Automation",
+//! 2000, ch. 2), read on a pixel stock model as in Choy and Chan
+//! (Computer-Aided Design 35, 2003), with the rim meter of
+//! `common/mask_grid.rs` (`contact_width`); our own design record (#4024).
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::geo2d::Point2;
+
+use super::entries::{Entry, Open, descends};
+use super::stock::{Stock, Z_EPS, points};
+use super::{Reading, Spec};
+
+/// One rim sample of the meter (72 samples over 180 degrees).
+const RIM_STEP_DEG: f64 = 2.5;
+/// A full-width cut reads all the samples of the forward half.
+const FULL_DEG: f64 = 180.0 - 0.5 * RIM_STEP_DEG;
+
+pub(super) struct Walk {
+    pub entries: Vec<Entry>,
+    pub over: Reading,
+    pub worst_deg: f64,
+    pub full_width: Reading,
+}
+
+/// The engagement angle in degrees from the radial depth that the rim
+/// meter gives (`ae = r (1 - cos theta)`).
+fn angle(ae: f64, r: f64) -> f64 {
+    (1.0 - ae / r).clamp(-1.0, 1.0).acos().to_degrees()
+}
+
+pub(super) fn walk(path: &Toolpath, spec: &Spec, stock: &mut Stock) -> Walk {
+    let mut out = Walk {
+        entries: Vec::new(),
+        over: Reading::default(),
+        worst_deg: 0.0,
+        full_width: Reading::default(),
+    };
+    let step = stock.grid.cell;
+    let mut open: Option<Open> = None;
+    for (i, m) in path.moves.iter().enumerate() {
+        if descends(m, spec.top) {
+            open = Some(Open::read(open.take(), i, m, stock));
+        } else if let Some(o) = open.take() {
+            out.entries.push(o.close(stock));
+        }
+        if m.from.z.min(m.to.z) >= spec.top {
+            continue;
+        }
+        let cuts = m.kind != MoveKind::Rapid
+            && (m.from.z - m.to.z).abs() < 1e-9
+            && m.to.z < spec.top - Z_EPS;
+        if !cuts && m.arc.is_none() {
+            stock.sweep(m.from, m.to);
+            continue;
+        }
+        let pts = points(m, step);
+        let mut worst: Option<(f64, Point2)> = None;
+        for w in pts.windows(2) {
+            let [a, b] = [w[0], w[1]];
+            stock.sweep(a, b);
+            if !cuts {
+                continue;
+            }
+            let at = Point2::new(b.x, b.y);
+            let ae = stock.grid.contact_width(
+                at,
+                (b.x - a.x, b.y - a.y),
+                b.z,
+                stock.r,
+                &stock.cuttable,
+                &stock.top,
+            );
+            let deg = angle(ae, stock.r);
+            if worst.is_none_or(|(d, _)| deg > d) {
+                worst = Some((deg, at));
+            }
+        }
+        if let Some((deg, at)) = worst {
+            out.worst_deg = out.worst_deg.max(deg);
+            if deg > spec.limit_deg + RIM_STEP_DEG {
+                out.over.add(at);
+            }
+            if deg >= FULL_DEG {
+                out.full_width.add(at);
+            }
+        }
+    }
+    if let Some(o) = open.take() {
+        out.entries.push(o.close(stock));
+    }
+    out
+}
diff --git a/crates/motion/tests/common/law_measure/entries.rs b/crates/motion/tests/common/law_measure/entries.rs
new file mode 100644
index 0000000000..d196e0c6a4
--- /dev/null
+++ b/crates/motion/tests/common/law_measure/entries.rs
@@ -0,0 +1,119 @@
+//! The entries of a toolpath into the stock, and where each one starts
+//! (law L5 of #4023).
+//! Provenance: our own design record (#4024, L5 "read the posted CL on an
+//! independent stock grid; classify the XY as air, a pre-drilled hole, a
+//! cleared column, or material"), on the grid of `stock.rs`.
+
+use camcraft_motion::cl::{Move, MoveKind};
+use camcraft_motion::geo2d::Point2;
+
+use super::stock::{Stock, points};
+
+/// How the tool goes down.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EntryKind {
+    /// A straight vertical feed.
+    Plunge,
+    /// A straight feed with an XY travel.
+    Ramp,
+    /// An arc in XY with a Z travel.
+    Helix,
+    /// A rapid move.
+    Rapid,
+}
+
+/// Where an entry starts, read on the stock that is left at that time.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EntryStart {
+    /// No stock under the tool at the start.
+    Air,
+    /// A pre-drilled hole under the tool.
+    Hole,
+    /// Stock that earlier moves cleared to below the entry depth.
+    Column,
+    /// The tool goes down into material.
+    Solid,
+}
+
+/// One descent below the stock top.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Entry {
+    /// The index of the first move of the descent.
+    pub at_move: usize,
+    pub kind: EntryKind,
+    pub start: EntryStart,
+    /// The XY where the descent ends (or first meets material).
+    pub place: Point2,
+}
+
+pub(super) fn kind_of(m: &Move) -> EntryKind {
+    if m.kind == MoveKind::Rapid {
+        EntryKind::Rapid
+    } else if m.arc.is_some() {
+        EntryKind::Helix
+    } else if (m.to.x - m.from.x).hypot(m.to.y - m.from.y) > 1e-6 {
+        EntryKind::Ramp
+    } else {
+        EntryKind::Plunge
+    }
+}
+
+/// True if `m` goes down and ends below the stock top.
+pub(super) fn descends(m: &Move, top: f64) -> bool {
+    m.to.z < m.from.z - 1e-9 && m.to.z < top - super::stock::Z_EPS
+}
+
+/// The open entry of a walk: one run of descending moves.
+pub(super) struct Open {
+    pub entry: Entry,
+}
+
+impl Open {
+    /// Read one descending move before the stock is cut by it. Material
+    /// under any of its points makes the entry an entry into solid.
+    pub fn read(open: Option<Open>, i: usize, m: &Move, stock: &Stock) -> Open {
+        let mut open = open.unwrap_or(Open {
+            entry: Entry {
+                at_move: i,
+                kind: kind_of(m),
+                start: EntryStart::Air,
+                place: Point2::new(m.to.x, m.to.y),
+            },
+        });
+        if open.entry.start == EntryStart::Solid {
+            return open;
+        }
+        let hit = points(m, stock.grid.cell)
+            .into_iter()
+            .skip(1)
+            .find(|p| stock.material(Point2::new(p.x, p.y), p.z));
+        match hit {
+            Some(p) => {
+                open.entry.kind = kind_of(m);
+                open.entry.start = EntryStart::Solid;
+                open.entry.place = Point2::new(p.x, p.y);
+            }
+            None => {
+                open.entry.kind = kind_of(m);
+                open.entry.place = Point2::new(m.to.x, m.to.y);
+            }
+        }
+        open
+    }
+
+    /// Close the entry: a descent that met no material starts in a hole,
+    /// in a cleared column or in air.
+    pub fn close(mut self, stock: &Stock) -> Entry {
+        if self.entry.start != EntryStart::Solid {
+            let p = self.entry.place;
+            self.entry.start = if stock.in_hole(p) {
+                EntryStart::Hole
+            } else if stock.was_stock(p) {
+                EntryStart::Column
+            } else {
+                EntryStart::Air
+            };
+        }
+        self.entry
+    }
+}
diff --git a/crates/motion/tests/common/law_measure/feeds.rs b/crates/motion/tests/common/law_measure/feeds.rs
new file mode 100644
index 0000000000..754362387b
--- /dev/null
+++ b/crates/motion/tests/common/law_measure/feeds.rs
@@ -0,0 +1,53 @@
+//! Planar feeds that cross another planar feed, or leave the reach of the
+//! tool centre (the link rule of #4023).
+//! Provenance: our own design record (#4024, "Link rule"); the crossing is
+//! the verifier's own law (`verify::crossed_pairs`), as the one-level
+//! reader `assert_no_crossing` of `pass_start_levels/ring_links.rs` uses it.
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::geo2d::{Point2, Region};
+
+use super::Reading;
+use super::stock::points;
+
+const Z_TOL: f64 = 1e-9;
+/// The chord tolerance of the verifier's crossing law in the old tests.
+const CHORD_TOL: f64 = 0.01;
+/// How far a centre may stand outside the reach before it counts.
+const REACH_TOL: f64 = 0.01;
+
+fn planar(path: &Toolpath, i: usize) -> bool {
+    path.moves
+        .get(i)
+        .is_some_and(|m| m.kind != MoveKind::Rapid && (m.from.z - m.to.z).abs() < Z_TOL)
+}
+
+/// Each pair of planar feeds that cross; the place is the end of the first.
+pub(super) fn crossings(path: &Toolpath) -> Reading {
+    let mut out = Reading::default();
+    for pr in camcraft_motion::verify::crossed_pairs(path, CHORD_TOL) {
+        if !(planar(path, pr[0]) && planar(path, pr[1])) {
+            continue;
+        }
+        if let Some(m) = path.moves.get(pr[0]) {
+            out.add(Point2::new(m.to.x, m.to.y));
+        }
+    }
+    out
+}
+
+/// Each planar feed whose centre goes outside `reach` (grown by a small
+/// tolerance); the place is the first point outside.
+pub(super) fn leaves(path: &Toolpath, reach: &Region, step: f64) -> Result<Reading, String> {
+    let grown = reach.offset(REACH_TOL).map_err(|e| format!("reach: {e:?}"))?;
+    let mut out = Reading::default();
+    for (i, m) in path.moves.iter().enumerate() {
+        if !planar(path, i) {
+            continue;
+        }
+        if let Some(p) = points(m, step).into_iter().find(|p| !grown.contains(Point2::new(p.x, p.y))) {
+            out.add(Point2::new(p.x, p.y));
+        }
+    }
+    Ok(out)
+}
diff --git a/crates/motion/tests/common/law_measure/lifts.rs b/crates/motion/tests/common/law_measure/lifts.rs
new file mode 100644
index 0000000000..bba5137e28
--- /dev/null
+++ b/crates/motion/tests/common/law_measure/lifts.rs
@@ -0,0 +1,63 @@
+//! The lifts and re-entries of each cut level (the link rule of #4023).
+//! Provenance: our own design record (#4024, "Link rule"); the same count
+//! as the one-level reader of `pass_start_levels/ring_links.rs`, made for
+//! each level of a path.
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::geo2d::Point2;
+
+use super::Reading;
+
+const Z_TOL: f64 = 1e-6;
+
+/// The cut levels: the Z values of planar feeds below the stock top.
+fn levels(path: &Toolpath, top: f64) -> Vec<f64> {
+    let mut out: Vec<f64> = Vec::new();
+    for m in &path.moves {
+        let planar = (m.from.z - m.to.z).abs() <= Z_TOL;
+        if m.kind == MoveKind::Rapid || !planar || !m.to.z.is_finite() || m.to.z >= top - Z_TOL {
+            continue;
+        }
+        if !out.iter().any(|z| (z - m.to.z).abs() <= Z_TOL) {
+            out.push(m.to.z);
+        }
+    }
+    out
+}
+
+/// The lifts of every level (a Z-up move that leaves the level between
+/// its first and its last cut) and the re-entries (each run of cuts on
+/// the level after the first one).
+pub(super) fn level_lifts(path: &Toolpath, top: f64) -> (Reading, usize) {
+    let mut lifts = Reading::default();
+    let mut re_entries = 0usize;
+    for z in levels(path, top) {
+        let on = |i: usize| {
+            path.moves.get(i).is_some_and(|m| {
+                m.kind != MoveKind::Rapid
+                    && (m.from.z - z).abs() <= Z_TOL
+                    && (m.to.z - z).abs() <= Z_TOL
+            })
+        };
+        let floor: Vec<usize> = (0..path.moves.len()).filter(|&i| on(i)).collect();
+        let (Some(&first), Some(&last)) = (floor.first(), floor.last()) else {
+            continue;
+        };
+        let mut runs = 0usize;
+        let mut was = false;
+        for i in first..=last {
+            let now = on(i);
+            if now && !was {
+                runs = runs.saturating_add(1);
+            }
+            was = now;
+        }
+        re_entries = re_entries.saturating_add(runs.saturating_sub(1));
+        for m in path.moves.get(first..last).unwrap_or(&[]) {
+            if m.to.z > z + Z_TOL && (m.from.z - z).abs() <= Z_TOL {
+                lifts.add(Point2::new(m.from.x, m.from.y));
+            }
+        }
+    }
+    (lifts, re_entries)
+}
diff --git a/crates/motion/tests/common/law_measure/mod.rs b/crates/motion/tests/common/law_measure/mod.rs
new file mode 100644
index 0000000000..3851fd22c6
--- /dev/null
+++ b/crates/motion/tests/common/law_measure/mod.rs
@@ -0,0 +1,220 @@
+//! Law measures on a finished toolpath (#4154, K7a of the path kernel, #4027).
+//! Provenance: the "laws as checks" table of our own design record (#4024);
+//! the radial engagement is the contact angle of the cutter rim with the
+//! stock (Altintas, "Manufacturing Automation", 2000, ch. 2), read on a pixel
+//! stock model as in the pixel-based engagement methods (Choy and Chan,
+//! Computer-Aided Design 35, 2003). No vendor material consulted.
+//!
+//! Each reading is a count with the list of its places. The measures read
+//! only the toolpath, the stock, the part and the reach of the tool centre:
+//! they run the same on an old planner and on the new kernel.
+
+mod engage;
+mod entries;
+mod feeds;
+mod lifts;
+mod notes;
+mod stock;
+
+use camcraft_motion::cl::Toolpath;
+use camcraft_motion::geo2d::{Point2, Region};
+
+pub use entries::{Entry, EntryKind, EntryStart};
+pub use notes::is_fallback;
+
+/// What the measures need beside the toolpath.
+#[derive(Clone)]
+pub struct Spec {
+    /// The radius of the tool (a flat disc).
+    pub tool_r: f64,
+    /// The stock outline in XY, as material from `bottom` up to `top`.
+    pub stock: Region,
+    /// The top of the stock.
+    pub top: f64,
+    /// The part in XY (never to cut), if any.
+    pub part: Option<Region>,
+    /// Pre-drilled holes (no material), if any.
+    pub holes: Option<Region>,
+    /// The area that the tool centre may use on a planar feed, if known.
+    pub reach: Option<Region>,
+    /// The planned engagement limit in degrees.
+    pub limit_deg: f64,
+    /// The entry kind that the operation asks for, if it has a choice.
+    pub asked_entry: Option<EntryKind>,
+    /// The size of a stock grid cell.
+    pub cell: f64,
+}
+
+impl Spec {
+    /// A spec with the usual cell (a quarter of a millimetre).
+    pub fn new(tool_r: f64, stock: Region, top: f64, limit_deg: f64) -> Self {
+        Spec {
+            tool_r,
+            stock,
+            top,
+            part: None,
+            holes: None,
+            reach: None,
+            limit_deg,
+            asked_entry: None,
+            cell: 0.25,
+        }
+    }
+}
+
+/// One reading: a count and the places where it occurs.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Reading {
+    pub count: usize,
+    pub places: Vec<Point2>,
+}
+
+impl Reading {
+    pub(crate) fn add(&mut self, at: Point2) {
+        self.count = self.count.saturating_add(1);
+        self.places.push(at);
+    }
+}
+
+/// All the readings of one toolpath.
+#[derive(Clone, Debug, Default)]
+pub struct Readings {
+    /// Z-up moves that leave a level while a cut of that level is to come.
+    pub lifts: Reading,
+    /// The lifts that the link notes name (the sum of their counts).
+    pub named_lifts: usize,
+    /// Returns to a level after its first cut run.
+    pub re_entries: usize,
+    /// Pairs of planar feeds that cross (the verifier's Crossing law).
+    pub crossings: Reading,
+    /// Planar feeds whose centre leaves the reach.
+    pub leaves: Reading,
+    /// Each descent below the stock top.
+    pub entries: Vec<Entry>,
+    /// Feed moves with an engagement above the limit.
+    pub over: Reading,
+    /// The worst engagement on a planar feed, in degrees.
+    pub worst_deg: f64,
+    /// Feed moves with a full-width cut (180 degrees).
+    pub full_width: Reading,
+    /// The notes that say that a different plan was used.
+    pub fallbacks: Vec<String>,
+    /// The entry kind that the operation asked for (from the spec).
+    pub asked_entry: Option<EntryKind>,
+}
+
+/// Measure `path` against `spec`.
+pub fn measure(path: &Toolpath, spec: &Spec) -> Result<Readings, String> {
+    if !(spec.tool_r.is_finite() && spec.tool_r > 0.0) {
+        return Err(format!("tool radius must be positive, got {}", spec.tool_r));
+    }
+    if !spec.top.is_finite() || !spec.limit_deg.is_finite() {
+        return Err("stock top and limit must be finite".into());
+    }
+    let mut out = Readings::default();
+    let (lifts, re_entries) = lifts::level_lifts(path, spec.top);
+    out.lifts = lifts;
+    out.re_entries = re_entries;
+    out.named_lifts = notes::named_lifts(path);
+    out.crossings = feeds::crossings(path);
+    if let Some(reach) = &spec.reach {
+        out.leaves = feeds::leaves(path, reach, spec.cell)?;
+    }
+    let mut grid = stock::Stock::new(spec)?;
+    let walk = engage::walk(path, spec, &mut grid);
+    out.entries = walk.entries;
+    out.over = walk.over;
+    out.worst_deg = walk.worst_deg;
+    out.full_width = walk.full_width;
+    out.asked_entry = spec.asked_entry;
+    out.fallbacks = path.notes.iter().filter(|n| is_fallback(n)).cloned().collect();
+    Ok(out)
+}
+
+impl Readings {
+    /// The count of entries that start at `at`.
+    pub fn entries_at(&self, at: EntryStart) -> usize {
+        self.entries.iter().filter(|e| e.start == at).count()
+    }
+
+    /// The count of entries into solid material with the kind `kind`.
+    pub fn solid(&self, kind: EntryKind) -> usize {
+        self.entries
+            .iter()
+            .filter(|e| e.start == EntryStart::Solid && e.kind == kind)
+            .count()
+    }
+
+    /// The lifts that no note names.
+    pub fn unnamed_lifts(&self) -> usize {
+        self.lifts.count.saturating_sub(self.named_lifts)
+    }
+
+    /// One line that a test pins: each count in a fixed order.
+    pub fn row(&self) -> String {
+        format!(
+            "lifts {} named {} re {} | cross {} leave {} | entry air {} hole {} col {} solid {} \
+             (plunge {} ramp {} helix {} rapid {}) | over {} worst {:.0} full {} | fallback {}",
+            self.lifts.count,
+            self.named_lifts,
+            self.re_entries,
+            self.crossings.count,
+            self.leaves.count,
+            self.entries_at(EntryStart::Air),
+            self.entries_at(EntryStart::Hole),
+            self.entries_at(EntryStart::Column),
+            self.entries_at(EntryStart::Solid),
+            self.solid(EntryKind::Plunge),
+            self.solid(EntryKind::Ramp),
+            self.solid(EntryKind::Helix),
+            self.solid(EntryKind::Rapid),
+            self.over.count,
+            self.worst_deg,
+            self.full_width.count,
+            self.fallbacks.len(),
+        )
+    }
+
+    /// The entries into solid material of another kind than the one that
+    /// the operation asked for.
+    pub fn substituted(&self) -> usize {
+        let Some(asked) = self.asked_entry else {
+            return 0;
+        };
+        self.entries
+            .iter()
+            .filter(|e| e.start == EntryStart::Solid && e.kind != asked)
+            .count()
+    }
+
+    /// The laws that these readings break, by the checks of the design
+    /// record (#4024):
+    /// - link: a lift with no named reason, a crossing, or a feed out of
+    ///   the reach;
+    /// - L4: an entry of another kind than the one asked, with no note;
+    /// - L5: a straight plunge or a rapid into solid material;
+    /// - L6: a cut above the limit, or a full-width cut outside a named
+    ///   slot. `slot` says that the kind is a named slot, where a
+    ///   full-width cut is the plan.
+    pub fn breaks(&self, slot: bool) -> String {
+        let mut out = Vec::new();
+        if self.unnamed_lifts() > 0 || self.crossings.count > 0 || self.leaves.count > 0 {
+            out.push("link");
+        }
+        if self.substituted() > 0 && self.fallbacks.is_empty() {
+            out.push("L4");
+        }
+        if self.solid(EntryKind::Plunge) > 0 || self.solid(EntryKind::Rapid) > 0 {
+            out.push("L5");
+        }
+        let planned_full = if slot { self.full_width.count } else { 0 };
+        if self.over.count > planned_full || (!slot && self.full_width.count > 0) {
+            out.push("L6");
+        }
+        if out.is_empty() {
+            "-".into()
+        } else {
+            out.join(" ")
+        }
+    }
+}
diff --git a/crates/motion/tests/common/law_measure/notes.rs b/crates/motion/tests/common/law_measure/notes.rs
new file mode 100644
index 0000000000..8cbef5280f
--- /dev/null
+++ b/crates/motion/tests/common/law_measure/notes.rs
@@ -0,0 +1,44 @@
+//! The notes of a toolpath that the laws read: the named lifts of the link
+//! stage and the fallbacks (law L4 of #4023).
+//! Provenance: our own design record (#4024, L4 and "Link rule"); the note
+//! texts are the ones that `links.rs` and the entry and pass-start stages
+//! of `camcraft-motion` write. The lift count is the same parse as
+//! `named_lifts` of `pass_start_levels/ring_links.rs`.
+
+use camcraft_motion::cl::Toolpath;
+use camcraft_motion::machining2d::{is_entry_stand_in, rings_fallbacks};
+
+/// The lifts that the link notes name ("link: ... lifted ... N time(s)").
+pub(super) fn named_lifts(path: &Toolpath) -> usize {
+    path.notes
+        .iter()
+        .filter(|n| n.starts_with("link: "))
+        .filter_map(|n| {
+            n.split(" time(s)")
+                .next()?
+                .rsplit(' ')
+                .next()?
+                .parse::<usize>()
+                .ok()
+        })
+        .fold(0usize, usize::saturating_add)
+}
+
+/// The words with which a note that has no classifier of its own says
+/// that the planner used a different plan than the one asked.
+const FALLBACK_WORDS: &[&str] = &[" instead", "fell back", "falls back", "fallback", "stand-in"];
+
+/// True if `note` says that a different plan was used: the planner's own
+/// classifiers (a stand-in entry, the Offset rings in place of the
+/// Adaptive plan) first, then the words above. A lift note is not a
+/// fallback: it is a link with a reason.
+pub fn is_fallback(note: &str) -> bool {
+    if note.starts_with("link: ") {
+        return false;
+    }
+    if is_entry_stand_in(note) || rings_fallbacks(&[note.to_string()]) > 0 {
+        return true;
+    }
+    let low = note.to_ascii_lowercase();
+    FALLBACK_WORDS.iter().any(|w| low.contains(w))
+}
diff --git a/crates/motion/tests/common/law_measure/stock.rs b/crates/motion/tests/common/law_measure/stock.rs
new file mode 100644
index 0000000000..007ceadfae
--- /dev/null
+++ b/crates/motion/tests/common/law_measure/stock.rs
@@ -0,0 +1,171 @@
+//! The independent stock grid of the law measures: a column height for
+//! each cell, cut down by the swept disc of the tool (#4154).
+//! Provenance: a Z-buffer (dexel) stock model, as in the stock simulation
+//! literature (Van Hook, "Real-time shaded NC milling display", SIGGRAPH
+//! 1986), on the shape-mask grid of `common/mask_grid.rs`.
+
+use camcraft_motion::cl::{ArcPlane, Move};
+use camcraft_motion::geo2d::Point2;
+use camcraft_motion::geometry::Point3;
+
+use super::super::mask_grid::Grid;
+use super::Spec;
+
+/// A material column stands above the tool by more than this.
+pub(super) const Z_EPS: f64 = 1e-3;
+/// The most sample points of one move.
+const MAX_STEPS: f64 = 200_000.0;
+
+pub(super) struct Stock {
+    pub grid: Grid,
+    /// The column top of each cell (`NEG_INFINITY`: no material).
+    pub top: Vec<f64>,
+    /// The cells of the stock that the tool may cut (stock less part).
+    pub cuttable: Vec<bool>,
+    /// The cells of the stock at the start.
+    pub stock0: Vec<bool>,
+    /// The cells of a pre-drilled hole.
+    pub hole: Vec<bool>,
+    pub r: f64,
+}
+
+impl Stock {
+    pub fn new(spec: &Spec) -> Result<Self, String> {
+        let pad = 2.0 * spec.tool_r + 1.0;
+        let grid = Grid::for_region(&spec.stock, spec.cell, pad)?;
+        let stock0 = grid.rasterize_region(&spec.stock);
+        let part = spec
+            .part
+            .as_ref()
+            .map_or_else(|| vec![false; grid.len()], |p| grid.rasterize_region(p));
+        let hole = spec
+            .holes
+            .as_ref()
+            .map_or_else(|| vec![false; grid.len()], |h| grid.rasterize_region(h));
+        let mut top = vec![f64::NEG_INFINITY; grid.len()];
+        let mut cuttable = vec![false; grid.len()];
+        for i in 0..grid.len() {
+            let solid = (stock0[i] && !hole[i]) || part[i];
+            if solid {
+                top[i] = spec.top;
+            }
+            cuttable[i] = stock0[i] && !hole[i] && !part[i];
+        }
+        Ok(Stock {
+            grid,
+            top,
+            cuttable,
+            stock0,
+            hole,
+            r: spec.tool_r,
+        })
+    }
+
+    /// Call `f` with each cell whose centre is within `rr` of `p`.
+    pub fn for_disc(&self, p: Point2, rr: f64, mut f: impl FnMut(usize)) {
+        let g = &self.grid;
+        if !(p.x.is_finite() && p.y.is_finite() && rr.is_finite() && rr > 0.0) {
+            return;
+        }
+        let span = |c: f64, o: f64, n: usize| -> (usize, usize) {
+            let lo = ((c - rr - o) / g.cell - 0.5).floor().clamp(0.0, n as f64);
+            let hi = ((c + rr - o) / g.cell - 0.5).ceil().clamp(0.0, n as f64);
+            (lo as usize, (hi as usize).min(n.saturating_sub(1)))
+        };
+        let (ix0, ix1) = span(p.x, g.x0, g.w);
+        let (iy0, iy1) = span(p.y, g.y0, g.h);
+        let r2 = rr * rr + 1e-12;
+        for iy in iy0..=iy1 {
+            for ix in ix0..=ix1 {
+                let c = g.center(ix, iy);
+                if (c.x - p.x).powi(2) + (c.y - p.y).powi(2) <= r2 {
+                    f(g.idx(ix, iy));
+                }
+            }
+        }
+    }
+
+    /// The inner disc of the tool: its radius less half a cell, so that a
+    /// tool that only touches a wall does not read the wall.
+    fn inner(&self) -> f64 {
+        (self.r - 0.5 * self.grid.cell).max(0.5 * self.grid.cell)
+    }
+
+    /// True if material stands above `z` under the tool at `p`.
+    pub fn material(&self, p: Point2, z: f64) -> bool {
+        let mut hit = false;
+        self.for_disc(p, self.inner(), |i| hit |= self.top[i] > z + Z_EPS);
+        hit
+    }
+
+    /// True if a cell under the tool at `p` is a pre-drilled hole.
+    pub fn in_hole(&self, p: Point2) -> bool {
+        let mut hit = false;
+        self.for_disc(p, self.inner(), |i| hit |= self.hole[i]);
+        hit
+    }
+
+    /// True if a cell under the tool at `p` was stock at the start.
+    pub fn was_stock(&self, p: Point2) -> bool {
+        let mut hit = false;
+        self.for_disc(p, self.inner(), |i| hit |= self.stock0[i]);
+        hit
+    }
+
+    /// Cut the swept disc of the tool from `a` to `b`.
+    pub fn sweep(&mut self, a: Point3, b: Point3) {
+        let mut mask = Vec::new();
+        let seg = (Point2::new(a.x, a.y), Point2::new(b.x, b.y));
+        self.grid
+            .sweep_capsule(seg, self.r, (a.z, b.z), false, &mut mask, &mut self.top);
+    }
+}
+
+/// The sample points of a move, `step` apart at most, with both ends. An
+/// arc in the XY plane follows its circle; other moves are straight.
+pub(super) fn points(m: &Move, step: f64) -> Vec<Point3> {
+    let (a, b) = (m.from, m.to);
+    let finite = [a.x, a.y, a.z, b.x, b.y, b.z].iter().all(|v| v.is_finite());
+    if !finite || !(step.is_finite() && step > 0.0) {
+        return Vec::new();
+    }
+    let arc = m.arc.filter(|c| c.plane == ArcPlane::Xy);
+    let (a0, sweep, rad, c) = match arc {
+        Some(arc) => {
+            let c = arc.center;
+            let a0 = (a.y - c.y).atan2(a.x - c.x);
+            let a1 = (b.y - c.y).atan2(b.x - c.x);
+            let tau = std::f64::consts::TAU;
+            let mut s = a1 - a0;
+            if arc.ccw {
+                while s <= 1e-12 {
+                    s += tau;
+                }
+            } else {
+                while s >= -1e-12 {
+                    s -= tau;
+                }
+            }
+            ((a0), s, (a.x - c.x).hypot(a.y - c.y), c)
+        }
+        None => (0.0, 0.0, 0.0, Point2::new(0.0, 0.0)),
+    };
+    let len = if arc.is_some() {
+        (sweep.abs() * rad).hypot(b.z - a.z)
+    } else {
+        ((b.x - a.x).powi(2) + (b.y - a.y).powi(2) + (b.z - a.z).powi(2)).sqrt()
+    };
+    let n = (len / step).ceil().clamp(1.0, MAX_STEPS) as usize;
+    (0..=n)
+        .map(|k| {
+            let t = k as f64 / n as f64;
+            let z = a.z + t * (b.z - a.z);
+            if arc.is_some() {
+                let ang = a0 + t * sweep;
+                Point3::new(c.x + rad * ang.cos(), c.y + rad * ang.sin(), z)
+            } else {
+                Point3::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y), z)
+            }
+        })
+        .collect()
+}
