From 764d7fff289c5ff6a08db75e316a19327e9fa0a6 Mon Sep 17 00:00:00 2001
From: Robert Eriksson <3308861+roer70@users.noreply.github.com>
Date: Sun, 22 Nov 2026 10:59:24 +0100
Subject: [PATCH 08/13] fix(machine): a move never trades an axis that moves
 the work with one that moves the tool

An A on the table that traded with a B carrying the head took the head's
slot and tilted the tool. move_axis now refuses a trade across the head,
as it does across kinds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/machine/chain.rs        | 12 +++++++++++-
 crates/app/tests/machine_axis_chain.rs | 17 +++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/crates/app/src/machine/chain.rs b/crates/app/src/machine/chain.rs
index 8f29e27168..e207f92bc5 100644
--- a/crates/app/src/machine/chain.rs
+++ b/crates/app/src/machine/chain.rs
@@ -98,7 +98,8 @@ pub enum Step {
 /// slot carries the head, which sit on the table - and each axis keeps
 /// all its own keys (`parts` stays with the slot). So a rotary that
 /// moves up gets a new `parent` and `chain_order` (#1962). The neighbour
-/// must be of the same kind, rotary or linear. Returns where the moved
+/// must be of the same kind, rotary or linear, and move the same thing,
+/// the work or the tool. Returns where the moved
 /// axis is now.
 pub fn move_axis(v: &mut Value, pointer: &str, step: Step) -> Result<String, String> {
     let rows = axis_pointers(v);
@@ -117,6 +118,15 @@ pub fn move_axis(v: &mut Value, pointer: &str, step: Step) -> Result<String, Str
             "axis {name}: a {what} trades places only with a {what}; to put it elsewhere, remove it and add it again"
         ));
     }
+    // The slot that carries the head keeps it, so a trade across it would
+    // turn a table rotary into one that tilts the tool.
+    let tool = |at: &str| first_of_type(v, &format!("{at}/parts"), "head").is_some();
+    if tool(&rows[i]) != tool(&rows[j]) {
+        let what = if tool(&rows[i]) { "tool" } else { "work" };
+        return Err(format!(
+            "axis {name}: an axis that moves the {what} trades places only with one that moves the {what}; to put it elsewhere, remove it and add it again"
+        ));
+    }
     // Depth-first, the earlier row is an ancestor or in an earlier
     // branch: write it first, so the later write lands in the new tree.
     let (first, second) = (&rows[i.min(j)], &rows[i.max(j)]);
diff --git a/crates/app/tests/machine_axis_chain.rs b/crates/app/tests/machine_axis_chain.rs
index 4969ac88d6..2ab5cda58c 100644
--- a/crates/app/tests/machine_axis_chain.rs
+++ b/crates/app/tests/machine_axis_chain.rs
@@ -196,6 +196,23 @@ fn a_move_trades_only_with_an_axis_of_the_same_kind() {
     assert_eq!(validate_text(&m.text()), [], "{}", m.text());
 }
 
+/// An A on the table and a B that carries the head are both rotaries,
+/// but a trade would put the head on A: A would tilt the tool.
+#[test]
+fn a_rotary_that_turns_the_work_never_trades_with_one_that_tilts_the_tool() {
+    let mut m = grblhal();
+    let a = m.add_rotary_axis(Place::OnTable, "A", [-1.0, 0.0, 0.0]).expect("adds A");
+    let b = m.add_rotary_axis(Place::CarriesHead, "B", [0.0, 1.0, 0.0]).expect("adds B");
+    m.dirty = false;
+    let before = m.value.clone();
+    let tail = "trades places only with one that moves the";
+    let again = "to put it elsewhere, remove it and add it again";
+    assert_eq!(m.move_axis(&a, Step::Down), Err(format!("axis A: an axis that moves the work {tail} work; {again}")));
+    assert_eq!(m.move_axis(&b, Step::Up), Err(format!("axis B: an axis that moves the tool {tail} tool; {again}")));
+    assert_eq!(m.value, before);
+    assert!(!m.dirty, "a refused move changes nothing");
+}
+
 fn unknown_keys_kept_on_x_wherever_it_is(m: &MachineDraft) {
     assert_eq!(m.value.pointer("/x_vendor_block/probe"), Some(&json!("OMP40")));
     let x = m.value.pointer(&pointer_of(m, "X")).expect("X");

