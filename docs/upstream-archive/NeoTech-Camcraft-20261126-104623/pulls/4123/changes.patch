index 0000000000..33670f9192
--- /dev/null
+++ b/crates/pathkernel/tests/laws/load.rs
@@ -0,0 +1,59 @@
+//! Finding 5 of the #4123 review: the load limit has its domain, every
+//! reading and every over-limit record is valid, each reading above the
+//! limit is named once, and each name agrees with a reading (law 6).
+
+use camcraft_pathkernel::Point2;
+use camcraft_pathkernel::guide::GuideSet;
+use camcraft_pathkernel::load::{BAD_LOAD, Controlled, DOUBLE_OVERLOAD, OverLimit, Reading, STRAY_OVERLOAD, UNNAMED_OVERLOAD};
+use camcraft_pathkernel::order::{OrderedSet, StartSide};
+use camcraft_pathkernel::verdict::NO_REASON;
+
+fn set() -> OrderedSet {
+    OrderedSet::new(&GuideSet::default(), vec![], Point2::new(0.0, 0.0), StartSide::Inside).unwrap()
+}
+
+fn control(readings: Vec<Reading>, over: Vec<OverLimit>, limit: f64) -> Result<Controlled, &'static str> {
+    Controlled::new(set(), readings, over, limit).map_err(|e| e.reason())
+}
+
+const P: Point2 = Point2 { x: 2.0, y: 3.0 };
+
+#[test]
+fn the_limit_has_its_domain() {
+    for limit in [0.0, -0.5, 1.5, f64::NAN, f64::INFINITY] {
+        assert_eq!(control(vec![], vec![], limit).unwrap_err(), BAD_LOAD, "{limit}");
+    }
+    assert_eq!(control(vec![], vec![], 0.5).unwrap().limit(), 0.5);
+}
+
+#[test]
+fn readings_and_records_are_valid_by_their_type() {
+    for (at, load) in [(Point2::new(f64::NAN, 0.0), 0.5), (P, f64::NAN), (P, -0.1), (P, 1.2)] {
+        assert!(Reading::new(at, load).is_err(), "{at:?} {load}");
+        assert!(OverLimit::new(at, load, "full width").is_err(), "{at:?} {load}");
+    }
+    assert_eq!(OverLimit::new(P, 1.0, " ").unwrap_err().reason(), NO_REASON);
+}
+
+#[test]
+fn a_reading_over_the_limit_is_named_once() {
+    let hot = vec![Reading::new(P, 1.0).unwrap()];
+    assert_eq!(control(hot.clone(), vec![], 0.5).unwrap_err(), UNNAMED_OVERLOAD);
+    let named = OverLimit::new(P, 1.0, "full-width first ring").unwrap();
+    assert_eq!(control(hot.clone(), vec![named], 0.5).unwrap().over().len(), 1);
+    assert_eq!(control(hot, vec![named, named], 0.5).unwrap_err(), DOUBLE_OVERLOAD);
+    // Within the tolerance band of the limit is not over it.
+    assert!(control(vec![Reading::new(P, 0.52).unwrap()], vec![], 0.5).is_ok());
+}
+
+#[test]
+fn a_record_must_agree_with_a_reading_over_the_limit() {
+    let hot = vec![Reading::new(P, 1.0).unwrap()];
+    // Another place, another load, or a reading that is not over the limit: each is a stray record.
+    let elsewhere = OverLimit::new(Point2::new(9.0, 9.0), 1.0, "full width").unwrap();
+    assert_eq!(control(hot.clone(), vec![OverLimit::new(P, 1.0, "x").unwrap(), elsewhere], 0.5).unwrap_err(), STRAY_OVERLOAD);
+    let other_load = OverLimit::new(P, 0.9, "full width").unwrap();
+    assert_eq!(control(hot, vec![other_load], 0.5).unwrap_err(), UNNAMED_OVERLOAD);
+    let cool = vec![Reading::new(P, 0.3).unwrap()];
+    assert_eq!(control(cool, vec![OverLimit::new(P, 0.3, "x").unwrap()], 0.5).unwrap_err(), STRAY_OVERLOAD);
+}
diff --git a/crates/pathkernel/tests/laws/order.rs b/crates/pathkernel/tests/laws/order.rs
new file mode 100644
index 0000000000..c3d9295fc9
--- /dev/null
+++ b/crates/pathkernel/tests/laws/order.rs
@@ -0,0 +1,86 @@
+//! Finding 1 of the #4123 review: the order stage may only permute the
+//! curves, restart a closed curve and reverse a curve (law 3). Any other
+//! change of a curve - another vertex order, a moved point, a changed
+//! circle, index or family - is refused.
+
+use super::common::{curve, pts};
+use camcraft_pathkernel::Point2;
+use camcraft_pathkernel::guide::{Circle, Curve, Family, GuideSet};
+use camcraft_pathkernel::order::{BAD_START, NOT_A_PERMUTATION, OrderedSet, START_OFF_CURVE, StartSide, UNRESOLVED};
+
+const SQ: [(f64, f64); 4] = [(0.0, 0.0), (4.0, 0.0), (4.0, 4.0), (0.0, 4.0)];
+
+fn ring(xy: &[(f64, f64)]) -> Curve {
+    curve(xy, true, 0, Family::Ring)
+}
+
+fn order(input: &[Curve], out: Vec<Curve>) -> Result<OrderedSet, &'static str> {
+    let g = GuideSet::new(input.to_vec());
+    let start = out.first().map_or(Point2::new(0.0, 0.0), |c| c.pts()[0].at());
+    OrderedSet::new(&g, out, start, StartSide::Inside).map_err(|e| e.reason())
+}
+
+#[test]
+fn a_restart_or_a_reversal_of_a_closed_curve_is_accepted() {
+    let a = ring(&SQ);
+    for shift in 0..4 {
+        let mut fwd = SQ.to_vec();
+        fwd.rotate_left(shift);
+        let mut rev = fwd.clone();
+        rev.reverse();
+        assert!(order(std::slice::from_ref(&a), vec![ring(&fwd)]).is_ok(), "shift {shift}");
+        assert!(order(std::slice::from_ref(&a), vec![ring(&rev)]).is_ok(), "reversed shift {shift}");
+    }
+}
+
+#[test]
+fn another_vertex_order_of_a_closed_curve_is_refused() {
+    // The same four vertices, crossing: (0,0) (4,4) (4,0) (0,4) is a bow tie, not the square.
+    let crossing = ring(&[(0.0, 0.0), (4.0, 4.0), (4.0, 0.0), (0.0, 4.0)]);
+    assert_eq!(order(&[ring(&SQ)], vec![crossing]).unwrap_err(), NOT_A_PERMUTATION);
+    let swapped = ring(&[(0.0, 0.0), (4.0, 0.0), (0.0, 4.0), (4.0, 4.0)]);
+    assert_eq!(order(&[ring(&SQ)], vec![swapped]).unwrap_err(), NOT_A_PERMUTATION);
+}
+
+#[test]
+fn an_open_curve_may_only_be_reversed() {
+    let a = curve(&[(0.0, 0.0), (1.0, 0.0), (2.0, 1.0)], false, 0, Family::Row);
+    assert!(order(std::slice::from_ref(&a), vec![curve(&[(2.0, 1.0), (1.0, 0.0), (0.0, 0.0)], false, 0, Family::Row)]).is_ok());
+    // A cyclic shift of an open curve is another path.
+    let shifted = curve(&[(1.0, 0.0), (2.0, 1.0), (0.0, 0.0)], false, 0, Family::Row);
+    assert_eq!(order(&[a], vec![shifted]).unwrap_err(), NOT_A_PERMUTATION);
+}
+
+#[test]
+fn a_changed_circle_index_family_or_point_is_refused() {
+    let c1 = Circle::new(Point2::new(2.0, 2.0), 2.0).unwrap();
+    let c2 = Circle::new(Point2::new(2.0, 2.0), 2.5).unwrap();
+    let with = |c: Option<Circle>| Curve::new(pts(&SQ), c, true, 0, Family::Ring).unwrap();
+    assert!(order(&[with(Some(c1))], vec![with(Some(c1))]).is_ok());
+    assert_eq!(order(&[with(Some(c1))], vec![with(Some(c2))]).unwrap_err(), NOT_A_PERMUTATION);
+    assert_eq!(order(&[with(Some(c1))], vec![with(None)]).unwrap_err(), NOT_A_PERMUTATION);
+    assert_eq!(order(&[ring(&SQ)], vec![curve(&SQ, true, 7, Family::Ring)]).unwrap_err(), NOT_A_PERMUTATION);
+    assert_eq!(order(&[ring(&SQ)], vec![curve(&SQ, true, 0, Family::Trace)]).unwrap_err(), NOT_A_PERMUTATION);
+    let moved = ring(&[(0.0, 0.0), (4.0, 0.0), (4.0, 4.5), (0.0, 4.0)]);
+    assert_eq!(order(&[ring(&SQ)], vec![moved]).unwrap_err(), NOT_A_PERMUTATION);
+}
+
+#[test]
+fn a_dropped_or_doubled_curve_is_refused_and_a_permutation_accepted() {
+    let a = ring(&SQ);
+    let b = curve(&[(1.0, 1.0), (3.0, 1.0), (3.0, 3.0)], true, 1, Family::Ring);
+    assert_eq!(order(&[a.clone(), b.clone()], vec![a.clone()]).unwrap_err(), NOT_A_PERMUTATION);
+    assert_eq!(order(&[a.clone(), b.clone()], vec![a.clone(), a.clone()]).unwrap_err(), NOT_A_PERMUTATION);
+    assert!(order(&[a.clone(), b.clone()], vec![b, a]).is_ok());
+}
+
+#[test]
+fn the_start_is_resolved_finite_and_on_the_first_curve() {
+    let g = GuideSet::new(vec![ring(&SQ)]);
+    let p = Point2::new(0.0, 0.0);
+    assert_eq!(OrderedSet::new(&g, vec![ring(&SQ)], p, StartSide::Auto).unwrap_err().reason(), UNRESOLVED);
+    assert_eq!(OrderedSet::new(&g, vec![ring(&SQ)], Point2::new(f64::NAN, 0.0), StartSide::Inside).unwrap_err().reason(), BAD_START);
+    let off = OrderedSet::new(&g, vec![ring(&SQ)], Point2::new(4.0, 4.0), StartSide::Inside).unwrap_err();
+    assert_eq!(off.reason(), START_OFF_CURVE);
+    assert_eq!(OrderedSet::new(&g, vec![ring(&SQ)], p, StartSide::Outside).unwrap().resolved(), StartSide::Outside);
+}
diff --git a/crates/pathkernel/tests/laws/plan.rs b/crates/pathkernel/tests/laws/plan.rs
new file mode 100644
index 0000000000..bd90bab8c1
--- /dev/null
+++ b/crates/pathkernel/tests/laws/plan.rs
@@ -0,0 +1,85 @@
+//! Finding 2 of the #4123 review: the step law of a plan is a transition
+//! table. A cut consumes the readiness, so each cut needs its own entry or
+//! stay-down link. Every cell of the table is tested.
+
+use super::common::{pts, square_region, tool};
+use camcraft_pathkernel::entry::{Area, Entry, EntryChoice, EntryKind, Exit, Proof};
+use camcraft_pathkernel::guide::{Curve, Family};
+use camcraft_pathkernel::link::Hop;
+use camcraft_pathkernel::plan::{BAD_AXIS, CUT_WITHOUT_ENTRY, Cut, DANGLING, NO_EXIT, Plan, STRAY_ENTRY, STRAY_EXIT, STRAY_LINK, Step};
+use camcraft_pathkernel::Point2;
+
+fn cut(y: f64) -> Step {
+    let c = Curve::new(pts(&[(0.0, y), (5.0, y)]), None, false, 0, Family::Row).unwrap();
+    Step::Cut(Cut::new(c, None).unwrap())
+}
+fn entry() -> Step {
+    let c = EntryChoice::new(EntryKind::Air, 2.0, vec![]).unwrap();
+    let proof = Proof::InAir(Area::new(square_region(-1.0, -1.0, 20.0)).unwrap());
+    Step::Entry(Entry::new(EntryKind::Air, vec![], pts(&[(0.0, 0.0)]), proof, &c, tool(3.0, false)).unwrap())
+}
+fn exit() -> Step {
+    Step::Exit(Exit::new(None, 5.0).unwrap())
+}
+fn stay() -> Step {
+    Step::Link(Hop::stay(vec![Point2::new(5.0, 1.0)]).unwrap())
+}
+fn lift() -> Step {
+    Step::Link(Hop::lift("crosses a planned cut").unwrap())
+}
+
+fn law(steps: Vec<Step>) -> Result<(), &'static str> {
+    Plan::new(steps).map(|_| ()).map_err(|e| e.reason())
+}
+
+#[test]
+fn the_legal_sequences_pass() {
+    assert!(law(vec![]).is_ok());
+    assert!(law(vec![entry(), cut(0.0), exit()]).is_ok());
+    assert!(law(vec![entry(), cut(0.0), stay(), cut(1.0), exit()]).is_ok());
+    assert!(law(vec![entry(), cut(0.0), lift(), entry(), cut(9.0), exit()]).is_ok());
+    assert!(law(vec![entry(), cut(0.0), exit(), entry(), cut(9.0), exit()]).is_ok());
+}
+
+#[test]
+fn a_cut_consumes_the_readiness() {
+    // Two disconnected cuts in a row: the second has no entry or stay link.
+    assert_eq!(law(vec![entry(), cut(0.0), cut(9.0), exit()]).unwrap_err(), CUT_WITHOUT_ENTRY);
+    assert_eq!(law(vec![cut(0.0), exit()]).unwrap_err(), CUT_WITHOUT_ENTRY);
+    assert_eq!(law(vec![entry(), cut(0.0), lift(), cut(9.0), exit()]).unwrap_err(), CUT_WITHOUT_ENTRY);
+    assert_eq!(law(vec![entry(), cut(0.0), exit(), cut(9.0), exit()]).unwrap_err(), CUT_WITHOUT_ENTRY);
+}
+
+#[test]
+fn each_illegal_cell_of_the_table_is_refused() {
+    // clear: link, exit.
+    assert_eq!(law(vec![stay()]).unwrap_err(), STRAY_LINK);
+    assert_eq!(law(vec![lift()]).unwrap_err(), STRAY_LINK);
+    assert_eq!(law(vec![exit()]).unwrap_err(), STRAY_EXIT);
+    // ready: entry, link, exit.
+    assert_eq!(law(vec![entry(), entry()]).unwrap_err(), STRAY_ENTRY);
+    assert_eq!(law(vec![entry(), stay(), cut(0.0), exit()]).unwrap_err(), STRAY_LINK);
+    assert_eq!(law(vec![entry(), exit()]).unwrap_err(), STRAY_EXIT);
+    // cut end: entry.
+    assert_eq!(law(vec![entry(), cut(0.0), entry(), cut(9.0), exit()]).unwrap_err(), STRAY_ENTRY);
+    // lifted: cut, link, exit.
+    assert_eq!(law(vec![entry(), cut(0.0), lift(), stay()]).unwrap_err(), STRAY_LINK);
+    assert_eq!(law(vec![entry(), cut(0.0), lift(), exit()]).unwrap_err(), STRAY_EXIT);
+}
+
+#[test]
+fn a_plan_ends_clear() {
+    assert_eq!(law(vec![entry(), cut(0.0)]).unwrap_err(), NO_EXIT);
+    assert_eq!(law(vec![entry(), cut(0.0), stay(), cut(1.0)]).unwrap_err(), NO_EXIT);
+    assert_eq!(law(vec![entry()]).unwrap_err(), DANGLING);
+    assert_eq!(law(vec![entry(), cut(0.0), stay()]).unwrap_err(), DANGLING);
+    assert_eq!(law(vec![entry(), cut(0.0), lift()]).unwrap_err(), DANGLING);
+}
+
+#[test]
+fn a_cut_axis_is_a_unit_vector() {
+    let c = Curve::new(pts(&[(0.0, 0.0), (1.0, 0.0)]), None, false, 0, Family::Trace).unwrap();
+    assert!(Cut::new(c.clone(), Some([0.0, 0.0, 1.0])).is_ok());
+    assert_eq!(Cut::new(c.clone(), Some([0.0, 0.0, 2.0])).unwrap_err().reason(), BAD_AXIS);
+    assert_eq!(Cut::new(c, Some([f64::NAN, 0.0, 1.0])).unwrap_err().reason(), BAD_AXIS);
+}
