From 51a718772975425ab9df0524a5d559262abc3548 Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Thu, 26 Nov 2026 05:05:20 -0500
Subject: [PATCH] fix(post): write plane axes first for G18/G19 arcs in
 Sinumerik 810M post

Write the two plane axes first on G18 and G19 arcs in the Sinumerik 810M post.
Omit the third axis when helical motion is not present.

Fixes #4146
---
 assets/posts/sinumerik-810m.cps               | 26 ++++++++++++++++++-
 .../recorded/golden/sinumerik-810m/arcs.nc    |  6 ++---
 crates/post/tests/sinumerik_810m_post.rs      | 18 ++++++++++---
 3 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/assets/posts/sinumerik-810m.cps b/assets/posts/sinumerik-810m.cps
index 75487b08d..394b12dec 100644
--- a/assets/posts/sinumerik-810m.cps
+++ b/assets/posts/sinumerik-810m.cps
@@ -632,6 +632,30 @@ function planeOf(p) {
   return p.CircularPlane === "XZ" ? 18 : (p.CircularPlane === "YZ" ? 19 : 17);
 }
 
+// On Sinumerik 810M, the control reads the first two axes in the block as
+// the plane. Write the two plane axes first (G18: X Z, G19: Y Z), and
+// write the third axis last only when helical motion occurs (#4146).
+function axisMoved(letter, endVal, startVal, curVal, org) {
+  if (!has(endVal)) return false;
+  var from = has(startVal) ? Number(startVal) : (has(curVal) ? curVal : null);
+  if (from === null) return true;
+  return wo(letter, endVal, org) !== wo(letter, from, org);
+}
+
+function arcAxes(p, pl) {
+  if (pl === 18) {
+    var words = [wo("X", p.X, orgX), wo("Z", p.Z, orgZ)];
+    if (axisMoved("Y", p.Y, p.StartY, curY, orgY)) words.push(wo("Y", p.Y, orgY));
+    return words;
+  }
+  if (pl === 19) {
+    var words = [wo("Y", p.Y, orgY), wo("Z", p.Z, orgZ)];
+    if (axisMoved("X", p.X, p.StartX, curX, orgX)) words.push(wo("X", p.X, orgX));
+    return words;
+  }
+  return xyz(p);
+}
+
 function centerWords(p, pl) {
   var c = p.IJKIncrement || {};
   var dx = has(c.I) && has(p.StartX) ? c.I - p.StartX : c.I;
@@ -659,7 +683,7 @@ function onCircular() {
     pw = "G" + pl;
     planeG = pl;
   }
-  block([pw, g].concat(xyz(properties), centerWords(properties, pl), [fw(properties.FeedRate)]));
+  block([pw, g].concat(arcAxes(properties, pl), centerWords(properties, pl), [fw(properties.FeedRate)]));
   trackPos(properties.X, properties.Y, properties.Z);
 }
 
diff --git a/crates/post/tests/recorded/golden/sinumerik-810m/arcs.nc b/crates/post/tests/recorded/golden/sinumerik-810m/arcs.nc
index 4d43ce5df..3ef311d04 100644
--- a/crates/post/tests/recorded/golden/sinumerik-810m/arcs.nc
+++ b/crates/post/tests/recorded/golden/sinumerik-810m/arcs.nc
@@ -13,9 +13,9 @@ G0 X10 Y0 Z5
 G1 X10 Y0 Z0 F300
 G3 X0 Y10 Z0 I-10 J0 F800
 G2 X10 Y20 Z0 I10 J0 F800
-G18 G2 X20 Y20 Z-10 I10 K0 F600
-G19 G3 X20 Y30 Z-20 J10 K0 F600
-G3 X20 Y30 Z0 J0 K10 F600
+G18 G2 X20 Z-10 I10 K0 F600
+G19 G3 Y30 Z-20 J10 K0 F600
+G3 Y30 Z0 J0 K10 F600
 G17 G2 X30 Y40 Z-2 I10 J0 F500
 G0 X30 Y40 Z15
 M5
diff --git a/crates/post/tests/sinumerik_810m_post.rs b/crates/post/tests/sinumerik_810m_post.rs
index 46c2469b2..ba8893324 100644
--- a/crates/post/tests/sinumerik_810m_post.rs
+++ b/crates/post/tests/sinumerik_810m_post.rs
@@ -255,7 +255,17 @@ fn arcs_comp_and_dwell_match_810m_dialect() {
             kind: MoveKind::Feed, x: 10.0, y: 50.0, z: -7.0, feed: Some(400.0),
             center: Some((10.0, 45.0)), ccw: false, plane: ArcPlane::Xy, abc: None,
         }),
-        mv(MoveKind::Rapid, 10.0, 50.0, 15.0, None),
+        // Helical G18 arc: X and Z in plane, Y moves from 50.0 to 52.0 (#4146).
+        cnc::Record::Move(cnc::MoveRec {
+            kind: MoveKind::Feed, x: 20.0, y: 52.0, z: -9.0, feed: Some(400.0),
+            center: Some((20.0, -7.0)), ccw: false, plane: ArcPlane::Xz, abc: None,
+        }),
+        // Helical G19 arc: Y and Z in plane, X moves from 20.0 to 22.0 (#4146).
+        cnc::Record::Move(cnc::MoveRec {
+            kind: MoveKind::Feed, x: 22.0, y: 60.0, z: -11.0, feed: Some(400.0),
+            center: Some((60.0, -9.0)), ccw: true, plane: ArcPlane::Yz, abc: None,
+        }),
+        mv(MoveKind::Rapid, 22.0, 60.0, 15.0, None),
         cnc::Record::Section { begin: false },
     ];
     let out = run(&mch, &cnc::serialize(&recs), &json!({}));
@@ -265,9 +275,11 @@ fn arcs_comp_and_dwell_match_810m_dialect() {
     assert!(p.contains("G40 "), "{p}");
     assert!(p.contains("(WEAR COMP - D1 HOLDS WEAR DELTA ONLY)"), "{p}");
     assert!(!p.contains("NORM") && !p.contains("KONT") && !p.contains("CR="), "{p}");
-    assert!(p.contains("G18 G2 X10 Y30 Z-4 I10 K0 F400"), "{p}");
-    assert!(p.contains("G19 G3 X10 Y40 Z-6 J10 K0 F400"), "{p}");
+    assert!(p.contains("G18 G2 X10 Z-4 I10 K0 F400"), "{p}");
+    assert!(p.contains("G19 G3 Y40 Z-6 J10 K0 F400"), "{p}");
     assert!(p.contains("G17 G2 X10 Y50 Z-7 I0 J5 F400"), "{p}");
+    assert!(p.contains("G18 G2 X20 Z-9 Y52 I10 K0 F400"), "{p}");
+    assert!(p.contains("G19 G3 Y60 Z-11 X22 J8 K0 F400"), "{p}");
 
     // Plane change while G41 is active must be refused by name.
     let bad_plane = recs.into_iter().filter(|r| !matches!(r, cnc::Record::Comp { side: None, .. })).collect::<Vec<_>>();
