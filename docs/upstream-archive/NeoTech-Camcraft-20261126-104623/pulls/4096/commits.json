[
  {
    "sha": "74acdafa239774eb41ee61a343d955f93b6e925c",
    "node_id": "C_kwDOV1WsOtoAKDc0YWNkYWZhMjM5Nzc0ZWI0MWVlNjFhMzQzZDk1NWY5M2I2ZTkyNWM",
    "commit": {
      "author": {
        "name": "Quintin Smits",
