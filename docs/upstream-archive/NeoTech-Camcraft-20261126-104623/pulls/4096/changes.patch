+        Err(DesignationError::Position { standard: "ISO 1832", pos, name, .. }) => (pos, name),
+        other => panic!("{s:?}: {other:?}"),
+    };
+    let with = |f: &dyn Fn(&mut InsertSpec)| {
+        let mut s = good.clone();
+        f(&mut s);
+        s
+    };
