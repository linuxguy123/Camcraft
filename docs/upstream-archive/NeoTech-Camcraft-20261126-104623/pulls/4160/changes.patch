From 95e8eb2e0dae71d3d932018b96661e03d7b45702 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 26 Nov 2026 00:44:31 -0800
Subject: [PATCH] test(app): one temp folder for each wire_post program

post_text() wrote every call to camcraft-wire-skims-<pid>.nc. The tests
that call it run in parallel threads of one process, so they shared the
path, and Windows refused the write ("Access is denied", os error 5).
Each call now writes into its own tempfile directory.

Fixes #4159

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/tests/wire_post.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/crates/app/tests/wire_post.rs b/crates/app/tests/wire_post.rs
index 0dd780d5d..b248dfd42 100644
--- a/crates/app/tests/wire_post.rs
+++ b/crates/app/tests/wire_post.rs
@@ -326,9 +326,11 @@ fn skim(id: &str, reverse: bool) -> WireSkim {
 }
 
 fn post_text(world: &World) -> String {
-    let out = std::env::temp_dir().join(format!("camcraft-wire-skims-{}.nc", std::process::id()));
+    // #4159: one directory for each call. Tests run in parallel threads of one
+    // process, and Windows refuses a write to a file that another thread holds.
+    let dir = tempfile::tempdir().expect("a temp folder");
+    let out = dir.path().join("camcraft-wire-skims.nc");
     let posted = posting::post_script(world, &out, cps(WIRE)).expect("the wire program posts");
-    let _ = std::fs::remove_file(&out);
     posted.program
 }
 
