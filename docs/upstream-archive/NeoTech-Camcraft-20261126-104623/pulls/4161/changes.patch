diff --git a/crates/post/src/post/machine_installation.rs b/crates/post/src/post/machine_installation.rs
index c194d08101..f2a9c303fa 100644
--- a/crates/post/src/post/machine_installation.rs
+++ b/crates/post/src/post/machine_installation.rs
@@ -67,4 +67,13 @@ pub(super) fn script_props(m: &Value, props: &mut Value) {
     if let Some(mode) = m.pointer("/tooling/tool_change").and_then(Value::as_str) {
         props["toolChangeMode"] = json!(mode);
     }
