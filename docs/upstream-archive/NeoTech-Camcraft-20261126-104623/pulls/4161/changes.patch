+        .map(|tol| tol * f);
     // #131: keep the stated unit for the posts (the numbers stay mm).
     let length = v.pointer("/kinematics/default/units/length").and_then(|u| u.as_str());
     if matches!(length, Some("inch" | "inches")) {
