     /// `general.operator_side` (#2632): the stated side; `None` takes the kind's default.
     #[serde(default, skip_serializing_if = "Option::is_none")]
     pub operator_side: Option<super::operator_side::OperatorSide>,
@@ -323,6 +326,7 @@ impl Machine {
             && rate_ok(self.max_tool_diameter)
             && rate_ok(self.spindle_d)
             && rate_ok(self.spindle_len)
+            && rate_ok(self.arc_tolerance)
             && self
                 .kind
                 .as_deref()
diff --git a/crates/post/src/machine/parse.rs b/crates/post/src/machine/parse.rs
index 920d671663..dc22544bc5 100644
--- a/crates/post/src/machine/parse.rs
+++ b/crates/post/src/machine/parse.rs
@@ -221,6 +221,12 @@ pub fn parse_mch_with(text: &str, holders: Option<super::HolderLookup>) -> Resul
 
     let kine = v.pointer("/kinematics/default/parts");
     let f = mm_factor(v.pointer("/kinematics/default/units")).unwrap_or(1.0);
+    m.arc_tolerance = v.pointer("/controller/arc_tolerance")
+        .and_then(serde_json::Value::as_f64)
+        .or_else(|| v.pointer("/controller/arcTolerance").and_then(serde_json::Value::as_f64))
