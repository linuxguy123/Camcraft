From 1cd28a35fd24ba3caeab89b42ae6986a9e9816b5 Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Thu, 26 Nov 2026 03:40:29 -0500
Subject: [PATCH] fix(#4110): name hole-order and sinker kinds in
 start_exit_shared capability test panic text

---
 crates/app/tests/start_exit_shared.rs            | 2 +-
 crates/app/tests/start_exit_shared/hole_order.rs | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/crates/app/tests/start_exit_shared.rs b/crates/app/tests/start_exit_shared.rs
index b32de0c18..a9bf17295 100644
--- a/crates/app/tests/start_exit_shared.rs
+++ b/crates/app/tests/start_exit_shared.rs
@@ -102,7 +102,7 @@ fn every_kind_has_one_pick_capability_and_only_the_taken_ones_take_a_pick() {
             OpType::SinkerSideBurn => assert_eq!(cap, PickCapability::Ends, "the side burn takes an end of its side move"),
             _ => {
                 let PickCapability::NotTaken(why) = cap else {
-                    panic!("{}: only the contour, the wire, the face, the slot and the three turning kinds take a pick", k.label)
+                    panic!("{}: only the contour, the wire, the face, the slot, the three turning kinds, the hole-order kinds and the sinker kinds take a pick", k.label)
                 };
                 assert!(!why.is_empty(), "{}: the reason is named", k.label);
             }
diff --git a/crates/app/tests/start_exit_shared/hole_order.rs b/crates/app/tests/start_exit_shared/hole_order.rs
index 46a828dd7..2c7adf688 100644
--- a/crates/app/tests/start_exit_shared/hole_order.rs
+++ b/crates/app/tests/start_exit_shared/hole_order.rs
@@ -72,6 +72,7 @@ fn drill(picks: PathPicks) -> OpParams {
 
 fn bore(picks: PathPicks) -> OpParams {
     OpParams::Bore {
+        entry: camcraft_app::machining3d::Entry3D::Plunge,
         pass_start: PassStart::Auto,
         break_through: None,
         links: camcraft_app::links::Links::PLANAR,
