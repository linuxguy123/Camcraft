From 2bda761cd9aa969b3cf1e8d48e8afedba117d286 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Wed, 25 Nov 2026 21:57:19 -0800
Subject: [PATCH] fix(test): build the disk_recovery machines path per
 component

The test made the folder with join("assets/machines"). On Windows that
path keeps a '/', and the reader prints '\'. The contains check failed.
Join "assets" and "machines" one at a time, in the parent and the child.
The reader does not change.

Fixes #4120

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../tests/default_machine_missing/disk_recovery.rs  |  7 +++++--
 docs/decisions/4120-windows-path-sep.md             | 13 +++++++++++++
 2 files changed, 18 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/4120-windows-path-sep.md

diff --git a/crates/app/tests/default_machine_missing/disk_recovery.rs b/crates/app/tests/default_machine_missing/disk_recovery.rs
index 820c3183f..425683d58 100644
--- a/crates/app/tests/default_machine_missing/disk_recovery.rs
+++ b/crates/app/tests/default_machine_missing/disk_recovery.rs
@@ -20,7 +20,9 @@ fn a_repaired_default_machine_file_is_read_again_through_the_disk_reader() {
     // A copied test executable has fresh OnceLocks and reads only the
     // assets beside it. No process-wide environment or shipped file changes.
     let root = tempfile::tempdir().expect("isolated install folder");
-    std::fs::create_dir_all(root.path().join("assets/machines")).expect("machines folder");
+    // One join per component: "assets/machines" keeps a '/' on Windows (#4120).
+    std::fs::create_dir_all(root.path().join("assets").join("machines"))
+        .expect("machines folder");
     let source = std::env::current_exe().expect("test executable");
     let exe = root
         .path()
@@ -49,7 +51,8 @@ fn check_disk_recovery() {
     let machines = exe
         .parent()
         .expect("install folder")
-        .join("assets/machines");
+        .join("assets")
+        .join("machines");
     let file = machines.join("3axis-vmc.mch");
     assert!(!file.exists(), "the default machine starts missing");
     let missing = default_machine_checked().expect_err("missing file must refuse");
diff --git a/docs/decisions/4120-windows-path-sep.md b/docs/decisions/4120-windows-path-sep.md
new file mode 100644
index 000000000..4025f5e31
--- /dev/null
+++ b/docs/decisions/4120-windows-path-sep.md
@@ -0,0 +1,13 @@
+# 4120 - disk_recovery test builds the machines folder one component at a time
+
+- **Chosen:** in `crates/app/tests/default_machine_missing/disk_recovery.rs`,
+  build the machines folder with `.join("assets").join("machines")` in the
+  parent test and in `check_disk_recovery`.
+- **Why:** `join("assets/machines")` keeps the `/` on Windows. The reader
+  prints `...\assets\machines`, so the `contains` check on the path failed
+  on Windows only. The reader is correct; only the test was wrong.
+- **Dropped:** a change to the reader or to its message (not needed, and the
+  issue says not to change it). A normalised string compare in the test
+  (it would hide a reader that prints a different folder). The
+  `../../assets/machines/3axis-vmc.mch` source path on line 72 stays: it is
+  only opened, never compared as text, and Windows accepts `/` there.
