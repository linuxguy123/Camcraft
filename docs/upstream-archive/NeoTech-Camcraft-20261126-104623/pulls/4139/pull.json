  "title": "feat(post): Sodick LN2W control-side wire offset (G41/G42 H, G40 on the lead-out)",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
