+    assert!(e.is_valid(), "{:?}", e.refusals);
+    assert_eq!(e.kind, Some(Kind::WireEdm));
+    assert!(e.posts.contains(&LN2W) && e.posts.contains(&MARK21), "{:?}", e.posts);
+}
