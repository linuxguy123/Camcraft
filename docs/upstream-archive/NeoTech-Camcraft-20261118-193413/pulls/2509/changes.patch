From d7aa843e5ee6abefa7ef5c60152afded90f08420 Mon Sep 17 00:00:00 2001
From: Viljo Marrandi <30616+vilts@users.noreply.github.com>
Date: Wed, 18 Nov 2026 13:56:53 +0200
Subject: [PATCH] refactor(tools): name each tool kind in the kind rules, with
 no catch-all

Tool::kind_rule ended with `_ => None`, so a new ToolKind passed the
check with no kind rule. The last arm now names each kind without a rule
(or whose guarded rules held). A new kind does not compile until the
match names it. The test kind list is guarded by an exhaustive
kind_slot match and the_sweep_list_holds_each_kind_once.

Fixes #2505

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/tools/src/tool_sanity.rs              | 17 ++++++++-
 crates/tools/src/tool_sanity_tests.rs        | 37 ++++++++++++++++++++
 docs/decisions/2505-exhaustive-kind-match.md |  7 ++++
 3 files changed, 60 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/2505-exhaustive-kind-match.md

diff --git a/crates/tools/src/tool_sanity.rs b/crates/tools/src/tool_sanity.rs
index 968d7bff8..b041ed6c7 100644
--- a/crates/tools/src/tool_sanity.rs
+++ b/crates/tools/src/tool_sanity.rs
@@ -155,7 +155,22 @@ impl Tool {
             ToolKind::Wire => crate::wire::refusal(self),
             ToolKind::Electrode => self.electrode_rule(),
             ToolKind::ThreadMill | ToolKind::ThreadMillSingle => self.thread_mill_rule(),
-            _ => None,
+            // No kind rule, or each guarded rule above held. Each kind is
+            // named, with no catch-all: a new `ToolKind` does not compile
+            // until this match names it (#2505).
+            ToolKind::EndMill
+            | ToolKind::BallNose
+            | ToolKind::BullNose
+            | ToolKind::Bore
+            | ToolKind::Drill
+            | ToolKind::Tap
+            | ToolKind::Turning
+            | ToolKind::Groove
+            | ToolKind::Thread
+            | ToolKind::Form
+            | ToolKind::Taper
+            | ToolKind::Probe
+            | ToolKind::Torch => None,
         }
     }
 
diff --git a/crates/tools/src/tool_sanity_tests.rs b/crates/tools/src/tool_sanity_tests.rs
index 58c23f781..c1132bcf9 100644
--- a/crates/tools/src/tool_sanity_tests.rs
+++ b/crates/tools/src/tool_sanity_tests.rs
@@ -118,6 +118,43 @@ const KINDS: [ToolKind; 18] = [
     ToolKind::ThreadMillSingle,
 ];
 
+/// Each kind's place, with no catch-all: a new `ToolKind` does not compile
+/// until it gets a slot here, and then `KINDS` must hold it, or the test
+/// below fails (#2505).
+fn kind_slot(kind: ToolKind) -> usize {
+    match kind {
+        ToolKind::EndMill => 0,
+        ToolKind::BallNose => 1,
+        ToolKind::BullNose => 2,
+        ToolKind::Drill => 3,
+        ToolKind::Tap => 4,
+        ToolKind::Bore => 5,
+        ToolKind::Turning => 6,
+        ToolKind::Groove => 7,
+        ToolKind::Thread => 8,
+        ToolKind::Form => 9,
+        ToolKind::Taper => 10,
+        ToolKind::Probe => 11,
+        ToolKind::Torch => 12,
+        ToolKind::Waterjet => 13,
+        ToolKind::Wire => 14,
+        ToolKind::Electrode => 15,
+        ToolKind::ThreadMill => 16,
+        ToolKind::ThreadMillSingle => 17,
+    }
+}
+
+#[test]
+fn the_sweep_list_holds_each_kind_once() {
+    let mut seen = [0usize; KINDS.len()];
+    for kind in KINDS {
+        let slot = kind_slot(kind);
+        assert!(slot < seen.len(), "{kind:?} has slot {slot}: add it to KINDS");
+        seen[slot] += 1;
+    }
+    assert!(seen.iter().all(|&n| n == 1), "each kind once in KINDS: {seen:?}");
+}
+
 fn agree(t: &Tool, what: &str) {
     let why = t.why_not_sane();
     assert_eq!(why.is_none(), old_is_sane(t), "{what}: {why:?} on {t:?}");
diff --git a/docs/decisions/2505-exhaustive-kind-match.md b/docs/decisions/2505-exhaustive-kind-match.md
new file mode 100644
index 000000000..633673d1d
--- /dev/null
+++ b/docs/decisions/2505-exhaustive-kind-match.md
@@ -0,0 +1,7 @@
+## #2505 - The tool kind rules name each kind, with no catch-all
+
+- **Decided:** `Tool::kind_rule` in `crates/tools/src/tool_sanity.rs` has no `_ => None` arm. Its last arm names each kind that has no rule, or whose guarded rules held. A new `ToolKind` does not compile until this match names it.
+  - **Why:** with the catch-all, a new kind passed the check with no kind rule, and no test saw it.
+- **Decided:** the test list `KINDS` is guarded by `kind_slot`, an exhaustive match in the test file. A new kind does not compile until it gets a slot. Then `the_sweep_list_holds_each_kind_once` fails until `KINDS` holds it.
+  - **Dropped:** a `ToolKind::ALL` constant in `crates/tools/src/tools.rs`. That file has 691 lines, over the 400-line limit. A hand-written constant also does not grow by itself when a kind is added.
+- **Not changed:** the oracle `old_is_sane` keeps its `_ => true`. It is the old law, verbatim, and the sweep compares against it. The verdicts for the 18 kinds do not change.
