+}
+
+// A drill cycle's expanded hole chain posts as these plain moves.
+function onRapid() {
+  startPreamble();
+  seeZ(properties.Z);
+  if (!tiltOk(properties)) return;
+  if (!xyFirst(properties.X, properties.Y, properties.Z)) return;  // #1682: refused - the move is not written
