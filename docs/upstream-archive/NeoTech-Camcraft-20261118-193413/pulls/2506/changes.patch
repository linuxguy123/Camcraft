+  dwellAtBottom(properties.Z);
+}
+function onCircular() {
+  startPreamble();
+  if (!tiltOk(properties)) return;
+  if (spindleStopped("arc move " + (properties.CircularDirection === "CW" ? "G2" : "G3"))) return;
