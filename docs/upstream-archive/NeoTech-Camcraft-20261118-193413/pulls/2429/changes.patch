+#[test]
+fn tilted_height_region_level_uses_the_same_fold() {
+    let state = asymmetric_tilted_pocket();
+    let level = camcraft_app::operation::region_z(
+        &state.world, None, Some(&state.op_ui.src()), &state.op_ui.params,
