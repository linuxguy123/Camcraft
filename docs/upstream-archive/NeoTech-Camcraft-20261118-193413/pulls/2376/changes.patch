From 09186f86ed41ea42af4552759434602c13090425 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 17 Nov 2026 13:01:16 -0800
Subject: [PATCH] fix(post): refuse unverified Sinumerik G73 dwell

Diagnose a positive G73 dwell before cycle positioning or output. Keep zero-dwell peck cycles and the verified G83 behavior.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #2354
---
 assets/posts/sinumerik.cps                 | 10 +++-
 crates/post/tests/script_sinumerik.rs      | 58 ++++++++++++++++++++++
 docs/decisions/2354-sinumerik-g73-dwell.md | 20 ++++++++
 3 files changed, 86 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/2354-sinumerik-g73-dwell.md

diff --git a/assets/posts/sinumerik.cps b/assets/posts/sinumerik.cps
index fab268127..75ac8f71e 100644
--- a/assets/posts/sinumerik.cps
+++ b/assets/posts/sinumerik.cps
@@ -733,6 +733,12 @@ function onCycle() {
     msg("canned cycle G86 (bore) has no dwell word on this control - a " + (ms / 1000) + " s dwell is refused, not dropped; set the dwell to 0");
     return;
   }
+  // #2354: the maintainer's ISO-mode check verified G83 P only, not G73.
+  // Refuse a requested G73 dwell before positioning or writing the cycle.
+  if (g === "G73" && has(p.P) && p.P > 0) {
+    msg("canned cycle G73 (peck) dwell is not verified in Sinumerik ISO dialect mode - a " + p.P + " s dwell is refused, not dropped; set the dwell to 0");
+    return;
+  }
   if (spindleStopped("canned cycle " + g)) return;
   if (!xyFirst(p.X, p.Y, p.R, false)) return;  // #1633: refused - the move is not written
   cycleSeat(p);
@@ -745,8 +751,8 @@ function onCycle() {
   // dialect mode (G291), 2026-11-17. This post writes no G291: it assumes
   // the control runs in ISO dialect mode. Siemens' "ISO dialects" Function
   // Manual (SINUMERIK ONE / 840D sl / 828D, 07/2021), section 6.3, lists
-  // no P in its G73 and G83 formats, so G73 is left as it was (#2354 is
-  // open for that dispute). G84 takes no P here.
+  // no P in its G73 and G83 formats; an unverified G73 dwell is refused
+  // above (#2354). G84 takes no P here.
   if (ms > 0 && g !== "G73" && g !== "G84") words.push("P" + ms);
   words.push(fw(p.FeedRate));
   block(words);
diff --git a/crates/post/tests/script_sinumerik.rs b/crates/post/tests/script_sinumerik.rs
index 3fdd27df9..bd4c1f676 100644
--- a/crates/post/tests/script_sinumerik.rs
+++ b/crates/post/tests/script_sinumerik.rs
@@ -14,3 +14,61 @@
 mod recorded;
 
 post_suite!("sinumerik.cps");
+
+fn peck_output(dwell: f64) -> camcraft_post::post::engine::PostOutput {
+    use camcraft_post::cl::{CycleKind, MoveKind};
+    use camcraft_post::post::{cnc::{self, CycleRec, MoveRec, Record}, engine};
+    use serde_json::json;
+
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let machine = serde_json::from_str(
+        &std::fs::read_to_string(root.join("assets/machines/3axis-vmc.mch")).expect("machine fixture"),
+    ).expect("machine JSON");
+    let records = vec![
+        Record::Param { name: "SpindleSpeed".into(), value: json!(900.0) },
+        Record::Param { name: "ClearancePlane".into(), value: json!(10.0) },
+        Record::Param { name: "RetractPlane".into(), value: json!(10.0) },
+        Record::Tool { number: 4, name: "DRILL".into() },
+        Record::Section { begin: true },
+        Record::Move(MoveRec {
+            kind: MoveKind::Rapid, x: 10.0, y: 10.0, z: 2.0,
+            feed: None, center: None, ccw: false, plane: Default::default(), abc: None,
+        }),
+        Record::Cycle(CycleRec {
+            kind: CycleKind::Peck, x: 10.0, y: 10.0, r_z: 2.0, bottom_z: -12.0,
+            entry_z: 0.0, peck: 3.0, dwell, first_move: 1, feed: Some(120.0),
+        }),
+        Record::Section { begin: false },
+    ];
+    let script = std::fs::read_to_string(root.join("assets/posts/sinumerik.cps")).expect("post fixture");
+    engine::run(&script, &machine, &cnc::serialize(&records)).expect("post engine")
+}
+
+#[test]
+fn sinumerik_g73_dwell_is_refused_by_name() {
+    for dwell in [0.001, 0.5] {
+        let out = peck_output(dwell);
+        assert!(
+            out.warnings.iter().any(|w| w.contains("G73") && w.contains("dwell") && w.contains("refused")),
+            "G73 dwell {dwell} must be refused by name: {:?}", out.warnings,
+        );
+        assert!(
+            !out.program.split_whitespace().any(|w| w == "G73"),
+            "a refused dwell must not write G73: {}", out.program,
+        );
+    }
+}
+
+#[test]
+fn sinumerik_g73_without_dwell_still_posts() {
+    let out = peck_output(0.0);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let cycle = out.program.lines()
+        .find(|line| line.split_whitespace().any(|w| w == "G73"))
+        .expect("zero-dwell peck cycle");
+    let words: Vec<_> = cycle.split_whitespace().collect();
+    for word in ["X10", "Y10", "Z-12", "R2", "Q3", "F120"] {
+        assert!(words.contains(&word), "G73 keeps {word}: {cycle}");
+    }
+    assert!(!words.iter().any(|w| w.starts_with('P')), "no dwell means no P: {cycle}");
+}
diff --git a/docs/decisions/2354-sinumerik-g73-dwell.md b/docs/decisions/2354-sinumerik-g73-dwell.md
new file mode 100644
index 000000000..ffae8e2b6
--- /dev/null
+++ b/docs/decisions/2354-sinumerik-g73-dwell.md
@@ -0,0 +1,20 @@
+## #2354 - Refuse unverified Sinumerik G73 dwell
+
+**Decided:** Refuse a positive dwell on a Sinumerik PECK/G73 cycle with a
+named, counted diagnostic before positioning or writing the cycle. Keep
+zero-dwell G73 and the existing G83 dwell output unchanged. Other posts
+with the same omission are tracked by #2356.
+
+**Why:** The maintainer's 2026-11-17 decision was "Not verified: leave it"
+for G73 P support. The control check covered G83 only. Refusing the dwell
+prevents a silent change to the requested program without inventing an
+unverified G73 word.
+
+**Considered and dropped:** Posting G73 P based on the G83 check would
+extend that evidence to a different cycle. Silently omitting the dwell
+would retain the defect. Expanding the cycle or substituting another
+cycle would change behavior beyond this refusal fix.
+
+**Cost to change later:** Once G73 dwell support is verified, replace the
+refusal with the verified output and update the refusal pins to check
+that output. Keep the zero-dwell and G83 regression coverage.
