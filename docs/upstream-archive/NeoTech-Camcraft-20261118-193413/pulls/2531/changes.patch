From: mkinney <mike.kinney@gmail.com>
Date: Wed, 18 Nov 2026 14:28:15 +0100
Subject: [PATCH] fix(build): preserve LF in all shipped example NC programs

Pin root and catalog example programs to LF. Test a fresh Git checkout
with core.autocrlf=true to prevent byte comparison failures on Windows.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #2523
---
 .gitattributes                       |  4 +-
 docs/decisions/2523-example-nc-lf.md | 20 +++++++
 xtask/tests/example_line_endings.rs  | 81 ++++++++++++++++++++++++++++
 3 files changed, 103 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/2523-example-nc-lf.md
 create mode 100644 xtask/tests/example_line_endings.rs

diff --git a/.gitattributes b/.gitattributes
index 6ed8b2fd2..f02afb959 100644
--- a/.gitattributes
+++ b/.gitattributes
@@ -3,8 +3,8 @@
 crates/app/tests/golden/** text eol=lf
 # Tester-kit programs are pinned byte for byte by their tests, like the goldens.
 docs/tester-kits/**/*.nc text eol=lf
-# The first 4-axis part's program is pinned the same way (#1904).
-examples/first-4axis-part.nc text eol=lf
+# Shipped example programs, including the catalog, are pinned byte for byte.
+examples/**/*.nc text eol=lf
 
 # Shell scripts run on macOS / Linux: a CR would break the shebang.
 *.sh text eol=lf
diff --git a/docs/decisions/2523-example-nc-lf.md b/docs/decisions/2523-example-nc-lf.md
new file mode 100644
index 000000000..a0790de63
--- /dev/null
+++ b/docs/decisions/2523-example-nc-lf.md
@@ -0,0 +1,20 @@
+## #2523 - Keep example NC programs at LF
+
+**Decision:** Use `examples/**/*.nc text eol=lf` for all example programs.
+Replace the separate rule for the first 4-axis part.
+Test a fresh Git checkout with `core.autocrlf=true` in an isolated repository.
+The test copies the real attributes and all tracked example NC programs.
+
+**Why:** The post writes LF bytes. The example tests compare those bytes
+with the shipped programs. Git must preserve LF on Windows as well as Linux.
+The glob covers programs directly in `examples/` and inside the catalog.
+All four programs already have LF in the Git index, so no renormalization is needed.
+The 4-axis tests read the already pinned program. The site tests read only
+that program and use text reads.
+
+**Dropped:** Separate rules for each program need updates for new examples.
+A repository-wide `*.nc` rule or global line-ending rule changes files
+outside this issue. Changing the byte comparisons would hide checkout errors.
+
+**Cost to change later:** Edit one attribute rule and its checkout test.
+No posted program or golden changes.
diff --git a/xtask/tests/example_line_endings.rs b/xtask/tests/example_line_endings.rs
new file mode 100644
index 000000000..662adcb15
--- /dev/null
+++ b/xtask/tests/example_line_endings.rs
@@ -0,0 +1,81 @@
+// Provenance: Git's documented core.autocrlf and gitattributes checkout behavior.
+use std::{fs, path::Path, process::Command, time::SystemTime};
+
+struct Checkout(std::path::PathBuf);
+
+impl Drop for Checkout {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn git(root: &Path, args: &[&str]) -> Vec<u8> {
+    let output = Command::new("git")
+        .arg("-c")
+        .arg("core.autocrlf=true")
+        .arg("-c")
+        .arg("core.safecrlf=false")
+        .arg("-c")
+        .arg("core.attributesfile=")
+        .args(args)
+        .current_dir(root)
+        .output()
+        .expect("run Git for the example checkout test");
+    assert!(
+        output.status.success(),
+        "git {args:?}: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    output.stdout
+}
+
+#[test]
+fn all_example_nc_files_keep_lf_with_autocrlf() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap();
+    let tracked = git(root, &["ls-files", "-z", "examples"]);
+    let programs: Vec<_> = std::str::from_utf8(&tracked)
+        .unwrap()
+        .split('\0')
+        .filter(|path| path.ends_with(".nc"))
+        .collect();
+    assert!(!programs.is_empty(), "no tracked example NC programs");
+
+    let stamp = SystemTime::now()
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let checkout = Checkout(std::env::temp_dir().join(format!(
+        "camcraft-example-lf-{}-{stamp}",
+        std::process::id()
+    )));
+    fs::create_dir(&checkout.0).unwrap();
+    git(&checkout.0, &["init", "--quiet", "--template="]);
+    fs::copy(
+        root.join(".gitattributes"),
+        checkout.0.join(".gitattributes"),
+    )
+    .unwrap();
+    for program in &programs {
+        let target = checkout.0.join(program);
+        fs::create_dir_all(target.parent().unwrap()).unwrap();
+        fs::copy(root.join(program), &target).unwrap();
+    }
+    git(&checkout.0, &["add", "."]);
+    for program in &programs {
+        fs::remove_file(checkout.0.join(program)).unwrap();
+    }
+    git(&checkout.0, &["checkout-index", "--all", "--force"]);
+
+    let mut changed = Vec::new();
+    for program in programs {
+        let actual = fs::read(checkout.0.join(program)).unwrap();
+        let indexed = git(&checkout.0, &["show", &format!(":{program}")]);
+        if actual.contains(&b'\r') || actual != indexed {
+            changed.push(program);
+        }
+    }
+    assert!(
+        changed.is_empty(),
+        "example NC checkout must preserve LF bytes with core.autocrlf=true: {changed:?}"
+    );
+}
