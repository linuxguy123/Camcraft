  "title": "fix(2d): a start-side edit of a seeded 2D Offset takes the Arc entry",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
