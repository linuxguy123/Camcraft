From 9d9f0d3114e0fb8ff0ce2880e29c7f1c37b3d618 Mon Sep 17 00:00:00 2001
From: tbrasselle <tbrasselle@gmail.com>
Date: Sun, 22 Nov 2026 10:58:41 -0500
Subject: [PATCH 1/4] fix(xtask): cover a package-level link in the unit sweep
 and fold link-target case on mac

Two gaps in the gate unit sweep (#3173):

- The scan skipped a link at the package level, but no test covered it.
  New test: a package link (whose name differs only by case) is never
  entered, the sweep removes nothing through it, and the link stays.
- norm() folded case only on Windows. On the case-insensitive default
  volume of macOS, a canonicalized link target that differs only by case
  missed the process-check needles. norm() now folds case on macOS too.

The verdict logic of the sweep is untouched.

Fixes #3173
---
 xtask/src/unit_sweep.rs       |  6 ++++--
 xtask/src/unit_sweep_tests.rs | 36 +++++++++++++++++++++++++++++++++++
 2 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/xtask/src/unit_sweep.rs b/xtask/src/unit_sweep.rs
index 083d0e09f..224292ff7 100644
--- a/xtask/src/unit_sweep.rs
+++ b/xtask/src/unit_sweep.rs
@@ -237,7 +237,9 @@ pub fn lines(r: &Report) -> Vec<String> {
 }
 
 /// A path in the form that the process check compares: `/` separators, no verbatim prefix (`\\?\`,
-/// `\\?\UNC\`), no trailing `/`, and on Windows lower case.
+/// `\\?\UNC\`), no trailing `/`, and lower case on a case-insensitive volume (Windows, and the
+/// default APFS/HFS+ volume of macOS #3173). There a link target or a canonical path that differs
+/// only by case is the same path: the process check must not miss it.
 pub fn norm(s: &str) -> String {
     let s = s.replace('\\', "/");
     let s = match s.strip_prefix("//?/UNC/") {
@@ -245,7 +247,7 @@ pub fn norm(s: &str) -> String {
         None => s.strip_prefix("//?/").unwrap_or(&s).to_string(),
     };
     let s = s.trim_end_matches('/').to_string();
-    if cfg!(windows) { s.to_lowercase() } else { s }
+    if cfg!(windows) || cfg!(target_os = "macos") { s.to_lowercase() } else { s }
 }
 
 /// `p` with `.` and `..` removed by text, as a command line shows a clean path.
diff --git a/xtask/src/unit_sweep_tests.rs b/xtask/src/unit_sweep_tests.rs
index 4cd7384be..7bb0072fd 100644
--- a/xtask/src/unit_sweep_tests.rs
+++ b/xtask/src/unit_sweep_tests.rs
@@ -257,6 +257,42 @@ fn the_sweep_never_reads_or_deletes_through_a_link() {
     let _ = fs::remove_dir_all(&base);
 }
 
+#[test]
+fn a_link_at_the_package_level_is_skipped() {
+    let base = tmp("pkglink");
+    let root = base.join("tree");
+    let start = SystemTime::now();
+    // A real package with one old unit, and a linked package whose target name differs only by case:
+    // on a case-insensitive volume both names are one directory, and the sweep must touch neither
+    // through the link (#3173).
+    let real_pkg = unit(&root, "debug", "camcraft-app", "aaaa", T, start - Duration::from_secs(3600));
+    unit(&root, "debug", "camcraft-app", "bbbb", T, start + Duration::from_secs(5));
+    let build = root.join("target").join("debug").join("build");
+    let linked_pkg = build.join("CamCraft-App");
+    assert!(dir_link(&real_pkg.parent().expect("the package dir"), &linked_pkg), "the test makes the package link");
+    assert!(!plain_dir(&linked_pkg), "a package link is not a plain directory");
+    let units = scan(&root.join("target"));
+    assert!(units.iter().all(|u| !u.dir.starts_with(&linked_pkg)), "the scan does not enter a package link: {units:?}");
+    let r = sweep(&root, start, none);
+    assert!(r.skipped.is_none(), "{r:?}");
+    assert_eq!(r.removed, 1, "only the real old variant is removed: {r:?}");
+    assert!(fs::read_dir(&build).is_ok_and(|mut d| d.count() == 2), "the package link itself stays");
+    let _ = fs::remove_file(&linked_pkg).or_else(|_| fs::remove_dir(&linked_pkg)); // the link only
+    let _ = fs::remove_dir_all(&base);
+}
+
+#[test]
+fn a_path_that_differs_only_by_case_is_one_form_on_a_case_insensitive_volume() {
+    let a = norm("/w/tree/target");
+    let b = norm("/W/Tree/target");
+    // Windows and the default macOS volume fold case; a case-sensitive Unix volume does not.
+    if cfg!(windows) || cfg!(target_os = "macos") {
+        assert_eq!(a, b, "case folding (#3173)");
+    } else {
+        assert_ne!(a, b);
+    }
+}
+
 #[test]
 fn the_sweep_can_be_turned_off_and_reports_failed_deletes_as_warnings() {
     assert!(opted_out(Some("off")) && opted_out(Some("OFF")) && opted_out(Some("0")));

From 7c2abc41cba67f42371b8c80de0c4f8ab067a909 Mon Sep 17 00:00:00 2001
From: tbrasselle <tbrasselle@gmail.com>
Date: Sun, 22 Nov 2026 14:06:40 -0500
Subject: [PATCH 2/4] fix(xtask): make the package-link test create the link on
 Windows too

---
 xtask/src/unit_sweep_tests.rs | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/xtask/src/unit_sweep_tests.rs b/xtask/src/unit_sweep_tests.rs
index 7bb0072fd..8798019df 100644
--- a/xtask/src/unit_sweep_tests.rs
+++ b/xtask/src/unit_sweep_tests.rs
@@ -262,13 +262,15 @@ fn a_link_at_the_package_level_is_skipped() {
     let base = tmp("pkglink");
     let root = base.join("tree");
     let start = SystemTime::now();
-    // A real package with one old unit, and a linked package whose target name differs only by case:
-    // on a case-insensitive volume both names are one directory, and the sweep must touch neither
-    // through the link (#3173).
+    // A real package with one old unit, and a second package that is a link to it: the scan must not
+    // enter the link, the sweep must remove nothing through it, and the link itself must stay (#3173).
     let real_pkg = unit(&root, "debug", "camcraft-app", "aaaa", T, start - Duration::from_secs(3600));
     unit(&root, "debug", "camcraft-app", "bbbb", T, start + Duration::from_secs(5));
     let build = root.join("target").join("debug").join("build");
-    let linked_pkg = build.join("CamCraft-App");
+    // On a case-insensitive volume (Windows, macOS) a link whose name differs only by case from the
+    // real package names the same directory; Windows refuses to create it. macOS allows the
+    // case-variant name, which is the fold of #3173; Windows links another package name instead.
+    let linked_pkg = if cfg!(windows) { build.join("other-app") } else { build.join("CamCraft-App") };
     assert!(dir_link(&real_pkg.parent().expect("the package dir"), &linked_pkg), "the test makes the package link");
     assert!(!plain_dir(&linked_pkg), "a package link is not a plain directory");
     let units = scan(&root.join("target"));
@@ -276,7 +278,7 @@ fn a_link_at_the_package_level_is_skipped() {
     let r = sweep(&root, start, none);
     assert!(r.skipped.is_none(), "{r:?}");
     assert_eq!(r.removed, 1, "only the real old variant is removed: {r:?}");
-    assert!(fs::read_dir(&build).is_ok_and(|mut d| d.count() == 2), "the package link itself stays");
+    assert!(fs::read_dir(&build).is_ok_and(|d| d.count() == 2), "the package link itself stays");
     let _ = fs::remove_file(&linked_pkg).or_else(|_| fs::remove_dir(&linked_pkg)); // the link only
     let _ = fs::remove_dir_all(&base);
 }

