@@ -267,10 +267,11 @@ fn a_link_at_the_package_level_is_skipped() {
     let real_pkg = unit(&root, "debug", "camcraft-app", "aaaa", T, start - Duration::from_secs(3600));
     unit(&root, "debug", "camcraft-app", "bbbb", T, start + Duration::from_secs(5));
