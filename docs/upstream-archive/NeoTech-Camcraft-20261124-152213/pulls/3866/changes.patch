From 3d1564e10ade3f895b3242fc0c4aee0deec19ea3 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 24 Nov 2026 01:33:08 -0800
Subject: [PATCH 3/5] test(2d): count the contour-tabs peck retracts apart from
 the lifts

The tab windows 1 to 3 of the contour-tabs case now peck their dive.
The lift count keeps the lead-out lifts and pins the six peck retracts.

Refs #3678

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/example_catalog.rs        | 12 +++++++++---
 examples/catalog/2d/contour-tabs/README.md |  1 +
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/crates/app/tests/example_catalog.rs b/crates/app/tests/example_catalog.rs
index be58efbcf..e75282013 100644
--- a/crates/app/tests/example_catalog.rs
+++ b/crates/app/tests/example_catalog.rs
@@ -346,9 +346,15 @@ fn contour_tabs_case_posts_the_lead_moves_and_the_tab_lifts() {
     assert_eq!(lead_ins(0.0), 4, "one lead-in arc for each run between two tabs at Z0");
 
     // A lift goes from a cut level to a height above the stock top (Z6).
-    // The block before it is the end of the linear lead-out.
-    let lifts: Vec<usize> =
-        (1..blocks.len()).filter(|&i| blocks[i - 1].1 <= 4.0 && blocks[i].1 > 6.0).collect();
+    // The block before it is the end of the linear lead-out. #3678: a rise
+    // after a G01 that went down is a peck retract, not a lift. Tab windows
+    // 1 to 3 start where the levels above left stock under the disc, so
+    // each dive pecks Z4, Z2, Z0: two retracts each.
+    let rises: Vec<usize> =
+        (2..blocks.len()).filter(|&i| blocks[i - 1].1 <= 4.0 && blocks[i].1 > 6.0).collect();
+    let peck = |i: usize| blocks[i - 1].0 == "G01" && blocks[i - 2].1 > blocks[i - 1].1;
+    let (pecks, lifts): (Vec<usize>, Vec<usize>) = rises.into_iter().partition(|&i| peck(i));
+    assert_eq!(pecks.len(), 6, "tab windows 1 to 3 each peck to Z0 with two retracts");
     assert_eq!(lifts.len(), 6, "two whole rings and four tab runs each end with a lift");
     for &i in &lifts {
         assert_eq!(blocks[i - 1].0, "G01", "the block before lift {i} is the linear lead-out");
diff --git a/examples/catalog/2d/contour-tabs/README.md b/examples/catalog/2d/contour-tabs/README.md
index bf9063b6a..b9094120b 100644
--- a/examples/catalog/2d/contour-tabs/README.md
+++ b/examples/catalog/2d/contour-tabs/README.md
@@ -13,6 +13,7 @@ A 90 x 50 x 6 mm clean-room plate with four 10 mm corner chamfers. One 2D Contou
 
 - In `contour-tabs.nc`, the levels `Z4` and `Z2` each have one `G03` lead-in and one lift.
 - The level `Z0` has four `G03` lead-ins and four lifts. The first three lifts are `G01` moves to the retract height `Z11`. The last lift is the `G00` move to the clearance height `Z21`.
+- The last three `Z0` runs start where the levels above did not cut under the full tool. Each dive there pecks: `G01` to `Z4`, `Z2`, then `Z0`, with a `G00` retract to `Z8` between the pecks.
 - The gap between two `Z0` runs is larger than the tab width plus the tool diameter (14 mm). The tab fit moves the runs apart until the two lead moves leave the full 8 mm of the tab.
 - The outline corners are `G02` arcs of 3 mm radius: the tool centre rolls around each sharp corner of the plate.
 - `build.camscript` sets `lead` with `linear: null`. `add_operation` applies `params` as a merge patch on the seeded linear lead, and a lead holds one shape only (#2876).

