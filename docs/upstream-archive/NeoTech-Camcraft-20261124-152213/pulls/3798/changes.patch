+//! Provenance: issue #3781 provider setup instructions and our structural harness.
+//! Gate map (M4.4): covers ui::egui_app::ai_chat::settings_panel.
+
+use super::*;
+use crate::egui_app::ai_chat::settings::{SettingsAction, SettingsBackend, SettingsRequest};
+
+struct HelpBackend;
+
+impl SettingsBackend for HelpBackend {
+    fn run(&self, _: &SettingsRequest, _: SettingsAction) -> Result<String, String> {
+        Ok("Ready".into())
+    }
+}
+
+#[test]
+fn provider_help_explains_ollama_options_and_gemini_subscription() {
+    let mut h = blank_harness();
+    h.state_mut().state.ai_chat.settings.backend = Arc::new(HelpBackend);
+    h.run_steps(2);
+    toggle_ai_chat_via_view_door(&mut h);
+    select_provider(&mut h, "Offline local (Ollama)");
+    h.get_by_label_contains("Ollama setup").click();
+    h.run_steps(3);
+    for instruction in [
+        "start the server with ollama serve",
+        "curl http://localhost:11434/api/version",
+        "ollama list",
+        "OLLAMA_HOST=127.0.0.1:11500",
+        "OLLAMA_HOST=0.0.0.0:11434",
+        "Anyone on that network can use it",
+        "OLLAMA_CONTEXT_LENGTH=32768",
+        "OLLAMA_KEEP_ALIVE=30m",
+    ] {
+        assert!(
+            h.query_by_label_contains(instruction).is_some(),
+            "missing Ollama setup instruction: {instruction}"
+        );
+    }
+    select_provider(&mut h, "Gemini (Cloud)");
+    h.get_by_label_contains("API key help").click();
+    h.run_steps(3);
+    assert!(
+        h.query_by_label_contains("A Gemini app subscription does not include an API key")
+            .is_some()
+    );
+}
diff --git a/crates/ui/src/egui_app/tests/ai_chat/settings_model.rs b/crates/ui/src/egui_app/tests/ai_chat/settings_model.rs
new file mode 100644
index 000000000..55de73180
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/ai_chat/settings_model.rs
@@ -0,0 +1,220 @@
+//! Provenance: PR #3798 review; count readiness checks during Model edits.
+//! Gate map (M4.4): covers ui::egui_app::ai_chat::settings,
+//! ui::egui_app::ai_chat::settings_panel.
+
+use super::*;
+use crate::egui_app::ai_chat::settings::{
+    Settings, SettingsAction, SettingsBackend, SettingsRequest,
+};
+
+#[derive(Default)]
+struct RecordingSettings {
+    calls: Mutex<Vec<(String, String, &'static str)>>,
+}
+
+impl SettingsBackend for RecordingSettings {
+    fn run(&self, request: &SettingsRequest, action: SettingsAction) -> Result<String, String> {
+        let action = match action {
+            SettingsAction::Check => "check",
+            SettingsAction::Test => "test",
+            SettingsAction::Save(_) => "save",
+            SettingsAction::Remove => "remove",
+        };
+        self.calls.lock().expect("calls").push((
+            request.preset_id.clone(),
+            request.model.clone(),
+            action,
+        ));
+        Ok("Ready".into())
+    }
+}
+
+fn request(preset: &str, model: &str) -> SettingsRequest {
+    SettingsRequest {
+        preset_id: preset.into(),
+        model: model.into(),
+        offline_only: false,
+    }
+}
+
+fn finish(settings: &mut Settings, request: &SettingsRequest, now: Instant) {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while settings.busy() {
+        settings.sync_at(request.clone(), now);
+        assert!(
+            Instant::now() < deadline,
+            "recording backend did not finish"
+        );
+        std::thread::sleep(Duration::from_millis(1));
+    }
+}
+
+#[test]
+fn cloud_model_edits_do_not_read_credentials_again_and_test_uses_latest_model() {
+    for provider in ["anthropic", "openai-chat", "openai-responses", "gemini"] {
+        let backend = Arc::new(RecordingSettings::default());
+        let mut settings = Settings::default();
+        settings.backend = backend.clone();
+        let now = Instant::now();
+        let mut current = request(provider, "old");
+        settings.sync_at(current.clone(), now);
+        finish(&mut settings, &current, now);
+        assert_eq!(backend.calls.lock().expect("calls").len(), 1);
+
+        for model in ["n", "ne", "new"] {
+            current.model = model.into();
+            settings.sync_at(current.clone(), now);
+            finish(&mut settings, &current, now);
+            assert_eq!(backend.calls.lock().expect("calls").len(), 1, "{provider}");
+            assert_eq!(settings.status, "Ready");
+            assert!(!settings.has_work());
+        }
+
+        settings.start(SettingsAction::Test);
+        finish(&mut settings, &current, now);
+        assert_eq!(
+            backend.calls.lock().expect("calls").last(),
+            Some(&(provider.into(), "new".into(), "test"))
+        );
+        current.preset_id = if provider == "openai-chat" {
+            "gemini"
+        } else {
+            "openai-chat"
+        }
+        .into();
+        settings.sync_at(current.clone(), now);
+        finish(&mut settings, &current, now);
+        assert_eq!(backend.calls.lock().expect("calls").len(), 3);
+    }
+}
+
+#[test]
+fn ollama_model_edits_check_once_after_the_last_keystroke_pause() {
+    let backend = Arc::new(RecordingSettings::default());
+    let mut settings = Settings::default();
+    settings.backend = backend.clone();
+    let mut now = Instant::now();
+    let mut current = request("ollama", "old");
+    settings.sync_at(current.clone(), now);
+    finish(&mut settings, &current, now);
+    assert_eq!(backend.calls.lock().expect("calls").len(), 1);
+
+    for model in ["n", "ne", "new"] {
+        now += Duration::from_millis(100);
+        current.model = model.into();
+        settings.sync_at(current.clone(), now);
+        finish(&mut settings, &current, now);
+        assert_eq!(backend.calls.lock().expect("calls").len(), 1);
+        assert!(settings.has_work(), "the queued check must request repaint");
+        assert_eq!(settings.status, "Checking provider...");
+    }
+    settings.sync_at(current.clone(), now + Duration::from_millis(499));
+    finish(&mut settings, &current, now + Duration::from_millis(499));
+    assert_eq!(backend.calls.lock().expect("calls").len(), 1);
+
+    now += Duration::from_millis(500);
+    settings.sync_at(current.clone(), now);
+    finish(&mut settings, &current, now);
+    assert_eq!(
+        *backend.calls.lock().expect("calls"),
+        vec![
+            ("ollama".into(), "old".into(), "check"),
+            ("ollama".into(), "new".into(), "check"),
+        ]
+    );
+    assert_eq!(settings.status, "Ready");
+    assert!(!settings.has_work());
+    settings.sync_at(current.clone(), now + Duration::from_secs(2));
+    assert_eq!(backend.calls.lock().expect("calls").len(), 2);
+}
+
+#[test]
+fn ollama_explicit_test_supersedes_the_queued_model_check() {
+    let backend = Arc::new(RecordingSettings::default());
+    let mut settings = Settings::default();
+    settings.backend = backend.clone();
+    let now = Instant::now();
+    let mut current = request("ollama", "old");
+    settings.sync_at(current.clone(), now);
+    finish(&mut settings, &current, now);
+    current.model = "new".into();
+    settings.sync_at(current.clone(), now);
+    settings.start(SettingsAction::Test);
+    finish(&mut settings, &current, now);
+    settings.sync_at(current.clone(), now + Duration::from_secs(2));
+    finish(&mut settings, &current, now + Duration::from_secs(2));
+    assert_eq!(
+        *backend.calls.lock().expect("calls"),
+        vec![
+            ("ollama".into(), "old".into(), "check"),
+            ("ollama".into(), "new".into(), "test"),
+        ]
+    );
+    assert!(!settings.has_work());
+}
+
+#[test]
+fn ollama_model_edit_hides_the_previous_result_while_the_check_is_queued() {
+    let backend = Arc::new(RecordingSettings::default());
+    let mut settings = Settings::default();
+    settings.backend = backend.clone();
+    let now = Instant::now();
+    let mut current = request("ollama", "old");
+    settings.sync_at(current.clone(), now);
+    current.model = "new".into();
+    settings.sync_at(current.clone(), now);
+    finish(&mut settings, &current, now);
+    assert_eq!(backend.calls.lock().expect("calls").len(), 1);
+    assert_eq!(settings.status, "Checking provider...");
+    assert!(settings.has_work());
+
+    let due = now + Duration::from_millis(500);
+    settings.sync_at(current.clone(), due);
+    finish(&mut settings, &current, due);
+    assert_eq!(settings.status, "Ready");
+    assert_eq!(backend.calls.lock().expect("calls").len(), 2);
+}
+
+#[test]
+fn cloud_model_edit_during_readiness_keeps_one_check_and_reaches_ready() {
+    let backend = Arc::new(RecordingSettings::default());
+    let mut settings = Settings::default();
+    settings.backend = backend.clone();
+    let now = Instant::now();
+    let mut current = request("anthropic", "old");
+    settings.sync_at(current.clone(), now);
+    current.model = "new".into();
+    settings.sync_at(current.clone(), now);
+    finish(&mut settings, &current, now);
+    assert_eq!(backend.calls.lock().expect("calls").len(), 1);
+    assert_eq!(settings.status, "Ready");
+    assert!(!settings.has_work());
+}
+
+#[test]
+fn cloud_model_edit_discards_an_in_flight_test_for_the_previous_model() {
+    let backend = Arc::new(RecordingSettings::default());
+    let mut settings = Settings::default();
+    settings.backend = backend.clone();
+    let now = Instant::now();
+    let mut current = request("anthropic", "old");
+    settings.sync_at(current.clone(), now);
+    finish(&mut settings, &current, now);
+    settings.start(SettingsAction::Test);
+    current.model = "new".into();
+    settings.sync_at(current.clone(), now);
+    finish(&mut settings, &current, now);
+    assert_eq!(backend.calls.lock().expect("calls").len(), 2);
+    assert_eq!(
+        settings.status,
+        "Model changed. Click Test to test this model."
+    );
+    assert!(!settings.has_work());
+    settings.start(SettingsAction::Test);
+    finish(&mut settings, &current, now);
+    assert_eq!(settings.status, "Ready");
+    assert_eq!(
+        backend.calls.lock().expect("calls").last(),
+        Some(&("anthropic".into(), "new".into(), "test"))
+    );
+}
diff --git a/docs/decisions/3781-ai-key-setup.md b/docs/decisions/3781-ai-key-setup.md
index e28367862..7e973df21 100644
--- a/docs/decisions/3781-ai-key-setup.md
+++ b/docs/decisions/3781-ai-key-setup.md
@@ -11,3 +11,19 @@ Explain API keys, provider setup, billing, environment precedence, and OS permis
 **Considered and dropped:** Environment-only setup does not work well for an app started from the Dock. Storing a key in preferences or the project would expose it. Displaying a saved key would create an unnecessary disclosure. Sending cloud requests automatically on provider selection could cause charges without an explicit action. A separate credential store would duplicate the existing platform support.
 
 **Cost to change later:** Provider instructions and links can change without a storage migration. Changing the keychain service or account names requires a migration for existing keys. Changing lookup precedence requires updates to the transport, readiness checks, tests, and guide.
+
+**Review fix scope:** Add the missing Ollama server commands and environment options to the panel and guide. Explain that a Gemini app subscription does not include an API key. Keep the current endpoint limit explicit. Track the live-ai smoke lane in #3803 and the distinct key-rejected status in #3804. Change this PR to reference #3781 because those requirements remain open.
+
+**Why:** The review permits a bounded fix with explicit follow-ups. The live lane needs real provider credentials and fixture tool calls. The rejected-key status needs provider error classification. Neither belongs in the Model edit scheduling fix.
+
+**Considered and dropped:** Do not claim that the full issue is complete or ask for the reporter's hand-test before the live lane runs. Do not add endpoint controls in this fix; #3783 tracks them.
+
+**Cost to change later:** The follow-up work can reuse the existing credential backend and provider transports. Its tests must preserve secret redaction.
+
+**Model edit scheduling:** Use a cloud readiness identity that excludes the model text. For Ollama, wait for a 500 ms pause in Model edits before checking the model.
+
+**Why:** A cloud readiness check reads the credential but does not use the model. Repeating it per character can show repeated OS keychain prompts. Ollama needs the model name, but a short delay avoids an `/api/show` request for each character.
+
+**Considered and dropped:** Per-character validation repeats credential reads and server requests. Checking only when the field loses focus delays feedback while the user stays in the field. A short pause gives feedback without requiring a focus change.
+
+**Cost to change later:** The delay can change without a storage migration. Backend-call-count tests pin cloud reuse and one Ollama check after the edit pause.
