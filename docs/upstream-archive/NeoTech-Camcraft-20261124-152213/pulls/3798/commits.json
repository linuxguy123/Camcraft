  {
    "sha": "cba232f82cafd7490f634ef3611d1e02c4d73a25",
    "node_id": "C_kwDOVoU8JdoAKGNiYTIzMmY4MmNhZmQ3NDkwZjYzNGVmMzYxMWQxZTAyYzRkNzNhMjU",
    "commit": {
      "author": {
        "name": "Mike Kinney",
        "email": "mike.kinney@gmail.com",
        "date": "2026-11-24T05:30:16Z"
      },
      "committer": {
