new file mode 100644
index 000000000..c307e556e
--- /dev/null
+++ b/crates/app/tests/mcp/background_streams.rs
@@ -0,0 +1,166 @@
+//! MCP stream backpressure and output-error regressions from PR #3860.
+//! Provenance: our own stdio protocol tests.
+//! Gate map: covers app::mcp (background, serve).
+
+use camcraft_app::mcp;
+use std::io::{self, BufRead, BufReader, Cursor, Read, Write};
+use std::sync::mpsc::{self, Receiver, Sender};
+use std::time::Duration;
+
+const PING: &[u8] = b"{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"ping\"}\n";
+
+/// Expose exactly one line per buffer and report every consumed line.
+struct CountLines {
+    data: Cursor<Vec<u8>>,
+    consumed: Sender<()>,
+}
+
+impl Read for CountLines {
+    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+        let bytes = self.fill_buf()?;
+        let n = bytes.len().min(out.len());
+        out[..n].copy_from_slice(&bytes[..n]);
+        self.consume(n);
+        Ok(n)
+    }
+}
+
+impl BufRead for CountLines {
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
+        let bytes = self.data.fill_buf()?;
+        Ok(&bytes[..bytes
+            .iter()
+            .position(|&b| b == b'\n')
+            .map_or(bytes.len(), |i| i + 1)])
+    }
+
+    fn consume(&mut self, n: usize) {
+        let line_ended = self
+            .data
+            .fill_buf()
+            .expect("memory input")
+            .get(..n)
+            .is_some_and(|b| b.ends_with(b"\n"));
+        self.data.consume(n);
+        if line_ended {
+            let _ = self.consumed.send(());
+        }
+    }
+}
+
+/// The first response blocks until the client releases it, then fails.
+struct BlockedOutput {
+    entered: Sender<()>,
+    release: Receiver<()>,
+}
+
+impl Write for BlockedOutput {
+    fn write(&mut self, _: &[u8]) -> io::Result<usize> {
+        self.entered.send(()).expect("client waiting for response");
+        self.release.recv().expect("client releases output");
+        Err(io::Error::new(
+            io::ErrorKind::BrokenPipe,
+            "client closed output",
+        ))
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+#[test]
+fn blocked_output_bounds_the_input_queue() {
+    let (consumed_tx, consumed_rx) = mpsc::channel();
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (release_tx, release_rx) = mpsc::channel();
+    let input = CountLines {
+        data: Cursor::new(PING.repeat(1000)),
+        consumed: consumed_tx,
+    };
+    let thread = std::thread::spawn(move || {
+        mcp::serve(
+            input,
+            BlockedOutput {
+                entered: entered_tx,
+                release: release_rx,
+            },
+        )
+    });
+    entered_rx
+        .recv_timeout(Duration::from_secs(10))
+        .expect("first response starts");
+    // One request is being answered, one is queued, and one line waits to send.
+    for _ in 0..3 {
+        consumed_rx
+            .recv_timeout(Duration::from_secs(10))
+            .expect("reader fills its finite budget");
+    }
+    let extra = consumed_rx.recv_timeout(Duration::from_millis(200));
+    release_tx.send(()).expect("release output");
+    let result = thread.join().expect("session thread");
+    assert_eq!(
+        result.expect_err("output fails").kind(),
+        io::ErrorKind::BrokenPipe
+    );
+    assert!(
+        matches!(extra, Err(mpsc::RecvTimeoutError::Timeout)),
+        "reader consumed more than three lines while output was blocked: {extra:?}"
+    );
+}
+
+/// Keep input open after its first request until the test closes the sender.
+struct OpenInput {
+    chunks: Receiver<Vec<u8>>,
+    current: Cursor<Vec<u8>>,
+}
+
+impl Read for OpenInput {
+    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+        if self.current.position() == self.current.get_ref().len() as u64 {
+            self.current = match self.chunks.recv() {
+                Ok(chunk) => Cursor::new(chunk),
+                Err(_) => return Ok(0),
+            };
+        }
+        self.current.read(out)
+    }
+}
+
+#[test]
+fn an_output_error_returns_while_input_remains_open() {
+    let (input_tx, input_rx) = mpsc::channel();
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (release_tx, release_rx) = mpsc::channel();
+    let (done_tx, done_rx) = mpsc::channel();
+    let thread = std::thread::spawn(move || {
+        let input = BufReader::new(OpenInput {
+            chunks: input_rx,
+            current: Cursor::new(Vec::new()),
+        });
+        let result = mcp::serve(
+            input,
+            BlockedOutput {
+                entered: entered_tx,
+                release: release_rx,
+            },
+        );
+        done_tx.send(result).expect("client receives result");
+    });
+    input_tx.send(PING.to_vec()).expect("request");
+    entered_rx
+        .recv_timeout(Duration::from_secs(10))
+        .expect("response starts");
+    release_tx.send(()).expect("fail output");
+    let result = done_rx.recv_timeout(Duration::from_secs(2));
+    // Close input even on failure, so a scoped-reader mutation can exit.
+    drop(input_tx);
+    thread.join().expect("session thread");
+    assert_eq!(
+        result
+            .expect("serve must return before input closes")
+            .expect_err("output fails")
+            .kind(),
+        io::ErrorKind::BrokenPipe
+    );
+}
diff --git a/docs/decisions/3035-mcp-generate-worker.md b/docs/decisions/3035-mcp-generate-worker.md
index 3126fe5eb..702b3d5fa 100644
--- a/docs/decisions/3035-mcp-generate-worker.md
+++ b/docs/decisions/3035-mcp-generate-worker.md
@@ -48,3 +48,36 @@ still blocks other calls.
 **Cost to change later.** Small. The lane is one module,
 `crates/app/src/mcp/background.rs`. A generator cancel flag can be passed
 through the staged job later without a change to the protocol.
+
+
+## PR #3860 review fixes
+
+**What was decided.** A cancelled generate keeps the single worker slot
+until its completion reaches the session. The session drops its result,
+clears its remaining operation queue, and sends no answer. A retry gets
+the busy refusal while that worker runs. The optional `name: null` value
+uses the same background path as an omitted name. Dispatch accepts the
+same non-null request IDs as the synchronous handler, so no accepted ID
+form bypasses the busy check.
+
+The input and completion events share a channel with capacity one. If an
+output response blocks, one input line can wait in the channel and one
+can wait in the reader. This bounds the input memory at the existing line
+size limit. A worker completion cannot make the channel grow.
+
+The reader owns its input with a `Send + 'static` bound. The session does
+not join it after an output error. The output error can therefore return
+while the client keeps input open. A generic blocking reader cannot be
+interrupted. Its thread can remain blocked until another input byte or
+EOF; it retains no session or world and exits when its next send fails.
+
+**Why.** Repeated cancel and retry must not accumulate staged jobs. Input
+must stop reading ahead when the session cannot write. Every accepted
+generate form must obey the worker budget. An output error must not wait
+for an unrelated input event.
+
+**Dropped.** Starting a replacement worker immediately after cancellation
+would leave the old worker outside the budget. An unbounded input queue
+would retain arbitrarily many permitted lines. Joining the input reader
+on an output error would wait for the client to close input. Generator
+cancellation points remain outside this fix.

