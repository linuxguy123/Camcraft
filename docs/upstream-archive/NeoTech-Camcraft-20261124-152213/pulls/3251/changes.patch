+    let open = chamfer_open_runs(std::slice::from_ref(&run), &p, &|_| {
+        Ok(Some(rect(-20.0, -20.0, 20.0, 20.0)))
+    })
+    .expect("legacy open");
+    assert_eq!(
+        feed_xy(&open),
+        vec![
+            Point2::new(-20.0, 20.0),
+            Point2::new(20.0, 20.0),
+            Point2::new(20.0, 22.0),
