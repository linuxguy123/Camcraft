+    let run = vec![Point2::new(-20.0, 20.0), Point2::new(20.0, 20.0)];
+    let open = chamfer_open_runs(&[run], &p, &|_| Ok(Some(rect(-20.0, -20.0, 20.0, 20.0))))
+        .expect("zero open");
+    assert_captured_legacy(open, false);
+}
