+        assert!(
+            why.contains("minimum cone radius") && why.contains(word),
+            "{why}"
+        );
+    }
+    let why = refusal(chamfer(
+        &rect(0.0, 0.0, 4.0, 4.0),
+        &params(3.0, Side::Inside),
+    ));
+    assert!(
+        why.contains("disappears") && why.contains("minimum cone radius"),
+        "{why}"
+    );
+}
