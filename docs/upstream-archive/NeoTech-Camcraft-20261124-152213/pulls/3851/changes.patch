From 5b8b530eadef6f55f9ba2b39979a458cffde4bca Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Tue, 24 Nov 2026 02:44:34 -0500
Subject: [PATCH] test(2d): pin 2D Pocket Outside case of ring-link law

Add a test pin for a 2D Pocket with Outside containment asserting link moves and notes. Document behavior in decision record.

Fixes #3820
---
 .../tests/pass_start_levels/pocket_outside.rs   | 17 ++++++++++++++---
 docs/decisions/3747-in-plane-ring-links.md      |  3 +++
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/crates/motion/tests/pass_start_levels/pocket_outside.rs b/crates/motion/tests/pass_start_levels/pocket_outside.rs
index 60d484f48..ef95f51f9 100644
--- a/crates/motion/tests/pass_start_levels/pocket_outside.rs
+++ b/crates/motion/tests/pass_start_levels/pocket_outside.rs
@@ -1,4 +1,4 @@
-//! #3822: a 2D Pocket with Outside containment is an area round a part
+//! #3820, #3822: a 2D Pocket with Outside containment is an area round a part
 //! (`around_part`), so its rings link by the ring law of #3747 too. The
 //! pins: on both ring strategies of the pocket, no overcut, no crossing
 //! feeds, each lift named, and no lift round a part that splits no ring.
@@ -6,7 +6,7 @@
 
 use super::ring_links::{assert_no_crossing, band, disc_part, dog_bone, lifts, named_lifts, side};
 use super::{box_facets, mask, params, Z};
-use camcraft_motion::cl::Toolpath;
+use camcraft_motion::cl::{MoveKind, Toolpath};
 use camcraft_motion::geo2d::Region;
 use camcraft_motion::links::Link;
 use camcraft_motion::machining2d::{
@@ -29,9 +29,10 @@ fn plan(part: &Region, p: &PocketParams, start: PassStart) -> Toolpath {
     pocket_started_on(&band(part), p, &[], &CornerRelief::default(), &side(start)).expect("plan")
 }
 
-/// #3822 pin: round a disc (the part splits no ring) the Outside-contained
+/// #3820 / #3822 pin: round a disc (the part splits no ring) the Outside-contained
 /// pocket keeps each level on the floor on Inside and Outside, on both
 /// ring strategies: no lift, no re-entry, no overcut, no crossing feed.
+/// Links between pass rings stay in the cut plane as feed moves.
 #[test]
 fn outside_pocket_rings_round_a_disc_do_not_lift() {
     for strategy in STRATEGIES {
@@ -42,6 +43,16 @@ fn outside_pocket_rings_round_a_disc_do_not_lift() {
             eprintln!("{name}: {up} lift(s), {back} re-entry(ies), notes {:?}", path.notes);
             assert_eq!(named_lifts(&path), up, "{name}: a lift with no named reason: {:?}", path.notes);
             assert_eq!((up, back), (0, 0), "{name}: the rings lift: {:?}", path.notes);
+            let floor_feeds = path
+                .moves
+                .iter()
+                .filter(|m| {
+                    m.kind == MoveKind::Feed
+                        && (m.from.z - Z).abs() < 1e-9
+                        && (m.to.z - Z).abs() < 1e-9
+                })
+                .count();
+            assert!(floor_feeds > 0, "{name}: expected planar feed moves on the floor");
             mask("pocket_outside_disc", &band(&disc_part()), &path).assert_no_overcut();
             assert_no_crossing(&name, &path);
         }
diff --git a/docs/decisions/3747-in-plane-ring-links.md b/docs/decisions/3747-in-plane-ring-links.md
index b616d38a1..fa5744af3 100644
--- a/docs/decisions/3747-in-plane-ring-links.md
+++ b/docs/decisions/3747-in-plane-ring-links.md
@@ -44,6 +44,9 @@ stock edge cut began a new pass, and `Retract` lifted there.
 **Scope kept small.**
 - A pocket (`around_part: false`) keeps its join law and pass link byte
   for byte; #3752 moves 2D Pocket Inside and Outside to the shared law.
+  A 2D Pocket with Outside containment (`around_part: true`) takes the
+  ring-link law (#3820, #3822): every in-plane link stays in the certified
+  cutter-centre area or lifts with a named reason.
 - The level link, the entry and the re-entry after a named lift (the
   dead-end ramp, the solid restart) do not change; #3746 owns the entry.
 - No new `Links::RINGS` seed. The ring law lives in the motion layer for
