+++ b/examples/agie/die-pair.camscript
@@ -0,0 +1,28 @@
+// Original CAMCraft example. Run from the project root with a fresh output name.
+cam.call("load_machine", {builtin: "AGIECUT Classic 2S (template)"});
+cam.call("edit_machine", {patch: {edm: {conditions: [{
+  id: "AGIE_QN2", role: "rough", gap: 0.005, wire_diameter: 0.25
+}]}}});
+cam.call("add_tool", {catalog: "EDM-W025"});
+cam.import("examples/agie/die-pair.obj", "plate");
+cam.call("set_stock", {box: {dx: 130, dy: 70, dz: 20}});
+cam.call("set_wcs", {origin: [0, 0, 20]});
+const features = cam.call("list_features", {model: "plate", kinds: ["faces", "chains"]});
+const top = features.faces.find(face => face.facing === "up");
+const holes = top.loops.filter(loop => loop.kind === "hole" && loop.complete);
+for (const op of [{name: "DieL", x: -35.5}, {name: "DieR", x: 24.5}]) {
+  const rim = holes.find(loop => {
+    const edge = features.chains.find(chain => chain.id === loop.chains[0]);
+    return (edge.start[0] < 0) === (op.x < 0);
+  });
+  cam.call("add_operation", {
+    kind: "Wire Contour", name: op.name, source: "plate", tool: "EDM-W025",
+    params: {top_z: 20, bottom_z: 0, side: "die", condition: "AGIE_QN2",
+      start: [op.x, 0], capture: true}
+  });
+  cam.call("set_operation_geometry", {operation: op.name,
+    picks: rim.chains.map(id => ({model: "plate", id: id}))
+  });
+}
+cam.generate();
+cam.post({to: "DUODI20", cps: "Agie native wire EDM", options: {separationLengthMm: 1.0}});
