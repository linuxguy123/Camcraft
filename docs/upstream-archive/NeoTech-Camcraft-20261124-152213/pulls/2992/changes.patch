             CIRCLE_DXF.to_owned(),
         ),
         (script.clone(), CIRCLE_DXF.replace("40\n10\n", "40\n0.4\n")),
-        (script, CIRCLE_DXF.replace("40\n10\n", "40\n9\n")),
+        (
+            script.replace(
+                "cam.post(",
+                "cam.call(\"move_dxf_profile\", {name:\"racetrack\",position:[0,2]});\ncam.post(",
+            ),
+            CIRCLE_DXF.to_owned(),
+        ),
+        (script, CIRCLE_DXF.replace("40\n10\n", "40\n5.99\n")),
+        (
+            CIRCLE_SCRIPT.replace("circle-punch", "racetrack"),
+            CIRCLE_DXF.replace("40\n10\n", "40\n15.01\n"),
+        ),
     ] {
         let dir = tempfile::tempdir().unwrap();
         assert!(!run(dir.path(), &s, &d).status.success());
diff --git a/crates/post/src/agie/round_profile.rs b/crates/post/src/agie/round_profile.rs
index 36a9a3933..20af4e5bb 100644
--- a/crates/post/src/agie/round_profile.rs
+++ b/crates/post/src/agie/round_profile.rs
@@ -57,13 +57,34 @@ pub(super) fn prepare(
         max: std::array::from_fn(|i| max[i].max(entry[i]) + margin),
     };
     let Spine::Stadium(pair) = shape.spine else {
-        // The verified circular separation is a 1 mm arc, with a radial
-        // approach from negative X. The ISO diameter ends are exact lattice points.
-        if radius != 10.0 || entry[1] != a[1] || entry[0] > a[0] - radius - 3. {
-            return Err("Native Agie circles require radius 10 mm and a horizontal radial start at least 3 mm to the left of the circle".into());
+        // A cardinal radial approach and its diameter endpoints are exactly
+        // representable on the ISO grid. The 1 mm bridge subtends 1/R at
+        // every nominal radius; this entire interval leaves more than a
+        // semicircle for the main profile and room for the radial approach.
+        if !(6.0..=15.0).contains(&radius) {
+            return Err("Native Agie circles require a radius between 6 and 15 mm".into());
         }
-        let seam = [grid(a[0] - radius)?, a[1]];
-        let opposite = [grid(a[0] + radius)?, a[1]];
+        let axis = if entry[1] == a[1] {
+            0
+        } else if entry[0] == a[0] {
+            1
+        } else {
+            return Err(
+                "The native Agie start hole must be on an exact horizontal or vertical radius"
+                    .into(),
+            );
+        };
+        let radial = entry[axis] - a[axis];
+        if radial.abs() < radius + 3.0 {
+            return Err(
+                "The Agie threading hole must be at least 3 mm beyond the circular edge".into(),
+            );
+        }
+        let diameter_end = radius * radial.signum();
+        let mut seam = a;
+        let mut opposite = a;
+        seam[axis] = grid(a[axis] + diameter_end)?;
+        opposite[axis] = grid(a[axis] - diameter_end)?;
         return Ok(finish(
             vec![seam, opposite, seam],
             vec![None, Some(a), Some(a)],
diff --git a/crates/post/src/agie/tests.rs b/crates/post/src/agie/tests.rs
index 64bacf38e..a4508f66e 100644
--- a/crates/post/src/agie/tests.rs
+++ b/crates/post/src/agie/tests.rs
@@ -285,3 +285,35 @@ fn a_group_rejects_an_unqualified_height_or_reserved_geometry_alias() {
         assert!(!dir.exists());
     }
 }
+
+#[test]
+fn qualified_circle_radii_and_cardinal_entries_keep_the_exact_diameter() {
+    use camcraft_geometry::{
+        geo2d::Point2,
+        wire_round_profile::{RoundProfile, Spine},
+    };
+    let center = [2.0, -3.0];
+    for radius in [6.0, 8.375, 10.0, 15.0] {
+        for axis in [0, 1] {
+            for sign in [-1.0, 1.0] {
+                let mut job = punch();
+                job.contour.clear();
+                job.round_profile = Some(RoundProfile {
+                    spine: Spine::Circle(Point2::new(center[0], center[1])),
+                    radius,
+                });
+                let mut hole = center;
+                let mut seam = center;
+                let mut opposite = center;
+                hole[axis] += sign * (radius + 7.0);
+                seam[axis] += sign * radius;
+                opposite[axis] -= sign * radius;
+                job.start = Some(hole);
+                let work = Work::prepare(&job, "CIRCLE".into(), 1.0).unwrap();
+                assert_eq!(work.entry, hole);
+                assert_eq!(work.points, [seam, opposite, seam]);
+                assert_eq!(work.arc_centers, [None, Some(center), Some(center)]);
+            }
+        }
+    }
+}
diff --git a/docs/decisions/2022-agie-placed-dxf.md b/docs/decisions/2022-agie-placed-dxf.md
index a1639ddb9..9bdf6b56d 100644
--- a/docs/decisions/2022-agie-placed-dxf.md
+++ b/docs/decisions/2022-agie-placed-dxf.md
@@ -14,10 +14,12 @@ perpendicular straight entry and capture sequence. Keep mixed drawings,
 selected subchains, die openings from sketches and laser
 operations for separate qualification.
 
-Accept an independently qualified single DXF CIRCLE of radius 10 mm. Its
-threading hole lies on the negative-X radial line. The native printer uses
-two semicircles centered on the source drawing and the same 1 mm resident
-separation. On the control each bridge subtended 0.1 radians, with the main
-cut covering the remaining angle. Limit this version to the proven radius and
-entry side. An unrestricted-radius policy would assume more about how the
-controller separates small punches than these readings establish.
+Accept one DXF CIRCLE of radius 6 to 15 mm with a cardinal radial threading
+hole. All diameter endpoints and incremental centers must fit the native grid.
+The control plotted the same 1 mm nominal separation (angle 1/R radians) at
+R6, R10 and R15. At R10, each of the four cardinal threading holes led to the
+same swept circle. The main cut covers the remaining angle and all four passes
+share the original center. A fixture-driven radius bound and a cardinal entry
+give a direct clearance check at all intermediate radii. Retain the stock
+clearance and full hole checks for each actual placement. An oblique hole
+needs an additional grid and lead proof before it can be supported.
diff --git a/docs/user-guide/agie-wire-edm.md b/docs/user-guide/agie-wire-edm.md
index b76b5c60d..59c9d454d 100644
--- a/docs/user-guide/agie-wire-edm.md
+++ b/docs/user-guide/agie-wire-edm.md
@@ -110,13 +110,14 @@ destination named `RACE20`.
 cargo run -p camcraft-app --bin camcraft-cli -- script examples/agie/racetrack.camscript
 ```
 
-A drawing with one DXF `CIRCLE` can also produce a 20 mm punch. The qualified
-circle has a 10 mm radius. Place the 2 mm threading hole on the negative X
-side, at the same Y as the center and at least 3 mm beyond the leftmost edge.
+A drawing with one DXF `CIRCLE` can also produce a 20 mm punch. Use a radius
+from 6 to 15 mm. Place the 2 mm threading hole on a horizontal or vertical
+radius, at least 3 mm beyond the nearest circular edge.
 The native file starts at that edge and defines the circle with two nominal
 semicircles. The control applies the 1 mm separation along the circumference.
 The whole rough wire and threading hole must fit inside the stock.
 
 ```sh
 cargo run -p camcraft-app --bin camcraft-cli -- script examples/agie/circle-punch.camscript
+cargo run -p camcraft-app --bin camcraft-cli -- script examples/agie/north-circle.camscript
 ```
