+        (format!("{program}.SBR"), setup.sbr),
+        (format!("{program}.SBL"), setup.sbl),
+    ];
+    Ok(ExportedJob {
+        files: publish(destination, &files)?,
+        controller_review: setup.controller_review,
+    })
+}
