From ea39d4180e62646a463a9b4fa91e3f5464d95254 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 24 Nov 2026 00:43:14 -0800
Subject: [PATCH 2/2] fix(3d): prove full-disc clearance for pocket restarts

Keep the core plunge law separate from the restart policy. Pin the outer-stock witness independently and regenerate the rough-finish catalog.

Fixes #3670
---
 .../example_catalog/case_3d_rough_finish.rs   |   51 +
 crates/motion/src/machining3d/reentry.rs      |   71 +-
 docs/decisions/3670-pass-hop-entry.md         |   23 +-
 .../3d/rough-finish/rough-finish.camproj      | 2394 +++++++++++++++--
 .../catalog/3d/rough-finish/rough-finish.nc   |  164 +-
 5 files changed, 2471 insertions(+), 232 deletions(-)

diff --git a/crates/app/tests/example_catalog/case_3d_rough_finish.rs b/crates/app/tests/example_catalog/case_3d_rough_finish.rs
index 99d405f2c..81e9493fc 100644
--- a/crates/app/tests/example_catalog/case_3d_rough_finish.rs
+++ b/crates/app/tests/example_catalog/case_3d_rough_finish.rs
@@ -32,4 +32,55 @@ mod catalog_3d_rough_finish {
         let solid = Solid { top: 22.0, footprint: None };
         assert_eq!(first_solid_plunge(&t, 3.0, &solid), None, "a re-entry plunges into uncut stock: {:?}", t.notes);
     }
+
+    /// The review of #3670 found stock outside the core but inside the
+    /// cutter at this point. Read the mesh and previous swept cuts directly;
+    /// do not call the production core or full-disc clearance predicates.
+    #[test]
+    fn pocket_re_entry_keeps_the_outer_stock_clear() {
+        use camcraft_app::{geometry::import::obj, model, operation, project, setup, world};
+        use camcraft_motion::cl::MoveKind;
+        use camcraft_motion::geometry::Point3;
+        let dir = repo("examples/catalog/3d/rough-finish");
+        let witness = Point3::new(-0.138840, -17.8, 10.0);
+        let mesh = obj::parse(&fs::read(dir.join("model/rough-finish.obj")).expect("catalog OBJ")).expect("OBJ mesh");
+        let surface = mesh.facets.iter().filter_map(|t| {
+            let (ux, uy) = (t.b.x - t.a.x, t.b.y - t.a.y);
+            let (vx, vy) = (t.c.x - t.a.x, t.c.y - t.a.y);
+            let (px, py) = (witness.x - t.a.x, witness.y - t.a.y);
+            let det = ux * vy - uy * vx;
+            if det.abs() < 1e-12 { return None; }
+            let (u, v) = ((px * vy - py * vx) / det, (ux * py - uy * px) / det);
+            (u >= -1e-9 && v >= -1e-9 && u + v <= 1.0 + 1e-9)
+                .then_some(t.a.z + u * (t.b.z - t.a.z) + v * (t.c.z - t.a.z))
+        }).reduce(f64::max).expect("mesh surface under witness");
+        assert!((surface - 8.582312).abs() < 1e-5, "surface Z{surface}");
+        assert!(surface < witness.z && witness.z < 22.0, "the witness is stock above the model");
+        let w = world::new_world();
+        let notes = project::load_noted(&w, &dir.join("rough-finish.camproj")).expect("rough-finish project");
+        assert!(notes.is_empty(), "load notes: {notes:?}");
+        let (_, pocket) = setup::operation_order(&w).into_iter().find(|(n, _)| n == "3D Pocket1").expect("pocket");
+        let op = model::operation_of(&w, &pocket).expect("operation");
+        let (path, _) = operation::generate(&w, &op, "3D Pocket1").expect("pocket generates");
+        let mut cleared = false;
+        for (i, m) in path.moves.iter().enumerate().filter(|(_, m)| m.kind != MoveKind::Rapid) {
+            let axial = m.arc.is_none() && (m.from.x - m.to.x).hypot(m.from.y - m.to.y) < 1e-6
+                && m.from.z > witness.z && m.to.z <= witness.z;
+            let reaches = (m.to.x - witness.x).hypot(m.to.y - witness.y) < 3.0;
+            assert!(!axial || !reaches || cleared, "move {i} plunges through outer stock at {witness:?}: {m:?}");
+            // A chord wholly below the witness removes its stock. Shrink
+            // the cutter by more than the chord sagitta to prove coverage.
+            cleared |= m.segments3(0.001).iter().any(|(a, b)| {
+                if a.z.max(b.z) > witness.z { return false; }
+                let (dx, dy) = (b.x - a.x, b.y - a.y);
+                let len2 = dx * dx + dy * dy;
+                let f = if len2 > 0.0 {
+                    (((witness.x - a.x) * dx + (witness.y - a.y) * dy) / len2).clamp(0.0, 1.0)
+                } else { 0.0 };
+                (witness.x - a.x - f * dx).hypot(witness.y - a.y - f * dy) < 2.998
+            });
+        }
+        assert!(cleared, "a cutting entry eventually removes the witness stock");
+    }
+
 }
diff --git a/crates/motion/src/machining3d/reentry.rs b/crates/motion/src/machining3d/reentry.rs
index 475687c9f..8d3473bf1 100644
--- a/crates/motion/src/machining3d/reentry.rs
+++ b/crates/motion/src/machining3d/reentry.rs
@@ -1,6 +1,6 @@
 //! A pass restart inside a 3-D ladder level (#3670): the op's own entry,
-//! the ramp along the pass, or a named plunge, read by the centre-cutting
-//! plunge law (`plunge_law`).
+//! the ramp along the pass, or a named plunge, with a full-disc clearance
+//! proof separate from the non-centre-cutting plunge law (`plunge_law`).
 //!
 //! Provenance: standard CNC entry motions (helix, ramp, plunge) per public
 //! G-code manuals and machining handbooks; the cleared-column test is this
@@ -10,9 +10,42 @@ use super::descent::{Ask, descend, fallback, mat_top, push_zig3, zig_fallback};
 use super::level_ctx::LevelCtx;
 use super::params::Entry3D;
 
-use crate::cl::{MoveKind, PathBuilder};
+use crate::cl::{Move, MoveKind, PathBuilder};
 use crate::geo2d::Point2;
-use crate::plunge_law;
+
+/// A straight cut by this same tool clears its full disc at every point
+/// of its centre line. Require the restart axis on that line, rather
+/// than merely near it (the core law permits an offset of half a radius).
+/// This sufficient proof can miss clearance made by several cuts. That
+/// costs an entry, never a plunge into stock. Arcs do not prove a line:
+/// their tessellation chords can lie outside the actual cleared sweep.
+fn disc_into_solid(moves: &[Move], xy: Point2, z: f64, top: f64) -> bool {
+    if ![xy.x, xy.y, z, top].iter().all(|v| v.is_finite()) {
+        return true;
+    }
+    if z >= top - 1e-6 {
+        return false;
+    }
+    !moves.iter().rev().any(|m| {
+        if m.kind == MoveKind::Rapid
+            || m.arc.is_some()
+            || !m.from.z.is_finite()
+            || !m.to.z.is_finite()
+            || m.from.z.max(m.to.z) > z + 1e-6
+        {
+            return false;
+        }
+        let (ax, ay) = (xy.x - m.from.x, xy.y - m.from.y);
+        let (dx, dy) = (m.to.x - m.from.x, m.to.y - m.from.y);
+        let len2 = dx * dx + dy * dy;
+        let along = ax * dx + ay * dy;
+        // No XY slack: an offset centre line does not contain this disc.
+        // Explicit endpoint equality also covers a stationary plunge.
+        (xy.x == m.from.x && xy.y == m.from.y)
+            || (xy.x == m.to.x && xy.y == m.to.y)
+            || (len2.is_finite() && len2 > 0.0 && along >= 0.0 && along <= len2 && ax * dy == ay * dx)
+    })
+}
 
 /// A pass start inside a level, reached by a hop (#3670): a straight
 /// plunge stands only over a cleared column, or when the user's entry is
@@ -22,8 +55,8 @@ use crate::plunge_law;
 /// plunge into solid itself, else the ramp along the pass, else the
 /// plunge, named. `None`: plunge as before; `Some(dive start)`: posted.
 pub(super) fn reenter(b: &mut PathBuilder, lvl: &LevelCtx, a: &Ask, entry: Entry3D) -> Option<Option<Point2>> {
-    let (r, top) = (lvl.p.tool_diameter * 0.5, mat_top(lvl, a));
-    if !plunge_law::into_solid(b, a.entry, lvl.tip(a.entry, 0.0), top, r) {
+    let top = mat_top(lvl, a);
+    if !disc_into_solid(b.moves(), a.entry, lvl.tip(a.entry, 0.0), top) {
         return None;
     }
     if !lvl.p.links.approach.center_cutting {
@@ -43,7 +76,7 @@ pub(super) fn reenter(b: &mut PathBuilder, lvl: &LevelCtx, a: &Ask, entry: Entry
             && !(n0..mv.len()).any(|i| {
                 let m = &mv[i];
                 m.kind == MoveKind::Plunge
-                    && plunge_law::into_solid_at(&mv[..i], Point2::new(m.to.x, m.to.y), m.to.z, top, r)
+                    && disc_into_solid(&mv[..i], Point2::new(m.to.x, m.to.y), m.to.z, top)
             })
     };
     let mut trial = b.clone();
@@ -64,3 +97,27 @@ pub(super) fn reenter(b: &mut PathBuilder, lvl: &LevelCtx, a: &Ask, entry: Entry
     b.note_once("entry: a pass start inside the level has no room for the entry or a ramp - plunged there");
     None
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geometry::Point3;
+
+    #[test]
+    fn cleared_core_does_not_prove_the_outer_disc_clear() {
+        let cut = Move::new(MoveKind::Feed, Point3::new(-5.0, 0.0, 0.0), Point3::new(5.0, 0.0, 0.0), Some(100.0));
+        let restart = Point2::new(0.0, 1.0);
+        assert!(!crate::plunge_law::into_solid_at(&[cut], restart, 0.0, 2.0, 3.0), "the core law still permits this offset");
+        // (0, 3.5) lies 2.5 mm from the restart axis, but 3.5 mm
+        // from the earlier cut: the outer disc contains uncut stock.
+        assert!(disc_into_solid(&[cut], restart, 0.0, 2.0));
+        assert!(!disc_into_solid(&[cut], Point2::new(0.0, 0.0), 0.0, 2.0));
+    }
+
+    #[test]
+    fn an_arc_chord_does_not_prove_a_cleared_disc() {
+        let arc = Move::new(MoveKind::Feed, Point3::new(-5.0, 0.0, 0.0), Point3::new(5.0, 0.0, 0.0), Some(100.0))
+            .with_arc(Point2::new(0.0, 0.0), true);
+        assert!(disc_into_solid(&[arc], Point2::new(0.0, 0.0), 0.0, 2.0));
+    }
+}
