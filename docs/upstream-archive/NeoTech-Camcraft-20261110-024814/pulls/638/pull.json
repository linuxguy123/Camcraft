  "title": "fix(#622): view-cube pole clicks keep the roll, snapped to the nearest quarter turn",
  "user": {
    "login": "tbrasselle",
    "id": 4564956,
    "node_id": "MDQ6VXNlcjQ1NjQ5NTY=",
    "avatar_url": "https://avatars.githubusercontent.com/u/4564956?v=4",
