diff --git a/crates/motion/src/ring_zig.rs b/crates/motion/src/ring_zig.rs
new file mode 100644
index 000000000..007c4198e
--- /dev/null
+++ b/crates/motion/src/ring_zig.rs
@@ -0,0 +1,135 @@
+//! The ring ramp (#1558): a planned zig-zag ramp flown as helical arcs
+//! about a ring's centre instead of its polygon's chords - only where
+//! the planned prefix provably lies on that ring, in the ring's own
+//! sense, and every arc spans a chord no posted resolution can collapse.
+//! Anything else posts the chords ([`push_zig`]), as before #1558.
+//!
+//! Provenance: our own law over RS-274 / ISO 6983 circular
+//! interpolation (G2/G3 with a Z word is a helix); the full-circle
+//! reading of an arc whose endpoints coincide is the standard's own
+//! (a G2/G3 whose end equals its start is one whole turn). No vendor
+//! material consulted (Clean-Room Protocol).
+
+use std::f64::consts::PI;
+
+use crate::cl::{MoveKind, PathBuilder, lattice};
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::links::push_zig;
+use crate::machining2d::ARC_FIT_TOL;
+
+/// The shortest XY chord an arc move may span, mm. The coarsest
+/// length a shipped post writes is four-decimal inch (2.54 um per
+/// axis); two endpoints whose larger axis difference is at least one
+/// unit can never round to the same point, and a chord of `sqrt(2)`
+/// units (3.6 um) guarantees that. A control reads an arc whose
+/// posted end equals its start as a FULL circle, so anything shorter
+/// is posted straight. 10 um is that bound with margin.
+pub const MIN_ARC_CHORD: f64 = 0.01;
+
+/// How far a planned prefix vertex may stand off the ring, mm: the
+/// 1 um lattice's half-diagonal (0.71 um) plus float noise.
+pub const ON_RING_TOL: f64 = 2e-6;
+
+/// The XY chord of a sweep `phi` on a circle of radius `rho`.
+#[must_use]
+pub fn arc_chord(rho: f64, phi: f64) -> f64 {
+    2.0 * rho * (phi * 0.5).sin().abs()
+}
+
+/// Whether the planned prefix `pre` lies on the ring about `center`
+/// of radius `rho` in the sense `sense` (+1 CCW, -1 CW): every vertex
+/// but the last within [`ON_RING_TOL`] of the circle; the last (cut
+/// part-way along a chord of the ring's polygon) inside it by at most
+/// that polygon's own sagitta ([`ARC_FIT_TOL`]); its first step turning
+/// in `sense`; and the leg's arc end (`a0 + sense * phi`) landing on the
+/// prefix's end within the arc-versus-chord length difference of a
+/// polygon held to [`ARC_FIT_TOL`] (under `2 pi / 3` of it, plus the
+/// sagitta). A non-circular ladder, or a ring flown the wrong way,
+/// fails one of these.
+fn on_ring(pre: &[Point2], center: Point2, rho: f64, sense: f64, end: Point2) -> bool {
+    let r = |p: &Point2| (p.x - center.x).hypot(p.y - center.y);
+    let (Some(first), Some(last)) = (pre.first(), pre.last()) else {
+        return false;
+    };
+    let body = &pre[..pre.len().saturating_sub(1)];
+    if !body.iter().all(|p| (r(p) - rho).abs() <= ON_RING_TOL) {
+        return false;
+    }
+    let rl = r(last);
+    if !(rl <= rho + ON_RING_TOL && rl >= rho - ARC_FIT_TOL - ON_RING_TOL) {
+        return false;
+    }
+    let Some(next) = pre.get(1) else {
+        return false;
+    };
+    let cross = (first.x - center.x) * (next.y - center.y) - (first.y - center.y) * (next.x - center.x);
+    let turn = cross * sense;
+    if turn.is_nan() || turn <= 0.0 {
+        return false;
+    }
+    (end.x - last.x).hypot(end.y - last.y) <= 4.0 * ARC_FIT_TOL
+}
+
+/// [`push_zig`] on a ring (#1558): the same `n` out-and-back legs over
+/// the same travelled length (the chord prefix `pre`'s own, so the ramp
+/// angle is unchanged), flown as helical arcs about `center` - out in
+/// the ring's own sense `ccw`, back against it - instead of the
+/// polygon's chords. Each leg is split into half turns at most (the
+/// helix entry's own pieces). The chords are posted instead - never a
+/// guessed arc - when the ring is degenerate, when `pre` is not on the
+/// ring in that sense ([`on_ring`]: a non-circular ladder can never be
+/// flown as arcs, whatever its flag), or when a piece's chord is under
+/// [`MIN_ARC_CHORD`] (a micro-ramp on a tiny last level, which a post
+/// could round to a full circle).
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn push_zig_ring(
+    b: &mut PathBuilder,
+    pre: &[Point2],
+    center: Point2,
+    ccw: bool,
+    n: usize,
+    z_from: f64,
+    z_to: f64,
+    feed: f64,
+) {
+    let lap: f64 = pre.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum();
+    let total = 2.0 * lap * n as f64;
+    let Some(&e) = pre.first() else {
+        return;
+    };
+    let rho = (e.x - center.x).hypot(e.y - center.y);
+    let phi = lap / rho;
+    if !(total.is_finite() && total > 0.0 && rho.is_finite() && rho > 1e-9 && phi.is_finite() && phi < 2.0 * PI) {
+        push_zig(b, pre, n, z_from, z_to, feed);
+        return;
+    }
+    let pieces = ((phi / PI).ceil() as usize).clamp(1, 2);
+    let step = lap / pieces as f64;
+    let a0 = (e.y - center.y).atan2(e.x - center.x);
+    let sense = if ccw { 1.0 } else { -1.0 };
+    let at_angle = |ang: f64| Point2::new(center.x + rho * ang.cos(), center.y + rho * ang.sin());
+    let end = at_angle(a0 + sense * phi);
+    if !on_ring(pre, center, rho, sense, end) || arc_chord(rho, phi / pieces as f64) < MIN_ARC_CHORD {
+        push_zig(b, pre, n, z_from, z_to, feed);
+        return;
+    }
+    let mut s = 0.0;
+    for k in 0..n {
+        for out in [true, false] {
+            for j in 1..=pieces {
+                s += step;
+                let at = if out { j } else { pieces - j };
+                let last = k + 1 == n && !out && j == pieces;
+                let q = if at == 0 {
+                    e
+                } else {
+                    let p = at_angle(a0 + sense * phi * at as f64 / pieces as f64);
+                    Point2::new(lattice(p.x), lattice(p.y))
+                };
+                let z = if last { z_to } else { z_from - (z_from - z_to) * (s / total) };
+                b.push_arc(MoveKind::Feed, Point3::new(q.x, q.y, z), Some(feed), center, if out { ccw } else { !ccw });
+            }
+        }
+    }
+}
diff --git a/crates/motion/src/ring_zig_tests.rs b/crates/motion/src/ring_zig_tests.rs
new file mode 100644
index 000000000..2a86365b5
--- /dev/null
+++ b/crates/motion/src/ring_zig_tests.rs
@@ -0,0 +1,149 @@
+//! #1558 review pins for the ring ramp ([`crate::ring_zig`]): it rides
+//! arcs only where the planned prefix is on the ring in the ring's own
+//! sense and every arc spans a postable chord; anything else posts the
+//! chords exactly as [`crate::links::push_zig`] does.
+//!
+//! Provenance: our own tests over RS-274 G2/G3 helical interpolation;
+//! no vendor material consulted.
+
+use std::f64::consts::PI;
+
+use crate::cl::{Move, PathBuilder};
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::links::{plan_zig_capped, push_zig};
+use crate::ring_zig::{MIN_ARC_CHORD, arc_chord, push_zig_ring};
+
+const C: Point2 = Point2 { x: 4.0, y: -2.0 };
+
+/// A closed ring polygon of `n` chords on radius `rho` about [`C`],
+/// CCW when `ccw` - the circular kernel's own shape.
+fn ring(rho: f64, n: usize, ccw: bool) -> Vec<Point2> {
+    let s = if ccw { 1.0 } else { -1.0 };
+    (0..=n)
+        .map(|k| {
+            let t = s * 2.0 * PI * k as f64 / n as f64;
+            Point2::new(C.x + rho * t.cos(), C.y + rho * t.sin())
+        })
+        .collect()
+}
+
+fn start(p: Point2, z: f64) -> PathBuilder {
+    PathBuilder::new(Point3::new(p.x, p.y, z))
+}
+
+fn ring_ramp(pre: &[Point2], ccw: bool, n: usize, dz: f64) -> Vec<Move> {
+    let mut b = start(pre[0], 0.0);
+    push_zig_ring(&mut b, pre, C, ccw, n, 0.0, -dz, 100.0);
+    b.finish().moves
+}
+
+fn chord_ramp(pre: &[Point2], n: usize, dz: f64) -> Vec<Move> {
+    let mut b = start(pre[0], 0.0);
+    push_zig(&mut b, pre, n, 0.0, -dz, 100.0);
+    b.finish().moves
+}
+
+/// An arc move's sweep in its own sense, radians in (0, 2 pi].
+fn sweep(m: &Move) -> f64 {
+    let a = m.arc.expect("an arc");
+    let ang = |p: Point3| (p.y - a.center.y).atan2(p.x - a.center.x);
+    let d = ang(m.to) - ang(m.from);
+    let d = if a.ccw { d } else { -d };
+    let d = d.rem_euclid(2.0 * PI);
+    if d <= 0.0 { 2.0 * PI } else { d }
+}
+
+/// On the ring, in its sense: arcs about the centre, each leg's sweep
+/// is the planned leg (lap / rho) and every piece descends at the ramp
+/// angle at most.
+#[test]
+fn an_on_ring_prefix_rides_arcs_at_the_ramp_angle() {
+    for ccw in [true, false] {
+        let rho = 1.0;
+        let path = ring(rho, 32, ccw);
+        let (pre, n) = plan_zig_capped(&path, 1.0, 3.0, 0.0).expect("a plan");
+        let lap: f64 = pre.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum();
+        let moves = ring_ramp(&pre, ccw, n, 1.0);
+        assert!(moves.iter().all(|m| m.arc.is_some()), "ccw {ccw}: all arcs");
+        let tan = 3f64.to_radians().tan();
+        let mut leg = 0.0;
+        let mut legs = 0;
+        let mut out = None;
+        for m in &moves {
+            let a = m.arc.expect("arc");
+            let len = rho * sweep(m);
+            let dz = m.from.z - m.to.z;
+            assert!(dz > 0.0 && dz / len <= tan * (1.0 + 1e-6), "ccw {ccw}: slope {} deg", (dz / len).atan().to_degrees());
+            if out.is_some_and(|o| o != a.ccw) {
+                assert!((leg - lap / rho).abs() < 1e-5, "ccw {ccw}: leg sweep {leg} vs plan {}", lap / rho);
+                leg = 0.0;
+                legs += 1;
+            }
+            out = Some(a.ccw);
+            leg += sweep(m);
+        }
+        assert!((leg - lap / rho).abs() < 1e-5, "ccw {ccw}: last leg {leg}");
+        assert_eq!(legs + 1, 2 * n, "ccw {ccw}: legs");
+    }
+}
+
+/// A ladder that is not this ring - a square corner, or an arc that
+/// runs onto its tangent line before the prefix ends - stays chords,
+/// exactly push_zig's, whatever flag asked for arcs.
+#[test]
+fn a_non_circular_prefix_stays_chords() {
+    let square = vec![
+        Point2::new(C.x + 1.0, C.y),
+        Point2::new(C.x + 1.0, C.y + 1.0),
+        Point2::new(C.x, C.y + 1.0),
+    ];
+    // A quarter arc of R1 (8 chords) then its tangent line onward.
+    let mut bore: Vec<Point2> = ring(1.0, 32, true).into_iter().take(9).collect();
+    bore.push(Point2::new(C.x - 2.0, C.y + 1.0));
+    for path in [square, bore] {
+        let (pre, n) = plan_zig_capped(&path, 1.0, 3.0, 0.0).expect("a plan");
+        let moves = ring_ramp(&pre, true, n, 1.0);
+        assert!(moves.iter().all(|m| m.arc.is_none()), "chords only");
+        assert_eq!(moves, chord_ramp(&pre, n, 1.0), "the chords push_zig posts");
+    }
+}
+
+/// A ring prefix walked in the sense opposite to the arcs asked for is
+/// caught (each leg would fly the long way round): chords.
+#[test]
+fn a_flipped_sense_is_caught() {
+    for ccw in [true, false] {
+        let path = ring(1.0, 32, ccw);
+        let (pre, n) = plan_zig_capped(&path, 1.0, 3.0, 0.0).expect("a plan");
+        let moves = ring_ramp(&pre, !ccw, n, 1.0);
+        assert!(moves.iter().all(|m| m.arc.is_none()), "ccw {ccw}: chords");
+        assert_eq!(moves, chord_ramp(&pre, n, 1.0));
+    }
+}
+
+/// A micro-ramp (a few-micron last level) would fly arcs whose ends a
+/// four-decimal inch post rounds together - a full circle on the
+/// control. Its pieces are under MIN_ARC_CHORD, so it posts chords;
+/// a ramp just over the bound still rides arcs.
+#[test]
+fn a_sub_resolution_ramp_posts_chords() {
+    let path = ring(1.0, 32, true);
+    for dz in [0.0003, 0.0001, 1e-6] {
+        let (pre, n) = plan_zig_capped(&path, dz, 3.0, 0.0).expect("a plan");
+        let lap: f64 = pre.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum();
+        assert!(arc_chord(1.0, lap) < MIN_ARC_CHORD, "dz {dz}: the fixture is sub-resolution");
+        let moves = ring_ramp(&pre, true, n, dz);
+        assert!(moves.iter().all(|m| m.arc.is_none()), "dz {dz}: chords");
+    }
+    let (pre, n) = plan_zig_capped(&path, 0.002, 3.0, 0.0).expect("a plan");
+    let moves = ring_ramp(&pre, true, n, 0.002);
+    assert!(moves.iter().all(|m| m.arc.is_some()), "a 19 um leg rides arcs");
+}
+
+#[test]
+fn min_arc_chord_outlasts_four_decimal_inch() {
+    // One posted unit on each axis: sqrt(2) * 0.0001 in.
+    assert!(MIN_ARC_CHORD >= 2f64.sqrt() * 0.00254);
+    assert!((arc_chord(2.0, PI) - 4.0).abs() < 1e-12);
+}
diff --git a/crates/motion/tests/circular_arcs.rs b/crates/motion/tests/circular_arcs.rs
index 2fa8c0636..074c32f24 100644
--- a/crates/motion/tests/circular_arcs.rs
+++ b/crates/motion/tests/circular_arcs.rs
@@ -7,7 +7,7 @@
 //! Provenance: our own tests over the kernel's circle law (standard
 //! circular interpolation, RS-274 G2/G3); no vendor material consulted.
 //!
-//! Gate map: covers camcraft_motion::machining2d (circular).
+//! Gate map: covers camcraft_motion::machining2d (circular), camcraft_motion::ring_zig.
 
 use camcraft_motion::cl::{Move, MoveKind, Toolpath};
 use camcraft_motion::entry::Entry3D;
@@ -125,3 +125,100 @@ fn the_ramp_rides_the_ring_as_helical_arcs() {
     }
 }
 
+
+/// An arc move's sweep in its own sense, radians in (0, 2 pi].
+fn sweep(m: &Move) -> f64 {
+    let a = m.arc.expect("an arc");
+    let ang = |p: camcraft_motion::geometry::Point3| (p.y - a.center.y).atan2(p.x - a.center.x);
+    let d = if a.ccw { ang(m.to) - ang(m.from) } else { ang(m.from) - ang(m.to) };
+    let d = d.rem_euclid(2.0 * std::f64::consts::PI);
+    if d <= 0.0 { 2.0 * std::f64::consts::PI } else { d }
+}
+
+fn is_ramp(m: &Move) -> bool {
+    m.kind == MoveKind::Feed && m.from.z != m.to.z && (m.from.x != m.to.x || m.from.y != m.to.y)
+}
+
+/// #1558 review: the ring ramp keeps the ramp law. Every helical piece
+/// descends at the ramp angle at most, measured along the arc it flies
+/// (radius times its sweep, in its own sense); each ramp's out and back
+/// legs all sweep the same planned leg (to the endpoint lattice); and the ramp's whole XY travel
+/// is exactly what the angle needs for its drop - so no piece is steep
+/// and none flies the long way round.
+#[test]
+fn the_ring_ramp_holds_the_ramp_angle_on_every_piece() {
+    let tan = camcraft_motion::links::DEFAULT_RAMP_ANGLE.to_radians().tan();
+    for climb in [true, false] {
+        let t = path(&params(Entry3D::Helix, climb));
+        let mut ramps: Vec<Vec<&Move>> = Vec::new();
+        let mut run: Vec<&Move> = Vec::new();
+        for m in &t.moves {
+            if is_ramp(m) {
+                run.push(m);
+            } else if !run.is_empty() {
+                ramps.push(std::mem::take(&mut run));
+            }
+        }
+        if !run.is_empty() {
+            ramps.push(run);
+        }
+        assert!(ramps.len() >= 26, "climb {climb}: {} ramps", ramps.len());
+        for r in &ramps {
+            let (mut xy, mut dz) = (0.0, 0.0);
+            let mut legs: Vec<f64> = Vec::new();
+            let mut sense = None;
+            for m in r {
+                let rho = rad(m, m.from);
+                let len = rho * sweep(m);
+                let d = m.from.z - m.to.z;
+                // 1e-5 mm of XY slack: the endpoint lattice.
+                assert!(d > 0.0 && d <= tan * (len + 1e-5), "climb {climb}: a piece at {:.4} deg", (d / len).atan().to_degrees());
+                let ccw = m.arc.map(|a| a.ccw);
+                if sense != ccw {
+                    legs.push(0.0);
+                    sense = ccw;
+                }
+                if let Some(l) = legs.last_mut() {
+                    *l += len;
+                }
+                xy += len;
+                dz += d;
+            }
+            assert!(legs.len().is_multiple_of(2), "climb {climb}: legs pair out and back: {legs:?}");
+            assert!(legs.iter().all(|l| (l - legs[0]).abs() < 1e-5), "climb {climb}: every leg the planned leg: {legs:?}");
+            assert!((xy * tan - dz).abs() <= 1e-6 * dz.max(1.0), "climb {climb}: travel {xy} for drop {dz}");
+        }
+    }
+}
+
+/// #1558 review: a tiny last level (a few microns: here 0.3 um, then
+/// 3 um, below the 1 mm ladder) never posts an arc whose ends a post
+/// could round together - checked at three-decimal mm and four-decimal
+/// inch, the coarsest lengths the shipped posts write. A control reads
+/// such an arc as a full circle.
+#[test]
+fn no_arc_rounds_to_a_full_circle_on_a_tiny_last_level() {
+    for tail in [0.0003, 0.003] {
+        for entry in [Entry3D::Plunge, Entry3D::Helix, Entry3D::Ramp] {
+            let mut p = params(entry, true);
+            p.bottom_z = -11.508 - tail;
+            let t = path(&p);
+            let arcs: Vec<&Move> = t.moves.iter().filter(|m| m.arc.is_some()).collect();
+            assert!(!arcs.is_empty());
+            for m in arcs {
+                let mm = |v: f64| (v * 1e3).round();
+                let inch = |v: f64| (v / 25.4 * 1e4).round();
+                for (unit, f) in [("mm", &mm as &dyn Fn(f64) -> f64), ("inch", &inch)] {
+                    assert!(
+                        f(m.from.x) != f(m.to.x) || f(m.from.y) != f(m.to.y),
+                        "{entry:?} tail {tail}: an arc {:?} -> {:?} posts as a full circle in {unit}",
+                        m.from,
+                        m.to
+                    );
+                }
+                let c = (m.to.x - m.from.x).hypot(m.to.y - m.from.y);
+                assert!(c >= camcraft_motion::ring_zig::MIN_ARC_CHORD, "{entry:?} tail {tail}: chord {c}");
+            }
+        }
+    }
+}
