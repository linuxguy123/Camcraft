+fn pass_spans(path: &Toolpath) -> Vec<&[camcraft_motion::cl::Move]> {
+    let at: Vec<usize> = path
+        .moves
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| m.kind == MoveKind::Feed && m.arc.is_none())
+        .map(|(i, _)| i)
+        .collect();
+    let len = match at.as_slice() {
+        [a, b, ..] => b - a - 1,
+        _ => 0,
+    };
+    at.iter().filter_map(|&i| path.moves.get(i..i + len)).collect()
