From 9a40e703c781896fa6be336ed71e3fc072f13f4c Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Tue, 17 Nov 2026 00:00:06 +0100
Subject: [PATCH] test(app): give stock_in_vise_sim its LocateSpec body

LocateSpec gained a required body field in #2184. The stock_in_vise_sim
test literal still used the old shape, so main did not compile its
tests (post-merge run 43970156626). The test mates the part's faces, so
it keeps the default LocateBody::Part.

Changelog: none
Fixes #2297
Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 crates/app/tests/stock_in_vise_sim.rs         |  2 +-
 .../2297-main-tests-locatespec-body.md        | 20 +++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/2297-main-tests-locatespec-body.md

diff --git a/crates/app/tests/stock_in_vise_sim.rs b/crates/app/tests/stock_in_vise_sim.rs
index 812fc84e1..6e6ecc999 100644
--- a/crates/app/tests/stock_in_vise_sim.rs
+++ b/crates/app/tests/stock_in_vise_sim.rs
@@ -100,7 +100,7 @@ fn located(rot: [f64; 4]) -> (World, History) {
         Mate { part: face(&world, "part", [10.0, 0.0, 4.0]), fixture: face(&world, "vise", [50.0, -1.0, 20.25]) },
         Mate { part: face(&world, "part", [0.0, 5.0, 4.0]), fixture: face(&world, "vise", [-1.0, 30.0, 15.25]) },
     ];
-    let spec = LocateSpec { part: "part".into(), fixture: "vise".into(), mates, offset: LocateOffset::default() };
+    let spec = LocateSpec { part: "part".into(), fixture: "vise".into(), body: Default::default(), mates, offset: LocateOffset::default() };
     h.execute(&world, LocatePart::new(&world, &spec).expect("locate"));
     (world, h)
 }
diff --git a/docs/decisions/2297-main-tests-locatespec-body.md b/docs/decisions/2297-main-tests-locatespec-body.md
new file mode 100644
index 000000000..b2e49843f
--- /dev/null
+++ b/docs/decisions/2297-main-tests-locatespec-body.md
@@ -0,0 +1,20 @@
+# 2297: give the stock-in-vise test its LocateSpec body
+
+## Decision
+
+`crates/app/tests/stock_in_vise_sim.rs` sets `body: Default::default()`
+(`LocateBody::Part`) in its `LocateSpec` literal.
+
+## Why
+
+The test's mates pick faces on the entity `part`. `LocateBody::Stock`
+would refuse them: `plan` checks that each mate's part is on the held
+body and refuses other entities by name. The part mates are the right
+input for this test. The stock follows the part (the one stock-follows
+law), so the test still runs on a stock in the vise.
+
+## Dropped
+
+- `LocateBody::Stock` with stock faces as mates. That changes what the
+  test asserts (the #2177 turn and simulation checks), so it is a new
+  test, not this fix.
