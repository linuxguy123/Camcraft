+    // The wall dive this law replaces had no arcs at all.
+    let base = slot(a, b, &SlotParams { entry: Entry3D::Plunge, ..p }).expect("valid");
+    assert_eq!(base.moves.iter().filter(|m| m.arc.is_some()).count(), 0);
