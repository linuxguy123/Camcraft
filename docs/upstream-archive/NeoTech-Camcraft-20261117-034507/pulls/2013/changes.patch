From d6a1b8c03442fc63535f70bc7ebcac84904d39a4 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 16 Nov 2026 08:25:07 +0100
Subject: [PATCH 13/20] test(app): drop the Top Z air level from the round 8
 expectations

The 18 red app tests after round 7 each expected the old air level at
Top Z. Each one is class (a): the expectation is updated with a comment,
and no check is loosened. The two wrong-side contour refusals stay
refused and now assert the #1927 named text. The wall-arc entry tests
gain an assert that no entry rapids below the stock top.

Fixes #2004

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/operations.rs            | 23 ++++++----
 crates/app/tests/predrilled_entry.rs      | 13 ++++--
 crates/app/tests/project_roundtrip.rs     |  9 +++-
 crates/app/tests/remachining.rs           | 18 +++++---
 crates/app/tests/stitch_cross.rs          |  9 +++-
 crates/app/tests/turning_face_approach.rs |  8 +++-
 crates/app/tests/turning_face_seed.rs     |  5 ++-
 crates/app/tests/wall_arc_entry.rs        | 53 ++++++++++++++---------
 docs/decisions/2004-top-z-level.md        | 16 +++++++
 9 files changed, 111 insertions(+), 43 deletions(-)

diff --git a/crates/app/tests/operations.rs b/crates/app/tests/operations.rs
index 0338383ab..8671a76ae 100644
--- a/crates/app/tests/operations.rs
+++ b/crates/app/tests/operations.rs
@@ -2233,9 +2233,10 @@ fn an_open_run_contours_on_its_air_side() {
     };
     let ends = [off(a), off(b)];
     let near = |x: f64, y: f64, e: (f64, f64)| (x - e.0).hypot(y - e.1) < 1e-6;
-    // contour_params: 5.0 -> 0.0 at 2.5 - three levels, one plunge each,
-    // Lead::None so the plunge lands exactly on the offset start.
-    let levels = [5.0, 2.5, 0.0];
+    // contour_params: 5.0 -> 0.0 at 2.5 - two levels, one plunge each,
+    // Lead::None so the plunge lands exactly on the offset start. #2004:
+    // Top Z 5 is the part top (no stock), so the air level at Z 5 is gone.
+    let levels = [2.5, 0.0];
     let plunges: Vec<_> = path
         .moves
         .iter()
@@ -2650,8 +2651,9 @@ fn a_mixed_pick_list_cuts_boundary_then_run_and_says_what_overlap_means() {
             .iter()
             .filter(|m| m.kind == MoveKind::Plunge)
             .count(),
-        6,
-        "three levels of boundary, three of run"
+        // #2004: Top Z 5 is the part top (no stock): no air level there.
+        4,
+        "two levels of boundary, two of run"
     );
     // The run's edge lies on the face's own wall. Before #1777 the cutter
     // rode the edge on its centre and half-cut the finished boundary; now
@@ -3552,12 +3554,17 @@ fn contour_outside_forces_outside_on_bore() {
     // The explicit Outside stands as asked - and on a bore it puts the
     // Ø6 cutter on the ring at r 15, IN the plate around the Ø24 bore:
     // the old path cut that groove silently. The part-solid depth law
-    // refuses it by name instead (the silent-gouge fix).
+    // refuses it by name instead (the silent-gouge fix). #2004: with no
+    // air level at Top Z the ring walks no level, and the picked-ring
+    // law (#1927) now speaks first: the same refusal, with the side
+    // named as the cause and Inside advised - the right advice on a bore.
     let err = GenerateOperation::new(&world, "BoreO")
         .err()
         .expect("an Outside ring around a bore stands in the plate - refused");
-    assert!(err.to_string().contains("cuts into the part"), "{err}");
-    assert!(err.to_string().contains("not walked at any level"), "{err}");
+    let err = err.to_string();
+    assert!(err.contains("meets its wall at no level below the part top"), "{err}");
+    assert!(err.contains("the cutter Outside this ring stands in the part material"), "{err}");
+    assert!(err.contains("set Side to Inside"), "{err}");
 }
 
 #[test]
diff --git a/crates/app/tests/predrilled_entry.rs b/crates/app/tests/predrilled_entry.rs
index 3b200c48c..916069119 100644
--- a/crates/app/tests/predrilled_entry.rs
+++ b/crates/app/tests/predrilled_entry.rs
@@ -197,8 +197,10 @@ fn noted(t: &Toolpath, s: &str) -> bool {
 fn a_drilled_hole_ahead_is_plunged_to_full_depth_and_posted() {
     // DR-0600 to Z 5: its point is full Ø6 by Z 6.8, far under the floor.
     let (world, _h, t) = job(Some((5.0, 3.0, "DR-0600")), true);
-    assert_eq!(centre_plunges(&t), vec![TOP, 16.0, FLOOR], "{:?}", t.notes);
-    assert!([TOP, 16.0, FLOOR].iter().all(|&z| first_entry_is_plunge(&t, z)));
+    // #2004: the stock top is TOP, so the ladder starts one stepdown
+    // under it (16, then the floor 12); the air level at TOP is gone.
+    assert_eq!(centre_plunges(&t), vec![16.0, FLOOR], "{:?}", t.notes);
+    assert!([16.0, FLOOR].iter().all(|&z| first_entry_is_plunge(&t, z)));
     assert_eq!(helix_moves(&t), 0, "no helix where the hole serves: {:?}", t.notes);
     assert!(noted(&t, "down the pre-drilled hole at (0.000, 0.000)"), "{:?}", t.notes);
     let nc = std::env::temp_dir().join(format!("camcraft-predrilled-{}.nc", std::process::id()));
@@ -247,7 +249,12 @@ fn a_shallow_hole_serves_only_the_levels_it_reaches() {
     // Tip at Z 14: full Ø4.2 only above 14 + 2.1 x cot(59) = 15.26 -
     // the Z 16 level plunges, the floor level helixes, said with numbers.
     let (_w, _h, t) = job(Some((14.0, 3.0, "DR-0600")), true);
-    assert!(first_entry_is_plunge(&t, TOP) && first_entry_is_plunge(&t, 16.0));
+    // #2004: no level at TOP (the stock top); Z 16 is the first level.
+    assert!(first_entry_is_plunge(&t, 16.0));
+    assert!(
+        !t.moves.iter().any(|m| m.kind != MoveKind::Rapid && m.to.z < m.from.z && (m.to.z - TOP).abs() < 1e-9),
+        "no descent onto an air level at TOP"
+    );
     assert!(!first_entry_is_plunge(&t, FLOOR), "the floor level is entered by its helix");
     assert!(helix_moves(&t) > 0);
     assert!(t.moves.iter().filter(|m| m.arc.is_some() && m.to.z < m.from.z).all(|m| m.from.z <= 16.0 + 1e-9));
