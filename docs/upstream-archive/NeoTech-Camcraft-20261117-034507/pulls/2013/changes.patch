+            seg_dist(*q, (0.0, 0.0), (40.0, 0.0)) <= 7.0 + 1e-9,
+            "center left the area: {q:?}"
+        );
+    }
+    let max_x = pts.iter().map(|q| q.0).fold(f64::NEG_INFINITY, f64::max);
+    let min_x = pts.iter().map(|q| q.0).fold(f64::INFINITY, f64::min);
+    assert_eq!(max_x, 40.0 + s48);
