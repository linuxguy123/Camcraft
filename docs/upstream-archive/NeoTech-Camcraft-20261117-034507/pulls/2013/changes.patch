-fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Region {
-    Region::new(vec![Loop::new(vec![
-        Point2::new(x0, y0),
-        Point2::new(x1, y0),
-        Point2::new(x1, y1),
-        Point2::new(x0, y1),
-    ])
-    .unwrap()])
-    .unwrap()
-}
