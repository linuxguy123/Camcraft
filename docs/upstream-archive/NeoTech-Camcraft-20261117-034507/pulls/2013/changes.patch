+}
+
+#[test]
+fn blended_facing_is_deterministic() {
+    let a = face(&rect(0.0, 0.0, 33.3, 27.1), &p(7.0, true)).unwrap();
+    let b = face(&rect(0.0, 0.0, 33.3, 27.1), &p(7.0, true)).unwrap();
+    assert_eq!(a, b);
+}
