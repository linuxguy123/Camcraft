-    for (z, _) in &planar {
-        if seen.iter().any(|s| (s - z).abs() <= 1e-9) {
-            continue;
-        }
-        seen.push(*z);
-        let level: Vec<f64> = planar.iter().filter(|(lz, _)| (lz - z).abs() <= 1e-9).map(|(_, y)| *y).collect();
