+    assert_eq!(t.arc_count(), 1);
+    assert!(t.notes.is_empty(), "{:?}", t.notes);
+}
+
+#[test]
+fn one_row_has_no_turn_and_no_note() {
+    let t = face(&rect(0.0, 0.0, 40.0, 6.0), &p(8.0, true)).unwrap();
