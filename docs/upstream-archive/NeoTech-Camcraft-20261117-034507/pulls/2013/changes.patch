+    assert!(!t.has_arcs());
+    assert_eq!(t.notes.len(), 1, "{:?}", t.notes);
+    assert!(t.notes[0].contains("resolution"));
+    // Just above the floor, the same snap row blends.
+    let tall = 10.0 + 2.0 * MIN_BLEND_RADIUS + 0.001;
