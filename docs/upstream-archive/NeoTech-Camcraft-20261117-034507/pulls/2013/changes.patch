+#[test]
+fn the_rapids_stand_clear_of_the_whirl() {
+    let got = rotary_offset(&lathe_bar(16), &params(28.0, 0.0), &control(0.0, 0.0, None)).unwrap();
+    // Wrap clearance = rho_max + stepdown + r = 4.5 of plan height,
