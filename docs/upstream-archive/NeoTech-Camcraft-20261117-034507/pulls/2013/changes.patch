+    assert!(mid.contains(Point2::new(0.0, 0.0)), "the boss fills -5.0");
+    assert!(!mid.contains(Point2::new(15.0, 0.0)), "the slab top is at -10");
+    assert!(deep.contains(Point2::new(15.0, 0.0)), "and below it all is solid");
