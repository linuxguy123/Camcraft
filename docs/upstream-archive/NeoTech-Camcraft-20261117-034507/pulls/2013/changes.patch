+    let t = slot(a, b, &p).expect("valid"); // h = 7: rows -7, -3, 1, 5, 7
+    let (s40, s48, s24) = (40f64.sqrt(), 48f64.sqrt(), 24f64.sqrt());
+    let want = vec![
+        (0.0, -7.0),
+        (40.0, -7.0),
