+#[test]
+fn trace_is_deterministic() {
+    let r = rect(0.0, 0.0, 10.0, 10.0);
+    let a = trace(&r, &tp()).unwrap();
+    let b = trace(&r, &tp()).unwrap();
+    assert_eq!(a, b);
+    assert!(a.is_chained() && a.all_finite());
+}
