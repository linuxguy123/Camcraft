+/// `Ok`, or an `Err` that names itself: the only two answers allowed.
+trait Named {
+    fn is_ok_or_named(&self) -> bool;
+}
+impl Named for Result<ArcLead, &'static str> {
+    fn is_ok_or_named(&self) -> bool {
+        match self {
+            Ok(l) => l.fan.len() <= ARC_ENTRY_MAX_CHORDS,
+            Err(why) => why.starts_with("the arc"),
+        }
+    }
+}
