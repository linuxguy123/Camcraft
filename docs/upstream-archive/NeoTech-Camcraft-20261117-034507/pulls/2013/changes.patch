-fn params() -> FaceParams {
-    FaceParams { holes: Default::default(),
-        tool_diameter: 10.0,
-        stepover: 5.0,
-        clearance_z: 5.0,
-        cut_z: 2.0,
-        top_z: None,
-        stepdown: None,
-        feed: 500.0,
-        plunge_feed: 100.0,
-        climb: true,
-        blend_turns: false,
-    }
-}
