+pub(super) type Handler = fn(&mut Env, &Map<String, Value>) -> Result<Value, String>;
+
+pub(super) struct Tool {
+    pub(super) name: &'static str,
+    pub(super) description: &'static str,
+    pub(super) schema: fn() -> Value,
+    pub(super) run: Handler,
+}
