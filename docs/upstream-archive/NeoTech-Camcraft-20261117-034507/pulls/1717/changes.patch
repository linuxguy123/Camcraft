-
-/// The quarter turns, two rows of three: (label, world axis, sign).
-const TURNS: [[(&str, usize, f64); 3]; 2] = [
-    [("Turn X+", 0, 1.0), ("Turn Y+", 1, 1.0), ("Turn Z+", 2, 1.0)],
-    [("Turn X-", 0, -1.0), ("Turn Y-", 1, -1.0), ("Turn Z-", 2, -1.0)],
