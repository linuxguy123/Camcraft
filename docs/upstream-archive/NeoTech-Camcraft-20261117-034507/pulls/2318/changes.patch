From c39e6504303b350ca541476df266a07aede0204f Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Tue, 17 Nov 2026 02:58:49 +0100
Subject: [PATCH] fix(post): find the repository assets under the new cargo
 build-dir layout

The post-merge runner's cargo puts test executables in
target/<profile>/build/<pkg>/<hash>/out and has no
target/<profile>/.fingerprint. cargo_profile_dir then returned None, so
the data folder lookup tried only <exe dir>/assets/<kind> and about 200
test binaries failed with "no posts folder found" (run 43990986558).

cargo_profile_dir now also accepts the new layout: an exe in a unit
"out" folder maps to its profile folder, and a profile folder that holds
build/camcraft-post is a cargo build tree. An installed exe is still
refused by name.

Fixes #2316

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/post/src/data_dir.rs                | 31 ++++++++++++++++------
 crates/post/src/data_dir_tests.rs          | 26 ++++++++++++++++++
 docs/decisions/2316-data-dir-new-layout.md | 27 +++++++++++++++++++
 3 files changed, 76 insertions(+), 8 deletions(-)
 create mode 100644 docs/decisions/2316-data-dir-new-layout.md

diff --git a/crates/post/src/data_dir.rs b/crates/post/src/data_dir.rs
index 5828192f3..652372c46 100644
--- a/crates/post/src/data_dir.rs
+++ b/crates/post/src/data_dir.rs
@@ -11,13 +11,13 @@
 //! 1. `<exe dir>/assets/<kind>` - the zip, the installer, the Linux
 //!    tarball, deb/rpm (`/usr/lib/camcraft`), AppImage, flatpak, snap;
 //! 2. `<app>/Contents/Resources/assets/<kind>` - the macOS app bundle;
-//! 3. `<exe dir>/../../assets/<kind>` - a dev run from `target/<profile>/`;
+//! 3. `<profile>/../../assets/<kind>` - a dev run from `target/<profile>/`;
 //! 4. `<this crate>/../../assets/<kind>` - the source tree, for the test
 //!    binaries in `target/*/deps/` (a path, not a compiled-in copy).
 //!
 //! Candidates 3 and 4 apply only when the exe is in a cargo build tree
-//! (its folder, or the folder above `deps`/`examples`, holds cargo's
-//! `.fingerprint`). An installed exe without its `assets/<kind>` folder
+//! of the old or the new cargo build-dir layout ([`cargo_profile_dir`]).
+//! An installed exe without its `assets/<kind>` folder
 //! is refused by name: it never reads the build machine's checkout, nor
 //! `/usr/assets` or `C:\assets`. There is no per-user copy: it could
 //! shadow the shipped files with no warning (review of #2293).
@@ -38,15 +38,30 @@ use std::sync::{Arc, Mutex};
 /// post script is far below it.
 pub const MAX_BYTES: u64 = 4 * 1024 * 1024;
 
-/// The profile folder of a cargo build tree that holds `exe_dir`
-/// (`target/<profile>`, or its `deps` / `examples` child), known by
-/// cargo's `.fingerprint` folder in it. `None` for an installed exe.
+/// The profile folder of a cargo build tree that holds `exe_dir`, or
+/// `None` for an installed exe. Cargo has two layouts (#2316):
+///
+/// - old: the exe is in `target/<profile>` or its `deps` / `examples`
+///   child, and the profile folder holds cargo's `.fingerprint`;
+/// - new build-dir layout: a test or example exe is in
+///   `target/<profile>/build/<pkg>/<hash>/out`, the uplifted binaries
+///   stay in `target/<profile>`, and there is no `.fingerprint` there.
+///   The profile folder then holds `build/camcraft-post`, the unit folder
+///   of this crate, which every exe that reads data files links.
 pub fn cargo_profile_dir<'a>(exe_dir: &'a Path, is_dir: &dyn Fn(&Path) -> bool) -> Option<&'a Path> {
-    let profile = match exe_dir.file_name().and_then(std::ffi::OsStr::to_str) {
+    let name = |p: &Path| p.file_name().and_then(std::ffi::OsStr::to_str).map(str::to_owned);
+    let profile = match name(exe_dir).as_deref() {
         Some("deps" | "examples") => exe_dir.parent()?,
+        Some("out") => {
+            // out -> <hash> -> <pkg> -> build -> <profile>
+            let build = exe_dir.parent()?.parent()?.parent()?;
+            if name(build).as_deref() == Some("build") { build.parent()? } else { exe_dir }
+        }
         _ => exe_dir,
     };
-    is_dir(&profile.join(".fingerprint")).then_some(profile)
+    let in_tree =
+        is_dir(&profile.join(".fingerprint")) || is_dir(&profile.join("build").join(env!("CARGO_PKG_NAME")));
+    in_tree.then_some(profile)
 }
 
 /// The directory candidates for one kind (`posts`, `machines`) in
diff --git a/crates/post/src/data_dir_tests.rs b/crates/post/src/data_dir_tests.rs
index ef50eca4c..a67b8685a 100644
--- a/crates/post/src/data_dir_tests.rs
+++ b/crates/post/src/data_dir_tests.rs
@@ -40,6 +40,32 @@ fn the_order_is_exe_dev_manifest_in_a_cargo_tree() {
     assert_eq!(got.last(), Some(&p("/src/camcraft/assets/posts")), "a test binary in deps/ finds the source tree");
 }
 
+/// #2316: the new cargo build-dir layout (the post-merge runner's cargo)
+/// puts a test exe in `target/<profile>/build/<pkg>/<hash>/out` and has
+/// no `target/<profile>/.fingerprint`. The test exes and the uplifted
+/// binaries still find the repository assets; nothing else is let in.
+#[test]
+fn the_new_cargo_build_dir_layout_finds_the_repository_assets() {
+    let tree = dirs(&["/opt/cc/target/debug/build/camcraft-post", "/opt/cc/assets/posts"]);
+    for exe in [
+        "/opt/cc/target/debug/build/camcraft-app/022e328e1d2fcaa4/out/posting-022e328e1d2fcaa4",
+        "/opt/cc/target/debug/build/camcraft-post/4d4a6b2fbedf41a7/out/camcraft_post-4d4a6b2fbedf41a7",
+        "/opt/cc/target/debug/camcraft-cli",
+    ] {
+        let exe = p(exe);
+        let got = candidates("posts", Some(&exe), Some(&p(MANIFEST)), &tree);
+        assert_eq!(got[1..], [p("/opt/cc/assets/posts"), p("/src/camcraft/assets/posts")], "{}", exe.display());
+        assert_eq!(resolve("posts", Some(&exe), Some(&p(MANIFEST)), &tree), Ok(p("/opt/cc/assets/posts")));
+    }
+    // An exe in an `out` folder that is not a cargo unit folder stays an
+    // installed exe: only the folder beside it.
+    let stray = p("/opt/app/build/x/y/out/camcraft-ui");
+    let elsewhere = dirs(&["/opt/assets/posts", "/src/camcraft/assets/posts"]);
+    assert_eq!(candidates("posts", Some(&stray), Some(&p(MANIFEST)), &elsewhere).len(), 1);
+    let why = resolve("posts", Some(&stray), Some(&p(MANIFEST)), elsewhere).expect_err("not a cargo tree");
+    assert!(why.starts_with("no posts folder found"), "{why}");
+}
+
 /// Review of #2293: an installed exe never falls back to the build
 /// machine's checkout or to `<exe>/../../assets` (`/usr/assets`, `C:/assets`).
 #[test]
diff --git a/docs/decisions/2316-data-dir-new-layout.md b/docs/decisions/2316-data-dir-new-layout.md
new file mode 100644
index 000000000..83768298d
--- /dev/null
+++ b/docs/decisions/2316-data-dir-new-layout.md
@@ -0,0 +1,27 @@
+## #2316 - The data folder lookup knows the new cargo build-dir layout
+
+**Decided:** `camcraft_post::data_dir::cargo_profile_dir` accepts two
+layouts. The old one: the exe is in `target/<profile>` or its
+`deps` / `examples` child, and the profile folder holds `.fingerprint`. The
+new build-dir layout: a test exe is in
+`target/<profile>/build/<pkg>/<hash>/out`, and the profile folder holds
+`build/camcraft-post` (the unit folder of this crate, which every exe that
+reads data files links). The uplifted binaries in `target/<profile>` are
+known by the same `build/camcraft-post` marker.
+
+**Why:** the post-merge runner's cargo uses the new layout. There the test
+exes are in `.../out/` and `target/debug/.fingerprint` does not exist, so
+the lookup tried only `<exe dir>/assets/<kind>` and about 200 test binaries
+failed (run 43990986558). The local cargo (1.99.0) still uses the old
+layout, so Windows worktrees passed.
+
+**Dropped:**
+- An env var (`CARGO_MANIFEST_DIR` at run time): the gate runs some test
+  exes outside cargo, and an installed exe must never read it.
+- A compiled-in copy of the assets for tests: #2293 removed it by intent.
+- Any marker that an installed folder can hold by chance (a bare `build`
+  folder): the review of #2293 requires that an installed exe never reads
+  the build machine's checkout.
+
+**Cost to change:** one function and its tests in `crates/post/src/data_dir.rs`.
+If cargo changes its layout again, add the new shape there.
