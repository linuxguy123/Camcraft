  "title": "fix(motion): hold the crossing law on corner arcs one corner at a time",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
