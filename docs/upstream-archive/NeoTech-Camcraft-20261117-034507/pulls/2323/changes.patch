+
+/// Where an arc of a rounded walk came from, when it is not an arc of
+/// the walk handed in: the corner it rounds, or the end its arc had
+/// before a corner arc trimmed it.
+pub(super) enum Source {
+    Corner(Point2),
+    Trimmed(Point2),
