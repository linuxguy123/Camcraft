+    let (first, last) = first_last(&t);
+    assert!(outside(first, 35.0) >= R, "the first pass starts in the stock: {first:?}");
+    assert!((outside(last, 15.0) - R).abs() < 0.05, "the level ends off the part wall: {last:?}");
+}
+
+#[test]
