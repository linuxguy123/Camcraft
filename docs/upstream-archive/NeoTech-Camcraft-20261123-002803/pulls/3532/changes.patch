diff --git a/crates/gpu/src/cut.rs b/crates/gpu/src/cut.rs
new file mode 100644
index 000000000..92655cee6
--- /dev/null
+++ b/crates/gpu/src/cut.rs
@@ -0,0 +1,286 @@
+//! The plain-value input of the stock removal kernel (#2627, GPU stock
+//! sim S2) and its CPU law: the per-cell cut of a ball or an upright
+//! flat end mill on one linear chord, in f32, folded with the max law
+//! on order-preserving keys into a dense z-major lattice.
+//!
+//! Provenance: a copy, operation for operation, of the f32 cut twin of
+//! camcraft-sim (`stock_sim::cut_twin`, #2626): the capsule closed form,
+//! the upright flat cylinder in the (rho, z) half-plane and the golden
+//! section on a convex 1-D minimum (J. Kiefer, "Sequential minimax
+//! search for a maximum", Proc. AMS 4, 1953); the key is the standard
+//! radix-sort float transform. Our own design notes; nothing from vendor
+//! binaries.
+//!
+//! ## The laws here
+//!
+//! - **Plain values in.** The caller (which sees camcraft-sim) gives
+//!   each work item as numbers: the chord relative to its brick origin,
+//!   already rounded to f32 with its claim margin, and the brick's
+//!   cells. This crate imports no camcraft crate (decision 2620).
+//! - **Validate before any work.** A non-finite or out-of-range value,
+//!   an item outside the lattice or a lattice over the texel budget is
+//!   an `Err` that names it. The CPU law and the kernel never see it.
+//! - **The CPU law is the twin, bit for bit.** `cut_cpu` gives the same
+//!   bits as camcraft-sim's `run_twin` on the same items
+//!   (`tests/cut_parity.rs` reads the recorded twin output). It is the
+//!   fallback of the GPU path and the oracle of its spot check.
+
+/// The brick edge in cells (camcraft-sim's `field::BRICK`).
+pub const CUT_BRICK: u32 = 8;
+
+/// The dense lattice budget in texels (camcraft-sim's
+/// `preview::pack::MAX_TEXELS`, the same value).
+pub const MAX_CUT_TEXELS: usize = 1 << 23;
+
+/// The largest coordinate magnitude that an item may carry, in mm. A
+/// tile-relative value past it is no stock cut; it also keeps every
+/// square inside the f32 range, so no distance overflows.
+pub const MAX_CUT_COORD: f32 = 1.0e6;
+
+/// Golden-section iterations (the twin's and the f64 law's count).
+const GS_ITERS: u32 = 32;
+
+/// (sqrt(5) - 1) / 2 in f32 (the twin's value).
+const PHI: f32 = 0.618_034;
+
+/// The dense lattice: `dims` cells a side, edge `cell`, claim cap `cap`.
+/// Texel `(x, y, z)` is slot `(z * dims[1] + y) * dims[0] + x`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct CutGrid {
+    pub dims: [u32; 3],
+    pub cell: f32,
+    pub cap: f32,
+}
+
+/// One unit of kernel work: one chord against one brick.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct CutItem {
+    /// Chord start, relative to the brick origin (ball: the center
+    /// path; flat: the tip path).
+    pub a: [f32; 3],
+    /// Chord end, relative to the brick origin.
+    pub b: [f32; 3],
+    /// Tool radius.
+    pub r: f32,
+    /// Flank length up +Z (flat only; `0` for the ball).
+    pub flank: f32,
+    /// The claim margin that keeps the f32 cut under the f64 cut.
+    pub margin: f32,
+    pub ball: bool,
+    /// The brick origin's lattice offset in cells (may be negative
+    /// when the brick starts before the lattice).
+    pub base: [i32; 3],
+    /// First local cell of the brick to cut, in `0..CUT_BRICK`.
+    pub lo: [u32; 3],
+    /// Last local cell to cut (inclusive), in `lo..CUT_BRICK`.
+    pub hi: [u32; 3],
+}
+
+/// One batch for the kernel.
+#[derive(Clone, Debug, PartialEq)]
+pub struct CutInput {
+    pub grid: CutGrid,
+    pub items: Vec<CutItem>,
+}
+
+fn bad(msg: String) -> String {
+    format!("stock cut kernel: {msg}")
+}
+
+impl CutGrid {
+    /// The number of texels, or why the lattice is refused.
+    pub fn texels(&self) -> Result<usize, String> {
+        if !(self.cell.is_finite() && self.cell > 0.0 && self.cap.is_finite() && self.cap > 0.0) {
+            return Err(bad(format!("the cell {} and cap {} must be positive finite numbers", self.cell, self.cap)));
+        }
+        let [x, y, z] = self.dims.map(|d| d as usize);
+        match x.checked_mul(y).and_then(|n| n.checked_mul(z)) {
+            Some(n) if n > 0 && n <= MAX_CUT_TEXELS => Ok(n),
+            _ => Err(bad(format!("the lattice dims {:?} are empty or over the {MAX_CUT_TEXELS} texel budget", self.dims))),
+        }
+    }
+
+    /// The key of the "no cut" floor, `-4 cap` (the `pack_cut` floor).
+    #[must_use]
+    pub fn floor_key(&self) -> u32 {
+        ordered_bits(-4.0 * self.cap)
+    }
+}
+
+impl CutItem {
+    fn check(&self, n: usize, dims: [u32; 3]) -> Result<(), String> {
+        let coords = self.a.iter().chain(self.b.iter());
+        if !coords.clone().all(|v| v.is_finite() && v.abs() <= MAX_CUT_COORD) {
+            return Err(bad(format!("item {n} has a chord endpoint that is not finite or past {MAX_CUT_COORD} mm")));
+        }
+        let size_ok = |v: f32| v.is_finite() && v <= MAX_CUT_COORD;
+        if !(size_ok(self.r) && self.r > 0.0 && size_ok(self.flank) && self.flank >= 0.0) {
+            return Err(bad(format!("item {n} has the radius {} and flank {}: not a tool size", self.r, self.flank)));
+        }
+        if !(size_ok(self.margin) && self.margin >= 0.0) {
+            return Err(bad(format!("item {n} has the margin {}: not a finite non-negative value", self.margin)));
+        }
+        if !self.ball && self.flank <= 0.0 {
+            return Err(bad(format!("item {n} is a flat end mill with no flank")));
+        }
+        for a in 0..3 {
+            let (lo, hi) = (self.lo[a], self.hi[a]);
+            if lo > hi || hi >= CUT_BRICK {
+                return Err(bad(format!("item {n} has the cells {lo}..={hi} on axis {a}: not inside one brick")));
+            }
+            let first = i64::from(self.base[a]) + i64::from(lo);
+            let last = i64::from(self.base[a]) + i64::from(hi);
+            if first < 0 || last >= i64::from(dims[a]) {
+                return Err(bad(format!("item {n} reaches the cells {first}..={last} on axis {a}, outside the lattice")));
+            }
+        }
+        Ok(())
+    }
+}
+
+impl CutInput {
+    /// Validate the whole batch; the texel count when it is good.
+    pub fn check(&self) -> Result<usize, String> {
+        let n = self.grid.texels()?;
+        if u32::try_from(self.items.len()).is_err() {
+            return Err(bad(format!("{} items do not fit one batch", self.items.len())));
+        }
+        for (i, it) in self.items.iter().enumerate() {
+            it.check(i, self.grid.dims)?;
+        }
+        Ok(n)
+    }
+}
+
+/// The lattice slot of local cell `l` of `it`. The item is checked, so
+/// the sum is inside the lattice.
+pub(crate) fn slot(it: &CutItem, l: [u32; 3], dims: [u32; 3]) -> Option<usize> {
+    let mut at = [0usize; 3];
+    for a in 0..3 {
+        let v = i64::from(it.base[a]) + i64::from(l[a]);
+        if v < 0 || v >= i64::from(dims[a]) {
+            return None;
+        }
+        at[a] = usize::try_from(v).ok()?;
+    }
+    let [dx, dy, _] = dims.map(|d| d as usize);
+    Some((at[2] * dy + at[1]) * dx + at[0])
+}
+
+/// The cell cut of `it` at local cell `l`: `Some(min(-phi, cap))` when
+/// the biased distance `phi` is under `cap` (the twin's `cell_cut`).
+#[must_use]
+pub fn cell_cut(it: &CutItem, l: [u32; 3], grid: &CutGrid) -> Option<f32> {
+    let q = l.map(|v| (v as f32 + 0.5) * grid.cell);
+    let d = if it.ball { ball_dist(it, q) } else { flat_dist(it, q) };
+    let phi = d + it.margin;
+    if !phi.is_finite() || phi >= grid.cap {
+        return None;
+    }
+    Some((-phi).min(grid.cap))
+}
+
+/// The CPU run of the kernel: the cut layer in the dense layout, with
+/// the `-4 cap` floor where no item claims a cell.
+pub fn cut_cpu(input: &CutInput) -> Result<Vec<f32>, String> {
+    let n = input.check()?;
+    let mut keys = Vec::new();
+    keys.try_reserve_exact(n).map_err(|e| bad(format!("no memory for {n} texels: {e}")))?;
+    keys.resize(n, input.grid.floor_key());
+    for it in &input.items {
+        for z in it.lo[2]..=it.hi[2] {
+            for y in it.lo[1]..=it.hi[1] {
+                for x in it.lo[0]..=it.hi[0] {
+                    let Some(v) = cell_cut(it, [x, y, z], &input.grid) else {
+                        continue;
+                    };
+                    let dst = slot(it, [x, y, z], input.grid.dims).and_then(|s| keys.get_mut(s));
+                    let Some(dst) = dst else {
+                        return Err(bad("a checked item left the lattice".into()));
+                    };
+                    *dst = (*dst).max(ordered_bits(v));
+                }
+            }
+        }
+    }
+    Ok(keys.into_iter().map(from_ordered_bits).collect())
+}
+
+fn ball_dist(it: &CutItem, q: [f32; 3]) -> f32 {
+    let d = sub(it.b, it.a);
+    let v = sub(q, it.a);
+    let dd = dot(d, d);
+    let t = if dd > 0.0 { (dot(v, d) / dd).clamp(0.0, 1.0) } else { 0.0 };
+    let w = [v[0] - t * d[0], v[1] - t * d[1], v[2] - t * d[2]];
+    dot(w, w).sqrt() - it.r
+}
+
+fn flat_dist(it: &CutItem, q: [f32; 3]) -> f32 {
+    let d = sub(it.b, it.a);
+    let at = |t: f32| pose(it, [it.a[0] + t * d[0], it.a[1] + t * d[1], it.a[2] + t * d[2]], q);
+    if d[2] == 0.0 {
+        let dd = d[0] * d[0] + d[1] * d[1];
+        let t = ((q[0] - it.a[0]) * d[0] + (q[1] - it.a[1]) * d[1]) / dd;
+        return at(if t.is_finite() { t.clamp(0.0, 1.0) } else { 0.0 });
+    }
+    if d[0] == 0.0 && d[1] == 0.0 {
+        let t = (q[2] - it.a[2] - 0.5 * it.flank) / d[2];
+        return at(if t.is_finite() { t.clamp(0.0, 1.0) } else { 0.0 });
+    }
+    let (mut lo, mut hi) = (0.0f32, 1.0f32);
+    let mut c = hi - PHI * (hi - lo);
+    let mut e = lo + PHI * (hi - lo);
+    let mut fc = at(c);
+    let mut fe = at(e);
+    for _ in 0..GS_ITERS {
+        if fc < fe {
+            hi = e;
+            e = c;
+            fe = fc;
+            c = hi - PHI * (hi - lo);
+            fc = at(c);
+        } else {
+            lo = c;
+            c = e;
+            fc = fe;
+            e = lo + PHI * (hi - lo);
+            fe = at(e);
+        }
+    }
+    fc.min(fe)
+}
+
+fn pose(it: &CutItem, t: [f32; 3], q: [f32; 3]) -> f32 {
+    let (x, y, zl) = (q[0] - t[0], q[1] - t[1], q[2] - t[2]);
+    let rho = (x * x + y * y).sqrt();
+    let (e1, e2, e3) = (rho - it.r, -zl, zl - it.flank);
+    let m = e1.max(e2).max(e3);
+    if m > 0.0 {
+        let (p1, p2, p3) = (e1.max(0.0), e2.max(0.0), e3.max(0.0));
+        (p1 * p1 + p2 * p2 + p3 * p3).sqrt()
+    } else {
+        m
+    }
+}
+
+fn sub(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+fn dot(a: [f32; 3], b: [f32; 3]) -> f32 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+/// The order-preserving key of an f32 (a negative flips every bit, a
+/// positive sets the sign bit): the twin's `ordered_bits`.
+#[must_use]
+pub fn ordered_bits(v: f32) -> u32 {
+    let b = v.to_bits();
+    if b & 0x8000_0000 != 0 { !b } else { b | 0x8000_0000 }
+}
+
+/// The inverse of [`ordered_bits`].
+#[must_use]
+pub fn from_ordered_bits(u: u32) -> f32 {
+    if u & 0x8000_0000 != 0 { f32::from_bits(u & 0x7fff_ffff) } else { f32::from_bits(!u) }
+}
diff --git a/crates/gpu/src/cut.wgsl b/crates/gpu/src/cut.wgsl
new file mode 100644
index 000000000..a94b2a4dd
--- /dev/null
+++ b/crates/gpu/src/cut.wgsl
@@ -0,0 +1,182 @@
+// The stock removal kernel (#2627, GPU stock sim S2): one workgroup for
+// each work item (one chord against one 8^3 brick), one invocation for
+// each (x, y) column of the brick, the eight z cells in a loop. A claim
+// folds into the lattice with atomicMax on the order-preserving key, so
+// the result does not depend on the order of the items. Three entry
+// points: cs_fill writes the -4 cap floor key, cs_cut claims, cs_decode
+// turns each key into the bits of its f32 (the pack_cut layout).
+// The math is the CPU law of cut.rs, operation for operation.
+// Provenance: the swept-solid distance laws of camcraft-sim's f32 twin
+// (#2626): capsule closed form, upright flat cylinder in the (rho, z)
+// half-plane, golden section (Kiefer 1953); the radix-sort float key.
+
+struct Params {
+    dims: vec3<u32>,
+    n_tex: u32,
+    first: u32,
+    count: u32,
+    row: u32,
+    floor_key: u32,
+    cell: f32,
+    cap: f32,
+    pad0: u32,
+    pad1: u32,
+}
+
+struct Item {
+    a: vec3<f32>,
+    r: f32,
+    b: vec3<f32>,
+    flank: f32,
+    base: vec3<i32>,
+    ball: u32,
+    lo: vec3<u32>,
+    margin: f32,
+    hi: vec3<u32>,
+    pad: u32,
+}
+
+@group(0) @binding(0) var<uniform> params: Params;
+@group(0) @binding(1) var<storage, read> items: array<Item>;
+@group(0) @binding(2) var<storage, read_write> keys: array<atomic<u32>>;
+
+const GS_ITERS: u32 = 32u;
+const PHI: f32 = 0.618034;
+// The smallest denominator that the closed forms divide by; the CPU law
+// gets a non-finite quotient (and takes t = 0) only below it.
+const TINY: f32 = 1e-30;
+const SIGN: u32 = 0x80000000u;
+
+fn texel(wg: vec3<u32>, li: u32) -> u32 {
+    return (wg.y * params.row + wg.x) * 64u + li;
+}
+
+@compute @workgroup_size(64)
+fn cs_fill(@builtin(workgroup_id) wg: vec3<u32>, @builtin(local_invocation_index) li: u32) {
+    let i = texel(wg, li);
+    if (i < params.n_tex) {
+        atomicStore(&keys[i], params.floor_key);
+    }
+}
+
+@compute @workgroup_size(64)
+fn cs_decode(@builtin(workgroup_id) wg: vec3<u32>, @builtin(local_invocation_index) li: u32) {
+    let i = texel(wg, li);
+    if (i >= params.n_tex) {
+        return;
+    }
+    let u = atomicLoad(&keys[i]);
+    var bits = ~u;
+    if ((u & SIGN) != 0u) {
+        bits = u & ~SIGN;
+    }
+    atomicStore(&keys[i], bits);
+}
+
+fn ordered(v: f32) -> u32 {
+    let b = bitcast<u32>(v);
+    if ((b & SIGN) != 0u) {
+        return ~b;
+    }
+    return b | SIGN;
+}
+
+fn ball_dist(it: Item, q: vec3<f32>) -> f32 {
+    let d = it.b - it.a;
+    let v = q - it.a;
+    let dd = dot(d, d);
+    var t = 0.0;
+    if (dd > 0.0) {
+        t = clamp(dot(v, d) / dd, 0.0, 1.0);
+    }
+    let w = v - t * d;
+    return sqrt(dot(w, w)) - it.r;
+}
+
+fn pose(it: Item, t: f32, q: vec3<f32>) -> f32 {
+    let tip = it.a + t * (it.b - it.a);
+    let x = q.x - tip.x;
+    let y = q.y - tip.y;
+    let zl = q.z - tip.z;
+    let rho = sqrt(x * x + y * y);
+    let e = vec3<f32>(rho - it.r, -zl, zl - it.flank);
+    let m = max(max(e.x, e.y), e.z);
+    if (m > 0.0) {
+        let p = max(e, vec3<f32>(0.0));
+        return sqrt(dot(p, p));
+    }
+    return m;
+}
+
+fn flat_dist(it: Item, q: vec3<f32>) -> f32 {
+    let d = it.b - it.a;
+    if (d.z == 0.0) {
+        let dd = d.x * d.x + d.y * d.y;
+        var t = 0.0;
+        if (dd > TINY) {
+            t = clamp(((q.x - it.a.x) * d.x + (q.y - it.a.y) * d.y) / dd, 0.0, 1.0);
+        }
+        return pose(it, t, q);
+    }
+    if (d.x == 0.0 && d.y == 0.0) {
+        var t = 0.0;
+        if (abs(d.z) > TINY) {
+            t = clamp((q.z - it.a.z - 0.5 * it.flank) / d.z, 0.0, 1.0);
+        }
+        return pose(it, t, q);
+    }
+    var lo = 0.0;
+    var hi = 1.0;
+    var c = hi - PHI * (hi - lo);
+    var e = lo + PHI * (hi - lo);
+    var fc = pose(it, c, q);
+    var fe = pose(it, e, q);
+    for (var k = 0u; k < GS_ITERS; k = k + 1u) {
+        if (fc < fe) {
+            hi = e;
+            e = c;
+            fe = fc;
+            c = hi - PHI * (hi - lo);
+            fc = pose(it, c, q);
+        } else {
+            lo = c;
+            c = e;
+            fc = fe;
+            e = lo + PHI * (hi - lo);
+            fe = pose(it, e, q);
+        }
+    }
+    return min(fc, fe);
+}
+
+@compute @workgroup_size(8, 8, 1)
+fn cs_cut(@builtin(workgroup_id) wg: vec3<u32>, @builtin(local_invocation_id) lid: vec3<u32>) {
+    if (wg.x >= params.count) {
+        return;
+    }
+    let it = items[params.first + wg.x];
+    for (var z = 0u; z < 8u; z = z + 1u) {
+        let l = vec3<u32>(lid.x, lid.y, z);
+        if (any(l < it.lo) || any(l > it.hi)) {
+            continue;
+        }
+        let q = (vec3<f32>(l) + vec3<f32>(0.5)) * params.cell;
+        var dist: f32;
+        if (it.ball != 0u) {
+            dist = ball_dist(it, q);
+        } else {
+            dist = flat_dist(it, q);
+        }
+        let phi = dist + it.margin;
+        // written so that a NaN claims nothing, as on the CPU
+        if (!(phi < params.cap)) {
+            continue;
+        }
+        let at = vec3<i32>(l) + it.base;
+        if (any(at < vec3<i32>(0)) || any(vec3<u32>(at) >= params.dims)) {
+            continue; // unreachable: the host checked every item
+        }
+        let s = (u32(at.z) * params.dims.y + u32(at.y)) * params.dims.x + u32(at.x);
+        atomicMax(&keys[s], ordered(min(-phi, params.cap)));
+    }
+}
diff --git a/crates/gpu/src/cut_gpu.rs b/crates/gpu/src/cut_gpu.rs
new file mode 100644
index 000000000..3ee6c3dd2
--- /dev/null
+++ b/crates/gpu/src/cut_gpu.rs
@@ -0,0 +1,300 @@
+//! The GPU half of the stock removal kernel (#2627, GPU stock sim S2):
+//! the pipelines of `cut.wgsl`, the upload of a checked batch, the
+//! fill / cut / decode passes, and a read-back with a time bound. Every
+//! failure (a limit, a validation, internal or out-of-memory error, a
+//! failed map, a poll past its time bound) is an `Err` with the reason;
+//! the caller then takes the CPU law (`cut_run::cut_or_cpu`).
+//! Provenance: our own dispatch over wgpu's public compute API.
+
+use std::sync::mpsc;
+use std::time::Duration;
+
+use crate::cut::{CutInput, CutItem};
+use crate::probe::Compute;
+
+const SHADER: &str = include_str!("cut.wgsl");
+
+/// Work items in one dispatch of `cs_cut`: small enough that one
+/// dispatch of the golden-section path (about 34 M pose evaluations)
+/// stays far under a 2 s driver watchdog on a slow device.
+pub const ITEMS_PER_DISPATCH: u32 = 256;
+
+/// The longest wait for one batch to come back. Past it the batch is a
+/// failure and the CPU law answers.
+pub const CUT_WAIT: Duration = Duration::from_secs(10);
+
+/// Bytes of one `Item` in `cut.wgsl` (five 16-byte rows).
+const ITEM_BYTES: u64 = 80;
+
+/// Bytes of `Params` in `cut.wgsl`.
+const PARAMS_BYTES: u64 = 48;
+
+/// The compiled kernel for one device: build it one time, run it often.
+pub struct CutKernel {
+    bgl: wgpu::BindGroupLayout,
+    fill: wgpu::ComputePipeline,
+    cut: wgpu::ComputePipeline,
+    decode: wgpu::ComputePipeline,
+}
+
+/// The error class of a wgpu error, for the fallback reason.
+pub(crate) fn gpu_error(err: wgpu::Error) -> String {
+    let kind = match &err {
+        wgpu::Error::OutOfMemory { .. } => "out of memory",
+        wgpu::Error::Internal { .. } => "internal",
+        wgpu::Error::Validation { .. } => "validation",
+    };
+    format!("stock cut kernel: GPU {kind} error: {err}")
+}
+
+/// Run `f` inside the three error scopes; any captured error wins.
+fn scoped<T>(device: &wgpu::Device, f: impl FnOnce() -> Result<T, String>) -> Result<T, String> {
+    let oom = device.push_error_scope(wgpu::ErrorFilter::OutOfMemory);
+    let internal = device.push_error_scope(wgpu::ErrorFilter::Internal);
+    let validation = device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let result = f();
+    let mut failure = None;
+    for scope in [validation, internal, oom] {
+        if let Some(err) = pollster::block_on(scope.pop()) {
+            failure.get_or_insert(gpu_error(err));
+        }
+    }
+    match failure {
+        Some(err) => Err(err),
+        None => result,
+    }
+}
+
+fn entry(binding: u32, ty: wgpu::BufferBindingType, dynamic: bool) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::COMPUTE,
+        ty: wgpu::BindingType::Buffer { ty, has_dynamic_offset: dynamic, min_binding_size: None },
+        count: None,
+    }
+}
+
+impl CutKernel {
+    /// Compile the three pipelines on `device`.
+    pub fn new(device: &wgpu::Device) -> Result<CutKernel, String> {
+        scoped(device, || {
+            let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: Some("camcraft-gpu stock cut"),
+                source: wgpu::ShaderSource::Wgsl(SHADER.into()),
+            });
+            use wgpu::BufferBindingType as B;
+            let bgl = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("camcraft-gpu stock cut"),
+                entries: &[
+                    entry(0, B::Uniform, true),
+                    entry(1, B::Storage { read_only: true }, false),
+                    entry(2, B::Storage { read_only: false }, false),
+                ],
+            });
+            let layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                label: Some("camcraft-gpu stock cut"),
+                bind_group_layouts: &[Some(&bgl)],
+                immediate_size: 0,
+            });
+            let pipe = |name: &str| {
+                device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                    label: Some(name),
+                    layout: Some(&layout),
+                    module: &module,
+                    entry_point: Some(name),
+                    compilation_options: Default::default(),
+                    cache: None,
+                })
+            };
+            Ok(CutKernel { fill: pipe("cs_fill"), cut: pipe("cs_cut"), decode: pipe("cs_decode"), bgl })
+        })
+    }
+
+    /// Cut `input` on `device`: the dense f32 layer of `cut_cpu`'s
+    /// layout. Blocks for at most about [`CUT_WAIT`]. `input` must have
+    /// passed [`CutInput::check`]; it is checked again here.
+    pub fn run(
+        &self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        compute: &Compute,
+        input: &CutInput,
+    ) -> Result<Vec<f32>, String> {
+        let n_tex = input.check()?;
+        let plan = Layout::of(device, compute, input, n_tex)?;
+        scoped(device, || {
+            let (read, at) = self.submit(device, queue, input, &plan)?;
+            read_back(device, &read, at, plan.out_bytes)
+        })
+    }
+
+    fn submit(
+        &self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        input: &CutInput,
+        p: &Layout,
+    ) -> Result<(wgpu::Buffer, wgpu::SubmissionIndex), String> {
+        use wgpu::BufferUsages as U;
+        let buf = |label, size, usage| {
+            device.create_buffer(&wgpu::BufferDescriptor { label: Some(label), size, usage, mapped_at_creation: false })
+        };
+        let params = buf("stock cut params", p.params_bytes, U::UNIFORM | U::COPY_DST);
+        let items = buf("stock cut items", p.item_bytes, U::STORAGE | U::COPY_DST);
+        let keys = buf("stock cut keys", p.out_bytes, U::STORAGE | U::COPY_SRC);
+        let read = buf("stock cut read", p.out_bytes, U::MAP_READ | U::COPY_DST);
+        queue.write_buffer(&params, 0, &p.params);
+        queue.write_buffer(&items, 0, &item_bytes(&input.items, p.item_bytes)?);
+        let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("camcraft-gpu stock cut"),
+            layout: &self.bgl,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                        buffer: &params,
+                        offset: 0,
+                        size: wgpu::BufferSize::new(PARAMS_BYTES),
+                    }),
+                },
+                wgpu::BindGroupEntry { binding: 1, resource: items.as_entire_binding() },
+                wgpu::BindGroupEntry { binding: 2, resource: keys.as_entire_binding() },
+            ],
+        });
+        let mut enc = device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("stock cut") });
+        {
+            let mut pass = enc.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Some("stock cut"), timestamp_writes: None });
+            pass.set_bind_group(0, &group, &[0]);
+            pass.set_pipeline(&self.fill);
+            pass.dispatch_workgroups(p.tex_groups[0], p.tex_groups[1], 1);
+            pass.set_pipeline(&self.cut);
+            for (k, count) in p.chunks.iter().enumerate() {
+                pass.set_bind_group(0, &group, &[p.offset(k)?]);
+                pass.dispatch_workgroups(*count, 1, 1);
+            }
+            pass.set_bind_group(0, &group, &[0]);
+            pass.set_pipeline(&self.decode);
+            pass.dispatch_workgroups(p.tex_groups[0], p.tex_groups[1], 1);
+        }
+        enc.copy_buffer_to_buffer(&keys, 0, &read, 0, p.out_bytes);
+        let at = queue.submit([enc.finish()]);
+        Ok((read, at))
+    }
+}
+
+/// The buffer plan of one batch, checked against the device limits.
+struct Layout {
+    params: Vec<u8>,
+    params_bytes: u64,
+    stride: u64,
+    item_bytes: u64,
+    out_bytes: u64,
+    tex_groups: [u32; 2],
+    chunks: Vec<u32>,
+}
+
+impl Layout {
+    fn of(device: &wgpu::Device, compute: &Compute, input: &CutInput, n_tex: usize) -> Result<Layout, String> {
+        let limit = compute.max_storage_buffer_binding_size.min(compute.max_buffer_size);
+        let over = |what: &str, bytes: u64| format!("stock cut kernel: the {what} need {bytes} bytes, over the device limit {limit}");
+        let out_bytes = (n_tex as u64).saturating_mul(4);
+        let n_items = input.items.len() as u64;
+        // an empty batch still binds a one-item buffer
+        let item_bytes = n_items.max(1).saturating_mul(ITEM_BYTES);
+        if out_bytes > limit {
+            return Err(over("texels", out_bytes));
+        }
+        if item_bytes > limit {
+            return Err(over("work items", item_bytes));
+        }
+        let max_dim = compute.max_compute_workgroups_per_dimension.max(1);
+        let groups = u32::try_from(n_tex.div_ceil(64)).map_err(|_| "stock cut kernel: too many texel groups".to_string())?;
+        let row = groups.min(max_dim);
+        let rows = groups.div_ceil(row.max(1));
+        if rows > max_dim {
+            return Err(format!("stock cut kernel: {groups} texel groups pass the dispatch limit {max_dim}"));
+        }
+        let mut chunks = Vec::new();
+        let n = u32::try_from(n_items).map_err(|_| "stock cut kernel: too many work items".to_string())?;
+        let mut first = 0u32;
+        while first < n {
+            chunks.push((n - first).min(ITEMS_PER_DISPATCH));
+            first += ITEMS_PER_DISPATCH;
+        }
+        let stride = u64::from(device.limits().min_uniform_buffer_offset_alignment).max(PARAMS_BYTES).next_multiple_of(16);
+        let blocks = chunks.len().max(1);
+        let params_bytes = stride.saturating_mul(blocks as u64);
+        let mut params = Vec::new();
+        params.try_reserve_exact(params_bytes as usize).map_err(|e| format!("stock cut kernel: no host memory: {e}"))?;
+        params.resize(params_bytes as usize, 0);
+        let g = &input.grid;
+        let n_tex32 = u32::try_from(n_tex).map_err(|_| "stock cut kernel: too many texels".to_string())?;
+        for (k, block) in params.chunks_exact_mut(stride as usize).enumerate() {
+            let count = chunks.get(k).copied().unwrap_or(0);
+            let first = u32::try_from(k).unwrap_or(u32::MAX).saturating_mul(ITEMS_PER_DISPATCH);
+            let words = [g.dims[0], g.dims[1], g.dims[2], n_tex32, first, count, row, g.floor_key(), g.cell.to_bits(), g.cap.to_bits()];
+            for (dst, w) in block.as_chunks_mut::<4>().0.iter_mut().zip(words) {
+                dst.copy_from_slice(&w.to_le_bytes());
+            }
+        }
+        Ok(Layout { params, params_bytes, stride, item_bytes, out_bytes, tex_groups: [row, rows], chunks })
+    }
+
+    fn offset(&self, k: usize) -> Result<u32, String> {
+        u32::try_from(self.stride.saturating_mul(k as u64)).map_err(|_| "stock cut kernel: the uniform offset overflows".into())
+    }
+}
+
+fn item_bytes(items: &[CutItem], bytes: u64) -> Result<Vec<u8>, String> {
+    let mut v = Vec::new();
+    v.try_reserve_exact(bytes as usize).map_err(|e| format!("stock cut kernel: no host memory: {e}"))?;
+    for it in items {
+        let row = |xyz: [u32; 3], w: u32| [xyz[0], xyz[1], xyz[2], w];
+        let f = |p: [f32; 3]| p.map(f32::to_bits);
+        let words = [
+            row(f(it.a), it.r.to_bits()),
+            row(f(it.b), it.flank.to_bits()),
+            row(it.base.map(|v| v as u32), u32::from(it.ball)),
+            row(it.lo, it.margin.to_bits()),
+            row(it.hi, 0),
+        ];
+        for w in words.iter().flatten() {
+            v.extend_from_slice(&w.to_le_bytes());
+        }
+    }
+    v.resize(bytes as usize, 0);
+    Ok(v)
+}
+
+/// Map the read buffer and wait at most [`CUT_WAIT`] for it.
+fn read_back(
+    device: &wgpu::Device,
+    read: &wgpu::Buffer,
+    at: wgpu::SubmissionIndex,
+    out_bytes: u64,
+) -> Result<Vec<f32>, String> {
+    let (tx, rx) = mpsc::channel();
+    read.slice(..).map_async(wgpu::MapMode::Read, move |r| {
+        let _ = tx.send(r);
+    });
+    device
+        .poll(wgpu::PollType::Wait { submission_index: Some(at), timeout: Some(CUT_WAIT) })
+        .map_err(|e| format!("stock cut kernel: the GPU did not answer within {CUT_WAIT:?}: {e}"))?;
+    match rx.recv_timeout(Duration::from_millis(100)) {
+        Ok(Ok(())) => {}
+        Ok(Err(e)) => return Err(format!("stock cut kernel: the read-back map failed: {e}")),
+        Err(_) => return Err("stock cut kernel: the read-back map did not complete".into()),
+    }
+    let out = {
+        let view = read.get_mapped_range(..).map_err(|e| format!("stock cut kernel: the read-back range failed: {e:?}"))?;
+        if view.len() as u64 != out_bytes {
+            return Err(format!("stock cut kernel: the read-back has {} bytes, not {out_bytes}", view.len()));
+        }
+        let mut out = Vec::new();
+        out.try_reserve_exact(view.len() / 4).map_err(|e| format!("stock cut kernel: no host memory: {e}"))?;
+        out.extend(view.as_chunks::<4>().0.iter().map(|c| f32::from_le_bytes(*c)));
+        out
+    };
+    read.unmap();
+    Ok(out)
+}
