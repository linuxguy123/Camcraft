+#[test]
+fn a_wrong_texel_at_a_fixed_lattice_place_fails_the_spot_check() {
+    let grid = CutGrid { dims: [4, 4, 4], cell: 1.0, cap: 4.0 };
+    let input = CutInput {
+        grid,
