+        "tool": "SteppedMill",
+        "params": {
+            "stepover": 2.5,
+            "stepdown": 7.0,
+            "stock_to_leave": 0.5,
+            "strategy": "waterline",
+            "entry": "helix",
+            "helix_radius": 1.5,
+            "top_z": { "reference": "fixed", "offset": 24.0 },
+            "bottom_z": { "reference": "fixed", "offset": 10.0 },
