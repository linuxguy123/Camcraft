+        .map(|(_, t)| t)
+        .expect("catalog tool");
+    history.execute(&world, AddTool::new(&world, "EM-0400-2FL", tool).expect("add tool"));
+    let params = OpParams::Face {
+        holes: Default::default(),
+        blend_turns: false,
+        tilt: None,
+        stepover: 3.0,
+        clearance_z: Height::fixed(22.0),
