+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum CameraView {
+    #[default]
+    Iso,
+    FrontRight,
+    Top,
+    Side,
+}
+
+impl CameraView {
+    pub fn parse(s: &str) -> Result<Self, String> {
+        match s.to_ascii_lowercase().as_str() {
+            "iso" | "isometric" => Ok(Self::Iso),
+            "front" | "front-right" | "front_right" => Ok(Self::FrontRight),
+            "top" => Ok(Self::Top),
+            "side" => Ok(Self::Side),
+            other => Err(format!("unsupported view \"{other}\" (expected iso, front-right, top, or side)")),
+        }
+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Iso => "iso",
+            Self::FrontRight => "front-right",
+            Self::Top => "top",
+            Self::Side => "side",
+        }
+    }
+
+    fn angles_deg(self) -> (f32, f32) {
+        match self {
+            Self::Iso => (-48.0, 31.0),
+            Self::FrontRight => (-28.0, 22.0),
+            Self::Top => (-90.0, 82.0),
+            Self::Side => (-12.0, 14.0),
+        }
+    }
+}
