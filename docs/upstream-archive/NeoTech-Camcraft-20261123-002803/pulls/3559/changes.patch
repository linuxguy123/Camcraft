+    pub keyframes: Vec<String>,
+    pub setups: Vec<SetupReport>,
+}
+
+fn validate_options(opts: &VideoOptions) -> Result<VideoFormat, String> {
+    if opts.output.as_os_str().is_empty() {
+        return Err("output path must not be empty".into());
+    }
+    if !(MIN_EDGE..=MAX_EDGE).contains(&opts.width) {
+        return Err(format!("width must be in {MIN_EDGE}..={MAX_EDGE}, got {}", opts.width));
+    }
+    if !(MIN_EDGE..=MAX_EDGE).contains(&opts.height) {
+        return Err(format!("height must be in {MIN_EDGE}..={MAX_EDGE}, got {}", opts.height));
+    }
+    if !(1..=120).contains(&opts.fps) {
+        return Err(format!("fps must be in 1..=120, got {}", opts.fps));
+    }
+    let fmt = opts.format.resolve(&opts.output);
+    if matches!(fmt, VideoFormat::Mp4 | VideoFormat::Webm) && (!opts.width.is_multiple_of(2) || !opts.height.is_multiple_of(2)) {
+        return Err(format!(
+            "{} encoding requires even width and height (got {}x{})",
+            fmt.as_str(),
+            opts.width,
+            opts.height
+        ));
+    }
+    for (label, val) in [
+        ("seconds", opts.seconds),
+        ("transition_seconds", opts.transition_seconds),
+        ("spin_seconds", opts.spin_seconds),
+    ] {
+        if let Some(v) = val
+            && (!v.is_finite() || v < 0.0 || v > 600.0)
+        {
+            return Err(format!("{label} must be finite and in 0..=600, got {v}"));
+        }
+    }
+    Ok(fmt)
+}
+
+#[inline]
+fn round2(v: f64) -> f64 {
+    (v * 100.0).round() / 100.0
+}
+
+#[inline]
+fn smoothstep(t: f32) -> f32 {
+    let x = t.clamp(0.0, 1.0);
+    x * x * (3.0 - 2.0 * x)
+}
+
+fn orbit_camera(view: CameraView, span: Vec3, az_offset_deg: f32, elev_offset_deg: f32, w: u32, h: u32) -> Camera {
+    let r_sphere = (span.len() * 0.5).max(1.0);
+    let fov_deg = 36.0f32;
+    let half_tan = (fov_deg * 0.5).to_radians().tan();
+    let aspect = (w as f32 / h.max(1) as f32).min(1.0);
+    let dist = r_sphere / (half_tan * aspect) * 1.32;
+    let (base_az, base_el) = view.angles_deg();
+    let az = (base_az + az_offset_deg).to_radians();
+    let el = (base_el + elev_offset_deg).clamp(-20.0, 86.0).to_radians();
+    let eye = Vec3::new(
+        dist * el.cos() * az.cos(),
+        dist * el.cos() * az.sin(),
+        dist * el.sin() + r_sphere * 0.14,
+    );
+    let target = Vec3::new(0.0, 0.0, r_sphere * 0.04);
+    Camera::look_at(eye, target, fov_deg, w, h)
+}
+
+/// Choose a slight horizontal azimuth offset for asymmetric setups (e.g. a quarter-turned fixture
+/// whose machined features all sit on the far side of the billet from the default eye).
+fn setup_az_bias(view: CameraView, setup: &VideoSetup, rot: Mat3, center: Vec3, span: Vec3) -> f32 {
+    if view == CameraView::Top {
+        return 0.0;
+    }
+    let (mut sx, mut sy, mut n) = (0.0f64, 0.0f64, 0u64);
+    for op in &setup.ops {
+        let step = (op.segs.len() / 256).max(1);
+        for seg in op.segs.iter().step_by(step) {
+            if !seg.is_rapid {
+                let d = rot.mul(seg.b_part.sub(center));
+                sx += f64::from(d.x);
+                sy += f64::from(d.y);
+                n += 1;
+            }
+        }
+    }
+    if n == 0 {
+        return 0.0;
+    }
+    let mx = (sx / n as f64) as f32;
+    let my = (sy / n as f64) as f32;
+    let max_span = span.x.max(span.y).max(span.z).max(1.0);
+    if mx.hypot(my) < max_span * 0.06 {
+        return 0.0;
+    }
+    let (base_az, _) = view.angles_deg();
+    let base_rad = base_az.to_radians();
+    let dot = mx * base_rad.cos() + my * base_rad.sin();
+    if dot >= 0.0 {
+        return 0.0;
+    }
+    // Mirror camera onto the hemisphere containing the cutting centroid, offset ~38° for 3/4 view.
+    let target_az = my.atan2(mx).to_degrees() + 38.0;
+    let mut diff = (target_az - base_az) % 360.0;
+    if diff > 180.0 { diff -= 360.0; }
+    if diff < -180.0 { diff += 360.0; }
+    diff
+}
+
+fn sanitize_tag(s: &str) -> String {
+    let t: String = s
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() || c == '_' || c == '-' { c } else { '_' })
+        .collect();
+    if t.is_empty() { "setup".into() } else { t }
+}
+
+fn setup_bars(setup: &VideoSetup) -> (Vec<OpBar>, usize) {
+    let mut bars = Vec::with_capacity(setup.ops.len());
+    let mut cur = 0usize;
+    for op in &setup.ops {
+        let len = op.segs.len();
+        bars.push(OpBar {
+            first_seg: cur,
+            end_seg: cur + len,
+            color: bar_color(op.tool.tag),
+        });
+        cur += len;
+    }
+    (bars, cur)
+}
+
+/// Distribute `budget` cutting frames across a setup's ops with `sqrt(len)` weighting so both
+/// quick drills/contours and huge 3D ball-nose passes remain readable.
+fn allocate_op_frames(ops: &[VideoOp], budget: usize) -> Vec<usize> {
+    if ops.is_empty() {
+        return Vec::new();
+    }
+    let weights: Vec<f64> = ops.iter().map(|o| (o.segs.len().max(1) as f64).sqrt()).collect();
+    let sum: f64 = weights.iter().sum::<f64>().max(1e-6);
+    let floor = if budget >= ops.len() * 6 { 6 } else { 1 };
+    let mut counts: Vec<usize> = weights
+        .iter()
+        .map(|w| ((w / sum) * budget as f64).round().max(floor as f64) as usize)
+        .collect();
+    for (c, op) in counts.iter_mut().zip(ops) {
+        // Keep tiny single-move ops bounded to their natural length unless spinning minimally.
+        *c = (*c).clamp(1, (op.segs.len() * 8).max(4));
+    }
+    counts
+}
+
+fn save_keyframe(
+    dir: Option<&Path>,
+    name: &str,
+    w: u32,
+    h: u32,
+    rgb: &[u8],
+    out: &mut Vec<String>,
+) -> Result<(), String> {
+    if let Some(d) = dir {
+        let path = d.join(format!("{name}.png"));
+        write_png(&path, w, h, rgb)?;
+        out.push(path.display().to_string());
+    }
+    Ok(())
+}
+
+fn push_frame(
+    rgb: &[u8],
+    main: &mut FrameSink,
+    side: Option<&mut FrameSink>,
+    total: &mut usize,
+    setup_frames: &mut usize,
+) -> Result<(), String> {
+    main.write_frame(rgb)?;
+    *total += 1;
+    if let Some(s) = side {
+        s.write_frame(rgb)?;
+    }
+    *setup_frames += 1;
+    Ok(())
+}
+
+fn quats_differ(a: [f32; 4], b: [f32; 4]) -> bool {
+    let a = norm_quat(a);
+    let b = norm_quat(b);
+    (a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3]).abs() < 0.999
+}
+
+struct SpinCtx<'a> {
+    stock: &'a VoxelStock,
+    center: Vec3,
+    span: Vec3,
+    view: CameraView,
+    w: u32,
+    h: u32,
+    show_hud: bool,
+    base_q: [f32; 4],
+    upright_q: Option<[f32; 4]>,
+    setup_title: &'a str,
+    banner: &'a str,
+    footer_left: &'a str,
+    footer_right: &'a str,
+    bars: &'a [OpBar],
+    total_segs: usize,
+    rgb: &'a mut Vec<u8>,
+    zbuf: &'a mut Vec<f32>,
+}
+
+fn emit_spin_frames(
+    ctx: &mut SpinCtx<'_>,
+    frames: usize,
+    az_start: f32,
+    sweep_deg: f32,
+    mut on_frame: impl FnMut(usize, &[u8]) -> Result<(), String>,
+) -> Result<(), String> {
+    if frames == 0 {
+        return Ok(());
+    }
+    let rem = ctx.stock.volume_cm3();
+    let pct = ctx.stock.removed_pct();
+    for f in 0..frames {
+        let u = (f as f32 + 1.0) / frames as f32;
+        let q = match ctx.upright_q {
+            Some(up) if u > 0.25 => {
+                let s = smoothstep((u - 0.25) / 0.28);
+                quat_slerp(ctx.base_q, up, s)
+            }
+            _ => ctx.base_q,
+        };
+        let rot = Mat3::from_quat(q);
+        let az = if ctx.upright_q.is_some() {
+            az_start + (sweep_deg - az_start) * u
+        } else {
+            az_start + sweep_deg * u
+        };
+        let cam = orbit_camera(ctx.view, ctx.span, az, 6.0 * (u * std::f32::consts::PI).sin(), ctx.w, ctx.h);
+        let table_z = ctx.stock.lowest_display_z(rot, ctx.center) - 1.2;
+        let hud = ctx.show_hud.then_some(HudInfo {
+            setup_title: ctx.setup_title,
+            op_title: "FINAL STOCK INSPECTION",
+            tool_badge: "",
+            rpm: 0.0,
+            feed: 0.0,
+            is_rapid: false,
+            show_tool: false,
+            wcs_pos: [0.0; 3],
+            remaining_cm3: rem,
+            removed_pct: pct,
+            progress_frac: 1.0,
+            footer_left: ctx.footer_left,
+            footer_right: ctx.footer_right,
+            banner: ctx.banner,
+            move_num: ctx.total_segs,
+            bars: ctx.bars,
+            total_segs: ctx.total_segs,
+        });
+        render_frame(
+            &FrameParams {
+                stock: ctx.stock,
+                cam,
+                part_rot: rot,
+                part_center: ctx.center,
+                spindle_axis_part: Vec3::new(0.0, 0.0, 1.0),
+                show_tool: false,
+                tool_tip_part: Vec3::ZERO,
+                tool: None,
+                spin_phase: 0.0,
+                is_cutting: false,
+                show_toolpath: false,
+                trail: &[],
+                hud,
+                table_z,
+            },
+            ctx.rgb,
+            ctx.zbuf,
+        );
+        on_frame(f, ctx.rgb)?;
+    }
+    Ok(())
+}
+
+/// Simulate every generated operation in program order across multi-setup orientations and write
+/// a combined movie (plus optional per-setup split videos and PNG keyframes).
+pub fn render_simulation_video(world: &World, opts: &VideoOptions) -> Result<VideoReport, String> {
+    let resolved_fmt = validate_options(opts)?;
+    let mut plan = gather_plan(world, opts.cell_mm)?;
+    let target_idx: Option<usize> = match opts.setup.as_deref() {
+        None => None,
+        Some(wanted) => {
+            let pos = plan.setups.iter().position(|s| s.name == wanted);
+            match pos {
+                Some(i) => Some(i),
+                None => {
+                    let names: Vec<&str> = plan.setups.iter().map(|s| s.name.as_str()).collect();
+                    return Err(format!("setup \"{wanted}\" not found (available: {})", names.join(", ")));
+                }
+            }
+        }
+    };
+    let rendered_setups: usize = if target_idx.is_some() { 1 } else { plan.setups.len() };
+    let total_cut_s = opts.seconds.unwrap_or_else(|| {
+        plan.setups
+            .iter()
+            .enumerate()
+            .filter(|(i, _)| target_idx.is_none_or(|t| *i == t))
+            .map(|(_, s)| (s.ops.len() as f64 * 2.8).clamp(4.5, 16.0))
+            .sum::<f64>()
+    });
+    let total_cut_frames = (total_cut_s * f64::from(opts.fps)).round().max(rendered_setups as f64) as usize;
+    let trans_frames = (opts.transition_seconds.unwrap_or(1.1) * f64::from(opts.fps)).round() as usize;
+    let spin_frames = (opts.spin_seconds.unwrap_or(3.0) * f64::from(opts.fps)).round() as usize;
+    let hold_frames = if opts.seconds.is_some_and(|s| s <= 1.0) { 0 } else { (opts.fps / 3).max(1) as usize };
+
+    let mut main_sink = FrameSink::open(&opts.output, resolved_fmt, opts.width, opts.height, opts.fps)?;
+    let mut rgb = Vec::new();
+    let mut zbuf = Vec::new();
+    let center = plan.stock.center();
+    let span = plan.stock.span_vec();
+    let init_cm3 = plan.stock.initial_cm3();
+    let first_q = plan.setups[0].rot_q;
+    let footer_right = match plan.part_volume_cm3 {
+        Some(pv) => format!("{}  |  CAD {pv:.1}cm3  |  Cell {:.2}mm", plan.stock_label, plan.stock.cell),
+        None => format!("{}  |  Cell {:.2}mm", plan.stock_label, plan.stock.cell),
+    };
+    let rendered_segs_sum: f64 = plan
+        .setups
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| target_idx.is_none_or(|t| *i == t))
+        .map(|(_, s)| (s.ops.len().max(1) as f64).powf(0.8))
+        .sum::<f64>()
+        .max(1e-6);
+
+    let mut total_frames = 0usize;
+    let mut spin_phase = 0.0f32;
+    let mut prev_q: Option<[f32; 4]> = None;
+    let mut prev_az_bias = 0.0f32;
+    let mut per_setup_files = Vec::new();
+    let mut keyframes = Vec::new();
+    let mut reports = Vec::with_capacity(plan.setups.len());
+    let kf_dir = opts.keyframes_dir.as_deref();
+    let mut trail_buf: VecDeque<TrailSeg> = VecDeque::with_capacity(MAX_TRAIL_SEGS);
+    let mut trail_slice: Vec<TrailSeg> = Vec::with_capacity(MAX_TRAIL_SEGS);
+
+    for (si, setup) in plan.setups.iter().enumerate() {
+        let seg_total: usize = setup.ops.iter().map(|o| o.segs.len()).sum();
+        if let Some(t) = target_idx
+            && si > t
+        {
+            break;
+        }
+        let render_this = target_idx.is_none_or(|t| si == t);
+        if !render_this {
+            // Silently carve earlier setups so the requested setup starts from carried stock.
+            for op in &setup.ops {
+                for seg in &op.segs {
+                    if !seg.is_rapid {
+                        let ax = seg.axis_part.unwrap_or(setup.spindle_axis_part);
+                        plan.stock.sweep_segment(seg.a_part, seg.b_part, ax, &op.tool);
+                    }
+                }
+            }
+            reports.push(SetupReport {
+                name: setup.name.clone(),
+                wcs: setup.wcs_label.clone(),
+                operations: setup.ops.len(),
+                segments: seg_total,
+                rendered: false,
+                frames: 0,
+                remaining_cm3: round2(plan.stock.volume_cm3()),
+                removed_pct: round2(plan.stock.removed_pct()),
+                file: None,
+            });
+            continue;
+        }
+
+        let stag = format!("{:02}_{}", si + 1, sanitize_tag(&setup.name));
+        let mut side_file: Option<String> = None;
+        let mut side_sink: Option<FrameSink> = if opts.per_setup && target_idx.is_none() {
+            let sp = per_setup_path(&opts.output, resolved_fmt, si, &setup.name);
+            let s = FrameSink::open(&sp, resolved_fmt, opts.width, opts.height, opts.fps)?;
+            side_file = Some(sp.display().to_string());
+            per_setup_files.push(sp.display().to_string());
+            Some(s)
+        } else {
+            None
+        };
+
+        let setup_title = format!("SETUP {}/{}: {} ({})", si + 1, plan.setups.len(), setup.name, setup.wcs_label);
+        let footer_left = "CamCraft 3D Stock Simulation  |  blue:feed  amber:plunge  red:rapid";
+        let (bars, total_segs) = setup_bars(setup);
+        let mut setup_frames = 0usize;
+
+        let rot = Mat3::from_quat(setup.rot_q);
+        let cur_az_bias = setup_az_bias(opts.view, setup, rot, center, span);
+
+        // Smooth flip/turn transition between differently oriented setups.
+        if let Some(pq) = prev_q
+            && quats_differ(pq, setup.rot_q)
+            && trans_frames > 0
+        {
+            let banner = format!("M0 STOP - RE-ORIENT PART -> {} ({})", setup.name, setup.wcs_label);
+            let rem = plan.stock.volume_cm3();
+            let pct = plan.stock.removed_pct();
+            for f in 0..trans_frames {
+                let t = smoothstep((f as f32 + 1.0) / trans_frames as f32);
+                let q = quat_slerp(pq, setup.rot_q, t);
+                let t_rot = Mat3::from_quat(q);
+                let az = prev_az_bias + (cur_az_bias - prev_az_bias) * t - 10.0 * t;
+                let cam = orbit_camera(opts.view, span, az, 4.0 * (t * std::f32::consts::PI).sin(), opts.width, opts.height);
+                let table_z = plan.stock.lowest_display_z(t_rot, center) - 1.2;
+                let hud = opts.hud.then_some(HudInfo {
+                    setup_title: &setup_title,
+                    op_title: "RE-CLAMPING WORKPIECE...",
+                    tool_badge: "",
+                    rpm: 0.0,
+                    feed: 0.0,
+                    is_rapid: false,
+                    show_tool: false,
+                    wcs_pos: [0.0; 3],
+                    remaining_cm3: rem,
+                    removed_pct: pct,
+                    progress_frac: 0.0,
+                    footer_left,
+                    footer_right: &footer_right,
+                    banner: &banner,
+                    move_num: 0,
+                    bars: &bars,
+                    total_segs,
+                });
+                render_frame(
+                    &FrameParams {
+                        stock: &plan.stock,
+                        cam,
+                        part_rot: t_rot,
+                        part_center: center,
+                        spindle_axis_part: setup.spindle_axis_part,
+                        show_tool: false,
+                        tool_tip_part: Vec3::ZERO,
+                        tool: None,
+                        spin_phase: 0.0,
+                        is_cutting: false,
+                        show_toolpath: false,
+                        trail: &[],
+                        hud,
+                        table_z,
+                    },
+                    &mut rgb,
+                    &mut zbuf,
+                );
+                main_sink.write_frame(&rgb)?;
+                total_frames += 1;
+            }
+        }
+        prev_q = Some(setup.rot_q);
+        prev_az_bias = cur_az_bias + 18.0;
+
+        let table_z = plan.stock.lowest_display_z(rot, center) - 1.2;
+        if hold_frames > 0 {
+            let cam = orbit_camera(opts.view, span, cur_az_bias - 10.0, 0.0, opts.width, opts.height);
+            let hud = opts.hud.then_some(HudInfo {
+                setup_title: &setup_title,
+                op_title: "INCOMING STOCK",
+                tool_badge: "",
+                rpm: 0.0,
+                feed: 0.0,
+                is_rapid: false,
+                show_tool: false,
+                wcs_pos: [0.0; 3],
+                remaining_cm3: plan.stock.volume_cm3(),
+                removed_pct: plan.stock.removed_pct(),
+                progress_frac: 0.0,
+                footer_left,
+                footer_right: &footer_right,
+                banner: "",
+                move_num: 0,
+                bars: &bars,
+                total_segs,
+            });
+            render_frame(
+                &FrameParams {
+                    stock: &plan.stock,
+                    cam,
+                    part_rot: rot,
+                    part_center: center,
+                    spindle_axis_part: setup.spindle_axis_part,
+                    show_tool: false,
+                    tool_tip_part: Vec3::ZERO,
+                    tool: None,
+                    spin_phase: 0.0,
+                    is_cutting: false,
+                    show_toolpath: false,
+                    trail: &[],
+                    hud,
+                    table_z,
+                },
+                &mut rgb,
+                &mut zbuf,
+            );
+            save_keyframe(kf_dir, &format!("{stag}_start"), opts.width, opts.height, &rgb, &mut keyframes)?;
+            for _ in 0..hold_frames {
+                push_frame(&rgb, &mut main_sink, side_sink.as_mut(), &mut total_frames, &mut setup_frames)?;
+            }
+        }
+
+        let share = ((setup.ops.len().max(1) as f64).powf(0.8) / rendered_segs_sum * total_cut_frames as f64)
+            .round()
+            .max(setup.ops.len() as f64) as usize;
+        let op_frames = allocate_op_frames(&setup.ops, share);
+        let mut segs_done = 0usize;
+        trail_buf.clear();
+
+        for (oi, op) in setup.ops.iter().enumerate() {
+            let nf = op_frames[oi].max(1);
+            let op_n = op.segs.len();
+            if op_n == 0 {
+                continue;
+            }
+            let op_title = format!("OP {}/{}: {} [{}]", oi + 1, setup.ops.len(), op.name, op.kind_label);
+            let mut cur_idx = 0usize;
+            let mid_f = nf / 2;
+            trail_buf.clear();
+
+            for f in 0..nf {
+                let next_idx = ((f + 1) * op_n).div_ceil(nf).min(op_n);
+                let batch = next_idx.saturating_sub(cur_idx);
+                let trail_stride = (batch / 10).max(1);
+                let mut carved_any = false;
+                for i in cur_idx..next_idx {
+                    let seg = &op.segs[i];
+                    if !seg.is_rapid {
+                        let ax = seg.axis_part.unwrap_or(setup.spindle_axis_part);
+                        if plan.stock.sweep_segment(seg.a_part, seg.b_part, ax, &op.tool) > 0 {
+                            carved_any = true;
+                        }
+                    }
+                    if opts.toolpath && ((i - cur_idx).is_multiple_of(trail_stride) || i + 1 == next_idx) {
+                        if trail_buf.len() >= MAX_TRAIL_SEGS {
+                            trail_buf.pop_front();
+                        }
+                        trail_buf.push_back(TrailSeg {
+                            a_part: seg.a_part,
+                            b_part: seg.b_part,
+                            is_rapid: seg.is_rapid,
+                            is_plunge: seg.is_plunge,
+                        });
+                    }
+                }
+                let last_i = next_idx.saturating_sub(1);
+                let last_seg = &op.segs[last_i];
+                let seg_prog = segs_done + next_idx;
+                let setup_frac = if total_segs > 0 { seg_prog as f32 / total_segs as f32 } else { 1.0 };
+                let az_off = cur_az_bias - 10.0 + 28.0 * setup_frac;
+                let cam = orbit_camera(opts.view, span, az_off, 0.0, opts.width, opts.height);
+                spin_phase += 0.9;
+                trail_slice.clear();
+                trail_slice.extend(trail_buf.iter().copied());
+                let hud = opts.hud.then_some(HudInfo {
+                    setup_title: &setup_title,
+                    op_title: &op_title,
+                    tool_badge: &op.tool.label,
+                    rpm: op.rpm,
+                    feed: last_seg.feed,
+                    is_rapid: last_seg.is_rapid,
+                    show_tool: true,
+                    wcs_pos: last_seg.wcs_b,
+                    remaining_cm3: plan.stock.volume_cm3(),
+                    removed_pct: plan.stock.removed_pct(),
+                    progress_frac: setup_frac,
+                    footer_left,
+                    footer_right: &footer_right,
+                    banner: "",
+                    move_num: last_seg.move_no,
+                    bars: &bars,
+                    total_segs,
+                });
+                let tip_axis = last_seg.axis_part.unwrap_or(setup.spindle_axis_part);
+                render_frame(
+                    &FrameParams {
+                        stock: &plan.stock,
+                        cam,
+                        part_rot: rot,
+                        part_center: center,
+                        spindle_axis_part: tip_axis,
+                        show_tool: true,
+                        tool_tip_part: last_seg.b_part,
+                        tool: Some(&op.tool),
+                        spin_phase,
+                        is_cutting: carved_any && !last_seg.is_rapid,
+                        show_toolpath: opts.toolpath,
+                        trail: &trail_slice,
+                        hud,
+                        table_z,
+                    },
+                    &mut rgb,
+                    &mut zbuf,
+                );
+                push_frame(&rgb, &mut main_sink, side_sink.as_mut(), &mut total_frames, &mut setup_frames)?;
+                if f == mid_f {
+                    save_keyframe(
+                        kf_dir,
+                        &format!("{stag}_op{:02}_mid", oi + 1),
+                        opts.width,
+                        opts.height,
+                        &rgb,
+                        &mut keyframes,
+                    )?;
+                }
+                cur_idx = next_idx;
+            }
+            segs_done += op_n;
+        }
+
+        // Write a turntable check at the end of per-setup split videos and the final program spin.
+        let is_last_rendered = target_idx.is_some() || si + 1 == plan.setups.len();
+        let upright_back = quats_differ(setup.rot_q, first_q).then_some(first_q);
+        if let Some(mut side) = side_sink {
+            let side_spin = if is_last_rendered {
+                spin_frames
+            } else if spin_frames == 0 {
+                0
+            } else {
+                (spin_frames / 2).max(1)
+            };
+            let banner = format!("{} COMPLETE - {:.1} cm3 REMAINING", setup.name, plan.stock.volume_cm3());
+            let mut sc = SpinCtx {
+                stock: &plan.stock,
+                center,
+                span,
+                view: opts.view,
+                w: opts.width,
+                h: opts.height,
+                show_hud: opts.hud,
+                base_q: setup.rot_q,
+                upright_q: if is_last_rendered { upright_back } else { None },
+                setup_title: &setup_title,
+                banner: &banner,
+                footer_left,
+                footer_right: &footer_right,
+                bars: &bars,
+                total_segs,
+                rgb: &mut rgb,
+                zbuf: &mut zbuf,
+            };
+            let half = side_spin / 2;
+            let last_f = side_spin.saturating_sub(1);
+            emit_spin_frames(&mut sc, side_spin, cur_az_bias + 18.0, 360.0, |f, buf| {
+                side.write_frame(buf)?;
+                if is_last_rendered {
+                    main_sink.write_frame(buf)?;
+                    total_frames += 1;
+                }
+                setup_frames += 1;
+                if f == 0 {
+                    save_keyframe(kf_dir, &format!("{stag}_done"), opts.width, opts.height, buf, &mut keyframes)?;
+                } else if is_last_rendered && f == half {
+                    save_keyframe(kf_dir, &format!("{stag}_done_back"), opts.width, opts.height, buf, &mut keyframes)?;
+                } else if is_last_rendered && f == last_f {
+                    save_keyframe(kf_dir, &format!("{stag}_done_upright"), opts.width, opts.height, buf, &mut keyframes)?;
+                }
+                Ok(())
+            })?;
+            side.finish()?;
+        } else if is_last_rendered && spin_frames > 0 {
+            let banner = format!("SIMULATION COMPLETE - {:.1} cm3 REMAINING", plan.stock.volume_cm3());
+            let mut sc = SpinCtx {
+                stock: &plan.stock,
+                center,
+                span,
+                view: opts.view,
+                w: opts.width,
+                h: opts.height,
+                show_hud: opts.hud,
+                base_q: setup.rot_q,
+                upright_q: upright_back,
+                setup_title: &setup_title,
+                banner: &banner,
+                footer_left,
+                footer_right: &footer_right,
+                bars: &bars,
+                total_segs,
+                rgb: &mut rgb,
+                zbuf: &mut zbuf,
+            };
+            let last_f = spin_frames.saturating_sub(1);
+            emit_spin_frames(&mut sc, spin_frames, cur_az_bias + 18.0, 360.0, |f, buf| {
+                main_sink.write_frame(buf)?;
+                total_frames += 1;
+                setup_frames += 1;
+                if f == 0 {
+                    save_keyframe(kf_dir, &format!("{stag}_done"), opts.width, opts.height, buf, &mut keyframes)?;
+                } else if f == last_f {
+                    save_keyframe(kf_dir, &format!("{stag}_done_upright"), opts.width, opts.height, buf, &mut keyframes)?;
+                }
+                Ok(())
+            })?;
+        } else if kf_dir.is_some() {
+            save_keyframe(kf_dir, &format!("{stag}_done"), opts.width, opts.height, &rgb, &mut keyframes)?;
+        }
+
+        reports.push(SetupReport {
+            name: setup.name.clone(),
+            wcs: setup.wcs_label.clone(),
+            operations: setup.ops.len(),
+            segments: seg_total,
+            rendered: true,
+            frames: setup_frames,
+            remaining_cm3: round2(plan.stock.volume_cm3()),
+            removed_pct: round2(plan.stock.removed_pct()),
+            file: side_file,
+        });
+    }
+
+    main_sink.finish()?;
+    Ok(VideoReport {
+        output: opts.output.display().to_string(),
+        format: resolved_fmt.as_str().to_string(),
+        width: opts.width,
+        height: opts.height,
+        fps: opts.fps,
+        view: opts.view.as_str().to_string(),
+        total_frames,
+        duration_s: round2(total_frames as f64 / f64::from(opts.fps)),
+        cell_mm: round2(f64::from(plan.stock.cell)),
+        grid: [plan.stock.nx, plan.stock.ny, plan.stock.nz],
+        initial_cm3: round2(init_cm3),
+        remaining_cm3: round2(plan.stock.volume_cm3()),
+        removed_pct: round2(plan.stock.removed_pct()),
+        part_volume_cm3: plan.part_volume_cm3.map(round2),
+        part_size_mm: plan.part_size_mm.map(|s| [round2(s[0]), round2(s[1]), round2(s[2])]),
+        per_setup_files,
+        keyframes,
+        setups: reports,
+    })
+}
diff --git a/crates/app/src/sim_video/plan.rs b/crates/app/src/sim_video/plan.rs
new file mode 100644
index 000000000..2a10983ec
--- /dev/null
+++ b/crates/app/src/sim_video/plan.rs
@@ -0,0 +1,392 @@
+//! Extracts setups, rigid transforms, tools, stock solid, and chord-tessellated toolpaths
+//! from a live `World` in part/document coordinates for `sim_video`.
+//!
+//! Provenance: reads CamCraft's own ECS world (`setup`, `setup_align`, `model`, `posting`).
+
+use flecs_ecs::prelude::World;
+
+use super::math::Vec3;
+use super::voxel::{
+    SimTool, ToolShape, VoxelStock, TAG_BALL, TAG_BORE, TAG_BULL, TAG_CHAMFER, TAG_DRILL, TAG_FACED, TAG_FLAT_FIN,
+    TAG_RECESS_BALL, TAG_RECESS_FLAT, TAG_ROUGH, TAG_SIDE_FINISH,
+};
+use crate::cl::MoveKind;
+use crate::geometry::{quat_rotate_point, transform_point, Point3};
+use crate::model;
+use crate::operation::OpParams;
+use crate::schema::Location;
+use crate::setup;
+use crate::setup_align;
+use crate::stock::StockShape;
+use crate::tools::ToolKind;
+
+#[derive(Clone, Debug)]
+pub(super) struct VideoSeg {
+    pub a_part: Vec3,
+    pub b_part: Vec3,
+    pub axis_part: Option<Vec3>,
+    pub wcs_b: [f32; 3],
+    pub is_rapid: bool,
+    pub is_plunge: bool,
+    pub feed: f64,
+    pub move_no: usize,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct VideoOp {
+    pub name: String,
+    pub kind_label: String,
+    pub tool: SimTool,
+    pub rpm: f64,
+    pub segs: Vec<VideoSeg>,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct VideoSetup {
+    pub name: String,
+    pub wcs_label: String,
+    /// Unit quaternion rotating part/document coords into this setup's table orientation (Z up).
+    pub rot_q: [f32; 4],
+    /// Unit spindle axis (`+Z_setup`) expressed in document/part frame.
+    pub spindle_axis_part: Vec3,
+    pub ops: Vec<VideoOp>,
+}
+
+pub(super) struct VideoPlan {
+    pub setups: Vec<VideoSetup>,
+    pub stock: VoxelStock,
+    pub stock_label: String,
+    pub part_volume_cm3: Option<f64>,
+    pub part_size_mm: Option<[f64; 3]>,
+}
+
+fn p3_to_v3(p: Point3) -> Vec3 {
+    Vec3::new(p.x as f32, p.y as f32, p.z as f32)
+}
+
+fn wcs_label_for(world: &World, setup_name: Option<&str>) -> String {
+    let slot = setup::wcs_slot(world, setup_name);
+    if slot < 6 {
+        format!("G{}", 54 + slot)
+    } else {
+        format!("G54.1P{}", slot - 5)
+    }
+}
+
+fn wcs_origin_in_setup(world: &World, setup_name: Option<&str>) -> Point3 {
+    setup::wcs_entity(world, setup_name)
+        .and_then(|e| model::transform_of(world, &e))
+        .map_or(Point3::ZERO, |loc| loc.pos)
+}
+
+fn to_doc_location(world: &World, setup_name: Option<&str>) -> Location {
+    setup_name
+        .and_then(|s| setup_align::stored(world, s))
+        .unwrap_or_default()
+}
+
+fn op_tag_and_label(params: &OpParams, kind: ToolKind, setup_idx: usize, is_side_on: bool) -> (u8, &'static str) {
+    match params {
+        OpParams::Face { .. } => (TAG_FACED, "Face"),
+        OpParams::Drill { .. } => (TAG_DRILL, "Drill"),
+        OpParams::Bore { .. } | OpParams::Circular { .. } | OpParams::Thread { .. } => (TAG_BORE, "Bore"),
+        OpParams::Chamfer2D { .. } | OpParams::Deburr { .. } => (TAG_CHAMFER, "Chamfer"),
+        OpParams::Contour { .. } | OpParams::Contour5D { .. } => {
+            if is_side_on {
+                (TAG_SIDE_FINISH, "Contour")
+            } else {
+                (TAG_FLAT_FIN, "Contour")
+            }
+        }
+        OpParams::Finish3D { .. } => (if setup_idx == 1 { TAG_RECESS_BALL } else { TAG_BALL }, "3D Finish"),
+        OpParams::Pocket3D { stock_to_leave, .. } => match kind {
+            ToolKind::BallNose => (if setup_idx == 1 { TAG_RECESS_BALL } else { TAG_BALL }, "3D Ball"),
+            ToolKind::BullNose => (TAG_BULL, "3D Bull"),
+            _ if *stock_to_leave > 0.05 => (if setup_idx == 1 { TAG_RECESS_FLAT } else { TAG_ROUGH }, "3D Rough"),
+            _ => (if setup_idx == 1 { TAG_RECESS_FLAT } else { TAG_FLAT_FIN }, "3D Pocket"),
+        },
+        OpParams::Pocket { .. } | OpParams::Adaptive2D { .. } | OpParams::Offset2D { .. } => {
+            if setup_idx == 1 { (TAG_RECESS_FLAT, "2D Pocket") } else { (TAG_ROUGH, "2D Pocket") }
+        }
+        _ => match kind {
+            ToolKind::BallNose => (TAG_BALL, "Ball"),
+            ToolKind::BullNose => (TAG_BULL, "Bull"),
+            ToolKind::Drill => (TAG_DRILL, "Drill"),
+            ToolKind::Taper => (TAG_CHAMFER, "Chamfer"),
+            _ => (TAG_FLAT_FIN, "Mill"),
+        },
+    }
+}
+
+fn tool_shape_and_label(tool: &crate::tools::Tool, tnum: u32, tag: u8, is_side_on: bool, z_span: f32) -> SimTool {
+    let shape = match tool.kind {
+        ToolKind::BallNose => ToolShape::Ball,
+        ToolKind::BullNose if tool.corner_r > 0.0 => ToolShape::Bull,
+        ToolKind::Drill => ToolShape::Drill,
+        ToolKind::Taper => ToolShape::Chamfer,
+        _ => ToolShape::Flat,
+    };
+    let d = tool.diameter.max(0.1) as f32;
+    let flute = if tool.flute_len > 0.1 { tool.flute_len as f32 } else { (d * 2.5).max(10.0) };
+    let shank = if tool.shank_len > 0.1 { tool.shank_len as f32 } else { (d * 2.0).max(15.0) };
+    let total = flute + shank;
+    let holder_d = if tool.holder_d > d as f64 { tool.holder_d as f32 } else { (d * 2.6).max(24.0) };
+    let tip_angle = if tool.tip_angle > 1.0 {
+        tool.tip_angle as f32
+    } else if shape == ToolShape::Drill {
+        118.0
+    } else {
+        90.0
+    };
+    let kind_txt = match shape {
+        ToolShape::Flat => "Flat EM",
+        ToolShape::Ball => "Ball-Nose",
+        ToolShape::Bull => "Bull-Nose",
+        ToolShape::Drill => "Drill",
+        ToolShape::Chamfer => "Chamfer",
+    };
+    let label = format!("T{:02} {kind_txt} D{d:.1}", tnum);
+    // Keep side-on contour cutters strictly inside their axial window so a relieved-shank end
+    // mill working on a lower ear/flange does not re-paint an upper wall.
+    let cut_height = match shape {
+        ToolShape::Chamfer => (d * 0.5) / ((tip_angle * 0.5).to_radians().tan().max(1e-3)) + 0.2,
+        ToolShape::Flat if is_side_on && tag == TAG_SIDE_FINISH => (z_span + 0.5).clamp(2.0, flute),
+        ToolShape::Flat | ToolShape::Drill => {
+            if is_side_on { flute } else { total }
+        }
+        ToolShape::Ball | ToolShape::Bull => flute,
+    };
+    SimTool {
+        shape,
+        diameter: d,
+        corner_r: tool.corner_r as f32,
+        tip_angle_deg: tip_angle,
+        flute_len: flute,
+        total_len: total,
+        holder_d,
+        label,
+        tag,
+        cut_height,
+    }
+}
+
+/// Signed triangle mesh volume in cm^3 for any watertight part mesh in the document frame.
+fn part_mesh_stats(world: &World) -> (Option<f64>, Option<[f64; 3]>) {
+    let skip = crate::stock_source::stock_only_model(world);
+    let mut vol6 = 0.0f64;
+    let mut any = false;
+    let (mut lo, mut hi) = (
+        Point3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
+        Point3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
+    );
+    for (_, e) in model::model_entities(world) {
+        if !crate::stock_source::judged(world, &e, skip) {
+            continue;
+        }
+        let Some(tris) = model::facets_of(world, &e) else { continue };
+        let l = model::transform_of(world, &e).unwrap_or_default();
+        for t in tris.iter() {
+            any = true;
+            let a = transform_point(t.a, l.pos, l.rot);
+            let b = transform_point(t.b, l.pos, l.rot);
+            let c = transform_point(t.c, l.pos, l.rot);
+            vol6 += a.dot(b.cross(c));
+            for p in [a, b, c] {
+                lo = Point3::new(lo.x.min(p.x), lo.y.min(p.y), lo.z.min(p.z));
+                hi = Point3::new(hi.x.max(p.x), hi.y.max(p.y), hi.z.max(p.z));
+            }
+        }
+    }
+    if !any {
+        return (None, None);
+    }
+    let vol_cm3 = (vol6.abs() / 6.0) / 1000.0;
+    let size = [hi.x - lo.x, hi.y - lo.y, hi.z - lo.z];
+    let v = (vol_cm3.is_finite() && vol_cm3 > 1e-4).then_some(vol_cm3);
+    let s = size.iter().all(|x| x.is_finite() && *x >= 0.0).then_some(size);
+    (v, s)
+}
+
+/// Build the initial voxel stock billet from the first setup's stock in document frame.
+fn build_initial_stock(world: &World, first_setup: Option<&str>, cell_override: Option<f64>) -> Result<(VoxelStock, String), String> {
+    let stock_name = setup::stock_entity_name(world, first_setup);
+    let e = model::find_by_name(world, &stock_name)
+        .ok_or_else(|| format!("no stock '{stock_name}' defined in document"))?;
+    let aabb = model::stock_world_aabb_for(world, first_setup)
+        .ok_or_else(|| format!("stock '{stock_name}' has no finite bounding box"))?;
+    let align = to_doc_location(world, first_setup);
+    let inv = setup_align::inverse(align);
+    let mut lo = Point3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY);
+    let mut hi = Point3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY);
+    for x in [aabb.min.x, aabb.max.x] {
+        for y in [aabb.min.y, aabb.max.y] {
+            for z in [aabb.min.z, aabb.max.z] {
+                let p = transform_point(Point3::new(x, y, z), inv.pos, inv.rot);
+                lo = Point3::new(lo.x.min(p.x), lo.y.min(p.y), lo.z.min(p.z));
+                hi = Point3::new(hi.x.max(p.x), hi.y.max(p.y), hi.z.max(p.z));
+            }
+        }
+    }
+    let (sx, sy, sz) = (hi.x - lo.x, hi.y - lo.y, hi.z - lo.z);
+    if !(sx.is_finite() && sy.is_finite() && sz.is_finite() && sx > 0.0 && sy > 0.0 && sz > 0.0) {
+        return Err("stock has degenerate dimensions".into());
+    }
+    // Auto-select voxel pitch (~14M voxels target) unless the caller specifies `cell_mm`.
+    let target_voxels = 14_000_000.0f64;
+    let cell = match cell_override {
+        Some(c) if c.is_finite() && c > 0.0 => c,
+        Some(c) => return Err(format!("cell size must be positive and finite, got {c}")),
+        None => ((sx * sy * sz) / target_voxels).cbrt().clamp(0.20, 4.0),
+    };
+    let est = (sx / cell).ceil() * (sy / cell).ceil() * (sz / cell).ceil();
+    if !est.is_finite() || est > 120_000_000.0 {
+        return Err(format!(
+            "voxel cell {cell:.3} mm would allocate {:.1}M voxels (max 120M) - choose a larger cell size",
+            est / 1_000_000.0
+        ));
+    }
+    let mut stock = VoxelStock::from_box(p3_to_v3(lo), p3_to_v3(hi), cell as f32);
+    if let Some(shape) = model::stock_def_of(world, &e) {
+        match shape {
+            StockShape::Box { .. } => {}
+            StockShape::Cylinder { diameter, .. } => {
+                let c = stock.center();
+                stock.mask_cylinder_z(c.x, c.y, (diameter * 0.5) as f32);
+            }
+            StockShape::FromModel { .. } => {
+                if let Some(tris) = model::facets_of(world, &e) {
+                    let loc = model::transform_of(world, &e).unwrap_or_default();
+                    let world_tris: Vec<_> = tris
+                        .iter()
+                        .map(|t| {
+                            let map = |pt: Point3| {
+                                let wpt = transform_point(pt, loc.pos, loc.rot);
+                                transform_point(wpt, inv.pos, inv.rot)
+                            };
+                            crate::geometry::Triangle::new(map(t.a), map(t.b), map(t.c))
+                        })
+                        .collect();
+                    stock.mask_mesh(&world_tris);
+                }
+            }
+        }
+    }
+    let label = format!("Stock {sx:.0}x{sy:.0}x{sz:.0}mm");
+    Ok((stock, label))
+}
+
+/// Gather the full generated multi-setup program in part/document world coordinates.
+pub(super) fn gather_plan(world: &World, cell_mm: Option<f64>) -> Result<VideoPlan, String> {
+    let ordered = crate::posting::program_ops(world)?;
+    if ordered.is_empty() {
+        return Err("no operations in program to simulate".into());
+    }
+    let first_setup = model::operation_of(world, &ordered[0].1)
+        .and_then(|op| setup::effective(world, op.setup.as_deref()));
+    let (stock, stock_label) = build_initial_stock(world, first_setup.as_deref(), cell_mm)?;
+    let chord_tol = (f64::from(stock.cell) * 0.5).clamp(0.05, 0.4);
+
+    let mut setups: Vec<VideoSetup> = Vec::new();
+    for (op_name, op_ent) in ordered {
+        let op = model::operation_of(world, &op_ent)
+            .ok_or_else(|| format!("{op_name}: lost operation component"))?;
+        let tp = model::toolpath_of(world, &op_ent)
+            .ok_or_else(|| format!("{op_name}: has no generated toolpath (run generate first)"))?;
+        let moves = &tp.path.moves;
+        if moves.is_empty() {
+            continue;
+        }
+        let eff_setup = setup::effective(world, op.setup.as_deref());
+        let s_name = eff_setup.clone().unwrap_or_else(|| "Setup1".to_string());
+        let need_new = setups.last().is_none_or(|cur| cur.name != s_name);
+        if need_new {
+            let align = to_doc_location(world, eff_setup.as_deref());
+            let inv = setup_align::inverse(align);
+            let axis = quat_rotate_point(inv.rot, Point3::new(0.0, 0.0, 1.0));
+            let q = align.rot;
+            setups.push(VideoSetup {
+                name: s_name.clone(),
+                wcs_label: wcs_label_for(world, eff_setup.as_deref()),
+                rot_q: [q[0] as f32, q[1] as f32, q[2] as f32, q[3] as f32],
+                spindle_axis_part: p3_to_v3(axis).norm(),
+                ops: Vec::new(),
+            });
+        }
+        let setup_idx = setups.len() - 1;
+        let is_side_on = setups[setup_idx].spindle_axis_part.z.abs() < 0.5;
+        let align = to_doc_location(world, eff_setup.as_deref());
+        let inv = setup_align::inverse(align);
+        let wcs_org = wcs_origin_in_setup(world, eff_setup.as_deref());
+
+        let _tool_ent = model::find_by_name(world, &op.tool)
+            .ok_or_else(|| format!("{op_name}: missing tool '{}'", op.tool))?;
+        let tool_def = model::tool_of(world, &_tool_ent)
+            .ok_or_else(|| format!("{op_name}: tool '{}' has no definition", op.tool))?;
+        let tnum = crate::tool_numbers::number_of(world, &op.tool).unwrap_or(1);
+
+        let (tag, kind_label) = op_tag_and_label(&op.params, tool_def.kind, setup_idx, is_side_on);
+        let (mut zmin, mut zmax) = (f64::INFINITY, f64::NEG_INFINITY);
+        for m in moves {
+            if m.kind != MoveKind::Rapid {
+                zmin = zmin.min(m.from.z).min(m.to.z);
+                zmax = zmax.max(m.from.z).max(m.to.z);
+            }
+        }
+        let z_span = if zmin.is_finite() && zmax.is_finite() { (zmax - zmin) as f32 } else { 12.0 };
+        let sim_tool = tool_shape_and_label(&tool_def, tnum, tag, is_side_on, z_span);
+
+        let to_part = |pt: Point3| p3_to_v3(transform_point(pt, inv.pos, inv.rot));
+        let to_wcs = |pt: Point3| [
+            (pt.x - wcs_org.x) as f32,
+            (pt.y - wcs_org.y) as f32,
+            (pt.z - wcs_org.z) as f32,
+        ];
+
+        let mut segs = Vec::with_capacity(moves.len());
+        for (mi, m) in moves.iter().enumerate() {
+            let is_rapid = m.kind == MoveKind::Rapid;
+            let is_plunge = m.kind == MoveKind::Plunge;
+            let feed = m.feed.unwrap_or(tool_def.feed);
+            let axis_part = m.axis.map(|ax| {
+                p3_to_v3(quat_rotate_point(inv.rot, Point3::new(ax[0], ax[1], ax[2]))).norm()
+            });
+            let push_seg = |segs: &mut Vec<VideoSeg>, a: Point3, b: Point3, rapid: bool| {
+                segs.push(VideoSeg {
+                    a_part: to_part(a),
+                    b_part: to_part(b),
+                    axis_part,
+                    wcs_b: to_wcs(b),
+                    is_rapid: rapid,
+                    is_plunge,
+                    feed,
+                    move_no: mi + 1,
+                });
+            };
+            if m.arc.is_none() || is_rapid {
+                push_seg(&mut segs, m.from, m.to, is_rapid);
+            } else {
+                let chords = m.segments3(chord_tol);
+                if chords.is_empty() {
+                    push_seg(&mut segs, m.from, m.to, false);
+                } else {
+                    for (a, b) in chords {
+                        push_seg(&mut segs, a, b, false);
+                    }
+                }
+            }
+        }
+        setups[setup_idx].ops.push(VideoOp {
+            name: op_name,
+            kind_label: kind_label.to_string(),
+            tool: sim_tool,
+            rpm: tool_def.rpm,
+            segs,
+        });
+    }
+
+    if setups.iter().all(|s| s.ops.is_empty()) {
+        return Err("no generated toolpath moves to simulate".into());
+    }
+    let (part_volume_cm3, part_size_mm) = part_mesh_stats(world);
+    Ok(VideoPlan { setups, stock, stock_label, part_volume_cm3, part_size_mm })
+}
