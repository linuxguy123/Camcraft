+//! `render_simulation_video`: MCP and script door for the built-in 3D
+//! multi-setup stock-simulation movie renderer (`crate::sim_video`).
+//!
+//! Provenance: exposes `sim_video::render_simulation_video` over the same
+//! JSON-RPC tool table used by both `camcraft-cli mcp` and `cam.call(...)`.
+
+use std::path::PathBuf;
+
+use serde_json::{json, Map, Value};
+
+use super::tools::{opt_str, req_str};
+use crate::script::Env;
+use crate::sim_video::{
+    render_simulation_video, CameraView, VideoFormat, VideoOptions, DEFAULT_FPS, DEFAULT_HEIGHT, DEFAULT_WIDTH,
+    MAX_EDGE, MIN_EDGE,
+};
+
+pub(super) fn schema() -> Value {
+    json!({
+        "type": "object",
+        "properties": {
+            "output": { "type": "string", "description": "Output movie path (.mp4, .webm, .gif) or frame directory (for format=\"frames\")." },
+            "format": { "type": "string", "enum": ["auto", "mp4", "webm", "gif", "frames"], "description": "Output format; default auto (detected from extension, or PNG frames when none)." },
+            "setup": { "type": "string", "description": "Render only one setup (earlier setups are still simulated silently so incoming stock is exact)." },
+            "per_setup": { "type": "boolean", "description": "Also write one video (or frame folder) per setup alongside the combined output (default false)." },
+            "width": { "type": "integer", "minimum": MIN_EDGE, "maximum": MAX_EDGE, "description": "Frame width in pixels (default 960; must be even for mp4/webm)." },
+            "height": { "type": "integer", "minimum": MIN_EDGE, "maximum": MAX_EDGE, "description": "Frame height in pixels (default 540; must be even for mp4/webm)." },
+            "fps": { "type": "integer", "minimum": 1, "maximum": 120, "description": "Frames per second (default 30)." },
+            "cell_mm": { "type": "number", "description": "Voxel pitch in mm (auto-sized around ~14M voxels if omitted)." },
+            "view": { "type": "string", "enum": ["iso", "front-right", "top", "side"], "description": "Camera angle preset (default iso)." },
+            "toolpath": { "type": "boolean", "description": "Overlay live depth-tested 3D toolpath ribbon trail (default true)." },
+            "hud": { "type": "boolean", "description": "Overlay operation HUD, DRO readout, tool badge, and progress bar (default true)." },
+            "seconds": { "type": "number", "minimum": 0.0, "maximum": 600.0, "description": "Approximate total machining playback seconds across rendered setups (auto if omitted)." },
+            "transition_seconds": { "type": "number", "minimum": 0.0, "maximum": 600.0, "description": "Setup re-orientation flip/turn animation duration in seconds (default 1.1)." },
+            "spin_seconds": { "type": "number", "minimum": 0.0, "maximum": 600.0, "description": "End-of-program turntable inspection spin duration in seconds (default 3.0)." },
+            "keyframes_dir": { "type": "string", "description": "Optional directory to write representative PNG keyframes during the render." }
+        },
+        "required": ["output"],
+        "additionalProperties": false,
+    })
+}
+
+fn opt_u32(a: &Map<String, Value>, key: &str, default: u32, min: u32, max: u32) -> Result<u32, String> {
+    match a.get(key) {
+        None | Some(Value::Null) => Ok(default),
+        Some(v) => v
+            .as_u64()
+            .and_then(|n| u32::try_from(n).ok())
+            .filter(|n| (min..=max).contains(n))
+            .ok_or_else(|| format!("\"{key}\" must be an integer from {min} to {max}, got {v}")),
+    }
+}
+
+fn opt_bool(a: &Map<String, Value>, key: &str, default: bool) -> Result<bool, String> {
+    match a.get(key) {
+        None | Some(Value::Null) => Ok(default),
+        Some(Value::Bool(b)) => Ok(*b),
+        Some(other) => Err(format!("\"{key}\" must be a boolean, got {other}")),
+    }
+}
+
+fn opt_f64(a: &Map<String, Value>, key: &str) -> Result<Option<f64>, String> {
+    match a.get(key) {
+        None | Some(Value::Null) => Ok(None),
+        Some(v) => v
+            .as_f64()
+            .filter(|x| x.is_finite())
+            .map(Some)
+            .ok_or_else(|| format!("\"{key}\" must be a finite number, got {v}")),
+    }
+}
+
+pub(super) fn render_video(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let output = PathBuf::from(req_str(a, "output")?);
+    let format = match opt_str(a, "format")? {
+        None => VideoFormat::Auto,
+        Some(s) => VideoFormat::parse(s)?,
+    };
+    let view = match opt_str(a, "view")? {
+        None => CameraView::Iso,
+        Some(s) => CameraView::parse(s)?,
+    };
+    let opts = VideoOptions {
+        output,
+        format,
+        width: opt_u32(a, "width", DEFAULT_WIDTH, MIN_EDGE, MAX_EDGE)?,
+        height: opt_u32(a, "height", DEFAULT_HEIGHT, MIN_EDGE, MAX_EDGE)?,
+        fps: opt_u32(a, "fps", DEFAULT_FPS, 1, 120)?,
+        cell_mm: opt_f64(a, "cell_mm")?,
+        setup: opt_str(a, "setup")?.map(str::to_string),
+        per_setup: opt_bool(a, "per_setup", false)?,
+        toolpath: opt_bool(a, "toolpath", true)?,
+        hud: opt_bool(a, "hud", true)?,
+        view,
+        seconds: opt_f64(a, "seconds")?,
+        transition_seconds: opt_f64(a, "transition_seconds")?,
+        spin_seconds: opt_f64(a, "spin_seconds")?,
+        keyframes_dir: opt_str(a, "keyframes_dir")?.map(PathBuf::from),
+    };
+    let report = render_simulation_video(&env.world, &opts)?;
+    serde_json::to_value(report).map_err(|e| format!("serialise video report: {e}"))
+}
diff --git a/crates/app/src/sim_video/encode.rs b/crates/app/src/sim_video/encode.rs
new file mode 100644
index 000000000..7e1faf320
--- /dev/null
+++ b/crates/app/src/sim_video/encode.rs
@@ -0,0 +1,228 @@
+//! Frame output sinks for `sim_video`: pure-Rust PNG sequences via `png` and streamed video
+//! encoding (`.mp4`, `.webm`, `.gif`) via a piped `ffmpeg` process (native builds only).
+//!
+//! Provenance: `png` crate RGB8 encoding (W3C PNG spec) and `ffmpeg` stdin `rawvideo`/`rgb24`
+//! pipe interface.
+
+use std::fs::{self, File};
+use std::io::{BufWriter, Write};
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VideoFormat {
+    Auto,
+    Mp4,
+    Webm,
+    Gif,
+    Frames,
+}
+
+impl VideoFormat {
+    pub fn parse(s: &str) -> Result<Self, String> {
+        match s.to_ascii_lowercase().as_str() {
+            "auto" => Ok(Self::Auto),
+            "mp4" => Ok(Self::Mp4),
+            "webm" => Ok(Self::Webm),
+            "gif" => Ok(Self::Gif),
+            "frames" | "png" => Ok(Self::Frames),
+            other => Err(format!(
+                "unsupported format \"{other}\" (expected auto, mp4, webm, gif, or frames)"
+            )),
+        }
+    }
+
+    pub fn resolve(self, output: &Path) -> Self {
+        if self != Self::Auto {
+            return self;
+        }
+        match output
+            .extension()
+            .and_then(|e| e.to_str())
+            .map(str::to_ascii_lowercase)
+            .as_deref()
+        {
+            Some("mp4" | "m4v" | "mov") => Self::Mp4,
+            Some("webm") => Self::Webm,
+            Some("gif") => Self::Gif,
+            Some("png") | None => Self::Frames,
+            Some(_) => Self::Mp4,
+        }
+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Auto => "auto",
+            Self::Mp4 => "mp4",
+            Self::Webm => "webm",
+            Self::Gif => "gif",
+            Self::Frames => "frames",
+        }
+    }
+}
+
+/// Write one RGB24 buffer to a PNG file (pure Rust; no external dependencies).
+pub(super) fn write_png(path: &Path, width: u32, height: u32, rgb: &[u8]) -> Result<(), String> {
+    if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
+        fs::create_dir_all(parent).map_err(|e| format!("create dir {}: {e}", parent.display()))?;
+    }
+    let file = File::create(path).map_err(|e| format!("create {}: {e}", path.display()))?;
+    let mut enc = png::Encoder::new(BufWriter::new(file), width, height);
+    enc.set_color(png::ColorType::Rgb);
+    enc.set_depth(png::BitDepth::Eight);
+    let mut writer = enc.write_header().map_err(|e| format!("png header {}: {e}", path.display()))?;
+    writer.write_image_data(rgb).map_err(|e| format!("png write {}: {e}", path.display()))?;
+    Ok(())
+}
+
+pub(super) enum FrameSink {
+    Frames {
+        dir: PathBuf,
+        width: u32,
+        height: u32,
+        index: usize,
+    },
+    #[cfg(not(target_arch = "wasm32"))]
+    Ffmpeg {
+        path: PathBuf,
+        child: std::process::Child,
+        stdin: Option<std::process::ChildStdin>,
+        frames: usize,
+    },
+}
+
+impl FrameSink {
+    pub fn open(path: &Path, format: VideoFormat, width: u32, height: u32, fps: u32) -> Result<Self, String> {
+        let fmt = format.resolve(path);
+        match fmt {
+            VideoFormat::Frames => {
+                fs::create_dir_all(path).map_err(|e| format!("create frame directory {}: {e}", path.display()))?;
+                Ok(Self::Frames { dir: path.to_path_buf(), width, height, index: 0 })
+            }
+            VideoFormat::Mp4 | VideoFormat::Webm | VideoFormat::Gif | VideoFormat::Auto => {
+                #[cfg(target_arch = "wasm32")]
+                {
+                    let _ = (fps, width, height);
+                    Err("video encoding requires a native build (use format=\"frames\" for PNG output)".into())
+                }
+                #[cfg(not(target_arch = "wasm32"))]
+                {
+                    Self::spawn_ffmpeg(path, fmt, width, height, fps)
+                }
+            }
+        }
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    fn spawn_ffmpeg(path: &Path, fmt: VideoFormat, width: u32, height: u32, fps: u32) -> Result<Self, String> {
+        use std::process::{Command, Stdio};
+        if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
+            fs::create_dir_all(parent).map_err(|e| format!("create output dir {}: {e}", parent.display()))?;
+        }
+        // libx264/yuv420p requires even dimensions; callers already validate even sizes for video.
+        let mut cmd = Command::new("ffmpeg");
+        cmd.args([
+            "-y",
+            "-hide_banner",
+            "-loglevel",
+            "error",
+            "-f",
+            "rawvideo",
+            "-pix_fmt",
+            "rgb24",
+            "-s",
+            &format!("{width}x{height}"),
+            "-r",
+            &fps.to_string(),
+            "-i",
+            "-",
+        ]);
+        match fmt {
+            VideoFormat::Mp4 => {
+                cmd.args([
+                    "-c:v", "libx264", "-preset", "medium", "-crf", "19", "-pix_fmt", "yuv420p", "-movflags",
+                    "+faststart",
+                ]);
+            }
+            VideoFormat::Webm => {
+                cmd.args(["-c:v", "libvpx", "-crf", "10", "-b:v", "2200k", "-cpu-used", "2", "-an"]);
+            }
+            VideoFormat::Gif => {
+                cmd.args([
+                    "-vf",
+                    "split[s0][s1];[s0]palettegen=max_colors=192[p];[s1][p]paletteuse=dither=bayer",
+                ]);
+            }
+            VideoFormat::Frames | VideoFormat::Auto => {}
+        }
+        cmd.arg(path);
+        cmd.stdin(Stdio::piped()).stdout(Stdio::null()).stderr(Stdio::piped());
+        let mut child = cmd.spawn().map_err(|e| {
+            if e.kind() == std::io::ErrorKind::NotFound {
+                "ffmpeg was not found on PATH - install ffmpeg to encode MP4/WebM/GIF videos, or pass format=\"frames\" for pure-Rust PNG sequences".to_string()
+            } else {
+                format!("failed to start ffmpeg for {}: {e}", path.display())
+            }
+        })?;
+        let stdin = child.stdin.take();
+        Ok(Self::Ffmpeg { path: path.to_path_buf(), child, stdin, frames: 0 })
+    }
+
+    pub fn write_frame(&mut self, rgb: &[u8]) -> Result<(), String> {
+        match self {
+            Self::Frames { dir, width, height, index } => {
+                *index += 1;
+                let file = dir.join(format!("frame_{:05}.png", *index));
+                write_png(&file, *width, *height, rgb)
+            }
+            #[cfg(not(target_arch = "wasm32"))]
+            Self::Ffmpeg { path, stdin, frames, .. } => {
+                let pipe = stdin.as_mut().ok_or_else(|| format!("ffmpeg pipe closed for {}", path.display()))?;
+                pipe.write_all(rgb).map_err(|e| format!("write frame to ffmpeg ({}): {e}", path.display()))?;
+                *frames += 1;
+                Ok(())
+            }
+        }
+    }
+
+    pub fn finish(mut self) -> Result<usize, String> {
+        match &mut self {
+            Self::Frames { index, .. } => Ok(*index),
+            #[cfg(not(target_arch = "wasm32"))]
+            Self::Ffmpeg { path, child, stdin, frames } => {
+                drop(stdin.take());
+                let status = child
+                    .wait()
+                    .map_err(|e| format!("wait for ffmpeg ({}): {e}", path.display()))?;
+                if !status.success() {
+                    let mut msg = String::new();
+                    if let Some(mut se) = child.stderr.take() {
+                        let _ = std::io::Read::read_to_string(&mut se, &mut msg);
+                    }
+                    let detail = msg.trim();
+                    return Err(if detail.is_empty() {
+                        format!("ffmpeg exited with {status} while writing {}", path.display())
+                    } else {
+                        format!("ffmpeg failed writing {}: {detail}", path.display())
+                    });
+                }
+                Ok(*frames)
+            }
+        }
+    }
+}
+
+/// Derive a clean per-setup output path alongside `base` (e.g. `sim.mp4` -> `sim_01_OP10_Top.mp4`).
+pub(super) fn per_setup_path(base: &Path, format: VideoFormat, index: usize, setup_name: &str) -> PathBuf {
+    let clean: String = setup_name
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() || c == '_' || c == '-' { c } else { '_' })
+        .collect();
+    let tag = format!("{:02}_{}", index + 1, if clean.is_empty() { "setup" } else { &clean });
+    if format.resolve(base) == VideoFormat::Frames {
+        return base.join(tag);
+    }
+    let parent = base.parent().unwrap_or_else(|| Path::new(""));
+    let stem = base.file_stem().and_then(|s| s.to_str()).unwrap_or("simulation");
+    let ext = base.extension().and_then(|e| e.to_str()).unwrap_or(format.resolve(base).as_str());
+    parent.join(format!("{stem}_{tag}.{ext}"))
+}
