  {
    "sha": "8e6bb98751ec24a35b547e75c2b24d6632b7b082",
    "node_id": "C_kwDOVoU8JdoAKDhlNmJiOTg3NTFlYzI0YTM1YjU0N2U3NWMyYjI0ZDY2MzJiN2IwODI",
    "commit": {
      "author": {
        "name": "mkinney",
        "email": "mike.kinney@gmail.com",
        "date": "2026-11-22T11:38:21Z"
      },
