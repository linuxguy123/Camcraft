@@ -0,0 +1,20 @@
+## #3521 - The quick plan selects the suites that post the shipped examples
+
+**Decided:** `xtask/src/example_suites.rs` adds nine whole app suites to the quick plan when the diff
+touches `assets/posts/`, `assets/machines/`, `examples/`, `crates/post/src/` or `crates/motion/src/`:
+`example_catalog`, `example_catalog_adaptive`, `example_catalog_edge_work`, `first_part_programs`,
+`first_router_part`, `first_4axis_part`, `continuous_4axis_part`, `tilt_basis_compat` and
+`catalog_groove_part_off`. Each one posts a shipped example, compares a shipped `.nc`, or reads a posted
+catalog case. The list is fixed; a test pins that each name is an app test binary.
+
+**Why:** PR #3478 and PR #3464 passed review with a red `example_catalog` and `first_part_programs`.
+The content scan of `assets.rs` cannot find these suites: they read `examples/` and name no post
+script. A fixed list is the smallest rule that covers them.
+
+**Dropped:** `agie_native` (it reads an example only as input). The UI suites that render
+`examples/` projects (`catalog_render`, `egui_app`, `gpu_render`): no post output, and a UI build for
+each post change is too slow for quick. A list discovered from a scan of `examples/` in the test text:
+it also selects the input-only readers, and the wider selection problem is #3557.
+
+**Cost to change:** one line in `SUITES` or `INPUTS`. The heavy reach (`heavy.rs`) still uses only
+`map_catalog` and does not change.
diff --git a/xtask/src/example_suites.rs b/xtask/src/example_suites.rs
new file mode 100644
index 000000000..c31bced01
--- /dev/null
+++ b/xtask/src/example_suites.rs
@@ -0,0 +1,43 @@
+//! The quick tier's shipped-example rule (#3521): a change to a post script, a machine file, a shipped
+//! example, or the post or toolpath engine runs the app suites that post or read the shipped examples.
+//! Provenance: our own build law (AGENTS.md "Test the change, not everything"); the misses of PR #3478
+//! (`example_catalog`) and PR #3464 (`first_part_programs`, red main #3572).
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::Path;
+
+/// Inputs that change what a shipped example posts: post scripts, machine files, the shipped examples
+/// themselves, and the post and toolpath engines.
+const INPUTS: [&str; 5] = ["assets/posts/", "assets/machines/", "examples/", "crates/post/src/", "crates/motion/src/"];
+
+/// The `crates/app/tests` binaries that post a shipped example under `examples/`, compare a shipped `.nc`
+/// byte for byte, or regenerate a catalog case. A binary that only reads an example as input
+/// (`agie_native`) is not here.
+pub const SUITES: [&str; 9] = [
+    "example_catalog",
+    "example_catalog_adaptive",
+    "example_catalog_edge_work",
+    "first_part_programs",
+    "first_router_part",
+    "first_4axis_part",
+    "continuous_4axis_part",
+    "tilt_basis_compat",
+    "catalog_groove_part_off",
+];
+
+/// Adds the shipped-example suites (each one that exists) as whole app suites when the diff touches one
+/// of [`INPUTS`]. The catalog rule (#2393) runs first, so `examples/catalog/` keeps its own reason.
+pub fn map(root: &Path, changed: &[String], whole: &mut BTreeSet<String>, why: &mut BTreeMap<String, String>) {
+    crate::catalog::map_catalog(root, changed, whole, why);
+    let Some(hit) = changed.iter().find(|f| INPUTS.iter().any(|p| f.starts_with(p))) else {
+        return;
+    };
+    for bin in SUITES {
+        if !root.join(format!("crates/app/tests/{bin}.rs")).is_file() {
+            continue;
+        }
+        let key = format!("app:{bin}");
+        why.entry(key.clone()).or_insert_with(|| format!("{hit} can change a shipped example (#3521)"));
+        whole.insert(key);
+    }
+}
diff --git a/xtask/src/example_suites_tests.rs b/xtask/src/example_suites_tests.rs
new file mode 100644
index 000000000..1d02e8752
--- /dev/null
+++ b/xtask/src/example_suites_tests.rs
@@ -0,0 +1,78 @@
+//! Pins the quick tier's shipped-example rule (#3521): a post script, machine file, shipped example or
+//! engine change runs the suites that post the shipped examples; a docs-only change does not.
+//! Provenance: our own build law (AGENTS.md "Test the change, not everything").
+
+use std::path::{Path, PathBuf};
+
+use crate::example_suites::SUITES;
+use crate::quick::{self, Diff, Quick};
+
+fn root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).parent().map(Path::to_path_buf).unwrap_or_default()
+}
+
+/// The step names of the quick plan for a diff of `files` against the real tree.
+fn step_names(files: &[&str]) -> Vec<String> {
+    let changed: Vec<String> = files.iter().map(|s| s.to_string()).collect();
+    let hunks = |_: &str| -> Vec<String> { Vec::new() };
+    let diff = Diff { changed: &changed, untracked: &[], hunks: &hunks, before: &|_| None };
+    match quick::plan(&root(), &diff, false) {
+        Ok(Quick::Plan(p)) => p.steps.into_iter().map(|s| s.name).collect(),
+        other => panic!("{files:?} did not plan: {other:?}"),
+    }
+}
+
+const FOUR: [&str; 4] = [
+    "app suites: example_catalog",
+    "app suites: example_catalog_adaptive",
+    "app suites: example_catalog_edge_work",
+    "app suites: first_part_programs",
+];
+
+fn has_all(names: &[String], want: &[&str]) {
+    for w in want {
+        assert!(names.iter().any(|n| n == w), "{w} missing from {names:?}");
+    }
+}
+
+#[test]
+fn every_listed_example_suite_exists() {
+    for bin in SUITES {
+        assert!(root().join(format!("crates/app/tests/{bin}.rs")).is_file(), "{bin} is not an app test binary");
+    }
+}
+
+#[test]
+fn a_post_script_change_selects_the_shipped_example_suites() {
+    has_all(&step_names(&["assets/posts/grblhal.cps"]), &FOUR);
+}
+
+#[test]
+fn a_machine_file_change_selects_the_shipped_example_suites() {
+    has_all(&step_names(&["assets/machines/3axis-vmc.mch"]), &FOUR);
+}
+
+#[test]
+fn a_shipped_program_change_selects_first_part_programs() {
+    let names = step_names(&["examples/first-router-part.nc"]);
+    has_all(&names, &["app suites: first_part_programs", "app suites: first_router_part"]);
+}
+
+#[test]
+fn a_catalog_case_change_selects_every_catalog_suite() {
+    has_all(&step_names(&["examples/catalog/2d/first-part/case.toml"]), &FOUR);
+}
+
+#[test]
+fn a_post_engine_change_selects_the_shipped_example_suites() {
+    has_all(&step_names(&["crates/post/src/post/cnc.rs"]), &FOUR);
+}
+
+#[test]
+fn a_docs_only_change_selects_no_shipped_example_suite() {
+    let names = step_names(&["docs/decisions/README.md"]);
+    for bin in SUITES {
+        let step = format!("app suites: {bin}");
+        assert!(!names.contains(&step), "{step} selected for a docs-only change: {names:?}");
+    }
+}
