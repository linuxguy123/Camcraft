diff --git a/crates/post/tests/sodick_comment_escape.rs b/crates/post/tests/sodick_comment_escape.rs
new file mode 100644
index 000000000..4f61fbe98
--- /dev/null
+++ b/crates/post/tests/sodick_comment_escape.rs
@@ -0,0 +1,57 @@
+//! Provenance: synthetic comment inputs from the Sodick owner report in #3213.
+//! Gate map: covers assets/posts/sodick-wire.cps, camcraft_post::post::engine.
+
+use camcraft_post::post::cnc::{self, Record};
+use camcraft_post::post::{engine, js::ProgramId};
+use serde_json::{json, Value};
+
+#[test]
+fn sodick_comment_escape_golden() {
+    let records = vec![
+        Record::Param {
+            name: "OperationName".into(),
+            value: json!(r"Sq #1 [die] \x"),
+        },
+        Record::Param {
+            name: "OperationKind".into(),
+            value: json!(r"Wire # [Contour] \kind"),
+        },
+        Record::Param {
+            name: "SetupName".into(),
+            value: json!(r"Fixture # [top] \setup"),
+        },
+        Record::Param {
+            name: "WireSide".into(),
+            value: json!(r"outside # [profile] \side"),
+        },
+        Record::Param {
+            name: "WorkOffset".into(),
+            value: json!("G54"),
+        },
+        Record::Param {
+            name: "EdmCondition".into(),
+            value: json!("C110"),
+        },
+        Record::Section { begin: true },
+        Record::Section { begin: false },
+    ];
+    let machine =
+        json!({"kind": "wire_edm", "name": r"Sodick # [machine] \name", "edm": {"awt": true}});
+    let id = ProgramId {
+        notes: vec![r"Check # [stock] \note before cutting".into()],
+        ..ProgramId::default()
+    };
+    let out = engine::run_program_with(
+        include_str!("../../../assets/posts/sodick-wire.cps"),
+        &machine,
+        &cnc::serialize(&records),
+        &Value::Null,
+        &id,
+    )
+    .expect("synthetic Sodick comments post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert_eq!(
+        out.program.trim_end(),
+        include_str!("golden/sodick_comment_escape.nc").trim_end()
+    );
+}
diff --git a/docs/decisions/3213-sodick-comment-escape.md b/docs/decisions/3213-sodick-comment-escape.md
new file mode 100644
index 000000000..13c580239
--- /dev/null
+++ b/docs/decisions/3213-sodick-comment-escape.md
@@ -0,0 +1,15 @@
+## #3213 - Remove unsupported characters from Sodick comments
+
+**Decided:** Replace `#`, `[`, `]` and backslash with spaces in the Sodick
+post's `note()` function.
+
+**Why:** Every comment route, including program notes, passes through this
+function. This keeps the existing comment lengths and diagnostic text.
+The existing `clean()` function handles names and limits them to 48
+characters. Applying that limit to all comments would shorten static warnings.
+
+**Dropped:** Changing the shared sanitizer would affect other dialects.
+Rejecting names or shortening all comments would add restrictions that this
+fix does not need.
+
+**Cost to change later:** Change the Sodick post and its comment golden.
