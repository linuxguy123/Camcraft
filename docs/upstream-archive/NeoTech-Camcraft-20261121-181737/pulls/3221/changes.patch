From: mkinney <mike.kinney@gmail.com>
Date: Sat, 21 Nov 2026 18:20:30 +0100
Subject: [PATCH] fix(post): remove unsupported Sodick comment characters

Replace hashes, brackets and backslashes at the comment output boundary. Pin machine, operation, setup, side and program notes with a golden.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #3213
---
 assets/posts/sodick-wire.cps                  |  5 +-
 .../tests/golden/sodick_comment_escape.nc     | 16 ++++++
 crates/post/tests/sodick_comment_escape.rs    | 57 +++++++++++++++++++
 docs/decisions/3213-sodick-comment-escape.md  | 15 +++++
 4 files changed, 91 insertions(+), 2 deletions(-)
 create mode 100644 crates/post/tests/golden/sodick_comment_escape.nc
 create mode 100644 crates/post/tests/sodick_comment_escape.rs
 create mode 100644 docs/decisions/3213-sodick-comment-escape.md

diff --git a/assets/posts/sodick-wire.cps b/assets/posts/sodick-wire.cps
index 4166aee28..6fd48df5f 100644
--- a/assets/posts/sodick-wire.cps
+++ b/assets/posts/sodick-wire.cps
@@ -112,7 +112,7 @@ function block(words) {
   }
   if (a.length > 0) writeln(a.join(" "));
 }
-function msg(s) { if (typeof message === "function") message(s); else writeln("(" + s + ")"); }
+function msg(s) { if (typeof message === "function") message(s); else note(s); }
 function refuse(key, s) {
   if (refused[key]) return;
   refused[key] = true;
@@ -124,7 +124,8 @@ function clean(s) {
   t = t.replace(/[()%;\/]/g, " ").replace(/[^\x20-\x7E]/g, "?").replace(/\s+/g, " ").trim();
   return t.length > 48 ? t.substring(0, 48).trim() : t;
 }
-function note(s) { block(["(" + s + ")"]); }
+// #3213: the control rejects hashes, brackets and escapes in every comment.
+function note(s) { block(["(" + String(s).replace(/[#\[\]\\]/g, " ") + ")"]); }
 // Program notes use this dialect without truncating the stated bound.
 function onComment(s) { note(commentText(s)); }
 
