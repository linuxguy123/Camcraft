@@ -0,0 +1,67 @@
+//! Nominal inspection setup form using the saved DXF chain identities and the shared creation command.
+
+use super::layout::{button, hint, prop_grid, prop_row, text_row};
+use crate::state::{CommandKind, State};
+use camcraft_app::geometry::sketch_chains::ChainId;
+use camcraft_app::{operation::wire_op, setup, sketch};
+use egui::{ComboBox, Ui};
+
+#[derive(Default, Clone)]
+struct Draft {
+    name: String,
+    tool: String,
+    selected: Option<(String, ChainId, String)>,
+    x: String,
+    y: String,
+}
+
+pub(super) fn section(ui: &mut Ui, state: &mut State, ctx: Option<&str>) {
+    egui::CollapsingHeader::new("Agie nominal inspection").id_salt(("agie-inspection-section",ctx)).show(ui,|ui| {
+        if !camcraft_app::setup_mount::machine_of(&state.world,ctx).1.is_some_and(|m|m.model == "AGIECUT CLASSIC 2S") {
+            hint(ui,"Mount the AGIECUT CLASSIC 2S machine on this setup to create an inspection opening.");
+            return;
+        }
+        hint(ui,"Choose one closed opening and the centre of a 3 mm start hole. The nominal piece has zero working steps. Physical stock XY is unknown.");
+        if crate::browser_files::button(ui,state.browser_refusal_of(&CommandKind::ImportAgieDrawing),"Import DXF drawing","Place a drawing on the active setup") {
+            state.pending.push_back(CommandKind::ImportAgieDrawing);
+        }
+        let id=ui.make_persistent_id(("agie-inspection-input",ctx));
+        let mut draft=ui.data_mut(|d|d.get_temp::<Draft>(id)).unwrap_or_default();
+        prop_grid(ui,"agie-inspection-fields",|ui| {
+            text_row(ui,"Operation name",&mut draft.name,"agie-inspection-name",140.0);
+            prop_row(ui,"Wire tool",|ui| {
+                ComboBox::from_id_salt("agie-inspection-tool").selected_text(if draft.tool.is_empty() {"Choose a 0.25 mm wire"} else {draft.tool.as_str()}).show_ui(ui,|ui| {
+                    for n in state.tool_names() {
+                        if wire_op::wire_diameter_of(&state.world,&n).is_ok_and(|d|(d-0.25).abs()<1e-9) {
+                            ui.selectable_value(&mut draft.tool,n.clone(),n);
+                        }
+                    }
+                });
+            });
+            prop_row(ui,"DXF opening",|ui| {
+                ComboBox::from_id_salt("agie-inspection-chain").selected_text(draft.selected.as_ref().map_or("Choose a closed chain",|(_,_,s)|s.as_str())).show_ui(ui,|ui| {
+                    for name in sketch::placed_in(&state.world,ctx) {
+                        if let Some((_,profile))=sketch::find(&state.world,&name) {
+                            for ring in &profile.data.chains().closed {
+                                let label=format!("{} · {} · {:.2} mm² · {}",name,ring.layer,ring.area,ring.id);
+                                ui.selectable_value(&mut draft.selected,Some((name.clone(),ring.id,label.clone())),label);
+                            }
+                        }
+                    }
+                });
+            });
+            text_row(ui,"Start X (world mm)",&mut draft.x,"agie-inspection-x",95.0);
+            text_row(ui,"Start Y (world mm)",&mut draft.y,"agie-inspection-y",95.0);
+        });
+        if button(ui,"Create inspection opening").clicked() {
+            match (draft.selected.as_ref(), draft.x.trim().parse::<f64>(),draft.y.trim().parse::<f64>()) {
+                (Some((drawing,chain,_)),Ok(x),Ok(y)) if !draft.name.trim().is_empty() && !draft.tool.is_empty() => {
+                    state.pending.push_back(CommandKind::CreateAgieInspection {name:draft.name.trim().into(),tool:draft.tool.clone(),
+                        drawing:drawing.clone(),chain:*chain,start:[x,y],setup:setup::active(&state.world)});
+                }
+                _ => state.status="Enter an operation name, choose a wire and a closed chain, and enter both hole coordinates.".into(),
+            }
+        }
+        ui.data_mut(|d|d.insert_temp(id,draft));
+    });
+}
diff --git a/crates/ui/src/egui_app/agie_inspection_tests.rs b/crates/ui/src/egui_app/agie_inspection_tests.rs
