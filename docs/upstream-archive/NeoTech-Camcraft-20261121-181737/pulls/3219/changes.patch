+
+fn wire_op() -> WireContourOp {
+    WireContourOp {
+        condition: "C110".into(),
+        top_z: Height::of(HeightReference::TopOfStock, 0.0),
+        bottom_z: Height::of(HeightReference::BottomOfStock, 0.0),
+        side: WireSide::Punch,
