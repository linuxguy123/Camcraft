+const DXF: &str = "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n\
+    0\nLWPOLYLINE\n8\noutline\n90\n4\n70\n1\n10\n-8\n20\n-3\n10\n8\n20\n-3\n10\n8\n20\n3\n10\n-8\n20\n3\n\
