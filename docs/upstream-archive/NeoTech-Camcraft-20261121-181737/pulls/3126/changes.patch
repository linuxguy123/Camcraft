+/// How the pieces of one top loop stand over their wall ([`read`]): a
+/// point on the first bevelled and the first sharp piece, the sharp
+/// length, and whether any piece is a drafted wall (#2929).
+#[derive(Debug, Default, PartialEq)]
+struct Reading {
+    bevel: Option<Point2>,
+    sharp: Option<Point2>,
+    sharp_len: f64,
+    drafted: bool,
+}
+
+impl Reading {
+    /// #2887: `Some((bevel, sharp))` when the loop has a bevelled piece
+    /// AND more than `width` of sharp length.
+    fn partly_bevelled(&self, width: f64) -> Option<(Point2, Point2)> {
+        match (self.bevel, self.sharp) {
+            (Some(b), Some(s)) if self.sharp_len > width => Some((b, s)),
+            _ => None,
+        }
+    }
+}
+
+/// #2929: the steepest wall still read as a draft, `tan(15 deg)`.
+/// Cast and moulded drafts stand well under it, a chamfer's face well
+/// over it: a 45 degree bevel deeper than the ride is straight too.
+const DRAFT_TAN: f64 = 0.267_949_192_431_122_7;
+
+/// #2929: the piece whose midpoint `m` stands off `wall` is a drafted
+/// wall - one straight face from the top plane down to the corner
+/// plane, at no more than a draft's slope. Measured along the frame's
+/// `lean`, the piece stands `d` off the wall, at most `depth *
+/// DRAFT_TAN`, and the section half way down stands half of `d` off
+/// it (within a quarter of `d`). A modelled chamfer that ends above
+/// half depth puts that section on the wall itself, not half way.
+fn drafted(m: Point2, wall: &[Point2], mid: &Region, depth: f64, lean: Point2) -> bool {
+    if !(depth.is_finite() && depth > 0.0) {
+        return false;
     }
+    let d = near(Point2::new(m.x - lean.x, m.y - lean.y), wall);
+    let half = Point2::new(m.x - lean.x * 0.5, m.y - lean.y * 0.5);
+    let dm = mid.loops().iter().map(|l| near(half, l.points())).fold(f64::INFINITY, f64::min);
+    d > SAME_EDGE && d <= depth * DRAFT_TAN && (dm - d * 0.5).abs() <= d * 0.25
 }
 
