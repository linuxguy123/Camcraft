index 000000000..a2f3e4ae4
--- /dev/null
+++ b/crates/app/tests/golden_undercut.rs
@@ -0,0 +1,84 @@
+//! Committed golden CL dumps for the Slot Undercut generator (#1444):
+//! a T-slot along a straight slot, a keyseat along a curved one, a
+//! dovetail and a lollipop - the exact output pinned beside the
+//! behavioural laws of `motion::machining2d::undercut`'s own tests.
+//! Format, naming and the regeneration workflow: tests/golden/CLAUDE.md.
+//!
+//! Gate map: covers motion::machining2d::undercut and tools::undercut
+//! through app's re-exports (`camcraft_app::machining2d`,
+//! `camcraft_app::undercut`), with app's golden writer.
+
+mod common;
+
+use common::{gen_to_cltext, write_golden};
+
+use camcraft_app::cl::Toolpath;
+use camcraft_app::geo2d::Point2;
+use camcraft_app::machining2d::{undercut, undercut_station, UndercutParams};
+use camcraft_app::tools::ToolKind;
+use camcraft_app::undercut::{cutter, Undercut};
+
+fn params(cutter: Undercut, width: f64, bulge: f64) -> UndercutParams {
+    UndercutParams {
+        cutter,
+        width,
+        bulge,
+        run_in: 15.0,
+        neck_slot: 0.0,
+        clearance_z: 10.0,
+        retract_z: Some(2.0),
+        bottom_z: -12.0,
+        stepover: 2.0,
+        feed: 120.0,
+        plunge_feed: 60.0,
+        climb: true,
+    }
+}
+
+/// The path, with the law every golden here must keep: Z changes at the
+/// entry station and nowhere else.
+fn cut(p: &UndercutParams) -> Toolpath {
+    let (a, b) = (Point2::new(0.0, 0.0), Point2::new(60.0, 0.0));
+    let t = undercut(a, b, p).unwrap();
+    let s = undercut_station(a, b, p).unwrap();
+    for m in t.moves.iter().filter(|m| m.from.z != m.to.z) {
+        assert!((m.from.x - s.x).hypot(m.from.y - s.y) < 1e-9 && (m.to.x - s.x).hypot(m.to.y - s.y) < 1e-9, "{m:?}");
+    }
+    t
+}
+
+#[test]
+fn slot_undercut_tslot_straight_matches_golden() {
+    // A 20 x 6 head on an 8 mm neck in a 26 mm T-slot whose 14 mm neck
+    // slot was cut earlier: the centre pass, then two widenings.
+    let head = Undercut::of(&cutter(ToolKind::TSlot, 20.0, 6.0, 8.0, 30.0, 0.0)).unwrap();
+    let t = cut(&UndercutParams { neck_slot: 14.0, ..params(head, 26.0, 0.0) });
+    assert!(!t.has_arcs());
+    write_golden("slot_undercut_tslot_straight.cl", &gen_to_cltext(&t));
+}
+
+#[test]
+fn slot_undercut_keyseat_arc_matches_golden() {
+    // A 16 x 3 keyseat cutter along an arc (bulge 0.3), conventional.
+    let head = Undercut::of(&cutter(ToolKind::Keyseat, 16.0, 3.0, 6.0, 25.0, 0.0)).unwrap();
+    let t = cut(&UndercutParams { climb: false, ..params(head, 20.0, 0.3) });
+    assert!(t.has_arcs());
+    write_golden("slot_undercut_keyseat_arc.cl", &gen_to_cltext(&t));
+}
+
+#[test]
+fn slot_undercut_dovetail_straight_matches_golden() {
+    // A 60 degree dovetail, 20 mm at its tip, in a 24 mm dovetail.
+    let head = Undercut::of(&cutter(ToolKind::Dovetail, 20.0, 5.0, 8.0, 30.0, 60.0)).unwrap();
+    let t = cut(&params(head, 24.0, 0.0));
+    write_golden("slot_undercut_dovetail_straight.cl", &gen_to_cltext(&t));
+}
+
+#[test]
+fn slot_undercut_lollipop_arc_matches_golden() {
+    // A 10 mm ball on a 4 mm neck: the 14 mm groove is measured at the
+    // ball's equator, so the passes shift 2 mm - not 7.
+    let head = Undercut::of(&cutter(ToolKind::Lollipop, 10.0, 5.0, 4.0, 30.0, 0.0)).unwrap();
+    let t = cut(&params(head, 14.0, -0.3));
+    write_golden("slot_undercut_lollipop_arc.cl", &gen_to_cltext(&t));
+}
diff --git a/crates/app/tests/mcp_slot_undercut.rs b/crates/app/tests/mcp_slot_undercut.rs
new file mode 100644
index 000000000..d326bf5a2
--- /dev/null
+++ b/crates/app/tests/mcp_slot_undercut.rs
@@ -0,0 +1,297 @@
+//! #1444: the Slot Undercut operation over the MCP tools, end to end on
+//! a T-slot block - an end mill cuts the neck slot, a T-slot cutter
+//! enters from outside the wall, cuts the undercut and leaves the way
+//! it came; the program verifies and posts. The refusals: a cutter that
+//! is no undercut cutter, an entry slot too narrow for the neck (by
+//! name, at generation), no slot cut for the neck (the neck collides),
+//! and an entry station under the stock (a Z move with the head under
+//! material), each holding the post.
+//! Provenance: our own fixture - a grid-aligned T-slot block written as
+//! STL by this test.
+//!
+//! Gate map: covers app::operation::slot_undercut_op, the SlotUndercut
+//! arms of app::operation::{generate, kinds, heights, keep_law},
+//! app::project (undercut_dto, the undercut tool kind words),
+//! app::stock_sim (the undercut plan) and app::mcp (add_operation,
+//! verify findings).
+
+use camcraft_app::mcp::Server;
+
+use serde_json::{json, Value};
+use std::path::{Path, PathBuf};
+
+fn tmp_dir(tag: &str) -> PathBuf {
+    let mut p = std::env::temp_dir();
+    p.push(format!("camcraft-mcp-undercut-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&p);
+    std::fs::create_dir_all(&p).expect("temp dir");
+    p
+}
+
+/// A T-slot block as ASCII STL: x -30..30, y -20..20, z 0..20, with a
+/// slot along X - a 9 mm neck from the top down to Z 14 and a 20 mm
+/// undercut from Z 14 down to Z 8. Built on a grid of the slot's own
+/// breaks, one quad per exposed cell face, wound outward: every edge is
+/// shared by exactly two facets.
+fn write_tslot_stl(path: &Path) {
+    let xs = [-30.0, 30.0];
+    let ys = [-20.0, -10.0, -4.5, 4.5, 10.0, 20.0];
+    let zs = [0.0, 8.0, 14.0, 20.0];
+    // Material by cell (y index, z index): the slot's cells are air.
+    let solid = |j: i32, k: i32| -> bool {
+        if !(0..5).contains(&j) || !(0..3).contains(&k) {
+            return false;
+        }
+        match k {
+            0 => true,
+            1 => j == 0 || j == 4,
+            _ => j != 2,
+        }
+    };
+    let mut s = String::from("solid tslot\n");
+    let mut quad = |q: [[f64; 3]; 4]| {
+        for tri in [[q[0], q[1], q[2]], [q[0], q[2], q[3]]] {
+            s.push_str(" facet normal 0 0 0\n  outer loop\n");
+            for p in tri {
+                s.push_str(&format!("   vertex {} {} {}\n", p[0], p[1], p[2]));
+            }
+            s.push_str("  endloop\n endfacet\n");
+        }
+    };
+    for j in 0..5i32 {
+        for k in 0..3i32 {
+            if !solid(j, k) {
+                continue;
+            }
+            let (y0, y1) = (ys[j as usize], ys[j as usize + 1]);
+            let (z0, z1) = (zs[k as usize], zs[k as usize + 1]);
+            let (x0, x1) = (xs[0], xs[1]);
+            // The two end caps (the block has one cell along X).
+            quad([[x0, y0, z0], [x0, y0, z1], [x0, y1, z1], [x0, y1, z0]]);
+            quad([[x1, y0, z0], [x1, y1, z0], [x1, y1, z1], [x1, y0, z1]]);
+            if !solid(j - 1, k) {
+                quad([[x0, y0, z0], [x1, y0, z0], [x1, y0, z1], [x0, y0, z1]]);
+            }
+            if !solid(j + 1, k) {
+                quad([[x0, y1, z0], [x0, y1, z1], [x1, y1, z1], [x1, y1, z0]]);
+            }
+            if !solid(j, k - 1) {
+                quad([[x0, y0, z0], [x0, y1, z0], [x1, y1, z0], [x1, y0, z0]]);
+            }
+            if !solid(j, k + 1) {
+                quad([[x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1]]);
+            }
+        }
+    }
+    s.push_str("endsolid tslot\n");
+    std::fs::write(path, s).expect("write stl");
+}
+
+struct Client {
+    server: Server,
+    next: i64,
+}
+
+impl Client {
+    fn new() -> Self {
+        Self { server: Server::new(), next: 1 }
+    }
+
+    fn call(&mut self, name: &str, args: Value) -> (bool, Value) {
+        let id = self.next;
+        self.next += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": "tools/call", "params": { "name": name, "arguments": args } });
+        let reply = self.server.handle(&msg).expect("a request gets a response");
+        let result = &reply["result"];
+        assert!(result.is_object(), "tools/call answers with a result: {reply}");
+        let is_err = result["isError"] == json!(true);
+        let body = if is_err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() };
+        (is_err, body)
+    }
+
+    fn ok(&mut self, name: &str, args: Value) -> Value {
+        let (err, body) = self.call(name, args);
+        assert!(!err, "{name} refused: {body}");
+        body
+    }
+
+    fn refused(&mut self, name: &str, args: Value) -> String {
+        let (err, body) = self.call(name, args);
+        assert!(err, "{name} should have refused, got {body}");
+        body.as_str().unwrap_or_default().to_owned()
+    }
+}
+
+/// The T-slot block in a stock of its own size, a 6 mm end mill and a
+/// 20 x 6 mm T-slot cutter on an 8 mm neck (`TS-20`).
+fn job(dir: &Path) -> Client {
+    let stl = dir.join("tslot.stl");
+    write_tslot_stl(&stl);
+    let mut c = Client::new();
+    let imp = c.ok("import_model", json!({ "path": stl.display().to_string() }));
+    assert_eq!(imp["model"], json!("tslot"));
+    c.ok("set_stock", json!({ "box": { "dx": 60.0, "dy": 40.0, "dz": 20.0 } }));
+    c.ok("add_tool", json!({ "catalog": "EM-0600-4FL" }));
+    let job = c.ok("get_job", json!({}));
+    let mut def = job["tools"][0]["definition"].clone();
+    def["kind"] = json!("t_slot");
+    def["diameter"] = json!(20.0);
+    def["flute_len"] = json!(6.0);
+    def["shank_d"] = json!(8.0);
+    def["shank_len"] = json!(30.0);
+    def["rpm"] = json!(1500.0);
+    def["feed"] = json!(120.0);
+    if let Some(o) = def.as_object_mut() {
+        o.remove("cutting_data");
+    }
+    c.ok("add_tool", json!({ "name": "TS-20", "definition": def, "holder": "none" }));
+    c
+}
+
+/// The neck slot: 9 mm wide along X, from the top down to Z 14.
+fn add_neck_slot(c: &mut Client) {
+    c.ok("add_operation", json!({
+        "kind": "Slot", "tool": "EM-0600-4FL", "source": "tslot", "name": "Neck",
+        "params": {
+            "a": [-30.0, 0.0], "b": [30.0, 0.0], "width": 9.0,
+            "clearance_z": 30.0, "top_z": 20.0, "bottom_z": 14.0, "stepdown": 3.0, "stepover": 2.0
+        }
+    }));
+}
+
+/// The undercut: 20 mm wide on the floor Z 8, entered from 15 mm
+/// outside the x -30 wall, with `patch` merged over it.
+fn add_undercut(c: &mut Client, patch: Value) -> Value {
+    let mut params = json!({
+        "a": [-30.0, 0.0], "b": [30.0, 0.0], "width": 20.0, "run_in": 15.0, "neck_slot": 9.0,
+        "clearance_z": 30.0, "retract_z": 25.0, "top_z": 20.0, "bottom_z": 8.0, "stepover": 2.0, "feed": 120.0, "plunge_feed": 60.0
+    });
+    if let (Some(p), Some(extra)) = (params.as_object_mut(), patch.as_object()) {
+        for (k, v) in extra {
+            p.insert(k.clone(), v.clone());
+        }
+    }
+    c.ok("add_operation", json!({ "kind": "Slot Undercut", "tool": "TS-20", "source": "tslot", "name": "Undercut", "params": params }))
+}
+
+fn kinds_of(findings: &Value, op: &str) -> Vec<String> {
+    findings["findings"]
+        .as_array()
+        .map(|f| f.iter().filter(|f| f["op"] == json!(op)).filter_map(|f| f["kind"].as_str().map(str::to_owned)).collect())
+        .unwrap_or_default()
+}
+
+#[test]
+fn a_t_slot_is_cut_verified_and_posted_over_the_tools() {
+    let dir = tmp_dir("job");
+    let mut c = job(&dir);
+    let kinds = c.ok("list_operation_types", json!({}));
+    let kind = kinds["kinds"].as_array().and_then(|k| k.iter().find(|k| k["label"] == json!("Slot Undercut"))).cloned();
+    let kind = kind.expect("the Slot Undercut kind is listed");
+    assert_eq!(kind["key"], json!("slot_undercut"));
+
+    add_neck_slot(&mut c);
+    let add = add_undercut(&mut c, json!({}));
+    assert_eq!(add["operation"], json!("Undercut"));
+    let job = c.ok("get_job", json!({}));
+    let tool = job["tools"].as_array().and_then(|t| t.iter().find(|t| t["name"] == json!("TS-20"))).cloned().expect("TS-20");
+    assert_eq!(tool["definition"]["kind"], json!("t_slot"));
+    let op = job["operations"].as_array().and_then(|o| o.iter().find(|o| o["key"] == json!("Undercut"))).cloned().expect("Undercut");
+    assert_eq!(op["params"]["slot_undercut"]["width"], json!(20.0));
+    assert_eq!(op["params"]["slot_undercut"]["neck_slot"], json!(9.0));
+
+    let generated = c.ok("generate", json!({}));
+    let status: Vec<&Value> = generated["generated"].as_array().map(|g| g.iter().map(|g| &g["status"]).collect()).unwrap_or_default();
+    assert_eq!(status, vec![&json!("ok"), &json!("ok")], "{generated}");
+    let ver = c.ok("verify", json!({}));
+    assert_eq!(ver["ok"], json!(true), "{ver}");
+    assert!(kinds_of(&ver, "Undercut").is_empty(), "{ver}");
+
+    let nc = dir.join("tslot.nc");
+    let posted = c.ok("post", json!({ "output": nc.display().to_string(), "post": "Fanuc" }));
+    assert!(posted["lines"].as_u64().is_some_and(|n| n > 0));
+    let text = std::fs::read_to_string(&nc).expect("the program was written");
+    // The cutter goes down at the station x -45, outside the wall, and
+    // every block at the floor Z 8 follows it there.
+    assert!(text.contains("X-45."), "the entry station is posted:\n{text}");
+    assert!(text.contains("Z8."), "the undercut floor is posted:\n{text}");
+
+    // Saved and opened again, the op and the cutter are what they were.
+    let camproj = dir.join("tslot.camproj");
+    c.ok("save_project", json!({ "path": camproj.display().to_string() }));
+    c.ok("open_project", json!({ "path": camproj.display().to_string() }));
+    let opened = c.ok("get_job", json!({}));
+    let tool = opened["tools"].as_array().and_then(|t| t.iter().find(|t| t["name"] == json!("TS-20"))).cloned().expect("TS-20");
+    assert_eq!(tool["definition"]["kind"], json!("t_slot"));
+    let op = opened["operations"].as_array().and_then(|o| o.iter().find(|o| o["key"] == json!("Undercut"))).cloned().expect("Undercut");
+    assert_eq!(op["params"]["slot_undercut"]["run_in"], json!(15.0));
+    let _ = std::fs::remove_dir_all(&dir);
+}
