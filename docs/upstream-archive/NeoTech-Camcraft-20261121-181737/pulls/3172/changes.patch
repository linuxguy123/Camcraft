From 3f945362ac7ca3ebcd0882c05cca8184b611ea9d Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 15:22:11 +0100
Subject: [PATCH] fix(app): break a catalog-hint size tie by name, not file
 order

The tool law's catalog hint picks the entry nearest 6 mm, then the
smaller size. A full tie kept the first entry in catalog.json order, so
the router starter cutters of #3159 ("Router ball nose 6 mm" before
"BN-0600") changed the ball-nose hint and turned the tool_gate suite red
on main. The lower name now wins a full tie; the hint is the same for
any file order. Pinned by a_size_tie_picks_by_name_not_file_order.

Fixes #3170

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/operation/tool_gate.rs         |  7 +++--
 crates/app/tests/tool_gate.rs                 | 25 ++++++++++++++++++
 .../3170-catalog-hint-tie-by-name.md          | 26 +++++++++++++++++++
 3 files changed, 56 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/3170-catalog-hint-tie-by-name.md

diff --git a/crates/app/src/operation/tool_gate.rs b/crates/app/src/operation/tool_gate.rs
index 717be9372..2348ab8a0 100644
--- a/crates/app/src/operation/tool_gate.rs
+++ b/crates/app/src/operation/tool_gate.rs
@@ -104,7 +104,9 @@ fn bought_size(t: &Tool) -> f64 {
 /// M13.4, the tool law's catalog hint: the starter-catalog entry the
 /// refusal suggests - of the family's first kind the catalog stocks
 /// (the family lists its primary kind first), the one nearest the
-/// everyday size, a tie to the smaller. `None` when the catalog holds
+/// everyday size, a tie to the smaller, a full tie to the lower name
+/// (#3170: a deterministic rule, so the hint never depends on the
+/// catalog's file order). `None` when the catalog holds
 /// no tool of any fitting kind: then the refusal says nothing extra
 /// rather than suggest a tool that cannot cut the op. Non-finite sizes
 /// never win (total ordering on the distance, NaN last).
@@ -114,12 +116,13 @@ pub fn catalog_suggestion(catalog: &[(&str, Tool)], kinds: &[ToolKind]) -> Optio
         catalog
             .iter()
             .filter(|(_, t)| t.kind == *kind && bought_size(t).is_finite())
-            .min_by(|(_, a), (_, b)| {
+            .min_by(|(na, a), (nb, b)| {
                 let (sa, sb) = (bought_size(a), bought_size(b));
                 (sa - SUGGEST_SIZE_MM)
                     .abs()
                     .total_cmp(&(sb - SUGGEST_SIZE_MM).abs())
                     .then(sa.total_cmp(&sb))
+                    .then_with(|| na.cmp(nb))
             })
     })?;
     Some(format!(
diff --git a/crates/app/tests/tool_gate.rs b/crates/app/tests/tool_gate.rs
index 739de006d..bf3f46d1a 100644
--- a/crates/app/tests/tool_gate.rs
+++ b/crates/app/tests/tool_gate.rs
@@ -245,3 +245,28 @@ fn no_catalog_entry_of_the_kind_means_no_hint() {
     let hint = tool_gate::catalog_suggestion(&no_drills, OpType::Drill.info().tool_kinds);
     assert_eq!(hint.as_deref(), Some("add 'TAP-M6' (6 mm tap) from the catalog?"));
 }
+
+/// #3170: two entries of one kind at the same size tie; the lower name
+/// wins, so the hint never depends on the catalog's file order (the
+/// router starter cutters of #3159 sit before the metal ladder).
+#[test]
+fn a_size_tie_picks_by_name_not_file_order() {
+    let named = |hint: Option<String>| {
+        hint.and_then(|h| h.split('\'').nth(1).map(str::to_owned)).unwrap_or_default()
+    };
+    let pair = |a: &'static str, b: &'static str| vec![(a, catalog_tool(a)), (b, catalog_tool(b))];
+    let ball = [ToolKind::BallNose];
+    for order in [pair("Router ball nose 6 mm", "BN-0600"), pair("BN-0600", "Router ball nose 6 mm")] {
+        assert_eq!(named(tool_gate::catalog_suggestion(&order, &ball)), "BN-0600");
+    }
+    let mut reversed = catalog();
+    reversed.reverse();
+    for (kinds, want) in [
+        (&[ToolKind::BallNose][..], "BN-0600"),
+        (&[ToolKind::EndMill][..], "EM-0600-4FL"),
+        (&[ToolKind::Taper][..], "CM-0600-90"),
+    ] {
+        assert_eq!(named(tool_gate::catalog_suggestion(&catalog(), kinds)), want);
+        assert_eq!(named(tool_gate::catalog_suggestion(&reversed, kinds)), want);
+    }
+}
diff --git a/docs/decisions/3170-catalog-hint-tie-by-name.md b/docs/decisions/3170-catalog-hint-tie-by-name.md
new file mode 100644
index 000000000..8e0430775
--- /dev/null
+++ b/docs/decisions/3170-catalog-hint-tie-by-name.md
@@ -0,0 +1,26 @@
+## #3170 - The catalog hint breaks a size tie by name
+
+**Decided:** `tool_gate::catalog_suggestion` keeps its order: the entry of
+the family's first stocked kind nearest 6 mm, then the smaller size. When
+two entries still tie, the entry with the lower name wins. This is a
+deterministic rule, not a preference for one tool line. It makes the hint
+independent of the file order of `assets/tools/catalog.json`.
+
+**Why:** #3159 added "Router ball nose 6 mm" before "BN-0600" in the
+catalog file. The old tie kept the first entry in file order, so the
+refusal for a ball-nose operation changed from 'BN-0600' to the router
+cutter, and `the_refusal_names_a_fitting_catalog_entry` failed on main.
+The taper kind has the same risk: "Router V-bit 60 deg 6 mm" and "Router
+V-bit 90 deg 6 mm" come before "CM-0600-90". The name rule gives
+'BN-0600', 'EM-0600-4FL' and 'CM-0600-90' for any file order. The pin
+`a_size_tie_picks_by_name_not_file_order` covers the two orders of the
+ball-nose pair and the reversed catalog for ball-nose, end mill and taper.
+
+**Dropped:**
+- Change the test expectation to 'Router ball nose 6 mm'. The hint would
+  still depend on file order, and the next catalog edit could move it
+  again.
+- Move the router entries after the metal ladder in `catalog.json`. This
+  hides the fault; the order stays load-bearing.
+- Prefer an entry by its material group. The suggestion has no material
+  context, and this is new behaviour for a P2 fix.
