From cf4d81fd9fd29ee1929e5110d4e919c8a2ccfbed Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 03:05:31 -0800
Subject: [PATCH] test(app): coarse_laws expects the current STEP facet budget
 refusal wording

coarse_laws.rs (#904, merged in #1064) expected the refusal "re-import
with a larger budget". #1054 (merged in #1074) reworded
model_fidelity::TOO_COARSE to "re-import with a larger STEP facet
budget" and updated the suites it knew, not this one, so four
coarse_laws tests went red on main. The expectation now builds the
text from model_fidelity::TOO_COARSE so it cannot drift again. Test
only; the product message is unchanged.

Fixes #1178
---
 crates/app/tests/coarse_laws.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/app/tests/coarse_laws.rs b/crates/app/tests/coarse_laws.rs
index ad325a1a0..d15d1c5de 100644
--- a/crates/app/tests/coarse_laws.rs
+++ b/crates/app/tests/coarse_laws.rs
@@ -121,7 +121,7 @@ fn fidelity_lines(world: &World) -> Vec<String> {
 }
 
 fn refusal(op: &str, mm: &str) -> String {
-    format!("{op}: model 'bar' was imported too coarsely to verify; re-import with a larger budget (surfaces are approximated to within {mm} mm)")
+    format!("{op}: model 'bar' was {} (surfaces are approximated to within {mm} mm)", model_fidelity::TOO_COARSE)
 }
 
 fn groove_finish(tolerance: f64) -> OpParams {
