+                None | Some(serde_json::Value::Null) => Ok(String::new()),
+                Some(serde_json::Value::String(s)) => Ok(s.clone()),
+                Some(x) => Err(format!("machine file: edm condition {id:?} {k} must be a word, not {x}")),
