new file mode 100644
index 000000000..f40d3886d
--- /dev/null
+++ b/crates/app/tests/thread_support/mod.rs
@@ -0,0 +1,172 @@
+//! Shared fixtures of the thread-milling suites (#894, #992): a disc with
+//! a blind tap-drill hole modelled deeper than its thread, a box stock,
+//! the catalog's thread mills, and a Drill operation ahead of the thread
+//! that opens the hole the way a shop does - a tap drill at the minor
+//! diameter, deeper than the thread so the mill clears its point.
+//!
+//! Provenance: ISO 724 thread sizes (M8 x 1.25: minor Ø6.647; M8 x 1:
+//! minor Ø6.917) and public handbook thread milling; our own fixtures.
+#![allow(dead_code)] // each suite uses its own share
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::cl::{ThreadHand, Toolpath};
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, ImportModel, SetStock};
+use camcraft_app::drilling::{CycleChoice, Hole};
+use camcraft_app::geo2d::Point2;
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::stock_sim::simulate_document;
+use camcraft_app::tools::{Tool, catalog};
+use camcraft_app::world::new_world;
+
+pub const TOP: f64 = 20.0;
+pub const BOTTOM: f64 = 0.0;
+/// The thread's blind floor: 12 mm of thread.
+pub const FLOOR: f64 = 8.0;
+/// The modelled tap-drill hole's floor (#992): deeper than the thread,
+/// so the drill's point stays under the thread mill.
+pub const DRILL_FLOOR: f64 = 4.0;
+/// M8 x 1.25's minor radius (ISO 724: D1 = 8 - 1.0825 x 1.25).
+pub const R_M8: f64 = 3.3235;
+/// M8 x 1 (fine): D1 = 8 - 1.0825.
+pub const R_M8_FINE: f64 = 3.45875;
+pub const MULTI: &str = "TM-0600-P125";
+pub const SINGLE: &str = "TMS-0600-P050-150";
+pub const DRILL: &str = "TAP-DRILL";
+
+/// A Ø36 disc from z 0 to 20 with a blind round hole of `radius` from
+/// the top down to `DRILL_FLOOR`, walls in 96 flats. Outward-wound.
+pub fn disc_with_hole(radius: f64) -> Mesh {
+    let n = 96;
+    let at = |r: f64, k: usize, z: f64| {
+        let a = std::f64::consts::TAU * (k % n) as f64 / n as f64;
+        Point3::new(r * a.cos(), r * a.sin(), z)
+    };
+    let quad = |a: Point3, b: Point3, c: Point3, d: Point3, f: &mut Vec<Triangle>| {
+        f.push(Triangle::new(a, b, c));
+        f.push(Triangle::new(a, c, d));
+    };
+    let mut f = Vec::new();
+    for k in 0..n {
+        let (o, i) = (18.0, radius);
+        quad(at(o, k, BOTTOM), at(o, k + 1, BOTTOM), at(o, k + 1, TOP), at(o, k, TOP), &mut f);
+        quad(at(o, k, TOP), at(o, k + 1, TOP), at(i, k + 1, TOP), at(i, k, TOP), &mut f);
+        quad(at(i, k + 1, DRILL_FLOOR), at(i, k, DRILL_FLOOR), at(i, k, TOP), at(i, k + 1, TOP), &mut f);
+        f.push(Triangle::new(Point3::new(0.0, 0.0, DRILL_FLOOR), at(i, k, DRILL_FLOOR), at(i, k + 1, DRILL_FLOOR)));
+        f.push(Triangle::new(Point3::new(0.0, 0.0, BOTTOM), at(o, k + 1, BOTTOM), at(o, k, BOTTOM)));
+    }
+    Mesh::from_facets(f)
+}
+
+/// The thread's hole: the minor wall of `radius`, threaded down to `FLOOR`.
+pub fn hole(radius: f64) -> Hole {
+    Hole { xy: Point2::new(0.0, 0.0), radius, entry_z: TOP, floor_z: FLOOR, through: false, stepped: false }
+}
+
+pub fn catalog_tool(name: &str) -> Tool {
+    catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog tool")
+}
+
+/// A 118-degree drill of `diameter`, long enough for the disc.
+pub fn tap_drill(diameter: f64) -> Tool {
+    Tool { diameter, shank_d: diameter, flute_len: 25.0, ..catalog_tool("DR-0600") }
+}
+
+/// The tap drill a modelled hole of `radius` takes: its diameter to the
+/// tenth below, so the drill never touches the drawn wall.
+pub fn tap_drill_for(radius: f64) -> f64 {
+    ((radius * 2.0 - 0.02) * 10.0).floor() / 10.0
+}
+
+pub fn thread(radius: f64, pitch: Option<f64>, hand: ThreadHand, climb: bool) -> OpParams {
+    OpParams::Thread {
+        clearance_z: Height::fixed(TOP + 10.0),
+        retract_z: None,
+        top_z: Height::fixed(TOP),
+        bottom_z: None,
+        infeed: 0.25,
+        feed: 300.0,
+        plunge_feed: 150.0,
+        climb,
+        holes: vec![hole(radius)],
+        pitch,
+        hand,
+    }
+}
+
+/// A Drill operation's params: the hole at the origin, `radius` wide,
+/// drilled with its point to `floor`.
+pub fn drill(radius: f64, floor: f64) -> OpParams {
+    let hole = Hole { xy: Point2::new(0.0, 0.0), radius, entry_z: TOP, floor_z: floor, through: false, stepped: false };
+    OpParams::Drill {
+        clearance_z: Height::fixed(TOP + 10.0),
+        retract_z: None,
+        top_z: Height::fixed(TOP),
+        bottom_z: None,
+        cycle: CycleChoice::Drill,
+        peck: 0.0,
+        dwell: 0.0,
+        feed: 120.0,
+        plunge_feed: 80.0,
+        holes: vec![hole],
+        cross: vec![],
+    }
+}
+
+/// A world holding the disc (hole of `model_radius`), a box stock
+/// around it and the named tools; nothing machined yet.
+pub fn bare_world(model_radius: f64, tools: &[(&str, Tool)]) -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    let stock_at = Location { pos: Point3::new(0.0, 0.0, BOTTOM), ..Location::default() };
+    let stock = SetStock::new(&world, StockShape::Box { dx: 40.0, dy: 40.0, dz: TOP - BOTTOM }, stock_at);
+    history.execute(&world, stock.expect("box stock"));
+    for (name, tool) in tools {
+        history.execute(&world, AddTool::new(&world, name, tool.clone()).expect("tool"));
+    }
+    history.execute(&world, ImportModel::from_mesh("disc", disc_with_hole(model_radius)));
+    (world, history)
+}
+
+/// Add a tap drill of `diameter` and a generated Drill operation
+/// "Drill1" whose point reaches `floor`, at the end of the program.
+pub fn drill_ahead(world: &World, history: &mut History, diameter: f64, floor: f64) {
+    history.execute(world, AddTool::new(world, DRILL, tap_drill(diameter)).expect("drill"));
+    let op = CreateOperation::new(world, "Drill1", DRILL, SrcRef::Entity("disc".into()), drill(diameter * 0.5, floor));
+    history.execute(world, op.expect("create drill"));
+    history.execute(world, GenerateOperation::new(world, "Drill1").expect("generate drill"));
+}
+
+/// [`bare_world`] with the hole already tap-drilled to `DRILL_FLOOR` by
+/// a Drill operation ahead (#992: a thread mill needs the hole open).
+pub fn world_with(model_radius: f64, tools: &[(&str, Tool)]) -> (World, History) {
+    let (world, mut history) = bare_world(model_radius, tools);
+    drill_ahead(&world, &mut history, tap_drill_for(model_radius), DRILL_FLOOR);
+    (world, history)
+}
+
+pub fn make(world: &World, history: &mut History, tool: &str, params: OpParams) -> Toolpath {
+    let op = CreateOperation::new(world, "Thread1", tool, SrcRef::Entity("disc".into()), params);
+    history.execute(world, op.expect("create op"));
+    history.execute(world, GenerateOperation::new(world, "Thread1").expect("generate op"));
+    let e = model::find_by_name(world, "Thread1").expect("op");
+    model::toolpath_of(world, &e).expect("cached path").path
+}
+
+pub fn blocking(world: &World) -> Vec<String> {
+    let e = model::find_by_name(world, "Thread1").expect("op");
+    let cache = model::toolpath_of(world, &e).expect("cached path");
+    cache.warnings.iter().filter(|w| w.blocks_post()).map(ToString::to_string).collect()
+}
+
+pub fn assert_clean(world: &World) {
+    assert_eq!(blocking(world), Vec::<String>::new(), "the generator's own verdict");
+    assert_eq!(posting::verification_gate(world), Vec::<String>::new(), "the post gate");
+    let sim = simulate_document(world).expect("the thread program simulates");
+    assert_eq!(sim.dev.gouge_cells, 0, "worst {:.3} mm at {:?}", sim.dev.max_gouge, sim.dev.max_gouge_at);
+}
diff --git a/docs/decisions/992-thread-undrilled.md b/docs/decisions/992-thread-undrilled.md
new file mode 100644
index 000000000..4ac41489e
--- /dev/null
+++ b/docs/decisions/992-thread-undrilled.md
@@ -0,0 +1,90 @@
+## #992 - Thread milling refuses a hole the program has not drilled yet
+
+**What was decided**
+
+1. **The prior grid judges the way in.** At generate, after the thread ride
+   is built, each threaded hole is read in the stock the setup's earlier
+   operations leave standing - the same lazily cut grid the drilling and
+   rapid laws read (`operation::drill_prior::PriorCell`, from
+   `job::collect_job`'s `verify_prior`). The highest stock standing over
+   the read disk must be at or below the lowest point the path takes the
+   mill to inside that hole; otherwise generate refuses by name: "the hole
+   at (x, y) is not drilled yet: the stock the program ahead leaves stands
+   at z .. inside it, above the thread mill's lowest point at z .. - a
+   thread mill does not cut at its centre - add a drilling operation of at
+   least the .. mm minor diameter, deep enough for its point, before the
+   thread" (`operation::thread_entry::judge`).
+2. **The disk read is the minor circle less one grid cell, never narrower
+   than the mill.** The ride assumes the hole is open to the minor
+   diameter: the descent runs on the axis, and the lead-in and every
+   radial pass sweep the mill out to the thread. A drill well under the
+   minor diameter would leave a wall the thread mill's teeth would have to
+   cut at thread feed before the first thread pass. One cell of slack is
+   the lattice's own resolution: the sweep cuts a column whose centre lies
+   inside the drill's disk, so a drill of exactly the minor diameter is
+   read open. For the tight case (an M8 x 1.25 with a 6 mm mill) the read
+   falls back to the mill's own cylinder, which is what the issue's
+   "a Drill of at least the tool's diameter generates" meant.
+3. **Unknown is refused.** Nothing ahead cut (no grid at all), a program
+   ahead the column grid cannot cut, a posed (3+2) Thread operation, a
+   carried body whose prior is distrusted, a hole off the grid, or a
+   non-finite reading: each is refused by name. An unjudged hole is never
+   air.
+4. **The lowest point is read from the path, not the kernel's arithmetic.**
+   The lowest Z of any move end inside the hole's minor circle is the
+   mill's lowest point there - one law for blind, through and stated
+   bottoms, and for any future ride change.
+5. **Staleness needed no new code.** An unposed operation's stamp already
+   digests the program ahead (`drill_prior::reads_prior` is true for every
+   unposed kind, #109), so moving the Drill after the Thread marks the
+   Thread Stale and its regeneration refuses. Pinned, not re-built.
+6. **Fixtures model the tap-drill hole deeper than the thread.** The #894
+   thread suites drew the hole exactly at the thread's floor, so a drill
+   ahead would leave its point under the thread mill. The shared fixture
+   (`tests/thread_support`) now draws the hole to z 4 (the tap drill's
+   depth) and threads to z 8 as before: the thread paths and their CL
+   goldens are unchanged; the M8 NC golden gains the Drill operation ahead
+   (and the thread mill becomes T02). The floor-gouge test drills past the
+   modelled floor so the floor law, not this refusal, is what it pins.
+   `mill2d_c`'s R10 thread gets a 20 mm drill ahead; the MCP thread test
+   now pins generate's refusal of the undrilled block.
+
+**Why**
+
+A thread mill is not centre-cutting and the ride feeds it down the hole's
+axis at plunge feed. With #894 a Thread operation posts, so a forgotten tap
+drill was a broken cutter with no finding at generate, verify or the post
+gate (the gouge laws read the part, where the hole is modelled). The
+Prime Directive puts this at P0 and asks for a refusal by name.
+
+**Sources (public)**
+
+- Machinery's Handbook, "Thread milling": the hole is drilled to the
+  tap-drill (minor) diameter first; thread mills cut on their side teeth.
+- Peter Smid, "CNC Programming Handbook", thread milling chapter: drill
+  depth exceeds the thread depth so the cutter clears the drill point.
+
+No HSMWorks / Fusion material, output or documentation was consulted.
+
+**Considered and dropped**
+
+- *Asking the centre-cutting plunge law (`plunge_law::audit`)*: it reads
+  the raw stock, so every thread would be refused; it has no prior-grid
+  reading.
+- *Reading only the mill's own cylinder (the issue's sketch)*: lets a
+  drill much narrower than the minor diameter (6 mm for an M10) pass, and
+  the mill then side-cuts a full wall at thread feed - a likely breakage.
+- *The padded disk the drilling laws read (half a cell's diagonal past the
+  radius)*: refuses a drill of exactly the mill's diameter, which the
+  issue says must generate.
+- *Falling back to the raw stock when nothing ahead cut* (a cast part with
+  the hole cored): needs a stock grid on the job thread with no world;
+  refused instead, rare, and the refusal names what to add.
+
+**What it would cost to change later**
+
+- A cored-stock acquittal: build the raw stock grid when no plan exists
+  and read it the same way (one branch in `thread_entry::judge`).
+- Posed thread milling: needs a frame-aware prior reading; today a posed
+  Thread is refused.
+- The milled Bore ride's axis entry has the same gap and is filed apart (#1036).

From ab0f88faff66986db1b47af517ac430ec824df67 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 00:42:58 -0800
Subject: [PATCH 3/4] feat(thread): external threads on a boss at the operation
 level

The Thread operation gains `external`: its list then holds bosses
(major radius, top, shoulder), read from the model by Detect holes
(`drilling::recognize_bosses`: the hole recogniser's law with the facing
vote inverted, stepped walls never folded) and passed to the kernel's
external ride pinned by #1005.

A tool beside a boss is judged without the part's silhouette:
- crest law: the tangency verdict against each boss's MINOR circle
  (ISO 965-1 design root, 0.6134 x pitch) - the drawn wall is not the
  wall the crests answer to (#1071's lesson read for a boss);
- root law: the solid law with the cutter narrowed by the external
  depth - roots, tip, shank and holder against the whole part;
- neighbour law (new): the crest ring at full radius against every
  facet that is not the threaded boss's own wall, no thread allowance.

The air law (#992's external analogue): every position the feeds take
the tool through is read in the stock the program ahead leaves; stock
standing under the tool's disc outside the boss refuses the thread by
name. Unknown is refused.

The door refuses a boss no thicker than the thread is deep and a thread
longer than the mill reaches beside a boss. The program simulation
sweeps an external thread at its external root radius. The Thread page
gets the external checkbox, Detect bosses and a per-row Remove; the MCP
tools carry the flag through the existing params and detect_holes.

Goldens: thread_mill_external_m8_multi_form.cl/.nc,
thread_mill_external_m10_single_form.cl.

Fixes #985

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
