From dd382dcf4cba00395a3c47f301c98b7340cf8caa Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 01:29:33 +0000
Subject: [PATCH] test(ui): pin the FrameWatch::excuse clamp (#879)

A 5 s excuse at +210 ms after a 200 ms commands phase must still report
the 200 ms; without the clamp the frame reads as 0 ms.

Fixes #879

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/frame_watch.rs   | 16 ++++++++++++++++
 docs/decisions/879-furniture-wording.md | 22 ++++++++++++++++++++++
 2 files changed, 38 insertions(+)
 create mode 100644 docs/decisions/879-furniture-wording.md

diff --git a/crates/ui/src/egui_app/frame_watch.rs b/crates/ui/src/egui_app/frame_watch.rs
index bc5851d98..694353daa 100644
--- a/crates/ui/src/egui_app/frame_watch.rs
+++ b/crates/ui/src/egui_app/frame_watch.rs
@@ -163,6 +163,22 @@ mod tests {
         assert_eq!(w.end(t3 + ms(10)), None);
     }
 
+    #[test]
+    fn an_excuse_is_clamped_to_the_time_since_the_last_mark() {
+        // #879: a 5 s dialog excused at +210 ms may only take the 10 ms
+        // since the last mark off the frame. Without the clamp the stamps
+        // jump past `now`, the frame reads as 0 ms and the 200 ms of
+        // commands work is lost.
+        let t0 = Instant::now();
+        let mut w = FrameWatch::new(t0);
+        w.begin(t0);
+        w.mark("commands", t0 + ms(200));
+        w.excuse(ms(5_000), t0 + ms(210));
+        let line = w.end(t0 + ms(210)).expect("200 ms of commands work is slow");
+        assert!(line.contains("slow frame 200 ms"), "{line}");
+        assert!(line.contains("\"commands\" 200 ms"), "{line}");
+    }
+
     #[test]
     fn reports_are_rate_limited_but_counted() {
         let t0 = Instant::now();
diff --git a/docs/decisions/879-furniture-wording.md b/docs/decisions/879-furniture-wording.md
new file mode 100644
index 000000000..9716e2712
--- /dev/null
+++ b/docs/decisions/879-furniture-wording.md
@@ -0,0 +1,22 @@
+## #879 - Reword the remaining 'setup furniture' errors; pin the frame-watch clamp
+
+**What was decided.** Every user-facing string that said "furniture" already
+reads in plain English on upstream/main (the repair, update, tool and setup
+messages now say "a setup's stock or work offset"), so no string was
+reworded. The work is the test hardening: a `FrameWatch::excuse` clamp case
+(`an_excuse_is_clamped_to_the_time_since_the_last_mark`) pins the 200 ms
+commands phase after a 5 s excuse at +210 ms.
+
+**Why.** The issue's line numbers had drifted and the wording was fixed by
+#873/#875/#878 before this branch was cut; a re-reword would only churn text.
+
+**Considered and dropped.**
+- A repo-wide source scan that fails on any string literal containing
+  "furniture". Dropped: string literals span lines and identifiers such as
+  `is_furniture_shape` sit beside them, so a scan would need a Rust lexer to
+  avoid false positives. The existing guards cover the refusal paths
+  (`setup_refusals_never_say_furniture` in `crates/app/tests/setups.rs`,
+  and the `repair_model` assertion in `crates/app/tests/repair_model.rs`).
+
+**Cost to change later.** Test-only; a broader guard can be added without
+touching product code.
