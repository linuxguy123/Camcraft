+fn insert_of(a: &Map<String, Value>) -> Result<Option<JawInsert>, String> {
+    match a.get("insert") {
+        None | Some(Value::Null) => Ok(None),
+        Some(v) => match v.as_str() {
+            Some("hard") => Ok(Some(JawInsert::Hard)),
