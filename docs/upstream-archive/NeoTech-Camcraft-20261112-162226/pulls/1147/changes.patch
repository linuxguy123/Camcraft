index 000000000..b36f1453e
--- /dev/null
+++ b/crates/sim/src/verify/wire/dist.rs
@@ -0,0 +1,80 @@
+//! Plain 2D distances for the wire laws: point to point, point to
+//! segment, segment to segment, and a move's clearance to the product.
+//! Provenance: textbook Euclidean geometry (closest points of segments).
+//! Our own code.
+
+use super::Product;
+use crate::geo2d::Point2;
+
+pub(super) fn pp(a: Point2, b: Point2) -> f64 {
+    (a.x - b.x).hypot(a.y - b.y)
+}
+
+/// The point of segment `a`-`b` nearest `p`.
+fn foot(p: Point2, a: Point2, b: Point2) -> Point2 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let l2 = dx * dx + dy * dy;
+    if l2.is_nan() || l2 <= 0.0 {
+        return a;
+    }
+    let t = (((p.x - a.x) * dx + (p.y - a.y) * dy) / l2).clamp(0.0, 1.0);
+    Point2::new(a.x + t * dx, a.y + t * dy)
+}
+
+fn cross(o: Point2, a: Point2, b: Point2) -> f64 {
+    (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x)
+}
+
+/// Whether segments `a`-`b` and `c`-`d` cross or touch (proper or not).
+fn crosses(a: Point2, b: Point2, c: Point2, d: Point2) -> bool {
+    let (d1, d2) = (cross(c, d, a), cross(c, d, b));
+    let (d3, d4) = (cross(a, b, c), cross(a, b, d));
+    ((d1 > 0.0 && d2 < 0.0) || (d1 < 0.0 && d2 > 0.0)) && ((d3 > 0.0 && d4 < 0.0) || (d3 < 0.0 && d4 > 0.0))
+}
+
+/// The distance between segments `a`-`b` and `c`-`d`, with the point of
+/// `c`-`d` nearest the first.
+pub(super) fn seg_seg(a: Point2, b: Point2, c: Point2, d: Point2) -> (f64, Point2) {
+    if crosses(a, b, c, d) {
+        let t = cross(c, d, a) / (cross(c, d, a) - cross(c, d, b));
+        return (0.0, Point2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y)));
+    }
+    let mut best = (f64::INFINITY, c);
+    for (p, q) in [(a, foot(a, c, d)), (b, foot(b, c, d))] {
+        let dd = pp(p, q);
+        if dd < best.0 {
+            best = (dd, q);
+        }
+    }
+    for q in [c, d] {
+        let dd = pp(q, foot(q, a, b));
+        if dd < best.0 {
+            best = (dd, q);
+        }
+    }
+    best
+}
+
+/// How far the wire's centre walking `a`-`b` stays from the product,
+/// and the product's point nearest it: 0 when the move stands in the
+/// product. An empty product is infinitely clear.
+pub(super) fn clearance(p: &Product<'_>, a: Point2, b: Point2) -> (f64, Point2) {
+    if p.contains(a) {
+        return (0.0, a);
+    }
+    if p.contains(b) {
+        return (0.0, b);
+    }
+    let mut best = (f64::INFINITY, a);
+    for l in p.boundary().loops() {
+        let pts = l.points();
+        for i in 0..pts.len() {
+            let (c, d) = (pts[i], pts[(i + 1) % pts.len()]);
+            let got = seg_seg(a, b, c, d);
+            if got.0 < best.0 {
+                best = got;
+            }
+        }
+    }
+    best
+}
diff --git a/crates/sim/src/verify/wire/mod.rs b/crates/sim/src/verify/wire/mod.rs
new file mode 100644
index 000000000..e7717ece7
--- /dev/null
+++ b/crates/sim/src/verify/wire/mod.rs
@@ -0,0 +1,282 @@
+//! Wire EDM 2.5D verification (#534, part of #290 D7): a vertical
+//! 2-axis wire cut judged on the program plane against the part's
+//! sections through the whole height the wire passes.
+//!
+//! - **Kerf law.** The wire burns a slot of half-width `k` (wire radius
+//!   plus spark gap) along every move, through every height between its
+//!   guides. A move whose kerf comes nearer the product's section than
+//!   `k` - or stands in it - is a gouge, named by its move.
+//! - **Threading law.** The wire is threaded at the start hole through
+//!   the full height: the product must stand clear of the threading
+//!   point by `k` at every judged plane. A start hole that is not
+//!   stated, or that the path does not start from, is refused by name.
+//! - **Slug law.** The kerf region is subtracted from the material
+//!   section (stock and part); the connected pieces enclosed by the cut
+//!   are what drops free when the cut closes. A die keeps the material
+//!   outside the cut, so its freed piece must hold none of the product;
+//!   a punch's freed piece IS the product. A cut that frees nothing, or
+//!   frees the wrong side, is refused by name.
+//!
+//! The product's section by the stated side: a punch's product is the
+//! model. A die's product is the model too when the start hole stands
+//! outside it (the model is a die plate, the opening a hole in it); when
+//! the start hole stands IN the model, the model is the opening (the
+//! slug's shape, #532's whole-model die) and the product is the stock
+//! around it.
+//!
+//! Provenance: plain 2D distance and region geometry (point-segment
+//! distance, polygon booleans and the disc sweep of `geo2d`, clipper2)
+//! over the public wire EDM practice the umbrella #290 cites: the kerf
+//! is the wire diameter plus the gap on both sides, the wire is
+//! threaded through a start hole, and a closed cut frees the enclosed
+//! region (die slug or punch). Our own code; no vendor post, control
+//! manual or CAM product behaviour was consulted.
+
+mod dist;
+mod slug;
+#[cfg(test)]
+mod tests;
+
+use crate::cl::Toolpath;
+use crate::geo2d::{Point2, Region};
+
+pub use slug::Slug;
+
+/// How far (mm) the kerf may come under its offset to the product
+/// before the kerf law calls it a gouge: 0.1 um - the generator builds
+/// the path at the offset to 10 nm, the sections are facet-exact.
+pub const KERF_TOL: f64 = 1e-4;
+/// The least area (mm²) of product a freed piece may hold before the
+/// slug law reads it as holding product: a numerical sliver is not a
+/// part.
+pub const SLUG_AREA_TOL: f64 = 1e-3;
+
+/// Which side of the cut is kept - stated by the operation, never read
+/// from the geometry.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CutSide {
+    /// The opening is the product: the material outside the cut stays.
+    Die,
+    /// The enclosed piece is the product: it drops when the cut closes.
+    Punch,
+}
+
+impl CutSide {
+    #[must_use]
+    pub fn word(self) -> &'static str {
+        match self {
+            CutSide::Die => "die",
+            CutSide::Punch => "punch",
+        }
+    }
+}
+
+/// The material at one judged height: the part model's section and the
+/// stock's (when the setup has one).
+#[derive(Clone, Debug)]
+pub struct WireSection {
+    pub z: f64,
+    pub part: Region,
+    pub stock: Option<Region>,
+}
+
+/// One wire cut to judge.
+#[derive(Clone, Debug)]
+pub struct WireJob<'a> {
+    pub path: &'a Toolpath,
+    /// Wire radius plus spark gap (mm).
+    pub kerf_offset: f64,
+    pub side: CutSide,
+    /// The operation's stated start hole; `None` is not stated.
+    pub start: Option<Point2>,
+    /// The sections through the height the wire passes, low to high.
+    pub sections: Vec<WireSection>,
+}
+
+/// Every finding refuses: the wire laws have no warning tier.
+#[derive(Clone, Debug, PartialEq)]
+pub enum WireFinding {
+    /// The path cannot be read by these laws (an arc, a posed or
+    /// non-planar move, no moves, a bad offset).
+    Unreadable(String),
+    NoStart,
+    /// The path does not start at the stated start hole.
+    StartMoved { stated: Point2, path: Point2 },
+    /// The product stands nearer the threading point than the kerf.
+    Threading { z: f64, at: Point2, clear: f64, need: f64 },
+    /// The kerf of move `move_no` (1-based) enters the product.
+    Gouge { move_no: usize, z: f64, at: Point2, depth: f64, moves: usize },
+    /// The closed cut frees no material.
+    NothingFreed { z: f64 },
+    /// The piece freed is not the one the stated side drops.
+    WrongSlug { z: f64, side: CutSide, at: Point2, product_area: f64 },
+}
+
+impl WireFinding {
+    /// The finding in words, mm.
+    #[must_use]
+    pub fn describe(&self) -> String {
+        match self {
+            WireFinding::Unreadable(why) => format!("the wire laws cannot read the path - {why}"),
+            WireFinding::NoStart => {
+                "no start hole is stated - the wire cannot be threaded, nothing is judged clear".into()
+            }
+            WireFinding::StartMoved { stated, path } => format!(
+                "the path starts at X{:.3} Y{:.3}, not at the stated start hole X{:.3} Y{:.3} - regenerate it",
+                path.x, path.y, stated.x, stated.y
+            ),
+            WireFinding::Threading { z, at, clear, need } => format!(
+                "the start hole at X{:.3} Y{:.3} is not clear for threading at Z{z:.3}: the part stands {} - the wire and its gap need {need:.4} mm all round",
+                at.x,
+                at.y,
+                if *clear <= 0.0 { "at the threading point itself".to_owned() } else { format!("{clear:.4} mm from it") }
+            ),
+            WireFinding::Gouge { move_no, z, at, depth, moves } => format!(
+                "gouge: the kerf of move {move_no} enters the part by {depth:.4} mm near X{:.3} Y{:.3} at Z{z:.3} ({moves} move(s) gouge)",
+                at.x, at.y
+            ),
+            WireFinding::NothingFreed { z } => format!(
+                "the cut frees no material at Z{z:.3} - nothing drops when it closes (no closed cut, or no stock around the opening to judge the slug)"
+            ),
+            WireFinding::WrongSlug { z, side: CutSide::Die, at, product_area } => format!(
+                "slug: the piece freed near X{:.3} Y{:.3} at Z{z:.3} holds {product_area:.3} mm² of the part - a die keeps the material outside the cut, but here the part drops",
+                at.x, at.y
+            ),
+            WireFinding::WrongSlug { z, side: CutSide::Punch, at, .. } => format!(
+                "slug: the piece freed near X{:.3} Y{:.3} at Z{z:.3} holds none of the part - a punch's cut frees the punch, but here only waste drops and the part stays in the skeleton",
+                at.x, at.y
+            ),
+        }
+    }
+}
+
+/// The verdict: every refusal, and the pieces the cut frees at the
+/// lowest judged height that holds material (the report line's slug).
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct WireVerdict {
+    pub findings: Vec<WireFinding>,
+    pub slugs: Vec<Slug>,
+}
+
+/// The product's section at one height (module head): the model, or
+/// the stock around it when the model is a die's opening.
+pub(crate) enum Product<'a> {
+    Part(&'a Region),
+    /// Everything outside `opening`, within `stock` when there is one.
+    Around { opening: &'a Region, stock: Option<&'a Region> },
+}
+
+impl Product<'_> {
+    fn contains(&self, p: Point2) -> bool {
+        match self {
+            Product::Part(r) => r.contains(p),
+            Product::Around { opening, stock } => !opening.contains(p) && stock.is_none_or(|s| s.contains(p)),
+        }
+    }
+
+    fn boundary(&self) -> &Region {
+        match self {
+            Product::Part(r) => r,
+            Product::Around { opening, .. } => opening,
+        }
+    }
+}
+
+/// Judge one wire cut by the three laws.
+#[must_use]
+pub fn judge(job: &WireJob<'_>) -> WireVerdict {
+    let mut v = WireVerdict::default();
+    let k = job.kerf_offset;
+    if !(k.is_finite() && k > 0.0) {
+        v.findings.push(WireFinding::Unreadable(format!("the kerf offset {k} is not a positive number")));
+        return v;
+    }
+    let polyline = match polyline(job.path) {
+        Ok(p) => p,
+        Err(why) => {
+            v.findings.push(WireFinding::Unreadable(why));
+            return v;
+        }
+    };
+    let Some(start) = job.start else {
+        v.findings.push(WireFinding::NoStart);
+        return v;
+    };
+    let first = polyline[0];
+    if dist::pp(first, start) > 1e-6 {
+        v.findings.push(WireFinding::StartMoved { stated: start, path: first });
+    }
+    // The die's reading of the model (module head), decided once for
+    // the whole height: the start hole stands in the model at some plane.
+    let opening = job.side == CutSide::Die && job.sections.iter().any(|s| s.part.contains(start));
+    // The threading point's worst plane, and the first plane that gouges.
+    let mut worst: Option<(f64, f64)> = None;
+    let mut gouge: Option<WireFinding> = None;
+    for s in &job.sections {
+        let p = product(s, opening);
+        let (clear, _) = dist::clearance(&p, start, start);
+        if worst.is_none_or(|(c, _)| clear < c) {
+            worst = Some((clear, s.z));
+        }
+        if gouge.is_none() {
+            gouge = gouge_at(&p, &polyline, k, s.z);
+        }
+    }
+    if let Some((clear, z)) = worst.filter(|(c, _)| *c < k - KERF_TOL) {
+        v.findings.push(WireFinding::Threading { z, at: start, clear, need: k });
+    }
+    v.findings.extend(gouge);
+    slug::judge(job, &polyline, opening, &mut v);
+    v
+}
+
+fn product(s: &WireSection, opening: bool) -> Product<'_> {
+    if opening {
+        Product::Around { opening: &s.part, stock: s.stock.as_ref() }
+    } else {
+        Product::Part(&s.part)
+    }
+}
+
+/// The first move whose kerf enters the product at this height, with
+/// the count of moves that do.
+fn gouge_at(p: &Product<'_>, pts: &[Point2], k: f64, z: f64) -> Option<WireFinding> {
+    let mut first: Option<(usize, Point2, f64)> = None;
+    let mut moves = 0;
+    for (i, w) in pts.windows(2).enumerate() {
+        let (d, at) = dist::clearance(p, w[0], w[1]);
+        if d < k - KERF_TOL {
+            moves += 1;
+            if first.is_none() {
+                first = Some((i + 1, at, k - d));
+            }
+        }
+    }
+    first.map(|(move_no, at, depth)| WireFinding::Gouge { move_no, z, at, depth, moves })
+}
+
+/// The path as the polyline the wire's centre walks: straight, planar,
+/// unposed, contiguous moves only - anything else is not what these
+/// laws can read, and is refused by name.
+fn polyline(path: &Toolpath) -> Result<Vec<Point2>, String> {
+    let Some(m0) = path.moves.first() else {
+        return Err("the path has no moves".into());
+    };
+    let mut pts = vec![Point2::new(m0.from.x, m0.from.y)];
+    for (i, m) in path.moves.iter().enumerate() {
+        let n = i + 1;
+        if m.arc.is_some() || m.axis.is_some() {
+            return Err(format!("move {n} is an arc or states a pose - the 2-axis wire laws read straight vertical moves only"));
+        }
+        let finite = [m.from.x, m.from.y, m.from.z, m.to.x, m.to.y, m.to.z].iter().all(|c| c.is_finite());
+        if !finite || (m.from.z - m0.from.z).abs() > 1e-9 || (m.to.z - m0.from.z).abs() > 1e-9 {
+            return Err(format!("move {n} leaves the programmed plane"));
+        }
+        let from = Point2::new(m.from.x, m.from.y);
+        if pts.last().is_some_and(|l| dist::pp(*l, from) > 1e-6) {
+            return Err(format!("move {n} does not start where the move before it ended"));
+        }
+        pts.push(Point2::new(m.to.x, m.to.y));
+    }
+    Ok(pts)
+}
diff --git a/crates/sim/src/verify/wire/slug.rs b/crates/sim/src/verify/wire/slug.rs
new file mode 100644
index 000000000..d278a6577
--- /dev/null
+++ b/crates/sim/src/verify/wire/slug.rs
@@ -0,0 +1,131 @@
+//! The slug law (#534, #290 D7): what drops free when the wire's cut
+//! closes, by region connectivity. The kerf region (the disc of the
+//! kerf offset swept along the wire path) is taken out of the material
+//! section; the connected pieces left that lie inside the cut's filled
+//! outline are freed, the rest stay held by the stock's outside.
+//! Provenance: polygon booleans and the disc sweep of `geo2d`
+//! (clipper2) over the public reading of a closed wire cut (the
+//! enclosed region is cut free: a die's slug, or the punch itself).
+//! Our own code.
+
+use super::{CutSide, WireFinding, WireJob, WireVerdict, SLUG_AREA_TOL};
+use crate::geo2d::{Loop, Point2, Region};
+
+/// A piece the closed cut frees at one height.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Slug {
+    pub z: f64,
+    /// The piece's area, mm².
+    pub area: f64,
+    /// The middle of the piece's bounds.
+    pub at: Point2,
+    /// How much of the product the piece holds, mm².
+    pub product_area: f64,
+}
+
+/// Each outer loop with the holes it carries, as its own region (a hole
+/// goes to the smallest outer loop that contains it).
+fn components(r: &Region) -> Result<Vec<Region>, String> {
+    let (outers, holes): (Vec<&Loop>, Vec<&Loop>) = r.loops().iter().partition(|l| l.area() > 0.0);
+    let mut groups: Vec<Vec<Loop>> = outers.iter().map(|o| vec![(*o).clone()]).collect();
+    for h in holes {
+        let Some(&p) = h.points().first() else { continue };
+        let mut best: Option<(usize, f64)> = None;
+        for (i, o) in outers.iter().enumerate() {
+            let inside = Region::new(vec![(*o).clone()]).map_err(|e| e.to_string())?.contains(p);
+            if inside && best.is_none_or(|(_, a)| o.area() < a) {
+                best = Some((i, o.area()));
+            }
+        }
+        if let Some((i, _)) = best
+            && let Some(g) = groups.get_mut(i)
+        {
+            g.push(h.clone());
+        }
+    }
+    groups.into_iter().map(|g| Region::new(g).map_err(|e| e.to_string())).collect()
+}
+
+fn centre(r: &Region) -> Point2 {
+    r.bounds().map_or(Point2::new(0.0, 0.0), |(a, b)| Point2::new((a.x + b.x) * 0.5, (a.y + b.y) * 0.5))
+}
+
+/// The pieces freed at one height, or why they cannot be read.
+fn freed_at(
+    material: &Region,
+    product: &Region,
+    kerf: &Region,
+    fill: &Region,
+    z: f64,
+) -> Result<Vec<Slug>, String> {
+    let e = |e: crate::geo2d::GeoError| e.to_string();
+    let mut out = Vec::new();
+    for piece in components(&material.difference(kerf).map_err(e)?)? {
+        let area = piece.area();
+        if area <= SLUG_AREA_TOL || piece.difference(fill).map_err(e)?.area() > SLUG_AREA_TOL {
+            continue;
+        }
+        let product_area = piece.intersect(product).map_err(e)?.area();
+        out.push(Slug { z, area, at: centre(&piece), product_area });
+    }
+    Ok(out)
+}
+
+/// Run the slug law over every section; the first height that flags
+/// is named, and the lowest height holding material reports its slugs.
+pub(super) fn judge(job: &WireJob<'_>, pts: &[Point2], opening: bool, v: &mut WireVerdict) {
+    let unreadable = |why: String| WireFinding::Unreadable(format!("the slug cannot be judged - {why}"));
+    let kerf = match Region::sweep(&[pts.to_vec()], job.kerf_offset) {
+        Ok(r) => r,
+        Err(e) => return v.findings.push(unreadable(e.to_string())),
+    };
+    let fill = match Region::new(kerf.loops().iter().filter(|l| l.area() > 0.0).cloned().collect()) {
+        Ok(r) => r,
+        Err(e) => return v.findings.push(unreadable(e.to_string())),
+    };
+    let mut reported = false;
+    for s in &job.sections {
+        let material = match &s.stock {
+            Some(st) => s.part.union(st),
+            None => Ok(s.part.clone()),
+        };
+        let product = match (opening, &s.stock) {
+            (false, _) => Ok(s.part.clone()),
+            (true, Some(st)) => st.difference(&s.part),
+            (true, None) => Ok(Region::empty()),
+        };
+        if material.as_ref().is_ok_and(Region::is_empty) {
+            continue;
+        }
+        let freed = match (material, product) {
+            (Ok(m), Ok(p)) => freed_at(&m, &p, &kerf, &fill, s.z),
+            (Err(e), _) | (_, Err(e)) => Err(e.to_string()),
+        };
+        let freed = match freed {
+            Ok(f) => f,
+            Err(why) => return v.findings.push(unreadable(why)),
+        };
+        if !reported {
+            v.slugs.clone_from(&freed);
+            reported = true;
+        }
+        let flag = match job.side {
+            _ if freed.is_empty() => Some(WireFinding::NothingFreed { z: s.z }),
+            CutSide::Die => freed.iter().find(|f| f.product_area > SLUG_AREA_TOL).map(|f| WireFinding::WrongSlug {
+                z: s.z,
+                side: CutSide::Die,
+                at: f.at,
+                product_area: f.product_area,
+            }),
+            CutSide::Punch => freed.iter().all(|f| f.product_area <= SLUG_AREA_TOL).then(|| WireFinding::WrongSlug {
+                z: s.z,
+                side: CutSide::Punch,
+                at: freed.first().map_or(Point2::new(0.0, 0.0), |f| f.at),
+                product_area: 0.0,
+            }),
+        };
+        if let Some(f) = flag {
+            return v.findings.push(f);
+        }
+    }
+}
diff --git a/crates/sim/src/verify/wire/tests.rs b/crates/sim/src/verify/wire/tests.rs
new file mode 100644
index 000000000..1cb23d12b
--- /dev/null
+++ b/crates/sim/src/verify/wire/tests.rs
@@ -0,0 +1,115 @@
+//! The wire laws on synthetic squares (#534): a clean punch and die
+//! pass, a kerf into the part is a gouge naming its move, a missing or
+//! crowded start hole is refused, and the slug is read for each side.
+//! Provenance: our own fixtures.
+
+use super::*;
+use crate::cl::{MoveKind, PathBuilder};
+use crate::geo2d::Loop;
+use crate::geometry::Point3;
+
+const K: f64 = 0.2;
+
+fn square_loop(h: f64) -> Loop {
+    Loop::new(vec![Point2::new(-h, -h), Point2::new(h, -h), Point2::new(h, h), Point2::new(-h, h)]).expect("loop")
+}
+
+fn square(h: f64) -> Region {
+    Region::new(vec![square_loop(h)]).expect("region")
+}
+
+/// A closed square path of half-side `h` threaded from `start` by a
+/// straight lead to its left side's middle, out the same way.
+fn path(h: f64, start: Point2) -> Toolpath {
+    let p = |x: f64, y: f64| Point3::new(x, y, 0.0);
+    let mut b = PathBuilder::new(p(start.x, start.y));
+    for (x, y) in [(-h, 0.0), (-h, -h), (h, -h), (h, h), (-h, h), (-h, 0.0), (start.x, start.y)] {
+        b.push(MoveKind::Feed, p(x, y), None);
+    }
+    b.finish()
+}
+
+fn sections(part: &Region, stock: Option<&Region>) -> Vec<WireSection> {
+    [0.001, 6.0, 11.999].iter().map(|&z| WireSection { z, part: part.clone(), stock: stock.cloned() }).collect()
+}
+
+fn run(side: CutSide, tp: &Toolpath, start: Option<Point2>, part: &Region, stock: Option<&Region>) -> WireVerdict {
+    judge(&WireJob { path: tp, kerf_offset: K, side, start, sections: sections(part, stock) })
+}
+
+#[test]
+fn a_correct_punch_passes_and_drops_the_punch() {
+    let (part, stock) = (square(5.0), square(15.0));
+    let start = Point2::new(-10.0, 0.0);
+    let v = run(CutSide::Punch, &path(5.0 + K, start), Some(start), &part, Some(&stock));
+    assert!(v.findings.is_empty(), "{:?}", v.findings);
+    assert_eq!(v.slugs.len(), 1, "{:?}", v.slugs);
+    assert!((v.slugs[0].product_area - 100.0).abs() < 1e-3, "the punch drops: {:?}", v.slugs);
+}
+
+#[test]
+fn a_correct_die_passes_whether_the_model_is_the_opening_or_the_plate() {
+    let stock = square(15.0);
+    let start = Point2::new(0.0, 0.0);
+    let tp = path(5.0 - K, start);
+    // The model is the opening (#532's whole-model die): the product is the stock around it.
+    let v = run(CutSide::Die, &tp, Some(start), &square(5.0), Some(&stock));
+    assert!(v.findings.is_empty(), "{:?}", v.findings);
+    assert_eq!(v.slugs.len(), 1);
+    // The slug: the 9.2 mm square inside the kerf, less the lead-in's slot.
+    let a = v.slugs[0].area;
+    assert!(v.slugs[0].product_area < SLUG_AREA_TOL && a < 84.64 && a > 84.64 - 4.6 * 2.0 * K - 0.1, "{:?}", v.slugs);
+    // The model is a die plate with the opening as its hole.
+    let plate = Region::new(vec![square_loop(15.0), square_loop(5.0)]).expect("plate");
+    let v = run(CutSide::Die, &tp, Some(start), &plate, Some(&stock));
+    assert!(v.findings.is_empty(), "{:?}", v.findings);
+    assert!(v.slugs.len() == 1 && v.slugs[0].product_area < SLUG_AREA_TOL, "{:?}", v.slugs);
+}
+
+#[test]
+fn a_kerf_into_the_part_is_a_gouge_naming_the_move() {
+    let start = Point2::new(-10.0, 0.0);
+    // The path stands only half the kerf off the part.
+    let v = run(CutSide::Punch, &path(5.0 + K * 0.5, start), Some(start), &square(5.0), Some(&square(15.0)));
+    let g = v.findings.iter().find(|f| matches!(f, WireFinding::Gouge { .. })).expect("gouge");
+    let WireFinding::Gouge { move_no, depth, .. } = g else { unreachable!() };
+    assert_eq!(*move_no, 1, "the lead-in's end already burns the part");
+    assert!((depth - K * 0.5).abs() < 1e-9, "{depth}");
+    assert!(g.describe().contains("gouge: the kerf of move 1 enters the part"), "{}", g.describe());
+}
+
+#[test]
+fn a_missing_moved_or_crowded_start_hole_is_refused() {
+    let (part, stock) = (square(5.0), square(15.0));
+    let start = Point2::new(-10.0, 0.0);
+    let tp = path(5.0 + K, start);
+    let v = run(CutSide::Punch, &tp, None, &part, Some(&stock));
+    assert_eq!(v.findings, vec![WireFinding::NoStart]);
+    assert!(v.findings[0].describe().contains("no start hole is stated"));
+    let v = run(CutSide::Punch, &tp, Some(Point2::new(-11.0, 0.0)), &part, Some(&stock));
+    assert!(v.findings.iter().any(|f| matches!(f, WireFinding::StartMoved { .. })), "{:?}", v.findings);
+    // Threaded 0.1 mm off the part: the wire and its gap need 0.2.
+    let near = Point2::new(-5.1, 0.0);
+    let v = run(CutSide::Punch, &path(5.0 + K, near), Some(near), &part, Some(&stock));
+    let t = v.findings.iter().find(|f| matches!(f, WireFinding::Threading { .. })).expect("threading");
+    assert!(t.describe().contains("not clear for threading") && t.describe().contains("0.1000 mm from it"), "{}", t.describe());
+}
+
+#[test]
+fn the_slug_is_read_for_the_stated_side() {
+    let stock = square(15.0);
+    // A die plate's hole cut as a punch: only the waste slug drops.
+    let plate = Region::new(vec![square_loop(15.0), square_loop(5.0)]).expect("plate");
+    let start = Point2::new(0.0, 0.0);
+    let v = run(CutSide::Punch, &path(5.0 - K, start), Some(start), &plate, Some(&stock));
+    let f = v.findings.iter().find(|f| matches!(f, WireFinding::WrongSlug { .. })).expect("wrong slug");
+    assert!(f.describe().contains("holds none of the part"), "{}", f.describe());
+    // A punch's outline cut as a die (threaded outside the part): the part drops.
+    let out = Point2::new(-10.0, 0.0);
+    let v = run(CutSide::Die, &path(5.0 + K, out), Some(out), &square(5.0), Some(&stock));
+    let f = v.findings.iter().find(|f| matches!(f, WireFinding::WrongSlug { .. })).expect("wrong slug");
+    assert!(f.describe().contains("here the part drops"), "{}", f.describe());
+    // No stock around a die plate's hole: nothing drops, and that is said.
+    let v = run(CutSide::Die, &path(5.0 - K, start), Some(start), &plate, None);
+    assert!(v.findings.iter().any(|f| matches!(f, WireFinding::NothingFreed { .. })), "{:?}", v.findings);
+}
diff --git a/docs/decisions/534-wire-verify.md b/docs/decisions/534-wire-verify.md
new file mode 100644
index 000000000..2e2d33bca
--- /dev/null
+++ b/docs/decisions/534-wire-verify.md
@@ -0,0 +1,16 @@
+## #534 - Wire EDM: verification of a 2-axis cut
+
+The umbrella (#290 D7) decided a 2.5D verify: the kerf region against the part section, the start hole's threading clearance through the full height, and slug analysis by region connectivity, every flag blocking the post. These are the points it left open.
+
+**Decided:**
+
+- **Judged at the post, live.** The laws (`sim::verify::wire`) run in the verification gate's own wire clause (`posting_wire.rs`), beside the plasma clause, over the cached path and the part and stock as they stand now. Every finding is a blocking problem; there is no warning tier. The not-judged line says the 3D stock sim did not run for the wire and names the piece each cut frees. *Dropped:* a generator-time verdict cached with the path - the plasma precedent and the live-gate law (fixtures, machine limits) judge what the room is now.
+- **The whole height the wire passes.** A vertical wire cuts everything between its guides, so the heights judged span the op's planes, the part and the stock, whichever reaches farther: both ends (1 um inside, so a horizontal face is never sliced edge-on) and about every 2 mm between, at most nine sections. *Dropped:* the two programmed planes only - a part taller than the planes, or a step between them, would pass unseen.
+- **The kerf law is exact distance, not area.** A move gouges when its segment comes nearer the product's section than the kerf offset (less 0.1 um) or stands in it; the first such move is named with its depth, the spot and the count. *Dropped:* a swept-capsule boolean with an area threshold - a 10 um intrusion along a 1 mm move falls under any sensible sliver area.
+- **What "the part" is, by the stated side.** A punch's product is the model. A die's product is the model when the start hole stands outside it (a die plate: the opening is its hole); when the start hole stands in the model, the model is the opening itself (#532's whole-model die, where the model's silhouette is the profile) and the product is the stock around it. The start hole is stated and the generator already refuses it on the product's side, so this reads a stated fact, not the geometry's guess. *Dropped:* refusing the whole-model die - #532 ships it as the way a die is cut from a model.
+- **Threading clearance = the kerf offset.** The op states a threading point, not a hole diameter (#532), so "too small" is read as: the product stands nearer the threading point than wire radius + gap at some height. A start hole not stated, or a path that no longer starts at it, is refused by name. A pre-drilled hole's diameter is not modelled.
+- **The slug, by connectivity.** The kerf (the disc of the offset swept along the whole path) is taken out of the material section (stock and part); a piece left inside the kerf's filled outline is freed. A die's freed piece must hold none of the product (else "the part drops"); a punch's freed pieces must hold some (else "only waste drops"); a cut that frees nothing is refused (no stock around a die plate's hole means the slug cannot be judged - said, not passed).
+- **No capture or tab law yet.** D6 says an unsupported slug is refused unless a tab or capture is set; tabs are #539 and no capture parameter exists. This PR flags only a slug on the wrong side and a cut that frees nothing; a correct die or punch passes, and the report names what drops so the operator can catch it. When #539 lands it adds the capture law here.
+- **No part, no verdict.** A wire cut taken from the stock has no part to judge the kerf against and is refused at the gate by name.
+
+**Cost to change later:** the laws are pure functions of a path, an offset, a side, a start and a list of sections; adding the taper (#536) means a section pair per move and the ruled surface between, without changing the gate seam.

From d69f28691dd1632a161628366783a2a9ad179731 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 01:08:08 -0800
Subject: [PATCH 09/12] feat(edm): wire contour cuts an open run from the
 stock's edge

The Wire Contour op accepts one open run (a cut-off, a slot, a relief)
entered from the stock's edge: the kerf stated left or right of travel,
the wire threaded and run out along the run's own ends the kerf offset
plus a stated clearance off the stock, no start hole. Refused by name:
die/punch on an open run (no kerf side stated), left/right on a closed
profile, no stock, an end that stops inside the stock, a run that never
enters it, a self-crossing or doubling-back run, several runs, a corner
tighter than the wire, a run-out that would cut the stock. Closed
profiles and their goldens are unchanged.

Fixes #1109

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
