diff --git a/docs/decisions/1245-site-search.md b/docs/decisions/1245-site-search.md
new file mode 100644
index 000000000..eabbe4ecf
--- /dev/null
+++ b/docs/decisions/1245-site-search.md
@@ -0,0 +1,22 @@
+## #1245 - Docs site search
+
+**What was decided.** Zola builds the search index (`build_search_index = true`,
+`index_format = "elasticlunr_javascript"`, so `search_index.en.js`). The header
+box in `site/templates/base.html` loads that index with elasticlunr 0.9.5
+vendored at `site/static/vendor/elasticlunr.min.js` and its MIT licence beside
+it. Result links are the page URLs Zola built from `base_url`, so the base
+path is carried without a hard-coded host.
+
+**Why.** The site must work with no third-party service at run time, and the
+index is already produced by Zola, so the only addition is the browser side.
+Zola's pinned version (v0.23.6 in release.yml) already emits this format.
+
+**Considered and dropped.** A CDN script (cdnjs or jsdelivr): it would need a
+network fetch on every visit and a pinned exact version anyway, so vendoring
+was the cheaper choice. Full-page bodies in the index: dropped, the index
+would grow past 200 KB per build of the guide; the body is cut to 2000
+characters.
+
+**Cost to change later.** Replacing elasticlunr means swapping the vendored
+file and the inline script's `Index.load` and `search` calls. The search
+options (`[search]` in `config.toml`) are one block.
diff --git a/site/README.md b/site/README.md
index 6cef32760..193f59906 100644
--- a/site/README.md
+++ b/site/README.md
@@ -14,7 +14,12 @@ zola check          # build and check every link
   `developers/` (developer section). A page's place in its section is its
   `weight`.
 - `templates/` - our own Tera templates; no third-party theme.
-- `static/` - the stylesheet, copied as is.
+- `static/` - the stylesheet, copied as is, and `vendor/` (elasticlunr, the
+  MIT-licensed search library, with its licence beside it).
+- Search (#1245): `build_search_index` writes `search_index.en.js`, which the
+  header search box loads with the vendored elasticlunr. No third-party
+  service; the index is built from each page's title, description and the
+  first 2000 characters of its body.
 
 The version shown on the site comes from `version.toml`, which the release
 workflow writes from the workspace version before it builds. Without it the
diff --git a/site/config.toml b/site/config.toml
index 01b63788e..0edf3b0eb 100644
--- a/site/config.toml
+++ b/site/config.toml
@@ -8,9 +8,20 @@ title = "CamCraft"
 description = "CamCraft: an open-source CAM system that turns 3D models into G-code for CNC mills and lathes."
 default_language = "en"
 compile_sass = false
-build_search_index = false
+build_search_index = true
 generate_feeds = false
 
+# Search (#1245): Zola writes search_index.en.js from the pages below; the
+# header box loads it with the vendored elasticlunr (static/vendor/). Only
+# the title, description, path and the start of each body are indexed.
+[search]
+index_format = "elasticlunr_javascript"
+include_title = true
+include_description = true
+include_path = true
+include_content = true
+truncate_content_length = 2000
+
 [markdown]
 smart_punctuation = false
 
diff --git a/site/static/style.css b/site/static/style.css
index 551a76d54..ac62178ba 100644
--- a/site/static/style.css
+++ b/site/static/style.css
@@ -45,3 +45,16 @@ blockquote { margin: 1em 0; padding: 8px 16px; border-left: 4px solid var(--acce
 .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 32px; padding-top: 12px; border-top: 1px solid var(--line); }
 .foot { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; padding-top: 12px; padding-bottom: 24px; }
 .small { font-size: 0.82rem; }
+/* Search box in the header (#1245): results are a dropdown under the field. */
+.visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.search { position: relative; flex: 1 1 200px; max-width: 320px; margin: 0 0 0 auto; }
+.search input { width: 100%; font: inherit; color: var(--fg); background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 6px 10px; }
+.search input:focus-visible, .search-results a:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+.search-results { position: absolute; top: 100%; left: 0; right: 0; z-index: 20; margin: 4px 0 0; padding: 4px; list-style: none; max-height: 60vh; overflow-y: auto; background: var(--bg); border: 1px solid var(--line); border-radius: 6px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18); }
+.search-results[hidden] { display: none; }
+.search-results li { margin: 0; }
+.search-results a { display: block; padding: 6px 8px; border-radius: 4px; color: var(--fg); text-decoration: none; }
+.search-results a:hover, .search-results a:focus-visible { background: var(--card); }
+.search-results a small { display: block; color: var(--muted); font-size: 0.85rem; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.search-results .search-empty { padding: 6px 8px; color: var(--muted); font-size: 0.9rem; }
+@media (max-width: 600px) { .search { flex-basis: 100%; max-width: none; margin: 0; } }
