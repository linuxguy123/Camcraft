Date: Thu, 12 Nov 2026 00:05:38 -0500
Subject: [PATCH] test(gate): a motion generator change runs the operations
 suite (#1068)

operations.rs generates through the app layer, so it pins the motion
generators end to end - but its Gate map named app modules only. A change
under crates/motion/src/multiaxis/ therefore passed quick while
multiaxis_rough_refuses_a_slot_the_cone_cannot_clear sat out; PR #1044 hit
exactly that and only failed when a stacked merge ran the whole app list.

Name the generators the suite drives - machining2d, machining3d, drilling,
finishing3d, multiaxis, plunge_law - and pin both the map and the plan in an
xtask unit test against this checkout: a change under
crates/motion/src/multiaxis/ selects app:operations.

xtask/ is a process file, so PROCESS_VERSION goes 16 -> 17 (same number as
the other open process PRs; whichever merges second renumbers).

Fixes #1068
---
 .claude/PROCESS_VERSION        |  2 +-
 crates/app/tests/operations.rs |  2 +-
 xtask/src/tests.rs             | 26 ++++++++++++++++++++++++++
 3 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/.claude/PROCESS_VERSION b/.claude/PROCESS_VERSION
index b6a7d89c6..98d9bcb75 100644
--- a/.claude/PROCESS_VERSION
+++ b/.claude/PROCESS_VERSION
@@ -1 +1 @@
-16
+17
diff --git a/crates/app/tests/operations.rs b/crates/app/tests/operations.rs
index fb85ea4d4..898805b13 100644
--- a/crates/app/tests/operations.rs
+++ b/crates/app/tests/operations.rs
@@ -3,7 +3,7 @@
 //! at command construction (validate early), and staleness is derived,
 //! never stored.
 //!
-//! Gate map (M4.4): covers app::cl, app::commands, app::drilling, app::finishing3d, app::geo2d, app::geometry, app::machining2d, app::model, app::operation, app::schema, app::stock, app::tools, app::verify, app::world.
+//! Gate map (M4.4): covers app::cl, app::commands, app::drilling, app::finishing3d, app::geo2d, app::geometry, app::machining2d, app::model, app::operation, app::schema, app::stock, app::tools, app::verify, app::world, motion::drilling, motion::finishing3d, motion::machining2d, motion::machining3d, motion::multiaxis, motion::plunge_law (the motion generators these tests drive end to end, #1068).
 //!
 //! Lane shape (M13.8): the debug ladder runs every test here in seconds.
 //! The six slow generate-and-verify laws (swarf, the swarf ladder,
diff --git a/xtask/src/tests.rs b/xtask/src/tests.rs
index 7e8f096c0..acbe9fbc5 100644
--- a/xtask/src/tests.rs
+++ b/xtask/src/tests.rs
@@ -153,6 +153,32 @@ fn shared_test_input_runs_every_suite_of_the_crate() {
     );
 }
 
+/// #1068: the operations suite generates through the app layer, so it pins the motion generators
+/// end to end - a change to one of them must run it. The map and the plan are both checked against
+/// this checkout, so a header that loses a name fails here rather than in a later PR's gate run.
+#[test]
+fn a_motion_generator_change_selects_the_operations_suite() {
+    let root = crate::root();
+    let map = scan::gate_map(&scan::read(&root.join("crates/app/tests/operations.rs")))
+        .expect("operations.rs gate map");
+    for m in ["machining2d", "machining3d", "drilling", "finishing3d", "multiaxis", "plunge_law"] {
+        assert!(map.contains(&format!("motion::{m}")), "operations.rs must name motion::{m}: {map}");
+    }
+    let changed = ["crates/motion/src/multiaxis/mod.rs".to_string()];
+    let none: Vec<String> = Vec::new();
+    let hunks = |_: &str| Vec::new();
+    let diff = Diff { changed: &changed, untracked: &none, hunks: &hunks };
+    let Quick::Plan(p) = quick::plan(&root, &diff, false).expect("quick plan") else {
+        panic!("a motion::multiaxis change must not fall back to batch")
+    };
+    assert!(
+        p.steps.iter().any(|s| s.args.iter().any(|a| a == "camcraft-app")
+            && s.args.iter().any(|a| a == "operations")),
+        "a motion::multiaxis change must select app:operations: {:?}",
+        p.steps
+    );
+}
