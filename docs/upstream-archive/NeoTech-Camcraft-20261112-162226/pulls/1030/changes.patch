--- /dev/null
+++ b/crates/kernel/tests/step_agreement.rs
@@ -0,0 +1,361 @@
+//! Dual-importer STEP bench (M12.1 stage 4, #916): every STEP file under
+//! testdata/models through the solidcore-side importer and through
+//! truck-stepio as crates/app reads it today. Per file both import, or one
+//! refuses by name; where both import, solid count, bounding box, volume,
+//! area and the length unit are compared within the stated tolerances. The
+//! verdicts are pinned in a table like stages 1-3: a disagreement is
+//! recorded, never averaged away, and a file with no row fails the bench.
+//! Provenance: our own bench design; the fixtures are the repo's own.
+//!
+//! Gate map (M12.1): covers camcraft_kernel::solidcore_step (read_step,
+//! import_step).
+
+mod step_util;
+
+use std::path::PathBuf;
+use std::time::Instant;
+
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::{StepRead, read_step};
+use camcraft_kernel::{KernelError, Measure};
+use step_util::{
+    CASE_TIMEOUT, CHORD_MM, SolidcoreMesh, TruckStep, bounded_cancel, solidcore_mesh, truck_read,
+};
+
+/// truck's numbers are a mesh's at [`CHORD_MM`]; solidcore's are exact.
+/// Relative volume and area distance the two may keep.
+const REL_TOL: f64 = 1e-3;
+/// Bounding-box corner distance the two may keep, in chords of the mesh
+/// it is judged against (a mesh stands inside its solid by its sagitta).
+const BOX_CHORDS: f64 = 2.0;
+
+/// One fixture: its length unit (mm per unit, what crates/app's
+/// `step_units` reads from it, pinned in crates/app/tests/import.rs) and
+/// the pinned verdicts of the importer comparison and of the mesh
+/// comparison.
+struct Row {
+    file: &'static str,
+    mm_per_unit: f64,
+    import: &'static str,
+    mesh: &'static str,
+}
+
+/// The pinned verdicts (readings in docs/decisions/916-solidcore-step-bench.md).
+///
+/// DISAGREEMENT, both Milling-test files: the port's "tight" bounding box
+/// of the imported solid is Y -30..30; the part is a 60 mm disc with a
+/// flat at Y = 19.719 (the file's own vertices, truck's mesh and
+/// solidcore's own mesh all stop there). Volume and area agree, so the
+/// solid is right and its box is not: the box takes the whole cylinder,
+/// not the trimmed face. Nothing may size stock from that box until it is
+/// fixed (#939).
+///
+/// The three tool_csys files hold a coordinate system and no solid: both
+/// importers refuse them by name.
+const ROWS: &[Row] = &[
+    Row {
+        file: "Milling-test-inch.step",
+        mm_per_unit: 25.4,
+        import: "disagree: bounding box",
+        mesh: "watertight, within tolerance",
+    },
+    Row {
+        file: "Milling-test.step",
+        mm_per_unit: 1.0,
+        import: "disagree: bounding box",
+        mesh: "watertight, within tolerance",
+    },
+    Row {
+        file: "box.step",
+        mm_per_unit: 1.0,
+        import: "agree",
+        mesh: "watertight, within tolerance",
+    },
+    Row {
+        file: "empty_list.step",
+        mm_per_unit: 1.0,
+        import: "agree",
+        mesh: "watertight, within tolerance",
+    },
+    Row {
+        file: "sample_ap214.step",
+        mm_per_unit: 1000.0,
+        import: "agree",
+        mesh: "watertight, within tolerance",
+    },
+    Row {
+        file: "tool_csys_box_iso13399.step",
+        mm_per_unit: 1.0,
+        import: "agree",
+        mesh: "watertight, within tolerance",
+    },
+    Row {
+        file: "tool_csys_degenerate.step",
+        mm_per_unit: 1.0,
+        import: "both refuse (solidcore: the file holds no solid)",
+        mesh: "no exact solid to judge against",
+    },
+    Row {
+        file: "tool_csys_iso13399.step",
+        mm_per_unit: 1.0,
+        import: "both refuse (solidcore: the file holds no solid)",
+        mesh: "no exact solid to judge against",
+    },
+    Row {
+        file: "tool_csys_none.step",
+        mm_per_unit: 1.0,
+        import: "both refuse (solidcore: the file holds no solid)",
+        mesh: "no exact solid to judge against",
+    },
+];
+
+fn models_dir() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models")
+}
+
+/// Every `.step` / `.stp` file under testdata/models, sorted by name.
+fn step_files() -> Vec<String> {
+    let mut names: Vec<String> = std::fs::read_dir(models_dir())
+        .map(|rd| {
+            rd.filter_map(|e| e.ok())
+                .filter_map(|e| e.file_name().into_string().ok())
+                .filter(|n| {
+                    let l = n.to_ascii_lowercase();
+                    l.ends_with(".step") || l.ends_with(".stp")
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    names.sort();
+    names
+}
+
+/// The solidcore side of one file, summed over its solids.
+struct Whole {
+    solids: usize,
+    measure: Measure,
+    area: f64,
+    gap: f64,
+}
+
+fn whole(read: &StepRead) -> Option<Whole> {
+    let first = read.solids.first()?;
+    let mut w = Whole {
+        solids: read.solids.len(),
+        measure: Measure {
+            volume: 0.0,
+            ..first.measure
+        },
+        area: 0.0,
+        gap: 0.0,
+    };
+    for s in &read.solids {
+        w.measure.volume += s.measure.volume;
+        w.area += s.area;
+        w.gap = w.gap.max(s.vertex_gap);
+        for i in 0..3 {
+            w.measure.min[i] = w.measure.min[i].min(s.measure.min[i]);
+            w.measure.max[i] = w.measure.max[i].max(s.measure.max[i]);
+        }
+    }
+    Some(w)
+}
+
+fn rel(a: f64, b: f64) -> f64 {
+    (a - b).abs() / b.abs().max(f64::MIN_POSITIVE)
+}
+
+/// The importer verdict of one file.
+fn import_verdict(
+    row_unit: f64,
+    sc: &Result<StepRead, KernelError>,
+    tr: &Result<TruckStep, String>,
+) -> String {
+    let sc_whole = match sc {
+        Err(e) => Err(format!("{e}")),
+        Ok(r) => match (r.refused.first(), whole(r)) {
+            (Some(f), _) => Err(format!("#{} at {}: {}", f.item, f.stage, f.reason)),
+            (None, None) => Err("the file holds no solid".into()),
+            (None, Some(w)) => Ok((r, w)),
+        },
+    };
+    match (sc_whole, tr) {
+        (Err(a), Err(_)) => format!("both refuse (solidcore: {})", first_words(&a)),
+        (Err(a), Ok(_)) => format!("solidcore refuses: {}", first_words(&a)),
+        (Ok(_), Err(b)) => format!("truck refuses: {}", first_words(b)),
+        (Ok((r, w)), Ok(t)) => {
+            let mut off = Vec::new();
+            let unit = match r.length_units_mm.as_slice() {
+                [] => 1.0,
+                [one] => *one,
+                _ => f64::NAN,
+            };
+            if rel(unit, row_unit) > 1e-12 || unit.is_nan() {
+                off.push("unit");
+            }
+            if w.solids != t.shells {
+                off.push("solid count");
+            }
+            let tm = Measure {
+                volume: t.mesh.volume,
+                min: t.mesh.min,
+                max: t.mesh.max,
+            };
+            if w.measure.bbox_deviation(&tm) > BOX_CHORDS * t.chord_mm {
+                off.push("bounding box");
+            }
+            if rel(t.mesh.volume, w.measure.volume) > REL_TOL {
+                off.push("volume");
+            }
+            if rel(t.mesh.area, w.area) > REL_TOL {
+                off.push("area");
+            }
+            if off.is_empty() {
+                "agree".into()
+            } else {
+                format!("disagree: {}", off.join(", "))
+            }
+        }
+    }
+}
+
+/// The first few words of a refusal: enough to name it, short enough to
+/// stay stable when a count or an id in its tail moves.
+fn first_words(s: &str) -> String {
+    s.split_whitespace().take(6).collect::<Vec<_>>().join(" ")
+}
+
+/// The mesh verdict of one file: solidcore's mesher against the exact
+/// solid, and against truck's mesh at the same chord.
+fn mesh_verdict(
+    sc: &Result<StepRead, KernelError>,
+    tr: &Result<TruckStep, String>,
+    tess: &Result<SolidcoreMesh, String>,
+) -> String {
+    let Some(w) = sc.as_ref().ok().and_then(whole) else {
+        return "no exact solid to judge against".into();
+    };
+    match tess {
+        Err(e) => format!("no mesh: {}", first_words(e)),
+        Ok(m) => {
+            let mut off = Vec::new();
+            if !m.refused_faces.is_empty() {
+                off.push("faces left out");
+            }
+            if m.mesh.open_edges > 0 {
+                off.push("open");
+            }
+            if rel(m.mesh.volume, w.measure.volume) > REL_TOL {
+                off.push("volume");
+            }
+            if rel(m.mesh.area, w.area) > REL_TOL {
+                off.push("area");
+            }
+            // The two meshes' boxes: each stands a chord inside the solid.
+            if let Ok(t) = tr {
+                let d = (0..3).fold(0.0_f64, |d, i| {
+                    d.max((m.mesh.min[i] - t.mesh.min[i]).abs())
+                        .max((m.mesh.max[i] - t.mesh.max[i]).abs())
+                });
+                if d > BOX_CHORDS * t.chord_mm.max(CHORD_MM) {
+                    off.push("box off truck's mesh");
+                }
+            }
+            if off.is_empty() {
+                "watertight, within tolerance".into()
+            } else {
+                format!("off: {}", off.join(", "))
+            }
+        }
+    }
+}
+
+struct Reading {
+    file: String,
+    import: String,
+    mesh: String,
+}
+
+fn read_one(file: &str, unit: f64) -> Reading {
+    let bytes = std::fs::read(models_dir().join(file)).unwrap_or_default();
+    assert!(!bytes.is_empty(), "{file}: fixture missing or empty");
+    let b = bytes.clone();
+    let t0 = Instant::now();
+    let sc = bounded_cancel(file, CASE_TIMEOUT, move |stop| {
+        let mut k = SolidcoreKernel::default();
+        read_step(&mut k, &b, stop)
+    });
+    let t_sc = t0.elapsed();
+    let b = bytes.clone();
+    let t0 = Instant::now();
+    let tr = bounded_cancel(file, CASE_TIMEOUT, move |_| truck_read(&b, unit));
+    let t_tr = t0.elapsed();
+    let t0 = Instant::now();
+    let tess = bounded_cancel(file, CASE_TIMEOUT, move |_| solidcore_mesh(&bytes));
+    let t_tess = t0.elapsed();
+
+    println!("== {file}");
+    match &sc {
+        Err(e) => println!("  solidcore  Err {e}"),
+        Ok(r) => {
+            if let Some(w) = whole(r) {
+                println!(
+                    "  solidcore  solids={} V={:.6} A={:.6} box={:?}..{:?} gap={:.2e} units={:?} ({t_sc:.1?})",
+                    w.solids, w.measure.volume, w.area, w.measure.min, w.measure.max, w.gap,
+                    r.length_units_mm
+                );
+            } else {
+                println!("  solidcore  no solid, units={:?} ({t_sc:.1?})", r.length_units_mm);
+            }
+            for f in &r.refused {
+                println!("  solidcore  refused #{} at {}: {}", f.item, f.stage, f.reason);
+            }
+            for n in r.notes.iter().chain(r.solids.iter().flat_map(|s| &s.notes)) {
+                println!("  solidcore  note: {n}");
+            }
+        }
+    }
+    match &tr {
+        Err(e) => println!("  truck      Err {e}"),
+        Ok(t) => println!(
+            "  truck      shells={} V={:.6} A={:.6} box={:?}..{:?} tris={} open={} chord={:.4} mm ({t_tr:.1?})",
+            t.shells, t.mesh.volume, t.mesh.area, t.mesh.min, t.mesh.max, t.mesh.triangles,
+            t.mesh.open_edges, t.chord_mm
+        ),
+    }
+    match &tess {
+        Err(e) => println!("  sc-tess    Err {e}"),
+        Ok(m) => println!(
+            "  sc-tess    V={:.6} A={:.6} box={:?}..{:?} tris={} open={} left out={:?} over tolerance={} ({t_tess:.1?})",
+            m.mesh.volume, m.mesh.area, m.mesh.min, m.mesh.max, m.mesh.triangles,
+            m.mesh.open_edges, m.refused_faces, m.over_tolerance
+        ),
+    }
+    let reading = Reading {
+        file: file.to_string(),
+        import: import_verdict(unit, &sc, &tr),
+        mesh: mesh_verdict(&sc, &tr, &tess),
+    };
+    println!("  verdict    import: {} | mesh: {}", reading.import, reading.mesh);
+    reading
+}
+
+#[test]
+fn step_files_agree_or_refuse_by_name() {
+    let files = step_files();
+    assert!(!files.is_empty(), "no STEP fixtures under {:?}", models_dir());
+    let mut observed = Vec::new();
+    for f in &files {
+        let unit = ROWS.iter().find(|r| r.file == f).map_or(1.0, |r| r.mm_per_unit);
+        let r = read_one(f, unit);
+        observed.push((r.file, r.import, r.mesh));
+    }
+    let pinned: Vec<(String, String, String)> = ROWS
+        .iter()
+        .map(|r| (r.file.to_string(), r.import.to_string(), r.mesh.to_string()))
+        .collect();
+    assert_eq!(
+        observed, pinned,
+        "STEP verdicts changed, or a fixture has no row - re-triage"
+    );
+}
diff --git a/crates/kernel/tests/step_import.rs b/crates/kernel/tests/step_import.rs
new file mode 100644
index 000000000..7a9f6f7b4
--- /dev/null
+++ b/crates/kernel/tests/step_import.rs
@@ -0,0 +1,319 @@
+//! The solidcore-side STEP importer on its own (M12.1 stage 4, #916): the
+//! closed forms and units it must hand out, and a corrupt-file corpus -
+//! blank, foreign, truncated and field-corrupted STEP text. Never a panic,
+//! never a hang (every case runs under a time bound that cancels the
+//! import); a file the importer accepts is whole, anything else is refused
+//! by name. Verdicts are pinned so a pin bump that changes one fails here.
+//! Provenance: our own corpus, shaped after the Prime Directive's
+//! degenerate-input list; edits are made on the repo's own box.step.
+//!
+//! Gate map (M12.1): covers camcraft_kernel::solidcore_step (read_step,
+//! import_step, the size and time bounds).
+
+mod step_util;
+
+use std::path::PathBuf;
+use std::time::Duration;
+
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::{MAX_STEP_BYTES, import_step, read_step};
+use camcraft_kernel::{KernelError, Measure};
+use solidcore::kernel::CancelToken;
+use step_util::{CASE_TIMEOUT, bounded_cancel, truck_read};
+
+fn models_dir() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models")
+}
+
+fn rel(a: f64, b: f64) -> f64 {
+    (a - b).abs() / b.abs().max(f64::MIN_POSITIVE)
+}
+
+/// The closed forms the importer must hand out exactly: the unit box of
+/// box.step, the same box from the file with an empty parameter list
+/// (#887), and the stated units of the inch and metre fixtures (#306).
+#[test]
+fn importer_hands_out_closed_forms_and_units() {
+    let import = |file: &'static str| {
+        let bytes = std::fs::read(models_dir().join(file)).unwrap_or_default();
+        bounded_cancel(file, CASE_TIMEOUT, move |stop| {
+            let mut k = SolidcoreKernel::default();
+            import_step(&mut k, &bytes, stop)
+                .map(|i| (i.solids.iter().map(|s| (s.measure, s.area)).collect::<Vec<_>>(), i.length_units_mm))
+        })
+    };
+    let unit_box = Measure {
+        volume: 1.0,
+        min: [0.0; 3],
+        max: [1.0; 3],
+    };
+    for file in ["box.step", "empty_list.step"] {
+        match import(file) {
+            Ok((solids, units)) => {
+                assert_eq!(units, [1.0], "{file}: millimetres");
+                assert_eq!(solids.len(), 1, "{file}: one solid");
+                for (m, area) in solids {
+                    assert!((m.volume - 1.0).abs() <= 1e-9, "{file}: volume {}", m.volume);
+                    assert!(m.bbox_deviation(&unit_box) <= 1e-9, "{file}: box {m:?}");
+                    assert!((area - 6.0).abs() <= 1e-9, "{file}: area {area}");
+                }
+            }
+            Err(e) => panic!("{file}: {e}"),
+        }
+    }
+    for (file, unit, solids) in [
+        ("Milling-test-inch.step", 25.4, 1),
+        ("sample_ap214.step", 1000.0, 3),
+    ] {
+        match import(file) {
+            Ok((s, units)) => {
+                assert_eq!(units, [unit], "{file}: mm per unit");
+                assert_eq!(s.len(), solids, "{file}: solids");
+            }
+            Err(e) => panic!("{file}: {e}"),
+        }
+    }
+    // The inch part is the millimetre part: same solid once in millimetres.
+    match (import("Milling-test.step"), import("Milling-test-inch.step")) {
+        (Ok((mm, _)), Ok((inch, _))) => {
+            let (a, b) = (mm.first().map(|s| s.0.volume), inch.first().map(|s| s.0.volume));
+            match (a, b) {
+                (Some(a), Some(b)) => assert!(rel(a, b) <= 1e-9, "mm {a} vs inch {b}"),
+                other => panic!("no solid: {other:?}"),
+            }
+        }
+        other => panic!("Milling-test pair: {:?}", other.0.err().or(other.1.err())),
+    }
+    for file in ["tool_csys_none.step", "tool_csys_degenerate.step"] {
+        match import(file) {
+            Err(KernelError::InvalidResult { detail, .. }) => {
+                assert_eq!(detail, "the file holds no solid", "{file}");
+            }
+            other => panic!("{file}: expected a named refusal, got {:?}", other.map(|_| "Ok")),
+        }
+    }
+}
+
+/// Compact verdict of an import: the error's kind, or the solids' volume.
+fn verdict(r: Result<f64, KernelError>) -> String {
+    match r {
+        Ok(v) => format!("Ok V={v:.3}"),
+        Err(KernelError::InvalidInput { .. }) => "Err refused".into(),
+        Err(KernelError::Failed { .. }) => "Err failed".into(),
+        Err(KernelError::InvalidResult { .. }) => "Err invalid".into(),
+        Err(KernelError::Unsupported { .. }) => "Err unsupported".into(),
+        Err(KernelError::TimedOut { .. }) => "Err timed out".into(),
+    }
+}
+
+fn box_text() -> String {
+    let bytes = std::fs::read(models_dir().join("box.step")).unwrap_or_default();
+    assert!(!bytes.is_empty(), "box.step missing");
+    String::from_utf8_lossy(&bytes).replace("\r\n", "\n")
+}
+
+/// `text` with the first `from` replaced by `to`; the edit must apply.
+fn edit(text: &str, from: &str, to: &str) -> Vec<u8> {
+    assert!(text.contains(from), "corpus edit no longer applies: {from}");
+    text.replacen(from, to, 1).into_bytes()
+}
+
+const ORIGIN: &str = "#158 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));";
+const SOLID: &str = "#16 = MANIFOLD_SOLID_BREP('', #17);";
+
+fn corpus() -> Vec<(&'static str, Vec<u8>)> {
+    let t = box_text();
+    let b = t.as_bytes();
+    let cut = |num: usize, den: usize| b.get(..b.len() * num / den).unwrap_or_default().to_vec();
+    let noise: Vec<u8> = (0u32..4096)
+        .map(|i| (i.wrapping_mul(2_654_435_761) >> 13) as u8)
+        .collect();
+    let nested = format!(
+        "ISO-10303-21;\nHEADER;\nENDSEC;\nDATA;\n#1 = A({}1{});\nENDSEC;\nEND-ISO-10303-21;\n",
+        "(".repeat(100_000),
+        ")".repeat(100_000)
+    );
+    vec![
+        ("empty file", Vec::new()),
+        ("one space", b" ".to_vec()),
+        ("text, not STEP", b"solid cube\nfacet normal 0 0 1\n".to_vec()),
+        ("binary noise 4 KiB", noise),
+        ("header only", b"ISO-10303-21;\nHEADER;\nENDSEC;\n".to_vec()),
+        (
+            "no entities",
+            b"ISO-10303-21;\nHEADER;\nENDSEC;\nDATA;\nENDSEC;\nEND-ISO-10303-21;\n".to_vec(),
+        ),
+        ("cut at 10%", cut(1, 10)),
+        ("cut at 50%", cut(1, 2)),
+        ("cut at 90%", cut(9, 10)),
+        ("parameter list 100000 deep", nested.into_bytes()),
+        (
+            "shell names a missing face",
+            edit(&t, "CLOSED_SHELL('', (#18, ", "CLOSED_SHELL('', (#99999, "),
+        ),
+        (
+            "solid names itself as its shell",
+            edit(&t, SOLID, "#16 = MANIFOLD_SOLID_BREP('', #16);"),
+        ),
+        (
+            "plane placed by itself",
+            edit(&t, "#80 = PLANE('', #81);", "#80 = PLANE('', #80);"),
+        ),
+        (
+            "one face dropped (open shell)",
+            edit(&t, "(#18, #25, #32, #39, #46, #53)", "(#25, #32, #39, #46, #53)"),
+        ),
+        (
+            "vertex moved 0.5 off its edges",
+            edit(&t, ORIGIN, "#158 = CARTESIAN_POINT('', (-0.5, 0.0, 0.0));"),
+        ),
+        (
+            "vertex at 1e300",
+            edit(&t, ORIGIN, "#158 = CARTESIAN_POINT('', (1.0E300, 0.0, 0.0));"),
+        ),
+        (
+            "point with one coordinate",
+            edit(&t, ORIGIN, "#158 = CARTESIAN_POINT('', (0.0));"),
+        ),
+        (
+            "length unit of zero inches",
+            edit(
+                &t,
+                "#12 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );",
+                "#12 = ( CONVERSION_BASED_UNIT('INCH', #900) LENGTH_UNIT() NAMED_UNIT(*) );\n\
+                 #900 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0), #901);\n\
+                 #901 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );",
+            ),
+        ),
+        (
+            "second copy of the solid",
+            edit(&t, SOLID, "#16 = MANIFOLD_SOLID_BREP('', #17);\n#990 = MANIFOLD_SOLID_BREP('', #17);"),
+        ),
+    ]
+}
+
+/// What `import_step` does with each corpus file, pinned. Nothing here may
+/// be `Ok` unless the edit left every solid of the file whole. The two
+/// `Ok` rows, each looked at:
+/// - "point with one coordinate": ISO 10303-42 lets a point list one to
+///   three coordinates; the reader takes the missing ones as 0, and the
+///   edited point is the origin, so the model is the same 1 mm box.
+/// - "second copy of the solid": the file states two solids on one shell
+///   and gets two (V = 2). The importer hands out what the file states; it
+///   does not look for coincident solids (recorded in the decision file).
+///
+/// "length unit of zero inches" is refused by the SEAM: the reader alone
+/// reads a unit it cannot convert as millimetres, silently.
+///
+/// Third column: truck-stepio on the same bytes, as the bench reads it
+/// (ruststep + `Table` + mesh; none of crates/app's checks after the
+/// mesh), with its mesh's open triangle sides. FINDINGS against that
+/// path, recorded and not chased here: it answers `Ok` with an OPEN mesh
+/// (open > 0) for a shell with a face dropped, dangling or unreadable and
+/// for a vertex moved off its edges or sent to 1e300, and it reads neither
+/// the solid item nor the length unit. What crates/app does with such a
+/// mesh afterwards is outside this crate's bench.
+const KNOWN_STEP_VERDICTS: &[(&str, &str, &str)] = &[
+    ("empty file", "Err refused", "Err"),
+    ("one space", "Err refused", "Err"),
+    ("text, not STEP", "Err refused", "Err"),
+    ("binary noise 4 KiB", "Err refused", "Err"),
+    ("header only", "Err refused", "Err"),
+    ("no entities", "Err invalid", "Err"),
+    ("cut at 10%", "Err refused", "Err"),
+    ("cut at 50%", "Err refused", "Err"),
+    ("cut at 90%", "Err refused", "Err"),
+    ("parameter list 100000 deep", "Err refused", "Err"),
+    ("shell names a missing face", "Err invalid", "Ok V=1.000 open=4"),
+    ("solid names itself as its shell", "Err invalid", "Ok V=1.000 open=0"),
+    ("plane placed by itself", "Err invalid", "Ok V=1.000 open=4"),
+    ("one face dropped (open shell)", "Err invalid", "Ok V=1.000 open=4"),
+    ("vertex moved 0.5 off its edges", "Err invalid", "Ok V=1.000 open=4"),
+    ("vertex at 1e300", "Err invalid", "Ok V=1.000 open=3"),
+    ("point with one coordinate", "Ok V=1.000", "Ok V=1.000 open=0"),
+    ("length unit of zero inches", "Err refused", "Ok V=1.000 open=0"),
+    ("second copy of the solid", "Ok V=2.000", "Ok V=1.000 open=0"),
+];
+
+#[test]
+fn corrupt_step_files_never_panic_or_hang() {
+    let mut observed = Vec::new();
+    for (name, bytes) in corpus() {
+        let bytes_for_truck = bytes.clone();
+        let v = bounded_cancel(name, CASE_TIMEOUT, move |stop| {
+            let mut k = SolidcoreKernel::default();
+            let r = import_step(&mut k, &bytes, stop);
+            if let Err(e) = &r {
+                println!("{name:<36} {e}");
+            }
+            verdict(r.map(|i| i.solids.iter().map(|s| s.measure.volume).sum()))
+        });
+        let b = bytes_for_truck;
+        let t = bounded_cancel(name, CASE_TIMEOUT, move |_| match truck_read(&b, 1.0) {
+            Ok(t) => format!("Ok V={:.3} open={}", t.mesh.volume, t.mesh.open_edges),
+            Err(e) => {
+                println!("{name:<36} truck: {e}");
+                "Err".to_string()
+            }
+        });
+        println!("{name:<36} -> solidcore {v} | truck {t}");
+        observed.push((name.to_string(), v, t));
+    }
+    let pinned: Vec<(String, String, String)> = KNOWN_STEP_VERDICTS
+        .iter()
+        .map(|(n, v, t)| (n.to_string(), v.to_string(), t.to_string()))
+        .collect();
+    assert_eq!(observed, pinned, "importer verdicts changed - re-triage");
+}
+
+/// The size bound and the time bound, each refused by name.
+#[test]
+fn importer_keeps_its_size_and_time_bounds() {
+    let over = bounded_cancel("oversized", CASE_TIMEOUT, |stop| {
+        let mut k = SolidcoreKernel::default();
+        let big = vec![b' '; MAX_STEP_BYTES + 1];
+        read_step(&mut k, &big, stop).map(|_| ())
+    });
+    match over {
+        Err(KernelError::InvalidInput { detail, .. }) => {
+            assert!(detail.contains("byte limit"), "{detail}");
+        }
+        other => panic!("oversized file: {other:?}"),
+    }
+    // A bound already reached: nothing is parsed.
+    let text = box_text().into_bytes();
+    let stop = CancelToken::new();
+    stop.cancel();
+    let mut k = SolidcoreKernel::default();
+    match import_step(&mut k, &text, &stop).map(|_| ()) {
+        Err(KernelError::TimedOut { op, stage }) => {
+            assert_eq!((op, stage), ("read_step", "before parsing"));
+        }
+        other => panic!("cancelled before the start: {other:?}"),
+    }
+    // The kernel is usable again and keeps no token of the refused call.
+    assert!(k.k.cancel.is_none(), "the caller's kernel keeps the import's token");
+    stop.reset();
+    let again = import_step(&mut k, &text, &stop).map(|i| i.solids.len());
+    assert_eq!(again.ok(), Some(1), "the same kernel imports after a time-out");
+    // A bound reached while the parser runs ends it by name: a large valid
+    // exchange structure, cancelled a moment after the import starts.
+    let mut big = String::from("ISO-10303-21;\nHEADER;\nENDSEC;\nDATA;\n");
+    for i in 1..=600_000u32 {
+        big.push_str(&format!("#{i} = CARTESIAN_POINT('', (0.0, 0.0, 0.0));\n"));
+    }
+    big.push_str("ENDSEC;\nEND-ISO-10303-21;\n");
+    let r = bounded_cancel("cancelled mid-parse", Duration::from_millis(1), move |stop| {
+        let mut k = SolidcoreKernel::default();
+        import_step(&mut k, big.as_bytes(), stop).map(|_| ())
+    });
+    match r {
+        Err(KernelError::TimedOut { .. }) => {}
+        // A machine fast enough to parse it all inside the bound still
+        // refuses the file by name: it holds no solid.
+        Err(KernelError::InvalidResult { detail, .. }) => {
+            assert_eq!(detail, "the file holds no solid");
+        }
+        other => panic!("cancelled mid-parse: {other:?}"),
+    }
+}
diff --git a/crates/kernel/tests/step_util/mod.rs b/crates/kernel/tests/step_util/mod.rs
new file mode 100644
index 000000000..2da243e73
--- /dev/null
+++ b/crates/kernel/tests/step_util/mod.rs
@@ -0,0 +1,285 @@
+//! Shared helpers of the STEP bench (step_agreement.rs, step_corrupt.rs):
+//! the truck-stepio reading of a file as crates/app does it today, the
+//! solidcore mesher over the same file, mesh measures, and a time bound
+//! that cancels the import it bounds.
+//! Provenance: our own bench design (M12.1 retirement gate). The truck
+//! calls are the ones crates/app/src/geometry/import/step.rs makes
+//! (ruststep parse, `Table::from_data_section`, `to_compressed_shell`,
+//! `robust_triangulation`), at the same chord target; mesh volume is the
+//! divergence theorem, mesh area the sum of triangle areas.
+
+#![allow(dead_code)] // each bench binary uses its own part
+
+use std::collections::HashMap;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::mpsc;
+use std::time::Duration;
+
+use camcraft_kernel::{P3, mesh_signed_volume};
+use solidcore::kernel::CancelToken;
+use truck_meshalgo::prelude::*;
+use truck_stepio::r#in::Table;
+
+/// No single file may take longer than this (release). At the bound the
+/// import's token is cancelled; a case that still does not answer in
+/// [`GRACE`] fails as a hang.
+pub const CASE_TIMEOUT: Duration = Duration::from_secs(60);
+/// How long a cancelled case gets to come back with its named error.
+pub const GRACE: Duration = Duration::from_secs(30);
+
+/// The coarsest chord a STEP mesh is made at, in millimetres: the app's
+/// `MAX_CHORD` (half the sim's verdict tolerance, #689).
+pub const CHORD_MM: f64 = 0.005;
+/// truck's least meshing tolerance in the file's unit (the app's `MIN_TOL`).
+pub const TRUCK_MIN_TOL: f64 = 1e-5;
+
+/// Runs `f` on its own thread with a token it must poll. At `limit` the
+/// token is cancelled; the test fails if `f` still has not answered after
+/// [`GRACE`] (a hang is a finding, never a silent wait).
+pub fn bounded_cancel<T: Send + 'static>(
+    name: &str,
+    limit: Duration,
+    f: impl FnOnce(&CancelToken) -> T + Send + 'static,
+) -> T {
+    let token = CancelToken::new();
+    let inner = token.clone();
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let _ = tx.send(f(&inner));
+    });
+    if let Ok(v) = rx.recv_timeout(limit) {
+        return v;
+    }
+    token.cancel();
+    match rx.recv_timeout(GRACE) {
+        Ok(v) => v,
+        Err(e) => panic!("{name}: no answer {GRACE:?} after its cancel ({e}) - a hang or a panic"),
+    }
+}
+
+/// A triangle mesh's numbers, in millimetres.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct MeshMeasure {
+    pub volume: f64,
+    pub area: f64,
+    pub min: P3,
+    pub max: P3,
+    pub triangles: usize,
+    /// Triangle sides used by exactly one triangle once vertices at the
+    /// same position are taken as one: 0 for a watertight mesh.
+    pub open_edges: usize,
+}
+
+/// Measures a triangle soup after scaling it by `k`. `None` for a mesh
+/// with an index out of range or a coordinate that is not finite.
+pub fn mesh_measure(positions: &[P3], tris: &[[usize; 3]], k: f64) -> Option<MeshMeasure> {
+    let pos: Vec<P3> = positions.iter().map(|p| [p[0] * k, p[1] * k, p[2] * k]).collect();
+    let volume = mesh_signed_volume(&pos, tris)?;
+    let mut area = 0.0_f64;
+    let (mut min, mut max) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+    // Vertices welded by exact position: the id of the first one seen there.
+    let mut weld: HashMap<[u64; 3], usize> = HashMap::new();
+    let mut sides: HashMap<(usize, usize), usize> = HashMap::new();
+    for t in tris {
+        // `as_slice`: truck's prelude brings a `get` of its own onto `Vec`.
+        let at = |i: usize| pos.as_slice().get(i).copied();
+        let (a, b, c): (P3, P3, P3) = (at(t[0])?, at(t[1])?, at(t[2])?);
+        let (u, v) = (sub(b, a), sub(c, a));
+        let n = [
+            u[1] * v[2] - u[2] * v[1],
+            u[2] * v[0] - u[0] * v[2],
+            u[0] * v[1] - u[1] * v[0],
+        ];
+        area += 0.5 * (n[0] * n[0] + n[1] * n[1] + n[2] * n[2]).sqrt();
+        let mut ids = [0usize; 3];
+        for (slot, p) in ids.iter_mut().zip([a, b, c]) {
+            for i in 0..3 {
+                min[i] = min[i].min(p[i]);
+                max[i] = max[i].max(p[i]);
+            }
+            // +0.0 and -0.0 are one position.
+            let key = [0, 1, 2].map(|i| (p[i] + 0.0).to_bits());
+            let next = weld.len();
+            *slot = *weld.entry(key).or_insert(next);
+        }
+        for (i, j) in [(0, 1), (1, 2), (2, 0)] {
+            let side = (ids[i].min(ids[j]), ids[i].max(ids[j]));
+            if side.0 != side.1 {
+                *sides.entry(side).or_default() += 1;
+            }
+        }
+    }
+    let open_edges = sides.values().filter(|n| **n == 1).count();
+    (area.is_finite() && min.iter().chain(&max).all(|c| c.is_finite())).then_some(MeshMeasure {
+        volume,
+        area,
+        min,
+        max,
+        triangles: tris.len(),
+        open_edges,
+    })
+}
+
+fn sub(a: P3, b: P3) -> P3 {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+/// What truck-stepio makes of a file, as the app's importer reads it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct TruckStep {
+    /// Shells in the file's table (the app meshes each one).
+    pub shells: usize,
+    /// All shells' meshes together, scaled to millimetres. The volume is
+    /// the sum of each shell's absolute mesh volume.
+    pub mesh: MeshMeasure,
+    /// The chord the meshes were made at, in millimetres.
+    pub chord_mm: f64,
+}
+
+/// Reads `bytes` with ruststep + truck-stepio and meshes every shell at
+/// the app's chord target. `mm_per_unit` is the file's length unit (the
+/// bench table states it; truck meshes in the file's unit). Every refusal
+/// and every truck panic is an `Err` with its reason.
+pub fn truck_read(bytes: &[u8], mm_per_unit: f64) -> Result<TruckStep, String> {
+    let text = std::str::from_utf8(bytes).map_err(|_| "not valid UTF-8".to_string())?;
+    let read = catch_unwind(AssertUnwindSafe(|| truck_read_text(text, mm_per_unit)));
+    read.unwrap_or_else(|_| Err("truck panicked on this file".into()))
+}
+
+fn truck_read_text(text: &str, k: f64) -> Result<TruckStep, String> {
+    let exchange = ruststep::parser::parse(text).map_err(|e| format!("syntax error: {e}"))?;
+    let section = exchange.data.first().ok_or("no DATA section")?;
+    let table = Table::from_data_section(section);
+    if table.shell.is_empty() {
+        return Err("no shells found".into());
+    }
+    let mut ids: Vec<&u64> = table.shell.keys().collect();
+    ids.sort_unstable();
+    let (mut volume, mut area, mut triangles, mut open_edges) = (0.0_f64, 0.0_f64, 0usize, 0usize);
+    let (mut min, mut max) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+    let mut chord_mm = 0.0_f64;
+    for id in ids {
+        let Some(shell) = table.shell.get(id) else {
+            continue;
+        };
+        let cshell = table
+            .to_compressed_shell(shell)
+            .map_err(|e| format!("shell conversion failed: {e}"))?;
+        let extent = cshell
+            .vertices
+            .iter()
+            .flat_map(|p| [p.x.abs(), p.y.abs(), p.z.abs()])
+            .fold(0.0_f64, f64::max);
+        if !extent.is_finite() {
+            return Err("shell vertices are not finite".into());
+        }
+        // The app's target: 0.1% of the extent, never coarser than the mm
+        // cap, never under truck's floor (all in the file's unit).
+        let tol = (extent * 1e-3).min(CHORD_MM / k).max(TRUCK_MIN_TOL);
+        chord_mm = chord_mm.max(tol * k);
+        let meshed = cshell.robust_triangulation(tol).to_polygon();
+        let positions: Vec<P3> = meshed.positions().iter().map(|p| [p.x, p.y, p.z]).collect();
+        let mut tris: Vec<[usize; 3]> = Vec::new();
+        for face in meshed.face_iter() {
+            let Some(a) = face.first() else { continue };
+            for w in face.get(1..).unwrap_or_default().windows(2) {
+                if let [b, c] = w {
+                    tris.push([a.pos, b.pos, c.pos]);
+                }
+            }
+        }
+        let m = mesh_measure(&positions, &tris, k).ok_or("a shell's mesh is not finite")?;
+        volume += m.volume.abs();
+        area += m.area;
+        triangles += m.triangles;
+        open_edges += m.open_edges;
+        for i in 0..3 {
+            min[i] = min[i].min(m.min[i]);
+            max[i] = max[i].max(m.max[i]);
+        }
+    }
+    Ok(TruckStep {
+        shells: table.shell.len(),
+        mesh: MeshMeasure {
+            volume,
+            area,
+            min,
+            max,
+            triangles,
+            open_edges,
+        },
+        chord_mm,
+    })
+}
+
+/// What solidcore's mesher makes of a file's solids.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SolidcoreMesh {
+    /// All solids' meshes together (mm); volume summed per solid.
+    pub mesh: MeshMeasure,
+    /// Faces the planner or the evaluator left out, with why.
+    pub refused_faces: Vec<String>,
+    /// Faces and edges the planner says left the chord tolerance.
+    pub over_tolerance: usize,
+}
+
+/// Meshes every solid record of `bytes` with solidcore-tess at
+/// [`CHORD_MM`] (the record is already in millimetres).
+pub fn solidcore_mesh(bytes: &[u8]) -> Result<SolidcoreMesh, String> {
+    let text = std::str::from_utf8(bytes).map_err(|_| "not valid UTF-8".to_string())?;
+    let run = catch_unwind(AssertUnwindSafe(|| solidcore_mesh_text(text)));
+    run.unwrap_or_else(|_| Err("solidcore-tess panicked on this file".into()))
+}
+
+fn solidcore_mesh_text(text: &str) -> Result<SolidcoreMesh, String> {
+    let ex = solidcore_step::p21::parse(text).map_err(|e| e.to_string())?;
+    let read = solidcore_step::topology::read_solids(&ex);
+    if let Some(f) = read.failures.first() {
+        return Err(format!("solid #{} not read: {}", f.item, f.message));
+    }
+    let mut out = SolidcoreMesh {
+        mesh: MeshMeasure {
+            volume: 0.0,
+            area: 0.0,
+            min: [f64::INFINITY; 3],
+            max: [f64::NEG_INFINITY; 3],
+            triangles: 0,
+            open_edges: 0,
+        },
+        refused_faces: Vec::new(),
+        over_tolerance: 0,
+    };
+    for s in &read.solids {
+        let (mut lo, mut hi) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+        for v in &s.brep.vertices {
+            for (i, c) in v.point.into_iter().enumerate() {
+                lo[i] = lo[i].min(c);
+                hi[i] = hi[i].max(c);
+            }
+        }
+        let size = (0..3).map(|i| (hi[i] - lo[i]).powi(2)).sum::<f64>().sqrt();
+        let tol = solidcore_tess::MeshTolerance::chord(CHORD_MM);
+        let (plan, stats) = solidcore_tess::plan(&s.brep, &tol, size).map_err(|e| e.to_string())?;
+        let (mesh, refused) = plan.evaluate();
+        for r in stats.unmeshed.iter().chain(&stats.lenient).chain(&refused) {
+            out.refused_faces.push(format!("face {}: {}", r.face, r.reason));
+        }
+        out.over_tolerance += stats.over_tolerance.len() + stats.edges_capped.len();
+        let positions: Vec<P3> = mesh.positions.iter().map(|p| [p.x, p.y, p.z]).collect();
+        let tris: Vec<[usize; 3]> = mesh
+            .triangles
+            .iter()
+            .map(|t| [t[0] as usize, t[1] as usize, t[2] as usize])
+            .collect();
+        let m = mesh_measure(&positions, &tris, 1.0).ok_or("a solid's mesh is not finite")?;
+        out.mesh.volume += m.volume.abs();
+        out.mesh.area += m.area;
+        out.mesh.triangles += m.triangles;
+        out.mesh.open_edges += m.open_edges;
+        for i in 0..3 {
+            out.mesh.min[i] = out.mesh.min[i].min(m.min[i]);
+            out.mesh.max[i] = out.mesh.max[i].max(m.max[i]);
+        }
+    }
+    Ok(out)
+}
diff --git a/docs/decisions/916-solidcore-step-bench.md b/docs/decisions/916-solidcore-step-bench.md
new file mode 100644
index 000000000..07a53617a
--- /dev/null
+++ b/docs/decisions/916-solidcore-step-bench.md
@@ -0,0 +1,159 @@
+## #916 - M12.1 stage 4: STEP import through solidcore-step behind the kernel seam, benched against truck
+
+Bench only: `crates/app` still imports STEP through truck-stepio; truck and
+ruststep stay. Everything is inside `crates/kernel`; no other workspace
+crate gained a dependency.
+
+**1. The pin.** `crates/kernel` takes `solidcore`, `solidcore-step` and
+`solidcore-convert` from `https://github.com/NeoTech/solidcore` at
+`rev = "55d0e7638b9e1ebbf91ab8c10657e595c114ecda"` (the fork's tag
+`camcraft-pin-2026-11-11`, upstream main of 2026-11-11 19:30 UTC), as the
+maintainer decided on the issue. `solidcore-ops` and `solidcore-record` come
+with them (path dependencies of `solidcore-step`); `solidcore-tess` at the
+same rev is a dev-dependency for the mesh bench. `Cargo.lock`: five git
+packages in place of the one crates.io `solidcore` (552 -> 556 packages),
+no new crates.io package (`serde`, `serde_json`, `spade`, `rayon` were
+already locked). The starting pin was kept: every kernel suite is green on
+it, so no nearer commit was needed.
+
+Moving the pin (the maintainer's procedure): `gh repo sync
+NeoTech/solidcore`, pick the commit, tag it `camcraft-pin-<date>` in the
+fork, change every `rev` in `crates/kernel/Cargo.toml` together, run the
+kernel suites and re-triage whatever pinned verdict moved.
+
+**2. What the pin changed against 1.0.1.** The package still says
+`version = "1.0.1"`, but the commit is 2973 commits past the
+`solidcore-v1.0.1` tag (628 files of `crates/solidcore/src` changed). The
+seam's library code compiled unchanged. Three differences reached the
+suites, each decided:
+
+- `Brep` is no longer `Clone`. Two test helpers cloned one; they now copy
+  with the kernel's `brep_copy` (corrupt_input.rs) or measure in place
+  (import_corpus.rs). No library change.
+- A NaN offset distance is now refused by the port (`Err`); 1.0.1 returned
+  an unchanged copy. The pinned port verdict is re-triaged to `Err`. The
+  seam's own guard already refused it first, so no behaviour changed.
+- The native reader now refuses a blank file, plain text, binary noise and
+  a header with no body itself (`Err failed`); 1.0.1 returned `Ok` with an
+  empty B-rep and only the seam's heal guard refused them. Four rows of the
+  pinned table moved in both columns; all four were findings against the
+  port in decision 27 and are closed by the pin.
+
+All 21 default-lane tests and the 2 heavy-lane tests of stages 1-3 pass on
+the pin with those edits.
+
+**3. The importer (`camcraft_kernel::solidcore_step`).** `read_step` gives
+the whole picture of a file (solids, refused items with stage and reason,
+length units, notes); `import_step` hands out a model only when EVERY solid
+item came through. Dropped: importing the solids that read and noting the
+rest - a part with a body missing is a toolpath through that body.
+
+- Size bound: 64 MiB (`MAX_STEP_BYTES`, the native reader's bound; the
+  reader's own cap is 512 MiB). The reader caps entity, record, parameter,
+  face, loop and solid counts itself.
+- Time bound: the caller's `CancelToken`. It is polled by the Part 21
+  parser, between stages and solids, and inside the kernel's loops (the
+  token is installed on the kernel for the call and removed after). The
+  result is `KernelError::TimedOut` (a new variant). Dropped: a deadline
+  from `std::time::Instant` inside the library - it panics on
+  wasm32-unknown-unknown, and the crate must build there. Known gap: the
+  reader's topology pass (`read_solids`) has no cancellation hook at the
+  pin; it runs to its end, bounded by the caps (#939).
+- A panic in the reader or the kernel is caught and becomes
+  `KernelError::Failed`; after a panic or a time-out the kernel state is
+  replaced by a fresh one (upstream's own rule after a cancelled call).
+- The record is built with `to_kernel_body(.., trusted = false)`: the
+  kernel heals it as it builds it. Then the seam's stage-3 laws apply
+  unchanged: integrity check, closed manifold solid, positive finite
+  volume and area, vertex-edge gap at or under `HEAL_GAP_LIMIT` (1e-3 mm),
+  no edge without a 3D curve. A sheet (open shells) is refused by name.
+- Units: every solid is in millimetres. The file's stated length units are
+  returned (`[25.4]` for an inch file). A length unit the reader cannot
+  convert is REFUSED by the seam: the reader alone reads it as millimetres
+  without a word. A file stating two different units gets a note, not a
+  refusal: the reader reads each solid in its own context's unit
+  (crates/app refuses such a file today; that difference is for stage 5).
+
+**4. Findings against the port at the pin (pinned, not papered over).**
+
+- `to_kernel_body` hands out a B-rep whose cached `Face::shell` is behind
+  its face-use links, on every fixture; the port's integrity check refuses
+  it. The seam calls `Brep::refresh_cached_topology()` (public; changes the
+  cached fields only) after the build. To report upstream (#939).
+- The port's "tight" bounding box is wrong for a trimmed cylinder face:
+  Milling-test.step is a 60 mm disc with a flat at Y = 19.719 and the box
+  says Y max = 30.0. Volume and area are right. See the table. Nothing may
+  size stock or place a part from `StepSolid::measure`'s box until this is
+  understood (#939).
+- Two solid items on one shell import as two coincident solids. That is
+  what the file states; the importer does not look for coincidence.
+
+**5. The bench (tests/step_agreement.rs).** Every `.step` under
+`testdata/models`, both importers, verdicts pinned; a fixture with no row
+fails. Tolerances: relative volume and area 1e-3 (truck's numbers are a
+mesh's at the app's chord, 0.005 mm, 0.01 mm for the metre file where
+truck's floor binds); box corners two chords. It runs in about a second in
+release, so it stays in the default lane; no heavy lane was needed.
+
+| File | Unit (mm) | Importers | solidcore exact V / A (mm) | truck mesh dV, dA | solidcore mesh dV, dA |
+|---|---|---|---|---|---|
+| box.step | 1 | agree | 1 / 6 | 0, 0 | 0, 0 |
+| empty_list.step (#887) | 1 | agree | 1 / 6 | 0, 0 | 0, 0 |
+| tool_csys_box_iso13399.step | 1 | agree | 16000 / 4000 | 0, 0 | 0, 0 |
+| sample_ap214.step (3 solids) | 1000 | agree | 17152.096 / 13877.096 | -1.5e-4, -1.9e-4 | -3.1e-5, -4.5e-5 |
+| Milling-test.step | 1 | DISAGREE: bounding box | 52808.744 / 11143.378 | -1.2e-4, -1.2e-4 | -5.6e-5, -7.5e-5 |
+| Milling-test-inch.step | 25.4 | DISAGREE: bounding box | 52808.744 / 11143.378 | -1.2e-4, -1.2e-4 | -5.6e-5, -7.5e-5 |
+| tool_csys_none / _iso13399 / _degenerate | 1 | both refuse (no solid) | - | - | - |
+
+The disagreement: solidcore's box of Milling-test is
+[-30, -30, -5]..[30, 30, 20]; truck's mesh and solidcore's own mesh both
+stop at Y = 19.719, as the file's vertices do. solidcore is the wrong side.
+
+**5a. The corrupt corpus (tests/step_import.rs).** 19 files made from
+box.step: blank, foreign text, noise, header only, no entities, three
+truncations, a parameter list nested 100000 deep, a dangling face, a solid
+that names itself, a plane placed by itself, a face dropped, a vertex moved
+0.5 mm, a vertex at 1e300, a one-coordinate point, an unconvertible length
+unit, a solid stated twice. Each runs under a 60 s bound that cancels the
+import. No panic, no hang. solidcore refuses 17 by name and imports 2 (the
+one-coordinate point is the origin, which ISO 10303-42 allows; the solid
+stated twice is two solids). truck-stepio, read the way the bench reads it
+(no app-level checks after the mesh), refuses the 10 that break the Part 21
+syntax and answers `Ok` for the other 9 - five of them with an open mesh (a
+dropped, dangling or unreadable face; a moved or far-away vertex). That
+column is a finding about the path the app uses today, recorded, not
+chased here.
+
+**6. Tessellation (issue point 4).** solidcore now has a mesher,
+`solidcore-tess` (the workspace's "one mesher"; `plan(record, tolerance,
+size)` then `TessPlan::evaluate()`), which meshes the STEP reader's B-rep
+record directly at a chord tolerance in millimetres. Benched at the app's
+0.005 mm cap on the same files:
+
+- watertight on every fixture when vertices are welded by exact position
+  (0 open triangle sides; edges are sampled once and shared). truck's
+  per-face meshes are not: 854 open sides on Milling-test, 3196 on
+  sample_ap214 by the same count;
+- closer to the exact volume and area than truck's (table), with more
+  triangles (6228 against 952 on Milling-test, 11894 against 3178 on
+  sample_ap214);
+- no face left out, none reported over tolerance, no lenient fill;
+- its bounding box matches truck's mesh within two chords on every file.
+
+Two cautions for stage 5. Its own docs call it a DISPLAY mesher ("a
+display mesh decides nothing a model depends on: it is drawn, never
+measured"), and it reports faces it could not mesh in `PlanStats` instead
+of failing - a machining import must turn any `unmeshed`, `lenient`,
+`over_tolerance` or `edges_capped` entry into a refusal. And the bench
+measures volume, area, box and watertightness, not the largest distance
+from mesh to surface; that deviation measure is still owed (#940). The caps of
+#689 / #864 map onto `MeshTolerance::chord(mm)` directly: the record is
+already in millimetres, so no per-unit conversion of the cap is needed.
+
+**7. wasm32 (issue point 5).** `cargo check -p camcraft-kernel --target
+wasm32-unknown-unknown` passes with the STEP importer in the library. The
+importer uses no clock and no thread. Not run: a wasm32 test execution.
+
+**Cost to change later.** The pin is three `rev` strings (four with the
+dev-dependency). The importer's laws are one function (`build`); the
+bench's tolerances are two constants.

