diff --git a/docs/decisions/1201-gate-checkout-guard.md b/docs/decisions/1201-gate-checkout-guard.md
new file mode 100644
index 000000000..88517a564
--- /dev/null
+++ b/docs/decisions/1201-gate-checkout-guard.md
@@ -0,0 +1,31 @@
+## #1201 - the gate detects a moved checkout (VOID) instead of guarding it
+
+**What was decided.** `cargo xtask gate` (every tier, and the release gate run in process) reads HEAD and
+`git --no-optional-locks status --porcelain` when it starts, again before each step, and at the end. If either
+reading changed, it prints a `VOID:` line naming what moved (the two commits, or the status entries that differ),
+stops, and exits non-zero with no verdict. The comparison is a pure function (`xtask/src/checkout.rs`), unit-tested
+on fake readings. AGENTS.md and the `work-issue` skill say a worktree agent never switches, pulls, merges, resets,
+checks out or stashes in the main checkout; its only git there is `fetch` and `worktree add`.
+
+**Detection only, no guard.** The gate takes no lock and installs no hook. The issue offered a
+`.git/index.lock` or a `reference-transaction` hook as the guard; the comment on the issue showed the hook leaves
+the checkout half-moved. A lock the gate holds is only safe if released on every exit path (a Ctrl-C leaves a
+stale `index.lock`, which blocks all git work in that checkout until someone deletes it by hand). That is not
+robust at effort:medium, so the gate only reports.
+
+**Why.** Both spoiled gates ran to completion and printed a verdict over a mix of commits. Detection turns that into
+a loud, non-green run. It does not stop the pull; the rule that workers do not pull into the main checkout does that.
+
+**Considered and dropped.**
+- `reference-transaction` hook: git rewrites index and tree before the ref update, so it refuses after the files
+  have moved (the issue's third spoiled gate).
+- `.git/index.lock` held by the gate: correct while held, but a leaked lock blocks git. Left for a later issue if
+  detection proves too weak.
+- A long-lived detached gate worktree nobody pulls into: removes the race entirely, at the cost of one more
+  `target/` (10-20 GB). Named on the issue; a separate decision.
+
+**Cost to change later.** Low: the guard is one module plus the `check` calls in `Run::plan`. A lock could be added
+behind the same `check` points.
+
+**Known limit.** A step that writes a tracked or untracked file in the checkout (a snapshot writer, a generated
+file not in `.gitignore`) also changes the status and voids its own run. That is intended: the run then names the file.
diff --git a/xtask/src/checkout.rs b/xtask/src/checkout.rs
new file mode 100644
index 000000000..ed99f2656
--- /dev/null
+++ b/xtask/src/checkout.rs
@@ -0,0 +1,69 @@
+//! The gate's checkout guard (#1201): HEAD and the working tree are read when a gate starts and again before
+//! each step and at its end; a run that straddles a pull, switch or reset is VOID, never a verdict. Detection
+//! only - the gate takes no lock, so no stale `index.lock` can block git work in the checkout.
+//! Provenance: our own build law (AGENTS.md "Three gate tiers", "Start from the latest main"), #1201.
+
+use std::collections::BTreeSet;
+use std::path::Path;
+
+use crate::exec;
+
+/// HEAD's commit and the porcelain status of the checkout at one moment.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Reading {
+    pub head: String,
+    pub status: String,
+}
+
+/// Reads HEAD and `git status --porcelain`. `--no-optional-locks` keeps the read from refreshing the index,
+/// so it never writes into the checkout while another git command holds it.
+pub fn read(root: &Path) -> Result<Reading, String> {
+    let head = exec::git(root, &["rev-parse", "HEAD"])?.trim().to_string();
+    let status = exec::git(root, &["--no-optional-locks", "status", "--porcelain"])?;
+    Ok(Reading { head, status })
+}
+
+/// `None` when the checkout still reads the same; otherwise the VOID line that names what moved and where
+/// the change was seen (`at`, e.g. "before step 3" or "at the end").
+pub fn void_message(start: &Reading, now: &Reading, at: &str) -> Option<String> {
+    if start == now {
+        return None;
+    }
+    let head_moved = start.head != now.head;
+    let tree = tree_change(&start.status, &now.status);
+    let what = match (head_moved, tree) {
+        (true, Some(t)) => format!(
+            "the checkout moved from {} to {} and its working tree changed ({t})",
+            short(&start.head),
+            short(&now.head)
+        ),
+        (true, None) => format!("the checkout moved from {} to {}", short(&start.head), short(&now.head)),
+        (false, Some(t)) => format!("the working tree of {} changed ({t})", short(&now.head)),
+        // Equal HEAD and equal status text cannot differ; reached only if git output changed shape.
+        (false, None) => format!("the checkout at {} reads differently", short(&now.head)),
+    };
+    Some(format!("VOID: {what} during the gate ({at}) - this run is void, not a verdict on any commit"))
+}
+
+/// The entries of the porcelain status that differ between two readings, up to five named, or `None`.
+fn tree_change(before: &str, after: &str) -> Option<String> {
+    if before == after {
+        return None;
+    }
+    let b: BTreeSet<&str> = before.lines().collect();
+    let a: BTreeSet<&str> = after.lines().collect();
+    let diff: Vec<&str> = b.symmetric_difference(&a).copied().collect();
+    if diff.is_empty() {
+        return Some("status lines reordered".into());
+    }
+    let shown: Vec<&str> = diff.iter().take(5).copied().collect();
+    let more = diff.len().saturating_sub(shown.len());
+    let tail = if more > 0 { format!(" and {more} more") } else { String::new() };
+    let one = diff.len() == 1;
+    let (noun, verb) = if one { ("entry", "differs") } else { ("entries", "differ") };
+    Some(format!("{} {noun} {verb}: {}{tail}", diff.len(), shown.join("; ")))
+}
+
+fn short(sha: &str) -> String {
+    sha.chars().take(8).collect()
+}
diff --git a/xtask/src/checkout_tests.rs b/xtask/src/checkout_tests.rs
new file mode 100644
index 000000000..0c81d8735
--- /dev/null
+++ b/xtask/src/checkout_tests.rs
@@ -0,0 +1,58 @@
+//! Pins the gate's checkout guard (#1201): the comparison of two readings of HEAD and the working tree.
+//! Works on fake readings - no git is needed, so the detection logic is tested as a pure function.
+//! Provenance: our own build law (AGENTS.md "Three gate tiers"), #1201.
+
+use crate::checkout::{Reading, void_message};
+
+fn reading(head: &str, status: &str) -> Reading {
+    Reading { head: head.into(), status: status.into() }
+}
+
+const A: &str = "d7e9a807aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+const B: &str = "2b9d33e3bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+
+#[test]
+fn unchanged_checkout_has_no_void_message() {
+    let r = reading(A, " M xtask/src/exec.rs\n");
+    assert_eq!(void_message(&r, &r.clone(), "at the end"), None);
+}
+
+#[test]
+fn head_moved_with_clean_tree_names_both_commits() {
+    let msg = void_message(&reading(A, ""), &reading(B, ""), "before step 2").expect("void");
+    assert!(msg.starts_with("VOID: the checkout moved from d7e9a807 to 2b9d33e3"), "{msg}");
+    assert!(msg.contains("before step 2"), "{msg}");
+    assert!(msg.ends_with("not a verdict on any commit"), "{msg}");
+}
+
+#[test]
+fn half_moved_checkout_is_caught_with_head_unchanged() {
+    // The #1201 case: HEAD still at A, the index and tree already rewritten to B's files.
+    let start = reading(A, "");
+    let now = reading(A, "M  crates/ui/src/a.rs\nM  crates/ui/src/b.rs\n");
+    let msg = void_message(&start, &now, "at the end").expect("void");
+    assert!(msg.starts_with("VOID: the working tree of d7e9a807 changed (2 entries differ"), "{msg}");
+    assert!(msg.contains("M  crates/ui/src/a.rs"), "{msg}");
+}
+
+#[test]
+fn head_and_tree_both_moved_say_so() {
+    let start = reading(A, "");
+    let now = reading(B, " M x.rs\n");
+    let msg = void_message(&start, &now, "at the end").expect("void");
+    assert!(msg.contains("moved from d7e9a807 to 2b9d33e3 and its working tree changed (1 entry differs:  M x.rs)"), "{msg}");
+}
+
+#[test]
+fn long_diffs_are_capped_at_five_named_entries() {
+    let now = reading(A, "?? a\n?? b\n?? c\n?? d\n?? e\n?? f\n?? g\n");
+    let msg = void_message(&reading(A, ""), &now, "at the end").expect("void");
+    assert!(msg.contains("7 entries differ"), "{msg}");
+    assert!(msg.contains("and 2 more"), "{msg}");
+}
+
+#[test]
+fn short_sha_is_safe_on_short_input() {
+    let msg = void_message(&reading("ab", ""), &reading("cd", ""), "at the end").expect("void");
+    assert!(msg.contains("from ab to cd"), "{msg}");
+}
