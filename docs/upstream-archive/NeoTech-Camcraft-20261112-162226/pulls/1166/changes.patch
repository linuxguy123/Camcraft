+            gap: num_at("gap", true)?,
+            wire_diameter: num_at("wire_diameter", false)?,
+            undersize: num_at("undersize", true)?,
+            role: word("role")?,
+            notes: word("notes")?,
+            id,
+        };
+        if !(cond.role.is_empty() || CONDITION_ROLES.contains(&cond.role.as_str())) {
+            return Err(format!(
