@@ -0,0 +1,245 @@
+//! The documents of the carried-stock suites, built once for the engine
+//! agreement lane (#637): `setup_carry`'s faced block (flip, quarter
+//! turn, "Same as", clip, new block, a flip off the grid pitch),
+//! `rest_across_setups`'s plate with a pocket, `carried_verify`'s contour
+//! beside a part. Mirrors of those suites' own fixtures - a change there
+//! is mirrored here.
+//! Provenance: our own fixtures; no vendor material consulted.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    AddTool, AlignPartToSetup, CreateOperation, CreateSetup, GenerateOperation, History, ImportModel, SetSetupRelative,
+    SetSetupStockSource, SetStock,
+};
+use camcraft_app::geometry::{cube, Mesh, Point3, Triangle};
+use camcraft_app::machining2d::{Lead, PocketStrategy, Side};
+use camcraft_app::machining3d::Entry3D;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::setup_align::AlignPreset;
+use camcraft_app::setup_stock::StockSource;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+
+/// How Setup2 is entered from Setup1.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Second {
+    /// Same hold, not linked: the M3.2 A clip.
+    Clip,
+    /// Placed "Same as" Setup1: the identity carry.
+    SameAs,
+    /// The part flipped over X: carried upside down.
+    FlipX,
+    /// The part turned 90 degrees about Z.
+    TurnZ90,
+    /// Flipped onto its own new block (#320).
+    FlipOwn,
+}
+
+/// One document of the lane.
+pub struct Doc {
+    pub name: String,
+    pub world: World,
+    /// Kept alive with the world (the commands own undo state).
+    pub _history: History,
+    /// The consumer in Setup2 whose rest and verify reads are compared:
+    /// its name and its tool radius.
+    pub consumer: Option<(&'static str, f64)>,
+}
+
+fn tool(world: &World, h: &mut History, name: &str) {
+    let t = catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog tool");
+    h.execute(world, AddTool::new(world, name, t).expect("add tool"));
+}
+
+fn add(world: &World, h: &mut History, name: &str, tool: &str, src: SrcRef, params: OpParams) {
+    h.execute(world, CreateOperation::new(world, name, tool, src, params).expect("create"));
+    h.execute(world, GenerateOperation::new(world, name).expect("generate"));
+}
+
+fn second_setup(world: &World, h: &mut History, second: Second) {
+    h.execute(world, CreateSetup::new(world, None, Some("Setup1")).expect("Setup2"));
+    match second {
+        Second::Clip => {}
+        Second::SameAs => h.execute(world, SetSetupRelative::link(world, "Setup2", "Setup1", [0.0; 3]).expect("same as")),
+        Second::FlipX | Second::FlipOwn => {
+            h.execute(world, AlignPartToSetup::preset(world, "Setup2", AlignPreset::FlipX).expect("flip"));
+        }
+        Second::TurnZ90 => h.execute(world, AlignPartToSetup::preset(world, "Setup2", AlignPreset::TurnZ90).expect("turn")),
+    }
+}
+
+fn face(cut_z: f64, stepover: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover,
+        clearance_z: Height::fixed(30.0),
+        cut_z: Height::fixed(cut_z),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+const FACE_TOOL: &str = "EM-0400-2FL";
+
+/// `setup_carry`: a part centred at `c`, `2*hx` x `2*hy` x [0, 16], in a
+/// `dx` x `dy` block Z -2..18; Face1 to `cut1` in Setup1, Setup2 entered
+/// as `second`, Face2 to 16.
+pub fn faced(name: &str, c: (f64, f64), (hx, hy): (f64, f64), (dx, dy): (f64, f64), cut1: f64, second: Second) -> Doc {
+    let world = new_world();
+    let mut h = History::default();
+    let part = cube(Point3::new(c.0 - hx, c.1 - hy, 0.0), Point3::new(c.0 + hx, c.1 + hy, 16.0));
+    h.execute(&world, ImportModel::from_mesh("part", part));
+    let at = Location { pos: Point3::new(0.0, 0.0, -2.0), ..Default::default() };
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx, dy, dz: 20.0 }, at).expect("stock"));
+    tool(&world, &mut h, FACE_TOOL);
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("materialize Setup1"));
+    add(&world, &mut h, "Face1", FACE_TOOL, SrcRef::Stock, face(cut1, 3.0));
+    second_setup(&world, &mut h, second);
+    add(&world, &mut h, "Face2", FACE_TOOL, SrcRef::Stock, face(16.0, 3.0));
+    if second == Second::FlipOwn {
+        h.execute(&world, SetSetupStockSource::new(&world, "Setup2", StockSource::Own).expect("own block"));
+        h.execute(&world, GenerateOperation::new(&world, "Face2").expect("Face2 on its own block"));
+    }
+    Doc { name: name.to_owned(), world, _history: h, consumer: Some(("Face2", 2.0)) }
+}
+
+/// A 40x40x20 plate with a 20x20 pocket sunk to z=10.
+fn plate_with_pocket() -> Mesh {
+    let mut facets = Vec::new();
+    let outer = cube(Point3::new(-20.0, -20.0, 0.0), Point3::new(20.0, 20.0, 20.0));
+    facets.extend(outer.facets[0..2].iter().cloned());
+    facets.extend(outer.facets[4..12].iter().cloned());
+    let inner = cube(Point3::new(-10.0, -10.0, 10.0), Point3::new(10.0, 10.0, 20.0));
+    facets.extend(inner.facets[0..2].iter().cloned());
+    facets.extend(inner.facets[4..12].iter().cloned());
+    let o = [(-20.0, -20.0), (20.0, -20.0), (20.0, 20.0), (-20.0, 20.0)].map(|(x, y)| Point3::new(x, y, 20.0));
+    let i = [(-10.0, -10.0), (10.0, -10.0), (10.0, 10.0), (-10.0, 10.0)].map(|(x, y)| Point3::new(x, y, 20.0));
+    for k in 0..4 {
+        let (a, b, c, d) = (o[k], o[(k + 1) % 4], i[(k + 1) % 4], i[k]);
+        facets.push(Triangle::new(a, b, c));
+        facets.push(Triangle::new(a, c, d));
+    }
+    Mesh::from_facets(facets)
+}
+
+fn pocket(bottom_z: f64, stepover: f64, rest_rough: bool) -> OpParams {
+    OpParams::Pocket3D {
+        links: camcraft_app::links::Links::ROUGH3D,
+        stepover,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(30.0),
+        retract_z: None,
+        top_z: Height::fixed(20.0),
+        bottom_z: Height::fixed(bottom_z),
+        stepdown: 5.0,
+        feed: 1500.0,
+        plunge_feed: 400.0,
+        climb: true,
+        strategy: PocketStrategy::Zigzag,
+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+        rest_rough,
+        optimal_load: camcraft_app::load::load_of_degrees(60.0),
+        feed_opt: false,
+        shell: false,
+    }
+}
+
+/// `rest_across_setups`: the plate roughed with the 8 mm tool in Setup1,
+/// the 4 mm rest pass in Setup2 entered as `second`.
+pub fn rest_plate(name: &str, second: Second) -> Doc {
+    let world = new_world();
+    let mut h = History::default();
+    for t in ["EM-0800-4FL", "EM-0400-2FL"] {
+        tool(&world, &mut h, t);
+    }
+    let stock = SetStock::new(&world, StockShape::Box { dx: 40.0, dy: 40.0, dz: 20.0 }, Location::default());
+    h.execute(&world, stock.expect("box stock"));
+    h.execute(&world, ImportModel::from_mesh("plate", plate_with_pocket()));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("materialize Setup1"));
+    let src = || SrcRef::Entity("plate".into());
+    add(&world, &mut h, "Rough1", "EM-0800-4FL", src(), pocket(12.0, 4.0, false));
+    second_setup(&world, &mut h, second);
+    add(&world, &mut h, "Rest2", "EM-0400-2FL", src(), pocket(10.0, 2.0, true));
+    Doc { name: name.to_owned(), world, _history: h, consumer: Some(("Rest2", 2.0)) }
+}
+
+fn contour() -> OpParams {
+    OpParams::Contour {
+        tilt: None,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(12.0),
+        retract_z: Height::fixed(8.0),
+        top_z: Height::fixed(5.0),
+        bottom_z: Height::fixed(0.0),
+        stepdown: 2.5,
+        feed: 800.0,
+        plunge_feed: 200.0,
+        climb: true,
+        side: Side::Auto,
+        lead: Lead::None,
+        tolerance: 0.01,
+        tab_count: 0,
+        tab_width: 0.0,
+        tab_height: 0.0,
+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+        blend_turns: false,
+        links: camcraft_app::links::Links::PLANAR,
+    }
+}
+
+const CONTOUR_TOOL: &str = "EM-0600-4FL";
+
+/// `carried_verify`: the part (0..10)^2 x [0, 5] in Setup1's `w1`-wide
+/// block Z -5..10 faced to `cut1`; Setup2 entered as `second`, declaring
+/// a `w2`-wide block Z -5..5, and Contour2 round the part.
+pub fn verify_contour(name: &str, w1: f64, cut1: f64, second: Second, w2: f64) -> Doc {
+    let world = new_world();
+    let mut h = History::default();
+    let block = |world: &World, w: f64, dz: f64| {
+        let at = Location { pos: Point3::new(5.0, 5.0, -5.0), ..Default::default() };
+        SetStock::new(world, StockShape::Box { dx: w, dy: w, dz }, at).expect("stock")
+    };
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::ZERO, Point3::new(10.0, 10.0, 5.0))));
+    h.execute(&world, block(&world, w1, 15.0));
+    tool(&world, &mut h, CONTOUR_TOOL);
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("materialize Setup1"));
+    add(&world, &mut h, "Face1", CONTOUR_TOOL, SrcRef::Stock, face(cut1, 4.0));
+    second_setup(&world, &mut h, second);
+    h.execute(&world, block(&world, w2, 10.0));
+    add(&world, &mut h, "Contour2", CONTOUR_TOOL, SrcRef::Entity("part".into()), contour());
+    Doc { name: name.to_owned(), world, _history: h, consumer: Some(("Contour2", 3.0)) }
+}
+
+/// Every document of the lane.
+pub fn documents() -> Vec<Doc> {
+    let sq = (30.0, 30.0);
+    vec![
+        // setup_carry
+        faced("carry/flip, faced clean", (0.0, 0.0), sq, (60.0, 60.0), 16.0, Second::FlipX),
+        faced("carry/flip after a 1 mm gouge", (0.0, 0.0), sq, (60.0, 60.0), 15.0, Second::FlipX),
+        faced("carry/quarter turn", (0.0, 0.0), (30.0, 20.0), (60.0, 40.0), 16.0, Second::TurnZ90),
+        faced("carry/same as", (0.0, 0.0), sq, (60.0, 60.0), 17.0, Second::SameAs),
+        faced("carry/clip in the same hold", (0.0, 0.0), sq, (60.0, 60.0), 17.0, Second::Clip),
+        faced("carry/flip onto a new block", (0.0, 0.0), sq, (60.0, 60.0), 16.0, Second::FlipOwn),
+        faced("carry/flip about a centre off the pitch", (0.37, -0.21), (20.0, 20.0), (61.0, 47.0), 16.0, Second::FlipX),
+        // rest_across_setups
+        rest_plate("rest/same as", Second::SameAs),
+        rest_plate("rest/clip", Second::Clip),
+        // carried_verify
+        verify_contour("verify/same as, material left standing", 100.0, 9.0, Second::SameAs, 100.0),
+        verify_contour("verify/same as, faced away", 100.0, 5.0, Second::SameAs, 100.0),
+        verify_contour("verify/flip", 100.0, 9.0, Second::FlipX, 100.0),
+        verify_contour("verify/declared stock beyond the carried block", 20.0, 9.0, Second::SameAs, 100.0),
+        verify_contour("verify/clip", 100.0, 9.0, Second::Clip, 100.0),
+    ]
+}
diff --git a/crates/app/tests/carried_engine_agreement.rs b/crates/app/tests/carried_engine_agreement.rs
new file mode 100644
index 000000000..b27cd05de
--- /dev/null
+++ b/crates/app/tests/carried_engine_agreement.rs
@@ -0,0 +1,284 @@
+//! #637, carried stock on both engines side by side: the documents of
+//! the carried-stock suites (`setup_carry`, `rest_across_setups`,
+//! `carried_verify`) are generated once, then every carried read is taken
+//! on the column engine AND the field engine and must agree - the program
+//! verdict column for column within `FIELD_VERDICT_EPS` with the same
+//! class, counts and aggregates; the body a setup is entered with (tops,
+//! floors, empties, volume, `floor_judged`); the rest grid generation
+//! masks with; the bounds and grids verify reads. A refusal on one
+//! engine only is a finding. Findings are located and printed whole
+//! before the suite fails; nothing is rounded away.
+//! Heavy lane: fourteen two-setup documents, each read twice, the field
+//! arm marching every column - release, about a minute.
+//! Provenance: our own fixtures, engines and agreement law
+//! (`stock_engine_agreement`'s, carried across setups).
+//!
+//! Gate map (#637): covers app::stock_sim::held (Held, the engine
+//! switch), app::stock_sim::carry (walk, incoming_body), app::rest
+//! (prior_state, prior_plan), app::rest::across (sweep, carried_stock_body,
+//! entered_body), sim::stock_sim::carried (CarriedStock on both arms).
+
+#[path = "carried_agreement/fixtures.rs"]
+mod fixtures;
+
+use fixtures::{documents, Doc};
+
+use camcraft_app::rest;
+use camcraft_app::stock_sim::{
+    incoming_body, simulate_document, with_carry_engine, Backend, Body, Deviation, Dexel, FIELD_BAND, FIELD_VERDICT_EPS,
+};
+
+const FIELD: Backend = Backend::Field { band: FIELD_BAND };
+
+/// A column's verdict word, as `deviate` draws its line.
+fn class(v: f64, tol: f64) -> &'static str {
+    if v.is_nan() {
+        "no verdict"
+    } else if v > tol {
+        "rest"
+    } else if v < -tol {
+        "gouge"
+    } else {
+        "clean"
+    }
+}
+
+/// One read on both engines; a refusal on exactly one is a finding, the
+/// same refusal on both is agreement (returned as `None`).
+fn both<T>(at: &str, out: &mut Vec<String>, read: impl Fn() -> Result<T, String>) -> Option<(T, T)> {
+    match (with_carry_engine(Backend::Column, &read), with_carry_engine(FIELD, &read)) {
+        (Ok(c), Ok(f)) => Some((c, f)),
+        (Err(c), Err(f)) => {
+            if c != f {
+                out.push(format!("{at}: refused differently - column: {c}; field: {f}"));
+            }
+            None
+        }
+        (c, f) => {
+            let say = |r: &Result<T, String>| r.as_ref().map_or_else(Clone::clone, |_| "ran".to_owned());
+            out.push(format!("{at}: the engines did not both run - column: {}; field: {}", say(&c), say(&f)));
+            None
+        }
+    }
+}
+
+fn same_lattice(at: &str, c: &Dexel, f: &Dexel, out: &mut Vec<String>) -> bool {
+    let ok = (c.nx, c.ny) == (f.nx, f.ny) && c.cell == f.cell && (c.x0 - f.x0).abs() <= 1e-9 && (c.y0 - f.y0).abs() <= 1e-9;
+    if !ok {
+        out.push(format!(
+            "{at}: lattice {}x{} @ {} from ({}, {}) vs field {}x{} @ {} from ({}, {})",
+            c.nx, c.ny, c.cell, c.x0, c.y0, f.nx, f.ny, f.cell, f.x0, f.y0
+        ));
+    }
+    ok
+}
+
+/// Two grids of tops: every column within the epsilon, air on both or
+/// neither.
+fn compare_tops(at: &str, c: &Dexel, f: &Dexel, out: &mut Vec<String>) -> f64 {
+    if !same_lattice(at, c, f, out) {
+        return f64::NAN;
+    }
+    let mut worst = 0.0f64;
+    for k in 0..c.nx * c.ny {
+        let (a, b) = (c.top_at(k), f.top_at(k));
+        if a.is_finite() != b.is_finite() || (a.is_finite() && (a - b).abs() > FIELD_VERDICT_EPS) {
+            let q = c.center(k % c.nx, k / c.nx);
+            out.push(format!("{at}: column ({:.3}, {:.3}): top {a:.6} vs field {b:.6}", q.x, q.y));
+        } else if a.is_finite() {
+            worst = worst.max((a - b).abs());
+        }
+    }
+    worst
+}
+
+/// Two carried bodies: tops and floors of every standing column, the
+/// empties, the volume and whether the floor is judged.
+fn compare_bodies(at: &str, c: &Body, f: &Body, out: &mut Vec<String>) -> f64 {
+    if !same_lattice(at, &c.dex, &f.dex, out) {
+        return f64::NAN;
+    }
+    if c.floor_judged() != f.floor_judged() {
+        out.push(format!("{at}: floor judged {} vs field {}", c.floor_judged(), f.floor_judged()));
+    }
+    let d = &c.dex;
+    let mut worst = 0.0f64;
+    for k in 0..d.nx * d.ny {
+        let q = d.center(k % d.nx, k / d.nx);
+        if c.empty_at(k) != f.empty_at(k) {
+            out.push(format!("{at}: column ({:.3}, {:.3}): empty {} vs field {}", q.x, q.y, c.empty_at(k), f.empty_at(k)));
+            continue;
+        }
+        if c.empty_at(k) {
+            continue;
+        }
+        let (dt, df) = ((d.top_at(k) - f.dex.top_at(k)).abs(), (c.floor_at(k) - f.floor_at(k)).abs());
+        if dt.is_nan() || df.is_nan() || dt > FIELD_VERDICT_EPS || df > FIELD_VERDICT_EPS {
+            out.push(format!(
+                "{at}: column ({:.3}, {:.3}): top {:.6} / floor {:.6} vs field top {:.6} / floor {:.6}",
+                q.x, q.y, d.top_at(k), c.floor_at(k), f.dex.top_at(k), f.floor_at(k)
+            ));
+        } else {
+            worst = worst.max(dt).max(df);
+        }
+    }
+    let vol_eps = FIELD_VERDICT_EPS * d.cell * d.cell * (d.nx * d.ny) as f64;
+    let dv = (c.volume() - f.volume()).abs();
+    if dv.is_nan() || dv > vol_eps {
+        out.push(format!("{at}: volume {:.6} vs field {:.6}", c.volume(), f.volume()));
+    }
+    worst
+}
+
+/// Every way two program verdicts can differ, said with its location.
+fn compare_verdicts(at: &str, c: &Deviation, f: &Deviation, out: &mut Vec<String>) -> f64 {
+    if (c.cells_x, c.cells_y) != (f.cells_x, f.cells_y) || c.cell != f.cell || c.tol != f.tol {
+        out.push(format!("{at}: verdict lattice {}x{} vs field {}x{}", c.cells_x, c.cells_y, f.cells_x, f.cells_y));
+        return f64::NAN;
+    }
+    let mut worst = 0.0f64;
+    for (k, (a, b)) in c.dev.iter().zip(&f.dev).enumerate() {
+        let d = (a - b).abs();
+        if a.is_finite() && b.is_finite() {
+            worst = worst.max(d);
+        }
+        let (ca, cb) = (class(*a, c.tol), class(*b, f.tol));
+        if a.is_nan() != b.is_nan() || (a.is_finite() && d > FIELD_VERDICT_EPS) || ca != cb {
+            let (ix, iy) = (k % c.cells_x, k / c.cells_x);
+            out.push(format!("{at}: column [{ix}, {iy}]: dev {a:.6} ({ca}) vs field {b:.6} ({cb}), |delta| {d:.3e}"));
+        }
+    }
+    let vol_eps = FIELD_VERDICT_EPS * c.cell * c.cell * c.dev.len() as f64;
+    for (name, a, b, e) in [
+        ("max_rest", c.max_rest, f.max_rest, FIELD_VERDICT_EPS),
+        ("max_gouge", c.max_gouge, f.max_gouge, FIELD_VERDICT_EPS),
+        ("rest_volume", c.rest_volume, f.rest_volume, vol_eps),
+        ("gouge_volume", c.gouge_volume, f.gouge_volume, vol_eps),
+    ] {
+        // NaN on either side is a disagreement too, never a pass.
+        if (a - b).abs().is_nan() || (a - b).abs() > e {
+            out.push(format!("{at}: {name} {a:.6} vs field {b:.6}"));
+        }
+    }
+    if (c.rest_cells, c.gouge_cells, c.is_clean()) != (f.rest_cells, f.gouge_cells, f.is_clean()) {
+        out.push(format!(
+            "{at}: counts rest {} / gouge {} / clean {} vs field rest {} / gouge {} / clean {}",
+            c.rest_cells, c.gouge_cells, c.is_clean(), f.rest_cells, f.gouge_cells, f.is_clean()
+        ));
+    }
+    for (name, a, b) in [("max_rest_at", c.max_rest_at, f.max_rest_at), ("max_gouge_at", c.max_gouge_at, f.max_gouge_at)] {
+        let near = match (a, b) {
+            (None, None) => true,
+            (Some(a), Some(b)) => (a.x - b.x).abs().max((a.y - b.y).abs()).max((a.z - b.z).abs()) <= FIELD_VERDICT_EPS,
+            _ => false,
+        };
+        if !near {
+            out.push(format!("{at}: {name} {a:?} vs field {b:?}"));
+        }
+    }
+    worst
+}
+
+/// Every carried read of one document, on both engines.
+fn judge(doc: &Doc, out: &mut Vec<String>) {
+    let (w, name) = (&doc.world, &doc.name);
+    let before = out.len();
+    let mut worst = 0.0f64;
+    let mut reads = 0;
+    let mut took = |v: f64| {
+        worst = worst.max(v);
+        reads += 1;
+    };
+    if let Some((c, f)) = both(&format!("{name} / program verdict"), out, || simulate_document(w).map(|s| s.dev)) {
+        took(compare_verdicts(&format!("{name} / program verdict"), &c, &f, out));
+    }
+    if let Some((c, f)) = both(&format!("{name} / incoming body"), out, || incoming_body(w, "Setup2")) {
+        took(compare_bodies(&format!("{name} / incoming body"), &c, &f, out));
+    }
+    if let Some((op, r)) = doc.consumer {
+        let setup = Some("Setup2");
+        let at = format!("{name} / rest grid of {op}");
+        let read = || rest::prior_state(w, op, setup, r).map(|p| (p.grid, p.digest)).map_err(|e| e.to_string());
+        if let Some(((cg, cd), (fg, fd))) = both(&at, out, read) {
+            if cd != fd {
+                out.push(format!("{at}: the stamp digest differs between engines"));
+            }
+            match (cg, fg) {
+                (Some(c), Some(f)) => took(compare_tops(&at, &c, &f, out)),
+                (None, None) => {}
+                (c, f) => out.push(format!("{at}: a mask on one engine only (column {}, field {})", c.is_some(), f.is_some())),
+            }
+        }
+        let at = format!("{name} / verify prior of {op}");
+        let read = || rest::prior_plan(w, op, setup, r)?.map(rest::PriorPlan::simulate).transpose();
+        match both(&at, out, read) {
+            Some((Some(c), Some(f))) => took(compare_tops(&at, &c, &f, out)),
+            Some((None, None)) | None => {}
+            Some((c, f)) => out.push(format!("{at}: a prior on one engine only (column {}, field {})", c.is_some(), f.is_some())),
+        }
+        let at = format!("{name} / entered body of {op}");
+        let read = || rest::entered_body(w, op, setup, r).map(|b| b.map(|(origin, body)| (origin, (*body).clone())));
+        match both(&at, out, read) {
+            Some((Some((co, c)), Some((fo, f)))) => {
+                if co != fo {
+                    out.push(format!("{at}: origin '{co}' vs field '{fo}'"));
+                }
+                took(compare_bodies(&at, &c, &f, out));
+            }
+            Some((None, None)) | None => {}
+            Some((c, f)) => out.push(format!("{at}: carried on one engine only (column {}, field {})", c.is_some(), f.is_some())),
+        }
+        let at = format!("{name} / verify bounds of {op}");
+        if let Ok(Some((_, block))) = rest::carried_stock_block(w, op, setup) {
+            match both(&at, out, || rest::carried_stock_body(w, op, setup, r, block)) {
+                Some((Some((cb, c)), Some((fb, f)))) => {
+                    let far = |a: camcraft_app::geometry::Point3, b: camcraft_app::geometry::Point3| {
+                        (a.x - b.x).abs().max((a.y - b.y).abs()).max((a.z - b.z).abs()) > FIELD_VERDICT_EPS
+                    };
+                    if far(cb.0, fb.0) || far(cb.1, fb.1) {
+                        out.push(format!("{at}: bounds {cb:?} vs field {fb:?}"));
+                    }
+                    took(compare_tops(&at, &c, &f, out));
+                }
+                Some((None, None)) | None => {}
+                Some((c, f)) => out.push(format!("{at}: bounds on one engine only (column {}, field {})", c.is_some(), f.is_some())),
+            }
+        }
+    }
+    println!("{name} | reads {reads} | max |delta| {worst:.3e} | findings {}", out.len() - before);
+}
+
+#[test]
+#[ignore = "heavy lane (#637 carried-stock agreement): the carried suites' documents read on both stock engines, release ~1 min - run at milestone close with -- --ignored"]
+fn both_engines_read_every_carried_document_alike() {
+    let mut findings: Vec<String> = Vec::new();
+    println!("document | reads compared | max |delta| | findings");
+    let docs = documents();
+    for doc in &docs {
+        judge(doc, &mut findings);
+    }
+    for f in &findings {
+        println!("FINDING {f}");
+    }
+    assert!(findings.is_empty(), "{} finding(s) across {} documents - see the list above", findings.len(), docs.len());
+}
+
+#[test]
+fn the_engine_switch_is_scoped_and_defaults_to_the_column_engine() {
+    use camcraft_app::stock_sim::carry_engine;
+    // The process default (no CAMCRAFT_CARRY_ENGINE in a gate run) is
+    // what ships; a scope sets it and puts it back, nested and on panic.
+    let outer = carry_engine();
+    if std::env::var(camcraft_app::stock_sim::CARRY_ENGINE_ENV).is_err() {
+        assert_eq!(outer, Backend::Column, "the column engine is the default");
+    }
+    with_carry_engine(FIELD, || {
+        assert_eq!(carry_engine(), FIELD);
+        with_carry_engine(Backend::Column, || assert_eq!(carry_engine(), Backend::Column));
+        assert_eq!(carry_engine(), FIELD);
+    });
+    assert_eq!(carry_engine(), outer);
+    let caught = std::panic::catch_unwind(|| with_carry_engine(FIELD, || panic!("unwound")));
+    assert!(caught.is_err());
+    assert_eq!(carry_engine(), outer, "restored after an unwind");
+}
