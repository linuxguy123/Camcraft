From 01ea313a195a40bfdc181f74ffa672215266ce12 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 08:09:48 -0800
Subject: [PATCH] fix(app): a refusal on a setup with no machine says so

A turning or plasma op refused on a setup with no machine mounted
said "the setup's machine is a mill", but an unmounted setup reads as
a mill only by default (the kind_of law), so the words misstated it.
The refusal is unchanged in verdict; only the clause differs: "the
setup has no machine mounted" when none is mounted, the mill wording
kept when one is.

Pinned by the_family_door_names_both_sides, a_mounted_mill_refusal_names_the_mill
and the_plasma_family_lives_on_a_plasma_table_only.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Fixes #1291
---
 crates/app/src/commands/operation/gates.rs | 14 ++++++++++----
 crates/app/tests/plasma_profile.rs         |  2 ++
 crates/app/tests/turning.rs                | 18 ++++++++++++++++++
 3 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/crates/app/src/commands/operation/gates.rs b/crates/app/src/commands/operation/gates.rs
index 447844328..22d64a62d 100644
--- a/crates/app/src/commands/operation/gates.rs
+++ b/crates/app/src/commands/operation/gates.rs
@@ -112,20 +112,26 @@ pub(super) fn family_gate(world: &World, context: Option<&str>, params: &OpParam
             family.work(),
         )));
     }
+    // #1291: an unmounted setup reads as a mill (the kind_of law), so
+    // the words must not call it one - they say no machine is mounted.
+    let mounted = crate::machine::of_setup(world, context).1.is_some();
+    let clause = if mounted {
+        format!("the setup's machine is a {}", machine.word())
+    } else {
+        "the setup has no machine mounted".to_owned()
+    };
     // #670: plasma work needs a plasma table - no mill or lathe (nor a
     // mill-turn) strikes an arc.
     if family == Family::Plasma {
         return Err(CommandError::Invalid(format!(
-            "a {} operation is plasma cutting work; the setup's machine is a {} - mount a plasma table first",
+            "a {} operation is plasma cutting work; {clause} - mount a plasma table first",
             params.kind(),
-            machine.word(),
         )));
     }
     Err(CommandError::Invalid(format!(
-        "a {} operation is {} work; the setup's machine is a {} - mount a {} (or a mill-turn) first",
+        "a {} operation is {} work; {clause} - mount a {} (or a mill-turn) first",
         params.kind(),
         family.work(),
-        machine.word(),
         family.machine(),
     )))
 }
diff --git a/crates/app/tests/plasma_profile.rs b/crates/app/tests/plasma_profile.rs
index 035983fa1..b27edb476 100644
--- a/crates/app/tests/plasma_profile.rs
+++ b/crates/app/tests/plasma_profile.rs
@@ -140,6 +140,8 @@ fn the_plasma_family_lives_on_a_plasma_table_only() {
         .err()
         .expect("refused on a mill");
     assert!(format!("{err:?}").contains("plasma cutting work") && format!("{err:?}").contains("mount a plasma table"), "{err:?}");
+    // #1291: this world mounts no machine, so the words say so.
+    assert!(format!("{err:?}").contains("the setup has no machine mounted - mount a plasma table first"), "{err:?}");
     // And on the plasma table, a milling tool is the tool law's refusal.
     let (world, mut h) = plasma_doc();
     let em = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").expect("em");
diff --git a/crates/app/tests/turning.rs b/crates/app/tests/turning.rs
index 5b8797834..dfdc04fe5 100644
--- a/crates/app/tests/turning.rs
+++ b/crates/app/tests/turning.rs
@@ -150,6 +150,9 @@ fn the_family_door_names_both_sides() {
     let msg = err.to_string();
     assert!(msg.contains("turning") && msg.contains("lathe"), "{msg}");
     assert!(msg.contains("Facing"), "{msg}");
+    // #1291: no machine is mounted, so the words say so - never "a mill".
+    assert!(msg.contains("the setup has no machine mounted - mount a lathe (or a mill-turn) first"), "{msg}");
+    assert!(!msg.contains("is a mill"), "{msg}");
     assert!(model::find_by_name(&world, "F1").is_none(), "a refusal creates nothing");
     // The lathe mount opens it - through the command, so the history
     // owns the change and undo shuts the door again.
@@ -316,3 +319,18 @@ fn facing_refuses_a_mill_tool_by_name() {
     let msg = err.to_string();
     assert!(msg.contains("turning insert") && msg.contains("EM-0400-2FL"), "{msg}");
 }
+
+#[test]
+fn a_mounted_mill_refusal_names_the_mill() {
+    // #1291: the mill case keeps its wording - the mounted machine is
+    // named, and the mount that opens the door is the same as before.
+    let (world, mut history) = bar_world();
+    mount(&world, &mut history, "mill");
+    let Err(err) =
+        CreateOperation::new(&world, "F1", "TN-1600-0R8", SrcRef::Entity("bar".into()), facing_params(14.0))
+    else {
+        panic!("a turning op on a mounted mill must refuse");
+    };
+    let msg = err.to_string();
+    assert!(msg.contains("the setup's machine is a mill - mount a lathe (or a mill-turn) first"), "{msg}");
+}
