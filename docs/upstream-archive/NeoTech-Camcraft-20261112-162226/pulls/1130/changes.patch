diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 1a19c442f..48938501b 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -19,6 +19,10 @@
 # alongside the platform builds; `pages` deploys it to GitHub Pages only on
 # a tag run and only once `publish` has put the release page up, so the
 # site's download links never point at a release that is not there.
+# Browser build (#1103): `wasm` builds the shell for wasm32 from the same
+# tree and hands the page folder to `site`, which serves it at app/. A
+# failed wasm build leaves app/ as the site's own "not part of this copy"
+# page and a warning in the run; the docs and the release go out anyway.
 name: Release
 on:
   push:
@@ -438,10 +442,58 @@ jobs:
           # refused a release with no asset at all.
           fail_on_unmatched_files: false
 
+  wasm:
+    # #1103: the browser shell (#31), built for wasm32 from this run's tree
+    # by web/build-app-wasm.sh. Its own runner, so the Cargo.lock the build
+    # rewrites for its flecs patch (#949) never reaches another job: only
+    # target/web/ leaves it, as the wasm-app artifact. No rust-cache: tags
+    # come weeks apart and an unused cache is evicted after 7 days.
+    runs-on: ubuntu-24.04
+    timeout-minutes: 45
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install the wasm32 Rust target and the C toolchain
+        # flecs' C is compiled by clang for wasm32 and archived by llvm-ar
+        # (Ubuntu's LLVM has the wasm32 backend). The wasi sysroot is a
+        # pinned, checksummed download inside the build script; the
+        # wasm-bindgen CLI is installed there with --version and --locked.
+        run: |
+          rustup target add wasm32-unknown-unknown
+          sudo apt-get update
+          sudo apt-get install -y clang-18 llvm-18
+          echo "CC_wasm32_unknown_unknown=clang-18" >> "$GITHUB_ENV"
+          echo "AR_wasm32_unknown_unknown=llvm-ar-18" >> "$GITHUB_ENV"
+      - name: Build the browser shell
+        run: bash web/build-app-wasm.sh --release
+      - name: Check the page folder
+        # The four files are there, the .wasm is a wasm module, and every
+        # URL is relative to the page's folder (it is served at
+        # <pages>/<repo>/app/, not at a site root).
+        run: |
+          bash web/check-app-page.sh target/web
+          ls -l target/web
+      - name: Cargo.lock untouched
+        # The script puts the lock back on exit; say so if it did not, so
+        # the next fix knows (nothing else is built from this checkout).
+        if: always()
+        run: git diff --quiet -- Cargo.lock || echo "::warning::web/build-app-wasm.sh left Cargo.lock modified (#949)"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: wasm-app
+          path: target/web/
+          if-no-files-found: error
+
   site:
     # #688: the documentation site, built with Zola from this run's tree
     # (the tagged tree on a tag run). Read-only; a workflow_dispatch run
     # builds it as a check and deploys nothing.
+    # #1103: waits for `wasm` whatever its result (but not on a cancelled
+    # run), like `publish` waits for the platforms: a failed browser build
+    # never withholds the docs.
+    needs: [wasm]
+    if: ${{ !cancelled() }}
     runs-on: ubuntu-latest
     permissions:
       contents: read
@@ -476,6 +528,27 @@ jobs:
           cd site
           /tmp/zola build --base-url "https://${owner}.github.io/${repo}"
           test -s public/index.html
+      - uses: actions/download-artifact@v4
+        if: ${{ needs.wasm.result == 'success' }}
+        with:
+          name: wasm-app
+          path: /tmp/wasm-app
+      - name: Browser build at app/
+        # Zola wrote app/ as the "not part of this copy" page; the browser
+        # build replaces it when it built. When it did not, that page stays
+        # and the run says so by name.
+        shell: bash
+        env:
+          WASM_RESULT: ${{ needs.wasm.result }}
+        run: |
+          if [ "$WASM_RESULT" = success ]; then
+            rm -rf site/public/app
+            cp -r /tmp/wasm-app site/public/app
+            bash web/check-app-page.sh site/public/app
+          else
+            echo "::warning::Browser build missing: the wasm job did not succeed (result: $WASM_RESULT); the site goes out with app/ saying so"
+            test -s site/public/app/index.html
+          fi
       - uses: actions/upload-pages-artifact@v5
         with:
           path: site/public
diff --git a/docs/decisions/1103-wasm-app-on-pages.md b/docs/decisions/1103-wasm-app-on-pages.md
new file mode 100644
index 000000000..71e6f533a
--- /dev/null
+++ b/docs/decisions/1103-wasm-app-on-pages.md
@@ -0,0 +1,56 @@
+## #1103 - the browser build on the Pages site
+
+**Path layout.** The browser shell is served at `<pages>/<repo>/app/`
+(`https://neotech.github.io/Camcraft/app/`): the folder
+`web/build-app-wasm.sh` writes (`index.html`, `wasi_shim.js`,
+`camcraft-ui.js`, `camcraft-ui_bg.wasm`) is copied as is into the Zola
+output's `app/`. Every URL the page loads was already relative
+(`./wasi_shim.js` in the import map and the module script, `./camcraft-ui.js`,
+and wasm-bindgen's `new URL('camcraft-ui_bg.wasm', import.meta.url)`), so
+no file changed; `web/check-app-page.sh` now pins it, in the wasm job and
+again on the Pages artifact's `app/`, and runs locally on `target/web`.
+Considered: a `<base href>` in the page, or rewriting paths in the workflow
+- dropped, both add a second truth for a path that is already relative.
+
+**Failure behaviour.** The `site` job needs `wasm` with `if: !cancelled()`,
+the pattern `publish` uses for the platforms. A failed wasm build skips
+the artifact download; the site deploys anyway, the run carries a warning
+naming the missing browser build, and `app/` is a real page instead of a
+404: `site/content/app.md`, a Zola page at `app/` that says the browser
+build is not part of this copy of the site and why that happens. When the
+wasm build succeeded, the workflow replaces that page's folder with the
+app. The same page is what a local `zola build` shows (no wasm there), so
+it is never a dead link. Considered: a separate stand-in HTML written by
+the workflow (dropped: not visible in local previews, and a second place
+holding site text), and failing the site on a missing app (dropped: the
+issue asks that the docs never wait on the browser build).
+
+**The front page's note** sits in `templates/index.html`, not in
+`_index.md`, because it names the version (`site/version.toml`), which only
+the templates read. The list of what does not work comes from #31's last
+comment: no file picker, no playback without threads, no WebGPU.
+
+**#949 (`Cargo.lock` rewritten by the build).** Not stacked on draft PR
+#1009. The wasm build runs on its own runner and only `target/web/` leaves
+it (the `wasm-app` artifact), so a rewritten lock cannot reach any package
+or the site. The script on main already restores the lock with an EXIT
+trap around its cargo build; a cheap `if: always()` step warns if the lock
+is still modified, so #1009 can be judged from a real run. #1009 stays
+independent and can merge in any order.
+
+**No new trigger.** The job rides `release.yml`'s existing triggers (a
+`vX.Y.0` tag, or a hand-run `workflow_dispatch`, which builds and deploys
+nothing). AGENTS.md's Actions budget forbids `push` / `pull_request` /
+`schedule`; a per-PR browser build would also cost more minutes than the
+whole release.
+
+**Pinned downloads.** The wasi sysroot is pinned by version and sha256
+inside the script; the wasm-bindgen CLI is installed by
+`cargo install --version <lock's version> --locked` (crates.io checksums
+via its own lock); clang-18 / llvm-18 come from Ubuntu's signed archive
+like the linux job's apt packages; the runner is pinned to `ubuntu-24.04`
+so the apt package names hold. No `wasm-opt`: binaryen has no pinned,
+checksummed download in this repo, and the size is well inside Pages'
+limits (100 MB per file). No rust-cache on the job: tags come weeks apart
+and GitHub evicts a cache unused for 7 days, so it would only cost the
+save.
