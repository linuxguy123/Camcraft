+    h.execute(&world, EditOperationParams::with_suppressed(&world, "Facing2", true).expect("suppress"));
+    h.execute(&world, ActivateSetup::new(&world, Some("Setup1")).expect("activate"));
+    let dir = scratch("serves-mill");
