From d73477bcd4e1d1b8bef7782ddae9d1703536e038 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 02:12:09 -0800
Subject: [PATCH] fix(post): doosan-dnm index writes A only for a stated A
 rotary

The non-RTCP indexing path formatted "A" itself, bypassing #1092's
angleWord/missingLetter: a machine with clamp codes and no A rotary
posted A words. It now refuses a turning letter the machine does not
state by name, refuses a turning C (this path writes only A, and used
to drop C silently), and writes A through angleWord - byte-identical on
a machine that states A.

Pinned by doosan_dnm_index_names_only_a_stated_rotary.

Fixes #1155

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 assets/posts/doosan-dnm.cps                | 15 +++++++++-
 crates/app/tests/doosan_dnm_post.rs        | 23 ++++++++++++++
 docs/decisions/1155-doosan-index-a-word.md | 35 ++++++++++++++++++++++
 3 files changed, 72 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/1155-doosan-index-a-word.md

diff --git a/assets/posts/doosan-dnm.cps b/assets/posts/doosan-dnm.cps
index 319d69ecb..9e93adfc7 100644
--- a/assets/posts/doosan-dnm.cps
+++ b/assets/posts/doosan-dnm.cps
@@ -307,10 +307,23 @@ function tilt(p) {  // words to append, [] if none, null if refused
       if (!tiltRefused) { tiltRefused = true; msg("tilted move on a machine without a tilting rotary"); }
       return null;
     }
+    // #1155: the index names only a rotary the machine states, as the
+    // RTCP path does - a turning letter with no rotary of that name is
+    // refused by name, never posted as an address the control lacks; a
+    // stated C that turns is refused too, as this path writes only A.
+    var lostIx = missingLetter(p);
+    if (lostIx) {
+      if (!tiltRefused) { tiltRefused = true; msg("indexed move commands " + lostIx + " - the machine states no " + lostIx + " rotary"); }
+      return null;
+    }
+    if (has(p.C) && Math.abs(p.C) > 1e-9) {
+      if (!tiltRefused) { tiltRefused = true; msg("indexed move commands C - this dialect's indexing path writes only an A rotary"); }
+      return null;
+    }
     var rotWords = [];
     var aChanged = !has(lastA) || p.A !== lastA;
     if (aChanged) {
-      rotWords.push("A" + fu(p.A));
+      rotWords.push(angleWord("A", p.A));
     }
     return rotWords;
   }
diff --git a/crates/app/tests/doosan_dnm_post.rs b/crates/app/tests/doosan_dnm_post.rs
index ef84232ae..73d0da15c 100644
--- a/crates/app/tests/doosan_dnm_post.rs
+++ b/crates/app/tests/doosan_dnm_post.rs
@@ -374,3 +374,26 @@ fn doosan_dnm_absent_rotary_takes_no_angle_word() {
     let c_word = |l: &str| l.split(' ').any(|w| w.len() > 1 && w.starts_with('C') && w[1..].parse::<f64>().is_ok());
     assert!(!out.program.lines().any(c_word), "no C word on a machine with no C: {}", out.program);
 }
+
+/// #1155: the indexing path (no RTCP) names only a rotary the machine
+/// states. An A index on a machine with no A is refused by name with no A
+/// word written; a stated C that turns is refused (this path writes only
+/// A); the shipped A machine posts its index words unchanged.
+#[test]
+fn doosan_dnm_index_names_only_a_stated_rotary() {
+    let cps = dnm_post();
+    let opts = serde_json::json!({ "rotaryBrake": true });
+    let stream = |a: &str, c: &str| format!("TOOL 1 T1\nSECTION\nRapid X 0 Y 0 Z 10000 A {a} C {c}\nFeed X 50000 Y 0 Z -1000 F 400000 A {a} C {c}\nENDSECTION\n");
+    let axis = |l: &str, k: char| l.split(' ').any(|w| w.len() > 1 && w.starts_with(k) && w[1..].parse::<f64>().is_ok());
+    let out = engine::run_with(&cps, &serde_json::json!({}), &stream("90000", "0"), &opts).expect("post");
+    assert_eq!(out.warnings, vec!["indexed move commands A - the machine states no A rotary"]);
+    assert!(!out.program.lines().any(|l| axis(l, 'A')), "no A word without an A: {}", out.program);
+    let mt = machine::mirror(&parse_mch(&read("assets/machines/millturn.mch")).expect("millturn parses"));
+    let out = engine::run_with(&cps, &mt, &stream("0", "45000"), &opts).expect("post");
+    assert_eq!(out.warnings, vec!["indexed move commands C - this dialect's indexing path writes only an A rotary"]);
+    assert!(!out.program.lines().any(|l| axis(l, 'C')), "no C word: {}", out.program);
+    let out = engine::run_with(&cps, &dnm_machine(), &stream("90000", "0"), &opts).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let moves: Vec<&str> = out.program.lines().filter(|l| l.starts_with("G00") || l.starts_with("G01") || *l == "M10" || *l == "M11").collect();
+    assert_eq!(moves, vec!["M11", "G00 X0 Y0 Z10 A90", "M10", "G01 X50 Y0 Z-1 F400"], "{}", out.program);
+}
diff --git a/docs/decisions/1155-doosan-index-a-word.md b/docs/decisions/1155-doosan-index-a-word.md
new file mode 100644
index 000000000..55ce09d76
--- /dev/null
+++ b/docs/decisions/1155-doosan-index-a-word.md
@@ -0,0 +1,35 @@
+## #1155 - Doosan indexing path writes its A word only for a stated A
+
+**What was decided.** `doosan-dnm.cps`'s non-RTCP indexing path (the
+clamp/unclamp 4th-axis path in `tilt()`) now writes its rotary word
+through #1092's `angleWord("A", ...)` and runs #1092's `missingLetter`
+first. A turning letter the machine states no rotary for is refused by
+name ("indexed move commands A - the machine states no A rotary") and no
+word is posted. A stated C that turns is refused too ("indexed move
+commands C - this dialect's indexing path writes only an A rotary"):
+this path never wrote C, so before this change a turning C was silently
+dropped from the block. A machine that states A posts byte-identically
+(`angleWord` is `w()`, which is `"A" + fu(v)` for a finite angle, and
+`tilt()` returns early unless the angle is finite).
+
+**Why.** Every other angle-word writer in the script went through
+`angleWord`/`missingLetter` after #1092; this one formatted `A` itself,
+so a non-RTCP machine with clamp codes and no A rotary posted A words
+the control has no axis for. Prime Directive: refuse by name, never post
+an address the machine does not have, never drop a turning axis.
+
+**Considered and dropped.**
+- Reusing the RTCP message text ("tilted move commands ..."). Dropped: an
+  index is not a tilt, and the existing tilt refusal strings are matched
+  by tests; a distinct "indexed move" prefix keeps both readable.
+- Writing a C word on the indexing path for a stated C. Dropped: that is
+  new indexing behaviour (a C table's clamp codes, its sign law) with no
+  machine or golden to pin it; refusing is the safe floor until an issue
+  asks for C indexing.
+- Moving the refusal before the clamp-code check. Dropped: it would
+  change which refusal an existing undeclared-clamp case reports (the
+  `rotary.refusal` golden and the undeclared-clamp tests).
+
+**Other direct letter writers.** None left that format a rotary letter:
+the probe macro's `ax + fu(pos)` writes only X/Y/Z, and `fanuc.cps`'s
+non-RTCP path refuses every tilt, so it writes no index word.
