         Some("icons") => icons::run(&root(), &args[1..]),
+        Some("merge-plan") => merge_plan_git::run(&root(), &args[1..]),
         Some("package") => {
             let a = package::parse(&args[1..]).map_err(|e| format!("{e}\n{USAGE}"))?;
             Ok(package::run(&root(), &a))
diff --git a/xtask/src/merge_delta.rs b/xtask/src/merge_delta.rs
new file mode 100644
index 000000000..250fdadb1
--- /dev/null
+++ b/xtask/src/merge_delta.rs
@@ -0,0 +1,129 @@
+//! What changed since a reviewed head (AGENTS.md "A clean merge of main keeps its review", #1221): classifies the
+//! commits after the reviewed head, so a merge of main whose remerge-diff is empty keeps its review and needs no
+//! delta review. Pure: git supplies the commits (merge_plan_git.rs). Provenance: port of the maintainer's
+//! merge-ready planner delta mode (plan_merge_order.py --delta, #1221), the same verdicts and notes.
+
+use std::fmt::Write as _;
+
+use crate::merge_plan::{mechanical, short};
+
+/// One commit after the reviewed head, as git describes it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Commit {
+    pub sha: String,
+    pub subject: String,
+    /// The parent shas, first parent first.
+    pub parents: Vec<String>,
+    /// For a merge: its second parent is an ancestor of the base, so the merge brings main in.
+    pub second_is_base: bool,
+    /// The files `git show --remerge-diff` changes for a merge of the base (empty: no hand edits).
+    pub remerge_files: Vec<String>,
+}
+
+/// The class of the change since the review.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Verdict {
+    /// The head is the reviewed head.
+    Unchanged,
+    /// The reviewed head is no longer in the branch: the history was rewritten.
+    Rewritten,
+    /// Only merges of the base with no hand edits: the review stands.
+    Same,
+    /// Hand edits only in rule-settled files: read them, no agent.
+    Mechanical,
+    /// A conflict was resolved by hand: a delta review of the remerge-diff.
+    Delta,
+    /// New commits (or a merge of another branch): a review of those commits.
+    NewCode,
+}
+
+impl Verdict {
+    pub fn label(self) -> &'static str {
+        match self {
+            Verdict::Unchanged | Verdict::Same => "SAME",
+            Verdict::Mechanical => "MECHANICAL",
+            Verdict::Delta => "DELTA",
+            Verdict::Rewritten | Verdict::NewCode => "NEW CODE",
+        }
+    }
+
+    pub fn meaning(self) -> &'static str {
+        match self {
+            Verdict::Unchanged => "the head is the reviewed head",
+            Verdict::Rewritten => "the reviewed head is not in the branch any more (history rewritten) - full review",
+            Verdict::Same => {
+                "only merges of the base with no hand edits: the tree is what merging the reviewed head would give - the review stands, no agent needed"
+            }
+            Verdict::Mechanical => {
+                "hand edits only in rule-settled files: read `git show --remerge-diff <merge>` yourself, no agent needed"
+            }
+            Verdict::Delta => {
+                "a conflict was resolved by hand: a read-only delta review of `git show --remerge-diff <merge>` (rebuild only if logic was merged)"
+            }
+            Verdict::NewCode => "new commits since the review: a review of `git diff <reviewed>..<head>` for those commits",
+        }
+    }
+}
+
+/// The verdict and one note per commit.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Delta {
+    pub verdict: Verdict,
+    pub notes: Vec<String>,
+}
+
+fn subject(s: &str) -> String {
+    s.chars().take(70).collect()
+}
+
+/// Classifies the commits between the reviewed head and `head`. `commits` is in order, first parent only.
+pub fn classify(head: &str, reviewed: &str, reviewed_is_ancestor: bool, base_name: &str, commits: &[Commit]) -> Delta {
+    if head == reviewed {
+        return Delta { verdict: Verdict::Unchanged, notes: Vec::new() };
+    }
+    if !reviewed_is_ancestor {
+        return Delta { verdict: Verdict::Rewritten, notes: Vec::new() };
+    }
+    let mut verdict = Verdict::Same;
+    let mut notes = Vec::new();
+    for c in commits {
+        let sha = short(&c.sha);
+        let Some(second) = c.parents.get(1) else {
+            verdict = Verdict::NewCode;
+            notes.push(format!("{sha} commit: {}", subject(&c.subject)));
+            continue;
+        };
+        if !c.second_is_base {
+            verdict = Verdict::NewCode;
+            notes.push(format!(
+                "{sha} merges a branch that is not {base_name} ({}): {}",
+                short(second),
+                subject(&c.subject)
+            ));
+            continue;
+        }
+        if c.remerge_files.is_empty() {
+            notes.push(format!("{sha} merge of {base_name}, no hand edits"));
+        } else if c.remerge_files.iter().all(|f| mechanical(f)) {
+            notes.push(format!("{sha} merge of {base_name}, hand edits only in: {}", c.remerge_files.join(", ")));
+            if verdict == Verdict::Same {
+                verdict = Verdict::Mechanical;
+            }
+        } else {
+            notes.push(format!("{sha} merge of {base_name}, HAND-RESOLVED: {}", c.remerge_files.join(", ")));
+            if verdict != Verdict::NewCode {
+                verdict = Verdict::Delta;
+            }
+        }
+    }
+    Delta { verdict, notes }
+}
+
+/// The verdict as the text the skill reads: a label, its meaning, then the notes.
+pub fn render(d: &Delta) -> String {
+    let mut s = format!("{}: {}\n", d.verdict.label(), d.verdict.meaning());
+    for n in &d.notes {
+        let _ = writeln!(s, "  {n}");
+    }
+    s
+}
diff --git a/xtask/src/merge_plan.rs b/xtask/src/merge_plan.rs
new file mode 100644
index 000000000..32cfe8460
--- /dev/null
+++ b/xtask/src/merge_plan.rs
@@ -0,0 +1,320 @@
+//! The merge order of a set of open PRs (AGENTS.md "Conflicted PRs are re-merged by their author", #1221):
+//! the wave of PRs that merge cleanly with no refresh, then the conflicting ones one at a time.
+//! Pure: every conflict comes from a `trial` callback (git's merge-tree, merge_plan_git.rs), so the ordering
+//! is unit-tested without git. Provenance: port of the maintainer's merge-ready planner
+//! (plan_merge_order.py, #1221), the same steps in the same order.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt::Write as _;
+
+/// A conflict confined to these paths (or to PNG snapshots) is settled by rule, without judgement.
+const MECHANICAL: &[&str] = &[".claude/PROCESS_VERSION", "CHANGELOG.md", "RECOMMENDED.md", "Cargo.lock"];
+/// Basenames that make a PR "hot": a PR touching one is merged after the cool ones within a wave.
+const HOT: &[&str] = &["lib.rs", "mod.rs", "state.rs", "Cargo.lock", "Cargo.toml", "AGENTS.md", "schema.rs"];
+
+/// Conflicts of merging PR `pr` onto the PRs `onto` (already merged, in order) on the base: `None` when clean,
+/// else the conflicted paths.
+pub type Trial<'a> = dyn FnMut(&[u32], u32) -> Result<Option<Vec<String>>, String> + 'a;
+
+/// Which PR must merge before which: `before[b]` holds the PRs that b is stacked on.
+pub type Before = BTreeMap<u32, BTreeSet<u32>>;
+
+/// A conflict that the process settles by rule (AGENTS.md "Conflicted PRs": snapshots, changelog, version).
+pub fn mechanical(path: &str) -> bool {
+    MECHANICAL.contains(&path) || path.ends_with(".png")
+}
+
+/// A short sha for display.
+pub fn short(sha: &str) -> String {
+    sha.chars().take(8).collect()
+}
+
+fn basename(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// One open PR as the planner sees it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Pr {
+    pub number: u32,
+    pub title: String,
+    /// The PR's head commit.
+    pub head: String,
+    /// Every path the PR changes.
+    pub paths: Vec<String>,
+}
+
+impl Pr {
+    /// How many of its paths are hot (see HOT).
+    pub fn hot(&self) -> usize {
+        self.paths.iter().filter(|p| HOT.contains(&basename(p))).count()
+    }
+
+    /// Only documentation and process files.
+    pub fn docs(&self) -> bool {
+        self.paths.iter().all(|f| f.ends_with(".md") || f.starts_with(".claude/") || f.starts_with("docs/"))
+    }
+}
+
+/// The facts git supplies that the file lists cannot: stack edges and shared unmerged history.
+#[derive(Debug, Default)]
+pub struct Facts {
+    /// Name of the base branch, for messages (`main`).
+    pub base_name: String,
+    /// The base commit the merges are simulated on.
+    pub base_sha: String,
+    pub prs: Vec<Pr>,
+    /// Stack edges: `before[b]` must merge before b (its base is a's head branch, or a's head is in b's history).
+    pub before: Before,
+    /// For a pair `(a, b)` with `a < b` whose merge base is not on the base: the commits each side has above it.
+    pub shared: BTreeMap<(u32, u32), (usize, usize)>,
+}
+
+/// Why a wave-2 PR refreshes and what its refresh is likely to take.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    /// Merges cleanly once wave 1 is in: a plain merge of main is enough.
+    CleanAfterWave1,
+    /// Conflicts only in rule-settled files.
+    Mechanical,
+    /// Conflicts in code: someone reads the hunk.
+    ByHand,
+}
+
+impl Kind {
+    pub fn label(self) -> &'static str {
+        match self {
+            Kind::CleanAfterWave1 => "clean after wave 1",
+            Kind::Mechanical => "mechanical",
+            Kind::ByHand => "by hand",
+        }
+    }
+}
+
+/// One PR of wave 2: refreshed against the main of that moment, checked, merged, then the next.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Refresh {
+    pub number: u32,
+    pub why: String,
+    pub files: Vec<String>,
+    pub kind: Kind,
+}
+
+/// The plan: wave 1 merges with no refresh and no delta review; wave 2 is one refresh at a time.
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct Plan {
+    pub base_sha: String,
+    pub wave1: Vec<u32>,
+    pub wave2: Vec<Refresh>,
+    pub titles: BTreeMap<u32, String>,
+    pub stacked: BTreeMap<u32, Vec<u32>>,
+}
+
+struct Deferred {
+    why: String,
+    files: Vec<String>,
+}
+
+fn parents_of(before: &Before, n: u32) -> Vec<u32> {
+    before.get(&n).map(|s| s.iter().copied().collect()).unwrap_or_default()
+}
+
+fn ordered(before: &Before, a: u32, b: u32) -> bool {
+    parents_of(before, b).contains(&a) || parents_of(before, a).contains(&b)
+}
+
+fn paths_len(by: &BTreeMap<u32, &Pr>, n: u32) -> usize {
+    by.get(&n).map_or(0, |p| p.paths.len())
+}
+
+fn refs(nums: &[u32]) -> String {
+    nums.iter().map(|a| format!("#{a}")).collect::<Vec<_>>().join(", ")
+}
+
+/// Orders the PRs. `trial` answers each merge question; the order and the wave split follow the reference planner.
+pub fn plan(facts: &Facts, trial: &mut Trial<'_>) -> Result<Plan, String> {
+    let by: BTreeMap<u32, &Pr> = facts.prs.iter().map(|p| (p.number, p)).collect();
+    let nums: Vec<u32> = by.keys().copied().collect();
+    let mut before = facts.before.clone();
+    for n in &nums {
+        before.entry(*n).or_default();
+    }
+
+    // Two PRs that share unmerged history: the one with fewer commits of its own on top of it goes first.
+    for (i, &a) in nums.iter().enumerate() {
+        for &b in &nums[i + 1..] {
+            if ordered(&before, a, b) {
+                continue;
+            }
+            let Some(&(own_a, own_b)) = facts.shared.get(&(a, b)) else { continue };
+            let (first, second) = if own_a <= own_b { (a, b) } else { (b, a) };
+            before.entry(second).or_default().insert(first);
+        }
+    }
+
+    // Which PRs merge with the base on their own; the rest are refreshed later.
+    let mut base_clash: BTreeMap<u32, Vec<String>> = BTreeMap::new();
+    let mut ok: Vec<u32> = Vec::new();
+    for &n in &nums {
+        match trial(&[], n)? {
+            None => ok.push(n),
+            Some(files) => {
+                base_clash.insert(n, files);
+            }
+        }
+    }
+
+    // Pairwise clashes among those, each tried on top of the first of the pair.
+    let mut clash: BTreeMap<u32, BTreeMap<u32, Vec<String>>> = BTreeMap::new();
+    for (i, &a) in ok.iter().enumerate() {
+        for &b in &ok[i + 1..] {
+            if ordered(&before, a, b) {
+                continue;
+            }
+            if let Some(files) = trial(&[a], b)? {
+                clash.entry(a).or_default().insert(b, files.clone());
+                clash.entry(b).or_default().insert(a, files);
+            }
+        }
+    }
+
+    // Wave 1 is an independent set: the PR with the fewest live rivals goes in, its rivals are deferred.
+    let mut deferred: BTreeMap<u32, Deferred> = BTreeMap::new();
+    for &n in &nums {
+        if let Some(files) = base_clash.remove(&n) {
+            deferred.insert(n, Deferred { why: format!("conflicts with {} now", facts.base_name), files });
+        }
+    }
+    let mut pool: BTreeSet<u32> = ok.iter().copied().collect();
+    let mut chosen: Vec<u32> = Vec::new();
+    loop {
+        let pick = pool.iter().copied().min_by_key(|x| {
+            let rivals = clash.get(x).map_or(0, |m| m.keys().filter(|c| pool.contains(c)).count());
+            (rivals, paths_len(&by, *x), *x)
+        });
+        let Some(n) = pick else { break };
+        pool.remove(&n);
+        chosen.push(n);
+        for (c, files) in clash.get(&n).cloned().unwrap_or_default() {
+            if pool.remove(&c) {
+                deferred.insert(c, Deferred { why: format!("conflicts with #{n}"), files });
+            }
+        }
+    }
+
+    // A PR whose parent is not in wave 1 cannot be either.
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for n in chosen.clone() {
+            let missing: Vec<u32> = parents_of(&before, n).into_iter().filter(|a| !chosen.contains(a)).collect();
+            if !missing.is_empty() {
+                chosen.retain(|x| *x != n);
+                deferred.insert(n, Deferred { why: format!("its parent {} is not in wave 1", refs(&missing)), files: Vec::new() });
+                changed = true;
+            }
+        }
+    }
+
+    // Parents first; then docs before code, cool before hot, small before large.
+    let mut order: Vec<u32> = Vec::new();
+    let mut left: BTreeSet<u32> = chosen.iter().copied().collect();
+    while !left.is_empty() {
+        let ready: Vec<u32> = left
+            .iter()
+            .copied()
+            .filter(|n| !parents_of(&before, *n).iter().any(|a| left.contains(a)))
+            .collect();
+        let candidates: Vec<u32> = if ready.is_empty() { left.iter().copied().collect() } else { ready };
+        let pick = candidates.into_iter().min_by_key(|x| {
+            let p = by.get(x);
+            (!p.is_some_and(|p| p.docs()), p.map_or(0, |p| p.hot()), paths_len(&by, *x), *x)
+        });
+        let Some(n) = pick else { break };
+        left.remove(&n);
+        order.push(n);
+    }
+
+    // Wave 1: each merge is checked on top of the ones before it. A child of a PR that did not make it is deferred too.
+    let mut wave1: Vec<u32> = Vec::new();
+    for n in order {
+        let missing: Vec<u32> = parents_of(&before, n).into_iter().filter(|a| !wave1.contains(a)).collect();
+        if !missing.is_empty() {
+            deferred.insert(n, Deferred { why: format!("its parent {} is not in wave 1", refs(&missing)), files: Vec::new() });
+            continue;
+        }
+        match trial(wave1.as_slice(), n)? {
+            None => wave1.push(n),
+            Some(files) => {
+                deferred.insert(n, Deferred { why: "conflicts once the earlier wave-1 PRs are in".into(), files });
+            }
+        }
+    }
+
+    // Wave 2: the least entangled first, each checked against the main that wave 1 leaves.
+    let mut keys: Vec<u32> = deferred.keys().copied().collect();
+    let in_deferred: BTreeSet<u32> = keys.iter().copied().collect();
+    keys.sort_by_key(|x| {
+        let entangled = parents_of(&before, *x).iter().filter(|a| in_deferred.contains(a)).count();
+        (entangled, deferred.get(x).map_or(0, |d| d.files.len()), *x)
+    });
+    let mut wave2: Vec<Refresh> = Vec::new();
+    for n in keys {
+        let Some(d) = deferred.remove(&n) else { continue };
+        let (clean, mut files) = match trial(wave1.as_slice(), n)? {
+            None => (true, Vec::new()),
+            Some(f) => (false, f),
+        };
+        if files.is_empty() {
+            files = d.files;
+        }
+        let kind = if clean {
+            Kind::CleanAfterWave1
+        } else if !files.is_empty() && files.iter().all(|f| mechanical(f)) {
+            Kind::Mechanical
+        } else {
+            Kind::ByHand
+        };
+        wave2.push(Refresh { number: n, why: d.why, files, kind });
+    }
+
+    let titles = by.iter().map(|(n, p)| (*n, p.title.clone())).collect();
+    let stacked = nums
+        .iter()
+        .filter_map(|n| {
+            let parents = parents_of(&before, *n);
+            (!parents.is_empty()).then_some((*n, parents))
+        })
+        .collect();
+    Ok(Plan { base_sha: facts.base_sha.clone(), wave1, wave2, titles, stacked })
+}
+
+/// The plan as the text the skill reads.
+pub fn render(p: &Plan) -> String {
+    let mut s = format!("base {}\n", short(&p.base_sha));
+    let _ = writeln!(s, "\nWAVE 1 - merge in this order; no head moves, so no refresh and no delta review ({}):", p.wave1.len());
+    for n in &p.wave1 {
+        let dep = p.stacked.get(n).map(|a| format!("  (after {})", refs(a))).unwrap_or_default();
+        let _ = writeln!(s, "  #{n}  {}{dep}", title(p, *n));
+    }
+    if !p.wave2.is_empty() {
+        let _ = writeln!(
+            s,
+            "\nWAVE 2 - one at a time: refresh against the main of that moment, check, merge, THEN the next ({}):",
+            p.wave2.len()
+        );
+        for w in &p.wave2 {
+            let mut files = w.files.iter().take(6).cloned().collect::<Vec<_>>().join(", ");
+            if w.files.len() > 6 {
+                files.push_str(" ...");
+            }
+            let files = if files.is_empty() { files } else { format!(": {files}") };
+            let _ = writeln!(s, "  #{}  [{}] {}{files}\n         {}", w.number, w.kind.label(), w.why, title(p, w.number));
+        }
+    }
+    s
+}
+
+fn title(p: &Plan, n: u32) -> String {
+    p.titles.get(&n).map(|t| t.chars().take(80).collect()).unwrap_or_default()
+}
diff --git a/xtask/src/merge_plan_git.rs b/xtask/src/merge_plan_git.rs
new file mode 100644
index 000000000..78d2c4118
--- /dev/null
+++ b/xtask/src/merge_plan_git.rs
@@ -0,0 +1,323 @@
+//! `cargo xtask merge-plan`: the git and gh side of the merge planner (#1221). Lists the open PRs, simulates their
+//! merges with `git merge-tree --write-tree` and `git commit-tree` (nothing is checked out, built or pushed), and
+//! prints the wave plan (merge_plan.rs) or the delta class of one PR since a reviewed head (merge_delta.rs).
+//! Provenance: port of the maintainer's merge-ready planner (plan_merge_order.py), #1221.
+
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+use std::path::Path;
+use std::process::Command;
+
+use crate::merge_delta::{self, Commit};
+use crate::merge_plan::{self, Facts, Pr};
+
+const USAGE: &str = "usage: cargo xtask merge-plan <PR>... | --label <name> | --delta <PR> --reviewed <sha>
+      [--repo owner/name] [--remote origin] [--base main]";
+
+/// Commit identity for the simulated merges (they are never pushed).
+const IDENTITY: [(&str, &str); 4] = [
+    ("GIT_AUTHOR_NAME", "merge-plan"),
+    ("GIT_AUTHOR_EMAIL", "merge-plan@localhost"),
+    ("GIT_COMMITTER_NAME", "merge-plan"),
+    ("GIT_COMMITTER_EMAIL", "merge-plan@localhost"),
+];
+
+/// The gh list fields: number, head branch, base branch, labels, paths (unit separator), title.
+const JQ: &str = ".[] | [(.number|tostring), .headRefName, .baseRefName, (.labels|map(.name)|join(\",\")), \
+     (.files|map(.path)|join(\"\\u001f\")), (.title|gsub(\"[\\t\\r\\n]\";\" \"))] | join(\"\\t\")";
+
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct Args {
+    pub prs: Vec<u32>,
+    pub label: Option<String>,
+    pub delta: Option<u32>,
+    pub reviewed: Option<String>,
+    pub repo: Option<String>,
+    pub remote: String,
+    pub base: String,
+}
+
+fn take(it: &mut std::slice::Iter<'_, String>, flag: &str) -> Result<String, String> {
+    it.next().cloned().ok_or_else(|| format!("{flag} needs a value\n{USAGE}"))
+}
+
+pub fn parse(args: &[String]) -> Result<Args, String> {
+    let mut a = Args { remote: "origin".into(), base: "main".into(), ..Args::default() };
+    let mut it = args.iter();
+    while let Some(arg) = it.next() {
+        match arg.as_str() {
+            "--label" => a.label = Some(take(&mut it, arg)?),
+            "--repo" => a.repo = Some(take(&mut it, arg)?),
+            "--remote" => a.remote = take(&mut it, arg)?,
+            "--base" => a.base = take(&mut it, arg)?,
+            "--reviewed" => a.reviewed = Some(take(&mut it, arg)?),
+            "--delta" => {
+                let v = take(&mut it, arg)?;
+                a.delta = Some(v.parse().map_err(|_| format!("--delta needs a PR number, got '{v}'"))?);
+            }
+            s if s.starts_with('-') => return Err(format!("unknown merge-plan option '{s}'\n{USAGE}")),
+            s => a.prs.push(s.parse().map_err(|_| format!("'{s}' is not a PR number\n{USAGE}"))?),
+        }
+    }
+    if a.delta.is_some() && a.reviewed.is_none() {
+        return Err(format!("--delta needs --reviewed <sha of the reviewed head>\n{USAGE}"));
+    }
+    if a.delta.is_none() && a.prs.is_empty() && a.label.is_none() {
+        return Err(format!("give PR numbers, --label, or --delta\n{USAGE}"));
+    }
+    Ok(a)
+}
+
+/// `cargo xtask merge-plan ...`: prints the plan (or the delta class); the process exit code.
+pub fn run(root: &Path, args: &[String]) -> Result<i32, String> {
+    let a = parse(args)?;
+    if let (Some(pr), Some(reviewed)) = (a.delta, a.reviewed.as_deref()) {
+        let text = delta(root, &a, pr, reviewed)?;
+        print!("{text}");
+        return Ok(0);
+    }
+    let listed = load(root, &a)?;
+    let plan = plan_for(root, &a, listed)?;
+    print!("{}", merge_plan::render(&plan));
+    Ok(0)
+}
+
+/// `gh` stdout, or the error gh printed.
+fn gh(root: &Path, args: &[&str]) -> Result<String, String> {
+    let out = Command::new("gh")
+        .current_dir(root)
+        .args(args)
+        .output()
+        .map_err(|e| format!("gh {}: {e}", args.join(" ")))?;
+    if !out.status.success() {
+        return Err(format!("gh {} failed: {}", args.join(" "), String::from_utf8_lossy(&out.stderr).trim()));
+    }
+    Ok(String::from_utf8_lossy(&out.stdout).into_owned())
+}
+
+/// `git -C root <args>`: the exit code and stdout, whatever the code (merge-tree exits 1 on a conflict).
+fn git_status(root: &Path, args: &[&str]) -> Result<(i32, String), String> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(args)
+        .envs(IDENTITY)
+        .output()
+        .map_err(|e| format!("git {}: {e}", args.join(" ")))?;
+    Ok((out.status.code().unwrap_or(-1), String::from_utf8_lossy(&out.stdout).into_owned()))
+}
+
+/// `git -C root <args>`: trimmed stdout; an error when git exits non-zero.
+fn git(root: &Path, args: &[&str]) -> Result<String, String> {
+    let (code, out) = git_status(root, args)?;
+    if code != 0 {
+        return Err(format!("git {} failed (exit {code})", args.join(" ")));
+    }
+    Ok(out.trim().to_string())
+}
+
+fn is_ancestor(root: &Path, a: &str, b: &str) -> Result<bool, String> {
+    Ok(git_status(root, &["merge-base", "--is-ancestor", a, b])?.0 == 0)
+}
+
+/// One open PR as gh lists it, plus the head sha once fetched.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Listed {
+    number: u32,
+    title: String,
+    head_ref: String,
+    base_ref: String,
+    labels: Vec<String>,
+    paths: Vec<String>,
+    head: String,
+}
+
+fn parse_row(line: &str) -> Result<Listed, String> {
+    let f: Vec<&str> = line.splitn(6, '\t').collect();
+    let [number, head_ref, base_ref, labels, paths, title] = f.as_slice() else {
+        return Err(format!("unexpected gh row: {line}"));
+    };
+    Ok(Listed {
+        number: number.parse().map_err(|_| format!("bad PR number in gh row: {line}"))?,
+        title: title.to_string(),
+        head_ref: head_ref.to_string(),
+        base_ref: base_ref.to_string(),
+        labels: labels.split(',').filter(|l| !l.is_empty()).map(str::to_string).collect(),
+        paths: paths.split('\u{1f}').filter(|p| !p.is_empty()).map(str::to_string).collect(),
+        head: String::new(),
+    })
+}
+
+/// The open PRs the plan covers: by label, or the numbers given (each must be open).
+fn load(root: &Path, a: &Args) -> Result<Vec<Listed>, String> {
+    let mut cmd = vec![
+        "pr", "list", "--state", "open", "--limit", "300", "--json",
+        "number,title,headRefName,baseRefName,files,labels", "--jq", JQ,
+    ];
+    if let Some(r) = a.repo.as_deref() {
+        cmd.extend(["--repo", r]);
+    }
+    let all: Vec<Listed> = gh(root, &cmd)?
+        .lines()
+        .filter(|l| !l.is_empty())
+        .map(parse_row)
+        .collect::<Result<_, _>>()?;
+    let mut chosen: Vec<Listed> = if let Some(label) = &a.label {
+        all.into_iter().filter(|p| p.labels.contains(label)).collect()
+    } else {
+        let want: BTreeSet<u32> = a.prs.iter().copied().collect();
+        let found: BTreeSet<u32> = all.iter().map(|p| p.number).filter(|n| want.contains(n)).collect();
+        let missing: Vec<u32> = want.difference(&found).copied().collect();
+        if !missing.is_empty() {
+            return Err(format!("not open PRs: {missing:?}"));
+        }
+        all.into_iter().filter(|p| want.contains(&p.number)).collect()
+    };
+    if chosen.is_empty() {
+        return Err("no matching open PRs".into());
+    }
+    chosen.sort_by_key(|p| p.number);
+    Ok(chosen)
+}
+
+/// Simulated merges: the commit of base plus a sequence of PRs, built once per prefix.
+struct Sim<'a> {
+    root: &'a Path,
+    base_sha: String,
+    heads: BTreeMap<u32, String>,
+    commits: HashMap<Vec<u32>, String>,
+}
+
+impl Sim<'_> {
+    fn head(&self, pr: u32) -> Result<String, String> {
+        self.heads.get(&pr).cloned().ok_or_else(|| format!("no fetched head for PR #{pr}"))
+    }
+
+    /// The commit of base with `seq` merged in order. Only sequences the planner has seen clean are asked for.
+    fn commit_of(&mut self, seq: &[u32]) -> Result<String, String> {
+        let Some((last, rest)) = seq.split_last() else { return Ok(self.base_sha.clone()) };
+        if let Some(c) = self.commits.get(seq) {
+            return Ok(c.clone());
+        }
+        let cur = self.commit_of(rest)?;
+        let head = self.head(*last)?;
+        let (code, out) = git_status(self.root, &["merge-tree", "--write-tree", "--name-only", "--no-messages", &cur, &head])?;
+        if code != 0 {
+            return Err(format!("PR #{last} does not merge cleanly in this sequence; the planner should not have asked"));
+        }
+        let tree = out.lines().next().unwrap_or("").trim().to_string();
+        if tree.is_empty() {
+            return Err(format!("git merge-tree gave no tree for PR #{last}"));
+        }
+        let msg = format!("simulated merge of PR {last}");
+        let c = git(self.root, &["commit-tree", &tree, "-p", &cur, "-p", &head, "-m", &msg])?;
+        self.commits.insert(seq.to_vec(), c.clone());
+        Ok(c)
+    }
+
+    /// `None` when `pr` merges cleanly on `onto`, else the conflicted paths.
+    fn trial(&mut self, onto: &[u32], pr: u32) -> Result<Option<Vec<String>>, String> {
+        let cur = self.commit_of(onto)?;
+        let head = self.head(pr)?;
+        let (code, out) = git_status(self.root, &["merge-tree", "--write-tree", "--name-only", "--no-messages", &cur, &head])?;
+        match code {
+            0 => Ok(None),
+            1 => Ok(Some(out.lines().skip(1).filter(|l| !l.is_empty()).map(str::to_string).collect())),
+            c => Err(format!("git merge-tree failed (exit {c}) for PR #{pr}")),
+        }
+    }
+}
+
+fn count(root: &Path, range: &str) -> Result<usize, String> {
+    git(root, &["rev-list", "--count", range])?.parse().map_err(|_| format!("bad commit count for {range}"))
+}
+
+/// Fetches the PRs and their base, works out the stack and shared-history facts, then runs the planner.
+fn plan_for(root: &Path, a: &Args, mut listed: Vec<Listed>) -> Result<merge_plan::Plan, String> {
+    let (remote, base) = (a.remote.as_str(), a.base.as_str());
+    let refspecs: Vec<String> = listed.iter().map(|p| format!("+refs/pull/{0}/head:refs/merge-plan/{0}", p.number)).collect();
+    let mut fetch: Vec<&str> = vec!["fetch", "--quiet", remote, base];
+    fetch.extend(refspecs.iter().map(String::as_str));
+    git(root, &fetch)?;
+    let base_sha = git(root, &["rev-parse", &format!("refs/remotes/{remote}/{base}")])?;
+    for p in &mut listed {
+        p.head = git(root, &["rev-parse", &format!("refs/merge-plan/{}", p.number)])?;
+    }
+
+    // a must merge before b: b is stacked on a's head branch, or a's head is in b's history.
+    let mut before: merge_plan::Before = BTreeMap::new();
+    for pa in &listed {
+        for pb in &listed {
+            if pa.number == pb.number {
+                continue;
+            }
+            let linked = pb.base_ref == pa.head_ref || (pa.head != pb.head && is_ancestor(root, &pa.head, &pb.head)?);
+            if linked {
+                before.entry(pb.number).or_default().insert(pa.number);
+            }
+        }
+    }
+
+    // Pairs with unmerged shared history (a stack whose parent moved on): each side's own commits above the base.
+    let mut shared = BTreeMap::new();
+    for (i, pa) in listed.iter().enumerate() {
+        for pb in &listed[i + 1..] {
+            let (code, mb) = git_status(root, &["merge-base", &pa.head, &pb.head])?;
+            let mb = mb.trim().to_string();
+            if code != 0 || mb.is_empty() || is_ancestor(root, &mb, &base_sha)? {
+                continue;
+            }
+            let own_a = count(root, &format!("{mb}..{}", pa.head))?;
+            let own_b = count(root, &format!("{mb}..{}", pb.head))?;
+            shared.insert((pa.number, pb.number), (own_a, own_b));
+        }
+    }
+
+    let heads: BTreeMap<u32, String> = listed.iter().map(|p| (p.number, p.head.clone())).collect();
+    let prs: Vec<Pr> = listed
+        .iter()
+        .map(|p| Pr { number: p.number, title: p.title.clone(), head: p.head.clone(), paths: p.paths.clone() })
+        .collect();
+    let facts = Facts { base_name: base.to_string(), base_sha: base_sha.clone(), prs, before, shared };
+    let mut sim = Sim { root, base_sha, heads, commits: HashMap::new() };
+    merge_plan::plan(&facts, &mut |onto: &[u32], pr: u32| sim.trial(onto, pr))
+}
+
+/// The delta class of PR `pr` since `reviewed`: fetched head, the commits after the review, each merge checked.
+fn delta(root: &Path, a: &Args, pr: u32, reviewed_arg: &str) -> Result<String, String> {
+    let (remote, base) = (a.remote.as_str(), a.base.as_str());
+    let refspec = format!("+refs/pull/{pr}/head:refs/merge-plan/{pr}");
+    git(root, &["fetch", "--quiet", remote, base, &refspec])?;
+    let base_ref = format!("refs/remotes/{remote}/{base}");
+    let head = git(root, &["rev-parse", &format!("refs/merge-plan/{pr}")])?;
+    let reviewed = git(root, &["rev-parse", reviewed_arg])?;
+    let ancestor = is_ancestor(root, &reviewed, &head)?;
+    let mut commits: Vec<Commit> = Vec::new();
+    if head != reviewed && ancestor {
+        let range = format!("{reviewed}..{head}");
+        let shas = git(root, &["rev-list", "--reverse", "--first-parent", &range])?;
+        for sha in shas.lines().filter(|l| !l.is_empty()) {
+            let parents: Vec<String> = git(root, &["rev-list", "--parents", "-n", "1", sha])?
+                .split_whitespace()
+                .skip(1)
+                .map(str::to_string)
+                .collect();
+            let subject = git(root, &["show", "-s", "--format=%s", sha])?;
+            let second_is_base = match parents.get(1) {
+                Some(p) => is_ancestor(root, p, &base_ref)?,
+                None => false,
+            };
+            let remerge_files = if second_is_base {
+                git(root, &["show", "--remerge-diff", "--format=", "--name-only", sha])?
+                    .lines()
+                    .filter(|l| !l.is_empty())
+                    .map(str::to_string)
+                    .collect()
+            } else {
+                Vec::new()
+            };
+            commits.push(Commit { sha: sha.to_string(), subject, parents, second_is_base, remerge_files });
+        }
+    }
+    let d = merge_delta::classify(&head, &reviewed, ancestor, base, &commits);
+    Ok(merge_delta::render(&d))
+}
diff --git a/xtask/src/merge_plan_tests.rs b/xtask/src/merge_plan_tests.rs
new file mode 100644
index 000000000..540181939
--- /dev/null
+++ b/xtask/src/merge_plan_tests.rs
@@ -0,0 +1,208 @@
+//! Unit tests of the merge planner's ordering and the delta classes (merge_plan.rs, merge_delta.rs). No git: the
+//! merge answers come from a fake `trial`. Gate map: xtask merge_plan, merge_delta.
+
+use std::collections::BTreeMap;
+
+use crate::merge_delta::{self, Commit, Verdict};
+use crate::merge_plan::{self, Facts, Kind, Pr};
+
+fn pr(n: u32, paths: &[&str]) -> Pr {
+    Pr { number: n, title: format!("PR {n}"), head: format!("h{n}"), paths: paths.iter().map(|p| p.to_string()).collect() }
+}
+
+fn facts(prs: Vec<Pr>) -> Facts {
+    Facts { base_name: "main".into(), base_sha: "base0000".into(), prs, ..Facts::default() }
+}
+
+/// A fake merge oracle: `base` conflicts are for a PR merged on the base alone, `pairs` for two PRs
+/// (either order). A sequence conflicts when any member of it clashes with the PR.
+#[derive(Default)]
+struct Fake {
+    base: BTreeMap<u32, Vec<String>>,
+    pairs: BTreeMap<(u32, u32), Vec<String>>,
+    /// Conflicts only when the sequence holds both of these (a three-way clash).
+    triple: Option<(u32, u32, u32, Vec<String>)>,
+}
+
+impl Fake {
+    fn trial(&self, onto: &[u32], pr: u32) -> Result<Option<Vec<String>>, String> {
+        if onto.is_empty() {
+            return Ok(self.base.get(&pr).cloned());
+        }
+        if let Some((x, y, z, files)) = &self.triple
+            && pr == *z
+            && onto.contains(x)
+            && onto.contains(y)
+        {
+            return Ok(Some(files.clone()));
+        }
+        for o in onto {
+            if let Some(f) = self.pairs.get(&(*o, pr)).or_else(|| self.pairs.get(&(pr, *o))) {
+                return Ok(Some(f.clone()));
+            }
+        }
+        Ok(None)
+    }
+}
+
+fn run(f: &Facts, fake: &Fake) -> merge_plan::Plan {
+    merge_plan::plan(f, &mut |onto: &[u32], n: u32| fake.trial(onto, n)).unwrap_or_default()
+}
+
+#[test]
+fn mechanical_is_the_settled_files_and_snapshots() {
+    assert!(merge_plan::mechanical(".claude/PROCESS_VERSION"));
+    assert!(merge_plan::mechanical("CHANGELOG.md"));
+    assert!(merge_plan::mechanical("crates/ui/tests/snapshots/x.png"));
+    assert!(!merge_plan::mechanical("crates/app/src/lib.rs"));
+}
+
+#[test]
+fn independent_prs_form_one_wave_docs_first_then_cool_then_hot() {
+    let f = facts(vec![pr(1, &["src/a.rs"]), pr(2, &["docs/x.md"]), pr(3, &["src/lib.rs"])]);
+    let p = run(&f, &Fake::default());
+    assert_eq!(p.wave1, vec![2, 1, 3]);
+    assert!(p.wave2.is_empty());
+    assert!(p.stacked.is_empty());
+}
+
+#[test]
+fn base_conflict_is_refreshed_after_wave_one_and_is_clean_then() {
+    let f = facts(vec![pr(1, &["a.rs"]), pr(2, &["b.rs"])]);
+    let fake = Fake { base: BTreeMap::from([(2, vec!["b.rs".to_string()])]), ..Fake::default() };
+    let p = run(&f, &fake);
+    assert_eq!(p.wave1, vec![1]);
+    assert_eq!(p.wave2.len(), 1);
+    assert_eq!(p.wave2[0].number, 2);
+    assert_eq!(p.wave2[0].why, "conflicts with main now");
+    assert_eq!(p.wave2[0].kind, Kind::CleanAfterWave1);
+}
+
+#[test]
+fn pair_clash_on_mechanical_files_is_a_mechanical_refresh() {
+    let f = facts(vec![pr(1, &["a.rs"]), pr(3, &["c.rs"])]);
+    let fake = Fake { pairs: BTreeMap::from([((1, 3), vec!["Cargo.lock".to_string()])]), ..Fake::default() };
+    let p = run(&f, &fake);
+    assert_eq!(p.wave1, vec![1]);
+    assert_eq!(p.wave2[0].number, 3);
+    assert_eq!(p.wave2[0].why, "conflicts with #1");
+    assert_eq!(p.wave2[0].kind, Kind::Mechanical);
+}
+
+#[test]
+fn code_conflict_after_wave_one_is_by_hand() {
+    let f = facts(vec![pr(1, &["a.rs"]), pr(2, &["b.rs"])]);
+    let fake = Fake { pairs: BTreeMap::from([((1, 2), vec!["src/shared.rs".to_string()])]), ..Fake::default() };
+    let p = run(&f, &fake);
+    assert_eq!(p.wave2[0].kind, Kind::ByHand);
+    assert_eq!(p.wave2[0].files, vec!["src/shared.rs".to_string()]);
+}
+
+#[test]
+fn stacked_child_merges_after_its_parent_even_when_it_is_docs_only() {
+    let mut f = facts(vec![pr(1, &["lib.rs"]), pr(2, &["docs/x.md"])]);
+    f.before.insert(2, [1].into_iter().collect());
+    let p = run(&f, &Fake::default());
+    assert_eq!(p.wave1, vec![1, 2]);
+    assert_eq!(p.stacked.get(&2), Some(&vec![1]));
+}
+
+#[test]
+fn child_of_a_deferred_parent_is_deferred_too() {
+    let mut f = facts(vec![pr(1, &["a.rs"]), pr(2, &["b.rs"])]);
+    f.before.insert(2, [1].into_iter().collect());
+    let fake = Fake { base: BTreeMap::from([(1, vec!["x.rs".to_string()])]), ..Fake::default() };
+    let p = run(&f, &fake);
+    assert!(p.wave1.is_empty());
+    let numbers: Vec<u32> = p.wave2.iter().map(|w| w.number).collect();
+    assert_eq!(numbers, vec![1, 2]);
+    assert_eq!(p.wave2[0].kind, Kind::ByHand);
+    assert_eq!(p.wave2[1].why, "its parent #1 is not in wave 1");
+}
+
+#[test]
+fn shared_history_puts_the_side_with_fewer_own_commits_first() {
+    let mut f = facts(vec![pr(5, &["a.rs"]), pr(6, &["b.rs"])]);
+    f.shared.insert((5, 6), (3, 1));
+    let p = run(&f, &Fake::default());
+    assert_eq!(p.wave1, vec![6, 5]);
+}
+
+#[test]
+fn three_way_clash_defers_the_merge_and_its_child() {
+    let mut f = facts(vec![pr(1, &["a.rs"]), pr(2, &["b.rs"]), pr(3, &["c.rs"]), pr(4, &["d.rs"])]);
+    f.before.insert(4, [3].into_iter().collect());
+    let fake = Fake { triple: Some((1, 2, 3, vec!["m.rs".to_string()])), ..Fake::default() };
+    let p = run(&f, &fake);
+    assert_eq!(p.wave1, vec![1, 2]);
+    let numbers: Vec<u32> = p.wave2.iter().map(|w| w.number).collect();
+    assert_eq!(numbers, vec![3, 4]);
+    assert_eq!(p.wave2[0].kind, Kind::ByHand);
+    assert_eq!(p.wave2[1].kind, Kind::CleanAfterWave1);
+    assert_eq!(p.wave2[1].why, "its parent #3 is not in wave 1");
+}
+
+#[test]
+fn render_names_both_waves() {
+    let f = facts(vec![pr(1, &["a.rs"]), pr(2, &["b.rs"])]);
+    let fake = Fake { base: BTreeMap::from([(2, vec!["b.rs".to_string()])]), ..Fake::default() };
+    let text = merge_plan::render(&run(&f, &fake));
+    assert!(text.contains("WAVE 1"));
+    assert!(text.contains("#1  PR 1"));
+    assert!(text.contains("WAVE 2"));
+    assert!(text.contains("[clean after wave 1] conflicts with main now"));
+}
+
+fn merge_of_main(sha: &str, files: &[&str]) -> Commit {
+    Commit {
+        sha: sha.into(),
+        subject: "Merge main".into(),
+        parents: vec!["p1".into(), "p2".into()],
+        second_is_base: true,
+        remerge_files: files.iter().map(|f| f.to_string()).collect(),
+    }
+}
+
+#[test]
+fn delta_same_head_and_rewritten_history() {
+    assert_eq!(merge_delta::classify("h", "h", true, "main", &[]).verdict, Verdict::Unchanged);
+    assert_eq!(merge_delta::classify("h", "r", false, "main", &[]).verdict, Verdict::Rewritten);
+}
+
+#[test]
+fn delta_clean_merges_of_main_keep_the_review() {
+    let d = merge_delta::classify("h", "r", true, "main", &[merge_of_main("c1", &[])]);
+    assert_eq!(d.verdict, Verdict::Same);
+    assert_eq!(d.notes, vec!["c1 merge of main, no hand edits".to_string()]);
+}
+
+#[test]
+fn delta_hand_edits_in_settled_files_are_mechanical() {
+    let d = merge_delta::classify("h", "r", true, "main", &[merge_of_main("c1", &["CHANGELOG.md"])]);
+    assert_eq!(d.verdict, Verdict::Mechanical);
+    assert_eq!(d.notes, vec!["c1 merge of main, hand edits only in: CHANGELOG.md".to_string()]);
+}
+
+#[test]
+fn delta_hand_resolved_code_is_a_delta_review_and_new_code_beats_it() {
+    let d = merge_delta::classify("h", "r", true, "main", &[merge_of_main("c1", &["src/a.rs"])]);
+    assert_eq!(d.verdict, Verdict::Delta);
+    let plain = Commit { sha: "c2".into(), subject: "fix".into(), parents: vec!["p1".into()], second_is_base: false, remerge_files: vec![] };
+    let d = merge_delta::classify("h", "r", true, "main", &[merge_of_main("c1", &["src/a.rs"]), plain]);
+    assert_eq!(d.verdict, Verdict::NewCode);
+    assert_eq!(d.notes[1], "c2 commit: fix");
+}
+
+#[test]
+fn delta_merge_of_another_branch_is_new_code() {
+    let other = Commit { second_is_base: false, ..merge_of_main("c1", &[]) };
+    let d = merge_delta::classify("h", "r", true, "main", &[other]);
+    assert_eq!(d.verdict, Verdict::NewCode);
+    assert!(d.notes[0].starts_with("c1 merges a branch that is not main (p2): "));
+}
+
+#[test]
+fn delta_render_starts_with_the_label() {
+    let d = merge_delta::classify("h", "h", true, "main", &[]);
+    assert!(merge_delta::render(&d).starts_with("SAME: the head is the reviewed head"));
+}

