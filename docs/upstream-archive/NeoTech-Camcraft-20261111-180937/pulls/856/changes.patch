+++ b/crates/app/tests/tool_cutter_profile.rs
@@ -0,0 +1,226 @@
+//! #93 slice 2 acceptance: a milling tool's own cutter, neck and shank
+//! drawn as a spun outline lands through one undoable command
+//! (`SetToolCutter`), is refused by name when it disagrees with the
+//! tool's numbers, never moves an operation's stamp (display only),
+//! survives delete/undo, saves and loads (an older file loads with no
+//! drawn cutter), holds a number edit that would break it, and is
+//! driven the same way over MCP.
+//!
+//! Gate map (M4.4): covers app::commands::tool_cutter, app::tool_cutter, app::project, app::mcp::cutter_tools, app::schema.
+
+use camcraft_app::commands::{AddTool, ChangeTool, CommandError, CreateOperation, DeleteTool, GenerateOperation, History, SetStock, SetToolCutter};
+use camcraft_app::mcp::Server;
+use camcraft_app::model;
+use camcraft_app::operation::{self, Height, OpParams, SrcRef};
+use camcraft_app::project;
+use camcraft_app::schema::Location;
+use camcraft_app::spun::SpunPoint;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tool_cutter;
+use camcraft_app::tools::{catalog, Tool, ToolKind};
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+use serde_json::{json, Value};
+
+const TOOL: &str = "EM-1000-4FL";
+
+fn catalog_tool(name: &str) -> Tool {
+    catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog entry")
+}
+
+fn pt(z: f64, r: f64) -> SpunPoint {
+    SpunPoint::line(z, r)
+}
+
+/// EM-1000-4FL (Ø10 x 22 flutes, Ø10 x 40 shank) with a Ø8 neck drawn
+/// from 22 to 30 and a convex radius into the shank.
+fn necked() -> Vec<SpunPoint> {
+    vec![pt(0.0, 0.0), pt(0.0, 5.0), pt(22.0, 5.0), pt(22.0, 4.0), SpunPoint { z: 30.0, r: 4.0, arc: 0.0 }, pt(30.0, 5.0), pt(62.0, 5.0), pt(62.0, 0.0)]
+}
+
+fn world_with_op() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location::default()).expect("stock"));
+    history.execute(&world, AddTool::new(&world, TOOL, catalog_tool(TOOL)).expect("tool"));
+    let face = OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(25.0),
+        cut_z: Height::fixed(19.5),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    };
+    history.execute(&world, CreateOperation::new(&world, "Face1", TOOL, SrcRef::Stock, face).expect("face op"));
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    (world, history)
+}
+
+fn drawn(world: &World) -> Option<usize> {
+    model::find_by_name(world, TOOL).and_then(|e| tool_cutter::cutter_of(world, &e)).map(|s| s.points().len())
+}
+
+fn stamp(world: &World) -> Option<u64> {
+    let op = model::operation_of(world, &model::find_by_name(world, "Face1").expect("Face1")).expect("an op");
+    operation::current_stamp(world, &op.tool, &op.src, &op.params, "Face1", op.setup.as_deref()).map(|g| g.0)
+}
+
+fn refusal(r: Result<SetToolCutter, CommandError>) -> String {
+    match r {
+        Err(CommandError::Invalid(m)) => m,
+        Err(e) => panic!("wrong refusal {e}"),
+        Ok(_) => panic!("accepted an outline that should be refused"),
+    }
+}
+
+#[test]
+fn a_drawn_cutter_lands_undoes_and_moves_no_stamp() {
+    let (world, mut history) = world_with_op();
+    let before = stamp(&world);
+    assert!(before.is_some());
+    history.execute(&world, SetToolCutter::new(&world, TOOL, Some(necked())).expect("drawn"));
+    assert_eq!(drawn(&world), Some(8));
+    assert_eq!(stamp(&world), before, "a drawn cutter is display only: no operation goes stale");
+    let mut plain = necked();
+    plain.drain(3..5);
+    history.execute(&world, SetToolCutter::new(&world, TOOL, Some(plain)).expect("plain"));
+    assert_eq!(drawn(&world), Some(6));
+    history.execute(&world, SetToolCutter::new(&world, TOOL, None).expect("clear"));
+    assert_eq!(drawn(&world), None);
+    assert!(history.undo(&world));
+    assert_eq!(drawn(&world), Some(6));
+    assert!(history.undo(&world));
+    assert_eq!(drawn(&world), Some(8));
+    assert!(history.undo(&world));
+    assert_eq!(drawn(&world), None);
+    assert!(history.redo(&world));
+    assert_eq!(drawn(&world), Some(8));
+}
+
+#[test]
+fn a_cutter_that_disagrees_with_the_numbers_is_refused_by_name() {
+    let (world, _history) = world_with_op();
+    let set = |pts: Vec<SpunPoint>| refusal(SetToolCutter::new(&world, TOOL, Some(pts)));
+    assert!(set(Vec::new()).contains("cutter profile: the profile needs at least 3 points"));
+    let mut wide = necked();
+    wide[1].r = 6.0;
+    wide[2].r = 6.0;
+    let m = set(wide);
+    assert!(m.starts_with(&format!("tool '{TOOL}': cutter profile:")) && m.contains("Ø 12.000") && m.contains("Ø 10.000"), "{m}");
+    let mut long = necked();
+    long[6].z = 70.0;
+    long[7].z = 70.0;
+    assert!(set(long).contains("flute + shank = 62.000"));
+    let mut neg = necked();
+    neg[3].r = -1.0;
+    assert!(set(neg).contains("point 4 has a negative radius"));
+    let mut nan = necked();
+    nan[5].r = f64::INFINITY;
+    assert!(set(nan).contains("point 6 is not a finite number"));
+    let fold = vec![pt(0.0, 0.0), pt(0.0, 5.0), pt(22.0, 5.0), pt(22.0, 4.0), pt(22.0, 4.5), pt(62.0, 4.5), pt(62.0, 0.0)];
+    assert!(set(fold).contains("folds back over itself at point 4"));
+    let mut collar = necked();
+    collar[5].r = 7.0;
+    collar[6].r = 7.0;
+    assert!(set(collar).contains("point 6 is wider"));
+    assert!(matches!(SetToolCutter::new(&world, "nope", Some(necked())), Err(CommandError::NotFound(_))));
+    // Turning tools are not spun profiles (owner, #93).
+    let (lname, lathe) = catalog().into_iter().find(|(_, t)| t.kind == ToolKind::Turning).expect("an insert");
+    let mut h = History::default();
+    h.execute(&world, AddTool::new(&world, lname, lathe).expect("insert"));
+    assert!(refusal(SetToolCutter::new(&world, lname, Some(necked()))).contains("turning tool"));
+}
+
+#[test]
+fn a_number_edit_that_breaks_the_drawn_cutter_is_refused_and_delete_restores_it() {
+    let (world, mut history) = world_with_op();
+    history.execute(&world, SetToolCutter::new(&world, TOOL, Some(necked())).expect("drawn"));
+    let fatter = Tool { diameter: 12.0, ..catalog_tool(TOOL) };
+    match ChangeTool::new(&world, TOOL, fatter.clone()) {
+        Err(CommandError::Invalid(m)) => assert!(m.contains("drawn cutter profile no longer fits") && m.contains("Parametric"), "{m}"),
+        _ => panic!("a diameter edit under a drawn Ø10 cutter must be refused"),
+    }
+    // A number the outline does not state (the rpm) edits freely.
+    history.execute(&world, ChangeTool::new(&world, TOOL, Tool { rpm: 5000.0, ..catalog_tool(TOOL) }).expect("rpm edit"));
+    // Cleared, the same edit goes through.
+    history.execute(&world, SetToolCutter::new(&world, TOOL, None).expect("clear"));
+    history.execute(&world, ChangeTool::new(&world, TOOL, fatter).expect("now free"));
+    history.undo(&world);
+    history.undo(&world);
+    assert_eq!(drawn(&world), Some(8));
+    // DeleteTool snapshots the drawn cutter with the tool.
+    history.execute(&world, camcraft_app::commands::DeleteOperation::new(&world, "Face1").expect("op gone"));
+    history.execute(&world, DeleteTool::new(&world, TOOL).expect("delete"));
+    assert_eq!(drawn(&world), None);
+    assert!(history.undo(&world));
+    assert_eq!(drawn(&world), Some(8));
+}
+
+#[test]
+fn the_drawn_cutter_round_trips_and_older_files_load_without_one() {
+    let (world, mut history) = world_with_op();
+    let path = std::env::temp_dir().join(format!("camcraft_cutter_{}.camproj", std::process::id()));
+    project::save(&world, &path).expect("save plain");
+    let plain = std::fs::read_to_string(&path).expect("read");
+    assert!(!plain.contains("\"cutter\""), "no drawn cutter writes no key: an older file's bytes");
+    history.execute(&world, SetToolCutter::new(&world, TOOL, Some(necked())).expect("drawn"));
+    project::save(&world, &path).expect("save");
+    let first = std::fs::read_to_string(&path).expect("read");
+    let world2 = new_world();
+    project::load(&world2, &path).expect("load");
+    project::save(&world2, &path).expect("resave");
+    let second = std::fs::read_to_string(&path).expect("reread");
+    let _ = std::fs::remove_file(&path);
+    assert!(first.contains("\"cutter\""));
+    assert_eq!(first, second, "save-load-save is byte-identical");
+    assert_eq!(drawn(&world2), Some(8));
+    // An older file (no key) loads with the outline its numbers draw.
+    let world3 = new_world();
+    project::open(&world3, &plain).expect("older file");
+    assert_eq!(drawn(&world3), None);
+    // A file whose drawn cutter disagrees with its tool is refused by name.
+    let mut v: Value = serde_json::from_str(&first).expect("json");
+    for e in v["entities"].as_array_mut().expect("entities") {
+        if let Some(t) = e.get_mut("tool").and_then(Value::as_object_mut)
+            && t.contains_key("cutter")
+        {
+            t.insert("diameter".into(), json!(12.0));
+        }
+    }
+    let err = project::open(&new_world(), &serde_json::to_string(&v).expect("json")).expect_err("disagreeing cutter");
+    assert!(err.to_string().contains("cutter profile"), "{err}");
+}
+
+#[test]
+fn the_cutter_is_drawn_and_undone_over_mcp() {
+    let mut server = Server::new();
+    let mut id = 0;
+    let mut call = |name: &str, args: Value| {
+        id += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": "tools/call", "params": { "name": name, "arguments": args } });
+        let reply = server.handle(&msg).expect("a response");
+        let r = reply["result"].clone();
+        if r["isError"] == json!(true) { Err(r["content"][0]["text"].as_str().unwrap_or_default().to_owned()) } else { Ok(r["structuredContent"].clone()) }
+    };
+    call("add_tool", json!({ "catalog": TOOL })).expect("add tool");
+    let got = call("get_tool_cutter_profile", json!({ "tool": TOOL })).expect("get");
+    assert_eq!(got["drawn"], json!(false));
+    assert_eq!(got["points"][0], json!([0.0, 0.0, 0.0]));
+    let pts: Vec<Value> = necked().iter().map(|p| json!([p.z, p.r, p.arc])).collect();
+    let set = call("set_tool_cutter_profile", json!({ "tool": TOOL, "points": pts })).expect("set");
+    assert_eq!(set["drawn"], json!(true));
+    assert_eq!(set["points"].as_array().map(Vec::len), Some(8));
+    let err = call("set_tool_cutter_profile", json!({ "tool": TOOL, "points": [[0.0, 0.0], [0.0, 7.0], [62.0, 7.0], [62.0, 0.0]] })).expect_err("too wide");
+    assert!(err.contains("cutter profile") && err.contains("Ø 14.000"), "{err}");
+    assert!(call("set_tool_cutter_profile", json!({ "tool": TOOL, "points": [[0.0, "x"]] })).expect_err("junk").contains("point 1 must be"));
+    call("undo", json!({})).expect("undo");
+    assert_eq!(call("get_tool_cutter_profile", json!({ "tool": TOOL })).expect("get")["drawn"], json!(false));
+    call("redo", json!({})).expect("redo");
+    let cleared = call("set_tool_cutter_profile", json!({ "tool": TOOL, "points": null })).expect("clear");
+    assert_eq!(cleared["drawn"], json!(false));
+}
diff --git a/crates/tools/src/cutter_profile.rs b/crates/tools/src/cutter_profile.rs
new file mode 100644
index 00000000..01e655e0
--- /dev/null
+++ b/crates/tools/src/cutter_profile.rs
@@ -0,0 +1,155 @@
+//! A milling tool's own drawn shape (#93, slice 2): the cutter, neck and
+//! shank as a spun half-outline (`spun::SpunProfile`), checked against
+//! the numbers the generators and the gouge and stack laws read. The
+//! numbers stay the truth: a drawn outline that states another cutting
+//! diameter, flute length or stickout, draws a shank wider than the
+//! laws judge, or folds back over itself is refused by name - so a drawn
+//! cutter can never change what a toolpath or a check computes. Our own
+//! design over elementary plane geometry; no vendor source consulted.
+
+use crate::spun::{SpunError, SpunPoint, SpunProfile};
+use crate::tools::{Tool, ToolKind};
+
+/// Agreement slack (mm) between a drawn outline and the tool's numbers:
+/// a typed value, not float dust - a 0.01 mm difference is a different
+/// tool and is refused.
+pub const AGREE: f64 = 1e-3;
+
+/// Why a drawn cutter outline is refused.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum CutterError {
+    /// The outline itself is no spun profile.
+    Shape(SpunError),
+    /// A turning tool: not a spun profile (owner, #93).
+    Lathe,
+    /// The outline starts above the tool tip (first point z > 0).
+    OffTip(f64),
+    /// The widest point within the flutes is not the stated diameter.
+    Diameter { drawn: f64, stated: f64 },
+    /// The outline ends at another height than flute plus shank length.
+    Length { drawn: f64, stated: f64 },
+    /// At the flute top wider than cutter and shank, or above it wider
+    /// than the shank the laws judge (point number, 1-based).
+    TooWide { point: usize, limit: f64 },
+    /// Two flat steps at one height run out and back over each other
+    /// (point number, 1-based): the outline crosses itself.
+    Folds(usize),
+}
+
+impl core::fmt::Display for CutterError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match *self {
+            Self::Shape(e) => write!(f, "{e}"),
+            Self::Lathe => write!(f, "a turning tool is not a spun profile - it keeps its own editor"),
+            Self::OffTip(z) => write!(f, "the outline must start at the tool tip (z = 0), not z = {z:.3} mm"),
+            Self::Diameter { drawn, stated } => write!(
+                f,
+                "the drawn cutter is Ø {drawn:.3} mm within the flutes, the tool states Ø {stated:.3} mm"
+            ),
+            Self::Length { drawn, stated } => write!(
+                f,
+                "the drawn outline ends {drawn:.3} mm above the tip, the tool states flute + shank = {stated:.3} mm"
+            ),
+            Self::TooWide { point, limit } => write!(
+                f,
+                "point {point} is wider than the shank the tool states (r ≤ {limit:.3} mm there) - the checks judge the stated shank"
+            ),
+            Self::Folds(i) => write!(f, "the outline folds back over itself at point {i}"),
+        }
+    }
+}
+
+impl std::error::Error for CutterError {}
+
+/// Validate `points` as `tool`'s drawn cutter: a spun profile (every
+/// `SpunProfile::new` refusal), on a milling tool, from the tip
+/// (z = 0) to the shank top (flute + shank length), reaching exactly the
+/// stated diameter within the flute length, never wider above it than
+/// the stated shank, and not folding over itself.
+pub fn check(tool: &Tool, points: Vec<SpunPoint>) -> Result<SpunProfile, CutterError> {
+    if is_lathe(tool.kind) {
+        return Err(CutterError::Lathe);
+    }
+    if let Some(i) = fold_at(&points) {
+        return Err(CutterError::Folds(i));
+    }
+    let spun = SpunProfile::new(points).map_err(CutterError::Shape)?;
+    agrees(tool, &spun)?;
+    Ok(spun)
+}
+
+/// Does a validated outline still agree with `tool`'s numbers? The
+/// stored cutter is re-judged by this after every number edit.
+pub fn agrees(tool: &Tool, spun: &SpunProfile) -> Result<(), CutterError> {
+    if is_lathe(tool.kind) {
+        return Err(CutterError::Lathe);
+    }
+    let pts = spun.points();
+    let foot = pts.first().map_or(0.0, |p| p.z);
+    if foot > AGREE {
+        return Err(CutterError::OffTip(foot));
+    }
+    let zc = tool.flute_len.max(0.0);
+    let stated_len = zc + tool.shank_len.max(0.0);
+    let top = pts.last().map_or(0.0, |p| p.z);
+    if (top - stated_len).abs() > AGREE {
+        return Err(CutterError::Length { drawn: top, stated: stated_len });
+    }
+    let out = spun.outline();
+    let r = tool.diameter.max(0.0) * 0.5;
+    // Below the flute top every radius counts; AT it, the step out to a
+    // wider shank is the shank's (judged by the width law below), so
+    // only radii up to the cutter's own count there.
+    let in_flutes = out
+        .iter()
+        .filter(|q| q.0 < zc - AGREE || (q.0 <= zc + AGREE && q.1 <= r + AGREE))
+        .fold(0.0f64, |m, q| m.max(q.1));
+    if (in_flutes - r).abs() > AGREE {
+        return Err(CutterError::Diameter { drawn: 2.0 * in_flutes, stated: tool.diameter });
+    }
+    // Above the flute top the laws judge the stated shank (`shank_d`), so
+    // nothing drawn there may be wider; AT the flute top the step runs
+    // between cutter and shank, so the larger of the two bounds it.
+    let sr = tool.shank_d.max(0.0) * 0.5;
+    let limit_at = |z: f64| if z > zc + AGREE { sr } else { r.max(sr) };
+    let over = |z: f64, rr: f64| z >= zc - AGREE && rr > limit_at(z) + AGREE;
+    // Checked on the drawn points (named in the refusal) and on the
+    // flattened outline (a convex arc between two in-limit points).
+    if let Some((i, p)) = pts.iter().enumerate().find(|(_, p)| over(p.z, p.r)) {
+        return Err(CutterError::TooWide { point: i + 1, limit: limit_at(p.z) });
+    }
+    if let Some(q) = out.iter().find(|q| over(q.0, q.1)) {
+        let i = pts.iter().rposition(|p| p.z <= q.0).map_or(1, |i| i + 1);
+        return Err(CutterError::TooWide { point: i, limit: limit_at(q.0) });
+    }
+    Ok(())
+}
+
+/// The cutter as `tool`'s numbers draw it (`SpunProfile::cutter_of`,
+/// tip to shank top) as editable points, near-duplicates (closer than
+/// `spun::MIN_SEGMENT`, e.g. a chamfer cone meeting the diameter at the
+/// flute top) merged. Empty for a turning tool.
+#[must_use]
+pub fn parametric(tool: &Tool) -> Vec<SpunPoint> {
+    let mut pts = SpunProfile::cutter_of(tool).map(|s| s.points().to_vec()).unwrap_or_default();
+    pts.dedup_by(|b, a| (a.z - b.z).hypot(a.r - b.r) < crate::spun::MIN_SEGMENT);
+    pts
+}
+
+/// The first point (1-based) where two consecutive flat steps at one
+/// height reverse direction - out and back over the same line.
+fn fold_at(points: &[SpunPoint]) -> Option<usize> {
+    points.windows(3).position(|w| {
+        let flat = |a: &SpunPoint, b: &SpunPoint| a.arc == 0.0 && (a.z - b.z).abs() <= 1e-9;
+        flat(&w[0], &w[1]) && flat(&w[1], &w[2]) && (w[1].r - w[0].r) * (w[2].r - w[1].r) < 0.0
+    })
+    .map(|i| i + 2)
+}
+
+fn is_lathe(k: ToolKind) -> bool {
+    matches!(k, ToolKind::Turning | ToolKind::Groove | ToolKind::Thread | ToolKind::Form)
+}
+
+#[cfg(test)]
+#[path = "cutter_profile_tests.rs"]
+mod tests;
diff --git a/crates/tools/src/cutter_profile_tests.rs b/crates/tools/src/cutter_profile_tests.rs
new file mode 100644
index 00000000..d9806277
--- /dev/null
+++ b/crates/tools/src/cutter_profile_tests.rs
@@ -0,0 +1,93 @@
+//! Unit tests of the drawn cutter law (#93 slice 2): every catalog
+//! milling tool's own numbers pass it, turning tools never do, and a
+//! drawn outline that disagrees with the numbers is refused by name.
+
+use super::*;
+use crate::tools::catalog;
+
+fn p(z: f64, r: f64) -> SpunPoint {
+    SpunPoint::line(z, r)
+}
+
+fn em10() -> Tool {
+    catalog().into_iter().find(|(n, _)| *n == "EM-1000-4FL").map(|(_, t)| t).unwrap()
+}
+
+/// EM-1000-4FL drawn by hand with a neck: Ø10 x 22 flutes, a Ø8 neck
+/// from 22 to 30, the Ø10 shank to 62 (22 + 40).
+fn necked() -> Vec<SpunPoint> {
+    vec![p(0.0, 0.0), p(0.0, 5.0), p(22.0, 5.0), p(22.0, 4.0), p(30.0, 4.0), p(30.0, 5.0), p(62.0, 5.0), p(62.0, 0.0)]
+}
+
+#[test]
+fn every_milling_catalog_tool_passes_its_own_cutter_law() {
+    for (name, t) in catalog() {
+        let pts = parametric(&t);
+        if is_lathe(t.kind) {
+            assert!(pts.is_empty(), "{name}: a turning tool has no spun cutter");
+            assert_eq!(check(&t, necked()), Err(CutterError::Lathe), "{name}");
+            continue;
+        }
+        let s = check(&t, pts).unwrap_or_else(|e| panic!("{name}: {e}"));
+        assert!((s.max_radius() - (t.diameter * 0.5).max(t.shank_d * 0.5)).abs() < 1e-9, "{name}");
+    }
+}
+
+#[test]
+fn a_hand_drawn_neck_that_keeps_the_numbers_is_accepted() {
+    let s = check(&em10(), necked()).unwrap();
+    assert_eq!(s.points().len(), 8);
+}
+
+#[test]
+fn a_cutter_that_disagrees_with_the_numbers_is_refused_by_name() {
+    let t = em10();
+    let refuse = |pts: Vec<SpunPoint>| check(&t, pts).unwrap_err();
+    // Ø 12 within the flutes, against a stated Ø 10.
+    let mut wide = necked();
+    wide[1].r = 6.0;
+    wide[2].r = 6.0;
+    assert_eq!(refuse(wide), CutterError::Diameter { drawn: 12.0, stated: 10.0 });
+    // Never reaching the stated diameter is as wrong as passing it.
+    let mut thin = necked();
+    thin[1].r = 4.5;
+    thin[2].r = 4.5;
+    assert!(matches!(refuse(thin), CutterError::Diameter { .. }));
+    // Too short / too long against flute + shank = 62.
+    let mut short = necked();
+    short[6].z = 50.0;
+    short[7].z = 50.0;
+    assert_eq!(refuse(short), CutterError::Length { drawn: 50.0, stated: 62.0 });
+    // Starts above the tip.
+    let mut lifted = necked();
+    lifted[0].z = 1.0;
+    lifted[1].z = 1.0;
+    assert_eq!(refuse(lifted), CutterError::OffTip(1.0));
+    // A collar wider than shank and cutter above the flutes.
+    let mut collar = necked();
+    collar[5].r = 7.0;
+    collar[6].r = 7.0;
+    assert_eq!(refuse(collar), CutterError::TooWide { point: 6, limit: 5.0 });
+    // Out and back at one height: the outline crosses itself.
+    let fold = vec![p(0.0, 0.0), p(0.0, 5.0), p(22.0, 5.0), p(22.0, 4.0), p(22.0, 4.5), p(62.0, 4.5), p(62.0, 0.0)];
+    assert_eq!(refuse(fold), CutterError::Folds(4));
+    // Every spun refusal rides through by name.
+    let mut neg = necked();
+    neg[3].r = -1.0;
+    assert_eq!(refuse(neg), CutterError::Shape(SpunError::Negative(4)));
+    let mut nan = necked();
+    nan[2].z = f64::NAN;
+    assert_eq!(refuse(nan), CutterError::Shape(SpunError::NonFinite(3)));
+    assert_eq!(refuse(Vec::new()), CutterError::Shape(SpunError::TooFew));
+    assert!(refuse(necked()[..2].to_vec()).to_string().contains("at least 3 points"));
+}
+
+#[test]
+fn a_number_edit_is_re_judged_against_the_stored_cutter() {
+    let s = check(&em10(), necked()).unwrap();
+    let t = Tool { diameter: 12.0, ..em10() };
+    assert!(matches!(agrees(&t, &s), Err(CutterError::Diameter { .. })));
+    let t = Tool { shank_len: 50.0, ..em10() };
+    assert!(matches!(agrees(&t, &s), Err(CutterError::Length { .. })));
+    assert_eq!(agrees(&em10(), &s), Ok(()));
+}
