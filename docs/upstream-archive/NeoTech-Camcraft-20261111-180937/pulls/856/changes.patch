+/// A drawn outline on file: `[z, r, arc]` per point, tip-up.
+#[must_use]
+pub fn spun_to_dto(s: &SpunProfile) -> Vec<[f64; 3]> {
+    s.points().iter().map(|p| [p.z, p.r, p.arc]).collect()
