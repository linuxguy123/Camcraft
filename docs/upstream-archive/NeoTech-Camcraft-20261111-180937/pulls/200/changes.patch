+                let chord_tol = (f.cell() * 0.25).max(1e-9);
+                let tool = SdfTool::Lathe { profile: *profile, axis: *axis };
+                for chunk in moves.chunks(super::field_batch::BATCH_MOVES) {
+                    f.subtract_batch(chunk, &tool, chord_tol)?;
+                }
+                Ok(())
+            }
+        }
+    }
+}
