diff --git a/crates/ui/build.rs b/crates/ui/build.rs
new file mode 100644
index 00000000..9f3ed8af
--- /dev/null
+++ b/crates/ui/build.rs
@@ -0,0 +1,61 @@
+use chrono::{DateTime, Utc};
+use std::process::Command;
+
+fn git(args: &[&str]) -> Option<String> {
+    let output = Command::new("git").args(args).output().ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    Some(String::from_utf8(output.stdout).ok()?.trim().to_owned())
+}
+
+fn valid_sha(value: &str) -> bool {
+    (value.len() == 40 || value.len() == 64) && value.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-changed=Cargo.toml");
+    println!("cargo:rerun-if-changed=src");
+    println!("cargo:rerun-if-env-changed=CAMCRAFT_SOURCE_SHA");
+    println!("cargo:rerun-if-env-changed=SOURCE_DATE_EPOCH");
+
+    // A source archive has no .git directory. Its packager can provide the
+    // exact source commit; an ordinary checkout reads its own HEAD.
+    let sha = std::env::var("CAMCRAFT_SOURCE_SHA")
+        .ok()
+        .filter(|s| valid_sha(s))
+        .or_else(|| {
+            git(&["rev-parse", "HEAD"])
+                .filter(|s| valid_sha(s))
+                .map(|sha| {
+                    if git(&["status", "--porcelain"]).is_some_and(|s| !s.is_empty()) {
+                        format!("{sha}-dirty")
+                    } else {
+                        sha
+                    }
+                })
+        })
+        .unwrap_or_else(|| "Custom Build".to_owned());
+    println!("cargo:rustc-env=CAMCRAFT_SOURCE_SHA={sha}");
+
+    // SOURCE_DATE_EPOCH makes reproducible package builds possible; otherwise
+    // this records when the UI crate was actually compiled, in UTC.
+    let built = std::env::var("SOURCE_DATE_EPOCH")
+        .ok()
+        .and_then(|s| s.parse::<i64>().ok())
+        .and_then(|secs| DateTime::<Utc>::from_timestamp(secs, 0))
+        .unwrap_or_else(Utc::now);
+    println!("cargo:rustc-env=CAMCRAFT_BUILD_UTC={}", built.format("%Y-%m-%d %H:%M UTC"));
+
+    // A branch tip can change while its source files do not. Watch Git's
+    // HEAD and current ref so the embedded ID follows the checked-out tree.
+    if let Some(head) = git(&["rev-parse", "--git-path", "HEAD"]) {
+        println!("cargo:rerun-if-changed={head}");
+    }
+    if let Some(reference) = git(&["symbolic-ref", "HEAD"])
+        && let Some(path) = git(&["rev-parse", "--git-path", &reference])
+    {
+        println!("cargo:rerun-if-changed={path}");
+    }
+}
diff --git a/crates/ui/src/build_info.rs b/crates/ui/src/build_info.rs
new file mode 100644
index 00000000..38dcca43
--- /dev/null
+++ b/crates/ui/src/build_info.rs
@@ -0,0 +1,35 @@
+//! Identification embedded when the UI crate is compiled.
+
+pub(crate) const VERSION: &str = env!("CARGO_PKG_VERSION");
+pub(crate) const BUILT_UTC: &str = env!("CAMCRAFT_BUILD_UTC");
+pub(crate) const SOURCE_SHA: &str = env!("CAMCRAFT_SOURCE_SHA");
+
+#[cfg(test)]
+const TOOLBAR_BUILD_UTC: &str = "2000-01-01 00:00 UTC";
+#[cfg(not(test))]
+const TOOLBAR_BUILD_UTC: &str = BUILT_UTC;
+
+#[cfg(not(test))]
+pub(crate) fn short_source() -> String {
+    if SOURCE_SHA == "Custom Build" {
+        SOURCE_SHA.to_owned()
+    } else {
+        let modified = if SOURCE_SHA.ends_with("-dirty") { "*" } else { "" };
+        format!("{}{modified}", &SOURCE_SHA[..8])
+    }
+}
+
+#[cfg(test)]
+pub(crate) fn short_source() -> String {
+    "test".to_owned()
+}
+
+pub(crate) fn toolbar_lines(compact: bool) -> (String, String) {
+    let top = format!("v{VERSION} · {}", short_source());
+    let bottom = if compact {
+        format!("{} UTC", TOOLBAR_BUILD_UTC.get(5..16).unwrap_or(TOOLBAR_BUILD_UTC))
+    } else {
+        format!("Built {TOOLBAR_BUILD_UTC}")
+    };
+    (top, bottom)
+}
