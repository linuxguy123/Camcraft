+    let world = doc(m, 3.0 * IN, None);
+    let lines: Vec<String> =
+        verification_gate(&world).into_iter().filter(|p| p.contains("states no axis vector")).collect();
+    assert_eq!(lines.len(), 1, "{:?}", verification_gate(&world));
