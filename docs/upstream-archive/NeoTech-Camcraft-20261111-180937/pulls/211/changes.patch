   startPreamble();
   var p = properties;
-  if (posed(p) || inCycle) return;
+  if (posed(p) || inCycle || inThread) return;
   var r = radiusOf(p.X, p.Y, "rapid");
   if (r === null) return;
   block(["G00", xWord(r), zWord(p.Z)]);
