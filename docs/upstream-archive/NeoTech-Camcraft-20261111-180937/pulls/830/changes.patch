diff --git a/crates/app/tests/accessory_collisions.rs b/crates/app/tests/accessory_collisions.rs
new file mode 100644
index 00000000..4a601f30
--- /dev/null
+++ b/crates/app/tests/accessory_collisions.rs
@@ -0,0 +1,170 @@
+//! Built-in accessories under the existing fixture laws (#789): a strap
+//! clamp's stud stands over the part, so a link laid low across it is
+//! struck and the link #489's routing lays (up to the clamp's box top
+//! plus its 5 mm gap, across, down) is clear - judged by the clamp's
+//! mesh, so a link over the strap beside the stud is clear too. Parallels
+//! fitted under the stock in a built-in vise lift the stock so its top
+//! stands the stated amount over the jaws: the face pass the jaws struck
+//! posts clean, and one undo puts the vise back.
+//!
+//! Gate map (M4.4): covers app::accessory, app::commands::accessory,
+//! app::fixture, app::fixture_struck, app::posting.
+
+use camcraft_app::accessory::Accessory;
+use camcraft_app::cl::{Move, MoveKind, Toolpath};
+use camcraft_app::commands::{
+    AccessoryPlacement, AddTool, CreateOperation, GenerateOperation, History, InsertAccessory, InsertVise, SetStock,
+    VisePlacement,
+};
+use camcraft_app::fixture;
+use camcraft_app::fixture_struck;
+use camcraft_app::fixture_view::{self, MeshState};
+use camcraft_app::geometry::{IDENTITY_Q, Point3};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::vise;
+use camcraft_app::world::new_world;
+
+const IN: f64 = 25.4;
+/// #489's routing gap over the highest box top under a link.
+const ROUTE_GAP: f64 = 5.0;
+
+/// 60 x 60 stock `dz` tall, a 4 mm end mill, a face pass `cut` high.
+fn face_world(dz: f64, cut: f64) -> (flecs_ecs::prelude::World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz }, Location::default()).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("catalog");
+    history.execute(&world, AddTool::new(&world, "EM-0400-2FL", tool).expect("tool"));
+    let params = OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(dz + 5.0),
+        cut_z: Height::fixed(cut),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    };
+    history.execute(&world, CreateOperation::new(&world, "Face1", "EM-0400-2FL", SrcRef::Stock, params).expect("op"));
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    (world, history)
+}
+
+/// The post gate's per-op fixture law on a hand-laid path, against the
+/// world's real steel (boxes, then meshes).
+fn hits(world: &flecs_ecs::prelude::World, moves: Vec<Move>) -> Vec<usize> {
+    let op = model::find_by_name(world, "Face1").and_then(|e| model::operation_of(world, &e)).expect("op");
+    let (turning, fixed) = fixture::workholding_for(world, None);
+    let meshes = fixture::meshes_for(world, None);
+    let path = Toolpath::new(moves);
+    let warnings = fixture_struck::op_hits(world, &op, &path, &turning, &fixed, &meshes).expect("judged");
+    fixture_struck::warned_moves(&warnings)
+}
+
+fn rapid(a: [f64; 3], b: [f64; 3]) -> Move {
+    Move::new(MoveKind::Rapid, Point3::new(a[0], a[1], a[2]), Point3::new(b[0], b[1], b[2]), None)
+}
+
+#[test]
+fn a_strap_clamp_stud_strikes_a_low_link_and_the_routed_link_clears_it() {
+    let (world, mut history) = face_world(20.0, 19.5);
+    // The toe on the stock's +x edge, clamping its 20 mm top face.
+    let clamp = Accessory::default_of("strap_clamp").expect("clamp").with_dim("clamp_height", 20.0).expect("dim");
+    let at = Location { pos: Point3::new(25.0, 0.0, 0.0), rot: IDENTITY_Q };
+    let cmd = InsertAccessory::new(&world, &clamp, None, AccessoryPlacement::At(at)).expect("placed");
+    let name = cmd.name().to_owned();
+    history.execute(&world, cmd);
+    assert_eq!(fixture_view::mesh_states(&world, None), [(name.clone(), MeshState::Mesh)], "judged by its mesh");
+
+    let e = model::find_by_name(&world, &name).expect("clamp");
+    let top = model::entity_world_aabb(&world, &e).expect("box").max.z;
+    let strap_top = 20.0 + 0.625 * IN;
+    let stud_x = 25.0 + 2.25 * IN;
+    assert!((top - (strap_top + 1.5 * IN)).abs() < 1e-9, "the stud stands 1.5 in over the strap: {top}");
+
+    // A link at z 50 - over the strap, under the stud's top - across the stud.
+    let low = 50.0;
+    assert!(low > strap_top + 5.0 && low < top - 5.0);
+    let link = vec![rapid([stud_x, -60.0, low], [stud_x, 60.0, low])];
+    assert_eq!(hits(&world, link), [0], "the stud strikes a low link across it");
+
+    // The same height over the strap beside the stud: the mesh acquits
+    // what the clamp's box (topped by the stud) convicts.
+    let beside = vec![rapid([40.0, -60.0, low], [40.0, 60.0, low])];
+    assert_eq!(hits(&world, beside), Vec::<usize>::new(), "only the stud stands that high");
+
+    // #489's re-laid link: up at its start, across over the box top plus
+    // the gap, down at its end.
+    let up = top + ROUTE_GAP;
+    let routed = vec![
+        rapid([stud_x, -60.0, low], [stud_x, -60.0, up]),
+        rapid([stud_x, -60.0, up], [stud_x, 60.0, up]),
+        rapid([stud_x, 60.0, up], [stud_x, 60.0, low]),
+    ];
+    assert_eq!(hits(&world, routed), Vec::<usize>::new(), "the routed link clears the stud");
+}
+
+#[test]
+fn parallels_fitted_under_the_stock_lift_it_over_the_jaws() {
+    let (world, mut history) = face_world(20.0, 19.5);
+    let six = vise::size("6 in").expect("6 in").half_open();
+    let cmd = InsertVise::new(&world, &six, None, VisePlacement::FitStock).expect("vise");
+    let vise_name = cmd.name().to_owned();
+    history.execute(&world, cmd);
+    assert!(posting::verification_gate(&world).iter().any(|p| p.contains("strikes a fixture")), "the jaws stand over the pass");
+
+    let above = 0.25 * IN;
+    let par = Accessory::default_of("parallels").expect("parallels");
+    let fit = AccessoryPlacement::UnderStockInVise { vise: vise_name.clone(), above };
+    let cmd = InsertAccessory::new(&world, &par, None, fit).expect("fits");
+    let name = cmd.name().to_owned();
+    let Some(Accessory::Parallels { height, thickness, spacing, .. }) = cmd.params().cloned() else {
+        panic!("parallels");
+    };
+    let want_h = 1.75 * IN + above - 20.0;
+    assert!((height - want_h).abs() < 1e-9, "height {height} vs {want_h}");
+    assert!((spacing + 2.0 * thickness - 60.0).abs() < 1e-9, "the pair spans the jaw opening");
+    history.execute(&world, cmd);
+
+    let v = model::find_by_name(&world, &vise_name).expect("vise");
+    let vb = model::entity_world_aabb(&world, &v).expect("vise box");
+    assert!((vb.max.z - (20.0 - above)).abs() < 1e-9, "the jaws stand {above} under the stock top: {}", vb.max.z);
+    let pb = model::entity_world_aabb(&world, &model::find_by_name(&world, &name).expect("parallels")).expect("box");
+    assert!(pb.max.z.abs() < 1e-9 && (pb.min.z + want_h).abs() < 1e-9, "on the floor, up to the stock: {pb:?}");
+    assert!((pb.min.y + 30.0).abs() < 1e-9 && (pb.max.y - 30.0).abs() < 1e-9, "against both jaws: {pb:?}");
+    let problems = posting::verification_gate(&world);
+    assert!(problems.is_empty(), "the pass now runs over the jaws: {problems:?}");
+
+    assert!(history.undo(&world));
+    assert!(model::find_by_name(&world, &name).is_none(), "one undo removes the parallels");
+    let vb = model::entity_world_aabb(&world, &v).expect("vise box");
+    assert!((vb.max.z - 1.75 * IN).abs() < 1e-9, "and puts the vise back: {}", vb.max.z);
+    assert!(history.redo(&world));
+    assert!(model::find_by_name(&world, &name).is_some());
+
+    // Refused by name: stock already standing that high, parallels too thick.
+    let low = AccessoryPlacement::UnderStockInVise { vise: vise_name.clone(), above: -1.0 };
+    assert!(InsertAccessory::new(&world, &par, None, low).is_err());
+    let (tall, mut h2) = face_world(60.0, 59.5);
+    let cmd = InsertVise::new(&tall, &six, None, VisePlacement::FitStock).expect("vise");
+    let tv = cmd.name().to_owned();
+    h2.execute(&tall, cmd);
+    let fit = AccessoryPlacement::UnderStockInVise { vise: tv.clone(), above: 1.0 };
+    let e = InsertAccessory::new(&tall, &par, None, fit).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("no parallels fit under it"), "{e}");
+    let thick = par.clone().with_dim("thickness", 31.0).expect("dim");
+    let fit = AccessoryPlacement::UnderStockInVise { vise: vise_name, above };
+    let e = InsertAccessory::new(&world, &thick, None, fit).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("do not fit in the vise's"), "{e}");
+    let fit = AccessoryPlacement::UnderStockInVise { vise: "Face1".into(), above };
+    let e = InsertAccessory::new(&world, &par, None, fit).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("not a built-in vise"), "{e}");
+}
diff --git a/crates/app/tests/builtin_accessory.rs b/crates/app/tests/builtin_accessory.rs
new file mode 100644
index 00000000..1673f223
--- /dev/null
+++ b/crates/app/tests/builtin_accessory.rs
@@ -0,0 +1,251 @@
+//! Built-in workholding accessories (#789): every kind builds closed,
+//! outward shells of its stated dimensions that the mesh law takes;
+//! nonsense parameters are refused by name; placing and resizing are one
+//! undo unit each; the parameters survive a save and load, and a file
+//! whose accessory key was edited into nonsense keeps plain steel.
+//!
+//! Gate map (M4.4): covers app::accessory, app::commands::accessory,
+//! app::commands::insert_fixture, app::project (fixture accessory key),
+//! app::fixture.
+
+use std::collections::HashMap;
+
+use camcraft_app::accessory::{self, Accessory, mesh};
+use camcraft_app::commands::{
+    AccessoryPlacement, History, ImportModel, InsertAccessory, SetAccessory, TagFixture,
+};
+use camcraft_app::fixture;
+use camcraft_app::geometry::{IDENTITY_Q, Mesh, Point3, Triangle};
+use camcraft_app::model;
+use camcraft_app::project;
+use camcraft_app::schema::Location;
+use camcraft_app::world::new_world;
+use camcraft_sim::fixture_mesh::FixtureMesh;
+
+const IN: f64 = 25.4;
+
+fn bounds(tris: &[Triangle]) -> ([f64; 3], [f64; 3]) {
+    let mut lo = [f64::MAX; 3];
+    let mut hi = [f64::MIN; 3];
+    for p in tris.iter().flat_map(|t| [t.a, t.b, t.c]) {
+        for (k, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+            lo[k] = lo[k].min(v);
+            hi[k] = hi[k].max(v);
+        }
+    }
+    (lo, hi)
+}
+
+fn key(p: Point3) -> [u64; 3] {
+    [p.x.to_bits(), p.y.to_bits(), p.z.to_bits()]
+}
+
+/// Closed and consistently oriented, the mesh law's 2-cycle: every
+/// directed edge is met by its reverse exactly as often (touching
+/// shells, like a heel block flush under the strap's end, share an edge
+/// once per shell).
+fn assert_watertight(tris: &[Triangle], what: &str) {
+    let mut edges: HashMap<([u64; 3], [u64; 3]), i32> = HashMap::new();
+    for t in tris {
+        for (a, b) in [(t.a, t.b), (t.b, t.c), (t.c, t.a)] {
+            *edges.entry((key(a), key(b))).or_default() += 1;
+        }
+    }
+    for ((a, b), n) in &edges {
+        assert_eq!(edges.get(&(*b, *a)), Some(n), "{what}: an edge with no matching reverse (open shell)");
+    }
+}
+
+fn volume(tris: &[Triangle]) -> f64 {
+    tris.iter()
+        .map(|t| {
+            let (a, b, c) = (t.a, t.b, t.c);
+            a.x * (b.y * c.z - b.z * c.y) - a.y * (b.x * c.z - b.z * c.x) + a.z * (b.x * c.y - b.y * c.x)
+        })
+        .sum::<f64>()
+        / 6.0
+}
+
+/// The polygon drawn around a stud: its area.
+fn stud_area(d: f64) -> f64 {
+    let n = mesh::STUD_SIDES as f64;
+    let r = mesh::stud_radius(d);
+    0.5 * n * r * r * (std::f64::consts::TAU / n).sin()
+}
+
+/// The solid's volume by its parts, and its bounds `(lo, hi)`.
+fn expected(a: &Accessory) -> (f64, [f64; 3], [f64; 3]) {
+    match *a {
+        Accessory::Parallels { height, thickness, length, spacing } => {
+            let y = 0.5 * spacing + thickness;
+            (2.0 * height * thickness * length, [-0.5 * length, -y, 0.0], [0.5 * length, y, height])
+        }
+        Accessory::Block { length, width, height } => {
+            (length * width * height, [-0.5 * length, -0.5 * width, 0.0], [0.5 * length, 0.5 * width, height])
+        }
+        Accessory::SoftJaw { width, height, thickness } => {
+            (width * height * thickness, [-0.5 * width, 0.0, 0.0], [0.5 * width, thickness, height])
+        }
+        Accessory::StepBlock { steps, rise, run, width } => {
+            let n = f64::from(steps);
+            (width * run * rise * n * (n + 1.0) / 2.0, [-0.5 * width, 0.0, 0.0], [0.5 * width, n * run, n * rise])
+        }
+        Accessory::StrapClamp {
+            strap_length: l,
+            strap_width: w,
+            strap_thickness: t,
+            stud_diameter: d,
+            stud_height: s,
+            heel_length: k,
+            clamp_height: h,
+            ..
+        } => {
+            let v = l * w * t + k * w * h + stud_area(d) * (h + s);
+            let hw = (0.5 * w).max(mesh::stud_radius(d));
+            (v, [0.0, -hw, 0.0], [l, hw, h + t + s])
+        }
+    }
+}
+
+fn check_solid(a: &Accessory, what: &str) {
+    let tris = a.mesh().unwrap_or_else(|e| panic!("{what}: {e}"));
+    assert_watertight(&tris, what);
+    let (want, lo_w, hi_w) = expected(a);
+    let v = volume(&tris);
+    assert!((v - want).abs() < 1e-9 * want.max(1.0), "{what}: outward volume {v} vs {want}");
+    let (lo, hi) = bounds(&tris);
+    for k in 0..3 {
+        assert!((lo[k] - lo_w[k]).abs() < 1e-9 && (hi[k] - hi_w[k]).abs() < 1e-9, "{what}: bounds {lo:?}..{hi:?}");
+    }
+    assert!(FixtureMesh::build(&tris).is_ok(), "{what}: the mesh law takes it");
+}
+
+#[test]
+fn every_kind_builds_closed_shells_of_its_dimensions() {
+    assert_eq!(accessory::KINDS, ["parallels", "block", "step_block", "strap_clamp", "soft_jaw"]);
+    for kind in accessory::KINDS {
+        let a = Accessory::default_of(kind).expect(kind);
+        assert_eq!(a.kind(), kind);
+        check_solid(&a, kind);
+    }
+    // The 1-2-3 block is 1 x 2 x 3 in, its holes drawn solid.
+    let block = Accessory::default_of("block").expect("block");
+    let (lo, hi) = bounds(&block.mesh().expect("mesh"));
+    let mut sides = [hi[0] - lo[0], hi[1] - lo[1], hi[2] - lo[2]];
+    sides.sort_by(f64::total_cmp);
+    for (s, want) in sides.iter().zip([IN, 2.0 * IN, 3.0 * IN]) {
+        assert!((s - want).abs() < 1e-9, "{sides:?}");
+    }
+    for steps in 1..=8 {
+        let mut a = Accessory::default_of("step_block").expect("steps");
+        *a.steps_mut().expect("a step block") = steps;
+        check_solid(&a, &format!("{steps} steps"));
+    }
+    let tall = Accessory::default_of("strap_clamp").expect("clamp").with_dim("stud_diameter", 40.0).expect("dim");
+    check_solid(&tall, "a stud wider than the strap");
+}
+
+#[test]
+fn nonsense_parameters_are_refused_by_name() {
+    let refused = |a: Accessory, word: &str| {
+        let e = a.mesh().expect_err(word);
+        assert!(e.contains(word), "'{e}' names {word}");
+    };
+    let par = Accessory::default_of("parallels").expect("parallels");
+    refused(par.clone().with_dim("height", 0.0).expect("dim"), "Parallels height must be more than zero");
+    refused(par.clone().with_dim("spacing", -1.0).expect("dim"), "spacing");
+    refused(par.clone().with_dim("thickness", f64::NAN).expect("dim"), "thickness must be a finite length");
+    refused(par.clone().with_dim("length", 1e9).expect("dim"), "is over");
+    let e = par.with_dim("stud_height", 3.0).err().unwrap_or_default();
+    assert!(e.contains("no dimension \"stud_height\""), "{e}");
+    let mut steps = Accessory::default_of("step_block").expect("steps");
+    *steps.steps_mut().expect("steps") = 0;
+    refused(steps.clone(), "step count");
+    *steps.steps_mut().expect("steps") = 500;
+    refused(steps, "step count");
+    let clamp = Accessory::default_of("strap_clamp").expect("clamp");
+    refused(clamp.clone().with_dim("stud_offset", 2.0).expect("dim"), "past the toe");
+    refused(clamp.clone().with_dim("stud_offset", 140.0).expect("dim"), "into the heel block");
+    refused(clamp.clone().with_dim("heel_length", 200.0).expect("dim"), "heel block length");
+    refused(Accessory::default_of("soft_jaw").expect("jaw").with_dim("width", f64::INFINITY).expect("dim"), "Soft jaw width");
+    let world = new_world();
+    let bad = clamp.with_dim("clamp_height", -5.0).expect("dim");
+    let at = AccessoryPlacement::At(Location::default());
+    assert!(InsertAccessory::new(&world, &bad, None, at.clone()).is_err(), "the command refuses too");
+    let nan = AccessoryPlacement::At(Location { pos: Point3::new(f64::NAN, 0.0, 0.0), rot: IDENTITY_Q });
+    let good = Accessory::default_of("block").expect("block");
+    assert!(InsertAccessory::new(&world, &good, None, nan).is_err(), "a NaN pose is refused");
+    let fit = AccessoryPlacement::UnderStockInVise { vise: "Vise 6 in".into(), above: 5.0 };
+    let e = InsertAccessory::new(&world, &good, None, fit).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("only parallels"), "{e}");
+}
+
+fn params_of(world: &flecs_ecs::prelude::World, name: &str) -> Option<Accessory> {
+    model::find_by_name(world, name).and_then(|e| fixture::def_of(world, &e)).and_then(|d| d.accessory)
+}
+
+#[test]
+fn placing_and_resizing_are_one_undo_each_and_survive_a_save() {
+    let world = new_world();
+    let mut history = History::default();
+    let mut names = Vec::new();
+    for (k, kind) in accessory::KINDS.iter().enumerate() {
+        let a = Accessory::default_of(kind).expect(kind);
+        let at = Location { pos: Point3::new(200.0 * k as f64, 0.0, 0.0), rot: IDENTITY_Q };
+        let cmd = InsertAccessory::new(&world, &a, None, AccessoryPlacement::At(at)).expect(kind);
+        names.push(cmd.name().to_owned());
+        history.execute(&world, cmd);
+    }
+    assert_eq!(names, ["Parallels", "1-2-3 block", "Step block", "Strap clamp", "Soft jaw"]);
+    let clamp = "Strap clamp";
+    let e = model::find_by_name(&world, clamp).expect("placed");
+    let rev = model::rev_of(&world, &e);
+    let before = model::facets_of(&world, &e).expect("facets").to_vec();
+    let taller = params_of(&world, clamp).expect("clamp").with_dim("clamp_height", 50.0).expect("dim");
+    history.execute(&world, SetAccessory::new(&world, clamp, taller.clone()).expect("resize"));
+    assert_eq!(params_of(&world, clamp), Some(taller.clone()));
+    assert!(model::rev_of(&world, &e) > rev, "the geometry revision moves");
+    let b = model::entity_world_aabb(&world, &e).expect("box");
+    assert!((b.max.z - (50.0 + 0.625 * IN + 1.5 * IN)).abs() < 1e-9, "the stud top rose with the clamp: {}", b.max.z);
+
+    let path = std::env::temp_dir().join(format!("camcraft-accessory-{}.camproj", std::process::id()));
+    project::save(&world, &path).expect("save");
+    let text = std::fs::read_to_string(&path).expect("read");
+    assert!(text.contains("\"accessory\"") && text.contains("\"strap_clamp\""), "the marker carries the parameters");
+    let back = new_world();
+    project::load(&back, &path).expect("load");
+    for n in &names {
+        assert_eq!(params_of(&back, n), params_of(&world, n), "{n} reloads");
+    }
+    assert!(SetAccessory::new(&back, clamp, taller.clone().with_dim("clamp_height", 30.0).expect("dim")).is_ok(), "and stays editable");
+
+    // A hand-edited nonsense key reads as plain steel, not a crash.
+    let broken = text.replace("\"clamp_height\": 50.0", "\"clamp_height\": -1.0");
+    assert_ne!(broken, text, "the key is in the file");
+    std::fs::write(&path, broken).expect("write");
+    let plain = new_world();
+    project::load(&plain, &path).expect("loads");
+    let _ = std::fs::remove_file(&path);
+    let pe = model::find_by_name(&plain, clamp).expect("the clamp's steel stays");
+    assert!(fixture::def_of(&plain, &pe).is_some_and(|d| d.accessory.is_none()), "kept as plain steel");
+
+    // One undo takes the resize back, facets and all; one more the clamp.
+    assert!(history.undo(&world));
+    assert_eq!(params_of(&world, clamp).map(|a| a.dims()), Accessory::default_of("strap_clamp").map(|a| a.dims()));
+    assert_eq!(model::rev_of(&world, &e), rev);
+    assert_eq!(model::facets_of(&world, &e).expect("facets").to_vec(), before, "the steel comes back");
+    assert!(history.undo(&world));
+    assert!(model::find_by_name(&world, "Soft jaw").is_none(), "one undo removes the last placement");
+    assert!(model::find_by_name(&world, clamp).is_some());
+    assert!(history.redo(&world));
+    assert!(history.redo(&world));
+    assert_eq!(params_of(&world, clamp), Some(taller), "redo lands both again");
+
+    // A resize keeps its kind; an imported fixture has no parameters.
+    let e = SetAccessory::new(&world, clamp, Accessory::default_of("block").expect("block")).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("cannot become a 1-2-3 block"), "{e}");
+    history.execute(&world, ImportModel::from_mesh("Plate", Mesh::from_facets(mesh::cuboid(Point3::ZERO, Point3::new(1.0, 1.0, 1.0)))));
+    history.execute(&world, TagFixture::new(&world, "Plate", None).expect("tag"));
+    let e = SetAccessory::new(&world, "Plate", Accessory::default_of("block").expect("block")).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("not a built-in accessory"), "{e}");
+}
diff --git a/crates/app/tests/mcp_accessory.rs b/crates/app/tests/mcp_accessory.rs
new file mode 100644
index 00000000..78b09462
--- /dev/null
+++ b/crates/app/tests/mcp_accessory.rs
@@ -0,0 +1,100 @@
+//! The MCP built-in accessory tools (#789), driven in-process over the
+//! server's JSON-RPC handler: a strap clamp placed and resized, parallels
+//! fitted under the stock in a built-in vise, every step one undo, every
+//! bad input a named tool error.
+//!
+//! Gate map (M4.4): covers app::mcp::accessory_tools.
+
+use camcraft_app::mcp::Server;
+
+use serde_json::{Value, json};
+
+struct Client {
+    server: Server,
+    next: i64,
+}
+
+impl Client {
+    fn new() -> Self {
+        let mut c = Self { server: Server::new(), next: 1 };
+        c.request("initialize", json!({ "protocolVersion": "2025-06-18" }));
+        c
+    }
+
+    fn request(&mut self, method: &str, params: Value) -> Value {
+        let id = self.next;
+        self.next += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params });
+        self.server.handle(&msg).expect("a request gets a response")
+    }
+
+    fn call(&mut self, name: &str, args: Value) -> (bool, Value) {
+        let reply = self.request("tools/call", json!({ "name": name, "arguments": args }));
+        let result = &reply["result"];
+        assert!(result.is_object(), "tools/call answers with a result: {reply}");
+        let is_err = result["isError"] == json!(true);
+        let body = if is_err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() };
+        (is_err, body)
+    }
+
+    fn ok(&mut self, name: &str, args: Value) -> Value {
+        let (err, body) = self.call(name, args);
+        assert!(!err, "{name} refused: {body}");
+        body
+    }
+
+    fn refused(&mut self, name: &str, args: Value) -> String {
+        let (err, body) = self.call(name, args);
+        assert!(err, "{name} should have refused, got {body}");
+        body.as_str().unwrap_or_default().to_owned()
+    }
+}
+
+#[test]
+fn accessories_are_placed_fitted_resized_and_undone_over_mcp() {
+    let mut c = Client::new();
+    let names: Vec<String> = c.request("tools/list", json!({}))["result"]["tools"]
+        .as_array()
+        .map(|t| t.iter().filter_map(|t| t["name"].as_str().map(str::to_owned)).collect())
+        .unwrap_or_default();
+    for want in ["add_accessory", "set_accessory"] {
+        assert!(names.iter().any(|n| n == want), "missing tool {want}");
+    }
+
+    let why = c.refused("add_accessory", json!({ "kind": "angle_plate" }));
+    assert!(why.contains("no built-in accessory 'angle_plate'") && why.contains("strap_clamp"), "{why}");
+    let why = c.refused("add_accessory", json!({ "kind": "block", "dimensions": { "stud_height": 3.0 } }));
+    assert!(why.contains("no dimension \"stud_height\""), "{why}");
+    let why = c.refused("add_accessory", json!({ "kind": "block", "steps": 3 }));
+    assert!(why.contains("has no steps"), "{why}");
+    let why = c.refused("add_accessory", json!({ "kind": "strap_clamp", "dimensions": { "clamp_height": 0.0 } }));
+    assert!(why.contains("clamp height must be more than zero"), "{why}");
+
+    let placed = c.ok("add_accessory", json!({ "kind": "strap_clamp", "position": [40.0, 0.0, 0.0],
+        "dimensions": { "clamp_height": 20.0 } }));
+    assert_eq!(placed["fixture"], json!("Strap clamp"), "{placed}");
+    assert_eq!(placed["accessory"]["clamp_height"], json!(20.0), "{placed}");
+    let set = c.ok("set_accessory", json!({ "name": "Strap clamp", "dimensions": { "stud_height": 50.0 } }));
+    assert_eq!(set["accessory"]["stud_height"], json!(50.0), "{set}");
+    let steps = c.ok("add_accessory", json!({ "kind": "step_block", "steps": 4, "position": [0.0, 200.0, 0.0] }));
+    assert_eq!(steps["accessory"]["steps"], json!(4), "{steps}");
+
+    c.ok("set_stock", json!({ "box": { "dx": 60.0, "dy": 50.0, "dz": 20.0 } }));
+    c.ok("add_builtin_vise", json!({ "size": "6 in", "fit_to_stock": true }));
+    let fit = c.ok("add_accessory", json!({ "kind": "parallels", "under_stock_in_vise": "Vise 6 in", "above": 10.0 }));
+    let h = fit["accessory"]["height"].as_f64().unwrap_or_default();
+    assert!((h - (1.75 * 25.4 + 10.0 - 20.0)).abs() < 1e-3, "{fit}");
+    let why = c.refused("add_accessory", json!({ "kind": "block", "under_stock_in_vise": "Vise 6 in" }));
+    assert!(why.contains("only parallels"), "{why}");
+
+    for _ in 0..3 {
+        c.ok("undo", json!({}));
+    }
+    let set = c.ok("set_accessory", json!({ "name": "Strap clamp", "dimensions": { "strap_width": 40.0 } }));
+    assert_eq!(set["accessory"]["stud_height"], json!(50.0), "the resize survived three undos: {set}");
+    for _ in 0..4 {
+        c.ok("undo", json!({}));
+    }
+    let why = c.refused("set_accessory", json!({ "name": "Strap clamp" }));
+    assert!(why.contains("not a built-in accessory"), "undo removed the clamp: {why}");
+}
