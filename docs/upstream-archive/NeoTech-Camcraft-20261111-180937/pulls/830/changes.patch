@@ -0,0 +1,325 @@
+//! Built-in workholding accessories (#789, part of #339): parallels,
+//! 1-2-3 blocks, step blocks, strap (toe) clamps and soft jaws, each
+//! generated from a few dimensions and placed through the fixture
+//! library's insert path (`commands::InsertAccessory`) - a model wearing
+//! `FixtureDef`, judged by the same fixture laws as any meshed fixture.
+//! Its parameters ride the marker so it can be resized
+//! (`commands::SetAccessory`) and saved.
+//!
+//! Every item's frame has z = 0 at its underside (the table, the vise
+//! floor). Parallels: two bars along x, centred, with the gap between
+//! their inner faces centred on y = 0. Block, soft jaw: centred in x; the
+//! block centred in y, the soft jaw's clamping face at y = 0 with its body
+//! toward +y (the vise's fixed-jaw voice). Step block: steps rising toward
+//! +y from y = 0, centred in x. Strap clamp: the toe tip at x = 0, the
+//! strap running toward +x, centred in y; its underside at the clamp
+//! height (the clamped face), the heel block under its far end, the stud
+//! between them from the table up through the strap.
+//!
+//! Provenance: our own generic geometry and figures (common inch sizes of
+//! shop accessories); no vendor model copied.
+
+use serde::{Deserialize, Serialize};
+
+use crate::geometry::{Aabb, Point3, Triangle, quat_conjugate, quat_rotate_point};
+use crate::schema::Location;
+
+pub mod mesh;
+
+const IN: f64 = 25.4;
+/// No accessory dimension past this (mm): a typo, never a real part.
+pub const MAX_DIM: f64 = 5000.0;
+/// The most steps a step block may have.
+pub const MAX_STEPS: u32 = 50;
+
+/// One accessory's kind and dimensions (millimetres).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum Accessory {
+    /// A pair of parallels: bars `length` long (x), `thickness` across
+    /// (y), `height` tall, `spacing` between their inner faces.
+    Parallels { height: f64, thickness: f64, length: f64, spacing: f64 },
+    /// A solid block (a 1-2-3 block by default; its holes drawn solid).
+    Block { length: f64, width: f64, height: f64 },
+    /// A step block: `steps` steps, each `rise` up and `run` deep, `width`
+    /// across.
+    StepBlock { steps: u32, rise: f64, run: f64, width: f64 },
+    /// A strap (toe) clamp: strap, stud, heel block; `clamp_height` is the
+    /// clamped face's height over the table (the strap's underside).
+    StrapClamp {
+        strap_length: f64,
+        strap_width: f64,
+        strap_thickness: f64,
+        stud_diameter: f64,
+        /// The stud (nut and washer included) above the strap's top.
+        stud_height: f64,
+        /// From the toe tip to the stud's centre.
+        stud_offset: f64,
+        heel_length: f64,
+        clamp_height: f64,
+    },
+    /// A soft jaw: a block that stands in for a vise jaw.
+    SoftJaw { width: f64, height: f64, thickness: f64 },
+}
+
+/// The kinds, in the order the dialog lists them.
+pub const KINDS: [&str; 5] = ["parallels", "block", "step_block", "strap_clamp", "soft_jaw"];
+
+/// One named dimension: the file/MCP key, the label the UI shows, and
+/// the value.
+pub struct Dim<'a> {
+    pub key: &'static str,
+    pub label: &'static str,
+    pub value: &'a mut f64,
+}
+
+impl Accessory {
+    /// The default accessory of kind `kind` (a `KINDS` key).
+    #[must_use]
+    pub fn default_of(kind: &str) -> Option<Self> {
+        Some(match kind {
+            // 1/8 x 1 x 6 in parallels, 4 in apart.
+            "parallels" => Self::Parallels { height: IN, thickness: 0.125 * IN, length: 6.0 * IN, spacing: 4.0 * IN },
+            "block" => Self::Block { length: 3.0 * IN, width: 2.0 * IN, height: IN },
+            "step_block" => Self::StepBlock { steps: 6, rise: 0.5 * IN, run: 0.75 * IN, width: IN },
+            // A 1/2 in stud's strap.
+            "strap_clamp" => Self::StrapClamp {
+                strap_length: 6.0 * IN,
+                strap_width: 1.25 * IN,
+                strap_thickness: 0.625 * IN,
+                stud_diameter: 0.5 * IN,
+                stud_height: 1.5 * IN,
+                stud_offset: 2.25 * IN,
+                heel_length: 1.25 * IN,
+                clamp_height: IN,
+            },
+            "soft_jaw" => Self::SoftJaw { width: 6.0 * IN, height: 2.0 * IN, thickness: 0.75 * IN },
+            _ => return None,
+        })
+    }
+
+    /// This accessory's `KINDS` key.
+    #[must_use]
+    pub fn kind(&self) -> &'static str {
+        match self {
+            Self::Parallels { .. } => "parallels",
+            Self::Block { .. } => "block",
+            Self::StepBlock { .. } => "step_block",
+            Self::StrapClamp { .. } => "strap_clamp",
+            Self::SoftJaw { .. } => "soft_jaw",
+        }
+    }
+
+    /// The kind as the UI names it, and the model name a fresh one lands
+    /// under (before the free-name suffix).
+    #[must_use]
+    pub fn label(&self) -> &'static str {
+        label_of(self.kind())
+    }
+
+    /// Every length dimension, named (the step count is apart).
+    pub fn dims_mut(&mut self) -> Vec<Dim<'_>> {
+        let d = |key, label, value| Dim { key, label, value };
+        match self {
+            Self::Parallels { height, thickness, length, spacing } => vec![
+                d("height", "Height", height),
+                d("thickness", "Thickness", thickness),
+                d("length", "Length", length),
+                d("spacing", "Spacing (gap between them)", spacing),
+            ],
+            Self::Block { length, width, height } => {
+                vec![d("length", "Length", length), d("width", "Width", width), d("height", "Height", height)]
+            }
+            Self::StepBlock { rise, run, width, .. } => {
+                vec![d("rise", "Step rise", rise), d("run", "Step run", run), d("width", "Width", width)]
+            }
+            Self::StrapClamp {
+                strap_length,
+                strap_width,
+                strap_thickness,
+                stud_diameter,
+                stud_height,
+                stud_offset,
+                heel_length,
+                clamp_height,
+            } => vec![
+                d("strap_length", "Strap length", strap_length),
+                d("strap_width", "Strap width", strap_width),
+                d("strap_thickness", "Strap thickness", strap_thickness),
+                d("stud_diameter", "Stud diameter", stud_diameter),
+                d("stud_height", "Stud above the strap", stud_height),
+                d("stud_offset", "Stud from the toe", stud_offset),
+                d("heel_length", "Heel block length", heel_length),
+                d("clamp_height", "Clamp height", clamp_height),
+            ],
+            Self::SoftJaw { width, height, thickness } => {
+                vec![d("width", "Width", width), d("height", "Height", height), d("thickness", "Thickness", thickness)]
+            }
+        }
+    }
+
+    /// Every length dimension as (key, label, value).
+    #[must_use]
+    pub fn dims(&self) -> Vec<(&'static str, &'static str, f64)> {
+        let mut copy = self.clone();
+        copy.dims_mut().into_iter().map(|d| (d.key, d.label, *d.value)).collect()
+    }
+
+    /// The step count, for a step block.
+    pub fn steps_mut(&mut self) -> Option<&mut u32> {
+        match self {
+            Self::StepBlock { steps, .. } => Some(steps),
+            _ => None,
+        }
+    }
+
+    /// The accessory law: every dimension a finite length over zero and
+    /// at most `MAX_DIM`; a step block 1..=`MAX_STEPS` steps; a strap
+    /// clamp's stud on the strap between the toe and the heel block.
+    /// Refusals name the accessory and the dimension.
+    pub fn check(&self) -> Result<(), String> {
+        let what = self.label();
+        for (_, label, v) in self.dims() {
+            let label = label.to_lowercase();
+            if !v.is_finite() {
+                return Err(format!("{what} {label} must be a finite length (got {v})"));
+            }
+            if v <= 0.0 {
+                return Err(format!("{what} {label} must be more than zero (got {v} mm)"));
+            }
+            if v > MAX_DIM {
+                return Err(format!("{what} {label} {v:.3} mm is over {MAX_DIM} mm"));
+            }
+        }
+        match self {
+            Self::StepBlock { steps, .. } if !(1..=MAX_STEPS).contains(steps) => {
+                Err(format!("{what} step count must be 1 to {MAX_STEPS} (got {steps})"))
+            }
+            Self::StrapClamp { strap_length, stud_diameter, stud_offset, heel_length, .. } => {
+                let r = mesh::stud_radius(*stud_diameter);
+                if *heel_length >= *strap_length {
+                    return Err(format!(
+                        "{what} heel block length {heel_length:.3} mm must be less than the strap length {strap_length:.3} mm"
+                    ));
+                }
+                if *stud_offset - r <= 0.0 {
+                    return Err(format!("{what} stud from the toe {stud_offset:.3} mm puts the stud past the toe"));
+                }
+                if *stud_offset + r >= *strap_length - *heel_length {
+                    return Err(format!("{what} stud from the toe {stud_offset:.3} mm puts the stud into the heel block"));
+                }
+                Ok(())
+            }
+            _ => Ok(()),
+        }
+    }
+
+    /// The checked accessory's closed shells in its own frame.
+    pub fn mesh(&self) -> Result<Vec<Triangle>, String> {
+        self.check()?;
+        mesh::solid(self)
+    }
+
+    /// The same accessory with key `key`'s dimension set to `v`; refused
+    /// by name for a key this kind does not have.
+    pub fn with_dim(mut self, key: &str, v: f64) -> Result<Self, String> {
+        let kind = self.label();
+        let keys: Vec<&str> = self.dims().iter().map(|d| d.0).collect();
+        match self.dims_mut().into_iter().find(|d| d.key == key) {
+            Some(d) => *d.value = v,
+            None => return Err(format!("a {kind} has no dimension \"{key}\" (one of {})", keys.join(", "))),
+        }
+        Ok(self)
+    }
+}
+
+/// The UI name of kind `kind`.
+#[must_use]
+pub fn label_of(kind: &str) -> &'static str {
+    match kind {
+        "parallels" => "Parallels",
+        "block" => "1-2-3 block",
+        "step_block" => "Step block",
+        "strap_clamp" => "Strap clamp",
+        "soft_jaw" => "Soft jaw",
+        _ => "Accessory",
+    }
+}
+
+/// Parallels fitted under the stock inside a built-in vise: the height,
+/// the spacing, the vise's new pose and the parallels' pose.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ParallelsFit {
+    pub height: f64,
+    pub spacing: f64,
+    pub vise: Location,
+    pub parallels: Location,
+}
+
+/// Fit parallels `thickness` thick under stock box `stock` inside the
+/// vise standing at `pose`, `jaw_height` tall and `opening` open, so the
+/// stock's top stands `above` over the jaws: the parallels' height is the
+/// jaw height plus `above` less the stock's height (all along the vise's
+/// own z), the vise drops so its floor is that far under the stock, and
+/// the pair stands on the floor against both jaws. Refused by name when
+/// the stock already stands that high, or two parallels do not fit in
+/// the opening.
+pub fn fit_parallels(
+    pose: &Location,
+    jaw_height: f64,
+    opening: f64,
+    stock: &Aabb,
+    thickness: f64,
+    above: f64,
+) -> Result<ParallelsFit, String> {
+    if !above.is_finite() || above < 0.0 {
+        return Err(format!("the stock's height over the jaws must be zero or more (got {above} mm)"));
+    }
+    let inv = quat_conjugate(pose.rot);
+    let (mut lo, mut hi) = (f64::MAX, f64::MIN);
+    for k in 0..8 {
+        let c = Point3::new(
+            if k & 1 == 0 { stock.min.x } else { stock.max.x },
+            if k & 2 == 0 { stock.min.y } else { stock.max.y },
+            if k & 4 == 0 { stock.min.z } else { stock.max.z },
+        );
+        let local = quat_rotate_point(inv, c - pose.pos);
+        lo = lo.min(local.z);
+        hi = hi.max(local.z);
+    }
+    if !(lo.is_finite() && hi.is_finite()) {
+        return Err("the stock box is not finite".into());
+    }
+    let tall = hi - lo;
+    let height = jaw_height + above - tall;
+    if height <= 0.0 {
+        return Err(format!(
+            "the stock is {tall:.3} mm tall: on the vise floor it already stands {:.3} mm over the jaws - no parallels fit under it",
+            tall - jaw_height
+        ));
+    }
+    let spacing = opening - 2.0 * thickness;
+    if spacing <= 0.0 {
+        return Err(format!(
+            "two {thickness:.3} mm parallels do not fit in the vise's {opening:.3} mm jaw opening"
+        ));
+    }
+    let drop = quat_rotate_point(pose.rot, Point3::new(0.0, 0.0, lo - height));
+    let vise = Location { pos: Point3::new(pose.pos.x + drop.x, pose.pos.y + drop.y, pose.pos.z + drop.z), rot: pose.rot };
+    let mid = quat_rotate_point(pose.rot, Point3::new(0.0, -0.5 * opening, 0.0));
+    let parallels = Location { pos: Point3::new(vise.pos.x + mid.x, vise.pos.y + mid.y, vise.pos.z + mid.z), rot: pose.rot };
+    Ok(ParallelsFit { height, spacing, vise, parallels })
+}
+
+/// An accessory read from a file, when it keeps the law; nonsense is
+/// dropped (logged) and the fixture stays plain steel.
+#[must_use]
+pub fn checked_on_load(a: &Accessory, model: &str) -> Option<Accessory> {
+    match a.check() {
+        Ok(()) => Some(a.clone()),
+        Err(why) => {
+            tracing::warn!(model, "accessory parameters dropped on load, kept as plain steel: {why}");
+            None
+        }
+    }
+}
diff --git a/crates/app/src/accessory/mesh.rs b/crates/app/src/accessory/mesh.rs
new file mode 100644
index 00000000..b2032b13
--- /dev/null
+++ b/crates/app/src/accessory/mesh.rs
@@ -0,0 +1,151 @@
+//! The built-in accessories' solids (#789): closed, outward shells that
+//! only ever touch, never overlap - a strap clamp's stud is drawn below
+//! and above the strap, not through it, so a point inside the steel is
+//! inside exactly one shell and the mesh law's ray-crossing test holds.
+//! Holes and slots are drawn solid and the stud as a polygon around its
+//! circle: a conservative envelope, never less than the real steel.
+//!
+//! Provenance: boxes, a prism extruded from a simple polygon (ear-clipped
+//! by `vise::mesh::triangulate`) and a circumscribed polygonal cylinder;
+//! our own code.
+
+use crate::geometry::{Point3, Triangle};
+use crate::vise::mesh::triangulate;
+
+use super::Accessory;
+
+/// The stud's sides.
+pub const STUD_SIDES: usize = 16;
+
+/// The radius of the polygon drawn around a stud of `diameter`: its
+/// flats touch the true circle, so the polygon encloses it.
+#[must_use]
+pub fn stud_radius(diameter: f64) -> f64 {
+    0.5 * diameter / (std::f64::consts::PI / STUD_SIDES as f64).cos()
+}
+
+/// A closed, outward box `lo..hi`.
+#[must_use]
+pub fn cuboid(lo: Point3, hi: Point3) -> Vec<Triangle> {
+    let c = |i: usize| {
+        Point3::new(
+            if i & 1 == 0 { lo.x } else { hi.x },
+            if i & 2 == 0 { lo.y } else { hi.y },
+            if i & 4 == 0 { lo.z } else { hi.z },
+        )
+    };
+    let quads = [[0, 2, 3, 1], [4, 5, 7, 6], [0, 1, 5, 4], [2, 6, 7, 3], [0, 4, 6, 2], [1, 3, 7, 5]];
+    quads
+        .iter()
+        .flat_map(|q| [Triangle::new(c(q[0]), c(q[1]), c(q[2])), Triangle::new(c(q[0]), c(q[2]), c(q[3]))])
+        .collect()
+}
+
+/// Twice the signed area of a polygon (positive: counter-clockwise).
+fn area2(poly: &[(f64, f64)]) -> f64 {
+    let n = poly.len();
+    (0..n)
+        .map(|i| {
+            let (a, b) = (poly[i], poly[(i + 1) % n]);
+            a.0 * b.1 - b.0 * a.1
+        })
+        .sum()
+}
+
+/// The closed, outward prism of simple polygon `poly` in (y, z),
+/// extruded over x in `x0..x1`.
+pub fn prism(poly: &[(f64, f64)], x0: f64, x1: f64) -> Result<Vec<Triangle>, String> {
+    let mut poly = poly.to_vec();
+    if area2(&poly) < 0.0 {
+        poly.reverse();
+    }
+    let caps = triangulate(&poly)?;
+    let at = |x: f64, k: usize| Point3::new(x, poly[k].0, poly[k].1);
+    let mut tris = Vec::with_capacity(2 * caps.len() + 2 * poly.len());
+    for [a, b, c] in &caps {
+        tris.push(Triangle::new(at(x1, *a), at(x1, *b), at(x1, *c)));
+        tris.push(Triangle::new(at(x0, *a), at(x0, *c), at(x0, *b)));
+    }
+    let n = poly.len();
+    for i in 0..n {
+        let j = (i + 1) % n;
+        tris.push(Triangle::new(at(x0, i), at(x0, j), at(x1, j)));
+        tris.push(Triangle::new(at(x0, i), at(x1, j), at(x1, i)));
+    }
+    Ok(tris)
+}
+
+/// A closed, outward polygonal cylinder around the z axis at (`x`, `y`),
+/// `z0..z1`, its flats touching a circle of `diameter`.
+#[must_use]
+pub fn stud(x: f64, y: f64, diameter: f64, z0: f64, z1: f64) -> Vec<Triangle> {
+    let r = stud_radius(diameter);
+    let ring = |k: usize, z: f64| {
+        let a = std::f64::consts::TAU * (k % STUD_SIDES) as f64 / STUD_SIDES as f64;
+        Point3::new(x + r * a.cos(), y + r * a.sin(), z)
+    };
+    let (bot, top) = (Point3::new(x, y, z0), Point3::new(x, y, z1));
+    let mut tris = Vec::with_capacity(4 * STUD_SIDES);
+    for k in 0..STUD_SIDES {
+        let (a0, a1, b0, b1) = (ring(k, z0), ring(k + 1, z0), ring(k, z1), ring(k + 1, z1));
+        tris.push(Triangle::new(bot, a1, a0));
+        tris.push(Triangle::new(top, b0, b1));
+        tris.push(Triangle::new(a0, a1, b1));
+        tris.push(Triangle::new(a0, b1, b0));
+    }
+    tris
+}
+
+/// A step block's side profile in (y, z): steps rising toward +y.
+#[must_use]
+pub fn steps_profile(steps: u32, rise: f64, run: f64) -> Vec<(f64, f64)> {
+    let n = f64::from(steps);
+    let mut poly = vec![(0.0, 0.0), (n * run, 0.0)];
+    for i in (0..steps).rev() {
+        let i = f64::from(i);
+        poly.push(((i + 1.0) * run, (i + 1.0) * rise));
+        poly.push((i * run, (i + 1.0) * rise));
+    }
+    // The last corner pushed is (0, rise); the ring closes to (0, 0).
+    poly
+}
+
+/// The accessory's shells in its own frame (see `accessory`'s frames).
+/// `a` is assumed checked.
+pub fn solid(a: &Accessory) -> Result<Vec<Triangle>, String> {
+    let p = Point3::new;
+    Ok(match *a {
+        Accessory::Parallels { height, thickness, length, spacing } => {
+            let (hx, g) = (0.5 * length, 0.5 * spacing);
+            let mut t = cuboid(p(-hx, -g - thickness, 0.0), p(hx, -g, height));
+            t.extend(cuboid(p(-hx, g, 0.0), p(hx, g + thickness, height)));
+            t
+        }
+        Accessory::Block { length, width, height } => {
+            cuboid(p(-0.5 * length, -0.5 * width, 0.0), p(0.5 * length, 0.5 * width, height))
+        }
+        Accessory::SoftJaw { width, height, thickness } => {
+            cuboid(p(-0.5 * width, 0.0, 0.0), p(0.5 * width, thickness, height))
+        }
+        Accessory::StepBlock { steps, rise, run, width } => {
+            prism(&steps_profile(steps, rise, run), -0.5 * width, 0.5 * width)?
+        }
+        Accessory::StrapClamp {
+            strap_length,
+            strap_width,
+            strap_thickness,
+            stud_diameter,
+            stud_height,
+            stud_offset,
+            heel_length,
+            clamp_height,
+        } => {
+            let (hw, top) = (0.5 * strap_width, clamp_height + strap_thickness);
+            let mut t = cuboid(p(0.0, -hw, clamp_height), p(strap_length, hw, top));
+            t.extend(cuboid(p(strap_length - heel_length, -hw, 0.0), p(strap_length, hw, clamp_height)));
+            t.extend(stud(stud_offset, 0.0, stud_diameter, 0.0, clamp_height));
+            t.extend(stud(stud_offset, 0.0, stud_diameter, top, top + stud_height));
+            t
+        }
+    })
+}
diff --git a/crates/app/src/commands/accessory.rs b/crates/app/src/commands/accessory.rs
new file mode 100644
index 00000000..04bf810b
--- /dev/null
+++ b/crates/app/src/commands/accessory.rs
@@ -0,0 +1,198 @@
+//! Built-in accessory commands (#789): place a generated workholding
+//! accessory into a setup, and resize a placed one - each ONE undo unit.
+//! Placing goes through the fixture library's insert path
+//! (`InsertFixture`, marked with the accessory's parameters), so an
+//! accessory is an ordinary meshed fixture to the collision laws, the
+//! project file and every fixture command. Parallels fitted under the
+//! stock inside a built-in vise also drop the vise (`MoveFixture`) in the
+//! same unit. Resizing regenerates the mesh through `UpdateModel` (the
+//! revision moves, so caches see the new steel) and swaps the marker.
+//!
+//! Provenance: our own composition of the insert, move, update and marker
+//! commands over `accessory`'s generated geometry (the #788 vise pattern).
+
+use flecs_ecs::prelude::World;
+
+use crate::accessory::{self, Accessory};
+use crate::commands::{Command, CommandError, InsertFixture, MoveFixture, UpdateModel};
+use crate::fixture;
+use crate::fixture_library::FixtureEntry;
+use crate::geometry::{IDENTITY_Q, Mesh, Point3};
+use crate::model;
+use crate::schema::{FixtureDef, Location};
+
+/// Where a new accessory goes.
+#[derive(Clone, Debug, PartialEq)]
+pub enum AccessoryPlacement {
+    /// The accessory frame's origin at this pose.
+    At(Location),
+    /// Parallels only: under the setup's stock inside built-in vise
+    /// `vise`, so the stock's top stands `above` mm over the jaws - the
+    /// parallels' height is set to fit and the vise drops to suit.
+    UnderStockInVise { vise: String, above: f64 },
+}
+
+/// Place accessory `params` into setup context `setup` (`None` - the
+/// implicit first setup).
+pub struct InsertAccessory {
+    inner: InsertFixture,
+    /// The vise drop of a parallels fit, applied after the insert.
+    lift: Option<MoveFixture>,
+}
+
+impl InsertAccessory {
+    /// Refused when the accessory breaks its law (named), the setup is
+    /// gone, the pose is not a finite rigid frame, or (fitting parallels)
+    /// the vise is not a built-in vise, the setup has no stock, the
+    /// stock already stands that high, or the pair does not fit the jaws.
+    pub fn new(
+        world: &World,
+        params: &Accessory,
+        setup: Option<&str>,
+        placement: AccessoryPlacement,
+    ) -> Result<Self, CommandError> {
+        let (params, pick, lift) = match placement {
+            AccessoryPlacement::At(loc) => (params.clone(), loc, None),
+            AccessoryPlacement::UnderStockInVise { vise, above } => fit_under_stock(world, params, setup, &vise, above)?,
+        };
+        let facets = params.mesh().map_err(CommandError::Invalid)?;
+        let entry = FixtureEntry {
+            name: params.label().to_owned(),
+            note: None,
+            datum: Location { pos: Point3::ZERO, rot: IDENTITY_Q },
+            facets,
+        };
+        let inner = InsertFixture::new(world, &entry, setup, pick)?.with_accessory(params);
+        Ok(Self { inner, lift })
+    }
+
+    /// The model name the accessory lands as.
+    #[must_use]
+    pub fn name(&self) -> &str {
+        self.inner.name()
+    }
+
+    /// The pose of the accessory frame.
+    #[must_use]
+    pub fn location(&self) -> Location {
+        self.inner.location()
+    }
+
+    /// The parameters it is built from (a fit's height included).
+    #[must_use]
+    pub fn params(&self) -> Option<&Accessory> {
+        self.inner.def().accessory.as_ref()
+    }
+}
+
+/// The parallels, their pose and the vise's drop for an under-stock fit.
+fn fit_under_stock(
+    world: &World,
+    params: &Accessory,
+    setup: Option<&str>,
+    vise: &str,
+    above: f64,
+) -> Result<(Accessory, Location, Option<MoveFixture>), CommandError> {
+    let Accessory::Parallels { thickness, length, .. } = *params else {
+        return Err(CommandError::Invalid(format!(
+            "only parallels fit under the stock in a vise, not a {}",
+            params.label().to_lowercase()
+        )));
+    };
+    let entity = model::find_by_name(world, vise).ok_or_else(|| CommandError::NotFound(vise.to_owned()))?;
+    let vp = fixture::def_of(world, &entity)
+        .and_then(|d| d.vise)
+        .ok_or_else(|| CommandError::Invalid(format!("'{vise}' is not a built-in vise")))?;
+    let pose = model::transform_of(world, &entity).unwrap_or_default();
+    let stock = model::stock_world_aabb_for(world, setup).ok_or_else(|| {
+        CommandError::Invalid(format!(
+            "{} has no stock to fit the parallels under",
+            setup.map_or_else(|| "the setup".to_owned(), |s| format!("setup '{s}'"))
+        ))
+    })?;
+    let fit = accessory::fit_parallels(&pose, vp.jaw_height, vp.opening, &stock, thickness, above)
+        .map_err(|e| CommandError::Invalid(format!("parallels in '{vise}': {e}")))?;
+    let fitted = Accessory::Parallels { height: fit.height, thickness, length, spacing: fit.spacing };
+    let lift = MoveFixture::locating(world, vise, fit.vise)?;
+    Ok((fitted, fit.parallels, Some(lift)))
+}
+
+impl Command for InsertAccessory {
+    fn apply(&self, world: &World) {
+        self.inner.apply(world);
+        if let Some(lift) = &self.lift {
+            lift.apply(world);
+        }
+    }
+
+    fn invert(&self, world: &World) {
+        if let Some(lift) = &self.lift {
+            lift.invert(world);
+        }
+        self.inner.invert(world);
+    }
+}
+
+/// Resize a placed built-in accessory: the mesh is regenerated and the
+/// marker updated together.
+pub struct SetAccessory {
+    name: String,
+    update: UpdateModel,
+    prev: FixtureDef,
+    next: FixtureDef,
+}
+
+impl SetAccessory {
+    /// Set accessory `name` to `params`. Refused when `name` is not a
+    /// built-in accessory, `params` is another kind, or breaks the law.
+    pub fn new(world: &World, name: &str, params: Accessory) -> Result<Self, CommandError> {
+        let prev = accessory_def(world, name)?;
+        let was = prev.accessory.as_ref().map_or("", Accessory::kind);
+        if was != params.kind() {
+            return Err(CommandError::Invalid(format!(
+                "'{name}' is a {}; it cannot become a {}",
+                accessory::label_of(was).to_lowercase(),
+                params.label().to_lowercase()
+            )));
+        }
+        let facets = params.mesh().map_err(|e| CommandError::Invalid(format!("'{name}': {e}")))?;
+        let update = UpdateModel::new(world, name, Mesh::from_facets(facets))?;
+        let next = FixtureDef { accessory: Some(params), ..prev.clone() };
+        Ok(Self { name: name.to_owned(), update, prev, next })
+    }
+
+    /// The parameters the edit lands.
+    #[must_use]
+    pub fn params(&self) -> Option<&Accessory> {
+        self.next.accessory.as_ref()
+    }
+}
+
+/// The accessory marker of fixture `name`, or why not.
+pub fn accessory_def(world: &World, name: &str) -> Result<FixtureDef, CommandError> {
+    let entity = model::find_by_name(world, name).ok_or_else(|| CommandError::NotFound(name.to_owned()))?;
+    let def = fixture::def_of(world, &entity)
+        .ok_or_else(|| CommandError::Invalid(format!("'{name}' is not a fixture")))?;
+    if def.accessory.is_none() {
+        return Err(CommandError::Invalid(format!(
+            "'{name}' is not a built-in accessory (an imported fixture has a fixed shape)"
+        )));
+    }
+    Ok(def)
+}
+
+impl Command for SetAccessory {
+    fn apply(&self, world: &World) {
+        self.update.apply(world);
+        if let Some(e) = model::find_by_name(world, &self.name) {
+            e.entity_view(world).set(self.next.clone());
+        }
+    }
+
+    fn invert(&self, world: &World) {
+        self.update.invert(world);
+        if let Some(e) = model::find_by_name(world, &self.name) {
+            e.entity_view(world).set(self.prev.clone());
+        }
+    }
+}
