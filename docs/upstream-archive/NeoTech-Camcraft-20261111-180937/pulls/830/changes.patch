diff --git a/crates/app/src/vise.rs b/crates/app/src/vise.rs
new file mode 100644
index 00000000..47b1afe0
--- /dev/null
+++ b/crates/app/src/vise.rs
@@ -0,0 +1,180 @@
+//! Built-in milling vises (#788, part of #339): generic parametric
+//! vises built as geometry from a few dimensions, placed into a setup
+//! through the fixture library's insert path (`commands::InsertVise`),
+//! and judged by the same fixture laws as any meshed fixture - a vise
+//! is a model wearing `FixtureDef`, its parameters riding the marker so
+//! the jaw opening can be edited (`commands::SetVise`) and saved.
+//!
+//! The vise frame: x across the jaws (centred on the jaw width), y along
+//! the screw - the fixed jaw's clamping face at y = 0, its body behind
+//! it toward +y, the moving jaw's face at y = -opening - and z = 0 the
+//! floor the part sits on, the base below. Placing the frame's origin
+//! puts the fixed jaw's face, centred, at the floor.
+//!
+//! Provenance: our own geometry and parameters; the size table's figures
+//! are typical values from public catalog spec sheets (cited in
+//! `docs/decisions/788-builtin-vises.md`), no vendor model copied.
+
+use crate::geometry::{Aabb, Point3, Triangle, quat_conjugate, quat_rotate_point};
+use crate::schema::Location;
+
+pub mod mesh;
+pub mod table;
+
+pub use table::{SIZES, ViseSize, size};
+
+/// One vise's dimensions (millimetres) and its jaw opening.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ViseParams {
+    /// The table row it started from ("6 in"); free text once edited.
+    pub size: String,
+    pub jaw_width: f64,
+    pub jaw_height: f64,
+    /// Each jaw's depth along the screw.
+    pub jaw_thickness: f64,
+    pub max_opening: f64,
+    /// Overall length along the screw, housing included.
+    pub length: f64,
+    /// Overall width across the jaws (at least the jaw width).
+    pub width: f64,
+    /// From the table to the floor the part sits on.
+    pub base_height: f64,
+    /// The screw and handle housing at the front: its length...
+    pub housing_length: f64,
+    /// ...and its height above the floor.
+    pub housing_height: f64,
+    /// The gap between the jaws' faces.
+    pub opening: f64,
+}
+
+/// How far a part box may stand into the fixed jaw before "the stock is
+/// not against the fixed jaw" (float dust on a placement made by fit).
+const FACE_TOL: f64 = 1e-6;
+
+impl ViseParams {
+    /// Every dimension named, as the refusals say it.
+    fn named(&self) -> [(&'static str, f64); 10] {
+        [
+            ("jaw width", self.jaw_width),
+            ("jaw height", self.jaw_height),
+            ("jaw thickness", self.jaw_thickness),
+            ("max opening", self.max_opening),
+            ("overall length", self.length),
+            ("overall width", self.width),
+            ("base height", self.base_height),
+            ("housing length", self.housing_length),
+            ("housing height", self.housing_height),
+            ("jaw opening", self.opening),
+        ]
+    }
+
+    /// The vise law: every dimension a positive, finite length; the
+    /// opening within the max; the body as wide as the jaws and long
+    /// enough to carry both jaws at the max opening plus the housing.
+    /// Refusals name the dimension.
+    pub fn check(&self) -> Result<(), String> {
+        for (what, v) in self.named() {
+            if !v.is_finite() {
+                return Err(format!("vise {what} must be a finite length (got {v})"));
+            }
+            if v <= 0.0 {
+                return Err(format!("vise {what} must be more than zero (got {v} mm)"));
+            }
+        }
+        if self.opening > self.max_opening {
+            return Err(format!(
+                "vise jaw opening {:.3} mm is over the max opening {:.3} mm",
+                self.opening, self.max_opening
+            ));
+        }
+        if self.width < self.jaw_width {
+            return Err(format!(
+                "vise overall width {:.3} mm is narrower than its jaw width {:.3} mm",
+                self.width, self.jaw_width
+            ));
+        }
+        let carry = 2.0 * self.jaw_thickness + self.max_opening + self.housing_length;
+        if self.length <= carry {
+            return Err(format!(
+                "vise overall length {:.3} mm must be more than two jaws, the max opening and the housing ({carry:.3} mm)",
+                self.length
+            ));
+        }
+        Ok(())
+    }
+
+    /// The same vise with the jaws `opening` apart.
+    #[must_use]
+    pub fn with_opening(&self, opening: f64) -> Self {
+        Self { opening, ..self.clone() }
+    }
+
+    /// The checked vise's closed shell in its own frame.
+    pub fn mesh(&self) -> Result<Vec<Triangle>, String> {
+        self.check()?;
+        mesh::solid(self)
+    }
+
+    /// The model name a fresh vise lands under (before the free-name
+    /// suffix): "Vise 6 in".
+    #[must_use]
+    pub fn base_name(&self) -> String {
+        let s = self.size.trim();
+        if s.is_empty() { "Vise".to_owned() } else { format!("Vise {s}") }
+    }
+}
+
+/// Fit a vise at identity rotation to stock box `stock`: the fixed jaw's
+/// face on the stock's +y side, the jaw width centred on the stock in x,
+/// the floor under the stock, and the opening the stock's y extent.
+/// Returns the vise (opening set) and the pose of its frame. Refused by
+/// name when the stock is wider than the vise opens.
+pub fn fit_to_stock(p: &ViseParams, stock: &Aabb) -> Result<(ViseParams, Location), String> {
+    let across = stock.max.y - stock.min.y;
+    if !across.is_finite() || across <= 0.0 {
+        return Err("the stock has no width to clamp".into());
+    }
+    if across > p.max_opening {
+        return Err(format!(
+            "the stock is {across:.3} mm across the jaws; the {} vise opens {:.3} mm at most",
+            p.base_name(),
+            p.max_opening
+        ));
+    }
+    let fitted = p.with_opening(across);
+    fitted.check()?;
+    let pos = Point3::new(0.5 * (stock.min.x + stock.max.x), stock.max.y, stock.min.z);
+    Ok((fitted, Location { pos, rot: crate::geometry::IDENTITY_Q }))
+}
+
+/// The opening that puts the moving jaw against stock box `stock` for a
+/// vise standing at `pose`: the stock's far side from the fixed jaw,
+/// measured along the vise's screw. Refused by name when the stock
+/// reaches into the fixed jaw (the vise is not placed against it) or
+/// lies behind it.
+pub fn opening_from_stock(pose: &Location, stock: &Aabb) -> Result<f64, String> {
+    let inv = quat_conjugate(pose.rot);
+    let (mut lo, mut hi) = (f64::MAX, f64::MIN);
+    for k in 0..8 {
+        let c = Point3::new(
+            if k & 1 == 0 { stock.min.x } else { stock.max.x },
+            if k & 2 == 0 { stock.min.y } else { stock.max.y },
+            if k & 4 == 0 { stock.min.z } else { stock.max.z },
+        );
+        let local = quat_rotate_point(inv, Point3::new(c.x - pose.pos.x, c.y - pose.pos.y, c.z - pose.pos.z));
+        lo = lo.min(local.y);
+        hi = hi.max(local.y);
+    }
+    if !(lo.is_finite() && hi.is_finite()) {
+        return Err("the stock box is not finite".into());
+    }
+    if hi > FACE_TOL {
+        return Err(format!(
+            "the stock reaches {hi:.3} mm into the fixed jaw - place the vise against the stock first"
+        ));
+    }
+    if lo >= -FACE_TOL {
+        return Err("the stock is not in front of the fixed jaw".into());
+    }
+    Ok(-lo)
+}
diff --git a/crates/app/src/vise/mesh.rs b/crates/app/src/vise/mesh.rs
new file mode 100644
index 00000000..616ab82c
--- /dev/null
+++ b/crates/app/src/vise/mesh.rs
@@ -0,0 +1,114 @@
+//! The built-in vise's solid (#788): one closed, outward-facing shell -
+//! the vise's side profile (base, fixed jaw, moving jaw at the opening,
+//! screw and handle housing) extruded across the vise's overall width.
+//! Jaws drawn as wide as the body are a conservative envelope: the
+//! fixture laws see at least the real steel, never less.
+//!
+//! Provenance: prism extrusion of a simple polygon; the cap is
+//! triangulated by ear clipping (Meisters, "Polygons have ears", 1975 -
+//! the textbook two-ears method). Our own code.
+
+use crate::geometry::{Point3, Triangle};
+
+use super::ViseParams;
+
+/// The side profile in the vise frame's (y, z), counter-clockwise seen
+/// from +X: y = 0 is the fixed jaw's clamping face (its body behind,
+/// toward +y), the moving jaw's face at y = -opening, z = 0 the floor
+/// the part sits on, the base below it. `p` is assumed checked.
+#[must_use]
+pub fn profile(p: &ViseParams) -> Vec<(f64, f64)> {
+    let t = p.jaw_thickness;
+    let o = p.opening;
+    let front = t - p.length;
+    let housing = front + p.housing_length;
+    vec![
+        (t, -p.base_height),
+        (t, p.jaw_height),
+        (0.0, p.jaw_height),
+        (0.0, 0.0),
+        (-o, 0.0),
+        (-o, p.jaw_height),
+        (-o - t, p.jaw_height),
+        (-o - t, 0.0),
+        (housing, 0.0),
+        (housing, p.housing_height),
+        (front, p.housing_height),
+        (front, -p.base_height),
+    ]
+}
+
+/// Twice the signed area of a polygon (positive: counter-clockwise).
+fn area2(poly: &[(f64, f64)]) -> f64 {
+    let n = poly.len();
+    (0..n)
+        .map(|i| {
+            let (a, b) = (poly[i], poly[(i + 1) % n]);
+            a.0 * b.1 - b.0 * a.1
+        })
+        .sum()
+}
+
+fn cross(a: (f64, f64), b: (f64, f64), c: (f64, f64)) -> f64 {
+    (b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)
+}
+
+/// `q` inside or on triangle `abc` (counter-clockwise).
+fn covers(a: (f64, f64), b: (f64, f64), c: (f64, f64), q: (f64, f64)) -> bool {
+    cross(a, b, q) >= 0.0 && cross(b, c, q) >= 0.0 && cross(c, a, q) >= 0.0
+}
+
+/// Ear-clip a simple counter-clockwise polygon into index triangles,
+/// each counter-clockwise. A polygon with no ear left (degenerate or
+/// self-crossing) is refused, never looped on.
+pub fn triangulate(poly: &[(f64, f64)]) -> Result<Vec<[usize; 3]>, String> {
+    if poly.len() < 3 {
+        return Err("the vise profile has fewer than three corners".into());
+    }
+    let mut ring: Vec<usize> = (0..poly.len()).collect();
+    let mut out = Vec::with_capacity(poly.len().saturating_sub(2));
+    while ring.len() > 3 {
+        let m = ring.len();
+        let ear = (0..m).find(|&i| {
+            let (a, b, c) = (ring[(i + m - 1) % m], ring[i], ring[(i + 1) % m]);
+            cross(poly[a], poly[b], poly[c]) > 0.0
+                && !ring.iter().any(|&k| k != a && k != b && k != c && covers(poly[a], poly[b], poly[c], poly[k]))
+        });
+        let Some(i) = ear else {
+            return Err("the vise profile could not be triangulated (degenerate dimensions)".into());
+        };
+        out.push([ring[(i + m - 1) % m], ring[i], ring[(i + 1) % m]]);
+        ring.remove(i);
+    }
+    if let [a, b, c] = ring[..] {
+        if cross(poly[a], poly[b], poly[c]) <= 0.0 {
+            return Err("the vise profile could not be triangulated (degenerate dimensions)".into());
+        }
+        out.push([a, b, c]);
+    }
+    Ok(out)
+}
+
+/// The closed, outward shell of the vise in its own frame: the profile
+/// extruded over x in [-width/2, width/2]. `p` is assumed checked.
+pub fn solid(p: &ViseParams) -> Result<Vec<Triangle>, String> {
+    let mut poly = profile(p);
+    if area2(&poly) < 0.0 {
+        poly.reverse();
+    }
+    let caps = triangulate(&poly)?;
+    let h = 0.5 * p.width;
+    let at = |x: f64, k: usize| Point3::new(x, poly[k].0, poly[k].1);
+    let mut tris = Vec::with_capacity(2 * caps.len() + 2 * poly.len());
+    for [a, b, c] in &caps {
+        tris.push(Triangle::new(at(h, *a), at(h, *b), at(h, *c)));
+        tris.push(Triangle::new(at(-h, *a), at(-h, *c), at(-h, *b)));
+    }
+    let n = poly.len();
+    for i in 0..n {
+        let j = (i + 1) % n;
+        tris.push(Triangle::new(at(-h, i), at(-h, j), at(h, j)));
+        tris.push(Triangle::new(at(-h, i), at(h, j), at(h, i)));
+    }
+    Ok(tris)
+}
diff --git a/crates/app/src/vise/table.rs b/crates/app/src/vise/table.rs
new file mode 100644
index 00000000..37eb349c
--- /dev/null
+++ b/crates/app/src/vise/table.rs
@@ -0,0 +1,135 @@
+//! The built-in vise size table (#788): typical figures for generic
+//! milling-machine vises at the common jaw widths, 3-8 in and 100-200 mm.
+//! Every row is our own rounded, generic proportion inside the ranges
+//! public catalog spec sheets print for vises of that jaw width (see
+//! `docs/decisions/788-builtin-vises.md`) - no vendor's model is copied.
+//! The user edits any figure to match their own vise.
+//!
+//! Provenance: our own table from published catalog ranges (jaw width,
+//! jaw height, max opening, overall length/width/height).
+
+use super::ViseParams;
+
+/// One row: a label and its figures, all millimetres.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ViseSize {
+    /// What the list shows ("6 in", "150 mm").
+    pub label: &'static str,
+    pub jaw_width: f64,
+    pub jaw_height: f64,
+    pub jaw_thickness: f64,
+    pub max_opening: f64,
+    pub length: f64,
+    pub width: f64,
+    pub base_height: f64,
+    pub housing_length: f64,
+    pub housing_height: f64,
+}
+
+const IN: f64 = 25.4;
+
+/// An imperial row, written in inches.
+#[allow(clippy::too_many_arguments)]
+const fn inch(
+    label: &'static str,
+    jaw_width: f64,
+    jaw_height: f64,
+    jaw_thickness: f64,
+    max_opening: f64,
+    length: f64,
+    width: f64,
+    base_height: f64,
+    housing_length: f64,
+    housing_height: f64,
+) -> ViseSize {
+    ViseSize {
+        label,
+        jaw_width: jaw_width * IN,
+        jaw_height: jaw_height * IN,
+        jaw_thickness: jaw_thickness * IN,
+        max_opening: max_opening * IN,
+        length: length * IN,
+        width: width * IN,
+        base_height: base_height * IN,
+        housing_length: housing_length * IN,
+        housing_height: housing_height * IN,
+    }
+}
+
+/// A metric row, written in millimetres.
+#[allow(clippy::too_many_arguments)]
+const fn mm(
+    label: &'static str,
+    jaw_width: f64,
+    jaw_height: f64,
+    jaw_thickness: f64,
+    max_opening: f64,
+    length: f64,
+    width: f64,
+    base_height: f64,
+    housing_length: f64,
+    housing_height: f64,
+) -> ViseSize {
+    ViseSize {
+        label,
+        jaw_width,
+        jaw_height,
+        jaw_thickness,
+        max_opening,
+        length,
+        width,
+        base_height,
+        housing_length,
+        housing_height,
+    }
+}
+
+/// The built-in sizes, imperial first, each in ascending jaw width.
+/// Columns: jaw width, jaw height, jaw thickness, max opening, overall
+/// length, overall width, base height (floor to table), screw-housing
+/// length and height (above the floor).
+pub const SIZES: &[ViseSize] = &[
+    inch("3 in", 3.0, 1.3125, 1.0, 4.75, 12.0, 4.0, 2.0, 1.5, 0.75),
+    inch("4 in", 4.0, 1.25, 1.25, 6.0, 14.0, 5.25, 2.25, 1.75, 1.0),
+    inch("5 in", 5.0, 1.5, 1.375, 7.0, 16.0, 6.25, 2.5, 2.0, 1.0),
+    inch("6 in", 6.0, 1.75, 1.5, 9.0, 18.5, 7.5, 2.875, 2.25, 1.25),
+    inch("8 in", 8.0, 2.0, 1.75, 8.25, 20.0, 9.5, 3.25, 2.5, 1.5),
+    mm("100 mm", 100.0, 32.0, 25.0, 110.0, 300.0, 125.0, 55.0, 35.0, 20.0),
+    mm("125 mm", 125.0, 40.0, 30.0, 160.0, 360.0, 150.0, 65.0, 40.0, 25.0),
+    mm("150 mm", 150.0, 45.0, 35.0, 200.0, 420.0, 180.0, 70.0, 45.0, 30.0),
+    mm("160 mm", 160.0, 50.0, 38.0, 220.0, 450.0, 190.0, 75.0, 50.0, 30.0),
+    mm("200 mm", 200.0, 62.0, 45.0, 260.0, 550.0, 240.0, 85.0, 60.0, 35.0),
+];
+
+/// The row labelled `label` (exact, then case- and space-blind).
+#[must_use]
+pub fn size(label: &str) -> Option<&'static ViseSize> {
+    let squash = |s: &str| s.chars().filter(|c| !c.is_whitespace()).collect::<String>().to_lowercase();
+    SIZES.iter().find(|s| s.label == label).or_else(|| SIZES.iter().find(|s| squash(s.label) == squash(label)))
+}
+
+impl ViseSize {
+    /// This size's parameters with the jaws `opening` mm apart.
+    #[must_use]
+    pub fn params(&self, opening: f64) -> ViseParams {
+        ViseParams {
+            size: self.label.to_owned(),
+            jaw_width: self.jaw_width,
+            jaw_height: self.jaw_height,
+            jaw_thickness: self.jaw_thickness,
+            max_opening: self.max_opening,
+            length: self.length,
+            width: self.width,
+            base_height: self.base_height,
+            housing_length: self.housing_length,
+            housing_height: self.housing_height,
+            opening,
+        }
+    }
+
+    /// This size, jaws half open (a fresh vise's starting opening).
+    #[must_use]
+    pub fn half_open(&self) -> ViseParams {
+        self.params(0.5 * self.max_opening)
+    }
+}
diff --git a/crates/app/tests/builtin_vise.rs b/crates/app/tests/builtin_vise.rs
new file mode 100644
index 00000000..19570302
--- /dev/null
+++ b/crates/app/tests/builtin_vise.rs
@@ -0,0 +1,277 @@
+//! Built-in vises (#788): the size table's rows build closed, outward
+//! shells of the stated dimensions; nonsense parameters are refused by
+//! name; a vise fitted to the stock opens to it and follows it; a placed
+//! 6 in vise convicts a pass that crosses its jaws and clears one over
+//! them; placing and editing are one undo unit each; the parameters
+//! survive a save and load.
+//!
+//! Gate map (M4.4): covers app::vise, app::commands::builtin_vise,
+//! app::commands::insert_fixture, app::project (fixture vise key),
+//! app::fixture, app::posting.
+
+use std::collections::HashMap;
+
+use camcraft_app::commands::{
+    AddTool, CreateOperation, GenerateOperation, History, ImportModel, InsertVise, SetStock, SetVise, TagFixture,
+    VisePlacement,
+};
+use camcraft_app::fixture;
+use camcraft_app::fixture_view::{self, MeshState};
+use camcraft_app::geometry::{IDENTITY_Q, Mesh, Point3, Triangle};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::project;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::vise::{self, ViseParams};
+use camcraft_app::world::new_world;
+use camcraft_sim::fixture_mesh::FixtureMesh;
+
+const IN: f64 = 25.4;
+
+fn bounds(tris: &[Triangle]) -> ([f64; 3], [f64; 3]) {
+    let mut lo = [f64::MAX; 3];
+    let mut hi = [f64::MIN; 3];
+    for p in tris.iter().flat_map(|t| [t.a, t.b, t.c]) {
+        for (k, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+            lo[k] = lo[k].min(v);
+            hi[k] = hi[k].max(v);
+        }
+    }
+    (lo, hi)
+}
+
+fn key(p: Point3) -> [u64; 3] {
+    [p.x.to_bits(), p.y.to_bits(), p.z.to_bits()]
+}
+
+/// Closed and consistently oriented: every directed edge is met once by
+/// its reverse, and no edge is used twice in one direction.
+fn assert_watertight(tris: &[Triangle], what: &str) {
+    let mut edges: HashMap<([u64; 3], [u64; 3]), i32> = HashMap::new();
+    for t in tris {
+        for (a, b) in [(t.a, t.b), (t.b, t.c), (t.c, t.a)] {
+            *edges.entry((key(a), key(b))).or_default() += 1;
+        }
+    }
+    for ((a, b), n) in &edges {
+        assert_eq!(*n, 1, "{what}: a directed edge used {n} times");
+        assert_eq!(edges.get(&(*b, *a)), Some(&1), "{what}: an edge with no reverse (open shell)");
+    }
+}
+
+fn volume(tris: &[Triangle]) -> f64 {
+    tris.iter()
+        .map(|t| {
+            let (a, b, c) = (t.a, t.b, t.c);
+            a.x * (b.y * c.z - b.z * c.y) - a.y * (b.x * c.z - b.z * c.x) + a.z * (b.x * c.y - b.y * c.x)
+        })
+        .sum::<f64>()
+        / 6.0
+}
+
+/// The profile's area by its parts: base, two jaws, the housing step.
+fn expected_volume(p: &ViseParams) -> f64 {
+    let base = p.length * p.base_height;
+    let jaws = 2.0 * p.jaw_thickness * p.jaw_height;
+    let housing = p.housing_length * p.housing_height;
+    (base + jaws + housing) * p.width
+}
+
+#[test]
+fn every_table_row_builds_a_closed_shell_of_its_dimensions() {
+    let labels: Vec<&str> = vise::SIZES.iter().map(|s| s.label).collect();
+    assert_eq!(
+        labels,
+        ["3 in", "4 in", "5 in", "6 in", "8 in", "100 mm", "125 mm", "150 mm", "160 mm", "200 mm"],
+        "the issue's ten sizes"
+    );
+    for row in vise::SIZES {
+        for frac in [0.01, 0.5, 1.0] {
+            let p = row.params(frac * row.max_opening);
+            p.check().unwrap_or_else(|e| panic!("{} @ {frac}: {e}", row.label));
+            let tris = p.mesh().expect("meshes");
+            let what = format!("{} @ {frac}", row.label);
+            assert_watertight(&tris, &what);
+            let v = volume(&tris);
+            let want = expected_volume(&p);
+            assert!((v - want).abs() < 1e-6 * want, "{what}: outward volume {v} vs {want}");
+            let (lo, hi) = bounds(&tris);
+            let close = |a: f64, b: f64| (a - b).abs() < 1e-9;
+            assert!(close(lo[0], -0.5 * p.width) && close(hi[0], 0.5 * p.width), "{what}: width");
+            assert!(close(hi[1], p.jaw_thickness) && close(lo[1], p.jaw_thickness - p.length), "{what}: length");
+            assert!(close(lo[2], -p.base_height) && close(hi[2], p.jaw_height), "{what}: height");
+            assert!(FixtureMesh::build(&tris).is_ok(), "{what}: the mesh law takes it");
+        }
+    }
+}
+
+#[test]
+fn the_table_keeps_the_issues_starting_figures() {
+    let row = |l: &str| vise::size(l).copied().expect(l);
+    assert!((row("3 in").jaw_height - 1.3125 * IN).abs() < 1e-9);
+    assert!((4.75 * IN..=5.0 * IN).contains(&row("3 in").max_opening));
+    assert!((row("4 in").jaw_height - 1.25 * IN).abs() < 1e-9);
+    assert!((row("4 in").max_opening - 6.0 * IN).abs() < 1e-9);
+    assert!((row("6 in").jaw_height - 1.75 * IN).abs() < 1e-9);
+    assert!((5.5 * IN..=9.0 * IN).contains(&row("6 in").max_opening));
+    assert!((row("8 in").jaw_height - 2.0 * IN).abs() < 1e-9);
+    assert!(row("8 in").max_opening >= 8.25 * IN - 1e-9);
+    for r in vise::SIZES {
+        let w = if r.label.ends_with("in") { r.label.trim_end_matches(" in").parse::<f64>().map(|v| v * IN) } else { r.label.trim_end_matches(" mm").parse::<f64>() };
+        assert_eq!(w.ok(), Some(r.jaw_width), "{}: the jaw width is the label", r.label);
+    }
+    assert!(vise::size("6IN").is_some(), "the lookup is case- and space-blind");
+}
+
+#[test]
+fn nonsense_parameters_are_refused_by_name() {
+    let six = vise::size("6 in").expect("6 in").half_open();
+    let refused = |p: ViseParams, word: &str| {
+        let e = p.mesh().expect_err(word);
+        assert!(e.contains(word), "'{e}' names {word}");
+    };
+    refused(six.with_opening(six.max_opening + 0.01), "over the max opening");
+    refused(six.with_opening(0.0), "jaw opening must be more than zero");
+    refused(six.with_opening(f64::NAN), "jaw opening must be a finite length");
+    refused(ViseParams { jaw_height: f64::INFINITY, ..six.clone() }, "jaw height");
+    refused(ViseParams { base_height: -1.0, ..six.clone() }, "base height");
+    refused(ViseParams { width: six.jaw_width - 1.0, ..six.clone() }, "narrower than its jaw width");
+    refused(ViseParams { length: 100.0, ..six.clone() }, "overall length");
+    let world = new_world();
+    let at = VisePlacement::At(Location::default());
+    assert!(InsertVise::new(&world, &six.with_opening(-3.0), None, at).is_err(), "the command refuses too");
+    assert!(InsertVise::new(&world, &six, None, VisePlacement::FitStock).is_err(), "no stock to fit to");
+}
+
+/// 60 x 60 stock `dz` tall, a 4 mm end mill, a face pass `cut` high.
+fn face_world(dz: f64, cut: f64) -> (flecs_ecs::prelude::World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz }, Location::default()).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("catalog");
+    history.execute(&world, AddTool::new(&world, "EM-0400-2FL", tool).expect("tool"));
+    let params = OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(dz + 5.0),
+        cut_z: Height::fixed(cut),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    };
+    history.execute(&world, CreateOperation::new(&world, "Face1", "EM-0400-2FL", SrcRef::Stock, params).expect("op"));
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    (world, history)
+}
+
+fn six_fitted(world: &flecs_ecs::prelude::World, history: &mut History) -> String {
+    let six = vise::size("6 in").expect("6 in").half_open();
+    let cmd = InsertVise::new(world, &six, None, VisePlacement::FitStock).expect("fits");
+    let name = cmd.name().to_owned();
+    history.execute(world, cmd);
+    name
+}
+
+fn struck(world: &flecs_ecs::prelude::World) -> bool {
+    posting::verification_gate(world).iter().any(|p| p.starts_with("Face1:") && p.contains("strikes a fixture"))
+}
+
+#[test]
+fn a_placed_six_inch_vise_convicts_a_pass_across_its_jaws_and_clears_one_over_them() {
+    let (world, mut history) = face_world(20.0, 19.5);
+    assert!(posting::verification_gate(&world).is_empty(), "a clean world posts");
+    let name = six_fitted(&world, &mut history);
+    assert_eq!(name, "Vise 6 in");
+    let states = fixture_view::mesh_states(&world, None);
+    assert_eq!(states, [(name.clone(), MeshState::Mesh)], "judged by its mesh, not a box");
+    assert!(struck(&world), "the pass runs into jaws standing 1.75 in over the floor");
+
+    let (world, mut history) = face_world(60.0, 59.5);
+    six_fitted(&world, &mut history);
+    let problems = posting::verification_gate(&world);
+    assert!(problems.is_empty(), "the pass runs 15 mm over the jaws: {problems:?}");
+}
+
+#[test]
+fn the_jaw_opening_follows_the_stock() {
+    let (world, mut history) = face_world(20.0, 19.5);
+    let name = six_fitted(&world, &mut history);
+    let e = model::find_by_name(&world, &name).expect("placed");
+    let def = fixture::def_of(&world, &e).expect("a fixture");
+    let p = def.vise.expect("a built-in vise");
+    assert!((p.opening - 60.0).abs() < 1e-9, "opened to the stock's 60 mm: {}", p.opening);
+    let loc = model::transform_of(&world, &e).expect("pose");
+    assert_eq!([loc.pos.x, loc.pos.y, loc.pos.z], [0.0, 30.0, 0.0], "fixed jaw on the stock's +y face, floor under it");
+    let b = model::entity_world_aabb(&world, &e).expect("box");
+    assert!((b.max.z - 1.75 * IN).abs() < 1e-9, "jaws stand 1.75 in over the floor");
+
+    // The stock grows to 80 mm across: the jaws re-open to it.
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 100.0, dz: 20.0 }, Location { pos: Point3::new(0.0, -20.0, 0.0), rot: IDENTITY_Q }).expect("stock"));
+    let stock = model::stock_world_aabb(&world).expect("stock box");
+    assert!((stock.max.y - 30.0).abs() < 1e-9, "still against the fixed jaw: {stock:?}");
+    history.execute(&world, SetVise::opening_from_stock(&world, &name).expect("re-open"));
+    let p = fixture::def_of(&world, &e).and_then(|d| d.vise).expect("vise");
+    assert!((p.opening - 100.0).abs() < 1e-9, "{}", p.opening);
+    let tris = model::world_facets(&world, &e).expect("facets");
+    let (lo, _) = bounds(&tris);
+    assert!(lo[1] < stock.min.y - p.jaw_thickness + 1e-9, "the moving jaw stands beyond the stock");
+
+    // Stock wider than the vise opens, or reaching into the fixed jaw: refused by name.
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 300.0, dz: 20.0 }, Location { pos: Point3::new(0.0, -120.0, 0.0), rot: IDENTITY_Q }).expect("stock"));
+    let e1 = SetVise::opening_from_stock(&world, &name).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e1.contains("max opening"), "{e1}");
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location { pos: Point3::new(0.0, 10.0, 0.0), rot: IDENTITY_Q }).expect("stock"));
+    let e2 = SetVise::opening_from_stock(&world, &name).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e2.contains("into the fixed jaw"), "{e2}");
+    let fresh = new_world();
+    SetStock::new(&fresh, StockShape::Box { dx: 60.0, dy: 300.0, dz: 20.0 }, Location::default())
+        .map(|c| History::default().execute(&fresh, c))
+        .expect("wide stock");
+    let wide = InsertVise::new(&fresh, &vise::size("6 in").expect("6").half_open(), None, VisePlacement::FitStock);
+    assert!(wide.err().is_some_and(|e| e.to_string().contains("opens")), "a fit wider than the max is refused");
+}
+
+#[test]
+fn placing_and_editing_are_one_undo_each_and_survive_a_save() {
+    let (world, mut history) = face_world(20.0, 19.5);
+    let name = six_fitted(&world, &mut history);
+    let e = model::find_by_name(&world, &name).expect("placed");
+    let rev = model::rev_of(&world, &e);
+    history.execute(&world, SetVise::opening(&world, &name, 120.0).expect("open"));
+    let opening = |w: &flecs_ecs::prelude::World| {
+        model::find_by_name(w, &name).and_then(|e| fixture::def_of(w, &e)).and_then(|d| d.vise).map(|v| v.opening)
+    };
+    assert_eq!(opening(&world), Some(120.0));
+    assert!(model::rev_of(&world, &e) > rev, "the geometry revision moves");
+
+    let path = std::env::temp_dir().join(format!("camcraft-builtin-vise-{}.camproj", std::process::id()));
+    project::save(&world, &path).expect("save");
+    let text = std::fs::read_to_string(&path).expect("read");
+    assert!(text.contains("\"vise\"") && text.contains("\"6 in\""), "the marker carries the parameters");
+    let back = new_world();
+    project::load(&back, &path).expect("load");
+    let _ = std::fs::remove_file(&path);
+    assert_eq!(opening(&back), Some(120.0), "the parameters reload");
+    assert!(SetVise::opening(&back, &name, 80.0).is_ok(), "and stay editable");
+
+    assert!(history.undo(&world));
+    assert_eq!(opening(&world), Some(60.0), "one undo takes the edit");
+    assert_eq!(model::rev_of(&world, &e), rev);
+    assert!(history.undo(&world));
+    assert!(model::find_by_name(&world, &name).is_none(), "one undo removes the vise");
+    assert!(history.redo(&world));
+    assert_eq!(opening(&world), Some(60.0), "redo places it again");
+
+    // An imported fixture is not a built-in vise.
+    history.execute(&world, ImportModel::from_mesh("Plate", Mesh::from_facets(vise::size("3 in").expect("3").half_open().mesh().expect("mesh"))));
+    history.execute(&world, TagFixture::new(&world, "Plate", None).expect("tag"));
+    let e = SetVise::opening(&world, "Plate", 10.0).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("not a built-in vise"), "{e}");
+}
diff --git a/crates/app/tests/mcp_vise.rs b/crates/app/tests/mcp_vise.rs
new file mode 100644
index 00000000..ad87ec34
--- /dev/null
+++ b/crates/app/tests/mcp_vise.rs
@@ -0,0 +1,98 @@
+//! The MCP built-in vise tools (#788), driven in-process over the
+//! server's JSON-RPC handler: a 6 in vise fitted to the stock, its jaws
+//! re-opened and resized, every step one undo, every bad input a named
+//! tool error.
+//!
+//! Gate map (M4.4): covers app::mcp::vise_tools.
+
+use camcraft_app::mcp::Server;
+
+use serde_json::{Value, json};
+
+struct Client {
+    server: Server,
+    next: i64,
+}
+
+impl Client {
+    fn new() -> Self {
+        let mut c = Self { server: Server::new(), next: 1 };
+        c.request("initialize", json!({ "protocolVersion": "2025-06-18" }));
+        c
+    }
+
+    fn request(&mut self, method: &str, params: Value) -> Value {
+        let id = self.next;
+        self.next += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params });
+        self.server.handle(&msg).expect("a request gets a response")
+    }
+
+    fn call(&mut self, name: &str, args: Value) -> (bool, Value) {
+        let reply = self.request("tools/call", json!({ "name": name, "arguments": args }));
+        let result = &reply["result"];
+        assert!(result.is_object(), "tools/call answers with a result: {reply}");
+        let is_err = result["isError"] == json!(true);
+        let body = if is_err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() };
+        (is_err, body)
+    }
+
+    fn ok(&mut self, name: &str, args: Value) -> Value {
+        let (err, body) = self.call(name, args);
+        assert!(!err, "{name} refused: {body}");
+        body
+    }
+
+    fn refused(&mut self, name: &str, args: Value) -> String {
+        let (err, body) = self.call(name, args);
+        assert!(err, "{name} should have refused, got {body}");
+        body.as_str().unwrap_or_default().to_owned()
+    }
+}
+
+fn fixtures(c: &mut Client) -> Vec<String> {
+    let f = c.ok("get_fixture_findings", json!({}));
+    f.to_string().match_indices("Vise 6 in").map(|(_, s)| s.to_owned()).collect()
+}
+
+#[test]
+fn a_vise_is_fitted_reopened_and_undone_over_mcp() {
+    let mut c = Client::new();
+    let names: Vec<String> = c.request("tools/list", json!({}))["result"]["tools"]
+        .as_array()
+        .map(|t| t.iter().filter_map(|t| t["name"].as_str().map(str::to_owned)).collect())
+        .unwrap_or_default();
+    for want in ["add_builtin_vise", "set_vise"] {
+        assert!(names.iter().any(|n| n == want), "missing tool {want}");
+    }
+
+    let why = c.refused("add_builtin_vise", json!({ "size": "7 in" }));
+    assert!(why.contains("no built-in vise '7 in'") && why.contains("6 in"), "{why}");
