    "node_id": "C_kwDOVoU8JdoAKDI2NDVhMDIzYmU2ZjQ1MGQ0MDVhMmExZGY1YWRjZmU5ZDk3ZjRkZTU",
    "commit": {
      "author": {
        "name": "Mike Kinney",
