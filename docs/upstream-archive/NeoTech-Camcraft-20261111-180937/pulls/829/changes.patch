+//! #793 acceptance: a built-in taper holder (BT30 / BT40 / CAT40, ER
+//! chuck or Weldon) drops into a tool's holder through one undoable
+//! command, lands as an editable drawn profile, and is judged by the
+//! fixture laws as the shape it is: the BT30 ER20 flange strikes a wall
+//! the plain holder cylinder misses, a long-gauge Weldon clears where a
+//! short one collides, undo restores the previous holder, and nonsense
+//! picks are refused by name.
+//!
+//! Gate map (M4.4): covers app::commands, app::tool_body, app::tools.
+
+use camcraft_app::commands::{AddTool, CommandError, CreateOperation, GenerateOperation, History, SetStock, SetToolBody, TagFixture};
+use camcraft_app::geometry::{Point3, Triangle};
+use camcraft_app::holder_library;
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tool_body;
+use camcraft_app::tools::{catalog, Tool};
+use camcraft_app::verify::{FixturePart, Warning};
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+
+/// A 4 mm end mill on a 6 mm shank: flutes 12, shank 40 - the holder's
+/// nose face stands 52 above the tip.
+const TOOL: &str = "EM-0400-2FL";
+const CUT_Z: f64 = 19.5;
+const CLEAR_Z: f64 = 25.0;
+const NOSE: f64 = 52.0;
+
+fn catalog_tool(name: &str) -> Tool {
+    catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog entry")
+}
+
+fn face_world() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(
+        &world,
+        SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location::default()).expect("stock"),
+    );
+    history.execute(&world, AddTool::new(&world, TOOL, catalog_tool(TOOL)).expect("tool"));
+    history.execute(
+        &world,
+        CreateOperation::new(
+            &world,
+            "Face1",
+            TOOL,
+            SrcRef::Stock,
+            OpParams::Face {
+                holes: Default::default(),
+                tilt: None,
+                blend_turns: false,
+                stepover: 3.0,
+                clearance_z: Height::fixed(CLEAR_Z),
+                cut_z: Height::fixed(CUT_Z),
+                top_z: None,
+                stepdown: None,
+                feed: 1200.0,
+                plunge_feed: 300.0,
+                climb: true,
+            },
+        )
+        .expect("face op"),
+    );
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    (world, history)
+}
+
+/// A vertical wall `dx` off the path's +X edge (radially, from the
+/// tool axis at its outermost pass), from `zb` up `h`, along the
+/// path's whole Y span.
+fn plant_wall(world: &World, history: &mut History, dx: f64, zb: f64, h: f64) {
+    let op = model::find_by_name(world, "Face1").expect("Face1");
+    let cache = model::toolpath_of(world, &op).expect("generated");
+    let xmax = cache.path.moves.iter().flat_map(|m| [m.from.x, m.to.x]).fold(f64::NEG_INFINITY, f64::max);
+    let (y0, y1) = cache
+        .path
+        .moves
+        .iter()
+        .flat_map(|m| [m.from.y, m.to.y])
+        .fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), y| (a.min(y), b.max(y)));
+    let x = xmax + dx;
+    let (a, b, c, d) =
+        (Point3::new(x, y0, zb), Point3::new(x, y1, zb), Point3::new(x, y1, zb + h), Point3::new(x, y0, zb + h));
+    let e = model::spawn(world, "Wall1");
+    model::set_facets(world, &e, vec![Triangle::new(a, b, c), Triangle::new(a, c, d)].into());
+    model::set_rev(world, &e, 1);
+    history.execute(world, TagFixture::new(world, "Wall1", None).expect("tagged"));
+    history.execute(world, GenerateOperation::new(world, "Face1").expect("regenerate"));
+}
+
+fn holder_hits(world: &World) -> usize {
+    let op = model::find_by_name(world, "Face1").expect("Face1");
+    let cache = model::toolpath_of(world, &op).expect("generated");
+    cache.warnings.iter().filter(|w| matches!(w, Warning::FixtureHit { fixture_part: FixturePart::Holder, .. })).count()
+}
+
+fn regenerate(world: &World, history: &mut History) {
+    history.execute(world, GenerateOperation::new(world, "Face1").expect("regenerate"));
+}
+
+fn drawn(world: &World) -> Option<Vec<(f64, f64)>> {
+    let e = model::find_by_name(world, TOOL).expect("tool");
+    tool_body::body_of(world, &e).and_then(|b| b.spun).map(|s| s.points().iter().map(|p| (p.z, p.r)).collect())
+}
+
+#[test]
+fn a_library_holder_lands_as_its_drawn_profile() {
+    let (world, mut history) = face_world();
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT30 ER20", None, None).expect("a library pick"));
+    let want = holder_library::find("BT30 ER20").and_then(|e| e.points(NOSE, e.gauge_len)).expect("draws");
+    assert_eq!(drawn(&world), Some(want.iter().map(|p| (p.z, p.r)).collect()), "nose at the shank top, default gauge 60");
+    let (judged, body) = tool_body::judged(&world, &model::find_by_name(&world, TOOL).expect("tool"), catalog_tool(TOOL)).expect("judged");
+    assert!(body.is_some(), "the laws read its bands");
+    assert!((judged.holder_d - 46.0).abs() < 1e-6, "the enclosing cylinder is the BT30 flange: Ø{}", judged.holder_d);
+    assert!((judged.holder_len - 60.0).abs() < 1e-6, "nose face to gauge line: {}", judged.holder_len);
+    // Gauge length and projection are the caller's to set.
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT30 ER20", Some(80.0), Some(60.0)).expect("set"));
+    let top = drawn(&world).and_then(|p| p.last().map(|q| q.0));
+    assert_eq!(top, Some(140.0));
+}
+
+/// The user's 770MX case: a wall beside the BT30 flange (22.5 mm off
+/// the tool axis, at the flange's height) is missed by the catalog's
+/// Ø44 × 35 holder cylinder - it tops out below the wall - and struck
+/// by the Ø46 flange; raised clear of the gauge line it is clear again.
+#[test]
+fn the_bt30_er20_flange_strikes_a_wall_the_cylinder_misses() {
+    let (world, mut history) = face_world();
+    // Flange: 90-110 above the tip at the default gauge of 60.
+    plant_wall(&world, &mut history, 22.5, CUT_Z + 95.0, 10.0);
+    assert_eq!(holder_hits(&world), 0, "the holder cylinder misses the wall");
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT30 ER20", None, None).expect("pick"));
+    regenerate(&world, &mut history);
+    assert!(holder_hits(&world) > 0, "the BT30 flange strikes it");
+
+    let (world, mut history) = face_world();
+    plant_wall(&world, &mut history, 22.5, CLEAR_Z + NOSE + 60.0 + 5.0, 10.0);
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT30 ER20", None, None).expect("pick"));
+    regenerate(&world, &mut history);
+    assert_eq!(holder_hits(&world), 0, "a wall above the gauge line is clear");
+}
+
+/// A wall 15 mm off the axis at 95-105 above the tip: the 60 mm Weldon
+/// puts its Ø46 flange there and collides; a 100 mm one reaches past
+/// it with its Ø25 body and clears.
+#[test]
+fn a_long_gauge_weldon_clears_where_a_short_one_collides() {
+    let (world, mut history) = face_world();
+    plant_wall(&world, &mut history, 15.0, CUT_Z + 95.0, 10.0);
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT30 Weldon 6 mm", Some(60.0), None).expect("short"));
+    regenerate(&world, &mut history);
+    assert!(holder_hits(&world) > 0, "the short holder's flange collides");
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT30 Weldon 6 mm", Some(100.0), None).expect("long"));
+    regenerate(&world, &mut history);
+    assert_eq!(holder_hits(&world), 0, "the long holder's Ø25 body clears");
+}
+
+#[test]
+fn undo_restores_the_previous_holder() {
+    let (world, mut history) = face_world();
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT40 ER20", None, None).expect("first"));
+    let bt40 = drawn(&world);
+    history.execute(&world, SetToolBody::library(&world, TOOL, "BT30 ER20", None, None).expect("second"));
+    assert_ne!(drawn(&world), bt40);
+    assert!(history.undo(&world));
+    assert_eq!(drawn(&world), bt40, "undo: the BT40 again");
+    assert!(history.undo(&world));
+    assert_eq!(drawn(&world), None, "undo: the holder cylinder again");
+    assert!(history.redo(&world));
+    assert_eq!(drawn(&world), bt40);
+}
+
+#[test]
+fn nonsense_picks_are_refused_by_name() {
+    let (world, _history) = face_world();
+    let refuse = |entry: &str, gauge: Option<f64>, proj: Option<f64>, says: &str| {
+        match SetToolBody::library(&world, TOOL, entry, gauge, proj) {
+            Err(CommandError::Invalid(m)) => assert!(m.contains(says), "{m:?} should say {says:?}"),
+            Err(e) => panic!("wrong refusal {e}"),
+            Ok(_) => panic!("accepted a pick that should say {says:?}"),
+        }
+    };
+    refuse("BT35 ER20", None, None, "no holder 'BT35 ER20'");
+    refuse("BT30 Weldon 12 mm", None, None, "does not fit");
+    refuse("BT30 ER20", Some(20.0), None, "gauge length is shorter");
+    refuse("BT30 ER20", Some(f64::NAN), None, "finite");
+    refuse("BT30 ER20", None, Some(5.0), "reaches into the flutes");
+    assert!(matches!(SetToolBody::library(&world, "nope", "BT30 ER20", None, None), Err(CommandError::NotFound(_))));
+}
diff --git a/crates/tools/src/holder_library.rs b/crates/tools/src/holder_library.rs
new file mode 100644
index 00000000..4a551278
--- /dev/null
+++ b/crates/tools/src/holder_library.rs
@@ -0,0 +1,274 @@
+//! The built-in holder library (#793): steep-taper holders - BT30 and
+//! BT40 (JIS B 6339 / MAS 403 BT), CAT40 (ASME B5.50) - in ER collet
+//! chuck (ISO 15488 / DIN 6499 collets and nuts) and Weldon side-lock
+//! (DIN 1835 form B / DIN 6359 bores) versions, each drawn as a spun
+//! profile (#93) the tool editor drops into a tool's holder. Specced
+//! from the published standards' dimension tables (the numbers and
+//! their sources are recorded in docs/decisions/793-taper-holders.md);
+//! the outlines are our own typical, conservative bodies, not any
+//! vendor's model.
+//!
+//! The laws here:
+//! - **Never smaller than the steel.** The flange is drawn as a full
+//!   cylinder at its outside diameter (the 60-degree gripper groove and
+//!   the drive slots are enveloped, never cut away), the nut at its
+//!   outside diameter over its whole length, and the chuck body as wide
+//!   as its nut.
+//! - **The profile stops at the gauge line.** The taper inside the
+//!   spindle is never in reach of the work; the spindle housing the
+//!   stack laws judge rides on the profile's top, which is the gauge
+//!   line - where the spindle face is.
+//! - **Refusals by name**: an unknown entry, a gauge length too short
+//!   to hold the nut and flange, a shank the collet or bore cannot
+//!   take, a non-finite or negative number.
+
+use crate::spun::SpunPoint;
+
+/// One steep-taper shank: what stands between the gauge line and the
+/// tool (mm).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Taper {
+    pub name: &'static str,
+    /// The taper's diameter at the gauge line.
+    pub gauge_d: f64,
+    /// The V-flange's outside diameter.
+    pub flange_d: f64,
+    /// From the gauge line to the flange's back (spindle-side) face.
+    pub standoff: f64,
+    /// The flange's thickness along the axis.
+    pub flange_t: f64,
+}
+
+impl Taper {
+    /// From the gauge line to the flange's front (tool-side) face.
+    #[must_use]
+    pub fn front_face(&self) -> f64 {
+        self.standoff + self.flange_t
+    }
+
+    /// The radius of the taper between the flange and the gauge line:
+    /// the gauge diameter grown by the 7/24 cone over the standoff, so
+    /// it is never smaller than the cone it stands for.
+    #[must_use]
+    pub fn standoff_r(&self) -> f64 {
+        (self.gauge_d + self.standoff * 7.0 / 24.0) * 0.5
+    }
+}
+
+/// JIS B 6339 / MAS 403 BT30.
+pub const BT30: Taper = Taper { name: "BT30", gauge_d: 31.75, flange_d: 46.0, standoff: 2.0, flange_t: 20.0 };
+/// JIS B 6339 / MAS 403 BT40.
+pub const BT40: Taper = Taper { name: "BT40", gauge_d: 44.45, flange_d: 63.0, standoff: 2.0, flange_t: 25.0 };
+/// ASME B5.50 size 40 (CAT40, V-flange): 1.750 in gauge, 2.500 in
+/// flange, 0.125 in standoff, 0.625 in flange.
+pub const CAT40: Taper = Taper { name: "CAT40", gauge_d: 44.45, flange_d: 63.5, standoff: 3.175, flange_t: 15.875 };
+
+/// One ER collet size (ISO 15488) with its clamping nut (DIN 6499,
+/// the standard round nut, not a slim "mini" nut).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ErSize {
+    pub name: &'static str,
+    /// The smallest and largest shank its collets clamp.
+    pub min_bore: f64,
+    pub max_bore: f64,
+    /// The nut's outside diameter and length along the axis.
+    pub nut_d: f64,
+    pub nut_len: f64,
+}
+
+pub const ER16: ErSize = ErSize { name: "ER16", min_bore: 0.5, max_bore: 10.0, nut_d: 32.0, nut_len: 17.5 };
+pub const ER20: ErSize = ErSize { name: "ER20", min_bore: 1.0, max_bore: 13.0, nut_d: 35.0, nut_len: 19.5 };
+pub const ER25: ErSize = ErSize { name: "ER25", min_bore: 1.0, max_bore: 16.0, nut_d: 42.0, nut_len: 20.0 };
+pub const ER32: ErSize = ErSize { name: "ER32", min_bore: 2.0, max_bore: 20.0, nut_d: 50.0, nut_len: 22.5 };
+
+/// How the holder grips the tool.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Clamp {
+    /// An ER collet chuck: the nut on the nose, a body as wide as the
+    /// nut up to the flange.
+    Er(ErSize),
+    /// A Weldon side-lock holder: a plain body of `body_d` around a
+    /// `bore` for the tool's shank.
+    Weldon { bore: f64, body_d: f64 },
+}
+
+/// One library entry: a taper, a clamp, a default gauge length (from
+/// the gauge line to the holder's nose face).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct HolderEntry {
+    pub taper: Taper,
+    pub clamp: Clamp,
+    pub gauge_len: f64,
+    /// The bore as the entry's name states it ("6 mm", "1/2 in").
+    label: &'static str,
+}
+
+/// The nut, flange and body must leave at least this much (mm) of body
+/// between them: a gauge length that does not is refused.
+pub const MIN_BODY: f64 = 1.0;
+/// The longest gauge length the library draws (mm).
+pub const MAX_GAUGE: f64 = 500.0;
+/// A Weldon bore takes a shank of its own size, within this (mm).
+pub const BORE_SLACK: f64 = 0.02;
+
+/// Why a library pick is refused. Each refusal names itself.
+#[derive(Clone, Debug, PartialEq)]
+pub enum LibraryError {
+    Unknown(String),
+    NonFinite,
+    BelowTip,
+    TooShort { min: f64 },
+    TooLong,
+    Shank { shank_d: f64, takes: String },
+}
+
+impl core::fmt::Display for LibraryError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::Unknown(n) => write!(f, "there is no holder '{n}' in the holder library"),
+            Self::NonFinite => write!(f, "the gauge length and the projection must be finite numbers"),
+            Self::BelowTip => write!(f, "the holder's nose cannot sit below the tool tip (projection < 0)"),
+            Self::TooShort { min } => {
+                write!(f, "the gauge length is shorter than the flange and nose need ({min:.2} mm at least)")
+            }
+            Self::TooLong => write!(f, "the gauge length is longer than {MAX_GAUGE} mm"),
+            Self::Shank { shank_d, takes } => write!(f, "a Ø{shank_d:.3} mm shank does not fit - the holder takes {takes}"),
+        }
+    }
+}
+
+impl std::error::Error for LibraryError {}
+
+impl HolderEntry {
+    /// The name the editor lists and MCP takes: "BT30 ER20",
+    /// "BT40 Weldon 12 mm", "CAT40 Weldon 1/2 in".
+    #[must_use]
+    pub fn name(&self) -> String {
+        match self.clamp {
+            Clamp::Er(er) => format!("{} {}", self.taper.name, er.name),
+            Clamp::Weldon { .. } => format!("{} Weldon {}", self.taper.name, self.label),
+        }
+    }
+
+    /// The shortest gauge length that still holds the flange, the nose
+    /// (nut or body) and [`MIN_BODY`] between them.
+    #[must_use]
+    pub fn min_gauge(&self) -> f64 {
+        let nose = match self.clamp {
+            Clamp::Er(er) => er.nut_len,
+            Clamp::Weldon { .. } => 0.0,
+        };
+        self.taper.front_face() + nose + MIN_BODY
+    }
+
+    /// Can the holder take a shank of `shank_d`? An ER chuck takes its
+    /// collet range, a Weldon bore its own size.
+    pub fn fits_shank(&self, shank_d: f64) -> Result<(), LibraryError> {
+        let (ok, takes) = match self.clamp {
+            Clamp::Er(er) => (
+                shank_d >= er.min_bore - 1e-9 && shank_d <= er.max_bore + 1e-9,
+                format!("{} collets, Ø{}-{} mm", er.name, er.min_bore, er.max_bore),
+            ),
+            Clamp::Weldon { bore, .. } => ((shank_d - bore).abs() <= BORE_SLACK, format!("a Ø{bore:.3} mm shank")),
+        };
+        if ok && shank_d.is_finite() { Ok(()) } else { Err(LibraryError::Shank { shank_d, takes }) }
+    }
+
+    /// The holder's half-outline (tip-up, as the spun profile reads it)
+    /// with its nose face `nose` above the tool tip and the gauge line
+    /// `gauge_len` above the nose: nose (nut or body), body up to the
+    /// flange, the flange, the standoff, closed to the axis at the
+    /// gauge line.
+    pub fn points(&self, nose: f64, gauge_len: f64) -> Result<Vec<SpunPoint>, LibraryError> {
+        if !(nose.is_finite() && gauge_len.is_finite()) {
+            return Err(LibraryError::NonFinite);
+        }
+        if nose < 0.0 {
+            return Err(LibraryError::BelowTip);
+        }
+        let min = self.min_gauge();
+        if gauge_len < min - 1e-9 {
+            return Err(LibraryError::TooShort { min });
+        }
+        if gauge_len > MAX_GAUGE {
+            return Err(LibraryError::TooLong);
+        }
+        let t = &self.taper;
+        let gauge = nose + gauge_len;
+        let front = gauge - t.front_face();
+        let back = gauge - t.standoff;
+        let p = SpunPoint::line;
+        let mut pts = vec![p(nose, 0.0)];
+        match self.clamp {
+            Clamp::Er(er) => {
+                let r = er.nut_d * 0.5;
+                // The nut, then the body as wide as the nut: the nut's
+                // top stays a point of its own so it can be edited.
+                pts.extend([p(nose, r), p(nose + er.nut_len, r), p(front, r)]);
+            }
+            Clamp::Weldon { body_d, .. } => pts.extend([p(nose, body_d * 0.5), p(front, body_d * 0.5)]),
+        }
+        let fr = t.flange_d * 0.5;
+        pts.extend([p(front, fr), p(back, fr), p(back, t.standoff_r()), p(gauge, t.standoff_r()), p(gauge, 0.0)]);
+        // A body as wide as the flange leaves a zero-length step.
+        pts.dedup_by(|b, a| (a.z - b.z).hypot(a.r - b.r) < 1e-9);
+        Ok(pts)
+    }
+}
+
+/// A Weldon bore: its label, bore and typical body diameter (mm).
+type Bore = (&'static str, f64, f64);
+
+/// Metric Weldon bores (DIN 1835 form B shanks) with the body
+/// diameters typical of DIN 6359 side-lock holders.
+const METRIC_BORES: [Bore; 6] =
+    [("6 mm", 6.0, 25.0), ("8 mm", 8.0, 28.0), ("10 mm", 10.0, 35.0), ("12 mm", 12.0, 42.0), ("16 mm", 16.0, 48.0), ("20 mm", 20.0, 52.0)];
+/// Inch Weldon bores with the body diameters typical of inch end-mill
+/// holders (1.00, 1.25, 1.375, 1.75, 1.75 in).
+const INCH_BORES: [Bore; 5] = [
+    ("1/4 in", 6.35, 25.4),
+    ("3/8 in", 9.525, 31.75),
+    ("1/2 in", 12.7, 34.925),
+    ("5/8 in", 15.875, 44.45),
+    ("3/4 in", 19.05, 44.45),
+];
+
+/// Every built-in holder, in the editor's order: by taper, ER chucks
+/// then Weldon holders.
+#[must_use]
+pub fn library() -> Vec<HolderEntry> {
+    let er = |taper: Taper, er: ErSize, gauge_len: f64| HolderEntry { taper, clamp: Clamp::Er(er), gauge_len, label: "" };
+    let weldon = |taper: Taper, b: &Bore, gauge_len: f64| HolderEntry {
+        taper,
+        clamp: Clamp::Weldon { bore: b.1, body_d: b.2 },
+        gauge_len,
+        label: b.0,
+    };
+    let mut v = Vec::new();
+    for e in [ER16, ER20, ER25, ER32] {
+        v.push(er(BT30, e, 60.0));
+    }
+    // BT30's 46 mm flange: the 16 mm and 1/2 in bores are the largest a
+    // BT30 side-lock body is built for.
+    v.extend(METRIC_BORES.iter().filter(|b| b.1 <= 16.0).map(|b| weldon(BT30, b, 60.0)));
+    v.extend(INCH_BORES.iter().filter(|b| b.1 <= 12.7).map(|b| weldon(BT30, b, 60.0)));
+    for e in [ER16, ER20, ER25, ER32] {
+        v.push(er(BT40, e, 70.0));
+    }
+    v.extend(METRIC_BORES.iter().chain(INCH_BORES.iter()).map(|b| weldon(BT40, b, 63.0)));
+    v.push(er(CAT40, ER32, 70.0));
+    v.extend(INCH_BORES.iter().chain(METRIC_BORES.iter()).map(|b| weldon(CAT40, b, 63.5)));
+    v
+}
+
+/// The library entry called `name` (as [`HolderEntry::name`] states it,
+/// case and spacing ignored).
+pub fn find(name: &str) -> Result<HolderEntry, LibraryError> {
+    let key = |s: &str| s.split_whitespace().collect::<Vec<_>>().join(" ").to_ascii_lowercase();
+    let want = key(name);
+    library().into_iter().find(|e| key(&e.name()) == want).ok_or_else(|| LibraryError::Unknown(name.to_owned()))
+}
+
+#[cfg(test)]
+#[path = "holder_library_tests.rs"]
+mod tests;
diff --git a/crates/tools/src/holder_library_tests.rs b/crates/tools/src/holder_library_tests.rs
