new file mode 100644
index 00000000..b3f18a85
--- /dev/null
+++ b/crates/motion/src/bin/camcraft-motion.rs
@@ -0,0 +1,129 @@
+//! `camcraft-motion` - headless toolpath generator (M13.3): runs the
+//! serpentine facing generator over a rectangle and writes a CLFile.
+//! Provenance: facing passes per the `machining2d::face` module
+//! (public machining literature); the CLI shape and the CL text dump
+//! (`cl::text`) are ours.
+
+use camcraft_motion::cl::text;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::machining2d::{face, FaceHoles, FaceParams};
+use std::process::ExitCode;
+
+const USAGE: &str = "\
+camcraft-motion - CamCraft toolpath generator (headless)
+
+USAGE:
+    camcraft-motion face [OPTIONS] <x0> <y0> <x1> <y1> <tool-diameter> <stepover> <cut-z> <clearance-z>
+
+Faces the rectangle x0..x1, y0..y1 (mm) at cut-z with serpentine
+passes and writes the toolpath as a CL text dump (stdout by default).
+Exits non-zero on nonsense parameters or an unwritable output.
+
+OPTIONS:
+    -o <file>         write the CLFile here instead of stdout
+    --feed <mm/min>   cutting feed (default 1000)
+    -h, --help        print this text
+    --version         print the version
+";
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let mut out: Option<String> = None;
+    let mut feed = 1000.0f64;
+    let mut pos: Vec<String> = Vec::new();
+    let mut it = args.iter();
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "-h" | "--help" => {
+                print!("{USAGE}");
+                return ExitCode::SUCCESS;
+            }
+            "--version" => {
+                println!("camcraft-motion {}", env!("CARGO_PKG_VERSION"));
+                return ExitCode::SUCCESS;
+            }
+            "-o" => match it.next() {
+                Some(v) => out = Some(v.clone()),
+                None => return die("-o needs a value".into()),
+            },
+            "--feed" => match it.next().map(|v| v.parse::<f64>()) {
+                Some(Ok(v)) if v.is_finite() && v > 0.0 => feed = v,
+                _ => return die("--feed needs a positive number".into()),
+            },
+            o if o.starts_with("--") => return die(format!("unknown option {o:?} (try --help)")),
+            o => pos.push(o.to_string()),
+        }
+    }
+    let [cmd, rest @ ..] = pos.as_slice() else {
+        return die("expected a command (try --help)".into());
+    };
+    if cmd != "face" {
+        return die(format!("unknown command {cmd:?} (try --help)"));
+    }
+    if rest.len() != 8 {
+        return die("face takes eight numbers (try --help)".into());
+    }
+    let mut n = [0.0f64; 8];
+    for (slot, s) in n.iter_mut().zip(rest) {
+        match s.parse::<f64>() {
+            Ok(v) if v.is_finite() => *slot = v,
+            _ => return die(format!("not a finite number: {s:?}")),
+        }
+    }
+    let [x0, y0, x1, y1, d, stepover, cut_z, clearance_z] = n;
+    if !(x1 > x0 && y1 > y0) {
+        return die("rectangle needs x0 < x1 and y0 < y1".into());
+    }
+    if clearance_z <= cut_z {
+        return die("clearance-z must be above cut-z".into());
+    }
+    let corners = vec![
+        Point2::new(x0, y0),
+        Point2::new(x1, y0),
+        Point2::new(x1, y1),
+        Point2::new(x0, y1),
+    ];
+    let region = match Loop::new(corners).and_then(|l| Region::new(vec![l])) {
+        Ok(r) => r,
+        Err(e) => return die(format!("bad rectangle: {e}")),
+    };
+    let p = FaceParams {
+        tool_diameter: d,
+        stepover,
+        clearance_z,
+        cut_z,
+        top_z: None,
+        stepdown: None,
+        feed,
+        plunge_feed: feed / 3.0,
+        climb: true,
+        blend_turns: false,
+        holes: FaceHoles::default(),
+    };
+    let path = match face(&region, &p) {
+        Ok(t) => t,
+        Err(e) => return die(e.to_string()),
+    };
+    let dump = match text::to_text(&path) {
+        Ok(s) => s,
+        Err(e) => return die(e),
+    };
+    for note in &path.notes {
+        eprintln!("camcraft-motion: note: {note}");
+    }
+    match out {
+        Some(f) => {
+            if let Err(e) = std::fs::write(&f, &dump) {
+                return die(format!("cannot write {f}: {e}"));
+            }
+            eprintln!("camcraft-motion: {} moves written to {f}", path.len());
+        }
+        None => print!("{dump}"),
+    }
+    ExitCode::SUCCESS
+}
+
+fn die(msg: String) -> ExitCode {
+    eprintln!("camcraft-motion: {msg}");
+    ExitCode::FAILURE
+}
diff --git a/crates/motion/tests/headless_bin.rs b/crates/motion/tests/headless_bin.rs
new file mode 100644
index 00000000..9beb605e
--- /dev/null
+++ b/crates/motion/tests/headless_bin.rs
@@ -0,0 +1,54 @@
+//! M13.3: the `camcraft-motion` headless binary - facing a rectangle
+//! writes a CLFile that reads back as a chained path at the cut depth;
+//! nonsense parameters exit non-zero with a message, never a panic
+//! (Prime Directive).
+//!
+//! Gate map (M4.4): covers camcraft-motion src/bin/camcraft-motion.rs.
+//!
+//! Provenance: our own fixtures, from the facing generator's contract.
+
+use camcraft_motion::cl::text;
+use std::process::{Command, Output};
+
+fn run(args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_camcraft-motion")).args(args).output().expect("spawn")
+}
+
+#[test]
+fn motion_bin_faces_a_rectangle() {
+    let f = std::env::temp_dir().join(format!("cc-motion-{}-face.cl", std::process::id()));
+    let fs = f.to_string_lossy().into_owned();
+    let o = run(&["face", "-o", &fs, "0", "0", "40", "20", "10", "6", "-1", "5"]);
+    assert!(o.status.success(), "{}", String::from_utf8_lossy(&o.stderr));
+    let src = std::fs::read_to_string(&f).expect("output written");
+    assert!(src.starts_with("; HSMW-CL v1"), "{src}");
+    let t = text::from_text(&src).expect("reads back");
+    assert!(t.is_chained() && t.len() > 3, "{src}");
+    assert!(t.moves.iter().any(|m| (m.to.z + 1.0).abs() < 1e-9), "{src}");
+    // stdout carries the same dump when no -o is given.
+    let o = run(&["face", "0", "0", "40", "20", "10", "6", "-1", "5"]);
+    assert_eq!(String::from_utf8_lossy(&o.stdout), src);
+    let _ = std::fs::remove_file(f);
+}
+
+#[test]
+fn motion_bin_refuses_bad_input() {
+    let unwritable = std::env::temp_dir().join("cc-motion-no-such-dir").join("out.cl");
+    let unwritable = unwritable.to_string_lossy().into_owned();
+    for args in [
+        &["face", "0", "0", "40", "20", "10", "0", "-1", "5"][..], // zero stepover
+        &["face", "0", "0", "40", "20", "-10", "6", "-1", "5"],    // negative tool
+        &["face", "40", "0", "0", "20", "10", "6", "-1", "5"],     // flipped box
+        &["face", "0", "0", "40", "20", "10", "6", "5", "-1"],     // clearance below cut
+        &["face", "0", "0", "40", "20", "10", "6", "inf", "5"],
+        &["face", "0", "0"],
+        &["pocket"],
+        &["face", "-o", &unwritable, "0", "0", "40", "20", "10", "6", "-1", "5"],
+        &[],
+    ] {
+        let o = run(args);
+        let err = String::from_utf8_lossy(&o.stderr);
+        assert_eq!(o.status.code(), Some(1), "{args:?}: {err}");
+        assert!(err.contains("camcraft-motion: ") && !err.contains("panicked"), "{args:?}: {err}");
+    }
+}
