index 00000000..0ffbf042
--- /dev/null
+++ b/crates/sim/src/bin/camcraft-sim.rs
@@ -0,0 +1,151 @@
+//! `camcraft-sim` - headless stock simulation (M13.3): cuts a box of
+//! stock with a CLFile's moves on the dexel grid and prints the removed
+//! volume and a rapid/depth verdict. Provenance: dexel (height-field)
+//! stock removal is general CAM verification practice from published
+//! literature, as the `stock_sim` module states; the CLI is ours.
+
+use camcraft_sim::cl::{text, MoveKind};
+use camcraft_sim::stock_sim::{auto_cell, simulate, Dexel, SimOp};
+use std::process::ExitCode;
+
+const USAGE: &str = "\
+camcraft-sim - CamCraft stock simulation (headless)
+
+USAGE:
+    camcraft-sim [OPTIONS] <file.cl> <x0> <y0> <z0> <x1> <y1> <z1> <tool-diameter>
+
+Cuts the stock box x0..x1, y0..y1, z0..z1 (mm) with the CLFile's moves
+using a flat end mill (or --ball) of the given diameter, then prints
+the removed volume and the verdict.
+
+EXIT:
+    0  simulated, no flags
+    1  bad input (unreadable or malformed file, nonsense numbers)
+    2  simulated, verdict flagged (a rapid that travels sideways or
+       descends below the stock top inside the stock footprint, or a
+       cut below the stock bottom)
+
+OPTIONS:
+    --ball            ball-nose tool instead of a flat end mill
+    --cell <mm>       grid cell size (default: from the tool and box)
+    -h, --help        print this text
+    --version         print the version
+";
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let mut ball = false;
+    let mut cell: Option<String> = None;
+    let mut pos: Vec<String> = Vec::new();
+    let mut it = args.iter();
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "-h" | "--help" => {
+                print!("{USAGE}");
+                return ExitCode::SUCCESS;
+            }
+            "--version" => {
+                println!("camcraft-sim {}", env!("CARGO_PKG_VERSION"));
+                return ExitCode::SUCCESS;
+            }
+            "--ball" => ball = true,
+            "--cell" => match it.next() {
+                Some(v) => cell = Some(v.clone()),
+                None => return die("--cell needs a value".into()),
+            },
+            o if o.starts_with("--") => return die(format!("unknown option {o:?} (try --help)")),
+            o => pos.push(o.to_string()),
+        }
+    }
+    let [path, rest @ ..] = pos.as_slice() else {
+        return die("expected a CLFile path and seven numbers (try --help)".into());
+    };
+    if rest.len() != 7 {
+        return die("expected a CLFile path and seven numbers (try --help)".into());
+    }
+    let mut n = [0.0f64; 7];
+    for (slot, s) in n.iter_mut().zip(rest) {
+        match s.parse::<f64>() {
+            Ok(v) if v.is_finite() => *slot = v,
+            _ => return die(format!("not a finite number: {s:?}")),
+        }
+    }
+    let [x0, y0, z0, x1, y1, z1, d] = n;
+    if !(x1 > x0 && y1 > y0 && z1 > z0) {
+        return die("stock box needs x0 < x1, y0 < y1, z0 < z1".into());
+    }
+    if d <= 0.0 {
+        return die("tool diameter must be positive".into());
+    }
+    let r = d / 2.0;
+    let cell = match cell.as_deref().map(str::parse::<f64>) {
+        None => auto_cell(r, x1 - x0, y1 - y0),
+        Some(Ok(c)) if c.is_finite() && c > 0.0 => c,
+        Some(_) => return die("--cell must be a positive number".into()),
+    };
+    let src = match std::fs::read_to_string(path) {
+        Ok(s) => s,
+        Err(e) => return die(format!("cannot read {path}: {e}")),
+    };
+    let t = match text::from_text(&src) {
+        Ok(t) => t,
+        Err(e) => return die(format!("cannot parse {path}: {e}")),
+    };
+    let mut dex = match Dexel::block(x0, y0, x1, y1, z1, cell) {
+        Ok(d) => d,
+        Err(e) => return die(e.to_string()),
+    };
+    let op = SimOp { moves: &t.moves, radius: r, ball, cone: None, corner: None };
+    if let Err(e) = simulate(&mut dex, &[op]) {
+        return die(e.to_string());
+    }
+    // Removed volume: per column, the stock surface down to what stands,
+    // floored at the stock bottom (the grid has no floor of its own).
+    let a2 = dex.cell * dex.cell;
+    let (mut removed, mut cut_cells, mut lowest) = (0.0f64, 0usize, z1);
+    for k in 0..dex.nx * dex.ny {
+        let top = dex.top_at(k);
+        if top.is_finite() && top < z1 {
+            removed += (z1 - top.max(z0)) * a2;
+            cut_cells += 1;
+            lowest = lowest.min(top);
+        }
+    }
+    let inside = |x: f64, y: f64| x > x0 - r && x < x1 + r && y > y0 - r && y < y1 + r;
+    let bad_rapids = t
+        .moves
+        .iter()
+        .filter(|m| m.kind == MoveKind::Rapid)
+        .filter(|m| {
+            // A straight-up retract leaves through the air it cut; a
+            // rapid that travels sideways or descends below the stock
+            // top inside the footprint may meet material at rapid feed.
+            let sideways = m.from.x != m.to.x || m.from.y != m.to.y;
+            let below = m.from.z.min(m.to.z) < z1;
+            below
+                && (sideways || m.to.z < m.from.z)
+                && (inside(m.from.x, m.from.y) || inside(m.to.x, m.to.y))
+        })
+        .count();
+    let through = lowest < z0;
+    println!("file: {path}");
+    println!("moves: {}", t.len());
+    println!("grid: {} x {} cells of {cell:.4} mm", dex.nx, dex.ny);
+    println!("stock volume: {:.3} mm^3", (x1 - x0) * (y1 - y0) * (z1 - z0));
+    println!("removed volume: {removed:.3} mm^3");
+    println!("cut cells: {cut_cells}");
+    println!("lowest cut: {lowest:.4}");
+    println!("rapids into the stock: {bad_rapids}");
+    println!("cut below stock bottom: {through}");
+    if bad_rapids > 0 || through {
+        println!("verdict: FLAGGED");
+        return ExitCode::from(2);
+    }
+    println!("verdict: ok (rapid and depth check only - no part, no gouge verdict)");
+    ExitCode::SUCCESS
+}
+
+fn die(msg: String) -> ExitCode {
+    eprintln!("camcraft-sim: {msg}");
+    ExitCode::FAILURE
+}
diff --git a/crates/sim/tests/headless_bin.rs b/crates/sim/tests/headless_bin.rs
new file mode 100644
index 00000000..23fe0855
--- /dev/null
+++ b/crates/sim/tests/headless_bin.rs
@@ -0,0 +1,90 @@
+//! M13.3: the `camcraft-sim` headless binary - a slot cut in a box
+//! removes its own volume and passes; a rapid through the stock is
+//! flagged (exit 2); a missing file or a nonsense box exits 1 with a
+//! message, never a panic (Prime Directive).
+//!
+//! Gate map (M4.4): covers camcraft-sim src/bin/camcraft-sim.rs.
+//!
+//! Provenance: our own fixtures, from the dexel removal law.
+
+use std::ffi::OsString;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output};
+
+fn tmp(name: &str, body: &str) -> PathBuf {
+    let p = std::env::temp_dir().join(format!("cc-sim-{}-{name}", std::process::id()));
+    std::fs::write(&p, body).expect("write fixture");
+    p
+}
+
+fn run(args: &[OsString]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_camcraft-sim")).args(args).output().expect("spawn")
+}
+
+/// The CLFile plus the stock box 0..40 x 0..20 x -10..0 and a 10 mm tool.
+fn with_box(p: &Path) -> Vec<OsString> {
+    let mut a = vec![p.as_os_str().to_os_string()];
+    a.extend(["0", "0", "-10", "40", "20", "0", "10"].map(OsString::from));
+    a
+}
+
+/// A 10 mm end mill slotting 1 mm deep from x=10 to x=30 along y=10.
+const SLOT: &str = "START 10000 10000 5000\nPlunge 10000 10000 -1000 F300000\n\
+Feed 30000 10000 -1000 F1000000\nRapid 30000 10000 5000\n";
+
+#[test]
+fn sim_bin_removes_a_slot() {
+    let p = tmp("slot.cl", SLOT);
+    let o = run(&with_box(&p));
+    let out = String::from_utf8_lossy(&o.stdout);
+    assert!(o.status.success(), "{out}{}", String::from_utf8_lossy(&o.stderr));
+    // A 20 x 10 band plus two 5 mm half discs, 1 mm deep.
+    let v: f64 = out
+        .lines()
+        .find_map(|l| l.strip_prefix("removed volume: "))
+        .and_then(|s| s.trim_end_matches(" mm^3").parse().ok())
+        .expect("removed volume line");
+    let want = 200.0 + 25.0 * std::f64::consts::PI;
+    assert!((v - want).abs() < want * 0.03, "removed {v}, want ~{want}\n{out}");
+    assert!(out.contains("verdict: ok"), "{out}");
+    let _ = std::fs::remove_file(p);
+}
+
+#[test]
+fn sim_bin_flags_a_rapid_through_stock() {
+    let p = tmp(
+        "rapid.cl",
+        "START 10000 10000 5000\nRapid 10000 10000 -2000\nRapid 30000 10000 -2000\n",
+    );
+    let o = run(&with_box(&p));
+    let out = String::from_utf8_lossy(&o.stdout);
+    assert_eq!(o.status.code(), Some(2), "{out}");
+    assert!(out.contains("rapids into the stock: 2") && out.contains("verdict: FLAGGED"), "{out}");
+    let _ = std::fs::remove_file(p);
+}
+
+#[test]
+fn sim_bin_refuses_bad_input() {
+    let corrupt = tmp("corrupt.cl", "START 0 0 0\nFeed x y z\n");
+    let good = tmp("good.cl", SLOT);
+    let mut flipped = with_box(&good);
+    flipped.swap(1, 4); // x0 = 40 > x1 = 0
+    let mut nan = with_box(&good);
+    nan[7] = "NaN".into();
+    let cases = vec![
+        with_box(Path::new("no-such-file.cl")),
+        with_box(&corrupt),
+        flipped,
+        nan,
+        vec![good.clone().into_os_string(), "1".into()],
+        vec![],
+    ];
+    for args in cases {
+        let o = run(&args);
+        let err = String::from_utf8_lossy(&o.stderr);
+        assert_eq!(o.status.code(), Some(1), "{args:?}: {err}");
+        assert!(err.starts_with("camcraft-sim: ") && !err.contains("panicked"), "{args:?}: {err}");
+    }
+    let _ = std::fs::remove_file(corrupt);
+    let _ = std::fs::remove_file(good);
+}
diff --git a/crates/tools/src/bin/camcraft-tools.rs b/crates/tools/src/bin/camcraft-tools.rs
new file mode 100644
index 00000000..3ec910bb
--- /dev/null
+++ b/crates/tools/src/bin/camcraft-tools.rs
@@ -0,0 +1,100 @@
+//! `camcraft-tools` - headless tool-catalog CLI (M13.3): lists and
+//! sanity-checks the built-in catalog, and computes speeds and feeds
+//! from the cutting table. Provenance: n = Vc*1000/(pi*D) and
+//! vf = fz*z*n are the public machining-handbook formulas the
+//! `cutting` module already states; the CLI shape is ours.
+
+use camcraft_tools::cutting::{feed_for, fz_scale, rpm_for};
+use camcraft_tools::tools::{catalog, ToolMaterial, WorkMaterial};
+use std::process::ExitCode;
+
+const USAGE: &str = "\
+camcraft-tools - CamCraft tool catalog (headless)
+
+USAGE:
+    camcraft-tools list
+    camcraft-tools speeds <work-material> <tool-material> <diameter-mm> <flutes>
+
+COMMANDS:
+    list      print the built-in catalog; exits non-zero if any tool
+              fails its sanity check
+    speeds    spindle speed and feed window from the cutting table
+
+    work materials: aluminium_6061 mild_steel stainless_304
+                    grey_cast_iron brass plastics_pom
+    tool materials: hss carbide
+
+OPTIONS:
+    -h, --help        print this text
+    --version         print the version
+";
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    match args.first().map(String::as_str) {
+        None => die("expected a command (try --help)".into()),
+        Some("-h" | "--help") => {
+            print!("{USAGE}");
+            ExitCode::SUCCESS
+        }
+        Some("--version") => {
+            println!("camcraft-tools {}", env!("CARGO_PKG_VERSION"));
+            ExitCode::SUCCESS
+        }
+        Some("list") if args.len() == 1 => list(),
+        Some("speeds") if args.len() == 5 => speeds(&args[1], &args[2], &args[3], &args[4]),
+        Some("list" | "speeds") => die("wrong number of arguments (try --help)".into()),
+        Some(other) => die(format!("unknown command {other:?} (try --help)")),
+    }
+}
+
+fn die(msg: String) -> ExitCode {
+    eprintln!("camcraft-tools: {msg}");
+    ExitCode::FAILURE
+}
+
+fn list() -> ExitCode {
+    let mut bad = 0usize;
+    for (name, t) in catalog() {
+        let ok = t.is_sane();
+        bad += usize::from(!ok);
+        println!(
+            "{name:<28} {:<10} D{:<8.3} flute {:<8.3} {}",
+            format!("{:?}", t.kind),
+            t.diameter,
+            t.flute_len,
+            if ok { "ok" } else { "INSANE" }
+        );
+    }
+    if bad > 0 {
+        return die(format!("{bad} catalog tool(s) fail the sanity check"));
+    }
+    ExitCode::SUCCESS
+}
+
+fn speeds(work: &str, tool: &str, d: &str, z: &str) -> ExitCode {
+    let Some(wm) = WorkMaterial::from_word(work) else {
+        return die(format!("unknown work material {work:?} (try --help)"));
+    };
+    let Some(tm) = ToolMaterial::from_word(tool) else {
+        return die(format!("unknown tool material {tool:?} (try --help)"));
+    };
+    let d = match d.parse::<f64>() {
+        Ok(v) if v.is_finite() && v > 0.0 && v <= 1000.0 => v,
+        _ => return die(format!("diameter must be a number in (0, 1000] mm, got {d:?}")),
+    };
+    let z = match z.parse::<u32>() {
+        Ok(v) if (1..=64).contains(&v) => v,
+        _ => return die(format!("flutes must be an integer in 1..=64, got {z:?}")),
+    };
+    let w = wm.window(tm);
+    let s = fz_scale(d);
+    let (fz0, fz1) = (w.fz10.0 * s, w.fz10.1 * s);
+    let (n0, n1) = (rpm_for(w.vc.0, d), rpm_for(w.vc.1, d));
+    println!("material: {} / {}", wm.word(), tm.label());
+    println!("vc: {:.0}..{:.0} m/min", w.vc.0, w.vc.1);
+    println!("fz: {fz0:.4}..{fz1:.4} mm/tooth");
+    println!("rpm: {n0:.0}..{n1:.0}");
+    println!("feed: {:.0}..{:.0} mm/min", feed_for(fz0, z, n0), feed_for(fz1, z, n1));
+    ExitCode::SUCCESS
+}
