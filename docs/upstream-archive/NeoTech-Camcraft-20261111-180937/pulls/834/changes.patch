+
+/// Does the entry show under the kind filter? A machine whose file
+/// states no kind shows only under "All".
+pub(crate) fn matches_filter(e: &MachineEntry, want: Option<Kind>) -> bool {
+    want.is_none_or(|k| e.kind == Some(k))
