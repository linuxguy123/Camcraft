From 8384ed9c4c838089e970660f6f1af2e564ef2d9b Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Wed, 11 Nov 2026 16:53:09 +0100
Subject: [PATCH] refactor(app): remove the unused tool-body view helpers

Since #837 the simulation draws the tool through sim_tool_body, so
tool_body_view::assembly_for_operation had no callers and bare_assembly
was reached only from it and from its own test. Remove both, the test
that exercised bare_assembly, and the ToolKind import they alone used.
No behaviour change.

Fixes #857

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 crates/app/src/tool_body_view.rs   | 36 +-----------------------------
 crates/app/tests/tool_body_view.rs | 14 ------------
 2 files changed, 1 insertion(+), 49 deletions(-)

diff --git a/crates/app/src/tool_body_view.rs b/crates/app/src/tool_body_view.rs
index 722c30c0..d1179415 100644
--- a/crates/app/src/tool_body_view.rs
+++ b/crates/app/src/tool_body_view.rs
@@ -20,7 +20,7 @@ use crate::geometry::{Point3, Triangle};
 use crate::model;
 use crate::schema::ToolBody;
 use crate::tool_body;
-use crate::tools::{Tool, ToolKind};
+use crate::tools::Tool;
 use camcraft_tools::spun::{SpunPoint, SpunProfile};
 
 /// The six model directions the editor offers as the tool axis.
@@ -221,40 +221,6 @@ pub(crate) fn revolve(prof: &[(f64, f64)]) -> Vec<Triangle> {
     out
 }
 
-/// The tool with no body, for display, tool frame: its whole
-/// `Tool::profile` revolved - cutter, shank, and the holder cylinder
-/// (Ø holder_d × holder_len on the shank top), the very cylinder
-/// `HolderStack::cylinder` hands the collision laws. `None` for the
-/// lathe insert kinds: their profile is a stand-in envelope (the truth
-/// lives in the work's meridian), so drawing it spun would show a tool
-/// that is not there - they keep the axis marker only.
-#[must_use]
-pub fn bare_assembly(tool: &Tool) -> Option<Vec<Triangle>> {
-    if matches!(tool.kind, ToolKind::Turning | ToolKind::Groove | ToolKind::Thread | ToolKind::Form) {
-        return None;
-    }
-    let prof: Vec<(f64, f64)> = tool.profile().into_iter().filter(|&(z, r)| z.is_finite() && r.is_finite()).collect();
-    let tris = revolve(&prof);
-    (!tris.is_empty()).then_some(tris)
-}
-
-/// The display assembly of the tool operation `op` runs, tool frame:
-/// with a body, [`assembly`]; without one, [`bare_assembly`] (`None`
-/// for the lathe insert kinds, which keep the marker only).
-#[must_use]
-pub fn assembly_for_operation(world: &World, op: &str) -> Option<Vec<Triangle>> {
-    let e = model::find_by_name(world, op)?;
-    let tool_name = model::operation_of(world, &e)?.tool;
-    let te = model::find_by_name(world, &tool_name)?;
-    let tool = model::tool_of(world, &te)?;
-    match tool_body::body_of(world, &te) {
-        // A lathe-frame body (#369) sits in the turning tool frame, not
-        // the spindle frame this assembly draws in: the bare tool stands.
-        Some(body) if body.profile().is_some() => Some(assembly(&tool, &body)),
-        _ => bare_assembly(&tool),
-    }
-}
-
 /// The body on the tool operation `op` runs, if that tool has one.
 #[must_use]
 pub fn body_for_operation(world: &World, op: &str) -> Option<ToolBody> {
diff --git a/crates/app/tests/tool_body_view.rs b/crates/app/tests/tool_body_view.rs
index 3495d519..fe5a4221 100644
--- a/crates/app/tests/tool_body_view.rs
+++ b/crates/app/tests/tool_body_view.rs
@@ -178,17 +178,3 @@ fn the_display_assembly_runs_from_the_tip_through_the_shank_into_the_body() {
     let steel = &all[..all.len() - high.facets.len()];
     assert!((zr(steel).1 - (zs + 10.0)).abs() < 1e-9, "no floating body");
 }
-
-#[test]
-fn without_a_body_the_display_is_the_profile_with_its_holder_cylinder() {
-    let t = catalog_tool(TOOL);
-    let tris = view::bare_assembly(&t).expect("a mill draws");
-    let zh = t.flute_len + t.shank_len + t.holder_len;
-    let (lo, hi) = tris.iter().flat_map(|q| [q.a.z, q.b.z, q.c.z]).fold((f64::INFINITY, f64::NEG_INFINITY), |a, z| (a.0.min(z), a.1.max(z)));
-    assert_eq!((lo, hi), (0.0, zh), "tip to the holder's top");
-    let r_top = tris.iter().flat_map(|q| [q.a, q.b, q.c]).filter(|p| (p.z - zh).abs() < 1e-9).map(|p| p.x.hypot(p.y)).fold(0.0, f64::max);
-    assert!((r_top - t.holder_d * 0.5).abs() < 1e-9, "the holder cylinder's radius");
-    // The lathe insert kinds keep the marker only.
-    let insert = catalog().into_iter().map(|(_, t)| t).find(|t| t.kind == camcraft_app::tools::ToolKind::Turning).expect("a turning insert in the catalog");
-    assert!(view::bare_assembly(&insert).is_none());
-}
