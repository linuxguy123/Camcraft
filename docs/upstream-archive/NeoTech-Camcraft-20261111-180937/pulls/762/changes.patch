+    if (floating) words.push(qword(206, feed), qword(211, dwell));
+    else words.push(qword(239, pitch));
+  } else {
+    if (type !== "SPOT" && type !== "DRILL" && type !== "PECK" && type !== "DEEP") {
+      cycleBad("unsupported cycle kind " + type); return;
