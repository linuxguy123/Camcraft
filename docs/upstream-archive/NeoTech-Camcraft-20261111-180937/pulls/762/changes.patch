+#[test]
+fn cycle_signatures_redefine_on_feed_dwell_surface_and_tapping_mode_changes() {
+    let mut rs = setup(3000.0);
+    let mut n = 0;
+    let make = |x, kind, r, bottom, dwell, feed| hole(kind, x, r, bottom, 0.0, dwell, Some(feed));
