+    add_hole(&mut rs, &mut n, hole(CycleKind::Bore, 50.0, 2.0, -8.0, 0.0, 0.25, Some(100.0)), None);
+    add_hole(&mut rs, &mut n, hole(CycleKind::BackBore, 70.0, 2.0, -8.0, 0.0, 0.25, Some(100.0)), None);
+    finish(&mut rs);
