+    assert!(definition(&bs, "G205").contains("Q208=FMAX"));
+    assert_qs(definition(&bs, "G200"), &[(200,"+0"),(201,"-8"),(206,"+90"),(202,"+4"),(210,"+0"),(203,"+0"),(204,"+0"),(211,"+0"),(395,"+0")]);
+    assert_eq!(calls(&bs), 2);
+}
