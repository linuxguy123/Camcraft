diff --git a/crates/app/tests/mcp_self_centering_vise.rs b/crates/app/tests/mcp_self_centering_vise.rs
new file mode 100644
index 00000000..1c21149c
--- /dev/null
+++ b/crates/app/tests/mcp_self_centering_vise.rs
@@ -0,0 +1,103 @@
+//! The MCP built-in vise tools with a 5-axis self-centering vise (#787),
+//! driven in-process over the server's JSON-RPC handler: listed among the
+//! sizes, fitted centred on the stock, its lip and clamping range edited
+//! through the `dimensions` object, every bad input a named tool error,
+//! every step one undo.
+//!
+//! Gate map (M4.4): covers app::mcp::vise_tools.
+
+use camcraft_app::mcp::Server;
+
+use serde_json::{Value, json};
+
+struct Client {
+    server: Server,
+    next: i64,
+}
+
+impl Client {
+    fn new() -> Self {
+        let mut c = Self { server: Server::new(), next: 1 };
+        c.request("initialize", json!({ "protocolVersion": "2025-06-18" }));
+        c
+    }
+
+    fn request(&mut self, method: &str, params: Value) -> Value {
+        let id = self.next;
+        self.next += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params });
+        self.server.handle(&msg).expect("a request gets a response")
+    }
+
+    fn call(&mut self, name: &str, args: Value) -> (bool, Value) {
+        let reply = self.request("tools/call", json!({ "name": name, "arguments": args }));
+        let result = &reply["result"];
+        assert!(result.is_object(), "tools/call answers with a result: {reply}");
+        let is_err = result["isError"] == json!(true);
+        let body = if is_err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() };
+        (is_err, body)
+    }
+
+    fn ok(&mut self, name: &str, args: Value) -> Value {
+        let (err, body) = self.call(name, args);
+        assert!(!err, "{name} refused: {body}");
+        body
+    }
+
+    fn refused(&mut self, name: &str, args: Value) -> String {
+        let (err, body) = self.call(name, args);
+        assert!(err, "{name} should have refused, got {body}");
+        body.as_str().unwrap_or_default().to_owned()
+    }
+}
+
+#[test]
+fn a_self_centering_vise_is_fitted_edited_and_undone_over_mcp() {
+    let mut c = Client::new();
+    let tools = c.request("tools/list", json!({}));
+    let add = tools["result"]["tools"]
+        .as_array()
+        .and_then(|t| t.iter().find(|t| t["name"] == json!("add_builtin_vise")))
+        .cloned()
+        .expect("add_builtin_vise is listed");
+    let sizes = add["inputSchema"]["properties"]["size"]["enum"].to_string();
+    for want in ["52 mm self-centering", "75 mm self-centering", "80 mm self-centering", "125 mm self-centering", "6 in"] {
+        assert!(sizes.contains(want), "{want} in {sizes}");
+    }
+
+    c.ok("set_stock", json!({ "box": { "dx": 40.0, "dy": 50.0, "dz": 20.0 } }));
+    let why = c.refused("add_builtin_vise", json!({ "size": "52 mm self-centering", "fit_to_stock": true }));
+    assert!(why.contains("wider than its clamping range"), "{why}");
+    let placed = c.ok("add_builtin_vise", json!({ "size": "80 mm self-centering", "fit_to_stock": true }));
+    assert_eq!(placed["fixture"], json!("Vise 80 mm self-centering"), "{placed}");
+    assert_eq!(placed["origin"], json!([0.0, 0.0, 0.0]), "centred on the stock: {placed}");
+    assert_eq!(placed["vise"]["style"], json!("self-centering"), "{placed}");
+    assert_eq!(placed["vise"]["opening"], json!(50.0), "{placed}");
+    assert_eq!(placed["vise"]["min_opening"], json!(0.0), "{placed}");
+    let name = "Vise 80 mm self-centering";
+
+    let why = c.refused("set_vise", json!({ "name": name, "dimensions": { "lip_height": 3.0 } }));
+    assert!(why.contains("both a height and a depth"), "{why}");
+    let why = c.refused("set_vise", json!({ "name": name, "dimensions": { "housing_length": 20.0 } }));
+    assert!(why.contains("no screw housing"), "{why}");
+    let why = c.refused("set_vise", json!({ "name": name, "opening": 200.0 }));
+    assert!(why.contains("clamping range"), "{why}");
+    let set = c.ok("set_vise", json!({ "name": name, "dimensions": { "lip_height": 3.0, "lip_depth": 5.0, "min_opening": 10.0 } }));
+    assert_eq!(set["vise"]["lip_height"], json!(3.0), "{set}");
+    assert_eq!(set["vise"]["min_opening"], json!(10.0), "{set}");
+    let set = c.ok("set_vise", json!({ "name": name, "opening": 60.0 }));
+    assert_eq!(set["vise"]["opening"], json!(60.0), "{set}");
+    let set = c.ok("set_vise", json!({ "name": name, "from_stock": true }));
+    assert_eq!(set["vise"]["opening"], json!(50.0), "closed on the stock again: {set}");
+
+    // A standard vise has no clamping-range floor or lip.
+    c.ok("add_builtin_vise", json!({ "size": "6 in", "position": [0.0, 200.0, 0.0] }));
+    let why = c.refused("set_vise", json!({ "name": "Vise 6 in", "dimensions": { "min_opening": 1.0 } }));
+    assert!(why.contains("self-centering vise's"), "{why}");
+
+    for _ in 0..5 {
+        c.ok("undo", json!({}));
+    }
+    let f = c.ok("get_fixture_findings", json!({})).to_string();
+    assert!(!f.contains("Vise 80 mm self-centering"), "five undos take the 6 in, three edits and the vise: {f}");
+}
diff --git a/crates/app/tests/self_centering_vise.rs b/crates/app/tests/self_centering_vise.rs
new file mode 100644
index 00000000..372d248f
--- /dev/null
+++ b/crates/app/tests/self_centering_vise.rs
@@ -0,0 +1,274 @@
+//! Built-in 5-axis self-centering vises (#787): the four rows build closed,
+//! outward shells of the stated dimensions (with and without the dovetail
+//! lip, closed, half and fully open); nonsense parameters and stock outside
+//! the clamping range are refused by name; a fitted vise sits centred on
+//! the stock with both jaws against it and re-closes when the stock
+//! changes; placing and editing are one undo each and survive a save.
+//!
+//! Gate map (M4.4): covers app::vise, app::vise::self_centering,
+//! app::commands::builtin_vise, app::project (fixture vise key).
+
+use std::collections::HashMap;
+
+use camcraft_app::commands::{History, InsertVise, SetStock, SetVise, VisePlacement};
+use camcraft_app::fixture;
+use camcraft_app::geometry::{IDENTITY_Q, Point3, Triangle};
+use camcraft_app::model;
+use camcraft_app::project;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::vise::{self, SelfCentering, ViseParams, ViseStyle};
+use camcraft_app::world::new_world;
+use camcraft_sim::fixture_mesh::FixtureMesh;
+use flecs_ecs::prelude::World;
+
+const LABELS: [&str; 4] = ["52 mm self-centering", "75 mm self-centering", "80 mm self-centering", "125 mm self-centering"];
+
+fn row(label: &str) -> ViseParams {
+    vise::size(label).map(vise::ViseSize::half_open).expect(label)
+}
+
+fn sc_of(p: &ViseParams) -> SelfCentering {
+    match p.style {
+        ViseStyle::SelfCentering(sc) => sc,
+        ViseStyle::Standard => panic!("{} is not self-centering", p.size),
+    }
+}
+
+fn bounds(tris: &[Triangle]) -> ([f64; 3], [f64; 3]) {
+    let mut lo = [f64::MAX; 3];
+    let mut hi = [f64::MIN; 3];
+    for p in tris.iter().flat_map(|t| [t.a, t.b, t.c]) {
+        for (k, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+            lo[k] = lo[k].min(v);
+            hi[k] = hi[k].max(v);
+        }
+    }
+    (lo, hi)
+}
+
+fn key(p: Point3) -> [u64; 3] {
+    [p.x.to_bits(), p.y.to_bits(), p.z.to_bits()]
+}
+
+fn assert_watertight(tris: &[Triangle], what: &str) {
+    let mut edges: HashMap<([u64; 3], [u64; 3]), i32> = HashMap::new();
+    for t in tris {
+        for (a, b) in [(t.a, t.b), (t.b, t.c), (t.c, t.a)] {
+            *edges.entry((key(a), key(b))).or_default() += 1;
+        }
+    }
+    for ((a, b), n) in &edges {
+        assert_eq!(*n, 1, "{what}: a directed edge used {n} times");
+        assert_eq!(edges.get(&(*b, *a)), Some(&1), "{what}: an edge with no reverse (open shell)");
+    }
+}
+
+fn volume(tris: &[Triangle]) -> f64 {
+    tris.iter()
+        .map(|t| {
+            let (a, b, c) = (t.a, t.b, t.c);
+            a.x * (b.y * c.z - b.z * c.y) - a.y * (b.x * c.z - b.z * c.x) + a.z * (b.x * c.y - b.y * c.x)
+        })
+        .sum::<f64>()
+        / 6.0
+}
+
+/// Body, two jaw bodies, two lips - all prisms across the overall width.
+fn expected_volume(p: &ViseParams) -> f64 {
+    let sc = sc_of(p);
+    (p.length * p.base_height + 2.0 * p.jaw_body_depth * p.jaw_height + 2.0 * sc.lip_depth * sc.lip_height) * p.width
+}
+
+fn with_lip(p: &ViseParams, h: f64, d: f64) -> ViseParams {
+    let mut q = p.clone();
+    if let ViseStyle::SelfCentering(sc) = &mut q.style {
+        sc.lip_height = h;
+        sc.lip_depth = d;
+    }
+    q
+}
+
+fn assert_shell(p: &ViseParams, what: &str) {
+    p.check().unwrap_or_else(|e| panic!("{what}: {e}"));
+    let tris = p.mesh().expect("meshes");
+    assert_watertight(&tris, what);
+    let (v, want) = (volume(&tris), expected_volume(p));
+    assert!((v - want).abs() < 1e-6 * want, "{what}: outward volume {v} vs {want}");
+    let (lo, hi) = bounds(&tris);
+    let close = |a: f64, b: f64| (a - b).abs() < 1e-9;
+    assert!(close(lo[0], -0.5 * p.width) && close(hi[0], 0.5 * p.width), "{what}: width");
+    assert!(close(lo[1], -0.5 * p.length) && close(hi[1], 0.5 * p.length), "{what}: length, centred");
+    let top = p.jaw_height + sc_of(p).lip_height;
+    assert!(close(lo[2], -p.base_height) && close(hi[2], top), "{what}: height");
+    let m = FixtureMesh::build(&tris).unwrap_or_else(|e| panic!("{what}: the mesh law refuses it: {e:?}"));
+    // Both jaws are steel at their mid-depth, the gap between them air.
+    let z = 0.5 * p.jaw_height;
+    let y = 0.5 * p.opening + 0.5 * p.jaw_body_depth;
+    assert!(m.contains(Point3::new(0.0, y, z)) && m.contains(Point3::new(0.0, -y, z)), "{what}: both jaws solid");
+    if p.opening > 1.0 {
+        assert!(!m.contains(Point3::new(0.0, 0.0, z)), "{what}: the gap is open");
+    }
+}
+
+#[test]
+fn every_self_centering_row_builds_a_closed_shell_of_its_dimensions() {
+    let labels: Vec<&str> = vise::presets().filter(|r| matches!(r.style, ViseStyle::SelfCentering(_))).map(|r| r.label).collect();
+    assert_eq!(labels, LABELS, "the issue's four sizes, after the standard table");
+    assert_eq!(vise::SIZES.len() + LABELS.len(), vise::presets().count());
+    for label in LABELS {
+        let p = row(label);
+        let sc = sc_of(&p);
+        for opening in [sc.min_opening, 0.5 * (sc.min_opening + p.max_opening), p.max_opening] {
+            let q = p.with_opening(opening);
+            assert_shell(&q, &format!("{label} @ {opening}"));
+            assert_shell(&with_lip(&q, 3.0, 0.5 * q.jaw_body_depth), &format!("{label} @ {opening} lipped"));
+            assert_shell(&with_lip(&q, 2.0, q.jaw_body_depth), &format!("{label} @ {opening} full-depth lip"));
+        }
+    }
+    // Jaws at the body's ends at the max opening: flush, still one shell.
+    let p = row("80 mm self-centering");
+    let flush = ViseParams { length: p.max_opening + 2.0 * p.jaw_body_depth, ..p.with_opening(p.max_opening) };
+    assert_shell(&flush, "80 mm, jaws at the body's ends");
+}
+
+#[test]
+fn the_table_keeps_the_issues_starting_figures() {
+    for (label, min, max) in [
+        ("52 mm self-centering", 3.5, 38.5),
+        ("75 mm self-centering", 0.0, 40.0),
+        ("80 mm self-centering", 0.0, 127.0),
+        ("125 mm self-centering", 0.0, 208.0),
+    ] {
+        let p = row(label);
+        assert_eq!((sc_of(&p).min_opening, p.max_opening), (min, max), "{label}: clamping range");
+        let jaw: f64 = label.split(' ').next().and_then(|w| w.parse().ok()).expect("a width");
+        assert_eq!(p.jaw_width, jaw, "{label}: the jaw width is the label");
+        assert_eq!(p.width, p.jaw_width, "{label}: narrow - the body no wider than the jaws");
+        assert_eq!((p.housing_length, p.housing_height), (0.0, 0.0), "{label}: no screw housing");
+        assert!(p.jaw_body_depth >= p.jaw_thickness, "{label}: the jaw body includes its plate");
+    }
+    assert!(vise::size("80MM self-centering").is_some(), "the lookup is case- and space-blind");
+    assert_eq!(vise::size("125 mm").map(|r| r.style), Some(ViseStyle::Standard), "the standard 125 mm keeps its label");
+}
+
+#[test]
+fn nonsense_parameters_are_refused_by_name() {
+    let p = row("52 mm self-centering");
+    let refused = |q: ViseParams, word: &str| {
+        let e = q.mesh().expect_err(word);
+        assert!(e.contains(word), "'{e}' names {word}");
+    };
+    refused(p.with_opening(3.0), "outside its clamping range 3.500-38.500");
+    refused(p.with_opening(39.0), "outside its clamping range");
+    refused(p.with_opening(f64::NAN), "jaw opening must be a finite length");
+    refused(ViseParams { jaw_height: f64::INFINITY, ..p.clone() }, "jaw height");
+    refused(ViseParams { base_height: 0.0, ..p.clone() }, "base height");
+    refused(ViseParams { housing_length: 10.0, ..p.clone() }, "no screw housing");
+    refused(ViseParams { width: 40.0, ..p.clone() }, "narrower than its jaw width");
+    refused(ViseParams { jaw_body_depth: 5.0, ..p.clone() }, "less than its jaw thickness");
+    refused(ViseParams { length: 60.0, ..p.clone() }, "overall length");
+    refused(with_lip(&p, 3.0, 0.0), "both a height and a depth");
+    refused(with_lip(&p, 3.0, 20.0), "lip depth");
+    refused(with_lip(&p, f64::NAN, 2.0), "lip height must be a finite length");
+    refused(with_lip(&p, -1.0, 2.0), "lip height must not be negative");
+    let mut q = p.clone();
+    if let ViseStyle::SelfCentering(sc) = &mut q.style {
+        sc.min_opening = 40.0;
+    }
+    refused(q, "min opening");
+
+    // Stock outside the clamping range, at placement.
+    for (dy, word) in [(50.0, "wider than its clamping range"), (2.0, "narrower than its clamping range")] {
+        let world = new_world();
+        History::default().execute(&world, SetStock::new(&world, StockShape::Box { dx: 30.0, dy, dz: 10.0 }, Location::default()).expect("stock"));
+        let e = InsertVise::new(&world, &p, None, VisePlacement::FitStock).err().map(|e| e.to_string()).unwrap_or_default();
+        assert!(e.contains(word), "{dy} mm stock: '{e}' names {word}");
+    }
+}
+
+/// Stock `dx` x `dy` x 20 centred at (`cx`, `cy`), floor at z 0.
+fn stock(world: &World, history: &mut History, dx: f64, dy: f64, cx: f64, cy: f64) {
+    let loc = Location { pos: Point3::new(cx, cy, 0.0), rot: IDENTITY_Q };
+    history.execute(world, SetStock::new(world, StockShape::Box { dx, dy, dz: 20.0 }, loc).expect("stock"));
+}
+
+fn params_of(world: &World, name: &str) -> Option<ViseParams> {
+    model::find_by_name(world, name).and_then(|e| fixture::def_of(world, &e)).and_then(|d| d.vise)
+}
+
+#[test]
+fn a_fitted_vise_is_centred_on_the_stock_and_closes_on_it() {
+    let world = new_world();
+    let mut history = History::default();
+    stock(&world, &mut history, 60.0, 30.0, 12.0, -7.0);
+    let cmd = InsertVise::new(&world, &row("80 mm self-centering"), None, VisePlacement::FitStock).expect("fits");
+    let name = cmd.name().to_owned();
+    assert_eq!(name, "Vise 80 mm self-centering");
+    history.execute(&world, cmd);
+    let e = model::find_by_name(&world, &name).expect("placed");
+    let loc = model::transform_of(&world, &e).expect("pose");
+    assert_eq!([loc.pos.x, loc.pos.y, loc.pos.z], [12.0, -7.0, 0.0], "centred on the stock, floor under it");
+    let p = params_of(&world, &name).expect("a built-in vise");
+    assert!((p.opening - 30.0).abs() < 1e-9, "closed to the stock's 30 mm: {}", p.opening);
+
+    // Both jaw faces touch the stock's sides: steel just outside each,
+    // air just inside.
+    let tris = model::world_facets(&world, &e).expect("facets");
+    let m = FixtureMesh::build(&tris).expect("mesh");
+    let s = model::stock_world_aabb(&world).expect("stock box");
+    for (y, out) in [(s.max.y, 1.0), (s.min.y, -1.0)] {
+        assert!(m.contains(Point3::new(12.0, y + 0.5 * out, 5.0)), "a jaw against the stock at y {y}");
+        assert!(!m.contains(Point3::new(12.0, y - 0.5 * out, 5.0)), "no steel inside the stock at y {y}");
+    }
+    assert!(m.contains(Point3::new(12.0, -7.0, -1.0)) && !m.contains(Point3::new(12.0, -7.0, 1.0)), "the floor under the stock");
+
+    // The stock grows, still centred: the jaws close on it again.
+    stock(&world, &mut history, 60.0, 90.0, 12.0, -7.0);
+    history.execute(&world, SetVise::opening_from_stock(&world, &name).expect("re-close"));
+    assert_eq!(params_of(&world, &name).map(|p| p.opening), Some(90.0));
+    // Off the vise's centre, or past the clamping range: refused by name.
+    stock(&world, &mut history, 60.0, 30.0, 12.0, 3.0);
+    let e = SetVise::opening_from_stock(&world, &name).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("off the self-centering vise's centre"), "{e}");
+    stock(&world, &mut history, 60.0, 130.0, 12.0, -7.0);
+    let e = SetVise::opening_from_stock(&world, &name).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("wider than its clamping range"), "{e}");
+}
+
+#[test]
+fn placing_and_editing_are_one_undo_each_and_survive_a_save() {
+    let world = new_world();
+    let mut history = History::default();
+    stock(&world, &mut history, 40.0, 30.0, 0.0, 0.0);
+    let cmd = InsertVise::new(&world, &row("75 mm self-centering"), None, VisePlacement::FitStock).expect("fits");
+    let name = cmd.name().to_owned();
+    history.execute(&world, cmd);
+    let e = model::find_by_name(&world, &name).expect("placed");
+    let before = model::facets_of(&world, &e).expect("facets").to_vec();
+    let lipped = with_lip(&params_of(&world, &name).expect("vise").with_opening(36.0), 4.0, 6.0);
+    history.execute(&world, SetVise::new(&world, &name, lipped.clone()).expect("edit"));
+    assert_eq!(params_of(&world, &name), Some(lipped.clone()));
+    let after = model::facets_of(&world, &e).expect("facets").to_vec();
+    assert_ne!(after, before, "the edit regenerates the mesh");
+
+    let path = std::env::temp_dir().join(format!("camcraft-sc-vise-{}.camproj", std::process::id()));
+    project::save(&world, &path).expect("save");
+    let text = std::fs::read_to_string(&path).expect("read");
+    assert!(text.contains("\"self_centering\"") && text.contains("\"min_opening\""), "the marker carries the style");
+    let back = new_world();
+    project::load(&back, &path).expect("load");
+    let _ = std::fs::remove_file(&path);
+    assert_eq!(params_of(&back, &name), Some(lipped), "the parameters reload, style and lip included");
+    let refused = SetVise::opening(&back, &name, 41.0).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(refused.contains("clamping range"), "and stay judged by its own law: {refused}");
+
+    assert!(history.undo(&world));
+    assert_eq!(model::facets_of(&world, &e).expect("facets").to_vec(), before, "one undo takes the edit");
+    assert_eq!(params_of(&world, &name).map(|p| p.opening), Some(30.0));
+    assert!(history.undo(&world));
+    assert!(model::find_by_name(&world, &name).is_none(), "one undo removes the vise");
+    assert!(history.redo(&world));
+    assert!(history.redo(&world));
+    assert_eq!(model::find_by_name(&world, &name).and_then(|e| model::facets_of(&world, &e)).map(|f| f.to_vec()), Some(after), "redo both");
+}
diff --git a/crates/app/tests/self_centering_vise_tilted.rs b/crates/app/tests/self_centering_vise_tilted.rs
new file mode 100644
index 00000000..0321c185
--- /dev/null
+++ b/crates/app/tests/self_centering_vise_tilted.rs
@@ -0,0 +1,153 @@
+//! Built-in self-centering vises in tilted setups (#787, #339 slice 3):
+//! the fixture laws judge the placed vise's mesh against the posed stack.
+//! A tool leaning 30 deg toward a jaw, its tip low beside the stock,
+//! strikes the jaw - where the same tip upright clears it - and the same
+//! lean from the vise's centre clears. End to end, a 3+2 face indexed
+//! B 10 deg over stock clamped in the vise posts clean, and raising the
+//! jaws into the pass blocks the post.
+//!
+//! Gate map (M4.4): covers app::vise::self_centering, app::fixture,
+//! app::fixture_struck, app::posting, app::verify.
+
+use camcraft_app::cl::{Move, MoveKind, Toolpath, is_vertical};
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, InsertVise, SetStock, SetVise, VisePlacement};
+use camcraft_app::fixture;
+use camcraft_app::fixture_struck;
+use camcraft_app::fixture_view::{self, MeshState};
+use camcraft_app::geometry::Point3;
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef, Tilt};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+use camcraft_app::vise::{self, ViseParams};
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// 40 x 30 x 30 stock centred on the origin (x -20..20, y -15..15, z
+/// 0..30), a 4 mm end mill (flute 12, shank r3, holder r22), a face on
+/// the stock's top `tilt`ed or not, and the 80 mm self-centering vise
+/// fitted to the stock: jaws closed to 30 mm (faces at y +-15, 25 mm deep,
+/// 15 mm tall), body x -40..40 under the floor.
+fn clamped(tilt: Option<Tilt>) -> (World, History, String) {
+    let world = new_world();
+    let mut history = History::default();
+    let stock = SetStock::new(&world, StockShape::Box { dx: 40.0, dy: 30.0, dz: 30.0 }, Location::default());
+    history.execute(&world, stock.expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("catalog");
+    history.execute(&world, AddTool::new(&world, "EM-0400-2FL", tool).expect("tool"));
+    let params = OpParams::Face {
+        holes: Default::default(),
+        tilt,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(40.0),
+        cut_z: Height::fixed(29.5),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    };
+    history.execute(&world, CreateOperation::new(&world, "Face1", "EM-0400-2FL", SrcRef::Stock, params).expect("op"));
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    let sc = vise::size("80 mm self-centering").map(vise::ViseSize::half_open).expect("80 mm row");
+    let cmd = InsertVise::new(&world, &sc, None, VisePlacement::FitStock).expect("fits");
+    let name = cmd.name().to_owned();
+    history.execute(&world, cmd);
+    (world, history, name)
+}
+
+/// The post gate's own per-op law (`fixture_struck::op_hits`: box broad
+/// phase, mesh-refined, posed stack) for `moves` cut by Face1's tool.
+fn hits(world: &World, moves: Vec<Move>) -> Vec<Warning> {
+    let e = model::find_by_name(world, "Face1").expect("op");
+    let op = model::operation_of(world, &e).expect("operation");
+    let (turning, fixed) = fixture::workholding_for(world, op.setup.as_deref());
+    let meshes = fixture::meshes_for(world, op.setup.as_deref());
+    fixture_struck::op_hits(world, &op, &Toolpath::new(moves), &turning, &fixed, &meshes).expect("judged")
+}
+
+/// The tool axis leaning `deg` from vertical toward +y (an A-type lean).
+fn lean_y(deg: f64) -> [f64; 3] {
+    let (s, c) = deg.to_radians().sin_cos();
+    [0.0, s, c]
+}
+
+/// A feed past the stock's +x end, tip 2 mm over the floor (13 mm under
+/// the jaw tops), `y` off the vise's centre, with `axis` (None: upright).
+fn pass(y: f64, axis: Option<[f64; 3]>) -> Vec<Move> {
+    let m = Move::new(MoveKind::Feed, p(22.0, y, 2.0), p(30.0, y, 2.0), Some(800.0));
+    vec![match axis {
+        Some(a) => m.with_axis(a),
+        None => m,
+    }]
+}
+
+#[test]
+fn a_tool_leaning_into_a_jaw_strikes_it_where_upright_it_clears() {
+    let (world, _history, name) = clamped(None);
+    assert_eq!(fixture_view::mesh_states(&world, None), [(name, MeshState::Mesh)], "judged by its mesh, not a box");
+    // Tip 10 mm off centre: the 4 mm cutter stands 3 mm clear of the
+    // jaw face at y 15. Upright, nothing above the tip reaches the jaw.
+    let upright = hits(&world, pass(10.0, None));
+    assert!(upright.is_empty(), "upright, the cutter clears the jaw by 3 mm: {upright:?}");
+    // Leaning 30 deg toward that jaw, the flute crosses y 15 about 6.5 mm
+    // up the axis, at z ~7 - inside the 15 mm tall jaw.
+    let tilted = hits(&world, pass(10.0, Some(lean_y(30.0))));
+    assert!(
+        tilted.iter().any(|w| matches!(w, Warning::FixtureHit { at: 0, .. })),
+        "the leaning tool strikes the jaw: {tilted:?}"
+    );
+    // The same lean the other way runs away from it, toward the far jaw
+    // 25 mm off: clear.
+    let away = hits(&world, pass(10.0, Some(lean_y(-30.0))));
+    assert!(away.is_empty(), "leaning away clears: {away:?}");
+}
+
+#[test]
+fn the_same_lean_from_the_vise_centre_clears_the_jaws() {
+    let (world, _history, _name) = clamped(None);
+    // From y 0 the flute and shank reach y 15 only above z ~22, and the
+    // holder's low rim stays above z 36: over the 15 mm jaws.
+    let tilted = hits(&world, pass(0.0, Some(lean_y(30.0))));
+    assert!(tilted.is_empty(), "the leaning stack passes over the jaws: {tilted:?}");
+    // The box law alone convicts it (the vise's one box covers the move);
+    // the mesh is what clears it.
+    let (turning, _) = fixture::workholding_for(&world, None);
+    assert!(turning.iter().any(|b| b.min.z < 2.0 && b.max.z > 2.0 && b.min.x < 22.0 && b.max.x > 30.0), "inside the vise's box");
+}
+
+fn struck(world: &World) -> bool {
+    posting::verification_gate(world).iter().any(|p| p.starts_with("Face1:") && p.contains("strikes a fixture"))
+}
+
+#[test]
+fn a_tilted_face_over_the_clamped_stock_posts_and_raised_jaws_block_it() {
+    let tilt = Tilt { a_deg: 0.0, b_deg: 10.0, origin: [0.0, 0.0, 30.0] };
+    let (world, mut history, name) = clamped(Some(tilt));
+    let e = model::find_by_name(&world, "Face1").expect("op");
+    let path = model::toolpath_of(&world, &e).expect("generated").path;
+    assert!(
+        !path.moves.is_empty() && path.moves.iter().all(|m| m.axis.is_some_and(|a| !is_vertical(&a))),
+        "the 3+2 index poses every move"
+    );
+    assert!(!struck(&world), "the tilted face runs ~10 mm over the jaws: {:?}", posting::verification_gate(&world));
+    // Jaws raised to 28 mm (a taller jaw set): the pass, overhanging the
+    // stock's sides by the cutter, now runs into them.
+    let tall = model::find_by_name(&world, &name)
+        .and_then(|v| fixture::def_of(&world, &v))
+        .and_then(|d| d.vise)
+        .map(|p| ViseParams { jaw_height: 28.0, ..p })
+        .expect("the vise");
+    history.execute(&world, SetVise::new(&world, &name, tall).expect("taller jaws"));
+    assert!(struck(&world), "the gate names the strike: {:?}", posting::verification_gate(&world));
+    assert!(history.undo(&world));
+    assert!(!struck(&world), "undo puts the low jaws back");
+}
diff --git a/crates/ui/src/egui_app/fixture_self_centering_tests.rs b/crates/ui/src/egui_app/fixture_self_centering_tests.rs
new file mode 100644
index 00000000..b2a88683
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_self_centering_tests.rs
@@ -0,0 +1,145 @@
+//! #787 in the shell, structurally: the built-in vise dialog lists the
+//! 5-axis self-centering sizes in their own row; picking one swaps the
+//! screw-housing fields for the clamping range floor and the dovetail
+//! lip, and Place fits it centred on the stock in one undoable step; a
+//! stock outside the clamping range is refused by name in the dialog;
+//! the placed vise's row closes its jaws on the stock through `SetVise`.
+//! Driven through the real dialog and page code in a kittest harness - no
+//! pixels (the snapshot lane is release).
+//! Provenance: our own tests over our own shell.
+
+use egui::Vec2;
+use egui_kittest::Harness;
+use egui_kittest::kittest::Queryable;
+
+use camcraft_app::commands::SetStock;
+use camcraft_app::fixture;
+use camcraft_app::model;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+
+use crate::state::{CommandKind, FixtureLibDialog, State};
+
+use super::fixture_library_dialog::window;
+
+const NAME: &str = "Vise 80 mm self-centering";
+
+fn with_stock(dy: f64) -> State {
+    let mut state = State::new();
+    let cmd = SetStock::new(&state.world, StockShape::Box { dx: 60.0, dy, dz: 20.0 }, Location::default());
+    state.history.execute(&state.world, cmd.expect("stock"));
+    state.doc_version += 1;
+    state
+}
+
+fn dialog(state: State) -> Harness<'static, State> {
+    Harness::builder().with_size(Vec2::new(900.0, 1100.0)).build_ui_state(
+        |ui, st: &mut State| {
+            st.drain_actions();
+            window(ui.ctx(), st);
+        },
+        state,
+    )
+}
+
+fn opened(mut state: State) -> Harness<'static, State> {
+    state.pending.push_back(CommandKind::BuiltinViseDialog(String::new()));
+    let mut h = dialog(state);
+    h.run();
+    h
+}
+
+fn opening(state: &State, name: &str) -> Option<f64> {
+    model::find_by_name(&state.world, name)
+        .and_then(|e| fixture::def_of(&state.world, &e))
+        .and_then(|d| d.vise)
+        .map(|v| v.opening)
+}
+
+#[test]
+fn the_dialog_lists_the_self_centering_sizes_and_their_own_fields() {
+    let mut h = opened(with_stock(40.0));
+    for label in ["5-axis self-centering", "52 mm self-centering", "75 mm self-centering", "80 mm self-centering", "125 mm self-centering", "150 mm"] {
+        assert!(h.query_by_label(label).is_some(), "the dialog shows {label}");
+    }
+    assert!(h.query_by_label("Housing length").is_some(), "a standard size has its housing");
+    assert!(h.query_by_label("Min opening").is_none(), "and no clamping-range floor");
+    h.get_by_label("80 mm self-centering").click();
+    h.run();
+    let Some(FixtureLibDialog::Vise(d)) = &h.state().fixture_lib else { panic!("still open") };
+    assert_eq!(d.params.size, "80 mm self-centering");
+    for label in ["Min opening", "Dovetail lip height", "Dovetail lip depth", "Fit to the stock (centred, jaws closed on it)"] {
+        assert!(h.query_by_label(label).is_some(), "a self-centering size shows {label}");
+    }
+    assert!(h.query_by_label("Housing length").is_none(), "and no screw housing");
+    h.get_by_label("Fit to the stock (centred, jaws closed on it)").click();
+    h.run();
+    assert!(h.query_by_label("Centre X").is_some(), "a typed pose places its centre");
+}
+
+#[test]
+fn the_dialog_places_a_centred_self_centering_vise_in_one_undoable_step() {
+    let mut h = opened(with_stock(40.0));
+    h.get_by_label("80 mm self-centering").click();
+    h.run();
+    h.get_by_label("Place").click();
+    h.run();
+    h.run();
+    assert!(h.state().fixture_lib.is_none(), "placed and closed: {:?}", h.state().fixture_lib);
+    assert_eq!(opening(h.state(), NAME), Some(40.0), "jaws closed on the 40 mm stock");
+    let st = h.state();
+    let pos = model::find_by_name(&st.world, NAME).and_then(|e| model::transform_of(&st.world, &e)).map(|l| l.pos);
+    assert_eq!(pos.map(|p| [p.x, p.y, p.z]), Some([0.0, 0.0, 0.0]), "centred on the stock");
+    let st = h.state_mut();
+    assert!(st.history.undo(&st.world));
+    assert!(model::find_by_name(&st.world, NAME).is_none(), "one undo takes the vise");
+}
+
+#[test]
+fn a_stock_outside_the_clamping_range_is_named_in_the_dialog() {
+    let mut h = opened(with_stock(40.0));
+    h.get_by_label("52 mm self-centering").click();
+    h.run();
+    h.get_by_label("Place").click();
+    h.run();
+    h.run();
+    let Some(FixtureLibDialog::Vise(d)) = &h.state().fixture_lib else { panic!("stays open") };
+    assert!(d.error.as_deref().is_some_and(|e| e.contains("wider than its clamping range")), "{:?}", d.error);
+    assert!(h.query_by_label_contains("wider than its clamping range").is_some(), "said in the dialog");
+}
+
+#[test]
+fn a_self_centering_row_closes_its_jaws_on_the_stock() {
+    let mut state = with_stock(40.0);
+    state.pending.push_back(CommandKind::BuiltinViseDialog(String::new()));
+    state.drain_actions();
+    let Some(FixtureLibDialog::Vise(d)) = state.fixture_lib.as_mut() else { panic!("open") };
+    let k = camcraft_app::vise::presets().position(|r| r.label == "80 mm self-centering").expect("row");
+    d.pick(k);
+    let cmd = super::fixture_vise_dialog::place_command(d);
+    state.pending.push_back(cmd);
+    state.drain_actions();
+    assert_eq!(opening(&state, NAME), Some(40.0));
+
+    let mut h = Harness::builder().with_size(Vec2::new(600.0, 700.0)).build_ui_state(
+        |ui, st: &mut State| {
+            st.drain_actions();
+            super::pages::fixtures_section(ui, st, None);
+        },
+        state,
+    );
+    h.run();
+    assert!(h.query_by_label_contains("Built-in vise 80 mm self-centering").is_some(), "the row names it");
+    *h.state_mut().vise_opening_draft(NAME, 40.0) = 100.0;
+    h.get_by_label("Set opening").click();
+    h.run();
+    h.run();
+    assert_eq!(opening(h.state(), NAME), Some(100.0), "Set lands through SetVise");
+    h.get_by_label("Open to stock").click();
+    h.run();
+    h.run();
+    assert_eq!(opening(h.state(), NAME), Some(40.0), "closed on the stock again");
+    let st = h.state_mut();
+    assert!(st.history.undo(&st.world));
+    assert_eq!(opening(st, NAME), Some(100.0), "each edit is one undo");
+}
