     let ring_levels = |keep: &dyn Fn(f64) -> bool| -> Vec<f64> {
         let mut v: Vec<f64> = t
             .moves
@@ -236,9 +244,11 @@ fn the_reported_outside_contour_enters_every_level_on_one_arc() {
