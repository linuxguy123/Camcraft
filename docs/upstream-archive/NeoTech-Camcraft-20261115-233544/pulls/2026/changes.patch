+#[test]
+fn waterjet_machine_check_applies_wcs_and_axis_direction() {
+    let (w, e) = cached(vec![feed([500.0,20.0,0.0], [510.0,30.0,0.0], 600.0)], tool());
+    let ops = [("Cached".into(), e)];
