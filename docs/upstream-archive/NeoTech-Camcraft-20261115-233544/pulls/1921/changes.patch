+                    "wire contour: the pairing ({rule}) leans the wire {lean:.3} degrees at X{:.3} Y{:.3}, and machine {machine} leans it at most {max:.3} degrees (edm.max_taper_deg)",
+                    l.x, l.y
+                ),
+                Point3::new(l.x, l.y, z0),
+            ));
+        }
+        steepest = steepest.max(lean);
+    }
+    Ok(steepest)
+}
