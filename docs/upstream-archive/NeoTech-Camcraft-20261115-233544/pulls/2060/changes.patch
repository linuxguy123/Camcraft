index 000000000..a05acf882
--- /dev/null
+++ b/docs/decisions/2057-gate-job-budget.md
@@ -0,0 +1,19 @@
+## #2057 - Gate: one job budget for all lanes of a wave
+
+**Decided:**
+
+- One budget for each gate run: `budget::DEFAULT = 6`, override `CAMCRAFT_GATE_JOBS` (a whole number of 1 or more). A bad value prints a note and keeps 6.
+- The executor sets `-j` and `--test-threads=` of each step when it runs the step (`budget::scale`). The plan builders (`plan.rs`, `quick.rs`, `single.rs`) still write `-j 6` and `--test-threads=6` as before.
+- A wave of N lanes gives each lane `budget / N` (minimum 1). A wave has at most `budget / 2` lanes (minimum 1). `lanes::waves` takes this limit as a parameter; `LIMIT = 4` is gone.
+- A step alone (each quick, batch and test step, and each release step that runs alone) gets the full budget.
+- A value that a step sets on purpose (not the plan default `6`) only goes down to the lane's jobs, never up. Example: `--test-threads=1` stays 1.
+- The gate prints the budget line at the start and `-- wave K: N lane(s) x -j M` before each wave, also in `--dry-run`.
+
+**Why:** the rewrite at run time keeps the plan builders unchanged. Open PR #1952 (#1941, one step per test binary) changes those builders on many lines. This change thus does not conflict with it, and each step that #1941 adds gets the budget too. The quick and batch tiers run their steps one at a time, so the budget applies to them as one step at a time.
+
+**Dropped:**
+
+- A budget parameter in each plan builder: it touches the same lines as #1952 and all plan-string tests.
+- An automatic core count (`std::thread::available_parallelism`): the machine is shared with review and worker builds, and the gate cannot see them. The maintainer set the budget from the shared `-j 6` rule; the skills tell each build to keep the sum at or below the core count.
+
+**Cost to change later:** small. `budget.rs` holds the rule; a different split (for example by step weight) changes `per_lane` and its tests.
diff --git a/xtask/src/budget.rs b/xtask/src/budget.rs
new file mode 100644
index 000000000..546238fe7
--- /dev/null
+++ b/xtask/src/budget.rs
@@ -0,0 +1,71 @@
+//! One job budget for a whole gate run (#2057): the lanes of a wave share it, so `-j` summed over a
+//! wave never exceeds it. Provenance: our own build law (AGENTS.md "Three gate tiers"), cargo's `-j`
+//! and libtest's `--test-threads` flags as documented in the Cargo Book and the rustc test docs.
+
+/// The budget when `CAMCRAFT_GATE_JOBS` is not set. The plan writes this value as `plan::J`.
+pub const DEFAULT: usize = 6;
+/// The environment variable that overrides the budget (a whole number of 1 or more).
+pub const ENV: &str = "CAMCRAFT_GATE_JOBS";
+
+/// The budget from the value of `ENV`; `None` or a bad value gives `DEFAULT` and a note.
+pub fn from_value(v: Option<&str>) -> (usize, Option<String>) {
+    match v.map(str::trim) {
+        None | Some("") => (DEFAULT, None),
+        Some(s) => match s.parse::<usize>() {
+            Ok(n) if n >= 1 => (n, None),
+            _ => (DEFAULT, Some(format!("note: {ENV}={s} is not a whole number of 1 or more; the budget stays {DEFAULT}"))),
+        },
+    }
+}
+
+/// The budget of this process.
+pub fn from_env() -> (usize, Option<String>) {
+    from_value(std::env::var(ENV).ok().as_deref())
+}
+
+/// The most lanes in one wave: half the budget, so each lane has two jobs or more; at least one.
+pub fn lane_limit(budget: usize) -> usize {
+    (budget / 2).max(1)
+}
+
+/// The jobs of each lane when `lanes` steps share `budget`; at least one. A step alone gets all of it.
+pub fn per_lane(budget: usize, lanes: usize) -> usize {
+    (budget / lanes.max(1)).max(1)
+}
+
+/// The args with `-j` and `--test-threads=` set to `jobs`. A value that the plan did not write as
+/// `plan::J` is a deliberate choice: it only goes down to `jobs`, never up. Args without those flags
+/// are unchanged; `-j` after `--` belongs to the child program and is left alone.
+pub fn scale(args: &[String], jobs: usize) -> Vec<String> {
+    let pick = |v: &str| match v.parse::<usize>() {
+        Ok(n) if v != crate::plan::J => n.min(jobs).max(1),
+        _ => jobs,
+    };
+    let mut out = Vec::with_capacity(args.len());
+    let (mut child, mut after_j) = (false, false);
+    for a in args {
+        if after_j {
+            out.push(pick(a).to_string());
+            after_j = false;
+        } else if !child && a == "-j" {
+            out.push(a.clone());
+            after_j = true;
+        } else if let Some(v) = a.strip_prefix("--test-threads=") {
+            out.push(format!("--test-threads={}", pick(v)));
+        } else {
+            child |= a == "--";
+            out.push(a.clone());
+        }
+    }
+    out
+}
+
+/// The line printed at the start of a gate: the budget, the lane limit and the jobs of each lane.
+pub fn header(budget: usize, lanes: bool) -> String {
+    if !lanes {
+        return format!("gate budget: {budget} job(s); steps run one at a time with -j {budget}");
+    }
+    let limit = lane_limit(budget);
+    let split: Vec<String> = (1..=limit).map(|n| format!("{n} lane(s) x -j {}", per_lane(budget, n))).collect();
+    format!("gate budget: {budget} job(s) ({ENV} overrides); at most {limit} lane(s) per wave; {}", split.join(", "))
+}
diff --git a/xtask/src/budget_tests.rs b/xtask/src/budget_tests.rs
new file mode 100644
index 000000000..a13c6467f
--- /dev/null
+++ b/xtask/src/budget_tests.rs
@@ -0,0 +1,92 @@
+//! Provenance: the job budget law of issue #2057 (one budget shared by the lanes of a wave).
+
+use crate::budget::{DEFAULT, from_value, lane_limit, per_lane, scale};
+use crate::plan::Step;
+
+fn job_value(args: &[String]) -> Option<usize> {
+    let i = args.iter().position(|a| a == "-j")?;
+    args.get(i + 1)?.parse().ok()
+}
+
+fn threads(args: &[String]) -> Option<usize> {
+    args.iter().find_map(|a| a.strip_prefix("--test-threads=")?.parse().ok())
+}
+
+fn suites(n: usize) -> Vec<Step> {
+    let mut steps = vec![Step::new("debug build", &["test", "-j", "6", "--no-run"], "")];
+    for i in 0..n {
+        let profile: &[&str] = if i % 2 == 0 { &[] } else { &["--release"] };
+        let mut args = vec!["test"];
+        args.extend_from_slice(profile);
+        args.extend(["-j", "6", "-p", "camcraft-motion", "--", "--test-threads=6"]);
+        steps.push(Step::new(format!("suite {i}"), &args, ""));
+    }
+    steps.push(Step::new("app", &["test", "-j", "6", "-p", "camcraft-app", "--", "--test-threads=6"], ""));
+    steps
+}
+
+#[test]
+fn wave_jobs_sum_to_at_most_the_budget_and_lanes_to_at_most_half() {
+    for budget in 1..=16 {
+        let steps = suites(11);
+        let waves = crate::lanes::waves(&steps, lane_limit(budget));
+        let mut seen: Vec<_> = waves.iter().flatten().copied().collect();
+        seen.sort_unstable();
+        assert_eq!(seen, (0..steps.len()).collect::<Vec<_>>(), "budget {budget}: a step was lost");
+        for wave in &waves {
+            assert!(wave.len() <= (budget / 2).max(1), "budget {budget}: wave {wave:?} has too many lanes");
+            let jobs = per_lane(budget, wave.len());
+            let sum: usize = wave.iter().filter_map(|&i| job_value(&scale(&steps[i].args, jobs))).sum();
+            let thr: usize = wave.iter().filter_map(|&i| threads(&scale(&steps[i].args, jobs))).sum();
+            assert!(sum <= budget.max(1), "budget {budget}: wave {wave:?} has -j sum {sum}");
+            assert!(thr <= budget.max(1), "budget {budget}: wave {wave:?} has {thr} test threads");
+        }
+    }
+}
+
+#[test]
+fn budget_six_gives_three_lanes_of_two_jobs() {
+    assert_eq!(DEFAULT, 6);
+    assert_eq!(crate::plan::J, DEFAULT.to_string(), "the plan writes the default budget");
+    assert_eq!(lane_limit(6), 3);
+    assert_eq!(per_lane(6, 3), 2);
+    let waves = crate::lanes::waves(&suites(6), lane_limit(6));
+    assert!(waves.iter().any(|w| w.len() == 3), "{waves:?}");
+}
+
+#[test]
+fn a_step_alone_keeps_the_full_budget() {
+    for budget in [1, 4, 6, 12] {
+        let steps = suites(0);
+        let waves = crate::lanes::waves(&steps, lane_limit(budget));
+        assert!(waves.iter().all(|w| w.len() == 1));
+        let jobs = per_lane(budget, 1);
+        assert_eq!(jobs, budget);
+        for &i in waves.iter().flatten() {
+            let args = scale(&steps[i].args, jobs);
+            assert_eq!(job_value(&args), Some(budget), "{}", steps[i].name);
+        }
+        assert_eq!(threads(&scale(&steps[1].args, jobs)), Some(budget));
+    }
+}
+
+#[test]
+fn scale_keeps_deliberate_values_low_and_child_args_alone() {
+    let s = |v: &[&str]| v.iter().map(|a| a.to_string()).collect::<Vec<_>>();
+    assert_eq!(scale(&s(&["test", "--", "--test-threads=1"]), 4), s(&["test", "--", "--test-threads=1"]));
+    assert_eq!(scale(&s(&["test", "-j", "8"]), 2), s(&["test", "-j", "2"]));
+    assert_eq!(scale(&s(&["run", "--", "-j", "6"]), 2), s(&["run", "--", "-j", "6"]));
+    assert_eq!(scale(&s(&["run", "--quiet"]), 2), s(&["run", "--quiet"]));
+}
+
+#[test]
+fn the_override_must_be_a_whole_number_of_one_or_more() {
+    assert_eq!(from_value(None), (DEFAULT, None));
+    assert_eq!(from_value(Some("12")).0, 12);
+    assert_eq!(from_value(Some(" 2 ")).0, 2);
+    for bad in ["0", "-3", "six"] {
+        let (b, note) = from_value(Some(bad));
+        assert_eq!(b, DEFAULT);
+        assert!(note.is_some_and(|n| n.contains(bad)), "{bad}");
+    }
+}
