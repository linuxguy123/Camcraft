@@ -858,6 +858,12 @@ function onCycle() {
     msg("canned cycle G86 (bore) has no dwell word on this control - a " + (ms / 1000) + " s dwell is refused, not dropped; set the dwell to 0");
     return;
   }
+  // #1820: B-64604EN-2/01 section 5.1.6 has no P in standard G83.
+  // The optional small-hole mode (5.1.7) is not selected by this post.
+  if (g === "G83" && p.P > 0) {
+    msg("canned cycle G83 (deep peck) dwell is not supported by this post - a " + p.P + " s dwell is refused, not dropped; set the dwell to 0");
+    return;
+  }
   if (spindleStopped("canned cycle " + g)) return;
   if (!xyFirst(p.X, p.Y, p.R, false)) return;  // #1633: refused - the move is not written
   cycleSeat(p);
diff --git a/assets/posts/haas.cps b/assets/posts/haas.cps
index e71bb066a..f934d8202 100644
--- a/assets/posts/haas.cps
+++ b/assets/posts/haas.cps
@@ -698,6 +698,8 @@ function onCycle() {
   if (!xyFirst(p.X, p.Y, p.R, false)) return;  // #1633: refused - the move is not written
   cycleSeat(p);
   var sig = g + "|" + p.Z + "|" + p.R + "|" + p.Q;
+  // #1820: Haas G83 keeps P modal; a changed dwell must reopen the cycle.
+  if (g === "G83") sig += "|" + ms;
   if (inCycle && sig === cycleSig) {
     block([wo("X", p.X, orgX), wo("Y", p.Y, orgY)]);
   } else {
@@ -708,7 +710,9 @@ function onCycle() {
     if ((p.CycleType === "PECK" || p.CycleType === "DEEP") && has(p.Q) && p.Q > 0) {
       words.push(w("Q", p.Q));
     }
-    if (ms > 0 && g !== "G73" && g !== "G84") words.push("P" + ms);
+    // Haas G83/G04 documentation: integer P is milliseconds. P0 clears
+    // a previous dwell; omitting P would reuse it even after a new G83.
+    if (g === "G83" || (ms > 0 && g !== "G73" && g !== "G84")) words.push("P" + ms);
     words.push(fw(p.FeedRate));
     block(words);
     cycleSig = sig;
