 site/content/developers/gates.md    |  5 +++--
 site/content/guide/first-run.md     | 11 +++++++----
 site/content/guide/install.md       |  6 ++++++
 site/content/guide/operations.md    |  4 ++--
 site/content/guide/posting.md       |  2 +-
 6 files changed, 21 insertions(+), 10 deletions(-)

