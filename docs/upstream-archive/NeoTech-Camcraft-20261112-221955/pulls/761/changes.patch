From ae39b16f908ed190a4fc68d1d91deda82d46e9d9 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 10 Nov 2026 15:26:34 -0800
Subject: [PATCH] test(app): fixture_library folder resolver uses host-absolute
 paths

The override and HOME cases fed Unix paths (/shop/fixtures, /Users/me,
/home/me). store.rs keeps an override only when PathBuf::is_absolute() on
the host, so on Windows those paths were dropped and the test failed.
Pick each absolute path per OS with cfg!(windows), as machine_edit.rs
already does, and build the expected folders with PathBuf::join. The
assertions keep their meaning: an absolute override wins, a relative one
falls back to HOME, and the macOS and linux data folders are unchanged.

Fixes #723
Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/tests/fixture_library.rs | 23 +++++++++++++++--------
 1 file changed, 15 insertions(+), 8 deletions(-)

diff --git a/crates/app/tests/fixture_library.rs b/crates/app/tests/fixture_library.rs
index ed21b0071..60b25a11c 100644
--- a/crates/app/tests/fixture_library.rs
+++ b/crates/app/tests/fixture_library.rs
@@ -110,19 +110,26 @@ fn a_bad_library_is_refused_whole_by_name() {
 
 #[test]
 fn the_library_folder_is_the_override_else_a_sibling_of_machines() {
-    let env = |pairs: &'static [(&'static str, &'static str)]| {
-        move |k: &str| pairs.iter().find(|(n, _)| *n == k).map(|(_, v)| OsString::from(v))
+    // Owned copies, so the paths can be picked per host: `is_absolute()` is
+    // judged on the host (a Windows host drops "/shop/fixtures"), as in
+    // machine_edit.rs's user_dir_for test.
+    let env = |pairs: &[(&str, &str)]| {
+        let owned: Vec<(String, String)> = pairs.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();
+        move |k: &str| owned.iter().find(|(n, _)| n.as_str() == k).map(|(_, v)| OsString::from(v))
     };
-    let both: &[(&str, &str)] = &[("CAMCRAFT_FIXTURES", "/shop/fixtures"), ("HOME", "/Users/me")];
-    assert_eq!(fixture_library::user_dir_for("macos", env(both)), Some(PathBuf::from("/shop/fixtures")));
-    let home: &[(&str, &str)] = &[("HOME", "/Users/me"), ("CAMCRAFT_FIXTURES", "relative")];
+    let abs = if cfg!(windows) { "C:\\shop\\fixtures" } else { "/shop/fixtures" };
+    let mac_home = if cfg!(windows) { "C:\\Users\\me" } else { "/Users/me" };
+    let linux_home = if cfg!(windows) { "C:\\home\\me" } else { "/home/me" };
+    let both: &[(&str, &str)] = &[("CAMCRAFT_FIXTURES", abs), ("HOME", mac_home)];
+    assert_eq!(fixture_library::user_dir_for("macos", env(both)), Some(PathBuf::from(abs)));
+    let home: &[(&str, &str)] = &[("HOME", mac_home), ("CAMCRAFT_FIXTURES", "relative")];
     assert_eq!(
         fixture_library::user_dir_for("macos", env(home)),
-        Some(PathBuf::from("/Users/me/Library/Application Support/camcraft/fixtures"))
+        Some(PathBuf::from(mac_home).join("Library").join("Application Support").join("camcraft").join("fixtures"))
     );
     assert_eq!(
-        fixture_library::user_dir_for("linux", env(&[("HOME", "/home/me")])),
-        Some(PathBuf::from("/home/me/.local/share/camcraft/fixtures"))
+        fixture_library::user_dir_for("linux", env(&[("HOME", linux_home)])),
+        Some(PathBuf::from(linux_home).join(".local").join("share").join("camcraft").join("fixtures"))
     );
     assert_eq!(fixture_library::user_dir_for("linux", env(&[])), None);
     assert!(library_path(&PathBuf::from("/x")).ends_with("fixtures.camfixtures"));
