  {
    "sha": "28b5e68272b8043cb052d391bd6a7d7fbb52570d",
    "node_id": "C_kwDOVoU8JdoAKDI4YjVlNjgyNzJiODA0M2NiMDUyZDM5MWJkNmE3ZDdmYmI1MjU3MGQ",
    "commit": {
      "author": {
        "name": "Mike Kinney",
        "email": "mike.kinney@gmail.com",
