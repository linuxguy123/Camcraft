+/// What a column under the slot truly holds: `[floor, min(top, slot)]`,
+/// `None` when the slot went through.
+fn truth(floor: f64, top: f64, slot: f64) -> Option<(f64, f64)> {
+    (slot >= floor).then_some((floor, top.min(slot)))
