+    let moves = [
+        Move::new(MoveKind::Rapid, p(-4.0, 3.0, 5.0), p(-4.0, 3.0, z), None),
+        Move::new(MoveKind::Feed, p(-4.0, 3.0, z), p(12.0, 3.0, z), Some(500.0)),
+    ];
+    if let Err(e) = s.simulate(&[SimOp { moves: &moves, radius: 2.0, ball: false, cone: None, corner: None }]) {
