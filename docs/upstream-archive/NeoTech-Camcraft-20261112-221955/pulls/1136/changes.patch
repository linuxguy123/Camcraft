Subject: [PATCH 9/9] test(lathe_voice): SinkerBurn is a refused kind on the
 lathe (#541 with main's #1190)

Main's lathe_voice_tests want() matches every OpType; #541's SinkerBurn
joins the refused arm (an EDM op never runs with the work turning).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/src/lathe_voice_tests.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/crates/app/src/lathe_voice_tests.rs b/crates/app/src/lathe_voice_tests.rs
index c95376b80..8f6a51fed 100644
--- a/crates/app/src/lathe_voice_tests.rs
+++ b/crates/app/src/lathe_voice_tests.rs
@@ -129,7 +129,9 @@ fn want(ty: OpType) -> Want {
         | OpType::MultiAxisContour
         | OpType::Probe
         | OpType::PlasmaProfile
-        | OpType::TrochoidalSlot => Want::Refused,
+        | OpType::TrochoidalSlot
+        // #541: a sinker burn is an EDM op; a lathe never runs it with the work turning.
+        | OpType::SinkerBurn => Want::Refused,
     }
 }
 
@@ -175,7 +177,7 @@ fn every_kind_is_work_spindle_live_tool_or_refused_by_name() {
         // The post's own order: a path stating C is live-tool work.
         assert_eq!(voice(&params, &stating_c(meridian()), ORIGIN), LatheVoice::LiveTool, "{}", info.label);
     }
-    assert_eq!((turns, holes, refused), (12, 1, 28), "the table covers every kind");
+    assert_eq!((turns, holes, refused), (12, 1, 29), "the table covers every kind");
     assert_eq!(turns + holes + refused, KindInfo::ALL.len());
 }
 
