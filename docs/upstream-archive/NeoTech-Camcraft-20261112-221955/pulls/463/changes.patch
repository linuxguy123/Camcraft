+        if super::os_quit::route_pending(&mut self.state) {
+            if self.failed {
+                el.exit();
+                return;
+            }
+            if let Some(window) = &self.window {
+                window.set_minimized(false);
+                window.focus_window();
+                window.request_redraw();
+            }
+        }
         if self.occluded {
             el.set_control_flow(ControlFlow::Wait);
             return;
