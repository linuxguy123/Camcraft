  "title": "feat(machine): refuse rigid tapping by name at the program gate; validate spindle.rigid_tapping",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
