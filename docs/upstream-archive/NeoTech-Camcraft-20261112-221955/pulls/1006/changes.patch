From 0d6039f851496fda0919062ef3728d9cf5a7a9f5 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 01:35:08 +0000
Subject: [PATCH 2/2] fix(import): clippy strip_prefix in step_diag

Refs #912

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/app/src/geometry/import/step_diag.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/app/src/geometry/import/step_diag.rs b/crates/app/src/geometry/import/step_diag.rs
index 4a62a5f5f..0c1b016f8 100644
--- a/crates/app/src/geometry/import/step_diag.rs
+++ b/crates/app/src/geometry/import/step_diag.rs
@@ -43,8 +43,8 @@ fn skip_lead(s: &str) -> usize {
         let rest = &s[i..];
         let t = rest.trim_start();
         i += rest.len() - t.len();
-        if t.starts_with("/*") {
-            match t[2..].find("*/") {
+        if let Some(body) = t.strip_prefix("/*") {
+            match body.find("*/") {
                 Some(e) => i += e + 4,
                 None => return s.len(),
             }
