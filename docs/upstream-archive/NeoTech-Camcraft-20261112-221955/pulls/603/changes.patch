diff --git a/crates/ui/src/egui_app/setup_points_pick.rs b/crates/ui/src/egui_app/setup_points_pick.rs
new file mode 100644
index 000000000..208086ac9
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_points_pick.rs
@@ -0,0 +1,136 @@
+//! The Setups page's "Lay on a plane - pick three points" row (#555): pick
+//! points 1, 2 and 3 in the viewport (model corners), choose G17 (XY),
+//! G18 (ZX) or G19 (YZ), flip it, optionally set point 1 onto the plane's
+//! level, optionally take the 3-2-1 frame (point 1 the origin, 1 -> 2
+//! along +X), and Apply. Distinct from the face row above it (#554): that
+//! one takes a face, this one points. The draft is view state
+//! (`crate::points_pick`); Apply queues `CommandKind::LayPartOnPoints`,
+//! the undoable `AlignPartToSetup`. The app says whether the points make
+//! a plane and, if not, why - shown on the disabled Apply. The work
+//! offset is not touched.
+//!
+//! Provenance: our own UI over the 3-2-1 datum practice of fixture
+//! design; no vendor material consulted.
+
+use egui::{ComboBox, RichText, Ui};
+
+use camcraft_app::cl::ArcPlane;
+use camcraft_app::commands::AlignPartToSetup;
+use camcraft_app::pick::{self, PlaneLay, PointsLay};
+
+use crate::state::{CommandKind, State};
+
+const PLANES: [ArcPlane; 3] = [ArcPlane::Xy, ArcPlane::Xz, ArcPlane::Yz];
+
+/// The row's options, kept between frames (view state).
+#[derive(Clone, Copy)]
+struct Draft {
+    plane: ArcPlane,
+    flip: bool,
+    place: bool,
+    frame: bool,
+}
+
+impl Default for Draft {
+    fn default() -> Self {
+        Draft { plane: ArcPlane::Xy, flip: false, place: true, frame: false }
+    }
+}
+
+/// One setup row's control.
+pub(super) fn row(ui: &mut Ui, state: &mut State, setup: &str) {
+    let id = ui.id().with(("setup_points_draft", setup));
+    let mut d: Draft = ui.data_mut(|m| *m.get_temp_mut_or_insert_with(id, Draft::default));
+    let armed = state.points_pick.as_ref().is_some_and(|p| p.setup == setup);
+    ui.horizontal(|ui| {
+        ui.label("    Lay on a plane - pick three points");
+        let pick_text = if armed { "Stop picking points" } else { "Pick three points" };
+        if ui
+            .selectable_label(armed, pick_text)
+            .on_hover_text("Click three corners of the model in the viewport; the plane through them is laid on the plane.")
+            .clicked()
+        {
+            if armed {
+                crate::points_pick::disarm(state);
+            } else {
+                crate::points_pick::arm(state, setup);
+            }
+        }
+        ComboBox::from_id_salt(("setup_points_plane", setup))
+            .selected_text(pick::plane_label(d.plane))
+            .show_ui(ui, |ui| {
+                for p in PLANES {
+                    ui.selectable_value(&mut d.plane, p, pick::plane_label(p));
+                }
+            })
+            .response
+            .on_hover_text("The plane the three points are laid on.");
+        ui.checkbox(&mut d.flip, "Flip points")
+            .on_hover_text("Face the points' outside the other way: down (-Z) for G17 rests them on the table.");
+        ui.checkbox(&mut d.place, "Point 1 to plane level")
+            .on_hover_text("Set the points onto the plane (e.g. Z 0 for G17); off keeps the part where it is.");
+        ui.checkbox(&mut d.frame, "3-2-1 frame").on_hover_text(
+            "Also turn the part so point 1 -> 2 runs along +X (+Y for G19) and move point 1 to the origin.",
+        );
+    });
+    if armed {
+        points_lines(ui, state, setup, d);
+    }
+    ui.data_mut(|m| m.insert_temp(id, d));
+}
+
+/// The armed row: the three point prompts, Remove last, Clear, Apply.
+fn points_lines(ui: &mut Ui, state: &mut State, setup: &str, d: Draft) {
+    let picks = state.points_pick.as_ref().map(|p| p.picks.clone()).unwrap_or_default();
+    for k in 0..3 {
+        let text = match picks.get(k) {
+            Some(g) => format!("{} of '{}'", g.feature, g.entity),
+            None if k == picks.len() => "click a corner in the viewport".to_owned(),
+            None => "-".to_owned(),
+        };
+        ui.label(RichText::new(format!("      Point {}: {text}", k + 1)).weak());
+    }
+    let pl = PointsLay { lay: PlaneLay { plane: d.plane, flip: d.flip, place: d.place }, frame: d.frame };
+    // The command's own check: a refused pick, or one that gives the
+    // alignment the setup already holds, greys Apply out with the why.
+    let check = AlignPartToSetup::check_points(&state.world, setup, &picks, pl).map_err(|e| e.to_string());
+    let side = pick::points_side(&state.world, &picks).ok();
+    ui.horizontal(|ui| {
+        ui.label("     ");
+        if ui
+            .add_enabled(!picks.is_empty(), egui::Button::new("Remove last"))
+            .on_hover_text("Drop the last point picked.")
+            .clicked()
+        {
+            crate::points_pick::remove_last(state);
+        }
+        if ui
+            .add_enabled(!picks.is_empty(), egui::Button::new("Clear points"))
+            .on_hover_text("Drop every point picked and start again from point 1.")
+            .clicked()
+        {
+            crate::points_pick::clear(state);
+        }
+        let tip = match &check {
+            Ok(()) => format!("Turn the part so the three points' plane lies on {}.", pick::plane_label(d.plane)),
+            Err(why) => why.clone(),
+        };
+        if ui
+            .add_enabled(check.is_ok(), egui::Button::new("Apply points"))
+            .on_hover_text(&tip)
+            .on_disabled_hover_text(&tip)
+            .clicked()
+        {
+            state.pending.push_back(CommandKind::LayPartOnPoints { setup: setup.to_owned(), picks: picks.clone(), lay: pl });
+        }
+    });
+    let words = match (&check, &side) {
+        (Err(why), _) if picks.len() == 3 => why.clone(),
+        (_, Some(side)) => side.clone(),
+        _ => String::new(),
+    };
+    if !words.is_empty() {
+        ui.label(RichText::new(format!("      {words}")).weak())
+            .on_hover_text("The side away from the part's material is the points' outside: it faces the plane's axis (or away, with Flip points).");
+    }
+}
diff --git a/crates/ui/src/egui_app/setup_points_tests.rs b/crates/ui/src/egui_app/setup_points_tests.rs
new file mode 100644
index 000000000..bb6841dde
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_points_tests.rs
@@ -0,0 +1,172 @@
+//! #555 in the surface: the Setups page's "Lay on a plane - pick three
+//! points" row arms the points draft in Vertex mode, points 1, 2, 3 land
+//! in it in order (never in an operation), a face, an edge or a fourth
+//! point is refused by name, Remove last and Clear walk the draft back,
+//! Apply stays greyed with the reason until the points make a plane, and
+//! Apply queues `LayPartOnPoints` - one undo unit. The work offset is not
+//! touched.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::{NodeT, Queryable};
+use egui_kittest::Harness;
+
+use camcraft_app::commands::ImportModel;
+use camcraft_app::geometry::{Point3, cube, feature, quat_rotate_point};
+use camcraft_app::model;
+use camcraft_app::operation::{FeatureSel, GeoSel};
+use camcraft_app::setup_align;
+
+use crate::state::{CommandKind, GeoPick, State};
+
+fn with_part() -> State {
+    let mut state = State::new();
+    let part = ImportModel::from_mesh("part", cube(Point3::new(0.0, 0.0, 0.0), Point3::new(20.0, 20.0, 10.0)));
+    state.history.execute(&state.world, part);
+    state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    state.drain_actions();
+    state
+}
+
+fn features(state: &State) -> std::sync::Arc<feature::Features> {
+    let e = model::find_by_name(&state.world, "part").expect("part");
+    model::features_of(&state.world, &e).expect("features")
+}
+
+fn corner(state: &State, p: [f64; 3]) -> GeoSel {
+    let f = features(state);
+    let id = feature::corner_verts(&f)
+        .into_iter()
+        .find(|&vi| f.verts.get(vi as usize).is_some_and(|v| *v == p))
+        .and_then(|vi| feature::vertex_id(&f, vi))
+        .expect("a corner");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Vertex(id) }
+}
+
+fn top_face(state: &State) -> GeoSel {
+    let id = features(state).faces.iter().find(|f| f.normal[2] > 0.99).map(|f| f.id).expect("the top");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Face(id) }
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_points_pick::row(ui, st, "Setup1");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+fn harness() -> Harness<'static, State> {
+    let mut h = Harness::builder().with_size(Vec2::new(1200.0, 300.0)).build_ui_state(frame, with_part());
+    h.run();
+    h
+}
+
+fn disabled(h: &Harness<'static, State>, label: &str) -> bool {
+    h.get_by_label(label).accesskit_node().is_disabled()
+}
+
+fn picks(h: &Harness<'static, State>) -> usize {
+    h.state().points_pick.as_ref().map_or(0, |d| d.picks.len())
+}
+
+/// Local +Z of the part as Setup1 holds it.
+fn held_up(state: &State) -> Option<[f64; 3]> {
+    let a = setup_align::stored(&state.world, "Setup1")?;
+    let v = quat_rotate_point(a.rot, Point3::new(0.0, 0.0, 1.0));
+    Some([v.x, v.y, v.z])
+}
+
+#[test]
+fn three_points_picked_in_order_lay_the_part_through_the_command_and_undo() {
+    let mut h = harness();
+    assert!(h.state().pending.is_empty(), "drawing the row queues nothing");
+    assert!(h.query_by_label_contains("Lay on a plane - pick three points").is_some(), "the row says what it takes");
+    h.get_by_label("Pick three points").click();
+    h.run();
+    assert!(h.state().points_pick.is_some(), "the draft is armed");
+    assert_eq!(h.state().geo_pick, GeoPick::Vertex, "the points row picks vertices");
+    assert!(h.query_by_label_contains("Point 1: click a corner").is_some(), "point 1 is prompted");
+    assert!(disabled(&h, "Apply points"), "nothing picked: Apply waits");
+    assert!(disabled(&h, "Remove last") && disabled(&h, "Clear points"));
+    // A face or an edge sets no points: refused by name, nothing drafted.
+    let face = top_face(h.state());
+    crate::points_pick::take(h.state_mut(), face);
+    assert!(h.state().status.contains("is a face"), "{}", h.state().status);
+    assert_eq!(picks(&h), 0);
+    for p in [[0.0, 0.0, 10.0], [20.0, 0.0, 10.0]] {
+        let c = corner(h.state(), p);
+        crate::points_pick::take(h.state_mut(), c);
+    }
+    h.run();
+    assert!(h.query_by_label_contains("Point 3: click a corner").is_some(), "point 3 is prompted next");
+    assert!(disabled(&h, "Apply points"), "two points make no plane");
+    h.get_by_label("Remove last").click();
+    h.run();
+    assert_eq!(picks(&h), 1, "Remove last drops point 2");
+    h.get_by_label("Clear points").click();
+    h.run();
+    assert_eq!(picks(&h), 0, "Clear drops them all");
+    for p in [[0.0, 0.0, 10.0], [20.0, 0.0, 10.0], [20.0, 20.0, 10.0], [0.0, 20.0, 10.0]] {
+        let c = corner(h.state(), p);
+        crate::points_pick::take(h.state_mut(), c);
+    }
+    assert_eq!(picks(&h), 3, "a fourth point is refused");
+    assert!(h.state().status.contains("Remove last or Clear"), "{}", h.state().status);
+    assert!(h.state().op_ui.geo.is_empty(), "a draft pick is not an operation pick");
+    h.run();
+    // The top already faces +Z; kept where it is, nothing would change:
+    // the reason is shown on the greyed Apply.
+    assert!(!disabled(&h, "Apply points"), "to the level, the top drops to Z 0");
+    h.get_by_label("Point 1 to plane level").click();
+    h.run();
+    assert!(disabled(&h, "Apply points"), "the top's outside already faces +Z");
+    assert!(h.query_by_label_contains("already holds the part that way").is_some(), "the reason is shown");
+    h.get_by_label("Point 1 to plane level").click();
+    h.get_by_label("Flip points").click();
+    h.run();
+    assert!(!disabled(&h, "Apply points"), "flipped, the points rest on the table");
+    h.get_by_label("Apply points").click();
+    h.run();
+    let up = held_up(h.state()).expect("Setup1 holds the part laid");
+    assert!((up[2] + 1.0).abs() < 1e-9, "the top now faces the table: {up:?}");
+    assert!(h.state().points_pick.is_none(), "a landed lay ends the pick");
+    assert!(h.state().status.contains("through three points"), "{}", h.state().status);
+    assert_eq!(camcraft_app::setup::work_offset(&h.state().world, "Setup1"), None, "the work offset is untouched");
+    key(&mut h, Key::Z);
+    assert_eq!(setup_align::stored(&h.state().world, "Setup1"), None, "undo restores as modelled");
+    key(&mut h, Key::Y);
+    assert!(held_up(h.state()).is_some(), "redo lays it again");
+}
+
+#[test]
+fn coincident_points_grey_apply_out_and_one_draft_collects_at_a_time() {
+    let mut h = harness();
+    h.get_by_label("Pick three points").click();
+    h.run();
+    let a = corner(h.state(), [0.0, 0.0, 10.0]);
+    let b = corner(h.state(), [20.0, 0.0, 10.0]);
+    for g in [a.clone(), a, b] {
+        crate::points_pick::take(h.state_mut(), g);
+    }
+    h.run();
+    assert!(disabled(&h, "Apply points"));
+    assert!(h.query_by_label_contains("coincide").is_some(), "the reason is shown");
+    // Arming the face row stops the points pick, and back.
+    crate::plane_pick::arm(h.state_mut(), "Setup1");
+    assert!(h.state().points_pick.is_none());
+    crate::points_pick::arm(h.state_mut(), "Setup1");
+    assert!(h.state().plane_pick.is_none());
+    crate::axis_pick::arm(h.state_mut(), "Setup1", camcraft_app::pick::InPlaneAxis::Y);
+    assert!(h.state().points_pick.is_none());
+}
