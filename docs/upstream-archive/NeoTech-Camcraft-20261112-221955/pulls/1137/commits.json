  {
    "sha": "4b1c9c08052e163868f54a321fcc79aa1d93582f",
    "node_id": "C_kwDOVoU8JdoAKDRiMWM5YzA4MDUyZTE2Mzg2OGY1NGEzMjFmY2M3OWFhMWQ5MzU4MmY",
    "commit": {
      "author": {
        "name": "Mike Kinney",
        "email": "mike.kinney@gmail.com",
