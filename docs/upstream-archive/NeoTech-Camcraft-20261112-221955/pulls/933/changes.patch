From 7123011df9992ab5ed1db162c32592513913e052 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Wed, 11 Nov 2026 14:35:30 -0800
Subject: [PATCH] test(ui): shipped theme example checks untouched fields
 against DARK

the_shipped_example_parses pinned two untouched fields to literal numbers
that went stale when the dark column moved: cell_h (35 -> 40, #767) and
font_row_suffix (10.5 -> 11.5). Both now read Tokens::DARK, so the check
follows the dark column instead of a copied number.

Fixes #932

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/ui/tests/theme_files.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/ui/tests/theme_files.rs b/crates/ui/tests/theme_files.rs
index d1d967b0a..120f581b3 100644
--- a/crates/ui/tests/theme_files.rs
+++ b/crates/ui/tests/theme_files.rs
@@ -57,8 +57,8 @@ fn the_shipped_example_parses() {
     assert_eq!(theme.tokens.glyph_px, 22.0);
     // Untouched fields keep the dark column's numbers.
     assert_eq!(theme.tokens.ink, Color32::from_rgb(0x23, 0x26, 0x2B));
-    assert_eq!(theme.tokens.cell_h, 35.0);
-    assert_eq!(theme.tokens.font_row_suffix, 10.5);
+    assert_eq!(theme.tokens.cell_h, Tokens::DARK.cell_h);
+    assert_eq!(theme.tokens.font_row_suffix, Tokens::DARK.font_row_suffix);
 }
 
 /// The ugly-but-legal law: a file can make the shell odd, never
