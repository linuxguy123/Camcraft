+    fn sliver(&self, x: f64, y: f64, floor: f64, ceiling: f64) -> ColumnSpan {
+        let cell = self.cell;
+        let (ix, iy) = (cell_of(x, cell), cell_of(y, cell));
+        let mut k = cell_of(floor, cell);
+        if center_of(k, cell) >= floor {
