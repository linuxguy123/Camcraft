+/// Dips every two leads, 0.3 high - under the 0.4 passes.
+fn dips() -> ThreadInfeed {
+    ThreadInfeed { dips: ThreadDips { interval: 4.0, height: 0.3, length: 0.0 }, ..ThreadInfeed::default() }
+}
