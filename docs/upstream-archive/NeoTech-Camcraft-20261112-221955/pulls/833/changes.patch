diff --git a/crates/app/tests/mcp_mod_vise.rs b/crates/app/tests/mcp_mod_vise.rs
new file mode 100644
index 000000000..e2c837969
--- /dev/null
+++ b/crates/app/tests/mcp_mod_vise.rs
@@ -0,0 +1,94 @@
+//! The MCP mod-vise tool (#820), driven in-process over the server's
+//! JSON-RPC handler: a pair placed on a plate's grid and fitted to the
+//! stock, its holes, slide and opening reported, one undo for both
+//! blocks, and every bad input a named tool error.
+//!
+//! Gate map (M4.4): covers app::mcp::modvise_tools.
+
+use camcraft_app::mcp::Server;
+
+use serde_json::{Value, json};
+
+struct Client {
+    server: Server,
+    next: i64,
+}
+
+impl Client {
+    fn new() -> Self {
+        let mut c = Self { server: Server::new(), next: 1 };
+        c.request("initialize", json!({ "protocolVersion": "2025-06-18" }));
+        c
+    }
+
+    fn request(&mut self, method: &str, params: Value) -> Value {
+        let id = self.next;
+        self.next += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params });
+        self.server.handle(&msg).expect("a request gets a response")
+    }
+
+    fn call(&mut self, name: &str, args: Value) -> (bool, Value) {
+        let reply = self.request("tools/call", json!({ "name": name, "arguments": args }));
+        let result = &reply["result"];
+        assert!(result.is_object(), "tools/call answers with a result: {reply}");
+        let is_err = result["isError"] == json!(true);
+        let body = if is_err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() };
+        (is_err, body)
+    }
+
+    fn ok(&mut self, name: &str, args: Value) -> Value {
+        let (err, body) = self.call(name, args);
+        assert!(!err, "{name} refused: {body}");
+        body
+    }
+
+    fn refused(&mut self, name: &str, args: Value) -> String {
+        let (err, body) = self.call(name, args);
+        assert!(err, "{name} should have refused, got {body}");
+        body.as_str().unwrap_or_default().to_owned()
+    }
+}
+
+#[test]
+fn a_mod_vise_pair_is_placed_fitted_and_undone_over_mcp() {
+    let mut c = Client::new();
+    let listed = c.request("tools/list", json!({}))["result"]["tools"].as_array().cloned().unwrap_or_default();
+    assert!(listed.iter().any(|t| t["name"] == json!("add_mod_vise_pair")), "listed");
+
+    c.ok("set_stock", json!({ "box": { "dx": 60.0, "dy": 60.0, "dz": 20.0 } }));
+    // A 12 in plate laid so C3's fixed block face sits on the stock's -Y
+    // side: C3 is (2.5, 2.5) in from the corner; the 1 in preset's face is
+    // 1.75 in in front of its anchor and its body centred 1 in across.
+    let x = -25.4 - 2.5 * 25.4;
+    let y = -30.0 - 1.75 * 25.4 - 2.5 * 25.4;
+    let plate = c.ok("add_fixture_plate", json!({ "preset": "12 x 12 in", "position": [x, y, 0.0] }))["fixture"]
+        .as_str()
+        .expect("name")
+        .to_owned();
+
+    let why = c.refused("add_mod_vise_pair", json!({ "plate": plate, "hole": "C3", "size": "3 in grid" }));
+    assert!(why.contains("no mod vise preset") && why.contains("1 in grid 3/8-16"), "{why}");
+    let why = c.refused("add_mod_vise_pair", json!({ "plate": plate, "hole": "C3", "size": "1 in grid 3/8-16", "adjustable": { "slot_travel": 10.0 } }));
+    assert!(why.contains("out of reach"), "{why}");
+    let why = c.refused("add_mod_vise_pair", json!({ "plate": plate, "hole": "C3", "size": "1 in grid 3/8-16", "fixed": { "body_length": -1.0 } }));
+    assert!(why.contains("body length"), "{why}");
+    let why = c.refused("add_mod_vise_pair", json!({ "plate": plate, "hole": "C3", "size": "1 in grid 3/8-16", "fixed": { "wings": 1.0 } }));
+    assert!(why.contains("unknown jaw block figure"), "{why}");
+    let why = c.refused("add_mod_vise_pair", json!({ "plate": plate, "hole": "C3", "size": "1 in grid 3/8-16", "yaw": 30.0 }));
+    assert!(why.contains("0, 90, 180 or 270"), "{why}");
+
+    let out = c.ok("add_mod_vise_pair", json!({ "plate": plate, "hole": "C3", "size": "1 in grid 3/8-16", "insert": "soft" }));
+    assert_eq!(out["fixed"]["at"], json!("C3"), "{out}");
+    assert_eq!(out["adjustable"]["at"], json!("I5"), "{out}");
+    assert_eq!(out["fixed"]["block"]["insert"], json!("soft"), "{out}");
+    let slide = out["slide"].as_f64().unwrap_or_default();
+    assert!((slide - (5.0 * 25.4 - 104.45)).abs() < 1e-6, "{out}");
+    assert!((out["opening"].as_f64().unwrap_or_default() - 60.0).abs() < 1e-6, "{out}");
+    let grid = c.ok("get_plate_grid", json!({ "name": plate }));
+    assert_eq!(grid["carries"].as_array().map(Vec::len), Some(2), "{grid}");
+
+    c.ok("undo", json!({}));
+    let grid = c.ok("get_plate_grid", json!({ "name": plate }));
+    assert_eq!(grid["carries"].as_array().map(Vec::len).unwrap_or_default(), 0, "one undo takes both: {grid}");
+}
diff --git a/crates/app/tests/mod_vise.rs b/crates/app/tests/mod_vise.rs
new file mode 100644
index 000000000..b1ed31148
--- /dev/null
+++ b/crates/app/tests/mod_vise.rs
@@ -0,0 +1,240 @@
+//! Mod vises (#820): every preset's jaw blocks are watertight solids of
+//! their exact figures; a pair placed on a plate's grid lands its fixed
+//! block on the named hole and its adjustable block on the nearest hole
+//! clear of the stock, slid until its face touches the stock (to 1e-6),
+//! at every quarter turn; one undo takes both; and every refusal is
+//! named - out of the slots' reach, off the plate, no grid, no stock,
+//! a stock in the fixed jaw, an off-quarter turn, nonsense figures.
+//!
+//! Gate map (M4.4): covers app::modvise (JawParams, mesh, table, fit),
+//! app::commands::mod_vise (PlaceModVisePair).
+
+use std::collections::HashMap;
+
+use camcraft_app::commands::{History, ImportModel, InsertPlate, PlaceModVisePair, PlatePlacement, SetStock, TagFixture};
+use camcraft_app::fixture;
+use camcraft_app::geometry::{IDENTITY_Q, Mesh, Point3, Triangle, transform_point};
+use camcraft_app::model;
+use camcraft_app::modvise::{self, JawParams, JawSide};
+use camcraft_app::plate::{self, MountAt};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+
+const IN: f64 = 25.4;
+
+fn key(p: Point3) -> [u64; 3] {
+    [p.x.to_bits(), p.y.to_bits(), p.z.to_bits()]
+}
+
+fn assert_watertight(tris: &[Triangle], what: &str) {
+    let mut edges: HashMap<([u64; 3], [u64; 3]), i32> = HashMap::new();
+    for t in tris {
+        for (a, b) in [(t.a, t.b), (t.b, t.c), (t.c, t.a)] {
+            *edges.entry((key(a), key(b))).or_default() += 1;
+        }
+    }
+    for ((a, b), n) in &edges {
+        assert_eq!(*n, 1, "{what}: a directed edge used {n} times");
+        assert_eq!(edges.get(&(*b, *a)), Some(&1), "{what}: an open edge");
+    }
+}
+
+fn volume(tris: &[Triangle]) -> f64 {
+    tris.iter()
+        .map(|t| {
+            let (a, b, c) = (t.a, t.b, t.c);
+            a.x * (b.y * c.z - b.z * c.y) - a.y * (b.x * c.z - b.z * c.x) + a.z * (b.x * c.y - b.y * c.x)
+        })
+        .sum::<f64>()
+        / 6.0
+}
+
+fn bounds(pts: impl Iterator<Item = Point3>) -> ([f64; 3], [f64; 3]) {
+    let mut lo = [f64::MAX; 3];
+    let mut hi = [f64::MIN; 3];
+    for p in pts {
+        for (k, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+            lo[k] = lo[k].min(v);
+            hi[k] = hi[k].max(v);
+        }
+    }
+    (lo, hi)
+}
+
+#[test]
+fn every_preset_block_is_a_watertight_solid_of_its_exact_figures() {
+    let labels: Vec<&str> = modvise::PRESETS.iter().map(|p| p.label).collect();
+    assert_eq!(labels, ["1 in grid 3/8-16", "2 in grid 1/2-13", "50 mm grid M12"]);
+    for row in modvise::PRESETS {
+        for (b, slide) in [(row.fixed(), 0.0), (row.adjustable(), 0.0), (row.adjustable(), row.pitch)] {
+            let b = b.with_slide(slide);
+            let what = format!("{} {} slid {slide}", row.label, b.side.word());
+            b.check().unwrap_or_else(|e| panic!("{what}: {e}"));
+            let tris = b.mesh().expect("meshes");
+            assert_watertight(&tris, &what);
+            let face = b.face_offset + slide;
+            let rear = face - b.jaw_thickness - b.body_length;
+            let w = b.body_width.max(b.jaw_width);
+            let xc = b.centre_x();
+            let (lo, hi) = bounds(tris.iter().flat_map(|t| [t.a, t.b, t.c]));
+            assert_eq!(lo, [xc - 0.5 * w, rear, 0.0], "{what}: exact low corner");
+            assert_eq!(hi, [xc + 0.5 * w, face, b.body_height.max(b.jaw_height)], "{what}: exact high corner");
+            // The body plus the insert slab (jaw shorter than the body).
+            let want = w * (b.body_length * b.body_height + b.jaw_thickness * b.jaw_height);
+            assert!((volume(&tris) - want).abs() < 1e-6 * want, "{what}: outward volume {} vs {want}", volume(&tris));
+        }
+    }
+    // A jaw as tall as the body: one plain box, still closed.
+    let mut b = modvise::preset("50 mm grid M12").map(modvise::ModVisePreset::fixed).expect("preset");
+    b.jaw_height = b.body_height;
+    let tris = b.mesh().expect("meshes");
+    assert_watertight(&tris, "flush jaw");
+    assert_eq!(tris.len(), 12, "a flush jaw is a plain box");
+}
+
+#[test]
+fn nonsense_block_figures_are_refused_by_name() {
+    let fixed = modvise::preset("1 in grid 3/8-16").map(modvise::ModVisePreset::fixed).expect("preset");
+    let adj = modvise::preset("1 in grid 3/8-16").map(modvise::ModVisePreset::adjustable).expect("preset");
+    let bad = |p: JawParams, want: &str| {
+        let e = p.check().err().unwrap_or_default();
+        assert!(e.contains(want), "want '{want}' in: {e}");
+    };
+    bad(JawParams { body_length: 0.0, ..fixed.clone() }, "body length must be more than zero");
+    bad(JawParams { jaw_height: f64::NAN, ..fixed.clone() }, "jaw height must be a finite length");
+    bad(JawParams { slot_travel: 5.0, ..fixed.clone() }, "has no slot travel");
+    bad(adj.with_slide(adj.slot_travel + 1.0), "past its slot travel");
+    bad(JawParams { bolts: vec![[IN, 0.0]], ..fixed.clone() }, "anchor bolt at [0, 0]");
+    bad(JawParams { face_offset: 0.0, ..fixed.clone() }, "bolt at [0.000, 0.000] mm is not inside the body");
+    bad(JawParams { body_length: 40.0, ..adj.clone() }, "inside the body at every slide");
+    bad(JawParams { bolts: vec![[0.0, 0.0]; 17], ..fixed }, "1 to 16 bolts");
+}
+
+/// A 60 x 60 x 20 stock (centred in XY, z 0..20) and a 770MX table plate
+/// laid so the 1 in preset's fixed block at `hole` turned `yaw` has its
+/// jaw face on the stock's near side, the bodies centred on it.
+fn rig(yaw: f64, hole: &str) -> (World, History, String) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location::default()).expect("stock"));
+    let fixed = modvise::preset("1 in grid 3/8-16").map(modvise::ModVisePreset::fixed).expect("preset");
+    let (s, c) = yaw.to_radians().sin_cos();
+    let (d, e) = ((-s.round(), c.round()), (c.round(), s.round()));
+    let near = (-30.0 * d.0, -30.0 * d.1);
+    let anchor = (near.0 - fixed.face_offset * d.0 - fixed.centre_x() * e.0, near.1 - fixed.face_offset * d.1 - fixed.centre_x() * e.1);
+    let p = plate::preset("770MX table 28 x 15 in").map(plate::PlatePreset::params).expect("preset");
+    let (hx, hy) = p.grid().locate(hole).expect("hole");
+    let cmd = InsertPlate::new(&world, &p, None, PlatePlacement::At(Location { pos: Point3::new(anchor.0 - hx, anchor.1 - hy, 0.0), rot: IDENTITY_Q }))
+        .expect("plate");
+    let name = cmd.name().to_owned();
+    history.execute(&world, cmd);
+    (world, history, name)
+}
+
+fn pair(label: &str) -> (JawParams, JawParams) {
+    let row = modvise::preset(label).expect("preset");
+    (row.fixed(), row.adjustable())
+}
+
+/// Fixture `name`'s mesh in the world.
+fn world_mesh(world: &World, name: &str) -> Vec<Point3> {
+    let e = model::find_by_name(world, name).expect(name);
+    let loc = model::transform_of(world, &e).unwrap_or_default();
+    model::facets_of(world, &e).map(|f| f.iter().flat_map(|t| [t.a, t.b, t.c]).map(|p| transform_point(p, loc.pos, loc.rot)).collect()).unwrap_or_default()
+}
+
+#[test]
+fn a_pair_lands_on_the_grid_and_the_adjustable_jaw_touches_the_stock_at_every_quarter_turn() {
+    for (yaw, hole, want_adj) in [(0.0, "C14", "I16"), (90.0, "H20", "J14"), (180.0, "M14", "G12"), (270.0, "H8", "F14")] {
+        let (world, mut history, plate) = rig(yaw, hole);
+        let (f, a) = pair("1 in grid 3/8-16");
+        let cmd = PlaceModVisePair::new(&world, &plate, &f, &a, hole, yaw).unwrap_or_else(|e| panic!("{yaw}: {e}"));
+        let fit = cmd.fit().clone();
+        assert_eq!((fit.fixed_at.as_str(), fit.adjustable_at.as_str()), (hole, want_adj), "{yaw}: the holes");
+        // Stock far side 60 + 44.45 from the fixed anchor; the nearest
+        // clear hole is 6 pitches on (its face 1 in back), so it slides
+        // 6 in - 1 in - 104.45 mm.
+        assert!((fit.slide - (6.0 * IN - IN - 104.45)).abs() < 1e-9, "{yaw}: slide {}", fit.slide);
+        assert!(fit.fixed_gap.abs() < 1e-9 && (fit.opening - 60.0).abs() < 1e-9, "{yaw}: {fit:?}");
+        let (fixed_name, adj_name) = (cmd.names().0.to_owned(), cmd.names().1.to_owned());
+        history.execute(&world, cmd);
+
+        let (s, c) = yaw.to_radians().sin_cos();
+        let d = (-s.round(), c.round());
+        let along = |p: &Point3| p.x * d.0 + p.y * d.1;
+        let fixed_front = world_mesh(&world, &fixed_name).iter().map(along).fold(f64::MIN, f64::max);
+        let adj_front = world_mesh(&world, &adj_name).iter().map(along).fold(f64::MAX, f64::min);
+        assert!((fixed_front + 30.0).abs() < 1e-6, "{yaw}: the fixed jaw on the stock's near side: {fixed_front}");
+        assert!((adj_front - 30.0).abs() < 1e-6, "{yaw}: the adjustable jaw touches the far side: {adj_front}");
+        let z = world_mesh(&world, &adj_name).iter().map(|p| p.z).fold(f64::MAX, f64::min);
+        assert!(z.abs() < 1e-9, "{yaw}: standing on the plate top");
+
+        let def = |n: &str| model::find_by_name(&world, n).and_then(|e| fixture::def_of(&world, &e)).expect(n);
+        assert_eq!(def(&fixed_name).plate.mount.map(|m| (m.plate, m.at)), Some((plate.clone(), MountAt::Hole(hole.into()))));
+        let adj = def(&adj_name);
+        assert_eq!(adj.plate.mount.map(|m| m.at), Some(MountAt::Hole(want_adj.into())));
+        assert_eq!(adj.mod_jaw.as_ref().map(|j| (j.side, (j.slide - fit.slide).abs() < 1e-12)), Some((JawSide::Adjustable, true)));
+
+        assert!(history.undo(&world), "one undo");
+        assert!(model::find_by_name(&world, &fixed_name).is_none() && model::find_by_name(&world, &adj_name).is_none(), "{yaw}: takes both");
+        assert!(history.redo(&world));
+        assert!(model::find_by_name(&world, &adj_name).is_some(), "redo brings them back");
+    }
+}
+
+fn refused(world: &World, plate: &str, f: &JawParams, a: &JawParams, hole: &str, yaw: f64) -> String {
+    PlaceModVisePair::new(world, plate, f, a, hole, yaw).err().map(|e| e.to_string()).unwrap_or_default()
+}
+
+#[test]
+fn every_refusal_is_named() {
+    let (world, mut history, plate) = rig(0.0, "C14");
+    let (f, a) = pair("1 in grid 3/8-16");
+    // Out of reach: the slots travel 10 mm, the stock is 22.55 mm away.
+    let short = JawParams { slot_travel: 10.0, ..a.clone() };
+    let e = refused(&world, &plate, &f, &short, "C14", 0.0);
+    assert!(e.contains("out of reach") && e.contains("22.550") && e.contains("I16"), "{e}");
+    // The stock in the fixed jaw, and behind it.
+    let e = refused(&world, &plate, &f, &a, "D14", 0.0);
+    assert!(e.contains("into the fixed jaw block at D14"), "{e}");
+    // An off-quarter turn, an unknown hole, a hole beside the stock.
+    assert!(refused(&world, &plate, &f, &a, "C14", 45.0).contains("0, 90, 180 or 270"));
+    assert!(refused(&world, &plate, &f, &a, "Z99", 0.0).contains("no location Z99"));
+    assert!(refused(&world, &plate, &f, &a, "C20", 0.0).contains("not between the jaws"));
+    // Two blocks of one side.
+    assert!(refused(&world, &plate, &f, &f, "C14", 0.0).contains("a fixed and an adjustable"));
+    // A plate with no grid.
+    history.execute(&world, ImportModel::from_mesh("Slab", Mesh::from_facets(plate::slab(300.0, 300.0, 10.0))));
+    history.execute(&world, TagFixture::new(&world, "Slab", None).expect("tag"));
+    assert!(refused(&world, "Slab", &f, &a, "A1", 0.0).contains("is not a fixture plate"));
+    assert!(refused(&world, "Nope", &f, &a, "A1", 0.0).contains("Nope"));
+    assert!(model::named_entities(&world).iter().all(|(n, _)| !n.starts_with("Mod vise")), "nothing placed");
+
+    // Off the plate: the plate laid so A1 is the fixed anchor - its body
+    // reaches 1.5 in past the anchor, the hole only 0.5 in from the edge.
+    let (world, _h, plate) = rig(0.0, "A1");
+    let e = refused(&world, &plate, &f, &a, "A1", 0.0);
+    assert!(e.contains("off the plate's -X edge") && e.contains("25.400"), "{e}");
+    // No stock to fit to.
+    let world = new_world();
+    let mut history = History::default();
+    let p = plate::preset("12 x 12 in").map(plate::PlatePreset::params).expect("preset");
+    let cmd = InsertPlate::new(&world, &p, None, PlatePlacement::At(Location::default())).expect("plate");
+    let name = cmd.name().to_owned();
+    history.execute(&world, cmd);
+    assert!(refused(&world, &name, &f, &a, "C3", 0.0).contains("no stock"));
+}
+
+#[test]
+fn bolts_and_pins_must_land_on_holes() {
+    let (world, _h, plate) = rig(0.0, "C14");
+    let (f, a) = pair("1 in grid 3/8-16");
+    let between = JawParams { bolts: vec![[0.0, 0.0], [1.5 * IN, 0.0]], ..f.clone() };
+    let e = refused(&world, &plate, &between, &a, "C14", 0.0);
+    assert!(e.contains("fixed jaw block bolt at [38.100, 0.000]") && e.contains("between holes"), "{e}");
+    let pinned = JawParams { pins: vec![[IN, 0.0]], ..f.clone() };
+    let e = refused(&world, &plate, &pinned, &a, "C14", 0.0);
+    assert!(e.contains("locating pins") && e.contains("no dowel bores"), "{e}");
+}
diff --git a/crates/app/tests/mod_vise_plate.rs b/crates/app/tests/mod_vise_plate.rs
new file mode 100644
index 000000000..91499f798
--- /dev/null
+++ b/crates/app/tests/mod_vise_plate.rs
@@ -0,0 +1,236 @@
+//! Mod vises on their plate (#820): both jaw blocks are riders of the
+//! plate - moving it carries both in its one command (one undo puts all
+//! three back), deleting it lets go of both (they stay where they
+//! stand); the blocks are judged by the real posting gate; and a pair
+//! survives a save and load, a `mod_jaw` key this build can't read (or
+//! that breaks the block law) dropped and logged, never a failed load.
+//!
+//! Gate map (M4.4): covers app::commands::mod_vise (PlaceModVisePair
+//! with app::commands::fixture MoveFixture/DeleteFixture),
+//! app::project::modvise_dto, app::posting (verification_gate).
+
+use std::io::Write;
+use std::sync::{Arc, Mutex};
+
+use camcraft_app::commands::{
+    AddTool, CreateOperation, DeleteFixture, GenerateOperation, History, InsertPlate, MoveFixture, PlaceModVisePair, PlatePlacement,
+    SetStock,
+};
+use camcraft_app::fixture;
+use camcraft_app::geometry::{IDENTITY_Q, Point3};
+use camcraft_app::model;
+use camcraft_app::modvise::{self, JawParams};
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::plate;
+use camcraft_app::posting;
+use camcraft_app::project;
+use camcraft_app::schema::{FixtureDef, Location};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+
+/// The 1 in preset pair, both blocks `tall` high when given.
+fn pair(tall: Option<f64>) -> (JawParams, JawParams) {
+    let row = modvise::preset("1 in grid 3/8-16").expect("preset");
+    let (mut f, mut a) = (row.fixed(), row.adjustable());
+    if let Some(h) = tall {
+        for b in [&mut f, &mut a] {
+            b.body_height = h;
+            b.jaw_height = h;
+        }
+    }
+    (f, a)
+}
+
+/// 60 x 60 x 20 stock (centred, z 0..20), and when `cut` is given a
+/// 4 mm end mill facing it at that height; a 770MX plate under it laid
+/// so the fixed block at C14 has its face on the stock's -Y side; the
+/// pair placed. Returns the plate and the block names.
+fn rig(cut: Option<f64>, tall: Option<f64>) -> (World, History, String, [String; 2]) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location::default()).expect("stock"));
+    if let Some(cut) = cut {
+        let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("catalog");
+        history.execute(&world, AddTool::new(&world, "EM-0400-2FL", tool).expect("tool"));
+        let params = OpParams::Face {
+            holes: Default::default(),
+            tilt: None,
+            blend_turns: false,
+            stepover: 3.0,
+            clearance_z: Height::fixed(25.0),
+            cut_z: Height::fixed(cut),
+            top_z: None,
+            stepdown: None,
+            feed: 1200.0,
+            plunge_feed: 300.0,
+            climb: true,
+        };
+        history.execute(&world, CreateOperation::new(&world, "Face1", "EM-0400-2FL", SrcRef::Stock, params).expect("op"));
+        history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    }
+    let (f, a) = pair(tall);
+    let p = plate::preset("770MX table 28 x 15 in").map(plate::PlatePreset::params).expect("preset");
+    let (hx, hy) = p.grid().locate("C14").expect("hole");
+    // Anchor: the stock's near side less the face offset, the body centred.
+    let anchor = (-f.centre_x(), -30.0 - f.face_offset);
+    let at = Location { pos: Point3::new(anchor.0 - hx, anchor.1 - hy, 0.0), rot: IDENTITY_Q };
+    let cmd = InsertPlate::new(&world, &p, None, PlatePlacement::At(at)).expect("plate");
+    let plate = cmd.name().to_owned();
+    history.execute(&world, cmd);
+    let cmd = PlaceModVisePair::new(&world, &plate, &f, &a, "C14", 0.0).expect("pair");
+    let names = [cmd.names().0.to_owned(), cmd.names().1.to_owned()];
+    history.execute(&world, cmd);
+    (world, history, plate, names)
+}
+
+fn pose(world: &World, name: &str) -> Point3 {
+    model::find_by_name(world, name).and_then(|e| model::transform_of(world, &e)).expect(name).pos
+}
+
+fn def(world: &World, name: &str) -> FixtureDef {
+    model::find_by_name(world, name).and_then(|e| fixture::def_of(world, &e)).expect(name)
+}
+
+fn close(a: Point3, b: Point3) -> bool {
+    (a.x - b.x).abs() + (a.y - b.y).abs() + (a.z - b.z).abs() < 1e-6
+}
+
+#[test]
+fn moving_the_plate_carries_both_blocks_in_one_undo() {
+    let (world, mut history, plate, names) = rig(None, None);
+    let before = names.clone().map(|n| pose(&world, &n));
+    let plate_at = pose(&world, &plate);
+    let to = Location { pos: Point3::new(plate_at.x + 40.0, plate_at.y - 15.0, 5.0), rot: IDENTITY_Q };
+    let mv = MoveFixture::new(&world, &plate, to).expect("move");
+    let mut carried: Vec<&str> = mv.carried().collect();
+    carried.sort_unstable();
+    let mut want: Vec<&str> = names.iter().map(String::as_str).collect();
+    want.sort_unstable();
+    assert_eq!(carried, want, "both blocks ride the plate");
+    history.execute(&world, mv);
+    for (n, b) in names.iter().zip(before) {
+        assert!(close(pose(&world, n), Point3::new(b.x + 40.0, b.y - 15.0, b.z + 5.0)), "{n} moved with the plate");
+    }
+    assert!(history.undo(&world), "one undo");
+    for (n, b) in names.iter().zip(before) {
+        assert!(close(pose(&world, n), b), "{n} back");
+    }
+    assert!(close(pose(&world, &plate), plate_at));
+}
+
+#[test]
+fn deleting_the_plate_lets_go_of_both_blocks() {
+    let (world, mut history, plate, names) = rig(None, None);
+    let before = names.clone().map(|n| pose(&world, &n));
+    history.execute(&world, DeleteFixture::new(&world, &plate).expect("delete"));
+    for (n, b) in names.iter().zip(before) {
+        assert!(def(&world, n).plate.mount.is_none(), "{n} taken off the gone plate");
+        assert!(close(pose(&world, n), b), "{n} stays where it stands");
+        assert!(def(&world, n).mod_jaw.is_some(), "{n} is still a jaw block");
+    }
+    assert!(history.undo(&world));
+    for n in &names {
+        assert_eq!(def(&world, n).plate.mount.map(|m| m.plate), Some(plate.clone()), "{n} back on the plate");
+    }
+}
+
+fn struck(world: &World) -> Vec<String> {
+    posting::verification_gate(world).into_iter().filter(|p| p.starts_with("Face1:") && p.contains("strikes a fixture")).collect()
+}
+
+#[test]
+fn the_blocks_are_judged_by_the_posting_gate() {
+    // Jaws 31.75 mm tall beside the stock: facing at 19.5 runs into them.
+    let (world, _h, _p, _n) = rig(Some(19.5), None);
+    assert!(!struck(&world).is_empty(), "the pass strikes the jaws: {:?}", posting::verification_gate(&world));
+    // Blocks 15 mm tall: the same pass runs over them.
+    let (world, _h, _p, _n) = rig(Some(19.5), Some(15.0));
+    assert!(struck(&world).is_empty(), "{:?}", posting::verification_gate(&world));
+}
+
+#[derive(Clone, Default)]
+struct Captured(Arc<Mutex<Vec<u8>>>);
+
+impl Write for Captured {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        if let Ok(mut v) = self.0.lock() {
+            v.extend_from_slice(buf);
+        }
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<'a> tracing_subscriber::fmt::MakeWriter<'a> for Captured {
+    type Writer = Captured;
+    fn make_writer(&'a self) -> Self::Writer {
+        self.clone()
+    }
+}
+
+/// Replace every `key` value in `j` with `with`.
+fn spoil(j: &mut serde_json::Value, key: &str, with: &serde_json::Value) -> usize {
+    match j {
+        serde_json::Value::Object(o) => {
+            let mut n = 0;
+            if let Some(v) = o.get_mut(key) {
+                *v = with.clone();
+                n += 1;
+            }
+            n + o.values_mut().map(|c| spoil(c, key, with)).sum::<usize>()
+        }
+        serde_json::Value::Array(a) => a.iter_mut().map(|c| spoil(c, key, with)).sum(),
+        _ => 0,
+    }
+}
+
+fn load_logged(path: &std::path::Path) -> (World, String) {
+    let w = new_world();
+    let out = Captured::default();
+    let sub = tracing_subscriber::fmt().with_writer(out.clone()).with_ansi(false).finish();
+    let loaded = tracing::subscriber::with_default(sub, || project::load(&w, path));
+    loaded.expect("the file still loads");
+    let log = out.0.lock().map(|v| String::from_utf8_lossy(&v).into_owned()).unwrap_or_default();
+    (w, log)
+}
+
+#[test]
+fn a_pair_survives_a_save_and_unreadable_keys_are_dropped() {
+    let (world, _h, plate, names) = rig(None, None);
+    let path = std::env::temp_dir().join(format!("camcraft-modvise-{}.camproj", std::process::id()));
+    project::save(&world, &path).expect("save");
+    let text = std::fs::read_to_string(&path).expect("read");
+    let back = new_world();
+    project::load(&back, &path).expect("load");
+    for n in &names {
+        assert_eq!(def(&back, n).mod_jaw, def(&world, n).mod_jaw, "{n}: the block reloads");
+        assert_eq!(def(&back, n).plate.mount, def(&world, n).plate.mount, "{n}: its place reloads");
+    }
+    let mv = MoveFixture::new(&back, &plate, Location { pos: Point3::new(5.0, 0.0, 0.0), rot: IDENTITY_Q }).expect("move");
+    assert_eq!(mv.carried().count(), 2, "the reloaded plate still carries both");
+
+    // A shape this build can't read, and figures that break the law.
+    let mut j: serde_json::Value = serde_json::from_str(&text).expect("json");
+    assert_eq!(spoil(&mut j, "mod_jaw", &serde_json::json!({ "side": "telescopic" })), 2);
+    std::fs::write(&path, j.to_string()).expect("write");
+    let (w, log) = load_logged(&path);
+    assert!(log.contains("mod vise jaw block key not understood"), "{log}");
+    for n in &names {
+        assert!(def(&w, n).mod_jaw.is_none(), "{n}: dropped");
+        assert!(def(&w, n).plate.mount.is_some(), "{n}: its place stays");
+        assert!(model::find_by_name(&w, n).and_then(|e| model::facets_of(&w, &e)).is_some_and(|f| !f.is_empty()), "the steel stays");
+    }
+    let mut j: serde_json::Value = serde_json::from_str(&text).expect("json");
+    let mut bad = serde_json::to_value(def(&world, &names[0]).mod_jaw).expect("value");
+    bad["body_length"] = serde_json::json!(-1.0);
+    assert_eq!(spoil(&mut j, "mod_jaw", &bad), 2);
+    std::fs::write(&path, j.to_string()).expect("write");
+    let (w, log) = load_logged(&path);
+    let _ = std::fs::remove_file(&path);
+    assert!(log.contains("mod vise jaw block parameters dropped on load") && log.contains("body length"), "{log}");
+    assert!(def(&w, &names[0]).mod_jaw.is_none());
+}
diff --git a/crates/ui/src/egui_app/fixture_modvise_rows.rs b/crates/ui/src/egui_app/fixture_modvise_rows.rs
