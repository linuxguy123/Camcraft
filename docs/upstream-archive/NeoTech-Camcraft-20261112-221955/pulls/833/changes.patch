+fn same(a: Location, b: Location) -> bool {
+    let d = (a.pos.x - b.pos.x).abs() + (a.pos.y - b.pos.y).abs() + (a.pos.z - b.pos.z).abs();
+    let q = (0..4).map(|k| (a.rot[k] - b.rot[k]).abs()).sum::<f64>().min((0..4).map(|k| (a.rot[k] + b.rot[k]).abs()).sum());
+    d < 1e-6 && q < 1e-9
+}
