@@ -0,0 +1,114 @@
+//! The wire contour's two laws (#532), run before the path leaves the
+//! generator:
+//!
+//! - **Cover law - the corner minimum** (#290 D8). The wire is a circle
+//!   of the kerf offset's radius rolling along the profile on the waste
+//!   side, so the tightest inside corner it can leave has that radius:
+//!   wire radius plus spark gap. Wherever the profile turns tighter -
+//!   a sharp inside corner, a fillet under the minimum, a slot or notch
+//!   narrower than the kerf - the wire-centre path stands farther than
+//!   the offset from the profile and material the drawing calls cut is
+//!   left standing. Every point of the profile must therefore lie
+//!   within the offset (plus [`COVER_TOL`]) of the path; the worst
+//!   point that does not is refused by name, with its spot.
+//! - **Kerf law.** No move - the leads included - brings the wire's
+//!   centre nearer the profile than the offset (less [`PATH_TOL`]): the
+//!   kerf never enters the product. The path is built to hold this; the
+//!   law is its certificate, and a failure is refused, never trimmed.
+//!
+//! Provenance: plain 2D distance geometry over the rolling-circle
+//! reading of a wire cut (see the module head). Our own code.
+
+use crate::cl::Toolpath;
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::machining2d::GenError;
+
+use super::ring::{dist, pt_ring};
+use super::{WireParams, COVER_TOL, PATH_TOL};
+
+/// The most samples either law reads along the profile or the path.
+const MAX_SAMPLES: f64 = 40_000.0;
+
+/// The sampling step (mm) along a run of `total` mm for offset `k`:
+/// half the offset, widened so the whole run takes at most
+/// [`MAX_SAMPLES`] - vertices are always read, whatever the step.
+fn step_for(k: f64, total: f64) -> f64 {
+    (k * 0.5).max(total / MAX_SAMPLES).max(1e-4)
+}
+
+fn perimeter(ring: &[Point2]) -> f64 {
+    let n = ring.len();
+    (0..n).map(|i| dist(ring[i], ring[(i + 1) % n])).sum()
+}
+
+/// The corner minimum: every point of the profile `given` lies within
+/// the kerf offset of the wire-centre `path_ring`.
+pub(super) fn cover(given: &[Point2], path_ring: &[Point2], p: &WireParams) -> Result<(), GenError> {
+    let k = p.kerf_offset();
+    let reach = k + COVER_TOL;
+    let step = step_for(k, perimeter(given));
+    let n = given.len();
+    let mut worst: Option<(f64, Point2)> = None;
+    for i in 0..n {
+        let (a, b) = (given[i], given[(i + 1) % n]);
+        let len = dist(a, b);
+        let steps = (len / step).ceil().clamp(1.0, 65_536.0) as u32;
+        for j in 0..steps {
+            let f = f64::from(j) / f64::from(steps);
+            let q = Point2::new(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f);
+            let d = pt_ring(q, path_ring);
+            // A NaN distance is never "covered".
+            if d.is_nan() {
+                return Err(GenError::Invalid(
+                    "wire contour: the profile's distance to the wire path is not a number - refused".into(),
+                ));
+            }
+            if d > reach && worst.is_none_or(|(w, _)| d > w) {
+                worst = Some((d, q));
+            }
+        }
+    }
+    let Some((d, q)) = worst else {
+        return Ok(());
+    };
+    Err(GenError::invalid_at(
+        format!(
+            "wire contour: an inside corner or slot of the profile near X{:.3} Y{:.3} is tighter than the wire can cut on the {} side - the minimum inside radius is {k:.4} mm (wire radius {:.4} + spark gap {:.4}), and the kerf would leave {:.4} mm standing there; round it to at least that radius, or cut with a thinner wire",
+            q.x,
+            q.y,
+            p.side.word(),
+            p.wire_diameter * 0.5,
+            p.gap,
+            d - k
+        ),
+        Point3::new(q.x, q.y, p.plane_z),
+    ))
+}
+
+/// The certificate: no move of `path` brings the wire's centre nearer
+/// the profile `given` than the kerf offset `k`.
+pub(super) fn kerf(path: &Toolpath, given: &[Point2], k: f64, z: f64) -> Result<(), GenError> {
+    let total: f64 = path.moves.iter().map(|m| (m.to.x - m.from.x).hypot(m.to.y - m.from.y)).sum();
+    let step = step_for(k, total);
+    let floor = k - PATH_TOL;
+    for (i, m) in path.moves.iter().enumerate() {
+        let (a, b) = (Point2::new(m.from.x, m.from.y), Point2::new(m.to.x, m.to.y));
+        let steps = (dist(a, b) / step).ceil().clamp(1.0, 65_536.0) as u32;
+        for j in 0..=steps {
+            let f = f64::from(j) / f64::from(steps);
+            let q = Point2::new(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f);
+            let d = pt_ring(q, given);
+            if d.is_nan() || d < floor {
+                return Err(GenError::invalid_at(
+                    format!(
+                        "wire contour: move {i} would bring the wire within {d:.4} mm of the profile near X{:.3} Y{:.3} - under the kerf offset ({k:.4} mm), so the kerf would burn into the product; refused",
+                        q.x, q.y
+                    ),
+                    Point3::new(q.x, q.y, z),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/crates/motion/src/wire_edm/mod.rs b/crates/motion/src/wire_edm/mod.rs
new file mode 100644
index 000000000..c48269840
--- /dev/null
+++ b/crates/motion/src/wire_edm/mod.rs
@@ -0,0 +1,247 @@
+//! Wire EDM 2-axis contour (#532, part of #290): one closed profile cut
+//! through the workpiece by a vertical wire. The wire-centre path is
+//! the profile's parallel at the kerf offset - the wire radius plus the
+//! condition's spark gap per side - on the STATED side: inside the
+//! profile for a die (the opening is the product, the slug falls out),
+//! outside it for a punch (the profile is the product). The cut starts
+//! and ends at a stated start hole / threading point, joined to the
+//! path by a straight lead.
+//!
+//! Provenance: general wire EDM practice as the public literature the
+//! umbrella cites states it (#290: the EDM review papers on wire
+//! diameter, kerf and spark gap; the public design guides on start
+//! holes and inside corners) - the wire-centre path is the profile
+//! offset by wire radius plus gap, an enclosed cut is threaded through
+//! a start hole, and no inside corner can be cut tighter than that
+//! offset - read through the umbrella's decisions D1, D2 and D8. The
+//! parallel curve is the textbook polygon offset
+//! (`geo2d::Region::offset_sharp`, clipper2); the leads and the laws
+//! are plain 2D geometry. Our own code; no vendor post, control manual
+//! table or CAM product behaviour was consulted.
+//!
+//! The path is the wire-centre truth on the lower programmed plane.
+//! Its moves state no pose (D2: a vertical cut posts as plain XY) and
+//! no feed (the control's generator sets the rate from the condition).
+//! Nothing here guesses: an open, crossing or area-less profile, a
+//! missing or misplaced start hole, an inside corner or a neck the wire
+//! cannot cut - each is refused by name, never trimmed or rounded.
+//!
+//! Seams left for the family (built by none of this): the wire post
+//! (#533) reads the feed moves between the threading point's visits;
+//! verification (#534), taper as a pose per move (#536), skims as
+//! further offsets (#538) and tabs (#539) stand on this path.
+
+mod laws;
+mod ring;
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geo2d::{Loop, Point2, Region};
+use crate::geometry::Point3;
+use crate::machining2d::GenError;
+
+/// How far (mm) past the kerf offset a point of the profile may stand
+/// from the wire-centre path before the cover law calls it uncut: 2 µm.
+/// It absorbs the facet turns of a tessellated round (a 15° turn at a
+/// 0.2 mm offset reads 1.7 µm) and nothing a drawing would call a
+/// corner: an inside radius 5 µm under the minimum is already refused.
+pub const COVER_TOL: f64 = 0.002;
+/// How far (mm) under the kerf offset the path may come to the profile
+/// before the kerf law refuses it: 10 nm, ten steps of the offsetter's
+/// lattice. The path is built to stand exactly at the offset.
+pub const PATH_TOL: f64 = 1e-5;
+/// The shortest lead (mm) that is a move at all.
+const MIN_LEAD: f64 = 1e-6;
+
+/// Which side of the profile is the product - stated, never inferred
+/// (#290 D8).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WireSide {
+    /// The opening is the product: the wire runs INSIDE the profile.
+    Die,
+    /// The profile is the product: the wire runs OUTSIDE it.
+    Punch,
+}
+
+impl WireSide {
+    /// The side's word, as the notes and refusals say it.
+    #[must_use]
+    pub fn word(self) -> &'static str {
+        match self {
+            WireSide::Die => "die",
+            WireSide::Punch => "punch",
+        }
+    }
+}
+
+/// Everything the generator reads, resolved to plain numbers (mm).
+#[derive(Clone, Debug, PartialEq)]
+pub struct WireParams {
+    /// The wire's diameter, from the machine's condition.
+    pub wire_diameter: f64,
+    /// The spark gap per side, from the machine's condition.
+    pub gap: f64,
+    /// The condition's id, as the control selects it - said in the
+    /// path's notes, never interpreted here.
+    pub condition: String,
+    pub side: WireSide,
+    /// The start hole / threading point; `None` is not stated.
+    pub start: Option<Point2>,
+    /// The lower programmed plane the moves ride.
+    pub plane_z: f64,
+}
+
+fn invalid(why: String) -> GenError {
+    GenError::Invalid(format!("wire contour: {why}"))
+}
+
+impl WireParams {
+    /// How far the wire's centre stands from the profile: the wire
+    /// radius plus the spark gap.
+    #[must_use]
+    pub fn kerf_offset(&self) -> f64 {
+        self.wire_diameter * 0.5 + self.gap
+    }
+
+    /// The width of the slot the wire burns: its diameter plus the gap
+    /// on both sides - twice the offset, the distance a die's path and
+    /// a punch's path on one profile stand apart.
+    #[must_use]
+    pub fn kerf_width(&self) -> f64 {
+        2.0 * self.kerf_offset()
+    }
+
+    /// The door: every refusal of the numbers by name, before any
+    /// geometry is read.
+    ///
+    /// # Errors
+    /// A wire diameter that is not positive, a gap below zero, or a
+    /// non-finite plane or start point.
+    pub fn door(&self) -> Result<(), GenError> {
+        if !(self.wire_diameter.is_finite() && self.wire_diameter > 0.0) {
+            return Err(invalid(format!(
+                "the wire diameter must be a positive number (the condition states {})",
+                self.wire_diameter
+            )));
+        }
+        if !(self.gap.is_finite() && self.gap >= 0.0) {
+            return Err(invalid(format!("the spark gap must be zero or more (the condition states {})", self.gap)));
+        }
+        if !self.kerf_offset().is_finite() {
+            return Err(invalid("the kerf offset is not a finite number".into()));
+        }
+        if !self.plane_z.is_finite() {
+            return Err(invalid("the programmed plane is not a finite height".into()));
+        }
+        if self.start.is_some_and(|s| !(s.x.is_finite() && s.y.is_finite())) {
+            return Err(invalid("the start hole's position is not a finite point".into()));
+        }
+        Ok(())
+    }
+}
+
+/// Cut the one closed profile in `loops` with the wire. `chains` are
+/// open runs: this operation cuts none (an open profile has no punch
+/// or die side) and refuses them by name.
+///
+/// # Errors
+/// Every refusal the module head lists, by name; none is a panic.
+pub fn wire_contour(loops: &[Loop], chains: &[Vec<Point2>], p: &WireParams) -> Result<Toolpath, GenError> {
+    p.door()?;
+    let (given, profile) = ring::profile(loops, chains)?;
+    let k = p.kerf_offset();
+    let path_ring = ring::wire_ring(&profile, p.side, k)?;
+    // The corner minimum (#290 D8): every point of the profile must be
+    // touched by the kerf - judged before the start hole, so a profile
+    // the wire cannot cut is refused whatever else is stated.
+    laws::cover(&given, &path_ring, p)?;
+    let Some(start) = p.start else {
+        return Err(invalid(format!(
+            "no start hole is stated - a closed profile is cut from a threading point ({}); the wire cannot be threaded through solid material",
+            match p.side {
+                WireSide::Die => "a start hole in the slug, inside the profile",
+                WireSide::Punch => "a start hole or the stock's edge, outside the profile",
+            }
+        )));
+    };
+    let (seg, foot) = ring::nearest(&path_ring, start);
+    let lead = ring::dist(start, foot);
+    if !(lead.is_finite() && lead > MIN_LEAD) {
+        return Err(GenError::invalid_at(
+            format!(
+                "wire contour: the start hole at X{:.3} Y{:.3} stands on the wire path itself - move it off the profile by more than the kerf offset ({k:.4} mm)",
+                start.x, start.y
+            ),
+            Point3::new(start.x, start.y, p.plane_z),
+        ));
+    }
+    start_side(&profile, &path_ring, start, p)?;
+    let z = p.plane_z;
+    let mut b = PathBuilder::new(Point3::new(start.x, start.y, z));
+    for q in ring::walk_from(&path_ring, seg, foot) {
+        b.push(MoveKind::Feed, Point3::new(q.x, q.y, z), None);
+    }
+    b.push(MoveKind::Feed, Point3::new(start.x, start.y, z), None);
+    let mut path = b.finish();
+    if path.moves.len() < 4 {
+        return Err(invalid("the wire path lays down no cut".into()));
+    }
+    // The certificate: no move brings the kerf into the product.
+    laws::kerf(&path, &given, k, p.plane_z)?;
+    path.notes.extend(notes(p, start, lead));
+    Ok(path)
+}
+
+/// The start hole must stand on the waste side, at least the kerf
+/// offset from the profile - inside the wire path for a die, outside
+/// it for a punch.
+fn start_side(profile: &Region, path_ring: &[Point2], start: Point2, p: &WireParams) -> Result<(), GenError> {
+    let k = p.kerf_offset();
+    let inside_path = Region::new(vec![Loop::new(path_ring.to_vec())?])?.contains(start);
+    let inside_profile = profile.contains(start);
+    let why = match (p.side, inside_path, inside_profile) {
+        (WireSide::Die, true, _) | (WireSide::Punch, false, _) => return Ok(()),
+        (WireSide::Die, false, true) | (WireSide::Punch, true, false) => format!(
+            "the start hole at X{:.3} Y{:.3} stands closer to the profile than the kerf offset ({k:.4} mm) - the wire would burn the {} there; move it away from the profile",
+            start.x,
+            start.y,
+            p.side.word()
+        ),
+        (WireSide::Die, false, false) => format!(
+            "the start hole at X{:.3} Y{:.3} lies outside the profile - a die is cut from a start hole inside it, in the slug",
+            start.x, start.y
+        ),
+        (WireSide::Punch, true, true) => format!(
+            "the start hole at X{:.3} Y{:.3} lies inside the profile - a punch is cut from outside it; the wire would burn through the punch",
+            start.x, start.y
+        ),
+    };
+    Err(GenError::invalid_at(format!("wire contour: {why}"), Point3::new(start.x, start.y, p.plane_z)))
+}
+
+/// What the path says of itself: the side, the offset and its two
+/// terms, the kerf, the threading point and the leads.
+fn notes(p: &WireParams, start: Point2, lead: f64) -> Vec<String> {
+    let cond = if p.condition.is_empty() { String::new() } else { format!(", condition {}", p.condition) };
+    vec![
+        format!(
+            "wire EDM: {} side - the wire runs {} the profile at {:.4} mm (wire radius {:.4} + spark gap {:.4}{cond}); kerf width {:.4} mm",
+            p.side.word(),
+            match p.side {
+                WireSide::Die => "inside",
+                WireSide::Punch => "outside",
+            },
+            p.kerf_offset(),
+            p.wire_diameter * 0.5,
+            p.gap,
+            p.kerf_width()
+        ),
+        format!(
+            "wire EDM: threaded at X{:.3} Y{:.3}; straight lead-in of {lead:.3} mm to the path's nearest point, the profile cut counter-clockwise, the lead-out back along the lead-in to the threading point",
+            start.x, start.y
+        ),
+        "wire EDM: a vertical cut - the moves state no pose (XY only) and no feed (the control's generator sets the rate); not verified here (no wire sweep against the part yet)".into(),
+    ]
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/motion/src/wire_edm/ring.rs b/crates/motion/src/wire_edm/ring.rs
new file mode 100644
index 000000000..b6b3ce388
--- /dev/null
+++ b/crates/motion/src/wire_edm/ring.rs
@@ -0,0 +1,149 @@
+//! The wire contour's rings (#532): the one closed profile read out of
+//! the picks, its parallel at the kerf offset on the stated side, and
+//! the polyline walks the emitter rides.
+//!
+//! Provenance: the parallel curve is the textbook polygon offset with
+//! mitred joins (clipper2 via `geo2d::Region::offset_sharp`); the walks
+//! are plain polyline geometry. Our own code.
+
+use crate::geo2d::{GeoError, Loop, Point2, Region};
+use crate::machining2d::GenError;
+
+use super::WireSide;
+
+/// The smallest ring area (mm²) that bounds anything: below it a closed
+/// profile is a zero-length or collinear ring.
+const MIN_AREA: f64 = 1e-6;
+
+fn invalid(why: String) -> GenError {
+    GenError::Invalid(format!("wire contour: {why}"))
+}
+
+pub(super) fn dist(a: Point2, b: Point2) -> f64 {
+    (b.x - a.x).hypot(b.y - a.y)
+}
+
+/// Distance from `p` to segment a-b.
+pub(super) fn pt_seg(p: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let l2 = dx * dx + dy * dy;
+    let t = if l2 > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+    (p.x - (a.x + t * dx)).hypot(p.y - (a.y + t * dy))
+}
+
+/// Distance from `p` to the closed ring.
+pub(super) fn pt_ring(p: Point2, ring: &[Point2]) -> f64 {
+    let n = ring.len();
+    (0..n).map(|i| pt_seg(p, ring[i], ring[(i + 1) % n])).fold(f64::INFINITY, f64::min)
+}
+
+/// The one closed profile of the picks: its points as given (what the
+/// laws judge the cut against) and its region. Open runs, several
+/// profiles, a crossing or area-less ring are refused by name.
+pub(super) fn profile(loops: &[Loop], chains: &[Vec<Point2>]) -> Result<(Vec<Point2>, Region), GenError> {
+    if !chains.is_empty() {
+        return Err(invalid(format!(
+            "the profile is open ({} open run(s) picked) - this operation cuts one CLOSED profile; an open profile has no punch or die side",
+            chains.len()
+        )));
+    }
+    let one = match loops {
+        [] => return Err(GenError::Empty("wire contour: no profile to cut".into())),
+        [one] => one,
+        many => {
+            return Err(invalid(format!(
+                "{} closed profiles are picked - one operation cuts one profile from its own start hole; give each profile its own operation",
+                many.len()
+            )));
+        }
+    };
+    let region = Region::new(vec![one.clone()]).map_err(|e| match e {
+        GeoError::Invalid(w) if w.contains("crosses itself") => {
+            invalid("the profile crosses itself - a wire path cannot cross its own kerf".into())
+        }
+        e => invalid(format!("the profile is unusable: {e}")),
+    })?;
+    let area = region.area().abs();
+    if region.loops().len() != 1 || !(area.is_finite() && area > MIN_AREA) {
+        return Err(invalid(
+            "the profile has no area (a zero-length or collinear ring) - there is nothing to cut around".into(),
+        ));
+    }
+    Ok((one.points().to_vec(), region))
+}
+
+/// The wire-centre ring: the profile shrunk by `k` (a die - the wire
+/// inside) or grown by `k` (a punch - the wire outside), mitred so no
+/// corner of the product is rolled over, counter-clockwise. A profile
+/// the wire does not fit, or one whose offset splits or closes a gap,
+/// is refused by name.
+pub(super) fn wire_ring(profile: &Region, side: WireSide, k: f64) -> Result<Vec<Point2>, GenError> {
+    let off = profile.offset_sharp(match side {
+        WireSide::Die => -k,
+        WireSide::Punch => k,
+    })?;
+    let kerf = 2.0 * k;
+    let one = match (off.loops(), side) {
+        ([one], _) => one,
+        ([], WireSide::Die) => {
+            return Err(invalid(format!(
+                "the profile is too small for the wire - no point inside it stands the kerf offset ({k:.4} mm) from its edge"
+            )));
+        }
+        (_, WireSide::Die) => {
+            return Err(invalid(format!(
+                "the profile narrows to a neck under the kerf width ({kerf:.4} mm) - the wire cannot pass it without burning the die"
+            )));
+        }
+        (_, WireSide::Punch) => {
+            return Err(invalid(format!(
+                "the profile has a slot or notch narrower than the kerf width ({kerf:.4} mm) - the wire cannot enter it; widen it or use a thinner wire"
+            )));
+        }
+    };
+    let mut pts = one.points().to_vec();
+    if pts.len() < 3 {
+        return Err(invalid("the wire path has collapsed to a line - the profile is too small for the wire".into()));
+    }
+    if !one.is_ccw() {
+        pts.reverse();
+    }
+    Ok(pts)
+}
+
+/// The nearest point of the closed ring to `p`: (edge index, foot). The
+/// first nearest edge wins a tie, so the answer is deterministic.
+pub(super) fn nearest(ring: &[Point2], p: Point2) -> (usize, Point2) {
+    let n = ring.len();
+    let mut best = (0usize, ring.first().copied().unwrap_or(p), f64::INFINITY);
+    for i in 0..n {
+        let (a, b) = (ring[i], ring[(i + 1) % n]);
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let dd = dx * dx + dy * dy;
+        let t = if dd > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / dd).clamp(0.0, 1.0) } else { 0.0 };
+        let f = Point2::new(a.x + t * dx, a.y + t * dy);
+        let d = dist(f, p);
+        if d < best.2 {
+            best = (i, f, d);
+        }
+    }
+    (best.0, best.1)
+}
+
+/// The closed walk of the counter-clockwise `ring` from `s` on edge
+/// `seg`: s, the ring's vertices in order, and back to s. Coincident
+/// neighbours are dropped.
+pub(super) fn walk_from(ring: &[Point2], seg: usize, s: Point2) -> Vec<Point2> {
+    let n = ring.len();
+    let mut out = vec![s];
+    let push = |p: Point2, out: &mut Vec<Point2>| {
+        if out.last().is_none_or(|q| dist(*q, p) > 1e-9) {
+            out.push(p);
+        }
+    };
+    for k in 1..=n {
+        push(ring[(seg + k) % n], &mut out);
+    }
+    push(s, &mut out);
+    out
+}
diff --git a/crates/motion/src/wire_edm/tests.rs b/crates/motion/src/wire_edm/tests.rs
new file mode 100644
index 000000000..3fe6dfce6
--- /dev/null
+++ b/crates/motion/src/wire_edm/tests.rs
@@ -0,0 +1,233 @@
+//! The wire contour's laws (#532): a die and a punch on one profile
+//! stand apart by exactly the kerf, the corner minimum and the start
+//! hole are refused by name, degenerate profiles give clean errors,
+//! and the moves state no pose.
+//!
+//! The wire and gap below are SYNTHETIC - a plausible size, from no
+//! machine's manual (#290 D4, D10).
+
+use super::ring::pt_ring;
+use super::*;
+use crate::cl::MoveKind;
+
+const WIRE: f64 = 0.25;
+const GAP: f64 = 0.04;
+/// Wire radius + gap.
+const K: f64 = 0.165;
+
+fn params(side: WireSide, start: Option<(f64, f64)>) -> WireParams {
+    WireParams {
+        wire_diameter: WIRE,
+        gap: GAP,
+        condition: "C110".into(),
+        side,
+        start: start.map(|(x, y)| Point2::new(x, y)),
+        plane_z: -12.0,
+    }
+}
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+    Loop::new(vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)]).unwrap()
+}
+
+/// A `w` x `h` rectangle centred on the origin with corners of radius
+/// `r`, each round drawn in 3-degree facets.
+fn rounded(w: f64, h: f64, r: f64) -> Loop {
+    let (hx, hy) = (w * 0.5 - r, h * 0.5 - r);
+    let mut pts = Vec::new();
+    for (cx, cy, a0) in [(hx, hy, 0.0_f64), (-hx, hy, 90.0), (-hx, -hy, 180.0), (hx, -hy, 270.0)] {
+        for s in 0..=30 {
+            let t = (a0 + 3.0 * f64::from(s)).to_radians();
+            pts.push(Point2::new(cx + r * t.cos(), cy + r * t.sin()));
+        }
+    }
+    Loop::new(pts).unwrap()
+}
+
+/// The wire-centre points of the profile's own cut: every move's end
+/// but the lead-in's arrival and the lead-out's return.
+fn ride(path: &Toolpath) -> Vec<Point2> {
+    path.moves[..path.moves.len() - 1].iter().map(|m| Point2::new(m.to.x, m.to.y)).collect()
+}
+
+/// Where the closed polyline `pts` crosses the line x = 0 highest.
+fn top_at_x0(pts: &[Point2]) -> f64 {
+    let n = pts.len();
+    (0..n)
+        .filter_map(|i| {
+            let (a, b) = (pts[i], pts[(i + 1) % n]);
+            ((a.x <= 0.0) != (b.x <= 0.0)).then(|| a.y + (b.y - a.y) * (0.0 - a.x) / (b.x - a.x))
+        })
+        .fold(f64::NEG_INFINITY, f64::max)
+}
+
+fn refusal(loops: &[Loop], chains: &[Vec<Point2>], p: &WireParams) -> String {
+    wire_contour(loops, chains, p).expect_err("refused").to_string()
+}
+
+/// Done means (1): a die and a punch on the same profile are offset to
+/// opposite sides, and their paths stand apart by exactly the kerf.
+#[test]
+fn a_die_and_a_punch_on_one_profile_stand_apart_by_exactly_the_kerf() {
+    let profile = rounded(40.0, 20.0, 2.0);
+    let region = Region::new(vec![profile.clone()]).unwrap();
+    let die = wire_contour(&[profile.clone()], &[], &params(WireSide::Die, Some((0.0, 0.0)))).unwrap();
+    let punch = wire_contour(&[profile.clone()], &[], &params(WireSide::Punch, Some((-30.0, 0.0)))).unwrap();
+    let (d, p) = (ride(&die), ride(&punch));
+    // Opposite sides: the die's wire inside the profile, the punch's outside.
+    assert!(d.iter().all(|q| region.contains(*q)), "the die's wire stays inside the profile");
+    assert!(p.iter().all(|q| !region.contains(*q)), "the punch's wire stays outside the profile");
+    // Each stands the kerf offset off the profile: never nearer (to the
+    // offsetter's lattice), and on the straight sides exactly there.
+    for (name, pts) in [("die", &d), ("punch", &p)] {
+        let near = pts.iter().map(|q| pt_ring(*q, profile.points())).fold(f64::INFINITY, f64::min);
+        let far = pts.iter().map(|q| pt_ring(*q, profile.points())).fold(0.0, f64::max);
+        assert!((near - K).abs() < 1e-6, "{name}: the nearest the wire comes is {near}, the offset is {K}");
+        assert!(far - K < 2e-4, "{name}: the farthest path vertex stands {far} off (a 3-degree facet's mitre)");
+    }
+    // The straight sides: the die's path at y = 10 - k, the punch's at
+    // y = 10 + k - apart by wire diameter + 2 x gap, the kerf width.
+    let (yd, yp) = (top_at_x0(&d), top_at_x0(&p));
+    assert!((yd - (10.0 - K)).abs() < 1e-9 && (yp - (10.0 + K)).abs() < 1e-9, "die {yd}, punch {yp}");
+    let kerf = params(WireSide::Die, None).kerf_width();
+    assert!((kerf - 0.33).abs() < 1e-12, "kerf width = 0.25 + 2 x 0.04");
+    assert!(((yp - yd) - kerf).abs() < 1e-9, "the two paths stand {} apart, the kerf is {kerf}", yp - yd);
+    // The notes say the side and the offset's two terms.
+    assert!(die.notes[0].contains("die side") && die.notes[0].contains("0.1650") && die.notes[0].contains("C110"), "{:?}", die.notes);
+    assert!(punch.notes[0].contains("punch side") && punch.notes[0].contains("kerf width 0.3300"), "{:?}", punch.notes);
+}
+
+/// Done means (2a): a corner tighter than wire radius + gap is refused
+/// by name - on the side where it is an INSIDE corner for the wire.
+#[test]
+fn a_corner_tighter_than_the_wire_is_refused_by_name() {
+    // A sharp rectangle: four inside corners for a die's wire.
+    let sharp = rect(-20.0, -10.0, 20.0, 10.0);
+    let why = refusal(&[sharp.clone()], &[], &params(WireSide::Die, Some((0.0, 0.0))));
+    assert!(why.contains("inside corner") && why.contains("minimum inside radius is 0.1650 mm"), "{why}");
+    assert!(why.contains("wire radius 0.1250 + spark gap 0.0400") && why.contains("die side"), "{why}");
+    // It names the spot: one of the four corners.
+    let at = wire_contour(&[sharp.clone()], &[], &params(WireSide::Die, Some((0.0, 0.0)))).expect_err("refused").location().expect("a spot");
+    assert!((at.x.abs() - 20.0).abs() < 1e-9 && (at.y.abs() - 10.0).abs() < 1e-9 && at.z == -12.0, "{at:?}");
+    // The same corners are OUTSIDE corners for a punch's wire: cut, and sharp.
+    let punch = wire_contour(&[sharp], &[], &params(WireSide::Punch, Some((-30.0, 0.0)))).unwrap();
+    assert!(ride(&punch).iter().any(|q| (q.x - (20.0 + K)).abs() < 1e-9 && (q.y - (10.0 + K)).abs() < 1e-9), "the mitred corner");
+    // A fillet under the minimum is refused; one over it is cut.
+    let tight = refusal(&[rounded(40.0, 20.0, 0.1)], &[], &params(WireSide::Die, Some((0.0, 0.0))));
+    assert!(tight.contains("inside corner") && tight.contains("0.1650"), "{tight}");
+    assert!(wire_contour(&[rounded(40.0, 20.0, 0.2)], &[], &params(WireSide::Die, Some((0.0, 0.0)))).is_ok());
+    // A notch narrower than the kerf is an inside feature for a punch.
+    let notched = Loop::new(vec![
+        Point2::new(-20.0, -10.0),
+        Point2::new(20.0, -10.0),
+        Point2::new(20.0, 10.0),
+        Point2::new(0.1, 10.0),
+        Point2::new(0.1, 5.0),
+        Point2::new(-0.1, 5.0),
+        Point2::new(-0.1, 10.0),
+        Point2::new(-20.0, 10.0),
+    ])
+    .unwrap();
+    let slot = refusal(&[notched], &[], &params(WireSide::Punch, Some((-30.0, 0.0))));
+    assert!(slot.contains("slot") && slot.contains("punch side"), "{slot}");
+}
+
+/// Done means (2b): a closed profile with no start hole is refused by
+/// name; so is a start hole on the product's side or too near it.
+#[test]
+fn a_missing_or_misplaced_start_hole_is_refused_by_name() {
+    let profile = rounded(40.0, 20.0, 2.0);
+    let none = refusal(&[profile.clone()], &[], &params(WireSide::Die, None));
+    assert!(none.contains("no start hole is stated") && none.contains("threaded through solid material"), "{none}");
+    let none = refusal(&[profile.clone()], &[], &params(WireSide::Punch, None));
+    assert!(none.contains("no start hole is stated") && none.contains("outside the profile"), "{none}");
+    let out = refusal(&[profile.clone()], &[], &params(WireSide::Die, Some((-30.0, 0.0))));
+    assert!(out.contains("lies outside the profile") && out.contains("slug"), "{out}");
+    let inside = refusal(&[profile.clone()], &[], &params(WireSide::Punch, Some((0.0, 0.0))));
+    assert!(inside.contains("lies inside the profile") && inside.contains("punch"), "{inside}");
+    // 0.1 mm inside the wall: nearer than the 0.165 mm offset.
+    let near = refusal(&[profile.clone()], &[], &params(WireSide::Die, Some((0.0, 9.9))));
+    assert!(near.contains("closer to the profile than the kerf offset (0.1650 mm)") && near.contains("die"), "{near}");
+    let near = refusal(&[profile.clone()], &[], &params(WireSide::Punch, Some((0.0, 10.1))));
+    assert!(near.contains("closer to the profile than the kerf offset") && near.contains("punch"), "{near}");
+    let on = refusal(&[profile], &[], &params(WireSide::Die, Some((0.0, 10.0 - K))));
+    assert!(on.contains("stands on the wire path itself"), "{on}");
+}
+
+/// Degenerate input errors cleanly, by name - never a panic.
+#[test]
+fn degenerate_profiles_and_numbers_are_refused_by_name() {
+    let p = params(WireSide::Die, Some((0.0, 0.0)));
+    let profile = rounded(40.0, 20.0, 2.0);
+    let open = refusal(&[], &[vec![Point2::new(0.0, 0.0), Point2::new(10.0, 0.0)]], &p);
+    assert!(open.contains("the profile is open") && open.contains("no punch or die side"), "{open}");
+    assert!(refusal(&[], &[], &p).contains("no profile to cut"));
+    let two = refusal(&[profile.clone(), rect(50.0, 0.0, 60.0, 10.0)], &[], &p);
+    assert!(two.contains("2 closed profiles") && two.contains("its own operation"), "{two}");
+    let bow = Loop::new(vec![Point2::new(-5.0, -5.0), Point2::new(5.0, 5.0), Point2::new(5.0, -5.0), Point2::new(-5.0, 5.0)]).unwrap();
+    assert!(refusal(&[bow], &[], &p).contains("crosses itself"));
+    let line = Loop::new(vec![Point2::new(-5.0, 0.0), Point2::new(0.0, 0.0), Point2::new(5.0, 0.0)]).unwrap();
+    assert!(refusal(&[line], &[], &p).contains("no area"));
+    // A zero-length segment in a good ring is just a repeated point.
+    let mut pts = profile.points().to_vec();
+    pts.insert(5, pts[5]);
+    assert!(wire_contour(&[Loop::new(pts).unwrap()], &[], &p).is_ok());
+    // Smaller than the wire; an hourglass whose neck is under the kerf.
+    let tiny = refusal(&[rounded(0.3, 0.3, 0.14)], &[], &p);
+    assert!(tiny.contains("too small for the wire"), "{tiny}");
+    let hourglass = Loop::new(vec![
+        Point2::new(-10.0, -5.0),
+        Point2::new(-0.5, -0.1),
+        Point2::new(0.5, -0.1),
+        Point2::new(10.0, -5.0),
+        Point2::new(10.0, 5.0),
+        Point2::new(0.5, 0.1),
+        Point2::new(-0.5, 0.1),
+        Point2::new(-10.0, 5.0),
+    ])
+    .unwrap();
+    let neck = refusal(&[hourglass], &[], &params(WireSide::Die, Some((-8.0, 0.0))));
+    assert!(neck.contains("neck under the kerf width (0.3300 mm)"), "{neck}");
+    // The numbers' door.
+    for (edit, says) in [
+        ((|q: &mut WireParams| q.wire_diameter = 0.0) as fn(&mut WireParams), "wire diameter must be a positive number"),
+        (|q| q.wire_diameter = f64::NAN, "wire diameter must be a positive number"),
+        (|q| q.gap = -0.01, "spark gap must be zero or more"),
+        (|q| q.gap = f64::INFINITY, "spark gap must be zero or more"),
+        (|q| q.plane_z = f64::NAN, "programmed plane"),
+        (|q| q.start = Some(Point2::new(f64::NAN, 0.0)), "start hole's position"),
+    ] {
+        let mut q = p.clone();
+        edit(&mut q);
+        let why = refusal(&[profile.clone()], &[], &q);
+        assert!(why.contains(says), "{why}");
+    }
+}
+
+/// D2: a vertical cut states no pose and rides one plane - it posts as
+/// XY. The cut is threaded at the start hole, leads straight to the
+/// path's nearest point, closes the loop and returns.
+#[test]
+fn the_moves_ride_one_plane_with_no_pose_from_and_to_the_start_hole() {
+    let profile = rounded(40.0, 20.0, 2.0);
+    let path = wire_contour(&[profile], &[], &params(WireSide::Die, Some((3.0, -1.0)))).unwrap();
+    assert!(path.is_chained() && path.is_prismatic() && !path.has_arcs());
+    assert!(path.moves.iter().all(|m| m.axis.is_none() && m.rotary.is_none()), "no pose is stated");
+    assert!(path.moves.iter().all(|m| m.kind == MoveKind::Feed && m.feed.is_none()), "burning moves, the control's rate");
+    assert!(path.moves.iter().all(|m| m.from.z == -12.0 && m.to.z == -12.0), "one programmed plane");
+    let (start, end) = (path.start().unwrap(), path.end().unwrap());
+    assert_eq!((start.x, start.y), (3.0, -1.0));
+    assert_eq!((end.x, end.y), (3.0, -1.0), "the lead-out returns to the threading point");
+    // The lead-in meets the path square, at its nearest point: straight
+    // down from (3, -1) to the bottom side at y = -10 + k.
+    let entry = path.moves[0].to;
+    assert!((entry.x - 3.0).abs() < 1e-9 && (entry.y - (-10.0 + K)).abs() < 1e-9, "{entry:?}");
+    let back = &path.moves[path.moves.len() - 1];
+    assert_eq!((back.from.x, back.from.y), (entry.x, entry.y), "the loop closes where it began");
+    // Counter-clockwise: the ride's signed area is positive.
+    let pts = ride(&path);
+    let n = pts.len();
+    let area: f64 = (0..n).map(|i| pts[i].x * pts[(i + 1) % n].y - pts[(i + 1) % n].x * pts[i].y).sum::<f64>() * 0.5;
+    assert!(area > 0.0, "counter-clockwise");
+    assert!(path.notes.iter().any(|n| n.contains("threaded at X3.000 Y-1.000") && n.contains("lead-in of 8.835 mm")), "{:?}", path.notes);
+}

From fc7ab7c916021b44b064346cad60af92233262fd Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Thu, 12 Nov 2026 08:28:44 +0100
Subject: [PATCH 2/5] feat(edm): Wire Contour operation - the machine's
 condition at the command door, no library tool, CL goldens

OpType::WireContour (id 41) in its own Wire EDM section and family,
admitted on a wire EDM only. The op names the machine condition it burns
with; CreateOperation / EditOperationParams refuse a missing condition,
gap or wire diameter by name (#531's door), and refuse a library tool on
a wire cut - the condition table is the wire's one source. The stamp
digests the condition's wire and gap, so an edited table re-marks the
cut Stale. Generation runs motion::wire_edm over the picked profile or
the model's through-silhouette. The machine check judges X/Y travel and
names what it does not judge; the post refuses a wire cut by name until
a wire post exists (#533).

Refs #532

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
