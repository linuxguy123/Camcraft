-                }
-            }
-        }
-        // Kerf crossing: within a kerf of an earlier cut's centre line.
-        for e in &p.cuts[..i] {
-            if let Some(at) = near(&c.path, &e.path, p.kerf) {
-                out.push(PlasmaFinding::KerfCrossing { contour: c.contour, earlier: e.contour, at });
-            }
-        }
-    }
