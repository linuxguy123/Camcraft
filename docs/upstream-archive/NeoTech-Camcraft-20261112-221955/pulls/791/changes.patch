--- /dev/null
+++ b/crates/sim/tests/plasma_program.rs
@@ -0,0 +1,135 @@
+//! #672 step 2: a plasma program read from a path's plasma record - the
+//! torch spans become cuts (arcs chorded), the torch-off travel between
+//! them the rapids - and judged: a generated-shape program is clean, the
+//! same cuts in the wrong order are refused, a path without the record
+//! (or with one off its moves) is refused by name.
+//!
+//! Gate map (#672): covers sim::verify::plasma (program).
+//! Provenance: our own fixtures.
+
+use camcraft_sim::cl::{ContourRole, MoveKind, PathBuilder, PlasmaCut as Record, Toolpath, TorchSpan};
+use camcraft_sim::geo2d::Point2;
+use camcraft_sim::geometry::Point3;
+use camcraft_sim::verify::plasma::{judge, CutRole, PlasmaFinding, PlasmaProgram};
+
+const Z: f64 = 0.0;
+const UP: f64 = 10.0;
+
+fn at(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// One lit contour: a rapid to the pierce, the descent, the lit points
+/// (straight), and the span that says so.
+fn lit(b: &mut PathBuilder, contour: u32, role: ContourRole, parent: Option<u32>, pts: &[(f64, f64)]) -> TorchSpan {
+    let (px, py) = pts[0];
+    b.push(MoveKind::Rapid, at(b.at().x, b.at().y, UP), None);
+    b.push(MoveKind::Rapid, at(px, py, UP), None);
+    b.push(MoveKind::Rapid, at(px, py, Z), None);
+    let on = b.moves_len();
+    for &(x, y) in &pts[1..] {
+        b.push(MoveKind::Feed, at(x, y, Z), Some(2500.0));
+    }
+    TorchSpan { contour, role, parent, on, off: b.moves_len() - 1, small: None }
+}
+
+/// The square hole (40..60) with a lead-in from the centre, and the
+/// outline (0..100) with a lead-in and lead-out on the outside.
+const HOLE: &[(f64, f64)] = &[(50.0, 50.0), (50.0, 40.0), (60.0, 40.0), (60.0, 60.0), (40.0, 60.0), (40.0, 40.0), (50.0, 40.0)];
+const OUTLINE: &[(f64, f64)] =
+    &[(-5.0, 50.0), (0.0, 50.0), (0.0, 0.0), (100.0, 0.0), (100.0, 100.0), (0.0, 100.0), (0.0, 50.0), (-5.0, 55.0)];
+
+fn plate(hole_first: bool) -> Toolpath {
+    let mut b = PathBuilder::new(at(50.0, 50.0, UP));
+    let mut torches = Vec::new();
+    if hole_first {
+        torches.push(lit(&mut b, 0, ContourRole::Inner, Some(1), HOLE));
+        torches.push(lit(&mut b, 1, ContourRole::Outer, None, OUTLINE));
+    } else {
+        torches.push(lit(&mut b, 1, ContourRole::Outer, None, OUTLINE));
+        torches.push(lit(&mut b, 0, ContourRole::Inner, Some(1), HOLE));
+    }
+    b.push(MoveKind::Rapid, at(b.at().x, b.at().y, UP), None);
+    let mut t = b.finish();
+    let rec = Record { kerf: 1.5, torches, ..Record::default() };
+    assert!(rec.is_sane(&t.moves), "fixture: the spans sit on the moves");
+    t.plasma = Some(rec);
+    t
+}
+
+#[test]
+fn the_spans_become_cuts_and_the_travel_between_them_the_rapids() {
+    let t = plate(true);
+    let p = PlasmaProgram::from_toolpath(&t).expect("read");
+    assert_eq!(p.kerf, 1.5);
+    assert_eq!(p.cuts.len(), 2);
+    assert_eq!((p.cuts[0].contour, p.cuts[0].role, p.cuts[0].parent, p.cuts[0].small), (0, CutRole::Inner, Some(1), false));
+    assert_eq!(p.cuts[0].path.len(), HOLE.len(), "lead-in and ring, point for point");
+    assert_eq!(p.cuts[0].path[0], Point2::new(50.0, 50.0));
+    // The ring between the two visits of the start (mid-edge, so five points).
+    assert_eq!(p.cuts[0].ring().map(<[Point2]>::len), Some(5));
+    assert_eq!(p.cuts[1].ring().map(<[Point2]>::len), Some(5));
+    assert_eq!(p.rapids, vec![None, Some((Point2::new(50.0, 40.0), Point2::new(-5.0, 50.0)))]);
+    assert_eq!(judge(&p), vec![], "hole first, outline after: clean");
+}
+
+#[test]
+fn the_outline_cut_before_its_hole_is_refused_from_the_record() {
+    let p = PlasmaProgram::from_toolpath(&plate(false)).expect("read");
+    let f = judge(&p);
+    // The order refusal, and - since the pierce lands inside the freed
+    // outline - the tip-up warning on the rapid into the hole.
+    assert_eq!(f[0], PlasmaFinding::CutOrder { contour: 0, enclosing: 1 });
+    assert!(f[0].refuses());
+    assert!(matches!(f.get(1), Some(PlasmaFinding::TipUp { contour: 0, freed: 1, .. })), "{f:?}");
+    assert_eq!(f.len(), 2);
+}
+
+#[test]
+fn lit_arcs_are_chorded_into_the_cut() {
+    let mut b = PathBuilder::new(at(50.0, 50.0, UP));
+    b.push(MoveKind::Rapid, at(50.0, 50.0, Z), None);
+    let on = b.moves_len();
+    b.push(MoveKind::Feed, at(50.0, 40.0, Z), Some(2500.0));
+    b.push_arc(MoveKind::Feed, at(50.0, 60.0, Z), Some(2500.0), Point2::new(50.0, 50.0), true);
+    b.push_arc(MoveKind::Feed, at(50.0, 40.0, Z), Some(2500.0), Point2::new(50.0, 50.0), true);
+    let hole = TorchSpan { contour: 0, role: ContourRole::Inner, parent: Some(1), on, off: b.moves_len() - 1, small: Some(0.65) };
+    let outline = lit(&mut b, 1, ContourRole::Outer, None, OUTLINE);
+    let mut t = b.finish();
+    t.plasma = Some(Record { kerf: 1.5, torches: vec![hole, outline], ..Record::default() });
+    let p = PlasmaProgram::from_toolpath(&t).expect("read");
+    let ring = p.cuts[0].ring().expect("a chorded circle closes");
+    assert!(ring.len() > 8, "{} chord points", ring.len());
+    assert!(ring.iter().all(|q| ((q.x - 50.0).hypot(q.y - 50.0) - 10.0).abs() < 0.02), "on the Ø20 circle");
+    assert!(p.cuts[0].small);
+    assert_eq!(judge(&p), vec![]);
+}
+
+#[test]
+fn a_rapid_over_a_part_already_freed_is_read_and_warned() {
+    // Part A (0..50) ends its lead-out at the far left; the rapid to
+    // part B at x 120 then crosses A's whole width.
+    let a: &[(f64, f64)] = &[(-5.0, 25.0), (0.0, 25.0), (0.0, 0.0), (50.0, 0.0), (50.0, 50.0), (0.0, 50.0), (0.0, 25.0), (-5.0, 30.0)];
+    let b: &[(f64, f64)] = &[(115.0, 10.0), (120.0, 10.0), (120.0, 0.0), (150.0, 0.0), (150.0, 30.0), (120.0, 30.0), (120.0, 10.0)];
+    let mut pb = PathBuilder::new(at(-5.0, 25.0, UP));
+    let torches = vec![lit(&mut pb, 0, ContourRole::Outer, None, a), lit(&mut pb, 1, ContourRole::Outer, None, b)];
+    let mut t = pb.finish();
+    t.plasma = Some(Record { kerf: 1.5, torches, ..Record::default() });
+    let p = PlasmaProgram::from_toolpath(&t).expect("read");
+    let f = judge(&p);
+    assert!(matches!(f.as_slice(), [PlasmaFinding::TipUp { contour: 1, freed: 0, .. }]), "{f:?}");
+    assert!(!f[0].refuses());
+}
+
+#[test]
+fn a_path_without_the_record_or_with_one_off_its_moves_is_refused() {
+    let mut t = plate(true);
+    let rec = t.plasma.take().expect("fixture");
+    let e = PlasmaProgram::from_toolpath(&t).expect_err("no record");
+    assert!(e.contains("no plasma record"), "{e}");
+    let mut off = rec;
+    off.torches[0].off = t.moves.len() + 5;
+    t.plasma = Some(off);
+    let e = PlasmaProgram::from_toolpath(&t).expect_err("off the moves");
+    assert!(e.contains("does not sit on the path's moves"), "{e}");
+}
diff --git a/docs/decisions/672-plasma-laws-2.md b/docs/decisions/672-plasma-laws-2.md
new file mode 100644
index 000000000..f60db5b65
--- /dev/null
+++ b/docs/decisions/672-plasma-laws-2.md
@@ -0,0 +1,82 @@
+## #672 - plasma laws, step 2: the CL reader, the post gate, the cover law
+
+Sources (clean room, behaviour only): Tormach's *1300PL Operator's Manual*
+UM10720 v1223A (§1.4.2, §4.12.8, §4.13 - tip-up, the torch over an open
+kerf, kerf ≈ 1.5x the orifice) and the LinuxCNC Plasma Primer §12 (torch
+height control diving into a cut kerf), as cited on the issue. No vendor
+CAM output or implementation was read.
+
+**1. The program is read from the records, never from text.**
+`PlasmaProgram::from_toolpath(&Toolpath)` (`sim::verify::plasma::program`)
+builds the laws' input from `Toolpath::plasma` - the kerf and each
+`TorchSpan`'s lit moves, chorded at 0.01 mm sagitta, with the torch-off
+travel between spans as the rapid into each cut. A path with no record, or
+a record `PlasmaCut::is_sane` rejects, is refused by name: nothing is
+guessed from bare moves. *Dropped:* re-parsing the `.cl` text (the records
+round-trip the cache already, #676 decision 11).
+
+**2. A refusal blocks the post the way a gouge does.** The gate's new
+plasma clause (`posting::plasma_clause`, `posting_plasma.rs`) runs inside
+`verification_report`, so every surface that reads the gate - the post,
+the per-op and per-mount posts, the script API, the status line - blocks
+on a plasma refusal ("post blocked - Plasma1: plasma cut order: ..."). The
+3D stock sim carves nothing for a torch (it skips the op); that skip is now
+SAID: the report's not-judged line reads "stock sim did not judge this
+program: the 3D stock sim does not run for plasma - Plasma1 judged by the
+2D plasma laws (cut order, cut crossing, kerf crossing, tip-up): clean"
+(or the warnings, named). A plasma op with no path, or a path with no
+record, is a blocking problem of its own - two missing judges never add
+up to a pass (the `posting_sim` law). *Dropped:* a new `GateReport` field
+for the plasma line - the existing `not_judged` line already rides to
+every consumer, and a plasma program IS a program the stock sim did not
+judge; when both lines exist they are joined with `; `.
+
+**3. The laws, step 2.** Beside step 1's cut order (refusal), kerf
+crossing (warning) and tip-up (warning):
+- **Cut crossing (refusal).** A later contour's RING properly crossing an
+  earlier contour's ring: the kerf runs through a part already cut - the
+  through-cut's 2D gouge. The ring is the stretch of a cut between the
+  first point it returns to and that return (leads and a small hole's
+  overburn fall outside it), so a lead running over an earlier kerf stays
+  the torch-height warning, not a gouge.
+- **Enclosure is recomputed from the rings.** Each cut's parent is the
+  smallest earlier-or-later ring enclosing every point of its ring (its
+  path, for an open run or a one-point small hole). A `PARENT` the
+  geometry disagrees with - names a parent but lies in none / in another,
+  names none but lies in one - is refused by name. The cut-order law runs
+  on the verified parent.
+- The review's notes (#675): `small` only on an `INNER` contour; a
+  one-point cut without `small` is "no cut path"; a parent that is an
+  open run is malformed; a closed-role cut whose path never returns to
+  its start is malformed.
+- A rapid that *leaves from* the edge of the part just freed (a cut with
+  no lead-out ends on its ring) is not a tip-up; only an endpoint strictly
+  inside, or a proper crossing, is.
+
+**4. The cover law (#676 decision 12), at generation.** An outward offset
+bridges a slot or notch narrower than the kerf (and an inward offset drops
+a keyway narrower than the kerf from a hole) as ONE loop, so the ring law
+accepted it and the feature was silently left in the material. Now
+`motion::plasma::laws::cover_law` samples every edge of every closed
+contour at 0.25 mm and refuses by name any point farther than one kerf
+width (2r + `KERF_TOL`) from its own cut's lit chords: "a slot, notch or
+inside corner narrower than the kerf is bridged by the offset, not cut".
+*Why one kerf width:* an inside corner the torch rounds off leaves
+r(1/sin(φ/2) − 1) at its vertex - under r for any opening of 60° or more,
+the fillet every round torch leaves and every CAM accepts - while a
+bridged slot's floor stands its whole depth away. *Dropped:* the exact
+right-angle fillet allowance r(√2 − 1), which would refuse every acute
+inside corner the torch can only round; a closing-area measure
+((contour ⊕ r) ⊖ r minus the contour), whose area does not separate a
+shallow notch from a sharp corner's sliver. The law lives beside the kerf
+law in the generator (the nominal contours are there; the CL has no part),
+in `laws.rs`, with `kerf_law` moved out of `emit.rs`.
+
+**5. The machine check's note** (#674) now names where the through-cut IS
+judged: the plasma laws at the post gate, the kerf and cover laws at
+generation, and that the 3D stock sim does not run for a torch.
+
+**Cost to change later:** the laws read a neutral `PlasmaProgram`; a
+post-side reader (the `.cnc` stream, #679) could build the same program
+from its torch records and judge the posted text too, without touching
+the laws.

