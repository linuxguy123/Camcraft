-            return Err(format!("the rapid into contour {} has a non-finite point", c.contour));
-        }
-    }
-    for c in &p.cuts {
-        match c.parent {
-            Some(parent) if parent == c.contour => return Err(format!("contour {} names itself as its parent", c.contour)),
