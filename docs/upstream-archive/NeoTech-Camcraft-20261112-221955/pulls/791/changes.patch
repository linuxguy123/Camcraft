-}
-
-/// The program's shape, refused by name when it cannot be judged.
-fn well_formed(p: &PlasmaProgram) -> Result<(), String> {
-    if !(p.kerf.is_finite() && p.kerf > 0.0) {
-        return Err(format!("plasma kerf {} is not a positive width", p.kerf));
