--- /dev/null
+++ b/crates/app/tests/inverted_probe.rs
@@ -0,0 +1,359 @@
+//! Probing on a machine with an inverted X / Y (#392): the posted Fanuc
+//! probing blocks, run by a macro B controller (`macro_b`) on a
+//! simulated machine whose inverted axis moves the other way, against a
+//! part sitting off its model position, write the PHYSICALLY correct
+//! work offset - the part datum in the controller's coordinates - for
+//! face, edge, corner, bore and boss probing. The same reader on a
+//! standard machine finds the same physical answer (the interpreter is
+//! checked too); a part out of reach alarms; and the standard-sign
+//! program, or a translation missing any one of its probing words, does
+//! NOT find it on the inverted machine (the reader is no tautology).
+//!
+//! Provenance: Fanuc's published operator documentation (G31, custom
+//! macro B, G10 L2); touch-probe practice. Fixture values are our own.
+//!
+//! Gate map (M4.4): covers post::invert (probing), post::js (manifest
+//! flags), assets/posts fanuc.cps (probing hooks), motion::probing.
+
+mod inverted_support;
+mod macro_b;
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::post::cnc::{self, Record};
+use camcraft_app::post::{self, engine, invert, probe_rec};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+use inverted_support::{cps, machine};
+use macro_b::{Pt, Run, Stop};
+
+/// The setup's work-offset origin in the model (CAM world) frame.
+const ORIGIN: Pt = [12.5, -7.25, 3.0];
+/// The machine's physical position of that origin as the model places
+/// it: G54 holds it (negated on an inverted axis) before probing.
+const DATUM: Pt = [-312.5, -201.25, -405.0];
+/// Where the real part sits relative to the model: what probing finds.
+const SHIFT: Pt = [0.37, -0.21, -0.13];
+/// Stylus ball radius.
+const R: f64 = 2.0;
+/// G55 before the program writes it: an unwritten axis stays this.
+const UNSET: f64 = 999.0;
+/// Program words carry three decimals.
+const TOL: f64 = 0.002;
+
+const MACHINES: &[&[&str]] = &[&[], &["X"], &["Y"], &["X", "Y"]];
+
+/// The part, in model coordinates of the stylus ball CENTRE.
+#[derive(Clone, Debug)]
+enum Shape {
+    /// The intersection of half-spaces: (surface point, outward normal).
+    Solid(Vec<(Pt, Pt)>),
+    /// Material outside a vertical bore (centre, radius) below `top`.
+    Bore(Pt, f64),
+    /// Material inside a vertical boss (centre, radius) below its top.
+    Boss(Pt, f64),
+}
+
+impl Shape {
+    fn holds(&self, c: Pt) -> bool {
+        let rho = |o: Pt| ((c[0] - o[0]).powi(2) + (c[1] - o[1]).powi(2)).sqrt();
+        match self {
+            Shape::Solid(faces) => faces
+                .iter()
+                .all(|(q, n)| (c[0] - q[0]) * n[0] + (c[1] - q[1]) * n[1] + (c[2] - q[2]) * n[2] < R),
+            Shape::Bore(o, rad) => rho(*o) > rad - R && c[2] - o[2] < R,
+            Shape::Boss(o, rad) => rho(*o) < rad + R && c[2] - o[2] < R,
+        }
+    }
+}
+
+struct Case {
+    name: &'static str,
+    params: ProbeParams,
+    shape: Shape,
+    /// The axes the probing finds (0 X, 1 Y, 2 Z).
+    found: &'static [usize],
+}
+
+fn params(mode: ProbeMode, dir: ProbeDir, dir_y: ProbeDir, t: Pt, radius: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir,
+        dir_y,
+        target: Point3::new(t[0], t[1], t[2]),
+        radius,
+        ball_diameter: 2.0 * R,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+fn wall(t: Pt, d: ProbeDir) -> (Pt, Pt) {
+    let u = d.unit();
+    (t, [-u.x, -u.y, -u.z])
+}
+
+fn cases() -> Vec<Case> {
+    use ProbeDir::{XNeg, XPos, YNeg, YPos, ZNeg};
+    use ProbeMode::{Boss, Bore, Corner, Edge, Face};
+    let up = |t: Pt| (t, [0.0, 0.0, 1.0]);
+    let (tz, tx, te) = ([10.0, 5.0, 20.0], [40.0, 5.0, 15.0], [20.0, 40.0, 20.0]);
+    let (tc, tn, tb) = ([0.0, 0.0, 20.0], [80.0, 60.0, 20.0], [30.0, 30.0, 20.0]);
+    vec![
+        Case {
+            name: "face -Z",
+            params: params(Face, ZNeg, YPos, tz, 0.0),
+            shape: Shape::Solid(vec![up(tz)]),
+            found: &[2],
+        },
+        Case {
+            name: "face -X",
+            params: params(Face, XNeg, YPos, tx, 0.0),
+            shape: Shape::Solid(vec![wall(tx, XNeg)]),
+            found: &[0],
+        },
+        Case {
+            name: "edge -Y",
+            params: params(Edge, YNeg, YPos, te, 0.0),
+            shape: Shape::Solid(vec![wall(te, YNeg), up(te)]),
+            found: &[1],
+        },
+        Case {
+            name: "corner +X+Y",
+            params: params(Corner, XPos, YPos, tc, 0.0),
+            shape: Shape::Solid(vec![wall(tc, XPos), wall(tc, YPos), up(tc)]),
+            found: &[0, 1],
+        },
+        Case {
+            name: "corner -X-Y",
+            params: params(Corner, XNeg, YNeg, tn, 0.0),
+            shape: Shape::Solid(vec![wall(tn, XNeg), wall(tn, YNeg), up(tn)]),
+            found: &[0, 1],
+        },
+        Case { name: "bore", params: params(Bore, ZNeg, YPos, tb, 10.0), shape: Shape::Bore(tb, 10.0), found: &[0, 1] },
+        Case { name: "boss", params: params(Boss, ZNeg, YPos, tb, 8.0), shape: Shape::Boss(tb, 8.0), found: &[0, 1] },
+    ]
+}
+
+/// The case's probing records: set G55 from the trips, tolerance 0.5.
+fn records(c: &Case) -> Vec<Record> {
+    let t = probe_cycle(&c.params).unwrap_or_else(|e| panic!("{}: {e:?}", c.name));
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 7,
+        tool_name: "PROBE-4",
+        tool_diameter: 2.0 * R,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        wcs: "G54",
+        origin: ORIGIN,
+        probe_result: Some(probe_rec::ProbeResult { set_wcs: Some(1), tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    post::dump(&t, &d)
+}
+
+fn post_for(records: &[Record], letters: &[&str]) -> String {
+    let out = engine::run(&cps("fanuc"), &machine(letters), &cnc::serialize(records))
+        .unwrap_or_else(|e| panic!("inverted {letters:?}: {e}"));
+    assert!(out.warnings.is_empty(), "inverted {letters:?}: {:?}", out.warnings);
+    out.program
+}
+
+fn sign(flip: [bool; 3]) -> Pt {
+    flip.map(|f| if f { -1.0 } else { 1.0 })
+}
+
+fn flip_of(letters: &[&str]) -> [bool; 3] {
+    [letters.contains(&"X"), letters.contains(&"Y"), false]
+}
+
+/// Run `program` on the machine with `flip` inverted, the part shifted
+/// by `shift` off its model position.
+fn simulate(program: &str, flip: [bool; 3], shape: &Shape, shift: Pt) -> Run {
+    let s = sign(flip);
+    let mut offsets = [[UNSET; 3]; 6];
+    offsets[0] = [0, 1, 2].map(|a| s[a] * DATUM[a]);
+    // Physical tip -> model coordinates of the ball centre, with the
+    // part moved by `shift` (so the part's model point m sits at m+shift).
+    let material = |p: Pt| {
+        let c = [0, 1, 2].map(|a| p[a] - DATUM[a] + ORIGIN[a] - shift[a] + if a == 2 { R } else { 0.0 });
+        shape.holds(c)
+    };
+    macro_b::run(program, flip, offsets, &material).unwrap_or_else(|e| panic!("{e}\n{program}"))
+}
+
+/// The register the probing must write: the real part's datum in the
+/// controller's coordinates (negated on an inverted axis).
+fn want(flip: [bool; 3], shift: Pt) -> Pt {
+    let s = sign(flip);
+    [0, 1, 2].map(|a| s[a] * (DATUM[a] + shift[a]))
+}
+
+/// True when the run ends cleanly with G55 right on every found axis
+/// and G54 untouched.
+fn correct(run: &Run, c: &Case, flip: [bool; 3], shift: Pt) -> bool {
+    let (w, g54) = (want(flip, shift), want(flip, [0.0; 3]));
+    run.stop == Stop::End
+        && c.found.iter().all(|&a| (run.offsets[1][a] - w[a]).abs() <= TOL)
+        && (0..3).all(|a| c.found.contains(&a) || run.offsets[1][a] == UNSET)
+        && (0..3).all(|a| (run.offsets[0][a] - g54[a]).abs() < 1e-12)
+}
+
+#[test]
+fn every_mode_sets_the_physical_offset_on_every_machine() {
+    for c in cases() {
+        let recs = records(&c);
+        let touches = recs.iter().filter(|r| matches!(r, Record::Touch(_))).count();
+        for letters in MACHINES {
+            let flip = flip_of(letters);
+            let program = post_for(&recs, letters);
+            let run = simulate(&program, flip, &c.shape, SHIFT);
+            let what = format!("{} on inverted {letters:?}", c.name);
+            assert_eq!(run.stop, Stop::End, "{what}\n{program}");
+            assert_eq!(run.trips.len(), touches, "{what}: every touch trips once\n{program}");
+            assert!(
+                correct(&run, &c, flip, SHIFT),
+                "{what}: G55 {:?}, want {:?} on axes {:?}\n{program}",
+                run.offsets[1],
+                want(flip, SHIFT),
+                c.found
+            );
+        }
+    }
+}
+
+#[test]
+fn a_part_where_the_model_says_sets_the_unchanged_datum() {
+    for c in cases() {
+        for letters in MACHINES {
+            let flip = flip_of(letters);
+            let run = simulate(&post_for(&records(&c), letters), flip, &c.shape, [0.0; 3]);
+            assert!(correct(&run, &c, flip, [0.0; 3]), "{} on {letters:?}: {:?}", c.name, run);
+        }
+    }
+}
+
+#[test]
+fn a_part_out_of_reach_alarms_no_contact_and_writes_nothing() {
+    let c = cases().into_iter().find(|c| c.name == "face -X").expect("face -X");
+    // Travelling -X onto a part 7 mm further -X: past the 5 mm overtravel.
+    for letters in MACHINES {
+        let run = simulate(&post_for(&records(&c), letters), flip_of(letters), &c.shape, [-7.0, 0.0, 0.0]);
+        assert_eq!(run.stop, Stop::Alarm(2, "PROBE NO CONTACT".into()), "{letters:?}");
+        assert_eq!(run.offsets[1], [UNSET; 3], "{letters:?}: no offset is written");
+    }
+}
+
+#[test]
+fn a_part_off_by_more_than_the_tolerance_alarms() {
+    let c = cases().into_iter().find(|c| c.name == "bore").expect("bore");
+    for letters in MACHINES {
+        let run = simulate(&post_for(&records(&c), letters), flip_of(letters), &c.shape, [0.8, 0.0, 0.0]);
+        assert_eq!(run.stop, Stop::Alarm(1, "PROBE X OUT OF TOLERANCE".into()), "{letters:?}");
+        assert_eq!(run.offsets[1], [UNSET; 3], "{letters:?}");
+    }
+}
+
+#[test]
+fn the_standard_program_on_an_inverted_machine_does_not_find_the_part() {
+    for c in cases().into_iter().filter(|c| c.found.iter().any(|&a| a < 2)) {
+        let program = post_for(&records(&c), &[]);
+        for letters in &MACHINES[1..] {
+            let flip = flip_of(letters);
+            if !c.found.iter().any(|&a| flip[a]) {
+                continue; // nothing measured on the inverted axis
+            }
+            let run = simulate(&program, flip, &c.shape, SHIFT);
+            assert!(!correct(&run, &c, flip, SHIFT), "{} untranslated on {letters:?} passed: {run:?}", c.name);
+        }
+    }
+}
+
+/// What a probing program must do on the machine `flip`: set the right
+/// offset for a part within reach, and alarm "no contact" (writing
+/// nothing) for one 7 mm past the first touch's overtravel.
+fn behaves(program: &str, c: &Case, flip: [bool; 3]) -> bool {
+    let u = c.params.dir.unit();
+    let away = [7.0 * u.x, 7.0 * u.y, 7.0 * u.z];
+    let far = simulate(program, flip, &c.shape, away);
+    correct(&simulate(program, flip, &c.shape, SHIFT), c, flip, SHIFT)
+        && far.stop == Stop::Alarm(2, "PROBE NO CONTACT".into())
+        && far.offsets[1] == [UNSET; 3]
+}
+
+/// Undo one word of the translation in a record.
+type Undo = fn(&mut Record);
+
+/// Each probing word the translation negates is load-bearing: undo one
+/// (after the engine's own translation) and the inverted machine
+/// crashes, alarms or sets a wrong offset - or, for the touch target,
+/// probes past its overtravel instead of alarming "no contact" (the
+/// skip runs on toward the wrong end, so a part out of reach is driven
+/// into rather than reported).
+#[test]
+fn every_translated_probing_word_is_needed() {
+    let (x, flip) = (invert::Flip { x: true, y: false, z: false }, [true, false, false]);
+    for c in cases().into_iter().filter(|c| c.name.starts_with("corner")) {
+        let mirrored = invert::translate_with(records(&c), x, true).expect("translates");
+        // The pre-translated stream on a standard post is the engine's
+        // own (less the header line naming the machine's inverted axis).
+        let body = |p: String| p.lines().filter(|l| !l.starts_with("(MACHINE ")).collect::<Vec<_>>().join("\n");
+        assert_eq!(body(post_for(&mirrored, &[])), body(post_for(&records(&c), &["X"])), "{}", c.name);
+        assert!(behaves(&post_for(&mirrored, &[]), &c, flip), "{}: the full translation", c.name);
+        let undo: [(&str, Undo); 3] = [
+            ("touch target", |r| {
+                if let Record::Touch(t) = r {
+                    t.target[0] = -t.target[0];
+                }
+            }),
+            ("back-off delta", |r| {
+                if let Record::Retreat(t) = r {
+                    t.delta[0] = -t.delta[0];
+                }
+            }),
+            ("found expected", |r| {
+                if let Record::Found(f) = r {
+                    f.axes.iter_mut().filter(|a| a.axis == 0).for_each(|a| a.expected = -a.expected);
+                }
+            }),
+        ];
+        for (what, f) in undo {
+            let mut broken = mirrored.clone();
+            broken.iter_mut().for_each(f);
+            assert!(!behaves(&post_for(&broken, &[]), &c, flip), "{}: passes without the {what}", c.name);
+        }
+    }
+}
+
+#[test]
+fn probing_through_an_unverified_script_still_refuses_by_name() {
+    let c = cases().into_iter().find(|c| c.name == "bore").expect("bore");
+    let stream = cnc::serialize(&records(&c));
+    let e = engine::run(&cps("haas"), &machine(&["X"]), &stream).map(|o| o.program).expect_err("refused").to_string();
+    assert_eq!(
+        e,
+        "machine VMC 3-AXIS has an inverted X axis: operation Probe1: probing with a post script that does not \
+         declare probeAxisInversion = true (Fanuc does) is not supported for an inverted axis yet"
+    );
+    let probing = invert::translate(records(&c), invert::Flip { x: false, y: true, z: false });
+    assert!(probing.is_err_and(|e| e.iter().any(|l| l.contains("probeAxisInversion"))), "plain translate refuses");
+}
+
+/// The reader itself: both deviation forms (main's `a--b` and #377's
+/// folded `a+b`) read alike, brackets and ABS nest, IF..GOTO jumps, and
+/// an unmodelled word is an error rather than a pass.
+#[test]
+fn the_macro_reader_reads_both_sign_forms() {
+    let program = "#100=5\n#101=#100--2.5\n#102=#100+2.5\n#103=[[#101+#102]/2]-ABS[-1]\n\
+                   IF[#101EQ#102]GOTO7\n#3000=9(NOT EQUAL)\nN7G10L2P3X[#101]Y[#102]Z#103\nM30";
+    let run = macro_b::run(program, [false; 3], [[0.0; 3]; 6], &|_| false).expect("reads");
+    assert_eq!(run.stop, Stop::End);
+    assert_eq!(run.offsets[2], [7.5, 7.5, 6.5]);
+    let bad = macro_b::run("G90 G02 X1 Y1 I1", [false; 3], [[0.0; 3]; 6], &|_| false);
+    assert!(bad.is_err_and(|e| e.contains("G2 is not modelled")), "an arc is not a probing block");
+}
diff --git a/crates/app/tests/macro_b/expr.rs b/crates/app/tests/macro_b/expr.rs
new file mode 100644
index 000000000..6c7663757
--- /dev/null
+++ b/crates/app/tests/macro_b/expr.rs
@@ -0,0 +1,161 @@
+//! The expression half of the test-only macro B reader (#392): a
+//! cursor over one block with its spaces removed, and the arithmetic -
+//! `#n` / `#[expr]` variables, `[ ]` brackets, `ABS[ ]`, `* /` over
+//! `+ -`, unary minus (so both `#100--15` and `#100+15` read), and the
+//! comparison operators `EQ NE GT LT GE LE` an `IF[ ]` tests.
+//!
+//! Provenance: Fanuc custom macro B as its published operator
+//! documentation describes it (variables, brackets, functions,
+//! conditional expressions). Our own code.
+
+/// One block, upper-cased with its spaces dropped.
+pub struct Cursor {
+    b: Vec<u8>,
+    i: usize,
+}
+
+/// What an expression reads a variable through: the controller's
+/// variables, skip position and work-offset registers.
+pub trait Vars {
+    fn read(&self, n: u32) -> Result<f64, String>;
+}
+
+impl Cursor {
+    pub fn new(text: &str) -> Self {
+        let b = text.bytes().filter(|c| !c.is_ascii_whitespace()).map(|c| c.to_ascii_uppercase()).collect();
+        Self { b, i: 0 }
+    }
+
+    pub fn done(&self) -> bool {
+        self.i >= self.b.len()
+    }
+
+    pub fn peek(&self) -> Option<u8> {
+        self.b.get(self.i).copied()
+    }
+
+    pub fn rest(&self) -> String {
+        String::from_utf8_lossy(self.b.get(self.i..).unwrap_or(&[])).into_owned()
+    }
+
+    /// Consume `k` when the block continues with it.
+    pub fn kw(&mut self, k: &str) -> bool {
+        let hit = self.b.get(self.i..).is_some_and(|r| r.starts_with(k.as_bytes()));
+        if hit {
+            self.i += k.len();
+        }
+        hit
+    }
+
+    pub fn want(&mut self, k: &str) -> Result<(), String> {
+        if self.kw(k) {
+            Ok(())
+        } else {
+            Err(format!("expected {k} at {:?}", self.rest()))
+        }
+    }
+
+    /// An unsigned decimal: digits with at most one point.
+    pub fn num(&mut self) -> Result<f64, String> {
+        let start = self.i;
+        while self.peek().is_some_and(|c| c.is_ascii_digit() || c == b'.') {
+            self.i += 1;
+        }
+        let s = String::from_utf8_lossy(self.b.get(start..self.i).unwrap_or(&[])).into_owned();
+        s.parse::<f64>().map_err(|_| format!("expected a number at {:?}", self.rest()))
+    }
+
+    /// A letter address (`G`, `X`, ...), consumed.
+    pub fn letter(&mut self) -> Option<char> {
+        let c = self.peek().filter(u8::is_ascii_uppercase)?;
+        self.i += 1;
+        Some(c as char)
+    }
+
+    /// A variable number after `#`: a literal or a bracketed expression.
+    pub fn var_no(&mut self, v: &dyn Vars) -> Result<u32, String> {
+        let n = if self.peek() == Some(b'[') { self.primary(v)? } else { self.num()? };
+        if n < 0.0 || n.fract() != 0.0 || n > 99_999.0 {
+            return Err(format!("#{n} is not a variable number"));
+        }
+        Ok(n as u32)
+    }
+
+    pub fn expr(&mut self, v: &dyn Vars) -> Result<f64, String> {
+        let mut a = self.term(v)?;
+        loop {
+            if self.kw("+") {
+                a += self.term(v)?;
+            } else if self.kw("-") {
+                a -= self.term(v)?;
+            } else {
+                return Ok(a);
+            }
+        }
+    }
+
+    fn term(&mut self, v: &dyn Vars) -> Result<f64, String> {
+        let mut a = self.unary(v)?;
+        loop {
+            if self.kw("*") {
+                a *= self.unary(v)?;
+            } else if self.kw("/") {
+                let d = self.unary(v)?;
+                if d == 0.0 {
+                    return Err("division by zero".into());
+                }
+                a /= d;
+            } else {
+                return Ok(a);
+            }
+        }
+    }
+
+    /// A signed primary - also a word's value (`X-1`, `X[#5221+#190]`).
+    pub fn unary(&mut self, v: &dyn Vars) -> Result<f64, String> {
+        if self.kw("-") {
+            return Ok(-self.unary(v)?);
+        }
+        if self.kw("+") {
+            return self.unary(v);
+        }
+        self.primary(v)
+    }
+
+    fn primary(&mut self, v: &dyn Vars) -> Result<f64, String> {
+        if self.kw("[") {
+            let a = self.expr(v)?;
+            self.want("]")?;
+            return Ok(a);
+        }
+        if self.kw("ABS[") {
+            let a = self.expr(v)?;
+            self.want("]")?;
+            return Ok(a.abs());
+        }
+        if self.kw("#") {
+            let n = self.var_no(v)?;
+            return v.read(n);
+        }
+        self.num()
+    }
+
+    /// `a OP b` inside an `IF[ ]`.
+    pub fn cond(&mut self, v: &dyn Vars) -> Result<bool, String> {
+        let a = self.expr(v)?;
+        for (op, f) in [
+            ("EQ", (|a, b| a == b) as fn(f64, f64) -> bool),
+            ("NE", |a, b| a != b),
+            ("GT", |a, b| a > b),
+            ("LT", |a, b| a < b),
+            ("GE", |a, b| a >= b),
+            ("LE", |a, b| a <= b),
+        ] {
+            if self.kw(op) {
+                let b = self.expr(v)?;
+                return Ok(f(a, b));
+            }
+        }
+        Err(format!("expected a comparison at {:?}", self.rest()))
+    }
+}
diff --git a/crates/app/tests/macro_b/mod.rs b/crates/app/tests/macro_b/mod.rs
new file mode 100644
index 000000000..d06fff6ba
--- /dev/null
+++ b/crates/app/tests/macro_b/mod.rs
@@ -0,0 +1,325 @@
+//! Test-only: a Fanuc-style controller that runs the subset of custom
+//! macro B the posted probing blocks use (#392), on a simulated machine
+//! whose X / Y may be inverted, against a simulated part.
+//!
+//! What it models: G0 / G1 (every move swept for a collision with the
+//! part - a stylus driven into material is a crash), G31 skip (the move
+//! stops where the stylus first meets the part; `#5061..#5063` hold that
+//! point in workpiece coordinates, or the block's end when nothing
+//! tripped), G90 / G91, G54..G59 and their registers `#5221 + 20 x slot +
+//! axis`, G10 L2 (set in G90, add in G91), G28 (the program's reference
+//! return: leaves the part, not swept), `#n = expr`, `IF[..]THEN` /
+//! `IF[..]GOTOn`, `#3000` (alarm) and `#3006` / M0 (operator stop).
+//! Anything else is an error: an unmodelled word must fail the test,
+//! never pass it.
+//!
+//! The frame law it simulates: the controller's machine position `M`
+//! is register + program position; physically the tip stands at `S * M`
+//! (S = -1 on an inverted axis). Tool length (G43 H) is taken as zero:
+//! Z is never inverted, so it only shifts Z for every program alike.
+//!
+//! Provenance: Fanuc's published operator documentation (G31 skip and
+//! its system variables, custom macro B, G10 L2 work offsets) and
+//! RS-274 motion semantics. Our own code and names.
+#![allow(dead_code)]
+
+pub mod expr;
+
+use expr::{Cursor, Vars};
+use std::collections::HashMap;
+
+pub type Pt = [f64; 3];
+
+/// Why the program stopped.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Stop {
+    /// M30 / M2, or the end of the text.
+    End,
+    /// `#3000 = n (message)`: the control alarms.
+    Alarm(u32, String),
+    /// `#3006 = n (message)` or M0: the program stops for the operator.
+    Halt(String),
+    /// A G0 / G1 drove the stylus into the part: the line (1-based) and
+    /// the physical point.
+    Crash(usize, Pt),
+}
+
+/// The outcome: the stop, the work-offset registers as the program
+/// left them, and every physical point a G31 tripped at.
+#[derive(Clone, Debug)]
+pub struct Run {
+    pub stop: Stop,
+    pub offsets: [Pt; 6],
+    pub trips: Vec<Pt>,
+}
+
+/// The sweep step, mm: finer than any feature the tests probe.
+const STEP: f64 = 0.005;
+
+struct Ctl<'a> {
+    sign: Pt,
+    material: &'a dyn Fn(Pt) -> bool,
+    vars: HashMap<u32, f64>,
+    offsets: [Pt; 6],
+    active: usize,
+    abs: bool,
+    motion: u32,
+    /// Controller machine coordinates; `None` before the first move and
+    /// after a reference return.
+    pos: Option<Pt>,
+    skip: Pt,
+    trips: Vec<Pt>,
+}
+
+impl Vars for Ctl<'_> {
+    fn read(&self, n: u32) -> Result<f64, String> {
+        match n {
+            5061..=5063 => Ok(self.skip[(n - 5061) as usize]),
+            5221..=5323 if (n - 5221) % 20 < 3 => {
+                let k = (n - 5221) as usize;
+                Ok(self.offsets[k / 20][k % 20])
+            }
+            _ => self.vars.get(&n).copied().ok_or_else(|| format!("read of vacant #{n}")),
+        }
+    }
+}
+
+/// Run `program` on a controller with registers `offsets` (G54..G59,
+/// controller machine coordinates), axes `flip` inverted, and the part
+/// `material(p)` true at physical tip points `p` inside it. `Err` is a
+/// block this reader does not model.
+pub fn run(program: &str, flip: [bool; 3], offsets: [Pt; 6], material: &dyn Fn(Pt) -> bool) -> Result<Run, String> {
+    let s = |on: bool| if on { -1.0 } else { 1.0 };
+    let mut c = Ctl {
+        sign: [s(flip[0]), s(flip[1]), s(flip[2])],
+        material,
+        vars: HashMap::new(),
+        offsets,
+        active: 0,
+        abs: true,
+        motion: 0,
+        pos: None,
+        skip: [0.0; 3],
+        trips: Vec::new(),
+    };
+    let lines: Vec<&str> = program.lines().collect();
+    let (mut pc, mut steps) = (0usize, 0usize);
+    while let Some(line) = lines.get(pc) {
+        steps += 1;
+        if steps > 100_000 {
+            return Err("the program does not end (a GOTO loop?)".into());
+        }
+        let n = pc + 1;
+        pc += 1;
+        match c.line(line, n).map_err(|e| format!("line {n} {line:?}: {e}"))? {
+            Flow::Next => {}
+            Flow::Goto(label) => {
+                pc = lines
+                    .iter()
+                    .position(|l| {
+                        let mut c = Cursor::new(l);
+                        c.kw("N") && c.num().ok() == Some(f64::from(label))
+                    })
+                    .ok_or_else(|| format!("line {n}: GOTO {label} names no block"))?;
+            }
+            Flow::Stop(stop) => return Ok(Run { stop, offsets: c.offsets, trips: c.trips }),
+        }
+    }
+    Ok(Run { stop: Stop::End, offsets: c.offsets, trips: c.trips })
+}
+
+enum Flow {
+    Next,
+    Goto(u32),
+    Stop(Stop),
+}
+
+/// The block without its `( )` comments, and the comments' text.
+fn split_comment(line: &str) -> (String, String) {
+    let (mut code, mut note, mut depth) = (String::new(), String::new(), 0);
+    for ch in line.chars() {
+        match ch {
+            '(' => depth += 1,
+            ')' if depth > 0 => depth -= 1,
+            _ if depth > 0 => note.push(ch),
+            _ => code.push(ch),
+        }
+    }
+    (code, note)
+}
+
+impl Ctl<'_> {
+    fn line(&mut self, raw: &str, n: usize) -> Result<Flow, String> {
+        let (code, note) = split_comment(raw);
+        let mut cur = Cursor::new(&code);
+        if cur.done() || cur.peek() == Some(b'%') {
+            return Ok(Flow::Next);
+        }
+        if cur.peek() == Some(b'O') {
+            return Ok(Flow::Next); // the program number
+        }
+        if cur.kw("N") {
+            cur.num()?;
+        }
+        if cur.kw("IF[") {
+            let yes = cur.cond(self)?;
+            cur.want("]")?;
+            if cur.kw("GOTO") {
+                let to = cur.num()?;
+                return Ok(if yes { Flow::Goto(to as u32) } else { Flow::Next });
+            }
+            cur.want("THEN")?;
+            if !yes {
+                return Ok(Flow::Next);
+            }
+            return self.assign(&mut cur, &note);
+        }
+        if cur.peek() == Some(b'#') {
+            return self.assign(&mut cur, &note);
+        }
+        self.block(&mut cur, n)
+    }
+
+    fn assign(&mut self, cur: &mut Cursor, note: &str) -> Result<Flow, String> {
+        cur.want("#")?;
+        let to = cur.var_no(self)?;
+        cur.want("=")?;
+        let v = cur.expr(self)?;
+        if !cur.done() {
+            return Err(format!("trailing text {:?}", cur.rest()));
+        }
+        match to {
+            3000 => return Ok(Flow::Stop(Stop::Alarm(v as u32, note.trim().to_owned()))),
+            3006 => return Ok(Flow::Stop(Stop::Halt(note.trim().to_owned()))),
+            5221..=5323 if (to - 5221) % 20 < 3 => {
+                let k = (to - 5221) as usize;
+                self.offsets[k / 20][k % 20] = v;
+            }
+            100..=199 | 500..=999 => {
+                self.vars.insert(to, v);
+            }
+            _ => return Err(format!("#{to} is not a variable this reader writes")),
+        }
+        Ok(Flow::Next)
+    }
+
+    fn block(&mut self, cur: &mut Cursor, n: usize) -> Result<Flow, String> {
+        let mut words: Vec<(char, f64)> = Vec::new();
+        while !cur.done() {
+            let l = cur.letter().ok_or_else(|| format!("expected an address at {:?}", cur.rest()))?;
+            words.push((l, cur.unary(self)?));
+        }
+        let get = |l: char| words.iter().find(|(c, _)| *c == l).map(|(_, v)| *v);
+        let (mut skip, mut g10, mut home) = (false, false, false);
+        for (l, v) in &words {
+            let code = (v * 10.0).round() as i64;
+            match (l, code) {
+                ('G', 0 | 10) => self.motion = code as u32,
+                ('G', 310) => skip = true,
+                ('G', 900) => self.abs = true,
+                ('G', 910) => self.abs = false,
+                ('G', 100) => g10 = true,
+                ('G', 280) => home = true,
+                ('G', 540..=590) if code % 10 == 0 => self.active = (code / 10 - 54) as usize,
+                ('G', 170 | 400 | 430 | 490 | 800) => {}
+                ('M', 0) => return Ok(Flow::Stop(Stop::Halt("M0".into()))),
+                ('M', 20 | 300) => return Ok(Flow::Stop(Stop::End)),
+                ('M', 10 | 50 | 60 | 80 | 90) | ('T' | 'H' | 'F' | 'S', _) => {}
+                ('X' | 'Y' | 'Z', _) => {}
+                ('L' | 'P', _) if g10 || words.iter().any(|(c, w)| *c == 'G' && *w == 10.0) => {}
+                _ => return Err(format!("{l}{v} is not modelled")),
+            }
+        }
+        if g10 {
+            if get('L') != Some(2.0) {
+                return Err("only G10 L2 (work offsets) is modelled".into());
+            }
+            let p = get('P').ok_or("G10 L2 needs P")?;
+            if !(1.0..=6.0).contains(&p) || p.fract() != 0.0 {
+                return Err(format!("G10 L2 P{p} is not G54..G59"));
+            }
+            let slot = p as usize - 1;
+            for (a, l) in ['X', 'Y', 'Z'].into_iter().enumerate() {
+                if let Some(v) = get(l) {
+                    self.offsets[slot][a] = if self.abs { v } else { self.offsets[slot][a] + v };
+                }
+            }
+            return Ok(Flow::Next);
+        }
+        if home {
+            self.pos = None; // to the reference point, away from the part
+            return Ok(Flow::Next);
+        }
+        let given = [get('X'), get('Y'), get('Z')];
+        if given.iter().all(Option::is_none) {
+            return Ok(Flow::Next);
+        }
+        let mut end = [0.0; 3];
+        for a in 0..3 {
+            end[a] = match (given[a], self.pos, self.abs) {
+                (Some(v), _, true) => self.offsets[self.active][a] + v,
+                (Some(v), Some(p), false) => p[a] + v,
+                (None, Some(p), _) => p[a],
+                _ => return Err("a move from an unknown position".into()),
+            };
+        }
+        if skip {
+            let from = self.pos.ok_or("G31 from an unknown position")?;
+            let at = self.skip_to(from, end);
+            self.skip = [0, 1, 2].map(|a| at[a] - self.offsets[self.active][a]);
+            self.pos = Some(at);
+            return Ok(Flow::Next);
+        }
+        if let Some(hit) = self.sweep(self.pos, end) {
+            return Ok(Flow::Stop(Stop::Crash(n, hit)));
+        }
+        self.pos = Some(end);
+        Ok(Flow::Next)
+    }
+
+    fn phys(&self, m: Pt) -> Pt {
+        [0, 1, 2].map(|a| self.sign[a] * m[a])
+    }
+
+    fn lerp(a: Pt, b: Pt, t: f64) -> Pt {
+        [0, 1, 2].map(|k| a[k] + (b[k] - a[k]) * t)
+    }
+
+    fn samples(a: Pt, b: Pt) -> usize {
+        let len = ((b[0] - a[0]).powi(2) + (b[1] - a[1]).powi(2) + (b[2] - a[2]).powi(2)).sqrt();
+        ((len / STEP).ceil() as usize).max(1)
+    }
+
+    /// The first physical point of a feed / rapid inside the part.
+    fn sweep(&self, from: Option<Pt>, to: Pt) -> Option<Pt> {
+        let Some(a) = from else {
+            let p = self.phys(to);
+            return (self.material)(p).then_some(p);
+        };
+        let n = Self::samples(a, to);
+        (1..=n).map(|k| self.phys(Self::lerp(a, to, k as f64 / n as f64))).find(|p| (self.material)(*p))
+    }
+
+    /// A G31 from `a` toward `b`: the controller position where the
+    /// stylus first meets the part (bisected to well under a micron), or
+    /// `b` when it never does.
+    fn skip_to(&mut self, a: Pt, b: Pt) -> Pt {
+        let n = Self::samples(a, b);
+        let inside = |t: f64| (self.material)(self.phys(Self::lerp(a, b, t)));
+        let Some(k) = (1..=n).find(|k| inside(*k as f64 / n as f64)) else {
+            return b;
+        };
+        let (mut lo, mut hi) = ((k - 1) as f64 / n as f64, k as f64 / n as f64);
+        for _ in 0..60 {
+            let mid = 0.5 * (lo + hi);
+            if inside(mid) {
+                hi = mid;
+            } else {
+                lo = mid;
+            }
+        }
+        let at = Self::lerp(a, b, lo);
+        self.trips.push(self.phys(at));
+        at
+    }
+}
