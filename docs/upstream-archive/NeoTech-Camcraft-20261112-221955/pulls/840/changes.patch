@@ -0,0 +1,16 @@
+//! The `grblhal.cps` script suite (#710): the post binary on every recorded
+//! edge-case stream (`recorded/streams/*.cnc`), its program or its named
+//! refusal compared with the golden in `recorded/golden/grblhal/`. No app, no
+//! toolpath generation: the inputs are recorded, and their generators keep
+//! them current (`recorded_streams.rs`, app's `recorded_post_streams.rs`).
+//!
+//! Regenerate after an intentional change, then read the diff:
+//! `WRITE_GOLDEN=1 cargo test -p camcraft-post --test script_grblhal`
+//!
+//! Gate map (M4.4): covers assets/posts/grblhal.cps, camcraft_post::post::engine,
+//! camcraft_post::post::cnc, the post binary.
+
+#[macro_use]
+mod recorded;
+
+post_suite!("grblhal.cps");
