 crates/app/tests/fanuc_post.rs     |  4 +-
 crates/app/tests/grblhal_post.rs   | 79 +++++++++++++++++++-----------
 docs/decisions/710-grblhal-post.md | 32 ++++++++----
 6 files changed, 121 insertions(+), 70 deletions(-)

