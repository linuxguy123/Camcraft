From 4e5968ad7a8bd3dd02b21473e8bda6453c007e41 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Wed, 11 Nov 2026 12:40:37 -0800
Subject: [PATCH] fix(ui): the refusal ghost's overlay-budget warning goes
 through diag_warn!

refusal_ghost.rs printed with eprintln!, which a browser build drops and
the diag-seam law (diag::tests::shared_ui_code_prints_only_through_the_diag_seam)
refuses. Same message, through the diag seam.

Fixes #907

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/ui/src/refusal_ghost.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/ui/src/refusal_ghost.rs b/crates/ui/src/refusal_ghost.rs
index f3b6df59f..711803c7c 100644
--- a/crates/ui/src/refusal_ghost.rs
+++ b/crates/ui/src/refusal_ghost.rs
@@ -41,7 +41,7 @@ pub(crate) fn ghost_lines(out: &mut Vec<[f32; 6]>, ghost: &Ghost, pal: &Semantic
         let segs = if m.arc.is_some() { arc_segments(m) } else { vec![(m.from, m.to)] };
         for (a, b) in segs {
             if !dashed(out, a, b, period, c) {
-                eprintln!(
+                diag_warn!(
                     "overlay: the refusal's ghost outgrew the {MAX_OVERLAY_VERTICES}-vertex display budget; \
                      the rest is not drawn (a ghost is never a toolpath either way)"
                 );
