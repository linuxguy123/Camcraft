diff --git a/crates/app/tests/probe_dialects.rs b/crates/app/tests/probe_dialects.rs
new file mode 100644
index 000000000..a25f61b2f
--- /dev/null
+++ b/crates/app/tests/probe_dialects.rs
@@ -0,0 +1,148 @@
+//! #173 acceptance: the probing hooks of the Haas, Mazak and Siemens 840D
+//! posts, and the Heidenhain post's named refusal. Each voiced dialect
+//! posts the same bore-centre probe the generic dialect's golden
+//! (`nc/fanuc/probe_bore_centre.nc`, tests/probe_op.rs) posts, through
+//! the whole post seam (dump -> stream text -> engine -> <dialect>.cps).
+//!
+//! Provenance: the public programming documentation each post cites in
+//! its probing section (Haas Mill Operator's Manual; Mazak EIA/ISO
+//! programming manual; SINUMERIK 840D sl Fundamentals / Job Planning);
+//! our own fixtures.
+//!
+//! Gate map (M4.4): covers assets/posts (haas, mazak, sinumerik,
+//! heidenhain probing), post::probe_rec, motion::probing.
+
+mod common;
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::post::{self, cnc, engine};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+
+const HAAS: &str = include_str!("../../../assets/posts/haas.cps");
+const MAZAK: &str = include_str!("../../../assets/posts/mazak.cps");
+const SINUMERIK: &str = include_str!("../../../assets/posts/sinumerik.cps");
+const HEIDENHAIN: &str = include_str!("../../../assets/posts/heidenhain.cps");
+
+/// The bore centre of tests/probe_op.rs: a 20 mm bore at (30, 30),
+/// rim Z 20, four touches (seek + measure each).
+fn bore_stream(set_wcs: Option<u8>, wcs: &str) -> String {
+    let p = ProbeParams {
+        mode: ProbeMode::Bore,
+        dir: ProbeDir::ZNeg,
+        dir_y: ProbeDir::YPos,
+        target: Point3::new(30.0, 30.0, 20.0),
+        radius: 10.0,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    };
+    let t = probe_cycle(&p).expect("bore");
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 7,
+        tool_name: "PROBE-4",
+        tool_diameter: 4.0,
+        rpm: 0.0,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        wcs,
+        probe_result: Some(post::probe_rec::ProbeResult { set_wcs, tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    let recs = post::dump(&t, &d);
+    assert!(!recs.iter().any(|r| matches!(r, cnc::Record::Warn { .. })), "a sane probe path carries no WARN");
+    cnc::serialize(&recs)
+}
+
+fn post_ok(cps: &str, stream: &str) -> String {
+    let out = engine::run(cps, &serde_json::Value::Null, stream).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(
+        !out.program.lines().any(|l| l.split_whitespace().any(|w| w == "M3" || w == "M8" || w == "MOTON")),
+        "a touch probe starts no spindle and no coolant:\n{}",
+        out.program
+    );
+    out.program
+}
+
+#[test]
+fn haas_bore_centre_posts_g31_skips() {
+    let prog = post_ok(HAAS, &bore_stream(Some(1), "G54"));
+    assert_eq!(prog.lines().filter(|l| l.starts_with("G31 ")).count(), 8, "four touches, seek + measure");
+    assert!(prog.contains("IF[ABS[#5061-43]LT0.001]THEN#3000=2(PROBE NO CONTACT)"), "{prog}");
+    assert!(prog.contains("#100=#5061"), "the measured trip is kept");
+    assert!(prog.contains("G91 G1 X-1 Y0 Z0 F300"), "the back-off is incremental");
+    assert!(prog.contains("G10 L2 P2 X[#5221+#190] Y[#5222+#191]"), "the result sets G55 from G54: {prog}");
+    common::write_golden("nc/haas/probe_bore_centre.nc", &prog);
+}
+
+#[test]
+fn haas_without_an_offset_to_set_stops_for_the_operator() {
+    let prog = post_ok(HAAS, &bore_stream(None, "G54"));
+    assert!(!prog.contains("G10"), "nothing is set");
+    assert!(prog.contains("#3006=1(CHECK PROBE RESULT #190..)"), "{prog}");
+}
+
+#[test]
+fn mazak_bore_centre_posts_g31_skips_with_goto_tests() {
+    let prog = post_ok(MAZAK, &bore_stream(Some(1), "G54"));
+    assert_eq!(prog.lines().filter(|l| l.starts_with("G31 ")).count(), 8, "four touches, seek + measure");
+    assert!(!prog.contains("THEN"), "the branch is IF..GOTO, not IF..THEN");
+    assert!(prog.contains("IF[ABS[#5061-43]GE0.001]GOTO9001\n#3000=2(PROBE NO CONTACT)\nN9001\n"), "{prog}");
+    assert!(prog.contains("G91 G01 X-1 Y0 Z0 F300"), "the back-off is incremental");
+    assert!(prog.contains("G10 L2 P2 X[#5221+#190] Y[#5222+#191]"), "the result sets G55 from G54: {prog}");
+    // Every GOTO label is unique, so no jump can land on another test's.
+    let labels: Vec<&str> = prog.lines().filter(|l| l.starts_with("N9")).collect();
+    let mut uniq = labels.clone();
+    uniq.sort_unstable();
+    uniq.dedup();
+    assert_eq!(labels.len(), uniq.len(), "unique labels: {labels:?}");
+    common::write_golden("nc/mazak/probe_bore_centre.nc", &prog);
+}
+
+#[test]
+fn mazak_without_an_offset_to_set_stops_for_the_operator() {
+    let prog = post_ok(MAZAK, &bore_stream(None, "G54"));
+    assert!(!prog.contains("G10"), "nothing is set");
+    assert!(prog.contains("(CHECK PROBE RESULT #190..)\nM00\n"), "{prog}");
+}
+
+#[test]
+fn sinumerik_bore_centre_posts_meas_blocks() {
+    let prog = post_ok(SINUMERIK, &bore_stream(Some(1), "G54"));
+    assert_eq!(prog.lines().filter(|l| l.contains(" MEAS=1 G1 ")).count(), 8, "four touches, seek + measure");
+    assert!(!prog.contains("G31"), "a Siemens control measures with MEAS, not G31");
+    assert!(prog.contains(" IF $AC_MEA[1]==0\n"), "a touch that never trips alarms: {prog}");
+    assert!(prog.contains(" R50=$AA_MW[X]\n"), "the trip is read in workpiece coordinates");
+    assert!(prog.contains(" G91 G1 X-1 Y0 Z0 F300\n"), "the back-off is incremental");
+    assert!(prog.contains(" $P_UIFR[2,X,TR]=$P_UIFR[1,X,TR]+R90\n"), "the result sets G55 from G54: {prog}");
+    assert!(prog.contains(" $P_UIFR[2,X,FI]=$P_UIFR[1,X,FI]\n"), "the fine part follows the active frame");
+    common::write_golden("nc/sinumerik/probe_bore_centre.nc", &prog);
+}
+
+/// G58 / G59 are axial programmable offsets on an 840D, not settable
+/// frames: a probe asked to set one is refused by name, never posted.
+#[test]
+fn sinumerik_refuses_setting_g59_by_name() {
+    let out = engine::run(SINUMERIK, &serde_json::Value::Null, &bore_stream(Some(5), "G54")).expect("post");
+    assert!(out.warnings.iter().any(|w| w.contains("G59") && w.contains("settable frames")), "{:?}", out.warnings);
+    assert!(!out.program.contains("$P_UIFR"), "nothing is set");
+}
+
+/// Heidenhain's ISO manual states no skip move and no trip-position
+/// variable (probing is the touch-probe cycles, another manual): the
+/// post defines no probing hook and the engine refuses by name - a
+/// counted warning, which blocks the post (posting::post_script).
+#[test]
+fn heidenhain_refuses_a_probe_by_name() {
+    let out = engine::run(HEIDENHAIN, &serde_json::Value::Null, &bore_stream(Some(1), "G54")).expect("engine runs");
+    for hook in ["onProbeMove", "onProbeRetreat", "onProbeResult"] {
+        assert!(out.warnings.iter().any(|w| w.contains(hook)), "refused by {hook}: {:?}", out.warnings);
+    }
+}
diff --git a/docs/decisions/173-probe-hooks-dialects.md b/docs/decisions/173-probe-hooks-dialects.md
new file mode 100644
index 000000000..1a6a5cf37
--- /dev/null
+++ b/docs/decisions/173-probe-hooks-dialects.md
@@ -0,0 +1,69 @@
+## #173 - probing hooks for the Haas, Mazak, Siemens and Heidenhain posts (2026-11-08)
+
+- **Chosen:** Haas, Mazak and Siemens 840D voice `onProbeMove` /
+  `onProbeRetreat` / `onProbeResult`; Heidenhain keeps the engine's
+  named refusal (no hook defined, a comment in `heidenhain.cps` says
+  why). Each voiced post keeps the generic dialect's contract
+  (`fanuc.cps`, #108): a skip/measuring move to the overtravel target,
+  an immediate no-contact alarm (a probe that never touched must not
+  back off and measure air), the measured trip copied to variables, an
+  incremental (G91) back-off, the mean of opposite trips minus the
+  expected value as the deviation, an alarm past the tolerance, then
+  either the work offset written (active offset + deviation) or a stop
+  for the operator. Goldens: `nc/{haas,mazak,sinumerik}/probe_bore_centre.nc`
+  (the bore centre of `nc/fanuc/probe_bore_centre.nc`), pinned by
+  `crates/app/tests/probe_dialects.rs`.
+- **Sources, per dialect** (public documentation only; no Fusion 360 /
+  HSMWorks post or output consulted):
+  - **Haas** - the Haas Mill Operator's Manual (haascnc.com): G31 feed
+    until skip; macro system variables #5061-#5063 (skip signal
+    position), #3000 (programmable alarm), #3006 (programmable stop
+    with message), #5221.. (G54..G59 work offsets, 20 per slot); G10 L2
+    P1..P6; IF[..]THEN. Same words as the generic dialect, one-digit
+    G1 and unpadded T/H as the Haas post already writes.
+  - **Mazak** - Mazak's published EIA/ISO programming manual (the
+    Fanuc-compatible G-code mode): G31 skip, #5061-#5063, #3000,
+    #5221.., G10 L2. Two deliberate differences from Haas: the branch
+    is `IF[..]GOTOn` with a unique `N9001..` label per test (IF..THEN is
+    not documented by every Mazak EIA generation; GOTO is), and the
+    no-offset stop is a comment + `M00`, not `#3006` (not clearly
+    documented for Mazak). This is the weakest-sourced of the three:
+    the variable numbers follow the Fanuc-compatible table the EIA mode
+    states, and a maintainer with a Mazak manual at hand should confirm.
+  - **Siemens 840D** - SINUMERIK 840D sl Programming Manual
+    Fundamentals / Job Planning (public): `MEAS=1` on a `G1` block
+    (probe 1, rising edge, distance-to-go deleted), `$AC_MEA[1]` (probe
+    responded), `$AA_MW[axis]` (trip in workpiece coordinates),
+    `IF..ENDIF`, `MSG`, `SETAL` (user cycle alarms 65000..), settable
+    frames `$P_UIFR[n,axis,TR|FI]` taking effect when the G5x is
+    programmed again (the post re-selects the active G5x after writing).
+    Reading a main-run variable stops preprocessing implicitly, so no
+    explicit `STOPRE` is written.
+  - **Heidenhain** - refused. This post is specced from the TNC 640
+    ISO User's Manual (ID 892909-25), which documents no free skip move
+    and no trip-position variable; TNC probing is the touch-probe
+    cycles (call form and result Q parameters in the separate
+    touch-probe cycle manual). No cycle number or Q parameter is guessed.
+- **Judgement calls:**
+  - Sinumerik keeps trips in `R50..R61` and deviations in `R90..`,
+    inside R0..R99 (more R parameters are a machine-data setting), and
+    refuses by name past 13 measurements (none of today's modes exceeds 4).
+  - Sinumerik refuses setting G58/G59 (axial programmable offsets on
+    an 840D, not settable frames) and any active offset outside
+    G54..G57 / G505..G599, by name. When the target frame differs from
+    the active one, the fine part (`FI`) is copied too so the target
+    equals active + deviation.
+  - Haas, Mazak and Sinumerik `startPreamble` now skip the spindle-on
+    block at 0 rpm (as `fanuc.cps` already did, #108): a touch probe
+    starts no spindle. No existing golden carried an `S0`.
+  - Arming the probe (its M-code / output on the machine) is not
+    written by any post: no stream record states it and the code is
+    machine-builder specific. An unarmed probe never trips; every touch
+    then alarms at once at its target, after the overtravel - the same
+    behaviour as the generic dialect.
+- **Dropped:** voicing Heidenhain via `G55`/cycle 0 from memory
+  (unsourced); IF..THEN on Mazak (generation-dependent); `R100+` on
+  Siemens (not guaranteed to exist).
+- **Cost to change:** each dialect's hooks are one section of its
+  `.cps` and one golden; a Heidenhain voicing needs the touch-probe
+  cycle manual and a fourth golden.

From 10f3ecf853873a24e2294565597ac135c936aae3 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mikekinney@Mikes-MacBook-Pro.local>
Date: Sun, 8 Nov 2026 15:20:37 -0800
Subject: [PATCH 2/4] fix(post): probe deviations fold their sign in the Haas,
 Mazak and Sinumerik posts

onProbeResult wrote each deviation as mean - expected with the expected
value printed signed, so an edge or outside-corner probe (negative
expected value) posted a doubled sign: #190=#100--2 / R90=R50--2. The
sign is now folded into the operator (mean + |expected|), as the Tormach
post already does. The right-hand side is left unbracketed: the fold
alone fixes the defect and the bore-centre goldens stay byte-identical.

Pinned by haas_/mazak_/sinumerik_edge_deviation_folds_its_sign in
probe_dialects (no '--', '+-' or '-+' anywhere; folded deviation line).

Refs #173

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 assets/posts/haas.cps              |  6 +++-
 assets/posts/mazak.cps             |  6 +++-
 assets/posts/sinumerik.cps         |  6 +++-
 crates/app/tests/probe_dialects.rs | 47 ++++++++++++++++++++++++++----
 4 files changed, 57 insertions(+), 8 deletions(-)

