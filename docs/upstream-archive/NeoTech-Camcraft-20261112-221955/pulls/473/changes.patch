diff --git a/crates/ui/src/state_tool_body.rs b/crates/ui/src/state_tool_body.rs
new file mode 100644
index 000000000..96076c166
--- /dev/null
+++ b/crates/ui/src/state_tool_body.rs
@@ -0,0 +1,224 @@
+//! The tool editor's body draft (#371): an imported holder mesh in its
+//! own model frame, the numeric placement (axis preset or picked face
+//! normal, tip offset), the pick mode, and the one command Apply body
+//! queues. The draft is ephemeral pane state like `ToolUi`: picks and
+//! previews only fill it; `SetToolBody` (one undo step) is the only
+//! thing that reaches the world, and its refusal lands on the Tool pane
+//! by name. Provenance: our own pane state over `app::tool_body_view`;
+//! no vendor material consulted.
+
+use std::path::Path;
+use std::sync::Arc;
+
+use camcraft_app::commands::{SetToolBody, ToolBodySpec};
+use camcraft_app::geometry::Triangle;
+use camcraft_app::schema::ToolBody;
+use camcraft_app::tool_body_view::{self, BodyPick};
+use camcraft_app::{model, tool_body};
+
+use super::{CommandKind, ErrorScope, State};
+
+/// What the next click on the editor's body preview does.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum BodyPickMode {
+    /// Drag orbits; clicks do nothing.
+    #[default]
+    Off,
+    /// The click's nearest facet corner becomes the tool tip.
+    Tip,
+    /// The clicked facet's outward normal becomes the tool axis.
+    Axis,
+}
+
+/// The editor's body draft for the tool it is open on.
+#[derive(Clone, Default)]
+pub struct ToolBodyUi {
+    /// The tool the draft belongs to (the editor's `tool_ui.name`).
+    pub tool: String,
+    /// Where the mesh came from, for display.
+    pub source: String,
+    /// The mesh in its own frame: as imported, or a landed body's
+    /// tool-frame facets (tip at the origin, +Z up) when re-edited.
+    pub facets: Arc<[Triangle]>,
+    /// The model direction that is the tool axis (tip to spindle).
+    pub axis: [f64; 3],
+    /// The model origin's height above the tip, along `axis`.
+    pub offset: f64,
+    pub pick: BodyPickMode,
+    /// The preview's orbit, radians off its default view.
+    pub yaw: f32,
+    pub pitch: f32,
+    /// The world body the draft last mirrored (identity, not value):
+    /// a change there (Apply, Undo, Redo, Open) re-mirrors.
+    seen: Option<Arc<[Triangle]>>,
+    /// Placement preview, cached against the (mesh, axis, offset) it read.
+    preview: Option<(PreviewKey, Result<ToolBody, String>)>,
+}
+
+type PreviewKey = (usize, [u64; 4]);
+
+/// A body as Apply body states it, for the command queue. Debug prints
+/// the facet count, never the mesh.
+#[derive(Clone)]
+pub struct BodyDraft {
+    pub source: String,
+    pub facets: Arc<[Triangle]>,
+    pub axis: [f64; 3],
+    pub offset: f64,
+}
+
+impl std::fmt::Debug for BodyDraft {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("BodyDraft")
+            .field("source", &self.source)
+            .field("facets", &self.facets.len())
+            .field("axis", &self.axis)
+            .field("offset", &self.offset)
+            .finish()
+    }
+}
+
+fn same(a: Option<&Arc<[Triangle]>>, b: Option<&Arc<[Triangle]>>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(x), Some(y)) => Arc::ptr_eq(x, y),
+        _ => false,
+    }
+}
+
+impl State {
+    /// The body landed on the editor's tool, if any.
+    pub(crate) fn editor_tool_body(&self) -> Option<ToolBody> {
+        let e = model::find_by_name(&self.world, &self.tool_ui.name)?;
+        tool_body::body_of(&self.world, &e)
+    }
+
+    /// Keep the draft on the editor's tool: a new tool, or a world body
+    /// that changed under it, re-mirrors (a landed body re-edits in its
+    /// tool frame: +Z, offset 0, which re-applies to the same facets).
+    /// An unapplied import survives unrelated document edits.
+    pub(crate) fn sync_tool_body_ui(&mut self) {
+        let world = self.editor_tool_body();
+        let facets = world.as_ref().map(|b| Arc::clone(&b.facets));
+        if self.tool_body_ui.tool == self.tool_ui.name && same(facets.as_ref(), self.tool_body_ui.seen.as_ref()) {
+            return;
+        }
+        let mut d = ToolBodyUi { tool: self.tool_ui.name.clone(), axis: [0.0, 0.0, 1.0], ..ToolBodyUi::default() };
+        if let Some(b) = world {
+            d.source = b.source;
+            d.facets = b.facets;
+        }
+        d.seen = facets;
+        self.tool_body_ui = d;
+    }
+
+    /// "Import body…": pick a mesh file, then read it into the draft.
+    pub(crate) fn import_tool_body_dialog(&mut self) {
+        if let Some(path) = super::pick_mesh_file() {
+            self.import_tool_body_from(&path);
+        }
+    }
+
+    /// Read a STEP / STL / OBJ into the draft (+Z axis, origin at the
+    /// tip until placed). Nothing reaches the world until Apply body.
+    pub(crate) fn import_tool_body_from(&mut self, path: &Path) {
+        self.sync_tool_body_ui();
+        match tool_body_view::load(path) {
+            Ok((source, facets)) => {
+                let d = &mut self.tool_body_ui;
+                self.status = format!(
+                    "body {source}: {} facets - set the axis and tip, then Apply body",
+                    facets.len()
+                );
+                d.source = source;
+                d.facets = Arc::from(facets);
+                d.axis = [0.0, 0.0, 1.0];
+                d.offset = 0.0;
+                d.pick = BodyPickMode::Off;
+                d.preview = None;
+            }
+            Err(err) => self.refuse(ErrorScope::Tool, format!("tool body not imported: {err}")),
+        }
+    }
+
+    /// The draft's placement as `SetToolBody` would read it, cached.
+    pub(crate) fn tool_body_preview(&mut self) -> Option<&Result<ToolBody, String>> {
+        let d = &mut self.tool_body_ui;
+        if d.facets.is_empty() {
+            return None;
+        }
+        let key: PreviewKey = (
+            d.facets.as_ptr() as usize,
+            [d.axis[0].to_bits(), d.axis[1].to_bits(), d.axis[2].to_bits(), d.offset.to_bits()],
+        );
+        if d.preview.as_ref().is_none_or(|(k, _)| *k != key) {
+            d.preview = Some((key, tool_body_view::preview(&d.facets, d.axis, d.offset)));
+        }
+        d.preview.as_ref().map(|(_, r)| r)
+    }
+
+    /// A click on the preview in a pick mode fills the numbers (ephemeral).
+    pub(crate) fn apply_body_pick(&mut self, hit: BodyPick) {
+        let d = &mut self.tool_body_ui;
+        match d.pick {
+            BodyPickMode::Off => return,
+            BodyPickMode::Tip => match tool_body_view::tip_offset_at(hit.vertex, d.axis) {
+                Some(o) => {
+                    d.offset = o;
+                    self.status = format!("tip picked: offset {o:.3} mm along the axis");
+                }
+                None => self.status = "tip not picked: set a usable axis first".into(),
+            },
+            BodyPickMode::Axis => match hit.normal {
+                Some(n) => {
+                    d.axis = n;
+                    self.status = format!(
+                        "axis picked: {}",
+                        tool_body_view::axis_label(n).map_or_else(|| format!("({:.3}, {:.3}, {:.3})", n[0], n[1], n[2]), str::to_owned)
+                    );
+                }
+                None => self.status = "axis not picked: that facet has no area".into(),
+            },
+        }
+        self.tool_body_ui.pick = BodyPickMode::Off;
+    }
+
+    /// "Apply body": queue the one `SetToolBody` for the draft.
+    pub(crate) fn queue_apply_tool_body(&mut self) {
+        let d = &self.tool_body_ui;
+        if d.facets.is_empty() {
+            return;
+        }
+        let body = BodyDraft { source: d.source.clone(), facets: Arc::clone(&d.facets), axis: d.axis, offset: d.offset };
+        self.pending.push_back(CommandKind::SetToolBody { name: self.tool_ui.name.clone(), body: Some(body) });
+    }
+
+    /// "Clear body": a landed body is cleared by command (undoable); an
+    /// unapplied import is only dropped from the draft.
+    pub(crate) fn clear_tool_body(&mut self) {
+        if self.editor_tool_body().is_some() {
+            self.pending.push_back(CommandKind::SetToolBody { name: self.tool_ui.name.clone(), body: None });
+        } else {
+            self.tool_body_ui = ToolBodyUi { tool: self.tool_ui.name.clone(), axis: [0.0, 0.0, 1.0], ..ToolBodyUi::default() };
+        }
+    }
+
+    /// The command handler: build (place, envelope, fit) now; a refusal
+    /// lands on the Tool pane by name and the draft stays for correction.
+    pub(crate) fn run_set_tool_body(&mut self, name: &str, body: Option<BodyDraft>) {
+        let clearing = body.is_none();
+        let spec = body.map(|b| ToolBodySpec { source: b.source, facets: b.facets.to_vec(), axis: b.axis, offset: b.offset });
+        match SetToolBody::new(&self.world, name, spec) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = if clearing {
+                    format!("tool {name}: body cleared")
+                } else {
+                    format!("tool {name}: body set")
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Tool, format!("tool body not set: {err}")),
+        }
+    }
+}
diff --git a/docs/decisions/371-tool-body-ui.md b/docs/decisions/371-tool-body-ui.md
new file mode 100644
index 000000000..5b446c26b
--- /dev/null
+++ b/docs/decisions/371-tool-body-ui.md
@@ -0,0 +1,76 @@
+## #371 - tool bodies in the tool editor, the viewport and the simulation (milling)
+
+- **Chosen: a Body column in the tool editor window** (third column,
+  beside the profile preview): Import body… / Clear body, the axis
+  (six model-direction presets, or a picked face normal shown as
+  "picked (x, y, z)"), the tip offset (the model origin's height above
+  the tip, the number `SetToolBody` takes), Pick tip / Pick axis, a
+  placement note, and Apply body. Why a column and not rows under the
+  preview: the fields column is already ~600 px tall, and stacking put
+  Apply body below a 720 px screen. The window's default anchor moved
+  left by the column's width so it stays centred (and clear of the
+  library pane's Delete button). Dropped: a separate body window (one
+  more floating surface to keep in sync with the editor's tool).
+- **Picking happens in a small 3D preview inside the editor**, painted
+  with egui (flat-shaded, depth-sorted triangles, orthographic, drag to
+  orbit), not in the main viewport. Why: the main viewport draws the
+  document in world space; picking a mesh that is not yet attached to
+  anything there would need a temporary scene part, a placement for it,
+  and a pick mode that competes with the face/edge/vertex picks. The
+  in-editor preview needs no GPU, runs under the test harness, and its
+  ray (`View::ray`) feeds the existing ray/triangle crossing
+  (`app::pick::soup_hit`). Over 30 000 facets it paints every n-th facet;
+  picks always read them all.
+- **Pick tip** takes the hit facet's corner nearest the click and sets
+  `offset = -dot(corner, axis)`, so that corner lands at height 0 (the
+  tip). Snapping to a corner, not the raw hit, gives a repeatable number
+  on a coarse mesh. **Pick axis** takes the clicked facet's outward
+  normal: the user clicks a face looking toward the spindle (the
+  holder's top). Dropped: snapping a picked normal to the nearest preset
+  - a vendor body modelled on a tilted frame would then be unalignable.
+- **Picks and orbit are ephemeral; Apply body is the one command.** The
+  draft (`ToolBodyUi`, `state_tool_body.rs`) is pane state like
+  `ToolUi`. Apply body queues `CommandKind::SetToolBody`, which builds
+  `SetToolBody` (place, envelope, tool fit) and either executes it (one
+  undo step) or refuses on the Tool pane by name ("tool body not set:
+  ..."), leaving the draft as it was for correction. Clear body on a
+  landed body is the same command with `None` (undoable); on an
+  unapplied import it only drops the draft. The draft re-mirrors when
+  the world body changes by identity (`Arc::ptr_eq` on the facets):
+  Apply, Undo, Redo or Open re-mirror, while an unrelated edit (Apply
+  on the tool numbers) keeps an unapplied import. A landed body
+  re-edits in its tool frame (+Z, offset 0), which re-applies to the
+  same facets; the original model frame is not stored (#368 stores the
+  placed facets only).
+- **Live placement note:** the draft's placement runs through
+  `tool_body_view::preview` (the same `place` + `build` the command
+  runs, cached on mesh/axis/offset) and the editor shows either "placed:
+  foot .. to top .." or the envelope's refusal before Apply. The profile
+  preview overlays the placed body's revolved envelope bands in amber
+  over the cylinders. A tool with no body draws exactly as before.
+- **Simulation:** while the transport is up, the running operation's
+  tool body is posed at the playhead (`tool_body_view::posed`: tool
+  frame to the frame's tip and axis by the shortest rotation, Rodrigues;
+  the turn about the axis is free because the body is judged by its
+  revolved envelope) and drawn as one more model part - depth-tested
+  and shaded by the existing GPU pipeline. It reads the cached timeline
+  only when it is this document version's, so it never re-walks the
+  program per frame. Without a body nothing is added. There are no
+  holder/shank cylinders drawn anywhere in the viewport today (the sim
+  draws an axis marker only), so "unchanged cylinders" means unchanged:
+  no body, no new geometry. Dropped: drawing the cylinder assembly for
+  body-less tools (a separate display feature).
+- **File read is synchronous** on the UI thread (`tool_body_view::load`,
+  the model importer). A holder file is small next to a part; the
+  worker-thread import path is wired to `ImportModel` and would need a
+  second result kind. Revisit if users import heavy assemblies.
+- **App seam:** everything the UI needs from a body lives in
+  `app::tool_body_view` (load, presets, preview, pick, tip offset,
+  posing, body of an operation's tool); the UI has no geometry of its
+  own beyond the preview's view math.
+- **Snapshot:** the tool editor's pixels change (the new column).
+  Pixel snapshots are release-lane (#255); `egui_tool_editor.png` is not
+  regenerated here. Structural tests pin the flow instead.
+- **Not in this slice:** lathe holders (#369), the spun holder-profile
+  editor (#93), ISO 13399 frames (#370), a rotation about the axis for
+  display, and drawing a body outside the simulation.

From 9656e4c0c4c2bfba02d3635669db533a7286d884 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mikekinney@Mikes-MacBook-Pro.local>
Date: Sun, 8 Nov 2026 17:09:06 -0800
Subject: [PATCH 2/5] fix(ui): draw the whole tool in the simulation when it
 has a body, and frame it

On a real document the body was posed a shank length above the tip
with nothing below it, off the top of a part-framed view, so the
simulation looked the same with and without it. A tool with a body now
draws whole while simulating - cutter and shank revolved from its
numbers up into the body (app::tool_body_view::assembly) - at every
playhead, paused or playing, stale or fresh; Frame takes the posed
assembly in. Tools without a body draw exactly as before.

Pinned on the user's own document (step_block_371.camproj fixture).

Refs #371

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
