  {
    "sha": "55b7b83d0aa3fa0dd42b6c8b8bf050e1a5fd4368",
    "node_id": "C_kwDOVoU8JdoAKDU1YjdiODNkMGFhM2ZhMGRkNDJiNmM4YjhiZjA1MGUxYTVmZDQzNjg",
    "commit": {
      "author": {
        "name": "Mike Kinney",
        "email": "mikekinney@Mikes-MacBook-Pro.local",
