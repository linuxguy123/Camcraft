diff --git a/crates/app/tests/probe_report.rs b/crates/app/tests/probe_report.rs
new file mode 100644
index 000000000..195088b7f
--- /dev/null
+++ b/crates/app/tests/probe_report.rs
@@ -0,0 +1,116 @@
+//! #575 acceptance: a probe program reports the deviation it measured on
+//! the control before it writes the work offset, in the dialect's own
+//! non-stopping message, or writes nothing where the dialect has none.
+//! - Tormach PathPilot / LinuxCNC: one `(DEBUG, PROBE <axis> ERROR #19n)`
+//!   per probed axis, after that axis's tolerance test and before the
+//!   `G10 L20` (or the measure-only MSG/M0 stop).
+//! - Fanuc (custom macro B): no non-stopping display exists (#3000 alarms,
+//!   #3006 stops), so nothing is added before the `G10 L2`.
+//!
+//! Provenance: the LinuxCNC G-code reference ("Messages" / "Comments":
+//! DEBUG shows like MSG and substitutes #n), Fanuc's published custom
+//! macro B documentation (#3000 / #3006); our own fixtures.
+//!
+//! Gate map (M4.4): covers assets/posts (tormach + fanuc probe result),
+//! post::probe_rec, motion::probing.
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::machine::parse_mch;
+use camcraft_app::post::{self, cnc, engine, machine};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+
+const TORMACH: &str = include_str!("../../../assets/posts/tormach.cps");
+const FANUC: &str = include_str!("../../../assets/posts/fanuc.cps");
+const MX770: &str = include_str!("../../../assets/machines/tormach-770mx.mch");
+
+fn cycle(mode: ProbeMode, dir: ProbeDir, target: Point3, radius: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir,
+        dir_y: ProbeDir::YPos,
+        target,
+        radius,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+fn face() -> ProbeParams {
+    cycle(ProbeMode::Face, ProbeDir::ZNeg, Point3::new(10.0, 5.0, 20.0), 0.0)
+}
+fn corner() -> ProbeParams {
+    cycle(ProbeMode::Corner, ProbeDir::XPos, Point3::new(0.0, 0.0, 20.0), 0.0)
+}
+
+fn stream(p: &ProbeParams, set_wcs: Option<u8>) -> String {
+    let t = probe_cycle(p).expect("probe cycle");
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 99,
+        tool_name: "PROBE-4",
+        tool_diameter: 4.0,
+        rpm: 0.0,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        probe_result: Some(post::probe_rec::ProbeResult { set_wcs, tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    cnc::serialize(&post::dump(&t, &d))
+}
+
+fn tormach(p: &ProbeParams, set_wcs: Option<u8>) -> String {
+    let m = machine::mirror(&parse_mch(MX770).expect("770MX parses"));
+    engine::run(TORMACH, &m, &stream(p, set_wcs)).expect("post").program
+}
+
+fn line_of(prog: &str, text: &str) -> usize {
+    prog.lines().position(|l| l == text).unwrap_or_else(|| panic!("no line {text:?}:\n{prog}"))
+}
+
+fn line_starting(prog: &str, prefix: &str) -> usize {
+    prog.lines().position(|l| l.starts_with(prefix)).unwrap_or_else(|| panic!("no line {prefix:?}..:\n{prog}"))
+}
+
+#[test]
+fn tormach_face_reports_z_after_its_tolerance_test_and_before_g10() {
+    let prog = tormach(&face(), Some(1));
+    let report = line_of(&prog, "(DEBUG, PROBE Z ERROR #190)");
+    assert_eq!(prog.matches("(DEBUG,").count(), 1, "one report per probed axis:\n{prog}");
+    assert!(report > line_of(&prog, "(MSG, PROBE Z OUT OF TOLERANCE)"), "after the tolerance test:\n{prog}");
+    assert!(prog.contains("o901 endif\n(DEBUG, PROBE Z ERROR #190)\nG10 L20 P2 Z[#5422-#190]\n"), "{prog}");
+}
+
+#[test]
+fn tormach_corner_reports_each_axis_before_g10() {
+    let prog = tormach(&corner(), Some(0));
+    let g10 = line_starting(&prog, "G10 L20 ");
+    let x = line_of(&prog, "(DEBUG, PROBE X ERROR #190)");
+    let y = line_of(&prog, "(DEBUG, PROBE Y ERROR #191)");
+    assert!(x > line_of(&prog, "(MSG, PROBE X OUT OF TOLERANCE)") && x < g10, "{prog}");
+    assert!(y > line_of(&prog, "(MSG, PROBE Y OUT OF TOLERANCE)") && y < g10, "{prog}");
+    assert_eq!(prog.matches("(DEBUG,").count(), 2, "{prog}");
+}
+
+#[test]
+fn tormach_measure_only_reports_before_its_stop() {
+    let prog = tormach(&face(), None);
+    assert!(!prog.contains("G10"), "nothing is set:\n{prog}");
+    assert!(prog.contains("(DEBUG, PROBE Z ERROR #190)\n(MSG, CHECK PROBE RESULT #190..)\nM0\n"), "{prog}");
+}
+
+#[test]
+fn fanuc_has_no_non_stopping_message_so_writes_no_report() {
+    let out = engine::run(FANUC, &serde_json::Value::Null, &stream(&corner(), Some(0))).expect("post");
+    let prog = out.program;
+    let g10 = line_starting(&prog, "G10 L2 ");
+    let y_test = line_starting(&prog, "IF[ABS[#191]GT");
+    assert_eq!(g10, y_test + 1, "the offset write follows the last tolerance test directly:\n{prog}");
+    assert!(!prog.contains("DEBUG") && !prog.contains("#3006"), "no report and no stop on a good probe:\n{prog}");
+}
diff --git a/docs/decisions/575-probe-report.md b/docs/decisions/575-probe-report.md
new file mode 100644
index 000000000..c6bd80830
--- /dev/null
+++ b/docs/decisions/575-probe-report.md
@@ -0,0 +1,20 @@
+## #575 - probe programs report the measured deviation on the control
+
+**Decided:** before a probe program writes the work offset, it shows each probed axis's measured deviation (found minus expected, the `#190..` value the offset write uses) through the dialect's own operator-message channel, and only when that channel does not stop the program. A dialect without such a channel writes nothing. A stop on every good probe is not a report.
+
+| Dialect | Report | Source |
+|---|---|---|
+| Tormach PathPilot / LinuxCNC | `(DEBUG, PROBE <axis> ERROR #19n)`, one line per axis, placed after that axis's `o<n> if` tolerance test and before `G10 L20`. In a measure-only op it goes before the `(MSG, CHECK PROBE RESULT ..)` / `M0` stop. | LinuxCNC G-code reference, "Messages" / "Comments": DEBUG is shown like MSG (in the status display, no stop), and each `#n` / `#<name>` in it is replaced by the parameter's value. |
+| Fanuc, Haas, Mazak (custom macro B, `fanuc.cps`) | none | The published custom macro B documentation offers only `#3000` (an alarm, which stops) and `#3006` (stop with a message). DPRNT/POPEN write to an external I/O device, not the screen. A comment in `fanuc.cps` next to `onProbeResult` records this. |
+| Sinumerik | none today, because `sinumerik.cps` has no probe hooks. When probing lands: `MSG("PROBE X ERROR "<<R190)`, cleared after the offset write with `MSG()`. | Siemens SINUMERIK programming manual (Fundamentals / Job planning): MSG shows a message without stopping, and `<<` joins a variable to the text. |
+| Heidenhain (ISO) | none today, because `heidenhain.cps` has no probe hooks. When probing lands: still none, unless the TNC user manual confirms that FN16 F-PRINT to `SCREEN:` shows its pop-up without halting the program. | TNC user manual (FN16 F-PRINT). Not confirmed non-stopping, so not adopted. |
+
+**Why:** the issue came from #521's run on a real 770MX. A successful probe changed G54 Z by 0.0007 in, and the offset table was the only trace of it. The operator should see what was measured before it is written. The report goes after the tolerance test, so the printed value is always one that passed the test and will be written. An out-of-tolerance value still stops with its MSG + M2.
+
+**Considered and dropped:**
+- Fanuc `#3006` on every probe: it stops the program each time, which is the opposite of a report.
+- A plain `( ... )` comment on Fanuc: the operator can't see it at run time.
+- A report before the tolerance test, so a failing value would be shown too: the issue places it after the test. Moving it would change the order of a single line in the post only.
+- Doing the report in `crates/motion` as a neutral record: each dialect owns its own message words, so it lives in the post scripts.
+
+**Cost to change later:** one line per dialect in its `onProbeResult`, plus the Tormach probe goldens. Pinned by `crates/app/tests/probe_report.rs`.

