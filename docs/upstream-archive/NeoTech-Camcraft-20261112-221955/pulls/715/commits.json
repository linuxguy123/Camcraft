  {
    "sha": "6129a9045e21ae5d2cb4d0faa8e06c6a70b0d7e7",
    "node_id": "C_kwDOVpkXAtoAKDYxMjlhOTA0NWUyMWFlNWQyY2I0ZDBmYWE4ZTA2YzZhNzBiMGQ3ZTc",
    "commit": {
      "author": {
        "name": "Ivica Safranko",
        "email": "safranko@msn.com",
