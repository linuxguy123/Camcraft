+++ b/crates/ui/src/viewport.rs
@@ -1366,7 +1366,7 @@ impl Camera {
     /// same `dist` (#434). `dist` is clamped >= 0.5 by `zoom`, so this
     /// never vanishes.
     #[must_use]
-    fn ortho_half_height(&self) -> f64 {
+    pub(crate) fn ortho_half_height(&self) -> f64 {
         self.dist * (std::f64::consts::FRAC_PI_6).tan()
     }
 }

From 4d9922b1e3efb4d00f988051abda8c5aa8ea9792 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mikekinney@Mikes-MacBook-Pro.local>
Date: Mon, 9 Nov 2026 17:17:25 -0800
Subject: [PATCH 2/2] fix(ui): vertex-pick visibility follows the parallel view
 direction in orthographic view

Vertex picking decided a corner's visibility on the segment from the
corner to the camera's eye point. In Orthographic mode the view rays are
parallel, so a corner hidden behind geometry along the view direction
could read as visible, and a visible one as hidden.

sight_origin starts the occlusion ray at the eye in perspective and, in
orthographic, at the corner's own point on the eye plane, so the test
runs back along -view direction exactly as Camera::ray_through casts a
pick; a corner at or behind the eye plane has nothing on screen to test
and is not offered. Perspective is unchanged.

Fixes #610

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAgjpiZbXSvmXLvdmL
---
 crates/ui/src/vertex_pick.rs       | 26 +++++++++++---
 crates/ui/src/vertex_pick_tests.rs | 55 ++++++++++++++++++++++++++++--
 2 files changed, 75 insertions(+), 6 deletions(-)

diff --git a/crates/ui/src/vertex_pick.rs b/crates/ui/src/vertex_pick.rs
index 3a367842d..259ae6a9f 100644
--- a/crates/ui/src/vertex_pick.rs
+++ b/crates/ui/src/vertex_pick.rs
@@ -5,7 +5,8 @@
 //!
 //! Provenance: standard screen-space point picking (project every
 //! candidate through the view-projection, nearest within a pixel radius,
-//! then an occlusion ray) - our own code from general graphics practice;
+//! then an occlusion ray - from the eye, or in orthographic back along
+//! the parallel view direction) - our own code from general graphics practice;
 //! no vendor material consulted.
 
 use camcraft_app::geometry::feature::{self, VertexId};
@@ -16,6 +17,7 @@ use camcraft_app::{model, pick};
 use crate::interact::{Mods, project_uv, queue_feature_pick};
 
 use crate::state::{CommandKind, HoverHit, State};
+use crate::viewport::{Camera, ProjectionMode};
 
 /// How close a corner must draw to the cursor to be pickable, logical px.
 pub(crate) const PICK_VERTEX_PX: f32 = 8.0;
@@ -53,6 +55,22 @@ pub fn nearest_vertex(
     near.into_iter().map(|(_, i)| i).find(|&i| visible(i))
 }
 
+/// Where the occlusion ray toward world point `q` starts: the eye in
+/// perspective; in orthographic (#610) `q`'s own point on the eye plane,
+/// so the ray runs back along the parallel view direction as
+/// `Camera::ray_through` casts it. `None` for a point at or behind the
+/// eye plane (nothing on screen to test) or degenerate math.
+pub(crate) fn sight_origin(cam: &Camera, q: [f64; 3]) -> Option<[f64; 3]> {
+    let eye = cam.eye();
+    if cam.projection == ProjectionMode::Perspective {
+        return Some(eye);
+    }
+    let (_, _, f) = cam.view_basis();
+    let depth = (q[0] - eye[0]) * f.0 + (q[1] - eye[1]) * f.1 + (q[2] - eye[2]) * f.2;
+    let o = [q[0] - f.0 * depth, q[1] - f.1 * depth, q[2] - f.2 * depth];
+    (depth.is_finite() && depth > 1e-9 && o.iter().all(|v| v.is_finite())).then_some(o)
+}
+
 /// Depth tolerance for the occlusion ray: the facets meeting AT a corner
 /// hit at its own distance; this absorbs their float noise.
 fn depth_tol(dist: f64) -> f64 {
@@ -69,7 +87,6 @@ pub(crate) fn vertex_nearest(state: &State, p: [f32; 2], radius: f32) -> Option<
         return None;
     }
     let mvp = state.cam.mvp(f64::from(w / h));
-    let eye = state.cam.eye();
     let hidden = |name: &str| state.hidden_in_view(name);
     let mut entities: Vec<(String, flecs_ecs::prelude::Entity)> =
         model::model_entities(&state.world).into_iter().filter(|(n, _)| !hidden(n)).collect();
@@ -101,8 +118,9 @@ pub(crate) fn vertex_nearest(state: &State, p: [f32; 2], radius: f32) -> Option<
     }
     let best = nearest_vertex(&pts, &mvp, state.viewport_rect, p, radius, |i| {
         let q = pts[i];
-        let dist = ((q[0] - eye[0]).powi(2) + (q[1] - eye[1]).powi(2) + (q[2] - eye[2]).powi(2)).sqrt();
-        pick::point_visible(&state.world, eye, q, depth_tol(dist), hidden)
+        let Some(o) = sight_origin(&state.cam, q) else { return false };
+        let dist = ((q[0] - o[0]).powi(2) + (q[1] - o[1]).powi(2) + (q[2] - o[2]).powi(2)).sqrt();
+        pick::point_visible(&state.world, o, q, depth_tol(dist), hidden)
     })?;
     let (k, id) = *tags.get(best)?;
     Some((entities.get(k)?.0.clone(), id))
diff --git a/crates/ui/src/vertex_pick_tests.rs b/crates/ui/src/vertex_pick_tests.rs
index 1596cae5a..2284ff083 100644
--- a/crates/ui/src/vertex_pick_tests.rs
+++ b/crates/ui/src/vertex_pick_tests.rs
@@ -7,8 +7,8 @@
 use camcraft_app::geometry::{Point3, cube};
 use camcraft_app::pick::sight_blocked;
 
-use crate::vertex_pick::nearest_vertex;
-use crate::viewport::Camera;
+use crate::vertex_pick::{nearest_vertex, sight_origin};
+use crate::viewport::{Camera, ProjectionMode};
 
 const RECT: ([f32; 2], [f32; 2]) = ([0.0, 0.0], [400.0, 400.0]);
 const CENTER: [f32; 2] = [200.0, 200.0];
@@ -74,3 +74,54 @@ fn degenerate_inputs_pick_nothing() {
     assert_eq!(nearest_vertex(&[[f64::NAN; 3]], &mvp, RECT, CENTER, 8.0, |_| true), None, "NaN vertex");
     assert_eq!(nearest_vertex(&[], &mvp, RECT, CENTER, 8.0, |_| true), None);
 }
+
+/// A 4 mm block centred at `c`: the occluder of the orthographic test.
+fn block(c: [f64; 3]) -> Vec<camcraft_app::geometry::Triangle> {
+    cube(Point3::new(c[0] - 2.0, c[1] - 2.0, c[2] - 2.0), Point3::new(c[0] + 2.0, c[1] + 2.0, c[2] + 2.0)).facets.to_vec()
+}
+
+#[test]
+fn orthographic_visibility_runs_along_the_view_direction_not_to_the_eye() {
+    // #610: two corners 30 mm off the view axis. A block sits on the
+    // first corner's parallel view ray (hidden in ortho) but off its
+    // line to the eye; another sits on the second corner's line to the
+    // eye but off its parallel ray (visible in ortho). The eye-point
+    // test reads both backwards; the parallel one reads them as the
+    // screen shows them. Perspective keeps the eye-point segment.
+    let mut cam = diagonal_cam();
+    cam.projection = ProjectionMode::Orthographic;
+    let (r, _, f) = cam.view_basis();
+    let eye = cam.eye();
+    let at = |base: [f64; 3], k: f64, d: [f64; 3]| [base[0] + k * d[0], base[1] + k * d[1], base[2] + k * d[2]];
+    let (r, f) = ([r.0, r.1, r.2], [f.0, f.1, f.2]);
+    let hidden_corner = at([0.0; 3], 30.0, r);
+    let shown_corner = at([0.0; 3], -30.0, r);
+    let mut tris = block(at(hidden_corner, -20.0, f)); // 20 mm up its view ray
+    let to_eye = [eye[0] - shown_corner[0], eye[1] - shown_corner[1], eye[2] - shown_corner[2]];
+    tris.extend(block(at(shown_corner, 0.2, to_eye))); // 20 mm up its eye line
+    let pts = [hidden_corner, shown_corner];
+    let ortho_visible = |i: usize| sight_origin(&cam, pts[i]).is_some_and(|o| !sight_blocked(&tris, o, pts[i], 1e-3));
+    assert!(!ortho_visible(0), "a corner behind a block along the view direction is hidden in ortho");
+    assert!(ortho_visible(1), "a corner with a clear parallel view ray is visible in ortho");
+    // The old eye-point law reads both the other way round - the bug.
+    assert!(!sight_blocked(&tris, eye, pts[0], 1e-3) && sight_blocked(&tris, eye, pts[1], 1e-3));
+
+    // Through the pick itself: the cursor on the hidden corner yields
+    // nothing; on the shown one, that corner.
+    let mvp = cam.mvp(1.0);
+    let px = |q: [f64; 3]| {
+        let uv = crate::interact::project_uv(&mvp, q).expect("on screen");
+        [uv[0] * 400.0, uv[1] * 400.0]
+    };
+    assert_eq!(nearest_vertex(&pts, &mvp, RECT, px(hidden_corner), 8.0, ortho_visible), None);
+    assert_eq!(nearest_vertex(&pts, &mvp, RECT, px(shown_corner), 8.0, ortho_visible), Some(1));
+
+    // Perspective: the occlusion ray still starts at the eye.
+    cam.projection = ProjectionMode::Perspective;
+    for q in pts {
+        assert_eq!(sight_origin(&cam, q), Some(cam.eye()));
+    }
+    // A point behind the ortho eye plane has nothing on screen to test.
+    cam.projection = ProjectionMode::Orthographic;
+    assert_eq!(sight_origin(&cam, at(eye, -1.0, f)), None);
+}
