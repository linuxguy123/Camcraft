diff --git a/crates/app/src/raster.rs b/crates/app/src/raster.rs
new file mode 100644
index 000000000..78cdb2100
--- /dev/null
+++ b/crates/app/src/raster.rs
@@ -0,0 +1,231 @@
+//! A CPU software rasteriser (#182): flat-shaded triangles through a
+//! depth buffer and plain line segments, under a fixed orthographic
+//! camera, into an RGB image and its PNG bytes - so a headless session
+//! (the MCP server, CI) can see the simulated stock with no GPU.
+//!
+//! Provenance: the textbook scanline-free triangle fill by edge
+//! functions over pixel centers (Pineda, "A Parallel Algorithm for
+//! Polygon Rasterization", SIGGRAPH 1988), a z-buffer (Catmull 1974),
+//! Lambert shading, and a DDA line walk; the PNG container through the
+//! `png` crate (W3C PNG specification). Our own code.
+//!
+//! ## The laws here
+//!
+//! - **Deterministic.** One thread, a fixed camera fitted to the scene's
+//!   own bounds, no clocks, no hashing order: the same scene is the same
+//!   bytes, every run, every machine with IEEE-754 doubles.
+//! - **Degenerate input is skipped, never a panic.** A non-finite vertex,
+//!   a zero-area projection, a segment off the canvas: drawn as nothing.
+//!   Every pixel index is bounds-checked; loops are capped by the canvas.
+
+use crate::geometry::Point3;
+
+/// The smallest and largest image edge accepted, in pixels.
+pub const MIN_EDGE: u32 = 16;
+pub const MAX_EDGE: u32 = 2048;
+
+/// Where the camera looks from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ViewDir {
+    /// From front-right-above (+X, -Y, +Z): the CAM isometric.
+    Iso,
+    /// Straight down the -Z axis, +X right, +Y up.
+    Top,
+}
+
+/// An orthographic camera fitted to a set of points.
+#[derive(Clone, Copy, Debug)]
+pub struct Camera {
+    right: Point3,
+    up: Point3,
+    /// Toward the viewer: larger depth is nearer.
+    toward: Point3,
+    light: Point3,
+    mid_x: f64,
+    mid_y: f64,
+    scale: f64,
+    width: u32,
+    height: u32,
+}
+
+fn unit(p: Point3) -> Point3 {
+    let n = p.dot(p).sqrt();
+    if n > 0.0 && n.is_finite() {
+        Point3::new(p.x / n, p.y / n, p.z / n)
+    } else {
+        Point3::new(0.0, 0.0, 1.0)
+    }
+}
+
+impl Camera {
+    /// Fit the view so every finite point of `pts` lands on a
+    /// `width` x `height` canvas with a 6 % margin. `None` when there is
+    /// no finite point to frame, or the size is outside the accepted edge.
+    #[must_use]
+    pub fn fit(dir: ViewDir, pts: impl Iterator<Item = Point3>, width: u32, height: u32) -> Option<Self> {
+        if !(MIN_EDGE..=MAX_EDGE).contains(&width) || !(MIN_EDGE..=MAX_EDGE).contains(&height) {
+            return None;
+        }
+        let (toward, right, up) = match dir {
+            ViewDir::Iso => {
+                let t = unit(Point3::new(1.0, -1.0, 1.0));
+                let r = unit(Point3::new(0.0, 0.0, 1.0).cross(t));
+                (t, r, t.cross(r))
+            }
+            ViewDir::Top => (Point3::new(0.0, 0.0, 1.0), Point3::new(1.0, 0.0, 0.0), Point3::new(0.0, 1.0, 0.0)),
+        };
+        let (mut x0, mut x1, mut y0, mut y1) = (f64::INFINITY, f64::NEG_INFINITY, f64::INFINITY, f64::NEG_INFINITY);
+        for p in pts.filter(|p| p.is_finite()) {
+            let (sx, sy) = (p.dot(right), p.dot(up));
+            x0 = x0.min(sx);
+            x1 = x1.max(sx);
+            y0 = y0.min(sy);
+            y1 = y1.max(sy);
+        }
+        if !(x0.is_finite() && x1.is_finite() && y0.is_finite() && y1.is_finite()) {
+            return None;
+        }
+        let (w, h) = (f64::from(width), f64::from(height));
+        let span_x = (x1 - x0).max(1e-9);
+        let span_y = (y1 - y0).max(1e-9);
+        let scale = ((w * 0.88) / span_x).min((h * 0.88) / span_y);
+        if !(scale.is_finite() && scale > 0.0) {
+            return None;
+        }
+        // A key light from above-left of the viewer, fixed per view.
+        let light = unit(Point3::new(
+            toward.x * 0.6 - right.x * 0.35 + up.x * 0.5,
+            toward.y * 0.6 - right.y * 0.35 + up.y * 0.5,
+            toward.z * 0.6 - right.z * 0.35 + up.z * 0.5,
+        ));
+        Some(Self { right, up, toward, light, mid_x: (x0 + x1) * 0.5, mid_y: (y0 + y1) * 0.5, scale, width, height })
+    }
+
+    /// Screen x, screen y (pixels, y down) and depth of a world point.
+    fn project(&self, p: Point3) -> (f64, f64, f64) {
+        let sx = f64::from(self.width) * 0.5 + (p.dot(self.right) - self.mid_x) * self.scale;
+        let sy = f64::from(self.height) * 0.5 - (p.dot(self.up) - self.mid_y) * self.scale;
+        (sx, sy, p.dot(self.toward))
+    }
+}
+
+/// An RGB image with a depth buffer.
+pub struct Canvas {
+    cam: Camera,
+    rgb: Vec<u8>,
+    depth: Vec<f64>,
+}
+
+impl Canvas {
+    /// A canvas of the camera's size, filled with `background`.
+    #[must_use]
+    pub fn new(cam: Camera, background: [u8; 3]) -> Self {
+        let n = (cam.width as usize).saturating_mul(cam.height as usize);
+        let mut rgb = Vec::with_capacity(n.saturating_mul(3));
+        for _ in 0..n {
+            rgb.extend_from_slice(&background);
+        }
+        Self { cam, rgb, depth: vec![f64::NEG_INFINITY; n] }
+    }
+
+    fn put(&mut self, x: i64, y: i64, z: f64, c: [u8; 3], test: bool) {
+        let (w, h) = (i64::from(self.cam.width), i64::from(self.cam.height));
+        if x < 0 || y < 0 || x >= w || y >= h {
+            return;
+        }
+        let Ok(k) = usize::try_from(y * w + x) else { return };
+        let Some(d) = self.depth.get_mut(k) else { return };
+        if test {
+            if z <= *d {
+                return;
+            }
+            *d = z;
+        }
+        if let Some(px) = self.rgb.get_mut(k * 3..k * 3 + 3) {
+            px.copy_from_slice(&c);
+        }
+    }
+
+    /// Fill one triangle, flat-shaded: `base` lit by the camera's fixed
+    /// light through the facet normal (two-sided - a sheet's walls face
+    /// either way).
+    pub fn triangle(&mut self, a: Point3, b: Point3, c: Point3, base: [u8; 3]) {
+        if !(a.is_finite() && b.is_finite() && c.is_finite()) {
+            return;
+        }
+        let n = unit((b - a).cross(c - a));
+        let lit = 0.3 + 0.7 * n.dot(self.cam.light).abs();
+        let shade = |v: u8| -> u8 { (f64::from(v) * lit).round().clamp(0.0, 255.0) as u8 };
+        let col = [shade(base[0]), shade(base[1]), shade(base[2])];
+        let (p0, p1, p2) = (self.cam.project(a), self.cam.project(b), self.cam.project(c));
+        let area = (p1.0 - p0.0) * (p2.1 - p0.1) - (p1.1 - p0.1) * (p2.0 - p0.0);
+        if !area.is_finite() || area.abs() < 1e-12 {
+            return;
+        }
+        let (w, h) = (f64::from(self.cam.width), f64::from(self.cam.height));
+        let x_lo = p0.0.min(p1.0).min(p2.0).floor().clamp(0.0, w) as i64;
+        let x_hi = p0.0.max(p1.0).max(p2.0).ceil().clamp(0.0, w) as i64;
+        let y_lo = p0.1.min(p1.1).min(p2.1).floor().clamp(0.0, h) as i64;
+        let y_hi = p0.1.max(p1.1).max(p2.1).ceil().clamp(0.0, h) as i64;
+        let edge = |p: (f64, f64, f64), q: (f64, f64, f64), x: f64, y: f64| (q.0 - p.0) * (y - p.1) - (q.1 - p.1) * (x - p.0);
+        for y in y_lo..y_hi {
+            let py = y as f64 + 0.5;
+            for x in x_lo..x_hi {
+                let px = x as f64 + 0.5;
+                let w0 = edge(p1, p2, px, py) / area;
+                let w1 = edge(p2, p0, px, py) / area;
+                let w2 = edge(p0, p1, px, py) / area;
+                if w0 < 0.0 || w1 < 0.0 || w2 < 0.0 {
+                    continue;
+                }
+                let z = w0 * p0.2 + w1 * p1.2 + w2 * p2.2;
+                self.put(x, y, z, col, true);
+            }
+        }
+    }
+
+    /// A one-pixel segment drawn over everything (no depth test): an
+    /// overlay the eye must never lose behind the stock.
+    pub fn overlay_line(&mut self, a: Point3, b: Point3, c: [u8; 3]) {
+        if !(a.is_finite() && b.is_finite()) {
+            return;
+        }
+        let (p, q) = (self.cam.project(a), self.cam.project(b));
+        let (dx, dy) = (q.0 - p.0, q.1 - p.1);
+        // Capped at the canvas diagonal's worth of steps: a segment that
+        // runs far off-canvas is walked no longer than one that fits.
+        let cap = 2.0 * f64::from(self.cam.width + self.cam.height);
+        let steps = dx.abs().max(dy.abs()).ceil().clamp(1.0, cap);
+        let n = steps as i64;
+        for i in 0..=n {
+            let t = i as f64 / steps;
+            let (x, y) = (p.0 + dx * t, p.1 + dy * t);
+            self.put(x.floor() as i64, y.floor() as i64, 0.0, c, false);
+        }
+    }
+
+    /// The image's RGB bytes, row-major from the top-left.
+    #[must_use]
+    pub fn rgb(&self) -> &[u8] {
+        &self.rgb
+    }
+
+    /// Pixels whose depth was written by a triangle.
+    #[must_use]
+    pub fn covered(&self) -> usize {
+        self.depth.iter().filter(|d| d.is_finite()).count()
+    }
+
+    /// The image as PNG bytes (8-bit RGB, default compression - the
+    /// encoder is deterministic for the same input).
+    pub fn png(&self) -> Result<Vec<u8>, String> {
+        let mut out = Vec::new();
+        let mut enc = png::Encoder::new(&mut out, self.cam.width, self.cam.height);
+        enc.set_color(png::ColorType::Rgb);
+        enc.set_depth(png::BitDepth::Eight);
+        let mut wr = enc.write_header().map_err(|e| format!("png header: {e}"))?;
+        wr.write_image_data(&self.rgb).map_err(|e| format!("png data: {e}"))?;
+        wr.finish().map_err(|e| format!("png finish: {e}"))?;
+        Ok(out)
+    }
+}
diff --git a/crates/app/tests/mcp_render.rs b/crates/app/tests/mcp_render.rs
new file mode 100644
index 000000000..ba4cbe77d
--- /dev/null
+++ b/crates/app/tests/mcp_render.rs
@@ -0,0 +1,201 @@
+//! The MCP stock render (#182), driven in-process over the JSON-RPC
+//! handler: a generated job renders to a PNG image block that decodes,
+//! has the asked size, shows stock, and is byte-identical run to run;
+//! the summary carries rest volume and bounds; and every refusal (no
+//! program, no stock, bad arguments) is a named tool error.
+//!
+//! Gate map (M4.4): covers app::mcp::render, app::raster.
+
+use camcraft_app::mcp::Server;
+
+use serde_json::{json, Value};
+use std::path::{Path, PathBuf};
+
+fn tmp_dir(tag: &str) -> PathBuf {
+    let mut p = std::env::temp_dir();
+    p.push(format!("camcraft-mcp-render-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&p);
+    std::fs::create_dir_all(&p).expect("temp dir");
+    p
+}
+
+/// A 40 x 40 x 15 box as ASCII STL, z from 0, wound outward.
+fn write_box_stl(path: &Path) {
+    let (x, y, z) = (20.0f64, 20.0f64, 15.0f64);
+    let v = |i: usize| -> [f64; 3] {
+        [if i & 1 == 0 { -x } else { x }, if i & 2 == 0 { -y } else { y }, if i & 4 == 0 { 0.0 } else { z }]
+    };
+    let quads = [[0, 2, 3, 1], [4, 5, 7, 6], [0, 1, 5, 4], [2, 6, 7, 3], [0, 4, 6, 2], [1, 3, 7, 5]];
+    let mut s = String::from("solid box\n");
+    for q in quads {
+        for tri in [[q[0], q[1], q[2]], [q[0], q[2], q[3]]] {
+            s.push_str(" facet normal 0 0 0\n  outer loop\n");
+            for i in tri {
+                let p = v(i);
+                s.push_str(&format!("   vertex {} {} {}\n", p[0], p[1], p[2]));
+            }
+            s.push_str("  endloop\n endfacet\n");
+        }
+    }
+    s.push_str("endsolid box\n");
+    std::fs::write(path, s).expect("write stl");
+}
+
+/// One tools/call: the whole `result` object.
+fn call(server: &mut Server, name: &str, args: Value) -> Value {
+    let msg = json!({ "jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": { "name": name, "arguments": args } });
+    let reply = server.handle(&msg).expect("a request gets a response");
+    reply["result"].clone()
+}
+
+fn ok(server: &mut Server, name: &str, args: Value) -> Value {
+    let r = call(server, name, args);
+    assert_eq!(r["isError"], json!(false), "{name} refused: {r}");
+    r
+}
+
+fn refused(server: &mut Server, name: &str, args: Value) -> String {
+    let r = call(server, name, args);
+    assert_eq!(r["isError"], json!(true), "{name} should have refused: {r}");
+    r["content"][0]["text"].as_str().unwrap_or_default().to_owned()
+}
+
+fn b64_decode(s: &str) -> Vec<u8> {
+    let val = |c: u8| -> u32 {
+        match c {
+            b'A'..=b'Z' => u32::from(c - b'A'),
+            b'a'..=b'z' => u32::from(c - b'a') + 26,
+            b'0'..=b'9' => u32::from(c - b'0') + 52,
+            b'+' => 62,
+            b'/' => 63,
+            _ => panic!("not base64: {c}"),
+        }
+    };
+    let bytes = s.as_bytes();
+    assert_eq!(bytes.len() % 4, 0, "padded base64");
+    let mut out = Vec::new();
+    for q in bytes.chunks(4) {
+        let pad = q.iter().filter(|c| **c == b'=').count();
+        let n = q.iter().take(4 - pad).enumerate().fold(0u32, |n, (i, c)| n | (val(*c) << (18 - 6 * i)));
+        out.push((n >> 16) as u8);
+        if pad < 2 {
+            out.push((n >> 8) as u8);
+        }
+        if pad < 1 {
+            out.push(n as u8);
+        }
+    }
+    out
+}
+
+/// The image block of a render result, decoded: (width, height, RGB).
+fn decode(result: &Value) -> (u32, u32, Vec<u8>, String) {
+    let content = result["content"].as_array().expect("content array");
+    assert_eq!(content[0]["type"], json!("text"));
+    let img = content.iter().find(|c| c["type"] == json!("image")).expect("an image block");
+    assert_eq!(img["mimeType"], json!("image/png"));
+    let data = img["data"].as_str().expect("base64 data").to_owned();
+    let png = b64_decode(&data);
+    let dec = png::Decoder::new(std::io::Cursor::new(png));
+    let mut reader = dec.read_info().expect("a PNG");
+    let mut buf = vec![0u8; reader.output_buffer_size().expect("buffer size")];
+    let info = reader.next_frame(&mut buf).expect("one frame");
+    assert_eq!(info.color_type, png::ColorType::Rgb);
+    buf.truncate(info.buffer_size());
+    (info.width, info.height, buf, data)
+}
+
+fn faced_job(dir: &Path) -> Server {
+    let stl = dir.join("block.stl");
+    write_box_stl(&stl);
+    let mut s = Server::new();
+    ok(&mut s, "import_model", json!({ "path": stl.display().to_string() }));
+    ok(&mut s, "set_stock", json!({ "box": { "dx": 60.0, "dy": 60.0, "dz": 20.0 } }));
+    ok(&mut s, "add_tool", json!({ "catalog": "EM-0400-2FL" }));
+    ok(&mut s, "add_operation", json!({ "kind": "Face", "tool": "EM-0400-2FL" }));
+    ok(&mut s, "generate", json!({}));
+    s
+}
+
+#[test]
+fn render_stock_is_a_deterministic_png_of_the_stock() {
+    let dir = tmp_dir("png");
+    let mut s = faced_job(&dir);
+    let r = ok(&mut s, "render_stock", json!({ "width": 320, "height": 240 }));
+    let (w, h, rgb, data) = decode(&r);
+    assert_eq!((w, h), (320, 240));
+    assert_eq!(rgb.len(), 320 * 240 * 3);
+    let bg = [236u8, 238, 241];
+    let stock = rgb.chunks(3).filter(|p| *p != bg).count();
+    assert!(stock > 320 * 240 / 10, "the stock covers the frame: {stock} pixels");
+
+    // The JSON copies never carry the picture; the summary does carry
+    // the numbers.
+    let sc = &r["structuredContent"];
+    assert!(sc.get("_png_base64").is_none(), "{sc}");
+    assert!(sc["rest"]["volume"].as_f64().is_some_and(|v| v >= 0.0), "{sc}");
+    // The faced block: 60 x 60 x 20 stock over a 40 x 40 x 15 part, the
+    // face pass at the stock top - 40 x 40 x 5 of rest stands.
+    assert_eq!(sc["stock_bounds"], json!({ "min": [-30.0, -30.0, 0.0], "max": [30.0, 30.0, 20.0] }), "{sc}");
+    assert!(sc["rest"]["volume"].as_f64().is_some_and(|v| (v - 8000.0).abs() < 1.0), "{sc}");
+    assert!(sc["rest"]["top_bounds"]["max"].is_array(), "{sc}");
+    assert!(sc["image"]["stock_pixels"].as_u64().is_some_and(|n| n > 0), "{sc}");
+    assert!(sc["judged_cells"].as_u64().is_some_and(|n| n > 0), "{sc}");
+
+    // Same document, same bytes - and a second server over the same job
+    // agrees too.
+    let again = ok(&mut s, "render_stock", json!({ "width": 320, "height": 240 }));
+    assert_eq!(decode(&again).3, data, "the render is deterministic");
+    let dir2 = tmp_dir("png2");
+    let mut s2 = faced_job(&dir2);
+    let other = ok(&mut s2, "render_stock", json!({ "width": 320, "height": 240 }));
+    assert_eq!(decode(&other).3, data, "a fresh session renders the same bytes");
+
+    // The top view and the toolpath overlay: the feed moves paint blue.
+    let top = ok(&mut s, "render_stock", json!({ "width": 200, "height": 200, "view": "top", "toolpath": true }));
+    let (tw, th, trgb, tdata) = decode(&top);
+    assert_eq!((tw, th), (200, 200));
+    assert_ne!(tdata, data);
+    assert!(trgb.chunks(3).any(|p| p == [20, 110, 230]), "feed moves are drawn");
+    let _ = std::fs::remove_dir_all(&dir);
+    let _ = std::fs::remove_dir_all(&dir2);
+}
+
+#[test]
+fn render_stock_refuses_by_name() {
+    let mut s = Server::new();
+    // No stock, no program.
+    let msg = refused(&mut s, "render_stock", json!({}));
+    assert!(msg.starts_with("render_stock: no stock simulation to render"), "{msg}");
+
+    // A stock and an operation that never generated.
+    ok(&mut s, "set_stock", json!({ "box": { "dx": 50.0, "dy": 50.0, "dz": 10.0 } }));
+    ok(&mut s, "add_tool", json!({ "catalog": "EM-0400-2FL" }));
+    ok(&mut s, "add_operation", json!({ "kind": "Face", "tool": "EM-0400-2FL" }));
+    let msg = refused(&mut s, "render_stock", json!({}));
+    assert!(msg.starts_with("render_stock: no stock simulation to render"), "{msg}");
+
+    // Arguments out of range or of the wrong type.
+    for bad in [
+        json!({ "width": 5 }),
+        json!({ "height": 100000 }),
+        json!({ "width": 64.5 }),
+        json!({ "width": "big" }),
+        json!({ "view": "side" }),
+        json!({ "toolpath": "yes" }),
+        json!({ "zoom": 2 }),
+    ] {
+        let msg = refused(&mut s, "render_stock", bad.clone());
+        assert!(msg.starts_with("render_stock:"), "{bad}: {msg}");
+    }
+}
+
+#[test]
+fn render_stock_is_listed() {
+    let mut s = Server::new();
+    let list = s.handle(&json!({ "jsonrpc": "2.0", "id": 1, "method": "tools/list" })).expect("answer");
+    let tools = list["result"]["tools"].as_array().expect("tools");
+    let t = tools.iter().find(|t| t["name"] == json!("render_stock")).expect("render_stock listed");
+    assert_eq!(t["inputSchema"]["type"], json!("object"));
+    assert!(t["inputSchema"]["properties"]["view"].is_object());
+}
diff --git a/docs/decisions/182-mcp-sim-render.md b/docs/decisions/182-mcp-sim-render.md
