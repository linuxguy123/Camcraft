diff --git a/crates/app/src/setup_stock_view.rs b/crates/app/src/setup_stock_view.rs
new file mode 100644
index 000000000..268d9d786
--- /dev/null
+++ b/crates/app/src/setup_stock_view.rs
@@ -0,0 +1,75 @@
+//! The incoming stock of a setup as the viewport draws it (#406): the
+//! body the setups before it leave (`stock_sim::incoming_body`), its
+//! sheet as triangles in the viewport's (active setup's) frame, and its
+//! box and volume - one program sim for both.
+//!
+//! Provenance: our own design over #317's carry and #320's stock source;
+//! showing the stock a later setup starts from is a plain CAM workflow
+//! (behaviour only). No vendor implementation inspected.
+//!
+//! ## The laws here
+//!
+//! - **Measured once, by the caller's cache.** One call runs the program
+//!   sim; the UI keys the answer by document version and never asks per
+//!   frame.
+//! - **The viewport's frame.** The body stands in the frame of the setup
+//!   that receives it (its part alignment); the viewport draws in the
+//!   ACTIVE setup's frame ([`crate::setup_align::view_pose`]), so the
+//!   sheet is carried by `A_active * A_setup^-1` - identity when the two
+//!   are the same setup or neither is aligned.
+//! - **Nothing to draw is a refusal, not an empty mesh.** A body with no
+//!   material, or one whose sheet holds no facet, is named.
+
+use flecs_ecs::prelude::World;
+
+use crate::geometry::{Point3, Triangle, transform_point};
+use crate::schema::Location;
+use crate::setup_align;
+use crate::setup_stock::Incoming;
+
+/// What a setup starts from, for the eye: the measured box and volume
+/// (in the setup's own frame, as the page and the sheet print them) and
+/// the body's sheet as triangle soup in the viewport's frame.
+#[derive(Debug, Clone)]
+pub struct IncomingShape {
+    pub incoming: Incoming,
+    pub mesh: Vec<Triangle>,
+}
+
+/// The rigid map from `setup`'s frame into the frame the viewport draws
+/// in (the active setup's).
+#[must_use]
+pub fn to_view(world: &World, setup: &str) -> Location {
+    let from = setup_align::alignment(world, Some(setup)).unwrap_or_default();
+    let view = setup_align::alignment(world, crate::setup::active(world).as_deref()).unwrap_or_default();
+    setup_align::compose(view, setup_align::inverse(from))
+}
+
+/// The incoming stock of `setup`, measured and meshed.
+///
+/// # Errors
+/// Every refusal of the program sim (`stock_sim::incoming_body`), a
+/// body with no material left, and a sheet with no facet to draw.
+pub fn incoming_shape(world: &World, setup: &str) -> Result<IncomingShape, String> {
+    let body = crate::stock_sim::incoming_body(world, setup)?;
+    let (lo, hi) = body.bounds().ok_or_else(|| format!("no material reaches setup '{setup}'"))?;
+    let incoming = Incoming { min: [lo.x, lo.y, lo.z], max: [hi.x, hi.y, hi.z], volume: body.volume() };
+    let sheet = body.display().surface(&[]);
+    let map = to_view(world, setup);
+    let at = |i: u32| -> Option<Point3> {
+        let p = *sheet.verts.get(usize::try_from(i).ok()?)?;
+        Some(transform_point(p, map.pos, map.rot))
+    };
+    let mut mesh = Vec::with_capacity(sheet.tris.len());
+    for t in &sheet.tris {
+        // An index outside the vertex list is a sheet bug: skip the facet
+        // rather than draw a wrong one (never a panic on a display path).
+        if let (Some(a), Some(b), Some(c)) = (at(t[0]), at(t[1]), at(t[2])) {
+            mesh.push(Triangle::new(a, b, c));
+        }
+    }
+    if mesh.is_empty() {
+        return Err(format!("the stock reaching setup '{setup}' has no surface to draw"));
+    }
+    Ok(IncomingShape { incoming, mesh })
+}
diff --git a/crates/app/tests/setup_stock_view.rs b/crates/app/tests/setup_stock_view.rs
new file mode 100644
index 000000000..395152acf
--- /dev/null
+++ b/crates/app/tests/setup_stock_view.rs
@@ -0,0 +1,109 @@
+//! #406: the incoming stock's sheet for the viewport. One measurement
+//! answers the page's box and volume and the sheet; the sheet stands in
+//! the ACTIVE setup's frame - as measured when the receiving setup is the
+//! active one, carried back by its alignment when another setup is - and
+//! a setup that receives nothing is named, never an empty mesh.
+//! Provenance: our own fixtures (a faced block, flipped over X); no
+//! vendor material consulted.
+//!
+//! Gate map (#406): covers app::setup_stock_view.
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    ActivateSetup, AddTool, AlignPartToSetup, CreateOperation, CreateSetup, GenerateOperation, History, ImportModel,
+    SetStock,
+};
+use camcraft_app::geometry::{Point3, cube, transform_point};
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::setup_align::{AlignPreset, is_identity_rot};
+use camcraft_app::setup_stock;
+use camcraft_app::setup_stock_view::{incoming_shape, to_view};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+
+const TOOL: &str = "EM-0400-2FL";
+
+fn face(cut_z: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(30.0),
+        cut_z: Height::fixed(cut_z),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+fn add_face(world: &World, h: &mut History, name: &str, cut: f64) {
+    let op = CreateOperation::new(world, name, TOOL, SrcRef::Stock, face(cut)).expect("create");
+    h.execute(world, op);
+    h.execute(world, GenerateOperation::new(world, name).expect("generate"));
+}
+
+/// A 60 x 60 x 16 part in a stock Z -2..18, Setup1 faced to 16, Setup2
+/// flipped over X (so it takes what Setup1 leaves) and faced too.
+fn flipped() -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::new(-30.0, -30.0, 0.0), Point3::new(30.0, 30.0, 16.0))));
+    let at = Location { pos: Point3::new(0.0, 0.0, -2.0), ..Default::default() };
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, at).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("tool");
+    h.execute(&world, AddTool::new(&world, TOOL, tool).expect("add tool"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("Setup1"));
+    add_face(&world, &mut h, "Face1", 16.0);
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup1")).expect("Setup2"));
+    h.execute(&world, AlignPartToSetup::preset(&world, "Setup2", AlignPreset::FlipX).expect("flip"));
+    add_face(&world, &mut h, "Face2", 16.0);
+    (world, h)
+}
+
+#[test]
+fn the_sheet_stands_in_the_active_setups_frame() {
+    let (world, mut h) = flipped();
+    h.execute(&world, ActivateSetup::new(&world, Some("Setup2")).expect("activate Setup2"));
+    let own = incoming_shape(&world, "Setup2").expect("Setup2 receives Setup1's body");
+    assert_eq!(Ok(own.incoming.clone()), setup_stock::incoming(&world, "Setup2"), "the page's box and volume, one law");
+    let t = to_view(&world, "Setup2");
+    assert!(is_identity_rot(t.rot) && t.pos == Point3::ZERO, "its own frame is the view's: {t:?}");
+    let top = own.mesh.iter().flat_map(|t| [t.a.z, t.b.z, t.c.z]).fold(f64::MIN, f64::max);
+    assert!((top - own.incoming.max[2]).abs() < 1e-9, "the sheet's top is the body's: {top} vs {:?}", own.incoming);
+
+    h.execute(&world, ActivateSetup::new(&world, Some("Setup1")).expect("activate Setup1"));
+    let back = incoming_shape(&world, "Setup2").expect("still measured");
+    assert_eq!(back.incoming, own.incoming, "the box stays in the receiving setup's frame");
+    let t = to_view(&world, "Setup2");
+    assert!(!is_identity_rot(t.rot), "Setup1 holds the part unflipped: the sheet is carried back");
+    assert_eq!(back.mesh.len(), own.mesh.len());
+    for (a, b) in own.mesh.iter().zip(&back.mesh) {
+        for (p, q) in [(a.a, b.a), (a.b, b.b), (a.c, b.c)] {
+            let m = transform_point(p, t.pos, t.rot);
+            assert!((m.x - q.x).abs() < 1e-9 && (m.y - q.y).abs() < 1e-9 && (m.z - q.z).abs() < 1e-9, "{m:?} vs {q:?}");
+        }
+    }
+    // Setup2's top is the block's uncut underside: seen as Setup1 holds
+    // the part, it lies back at the bottom of the stock, Z -2.
+    let zs: Vec<f64> = back.mesh.iter().flat_map(|t| [t.a.z, t.b.z, t.c.z]).collect();
+    let (lo, hi) = zs.iter().fold((f64::MAX, f64::MIN), |(l, h), &z| (l.min(z), h.max(z)));
+    assert!((lo + 2.0).abs() < 1e-6 && (hi + 2.0).abs() < 1e-6, "the underside at Z -2, got {lo} .. {hi}");
+}
+
+#[test]
+fn the_first_setup_draws_its_own_block_and_an_unknown_setup_is_named() {
+    let (world, _h) = flipped();
+    // The program's first setup starts from its own stock: the sheet is
+    // its block's top, not a refusal.
+    let first = incoming_shape(&world, "Setup1").expect("its own block");
+    assert!((first.incoming.max[2] - 18.0).abs() < 1e-9, "{:?}", first.incoming);
+    let err = incoming_shape(&world, "NoSuchSetup").expect_err("no such setup");
+    assert!(!err.is_empty());
+}
diff --git a/crates/ui/src/egui_app/incoming_view_tests.rs b/crates/ui/src/egui_app/incoming_view_tests.rs
