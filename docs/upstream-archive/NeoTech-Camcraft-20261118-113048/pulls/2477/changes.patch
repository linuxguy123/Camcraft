diff --git a/crates/motion/src/machining3d/hsm.rs b/crates/motion/src/machining3d/hsm.rs
index 3b794ae5f..fc6f7038c 100644
--- a/crates/motion/src/machining3d/hsm.rs
+++ b/crates/motion/src/machining3d/hsm.rs
@@ -233,7 +233,7 @@ pub(super) fn plan_level(
     let r = p.tool_diameter * 0.5;
     let air_entry = seam.is_none()
         && stock.is_some_and(|s| passes.first().and_then(|w| w.first()).is_some_and(|&e| in_air(s, e, r)));
-    if air_entry {
