From 9ff4d7b3055fe57932d30826b4e2e2c054d72842 Mon Sep 17 00:00:00 2001
From: mkinney <2219838+mkinney@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:00:04 -0800
Subject: [PATCH] fix(examples): pin and refresh first-part NC programs

Regenerate the mill program and ship the router companion program.
Pin both against CLI processing of the shipped projects.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #2422
---
 crates/app/tests/first_part_programs.rs |  40 ++
 docs/decisions/2422-example-programs.md |  20 +
 examples/first-part.nc                  | 572 ++++++++++++++----------
 examples/first-router-part.nc           | 151 +++++++
 4 files changed, 541 insertions(+), 242 deletions(-)
 create mode 100644 crates/app/tests/first_part_programs.rs
 create mode 100644 docs/decisions/2422-example-programs.md
 create mode 100644 examples/first-router-part.nc

diff --git a/crates/app/tests/first_part_programs.rs b/crates/app/tests/first_part_programs.rs
new file mode 100644
index 000000000..4dc19cf84
--- /dev/null
+++ b/crates/app/tests/first_part_programs.rs
@@ -0,0 +1,40 @@
+//! Provenance: our own shipped examples, processed through our public CLI.
+//! Gate map: covers app::cli, app::project, app::posting, app::operation.
+//!
+//! Regenerate each program with `camcraft-cli process examples/<name>.camproj
+//! -o examples/<name>.nc` after reviewing an intentional output change.
+
+use std::path::Path;
+
+fn assert_example_program(name: &str) {
+    let repo = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let project = repo.join(format!("examples/{name}.camproj"));
+    let golden = repo.join(format!("examples/{name}.nc"));
+    let output = std::env::temp_dir().join(format!(
+        "camcraft-{name}-program-pin-{}.nc",
+        std::process::id()
+    ));
+    let _ = std::fs::remove_file(&output);
+    let status = camcraft_app::cli::run(&[
+        "process".into(),
+        project.display().to_string(),
+        "-o".into(),
+        output.display().to_string(),
+    ]);
+    assert_eq!(status, 0, "{name} must generate, post and verify");
+    let actual = std::fs::read_to_string(&output).expect("the CLI posted a program");
+    let expected = std::fs::read_to_string(&golden)
+        .unwrap_or_else(|e| panic!("{} must ship beside its project: {e}", golden.display()));
+    assert!(actual == expected, "{} is stale; compare {} and regenerate it", golden.display(), output.display());
+    std::fs::remove_file(output).expect("remove the generated program");
+}
+
+#[test]
+fn first_part_posts_the_shipped_program() {
+    assert_example_program("first-part");
+}
+
+#[test]
+fn first_router_part_posts_the_shipped_program() {
+    assert_example_program("first-router-part");
+}
diff --git a/docs/decisions/2422-example-programs.md b/docs/decisions/2422-example-programs.md
new file mode 100644
index 000000000..8ec5bb6ee
--- /dev/null
+++ b/docs/decisions/2422-example-programs.md
@@ -0,0 +1,20 @@
+## #2422 - Keep the shipped first-part programs current
+
+**Chosen:** Regenerate `examples/first-part.nc` from its shipped project and add
+`examples/first-router-part.nc` from its shipped project. Pin both programs with
+tests that run the public CLI's `process` lane, including load, generation,
+posting and verification, before comparing the complete program text.
+
+**Why:** The mill example kept its original program while posting evolved. The
+router example shipped no program. Users need programs that reproduce with the
+current application. Running generation also prevents old cached paths in a
+project from hiding a change.
+
+**Dropped:** Changing the post implementation would change working behavior to
+match a stale example. Copying the catalog's program would not prove that the
+guide's project generates it. Comparing selected lines would miss drift elsewhere
+in either program.
+
+**Cost to change later:** Regenerate and review the two programs after an
+intentional output change. The pinning tests document the CLI command and check
+the entire generated result. No product code or dependencies change.
