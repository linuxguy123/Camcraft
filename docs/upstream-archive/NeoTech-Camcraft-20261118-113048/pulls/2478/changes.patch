--- /dev/null
+++ b/crates/motion/src/finishing3d/raster_bridge.rs
@@ -0,0 +1,90 @@
+//! Same-line gap bridging for the Z-following raster (#2431): a hole the
+//! ball cannot enter is crossed by one straight feed, certified by the
+//! swept-sphere (segment-to-triangle distance) clearance law of the
+//! drop-cutter literature. Source: our own design notes.
+
+use crate::geo2d::Point2;
+use crate::geometry::{Point3, Triangle};
+use crate::stock_sim::dist_seg_tri;
+
+use super::params::SPLIT_MZ;
+use super::support::Sup;
+
+/// One marched piece: XY samples with their ball-center heights.
+pub(super) type Piece = Vec<(Point2, f64)>;
+
+/// Join the pieces of ONE raster line where the gap between them is a
+/// hole the ball cannot enter. The march breaks a line wherever no
+/// shallow facet answers under the center, and a hole narrower than
+/// the tool is such a stretch: the ball would rest on the rim, which
+/// no candidate of `support_at` answers, so the line hopped to the
+/// retract and plunged again on the far rim - a stop and a pick for
+/// every bolt hole (#2431). Here the two pieces become one run, the
+/// gap one straight feed, when all of these hold:
+///
+/// - the gap's XY span is at most the tool diameter (`2r`). A wider
+///   opening is one the ball fits into: its walls and floor are the
+///   model's own surface, and the land model (`fill_openings`) is the
+///   user's switch to fly over it. There the clean hop stays.
+/// - the feed climbs or falls no steeper than the shallow region's
+///   own slope (`SPLIT_MZ`, 45 degrees) plus `tol` - the march's
+///   discontinuity law, so a shelf edge still breaks;
+/// - the ball swept along the feed stays `r - chord` clear of every
+///   facet: the exact certifier `column_clear` uses, with the march's
+///   own chord budget as the only slack.
+///
+/// Anything else (non-finite input included) keeps the break.
+pub(super) fn bridge_line(pieces: Vec<Piece>, r: f64, tol: f64, chord: f64, sups: &[Sup]) -> Vec<Piece> {
+    let mut out: Vec<Piece> = Vec::with_capacity(pieces.len());
+    for pc in pieces {
+        let (Some(&(b, zb)), Some(prev)) = (pc.first(), out.last_mut()) else {
+            if !pc.is_empty() {
+                out.push(pc);
+            }
+            continue;
+        };
+        match prev.last() {
+            Some(&(a, za)) if bridge_ok((a, za), (b, zb), r, tol, chord, sups) => prev.extend(pc),
+            _ => out.push(pc),
+        }
+    }
+    out
+}
+
+/// The certificate for one straight feed between two ball centers
+/// (XY, center Z). See [`bridge_line`] for the three laws.
+pub(super) fn bridge_ok(
+    (a, za): (Point2, f64),
+    (b, zb): (Point2, f64),
+    r: f64,
+    tol: f64,
+    chord: f64,
+    sups: &[Sup],
+) -> bool {
+    let d = (b.x - a.x).hypot(b.y - a.y);
+    // NaN fails every compare below: refused, never a silent pass.
+    let span_ok = d <= 2.0 * r;
+    if !(span_ok && za.is_finite() && zb.is_finite()) {
+        return false;
+    }
+    let slope = (1.0 - SPLIT_MZ * SPLIT_MZ).max(0.0).sqrt() / SPLIT_MZ;
+    let climb_ok = (zb - za).abs() <= d * slope + tol;
+    if !climb_ok {
+        return false;
+    }
+    let limit = r - chord;
+    let (pa, pb) = (Point3::new(a.x, a.y, za), Point3::new(b.x, b.y, zb));
+    let (x0, x1) = (a.x.min(b.x), a.x.max(b.x));
+    let (y0, y1) = (a.y.min(b.y), a.y.max(b.y));
+    for s in sups {
+        if x1 < s.xmin || x0 > s.xmax || y1 < s.ymin || y0 > s.ymax {
+            continue; // outside the padded footprint: the swept ball cannot reach it
+        }
+        let t = Triangle::new(s.tri[0], s.tri[1], s.tri[2]);
+        let clear = dist_seg_tri(pa, pb, &t) >= limit;
+        if !clear {
+            return false;
+        }
+    }
+    true
+}
diff --git a/crates/motion/src/finishing3d/swarf.rs b/crates/motion/src/finishing3d/swarf.rs
new file mode 100644
index 000000000..01ba1e0d2
--- /dev/null
+++ b/crates/motion/src/finishing3d/swarf.rs
@@ -0,0 +1,121 @@
+//! The swarf raster family (M5.1 D), split from `raster.rs` (#2431) along
+//! the pattern seam; structure only. Source: our own design notes.
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geometry::{Point3, Triangle};
+use crate::machining2d::GenError;
+
+use super::ladder::levels;
+use super::params::{dirs, validate, Finish3DParams};
+use super::raster::{raster_pass, raster_pass_spaced, rings_and_tail_with_trim};
+use super::rings::emit_rings_with_trim;
+use super::support::build_sups;
+
+/// The swarf pattern (M5.1 D): the raster's whole machinery with the
+/// ruling's DIRECTION. Lines run along `(ux, uy)` - the dominant
+/// straight-line direction of a ruled (bladed) region, found by
+/// `crate::multiaxis::ruling` - stepping across it at the same
+/// cos-law promise; the steep flanks ride the rings, as they do for
+/// every raster family. Geometry is the parallel pattern's exactly:
+/// what swarf adds is that the pass direction is the surface's own,
+/// so a ball tangent to the flank touches along a ruling, and the
+/// orientation the 5-axis stamp writes is the tool lying WITH the
+/// blade instead of against it.
+pub fn swarf(
+    facets: &[Triangle],
+    p: &Finish3DParams,
+    ux: f64,
+    uy: f64,
+) -> Result<Toolpath, GenError> {
+    validate(p, facets)?;
+    let r = p.tool_diameter * 0.5;
+    let sups = build_sups(facets, r);
+    let (ux, uy) = norm_dir(ux, uy)?;
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    let emitted = raster_pass(&mut b, p, r, &sups, ux, uy, false)?;
+    // Swarf tilts off +Z in 5-axis stamping; keep under-equator rings intact.
+    rings_and_tail_with_trim(b, p, r, facets, emitted, false)
+}
+
+/// The tolerance-aware multi-pass swarf (advanced swarf, M5.1 D):
+/// the SAME path family run coarse-first. Pass i from the top is
+/// SPACED at `tol·4^i` - every scallop law in the kernel is tolerance-
+/// authored, so the rough pass lands at DOUBLE the step and DOUBLE
+/// the level stepdown, fourfold the cusp - while its gouge budget
+/// stays the nominal `tol` (M13.8); the finishing pass then
+/// rides the nominal ladder. Each pass's centers stand tangent to
+/// the MODEL (never to the previous pass), so the finishing pass's
+/// promise does not depend on the rough pass having helped: the
+/// pair is the shop's chip-thinning sequence, and a wrong pass
+/// count cannot hide a gouge. `passes` is clamped by the caller's
+/// sane door; here 0 and nonsense refuse by name.
+pub fn swarf_multi(
+    facets: &[Triangle],
+    p: &Finish3DParams,
+    ux: f64,
+    uy: f64,
+    passes: u32,
+) -> Result<Toolpath, GenError> {
+    validate(p, facets)?;
+    if passes == 0 || passes > 4 {
+        return Err(GenError::Invalid(format!(
+            "swarf multi-pass needs 1..4 passes, got {passes}"
+        )));
+    }
+    let r = p.tool_diameter * 0.5;
+    let sups = build_sups(facets, r);
+    let (ux, uy) = norm_dir(ux, uy)?;
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    let mut emitted = false;
+    // The gouge budget never relaxes (M13.8): the march, the ring
+    // chords and the convex scan run at the nominal tolerance on
+    // every rung, so no rung bites past it; only the SPACING - the
+    // raster's step and the ring ladder's stepdown, both scallop
+    // laws - is authored by the rung's `tol·4^i`. Relaxing the whole
+    // tolerance let the coarse rung's chords sink ~4·tol (0.39 mm at
+    // tol 0.1 on the capped blade), a conviction the finish rung,
+    // tangent to the model, can never cut back.
+    let ds = dirs(r, p.tolerance);
+    for i in (0..passes).rev() {
+        let mut q = *p;
+        let mut spacing = *p;
+        if i > 0 {
+            spacing.tolerance = p.tolerance * (4.0f64).powi(i as i32);
+            // An explicit stepover rides the same 2x-per-pass ladder
+            // (scallop grows with the square of the spacing).
+            q.stepover = p.stepover.map(|s| s * (2.0f64).powi(i as i32));
+        }
+        // #1015: a rung refuses with the rungs before it built.
+        let ghost = |e: GenError, b: &PathBuilder| e.with_ghost_moves(b.moves());
+        emitted |= raster_pass_spaced(&mut b, &q, r, &sups, (ux, uy), emitted, spacing.tolerance).map_err(|e| ghost(e, &b))?;
+        let zs = levels(&spacing, r, facets).map_err(|e| ghost(e, &b))?;
+        let mut last = Some(q.clearance_z);
+        emitted |= emit_rings_with_trim(&mut b, &q, facets, &zs, &ds, &mut last, false)
+            .map_err(|e| ghost(e, &b))?;
+    }
+    if !emitted {
+        return Err(GenError::Empty(
+            "no surface reaches within one ball radius of the requested depths".into(),
+        ));
+    }
+    let cur = b.at();
+    b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, p.clearance_z), None);
+    let path = b.finish();
+    if !path.all_finite() {
+        return Err(GenError::Invalid("path left the finite horizon".into()));
+    }
+    Ok(path)
+}
+
+/// The pass direction made honest: finite, non-zero, unit. A raster
+/// needs a direction to run in; a zero or NaN pair is a caller's
+/// bug, not an isotropic model, and the refusal says so.
+fn norm_dir(ux: f64, uy: f64) -> Result<(f64, f64), GenError> {
+    let l = (ux * ux + uy * uy).sqrt();
+    if !l.is_finite() || l <= 1e-12 {
+        return Err(GenError::Invalid(
+            "swarf needs a finite non-zero pass direction".into(),
+        ));
+    }
+    Ok((ux / l, uy / l))
+}
diff --git a/crates/motion/tests/finish3d_holes.rs b/crates/motion/tests/finish3d_holes.rs
new file mode 100644
index 000000000..3dc8f2a2d
--- /dev/null
+++ b/crates/motion/tests/finish3d_holes.rs
@@ -0,0 +1,272 @@
+//! #2431: the Parallel finish crosses a hole the ball cannot enter in
+//! one straight feed at the surface height - no retract, no plunge -
+//! and still verifies against the real model. A hole the ball fits
+//! into keeps its clean hop: its walls are model surface.
+//!
+//! Gate map (#2431): covers camcraft_motion::finishing3d (raster_bridge, raster).
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::finishing3d::{parallel, Finish3DParams, FinishPattern};
+use camcraft_motion::geometry::{Point3, Triangle};
+
+const R: f64 = 1.5; // a 3 mm ball
+const TOL: f64 = 0.05;
+const TOP: f64 = 8.0;
+
+fn p3(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn quad(out: &mut Vec<Triangle>, p: [Point3; 4]) {
+    out.push(Triangle::new(p[0], p[1], p[2]));
+    out.push(Triangle::new(p[0], p[2], p[3]));
+}
+
+/// A stepped block on an XY grid of cells: each cell stands to its
+/// height (`None` = through), with top, bottom and every wall where a
+/// neighbour (or the outside) stands lower.
+fn block(xs: &[f64], ys: &[f64], h: &dyn Fn(usize, usize) -> Option<f64>) -> Vec<Triangle> {
+    let (nx, ny) = (xs.len() - 1, ys.len() - 1);
+    let at = |i: isize, j: isize| {
+        if i < 0 || j < 0 || i >= nx as isize || j >= ny as isize {
+            None
+        } else {
+            h(i as usize, j as usize)
+        }
+    };
+    let mut f = Vec::new();
+    for j in 0..ny {
+        for i in 0..nx {
+            let Some(z) = h(i, j) else { continue };
+            let (x0, x1, y0, y1) = (xs[i], xs[i + 1], ys[j], ys[j + 1]);
+            quad(&mut f, [p3(x0, y0, z), p3(x1, y0, z), p3(x1, y1, z), p3(x0, y1, z)]);
+            quad(&mut f, [p3(x0, y0, 0.0), p3(x0, y1, 0.0), p3(x1, y1, 0.0), p3(x1, y0, 0.0)]);
+            let (ii, jj) = (i as isize, j as isize);
+            let sides = [
+                (at(ii - 1, jj), [p3(x0, y1, 0.0), p3(x0, y0, 0.0)]),
+                (at(ii + 1, jj), [p3(x1, y0, 0.0), p3(x1, y1, 0.0)]),
+                (at(ii, jj - 1), [p3(x0, y0, 0.0), p3(x1, y0, 0.0)]),
+                (at(ii, jj + 1), [p3(x1, y1, 0.0), p3(x0, y1, 0.0)]),
+            ];
+            for (n, [a, b]) in sides {
+                let lo = n.unwrap_or(0.0);
+                if lo < z {
+                    let (a0, b0) = (p3(a.x, a.y, lo), p3(b.x, b.y, lo));
+                    quad(&mut f, [a0, b0, p3(b.x, b.y, z), p3(a.x, a.y, z)]);
+                }
+            }
+        }
+    }
+    f
+}
+
+/// 40 x 20 x 8 plate, two square through holes of side `w` centred
+/// at (10, 10) and (30, 10).
+fn holed_plate(w: f64) -> Vec<Triangle> {
+    let h = 0.5 * w;
+    let xs = [0.0, 10.0 - h, 10.0 + h, 30.0 - h, 30.0 + h, 40.0];
+    let ys = [0.0, 10.0 - h, 10.0 + h, 20.0];
+    block(&xs, &ys, &|i, j| (!(j == 1 && (i == 1 || i == 3))).then_some(TOP))
+}
+
+/// A 2 mm through slot across the plate's full depth at x 19..21:
+/// open to both edges, two bodies.
+fn slotted_plate() -> Vec<Triangle> {
+    let xs = [0.0, 19.0, 21.0, 40.0];
+    let ys = [0.0, 20.0];
+    block(&xs, &ys, &|i, _| (i != 1).then_some(TOP))
+}
+
+/// A lid edge a hair off the rim: the right half stands `dz` lower.
+fn stepped_plate(dz: f64) -> Vec<Triangle> {
+    let xs = [0.0, 20.0, 40.0];
+    let ys = [0.0, 20.0];
+    block(&xs, &ys, &|i, _| Some(if i == 1 { TOP - dz } else { TOP }))
+}
+
+fn fp() -> Finish3DParams {
+    Finish3DParams {
+        pattern: FinishPattern::Parallel,
+        stepover: None,
+        tool_diameter: 2.0 * R,
+        tolerance: TOL,
+        clearance_z: 20.0,
+        retract_z: None,
+        top_z: TOP,
+        bottom_z: 0.0,
+        feed: 500.0,
+        plunge_feed: 100.0,
+        climb: true,
+        ramp: false,
+        min_step: None,
+        ramp_angle: 45.0,
+        entry_ramp: false,
+        steep_stepover: None,
+        pencil_reference: None,
+    }
+}
+
+/// Ericson's closest point on a triangle, distance only.
+fn pt_tri(p: Point3, t: &Triangle) -> f64 {
+    let (ab, ac, ap) = (t.b - t.a, t.c - t.a, p - t.a);
+    let (d1, d2) = (ab.dot(ap), ac.dot(ap));
+    let n = |u: Point3| u.dot(u).sqrt();
+    let ax = |o: Point3, u: Point3, s: f64| p3(o.x + u.x * s, o.y + u.y * s, o.z + u.z * s);
+    if d1 <= 0.0 && d2 <= 0.0 {
+        return n(ap);
+    }
+    let bp = p - t.b;
+    let (d3, d4) = (ab.dot(bp), ac.dot(bp));
+    if d3 >= 0.0 && d4 <= d3 {
+        return n(bp);
+    }
+    let vc = d1 * d4 - d3 * d2;
+    if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
+        return n(p - ax(t.a, ab, d1 / (d1 - d3)));
+    }
+    let cp = p - t.c;
+    let (d5, d6) = (ab.dot(cp), ac.dot(cp));
+    if d6 >= 0.0 && d5 <= d6 {
+        return n(cp);
+    }
+    let vb = d5 * d2 - d1 * d6;
+    if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 {
+        return n(p - ax(t.a, ac, d2 / (d2 - d6)));
+    }
+    let va = d3 * d6 - d5 * d4;
+    if va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0 {
+        return n(p - ax(t.b, t.c - t.b, (d4 - d3) / ((d4 - d3) + (d5 - d6))));
+    }
+    let den = 1.0 / (va + vb + vc);
+    n(p - ax(ax(t.a, ab, vb * den), ac, vc * den))
+}
+
+/// The deepest bite of the ball into `model` along every straight
+/// feed, sampled at 0.05 mm - a bridge is judged along its length, not
+/// only at its ends.
+fn deepest_bite(t: &Toolpath, model: &[Triangle]) -> f64 {
+    let mut worst = f64::NEG_INFINITY;
+    for m in t.moves.iter().filter(|m| matches!(m.kind, MoveKind::Feed)) {
+        let len = (m.to - m.from).dot(m.to - m.from).sqrt();
+        // An arc is judged at its ends only: its chord is not the path.
+        let n = if m.arc.is_some() { 1 } else { ((len / 0.05).ceil() as usize).max(1) };
+        for k in 0..=n {
+            let s = k as f64 / n as f64;
+            let q = p3(
+                m.from.x + (m.to.x - m.from.x) * s,
+                m.from.y + (m.to.y - m.from.y) * s,
+                m.from.z + (m.to.z - m.from.z) * s + R,
+            );
+            let d = model.iter().map(|f| pt_tri(q, f)).fold(f64::INFINITY, f64::min);
+            worst = worst.max(R - d);
+        }
+    }
+    worst
+}
+
+/// Feeds that cross the X band `[lo, hi]` in one move, on rows inside
+/// the Y band `[ylo, yhi]`, at the surface height.
+fn crossings(t: &Toolpath, (lo, hi): (f64, f64), (ylo, yhi): (f64, f64), z: f64) -> usize {
+    t.moves
+        .iter()
+        .filter(|m| matches!(m.kind, MoveKind::Feed))
+        .filter(|m| m.from.x.min(m.to.x) <= lo && m.from.x.max(m.to.x) >= hi)
+        .filter(|m| (ylo..=yhi).contains(&m.from.y) && (ylo..=yhi).contains(&m.to.y))
+        .filter(|m| (m.from.z - z).abs() <= TOL && (m.to.z - z).abs() <= TOL)
+        .count()
+}
+
+/// Rapids and plunges that end over `x` band x `y` band: the picks.
+fn picks(t: &Toolpath, (xlo, xhi): (f64, f64), (ylo, yhi): (f64, f64)) -> usize {
+    t.moves
+        .iter()
+        .filter(|m| matches!(m.kind, MoveKind::Rapid | MoveKind::Plunge))
+        .filter(|m| (xlo..=xhi).contains(&m.to.x) && (ylo..=yhi).contains(&m.to.y))
+        .count()
+}
+
+#[test]
+fn a_hole_narrower_than_the_ball_is_crossed_without_a_pick() {
+    let plate = holed_plate(2.0);
+    let path = parallel(&plate, &fp()).expect("parallel");
+    for cx in [10.0, 30.0] {
+        let over = crossings(&path, (cx - 1.0, cx + 1.0), (9.0, 11.0), TOP);
+        assert!(over > 0, "hole at x {cx}: the raster must cross it in one feed at the top");
+        let near = picks(&path, (cx - 1.0 - R, cx + 1.0 + R), (9.0 - R, 11.0 + R));
+        assert_eq!(near, 0, "hole at x {cx}: no retract or plunge over the hole");
+    }
+    let bite = deepest_bite(&path, &plate);
+    assert!(bite <= TOL, "the bridged path bites the real plate by {bite}");
+}
+
+#[test]
+fn an_open_slot_narrower_than_the_ball_is_crossed_without_a_pick() {
+    let plate = slotted_plate();
+    let path = parallel(&plate, &fp()).expect("parallel");
+    let over = crossings(&path, (19.0, 21.0), (0.0, 20.0), TOP);
+    assert!(over > 10, "every row must cross the open slot, crossed {over}");
+    assert_eq!(picks(&path, (19.0 - R, 21.0 + R), (0.5, 19.5)), 0, "no pick at the slot");
+    let bite = deepest_bite(&path, &plate);
+    assert!(bite <= TOL, "the bridged path bites the real plate by {bite}");
+}
+
+#[test]
+fn a_lid_edge_a_hair_off_the_rim_is_crossed_without_a_pick() {
+    // A 0.01 mm step leaves a sqrt(2 r dz) = 0.17 mm stretch where no
+    // facet answers under the center; its chord sags 0.003 mm.
+    let plate = stepped_plate(0.01);
+    let path = parallel(&plate, &fp()).expect("parallel");
+    let over = t_cross(&path);
+    assert!(over > 10, "every row must cross the step in one feed, crossed {over}");
+    let bite = deepest_bite(&path, &plate);
+    assert!(bite <= TOL, "the bridged path bites the real plate by {bite}");
+}
+
+/// Crossings of the 0.01 step at x 20 on the rows inside the plate.
+fn t_cross(t: &Toolpath) -> usize {
+    t.moves
+        .iter()
+        .filter(|m| matches!(m.kind, MoveKind::Feed))
+        .filter(|m| m.from.x.min(m.to.x) < 20.0 && m.from.x.max(m.to.x) > 20.0)
+        .filter(|m| (m.from.y - m.to.y).abs() < 1e-9 && (0.5..=19.5).contains(&m.from.y))
+        .filter(|m| m.from.z >= TOP - 0.01 - TOL && m.to.z >= TOP - 0.01 - TOL)
+        .count()
+}
+
+#[test]
+fn a_hole_the_ball_fits_into_keeps_a_clean_hop() {
+    // 3.4 mm against a 3 mm ball: the hole is model surface, and the
+    // link over it goes up to the safe height, never across at the top.
+    let plate = holed_plate(3.4);
+    let path = parallel(&plate, &fp()).expect("parallel");
+    for cx in [10.0, 30.0] {
+        let over = crossings(&path, (cx - 1.7, cx + 1.7), (8.3, 11.7), TOP);
+        assert_eq!(over, 0, "hole at x {cx}: wider than the tool, no bridge");
+    }
+    let low_rapid = path
+        .moves
+        .iter()
+        .filter(|m| matches!(m.kind, MoveKind::Rapid))
+        .filter(|m| (m.from.x - m.to.x).abs() > 1e-9 || (m.from.y - m.to.y).abs() > 1e-9)
+        .any(|m| m.from.z < TOP + R || m.to.z < TOP + R);
+    assert!(!low_rapid, "every lateral rapid stays at the safe height");
+    let bite = deepest_bite(&path, &plate);
+    assert!(bite <= TOL, "the hop path bites the real plate by {bite}");
+}
+
+#[test]
+fn a_bridge_never_spans_a_wide_gap_or_a_tall_step() {
+    // A 1 mm step is a shelf edge, not a lid hair: the line still
+    // breaks there, and nothing feeds through the corner.
+    let plate = stepped_plate(1.0);
+    let path = parallel(&plate, &fp()).expect("parallel");
+    let bite = deepest_bite(&path, &plate);
+    assert!(bite <= TOL, "the shelf path bites the real plate by {bite}");
+    let through = path
+        .moves
+        .iter()
+        .filter(|m| matches!(m.kind, MoveKind::Feed))
+        .filter(|m| m.from.x.min(m.to.x) < 19.9 && m.from.x.max(m.to.x) > 20.1)
+        .any(|m| m.from.z.min(m.to.z) < TOP - 0.01 && m.from.z.max(m.to.z) > TOP - 0.99);
+    assert!(!through, "no straight feed crosses a 1 mm shelf edge");
+}
