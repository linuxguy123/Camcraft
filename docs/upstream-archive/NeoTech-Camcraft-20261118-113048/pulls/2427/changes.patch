From e10ba5ba32a77031856cbf6c0819695813d0d525 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 17 Nov 2026 17:19:58 -0800
Subject: [PATCH] fix(motion): keep a multi-piece pocket's eroded area when no
 sliver drops

`non_sliver_center` (#2383, for #2232) rebuilt every multi-piece cutter-
center area through `Region::from_slices` even when its sliver scan dropped
nothing. Clipper's normalisation restarts each loop at another vertex, so
the pass starts of multi-piece pockets moved: adaptive_entry_pieces'
narrow second piece started at (56, 6) instead of (56, 5) and the
post-merge batch gate went red. Return the plain offset unchanged unless
a sliver is actually removed.

Fixes #2426

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/motion/src/machining2d/pocket.rs   | 37 +++++++++++++++++++++++
 docs/decisions/2426-adaptive-entry-red.md | 28 +++++++++++++++++
 2 files changed, 65 insertions(+)
 create mode 100644 docs/decisions/2426-adaptive-entry-red.md

diff --git a/crates/motion/src/machining2d/pocket.rs b/crates/motion/src/machining2d/pocket.rs
index 406744d8a..132143d23 100644
--- a/crates/motion/src/machining2d/pocket.rs
+++ b/crates/motion/src/machining2d/pocket.rs
@@ -236,11 +236,20 @@ pub(super) fn non_sliver_center(region: &Region, erode: f64) -> Result<Region, G
     }
     let clean = Region::from_slices(center.loops().to_vec())?;
     let mut kept = Vec::new();
+    let mut dropped = false;
     for c in super::pocket_hsm::components(&clean)? {
         if c.area().abs() > 1e-2 || crate::entry::dive_room(&c, 0.008).is_some() {
             kept.extend(c.loops().iter().cloned());
+        } else {
+            dropped = true;
         }
     }
+    // Nothing dropped: keep the eroded area exactly as offset gave it. The
+    // rebuild through `from_slices` re-starts each loop at another vertex,
+    // which moved a multi-piece pocket's pass starts (#2426).
+    if !dropped {
+        return Ok(center);
+    }
     Ok(Region::from_slices(kept)?)
 }
 
@@ -332,3 +341,31 @@ pub(crate) fn plan_passes(
         }
     }
 }
+
+#[cfg(test)]
+mod non_sliver_tests {
+    use super::non_sliver_center;
+    use crate::geo2d::{Loop, Point2, Region};
+
+    fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+        let pts = [(x0, y0), (x1, y0), (x1, y1), (x0, y1)];
+        let Ok(l) = Loop::new(pts.iter().map(|&(x, y)| Point2::new(x, y)).collect()) else {
+            panic!("fixture loop")
+        };
+        l
+    }
+
+    /// #2426: a two-piece area with no sliver comes back exactly as the
+    /// offset gave it - same loops, same start vertices - so the pass
+    /// starts of a multi-piece pocket do not move.
+    #[test]
+    fn a_multi_piece_center_without_slivers_is_the_plain_offset() {
+        let Ok(reg) = Region::new(vec![rect(0.0, 0.0, 30.0, 30.0), rect(50.0, 0.0, 61.0, 11.0)]) else {
+            panic!("fixture region")
+        };
+        let Ok(plain) = reg.offset(-5.0) else { panic!("offset") };
+        let Ok(kept) = non_sliver_center(&reg, 5.0) else { panic!("non_sliver_center") };
+        assert_eq!(plain.loops().iter().filter(|l| l.is_ccw()).count(), 2, "fixture must have two pieces");
+        assert_eq!(kept, plain);
+    }
+}
