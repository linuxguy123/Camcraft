new file mode 100644
index 000000000..5838ebdba
--- /dev/null
+++ b/crates/motion/src/turning/thread_dips.rs
@@ -0,0 +1,340 @@
+//! In-pass chip-break dips (issue #419): inside one roughing pass the
+//! insert lifts radially by a dip height and comes back, a few times
+//! along the thread, so the chip breaks. The lead is never touched.
+//! Every half-turn of a dipped pass still advances exactly half a lead,
+//! so the station a spindle angle meets (station mod lead, the helix
+//! phase) is the plain pass's. Only the radius at each half-turn end
+//! changes. A half-turn whose two ends stand at different radii is the
+//! CL's variable-radius synchronized segment: on a continuous-threading
+//! control it is one `G32 X Z F` block, a taper segment of the chain.
+//!
+//! Safety laws:
+//! - **Never deeper than the pass.** Every radius is the pass's tip
+//!   plus a lift of 0 or more. The lifted V stands on the pass's own
+//!   station, and its tip is higher, so it lies inside the V the pass
+//!   cuts. A dip can only leave material, never take more.
+//! - **Never steeper than 45 degrees.** Each segment's diameter change
+//!   is smaller than its axial travel. Past 45 degrees a Fanuc control
+//!   reads F as the X lead (B-64304EN-1 §3.2), which would change the
+//!   Z feed and move the helix. Checking the diameter keeps the rule
+//!   whether a control measures the angle in radius or in diameter.
+//! - **Never in the first or the last lead, never on a pass at the
+//!   root.** The first lead is where the pass comes up to speed, and
+//!   the last is where it leaves. The finishing and spring passes cut
+//!   the finished flank, so a dip there would leave its wedge on the
+//!   part. Repeats of a depth (#418) clean that depth, so they cut
+//!   whole too.
+//! - **No more than the pass's own depth of cut.** The flanks lift
+//!   onto the surface the pass before left, not into air above it (the
+//!   #363 research's rule).
+//!
+//! The verdict ([`dip_warnings`]) re-reads each laid chain against
+//! these laws, so a path that breaks one is convicted. A convicted
+//! path holds the post.
+//!
+//! Provenance: continuous thread cutting as FANUC Series 0i-TD USER'S
+//! MANUAL (For Lathe System) B-64304EN-1 states it: §3.4 consecutive
+//! threading blocks keep spindle synchronism at the block joints; §3.2
+//! WARNING 6, a threading block that follows a threading block starts
+//! at once, without waiting for the one-rotation signal; §3.2, a G32
+//! may cut a taper, with the lead along Z up to 45 degrees. Also the
+//! Haas lathe G32 reference (sync holds for each following G32 line).
+//! In-pass interruption for chip control as tooling makers describe it
+//! (behaviour only). The layout, the containment proof and the verdict
+//! are our own. No vendor post, output or CAM strategy consulted.
+
+use crate::cl::{MoveKind, Toolpath};
+use crate::machining2d::GenError;
+use crate::verify::Warning;
+
+use super::infeed::Pass;
+use super::profile::Frame;
+use super::revolve::HAIR;
+
+/// The smallest dip a post can tell from lattice noise, mm radial (the
+/// stream writes whole microns).
+pub const MIN_DIP_HEIGHT: f64 = 0.01;
+
+/// Half-turns in a lead: the first and the last lead stay whole.
+const LEAD_HALVES: usize = 2;
+
+/// How far under 45 degrees a dip ramp stays, mm of diameter change
+/// per half-turn below its axial travel.
+const SLOPE_MARGIN: f64 = 0.01;
+
+/// How close two lengths must be to read as the same, mm. This is
+/// float noise on the half-micron stream lattice, far below any real
+/// dip.
+const EPS: f64 = 1e-6;
+
+/// The chip-break dips of a thread's roughing passes. `interval` 0
+/// (the default) lays none.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ThreadDips {
+    /// Axial distance from one dip's start to the next, mm. It is
+    /// rounded up to whole half-turns, at least two leads, and at least
+    /// one lead longer than the dip. 0 means no dips.
+    pub interval: f64,
+    /// Radial lift, mm. At most the depth of cut of every pass that
+    /// dips.
+    pub height: f64,
+    /// Axial length of one dip, out-ramp to in-ramp, mm. It is rounded
+    /// up to whole half-turns, and is never shorter than its two ramps.
+    /// 0 means the ramps alone.
+    pub length: f64,
+}
+
+impl Default for ThreadDips {
+    fn default() -> Self {
+        ThreadDips { interval: 0.0, height: 0.05, length: 0.0 }
+    }
+}
+
+/// Where the dips stand in a pass of `n` half-turns, in half-turns.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Layout {
+    /// Half-turns in each ramp.
+    ramp: usize,
+    /// Half-turns in a whole dip, both ramps included.
+    span: usize,
+    /// Half-turns from one dip's start to the next.
+    every: usize,
+}
+
+impl ThreadDips {
+    /// Does the plan lay dips at all?
+    #[must_use]
+    pub fn is_on(&self) -> bool {
+        self.interval > 0.0
+    }
+
+    /// Why these dips cannot ride a thread whose first pass is
+    /// `first_depth` deep (`None`: they can, as far as the numbers tell
+    /// before the passes are laid). Off is always fine.
+    #[must_use]
+    pub fn refusal(&self, first_depth: f64) -> Option<String> {
+        if !self.is_on() {
+            return None;
+        }
+        if !self.interval.is_finite() {
+            return Some(format!("a chip-break dip interval of {} is not a length", self.interval));
+        }
+        if !(self.height.is_finite() && self.height >= MIN_DIP_HEIGHT) {
+            return Some(format!(
+                "a chip-break dip {} high is too small for a post to tell apart from the \
+                 micron grid - lift at least {MIN_DIP_HEIGHT}",
+                self.height
+            ));
+        }
+        if !(self.length.is_finite() && self.length >= 0.0) {
+            return Some(format!("a chip-break dip length of {} is not a length - give 0 or more", self.length));
+        }
+        if first_depth.is_finite() && self.height > first_depth + EPS {
+            return Some(format!(
+                "a chip-break dip {:.3} high lifts past the first pass's own {:.3} depth of cut - \
+                 a dip lifts the flanks onto the last pass's surface, never above it",
+                self.height, first_depth
+            ));
+        }
+        None
+    }
+
+    /// The tool-free door: every number finite and in range.
+    #[must_use]
+    pub fn is_sane(&self) -> bool {
+        self.interval.is_finite()
+            && self.interval >= 0.0
+            && self.height.is_finite()
+            && self.height >= 0.0
+            && self.length.is_finite()
+            && self.length >= 0.0
+    }
+
+    fn layout(&self, pitch: f64, n: usize) -> Result<Layout, GenError> {
+        let h = pitch * 0.5;
+        let halves = |v: f64| -> usize {
+            let q = (v / h - 1e-9).ceil();
+            if q.is_finite() && q > 0.0 {
+                q.min(usize::MAX as f64 / 4.0) as usize
+            } else {
+                0
+            }
+        };
+        let too_long = || {
+            GenError::Invalid(format!(
+                "the thread is too short for a chip-break dip every {:.3} - the first and the \
+                 last lead stay whole, so the dip has nowhere to stand; shorten the interval \
+                 or turn the dips off",
+                self.interval
+            ))
+        };
+        // The diameter change of a ramp half-turn under its axial
+        // travel by at least SLOPE_MARGIN: 2 * height / ramp <= h -
+        // margin, the fewest half-turns that keep it so. The margin
+        // keeps the post's own 45-degree check (on the micron grid)
+        // on the same side as the kernel's.
+        let room = h - SLOPE_MARGIN;
+        let steep = (2.0 * self.height / room).floor() + 1.0;
+        if !(room > 0.0 && steep.is_finite() && steep >= 1.0 && steep <= n as f64) {
+            return Err(too_long());
+        }
+        let ramp = steep as usize;
+        let span = halves(self.length).max(ramp.saturating_mul(2));
+        let least = span.saturating_add(LEAD_HALVES).max(2 * LEAD_HALVES);
+        let every = halves(self.interval);
+        if every < least {
+            return Err(GenError::Invalid(format!(
+                "chip-break dips every {:.3} leave less than a lead of whole thread between \
+                 dips {:.3} long - the shortest interval here is {:.3}",
+                self.interval,
+                span as f64 * h,
+                least as f64 * h
+            )));
+        }
+        if every.saturating_add(span).saturating_add(LEAD_HALVES) > n {
+            return Err(too_long());
+        }
+        Ok(Layout { ramp, span, every })
+    }
+}
+
+/// The radius at every half-turn end of every pass: `out[k][0]` is pass
+/// `k`'s tip (the plunge), `out[k][i]` the end of half-turn `i` of `n`.
+/// A pass that does not dip keeps its tip throughout, bit for bit, so
+/// a plan with dips off lays the very path it laid before #419.
+/// Refused by name: dips on with no roughing pass to carry them, a dip
+/// higher than a dipped pass's depth of cut, a thread too short for a
+/// dip outside its first and last lead, and an interval that leaves no
+/// whole lead between dips.
+pub(super) fn radii(
+    dips: &ThreadDips,
+    passes: &[Pass],
+    ref_top: f64,
+    root: f64,
+    pitch: f64,
+    n: usize,
+) -> Result<Vec<Vec<f64>>, GenError> {
+    let plain = || passes.iter().map(|p| vec![p.tip; n + 1]).collect();
+    if !dips.is_on() {
+        return Ok(plain());
+    }
+    if let Some(why) = dips.refusal(f64::INFINITY) {
+        return Err(GenError::Invalid(why));
+    }
+    let mut out: Vec<Vec<f64>> = plain();
+    let dipped: Vec<(usize, f64)> = passes
+        .iter()
+        .enumerate()
+        .filter(|&(k, p)| p.tip > root + HAIR && (k == 0 || passes.get(k - 1) != Some(p)))
+        .map(|(k, p)| {
+            let above = k.checked_sub(1).and_then(|j| passes.get(j)).map_or(ref_top, |q| q.tip);
+            (k, above - p.tip)
+        })
+        .collect();
+    if dipped.is_empty() {
+        return Err(GenError::Invalid(
+            "chip-break dips ride the roughing passes, and this thread has none above the root - \
+             the first pass is the finishing pass; turn the dips off or take a shallower first pass"
+                .into(),
+        ));
+    }
+    let shallowest = dipped.iter().map(|&(_, d)| d).fold(f64::INFINITY, f64::min);
+    if dips.height > shallowest + EPS {
+        return Err(GenError::Invalid(format!(
+            "a chip-break dip {:.3} high lifts past a roughing pass's own {:.3} depth of cut - a \
+             dip lifts the flanks onto the last pass's surface, never above it; keep the dip at \
+             most {:.3}",
+            dips.height, shallowest, shallowest
+        )));
+    }
+    let lay = dips.layout(pitch, n)?;
+    for &(k, _) in &dipped {
+        let (Some(row), Some(p)) = (out.get_mut(k), passes.get(k)) else {
+            continue;
+        };
+        let mut j = lay.every;
+        while j + lay.span + LEAD_HALVES <= n {
+            for q in 1..=lay.span {
+                let up = if q <= lay.ramp {
+                    q
+                } else if q > lay.span - lay.ramp {
+                    lay.span - q
+                } else {
+                    lay.ramp
+                };
+                if let Some(r) = row.get_mut(j + q) {
+                    *r = p.tip + dips.height * (up as f64) / (lay.ramp as f64);
+                }
+            }
+            j += lay.every;
+        }
+    }
+    Ok(out)
+}
+
+/// One synchronized chain of a laid path: the plunge that opens it and
+/// the half-turns that follow it unbroken.
+struct Chain {
+    tip: f64,
+    /// (move index, station and radius at the start, then at the end).
+    turns: Vec<(usize, f64, f64, f64, f64)>,
+}
+
+/// The dip laws over a laid thread path, read off its own geometry. A
+/// chain opens at a straight feed (the plunge) and runs through the
+/// half-turns after it. Every half-turn must advance the station the
+/// chain's first one does (the phase law). No half-turn may stand
+/// deeper than the plunge. A half-turn whose radius changes must not
+/// be steeper than 45 degrees, must stand outside the chain's first and
+/// last lead, and must not stand on a pass at the deepest tip (the
+/// finishing and spring passes). Each breach is a gouge at its move:
+/// it holds the post.
+pub(super) fn dip_warnings(f: &Frame, path: &Toolpath) -> Vec<Warning> {
+    let mut chains: Vec<Chain> = Vec::new();
+    let mut open: Option<Chain> = None;
+    for (i, m) in path.moves.iter().enumerate() {
+        if m.kind == MoveKind::Rapid {
+            chains.extend(open.take());
+            continue;
+        }
+        let (sa, ra) = f.sr(m.from);
+        let (sb, rb) = f.sr(m.to);
+        if m.arc.is_some() {
+            if let Some(c) = open.as_mut() {
+                c.turns.push((i, sa, ra, sb, rb));
+            }
+        } else {
+            chains.extend(open.take());
+            open = Some(Chain { tip: rb, turns: Vec::new() });
+        }
+    }
+    chains.extend(open);
+    let deepest = chains
+        .iter()
+        .filter(|c| !c.turns.is_empty())
+        .map(|c| c.tip)
+        .fold(f64::INFINITY, f64::min);
+    let mut out = Vec::new();
+    for c in &chains {
+        let n = c.turns.len();
+        let Some(&(_, s0, _, s1, _)) = c.turns.first() else {
+            continue;
+        };
+        let step = s1 - s0;
+        for (k, &(at, sa, ra, sb, rb)) in c.turns.iter().enumerate() {
+            let k = k + 1;
+            let phase_moved = ((sb - sa) - step).abs() > EPS;
+            let deeper = ra.min(rb) < c.tip - EPS;
+            let dip = (rb - ra).abs() > EPS;
+            let bad_dip = dip
+                && (2.0 * (rb - ra).abs() >= (sb - sa).abs()
+                    || k <= LEAD_HALVES
+                    || k + LEAD_HALVES > n
+                    || c.tip <= deepest + EPS);
+            if phase_moved || deeper || bad_dip {
+                out.push(Warning::Gouge { at });
+            }
+        }
+    }
+    out
+}
diff --git a/crates/motion/tests/turning_thread_dips.rs b/crates/motion/tests/turning_thread_dips.rs
new file mode 100644
index 000000000..817d2e163
--- /dev/null
+++ b/crates/motion/tests/turning_thread_dips.rs
@@ -0,0 +1,335 @@
+//! In-pass chip-break dips (issue #419): the roughing passes lift
+//! radially and come back inside one synchronized chain. Pinned here:
+//! a plan with dips off lays the very path it laid before; no dip ever
+//! stands deeper than its pass, or higher than its dip height; the
+//! phase (station mod lead) of every half-turn end is the plain pass's;
+//! every dip segment stays under 45 degrees; no dip stands in a chain's
+//! first or last lead, on the finishing pass, or on a repeat of a depth;
+//! the verdict is silent on the laid dips and convicts a path that
+//! breaks a law (a dip in the first lead, on the finishing pass, deeper
+//! than its pass, or a moved station); the refusals by name; the cycle
+//! record marks the dips.
+//!
+//! Gate map (M4.4): covers camcraft_motion::turning (thread_dips: the
+//! dip layout and its verdict; the thread kernel's dipped half-turns;
+//! attach_cycle's chip_break_dips; thread_warnings).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::geometry::{Point3, Triangle};
+use camcraft_motion::turning::infeed::ThreadInfeed;
+use camcraft_motion::turning::profile::Frame;
+use camcraft_motion::turning::{thread_planned_in, thread_warnings, ThreadDips, ThreadParams};
+
+const TAU: f64 = std::f64::consts::TAU;
+const TOL: f64 = 0.05;
+const MAJOR: f64 = 6.0;
+const DEPTH: f64 = 1.2;
+const ROOT: f64 = MAJOR - DEPTH;
+const PITCH: f64 = 2.0;
+
+/// A 60-degree V every 2.0 from z 8 to `end` on a wall of r 6, 16 ways
+/// round (the motion threading suites' bar, lengthened).
+fn threaded(end: f64) -> Vec<Triangle> {
+    let half = DEPTH * (30.0_f64).to_radians().tan();
+    let mut m = vec![(0.0, -60.0), (MAJOR, -60.0), (MAJOR, 8.0 - half)];
+    let mut c = 8.0;
+    while c <= end + 1e-9 {
+        m.push((ROOT, c));
+        m.push((MAJOR, c + half));
+        if c + PITCH <= end + 1e-9 {
+            m.push((MAJOR, c + PITCH - half));
+        }
+        c += PITCH;
+    }
+    m.extend([(MAJOR, end + half), (MAJOR, end + 60.0), (0.0, end + 60.0)]);
+    let v = |j: usize, r: f64, z: f64| {
+        let th = TAU * j as f64 / 16.0;
+        Point3::new(r * th.cos(), r * th.sin(), z)
+    };
+    let mut t = Vec::new();
+    for seg in m.windows(2) {
+        let ((ra, za), (rb, zb)) = (seg[0], seg[1]);
+        for j in 0..16 {
+            let (a1, a2, b1, b2) = (v(j, ra, za), v(j + 1, ra, za), v(j, rb, zb), v(j + 1, rb, zb));
+            if ra <= 1e-12 {
+                t.push(Triangle::new(a1, b2, b1));
+            } else if rb <= 1e-12 {
+                t.push(Triangle::new(a1, a2, b2));
+            } else {
+                t.push(Triangle::new(a1, a2, b2));
+                t.push(Triangle::new(a1, b2, b1));
+            }
+        }
+    }
+    t
+}
+
+/// The long bar: eight leads, z 8 to 24.
+fn long_bar() -> Vec<Triangle> {
+    threaded(24.0)
+}
+
+fn width() -> f64 {
+    2.0 * DEPTH * (30.0_f64).to_radians().tan()
+}
+
+fn th(end: f64) -> ThreadParams {
+    ThreadParams {
+        tolerance: TOL,
+        clearance_z: end + 10.0,
+        top_z: end + 0.3,
+        bottom_z: 7.7,
+        pitch: PITCH,
+        depth: DEPTH,
+        infeed: 0.4,
+        feed: 120.0,
+        plunge_feed: 40.0,
+        insert_width: width(),
+        form_angle: 60.0,
+    }
+}
+
+/// Dips every two leads, 0.3 high, the shortest the ramps allow.
+fn dips() -> ThreadDips {
+    ThreadDips { interval: 4.0, height: 0.3, length: 0.0 }
+}
+
+fn plan_with(d: ThreadDips) -> ThreadInfeed {
+    ThreadInfeed { dips: d, ..ThreadInfeed::default() }
+}
+
+fn run(plan: &ThreadInfeed) -> Toolpath {
+    thread_planned_in(&long_bar(), &th(24.0), plan, None).expect("the thread cuts")
+}
+
+fn frame() -> Frame {
+    Frame::about(&long_bar()).expect("frame")
+}
+
+/// Every chain: the plunge's tip radius and its half-turns as (move
+/// index, start (station, radius), end (station, radius)).
+type Turn = (usize, (f64, f64), (f64, f64));
+fn chains(path: &Toolpath) -> Vec<(f64, Vec<Turn>)> {
+    let f = frame();
+    let mut out: Vec<(f64, Vec<Turn>)> = Vec::new();
+    for (i, m) in path.moves.iter().enumerate() {
+        if m.kind == MoveKind::Rapid {
+            continue;
+        }
+        if m.arc.is_none() {
+            out.push((f.sr(m.to).1, Vec::new()));
+        } else if let Some(c) = out.last_mut() {
+            c.1.push((i, f.sr(m.from), f.sr(m.to)));
+        }
+    }
+    out
+}
+
+fn is_dip(t: &Turn) -> bool {
+    (t.2 .1 - t.1 .1).abs() > 1e-9
+}
+
+#[test]
+fn dips_off_lay_the_plain_path_bit_for_bit() {
+    let plain = run(&ThreadInfeed::default());
+    // Off is interval 0, whatever the other numbers say.
+    let off = run(&plan_with(ThreadDips { interval: 0.0, height: 0.2, length: 3.0 }));
+    assert_eq!(plain.moves, off.moves);
+    assert_eq!(plain.threads, off.threads);
+    assert!(!plain.threads.iter().any(|t| t.chip_break_dips));
+}
+
+#[test]
+fn a_dip_never_stands_deeper_than_its_pass() {
+    let path = run(&plan_with(dips()));
+    let cs = chains(&path);
+    assert_eq!(cs.len(), 3, "three passes: 0.4, 0.8, 1.2");
+    let mut lifted = 0;
+    for (tip, turns) in &cs {
+        for t in turns {
+            for r in [t.1 .1, t.2 .1] {
+                assert!(r >= tip - 1e-9, "a half-turn at {r} under its pass's tip {tip}");
+                assert!(r <= tip + 0.3 + 1e-9, "a half-turn at {r} lifted past the dip height over {tip}");
+            }
+            if is_dip(t) {
+                lifted += 1;
+            }
+        }
+    }
+    // Two roughing passes, three dips each, an out- and an in-ramp per dip.
+    assert_eq!(lifted, 2 * 3 * 2, "{cs:?}");
+}
+
+#[test]
+fn the_phase_is_unchanged_across_the_chain() {
+    let plain = run(&ThreadInfeed::default());
+    let dipped = run(&plan_with(dips()));
+    assert_eq!(plain.moves.len(), dipped.moves.len(), "a dip adds no block");
+    let f = frame();
+    for (a, b) in plain.moves.iter().zip(&dipped.moves) {
+        assert_eq!(a.kind, b.kind);
+        assert_eq!(a.arc.is_some(), b.arc.is_some());
+        let (sa, sb) = (f.sr(a.to).0, f.sr(b.to).0);
+        assert!((sa - sb).abs() < 1e-9, "a dip moved a station: {sa} vs {sb}");
+        if let (Some(x), Some(y)) = (a.arc, b.arc) {
+            assert_eq!(x.center, y.center, "the half-turns turn about the same axis point");
+            assert_eq!(x.ccw, y.ccw);
+        }
+    }
+    for (_, turns) in chains(&dipped) {
+        let Some(first) = turns.first() else { continue };
+        let s0 = first.1 .0;
+        for (k, t) in turns.iter().enumerate() {
+            let along = t.2 .0 - s0;
+            let want = (k + 1) as f64 * PITCH * 0.5;
+            assert!((along - want).abs() < 1e-9, "half-turn {k} ends {along} along the chain, not {want}");
+            let phase = along.rem_euclid(PITCH);
+            assert!(phase.abs() < 1e-9 || (phase - PITCH * 0.5).abs() < 1e-9, "phase {phase}");
+        }
+    }
+}
+
+#[test]
+fn dips_stay_under_45_degrees_outside_the_first_and_last_lead_on_roughing_passes() {
+    let path = run(&plan_with(dips()));
+    let cs = chains(&path);
+    for (tip, turns) in &cs {
+        let n = turns.len();
+        for (k, t) in turns.iter().enumerate() {
+            if !is_dip(t) {
+                continue;
+            }
+            let k = k + 1;
+            assert!(k > 2 && k + 2 <= n, "a dip at half-turn {k} of {n} - inside the first or last lead");
+            let (dr, ds) = ((t.2 .1 - t.1 .1).abs(), (t.2 .0 - t.1 .0).abs());
+            assert!(2.0 * dr < ds, "a dip segment's diameter change {} not under its axial travel {ds}", 2.0 * dr);
+            assert!(*tip > ROOT + 1e-6, "a dip on the finishing pass at {tip}");
+        }
+    }
+    // The finishing pass at the root cuts whole.
+    let root = cs.iter().find(|(t, _)| (t - ROOT).abs() < 1e-6).expect("a pass at the root");
+    assert!(!root.1.iter().any(is_dip));
+    // A high dip spreads each ramp over two half-turns, still under 45:
+    // 0.6 high (a 1.2 diameter change) against 1.0 of travel each.
+    let p = ThreadParams { infeed: 0.6, ..th(24.0) };
+    let plan = plan_with(ThreadDips { interval: 8.0, height: 0.6, length: 0.0 });
+    let high = thread_planned_in(&long_bar(), &p, &plan, None).expect("the thread cuts");
+    let ramps: Vec<f64> = chains(&high)
+        .iter()
+        .flat_map(|(_, turns)| turns.iter().filter(|t| is_dip(t)).map(|t| (t.2 .1 - t.1 .1).abs()).collect::<Vec<_>>())
+        .collect();
+    assert_eq!(ramps.len(), 4, "one dip, two half-turns a ramp: {ramps:?}");
+    assert!(ramps.iter().all(|d| (d - 0.3).abs() < 1e-9), "{ramps:?}");
+    let w = thread_warnings(&long_bar(), &high, width(), 60.0, TOL);
+    assert!(w.is_empty(), "{w:?}");
+}
+
+#[test]
+fn a_repeated_depth_cuts_whole() {
+    let plan = ThreadInfeed { repeat_each_depth: true, dips: dips(), ..ThreadInfeed::default() };
+    let path = run(&plan);
+    let cs = chains(&path);
+    assert_eq!(cs.len(), 5, "0.4, 0.4, 0.8, 0.8, 1.2");
+    let dipped: Vec<bool> = cs.iter().map(|(_, t)| t.iter().any(is_dip)).collect();
+    assert_eq!(dipped, [true, false, true, false, false], "the first cut of each depth dips, its repeat does not");
+}
+
+#[test]
+fn the_verdict_is_silent_on_laid_dips() {
+    let path = run(&plan_with(dips()));
+    let w = thread_warnings(&long_bar(), &path, width(), 60.0, TOL);
+    assert!(w.is_empty(), "{w:?}");
+    assert!(path.threads.iter().all(|t| t.chip_break_dips), "the record marks the dips");
+}
+
+/// Rewrite the end radius of half-turn `k` (1-based) of chain `c` and
+/// the start of the half-turn after it: the shape a buggy layout would
+/// lay.
+fn bend(path: &mut Toolpath, c: usize, k: usize, radius: f64, station_shift: f64) -> usize {
+    let f = frame();
+    let cs = chains(path);
+    let at = cs[c].1[k - 1].0;
+    let to = path.moves[at].to;
+    let (s, _) = f.sr(to);
+    let (o, m) = (f.point(0.0, s), f.point(1.0, s));
+    let even = (to.x - o.x) * (m.x - o.x) + (to.y - o.y) * (m.y - o.y) + (to.z - o.z) * (m.z - o.z) > 0.0;
+    let s = s + station_shift;
+    let p = if even { f.point(radius, s) } else { antipode(&f, radius, s) };
+    path.moves[at].to = p;
+    if let Some(next) = path.moves.get_mut(at + 1) {
+        next.from = p;
+    }
+    at
+}
+
+fn antipode(f: &Frame, r: f64, s: f64) -> Point3 {
+    let a = f.point(r, s);
+    let o = f.point(0.0, s);
+    Point3::new(2.0 * o.x - a.x, 2.0 * o.y - a.y, 2.0 * o.z - a.z)
+}
+
+fn convicted(path: &Toolpath, at: usize) -> bool {
+    thread_warnings(&long_bar(), path, width(), 60.0, TOL)
+        .iter()
+        .any(|w| matches!(w, camcraft_motion::verify::Warning::Gouge { at: a } if *a == at || *a == at + 1))
+}
+
+#[test]
+fn the_verdict_convicts_a_dip_that_breaks_a_law() {
+    let base = run(&plan_with(dips()));
+    let tip0 = chains(&base)[0].0;
+    // A dip in the first lead: half-turn 1 of the first pass lifted.
+    let mut p = base.clone();
+    let at = bend(&mut p, 0, 1, tip0 + 0.2, 0.0);
+    assert!(convicted(&p, at), "a dip in the first lead passed the verdict");
+    // A dip in the last lead.
+    let mut p = base.clone();
+    let n = chains(&p)[0].1.len();
+    let at = bend(&mut p, 0, n - 1, tip0 + 0.2, 0.0);
+    assert!(convicted(&p, at), "a dip in the last lead passed the verdict");
+    // A dip on the finishing pass (the deepest chain).
+    let mut p = base.clone();
+    let at = bend(&mut p, 2, 6, ROOT + 0.2, 0.0);
+    assert!(convicted(&p, at), "a dip on the finishing pass passed the verdict");
+    // A dip deeper than its pass.
+    let mut p = base.clone();
+    let at = bend(&mut p, 0, 6, tip0 - 0.1, 0.0);
+    assert!(convicted(&p, at), "a half-turn under its pass passed the verdict");
+    // A moved station: the helix phase shifted.
+    let mut p = base.clone();
+    let at = bend(&mut p, 0, 6, tip0, 0.1);
+    assert!(convicted(&p, at), "a shifted phase passed the verdict");
+    // A dip steeper than 45 degrees.
+    let mut p = base;
+    let at = bend(&mut p, 0, 7, tip0 + 0.6, 0.0);
+    assert!(convicted(&p, at), "a steep dip passed the verdict");
+}
+
+fn refused(plan: &ThreadInfeed, end: f64, why: &str) {
+    match thread_planned_in(&threaded(end), &th(end), plan, None) {
+        Ok(_) => panic!("{why}: the thread cut"),
+        Err(e) => assert!(format!("{e:?}").contains(why), "{why}: refused for another reason: {e:?}"),
+    }
+}
+
+#[test]
+fn dips_refuse_by_name() {
+    // Higher than the first pass's depth of cut: the door's own refusal.
+    let high = plan_with(ThreadDips { height: 0.5, ..dips() });
+    assert!(high.refusal(DEPTH, 0.4, 60.0).is_some_and(|w| w.contains("first pass")));
+    refused(&high, 24.0, "lifts past the first pass");
+    // Higher than a later roughing pass's own (an allowance shortens it).
+    let short_rung = ThreadInfeed { finish_allowance: 0.1, dips: ThreadDips { height: 0.35, ..dips() }, ..ThreadInfeed::default() };
+    refused(&short_rung, 24.0, "lifts past a roughing pass's own 0.300");
+    // An interval that leaves no whole lead between dips.
+    refused(&plan_with(ThreadDips { interval: 2.0, ..dips() }), 24.0, "leave less than a lead");
+    // A thread too short for a dip outside its first and last lead.
+    refused(&plan_with(dips()), 14.0, "too short for a chip-break dip");
+    // A one-pass thread has no roughing pass to dip.
+    let p = ThreadParams { infeed: DEPTH, ..th(24.0) };
+    let e = thread_planned_in(&long_bar(), &p, &plan_with(ThreadDips { height: 0.3, ..dips() }), None);
+    assert!(e.is_err_and(|e| format!("{e:?}").contains("none above the root")));
+    // A dip too small to tell from the micron grid.
+    refused(&plan_with(ThreadDips { height: 0.001, ..dips() }), 24.0, "too small");
+}
