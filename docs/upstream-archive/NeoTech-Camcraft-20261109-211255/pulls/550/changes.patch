+/// 60 x 40 x 20 block, a 10 wide slot through along X to z 10.
+fn through_slot() -> Mesh {
+    height_field(&[-30.0, 30.0], &[-20.0, -5.0, 5.0, 20.0], |_, j| if j == 1 { 10.0 } else { 20.0 })
