diff --git a/crates/app/src/recognize/mod.rs b/crates/app/src/recognize/mod.rs
new file mode 100644
index 00000000..44916e33
--- /dev/null
+++ b/crates/app/src/recognize/mod.rs
@@ -0,0 +1,137 @@
+//! Pocket and slot recognition (#35, M13.6): the flat floors of a model
+//! whose boundary is held by walls rising on opposite sides, read off the
+//! planar-face topology `geometry::feature` builds (the B-rep this repo
+//! machines from). Each recognised floor is a closed pocket, an open
+//! pocket (walls broken by open spans), or a slot - a straight channel of
+//! constant width whose ends are open, round or square. The answer feeds
+//! an editable operation (`operation_for`), the way hole recognition
+//! feeds a drill.
+//!
+//! Provenance: our own algorithm, specced from the published
+//! feature-recognition literature's face-adjacency rule (a depression
+//! feature is a face whose boundary edges are concave, after Joshi &
+//! Chang, "Graph-based heuristics for recognition of machined features
+//! from a 3D solid model", CAD 20(2), 1988) and machining-handbook slot
+//! and pocket definitions; no vendor material or output was consulted.
+//!
+//! Robustness (Prime Directive): total on any mesh. Non-finite or
+//! degenerate facets never weld, faces that refuse a plane or a closed
+//! ring are skipped, and a model with no geometry is a refusal by name.
+
+mod op;
+mod shape;
+mod walls;
+
+pub use op::{op_kind_of, operation_for};
+
+use crate::geo2d::Point2;
+use crate::geometry::feature::{FaceId, FaceKind, LoopKind};
+use crate::model;
+use flecs_ecs::prelude::World;
+
+/// What a recognised floor is.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PocketKind {
+    /// Walls all round the floor's outer ring.
+    Closed,
+    /// Walls on opposite sides, broken by one or more open spans.
+    Open,
+    /// A straight channel of constant width (see [`SlotShape`]).
+    Slot,
+}
+
+/// How one end of a slot finishes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SlotEnd {
+    /// No wall: the channel runs out of the part there.
+    Open,
+    /// A semicircular wall of the slot's width.
+    Round,
+    /// A wall across the channel (square or small-radius corners).
+    Square,
+}
+
+/// A slot's straight-channel reading, world XY.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SlotShape {
+    /// The centreline ends a slot cut runs between: the cap centre of a
+    /// round end, the floor's edge at an open or square end.
+    pub a: Point2,
+    pub b: Point2,
+    pub width: f64,
+    /// Overall floor length along the centreline.
+    pub length: f64,
+    pub ends: [SlotEnd; 2],
+}
+
+/// One recognised pocket or slot, world coordinates.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Pocket {
+    /// The model it was read from.
+    pub model: String,
+    /// The floor face's stable id (`FeatureSel::Face`).
+    pub floor: FaceId,
+    pub kind: PocketKind,
+    /// The floor's outer ring, counter-clockwise from above.
+    pub boundary: Vec<Point2>,
+    /// Inner rings of the floor (bosses standing in it, or holes
+    /// through it).
+    pub islands: usize,
+    pub floor_z: f64,
+    /// The highest point of the walls standing on the floor.
+    pub top_z: f64,
+    pub depth: f64,
+    /// Floor area, mm².
+    pub area: f64,
+    /// The tightest inside corner between two walls: 0 for a sharp
+    /// corner, `None` when no two walls meet.
+    pub min_corner_radius: Option<f64>,
+    /// The spans of the outer ring no wall stands on, as segments.
+    pub open_spans: Vec<[Point2; 2]>,
+    pub slot: Option<SlotShape>,
+}
+
+/// The pockets and slots of one named model, ordered by floor Z (deepest
+/// first) then by position, so the list reads the same every call.
+///
+/// # Errors
+/// A name that is no model, or a model with no usable geometry.
+pub fn pockets_of(world: &World, name: &str) -> Result<Vec<Pocket>, String> {
+    let e = model::find_by_name(world, name).ok_or_else(|| format!("no model named '{name}'"))?;
+    if !model::is_model(world, &e) {
+        return Err(format!("'{name}' is not a model"));
+    }
+    let tris = model::facets_of(world, &e).ok_or_else(|| format!("'{name}' has no geometry"))?;
+    if tris.is_empty() {
+        return Err(format!("'{name}' has no geometry"));
+    }
+    let loc = model::transform_of(world, &e).unwrap_or_default();
+    let mesh = walls::Mesh::new(&tris, &loc);
+    if mesh.usable == 0 {
+        return Err(format!("'{name}' has no usable facets (every one degenerate or non-finite)"));
+    }
+    let features = model::features_of_local(&tris);
+    let mut out = Vec::new();
+    for (fi, face) in features.faces.iter().enumerate() {
+        if !matches!(face.kind, FaceKind::Planar) {
+            continue;
+        }
+        let Some(outer) = face.loops.iter().find(|l| matches!(l.kind, LoopKind::Outer)) else {
+            continue;
+        };
+        let Some(floor) = mesh.floor_of(&features, fi, face, outer) else {
+            continue;
+        };
+        let islands = face.loops.iter().filter(|l| matches!(l.kind, LoopKind::Hole)).count();
+        if let Some(p) = shape::classify(name, face.id, floor, islands) {
+            out.push(p);
+        }
+    }
+    out.sort_by(|a, b| {
+        a.floor_z
+            .total_cmp(&b.floor_z)
+            .then(a.boundary.first().map_or(0.0, |p| p.x).total_cmp(&b.boundary.first().map_or(0.0, |p| p.x)))
+            .then(a.boundary.first().map_or(0.0, |p| p.y).total_cmp(&b.boundary.first().map_or(0.0, |p| p.y)))
+    });
+    Ok(out)
+}
diff --git a/crates/app/src/recognize/op.rs b/crates/app/src/recognize/op.rs
new file mode 100644
index 00000000..a5a14e32
--- /dev/null
+++ b/crates/app/src/recognize/op.rs
@@ -0,0 +1,64 @@
+//! A recognised pocket or slot as an operation's source and parameters
+//! (#35): what the caller hands `CreateOperation`, so the new operation
+//! is one undoable History step whose every field stays editable - the
+//! way Detect holes fills a drill.
+//!
+//! Provenance: our own mapping onto this repo's operation kinds.
+
+use super::{Pocket, SlotEnd};
+use crate::operation::{self, FeatureSel, GeoSel, Height, HeightReference, OpParams, OpType, SrcRef};
+
+/// The kind a recognised feature machines as: a slot whose closed ends
+/// are all round (or open) rides the Slot cut along its centreline; a
+/// square closed end would leave its corners standing under a Slot's
+/// round cap, so it - and every pocket - is a 2D Pocket over the floor.
+#[must_use]
+pub fn op_kind_of(p: &Pocket) -> OpType {
+    match &p.slot {
+        Some(s) if !s.ends.contains(&SlotEnd::Square) => OpType::Slot,
+        _ => OpType::Pocket,
+    }
+}
+
+/// The source and parameters of the operation `p` machines as,
+/// carried from `base` (any kind's params: the caller's seed, its feeds
+/// and clearance kept through the registry's retype law).
+///
+/// A Pocket picks the floor face - its rings are the boundary and its
+/// islands, read again at every generate - with its floor at the
+/// selection's bottom and its top the walls' height above that, so the
+/// depths follow a moved part. A Slot is authored by its centreline
+/// ends and width (world XY) and fixed depths, cut into the setup's
+/// stock, as a typed Slot is: an open end runs its full width out to
+/// the floor's edge, so the round cap overhangs the part there into
+/// stock (or air) - never into the part.
+///
+/// # Errors
+/// A feature with no usable depth or width.
+pub fn operation_for(p: &Pocket, base: &OpParams) -> Result<(SrcRef, OpParams), String> {
+    if !(p.depth.is_finite() && p.depth > 0.0 && p.floor_z.is_finite() && p.top_z.is_finite()) {
+        return Err(format!("the feature on '{}' has no usable depth", p.model));
+    }
+    let kind = op_kind_of(p);
+    let mut params = if base.kind() == kind { base.clone() } else { operation::retype_params(base, kind as usize) };
+    match (&mut params, &p.slot) {
+        (OpParams::Pocket { top_z, bottom_z, .. }, _) => {
+            *bottom_z = Height::of(HeightReference::BottomOfSelection, 0.0);
+            *top_z = Height::of(HeightReference::BottomOfSelection, p.depth);
+            let src = SrcRef::Selection(vec![GeoSel { entity: p.model.clone(), feature: FeatureSel::Face(p.floor) }]);
+            Ok((src, params))
+        }
+        (OpParams::Slot { a, b, width, top_z, bottom_z, .. }, Some(s)) => {
+            if !(s.width.is_finite() && s.width > 0.0) {
+                return Err(format!("the slot on '{}' has no usable width", p.model));
+            }
+            *a = s.a;
+            *b = s.b;
+            *width = s.width;
+            *top_z = Height::fixed(p.top_z);
+            *bottom_z = Height::fixed(p.floor_z);
+            Ok((SrcRef::Stock, params))
+        }
+        _ => Err(format!("the feature on '{}' maps to no operation kind", p.model)),
+    }
+}
diff --git a/crates/app/src/recognize/shape.rs b/crates/app/src/recognize/shape.rs
new file mode 100644
index 00000000..612219fe
--- /dev/null
+++ b/crates/app/src/recognize/shape.rs
@@ -0,0 +1,265 @@
+//! The shape read of a walled floor (#35): closed or open pocket, the
+//! tightest inside corner, the open spans, and whether it is a slot - a
+//! straight channel of constant width, fitted by the minimum-area
+//! enclosing rectangle over the ring's edge directions (Freeman &
+//! Shapira, "Determining the minimum-area encasing rectangle for an
+//! arbitrary closed curve", CACM 18(7), 1975: an optimal rectangle has a
+//! side collinear with an edge of the convex hull).
+//!
+//! Provenance: our own code from the cited literature and handbook slot /
+//! pocket definitions; no vendor material consulted.
+
+use super::walls::Floor;
+use super::{Pocket, PocketKind, SlotEnd, SlotShape};
+use crate::geo2d::Point2;
+use crate::geometry::feature::FaceId;
+
+/// Two wall directions this opposed (cosine) face each other across the
+/// floor - the "walls on opposite sides" test of a pocket.
+const OPPOSED: f64 = -0.9;
+/// A turn below this is a collinear split, not a corner (radians, 1°).
+const MIN_TURN: f64 = std::f64::consts::PI / 180.0;
+/// A turn above this is a sharp corner, not an arc's tessellation (60°).
+const SHARP_TURN: f64 = std::f64::consts::FRAC_PI_3;
+/// A slot is at least this many widths long.
+const SLOT_ASPECT: f64 = 2.0;
+/// Relative slack between the floor's area and the slot shape's.
+const SLOT_AREA_TOL: f64 = 0.03;
+
+/// Shoelace area, counter-clockwise positive.
+pub(super) fn signed_area(pts: &[Point2]) -> f64 {
+    let n = pts.len();
+    let mut s = 0.0;
+    for i in 0..n {
+        let (Some(a), Some(b)) = (pts.get(i), pts.get((i + 1) % n)) else { continue };
+        s += a.x * b.y - b.x * a.y;
+    }
+    0.5 * s
+}
+
+fn sub(a: Point2, b: Point2) -> Point2 {
+    Point2::new(a.x - b.x, a.y - b.y)
+}
+
+fn dot(a: Point2, b: Point2) -> f64 {
+    a.x * b.x + a.y * b.y
+}
+
+fn cross(a: Point2, b: Point2) -> f64 {
+    a.x * b.y - a.y * b.x
+}
+
+/// The floor read as a pocket or slot; None when its walls do not stand
+/// on opposite sides (a shoulder, a corner step, a plain top face).
+pub(super) fn classify(model: &str, floor: FaceId, f: Floor, islands: usize) -> Option<Pocket> {
+    let n = f.ring.len();
+    let closed = f.wall.iter().all(|w| *w);
+    if !closed && !opposed_walls(&f) {
+        return None;
+    }
+    let slot = slot_of(&f, islands);
+    let kind = match (slot.is_some(), closed) {
+        (true, _) => PocketKind::Slot,
+        (false, true) => PocketKind::Closed,
+        (false, false) => PocketKind::Open,
+    };
+    let open_spans = open_spans(&f);
+    let min_corner_radius = min_corner(&f);
+    let depth = f.top - f.z;
+    if n < 3 || !depth.is_finite() {
+        return None;
+    }
+    Some(Pocket {
+        model: model.to_owned(),
+        floor,
+        kind,
+        boundary: f.ring,
+        islands,
+        floor_z: f.z,
+        top_z: f.top,
+        depth,
+        area: f.area,
+        min_corner_radius,
+        open_spans,
+        slot,
+    })
+}
+
+/// The inward direction of span `i` (left of a counter-clockwise ring).
+fn inward(f: &Floor, i: usize) -> Option<Point2> {
+    let n = f.ring.len();
+    let d = sub(*f.ring.get((i + 1) % n)?, *f.ring.get(i)?);
+    let len = d.x.hypot(d.y);
+    (len > 0.0 && len.is_finite()).then(|| Point2::new(-d.y / len, d.x / len))
+}
+
+fn opposed_walls(f: &Floor) -> bool {
+    let dirs: Vec<Point2> = (0..f.ring.len()).filter(|&i| f.wall.get(i) == Some(&true)).filter_map(|i| inward(f, i)).collect();
+    dirs.iter().any(|a| dirs.iter().any(|b| dot(*a, *b) < OPPOSED))
+}
+
+/// Each run of wall-less spans, as the segment from its first vertex to
+/// its last.
+fn open_spans(f: &Floor) -> Vec<[Point2; 2]> {
+    let n = f.ring.len();
+    let Some(start) = (0..n).find(|&i| f.wall.get(i) == Some(&true)) else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    let mut run: Option<usize> = None;
+    for k in 1..=n {
+        let i = (start + k) % n;
+        let open = f.wall.get(i) == Some(&false);
+        match (open, run) {
+            (true, None) => run = Some(i),
+            (false, Some(s)) => {
+                if let (Some(a), Some(b)) = (f.ring.get(s), f.ring.get(i)) {
+                    out.push([*a, *b]);
+                }
+                run = None;
+            }
+            _ => {}
+        }
+    }
+    out
+}
+
+/// The tightest corner where two walls meet: the circumradius of an
+/// arc's tessellation, 0 for a sharp corner. Only left turns of the
+/// counter-clockwise ring are inside corners a cutter must fit.
+fn min_corner(f: &Floor) -> Option<f64> {
+    let n = f.ring.len();
+    let mut best: Option<f64> = None;
+    for i in 0..n {
+        let prev = (i + n - 1) % n;
+        if f.wall.get(prev) != Some(&true) || f.wall.get(i) != Some(&true) {
+            continue;
+        }
+        let (Some(&a), Some(&b), Some(&c)) = (f.ring.get(prev), f.ring.get(i), f.ring.get((i + 1) % n)) else {
+            continue;
+        };
+        let (e1, e2) = (sub(b, a), sub(c, b));
+        let turn = cross(e1, e2).atan2(dot(e1, e2));
+        if !turn.is_finite() || turn < MIN_TURN {
+            continue;
+        }
+        let r = if turn > SHARP_TURN {
+            0.0
+        } else {
+            let chord = sub(c, a);
+            e1.x.hypot(e1.y) * e2.x.hypot(e2.y) * chord.x.hypot(chord.y) / (2.0 * cross(e1, e2).abs())
+        };
+        if r.is_finite() {
+            best = Some(best.map_or(r, |b| b.min(r)));
+        }
+    }
+    best
+}
+
+/// The minimum-area enclosing rectangle over the ring's edge
+/// directions: centre, long-axis unit direction, length, width.
+fn min_rect(pts: &[Point2]) -> Option<(Point2, Point2, f64, f64)> {
+    let n = pts.len();
+    let mut best: Option<(f64, Point2, Point2, f64, f64)> = None;
+    for i in 0..n {
+        let (Some(&a), Some(&b)) = (pts.get(i), pts.get((i + 1) % n)) else { continue };
+        let d = sub(b, a);
+        let len = d.x.hypot(d.y);
+        if !(len > 1e-9 && len.is_finite()) {
+            continue;
+        }
+        let u = Point2::new(d.x / len, d.y / len);
+        let v = Point2::new(-u.y, u.x);
+        let (mut u0, mut u1, mut v0, mut v1) = (f64::INFINITY, f64::NEG_INFINITY, f64::INFINITY, f64::NEG_INFINITY);
+        for p in pts {
+            let (pu, pv) = (dot(*p, u), dot(*p, v));
+            u0 = u0.min(pu);
+            u1 = u1.max(pu);
+            v0 = v0.min(pv);
+            v1 = v1.max(pv);
+        }
+        let area = (u1 - u0) * (v1 - v0);
+        if !area.is_finite() || best.as_ref().is_some_and(|b| b.0 <= area) {
+            continue;
+        }
+        let (cu, cv) = (0.5 * (u0 + u1), 0.5 * (v0 + v1));
+        let c = Point2::new(u.x * cu + v.x * cv, u.y * cu + v.y * cv);
+        let (lu, lv) = (u1 - u0, v1 - v0);
+        best = Some(if lu >= lv { (area, c, u, lu, lv) } else { (area, c, v, lv, lu) });
+    }
+    best.map(|(_, c, u, l, w)| (c, u, l, w))
+}
+
+/// The floor as a straight channel: both long sides walled along their
+/// whole length, each end wholly walled (round or square) or wholly
+/// open, no islands, and an area that matches the shape.
+fn slot_of(f: &Floor, islands: usize) -> Option<SlotShape> {
+    if islands > 0 {
+        return None;
+    }
+    let (c, u, l, w) = min_rect(&f.ring)?;
+    if !(w > 1e-3 && l >= SLOT_ASPECT * w) {
+        return None;
+    }
+    let v = Point2::new(-u.y, u.x);
+    let tol = (1e-3 * w).max(1e-3);
+    let n = f.ring.len();
+    let side = |p: Point2| {
+        let pv = dot(sub(p, c), v);
+        ((pv.abs() - 0.5 * w).abs() <= tol).then_some(pv.signum())
+    };
+    // Per end (0 = -u, 1 = +u): its span walls and its vertices.
+    let mut walls: [Vec<bool>; 2] = [Vec::new(), Vec::new()];
+    let mut verts: [Vec<Point2>; 2] = [Vec::new(), Vec::new()];
+    for i in 0..n {
+        let (&p, &q, &is_wall) = (f.ring.get(i)?, f.ring.get((i + 1) % n)?, f.wall.get(i)?);
+        match (side(p), side(q)) {
+            (Some(sp), Some(sq)) if sp == sq => {
+                if !is_wall {
+                    return None;
+                }
+            }
+            _ => {
+                let mid = Point2::new(0.5 * (p.x + q.x), 0.5 * (p.y + q.y));
+                let e = usize::from(dot(sub(mid, c), u) > 0.0);
+                walls.get_mut(e)?.push(is_wall);
+                verts.get_mut(e)?.extend([p, q]);
+            }
+        }
+    }
+    let mut ends = [SlotEnd::Open; 2];
+    for e in 0..2 {
+        let ws = walls.get(e)?;
+        if ws.is_empty() {
+            return None;
+        }
+        let sign = if e == 0 { -1.0 } else { 1.0 };
+        let cap = Point2::new(c.x + u.x * sign * 0.5 * (l - w), c.y + u.y * sign * 0.5 * (l - w));
+        let round_tol = (0.02 * w).max(0.01);
+        let end = if ws.iter().all(|x| !*x) {
+            SlotEnd::Open
+        } else if ws.iter().all(|x| *x) {
+            let round = verts.get(e)?.iter().all(|p| (sub(*p, cap).x.hypot(sub(*p, cap).y) - 0.5 * w).abs() <= round_tol);
+            if round { SlotEnd::Round } else { SlotEnd::Square }
+        } else {
+            return None;
+        };
+        *ends.get_mut(e)? = end;
+    }
+    let rounds = ends.iter().filter(|e| **e == SlotEnd::Round).count() as f64;
+    // A round end trades a w/2 x w corner block for a semicircle.
+    let expected = l * w - rounds * w * w * (0.5 - std::f64::consts::FRAC_PI_8);
+    let actual = signed_area(&f.ring).abs();
+    if !(expected > 0.0 && (actual - expected).abs() <= SLOT_AREA_TOL * expected) {
+        return None;
+    }
+    let inset = |e: SlotEnd| if e == SlotEnd::Round { 0.5 * w } else { 0.0 };
+    let (ha, hb) = (0.5 * l - inset(ends[0]), 0.5 * l - inset(ends[1]));
+    Some(SlotShape {
+        a: Point2::new(c.x - u.x * ha, c.y - u.y * ha),
+        b: Point2::new(c.x + u.x * hb, c.y + u.y * hb),
+        width: w,
+        length: l,
+        ends,
+    })
+}
diff --git a/crates/app/src/recognize/walls.rs b/crates/app/src/recognize/walls.rs
new file mode 100644
index 00000000..c9e225b7
--- /dev/null
+++ b/crates/app/src/recognize/walls.rs
@@ -0,0 +1,245 @@
+//! The wall read of a floor (#35): which spans of a level face's outer
+//! ring have a wall rising from them into the face (a concave edge, the
+//! depression rule), and how high the walls standing on it reach.
+//!
+//! Provenance: our own code over this repo's welded mesh topology; the
+//! concave-edge rule after Joshi & Chang (CAD 20(2), 1988), see
+//! `recognize`. No vendor material consulted.
+
+use crate::geo2d::Point2;
+use crate::geometry::feature::{Face, Features, Loop};
+use crate::geometry::{transform_point, Point3, Triangle};
+use crate::schema::Location;
+use std::collections::{HashMap, VecDeque};
+
+/// Weld lattice, 1 µm - the factor `geometry::feature` welds on, so a
+/// ring vertex of the feature topology keys to the same lattice point
+/// as the facet corners it was welded from.
+const S: f64 = 1e6;
+/// A face this close to +Z is level (the `list_features` "up" word).
+const LEVEL: f64 = 0.999_999;
+/// Height slack above a floor before a facet counts as standing on it.
+const Z_TOL: f64 = 1e-4;
+/// The least horizontal lean (unit normal toward the floor) a facet
+/// needs to count as a wall facing into it: a vertical wall reads 1, a
+/// first fillet strip still reads well above this.
+const WALL_LEAN: f64 = 0.05;
+/// Smallest depth worth calling a pocket, mm.
+const MIN_DEPTH: f64 = 1e-3;
+
+type Key = (i64, i64, i64);
+
+fn key(p: Point3) -> Option<Key> {
+    let q = |v: f64| {
+        let s = (v * S).round();
+        (s.is_finite() && s.abs() < 9.0e15).then_some(s as i64)
+    };
+    Some((q(p.x)?, q(p.y)?, q(p.z)?))
+}
+
+fn edge_key(a: Key, b: Key) -> (Key, Key) {
+    if a <= b { (a, b) } else { (b, a) }
+}
+
+/// One floor's ring, read for walls.
+pub(super) struct Floor {
+    /// The outer ring, world XY, counter-clockwise from above.
+    pub(super) ring: Vec<Point2>,
+    /// `wall[i]`: a wall stands on the span `ring[i] -> ring[i + 1]`.
+    pub(super) wall: Vec<bool>,
+    pub(super) z: f64,
+    pub(super) top: f64,
+    pub(super) area: f64,
+}
+
+/// The facets in world space with their winding normals and a welded
+/// edge -> facets map (keys in the model's local frame, where the
+/// feature topology welds).
+pub(super) struct Mesh {
+    world: Vec<[Point3; 3]>,
+    normal: Vec<Option<Point3>>,
+    keys: Vec<Option<[Key; 3]>>,
+    edges: HashMap<(Key, Key), Vec<u32>>,
+    /// Facets with three distinct finite corners and a normal.
+    pub(super) usable: usize,
+}
+
+impl Mesh {
+    pub(super) fn new(tris: &[Triangle], loc: &Location) -> Self {
+        let mut m = Mesh {
+            world: Vec::with_capacity(tris.len()),
+            normal: Vec::with_capacity(tris.len()),
+            keys: Vec::with_capacity(tris.len()),
+            edges: HashMap::new(),
+            usable: 0,
+        };
+        for (i, t) in tris.iter().enumerate() {
+            let w = [t.a, t.b, t.c].map(|p| transform_point(p, loc.pos, loc.rot));
+            let ks = match (key(t.a), key(t.b), key(t.c)) {
+                (Some(a), Some(b), Some(c)) if a != b && b != c && a != c => Some([a, b, c]),
+                _ => None,
+            };
+            let n = ks.and_then(|_| unit_normal(&w));
+            if let (Some(ks), Some(_)) = (ks, n) {
+                m.usable += 1;
+                for (a, b) in [(0, 1), (1, 2), (2, 0)] {
+                    m.edges.entry(edge_key(ks[a], ks[b])).or_default().push(i as u32);
+                }
+            }
+            m.world.push(w);
+            m.normal.push(n);
+            m.keys.push(if n.is_some() { ks } else { None });
+        }
+        m
+    }
+
+    /// `face` (index `fi`) read as a floor: level, looking up, with at
+    /// least one wall on its outer ring. None for anything else.
+    pub(super) fn floor_of(&self, f: &Features, fi: usize, face: &Face, outer: &Loop) -> Option<Floor> {
+        let up = face.facets.iter().find_map(|&t| *self.normal.get(t as usize)?)?;
+        if up.z < LEVEL {
+            return None;
+        }
+        // The ring's lattice keys in the local frame, where it welded.
+        let mut keys = Vec::with_capacity(outer.verts.len());
+        for &v in &outer.verts {
+            let p = f.verts.get(v as usize)?;
+            keys.push(key(Point3::new(p[0], p[1], p[2]))?);
+        }
+        if keys.len() < 3 {
+            return None;
+        }
+        // World positions: each ring vertex read off the facet corner
+        // that welds to it, so the placement is the facets' own.
+        let world = self.world_ring(face, &keys)?;
+        let z = world.iter().map(|p| p.z).sum::<f64>() / world.len() as f64;
+        if !z.is_finite() {
+            return None;
+        }
+        let mut pts: Vec<Point2> = world.iter().map(|p| Point2::new(p.x, p.y)).collect();
+        let signed = super::shape::signed_area(&pts);
+        if !signed.is_finite() || signed.abs() < 1e-9 {
+            return None;
+        }
+        if signed < 0.0 {
+            pts.reverse();
+            keys.reverse();
+        }
+        let n = pts.len();
+        let mut wall = Vec::with_capacity(n);
+        let mut seeds = Vec::new();
+        for i in 0..n {
+            let (Some(&ka), Some(&kb), Some(pa), Some(pb)) = (keys.get(i), keys.get((i + 1) % n), pts.get(i), pts.get((i + 1) % n)) else {
+                return None;
+            };
+            let (dx, dy) = (pb.x - pa.x, pb.y - pa.y);
+            let len = dx.hypot(dy);
+            let mut is_wall = false;
+            if len > 0.0 && len.is_finite() {
+                let left = (-dy / len, dx / len);
+                for &t in self.edges.get(&edge_key(ka, kb)).map_or(&[][..], |v| v.as_slice()) {
+                    if f.facet_face.get(t as usize).is_some_and(|&g| g as usize == fi) {
+                        continue;
+                    }
+                    if self.rises_into(t, z, left) {
+                        is_wall = true;
+                        seeds.push(t);
+                    }
+                }
+            }
+            wall.push(is_wall);
+        }
+        if seeds.is_empty() {
+            return None;
+        }
+        let top = self.wall_top(&seeds, z, &pts, f, fi)?;
+        if top - z < MIN_DEPTH {
+            return None;
+        }
+        Some(Floor { ring: pts, wall, z, top, area: face.area })
+    }
+
+    /// The ring's vertices in world space, read off the facet corners
+    /// that weld to them (every ring vertex is a corner of the face).
+    fn world_ring(&self, face: &Face, keys: &[Key]) -> Option<Vec<Point3>> {
+        let mut at: HashMap<Key, Point3> = HashMap::new();
+        for &t in &face.facets {
+            let (Some(Some(ks)), Some(w)) = (self.keys.get(t as usize), self.world.get(t as usize)) else {
+                continue;
+            };
+            for (k, p) in ks.iter().zip(w.iter()) {
+                at.entry(*k).or_insert(*p);
+            }
+        }
+        keys.iter().map(|k| at.get(k).copied()).collect()
+    }
+
+    /// Facet `t` stands on the floor at `z` and leans into it.
+    fn rises_into(&self, t: u32, z: f64, left: (f64, f64)) -> bool {
+        let (Some(Some(n)), Some(w)) = (self.normal.get(t as usize), self.world.get(t as usize)) else {
+            return false;
+        };
+        let cz = (w[0].z + w[1].z + w[2].z) / 3.0;
+        n.z < LEVEL && cz > z + Z_TOL && n.x * left.0 + n.y * left.1 > WALL_LEAN
+    }
+
+    /// How high the walls reach: a flood from the wall facets over every
+    /// facet that is neither level nor below the floor, held near the
+    /// floor's footprint so it cannot wander over the rest of the part.
+    fn wall_top(&self, seeds: &[u32], z: f64, ring: &[Point2], f: &Features, fi: usize) -> Option<f64> {
+        let (mut lo, mut hi) = ((f64::INFINITY, f64::INFINITY), (f64::NEG_INFINITY, f64::NEG_INFINITY));
+        for p in ring {
+            lo = (lo.0.min(p.x), lo.1.min(p.y));
+            hi = (hi.0.max(p.x), hi.1.max(p.y));
+        }
+        let margin = 0.25 * (hi.0 - lo.0).max(hi.1 - lo.1) + 1.0;
+        if !margin.is_finite() {
+            return None;
+        }
+        let near = |w: &[Point3; 3]| {
+            let (cx, cy) = ((w[0].x + w[1].x + w[2].x) / 3.0, (w[0].y + w[1].y + w[2].y) / 3.0);
+            cx >= lo.0 - margin && cx <= hi.0 + margin && cy >= lo.1 - margin && cy <= hi.1 + margin
+        };
+        let mut seen = vec![false; self.world.len()];
+        let mut queue: VecDeque<u32> = VecDeque::new();
+        let mut top = f64::NEG_INFINITY;
+        for &s in seeds {
+            if let Some(v) = seen.get_mut(s as usize)
+                && !*v
+            {
+                *v = true;
+                queue.push_back(s);
+            }
+        }
+        while let Some(t) = queue.pop_front() {
+            let (Some(Some(ks)), Some(w)) = (self.keys.get(t as usize), self.world.get(t as usize)) else {
+                continue;
+            };
+            top = top.max(w[0].z.max(w[1].z).max(w[2].z));
+            for (a, b) in [(0, 1), (1, 2), (2, 0)] {
+                for &g in self.edges.get(&edge_key(ks[a], ks[b])).map_or(&[][..], |v| v.as_slice()) {
+                    let Some(v) = seen.get_mut(g as usize) else { continue };
+                    if *v || f.facet_face.get(g as usize).is_some_and(|&h| h as usize == fi) {
+                        continue;
+                    }
+                    let (Some(Some(n)), Some(gw)) = (self.normal.get(g as usize), self.world.get(g as usize)) else {
+                        continue;
+                    };
+                    let min_z = gw[0].z.min(gw[1].z).min(gw[2].z);
+                    if n.z.abs() < LEVEL && min_z >= z - Z_TOL && near(gw) {
+                        *v = true;
+                        queue.push_back(g);
+                    }
+                }
+            }
+        }
+        top.is_finite().then_some(top)
+    }
+}
+
+fn unit_normal(w: &[Point3; 3]) -> Option<Point3> {
+    let (u, v) = (w[1] - w[0], w[2] - w[0]);
+    let n = Point3::new(u.y * v.z - u.z * v.y, u.z * v.x - u.x * v.z, u.x * v.y - u.y * v.x);
+    let len = (n.x * n.x + n.y * n.y + n.z * n.z).sqrt();
+    (len.is_finite() && len > 1e-12).then(|| Point3::new(n.x / len, n.y / len, n.z / len))
+}
