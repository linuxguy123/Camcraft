+    let mesh = height_field(&[-30.0, -10.0, 30.0], &[-20.0, -5.0, 5.0, 20.0], |i, j| if i == 1 && j == 1 { 10.0 } else { 20.0 });
+    let (world, _h) = world_with(mesh);
