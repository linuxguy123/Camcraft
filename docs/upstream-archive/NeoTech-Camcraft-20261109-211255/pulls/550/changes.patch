+#[test]
+fn degenerate_input_refuses_cleanly() {
+    let (world, _h) = world_with(pocket_block(0.0));
+    assert!(recognize::pockets_of(&world, "ghost").is_err_and(|e| e.contains("no model named")));
+    let nan = Point3::new(f64::NAN, 0.0, 0.0);
