From 8075f1c8ab3eaaef3d5a1eee9648b9cd96664e16 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Wed, 25 Nov 2026 11:28:17 -0800
Subject: [PATCH 1/2] ci(post-merge): skip the gate for docs-only and
 process-only commits

A push whose commit changes only site/, docs/, *.md or .claude/ (against its
first parent) now sets skip=true in the existing yield step with the notice
"no code changed - the previous run covers this code". Markdown under code
directories (crates/, xtask/), assets/, scripts/, build.rs, Cargo files and
.github/ always run the gate; workflow_dispatch always runs. The checkout
fetches two commits so the step can diff against the parent.

Fixes #4054

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 .github/scripts/post-merge-skip.sh      | 31 ++++++++++++-
 .github/scripts/test-post-merge-skip.sh | 58 +++++++++++++++++++++++++
 .github/workflows/post-merge.yml        |  9 +++-
 3 files changed, 94 insertions(+), 4 deletions(-)
 create mode 100644 .github/scripts/test-post-merge-skip.sh

diff --git a/.github/scripts/post-merge-skip.sh b/.github/scripts/post-merge-skip.sh
index 3c883a267..28dc3b4ff 100755
--- a/.github/scripts/post-merge-skip.sh
+++ b/.github/scripts/post-merge-skip.sh
@@ -4,10 +4,37 @@
 # should run. Uses only `gh` read calls (actions: read, pull-requests: read).
 # Provenance: our own AGENTS.md "The cut runner"; GitHub's public gh CLI docs.
 # GH overrides the gh binary (tests use a fake).
+# Docs-only rule (#4054): on a push, a commit whose diff against its first
+# parent touches only docs or process paths changes no code, so the run of the
+# commit before it covers this code. EVENT_NAME=push turns the rule on; a
+# workflow_dispatch (any other value, or none) always runs. A commit with no
+# readable parent (a shallow clone of one commit) runs.
 set -uo pipefail
 gh_bin="${GH:-gh}"
 repo="${REPO:?REPO is required}"
 
+# Exit 0 when every changed file is a docs or process path. Code, Cargo.*,
+# xtask/, assets/, .github/, build.rs and scripts/ are never docs. A *.md file
+# inside crates/ is code too: cli_skill.md is compiled in with include_str!.
+docs_only() {
+  local files f
+  files=$(git diff --name-only --no-renames HEAD^ HEAD 2>/dev/null) || return 1
+  [ -n "$files" ] || return 1
+  while IFS= read -r f; do
+    case "$f" in
+      crates/* | xtask/* | assets/* | .github/* | scripts/* | Cargo.* | build.rs | */build.rs) return 1 ;;
+      site/* | docs/* | .claude/* | *.md) ;;
+      *) return 1 ;;
+    esac
+  done <<<"$files"
+  return 0
+}
+
+if [ "${EVENT_NAME:-}" = push ] && docs_only; then
+  echo "no code changed - the previous run covers this code"
+  exit 0
+fi
+
 running=$("$gh_bin" run list -R "$repo" --workflow cut.yml --status in_progress --limit 5 \
   --json databaseId --jq '.[0].databaseId // empty') || running=""
 if [ -z "$running" ]; then
@@ -15,7 +42,7 @@ if [ -z "$running" ]; then
     --json databaseId --jq '.[0].databaseId // empty') || running=""
 fi
 if [ -n "$running" ]; then
-  echo "a cut.yml run ($running) is using the runner"
+  echo "a cut.yml run ($running) is using the runner; the cut's release gate covers main"
   exit 0
 fi
 
@@ -26,7 +53,7 @@ rel=$("$gh_bin" pr list -R "$repo" --state open --limit 100 \
   --json headRefName,isCrossRepository \
   --jq '[.[] | select((.isCrossRepository | not) and (.headRefName | test("^release/v")))][0].headRefName // empty') || rel=""
 if [ -n "$rel" ]; then
-  echo "release PR branch $rel is open (a cut is in progress)"
+  echo "release PR branch $rel is open (a cut is in progress); the cut's release gate covers main"
   exit 0
 fi
 exit 1
diff --git a/.github/scripts/test-post-merge-skip.sh b/.github/scripts/test-post-merge-skip.sh
new file mode 100644
index 000000000..c26f0e020
--- /dev/null
+++ b/.github/scripts/test-post-merge-skip.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+# Test of post-merge-skip.sh's docs-only rule (#4054): builds a throwaway repo,
+# commits one change set per case, and checks skip (exit 0) or run (exit 1).
+# Usage: bash .github/scripts/test-post-merge-skip.sh   (SCRIPT overrides the script)
+# Provenance: our own AGENTS.md "The post-merge gate".
+set -uo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+script="${SCRIPT:-$here/post-merge-skip.sh}"
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# A fake gh that finds no cut run and no release PR, so only the docs rule decides.
+printf '#!/usr/bin/env bash\nexit 0\n' >"$tmp/gh"
+chmod +x "$tmp/gh"
+
+repo="$tmp/repo"
+git init -q "$repo"
+cd "$repo" || exit 1
+git config user.email t@example.invalid
+git config user.name t
+git config commit.gpgsign false
+echo base >base.txt
+git add . && git commit -qm base
+
+fail=0
+# run_case <name> <event> <expect: skip|run> <file>...
+run_case() {
+  local name=$1 event=$2 expect=$3 f out rc got
+  shift 3
+  for f in "$@"; do
+    mkdir -p "$(dirname "$f")"
+    echo "$name" >>"$f"
+  done
+  git add -A && git commit -qm "$name"
+  out=$(EVENT_NAME=$event GH="$tmp/gh" REPO=o/r bash "$script")
+  rc=$?
+  if [ "$rc" -eq 0 ]; then got=skip; else got=run; fi
+  if [ "$got" = "$expect" ]; then
+    printf 'ok   %-22s %-17s -> %s %s\n' "$name" "$event" "$got" "$out"
+  else
+    printf 'FAIL %-22s %-17s -> %s, want %s\n' "$name" "$event" "$got" "$expect"
+    fail=1
+  fi
+}
+
+run_case docs-only push skip docs/a.txt site/index.html README.md
+run_case claude-only push skip .claude/skills/x/SKILL.md AGENTS.md
+run_case mixed-docs-code push run docs/b.md crates/app/src/lib.rs
+run_case github-change push run .github/workflows/post-merge.yml
+run_case cargo-lock push run Cargo.lock
+run_case xtask-md push run xtask/README.md
+run_case crates-md push run crates/app/src/cli_skill.md
+run_case assets push run assets/ui/icon.png
+run_case scripts push run scripts/gate.sh
+run_case build-rs push run crates/app/build.rs
+run_case unknown-root-file push run Makefile
+run_case docs-only-dispatch workflow_dispatch run docs/c.md
+exit "$fail"
diff --git a/.github/workflows/post-merge.yml b/.github/workflows/post-merge.yml
index 01ee71233..3c612b4d4 100644
--- a/.github/workflows/post-merge.yml
+++ b/.github/workflows/post-merge.yml
@@ -14,6 +14,9 @@
 # (green, with a notice) while a cut.yml run is queued or running or a
 # release/vX.Y.Z PR from this repo is open (.github/scripts/post-merge-skip.sh).
 # The release gate of the cut covers main's state then.
+# A push whose commit changes only docs or process paths (site/, docs/, *.md,
+# .claude/) skips too (#4054): no code changed, the previous run covers it. A
+# dispatch always runs.
 # Reporting: one rolling issue "main is red (post-merge gate)", opened or
 # commented on when red, closed when green (.github/scripts/post-merge-report.sh).
 # A runner stall (#3303: a STALL row, or the step timeout, and no FAIL row)
@@ -62,7 +65,8 @@ jobs:
       - uses: actions/checkout@v4
         with:
           ref: ${{ inputs.ref || github.sha }}
-          fetch-depth: 1
+          # Two commits: the yield step diffs the commit against its parent.
+          fetch-depth: 2
           persist-credentials: false
       - name: Yield to a cut
         id: yield
@@ -70,10 +74,11 @@ jobs:
         env:
           GH_TOKEN: ${{ github.token }}
           REPO: ${{ github.repository }}
+          EVENT_NAME: ${{ github.event_name }}
         run: |
           if reason=$(bash .github/scripts/post-merge-skip.sh); then
             echo "skip=true" >> "$GITHUB_OUTPUT"
-            echo "::notice title=post-merge gate skipped::$reason; the cut's release gate covers main"
+            echo "::notice title=post-merge gate skipped::skipped: $reason"
             echo "Skipped: $reason." >> "$GITHUB_STEP_SUMMARY"
           else
             echo "skip=false" >> "$GITHUB_OUTPUT"

