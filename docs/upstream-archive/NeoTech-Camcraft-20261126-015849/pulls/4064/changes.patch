From 8f75bb9c60f4af3de7e0b1585720bbcc557b6677 Mon Sep 17 00:00:00 2001
From: NeoTech <168627+NeoTech@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:53:09 +0000
Subject: [PATCH] fix(test): wire_post builds again with lead_arc_radius

PR #4002 added the field lead_arc_radius to WireContourOp. The fixture
die_of from PR #4019 does not set it.

Fixes #4058

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/app/tests/wire_post/model_arcs.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/crates/app/tests/wire_post/model_arcs.rs b/crates/app/tests/wire_post/model_arcs.rs
index d844eb79b..314dc6d65 100644
--- a/crates/app/tests/wire_post/model_arcs.rs
+++ b/crates/app/tests/wire_post/model_arcs.rs
@@ -55,6 +55,7 @@ fn die_of(mesh: Mesh) -> World {
         clearance: operation::DEFAULT_CLEARANCE,
         skims: Vec::new(),
         sharp_corners: false,
+        lead_arc_radius: None,
     };
     let c = CreateOperation::new(&world, "Die1", "EDM-W025", SrcRef::Entity("opening".into()), OpParams::WireContour(op)).expect("op");
     h.execute(&world, c);
