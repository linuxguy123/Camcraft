From 197420e88ece287f0aac9261b1be769702c92476 Mon Sep 17 00:00:00 2001
From: NeoTech <168627+NeoTech@users.noreply.github.com>
Date: Wed, 25 Nov 2026 18:12:48 +0000
Subject: [PATCH] fix(mcp): release the ui link owner lock by unlock, not by a
 close

On Unix a flock belongs to the open file. A child that another thread
starts holds a copy of each descriptor until its exec, so a close does
not release the lock in that time. link_owner::owner took a free lock to
prove that a window had ended and released it only by the close. A
fork at that moment left the lock held, and the next check read the
ended window as alive, so the CLI dialed its address. The post-merge
gate of 3bb6647f6 hit this in mcp_live.

owner, Registration::drop and the open error path now unlock before the
close; the tests end a stand-in window with an unlock. The unchanged
mcp_live binary failed in 44 of 150 looped runs; with this change it
passed 200 of 200.

Fixes #4041

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/mcp/link.rs                  | 14 +++++++--
 crates/app/src/mcp/link_owner.rs            | 10 +++++--
 crates/app/tests/mcp_live/ui_link.rs        | 10 +++++++
 crates/app/tests/mcp_live/ui_link_owner.rs  |  6 ++--
 docs/decisions/4041-ui-link-lock-release.md | 33 +++++++++++++++++++++
 5 files changed, 65 insertions(+), 8 deletions(-)
 create mode 100644 docs/decisions/4041-ui-link-lock-release.md

diff --git a/crates/app/src/mcp/link.rs b/crates/app/src/mcp/link.rs
index 1dd8fedaf..bb5faaedd 100644
--- a/crates/app/src/mcp/link.rs
+++ b/crates/app/src/mcp/link.rs
@@ -220,8 +220,8 @@ pub struct Registration {
     entry: Entry,
     lock_file: PathBuf,
     /// Held for the life of the window: the proof that it runs (#3995).
-    /// Dropped after `Drop::drop` removed the files.
-    _lock: std::fs::File,
+    /// Released by `Drop::drop` after it removed the files.
+    lock: std::fs::File,
 }
 
 impl Registration {
@@ -253,6 +253,13 @@ impl Drop for Registration {
                 tracing::warn!("ui link: cannot remove {}: {e}", path.display());
             }
         }
+        // Release the lock now, not at the close of the file (#4041): on
+        // Unix a child that another thread is starting holds a copy of the
+        // descriptor until its exec, and the close alone leaves the lock
+        // held while that copy lives.
+        if let Err(e) = self.lock.unlock() {
+            tracing::warn!("ui link: cannot release {}: {e}", self.lock_file.display());
+        }
     }
 }
 
@@ -271,6 +278,7 @@ pub(crate) fn open(dir: &Path) -> std::io::Result<(Listener, Registration, Strin
     let (listener, transport, address, socket) = match bind(dir, pid) {
         Ok(bound) => bound,
         Err(e) => {
+            let _ = lock.unlock();
             drop(lock);
             let _ = std::fs::remove_file(&lock_file);
             return Err(e);
@@ -287,7 +295,7 @@ pub(crate) fn open(dir: &Path) -> std::io::Result<(Listener, Registration, Strin
     };
     // Built before the write, so a failed write still removes the socket.
     let file = dir.join(format!("{pid}.json"));
-    let registration = Registration { file, socket, entry, lock_file, _lock: lock };
+    let registration = Registration { file, socket, entry, lock_file, lock };
     write_entry(&registration.file, &registration.entry)?;
     Ok((listener, registration, token))
 }
diff --git a/crates/app/src/mcp/link_owner.rs b/crates/app/src/mcp/link_owner.rs
index d747564d8..f53ba82d8 100644
--- a/crates/app/src/mcp/link_owner.rs
+++ b/crates/app/src/mcp/link_owner.rs
@@ -79,8 +79,14 @@ pub fn owner(dir: &Path, pid: u32) -> Owner {
     };
     match file.try_lock() {
         Err(TryLockError::WouldBlock) => Owner::Alive,
-        // The lock goes when `file` drops at the end of this function.
-        Ok(()) => Owner::Gone,
+        // Release the lock at once, never by the close of `file` (#4041):
+        // on Unix a child that another thread starts holds a copy of the
+        // descriptor until its exec, and a lock left held by the close
+        // makes the next test read the ended window as alive.
+        Ok(()) => match file.unlock() {
+            Ok(()) => Owner::Gone,
+            Err(e) => Owner::Unproved(format!("cannot release the lock {}: {e}", path.display())),
+        },
         Err(TryLockError::Error(e)) => Owner::Unproved(format!("cannot test the lock {}: {e}", path.display())),
     }
 }
diff --git a/crates/app/tests/mcp_live/ui_link.rs b/crates/app/tests/mcp_live/ui_link.rs
index a74038441..868f711ca 100644
--- a/crates/app/tests/mcp_live/ui_link.rs
+++ b/crates/app/tests/mcp_live/ui_link.rs
@@ -46,6 +46,16 @@ pub(super) fn hold_lock(dir: &Path, pid: u32) -> std::fs::File {
     file
 }
 
+/// End the window of a [`hold_lock`] file: release its lock at once, as
+/// the OS does when a window process ends (#4041). A plain `drop` is not
+/// enough here: on Unix a `flock` belongs to the open file, and a child
+/// that another test thread is starting holds a copy of each descriptor
+/// until its `exec`. Then the close does not release the lock, and the
+/// CLI still reads the window as alive.
+pub(super) fn release_lock(file: std::fs::File) {
+    file.unlock().expect("release the lock");
+}
+
 pub(super) fn write_entry(dir: &Path, entry: &Entry) {
     let text = serde_json::to_string(entry).expect("entry json");
     std::fs::write(dir.join(format!("{}.json", entry.pid)), text).expect("write entry");
diff --git a/crates/app/tests/mcp_live/ui_link_owner.rs b/crates/app/tests/mcp_live/ui_link_owner.rs
index bd5bd60d0..a135c93ca 100644
--- a/crates/app/tests/mcp_live/ui_link_owner.rs
+++ b/crates/app/tests/mcp_live/ui_link_owner.rs
@@ -3,7 +3,7 @@
 //! file is removed, an unproved one is skipped, and neither is dialed.
 //! Provenance: our own tests over our own link; no HSMWorks material.
 
-use super::ui_link::{cli_ui, fresh_dir, hold_lock, write_entry};
+use super::ui_link::{cli_ui, fresh_dir, hold_lock, release_lock, write_entry};
 use camcraft_app::mcp::link::{self, Entry};
 use camcraft_app::mcp::link_owner::{self, Owner};
 use camcraft_app::mcp::{link_call, LinkError, Select};
@@ -46,7 +46,7 @@ fn a_crashed_windows_file_is_removed_and_its_port_is_never_dialed() {
     let entry = false_entry(4_000_000_001, listener.local_addr().expect("addr"));
     write_entry(&dir, &entry);
     // The lock file of the crashed window: its lock went with its process.
-    drop(hold_lock(&dir, entry.pid));
+    release_lock(hold_lock(&dir, entry.pid));
     assert_eq!(link_owner::owner(&dir, entry.pid), Owner::Gone);
 
     let err = link_call(&dir, &Select::Only, "get_job", &json!({})).expect_err("no window runs");
@@ -99,7 +99,7 @@ fn a_false_server_that_proves_the_token_gets_no_tool_call_when_the_window_has_en
         let nonce = hello["nonce"].as_str().expect("nonce").to_owned();
         // The window ends during the hello; the false server answers with
         // the proof that it computes from the token in the file.
-        drop(lock);
+        release_lock(lock);
         writeln!(stream, "{}", link::hello_ok(&link::token_proof(TOKEN, &nonce, "server"))).expect("answer");
         stream.flush().expect("flush");
         line.clear();
diff --git a/docs/decisions/4041-ui-link-lock-release.md b/docs/decisions/4041-ui-link-lock-release.md
new file mode 100644
index 000000000..c0b92bbc6
--- /dev/null
+++ b/docs/decisions/4041-ui-link-lock-release.md
@@ -0,0 +1,33 @@
+## #4041 - UI link: release the owner lock by unlock, never by a close alone
+
+**Decided.** Each place that releases a UI link owner lock (#3995) calls
+`File::unlock` before the file closes:
+
+- `link_owner::owner`, when it takes a free lock to prove that a window
+  has ended. If the unlock fails, the entry is unproved and not dialed.
+- `Registration::drop`, when a window closes, after it removed its files.
+- `link::open`, when the bind fails after the lock was taken.
+- The tests end a stand-in window with `release_lock` (an unlock), not
+  with `drop`.
+
+**Why.** On Unix, `flock` belongs to the open file, not to the
+descriptor. When a thread starts a child process, the child holds a copy
+of each descriptor until its `exec` closes it. A close during that time
+does not release the lock. Then the next test of the lock reads an ended
+window as alive, and the CLI dials its address. The post-merge gate of
+`3bb6647f6` showed this in `mcp_live`. A loop of the unchanged binary
+failed in 44 of 150 runs. After this change it passed 200 of 200.
+
+**Dropped.**
+
+- A retry or a sleep in the test: it hides the race and keeps the product
+  defect in `owner`.
+- POSIX record locks (`fcntl`), which a child does not inherit: they need
+  `libc` (a new direct dependency) and are not in std.
+
+**Residual.** When a window process crashes while one of its own threads
+is starting a child, the lock stays held until that child runs `exec`.
+This is a short time and the OS ends it. The post-hello test of the lock
+stays in place.
+
+**Cost to change later.** None: the calls are local to the three places.
