+    [
+        t.cube_edge,
+        t.cube_label,
+        t.cube_glyph_on,
+        t.cube_glyph_off,
+        t.viewport_hint,
+        t.marker_stem,
+        t.marker_ring,
+        t.marker_dot,
+        t.axis_x,
+        t.axis_y,
+        t.axis_z,
+        t.viewport_hover,
+    ]
+}
+
+const FURNITURE_KEYS: [&str; 12] = [
+    "cube_edge",
+    "cube_label",
+    "cube_glyph_on",
+    "cube_glyph_off",
+    "viewport_hint",
+    "marker_stem",
+    "marker_ring",
