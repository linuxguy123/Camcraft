From 512d0e7a3ade186e2a337856d08ef88f58c8cfa6 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 16 Nov 2026 08:18:15 +0100
Subject: [PATCH] test(ui): AI chat pump helpers step instead of run to survive
 scroll repaints

The post-merge gate failed on post_confirmation_allow_and_deny_gate_mcp_dispatch:
Harness::run exceeded max_steps (4) in pump_until_idle, because a
scroll-area repaint keeps going on a slow runner. The gate under test is
unchanged. The helpers now call step() in the wait loops.

Fixes #2137

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/tests/ai_chat/mod.rs | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/crates/ui/src/egui_app/tests/ai_chat/mod.rs b/crates/ui/src/egui_app/tests/ai_chat/mod.rs
index e6a93b423..b08606835 100644
--- a/crates/ui/src/egui_app/tests/ai_chat/mod.rs
+++ b/crates/ui/src/egui_app/tests/ai_chat/mod.rs
@@ -65,10 +65,10 @@ pub(super) fn select_provider(h: &mut Harness<'static, ShellUi>, preset_label: &
 pub(super) fn submit_prompt(h: &mut Harness<'static, ShellUi>, text: &str) {
     let input = h.get_by_role_and_label(Role::TextInput, "Prompt");
     input.click();
-    h.run();
+    h.run_steps(2);
     h.get_by_role_and_label(Role::TextInput, "Prompt")
         .type_text(text);
-    h.run();
+    h.run_steps(2);
     h.get_by_role_and_label(Role::Button, "Send").click();
     h.run_steps(2);
 }
@@ -81,7 +81,9 @@ pub(super) fn pump_until_idle(h: &mut Harness<'static, ShellUi>) {
             "AI chat worker timed out still running"
         );
         std::thread::sleep(Duration::from_millis(5));
-        h.run();
+        // One step, not `run()`: a scroll-area animation keeps asking for repaints
+        // and `run()` panics past max_steps (#2137).
+        h.step();
     }
     h.run_steps(2);
 }
@@ -94,7 +96,9 @@ pub(super) fn pump_until_confirm(h: &mut Harness<'static, ShellUi>) {
             "timed out waiting for inline Allow/Deny confirmation prompt"
         );
         std::thread::sleep(Duration::from_millis(5));
-        h.run();
+        // One step, not `run()`: a scroll-area animation keeps asking for repaints
+        // and `run()` panics past max_steps (#2137).
+        h.step();
     }
     h.run_steps(2);
 }
