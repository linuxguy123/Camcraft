From 601332e6f23b37196f877b4c3cda7f96d6d7c768 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 16 Nov 2026 08:33:24 +0100
Subject: [PATCH] fix(ui): add the Waterjet arm to the machine short caption

camcraft-ui did not build on main: short_caption had no arm for
MachineKind::Waterjet (E0004). The arm reads "Waterjet", the name the
tool settings pane uses. A test asserts a caption for each machine
kind.

Changelog: none
Effort: low

Fixes #2143

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/machine_mode_tests.rs | 19 +++++++++++++++++++
 crates/ui/src/machine_modes.rs               |  1 +
 docs/decisions/2143-waterjet-caption.md      | 16 ++++++++++++++++
 3 files changed, 36 insertions(+)
 create mode 100644 docs/decisions/2143-waterjet-caption.md

diff --git a/crates/ui/src/egui_app/machine_mode_tests.rs b/crates/ui/src/egui_app/machine_mode_tests.rs
index 697e7085d..3a91268d2 100644
--- a/crates/ui/src/egui_app/machine_mode_tests.rs
+++ b/crates/ui/src/egui_app/machine_mode_tests.rs
@@ -131,3 +131,22 @@ fn plasma_cutting_mode_shows_the_plasma_profile_and_switching_back_restores_the_
     run(&mut state, CommandKind::Undo);
     assert_eq!(machine::kind_of(&state.world), Kind::Mill, "two undos: back to the mill");
 }
+
+#[test]
+fn every_machine_kind_has_a_short_caption() {
+    let kinds = [
+        Kind::Mill,
+        Kind::Lathe,
+        Kind::MillTurn,
+        Kind::Plasma,
+        Kind::Waterjet,
+        Kind::WireEdm,
+        Kind::SinkerEdm,
+    ];
+    for kind in kinds {
+        let short = machine_modes::short_caption(kind);
+        assert!(!short.is_empty(), "{kind:?} has a short caption");
+        assert!(!machine_modes::caption(kind).is_empty(), "{kind:?} has a caption");
+    }
+    assert_eq!(machine_modes::short_caption(Kind::Waterjet), "Waterjet");
+}
diff --git a/crates/ui/src/machine_modes.rs b/crates/ui/src/machine_modes.rs
index 55d87df60..1d4cc8003 100644
--- a/crates/ui/src/machine_modes.rs
+++ b/crates/ui/src/machine_modes.rs
@@ -47,6 +47,7 @@ pub(crate) fn short_caption(kind: MachineKind) -> &'static str {
         MachineKind::Plasma => "Plasma",
         MachineKind::WireEdm => "Wire",
         MachineKind::SinkerEdm => "Sinker",
+        MachineKind::Waterjet => "Waterjet",
     }
 }
 
diff --git a/docs/decisions/2143-waterjet-caption.md b/docs/decisions/2143-waterjet-caption.md
new file mode 100644
index 000000000..be7f89204
--- /dev/null
+++ b/docs/decisions/2143-waterjet-caption.md
@@ -0,0 +1,16 @@
+## #2143 - Waterjet short caption
+
+**What was decided:** the door's short caption for `Kind::Waterjet` is
+"Waterjet". `short_caption` has one explicit arm per kind and no wildcard.
+
+**Why:** the match is exhaustive, so the missing arm breaks the build of
+`camcraft-ui` on main. The tool settings pane already names the kind
+"Waterjet nozzle", so the word matches the UI.
+
+**Considered and dropped:** a wildcard arm (the issue forbids it). A
+ribbon mode row in `MACHINE_MODES` for Waterjet (no built-in waterjet
+machine ships yet, so no row is due; `caption()` keeps its "Machine"
+fallback until one ships).
+
+**Cost to change later:** one string in `short_caption`, and one assert
+in `every_machine_kind_has_a_short_caption`.
