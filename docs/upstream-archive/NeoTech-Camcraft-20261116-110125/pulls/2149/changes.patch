+    }
+    let upper = atom.rho_max() + m - d;
+    if upper <= allow {
+        return upper;
+    }
+    if hi - lo <= 1e-12 {
+        return rho_expanded(atom, lo, m) - d;
+    }
+    golden_pen(lo, hi, |z| b.slab_dist(z, z, pts) - rho_expanded(atom, z, m))
