+  // Each is written only when the machine file states it.
+  if (flushWord !== "") block([flushWord]);
+  if (tankWord !== "") block([tankWord]);
   block([condition]);
   threaded = true;
   cutZ = has(p.StartZ) ? p.StartZ : null;
