+        // when stated, so a mirror that states neither is main's.
+        if let (Some(e), Some(eo)) = (m.edm.as_ref(), edm.as_object_mut()) {
+            if let Some(t) = e.tank {
+                eo.insert("tank".to_owned(), json!(t.word()));
