From 38fb8543ab556849b31d2124ea0464c95a527dbb Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sun, 15 Nov 2026 19:08:14 -0800
Subject: [PATCH] fix(ui): remove dead MIN_LABEL_PX, name the theme label floor

Fixes #2104

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/ui/src/egui_app/painted.rs   |  5 +----
 docs/decisions/2104-min-label-px.md | 11 +++++++++++
 2 files changed, 12 insertions(+), 4 deletions(-)
 create mode 100644 docs/decisions/2104-min-label-px.md

diff --git a/crates/ui/src/egui_app/painted.rs b/crates/ui/src/egui_app/painted.rs
index e6d545983..94ba28ddc 100644
--- a/crates/ui/src/egui_app/painted.rs
+++ b/crates/ui/src/egui_app/painted.rs
@@ -95,7 +95,7 @@ pub fn cell(
         painter.image(tex.id(), r, UV_FULL, tint);
     }
     let ink = if enabled { pal.text } else { pal.text_faint };
-    // The label shrinks to fit its cell (down to MIN_LABEL_PX) so a short
+    // The label shrinks to fit its cell (down to the theme's font_label_min) so a short
     // word reads whole at the narrow 1280 px cell (#948); only a label
     // that still does not fit at the floor truncates with an ellipsis, so
     // it can never collide with the neighbour's.
@@ -111,9 +111,6 @@ pub fn cell(
     resp
 }
 
-/// The smallest default ribbon caption/label size (px); below it a label elides instead.
-pub const MIN_LABEL_PX: f32 = 10.0;
-
 /// Lay `label` out on one line at the largest whole size from `start_px`
 /// down to `min_px` whose width fits `max_w`; at the floor it truncates
 /// with an ellipsis (never overflows).
diff --git a/docs/decisions/2104-min-label-px.md b/docs/decisions/2104-min-label-px.md
new file mode 100644
index 000000000..a1afc4c1a
--- /dev/null
+++ b/docs/decisions/2104-min-label-px.md
@@ -0,0 +1,11 @@
+# #2104 - remove dead MIN_LABEL_PX
+
+Decision (unattended, effort:low): delete `MIN_LABEL_PX` from `crates/ui/src/egui_app/painted.rs`
+and point the `fit_label` comment at the theme token `pal.font_label_min`.
+
+Considered: keep the constant as the clamp floor. Dropped: the floor already comes from
+`pal.font_label_min` (clamped by `clamp::FONT`), so a second hard-coded 10.0 would be a
+duplicate source of truth that the theme cannot override. No `#[allow(dead_code)]`.
+
+Pinned by: `cargo clippy -p camcraft-ui --all-targets -- -D warnings` (clean), and the
+existing ribbon caption/theme suites in the quick gate.
