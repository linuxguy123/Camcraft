diff --git a/crates/app/src/sketch.rs b/crates/app/src/sketch.rs
new file mode 100644
index 000000000..ebef5e7ef
--- /dev/null
+++ b/crates/app/src/sketch.rs
@@ -0,0 +1,138 @@
+//! DXF profiles in the document (#1862): the `Sketch` entities, which
+//! setup each belongs to, and where each lies on its setup's stock.
+//!
+//! Provenance: our own design, from the maintainer's words on issue 1862
+//! ("A DXF should be possible to place on a stock and used as references
+//! for cutting - not be treated like a model"). The transform algebra is
+//! standard rigid-body math. No vendor material consulted.
+//!
+//! ## The laws here
+//!
+//! - **A profile is not a model.** It has no facets, `model::is_model` is
+//!   false for it, and the part readers (`model::model_entities`) never
+//!   list it.
+//! - **A profile belongs to one setup** and lies on the top face of that
+//!   setup's stock. Its `Location` is relative to that face, at the stock
+//!   origin ([`face_frame`]): Z is 0 and the turn is about the face
+//!   normal only ([`on_face`], [`face_placement`]). The stock is setup
+//!   furniture, so the profile rides the stock when the stock moves, and
+//!   a setup's part alignment does not move it.
+//! - **No stock, no place.** A profile whose setup has no stock has no
+//!   world placement ([`world_pose`] is `None`); nothing guesses one.
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::{Entity, World};
+
+use crate::geometry::{IDENTITY_Q, Point3};
+use crate::model;
+use crate::schema::{Location, Sketch};
+use crate::setup_align::compose;
+use crate::stock::StockShape;
+
+/// The largest X or Y a profile can be moved to on its face, mm.
+pub const MAX_OFFSET: f64 = 1.0e6;
+
+#[must_use]
+pub fn is_sketch(world: &World, entity: &Entity) -> bool {
+    entity.entity_view(world).try_get::<&Sketch>(|_| ()).is_some()
+}
+
+#[must_use]
+pub fn sketch_of(world: &World, entity: &Entity) -> Option<Sketch> {
+    entity.entity_view(world).try_get::<&Sketch>(Clone::clone)
+}
+
+/// The profile with this name, when the name wears one.
+#[must_use]
+pub fn find(world: &World, name: &str) -> Option<(Entity, Sketch)> {
+    let entity = model::find_by_name(world, name)?;
+    sketch_of(world, &entity).map(|sketch| (entity, sketch))
+}
+
+/// Every profile of the document, name-sorted.
+#[must_use]
+pub fn sketches(world: &World) -> Vec<(String, Entity)> {
+    model::named_entities(world).into_iter().filter(|(_, e)| is_sketch(world, e)).collect()
+}
+
+/// The profiles placed in a declared setup context, name-sorted. `None`
+/// and the first setup mean the same thing (the implicit-setup law).
+#[must_use]
+pub fn placed_in(world: &World, declared: Option<&str>) -> Vec<String> {
+    let target = crate::setup::effective(world, declared);
+    sketches(world)
+        .into_iter()
+        .filter(|(_, e)| {
+            sketch_of(world, e).is_some_and(|s| crate::setup::effective(world, s.setup.as_deref()) == target)
+        })
+        .map(|(name, _)| name)
+        .collect()
+}
+
+/// The top of a stock in its own frame: the box height, the cylinder
+/// height, or the highest finite facet Z of a stock copied from a model.
+fn stock_top(world: &World, stock: &Entity) -> Option<f64> {
+    match model::stock_def_of(world, stock)? {
+        StockShape::Box { dz, .. } => dz.is_finite().then_some(dz),
+        StockShape::Cylinder { height, .. } => height.is_finite().then_some(height),
+        StockShape::FromModel { .. } => model::facets_of(world, stock)?
+            .iter()
+            .flat_map(|t| [t.a.z, t.b.z, t.c.z])
+            .filter(|z| z.is_finite())
+            .reduce(f64::max),
+    }
+}
+
+/// The frame profiles of a setup are placed in: the top face of the
+/// setup's stock, at the stock origin, turned with the stock. `None`
+/// when the setup has no stock.
+#[must_use]
+pub fn face_frame(world: &World, declared: Option<&str>) -> Option<Location> {
+    let stock = crate::setup::stock_entity(world, declared)?;
+    let top = stock_top(world, &stock)?;
+    let at = model::transform_of(world, &stock).unwrap_or_default();
+    Some(compose(at, Location { pos: Point3::new(0.0, 0.0, top), rot: IDENTITY_Q }))
+}
+
+/// Where a profile lies in its setup's frame: its face placement on the
+/// stock's top face. `None` for an entity that is no profile, and for a
+/// profile whose setup has no stock.
+#[must_use]
+pub fn world_pose(world: &World, entity: &Entity) -> Option<Location> {
+    let sketch = sketch_of(world, entity)?;
+    let face = face_frame(world, sketch.setup.as_deref())?;
+    Some(compose(face, model::transform_of(world, entity).unwrap_or_default()))
+}
+
+/// A face placement: `x`, `y` on the face in mm and a turn of
+/// `angle_deg` about the face normal, counterclockwise seen from above.
+#[must_use]
+pub fn on_face(x: f64, y: f64, angle_deg: f64) -> Location {
+    let half = angle_deg.to_radians() / 2.0;
+    Location { pos: Point3::new(x, y, 0.0), rot: [0.0, 0.0, half.sin(), half.cos()] }
+}
+
+/// A `Location` read as a face placement (`x`, `y`, angle in degrees,
+/// -180 to 180); `None` when it leaves the face (a Z offset or a tilt),
+/// is not finite or is out of range. The project loader's test.
+#[must_use]
+pub fn face_placement(at: Location) -> Option<(f64, f64, f64)> {
+    let [qx, qy, qz, qw] = at.rot;
+    let finite = at.pos.is_finite() && at.rot.iter().all(|v| v.is_finite());
+    let unit = ((qx * qx + qy * qy + qz * qz + qw * qw).sqrt() - 1.0).abs() <= 1e-9;
+    let flat = at.pos.z.abs() <= 1e-9 && qx.abs() <= 1e-9 && qy.abs() <= 1e-9;
+    let near = at.pos.x.abs() <= MAX_OFFSET && at.pos.y.abs() <= MAX_OFFSET;
+    // The angle is read back to a billionth of a degree, so a turn of 90
+    // reads 90 and a move that keeps the angle writes the same rotation.
+    let angle = ((2.0 * qz.atan2(qw)).to_degrees() * 1e9).round() / 1e9;
+    (finite && unit && flat && near).then_some((at.pos.x, at.pos.y, angle))
+}
+
+/// A free entity name for a profile: `stem`, else `stem (2)`, `stem (3)`
+/// and so on. `None` when 10,000 candidates are all taken.
+#[must_use]
+pub fn free_name(world: &World, stem: &str) -> Option<String> {
+    std::iter::once(stem.to_owned())
+        .chain((2..10_000).map(|n| format!("{stem} ({n})")))
+        .find(|name| model::find_by_name(world, name).is_none())
+}
diff --git a/crates/app/src/sketch_model.rs b/crates/app/src/sketch_model.rs
new file mode 100644
index 000000000..e8b190ee3
--- /dev/null
+++ b/crates/app/src/sketch_model.rs
@@ -0,0 +1,157 @@
+//! The virtual model reference of a setup (#1862): what stands in for a
+//! model when a setup has a stock and a placed DXF profile and no model.
+//!
+//! Provenance: our own design, from the maintainer's words on issue 1862
+//! ("a virtual model reference, just so the operations pages gets happy
+//! about a model being loaded"). `docs/decisions/1862-sketch-profile.md`
+//! records it. No vendor material consulted.
+//!
+//! ## The laws here
+//!
+//! - **Derived, never stored.** The reference is read from the world
+//!   ([`of`]): the setup has one or more placed profiles and the document
+//!   has no part. No component and no file key holds it, so it cannot
+//!   disagree with what the document holds.
+//! - **No facets.** The reference names profiles, and a profile has no
+//!   mesh. No 3D solid tool reads it.
+//! - **A profile is a source for the 2D cut kinds only** ([`admits`]): the
+//!   2D milling, plasma and wire EDM sections. Every other kind needs a
+//!   solid model and refuses a profile by name ([`source_problem`]).
+//! - **A 3D operation refuses a virtual reference by name.** A 3D or
+//!   multi-axis milling kind in a setup whose model is virtual has no
+//!   solid to cut to.
+//! - **Nothing passes silently.** An operation on a profile states what
+//!   it is checked against ([`checked_against`]): the stock and the
+//!   profile's chains. This build does not yet make a toolpath from the
+//!   chains, so generation refuses by name ([`generation_problem`]) and
+//!   no check can pass for want of a solid.
+
+use flecs_ecs::prelude::World;
+
+use crate::operation::{OpParams, Section, SrcRef};
+use crate::schema::Operation;
+use crate::sketch;
+
+/// Why a Top of Model or Bottom of Model height has no value in a setup
+/// whose model is virtual (`operation::missing_source`).
+pub const NO_SOLID_HEIGHT: &str =
+    "the model is a DXF profile, a virtual model reference with no solid - measure this height from the stock, or fix it";
+
+/// The virtual model reference of a setup: the profiles that stand in
+/// for its model.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VirtualModel {
+    /// The effective setup (`None` in a document without setups).
+    pub setup: Option<String>,
+    /// The placed profiles, name-sorted; never empty.
+    pub profiles: Vec<String>,
+}
+
+/// Does the document hold a part: a model that is not a fixture?
+#[must_use]
+pub fn has_part(world: &World) -> bool {
+    crate::model::model_entities(world).iter().any(|(_, e)| !crate::model::is_fixture(world, e))
+}
+
+/// The setup's virtual model reference: `Some` when the setup has one or
+/// more placed profiles and the document has no part.
+#[must_use]
+pub fn of(world: &World, declared: Option<&str>) -> Option<VirtualModel> {
+    let profiles = sketch::placed_in(world, declared);
+    (!profiles.is_empty() && !has_part(world))
+        .then(|| VirtualModel { setup: crate::setup::effective(world, declared), profiles })
+}
+
+/// Does a setup have a model for the operation pages: a part, or the
+/// virtual reference?
+#[must_use]
+pub fn model_loaded(world: &World, declared: Option<&str>) -> bool {
+    has_part(world) || of(world, declared).is_some()
+}
+
+/// Can this kind take a profile as its source? The 2D cut kinds only.
+#[must_use]
+pub fn admits(params: &OpParams) -> bool {
+    matches!(params.kind().info().section, Section::Mill2D | Section::Plasma | Section::WireEdm)
+}
+
+/// Does this kind cut to a solid model's surface in 3D?
+fn cuts_a_solid(params: &OpParams) -> bool {
+    matches!(params.kind().info().section, Section::Mill3D | Section::MultiAxis)
+}
+
+/// The profiles a source names: a whole profile, or picks on one.
+#[must_use]
+pub fn source_profiles(world: &World, src: &SrcRef) -> Vec<String> {
+    let names: Vec<&str> = match src {
+        SrcRef::Stock => Vec::new(),
+        SrcRef::Entity(name) => vec![name.as_str()],
+        SrcRef::Selection(items) => items.iter().map(|g| g.entity.as_str()).collect(),
+    };
+    let mut out: Vec<String> = names.into_iter().filter(|n| sketch::find(world, n).is_some()).map(str::to_owned).collect();
+    out.dedup();
+    out
+}
+
+/// Why this operation cannot stand on this source, by name; `None` when
+/// the profile law has nothing against it. The command doors and the
+/// generation door read this one function.
+#[must_use]
+pub fn source_problem(world: &World, declared: Option<&str>, src: &SrcRef, params: &OpParams) -> Option<String> {
+    let kind = params.kind();
+    for name in source_profiles(world, src) {
+        if matches!(src, SrcRef::Selection(_)) {
+            return Some(format!(
+                "'{name}' is a DXF profile - an operation takes the whole profile as its source; picked chains of a profile are not supported yet"
+            ));
+        }
+        if !admits(params) {
+            return Some(format!(
+                "a {kind} operation needs a solid model - '{name}' is a DXF profile, a virtual model reference with no solid"
+            ));
+        }
+        let home = sketch::find(world, &name).and_then(|(_, s)| crate::setup::effective(world, s.setup.as_deref()));
+        if home != crate::setup::effective(world, declared) {
+            return Some(format!(
+                "'{name}' is a DXF profile on the stock of {} - an operation cuts the profiles of its own setup only",
+                home.map_or_else(|| "another setup".to_owned(), |s| format!("setup '{s}'"))
+            ));
+        }
+    }
+    if cuts_a_solid(params)
+        && let Some(v) = of(world, declared)
+    {
+        return Some(format!(
+            "a {kind} operation needs a solid model - the setup has only its stock and the DXF profile '{}', a virtual model reference with no solid",
+            v.profiles.first().map_or("", String::as_str)
+        ));
+    }
+    None
+}
+
+/// What an operation on a profile is checked against, as one sentence;
+/// `None` for an operation whose source is not a profile.
+#[must_use]
+pub fn checked_against(world: &World, op: &Operation) -> Option<String> {
+    let SrcRef::Entity(name) = &op.src else { return None };
+    let (_, profile) = sketch::find(world, name)?;
+    let chains = profile.data.chains();
+    Some(format!(
+        "checked against the stock '{}' and the chains of the DXF profile '{name}' ({} closed, {} open) - there is no solid model",
+        crate::setup::stock_entity_name(world, op.setup.as_deref()),
+        chains.closed.len(),
+        chains.open.len(),
+    ))
+}
+
+/// The generation door: an operation the profile law refuses, or one on
+/// a profile (this build makes no toolpath from profile chains yet), is
+/// refused by name. `None` for every other operation.
+#[must_use]
+pub fn generation_problem(world: &World, op: &Operation) -> Option<String> {
+    if let Some(why) = source_problem(world, op.setup.as_deref(), &op.src, &op.params) {
+        return Some(why);
+    }
+    checked_against(world, op)
+        .map(|what| format!("this operation is {what}; a toolpath from the chains of a DXF profile is not generated yet"))
+}
diff --git a/crates/app/tests/mcp_dxf.rs b/crates/app/tests/mcp_dxf.rs
new file mode 100644
index 000000000..419f149d8
--- /dev/null
+++ b/crates/app/tests/mcp_dxf.rs
@@ -0,0 +1,200 @@
+//! #1862 end to end over the MCP tools and the script verb: a setup with
+//! only a stock takes a DXF profile headlessly (`import_dxf`), the reply
+//! and `get_job` state the units and the skipped counts, a file with no
+//! units is refused by name until `units` is given, the profile moves on
+//! its stock face (`move_dxf_profile`), undo and redo work, a 2D
+//! operation on the profile is accepted and a 3D one is refused by name,
+//! and the document saves and reopens.
+//!
+//! Provenance: our own tests over our own tools; the DXF text is
+//! hand-built from Autodesk's public ASCII DXF group conventions.
+//!
+//! Gate map (M4.4): covers app::mcp (sketch_tools, job get_job, tools),
+//! app::script (dxf importDxf), app::commands (ImportDxf, MoveSketch),
+//! app::project (sketch_dto), app::sketch_model.
+
+use camcraft_app::mcp::Server;
+use camcraft_app::script;
+
+use serde_json::{json, Value};
+use std::path::{Path, PathBuf};
+
+fn tmp_dir(tag: &str) -> PathBuf {
+    let mut p = std::env::temp_dir();
+    p.push(format!("camcraft-mcp-dxf-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&p);
+    std::fs::create_dir_all(&p).expect("temp dir");
+    p
+}
+
+/// A 4 x 2 rectangle, a circle, a loose line and two skipped entities.
+fn write_dxf(dir: &Path, file: &str, insunits: Option<i32>) -> String {
+    let header = insunits.map_or(String::new(), |code| format!("9\n$INSUNITS\n70\n{code}\n"));
+    let text = format!(
+        "0\nSECTION\n2\nHEADER\n{header}0\nENDSEC\n0\nSECTION\n2\nENTITIES\n\
+         0\nLWPOLYLINE\n8\ncut\n90\n4\n70\n1\n10\n0\n20\n0\n10\n4\n20\n0\n10\n4\n20\n2\n10\n0\n20\n2\n\
+         0\nCIRCLE\n8\nholes\n10\n1\n20\n1\n40\n0.25\n\
+         0\nLINE\n8\nmarks\n10\n2\n20\n0.5\n11\n3\n21\n0.5\n\
+         0\nTEXT\n8\nnotes\n10\n0\n20\n0\n40\n0.1\n1\nhello\n\
+         0\nTEXT\n8\nnotes\n10\n0\n20\n1\n40\n0.1\n1\nagain\n\
+         0\nENDSEC\n0\nEOF\n"
+    );
+    let path = dir.join(file);
+    std::fs::write(&path, text).expect("write dxf");
+    path.display().to_string()
+}
+
+struct Client {
+    server: Server,
+    next: i64,
+}
+
+impl Client {
+    fn call(&mut self, name: &str, args: Value) -> (bool, Value) {
+        let id = self.next;
+        self.next += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": "tools/call", "params": { "name": name, "arguments": args } });
+        let reply = self.server.handle(&msg).expect("a request gets a response");
+        let result = &reply["result"];
+        let is_err = result["isError"] == json!(true);
+        let body = if is_err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() };
+        (is_err, body)
+    }
+
+    fn ok(&mut self, name: &str, args: Value) -> Value {
+        let (err, body) = self.call(name, args);
+        assert!(!err, "{name} refused: {body}");
+        body
+    }
+
+    fn refused(&mut self, name: &str, args: Value) -> String {
+        let (err, body) = self.call(name, args);
+        assert!(err, "{name} should have refused, got {body}");
+        body.as_str().unwrap_or_default().to_owned()
+    }
+}
+
+/// A document with a sheet stock and a tool, and no model.
+fn sheet_client() -> Client {
+    let mut c = Client { server: Server::new(), next: 1 };
+    c.ok("set_stock", json!({ "box": { "dx": 300.0, "dy": 200.0, "dz": 6.0 } }));
+    c.ok("add_tool", json!({ "catalog": "EM-0400-2FL" }));
+    c
+}
+
+#[test]
+fn import_dxf_places_a_profile_and_states_units_and_skipped_counts() {
+    let dir = tmp_dir("import");
+    let mut c = sheet_client();
+
+    // No stock, no place: a fresh document refuses and says what to do first.
+    let mut bare = Client { server: Server::new(), next: 1 };
+    let why = bare.refused("import_dxf", json!({ "path": write_dxf(&dir, "bare.dxf", Some(4)) }));
+    assert!(why.starts_with("import_dxf:") && why.contains("has no stock - make a stock first"), "{why}");
+
+    // A file with no units is refused by name, never guessed.
+    let unitless = write_dxf(&dir, "plate.dxf", None);
+    let why = c.refused("import_dxf", json!({ "path": unitless }));
+    assert!(why.contains("states no units") && why.contains("\"mm\" or \"in\""), "{why}");
+    assert!(why.contains("4 x 2 drawing units"), "the extents, for the caller to judge: {why}");
+    assert_eq!(c.ok("get_job", json!({}))["profiles"], json!([]), "nothing landed");
+    let why = c.refused("import_dxf", json!({ "path": unitless, "units": "furlongs" }));
+    assert!(why.contains("\"units\" must be \"mm\" or \"in\""), "{why}");
+
+    // With the unit stated it lands on the stock top, and the reply says what was read.
+    let r = c.ok("import_dxf", json!({ "path": unitless, "units": "in" }));
+    assert_eq!(r["profile"], json!("plate"));
+    assert_eq!(r["units"], json!({ "stated": null, "used": "in", "from": "caller", "mm_per_unit": 25.4 }));
+    assert_eq!(r["skipped"], json!({ "TEXT": 2 }));
+    assert_eq!(r["skipped_total"], json!(2));
+    assert_eq!(r["chains"], json!({ "closed": 2, "open": 1, "rejected": 0 }));
+    assert_eq!(r["layers"], json!(["cut", "holes", "marks"]));
+    assert_eq!(r["bounds"]["max"], json!([101.6, 50.8]), "inches read as millimetres");
+    assert_eq!(r["placement"], json!({ "x": 0.0, "y": 0.0, "angle": 0.0 }));
+    assert_eq!(r["origin"], json!([0.0, 0.0, 6.0]), "the top face of the 6 mm sheet, at the stock origin");
+    let summary = r["summary"].as_str().expect("summary");
+    assert!(summary.contains("read in in") && summary.contains("2 entities skipped"), "{summary}");
+
+    // A file that states its unit needs no answer; the same stem gets its own name.
+    let r2 = c.ok("import_dxf", json!({ "path": write_dxf(&dir, "plate.dxf", Some(4)), "join_tol": 0.05 }));
+    assert_eq!(r2["profile"], json!("plate (2)"));
+    assert_eq!(r2["units"]["stated"], json!("mm"));
+    assert_eq!(r2["units"]["from"], json!("file"));
+    assert_eq!(r2["join_tol"], json!(0.05));
+
+    // get_job: the profiles are listed apart from the models, and the setup's model is virtual.
+    let job = c.ok("get_job", json!({}));
+    assert_eq!(job["models"], json!([]), "a profile is not a model");
+    let names: Vec<&str> = job["profiles"].as_array().expect("profiles").iter().filter_map(|p| p["profile"].as_str()).collect();
+    assert_eq!(names, ["plate", "plate (2)"]);
+    assert_eq!(job["profiles"][0]["units"]["used"], json!("in"));
+    assert_eq!(job["profiles"][0]["skipped"], json!({ "TEXT": 2 }));
+    assert_eq!(job["setups"][0]["model_reference"], json!({ "kind": "virtual", "profiles": ["plate", "plate (2)"], "solid": false }));
+
+    // Undo removes the second profile; redo puts it back.
+    c.ok("undo", json!({}));
+    assert_eq!(c.ok("get_job", json!({}))["profiles"].as_array().map(Vec::len), Some(1));
+    c.ok("redo", json!({}));
+    assert_eq!(c.ok("get_job", json!({}))["profiles"].as_array().map(Vec::len), Some(2));
+}
+
+#[test]
+fn a_profile_moves_on_the_stock_and_takes_a_2d_operation_but_no_3d_one() {
+    let dir = tmp_dir("ops");
+    let mut c = sheet_client();
+    c.ok("import_dxf", json!({ "path": write_dxf(&dir, "plate.dxf", Some(4)) }));
+
+    // The move on the stock face; the angle is kept when it is not given.
+    let r = c.ok("move_dxf_profile", json!({ "name": "plate", "position": [25.0, -10.0], "angle": 90.0 }));
+    assert_eq!(r["placement"], json!({ "x": 25.0, "y": -10.0, "angle": 90.0 }));
+    assert_eq!(r["origin"], json!([25.0, -10.0, 6.0]), "still on the stock top");
+    let r = c.ok("move_dxf_profile", json!({ "name": "plate", "position": [5.0, 5.0] }));
+    assert_eq!(r["placement"], json!({ "x": 5.0, "y": 5.0, "angle": 90.0 }));
+    c.ok("undo", json!({}));
+    assert_eq!(c.ok("get_job", json!({}))["profiles"][0]["placement"], json!({ "x": 25.0, "y": -10.0, "angle": 90.0 }));
+    let why = c.refused("move_dxf_profile", json!({ "name": "Stock", "position": [0.0, 0.0] }));
+    assert!(why.contains("'Stock' is not a DXF profile"), "{why}");
+    let why = c.refused("move_model", json!({ "name": "plate", "position": [0.0, 0.0, 0.0] }));
+    assert!(why.contains("'plate' is a DXF profile"), "{why}");
+
+    // A 2D operation on the profile is accepted and says what it is checked against.
+    c.ok("add_operation", json!({ "kind": "2D Contour", "tool": "EM-0400-2FL", "source": "plate", "name": "Cut" }));
+    let job = c.ok("get_job", json!({}));
+    let checks = job["operations"][0]["checks_against"].as_str().expect("an operation on a profile states its checks");
+    assert!(checks.contains("the stock 'Stock'") && checks.contains("the chains of the DXF profile 'plate'"), "{checks}");
+    assert!(checks.contains("no solid model"), "{checks}");
+
+    // A 3D operation in the setup, and a solid kind on the profile, are refused by name.
+    let why = c.refused("add_operation", json!({ "kind": "3D Finish", "tool": "EM-0400-2FL", "name": "Finish" }));
+    assert!(why.contains("a 3D Finish operation needs a solid model"), "{why}");
+    assert!(why.contains("virtual model reference with no solid"), "{why}");
+    let why = c.refused("add_operation", json!({ "kind": "Drill", "tool": "EM-0400-2FL", "source": "plate", "name": "Holes" }));
+    assert!(why.contains("a Drill operation needs a solid model - 'plate' is a DXF profile"), "{why}");
+
+    // Nothing is cut for want of a solid: generation refuses by name, and the post gate holds.
+    let why = c.refused("generate", json!({ "name": "Cut" }));
+    assert!(why.contains("checked against the stock 'Stock'") && why.contains("is not generated yet"), "{why}");
+    let report = c.ok("verify", json!({}));
+    assert_eq!(report["ok"], json!(false), "an operation with no toolpath never passes the post gate");
+
+    // The setup with only a stock and a profile saves and reopens.
+    let file = dir.join("sheet.camproj").display().to_string();
+    c.ok("save_project", json!({ "path": file }));
+    let mut again = Client { server: Server::new(), next: 1 };
+    again.ok("open_project", json!({ "path": file }));
+    let job2 = again.ok("get_job", json!({}));
+    assert_eq!(job2["profiles"], job["profiles"]);
+    assert_eq!(job2["operations"][0]["source"], job["operations"][0]["source"]);
+    assert_eq!(job2["setups"][0]["model_reference"]["kind"], json!("virtual"));
+
+    // The script verb takes the same arguments and gives the same refusal.
+    let unitless = write_dxf(&dir, "loose.dxf", None);
+    let run = |body: &str| script::run(&format!("cam.load({file:?}); {body}"));
+    let out = run(&format!("cam.importDxf({unitless:?}, {{ units: \"mm\", name: \"loose\" }}).units.used"));
+    assert!(out.ok, "{:?}", out.errors);
+    assert_eq!(out.result, json!("mm"));
+    let out = run(&format!("var why = \"\"; try {{ cam.importDxf({unitless:?}) }} catch (e) {{ why = String(e.message) }} why"));
+    assert!(out.result.as_str().is_some_and(|w| w.contains("states no units")), "{:?} {:?}", out.result, out.errors);
+    let out = run(&format!("cam.importDxf({unitless:?}, {{ unit: \"mm\" }})"));
+    assert!(!out.ok && out.errors.iter().any(|e| e.contains("unknown option \"unit\"")), "{:?}", out.errors);
+}
diff --git a/crates/app/tests/sketch_profile.rs b/crates/app/tests/sketch_profile.rs
new file mode 100644
index 000000000..5c6f539f1
--- /dev/null
+++ b/crates/app/tests/sketch_profile.rs
@@ -0,0 +1,374 @@
+//! #1862: a DXF drawing is a profile placed on the stock of a setup - not
+//! a model. Pins: the placement on the stock top, the move on the stock,
+//! undo and redo, the typed missing-units error, the virtual model
+//! reference with its two refusals (a 3D operation in the setup, and a
+//! kind that needs a solid on the profile), the generation refusal, the
+//! delete, and that deleting the entity frees its drawing.
+//!
+//! Provenance: our own tests over our own commands; the DXF text is
+//! hand-built from Autodesk's public ASCII DXF group conventions.
+//!
+//! Gate map (M4.4): covers app::commands (ImportDxf, MoveSketch,
+//! DeleteEntity, SelectEntity, DeleteSetup, MoveModel, CreateOperation,
+//! ChangeOperationKind, SetOperationSetup, GenerateOperation),
+//! app::sketch, app::sketch_model, app::schema (Sketch), app::model,
+//! app::operation (heights), geometry::sketch_data.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    AddTool, ChangeOperationKind, Command, CommandError, CreateOperation, CreateSetup, DeleteEntity, DeleteSetup,
+    DxfOptions, GenerateOperation, History, ImportDxf, ImportModel, MoveModel, MoveSketch, SelectEntity, SetOperationSetup,
+    SetStock,
+};
+use camcraft_app::geometry::{cube, transform_point, IDENTITY_Q, Point3};
+use camcraft_app::model;
+use camcraft_app::operation::{self, FeatureSel, GeoSel, HeightReference, OpType, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::units::Unit;
+use camcraft_app::world::new_world;
+use camcraft_app::{sketch, sketch_model};
+
+const TOOL: &str = "EM-0400-2FL";
+
+fn tmp_dir(tag: &str) -> PathBuf {
+    let mut p = std::env::temp_dir();
+    p.push(format!("camcraft-sketch-profile-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&p);
+    std::fs::create_dir_all(&p).expect("temp dir");
+    p
+}
+
+/// A 100 x 50 rectangle and a circle (closed), one loose line (open) and
+/// one TEXT (skipped). `insunits`: the header's `$INSUNITS`, or none.
+fn dxf_text(insunits: Option<i32>) -> String {
+    let header = insunits.map_or(String::new(), |code| format!("9\n$INSUNITS\n70\n{code}\n"));
+    format!(
+        "0\nSECTION\n2\nHEADER\n{header}0\nENDSEC\n0\nSECTION\n2\nENTITIES\n\
+         0\nLWPOLYLINE\n8\ncut\n90\n4\n70\n1\n10\n0\n20\n0\n10\n100\n20\n0\n10\n100\n20\n50\n10\n0\n20\n50\n\
+         0\nCIRCLE\n8\nholes\n10\n20\n20\n25\n40\n5\n\
+         0\nLINE\n8\nmarks\n10\n60\n20\n10\n11\n80\n21\n10\n\
+         0\nTEXT\n8\nnotes\n10\n0\n20\n0\n40\n3\n1\nhello\n\
+         0\nENDSEC\n0\nEOF\n"
+    )
+}
+
+fn write_dxf(dir: &Path, file: &str, insunits: Option<i32>) -> PathBuf {
+    let path = dir.join(file);
+    std::fs::write(&path, dxf_text(insunits)).expect("write dxf");
+    path
+}
+
+fn run(world: &World, history: &mut History, cmd: Result<impl Command + 'static, CommandError>, what: &str) {
+    history.execute(world, cmd.unwrap_or_else(|e| panic!("{what}: {e}")));
+}
+
+fn refusal<T>(r: Result<T, CommandError>, what: &str) -> String {
+    match r {
+        Ok(_) => panic!("{what} should have been refused"),
+        Err(e) => e.to_string(),
+    }
+}
+
+/// A 200 x 120 x 6 sheet as the stock, its origin at (10, 20, 5), and a
+/// flat end mill. No model.
+fn sheet_world() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    let shape = StockShape::Box { dx: 200.0, dy: 120.0, dz: 6.0 };
+    let at = Location { pos: Point3::new(10.0, 20.0, 5.0), rot: IDENTITY_Q };
+    run(&world, &mut history, SetStock::new(&world, shape, at), "sheet stock");
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("catalog tool");
+    run(&world, &mut history, AddTool::new(&world, TOOL, tool), "tool");
+    (world, history)
+}
+
+fn place(world: &World, history: &mut History, path: &Path) -> String {
+    let cmd = ImportDxf::new(world, None, path, &DxfOptions::default()).expect("the drawing imports");
+    let name = cmd.name().to_owned();
+    history.execute(world, cmd);
+    name
+}
+
+fn near(a: f64, b: f64) {
+    assert!((a - b).abs() < 1e-9, "{a} != {b}");
+}
+
+fn pose(world: &World, name: &str) -> Location {
+    let (entity, _) = sketch::find(world, name).expect("the profile is in the document");
+    sketch::world_pose(world, &entity).expect("the profile has a place on its stock")
+}
+
+#[test]
+fn a_dxf_profile_lands_on_the_stock_top_at_the_stock_origin_and_is_not_a_model() {
+    let dir = tmp_dir("place");
+    let (world, mut history) = sheet_world();
+    let name = place(&world, &mut history, &write_dxf(&dir, "plate.dxf", Some(4)));
+    assert_eq!(name, "plate", "named by the file's stem");
+
+    let (entity, profile) = sketch::find(&world, &name).expect("a Sketch entity");
+    assert!(!model::is_model(&world, &entity), "a profile is not a model");
+    assert!(model::model_entities(&world).is_empty(), "the part readers never list it");
+    assert!(model::facets_of(&world, &entity).is_none(), "no facets: no 3D tool reads it as a mesh");
+    assert_eq!(profile.setup, None, "a document without setups: the implicit setup");
+
+    // The placement: the top face of the stock (5 + 6), at the stock origin.
+    let at = pose(&world, &name);
+    assert_eq!(at.pos, Point3::new(10.0, 20.0, 11.0));
+    assert_eq!(at.rot, IDENTITY_Q);
+
+    // Layer, chain, unit and skip metadata.
+    let data = &profile.data;
+    assert_eq!(data.layers(), ["cut", "holes", "marks"]);
+    assert_eq!((data.chains().closed.len(), data.chains().open.len(), data.chains().rejected.len()), (2, 1, 0));
+    assert!(!data.units().overridden(), "the file's own millimetres");
+    assert_eq!(data.summary().skipped.get("TEXT"), Some(&1));
+
+    // The profile rides the stock: a moved stock carries it.
+    let moved = Location { pos: Point3::new(-30.0, 0.0, 2.0), rot: IDENTITY_Q };
+    run(&world, &mut history, SetStock::new(&world, StockShape::Box { dx: 200.0, dy: 120.0, dz: 10.0 }, moved), "new stock");
+    assert_eq!(pose(&world, &name).pos, Point3::new(-30.0, 0.0, 12.0), "the top of the new stock");
+
+    // The same drawing placed again gets a name of its own.
+    assert_eq!(place(&world, &mut history, &dir.join("plate.dxf")), "plate (2)");
+    assert_eq!(sketch::placed_in(&world, None), ["plate", "plate (2)"]);
+}
+
+#[test]
+fn a_profile_moves_and_turns_on_its_stock_face_with_undo_and_redo() {
+    let dir = tmp_dir("move");
+    let (world, mut history) = sheet_world();
+    let name = place(&world, &mut history, &write_dxf(&dir, "plate.dxf", Some(4)));
+
+    // 450 degrees is 90 degrees: one turn is every turn.
+    run(&world, &mut history, MoveSketch::new(&world, &name, 30.0, -10.0, 450.0), "move");
+    let at = pose(&world, &name);
+    assert_eq!(at.pos, Point3::new(40.0, 10.0, 11.0), "moved on the face, still on the stock top");
+    // The drawing's +X now runs along the face's +Y.
+    let x_end = transform_point(Point3::new(100.0, 0.0, 0.0), at.pos, at.rot);
+    near(x_end.x, 40.0);
+    near(x_end.y, 110.0);
+    near(x_end.z, 11.0);
+    let (entity, _) = sketch::find(&world, &name).expect("profile");
+    let (x, y, angle) = model::transform_of(&world, &entity).and_then(sketch::face_placement).expect("on the face");
+    near(x, 30.0);
+    near(y, -10.0);
+    near(angle, 90.0);
+
+    assert!(history.undo(&world), "undo the move");
+    assert_eq!(pose(&world, &name), Location { pos: Point3::new(10.0, 20.0, 11.0), rot: IDENTITY_Q });
+    assert!(history.undo(&world), "undo the import");
+    assert!(sketch::find(&world, &name).is_none(), "undo removes the profile");
+    assert!(history.redo(&world) && history.redo(&world), "redo both");
+    assert_eq!(pose(&world, &name).pos, Point3::new(40.0, 10.0, 11.0), "redo puts the moved profile back");
+
+    // Refusals, by name; nothing moves.
+    assert!(refusal(MoveSketch::new(&world, &name, f64::NAN, 0.0, 0.0), "NaN").contains("must be finite"));
+    assert!(refusal(MoveSketch::new(&world, &name, 2.0e6, 0.0, 0.0), "far").contains("from the stock origin"));
+    assert!(refusal(MoveSketch::new(&world, TOOL, 0.0, 0.0, 0.0), "a tool").contains("is not a DXF profile"));
+    assert!(matches!(MoveSketch::new(&world, "nothing", 0.0, 0.0, 0.0), Err(CommandError::NotFound(_))));
+    // A profile is not placed with the model's verb.
+    let why = refusal(MoveModel::new(&world, &name, Location::default()), "MoveModel on a profile");
+    assert!(why.contains("is a DXF profile"), "{why}");
+    assert_eq!(pose(&world, &name).pos, Point3::new(40.0, 10.0, 11.0));
+}
