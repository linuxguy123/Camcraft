index 000000000..1bf1b8018
--- /dev/null
+++ b/crates/geometry/src/sketch_chains/nesting.rs
@@ -0,0 +1,159 @@
+//! Provenance: outer-versus-hole reading of closed sketch loops. Containment is the crossing-
+//! number test with the half-open edge rule (Shimrat, "Algorithm 112: Position of point relative
+//! to polygon", CACM 5(8), 1962; Haines, "Point in Polygon Strategies", Graphics Gems IV, 1994),
+//! extended to circular arcs by cutting each arc into y-monotone pieces at its top and bottom
+//! points. A loop inside an even number of loops is an outer boundary and inside an odd number
+//! a hole: the even-odd rule `geo2d::Region` reads its loops by. Original implementation.
+
+use super::crossing::{Sealed, sweep_on_y};
+use super::curve::{Piece, Shape};
+use super::{Budget, ChainError};
+use crate::geo2d::Point2;
+use std::f64::consts::{FRAC_PI_2, PI};
+
+/// Whether a ray from `p` towards +x crosses the y-monotone span from `ya` to `yb`, whose x at
+/// the ray's height is `x()`. Lower end inclusive, upper end exclusive.
+fn crosses(p: Point2, ya: f64, yb: f64, x: impl Fn() -> f64) -> bool {
+    (ya > p.y) != (yb > p.y) && x() > p.x
+}
+
+fn arc_parity(
+    p: Point2,
+    piece: &Piece,
+    center: Point2,
+    radius: f64,
+    start: f64,
+    sweep: f64,
+) -> bool {
+    // Walk the arc by increasing angle; the drawn ends keep the exact points of the piece.
+    let (drawn_from, drawn_to) = if piece.reversed {
+        (piece.b, piece.a)
+    } else {
+        (piece.a, piece.b)
+    };
+    let (from, to, y_from, y_to) = if sweep < 0.0 {
+        (start + sweep, start, drawn_to.y, drawn_from.y)
+    } else {
+        (start, start + sweep, drawn_from.y, drawn_to.y)
+    };
+    let dy = p.y - center.y;
+    let half = (radius * radius - dy * dy).max(0.0).sqrt();
+    let mut inside = false;
+    let (mut angle, mut y) = (from, y_from);
+    let mut k = ((from - FRAC_PI_2) / PI).floor() + 1.0;
+    // The top and bottom points lie half a turn apart, so one turn holds at most three of
+    // them: the bound is never reached.
+    for _ in 0..8 {
+        let turn = FRAC_PI_2 + k * PI;
+        if turn <= angle {
+            k += 1.0;
+            continue;
+        }
+        let last = turn >= to;
+        let (next, y_next) = if last {
+            (to, y_to)
+        } else if (k as i64).rem_euclid(2) == 0 {
+            (turn, center.y + radius)
+        } else {
+            (turn, center.y - radius)
+        };
+        let right = (0.5 * (angle + next)).cos() >= 0.0;
+        inside ^= crosses(p, y, y_next, || {
+            if right {
+                center.x + half
+            } else {
+                center.x - half
+            }
+        });
+        if last {
+            break;
+        }
+        (angle, y) = (next, y_next);
+        k += 1.0;
+    }
+    inside
+}
+
+/// Crossing-number containment of `p` in a watertight loop.
+fn contains(sealed: &Sealed, p: Point2) -> bool {
+    let mut inside = false;
+    for piece in &sealed.pieces {
+        inside ^= match piece.shape {
+            Shape::Line => crosses(p, piece.a.y, piece.b.y, || {
+                piece.a.x + (p.y - piece.a.y) * (piece.b.x - piece.a.x) / (piece.b.y - piece.a.y)
+            }),
+            Shape::Circle { center, radius } => {
+                let dy = p.y - center.y;
+                let half = (radius * radius - dy * dy).max(0.0).sqrt();
+                let (bottom, top) = (center.y - radius, center.y + radius);
+                crosses(p, bottom, top, || center.x + half)
+                    ^ crosses(p, top, bottom, || center.x - half)
+            }
+            Shape::Arc {
+                center,
+                radius,
+                start,
+                sweep,
+            } => arc_parity(p, piece, center, radius, start, sweep),
+        };
+    }
+    inside
+}
+
+/// Per loop: the loops that contain it. `skip` loops neither contain nor are contained.
+/// A container's bounds span those of what it contains, so the loops are swept by their low
+/// edge on the wider-spread axis and only those still open there are tested.
+pub(super) fn containers(
+    loops: &[Sealed],
+    skip: &[bool],
+    budget: &mut Budget,
+) -> Result<Vec<Vec<usize>>, ChainError> {
+    let mut order: Vec<usize> = (0..loops.len())
+        .filter(|&i| !skip.get(i).copied().unwrap_or(false))
+        .collect();
+    let on_y = sweep_on_y(
+        order
+            .iter()
+            .filter_map(|&i| loops.get(i))
+            .map(|sealed| (sealed.lo, sealed.hi)),
+    );
+    let along = |p: Point2| if on_y { p.y } else { p.x };
+    let low = |i: usize| {
+        loops
+            .get(i)
+            .map_or(f64::INFINITY, |sealed| along(sealed.lo))
+    };
+    order.sort_by(|&i, &j| low(i).total_cmp(&low(j)).then(i.cmp(&j)));
+    let mut out = vec![Vec::new(); loops.len()];
+    let mut active: Vec<usize> = Vec::new();
+    for i in order {
+        let Some(inner) = loops.get(i) else { continue };
+        let Some(sample) = inner.pieces.first().map(|piece| piece.a) else {
+            continue;
+        };
+        active.retain(|&j| {
+            loops
+                .get(j)
+                .is_some_and(|outer| along(outer.hi) >= along(inner.lo))
+        });
+        budget.spend(active.len())?;
+        for &j in &active {
+            let Some(outer) = loops.get(j) else { continue };
+            let around = outer.lo.x <= inner.lo.x
+                && outer.lo.y <= inner.lo.y
+                && outer.hi.x >= inner.hi.x
+                && outer.hi.y >= inner.hi.y;
+            if !around {
+                continue;
+            }
+            budget.spend(outer.pieces.len())?;
+            if contains(outer, sample)
+                && let Some(list) = out.get_mut(i)
+            {
+                list.push(j);
+            }
+        }
+        active.push(i);
+    }
+    Ok(out)
+}
diff --git a/crates/geometry/src/sketch_chains/types.rs b/crates/geometry/src/sketch_chains/types.rs
new file mode 100644
index 000000000..80432b065
--- /dev/null
+++ b/crates/geometry/src/sketch_chains/types.rs
@@ -0,0 +1,166 @@
+//! Provenance: the public values of sketch chaining - options, identities, chains, rejections
+//! and the named errors. Our own design for issue 1861; no vendor material consulted.
+
+use crate::dxf::Primitive;
+use crate::geo2d::Point2;
+use std::fmt;
+
+/// Default join tolerance in millimetres.
+pub const DEFAULT_JOIN_TOLERANCE: f64 = 0.01;
+/// The smallest join tolerance: above the identity quantum (1e-6 mm), so two joints of one
+/// chain never share a quantized position.
+pub const MIN_JOIN_TOLERANCE: f64 = 1e-5;
+/// The largest join tolerance, in millimetres.
+pub const MAX_JOIN_TOLERANCE: f64 = 10.0;
+/// Input size limit; above it the call is refused.
+pub const MAX_PRIMITIVES: usize = 2_000_000;
+
+#[derive(Clone, Debug, PartialEq, thiserror::Error)]
+pub enum ChainError {
+    #[error("sketch chaining: join tolerance must be between 1e-5 mm and 10 mm")]
+    InvalidTolerance,
+    #[error("sketch chaining: primitive {primitive} has a non-finite value")]
+    NonFinite { primitive: usize },
+    #[error("sketch chaining: primitive {primitive} lies outside the supported coordinate range")]
+    OutOfRange { primitive: usize },
+    #[error("sketch chaining: primitive {primitive} is invalid: {reason}")]
+    InvalidPrimitive {
+        primitive: usize,
+        reason: &'static str,
+    },
+    #[error(
+        "sketch chaining: the drawing is too large or too dense to chain within the work limit"
+    )]
+    TooComplex,
+    #[error("sketch chaining: primitive {primitive} repeats primitive {of} on the same layer")]
+    DuplicatePrimitive { primitive: usize, of: usize },
+    #[error("sketch chaining: primitive {primitive} is shorter than the join tolerance")]
+    DegenerateSegment { primitive: usize },
+    #[error("sketch chaining: {degree} curve ends meet at ({}, {}); a chain cannot branch", at.x, at.y)]
+    Branch { at: Point2, degree: usize },
+    #[error("sketch chaining: closed loop crosses or touches itself at ({}, {})", at.x, at.y)]
+    SelfCrossing { at: Point2 },
+    #[error("sketch chaining: closed loop encloses no area")]
+    ZeroArea,
+    #[error("sketch chaining: chain repeats chain {of}")]
+    DuplicateChain { of: ChainId },
+    #[error("sketch chaining: nesting is ambiguous: chain {other} crosses or touches a loop at ({}, {})", at.x, at.y)]
+    NestingAmbiguous { other: ChainId, at: Point2 },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ChainOptions {
+    /// Ends closer than this (mm) are joined; a wider gap is never bridged.
+    pub join_tolerance: f64,
+}
+
+impl Default for ChainOptions {
+    fn default() -> Self {
+        ChainOptions {
+            join_tolerance: DEFAULT_JOIN_TOLERANCE,
+        }
+    }
+}
+
+/// Identity of a chain: a hash of its layer name and its quantized curves in canonical order.
+/// It does not depend on the order or direction the primitives were drawn in.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct ChainId(pub u128);
+
+impl fmt::Display for ChainId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{:032x}", self.0)
+    }
+}
+
+/// One input primitive in walk direction.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChainSegment {
+    /// Index of the primitive in the input slice.
+    pub primitive: usize,
+    /// The analytic curve, turned to the walk direction (an arc keeps centre and radius; its
+    /// sweep sign says clockwise or counterclockwise).
+    pub curve: Primitive,
+    /// The walk runs against the drawn direction.
+    pub reversed: bool,
+    pub start: Point2,
+    pub end: Point2,
+}
+
+/// A chain with two free ends. It starts at its lower end in (x, y).
+#[derive(Clone, Debug, PartialEq)]
+pub struct OpenChain {
+    pub id: ChainId,
+    pub layer: String,
+    pub segments: Vec<ChainSegment>,
+    pub start: Point2,
+    pub end: Point2,
+    /// The widest joint gap inside the chain, at most the join tolerance.
+    pub max_gap: f64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LoopRole {
+    /// Inside an even number of other loops: material lies inside it.
+    Outer,
+    /// Inside an odd number of other loops: a hole in its parent.
+    Hole,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Nesting {
+    pub role: LoopRole,
+    /// How many closed chains contain this one.
+    pub depth: usize,
+    /// The innermost chain that contains this one.
+    pub parent: Option<ChainId>,
+}
+
+/// A closed loop, walked counterclockwise from its lowest joint in (x, y).
+#[derive(Clone, Debug, PartialEq)]
+pub struct ClosedChain {
+    pub id: ChainId,
+    pub layer: String,
+    pub segments: Vec<ChainSegment>,
+    /// Enclosed area in mm^2, arcs included exactly.
+    pub area: f64,
+    /// The widest joint gap inside the loop, at most the join tolerance.
+    pub max_gap: f64,
+    /// Outer boundary or hole; `NestingAmbiguous` when this loop or one around it crosses or
+    /// touches another closed chain, so no reading is safe.
+    pub nesting: Result<Nesting, ChainError>,
+}
+
+/// Primitives that form no usable chain, and why.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Rejected {
+    pub layer: String,
+    /// Input indices, ascending.
+    pub primitives: Vec<usize>,
+    pub error: ChainError,
+}
+
+/// Every chain of the input, each list sorted by layer name, then start position, then id.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SketchChains {
+    pub closed: Vec<ClosedChain>,
+    pub open: Vec<OpenChain>,
+    pub rejected: Vec<Rejected>,
+}
+
+impl SketchChains {
+    /// The chains, or the first rejection or ambiguous nesting as an error.
+    pub fn strict(self) -> Result<SketchChains, ChainError> {
+        if let Some(rejected) = self.rejected.first() {
+            return Err(rejected.error.clone());
+        }
+        if let Some(error) = self
+            .closed
+            .iter()
+            .find_map(|chain| chain.nesting.as_ref().err())
+        {
+            return Err(error.clone());
+        }
+        Ok(self)
+    }
+}
diff --git a/crates/geometry/tests/common/mod.rs b/crates/geometry/tests/common/mod.rs
