  "title": "fix(ui): pin the toolbar version in tests so a version bump leaves the shell snapshots alone",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
