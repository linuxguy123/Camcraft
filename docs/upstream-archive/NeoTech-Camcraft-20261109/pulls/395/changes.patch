Subject: [PATCH 8/8] test(setup): the version floors are compile-time asserts
 (clippy assertions_on_constants)

assert!(PROJECT_VERSION >= N) on a const trips clippy's
assertions_on_constants under -D warnings (batch tier); a const _: () =
assert!(...) checks the same floor at compile time and is lint-clean.

Refs #368

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/setup_relative.rs     | 2 +-
 crates/app/tests/setup_stock_source.rs | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/app/tests/setup_relative.rs b/crates/app/tests/setup_relative.rs
index 4f557ff5..7270eaec 100644
--- a/crates/app/tests/setup_relative.rs
+++ b/crates/app/tests/setup_relative.rs
@@ -227,7 +227,7 @@ fn links_round_trip_and_older_or_broken_files_are_read_by_name() {
     assert!(first.contains(&format!("\"version\": {}", project::PROJECT_VERSION)));
     // Links arrived at v56 (#316); a later rung must not break them, so
     // pin the floor, not the exact number (cf. #344).
-    assert!(project::PROJECT_VERSION >= 56, "setup links need project v56 or later");
+    const _: () = assert!(project::PROJECT_VERSION >= 56, "setup links need project v56 or later");
     let world2 = new_world();
     project::load(&world2, &path).expect("load");
     assert_eq!(link_of(&world2, "Setup2").as_deref(), Some("Setup1"));
