From 9ad5ffb1a630db0345f23f65ec88dd574bd4ac0a Mon Sep 17 00:00:00 2001
From: shadaytree <82917003+shadaytree@users.noreply.github.com>
Date: Tue, 24 Nov 2026 22:22:08 -0600
Subject: [PATCH] fix(dxf): MPOLYGON and the 3D surface kinds count as entities
 in the inert-section scan

ENTITY_KINDS lacked MPOLYGON and the six SURFACE subtypes (EXTRUDEDSURFACE,
LOFTEDSURFACE, NURBSURFACE, PLANESURFACE, REVOLVEDSURFACE, SWEPTSURFACE), so a
damaged file could hide one of them in CLASSES, ACDSDATA or THUMBNAILIMAGE and
the reader dropped it silently. They are refused now, like the other kinds.

SUN stays off the list on purpose: AutoCAD writes it in OBJECTS (AcDbSun, no
AcDbEntity), and OBJECTS refuses every listed kind. A comment says why and a
test pins that a SUN object in OBJECTS still imports.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Fixes #3683
---
 crates/geometry/src/dxf/entities.rs          | 15 +++++++-----
 crates/geometry/tests/dxf_classes_section.rs | 25 ++++++++++++++++++++
 crates/geometry/tests/dxf_objects_section.rs | 16 +++++++++++++
 3 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/crates/geometry/src/dxf/entities.rs b/crates/geometry/src/dxf/entities.rs
index f91f7ed6d..f2d272df3 100644
--- a/crates/geometry/src/dxf/entities.rs
+++ b/crates/geometry/src/dxf/entities.rs
@@ -6,14 +6,17 @@ use std::f64::consts::TAU;
 
 /// Record names of the DXF Reference ENTITIES chapter. A record of one of these kinds is
 /// drawable, so a section that the reader treats as inert must never hold one.
+/// SUN is in that chapter too but is left out: AutoCAD writes it in OBJECTS (subclass
+/// AcDbSun, no AcDbEntity), and OBJECTS refuses every kind on this list (#3683).
 #[rustfmt::skip]
-const ENTITY_KINDS: [&str; 46] = [
+const ENTITY_KINDS: [&str; 53] = [
     "3DFACE", "3DSOLID", "ACAD_PROXY_ENTITY", "ARC", "ATTDEF", "ATTRIB", "BODY", "CIRCLE",
-    "DGNUNDERLAY", "DIMENSION", "DWFUNDERLAY", "ELLIPSE", "HATCH", "HELIX", "IMAGE", "INSERT",
-    "LEADER", "LIGHT", "LINE", "LWPOLYLINE", "MESH", "MLEADER", "MLINE", "MTEXT", "OLE2FRAME",
-    "OLEFRAME", "PDFUNDERLAY", "POINT", "POLYLINE", "RAY", "REGION", "SECTION", "SEQEND",
-    "SHAPE", "SOLID", "SPLINE", "SURFACE", "TABLE", "TEXT", "TOLERANCE", "TRACE", "VERTEX",
-    "VIEWPORT", "WIPEOUT", "XLINE", "MULTILEADER",
+    "DGNUNDERLAY", "DIMENSION", "DWFUNDERLAY", "ELLIPSE", "EXTRUDEDSURFACE", "HATCH", "HELIX",
+    "IMAGE", "INSERT", "LEADER", "LIGHT", "LINE", "LOFTEDSURFACE", "LWPOLYLINE", "MESH",
+    "MLEADER", "MLINE", "MPOLYGON", "MTEXT", "NURBSURFACE", "OLE2FRAME", "OLEFRAME",
+    "PDFUNDERLAY", "PLANESURFACE", "POINT", "POLYLINE", "RAY", "REGION", "REVOLVEDSURFACE",
+    "SECTION", "SEQEND", "SHAPE", "SOLID", "SPLINE", "SURFACE", "SWEPTSURFACE", "TABLE", "TEXT",
+    "TOLERANCE", "TRACE", "VERTEX", "VIEWPORT", "WIPEOUT", "XLINE", "MULTILEADER",
 ];
 
 pub(super) fn is_entity_kind(kind: &str) -> bool {
diff --git a/crates/geometry/tests/dxf_classes_section.rs b/crates/geometry/tests/dxf_classes_section.rs
index abe921111..92400b066 100644
--- a/crates/geometry/tests/dxf_classes_section.rs
+++ b/crates/geometry/tests/dxf_classes_section.rs
@@ -98,3 +98,28 @@ fn an_entity_in_a_section_without_geometry_is_refused() {
         }
     }
 }
+
+#[test]
+fn mpolygon_and_the_surface_kinds_in_a_section_without_geometry_are_refused() {
+    // #3683: these ENTITIES-chapter kinds were missing from the list and slipped through.
+    for name in ["CLASSES", "ACDSDATA", "THUMBNAILIMAGE"] {
+        for kind in [
+            "MPOLYGON",
+            "EXTRUDEDSURFACE",
+            "LOFTEDSURFACE",
+            "NURBSURFACE",
+            "PLANESURFACE",
+            "REVOLVEDSURFACE",
+            "SWEPTSURFACE",
+        ] {
+            let record = format!("0\n{kind}\n8\n0\n");
+            let error = parse(file(&section(name, &record)).as_bytes())
+                .unwrap_err()
+                .0;
+            assert!(
+                error.contains(name) && error.contains(&format!("{kind} entity")),
+                "{error}"
+            );
+        }
+    }
+}
diff --git a/crates/geometry/tests/dxf_objects_section.rs b/crates/geometry/tests/dxf_objects_section.rs
index 4133cb443..4fb22dc3c 100644
--- a/crates/geometry/tests/dxf_objects_section.rs
+++ b/crates/geometry/tests/dxf_objects_section.rs
@@ -176,3 +176,19 @@ fn object_data_after_the_subclass_marker_stays_opaque() {
         parse(without.as_bytes()).unwrap()
     );
 }
+
+#[test]
+fn a_sun_object_in_objects_stays_inert() {
+    // AutoCAD writes SUN in OBJECTS (AcDbSun, no AcDbEntity), so it is not refused as a
+    // graphical entity there (#3683).
+    let body = format!(
+        "{ROOT}0\nDICTIONARY\n5\nA1\n330\nA0\n100\nAcDbDictionary\n3\nSun\n350\nB1\n\
+         0\nSUN\n5\nB1\n330\nA1\n100\nAcDbSun\n90\n1\n290\n1\n"
+    );
+    let with = format!("{ENTITIES}{}0\nEOF\n", section("OBJECTS", &body));
+    let without = format!("{ENTITIES}0\nEOF\n");
+    assert_eq!(
+        parse(with.as_bytes()).unwrap(),
+        parse(without.as_bytes()).unwrap()
+    );
+}
