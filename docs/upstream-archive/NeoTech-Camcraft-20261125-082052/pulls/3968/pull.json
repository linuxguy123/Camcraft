  "title": "DXF import: MPOLYGON and 3D surface records hidden in a non-drawing section are refused, not dropped",
  "user": {
    "login": "shadaytree",
    "id": 82917003,
    "node_id": "MDQ6VXNlcjgyOTE3MDAz",
    "avatar_url": "https://avatars.githubusercontent.com/u/82917003?v=4",
    "gravatar_id": "",
