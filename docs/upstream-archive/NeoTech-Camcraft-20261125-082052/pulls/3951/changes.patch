From a326fb2d76f45e23833b222bd40907577978b17e Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Tue, 24 Nov 2026 18:32:52 -0500
Subject: [PATCH 2/4] fix(motion): stop inter-level rapid at feed height above
 prior floor in 3D Pocket

Update descent start plane to add plunge height on level transitions.

Keep descent start plane on prior cut plane for pass restarts.

Stop rapids at feed height margin on restarts and feed down to descent plane.

Regenerate example catalog case 3d/rough-finish with rapids stopping at feed height.

Update golden digest in rotary_adaptive test for inter-level rapid feed margin.

Fixes #3671
---
 .../example_catalog/case_3d_rough_finish.rs   |   11 +-
 crates/motion/src/machining3d/descent.rs      |   46 +-
 crates/motion/src/machining3d/ladder.rs       |   11 +-
 crates/motion/src/machining3d/reentry.rs      |    1 +
 crates/motion/tests/rotary_adaptive.rs        |    3 +-
 .../3d/rough-finish/rough-finish.camproj      | 1408 ++++++++++++++++-
 .../catalog/3d/rough-finish/rough-finish.nc   |  213 ++-
 7 files changed, 1518 insertions(+), 175 deletions(-)

diff --git a/crates/app/tests/example_catalog/case_3d_rough_finish.rs b/crates/app/tests/example_catalog/case_3d_rough_finish.rs
index d9ae21a19..565aa39c0 100644
--- a/crates/app/tests/example_catalog/case_3d_rough_finish.rs
+++ b/crates/app/tests/example_catalog/case_3d_rough_finish.rs
@@ -23,12 +23,11 @@ mod catalog_3d_rough_finish {
         assert!(!op_lines.is_empty(), "3D Pocket1 section present");
         let mut lowest_rapid_z = f64::INFINITY;
         for line in &op_lines {
-            if line.starts_with("G00") || line.starts_with("G0 ") {
-                if let Some(z) = word(line, 'Z') {
-                    if z < lowest_rapid_z {
-                        lowest_rapid_z = z;
-                    }
-                }
+            if (line.starts_with("G00") || line.starts_with("G0 "))
+                && let Some(z) = word(line, 'Z')
+                && z < lowest_rapid_z
+            {
+                lowest_rapid_z = z;
             }
         }
         // The last level cuts at Z8. The level above it cut at Z10.
diff --git a/crates/motion/src/machining3d/descent.rs b/crates/motion/src/machining3d/descent.rs
index af208dfbe..5f9f371e3 100644
--- a/crates/motion/src/machining3d/descent.rs
+++ b/crates/motion/src/machining3d/descent.rs
@@ -43,22 +43,34 @@ pub(super) struct Ask<'a> {
     /// Issue #1950: `entry` is proved in the air outside the stock - a
     /// plain plunge there, for every arm (it bores into nothing).
     pub air: bool,
+    /// Whether this ask is a pass restart inside a level (`reenter`) rather
+    /// than an inter-level transition.
+    pub restart: bool,
