+++ b/crates/tools/src/meridian.rs
@@ -221,8 +221,14 @@ impl Tool {
                 let tan = (self.tip_angle.to_radians() * 0.5).tan();
                 if self.tip_angle > 0.0 && tan.is_finite() && tan > 0.0 {
                     let top = (r / tan).min(fl);
-                    let mut p = vec![line(0.0, 0.0), line(top, top * tan)];
