 crates/app/tests/mcp_edit_tool.rs             | 30 ++++++++++++
 .../src/egui_app/tests/tool_library_editor.rs | 13 +++++
 crates/ui/src/egui_app/tool_cutter_params.rs  | 17 ++++++-
 4 files changed, 105 insertions(+), 3 deletions(-)

diff --git a/crates/app/src/mcp/tool_edit.rs b/crates/app/src/mcp/tool_edit.rs
index c711b2af8..af2185717 100644
--- a/crates/app/src/mcp/tool_edit.rs
+++ b/crates/app/src/mcp/tool_edit.rs
@@ -29,7 +29,20 @@ pub(super) fn edit_tool(env: &mut Env, a: &Map<String, Value>) -> Result<Value,
     }
     let mut def = project::tool_to_json(&prev);
     merge(&mut def, &Value::Object(patch.clone()));
-    let next = project::tool_from_json(&def).map(settled).map_err(|e| format!("bad tool patch: {e}"))?;
+    let stated = project::tool_from_json(&def).map_err(|e| format!("bad tool patch: {e}"))?;
+    let next = settled(stated.clone());
+    // #3369: settling writes a form mill's outline and sizes. A value the
+    // patch states and settling replaces is refused, never dropped.
+    if let (Value::Object(asked), Value::Object(lands)) = (project::tool_to_json(&stated), project::tool_to_json(&next))
+        && let Some((path, want, got)) = replaced(patch, &asked, &lands, "")
+    {
+        let why = if path.starts_with("form.") {
+            "the form's preset writes the outline - set \"form.preset\" to null to draw \"form.points\", or edit the preset's numbers"
+        } else {
+            "the form outline sets it - edit \"form\" (its preset numbers or its drawn points)"
+        };
+        return Err(format!("bad tool patch: \"{path}\" {want} is not what form mill {name} gets ({got}): {why}"));
+    }
     // serde drops keys it does not know; a dropped edit reads as done.
     let Value::Object(back) = project::tool_to_json(&next) else {
         return Err("the patched tool could not be read back".into());
@@ -73,3 +86,36 @@ pub(super) fn settled(mut t: crate::tools::Tool) -> crate::tools::Tool {
     t.settle_form();
     t
 }
+
+/// The first value `patch` states that settling replaced: its path, the
+/// value asked for and the value the tool would get. `asked` is the
+/// patched tool as stated, `lands` the same tool settled. Numbers agree
+/// within the form mill's slack.
+fn replaced(patch: &Map<String, Value>, asked: &Map<String, Value>, lands: &Map<String, Value>, prefix: &str) -> Option<(String, Value, Value)> {
+    for (k, v) in patch {
+        let (Some(a), Some(l)) = (asked.get(k), lands.get(k)) else { continue };
+        let path = if prefix.is_empty() { k.clone() } else { format!("{prefix}.{k}") };
+        match (v, a, l) {
+            (Value::Null, ..) => {}
+            (Value::Object(p), Value::Object(a), Value::Object(l)) => {
+                if let Some(hit) = replaced(p, a, l, &path) {
+                    return Some(hit);
+                }
+            }
+            _ if !agree(a, l) => return Some((path, a.clone(), l.clone())),
+            _ => {}
+        }
+    }
+    None
+}
+
+fn agree(a: &Value, b: &Value) -> bool {
+    match (a, b) {
+        (Value::Array(x), Value::Array(y)) => x.len() == y.len() && x.iter().zip(y).all(|(p, q)| agree(p, q)),
+        (Value::Number(x), Value::Number(y)) => match (x.as_f64(), y.as_f64()) {
+            (Some(p), Some(q)) => (p - q).abs() <= camcraft_tools::form_mill::AGREE,
+            _ => x == y,
+        },
+        _ => a == b,
+    }
+}
diff --git a/crates/app/tests/mcp_edit_tool.rs b/crates/app/tests/mcp_edit_tool.rs
index db0ec33bc..2c1499f2f 100644
--- a/crates/app/tests/mcp_edit_tool.rs
+++ b/crates/app/tests/mcp_edit_tool.rs
@@ -171,3 +171,33 @@ fn add_and_edit_tool_take_a_form_mill_preset() {
     let e = c.refused("edit_tool", json!({ "name": "EM-0400-2FL", "patch": { "form": { "pilot_len": 1.0, "points": drawn } } }));
     assert!(e.contains("only a form mill"), "{e}");
 }
+
+/// #3369 (review of #3946): the form outline sets a form mill's diameter
+/// and flute length, and a preset writes its points. A patch that states
+/// another value for one of them is refused by the field's name and
+/// changes nothing - it is never dropped with a success. A value that
+/// agrees with the outline, and a preset number edit, still land.
+#[test]
+fn edit_tool_refuses_a_form_mill_value_that_settling_replaces() {
+    let mut c = setup();
+    c.ok("add_tool", json!({ "catalog": "FM-RO-R6", "holder": "none" }));
+    let before = c.tool("FM-RO-R6")["definition"].clone();
+    assert_eq!((before["diameter"].clone(), before["form"]["points"].as_array().map(Vec::len)), (json!(25.0), Some(5)), "{before}");
+    let e = c.refused("edit_tool", json!({ "name": "FM-RO-R6", "patch": { "diameter": -1.0 } }));
+    assert!(e.contains("\"diameter\" -1.0") && e.contains("FM-RO-R6") && e.contains("form outline sets it"), "{e}");
+    let e = c.refused("edit_tool", json!({ "name": "FM-RO-R6", "patch": { "flute_len": 30.0 } }));
+    assert!(e.contains("\"flute_len\" 30.0") && e.contains("form outline sets it"), "{e}");
+    let other = json!([[0.0, 0.0, 0.0], [0.0, 6.0, 0.0], [5.0, 6.0, 0.0], [10.0, 4.0, 0.0]]);
+    let e = c.refused("edit_tool", json!({ "name": "FM-RO-R6", "patch": { "form": { "points": other } } }));
+    assert!(e.contains("\"form.points\"") && e.contains("preset writes the outline"), "{e}");
+    // A preset number edit with a stale diameter beside it is refused too.
+    let e = c.refused("edit_tool", json!({ "name": "FM-RO-R6", "patch": { "diameter": 25.0, "form": { "preset": { "radius": 8.0 } } } }));
+    assert!(e.contains("\"diameter\" 25.0") && e.contains("(29.0)"), "{e}");
+    assert_eq!(c.tool("FM-RO-R6")["definition"], before, "a refused patch changes nothing");
+    // Values that agree with the outline are no conflict.
+    let same = json!({ "diameter": 25.0, "flute_len": 18.0, "form": { "points": before["form"]["points"] } });
+    let r = c.ok("edit_tool", json!({ "name": "FM-RO-R6", "patch": same }));
+    assert_eq!(r["definition"], before, "{r}");
+    let r = c.ok("edit_tool", json!({ "name": "FM-RO-R6", "patch": { "form": { "preset": { "radius": 8.0 } } } }));
+    assert_eq!(r["definition"]["diameter"], json!(29.0), "a preset edit still settles: {r}");
+}
