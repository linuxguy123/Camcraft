+    h.execute(&w, ChangeTool::new(&w, "RO", edited.clone()).expect("a number edit"));
+    assert_eq!(tool_named(&w, "RO").and_then(|t| t.form), Some(form.clone()), "the outline stays");
+    assert!(h.undo(&w));
