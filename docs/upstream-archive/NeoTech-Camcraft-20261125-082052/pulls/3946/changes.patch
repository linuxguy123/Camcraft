diff --git a/crates/tools/src/form_mill.rs b/crates/tools/src/form_mill.rs
new file mode 100644
index 000000000..d480c9637
--- /dev/null
+++ b/crates/tools/src/form_mill.rs
@@ -0,0 +1,239 @@
+//! A form mill (#3369): a router-style cutter whose cutting edge is a
+//! drawn outline (its meridian), with an optional pilot bearing at the
+//! tip that occupies space and does not cut. The outline is written by a
+//! preset ([`FormPreset`]) from the numbers of a public router bit
+//! catalogue, or drawn point by point. The circle geometry is elementary
+//! plane geometry (the centre of an arc through two points). Our own
+//! design; no vendor source or file consulted.
+//!
+//! In this slice the radius never narrows upward: an undercut outline is
+//! refused by name and stays with #896. No operation cuts with a form
+//! mill yet; the operation doors refuse it by name.
+
+use serde::{Deserialize, Serialize};
+
+use crate::meridian::{Meridian, MeridianError};
+use crate::spun::SpunPoint;
+use crate::tools::{Tool, ToolKind, add_pt};
+
+#[path = "form_mill_presets.rs"]
+mod presets;
+pub use presets::{FormPreset, NAMES};
+
+/// Slack (mm) between the outline and the tool's diameter and flute
+/// length.
+pub const AGREE: f64 = 1e-6;
+/// Slack (mm) on the monotonic checks: float dust only.
+const EPS: f64 = 1e-9;
+
+/// A form mill's outline: points `[z, r, arc]` from the tip up (the
+/// [`SpunPoint`] law: `arc` signed, positive bulges away from the axis),
+/// the pilot bearing's length at the tip (0 = no pilot), and the preset
+/// that wrote the points (`None` = drawn by hand). With a preset, the
+/// points are exactly what the preset writes.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct FormSpec {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub preset: Option<FormPreset>,
+    #[serde(default, skip_serializing_if = "is_zero")]
+    pub pilot_len: f64,
+    #[serde(default)]
+    pub points: Vec<[f64; 3]>,
+}
+
+#[allow(clippy::trivially_copy_pass_by_ref)]
+fn is_zero(v: &f64) -> bool {
+    *v == 0.0
+}
+
+impl FormSpec {
+    /// The outline a preset writes over a pilot of `pilot_len`.
+    pub fn from_preset(preset: FormPreset, pilot_len: f64) -> Result<Self, String> {
+        let pts = preset.points(pilot_len)?;
+        Ok(Self { preset: Some(preset), pilot_len, points: pts.iter().map(|p| [p.z, p.r, p.arc]).collect() })
+    }
+
+    /// The stored points as [`SpunPoint`]s.
+    #[must_use]
+    pub fn spun(&self) -> Vec<SpunPoint> {
+        self.points.iter().map(|p| SpunPoint { z: p[0], r: p[1], arc: p[2] }).collect()
+    }
+
+    /// One flag for each segment: a segment that ends at or under the
+    /// pilot's top is the bearing and does not cut.
+    #[must_use]
+    pub fn cutting(&self) -> Vec<bool> {
+        let pilot = self.pilot_len;
+        self.points.windows(2).map(|w| !(pilot > 0.0 && w[1][0] <= pilot + AGREE)).collect()
+    }
+
+    /// The widest radius and the top of the outline.
+    #[must_use]
+    pub fn extent(&self) -> (f64, f64) {
+        self.points.iter().fold((0.0, 0.0), |(r, z), p| (r.max(p[1]), z.max(p[0])))
+    }
+}
+
+/// Write a form mill's outline from its preset, and its diameter and
+/// flute length from the outline: the form is the one source of the
+/// cutter's shape (what the editor and MCP call after an edit). Any other
+/// kind, and a preset whose numbers make no bit, are left as they are, so
+/// [`refusal`] names the problem.
+pub fn settle(t: &mut Tool) {
+    if t.kind != ToolKind::FormMill {
+        return;
+    }
+    let Some(form) = t.form.as_mut() else { return };
+    if let Some(preset) = form.preset
+        && let Ok(f) = FormSpec::from_preset(preset, form.pilot_len)
+    {
+        *form = f;
+    }
+    if form.points.len() >= 2 {
+        let (r, z) = form.extent();
+        t.diameter = 2.0 * r;
+        t.flute_len = z;
+    }
+}
+
+impl Tool {
+    /// [`settle`] as a method, for the layers above `app` that reach the
+    /// tool through its re-export.
+    pub fn settle_form(&mut self) {
+        settle(self);
+    }
+}
+
+/// Fill the points of a preset form that states none (a catalogue entry
+/// gives only the preset). Unlike [`settle`], the stated diameter and
+/// flute length stay, so [`refusal`] checks them.
+pub fn fill(t: &mut Tool) {
+    if let Some(form) = t.form.as_mut()
+        && form.points.is_empty()
+        && let Some(preset) = form.preset
+        && let Ok(f) = FormSpec::from_preset(preset, form.pilot_len)
+    {
+        *form = f;
+    }
+}
+
+/// Why this tool's form is refused, by name: a form on another kind, a
+/// form mill without one, preset numbers that make no bit, points that
+/// disagree with their preset, an outline that is no meridian, an
+/// undercut, a pilot that ends inside a segment, or a diameter or flute
+/// length that is not the outline's. `None` when sound.
+#[must_use]
+pub fn refusal(t: &Tool) -> Option<String> {
+    let Some(form) = t.form.as_ref() else {
+        return (t.kind == ToolKind::FormMill).then(|| "a form mill needs a form outline: a preset or drawn points".to_owned());
+    };
+    if t.kind != ToolKind::FormMill {
+        return Some(format!("only a form mill has a form outline; this {} states one", t.kind));
+    }
+    if !(form.pilot_len.is_finite() && form.pilot_len >= 0.0) {
+        return Some(format!("a form mill's pilot length {} mm must be a finite number of 0 or more", form.pilot_len));
+    }
+    if let Some(preset) = form.preset {
+        let want = match preset.points(form.pilot_len) {
+            Ok(p) => p,
+            Err(why) => return Some(why),
+        };
+        let near = |a: f64, b: f64| (a - b).abs() <= AGREE;
+        let have = form.spun();
+        let same = want.len() == have.len()
+            && want.iter().zip(&have).all(|(a, b)| near(a.z, b.z) && near(a.r, b.r) && near(a.arc, b.arc));
+        if !same {
+            return Some(format!("the form outline is not the one its {} numbers write", preset.name()));
+        }
+    }
+    if form.points.len() > crate::spun::MAX_POINTS {
+        return Some(format!("a form outline has at most {} points, not {}", crate::spun::MAX_POINTS, form.points.len()));
+    }
+    let pts = form.spun();
+    if pts.first().is_none_or(|p| p.z != 0.0 || p.r != 0.0) {
+        return Some("a form outline starts on the axis at the tip, at z 0 and r 0".to_owned());
+    }
+    if let Err(e) = Meridian::new(pts.clone(), form.cutting()) {
+        return Some(format!("the form outline is refused: {e}"));
+    }
+    if let Some(i) = undercut_at(&pts) {
+        return Some(format!(
+            "the form outline narrows upward from point {i}: an undercut form is not supported yet (#896)"
+        ));
+    }
+    if form.pilot_len > 0.0 {
+        if !pts.iter().any(|p| (p.z - form.pilot_len).abs() <= AGREE) {
+            return Some(format!("the pilot length {} mm must end at a point of the form outline", form.pilot_len));
+        }
+        if !form.cutting().contains(&true) {
+            return Some("a form outline needs a cutting edge above its pilot".to_owned());
+        }
+    }
+    let (r, z) = form.extent();
+    if (t.diameter - 2.0 * r).abs() > AGREE || (t.flute_len - z).abs() > AGREE {
+        return Some(format!(
+            "a form mill's diameter and flute length are its outline's: {:.4} mm and {z:.4} mm, not {} mm and {} mm",
+            2.0 * r,
+            t.diameter,
+            t.flute_len
+        ));
+    }
+    None
+}
+
+/// The first point (1-based) where the outline's radius starts to fall
+/// as z climbs: a line that narrows, a convex arc past its widest point,
+/// a concave arc that starts before its narrowest.
+fn undercut_at(pts: &[SpunPoint]) -> Option<usize> {
+    pts.windows(2).position(|w| !rises(w[0], w[1])).map(|i| i + 1)
+}
+
+fn rises(a: SpunPoint, b: SpunPoint) -> bool {
+    if a.arc == 0.0 {
+        return b.r >= a.r - EPS;
+    }
+    let (dz, dr) = (b.z - a.z, b.r - a.r);
+    let len = dz.hypot(dr);
+    let rad = a.arc.abs();
+    if !(len > 0.0 && rad.is_finite()) {
+        return false;
+    }
+    // The centre of the minor arc: behind the chord for a convex arc, in
+    // front of it for a concave one (the spun profile's law).
+    let back = (rad * rad - len * len * 0.25).max(0.0).sqrt();
+    let s = a.arc.signum();
+    let cz = a.z + dz * 0.5 + s * back * dr / len;
+    let tol = 1e-7 * rad.max(1.0);
+    if s > 0.0 { b.z <= cz + tol } else { a.z >= cz - tol }
+}
+
+/// The cutting meridian of a sound form mill: its outline with the pilot
+/// flagged non-cutting. Refused by name when [`refusal`] refuses the tool.
+pub(crate) fn meridian(t: &Tool) -> Result<Meridian, MeridianError> {
+    if let Some(why) = refusal(t) {
+        return Err(MeridianError::Unsound(why));
+    }
+    let form = t.form.as_ref().ok_or_else(|| MeridianError::Unsound("a form mill needs a form outline".into()))?;
+    Meridian::new(form.spun(), form.cutting())
+}
+
+/// Append the form outline to a side-view polyline, each arc flattened
+/// so that it never falls inside the cutter (the spun profile's law).
+/// `false` when the tool states no outline to draw.
+pub(crate) fn outline(t: &Tool, p: &mut Vec<(f64, f64)>) -> bool {
+    let pts = t.form.as_ref().map(FormSpec::spun).unwrap_or_default();
+    if pts.len() < 2 {
+        return false;
+    }
+    for w in pts.windows(2) {
+        for (z, r) in crate::spun::flatten(w[0], w[1]) {
+            add_pt(p, z, r);
+        }
+    }
+    true
+}
+
+#[cfg(test)]
+#[path = "form_mill_tests.rs"]
+mod tests;
diff --git a/crates/tools/src/form_mill_presets.rs b/crates/tools/src/form_mill_presets.rs
new file mode 100644
index 000000000..974657dcb
--- /dev/null
+++ b/crates/tools/src/form_mill_presets.rs
@@ -0,0 +1,221 @@
+//! The form mill presets (#3369): the outline of a roundover, cove, ogee,
+//! V-groove or bead router bit, written from the numbers the public router
+//! bit catalogues state. Quarter arcs tangent to the pilot and the body,
+//! and a ball tangent to a cone, are elementary plane geometry. Our own
+//! design; no vendor source or file consulted.
+//!
+//! Every outline starts on the axis at the tip and climbs: the pilot
+//! bearing (when `pilot_len` is over 0), then the cutting edge, then the
+//! straight body to the cutting height. The radius never narrows upward.
+
+use serde::{Deserialize, Serialize};
+
+use crate::spun::SpunPoint;
+
+/// A segment shorter than this (mm) is not drawn: the cutting height then
+/// ends where the form ends.
+const MIN_STEP: f64 = 1e-6;
+
+/// A router bit preset with the numbers it is sold by, mm (the V-groove's
+/// angle in degrees). `pilot_radius` is the bearing's radius and the
+/// radius where the cut starts; `height` is the cutting height above the
+/// pilot.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum FormPreset {
+    /// Corner rounding: a concave quarter arc of `radius` from the pilot
+    /// out to the body.
+    Roundover { radius: f64, pilot_radius: f64, height: f64 },
+    /// A convex quarter arc of `radius` from the pilot out to the body.
+    Cove { radius: f64, pilot_radius: f64, height: f64 },
+    /// A concave arc of `radius`, a flat `step` across the axis, then a
+    /// convex arc of `radius2`.
+    Ogee { radius: f64, radius2: f64, step: f64, pilot_radius: f64, height: f64 },
+    /// A cone of `angle` (included, degrees) to `diameter`, its tip
+    /// rounded by a ball of `tip_radius` (0 = sharp). No pilot.
+    VGroove { angle: f64, tip_radius: f64, diameter: f64, height: f64 },
+    /// A beading bit: a flat `step` out from the pilot (the quirk), then
+    /// a concave quarter arc of `radius`.
+    Bead { radius: f64, step: f64, pilot_radius: f64, height: f64 },
+}
+
+/// The preset names, in [`FormPreset::index`] order.
+pub const NAMES: [&str; 5] = ["Roundover", "Cove", "Ogee", "V-groove", "Bead"];
+
+impl FormPreset {
+    /// The preset names, in [`FormPreset::index`] order.
+    pub const NAMES: [&'static str; 5] = NAMES;
+
+    /// The position of this preset in [`NAMES`].
+    #[must_use]
+    pub fn index(&self) -> usize {
+        match self {
+            Self::Roundover { .. } => 0,
+            Self::Cove { .. } => 1,
+            Self::Ogee { .. } => 2,
+            Self::VGroove { .. } => 3,
+            Self::Bead { .. } => 4,
+        }
+    }
+
+    /// The preset's name, as the editor and the refusals say it.
+    #[must_use]
+    pub fn name(&self) -> &'static str {
+        NAMES.get(self.index()).copied().unwrap_or("form")
+    }
+
+    /// Plausible starting numbers for the preset at `index` (a 1/2 inch
+    /// router bit class, in mm); anything past the list is a roundover.
+    #[must_use]
+    pub fn starter(index: usize) -> Self {
+        match index {
+            1 => Self::Cove { radius: 6.35, pilot_radius: 6.35, height: 9.5 },
+            2 => Self::Ogee { radius: 4.0, radius2: 4.0, step: 1.5, pilot_radius: 6.35, height: 12.7 },
+            3 => Self::VGroove { angle: 90.0, tip_radius: 0.0, diameter: 12.7, height: 6.35 },
+            4 => Self::Bead { radius: 6.35, step: 1.6, pilot_radius: 6.35, height: 9.5 },
+            _ => Self::Roundover { radius: 6.35, pilot_radius: 6.35, height: 9.5 },
+        }
+    }
+
+    /// The preset's numbers by label, for the editor's rows.
+    #[must_use]
+    pub fn numbers_mut(&mut self) -> Vec<(&'static str, &mut f64)> {
+        match self {
+            Self::Roundover { radius, pilot_radius, height } | Self::Cove { radius, pilot_radius, height } => {
+                vec![("Radius", radius), ("Pilot radius", pilot_radius), ("Cutting height", height)]
+            }
+            Self::Ogee { radius, radius2, step, pilot_radius, height } => vec![
+                ("Lower radius", radius),
+                ("Upper radius", radius2),
+                ("Step", step),
+                ("Pilot radius", pilot_radius),
+                ("Cutting height", height),
+            ],
+            Self::VGroove { angle, tip_radius, diameter, height } => vec![
+                ("Included angle (deg)", angle),
+                ("Tip radius", tip_radius),
+                ("Cutting diameter", diameter),
+                ("Cutting height", height),
+            ],
+            Self::Bead { radius, step, pilot_radius, height } => {
+                vec![("Radius", radius), ("Step", step), ("Pilot radius", pilot_radius), ("Cutting height", height)]
+            }
+        }
+    }
+
+    /// The outline these numbers write over a pilot of `pilot_len`, tip
+    /// up, or why the numbers make no bit (refused by name).
+    pub fn points(&self, pilot_len: f64) -> Result<Vec<SpunPoint>, String> {
+        let name = self.name();
+        let mut nums = *self;
+        for (label, v) in nums.numbers_mut() {
+            if !v.is_finite() || *v < 0.0 {
+                return Err(format!("a {name} form's {} {} must be a finite number of 0 or more", label.to_lowercase(), v));
+            }
+        }
+        if !(pilot_len.is_finite() && pilot_len >= 0.0) {
+            return Err(format!("a form mill's pilot length {pilot_len} mm must be a finite number of 0 or more"));
+        }
+        let line = SpunPoint::line;
+        let over = |label: &str, v: f64| {
+            (v > 0.0).then_some(()).ok_or_else(|| format!("a {name} form's {label} {v} must be over 0"))
+        };
+        match *self {
+            Self::VGroove { angle, tip_radius, diameter, height } => {
+                if pilot_len > 0.0 {
+                    return Err(format!("a V-groove form has no pilot bearing; its pilot length must be 0, not {pilot_len} mm"));
+                }
+                if !(angle > 0.0 && angle < 180.0) {
+                    return Err(format!("a V-groove form's included angle {angle} degrees must be over 0 and under 180"));
+                }
+                over("cutting diameter", diameter)?;
+                let half = (angle * 0.5).to_radians();
+                let (r, tan) = (diameter * 0.5, half.tan());
+                let mut p = vec![SpunPoint { z: 0.0, r: 0.0, arc: tip_radius }];
+                let tangent = (tip_radius * (1.0 - half.sin()), tip_radius * half.cos());
+                if tip_radius > 0.0 {
+                    if tangent.1 >= r - MIN_STEP {
+                        return Err(format!("a V-groove form's tip radius {tip_radius} mm leaves no cone under its {diameter} mm cutting diameter"));
+                    }
+                    p.push(line(tangent.0, tangent.1));
+                }
+                let cone_top = tangent.0 + (r - tangent.1) / tan;
+                p.push(line(cone_top, r));
+                top_out(p, cone_top, height, r, name)
+            }
+            Self::Roundover { radius, pilot_radius, height } => {
+                over("radius", radius)?;
+                let mut p = foot(pilot_len, pilot_radius, name)?;
+                set_arc(&mut p, -radius);
+                p.push(line(pilot_len + radius, pilot_radius + radius));
+                top_out(p, radius, height, pilot_radius + radius, name)
+            }
+            Self::Cove { radius, pilot_radius, height } => {
+                over("radius", radius)?;
+                let mut p = foot(pilot_len, pilot_radius, name)?;
+                set_arc(&mut p, radius);
+                p.push(line(pilot_len + radius, pilot_radius + radius));
+                top_out(p, radius, height, pilot_radius + radius, name)
+            }
+            Self::Ogee { radius, radius2, step, pilot_radius, height } => {
+                over("lower radius", radius)?;
+                over("upper radius", radius2)?;
+                let mut p = foot(pilot_len, pilot_radius, name)?;
+                set_arc(&mut p, -radius);
+                let (z1, r1) = (pilot_len + radius, pilot_radius + radius);
+                p.push(line(z1, r1));
+                if step > MIN_STEP {
+                    p.push(line(z1, r1 + step));
+                }
+                set_arc(&mut p, radius2);
+                let r2 = r1 + step + radius2;
+                p.push(line(z1 + radius2, r2));
+                top_out(p, radius + radius2, height, r2, name)
+            }
+            Self::Bead { radius, step, pilot_radius, height } => {
+                over("radius", radius)?;
+                over("step", step)?;
+                let mut p = foot(pilot_len, pilot_radius, name)?;
+                let r0 = pilot_radius + step;
+                p.push(line(pilot_len, r0));
+                set_arc(&mut p, -radius);
+                p.push(line(pilot_len + radius, r0 + radius));
+                top_out(p, radius, height, r0 + radius, name)
+            }
+        }
+    }
+}
+
+/// The tip and the pilot: the axis, out to the pilot radius, and up the
+/// bearing when it has a length.
+fn foot(pilot_len: f64, pilot_radius: f64, name: &str) -> Result<Vec<SpunPoint>, String> {
+    if pilot_radius <= 0.0 {
+        return Err(format!("a {name} form's pilot radius {pilot_radius} mm must be over 0"));
+    }
+    let mut p = vec![SpunPoint::line(0.0, 0.0), SpunPoint::line(0.0, pilot_radius)];
+    if pilot_len > MIN_STEP {
+        p.push(SpunPoint::line(pilot_len, pilot_radius));
+    }
+    Ok(p)
+}
+
+/// Make the segment from the last point an arc of signed radius `arc`.
+fn set_arc(p: &mut [SpunPoint], arc: f64) {
+    if let Some(last) = p.last_mut() {
+        last.arc = arc;
+    }
+}
+
+/// The straight body from the form's top (`form` above the pilot) to the
+/// cutting height, at radius `r`. A cutting height under the form is
+/// refused by name.
+fn top_out(mut p: Vec<SpunPoint>, form: f64, height: f64, r: f64, name: &str) -> Result<Vec<SpunPoint>, String> {
+    if height < form - MIN_STEP {
+        return Err(format!("a {name} form's cutting height {height} mm is under the {form:.3} mm its form needs"));
+    }
+    let top = p.last().map_or(0.0, |q| q.z) + (height - form);
+    if height - form > MIN_STEP {
+        p.push(SpunPoint::line(top, r));
+    }
+    Ok(p)
+}
diff --git a/crates/tools/src/form_mill_tests.rs b/crates/tools/src/form_mill_tests.rs
new file mode 100644
index 000000000..637c2afd9
--- /dev/null
+++ b/crates/tools/src/form_mill_tests.rs
@@ -0,0 +1,153 @@
+//! #3369: the form mill - each preset writes a valid outline whose
+//! cutting radius is its catalogue numbers', the pilot does not cut, an
+//! undercut and a disagreeing outline are refused by name, and the side
+//! view never falls inside the form.
+
+use super::*;
+use crate::meridian::Bound;
+use crate::undercut::cutter;
+
+/// A form mill of `preset` over a pilot of `pilot_len`, settled.
+fn mill(preset: FormPreset, pilot_len: f64) -> Tool {
+    let mut t = cutter(ToolKind::FormMill, 1.0, 1.0, 12.7, 30.0, 0.0);
+    t.form = Some(FormSpec { preset: Some(preset), pilot_len, points: Vec::new() });
+    settle(&mut t);
+    t
+}
+
+/// The widest radius the meridian's cutting segments reach.
+fn cutting_radius(t: &Tool) -> f64 {
+    let m = t.meridian().unwrap_or_else(|e| panic!("{}: {e}", t.kind));
+    m.points().windows(2).zip(m.cutting()).filter(|(_, c)| **c).fold(0.0, |r, (w, _)| r.max(w[0].r).max(w[1].r))
+}
+
+#[test]
+fn each_preset_meets_its_catalogue_radius() {
+    // (preset, pilot length, cutting radius, flute length): the radius is
+    // the pilot radius plus the form across the axis.
+    let cases = [
+        (FormPreset::Roundover { radius: 6.35, pilot_radius: 6.35, height: 12.7 }, 4.76, 12.7, 17.46),
+        (FormPreset::Roundover { radius: 6.0, pilot_radius: 6.5, height: 6.0 }, 0.0, 12.5, 6.0),
+        (FormPreset::Cove { radius: 6.0, pilot_radius: 6.5, height: 13.0 }, 5.0, 12.5, 18.0),
+        (FormPreset::Ogee { radius: 4.0, radius2: 3.0, step: 1.5, pilot_radius: 6.35, height: 12.7 }, 5.0, 14.85, 17.7),
+        (FormPreset::VGroove { angle: 90.0, tip_radius: 0.0, diameter: 12.7, height: 6.35 }, 0.0, 6.35, 6.35),
+        (FormPreset::VGroove { angle: 60.0, tip_radius: 0.5, diameter: 12.0, height: 15.0 }, 0.0, 6.0, 15.0),
+        (FormPreset::Bead { radius: 6.35, step: 1.6, pilot_radius: 6.35, height: 9.5 }, 5.0, 14.3, 14.5),
+    ];
+    for (preset, pilot, r, fl) in cases {
+        let t = mill(preset, pilot);
+        assert_eq!(t.why_not_sane(), None, "{}: {t:?}", preset.name());
+        assert!((cutting_radius(&t) - r).abs() < 1e-9, "{}: cuts at {} not {r}", preset.name(), cutting_radius(&t));
+        assert!((t.diameter - 2.0 * r).abs() < 1e-9, "{}: diameter {}", preset.name(), t.diameter);
+        assert!((t.flute_len - fl).abs() < 1e-9, "{}: flute length {}", preset.name(), t.flute_len);
+        // The solid atoms of the meridian build without a refusal.
+        let m = t.meridian().unwrap_or_else(|e| panic!("{e}"));
+        assert!(m.atoms(Bound::Outer, 1e-3).is_ok(), "{}", preset.name());
+    }
+}
+
+#[test]
+fn the_pilot_band_does_not_cut() {
+    let t = mill(FormPreset::Roundover { radius: 6.35, pilot_radius: 6.35, height: 12.7 }, 4.76);
+    let m = t.meridian().unwrap_or_else(|e| panic!("{e}"));
+    // The tip face and the bearing's side are the pilot; the arc and the
+    // body above it cut.
+    assert_eq!(m.cutting(), &[false, false, true, true]);
+    assert!(m.points()[1..3].iter().all(|p| (p.r - 6.35).abs() < 1e-12), "the bearing is a band of its own radius");
+    let none = mill(FormPreset::Roundover { radius: 6.35, pilot_radius: 6.35, height: 12.7 }, 0.0);
+    assert!(none.meridian().map(|m| m.cutting().iter().all(|c| *c)).unwrap_or(false), "no pilot: every segment cuts");
+}
+
+#[test]
+fn bad_preset_numbers_are_refused_by_name() {
+    let why = |p: FormPreset, pilot: f64| refusal(&mill(p, pilot)).unwrap_or_default();
+    assert!(why(FormPreset::Roundover { radius: 6.0, pilot_radius: 6.0, height: 3.0 }, 0.0).contains("cutting height 3 mm is under"));
+    assert!(why(FormPreset::Cove { radius: 0.0, pilot_radius: 6.0, height: 9.0 }, 0.0).contains("radius 0 must be over 0"));
+    assert!(why(FormPreset::Bead { radius: 6.0, step: 1.0, pilot_radius: 0.0, height: 9.0 }, 0.0).contains("pilot radius 0 mm"));
+    assert!(why(FormPreset::VGroove { angle: 90.0, tip_radius: 0.0, diameter: 12.0, height: 6.0 }, 2.0).contains("no pilot bearing"));
+    assert!(why(FormPreset::VGroove { angle: 180.0, tip_radius: 0.0, diameter: 12.0, height: 6.0 }, 0.0).contains("included angle"));
+    assert!(why(FormPreset::VGroove { angle: 90.0, tip_radius: 9.0, diameter: 12.0, height: 9.0 }, 0.0).contains("tip radius 9 mm"));
+    assert!(why(FormPreset::Ogee { radius: f64::NAN, radius2: 3.0, step: 1.0, pilot_radius: 6.0, height: 9.0 }, 0.0).contains("finite"));
+}
+
+/// A drawn outline: on the axis, out to 5, up, then the radius narrows -
+/// an undercut, refused by name and left to #896.
+#[test]
+fn an_undercut_outline_is_refused_by_name() {
+    let mut t = cutter(ToolKind::FormMill, 12.0, 10.0, 6.0, 30.0, 0.0);
+    let drawn = |pts: Vec<[f64; 3]>| FormSpec { preset: None, pilot_len: 0.0, points: pts };
+    t.form = Some(drawn(vec![[0.0, 0.0, 0.0], [0.0, 6.0, 0.0], [5.0, 6.0, 0.0], [10.0, 4.0, 0.0]]));
+    let why = refusal(&t).unwrap_or_default();
+    assert!(why.contains("narrows upward from point 3") && why.contains("#896"), "{why}");
+    // A convex arc past its widest point narrows too (a half bead).
+    t.form = Some(drawn(vec![[0.0, 0.0, 0.0], [0.0, 3.0, 3.0], [6.0, 3.0, 0.0]]));
+    t.diameter = 12.0;
+    t.flute_len = 6.0;
+    assert!(refusal(&t).unwrap_or_default().contains("narrows upward from point 2"));
+    // A sound drawn outline passes.
+    t.form = Some(drawn(vec![[0.0, 0.0, 0.0], [0.0, 3.0, 3.0], [3.0, 6.0, 0.0], [10.0, 6.0, 0.0]]));
+    t.flute_len = 10.0;
+    assert_eq!(t.why_not_sane(), None);
+}
+
+#[test]
+fn the_outline_owns_the_diameter_and_the_kind_owns_the_form() {
+    let mut t = mill(FormPreset::Cove { radius: 6.0, pilot_radius: 6.5, height: 13.0 }, 5.0);
+    t.diameter = 24.0;
+    assert!(refusal(&t).unwrap_or_default().contains("25.0000 mm and 18.0000 mm, not 24 mm"));
+    t.diameter = 25.0;
+    if let Some(f) = t.form.as_mut() {
+        f.points[3][1] += 0.5;
+    }
+    assert!(refusal(&t).unwrap_or_default().contains("not the one its Cove numbers write"));
+    let mut em = cutter(ToolKind::EndMill, 6.0, 20.0, 6.0, 30.0, 0.0);
+    em.form = mill(FormPreset::starter(0), 5.0).form;
+    assert!(em.why_not_sane().unwrap_or_default().contains("only a form mill has a form outline"));
+    let bare = cutter(ToolKind::FormMill, 6.0, 20.0, 6.0, 30.0, 0.0);
+    assert!(bare.why_not_sane().unwrap_or_default().contains("needs a form outline"));
+    assert!(bare.meridian().is_err(), "no outline, no meridian");
+}
+
+#[test]
+fn the_side_view_never_falls_inside_the_form() {
+    for i in 0..FormPreset::NAMES.len() {
+        let pilot = if i == 3 { 0.0 } else { 5.0 };
+        let t = mill(FormPreset::starter(i), pilot);
+        let prof = t.profile();
+        let m = t.meridian().unwrap_or_else(|e| panic!("{e}"));
+        let atoms = m.atoms(Bound::Outer, 1e-4).unwrap_or_else(|e| panic!("{e}"));
+        // At each profile vertex inside the flutes, the profile's radius
+        // is at least the form's (a convex arc is drawn by its tangent
+        // polygon, a concave one by its chords).
+        for &(z, _) in prof.iter().filter(|p| p.0 > 1e-9 && p.0 < t.flute_len - 1e-9) {
+            // A flat step has two vertices at one z: the wider one counts.
+            let r = prof.iter().filter(|q| (q.0 - z).abs() < 1e-12).fold(0.0, |m, q| m.max(q.1));
+            let want = atoms.iter().filter(|a| a.z0 - 1e-12 <= z && z <= a.z1 + 1e-12).fold(0.0, |m, a| m.max(a.rho(z)));
+            assert!(r >= want - 1e-3, "{}: the side view is {r} at z {z}, the form {want}", FormPreset::NAMES[i]);
+        }
+        let top = prof.iter().filter(|p| p.0 <= t.flute_len + 1e-9).fold(0.0, |m, p| m.max(p.1));
+        assert!((top - t.diameter * 0.5).abs() < 1e-9, "{}: the widest cut is the diameter", FormPreset::NAMES[i]);
+    }
+}
+
+#[test]
+fn a_number_edit_keeps_the_drawn_form() {
+    let t = mill(FormPreset::starter(0), 5.0);
+    let longer = Tool { shank_len: t.shank_len + 10.0, ..t.clone() };
+    assert_eq!(longer.form, t.form, "a shank edit keeps the outline");
+    assert_eq!(longer.why_not_sane(), None);
+    assert!(!crate::cutter_fit::same_shape(&t, &Tool { form: mill(FormPreset::starter(1), 5.0).form, ..t.clone() }));
+    // Settling again changes nothing: the preset and its outline agree.
+    let mut again = t.clone();
+    settle(&mut again);
+    assert_eq!(again, t);
+}
+
+#[test]
+fn the_wire_form_round_trips() {
+    let t = mill(FormPreset::Ogee { radius: 4.0, radius2: 3.0, step: 1.5, pilot_radius: 6.35, height: 12.7 }, 5.0);
+    let json = serde_json::to_string(&t.form).unwrap_or_default();
+    assert!(json.contains("\"kind\":\"ogee\"") && json.contains("\"pilot_len\":5.0"), "{json}");
+    let back: Option<FormSpec> = serde_json::from_str(&json).unwrap_or_else(|e| panic!("{e}"));
+    assert_eq!(back, t.form);
+}
