diff --git a/crates/app/tests/wire_dxf_selection/arcs.rs b/crates/app/tests/wire_dxf_selection/arcs.rs
new file mode 100644
index 000000000..7f324b6d2
--- /dev/null
+++ b/crates/app/tests/wire_dxf_selection/arcs.rs
@@ -0,0 +1,144 @@
+//! A selected DXF chain with arcs (#3937): a die circle and a line-and-arc
+//! punch cut as true arcs, verified by the wire laws and posted as G2 / G3
+//! with I J through the generic ISO, Sodick and G-EDM wire posts, each to
+//! its golden. TEXT and DIMENSION entities no longer block the cut.
+//!
+//! Regenerate the goldens after an intentional change, then read the diff:
+//! `WRITE_GOLDEN=1 cargo test -p camcraft-app --test wire_dxf_selection arcs`
+
+use super::*;
+
+const ISO: &str = "Generic ISO Wire EDM";
+const SODICK: &str = "Sodick Wire EDM (Mark 21)";
+const GEDM: &str = "G-EDM Wire EDM";
+const GEDM_FIXTURE: &str = include_str!("../edm/g-edm-fixture.mch");
+
+/// A radius 5 circle about the drawing's origin, with a TEXT and a
+/// DIMENSION entity beside it.
+const DIE: &str = "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n\
+    0\nCIRCLE\n8\noutline\n10\n0\n20\n0\n40\n5\n\
+    0\nTEXT\n8\nnotes\n10\n20\n20\n20\n40\n2\n1\nDIE 10\n\
+    0\nDIMENSION\n8\nnotes\n10\n-5\n20\n-8\n0\nENDSEC\n0\nEOF\n";
+
+/// A 20 x 20 L about the origin: its corner at (10, -10) rounded by a
+/// radius 3 fillet (bulge tan(22.5 degrees)), a sharp inside corner at
+/// (0, 0).
+const PUNCH: &str = "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n\
+    0\nLWPOLYLINE\n8\noutline\n90\n7\n70\n1\n10\n-10\n20\n-10\n10\n7\n20\n-10\n42\n0.41421356237309503\n\
+    10\n10\n20\n-7\n10\n10\n20\n0\n10\n0\n20\n0\n10\n0\n20\n10\n10\n-10\n20\n10\n0\nENDSEC\n0\nEOF\n";
+
+/// The drawing point (`x`, `y`) in world XY.
+fn to_world(world: &World, x: f64, y: f64) -> [f64; 2] {
+    let (e, _) = sketch::find(world, "drawing").expect("drawing");
+    let pose = sketch::world_pose(world, &e).expect("placed");
+    let q = camcraft_app::geometry::transform_point(Point3::new(x, y, 0.0), pose.pos, pose.rot);
+    [q.x, q.y]
+}
+
+/// `dxf` placed and picked as `document` does, on `machine`, cut on
+/// `side` from the drawing point `hole` under `condition`.
+fn doc(dxf: &str, machine: &str, condition: &str, side: WireSide, hole: (f64, f64), sharp: bool) -> World {
+    let (world, mut h) = document(dxf);
+    if machine != FIXTURE {
+        let m = machine::parse_mch(machine).expect("machine");
+        h.execute(&world, LoadMachine::new(&world, "wire.mch".into(), Some(m)).expect("mount"));
+    }
+    let op = WireContourOp {
+        condition: condition.into(),
+        side,
+        start: Some(to_world(&world, hole.0, hole.1)),
+        sharp_corners: sharp,
+        ..wire_op()
+    };
+    h.execute(&world, EditOperationParams::new(&world, "Cut", OpParams::WireContour(op)).expect("edit"));
+    world
+}
+
+fn generated(world: &World) -> camcraft_app::cl::Toolpath {
+    let cmd = GenerateOperation::new(world, "Cut").unwrap_or_else(|e| panic!("generates: {e}"));
+    let mut h = History::default();
+    h.execute(world, cmd);
+    let e = model::find_by_name(world, "Cut").expect("operation");
+    let verdict = operation::wire_verify::wire_verdict(world, &e).expect("wire").expect("verifiable");
+    assert!(verdict.findings.is_empty() && verdict.captured && verdict.slugs.len() == 1, "{verdict:?}");
+    model::toolpath_of(world, &e).expect("cache").path.clone()
+}
+
+/// Post through `post` and hold the program to `golden`.
+fn golden(world: &World, post: &str, golden: &str) -> String {
+    let file = std::env::temp_dir().join(format!("camcraft-dxf-arcs-{}-{}.nc", std::process::id(), golden.replace('/', "-")));
+    let nc = posting::post_script(world, &file, posting::builtin_post_text(post).expect("post"))
+        .unwrap_or_else(|e| panic!("{post} posts: {e}"))
+        .program;
+    let _ = std::fs::remove_file(file);
+    let path = format!("tests/golden/nc/{golden}");
+    if std::env::var_os("WRITE_GOLDEN").is_some() {
+        std::fs::write(&path, &nc).expect("write golden");
+    }
+    let want = std::fs::read_to_string(&path).expect("golden present");
+    assert_eq!(nc, want, "{post} drifted from {golden}");
+    nc
+}
+
+fn arc_blocks(nc: &str) -> Vec<&str> {
+    nc.lines().filter(|l| l.starts_with("G2 ") || l.starts_with("G3 ") || l.starts_with("G02") || l.starts_with("G03")).collect()
+}
+
+#[test]
+fn die_circle_cuts_two_half_arcs_from_its_centre_and_posts_g3_with_ij() {
+    let world = doc(DIE, FIXTURE, "C110", WireSide::Die, (0.0, 0.0), false);
+    let path = generated(&world);
+    assert_eq!(path.arc_count(), 2, "{:?}", path.moves);
+    assert!(path.notes.iter().any(|n| n.contains("towards +X")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("2 TEXT, MTEXT or DIMENSION entities")), "{:?}", path.notes);
+    // The arcs stand on the kerf circle about the drawn centre.
+    let c = to_world(&world, 0.0, 0.0);
+    for m in path.moves.iter().filter(|m| m.arc.is_some()) {
+        let a = m.arc.expect("arc");
+        assert!((a.center.x - c[0]).abs() < 1e-9 && (a.center.y - c[1]).abs() < 1e-9, "{a:?}");
+        let r = (m.to.x - c[0]).hypot(m.to.y - c[1]);
+        assert!((r - (5.0 - 0.165)).abs() < 1e-9, "{r}");
+    }
+    let nc = golden(&world, ISO, "wire-iso/wire_dxf_die_circle.nc");
+    let arcs = arc_blocks(&nc);
+    assert_eq!(arcs.len(), 2, "{nc}");
+    // Each half arc turns counter-clockwise about the centre: I = -4.835 or +4.835.
+    assert!(arcs.iter().all(|l| l.starts_with("G3") && (l.contains("I-4.835") || l.contains("I4.835"))), "{arcs:?}");
+    let nc = golden(&world, SODICK, "sodick-wire/wire_dxf_die_circle.nc");
+    assert_eq!(arc_blocks(&nc).len(), 2, "{nc}");
+    let gedm = doc(DIE, GEDM_FIXTURE, "R1", WireSide::Die, (0.0, 0.0), false);
+    generated(&gedm);
+    let nc = golden(&gedm, GEDM, "g-edm/wire_dxf_die_circle.nc");
+    assert_eq!(arc_blocks(&nc).len(), 2, "{nc}");
+}
+
+#[test]
+fn line_and_arc_punch_pivots_its_corners_and_posts_its_goldens() {
+    let world = doc(PUNCH, FIXTURE, "C110", WireSide::Punch, (20.0, 0.0), true);
+    let path = generated(&world);
+    // The fillet, and a pivot about each of the four sharp outside corners.
+    assert_eq!(path.arc_count(), 5, "{:?}", path.moves);
+    assert!(path.notes.iter().any(|n| n.contains("sharp inside corners stated")), "{:?}", path.notes);
+    for (post, file) in [(ISO, "wire-iso/wire_dxf_punch_fillet.nc"), (SODICK, "sodick-wire/wire_dxf_punch_fillet.nc")] {
+        let nc = golden(&world, post, file);
+        assert_eq!(arc_blocks(&nc).len(), 5, "{nc}");
+    }
+    let gedm = doc(PUNCH, GEDM_FIXTURE, "R1", WireSide::Punch, (20.0, 0.0), true);
+    generated(&gedm);
+    let nc = golden(&gedm, GEDM, "g-edm/wire_dxf_punch_fillet.nc");
+    assert_eq!(arc_blocks(&nc).len(), 5, "{nc}");
+}
+
+#[test]
+fn arcs_stay_refused_for_taper_and_a_hatch_still_blocks_the_cut() {
+    let world = doc(DIE, FIXTURE, "C110", WireSide::Die, (0.0, 0.0), false);
+    let tapered = WireContourOp { start: Some(to_world(&world, 0.0, 0.0)), taper_deg: 1.0, ..wire_op() };
+    let mut h = History::default();
+    h.execute(&world, EditOperationParams::new(&world, "Cut", OpParams::WireContour(tapered)).expect("taper"));
+    let why = refusal(&world);
+    assert!(why.contains("single vertical pass"), "{why}");
+    let hatch = DIE.replace("0\nENDSEC\n0\nEOF", "0\nHATCH\n8\nnotes\n0\nENDSEC\n0\nEOF");
+    let world = doc(&hatch, FIXTURE, "C110", WireSide::Die, (0.0, 0.0), false);
+    let why = refusal(&world);
+    assert!(why.contains("skipped 1 HATCH entity"), "{why}");
+}
diff --git a/crates/motion/src/wire_edm/arc_chain.rs b/crates/motion/src/wire_edm/arc_chain.rs
new file mode 100644
index 000000000..0fb814730
--- /dev/null
+++ b/crates/motion/src/wire_edm/arc_chain.rs
@@ -0,0 +1,216 @@
+//! The analytic wire profile (#3937): one closed chain of lines, arcs and
+//! circles as the drawing states it, walked counter-clockwise, its joint
+//! gaps measured and held under a stated tolerance.
+//!
+//! Provenance: plane geometry (Green's theorem for the enclosed area,
+//! inscribed and circumscribed chords of a circle for the waste-side
+//! ring). Our own implementation.
+
+use std::f64::consts::TAU;
+
+use camcraft_geometry::dxf::Primitive;
+use camcraft_geometry::sketch_chains::ClosedChain;
+
+use crate::geo2d::{Loop, Point2, Region};
+use crate::machining2d::GenError;
+
+use super::arc_span::{cross, dist, sub, Span};
+use super::WireSide;
+
+/// The widest joint gap (mm) the wire path accepts between two spans of
+/// the drawing: 0.25 um. Arc ends computed from a centre and an angle
+/// seldom meet a line's end bit for bit; a gap under this is charged to
+/// the path's waste-side margin (`arc_cut`), a wider one is refused.
+pub const JOINT_TOL: f64 = 2.5e-4;
+
+fn invalid(why: String) -> GenError {
+    GenError::Invalid(format!("wire contour: {why}"))
+}
+
+/// A closed line / arc chain, counter-clockwise.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ArcChain {
+    spans: Vec<Span>,
+    max_gap: f64,
+}
+
+impl ArcChain {
+    /// The chain from its spans in walk order. Refused: an empty chain, a
+    /// non-finite or zero-length span, a joint gap past [`JOINT_TOL`], or
+    /// no enclosed area. A clockwise chain is reversed.
+    ///
+    /// # Errors
+    /// Each refusal by name.
+    pub fn new(spans: Vec<Span>) -> Result<ArcChain, GenError> {
+        if spans.is_empty() {
+            return Err(GenError::Empty("wire contour: no profile to cut".into()));
+        }
+        for (i, s) in spans.iter().enumerate() {
+            let ok = match *s {
+                Span::Line { a, b } => fin(a) && fin(b) && dist(a, b) > 0.0,
+                Span::Arc { c, r, a, b, sweep, .. } => {
+                    fin(c) && fin(a) && fin(b) && r.is_finite() && r > 0.0 && sweep > 0.0 && sweep <= TAU + 1e-9
+                }
+            };
+            if !ok {
+                return Err(invalid(format!("span {} of the profile is degenerate (no length, or not a finite curve)", i + 1)));
+            }
+        }
+        let n = spans.len();
+        let mut max_gap: f64 = 0.0;
+        for i in 0..n {
+            let (e, s) = (spans[i].end(), spans[(i + 1) % n].start());
+            let g = dist(e, s);
+            if g.is_nan() || g > JOINT_TOL {
+                return Err(GenError::invalid_at(
+                    format!(
+                        "wire contour: the profile has a joint gap of {g:.6} mm near X{:.3} Y{:.3} - the wire path accepts at most {JOINT_TOL} mm; close the drawing's joint",
+                        e.x, e.y
+                    ),
+                    crate::geometry::Point3::new(e.x, e.y, 0.0),
+                ));
+            }
+            max_gap = max_gap.max(g);
+        }
+        let mut chain = ArcChain { spans, max_gap };
+        let area = chain.area();
+        if !(area.is_finite() && area.abs() > 1e-6) {
+            return Err(invalid("the profile has no area (a zero-length or collinear ring) - there is nothing to cut around".into()));
+        }
+        if area < 0.0 {
+            chain.spans = chain.spans.iter().rev().map(reversed).collect();
+        }
+        Ok(chain)
+    }
+
+    /// The selected DXF chain, each point taken through `place` (a rigid
+    /// placement: a turn about Z and a shift, never a mirror).
+    ///
+    /// # Errors
+    /// As [`ArcChain::new`].
+    pub fn from_closed(chain: &ClosedChain, place: impl Fn(Point2) -> Point2) -> Result<ArcChain, GenError> {
+        let spans = chain
+            .segments
+            .iter()
+            .map(|seg| match seg.curve {
+                Primitive::Line { .. } => Span::Line { a: place(seg.start), b: place(seg.end) },
+                Primitive::Arc { center, radius, sweep_angle, .. } => Span::Arc {
+                    c: place(center),
+                    r: radius,
+                    a: place(seg.start),
+                    b: place(seg.end),
+                    ccw: sweep_angle > 0.0,
+                    sweep: sweep_angle.abs(),
+                },
+                Primitive::Circle { center, radius } => {
+                    let a = place(seg.start);
+                    Span::Arc { c: place(center), r: radius, a, b: a, ccw: true, sweep: TAU }
+                }
+            })
+            .collect();
+        ArcChain::new(spans)
+    }
+
+    #[must_use]
+    pub fn spans(&self) -> &[Span] {
+        &self.spans
+    }
+
+    /// The widest joint gap of the chain (mm), at most [`JOINT_TOL`].
+    #[must_use]
+    pub fn max_gap(&self) -> f64 {
+        self.max_gap
+    }
+
+    /// Whether every span is a line.
+    #[must_use]
+    pub fn straight(&self) -> bool {
+        self.spans.iter().all(|s| !s.is_arc())
+    }
+
+    /// The enclosed area (Green's theorem), counter-clockwise positive.
+    #[must_use]
+    pub fn area(&self) -> f64 {
+        self.spans
+            .iter()
+            .map(|s| match *s {
+                Span::Line { a, b } => 0.5 * cross(a, b),
+                Span::Arc { c, r, a, b, ccw, sweep } => {
+                    let signed = if ccw { sweep } else { -sweep };
+                    0.5 * (cross(c, sub(b, a)) + r * r * signed)
+                }
+            })
+            .sum()
+    }
+
+    #[must_use]
+    pub fn perimeter(&self) -> f64 {
+        self.spans.iter().map(Span::length).sum()
+    }
+
+    /// The chain as a polygon whose every edge lies on the WASTE side of
+    /// the true curve, within `sag` (mm) of it: chords inscribed in an arc
+    /// whose waste is toward its centre, circumscribed about one whose
+    /// waste is away from it. A region read from it holds the whole
+    /// product, so a check against it errs toward the product only by
+    /// stating more of it.
+    ///
+    /// # Errors
+    /// A `sag` that is not positive, or a ring that needs too many points.
+    pub fn waste_ring(&self, side: WireSide, sag: f64) -> Result<Loop, GenError> {
+        if !(sag.is_finite() && sag > 0.0) {
+            return Err(invalid(format!("the waste-side ring needs a positive sag, not {sag}")));
+        }
+        // Counter-clockwise: the inside (a die's waste) is to the left.
+        let waste_left = match side {
+            WireSide::Die => true,
+            WireSide::Punch => false,
+            WireSide::Left | WireSide::Right => return Err(invalid("a closed profile states its die or punch side".into())),
+        };
+        let mut pts = Vec::new();
+        for s in &self.spans {
+            pts.push(s.start());
+            let Span::Arc { c, r, a, ccw, sweep, .. } = *s else { continue };
+            // The arc's centre is to the left of its walk when it turns left.
+            let inscribed = ccw == waste_left;
+            let step = if inscribed { 2.0 * (1.0 - sag / r).clamp(-1.0, 1.0).acos() } else { 2.0 * (r / (r + sag)).acos() };
+            let n = (sweep / step).ceil();
+            if !(n.is_finite() && n <= 65_536.0) {
+                return Err(invalid(format!("an arc of radius {r:.4} mm needs more than 65536 points at {sag} mm - refused")));
+            }
+            let n = (n as usize).max(1);
+            let d = sweep / n as f64 * if ccw { 1.0 } else { -1.0 };
+            let a0 = (a.y - c.y).atan2(a.x - c.x);
+            if inscribed {
+                pts.extend((1..n).map(|j| on(c, r, a0 + d * j as f64)));
+            } else {
+                let rr = r / (d * 0.5).cos();
+                pts.extend((1..=n).map(|j| on(c, rr, a0 + d * (j as f64 - 0.5))));
+                pts.push(s.end());
+            }
+        }
+        Loop::new(pts).map_err(GenError::from)
+    }
+
+    /// Whether `q` stands inside the chain (read on a ring within 1 um).
+    pub(super) fn contains(&self, q: Point2) -> Result<bool, GenError> {
+        let ring = self.waste_ring(WireSide::Die, 1e-3)?;
+        Ok(Region::new(vec![ring])?.contains(q))
+    }
+}
+
+fn fin(p: Point2) -> bool {
+    p.x.is_finite() && p.y.is_finite()
+}
+
+fn on(c: Point2, r: f64, t: f64) -> Point2 {
+    let (s, co) = t.sin_cos();
+    Point2::new(c.x + r * co, c.y + r * s)
+}
+
+fn reversed(s: &Span) -> Span {
+    match *s {
+        Span::Line { a, b } => Span::Line { a: b, b: a },
+        Span::Arc { c, r, a, b, ccw, sweep } => Span::Arc { c, r, a: b, b: a, ccw: !ccw, sweep },
+    }
+}
diff --git a/crates/motion/src/wire_edm/arc_cut.rs b/crates/motion/src/wire_edm/arc_cut.rs
new file mode 100644
index 000000000..a4d9e37e1
--- /dev/null
+++ b/crates/motion/src/wire_edm/arc_cut.rs
@@ -0,0 +1,276 @@
+//! The wire contour of an analytic line-and-arc profile (#3937): the
+//! drawing's lines and arcs offset by the kerf (`arc_offset`), entered by
+//! a straight lead from the stated start hole to the path's nearest
+//! point, cut as true arcs, and certified by the laws read against the
+//! drawing itself (`arc_laws`).
+//!
+//! - **Seam.** The nearest point of the path to the start hole; on a
+//!   circle that is the point on the radius through the hole, so the lead
+//!   enters square to the path. A hole exactly at the centre of a
+//!   circular path has every point equally near: by rule the lead then
+//!   enters towards +X (of equally near points, the one at the least
+//!   counter-clockwise angle from +X wins), and the path says so.
+//! - **Arcs.** An arc of more than half a turn - a full circle above all,
+//!   which no single block states - is cut as two halves.
+//! - **Lattice and gaps.** A recorded arc's centre stands on the CL
+//!   lattice (`cl::lattice`, 1e-6 mm). Each arc is moved onto its lattice
+//!   centre with its radius kept, its ends taken along their radii. When
+//!   that move plus the drawing's widest joint gap passes [`MARGIN_FLOOR`],
+//!   the path is laid that much farther on the waste side, so the kerf
+//!   never reaches the product, and the path says so.
+//!
+//! Provenance: our own implementation over the public wire EDM practice
+//! the module head cites; RS-274 / ISO 6983 circular interpolation for
+//! the arc blocks (an arc is stated by its end and centre, a full turn
+//! needs more than one block on most controls).
+
+use std::f64::consts::TAU;
+
+use crate::cl::{lattice, MoveKind, PathBuilder, Toolpath};
+use crate::geo2d::{GeoError, Loop, Point2, Region};
+use crate::geometry::Point3;
+use crate::machining2d::GenError;
+
+use super::arc_chain::ArcChain;
+use super::arc_dist::{nearest, pt_span};
+use super::arc_laws;
+use super::arc_offset::parallel_walk;
+use super::arc_span::{dist, mul, sub, add, unit, Span};
+use super::{laws, WireParams, WireSide, MIN_LEAD};
+
+/// The least margin (mm) the path is moved out by: 1 nm. Under it the
+/// kerf law's own [`super::PATH_TOL`] (10 nm) holds the difference.
+const MARGIN_FLOOR: f64 = 1e-6;
+
+fn invalid(why: String) -> GenError {
+    GenError::Invalid(format!("wire contour: {why}"))
+}
+
+fn at3(p: Point2, z: f64) -> Point3 {
+    Point3::new(p.x, p.y, z)
+}
+
+fn on_lattice(c: Point2) -> Point2 {
+    Point2::new(lattice(c.x), lattice(c.y))
+}
+
+/// Cut the closed line-and-arc `chain` with the wire, as true arcs.
+///
+/// # Errors
+/// Every refusal of the module head and of the wire contour's, by name.
+pub fn wire_contour_arcs(chain: &ArcChain, p: &WireParams) -> Result<Toolpath, GenError> {
+    p.door()?;
+    if p.tabs.is_some() {
+        return Err(invalid("tabs are stated on a drawn line-and-arc profile - tabs are not cut on it yet; remove the tabs".into()));
+    }
+    let sign = match p.side {
+        WireSide::Die => 1.0,
+        WireSide::Punch => -1.0,
+        WireSide::Left | WireSide::Right => {
+            return Err(invalid(format!(
+                "the side is {} of travel, but the profile is closed - a closed profile states its die or punch side",
+                p.side.word()
+            )));
+        }
+    };
+    let k = p.kerf_offset();
+    let (first, miss) = parallel_walk(chain.spans(), sign * k, p.sharp_corners)?;
+    let snap = first
+        .iter()
+        .filter_map(|s| match *s {
+            Span::Arc { c, .. } => Some(dist(c, on_lattice(c))),
+            Span::Line { .. } => None,
+        })
+        .fold(0.0, f64::max);
+    let margin = snap + chain.max_gap() + miss;
+    let margin = if margin > MARGIN_FLOOR { margin } else { 0.0 };
+    let walk = if margin > 0.0 { parallel_walk(chain.spans(), sign * (k + margin), p.sharp_corners)?.0 } else { first };
+    simple(&walk, k)?;
+    let Some(start) = p.start else {
+        return Err(invalid(format!(
+            "no start hole is stated - a closed profile is cut from a threading point ({}); the wire cannot be threaded through solid material",
+            match p.side {
+                WireSide::Die => "a start hole in the slug, inside the profile",
+                _ => "a start hole or the stock's edge, outside the profile",
+            }
+        )));
+    };
+    start_side(chain, start, p)?;
+    let (seam, at, centred) = seam(&walk, start).ok_or_else(|| invalid("the wire path is empty".into()))?;
+    let lead = dist(start, at);
+    if !(lead.is_finite() && lead > MIN_LEAD) {
+        return Err(GenError::invalid_at(
+            format!(
+                "wire contour: the start hole at X{:.3} Y{:.3} stands on the wire path itself - move it off the profile by more than the kerf offset ({k:.4} mm)",
+                start.x, start.y
+            ),
+            at3(start, p.plane_z),
+        ));
+    }
+    let seq = stitch(from_seam(&walk, seam, at).iter().flat_map(Span::halves).map(snapped).collect());
+    let z = p.plane_z;
+    let mut b = PathBuilder::new(at3(start, z));
+    if let Some(first) = seq.first() {
+        b.push(MoveKind::Feed, at3(first.start(), z), None);
+    }
+    for s in &seq {
+        match *s {
+            Span::Line { b: e, .. } => b.push(MoveKind::Feed, at3(e, z), None),
+            Span::Arc { c, b: e, ccw, .. } => b.push_arc(MoveKind::Feed, at3(e, z), None, c, ccw),
+        }
+    }
+    b.push(MoveKind::Feed, at3(start, z), None);
+    let mut path = b.finish();
+    if path.moves.len() < 4 {
+        return Err(invalid("the wire path lays down no cut".into()));
+    }
+    arc_laws::kerf(&path, chain, k, z)?;
+    let rest = arc_laws::cover(&path, chain, p)?;
+    let mut said = super::pass_notes(p, start, lead, false);
+    let arcs = chain.spans().iter().filter(|s| s.is_arc()).count();
+    said.push(format!(
+        "wire EDM: the drawn profile is read exactly - {} line(s) and {arcs} arc(s); the path holds {} arc move(s) (G2/G3 on a post that writes arcs), concentric with the drawing's arcs, with pivot arcs about outside corners",
+        chain.spans().len() - arcs,
+        path.arc_count()
+    ));
+    if centred {
+        said.push("wire EDM: the start hole stands at the centre of the circular path - every path point is equally near, so by rule the lead enters towards +X".into());
+    }
+    if margin > 0.0 {
+        said.push(format!(
+            "wire EDM: the path stands {:.1} nm farther on the waste side - arc centres are written on the 1e-6 mm grid (up to {:.1} nm off the drawing's centres), the drawing's joints gap up to {:.1} nm, and near-tangent parallels are joined across up to {:.1} nm; this keeps the kerf out of the product",
+            margin * 1e6,
+            snap * 1e6,
+            chain.max_gap() * 1e6,
+            miss * 1e6
+        ));
+    }
+    said.extend(rest.map(|r| laws::sharp_note(r, k)));
+    path.notes.extend(said);
+    Ok(path)
+}
+
+/// The walk must not cross itself: a crossing is a neck under the kerf
+/// width, where the parallels of two far spans of the profile meet.
+fn simple(walk: &[Span], k: f64) -> Result<(), GenError> {
+    let sag = (k / 8.0).min(1e-3);
+    let mut pts = Vec::new();
+    for s in walk {
+        pts.push(s.start());
+        if let Span::Arc { r, sweep, .. } = *s {
+            let step = 2.0 * (1.0 - sag / r).clamp(-1.0, 1.0).acos();
+            let n = (sweep / step).ceil().clamp(2.0, 4096.0) as u32;
+            pts.extend((1..n).map(|j| s.point_at(f64::from(j) / f64::from(n))));
+        }
+    }
+    let neck = |at: Point2| {
+        GenError::invalid_at(
+            format!(
+                "wire contour: the profile narrows to a neck under the kerf width ({:.4} mm) near X{:.3} Y{:.3} - the wire's path crosses itself there; widen the profile or cut with a thinner wire",
+                2.0 * k,
+                at.x,
+                at.y
+            ),
+            at3(at, 0.0),
+        )
+    };
+    let at = pts.first().copied().unwrap_or(Point2::new(0.0, 0.0));
+    match Loop::new(pts).and_then(|l| Region::new(vec![l])) {
+        Ok(r) if r.loops().len() == 1 => Ok(()),
+        Ok(_) => Err(neck(at)),
+        Err(GeoError::Invalid(w)) if w.contains("crosses itself") => Err(neck(at)),
+        Err(e) => Err(invalid(format!("the wire path is unusable: {e}"))),
+    }
+}
+
+/// The start hole stands on the waste side, at least the kerf offset off
+/// the profile.
+fn start_side(chain: &ArcChain, start: Point2, p: &WireParams) -> Result<(), GenError> {
+    let k = p.kerf_offset();
+    let clear = chain.spans().iter().map(|s| pt_span(start, s)).fold(f64::INFINITY, f64::min);
+    let inside = chain.contains(start)?;
+    let why = if clear < k {
+        format!(
+            "the start hole at X{:.3} Y{:.3} stands closer to the profile than the kerf offset ({k:.4} mm) - the wire would burn the {} there; move it away from the profile",
+            start.x,
+            start.y,
+            p.side.word()
+        )
+    } else {
+        match (p.side, inside) {
+            (WireSide::Die, true) | (WireSide::Punch, false) => return Ok(()),
+            (WireSide::Die, false) => format!(
+                "the start hole at X{:.3} Y{:.3} lies outside the profile - a die is cut from a start hole inside it, in the slug",
+                start.x, start.y
+            ),
+            _ => format!(
+                "the start hole at X{:.3} Y{:.3} lies inside the profile - a punch is cut from outside it; the wire would burn through the punch",
+                start.x, start.y
+            ),
+        }
+    };
+    Err(GenError::invalid_at(format!("wire contour: {why}"), at3(start, p.plane_z)))
+}
+
+/// The seam: the index of the walk's span nearest `start`, the point on
+/// it, and whether `start` is the centre of that (circular) span. Equally
+/// near points go to the least counter-clockwise angle from +X.
+fn seam(walk: &[Span], start: Point2) -> Option<(usize, Point2, bool)> {
+    let near: Vec<(usize, f64, Point2)> = walk.iter().enumerate().map(|(i, s)| { let (d, q) = nearest(start, s); (i, d, q) }).collect();
+    let best = near.iter().map(|n| n.1).fold(f64::INFINITY, f64::min);
+    let angle = |q: Point2| (q.y - start.y).atan2(q.x - start.x).rem_euclid(TAU);
+    let (i, _, q) = near
+        .into_iter()
+        .filter(|n| n.1 <= best + 1e-9)
+        .min_by(|a, b| angle(a.2).total_cmp(&angle(b.2)))?;
+    let centred = matches!(walk[i], Span::Arc { c, .. } if dist(c, start) <= 1e-9);
+    Some((i, q, centred))
+}
+
+/// The closed walk re-ordered to start and end at `at` on span `i`.
+fn from_seam(walk: &[Span], i: usize, at: Point2) -> Vec<Span> {
+    let s = walk[i];
+    if let Span::Arc { c, r, ccw, .. } = s
+        && s.full()
+    {
+        return vec![Span::Arc { c, r, a: at, b: at, ccw, sweep: TAU }];
+    }
+    let (before, after) = s.split(at);
+    let n = walk.len();
+    after.into_iter().chain((1..n).map(|j| walk[(i + j) % n])).chain(before).collect()
+}
+
+/// An arc moved onto its lattice centre: radius kept, ends taken along
+/// their radii from that centre.
+fn snapped(s: Span) -> Span {
+    let Span::Arc { c, r, a, b, ccw, sweep } = s else { return s };
+    let c2 = on_lattice(c);
+    let onto = |q: Point2| unit(sub(q, c2)).map_or(q, |u| add(c2, mul(u, r)));
+    Span::Arc { c: c2, r, a: onto(a), b: onto(b), ccw, sweep }
+}
+
+/// Make each span start where the one before it ends: a line's end moves
+/// to its neighbour arc's, and two arcs that do not share their end are
+/// joined by a short line (no longer than the margin allows).
+fn stitch(seq: Vec<Span>) -> Vec<Span> {
+    let mut out: Vec<Span> = Vec::with_capacity(seq.len());
+    for mut s in seq {
+        let ss = s.start();
+        let mut joiner = None;
+        if let Some(last) = out.last_mut()
+            && last.end() != ss
+        {
+            let e = last.end();
+            if let Span::Line { b, .. } = last {
+                *b = ss;
+            } else if let Span::Line { a, .. } = &mut s {
+                *a = e;
+            } else {
+                joiner = Some(Span::Line { a: e, b: ss });
+            }
+        }
+        out.extend(joiner);
+        out.push(s);
+    }
+    out
+}
diff --git a/crates/motion/src/wire_edm/arc_dist.rs b/crates/motion/src/wire_edm/arc_dist.rs
new file mode 100644
index 000000000..786ae032a
--- /dev/null
+++ b/crates/motion/src/wire_edm/arc_dist.rs
@@ -0,0 +1,226 @@
+//! Exact distances and crossings between the spans of an analytic wire
+//! profile (#3937): point to line or arc, span to span, and the meets of
+//! two parallels at a corner.
+//!
+//! Provenance: textbook Euclidean geometry. The least distance between
+//! a segment and an arc that do not meet is at an end of one of them, or
+//! on the normal from the circle's centre to the segment; between two
+//! arcs at an end, or on the line of the two centres (the critical points
+//! of the distance between two circles). Line and circle crossings are
+//! the quadratic of the substitution. Our own implementation.
+
+use crate::geo2d::Point2;
+
+use super::arc_span::{add, cross, dist, dot, mul, sub, unit, Span};
+
+/// The point of segment `a`-`b` nearest `q`.
+pub(super) fn foot(q: Point2, a: Point2, b: Point2) -> Point2 {
+    let d = sub(b, a);
+    let l2 = dot(d, d);
+    if l2.is_nan() || l2 <= 0.0 {
+        return a;
+    }
+    let t = (dot(sub(q, a), d) / l2).clamp(0.0, 1.0);
+    add(a, mul(d, t))
+}
+
+/// The point of `s` nearest `q`, and its distance. On an arc whose centre
+/// is `q` itself every point is equally near: the point with the least
+/// counter-clockwise angle from +X wins (the stated tie rule, #3937).
+pub(super) fn nearest(q: Point2, s: &Span) -> (f64, Point2) {
+    match *s {
+        Span::Line { a, b } => {
+            let f = foot(q, a, b);
+            (dist(q, f), f)
+        }
+        Span::Arc { c, r, a, b, .. } => {
+            let Some(u) = unit(sub(q, c)) else {
+                return (r, tie_point(s));
+            };
+            if s.holds_dir(q) {
+                let p = add(c, mul(u, r));
+                return (dist(q, p), p);
+            }
+            let (da, db) = (dist(q, a), dist(q, b));
+            if db < da { (db, b) } else { (da, a) }
+        }
+    }
+}
+
+/// The arc's point at the least counter-clockwise angle from +X, seen from
+/// its centre: +X itself when the sweep holds it, else the nearer end in
+/// angle.
+pub(super) fn tie_point(s: &Span) -> Point2 {
+    let Span::Arc { c, r, a, b, .. } = *s else { return s.start() };
+    let east = Point2::new(c.x + r, c.y);
+    if s.holds_dir(east) {
+        return east;
+    }
+    let ang = |p: Point2| (p.y - c.y).atan2(p.x - c.x).rem_euclid(std::f64::consts::TAU);
+    if ang(b) < ang(a) { b } else { a }
+}
+
+pub(super) fn pt_span(q: Point2, s: &Span) -> f64 {
+    nearest(q, s).0
+}
+
+/// Where the line through `a`-`b` (parameter `t`, 0 at `a`) meets the
+/// circle about `c` of radius `r`.
+fn line_circle(a: Point2, b: Point2, c: Point2, r: f64) -> Vec<(f64, Point2)> {
+    let d = sub(b, a);
+    let f = sub(a, c);
+    let (qa, qb, qc) = (dot(d, d), 2.0 * dot(f, d), dot(f, f) - r * r);
+    if qa.is_nan() || qa <= 0.0 {
+        return Vec::new();
+    }
+    let disc = qb * qb - 4.0 * qa * qc;
+    if disc < 0.0 || !disc.is_finite() {
+        return Vec::new();
+    }
+    let sq = disc.sqrt();
+    [(-qb - sq) / (2.0 * qa), (-qb + sq) / (2.0 * qa)].into_iter().map(|t| (t, add(a, mul(d, t)))).collect()
+}
+
+/// Where two circles meet.
+fn circle_circle(c1: Point2, r1: f64, c2: Point2, r2: f64) -> Vec<Point2> {
+    let d = dist(c1, c2);
+    if d.is_nan() || d <= 0.0 || d > r1 + r2 || d < (r1 - r2).abs() {
+        return Vec::new();
+    }
+    let x = (d * d + r1 * r1 - r2 * r2) / (2.0 * d);
+    let h = (r1 * r1 - x * x).max(0.0).sqrt();
+    let u = mul(sub(c2, c1), 1.0 / d);
+    let m = add(c1, mul(u, x));
+    let n = Point2::new(-u.y, u.x);
+    vec![add(m, mul(n, h)), sub(m, mul(n, h))]
+}
+
+/// Where the carrier lines / circles of two spans meet (ignoring their
+/// ends): the candidates of a trim at a corner.
+pub(super) fn carriers_meet(s1: &Span, s2: &Span) -> Vec<Point2> {
+    match (*s1, *s2) {
+        (Span::Line { a, b }, Span::Line { a: c, b: d }) => {
+            let (r, s) = (sub(b, a), sub(d, c));
+            let den = cross(r, s);
+            if den == 0.0 || !den.is_finite() {
+                return Vec::new();
+            }
+            let t = cross(sub(c, a), s) / den;
+            vec![add(a, mul(r, t))]
+        }
+        (Span::Line { a, b }, Span::Arc { c, r, .. }) | (Span::Arc { c, r, .. }, Span::Line { a, b }) => {
+            line_circle(a, b, c, r).into_iter().map(|(_, p)| p).collect()
+        }
+        (Span::Arc { c: c1, r: r1, .. }, Span::Arc { c: c2, r: r2, .. }) => circle_circle(c1, r1, c2, r2),
+    }
+}
+
+/// Where the carriers of two spans come nearest when they do not meet: a
+/// line that just misses a circle, two circles that just miss each other.
+/// The point halfway across the miss, and the miss (mm).
+pub(super) fn carriers_touch(s1: &Span, s2: &Span) -> Option<(Point2, f64)> {
+    match (*s1, *s2) {
+        (Span::Line { a, b }, Span::Arc { c, r, .. }) | (Span::Arc { c, r, .. }, Span::Line { a, b }) => {
+            let d = sub(b, a);
+            let l2 = dot(d, d);
+            if l2.is_nan() || l2 <= 0.0 {
+                return None;
+            }
+            let f = add(a, mul(d, dot(sub(c, a), d) / l2));
+            let u = unit(sub(f, c))?;
+            let on = add(c, mul(u, r));
+            Some((mul(add(f, on), 0.5), dist(f, on)))
+        }
+        (Span::Arc { c: c1, r: r1, .. }, Span::Arc { c: c2, r: r2, .. }) => {
+            let u = unit(sub(c2, c1))?;
+            // The nearer pair of points on the line of the centres.
+            let mut best: Option<(Point2, f64)> = None;
+            for e1 in [1.0, -1.0] {
+                for e2 in [1.0, -1.0] {
+                    let (x1, x2) = (add(c1, mul(u, r1 * e1)), add(c2, mul(u, r2 * e2)));
+                    let g = dist(x1, x2);
+                    if best.is_none_or(|(_, b)| g < b) {
+                        best = Some((mul(add(x1, x2), 0.5), g));
+                    }
+                }
+            }
+            best
+        }
+        (Span::Line { .. }, Span::Line { .. }) => None,
+    }
+}
+
+fn seg_seg(a: Point2, b: Point2, c: Point2, d: Point2) -> f64 {
+    let (d1, d2) = (cross(sub(d, c), sub(a, c)), cross(sub(d, c), sub(b, c)));
+    let (d3, d4) = (cross(sub(b, a), sub(c, a)), cross(sub(b, a), sub(d, a)));
+    if ((d1 > 0.0 && d2 < 0.0) || (d1 < 0.0 && d2 > 0.0)) && ((d3 > 0.0 && d4 < 0.0) || (d3 < 0.0 && d4 > 0.0)) {
+        return 0.0;
+    }
+    [dist(a, foot(a, c, d)), dist(b, foot(b, c, d)), dist(c, foot(c, a, b)), dist(d, foot(d, a, b))]
+        .into_iter()
+        .fold(f64::INFINITY, f64::min)
+}
+
+fn seg_arc(a: Point2, b: Point2, arc: &Span) -> f64 {
+    let Span::Arc { c, r, a: p, b: q, .. } = *arc else { return f64::INFINITY };
+    let line = Span::Line { a, b };
+    let mut best = pt_span(a, arc).min(pt_span(b, arc)).min(pt_span(p, &line)).min(pt_span(q, &line));
+    for (t, x) in line_circle(a, b, c, r) {
+        if (0.0..=1.0).contains(&t) && arc.holds_dir(x) {
+            return 0.0;
+        }
+    }
+    let f = foot(c, a, b);
+    if let Some(u) = unit(sub(f, c)) {
+        for side in [1.0, -1.0] {
+            let x = add(c, mul(u, r * side));
+            if arc.holds_dir(x) {
+                best = best.min(dist(x, f));
+            }
+        }
+    }
+    best
+}
+
+fn arc_arc(s1: &Span, s2: &Span) -> f64 {
+    let (Span::Arc { c: c1, r: r1, a: a1, b: b1, .. }, Span::Arc { c: c2, r: r2, a: a2, b: b2, .. }) = (*s1, *s2) else {
+        return f64::INFINITY;
+    };
+    let mut best = pt_span(a1, s2).min(pt_span(b1, s2)).min(pt_span(a2, s1)).min(pt_span(b2, s1));
+    if circle_circle(c1, r1, c2, r2).iter().any(|x| s1.holds_dir(*x) && s2.holds_dir(*x)) {
+        return 0.0;
+    }
+    match unit(sub(c2, c1)) {
+        Some(u) => {
+            for e1 in [1.0, -1.0] {
+                let x1 = add(c1, mul(u, r1 * e1));
+                if !s1.holds_dir(x1) {
+                    continue;
+                }
+                for e2 in [1.0, -1.0] {
+                    let x2 = add(c2, mul(u, r2 * e2));
+                    if s2.holds_dir(x2) {
+                        best = best.min(dist(x1, x2));
+                    }
+                }
+            }
+        }
+        // Concentric: |r1 - r2| wherever the two sweeps share a direction.
+        None => {
+            let shared = [a1, b1].iter().any(|p| s2.holds_dir(*p)) || [a2, b2].iter().any(|p| s1.holds_dir(*p));
+            if shared {
+                best = best.min((r1 - r2).abs());
+            }
+        }
+    }
+    best
+}
+
+/// The least distance between two spans; 0 where they meet.
+pub(super) fn span_span(s1: &Span, s2: &Span) -> f64 {
+    match (*s1, *s2) {
+        (Span::Line { a, b }, Span::Line { a: c, b: d }) => seg_seg(a, b, c, d),
+        (Span::Line { a, b }, arc @ Span::Arc { .. }) | (arc @ Span::Arc { .. }, Span::Line { a, b }) => seg_arc(a, b, &arc),
+        (Span::Arc { .. }, Span::Arc { .. }) => arc_arc(s1, s2),
+    }
+}
diff --git a/crates/motion/src/wire_edm/arc_laws.rs b/crates/motion/src/wire_edm/arc_laws.rs
new file mode 100644
index 000000000..e62d488e6
--- /dev/null
+++ b/crates/motion/src/wire_edm/arc_laws.rs
@@ -0,0 +1,116 @@
+//! The wire contour's two laws (`laws`) read against the analytic profile
+//! (#3937): the path's moves - lines and arcs as the toolpath records them,
+//! each arc about its lattice centre - against the drawing's own lines and
+//! arcs, never against a chord list of either.
+//!
+//! - **Kerf law.** The least distance from each move to each span of the
+//!   profile, exact (`arc_dist`), is the kerf offset less [`PATH_TOL`] or
+//!   more. A recorded arc whose two end radii differ (a spiral) is read
+//!   as the circle of their mean radius, and half the difference is taken
+//!   off the reading.
+//! - **Cover law.** Every sampled point of the profile stands within the
+//!   offset plus [`COVER_TOL`] (or the stated sharp corners' reach,
+//!   #3207) of the path; the distance to a move is exact.
+//!
+//! Provenance: plain 2D distance geometry over the rolling-circle reading
+//! of a wire cut (module `laws`). Our own implementation.
+
+use std::f64::consts::TAU;
+
+use crate::cl::{Move, Toolpath};
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::machining2d::GenError;
+
+use super::arc_chain::ArcChain;
+use super::arc_dist::{nearest, pt_span, span_span};
+use super::arc_span::{cross, dist, dot, sub, Span};
+use super::laws::{sharp_reach, uncovered, UncutRest};
+use super::{WireParams, COVER_TOL, PATH_TOL};
+
+/// The most points the cover law samples along the profile.
+const MAX_SAMPLES: f64 = 40_000.0;
+
+/// A recorded move as a span, with how far (mm) the recorded curve may
+/// stand from that span. `None` for a move that is not a flat XY move.
+pub(super) fn move_span(m: &Move) -> Option<(Span, f64)> {
+    let (a, b) = (Point2::new(m.from.x, m.from.y), Point2::new(m.to.x, m.to.y));
+    let Some(arc) = m.arc else {
+        return (dist(a, b) > 0.0).then_some((Span::Line { a, b }, 0.0));
+    };
+    if !arc.plane.is_xy() {
+        return None;
+    }
+    let c = arc.center;
+    let (ra, rb) = (dist(a, c), dist(b, c));
+    if !(ra > 0.0 && rb > 0.0) {
+        return None;
+    }
+    let (u, v) = (sub(a, c), sub(b, c));
+    let t = cross(u, v).atan2(dot(u, v));
+    let sweep = if arc.ccw { t } else { -t }.rem_euclid(TAU);
+    let sweep = if sweep <= 0.0 { TAU } else { sweep };
+    Some((Span::Arc { c, r: 0.5 * (ra + rb), a, b, ccw: arc.ccw, sweep }, 0.5 * (ra - rb).abs()))
+}
+
+fn spans_of(path: &Toolpath) -> Result<Vec<(Span, f64)>, GenError> {
+    path.moves
+        .iter()
+        .filter(|m| m.from.x != m.to.x || m.from.y != m.to.y)
+        .map(|m| move_span(m).ok_or_else(|| GenError::Invalid("wire contour: the path holds a move that is not a flat XY line or arc - refused".into())))
+        .collect()
+}
+
+/// The certificate: no move of `path` brings the wire's centre nearer
+/// the profile than `k` (less [`PATH_TOL`]).
+pub(super) fn kerf(path: &Toolpath, chain: &ArcChain, k: f64, z: f64) -> Result<(), GenError> {
+    let floor = k - PATH_TOL;
+    for (i, (ms, dev)) in spans_of(path)?.iter().enumerate() {
+        for cs in chain.spans() {
+            let d = span_span(ms, cs) - dev;
+            if d.is_nan() || d < floor {
+                let (_, q) = nearest(ms.point_at(0.5), cs);
+                return Err(GenError::invalid_at(
+                    format!(
+                        "wire contour: move {i} would bring the wire within {d:.4} mm of the profile near X{:.3} Y{:.3} - under the kerf offset ({k:.4} mm), so the kerf would burn into the product; refused",
+                        q.x, q.y
+                    ),
+                    Point3::new(q.x, q.y, z),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The corner minimum: every point of the profile lies within the kerf
+/// offset (plus [`COVER_TOL`], or the stated sharp corners' reach) of
+/// the path. Returns the worst rest the sharp corners let pass.
+pub(super) fn cover(path: &Toolpath, chain: &ArcChain, p: &WireParams) -> Result<Option<UncutRest>, GenError> {
+    let k = p.kerf_offset();
+    let moves = spans_of(path)?;
+    let heal = sharp_reach(p);
+    let (strict, reach) = (k + COVER_TOL, k + heal.max(COVER_TOL));
+    let step = (k * 0.5).max(chain.perimeter() / MAX_SAMPLES).max(1e-4);
+    let mut over: Option<(f64, Point2)> = None;
+    let mut healed: Option<(f64, Point2)> = None;
+    for s in chain.spans() {
+        let steps = (s.length() / step).ceil().clamp(2.0, 65_536.0) as u32;
+        for j in 0..=steps {
+            let q = s.point_at(f64::from(j) / f64::from(steps));
+            let d = moves.iter().map(|(ms, dev)| pt_span(q, ms) + dev).fold(f64::INFINITY, f64::min);
+            if d.is_nan() {
+                return Err(GenError::Invalid("wire contour: the profile's distance to the wire path is not a number - refused".into()));
+            }
+            if d > reach && over.is_none_or(|(w, _)| d > w) {
+                over = Some((d, q));
+            } else if d > strict && healed.is_none_or(|(w, _)| d > w) {
+                healed = Some((d, q));
+            }
+        }
+    }
+    if let Some((d, q)) = over {
+        return Err(uncovered(q, d, p, heal, p.sharp_corners));
+    }
+    Ok(healed.map(|(d, q)| UncutRest { depth: d - k, at: Point3::new(q.x, q.y, p.plane_z) }))
+}
diff --git a/crates/motion/src/wire_edm/arc_offset.rs b/crates/motion/src/wire_edm/arc_offset.rs
new file mode 100644
index 000000000..26e750423
--- /dev/null
+++ b/crates/motion/src/wire_edm/arc_offset.rs
@@ -0,0 +1,146 @@
+//! The parallel of an analytic wire profile at the kerf offset (#3937):
+//! each line moved along its normal, each arc made concentric, and every
+//! corner closed - a pivot arc about the corner where the two parallels
+//! part, a trim at their meet where they overlap. A parallel that a trim
+//! consumes, or an arc tighter than the offset on its waste side, is
+//! refused by name: nothing is clamped or rounded.
+//!
+//! Provenance: the offset-curve construction for line and arc profiles
+//! (Tiller and Hanson, "Offsets of two-dimensional profiles", IEEE CG&A
+//! 1984; M. Held, "On the Computational Geometry of Pocket Machining",
+//! Springer 1991: parallel elements, joining arcs at convex vertices,
+//! trimming at concave ones). Our own implementation.
+
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::machining2d::GenError;
+
+use super::arc_chain::JOINT_TOL;
+use super::arc_dist::{carriers_meet, carriers_touch};
+use super::arc_span::{cross, dist, dot, left, mul, add, Parallel, Span};
+
+/// Two unit tangents whose cross product is under this meet smoothly: no
+/// pivot and no trim, the parallels already share their end.
+const SMOOTH: f64 = 1e-7;
+
+fn refuse(msg: String, at: Point2) -> GenError {
+    GenError::invalid_at(format!("wire contour: {msg}"), Point3::new(at.x, at.y, 0.0))
+}
+
+/// One parallel element, with its source span and whether a trim moved
+/// its start or end.
+struct Piece {
+    span: Span,
+    src: usize,
+    start: Point2,
+    end: Point2,
+    start_moved: bool,
+    end_moved: bool,
+}
+
+/// The parallel of the counter-clockwise `spans` at signed offset `s`
+/// (positive: inside, to the left of the walk). `sharp` lets an arc
+/// tighter than the offset drop out to a corner (#3207); without it that
+/// arc is refused. Returns the closed walk of lines and arcs, and the
+/// widest miss (mm) where two near-tangent parallels were joined across a
+/// gap instead of at a crossing (at most [`JOINT_TOL`]).
+pub(super) fn parallel_walk(spans: &[Span], s: f64, sharp: bool) -> Result<(Vec<Span>, f64), GenError> {
+    let mut miss: f64 = 0.0;
+    let k = s.abs();
+    let mut pieces: Vec<Piece> = Vec::with_capacity(spans.len());
+    for (i, sp) in spans.iter().enumerate() {
+        match sp.parallel(s) {
+            Some(Parallel::Span(o)) => pieces.push(Piece { span: o, src: i, start: o.start(), end: o.end(), start_moved: false, end_moved: false }),
+            Some(Parallel::Point) => {}
+            Some(Parallel::Inverted(by)) => {
+                if !sharp {
+                    let Span::Arc { r, .. } = *sp else { continue };
+                    let at = sp.point_at(0.5);
+                    return Err(refuse(
+                        format!(
+                            "an inside arc of radius {r:.4} mm near X{:.3} Y{:.3} is tighter than the wire can follow on this side - the minimum inside radius is {k:.4} mm (wire radius + spark gap), {by:.4} mm more than the arc; open the radius or cut with a thinner wire",
+                            at.x, at.y
+                        ),
+                        at,
+                    ));
+                }
+            }
+            None => return Err(refuse(format!("span {} of the profile has no direction", i + 1), sp.start())),
+        }
+    }
+    if pieces.is_empty() {
+        let at = spans.first().map_or(Point2::new(0.0, 0.0), Span::start);
+        return Err(refuse(format!("the profile is too small for the wire - no point of it stands the kerf offset ({k:.4} mm) from its edge"), at));
+    }
+    let n = pieces.len();
+    let mut pivots: Vec<Option<Span>> = vec![None; n];
+    for i in 0..n {
+        let j = (i + 1) % n;
+        let (oi, oj) = (pieces[i].span, pieces[j].span);
+        let (Some(t1), Some(t2)) = (oi.dir_end(), oj.dir_start()) else {
+            return Err(refuse("a parallel of the profile has no direction".into(), oi.end()));
+        };
+        let (e, f) = (pieces[i].end, pieces[j].start);
+        let turn = cross(t1, t2);
+        let consecutive = (pieces[i].src + 1) % spans.len() == pieces[j].src;
+        if dist(e, f) <= 1e-9 || (turn.abs() <= SMOOTH && dot(t1, t2) > 0.0) {
+            continue;
+        }
+        if turn.abs() <= SMOOTH {
+            return Err(refuse("the profile turns back on itself at a joint - there is no side for the wire there".into(), e));
+        }
+        if turn * s < 0.0 {
+            // The parallels part: the wire pivots about the drawing's corner.
+            let p = spans[pieces[i].src].end();
+            if !consecutive || n == 1 {
+                return Err(refuse("an outside corner follows an arc too tight for the wire - the parallel cannot be closed there".into(), p));
+            }
+            let b = add(p, mul(left(t2), s));
+            let a = add(p, mul(left(t1), s));
+            let sweep = turn.abs().atan2(dot(t1, t2));
+            pivots[i] = Some(Span::Arc { c: p, r: k, a, b, ccw: s < 0.0, sweep });
+            continue;
+        }
+        // The parallels overlap: both end at their meet nearest the corner.
+        let mid = mul(add(e, f), 0.5);
+        let meet = carriers_meet(&oi, &oj).into_iter().min_by(|a, b| dist(*a, mid).total_cmp(&dist(*b, mid)));
+        // Near-tangent parallels that just miss (a drawing's joint gap):
+        // joined across the miss, which the path's margin then holds.
+        let touch = || carriers_touch(&oi, &oj).filter(|(_, g)| *g <= JOINT_TOL && dist(e, f) <= 10.0 * JOINT_TOL);
+        let Some(x) = meet.or_else(|| {
+            touch().map(|(x, g)| {
+                miss = miss.max(g);
+                x
+            })
+        }) else {
+            return Err(refuse(
+                format!("the parallels of the profile at the kerf offset ({k:.4} mm) do not meet at the inside corner near X{:.3} Y{:.3} - a feature there is narrower than the kerf", e.x, e.y),
+                e,
+            ));
+        };
+        pieces[i].end = x;
+        pieces[i].end_moved = true;
+        pieces[j].start = x;
+        pieces[j].start_moved = true;
+    }
+    let mut out = Vec::with_capacity(2 * n);
+    for (i, pc) in pieces.iter().enumerate() {
+        let Some(sp) = pc.span.between(pc.start, pc.end, pc.start_moved, pc.end_moved, 10.0 * JOINT_TOL) else {
+            let at = pc.span.point_at(0.5);
+            return Err(refuse(
+                format!(
+                    "the profile narrows near X{:.3} Y{:.3} under the kerf width ({:.4} mm) - the wire's parallel there is consumed by its neighbours; widen the feature or cut with a thinner wire",
+                    at.x,
+                    at.y,
+                    2.0 * k
+                ),
+                at,
+            ));
+        };
+        out.push(sp);
+        if let Some(pv) = pivots[i] {
+            out.push(pv);
+        }
+    }
+    Ok((out, miss))
+}
diff --git a/crates/motion/src/wire_edm/arc_span.rs b/crates/motion/src/wire_edm/arc_span.rs
new file mode 100644
index 000000000..0eeafef89
--- /dev/null
+++ b/crates/motion/src/wire_edm/arc_span.rs
@@ -0,0 +1,258 @@
+//! One span of an analytic wire profile (#3937): a straight line or a
+//! circular arc, walked from `a` to `b`. The arc keeps its centre,
+//! radius and turning sense, so its parallel at the kerf offset is a
+//! concentric arc, never a chord list.
+//!
+//! Provenance: textbook plane geometry - the parallel (offset) curve of
+//! a line is a line, of a circle a concentric circle (the offset-curve
+//! reading of Tiller and Hanson, "Offsets of two-dimensional profiles",
+//! IEEE CG&A 1984). Output points use only `+ - * /` and `sqrt` (no
+//! trigonometry), so the posted bytes agree on every platform. Our own
+//! implementation.
+
+use std::f64::consts::TAU;
+
+use crate::geo2d::Point2;
+
+/// How far (radians) a direction may stand outside an arc's sweep and
+/// still read as on it: float noise at the arc's ends.
+pub(super) const ANG_EPS: f64 = 1e-9;
+
+pub(super) fn sub(p: Point2, q: Point2) -> Point2 {
+    Point2::new(p.x - q.x, p.y - q.y)
+}
+
+pub(super) fn add(p: Point2, q: Point2) -> Point2 {
+    Point2::new(p.x + q.x, p.y + q.y)
+}
+
+pub(super) fn mul(p: Point2, f: f64) -> Point2 {
+    Point2::new(p.x * f, p.y * f)
+}
+
+pub(super) fn dot(p: Point2, q: Point2) -> f64 {
+    p.x * q.x + p.y * q.y
+}
+
+pub(super) fn cross(p: Point2, q: Point2) -> f64 {
+    p.x * q.y - p.y * q.x
+}
+
+pub(super) fn norm(p: Point2) -> f64 {
+    p.x.hypot(p.y)
+}
+
+pub(super) fn dist(p: Point2, q: Point2) -> f64 {
+    norm(sub(p, q))
+}
+
+/// `p` scaled to unit length; `None` for a zero or non-finite vector.
+pub(super) fn unit(p: Point2) -> Option<Point2> {
+    let l = norm(p);
+    (l.is_finite() && l > 0.0).then(|| mul(p, 1.0 / l))
+}
+
+/// The left normal of a unit direction.
+pub(super) fn left(t: Point2) -> Point2 {
+    Point2::new(-t.y, t.x)
+}
+
+/// One span in walk direction.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Span {
+    Line { a: Point2, b: Point2 },
+    /// `sweep` is the turn from `a` to `b` in (0, 2pi]; 2pi is a full
+    /// circle (`a == b`). `ccw` is the turning sense of the walk.
+    Arc { c: Point2, r: f64, a: Point2, b: Point2, ccw: bool, sweep: f64 },
+}
+
+/// What a span's parallel at a signed offset is.
+pub(super) enum Parallel {
+    Span(Span),
+    /// A concave arc whose radius equals the offset: its parallel is the
+    /// centre point.
+    Point,
+    /// A concave arc tighter than the offset by this much (mm).
+    Inverted(f64),
+}
+
+impl Span {
+    #[must_use]
+    pub fn start(&self) -> Point2 {
+        match *self {
+            Span::Line { a, .. } | Span::Arc { a, .. } => a,
+        }
+    }
+
+    #[must_use]
+    pub fn end(&self) -> Point2 {
+        match *self {
+            Span::Line { b, .. } | Span::Arc { b, .. } => b,
+        }
+    }
+
+    pub(super) fn is_arc(&self) -> bool {
+        matches!(self, Span::Arc { .. })
+    }
+
+    /// The unit tangent of the walk at `p` on the span.
+    fn tangent_at(&self, p: Point2) -> Option<Point2> {
+        match *self {
+            Span::Line { a, b } => unit(sub(b, a)),
+            Span::Arc { c, ccw, .. } => {
+                let n = left(unit(sub(p, c))?);
+                Some(if ccw { n } else { mul(n, -1.0) })
+            }
+        }
+    }
+
+    pub(super) fn dir_start(&self) -> Option<Point2> {
+        self.tangent_at(self.start())
+    }
+
+    pub(super) fn dir_end(&self) -> Option<Point2> {
+        self.tangent_at(self.end())
+    }
+
+    #[must_use]
+    pub fn length(&self) -> f64 {
+        match *self {
+            Span::Line { a, b } => dist(a, b),
+            Span::Arc { r, sweep, .. } => r * sweep,
+        }
+    }
+
+    /// The turn (radians, in walk sense) from the arc's start to the
+    /// direction of `q` from its centre, in [0, 2pi). 0 for a line.
+    pub(super) fn turn_to(&self, q: Point2) -> f64 {
+        let Span::Arc { c, a, ccw, .. } = *self else { return 0.0 };
+        let (u, v) = (sub(a, c), sub(q, c));
+        let t = cross(u, v).atan2(dot(u, v));
+        let t = if ccw { t } else { -t };
+        let t = t.rem_euclid(TAU);
+        if t > TAU - ANG_EPS { 0.0 } else { t }
+    }
+
+    /// Whether the direction of `q` from the arc's centre lies within its
+    /// sweep (always true for a full circle).
+    pub(super) fn holds_dir(&self, q: Point2) -> bool {
+        match *self {
+            Span::Line { .. } => false,
+            Span::Arc { sweep, .. } => self.turn_to(q) <= sweep + ANG_EPS,
+        }
+    }
+
+    /// The point at `f` of the way along (0 = start, 1 = end). Used by the
+    /// laws' sampling only; output points never come from here.
+    pub(super) fn point_at(&self, f: f64) -> Point2 {
+        match *self {
+            Span::Line { a, b } => add(a, mul(sub(b, a), f)),
+            Span::Arc { c, a, ccw, sweep, .. } => {
+                let t = if ccw { sweep * f } else { -sweep * f };
+                let (s, co) = t.sin_cos();
+                let u = sub(a, c);
+                Point2::new(c.x + u.x * co - u.y * s, c.y + u.x * s + u.y * co)
+            }
+        }
+    }
+
+    /// The parallel of the span at signed offset `s` (positive: to the
+    /// left of the walk). A line keeps its length; an arc turning left
+    /// (counter-clockwise) has the radius `r - s`, one turning right
+    /// `r + s`, its ends moved along their radii.
+    pub(super) fn parallel(&self, s: f64) -> Option<Parallel> {
+        match *self {
+            Span::Line { a, b } => {
+                let n = mul(left(unit(sub(b, a))?), s);
+                Some(Parallel::Span(Span::Line { a: add(a, n), b: add(b, n) }))
+            }
+            Span::Arc { c, r, a, b, ccw, sweep } => {
+                let r2 = if ccw { r - s } else { r + s };
+                if !r2.is_finite() || r.is_nan() || r <= 0.0 {
+                    return None;
+                }
+                if r2.abs() <= 1e-9 {
+                    return Some(Parallel::Point);
+                }
+                if r2 < 0.0 {
+                    return Some(Parallel::Inverted(-r2));
+                }
+                let f = r2 / r;
+                Some(Parallel::Span(Span::Arc {
+                    c,
+                    r: r2,
+                    a: add(c, mul(sub(a, c), f)),
+                    b: add(c, mul(sub(b, c), f)),
+                    ccw,
+                    sweep,
+                }))
+            }
+        }
+    }
+
+    /// The span from `p` to `q`, both on it in walk order: a line's
+    /// parameter, an arc's turn. A moved end may stand up to `ext` (mm)
+    /// past the span's own end (two near-tangent parallels joined across a
+    /// drawing's joint gap). `None` when `q` does not follow `p` - the
+    /// trim consumed the span.
+    pub(super) fn between(&self, p: Point2, q: Point2, p_moved: bool, q_moved: bool, ext: f64) -> Option<Span> {
+        match *self {
+            Span::Line { a, b } => {
+                let d = sub(b, a);
+                let l2 = dot(d, d);
+                if l2.is_nan() || l2 <= 0.0 {
+                    return None;
+                }
+                let tp = if p_moved { dot(sub(p, a), d) / l2 } else { 0.0 };
+                let tq = if q_moved { dot(sub(q, a), d) / l2 } else { 1.0 };
+                let e = 1e-12 + ext / l2.sqrt();
+                (tp >= -e && tq <= 1.0 + e && tq - tp > 1e-12).then_some(Span::Line { a: p, b: q })
+            }
+            Span::Arc { c, r, ccw, sweep, .. } => {
+                let e = ANG_EPS + ext / r;
+                let mut tp = if p_moved { self.turn_to(p) } else { 0.0 };
+                if p_moved && tp > TAU - e {
+                    tp -= TAU;
+                }
+                let tq = if q_moved { self.turn_to(q) } else { sweep };
+                let tq = if q_moved && tq <= ANG_EPS && sweep >= TAU - ANG_EPS { sweep } else { tq };
+                let turn = tq - tp;
+                (tp >= -e && tq <= sweep + e && turn > ANG_EPS && turn <= TAU + ANG_EPS)
+                    .then_some(Span::Arc { c, r, a: p, b: q, ccw, sweep: turn })
+            }
+        }
+    }
+
+    /// The span cut at `p` (on it): the part before and the part after.
+    /// A part of no length is `None`.
+    pub(super) fn split(&self, p: Point2) -> (Option<Span>, Option<Span>) {
+        let before = if dist(self.start(), p) > 1e-12 { self.between(self.start(), p, false, true, 0.0) } else { None };
+        let after = if dist(p, self.end()) > 1e-12 || self.full() { self.between(p, self.end(), true, false, 0.0) } else { None };
+        (before, after)
+    }
+
+    /// A full circle.
+    pub(super) fn full(&self) -> bool {
+        matches!(*self, Span::Arc { sweep, .. } if sweep >= TAU - ANG_EPS)
+    }
+
+    /// The arc cut into two equal halves when it turns more than half a
+    /// circle: a full circle at its antipode, any other at the point
+    /// opposite the bisector of its end radii (no trigonometry).
+    pub(super) fn halves(&self) -> Vec<Span> {
+        let Span::Arc { c, r, a, b, ccw, sweep } = *self else { return vec![*self] };
+        if sweep <= std::f64::consts::PI + ANG_EPS {
+            return vec![*self];
+        }
+        let m = if self.full() {
+            sub(mul(c, 2.0), a)
+        } else {
+            match unit(add(sub(a, c), sub(b, c))) {
+                Some(u) => sub(c, mul(u, r)),
+                None => return vec![*self],
+            }
+        };
+        let h = sweep * 0.5;
+        vec![Span::Arc { c, r, a, b: m, ccw, sweep: h }, Span::Arc { c, r, a: m, b, ccw, sweep: sweep - h }]
+    }
+}
diff --git a/crates/motion/src/wire_edm/arc_tests.rs b/crates/motion/src/wire_edm/arc_tests.rs
new file mode 100644
index 000000000..6ff3f07a1
--- /dev/null
+++ b/crates/motion/src/wire_edm/arc_tests.rs
@@ -0,0 +1,259 @@
+//! The wire contour of a drawn line-and-arc profile (#3937): circles and
+//! fillets cut as true arcs at the kerf offset, outside corners pivoted,
+//! inside corners trimmed, and every case the wire cannot cut refused by
+//! name. The wire and gap are SYNTHETIC (#290 D4, D10).
+
+use std::f64::consts::{FRAC_PI_2, PI, TAU};
+
+use super::arc_span::Span;
+use super::*;
+use crate::cl::MoveKind;
+
+const K: f64 = 0.165;
+
+fn params(side: WireSide, start: (f64, f64)) -> WireParams {
+    WireParams {
+        wire_diameter: 0.25,
+        gap: 0.04,
+        condition: "C110".into(),
+        side,
+        start: Some(Point2::new(start.0, start.1)),
+        plane_z: -12.0,
+        tabs: None,
+        stock: None,
+        clearance: 1.0,
+        sharp_corners: false,
+    }
+}
+
+fn p(x: f64, y: f64) -> Point2 {
+    Point2::new(x, y)
+}
+
+fn line(a: (f64, f64), b: (f64, f64)) -> Span {
+    Span::Line { a: p(a.0, a.1), b: p(b.0, b.1) }
+}
+
+fn circle(c: (f64, f64), r: f64) -> ArcChain {
+    let a = p(c.0 + r, c.1);
+    ArcChain::new(vec![Span::Arc { c: p(c.0, c.1), r, a, b: a, ccw: true, sweep: TAU }]).unwrap()
+}
+
+/// A 20 x 20 L: the corner at (20, 0) rounded by a radius 3 fillet, an
+/// inside corner at (10, 10), four sharp outside corners.
+fn el() -> ArcChain {
+    ArcChain::new(vec![
+        line((0.0, 0.0), (17.0, 0.0)),
+        Span::Arc { c: p(17.0, 3.0), r: 3.0, a: p(17.0, 0.0), b: p(20.0, 3.0), ccw: true, sweep: FRAC_PI_2 },
+        line((20.0, 3.0), (20.0, 10.0)),
+        line((20.0, 10.0), (10.0, 10.0)),
+        line((10.0, 10.0), (10.0, 20.0)),
+        line((10.0, 20.0), (0.0, 20.0)),
+        line((0.0, 20.0), (0.0, 0.0)),
+    ])
+    .unwrap()
+}
+
+fn xy(q: crate::geometry::Point3) -> Point2 {
+    p(q.x, q.y)
+}
+
+fn near(a: Point2, b: Point2) -> bool {
+    (a.x - b.x).hypot(a.y - b.y) < 1e-9
+}
+
+fn refusal(chain: &ArcChain, prm: &WireParams) -> String {
+    wire_contour_arcs(chain, prm).unwrap_err().to_string()
+}
+
+#[test]
+fn die_circle_with_a_centred_hole_enters_towards_plus_x_and_cuts_two_half_arcs() {
+    let path = wire_contour_arcs(&circle((0.0, 0.0), 5.0), &params(WireSide::Die, (0.0, 0.0))).unwrap();
+    let m = &path.moves;
+    assert_eq!(m.len(), 4, "{m:?}");
+    assert!(near(xy(m[0].to), p(5.0 - K, 0.0)), "the lead enters towards +X: {:?}", m[0]);
+    for arc_move in &m[1..3] {
+        let arc = arc_move.arc.expect("a true arc");
+        assert!(arc.ccw && near(arc.center, p(0.0, 0.0)));
+        for q in [arc_move.from, arc_move.to] {
+            assert!(((q.x.hypot(q.y)) - (5.0 - K)).abs() < 1e-12, "on the kerf circle: {q:?}");
+        }
+    }
+    assert!(near(xy(m[1].to), p(-(5.0 - K), 0.0)), "the half turn ends at the antipode");
+    assert!(near(xy(m[3].to), p(0.0, 0.0)) && m.iter().all(|q| q.kind == MoveKind::Feed && q.to.z == -12.0));
+    assert!(path.notes.iter().any(|n| n.contains("towards +X")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("2 arc move(s)")), "{:?}", path.notes);
+}
+
+#[test]
+fn punch_circle_is_entered_on_the_radius_through_the_hole() {
+    let path = wire_contour_arcs(&circle((3.0, 4.0), 5.0), &params(WireSide::Punch, (3.0, 14.0))).unwrap();
+    assert!(near(xy(path.moves[0].to), p(3.0, 9.0 + K)), "{:?}", path.moves[0]);
+    assert_eq!(path.arc_count(), 2);
+    assert!(path.moves[1].arc.is_some_and(|a| a.ccw && near(a.center, p(3.0, 4.0))));
+    assert!(!path.notes.iter().any(|n| n.contains("towards +X")));
+}
+
+#[test]
+fn line_and_arc_punch_pivots_outside_corners_and_trims_the_inside_corner() {
+    // The L's inside corner is sharp: stated (#3207), else the cover law
+    // refuses the rest the wire's own radius leaves there.
+    let strict = refusal(&el(), &params(WireSide::Punch, (30.0, 5.0)));
+    assert!(strict.contains("near X10.000 Y10.000 is tighter than the wire can cut"), "{strict}");
+    let mut prm = params(WireSide::Punch, (30.0, 5.0));
+    prm.sharp_corners = true;
+    let path = wire_contour_arcs(&el(), &prm).unwrap();
+    assert!(path.notes.iter().any(|n| n.starts_with(SHARP_NOTE)), "{:?}", path.notes);
+    // The fillet at radius 3 + K about its own centre, and a pivot of
+    // radius K about each of the four sharp outside corners.
+    let arcs: Vec<_> = path.moves.iter().filter_map(|m| m.arc.map(|a| (a, m))).collect();
+    assert_eq!(arcs.len(), 5, "{:?}", path.moves);
+    let fillet = arcs.iter().find(|(a, _)| near(a.center, p(17.0, 3.0))).expect("the fillet's arc");
+    assert!((xy(fillet.1.from).x - 17.0).abs() < 1e-12 && (xy(fillet.1.from).y + K).abs() < 1e-12);
+    for corner in [p(20.0, 10.0), p(10.0, 20.0), p(0.0, 20.0), p(0.0, 0.0)] {
+        let (a, m) = arcs.iter().find(|(a, _)| near(a.center, corner)).expect("a pivot");
+        assert!(a.ccw && ((xy(m.from).x - corner.x).hypot(xy(m.from).y - corner.y) - K).abs() < 1e-12);
+    }
+    // The inside corner is trimmed to the meet of its two parallels.
+    let trim = p(10.0 + K, 10.0 + K);
+    assert!(path.moves.iter().any(|m| near(xy(m.to), trim)), "{:?}", path.moves);
+}
+
+#[test]
+fn line_and_arc_die_trims_outside_corners_and_pivots_the_reentrant_one() {
+    let mut prm = params(WireSide::Die, (5.0, 5.0));
+    prm.sharp_corners = true;
+    let path = wire_contour_arcs(&el(), &prm).unwrap();
+    let arcs: Vec<_> = path.moves.iter().filter_map(|m| m.arc).collect();
+    assert_eq!(arcs.len(), 2, "the fillet at 3 - K and one pivot: {:?}", path.moves);
+    assert!(arcs.iter().any(|a| near(a.center, p(17.0, 3.0)) && a.ccw));
+    assert!(arcs.iter().any(|a| near(a.center, p(10.0, 10.0)) && !a.ccw), "{arcs:?}");
+    assert!(path.moves.iter().any(|m| near(xy(m.to), p(K, K))), "a trimmed corner");
+}
+
+#[test]
+fn an_inside_arc_tighter_than_the_offset_is_refused_by_name() {
+    // A die whose corner fillet (radius 0.1) is under the 0.165 offset.
+    let chain = ArcChain::new(vec![
+        line((0.0, 0.0), (9.9, 0.0)),
+        Span::Arc { c: p(9.9, 0.1), r: 0.1, a: p(9.9, 0.0), b: p(10.0, 0.1), ccw: true, sweep: FRAC_PI_2 },
+        line((10.0, 0.1), (10.0, 10.0)),
+        line((10.0, 10.0), (0.0, 10.0)),
+        line((0.0, 10.0), (0.0, 0.0)),
+    ])
+    .unwrap();
+    let why = refusal(&chain, &params(WireSide::Die, (5.0, 5.0)));
+    assert!(why.contains("inside arc of radius 0.1000") && why.contains("minimum inside radius is 0.1650"), "{why}");
+}
+
+#[test]
+fn a_slot_under_the_kerf_width_and_a_crossing_neck_are_refused() {
+    let thin = ArcChain::new(vec![
+        line((0.0, 0.0), (10.0, 0.0)),
+        line((10.0, 0.0), (10.0, 0.2)),
+        line((10.0, 0.2), (0.0, 0.2)),
+        line((0.0, 0.2), (0.0, 0.0)),
+    ])
+    .unwrap();
+    let why = refusal(&thin, &params(WireSide::Die, (5.0, 0.1)));
+    assert!(why.contains("under the kerf width"), "{why}");
+    // Two round chambers joined by a 0.2 mm channel: the parallels of the
+    // two channel walls cross.
+    let r = 5.0;
+    let h = 0.1_f64;
+    let x = (r * r - h * h).sqrt();
+    let s = h.atan2(x);
+    let dumbbell = ArcChain::new(vec![
+        Span::Arc { c: p(0.0, 0.0), r, a: p(x, h), b: p(x, -h), ccw: true, sweep: TAU - 2.0 * s },
+        line((x, -h), (20.0 - x, -h)),
+        Span::Arc { c: p(20.0, 0.0), r, a: p(20.0 - x, -h), b: p(20.0 - x, h), ccw: true, sweep: TAU - 2.0 * s },
+        line((20.0 - x, h), (x, h)),
+    ])
+    .unwrap();
+    let why = refusal(&dumbbell, &params(WireSide::Die, (0.0, 0.0)));
+    assert!(why.contains("under the kerf width") || why.contains("neck"), "{why}");
+}
+
+#[test]
+fn a_joint_gap_past_the_tolerance_is_refused_and_one_under_it_is_charged_to_the_margin() {
+    let gap = |g: f64| {
+        ArcChain::new(vec![
+            line((0.0, 0.0), (10.0, 0.0)),
+            Span::Arc { c: p(10.0, 5.0), r: 5.0, a: p(10.0, 0.0), b: p(10.0, 10.0), ccw: true, sweep: PI },
+            line((10.0, 10.0 + g), (0.0, 10.0)),
+            line((0.0, 10.0), (0.0, 0.0)),
+        ])
+    };
+    let why = gap(1e-3).unwrap_err().to_string();
+    assert!(why.contains("joint gap of 0.001000 mm") && why.contains("at most 0.00025"), "{why}");
+    let mut prm = params(WireSide::Die, (5.0, 5.0));
+    prm.sharp_corners = true;
+    let path = wire_contour_arcs(&gap(1e-4).unwrap(), &prm).unwrap();
+    assert!(path.notes.iter().any(|n| n.contains("200.0 nm farther on the waste side") && n.contains("gap up to 100.0 nm")), "{:?}", path.notes);
+}
+
+#[test]
+fn an_off_lattice_centre_is_snapped_with_its_radius_kept() {
+    let path = wire_contour_arcs(&circle((1.000_000_000_3, 2.000_000_000_4), 4.0), &params(WireSide::Die, (1.0, 2.5))).unwrap();
+    for m in path.moves.iter().filter(|m| m.arc.is_some()) {
+        let a = m.arc.unwrap();
+        assert_eq!((a.center.x, a.center.y), (1.0, 2.0), "a lattice centre");
+        for q in [m.from, m.to] {
+            let r = (q.x - 1.0).hypot(q.y - 2.0);
+            assert!((r - (4.0 - K)).abs() < 1e-12, "radius kept about the lattice centre: {r}");
+        }
+    }
+    assert!(!path.notes.iter().any(|n| n.contains("farther")), "under 1 nm needs no margin: {:?}", path.notes);
+}
+
+#[test]
+fn the_laws_catch_a_mutated_arc_path() {
+    let chain = circle((0.0, 0.0), 5.0);
+    let prm = params(WireSide::Die, (0.0, 0.0));
+    let good = wire_contour_arcs(&chain, &prm).unwrap();
+    assert!(arc_laws::kerf(&good, &chain, K, -12.0).is_ok());
+    // One half arc 2 um nearer the product: the kerf law refuses it.
+    let mut bad = good.clone();
+    for m in &mut bad.moves[1..3] {
+        for q in [&mut m.from, &mut m.to] {
+            let f = (5.0 - K + 0.002) / (5.0 - K);
+            q.x *= f;
+            q.y *= f;
+        }
+    }
+    let why = arc_laws::kerf(&bad, &chain, K, -12.0).unwrap_err().to_string();
+    assert!(why.contains("burn into the product"), "{why}");
+    // The arcs written as straight chords leave the drawing uncut.
+    let mut chords = good;
+    for m in &mut chords.moves {
+        m.arc = None;
+    }
+    let why = arc_laws::cover(&chords, &chain, &prm).unwrap_err().to_string();
+    assert!(why.contains("tighter than the wire can cut"), "{why}");
+}
+
+#[test]
+fn a_hole_too_near_the_profile_or_on_the_wrong_side_is_refused() {
+    let chain = circle((0.0, 0.0), 5.0);
+    assert!(refusal(&chain, &params(WireSide::Die, (4.9, 0.0))).contains("closer to the profile than the kerf offset"));
+    assert!(refusal(&chain, &params(WireSide::Die, (9.0, 0.0))).contains("lies outside the profile"));
+    assert!(refusal(&chain, &params(WireSide::Punch, (1.0, 0.0))).contains("lies inside the profile"));
+    let mut tabbed = params(WireSide::Die, (0.0, 0.0));
+    tabbed.tabs = Some(TabParams { count: Some(1), width: Some(1.0), at: Vec::new(), cutoff: None });
+    assert!(refusal(&chain, &tabbed).contains("tabs"));
+}
+
+#[test]
+fn the_waste_ring_lies_on_the_waste_side_of_every_arc() {
+    let chain = el();
+    for (side, outside) in [(WireSide::Die, false), (WireSide::Punch, true)] {
+        let ring = chain.waste_ring(side, 2.5e-5).unwrap();
+        for q in ring.points() {
+            let r = (q.x - 17.0).hypot(q.y - 3.0);
+            if q.x > 17.0 && q.y < 3.0 {
+                assert!(if outside { r >= 3.0 - 1e-12 } else { r <= 3.0 + 1e-12 }, "{side:?} {q:?} {r}");
+                assert!((r - 3.0).abs() <= 2.5e-5 + 1e-12);
+            }
+        }
+    }
+}
