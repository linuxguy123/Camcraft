From 0e86e5407f1ef55b267c20e44bb430ab6b3044a8 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 24 Nov 2026 18:34:00 -0800
Subject: [PATCH] build: drop the unused camcraft-gcode workspace dependency

PR #3657 declared camcraft-gcode in [workspace.dependencies], but no
crate depends on it yet, so every cargo command warned. The crate stays
a workspace member; the first crate that uses it (#2218) adds the entry
back with its decision record.

Fixes #3955

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 Cargo.toml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index d2976ae0a..cbc247c08 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -12,7 +12,6 @@ rust-version = "1.90"
 camcraft-app = { path = "crates/app" }
 camcraft-geometry = { path = "crates/geometry" }
 camcraft-cl = { path = "crates/cl" }
-camcraft-gcode = { path = "crates/gcode" }
 camcraft-tools = { path = "crates/tools" }
 camcraft-post = { path = "crates/post" }
 camcraft-sim = { path = "crates/sim" }
