+    assert_window_layout(&h, "Tool library", &[HOLDERS_PAGE, "Holder filter", holders::READ_ONLY, "Used by"]);
+    let win = library_window(&h);
+    let node = super::tool_library_editor::library_window(&h);
+    let rect = |l: &str| node.query_all_by_label(l).next().unwrap_or_else(|| panic!("no {l:?} in the window")).rect();
+    let (all, name) = (rect(holders::ALL), rect("Name"));
+    assert!(all.right() < name.left(), "the taper column {all:?} stands left of the rows {name:?}");
+    assert!(win.expand(1.0).contains_rect(rect("Used by")), "the last head stays in the window");
+    let Some(props) = super::layout::leaf_rect(&h.state().dock, &Tab::Properties) else {
+        panic!("the Properties leaf is not laid out");
+    };
+    assert!(!win.intersects(props), "the window {win:?} stands beside the Properties pane {props:?}");
+    super::tool_library_holders_ui::filter_to_holder(&mut h);
+    super::tool_library_editor::click_window_button(&mut h, "BT40 ER32");
+    let node = super::tool_library_editor::library_window(&h);
+    let rect = |l: &str| node.query_all_by_label(l).next().unwrap_or_else(|| panic!("no {l:?} in the holder view")).rect();
+    let (back, taper, dims) = (rect(holder_view::BACK), rect("Spindle taper"), rect(holder_view::DIMS));
+    assert!(back.top() < taper.top(), "the way back {back:?} heads the view");
+    assert!(dims.left() > taper.right(), "the drawing's toggle {dims:?} stands right of the facts {taper:?}");
+    assert!(win.expand(1.0).contains_rect(dims), "the toggle stays in the window {win:?}");
+}
diff --git a/crates/ui/src/egui_app/tests/tool_library_holders_ui.rs b/crates/ui/src/egui_app/tests/tool_library_holders_ui.rs
new file mode 100644
index 000000000..2b56f4653
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/tool_library_holders_ui.rs
@@ -0,0 +1,101 @@
+//! #3897 (U6 of #3663): the Holders page of the tool library window. The
+//! list groups the built-in holders by taper with the count of the tools
+//! that use each one; a holder opens in a read-only view that lists those
+//! tools (a click opens the tool in the editor) and draws the outline,
+//! built only when its input changes. No click here queues a command.
+//! Gate map: covers ui::egui_app::tool_library_dialog, ui::state.
+//! Provenance: our own structural tests; no HSMWorks material involved.
+
+use egui::accesskit::Role;
+
+use super::tool_library_editor::{H, click_window_button, library_window};
+use super::tool_library_mockup::{HOLDER, seeded_in_holder};
+use super::*;
+use crate::egui_app::tool_library_dialog::{HOLDERS_PAGE, holder_view, holders};
+use crate::state::LibraryPage;
+
+/// Open the window on its Holders page.
+pub(super) fn open_holders(h: &mut H) {
+    h.get_by_role_and_label(Role::Button, "Tools").click();
+    h.run_steps(2);
+    click_window_button(h, HOLDERS_PAGE);
+}
+
+/// Narrow the holder rows to `HOLDER`, so its row is in view (a long
+/// list scrolls, and a click lands where the row is drawn).
+pub(super) fn filter_to_holder(h: &mut H) {
+    if let Some(v) = h.state_mut().state.tool_library.as_mut() {
+        v.holders.filter = HOLDER.to_owned();
+    }
+    h.run_steps(3);
+}
+
+fn has(h: &H, label: &str) -> bool {
+    library_window(h).query_all_by_label(label).next().is_some()
+}
+
+#[test]
+fn a_holder_lists_the_tools_that_use_it() {
+    let mut h = shell_harness();
+    h.run_steps(2);
+    let name = seeded_in_holder(&mut h);
+    open_holders(&mut h);
+    let done = h.state().state.history.done_len();
+    assert!(has(&h, holders::ALL), "the taper column shows");
+    filter_to_holder(&mut h);
+    assert!(has(&h, "1 tool"), "the list counts the one tool in {HOLDER}");
+    click_window_button(&mut h, HOLDER);
+    let view = h.state().state.tool_library.as_ref().map(|v| v.holders.open.clone());
+    assert_eq!(view, Some(Some(HOLDER.to_owned())), "the holder view is open");
+    assert!(has(&h, holder_view::BACK), "the view has its way back");
+    assert!(has(&h, holders::READ_ONLY), "the view says it is read-only");
+    assert!(has(&h, &name), "the view lists {name}");
+    assert!(has(&h, "ER32 collet"), "the view shows the clamp");
+    // A click on the tool opens it in the editor, on the tool list.
+    library_window(&h).get_by_label(&name).click();
+    h.run_steps(3);
+    let st = &h.state().state;
+    let v = st.tool_library.as_ref().unwrap_or_else(|| panic!("the window stays open"));
+    assert_eq!(v.page, LibraryPage::Tools, "the tool opens on the tool list");
+    assert_eq!(v.open_tool(), Some(name.as_str()), "the tool is open in the editor");
+    assert_eq!(st.history.done_len(), done, "browsing holders lands no command");
+    assert!(st.pending.is_empty(), "and queues none");
+}
+
+#[test]
+fn the_machine_taper_comes_first_and_a_taper_filters_the_list() {
+    let rows = holders::rows();
+    assert!(rows.len() >= 40, "the built-in library: {} holders", rows.len());
+    let tapers = holders::tapers(&rows, Some("bt40"));
+    assert_eq!(tapers.first().copied(), Some("BT40"), "the machine's taper first: {tapers:?}");
+    let unsorted = holders::tapers(&rows, None);
+    assert_eq!(tapers.len(), unsorted.len(), "every taper stays");
+    let mut h = shell_harness();
+    h.run_steps(2);
+    open_holders(&mut h);
+    assert!(has(&h, "BT30 ER20"), "all holders show");
+    click_window_button(&mut h, "CAT40");
+    assert!(has(&h, "CAT40 ER32") && !has(&h, "BT30 ER20"), "the CAT40 pick shows its holders only");
+    click_window_button(&mut h, holders::ALL);
+    assert!(has(&h, "BT30 ER20"), "All holders shows them again");
+}
+
+#[test]
+fn a_still_frame_builds_no_holder_outline() {
+    let mut h = shell_harness();
+    h.run_steps(2);
+    open_holders(&mut h);
+    filter_to_holder(&mut h);
+    click_window_button(&mut h, HOLDER);
+    let b = holder_view::builds();
+    h.run_steps(3);
+    assert_eq!(holder_view::builds(), b, "a still frame builds no outline");
+    // A changed input (the dimension toggle) builds it once, then holds.
+    library_window(&h).get_by_label(holder_view::DIMS).click();
+    h.run_steps(2);
+    let b1 = holder_view::builds();
+    assert!(b1 > b, "the toggle builds the outline again");
+    h.run_steps(3);
+    assert_eq!(holder_view::builds(), b1, "and then holds");
+    assert!(h.state().state.tool_library.as_ref().is_some_and(|v| v.holders.hide_dims), "the toggle is view state");
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/holder_view.rs b/crates/ui/src/egui_app/tool_library_dialog/holder_view.rs
new file mode 100644
index 000000000..ee36d2fca
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/holder_view.rs
@@ -0,0 +1,260 @@
+//! #3897 (U6 of #3663): the read-only holder view of the tool library
+//! window, as the holder picture of the #3663 mock-up: the machine side
+//! (the spindle taper, marked when it is the mounted machine's), the tool
+//! side (the clamp and its clamping range), the shape (gauge length,
+//! largest and nose diameter), the document tools that use the holder
+//! (a click opens the tool in the editor), and the outline to scale with
+//! its dimension lines. Nothing here is editable: a built-in holder is
+//! fixed, and holder edits wait for the user library of #3645 (U7).
+//! Frame cost (`crates/ui/AGENTS.md`): the outline's shapes and labels
+//! are built when the holder, the drawing's rect, the unit or the
+//! dimension toggle change; a still frame builds nothing (`builds`).
+//! Provenance: our own view over `holder_library::HolderEntry::points`;
+//! the dimension style follows `side_view` (general drawing practice).
+//! No HSMWorks material involved.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use egui::{Align2, Color32, FontId, Pos2, Rect, RichText, Sense, Shape, Stroke, Ui, Vec2};
+
+use camcraft_app::holder_library::HolderEntry;
+use camcraft_app::tool_body;
+use camcraft_app::units::{self, Unit};
+
+use super::holders::{self, READ_ONLY};
+use crate::egui_app::tool_model_view::BG;
+use crate::state::State;
+
+/// The button back to the holder list.
+pub(crate) const BACK: &str = "Holder list";
+/// The heading of the tools that use the holder.
+pub(crate) const USED_BY: &str = "Used by";
+/// The drawing's dimension toggle.
+pub(crate) const DIMS: &str = "Dimensions";
+const FACTS_W: f32 = 380.0;
+const BODY: Color32 = Color32::from_rgb(86, 92, 104);
+const EDGE: Color32 = Color32::from_rgb(214, 220, 228);
+const DIM: Color32 = Color32::from_rgb(0x7F, 0xB4, 0xD8);
+const NOTE: Color32 = Color32::from_rgb(0x9E, 0xA8, 0xB8);
+
+/// What the user asked for this frame.
+enum Ask {
+    List,
+    Tool(String),
+}
+
+pub(super) fn draw(ui: &mut Ui, state: &mut State) {
+    let Some(view) = state.tool_library.as_ref().map(|v| v.holders.clone()) else {
+        return;
+    };
+    let rows = holders::rows();
+    let Some(row) = view.open.as_deref().and_then(|n| rows.iter().find(|r| r.name == n)) else {
+        // A name the library does not hold: back to the list.
+        state.open_holder_in_library(None);
+        return;
+    };
+    let e = row.entry;
+    let u = state.units();
+    let machine = holders::machine_taper(state);
+    let users = tool_body::tools_using_holder(&state.world, &row.name);
+    let mut ask = None;
+    let mut hide = view.hide_dims;
+    ui.horizontal(|ui| {
+        if ui.button(BACK).on_hover_text("back to the holders by taper").clicked() {
+            ask = Some(Ask::List);
+        }
+        ui.heading(row.name.as_str());
+        ui.weak(format!("holder · used by {}", count(users.len())));
+    });
+    ui.weak(READ_ONLY);
+    ui.separator();
+    // Bounded by the screen: a column as tall as the room left would let
+    // the window grow each frame.
+    let h = ui.available_height().min(ui.ctx().viewport_rect().height() * 0.7 - 140.0).max(160.0);
+    ui.horizontal_top(|ui| {
+        ui.vertical(|ui| {
+            ui.set_width(FACTS_W);
+            egui::ScrollArea::vertical().id_salt("tool_library_holder_facts").max_height(h).show(ui, |ui| {
+                facts(ui, &e, machine.as_deref(), u);
+                if let Some(t) = used_by(ui, state, &users) {
+                    ask = Some(Ask::Tool(t));
+                }
+            });
+        });
+        ui.separator();
+        ui.vertical(|ui| {
+            let mut show = !hide;
+            ui.horizontal(|ui| {
+                ui.checkbox(&mut show, DIMS).on_hover_text("show the dimension lines of the drawing");
+                ui.weak(format!("to scale · {}", u.suffix()));
+            });
+            hide = !show;
+            let size = Vec2::new(ui.available_width().max(160.0), (h - 30.0).max(160.0));
+            outline(ui, &row.name, &e, size, u, show);
+        });
+    });
+    if let Some(v) = state.tool_library.as_mut() {
+        v.holders.hide_dims = hide;
+    }
+    match ask {
+        Some(Ask::List) => state.open_holder_in_library(None),
+        Some(Ask::Tool(name)) => state.open_tool_in_library(&name),
+        None => {}
+    }
+}
+
+fn count(n: usize) -> String {
+    if n == 1 { "1 tool".to_owned() } else { format!("{n} tools") }
+}
+
+/// The machine side, the tool side and the shape, as label rows.
+fn facts(ui: &mut Ui, e: &HolderEntry, machine: Option<&str>, u: Unit) {
+    let l = |v: f64| format!("{} {}", units::len(v, u, 2), u.suffix());
+    let taper = e.taper.map_or(holders::STRAIGHT, |t| t.name);
+    let taper_note = match (e.taper, machine) {
+        (Some(t), Some(m)) if m.eq_ignore_ascii_case(t.name) => "the mounted machine's taper".to_owned(),
+        (_, Some(m)) => format!("the mounted machine takes {m}"),
+        (_, None) => "the machine states no taper".to_owned(),
+    };
+    let nose = e.body_r() * 2.0;
+    let sections: [(&str, Vec<(&str, String)>); 3] = [
+        ("MACHINE SIDE", vec![("Spindle taper", format!("{taper} ({taper_note})"))]),
+        ("TOOL SIDE", vec![("Clamp", holders::clamp_text(e)), ("Clamping range", format!("Ø {} {}", holders::range_text(e, u), u.suffix()))]),
+        (
+            "SHAPE",
+            vec![("Gauge length", l(e.gauge_len)), ("Largest diameter", l(holders::largest_d(e))), ("Nose diameter", l(nose))],
+        ),
+    ];
+    for (head, rows) in sections {
+        ui.add_space(4.0);
+        ui.label(RichText::new(head).small().weak());
+        egui::Grid::new(("holder_facts", head)).num_columns(2).show(ui, |ui| {
+            for (k, v) in rows {
+                ui.label(k);
+                ui.label(v);
+                ui.end_row();
+            }
+        });
+    }
+}
+
+/// The tools that use the holder: a link for each, with its stick-out and
+/// gauge length. Gives the tool the user opened.
+fn used_by(ui: &mut Ui, state: &State, users: &[String]) -> Option<String> {
+    ui.add_space(6.0);
+    ui.label(RichText::new(format!("{USED_BY} {}", count(users.len()))).small().weak());
+    if users.is_empty() {
+        ui.weak("No tool of this document uses this holder.");
+        return None;
+    }
+    let u = state.units();
+    let refs = tool_body::holder_users(&state.world);
+    let mut out = None;
+    for name in users {
+        ui.horizontal(|ui| {
+            if ui.link(name.as_str()).on_hover_text("edit this tool in this window").clicked() {
+                out = Some(name.clone());
+            }
+            if let Some((_, r)) = refs.iter().find(|(n, _)| n == name) {
+                let l = |v: f64| units::len(v, u, 2);
+                ui.weak(format!("stick-out {}, gauge {} {}", l(r.projection), l(r.gauge_len + r.projection), u.suffix()));
+            }
+        });
+    }
+    out
+}
+
+/// What the outline was built from.
+#[derive(Clone, PartialEq)]
+struct Key {
+    name: String,
+    rect: Rect,
+    unit: Unit,
+    dims: bool,
+}
+
+/// The kept drawing: its shapes and its labels.
+struct Drawing {
+    shapes: Vec<Shape>,
+    labels: Vec<(Pos2, Align2, String)>,
+}
+
+thread_local! {
+    static KEPT: RefCell<Option<(Key, Rc<Drawing>)>> = const { RefCell::new(None) };
+    static BUILDS: Cell<u64> = const { Cell::new(0) };
+}
+
+/// The outline drawings built on this thread - a still frame adds none.
+#[cfg(test)]
+pub(crate) fn builds() -> u64 {
+    BUILDS.with(Cell::get)
+}
+
+/// The holder to scale in a `size` area, nose down, gauge line up.
+fn outline(ui: &mut Ui, name: &str, e: &HolderEntry, size: Vec2, u: Unit, dims: bool) {
+    let (resp, painter) = ui.allocate_painter(size, Sense::hover());
+    painter.rect_filled(resp.rect, 4.0, BG);
+    let key = Key { name: name.to_owned(), rect: resp.rect, unit: u, dims };
+    let d = KEPT.with(|k| {
+        let mut k = k.borrow_mut();
+        if let Some((kk, d)) = k.as_ref()
+            && *kk == key
+        {
+            return Rc::clone(d);
+        }
+        BUILDS.with(|b| b.set(b.get().saturating_add(1)));
+        let d = Rc::new(build(e, resp.rect, u, dims));
+        *k = Some((key, Rc::clone(&d)));
+        d
+    });
+    painter.extend(d.shapes.iter().cloned());
+    for (at, align, text) in &d.labels {
+        painter.text(*at, *align, text, FontId::proportional(11.0), NOTE);
+    }
+}
+
+fn build(e: &HolderEntry, rect: Rect, u: Unit, dims: bool) -> Drawing {
+    let mut d = Drawing { shapes: Vec::new(), labels: Vec::new() };
+    let Ok(points) = e.points(0.0, e.gauge_len) else {
+        d.labels.push((rect.center(), Align2::CENTER_CENTER, "no outline".to_owned()));
+        return d;
+    };
+    let pts: Vec<(f64, f64)> = points.iter().map(|p| (p.z, p.r)).filter(|(z, r)| z.is_finite() && r.is_finite()).collect();
+    let r_max = pts.iter().map(|p| p.1).fold(0.0f64, f64::max);
+    let z_max = pts.iter().map(|p| p.0).fold(0.0f64, f64::max);
+    if r_max <= 0.0 || z_max <= 0.0 {
+        return d;
+    }
+    let inner = rect.shrink2(Vec2::new(70.0, 34.0));
+    let scale = (inner.width() / (2.0 * r_max as f32)).min(inner.height() / z_max as f32).max(f32::EPSILON);
+    let (axis, base) = (inner.center().x, inner.bottom());
+    let at = |z: f64, r: f64| Pos2::new(axis + r as f32 * scale, base - z as f32 * scale);
+    d.shapes.push(Shape::line_segment([Pos2::new(axis, rect.top() + 4.0), Pos2::new(axis, rect.bottom() - 4.0)], Stroke::new(1.0, Color32::from_rgb(70, 74, 84))));
+    for w in pts.windows(2) {
+        let ((z0, r0), (z1, r1)) = (w[0], w[1]);
+        if z1 > z0 {
+            d.shapes.push(Shape::convex_polygon(vec![at(z0, -r0), at(z0, r0), at(z1, r1), at(z1, -r1)], BODY, Stroke::NONE));
+        }
+    }
+    let mut edge: Vec<Pos2> = pts.iter().map(|&(z, r)| at(z, r)).collect();
+    edge.extend(pts.iter().filter(|p| p.1 > 0.0).rev().map(|&(z, r)| at(z, -r)));
+    d.shapes.push(Shape::closed_line(edge, Stroke::new(1.0, EDGE)));
+    if dims {
+        let len = |v: f64| units::len(v, u, 2);
+        let stroke = Stroke::new(1.0, DIM);
+        // The gauge length on the right, the largest diameter over the top,
+        // the nose diameter under the nose.
+        let x = at(0.0, r_max).x + 14.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(x, at(0.0, 0.0).y), Pos2::new(x, at(z_max, 0.0).y)], stroke));
+        d.labels.push((Pos2::new(x + 4.0, at(z_max * 0.5, 0.0).y), Align2::LEFT_CENTER, format!("gauge length {}", len(e.gauge_len))));
+        let y = at(z_max, 0.0).y - 10.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(at(0.0, -r_max).x, y), Pos2::new(at(0.0, r_max).x, y)], stroke));
+        d.labels.push((Pos2::new(axis, y - 2.0), Align2::CENTER_BOTTOM, format!("Ø {}", len(holders::largest_d(e)))));
+        let rn = e.body_r();
+        let y = base + 10.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(at(0.0, -rn).x, y), Pos2::new(at(0.0, rn).x, y)], stroke));
+        d.labels.push((Pos2::new(axis, y + 2.0), Align2::CENTER_TOP, format!("nose Ø {}", len(rn * 2.0))));
+    }
+    d
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/holders.rs b/crates/ui/src/egui_app/tool_library_dialog/holders.rs
new file mode 100644
index 000000000..c8008e827
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/holders.rs
@@ -0,0 +1,235 @@
+//! #3897 (U6 of #3663): the Holders page of the tool library window - the
+//! built-in holder library (`holder_library::library`) grouped by spindle
+//! taper, the taper of the mounted machine first and marked. A row gives
+//! the name, the taper, the clamp, the clamping range, the gauge length,
+//! the largest diameter and the number of document tools that use the
+//! holder (`app::tool_body::holder_users`, keyed on the entry name). A
+//! click on a name opens the read-only holder view (`holder_view`).
+//! Built-in holders are read-only: user holders and holder edits need the
+//! user library store of #3645 (U7, #3898).
+//! Frame cost: the library rows are built once for each thread; a frame
+//! reads the document's holder references and formats the rows.
+//! Provenance: our own list over our own holder library; no HSMWorks
+//! material involved.
+
+use std::cell::OnceCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use egui::{RichText, Ui};
+
+use camcraft_app::holder_library::{self, Clamp, HolderEntry};
+use camcraft_app::tool_body;
+use camcraft_app::units::{self, Unit};
+
+use crate::state::State;
+
+/// The label of the row that shows every taper.
+pub(crate) const ALL: &str = "All holders";
+/// The name of the group of the straight-shank chucks (no taper).
+pub(crate) const STRAIGHT: &str = "Straight shank";
+/// The note that says what the page cannot do yet.
+pub(crate) const READ_ONLY: &str =
+    "Built-in holders are read-only. User holders and holder edits come with the user library (#3645).";
+/// The column heads.
+pub(crate) const HEADS: [&str; 7] = ["Name", "Taper", "Clamp", "Clamps Ø", "Gauge length", "Largest Ø", "Used by"];
+const TAPER_W: f32 = 170.0;
+
+/// One library holder as the list shows it.
+#[derive(Clone, Debug)]
+pub(crate) struct Row {
+    pub entry: HolderEntry,
+    pub name: String,
+    /// The taper's name, or "" for a straight-shank chuck.
+    pub taper: &'static str,
+}
+
+thread_local! {
+    static ROWS: OnceCell<Rc<Vec<Row>>> = const { OnceCell::new() };
+}
+
+/// The library's rows, in the library's order (built once).
+pub(crate) fn rows() -> Rc<Vec<Row>> {
+    ROWS.with(|r| {
+        Rc::clone(r.get_or_init(|| {
+            Rc::new(
+                holder_library::library()
+                    .into_iter()
+                    .map(|e| Row { name: e.name(), taper: e.taper.map_or("", |t| t.name), entry: e })
+                    .collect(),
+            )
+        }))
+    })
+}
+
+/// The group name of a taper ("" is the straight-shank group).
+pub(crate) fn group_name(taper: &str) -> &str {
+    if taper.is_empty() { STRAIGHT } else { taper }
+}
+
+/// The taper the mounted machine's spindle takes, if the machine states one.
+pub(crate) fn machine_taper(state: &State) -> Option<String> {
+    camcraft_app::machine::document_of(&state.world).1.and_then(|m| m.spindle_mount)
+}
+
+/// The tapers in the list's order: the machine's first, then the library's.
+pub(crate) fn tapers(rows: &[Row], machine: Option<&str>) -> Vec<&'static str> {
+    let mut out: Vec<&'static str> = Vec::new();
+    for r in rows {
+        if !out.contains(&r.taper) {
+            out.push(r.taper);
+        }
+    }
+    if let Some(m) = machine
+        && let Some(i) = out.iter().position(|t| t.eq_ignore_ascii_case(m))
+    {
+        let t = out.remove(i);
+        out.insert(0, t);
+    }
+    out
+}
+
+/// The document tools that use each holder, by `tool_body::holder_key`.
+pub(crate) fn users(state: &State) -> HashMap<String, Vec<String>> {
+    let mut out: HashMap<String, Vec<String>> = HashMap::new();
+    for (tool, r) in tool_body::holder_users(&state.world) {
+        out.entry(tool_body::holder_key(&r.entry)).or_default().push(tool);
+    }
+    out
+}
+
+/// The clamp as words: "ER32 collet", "Weldon side lock".
+pub(crate) fn clamp_text(e: &HolderEntry) -> String {
+    match e.clamp {
+        Clamp::Er(er) => format!("{} collet", er.name),
+        Clamp::Weldon { .. } => "Weldon side lock".to_owned(),
+    }
+}
+
+/// The shank diameters the holder takes.
+pub(crate) fn range_text(e: &HolderEntry, u: Unit) -> String {
+    match e.clamp {
+        Clamp::Er(er) => format!("{} – {}", units::len(er.min_bore, u, 2), units::len(er.max_bore, u, 2)),
+        Clamp::Weldon { bore, .. } => units::len(bore, u, 3),
+    }
+}
+
+/// The largest diameter of the holder: the flange's or the nose's.
+pub(crate) fn largest_d(e: &HolderEntry) -> f64 {
+    e.taper.map_or(0.0, |t| t.flange_d).max(e.body_r() * 2.0)
+}
+
+pub(super) fn draw(ui: &mut Ui, state: &mut State) {
+    let rows = rows();
+    let machine = machine_taper(state);
+    let users = users(state);
+    let Some(view) = state.tool_library.as_ref().map(|v| v.holders.clone()) else {
+        return;
+    };
+    let mut pick_taper = None;
+    let mut open = None;
+    let mut filter = view.filter.clone();
+    ui.horizontal_top(|ui| {
+        ui.vertical(|ui| {
+            ui.set_width(TAPER_W);
+            pick_taper = taper_column(ui, &rows, machine.as_deref(), view.taper.as_deref());
+        });
+        ui.separator();
+        ui.vertical(|ui| {
+            let label = ui.label("Holder filter");
+            ui.add(egui::TextEdit::singleline(&mut filter).desired_width(ui.available_width())).labelled_by(label.id);
+            ui.weak(READ_ONLY);
+            egui::ScrollArea::both().id_salt("tool_library_holders").auto_shrink([false, false]).show(ui, |ui| {
+                open = table(ui, &rows, &users, machine.as_deref(), &view.taper, &filter, state.units());
+            });
+        });
+    });
+    if let Some(v) = state.tool_library.as_mut() {
+        v.holders.filter = filter;
+        if let Some(t) = pick_taper {
+            v.holders.taper = t;
+        }
+    }
+    if let Some(name) = open {
+        state.open_holder_in_library(Some(&name));
+    }
+}
+
+/// "All holders", then one row for each taper with its count, then the
+/// machine's taper. Gives the new taper pick when the user clicks a row.
+fn taper_column(ui: &mut Ui, rows: &[Row], machine: Option<&str>, picked: Option<&str>) -> Option<Option<String>> {
+    let mut out = None;
+    ui.label(RichText::new("SPINDLE TAPER").small().weak());
+    let item = |ui: &mut Ui, sel: bool, text: &str, n: usize| {
+        ui.horizontal(|ui| {
+            let c = ui.selectable_label(sel, text).clicked();
+            ui.weak(n.to_string());
+            c
+        })
+        .inner
+    };
+    if item(ui, picked.is_none(), ALL, rows.len()) {
+        out = Some(None);
+    }
+    for t in tapers(rows, machine) {
+        let n = rows.iter().filter(|r| r.taper == t).count();
+        let mark = machine.is_some_and(|m| m.eq_ignore_ascii_case(t));
+        let text = if mark { format!("{} (machine)", group_name(t)) } else { group_name(t).to_owned() };
+        if item(ui, picked == Some(t), &text, n) {
+            out = Some(Some(t.to_owned()));
+        }
+    }
+    ui.add_space(8.0);
+    ui.label(RichText::new("MACHINE").small().weak());
+    ui.label(match machine {
+        Some(m) => format!("The mounted machine takes {m}. Its holders come first."),
+        None => "The mounted machine states no spindle taper.".to_owned(),
+    });
+    out
+}
+
+/// The holder rows, grouped by taper; gives the name the user opened.
+fn table(
+    ui: &mut Ui,
+    rows: &[Row],
+    users: &HashMap<String, Vec<String>>,
+    machine: Option<&str>,
+    taper: &Option<String>,
+    filter: &str,
+    u: Unit,
+) -> Option<String> {
+    let f = filter.to_lowercase();
+    let mut open = None;
+    egui::Grid::new("tool_library_holder_rows").striped(true).show(ui, |ui| {
+        for h in HEADS {
+            ui.label(RichText::new(h).strong());
+        }
+        ui.end_row();
+        for t in tapers(rows, machine) {
+            if taper.as_deref().is_some_and(|p| p != t) {
+                continue;
+            }
+            let shown: Vec<&Row> = rows.iter().filter(|r| r.taper == t && r.name.to_lowercase().contains(&f)).collect();
+            if shown.is_empty() {
+                continue;
+            }
+            let mark = if machine.is_some_and(|m| m.eq_ignore_ascii_case(t)) { "  (the machine's taper)" } else { "" };
+            ui.label(RichText::new(format!("{}{mark}", group_name(t))).small().weak());
+            ui.end_row();
+            for r in shown {
+                if ui.selectable_label(false, &r.name).on_hover_text("open this holder").clicked() {
+                    open = Some(r.name.clone());
+                }
+                ui.label(group_name(r.taper));
+                ui.label(clamp_text(&r.entry));
+                ui.label(range_text(&r.entry, u));
+                ui.label(units::len(r.entry.gauge_len, u, 2));
+                ui.label(units::len(largest_d(&r.entry), u, 2));
+                let n = users.get(&tool_body::holder_key(&r.name)).map_or(0, Vec::len);
+                ui.label(if n == 1 { "1 tool".to_owned() } else { format!("{n} tools") });
+                ui.end_row();
+            }
+        }
+    });
+    open
+}
