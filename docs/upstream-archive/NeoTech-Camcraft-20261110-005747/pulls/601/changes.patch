diff --git a/crates/app/src/schema.rs b/crates/app/src/schema.rs
index a6f7d66f..65739481 100644
--- a/crates/app/src/schema.rs
+++ b/crates/app/src/schema.rs
@@ -380,6 +380,26 @@ pub struct PostOptions {
     pub skip_stops: bool,
     /// One standalone program per operation (#111).
     pub per_op: bool,
