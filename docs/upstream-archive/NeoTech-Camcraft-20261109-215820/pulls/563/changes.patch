@@ -0,0 +1,72 @@
+//! The lifted-return law (issue #220, after #47's microlift): a return
+//! lifted over the floor must travel in air - the cutter's disc, read on
+//! the in-process dexel stock the instant before the move runs, may
+//! stand over no column still above the lift. The rim reading of
+//! `quality` is the wrong yardstick here (it reads a cell and a half
+//! OUTSIDE the cutter, so a return grazing the face it just cut reads a
+//! few degrees of "contact" at zero depth); this reads INSIDE the disc,
+//! two cells in, where a real collision would stand. Sampling law ours.
+
+use crate::cl::{MoveKind, Toolpath};
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::stock_sim::Dexel;
+
+/// Height slack: a column within a micron of the lift is cut.
+const Z_EPS: f64 = 1e-3;
+
+/// Rim samples per ring of the disc read.
+const RING: usize = 24;
+
+/// The first point where a lifted planar feed of `path` (a planar feed
+/// above the lowest plane fed since the last rapid) would stand its
+/// disc of radius `r` over stock in `dex`, which is cut by every move
+/// in order as the walk goes; `None` when every lifted move is in air.
+pub fn lifted_cut(path: &Toolpath, dex: &mut Dexel, r: f64) -> Option<Point3> {
+    let inner = (r - 2.0 * dex.cell).max(0.0);
+    let step = (r / 10.0).max(dex.cell);
+    let mut plane: Option<f64> = None;
+    for m in &path.moves {
+        if m.kind == MoveKind::Rapid {
+            plane = None;
+            continue;
+        }
+        let planar = (m.from.z - m.to.z).abs() <= 1e-9;
+        if planar && m.kind == MoveKind::Feed {
+            match plane {
+                Some(z) if m.to.z > z + 1e-6 => {
+                    if let Some(p) = first_stock(dex, m.segments3(0.01).as_slice(), inner, step) {
+                        return Some(p);
+                    }
+                }
+                _ => plane = Some(plane.map_or(m.to.z, |z| z.min(m.to.z))),
+            }
+        }
+        dex.subtract(m, r, 0.01);
+    }
+    None
+}
+
+/// The first sample along `segs` whose disc (radius `inner`) stands
+/// over a column above the sample's height.
+fn first_stock(dex: &Dexel, segs: &[(Point3, Point3)], inner: f64, step: f64) -> Option<Point3> {
+    for &(a, b) in segs {
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        let n = ((len / step).ceil() as usize).clamp(1, 1 << 16);
+        for k in 0..=n {
+            let t = k as f64 / n as f64;
+            let p = Point3::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
+            let mut pts = vec![Point2::new(p.x, p.y)];
+            for rr in [0.5 * inner, inner] {
+                for j in 0..RING {
+                    let ang = j as f64 * std::f64::consts::TAU / RING as f64;
+                    pts.push(Point2::new(p.x + rr * ang.cos(), p.y + rr * ang.sin()));
+                }
+            }
+            if pts.iter().any(|&q| dex.col(q).is_some_and(|i| dex.top_at(i) > p.z + Z_EPS)) {
+                return Some(p);
+            }
+        }
+    }
+    None
+}
diff --git a/crates/motion/src/machining2d/trochoid_loops.rs b/crates/motion/src/machining2d/trochoid_loops.rs
new file mode 100644
index 00000000..93777d39
--- /dev/null
+++ b/crates/motion/src/machining2d/trochoid_loops.rs
@@ -0,0 +1,293 @@
+//! The trochoidal slot's loop layout (issue #220): circular trochoid
+//! loops `x(phi) = B cos phi, y(phi) = B sin phi + S phi / 2pi` (Otkur &
+//! Lazoglu 2007, "Trochoidal milling", IJMTM 47; Rauch, Duc & Hascoet
+//! 2009, IJMTM 49) laid along a centre chain, cut on their FRONT arc
+//! only, the return between them lifted. Circular, trochoidal and
+//! epicycloidal parameterisations (Prod. Eng. 2021, doi
+//! 10.1007/s11740-021-01060-4) differ only in the return; ours is the
+//! front arc retraced over the floor.
+//!
+//! Why front arcs only: the verifier's crossing law holds the post on
+//! two Feed moves crossing at a shared depth, and every textbook full
+//! circle crosses the loop before it. Each front arc here meets the two
+//! walls of the loop band `|v| <= b` at the angle `END_DEG` (its circle
+//! has radius `rho = b / cos END_DEG`, centre `rho sin END_DEG` behind
+//! the wall points), so it is a graph over the band's width and the arcs
+//! of a straight chain are translates of one another: they never cross,
+//! whatever the step. The tool reaches the next arc's start by a lead
+//! along the wall (the cusp between two loops is cut there), so the
+//! walls come out clean. The band's ends are a bored circle at the
+//! chain's start and a pencil of arcs through the end's two wall points
+//! (tips stepped like the loops) closing the far cap. The layout, the
+//! end angle and the cap pencil are ours; no vendor material.
+
+use crate::geo2d::Point2;
+
+/// The angle (degrees) a front arc meets the band's wall at.
+pub(super) const END_DEG: f64 = 10.0;
+
+/// Loops at most (the Prime Directive's "never hang").
+pub(super) const MAX_LOOPS: usize = 20_000;
+
+/// One element of a cut, from where the tool stands.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum El {
+    Arc { center: Point2, to: Point2, ccw: bool },
+}
+
+/// One loop: the lead's target on the wall (where the next return comes
+/// back down), then the cut from there (fillet and front arc).
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct Piece {
+    pub(super) start: Point2,
+    pub(super) cut: Vec<El>,
+}
+
+impl Piece {
+    /// The cut walked backwards from its end: the retraced return.
+    pub(super) fn retrace(&self) -> Vec<El> {
+        let mut out = Vec::with_capacity(self.cut.len());
+        for (i, el) in self.cut.iter().enumerate().rev() {
+            let to = if i == 0 { self.start } else { end_of(&self.cut[i - 1]) };
+            match *el {
+                El::Arc { center, ccw, .. } => out.push(El::Arc { center, to, ccw: !ccw }),
+            }
+        }
+        out
+    }
+
+    /// Where the cut ends.
+    pub(super) fn end(&self) -> Point2 {
+        self.cut.last().map_or(self.start, end_of)
+    }
+}
+
+fn end_of(el: &El) -> Point2 {
+    match *el {
+        El::Arc { to, .. } => to,
+    }
+}
+
+/// The loops of one level.
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct Layout {
+    /// The bore: its centre (the chain's start), its radius `b`, the
+    /// wall point the helix starts and ends at, the point opposite it.
+    pub(super) c0: Point2,
+    pub(super) b: f64,
+    pub(super) entry: Point2,
+    pub(super) opposite: Point2,
+    /// Travel sense of the bore and of every arc (CCW for climb).
+    pub(super) ccw: bool,
+    pub(super) pieces: Vec<Piece>,
+    /// Front-arc loops along the chain (the cap pencil not counted).
+    pub(super) loops: usize,
+    /// The loop circle's radius and the centre spacing actually used.
+    pub(super) rho: f64,
+    pub(super) spacing: f64,
+}
+
+/// A polyline walked by arc length.
+pub(super) struct Chain<'a> {
+    pts: &'a [Point2],
+    acc: Vec<f64>,
+}
+
+impl<'a> Chain<'a> {
+    /// `None` when fewer than two points or a zero-length span.
+    pub(super) fn new(pts: &'a [Point2]) -> Option<Self> {
+        if pts.len() < 2 || pts.iter().any(|p| !(p.x.is_finite() && p.y.is_finite())) {
+            return None;
+        }
+        let mut acc = Vec::with_capacity(pts.len());
+        let mut s = 0.0;
+        acc.push(0.0);
+        for w in pts.windows(2) {
+            let l = dist(w[0], w[1]);
+            if l <= 1e-9 {
+                return None;
+            }
+            s += l;
+            acc.push(s);
+        }
+        Some(Chain { pts, acc })
+    }
+
+    pub(super) fn len(&self) -> f64 {
+        self.acc.last().copied().unwrap_or(0.0)
+    }
+
+    /// The point at arc length `s` (clamped onto the chain).
+    pub(super) fn at(&self, s: f64) -> Point2 {
+        let s = s.clamp(0.0, self.len());
+        let i = self.acc.partition_point(|&a| a <= s).clamp(1, self.pts.len() - 1);
+        let (a, b) = (self.pts[i - 1], self.pts[i]);
+        let l = self.acc[i] - self.acc[i - 1];
+        let t = if l > 0.0 { ((s - self.acc[i - 1]) / l).clamp(0.0, 1.0) } else { 0.0 };
+        Point2::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t)
+    }
+
+    /// The unit direction at `s`: the chord from `s - h` to `s + h`
+    /// (a loop faces the way its neighbours advance), the end span's
+    /// own where the chord degenerates.
+    pub(super) fn dir(&self, s: f64, h: f64) -> Point2 {
+        let (a, b) = (self.at(s - h), self.at(s + h));
+        let l = dist(a, b);
+        if l > 1e-9 {
+            return Point2::new((b.x - a.x) / l, (b.y - a.y) / l);
+        }
+        let n = self.pts.len();
+        let (a, b) = (self.pts[n - 2], self.pts[n - 1]);
+        let l = dist(a, b).max(1e-12);
+        Point2::new((b.x - a.x) / l, (b.y - a.y) / l)
+    }
+
+    /// Distance from `p` to the chain.
+    pub(super) fn distance(&self, p: Point2) -> f64 {
+        self.pts.windows(2).map(|w| seg_dist(p, w[0], w[1])).fold(f64::INFINITY, f64::min)
+    }
+}
+
+pub(super) fn dist(a: Point2, b: Point2) -> f64 {
+    (b.x - a.x).hypot(b.y - a.y)
+}
+
+fn seg_dist(p: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let l2 = dx * dx + dy * dy;
+    let t = if l2 > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+    dist(p, Point2::new(a.x + dx * t, a.y + dy * t))
+}
+
+/// A loop's local frame: centre, forward unit, wall-side unit (the side
+/// the arcs start from is `-side`).
+#[derive(Clone, Copy)]
+struct Frame {
+    c: Point2,
+    t: Point2,
+    n: Point2,
+}
+
+impl Frame {
+    fn new(c: Point2, t: Point2, ccw: bool) -> Self {
+        let s = if ccw { 1.0 } else { -1.0 };
+        Frame { c, t, n: Point2::new(-t.y * s, t.x * s) }
+    }
+
+    fn at(&self, u: f64, v: f64) -> Point2 {
+        Point2::new(self.c.x + u * self.t.x + v * self.n.x, self.c.y + u * self.t.y + v * self.n.y)
+    }
+}
+
+/// One front arc in `f`: the circle of radius `rho` about the frame's
+/// centre, from its wall point `(sqrt(rho^2 - b^2), -b)` to `(.., b)`,
+/// entered tangentially off the wall by a fillet of radius `fillet`
+/// (0: none; clamped under the band's half-width).
+fn front(f: &Frame, rho: f64, b: f64, fillet: f64, ccw: bool) -> Piece {
+    let u = (rho * rho - b * b).max(0.0).sqrt();
+    let end = f.at(u, b);
+    let rf = fillet.min(0.9 * b).max(0.0);
+    if rf <= 1e-6 || rho - b <= 1e-9 {
+        return Piece { start: f.at(u, -b), cut: vec![El::Arc { center: f.c, to: end, ccw }] };
+    }
+    // The fillet circle: tangent to the wall `v = -b` from inside and to
+    // the loop circle from inside (`|F| = rho - rf`).
+    let fx = ((rho - rf).powi(2) - (b - rf).powi(2)).max(0.0).sqrt();
+    let (cu, cv) = (fx, -b + rf);
+    let k = rho / (rho - rf);
+    Piece {
+        start: f.at(fx, -b),
+        cut: vec![
+            El::Arc { center: f.at(cu, cv), to: f.at(cu * k, cv * k), ccw },
+            El::Arc { center: f.c, to: end, ccw },
+        ],
+    }
+}
+
+/// The loops for a band of half-width `b` along `chain`, about `step`
+/// apart (the spacing is the chain's span split evenly, never more than
+/// `step`); `None` on a step or band that is no number.
+pub(super) fn layout(chain: &Chain, b: f64, step: f64, fillet: f64, climb: bool) -> Option<Layout> {
+    if !(b.is_finite() && b > 0.0 && step.is_finite() && step > 0.0 && fillet.is_finite()) {
+        return None;
+    }
+    let ccw = climb;
+    let end = END_DEG.to_radians();
+    let rho = b / end.cos();
+    let back = rho * end.sin();
+    let len = chain.len();
+    let span = len - back;
+    let n = if span > 1e-9 { ((span / step).ceil() as usize).max(1) } else { 0 };
+    if n > MAX_LOOPS {
+        return None;
+    }
+    let spacing = if n > 0 { span / n as f64 } else { step };
+    let c0 = chain.at(0.0);
+    let f0 = Frame::new(c0, chain.dir(0.0, spacing), ccw);
+    let mut pieces = Vec::with_capacity(n + 8);
+    for k in 1..=n {
+        let s = k as f64 * spacing;
+        // Each loop's circle sits `back` behind its wall points.
+        let f = Frame::new(chain.at(s), chain.dir(s, spacing), ccw);
+        pieces.push(front(&f, rho, b, fillet, ccw));
+    }
+    // The cap pencil: circles through the end's two wall points, tips
+    // stepped forward from the last front (or the bore's) to the cap.
+    let ce = chain.at(len);
+    let fe = Frame::new(ce, chain.dir(len, spacing), ccw);
+    let tip0 = if n > 0 { b * (std::f64::consts::FRAC_PI_4 - end * 0.5).tan() } else { b - len };
+    let gap = b - tip0;
+    if gap > 1e-9 {
+        let m = ((gap / spacing.min(step)).ceil() as usize).clamp(1, MAX_LOOPS);
+        for j in 1..=m {
+            let tip = tip0 + gap * j as f64 / m as f64;
+            let e = std::f64::consts::FRAC_PI_2 - 2.0 * (tip / b).atan();
+            let rj = b / e.cos();
+            let center = fe.at(-rj * e.sin(), 0.0);
+            pieces.push(Piece { start: fe.at(0.0, -b), cut: vec![El::Arc { center, to: fe.at(0.0, b), ccw }] });
+        }
+    }
+    Some(Layout { c0, b, entry: f0.at(0.0, -b), opposite: f0.at(0.0, b), ccw, pieces, loops: n, rho, spacing })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn straight() -> Vec<Point2> {
+        vec![Point2::new(0.0, 0.0), Point2::new(40.0, 0.0)]
+    }
+
+    #[test]
+    fn front_arcs_start_and_end_on_the_band_walls_and_step_evenly() {
+        let pts = straight();
+        let Some(ch) = Chain::new(&pts) else { panic!("chain") };
+        let Some(l) = layout(&ch, 4.0, 1.0, 0.0, true) else { panic!("layout") };
+        assert!(l.loops >= 39 && l.spacing <= 1.0 + 1e-12, "{} loops at {}", l.loops, l.spacing);
+        for p in &l.pieces {
+            assert!((p.start.y + 4.0).abs() < 1e-9, "start {:?}", p.start);
+            assert!((p.end().y - 4.0).abs() < 1e-9, "end {:?}", p.end());
+        }
+        // The last piece closes the cap: a half circle about the end.
+        let Some(last) = l.pieces.last() else { panic!("pieces") };
+        let El::Arc { center, .. } = last.cut[0];
+        assert!(dist(center, Point2::new(40.0, 0.0)) < 1e-9, "cap centre {center:?}");
+    }
+
+    #[test]
+    fn a_fillet_enters_the_arc_tangentially_off_the_wall() {
+        let pts = straight();
+        let Some(ch) = Chain::new(&pts) else { panic!("chain") };
+        let Some(l) = layout(&ch, 4.0, 1.0, 1.0, true) else { panic!("layout") };
+        let p = &l.pieces[3];
+        let El::Arc { center: fc, to: t2, .. } = p.cut[0];
+        // Tangent to the wall at the start, to the loop circle at t2.
+        assert!((dist(fc, p.start) - 1.0).abs() < 1e-9 && (fc.x - p.start.x).abs() < 1e-9);
+        let El::Arc { center: c, .. } = p.cut[1];
+        assert!((dist(c, t2) - l.rho).abs() < 1e-9 && (dist(c, fc) - (l.rho - 1.0)).abs() < 1e-9);
+        // The retrace walks back to the start.
+        let back = p.retrace();
+        let Some(El::Arc { to, .. }) = back.last().copied() else { panic!("retrace") };
+        assert_eq!(to, p.start);
+    }
+}
diff --git a/crates/motion/src/machining2d/trochoid_slot.rs b/crates/motion/src/machining2d/trochoid_slot.rs
new file mode 100644
index 00000000..103a648f
--- /dev/null
+++ b/crates/motion/src/machining2d/trochoid_slot.rs
@@ -0,0 +1,381 @@
+//! The trochoidal slot (issue #220): a channel of width `W` along a
+//! centre chain cleared by trochoid loops whose engagement is MEASURED,
+//! not assumed. Engagement angle `theta = theta_out - theta_in` on the
+//! current stock, the step adapted until `theta <= limit` everywhere
+//! (Otkur & Lazoglu 2007, IJMTM 47; Rauch, Duc & Hascoet 2009, IJMTM 49,
+//! "Improving trochoidal tool paths generation and implementation using
+//! process constraints modelling"; the maximum-engagement constraint of
+//! the B-spline trochoid study, Int J Adv Manuf Technol 2022, doi
+//! 10.1007/s00170-022-09527-z). The loop layout is `trochoid_loops`;
+//! the stock and the reading are `quality`'s dexel yardstick (the same
+//! measurement every Adaptive pin reads), run on the candidate level
+//! before it is kept. Loop band `B = (W - D) / 2` by default. Ours, no
+//! vendor material.
+//!
+//! Prime Directive: a channel no wider than the tool, a loop band wider
+//! than the room, a limit no step down the ladder can hold, a loop that
+//! would leave the channel, a crossing the verifier would hold, and a
+//! lifted return that would cut stock are each refused by name.
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath, lattice};
+use crate::geo2d::{Point2, Region};
+use crate::geometry::Point3;
+use crate::quality::{QualitySpec, measure, stock_for};
+
+use super::face::GenError;
+use super::levels::cut_levels;
+use super::trochoid_air::lifted_cut;
+use super::trochoid_loops::{Chain, El, Layout, layout};
+
+/// The forward step is tried at these shares of the user's, longest
+/// first, until the measured engagement holds.
+const LADDER: [f64; 11] = [1.0, 0.85, 0.7, 0.55, 0.45, 0.35, 0.28, 0.22, 0.15, 0.1, 0.07];
+
+/// A loop band narrower than this share of the tool diameter is no
+/// trochoid (the loops would be a slot with extra steps).
+const MIN_BAND_PER_D: f64 = 0.02;
+
+/// Loops a candidate step is first tried on.
+const TRIAL_LOOPS: usize = 12;
+
+/// How the tool gets from one loop's end back to the next loop's start.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum TrochoidReturn {
+    /// Lifted `height` off the floor, retracing the front arc it just
+    /// cut (its own swept air) at the return feed.
+    Microlift { height: f64 },
+    /// Up to the retract plane, across, down again.
+    Retract,
+}
+
+/// The default microlift height (mm): the HSM planner's own lift.
+pub const DEFAULT_MICROLIFT: f64 = 0.3;
+
+/// The default engagement limit (degrees).
+pub const DEFAULT_MAX_ENGAGEMENT: f64 = 90.0;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct TrochoidParams {
+    pub tool_diameter: f64,
+    /// Width of the finished channel.
+    pub width: f64,
+    /// Width of the band the loop centres sweep; `None` is all the room
+    /// the channel leaves (`W - D - 2 leave`).
+    pub loop_width: Option<f64>,
+    /// Forward step per loop (mm) - the most the planner may use.
+    pub step: f64,
+    /// Engagement limit (degrees of the cutter's periphery in contact).
+    pub max_engagement: f64,
+    pub ret: TrochoidReturn,
+    /// Fillet radius from the wall lead into each front arc (0: none).
+    pub smoothing: f64,
+    pub stock_to_leave: f64,
+    pub clearance_z: f64,
+    pub retract_z: Option<f64>,
+    pub top_z: f64,
+    pub bottom_z: f64,
+    pub stepdown: f64,
+    /// Feed on the cutting arc, on the return, and into the material.
+    pub feed: f64,
+    pub return_feed: f64,
+    pub plunge_feed: f64,
+    pub climb: bool,
+}
+
+impl TrochoidParams {
+    fn validate(&self) -> Result<(), GenError> {
+        let mut nums = vec![
+            self.tool_diameter,
+            self.width,
+            self.step,
+            self.max_engagement,
+            self.smoothing,
+            self.stock_to_leave,
+            self.clearance_z,
+            self.top_z,
+            self.bottom_z,
+            self.stepdown,
+            self.feed,
+            self.return_feed,
+            self.plunge_feed,
+        ];
+        nums.extend(self.retract_z);
+        nums.extend(self.loop_width);
+        if let TrochoidReturn::Microlift { height } = self.ret {
+            nums.push(height);
+        }
+        let bad = |m: &str| Err(GenError::Invalid(format!("trochoidal slot: {m}")));
+        if !nums.iter().all(|v| v.is_finite()) {
+            return bad("parameters must be finite");
+        }
+        if self.tool_diameter <= 0.0 || self.stepdown <= 0.0 || self.step <= 0.0 {
+            return bad("diameter, stepdown and forward step must be positive");
+        }
+        if self.feed <= 0.0 || self.return_feed <= 0.0 || self.plunge_feed <= 0.0 {
+            return bad("feeds must be positive");
+        }
+        if !(self.max_engagement > 0.0 && self.max_engagement <= 180.0) {
+            return bad("the engagement limit must lie in (0, 180] degrees");
+        }
+        if self.smoothing < 0.0 || self.stock_to_leave < 0.0 {
+            return bad("smoothing radius and stock to leave must not be negative");
+        }
+        if let TrochoidReturn::Microlift { height } = self.ret
+            && height <= 0.0
+        {
+            return bad("the microlift height must be positive");
+        }
+        if self.top_z < self.bottom_z {
+            return bad("cut top below cut bottom");
+        }
+        if self.clearance_z < self.top_z {
+            return bad("clearance plane below the first cut level");
+        }
+        if self.retract_z.is_some_and(|rz| rz < self.top_z) {
+            return bad("retract plane sits inside the material");
+        }
+        Ok(())
+    }
+
+    /// The loop band's half-width, or why the channel has none.
+    fn band(&self) -> Result<f64, GenError> {
+        let room = self.width - self.tool_diameter - 2.0 * self.stock_to_leave;
+        if room <= MIN_BAND_PER_D * self.tool_diameter {
+            return Err(GenError::Invalid(format!(
+                "trochoidal slot: the channel ({:.3} mm, {:.3} mm left on each wall) is too narrow for a {:.3} mm tool to loop in - cut it as a plain Slot",
+                self.width, self.stock_to_leave, self.tool_diameter
+            )));
+        }
+        let w = self.loop_width.unwrap_or(room);
+        if w > room + 1e-9 {
+            return Err(GenError::Invalid(format!(
+                "trochoidal slot: a loop width of {w:.3} mm leaves the channel - at most {room:.3} mm fits"
+            )));
+        }
+        if w <= MIN_BAND_PER_D * self.tool_diameter {
+            return Err(GenError::Invalid(format!("trochoidal slot: a loop width of {w:.3} mm is no loop")));
+        }
+        Ok(0.5 * w)
+    }
+}
+
+/// What the planner kept: the path, the loop layout's numbers and the
+/// engagement it measured.
+#[derive(Clone, Debug)]
+pub struct TrochoidPlan {
+    pub path: Toolpath,
+    /// The forward step used (mm) and the loop circle's radius.
+    pub step: f64,
+    pub loop_radius: f64,
+    /// Front-arc loops per level.
+    pub loops: usize,
+    /// The worst contact angle the planner measured on one level.
+    pub max_engagement: f64,
+}
+
+/// Cut the trochoidal slot along `chain` (see [`TrochoidParams`]).
+pub fn trochoidal_slot(chain: &[Point2], p: &TrochoidParams) -> Result<Toolpath, GenError> {
+    plan_trochoidal_slot(chain, p).map(|pl| pl.path)
+}
+
+/// [`trochoidal_slot`] with the planner's numbers.
+pub fn plan_trochoidal_slot(chain: &[Point2], p: &TrochoidParams) -> Result<TrochoidPlan, GenError> {
+    p.validate()?;
+    let Some(ch) = Chain::new(chain) else {
+        return Err(GenError::Invalid("trochoidal slot: the centre line needs two distinct, finite points".into()));
+    };
+    let b = p.band()?;
+    let r = 0.5 * p.tool_diameter;
+    let room = 0.5 * p.width - r - p.stock_to_leave;
+    let channel = Region::sweep(&[chain.to_vec()], 0.5 * p.width - p.stock_to_leave)?;
+    let spec = QualitySpec::new(p.tool_diameter);
+    let stock = || {
+        stock_for(&channel, 1.0, 0.0, p.tool_diameter, &spec)
+            .map_err(|e| GenError::Invalid(format!("trochoidal slot: measuring stock: {e}")))
+    };
+    // One level at Z 0 under a 1 mm block of the channel, measured.
+    let level = |lay: &Layout| {
+        let mut bld = PathBuilder::new(Point3::new(lay.entry.x, lay.entry.y, 1.0));
+        emit_level(&mut bld, lay, p, 0.0, 1.0, false);
+        bld.finish()
+    };
+    let mut best: Option<(f64, Point3, f64)> = None;
+    for f in LADDER {
+        let step = p.step * f;
+        let Some(lay) = layout(&ch, b, step, p.smoothing, p.climb) else { continue };
+        contained(&ch, &lay, room)?;
+        // The first loops first (the steady state comes within a few
+        // loops; a failing step need not be walked to the end), then
+        // the whole level.
+        let head = Layout { pieces: lay.pieces.iter().take(TRIAL_LOOPS).cloned().collect(), ..lay.clone() };
+        let full = lay.pieces.len() > TRIAL_LOOPS;
+        let mut q = measure(&level(&head), &mut stock()?, &spec);
+        let mut trial = None;
+        if q.max_deg <= p.max_engagement && full {
+            let t = level(&lay);
+            q = measure(&t, &mut stock()?, &spec);
+            trial = Some(t);
+        }
+        if best.is_none_or(|(d, _, _)| q.max_deg < d) {
+            best = Some((q.max_deg, q.max_at, step));
+        }
+        if q.max_deg > p.max_engagement {
+            continue;
+        }
+        // The lifted returns land on air, read inside the disc.
+        let trial = trial.unwrap_or_else(|| level(&lay));
+        if let Some(at) = lifted_cut(&trial, &mut stock()?, r) {
+            return Err(GenError::Invalid(format!(
+                "trochoidal slot: a lifted return at ({:.3}, {:.3}) would cut stock",
+                at.x, at.y
+            )));
+        }
+        return finish(&lay, p, step, q.max_deg, b, room);
+    }
+    let (deg, at, step) = best.unwrap_or((f64::INFINITY, Point3::new(0.0, 0.0, 0.0), p.step));
+    Err(GenError::Invalid(format!(
+        "trochoidal slot: no forward step holds the {:.1} deg engagement limit - the least, {:.1} deg at ({:.3}, {:.3}), was read at a {:.4} mm step",
+        p.max_engagement, deg, at.x, at.y, step
+    )))
+}
+
+/// Every loop stays inside the cutter-centre band of the channel (a
+/// chain turning tighter than the loops is refused, never gouged).
+fn contained(ch: &Chain, lay: &Layout, room: f64) -> Result<(), GenError> {
+    let mut from = lay.entry;
+    for pc in &lay.pieces {
+        let mut at = pc.start;
+        for el in &pc.cut {
+            let El::Arc { center, to, ccw } = *el;
+            for q in arc_samples(at, to, center, ccw) {
+                if ch.distance(q) > room + 1e-6 {
+                    return Err(GenError::Invalid(format!(
+                        "trochoidal slot: a loop at ({:.3}, {:.3}) would leave the channel - the centre line turns too tightly for loops this wide",
+                        q.x, q.y
+                    )));
+                }
+            }
+            at = to;
+        }
+        if ch.distance(pc.start) > room + 1e-6 || ch.distance(from) > room + 1e-6 {
+            return Err(GenError::Invalid("trochoidal slot: a wall lead would leave the channel".into()));
+        }
+        from = pc.start;
+    }
+    Ok(())
+}
+
+/// Points along the arc `a -> b` about `c` (a degree apart at most).
+fn arc_samples(a: Point2, b: Point2, c: Point2, ccw: bool) -> Vec<Point2> {
+    let (a0, a1) = ((a.y - c.y).atan2(a.x - c.x), (b.y - c.y).atan2(b.x - c.x));
+    let tau = std::f64::consts::TAU;
+    let sweep = if ccw { (a1 - a0).rem_euclid(tau) } else { -(a0 - a1).rem_euclid(tau) };
+    let rad = (a.x - c.x).hypot(a.y - c.y);
+    let n = ((sweep.abs().to_degrees()).ceil() as usize).clamp(1, 720);
+    (0..=n)
+        .map(|k| {
+            let t = a0 + sweep * k as f64 / n as f64;
+            Point2::new(c.x + rad * t.cos(), c.y + rad * t.sin())
+        })
+        .collect()
+}
+
+/// The kept plan over every level, said in the notes and held to the
+/// verifier's crossing law.
+fn finish(lay: &Layout, p: &TrochoidParams, step: f64, deg: f64, b: f64, room: f64) -> Result<TrochoidPlan, GenError> {
+    let zs = cut_levels(p.top_z, p.bottom_z, p.stepdown);
+    let hop = p.retract_z.unwrap_or(p.clearance_z);
+    let mut bld = PathBuilder::new(Point3::new(0.0, 0.0, p.clearance_z));
+    bld.push(MoveKind::Rapid, Point3::new(lay.entry.x, lay.entry.y, p.clearance_z), None);
+    let mut above = p.top_z;
+    for (i, &z) in zs.iter().enumerate() {
+        if i > 0 {
+            let at = bld.at();
+            bld.push(MoveKind::Rapid, Point3::new(at.x, at.y, hop), None);
+            bld.push(MoveKind::Rapid, Point3::new(lay.entry.x, lay.entry.y, hop), None);
+        }
+        let from = (above + crate::approach::DEFAULT_PLUNGE_HEIGHT).min(hop).max(above);
+        bld.push(MoveKind::Rapid, Point3::new(lay.entry.x, lay.entry.y, from), None);
+        emit_level(&mut bld, lay, p, z, from, true);
+        above = z;
+    }
+    let at = bld.at();
+    bld.push(MoveKind::Rapid, Point3::new(at.x, at.y, p.clearance_z), None);
+    bld.note(format!(
+        "trochoidal slot: {} loops of radius {:.3} mm a level at a {:.4} mm step, measured {:.1} deg engagement (limit {:.1} deg)",
+        lay.loops, lay.rho, lay.spacing, deg, p.max_engagement
+    ));
+    if step < p.step - 1e-12 {
+        bld.note(format!(
+            "trochoidal slot: the forward step was cut from {:.4} to {:.4} mm to hold the engagement limit",
+            p.step, step
+        ));
+    }
+    if room - b > 1e-6 {
+        bld.note(format!(
+            "trochoidal slot: the loops stop {:.3} mm short of each wall - finish the walls with a contour",
+            room - b
+        ));
+    }
+    let path = bld.finish();
+    if !path.all_finite() {
+        return Err(GenError::Invalid("trochoidal slot: path left the finite horizon".into()));
+    }
+    if let Some([i, j]) = crate::verify::crossed_pairs(&path, super::ARC_FIT_TOL).first().copied() {
+        let at = path.moves.get(i).map_or(Point3::new(0.0, 0.0, 0.0), |m| m.to);
+        return Err(GenError::Invalid(format!(
+            "trochoidal slot: the loops would cross themselves (moves {i} and {j}, near ({:.3}, {:.3}))",
+            at.x, at.y
+        )));
+    }
+    Ok(TrochoidPlan { path, step, loop_radius: lay.rho, loops: lay.loops, max_engagement: deg })
+}
+
+/// One level at `z`: the helix bore from `from`, the floor circle, then
+/// each loop's wall lead and cut, the returns between them. `levels`
+/// says whether a retract return may hop (the planner's single level
+/// lifts in place instead, which reads the same stock).
+fn emit_level(b: &mut PathBuilder, lay: &Layout, p: &TrochoidParams, z: f64, from: f64, levels: bool) {
+    let p3 = |q: Point2, zz: f64| Point3::new(lattice(q.x), lattice(q.y), lattice(zz));
+    let ccw = lay.ccw;
+    let turns = crate::links::helix_turns(from - z, lay.b, 0.0).unwrap_or(1.0).ceil().max(1.0);
+    let halves = (2.0 * turns) as usize;
+    for k in 1..=halves {
+        let zz = from - (from - z) * k as f64 / halves as f64;
+        let to = if k % 2 == 1 { lay.opposite } else { lay.entry };
+        b.push_arc(MoveKind::Feed, p3(to, zz), Some(p.plunge_feed), lay.c0, ccw);
+    }
+    b.push_arc(MoveKind::Feed, p3(lay.opposite, z), Some(p.feed), lay.c0, ccw);
+    b.push_arc(MoveKind::Feed, p3(lay.entry, z), Some(p.feed), lay.c0, ccw);
+    let n = lay.pieces.len();
+    for (i, pc) in lay.pieces.iter().enumerate() {
+        b.push(MoveKind::Feed, p3(pc.start, z), Some(p.feed));
+        for el in &pc.cut {
+            let El::Arc { center, to, ccw } = *el;
+            b.push_arc(MoveKind::Feed, p3(to, z), Some(p.feed), center, ccw);
+        }
+        if i + 1 == n {
+            break;
+        }
+        let e = pc.end();
+        match p.ret {
+            TrochoidReturn::Microlift { height } => {
+                let zl = z + height;
+                b.push(MoveKind::Feed, p3(e, zl), Some(p.return_feed));
+                for el in pc.retrace() {
+                    let El::Arc { center, to, ccw } = el;
+                    b.push_arc(MoveKind::Feed, p3(to, zl), Some(p.return_feed), center, ccw);
+                }
+                b.push(MoveKind::Feed, p3(pc.start, z), Some(p.plunge_feed));
+            }
+            TrochoidReturn::Retract => {
+                let hop = if levels { p.retract_z.unwrap_or(p.clearance_z) } else { z + 0.5 };
+                let near = (z + crate::approach::DEFAULT_PLUNGE_HEIGHT).min(hop);
+                b.push(MoveKind::Rapid, p3(e, hop), None);
+                b.push(MoveKind::Rapid, p3(pc.start, hop), None);
+                b.push(MoveKind::Rapid, p3(pc.start, near), None);
+                b.push(MoveKind::Feed, p3(pc.start, z), Some(p.plunge_feed));
+            }
+        }
+    }
+}
