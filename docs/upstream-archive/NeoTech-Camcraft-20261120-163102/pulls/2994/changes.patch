From 0e63efbb6b4d25f6e3c97ce770a35d58ffa64538 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Fri, 20 Nov 2026 16:33:09 +0100
Subject: [PATCH 2/3] fix(import): say what the checks do on a model kept for
 its edge gaps

The note of a model meshed coarser for its edge gaps said "checks allow
0.020 mm". That was false: at that chord the fidelity law has no verdict
tolerance left, and the post refuses the program. The geometry note now
gives the facts only, and the app adds what the fidelity law does at the
chord (loosened_consequence, read from excess, excess_floor and DEV_TOL).

The decision file says what the user can and cannot do until #2996.

Refs #2996
Refs #2976

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/geometry/import/step.rs   | 26 +++++++++++++++-
 crates/app/tests/import_step_edge_gap.rs | 18 ++++++++++-
 crates/geometry/src/step.rs              |  6 +++-
 crates/geometry/tests/step_edge_gap.rs   |  7 +++--
 crates/kernel/src/step_edge_gap.rs       |  7 +++--
 docs/decisions/2976-edge-gap-cap.md      | 39 +++++++++++++++++++-----
 6 files changed, 87 insertions(+), 16 deletions(-)

diff --git a/crates/app/src/geometry/import/step.rs b/crates/app/src/geometry/import/step.rs
index f2b2cc588..e8d7e8236 100644
--- a/crates/app/src/geometry/import/step.rs
+++ b/crates/app/src/geometry/import/step.rs
@@ -111,5 +111,29 @@ pub fn parse_open(data: &[u8], budget: usize) -> Result<(Mesh, f64, Vec<String>,
     if read.mesh.facets.is_empty() {
         return Err(ImportError::Empty);
     }
-    Ok((read.mesh, chord, read.notes, read.open))
+    let mut notes = read.notes;
+    // The geometry note of a model meshed coarser for its edge gaps says
+    // the facts; what the checks then do is the fidelity law's (#2976).
+    if read.loosened
+        && let Some(first) = notes.first_mut()
+    {
+        first.push(' ');
+        first.push_str(loosened_consequence(chord));
+    }
+    Ok((read.mesh, chord, notes, read.open))
+}
+
+/// What the fidelity law (#864) does with a model kept at `chord_mm`, in
+/// plain words, for the note of a model meshed coarser for its edge gaps
+/// (#2976): read from the same law the checks use
+/// (`model_fidelity::verdict_tol`), never a second rule.
+#[must_use]
+pub fn loosened_consequence(chord_mm: f64) -> &'static str {
+    let excess = crate::model_fidelity::excess(chord_mm);
+    if crate::verify::excess_floor(crate::stock_sim::DEV_TOL, excess).is_none() {
+        "A program cannot be posted while this model is in the document. \
+         Export the file again with a tighter tolerance to post one."
+    } else {
+        "Gouge checks against this model are stricter, and an operation that they cannot check is refused at the post."
+    }
 }
