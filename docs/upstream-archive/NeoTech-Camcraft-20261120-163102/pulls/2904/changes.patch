diff --git a/crates/kernel/src/solidcore_step_import.rs b/crates/kernel/src/solidcore_step_import.rs
new file mode 100644
index 000000000..824da62b4
--- /dev/null
+++ b/crates/kernel/src/solidcore_step_import.rs
@@ -0,0 +1,127 @@
+//! The STEP importers over [`read_step`] (#916, #917): a file whole, or
+//! refused by name. [`import_step`] hands out solids only;
+//! [`import_step_model`] also hands out surface models, to be meshed with
+//! open sides.
+//! Provenance: our own seam over solidcore-step's public API (see
+//! `solidcore_step`); no HSMWorks material consulted.
+
+use solidcore::kernel::CancelToken;
+
+use crate::KernelError;
+use crate::solidcore_impl::SolidcoreKernel;
+use crate::solidcore_step::{NAME, SHEET, StepRead, StepRefusal, StepSolid, read_step};
+
+/// A surface model of a STEP file (`SHELL_BASED_SURFACE_MODEL` of open
+/// shells), in millimetres: a record to mesh with open sides
+/// ([`crate::machining_mesh_open::sheet_mesh`]), never a solid.
+#[derive(Debug)]
+pub struct StepSheet {
+    /// The file's entity id of the item (`#id`).
+    pub item: u64,
+    /// The item's own name, else its product's (may be empty).
+    pub name: String,
+    /// The reader's B-rep record (mm).
+    pub record: solidcore_record::brep::Brep,
+    /// What the reader repaired or noted on it.
+    pub notes: Vec<String>,
+}
+
+/// A STEP file imported whole: every solid item of the file is a solid.
+#[derive(Debug)]
+pub struct StepImport {
+    /// The file's solids, in millimetres.
+    pub solids: Vec<StepSolid>,
+    /// See [`StepRead::length_units_mm`].
+    pub length_units_mm: Vec<f64>,
+    /// File-level diagnostics.
+    pub notes: Vec<String>,
+}
+
+/// A STEP model imported whole: its solids and its surface models.
+#[derive(Debug)]
+pub struct StepModel {
+    /// The file's solids, in millimetres.
+    pub solids: Vec<StepSolid>,
+    /// The file's surface models, in millimetres.
+    pub sheets: Vec<StepSheet>,
+    /// See [`StepRead::length_units_mm`].
+    pub length_units_mm: Vec<f64>,
+    /// File-level diagnostics.
+    pub notes: Vec<String>,
+}
+
+fn refused(op: &'static str, read: &StepRead, kept: usize) -> Option<KernelError> {
+    let first = read.refused.first()?;
+    Some(KernelError::InvalidResult {
+        kernel: NAME,
+        op,
+        detail: format!(
+            "{} of {} solid item(s) refused; first #{} at {}: {}",
+            read.refused.len(),
+            read.refused.len().saturating_add(kept),
+            first.item,
+            first.stage,
+            first.reason
+        ),
+    })
+}
+
+/// The importer: [`read_step`], and a model only when EVERY solid item of
+/// the file came through. A file that reads only in part is refused by
+/// name, never handed out with a body missing - a toolpath planned against
+/// a part with a solid left out cuts through it. A surface model is
+/// refused as no solid.
+pub fn import_step(
+    k: &mut SolidcoreKernel,
+    bytes: &[u8],
+    stop: &CancelToken,
+) -> Result<StepImport, KernelError> {
+    let mut read = read_step(k, bytes, stop)?;
+    for s in read.sheets.drain(..) {
+        read.refused.push(StepRefusal { item: s.item, stage: "read", reason: SHEET.into() });
+    }
+    read.refused.sort_by_key(|r| r.item);
+    if let Some(e) = refused("import_step", &read, read.solids.len()) {
+        return Err(e);
+    }
+    if read.solids.is_empty() {
+        return Err(KernelError::InvalidResult {
+            kernel: NAME,
+            op: "import_step",
+            detail: "the file holds no solid".into(),
+        });
+    }
+    Ok(StepImport {
+        solids: read.solids,
+        length_units_mm: read.length_units_mm,
+        notes: read.notes,
+    })
+}
+
+/// [`import_step`] that keeps the surface models too: the app's model
+/// importer. Every solid and sheet item came through, or the file is
+/// refused by name.
+pub fn import_step_model(
+    k: &mut SolidcoreKernel,
+    bytes: &[u8],
+    stop: &CancelToken,
+) -> Result<StepModel, KernelError> {
+    let read = read_step(k, bytes, stop)?;
+    let kept = read.solids.len().saturating_add(read.sheets.len());
+    if let Some(e) = refused("import_step", &read, kept) {
+        return Err(e);
+    }
+    if kept == 0 {
+        return Err(KernelError::InvalidResult {
+            kernel: NAME,
+            op: "import_step",
+            detail: "the file holds no solid".into(),
+        });
+    }
+    Ok(StepModel {
+        solids: read.solids,
+        sheets: read.sheets,
+        length_units_mm: read.length_units_mm,
+        notes: read.notes,
+    })
+}
diff --git a/crates/kernel/src/step_face_winding.rs b/crates/kernel/src/step_face_winding.rs
new file mode 100644
index 000000000..354769524
--- /dev/null
+++ b/crates/kernel/src/step_face_winding.rs
@@ -0,0 +1,190 @@
+//! The faces of a STEP closed shell whose loops run against their
+//! neighbours (#917, the note of #1576): solidcore's reader orients them
+//! with the shell and leaves no trace, so the seam finds them in the file
+//! and names them, as the earlier importer did ("shell #7: 1 face(s) wound
+//! against their neighbours were flipped: face #32 (3 of 6)").
+//! Provenance: ISO 10303-42 topology (CLOSED_SHELL, ORIENTED_FACE,
+//! FACE_BOUND orientation, ORIENTED_EDGE orientation: in a closed shell
+//! each edge is used twice, once in each direction); consistent orientation
+//! by relative parity across shared edges (Botsch et al., "Polygon Mesh
+//! Processing", 2010, ch. 1) as a union-find with parity (Tarjan, J. ACM
+//! 22(2), 1975). Read through the public p21 API of solidcore-step. Our
+//! own code; no HSMWorks material consulted.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use solidcore_step::p21::{Exchange, Param};
+
+/// The most faces one note names; the rest are counted.
+const NAMED: usize = 8;
+
+/// One note for each closed shell that has faces wound against their
+/// neighbours, naming the faces (the smaller side of each connected
+/// group). A shell whose edge uses do not resolve to one winding (an edge
+/// used other than twice, or an odd cycle) gets no note: the reader and
+/// the mesh judge it.
+pub(crate) fn notes(ex: &Exchange) -> Vec<String> {
+    let mut out = Vec::new();
+    for id in closed_shells(ex) {
+        if let Some(note) = shell_note(ex, id) {
+            out.push(note);
+        }
+    }
+    out
+}
+
+/// Every CLOSED_SHELL, and every outer shell of a MANIFOLD_SOLID_BREP
+/// whatever its keyword, by id.
+fn closed_shells(ex: &Exchange) -> BTreeSet<u64> {
+    let mut found = BTreeSet::new();
+    for (id, e) in &ex.entities {
+        if e.has("CLOSED_SHELL") && !e.has("ORIENTED_CLOSED_SHELL") {
+            found.insert(*id);
+        } else if let Some(outer) = e.record("MANIFOLD_SOLID_BREP").and_then(|p| p.get(1)).and_then(Param::as_ref_id) {
+            found.insert(outer);
+        }
+    }
+    found
+}
+
+fn flag(p: Option<&Param>) -> Option<bool> {
+    p.and_then(Param::as_bool)
+}
+
+/// The face entity of a shell member and whether the shell uses it as
+/// written.
+fn face_of(ex: &Exchange, id: u64) -> Option<(u64, bool)> {
+    let e = ex.get(id)?;
+    if let Some(p) = e.record("ORIENTED_FACE") {
+        let (inner, fwd) = face_of(ex, p.get(2)?.as_ref_id()?)?;
+        return Some((inner, fwd == flag(p.get(3))?));
+    }
+    Some((id, true))
+}
+
+/// The edge entity of a loop member and whether the loop runs along it.
+fn edge_of(ex: &Exchange, id: u64, depth: u32) -> Option<(u64, bool)> {
+    let e = ex.get(id)?;
+    match e.record("ORIENTED_EDGE") {
+        Some(p) if depth < 4 => {
+            let (inner, fwd) = edge_of(ex, p.get(3)?.as_ref_id()?, depth + 1)?;
+            Some((inner, fwd == flag(p.get(4))?))
+        }
+        Some(_) => None,
+        None => Some((id, true)),
+    }
+}
+
+/// Each edge use of one face, `(edge, runs along it)`, with the face's use
+/// in the shell applied. `None`: a member this check does not read.
+fn edge_uses(ex: &Exchange, face: u64, fwd: bool) -> Option<Vec<(u64, bool)>> {
+    let e = ex.get(face)?;
+    let p = ["ADVANCED_FACE", "FACE_SURFACE", "FACE"].iter().find_map(|n| e.record(n))?;
+    let mut uses = Vec::new();
+    for b in p.get(1)?.as_list()? {
+        let bound = ex.get(b.as_ref_id()?)?;
+        let bp = bound.record("FACE_OUTER_BOUND").or_else(|| bound.record("FACE_BOUND"))?;
+        let along = flag(bp.get(2))? == fwd;
+        let Some(lp) = ex.get(bp.get(1)?.as_ref_id()?)?.record("EDGE_LOOP") else {
+            continue; // a VERTEX_LOOP uses no edge
+        };
+        for oe in lp.get(1)?.as_list()? {
+            let (edge, dir) = edge_of(ex, oe.as_ref_id()?, 0)?;
+            uses.push((edge, dir == along));
+        }
+    }
+    Some(uses)
+}
+
+/// Union-find with parity: a face's winding relative to its root.
+struct Parity {
+    up: Vec<usize>,
+    odd: Vec<bool>,
+}
+
+impl Parity {
+    fn find(&mut self, f: usize) -> (usize, bool) {
+        let (mut r, mut odd) = (f, false);
+        while let Some(&u) = self.up.get(r) {
+            if u == r {
+                break;
+            }
+            odd ^= self.odd.get(r).copied().unwrap_or(false);
+            r = u;
+        }
+        (r, odd)
+    }
+
+    /// Joins `a` and `b` with `b` wound `differ` against `a`; `false` when
+    /// that contradicts what is known.
+    fn join(&mut self, a: usize, b: usize, differ: bool) -> bool {
+        let ((ra, pa), (rb, pb)) = (self.find(a), self.find(b));
+        if ra == rb {
+            return (pa ^ pb) == differ;
+        }
+        if let (Some(u), Some(o)) = (self.up.get_mut(rb), self.odd.get_mut(rb)) {
+            (*u, *o) = (ra, pa ^ pb ^ differ);
+        }
+        true
+    }
+}
+
+fn shell_note(ex: &Exchange, shell: u64) -> Option<String> {
+    let members: Vec<u64> = ex
+        .get(shell)?
+        .params()
+        .get(1)?
+        .as_list()?
+        .iter()
+        .map(Param::as_ref_id)
+        .collect::<Option<_>>()?;
+    let mut by_edge: BTreeMap<u64, Vec<(usize, bool)>> = BTreeMap::new();
+    let mut names = Vec::with_capacity(members.len());
+    for (i, m) in members.iter().enumerate() {
+        let (face, fwd) = face_of(ex, *m)?;
+        names.push(face);
+        for (edge, dir) in edge_uses(ex, face, fwd)? {
+            by_edge.entry(edge).or_default().push((i, dir));
+        }
+    }
+    let n = members.len();
+    let mut parity = Parity { up: (0..n).collect(), odd: vec![false; n] };
+    for uses in by_edge.values() {
+        let [(a, da), (b, db)] = uses.as_slice() else { return None };
+        // Two uses the same way: the two faces are wound against each other.
+        if a != b && !parity.join(*a, *b, da == db) {
+            return None;
+        }
+    }
+    // In each group the side with fewer faces is the one wound against the
+    // rest (a tie: the side without the group's lowest face).
+    let mut groups: BTreeMap<usize, (Vec<usize>, Vec<usize>)> = BTreeMap::new();
+    for f in 0..n {
+        let (root, odd) = parity.find(f);
+        let g = groups.entry(root).or_default();
+        if odd { g.1.push(f) } else { g.0.push(f) }
+    }
+    let mut flipped: Vec<usize> = Vec::new();
+    for (even, odd) in groups.into_values() {
+        let lowest_even = even.first().copied().unwrap_or(usize::MAX) < odd.first().copied().unwrap_or(usize::MAX);
+        let take_odd = odd.len() < even.len() || (odd.len() == even.len() && lowest_even);
+        flipped.extend(if take_odd { odd } else { even });
+    }
+    if flipped.is_empty() {
+        return None;
+    }
+    flipped.sort_unstable();
+    let mut said: Vec<String> = flipped
+        .iter()
+        .take(NAMED)
+        .filter_map(|&f| names.get(f).map(|id| format!("face #{id} ({} of {n})", f + 1)))
+        .collect();
+    if flipped.len() > NAMED {
+        said.push(format!("{} more", flipped.len() - NAMED));
+    }
+    Some(format!(
+        "shell #{shell}: {} face(s) wound against their neighbours were flipped: {}",
+        flipped.len(),
+        said.join(", ")
+    ))
+}
diff --git a/crates/kernel/tests/machining_mesh_open.rs b/crates/kernel/tests/machining_mesh_open.rs
new file mode 100644
index 000000000..c0ae31c66
--- /dev/null
+++ b/crates/kernel/tests/machining_mesh_open.rs
@@ -0,0 +1,106 @@
+//! The open machining meshes (#917): a sheet meshes with its own boundary
+//! open; a solid with a face the mesher leaves out meshes partially with
+//! that face named; a face wound against its neighbours in the file is
+//! named in the read notes.
+//! Provenance: our own test design; mutates `box.step` in memory.
+//!
+//! Gate map (#917): covers camcraft_kernel::machining_mesh_open,
+//! camcraft_kernel::machining_mesh, camcraft_kernel::solidcore_step_import,
+//! camcraft_kernel::step_face_winding.
+
+use std::path::PathBuf;
+
+use camcraft_kernel::machining_mesh::{MeshRefusal, machining_mesh};
+use camcraft_kernel::machining_mesh_open::{partial_mesh, sheet_mesh};
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::{import_step, import_step_model};
+use solidcore::kernel::CancelToken;
+use solidcore_record::brep::{Curve2, Loop};
+
+const TOL: f64 = 0.005;
+
+fn box_text() -> String {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models/box.step");
+    std::fs::read_to_string(path).expect("box.step")
+}
+
+/// `box.step` with its top face taken off, kept as a surface model.
+fn open_box() -> String {
+    let text = box_text();
+    let solid = "#16 = MANIFOLD_SOLID_BREP('', #17);";
+    let shell = "#17 = CLOSED_SHELL('', (#18, #25, #32, #39, #46, #53));";
+    assert!(text.contains(solid) && text.contains(shell), "fixture layout changed");
+    text.replace(solid, "#16 = SHELL_BASED_SURFACE_MODEL('', (#17));")
+        .replace(shell, "#17 = OPEN_SHELL('', (#18, #25, #32, #39, #46));")
+}
+
+#[test]
+fn a_sheet_meshes_with_its_boundary_open() {
+    let stop = CancelToken::new();
+    let model = import_step_model(&mut SolidcoreKernel::default(), open_box().as_bytes(), &stop)
+        .unwrap_or_else(|e| panic!("a surface model imports as a sheet: {e}"));
+    assert!(model.solids.is_empty(), "no solid in a surface model");
+    assert_eq!(model.sheets.len(), 1, "one sheet");
+    let m = sheet_mesh(&model.sheets[0].record, TOL, &stop).expect("the sheet meshes");
+    assert_eq!(m.report.faces, 5);
+    assert_eq!(m.report.volume, 0.0, "an open mesh encloses no volume");
+    // The missing face's four sides are open, one triangle side or more each.
+    assert!(m.report.open_sides >= 4, "{:?}", m.report.open_sides);
+    let mut has = [false; 5];
+    m.tri_face.iter().for_each(|f| has[*f as usize] = true);
+    assert!(has.iter().all(|h| *h), "every face of the sheet has triangles");
+}
+
+#[test]
+fn the_strict_import_still_refuses_a_sheet_by_name() {
+    let stop = CancelToken::new();
+    let err = import_step(&mut SolidcoreKernel::default(), open_box().as_bytes(), &stop)
+        .expect_err("import_step hands out solids only");
+    assert!(err.to_string().contains("a surface model of open shells"), "{err}");
+}
+
+#[test]
+fn a_face_left_out_meshes_partially_and_is_named() {
+    let stop = CancelToken::new();
+    let mut import = import_step(&mut SolidcoreKernel::default(), box_text().as_bytes(), &stop).expect("box.step");
+    let mut s = import.solids.remove(0);
+    // As machining_mesh_shortfalls: a pcurve of face 0 shifted along u past
+    // what the planner accepts, so face 0 gets no triangles.
+    let f0 = &mut s.record.faces[0];
+    let Loop::Edges { edges } = &mut f0.loops[0] else { panic!("expected edge loop") };
+    match &mut edges[0].pcurve {
+        Curve2::Spline { points, .. } => points.iter_mut().for_each(|p| p[0] += 0.5),
+        Curve2::RationalSpline { homogeneous, .. } => homogeneous.iter_mut().for_each(|p| p[0] += 0.5 * p[2]),
+    }
+    f0.domain[0][1] += 0.5;
+    let strict = machining_mesh(&s, TOL, &stop);
+    assert!(matches!(strict, Err(MeshRefusal::FaceLeftOut { face: 0, .. })), "the strict mesh refuses: {strict:?}");
+    let open = partial_mesh(&s, TOL, &stop).expect("the partial mesh");
+    assert_eq!(open.left_out.len(), 1, "{:?}", open.left_out);
+    assert_eq!(open.left_out[0].face, 0);
+    assert!(!open.left_out[0].reason.is_empty(), "the reason is said");
+    assert!(open.mesh.report.open_sides >= 4, "the hole is open: {}", open.mesh.report.open_sides);
+    assert!(open.mesh.tri_face.iter().all(|f| *f != 0), "no triangle on the left-out face");
+    assert_eq!(open.mesh.report.volume, 0.0);
+}
