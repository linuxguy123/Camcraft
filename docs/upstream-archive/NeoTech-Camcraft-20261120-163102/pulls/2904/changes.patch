-/// One sweep: which u intervals and which v intervals to halve.
-fn sweep<S>(surface: &S, udiv: &[f64], vdiv: &[f64], tol2: f64) -> (Vec<bool>, Vec<bool>)
-where
-    S: ParametricSurface<Point = Point3>,
