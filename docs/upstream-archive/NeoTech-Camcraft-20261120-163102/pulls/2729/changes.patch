index 6f8db1a2b..f55361962 100644
--- a/crates/app/tests/hole_feed_rating.rs
+++ b/crates/app/tests/hole_feed_rating.rs
@@ -296,3 +296,78 @@ fn a_running_feed_lowered_below_the_material_row_is_the_rating() {
