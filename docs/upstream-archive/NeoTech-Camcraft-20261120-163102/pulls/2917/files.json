    "raw_url": "https://github.com/NeoTech/Camcraft/raw/fddf5300f0e8b2eb481eeece6c7d850a366c3617/examples%2Fcatalog%2F2d%2Fedge-work%2Fmodel%2Fgen_edge_work_obj.py",
    "contents_url": "https://api.github.com/repos/NeoTech/Camcraft/contents/examples%2Fcatalog%2F2d%2Fedge-work%2Fmodel%2Fgen_edge_work_obj.py?ref=fddf5300f0e8b2eb481eeece6c7d850a366c3617",
    "patch": "@@ -0,0 +1,21 @@\n+#!/usr/bin/env python3\n+\"\"\"Provenance: original rectangular plate fixture, built from planar quads.\n+\n+Run from model/: python3 gen_edge_work_obj.py\n+The plate spans x +/-30, y +/-20, z 0..6 millimetres.\n+\"\"\"\n+from pathlib import Path\n+\n+vertices = [\n+    (-30, -20, 0), (30, -20, 0), (30, 20, 0), (-30, 20, 0),\n+    (-30, -20, 6), (30, -20, 6), (30, 20, 6), (-30, 20, 6),\n+]\n+faces = [(4, 3, 2, 1), (5, 6, 7, 8), (1, 2, 6, 5),\n+         (2, 3, 7, 6), (3, 4, 8, 7), (4, 1, 5, 8)]\n+edges = [(a, b) for face in faces for a, b in zip(face, face[1:] + face[:1])]\n+assert len(set(edges)) == len(edges), \"reused directed edge\"\n+assert all((b, a) in edges for a, b in edges), \"open or reversed face\"\n+text = \"# Original CamCraft edge-work plate; generated by gen_edge_work_obj.py\\n\"\n+text += \"\\n\".join(\"v %g %g %g\" % v for v in vertices) + \"\\n\"\n+text += \"\\n\".join(\"f \" + \" \".join(map(str, f)) for f in faces) + \"\\n\"\n+Path(__file__).with_name(\"edge-work.obj\").write_text(text)"
  }
