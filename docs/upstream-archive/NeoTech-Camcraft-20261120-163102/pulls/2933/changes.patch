From 54289aeb5166ddbfaff5fa3cc4ee41ccb35bbfb0 Mon Sep 17 00:00:00 2001
From: Quintin Smits <qd.smits@gmail.com>
Date: Fri, 20 Nov 2026 10:40:28 +0100
Subject: [PATCH] fix(mcp): accept a zero wire contour taper

Check explicit taper edits against the typed Wire Contour angle. The project writer omits the vertical default.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #2925
---
 crates/app/src/mcp/edit.rs             |  5 +++++
 crates/app/tests/mcp_wire_contour.rs   | 23 ++++++++++++++++++++++-
 docs/decisions/2925-wire-zero-taper.md |  7 +++++++
 3 files changed, 34 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/2925-wire-zero-taper.md

diff --git a/crates/app/src/mcp/edit.rs b/crates/app/src/mcp/edit.rs
index 998f826ad..bd6dae5fe 100644
--- a/crates/app/src/mcp/edit.rs
+++ b/crates/app/src/mcp/edit.rs
@@ -77,6 +77,11 @@ fn patched(base: &OpParams, patch: &Value) -> Result<OpParams, String> {
         return Err("the patched parameters could not be read back".into());
     };
     let mut back = back.get(&key).and_then(Value::as_object).cloned().unwrap_or_default();
+    // The project DTO omits a zero wire taper. Use the typed value when
+    // checking the patch so an explicit return to vertical is accepted.
+    if let OpParams::WireContour(wire) = &next {
+        back.insert("taper_deg".into(), json!(wire.taper_deg));
+    }
     // An opt-in flag (`blend_turns`) is written only when ON, so `false`
     // never comes back: it is kept when `true` would have come back.
     for (k, v) in patch {
diff --git a/crates/app/tests/mcp_wire_contour.rs b/crates/app/tests/mcp_wire_contour.rs
index d9c1c099e..b8e0516d0 100644
--- a/crates/app/tests/mcp_wire_contour.rs
+++ b/crates/app/tests/mcp_wire_contour.rs
@@ -96,8 +96,12 @@ fn prism(pts: &[(f64, f64)]) -> Mesh {
 /// A document with the synthetic wire EDM mounted from its file and a
 /// 40 x 20 slug imported.
 fn wire_job(tag: &str) -> Client {
+    wire_job_on(tag, WIRE)
+}
+
+fn wire_job_on(tag: &str, template: &str) -> Client {
     let dir = tmp_dir(tag);
-    let mut v: Value = serde_json::from_str(WIRE).expect("template json");
+    let mut v: Value = serde_json::from_str(template).expect("template json");
     v["edm"]["conditions"] = serde_json::from_str(TABLE).expect("conditions json");
     let mch = dir.join("wire.mch");
     std::fs::write(&mch, v.to_string()).expect("write mch");
@@ -210,3 +214,20 @@ fn a_taper_edit_the_machine_cannot_post_is_a_tool_error() {
     let op = job["operations"][0].to_string();
     assert!(!op.contains("\"taper_deg\":3"), "the refused taper never lands: {op}");
 }
+
+#[test]
+fn wire_contour_accepts_an_explicit_zero_taper_on_add_and_edit() {
+    let mut c = wire_job_on("zero-taper", include_str!("edm/wire-iso-fixture.mch"));
+    let mut args = wire_args("C110");
+    args["params"]["taper_deg"] = json!(0);
+    c.ok("add_operation", args);
+    let tapered = c.ok("edit_operation", json!({ "name": "W", "params": { "taper_deg": 3 } }));
+    assert_eq!(tapered["params"]["wire_contour"]["taper_deg"], json!(3.0));
+    let vertical = c.ok("edit_operation", json!({ "name": "W", "params": { "taper_deg": 0.0 } }));
+    assert!(vertical["params"]["wire_contour"].as_object().expect("wire parameters").get("taper_deg").is_none());
+
+    let why = c.refused("edit_operation", json!({ "name": "W", "params": { "taper_dge": 0 } }));
+    assert!(why.contains("unknown field taper_dge"), "{why}");
+    let why = c.refused("add_operation", json!({ "kind": "Face", "tool": "EDM-W025", "params": { "taper_deg": 0 } }));
+    assert!(why.contains("unknown field taper_deg"), "{why}");
+}
diff --git a/docs/decisions/2925-wire-zero-taper.md b/docs/decisions/2925-wire-zero-taper.md
new file mode 100644
index 000000000..d21b66bef
--- /dev/null
+++ b/docs/decisions/2925-wire-zero-taper.md
@@ -0,0 +1,7 @@
+## #2925 - Accept an explicit zero wire taper
+
+Use the Wire Contour's typed taper angle when checking an operation parameter patch.
+Zero selects a vertical cut and the project writer omits it from the saved fields.
+Changing project serialization would change existing files when saved. Accepting all
+zero fields would hide spelling errors. A later change to how a wire taper is stored
+needs an update to this check and its MCP regression test.
