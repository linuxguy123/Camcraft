     let motion = Motion::new(p.clearance_z, p.retract_z, p.feed, p.plunge_feed);
-    run_levels(&mut b, &passes, &[z], &motion, None, None, None);
+    let fit_tolerance = tolerance.min(ARC_FIT_TOL);
