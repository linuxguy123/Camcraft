+fn ring_basis(dir: [f64; 3]) -> ([f64; 3], [f64; 3]) {
+    let u = off_axis(dir);
+    let v = [
+        dir[1] * u[2] - dir[2] * u[1],
+        dir[2] * u[0] - dir[0] * u[2],
+        dir[0] * u[1] - dir[1] * u[0],
