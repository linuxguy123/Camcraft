From 42931ef862bf47e7f432bbadbc88fb49b5995c39 Mon Sep 17 00:00:00 2001
From: tbrasselle <tbrasselle@gmail.com>
Date: Sun, 22 Nov 2026 09:16:12 -0500
Subject: [PATCH 3/9] fix(multiaxis): a wrapping parallel band hands the base
 path on unchanged

#2774 pin: a band whose cylinders cover the path's whole radial reach
trims nothing, but the per-span solve still chopped runs where the retip
read dips past the axis, and the relink turned each chop into a retract,
index and plunge. band_trim now reads the clamped reach first and returns
the base path unchanged when every chord stands in the band.

Fixes #2774
---
 crates/motion/src/multiaxis/radial_band.rs | 49 ++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/crates/motion/src/multiaxis/radial_band.rs b/crates/motion/src/multiaxis/radial_band.rs
index 0d9dd43650..c7c0ee6e3c 100644
--- a/crates/motion/src/multiaxis/radial_band.rs
+++ b/crates/motion/src/multiaxis/radial_band.rs
@@ -149,6 +149,55 @@ pub(super) fn band_trim(
             }
         }
     };
+    // A band that covers the path's whole reach trims nothing: the trim
+    // hands the base path on unchanged. The per-span solve below would
+    // still chop runs where the retip read dips past the axis - the read
+    // is a flank convention, and a radius is a distance, so a point it
+    // reads negative stands at the axis - and the relink would turn each
+    // chop into a retract, index and plunge (#2774). The read clamped at
+    // 0 stays convex, so one ternary search reads the chord's low point.
+    let radius = |p: &Point3| rho(p.x, p.y, p.z).max(0.0);
+    let chord_covered = |a: &Point3, b: &Point3| -> bool {
+        let r = |t: f64| {
+            let p = chord(a, b, t);
+            radius(&p)
+        };
+        let (mut u, mut v) = (0.0f64, 1.0f64);
+        for _ in 0..64 {
+            let (m1, m2) = (u + (v - u) / 3.0, v - (v - u) / 3.0);
+            if r(m1) <= r(m2) {
+                v = m2;
+            } else {
+                u = m1;
+            }
+            if v - u < 1e-12 {
+                break;
+            }
+        }
+        // A convex read tops out at the chord's ends; its low point is
+        // the search's. The edges are inclusive, as in the span solve.
+        r((u + v) * 0.5) >= lo && r(0.0) <= hi && r(1.0) <= hi
+    };
+    let mut whole = true;
+    for (i, mv) in ms.iter().enumerate() {
+        if link(i) {
+            continue;
+        }
+        for (a, b) in mv.segments3(ARC_FIT_TOL) {
+            if !chord_covered(&a, &b) {
+                whole = false;
+                break;
+            }
+        }
+        if !whole {
+            break;
+        }
+    }
+    if whole {
+        let mut path = Toolpath::new(ms.clone());
+        path.notes = base.notes.clone();
+        return Ok(path);
+    }
     let mut out: Vec<Move> = Vec::with_capacity(ms.len());
     let (mut min_r, mut max_r) = (f64::MAX, f64::MIN);
     let mut open = false;

From 26e97178424fb99f48d800ba0a5def414b9ce0ca Mon Sep 17 00:00:00 2001
From: tbrasselle <tbrasselle@gmail.com>
Date: Fri, 27 Nov 2026 10:23:46 -0500
Subject: [PATCH 4/9] feat(multiaxis): the radial heights and the cut band land
 on the current ladder

The held #2774 feature (rotary heights read as radii about the fitted
axis, the band windowing, the wrapping band's hand-off), cherry-picked
from FlamingFireCoding:issue/2774-rotary-heights onto the current main,
and completed the way main has moved since:

- The project ladder steps v84 -> v85 (#2774): the rotary kinds may
  state `clearance_r`, `retract_r`, `top_r`, `bottom_r`; absent is the
  Z-plane law every v84 file ran, so a v84 file steps up unchanged. A
  v84 reader refuses a v85 file rather than drop the stated radii.
  The rung's comment sits in apply.rs's ladder and file.rs's doc, and
  the params DTO's own doc comments name v85.
- The stated-axis entries (#2772) take the radial heights: the
  generate calls `rotary_contour_stated`/`rotary_parallel_over_stated`/
  `rotary_offset_stated` with the resolved radii, and the plain entries
  keep the fit inside them.
- The heights-page rows and the radial rows coexist: the rotary page
  keeps main's editor shape and adds the band's four rows on the
  Heights tab; the heights memo keeps main's unresolved note beside
  the radial memo.
- The digest's pocket-door arms (RotaryOffset, MultiAxisRough,
  AdvancedSwarf) move to `params/multiaxis_pocket.rs` and the radial
  height writer to `params/digest.rs` - the 400-line law.
- New-op call sites of the rotated enums on main (first traverse,
  rotary traverse, the tests) state the four radii None, so every
  Z-plane op reads byte for byte as before.

Pinned by the motion rotary suite, the app rotary suites
(`rotary_verify` incl. the v85 round trip and the band refusals), the
project-version suites, the ui lib suite and clippy -D warnings.

