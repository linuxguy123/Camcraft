From 07082e09867ad14e3760554e7e099fdad5341874 Mon Sep 17 00:00:00 2001
From: Quintin Smits <qd.smits@gmail.com>
Date: Fri, 27 Nov 2026 18:18:08 +0100
Subject: [PATCH] feat(machines): Picomax 55 states travel limits and rigid
 tapping

The description names the machine parameters, not a parameter file. The
SF32 mount is not stated: the holder library has no SF32 holders yet.

Fixes #4396

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 assets/machines/fehlmann-picomax55.mch | 10 ++---
 crates/app/tests/machine_controller.rs | 62 +++++++++++++++++++++++++-
 2 files changed, 66 insertions(+), 6 deletions(-)

diff --git a/assets/machines/fehlmann-picomax55.mch b/assets/machines/fehlmann-picomax55.mch
index 6230e98d8..2aaaf2c37 100644
--- a/assets/machines/fehlmann-picomax55.mch
+++ b/assets/machines/fehlmann-picomax55.mch
@@ -3,19 +3,19 @@
     "model": "Fehlmann Picomax 55 (iTNC 530)",
     "vendor": "Fehlmann",
     "kind": "mill",
-    "description": "Three-axis CNC mode with a fixed W head. Set W before setting the preset. Sources: Fehlmann parameters 14108131.MP, operating manual 141-49-07-E and programming manual P07-35-06-E. Reference-frame travel limits are unstated. The preset table rows 0..5 come from the 2008 delivery CD (PRESET.PR); check the table at the control and raise controller.work_offset_max if the shop added rows."
+    "description": "Three-axis CNC mode with a fixed W head. Set W before setting the preset. Sources: the machine parameters, operating manual 141-49-07-E (section 7.1) and programming manual P07-35-06-E. Travel is the full stroke each way from the work origin: X 500, Y 255 and Z (quill) 147 mm. The spindle is the 9000 rpm option; the manual lists 7100 rpm for the standard spindle. The machine owner confirms rigid tapping. The manual names the SF32 tool holder; the SF32 mount is not stated because the holder library has no SF32 holders yet. The preset table rows 0..5 come from the 2008 delivery CD (PRESET.PR); check the table at the control and raise controller.work_offset_max if the shop added rows."
   },
   "kinematics": { "default": {
     "units": { "length": "mm", "angle": "degrees" },
     "parts": [
-      { "id": "x", "name": "X", "type": "linear", "parts": [
-        { "id": "y", "name": "Y", "type": "linear", "parts": [
+      { "id": "x", "name": "X", "type": "linear", "travel": { "min": -500.0, "max": 500.0 }, "parts": [
+        { "id": "y", "name": "Y", "type": "linear", "travel": { "min": -255.0, "max": 255.0 }, "parts": [
           { "id": "table", "name": "Table", "type": "table" }
         ] }
       ] },
-      { "id": "z", "name": "Z", "type": "linear", "parts": [
+      { "id": "z", "name": "Z", "type": "linear", "travel": { "min": -147.0, "max": 147.0 }, "parts": [
         { "id": "head", "name": "Quill", "type": "head",
-          "spindle": { "min_speed": 50, "max_speed": 9000 },
+          "spindle": { "min_speed": 50, "max_speed": 9000, "rigid_tapping": true },
           "tool_station": { "coolants": [{ "name": "Flood", "mCode": "M8" }] }
         }
       ] }
diff --git a/crates/app/tests/machine_controller.rs b/crates/app/tests/machine_controller.rs
index 621001062..05c9c9dda 100644
--- a/crates/app/tests/machine_controller.rs
+++ b/crates/app/tests/machine_controller.rs
@@ -53,7 +53,11 @@ fn mounting_saving_and_reopening_the_picomax_preserves_its_installation() {
     let loaded = machine::of(&world);
     let m = loaded.1.as_ref().unwrap();
     assert_eq!(m.axes.len(), 3);
-    assert!(m.axes.iter().all(|a| a.travel.is_none()));
+    let travel = |n: &str| m.axes.iter().find(|a| a.name == n).and_then(|a| a.travel);
+    assert_eq!(
+        (travel("X"), travel("Y"), travel("Z")),
+        (Some((-500.0, 500.0)), Some((-255.0, 255.0)), Some((-147.0, 147.0)))
+    );
     assert_eq!(
         (m.spindle_min, m.spindle_max, m.spindles),
         (Some(50.0), Some(9000.0), Some(1))
@@ -116,3 +120,59 @@ fn a_v74_machine_opens_with_unstated_installation_facts_and_a_future_file_preser
     );
     assert_eq!(machine::of(&world), loaded);
 }
+
+#[test]
+fn the_picomax_states_travel_and_rigid_tapping_and_no_parameter_file_name() {
+    let entry = MachineEntry::from_text(NAME, MachineSource::Builtin(NAME), PICOMAX);
+    assert!(entry.is_valid());
+    let file: Value = serde_json::from_str(PICOMAX).unwrap();
+    assert!(!PICOMAX.contains(".MP"), "the description names no parameter file");
+    let head = &file["kinematics"]["default"]["parts"][1]["parts"][0]["spindle"];
+    assert_eq!(head["rigid_tapping"], json!(true));
+    assert_eq!(head["max_speed"], json!(9000));
+    // A stated mount must be one the holder library knows; SF32 is not, so none is stated.
+    assert!(file["tooling"].get("spindle_mount").is_none());
+}
+
+#[test]
+fn a_face_wider_than_the_picomax_x_stroke_is_refused_naming_the_op_and_the_stroke() {
+    use camcraft_app::{
+        commands::{AddTool, CreateOperation, GenerateOperation, SetStock},
+        geometry::{IDENTITY_Q, Point3, cube},
+        machine::check_document,
+        operation::{Height, OpParams, SrcRef},
+        schema::Location,
+        stock::StockShape,
+        tools::catalog,
+    };
+    let m = camcraft_app::machine::parse_mch(PICOMAX).expect("the picomax file reads");
+    let world = new_world();
+    let mut history = History::default();
+    let loc = Location { pos: Point3::new(0.0, 0.0, 0.0), rot: IDENTITY_Q };
+    // 1100 mm wide: the path swings past X +/- 500 (the file's full stroke each way).
+    let stock = StockShape::Box { dx: 1100.0, dy: 60.0, dz: 20.0 };
+    history.execute(&world, SetStock::new(&world, stock, loc).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("tool");
+    history.execute(&world, AddTool::new(&world, "EM-0400-2FL", tool).expect("tool"));
+    history.execute(
+        &world,
+        camcraft_app::commands::ImportModel::from_mesh(
+            "part",
+            cube(Point3::new(-550.0, -30.0, 0.0), Point3::new(550.0, 30.0, 18.0)),
+        ),
+    );
+    let op = OpParams::Face {
+        holes: Default::default(), tilt: None, blend_turns: false, blend_radius: None,
+        stepover: 3.0, clearance_z: Height::fixed(25.0), cut_z: Height::fixed(18.0),
+        top_z: None, stepdown: None, feed: 1200.0, plunge_feed: 300.0, climb: true,
+        picks: Default::default(),
+    };
+    let cmd = CreateOperation::new(&world, "Face1", "EM-0400-2FL", SrcRef::Stock, op);
+    history.execute(&world, cmd.expect("create face"));
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate face"));
+    let c = check_document(&world, &m).expect("checks");
+    assert!(
+        c.problems.iter().any(|p| p.starts_with("Face1:") && p.contains("in X") && p.contains("the stroke is -500.000..500.000")),
+        "{:?}", c.problems
+    );
+}
