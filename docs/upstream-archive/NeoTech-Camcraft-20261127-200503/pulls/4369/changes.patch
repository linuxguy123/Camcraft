@@ -164,6 +186,35 @@ fn the_3d_finish_bands_tile_the_whole_span() {
     }
 }
 
+/// #3513: the generate time per level is not even over the span. The
+/// lower half of the sample (below the cylinder axis) holds almost all of
+/// it, and an equal sixth there took 559 s against 7 s for a sixth above.
+/// So each band that starts in the lower half spans no more than 3/48 of
+/// the model's Z span, and each band in the upper half starts at the top.
+#[test]
+fn the_3d_finish_bands_are_narrow_where_the_levels_are_slow() {
+    let m = camcraft_app::geometry::import::load_model(std::path::Path::new(&model("sample_ap214.step")))
+        .expect("the sample imports");
+    let b = m.bounds().expect("bounds");
+    let span = b.max.z - b.min.z;
+    let depth = |h: &Value| match h["reference"].as_str() {
+        Some("top_of_model") => -h["offset"].as_f64().expect("offset"),
+        Some("bottom_of_model") => span - h["offset"].as_f64().expect("offset"),
+        other => panic!("unexpected reference {other:?}: {h}"),
+    };
+    let eps = 1e-9 * span;
+    for k in 0..BANDS {
+        let h = band_heights(k);
+        let (top, bottom) = (depth(&h["top_z"]), depth(&h["bottom_z"]));
+        assert!(bottom - top > eps, "band {k} is not empty: {h}");
+        if top + eps >= span / 2.0 {
+            assert!(bottom - top <= span * 3.0 / 48.0 + eps, "band {k} in the slow lower half is too wide: {h}");
+        } else {
+            assert!(top <= eps, "band {k} in the fast upper half starts at the model's top: {h}");
+        }
+    }
+}
