+    assert_eq!(i.names_note, None);
+}
+
+/// SolidCraft 0.46.2's own format-10 file, which `hole_on_pocket_wall.rs`
+/// already reads. Keep it only if the maintainer allows real files as
+/// fixtures here (C13 question Q4); the block pins above do not need it.
+#[test]
+fn a_solidcraft_written_file_names_its_faces_in_record_order() {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("../../testdata/models/hole_on_pocket_wall.sc");
+    let bytes = std::fs::read(&path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    let i = ok(&bytes);
+    let names = match &i.names {
+        Some(n) => n,
+        None => panic!("no names: {:?}", i.names_note),
+    };
+    assert_eq!(names.len(), i.solid.record.faces.len());
+    assert_eq!(names.len(), 13);
+    let mesh = match machining_mesh(&i.solid, CHORD, &CancelToken::new()) {
+        Ok(m) => m,
+        Err(e) => panic!("the file does not mesh: {e}"),
+    };
+    let corners = |name: &str| -> Vec<[f64; 3]> {
+        let f = match names.iter().position(|n| n.name == name) {
+            Some(f) => f as u32,
+            None => panic!("no face named {name}"),
+        };
+        mesh.triangles
+            .iter()
+            .zip(&mesh.tri_face)
+            .filter(|(_, g)| **g == f)
+            .flat_map(|(t, _)| t.map(|v| mesh.positions[v as usize]))
+            .collect()
+    };
+    // The plate's two caps: each flat on one axis plane, the same axis, and
+    // at the two ends of the body on it.
+    let (top, start) = (corners("F2:top"), corners("F2:start"));
+    let flat = |c: &[[f64; 3]]| {
+        (0..3).find(|&a| !c.is_empty() && c.iter().all(|p| (p[a] - c[0][a]).abs() < ON_PLANE))
+    };
+    let a = match (flat(&top), flat(&start)) {
+        (Some(a), Some(b)) if a == b => a,
+        other => panic!("the caps are not flat on one axis: {other:?}"),
+    };
+    let lo = mesh
+        .positions
+        .iter()
+        .map(|p| p[a])
+        .fold(f64::INFINITY, f64::min);
+    let hi = mesh
+        .positions
+        .iter()
+        .map(|p| p[a])
+        .fold(f64::NEG_INFINITY, f64::max);
+    let (t, s) = (top[0][a], start[0][a]);
+    assert!(
+        (t.min(s) - lo).abs() < ON_PLANE && (t.max(s) - hi).abs() < ON_PLANE,
+        "caps at {t} and {s}, body from {lo} to {hi}"
+    );
+}
diff --git a/crates/kernel/tests/solidcraft_import/names_misfit.rs b/crates/kernel/tests/solidcraft_import/names_misfit.rs
new file mode 100644
index 0000000000..9d28bc4c8e
--- /dev/null
+++ b/crates/kernel/tests/solidcraft_import/names_misfit.rs
@@ -0,0 +1,133 @@
+//! Face names that do not fit the body (#3915): each misfit of a format-10
+//! names record gives no names and one note that says why, and the import
+//! goes on as before. Never a refusal. The fixture is the one of `names`:
+//! the sample marked as format 10, its final body a block of our own.
+//! Provenance: our own fixture, built by the test. The names layout is
+//! SolidCraft's published crates/doc/src/model_cache.rs (v0.50.0).
+
+use camcraft_kernel::solidcraft::{MAX_NAME_BYTES, NAMES_FORMAT};
+use serde_json::{Value, json};
+
+use super::import;
+use super::names::{FINAL, block, design_with, info, names_of, names_record};
+
+/// A manifest edit, named in the misfit cases.
+type Edit = Box<dyn Fn(&mut Value)>;
+
+/// The edit that puts `v` at place `at` of the list `list` of the final
+/// body's names record.
+fn put(list: &'static str, at: usize, v: Value) -> Edit {
+    Box::new(move |m: &mut Value| {
+        if let Some(slot) = m["model"]["names"][FINAL][list].get_mut(at) {
+            *slot = v.clone();
+        }
+    })
+}
+
+/// The edit that takes `key` out of the final body's entry of the model
+/// list `list` (`names` or `model_bodies`).
+fn take(list: &'static str, key: &'static str) -> Edit {
+    Box::new(move |m: &mut Value| {
+        if let Some(n) = m["model"][list][FINAL].as_object_mut() {
+            n.remove(key);
+        }
+    })
+}
+
+/// Any other edit, boxed.
+fn edit(f: impl Fn(&mut Value) + 'static) -> Edit {
+    Box::new(f)
+}
+
+/// The edit that drops the last item of the list `list` of the final
+/// body's names record.
+fn pop(list: &'static str) -> Edit {
+    Box::new(move |m: &mut Value| {
+        if let Some(l) = m["model"]["names"][FINAL][list].as_array_mut() {
+            l.pop();
+        }
+    })
+}
+
+#[test]
+fn names_that_do_not_fit_give_a_note_never_a_refusal() {
+    let record = block();
+    let names = names_of(&record);
+    let good = names_record(&names, |_| info(true, None));
+    let long = "n".repeat(MAX_NAME_BYTES + 1);
+    let index = |v: Value| edit(move |m| m["model"]["model_bodies"][FINAL]["names"] = v.clone());
+    let cases: Vec<(&str, Edit, &str)> = vec![
+        ("one name short", pop("faces"), "5 names and 6 info items"),
+        (
+            "one info item short",
+            pop("info"),
+            "6 names and 5 info items",
+        ),
+        ("a name not a text", put("faces", 2, json!(7)), "name 2"),
+        ("an empty name", put("faces", 2, json!("")), "name 2"),
+        ("a name too long", put("faces", 2, json!(long)), "name 2"),
+        (
+            "info of three items",
+            put("info", 3, json!([[], [], true])),
+            "info 3",
+        ),
+        (
+            "info of six items",
+            put("info", 3, json!([[], [], true, [], "a", "b"])),
+            "info 3",
+        ),
+        (
+            "verified not a flag",
+            put("info", 3, json!([[], [], "yes", []])),
+            "info 3",
+        ),
+        (
+            "aliases not a list",
+            put("info", 3, json!(["a", [], true, []])),
+            "info 3",
+        ),
+        (
+            "former not a text",
+            put("info", 3, json!([[], [], true, [], 5])),
+            "info 3",
+        ),
+        ("no face list", take("names", "faces"), "no face list"),
+        ("no info list", take("names", "info"), "no info list"),
+        (
+            "record not an object",
+            edit(|m| m["model"]["names"][FINAL] = json!([1, 2])),
+            "no face list",
+        ),
+        ("index past the list", index(json!(99)), "past the"),
+        ("index a text", index(json!("13")), "no names record"),
+        ("index negative", index(json!(-1)), "no names record"),
+        ("no index", take("model_bodies", "names"), "no names record"),
+        (
+            "no names list",
+            edit(|m| m["model"]["names"] = json!({})),
+            "no names list",
+        ),
+    ];
+    for (case, change, want) in cases {
+        let bytes = design_with(record.clone(), |m| {
+            m["format"] = json!(NAMES_FORMAT);
+            m["model"]["model_bodies"][FINAL]["names"] = json!(FINAL);
+            m["model"]["names"][FINAL] = good.clone();
+            change(m);
+        });
+        let i = match import(&bytes) {
+            Ok(i) => i,
+            Err(e) => panic!("{case}: names refused the import: {e}"),
+        };
+        assert!(i.names.is_none(), "{case}: names kept");
+        let note = i.names_note.unwrap_or_default();
+        assert!(
+            note.contains("face names were not read"),
+            "{case}: note '{note}'"
+        );
+        assert!(
+            note.contains(want),
+            "{case}: note '{note}' does not say '{want}'"
+        );
+    }
+}

From 60a0d969c1c2a72cba07a74d453ce4f913b68748 Mon Sep 17 00:00:00 2001
From: Marc Britten <11667518+marcbritten@users.noreply.github.com>
Date: Thu, 26 Nov 2026 14:07:52 -0500
Subject: [PATCH 2/5] feat(import): hold the .sc face names beside the model's
 facets

The Solidcraft import builds facet ranges from the machining mesh's
`tri_face` (one range for each run of a record face) and hands them out
with SolidCraft's names as `geometry::source_faces::SourceFaces`, beside
the mesh. A record that does not tile the facets is dropped with a note.

In the app, `Graded` and `ImportModel` carry it, and a new component
(`schema::SourceFaces`, through `source_faces::{of, set}`) holds it on
the model in memory only. It keeps the revision and facet count it was
landed with, so any other landing of facets makes it stale. UpdateModel
trades it on undo (`with_source_faces`); unstated, an update drops it,
so a repair or a file that is not `.sc` drops the names. DeleteEntity
puts it back on undo. The window, script/MCP import and fixture
re-import pass it. Nothing reads it yet and the project file is
unchanged: no behaviour change.

Built and tested on the earlier base 773736856 (the PR body lists the
runs). Rebased onto a721fd4dc without a local build; the maintainer's
runners test it.

Refs #3915

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
