@@ -12,8 +12,21 @@
 //! app::commands::model_link (SetModelSource), app::project (source_dto,
 //! v72), app::mcp::model_link_tools, app::mcp::job (get_job),
 //! app::geometry::import::sourced (#2689).
+//! #3915 (`model_link/`): a `.sc` model's picks follow SolidCraft face
