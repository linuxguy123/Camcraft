--- /dev/null
+++ b/crates/geometry/src/source_follow.rs
@@ -0,0 +1,303 @@
+//! Picks that follow their face by SolidCraft name (#3915): given two
+//! revisions of one model, each with its source face record
+//! ([`crate::source_faces`]), find the one new face or patch that carries
+//! the SolidCraft names of a face or patch whose geometry-hash id went
+//! missing.
+//!
+//! Provenance: our own design (C13, `docs/decisions/3915-sc-face-name-follow.md`).
+//! The names are SolidCraft's own face identity, read from its published
+//! model cache (SolidCraft `crates/doc/src/model_cache.rs`, v0.50.0); the
+//! match is plain set equality. No vendor material consulted.
+//!
+//! ## The law here
+//!
+//! `revision` pairs no missing face with an added one by guessing:
+//! re-picking is "made visible to the user, never assumed". A SolidCraft
+//! name is not a guess - it is SolidCraft's identity for the face - but a
+//! pick follows only when the names leave no doubt:
+//!
+//! - the old feature is the only one of its kind with its id and with its
+//!   names, and every one of its names is verified (it follows exact
+//!   history in SolidCraft);
+//! - exactly one new feature of the same kind has the same names (a
+//!   record face's `former` name counts as its name too, so the pieces of
+//!   a Split Face still answer to the face they came from);
+//! - that new feature was not in the old revision, its names are
+//!   verified, and a face keeps its plane kind.
+//!
+//! Anything else is a [`Lost`] verdict with its reason: the pick stays as
+//! it is and generation refuses it, exactly as before #3915. A wrong
+//! follow is the failure this module exists to prevent; a missed follow
+//! is only today's behaviour.
+
+use std::collections::{BTreeSet, HashMap};
+
+use crate::geometry::feature::{FaceKind, Features, patches};
+use crate::source_faces::SourceFaces;
+
+/// The kind of feature a pick names: a planar `Face` or a smooth `Patch`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PickKind {
+    Face,
+    Patch,
+}
+
+/// Why a pick did not follow its names.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Lost {
+    /// Two features of the old revision carry the pick's id.
+    TwinId,
+    /// A facet of the old feature has no record face.
+    Unnamed,
+    /// SolidCraft did not verify this name of the old feature.
+    Unverified(String),
+    /// Another feature of the same kind had the same names before.
+    TwinNames,
+    /// No new feature has these names.
+    NoMatch,
+    /// This many new features of the same kind have these names.
+    Many(usize),
+    /// The only new feature with these names is of another kind: a flat
+    /// face that is now curved, a curved face that is now flat, or a face
+    /// that has no plane now.
+    KindChanged,
+    /// The only new feature with these names was in the old revision too,
+    /// under other names.
+    NotNew,
+    /// SolidCraft did not verify the name of the only new feature.
+    NewUnverified,
+}
+
+impl Lost {
+    /// The reason in a few words, for the re-import report.
+    #[must_use]
+    pub fn reason(&self) -> String {
+        match self {
+            Lost::TwinId => "two faces had its id".into(),
+            Lost::Unnamed => "part of it had no SolidCraft name".into(),
+            Lost::Unverified(name) => format!("SolidCraft did not verify the name '{name}'"),
+            Lost::TwinNames => "another face had the same names".into(),
+            Lost::NoMatch => "no face has these names now".into(),
+            Lost::Many(n) => format!("{n} faces have these names now"),
+            Lost::KindChanged => "the face with these names changed kind".into(),
+            Lost::NotNew => "the face with these names was in the model before".into(),
+            Lost::NewUnverified => "SolidCraft did not verify the new face's name".into(),
+        }
+    }
+}
+
+/// What the follow says about one pick whose id went missing.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Verdict {
+    /// The old feature's SolidCraft names, sorted; empty when it had none
+    /// ([`Lost::Unnamed`], [`Lost::TwinId`]).
+    pub names: Vec<String>,
+    /// The new id, or why there is none.
+    pub to: Result<u64, Lost>,
+}
+
+/// One feature of a revision: its id, its plane kind (`None` for a
+/// patch) and its record faces, sorted; `None` when a facet has none.
+struct Entry {
+    id: u64,
+    kind: Option<FaceKind>,
+    record: Option<Vec<u32>>,
+}
+
+/// One revision of a model, indexed for the follow.
+pub struct Revision<'a> {
+    record: &'a SourceFaces,
+    faces: Vec<Entry>,
+    patches: Vec<Entry>,
+}
+
+impl<'a> Revision<'a> {
+    /// Index `features` with `record`. `None` when the record does not
+    /// tile the facets the features were built from: a record that
+    /// speaks for other facets is never read.
+    #[must_use]
+    pub fn new(features: &Features, record: &'a SourceFaces) -> Option<Self> {
+        if !record.tiles(features.facet_face.len()) {
+            return None;
+        }
+        let faces: Vec<Entry> = features
+            .faces
+            .iter()
+            .map(|f| Entry {
+                id: f.id,
+                kind: Some(f.kind),
+                record: record_faces(record, f.facets.iter().copied()),
+            })
+            .collect();
+        let mut by_id: HashMap<u64, usize> = HashMap::with_capacity(faces.len());
+        for (i, e) in faces.iter().enumerate() {
+            by_id.entry(e.id).or_insert(i);
+        }
+        let patches = patches(features)
+            .into_iter()
+            .map(|p| {
+                let mut union: BTreeSet<u32> = BTreeSet::new();
+                let mut whole = true;
+                for fid in &p.faces {
+                    match by_id
+                        .get(fid)
+                        .and_then(|&i| faces.get(i))
+                        .and_then(|e| e.record.as_ref())
+                    {
+                        Some(r) => union.extend(r.iter().copied()),
+                        None => whole = false,
+                    }
+                }
+                Entry {
+                    id: p.id,
+                    kind: None,
+                    record: (whole && !union.is_empty()).then(|| union.into_iter().collect()),
+                }
+            })
+            .collect();
+        Some(Revision {
+            record,
+            faces,
+            patches,
+        })
+    }
+
+    fn entries(&self, kind: PickKind) -> &[Entry] {
+        match kind {
+            PickKind::Face => &self.faces,
+            PickKind::Patch => &self.patches,
+        }
+    }
+
+    fn count(&self, kind: PickKind, id: u64) -> usize {
+        self.entries(kind).iter().filter(|e| e.id == id).count()
+    }
+
+    /// The names of `faces`, sorted and deduplicated; `None` when one
+    /// index passes the name list.
+    fn names_of(&self, faces: &[u32]) -> Option<Vec<&str>> {
+        let mut out: Vec<&str> = Vec::with_capacity(faces.len());
+        for &r in faces {
+            out.push(self.name(r)?.name.as_str());
+        }
+        out.sort_unstable();
+        out.dedup();
+        Some(out)
+    }
+
+    fn name(&self, r: u32) -> Option<&crate::source_faces::FaceName> {
+        usize::try_from(r)
+            .ok()
+            .and_then(|i| self.record.names.get(i))
+    }
+
+    fn verified(&self, faces: &[u32]) -> bool {
+        faces
+            .iter()
+            .all(|&r| self.name(r).is_some_and(|n| n.verified))
+    }
+
+    /// The names `key` and the record faces `faces` say the same face:
+    /// each name is a name or the former name of one of the faces, and
+    /// each face answers to one of the names.
+    fn matches(&self, key: &[&str], faces: &[u32]) -> bool {
+        let alias = |r: u32, n: &str| {
+            self.name(r)
+                .is_some_and(|f| f.name == n || f.former.as_deref() == Some(n))
+        };
+        !faces.is_empty()
+            && key.iter().all(|n| faces.iter().any(|&r| alias(r, n)))
+            && faces.iter().all(|&r| key.iter().any(|n| alias(r, n)))
+    }
+
+    fn candidates(&self, kind: PickKind, key: &[&str]) -> Vec<&Entry> {
+        self.entries(kind)
+            .iter()
+            .filter(|e| e.record.as_deref().is_some_and(|r| self.matches(key, r)))
+            .collect()
+    }
+}
+
+/// The record faces under `facets`, sorted; `None` when one facet has none.
+fn record_faces(record: &SourceFaces, facets: impl Iterator<Item = u32>) -> Option<Vec<u32>> {
+    let mut set: BTreeSet<u32> = BTreeSet::new();
+    for t in facets {
+        set.insert(record.face_of(usize::try_from(t).ok()?)?);
+    }
+    (!set.is_empty()).then(|| set.into_iter().collect())
+}
+
+/// Where a pick of `kind` with `id` goes from `old` to `new`. `None` when
+/// it has nothing to follow: the id is still in `new` (the face is
+/// carried, and the pick is untouched), or it was not in `old` either
+/// (the pick was lost before this import).
+#[must_use]
+pub fn follow(old: &Revision, new: &Revision, kind: PickKind, id: u64) -> Option<Verdict> {
+    if new.count(kind, id) > 0 {
+        return None;
+    }
+    let lost = |names: Vec<String>, why: Lost| {
+        Some(Verdict {
+            names,
+            to: Err(why),
+        })
+    };
+    let mut mine = old.entries(kind).iter().filter(|e| e.id == id);
+    let entry = mine.next()?;
+    if mine.next().is_some() {
+        return lost(Vec::new(), Lost::TwinId);
+    }
+    let Some(faces) = entry.record.as_deref() else {
+        return lost(Vec::new(), Lost::Unnamed);
+    };
+    let Some(key) = old.names_of(faces) else {
+        return lost(Vec::new(), Lost::Unnamed);
+    };
+    let names: Vec<String> = key.iter().map(|n| (*n).to_owned()).collect();
+    if let Some(r) = faces
+        .iter()
+        .find(|&&r| !old.name(r).is_some_and(|n| n.verified))
+    {
+        let name = old.name(*r).map(|n| n.name.clone()).unwrap_or_default();
+        return lost(names, Lost::Unverified(name));
+    }
+    let twins = old
+        .entries(kind)
+        .iter()
+        .filter(|e| e.id != id)
+        .filter(|e| {
+            e.record
+                .as_deref()
+                .and_then(|r| old.names_of(r))
+                .is_some_and(|n| n == key)
+        })
+        .count();
+    if twins > 0 {
+        return lost(names, Lost::TwinNames);
+    }
+    let found = new.candidates(kind, &key);
+    let to = match found.as_slice() {
+        [] => {
+            let other = match kind {
+                PickKind::Face => PickKind::Patch,
+                PickKind::Patch => PickKind::Face,
+            };
+            Err(if new.candidates(other, &key).is_empty() {
+                Lost::NoMatch
+            } else {
+                Lost::KindChanged
+            })
+        }
+        [one] if one.kind != entry.kind => Err(Lost::KindChanged),
+        [one] if old.count(kind, one.id) > 0 => Err(Lost::NotNew),
+        [one] if !one.record.as_deref().is_some_and(|r| new.verified(r)) => {
+            Err(Lost::NewUnverified)
+        }
+        [one] => Ok(one.id),
+        many => Err(Lost::Many(many.len())),
+    };
+    Some(Verdict { names, to })
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/geometry/src/source_follow/tests.rs b/crates/geometry/src/source_follow/tests.rs
new file mode 100644
index 0000000000..9a50184b81
--- /dev/null
+++ b/crates/geometry/src/source_follow/tests.rs
@@ -0,0 +1,321 @@
+//! Pins of the name follow (#3915) on meshes built here, with records of
+//! our own: a box at two widths, and a faceted cylinder whose wall is
+//! one patch. Each revision lists its names in its own order, so a
+//! follow that read the record index instead of the name fails.
+
+use super::*;
+use crate::geometry::feature::features_of_facets;
+use crate::geometry::{Point3, Triangle, cube, cylinder};
+use crate::source_faces::{FaceName, FacetRange, SourceFaces};
+
+/// The six faces of `cube()`, in its facet order (two facets each).
+const CUBE: [&str; 6] = ["bottom", "top", "front", "back", "right", "left"];
+const FRONT: usize = 2;
+const BACK: usize = 3;
+const LEFT: usize = 5;
+
+fn name(n: &str) -> FaceName {
+    FaceName {
+        name: n.into(),
+        verified: true,
+        former: None,
+    }
+}
+
+fn names(list: &[&str]) -> Vec<FaceName> {
+    list.iter().map(|n| name(n)).collect()
+}
+
+fn box_tris(width: f64) -> Vec<Triangle> {
+    cube(Point3::ZERO, Point3::new(width, 20.0, 10.0))
+        .facets
+        .to_vec()
+}
+
+/// A record that gives facet `t` the record face `of(t, facet)`.
+fn label(
+    tris: &[Triangle],
+    names: Vec<FaceName>,
+    of: impl Fn(usize, &Triangle) -> usize,
+) -> SourceFaces {
+    let mut ranges: Vec<FacetRange> = Vec::new();
+    for (t, tri) in tris.iter().enumerate() {
+        let face = u32::try_from(of(t, tri)).expect("a small index");
+        match ranges.last_mut() {
+            Some(r) if r.face == face && r.end == t => r.end = t + 1,
+            _ => ranges.push(FacetRange {
+                start: t,
+                end: t + 1,
+                face,
+            }),
+        }
+    }
+    SourceFaces { names, ranges }
+}
+
+/// Cube face `k` (in [`CUBE`] order) is record face `slot[k]`.
+fn box_record(tris: &[Triangle], names: Vec<FaceName>, slot: [usize; 6]) -> SourceFaces {
+    label(tris, names, |t, _| slot[t / 2])
+}
+
+/// The old box (60 wide) in [`CUBE`] order, and the new box (80 wide)
+/// with its names reversed - the same names, other record indexes.
+fn reversed() -> (Vec<FaceName>, [usize; 6]) {
+    let mut list = CUBE;
+    list.reverse();
+    (names(&list), [5, 4, 3, 2, 1, 0])
+}
+
+/// The id of the face that holds facet `t`.
+fn id_at(f: &Features, t: usize) -> u64 {
+    f.faces[f.facet_face[t] as usize].id
+}
+
+struct Pair {
+    fa: Features,
+    fb: Features,
+    ra: SourceFaces,
+    rb: SourceFaces,
+}
+
+impl Pair {
+    fn new(a: &[Triangle], ra: SourceFaces, b: &[Triangle], rb: SourceFaces) -> Self {
+        Pair {
+            fa: features_of_facets(a),
+            fb: features_of_facets(b),
+            ra,
+            rb,
+        }
+    }
+
+    fn boxes(old: (Vec<FaceName>, [usize; 6]), new: (Vec<FaceName>, [usize; 6])) -> Self {
+        let (a, b) = (box_tris(60.0), box_tris(80.0));
+        let (ra, rb) = (box_record(&a, old.0, old.1), box_record(&b, new.0, new.1));
+        Pair::new(&a, ra, &b, rb)
+    }
+
+    fn follow(&self, kind: PickKind, id: u64) -> Option<Verdict> {
+        let old = Revision::new(&self.fa, &self.ra).expect("the old record tiles");
+        let new = Revision::new(&self.fb, &self.rb).expect("the new record tiles");
+        follow(&old, &new, kind, id)
+    }
+
+    fn face(&self, k: usize) -> Option<Verdict> {
+        self.follow(PickKind::Face, id_at(&self.fa, 2 * k))
+    }
+}
+
+fn plain() -> (Vec<FaceName>, [usize; 6]) {
+    (names(&CUBE), [0, 1, 2, 3, 4, 5])
+}
+
+#[test]
+fn a_side_face_follows_its_name_into_the_wider_box() {
+    let p = Pair::boxes(plain(), reversed());
+    let v = p.face(FRONT).expect("the front face moved");
+    assert_eq!(v.to, Ok(id_at(&p.fb, 2 * FRONT)));
+    assert_eq!(v.names, vec!["front".to_owned()]);
+    assert_ne!(
+        id_at(&p.fa, 2 * FRONT),
+        id_at(&p.fb, 2 * FRONT),
+        "the width change moved the id"
+    );
+}
+
+#[test]
+fn a_carried_face_and_a_pick_lost_before_have_nothing_to_follow() {
+    let p = Pair::boxes(plain(), reversed());
+    assert_eq!(
+        id_at(&p.fa, 2 * LEFT),
+        id_at(&p.fb, 2 * LEFT),
+        "x = 0 keeps its corners"
+    );
+    assert_eq!(p.face(LEFT), None, "a carried face is untouched");
+    assert_eq!(
+        p.follow(PickKind::Face, 0xdead_beef),
+        None,
+        "an id in neither revision"
+    );
+}
+
+#[test]
+fn a_removed_name_does_not_follow() {
+    let mut new = reversed();
+    new.0[4] = name("lid"); // the new record's "top"
+    let p = Pair::boxes(plain(), new);
+    let v = p.face(1).expect("the top face moved");
+    assert_eq!(v.to, Err(Lost::NoMatch));
+    assert_eq!(v.names, vec!["top".to_owned()]);
+}
+
+#[test]
+fn an_unverified_name_does_not_follow() {
+    let mut old = plain();
+    old.0[FRONT].verified = false;
+    let p = Pair::boxes(old, reversed());
+    assert_eq!(
+        p.face(FRONT).expect("moved").to,
+        Err(Lost::Unverified("front".into()))
+    );
+}
+
+#[test]
+fn an_unverified_new_name_does_not_follow() {
+    let mut new = reversed();
+    new.0[5 - FRONT].verified = false;
+    let p = Pair::boxes(plain(), new);
+    assert_eq!(p.face(FRONT).expect("moved").to, Err(Lost::NewUnverified));
+}
+
+#[test]
+fn two_candidates_do_not_follow() {
+    // The new record names the front and the back face both "front".
+    let new = (
+        names(&["bottom", "top", "front", "right", "left"]),
+        [0, 1, 2, 2, 3, 4],
+    );
+    let p = Pair::boxes(plain(), new);
+    assert_eq!(p.face(FRONT).expect("moved").to, Err(Lost::Many(2)));
+}
+
+#[test]
+fn two_faces_with_one_name_before_do_not_follow() {
+    let old = (
+        names(&["bottom", "top", "side", "right", "left"]),
+        [0, 1, 2, 2, 3, 4],
+    );
+    let p = Pair::boxes(old, reversed());
+    assert_eq!(p.face(BACK).expect("moved").to, Err(Lost::TwinNames));
+}
+
+#[test]
+fn a_former_name_follows() {
+    let mut new = reversed();
+    new.0[5 - FRONT] = FaceName {
+        name: "front.1".into(),
+        verified: true,
+        former: Some("front".into()),
+    };
+    let p = Pair::boxes(plain(), new);
+    assert_eq!(
+        p.face(FRONT).expect("moved").to,
+        Ok(id_at(&p.fb, 2 * FRONT))
+    );
+}
+
+#[test]
+fn a_name_that_moved_to_a_carried_face_does_not_follow() {
+    // The new record gives "front" to the carried x = 0 face.
+    let new = (
+        names(&["bottom", "top", "front2", "back", "right", "front"]),
+        [0, 1, 2, 3, 4, 5],
+    );
+    let p = Pair::boxes(plain(), new);
+    assert_eq!(p.face(FRONT).expect("moved").to, Err(Lost::NotNew));
+}
+
+/// Cylinder facets: a cap by its normal, else the wall - or, with
+/// `halves`, the wall's +x half and its -x half under two names.
+fn cylinder_record(tris: &[Triangle], halves: bool) -> SourceFaces {
+    label(tris, names(&["top", "bottom", "wall", "wall.b"]), |_, t| {
+        let n = t.normal();
+        let x = (t.a.x + t.b.x + t.c.x) / 3.0;
+        if n.z > 0.9 {
+            0
+        } else if n.z < -0.9 {
+            1
+        } else if halves && x < 0.0 {
+            3
+        } else {
+            2
+        }
+    })
+}
+
+fn cyl(d: f64) -> Vec<Triangle> {
+    cylinder(d, 10.0, 16).facets.to_vec()
+}
+
+fn wall_patch(f: &Features) -> u64 {
+    let all = patches(f);
+    assert_eq!(all.len(), 1, "the faceted wall is one patch");
+    all[0].id
+}
+
+#[test]
+fn a_patch_follows_its_names_and_its_strips_do_not() {
+    for halves in [false, true] {
+        let (a, b) = (cyl(20.0), cyl(24.0));
+        let (ra, rb) = (cylinder_record(&a, halves), cylinder_record(&b, halves));
+        let p = Pair::new(&a, ra, &b, rb);
+        let (pa, pb) = (wall_patch(&p.fa), wall_patch(&p.fb));
+        assert_ne!(pa, pb, "the diameter change moved the patch id");
+        let v = p.follow(PickKind::Patch, pa).expect("the wall moved");
+        assert_eq!(v.to, Ok(pb), "halves {halves}");
+        // One strip of the wall shares its names with its neighbours.
+        let strip =
+            p.fa.faces
+                .iter()
+                .find(|f| f.normal[2].abs() < 0.5)
+                .expect("a strip")
+                .id;
+        assert_eq!(
+            p.follow(PickKind::Face, strip).expect("moved").to,
+            Err(Lost::TwinNames)
+        );
+    }
+}
+
+#[test]
+fn a_kind_change_does_not_follow() {
+    // The wall becomes the flat front face of a box.
+    let (a, b) = (cyl(20.0), box_tris(60.0));
+    let ra = cylinder_record(&a, false);
+    let rb = box_record(
+        &b,
+        names(&["bottom", "top", "wall", "back", "right", "left"]),
+        [0, 1, 2, 3, 4, 5],
+    );
+    let p = Pair::new(&a, ra, &b, rb);
+    let v = p
+        .follow(PickKind::Patch, wall_patch(&p.fa))
+        .expect("the wall is gone");
+    assert_eq!(v.to, Err(Lost::KindChanged));
+}
+
+#[test]
+fn a_record_that_does_not_tile_is_never_read() {
+    let a = box_tris(60.0);
+    let f = features_of_facets(&a);
+    let mut short = box_record(&a, names(&CUBE), [0, 1, 2, 3, 4, 5]);
+    if let Some(r) = short.ranges.last_mut() {
+        r.end -= 1;
+    }
+    assert!(
+        Revision::new(&f, &short).is_none(),
+        "a facet with no record face"
+    );
+    let mut past = box_record(&a, names(&CUBE), [0, 1, 2, 3, 4, 5]);
+    past.names.pop();
+    assert!(
+        Revision::new(&f, &past).is_none(),
+        "an index past the names"
+    );
+}
+
+#[test]
+fn every_reason_has_words() {
+    for why in [
+        Lost::TwinId,
+        Lost::Unnamed,
+        Lost::Unverified("a".into()),
+        Lost::TwinNames,
+        Lost::NoMatch,
+        Lost::Many(3),
+        Lost::KindChanged,
+        Lost::NotNew,
+        Lost::NewUnverified,
+    ] {
+        assert!(!why.reason().is_empty(), "{why:?}");
+    }
+}

From 4b8016b27750033735ec14538d522ce0d81c017d Mon Sep 17 00:00:00 2001
From: Marc Britten <11667518+marcbritten@users.noreply.github.com>
Date: Thu, 26 Nov 2026 14:15:49 -0500
Subject: [PATCH 07/14] feat(project): save a .sc model's source face record,
 with no version step

A model with a source face record saves it under the optional entity
key `source_faces`: the names in record order, and [start, end, face]
facet ranges. The DTO is in the new project/source_faces_dto.rs. The
hooks are one line each in entity.rs, wire.rs and apply.rs.

- PROJECT_VERSION does not change (D4, the `solids` #917 precedent).
  An old reader drops the key and reads the model as today. This is
  the maintainer's call (Q1).
- At save, only a record that tiles the facets is written.
- At load, a record that does not read, does not tile the facets,
  names a face past u32, or holds a name over 16 KiB is dropped with
  a logged note. The key never refuses a project.

Built and tested with the rest of this series on the earlier base
773736856 (the PR body lists the runs). Rebased onto a721fd4dc
without a local build; the maintainer's runners test it.

Refs #4213

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
