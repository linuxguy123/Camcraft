diff --git a/crates/app/src/commands/update_model_follow.rs b/crates/app/src/commands/update_model_follow.rs
new file mode 100644
index 0000000000..006ed1aa69
--- /dev/null
+++ b/crates/app/src/commands/update_model_follow.rs
@@ -0,0 +1,208 @@
+//! Picks follow their faces by SolidCraft name when a model imports again
+//! (#3915): the undoable half of the follow, inside `UpdateModel`.
+//!
+//! Provenance: our own design (C13, `docs/decisions/3915-sc-face-name-follow.md`);
+//! the match itself is `camcraft_geometry::source_follow`. No vendor
+//! material consulted.
+//!
+//! ## The law here
+//!
+//! - The follow runs only when the old model and the new mesh both hold a
+//!   source face record, and only from `UpdateModel::with_source_faces` -
+//!   the step that brings the new record - never from `UpdateModel::new`.
+//! - It rewrites only `Face` and `Patch` picks on this model, stored
+//!   inside operations (`stores`); a carried pick is untouched. Setup WCS
+//!   and alignment picks, fixture-locate picks and electrodes are not
+//!   followed (D7).
+//! - It is visible, never assumed (`revision`'s law): each operation with
+//!   a followed pick gets one `needs_review` line, which holds the post
+//!   until the user marks the operation reviewed; each pick that could
+//!   not follow is named in the re-import report and stays as it was, so
+//!   generation refuses it exactly as before.
+//! - Everything lands in the update's own undo step: the operations are
+//!   snapshotted whole at construction and written back by `invert`.
+
+use std::sync::Arc;
+
+use camcraft_geometry::source_faces::SourceFaces;
+use camcraft_geometry::source_follow::{self, PickKind, Revision};
+use flecs_ecs::prelude::World;
+
+use crate::geometry::Triangle;
+use crate::model;
+use crate::operation::FeatureSel;
+use crate::schema::{Operation, OperationMeta};
+
+mod report;
+mod stores;
+
+pub use report::{FollowReport, PickNote};
+use report::{noun, review_line};
+
+/// One operation the follow rewrites: as it stood, and after.
+struct OpChange {
+    key: String,
+    prev: Operation,
+    next: Operation,
+    prev_meta: OperationMeta,
+    next_meta: OperationMeta,
+}
+
+/// An operation that holds a `Face` or `Patch` pick on the model, as it
+/// stood at construction: key, label, definition and meta.
+type Held = (String, String, Operation, OperationMeta);
+
+/// The follow of one `UpdateModel`: the snapshot taken at construction,
+/// then what [`Follow::plan`] decided once the new record arrived.
+#[derive(Default)]
+pub(crate) struct Follow {
+    old: Option<Arc<SourceFaces>>,
+    held: Vec<Held>,
+    changes: Vec<OpChange>,
+    report: FollowReport,
+}
+
+impl Follow {
+    /// Snapshot the old record of model `name` and every operation that
+    /// holds a `Face` or `Patch` pick on it. A model with no record
+    /// snapshots nothing: no follow can come of it.
+    pub(crate) fn snapshot(world: &World, name: &str) -> Self {
+        let Some(entity) = model::find_by_name(world, name) else {
+            return Self::default();
+        };
+        let Some(old) = crate::source_faces::of(world, &entity) else {
+            return Self::default();
+        };
+        let held = crate::setup::operation_order(world)
+            .into_iter()
+            .filter_map(|(key, e)| {
+                let op = model::operation_of(world, &e)?;
+                stores::holds_face_pick(&op, name).then(|| {
+                    let label = model::operation_label(world, &key, &e);
+                    (key, label, op, model::operation_meta_of(world, &e))
+                })
+            })
+            .collect();
+        Follow {
+            old: Some(old),
+            held,
+            ..Self::default()
+        }
+    }
+
+    /// Decide the follow from the old facets to the new ones, with the
+    /// new record. Called again, it starts over. Nothing follows unless
+    /// both records tile the facets they ride.
+    pub(crate) fn plan(
+        &mut self,
+        name: &str,
+        old_facets: Option<&Arc<[Triangle]>>,
+        new_facets: &Arc<[Triangle]>,
+        new: Option<&Arc<SourceFaces>>,
+    ) {
+        self.changes.clear();
+        self.report = FollowReport::default();
+        let (Some(old), Some(new), Some(old_facets)) =
+            (self.old.as_deref(), new.map(Arc::as_ref), old_facets)
+        else {
+            return;
+        };
+        if self.held.is_empty() {
+            return;
+        }
+        if !old.tiles(old_facets.len()) || !new.tiles(new_facets.len()) {
+            tracing::warn!(
+                "model '{name}': a source face record does not tile its facets; no pick follows by name"
+            );
+            return;
+        }
+        let (fa, fb) = (
+            model::features_of_shared(old_facets),
+            model::features_of_shared(new_facets),
+        );
+        let (Some(ra), Some(rb)) = (Revision::new(&fa, old), Revision::new(&fb, new)) else {
+            return;
+        };
+        let mut lost: Vec<PickNote> = Vec::new();
+        let mut followed_all: Vec<PickNote> = Vec::new();
+        let mut changes: Vec<OpChange> = Vec::new();
+        for (key, label, prev, prev_meta) in &self.held {
+            let mut next = prev.clone();
+            let mut followed: Vec<PickNote> = Vec::new();
+            stores::for_each_pick_mut(&mut next, |g| {
+                if g.entity != name {
+                    return;
+                }
+                let (kind, id) = match g.feature {
+                    FeatureSel::Face(id) => (PickKind::Face, id),
+                    FeatureSel::Patch(id) => (PickKind::Patch, id),
+                    _ => return,
+                };
+                let Some(v) = source_follow::follow(&ra, &rb, kind, id) else {
+                    return;
+                };
+                let mut note = PickNote {
+                    operation: key.clone(),
+                    label: label.clone(),
+                    kind: noun(kind),
+                    names: v.names,
+                    why: None,
+                };
+                match v.to {
+                    Ok(to) => {
+                        g.feature = match kind {
+                            PickKind::Face => FeatureSel::Face(to),
+                            PickKind::Patch => FeatureSel::Patch(to),
+                        };
+                        followed.push(note);
+                    }
+                    Err(why) => {
+                        note.why = Some(why.reason());
+                        lost.push(note);
+                    }
+                }
+            });
+            if followed.is_empty() {
+                continue;
+            }
+            let mut next_meta = prev_meta.clone();
+            let line = review_line(name, &followed);
+            if !next_meta.needs_review.contains(&line) {
+                next_meta.needs_review.push(line);
+            }
+            changes.push(OpChange {
+                key: key.clone(),
+                prev: prev.clone(),
+                next,
+                prev_meta: prev_meta.clone(),
+                next_meta,
+            });
+            followed_all.extend(followed);
+        }
+        self.changes = changes;
+        self.report = FollowReport {
+            followed: followed_all,
+            lost,
+        };
+    }
+
+    /// `true`: land the followed picks and the review lines (apply);
+    /// `false`: put the operations back as they stood (invert).
+    pub(crate) fn write(&self, world: &World, forward: bool) {
+        for c in &self.changes {
+            if let Some(e) = model::find_by_name(world, &c.key) {
+                let (op, meta) = if forward {
+                    (&c.next, &c.next_meta)
+                } else {
+                    (&c.prev, &c.prev_meta)
+                };
+                e.entity_view(world).set(op.clone());
+                e.entity_view(world).set(meta.clone());
+            }
+        }
+    }
+
+    pub(crate) fn report(&self) -> &FollowReport {
+        &self.report
+    }
+}
diff --git a/crates/app/src/commands/update_model_follow/report.rs b/crates/app/src/commands/update_model_follow/report.rs
new file mode 100644
index 0000000000..5c34f447a7
--- /dev/null
+++ b/crates/app/src/commands/update_model_follow/report.rs
@@ -0,0 +1,248 @@
+//! The re-import report of the name follow (#3915): the picks that
+//! followed, each pick that could not, the window's phrase, the import
+//! answer's `picks` key, and the `needs_review` line of an operation.
+//! Provenance: our own wording and format (C13, D5, D6, D10).
+
+use serde_json::{Value, json};
+
+use camcraft_geometry::source_follow::PickKind;
+
+/// The longest `needs_review` line a project file holds
+/// (`project::validate` refuses a longer one as corrupt).
+const NOTE_MAX: usize = 240;
+/// The longest SolidCraft name the window and a review line show, bytes.
+const NAME_SHOWN: usize = 60;
+/// How many lost picks the window's phrase names; the import answer
+/// names them all.
+const STATUS_LOST: usize = 8;
+/// The longest phrase the window's status gets from the follow, bytes.
+const STATUS_MAX: usize = 900;
+
+/// One pick of the follow, for the re-import report.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PickNote {
+    /// The operation's stable key (MCP and scripts address it by this).
+    pub operation: String,
+    /// The operation's label, as people see it.
+    pub label: String,
+    /// `"face"` or `"curved face"`.
+    pub kind: &'static str,
+    /// The face's SolidCraft names before the import, sorted.
+    pub names: Vec<String>,
+    /// Why it did not follow; `None` for a followed pick.
+    pub why: Option<String>,
+}
+
+/// What the follow did, for the re-import report.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct FollowReport {
+    pub followed: Vec<PickNote>,
+    pub lost: Vec<PickNote>,
+}
+
+impl FollowReport {
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.followed.is_empty() && self.lost.is_empty()
+    }
+
+    /// The window's phrase: how many picks followed, and each pick that
+    /// could not (the first [`STATUS_LOST`], then a count). `None` when
+    /// the follow did nothing.
+    #[must_use]
+    pub fn describe(&self) -> Option<String> {
+        if self.is_empty() {
+            return None;
+        }
+        let mut parts: Vec<String> = Vec::new();
+        let n = self.followed.len();
+        if n > 0 {
+            parts.push(format!("{n} pick{} followed by SolidCraft name", plural(n)));
+        }
+        let n = self.lost.len();
+        if n > 0 {
+            let mut each: Vec<String> = self
+                .lost
+                .iter()
+                .take(STATUS_LOST)
+                .map(|p| {
+                    format!(
+                        "{} in '{}' ({})",
+                        shown(p),
+                        clean(&p.label),
+                        p.why.as_deref().unwrap_or("")
+                    )
+                })
+                .collect();
+            if n > STATUS_LOST {
+                each.push(format!("and {} more", n - STATUS_LOST));
+            }
+            parts.push(format!(
+                "{n} pick{} could not follow: {}",
+                plural(n),
+                each.join("; ")
+            ));
+        }
+        Some(clamp(&parts.join("; "), STATUS_MAX))
+    }
+
+    /// The `picks` key of the import answer: every followed and every
+    /// lost pick, by operation key, with its names. `None` when the
+    /// follow did nothing, so the answer is as before.
+    #[must_use]
+    pub fn to_json(&self) -> Option<Value> {
+        if self.is_empty() {
+            return None;
+        }
+        let row = |p: &PickNote| {
+            let mut r = json!({ "operation": p.operation, "pick": p.kind, "names": p.names });
+            if let Some(why) = &p.why {
+                r["why"] = json!(why);
+            }
+            r
+        };
+        Some(json!({
+            "followed": self.followed.iter().map(row).collect::<Vec<_>>(),
+            "lost": self.lost.iter().map(row).collect::<Vec<_>>(),
+        }))
+    }
+}
+
+pub(super) fn noun(kind: PickKind) -> &'static str {
+    match kind {
+        PickKind::Face => "face",
+        PickKind::Patch => "curved face",
+    }
+}
+
+fn plural(n: usize) -> &'static str {
+    if n == 1 { "" } else { "s" }
+}
+
+/// A pick in words: `face 'F2:side:b'`, `curved face 'a + b'`, or the
+/// bare kind when it had no names.
+fn shown(p: &PickNote) -> String {
+    if p.names.is_empty() {
+        return p.kind.to_owned();
+    }
+    let names: Vec<String> = p
+        .names
+        .iter()
+        .map(|n| clamp(&clean(n), NAME_SHOWN))
+        .collect();
+    format!("{} '{}'", p.kind, names.join(" + "))
+}
+
+/// The `needs_review` line of one operation: which picks of model `name`
+/// followed their names. At most [`NOTE_MAX`] bytes, no control
+/// characters - the project loader refuses anything else as corrupt.
+pub(super) fn review_line(name: &str, followed: &[PickNote]) -> String {
+    let mut each: Vec<String> = followed.iter().map(shown).collect();
+    each.dedup();
+    let model = clamp(&clean(name), NAME_SHOWN);
+    let line = match each.as_slice() {
+        [one] => format!(
+            "{one} of '{model}' followed by its SolidCraft name after the model was imported again"
+        ),
+        many => format!(
+            "{} picks of '{model}' followed by their SolidCraft names after the model was imported again: {}",
+            many.len(),
+            many.join(", ")
+        ),
+    };
+    clamp(&line, NOTE_MAX)
+}
+
+/// `s` with each control character (a newline, a tab) as a space.
+fn clean(s: &str) -> String {
+    s.chars()
+        .map(|c| if c.is_control() { ' ' } else { c })
+        .collect()
+}
+
+/// `s` cut to at most `max` bytes on a character boundary, with `...`
+/// when it was cut and there is room for it. Never panics.
+fn clamp(s: &str, max: usize) -> String {
+    if s.len() <= max {
+        return s.to_owned();
+    }
+    let dots = if max >= 3 { "..." } else { "" };
+    let room = max.saturating_sub(dots.len());
+    let mut end = 0;
+    for (i, c) in s.char_indices() {
+        let next = i.saturating_add(c.len_utf8());
+        if next > room {
+            break;
+        }
+        end = next;
+    }
+    format!("{}{dots}", s.get(..end).unwrap_or(""))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn note(names: &[&str]) -> PickNote {
+        PickNote {
+            operation: "op1".into(),
+            label: "Face1".into(),
+            kind: "face",
+            names: names.iter().map(|n| (*n).to_owned()).collect(),
+            why: None,
+        }
+    }
+
+    #[test]
+    fn a_review_line_is_short_and_clean_whatever_the_names() {
+        let long = "x".repeat(300);
+        let hostile = ["F2:side:b\nnext line", long.as_str(), "\u{e9}\u{e9}\u{e9}"];
+        for names in [
+            vec![hostile[0]],
+            vec![hostile[1]],
+            vec![hostile[0], hostile[1], hostile[2]],
+        ] {
+            let line = review_line("part\tname", &[note(&names), note(&["top"])]);
+            assert!(line.len() <= NOTE_MAX, "{} bytes: {line}", line.len());
+            assert!(!line.chars().any(char::is_control), "{line:?}");
+            assert!(!line.trim().is_empty());
+        }
+        let one = review_line("part", &[note(&["F2:side:b"])]);
+        assert_eq!(
+            one,
+            "face 'F2:side:b' of 'part' followed by its SolidCraft name after the model was imported again"
+        );
+    }
+
+    #[test]
+    fn clamp_cuts_on_a_character_boundary() {
+        let s = "\u{e9}".repeat(200); // two bytes each
+        let c = clamp(&s, 11);
+        assert!(c.len() <= 11 && c.ends_with("..."), "{c}");
+        assert_eq!(clamp("short", 11), "short");
+        assert_eq!(clamp("", 0), "");
+        assert_eq!(clamp("abcdef", 2), "ab");
+        assert!(clamp(&"x".repeat(300), NOTE_MAX).len() <= NOTE_MAX);
+    }
+
+    #[test]
+    fn the_report_names_each_lost_pick_and_counts_the_rest() {
+        let mut r = FollowReport::default();
+        assert_eq!(r.describe(), None);
+        assert_eq!(r.to_json(), None);
+        r.followed.push(note(&["front"]));
+        for i in 0..10 {
+            let name = format!("lost{i}");
+            let mut n = note(&[name.as_str()]);
+            n.why = Some("no face has these names now".into());
+            r.lost.push(n);
+        }
+        let said = r.describe().expect("a phrase");
+        assert!(said.starts_with("1 pick followed by SolidCraft name; 10 picks could not follow: face 'lost0' in 'Face1'"), "{said}");
+        assert!(said.contains("and 2 more"), "{said}");
+        let j = r.to_json().expect("json");
+        assert_eq!(j["lost"].as_array().map(Vec::len), Some(10));
+        assert_eq!(j["followed"][0]["names"][0], "front");
+        assert_eq!(j["lost"][9]["why"], "no face has these names now");
+    }
+}
