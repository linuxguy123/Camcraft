diff --git a/crates/app/tests/model_link/face_record.rs b/crates/app/tests/model_link/face_record.rs
new file mode 100644
index 0000000000..2c97d3aeb4
--- /dev/null
+++ b/crates/app/tests/model_link/face_record.rs
@@ -0,0 +1,200 @@
+//! #3915: a `.sc` model's source face record rides the project file under
+//! the key `source_faces`, with no version step: a reopened project still
+//! follows picks by name at the next re-import, a record that does not
+//! read or does not tile its facets is dropped and the file opens as it
+//! would without it, and a model with no record saves no key.
+//! Provenance: our own fixtures (`source_names`).
+
+use serde_json::{Value, json};
+
+use camcraft_app::commands::History;
+use camcraft_app::world::new_world;
+use camcraft_app::{model, project, source_faces};
+
+use super::area_support::{AreaControls, block_world, op, pocket, sel};
+use super::source_names::*;
+
+const OP: &str = "op1";
+
+fn saved(world: &flecs_ecs::prelude::World, tag: &str) -> String {
+    let path = std::env::temp_dir().join(format!(
+        "camcraft-3915-{tag}-{}.camproj",
+        std::process::id()
+    ));
+    project::save(world, &path).expect("save");
+    let text = std::fs::read_to_string(&path).expect("read back");
+    let _ = std::fs::remove_file(&path);
+    text
+}
+
+fn part_row(doc: &mut Value) -> &mut Value {
+    doc["entities"]
+        .as_array_mut()
+        .and_then(|rows| rows.iter_mut().find(|r| r["name"] == PART))
+        .expect("the part's row")
+}
+
+fn opened(text: &str) -> flecs_ecs::prelude::World {
+    let world = new_world();
+    project::open(&world, text).expect("the project opens");
+    world
+}
+
+fn has_record(world: &flecs_ecs::prelude::World) -> bool {
+    let e = model::find_by_name(world, PART).expect("the part");
+    source_faces::of(world, &e).is_some()
+}
+
+#[test]
+fn the_record_rides_the_project_file_and_picks_follow_after_it_opens() {
+    let world = block_world();
+    give_record(&world, &plain(&block(40.0)));
+    land_op(
+        &world,
+        OP,
+        op(
+            sel(PART, face(&world, FRONT)),
+            pocket(10.0, 5.0),
+            AreaControls::default(),
+        ),
+    );
+    let text = saved(&world, "rides");
+    let mut doc: Value = serde_json::from_str(&text).expect("json");
+    let row = part_row(&mut doc);
+    assert_eq!(
+        row["source_faces"]["names"].as_array().map(Vec::len),
+        Some(6)
+    );
+    assert_eq!(
+        row["source_faces"]["names"][FRONT],
+        json!({ "name": "front", "verified": true })
+    );
+    assert_eq!(row["source_faces"]["ranges"][0], json!([0, 2, 0]));
+
+    let fresh = opened(&text);
+    let e = model::find_by_name(&fresh, PART).expect("the part");
+    let rec = source_faces::of(&fresh, &e).expect("the record came back");
+    // The alignment holds after the load: every facet answers to the name
+    // of the cube face it lies on.
+    let facets = model::facets_of(&fresh, &e).expect("facets");
+    assert_eq!(facets.len(), 12);
+    for t in 0..facets.len() {
+        let r = rec.face_of(t).expect("every facet is named");
+        assert_eq!(rec.names[r as usize].name, CUBE[t / 2], "facet {t}");
+    }
+
+    let mut h = History::default();
+    let (report, _) = reimport(
+        &fresh,
+        &mut h,
+        block(50.0),
+        Some(reversed(&block(50.0), None)),
+    );
+    assert_eq!(report.followed.len(), 1, "{report:?}");
+    assert_eq!(src_of(&fresh, OP), vec![on_part(face(&fresh, FRONT))]);
+}
+
+#[test]
+fn a_record_that_does_not_read_or_tile_is_dropped_and_the_file_opens() {
+    let world = block_world();
+    give_record(&world, &plain(&block(40.0)));
+    let text = saved(&world, "dropped");
+    let doc: Value = serde_json::from_str(&text).expect("json");
+    let six = json!([{ "name": "a" }, { "name": "b" }, { "name": "c" }, { "name": "d" }, { "name": "e" }, { "name": "f" }]);
+    let cases = [
+        ("short", json!({ "names": six, "ranges": [[0, 11, 0]] })),
+        (
+            "past the names",
+            json!({ "names": [], "ranges": [[0, 12, 0]] }),
+        ),
+        (
+            "face past u32",
+            json!({ "names": six, "ranges": [[0, 12, 5_000_000_000_u64]] }),
+        ),
+        ("not a record", json!("names")),
+        ("unknown shape", json!({ "faces": [] })),
+        (
+            "long name",
+            json!({ "names": [{ "name": "x".repeat(20_000) }], "ranges": [[0, 12, 0]] }),
+        ),
+    ];
+    for (case, bad) in cases {
+        let mut d = doc.clone();
+        part_row(&mut d)["source_faces"] = bad;
+        let fresh = opened(&serde_json::to_string(&d).expect("json"));
+        assert!(!has_record(&fresh), "{case}: dropped, never trusted");
+        let e = model::find_by_name(&fresh, PART).expect("the part");
+        assert_eq!(
+            model::facets_of(&fresh, &e).map(|f| f.len()),
+            Some(12),
+            "{case}: the model loads as before"
+        );
+    }
+}
+
+#[test]
+fn a_model_without_a_record_saves_no_key() {
+    let world = block_world();
+    let mut doc: Value = serde_json::from_str(&saved(&world, "none")).expect("json");
+    assert!(
+        part_row(&mut doc).get("source_faces").is_none(),
+        "no record, no key: the file is as before"
+    );
+
+    // An update from a file with no names drops the record, and the key.
+    give_record(&world, &plain(&block(40.0)));
+    let mut h = History::default();
+    reimport(&world, &mut h, block(50.0), None);
+    let mut doc: Value = serde_json::from_str(&saved(&world, "dropped-by-update")).expect("json");
+    assert!(part_row(&mut doc).get("source_faces").is_none());
+}
+
+#[test]
+fn hostile_names_leave_a_review_line_the_project_file_accepts() {
+    let world = block_world();
+    let long = "r".repeat(300);
+    let list = [
+        "bottom",
+        "top",
+        "front\nside",
+        "back",
+        long.as_str(),
+        "left",
+    ];
+    give_record(
+        &world,
+        &record(&block(40.0), names(&list), [0, 1, 2, 3, 4, 5]),
+    );
+    let picks = vec![on_part(face(&world, FRONT)), on_part(face(&world, RIGHT))];
+    land_op(
+        &world,
+        OP,
+        op(
+            camcraft_app::operation::SrcRef::Selection(picks),
+            pocket(10.0, 5.0),
+            AreaControls::default(),
+        ),
+    );
+    let mut h = History::default();
+    let (report, _) = reimport(
+        &world,
+        &mut h,
+        block(50.0),
+        Some(record(&block(50.0), names(&list), [0, 1, 2, 3, 4, 5])),
+    );
+    assert_eq!(report.followed.len(), 2, "{report:?}");
+    let review = review_of(&world, OP);
+    assert_eq!(review.len(), 1);
+    assert!(
+        review[0].len() <= 240 && !review[0].chars().any(char::is_control),
+        "{:?}",
+        review[0]
+    );
+
+    let fresh = opened(&saved(&world, "hostile"));
+    assert_eq!(
+        review_of(&fresh, OP),
+        review,
+        "the line survives a save and a load"
+    );
+}
diff --git a/crates/app/tests/model_link/follow.rs b/crates/app/tests/model_link/follow.rs
new file mode 100644
index 0000000000..6542e2a5e1
--- /dev/null
+++ b/crates/app/tests/model_link/follow.rs
@@ -0,0 +1,354 @@
+//! #3915: face picks follow their faces by SolidCraft name when a `.sc`
+//! model imports again - in the update's own undo step, with a review
+//! line on each operation that a follow touched, and each pick that could
+//! not follow named in the re-import report and refused at generate as
+//! before. The matching rules themselves are pinned in
+//! `camcraft_geometry::source_follow`'s tests.
+//! Provenance: our own fixtures (`source_names`).
+
+use camcraft_app::commands::{CreateOperation, GenerateOperation, History, MarkOperationReviewed};
+use camcraft_app::operation::{BoundaryMode, ExtraBoundary};
+use camcraft_app::posting;
+
+use super::area_support::{
+    AreaControls, BoundaryShape, ChainSide, OpenBoundary, TOOL, block_world, op, pocket, run, sel,
+};
+use super::source_names::*;
+
+const OP: &str = "op1";
+
+/// The block with its record, and one pocket whose source picks cube
+/// face `k`.
+fn picked(k: usize) -> (flecs_ecs::prelude::World, History) {
+    let world = block_world();
+    give_record(&world, &plain(&block(40.0)));
+    land_op(
+        &world,
+        OP,
+        op(
+            sel(PART, face(&world, k)),
+            pocket(10.0, 5.0),
+            AreaControls::default(),
+        ),
+    );
+    (world, History::default())
+}
+
+#[test]
+fn a_face_pick_follows_its_name_in_the_same_undo_step() {
+    let (world, mut h) = picked(FRONT);
+    let before = face(&world, FRONT);
+    let (report, summary) = reimport(
+        &world,
+        &mut h,
+        block(50.0),
+        Some(reversed(&block(50.0), None)),
+    );
+    let after = face(&world, FRONT);
+    assert_ne!(before, after, "the width change moved the front face's id");
+    assert_eq!(src_of(&world, OP), vec![on_part(after.clone())]);
+    assert_eq!(
+        review_of(&world, OP),
+        vec!["face 'front' of 'part' followed by its SolidCraft name after the model was imported again".to_owned()]
+    );
+    assert_eq!(report.followed.len(), 1);
+    assert_eq!(report.followed[0].names, vec!["front".to_owned()]);
+    assert!(report.lost.is_empty(), "{:?}", report.lost);
+    assert!(
+        summary.contains("1 pick followed by SolidCraft name"),
+        "{summary}"
+    );
+
+    assert!(h.undo(&world));
+    assert_eq!(
+        src_of(&world, OP),
+        vec![on_part(before)],
+        "undo puts the old id back"
+    );
+    assert!(
+        review_of(&world, OP).is_empty(),
+        "and takes the review line away"
+    );
+    assert!(h.redo(&world));
+    assert_eq!(
+        src_of(&world, OP),
+        vec![on_part(after)],
+        "redo follows again"
+    );
+    assert_eq!(review_of(&world, OP).len(), 1);
+}
+
+#[test]
+fn every_pick_store_of_an_operation_follows() {
+    let world = block_world();
+    give_record(&world, &plain(&block(40.0)));
+    let area = AreaControls {
+        extra: vec![ExtraBoundary {
+            mode: BoundaryMode::Exclude,
+            shape: BoundaryShape::Picks(vec![on_part(face(&world, BACK))]),
+        }],
+        open: Some(OpenBoundary {
+            picks: vec![on_part(face(&world, RIGHT))],
+            side: ChainSide::Inside,
+        }),
+        do_not_touch: camcraft_app::operation::DoNotTouch {
+            clearance: 0.0,
+            picks: vec![on_part(face(&world, FRONT))],
+        },
+        ..AreaControls::default()
+    };
+    land_op(
+        &world,
+        OP,
+        op(sel(PART, face(&world, TOP)), pocket(10.0, 5.0), area),
+    );
+    let mut h = History::default();
+    let (report, _) = reimport(
+        &world,
+        &mut h,
+        block(50.0),
+        Some(reversed(&block(50.0), None)),
+    );
+    assert_eq!(report.followed.len(), 4, "{report:?}");
+    let o = op_of(&world, OP);
+    assert_eq!(src_of(&world, OP), vec![on_part(face(&world, TOP))]);
+    assert!(
+        matches!(&o.area.extra[0].shape, BoundaryShape::Picks(p) if *p == vec![on_part(face(&world, BACK))])
+    );
+    assert_eq!(
+        o.area.open.as_ref().map(|b| b.picks.clone()),
+        Some(vec![on_part(face(&world, RIGHT))])
+    );
+    assert_eq!(
+        o.area.do_not_touch.picks,
+        vec![on_part(face(&world, FRONT))]
+    );
+    let review = review_of(&world, OP);
+    assert_eq!(review.len(), 1, "one line for the operation: {review:?}");
+    assert!(
+        review[0].starts_with("4 picks of 'part' followed by their SolidCraft names"),
+        "{}",
+        review[0]
+    );
+    for n in ["top", "back", "right", "front"] {
+        assert!(
+            review[0].contains(&format!("face '{n}'")),
+            "{n}: {}",
+            review[0]
+        );
+    }
+}
+
+#[test]
+fn a_pick_that_cannot_follow_stays_and_is_named_in_the_report() {
+    let mut unverified = names(&CUBE);
+    unverified[TOP].verified = false;
+    let wide = block(50.0);
+    let cases = [
+        (
+            "renamed",
+            plain(&block(40.0)),
+            reversed(&wide, Some((TOP, name("lid")))),
+            "no face has these names now",
+        ),
+        (
+            "unverified",
+            record(&block(40.0), unverified, [0, 1, 2, 3, 4, 5]),
+            reversed(&wide, None),
+            "did not verify",
+        ),
+        (
+            "two candidates",
+            plain(&block(40.0)),
+            record(
+                &wide,
+                names(&["top", "front", "back", "right", "left"]),
+                [0, 0, 1, 2, 3, 4],
+            ),
+            "2 faces have these names now",
+        ),
+    ];
+    for (case, old, new, why) in cases {
+        let world = block_world();
+        give_record(&world, &old);
+        let before = face(&world, TOP);
+        land_op(
+            &world,
+            OP,
+            op(
+                sel(PART, before.clone()),
+                pocket(10.0, 5.0),
+                AreaControls::default(),
+            ),
+        );
+        let mut h = History::default();
+        let (report, summary) = reimport(&world, &mut h, block(50.0), Some(new));
+        assert_eq!(
+            src_of(&world, OP),
+            vec![on_part(before)],
+            "{case}: the pick stays as it was"
+        );
+        assert!(
+            review_of(&world, OP).is_empty(),
+            "{case}: nothing followed, nothing to review"
+        );
+        assert!(report.followed.is_empty(), "{case}");
+        assert_eq!(report.lost.len(), 1, "{case}");
+        assert_eq!(report.lost[0].names, vec!["top".to_owned()], "{case}");
+        assert_eq!(report.lost[0].operation, OP, "{case}");
+        assert!(
+            report.lost[0]
+                .why
+                .as_deref()
+                .is_some_and(|w| w.contains(why)),
+            "{case}: {:?}",
+            report.lost[0].why
+        );
+        assert!(
+            summary.contains("1 pick could not follow: face 'top' in 'op1'"),
+            "{case}: {summary}"
+        );
+        let j = report.to_json().expect("the import answer's picks");
+        assert_eq!(j["lost"][0]["operation"], OP, "{case}");
+        assert_eq!(j["lost"][0]["names"][0], "top", "{case}");
+    }
+}
+
+#[test]
+fn a_carried_pick_a_model_without_a_record_and_a_plain_update_behave_as_today() {
+    // A carried face: the x = -20 wall keeps its id, and its pick.
+    let (world, mut h) = picked(LEFT);
+    let left = face(&world, LEFT);
+    let (report, _) = reimport(
+        &world,
+        &mut h,
+        block(50.0),
+        Some(reversed(&block(50.0), None)),
+    );
+    assert_eq!(src_of(&world, OP), vec![on_part(left)]);
+    assert!(report.is_empty() && review_of(&world, OP).is_empty());
+
+    // No record on the old model: nothing follows, the phrase is today's.
+    let world = block_world();
+    let front = face(&world, FRONT);
+    land_op(
+        &world,
+        OP,
+        op(
+            sel(PART, front.clone()),
+            pocket(10.0, 5.0),
+            AreaControls::default(),
+        ),
+    );
+    let mut h = History::default();
+    let (report, summary) = reimport(
+        &world,
+        &mut h,
+        block(50.0),
+        Some(reversed(&block(50.0), None)),
+    );
+    assert_eq!(src_of(&world, OP), vec![on_part(front)]);
+    assert!(report.is_empty() && review_of(&world, OP).is_empty());
+    assert!(!summary.contains("pick"), "{summary}");
+
+    // An update with no record (an STL, a STEP): nothing follows.
+    let (world, mut h) = picked(FRONT);
+    let front = face(&world, FRONT);
+    let (report, _) = reimport(&world, &mut h, block(50.0), None);
+    assert_eq!(src_of(&world, OP), vec![on_part(front)]);
+    assert!(report.is_empty() && review_of(&world, OP).is_empty());
+}
+
+#[test]
+fn a_do_not_touch_pick_that_cannot_follow_is_refused_at_generate() {
+    let world = block_world();
+    give_record(&world, &plain(&block(40.0)));
+    let area = AreaControls {
+        do_not_touch: camcraft_app::operation::DoNotTouch {
+            clearance: 0.0,
+            picks: vec![on_part(face(&world, BACK))],
+        },
+        ..AreaControls::default()
+    };
+    let back = face(&world, BACK);
+    land_op(
+        &world,
+        OP,
+        op(sel(PART, face(&world, TOP)), pocket(10.0, 5.0), area),
+    );
+    let mut h = History::default();
+    let (report, _) = reimport(
+        &world,
+        &mut h,
+        block(50.0),
+        Some(reversed(&block(50.0), Some((BACK, name("back2"))))),
+    );
+    assert_eq!(
+        src_of(&world, OP),
+        vec![on_part(face(&world, TOP))],
+        "the source pick followed"
+    );
+    let o = op_of(&world, OP);
+    assert_eq!(
+        o.area.do_not_touch.picks,
+        vec![on_part(back)],
+        "the protected pick did not"
+    );
+    assert_eq!(report.lost.len(), 1);
+    assert_eq!(report.lost[0].names, vec!["back".to_owned()]);
+    let why = run(&world, &o).expect_err("a protected face that is gone refuses");
+    assert!(
+        why.contains("Do not touch") && why.contains("no longer in 'part'"),
+        "{why}"
+    );
+}
+
+#[test]
+fn a_followed_pick_holds_the_post_until_the_operation_is_marked_reviewed() {
+    let world = block_world();
+    give_record(&world, &plain(&block(40.0)));
+    let mut h = History::default();
+    let create = CreateOperation::new(
+        &world,
+        OP,
+        TOOL,
+        sel(PART, face(&world, TOP)),
+        pocket(10.0, 5.0),
+    )
+    .expect("a pocket on the top");
+    h.execute(&world, create);
+    let needs_review = |w: &flecs_ecs::prelude::World| {
+        posting::verification_gate(w)
+            .into_iter()
+            .any(|p| p.contains(OP) && p.contains("needs review before posting"))
+    };
+    assert!(!needs_review(&world), "a fresh operation needs no review");
+    let (report, _) = reimport(
+        &world,
+        &mut h,
+        block(50.0),
+        Some(reversed(&block(50.0), None)),
+    );
+    assert_eq!(report.followed.len(), 1);
+    h.execute(
+        &world,
+        GenerateOperation::new(&world, OP).expect("the followed pick generates"),
+    );
+    assert!(
+        needs_review(&world),
+        "the follow is made visible: the post waits for a person"
+    );
+    h.execute(
+        &world,
+        MarkOperationReviewed::new(&world, OP).expect("mark reviewed"),
+    );
+    assert!(
+        !needs_review(&world),
+        "marked reviewed, the review clause is gone"
+    );
+    assert!(h.undo(&world));
+    assert!(
+        needs_review(&world),
+        "undo of the mark brings the line back"
+    );
+}
