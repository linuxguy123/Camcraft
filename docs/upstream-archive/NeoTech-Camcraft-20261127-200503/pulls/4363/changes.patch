diff --git a/assets/posts/doosan-dnm.cps b/assets/posts/doosan-dnm.cps
index cebf401e69..b5ae7c6b13 100644
--- a/assets/posts/doosan-dnm.cps
+++ b/assets/posts/doosan-dnm.cps
@@ -948,11 +948,12 @@ function endPreamble() {
   if (!sectionOpen) return;
   restorePlane();
   ensureProbeOff();
+  // #4347: G80 closes the cycle group before any G5.1 word (B-64604EN-2/01, 3.3.2).
+  if (inCycle) block(["G80"]);
+  inCycle = false;
   disableSmoothing();
   ensureRotaryClamped();
   sectionOpen = false;
-  if (inCycle) block(["G80"]);
-  inCycle = false;
   if (wcsRotActive) { block(["G69"]); wcsRotActive = false; }
   wcsYaw = 0;
   wcsRotMode = "";
@@ -1117,7 +1118,9 @@ function heldAngles(p, tw) {
 }
 function onLinear() {
   startPreamble();
-  enableSmoothing();
+  // #4347: an open cycle group's chain is the cycle's (chainCut below),
+  // and no G5.1 word is legal while G81-G89 is modal.
+  if (!inCycle) enableSmoothing();
   var aChanged = has(properties.A) && (!has(lastA) || properties.A !== lastA);
   var tw = tilt(properties);
   if (tw === null || chainCut()) return;
@@ -1140,7 +1143,7 @@ function onCircular() {
   // #3442: an arc whose written ends coincide is no arc block (arcFate, PRELUDE).
   var fate = arcFate(arcWord, arcIncOf(fu));  // #3474: I J K are increments from the start
   if (fate !== "arc") { if (fate === "linear") onLinear(); return; }
-  enableSmoothing();
+  if (!inCycle) enableSmoothing();  // #4347: as onLinear
   var aChanged = has(properties.A) && (!has(lastA) || properties.A !== lastA);
   var tw = tilt(properties);
   if (tw === null || chainCut()) return;
diff --git a/crates/post/tests/doosan_dnm_post.rs b/crates/post/tests/doosan_dnm_post.rs
index c8c2f0daef..41bed87952 100644
--- a/crates/post/tests/doosan_dnm_post.rs
+++ b/crates/post/tests/doosan_dnm_post.rs
@@ -197,6 +197,47 @@ SECTION END
     assert!(out_r8.program.contains("G5.1 Q1 R8"), "G5.1 Q1 R8 must be emitted:\n{}", out_r8.program);
 }
 
+// #4347: the hole chain (plunge, retract to R) inside an open canned-cycle
+// group writes no G5.1 word, and a section that ends inside the group
+// writes G80 before any G5.1 Q0 (B-64604EN-2/01, 3.3.2).
+#[test]
+fn doosan_dnm_smoothing_stays_out_of_open_cycle_group() {
+    let cps = dnm_post();
+    let mch = dnm_machine();
+    let stream = r#"; HSMW-CL v1 scale=0.001mm moves=7
+PARAM WorkOffset G54
+PARAM ClearancePlane 50
+PARAM RetractPlane 10
+TOOL 1 "6mm Drill"
+PARAM SpindleSpeed 3000
+SECTION Drill
+Rapid 20000 10000 2000
+CYCLE DRILL X20000 Y10000 Z-5000 R2000 F200000
+Plunge 20000 10000 -5000 F200000
+Rapid 20000 10000 2000
+CYCLE DRILL X20000 Y10000 Z-5000 R2000 F200000
+Plunge 20000 10000 -5000 F200000
+Rapid 20000 10000 2000
+SECTION END
+"#;
+    let options = serde_json::json!({ "smoothing": true });
+    let out = engine::run_with(&cps, &mch, stream, &options).expect("posts smoothed drilling");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let lines: Vec<&str> = out.program.lines().collect();
+    let open = lines.iter().position(|l| l.contains("G81")).expect("cycle present");
+    let close = open + lines[open..].iter().position(|l| l.contains("G80")).expect("G80 closes the cycle group");
+    assert!(
+        !lines[open..close].iter().any(|l| l.contains("G5.1")),
+        "no G5.1 word inside the open cycle group:\n{}",
+        out.program
+    );
+    assert!(
+        !lines[open..].iter().any(|l| l.contains("G5.1 Q1")),
+        "no G5.1 Q1 after the cycle in a section with no cut outside it:\n{}",
+        out.program
+    );
+}
