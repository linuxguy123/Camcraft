+/// The feed field of each drawn table row, top down.
+fn feed_fields(h: &H) -> Vec<egui::Rect> {
+    let mut v: Vec<egui::Rect> = library_window(h).query_all_by_label("Feed").map(|n| n.rect()).collect();
+    v.sort_by(|a, b| a.top().total_cmp(&b.top()));
+    v
+}
