diff --git a/crates/ui/src/egui_app/tool_library_dialog/holder_drawing.rs b/crates/ui/src/egui_app/tool_library_dialog/holder_drawing.rs
new file mode 100644
index 000000000..63665f6f2
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/holder_drawing.rs
@@ -0,0 +1,166 @@
+//! #3897 (U6), #4338 (U12 of #3663): the holder drawing of the tool
+//! library window, shared by the read-only holder view and the holder
+//! form: the outline to scale, nose down, with the spindle nose as a
+//! dashed box above the gauge line and the shank range the holder clamps
+//! as a dashed ghost below the nose. The dimension lines give the gauge
+//! length, the largest and the nose diameter; the drawing keeps room for
+//! their labels, so no label is cut off at the edge.
+//! Frame cost (`crates/ui/AGENTS.md`): the shapes and labels are built
+//! when the holder, the rect, the unit or the dimension toggle change; a
+//! still frame builds nothing (`builds`).
+//! Provenance: our own drawing over `holder_library::HolderEntry::points`;
+//! the dimension style follows `side_view` (general drawing practice). No
+//! HSMWorks material involved.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use egui::{Align2, Color32, FontId, Pos2, Rect, Sense, Shape, Stroke, Ui, Vec2};
+
+use camcraft_app::holder_library::HolderEntry;
+use camcraft_app::units::{self, Unit};
+
+use crate::egui_app::tool_model_view::BG;
+
+const BODY: Color32 = Color32::from_rgb(86, 92, 104);
+const EDGE: Color32 = Color32::from_rgb(214, 220, 228);
+const DIM: Color32 = Color32::from_rgb(0x7F, 0xB4, 0xD8);
+const NOTE: Color32 = Color32::from_rgb(0x9E, 0xA8, 0xB8);
+const GHOST: Color32 = Color32::from_rgb(0x8A, 0x92, 0xA0);
+/// The room (px) the labels keep at the right and the left of the outline.
+const LABEL_R: f32 = 150.0;
+const LABEL_L: f32 = 40.0;
+/// The spindle nose box and the shank ghost, as shares of the gauge length.
+const NOSE_BOX: f64 = 0.25;
+const SHANK: f64 = 0.35;
+/// The label of the spindle nose box.
+pub(crate) const SPINDLE: &str = "spindle nose";
+
+/// What the drawing was built from.
+#[derive(Clone, PartialEq)]
+struct Key {
+    entry: HolderEntry,
+    clamps: (f64, f64),
+    rect: Rect,
+    unit: Unit,
+    dims: bool,
+}
+
+/// The kept drawing: its shapes and its labels.
+struct Drawing {
+    shapes: Vec<Shape>,
+    labels: Vec<(Pos2, Align2, String)>,
+}
+
+thread_local! {
+    static KEPT: RefCell<Option<(Key, Rc<Drawing>)>> = const { RefCell::new(None) };
+    static BUILDS: Cell<u64> = const { Cell::new(0) };
+}
+
+/// The drawings built on this thread - a still frame adds none.
+#[cfg(test)]
+pub(crate) fn builds() -> u64 {
+    BUILDS.with(Cell::get)
+}
+
+/// The largest diameter of the holder: the flange's or the body's.
+pub(crate) fn largest_d(e: &HolderEntry) -> f64 {
+    e.taper.map_or(0.0, |t| t.flange_d).max(e.body_r() * 2.0)
+}
+
+/// Holder `e` (shank range `clamps`, mm) to scale in a `size` area.
+pub(crate) fn outline(ui: &mut Ui, e: &HolderEntry, clamps: (f64, f64), size: Vec2, u: Unit, dims: bool) {
+    let (resp, painter) = ui.allocate_painter(size, Sense::hover());
+    painter.rect_filled(resp.rect, 4.0, BG);
+    let key = Key { entry: *e, clamps, rect: resp.rect, unit: u, dims };
+    let d = KEPT.with(|k| {
+        let mut k = k.borrow_mut();
+        if let Some((kk, d)) = k.as_ref()
+            && *kk == key
+        {
+            return Rc::clone(d);
+        }
+        BUILDS.with(|b| b.set(b.get().saturating_add(1)));
+        let d = Rc::new(build(e, clamps, resp.rect, u, dims));
+        *k = Some((key, Rc::clone(&d)));
+        d
+    });
+    painter.extend(d.shapes.iter().cloned());
+    for (at, align, text) in &d.labels {
+        painter.text(*at, *align, text, FontId::proportional(11.0), NOTE);
+    }
+}
+
+fn build(e: &HolderEntry, clamps: (f64, f64), rect: Rect, u: Unit, dims: bool) -> Drawing {
+    let mut d = Drawing { shapes: Vec::new(), labels: Vec::new() };
+    let Ok(points) = e.points(0.0, e.gauge_len) else {
+        d.labels.push((rect.center(), Align2::CENTER_CENTER, "no outline".to_owned()));
+        return d;
+    };
+    let pts: Vec<(f64, f64)> = points.iter().map(|p| (p.z, p.r)).filter(|(z, r)| z.is_finite() && r.is_finite()).collect();
+    let r_max = pts.iter().map(|p| p.1).fold(0.0f64, f64::max);
+    let z_max = pts.iter().map(|p| p.0).fold(0.0f64, f64::max);
+    if r_max <= 0.0 || z_max <= 0.0 {
+        return d;
+    }
+    // The spindle nose box is wider than the holder; the room left for
+    // the labels on both sides is kept out of the scale.
+    let r_box = r_max * 1.3;
+    let (top, bottom) = (z_max * (1.0 + NOSE_BOX), -z_max * SHANK);
+    let inner = Rect::from_min_max(
+        Pos2::new(rect.left() + LABEL_L, rect.top() + 12.0),
+        Pos2::new((rect.right() - LABEL_R).max(rect.left() + LABEL_L + 40.0), (rect.bottom() - 26.0).max(rect.top() + 52.0)),
+    );
+    let scale = (inner.width() / (2.0 * r_box as f32)).min(inner.height() / (top - bottom) as f32).max(f32::EPSILON);
+    let axis = inner.center().x;
+    let base = inner.bottom() + bottom as f32 * scale;
+    let at = |z: f64, r: f64| Pos2::new(axis + r as f32 * scale, base - z as f32 * scale);
+    d.shapes.push(Shape::line_segment(
+        [Pos2::new(axis, rect.top() + 4.0), Pos2::new(axis, rect.bottom() - 4.0)],
+        Stroke::new(1.0, Color32::from_rgb(70, 74, 84)),
+    ));
+    for w in pts.windows(2) {
+        let ((z0, r0), (z1, r1)) = (w[0], w[1]);
+        if z1 > z0 {
+            d.shapes.push(Shape::convex_polygon(vec![at(z0, -r0), at(z0, r0), at(z1, r1), at(z1, -r1)], BODY, Stroke::NONE));
+        }
+    }
+    let mut edge: Vec<Pos2> = pts.iter().map(|&(z, r)| at(z, r)).collect();
+    edge.extend(pts.iter().filter(|p| p.1 > 0.0).rev().map(|&(z, r)| at(z, -r)));
+    d.shapes.push(Shape::closed_line(edge, Stroke::new(1.0, EDGE)));
+    let ghost = Stroke::new(1.0, GHOST);
+    let dashed = |d: &mut Drawing, pts: &[Pos2]| d.shapes.extend(Shape::dashed_line(pts, ghost, 5.0, 4.0));
+    // The spindle nose above the gauge line.
+    let sp = [at(z_max, -r_box), at(top, -r_box), at(top, r_box), at(z_max, r_box), at(z_max, -r_box)];
+    dashed(&mut d, &sp);
+    d.labels.push((Pos2::new(at(z_max, r_box).x + 6.0, at((z_max + top) * 0.5, 0.0).y), Align2::LEFT_CENTER, SPINDLE.to_owned()));
+    // The shank range below the nose: the largest shank, the smallest inside.
+    let (from, to) = clamps;
+    if to > 0.0 && to.is_finite() {
+        let (rt, rf) = (to * 0.5, from.max(0.0) * 0.5);
+        dashed(&mut d, &[at(0.0, -rt), at(bottom, -rt), at(bottom, rt), at(0.0, rt)]);
+        if rf > 0.0 && (rt - rf) > 1e-9 {
+            dashed(&mut d, &[at(0.0, -rf), at(bottom * 0.8, -rf), at(bottom * 0.8, rf), at(0.0, rf)]);
+        }
+        let len = |v: f64| units::len(v, u, 2);
+        let text = if (to - from).abs() < 1e-9 { format!("shank Ø{}", len(to)) } else { format!("shank Ø{} to {}", len(from), len(to)) };
+        d.labels.push((Pos2::new(at(0.0, rt).x + 6.0, at(bottom * 0.5, 0.0).y), Align2::LEFT_CENTER, text));
+    }
+    if dims {
+        let len = |v: f64| units::len(v, u, 2);
+        let stroke = Stroke::new(1.0, DIM);
+        // The gauge length on the right, the largest diameter over the top,
+        // the nose diameter under the nose.
+        let x = at(0.0, r_max).x + 14.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(x, at(0.0, 0.0).y), Pos2::new(x, at(z_max, 0.0).y)], stroke));
+        d.labels.push((Pos2::new(x + 4.0, at(z_max * 0.5, 0.0).y), Align2::LEFT_CENTER, format!("gauge length {}", len(e.gauge_len))));
+        let y = at(z_max, 0.0).y - 8.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(at(0.0, -r_max).x, y), Pos2::new(at(0.0, r_max).x, y)], stroke));
+        d.labels.push((Pos2::new(axis, y - 2.0), Align2::CENTER_BOTTOM, format!("Ø {}", len(largest_d(e)))));
+        let rn = e.body_r();
+        let y = at(0.0, 0.0).y + 8.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(at(0.0, -rn).x, y), Pos2::new(at(0.0, rn).x, y)], stroke));
+        d.labels.push((Pos2::new(at(0.0, -rn).x - 4.0, y), Align2::RIGHT_CENTER, format!("nose Ø {}", len(rn * 2.0))));
+    }
+    d
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/holder_form.rs b/crates/ui/src/egui_app/tool_library_dialog/holder_form.rs
new file mode 100644
index 000000000..9f4d0d7bb
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/holder_form.rs
@@ -0,0 +1,281 @@
+//! #4338 (U12 of #3663): the holder form of the tool library window - a
+//! user holder of the document with its name, its machine side (the
+//! spindle taper), its tool side (the clamp and the shank range it
+//! clamps) and its shape (gauge length, largest and nose diameter) as
+//! inputs, the drawing to scale with the spindle nose and the shank range,
+//! and the tools that use it. The values are the window's own draft
+//! (`ComponentDraft::shape`); only the footer's Apply lands them, as one
+//! undoable `EditDocumentComponent` that derives each of those tools again
+//! in the same undo step - or refuses by name, and changes nothing, when a
+//! tool no longer fits. The outline is the holder library's outline of the
+//! values (`HolderShape::geometry`): never smaller than the steel.
+//! Frame cost (`crates/ui/AGENTS.md`): the check of the draft is kept for
+//! its shape (`checks`); the drawing is `holder_drawing`'s.
+//! Provenance: our own form over our own holder shape and component
+//! commands; no HSMWorks material involved.
+
+use std::cell::{Cell, RefCell};
+
+use egui::{RichText, Ui, Vec2};
+
+use camcraft_app::component::{ADAPTIVE_PORT, ToolComponent};
+use camcraft_app::holder_library::{ER_SIZES, HolderEntry, HolderShape, ShapeClamp, tapers};
+
+use super::component_edit::{close, current};
+use crate::state::{ComponentAction, ComponentDraft, ErrorScope, State};
+
+/// The field labels (their AccessKit names).
+pub(crate) const NAME: &str = "Name";
+pub(crate) const TAPER: &str = "Spindle taper";
+pub(crate) const CLAMP: &str = "Clamp";
+pub(crate) const FROM: &str = "Clamps from";
+pub(crate) const TO: &str = "Clamps to";
+pub(crate) const GAUGE: &str = "Gauge length";
+pub(crate) const LARGEST: &str = "Largest diameter";
+pub(crate) const NOSE: &str = "Nose diameter";
+pub(crate) const EDIT_OUTLINE: &str = "Edit outline…";
+pub(crate) const IMPORT_STEP: &str = "Import model (STEP)…";
+/// Why the outline buttons are not offered yet.
+pub(crate) const NO_OUTLINE: &str = "an outline edit and a STEP import follow in #4390";
+const FIELDS_W: f32 = 380.0;
+const WELDON: &str = "Weldon side lock";
+const SHRINK: &str = "shrink fit";
+
+thread_local! {
+    static KEPT: RefCell<Option<(HolderShape, Result<HolderEntry, String>)>> = const { RefCell::new(None) };
+    static CHECKS: Cell<u64> = const { Cell::new(0) };
+}
+
+/// The shape checks run on this thread - a still frame adds none.
+#[cfg(test)]
+pub(crate) fn checks() -> u64 {
+    CHECKS.with(Cell::get)
+}
+
+/// The library entry the shape draws, or why the shape is refused: the
+/// values and the outline, as Apply will check them. Kept for the shape.
+fn check(shape: &HolderShape) -> Result<HolderEntry, String> {
+    KEPT.with(|k| {
+        let mut k = k.borrow_mut();
+        if let Some((s, out)) = k.as_ref()
+            && s == shape
+        {
+            return out.clone();
+        }
+        CHECKS.with(|c| c.set(c.get().saturating_add(1)));
+        let out = shape.geometry(ADAPTIVE_PORT).and_then(|_| shape.entry()).map_err(|e| e.to_string());
+        *k = Some((*shape, out.clone()));
+        out
+    })
+}
+
+/// The clamp as words.
+fn clamp_text(c: ShapeClamp) -> String {
+    match c {
+        ShapeClamp::Er(er) => format!("{} collet", er.name),
+        ShapeClamp::Weldon => WELDON.to_owned(),
+        ShapeClamp::Shrink => SHRINK.to_owned(),
+    }
+}
+
+/// The open holder draft, when the window shows the holder form.
+fn draft(state: &State) -> Option<(&ComponentDraft, HolderShape)> {
+    let d = state.tool_library.as_ref()?.component_edit.as_ref()?;
+    Some((d, d.shape?))
+}
+
+/// Why the holder draft cannot be applied, or `None` (also when no holder
+/// form is open).
+pub(crate) fn refusal(state: &State) -> Option<String> {
+    let (d, shape) = draft(state)?;
+    if d.name.trim().is_empty() {
+        return Some("the holder needs a name".to_owned());
+    }
+    check(&shape).err()
+}
+
+/// The tools whose component stack uses the open holder.
+pub(crate) fn users(state: &mut State) -> Vec<String> {
+    current(state).map(|(_, _, _, users)| users).unwrap_or_default()
+}
+
+/// The footer's Apply: one undoable `EditDocumentComponent`, or the
+/// refusal by name.
+pub(super) fn apply(state: &mut State) {
+    let Some((d, row, _, _)) = current(state) else {
+        return;
+    };
+    let Some(shape) = d.shape else {
+        return;
+    };
+    if d == crate::state::draft_of(&row) {
+        return;
+    }
+    let built = shape
+        .kind()
+        .and_then(|kind| Ok((kind, shape.geometry(ADAPTIVE_PORT)?)))
+        .map_err(|e| e.to_string())
+        .and_then(|(kind, geometry)| Ok((ToolComponent::new(&d.id, d.name.trim(), kind).map_err(|e| e.to_string())?, geometry)));
+    match built {
+        Ok(edit) => state.queue_component(ComponentAction::Edit(Box::new(edit))),
+        Err(e) => state.refuse(ErrorScope::Tool, format!("holder not changed: {e}")),
+    }
+}
+
+/// The footer's Duplicate: a new user holder, copied from the applied one.
+pub(super) fn duplicate(state: &mut State) {
+    if let Some((d, _)) = draft(state) {
+        let id = d.id.clone();
+        state.queue_component(ComponentAction::CopyAsUser { id });
+    }
+}
+
+/// A value row: the label, the input (`mm`) and the unit.
+fn number(ui: &mut Ui, label: &str, v: &mut f64, enabled: bool, why: &str) -> bool {
+    let l = ui.label(label);
+    let r = ui
+        .add_enabled(enabled, egui::DragValue::new(v).speed(0.1).range(0.0..=1000.0).max_decimals(3))
+        .labelled_by(l.id)
+        .on_disabled_hover_text(why);
+    ui.weak("mm");
+    ui.end_row();
+    r.changed()
+}
+
+pub(super) fn draw(ui: &mut Ui, state: &mut State) {
+    let Some((mut d, _row, _, users)) = current(state) else {
+        // Deleted (or undone) under the form: back to the list.
+        close(state);
+        return;
+    };
+    let Some(mut s) = d.shape else {
+        close(state);
+        return;
+    };
+    let mut open_tool = None;
+    if let Some(msg) = state.error_for(ErrorScope::Tool).map(str::to_owned) {
+        super::super::error_text::error_text(ui, super::super::colorvision::text_inks(ui, &state.world).error, &msg);
+    }
+    let h = ui.available_height().min(ui.ctx().viewport_rect().height() * 0.7 - 140.0).max(200.0);
+    let checked = check(&s);
+    ui.horizontal_top(|ui| {
+        ui.vertical(|ui| {
+            ui.set_width(FIELDS_W);
+            egui::ScrollArea::vertical().id_salt("tool_library_holder_form").max_height(h).show(ui, |ui| {
+                fields(ui, &mut d.name, &mut s);
+                if let Err(why) = &checked {
+                    super::super::error_text::error_text(ui, super::super::colorvision::text_inks(ui, &state.world).error, why);
+                }
+                ui.horizontal(|ui| {
+                    let _ = ui.add_enabled(false, egui::Button::new(EDIT_OUTLINE)).on_disabled_hover_text(NO_OUTLINE);
+                    let _ = ui.add_enabled(false, egui::Button::new(IMPORT_STEP)).on_disabled_hover_text(NO_OUTLINE);
+                });
+                ui.add_space(6.0);
+                ui.label(RichText::new(format!("USED BY {}", super::holder_view::count(users.len()).to_uppercase())).small().weak());
+                if users.is_empty() {
+                    ui.weak("No tool stack uses this holder.");
+                }
+                for name in &users {
+                    if ui.link(name.as_str()).on_hover_text("edit this tool in this window").clicked() {
+                        open_tool = Some(name.clone());
+                    }
+                }
+            });
+        });
+        ui.separator();
+        ui.vertical(|ui| {
+            ui.weak("to scale · mm");
+            let size = Vec2::new(ui.available_width().max(200.0), (h - 24.0).max(180.0));
+            match &checked {
+                Ok(entry) => super::holder_drawing::outline(ui, entry, s.clamps(), size, camcraft_app::units::Unit::Millimeters, true),
+                Err(_) => {
+                    ui.weak("The drawing shows when the values describe a holder.");
+                }
+            }
+        });
+    });
+    d.shape = Some(s);
+    if let Some(v) = state.tool_library.as_mut() {
+        v.component_edit = Some(d);
+    }
+    if let Some(name) = open_tool {
+        close(state);
+        state.open_tool_in_library(&name);
+    }
+}
+
+/// The name and the three sections; a change lands in the draft only.
+fn fields(ui: &mut Ui, name: &mut String, s: &mut HolderShape) {
+    egui::Grid::new("tool_library_holder_name").num_columns(2).show(ui, |ui| {
+        let l = ui.label(NAME);
+        ui.add(egui::TextEdit::singleline(name).desired_width(220.0)).labelled_by(l.id);
+        ui.end_row();
+    });
+    section(ui, "MACHINE SIDE");
+    egui::Grid::new("tool_library_holder_machine").num_columns(2).show(ui, |ui| {
+        let l = ui.label(TAPER);
+        egui::ComboBox::from_id_salt("holder_taper").selected_text(s.taper.name).show_ui(ui, |ui| {
+            for t in tapers() {
+                ui.selectable_value(&mut s.taper, t, t.name);
+            }
+        })
+        .response
+        .labelled_by(l.id);
+        ui.end_row();
+    });
+    section(ui, "TOOL SIDE");
+    egui::Grid::new("tool_library_holder_tool").num_columns(3).show(ui, |ui| {
+        let l = ui.label(CLAMP);
+        let mut clamp = s.clamp;
+        egui::ComboBox::from_id_salt("holder_clamp").selected_text(clamp_text(clamp)).show_ui(ui, |ui| {
+            for c in ER_SIZES.iter().map(|e| ShapeClamp::Er(*e)).chain([ShapeClamp::Weldon, ShapeClamp::Shrink]) {
+                ui.selectable_value(&mut clamp, c, clamp_text(c));
+            }
+        })
+        .response
+        .labelled_by(l.id);
+        ui.end_row();
+        if clamp != s.clamp {
+            set_clamp(s, clamp);
+        }
+        let bore = !matches!(s.clamp, ShapeClamp::Er(_));
+        let (mut from, mut to) = s.clamps();
+        let why = "an ER chuck clamps the collet range of its size";
+        // A bore clamps one size: either field sets it.
+        if number(ui, FROM, &mut from, bore, why) {
+            s.bore = from;
+        }
+        if number(ui, TO, &mut to, bore, why) {
+            s.bore = to;
+        }
+    });
+    section(ui, "SHAPE");
+    egui::Grid::new("tool_library_holder_shape").num_columns(3).show(ui, |ui| {
+        number(ui, GAUGE, &mut s.gauge_len, true, "");
+        let shrink = s.clamp == ShapeClamp::Shrink;
+        number(ui, LARGEST, &mut s.largest_d, shrink, "an ER or Weldon body is as wide as its nose: edit the nose diameter");
+        if number(ui, NOSE, &mut s.nose_d, true, "") && !shrink {
+            s.largest_d = s.nose_d;
+        }
+    });
+}
+
+/// A new clamp keeps what still applies: a bore keeps its size (a new one
+/// takes the largest collet), a one-body clamp its nose.
+fn set_clamp(s: &mut HolderShape, clamp: ShapeClamp) {
+    if let ShapeClamp::Er(er) = s.clamp
+        && !matches!(clamp, ShapeClamp::Er(_))
+    {
+        s.bore = er.max_bore;
+    }
+    s.clamp = clamp;
+    match clamp {
+        ShapeClamp::Shrink => s.largest_d = s.largest_d.max(s.nose_d),
+        ShapeClamp::Er(_) | ShapeClamp::Weldon => s.largest_d = s.nose_d,
+    }
+}
+
+fn section(ui: &mut Ui, head: &str) {
+    ui.add_space(4.0);
+    ui.label(RichText::new(head).small().weak());
+}
