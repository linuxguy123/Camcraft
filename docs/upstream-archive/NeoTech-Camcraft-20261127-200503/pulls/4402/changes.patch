@@ -0,0 +1,51 @@
+//! #4338 (U12 of #3663): the shape of a document holder as the holder form
+//! edits it (`holder_library::HolderShape::of`), read when the row
+//! changes and kept: the form compares its draft with the row's shape on
+//! each frame, and a still frame reads no shape again (`shape_reads`).
+//! Provenance: our own cache over our own holder shape; no HSMWorks
+//! material involved.
+
+use std::cell::{Cell, RefCell};
+
+use camcraft_app::component::{ADAPTIVE_PORT, ComponentKind};
+use camcraft_app::component_geometry::ComponentGeometry;
+use camcraft_app::holder_library::HolderShape;
+use camcraft_app::schema::DocumentComponent;
+
+use super::{ComponentGroup, group_of};
+
+type Kept = Option<((ComponentKind, ComponentGeometry), Option<HolderShape>)>;
+
+thread_local! {
+    static KEPT: RefCell<Kept> = const { RefCell::new(None) };
+    static READS: Cell<u64> = const { Cell::new(0) };
+}
+
+/// The shape reads on this thread - a still frame adds none.
+#[cfg(test)]
+#[must_use]
+pub fn shape_reads() -> u64 {
+    READS.with(Cell::get)
+}
+
+/// The shape of holder `row`, when the holder form can edit it: a spindle
+/// holder whose outline is the holder library's outline of a shape.
+#[must_use]
+pub fn shape_of(row: &DocumentComponent) -> Option<HolderShape> {
+    if group_of(&row.component) != ComponentGroup::Holders {
+        return None;
+    }
+    KEPT.with(|k| {
+        let mut k = k.borrow_mut();
+        if let Some(((kind, geometry), shape)) = k.as_ref()
+            && kind == row.component.kind()
+            && *geometry == row.geometry
+        {
+            return *shape;
+        }
+        READS.with(|r| r.set(r.get().saturating_add(1)));
+        let shape = HolderShape::of(row.component.kind(), &row.geometry, ADAPTIVE_PORT);
+        *k = Some(((row.component.kind().clone(), row.geometry.clone()), shape));
+        shape
+    })
+}
diff --git a/crates/ui/src/state_holder_search.rs b/crates/ui/src/state_holder_search.rs
new file mode 100644
index 000000000..4f6596f80
--- /dev/null
+++ b/crates/ui/src/state_holder_search.rs
@@ -0,0 +1,107 @@
+//! #4338 (U12 of #3663): the search of the Holders page. The text splits
+//! into terms; a holder is shown when each term is in its words (name,
+//! taper, clamp, sizes) or, for a number, when the holder clamps a shank
+//! of that size - "BT40 ER32", "shrink 12". The result is kept for its
+//! input (the text, the taper pick, the library rows and the document's
+//! component rows, each an `Rc` that a change replaces): a still frame
+//! searches nothing (`holder_searches`).
+//! Provenance: our own search over our own holder rows; no HSMWorks
+//! material involved.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use super::ComponentRow;
+
+/// One searchable holder: its words (lower case), the shank range it
+/// clamps (mm) and its taper's name ("" for none).
+#[derive(Clone, Debug, PartialEq)]
+pub struct HolderItem {
+    pub words: String,
+    pub from: f64,
+    pub to: f64,
+    pub taper: String,
+}
+
+/// The shown rows: indices into the library rows and into the document's
+/// component rows, and the counts before the search.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct HolderHits {
+    pub library: Vec<usize>,
+    pub user: Vec<usize>,
+    pub library_total: usize,
+    pub user_total: usize,
+}
+
+impl HolderHits {
+    #[must_use]
+    pub fn shown(&self) -> usize {
+        self.library.len() + self.user.len()
+    }
+
+    #[must_use]
+    pub fn total(&self) -> usize {
+        self.library_total + self.user_total
+    }
+}
+
+/// The input: the text, the taper pick and the two row lists (kept, so
+/// that an address is never reused while it is a key).
+type Key = (String, Option<String>, Rc<Vec<HolderItem>>, Rc<Vec<ComponentRow>>);
+
+fn same(a: &Key, b: &Key) -> bool {
+    a.0 == b.0 && a.1 == b.1 && Rc::ptr_eq(&a.2, &b.2) && Rc::ptr_eq(&a.3, &b.3)
+}
+
+thread_local! {
+    static KEPT: RefCell<Option<(Key, Rc<HolderHits>)>> = const { RefCell::new(None) };
+    static SEARCHES: Cell<u64> = const { Cell::new(0) };
+}
+
+/// The searches run on this thread - a still frame adds none.
+#[cfg(test)]
+#[must_use]
+pub fn holder_searches() -> u64 {
+    SEARCHES.with(Cell::get)
+}
+
+/// Does `item` match each of `terms`?
+fn matches(item: &HolderItem, terms: &[String]) -> bool {
+    terms.iter().all(|t| {
+        item.words.contains(t.as_str())
+            || t.trim_end_matches("mm").parse::<f64>().is_ok_and(|v| v.is_finite() && v >= item.from - 1e-9 && v <= item.to + 1e-9)
+    })
+}
+
+/// The rows `query` shows: the library rows of the picked `taper` (all
+/// when `None`) and the document rows that `user_item` makes an item of.
+pub fn holder_hits(
+    query: &str,
+    taper: Option<&str>,
+    library: &Rc<Vec<HolderItem>>,
+    user: &Rc<Vec<ComponentRow>>,
+    user_item: impl Fn(&ComponentRow) -> Option<HolderItem>,
+) -> Rc<HolderHits> {
+    let key: Key = (query.to_owned(), taper.map(str::to_owned), Rc::clone(library), Rc::clone(user));
+    KEPT.with(|k| {
+        let mut k = k.borrow_mut();
+        if let Some((kk, hits)) = k.as_ref()
+            && same(kk, &key)
+        {
+            return Rc::clone(hits);
+        }
+        SEARCHES.with(|s| s.set(s.get().saturating_add(1)));
+        let terms: Vec<String> = query.to_lowercase().split_whitespace().map(str::to_owned).collect();
+        let in_taper = |i: &HolderItem| taper.is_none_or(|t| i.taper == t);
+        let lib: Vec<usize> = library.iter().enumerate().filter(|(_, i)| in_taper(i)).map(|(n, _)| n).collect();
+        let users: Vec<(usize, HolderItem)> = user.iter().enumerate().filter_map(|(n, r)| user_item(r).map(|i| (n, i))).collect();
+        let hits = Rc::new(HolderHits {
+            library_total: lib.len(),
+            user_total: users.len(),
+            library: lib.into_iter().filter(|n| library.get(*n).is_some_and(|i| matches(i, &terms))).collect(),
+            user: users.iter().filter(|(_, i)| matches(i, &terms)).map(|(n, _)| *n).collect(),
+        });
+        *k = Some((key, Rc::clone(&hits)));
+        hits
+    })
+}
diff --git a/docs/decisions/4338-holders-page.md b/docs/decisions/4338-holders-page.md
new file mode 100644
index 000000000..8b01d5652
--- /dev/null
+++ b/docs/decisions/4338-holders-page.md
@@ -0,0 +1,59 @@
+## #4338 - Tool library U12: the Holders page search and the holder form
+
+**What was decided.**
+
+- **The shape is the holder library's.** A user holder's editable shape is
+  `holder_library::HolderShape` (new, in `crates/tools`): the taper, the
+  clamp (an ER size, a Weldon bore or a shrink-fit bore), the bore, the
+  gauge length, the nose diameter and the largest diameter. Its outline is
+  `HolderEntry::points` of those values - the same audited builder as the
+  built-in holders - so the law "never smaller than the steel" holds for
+  the values the user states: an ER nut at its diameter over its whole
+  length, a Weldon body `WELDON_SCREW` wider, a shrink nose and body
+  `SHRINK_MARGIN` wider, the flange a full cylinder. The test
+  `an_edited_outline_is_never_smaller_than_the_steel` samples the outline
+  of a grid of edited shapes against the stated steel.
+- **No new project-file field.** The shape is read back from the row's
+  machine side, workpiece side and outline (`HolderShape::of`), and is
+  accepted only when the outline it makes is the row's outline, point for
+  point. A holder with any other outline (a DXF profile, an adapter) opens
+  in the generic component editor as before. Dropped: a stored shape record
+  on `DocumentComponent` - a project-file change and a hot `schema.rs` edit
+  for data the outline already holds.
+- **Largest diameter.** It is the widest steel of the body below the
+  flange. An ER or Weldon body is as wide as its nose, so for those clamps
+  the field follows the nose diameter and is disabled with that reason;
+  only a shrink-fit chuck has two body diameters. The drawing's top
+  dimension still shows the flange when the flange is wider.
+- **Clamps from / to.** An ER chuck clamps the collet range of its size
+  (ISO 15488): the two fields show it and are disabled. A Weldon or
+  shrink-fit bore clamps one size: either field sets the bore. Dropped: a
+  narrowed ER range - the workpiece side code `ER32` cannot state it.
+- **Refusals.** A value that cannot describe steel is refused by name
+  before Apply (Apply disabled with the reason, the text under the
+  fields). An edit that breaks a tool's fit is refused by
+  `EditDocumentComponent`, which derives each tool that uses the holder
+  again; the refusal names the holder and what no longer fits, and nothing
+  changes.
+- **Units.** The form edits in mm, as the component table and the library
+  facts store them. Dropped for now: inch input on this form.
+- **Search.** AND over terms; a term matches the holder's words (name,
+  taper, clamp) or, when it is a number, a holder that clamps that shank
+  size ("BT40 ER32", "shrink 12", "er 16"). The result is kept for its
+  input (text, taper pick, the library rows and the component rows,
+  each an `Rc`), so a still frame searches nothing. The user holders
+  section shows only when the document has one.
+- **New holder** copies the machine taper's ER32 chuck (or its first
+  holder; BT40 ER32 without a machine taper) as a user holder and opens
+  it. **Duplicate** copies the applied user holder under a new `user:` id.
+  Both are the existing `CopyAsUser` action, one undo step.
+- **Not in this PR, filed:** Import / Export of holder files (#4389, the
+  buttons are disabled with that reason), Edit outline and Import model
+  (STEP) (#4390, same), the MCP tool for a shape edit (#4391; MCP can
+  already replace the row with `upsert_tool_component`). The holder rail
+  on the left of the mockup's form is not drawn: "‹ List" returns to the
+  searchable list.
+
+**Cost to change later.** The shape lives in `holder_library_shape.rs`;
+a stored shape record or a new clamp kind changes that file, the form and
+`HolderShape::of`'s read-back.

