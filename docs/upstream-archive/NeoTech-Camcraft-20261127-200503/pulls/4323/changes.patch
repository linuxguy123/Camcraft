+//! #3643: an STL or OBJ file read as the facets of one tool component,
+//! inside the facet budget of a component body. STL per the public
+//! StereoLithography interface layout (ASCII `solid` / `facet` /
+//! `vertex` records; binary: an 80-byte header, a little-endian u32
+//! count, 50 bytes per facet); OBJ per the public Wavefront OBJ notes
+//! (`v x y z`, `f` with 1-based or negative indices and `v/vt/vn`
+//! words, polygons split as a fan). Our own reader; no vendor source or
+//! file consulted.
+//!
+//! The law: a file is read whole or refused by name - empty, too big,
+//! over the facet budget, not text where text is needed, a syntax
+//! error with its line, a non-finite number, an index off the vertex
+//! list, or no facets. Nothing here panics on any input.
+
+/// One facet: three corners in mm.
+pub type Tri = [[f64; 3]; 3];
+
+/// The most facets one component body may have. A body past it is
+/// refused by name (#1041 is the open work to mesh it coarser instead).
+pub const MAX_BODY_FACETS: usize = 1_000_000;
+/// The largest component file read (bytes): an ASCII STL at the facet
+/// budget is about 250 MB.
+pub const MAX_BODY_FILE_BYTES: usize = 512 << 20;
+/// The most vertices an OBJ body may list.
+pub const MAX_BODY_VERTICES: usize = 3 * MAX_BODY_FACETS;
+
+/// Why a mesh file is no component body.
+#[derive(Clone, Debug, PartialEq)]
+pub enum MeshFileError {
+    Empty,
+    TooBig { bytes: usize },
+    OverBudget { facets: usize },
+    TooManyVertices,
+    NotText,
+    BinaryLength { facets: u64, bytes: usize },
+    Syntax { line: usize, why: String },
+    NonFinite { line: usize },
+    BadIndex { line: usize, word: String },
+    NoFacets,
+}
+
+impl core::fmt::Display for MeshFileError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::Empty => write!(f, "the file is empty"),
+            Self::TooBig { bytes } => {
+                write!(f, "the file has {bytes} bytes, more than the {MAX_BODY_FILE_BYTES} bytes of a component body")
+            }
+            Self::OverBudget { facets } => write!(
+                f,
+                "the body has {facets} facets or more, over the budget of {MAX_BODY_FACETS} facets for one tool \
+                 component (#1041: a coarser mesh is not made yet) - export it again with fewer facets"
+            ),
+            Self::TooManyVertices => {
+                write!(f, "the file lists more than {MAX_BODY_VERTICES} vertices, over the budget of a component body")
+            }
+            Self::NotText => write!(f, "the file is not text (UTF-8)"),
+            Self::BinaryLength { facets, bytes } => write!(
+                f,
+                "the binary STL states {facets} facets, but holds {bytes} bytes (84 + 50 per facet) - the file is cut short or is no STL"
+            ),
+            Self::Syntax { line, why } => write!(f, "line {line}: {why}"),
+            Self::NonFinite { line } => write!(f, "line {line}: a coordinate is not a finite number"),
+            Self::BadIndex { line, word } => write!(f, "line {line}: '{word}' is no vertex of the file"),
+            Self::NoFacets => write!(f, "the file has no facets"),
+        }
+    }
+}
+
+impl std::error::Error for MeshFileError {}
+
+fn check_size(data: &[u8]) -> Result<(), MeshFileError> {
+    if data.is_empty() {
+        return Err(MeshFileError::Empty);
+    }
+    if data.len() > MAX_BODY_FILE_BYTES {
+        return Err(MeshFileError::TooBig { bytes: data.len() });
+    }
+    Ok(())
+}
+
+/// The facets of an ASCII or binary STL file.
+pub fn read_stl(data: &[u8]) -> Result<Vec<Tri>, MeshFileError> {
+    check_size(data)?;
+    // A binary header may start with "solid" too: an ASCII STL is text
+    // with no NUL byte, and one with no facet record is tried as binary.
+    let text_start = data.iter().position(|b| !b.is_ascii_whitespace()).unwrap_or(data.len());
+    let solid = data[text_start..].starts_with(b"solid");
+    if solid
+        && !data.contains(&0)
+        && let Ok(text) = std::str::from_utf8(data)
+    {
+        match read_ascii(text) {
+            Err(MeshFileError::NoFacets) => {}
+            other => return other,
+        }
+    }
+    let count = data.get(80..84).map(|b| u64::from(u32::from_le_bytes([b[0], b[1], b[2], b[3]])));
+    if let Some(n) = count
+        && 84 + 50 * n == data.len() as u64
+    {
+        return read_binary(data, n);
+    }
+    match count {
+        _ if solid && !data.contains(&0) && std::str::from_utf8(data).is_ok() => Err(MeshFileError::NoFacets),
+        Some(facets) => Err(MeshFileError::BinaryLength { facets, bytes: data.len() }),
+        None if solid => Err(MeshFileError::NotText),
+        None => Err(MeshFileError::Syntax { line: 1, why: "an STL starts with 'solid' or an 84-byte binary header".into() }),
+    }
+}
+
+fn read_binary(data: &[u8], n: u64) -> Result<Vec<Tri>, MeshFileError> {
+    if n == 0 {
+        return Err(MeshFileError::NoFacets);
+    }
+    if n > MAX_BODY_FACETS as u64 {
+        return Err(MeshFileError::OverBudget { facets: usize::try_from(n).unwrap_or(usize::MAX) });
+    }
+    let mut tris = Vec::new();
+    // The length was checked equal to 84 + 50 n, so every record is whole.
+    let (records, _) = data[84..].as_chunks::<50>();
+    for (k, rec) in records.iter().enumerate() {
+        let f = |i: usize| {
+            let at = 12 + 4 * i;
+            f64::from(f32::from_le_bytes([rec[at], rec[at + 1], rec[at + 2], rec[at + 3]]))
+        };
+        let t: Tri = core::array::from_fn(|v| core::array::from_fn(|c| f(3 * v + c)));
+        if !t.iter().flatten().all(|x| x.is_finite()) {
+            // Binary records have no lines; name the facet as line k + 1.
+            return Err(MeshFileError::NonFinite { line: k + 1 });
+        }
+        tris.push(t);
+    }
+    Ok(tris)
+}
+
+fn read_ascii(text: &str) -> Result<Vec<Tri>, MeshFileError> {
+    let mut tris = Vec::new();
+    let mut corners: Vec<[f64; 3]> = Vec::with_capacity(3);
+    let mut in_facet = false;
+    let syntax = |line: usize, why: &str| MeshFileError::Syntax { line, why: why.into() };
+    for (i, row) in text.lines().enumerate() {
+        let line = i + 1;
+        let mut words = row.split_whitespace();
+        match words.next() {
+            Some("facet") => {
+                if in_facet {
+                    return Err(syntax(line, "a facet starts inside a facet"));
+                }
+                in_facet = true;
+                corners.clear();
+            }
+            Some("vertex") => {
+                if !in_facet {
+                    return Err(syntax(line, "a vertex stands outside a facet"));
+                }
+                if corners.len() == 3 {
+                    return Err(syntax(line, "a facet has more than 3 vertices"));
+                }
+                corners.push(point(&mut words, line)?);
+            }
+            Some("endfacet") => {
+                if !in_facet {
+                    return Err(syntax(line, "'endfacet' without 'facet'"));
+                }
+                let [a, b, c] = corners[..] else {
+                    return Err(syntax(line, "a facet needs exactly 3 vertices"));
+                };
+                if tris.len() >= MAX_BODY_FACETS {
+                    return Err(MeshFileError::OverBudget { facets: tris.len() + 1 });
+                }
+                tris.push([a, b, c]);
+                in_facet = false;
+                corners.clear();
+            }
+            _ => {}
+        }
+    }
+    if in_facet {
+        return Err(syntax(text.lines().count(), "the file ends inside a facet"));
+    }
+    if tris.is_empty() {
+        return Err(MeshFileError::NoFacets);
+    }
+    Ok(tris)
+}
+
+fn point<'a>(words: &mut impl Iterator<Item = &'a str>, line: usize) -> Result<[f64; 3], MeshFileError> {
+    let mut p = [0.0; 3];
+    for c in &mut p {
+        let w = words.next().ok_or_else(|| MeshFileError::Syntax { line, why: "a point needs 3 numbers".into() })?;
+        let v: f64 =
+            w.parse().map_err(|_| MeshFileError::Syntax { line, why: format!("'{w}' is not a number") })?;
+        if !v.is_finite() {
+            return Err(MeshFileError::NonFinite { line });
+        }
+        *c = v;
+    }
+    Ok(p)
+}
+
+/// The facets of an OBJ file: every `f` record, a polygon split as a
+/// fan from its first corner.
+pub fn read_obj(data: &[u8]) -> Result<Vec<Tri>, MeshFileError> {
+    check_size(data)?;
+    let text = std::str::from_utf8(data).map_err(|_| MeshFileError::NotText)?;
+    let mut verts: Vec<[f64; 3]> = Vec::new();
+    let mut tris: Vec<Tri> = Vec::new();
+    for (i, row) in text.lines().enumerate() {
+        let line = i + 1;
+        let mut words = row.split_whitespace();
+        match words.next() {
+            Some("v") => {
+                if verts.len() >= MAX_BODY_VERTICES {
+                    return Err(MeshFileError::TooManyVertices);
+                }
+                verts.push(point(&mut words, line)?);
+            }
+            Some("f") => {
+                let corners: Vec<[f64; 3]> =
+                    words.map(|w| vertex(w, &verts, line)).collect::<Result<_, _>>()?;
+                if corners.len() < 3 {
+                    return Err(MeshFileError::Syntax { line, why: "a face needs at least 3 corners".into() });
+                }
+                for k in 1..corners.len() - 1 {
+                    if tris.len() >= MAX_BODY_FACETS {
+                        return Err(MeshFileError::OverBudget { facets: tris.len() + 1 });
+                    }
+                    tris.push([corners[0], corners[k], corners[k + 1]]);
+                }
+            }
+            _ => {}
+        }
+    }
+    if tris.is_empty() {
+        return Err(MeshFileError::NoFacets);
+    }
+    Ok(tris)
+}
+
+/// The vertex an `f` word names: `i`, `i/t`, `i//n` or `i/t/n`, with a
+/// 1-based index or a negative one counted back from the last vertex.
+fn vertex(word: &str, verts: &[[f64; 3]], line: usize) -> Result<[f64; 3], MeshFileError> {
+    let bad = || MeshFileError::BadIndex { line, word: word.to_owned() };
+    let head = word.split('/').next().unwrap_or_default();
+    let i: i64 = head.parse().map_err(|_| bad())?;
+    let n = i64::try_from(verts.len()).map_err(|_| bad())?;
+    let at = if (1..=n).contains(&i) {
+        i - 1
+    } else if (-n..0).contains(&i) {
+        n + i
+    } else {
+        return Err(bad());
+    };
+    usize::try_from(at).ok().and_then(|k| verts.get(k)).copied().ok_or_else(bad)
+}
diff --git a/docs/decisions/3643-mesh-bodies.md b/docs/decisions/3643-mesh-bodies.md
new file mode 100644
index 0000000000..4e5392dd8e
--- /dev/null
+++ b/docs/decisions/3643-mesh-bodies.md
@@ -0,0 +1,100 @@
+## #3643 - Tool component bodies from STEP, STL and OBJ files, and MCS_INSERT (mesh-body slice)
+
+**What was decided.**
+- `MCS_INSERT` is classified as `CsysRole::Mounting` in
+  `camcraft_geometry::step_csys` (the app's `step_csys.rs` re-exports
+  that type, so the app reads it too). Only the exact name (case and
+  blanks ignored) is taken; `MCS_1` or `MCS_INSERT_2` stay `Other`. A
+  file that names both `MCS` and `MCS_INSERT` has two mounting frames,
+  and `ToolCsysReport::find` refuses it as ambiguous. It is not guessed
+  which one wins.
+- A new `camcraft_tools::mesh_body::MeshBody` reads one component body:
+  - STEP through the existing kernel import
+    (`camcraft_geometry::step::parse`) at a 0.01 mm chord, or coarser
+    inside the facet budget, with its named coordinate systems from
+    `camcraft_geometry::step_csys`;
+  - STL (ASCII and binary) and OBJ through a new small reader in
+    `camcraft_tools::mesh_file`, with frames that the caller stores
+    (`MeshBody::with_frames`), classified by their ISO 13399 names.
+- The component frame is the body's one mounting frame (MCS or
+  MCS_INSERT), as `ComponentGeometry` defines it: origin on the machine
+  side, +Z toward the machine. Each workpiece-side port (CSW, CSWx,
+  CSWx_y) and the cutting point (CIP) is read in that frame. A port or
+  cutting point that is not below the mounting frame is refused by
+  name (`NotBelowMount`): this catches a file whose MCS +Z points away
+  from the machine, which would otherwise place the body upside down.
+- A spindle body (`MeshBody::spindle_geometry`) is the revolved
+  envelope of every facet (`HolderProfile::envelope`), drawn as a
+  stepped `SpunProfile` and stored as a `ComponentBody`. The drawn
+  outline only grows the envelope:
+  - each join of two bands takes the larger radius;
+  - bands closer than 0.02 mm in radius, or shorter than 0.02 mm, are
+    joined, so no drawn segment is shorter than `MIN_SEGMENT`;
+  - a band with no facet (a gap along the axis) gets 0.02 mm, not 0;
+  - at most 31 bands remain, so the outline fits `MAX_POINTS`;
+  - a last check refuses the body (`Outline`) if any envelope band is
+    not inside the drawn outline over its whole length.
+- A lathe body (`MeshBody::lathe_geometry`) is the facets as a
+  `LatheBody`, as #4194 builds the lathe envelope: all bodies of the
+  stack go to `LatheClearance::of` as one set.
+- Never smaller than the steel: a meshed STEP body grows by the
+  kernel's certified deviation (`StepMesh::deviation_mm`).
+  - Spindle: each band radius and both ends grow by it.
+  - Lathe: `LatheBody::padded` records it, and `resolve_lathe` grows
+    the clearance bands by the largest pad of the stack
+    (`LatheClearance::padded`, a Minkowski grow by a box, proof in the
+    module comment of `lathe_clearance_pad.rs`).
+  - An STL or OBJ body has no deviation: the file is the body.
+- Facet budget: one component body has at most `MAX_BODY_FACETS` =
+  1 000 000 facets, and a file at most 512 MB. Past the budget the body
+  is refused by name, with #1041 named in the text. A STEP model is
+  first meshed coarser by the existing importer (up to its six tries);
+  only when no chord fits is it refused (`StepOverBudget`). Automatic
+  coarsening of an STL or OBJ (#1041) is not done here.
+- Every refusal has a name (`MeshBodyError`, `MeshFileError`). No path
+  panics: the readers use checked lengths, `get`, and `try_from`. A
+  fuzz-style test cuts short and flips bits in STL, OBJ and STEP files.
+
+**Why.**
+- The brief asks for the body in the crate that owns component
+  geometry (`camcraft-tools`). That crate already depends on
+  `camcraft-geometry`, which holds the STEP mesher and the coordinate
+  system reader, so no new crate edge is needed.
+- The app's STL and OBJ importers are in `crates/app/src/geometry/import`
+  and return the app's `ImportError`, so `camcraft-tools` cannot call
+  them. A small reader in the tools crate was chosen over a move of the
+  app importers, because the move touches the model import path and its
+  tests, which this slice must not change.
+- A revolved outline is what the spindle laws read today
+  (`ComponentBody`, `HolderProfile`), so the mesh enters the same
+  judged path as a parametric holder, and the existing union of bodies
+  in `tool_assembly_body::judged` works with no change.
+- The deviation is a measured bound, so the grow is the smallest grow
+  that keeps "never smaller than the steel" true for a curved surface,
+  where the facets lie inside the surface.
+
+**Considered and dropped.**
+- A mesh variant of `ComponentBody` that the spindle laws read
+  directly: dropped. It changes `judged` and the collision laws, and
+  the revolved envelope is already how an imported holder mesh is
+  judged today.
+- Moving the app's STL and OBJ readers to `camcraft-geometry`: kept for
+  later. A follow-up can make the app import call
+  `camcraft_tools::mesh_file` or a shared reader.
+- Refusing a pad larger than half a lathe band: dropped. The grow
+  takes the union of as many neighbour bands as the pad needs.
+- Taking `MCS` over `MCS_INSERT` when a file names both: dropped. The
+  two are the same role, and a guess can place an insert wrongly.
+
+**What it costs to change later.**
+- The budget and the chord are constants in `mesh_file.rs` and
+  `mesh_body.rs`. #1041 can replace the refusal with a coarser mesh.
+- The app wiring is not in this slice: a document field for the mesh
+  file and its stored frames, the commands and MCP tools that set it,
+  and the call to `MeshBody::spindle_geometry` / `lathe_geometry` in
+  `crates/app/src/tool_assembly*.rs` (open PRs #4249 and #4278 change
+  those files now).
+- The near-tip check of `resolve_lathe` (`BodyPastEdge`) reads the
+  facets without the pad. It finds a wrong hand or seat frame, and it
+  is not a clearance law.
+- The boring-bar overhang in a sleeve is not in this slice.

From 06eecf33c4564f6c2772534285ba82ddde59ccac Mon Sep 17 00:00:00 2001
From: Quintin Smits <qd.smits@gmail.com>
Date: Fri, 27 Nov 2026 10:04:23 +0100
Subject: [PATCH 2/4] fix(app): a lathe body keeps its pad through save and
 open

Main took #3645: a components row writes its lathe body to the
.camproj as facets only. A padded body (#3643, a meshed body's chord
deviation) opened again without its pad, so its bands shrank to the
bare facets. LatheBodyDto now carries an optional `pad` key, written
only above 0 (files without a meshed body stay byte for byte the
same) and read back through the checked LatheBody::padded.

Pinned by a_padded_lathe_body_keeps_its_pad_through_save_and_open and
a negative-pad case in the corrupt-lathe-body test.

Refs #3643

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
