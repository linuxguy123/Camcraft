+            );
+            assert!(
+                at_limit.program.contains(tool_call),
+                "{script}: missing {tool_call}: {}",
+                at_limit.program
+            );
+            let over = refusal(255);
+            assert!(
+                over.contains("tool number 255") && over.contains("tool table"),
+                "{script}: {over}"
+            );
+        }
+    }
+}
