+    assert!(at("FX-TIP-OUT") < travel && travel < at_from("FX-THREAD", travel), "the wire is cut and disposed before the travel, threaded after it: {text}");
+    let (comp, comp2) = (at("FX-COMP-OFF"), at_from("FX-COMP-OFF", skim_cond));
