@@ -0,0 +1,273 @@
+//! The colour-literal scanner of the #1120 guard (`colour_literals`):
+//! what counts as a colour literal in Rust source, and the comment
+//! stripper it reads through. Split from the guard for the 400-line law.
+//!
+//! A literal is a named constant (`Color32::WHITE`) or a constructor
+//! whose arguments are all numbers written in place
+//! (`Color32::from_rgb(245, 240, 250)`). A constructor over variables
+//! (`from_rgb(r, g, b)`) converts a colour chosen elsewhere and does not
+//! count. Comments (`//` to the line end, `/* */`) do not count; the text
+//! of a string or char literal is kept as it is.
+//! Provenance: our own scanner, specced from the Rust reference's lexical
+//! rules for comments, strings and char literals.
+
+/// A colour written as a value at the call site. `Color32::TRANSPARENT`
+/// is not in the list: it carries no hue for a theme to change.
+const PATTERNS: &[&str] = &[
+    "Color32::from_rgb(",
+    "Color32::from_rgba_unmultiplied(",
+    "Color32::from_rgba_premultiplied(",
+    "Color32::from_gray(",
+    "Color32::from_black_alpha(",
+    "Color32::from_white_alpha(",
+    "Color32::from_hex(",
+    "Rgba::from_rgb(",
+    "Color32::WHITE",
+    "Color32::BLACK",
+    "Color32::GRAY",
+    "Color32::LIGHT_GRAY",
+    "Color32::DARK_GRAY",
+    "Color32::RED",
+    "Color32::LIGHT_RED",
+    "Color32::DARK_RED",
+    "Color32::GREEN",
+    "Color32::LIGHT_GREEN",
+    "Color32::DARK_GREEN",
+    "Color32::BLUE",
+    "Color32::LIGHT_BLUE",
+    "Color32::DARK_BLUE",
+    "Color32::YELLOW",
+    "Color32::LIGHT_YELLOW",
+    "Color32::ORANGE",
+    "Color32::GOLD",
+    "Color32::BROWN",
+    "Color32::KHAKI",
+];
+
+/// A number written in place: `255`, `0x2B`, `1.0`, `0.5_f32`.
+fn is_number(arg: &str) -> bool {
+    let a = arg.trim();
+    a.starts_with(|c: char| c.is_ascii_digit())
+        && a.chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '.')
+}
+
+/// The arguments of the call whose `(` ends at `open`, split at the
+/// commas of its own depth; `None` when the call does not close.
+fn call_args(text: &str, open: usize) -> Option<Vec<&str>> {
+    let mut depth = 0usize;
+    let mut start = open;
+    let mut args = Vec::new();
+    for (k, c) in text[open..].char_indices() {
+        let at = open + k;
+        match c {
+            '(' | '[' | '{' => depth += 1,
+            ')' | ']' | '}' => {
+                depth = depth.checked_sub(1)?;
+                if depth == 0 {
+                    args.push(&text[start..at]);
+                    return Some(args);
+                }
+            }
+            ',' if depth == 1 => {
+                args.push(&text[start..at]);
+                start = at + 1;
+            }
+            _ => {}
+        }
+        if at == open {
+            start = open + 1;
+        }
+    }
+    None
+}
+
+/// The length of the string literal that starts at `chars[i]` (`"`,
+/// `r"`, `r#"`, `b"`, `br#"`), or `None` when no string starts there.
+fn string_len(chars: &[char], i: usize) -> Option<usize> {
+    let ident = |c: char| c.is_alphanumeric() || c == '_';
+    if i > 0 && ident(chars[i - 1]) {
+        return None;
+    }
+    let mut j = i;
+    if chars.get(j) == Some(&'b') {
+        j += 1;
+    }
+    let raw = chars.get(j) == Some(&'r');
+    if raw {
+        j += 1;
+    }
+    let hashes = chars[j.min(chars.len())..]
+        .iter()
+        .take_while(|c| **c == '#')
+        .count();
+    if !raw && hashes > 0 {
+        return None;
+    }
+    j += hashes;
+    if chars.get(j) != Some(&'"') {
+        return None;
+    }
+    j += 1;
+    while j < chars.len() {
+        match chars[j] {
+            '\\' if !raw => j += 2,
+            '"' if chars[j + 1..].iter().take(hashes).all(|c| *c == '#')
+                && chars.len() > j + hashes =>
+            {
+                return Some(j + 1 + hashes - i);
+            }
+            _ => j += 1,
+        }
+    }
+    Some(chars.len() - i)
+}
+
+/// The length of the char literal that starts at `chars[i]` (`'a'`,
+/// `'\''`, `'"'`, `'\u{2F}'`), or `None` for a lifetime or a label.
+fn char_len(chars: &[char], i: usize) -> Option<usize> {
+    match (chars.get(i + 1), chars.get(i + 2)) {
+        (Some('\\'), Some(_)) => {
+            let end = chars.get(i + 3..)?.iter().position(|c| *c == '\'')?;
+            Some(end + 4)
+        }
+        (Some(_), Some('\'')) => Some(3),
+        _ => None,
+    }
+}
+
+/// The source with its comments removed: `//` to the line end, and
+/// `/* */` blocks (nested, as Rust reads them). The newlines stay, and
+/// the text of string and char literals is kept as it is.
+fn strip_comments(text: &str) -> String {
+    let chars: Vec<char> = text.chars().collect();
+    let mut out = String::with_capacity(text.len());
+    let mut i = 0;
+    while i < chars.len() {
+        let (c, next) = (chars[i], chars.get(i + 1).copied());
+        if c == '/' && next == Some('/') {
+            while i < chars.len() && chars[i] != '\n' {
+                i += 1;
+            }
+        } else if c == '/' && next == Some('*') {
+            let mut depth = 0usize;
+            while i < chars.len() {
+                match (chars[i], chars.get(i + 1).copied()) {
+                    ('/', Some('*')) => {
+                        depth += 1;
+                        i += 2;
+                    }
+                    ('*', Some('/')) => {
+                        depth = depth.saturating_sub(1);
+                        i += 2;
+                        if depth == 0 {
+                            break;
+                        }
+                    }
+                    ('\n', _) => {
+                        out.push('\n');
+                        i += 1;
+                    }
+                    _ => i += 1,
+                }
+            }
+            out.push(' ');
+        } else if let Some(n) =
+            string_len(&chars, i).or_else(|| if c == '\'' { char_len(&chars, i) } else { None })
+        {
+            let end = (i + n).min(chars.len());
+            out.extend(&chars[i..end]);
+            i = end;
+        } else {
+            out.push(c);
+            i += 1;
+        }
+    }
+    out
+}
+
+/// The colour literals of one file. A constructor counts only when each
+/// argument is a number written in place: `from_rgb(r, g, b)` converts a
+/// colour chosen elsewhere and is not a literal. A named constant
+/// (`Color32::WHITE`) always counts. A comment does not count.
+pub(super) fn count(text: &str) -> usize {
+    let code = strip_comments(text);
+    PATTERNS
+        .iter()
+        .map(|pat| {
+            code.match_indices(pat)
+                .filter(|(i, _)| {
+                    let end = i + pat.len();
+                    if pat.ends_with('(') {
+                        call_args(&code, end - 1).is_some_and(|args| {
+                            // A trailing comma leaves one empty argument.
+                            let args: Vec<&&str> =
+                                args.iter().filter(|a| !a.trim().is_empty()).collect();
+                            !args.is_empty() && args.iter().all(|a| is_number(a))
+                        })
+                    } else {
+                        // `Color32::RED` must not count `Color32::REDDISH`-like names.
+                        !code[end..].starts_with(|c: char| c.is_ascii_alphanumeric() || c == '_')
+                    }
+                })
+                .count()
+        })
+        .sum()
+}
+
+#[test]
+fn the_counter_sees_each_form_and_skips_comments() {
+    let text = "let a = Color32::from_rgb(1, 2, 3);\n\
+                // Color32::from_rgb(9, 9, 9) in a comment\n\
+                let b = [Color32::WHITE, Color32::TRANSPARENT, Color32::from_gray(4)];\n\
+                let c = Color32::RED; let d = Color32::REDDISH;\n\
+                let e = Color32::from_rgb(\n    0x10,\n    0x20,\n    0x30,\n);\n\
+                let f = Color32::from_rgba_unmultiplied(r, g, b, ALPHA);\n\
+                let g = Color32::from_rgb(rgb.0, rgb.1, rgb.2);\n\
+                let h = Color32::from_black_alpha(170);\n";
+    assert_eq!(
+        count(text),
+        6,
+        "from_rgb, WHITE, from_gray, RED, the split from_rgb and from_black_alpha; \
+         not the comment, TRANSPARENT, REDDISH or a conversion of variables"
+    );
+}
+
+#[test]
+fn a_comment_after_code_neither_hides_nor_adds_a_literal() {
+    // The two probes of the #3990 review.
+    assert_eq!(
+        count("let c = Color32::from_rgb(1, // red\n2, 3);\n"),
+        1,
+        "a comment inside the call does not hide its numbers"
+    );
+    assert_eq!(
+        count("let x = 0; // Color32::WHITE\n"),
+        0,
+        "a colour in a comment after code does not count"
+    );
+}
+
+#[test]
+fn strings_and_char_literals_keep_their_text() {
+    assert_eq!(
+        count("let s = \"http://x\"; let c = Color32::WHITE;\n"),
+        1,
+        "a // inside a string is not a comment"
+    );
+    assert_eq!(
+        count("let s = r#\"a \"// b\"#; let c = Color32::WHITE;\n"),
+        1,
+        "nor inside a raw string"
+    );
+    assert_eq!(
+        count("let q = '\"'; let c = Color32::BLACK; let l: &'static str = \"\";\n"),
+        1,
+        "a quote char literal opens no string; a lifetime is not a char"
+    );
+    assert_eq!(
+        count("let a = /* Color32::WHITE /* nested */ */ Color32::from_gray(7);\n"),
+        1,
+        "a block comment does not count, nested or not"
+    );
+}
diff --git a/crates/ui/tests/theme_files/viewport_inks.rs b/crates/ui/tests/theme_files/viewport_inks.rs
new file mode 100644
index 000000000..e90ea9686
--- /dev/null
+++ b/crates/ui/tests/theme_files/viewport_inks.rs
@@ -0,0 +1,284 @@
+//! The viewport overlay inks are theme tokens (#1120): each built-in
+//! column keeps the colour the draw site wrote as a literal before, so
+//! the move changes no pixel, and a theme file can set each ink by name.
+//! The view cube inks follow the viewport ground, as they did before.
+//! Provenance: our own tests over our own token table and theme format.
+//!
+//! A module of the `theme_files` suite (#3187: no new test binary).
+
+use camcraft_ui::egui_app::theme::Tokens;
+use camcraft_ui::egui_app::theme_files as tf;
+use egui::Color32;
+
+/// The handle and pick inks of a token table.
+fn inks(t: &Tokens) -> [Color32; 3] {
+    [t.handle_shade, t.handle_text, t.pick_rim]
+}
+
+#[test]
+fn the_built_in_columns_keep_the_handle_and_pick_colours() {
+    // The literals of `move_handles.rs`, `turn_handles.rs` and
+    // `align_pick_viz.rs` before #1120, in both columns: the handles and
+    // the picks draw over the 3D view, whose ink does not follow the
+    // chrome's column.
+    let before = [
+        Color32::from_black_alpha(170),
+        Color32::WHITE,
+        Color32::from_rgb(245, 240, 250),
+    ];
+    assert_eq!(inks(&Tokens::DARK), before, "dark column");
+    assert_eq!(inks(&Tokens::LIGHT), before, "light column");
+}
+
+#[test]
+fn a_theme_file_sets_each_handle_and_pick_ink_by_name() {
+    let text = r##"{
+        "format": "camcraft-theme/1",
+        "descriptor": { "name": "inks" },
+        "base": "dark",
+        "colors": { "handle_shade": "#10203040", "handle_text": "#FFEE00", "pick_rim": "#00FF88" }
+    }"##;
+    let theme =
+        tf::parse_text(text, "inks.json").unwrap_or_else(|e| panic!("the theme reads: {e}"));
+    assert_eq!(
+        inks(&theme.tokens),
+        [
+            Color32::from_rgba_unmultiplied(0x10, 0x20, 0x30, 0x40),
+            Color32::from_rgb(0xFF, 0xEE, 0x00),
+            Color32::from_rgb(0x00, 0xFF, 0x88),
+        ]
+    );
+    assert!(
+        theme.notes.is_empty(),
+        "each key is known: {:?}",
+        theme.notes
+    );
+    for name in ["handle_shade", "handle_text", "pick_rim"] {
+        assert!(
+            tf::COLOR_NAMES.contains(&name),
+            "{name} is a colour key of the theme format"
+        );
+    }
+}
+
+/// The view cube, marker, axis and hover inks of a token table.
+fn furniture(t: &Tokens) -> [Color32; 12] {
+    [
+        t.cube_edge,
+        t.cube_label,
+        t.cube_glyph_on,
+        t.cube_glyph_off,
+        t.viewport_hint,
+        t.marker_stem,
+        t.marker_ring,
+        t.marker_dot,
+        t.axis_x,
+        t.axis_y,
+        t.axis_z,
+        t.viewport_hover,
+    ]
+}
+
+const FURNITURE_KEYS: [&str; 12] = [
+    "cube_edge",
+    "cube_label",
+    "cube_glyph_on",
+    "cube_glyph_off",
+    "viewport_hint",
+    "marker_stem",
+    "marker_ring",
+    "marker_dot",
+    "axis_x",
+    "axis_y",
+    "axis_z",
+    "viewport_hover",
+];
+
+/// The gold of the view cube's hover dot and the machined facet's hover.
+const GOLD: Color32 = Color32::from_rgb(255, 217, 102);
+
+#[test]
+fn the_built_in_columns_keep_the_view_cube_and_marker_colours() {
+    // `ground_ink::cube_ink` before #1120: the dark set, then the light set.
+    let dark = [
+        Color32::from_white_alpha(170),
+        Color32::from_white_alpha(230),
+        Color32::WHITE,
+        Color32::from_white_alpha(160),
+        Color32::from_white_alpha(200),
+        Color32::from_gray(225),
+        Color32::from_gray(240),
+        Color32::WHITE,
+        Color32::from_rgb(245, 70, 70),
+        Color32::from_rgb(60, 220, 80),
+        Color32::from_rgb(90, 140, 255),
+        GOLD,
+    ];
+    let light = [
+        Color32::from_gray(90),
+        Color32::from_gray(20),
+        Color32::from_gray(10),
+        Color32::from_gray(60),
+        Color32::from_gray(60),
+        Color32::from_gray(50),
+        Color32::from_gray(40),
+        Color32::from_gray(20),
+        Color32::from_rgb(215, 20, 20),
+        Color32::from_rgb(0, 140, 30),
+        Color32::from_rgb(20, 70, 230),
+        GOLD,
+    ];
+    assert_eq!(furniture(&Tokens::DARK), dark, "dark column");
+    assert_eq!(furniture(&Tokens::LIGHT), light, "light column");
+}
+
+fn hex(c: Color32) -> String {
+    format!("#{:02X}{:02X}{:02X}", c.r(), c.g(), c.b())
+}
+
+fn parse(base: &str, colors: &str) -> Tokens {
+    let text = format!(
+        r#"{{"format":"camcraft-theme/1","descriptor":{{"name":"g"}},"base":"{base}","colors":{{{colors}}}}}"#
+    );
+    let theme = tf::parse_text(&text, "g.json").unwrap_or_else(|e| panic!("the theme reads: {e}"));
+    assert!(theme.notes.is_empty(), "notes: {:?}", theme.notes);
+    theme.tokens
+}
+
+#[test]
+fn the_view_cube_inks_follow_the_viewport_ground_of_a_theme_file() {
+    // Before #1120 the cube chose its set by the viewport ground. A file
+    // that turns the ground light on the dark base keeps that: each key
+    // it omits takes the light table's value.
+    let light_vp = format!(r#""viewport":"{}""#, hex(Tokens::LIGHT.viewport));
+    assert_eq!(
+        furniture(&parse("dark", &light_vp)),
+        furniture(&Tokens::LIGHT)
+    );
+    let dark_vp = format!(r#""viewport":"{}""#, hex(Tokens::DARK.viewport));
+    assert_eq!(
+        furniture(&parse("light", &dark_vp)),
+        furniture(&Tokens::DARK)
+    );
+    // A ground of the base's own lightness keeps the base's set.
+    let near = format!(
+        r#""viewport":"{}""#,
+        hex(Color32::from_rgb(0x20, 0x22, 0x26))
+    );
+    assert_eq!(furniture(&parse("dark", &near)), furniture(&Tokens::DARK));
+    // A key the file sets wins over the ground's set.
+    let both = format!(r##"{light_vp},"axis_x":"#123456""##);
+    let t = parse("dark", &both);
+    assert_eq!(t.axis_x, Color32::from_rgb(0x12, 0x34, 0x56));
+    assert_eq!(t.axis_y, Tokens::LIGHT.axis_y);
+}
+
+#[test]
+fn each_view_cube_ink_is_a_theme_key() {
+    for name in FURNITURE_KEYS {
+        assert!(
+            tf::COLOR_NAMES.contains(&name),
+            "{name} is a colour key of the theme format"
+        );
+        let t = parse("dark", &format!(r##""{name}":"#0A0B0C""##));
+        let set = furniture(&t);
+        let at = FURNITURE_KEYS
+            .iter()
+            .position(|k| *k == name)
+            .unwrap_or(usize::MAX);
+        assert_eq!(
+            set.get(at),
+            Some(&Color32::from_rgb(10, 11, 12)),
+            "{name} sets its own ink"
+        );
+    }
+}
+
+#[test]
+fn the_facet_veil_keeps_the_hover_colour_of_a_semi_transparent_token() {
+    use camcraft_ui::egui_app::ground_ink::facet_veil;
+    // The built-in gold gives the veil it gave before #1120.
+    assert_eq!(
+        facet_veil(GOLD),
+        Color32::from_rgba_unmultiplied(255, 217, 102, 90)
+    );
+    // The probe of the #3993 review: `#FF000080` gave [45, 0, 0, 90],
+    // because the stored channels are already multiplied by alpha.
+    let half_red = parse("dark", r##""viewport_hover":"#FF000080""##).viewport_hover;
+    assert_eq!(facet_veil(half_red).to_array(), [90, 0, 0, 90]);
+}
+
+/// The overlay inks of a token table, in the order of `OVERLAY_KEYS`.
+fn overlays(t: &Tokens) -> [Color32; 10] {
+    [
+        t.overlay_panel,
+        t.overlay_edge,
+        t.overlay_text,
+        t.overlay_track,
+        t.drop_veil,
+        t.empty_hint,
+        t.pick_halo,
+        t.plate_hole,
+        t.plate_dowel,
+        t.gcode_line,
+    ]
+}
+
+const OVERLAY_KEYS: [&str; 10] = [
+    "overlay_panel",
+    "overlay_edge",
+    "overlay_text",
+    "overlay_track",
+    "drop_veil",
+    "empty_hint",
+    "pick_halo",
+    "plate_hole",
+    "plate_dowel",
+    "gcode_line",
+];
+
+#[test]
+fn the_built_in_columns_keep_the_overlay_colours() {
+    // The literals of `gen_overlay.rs`, `file_drop.rs`, `shell.rs` and
+    // `pick_ink.rs` before #1120, in both columns: these draw sites did
+    // not follow the ground.
+    let before = [
+        Color32::from_black_alpha(200),
+        Color32::from_white_alpha(60),
+        Color32::WHITE,
+        Color32::from_white_alpha(40),
+        Color32::from_black_alpha(140),
+        Color32::from_white_alpha(150),
+        Color32::from_black_alpha(camcraft_ui::pick_ink::HALO_ALPHA),
+        Color32::from_rgb(230, 190, 90),
+        Color32::from_rgb(120, 200, 255),
+        Color32::from_rgb(255, 170, 60),
+    ];
+    assert_eq!(overlays(&Tokens::DARK), before, "dark column");
+    assert_eq!(overlays(&Tokens::LIGHT), before, "light column");
+    // The origin triads' outline reads the handle shadow: the same 170.
+    assert_eq!(Tokens::DARK.handle_shade, Color32::from_black_alpha(170));
+}
+
+#[test]
+fn each_overlay_ink_is_a_theme_key() {
+    for (at, name) in OVERLAY_KEYS.iter().enumerate() {
+        assert!(
+            tf::COLOR_NAMES.contains(name),
+            "{name} is a colour key of the theme format"
+        );
+        let t = parse("light", &format!(r##""{name}":"#0A0B0C""##));
+        assert_eq!(
+            overlays(&t)[at],
+            Color32::from_rgb(10, 11, 12),
+            "{name} sets its own ink"
+        );
+    }
+    // A key the file omits keeps its base value; the ground rule of
+    // the view cube inks does not touch the overlays.
+    let dark_vp = format!(r#""viewport":"{}""#, hex(Tokens::DARK.viewport));
+    assert_eq!(
+        overlays(&parse("light", &dark_vp)),
+        overlays(&Tokens::LIGHT)
+    );
+}
