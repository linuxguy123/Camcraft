+        && ribbon_tab_gap >= clamp::RIBBON_GAP.0
+        && ribbon_tab_gap <= clamp::RIBBON_GAP.1
+        && ribbon_tab_stroke >= clamp::RIBBON_STROKE.0
+        && ribbon_tab_stroke <= clamp::RIBBON_STROKE.1
