+    let skims: Vec<usize> = w.iter().enumerate().filter(|(_, l)| **l == "T85").map(|(i, _)| i).collect();
+    assert_eq!(skims.len(), 2, "{text}");
+    assert_eq!((w[skims[0] + 1], w[skims[1] + 1]), ("C002", "C903"), "{text}");
