+vendor = "Camcraft";
+legal = "Original clean-room work; public documentation and a machine owner's statements only";
+certificationLevel = 1;
+minimumRevision = 1;
+extension = "nc";
+setCodePage = "utf-8";
+capabilities = 1;          // reference contract: integer feature mask
