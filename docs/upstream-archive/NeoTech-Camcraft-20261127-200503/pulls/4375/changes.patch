+use super::contour_avoid_clip::finalize_avoid;
+use super::contour_avoid_emit::{AvoidSink, emit_band_avoid};
+use super::contour_comp;
+use super::contour_depth::{Ladder, ladder, ladder_picked, picked_law};
+use super::contour_entry::say;
+use super::contour_region::{PartRef, contour, contour_on_bodies, contour_on_part, contour_on_picked};
+use super::contour_start;
+use super::face::GenError;
+
+/// Shared finalization after one or more bands have been emitted into `b`.
+pub(super) fn finish_avoid_contour(
+    mut b: PathBuilder,
+    mut sink: AvoidSink,
+    p: &ContourParams,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    if sink.blocked_any || sink.clipped_any {
+        say(
+            &mut sink.lead_notes,
+            format!(
+                "Do not touch ({}): skipped or trimmed blocked contour portion(s); remaining path stays clear",
+                avoid.names_list()
+            ),
+        );
+    }
+    sink.lifted.say(&mut b, "ring-to-ring");
+    let path = finish_contour(b, sink.lead_notes, &sink.tally, p)?;
+    finalize_avoid(path, avoid)
+}
+
+/// [`contour`] with "Do not touch" protection across flutes, shank, and holder.
+pub fn contour_avoid(region: &Region, p: &ContourParams, avoid: &AvoidSpec) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return contour(region, p);
+    }
+    contour_impl_avoid(region, p, None, avoid)
+}
+
+/// [`contour_on_part`] with "Do not touch" protection.
+pub fn contour_on_part_avoid(
+    region: &Region,
+    part: &[Triangle],
+    p: &ContourParams,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return contour_on_part(region, part, p);
+    }
+    contour_impl_avoid(region, p, Some((part, &[], false)), avoid)
+}
+
+/// [`contour_on_bodies`] with "Do not touch" protection.
+pub fn contour_on_bodies_avoid(
+    region: &Region,
+    part: &[Triangle],
+    bodies: &[std::ops::Range<usize>],
+    p: &ContourParams,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return contour_on_bodies(region, part, bodies, p);
+    }
+    contour_impl_avoid(region, p, Some((part, bodies, false)), avoid)
+}
+
+/// [`contour_on_picked`] with "Do not touch" protection.
+pub fn contour_on_picked_avoid(
+    region: &Region,
+    part: &[Triangle],
+    bodies: &[std::ops::Range<usize>],
+    p: &ContourParams,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return contour_on_picked(region, part, bodies, p);
+    }
+    contour_impl_avoid(region, p, Some((part, bodies, true)), avoid)
+}
+
+fn contour_impl_avoid(
+    region: &Region,
+    p: &ContourParams,
+    part: Option<PartRef<'_>>,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    p.validate()?;
+    contour_comp::door(p)?;
+    let band = prepare_band(region, p)?;
+    let refs: Vec<&Loop> = band.loops.iter().collect();
+    let pick = contour_start::pick_ring(&refs, p)?;
+    let exit = contour_start::pick_exit(&refs, p)?;
+    let flat = p.ring_levels()?;
+    let r = p.tool_diameter * 0.5;
+    let d = r + p.stock_to_leave;
+    let mut sink = AvoidSink::default();
+    let lad = match part {
+        None => Ladder::uniform(&flat, band.loops.len()),
+        Some((f, bodies, true)) => {
+            ladder_picked(&band.plan, f, bodies, &flat, p.top_z, r, p.stock_to_leave, &mut sink.lead_notes)
+        }
+        Some((f, bodies, false)) => ladder(&band.plan, f, bodies, &flat, p.top_z, r, p.stock_to_leave, &mut sink.lead_notes),
+    };
+    if let Some((f, _, true)) = part {
+        picked_law(&band.plan, f, &flat, &lad, d, p.side)?;
+    }
+    if lad.zs.is_empty() {
+        return Err(GenError::Invalid(format!(
+            "every contour ring cuts into the part at its first level - nothing to machine without a gouge ({})",
+            sink.lead_notes.join("; ")
+        )));
+    }
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    emit_band_avoid(&mut b, &band, p, &lad, pick, exit, avoid, &mut sink)?;
+    let cur = b.at();
+    b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, p.clearance_z), None);
+    finish_avoid_contour(b, sink, p, avoid)
+}
diff --git a/crates/motion/src/machining2d/contour_avoid_clip.rs b/crates/motion/src/machining2d/contour_avoid_clip.rs
new file mode 100644
index 000000000..d451f8e50
--- /dev/null
+++ b/crates/motion/src/machining2d/contour_avoid_clip.rs
@@ -0,0 +1,323 @@
+//! Polyline clipping and keep-out validation helpers for 2D Contour "Do not touch" (#3344).
+//! Provenance: clean-room 2D segment-polygon clipping and sampled arc/chord verification over `geo2d::Region`; no vendor material consulted.
+
+use std::f64::consts::TAU;
+
+use camcraft_sim::verify::{AVOID_VERIFY_TOL, AvoidSpec, Warning};
+
+use crate::cl::{MoveKind, Toolpath};
+use crate::geo2d::{Point2, Region};
+
+use super::arcs::{Seg, fit_arcs_sided};
+use super::contour_entry::flatten;
+use super::face::GenError;
+use super::fillet::Legal;
+use super::ring::dist;
+use super::ContourParams;
+
+/// Epsilon for deduplicating clip parameters along a segment.
+const CLIP_PARAM_EPS: f64 = 1e-8;
+/// Minimum kept polyline arc length (mm) to emit after clipping.
+const MIN_PIECE_LEN: f64 = 1e-4;
+/// Sampling interval (mm) when validating arcs against a keep-out region.
+const CHECK_STEP: f64 = 0.02;
+/// How far (mm) a cut end steps back from the keep-out boundary. A clip
+/// end lies on that boundary, and `Region::contains` counts the boundary
+/// as inside, so an end left there reads as blocked.
+const END_TRIM: f64 = 1e-3;
+const MAX_SAMPLES: usize = 4096;
+
+/// Result of clipping a closed loop or open polyline against the outside of a keep-out region.
+pub(super) enum Clip {
+    Unclipped,
+    Pieces(Vec<Vec<Point2>>),
+    AllBlocked,
+}
+
+fn lerp(a: Point2, b: Point2, t: f64) -> Point2 {
+    Point2::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t)
+}
+
+fn poly_len(pts: &[Point2]) -> f64 {
+    pts.windows(2).map(|w| dist(w[0], w[1])).sum()
+}
+
+fn push_intersections(a: Point2, b: Point2, c: Point2, d: Point2, ts: &mut Vec<f64>) {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let (ex, ey) = (d.x - c.x, d.y - c.y);
+    let denom = dx * ey - dy * ex;
+    let ab_len2 = dx * dx + dy * dy;
+    if ab_len2 <= 1e-18 {
+        return;
+    }
+    let (cx, cy) = (c.x - a.x, c.y - a.y);
+    if denom.abs() > 1e-12 * ab_len2.sqrt() * ex.hypot(ey).max(1e-9) {
+        let t = (cx * ey - cy * ex) / denom;
+        let u = (cx * dy - cy * dx) / denom;
+        if t > CLIP_PARAM_EPS && t < 1.0 - CLIP_PARAM_EPS && (-1e-7..=1.0 + 1e-7).contains(&u) {
+            ts.push(t);
+        }
+        return;
+    }
+    // Nearly collinear: split at projections of c and d if on the same line.
+    let perp = (cx * dy - cy * dx).abs() / ab_len2.sqrt();
+    if perp <= 1e-7 {
+        for q in [c, d] {
+            let t = ((q.x - a.x) * dx + (q.y - a.y) * dy) / ab_len2;
+            if t > CLIP_PARAM_EPS && t < 1.0 - CLIP_PARAM_EPS {
+                ts.push(t);
+            }
+        }
+    }
+}
+
+/// Clip `pts` to maximal contiguous pieces whose interior lies outside `ko`.
+pub(super) fn clip_polyline(pts: &[Point2], ko: &Region, closed: bool) -> Clip {
+    if pts.len() < 2 || ko.is_empty() {
+        return Clip::Unclipped;
+    }
+    let mut segs: Vec<(Point2, Point2)> = pts.windows(2).map(|w| (w[0], w[1])).collect();
+    if closed && let (Some(&first), Some(&last)) = (pts.first(), pts.last()) && dist(first, last) > 1e-9 {
+        segs.push((last, first));
+    }
+
+    let mut pieces: Vec<Vec<Point2>> = Vec::new();
+    let mut cur: Vec<Point2> = Vec::new();
+    let mut all_kept = true;
+
+    for (a, b) in segs {
+        if dist(a, b) <= 1e-11 {
+            continue;
+        }
+        let mut ts = vec![0.0, 1.0];
+        for loop_ in ko.loops() {
+            let lp = loop_.points();
+            let n = lp.len();
+            for i in 0..n {
+                push_intersections(a, b, lp[i], lp[(i + 1) % n], &mut ts);
+            }
+        }
+        ts.sort_by(f64::total_cmp);
+        ts.dedup_by(|x, y| (*x - *y).abs() <= CLIP_PARAM_EPS);
+
+        for w in ts.windows(2) {
+            let (p0, p1) = (lerp(a, b, w[0]), lerp(a, b, w[1]));
+            if dist(p0, p1) <= 1e-9 {
+                continue;
+            }
+            let mid = Point2::new((p0.x + p1.x) * 0.5, (p0.y + p1.y) * 0.5);
+            if ko.contains(mid) {
+                all_kept = false;
+                if cur.len() >= 2 {
+                    pieces.push(std::mem::take(&mut cur));
+                } else {
+                    cur.clear();
+                }
+            } else if cur.is_empty() {
+                cur.push(p0);
+                cur.push(p1);
+            } else if let Some(&last) = cur.last()
+                && dist(last, p0) <= 1e-6
+            {
+                cur.push(p1);
+            } else {
+                if cur.len() >= 2 {
+                    pieces.push(std::mem::take(&mut cur));
+                }
+                cur.clear();
+                cur.push(p0);
+                cur.push(p1);
+            }
+        }
+    }
+    if cur.len() >= 2 {
+        pieces.push(cur);
+    }
+
+    if all_kept {
+        return Clip::Unclipped;
+    }
+    // Stitch a closed loop whose safe run wraps past vertex 0.
+    if closed
+        && pieces.len() >= 2
+        && let (Some(first_pt), Some(last_pt)) = (
+            pieces.first().and_then(|v| v.first()).copied(),
+            pieces.last().and_then(|v| v.last()).copied(),
+        )
+        && dist(first_pt, last_pt) <= 1e-6
+    {
+        let first = pieces.remove(0);
+        if let Some(last_piece) = pieces.last_mut() {
+            last_piece.extend_from_slice(&first[1..]);
+        }
+    }
+    for v in &mut pieces {
+        trim_ends(v, ko);
+    }
+    pieces.retain(|v| v.len() >= 2 && poly_len(v) > MIN_PIECE_LEN);
+    if pieces.is_empty() {
+        Clip::AllBlocked
+    } else {
+        Clip::Pieces(pieces)
+    }
+}
+
+/// Step each end of `v` that touches `ko` back along its own segment by
+/// [`END_TRIM`] (never past the segment's other point).
+fn trim_ends(v: &mut [Point2], ko: &Region) {
+    let n = v.len();
+    if n < 2 || poly_len(v) <= 2.0 * END_TRIM {
+        return;
+    }
+    let step = |end: Point2, next: Point2| {
+        let d = dist(end, next);
+        if d <= END_TRIM { end } else { lerp(end, next, END_TRIM / d) }
+    };
+    if ko.contains(v[0]) {
+        v[0] = step(v[0], v[1]);
+    }
+    if ko.contains(v[n - 1]) {
+        v[n - 1] = step(v[n - 1], v[n - 2]);
+    }
+}
+
+/// Combined legal regions `(for_cut, for_entry)` keeping outside `ko_cut` and `ko_entry`.
+pub(super) fn legal_regions(
+    base: &Region,
+    inside: bool,
+    ko_cut: &Region,
+    ko_entry: &Region,
+) -> Result<(Region, Region), GenError> {
+    if inside {
+        let cut = if ko_cut.is_empty() { base.clone() } else { base.difference(ko_cut)? };
+        let entry = if ko_entry.is_empty() { cut.clone() } else { cut.difference(ko_entry)? };
+        Ok((cut, entry))
+    } else {
+        let cut = if ko_cut.is_empty() { base.clone() } else { base.union(ko_cut)? };
+        let entry = if ko_entry.is_empty() { cut.clone() } else { cut.union(ko_entry)? };
+        Ok((cut, entry))
+    }
+}
+
+/// True when every sampled point on `(from, segs)` stays outside `ko`.
+pub(super) fn segs_clear_of(from: Point2, segs: &[Seg], ko: &Region) -> bool {
+    if ko.is_empty() {
+        return true;
+    }
+    let pt_clear = |q: Point2| q.x.is_finite() && q.y.is_finite() && !ko.contains(q);
+    if !pt_clear(from) {
+        return false;
+    }
+    let mut at = from;
+    for seg in segs {
+        match seg {
+            Seg::Line(qs) => {
+                for &q in qs {
+                    let n = ((dist(at, q) / CHECK_STEP).ceil() as usize).clamp(1, MAX_SAMPLES);
+                    for k in 1..=n {
+                        if !pt_clear(lerp(at, q, k as f64 / n as f64)) {
+                            return false;
+                        }
+                    }
+                    at = q;
+                }
+            }
+            Seg::Arc { center, ccw, to } => {
+                let rad = dist(at, *center);
+                let a0 = (at.y - center.y).atan2(at.x - center.x);
+                let a1 = (to.y - center.y).atan2(to.x - center.x);
+                let sweep = if *ccw { a1 - a0 } else { a0 - a1 }.rem_euclid(TAU);
+                if !(rad.is_finite() && sweep.is_finite()) {
+                    return false;
+                }
+                let n = ((sweep * rad / CHECK_STEP).ceil() as usize).clamp(8, MAX_SAMPLES);
+                let dir = if *ccw { 1.0 } else { -1.0 };
+                for k in 1..=n {
+                    let a = a0 + dir * sweep * k as f64 / n as f64;
+                    if !pt_clear(Point2::new(center.x + rad * a.cos(), center.y + rad * a.sin())) {
+                        return false;
+                    }
+                }
+                at = *to;
+            }
+        }
+    }
+    true
+}
+
+/// Fit arcs on `poly` and keep only those that stay outside `ko_cut` (else linear).
+pub(super) fn safe_walk(
+    poly: &[Point2],
+    p: &ContourParams,
+    legal_cut: &Legal,
+    ko_cut: &Region,
+) -> Vec<Seg> {
+    let walk = fit_arcs_sided(poly, p.tolerance, legal_cut.air_left);
+    if segs_clear_of(poly[0], &walk, ko_cut) {
+        walk
+    } else if poly.len() > 1 {
+        vec![Seg::Line(poly[1..].to_vec())]
+    } else {
+        Vec::new()
+    }
+}
+
+/// True when `(from, segs)` properly crosses any chord in `prior` at a non-shared point.
+pub(super) fn segs_cross_prior(from: Point2, segs: &[Seg], prior: &[Vec<Point2>]) -> bool {
+    if prior.is_empty() || segs.is_empty() {
+        return false;
+    }
+    let pa = flatten(from, segs);
+    let orient = |a: Point2, b: Point2, c: Point2| (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
+    let near = |u: Point2, v: Point2| dist(u, v) <= 1e-7;
+    pa.windows(2).any(|s| {
+        prior.iter().any(|pl| {
+            pl.windows(2).any(|t| {
+                if near(s[0], t[0]) || near(s[0], t[1]) || near(s[1], t[0]) || near(s[1], t[1]) {
+                    return false;
+                }
+                let (d1, d2) = (orient(s[0], s[1], t[0]), orient(s[0], s[1], t[1]));
+                let (d3, d4) = (orient(t[0], t[1], s[0]), orient(t[0], t[1], s[1]));
+                d1 * d2 < 0.0 && d3 * d4 < 0.0
+            })
+        })
+    })
+}
+
+/// True when `path` contains at least one Feed move of positive XY/Z travel.
+pub(super) fn has_cut_moves(path: &Toolpath) -> bool {
+    path.moves
+        .iter()
+        .any(|m| m.kind == MoveKind::Feed && (m.to.x != m.from.x || m.to.y != m.from.y || m.to.z != m.from.z))
+}
+
+/// Elevate rapids and run independent full-tool verification, refusing by item name if any hit persists.
+pub(super) fn finalize_avoid(mut path: Toolpath, avoid: &AvoidSpec) -> Result<Toolpath, GenError> {
+    if !has_cut_moves(&path) {
+        return Err(GenError::Invalid(format!(
+            "cannot cut clear of protected 'Do not touch' {}: no safe cutting room remains",
+            avoid.names_list()
+        )));
+    }
+    let _ = camcraft_sim::verify::elevate_rapid_links(&mut path, avoid, None, camcraft_sim::verify::AVOID_PAD);
+    match avoid.hits_named(&path, AVOID_VERIFY_TOL) {
+        Ok(hits) if hits.is_empty() => {}
+        Ok(hits) => {
+            if let Some((Warning::AvoidHit { part, short_mm, .. }, label)) = hits.first() {
+                return Err(GenError::Invalid(format!(
+                    "cannot cut clear of protected 'Do not touch' {label} ({part:?}, {short_mm:.3} mm short of {:.2} mm clearance)",
+                    avoid.clearance
+                ))
+                .with_ghost(&path));
+            }
+        }
+        Err(e) => return Err(GenError::Invalid(e).with_ghost(&path)),
+    }
+    if let Some(why) = crate::approach::refusal(&path) {
+        return Err(GenError::Invalid(why).with_ghost(&path));
+    }
+    if !path.all_finite() {
+        return Err(GenError::Invalid("path left the finite horizon".into()));
+    }
+    Ok(path)
+}
diff --git a/crates/motion/src/machining2d/contour_avoid_emit.rs b/crates/motion/src/machining2d/contour_avoid_emit.rs
new file mode 100644
index 000000000..816eb95cb
--- /dev/null
+++ b/crates/motion/src/machining2d/contour_avoid_emit.rs
@@ -0,0 +1,344 @@
+//! Closed-loop and trimmed-piece band emission for 2D Contour "Do not touch" (#3344).
+//! Provenance: clean-room per-level keep-out emission over `contour` helpers; no vendor material consulted.
+
+use camcraft_sim::verify::{AVOID_PAD, AvoidSpec};
+
+use crate::cl::PathBuilder;
+use crate::entry::Entry3D;
+use crate::geo2d::Point2;
+use crate::links::Link;
+
+use super::arcs::push_segs;
+use super::contour::{ContourParams, Lead, PreparedBand};
+use super::contour_avoid_clip::{Clip, clip_polyline, legal_regions, segs_clear_of};
+pub(super) use super::contour_avoid_piece::AvoidSink;
+use super::contour_avoid_piece::{check_pick_clear, plan_window_avoid, push_open_piece, rotate_clear_start};
+use super::contour_comp::{self, SpanCtx};
+use super::contour_depth::Ladder;
+use super::contour_entry::{Engage, crosses, flatten, say, seam_leads, wall_arc, wall_arc_top};
+use super::contour_link::{Stay, plan_links, push_stay, ring_entry, ring_link, tab_window_dive, wall_arc_hop};
+use super::contour_peck::uncut_floor;
+use super::contour_start;
+use super::contour_step::{Step, engage_level};
+use super::face::GenError;
+use super::fillet::Legal;
+use super::lead_ext::{extend_leads, retrace};
+use super::levels::{Cert, Motion};
+use super::ring::Ring;
+use super::tab_bridge::{cached, fit_tabs};
+use super::tab_clear::fit_loops;
+
+/// Emit all levels & rings of one band while keeping every move clear of `avoid`.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn emit_band_avoid(
+    b: &mut PathBuilder,
+    band: &PreparedBand,
+    p: &ContourParams,
+    lad: &Ladder,
+    pick: Option<(usize, Point2)>,
+    exit: Option<(usize, Point2)>,
+    avoid: &AvoidSpec,
+    sink: &mut AvoidSink,
+) -> Result<(), GenError> {
+    let inside = p.side == Side::Inside;
+    let m = Motion::new(p.clearance_z, Some(p.retract_z), p.feed, p.plunge_feed)
+        .with_entry(p.entry, p.helix_radius)
+        .with_arc_radius(p.tool_diameter)
+        .with_links(p.links, p.helix_radius);
+    let base_legal = band.room.as_ref().unwrap_or(&band.center);
+    let prog = &band.prog;
+    let hop = p.retract_z.min(p.clearance_z);
+    let pad = AVOID_PAD.max(p.tolerance.min(0.05) + 0.01);
+
+    let mut dives: (f64, Vec<Vec<Point2>>) = (f64::NAN, Vec::new());
+    let mut last_leads: Vec<Vec<Point2>> = Vec::new();
+    let mut prior_at_z: (f64, Vec<Vec<Point2>>) = (f64::NAN, Vec::new());
+    let mut unclipped_last: Vec<bool> = vec![false; band.loops.len()];
+
+    let is_tabbed = |z: f64| p.tab_count > 0 && z < p.bottom_z + p.tab_height;
+    let tab_levels: Vec<Vec<u64>> = (0..band.loops.len())
+        .map(|li| lad.ring(li).iter().filter(|&&z| is_tabbed(z)).map(|z| z.to_bits()).collect())
+        .collect();
+    let legal_base_only = Legal { region: base_legal, inside, air_left: Some(p.climb) };
+    let mut fits = fit_loops(&band.loops, &tab_levels, pick, p, &legal_base_only);
+    let (sched, stay) = plan_links(p, lad, &band.plan, &mut sink.lead_notes);
+
+    for (si, &(z, li)) in sched.iter().enumerate() {
+        let l = &band.loops[li];
+        let tabbed = is_tabbed(z);
+        let hop_z = if tabbed { hop.max(p.bottom_z + p.tab_height) } else { hop };
+        let same_level = si > 0 && sched[si - 1].0.to_bits() == z.to_bits();
+        if prior_at_z.0.to_bits() != z.to_bits() {
+            prior_at_z = (z, Vec::new());
+        }
+
+        let ko_cut = avoid.keepout_region(z, z, pad).map_err(GenError::Invalid)?;
+        let rz = lad.ring(li);
+        let rzi = rz.iter().position(|q| q.to_bits() == z.to_bits()).unwrap_or(0);
+        let arc_top = wall_arc_top(p, rz, rzi, hop_z);
+        let drop_hi = (if sink.first_entry || p.links.level == Link::Clearance { p.clearance_z } else { hop_z })
+            .max(arc_top)
+            .max(z);
+        let ko_entry = avoid.keepout_region(z, drop_hi, pad).map_err(GenError::Invalid)?;
+        let (cut_reg, entry_reg) = legal_regions(base_legal, inside, &ko_cut, &ko_entry)?;
+        let legal_cut = Legal { region: &cut_reg, inside, air_left: Some(p.climb) };
+        let legal_entry = Legal { region: &entry_reg, inside, air_left: Some(p.climb) };
+        let center_avoid = if ko_entry.is_empty() { band.center.clone() } else { band.center.difference(&ko_entry)? };
+        let cert_avoid = Cert::Region(&center_avoid);
+
+        let pts: Vec<Point2> = super::ring::walked(l.points(), p.climb == inside, inside);
+        let picked = pick.filter(|&(pi, _)| pi == li).map(|(_, q)| q);
+        let exit_q = exit.filter(|&(ei, _)| ei == li).map(|(_, q)| q);
+        check_pick_clear(picked, exit_q, &pts, &ko_cut, &ko_entry, avoid)?;
+
+        match clip_polyline(&pts, &ko_cut, true) {
+            Clip::AllBlocked => {
+                if prog.is_some() {
+                    return Err(contour_comp::refused_as(
+                        p,
+                        format!("cannot keep clear of protected 'Do not touch' {}: closed ring is blocked", avoid.names_list()),
+                    )
+                    .with_ghost_moves(b.moves()));
+                }
+                sink.blocked_any = true;
+                unclipped_last[li] = false;
+                continue;
+            }
+            Clip::Pieces(pieces) => {
+                if prog.is_some() {
+                    return Err(contour_comp::refused_as(
+                        p,
+                        format!("cannot keep clear of protected 'Do not touch' {}: partial trim breaks closed compensation ring", avoid.names_list()),
+                    )
+                    .with_ghost_moves(b.moves()));
+                }
+                sink.clipped_any = true;
+                unclipped_last[li] = false;
+                for piece in pieces {
+                    push_open_piece(
+                        b, &piece, z, hop_z, inside, tabbed, p, band, &legal_cut, &legal_entry,
+                        &ko_cut, &ko_entry, &center_avoid, &cert_avoid, &m, &mut prior_at_z.1, &mut dives, &mut last_leads, sink,
+                    )?;
+                }
+                continue;
+            }
+            Clip::Unclipped => {}
+        }
+
+        let seated = contour_start::seat(pts.clone(), picked, tabbed, prog.is_some(), p, &legal_entry, &mut sink.lead_notes);
+        // #3453 (as `contour::emit_band`): an untabbed level of a tabbed ring
+        // that shares no level starts at its first window.
+        let alone = !tabbed
+            && picked.is_none()
+            && band.room.is_none()
+            && !(0..band.loops.len()).any(|lj| lj != li && rz.iter().any(|&q| lad.walks(lj, q)));
+        let seated = super::tab_clear::level_start(seated, pts, fits.get(&li).filter(|_| alone && !tab_levels[li].is_empty()));
+        let seated = if picked.is_none() && !tabbed && p.lead == Lead::None && ko_entry.contains(seated[0]) {
+            match rotate_clear_start(seated.clone(), &ko_entry) {
+                Some(r) => r,
+                None => {
+                    sink.clipped_any = true;
+                    unclipped_last[li] = false;
+                    push_open_piece(
+                        b, &seated, z, hop_z, inside, tabbed, p, band, &legal_cut, &legal_entry,
+                        &ko_cut, &ko_entry, &center_avoid, &cert_avoid, &m, &mut prior_at_z.1, &mut dives, &mut last_leads, sink,
+                    )?;
+                    continue;
+                }
+            }
+        } else {
+            seated
+        };
+
+        let ap = &p.links.approach;
+        let ring = Ring::new(seated);
+        let ov = if tabbed || ap.overlap <= 0.0 {
+            0.0
+        } else if p.links.level == Link::KeepDown {
+            say(&mut sink.lead_notes, "lead: the overlap stands down under the keep-down level link - the next level descends from the seam".into());
+            0.0
+        } else {
+            ap.overlap.min(ring.len)
+        };
+        let keeps = if tabbed {
+            cached(&mut fits, li, || fit_tabs(&ring, p, picked.is_some(), &legal_entry), &mut sink.lead_notes)
+        } else {
+            vec![(0.0, ring.len)]
+        };
+
+        let stay_in = if unclipped_last[li] { stay[si] } else { None };
+        let stay_out = stay.get(si + 1).copied().flatten().is_some();
+        unclipped_last[li] = !tabbed;
+
+        for (k, &ke) in keeps.iter().enumerate() {
+            let Some(mut window) = plan_window_avoid(&ring, ke, p, &legal_cut, &legal_entry, &ko_cut, &ko_entry, &prior_at_z.1, sink) else {
+                continue;
+            };
+            if picked.is_some() && k == 0 {
+                contour_start::lead_held(p, window.0[0], &window.3)?;
+            }
+            if let Some(q) = exit_q {
+                window = contour_start::exit_at(window, q, p, &legal_entry, &mut sink.lead_notes)?;
+            } else if ov > 0.0 {
+                let (rpoly, rwalk) = retrace(&window.0, &window.1, ov);
+                let (en, li_segs, lo_segs) = seam_leads(&rwalk, &rpoly, p, &legal_entry, &mut sink.lead_notes);
+                let (en, li_segs, lo_segs) = extend_leads(en, li_segs, lo_segs, &rwalk, &rpoly, p, &legal_entry, &mut sink.lead_notes);
+                let last = rpoly[rpoly.len() - 1];
+                if !crosses(en, &li_segs, last, &lo_segs)
+                    && segs_clear_of(en, &li_segs, &ko_cut)
+                    && !ko_entry.contains(en)
+                    && segs_clear_of(last, &lo_segs, &ko_cut)
+                {
+                    window = (rpoly, rwalk, en, li_segs, lo_segs);
+                }
+            }
+            let (poly, walk, entry, mut lead, mut lead_off) = window;
+            if prog.is_some() && !segs_clear_of(entry, &lead, &ko_cut) {
+                return Err(contour_comp::refused_as(
+                    p,
+                    format!("cannot keep clear of protected 'Do not touch' {}: lead-in enters keep-out", avoid.names_list()),
+                )
+                .with_ghost_moves(b.moves()));
+            }
+            if prog.is_none() && (ko_entry.contains(entry) || !segs_clear_of(entry, &lead, &ko_cut)) {
+                lead.clear();
+            }
+            let e2 = if lead.is_empty() { poly[0] } else { Point2::new(entry.x, entry.y) };
+            if ko_entry.contains(e2) || ko_cut.contains(e2) {
+                if prog.is_some() || picked.is_some() {
+                    return Err(GenError::Invalid(format!(
+                        "cannot cut clear of protected 'Do not touch' {}: entry ({:.3}, {:.3}) is blocked",
+                        avoid.names_list(),
+                        e2.x,
+                        e2.y
+                    ))
+                    .with_ghost_moves(b.moves()));
+                }
+                sink.clipped_any = true;
+                unclipped_last[li] = false;
+                push_open_piece(
+                    b, &poly, z, hop_z, inside, tabbed, p, band, &legal_cut, &legal_entry,
+                    &ko_cut, &ko_entry, &center_avoid, &cert_avoid, &m, &mut prior_at_z.1, &mut dives, &mut last_leads, sink,
+                )?;
+                continue;
+            }
+            let here = vec![flatten(e2, &lead), flatten(poly.last().copied().unwrap_or(e2), &lead_off)];
+            let link_leads: Vec<Vec<Point2>> = std::mem::replace(&mut last_leads, here.clone()).into_iter().chain(here).collect();
+            let lf = ap.lead_feed(p.feed);
+            let lead_top = if ap.lead_height > 0.0 && !lead.is_empty() { z + ap.lead_height } else { z };
+
+            if let (Some(s), Some(&zp)) = (stay_in, rzi.checked_sub(1).and_then(|i| rz.get(i))) {
+                let ko_stay = avoid.keepout_region(z, zp, pad).map_err(GenError::Invalid)?;
+                let stay_ok = match s {
+                    Stay::Laps(_) => segs_clear_of(poly[0], &walk, &ko_stay),
+                    Stay::Plunge | Stay::Arc => !ko_stay.contains(poly[0]),
+                };
+                if stay_ok {
+                    let (_, stay_reg) = legal_regions(base_legal, inside, &ko_stay, &ko_stay)?;
+                    let legal_stay = Legal { region: &stay_reg, inside, air_left: Some(p.climb) };
+                    push_stay(b, s, &poly, &walk, zp, z, p, &legal_stay, &mut sink.lead_notes);
+                    sink.first_entry = false;
+                    push_segs(b, &walk, z, p.feed);
+                    if !stay_out {
+                        push_segs(b, &lead_off, z, p.feed);
+                    }
+                    continue;
+                }
+            }
+
+            let arm = if sink.first_entry { p.entry } else { p.links.arm(p.entry) };
+            let ring_to_ring = k == 0 && same_level && !sink.first_entry;
+            // #3830, #3917: a ring after another one is entered by the user's arm.
+            let ring_in = ring_entry(p, ring_to_ring && !tabbed, inside, rzi == 0, arm, hop_z);
+            let enter_ring = ring_in.is_some();
+            let wall_arc_on = !inside && arm == Entry3D::Arc && k == 0 && !(ring_to_ring && p.links.pass == Link::KeepDown);
+            let eng = Engage { p, center: &center_avoid, cert: &cert_avoid, plan: &band.plan, m: &m, legal: &legal_entry };
+
+            if wall_arc_on && ring_to_ring && p.links.pass == Link::Clearance {
+                wall_arc_hop(b, p, hop_z);
+            }
+            let mut arced = false;
+            if wall_arc_on && !tabbed && p.lead != Lead::None {
+                let first = lead.first().or(walk.first());
+                if wall_arc(b, &eng, e2, z, arc_top, hop_z, first).is_ok() {
+                    arced = true;
+                }
+            }
+            let linked = !arced && ring_to_ring && {
+                let cut = if dives.0.to_bits() == z.to_bits() { dives.1.as_slice() } else { &[] };
+                ring_link(b, p, &legal_cut, &[&band.plan, cut, &link_leads, &prior_at_z.1], e2, z, hop_z, tabbed, &mut sink.lifted, enter_ring)
+            };
+            if !arced && !linked {
+                if k == 0 {
+                    let prev_z = if rzi == 0 { p.clearance_z } else { rz[rzi - 1] };
+                    let arm = ring_in.as_ref().map_or(arm, |r| r.arm);
+                    let opened = rzi >= 2 || (rzi == 1 && arm == p.entry);
+                    let use_inside = inside && center_avoid.contains(e2);
+                    let step = Step {
+                        arm,
+                        e2,
+                        z,
+                        prev_z,
+                        first: sink.first_entry,
+                        opened,
+                        inside: use_inside,
+                        tabbed,
+                        lead_top,
+                        uncut: uncut_floor(p, rz, rzi),
+                        traverse: ring_in.as_ref().map(|r| r.plane),
+                    };
+                    if let Some(d) = engage_level(b, &eng, &step, &lead, &walk, &mut sink.said) {
+                        if dives.0.to_bits() != z.to_bits() {
+                            dives = (z, Vec::new());
+                        }
+                        dives.1.push(vec![d, e2]);
+                    }
+                } else {
+                    tab_window_dive(b, p, e2, hop_z, lead_top, uncut_floor(p, rz, rzi));
+                }
+            }
+            sink.first_entry = false;
+            let at = b.at();
+            let lead_at = b.moves_len();
+            if at.x == e2.x && at.y == e2.y && at.z > z {
+                super::lead_ext::push_lead_down(b, &lead, at.z, z, lf);
+            } else {
+                push_segs(b, &lead, z, lf);
+            }
+            let walk_at = b.moves_len();
+            push_segs(b, &walk, z, p.feed);
+            let out_at = b.moves_len();
+            if !stay_out {
+                let end_pt = poly[poly.len() - 1];
+                let exit_end = flatten(end_pt, &lead_off).last().copied().unwrap_or(end_pt);
+                if !segs_clear_of(end_pt, &lead_off, &ko_cut) || ko_entry.contains(exit_end) {
+                    lead_off.clear();
+                }
+                push_segs(b, &lead_off, z, p.feed);
+            }
+            if let Some(prog) = prog {
+                if walk_at == lead_at || b.moves_len() == out_at {
+                    return Err(contour_comp::refused_as(
+                        p,
+                        format!(
+                            "needs a lead-in and a lead-out clear of protected 'Do not touch' {} at ({:.3}, {:.3})",
+                            avoid.names_list(),
+                            e2.x,
+                            e2.y
+                        ),
+                    )
+                    .with_ghost_moves(b.moves()));
+                }
+                contour_comp::push_span(b, &SpanCtx { prog, p, picked }, walk_at - 1, out_at)
+                    .map_err(|e| e.with_ghost_moves(b.moves()))?;
+            }
+            let end = poly[poly.len() - 1];
+            prior_at_z.1.push(flatten(e2, &lead));
+            prior_at_z.1.push(poly);
+            prior_at_z.1.push(flatten(end, &lead_off));
+        }
+    }
+    Ok(())
+}
