@@ -0,0 +1,198 @@
+//! #4094: the G200 parameter set follows the stated control. Q395 exists
+//! only from iTNC 530 60642x-04, TNC 640 34059x-04, TNC 620 81760x-01 and
+//! TNC 320 77185x-01 (docs/research/heidenhain/differences.md B2/B3,
+//! dialects.md). #4224: PECK posts the explicit chain on each level, never
+//! a G205. #4095: the level comes from the shared dialect resolver
+//! (`drillC200`), and a control that it does not know, or that has no
+//! DIN/ISO programs, is refused by name at the program start.
+
+use super::*;
+use camcraft_post::machine::parse_mch;
+use camcraft_post::post::machine as post_machine;
+
+/// One peck hole (R on the surface: the explicit chain, #4224) and one
+/// G200 hole (drill).
+fn two_holes() -> String {
+    let mut rs = setup(3000.0);
+    let mut n = 0;
+    add_hole(&mut rs, &mut n, hole(CycleKind::Peck, 10.0, 0.0, -8.0, 4.0, 0.2, Some(150.0)), None);
+    add_hole(&mut rs, &mut n, hole(CycleKind::Drill, 30.0, 0.0, -8.0, 0.0, 0.0, Some(90.0)), None);
+    finish(&mut rs);
+    stream(&rs)
+}
+
+fn with_identity(model: &str, nc: &str) -> Value {
+    let mut m = machine(None);
+    m["controller"]["identity"] = json!({ "model": model, "nc_software": nc });
+    m
+}
+
+fn run_on(m: &Value, script: &str) -> engine::PostOutput {
+    engine::run(script, m, &two_holes()).unwrap_or_else(|e| panic!("Heidenhain engine run: {e}"))
+}
+
+const OLD_G200: &[(u16, &str)] = &[(200,"+0"),(201,"-8"),(206,"+90"),(202,"+8"),(210,"+0"),(203,"+0"),(204,"+0"),(211,"+0")];
+
+/// #4224: the peck hole is the explicit chain on each level.
+fn assert_peck_chain(out: &engine::PostOutput, what: &str) {
+    assert!(!out.program.contains("G205") && !out.program.contains("Q258"), "{what}: {}", out.program);
+    let bs = bodies(&out.program);
+    assert!(bs.iter().any(|b| b == "G00 X+10 Y+20 Z-3"), "{what}: the chip-break hop is posted: {bs:?}");
+    assert!(bs.iter().any(|b| b == "G01 X+10 Y+20 Z-8 F150"), "{what}: the last infeed is posted: {bs:?}");
+}
+
+fn assert_old_level(out: &engine::PostOutput, what: &str) {
+    assert!(out.warnings.is_empty(), "{what}: {:?}", out.warnings);
+    let bs = bodies(&out.program);
+    assert_qs(definition(&bs, "G200"), OLD_G200);
+    assert!(!out.program.contains("Q208") && !out.program.contains("Q395"), "{what}: {}", out.program);
+    assert_eq!(calls(&bs), 1, "{what}");
+    assert_peck_chain(out, what);
+}
+
+#[test]
+fn picomax_340490_03_writes_g200_without_q395_and_the_peck_chain() {
+    let mch = read("assets/machines/fehlmann-picomax55.mch");
+    let picomax = post_machine::mirror(&parse_mch(&mch).expect("the Picomax machine file"));
+    let out = run_on(&picomax, &read("assets/posts/heidenhain.cps"));
+    assert_old_level(&out, "Picomax 55, iTNC 530 340490-03");
+}
+
+#[test]
+fn controls_before_the_q395_level_write_g200_without_q395() {
+    let script = read("assets/posts/heidenhain.cps");
+    for (model, nc) in [
+        ("iTNC 530", "340490-03"),
+        ("iTNC 530", "340494-05"),
+        ("iTNC 530", "340490-08"),
+        ("iTNC 530", "340422-02"),
+        ("iTNC 530", "606420-03"),
+        ("TNC 640", "340590-02"),
+        ("TNC 620", "340560-02"),
+        ("TNC 320", "340551-06"),
+        // #4095: the resolver knows these Q211 levels too (B3).
+        ("iTNC 530", "340420-05"),
+        ("TNC 426", "280474-01"),
+        ("TNC 430", "280476-01"),
+    ] {
+        assert_old_level(&run_on(&with_identity(model, nc), &script), &format!("{model} {nc}"));
+    }
+}
+
+#[test]
+fn controls_from_the_q395_level_keep_q395() {
+    let script = read("assets/posts/heidenhain.cps");
+    for (model, nc) in [
+        ("iTNC 530", "606425-04"),
+        ("iTNC 530", "606425-04 SP8"),
+        ("TNC 640", "340595-04"),
+        ("TNC 640", "340595-11"),
+        ("TNC 620", "817600-01"),
+        ("TNC 620", "817600-18"),
+        ("TNC 320", "771851-18"),
+        ("TNC7", "817625-17"),
+    ] {
+        let out = run_on(&with_identity(model, nc), &script);
+        assert!(out.warnings.is_empty(), "{model} {nc}: {:?}", out.warnings);
+        let bs = bodies(&out.program);
+        assert!(!out.program.contains("Q208"), "{model} {nc}: {}", out.program);
+        assert_peck_chain(&out, &format!("{model} {nc}"));
+        let mut g200 = OLD_G200.to_vec();
+        g200.push((395, "+0"));
+        assert_qs(definition(&bs, "G200"), &g200);
+    }
+}
+
+#[test]
+fn an_unknown_control_or_version_is_refused_by_name() {
+    let script = read("assets/posts/heidenhain.cps");
+    for (model, nc) in [("TNC 640", "340593-03"), ("TNC 426", "280460-01"), ("TNC7", "817625-21")] {
+        assert_refused(&script, model, nc, &format!("{model} NC {nc} is not in the HEIDENHAIN dialect table"));
+    }
+    assert_refused(&script, "Sinumerik 840D", "340490-03", "\"Sinumerik 840D\" is not a HEIDENHAIN control");
+    assert_refused(&script, "TNC 128", "771841-05", "TNC 128 is a paraxial positioning control");
+    assert_refused(&script, "iTNC 530", "unknown", "is not a canonical HEIDENHAIN identifier");
+}
+
+/// #4095: DIN/ISO programs do not exist on the TNC 310 and on TNC7
+/// 81762x-16; the research does not show them on TNC 320 340 551-01 to -03
+/// (differences.md B2, "DIN/ISO programs").
+#[test]
+fn a_control_without_din_iso_programs_is_refused_by_name() {
+    let script = read("assets/posts/heidenhain.cps");
+    assert_refused(&script, "TNC 310", "286040-01", "TNC 310 NC 286040-01 (profile tnc310) has no DIN/ISO programs");
+    assert_refused(&script, "TNC7", "817625-16", "TNC7 NC 817625-16 (profile tnc7) has no DIN/ISO programs");
+    assert_refused(
+        &script,
+        "TNC 320",
+        "340551-03",
+        "TNC 320 NC 340551-03 (profile tnc320-34055x) is not known to run DIN/ISO programs",
+    );
+}
+
+/// #4095: cycle 200 before TNC 426/430 280 474 has no Q211, which the post
+/// writes: refused by name, never written without it.
+#[test]
+fn a_cycle_200_without_q211_is_refused_by_name() {
+    let out = run_on(&with_identity("TNC 426", "280472-01"), &read("assets/posts/heidenhain.cps"));
+    let why = "cycle 200 of TNC 426 NC 280472-01 (profile tnc426-472) has no Q211 (dwell at the depth), which this post writes - refused, not posted";
+    assert!(out.warnings.iter().any(|w| w.contains(why)), "{:?}", out.warnings);
+    assert!(!out.program.contains("G200"), "{}", out.program);
+}
+
+fn assert_refused(script: &str, model: &str, nc: &str, why: &str) {
+    let err = match engine::run(script, &with_identity(model, nc), &two_holes()) {
+        Ok(out) => panic!("{model} {nc:?}: posted\n{}", out.program),
+        Err(e) => e.to_string(),
+    };
+    assert!(err.contains("Heidenhain TNC: ") && err.contains(why), "{model} {nc:?}: {err}");
+}
+
+/// #4172: the NC software must be the complete canonical identifier
+/// (6 digits, "-", 2 release digits, optional " SP<n>") of a variant and a
+/// release that the research names. A prefix match never selects a level.
+/// (Outer white space is refused before, when the machine file loads.)
+#[test]
+fn a_malformed_or_unsupported_nc_identifier_is_refused_by_name() {
+    let script = read("assets/posts/heidenhain.cps");
+    for nc in ["340490-03junk", "340490-030", "340490-3", "340490-03 sp8", "606425-04 SP", "606425-04 SP0", "606425-04SP8"] {
+        assert_refused(&script, "iTNC 530", nc, "is not a canonical HEIDENHAIN identifier");
+    }
+    for (model, nc) in [("iTNC 530", "340490-00"), ("TNC 620", "817600-00")] {
+        assert_refused(&script, model, nc, "release 00 does not exist");
+    }
+    for (model, nc) in [
+        // Releases that the research does not name.
+        ("iTNC 530", "340490-09"),
+        ("iTNC 530", "606425-05"),
+        ("TNC 640", "340595-12"),
+        // Variants outside the family.
+        ("iTNC 530", "340499-03"),
+        ("iTNC 530", "340495-03"),
+        ("iTNC 530", "606426-04"),
+        ("iTNC 530", "340421-02"),
+        // A valid identifier under the wrong model.
+        ("TNC 640", "340490-03"),
+    ] {
+        assert_refused(&script, model, nc, &format!("{model} NC {nc} is not in the HEIDENHAIN dialect table"));
+    }
+}
+
+/// A depth reference that the old cycle cannot take is refused, never
+/// dropped. The CAM asks for Q395=0 today: a script variant asks for 1.
+#[test]
+fn a_q395_ask_the_340_49x_cycle_cannot_take_is_refused_by_name() {
+    let original = read("assets/posts/heidenhain.cps");
+    let script = original.replace("var DEPTH_REFERENCE = 0;", "var DEPTH_REFERENCE = 1;");
+    assert_ne!(script, original, "the variant must change the asked depth reference");
+    let out = run_on(&with_identity("iTNC 530", "340490-03"), &script);
+    assert!(
+        out.warnings.iter().any(|w| w.contains("G200 Q395=1 cannot be written for iTNC 530 NC 340490-03: its cycle 200 has no Q395")),
+        "{:?}",
+        out.warnings
+    );
+    assert!(!out.program.contains("G200"), "{}", out.program);
+    let newer = run_on(&with_identity("iTNC 530", "606425-04"), &script);
+    assert!(newer.warnings.is_empty(), "{:?}", newer.warnings);
+    assert!(definition(&bodies(&newer.program), "G200").ends_with("Q211=+0 Q395=+1"), "{}", newer.program);
+}
diff --git a/crates/post/tests/heidenhain_cycles/preset_rows.rs b/crates/post/tests/heidenhain_cycles/preset_rows.rs
new file mode 100644
index 000000000..97b51f44f
--- /dev/null
+++ b/crates/post/tests/heidenhain_cycles/preset_rows.rs
@@ -0,0 +1,87 @@
+//! #4088: the machine file states the highest work offset its control holds
+//! (`controller.work_offset_max`), and the post engine refuses a higher one by
+//! setup name. Our own design, on the installation-fact pattern of #3181.
+//! Covers camcraft_post::machine::installation, camcraft_post::post::work_offset
+//! and assets/machines/fehlmann-picomax55.mch.
+
+use camcraft_post::{
+    machine::parse_mch,
+    post::{engine, machine},
+};
+use serde_json::{Value, json};
+
+const PICOMAX: &str = include_str!("../../../../assets/machines/fehlmann-picomax55.mch");
+const POSTS: [(&str, &str); 2] = [
+    ("heidenhain.cps", include_str!("../../../../assets/posts/heidenhain.cps")),
+    ("heidenhain-klartext.cps", include_str!("../../../../assets/posts/heidenhain-klartext.cps")),
+];
+const STREAM: &str = include_str!("../klartext/contour.cnc");
+
+/// The warnings and the error of one post at work offset `n`, as one text.
+fn post(cps: &str, input: &Value, n: u32) -> Result<engine::PostOutput, String> {
+    let stream = STREAM.replace("PARAM WorkOffset 2", &format!("PARAM WorkOffset {n}"));
+    assert_ne!(stream, STREAM, "the recorded stream states WorkOffset 2");
+    engine::run(cps, input, &stream).map_err(|e| e.to_string())
+}
+
+fn refusal(cps: &str, input: &Value, n: u32) -> String {
+    match post(cps, input, n) {
+        Ok(out) => out.warnings.join("\n"),
+        Err(e) => e,
+    }
+}
+
+/// The Picomax preset table on the delivery CD has rows 0..5 (PRESET.PR), so
+/// preset 5 posts and preset 6 is refused by setup name, by both Heidenhain
+/// posts, through the raw file and through the parsed mirror.
+#[test]
+fn heidenhain_posts_refuse_a_preset_above_the_machine_preset_table() {
+    let file: Value = serde_json::from_str(PICOMAX).expect("machine file");
+    assert_eq!(file["controller"]["work_offset_max"], 5, "the Picomax states its last preset row");
+    let parsed = parse_mch(PICOMAX).expect("machine reads");
+    assert_eq!(parsed.work_offset_max, Some(5));
+    let mirrored = machine::mirror(&parsed);
+    for (name, cps) in POSTS {
+        for input in [&file, &mirrored] {
+            let at_limit = post(cps, input, 5).unwrap_or_else(|e| panic!("{name}: preset 5 must post: {e}"));
+            assert!(at_limit.warnings.is_empty(), "{name}: {:?}", at_limit.warnings);
+            let over = refusal(cps, input, 6);
+            assert!(
+                over.contains("setup Setup1: uses work offset 6") && over.contains("controller.work_offset_max"),
+                "{name}: {over}"
+            );
+        }
+    }
+}
+
+/// A machine that states no maximum keeps the post's own limit (6 for the ISO
+/// Heidenhain post), and a maximum above the post's own limit does not raise it.
+#[test]
+fn an_unstated_or_larger_machine_maximum_keeps_the_post_limit() {
+    let (name, cps) = POSTS[0];
+    let out = post(cps, &Value::Null, 6).unwrap_or_else(|e| panic!("{name}: preset 6 must post: {e}"));
+    assert!(out.warnings.is_empty(), "{name}: {:?}", out.warnings);
+    let mut file: Value = serde_json::from_str(PICOMAX).expect("machine file");
+    file["controller"]["work_offset_max"] = json!(99);
+    let mirrored = machine::mirror(&parse_mch(&file.to_string()).expect("machine reads"));
+    for input in [&file, &mirrored] {
+        let at_six = post(cps, input, 6).unwrap_or_else(|e| panic!("{name}: preset 6 must post: {e}"));
+        assert!(at_six.warnings.is_empty(), "{name}: {:?}", at_six.warnings);
+        let over = refusal(cps, input, 7);
+        assert!(over.contains("work offsets 1-6 only"), "{name}: {over}");
+    }
+}
+
+/// A malformed maximum is refused by name at the machine reader and at the raw
+/// engine, never read as no limit.
+#[test]
+fn a_malformed_work_offset_max_is_refused_by_name() {
+    for bad in [json!(0), json!(-1), json!(2.5), json!("5"), json!(1001)] {
+        let mut file: Value = serde_json::from_str(PICOMAX).expect("machine file");
+        file["controller"]["work_offset_max"] = bad.clone();
+        let read = parse_mch(&file.to_string()).expect_err("the reader refuses it");
+        assert!(read.contains("controller.work_offset_max"), "{bad}: {read}");
+        let raw = refusal(POSTS[0].1, &file, 1);
+        assert!(raw.contains("controller.work_offset_max"), "{bad}: {raw}");
+    }
+}
diff --git a/crates/post/tests/heidenhain_cycles/presets.rs b/crates/post/tests/heidenhain_cycles/presets.rs
new file mode 100644
index 000000000..f7bd1e7af
--- /dev/null
+++ b/crates/post/tests/heidenhain_cycles/presets.rs
@@ -0,0 +1,44 @@
+//! #4095: G247 Q339 selects a preset-table row only where cycle 247 has
+//! that meaning. Before iTNC 530 340 422 it sets a datum value, and the TNC
+//! 410 has no cycle 247 (docs/research/heidenhain/differences.md B2, "Cycle
+//! 247 DATUM SETTING"). The post refuses the block by name there.
+
+use super::*;
+
+fn preset_hole(model: Option<(&str, &str)>) -> engine::PostOutput {
+    let mut rs = vec![param("WorkOffset", json!(2))];
+    rs.extend(setup(3000.0));
+    let mut n = 0;
+    add_hole(&mut rs, &mut n, hole(CycleKind::Drill, 30.0, 0.0, -8.0, 0.0, 0.0, Some(90.0)), None);
+    finish(&mut rs);
+    let mut m = machine(None);
+    if let Some((model, nc)) = model {
+        m["controller"]["identity"] = json!({ "model": model, "nc_software": nc });
+    }
+    engine::run(&read("assets/posts/heidenhain.cps"), &m, &stream(&rs))
+        .unwrap_or_else(|e| panic!("Heidenhain engine run: {e}"))
+}
+
+#[test]
+fn a_preset_table_control_selects_the_row() {
+    for id in [None, Some(("iTNC 530", "340422-01")), Some(("iTNC 530", "340490-03")), Some(("TNC 640", "340595-11"))] {
+        let out = preset_hole(id);
+        assert!(out.warnings.is_empty(), "{id:?}: {:?}", out.warnings);
+        assert!(bodies(&out.program).iter().any(|b| b == "G247 Q339=2"), "{id:?}: {}", out.program);
+    }
+}
+
+#[test]
+fn g247_is_refused_where_cycle_247_is_not_a_preset_row() {
+    for (model, nc, why) in [
+        ("iTNC 530", "340420-05", "iTNC 530 NC 340420-05 (profile itnc-340420): its cycle 247 sets a datum value, not a preset-table row"),
+        ("TNC 430", "280476-01", "TNC 430 NC 280476-01 (profile tnc426-476): its cycle 247 sets a datum value, not a preset-table row"),
+        ("TNC 410", "286060-01", "TNC 410 NC 286060-01 (profile tnc410): it has no cycle 247"),
+        ("TNC 426", "280474-01", "TNC 426 NC 280474-01 (profile tnc426-474): the meaning of its cycle 247 is not known"),
+    ] {
+        let out = preset_hole(Some((model, nc)));
+        let want = format!("G247 Q339=2 (preset-table row) cannot be written for {why} - refused, not posted");
+        assert!(out.warnings.iter().any(|w| w.contains(&want)), "{model} {nc}: {:?}", out.warnings);
+        assert!(!out.program.contains("G247"), "{model} {nc}: {}", out.program);
+    }
+}
