+}
diff --git a/crates/post/tests/sodick_ln2w/offset.rs b/crates/post/tests/sodick_ln2w/offset.rs
new file mode 100644
index 000000000..74f3c9018
--- /dev/null
+++ b/crates/post/tests/sodick_ln2w/offset.rs
@@ -0,0 +1,308 @@
+//! #4076: the control-side wire offset of the Sodick LN2W wire post
+//! (`sodick-ln2w.cps`) on synthetic streams. Pins the owner's form
+//! (`G41` / `G42 Hnnn` on its own line before the lead-in, H from the pass
+//! number, `C001` with `H001`, a later pass on the condition that the
+//! operation states, `G40` on the lead-out move) and each named refusal of
+//! the shared wire-offset law (`wire_offset.rs`), and the header and section
+//! notes of an offset program (`programOffsets`).
+//! Provenance: synthetic streams from our CNC intermediate contract; the
+//! expected words are the statements of the owner of a Sodick AQ600L (LN2W)
+//! on #4076, 2026-11-25.
+//! Gate map: covers assets/posts/sodick-ln2w.cps, camcraft_post::post::wire_offset,
+//! camcraft_post::post::engine, camcraft_post::post::cnc.
+
+use camcraft_post::cl::{ArcPlane, CompSide, MoveKind};
+use camcraft_post::post::cnc::{self, MoveRec, Record};
+use camcraft_post::post::engine;
+use serde_json::{json, Value};
+
+const SCRIPT: &str = include_str!("../../../../assets/posts/sodick-ln2w.cps");
+
+fn mv(kind: MoveKind, x: f64, y: f64) -> Record {
+    Record::Move(MoveRec { kind, x, y, z: 0.0, feed: (kind == MoveKind::Feed).then_some(2.0), center: None, ccw: false, plane: ArcPlane::Xy, abc: None })
+}
+
+fn feed(x: f64, y: f64) -> Record {
+    mv(MoveKind::Feed, x, y)
+}
+
+/// A clockwise arc to `(x, y)` about `(cx, cy)`.
+fn arc(x: f64, y: f64, cx: f64, cy: f64) -> Record {
+    Record::Move(MoveRec { kind: MoveKind::Feed, x, y, z: 0.0, feed: Some(2.0), center: Some((cx, cy)), ccw: false, plane: ArcPlane::Xy, abc: None })
+}
+
+fn param(name: &str, value: Value) -> Record {
+    Record::Param { name: name.into(), value }
+}
+
+fn comp(side: Option<CompSide>, radius_mm: f64, wear: bool) -> Record {
+    Record::Comp { side, radius_mm, wear }
+}
+
+fn head(condition: &str) -> Vec<Record> {
+    vec![
+        param("OperationName", json!("Punch1")),
+        param("WorkOffset", json!("G54")),
+        param("EdmCondition", json!(condition)),
+        Record::Section { begin: true },
+        mv(MoveKind::Rapid, -22.0, 10.0),
+    ]
+}
+
+/// One pass on the control's offset: a 3 mm straight lead-in, one side
+/// of the contour, and a straight lead-out with the offset off.
+fn pass(side: CompSide, radius: f64, wear: bool) -> Vec<Record> {
+    vec![comp(Some(side), radius, wear), feed(-25.0, 10.0), feed(-25.0, -10.0), comp(None, 0.0, wear), feed(-22.0, 10.0)]
+}
+
+fn machine(extra: Value) -> Value {
+    let mut m = json!({"kind": "wire_edm", "name": "Sodick AQ600L", "edm": {"awt": true, "tank": "submerged", "flushing": "high", "skim_flushing": "low"}});
+    if let (Some(e), Some(x)) = (m["edm"].as_object_mut(), extra.as_object()) {
+        e.extend(x.clone());
+    }
+    m
+}
+
+fn run(records: &[Record]) -> engine::PostOutput {
+    run_on(json!({}), records)
+}
+
+fn run_on(extra: Value, records: &[Record]) -> engine::PostOutput {
+    engine::run(SCRIPT, &machine(extra), &cnc::serialize(records)).expect("the synthetic stream runs")
+}
+
+/// A section named `name` on `C001` that states `WireSide left`.
+fn sided(name: &str, body: Vec<Record>) -> Vec<Record> {
+    let mut r = vec![param("OperationName", json!(name)), param("WireSide", json!("left"))];
+    r.extend(head("C001").into_iter().skip(1));
+    r.extend(body);
+    r.push(Record::Section { begin: false });
+    r
+}
+
+fn words(out: &engine::PostOutput) -> Vec<&str> {
+    out.program.lines().filter(|l| !l.starts_with('(')).collect()
+}
+
+fn offset_word(out: &engine::PostOutput) -> bool {
+    words(out).iter().any(|l| l.split(' ').any(|w| w == "G41" || w == "G42" || w == "G40" || w.starts_with('H')))
+}
+
+fn refused(out: &engine::PostOutput, needles: &[&str]) {
+    assert!(
+        out.warnings.iter().any(|w| w.contains("Punch1") && needles.iter().all(|n| w.contains(n))),
+        "{needles:?} not in {:?}\n{}",
+        out.warnings,
+        out.program
+    );
+}
+
+/// The owner's example on #4076, rough cut plus one skim: `C001` with
+/// `H001`, the skim on the condition the operation states (`C007`, not a
+/// computed `C002`) with `H002`, each `G42 Hnnn` on its own line before the
+/// lead-in, and `G40` on each lead-out move. Control and wear compensation
+/// write the same words.
+#[test]
+fn a_control_side_wire_offset_posts_in_the_owners_form() {
+    for wear in [false, true] {
+        let mut r = head("C001");
+        r.extend(pass(CompSide::Right, 0.165, wear));
+        r.push(param("EdmCondition", json!("C007")));
+        r.extend(pass(CompSide::Right, 0.155, wear));
+        r.push(Record::Section { begin: false });
+        let out = run(&r);
+        assert!(out.warnings.is_empty(), "wear {wear}: {:?}", out.warnings);
+        assert_eq!(
+            words(&out),
+            [
+                "G90", "G54", "G00 X-22. Y10. U0. V0.", "Z0.", "T91", "T84", "T94",
+                "C001", "G42 H001", "G01 X-25. Y10.", "G01 X-25. Y-10.", "G40 G01 X-22. Y10.",
+                "T85", "C007", "G42 H002", "G01 X-25. Y10.", "G01 X-25. Y-10.", "G40 G01 X-22. Y10.",
+                "T90", "M02",
+            ],
+            "wear {wear}:\n{}",
+            out.program
+        );
+        // The operator's note names the register, its condition and the stated value.
+        assert!(out.program.contains("H001") && out.program.contains("0.165 MM"), "{}", out.program);
+    }
+    // The left side is G41.
+    let mut r = head("C001");
+    r.extend(pass(CompSide::Left, 0.165, false));
+    r.push(Record::Section { begin: false });
+    let out = run(&r);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(words(&out).contains(&"G41 H001"), "{}", out.program);
+}
+
+/// The lead-in must be at least the offset radius long (the owner's rule,
+/// as for a mill cutter): a shorter one is refused by name, and no offset
+/// word or cut is written.
+#[test]
+fn a_lead_in_shorter_than_the_wire_radius_is_refused_by_name() {
+    let mut r = head("C001");
+    r.extend([comp(Some(CompSide::Right), 0.165, false), feed(-22.1, 10.0), feed(-22.1, -10.0), comp(None, 0.0, false), feed(-22.0, 10.0)]);
+    r.push(Record::Section { begin: false });
+    let out = run(&r);
+    refused(&out, &["lead-in", "0.1 mm", "0.165 mm"]);
+    assert!(!offset_word(&out) && !words(&out).iter().any(|l| l.starts_with("G01")), "{}", out.program);
+    // Exactly the radius is long enough.
+    let mut r = head("C001");
+    r.extend([comp(Some(CompSide::Right), 0.165, false), feed(-22.165, 10.0), feed(-22.165, -10.0), comp(None, 0.0, false), feed(-22.0, 10.0)]);
+    r.push(Record::Section { begin: false });
+    let out = run(&r);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+}
+
+/// The lead-in and the lead-out are straight moves: an arc that would
+/// engage or cancel the offset is refused by name.
+#[test]
+fn an_arc_lead_in_or_lead_out_is_refused_by_name() {
+    let mut r = head("C001");
+    r.extend([comp(Some(CompSide::Right), 0.165, false), feed(-25.0, 10.0), arc(-25.0, -10.0, -25.0, 0.0)]);
+    r.extend([comp(None, 0.0, false), arc(-22.0, 10.0, -22.0, 0.0), Record::Section { begin: false }]);
+    let out = run(&r);
+    refused(&out, &["lead-out", "straight"]);
+    assert!(!words(&out).iter().any(|l| l.contains("G40")), "{}", out.program);
+
+    let mut r = head("C001");
+    r.extend([feed(-23.0, 10.0), comp(Some(CompSide::Right), 0.165, false), arc(-25.0, 10.0, -24.0, 10.0)]);
+    r.extend([comp(None, 0.0, false), feed(-22.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&r);
+    refused(&out, &["lead-in", "straight"]);
+    assert!(!offset_word(&out), "{}", out.program);
+}
+
+/// H001 always goes with C001 on this control: a first pass on another
+/// condition is refused by name, never posted with a register of a
+/// different condition.
+#[test]
+fn a_first_offset_pass_on_a_condition_other_than_c001_is_refused_by_name() {
+    let mut r = head("C110");
+    r.extend(pass(CompSide::Right, 0.165, false));
+    r.push(Record::Section { begin: false });
+    let out = run(&r);
+    refused(&out, &["H001", "C001", "C110"]);
+    assert!(!offset_word(&out), "{}", out.program);
+}
+
+/// A section that ends with the offset on would leave G41 / G42 modal for
+/// the next cut: refused by name.
+#[test]
+fn a_section_that_ends_with_the_offset_on_is_refused_by_name() {
+    let mut r = head("C001");
+    r.extend([comp(Some(CompSide::Right), 0.165, false), feed(-25.0, 10.0), feed(-25.0, -10.0), Record::Section { begin: false }]);
+    let out = run(&r);
+    refused(&out, &["ends with the wire offset on", "G40"]);
+}
+
+/// The C000 approach option cuts the lead-in on C000, but H001 goes with
+/// C001: the two together are refused by name.
+#[test]
+fn the_approach_condition_with_a_wire_offset_is_refused_by_name() {
+    let mut r = head("C001");
+    r.extend(pass(CompSide::Right, 0.165, false));
+    r.push(Record::Section { begin: false });
+    let out = engine::run_with(SCRIPT, &machine(json!({})), &cnc::serialize(&r), &json!({"approachCondition": true}));
+    let out = out.expect("the synthetic stream runs");
+    refused(&out, &["C000", "wire offset"]);
+    assert!(!offset_word(&out), "{}", out.program);
+}
+
+/// The lead-out that cancels the offset gets the rule of the lead-in (PR
+/// #4139 review, finding 1): on a move of no length, or one shorter than
+/// the radius, the control puts the wire centre on the contour inside the
+/// part. Each is refused by name and no `G40` block is written. A lead-out
+/// of exactly the radius posts.
+#[test]
+fn a_lead_out_shorter_than_the_wire_radius_is_refused_by_name() {
+    for (end, needles) in [((-25.0, -10.0), ["lead-out", "no length", ""]), ((-25.0, -10.01), ["lead-out", "0.01 mm", "0.165 mm"])] {
+        let mut r = head("C001");
+        r.extend([comp(Some(CompSide::Right), 0.165, false), feed(-25.0, 10.0), feed(-25.0, -10.0), comp(None, 0.0, false), feed(end.0, end.1)]);
+        r.push(Record::Section { begin: false });
+        let out = run(&r);
+        refused(&out, &needles);
+        assert!(!words(&out).iter().any(|l| l.contains("G40")), "{}", out.program);
+        assert_eq!(words(&out).iter().filter(|l| l.starts_with("G01")).count(), 2, "{}", out.program);
+    }
+    let mut r = head("C001");
+    r.extend([comp(Some(CompSide::Right), 0.165, false), feed(-25.0, 10.0), feed(-25.0, -10.0), comp(None, 0.0, false), feed(-25.0, -10.165)]);
+    r.push(Record::Section { begin: false });
+    let out = run(&r);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(words(&out).contains(&"G40 G01 X-25. Y-10.165"), "{}", out.program);
+}
+
+/// The notes are true for an offset program (finding 2). The header does
+/// not say "NO WIRE OFFSET", and a section on the control's offset does
+/// not say that the kerf is in the path or that the kerf uses the row's
+/// gap. A section without a `COMP` record keeps its wire-centre notes, and
+/// a program without one keeps the old header line.
+#[test]
+fn the_notes_of_an_offset_program_state_the_offset() {
+    let table = json!({"conditions": [{"id": "C001", "gap": 0.04, "notes": ""}]});
+    let centre = vec![feed(-25.0, 10.0), feed(-22.0, 10.0)];
+    const OLD: [&str; 3] = [
+        "(WIRE-CENTRE PATH - NO WIRE OFFSET G41 G42 IS USED)",
+        "(SIDE LEFT - KERF IN THE PATH)",
+        "(CONDITION C001 KERF GAP 0.040 MM - COMPARE WITH THE CONTROL ROW)",
+    ];
+    // No COMP record: the three old lines, and no word of an H register.
+    let out = run_on(table.clone(), &sided("Punch1", centre.clone()));
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(OLD.iter().all(|l| out.program.lines().any(|p| p == *l)), "{}", out.program);
+    assert!(!out.program.contains("H REGISTER"), "{}", out.program);
+
+    // A wire-centre section, then a section on the control's offset.
+    let mut r = sided("Punch1", centre);
+    r.extend(sided("Punch2", pass(CompSide::Right, 0.165, false)));
+    let out = run_on(table.clone(), &r);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let (first, second) = out.program.split_once("(Punch2").expect("the second section's note");
+    assert!(!first.contains("NO WIRE OFFSET") && first.contains("(WIRE OFFSET G41 G42 IS USED IN EACH SECTION THAT NAMES AN H REGISTER"), "{first}");
+    assert!(OLD[1..].iter().all(|l| first.contains(l)), "{first}");
+    assert!(!second.contains("KERF IN THE PATH") && !second.contains("COMPARE WITH THE CONTROL ROW"), "{second}");
+    assert!(second.contains("(WIRE OFFSET G41 G42 IN THIS SECTION - THE PATH IS THE PART CONTOUR WITHOUT THE KERF)"), "{second}");
+    assert!(second.contains("(SIDE LEFT - THE CONTROL WIRE OFFSET SETS THE KERF)"), "{second}");
+    assert!(second.contains("(CONDITION C001 - THE MACHINE FILE GAP 0.040 MM IS NOT IN THE PATH - THE H REGISTER AT THE CONTROL SETS THE KERF)"), "{second}");
+
+    // Wear: the path is the wire-centre path, so the kerf notes stay.
+    let out = run_on(table, &sided("Punch1", pass(CompSide::Right, 0.01, true)));
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(!out.program.contains("NO WIRE OFFSET") && OLD[1..].iter().all(|l| out.program.contains(l)), "{}", out.program);
+    assert!(out.program.contains("(WIRE OFFSET G41 G42 IN THIS SECTION - THE H REGISTER HOLDS THE WEAR DELTA ONLY)"), "{}", out.program);
+}
+
+/// A `COMP` record that changes the side while the offset is on is refused
+/// by name (finding 4), and no word is written after it.
+#[test]
+fn a_change_of_side_while_the_offset_is_on_is_refused_by_name() {
+    let mut r = head("C001");
+    r.extend([comp(Some(CompSide::Right), 0.165, false), feed(-25.0, 10.0), comp(Some(CompSide::Left), 0.165, false)]);
+    r.extend([feed(-25.0, -10.0), comp(None, 0.0, false), feed(-22.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&r);
+    refused(&out, &["changes to left while it is on", "G40"]);
+    let w = words(&out);
+    assert_eq!(w.iter().filter(|l| l.starts_with("G01")).count(), 1, "{}", out.program);
+    assert!(!w.iter().any(|l| l.contains("G41") || l.contains("G40")), "{}", out.program);
+}
+
+/// The H register is H001 to H999 (finding 4): pass 999 posts `H999`, and
+/// pass 1000 is refused by name with no register word.
+#[test]
+fn a_pass_above_h999_is_refused_by_name() {
+    let mut r = head("C001");
+    for n in 0..1000 {
+        if n > 0 {
+            r.push(param("EdmCondition", json!("C007")));
+        }
+        r.extend(pass(CompSide::Right, 0.165, false));
+    }
+    r.push(Record::Section { begin: false });
+    let out = run(&r);
+    refused(&out, &["pass 1000", "H001 to H999"]);
+    let w = words(&out);
+    assert!(w.contains(&"G42 H999"), "no H999");
+    assert_eq!(w.iter().filter(|l| l.starts_with("G42")).count(), 999);
+    assert!(!w.iter().any(|l| l.contains("H000") || l.contains("H1000")));
+}
diff --git a/crates/post/tests/sodick_ln2w/pins.rs b/crates/post/tests/sodick_ln2w/pins.rs
new file mode 100644
index 000000000..470c6f36c
--- /dev/null
+++ b/crates/post/tests/sodick_ln2w/pins.rs
@@ -0,0 +1,155 @@
+//! #4045: the Sodick LN2W wire post (`sodick-ln2w.cps`) on synthetic
+//! streams. Pins the start sequence that the owner of an AQ600L gave, the
+//! absence of a unit word (the control alarms on G21), the refusal of each
+//! taper (#4075), the skim flushing and each named refusal.
+//! Provenance: synthetic streams from our CNC intermediate contract; the
+//! expected words are the owner's statements and the LN manual facts that
+//! docs/decisions/4045-sodick-ln2w-dialect.md records.
+//! Gate map: covers assets/posts/sodick-ln2w.cps, camcraft_post::post::engine,
+//! camcraft_post::post::cnc.
+
+use camcraft_post::cl::{ArcPlane, MoveKind};
+use camcraft_post::post::cnc::{self, MoveRec, Record};
+use camcraft_post::post::engine;
+use serde_json::{json, Value};
+
+const SCRIPT: &str = include_str!("../../../../assets/posts/sodick-ln2w.cps");
+
+fn mv(kind: MoveKind, x: f64, y: f64) -> Record {
+    Record::Move(MoveRec { kind, x, y, z: 0.0, feed: (kind == MoveKind::Feed).then_some(2.0), center: None, ccw: false, plane: ArcPlane::Xy, abc: None })
+}
+
+fn param(name: &str, value: Value) -> Record {
+    Record::Param { name: name.into(), value }
+}
+
+/// The section's opening params; `wire` holds the taper params.
+fn head(wire: &[(&str, Value)]) -> Vec<Record> {
+    let mut r = vec![param("OperationName", json!("Punch1")), param("WorkOffset", json!("G54")), param("EdmCondition", json!("C001"))];
+    r.extend(wire.iter().map(|(n, v)| param(n, v.clone())));
+    r.extend([Record::Section { begin: true }, mv(MoveKind::Rapid, -22.0, 10.0)]);
+    r
+}
+
+fn machine(extra: Value) -> Value {
+    let mut m = json!({"kind": "wire_edm", "name": "Sodick AQ600L", "edm": {"awt": true, "tank": "submerged", "flushing": "high", "skim_flushing": "low"}});
+    if let (Some(e), Some(x)) = (m["edm"].as_object_mut(), extra.as_object()) {
+        e.extend(x.clone());
+    }
+    m
+}
+
+fn run(machine: &Value, records: &[Record]) -> engine::PostOutput {
+    engine::run(SCRIPT, machine, &cnc::serialize(records)).expect("the synthetic stream runs")
+}
+
+/// The program's executable lines (no comment lines).
+fn words(out: &engine::PostOutput) -> Vec<&str> {
+    out.program.lines().filter(|l| !l.starts_with('(')).collect()
+}
+
+/// A taper of `angle` degrees: the lead-in leans, one side, the lead-out
+/// stands upright.
+fn tapered(angle: f64) -> Vec<Record> {
+    let mut r = head(&[
+        ("WireTaper", json!(angle.abs())),
+        ("WireTaperDialect", json!("angle")),
+        ("WireCorner", json!("mitre")),
+        ("WirePlane", json!(12.0)),
+    ]);
+    r.extend([
+        param("WireAngle", json!(angle)),
+        mv(MoveKind::Feed, -25.0, 10.0),
+        param("WireAngle", json!(angle)),
+        mv(MoveKind::Feed, -25.0, -10.0),
+        param("WireAngle", json!(0.0)),
+        mv(MoveKind::Feed, -22.0, 10.0),
+        Record::Section { begin: false },
+    ]);
+    r
+}
+
+#[test]
+fn the_start_sequence_is_the_owners_and_no_unit_word_is_written() {
+    let mut r = head(&[]);
+    r.extend([mv(MoveKind::Feed, -25.838, 10.0), mv(MoveKind::Feed, -22.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&machine(json!({})), &r);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert_eq!(
+        words(&out),
+        ["G90", "G54", "G00 X-22. Y10. U0. V0.", "Z0.", "T91", "T84", "T94", "C001", "G01 X-25.838 Y10.", "G01 X-22. Y10.", "T90", "M02"],
+        "{}",
+        out.program
+    );
+    for banned in ["G21", "G20", "G40", "G92", "M30"] {
+        assert!(!words(&out).iter().any(|l| l.split(' ').any(|w| w == banned)), "{banned} in\n{}", out.program);
+    }
+    assert!(out.program.contains("(SODICK LN2W WORDS - NOT VERIFIED ON A CONTROL - CHECK BEFORE CUTTING)"), "{}", out.program);
+    assert!(SCRIPT.contains("programUnits = \"mm\";"), "an inch document must be refused: no unit word can be written");
+}
+
+/// Review of PR #4065 (findings 3, 4, 6): no taper word is written. A
+/// positive or negative stream angle (a top_left or a top_right machine
+/// signs it either way), a machine that states a table height, and a
+/// 0.0004 degree angle that would round to `A0.` are each refused by name,
+/// with no TP / TN, G51 / G52, A, G50 or cut written (#4075).
+#[test]
+fn every_taper_is_refused_by_name_and_writes_no_taper_word() {
+    let taper_word = |out: &engine::PostOutput| {
+        words(out).iter().any(|l| l.starts_with("TP") || l.starts_with("TN") || l.starts_with("G5") || l.contains(" A") || l.starts_with("G01") || *l == "T91")
+    };
+    let side = |s: &str| json!({"table_to_part_bottom": 5.0, "taper_angle": {"positive": s, "corner": "mitre"}});
+    for (m, angle) in [(machine(json!({})), 3.0), (machine(side("top_right")), 3.0), (machine(side("top_right")), -3.0), (machine(json!({})), 0.0004)] {
+        let out = run(&m, &tapered(angle));
+        assert!(out.warnings.iter().any(|w| w.contains("Punch1") && w.contains("is tapered") && w.contains("#4075")), "{angle}: {:?}", out.warnings);
+        assert!(!taper_word(&out), "{angle}:\n{}", out.program);
+    }
+}
+
+#[test]
+fn a_lean_without_a_taper_section_is_refused_by_name() {
+    let cut = |out: &engine::PostOutput| words(out).iter().any(|l| l.starts_with("G01") || *l == "T91");
+    // A guide-offset (U V) stream.
+    let mut uv = head(&[("WireTaper", json!(3.0))]);
+    uv.extend([param("WireU", json!(0.6)), param("WireV", json!(0.0)), mv(MoveKind::Feed, -25.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&machine(json!({})), &uv);
+    assert!(out.warnings.iter().any(|w| w.contains("is tapered")), "{:?}", out.warnings);
+    assert!(!cut(&out), "{}", out.program);
+    // A 4-axis cut.
+    let mut four = head(&[("WireFourAxis", json!("arc length"))]);
+    four.extend([param("WireU", json!(0.6)), param("WireV", json!(0.0)), mv(MoveKind::Feed, -25.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&machine(json!({})), &four);
+    assert!(out.warnings.iter().any(|w| w.contains("is a 4-axis cut")), "{:?}", out.warnings);
+    assert!(!cut(&out), "{}", out.program);
+    // An angle word in a vertical section.
+    let mut stray = head(&[]);
+    stray.extend([param("WireAngle", json!(3.0)), mv(MoveKind::Feed, -25.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&machine(json!({})), &stray);
+    assert!(out.warnings.iter().any(|w| w.contains("an angle word") && w.contains("#4075")), "{:?}", out.warnings);
+    assert!(!words(&out).iter().any(|l| l.starts_with("G01")), "{}", out.program);
+    // A leaning (U V) move in a vertical section.
+    let mut lean = head(&[]);
+    lean.extend([param("WireU", json!(0.6)), param("WireV", json!(0.0)), mv(MoveKind::Feed, -25.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&machine(json!({})), &lean);
+    assert!(out.warnings.iter().any(|w| w.contains("writes no U V lean")), "{:?}", out.warnings);
+    assert!(!words(&out).iter().any(|l| l.starts_with("G01")), "{}", out.program);
+}
+
+#[test]
+fn a_skim_pass_takes_the_low_flushing_word_and_its_own_condition() {
+    let mut r = head(&[]);
+    r.extend([
+        mv(MoveKind::Feed, -25.0, 10.0),
+        mv(MoveKind::Feed, -22.0, 10.0),
+        param("EdmCondition", json!("C002")),
+        mv(MoveKind::Feed, -25.02, 10.0),
+        mv(MoveKind::Feed, -22.0, 10.0),
+        Record::Section { begin: false },
+    ]);
+    let out = run(&machine(json!({})), &r);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let w = words(&out);
+    let at = w.iter().position(|l| *l == "T85").expect("the skim's flushing word");
+    assert_eq!(&w[at..at + 3], ["T85", "C002", "G01 X-25.02 Y10."], "{}", out.program);
+    assert_eq!(w.iter().filter(|l| **l == "T91").count(), 1, "one threading for the section: {}", out.program);
+}
diff --git a/crates/post/tests/sodick_ln2w/taper.rs b/crates/post/tests/sodick_ln2w/taper.rs
new file mode 100644
index 000000000..e5f07eb2e
--- /dev/null
+++ b/crates/post/tests/sodick_ln2w/taper.rs
@@ -0,0 +1,253 @@
+//! #4075: a constant taper on the Sodick LN2W post, as a 4-axis program
+//! (the owner of an AQ600L, 2026-11-25): TP (the part's bottom above the
+//! worktable) and TN (its top above the worktable), G74, X Y on the part's
+//! bottom and U V = top minus bottom on every move, G75 at the end. The
+//! G51 / G52 angle form stays refused.
+//! Provenance: synthetic streams from our CNC intermediate contract
+//! (docs/CNC-INTERMEDIATE.md: WireU / WireV at the guide planes); the
+//! expected words are the owner's statements recorded on #4075.
+//! Gate map: covers assets/posts/sodick-ln2w.cps, camcraft_post::post::engine.
+
+use camcraft_post::cl::{ArcPlane, CompSide, MoveKind};
+use camcraft_post::post::cnc::{self, MoveRec, Record};
+use camcraft_post::post::engine;
+use serde_json::{json, Value};
+
+const SCRIPT: &str = include_str!("../../../../assets/posts/sodick-ln2w.cps");
+
+fn mv(kind: MoveKind, x: f64, y: f64) -> Record {
+    Record::Move(MoveRec { kind, x, y, z: 0.0, feed: (kind == MoveKind::Feed).then_some(2.0), center: None, ccw: false, plane: ArcPlane::Xy, abc: None })
+}
+
+fn param(name: &str, value: Value) -> Record {
+    Record::Param { name: name.into(), value }
+}
+
+fn machine() -> Value {
+    json!({"kind": "wire_edm", "name": "Sodick AQ600L", "edm": {"awt": true, "tank": "submerged", "flushing": "high", "skim_flushing": "low"}})
+}
+
+/// The section's opening params for `setup`: a 3 degree taper whose
+/// guides stand at Z-10 and Z90 (a 100 mm span) and whose part runs from
+/// Z0 to Z20 (work Z); `drop` leaves out the named params.
+fn head(setup: &str, drop: &[&str]) -> Vec<Record> {
+    head_at("Punch1", setup, drop, 0.0)
+}
+
+/// The same opening for operation `op`, with the cut's bottom at work Z
+/// `bottom` (two Wire Contour operations of one setup can state two).
+fn head_at(op: &str, setup: &str, drop: &[&str], bottom: f64) -> Vec<Record> {
+    let mut r = vec![param("OperationName", json!(op)), param("SetupName", json!(setup)), param("WorkOffset", json!("G54")), param("EdmCondition", json!("C001"))];
+    for (n, v) in [("WireTaper", 3.0), ("WireGuideLower", -10.0), ("WireGuideUpper", 90.0), ("WireBottom", bottom), ("WireTop", 20.0)] {
+        if !drop.contains(&n) {
+            r.push(param(n, json!(v)));
+        }
+    }
+    r.extend([Record::Section { begin: true }, mv(MoveKind::Rapid, -22.0, 10.0)]);
+    r
+}
+
+/// The lead-in leans (U5 at the upper guide, over the 100 mm span), one
+/// side, and the lead-out stands upright again.
+fn body() -> Vec<Record> {
+    vec![
+        param("WireU", json!(5.0)),
+        param("WireV", json!(0.0)),
+        mv(MoveKind::Feed, -25.0, 10.0),
+        param("WireU", json!(5.0)),
+        param("WireV", json!(0.0)),
+        mv(MoveKind::Feed, -25.0, -10.0),
+        mv(MoveKind::Feed, -22.0, 10.0),
+        Record::Section { begin: false },
+    ]
+}
+
+fn tapered(setup: &str, drop: &[&str]) -> Vec<Record> {
+    let mut r = head(setup, drop);
+    r.extend(body());
+    r
+}
+
+fn run(records: &[Record], options: &Value) -> engine::PostOutput {
+    engine::run_with(SCRIPT, &machine(), &cnc::serialize(records), options).expect("the synthetic stream runs")
+}
+
+fn words(out: &engine::PostOutput) -> Vec<&str> {
+    out.program.lines().filter(|l| !l.starts_with('(')).collect()
+}
+
+/// A program that writes no taper word and no cut.
+fn nothing_cut(out: &engine::PostOutput) -> bool {
+    !words(out).iter().any(|l| l.starts_with("TP") || l.starts_with("TN") || l.starts_with("G74") || l.starts_with("G01") || *l == "T91")
+}
+
+fn height(h: f64) -> Value {
+    json!({ "partBottomAboveTable": h })
+}
+
+/// The owner's 4-axis form: the start order of #4065, then TP TN G74,
+/// each move with X Y on the part's bottom and U V over its height, and
+/// G75 after the last cut. Slope 5 / 100: the bottom (Z0) is 10 mm above
+/// the lower guide, so X moves 0.5 toward the lean; U is 0.05 x 20 = 1.
+#[test]
+fn a_taper_posts_as_a_four_axis_program_with_tp_tn_and_uv_on_every_move() {
+    let out = run(&tapered("Setup1", &[]), &height(5.0));
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert_eq!(
+        words(&out),
+        [
+            "G90", "G54", "G00 X-22. Y10. U0. V0.", "Z0.", "T91", "T84", "T94", "C001", "TP5.", "TN25.", "G74",
+            "G01 X-24.5 Y10. U1. V0.", "G01 X-24.5 Y-10. U1. V0.", "G01 X-22. Y10. U0. V0.", "G75", "T90", "M02",
+        ],
+        "{}",
+        out.program
+    );
+    for banned in ["G51", "G52", "G50"] {
+        assert!(!words(&out).iter().any(|l| l.split(' ').any(|w| w == banned)), "{banned} in\n{}", out.program);
+    }
+}
+
+/// The lean side is the sign of U V: a top that leans to -X and +Y.
+#[test]
+fn the_lean_side_is_the_sign_of_u_and_v() {
+    let mut r = head("Setup1", &[]);
+    r.extend([param("WireU", json!(-5.0)), param("WireV", json!(2.5)), mv(MoveKind::Feed, -25.0, 10.0), mv(MoveKind::Feed, -22.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&r, &height(0.0));
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(words(&out).contains(&"G01 X-25.5 Y10.25 U-1. V0.5"), "{}", out.program);
+    assert!(words(&out).contains(&"TP0.") && words(&out).contains(&"TN20."), "{}", out.program);
+}
+
+/// TP and TN are heights above the worktable; CamCraft does not know the
+/// fixture. Unstated, the taper is refused by name and nothing is cut.
+#[test]
+fn a_taper_without_the_table_height_is_refused_by_name() {
+    for options in [Value::Null, height(-1.0)] {
+        let out = run(&tapered("Setup1", &[]), &options);
+        assert!(
+            out.warnings.iter().any(|w| w.contains("Punch1") && w.contains("is tapered") && w.contains("partBottomAboveTable") && w.contains("#4075")),
+            "{options}: {:?}",
+            out.warnings
+        );
+        assert!(nothing_cut(&out), "{options}:\n{}", out.program);
+    }
+}
+
+/// A stream that states no guide planes or no part planes cannot be
+/// converted: refused by name, never written from the guide planes.
+#[test]
+fn a_taper_stream_without_its_planes_is_refused_by_name() {
+    for drop in ["WireGuideLower", "WireGuideUpper", "WireBottom", "WireTop"] {
+        let out = run(&tapered("Setup1", &[drop]), &height(5.0));
+        assert!(out.warnings.iter().any(|w| w.contains("is tapered") && w.contains(drop)), "{drop}: {:?}", out.warnings);
+        assert!(nothing_cut(&out), "{drop}:\n{}", out.program);
+    }
+}
+
+/// One option states one table height: tapers from two setups are refused.
+#[test]
+fn tapers_from_two_setups_are_refused_by_name() {
+    let mut r = tapered("Setup1", &[]);
+    r.extend(tapered("Setup2", &[]));
+    let out = run(&r, &height(5.0));
+    assert!(out.warnings.iter().any(|w| w.contains("Setup2") && w.contains("Setup1") && w.contains("one table height")), "{:?}", out.warnings);
+}
+
+/// Two tapered cuts of `Setup1`, operations `First` then `Second`, with
+/// their bottoms at the two given work Z; the top of each is Z20.
+fn two_bottoms(first: f64, second: f64) -> Vec<Record> {
+    let mut r = head_at("First", "Setup1", &[], first);
+    r.extend(body());
+    r.extend(head_at("Second", "Setup1", &[], second));
+    r.extend(body());
+    r
+}
+
+/// The lines of operation `op`'s section: from its name note to its T90.
+fn section<'a>(out: &'a engine::PostOutput, op: &str) -> Vec<&'a str> {
+    let all: Vec<&str> = out.program.lines().collect();
+    let from = all.iter().position(|l| *l == format!("({op})")).unwrap_or_else(|| panic!("no section {op} in\n{}", out.program));
+    let len = all[from..].iter().position(|l| *l == "T90").unwrap_or_else(|| panic!("section {op} has no T90 in\n{}", out.program));
+    all[from..from + len].to_vec()
+}
+
+/// A section's words from its TP word on.
+fn cut<'a>(lines: &[&'a str]) -> Vec<&'a str> {
+    lines.iter().filter(|l| !l.starts_with('(')).skip_while(|l| !l.starts_with("TP")).copied().collect()
+}
+
+/// X Y are on each section's own bottom, so TP follows it (the review of
+/// PR #4171): the option states the first taper's bottom above the
+/// worktable, and a cut that starts 8 mm higher gets TP + 8. TN is the
+/// same top for the two (5 + 20). The second cut's bottom is 18 mm above
+/// the lower guide: X moves 0.05 x 18 = 0.9, and U is 0.05 x 12 = 0.6.
+/// Each section note names the work Z that its TP stands for.
+#[test]
+fn tp_follows_each_tapered_sections_own_bottom() {
+    let out = run(&two_bottoms(0.0, 8.0), &height(5.0));
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let (first, second) = (section(&out, "First"), section(&out, "Second"));
+    assert_eq!(cut(&first), ["TP5.", "TN25.", "G74", "G01 X-24.5 Y10. U1. V0.", "G01 X-24.5 Y-10. U1. V0.", "G01 X-22. Y10. U0. V0.", "G75"], "{}", out.program);
+    assert_eq!(cut(&second), ["TP13.", "TN25.", "G74", "G01 X-24.1 Y10. U0.6 V0.", "G01 X-24.1 Y-10. U0.6 V0.", "G01 X-22. Y10. U0. V0.", "G75"], "{}", out.program);
+    assert!(first.iter().any(|l| l.contains("TP 5. IS WORK Z0. ABOVE THE WORKTABLE") && l.contains("THE POST OPTION STATES WORK Z0. AT 5.")), "{}", out.program);
+    assert!(second.iter().any(|l| l.contains("TP 13. IS WORK Z8. ABOVE THE WORKTABLE") && l.contains("THE POST OPTION STATES WORK Z0. AT 5.")), "{}", out.program);
+    // The reverse order: the option names the first cut's bottom (work Z8),
+    // and the later, lower cut gets TP - 8.
+    let out = run(&two_bottoms(8.0, 0.0), &height(8.0));
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert_eq!(cut(&section(&out, "First"))[..2], ["TP8.", "TN20."], "{}", out.program);
+    assert_eq!(cut(&section(&out, "Second"))[..2], ["TP0.", "TN20."], "{}", out.program);
+    assert!(section(&out, "Second").iter().any(|l| l.contains("TP 0. IS WORK Z0. ABOVE THE WORKTABLE") && l.contains("THE POST OPTION STATES WORK Z8. AT 8.")), "{}", out.program);
+}
+
+/// A later cut whose bottom is below the worktable by the stated option is
+/// refused by name, and no word of it is written.
+#[test]
+fn a_tapered_section_below_the_worktable_is_refused_by_name() {
+    let out = run(&two_bottoms(8.0, 0.0), &height(5.0));
+    assert!(
+        out.warnings.iter().any(|w| w.contains("Second") && w.contains("is tapered") && w.contains("below the worktable") && w.contains("work Z8.") && w.contains("partBottomAboveTable")),
+        "{:?}",
+        out.warnings
+    );
+    assert_eq!(words(&out).iter().filter(|l| l.starts_with("TP")).copied().collect::<Vec<_>>(), ["TP5."], "{}", out.program);
+    assert_eq!(words(&out).iter().filter(|l| **l == "G74" || **l == "T91").count(), 2, "{}", out.program);
+}
+
+/// What the 4-axis form does not write is refused by name: an arc, and
+/// the control's wire offset under a taper.
+#[test]
+fn an_arc_or_a_wire_offset_in_a_taper_is_refused_by_name() {
+    let mut arc = head("Setup1", &[]);
+    arc.extend([
+        mv(MoveKind::Feed, -25.0, 10.0),
+        Record::Move(MoveRec { kind: MoveKind::Feed, x: -25.0, y: -10.0, z: 0.0, feed: Some(2.0), center: Some((-25.0, 0.0)), ccw: false, plane: ArcPlane::Xy, abc: None }),
+        mv(MoveKind::Feed, -22.0, 10.0),
+        Record::Section { begin: false },
+    ]);
+    let out = run(&arc, &height(5.0));
+    assert!(out.warnings.iter().any(|w| w.contains("Punch1") && w.contains("an arc in a tapered cut")), "{:?}", out.warnings);
+    assert!(!words(&out).iter().any(|l| l.starts_with("G02") || l.starts_with("G03")), "{}", out.program);
+    let mut comp = head("Setup1", &[]);
+    comp.extend([
+        Record::Comp { side: Some(CompSide::Right), radius_mm: 0.165, wear: false },
+        mv(MoveKind::Feed, -25.0, 10.0),
+        mv(MoveKind::Feed, -25.0, -10.0),
+        Record::Comp { side: None, radius_mm: 0.0, wear: false },
+        mv(MoveKind::Feed, -22.0, 10.0),
+        Record::Section { begin: false },
+    ]);
+    let out = run(&comp, &height(5.0));
+    assert!(out.warnings.iter().any(|w| w.contains("Punch1") && w.contains("wire offset") && w.contains("taper")), "{:?}", out.warnings);
+    assert!(!words(&out).iter().any(|l| l.starts_with("G41") || l.starts_with("G42") || l.starts_with("G74")), "{}", out.program);
+}
+
+/// The section must stand the wire upright before G75: a cut that ends
+/// leaning is refused by name.
+#[test]
+fn a_taper_that_ends_leaning_is_refused_by_name() {
+    let mut r = head("Setup1", &[]);
+    r.extend([param("WireU", json!(5.0)), param("WireV", json!(0.0)), mv(MoveKind::Feed, -25.0, 10.0), Record::Section { begin: false }]);
+    let out = run(&r, &height(5.0));
+    assert!(out.warnings.iter().any(|w| w.contains("Punch1") && w.contains("ends with the wire leaning")), "{:?}", out.warnings);
+}
