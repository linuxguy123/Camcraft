+            Self::D | Self::K => 55.0,
+            Self::E => 75.0,
+            Self::H => 120.0,
+            Self::L | Self::S => 90.0,
+            Self::M => 86.0,
+            Self::O => 135.0,
+            Self::P => 108.0,
+            Self::T => 60.0,
