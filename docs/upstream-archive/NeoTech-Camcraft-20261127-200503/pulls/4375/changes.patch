+    assert_eq!(w.iter().filter(|l| l.contains("U0.")).count(), 1, "U0. V0. rides the one G00 only: {text}");
+    assert!(!w.iter().any(|l| l.split(' ').any(|x| matches!(x, "G20" | "G21" | "G40" | "G92"))), "{text}");
