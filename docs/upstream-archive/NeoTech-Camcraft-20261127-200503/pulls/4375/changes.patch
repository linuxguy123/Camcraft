+        && tree_pad_y <= clamp::SPACING.1
+        && tree_suffix_gap >= clamp::SPACING.0
+        && tree_suffix_gap <= clamp::SPACING.1
+        && tree_header_boost >= clamp::HEADER_BOOST.0
+        && tree_header_boost <= clamp::HEADER_BOOST.1
