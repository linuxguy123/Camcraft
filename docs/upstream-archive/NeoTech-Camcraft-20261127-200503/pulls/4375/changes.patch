diff --git a/crates/post/tests/klartext/dialect_tests.rs b/crates/post/tests/klartext/dialect_tests.rs
new file mode 100644
index 000000000..bb42f9d3b
--- /dev/null
+++ b/crates/post/tests/klartext/dialect_tests.rs
@@ -0,0 +1,52 @@
+//! #4095: the Klartext post reads the shared dialect resolver. It writes
+//! L M140 MB MAX, CYCL DEF 247 with Q339 (a preset-table row) and M137, so a
+//! profile that does not confirm one of these is refused by name. The manual
+//! quill procedure stays verified for iTNC 530 NC 340490-03 only (#4114).
+
+use super::*;
+
+fn with_identity(model: &str, nc: &str) -> String {
+    let mut machine: Value = serde_json::from_str(MCH).unwrap();
+    machine["controller"]["identity"] = serde_json::json!({ "model": model, "nc_software": nc });
+    machine.to_string()
+}
+
+#[test]
+fn the_dialect_resolver_decides_the_klartext_profile() {
+    for (model, nc, diagnostic) in [
+        (
+            "iTNC 530",
+            "340420-03",
+            "controller profile itnc-340420 (iTNC 530 NC 340420-03) does not confirm cycle 247 as a preset-table row, which this post writes",
+        ),
+        (
+            "TNC 410",
+            "286060-01",
+            "controller profile tnc410 (TNC 410 NC 286060-01) does not confirm M140 MB MAX, cycle 247 as a preset-table row, M137",
+        ),
+        ("TNC 640", "340595-11", "controller profile tnc640-d (TNC 640 NC 340595-11) does not confirm M137"),
+        (
+            "iTNC 530",
+            "340490-04",
+            "controller profile itnc-49x (iTNC 530 NC 340490-04) is not verified for the manual quill procedure",
+        ),
+        ("iTNC 530", "340490-3", "unsupported controller profile: NC software \"340490-3\" is not a canonical HEIDENHAIN identifier"),
+        ("Sinumerik 840D", "340490-03", "unsupported controller profile: controller model \"Sinumerik 840D\" is not a HEIDENHAIN control"),
+    ] {
+        let why = post(&with_identity(model, nc), STREAM, &Value::Null).expect_err(nc);
+        assert!(why.contains(diagnostic), "{model} {nc}: {why}");
+    }
+}
+
+/// The Picomax control resolves to 4 coordinate decimals (0.1 um input,
+/// profile itnc-49x): a 0.3 um step keeps its fourth decimal.
+#[test]
+fn the_picomax_profile_writes_four_decimals() {
+    let stream = STREAM.replace(
+        "Arc CCW X 100000 Y 35000 Z 9000 F 350000 I 100000 J 25000",
+        "Arc CCW X 100000 Y 35000.3 Z 9000 F 350000 I 100000 J 25000",
+    );
+    assert_ne!(stream, STREAM, "the variant must change the stream");
+    let nc = post(MCH, &stream, &Value::Null).expect("the Picomax posts");
+    assert!(nc.contains("C X+0 Y+10.0003 DR+"), "{nc}");
+}
diff --git a/crates/post/tests/linuxcnc_post.rs b/crates/post/tests/linuxcnc_post.rs
new file mode 100644
index 000000000..26d0883cd
--- /dev/null
+++ b/crates/post/tests/linuxcnc_post.rs
@@ -0,0 +1,235 @@
+//! Issue #4151: LinuxCNC post header clears G92 offsets and states G97.
+//! Issue #4152: LinuxCNC active comment guard and probe tolerance preview check.
+//!
+//! Provenance: public LinuxCNC G-code reference (linuxcnc.org/docs)
+//! for G92.1 (reset G92 offsets), G97 (constant spindle RPM mode),
+//! active comment keywords and predefined named parameters (#<_task>);
+//! no vendor materials consulted. Original clean-room tests.
+//!
+//! Gate map: covers assets/posts/linuxcnc.cps, camcraft_post::post::engine.
+
+mod recorded;
+
+use camcraft_post::cl::{Move, MoveKind, Toolpath};
+use camcraft_post::geometry::Point3;
+use camcraft_post::post::cnc::{self, MoveRec, Record};
+use camcraft_post::post::{dump, engine, Dump};
+use serde_json::{json, Value};
+use std::path::{Path, PathBuf};
+
+const LINUXCNC: &str = include_str!("../../../assets/posts/linuxcnc.cps");
+const MACHINE_JSON: &str = include_str!("../../../assets/machines/3axis-vmc.mch");
+
+fn repo(rel: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("../../").join(rel)
+}
+
+fn read(rel: &str) -> String {
+    std::fs::read_to_string(repo(rel)).unwrap_or_else(|e| panic!("{rel}: {e}"))
+}
+
+fn simple_stream() -> String {
+    cnc::serialize(&[
+        Record::Param {
+            name: "OperationName".into(),
+            value: json!("Face1"),
+        },
+        Record::Param {
+            name: "WorkOffset".into(),
+            value: json!(1),
+        },
+        Record::Param {
+            name: "ClearancePlane".into(),
+            value: json!(25.0),
+        },
+        Record::Param {
+            name: "RetractPlane".into(),
+            value: json!(10.0),
+        },
+        Record::Param {
+            name: "SpindleSpeed".into(),
+            value: json!(3000.0),
+        },
+        Record::Tool {
+            number: 1,
+            name: "10mm Endmill".into(),
+        },
+        Record::Section { begin: true },
+        Record::Move(MoveRec {
+            kind: MoveKind::Rapid,
+            x: 0.0,
+            y: 0.0,
+            z: 10.0,
+            feed: None,
+            center: None,
+            ccw: false,
+            plane: Default::default(),
+            abc: None,
+        }),
+        Record::Move(MoveRec {
+            kind: MoveKind::Feed,
+            x: 10.0,
+            y: 0.0,
+            z: -1.0,
+            feed: Some(500.0),
+            center: None,
+            ccw: false,
+            plane: Default::default(),
+            abc: None,
+        }),
+        Record::Section { begin: false },
+    ])
+}
+
+fn post_stream(stream: &str) -> String {
+    let out = engine::run_with(LINUXCNC, &Value::Null, stream, &json!({ "retractMode": "g28" }))
+        .expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    out.program
+}
+
+#[test]
+fn header_clears_g92_and_states_g97_by_default() {
+    let cps = read("assets/posts/linuxcnc.cps");
+    let mch = json!({ "name": "LinuxCNC Mill", "safeRetractZ": 50.0 });
+    let stream = simple_stream();
+
+    let out = engine::run(&cps, &mch, &stream).expect("post run");
+    let nc = &out.program;
+
+    // Must emit G92.1 and G97 in the header modal safety block
+    let header_line = nc
+        .lines()
+        .find(|l| l.contains("G21") && l.contains("G17"))
+        .expect("modal header block");
+
+    assert!(
+        header_line.contains("G92.1"),
+        "header must clear G92 offsets: {header_line}"
+    );
+    assert!(
+        header_line.contains("G97"),
+        "header must state G97 constant RPM mode: {header_line}"
+    );
+
+    // G92.1 and G97 must appear before the first spindle start S3000 M3
+    let s_pos = nc.find("S3000 M3").expect("spindle start block");
+    let g92_pos = nc.find("G92.1").expect("G92.1 in nc");
+    let g97_pos = nc.find("G97").expect("G97 in nc");
+
+    assert!(g92_pos < s_pos, "G92.1 must precede spindle start");
+    assert!(g97_pos < s_pos, "G97 must precede spindle start");
+}
+
+#[test]
+fn header_omits_g92_1_when_clearg92_option_is_false() {
+    let cps = read("assets/posts/linuxcnc.cps");
+    let mch = json!({ "name": "LinuxCNC Mill", "safeRetractZ": 50.0 });
+    let stream = simple_stream();
+    let options = json!({ "clearG92": false });
+
+    let out = engine::run_with(&cps, &mch, &stream, &options).expect("post run");
+    let nc = &out.program;
+
+    let header_line = nc
+        .lines()
+        .find(|l| l.contains("G21") && l.contains("G17"))
+        .expect("modal header block");
+
+    assert!(
+        !header_line.contains("G92.1"),
+        "G92.1 must be omitted when clearG92 is false: {header_line}"
+    );
+    assert!(
+        header_line.contains("G97"),
+        "G97 must still be emitted: {header_line}"
+    );
+}
+
+#[test]
+fn header_includes_g92_1_when_clearg92_option_is_true() {
+    let cps = read("assets/posts/linuxcnc.cps");
+    let mch = json!({ "name": "LinuxCNC Mill", "safeRetractZ": 50.0 });
+    let stream = simple_stream();
+    let options = json!({ "clearG92": true });
+
+    let out = engine::run_with(&cps, &mch, &stream, &options).expect("post run");
+    let nc = &out.program;
+
+    let header_line = nc
+        .lines()
+        .find(|l| l.contains("G21") && l.contains("G17"))
+        .expect("modal header block");
+
+    assert!(
+        header_line.contains("G92.1"),
+        "G92.1 must be emitted when clearG92 is true: {header_line}"
+    );
+    assert!(
