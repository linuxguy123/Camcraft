@@ -0,0 +1,335 @@
+//! The user's start and exit points on Deburr's edge chains (#3329, the
+//! Deburr slice of #1448). The chains and their cut geometry stay the
+//! automatic ride's; a pick only chooses the order:
+//!
+//! - **Start:** the chain nearest the start pick is cut first. An open
+//!   chain starts at its end nearest the pick (it runs the other way
+//!   when that is its far end). A closed chain is re-seated: it starts
+//!   and ends at its point nearest the pick.
+//! - **Exit:** the chain nearest the exit pick is cut last. An open
+//!   chain ends at its end nearest the pick. A closed chain is re-seated
+//!   at its point nearest the pick, so its lap ends there. When the start
+//!   and the exit are on one closed chain, the chain starts at the start
+//!   point, cuts its whole lap and runs on along its own edges to the
+//!   exit point (a re-trace of cut material, never a new cut).
+//! - The other chains keep the automatic order between them.
+//!
+//! What a pick cannot keep is refused by name before any motion, never
+//! moved: a pick farther than its reach from every chain, an exit that
+//! an open chain cannot end at (its start end), a start and an exit on
+//! one chain while other chains remain (the operation cannot both
+//! start and end on that chain), and a plunge or retract
+//! column at a moved chain end that comes within the tool radius of the
+//! part. The column check is exact: the distance from the column's
+//! segment to each facet (`stock_sim::dist_seg_tri`), no sampling. Each
+//! end that a pick moves is checked: the new start and the new end of a
+//! reversed or re-seated chain.
+//!
+//! Provenance: first principles - the closest point on a segment
+//! (orthogonal projection clamped to the segment), the rotation of a
+//! closed polyline's vertex list and the reversal of an open one, as
+//! the 5-axis contour's ring seam (`ring_seam`). The entry and exit
+//! position is the common vocabulary of published CAM practice. No
+//! vendor material consulted.
+
+use crate::geometry::{Point3, Triangle};
+use crate::machining2d::GenError;
+use crate::path_picks::{PathPick, PathPicks, PickRole};
+use crate::stock_sim::dist_seg_tri;
+
+/// The start and exit picks a Deburr ride reads, in model mm, with the
+/// chamfer mill's diameter. No pick is the automatic order of every
+/// earlier path, byte for byte.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct ChainSeam {
+    /// The chain nearest this pick is cut first, from its point nearest it.
+    pub start: Option<PathPick>,
+    /// The chain nearest this pick is cut last, to its point nearest it.
+    pub exit: Option<PathPick>,
+    /// The chamfer mill's largest diameter, mm: it sets the reach of a
+    /// pick and the radius that a moved plunge or retract column clears.
+    pub tool_diameter: f64,
+}
+
+impl ChainSeam {
+    /// The seam of an operation's picks: the first start and the first
+    /// exit. A pick with a Z is measured in 3D, one without in XY.
+    #[must_use]
+    pub fn of(picks: &PathPicks, tool_diameter: f64) -> Self {
+        Self { start: picks.first(PickRole::Start), exit: picks.first(PickRole::Exit), tool_diameter }
+    }
+
+    /// No pick of either role.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.start.is_none() && self.exit.is_none()
+    }
+}
+
+/// One chain of the ride and its tip drop.
+pub(super) type Run = (Vec<Point3>, f64);
+
+/// The farthest a pick may sit from the nearest chain: one and a half
+/// tool diameters, the contour's slack for a click beside the edge.
+fn reach(tool_diameter: f64) -> f64 {
+    tool_diameter * 1.5
+}
+
+/// "start point (x, y)" or "start point (x, y, z)", the refusals' lead.
+fn named(role: PickRole, q: PathPick) -> String {
+    match q.z {
+        Some(z) => format!("{} point ({:.3}, {:.3}, {z:.3})", role.word(), q.xy.x, q.xy.y),
+        None => format!("{} point ({:.3}, {:.3})", role.word(), q.xy.x, q.xy.y),
+    }
+}
+
+/// The distance from the pick to `p`: in 3D when the pick has a Z,
+/// else in XY.
+fn dist(q: PathPick, p: Point3) -> f64 {
+    let (dx, dy) = (p.x - q.xy.x, p.y - q.xy.y);
+    let dz = q.z.map_or(0.0, |z| p.z - z);
+    (dx * dx + dy * dy + dz * dz).sqrt()
+}
+
+/// The closest point to the pick on the polyline `run`: `(segment
+/// index, parameter on it, point, distance)`; the first segment wins a
+/// tie. `None` for a run with no segment or no finite answer.
+fn nearest(run: &[Point3], q: PathPick) -> Option<(usize, f64, Point3, f64)> {
+    let mut best: Option<(usize, f64, Point3, f64)> = None;
+    for (i, w) in run.windows(2).enumerate() {
+        let (a, b) = (w[0], w[1]);
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let dz = if q.z.is_some() { b.z - a.z } else { 0.0 };
+        let (px, py, pz) = (q.xy.x - a.x, q.xy.y - a.y, q.z.map_or(0.0, |z| z - a.z));
+        let dd = dx * dx + dy * dy + dz * dz;
+        let t = if dd > 0.0 { ((px * dx + py * dy + pz * dz) / dd).clamp(0.0, 1.0) } else { 0.0 };
+        let f = Point3::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
+        let d = dist(q, f);
+        if d.is_finite() && best.is_none_or(|b| d < b.3) {
+            best = Some((i, t, f, d));
+        }
+    }
+    best
+}
+
+/// Drops each point that repeats its predecessor (a foot that lands on
+/// a vertex), so no zero-length move is cut.
+fn dedupe(pts: &mut Vec<Point3>) {
+    pts.dedup_by(|b, a| (a.x - b.x).abs() <= 1e-12 && (a.y - b.y).abs() <= 1e-12 && (a.z - b.z).abs() <= 1e-12);
+}
+
+/// Where a pick lands: the chain, and the closest point on it.
+#[derive(Clone, Copy)]
+struct Landing {
+    run: usize,
+    seg: usize,
+    t: f64,
+    foot: Point3,
+}
+
+/// The chain nearest the pick of `role`, or the by-name refusal of a
+/// pick beyond its reach.
+fn land(runs: &[Run], q: PathPick, role: PickRole, tool_diameter: f64) -> Result<Landing, GenError> {
+    let mut best: Option<(Landing, f64)> = None;
+    for (k, (run, _)) in runs.iter().enumerate() {
+        let Some((seg, t, foot, d)) = nearest(run, q) else { continue };
+        if best.as_ref().is_none_or(|b| d < b.1) {
+            best = Some((Landing { run: k, seg, t, foot }, d));
+        }
+    }
+    let lim = reach(tool_diameter);
+    match best {
+        Some((l, d)) if d <= lim => Ok(l),
+        Some((_, d)) => Err(GenError::Invalid(format!(
+            "{} is {d:.3} mm from the nearest edge chain of the Deburr, farther than the {lim:.3} mm a {} point may sit \
+             from it - pick on or beside an edge to break",
+            named(role, q),
+            role.word()
+        ))),
+        None => Err(GenError::Invalid(format!(
+            "{}: the Deburr has no edge chain to {} on - clear the {} point",
+            named(role, q),
+            role.word(),
+            role.word()
+        ))),
+    }
+}
+
+/// The closed chain `run` (`run[m] == run[0]`) re-seated to start and
+/// end at the foot `l`, then, with `on`, carried on along its own
+/// edges to the foot `on`.
+fn seat(run: &[Point3], l: Landing, on: Option<Landing>) -> Vec<Point3> {
+    let m = run.len().saturating_sub(1);
+    let mut out = Vec::with_capacity(m + 3);
+    out.push(l.foot);
+    out.extend((1..=m).map(|k| run[(l.seg + k) % m]));
+    out.push(l.foot);
+    if let Some(g) = on {
+        let mut steps = (g.seg + m - l.seg) % m;
+        if steps == 0 && g.t < l.t {
+            steps = m;
+        }
+        out.extend((1..=steps).map(|k| run[(l.seg + k) % m]));
+        out.push(g.foot);
+    }
+    dedupe(&mut out);
+    out
+}
+
+/// Does the open chain `run` run the other way so that it starts at
+/// the end nearest the start pick (or ends at the end nearest the exit
+/// pick)? A pick as near to one end as the other keeps the automatic
+/// direction.
+fn far_end(run: &[Point3], q: PathPick) -> bool {
+    match (run.first(), run.last()) {
+        (Some(&a), Some(&b)) => dist(q, b) < dist(q, a),
+        _ => false,
+    }
+}
+
+impl ChainSeam {
+    /// The runs in the order and the direction the picks give, or `None`
+    /// with no pick (the automatic order). `closed[k]` says that run `k`
+    /// closes on itself. `facets` and `clearance_z` judge the columns of
+    /// each moved chain end. Refused by name, before any motion.
+    pub(super) fn order(&self, runs: &[Run], closed: &[bool], facets: &[Triangle], clearance_z: f64) -> Result<Option<Vec<Run>>, GenError> {
+        if self.is_empty() {
+            return Ok(None);
+        }
+        let d = self.tool_diameter;
+        if !(d.is_finite() && d > 0.0) {
+            return Err(GenError::Invalid(format!("Deburr start and exit points need a positive tool diameter, not {d}")));
+        }
+        let s = self.start.map(|q| land(runs, q, PickRole::Start, d).map(|l| (q, l))).transpose()?;
+        let e = self.exit.map(|q| land(runs, q, PickRole::Exit, d).map(|l| (q, l))).transpose()?;
+        let mut out: Vec<Run> = runs.to_vec();
+        // The pick that answers for each moved end of each chain:
+        // (plunge, retract).
+        let mut owner: Vec<Option<(PathPick, PickRole, PathPick, PickRole)>> = vec![None; runs.len()];
+        let is_closed = |k: usize| closed.get(k).copied().unwrap_or(false) && runs[k].0.len() >= 3;
+        match (s, e) {
+            (Some((sq, sl)), Some((eq, el))) if sl.run == el.run => {
+                let k = sl.run;
+                let run = &runs[k].0;
+                // One chain cannot be cut first and last while other
+                // chains are cut between: the operation would end on
+                // another chain, a silently moved exit (#4168 review).
+                let others = runs.iter().enumerate().filter(|(j, (r, _))| *j != k && r.len() >= 2).count();
+                if others > 0 {
+                    return Err(GenError::Invalid(format!(
+                        "{}: the start point and the exit point pick one edge chain, but the Deburr cuts {others} other \
+                         edge chain(s) after the start chain - pick the exit on another chain or clear one of the two points",
+                        named(PickRole::Exit, eq)
+                    )));
+                }
+                if is_closed(k) {
+                    out[k].0 = seat(run, sl, Some(el));
+                } else {
+                    let flip = far_end(run, sq);
+                    // The exit must be nearest the end the start leaves free.
+                    if far_end(run, eq) == flip {
+                        return Err(GenError::Invalid(format!(
+                            "{}: the open edge chain that starts at the start point ends at its other end - pick near \
+                             that end or clear the exit point",
+                            named(PickRole::Exit, eq)
+                        )));
+                    }
+                    if flip {
+                        out[k].0.reverse();
+                    }
+                }
+                owner[k] = Some((sq, PickRole::Start, eq, PickRole::Exit));
+            }
+            (s, e) => {
+                if let Some((q, l)) = s {
+                    let k = l.run;
+                    if is_closed(k) {
+                        out[k].0 = seat(&runs[k].0, l, None);
+                    } else if far_end(&runs[k].0, q) {
+                        out[k].0.reverse();
+                    }
+                    owner[k] = Some((q, PickRole::Start, q, PickRole::Start));
+                }
+                if let Some((q, l)) = e {
+                    let k = l.run;
+                    if is_closed(k) {
+                        out[k].0 = seat(&runs[k].0, l, None);
+                    } else if near_first(&runs[k].0, q) {
+                        out[k].0.reverse();
+                    }
+                    owner[k] = Some((q, PickRole::Exit, q, PickRole::Exit));
+                }
+            }
+        }
+        columns(runs, &out, &owner, 0.5 * d, facets, clearance_z)?;
+        // The start chain first, the exit chain last, the rest between.
+        let first = s.map(|(_, l)| l.run);
+        let last = e.map(|(_, l)| l.run).filter(|k| Some(*k) != first);
+        let mut seq: Vec<usize> = first.into_iter().collect();
+        seq.extend((0..out.len()).filter(|k| Some(*k) != first && Some(*k) != last));
+        seq.extend(last);
+        Ok(Some(seq.into_iter().map(|k| out[k].clone()).collect()))
+    }
+}
+
+/// Is the first point of the open chain `run` strictly nearer the pick
+/// than its last? The exit chain then runs the other way.
+fn near_first(run: &[Point3], q: PathPick) -> bool {
+    match (run.first(), run.last()) {
+        (Some(&a), Some(&b)) => dist(q, a) < dist(q, b),
+        _ => false,
+    }
+}
+
+/// The exact column law at every chain end that a pick moved: the
+/// plunge column at a new first point and the retract column at a new
+/// last point. The refusal names the pick that moved the end.
+fn columns(
+    auto: &[Run],
+    out: &[Run],
+    owner: &[Option<(PathPick, PickRole, PathPick, PickRole)>],
+    r: f64,
+    facets: &[Triangle],
+    clearance_z: f64,
+) -> Result<(), GenError> {
+    let same = |a: Option<&Point3>, b: Option<&Point3>| match (a, b) {
+        (Some(a), Some(b)) => a.x == b.x && a.y == b.y && a.z == b.z,
+        _ => a.is_none() && b.is_none(),
+    };
+    for (k, (run, _)) in out.iter().enumerate() {
+        let Some((sq, sr, eq, er)) = owner.get(k).copied().flatten() else { continue };
+        let was = &auto[k].0;
+        let ends = [
+            (run.first(), !same(run.first(), was.first()), sq, sr, "plunge column to"),
+            (run.last(), !same(run.last(), was.last()), eq, er, "retract column from"),
+        ];
+        for (p, moved, q, role, what) in ends {
+            let Some(&p) = p else { continue };
+            if moved && !column_clear(p, r, clearance_z, facets) {
+                return Err(GenError::Invalid(format!(
+                    "{}: the {what} the edge at ({:.3}, {:.3}, {:.3}) comes within the tool radius {r:.3} mm of the \
+                     part - pick another point or clear the {} point",
+                    named(role, q),
+                    p.x,
+                    p.y,
+                    p.z,
+                    role.word()
+                )));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Does the vertical column above the edge point `p` keep a full tool
+/// radius `r` from every facet, from one radius above the edge up to
+/// the clearance plane? Below that the cone works across the break,
+/// which the ride's contact law sizes. Exact: the distance from the
+/// column's segment to each facet, no sampling.
+pub(super) fn column_clear(p: Point3, r: f64, clearance_z: f64, facets: &[Triangle]) -> bool {
+    let top = clearance_z.max(p.z);
+    let a = Point3::new(p.x, p.y, (p.z + r).min(top));
+    let b = Point3::new(p.x, p.y, top);
+    let limit = r - 1e-6;
+    facets.iter().all(|t| dist_seg_tri(a, b, t) >= limit)
+}
diff --git a/crates/motion/src/finishing3d/finish_seam.rs b/crates/motion/src/finishing3d/finish_seam.rs
new file mode 100644
index 000000000..e8244a028
--- /dev/null
+++ b/crates/motion/src/finishing3d/finish_seam.rs
@@ -0,0 +1,179 @@
+//! The user's start and exit points on the 3D Finish (#3329, the 3D
+//! Finish slice of #1448). The picks are read on the Parallel pattern,
+//! the one-direction zigzag raster, at any pass direction. The raster's
+//! passes are kept as they are; the pick only chooses the corner where
+//! the cut starts and the corner where the last pass ends, by the
+//! raster seam's law (`raster_seam::order`, shared with the 5-Axis
+//! Parallel):
+//!
+//! - **Start:** the raster corner nearest the start pick. The pass
+//!   order is reversed when that corner is on the last pass, and each
+//!   pass runs the other way when that corner is the far end of its
+//!   pass.
+//! - **Exit:** the order whose last pass ends nearest the exit pick.
+//!   With a start pick, the exit must be near the end that the start's
+//!   order gives.
+//!
+//! What a pick cannot keep is refused by name, never moved:
+//!
+//! - a pick on a pattern other than Parallel;
+//! - a pick farther than its reach from every corner, and an exit that
+//!   the start's order cannot end at (`raster_seam`);
+//! - a plunge column at the picked start, or a retract column at the
+//!   picked exit, that comes within the ball radius of the part. The
+//!   check is exact: the distance from the column's segment to each
+//!   facet (`support::column_clear`), no sampling;
+//! - a start or an exit that a later stage moves: the waterline rings
+//!   that cut after the raster, or (in the application) the area
+//!   controls that clip it. The finished path is read again, and its
+//!   first cut and its last cut must be the picked corners.
+//!
+//! No pick is the automatic raster, byte for byte.
+//!
+//! Provenance: first principles - the four end corners of a serpentine
+//! raster, the swept ball of a vertical move as its segment inflated by
+//! the radius; the entry and exit position is the common vocabulary of
+//! published CAM practice. No vendor material consulted.
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geometry::{Point3, Triangle};
+use crate::machining2d::GenError;
+use crate::path_picks::{PathPick, PickRole};
+
+use super::grid::SupSet;
+use super::params::{validate, Finish3DParams, FinishPattern, TOUCH_EPS};
+use super::raster::{parallel_angle_refusal, parallel_with_angle, raster_pass_seamed, rings_and_tail};
+use super::raster_seam::{RasterEnds, RasterSeam};
+use super::support::{build_sups, column_clear};
+
+/// The unit pass direction of the Parallel pattern at `direction_angle`
+/// degrees counterclockwise from +X; the four axis angles are exact.
+pub(super) fn parallel_direction(direction_angle: f64) -> (f64, f64) {
+    match direction_angle {
+        0.0 => (1.0, 0.0),
+        90.0 => (0.0, 1.0),
+        180.0 => (-1.0, 0.0),
+        270.0 => (0.0, -1.0),
+        _ => {
+            let (sin, cos) = direction_angle.to_radians().sin_cos();
+            (cos, sin)
+        }
+    }
+}
+
+/// "start point (x, y)" or "exit point (x, y, z)", the refusals' lead.
+fn named(role: PickRole, p: &PathPick) -> String {
+    match p.z {
+        Some(z) => format!("{} point ({:.3}, {:.3}, {:.3})", role.word(), p.xy.x, p.xy.y, z),
+        None => format!("{} point ({:.3}, {:.3})", role.word(), p.xy.x, p.xy.y),
+    }
+}
+
+fn at(q: Point3) -> String {
+    format!("({:.3}, {:.3}, {:.3})", q.x, q.y, q.z)
+}
+
+/// The first pick of the seam, with its role: the subject of a refusal
+/// that is not about one role.
+fn any_pick(seam: &RasterSeam) -> Option<(PickRole, PathPick)> {
+    seam.start.map(|q| (PickRole::Start, q)).or(seam.exit.map(|q| (PickRole::Exit, q)))
+}
+
+/// The 3D Finish's Parallel raster at `direction_angle` degrees with the
+/// user's start and exit points: the passes ordered for the picks, then
+/// the waterline rings and the clearance exit, as the automatic path.
+/// Returns the path and where the raster starts and ends. An empty
+/// `seam` is [`parallel_with_angle`], byte for byte, with no ends.
+pub fn finish_seamed(
+    facets: &[Triangle],
+    p: &Finish3DParams,
+    direction_angle: f64,
+    seam: &RasterSeam,
+) -> Result<(Toolpath, Option<RasterEnds>), GenError> {
+    let Some((role, q)) = any_pick(seam) else {
+        return Ok((parallel_with_angle(facets, p, direction_angle)?, None));
+    };
+    if !matches!(p.pattern, FinishPattern::Parallel) {
+        return Err(GenError::Invalid(format!(
+            "{}: the 3D Finish reads a start or exit point on the Parallel pattern only, not on {:?} - pick \
+             the Parallel pattern, or clear the {} point",
+            named(role, &q),
+            p.pattern,
+            role.word()
+        )));
+    }
+    if let Some(why) = parallel_angle_refusal(direction_angle) {
+        return Err(GenError::Invalid(why.into()));
+    }
+    validate(p, facets)?;
+    let r = p.tool_diameter * 0.5;
+    let sups = build_sups(facets, r);
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    let dir = parallel_direction(direction_angle);
+    let Some(ends) = raster_pass_seamed(&mut b, p, r, &sups, dir, false, p.tolerance, seam)? else {
+        return Err(GenError::Invalid(format!(
+            "{}: the raster has no pass to read it on - no shallow ground stands inside the depths",
+            named(role, &q)
+        )));
+    };
+    ends_clear(ends, seam, r, p.clearance_z, &sups)?;
+    let path = rings_and_tail(b, p, r, facets, true)?;
+    raster_ends_kept(
+        &path,
+        ends,
+        seam,
+        "the waterline rings cut after the raster",
+        "turn off the waterline rings, or clear the exit point",
+    )?;
+    Ok((path, Some(ends)))
+}
+
+/// The exact column law at each picked end of the ordered raster: the
+/// ball's plunge from the clearance plane down to the first tip, and
+/// its retract from the last tip up to the clearance plane, keep a full
+/// radius from every facet (`support::column_clear`: the distance from
+/// the column's segment to each facet, no sampling). The raster's own
+/// ground law gives the same answer for each sample it keeps; this is
+/// the seam's own proof at the ends that a pick moves.
+pub(super) fn ends_clear(ends: RasterEnds, seam: &RasterSeam, r: f64, clearance_z: f64, sups: &SupSet) -> Result<(), GenError> {
+    let top = clearance_z + r;
+    let picked = [(seam.start, ends.start, PickRole::Start, "plunge column to"), (seam.exit, ends.exit, PickRole::Exit, "retract column from")];
+    for (pick, tip, role, what) in picked {
+        let Some(q) = pick else { continue };
+        if !column_clear(tip.x, tip.y, tip.z + r, top, r - TOUCH_EPS, sups) {
+            return Err(GenError::Invalid(format!(
+                "{}: the {what} the raster corner {} comes within the ball radius {r:.3} mm of the part - \
+                 pick another corner, or clear the {} point",
+                named(role, &q),
+                at(tip),
+                role.word()
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// The finished path keeps the picked corners: its first cut lands on
+/// the raster's first tip when a start is picked, and its last cut ends
+/// on the raster's last tip when an exit is picked. Else the refusal
+/// names the pick, where the path starts or ends instead, the `cause`
+/// (what moved it) and the `fix`. A pick is never moved in silence.
+pub fn raster_ends_kept(path: &Toolpath, ends: RasterEnds, seam: &RasterSeam, cause: &str, fix: &str) -> Result<(), GenError> {
+    let same = |a: Point3, b: Point3| (a.x - b.x).abs() <= 1e-9 && (a.y - b.y).abs() <= 1e-9 && (a.z - b.z).abs() <= 1e-9;
+    let first = path.moves.iter().find(|m| m.kind != MoveKind::Rapid).map(|m| m.to);
+    let last = path.moves.iter().rev().find(|m| m.kind == MoveKind::Feed).map(|m| m.to);
+    let checks = [(seam.start, first, ends.start, PickRole::Start, "starts"), (seam.exit, last, ends.exit, PickRole::Exit, "ends")];
+    for (pick, got, want, role, verb) in checks {
+        let Some(q) = pick else { continue };
+        if got.is_some_and(|g| same(g, want)) {
+            continue;
+        }
+        let instead = got.map_or_else(|| "nowhere".to_owned(), at);
+        return Err(GenError::Invalid(format!(
+            "{}: {cause}, so the cut {verb} at {instead}, not at the picked raster corner {} - {fix}",
+            named(role, &q),
+            at(want)
+        )));
+    }
+    Ok(())
+}
diff --git a/crates/motion/src/finishing3d/finish_seam_tests.rs b/crates/motion/src/finishing3d/finish_seam_tests.rs
new file mode 100644
index 000000000..c021adcf9
--- /dev/null
+++ b/crates/motion/src/finishing3d/finish_seam_tests.rs
@@ -0,0 +1,70 @@
+//! #3329: the 3D Finish seam's exact column law, driven inside the
+//! crate. The raster's own ground law never keeps a sample under a
+//! canopy, so a whole raster cannot reach this refusal: the test gives
+//! the law the ends directly. Fixture: a floor at z = 0 and a canopy
+//! block over one corner, below the clearance plane.
+
+use crate::geo2d::Point2;
+use crate::geometry::{Point3, Triangle};
+use crate::path_picks::PathPick;
+
+use super::finish_seam::ends_clear;
+use super::raster_seam::{RasterEnds, RasterSeam};
+use super::support::build_sups;
+
+const R: f64 = 3.0;
+const CLEARANCE: f64 = 20.0;
+
+fn p3(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// A 40 x 30 floor at z = 0 and a closed canopy block x, y -4..6 at
+/// z 10..12 over the corner (1, 1).
+fn floor_and_canopy() -> Vec<Triangle> {
+    let mut f = vec![
+        Triangle::new(p3(0.0, 0.0, 0.0), p3(40.0, 0.0, 0.0), p3(40.0, 30.0, 0.0)),
+        Triangle::new(p3(0.0, 0.0, 0.0), p3(40.0, 30.0, 0.0), p3(0.0, 30.0, 0.0)),
+    ];
+    let (lo, hi) = (p3(-4.0, -4.0, 10.0), p3(6.0, 6.0, 12.0));
+    let c = |i: usize| p3(if i & 1 == 0 { lo.x } else { hi.x }, if i & 2 == 0 { lo.y } else { hi.y }, if i & 4 == 0 { lo.z } else { hi.z });
+    for q in [[0, 2, 3], [0, 3, 1], [4, 5, 7], [4, 7, 6], [0, 1, 5], [0, 5, 4], [2, 6, 7], [2, 7, 3], [0, 4, 6], [0, 6, 2], [1, 3, 7], [1, 7, 5]] {
+        f.push(Triangle::new(c(q[0]), c(q[1]), c(q[2])));
+    }
+    f
+}
+
+fn pick(x: f64, y: f64) -> Option<PathPick> {
+    Some(PathPick::xy(Point2::new(x, y)))
+}
+
+fn refusal(ends: RasterEnds, seam: RasterSeam) -> String {
+    let sups = build_sups(&floor_and_canopy(), R);
+    ends_clear(ends, &seam, R, CLEARANCE, &sups).err().map(|e| format!("{e:?}")).unwrap_or_default()
+}
+
+#[test]
+fn a_picked_end_under_a_canopy_is_refused_by_its_column() {
+    let (under, open) = (p3(1.0, 1.0, 0.0), p3(20.0, 15.0, 0.0));
+    // The picked start under the canopy: its plunge column is refused.
+    let e = refusal(RasterEnds { start: under, exit: open }, RasterSeam { start: pick(1.5, 1.5), exit: None });
+    assert!(e.contains("start point (1.500, 1.500)") && e.contains("plunge column") && e.contains("ball radius 3.000"), "{e}");
+    // The picked exit under the canopy: its retract column is refused.
+    let e = refusal(RasterEnds { start: open, exit: under }, RasterSeam { start: None, exit: pick(1.5, 1.5) });
+    assert!(e.contains("exit point (1.500, 1.500)") && e.contains("retract column"), "{e}");
+    // Clear columns pass, and an end that no pick states is not judged.
+    assert_eq!(refusal(RasterEnds { start: open, exit: open }, RasterSeam { start: pick(20.0, 15.0), exit: pick(20.0, 15.0) }), "");
+    assert_eq!(refusal(RasterEnds { start: open, exit: under }, RasterSeam { start: pick(20.0, 15.0), exit: None }), "");
+}
+
+#[test]
+fn the_column_law_is_exact_at_the_ball_radius() {
+    // The canopy's edge at x = 6: a column 3 mm off it grazes and
+    // passes, one 2.999 mm off it is refused. No sampling step can
+    // tell these apart; the segment-to-facet distance does.
+    let seam = RasterSeam { start: pick(9.0, 1.0), exit: None };
+    let grazes = p3(9.0, 1.0, 0.0);
+    assert_eq!(refusal(RasterEnds { start: grazes, exit: grazes }, seam), "", "a column at the radius passes");
+    let bites = p3(8.999, 1.0, 0.0);
+    assert!(refusal(RasterEnds { start: bites, exit: bites }, seam).contains("plunge column"), "a column inside the radius is refused");
+}
