index 0000000000..d32efa815d
--- /dev/null
+++ b/crates/motion/src/laser/mod.rs
@@ -0,0 +1,116 @@
+//! Laser profile cutting (#4081): 2D through-cuts of closed and open
+//! contours with a laser beam - the kerf offset, inner contours before
+//! the contour that frees them, straight or arc leads with the pierce
+//! in the waste, tabs left as uncut gaps, and the tight-hole rule.
+//!
+//! Provenance (public sources, behaviour only, our own words and code):
+//! - General laser-cutting shop practice: the kerf is the burnt width
+//!   of the focused beam, the cut path stands kerf / 2 off the part on
+//!   the waste side, a pierce is made in the scrap and led in, holes
+//!   are cut before the outline that frees the part, and tabs
+//!   (micro-joints) hold a part in the sheet. The same rules as the
+//!   abrasive waterjet, so this cut rides that generator
+//!   ([`crate::waterjet`]) under its own voice.
+//! - RS-274 / ISO 6983 for G41/G42 and for linear-only controls.
+//!
+//! The power is a fraction of the source's maximum (the Grbl laser
+//! mode reads it as the S word against `$30`); this module only checks
+//! and states it. Nothing here guesses: each refusal names its value.
+
+use crate::cl::Toolpath;
+use crate::geo2d::{Loop, Point2, Region};
+use crate::machining2d::GenError;
+use crate::sheet::Voice;
+use crate::waterjet::{waterjet_profile, WaterjetParams};
+
+pub use crate::waterjet::{JetTabs, LeadShape, OpenSide};
+
+/// Everything the generator reads, resolved to plain numbers (mm,
+/// mm/min, seconds, percent).
+#[derive(Clone, Debug, PartialEq)]
+pub struct LaserParams {
+    /// The kerf width (the laser head tool's diameter, or the op's
+    /// override).
+    pub kerf: f64,
+    /// Post G41/G42 instead of the offset path the computer walked.
+    pub control_comp: bool,
+    /// Run outer contours counter-clockwise and holes clockwise.
+    pub reversed: bool,
+    pub lead_shape: LeadShape,
+    /// Lead-in / lead-out length, mm (0 = none).
+    pub lead_in: f64,
+    pub lead_out: f64,
+    /// The kerf side of every open run.
+    pub open_side: OpenSide,
+    pub tabs: Option<JetTabs>,
+    /// The beam power while it cuts, percent of the source's maximum:
+    /// more than 0, at most 100.
+    pub power: f64,
+    /// Seconds the beam dwells to pierce.
+    pub pierce_time: f64,
+    /// Send every arc as chords at this tolerance (mm); `None` keeps
+    /// the arcs.
+    pub linearize: Option<f64>,
+    pub feed: f64,
+    /// The beam-off travel plane, and the plane the cut rides (the
+    /// sheet top).
+    pub clearance_z: f64,
+    pub cut_z: f64,
+    /// How much coarser than the importer's promise the model is, mm
+    /// (#1053).
+    pub model_excess: f64,
+}
+
+impl LaserParams {
+    /// The waterjet generator's numbers under the laser's voice: no
+    /// abrasive, the same geometry laws.
+    #[must_use]
+    pub fn as_sheet(&self) -> WaterjetParams {
+        WaterjetParams {
+            kerf: self.kerf,
+            control_comp: self.control_comp,
+            reversed: self.reversed,
+            lead_shape: self.lead_shape,
+            lead_in: self.lead_in,
+            lead_out: self.lead_out,
+            open_side: self.open_side,
+            tabs: self.tabs.clone(),
+            pierce_time: self.pierce_time,
+            abrasive_delay: 0.0,
+            linearize: self.linearize,
+            feed: self.feed,
+            clearance_z: self.clearance_z,
+            cut_z: self.cut_z,
+            model_excess: self.model_excess,
+            voice: Voice::LASER,
+        }
+    }
+
+    /// The door: the power by name, then every number the shared
+    /// generator checks, in the laser's voice.
+    pub fn door(&self) -> Result<(), GenError> {
+        if !(self.power.is_finite() && self.power > 0.0 && self.power <= 100.0) {
+            return Err(Voice::LASER.invalid(format!(
+                "the power must be more than 0 and at most 100 % of the source's maximum (it is {})",
+                self.power
+            )));
+        }
+        self.as_sheet().door()
+    }
+}
+
+/// Cut `loops` (closed contours) and `chains` (open runs) with the
+/// beam. `part` is the material the kerf must never reach; an empty
+/// region skips that law (said in the notes).
+pub fn laser_profile(loops: &[Loop], chains: &[Vec<Point2>], part: &Region, p: &LaserParams) -> Result<Toolpath, GenError> {
+    p.door()?;
+    let mut path = waterjet_profile(loops, chains, part, &p.as_sheet())?;
+    path.notes.push(format!(
+        "laser: requested power {:.1} % of the source's maximum at {:.0} mm/min; no power record is posted yet",
+        p.power, p.feed
+    ));
+    Ok(path)
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/motion/src/laser/tests.rs b/crates/motion/src/laser/tests.rs
new file mode 100644
index 0000000000..185fd95c22
--- /dev/null
+++ b/crates/motion/src/laser/tests.rs
@@ -0,0 +1,96 @@
+//! The laser profile (#4081): the shared sheet laws under the laser's
+//! voice - the same cut as the waterjet's for the same numbers, every
+//! note and refusal in the laser's words, and the power door.
+
+use super::*;
+use crate::cl::MoveKind;
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+    Loop::new(vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)]).unwrap()
+}
+
+/// A 100 x 60 plate with a 10 x 10 square hole.
+fn plate() -> (Vec<Loop>, Region) {
+    let loops = vec![rect(0.0, 0.0, 100.0, 60.0), rect(70.0, 25.0, 80.0, 35.0)];
+    let part = Region::new(loops.clone()).unwrap();
+    (loops, part)
+}
+
+fn params() -> LaserParams {
+    LaserParams {
+        kerf: 0.2,
+        control_comp: false,
+        reversed: false,
+        lead_shape: LeadShape::Arc,
+        lead_in: 2.0,
+        lead_out: 1.0,
+        open_side: OpenSide::Center,
+        tabs: None,
+        power: 80.0,
+        pierce_time: 0.3,
+        linearize: None,
+        feed: 1500.0,
+        clearance_z: 5.0,
+        cut_z: 0.0,
+        model_excess: 0.0,
+    }
+}
+
+#[test]
+fn the_laser_cuts_what_the_waterjet_cuts_and_speaks_as_the_laser() {
+    let (loops, part) = plate();
+    let p = params();
+    let path = laser_profile(&loops, &[], &part, &p).unwrap();
+    let jet = waterjet_profile(&loops, &[], &part, &WaterjetParams { voice: Voice::WATERJET, ..p.as_sheet() }).unwrap();
+    assert_eq!(path.moves, jet.moves, "the same sheet laws, the same moves");
+    let pierces = path.moves.iter().filter(|m| m.kind == MoveKind::Rapid && m.to.z == 0.0 && m.from.z > 0.0).count();
+    assert_eq!(pierces, 2, "one pierce for the hole, one for the outline");
+    assert!(path.notes.iter().all(|n| n.starts_with("laser: ")), "{:?}", path.notes);
+    assert!(!path.notes.iter().any(|n| n.contains("abrasive") || n.contains("jet ")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("2 contour(s) cut inner first (1 hole(s), 0 tab(s)), 2 pierce(s), kerf 0.200 mm")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("pierce time 0.30 s at each pierce; beam and dwell records")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("requested power 80.0 %")), "{:?}", path.notes);
+}
+
+#[test]
+fn the_power_is_refused_by_name_outside_its_range() {
+    let (loops, part) = plate();
+    for bad in [0.0, -5.0, 100.5, f64::NAN] {
+        let p = LaserParams { power: bad, ..params() };
+        let err = laser_profile(&loops, &[], &part, &p).unwrap_err().to_string();
+        assert!(err.contains("laser profile: the power must be more than 0 and at most 100 %"), "{bad}: {err}");
+    }
+    let p = LaserParams { power: 100.0, ..params() };
+    assert!(laser_profile(&loops, &[], &part, &p).is_ok(), "full power is legal");
+}
+
+#[test]
+fn the_shared_refusals_speak_as_the_laser_profile() {
+    let (loops, part) = plate();
+    let cases: [(LaserParams, &str); 4] = [
+        (LaserParams { kerf: 0.0, ..params() }, "laser profile: the kerf width must be a positive number"),
+        (LaserParams { clearance_z: -1.0, ..params() }, "laser profile: the clearance plane"),
+        (
+            LaserParams { tabs: Some(JetTabs { count: 2, width: 1.0, at: vec![Point2::new(50.0, 0.0)] }), ..params() },
+            "laser profile: the tab count is 2 but 1 tab position(s)",
+        ),
+        (
+            LaserParams { tabs: Some(JetTabs { count: 1, width: 1.0, at: vec![Point2::new(500.0, 500.0)] }), ..params() },
+            "laser profile: tab 1",
+        ),
+    ];
+    for (p, want) in cases {
+        let err = laser_profile(&loops, &[], &part, &p).unwrap_err().to_string();
+        assert!(err.contains(want), "want {want:?}: {err}");
+    }
+    let err = laser_profile(&[], &[], &Region::default(), &params()).unwrap_err().to_string();
+    assert!(err.contains("laser profile: no contour to cut"), "{err}");
+}
+
+#[test]
+fn an_open_run_and_a_missing_silhouette_say_so_in_the_lasers_words() {
+    let chain = vec![Point2::new(0.0, 0.0), Point2::new(40.0, 0.0)];
+    let path = laser_profile(&[], &[chain], &Region::default(), &params()).unwrap();
+    assert!(path.notes.iter().any(|n| n.starts_with("laser: contour C0 is an open run, cut on its centre line")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.starts_with("laser: no part silhouette to judge")), "{:?}", path.notes);
+}
