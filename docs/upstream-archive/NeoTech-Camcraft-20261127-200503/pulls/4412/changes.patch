+        (Planners { guide: Box::new(NoGuide), ..good() }, NO_GUIDE),
+        (Planners { order: Box::new(NoOrder), ..good() }, NO_ORDER),
+        (Planners { load: Box::new(NoLoad), ..good() }, NO_LOAD),
