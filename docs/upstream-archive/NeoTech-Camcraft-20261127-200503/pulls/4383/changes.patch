new file mode 100644
index 000000000..b5f86a058
--- /dev/null
+++ b/crates/pathkernel/src/load/law.rs
@@ -0,0 +1,177 @@
+//! The engagement law of the load stage (K3, #4026): the in-process stock
+//! as a raster of the stage's stock reader, and the radial engagement ae/D
+//! of each cut, read in the cut order on the stock that the earlier cuts
+//! leave. Every mode of the stage reads with this one law (record "Stage 3",
+//! invariant 3).
+//! Provenance: the contact angle phi of the cutting edge and the radial
+//! engagement ae/D = (1 - cos phi) / 2 (Altintas, "Manufacturing
+//! Automation", 2000, ch. 2; Stori & Wright 2000, the engagement on the
+//! in-process stock); the stock as a raster of material cells, read at
+//! the rim of the swept disc, as in Choy & Chan (Computer-Aided Design 35,
+//! 2003) and our own design record `docs/decisions/4024-path-kernel-design.md`.
+
+use crate::guide::Curve;
+use crate::load::StockRead;
+use crate::verdict::{Refusal, Stage};
+use crate::{Point2, Region};
+
+/// The raster cells across one tool radius.
+const CELLS_PER_R: f64 = 20.0;
+/// The most raster cells of one read: a coarser cell above it.
+const MAX_CELLS: f64 = 4.0e6;
+/// The reads along a cut across one tool radius.
+const SAMPLES_PER_R: f64 = 8.0;
+
+/// Refusal reason: the stock raster cannot be made for the region.
+pub const NO_RASTER: &str = "the load stage cannot make a stock raster: the cutter-centre area is empty or out of range";
+
+/// The in-process stock: material cells of side `h` from `(x0, y0)`.
+#[derive(Clone, Debug)]
+pub(crate) struct Stock {
+    x0: f64,
+    y0: f64,
+    h: f64,
+    nx: usize,
+    ny: usize,
+    cells: Vec<bool>,
+}
+
+/// One read of a cut: the curve's index, the place and the engagement.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Read {
+    pub curve: usize,
+    pub at: Point2,
+    pub load: f64,
+}
+
+/// A count of cells along one side, or `None` when it is not finite or too large.
+fn count(span: f64, h: f64) -> Option<usize> {
+    let n = (span / h).ceil() + 1.0;
+    (n.is_finite() && (1.0..=MAX_CELLS).contains(&n)).then_some(n as usize)
+}
+
+impl Stock {
+    /// The raster of the stock round `center` (the cutter-centre area) for
+    /// a tool of radius `r`: each cell is material where `reader` says so.
+    /// A cell that the reader does not know is material: the read can then
+    /// only be too high, never too low.
+    pub fn new(center: &Region, reader: &dyn StockRead, r: f64) -> Result<Self, Refusal> {
+        let bad = || Refusal::new(Stage::Load, NO_RASTER);
+        let (lo, hi) = center.bounds().ok_or_else(bad)?;
+        let m = 2.0 * r;
+        let (w, t) = ((hi.x - lo.x) + 2.0 * m, (hi.y - lo.y) + 2.0 * m);
+        let h = (r / CELLS_PER_R).max((w * t / MAX_CELLS).sqrt());
+        if !(h.is_finite() && h > 0.0) {
+            return Err(bad());
+        }
+        let (nx, ny) = (count(w, h).ok_or_else(bad)?, count(t, h).ok_or_else(bad)?);
+        let all = nx.checked_mul(ny).ok_or_else(bad)?;
+        let mut s = Self { x0: lo.x - m, y0: lo.y - m, h, nx, ny, cells: Vec::with_capacity(all) };
+        for j in 0..ny {
+            for i in 0..nx {
+                let c = s.centre(i, j);
+                s.cells.push(reader.material_at(c).unwrap_or(true));
+            }
+        }
+        Ok(s)
+    }
+
+    fn centre(&self, i: usize, j: usize) -> Point2 {
+        Point2::new(self.x0 + (i as f64 + 0.5) * self.h, self.y0 + (j as f64 + 0.5) * self.h)
+    }
+
+    /// The cell index at `p`, or `None` off the raster.
+    fn cell(&self, p: Point2) -> Option<usize> {
+        let (fx, fy) = ((p.x - self.x0) / self.h, (p.y - self.y0) / self.h);
+        if !(fx >= 0.0 && fy >= 0.0 && fx.is_finite() && fy.is_finite()) {
+            return None;
+        }
+        let (i, j) = (fx as usize, fy as usize);
+        (i < self.nx && j < self.ny).then(|| j.saturating_mul(self.nx).saturating_add(i))
+    }
+
+    /// Clears each cell whose centre is within `r` of `c` (the tool disc).
+    fn clear(&mut self, c: Point2, r: f64) {
+        let span = |v: f64, v0: f64, n: usize| {
+            let lo = ((v - r - v0) / self.h).floor().max(0.0) as usize;
+            let hi = (((v + r - v0) / self.h).ceil().max(0.0) as usize).min(n);
+            lo..hi
+        };
+        for j in span(c.y, self.y0, self.ny) {
+            for i in span(c.x, self.x0, self.nx) {
+                let q = self.centre(i, j);
+                if (q.x - c.x).hypot(q.y - c.y) <= r
+                    && let Some(k) = self.cells.get_mut(j.saturating_mul(self.nx).saturating_add(i))
+                {
+                    *k = false;
+                }
+            }
+        }
+    }
+
+    /// ae/D at `c` for the unit motion direction `d`, after the tool disc
+    /// at `c` is cleared: the contact angle is the part of the front half
+    /// of the cutting edge (one read for each degree, three quarters of a
+    /// cell outside the edge) that has material beside it. A read inside
+    /// the edge would miss the side of the arc that the disc of the read
+    /// before has just cleared, and read too low.
+    fn engagement(&self, c: Point2, d: Point2, r: f64) -> f64 {
+        let n = Point2::new(-d.y, d.x);
+        let edge = r + 0.75 * self.h;
+        let touch = (-90i32..=90)
+            .filter(|deg| {
+                let t = f64::from(*deg).to_radians();
+                let (a, b) = (t.cos() * edge, t.sin() * edge);
+                let p = Point2::new(c.x + a * d.x + b * n.x, c.y + a * d.y + b * n.y);
+                self.cell(p).and_then(|k| self.cells.get(k)).copied().unwrap_or(false)
+            })
+            .count();
+        let phi = (touch as f64).to_radians().min(std::f64::consts::PI);
+        ((1.0 - phi.cos()) / 2.0).clamp(0.0, 1.0)
+    }
+}
+
+/// The places of a curve at most `step` apart, each with its unit
+/// direction; a closed curve runs back to its start, which is not read twice.
+pub(crate) fn samples(c: &Curve, step: f64) -> Vec<(Point2, Point2)> {
+    let mut line: Vec<Point2> = c.pts().iter().map(|p| p.at()).collect();
+    if c.closed()
+        && let Some(&f) = line.first()
+    {
+        line.push(f);
+    }
+    let mut out = Vec::new();
+    for w in line.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        if !(len > 0.0 && len.is_finite()) {
+            continue;
+        }
+        let d = Point2::new((b.x - a.x) / len, (b.y - a.y) / len);
+        let n = (len / step).ceil().clamp(1.0, 1e6) as usize;
+        for k in 0..n {
+            let t = k as f64 / n as f64;
+            out.push((Point2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y)), d));
+        }
+    }
+    if !c.closed()
+        && let (Some(&(_, d)), Some(&p)) = (out.last(), line.last())
+    {
+        out.push((p, d));
+    }
+    out
+}
+
+/// Reads each curve of `curves` in order on a copy of `stock`: the tool
+/// disc at each place is cleared, then the material beside its edge is read.
+pub(crate) fn read(stock: &Stock, curves: &[Curve], r: f64) -> Vec<Read> {
+    let mut s = stock.clone();
+    let mut out = Vec::new();
+    for (i, c) in curves.iter().enumerate() {
+        for (p, d) in samples(c, r / SAMPLES_PER_R) {
+            s.clear(p, r);
+            out.push(Read { curve: i, at: p, load: s.engagement(p, d, r) });
+        }
+    }
+    out
+}
diff --git a/crates/pathkernel/src/load/rings.rs b/crates/pathkernel/src/load/rings.rs
new file mode 100644
index 000000000..99eab3970
--- /dev/null
+++ b/crates/pathkernel/src/load/rings.rs
@@ -0,0 +1,298 @@
+//! Constant engagement on rings (K3, #4026): where a ring reads above the
+//! load on the stock that the rings before it leave, a ring of the same
+//! distance field is inserted between it and the nearest ring cut before
+//! it (the mid level), and the plan is read again. An insertion that does
+//! not lower the load (the classic sharp corner of offset rings) is taken
+//! out again and the cut is named; so is a cut with no earlier pass beside
+//! it, a curve that is not a ring of a distance field, and a gap at the
+//! smallest step.
+//! Provenance: the engagement of a circular path and the closer spacing
+//! that it needs round a small core (Stori & Wright 2000, "Constant
+//! engagement tool path generation for convex geometries", J. Manuf.
+//! Systems 19(3)); rings as level sets of the distance to the walls (Held
+//! 1991); the floor of 15 % of the load width from the held #3933 design
+//! (`docs/decisions/3933-pocket-offset-rings-spiral.md`).
+
+use std::collections::{HashMap, HashSet};
+
+use super::law::{Read, Stock, read};
+use super::stage::{FRESH_CUT, Outcome, beside, finish, on_span, poly_dist};
+use super::{Controlled, OrderedSet, PLAN_TOL};
+use crate::frame::PlanePoint;
+use crate::guide::{Curve, Family, MarkKind};
+use crate::region::PlanarRegion;
+use crate::verdict::{Refusal, Stage, Verdict};
+use crate::{Loop, Point2, Region, to_loops};
+
+/// Over-limit reason: an inserted pass did not lower the load.
+pub const NOT_FIXED: &str = "more passes do not bring this cut under the load limit (a sharp corner of the rings): use Adaptive or round the corner";
+/// Over-limit reason: the cut is not a ring of a distance field.
+pub const NOT_A_RING: &str = "this cut is not a ring of the wall distance: no pass can be inserted before it";
+/// Over-limit reason: the gap to the pass before is at the smallest step.
+pub const AT_FLOOR: &str = "the passes are at the smallest step and this cut is still above the load limit";
+/// Over-limit reason: the most passes were inserted.
+pub const TOO_MANY_PASSES: &str = "the load stage inserted the most passes that it makes; this cut is still above the load limit";
+/// Refusal reason: a polygon operation of the stage failed.
+pub const LOAD_GEOMETRY: &str = "the load stage geometry cannot be computed: a value is out of range";
+
+/// The most read-and-insert rounds.
+const MAX_ROUNDS: usize = 12;
+/// The most curves: this many times the curves of the guide, and 64 more.
+const GROWTH: usize = 8;
+/// The smallest gap between two rings: this share of the load width
+/// (the floor of the held #3933 design).
+const FLOOR_SHARE: f64 = 0.15;
+
+/// The distance field of a ring.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Field {
+    /// The distance to every wall of the cutter-centre area.
+    Wall,
+    /// The distance to the part walls only (a region with a stock edge).
+    Part,
+}
+
+fn geo<T, E>(r: Result<T, E>) -> Result<T, Refusal> {
+    r.map_err(|_| Refusal::new(Stage::Load, LOAD_GEOMETRY))
+}
+
+fn refs(p: &PlanarRegion, f: Field) -> &[Loop] {
+    match f {
+        Field::Wall => p.center().loops(),
+        Field::Part => p.part_walls(),
+    }
+}
+
+/// The level of curve `c` in field `f`: the distance of each point to the
+/// field's walls, when they agree within `tol`.
+fn depth(c: &Curve, p: &PlanarRegion, f: Field, tol: f64) -> Option<f64> {
+    let walls = refs(p, f);
+    if walls.is_empty() {
+        return None;
+    }
+    let ds: Vec<f64> = c.pts().iter().map(|q| to_loops(q.at(), walls)).collect();
+    let (lo, hi) = ds.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), d| (a.min(*d), b.max(*d)));
+    (hi - lo <= tol && lo.is_finite()).then(|| (lo + hi) / 2.0)
+}
+
+/// The fields to try: the part walls first where the region has a stock edge.
+fn fields(p: &PlanarRegion) -> Vec<Field> {
+    if p.stock_edge().is_empty() || p.part_walls().is_empty() { vec![Field::Wall] } else { vec![Field::Part, Field::Wall] }
+}
+
+/// The pieces of the level `d` of field `f` that lie within `gap` of
+/// `near`, each in the direction of `near`, as ring curves.
+fn between(p: &PlanarRegion, f: Field, d: f64, near: &Curve, gap: f64, tol: f64) -> Result<Vec<Curve>, Refusal> {
+    let area = match f {
+        Field::Wall => geo(p.center().offset(-d))?,
+        Field::Part => {
+            let walks: Vec<Vec<Point2>> = p.part_walls().iter().map(|l| l.points().iter().chain(l.points().first()).copied().collect()).collect();
+            geo(p.center().difference(&geo(Region::sweep(&walks, d))?))?
+        }
+    };
+    let walls = refs(p, f);
+    let z = near.pts().first().map_or(0.0, PlanePoint::depth);
+    let mut out = Vec::new();
+    for l in area.loops() {
+        let pts = l.points();
+        let on: Vec<bool> = pts.iter().map(|q| (to_loops(*q, walls) - d).abs() <= tol).collect();
+        for (mut piece, closed) in runs(pts, &on) {
+            if piece.iter().any(|q| poly_dist(*q, near) > gap + tol) {
+                continue;
+            }
+            orient(&mut piece, closed, near);
+            let pp: Result<Vec<PlanePoint>, Refusal> = piece.into_iter().map(|q| PlanePoint::new(q, z)).collect();
+            if let Ok(c) = Curve::new(pp?, None, closed, near.k(), Family::Ring) {
+                out.push(c);
+            }
+        }
+    }
+    Ok(out)
+}
+
+/// The runs of `pts` (a closed loop) where `on` holds: the whole loop when
+/// it holds everywhere, else open pieces of two or more points.
+fn runs(pts: &[Point2], on: &[bool]) -> Vec<(Vec<Point2>, bool)> {
+    let n = pts.len();
+    let Some(off) = on.iter().position(|b| !b) else {
+        return vec![(pts.to_vec(), true)];
+    };
+    let (mut out, mut cur) = (Vec::new(), Vec::new());
+    for j in 1..=n {
+        let i = (off + j) % n;
+        if on.get(i).copied().unwrap_or(false) {
+            cur.extend(pts.get(i).copied());
+        } else if !cur.is_empty() {
+            if cur.len() >= 2 {
+                out.push((std::mem::take(&mut cur), false));
+            }
+            cur.clear();
+        }
+    }
+    out
+}
+
+/// Turns `piece` to run as `near` runs beside it; a closed piece starts at
+/// its point nearest the start of `near`.
+fn orient(piece: &mut [Point2], closed: bool, near: &Curve) {
+    let line: Vec<Point2> = near.pts().iter().map(PlanePoint::at).collect();
+    let dir = |q: Point2| -> Point2 {
+        let best = line.windows(2).min_by(|a, b| crate::seg_dist(q, a[0], a[1]).total_cmp(&crate::seg_dist(q, b[0], b[1])));
+        best.map_or(Point2::new(0.0, 0.0), |w| Point2::new(w[1].x - w[0].x, w[1].y - w[0].y))
+    };
+    let along: f64 = piece.windows(2).map(|w| {
+        let u = dir(w[0]);
+        (w[1].x - w[0].x) * u.x + (w[1].y - w[0].y) * u.y
+    }).sum();
+    if along < 0.0 {
+        piece.reverse();
+    }
+    if closed && let Some(s) = line.first() {
+        let k = piece.iter().enumerate().min_by(|a, b| (a.1.x - s.x).hypot(a.1.y - s.y).total_cmp(&(b.1.x - s.x).hypot(b.1.y - s.y))).map_or(0, |(k, _)| k);
+        piece.rotate_left(k);
+    }
+}
+
+/// The worst read above the cap of each curve, and the count of them.
+#[derive(Clone, Copy, Debug, Default)]
+struct Hot {
+    count: usize,
+    worst: f64,
+    at: Point2,
+}
+
+fn hot(reads: &[Read], n: usize, cap: f64) -> Vec<Hot> {
+    let mut out = vec![Hot::default(); n];
+    for rd in reads.iter().filter(|r| r.load > cap) {
+        if let Some(h) = out.get_mut(rd.curve) {
+            h.count += 1;
+            if rd.load > h.worst {
+                (h.worst, h.at) = (rd.load, rd.at);
+            }
+        }
+    }
+    out
+}
+
+/// An insertion lowered the load of its cut: no read above the cap is
+/// left, or the worst excess halved, or a quarter of the hot reads went.
+fn improved(before: Hot, after: Hot, cap: f64) -> bool {
+    after.count == 0 || (after.worst - cap) <= 0.5 * (before.worst - cap) || after.count * 4 <= before.count * 3
+}
+
+/// What one hot ring gets.
+enum Step {
+    Insert(Vec<Curve>),
+    Named(&'static str),
+}
+
+/// The passes to insert before curve `i` (hot at `at`), or the reason
+/// that none can be.
+fn plan_for(curves: &[Curve], i: usize, at: Point2, p: &PlanarRegion, (r, tol, floor): (f64, f64, f64)) -> Result<Step, Refusal> {
+    // Only a ring is a level of a distance field: a pass is never inserted
+    // before a row, a medial line, a trace or a helix (#4176), even where
+    // its points are at one distance to the walls (a helix on a circle
+    // round the centre of a hole).
+    let Some(c) = curves.get(i).filter(|c| c.family() == Family::Ring) else { return Ok(Step::Named(NOT_A_RING)) };
+    let prev = curves.iter().take(i).map(|e| (poly_dist(at, e), e)).min_by(|a, b| a.0.total_cmp(&b.0));
+    let Some((dist, j)) = prev.filter(|(d, _)| *d <= 2.0 * r + tol) else { return Ok(Step::Named(FRESH_CUT)) };
+    for f in fields(p) {
+        let (Some(di), Some(dj)) = (depth(c, p, f, tol), depth(j, p, f, tol)) else { continue };
+        let gap = (di - dj).abs();
+        if gap < 2.0 * floor {
+            return Ok(Step::Named(AT_FLOOR));
+        }
+        let mid = between(p, f, (di + dj) / 2.0, c, gap.max(dist), tol)?;
+        if !mid.is_empty() {
+            return Ok(Step::Insert(mid));
+        }
+    }
+    Ok(Step::Named(NOT_A_RING))
+}
+
+/// Constant engagement at `load` (ae/D) on the ordered rings `s`.
+pub(crate) fn control(s: &OrderedSet, p: &PlanarRegion, stock: &Stock, load: f64, r: f64) -> Result<Verdict<Controlled>, Refusal> {
+    let cap = load * (1.0 + PLAN_TOL);
+    let tol = (0.01 * r).max(0.01);
+    let floor = (FLOOR_SHARE * load * 2.0 * r).max(2.0 * tol);
+    let most = s.curves().len().saturating_mul(GROWTH).saturating_add(64);
+    // Each curve keeps an id: its index in `s`, or a new one for an inserted pass.
+    let mut items: Vec<(usize, Curve)> = s.curves().iter().cloned().enumerate().collect();
+    let mut next = items.len();
+    let (mut why, mut stuck): (HashMap<usize, &'static str>, HashSet<usize>) = (HashMap::new(), HashSet::new());
+    let mut pending: Vec<(usize, Vec<usize>, Hot)> = Vec::new();
+    for _ in 0..MAX_ROUNDS {
+        let curves: Vec<Curve> = items.iter().map(|(_, c)| c.clone()).collect();
+        let heat = hot(&read(stock, &curves, r), curves.len(), cap);
+        let mut reverted = false;
+        for (target, added, before) in pending.drain(..) {
+            let after = items.iter().position(|(id, _)| *id == target).and_then(|k| heat.get(k)).copied().unwrap_or_default();
+            if !improved(before, after, cap) {
+                items.retain(|(id, _)| !added.contains(id));
+                stuck.insert(target);
+                why.insert(target, NOT_FIXED);
+                reverted = true;
+            }
+        }
+        if reverted {
+            continue;
+        }
+        let mut adds: Vec<(usize, Vec<Curve>, Hot)> = Vec::new();
+        for (k, h) in heat.iter().enumerate().filter(|(_, h)| h.count > 0) {
+            let id = items.get(k).map_or(usize::MAX, |(id, _)| *id);
+            if stuck.contains(&id) {
+                continue;
+            }
+            match plan_for(&curves, k, h.at, p, (r, tol, floor))? {
+                Step::Insert(mid) => adds.push((k, mid, *h)),
+                Step::Named(reason) => {
+                    why.insert(id, reason);
+                }
+            }
+        }
+        let extra: usize = adds.iter().map(|(_, m, _)| m.len()).sum();
+        if adds.is_empty() {
+            break;
+        }
+        if items.len().saturating_add(extra) > most {
+            for (k, _, _) in &adds {
+                if let Some((id, _)) = items.get(*k) {
+                    why.insert(*id, TOO_MANY_PASSES);
+                }
+            }
+            break;
+        }
+        for (k, mid, h) in adds.into_iter().rev() {
+            let target = items.get(k).map_or(usize::MAX, |(id, _)| *id);
+            let ids: Vec<usize> = (next..next + mid.len()).collect();
+            next += mid.len();
+            for (c, id) in mid.into_iter().zip(ids.iter()).rev() {
+                items.insert(k, (*id, c));
+            }
+            pending.push((target, ids, h));
+        }
+    }
+    let curves: Vec<Curve> = items.iter().map(|(_, c)| c.clone()).collect();
+    let reads = read(stock, &curves, r);
+    let changed = items.len() != s.curves().len();
+    let at: HashMap<usize, usize> = items.iter().enumerate().map(|(k, (id, _))| (*id, k)).collect();
+    // A full-width stretch with no read above the cap is resolved: its mark goes.
+    let mut marks = Vec::new();
+    for m in s.marks() {
+        let Some(&k) = at.get(&m.curve()) else { continue };
+        let still = reads.iter().any(|rd| rd.curve == k && rd.load > cap && on_span(m, rd.at));
+        if m.kind() != MarkKind::FullWidth || still {
+            marks.push(m.clone().renumber(k));
+        }
+    }
+    let ids: Vec<usize> = items.iter().map(|(id, _)| *id).collect();
+    let reason = |rd: &Read| -> &'static str {
+        if !beside(&curves, rd.curve, rd.at, 2.0 * r + tol) {
+            return FRESH_CUT;
+        }
+        ids.get(rd.curve).and_then(|id| why.get(id)).copied().unwrap_or(NOT_FIXED)
+    };
+    let marks = if changed { marks } else { s.marks().to_vec() };
+    let out = Outcome { curves: changed.then(|| curves.clone()), marks, reads };
+    finish(s, out, load, "constant engagement", reason)
+}
diff --git a/crates/pathkernel/src/load/stage.rs b/crates/pathkernel/src/load/stage.rs
new file mode 100644
index 000000000..a1f48fa21
--- /dev/null
+++ b/crates/pathkernel/src/load/stage.rs
@@ -0,0 +1,160 @@
+//! The load stage (K3, #4026): one planner for the three load choices.
+//! It changes guide curves only (record "Stage 3": never an entry, a link
+//! or a lift). `None` keeps the curves and names each cut above the limit;
+//! constant engagement inserts passes where a cut reads above the load
+//! (`rings.rs`); trochoidal replaces each full-width stretch by loops
+//! (`trochoid.rs`). Each mode reads with the one engagement law
+//! (`law.rs`), and each cut that stays above the limit is named on the
+//! status line (the maintainer's answer 4 of the K0 record).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 3: Load control" and `docs/decisions/4026-kernel-load-control.md`.
+
+use super::law::{Read, Stock, read};
+use super::{Controlled, Engagement, LoadControl, LoadPlanner, OverLimit, PLAN_TOL, Reach, Reading, StockRead, rings, trochoid};
+use crate::frame::Positive;
+use crate::guide::{Curve, GuideSet, Mark, Span};
+use crate::order::OrderedSet;
+use crate::region::KernelRegion;
+use crate::verdict::{Note, Refusal, Stage, Verdict};
+use crate::{KERNEL_TOL, Point2, near, seg_dist};
+
+/// The limit (ae/D) that the stage states when the load choice has none
+/// (`None` and `Trochoidal`): a contact angle of 90 degrees, half the
+/// diameter.
+pub const DEFAULT_LIMIT: f64 = 0.5;
+
+/// Refusal reason: a region that is not planar.
+pub const LOAD_NOT_PLANAR: &str = "the load stage reads planar regions only";
+/// Refusal reason: the stock reach of constant engagement (Adaptive).
+pub const STOCK_REACH_ELSEWHERE: &str =
+    "constant engagement on the in-process stock (Adaptive) is planned by the HSM planner behind the load trait, not by this stage";
+/// Refusal reason: the controlled curves and their marks do not make an
+/// ordered set again (a mark off its curve, a start off the first curve).
+pub const SET_NOT_KEPT: &str = "the load stage cannot keep the controlled curves, their marks and their start as an ordered set";
+/// Over-limit reason of `None`.
+pub const NO_CONTROL: &str = "no load control: this cut is above the load limit";
+/// Over-limit reason: no earlier pass is beside the cut.
+pub const FRESH_CUT: &str = "a full-width cut: no earlier pass is beside it";
+
+/// The load stage, with the limit that it states for a choice without one.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct LoadStage {
+    limit: Engagement,
+}
+
+impl Default for LoadStage {
+    fn default() -> Self {
+        Self { limit: Engagement(DEFAULT_LIMIT) }
+    }
+}
+
+impl LoadStage {
+    /// The stage with the stated limit `limit` (ae/D above 0, at most 1).
+    pub fn new(limit: f64) -> Result<Self, Refusal> {
+        Ok(Self { limit: Engagement::limit(Stage::Load, limit)? })
+    }
+    #[must_use]
+    pub fn limit(&self) -> f64 {
+        self.limit.get()
+    }
+}
+
+impl LoadPlanner for LoadStage {
+    fn control(&self, s: OrderedSet, r: &KernelRegion, stock: &dyn StockRead, lc: &LoadControl, tool_r: f64) -> Result<Verdict<Controlled>, Refusal> {
+        let p = r.planar().ok_or(Refusal::new(Stage::Load, LOAD_NOT_PLANAR))?;
+        let tool_r = Positive::new(Stage::Load, tool_r)?.get();
+        let base = Stock::new(p.center(), stock, tool_r)?;
+        match lc {
+            LoadControl::None => {
+                let reads = read(&base, s.curves(), tool_r);
+                let out = Outcome { curves: None, marks: s.marks().to_vec(), reads };
+                finish(&s, out, self.limit.get(), "no load control", |_| NO_CONTROL)
+            }
+            LoadControl::ConstantEngagement(c) if c.reach() == Reach::Stock => Err(Refusal::new(Stage::Load, STOCK_REACH_ELSEWHERE)),
+            LoadControl::ConstantEngagement(c) => rings::control(&s, p, &base, c.load(), tool_r),
+            LoadControl::Trochoidal(t) => trochoid::control(&s, p, &base, t, self.limit.get(), tool_r),
+        }
+    }
+}
+
+/// What a mode gives to [`finish`]: the new curves in cut order (`None`:
+/// unchanged), their marks on the new indices, and the reads of the curves.
+pub(crate) struct Outcome {
+    pub curves: Option<Vec<Curve>>,
+    pub marks: Vec<Mark>,
+    pub reads: Vec<Read>,
+}
+
+/// True when the place `p` of the marked curve is on the span of `m`
+/// (within 1 um).
+pub(crate) fn on_span(m: &Mark, p: Point2) -> bool {
+    match m.span() {
+        Span::Whole => true,
+        Span::Part(pts) => pts.windows(2).any(|w| seg_dist(p, w[0].at(), w[1].at()) <= 1e-3),
+    }
+}
+
+/// The distance from `p` to curve `c` (its closing segment included).
+pub(crate) fn poly_dist(p: Point2, c: &Curve) -> f64 {
+    let pts = c.pts();
+    let close = c.closed().then(|| pts.last().zip(pts.first())).flatten();
+    let segs = pts.windows(2).map(|w| (w[0].at(), w[1].at())).chain(close.map(|(a, b)| (a.at(), b.at())));
+    let d = segs.map(|(a, b)| seg_dist(p, a, b)).fold(f64::INFINITY, f64::min);
+    if pts.len() == 1 { pts.first().map_or(d, |q| (q.at().x - p.x).hypot(q.at().y - p.y)) } else { d }
+}
+
+/// The ordered set with `curves` in this order and `marks` on their
+/// indices; the start side of `s` stays.
+fn rebuild(s: &OrderedSet, curves: Vec<Curve>, marks: Vec<Mark>) -> Result<OrderedSet, Refusal> {
+    // A refusal of the guide set or of the ordered set is this stage's own
+    // failure: it names the load stage, not the constructor (#4176).
+    let kept = |_| Refusal::new(Stage::Load, SET_NOT_KEPT);
+    let gs = GuideSet::with_marks(curves.clone(), marks).map_err(kept)?;
+    let start = curves.first().and_then(|c| c.pts().first()).map_or(s.start(), |q| q.at());
+    OrderedSet::new(&gs, curves, start, s.resolved()).map_err(kept)
+}
+
+/// The controlled set: the readings of `out`, each read above
+/// `limit x (1 + PLAN_TOL)` named with `why`, and one status line note
+/// for each reason. A second read at the same place and load gets no
+/// second record: it is the same cut place (a curve that ends where the
+/// next starts), and the one record names both.
+pub(crate) fn finish(s: &OrderedSet, out: Outcome, limit: f64, mode: &str, why: impl Fn(&Read) -> &'static str) -> Result<Verdict<Controlled>, Refusal> {
+    let cap = limit * (1.0 + PLAN_TOL);
+    let set = match out.curves {
+        None => s.clone(),
+        Some(c) => rebuild(s, c, out.marks)?,
+    };
+    let (mut readings, mut over, mut hot): (Vec<Reading>, Vec<OverLimit>, Vec<Read>) = (Vec::new(), Vec::new(), Vec::new());
+    for rd in &out.reads {
+        readings.push(Reading::new(rd.at, rd.load)?);
+        if rd.load > cap && !hot.iter().any(|h| near(h.at, rd.at) && (h.load - rd.load).abs() <= KERNEL_TOL) {
+            hot.push(*rd);
+            over.push(OverLimit::new(rd.at, rd.load, why(rd))?);
+        }
+    }
+    let mut notes = Vec::new();
+    let mut reasons: Vec<&'static str> = over.iter().map(OverLimit::reason).collect();
+    reasons.sort_unstable();
+    reasons.dedup();
+    for reason in reasons {
+        let mine: Vec<&OverLimit> = over.iter().filter(|o| o.reason() == reason).collect();
+        if let Some(w) = mine.iter().max_by(|a, b| a.load().total_cmp(&b.load())) {
+            let (n, at) = (mine.len(), w.at());
+            let text = format!(
+                "{mode}: {n} cut place(s) above the load limit ae/D {limit:.3}, the worst {:.3} at ({:.3}, {:.3}): {reason}",
+                w.load(),
+                at.x,
+                at.y
+            );
+            notes.push(Note::new(Stage::Load, text)?);
+        }
+    }
+    let ctl = Controlled::new(set, readings, over, limit)?;
+    Ok(Verdict::Done { out: ctl, fallbacks: Vec::new(), notes })
+}
+
+/// True when an earlier curve than `i` (in `curves`) lies within `reach` of `p`.
+pub(crate) fn beside(curves: &[Curve], i: usize, p: Point2, reach: f64) -> bool {
+    curves.iter().take(i).any(|c| poly_dist(p, c) <= reach)
+}
diff --git a/crates/pathkernel/src/load/trochoid.rs b/crates/pathkernel/src/load/trochoid.rs
