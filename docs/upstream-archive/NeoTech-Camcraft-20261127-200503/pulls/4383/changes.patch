@@ -0,0 +1,81 @@
+//! Finding 4 of the #4123 review: each proof names its place, and each
+//! descent move of the entry stays in that place (law 5). A proof for
+//! another place is refused, for every proof kind.
+
+use super::common::{pts, square_region, tool};
+use camcraft_pathkernel::entry::{
+    Area, BAD_AREA, BAD_CHOICE, Entry, EntryChoice, EntryKind, Hole, NO_DESCENT, NO_HOLE, OFF_PROOF, PLUNGE_NOT_ALLOWED, Proof,
+    WRONG_PROOF,
+};
+use camcraft_pathkernel::{Point2, Positive, Region, Stage};
+
+fn area(x0: f64) -> Area {
+    Area::new(square_region(x0, 0.0, 10.0)).unwrap()
+}
+
+fn pitch() -> Positive {
+    Positive::new(Stage::Entry, 1.0).unwrap()
+}
+
+fn entry(kind: EntryKind, at: (f64, f64), proof: Proof, choice: &EntryChoice, plunge: bool) -> Result<Entry, &'static str> {
+    let approach = pts(&[(at.0, at.1)]);
+    Entry::new(kind, approach, pts(&[at, at]), proof, choice, tool(3.0, plunge)).map_err(|e| e.reason())
+}
+
+#[test]
+fn each_entry_kind_needs_its_own_proof() {
+    let c = EntryChoice::new(EntryKind::Helix, 2.0, vec![]).unwrap();
+    let into = || Proof::IntoMaterial { area: area(0.0), angle_or_pitch: pitch() };
+    assert!(entry(EntryKind::Air, (5.0, 5.0), Proof::InAir(area(0.0)), &c, false).is_ok());
+    assert!(entry(EntryKind::ArcLead, (5.0, 5.0), Proof::InAir(area(0.0)), &c, false).is_ok());
+    assert!(entry(EntryKind::ClearedColumn, (5.0, 5.0), Proof::InColumn(area(0.0)), &c, false).is_ok());
+    assert!(entry(EntryKind::Helix, (5.0, 5.0), into(), &c, false).is_ok());
+    assert!(entry(EntryKind::Ramp, (5.0, 5.0), into(), &c, false).is_ok());
+    assert_eq!(entry(EntryKind::Helix, (5.0, 5.0), Proof::InAir(area(0.0)), &c, false).unwrap_err(), WRONG_PROOF);
+    assert_eq!(entry(EntryKind::Air, (5.0, 5.0), Proof::InColumn(area(0.0)), &c, false).unwrap_err(), WRONG_PROOF);
+    let hole = Hole::new(Point2::new(5.0, 5.0), 4.0).unwrap();
+    assert_eq!(entry(EntryKind::Air, (5.0, 5.0), Proof::InHole(hole), &c, false).unwrap_err(), WRONG_PROOF);
+    let none = Entry::new(EntryKind::Air, vec![], vec![], Proof::InAir(area(0.0)), &c, tool(3.0, false));
+    assert_eq!(none.unwrap_err().reason(), NO_DESCENT);
+}
+
+#[test]
+fn a_descent_outside_the_proved_area_is_refused_for_each_area_proof() {
+    let c = EntryChoice::new(EntryKind::Helix, 2.0, vec![]).unwrap();
+    let far = (25.0, 5.0);
+    assert_eq!(entry(EntryKind::Air, far, Proof::InAir(area(0.0)), &c, false).unwrap_err(), OFF_PROOF);
+    assert_eq!(entry(EntryKind::ClearedColumn, far, Proof::InColumn(area(0.0)), &c, false).unwrap_err(), OFF_PROOF);
+    let into = Proof::IntoMaterial { area: area(0.0), angle_or_pitch: pitch() };
+    assert_eq!(entry(EntryKind::Ramp, far, into, &c, false).unwrap_err(), OFF_PROOF);
+    // On the boundary of the proved area within the tolerance is in it.
+    assert!(entry(EntryKind::Air, (10.0, 5.0), Proof::InAir(area(0.0)), &c, false).is_ok());
+    assert_eq!(Area::new(Region::empty()).unwrap_err().reason(), BAD_AREA);
+}
+
+#[test]
+fn a_predrilled_entry_stays_in_a_known_hole() {
+    let h = Hole::new(Point2::new(5.0, 5.0), 4.0).unwrap();
+    let c = EntryChoice::new(EntryKind::Helix, 2.0, vec![h]).unwrap();
+    assert!(entry(EntryKind::Predrilled, (5.0, 5.0), Proof::InHole(h), &c, false).is_ok());
+    // The tool of radius 3 in a hole of radius 4: the centre may move 1 mm off the hole centre.
+    assert!(entry(EntryKind::Predrilled, (6.0, 5.0), Proof::InHole(h), &c, false).is_ok());
+    // The moves at (0,0) with the proof of the hole at (5,5): refused.
+    assert_eq!(entry(EntryKind::Predrilled, (0.0, 0.0), Proof::InHole(h), &c, false).unwrap_err(), OFF_PROOF);
+    assert_eq!(entry(EntryKind::Predrilled, (6.5, 5.0), Proof::InHole(h), &c, false).unwrap_err(), OFF_PROOF);
+    let other = Hole::new(Point2::new(6.0, 5.0), 4.0).unwrap();
+    assert_eq!(entry(EntryKind::Predrilled, (6.0, 5.0), Proof::InHole(other), &c, false).unwrap_err(), NO_HOLE);
+    let wider = Hole::new(Point2::new(5.0, 5.0), 5.0).unwrap();
+    assert_eq!(entry(EntryKind::Predrilled, (5.0, 5.0), Proof::InHole(wider), &c, false).unwrap_err(), NO_HOLE);
+}
+
+#[test]
+fn a_plunge_needs_the_users_choice_and_a_plunging_tool() {
+    let into = || Proof::IntoMaterial { area: area(0.0), angle_or_pitch: Positive::new(Stage::Entry, 90.0).unwrap() };
+    let asked = EntryChoice::new(EntryKind::Plunge, 0.0, vec![]).unwrap();
+    let other = EntryChoice::new(EntryKind::Ramp, 0.0, vec![]).unwrap();
+    assert!(entry(EntryKind::Plunge, (5.0, 5.0), into(), &asked, true).is_ok());
+    assert_eq!(entry(EntryKind::Plunge, (5.0, 5.0), into(), &asked, false).unwrap_err(), PLUNGE_NOT_ALLOWED);
+    assert_eq!(entry(EntryKind::Plunge, (5.0, 5.0), into(), &other, true).unwrap_err(), PLUNGE_NOT_ALLOWED);
+    assert_eq!(EntryChoice::new(EntryKind::Air, -1.0, vec![]).unwrap_err().reason(), BAD_CHOICE);
+    assert!(Hole::new(Point2::new(f64::NAN, 0.0), 1.0).is_err());
+}
diff --git a/crates/pathkernel/tests/laws/entry_stage.rs b/crates/pathkernel/tests/laws/entry_stage.rs
new file mode 100644
index 000000000..2d1c134dc
--- /dev/null
+++ b/crates/pathkernel/tests/laws/entry_stage.rs
@@ -0,0 +1,210 @@
+//! K5 (#4178): the entry stage plans each entry with a proof (law 5), names
+//! each fallback (law 4), and refuses by name when no entry is safe. Never
+//! a plunge into material that the user did not choose.
+
+use super::common::{curve, square_region, tool};
+use camcraft_pathkernel::entry::{
+    ArcChoice, Entry, EntryChoice, EntryKind, EntryPlanner, EntryStage, Heights, Hole, MaterialChoice, NO_MATERIAL_ENTRY,
+    NO_SAFE_ENTRY, Proof,
+};
+use camcraft_pathkernel::guide::Family;
+use camcraft_pathkernel::plan::Cut;
+use camcraft_pathkernel::{Bounds, KernelRegion, MaterialSide, Point2, Region, Selection, Verdict, WorkPlane, region};
+
+pub fn p(x: f64, y: f64) -> Point2 {
+    Point2::new(x, y)
+}
+
+fn rect(x0: f64, y0: f64, w: f64, h: f64) -> Vec<Point2> {
+    vec![p(x0, y0), p(x0 + w, y0), p(x0 + w, y0 + h), p(x0, y0 + h)]
+}
+
+/// The planner: material top 5 above the level, clearance 2, retract 10;
+/// arc leads of radius 5 and 90 degrees; chords within 0.01 mm.
+pub fn stage() -> EntryStage {
+    EntryStage::new(Heights::new(5.0, 2.0, 10.0).unwrap(), ArcChoice::new(5.0, 90.0).unwrap(), 0.01).unwrap()
+}
+
+/// A closed pocket `w` by `h` from the origin, in a stock that covers it.
+pub fn pocket(w: f64, h: f64, plunges: bool) -> KernelRegion {
+    let bounds = Bounds::new(Some(square_region(-10.0, -10.0, 80.0)), Region::empty(), 0.0, -5.0).unwrap();
+    let sel = Selection::face(rect(0.0, 0.0, w, h), vec![]).unwrap();
+    region(&sel, MaterialSide::Inside, &bounds, WorkPlane::setup_xy(0.0).unwrap(), tool(3.0, plunges), 0.0).unwrap()
+}
+
+/// The open band round a 20 mm part in a 60 mm stock from (-20, -20),
+/// with the keep-out `keep`.
+pub fn band(keep: Region) -> KernelRegion {
+    let bounds = Bounds::new(Some(square_region(-20.0, -20.0, 60.0)), keep, 0.0, -5.0).unwrap();
+    let sel = Selection::face(rect(0.0, 0.0, 20.0, 20.0), vec![]).unwrap();
+    region(&sel, MaterialSide::Outside, &bounds, WorkPlane::setup_xy(0.0).unwrap(), tool(3.0, false), 0.0).unwrap()
+}
+
+/// A closed ring cut through `xy`, counter-clockwise.
+pub fn ring(xy: &[(f64, f64)]) -> Cut {
+    Cut::new(curve(xy, true, 0, Family::Ring), None).unwrap()
+}
+
+/// The ring of the 40 mm pocket, 10 mm in from its walls.
+pub fn pocket_ring() -> Cut {
+    ring(&[(10.0, 10.0), (30.0, 10.0), (30.0, 30.0), (10.0, 30.0)])
+}
+
+/// The ring on the stock outline of [`band`], from (10, -20).
+pub fn edge_ring() -> Cut {
+    ring(&[(10.0, -20.0), (40.0, -20.0), (40.0, 40.0), (-20.0, 40.0), (-20.0, -20.0)])
+}
+
+fn choice(k: EntryKind) -> EntryChoice {
+    EntryChoice::new(k, 1.0, vec![]).unwrap()
+}
+
+fn plan(cut: &Cut, r: &KernelRegion, cleared: &Region, e: &EntryChoice) -> Result<Verdict<Entry>, &'static str> {
+    let s: &dyn EntryPlanner = &stage();
+    s.entry(cut, r, cleared, e).map_err(|e| e.reason())
+}
+
+
+/// The entry and its fallbacks as (asked, used) names.
+fn done(v: Verdict<Entry>) -> (Entry, Vec<(&'static str, &'static str)>, Vec<String>) {
+    match v {
+        Verdict::Done { out, fallbacks, notes } => {
+            (out, fallbacks.iter().map(|f| (f.asked(), f.used())).collect(), notes.iter().map(|n| n.text().to_owned()).collect())
+        }
+        other => panic!("the entry stage gives only done verdicts: {other:?}"),
+    }
+}
+
+fn last_descent(e: &Entry) -> Point2 {
+    e.descent().last().unwrap().at()
+}
+
+#[test]
+fn a_closed_pocket_with_no_hole_and_no_helix_or_ramp_is_refused_by_name() {
+    for plunges in [false, true] {
+        let r = pocket(40.0, 40.0, plunges);
+        for k in [EntryKind::Air, EntryKind::ArcLead, EntryKind::Predrilled, EntryKind::ClearedColumn] {
+            let s: &dyn EntryPlanner = &stage();
+            let e = s.entry(&pocket_ring(), &r, &Region::empty(), &choice(k)).unwrap_err();
+            assert_eq!(e.reason(), NO_SAFE_ENTRY, "{k:?}");
+            assert_eq!(e.place(), Some(p(10.0, 10.0)));
+            assert!(e.fix_text().is_some_and(|f| f.contains("helix or ramp")));
+        }
+    }
+}
+
+#[test]
+fn an_asked_helix_enters_the_closed_pocket_in_the_centre_area() {
+    let r = pocket(40.0, 40.0, false);
+    let (e, fallbacks, notes) = done(plan(&pocket_ring(), &r, &Region::empty(), &choice(EntryKind::Helix)).unwrap());
+    assert_eq!((e.kind(), fallbacks.len(), notes.len()), (EntryKind::Helix, 0, 0));
+    assert!(matches!(e.proof(), Proof::IntoMaterial { .. }));
+    assert_eq!(e.approach()[0].depth(), 7.0);
+    let end = e.descent().last().unwrap();
+    assert_eq!((end.at(), end.depth()), (p(10.0, 10.0), 0.0));
+    let center = r.planar().unwrap().center().offset(0.01).unwrap();
+    assert!(e.descent().iter().all(|q| center.contains(q.at())), "the helix leaves the centre area");
+    assert!(e.descent().windows(2).all(|w| w[1].depth() < w[0].depth()), "the helix goes down on each move");
+    assert!(e.descent().windows(2).all(|w| w[0].at() != w[1].at()), "no move straight down");
+}
+
+#[test]
+fn an_asked_helix_that_does_not_fit_falls_back_to_a_named_ramp() {
+    let r = pocket(40.0, 6.4, false);
+    let line = Cut::new(curve(&[(5.0, 3.2), (35.0, 3.2)], false, 0, Family::Row), None).unwrap();
+    let (e, fallbacks, _) = done(plan(&line, &r, &Region::empty(), &choice(EntryKind::Helix)).unwrap());
+    assert_eq!(e.kind(), EntryKind::Ramp);
+    assert_eq!(fallbacks, vec![("helix", "ramp")]);
+    assert_eq!(last_descent(&e), p(5.0, 3.2));
+    assert!(e.descent().windows(2).all(|w| w[0].at() != w[1].at()), "no move straight down");
+    // At 0.01 degrees the ramp needs too many passes: refused, never a plunge.
+    let flat = EntryChoice::new(EntryKind::Helix, 1.0, vec![]).unwrap().with_material(MaterialChoice::new(0.01, None).unwrap());
+    let r = pocket(40.0, 6.4, true);
+    assert_eq!(plan(&line, &r, &Region::empty(), &flat).unwrap_err(), NO_MATERIAL_ENTRY);
+}
+
+#[test]
+fn a_plunge_needs_the_users_choice_and_a_plunging_tool() {
+    let (e, fallbacks, _) = done(plan(&pocket_ring(), &pocket(40.0, 40.0, true), &Region::empty(), &choice(EntryKind::Plunge)).unwrap());
+    assert_eq!((e.kind(), fallbacks.len()), (EntryKind::Plunge, 0));
+    let (e, fallbacks, _) = done(plan(&pocket_ring(), &pocket(40.0, 40.0, false), &Region::empty(), &choice(EntryKind::Plunge)).unwrap());
+    assert_eq!(e.kind(), EntryKind::Helix);
+    assert_eq!(fallbacks, vec![("plunge", "helix")]);
+    // A ramp asked with a plunging tool: never a plunge in its place.
+    let (e, _, _) = done(plan(&pocket_ring(), &pocket(40.0, 40.0, true), &Region::empty(), &choice(EntryKind::Ramp)).unwrap());
+    assert_eq!(e.kind(), EntryKind::Ramp);
+}
+
+#[test]
+fn a_predrilled_hole_serves_the_closed_pocket() {
+    let r = pocket(40.0, 40.0, false);
+    let hole = Hole::new(p(20.0, 20.0), 4.0).unwrap();
+    let asked = EntryChoice::new(EntryKind::Predrilled, 1.0, vec![hole]).unwrap();
+    let (e, fallbacks, _) = done(plan(&pocket_ring(), &r, &Region::empty(), &asked).unwrap());
+    assert_eq!((e.kind(), fallbacks.len()), (EntryKind::Predrilled, 0));
+    assert_eq!(e.proof(), &Proof::InHole(hole));
+    assert_eq!(last_descent(&e), p(20.0, 20.0));
+    let lead: Vec<Point2> = e.lead().unwrap().pts().iter().map(|q| q.at()).collect();
+    assert_eq!(lead, vec![p(20.0, 20.0), p(10.0, 10.0)]);
+    // Asked air: the hole serves, and the fallback is named.
+    let air = EntryChoice::new(EntryKind::Air, 1.0, vec![hole]).unwrap();
+    let (_, fallbacks, _) = done(plan(&pocket_ring(), &r, &Region::empty(), &air).unwrap());
+    assert_eq!(fallbacks, vec![("air entry", "pre-drilled hole")]);
+    // A hole narrower than the tool does not serve a tool that cannot plunge.
+    let narrow = EntryChoice::new(EntryKind::Predrilled, 1.0, vec![Hole::new(p(20.0, 20.0), 2.0).unwrap()]).unwrap();
+    assert_eq!(plan(&pocket_ring(), &r, &Region::empty(), &narrow).unwrap_err(), NO_SAFE_ENTRY);
+}
+
+#[test]
+fn a_cleared_column_serves_the_closed_pocket() {
+    let r = pocket(40.0, 40.0, false);
+    let cleared = square_region(14.0, 14.0, 12.0);
+    let (e, fallbacks, _) = done(plan(&pocket_ring(), &r, &cleared, &choice(EntryKind::ClearedColumn)).unwrap());
+    assert_eq!((e.kind(), fallbacks.len()), (EntryKind::ClearedColumn, 0));
+    let Proof::InColumn(col) = e.proof() else { panic!("a column proof") };
+    // The tool disc of radius 3 fits in the cleared square from (14, 14) to (26, 26).
+    let at = last_descent(&e);
+    assert!((17.0 - 0.01..=23.0 + 0.01).contains(&at.x) && (17.0 - 0.01..=23.0 + 0.01).contains(&at.y), "{at:?}");
+    assert!(col.region().offset(0.001).unwrap().contains(at));
+    assert_eq!(e.lead().unwrap().pts().last().unwrap().at(), p(10.0, 10.0));
+}
+
+#[test]
+fn an_open_pocket_enters_in_air_with_an_arc_lead() {
+    let r = band(Region::empty());
+    let air = r.planar().unwrap().air().clone();
+    for asked in [EntryKind::ArcLead, EntryKind::Helix] {
+        let (e, fallbacks, notes) = done(plan(&edge_ring(), &r, &Region::empty(), &choice(asked)).unwrap());
+        assert_eq!((e.kind(), fallbacks.len(), notes.len()), (EntryKind::ArcLead, 0, 0), "{asked:?}");
+        assert!(matches!(e.proof(), Proof::InAir(_)));
+        let at = last_descent(&e);
+        assert!(air.contains(at), "the descent is in the air band: {at:?}");
+        assert!(at.y <= -20.0 - 3.0 - 1.0 + 1e-6, "clear of the stock by the tool radius and the approach: {at:?}");
+        let lead = e.lead().unwrap().pts();
+        assert_eq!((lead[0].at(), lead.last().unwrap().at()), (at, p(10.0, -20.0)));
+        assert!(lead.iter().all(|q| q.at().y <= -20.0 + 0.01 && q.depth() == 0.0), "the lead stays outside the stock");
+    }
+}
+
+/// The distance from `q` to the box from `lo` to `hi`.
+fn off_box(q: Point2, lo: Point2, hi: Point2) -> f64 {
+    let dx = (lo.x - q.x).max(q.x - hi.x).max(0.0);
+    let dy = (lo.y - q.y).max(q.y - hi.y).max(0.0);
+    dx.hypot(dy)
+}
+
+#[test]
+fn an_air_entry_at_the_stock_edge_keeps_off_a_clamp() {
+    let free = done(plan(&edge_ring(), &band(Region::empty()), &Region::empty(), &choice(EntryKind::ArcLead)).unwrap()).0;
+    // A clamp from (3, -26) to (4, -25) stands where the free entry comes down.
+    let (lo, hi) = (p(3.0, -26.0), p(4.0, -25.0));
+    assert!(off_box(last_descent(&free), lo, hi) < 3.0, "the clamp is in the way of the free entry");
+    let r = band(square_region(3.0, -26.0, 1.0));
+    let (e, _, notes) = done(plan(&edge_ring(), &r, &Region::empty(), &choice(EntryKind::ArcLead)).unwrap());
+    assert_eq!(e.kind(), EntryKind::ArcLead);
+    let moves = e.descent().iter().chain(e.lead().unwrap().pts());
+    for q in moves {
+        assert!(off_box(q.at(), lo, hi) >= 3.0 - 0.01, "the tool touches the clamp at {:?}", q.at());
+    }
+    assert!(notes.iter().any(|n| n.contains("flown at 2.500 mm")), "{notes:?}");
+}
diff --git a/crates/pathkernel/tests/laws/exit.rs b/crates/pathkernel/tests/laws/exit.rs
new file mode 100644
index 000000000..a7e6960dc
--- /dev/null
+++ b/crates/pathkernel/tests/laws/exit.rs
@@ -0,0 +1,97 @@
+//! K5 (#4178): the exit is a lead-out in the plane where there is room,
+//! then the retract (no cut on the way out, no rapid in material); a lead
+//! is bound to its room; the fallback rule of law 4; the stage's own
+//! choices refuse bad values by name.
+
+use super::common::{pts, square_region};
+use super::entry_stage::{band, edge_ring, p, pocket, pocket_ring, stage};
+use camcraft_pathkernel::entry::{
+    ArcChoice, Area, BAD_ARC, BAD_EXIT, BAD_HEIGHTS, BAD_MATERIAL_CHOICE, EXIT_OFF_CUT, Entry, EntryChoice, EntryKind,
+    EntryPlanner, Exit, Heights, LEAD_GAP, LEAD_NOT_FLAT, LEAD_OFF_ROOM, LEAD_SHORT, Lead, MaterialChoice,
+    Proof, RAPID_IN_MATERIAL, UNPROVED_LEAD_OUT, named, needs_fallback,
+};
+use camcraft_pathkernel::{PlanePoint, Region, Verdict};
+
+fn room() -> Area {
+    Area::new(square_region(0.0, 0.0, 10.0)).unwrap()
+}
+
+#[test]
+fn the_exit_leads_out_into_the_air_then_retracts() {
+    let s: &dyn EntryPlanner = &stage();
+    let x = s.exit(&edge_ring(), &band(Region::empty()), &Region::empty()).unwrap();
+    assert_eq!(x.retract(), 10.0);
+    let out = x.lead_out().expect("a lead-out in the air");
+    assert_eq!(out[0].at(), p(10.0, -20.0));
+    assert!(out.len() > 2 && out.iter().all(|q| q.at().y <= -20.0 + 0.01 && q.depth() == 0.0), "the lead-out cuts no stock");
+}
+
+#[test]
+fn the_exit_of_a_ring_in_uncut_material_goes_straight_up() {
+    let s: &dyn EntryPlanner = &stage();
+    let r = pocket(40.0, 40.0, false);
+    let x = s.exit(&pocket_ring(), &r, &Region::empty()).unwrap();
+    assert_eq!((x.lead_out(), x.retract()), (None, 10.0));
+    // With the pocket cleared round the ring, the lead-out has room.
+    let x = s.exit(&pocket_ring(), &r, &square_region(0.0, 0.0, 40.0)).unwrap();
+    let out = x.lead_out().expect("a lead-out in cleared material");
+    assert_eq!(out[0].at(), p(10.0, 10.0));
+}
+
+#[test]
+fn an_exit_is_refused_off_its_cut_or_below_the_top() {
+    let lead = Lead::new(pts(&[(1.0, 1.0), (2.0, 1.0)]), &room()).unwrap();
+    assert_eq!(Exit::proved(&pocket_ring(), Some(lead), 10.0, 5.0).unwrap_err().reason(), EXIT_OFF_CUT);
+    assert_eq!(Exit::proved(&pocket_ring(), None, 4.0, 5.0).unwrap_err().reason(), RAPID_IN_MATERIAL);
+    assert_eq!(Exit::proved(&pocket_ring(), None, f64::NAN, 5.0).unwrap_err().reason(), BAD_EXIT);
+    assert!(Exit::proved(&pocket_ring(), None, 5.0, 5.0).is_ok());
+    assert_eq!(Exit::new(Some(pts(&[(1.0, 1.0)])), 5.0).unwrap_err().reason(), UNPROVED_LEAD_OUT);
+}
+
+#[test]
+fn a_lead_stays_flat_and_in_its_room_and_starts_where_the_descent_ends() {
+    assert_eq!(Lead::new(pts(&[(1.0, 1.0)]), &room()).unwrap_err().reason(), LEAD_SHORT);
+    assert_eq!(Lead::new(pts(&[(1.0, 1.0), (12.0, 1.0)]), &room()).unwrap_err().reason(), LEAD_OFF_ROOM);
+    let tilted = vec![PlanePoint::new(p(1.0, 1.0), 0.0).unwrap(), PlanePoint::new(p(2.0, 1.0), -1.0).unwrap()];
+    assert_eq!(Lead::new(tilted, &room()).unwrap_err().reason(), LEAD_NOT_FLAT);
+    let c = EntryChoice::new(EntryKind::Air, 1.0, vec![]).unwrap();
+    let tool = super::common::tool(3.0, false);
+    let lead = || Some(Lead::new(pts(&[(2.0, 2.0), (5.0, 5.0)]), &room()).unwrap());
+    let led = |at| Entry::led(EntryKind::ArcLead, vec![], pts(&[at]), lead(), Proof::InAir(room()), &c, tool);
+    assert!(led((2.0, 2.0)).is_ok());
+    assert_eq!(led((3.0, 2.0)).unwrap_err().reason(), LEAD_GAP);
+}
+
+#[test]
+fn a_fallback_is_named_for_another_kind_than_asked() {
+    use EntryKind::*;
+    assert!(!needs_fallback(Air, ArcLead) && !needs_fallback(ArcLead, Air) && !needs_fallback(Helix, Helix));
+    // Where the tool need not enter material, a safer entry is no fallback.
+    for used in [Air, ArcLead, Predrilled, ClearedColumn] {
+        assert!(!needs_fallback(Helix, used) && !needs_fallback(Ramp, used) && !needs_fallback(Plunge, used));
+    }
+    assert!(needs_fallback(Helix, Ramp) && needs_fallback(Plunge, Helix) && needs_fallback(Air, Predrilled));
+    assert!(needs_fallback(Air, Helix) && needs_fallback(Predrilled, ClearedColumn));
+    let c = EntryChoice::new(Helix, 1.0, vec![]).unwrap();
+    let into = Proof::IntoMaterial { area: room(), angle_or_pitch: camcraft_pathkernel::Positive::new(camcraft_pathkernel::Stage::Entry, 3.0).unwrap() };
+    let ramp = Entry::new(Ramp, vec![], pts(&[(5.0, 5.0)]), into, &c, super::common::tool(3.0, false)).unwrap();
+    let Verdict::Done { fallbacks, .. } = named(ramp, &c, "the helix does not fit", vec![]).unwrap() else { panic!("done") };
+    assert_eq!(fallbacks.len(), 1);
+    assert_eq!((fallbacks[0].asked(), fallbacks[0].used(), fallbacks[0].reason()), ("helix", "ramp", "the helix does not fit"));
+}
+
+#[test]
+fn the_stage_choices_refuse_bad_values_by_name() {
+    assert_eq!(Heights::new(5.0, -1.0, 10.0).unwrap_err().reason(), BAD_HEIGHTS);
+    assert_eq!(Heights::new(5.0, 1.0, 4.0).unwrap_err().reason(), BAD_HEIGHTS);
+    assert_eq!(Heights::new(f64::NAN, 1.0, 4.0).unwrap_err().reason(), BAD_HEIGHTS);
+    assert_eq!(ArcChoice::new(0.0, 90.0).unwrap_err().reason(), BAD_ARC);
+    assert_eq!(ArcChoice::new(1.0, 181.0).unwrap_err().reason(), BAD_ARC);
+    assert_eq!(ArcChoice::new(1.0, 0.0).unwrap_err().reason(), BAD_ARC);
+    for (angle, radius) in [(0.0, None), (90.0, None), (f64::NAN, None), (3.0, Some(0.0)), (3.0, Some(-1.0))] {
+        assert_eq!(MaterialChoice::new(angle, radius).unwrap_err().reason(), BAD_MATERIAL_CHOICE);
+    }
+    let m = MaterialChoice::new(5.0, Some(1.0)).unwrap();
+    assert_eq!((m.angle(), m.helix_radius()), (5.0, Some(1.0)));
+    assert_eq!(MaterialChoice::default().angle(), 3.0);
+}
diff --git a/crates/pathkernel/tests/laws/grid.rs b/crates/pathkernel/tests/laws/grid.rs
new file mode 100644
index 000000000..9fe50d363
--- /dev/null
+++ b/crates/pathkernel/tests/laws/grid.rs
@@ -0,0 +1,195 @@
+//! The stock grid that the law checks own (#4027): a raster of the stock
+//! footprint, written apart from any planner's stock reader (record "The
+//! laws as checks": an independent stock grid). It walks a plan step by
+//! step, reads each entry and each cut on the stock as it is at that step,
+//! and clears the swept disc of the tool.
+//! Provenance: our own design record; the radial engagement ae/D from the
+//! contact angle of the cutting edge (Stori & Wright 2000).
+
+use camcraft_pathkernel::entry::{EntryKind, Proof};
+use camcraft_pathkernel::plan::{Plan, Step};
+use camcraft_pathkernel::{Point2, Region};
+
+use super::kit::{dist, poly};
+
+/// The grid cell is this part of the tool radius.
+pub const CELL: f64 = 0.1;
+/// The read error of an engagement on the grid: one cell at each side of
+/// the width, over the diameter.
+pub const GRID_TOL: f64 = CELL;
+
+pub struct Grid {
+    x0: f64,
+    y0: f64,
+    h: f64,
+    nx: usize,
+    ny: usize,
+    cells: Vec<bool>,
+}
+
+impl Grid {
+    /// The raster of `stock` with the cell side `h`, or `None` for an
+    /// empty stock or a bad cell side.
+    pub fn new(stock: &Region, h: f64) -> Option<Self> {
+        let (lo, hi) = stock.bounds()?;
+        if !(h > 0.0 && h.is_finite()) {
+            return None;
+        }
+        let nx = ((hi.x - lo.x) / h).ceil() as usize + 1;
+        let ny = ((hi.y - lo.y) / h).ceil() as usize + 1;
+        let mut g = Self { x0: lo.x, y0: lo.y, h, nx, ny, cells: Vec::with_capacity(nx * ny) };
+        for j in 0..ny {
+            for i in 0..nx {
+                let c = g.centre(i, j);
+                g.cells.push(stock.contains(c));
+            }
+        }
+        Some(g)
+    }
+
+    fn centre(&self, i: usize, j: usize) -> Point2 {
+        Point2::new(self.x0 + (i as f64 + 0.5) * self.h, self.y0 + (j as f64 + 0.5) * self.h)
+    }
+
+    /// The index and the centre of each cell whose centre is within `r` of `c`.
+    fn disc(&self, c: Point2, r: f64) -> Vec<(usize, Point2)> {
+        let span = |v: f64, v0: f64, n: usize| {
+            let lo = ((v - r - v0) / self.h).floor().max(0.0) as usize;
+            let hi = (((v + r - v0) / self.h).ceil().max(0.0) as usize).min(n);
+            lo..hi
+        };
+        let mut out = Vec::new();
+        for j in span(c.y, self.y0, self.ny) {
+            for i in span(c.x, self.x0, self.nx) {
+                let q = self.centre(i, j);
+                if dist(q, c) <= r {
+                    out.push((j * self.nx + i, q));
+                }
+            }
+        }
+        out
+    }
+
+    pub fn clear_disc(&mut self, c: Point2, r: f64) {
+        for (k, _) in self.disc(c, r) {
+            self.cells[k] = false;
+        }
+    }
+
+    /// The share of the disc that holds material (cells off the grid are air).
+    pub fn fill(&self, c: Point2, r: f64) -> f64 {
+        let all = std::f64::consts::PI * r * r / (self.h * self.h);
+        let hit = self.disc(c, r).iter().filter(|(k, _)| self.cells[*k]).count();
+        if all > 0.0 { (hit as f64 / all).min(1.0) } else { 0.0 }
+    }
+
+    /// True when the cell at `p` holds material (off the grid: air).
+    fn material(&self, p: Point2) -> bool {
+        let (fx, fy) = ((p.x - self.x0) / self.h, (p.y - self.y0) / self.h);
+        if !(fx >= 0.0 && fy >= 0.0) {
+            return false;
+        }
+        let (i, j) = (fx as usize, fy as usize);
+        i < self.nx && j < self.ny && self.cells[j * self.nx + i]
+    }
+
+    /// ae/D at `c` for the motion direction `d` (a unit vector), from the
+    /// contact angle: the angle of the front half of the cutting edge that
+    /// touches material, read each degree half a cell inside the edge, as
+    /// `(1 - cos angle) / 2` (1 for a full-width slot).
+    pub fn engagement(&self, c: Point2, d: Point2, r: f64) -> f64 {
+        let n = Point2::new(-d.y, d.x);
+        let edge = r - self.h / 2.0;
+        let touch = (-90..=90)
+            .filter(|deg| {
+                let t = f64::from(*deg).to_radians();
+                let (a, b) = (t.cos() * edge, t.sin() * edge);
+                self.material(Point2::new(c.x + a * d.x + b * n.x, c.y + a * d.y + b * n.y))
+            })
+            .count();
+        let angle = (touch as f64).to_radians().min(std::f64::consts::PI);
+        (1.0 - angle.cos()) / 2.0
+    }
+}
+
+/// One read of an entry descent point: the material share under the tool,
+/// the proof, and how far the descent of its entry moves in the plane
+/// (#4406: a descent into material that does not move is a plunge).
+pub struct EntryRead {
+    pub index: usize,
+    pub at: Point2,
+    pub fill: f64,
+    pub into_material: bool,
+    pub kind: EntryKind,
+    /// The largest distance of a descent point from the end of the descent.
+    pub travel: f64,
+}
+
+/// One read of a cut point: its engagement on the stock of that moment.
+pub struct CutRead {
+    pub index: usize,
+    pub at: Point2,
+    pub load: f64,
+}
+
+#[derive(Default)]
+pub struct Walk {
+    pub entries: Vec<EntryRead>,
+    pub cuts: Vec<CutRead>,
+}
+
+/// The points of a polyline at most `step` apart, each with its unit direction.
+pub fn samples(line: &[Point2], step: f64) -> Vec<(Point2, Point2)> {
+    let mut out = Vec::new();
+    for w in line.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        let len = dist(a, b);
+        if len <= 0.0 {
+            continue;
+        }
+        let d = Point2::new((b.x - a.x) / len, (b.y - a.y) / len);
+        let n = (len / step).ceil().max(1.0) as usize;
+        for k in 0..n {
+            let t = k as f64 / n as f64;
+            out.push((Point2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y)), d));
+        }
+    }
+    if let (Some(&(_, d)), Some(&p)) = (out.last(), line.last()) {
+        out.push((p, d));
+    }
+    out
+}
+
+/// Walks `plan` on a fresh grid of `stock` for a tool of radius `r`. An
+/// entry is read before its descent clears the disc; a cut point is read
+/// before the tool clears its disc there. `None` for an empty stock.
+pub fn walk(plan: &Plan, stock: &Region, r: f64) -> Option<Walk> {
+    let mut g = Grid::new(stock, r * CELL)?;
+    let (mut w, mut ne, mut nc) = (Walk::default(), 0, 0);
+    for s in plan.steps() {
+        match s {
+            Step::Entry(e) => {
+                let into_material = matches!(e.proof(), Proof::IntoMaterial { .. });
+                let end = e.descent().last().map(|p| p.at());
+                let travel = end.map_or(0.0, |q| e.descent().iter().map(|p| dist(p.at(), q)).fold(0.0, f64::max));
+                for p in e.descent() {
+                    let read = EntryRead { index: ne, at: p.at(), fill: g.fill(p.at(), r), into_material, kind: e.kind(), travel };
+                    w.entries.push(read);
+                }
+                for p in e.descent() {
+                    g.clear_disc(p.at(), r);
+                }
+                ne += 1;
+            }
+            Step::Cut(c) => {
+                for (p, d) in samples(&poly(c.curve()), r / 4.0) {
+                    w.cuts.push(CutRead { index: nc, at: p, load: g.engagement(p, d, r) });
+                    g.clear_disc(p, r);
+                }
+                nc += 1;
+            }
+            _ => {}
+        }
+    }
+    Some(w)
+}
diff --git a/crates/pathkernel/tests/laws/guide.rs b/crates/pathkernel/tests/laws/guide.rs
new file mode 100644
