+//! #4153 V-Carve baseline: a 90 degree V-bit in a rectangle, a hexagon
+//! and a rectangle too wide for the cone (with and without the flat
+//! clear), and a 60 degree bit.
+
+use super::{pin, poly, rect, region};
+use camcraft_motion::machining2d::{VCarveParams, v_carve};
+
+fn params() -> VCarveParams {
+    VCarveParams {
+        angle_deg: 90.0,
+        tool_diameter: 12.0,
+        clearance_z: 10.0,
+        retract_z: Some(3.0),
+        top_z: 0.0,
+        bottom_z: -6.0,
+        stepdown: 6.0,
+        feed: 600.0,
+        plunge_feed: 200.0,
+        flat_clear: false,
+        flat_stepover: 0.25,
+    }
+}
+
+fn hexagon() -> super::Loop {
+    let pts: Vec<(f64, f64)> = (0..6)
+        .map(|i| {
+            let a = std::f64::consts::TAU * f64::from(i) / 6.0;
+            (8.0 * a.cos(), 8.0 * a.sin())
+        })
+        .collect();
+    poly(&pts)
+}
+
+#[test]
+fn kernel_baseline_v_carve() {
+    let narrow = region(vec![rect(0.0, 0.0, 30.0, 8.0)]);
+    let hex = region(vec![hexagon()]);
+    let wide = region(vec![rect(0.0, 0.0, 40.0, 20.0)]);
+    let shallow = VCarveParams { bottom_z: -3.0, stepdown: 3.0, ..params() };
+    let cases: [(&str, &_, VCarveParams); 5] = [
+        ("narrow", &narrow, params()),
+        ("hexagon", &hex, params()),
+        ("wide", &wide, shallow),
+        ("wide_flat_clear", &wide, VCarveParams { flat_clear: true, ..shallow }),
+        ("narrow_60deg", &narrow, VCarveParams { angle_deg: 60.0, ..params() }),
+    ];
+    for (case, reg, p) in cases {
+        pin("v_carve", case, &v_carve(reg, &p).unwrap_or_else(|e| panic!("{case}: {e}")));
+    }
+}
diff --git a/crates/motion/tests/pass_start_levels/kernel_guides.rs b/crates/motion/tests/pass_start_levels/kernel_guides.rs
new file mode 100644
index 000000000..48135975a
--- /dev/null
+++ b/crates/motion/tests/pass_start_levels/kernel_guides.rs
@@ -0,0 +1,243 @@
+//! #4176 (second part): the kernel's trace, medial and helix guides
+//! (`camcraft-pathkernel`, K2) against the recorded old output (the #4153
+//! `kernel_*` goldens). Only the guide geometry is compared: the places of
+//! the cut moves at a cut level, the radii of the rings and the radius,
+//! pitch and hand of a thread helix. The order, the links, the entries and
+//! the levels are stages 4 to 6. Where the old output is correct the
+//! kernel guide lies on it. The named differences:
+//! - Bore: the old rings are spaced evenly (`rc * k / count`); the kernel
+//!   spaces them at the stepover from the wall, so the recipe gives the
+//!   stepover `rc / count` to get the same rings;
+//! - Bore and Circular: the old rings are 256 or 2^n chords; the kernel
+//!   rings are exact circles with a chord count from the tolerance (#3756);
+//! - the wide slot: the old plan cuts rows across the centre band (y = -4,
+//!   -1, 2, 4); the medial guide is the one centre line (y = 0) of the
+//!   band, inside the old rows: rows across a slot are the row family;
+//! - Engrave with an avoid item: not compared, because the old keep-out
+//!   comes from an avoid item with its own pad; the kernel takes the
+//!   keep-out as a value. The case without avoid is compared.
+
+use camcraft_motion::geo2d::Point2;
+use camcraft_motion::pathkernel::guide::{
+    Circle, Curve, GuideChoice, GuidePlanner, GuideSet, Guides, Hand, HelixChoice, RingRef, RingsChoice, TraceOffset,
+};
+use camcraft_motion::pathkernel::{
+    Bounds, Chain, MaterialSide, Region, Selection, ToolShape, WorkPlane, chain_region, region,
+};
+
+const TOL: f64 = 1e-3;
+/// Two paths agree where their points are this close (mm).
+const AGREE: f64 = 0.02;
+
+/// One cut move of a golden: its end, and the centre and the sense of an arc.
+#[derive(Clone, Copy, Debug)]
+struct Move {
+    to: (f64, f64, f64),
+    arc: Option<(Point2, bool)>,
+}
+
+/// The `Plunge`, `Feed` and `Arc` moves of a golden CL text (coordinates
+/// in um): a plunge ends at the cut level.
+fn moves(name: &str) -> Vec<Move> {
+    let file = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/golden").join(name);
+    let text = std::fs::read_to_string(&file).expect("golden");
+    let mut out = Vec::new();
+    for line in text.lines() {
+        let w: Vec<&str> = line.split_whitespace().collect();
+        let num = |i: usize| w.get(i).and_then(|s| s.parse::<f64>().ok()).map(|v| v / 1000.0);
+        let tag = |c: char| w.iter().find_map(|t| t.strip_prefix(c).and_then(|v| v.parse::<f64>().ok()));
+        let (Some(x), Some(y), Some(z)) = (num(1), num(2), num(3)) else { continue };
+        match w.first() {
+            Some(&"Feed" | &"Plunge") => out.push(Move { to: (x, y, z), arc: None }),
+            Some(&"Arc") => {
+                let c = Point2::new(tag('I').unwrap_or(0.0) / 1000.0, tag('J').unwrap_or(0.0) / 1000.0);
+                out.push(Move { to: (x, y, z), arc: Some((c, tag('S').unwrap_or(0.0) > 0.0)) });
+            }
+            _ => {}
+        }
+    }
+    out
+}
+
+/// The ends of the cut moves at the level `z`.
+fn at_level(name: &str, z: f64) -> Vec<Point2> {
+    moves(name).into_iter().filter(|m| (m.to.2 - z).abs() < 5e-4).map(|m| Point2::new(m.to.0, m.to.1)).collect()
+}
+
+fn seg(q: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let l2 = dx * dx + dy * dy;
+    let t = if l2 > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+    (q.x - a.x - t * dx).hypot(q.y - a.y - t * dy)
+}
+
+fn walk(c: &Curve) -> Vec<Point2> {
+    let mut v: Vec<Point2> = c.pts().iter().map(|p| p.at()).collect();
+    if c.closed()
+        && let Some(&f) = v.first()
+    {
+        v.push(f);
+    }
+    v
+}
+
+fn to_set(set: &GuideSet, q: Point2) -> f64 {
+    set.curves().iter().flat_map(|c| walk(c).windows(2).map(|w| seg(q, w[0], w[1])).collect::<Vec<_>>()).fold(f64::INFINITY, f64::min)
+}
+
+fn to_points(pts: &[Point2], q: Point2) -> f64 {
+    pts.iter().map(|p| (p.x - q.x).hypot(p.y - q.y)).fold(f64::INFINITY, f64::min)
+}
+
+fn guide(r: &camcraft_motion::pathkernel::KernelRegion, g: GuideChoice) -> GuideSet {
+    let v = Guides.guide(r, &g, TOL).expect("guide");
+    assert!(v.postable(), "{v:?}");
+    v.out().expect("out").clone()
+}
+
+fn xy() -> WorkPlane {
+    WorkPlane::setup_xy(0.0).expect("plane")
+}
+
+fn tool(r: f64) -> ToolShape {
+    ToolShape::disc(r, 0.0, true, 30.0).expect("tool")
+}
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Vec<Point2> {
+    vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)]
+}
+
+fn disc(cx: f64, cy: f64, r: f64, n: u32) -> Vec<Point2> {
+    (0..n).map(|k| f64::from(k) * std::f64::consts::TAU / f64::from(n)).map(|a| Point2::new(cx + r * a.cos(), cy + r * a.sin())).collect()
+}
+
+/// A slot of half-width `w` round (0, 0)-(`len`, 0), counter-clockwise.
+fn stadium(len: f64, w: f64) -> Vec<Point2> {
+    let half = |cx: f64, a0: f64| (0..=64).map(move |i| a0 + std::f64::consts::PI * f64::from(i) / 64.0).map(move |a| Point2::new(cx + w * a.cos(), w * a.sin()));
+    half(len, -std::f64::consts::FRAC_PI_2).chain(half(0.0, std::f64::consts::FRAC_PI_2)).collect()
+}
+
+/// A trace on the chains themselves (offset 0): every old cut point is on a
+/// kernel curve, and every kernel vertex is an old cut point.
+fn trace_agrees(chains: Vec<Chain>, golden: &str, z: f64) {
+    let r = chain_region(&Selection::new(chains).expect("sel"), xy(), tool(1.0), Region::empty()).expect("region");
+    let set = guide(&r, GuideChoice::Trace(TraceOffset::new(0.0).expect("offset")));
+    let old = at_level(golden, z);
+    assert!(!old.is_empty(), "{golden}: no cut at {z}");
+    for q in &old {
+        assert!(to_set(&set, *q) <= AGREE, "{golden}: old point {q:?} is off the kernel trace");
+    }
+    for q in set.curves().iter().flat_map(|c| c.pts().iter().map(|p| p.at())) {
+        assert!(to_points(&old, q) <= AGREE, "{golden}: kernel vertex {q:?} is not an old cut point");
+    }
+}
+
+#[test]
+fn kernel_trace_is_the_old_trace_of_the_plate_and_the_round_loop() {
+    let plate = vec![Chain::closed(rect(-30.0, -20.0, 30.0, 20.0)).unwrap(), Chain::closed(rect(-6.0, -6.0, 6.0, 6.0)).unwrap()];
+    trace_agrees(plate, "kernel_trace_plate_climb.cl", -2.0);
+    trace_agrees(vec![Chain::closed(disc(0.0, 0.0, 15.0, 128)).unwrap()], "kernel_trace_round.cl", -2.0);
+}
+
+#[test]
+fn kernel_engrave_lines_are_the_old_engrave_without_an_avoid_item() {
+    let squares = vec![Chain::closed(rect(-28.0, -12.0, -12.0, 12.0)).unwrap(), Chain::closed(rect(12.0, -12.0, 28.0, 12.0)).unwrap()];
+    trace_agrees(squares, "kernel_engrave_avoid_empty.cl", -2.0);
+}
+
+#[test]
+fn kernel_slot_lines_are_the_old_slot_centre() {
+    // A slot as wide as the tool: the trace of its centre segment.
+    let line = vec![Chain::open(vec![Point2::new(0.0, 0.0), Point2::new(60.0, 0.0)]).unwrap()];
+    trace_agrees(line, "kernel_slot_plunge.cl", -3.0);
+    // The wide slot (18 mm, tool 10): the medial line of the centre band
+    // (half-width 4) is the centre segment, inside the old rows.
+    let outline = stadium(60.0, 9.0);
+    let sel = Selection::face(outline, vec![]).expect("slot");
+    let b = Bounds::new(None, Region::empty(), 0.0, -6.0).expect("bounds");
+    let r = region(&sel, MaterialSide::Inside, &b, xy(), tool(5.0), 0.0).expect("region");
+    let set = guide(&r, GuideChoice::Medial);
+    assert_eq!(set.curves().len(), 1, "{set:?}");
+    let pts: Vec<Point2> = set.curves()[0].pts().iter().map(|p| p.at()).collect();
+    assert!(pts.iter().all(|q| q.y.abs() <= 2.0 * TOL), "{pts:?}");
+    let (x0, x1) = pts.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), q| (a.min(q.x), b.max(q.x)));
+    assert!(x0.abs() <= 0.1 && (x1 - 60.0).abs() <= 0.1, "{x0} {x1}");
+    let old = at_level("kernel_slot_wide.cl", -3.0);
+    let (lo, hi) = old.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), q| (a.min(q.y), b.max(q.y)));
+    assert!((lo + 4.0).abs() < 1e-3 && (hi - 4.0).abs() < 1e-3, "the old rows span the band: {lo} {hi}");
+}
+
+/// The radii of the old arcs about `c` at level `z`, largest first.
+fn old_radii(golden: &str, c: Point2, z: f64) -> Vec<f64> {
+    let mut r: Vec<f64> = moves(golden)
+        .into_iter()
+        .filter(|m| (m.to.2 - z).abs() < 5e-4)
+        .filter_map(|m| m.arc.filter(|(o, _)| (o.x - c.x).hypot(o.y - c.y) < 1e-3).map(|_| (m.to.0 - c.x).hypot(m.to.1 - c.y)))
+        .collect();
+    r.sort_by(|a, b| b.total_cmp(a));
+    r.dedup_by(|a, b| (*a - *b).abs() < 2e-3);
+    r
+}
+
+fn ring_radii(set: &GuideSet) -> Vec<f64> {
+    let mut r: Vec<f64> = set.curves().iter().map(|c| c.arc().expect("exact circle").radius()).collect();
+    r.sort_by(|a, b| b.total_cmp(a));
+    r
+}
+
+fn same(a: &[f64], b: &[f64]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).all(|(x, y)| (x - y).abs() <= 2e-3)
+}
+
+#[test]
+fn kernel_circle_rings_have_the_old_radii_of_circular_and_bore() {
+    // Circular: hole 15, tool 8, step 3: centre radius 11.
+    let hole = |c: Point2, r: f64, t: f64| {
+        let sel = Selection::face(disc(c.x, c.y, r, 1024), vec![]).expect("hole");
+        let b = Bounds::new(None, Region::empty(), 0.0, -4.0).expect("bounds");
+        region(&sel, MaterialSide::Inside, &b, xy(), tool(t), 0.0).expect("region")
+    };
+    let o = Point2::new(0.0, 0.0);
+    let rings = |c: Point2, rc: f64, step: f64| {
+        GuideChoice::Rings(RingsChoice::new(RingRef::Boundary, 0.0, step, Some(Circle::new(c, rc).expect("circle")), None).expect("rings"))
+    };
+    let set = guide(&hole(o, 15.0, 4.0), rings(o, 11.0, 3.0));
+    for z in [-2.0, -4.0] {
+        let old = old_radii("kernel_circular_auto.cl", o, z);
+        assert!(same(&ring_radii(&set), &old), "Circular at {z}: kernel {:?} against old {old:?}", ring_radii(&set));
+    }
+    // Bore: hole 10 at (5, 5), tool 6: centre radius 7, three even rings.
+    let c = Point2::new(5.0, 5.0);
+    let set = guide(&hole(c, 10.0, 3.0), rings(c, 7.0, 7.0 / 3.0));
+    for z in [-2.0, -4.0] {
+        let old = old_radii("kernel_bore_auto.cl", c, z);
+        assert!(same(&ring_radii(&set), &old), "Bore at {z}: kernel {:?} against old {old:?}", ring_radii(&set));
+    }
+}
+
+#[test]
+fn kernel_thread_helix_has_the_old_radius_pitch_and_hand() {
+    let c = Point2::new(10.0, 20.0);
+    for (golden, hand) in [("kernel_thread_internal_right_climb.cl", Hand::Right), ("kernel_thread_internal_left_climb.cl", Hand::Left)] {
+        let arcs: Vec<Move> = moves(golden).into_iter().filter(|m| m.arc.is_some_and(|(o, _)| (o.x - c.x).hypot(o.y - c.y) < 1e-3)).collect();
+        let last = arcs.last().copied().expect("helix arcs");
+        let rho = (last.to.0 - c.x).hypot(last.to.1 - c.y);
+        // The old helix: half turns of 0.75 mm (pitch 1.5); its hand from
+        // the sense of the arcs and the sign of the climb.
+        let pair = arcs.windows(2).last().expect("two arcs");
+        let dz = pair[1].to.2 - pair[0].to.2;
+        assert!((dz.abs() - 0.75).abs() < 1e-3, "{golden}: {dz}");
+        let ccw = last.arc.is_some_and(|(_, s)| s);
+        let old_hand = if ccw == (dz > 0.0) { Hand::Right } else { Hand::Left };
+        assert_eq!(old_hand, hand, "{golden}");
+        let sel = Selection::face(disc(c.x, c.y, 5.0, 1024), vec![]).expect("hole");
+        let b = Bounds::new(None, Region::empty(), 0.0, -6.0).expect("bounds");
+        let r = region(&sel, MaterialSide::Inside, &b, xy(), tool(1.0), 0.0).expect("region");
+        let g = GuideChoice::Helix(HelixChoice::new(Circle::new(c, rho).expect("circle"), 1.5, 6.0, hand).expect("helix"));
+        let set = guide(&r, g);
+        let h = &set.curves()[0];
+        let lead = h.lead().expect("lead");
+        assert_eq!((lead.pitch(), lead.hand()), (1.5, hand), "{golden}");
+        assert!(h.pts().iter().all(|p| ((p.at().x - c.x).hypot(p.at().y - c.y) - rho).abs() < 1e-9), "{golden}");
+    }
+}
diff --git a/crates/motion/tests/pass_start_levels/kernel_rings.rs b/crates/motion/tests/pass_start_levels/kernel_rings.rs
new file mode 100644
index 000000000..511688756
--- /dev/null
+++ b/crates/motion/tests/pass_start_levels/kernel_rings.rs
@@ -0,0 +1,218 @@
+//! #4176: the kernel's ring guide (`camcraft-pathkernel`, K2) against the
+//! recorded rings of the old planner (the #3750 goldens of
+//! `shared_planner.rs`), on the dog bone and on the band round a disc.
+//! Where the old rings are correct the kernel rings lie on them. The named
+//! differences:
+//! - the old 2D Offset also walks the stock outline; the kernel's rings
+//!   round the part end at the last level, whose tool disc already cuts
+//!   past the stock outline (the outline is air: #4025 decision 4);
+//! - the old Inside and Outside plans of the band build their own pieces
+//!   for each start side (#3316, the defect of #3750); the kernel has one
+//!   ring set, and it is the old Auto set;
+//! - the helix turns and the links are stages 6 and 5, not the guide;
+//! - `offset2d_dogbone_auto_blind.cl` is not compared: without the stock
+//!   the old plan rings the part out to the band's outer edge, and the
+//!   kernel cannot tell the part walls from the stock edge (an Outside
+//!   region needs the stock, #4025 decision 8).
+
+use super::{R, STEP, band, rect, region};
+use camcraft_motion::geo2d::{Point2, Region};
+use camcraft_motion::machining2d::{PassStart, StartSide, kernel_bounds_of, kernel_pocket_region};
+use camcraft_motion::pathkernel::guide::{GuideChoice, GuidePlanner, GuideSet, MarkKind, RingPlanner, RingRef, RingsChoice};
+use camcraft_motion::pathkernel::{KernelRegion, MaterialSide, PlanarRegion, ToolShape, WorkPlane};
+
+const TOL: f64 = 1e-3;
+/// Two paths agree where their points are this close (mm): the polygon
+/// offsets of the two planners share the 5 um arc flattening.
+const AGREE: f64 = 0.02;
+
+fn disc(cx: f64, r: f64) -> Vec<Point2> {
+    (0..128)
+        .map(|k| {
+            let a = f64::from(k) * std::f64::consts::TAU / 128.0;
+            Point2::new(cx + r * a.cos(), r * a.sin())
+        })
+        .collect()
+}
+
+/// The dog bone of `shared_planner.rs`: the stock and the band.
+fn dog_bone() -> (Region, Region) {
+    let part = region(vec![disc(-15.0, 12.0)])
+        .union(&region(vec![disc(15.0, 12.0)]))
+        .and_then(|p| p.union(&region(vec![rect(-15.0, -4.0, 15.0, 4.0)])))
+        .expect("part");
+    let stock = region(vec![rect(-40.0, -25.0, 40.0, 25.0)]);
+    let band = stock.offset(R).and_then(|s| s.difference(&part)).expect("band");
+    (stock, band)
+}
+
+fn tool() -> ToolShape {
+    ToolShape::disc(R, 0.0, true, 30.0).expect("tool")
+}
+
+fn xy() -> WorkPlane {
+    WorkPlane::setup_xy(0.0).expect("plane")
+}
+
+fn rings(r: &KernelRegion, reference: RingRef, step: f64) -> GuideSet {
+    let g = GuideChoice::Rings(RingsChoice::new(reference, 0.0, step, None, None).expect("choice"));
+    let v = RingPlanner.guide(r, &g, TOL).expect("rings");
+    assert!(v.postable(), "the kernel rings cover the area: {v:?}");
+    v.out().expect("out").clone()
+}
+
+/// The cut polylines of a golden CL text: runs of `Feed` and `Arc` moves
+/// at the cut level (z = -2 mm), split at each other move. The first point
+/// of a run is where the entry reaches the cut level. Coordinates are in um.
+fn cl_runs(name: &str) -> Vec<Vec<Point2>> {
+    let file = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/golden").join(name);
+    let text = std::fs::read_to_string(&file).expect("golden");
+    let mut runs: Vec<Vec<Point2>> = vec![Vec::new()];
+    for line in text.lines() {
+        let w: Vec<&str> = line.split_whitespace().collect();
+        let num = |i: usize| w.get(i).and_then(|s| s.parse::<f64>().ok());
+        let tag = |c: char| w.iter().find_map(|t| t.strip_prefix(c).and_then(|v| v.parse::<f64>().ok()));
+        let run = runs.last_mut().expect("run");
+        match (w.first(), num(1), num(2), num(3)) {
+            (Some(&"Feed"), Some(x), Some(y), Some(z)) if (z + 2000.0).abs() < 0.5 => run.push(Point2::new(x / 1000.0, y / 1000.0)),
+            (Some(&"Arc"), Some(x), Some(y), Some(z)) if (z + 2000.0).abs() < 0.5 => {
+                let to = Point2::new(x / 1000.0, y / 1000.0);
+                match (run.last().copied(), tag('I'), tag('J'), tag('S')) {
+                    (Some(from), Some(i), Some(j), Some(s)) => run.extend(arc(from, to, Point2::new(i / 1000.0, j / 1000.0), s > 0.0)),
+                    // The last helix turn: the tool reaches the cut level here.
+                    _ => run.push(to),
+                }
+            }
+            _ => runs.push(Vec::new()),
+        }
+    }
+    runs.into_iter().filter(|r| r.len() >= 2).collect()
+}
+
+/// The points of an arc from `from` to `to` round `c` (counter-clockwise
+/// when `ccw`), every 2 degrees, the end included.
+fn arc(from: Point2, to: Point2, c: Point2, ccw: bool) -> Vec<Point2> {
+    let a0 = (from.y - c.y).atan2(from.x - c.x);
+    let a1 = (to.y - c.y).atan2(to.x - c.x);
+    let tau = std::f64::consts::TAU;
+    let sweep = if ccw { (a1 - a0).rem_euclid(tau) } else { -(a0 - a1).rem_euclid(tau) };
+    let sweep = if sweep.abs() < 1e-9 { if ccw { tau } else { -tau } } else { sweep };
+    let rad = (from.x - c.x).hypot(from.y - c.y);
+    let n = ((sweep.abs() / 2f64.to_radians()).ceil() as usize).max(1);
+    (1..=n).map(|i| {
+        let a = a0 + sweep * i as f64 / n as f64;
+        Point2::new(c.x + rad * a.cos(), c.y + rad * a.sin())
+    }).collect()
+}
+
+/// The passes of one start side of `level_rings_band.txt`.
+fn level_passes(start: &str) -> Vec<Vec<Point2>> {
+    let file = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/golden/level_rings_band.txt");
+    let text = std::fs::read_to_string(&file).expect("golden");
+    let mut out = Vec::new();
+    let mut on = false;
+    for line in text.lines() {
+        if line.contains("passes=") {
+            on = line.starts_with(start);
+            continue;
+        }
+        if on && !line.starts_with("note:") {
+            let pts = line.split_whitespace().filter_map(|t| {
+                let (x, y) = t.split_once(',')?;
+                Some(Point2::new(x.parse().ok()?, y.parse().ok()?))
+            });
+            out.push(pts.collect());
+        }
+    }
+    out
+}
+
+fn seg(q: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let l2 = dx * dx + dy * dy;
+    let t = if l2 > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+    (q.x - a.x - t * dx).hypot(q.y - a.y - t * dy)
+}
+
+fn to_runs(runs: &[Vec<Point2>], q: Point2) -> f64 {
+    runs.iter().flat_map(|r| r.windows(2).map(move |w| seg(q, w[0], w[1]))).fold(f64::INFINITY, f64::min)
+}
+
+/// The regular (not clean-up) kernel rings as closed or open polylines.
+fn kernel_runs(set: &GuideSet) -> (Vec<Vec<Point2>>, Vec<Vec<Point2>>) {
+    let fills: Vec<usize> = set.marks().iter().filter(|m| m.kind() == MarkKind::Fill).map(|m| m.curve()).collect();
+    let (mut reg, mut fill) = (Vec::new(), Vec::new());
+    for (i, c) in set.curves().iter().enumerate() {
+        let mut v: Vec<Point2> = c.pts().iter().map(|q| q.at()).collect();
+        if c.closed() {
+            v.push(v[0]);
+        }
+        if fills.contains(&i) { fill.push(v) } else { reg.push(v) }
+    }
+    (reg, fill)
+}
+
+/// The points of `of` farther than [`AGREE`] from the paths `from`.
+fn far(of: &[Vec<Point2>], from: &[Vec<Point2>]) -> Vec<Point2> {
+    of.iter().flatten().copied().filter(|q| to_runs(from, *q) > AGREE).collect()
+}
+
+/// [`far`] for the old runs, less the first point of each run: the end of
+/// an entry (stage 6), not a ring.
+fn far_old(old: &[Vec<Point2>], from: &[Vec<Point2>]) -> Vec<Point2> {
+    old.iter().flat_map(|r| r.iter().skip(1)).copied().filter(|q| to_runs(from, *q) > AGREE).collect()
+}
+
+/// The distance from `q` to the outline of the rectangle `x0..x1, y0..y1`.
+fn to_rect(q: Point2, (x0, y0, x1, y1): (f64, f64, f64, f64)) -> f64 {
+    let c = [Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)];
+    (0..4).map(|i| seg(q, c[i], c[(i + 1) % 4])).fold(f64::INFINITY, f64::min)
+}
+
+#[test]
+fn kernel_rings_lie_on_the_old_offset_rings_of_the_dog_bone() {
+    let (stock, band_) = dog_bone();
+    let side = StartSide { start: PassStart::Inside, stock: Some(stock), around_part: true };
+    let b = kernel_bounds_of(&side, Region::empty(), 0.0, -2.0).expect("bounds");
+    let k = kernel_pocket_region(&band_, &side, &b, xy(), tool(), 0.0).expect("region");
+    assert_eq!(k.planar().map(PlanarRegion::material), Some(MaterialSide::Outside));
+    let set = rings(&k, RingRef::Part, 2.0);
+    let (reg, fill) = kernel_runs(&set);
+    assert!(fill.is_empty(), "the 2 mm step covers the band: no clean-up ring");
+    for n in ["auto", "inside", "outside", "inside_rings", "outside_rings", "inside_arc", "outside_arc"] {
+        let old = cl_runs(&format!("offset2d_dogbone_{n}.cl"));
+        // Every point of the kernel's one ring set is on each old plan.
+        assert_eq!(far(&reg, &old).len(), 0, "{n}: a kernel ring leaves the old path");
+        // The old plan's other points are its pass along the stock
+        // outline (the outer edge of its band, rounded where it meets the
+        // rings): each is within one step of the outline.
+        let extra = far_old(&old, &reg);
+        assert!(!extra.is_empty(), "{n}: the old outline pass is the named difference");
+        assert!(extra.iter().all(|q| to_rect(*q, (-40.0, -25.0, 40.0, 25.0)) < 2.0), "{n}: an old point off the rings, away from the outline");
+    }
+}
+
+#[test]
+fn kernel_rings_of_the_band_are_the_old_auto_rings() {
+    let (_, _, reach) = band();
+    let side = StartSide { start: PassStart::Inside, stock: None, around_part: false };
+    let b = kernel_bounds_of(&side, Region::empty(), 0.0, -2.0).expect("bounds");
+    let pocket = rings(&kernel_pocket_region(&reach, &side, &b, xy(), tool(), 0.0).expect("region"), RingRef::Boundary, STEP);
+    let walls = reach.loops().to_vec();
+    let level = PlanarRegion::new(xy(), reach.clone(), MaterialSide::Inside, walls, vec![], Region::empty(), Region::empty(), tool());
+    let level = rings(&KernelRegion::Planar(level.expect("level region")), RingRef::Boundary, STEP);
+    let cases = [
+        ("2D Pocket", &pocket, cl_runs("pocket_band_auto.cl"), [cl_runs("pocket_band_inside.cl"), cl_runs("pocket_band_outside.cl")]),
+        ("level", &level, level_passes("Auto"), [level_passes("Inside"), level_passes("Outside")]),
+    ];
+    for (name, set, auto, sided) in cases {
+        let (reg, fill) = kernel_runs(set);
+        assert!(fill.is_empty(), "{name}: no clean-up ring on the band");
+        assert_eq!((far(&reg, &auto).len(), far_old(&auto, &reg).len()), (0, 0), "{name}: the kernel rings are the old Auto rings");
+        // The named difference: the old Inside and Outside sets are not the
+        // Auto set (#3750); the kernel has the one set for each side.
+        for old in &sided {
+            assert!(!far(&reg, old).is_empty() || !far_old(old, &reg).is_empty(), "{name}: an old sided set is now the Auto set");
+        }
+    }
+}
diff --git a/crates/motion/tests/pass_start_levels/shared_planner.rs b/crates/motion/tests/pass_start_levels/shared_planner.rs
new file mode 100644
index 000000000..dd0bda05d
--- /dev/null
+++ b/crates/motion/tests/pass_start_levels/shared_planner.rs
@@ -0,0 +1,125 @@
+//! #3750 equivalence pins: the shared ring planner (`ring_set`,
+//! `ring_links`, `ring_entry`) gives the 2D Offset, the 2D Pocket and the
+//! 3-D level the exact output of the head before it. Each golden was
+//! recorded on that head (origin/main 138a592a1) and must not move.
+//! Regenerate only for an intended output change, with
+//! `WRITE_GOLDEN=1 cargo test -p camcraft-motion --test pass_start_levels shared_planner`,
+//! then read the diff in crates/motion/tests/golden/.
+
+use super::{band, params, rect, region};
+use camcraft_motion::cl::{Toolpath, text::to_text};
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Point2, Region};
+use camcraft_motion::machining2d::{
+    CornerRelief, PassStart, PocketParams, PocketStrategy, StartSide, level_ring_plan, pocket_started, pocket_started_on,
+};
+
+fn disc(cx: f64, r: f64) -> Vec<Point2> {
+    (0..128)
+        .map(|k| {
+            let a = f64::from(k) * std::f64::consts::TAU / 128.0;
+            Point2::new(cx + r * a.cos(), r * a.sin())
+        })
+        .collect()
+}
+
+/// The dog-bone part of #3741 (two discs of radius 12, a neck 8 mm wide)
+/// in a stock box of 80 x 50, and the band a 2D Offset round it sweeps.
+fn dog_bone() -> (Region, Region) {
+    let part = region(vec![disc(-15.0, 12.0)])
+        .union(&region(vec![disc(15.0, 12.0)]))
+        .and_then(|p| p.union(&region(vec![rect(-15.0, -4.0, 15.0, 4.0)])))
+        .expect("part");
+    let stock = region(vec![rect(-40.0, -25.0, 40.0, 25.0)]);
+    let band = stock.offset(super::R).and_then(|s| s.difference(&part)).expect("band");
+    (stock, band)
+}
+
+/// Compares `text` with `tests/golden/<name>`, or writes it under
+/// `WRITE_GOLDEN`.
+fn golden(name: &str, text: &str) {
+    let file = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/golden").join(name);
+    if std::env::var_os("WRITE_GOLDEN").is_some() {
+        std::fs::write(&file, text).expect("cannot write the golden file");
+        return;
+    }
+    let want = std::fs::read_to_string(&file).unwrap_or_else(|e| panic!("cannot read golden {}: {e}", file.display()));
+    assert!(want.replace("\r\n", "\n") == text, "golden {} moved: the shared ring planner changed the output", file.display());
+}
+
+/// The CL text of `path` with its notes, one `; note:` line each.
+fn dump(path: &Toolpath) -> String {
+    let mut s = to_text(path).expect("the path has a CL text form");
+    for n in &path.notes {
+        s.push_str(&format!("; note: {}\n", n.replace('\n', " ")));
+    }
+    s
+}
+
+fn offset_params(strategy: PocketStrategy, entry: Entry3D) -> PocketParams {
+    let mut p = params();
+    p.stepover = 2.0;
+    p.strategy = strategy;
+    p.entry = entry;
+    p
+}
+
+/// #3750 pin: the 2D Offset round the dog-bone, for Auto (with and
+/// without a stock footprint), Inside and Outside, for Waterline and
+/// Offset rings, with a Helix and an Arc entry, posts the same CL as the
+/// head before the shared planner.
+#[test]
+fn offset2d_rings_unchanged_by_the_shared_planner() {
+    let (stock, band) = dog_bone();
+    let cases: [(&str, PassStart, bool, PocketStrategy, Entry3D); 8] = [
+        ("auto", PassStart::Auto, true, PocketStrategy::Waterline, Entry3D::Helix),
+        ("auto_blind", PassStart::Auto, false, PocketStrategy::Waterline, Entry3D::Helix),
+        ("inside", PassStart::Inside, true, PocketStrategy::Waterline, Entry3D::Helix),
+        ("outside", PassStart::Outside, true, PocketStrategy::Waterline, Entry3D::Helix),
+        ("inside_rings", PassStart::Inside, true, PocketStrategy::OffsetRings, Entry3D::Helix),
+        ("outside_rings", PassStart::Outside, true, PocketStrategy::OffsetRings, Entry3D::Helix),
+        ("inside_arc", PassStart::Inside, true, PocketStrategy::OffsetRings, Entry3D::Arc),
+        ("outside_arc", PassStart::Outside, true, PocketStrategy::OffsetRings, Entry3D::Arc),
+    ];
+    for (name, start, known, strategy, entry) in cases {
+        let side = StartSide { start, stock: known.then(|| stock.clone()), around_part: true };
+        let p = offset_params(strategy, entry);
+        let path = pocket_started_on(&band, &p, &[], &CornerRelief::default(), &side).expect("plan");
+        golden(&format!("offset2d_dogbone_{name}.cl"), &dump(&path));
+    }
+}
+
+/// #3750 pin: the 2D Pocket on the split band of #3316 (the ring set of
+/// the area's own walls), for Auto, Inside and Outside, posts the same CL
+/// as the head before the shared planner.
+#[test]
+fn pocket_rings_unchanged_by_the_shared_planner() {
+    let (_, _, reach) = band();
+    for (name, start) in [("auto", PassStart::Auto), ("inside", PassStart::Inside), ("outside", PassStart::Outside)] {
+        let path = pocket_started(&reach, &params(), &[], &CornerRelief::default(), start).expect("plan");
+        golden(&format!("pocket_band_{name}.cl"), &dump(&path));
+    }
+}
+
+/// #3750 pin: the 3-D rough's level ring plan (`level_ring_plan`) on the
+/// same band, for each start side, gives the same passes (1 um) and notes.
+#[test]
+fn level_rings_unchanged_by_the_shared_planner() {
+    let (stock, _, reach) = band();
+    let mut s = String::new();
+    for start in [PassStart::Auto, PassStart::Inside, PassStart::Outside] {
+        let side = StartSide { start, stock: Some(stock.clone()), around_part: false };
+        let (passes, notes) =
+            level_ring_plan(&reach, super::R, super::STEP, true, PocketStrategy::Waterline, &side).expect("level plan");
+        s.push_str(&format!("{start:?} passes={}\n", passes.len()));
+        for pass in &passes {
+            let pts: Vec<String> = pass.iter().map(|q| format!("{:.3},{:.3}", q.x, q.y)).collect();
+            s.push_str(&pts.join(" "));
+            s.push('\n');
+        }
+        for n in notes {
+            s.push_str(&format!("note: {}\n", n.replace('\n', " ")));
+        }
+    }
+    golden("level_rings_band.txt", &s);
+}
