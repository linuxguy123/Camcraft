+//! Unit pins of the medial axis (#4176): a slot, a rectangle, an annulus,
+//! the order of the input, and the refusals.
+
+use super::*;
+use crate::geo2d::Loop;
+
+const TOL: f64 = 1e-3;
+const ANGLE: f64 = std::f64::consts::FRAC_PI_3;
+
+fn region(loops: Vec<Vec<Point2>>) -> Region {
+    Region::new(loops.into_iter().map(|l| Loop::new(l).unwrap()).collect()).unwrap()
+}
+
+fn arc(c: Point2, r: f64, a0: f64, a1: f64, n: usize) -> Vec<Point2> {
+    (0..=n).map(|i| a0 + (a1 - a0) * i as f64 / n as f64).map(|a| Point2::new(c.x + r * a.cos(), c.y + r * a.sin())).collect()
+}
+
+/// A slot of half-width `w` round the segment (0, 0)-(len, 0).
+fn stadium(len: f64, w: f64) -> Vec<Point2> {
+    use std::f64::consts::FRAC_PI_2;
+    let mut v = arc(Point2::new(len, 0.0), w, -FRAC_PI_2, FRAC_PI_2, 64);
+    v.extend(arc(Point2::new(0.0, 0.0), w, FRAC_PI_2, 3.0 * FRAC_PI_2, 64));
+    v
+}
+
+fn circle(r: f64, n: usize, ccw: bool) -> Vec<Point2> {
+    let mut v: Vec<Point2> =
+        (0..n).map(|i| std::f64::consts::TAU * i as f64 / n as f64).map(|a| Point2::new(r * a.cos(), r * a.sin())).collect();
+    if !ccw {
+        v.reverse();
+    }
+    v
+}
+
+fn length(c: &MedialCurve) -> f64 {
+    c.points.windows(2).map(|w| dist(w[0], w[1])).sum()
+}
+
+#[test]
+fn the_axis_of_a_slot_is_its_centre_segment() {
+    let ax = region(vec![stadium(40.0, 3.0)]).medial_axis(TOL, ANGLE).unwrap();
+    let long: Vec<&MedialCurve> = ax.curves.iter().filter(|c| length(c) > 1.0).collect();
+    assert_eq!(long.len(), 1, "{ax:?}");
+    let c = long[0];
+    assert!(!c.closed);
+    assert!(c.points.iter().all(|p| p.y.abs() <= 2.0 * TOL), "{:?}", c.points);
+    assert!(c.radii.iter().all(|r| (r - 3.0).abs() <= 0.01), "{:?}", c.radii);
+    let (x0, x1) = c.points.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), p| (a.min(p.x), b.max(p.x)));
+    assert!(x0.abs() <= 0.05 && (x1 - 40.0).abs() <= 0.05, "ends at {x0} and {x1}");
+    // Ramer-Douglas-Peucker leaves a straight axis with few points.
+    assert!(c.points.len() <= 8, "{} points", c.points.len());
+}
+
+#[test]
+fn a_rectangle_has_a_centre_segment_and_four_corner_branches() {
+    let r = region(vec![vec![Point2::new(0.0, 0.0), Point2::new(40.0, 0.0), Point2::new(40.0, 10.0), Point2::new(0.0, 10.0)]]);
+    let ax = r.medial_axis(TOL, ANGLE).unwrap();
+    assert_eq!(ax.curves.len(), 5, "{ax:?}");
+    let mid: Vec<&MedialCurve> = ax.curves.iter().filter(|c| c.points.iter().all(|p| (p.y - 5.0).abs() <= 2.0 * TOL)).collect();
+    assert_eq!(mid.len(), 1, "{ax:?}");
+    let xs: Vec<f64> = mid[0].points.iter().map(|p| p.x).collect();
+    assert!(xs.iter().any(|x| (x - 5.0).abs() <= 0.01) && xs.iter().any(|x| (x - 35.0).abs() <= 0.01), "{xs:?}");
+    // Each corner branch runs from a fork to near its corner on the bisector.
+    for c in ax.curves.iter().filter(|c| !std::ptr::eq(*c, mid[0])) {
+        assert!(c.points.iter().all(|p| (p.y - p.x).abs() <= 0.01 || (p.y + p.x - 10.0).abs() <= 0.01
+            || (p.y - (p.x - 30.0)).abs() <= 0.01 || (p.y + p.x - 40.0).abs() <= 0.01), "{c:?}");
+        assert!(length(c) > 6.5, "{c:?}");
+    }
+}
+
+#[test]
+fn the_axis_of_an_annulus_is_one_closed_circle_midway() {
+    let r = region(vec![circle(10.0, 256, true), circle(6.0, 256, false)]);
+    let ax = r.medial_axis(TOL, ANGLE).unwrap();
+    let ring: Vec<&MedialCurve> = ax.curves.iter().filter(|c| c.closed).collect();
+    assert_eq!(ring.len(), 1, "{ax:?}");
+    assert!(ring[0].points.iter().all(|p| (p.x.hypot(p.y) - 8.0).abs() <= 0.01), "{:?}", ring[0].points);
+    assert!(ax.curves.iter().filter(|c| !c.closed).all(|c| length(c) < 0.1), "{ax:?}");
+}
+
+#[test]
+fn the_axis_does_not_depend_on_the_start_vertex_or_the_loop_order() {
+    let mut a = stadium(30.0, 4.0);
+    let one = region(vec![a.clone(), circle(1.0, 32, false).into_iter().map(|p| Point2::new(p.x + 15.0, p.y)).collect()]);
+    a.rotate_left(17);
+    let two = region(vec![circle(1.0, 32, false).into_iter().map(|p| Point2::new(p.x + 15.0, p.y)).collect(), a]);
+    let (x, y) = (one.medial_axis(TOL, ANGLE).unwrap(), two.medial_axis(TOL, ANGLE).unwrap());
+    assert_eq!(x.curves.len(), y.curves.len());
+    for (c, d) in x.curves.iter().zip(&y.curves) {
+        assert_eq!(c.points.len(), d.points.len());
+        assert!(c.points.iter().zip(&d.points).all(|(p, q)| dist(*p, *q) <= 1e-9));
+    }
+}
+
+#[test]
+fn bad_input_is_refused_not_guessed() {
+    let r = region(vec![stadium(10.0, 2.0)]);
+    assert!(r.medial_axis(0.0, ANGLE).is_err());
+    assert!(r.medial_axis(f64::NAN, ANGLE).is_err());
+    assert!(r.medial_axis(TOL, 0.0).is_err());
+    assert!(Region::empty().medial_axis(TOL, ANGLE).is_err());
+    let big = region(vec![circle(5000.0, 64, true)]);
+    let e = big.medial_axis(1e-6, ANGLE).unwrap_err();
+    assert!(format!("{e}").contains("boundary samples"), "{e}");
+}
+
+#[test]
+fn a_neck_that_touches_gives_an_axis_with_no_crash() {
+    // Two squares that share one corner: the area touches itself there.
+    let r = region(vec![
+        vec![Point2::new(0.0, 0.0), Point2::new(4.0, 0.0), Point2::new(4.0, 4.0), Point2::new(0.0, 4.0)],
+        vec![Point2::new(4.0, 4.0), Point2::new(8.0, 4.0), Point2::new(8.0, 8.0), Point2::new(4.0, 8.0)],
+    ]);
+    let ax = r.medial_axis(TOL, ANGLE).unwrap();
+    assert!(!ax.curves.is_empty());
+}
diff --git a/crates/geometry/src/geo2d/segments.rs b/crates/geometry/src/geo2d/segments.rs
new file mode 100644
index 000000000..9bdfbd955
--- /dev/null
+++ b/crates/geometry/src/geo2d/segments.rs
@@ -0,0 +1,98 @@
+//! The distance between two straight segments in the plane (#4177): zero
+//! where they cross or touch, else the least distance of an end point to
+//! the other segment. The link stage of the path kernel reads it to prove
+//! that a link crosses no cut.
+//! Provenance: the orientation test of two segments and the point-segment
+//! distance, as in O'Rourke, "Computational Geometry in C" (2nd ed., 1998),
+//! ch. 1 and 7; no vendor material consulted.
+
+use super::Point2;
+
+/// The signed area of the triangle `a`, `b`, `c` (twice): positive when
+/// `c` is to the left of the line from `a` to `b`.
+fn orient(a: Point2, b: Point2, c: Point2) -> f64 {
+    (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
+}
+
+/// The distance from `p` to the closed segment `a`-`b` (a point when `a`
+/// and `b` are the same).
+#[must_use]
+pub fn point_segment_distance(p: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / len2).clamp(0.0, 1.0) } else { 0.0 };
+    (p.x - (a.x + t * dx)).hypot(p.y - (a.y + t * dy))
+}
+
+/// True when the segments `a0`-`a1` and `b0`-`b1` cross properly: each one
+/// has the ends of the other strictly on its two sides. A touch, a shared
+/// end or a collinear overlap is not a crossing (the crossing law of the
+/// simulator's verifier reads the same test).
+#[must_use]
+pub fn segments_cross(a0: Point2, a1: Point2, b0: Point2, b1: Point2) -> bool {
+    let (oa, ob) = (orient(b0, b1, a0), orient(b0, b1, a1));
+    let (oc, od) = (orient(a0, a1, b0), orient(a0, a1, b1));
+    ((oa > 0.0 && ob < 0.0) || (oa < 0.0 && ob > 0.0)) && ((oc > 0.0 && od < 0.0) || (oc < 0.0 && od > 0.0))
+}
+
+/// The least distance between the closed segments `a0`-`a1` and `b0`-`b1`:
+/// zero when they cross properly, else the least distance from an end
+/// point of one segment to the other segment. A touch or a collinear
+/// overlap has an end point on the other segment, so it gives zero too. A
+/// point that is not finite gives zero: the two segments are not proved
+/// apart.
+#[must_use]
+pub fn segment_gap(a0: Point2, a1: Point2, b0: Point2, b1: Point2) -> f64 {
+    let finite = [a0, a1, b0, b1].iter().all(|p| p.x.is_finite() && p.y.is_finite());
+    if !finite || segments_cross(a0, a1, b0, b1) {
+        return 0.0;
+    }
+    point_segment_distance(a0, b0, b1)
+        .min(point_segment_distance(a1, b0, b1))
+        .min(point_segment_distance(b0, a0, a1))
+        .min(point_segment_distance(b1, a0, a1))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn p(x: f64, y: f64) -> Point2 {
+        Point2::new(x, y)
+    }
+
+    #[test]
+    fn crossing_segments_have_no_gap() {
+        assert_eq!(segment_gap(p(0.0, 0.0), p(2.0, 2.0), p(0.0, 2.0), p(2.0, 0.0)), 0.0);
+        assert!(segments_cross(p(0.0, 0.0), p(2.0, 2.0), p(0.0, 2.0), p(2.0, 0.0)));
+    }
+
+    #[test]
+    fn a_touch_a_shared_end_and_an_overlap_do_not_cross() {
+        assert!(!segments_cross(p(0.0, 0.0), p(2.0, 0.0), p(1.0, 0.0), p(1.0, 3.0)));
+        assert!(!segments_cross(p(0.0, 0.0), p(2.0, 0.0), p(2.0, 0.0), p(3.0, 1.0)));
+        assert!(!segments_cross(p(0.0, 0.0), p(2.0, 0.0), p(1.0, 0.0), p(3.0, 0.0)));
+        assert!(!segments_cross(p(0.0, 0.0), p(1.0, 0.0), p(2.0, -1.0), p(2.0, 1.0)));
+    }
+
+    #[test]
+    fn apart_segments_have_the_least_end_distance() {
+        let g = segment_gap(p(0.0, 0.0), p(2.0, 0.0), p(1.0, 0.5), p(1.0, 3.0));
+        assert!((g - 0.5).abs() < 1e-12, "{g}");
+        let g = segment_gap(p(0.0, 0.0), p(1.0, 0.0), p(3.0, 0.0), p(4.0, 0.0));
+        assert!((g - 2.0).abs() < 1e-12, "{g}");
+    }
+
+    #[test]
+    fn a_touch_and_an_overlap_have_no_gap() {
+        assert_eq!(segment_gap(p(0.0, 0.0), p(2.0, 0.0), p(1.0, 0.0), p(1.0, 3.0)), 0.0);
+        assert_eq!(segment_gap(p(0.0, 0.0), p(2.0, 0.0), p(1.0, 0.0), p(3.0, 0.0)), 0.0);
+        assert_eq!(segment_gap(p(0.0, 0.0), p(2.0, 0.0), p(2.0, 0.0), p(3.0, 1.0)), 0.0);
+    }
+
+    #[test]
+    fn a_point_segment_and_a_non_finite_point_are_read() {
+        assert!((point_segment_distance(p(1.0, 1.0), p(0.0, 0.0), p(0.0, 0.0)) - 2f64.sqrt()).abs() < 1e-12);
+        assert_eq!(segment_gap(p(f64::NAN, 0.0), p(1.0, 0.0), p(0.0, 1.0), p(1.0, 1.0)), 0.0);
+    }
+}
diff --git a/crates/geometry/src/geo2d/side_offset.rs b/crates/geometry/src/geo2d/side_offset.rs
new file mode 100644
index 000000000..e75e32d75
--- /dev/null
+++ b/crates/geometry/src/geo2d/side_offset.rs
@@ -0,0 +1,200 @@
+//! The offset of an open polyline to one side (#4176): the curves at
+//! distance `|d|` from the polyline on its left (`d > 0`) or its right
+//! (`d < 0`), trimmed where the polyline comes back nearer than `|d|`.
+//! Provenance: the offset curve as the boundary of the Minkowski sum of the
+//! polyline and a disc, with the parts that are nearer to another part of
+//! the polyline removed (the global invalid loops of Tiller and Hanson,
+//! "Offsets of two-dimensional profiles", IEEE CG&A 4, 1984; Choi and
+//! Park, "A pair-wise offset algorithm for 2D point-sequence curve", CAD
+//! 31, 1999). The sum is [`Region::sweep`]; the side and end-cap tests are
+//! ours. Written new; no vendor material consulted.
+
+use super::{GeoError, Point2, Region};
+
+/// One piece of a side offset: its points in the direction of the
+/// polyline, and whether it is a closed loop.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SidePiece {
+    pub points: Vec<Point2>,
+    pub closed: bool,
+}
+
+/// The tolerance (mm) of the end-cap and side tests.
+const SIDE_TOL: f64 = 1e-6;
+
+fn sub(a: Point2, b: Point2) -> (f64, f64) {
+    (a.x - b.x, a.y - b.y)
+}
+
+/// The nearest place of `q` on `path`: the distance, the segment and the
+/// parameter on it.
+fn nearest(path: &[Point2], q: Point2) -> (f64, usize, f64) {
+    let mut best = (f64::INFINITY, 0, 0.0);
+    for (i, w) in path.windows(2).enumerate() {
+        let (dx, dy) = sub(w[1], w[0]);
+        let l2 = dx * dx + dy * dy;
+        let t = if l2 > 0.0 { (((q.x - w[0].x) * dx + (q.y - w[0].y) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+        let d = (q.x - w[0].x - t * dx).hypot(q.y - w[0].y - t * dy);
+        if d < best.0 - SIDE_TOL {
+            best = (d, i, t);
+        }
+    }
+    best
+}
+
+fn unit(a: Point2, b: Point2) -> (f64, f64) {
+    let (dx, dy) = sub(b, a);
+    let l = dx.hypot(dy);
+    if l > 0.0 { (dx / l, dy / l) } else { (0.0, 0.0) }
+}
+
+/// True when `q` (on the boundary of the swept area) is on the left of the
+/// path and not on an end cap.
+fn keep_left(path: &[Point2], q: Point2) -> bool {
+    let n = path.len();
+    let (_, i, t) = nearest(path, q);
+    let (a, b) = (path[i], path[i + 1]);
+    let u = unit(a, b);
+    let v = sub(q, a);
+    let at_start = i == 0 && t <= 0.0;
+    let at_end = i + 2 == n && t >= 1.0;
+    if at_start {
+        return v.0 * u.0 + v.1 * u.1 >= -SIDE_TOL && u.0 * v.1 - u.1 * v.0 > 0.0;
+    }
+    if at_end {
+        let w = sub(q, b);
+        return w.0 * u.0 + w.1 * u.1 <= SIDE_TOL && u.0 * w.1 - u.1 * w.0 > 0.0;
+    }
+    if t > 0.0 && t < 1.0 {
+        return u.0 * v.1 - u.1 * v.0 > 0.0;
+    }
+    // At an inner vertex: the side of the sum of the two left normals.
+    let (c, prev, next) = if t <= 0.0 { (a, path[i - 1], b) } else { (b, a, path[i + 2]) };
+    let (u1, u2) = (unit(prev, c), unit(c, next));
+    let m = (-u1.1 - u2.1, u1.0 + u2.0);
+    let w = sub(q, c);
+    if m.0.hypot(m.1) > SIDE_TOL { w.0 * m.0 + w.1 * m.1 > 0.0 } else { u1.0 * w.1 - u1.1 * w.0 > 0.0 }
+}
+
+/// The offset of the open polyline `path` by `d`: to its left for `d > 0`,
+/// to its right for `d < 0`. The pieces run in the direction of `path`.
+/// The round joins are flattened as the region offset (5 um). Refused for
+/// a path of fewer than two points, a point or a distance that is not
+/// finite, or `d` of zero.
+pub fn offset_side(path: &[Point2], d: f64) -> Result<Vec<SidePiece>, GeoError> {
+    if path.len() < 2 || !path.iter().all(|p| p.x.is_finite() && p.y.is_finite()) {
+        return Err(GeoError::Invalid("side offset: the path needs two or more finite points".into()));
+    }
+    if !d.is_finite() || d == 0.0 {
+        return Err(GeoError::Invalid("side offset: the distance must be finite and not zero".into()));
+    }
+    // The right side of the path is the left side of the reversed path.
+    let mut walk: Vec<Point2> = path.to_vec();
+    walk.dedup_by(|a, b| (a.x - b.x).hypot(a.y - b.y) <= SIDE_TOL);
+    if walk.len() < 2 {
+        return Err(GeoError::Invalid("side offset: the path has no length".into()));
+    }
+    if d < 0.0 {
+        walk.reverse();
+    }
+    let tube = Region::sweep(std::slice::from_ref(&walk), d.abs())?;
+    let mut out = Vec::new();
+    for l in tube.loops() {
+        let v = l.points();
+        let kept: Vec<bool> = v.iter().map(|q| keep_left(&walk, *q)).collect();
+        if kept.iter().all(|k| *k) {
+            out.push(SidePiece { points: v.to_vec(), closed: true });
+            continue;
+        }
+        // Runs of kept points, read round the loop from a point that is out.
+        let Some(s) = kept.iter().position(|k| !k) else { continue };
+        let mut run: Vec<Point2> = Vec::new();
+        for j in 1..=v.len() {
+            let i = (s + j) % v.len();
+            if kept[i] {
+                run.push(v[i]);
+            } else if !run.is_empty() {
+                out.push(SidePiece { points: std::mem::take(&mut run), closed: false });
+            }
+        }
+    }
+    out.retain(|p| p.points.len() >= 2);
+    // Each piece in the direction of the path (the walk for d < 0 is the
+    // path reversed, so its pieces turn back).
+    for p in &mut out {
+        let place = |q: &Point2| {
+            let (_, i, t) = nearest(&walk, *q);
+            i as f64 + t
+        };
+        let forward = match (p.points.first(), p.points.last()) {
+            (Some(a), Some(b)) => place(a) <= place(b),
+            _ => true,
+        };
+        if forward == (d < 0.0) {
+            p.points.reverse();
+        }
+    }
+    out.sort_by(|a, b| {
+        let key = |p: &SidePiece| p.points.first().map_or((0.0, 0.0), |q| (q.y, q.x));
+        key(a).0.total_cmp(&key(b).0).then(key(a).1.total_cmp(&key(b).1))
+    });
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn p(x: f64, y: f64) -> Point2 {
+        Point2::new(x, y)
+    }
+
+    #[test]
+    fn a_straight_line_is_offset_to_its_left_and_its_right() {
+        let line = [p(0.0, 0.0), p(10.0, 0.0)];
+        let left = offset_side(&line, 2.0).unwrap();
+        assert_eq!(left.len(), 1);
+        assert!(left[0].points.iter().all(|q| (q.y - 2.0).abs() < 1e-6 && q.x > -1e-6 && q.x < 10.0 + 1e-6), "{left:?}");
+        assert!(left[0].points.first().unwrap().x < left[0].points.last().unwrap().x, "in the direction of the path");
+        let right = offset_side(&line, -2.0).unwrap();
+        assert_eq!(right.len(), 1);
+        assert!(right[0].points.iter().all(|q| (q.y + 2.0).abs() < 1e-6), "{right:?}");
+        assert!(right[0].points.first().unwrap().x < right[0].points.last().unwrap().x);
+        let span = |s: &[SidePiece]| s[0].points.iter().map(|q| q.x).fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), x| (a.min(x), b.max(x)));
+        let (a, b) = span(&left);
+        assert!(a.abs() < 1e-6 && (b - 10.0).abs() < 1e-6, "the ends are the normal offsets of the path ends: {a} {b}");
+    }
+
+    #[test]
+    fn a_corner_is_round_outside_and_sharp_inside() {
+        // An L turning left at (10, 0): the left side is the inner side.
+        let l = [p(0.0, 0.0), p(10.0, 0.0), p(10.0, 10.0)];
+        let inner = offset_side(&l, 2.0).unwrap();
+        assert_eq!(inner.len(), 1);
+        assert!(inner[0].points.iter().any(|q| (q.x - 8.0).abs() < 1e-6 && (q.y - 2.0).abs() < 1e-6), "the sharp inner corner");
+        let outer = offset_side(&l, -2.0).unwrap();
+        assert_eq!(outer.len(), 1);
+        let d = |q: &Point2| (q.x - 10.0).hypot(q.y);
+        let round: Vec<&Point2> = outer[0].points.iter().filter(|q| q.x > 10.0 && q.y < 0.0).collect();
+        assert!(!round.is_empty() && round.iter().all(|q| (d(q) - 2.0).abs() < 1e-2), "the round join");
+    }
+
+    #[test]
+    fn a_hairpin_trims_the_inner_offset() {
+        // Two legs 2 mm apart: the offset of 3 mm between them is trimmed away.
+        let u = [p(0.0, 0.0), p(20.0, 0.0), p(20.0, 2.0), p(0.0, 2.0)];
+        let between = offset_side(&u, 3.0).unwrap();
+        for s in &between {
+            assert!(s.points.iter().all(|q| nearest(&u, *q).0 >= 3.0 - 1e-3), "{s:?}");
+        }
+    }
+
+    #[test]
+    fn bad_input_is_refused() {
+        assert!(offset_side(&[p(0.0, 0.0)], 1.0).is_err());
+        assert!(offset_side(&[p(0.0, 0.0), p(1.0, 0.0)], 0.0).is_err());
+        assert!(offset_side(&[p(0.0, 0.0), p(1.0, 0.0)], f64::NAN).is_err());
+        assert!(offset_side(&[p(0.0, 0.0), p(f64::INFINITY, 0.0)], 1.0).is_err());
+        assert!(offset_side(&[p(1.0, 1.0), p(1.0, 1.0)], 1.0).is_err());
+    }
+}
