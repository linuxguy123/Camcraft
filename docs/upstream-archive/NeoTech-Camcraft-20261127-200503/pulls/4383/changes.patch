index 000000000..0c758c1d8
--- /dev/null
+++ b/crates/pathkernel/src/guide/all.rs
@@ -0,0 +1,26 @@
+//! The guide stage as one planner (#4176): each guide choice goes to the
+//! planner of its family, never to the planner of another family (law 4).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 2: Guide curves" and law 4.
+
+use super::{GuideChoice, GuidePlanner, GuideSet, HelixPlanner, MedialPlanner, RingPlanner, RowPlanner, TracePlanner};
+use crate::region::KernelRegion;
+use crate::verdict::{Refusal, Verdict};
+
+/// The guide stage: rings (exact circles included) to [`RingPlanner`], rows
+/// to [`RowPlanner`], the medial line to [`MedialPlanner`], the trace to
+/// [`TracePlanner`] and the helix to [`HelixPlanner`].
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Guides;
+
+impl GuidePlanner for Guides {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        match g {
+            GuideChoice::Rings(_) => RingPlanner.guide(r, g, tol),
+            GuideChoice::Rows(_) => RowPlanner.guide(r, g, tol),
+            GuideChoice::Medial => MedialPlanner.guide(r, g, tol),
+            GuideChoice::Trace(_) => TracePlanner.guide(r, g, tol),
+            GuideChoice::Helix(_) => HelixPlanner.guide(r, g, tol),
+        }
+    }
+}
diff --git a/crates/pathkernel/src/guide/choice.rs b/crates/pathkernel/src/guide/choice.rs
new file mode 100644
index 000000000..7dde0be13
--- /dev/null
+++ b/crates/pathkernel/src/guide/choice.rs
@@ -0,0 +1,213 @@
+//! The guide choices of stage 2 (#4176): what a strategy asks of the guide
+//! stage, each a checked value. Moved out of `guide.rs` (first part) with
+//! no change; the helix choice is new (second part).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 2: Guide curves"; the helix of a thread or a helical bore as in
+//! the machine-tool handbooks (one turn for each pitch of descent).
+
+use crate::frame::{Positive, Spot};
+use crate::verdict::{Refusal, Stage};
+use crate::KERNEL_TOL;
+
+/// What the rings are offset from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum RingRef {
+    /// The selected contour.
+    Part,
+    /// All the walls of the area.
+    Boundary,
+    /// The band between the part and the stock edge.
+    Band,
+}
+
+/// An exact circle, for G2/G3 rings (Circular, Bore): a finite centre and
+/// a positive finite radius.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Circle {
+    center: Spot,
+    radius: Positive,
+}
+
+impl Circle {
+    pub fn new(center: crate::Point2, radius: f64) -> Result<Self, Refusal> {
+        Ok(Self { center: Spot::new(Stage::Guide, center)?, radius: Positive::new(Stage::Guide, radius)? })
+    }
+    #[must_use]
+    pub fn center(&self) -> crate::Point2 {
+        self.center.get()
+    }
+    #[must_use]
+    pub fn radius(&self) -> f64 {
+        self.radius.get()
+    }
+    /// The same circle within [`KERNEL_TOL`].
+    #[must_use]
+    pub fn near(&self, o: &Self) -> bool {
+        crate::near(self.center(), o.center()) && (self.radius() - o.radius()).abs() <= KERNEL_TOL
+    }
+}
+
+/// Refusal reason: an offset or an angle that is not finite.
+pub const BAD_OFFSET: &str = "an offset or an angle of the guide is not a finite number";
+/// Refusal reason: a ring count of zero.
+pub const ZERO_COUNT: &str = "a ring count must be one or more";
+/// Refusal reason: a helix of more turns than the planner makes.
+pub const TOO_MANY_TURNS: &str = "the helix needs more turns than the planner makes (10000)";
+
+/// The most turns of one helix.
+pub const MAX_TURNS: f64 = 10_000.0;
+
+/// The rings of a guide: a finite first offset, a positive stepover, an
+/// optional exact circle and an optional count of one or more.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RingsChoice {
+    reference: RingRef,
+    first_offset: f64,
+    stepover: Positive,
+    circle: Option<Circle>,
+    count: Option<u32>,
+}
+
+impl RingsChoice {
+    /// With `circle`, the rings are exact circles about its centre and
+    /// `circle` is the boundary of the cutter-centre area of the hole: ring
+    /// `k` has the radius `circle.radius() - first_offset - k * stepover`.
+    pub fn new(reference: RingRef, first_offset: f64, stepover: f64, circle: Option<Circle>, count: Option<u32>) -> Result<Self, Refusal> {
+        if !first_offset.is_finite() {
+            return Err(Refusal::new(Stage::Recipe, BAD_OFFSET));
+        }
+        if count == Some(0) {
+            return Err(Refusal::new(Stage::Recipe, ZERO_COUNT));
+        }
+        Ok(Self { reference, first_offset, stepover: Positive::new(Stage::Recipe, stepover)?, circle, count })
+    }
+    #[must_use]
+    pub fn reference(&self) -> RingRef {
+        self.reference
+    }
+    #[must_use]
+    pub fn first_offset(&self) -> f64 {
+        self.first_offset
+    }
+    #[must_use]
+    pub fn stepover(&self) -> f64 {
+        self.stepover.get()
+    }
+    #[must_use]
+    pub fn circle(&self) -> Option<Circle> {
+        self.circle
+    }
+    #[must_use]
+    pub fn count(&self) -> Option<u32> {
+        self.count
+    }
+}
+
+/// Parallel rows: a finite angle (degrees), a positive stepover, and a
+/// closing ring or none.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RowsChoice {
+    angle: f64,
+    stepover: Positive,
+    closing_ring: bool,
+}
+
+impl RowsChoice {
+    pub fn new(angle: f64, stepover: f64, closing_ring: bool) -> Result<Self, Refusal> {
+        if !angle.is_finite() {
+            return Err(Refusal::new(Stage::Recipe, BAD_OFFSET));
+        }
+        Ok(Self { angle, stepover: Positive::new(Stage::Recipe, stepover)?, closing_ring })
+    }
+    #[must_use]
+    pub fn angle(&self) -> f64 {
+        self.angle
+    }
+    #[must_use]
+    pub fn stepover(&self) -> f64 {
+        self.stepover.get()
+    }
+    #[must_use]
+    pub fn closing_ring(&self) -> bool {
+        self.closing_ring
+    }
+}
+
+/// The finite offset of a trace guide: above zero to the left of the
+/// chain (in its point order; a closed chain is read counter-clockwise, so
+/// its left is its inside), below zero to the right, zero on the chain.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct TraceOffset(f64);
+
+impl TraceOffset {
+    pub fn new(offset: f64) -> Result<Self, Refusal> {
+        if offset.is_finite() { Ok(Self(offset)) } else { Err(Refusal::new(Stage::Recipe, BAD_OFFSET)) }
+    }
+    #[must_use]
+    pub fn get(self) -> f64 {
+        self.0
+    }
+}
+
+/// The hand of a helix: `Right` rises when it turns counter-clockwise (as
+/// seen from above the plane), `Left` rises when it turns clockwise. The
+/// hand is the shape of the curve; the direction of travel is stage 4.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Hand {
+    Right,
+    Left,
+}
+
+/// One helix about the centre of `circle` at its radius (the cutter-centre
+/// path), from the level of the plan down by `drop`, one turn for each
+/// `pitch` of descent (Thread, a helical bore).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct HelixChoice {
+    circle: Circle,
+    pitch: Positive,
+    drop: Positive,
+    hand: Hand,
+}
+
+impl HelixChoice {
+    /// Refused for a pitch or a drop that is not a positive finite number,
+    /// or more than [`MAX_TURNS`] turns.
+    pub fn new(circle: Circle, pitch: f64, drop: f64, hand: Hand) -> Result<Self, Refusal> {
+        let (pitch, drop) = (Positive::new(Stage::Recipe, pitch)?, Positive::new(Stage::Recipe, drop)?);
+        let turns = drop.get() / pitch.get();
+        if !turns.is_finite() || turns > MAX_TURNS {
+            return Err(Refusal::new(Stage::Recipe, TOO_MANY_TURNS).fix("use a larger pitch or a smaller depth"));
+        }
+        Ok(Self { circle, pitch, drop, hand })
+    }
+    #[must_use]
+    pub fn circle(&self) -> Circle {
+        self.circle
+    }
+    #[must_use]
+    pub fn pitch(&self) -> f64 {
+        self.pitch.get()
+    }
+    #[must_use]
+    pub fn drop(&self) -> f64 {
+        self.drop.get()
+    }
+    #[must_use]
+    pub fn hand(&self) -> Hand {
+        self.hand
+    }
+}
+
+/// The guide of a strategy. Each variant with data holds a checked choice.
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[non_exhaustive]
+pub enum GuideChoice {
+    Rings(RingsChoice),
+    Rows(RowsChoice),
+    /// The centre line of a slot or a channel.
+    Medial,
+    /// The selection itself (engrave, trace, chamfer), at a finite offset.
+    Trace(TraceOffset),
+    /// One helix (Thread, a helical bore).
+    Helix(HelixChoice),
+}
diff --git a/crates/pathkernel/src/guide/cover.rs b/crates/pathkernel/src/guide/cover.rs
new file mode 100644
index 000000000..578205e3d
--- /dev/null
+++ b/crates/pathkernel/src/guide/cover.rs
@@ -0,0 +1,235 @@
+//! The shared parts of the guide planners (#4176): the checked inputs, the
+//! raw curves before they are checked, and the completeness guard of the
+//! record (#3744: the swept discs cover the cutter-centre area up to
+//! 0.1 mm2, else the result is incomplete with each gap named).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 2: Guide curves"; the swept area of a disc as the Minkowski sum of
+//! a path and the disc (the published polygon-offsetting literature).
+
+use super::{Circle, Curve, Family, GuideSet};
+use crate::frame::PlanePoint;
+use crate::guide::mark::Mark;
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Gap, Note, Refusal, Stage, Verdict};
+use crate::{KERNEL_TOL, Loop, Point2, Region};
+
+/// Refusal reason: a guide tolerance that is not a finite number at or
+/// above the kernel tolerance.
+pub const BAD_TOL: &str = "the guide tolerance must be a finite number at or above the kernel tolerance";
+/// Refusal reason: a region that is not a planar area.
+pub const NOT_PLANAR: &str = "this guide planner plans only a planar region";
+/// Refusal reason: an area planner given the chains of a trace.
+pub const NOT_AN_AREA: &str = "this guide planner plans an area: the chains of a trace have no area";
+/// Refusal reason: a polygon operation that cannot be computed.
+pub const GUIDE_GEOMETRY: &str = "the guide geometry cannot be computed: a value is out of range";
+/// Refusal reason: a stepover larger than the tool diameter.
+pub const STEP_ABOVE_DIAMETER: &str = "the stepover is larger than the tool diameter: material between two curves stays uncut";
+
+/// The largest flattening error (mm) of a round join of the polygon
+/// offset of `camcraft-geometry` (5 um): a swept disc can fall short of the
+/// true disc by this much.
+pub(crate) const ARC_SAG: f64 = 5e-3;
+/// The total uncovered area (mm2) that the completeness guard accepts
+/// (record "Stage 2": 0.1 mm2).
+pub(crate) const GUARD_AREA: f64 = 0.1;
+/// The area (mm2) under which an uncovered piece is polygon noise of the
+/// micron lattice, not a gap (one square micron).
+pub(crate) const NOISE_AREA: f64 = 1e-6;
+
+/// A curve before its checks: plane points at depth 0 and its index.
+#[derive(Clone, Debug)]
+pub(crate) struct Raw {
+    pub pts: Vec<Point2>,
+    pub closed: bool,
+    pub k: u32,
+}
+
+impl Raw {
+    /// The walk of the curve as an open path (a closed curve repeats its
+    /// first point at the end), for a sweep or a clip.
+    pub fn walk(&self) -> Vec<Point2> {
+        let mut w = self.pts.clone();
+        if self.closed
+            && let Some(&f) = self.pts.first()
+        {
+            w.push(f);
+        }
+        w
+    }
+}
+
+/// The planar region of `r`, or the refusal.
+pub(crate) fn planar(r: &KernelRegion) -> Result<&PlanarRegion, Refusal> {
+    match r {
+        KernelRegion::Planar(p) => Ok(p),
+        KernelRegion::Chains(_) => Err(Refusal::new(Stage::Guide, NOT_AN_AREA)),
+    }
+}
+
+/// The guide tolerance, checked.
+pub(crate) fn check_tol(tol: f64) -> Result<f64, Refusal> {
+    if tol.is_finite() && tol >= KERNEL_TOL { Ok(tol) } else { Err(Refusal::new(Stage::Guide, BAD_TOL)) }
+}
+
+/// The stepover, checked against the tool diameter.
+pub(crate) fn check_step(step: f64, tool_r: f64) -> Result<f64, Refusal> {
+    let limit = 2.0 * tool_r + KERNEL_TOL;
+    if step > limit { Err(Refusal::new(Stage::Guide, STEP_ABOVE_DIAMETER).fix("use a stepover of the tool diameter or less")) } else { Ok(step) }
+}
+
+/// A geometry result as a guide refusal.
+pub(crate) fn geo<T, E>(r: Result<T, E>) -> Result<T, Refusal> {
+    r.map_err(|_| Refusal::new(Stage::Guide, GUIDE_GEOMETRY))
+}
+
+/// The closed walks of loops, for a sweep.
+pub(crate) fn loop_walks(loops: &[Loop]) -> Vec<Vec<Point2>> {
+    loops.iter().map(|l| l.points().iter().chain(l.points().first()).copied().collect()).collect()
+}
+
+/// The area of `target` that the discs of radius `r` along `curves` do not
+/// cover, with `margin` for the polygon flattening.
+pub(crate) fn uncovered(target: &Region, curves: &[Raw], r: f64, margin: f64) -> Result<Region, Refusal> {
+    let walks: Vec<Vec<Point2>> = curves.iter().map(Raw::walk).collect();
+    geo(target.difference(&geo(Region::sweep(&walks, r + margin))?))
+}
+
+/// The pieces of a region: each outer loop with the holes inside it, as
+/// its own region, with its area (mm2), largest first; then by place.
+pub(crate) fn pieces(r: &Region) -> Result<Vec<(Region, f64)>, Refusal> {
+    let (outer, holes): (Vec<&Loop>, Vec<&Loop>) = r.loops().iter().partition(|l| l.area() > 0.0);
+    let mut out = Vec::with_capacity(outer.len());
+    for o in outer {
+        let shell = geo(Region::new(vec![o.clone()]))?;
+        let mine: Vec<Loop> = holes.iter().filter(|h| h.points().first().is_some_and(|p| shell.contains(*p))).map(|h| (*h).clone()).collect();
+        let mut loops = vec![o.clone()];
+        loops.extend(mine);
+        let piece = geo(Region::new(loops))?;
+        let area = piece.area();
+        out.push((piece, area));
+    }
+    out.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| low(&a.0).total_cmp(&low(&b.0))));
+    Ok(out)
+}
+
+/// A sort key of a region: the least y of its points.
+fn low(r: &Region) -> f64 {
+    r.loops().iter().flat_map(|l| l.points()).map(|p| p.y).fold(f64::INFINITY, f64::min)
+}
+
+/// The lowest point of a region (least y, then x): the place of a gap.
+pub(crate) fn lowest(r: &Region) -> Point2 {
+    r.loops().iter().flat_map(|l| l.points()).copied().min_by(|a, b| a.y.total_cmp(&b.y).then(a.x.total_cmp(&b.x))).unwrap_or_default()
+}
+
+/// The checked curves, their marks and the notes of [`finish`].
+pub(crate) type Finished = (Vec<Curve>, Vec<Mark>, Vec<Note>);
+
+/// The checked curves of the raw curves, with each mark moved to the index
+/// of its curve. A raw curve that the curve checks refuse (a piece below the
+/// kernel tolerance) is named in a note, never dropped silently.
+pub(crate) fn finish(raws: &[Raw], marks: Vec<(usize, Mark)>, family: impl Fn(&Raw) -> Family) -> Result<Finished, Refusal> {
+    finish_arcs(raws, &[], marks, family)
+}
+
+/// [`finish`] with the exact circle of raw curve `i` at `arcs[i]` (none
+/// where `arcs` is shorter).
+pub(crate) fn finish_arcs(raws: &[Raw], arcs: &[Option<Circle>], marks: Vec<(usize, Mark)>, family: impl Fn(&Raw) -> Family) -> Result<Finished, Refusal> {
+    let mut curves = Vec::with_capacity(raws.len());
+    let mut index = vec![None; raws.len()];
+    let mut notes = Vec::new();
+    for (i, raw) in raws.iter().enumerate() {
+        let pts: Result<Vec<PlanePoint>, Refusal> = raw.pts.iter().map(|p| PlanePoint::flat(*p)).collect();
+        match Curve::new(pts?, arcs.get(i).copied().flatten(), raw.closed, raw.k, family(raw)) {
+            Ok(c) => {
+                index[i] = Some(curves.len());
+                curves.push(c);
+            }
+            Err(e) => {
+                // Nothing that a planner made is dropped without a note:
+                // the note names the curve and each mark on it.
+                let at = raw.pts.first().copied().unwrap_or_default();
+                let lost = marks.iter().filter(|(j, _)| *j == i).count();
+                let text = format!("a piece of curve {} at ({:.3}, {:.3}) is not a curve ({}); {lost} mark(s) on it are not kept", raw.k, at.x, at.y, e.reason());
+                notes.push(Note::new(Stage::Guide, text)?);
+            }
+        }
+    }
+    let marks = marks.into_iter().filter_map(|(i, m)| index.get(i).copied().flatten().map(|j| m.renumber(j))).collect();
+    Ok((curves, marks, notes))
+}
+
+/// What a guide choice asks of the area.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Ask {
+    /// Clear the area: more than [`GUARD_AREA`] uncut makes the verdict
+    /// incomplete.
+    Clear,
+    /// A fixed count of rings (Contour): the uncut area is named in a note.
+    Count(u32),
+    /// A line that does not clear the area (the medial line): the uncut
+    /// area is named in a note.
+    Line,
+}
+
+/// The verdict of a guide set by the completeness guard (#4176 review: one
+/// guard for each planner). The guard measures the WHOLE cutter-centre
+/// area of the region (`p.center()`), never an area that a planner derives
+/// from its own parameters: what the tool discs along `raws` leave uncut of
+/// it decides. For [`Ask::Clear`]: done when at most [`GUARD_AREA`] stays
+/// uncut (a remnant above the noise is named in a note); else incomplete
+/// with each gap named. For [`Ask::Count`]: done, with the uncut area named.
+/// The discs are read along the curves of the finished set, so a curve that
+/// the curve checks refused covers nothing.
+pub(crate) fn judge(p: &PlanarRegion, set: GuideSet, mut notes: Vec<Note>, ask: Ask, margin: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    let cut: Vec<Raw> = set.curves().iter().map(|c| Raw { pts: c.pts().iter().map(PlanePoint::at).collect(), closed: c.closed(), k: c.k() }).collect();
+    let left = uncovered(p.center(), &cut, p.tool().radius(), margin)?;
+    let left = &left;
+    let gaps: Vec<(Region, f64)> = pieces(left)?.into_iter().filter(|(_, a)| *a > NOISE_AREA).collect();
+    let total: f64 = gaps.iter().map(|(_, a)| a).sum();
+    let named = match ask {
+        Ask::Count(n) => Some(format!("a count of {n} ring(s) leaves {total:.3} mm2 of the area uncut, as the choice asks")),
+        Ask::Line => Some(format!("the tool along the line(s) leaves {total:.3} mm2 of the area uncut: the guide does not clear the area")),
+        Ask::Clear => None,
+    };
+    if let Some(text) = named {
+        if total > 0.0 {
+            notes.push(Note::new(Stage::Guide, text)?);
+        }
+        return Ok(Verdict::Done { out: set, fallbacks: Vec::new(), notes });
+    }
+    if total > GUARD_AREA {
+        let list: Result<Vec<Gap>, Refusal> = gaps.iter().map(|(g, a)| Gap::new(*a, lowest(g))).collect();
+        let mut v = Verdict::incomplete(Stage::Guide, set, list?)?;
+        if let Verdict::Incomplete { notes: n, .. } = &mut v {
+            n.append(&mut notes);
+        }
+        return Ok(v);
+    }
+    if total > 0.0 {
+        notes.push(Note::new(Stage::Guide, format!("{} uncovered piece(s) of {total:.4} mm2 in all stay under the 0.1 mm2 guard", gaps.len()))?);
+    }
+    Ok(Verdict::Done { out: set, fallbacks: Vec::new(), notes })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::guide::mark::MarkKind;
+
+    #[test]
+    fn a_refused_curve_names_its_marks_in_its_note() {
+        // A closed curve that repeats its first point is refused by the
+        // curve checks; its mark is not kept, and the note says so.
+        let p = |x, y| Point2::new(x, y);
+        let bad = Raw { pts: vec![p(0.0, 0.0), p(1.0, 0.0), p(0.0, 0.0)], closed: true, k: 2 };
+        let good = Raw { pts: vec![p(0.0, 0.0), p(4.0, 0.0)], closed: false, k: 0 };
+        let marks = vec![(0, Mark::whole(0, MarkKind::Fill)), (1, Mark::whole(0, MarkKind::FullWidth))];
+        let (curves, kept, notes) = finish(&[bad, good], marks, |_| Family::Ring).unwrap();
+        assert_eq!(curves.len(), 1);
+        assert_eq!(kept.len(), 1);
+        assert_eq!((kept[0].curve(), kept[0].kind()), (0, MarkKind::FullWidth));
+        assert_eq!(notes.len(), 1);
+        assert!(notes[0].text().contains("1 mark(s) on it are not kept"), "{}", notes[0].text());
+    }
+}
diff --git a/crates/pathkernel/src/guide/helix.rs b/crates/pathkernel/src/guide/helix.rs
new file mode 100644
index 000000000..21f3f99b2
--- /dev/null
+++ b/crates/pathkernel/src/guide/helix.rs
@@ -0,0 +1,177 @@
+//! The helix guide and the exact circle rings of a hole (#4176, K2):
+//! Circular and Bore get concentric circles at the choice's stepover, each
+//! an exact [`Circle`] with a carrier polygon whose chord count follows
+//! the tolerance (#3756: no fixed 256 chords); Thread and a helical bore
+//! get one helix with its circle, pitch and hand.
+//! Provenance: the circular pocket as concentric rings (the level sets of
+//! the distance to the wall of a disc, Held, "On the Computational Geometry
+//! of Pocket Machining", 1991); the chord count of a circle from its sagitta
+//! (`r (1 - cos(pi / n)) <= tol`, elementary geometry); the helix of a
+//! thread mill as in the machine-tool handbooks (one turn for each pitch);
+//! our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 2" and `docs/decisions/4176-kernel-guides-medial-trace-helix.md`.
+//! Written new: no code path of the old Bore, Circular or Thread planners
+//! of `camcraft-motion` is ported.
+
+use std::f64::consts::{PI, TAU};
+
+use super::cover::{ARC_SAG, Ask, Raw, check_step, check_tol, finish_arcs, geo, judge, planar};
+use super::mark::{Mark, MarkKind};
+use super::rings::{MAX_RINGS, NO_RING, OFFSET_BELOW_CENTER, TOO_MANY_RINGS, WALL_STRIP_UNCUT, full_width};
+use super::{Circle, Curve, Family, GuideChoice, GuidePlanner, GuideSet, Hand, HelixChoice, Lead, RingsChoice};
+use crate::frame::PlanePoint;
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Refusal, Stage, Verdict};
+use crate::{KERNEL_TOL, Point2, in_area};
+
+/// Refusal reason: the helix planner was given another guide choice.
+pub const NOT_HELIX: &str = "the helix planner plans only a helix choice";
+/// Refusal reason: exact circle rings on an area that is not the disc of
+/// the circle.
+pub const CIRCLE_NOT_REGION: &str = "exact circle rings need a cutter-centre area that is the disc of the circle";
+/// Refusal reason: a helix that leaves the cutter-centre area.
+pub const HELIX_OUTSIDE: &str = "the helix leaves the cutter-centre area: the tool would cut the wall";
+/// Refusal reason: a helix of more points than the planner makes.
+pub const HELIX_TOO_FINE: &str = "the helix needs more points than the planner makes (1000000)";
+
+/// The most chords of one turn.
+const MAX_CHORDS: f64 = 65_536.0;
+/// The most points of one helix.
+const MAX_HELIX_POINTS: f64 = 1_000_000.0;
+
+/// The helix guide planner. It reads only the region and the helix choice:
+/// no start side, no order, no link (laws 2 and 3). The direction of travel
+/// is stage 4; the hand is the shape of the curve.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct HelixPlanner;
+
+impl GuidePlanner for HelixPlanner {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Helix(h) = g else {
+            return Err(Refusal::new(Stage::Guide, NOT_HELIX));
+        };
+        helix(planar(r)?, h, check_tol(tol)?)
+    }
+}
+
+/// The chords of one turn of a circle of radius `rho`: the least count of
+/// eight or more whose sagitta is within `tol`.
+pub(crate) fn chords(rho: f64, tol: f64) -> f64 {
+    if tol >= rho {
+        return 8.0;
+    }
+    let n = (PI / (1.0 - tol / rho).acos()).ceil();
+    if n.is_finite() { n.clamp(8.0, MAX_CHORDS) } else { MAX_CHORDS }
+}
+
+/// The carrier polygon of a circle: `n` points from the angle 0 (the first
+/// axis of the plane), counter-clockwise.
+fn polygon(c: Point2, rho: f64, n: f64) -> Vec<Point2> {
+    let count = n as u32;
+    (0..count).map(|i| f64::from(i) * TAU / n).map(|a| Point2::new(c.x + rho * a.cos(), c.y + rho * a.sin())).collect()
+}
+
+/// Checks that the cutter-centre area is one loop whose vertices and edge
+/// midpoints are within `tol` and the offset flattening of the circle.
+fn fits(p: &PlanarRegion, circle: Circle, tol: f64) -> Result<(), Refusal> {
+    let (c, r) = (circle.center(), circle.radius());
+    let refuse = |at: Point2| Err(Refusal::new(Stage::Guide, CIRCLE_NOT_REGION).at(at).fix("give the circle of the cutter-centre area of the hole"));
+    let [only] = p.center().loops() else {
+        return refuse(c);
+    };
+    let v = only.points();
+    for (i, a) in v.iter().enumerate() {
+        let b = v[(i + 1) % v.len()];
+        let m = Point2::new(0.5 * (a.x + b.x), 0.5 * (a.y + b.y));
+        for q in [*a, m] {
+            if ((q.x - c.x).hypot(q.y - c.y) - r).abs() > tol + ARC_SAG {
+                return refuse(q);
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The exact circle rings of a hole. Ring `k` has the radius
+/// `circle - first_offset - k * stepover` while it is above the tolerance;
+/// a choice without a count gets a clean-up circle at half the radius of
+/// the last ring when the last ring's disc does not reach the centre. The
+/// single guard ([`judge`]) decides done or incomplete.
+pub(super) fn circle_rings(p: &PlanarRegion, c: &RingsChoice, circle: Circle, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    let rad = p.tool().radius();
+    let step = check_step(c.stepover(), rad)?;
+    let d0 = c.first_offset();
+    if d0 < 0.0 {
+        return Err(Refusal::new(Stage::Guide, OFFSET_BELOW_CENTER));
+    }
+    if c.count().is_none() && d0 > rad + KERNEL_TOL {
+        return Err(Refusal::new(Stage::Guide, WALL_STRIP_UNCUT).fix("use a first offset of the tool radius or less, or a stock to leave on the region"));
+    }
+    fits(p, circle, tol)?;
+    let top = circle.radius() - d0;
+    if top <= tol {
+        return Err(Refusal::new(Stage::Guide, NO_RING).fix("use a smaller first offset"));
+    }
+    if top / step > f64::from(MAX_RINGS) {
+        return Err(Refusal::new(Stage::Guide, TOO_MANY_RINGS).fix("use a larger stepover"));
+    }
+    let (mut raws, mut arcs, mut marks) = (Vec::new(), Vec::new(), Vec::new());
+    let mut push = |raws: &mut Vec<Raw>, rho: f64, k: u32| -> Result<(), Refusal> {
+        raws.push(Raw { pts: polygon(circle.center(), rho, chords(rho, tol)), closed: true, k });
+        arcs.push(Some(Circle::new(circle.center(), rho)?));
+        Ok(())
+    };
+    let mut last = None;
+    for k in 0..MAX_RINGS {
+        let rho = top - f64::from(k) * step;
+        if c.count().is_some_and(|n| k >= n) || rho <= tol {
+            break;
+        }
+        push(&mut raws, rho, k)?;
+        last = Some((rho, k));
+    }
+    if let (None, Some((rho, k))) = (c.count(), last)
+        && rho > rad
+    {
+        // The disc of the last ring leaves the centre of the hole uncut.
+        marks.push((raws.len(), Mark::whole(0, MarkKind::Fill)));
+        push(&mut raws, 0.5 * rho, k.saturating_add(1))?;
+    }
+    let margin = tol + ARC_SAG;
+    full_width(p, &raws, &mut marks, rad, (margin, tol))?;
+    let (curves, marks, notes) = finish_arcs(&raws, &arcs, marks, |_| Family::Ring)?;
+    let ask = c.count().map_or(Ask::Clear, Ask::Count);
+    judge(p, GuideSet::with_marks(curves, marks)?, notes, ask, margin)
+}
+
+/// One helix from the level of the plan (depth 0) down by the drop, from
+/// the angle 0 (the first axis of the plane). A right hand turns clockwise
+/// as it descends, a left hand counter-clockwise.
+fn helix(p: &PlanarRegion, h: &HelixChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    let circle = h.circle();
+    let (c, rho) = (circle.center(), circle.radius());
+    let n = chords(rho, tol);
+    let inside = geo(p.center().offset(tol + ARC_SAG))?;
+    if let Some(q) = polygon(c, rho, n).into_iter().find(|q| !in_area(&inside, *q)) {
+        return Err(Refusal::new(Stage::Guide, HELIX_OUTSIDE).at(q).fix("use a smaller helix radius or a smaller tool"));
+    }
+    let turns = h.drop() / h.pitch();
+    let m = (n * turns).ceil().max(2.0);
+    if !m.is_finite() || m > MAX_HELIX_POINTS {
+        return Err(Refusal::new(Stage::Guide, HELIX_TOO_FINE).fix("use a larger tolerance"));
+    }
+    let way = match h.hand() {
+        Hand::Right => -1.0,
+        Hand::Left => 1.0,
+    };
+    let count = m as u32;
+    let pts = (0..=count)
+        .map(|i| {
+            let f = f64::from(i) / m;
+            let a = way * TAU * turns * f;
+            PlanePoint::new(Point2::new(c.x + rho * a.cos(), c.y + rho * a.sin()), -h.drop() * f)
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let curve = Curve::helix(circle, Lead::new(h.pitch(), h.hand())?, pts, 0)?;
+    Ok(Verdict::done(GuideSet::new(vec![curve])))
+}
diff --git a/crates/pathkernel/src/guide/lead.rs b/crates/pathkernel/src/guide/lead.rs
new file mode 100644
index 000000000..e6cc63cf8
--- /dev/null
+++ b/crates/pathkernel/src/guide/lead.rs
@@ -0,0 +1,87 @@
+//! The lead of a helix curve (#4176): its pitch and its hand, and the
+//! checked constructor of a helix curve, so that a helix is valid by
+//! construction (its points on its circle, its depth along its pitch).
+//! Provenance: the circular helix of the machine-tool handbooks (one turn
+//! for each pitch along the axis); our own design record
+//! `docs/decisions/4024-path-kernel-design.md` "Stage 2: Guide curves".
+
+use std::cmp::Ordering;
+
+use super::{Circle, Curve, Family, Hand};
+use crate::frame::{PlanePoint, Positive};
+use crate::verdict::{Refusal, Stage};
+use crate::KERNEL_TOL;
+
+/// Refusal reason: a curve of the helix family made without a lead.
+pub const HELIX_NEEDS_LEAD: &str = "a helix curve needs its circle and its lead: make it with Curve::helix";
+/// Refusal reason: a helix point off its circle or off its pitch.
+pub const NOT_ON_HELIX: &str = "a helix point is not on its circle at the depth of its pitch and hand";
+
+/// The pitch (the descent along the plane normal in one turn) and the hand
+/// of a helix.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Lead {
+    pitch: Positive,
+    hand: Hand,
+}
+
+impl Lead {
+    pub fn new(pitch: f64, hand: Hand) -> Result<Self, Refusal> {
+        Ok(Self { pitch: Positive::new(Stage::Guide, pitch)?, hand })
+    }
+    #[must_use]
+    pub fn pitch(&self) -> f64 {
+        self.pitch.get()
+    }
+    #[must_use]
+    pub fn hand(&self) -> Hand {
+        self.hand
+    }
+}
+
+pub(super) fn cmp_lead(a: Option<Lead>, b: Option<Lead>) -> Ordering {
+    let key = |l: Option<Lead>| l.map(|l| (l.hand, l.pitch()));
+    match (key(a), key(b)) {
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => Ordering::Less,
+        (Some(_), None) => Ordering::Greater,
+        (Some(x), Some(y)) => x.0.cmp(&y.0).then(x.1.total_cmp(&y.1)),
+    }
+}
+
+pub(super) fn same_lead(a: Option<Lead>, b: Option<Lead>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(x), Some(y)) => x.hand == y.hand && (x.pitch() - y.pitch()).abs() <= KERNEL_TOL,
+        _ => false,
+    }
+}
+
+impl Curve {
+    /// An open helix curve of family [`Family::Helix`] on `circle`. Refused
+    /// unless each point is on the circle and each step turns by less than
+    /// half a turn and changes the depth by `pitch * turn / (2 pi)`: up for a
+    /// counter-clockwise step of a right hand, down for a clockwise one, the
+    /// other way for a left hand (all within [`KERNEL_TOL`]).
+    pub fn helix(circle: Circle, lead: Lead, pts: Vec<PlanePoint>, k: u32) -> Result<Self, Refusal> {
+        let (c, r) = (circle.center(), circle.radius());
+        let off = |p: &PlanePoint| ((p.at().x - c.x).hypot(p.at().y - c.y) - r).abs() > KERNEL_TOL;
+        if pts.iter().any(off) {
+            return Err(Refusal::new(Stage::Guide, NOT_ON_HELIX).at(pts.iter().find(|p| off(p)).map_or(c, PlanePoint::at)));
+        }
+        let sign = match lead.hand {
+            Hand::Right => 1.0,
+            Hand::Left => -1.0,
+        };
+        for w in pts.windows(2) {
+            let (a, b) = ((w[0].at().x - c.x, w[0].at().y - c.y), (w[1].at().x - c.x, w[1].at().y - c.y));
+            let turn = (a.0 * b.1 - a.1 * b.0).atan2(a.0 * b.0 + a.1 * b.1);
+            let rise = sign * lead.pitch() * turn / std::f64::consts::TAU;
+            let bad = turn.abs() >= std::f64::consts::PI - KERNEL_TOL || (w[1].depth() - w[0].depth() - rise).abs() > KERNEL_TOL;
+            if bad {
+                return Err(Refusal::new(Stage::Guide, NOT_ON_HELIX).at(w[1].at()));
+            }
+        }
+        Self::checked(pts, Some(circle), false, k, Family::Helix, Some(lead))
+    }
+}
diff --git a/crates/pathkernel/src/guide/mark.rs b/crates/pathkernel/src/guide/mark.rs
new file mode 100644
index 000000000..6a98c5ec8
--- /dev/null
+++ b/crates/pathkernel/src/guide/mark.rs
@@ -0,0 +1,135 @@
+//! Named stretches of a guide set (#4176): a guide planner names a stretch
+//! that a later stage must act on, in place of a silent choice. The ring
+//! planner names a full-width stretch (#3788, the merge of two lobes) and
+//! a clean-up ring; the row planner names its closing ring.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 2: Guide curves" and the Prime Directive (a full-width cut is
+//! named, not hidden); `docs/decisions/4176-kernel-guides-rings-rows.md`.
+
+use std::cmp::Ordering;
+
+use super::{Curve, cmp_seq};
+use crate::frame::PlanePoint;
+use crate::verdict::{Refusal, Stage};
+use crate::{KERNEL_TOL, seg_dist};
+
+/// What a mark names.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+#[non_exhaustive]
+pub enum MarkKind {
+    /// The tool disc on this stretch overlaps the disc of no deeper curve
+    /// and no air: when the deeper curves are cut first, the tool cuts
+    /// here at full width (180 degrees). The load stage (K3) and the order
+    /// and link stage (K4) act on it.
+    FullWidth,
+    /// A clean-up ring: it cuts an area that the regular rings leave, so
+    /// that the swept discs cover the cutter-centre area.
+    Fill,
+    /// The closing ring that a row choice asks for.
+    Closing,
+}
+
+/// The part of a curve that a mark names.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Span {
+    /// The whole curve.
+    Whole,
+    /// A stretch of the curve: two or more points on it, in its direction.
+    Part(Vec<PlanePoint>),
+}
+
+/// A named stretch of curve `curve` of its guide set.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Mark {
+    curve: usize,
+    kind: MarkKind,
+    span: Span,
+}
+
+/// Refusal reason: a stretch with fewer than two points or no length.
+pub const BAD_STRETCH: &str = "a marked stretch needs two or more points and a length above the kernel tolerance";
+/// Refusal reason: a mark on a curve that the set does not have.
+pub const MARK_NO_CURVE: &str = "a mark names a curve that the guide set does not have";
+/// Refusal reason: a marked stretch with a point off its curve.
+pub const MARK_OFF_CURVE: &str = "a marked stretch has a point that is not on its curve";
+
+impl Mark {
+    /// A mark on the whole of curve `curve`.
+    #[must_use]
+    pub fn whole(curve: usize, kind: MarkKind) -> Self {
+        Self { curve, kind, span: Span::Whole }
+    }
+
+    /// A mark on a stretch of curve `curve`. Refused for fewer than two
+    /// points or a stretch with no length; [`super::GuideSet::with_marks`]
+    /// checks that each point is on the curve.
+    pub fn part(curve: usize, kind: MarkKind, pts: Vec<PlanePoint>) -> Result<Self, Refusal> {
+        let length: f64 = pts.windows(2).map(|w| (w[1].at().x - w[0].at().x).hypot(w[1].at().y - w[0].at().y)).sum();
+        if pts.len() < 2 || !length.is_finite() || length <= KERNEL_TOL {
+            return Err(Refusal::new(Stage::Guide, BAD_STRETCH));
+        }
+        Ok(Self { curve, kind, span: Span::Part(pts) })
+    }
+    /// The index of the marked curve in [`super::GuideSet::curves`].
+    #[must_use]
+    pub fn curve(&self) -> usize {
+        self.curve
+    }
+    #[must_use]
+    pub fn kind(&self) -> MarkKind {
+        self.kind
+    }
+    #[must_use]
+    pub fn span(&self) -> &Span {
+        &self.span
+    }
+
+    /// This mark on curve index `i` of a list that a planner builds.
+    pub(crate) fn renumber(self, i: usize) -> Self {
+        Self { curve: i, ..self }
+    }
+
+    /// This mark moved to curve index `i`, checked against that curve.
+    pub(super) fn onto(self, i: usize, c: &Curve) -> Result<Self, Refusal> {
+        if let Span::Part(pts) = &self.span
+            && !pts.iter().all(|p| on_curve(c, p))
+        {
+            return Err(Refusal::new(Stage::Guide, MARK_OFF_CURVE).at(pts.first().map_or_else(Default::default, PlanePoint::at)));
+        }
+        Ok(Self { curve: i, ..self })
+    }
+
+    /// This mark moved with its curve to index `i` of an ordered set; a
+    /// stretch of a reversed curve is given in the new direction (#4177).
+    pub(crate) fn follow(self, i: usize, reversed: bool) -> Self {
+        let span = match self.span {
+            Span::Part(mut pts) if reversed => {
+                pts.reverse();
+                Span::Part(pts)
+            }
+            s => s,
+        };
+        Self { curve: i, kind: self.kind, span }
+    }
+
+    /// The total order of the marks of a set: curve, kind, the whole curve
+    /// before a stretch, then the points.
+    pub(crate) fn cmp_set(&self, o: &Self) -> Ordering {
+        self.curve.cmp(&o.curve).then(self.kind.cmp(&o.kind)).then_with(|| match (&self.span, &o.span) {
+            (Span::Whole, Span::Whole) => Ordering::Equal,
+            (Span::Whole, Span::Part(_)) => Ordering::Less,
+            (Span::Part(_), Span::Whole) => Ordering::Greater,
+            (Span::Part(a), Span::Part(b)) => cmp_seq(a, b),
+        })
+    }
+}
+
+/// True when `p` is on curve `c` (a segment of it, the closing one of a
+/// closed curve included) within [`KERNEL_TOL`] in place and depth.
+fn on_curve(c: &Curve, p: &PlanePoint) -> bool {
+    let pts = c.pts();
+    let close = c.closed().then(|| (pts.last(), pts.first()));
+    let segs = pts.windows(2).map(|w| (&w[0], &w[1])).chain(close.into_iter().filter_map(|(a, b)| a.zip(b)));
+    let flat = pts.iter().all(|q| (q.depth() - p.depth()).abs() <= KERNEL_TOL);
+    flat && segs.into_iter().any(|(a, b)| seg_dist(p.at(), a.at(), b.at()) <= KERNEL_TOL)
+}
diff --git a/crates/pathkernel/src/guide/medial.rs b/crates/pathkernel/src/guide/medial.rs
new file mode 100644
index 000000000..af7c413c1
--- /dev/null
+++ b/crates/pathkernel/src/guide/medial.rs
@@ -0,0 +1,99 @@
+//! The medial guide (#4176, K2): the centre line of the cutter-centre area,
+//! for Slot, Trochoidal slot, Engrave and V-Carve of an area, and the spine
+//! of the 2D Adaptive. The line is the medial axis of the area (Blum 1967),
+//! computed by `Region::medial_axis` of `camcraft-geometry` (the Voronoi
+//! diagram of the sampled boundary, pruned by the object angle).
+//! Provenance: Blum, "A transformation for extracting new descriptors of
+//! shape" (1967); Brandt and Algazi (1992); Foskey, Lin and Manocha (2003),
+//! as cited in `camcraft-geometry`'s `geo2d/medial.rs`; our own design
+//! record `docs/decisions/4024-path-kernel-design.md` "Stage 2" and
+//! `docs/decisions/4176-kernel-guides-medial-trace-helix.md`. Written new:
+//! no code path of the old spine of `camcraft-motion` is ported.
+
+use camcraft_geometry::geo2d::MEDIAL_MAX_SAMPLES;
+
+use super::cover::{ARC_SAG, Ask, Raw, check_tol, finish, geo, judge, lowest, pieces, planar};
+use super::rings::length;
+use super::{Family, GuideChoice, GuidePlanner, GuideSet};
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Note, Refusal, Stage, Verdict};
+use crate::{Point2, Region};
+
+/// Refusal reason: the medial planner was given another guide choice.
+pub const NOT_MEDIAL: &str = "the medial planner plans only a medial choice";
+/// Refusal reason: an area with no centre line.
+pub const NO_MEDIAL: &str = "the area has no centre line longer than the tolerance: a round or a very small area has a centre point, not a line";
+/// Refusal reason: a centre line through a neck narrower than the tolerance.
+pub const NARROW_NECK: &str = "the area has a neck narrower than the tolerance, or touches itself: its centre line would run through a point";
+/// Refusal reason: more boundary samples than the planner makes.
+pub const MEDIAL_TOO_FINE: &str = "the centre line needs more boundary samples than the planner makes (200000)";
+
+/// The least angle (radians) that the two boundary points of a kept medial
+/// edge subtend at it: 60 degrees. The centre line of a slot subtends 180
+/// degrees, the branch into a corner of 90 degrees subtends 90; a corner
+/// flatter than 120 degrees (a flattened arc) has no branch.
+pub const MIN_ANGLE: f64 = std::f64::consts::FRAC_PI_3;
+
+/// The medial guide planner. It reads only the region: no start side, no
+/// order, no link (laws 2 and 3). Each branch of the medial axis is a curve
+/// of family `Medial`, index 0; a branch round a hole is closed.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct MedialPlanner;
+
+impl GuidePlanner for MedialPlanner {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Medial = g else {
+            return Err(Refusal::new(Stage::Guide, NOT_MEDIAL));
+        };
+        plan(planar(r)?, check_tol(tol)?)
+    }
+}
+
+/// The first place where a piece of the area is narrower than `tol`: its
+/// erosion by half of `tol` splits the piece or opens one of its holes.
+fn neck(center: &Region, tol: f64) -> Result<Option<Point2>, Refusal> {
+    let count = |r: &Region| r.loops().iter().fold((0usize, 0usize), |(o, h), l| if l.area() > 0.0 { (o + 1, h) } else { (o, h + 1) });
+    for (piece, _) in pieces(center)? {
+        let (outer, holes) = count(&piece);
+        let (o, h) = count(&geo(piece.offset(-0.5 * tol))?);
+        if o > outer || (o == outer && h < holes) {
+            return Ok(Some(lowest(&piece)));
+        }
+    }
+    Ok(None)
+}
+
+fn plan(p: &PlanarRegion, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    let perimeter: f64 = p.center().loops().iter().map(|l| length(l.points()) + l.points().first().zip(l.points().last()).map_or(0.0, |(a, b)| (a.x - b.x).hypot(a.y - b.y))).sum();
+    let samples = perimeter / Region::medial_spacing(tol);
+    if !samples.is_finite() || samples >= MEDIAL_MAX_SAMPLES as f64 {
+        return Err(Refusal::new(Stage::Guide, MEDIAL_TOO_FINE).fix("use a larger tolerance"));
+    }
+    if let Some(at) = neck(p.center(), tol)? {
+        return Err(Refusal::new(Stage::Guide, NARROW_NECK).at(at).fix("use a smaller tool, or select each side of the neck"));
+    }
+    let axis = geo(p.center().medial_axis(tol, MIN_ANGLE))?;
+    let mut notes = Vec::new();
+    let (mut raws, mut short) = (Vec::new(), 0usize);
+    for c in &axis.curves {
+        let closing = if c.closed { c.points.first().zip(c.points.last()).map_or(0.0, |(a, b)| (a.x - b.x).hypot(a.y - b.y)) } else { 0.0 };
+        if length(&c.points) + closing < tol {
+            short += 1;
+        } else {
+            raws.push(Raw { pts: c.points.clone(), closed: c.closed, k: 0 });
+        }
+    }
+    if raws.is_empty() {
+        return Err(Refusal::new(Stage::Guide, NO_MEDIAL).fix("use a ring guide for a round area"));
+    }
+    if short > 0 {
+        notes.push(Note::new(Stage::Guide, format!("{short} piece(s) of the medial axis shorter than the tolerance are not curves"))?);
+    }
+    if axis.spurs > 0 {
+        let text = format!("{} side branch(es) of the medial axis shorter than four sample spacings are sampling noise and are not curves", axis.spurs);
+        notes.push(Note::new(Stage::Guide, text)?);
+    }
+    let (curves, marks, more) = finish(&raws, Vec::new(), |_| Family::Medial)?;
+    notes.extend(more);
+    judge(p, GuideSet::with_marks(curves, marks)?, notes, Ask::Line, tol + ARC_SAG)
+}
diff --git a/crates/pathkernel/src/guide/rings.rs b/crates/pathkernel/src/guide/rings.rs
new file mode 100644
index 000000000..0173ed3da
--- /dev/null
+++ b/crates/pathkernel/src/guide/rings.rs
@@ -0,0 +1,243 @@
+//! The ring guide (#4176, K2): contour-parallel rings as the level sets of
+//! the distance to the walls of the cutter-centre area, spaced by the
+//! choice's stepover, with clean-up rings where the regular rings leave an
+//! area uncut, and each full-width stretch named (#3788). A choice with an
+//! exact circle goes to the circle rings of `helix.rs`.
+//! Provenance: contour-parallel pocketing as level sets of the distance to
+//! the boundary, Held, "On the Computational Geometry of Pocket Machining"
+//! (1991), computed by the polygon offset of `camcraft-geometry`; our own
+//! design record `docs/decisions/4024-path-kernel-design.md` "Stage 2" and
+//! `docs/decisions/4176-kernel-guides-rings-rows.md`. Written new: no code
+//! path of the old ring planners of `camcraft-motion` is ported.
+
+use camcraft_geometry::geo2d::RingClip;
+
+use super::cover::{
+    ARC_SAG, Ask, Raw, check_step, check_tol, finish, geo, judge, loop_walks, pieces, planar, uncovered,
+};
+use super::mark::{Mark, MarkKind};
+use super::{Family, GuideChoice, GuidePlanner, GuideSet, RingRef, RingsChoice};
+use crate::frame::PlanePoint;
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Refusal, Stage, Verdict};
+use crate::{KERNEL_TOL, Loop, Point2, Region, in_area};
+
+/// Refusal reason: the ring planner was given another guide choice.
+pub const NOT_RINGS: &str = "the ring planner plans only a rings choice";
+/// Refusal reason: the band reference is not planned yet.
+pub const BAND_NOT_YET: &str = "the band ring reference is not planned yet: it comes with the order stage (K4, #3934)";
+/// Refusal reason: a first ring offset below zero.
+pub const OFFSET_BELOW_CENTER: &str = "a ring offset below zero puts the ring outside the cutter-centre area";
+/// Refusal reason: a first ring offset above the tool radius for a choice
+/// that clears the area: the strip at the wall stays uncut.
+pub const WALL_STRIP_UNCUT: &str = "a first ring offset above the tool radius leaves the strip at the wall uncut";
+/// Refusal reason: the first ring offset leaves no area.
+pub const NO_RING: &str = "the first ring offset leaves no area: there is no ring";
+/// Refusal reason: more rings than the planner makes.
+pub const TOO_MANY_RINGS: &str = "the area needs more rings than the planner makes (10000)";
+
+/// The most regular rings of one plan.
+pub(super) const MAX_RINGS: u32 = 10_000;
+/// The most rounds of clean-up rings.
+const MAX_FILL_ROUNDS: u32 = 6;
+/// The area (mm2) from which an uncovered piece gets a clean-up ring: a
+/// square of 10 um. A smaller piece stays, named by the guard.
+const FILL_MIN: f64 = 1e-4;
+
+/// The ring guide planner. It reads only the region and the rings choice:
+/// no start side, no order, no link (laws 2 and 3).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RingPlanner;
+
+impl GuidePlanner for RingPlanner {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Rings(c) = g else {
+            return Err(Refusal::new(Stage::Guide, NOT_RINGS));
+        };
+        plan(planar(r)?, c, check_tol(tol)?)
+    }
+}
+
+/// The distance field whose level sets are the rings.
+enum Field {
+    /// The distance to every edge of the area: the erosion of the area.
+    Boundary,
+    /// The distance to the part walls only; the stretches on the stock edge
+    /// (`edge`, a thin band round it) are not rings.
+    Part { walls: Vec<Vec<Point2>>, edge: Region },
+}
+
+impl Field {
+    fn new(p: &PlanarRegion, reference: RingRef, tol: f64) -> Result<Self, Refusal> {
+        if reference == RingRef::Boundary || p.stock_edge().is_empty() {
+            return Ok(Self::Boundary);
+        }
+        Ok(Self::Part { walls: loop_walks(p.part_walls()), edge: geo(Region::sweep(&loop_walks(p.stock_edge()), tol))? })
+    }
+
+    /// The area at distance `d` or more from the reference walls.
+    fn level(&self, center: &Region, d: f64) -> Result<Region, Refusal> {
+        if d <= 0.0 {
+            return Ok(center.clone());
+        }
+        match self {
+            Self::Boundary => geo(center.offset(-d)),
+            Self::Part { walls, .. } => geo(center.difference(&geo(Region::sweep(walls, d))?)),
+        }
+    }
+
+    /// The rings of index `k` on the boundary of a level area.
+    fn rings(&self, level: &Region, k: u32) -> Result<Vec<Raw>, Refusal> {
+        let mut out = Vec::new();
+        for l in level.loops() {
+            let pts = l.points().to_vec();
+            match self {
+                Self::Boundary => out.push(Raw { pts, closed: true, k }),
+                Self::Part { edge, .. } => match geo(edge.clip_ring(&pts, false))? {
+                    RingClip::Whole => out.push(Raw { pts, closed: true, k }),
+                    RingClip::Pieces(ps) => out.extend(ps.into_iter().filter(|s| s.len() >= 2).map(|s| Raw { pts: s, closed: false, k })),
+                },
+            }
+        }
+        Ok(out)
+    }
+}
+
+fn plan(p: &PlanarRegion, c: &RingsChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    if c.reference() == RingRef::Band {
+        return Err(Refusal::new(Stage::Guide, BAND_NOT_YET));
+    }
+    if let Some(circle) = c.circle() {
+        // Exact circle rings of a hole (Circular, Bore): `helix.rs`.
+        return super::helix::circle_rings(p, c, circle, tol);
+    }
+    let rad = p.tool().radius();
+    let step = check_step(c.stepover(), rad)?;
+    let d0 = c.first_offset();
+    if d0 < 0.0 {
+        return Err(Refusal::new(Stage::Guide, OFFSET_BELOW_CENTER));
+    }
+    // A clearing choice whose first ring is farther than the tool radius
+    // from the wall cannot cut the strip at the wall; the clean-up rings
+    // would cut what the offset asks to leave. Refused by name.
+    if c.count().is_none() && d0 > rad + KERNEL_TOL {
+        return Err(Refusal::new(Stage::Guide, WALL_STRIP_UNCUT).fix("use a first offset of the tool radius or less, or a stock to leave on the region"));
+    }
+    let reach = p.center().bounds().map_or(0.0, |(lo, hi)| (hi.x - lo.x).hypot(hi.y - lo.y));
+    if (reach - d0) / step > f64::from(MAX_RINGS) {
+        return Err(Refusal::new(Stage::Guide, TOO_MANY_RINGS).fix("use a larger stepover"));
+    }
+    let margin = tol + ARC_SAG;
+    let field = Field::new(p, c.reference(), tol)?;
+    let (mut raws, levels) = regular(p.center(), &field, d0, step, c.count())?;
+    if raws.is_empty() {
+        return Err(Refusal::new(Stage::Guide, NO_RING).fix("use a smaller first offset"));
+    }
+    let mut marks = Vec::new();
+    // A ring count asks for that many rings, not for a cleared area: the
+    // clean-up rings apply to a choice without a count. The guard reads the
+    // whole centre area in both cases.
+    let ask = match c.count() {
+        None => {
+            fill(p.center(), &levels, &mut raws, &mut marks, rad.min(step), (rad, margin))?;
+            Ask::Clear
+        }
+        Some(n) => Ask::Count(n),
+    };
+    full_width(p, &raws, &mut marks, rad, (margin, tol))?;
+    let (curves, marks, notes) = finish(&raws, marks, |_| Family::Ring)?;
+    judge(p, GuideSet::with_marks(curves, marks)?, notes, ask, margin)
+}
+
+/// The regular rings, level by level from the first offset, and the level
+/// areas (nested, the first one outermost).
+fn regular(center: &Region, field: &Field, d0: f64, step: f64, count: Option<u32>) -> Result<(Vec<Raw>, Vec<Region>), Refusal> {
+    let (mut raws, mut levels) = (Vec::new(), Vec::new());
+    for k in 0u32.. {
+        if count.is_some_and(|n| k >= n) {
+            break;
+        }
+        if k >= MAX_RINGS {
+            return Err(Refusal::new(Stage::Guide, TOO_MANY_RINGS).fix("use a larger stepover"));
+        }
+        let level = field.level(center, d0 + f64::from(k) * step)?;
+        if level.is_empty() {
+            break;
+        }
+        raws.extend(field.rings(&level, k)?);
+        levels.push(level);
+    }
+    Ok((raws, levels))
+}
+
+/// Adds clean-up rings until the discs cover `target` (the whole centre
+/// area), at most [`MAX_FILL_ROUNDS`] rounds. The guard ([`judge`]) then
+/// reads what stays uncut. A clean-up ring of an uncovered piece is the
+/// boundary of the piece eroded by half of `inset` (the piece itself when
+/// it is thinner).
+fn fill(target: &Region, levels: &[Region], raws: &mut Vec<Raw>, marks: &mut Vec<(usize, Mark)>, inset: f64, (rad, margin): (f64, f64)) -> Result<(), Refusal> {
+    for _ in 0..MAX_FILL_ROUNDS {
+        let left = uncovered(target, raws, rad, margin)?;
+        let big: Vec<Region> = pieces(&left)?.into_iter().filter(|(_, a)| *a >= FILL_MIN).map(|(g, _)| g).collect();
+        if big.is_empty() {
+            return Ok(());
+        }
+        for g in big {
+            let core = geo(g.offset(-0.5 * inset))?;
+            let src = if core.is_empty() { &g } else { &core };
+            for l in src.loops() {
+                marks.push((raws.len(), Mark::whole(0, MarkKind::Fill)));
+                raws.push(Raw { pts: l.points().to_vec(), closed: true, k: fill_index(l, levels) });
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The index of a clean-up ring: one more than the deepest level area that
+/// holds all of it, so that it sorts with the next deeper rings.
+fn fill_index(l: &Loop, levels: &[Region]) -> u32 {
+    let deepest = levels.iter().rposition(|lv| l.points().iter().all(|p| in_area(lv, *p)));
+    deepest.map_or(0, |j| u32::try_from(j).map_or(u32::MAX, |j| j.saturating_add(1)))
+}
+
+/// Names each full-width stretch: a stretch of a curve of index `k` whose
+/// tool disc overlaps no disc of a curve of index `k + 1` (the next deeper
+/// curves; a deeper curve is farther, behind them) and no air beyond the
+/// stock edge. When the deeper curves are cut first, the tool cuts there
+/// at full width (#3788: the strands of a ring through the neck between two
+/// lobes). A crumb of `tol` or less where the test is tangent is no stretch.
+pub(super) fn full_width(p: &PlanarRegion, raws: &[Raw], marks: &mut Vec<(usize, Mark)>, rad: f64, (margin, tol): (f64, f64)) -> Result<(), Refusal> {
+    let air = if p.stock_edge().is_empty() { Region::empty() } else { geo(Region::sweep(&loop_walks(p.stock_edge()), rad))? };
+    let Some(top) = raws.iter().map(|r| r.k).max() else {
+        return Ok(());
+    };
+    for k in 0..=top {
+        let deeper: Vec<Vec<Point2>> = raws.iter().filter(|r| r.k == k.saturating_add(1)).map(Raw::walk).collect();
+        let near = if deeper.is_empty() { Region::empty() } else { geo(Region::sweep(&deeper, 2.0 * rad + margin))? };
+        let reach = if air.is_empty() { near } else { geo(near.union(&air))? };
+        for (i, raw) in raws.iter().enumerate().filter(|(_, r)| r.k == k) {
+            let stretches = if raw.closed {
+                match geo(reach.clip_ring(&raw.pts, false))? {
+                    RingClip::Whole => {
+                        marks.push((i, Mark::whole(0, MarkKind::FullWidth)));
+                        continue;
+                    }
+                    RingClip::Pieces(ps) => ps,
+                }
+            } else {
+                geo(reach.clip_polyline(&raw.pts, false))?
+            };
+            for s in stretches.into_iter().filter(|s| length(s) > tol) {
+                let pts: Result<Vec<PlanePoint>, Refusal> = s.into_iter().map(PlanePoint::flat).collect();
+                marks.push((i, Mark::part(0, MarkKind::FullWidth, pts?)?));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The length of a polyline.
+pub(crate) fn length(pts: &[Point2]) -> f64 {
+    pts.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum()
+}
diff --git a/crates/pathkernel/src/guide/rows.rs b/crates/pathkernel/src/guide/rows.rs
new file mode 100644
index 000000000..2cedc9d24
--- /dev/null
+++ b/crates/pathkernel/src/guide/rows.rs
@@ -0,0 +1,96 @@
+//! The row guide (#4176, K2): parallel rows at the choice's angle, spaced
+//! evenly at the stepover or less across the cutter-centre area and
+//! clipped to it, for Face and Zigzag; with the area's boundary as a
+//! closing ring when the choice asks for one.
+//! Provenance: direction-parallel (zigzag) area clearing as in Held, "On
+//! the Computational Geometry of Pocket Machining" (1991); the clip of a
+//! line by a polygon from the published computer-graphics literature
+//! (`Region::clip_polyline` of `camcraft-geometry`); our own design record
+//! `docs/decisions/4024-path-kernel-design.md` "Stage 2" and
+//! `docs/decisions/4176-kernel-guides-rings-rows.md`. Written new: no code
+//! path of the old Face and Zigzag planners of `camcraft-motion` is ported.
+
+use super::cover::{ARC_SAG, Ask, Raw, check_step, check_tol, finish, geo, judge, planar};
+use super::mark::{Mark, MarkKind};
+use super::rings::length;
+use super::{Family, GuideChoice, GuidePlanner, GuideSet, RowsChoice};
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Note, Refusal, Stage, Verdict};
+use crate::Point2;
+
+/// Refusal reason: the row planner was given another guide choice.
+pub const NOT_ROWS: &str = "the row planner plans only a rows choice";
+/// Refusal reason: more rows than the planner makes.
+pub const TOO_MANY_ROWS: &str = "the area needs more rows than the planner makes (100000)";
+
+/// The most rows of one plan.
+const MAX_ROWS: f64 = 100_000.0;
+
+/// The row guide planner. It reads only the region and the rows choice: no
+/// start side, no order, no link (laws 2 and 3). Each row piece is an open
+/// curve of family `Row` with the index of its row; the closing ring is of
+/// family `Ring`, index 0, marked [`MarkKind::Closing`].
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RowPlanner;
+
+impl GuidePlanner for RowPlanner {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Rows(c) = g else {
+            return Err(Refusal::new(Stage::Guide, NOT_ROWS));
+        };
+        plan(planar(r)?, c, check_tol(tol)?)
+    }
+}
+
+fn plan(p: &PlanarRegion, c: &RowsChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    let rad = p.tool().radius();
+    let step = check_step(c.stepover(), rad)?;
+    let (s, co) = c.angle().to_radians().sin_cos();
+    let (u, n) = ((co, s), (-s, co));
+    let center = p.center();
+    let pts: Vec<Point2> = center.loops().iter().flat_map(|l| l.points()).copied().collect();
+    let Some((lo, hi)) = center.bounds() else {
+        return Err(Refusal::new(Stage::Guide, crate::region::EMPTY_CENTER));
+    };
+    // Coordinates about the middle of the area keep the row math small.
+    let mid = Point2::new(0.5 * (lo.x + hi.x), 0.5 * (lo.y + hi.y));
+    let along = |q: &Point2, d: (f64, f64)| (q.x - mid.x) * d.0 + (q.y - mid.y) * d.1;
+    let (vmin, vmax) = pts.iter().map(|q| along(q, n)).fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), v| (a.min(v), b.max(v)));
+    let half = 1.0 + (hi.x - lo.x).hypot(hi.y - lo.y);
+    let span = vmax - vmin;
+    let gaps = (span / step).ceil().max(1.0);
+    if !gaps.is_finite() || gaps > MAX_ROWS {
+        return Err(Refusal::new(Stage::Guide, TOO_MANY_ROWS).fix("use a larger stepover"));
+    }
+    // The rows run on the boundary at the two extremes, so that a wall
+    // parallel to the rows is cut; the clip area is the centre grown by a
+    // quarter of the tolerance, so that a row on the boundary is kept.
+    let clip = geo(center.offset(0.25 * tol))?;
+    let mut raws = Vec::new();
+    let mut crumbs = 0usize;
+    let count = gaps as u32;
+    for i in 0..=count {
+        let v = if i == count { vmax } else { vmin + f64::from(i) * span / gaps };
+        let at = |t: f64| Point2::new(mid.x + v * n.0 + t * u.0, mid.y + v * n.1 + t * u.1);
+        for piece in geo(clip.clip_polyline(&[at(-half), at(half)], true))? {
+            if length(&piece) < tol {
+                crumbs += 1;
+            } else {
+                raws.push(Raw { pts: piece, closed: false, k: i });
+            }
+        }
+    }
+    let mut marks = Vec::new();
+    if c.closing_ring() {
+        for l in center.loops() {
+            marks.push((raws.len(), Mark::whole(0, MarkKind::Closing)));
+            raws.push(Raw { pts: l.points().to_vec(), closed: true, k: 0 });
+        }
+    }
+    let (curves, marks, mut notes) = finish(&raws, marks, |r| if r.closed { Family::Ring } else { Family::Row })?;
+    if crumbs > 0 {
+        let text = format!("{crumbs} row piece(s) shorter than the tolerance touch the area at one point and are not rows");
+        notes.push(Note::new(Stage::Guide, text)?);
+    }
+    judge(p, GuideSet::with_marks(curves, marks)?, notes, Ask::Clear, tol + ARC_SAG)
+}
diff --git a/crates/pathkernel/src/guide/trace.rs b/crates/pathkernel/src/guide/trace.rs
new file mode 100644
index 000000000..0670fa809
--- /dev/null
+++ b/crates/pathkernel/src/guide/trace.rs
@@ -0,0 +1,132 @@
+//! The trace guide (#4176, K2): the picked chains themselves, offset by the
+//! choice to their left, their right or not at all, open or closed, for
+//! Trace, 2D Contour on a chain, Engrave on a line and 2D Chamfer; with the
+//! stretches in the keep-out area left out and named.
+//! Provenance: the offset of a closed curve as the polygon offset of its
+//! area (Held, "On the Computational Geometry of Pocket Machining", 1991),
+//! the offset of an open chain as the trimmed boundary of its Minkowski sum
+//! with a disc (Tiller and Hanson, 1984), both in `camcraft-geometry`; our
+//! own design record `docs/decisions/4024-path-kernel-design.md` "Stage 2"
+//! and `docs/decisions/4176-kernel-guides-medial-trace-helix.md`. Written
+//! new: no code path of the old Trace, Contour or Chamfer planners of
+//! `camcraft-motion` is ported.
+
+use camcraft_geometry::geo2d::{RingClip, offset_side};
+
+use super::cover::{Raw, check_tol, finish, geo};
+use super::rings::length;
+use super::{Family, GuideChoice, GuidePlanner, GuideSet};
+use crate::region::{ChainRegion, KernelRegion};
+use crate::verdict::{Note, Refusal, Stage, Verdict};
+use crate::{KERNEL_TOL, Loop, Point2, Region};
+
+/// Refusal reason: the trace planner was given another guide choice.
+pub const NOT_TRACE: &str = "the trace planner plans only a trace choice";
+/// Refusal reason: the trace planner was given an area.
+pub const NOT_A_CHAIN: &str = "the trace planner plans the chains of a trace: build the region with chain_region";
+/// Refusal reason: no chain has an offset curve.
+pub const TRACE_COLLAPSES: &str = "the offset of each chain collapses: there is no trace curve";
+/// Refusal reason: the whole trace is in the keep-out area.
+pub const TRACE_KEPT_OUT: &str = "the whole trace is in the keep-out area";
+
+/// The trace guide planner. It reads only the chain region and the trace
+/// offset: no start side, no order, no link (laws 2 and 3). Each curve is
+/// of family `Trace`, index 0.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct TracePlanner;
+
+impl GuidePlanner for TracePlanner {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Trace(t) = g else {
+            return Err(Refusal::new(Stage::Guide, NOT_TRACE));
+        };
+        let Some(c) = r.chains() else {
+            return Err(Refusal::new(Stage::Guide, NOT_A_CHAIN));
+        };
+        plan(c, t.get(), check_tol(tol)?)
+    }
+}
+
+fn note(notes: &mut Vec<Note>, text: String) -> Result<(), Refusal> {
+    notes.push(Note::new(Stage::Guide, text)?);
+    Ok(())
+}
+
+/// The offset curves of one closed chain, counter-clockwise: its area
+/// shrunk by `d` (to its left, the inside) or grown by `-d`.
+fn closed(pts: &[Point2], d: f64, tol: f64) -> Result<Vec<Raw>, Refusal> {
+    let mut ccw = pts.to_vec();
+    let l = geo(Loop::new(ccw.clone()))?;
+    if l.area() < 0.0 {
+        ccw.reverse();
+    }
+    if d.abs() <= KERNEL_TOL {
+        return Ok(vec![Raw { pts: ccw, closed: true, k: 0 }]);
+    }
+    let area = geo(Region::new(vec![geo(Loop::new(ccw))?]))?;
+    let off = geo(area.offset_fine(-d, tol))?;
+    Ok(off.loops().iter().map(|l| Raw { pts: l.points().to_vec(), closed: true, k: 0 }).collect())
+}
+
+fn plan(c: &ChainRegion, d: f64, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    let (mut raws, mut notes) = (Vec::new(), Vec::new());
+    for chain in c.chains() {
+        let pts = chain.points();
+        let at = pts.first().copied().unwrap_or_default();
+        let made = if chain.is_closed() {
+            closed(pts, d, tol)?
+        } else if d.abs() <= KERNEL_TOL {
+            vec![Raw { pts: pts.to_vec(), closed: false, k: 0 }]
+        } else {
+            let pieces = geo(offset_side(pts, d))?;
+            if pieces.len() > 1 {
+                let text = format!("the offset of the open chain at ({:.3}, {:.3}) is {} pieces: the chain comes nearer to itself than the offset", at.x, at.y, pieces.len());
+                note(&mut notes, text)?;
+            }
+            pieces.into_iter().map(|p| Raw { pts: p.points, closed: p.closed, k: 0 }).collect()
+        };
+        if made.is_empty() {
+            note(&mut notes, format!("the offset of {d:.3} mm of the chain at ({:.3}, {:.3}) collapses: it has no trace curve", at.x, at.y))?;
+        }
+        raws.extend(made);
+    }
+    if raws.is_empty() {
+        return Err(Refusal::new(Stage::Guide, TRACE_COLLAPSES).fix("use a smaller offset"));
+    }
+    let raws = keep_out(c, raws, &mut notes)?;
+    if raws.is_empty() {
+        return Err(Refusal::new(Stage::Guide, TRACE_KEPT_OUT).fix("move the keep-out area or pick another chain"));
+    }
+    let (curves, marks, more) = finish(&raws, Vec::new(), |_| Family::Trace)?;
+    notes.extend(more);
+    Ok(Verdict::Done { out: GuideSet::with_marks(curves, marks)?, fallbacks: Vec::new(), notes })
+}
+
+/// The curves less their stretches where the tool disc meets the keep-out
+/// area; the length left out is named in a note.
+fn keep_out(c: &ChainRegion, raws: Vec<Raw>, notes: &mut Vec<Note>) -> Result<Vec<Raw>, Refusal> {
+    if c.keep_out().is_empty() {
+        return Ok(raws);
+    }
+    let zone = geo(c.keep_out().offset(c.tool().radius()))?;
+    let (mut out, mut lost) = (Vec::new(), 0.0);
+    for r in raws {
+        let walk = r.walk();
+        let before = length(&walk);
+        let kept: Vec<Raw> = if r.closed {
+            match geo(zone.clip_ring(&r.pts, false))? {
+                RingClip::Whole => vec![r],
+                RingClip::Pieces(ps) => ps.into_iter().map(|s| Raw { pts: s, closed: false, k: 0 }).collect(),
+            }
+        } else {
+            geo(zone.clip_polyline(&r.pts, false))?.into_iter().map(|s| Raw { pts: s, closed: false, k: 0 }).collect()
+        };
+        let after: f64 = kept.iter().map(|k| length(&k.walk())).sum();
+        lost += (before - after).max(0.0);
+        out.extend(kept.into_iter().filter(|k| k.pts.len() >= 2));
+    }
+    if lost > KERNEL_TOL {
+        note(notes, format!("the trace leaves out {lost:.3} mm of its curves where the tool meets the keep-out area"))?;
+    }
+    Ok(out)
+}
diff --git a/crates/pathkernel/src/lib.rs b/crates/pathkernel/src/lib.rs
new file mode 100644
index 000000000..eedc68849
--- /dev/null
+++ b/crates/pathkernel/src/lib.rs
@@ -0,0 +1,100 @@
+//! The path kernel (#4023, #4055): one planner for the 2D milling kinds,
+//! cut into six stages - region, guide curves, order, load control, link,
+//! entry and exit. Each stage has its own type, its invariants as checked
+//! constructors, and a trait so that a later family can supply its own
+//! stage. This step holds the types only: no stage plans a path yet.
+//!
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! (clean-room); the stage split follows the published offset-pocketing and
+//! engagement literature (Held 1991; Stori & Wright 2000; Held & Spielberger
+//! 2009). No HSMWorks material consulted.
+//!
+//! The data flow is `region -> guide -> order -> load -> link -> entry/exit`.
+//! The start side reaches the curves only through [`order`] (law 3): the
+//! region stage takes no start side, the order stage takes no material side.
+//!
+//! **Valid by construction** (#4055 review): a value of a public type of
+//! this crate is always valid. A field that could hold an invalid value is
+//! private and is set only by a checked constructor that returns a
+//! [`Refusal`]. An enum variant that carries data holds a validated
+//! newtype, never a raw number or a raw point. A list in a value holds only
+//! validated records, and the constructor that takes the list checks the
+//! rules between its records. So no constructor relies on another one
+//! having run: it cannot receive an unchecked value. The open enums of the
+//! record (`WorkPlane`, `ToolShape`, `KernelRegion`, `Step`, ...) stay
+//! `#[non_exhaustive]`.
+
+pub mod engine;
+pub mod entry;
+pub mod frame;
+pub mod guide;
+pub mod link;
+pub mod load;
+pub mod order;
+pub mod plan;
+pub mod recipe;
+pub mod region;
+mod region_build;
+mod region_chain;
+mod region_check;
+pub mod selection;
+pub mod verdict;
+
+pub use engine::{PLANNER_ENV, PlannerEngine, engine_from_switch};
+pub use frame::{AxisControl, Disc, PlanarFrame, PlanePoint, Positive, Spot, ToolShape, WorkPlane};
+pub use recipe::Recipe;
+pub use region::{Bounds, ChainRegion, KernelRegion, MaterialSide, PlanarRegion, chain_region, region};
+pub use selection::{Chain, Selection};
+pub use verdict::{Fallback, Gap, Gaps, Note, Refusal, Stage, Verdict};
+
+/// The 2D types of the kernel's data, re-exported so that a caller names
+/// one crate.
+pub use camcraft_geometry::geo2d::{Loop, Point2, Region};
+
+/// The tolerance (mm) of the kernel's own invariant checks: two points
+/// closer than this are the same point.
+pub const KERNEL_TOL: f64 = 1e-6;
+
+/// True when every value is a finite number (no NaN, no infinity).
+pub(crate) fn finite(values: &[f64]) -> bool {
+    values.iter().all(|v| v.is_finite())
+}
+
+/// True when the two points are the same point within [`KERNEL_TOL`].
+pub(crate) fn near(a: Point2, b: Point2) -> bool {
+    (a.x - b.x).hypot(a.y - b.y) <= KERNEL_TOL
+}
+
+/// The distance from `p` to the segment `a`-`b`.
+pub(crate) fn seg_dist(p: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / len2).clamp(0.0, 1.0) } else { 0.0 };
+    (p.x - (a.x + t * dx)).hypot(p.y - (a.y + t * dy))
+}
+
+/// True when `p` is inside `area` or on its boundary within [`KERNEL_TOL`].
+pub(crate) fn in_area(area: &Region, p: Point2) -> bool {
+    area.contains(p)
+        || area.loops().iter().any(|l| {
+            let pts = l.points();
+            pts.iter().zip(pts.iter().cycle().skip(1)).any(|(a, b)| seg_dist(p, *a, *b) <= KERNEL_TOL)
+        })
+}
+
+/// The distance from `q` to the nearest edge of `loops` (infinite for none).
+pub(crate) fn to_loops(q: Point2, loops: &[Loop]) -> f64 {
+    let mut best = f64::INFINITY;
+    for l in loops {
+        let pts = l.points();
+        for (a, b) in pts.iter().zip(pts.iter().cycle().skip(1)) {
+            best = best.min(seg_dist(q, *a, *b));
+        }
+    }
+    best
+}
+
+/// True when every point of every loop of `r` is finite.
+pub(crate) fn region_finite(r: &Region) -> bool {
+    r.loops().iter().all(|l| l.points().iter().all(|p| finite(&[p.x, p.y])))
+}
diff --git a/crates/pathkernel/src/link.rs b/crates/pathkernel/src/link.rs
new file mode 100644
index 000000000..a225fdf47
--- /dev/null
+++ b/crates/pathkernel/src/link.rs
@@ -0,0 +1,164 @@
+//! Stage 5, Link (K4): a hop between two cuts stays at depth only with a
+//! proof, else it lifts with a named reason that the tally counts. The
+//! proofs are in `link/` (#4177).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 5: Link"; stay-down linking as in the published high-speed
+//! machining literature (Held & Spielberger 2009).
+
+mod approach;
+mod proof;
+mod route;
+
+pub use proof::{LinkStage, SWATH};
+pub(crate) use proof::proved_path;
+
+use std::collections::BTreeMap;
+
+use crate::Point2;
+use crate::frame::Spot;
+use crate::plan::Cut;
+use crate::region::KernelRegion;
+use crate::verdict::{NO_REASON, Refusal, Stage};
+
+/// The user's link policy, as the stages read it. Motion converts its
+/// `Links` into this value.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+#[non_exhaustive]
+pub enum LinkPolicy {
+    /// Stay at depth where a proof holds, else lift with a reason.
+    #[default]
+    StayWhereProved,
+    /// The user asked for a retract between cuts: always lift.
+    Retract,
+}
+
+/// The finite points of a stay-down hop: one or more.
+#[derive(Clone, Debug, PartialEq)]
+pub struct StayPath(Vec<Spot>);
+
+impl StayPath {
+    #[must_use]
+    pub fn points(&self) -> Vec<Point2> {
+        self.0.iter().map(|s| s.get()).collect()
+    }
+}
+
+/// The reason of a lift: not blank.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct LiftReason(&'static str);
+
+impl LiftReason {
+    #[must_use]
+    pub fn get(self) -> &'static str {
+        self.0
+    }
+}
+
+/// One hop between two cuts. Each variant holds a checked value.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Hop {
+    /// Stay at depth along these points (a proof holds for them).
+    Stay(StayPath),
+    /// Lift along the tool axis, for a named reason.
+    Lift(LiftReason),
+}
+
+/// Refusal reason: a stay hop with no point.
+pub const BAD_STAY: &str = "a stay-down hop needs one or more finite points";
+/// The lift reason when the user asked for a retract.
+pub const USER_RETRACT: &str = "the user asked for a retract between cuts";
+/// Lift reason: the in-plane link leaves the cutter-centre area (it would cut the part).
+pub const CUTS_PART: &str = "the in-plane link would leave the area that keeps the tool off the part";
+/// Lift reason: the in-plane link comes within a tool radius of a keep-out area.
+pub const HITS_FIXTURE: &str = "the in-plane link would hit a fixture (a keep-out area)";
+/// Lift reason: the in-plane link crosses a cut of the level.
+pub const CROSSES_CUT: &str = "the in-plane link would cross a cut planned on that plane";
+/// Lift reason: the in-plane path has no finite point to stay on (a cut
+/// with no point, or a point that is not a finite number).
+pub const BAD_PATH: &str = "the in-plane link has no finite path to stay on";
+/// Lift reason: the region is not planar, and the link stage proves
+/// in-plane links on planar regions only.
+pub const NOT_PLANAR_LINK: &str = "the link stage proves in-plane links on planar regions only";
+/// Lift reason: the in-plane link runs through stock that no cut has cleared.
+pub const UNCUT_STOCK: &str = "the in-plane link would cut uncut stock with the full tool width";
+
+impl Hop {
+    pub fn stay(pts: Vec<Point2>) -> Result<Self, Refusal> {
+        if pts.is_empty() {
+            return Err(Refusal::new(Stage::Link, BAD_STAY));
+        }
+        let spots = pts.into_iter().map(|p| Spot::new(Stage::Link, p)).collect::<Result<Vec<_>, _>>()?;
+        Ok(Self::Stay(StayPath(spots)))
+    }
+    pub fn lift(reason: &'static str) -> Result<Self, Refusal> {
+        if reason.trim().is_empty() {
+            return Err(Refusal::new(Stage::Link, NO_REASON));
+        }
+        Ok(Self::Lift(LiftReason(reason)))
+    }
+}
+
+/// The count of lifts by reason. The status line prints it.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct LinkTally {
+    lifts: BTreeMap<&'static str, u32>,
+}
+
+impl LinkTally {
+    /// Counts `hop` if it is a lift; returns the hop unchanged.
+    pub fn record(&mut self, hop: Hop) -> Hop {
+        if let Hop::Lift(reason) = &hop {
+            let n = self.lifts.entry(reason.get()).or_insert(0);
+            *n = n.saturating_add(1);
+        }
+        hop
+    }
+    #[must_use]
+    pub fn lifts(&self) -> u32 {
+        self.lifts.values().fold(0u32, |a, b| a.saturating_add(*b))
+    }
+    #[must_use]
+    pub fn by_reason(&self) -> &BTreeMap<&'static str, u32> {
+        &self.lifts
+    }
+}
+
+/// The cuts of one level round a hop: those made before it (the cut that
+/// the hop leaves is the last one), those planned after it (the cut that
+/// the hop reaches is the first one), and the stay-down paths of the hops
+/// before it (a new link must not cross them either).
+#[derive(Clone, Copy, Debug)]
+pub struct Level<'a> {
+    made: &'a [Cut],
+    planned: &'a [Cut],
+    links: &'a [Vec<Point2>],
+}
+
+impl<'a> Level<'a> {
+    #[must_use]
+    pub fn new(made: &'a [Cut], planned: &'a [Cut]) -> Self {
+        Self { made, planned, links: &[] }
+    }
+    /// This level with the stay-down paths of the hops before the hop.
+    #[must_use]
+    pub fn with_links(self, links: &'a [Vec<Point2>]) -> Self {
+        Self { links, ..self }
+    }
+    #[must_use]
+    pub fn links(&self) -> &'a [Vec<Point2>] {
+        self.links
+    }
+    #[must_use]
+    pub fn made(&self) -> &'a [Cut] {
+        self.made
+    }
+    #[must_use]
+    pub fn planned(&self) -> &'a [Cut] {
+        self.planned
+    }
+}
+
+/// A link proof: a hop between two cuts, always counted in the tally.
+pub trait LinkProof {
+    fn link(&self, from: &Cut, to: &Cut, r: &KernelRegion, level: Level<'_>, policy: LinkPolicy, tally: &mut LinkTally) -> Hop;
+}
diff --git a/crates/pathkernel/src/link/approach.rs b/crates/pathkernel/src/link/approach.rs
new file mode 100644
index 000000000..4102ee7a5
--- /dev/null
+++ b/crates/pathkernel/src/link/approach.rs
@@ -0,0 +1,103 @@
+//! The approach from the air (#4254): the last stretch of a stay-down link
+//! into the start of an open piece whose start is on the stock edge (a
+//! ring cut open there). The tool comes from the air in the cut plane,
+//! straight to the start, and the stretch cuts no stock off the planned
+//! curve: each piece of stock that the disc sweeps on the stretch lies in
+//! the swath of the piece that it reaches, so the tool begins to cut along
+//! the planned curve. Elsewhere the disc stands outside the stock: within
+//! a tool radius of the air (the air starts one tool radius outside the
+//! stock, so no point inside the stock is that near to it). The proof is
+//! exact area geometry of the swept disc, as the lead-in of an air entry is
+//! proved in its room (`entry/air.rs`), not a strip of stock that is open
+//! by a constant. The way to the air is proved as any link (`proof.rs`).
+//! Provenance: the tangential approach from outside the stock of public
+//! machining handbooks; the swept disc as the Minkowski sum of the path
+//! and the tool disc (Held 1991); our own design record
+//! `docs/decisions/4024-path-kernel-design.md` (#3934: the split pieces of
+//! a band are joined from the air) and `docs/decisions/4254-kernel-air-approach.md`.
+
+use super::proof::{Proof, tries};
+use super::route::project;
+use crate::entry::ROOM_TOL;
+use crate::plan::Cut;
+use crate::{Point2, Region, in_area, near, to_loops};
+
+/// The tolerance (mm) of the area test: the swept discs and the grown
+/// areas are polygons flattened within [`ROOM_TOL`] each, so the cover is
+/// grown by twice that. It is the flattening of the polygon offset, not
+/// room for the tool.
+const AREA_TOL: f64 = 2.0 * ROOM_TOL;
+
+/// The proved link from `a` (the end of `from`) to `b` (the start of `to`)
+/// whose last stretch is an approach from the air; `None` when `to` is not
+/// an open piece that starts on the stock edge, or when no approach and no
+/// way out to it is proved.
+pub(super) fn from_air(proof: &mut Proof<'_>, from: &Cut, to: &Cut, a: Point2, b: Point2) -> Option<Vec<Point2>> {
+    let (p, r) = (proof.region(), proof.radius());
+    if to.curve().closed() || p.air().is_empty() || to_loops(b, p.stock_edge()) > ROOM_TOL {
+        return None;
+    }
+    // The doors: the places of the air nearest to the start, one for each
+    // air loop within the edge band of it (a tool radius and the room
+    // tolerance), the nearest first.
+    let mut doors: Vec<(f64, Point2)> = p
+        .air()
+        .loops()
+        .iter()
+        .filter_map(|l| project(l.points(), b))
+        .map(|(_, _, q, d)| (d, q))
+        .filter(|&(d, _)| d <= r + ROOM_TOL)
+        .collect();
+    doors.sort_by(|x, y| x.0.total_cmp(&y.0));
+    for (_, door) in doors {
+        if !approach(proof, to, door, b) {
+            continue;
+        }
+        if let Ok(mut path) = tries(proof, from, a, door) {
+            path.push(b);
+            path.dedup_by(|x, y| near(*x, *y));
+            return Some(path);
+        }
+    }
+    None
+}
+
+/// The points that the tool centre walks along `cut`.
+fn path_of(cut: &Cut) -> Vec<Point2> {
+    cut.curve().pts().iter().map(|q| q.at()).collect()
+}
+
+/// True when the straight stretch from `door` (in the air) to `b` (the
+/// start of `to`) is a proved approach:
+/// - each sample is in the air or the edge band (clear of the part zone),
+///   more than a tool radius from each keep-out area, and not inside the
+///   cutter-centre area (the tool comes from outside the stock);
+/// - the stretch holds in the legal room of the entry stage;
+/// - it crosses no cut made and no link, and touches no planned cut away
+///   from the ends of the link;
+/// - the disc swept along it, less the swath of `to`, lies outside the
+///   stock (within a tool radius of the air).
+pub(super) fn approach(proof: &Proof<'_>, to: &Cut, door: Point2, b: Point2) -> bool {
+    let (p, r) = (proof.region(), proof.radius());
+    let keep = p.keep_out();
+    let clear = |q: Point2| keep.is_empty() || (!in_area(keep, q) && to_loops(q, keep.loops()) > r);
+    let center = p.center();
+    let outside_center = |q: Point2| near(q, b) || !center.contains(q) || to_loops(q, center.loops()) <= ROOM_TOL;
+    let pts = proof.samples(door, b);
+    if !in_area(p.air(), door) || !pts.iter().all(|&q| (in_area(p.air(), q) || proof.in_band(q)) && clear(q) && outside_center(q)) {
+        return false;
+    }
+    if !proof.legal().is_some_and(|l| matches!(l.holds_path(&[door, b]), Ok(true))) {
+        return false;
+    }
+    if proof.crossing(door, b, None).is_err() {
+        return false;
+    }
+    let Some(outside) = proof.outside.get_or_init(|| p.air().offset(r + AREA_TOL).ok()) else {
+        return false;
+    };
+    let off_curve = Region::sweep(&[vec![door, b]], r)
+        .and_then(|swept| Region::sweep(&[path_of(to)], r + AREA_TOL).and_then(|on| swept.difference(&on)))
+        .and_then(|rest| rest.difference(outside));
+    matches!(off_curve, Ok(rest) if rest.is_empty())
+}
diff --git a/crates/pathkernel/src/link/proof.rs b/crates/pathkernel/src/link/proof.rs
new file mode 100644
index 000000000..fd1fd32cc
--- /dev/null
+++ b/crates/pathkernel/src/link/proof.rs
@@ -0,0 +1,303 @@
+//! The link proof of the kernel (#4177, K4): a hop stays at depth when an
+//! in-plane path is proved clear, else it lifts with the named reason of
+//! the straight link. A path is clear when each of its chords stays in the
+//! cutter-centre area, the air or the edge band (so it cuts no part wall
+//! and no keep-out area), crosses no cut of the level, and runs only over
+//! cleared stock (within the swath of a cut already made) or the air of
+//! the region (the band outside the stock where the tool does not touch
+//! it). The edge band (#4241) is the band outside the stock within one
+//! tool radius of a stock edge, as the entry stage's legal room defines it
+//! (`entry/room.rs`): there the disc overhangs the stock edge. Its part
+//! outside the stock meets no part: the proof asks that the centre is not
+//! inside the part zone (the part grown by the tool radius plus the stock
+//! to leave; a part can touch the stock edge or reach out of it) and not
+//! within a tool radius of a keep-out area. Its part inside the
+//! stock is stock as any other: it is open only where the swath of a cut
+//! already made covers it. The tries, in order: the straight chord; back
+//! along the cut just made, then a chord (the chain link of the air plan);
+//! a walk along an edge of the centre area or of the air.
+//! Provenance: ported from `camcraft-motion` with its named reasons - the
+//! chord proof of the ring links (`machining2d/ring_links.rs`, #3747,
+//! #3822) and the chain link of the Adaptive air plan
+//! (`machining2d/adaptive/air_chain.rs`, `link`; the #3934 decision of our
+//! design record `docs/decisions/4024-path-kernel-design.md`); stay-down
+//! linking as in Held & Spielberger (2009).
+
+use camcraft_geometry::geo2d::{point_segment_distance, segment_gap, segments_cross};
+
+use std::cell::OnceCell;
+
+use super::{BAD_PATH, CROSSES_CUT, CUTS_PART, HITS_FIXTURE, Hop, LiftReason, LinkPolicy, LinkProof, LinkTally, Level, NOT_PLANAR_LINK, UNCUT_STOCK, USER_RETRACT};
+use crate::entry::legal_room;
+use crate::plan::Cut;
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::{KERNEL_TOL, Point2, Region, in_area, near, to_loops};
+
+/// The part of the tool radius that a link may stand from a cut already
+/// made and still run over cleared stock (the ring links' swath).
+pub const SWATH: f64 = 0.9;
+/// The sample step of a chord, in tool radii (the ring links' step).
+const STEP: f64 = 0.25;
+/// Two segments closer than this (mm) meet.
+const APART: f64 = 1e-6;
+
+/// The kernel's link stage.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct LinkStage;
+
+/// A cut as a polyline (a closed cut repeats its start) and its bounds.
+pub(super) struct Line {
+    pts: Vec<Point2>,
+    lo: Point2,
+    hi: Point2,
+}
+
+impl Line {
+    fn of(c: &Cut) -> Self {
+        let mut pts: Vec<Point2> = c.curve().pts().iter().map(|p| p.at()).collect();
+        if c.curve().closed()
+            && let Some(&f) = pts.first()
+        {
+            pts.push(f);
+        }
+        Self::path(pts)
+    }
+    fn path(pts: Vec<Point2>) -> Self {
+        let lo = pts.iter().fold(Point2::new(f64::INFINITY, f64::INFINITY), |m, p| Point2::new(m.x.min(p.x), m.y.min(p.y)));
+        let hi = pts.iter().fold(Point2::new(f64::NEG_INFINITY, f64::NEG_INFINITY), |m, p| Point2::new(m.x.max(p.x), m.y.max(p.y)));
+        Self { pts, lo, hi }
+    }
+    /// The distance from `q` to the line, or a bound above `cap` when the
+    /// bounds are already farther than `cap`.
+    fn dist(&self, q: Point2, cap: f64) -> f64 {
+        let dx = (self.lo.x - q.x).max(q.x - self.hi.x).max(0.0);
+        let dy = (self.lo.y - q.y).max(q.y - self.hi.y).max(0.0);
+        if dx.hypot(dy) > cap {
+            return f64::INFINITY;
+        }
+        self.pts.windows(2).map(|w| point_segment_distance(q, w[0], w[1])).fold(f64::INFINITY, f64::min)
+    }
+    /// True when the segment `a`-`b` meets the line. A cut already made is
+    /// met only by a proper crossing (the verifier's crossing law): a link
+    /// may run on cut ground and along a made cut. A planned cut is met by
+    /// any touch away from the ends `ends` of the link (where the link
+    /// joins its two cuts): a link that touches it cuts its material.
+    fn meets(&self, a: Point2, b: Point2, ends: (Point2, Point2), made: bool) -> bool {
+        let pad = APART;
+        let off = a.x.min(b.x) > self.hi.x + pad || a.x.max(b.x) < self.lo.x - pad;
+        if off || a.y.min(b.y) > self.hi.y + pad || a.y.max(b.y) < self.lo.y - pad {
+            return false;
+        }
+        self.pts.windows(2).any(|w| {
+            if made {
+                return segments_cross(a, b, w[0], w[1]);
+            }
+            let joint = point_segment_distance(ends.0, w[0], w[1]) <= APART || point_segment_distance(ends.1, w[0], w[1]) <= APART;
+            !joint && segment_gap(a, b, w[0], w[1]) <= APART
+        })
+    }
+}
+
+/// What a proof reads: the region, the tool radius, the cuts made and all
+/// the cuts of the level (made first), and the two ends of the link.
+pub(super) struct Proof<'a> {
+    p: &'a PlanarRegion,
+    r: f64,
+    made: Vec<Line>,
+    planned: Vec<Line>,
+    links: Vec<Line>,
+    ends: (Point2, Point2),
+    /// The legal room of the tool centre (`entry::legal_room`), built at
+    /// the first sample outside the centre area and the air. `None` when
+    /// its geometry cannot be computed: then no sample is in the band.
+    room: OnceCell<Option<Region>>,
+    /// The ground outside the stock round the air (`approach.rs`), built
+    /// at the first approach.
+    pub(super) outside: OnceCell<Option<Region>>,
+}
+
+impl Proof<'_> {
+    /// True when the tool centre `q` stands in the edge band: in the legal
+    /// room of the entry stage, not inside the part zone (so its disc meets
+    /// no part, also a part that reaches out of the stock), and more than a
+    /// tool radius from each keep-out area. A region with no part zone (not
+    /// made by the region builder) or with no air has no band.
+    pub(super) fn in_band(&self, q: Point2) -> bool {
+        let zone = self.p.part_zone();
+        if zone.is_empty() || self.p.air().is_empty() {
+            return false;
+        }
+        let Some(room) = self.legal() else {
+            return false;
+        };
+        let in_zone = zone.contains(q) && to_loops(q, zone.loops()) > KERNEL_TOL;
+        let keep = self.p.keep_out();
+        let clear_of_keep = keep.is_empty() || (!in_area(keep, q) && to_loops(q, keep.loops()) > self.r);
+        !in_zone && clear_of_keep && in_area(room, q)
+    }
+
+    /// The samples of the chord `a`-`b`, both ends included.
+    pub(super) fn samples(&self, a: Point2, b: Point2) -> Vec<Point2> {
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        let step = STEP * self.r;
+        let n = if len.is_finite() && step > 0.0 { (len / step).ceil().clamp(1.0, 1e6) } else { 1.0 };
+        let n = n as usize;
+        (0..=n).map(|i| {
+            let t = i as f64 / n as f64;
+            Point2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y))
+        })
+        .collect()
+    }
+
+    /// The proof of one chord, `skip` the index of a made cut that the
+    /// chord may run along (the cut it goes back on). The reason names the
+    /// first test that fails.
+    ///
+    /// Open ground is only what is proved open: the air of the region, or a
+    /// sample within the swath of a cut already made. A centre near the
+    /// stock edge, inside or in the edge band outside, is not open by
+    /// itself: with no cut made beside it, its tool cuts more than the
+    /// swath into uncut stock (`UNCUT_STOCK`). The swath test bounds what
+    /// the disc cuts beyond the disc of a made cut, whatever stock is
+    /// there, so it reads a centre in the band as any other centre.
+    pub(super) fn chord(&self, a: Point2, b: Point2, skip: Option<usize>) -> Result<(), LiftReason> {
+        if near(a, b) {
+            return Ok(());
+        }
+        let pts = self.samples(a, b);
+        self.room(&pts)?;
+        self.crossing(a, b, skip)?;
+        let (air, reach) = (self.p.air(), SWATH * self.r);
+        if !pts.iter().all(|&q| in_area(air, q) || self.made.iter().any(|l| l.dist(q, reach) <= reach)) {
+            return Err(LiftReason(UNCUT_STOCK));
+        }
+        Ok(())
+    }
+
+    /// The room test of a chord's samples: each in the centre area, the
+    /// air or the edge band, else `HITS_FIXTURE` (within a tool radius of
+    /// a keep-out area) or `CUTS_PART`.
+    pub(super) fn room(&self, pts: &[Point2]) -> Result<(), LiftReason> {
+        let air = self.p.air();
+        if pts.iter().all(|&q| in_area(self.p.center(), q) || in_area(air, q) || self.in_band(q)) {
+            return Ok(());
+        }
+        let keep = self.p.keep_out();
+        let fixture = !keep.is_empty() && pts.iter().any(|&q| in_area(keep, q) || to_loops(q, keep.loops()) <= self.r);
+        Err(LiftReason(if fixture { HITS_FIXTURE } else { CUTS_PART }))
+    }
+
+    /// The crossing test of the chord `a`-`b`: it crosses no made cut (but
+    /// the one of index `skip`), no stay-down link before it, and touches
+    /// no planned cut away from the two ends of the link (`CROSSES_CUT`).
+    pub(super) fn crossing(&self, a: Point2, b: Point2, skip: Option<usize>) -> Result<(), LiftReason> {
+        let made = self.made.iter().enumerate().filter(|(i, _)| Some(*i) != skip).chain(self.links.iter().enumerate()).any(|(_, l)| l.meets(a, b, self.ends, true));
+        if made || self.planned.iter().any(|l| l.meets(a, b, self.ends, false)) {
+            return Err(LiftReason(CROSSES_CUT));
+        }
+        Ok(())
+    }
+
+    /// The legal room of the tool centre (`entry::legal_room`), built once;
+    /// `None` when its geometry cannot be computed.
+    pub(super) fn legal(&self) -> Option<&Region> {
+        self.room.get_or_init(|| legal_room(self.p).ok()).as_ref()
+    }
+
+    /// The proof of a path: each chord.
+    pub(super) fn path(&self, pts: &[Point2]) -> Result<(), LiftReason> {
+        pts.windows(2).try_for_each(|w| self.chord(w[0], w[1], None))
+    }
+
+    pub(super) fn region(&self) -> &PlanarRegion {
+        self.p
+    }
+    pub(super) fn radius(&self) -> f64 {
+        self.r
+    }
+}
+
+fn start_of(c: &Cut) -> Option<Point2> {
+    c.curve().pts().first().map(|p| p.at())
+}
+
+fn end_of(c: &Cut) -> Option<Point2> {
+    if c.curve().closed() { c.curve().pts().first() } else { c.curve().pts().last() }.map(|p| p.at())
+}
+
+/// The in-plane path from the end of `from` to the start of `to`, or the
+/// reason of the straight chord when no path is proved.
+fn stay_path(from: &Cut, to: &Cut, p: &PlanarRegion, level: Level<'_>) -> Result<Vec<Point2>, LiftReason> {
+    let (Some(a), Some(b)) = (end_of(from), start_of(to)) else {
+        return Err(LiftReason(BAD_PATH));
+    };
+    let mut proof = Proof {
+        p,
+        r: p.tool().radius(),
+        made: level.made().iter().map(Line::of).collect(),
+        planned: level.planned().iter().map(Line::of).collect(),
+        links: level.links().iter().map(|l| Line::path(l.clone())).collect(),
+        ends: (a, b),
+        room: OnceCell::new(),
+        outside: OnceCell::new(),
+    };
+    let why = match tries(&mut proof, from, a, b) {
+        Ok(path) => return Ok(path),
+        Err(why) => why,
+    };
+    // The approach from the air (#4254): out to the air and along it as
+    // above, then in to the start of an open piece at the stock edge with
+    // a stretch that cuts no stock off the planned curve.
+    super::approach::from_air(&mut proof, from, to, a, b).ok_or(why)
+}
+
+/// The tries of a path from `a` (the end of `from`) to `target`: the
+/// straight chord; back along the open cut just made, then a chord; a walk
+/// along a loop of the centre area or of the air. The reason is the one of
+/// the straight chord.
+pub(super) fn tries(proof: &mut Proof<'_>, from: &Cut, a: Point2, target: Point2) -> Result<Vec<Point2>, LiftReason> {
+    let why = match proof.chord(a, target, None) {
+        Ok(()) => return Ok(vec![a, target]),
+        Err(why) => why,
+    };
+    // Back along the open cut just made, then a chord to the target (the
+    // chain link of the air plan). The cut just made is the last one made;
+    // the chord may start on it.
+    let back: Vec<Point2> = from.curve().pts().iter().rev().map(|q| q.at()).collect();
+    if let (false, Some(&s), Some(last)) = (from.curve().closed(), back.last(), proof.made.len().checked_sub(1)) {
+        let ends = proof.ends;
+        proof.ends = (s, ends.1);
+        let ok = proof.chord(s, target, Some(last)).is_ok();
+        proof.ends = ends;
+        if ok {
+            let mut out = back;
+            out.push(target);
+            return Ok(out);
+        }
+    }
+    super::route::edge_route(proof, a, target).ok_or(why)
+}
+
+/// The in-plane path that the link stage proves from `from` to `to`, if
+/// any (the order stage reads it to pick a start that the link can reach).
+pub(crate) fn proved_path(from: &Cut, to: &Cut, p: &PlanarRegion, level: Level<'_>) -> Option<Vec<Point2>> {
+    stay_path(from, to, p, level).ok()
+}
+
+impl LinkProof for LinkStage {
+    fn link(&self, from: &Cut, to: &Cut, r: &KernelRegion, level: Level<'_>, policy: LinkPolicy, tally: &mut LinkTally) -> Hop {
+        // Each lift reason is a named constant of `link.rs`, so a lift can
+        // not be blank; each case has its own arm and no fallback.
+        let path = match (policy, r.planar()) {
+            (LinkPolicy::StayWhereProved, Some(p)) => stay_path(from, to, p, level),
+            (LinkPolicy::StayWhereProved, None) => Err(LiftReason(NOT_PLANAR_LINK)),
+            (LinkPolicy::Retract, _) => Err(LiftReason(USER_RETRACT)),
+        };
+        let hop = match path.map(Hop::stay) {
+            Ok(Ok(hop)) => hop,
+            Ok(Err(_)) => Hop::Lift(LiftReason(BAD_PATH)),
+            Err(why) => Hop::Lift(why),
+        };
+        tally.record(hop)
+    }
+}
diff --git a/crates/pathkernel/src/link/route.rs b/crates/pathkernel/src/link/route.rs
new file mode 100644
index 000000000..5f5dec918
--- /dev/null
+++ b/crates/pathkernel/src/link/route.rs
@@ -0,0 +1,128 @@
+//! The edge route of the link stage (#4177): where no straight link is
+//! proved, the tool walks along a loop of the cutter-centre area that both
+//! ends of the link stand near (within a tool radius), the shorter way
+//! first, and each chord of the walk is proved as a link. The walk joins
+//! the loop at the places of the loop nearest to the two ends, or at its
+//! vertices only, so that it can run exactly on a ring that lies on the
+//! loop (a ring at offset 0). A walk can also run along a loop of the air
+//! (#4241): from an end at the stock edge out through the edge band, along
+//! the air, and back in; the proof of each chord decides if it holds.
+//! Provenance: ported from the edge route of the ring links of
+//! `camcraft-motion` (`machining2d/ring_links.rs`, `edge_route`, #3824);
+//! our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 5: Link".
+
+use super::proof::Proof;
+use crate::entry::ROOM_TOL;
+use crate::{Loop, Point2, near, seg_dist};
+
+fn dist(a: Point2, b: Point2) -> f64 {
+    (a.x - b.x).hypot(a.y - b.y)
+}
+
+/// The nearest place of the closed loop `pts` to `q`: the index of its
+/// segment (from `pts[i]` to the next point), the place along it (0 to 1)
+/// and the distance.
+pub(super) fn project(pts: &[Point2], q: Point2) -> Option<(usize, f64, Point2, f64)> {
+    let n = pts.len();
+    let mut best: Option<(usize, f64, Point2, f64)> = None;
+    for i in 0..n {
+        let (Some(&a), Some(&b)) = (pts.get(i), pts.get((i + 1) % n)) else {
+            continue;
+        };
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let len2 = dx * dx + dy * dy;
+        let t = if len2 > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / len2).clamp(0.0, 1.0) } else { 0.0 };
+        let d = seg_dist(q, a, b);
+        if d.is_finite() && best.is_none_or(|(_, _, _, bd)| d < bd) {
+            best = Some((i, t, Point2::new(a.x + t * dx, a.y + t * dy), d));
+        }
+    }
+    best
+}
+
+/// The loop vertices between two places of a loop of `n` points, forward
+/// (in the loop's direction) or back.
+fn between(n: usize, (ia, ta): (usize, f64), (ib, tb): (usize, f64), forward: bool) -> Vec<usize> {
+    if n == 0 {
+        return Vec::new();
+    }
+    if forward {
+        let count = match (ib + n - ia) % n {
+            0 if tb >= ta => 0,
+            0 => n,
+            c => c,
+        };
+        (1..=count).map(|k| (ia + k) % n).collect()
+    } else {
+        let count = match (ia + n - ib) % n {
+            0 if tb <= ta => 0,
+            0 => n,
+            c => c,
+        };
+        (0..count).map(|k| (ia + n - k) % n).collect()
+    }
+}
+
+fn length(w: &[Point2]) -> f64 {
+    w.windows(2).map(|s| dist(s[0], s[1])).sum()
+}
+
+/// The proved walk from `a` to `b` along a loop of the centre area or of
+/// the air, the shortest first; `None` when no walk is proved. The ends
+/// stand within a tool radius of a centre loop; of an air loop, within the
+/// edge band (a tool radius and the room tolerance: an end on the stock
+/// edge is one tool radius from the air).
+pub(super) fn edge_route(proof: &Proof<'_>, a: Point2, b: Point2) -> Option<Vec<Point2>> {
+    let r = proof.radius();
+    let centre = proof.region().center().loops().iter().map(|l| (l, r));
+    let air = proof.region().air().loops().iter().map(|l| (l, r + ROOM_TOL));
+    let loops: Vec<(&Loop, f64)> = centre.chain(air).collect();
+    let mut ways: Vec<Vec<Point2>> = Vec::new();
+    for (l, gap) in loops {
+        let pts = l.points();
+        if pts.len() < 3 {
+            continue;
+        }
+        let (Some((ia, ta, pa, da)), Some((ib, tb, pb, db))) = (project(pts, a), project(pts, b)) else {
+            continue;
+        };
+        if da > gap || db > gap {
+            continue;
+        }
+        for forward in [true, false] {
+            let mid: Vec<Point2> = between(pts.len(), (ia, ta), (ib, tb), forward).into_iter().filter_map(|i| pts.get(i).copied()).collect();
+            // Joined at the nearest places of the loop (the walk runs on
+            // the edge), or at its vertices only (the walk runs exactly on
+            // a ring that lies on the loop).
+            for (on, off) in [(Some(pa), Some(pb)), (None, None)] {
+                if mid.is_empty() && on.is_none() {
+                    continue;
+                }
+                let mut w = vec![a];
+                w.extend(on);
+                w.extend(mid.iter().copied());
+                w.extend(off);
+                w.push(b);
+                w.dedup_by(|x, y| near(*x, *y));
+                ways.push(w);
+            }
+        }
+    }
+    ways.sort_by(|x, y| length(x).total_cmp(&length(y)));
+    ways.into_iter().find(|w| proof.path(w).is_ok())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_walk_between_two_places_goes_each_way_round() {
+        assert_eq!(between(4, (0, 0.5), (2, 0.5), true), vec![1, 2]);
+        assert_eq!(between(4, (0, 0.5), (2, 0.5), false), vec![0, 3]);
+        assert_eq!(between(4, (1, 0.2), (1, 0.8), true), Vec::<usize>::new());
+        assert_eq!(between(4, (1, 0.8), (1, 0.2), true).len(), 4);
+        assert_eq!(between(4, (1, 0.8), (1, 0.2), false), Vec::<usize>::new());
+    }
+}
diff --git a/crates/pathkernel/src/load.rs b/crates/pathkernel/src/load.rs
new file mode 100644
index 000000000..706beaa61
--- /dev/null
+++ b/crates/pathkernel/src/load.rs
@@ -0,0 +1,250 @@
+//! Stage 3, Load control (K3, #4026): the load choice, the readings and the
+//! over-limit record, and the stock reader. The `Controlled` constructor
+//! checks law 6: each cut read above the limit is named, and each name
+//! agrees with a reading. The planner is [`LoadStage`] in `load/` (#4026):
+//! the engagement law (`law.rs`), constant engagement on rings
+//! (`rings.rs`) and trochoidal loops (`trochoid.rs`).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 3: Load control"; radial engagement as in Stori & Wright (2000)
+//! and Held & Spielberger (2009).
+
+mod law;
+mod rings;
+mod stage;
+mod trochoid;
+
+pub use law::NO_RASTER;
+pub use rings::{AT_FLOOR, LOAD_GEOMETRY, NOT_A_RING, NOT_FIXED, TOO_MANY_PASSES};
+pub use stage::{DEFAULT_LIMIT, FRESH_CUT, LOAD_NOT_PLANAR, LoadStage, NO_CONTROL, SET_NOT_KEPT, STOCK_REACH_ELSEWHERE};
+pub use trochoid::{LOOP_LEAVES, LOOPS_NOT_A_CURVE, LOOPS_OVER, NO_ROOM, NOT_MARKED, SHAPE_KEPT};
+
+use crate::frame::{Positive, Spot};
+use crate::order::OrderedSet;
+use crate::region::KernelRegion;
+use crate::verdict::{NO_REASON, Refusal, Stage, Verdict};
+use crate::{KERNEL_TOL, Point2};
+
+/// The relative tolerance of the load limit: a cut above
+/// `load x (1 + PLAN_TOL)` is over the limit.
+pub const PLAN_TOL: f64 = 0.05;
+
+/// Refusal reason: an engagement out of its domain.
+pub const BAD_LOAD: &str = "an engagement ae/D must be a finite number from 0 to 1 (a limit: above 0)";
+/// Refusal reason: a trochoid whose pitch is not below its width.
+pub const BAD_TROCHOID: &str = "a trochoid needs a positive width and a positive pitch below the width";
+
+/// A radial engagement ae/D from 0 to 1 (1 is a full-width slot).
+#[derive(Clone, Copy, Debug, PartialEq, PartialOrd)]
+pub struct Engagement(f64);
+
+impl Engagement {
+    pub fn new(stage: Stage, v: f64) -> Result<Self, Refusal> {
+        if v.is_finite() && (0.0..=1.0).contains(&v) { Ok(Self(v)) } else { Err(Refusal::new(stage, BAD_LOAD)) }
+    }
+    /// A limit: an engagement above 0.
+    pub fn limit(stage: Stage, v: f64) -> Result<Self, Refusal> {
+        let e = Self::new(stage, v)?;
+        if e.0 > 0.0 { Ok(e) } else { Err(Refusal::new(stage, BAD_LOAD)) }
+    }
+    #[must_use]
+    pub fn get(self) -> f64 {
+        self.0
+    }
+}
+
+/// What the constant-engagement control reads the cut material from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Reach {
+    /// The rings before (Offset rings).
+    Rings,
+    /// The in-process stock (Adaptive).
+    Stock,
+}
+
+/// Trochoidal loops along a curve: a positive width and a positive pitch below it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Trochoid {
+    width: Positive,
+    pitch: Positive,
+}
+
+impl Trochoid {
+    pub fn new(width: f64, pitch: f64) -> Result<Self, Refusal> {
+        let (w, p) = (Positive::new(Stage::Recipe, width), Positive::new(Stage::Recipe, pitch));
+        match (w, p) {
+            (Ok(w), Ok(p)) if p < w => Ok(Self { width: w, pitch: p }),
+            _ => Err(Refusal::new(Stage::Recipe, BAD_TROCHOID)),
+        }
+    }
+    #[must_use]
+    pub fn width(&self) -> f64 {
+        self.width.get()
+    }
+    #[must_use]
+    pub fn pitch(&self) -> f64 {
+        self.pitch.get()
+    }
+}
+
+/// How the load on the tool is held. Each variant with data holds a
+/// checked value.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+#[non_exhaustive]
+pub enum LoadControl {
+    /// The identity: the curves stay; the load is still read and named.
+    #[default]
+    None,
+    Trochoidal(Trochoid),
+    ConstantEngagement(ConstantLoad),
+}
+
+/// A constant engagement: a limit above 0 and at most 1, read from `Reach`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ConstantLoad {
+    load: Engagement,
+    reach: Reach,
+}
+
+impl ConstantLoad {
+    pub fn new(load: f64, reach: Reach) -> Result<Self, Refusal> {
+        Ok(Self { load: Engagement::limit(Stage::Recipe, load)?, reach })
+    }
+    #[must_use]
+    pub fn load(&self) -> f64 {
+        self.load.get()
+    }
+    #[must_use]
+    pub fn reach(&self) -> Reach {
+        self.reach
+    }
+}
+
+impl LoadControl {
+    /// A constant engagement of `load` (above 0, at most 1).
+    pub fn constant(load: f64, reach: Reach) -> Result<Self, Refusal> {
+        ConstantLoad::new(load, reach).map(Self::ConstantEngagement)
+    }
+}
+
+/// One load reading: the engagement at a finite place of a cut.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Reading {
+    at: Spot,
+    load: Engagement,
+}
+
+impl Reading {
+    pub fn new(at: Point2, load: f64) -> Result<Self, Refusal> {
+        Ok(Self { at: Spot::new(Stage::Load, at)?, load: Engagement::new(Stage::Load, load)? })
+    }
+    #[must_use]
+    pub fn at(&self) -> Point2 {
+        self.at.get()
+    }
+    #[must_use]
+    pub fn load(&self) -> f64 {
+        self.load.get()
+    }
+}
+
+/// A cut read above the limit: its reading and a reason that is not blank.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct OverLimit {
+    reading: Reading,
+    reason: &'static str,
+}
+
+impl OverLimit {
+    pub fn new(at: Point2, load: f64, reason: &'static str) -> Result<Self, Refusal> {
+        if reason.trim().is_empty() {
+            return Err(Refusal::new(Stage::Load, NO_REASON));
+        }
+        Ok(Self { reading: Reading::new(at, load)?, reason })
+    }
+    #[must_use]
+    pub fn at(&self) -> Point2 {
+        self.reading.at()
+    }
+    #[must_use]
+    pub fn load(&self) -> f64 {
+        self.reading.load()
+    }
+    #[must_use]
+    pub fn reason(&self) -> &'static str {
+        self.reason
+    }
+}
+
+/// The ordered set after load control, with its readings and every cut
+/// above the limit.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Controlled {
+    set: OrderedSet,
+    readings: Vec<Reading>,
+    over: Vec<OverLimit>,
+    limit: Engagement,
+}
+
+/// Refusal reason: a reading above the limit with no over-limit record (law 6).
+pub const UNNAMED_OVERLOAD: &str = "a cut above the load limit must be named in the over-limit list";
+/// Refusal reason: an over-limit record that names no reading above the limit.
+pub const STRAY_OVERLOAD: &str = "an over-limit record must name a reading above the limit, at its place and with its load";
+/// Refusal reason: two over-limit records for one reading.
+pub const DOUBLE_OVERLOAD: &str = "a reading above the limit must be named once";
+
+fn same(r: &Reading, o: &OverLimit) -> bool {
+    crate::near(r.at(), o.at()) && (r.load() - o.load()).abs() <= KERNEL_TOL
+}
+
+impl Controlled {
+    /// Every record is valid by its type. Refused when the limit is not in
+    /// (0, 1], when a reading above `limit x (1 + PLAN_TOL)` is not named
+    /// exactly once, or when an over-limit record does not agree with a
+    /// reading above the limit (same place and load).
+    pub fn new(set: OrderedSet, readings: Vec<Reading>, over: Vec<OverLimit>, limit: f64) -> Result<Self, Refusal> {
+        let limit = Engagement::limit(Stage::Load, limit)?;
+        let cap = limit.get() * (1.0 + PLAN_TOL);
+        let hot = |r: &&Reading| r.load() > cap;
+        for r in readings.iter().filter(hot) {
+            match over.iter().filter(|o| same(r, o)).count() {
+                0 => return Err(Refusal::new(Stage::Load, UNNAMED_OVERLOAD).at(r.at())),
+                1 => {}
+                _ => return Err(Refusal::new(Stage::Load, DOUBLE_OVERLOAD).at(r.at())),
+            }
+        }
+        if let Some(o) = over.iter().find(|o| !readings.iter().filter(hot).any(|r| same(r, o))) {
+            return Err(Refusal::new(Stage::Load, STRAY_OVERLOAD).at(o.at()));
+        }
+        Ok(Self { set, readings, over, limit })
+    }
+    #[must_use]
+    pub fn set(&self) -> &OrderedSet {
+        &self.set
+    }
+    #[must_use]
+    pub fn readings(&self) -> &[Reading] {
+        &self.readings
+    }
+    #[must_use]
+    pub fn over(&self) -> &[OverLimit] {
+        &self.over
+    }
+    #[must_use]
+    pub fn limit(&self) -> f64 {
+        self.limit.get()
+    }
+}
+
+/// The in-process stock as the stages read it. Motion implements it, so
+/// the kernel has no edge to the simulator.
+pub trait StockRead {
+    /// True when material stands at `p` in the plan's plane; `None` when the
+    /// reader does not know (the stage must then not claim a proof).
+    fn material_at(&self, p: Point2) -> Option<bool>;
+}
+
+/// A load planner.
+pub trait LoadPlanner {
+    fn control(&self, s: OrderedSet, r: &KernelRegion, stock: &dyn StockRead, lc: &LoadControl, tool_r: f64)
+    -> Result<Verdict<Controlled>, Refusal>;
+}
