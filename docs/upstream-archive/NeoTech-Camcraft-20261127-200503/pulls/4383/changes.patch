index 000000000..aee441e7c
--- /dev/null
+++ b/crates/pathkernel/src/load/trochoid.rs
@@ -0,0 +1,223 @@
+//! Trochoidal load control (K3, #4026): each full-width stretch that the
+//! guide names (a `FullWidth` mark: a slot, a neck) is replaced by
+//! trochoidal loops that walk the stretch itself (#3932: they follow the
+//! contour, they do not slot to a wall). Each loop touches the stretch at
+//! its start and its end and lies on the side of the stretch with the more
+//! room; its radius is the room that is free there, at most half the loop
+//! width, so that the loop stays in the cutter-centre area. The loops
+//! advance one step a loop, and the step is at most the load width of the
+//! limit. Where no loop fits, the stretch stays and its cut is named. All
+//! curves, the clean-up rings too, are read with the one law (#3849).
+//! Provenance: trochoidal milling with the step per loop as the radial
+//! engagement of the front arc (Otkur & Lazoglu 2007, Int. J. Mach. Tools
+//! Manuf. 47; Rauch, Duc & Hascoet 2009, Int. J. Mach. Tools Manuf. 49);
+//! our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 3".
+
+use super::law::{Read, Stock, read, samples};
+use super::stage::{Outcome, finish, on_span};
+use super::{Controlled, OrderedSet, Trochoid};
+use crate::frame::PlanePoint;
+use crate::guide::{Curve, Mark, MarkKind, Span};
+use crate::region::PlanarRegion;
+use crate::verdict::{Refusal, Stage, Verdict};
+use crate::{Point2, Region, in_area, to_loops};
+
+/// Over-limit reason: no loop fits beside the full-width stretch.
+pub const NO_ROOM: &str = "no room for trochoidal loops here: this full-width stretch stays";
+/// Over-limit reason: the loops read above the limit.
+pub const LOOPS_OVER: &str = "the trochoidal loops read above the load limit here";
+/// Over-limit reason: trochoidal control changes only full-width stretches.
+pub const NOT_MARKED: &str = "trochoidal control changes only the full-width stretches: this cut stays above the load limit";
+/// Refusal reason: a loop point outside the cutter-centre area.
+pub const LOOP_LEAVES: &str = "a trochoidal loop leaves the cutter-centre area";
+/// Over-limit reason: the stretch is on a curve whose shape is data (a
+/// helix with its lead, an exact circle, a curve that changes its depth):
+/// flat loops would drop that data, so the curve stays (#4176).
+pub const SHAPE_KEPT: &str =
+    "trochoidal loops are flat and have no circle: a helix, an exact circle or a curve that changes its depth keeps its shape, and this cut stays above the load limit";
+/// Refusal reason: the loops of a stretch do not make a valid curve.
+pub const LOOPS_NOT_A_CURVE: &str = "the trochoidal loops of this stretch do not make a valid curve";
+
+/// The points of one loop.
+const PER_LOOP: usize = 24;
+/// The smallest loop radius: this share of the tool radius.
+const MIN_LOOP_SHARE: f64 = 0.05;
+/// The halvings of the room search.
+const BISECT: usize = 14;
+/// The most loops of one stretch.
+const MAX_LOOPS: usize = 20_000;
+
+/// The largest radius up to `most` of a disc that touches `q` from the
+/// side `n` and lies in `center`.
+fn room(center: &Region, q: Point2, n: Point2, most: f64) -> f64 {
+    let fits = |rho: f64| {
+        let c = Point2::new(q.x + rho * n.x, q.y + rho * n.y);
+        center.contains(c) && to_loops(c, center.loops()) >= rho * (1.0 - 1e-3)
+    };
+    if fits(most) {
+        return most;
+    }
+    let (mut lo, mut hi) = (0.0, most);
+    for _ in 0..BISECT {
+        let m = 0.5 * (lo + hi);
+        if fits(m) { lo = m } else { hi = m }
+    }
+    lo
+}
+
+/// The places of a run at `n + 1` even steps along it, with directions.
+fn resample(line: &[Point2], n: usize) -> Vec<(Point2, Point2)> {
+    let seg: Vec<f64> = line.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).collect();
+    let total: f64 = seg.iter().sum();
+    let mut out = Vec::with_capacity(n + 1);
+    let (mut j, mut acc) = (0usize, 0.0);
+    for k in 0..=n {
+        let s = total * k as f64 / n.max(1) as f64;
+        while j + 1 < seg.len() && acc + seg[j] < s {
+            acc += seg[j];
+            j += 1;
+        }
+        let (Some(a), Some(b), Some(&l)) = (line.get(j), line.get(j + 1), seg.get(j)) else { break };
+        let t = if l > 0.0 { ((s - acc) / l).clamp(0.0, 1.0) } else { 0.0 };
+        let d = if l > 0.0 { Point2::new((b.x - a.x) / l, (b.y - a.y) / l) } else { Point2::new(1.0, 0.0) };
+        out.push((Point2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y)), d));
+    }
+    out
+}
+
+/// The loops along one run of a stretch: `n` loops of `PER_LOOP` points,
+/// and true when one of them has a radius. A loop is
+/// `q + rho n (1 - cos t) + rho d sin t`: it leaves the stretch and comes
+/// back to it; `rho` is the room on the side with more room (0 below `least`).
+fn loops(center: &Region, run: &[Point2], pitch: f64, (most, least): (f64, f64)) -> Result<(Vec<Point2>, bool), Refusal> {
+    let len: f64 = run.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum();
+    let n = ((len / pitch).ceil().max(1.0) as usize).min(MAX_LOOPS);
+    let spine = resample(run, n * PER_LOOP);
+    let left = |d: Point2| Point2::new(-d.y, d.x);
+    let (mut out, mut made) = (Vec::with_capacity(spine.len()), false);
+    for part in spine.get(..n * PER_LOOP).unwrap_or(&[]).chunks(PER_LOOP) {
+        let side = |sgn: f64| part.iter().map(|(q, d)| room(center, *q, Point2::new(sgn * left(*d).x, sgn * left(*d).y), most)).fold(most, f64::min);
+        let (a, b) = (side(1.0), side(-1.0));
+        let (sgn, rho) = if a >= b { (1.0, a) } else { (-1.0, b) };
+        let rho = if rho >= least { rho } else { 0.0 };
+        made |= rho > 0.0;
+        for (j, (q, d)) in part.iter().enumerate() {
+            let t = std::f64::consts::TAU * j as f64 / PER_LOOP as f64;
+            let nn = left(*d);
+            let (u, v) = (rho * (1.0 - t.cos()) * sgn, rho * t.sin());
+            let pt = Point2::new(q.x + u * nn.x + v * d.x, q.y + u * nn.y + v * d.y);
+            if !in_area(center, pt) {
+                return Err(Refusal::new(Stage::Load, LOOP_LEAVES).at(pt));
+            }
+            out.push(pt);
+        }
+    }
+    out.extend(spine.last().map(|(q, _)| *q));
+    Ok((out, made))
+}
+
+/// Curve `c` with each stretch of `marks` replaced by loops, or `None`
+/// when no loop fits.
+fn change(c: &Curve, marks: &[&Mark], center: &Region, pitch: f64, radii: (f64, f64)) -> Result<Option<Curve>, Refusal> {
+    let mut pts: Vec<Point2> = samples(c, pitch / PER_LOOP as f64).into_iter().map(|(q, _)| q).collect();
+    let mut on: Vec<bool> = pts.iter().map(|q| marks.iter().any(|m| on_span(m, *q))).collect();
+    if c.closed()
+        && let Some(off) = on.iter().position(|b| !b)
+    {
+        pts.rotate_left(off);
+        on.rotate_left(off);
+    }
+    let whole = on.iter().all(|b| *b);
+    if whole && c.closed() {
+        pts.extend(pts.first().copied());
+    }
+    let (mut out, mut run, mut any) = (Vec::new(), Vec::new(), false);
+    for (q, hit) in pts.iter().zip(&on) {
+        if *hit {
+            run.push(*q);
+            continue;
+        }
+        if run.len() >= 2 {
+            let (lp, made) = loops(center, &run, pitch, radii)?;
+            any |= made;
+            out.extend(lp);
+        } else {
+            out.append(&mut run);
+        }
+        run.clear();
+        out.push(*q);
+    }
+    if run.len() >= 2 {
+        let (lp, made) = loops(center, &run, pitch, radii)?;
+        any |= made;
+        out.extend(lp);
+    } else {
+        out.extend(run);
+    }
+    out.dedup_by(|a, b| crate::near(*a, *b));
+    if c.closed() && out.len() > 1 && out.first().zip(out.last()).is_some_and(|(a, b)| crate::near(*a, *b)) {
+        out.pop();
+    }
+    if !any {
+        return Ok(None);
+    }
+    // A closed curve keeps its start (the order stage chose it).
+    if c.closed()
+        && let Some(s) = c.pts().first().map(PlanePoint::at)
+    {
+        let k = out.iter().enumerate().min_by(|a, b| (a.1.x - s.x).hypot(a.1.y - s.y).total_cmp(&(b.1.x - s.x).hypot(b.1.y - s.y))).map_or(0, |(k, _)| k);
+        out.rotate_left(k);
+    }
+    let z = c.pts().first().map_or(0.0, PlanePoint::depth);
+    let pp: Result<Vec<PlanePoint>, Refusal> = out.into_iter().map(|q| PlanePoint::new(q, z)).collect();
+    // `keeps_shape` let only a flat curve without a circle or a lead here,
+    // so the constructor of its family keeps all of its data.
+    c.with_points(pp?).map(Some).map_err(|_| Refusal::new(Stage::Load, LOOPS_NOT_A_CURVE))
+}
+
+/// True when the shape of `c` is data that flat loops cannot keep: the
+/// lead of a helix, an exact circle, or a depth that changes along it.
+fn keeps_shape(c: &Curve) -> bool {
+    let z = c.pts().first().map_or(0.0, PlanePoint::depth);
+    c.lead().is_some() || c.arc().is_some() || c.pts().iter().any(|q| (q.depth() - z).abs() > crate::KERNEL_TOL)
+}
+
+/// Trochoidal control of the ordered set `s` with the stated `limit`.
+pub(crate) fn control(s: &OrderedSet, p: &PlanarRegion, stock: &Stock, t: &Trochoid, limit: f64, r: f64) -> Result<Verdict<Controlled>, Refusal> {
+    let pitch = t.pitch().min(limit * 2.0 * r);
+    let radii = (t.width() / 2.0, MIN_LOOP_SHARE * r);
+    let mut curves = s.curves().to_vec();
+    let mut changed = vec![false; curves.len()];
+    let mut kept = vec![false; curves.len()];
+    for (i, c) in s.curves().iter().enumerate() {
+        let mine: Vec<&Mark> = s.marks().iter().filter(|m| m.curve() == i && m.kind() == MarkKind::FullWidth).collect();
+        if mine.is_empty() {
+            continue;
+        }
+        if keeps_shape(c) {
+            kept[i] = true;
+            continue;
+        }
+        if let Some(n) = change(c, &mine, p.center(), pitch, radii)? {
+            curves[i] = n;
+            changed[i] = true;
+        }
+    }
+    let reads = read(stock, &curves, r);
+    let marks: Vec<Mark> = s.marks().iter().filter(|m| !changed.get(m.curve()).copied().unwrap_or(false) || matches!(m.span(), Span::Whole) && m.kind() != MarkKind::FullWidth).cloned().collect();
+    let full = |rd: &Read| s.marks().iter().any(|m| m.curve() == rd.curve && m.kind() == MarkKind::FullWidth && on_span(m, rd.at));
+    let reason = |rd: &Read| -> &'static str {
+        if changed.get(rd.curve).copied().unwrap_or(false) {
+            LOOPS_OVER
+        } else if kept.get(rd.curve).copied().unwrap_or(false) && full(rd) {
+            SHAPE_KEPT
+        } else if full(rd) {
+            NO_ROOM
+        } else {
+            NOT_MARKED
+        }
+    };
+    let out = Outcome { curves: changed.iter().any(|b| *b).then(|| curves.clone()), marks, reads };
+    finish(s, out, limit, "trochoidal", reason)
+}
diff --git a/crates/pathkernel/src/order.rs b/crates/pathkernel/src/order.rs
new file mode 100644
index 000000000..17868be76
--- /dev/null
+++ b/crates/pathkernel/src/order.rs
@@ -0,0 +1,135 @@
+//! Stage 4, Order (K4): the start side, the direction and the ordered set.
+//! The ordered set's constructor checks law 3: the output curves are the
+//! input curves, permuted, with a start point and a direction. Nothing else
+//! changes. The marks of the guide set go with their curves. The planner
+//! is in `order/` (#4177).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 4: Order"; climb and conventional milling as in any machining
+//! handbook.
+
+mod chain;
+mod side;
+mod stage;
+
+pub use stage::{HELIX_HAND_SETS_DIRECTION, NOT_REVERSIBLE, ORDER_NOT_PLANAR, OrderStage};
+
+use crate::guide::{Curve, GuideSet, Mark};
+use crate::region::KernelRegion;
+use crate::verdict::{Refusal, Stage, Verdict};
+use crate::{Point2, Region, finite};
+
+/// Where the passes start. The material side is not here: it is stage 1.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum StartSide {
+    #[default]
+    Auto,
+    Inside,
+    Outside,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum Direction {
+    #[default]
+    Climb,
+    Conventional,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub struct OrderChoice {
+    pub start: StartSide,
+    pub direction: Direction,
+}
+
+/// The ordered curves, the first start point, the side that Auto
+/// resolved to (never Auto), and the marks of the guide set, each on its
+/// curve's new index.
+#[derive(Clone, Debug, PartialEq)]
+pub struct OrderedSet {
+    curves: Vec<Curve>,
+    start: Point2,
+    resolved: StartSide,
+    marks: Vec<Mark>,
+}
+
+/// Refusal reason: the order stage changed a curve, dropped one or added one.
+pub const NOT_A_PERMUTATION: &str = "the order stage may only permute the guide curves, restart a closed curve and reverse a curve";
+/// Refusal reason: Auto was not resolved to Inside or Outside.
+pub const UNRESOLVED: &str = "the order stage must resolve Auto to Inside or Outside";
+/// Refusal reason: a start point that is not the first point of the first curve.
+pub const START_OFF_CURVE: &str = "the start point must be the first point of the first ordered curve";
+/// Refusal reason: a start point that is not finite.
+pub const BAD_START: &str = "the start point is not a finite number";
+
+impl OrderedSet {
+    /// The ordered set made from `input`. Refused unless `curves` is a
+    /// permutation of the input curves, each only restarted (closed) or
+    /// reversed, with its index, family and circle; `resolved` is not Auto; and `start`
+    /// is the first point of the first curve (any finite point for no curve).
+    /// Each mark of `input` moves with its curve: no planner can drop or
+    /// move a mark (#4177).
+    pub fn new(input: &GuideSet, curves: Vec<Curve>, start: Point2, resolved: StartSide) -> Result<Self, Refusal> {
+        if resolved == StartSide::Auto {
+            return Err(Refusal::new(Stage::Order, UNRESOLVED));
+        }
+        if !finite(&[start.x, start.y]) {
+            return Err(Refusal::new(Stage::Order, BAD_START));
+        }
+        let Some(map) = permutation(input.curves(), &curves) else {
+            return Err(Refusal::new(Stage::Order, NOT_A_PERMUTATION));
+        };
+        if curves.first().and_then(|c| c.pts().first()).is_some_and(|p| !crate::near(p.at(), start)) {
+            return Err(Refusal::new(Stage::Order, START_OFF_CURVE).at(start));
+        }
+        let mut marks = Vec::with_capacity(input.marks().len());
+        for m in input.marks() {
+            let hit = map.iter().enumerate().find(|(_, (i, _))| *i == m.curve());
+            let Some((j, &(_, reversed))) = hit else {
+                return Err(Refusal::new(Stage::Order, NOT_A_PERMUTATION));
+            };
+            marks.push(m.clone().follow(j, reversed));
+        }
+        marks.sort_by(Mark::cmp_set);
+        Ok(Self { curves, start, resolved, marks })
+    }
+    #[must_use]
+    pub fn curves(&self) -> &[Curve] {
+        &self.curves
+    }
+    #[must_use]
+    pub fn start(&self) -> Point2 {
+        self.start
+    }
+    #[must_use]
+    pub fn resolved(&self) -> StartSide {
+        self.resolved
+    }
+    /// The named stretches of the guide set, each on the index of its
+    /// curve in [`OrderedSet::curves`] (a stretch of a reversed curve runs
+    /// in the new direction). The load stage (K3) reads them.
+    #[must_use]
+    pub fn marks(&self) -> &[Mark] {
+        &self.marks
+    }
+}
+
+/// For each curve of `out`, the index of its input curve and whether it is
+/// reversed; `None` unless `out` holds each curve of `input` once, each
+/// only restarted or reversed ([`Curve::same_cut`]).
+fn permutation(input: &[Curve], out: &[Curve]) -> Option<Vec<(usize, bool)>> {
+    if input.len() != out.len() {
+        return None;
+    }
+    let mut used = vec![false; input.len()];
+    let mut map = Vec::with_capacity(out.len());
+    for c in out {
+        let (i, rev) = input.iter().enumerate().filter(|(i, _)| !used[*i]).find_map(|(i, g)| g.turn_of(c).map(|r| (i, r)))?;
+        used[i] = true;
+        map.push((i, rev));
+    }
+    Some(map)
+}
+
+/// An order planner. It reads no material side (law 2).
+pub trait OrderPlanner {
+    fn order(&self, g: GuideSet, r: &KernelRegion, o: &OrderChoice, stock: Option<&Region>) -> Result<Verdict<OrderedSet>, Refusal>;
+}
diff --git a/crates/pathkernel/src/order/chain.rs b/crates/pathkernel/src/order/chain.rs
new file mode 100644
index 000000000..7a19184b5
--- /dev/null
+++ b/crates/pathkernel/src/order/chain.rs
@@ -0,0 +1,109 @@
+//! The sequence of the curves in the order stage (#4177): the levels of the
+//! ring index in the walk's sense, and the chain order of the split pieces
+//! of a band walked from the stock edge (#3934): the runs of consecutive
+//! levels in one open region form a chain, and the chains are cut one
+//! after the other.
+//! Provenance: the chain order is ported from the Adaptive air plan of
+//! `camcraft-motion` (`machining2d/adaptive/air_chain.rs`, `chains`), as
+//! the design record decided for #3934; it is the return pass of
+//! contour-parallel pocketing (Held, "On the Computational Geometry of
+//! Pocket Machining", 1991). Our own design record
+//! `docs/decisions/4024-path-kernel-design.md` "Stage 4: Order".
+
+use crate::guide::Curve;
+use crate::{Point2, seg_dist};
+
+/// The curve indices grouped by ring index, the groups in the walk's
+/// order (the deepest first when `deeper_first`), each group in the order
+/// of the guide set.
+pub(super) fn levels(curves: &[Curve], deeper_first: bool) -> Vec<Vec<usize>> {
+    let mut ks: Vec<u32> = curves.iter().map(Curve::k).collect();
+    ks.sort_unstable();
+    ks.dedup();
+    if deeper_first {
+        ks.reverse();
+    }
+    ks.into_iter().map(|k| (0..curves.len()).filter(|&i| curves.get(i).is_some_and(|c| c.k() == k)).collect()).collect()
+}
+
+fn dist(a: Point2, b: Point2) -> f64 {
+    (a.x - b.x).hypot(a.y - b.y)
+}
+
+/// The chain of each run: each run of a level joins the nearest chain
+/// whose last run ends within `reach` of both of its ends (one run for
+/// each chain and level), else it starts a new chain. The result gives the
+/// chain number of each run (chains numbered in the order they start).
+/// `ends[i]` are the first and the last point of run `i` as it will be cut.
+pub(super) fn chains(levels: &[Vec<usize>], ends: &[(Point2, Point2)], reach: f64) -> Vec<usize> {
+    let mut out: Vec<Vec<usize>> = Vec::new();
+    for runs in levels {
+        let mut taken = vec![false; out.len()];
+        for &run in runs {
+            let Some(&(a, b)) = ends.get(run) else {
+                continue;
+            };
+            let near = |c: &Vec<usize>| c.last().and_then(|&l| ends.get(l)).map(|&(la, lb)| dist(la, a).max(dist(lb, b)));
+            let best = out
+                .iter()
+                .enumerate()
+                .filter(|(i, _)| !taken.get(*i).copied().unwrap_or(true))
+                .filter_map(|(i, c)| near(c).map(|d| (i, d)))
+                .filter(|&(_, d)| d <= reach)
+                .min_by(|x, y| x.1.total_cmp(&y.1));
+            match best.and_then(|(i, _)| out.get_mut(i).map(|c| (i, c))) {
+                Some((i, c)) => {
+                    c.push(run);
+                    if let Some(t) = taken.get_mut(i) {
+                        *t = true;
+                    }
+                }
+                None => out.push(vec![run]),
+            }
+        }
+    }
+    let mut id = vec![usize::MAX; ends.len()];
+    for (c, runs) in out.iter().enumerate() {
+        for &r in runs {
+            if let Some(slot) = id.get_mut(r) {
+                *slot = c;
+            }
+        }
+    }
+    id
+}
+
+/// True when the curves `a` and `b` come within `reach` of each other.
+fn near(a: &Curve, b: &Curve, reach: f64) -> bool {
+    let bounds = |c: &Curve| {
+        c.pts().iter().fold((f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY), |m, p| {
+            let q = p.at();
+            (m.0.min(q.x), m.1.min(q.y), m.2.max(q.x), m.3.max(q.y))
+        })
+    };
+    let (x, y) = (bounds(a), bounds(b));
+    if x.0 > y.2 + reach || y.0 > x.2 + reach || x.1 > y.3 + reach || y.1 > x.3 + reach {
+        return false;
+    }
+    let segs = |c: &Curve| -> Vec<(Point2, Point2)> {
+        let p: Vec<Point2> = c.pts().iter().map(|q| q.at()).collect();
+        let close = if c.closed() { p.first().zip(p.last()).map(|(f, l)| (*l, *f)) } else { None };
+        p.windows(2).map(|w| (w[0], w[1])).chain(close).collect()
+    };
+    let one = |from: &Curve, to: &[(Point2, Point2)]| from.pts().iter().any(|q| to.iter().any(|(s, e)| seg_dist(q.at(), *s, *e) <= reach));
+    one(a, &segs(b)) || one(b, &segs(a))
+}
+
+/// The runs that each run waits for: the runs of the level before it in
+/// the walk (`k + 1` when the deepest come first, else `k - 1`) that come
+/// within `reach` of it. A ring is cut only when its neighbours on the
+/// side the walk comes from are cut (the order of the offset tree, Held
+/// 1991).
+pub(super) fn needs(runs: &[Curve], deeper_first: bool, reach: f64) -> Vec<Vec<usize>> {
+    runs.iter()
+        .map(|c| {
+            let before = if deeper_first { c.k().checked_add(1) } else { c.k().checked_sub(1) };
+            (0..runs.len()).filter(|&j| runs.get(j).is_some_and(|o| Some(o.k()) == before && near(c, o, reach))).collect()
+        })
+        .collect()
+}
diff --git a/crates/pathkernel/src/order/side.rs b/crates/pathkernel/src/order/side.rs
new file mode 100644
index 000000000..1314acd4e
--- /dev/null
+++ b/crates/pathkernel/src/order/side.rs
@@ -0,0 +1,92 @@
+//! The start side in the order stage (#4177): Auto resolved in one place,
+//! the sense in which the ring index grows (into the area or out to the
+//! stock edge), and the side of each curve where the deeper curves lie, so
+//! that the direction choice can put the uncut material on the right
+//! (climb) or on the left (conventional) of the travel.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 4: Order" and "#3934" (Outside walks from the stock edge, Inside
+//! from the part wall); climb milling with the material on the right of a
+//! clockwise spindle, as in any machining handbook.
+
+use super::StartSide;
+use crate::guide::{Curve, Family};
+use crate::region::PlanarRegion;
+use crate::{Loop, Point2, to_loops};
+
+/// How far (mm) the side test steps off a curve.
+const SIDE_STEP: f64 = 0.01;
+
+/// Auto resolves to Outside when the region reaches a stock edge with air
+/// beyond it (the tool can start outside the stock), else to Inside. The
+/// stage never selects another guide.
+pub(super) fn resolve(p: &PlanarRegion, side: StartSide) -> StartSide {
+    match side {
+        StartSide::Auto if !p.stock_edge().is_empty() && !p.air().is_empty() => StartSide::Outside,
+        StartSide::Auto => StartSide::Inside,
+        s => s,
+    }
+}
+
+/// The mean distance of the points of `curves` to `loops`.
+fn mean_to(curves: &[&Curve], loops: &[Loop]) -> f64 {
+    let (mut sum, mut n) = (0.0, 0.0);
+    for c in curves {
+        for q in c.pts() {
+            sum += to_loops(q.at(), loops);
+            n += 1.0;
+        }
+    }
+    if n > 0.0 { sum / n } else { f64::INFINITY }
+}
+
+/// True when the order cuts the deeper curves (higher index) first. A
+/// single index has no deeper curve: its material is on the wall side, as
+/// for a deeper-first walk. Else the index grows outward when the region
+/// has a stock edge and the deepest curves lie nearer to it than the first
+/// ones (rings round a part); it grows inward otherwise (a pocket). Inside
+/// starts at the part wall or in the middle of a pocket; Outside starts at
+/// the stock edge or at the pocket wall.
+pub(super) fn deeper_first(p: &PlanarRegion, curves: &[Curve], side: StartSide) -> bool {
+    let (Some(lo), Some(hi)) = (curves.iter().map(Curve::k).min(), curves.iter().map(Curve::k).max()) else {
+        return true;
+    };
+    if lo == hi {
+        return true;
+    }
+    let at = |k: u32| curves.iter().filter(|c| c.k() == k).collect::<Vec<_>>();
+    let outward = !p.stock_edge().is_empty() && mean_to(&at(hi), p.stock_edge()) < mean_to(&at(lo), p.stock_edge());
+    (side == StartSide::Outside) == outward
+}
+
+/// True when the deeper curves lie on the left of `c` as it runs, `None`
+/// when the curve has no such side (a row: its direction is free). A
+/// closed ring is a loop of a level area whose inside is deeper: the area
+/// is on the left of its loops. An open piece of a ring round a part has
+/// the deeper side away from the part walls.
+pub(super) fn deeper_left(p: &PlanarRegion, c: &Curve) -> Option<bool> {
+    if c.family() == Family::Row {
+        return None;
+    }
+    if c.closed() {
+        return Some(true);
+    }
+    if p.part_walls().is_empty() {
+        return None;
+    }
+    let pts = c.pts();
+    let (mut best, mut at) = (0.0, None);
+    for w in pts.windows(2) {
+        let (a, b) = (w[0].at(), w[1].at());
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        if len > best {
+            best = len;
+            at = Some((a, b, len));
+        }
+    }
+    let (a, b, len) = at?;
+    let m = Point2::new(0.5 * (a.x + b.x), 0.5 * (a.y + b.y));
+    let (nx, ny) = (-(b.y - a.y) / len * SIDE_STEP, (b.x - a.x) / len * SIDE_STEP);
+    let left = to_loops(Point2::new(m.x + nx, m.y + ny), p.part_walls());
+    let right = to_loops(Point2::new(m.x - nx, m.y - ny), p.part_walls());
+    (left.is_finite() && right.is_finite() && left != right).then_some(left > right)
+}
diff --git a/crates/pathkernel/src/order/stage.rs b/crates/pathkernel/src/order/stage.rs
new file mode 100644
index 000000000..7c02f9920
--- /dev/null
+++ b/crates/pathkernel/src/order/stage.rs
@@ -0,0 +1,271 @@
+//! The order planner (#4177, K4): it resolves the start side, sets the
+//! direction of each curve, puts the curves in the walk's order and picks
+//! the start point of each closed curve. It changes nothing else (law 3):
+//! the ordered set refuses any other change, and the marks go with their
+//! curves.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 4: Order" and `docs/decisions/4177-kernel-order-link.md`; the
+//! nearest-start sequence of contour-parallel pocketing (Held 1991); the
+//! chain order of split pieces as ported in `chain.rs`.
+
+use super::{Direction, OrderChoice, OrderPlanner, OrderedSet, chain, side};
+use crate::link::{self, Level};
+use crate::plan::Cut;
+use crate::guide::{Curve, Family, GuideSet, MarkKind, Span};
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::frame::PlanePoint;
+use crate::verdict::{Note, Refusal, Stage, Verdict};
+use crate::{Point2, Region};
+
+/// Refusal reason: the order stage was given a region that is not planar.
+pub const ORDER_NOT_PLANAR: &str = "the order stage plans planar regions only";
+/// Refusal reason: a curve that the order stage cannot restart or reverse
+/// through the constructor of its family (its circle, its lead and its
+/// points kept).
+pub const NOT_REVERSIBLE: &str = "the order stage cannot restart or reverse this curve and keep its circle, its lead and its points";
+/// Note: a helix runs down its lead, so its hand sets its direction.
+pub const HELIX_HAND_SETS_DIRECTION: &str = "a helix cuts down along its lead, so its hand sets its direction: this helix cuts against the asked direction (climb or conventional); choose the other hand for the other direction";
+
+/// The reach of the chain order, in tool radii (as the air plan's chains).
+const CHAIN_REACH: f64 = 3.0;
+/// The vertices of a closed curve that the walk tries as its start.
+const START_TRIES: usize = 8;
+/// The starts that the walk asks the link stage to prove at each step.
+const PICK_TRIES: usize = 16;
+
+/// The order planner of the kernel. It reads the region, never a material
+/// side (law 2), and changes only the order, the start points and the
+/// directions (law 3).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct OrderStage;
+
+/// Where a full-width stretch of a curve ends, as the curve is cut.
+#[derive(Clone, Copy)]
+enum Heavy {
+    /// No full-width mark.
+    None,
+    /// The whole curve is full-width (a `Span::Whole` mark). The curve is
+    /// taken after the other ready curves, as a curve with a stretch. It
+    /// has no stretch end to start at, so it starts as a plain curve does
+    /// (`starts`): no point of it is less heavy than another.
+    Whole,
+    /// The end of the longest full-width stretch: a closed curve starts
+    /// there, so that the stretch is cut last on the curve.
+    EndsAt(Point2),
+}
+
+fn dist(a: Point2, b: Point2) -> f64 {
+    (a.x - b.x).hypot(a.y - b.y)
+}
+
+/// `c` with the points `pts`, through the constructor of its family
+/// (`Curve::with_points`: a helix keeps its circle and its lead). A curve
+/// that the constructor refuses is refused by the order stage's own reason.
+fn rebuilt(c: &Curve, pts: Vec<PlanePoint>) -> Result<Curve, Refusal> {
+    c.with_points(pts).map_err(|_| Refusal::new(Stage::Order, NOT_REVERSIBLE))
+}
+
+/// `c` in the other direction (a closed curve keeps its start).
+fn reversed(c: &Curve) -> Result<Curve, Refusal> {
+    let mut pts = c.pts().to_vec();
+    match (c.closed(), pts.get_mut(1..)) {
+        (true, Some(rest)) => rest.reverse(),
+        _ => pts.reverse(),
+    }
+    rebuilt(c, pts)
+}
+
+/// One curve as the order stage runs it: the curve, whether it was
+/// reversed, and whether the asked direction could not be met.
+type Oriented = (Curve, bool, bool);
+
+/// `c` in the direction that puts the deeper curves on the left when
+/// `want_left` (on the right else); whether it was reversed; and whether
+/// that direction could not be met. A helix always runs down its lead
+/// (reversed when the guide set holds it upward): a reversal in the plane
+/// would also turn it up its lead, so its hand sets its side, and a side
+/// against `want_left` is named, not met (#4176).
+fn orient(p: &PlanarRegion, c: &Curve, want_left: bool) -> Result<Oriented, Refusal> {
+    if c.family() == Family::Helix {
+        let (down, turned) = if c.descends() {
+            (c.clone(), false)
+        } else {
+            let r = reversed(c)?;
+            if r.descends() { (r, true) } else { (c.clone(), false) }
+        };
+        let unmet = side::deeper_left(p, &down).is_some_and(|left| left != want_left);
+        return Ok((down, turned, unmet));
+    }
+    match side::deeper_left(p, c) {
+        Some(left) if left != want_left => Ok((reversed(c)?, true, false)),
+        _ => Ok((c.clone(), false, false)),
+    }
+}
+
+/// The full-width stretch of each run: the end of its longest stretch in
+/// the run's direction, or `Heavy::Whole` when a mark names the whole
+/// curve (a whole mark wins over the stretches of the same curve).
+fn heavy(g: &GuideSet, turned: &[bool]) -> Vec<Heavy> {
+    let mut out = vec![Heavy::None; g.curves().len()];
+    let mut longest = vec![0.0f64; g.curves().len()];
+    for m in g.marks().iter().filter(|m| m.kind() == MarkKind::FullWidth) {
+        let i = m.curve();
+        let (Some(slot), Some(len)) = (out.get_mut(i), longest.get_mut(i)) else {
+            continue;
+        };
+        match m.span() {
+            Span::Whole => *slot = Heavy::Whole,
+            Span::Part(pts) => {
+                let l: f64 = pts.windows(2).map(|w| dist(w[0].at(), w[1].at())).sum();
+                let end = if turned.get(i).copied().unwrap_or(false) { pts.first() } else { pts.last() };
+                if let (Some(e), false) = (end, matches!(slot, Heavy::Whole))
+                    && l > *len
+                {
+                    *len = l;
+                    *slot = Heavy::EndsAt(e.at());
+                }
+            }
+        }
+    }
+    out
+}
+
+/// The vertices of `c` by their distance to `q`, the nearest first.
+fn by_distance(c: &Curve, q: Point2) -> Vec<usize> {
+    let mut v: Vec<(f64, usize)> = c.pts().iter().enumerate().map(|(i, p)| (dist(p.at(), q), i)).collect();
+    v.sort_by(|a, b| a.0.total_cmp(&b.0));
+    v.into_iter().map(|(_, i)| i).collect()
+}
+
+/// `c` restarted at its vertex `j` (a closed curve).
+fn restarted(c: &Curve, j: usize) -> Result<Curve, Refusal> {
+    let mut pts = c.pts().to_vec();
+    let n = pts.len();
+    pts.rotate_left(j.min(n));
+    rebuilt(c, pts)
+}
+
+/// The ways to start `c` from `at`: a closed curve at the end of its
+/// full-width stretch (cut last on the curve) or at one of its vertices
+/// nearest to `at`; a row from its end nearer to `at`; another open
+/// curve as it is.
+///
+/// On the first step there is no tool position (`at` is `None`): a closed
+/// curve without a stretch starts at its first vertex, and a row is never
+/// reversed. The row then keeps the direction that the guide planner gave
+/// it, so the first cut of a level is the guide's own (deterministic, and
+/// the order invents no direction that no tool position asks for). Each
+/// later row starts at its end nearer to the tool (a zigzag).
+fn starts(c: &Curve, at: Option<Point2>, h: Heavy) -> Result<Vec<Curve>, Refusal> {
+    if c.closed() {
+        let js = match (h, at) {
+            (Heavy::EndsAt(e), _) => by_distance(c, e).into_iter().take(1).collect(),
+            (Heavy::None | Heavy::Whole, Some(q)) => by_distance(c, q).into_iter().take(START_TRIES).collect(),
+            (Heavy::None | Heavy::Whole, None) => vec![0],
+        };
+        return js.into_iter().map(|j| restarted(c, j)).collect();
+    }
+    let ends = (c.pts().first().map(|p| p.at()), c.pts().last().map(|p| p.at()));
+    match (c.family(), at, ends) {
+        (Family::Row, Some(q), (Some(a), Some(b))) if dist(b, q) < dist(a, q) => Ok(vec![reversed(c)?]),
+        // A row on the first step (no `at`), a row already from its nearer
+        // end, and any other open curve: as it is.
+        _ => Ok(vec![c.clone()]),
+    }
+}
+
+/// Where the tool stands after `c`.
+fn end_of(c: &Curve) -> Option<Point2> {
+    if c.closed() { c.pts().first() } else { c.pts().last() }.map(|p| p.at())
+}
+
+fn first_of(c: &Curve) -> Point2 {
+    c.pts().first().map_or(Point2::new(0.0, 0.0), |q| q.at())
+}
+
+/// The walk: each step takes a run whose neighbours on the side the walk
+/// comes from are cut. Of those, it takes the first start (a curve with a
+/// full-width stretch or a whole full-width mark last; then the run that
+/// goes on the chain of the last run; then the nearest) to which the link
+/// stage proves an in-plane link; if none is proved, the first start (the
+/// link will lift, named).
+fn walk(p: &PlanarRegion, runs: &[Curve], heavy: &[Heavy], deep: bool) -> Result<Vec<Curve>, Refusal> {
+    let reach = 2.0 * p.tool().radius() + crate::KERNEL_TOL;
+    let needs = chain::needs(runs, deep, reach);
+    let levels = chain::levels(runs, deep);
+    let ends: Vec<(Point2, Point2)> = runs.iter().map(|c| (first_of(c), end_of(c).unwrap_or_else(|| first_of(c)))).collect();
+    let chain_of = chain::chains(&levels, &ends, CHAIN_REACH * p.tool().radius());
+    let mut done = vec![false; runs.len()];
+    let mut made: Vec<Cut> = Vec::with_capacity(runs.len());
+    let mut out: Vec<Curve> = Vec::with_capacity(runs.len());
+    let mut last: Option<usize> = None;
+    let mut paths: Vec<Vec<Point2>> = Vec::new();
+    // The cuts still planned (their run indices beside them): built once,
+    // and a run leaves the list when the walk takes it.
+    let mut planned: Vec<Cut> = runs.iter().map(|c| Cut::new(c.clone(), None)).collect::<Result<_, _>>()?;
+    let mut planned_of: Vec<usize> = (0..runs.len()).collect();
+    while out.len() < runs.len() {
+        let at = out.last().and_then(end_of);
+        let mut options: Vec<((bool, bool, f64), usize, Curve)> = Vec::new();
+        for (i, c) in runs.iter().enumerate() {
+            let ready = needs.get(i).is_some_and(|n| n.iter().all(|&j| done.get(j).copied().unwrap_or(true)));
+            if done.get(i).copied().unwrap_or(true) || !ready {
+                continue;
+            }
+            let h = heavy.get(i).copied().unwrap_or(Heavy::None);
+            let late = !matches!(h, Heavy::None);
+            let other = last.is_some_and(|l| chain_of.get(l) != chain_of.get(i));
+            for s in starts(c, at, h)? {
+                let far = at.map_or(0.0, |q| dist(q, first_of(&s)));
+                options.push(((late, other, far), i, s));
+            }
+        }
+        options.sort_by(|a, b| a.0.0.cmp(&b.0.0).then(a.0.1.cmp(&b.0.1)).then(a.0.2.total_cmp(&b.0.2)));
+        let proved = |s: &Curve| -> Result<Option<Vec<Point2>>, Refusal> {
+            let Some(from) = made.last() else { return Ok(Some(Vec::new())) };
+            let to = Cut::new(s.clone(), None)?;
+            Ok(link::proved_path(from, &to, p, Level::new(&made, &planned).with_links(&paths)))
+        };
+        let mut pick = None;
+        for (n, o) in options.iter().enumerate().take(PICK_TRIES) {
+            if let Some(path) = proved(&o.2)? {
+                pick = Some((n, path));
+                break;
+            }
+        }
+        let (n, path) = pick.map_or((0, None), |(n, path)| (n, Some(path)));
+        let Some((_, i, s)) = options.into_iter().nth(n) else {
+            return Err(Refusal::new(Stage::Order, super::NOT_A_PERMUTATION));
+        };
+        paths.extend(path.filter(|p| !p.is_empty()));
+        if let Some(d) = done.get_mut(i) {
+            *d = true;
+        }
+        if let Some(k) = planned_of.iter().position(|&j| j == i) {
+            planned.remove(k);
+            planned_of.remove(k);
+        }
+        last = Some(i);
+        made.push(Cut::new(s.clone(), None)?);
+        out.push(s);
+    }
+    Ok(out)
+}
+
+impl OrderPlanner for OrderStage {
+    fn order(&self, g: GuideSet, r: &KernelRegion, o: &OrderChoice, _stock: Option<&Region>) -> Result<Verdict<OrderedSet>, Refusal> {
+        let p = r.planar().ok_or(Refusal::new(Stage::Order, ORDER_NOT_PLANAR))?;
+        let resolved = side::resolve(p, o.start);
+        let deep = side::deeper_first(p, g.curves(), resolved);
+        // Climb puts the uncut material on the right of the travel: the
+        // deeper side when the deeper curves come later, else the other.
+        let want_left = deep == (o.direction == Direction::Climb);
+        let oriented = g.curves().iter().map(|c| orient(p, c, want_left)).collect::<Result<Vec<_>, _>>()?;
+        let notes = if oriented.iter().any(|o| o.2) { vec![Note::new(Stage::Order, HELIX_HAND_SETS_DIRECTION)?] } else { Vec::new() };
+        let (runs, turned): (Vec<Curve>, Vec<bool>) = oriented.into_iter().map(|(c, t, _)| (c, t)).unzip();
+        let heavy = heavy(&g, &turned);
+        let seq = walk(p, &runs, &heavy, deep)?;
+        let start = seq.first().map_or(Point2::new(0.0, 0.0), first_of);
+        Ok(Verdict::Done { out: OrderedSet::new(&g, seq, start, resolved)?, fallbacks: Vec::new(), notes })
+    }
+}
diff --git a/crates/pathkernel/src/plan.rs b/crates/pathkernel/src/plan.rs
new file mode 100644
index 000000000..56e9babdf
--- /dev/null
+++ b/crates/pathkernel/src/plan.rs
@@ -0,0 +1,120 @@
+//! The plan output of one level: a list of steps - cut, link, entry, exit
+//! (record "What phase 1 keeps open", point 5). The constructor checks the
+//! step law as a transition table (see [`Plan::new`]).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`.
+
+use crate::entry::{Entry, Exit};
+use crate::frame::unit;
+use crate::guide::Curve;
+use crate::link::Hop;
+use crate::verdict::{Refusal, Stage};
+
+/// One cut along a curve, with an optional tool axis (none = the plane
+/// normal of the recipe).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Cut {
+    curve: Curve,
+    axis: Option<[f64; 3]>,
+}
+
+/// Refusal reason: a tool axis that is not a finite unit vector.
+pub const BAD_AXIS: &str = "the tool axis of a cut must be a finite unit vector";
+
+impl Cut {
+    pub fn new(curve: Curve, axis: Option<[f64; 3]>) -> Result<Self, Refusal> {
+        if axis.is_some_and(|a| !unit(a)) {
+            return Err(Refusal::new(Stage::Recipe, BAD_AXIS));
+        }
+        Ok(Self { curve, axis })
+    }
+    #[must_use]
+    pub fn curve(&self) -> &Curve {
+        &self.curve
+    }
+    #[must_use]
+    pub fn axis(&self) -> Option<[f64; 3]> {
+        self.axis
+    }
+}
+
+/// One step of a plan. A later phase adds a canned cycle with no path.
+#[derive(Clone, Debug, PartialEq)]
+#[non_exhaustive]
+pub enum Step {
+    Entry(Entry),
+    Cut(Cut),
+    Link(Hop),
+    Exit(Exit),
+}
+
+/// The checked steps of one level.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Plan {
+    steps: Vec<Step>,
+}
+
+/// Refusal reason: a cut with no entry or stay-down link just before it.
+pub const CUT_WITHOUT_ENTRY: &str = "each cut must follow an entry or a stay-down link";
+/// Refusal reason: a plan that does not end with an exit after its last cut.
+pub const NO_EXIT: &str = "the last cut of a plan must be followed by an exit";
+/// Refusal reason: a link that does not follow a cut.
+pub const STRAY_LINK: &str = "a link must follow a cut";
+/// Refusal reason: an entry while the tool is at depth after a cut, or two entries in a row.
+pub const STRAY_ENTRY: &str = "an entry must start the plan, or follow an exit or a lift";
+/// Refusal reason: an exit that does not follow a cut.
+pub const STRAY_EXIT: &str = "an exit must follow a cut";
+/// Refusal reason: a plan that ends after an entry, a stay-down link or a lift.
+pub const DANGLING: &str = "a plan must not end after an entry or a link: a cut and an exit must follow";
+
+/// Where the tool is between two steps.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum At {
+    /// Above the material: the start, or after an exit.
+    Clear,
+    /// Above the material after a lift: an entry must follow.
+    Lifted,
+    /// At depth with a proof (after an entry or a stay-down link): one cut may follow.
+    Ready,
+    /// At depth at the end of a cut: a link or an exit must follow.
+    CutEnd,
+}
+
+impl Plan {
+    /// The checked steps. The transition table (any other step is refused):
+    ///
+    /// | at       | entry  | cut     | stay link | lift   | exit  |
+    /// |----------|--------|---------|-----------|--------|-------|
+    /// | clear    | ready  | -       | -         | -      | -     |
+    /// | lifted   | ready  | -       | -         | -      | -     |
+    /// | ready    | -      | cut end | -         | -      | -     |
+    /// | cut end  | -      | -       | ready     | lifted | clear |
+    ///
+    /// A cut consumes the readiness: each next cut needs its own entry or
+    /// stay-down link. The plan ends clear. An empty plan is legal (nothing
+    /// to cut at this level).
+    pub fn new(steps: Vec<Step>) -> Result<Self, Refusal> {
+        let mut at = At::Clear;
+        for s in &steps {
+            at = match (at, s) {
+                (At::Clear | At::Lifted, Step::Entry(_)) => At::Ready,
+                (_, Step::Entry(_)) => return Err(Refusal::new(Stage::Entry, STRAY_ENTRY)),
+                (At::Ready, Step::Cut(_)) => At::CutEnd,
+                (_, Step::Cut(_)) => return Err(Refusal::new(Stage::Entry, CUT_WITHOUT_ENTRY)),
+                (At::CutEnd, Step::Link(Hop::Stay(_))) => At::Ready,
+                (At::CutEnd, Step::Link(Hop::Lift(_))) => At::Lifted,
+                (_, Step::Link(_)) => return Err(Refusal::new(Stage::Link, STRAY_LINK)),
+                (At::CutEnd, Step::Exit(_)) => At::Clear,
+                (_, Step::Exit(_)) => return Err(Refusal::new(Stage::Exit, STRAY_EXIT)),
+            };
+        }
+        match at {
+            At::Clear => Ok(Self { steps }),
+            At::CutEnd => Err(Refusal::new(Stage::Exit, NO_EXIT)),
+            At::Ready | At::Lifted => Err(Refusal::new(Stage::Exit, DANGLING)),
+        }
+    }
+    #[must_use]
+    pub fn steps(&self) -> &[Step] {
+        &self.steps
+    }
+}
diff --git a/crates/pathkernel/src/recipe.rs b/crates/pathkernel/src/recipe.rs
new file mode 100644
index 000000000..8d1622087
--- /dev/null
+++ b/crates/pathkernel/src/recipe.rs
@@ -0,0 +1,77 @@
+//! The recipe of a strategy: one choice for each stage, checked when it is
+//! made (record "The strategy is a recipe"; the Prime Directive's
+//! "validate early"). A malformed choice is refused here, never inside a
+//! stage.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`.
+
+use crate::entry::EntryChoice;
+use crate::frame::{AxisControl, WorkPlane};
+use crate::guide::GuideChoice;
+use crate::link::LinkPolicy;
+use crate::load::{LoadControl, Reach};
+use crate::order::OrderChoice;
+use crate::verdict::{Refusal, Stage};
+
+/// One choice for each stage.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Recipe {
+    plane: WorkPlane,
+    axis: AxisControl,
+    guide: GuideChoice,
+    load: LoadControl,
+    order: OrderChoice,
+    link: LinkPolicy,
+    entry: EntryChoice,
+}
+
+/// Refusal reason: ring-reach engagement control on a guide that has no rings.
+pub const RINGS_REACH_NEEDS_RINGS: &str = "engagement control that reads the rings before needs a ring guide";
+
+impl Recipe {
+    /// The checked recipe. Each choice is valid by its own type (the crate
+    /// rule "valid by construction"); this checks the pairs of choices that
+    /// cannot go together.
+    pub fn new(
+        plane: WorkPlane,
+        axis: AxisControl,
+        guide: GuideChoice,
+        load: LoadControl,
+        order: OrderChoice,
+        link: LinkPolicy,
+        entry: EntryChoice,
+    ) -> Result<Self, Refusal> {
+        let rings = matches!(guide, GuideChoice::Rings(_));
+        if matches!(load, LoadControl::ConstantEngagement(c) if c.reach() == Reach::Rings) && !rings {
+            return Err(Refusal::new(Stage::Recipe, RINGS_REACH_NEEDS_RINGS));
+        }
+        Ok(Self { plane, axis, guide, load, order, link, entry })
+    }
+    #[must_use]
+    pub fn plane(&self) -> &WorkPlane {
+        &self.plane
+    }
+    #[must_use]
+    pub fn axis(&self) -> AxisControl {
+        self.axis
+    }
+    #[must_use]
+    pub fn guide(&self) -> GuideChoice {
+        self.guide
+    }
+    #[must_use]
+    pub fn load(&self) -> LoadControl {
+        self.load
+    }
+    #[must_use]
+    pub fn order(&self) -> OrderChoice {
+        self.order
+    }
+    #[must_use]
+    pub fn link(&self) -> LinkPolicy {
+        self.link
+    }
+    #[must_use]
+    pub fn entry(&self) -> &EntryChoice {
+        &self.entry
+    }
+}
diff --git a/crates/pathkernel/src/region.rs b/crates/pathkernel/src/region.rs
new file mode 100644
index 000000000..ce03262e9
--- /dev/null
+++ b/crates/pathkernel/src/region.rs
@@ -0,0 +1,226 @@
+//! Stage 1, Region (K1, #4025): the cutter-centre area and its edges, the
+//! types and their checked constructors. [`region`] builds the value from a
+//! selection (`region_build.rs`); the checks between the parts of a value
+//! are in `region_check.rs`. The stage takes no start side: that is law 2
+//! in the type system.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region"; the cutter-centre offset of a pocket boundary as in
+//! Held, "On the Computational Geometry of Pocket Machining" (1991).
+
+use crate::frame::{ToolShape, WorkPlane};
+pub use crate::region_chain::{ChainRegion, KEEP_OUT_NOT_FINITE, chain_region};
+use crate::region_check::{oriented, partition};
+use crate::verdict::{Refusal, Stage};
+use crate::{Loop, Region, finite, region_finite};
+
+pub use crate::region_build::{
+    BAD_LEAVE, EMPTY_MATERIAL, NEEDS_STOCK, OFF_STOCK, OPEN_NEEDS_SIDE, REGION_GEOMETRY, region,
+};
+pub use crate::region_check::{NOT_ORIENTED, NOT_A_PARTITION};
+
+/// The side of the selection's closed chains where the material to cut
+/// is: `Inside` cuts the area that the chains enclose (a pocket, a bore,
+/// Contour "Inside"); `Outside` cuts the stock round the area that they
+/// enclose (Contour "Outside", the band round a part). It is a parameter
+/// of its own and never depends on the start side.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum MaterialSide {
+    Inside,
+    Outside,
+}
+
+/// The bounds of one plan: the stock footprint (if known), the keep-out
+/// area (fixtures, Do not touch) and the top and bottom along the normal.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Bounds {
+    stock: Option<Region>,
+    keep_out: Region,
+    top: f64,
+    bottom: f64,
+}
+
+/// Refusal reason: bounds whose top is below the bottom, or a value that is
+/// not finite.
+pub const BAD_BOUNDS: &str = "the bounds need a finite top at or above a finite bottom, and finite areas";
+
+impl Bounds {
+    pub fn new(stock: Option<Region>, keep_out: Region, top: f64, bottom: f64) -> Result<Self, Refusal> {
+        let areas_ok = stock.as_ref().is_none_or(region_finite) && region_finite(&keep_out);
+        if !finite(&[top, bottom]) || top < bottom || !areas_ok {
+            return Err(Refusal::new(Stage::Region, BAD_BOUNDS));
+        }
+        Ok(Self { stock, keep_out, top, bottom })
+    }
+    #[must_use]
+    pub fn stock(&self) -> Option<&Region> {
+        self.stock.as_ref()
+    }
+    #[must_use]
+    pub fn keep_out(&self) -> &Region {
+        &self.keep_out
+    }
+    #[must_use]
+    pub fn top(&self) -> f64 {
+        self.top
+    }
+    #[must_use]
+    pub fn bottom(&self) -> f64 {
+        self.bottom
+    }
+}
+
+/// The output of stage 1: a planar area, or the picked chains of a trace
+/// (#4176). A later phase adds a region that is not planar as a new variant.
+#[derive(Clone, Debug, PartialEq)]
+#[non_exhaustive]
+pub enum KernelRegion {
+    Planar(PlanarRegion),
+    /// The chains of a trace (`region_chain.rs`): no area, no material side.
+    Chains(ChainRegion),
+}
+
+impl KernelRegion {
+    /// The planar area, if this is one.
+    #[must_use]
+    pub fn planar(&self) -> Option<&PlanarRegion> {
+        match self {
+            Self::Planar(p) => Some(p),
+            Self::Chains(_) => None,
+        }
+    }
+    /// The chains of a trace, if this is one.
+    #[must_use]
+    pub fn chains(&self) -> Option<&ChainRegion> {
+        match self {
+            Self::Chains(c) => Some(c),
+            Self::Planar(_) => None,
+        }
+    }
+    /// The tool of the region.
+    #[must_use]
+    pub fn tool(&self) -> ToolShape {
+        match self {
+            Self::Planar(p) => p.tool(),
+            Self::Chains(c) => c.tool(),
+        }
+    }
+}
+
+/// A planar cutter-centre area with its edges, in the frame of its work
+/// plane (any plane: the 2D coordinates are along the plane's own axes).
+#[derive(Clone, Debug, PartialEq)]
+pub struct PlanarRegion {
+    plane: WorkPlane,
+    center: Region,
+    material: MaterialSide,
+    part_walls: Vec<Loop>,
+    stock_edge: Vec<Loop>,
+    air: Region,
+    keep_out: Region,
+    tool: ToolShape,
+    /// The part grown by the tool radius plus the stock to leave (an
+    /// `Outside` region of [`region`](crate::region()) only; empty else).
+    part_zone: Region,
+}
+
+/// Refusal reason: an empty cutter-centre area (the tool does not fit).
+pub const EMPTY_CENTER: &str = "the tool does not fit: the cutter-centre area is empty";
+/// Refusal reason: a loop with a point that is not finite.
+pub const NOT_FINITE: &str = "a loop of the region has a point that is not a finite number";
+/// Refusal reason: a region with no wall and no stock edge.
+pub const NO_EDGE: &str = "the region needs at least one part wall or stock edge";
+/// Refusal reason: an edge loop with no area (all its points on one line).
+pub const FLAT_EDGE: &str = "an edge loop of the region has no area";
+
+impl PlanarRegion {
+    /// The checked region. Refused for an empty or degenerate `center`, a
+    /// point that is not finite, an edge loop with no area, no edge at all,
+    /// loops of `center` that are not oriented by their nesting (outer
+    /// counter-clockwise, hole clockwise), or edges that do not partition
+    /// the boundary of `center` (each loop of `center` is exactly one part
+    /// wall or one stock edge). The tool and the plane are valid by their
+    /// own types.
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        plane: WorkPlane,
+        center: Region,
+        material: MaterialSide,
+        part_walls: Vec<Loop>,
+        stock_edge: Vec<Loop>,
+        air: Region,
+        keep_out: Region,
+        tool: ToolShape,
+    ) -> Result<Self, Refusal> {
+        let edges_finite = part_walls.iter().chain(&stock_edge).all(|l| l.points().iter().all(|p| finite(&[p.x, p.y])));
+        if !edges_finite || ![&center, &air, &keep_out].iter().all(|r| region_finite(r)) {
+            return Err(Refusal::new(Stage::Region, NOT_FINITE));
+        }
+        let area = center.area();
+        if center.is_empty() || !area.is_finite() || area <= 0.0 {
+            return Err(Refusal::new(Stage::Region, EMPTY_CENTER).fix("use a smaller tool or a larger selection"));
+        }
+        if part_walls.is_empty() && stock_edge.is_empty() {
+            return Err(Refusal::new(Stage::Region, NO_EDGE));
+        }
+        if part_walls.iter().chain(&stock_edge).any(|l| !l.area().is_finite() || l.area().abs() <= 0.0) {
+            return Err(Refusal::new(Stage::Region, FLAT_EDGE));
+        }
+        if let Some(p) = oriented(&center) {
+            return Err(Refusal::new(Stage::Region, NOT_ORIENTED).at(p));
+        }
+        if let Some(p) = partition(&center, &part_walls, &stock_edge) {
+            return Err(Refusal::new(Stage::Region, NOT_A_PARTITION).at(p));
+        }
+        Ok(Self { plane, center, material, part_walls, stock_edge, air, keep_out, tool, part_zone: Region::empty() })
+    }
+    /// This region with its part zone: the part grown by the tool radius
+    /// plus the stock to leave, where no tool centre may stand. The region
+    /// builder sets it for an `Outside` region; the link stage reads it for
+    /// a link outside the stock (#4241). Refused for a point that is not
+    /// finite.
+    pub(crate) fn with_part_zone(self, part_zone: Region) -> Result<Self, Refusal> {
+        if !region_finite(&part_zone) {
+            return Err(Refusal::new(Stage::Region, NOT_FINITE));
+        }
+        Ok(Self { part_zone, ..self })
+    }
+    /// The work plane whose axes the 2D coordinates of the region use.
+    #[must_use]
+    pub fn plane(&self) -> WorkPlane {
+        self.plane
+    }
+    #[must_use]
+    pub fn center(&self) -> &Region {
+        &self.center
+    }
+    #[must_use]
+    pub fn material(&self) -> MaterialSide {
+        self.material
+    }
+    #[must_use]
+    pub fn part_walls(&self) -> &[Loop] {
+        &self.part_walls
+    }
+    #[must_use]
+    pub fn stock_edge(&self) -> &[Loop] {
+        &self.stock_edge
+    }
+    #[must_use]
+    pub fn air(&self) -> &Region {
+        &self.air
+    }
+    #[must_use]
+    pub fn keep_out(&self) -> &Region {
+        &self.keep_out
+    }
+    #[must_use]
+    pub fn tool(&self) -> ToolShape {
+        self.tool
+    }
+    /// The part zone: empty unless the region builder made an `Outside`
+    /// region.
+    #[must_use]
+    pub fn part_zone(&self) -> &Region {
+        &self.part_zone
+    }
+}
diff --git a/crates/pathkernel/src/region_build.rs b/crates/pathkernel/src/region_build.rs
new file mode 100644
index 000000000..0cd2d5bfe
--- /dev/null
+++ b/crates/pathkernel/src/region_build.rs
@@ -0,0 +1,145 @@
+//! Stage 1 builder (K1, #4025): one region value from a selection, the
+//! material side and the bounds. Each planner reads this value; the
+//! material side is an input of its own, and no start side reaches it.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region"; the cutter-centre area as the Minkowski erosion of the
+//! machinable area by the tool disc (Held, "On the Computational Geometry of
+//! Pocket Machining", 1991, ch. 2), computed with the polygon offset and the
+//! booleans of `camcraft-geometry`.
+
+use crate::frame::{ToolShape, WorkPlane};
+use crate::region::{Bounds, KernelRegion, MaterialSide, PlanarRegion};
+use crate::region_check::oriented;
+use crate::selection::Selection;
+use crate::verdict::{Refusal, Stage};
+use crate::{KERNEL_TOL, Loop, Point2, Region, seg_dist};
+
+/// Refusal reason: an open chain, which encloses no area and so has no
+/// inside or outside.
+pub const OPEN_NEEDS_SIDE: &str = "an open chain encloses no area, so it has no inside or outside material side";
+/// Refusal reason: a stock to leave that is not finite, or that cancels
+/// the tool radius.
+pub const BAD_LEAVE: &str = "the stock to leave must be a finite number greater than minus the tool radius";
+/// Refusal reason: an Outside material side with no stock to bound it.
+pub const NEEDS_STOCK: &str = "an Outside material side needs the stock: the area outside the selection has no limit";
+/// Refusal reason: a selection that does not meet the stock.
+pub const OFF_STOCK: &str = "the selection is outside the stock: there is no material to cut";
+/// Refusal reason: a material side with no area (an Outside selection
+/// that covers all of the stock).
+pub const EMPTY_MATERIAL: &str = "the material side of the selection has no area";
+/// Refusal reason: the polygon offset or a boolean refused its input.
+pub const REGION_GEOMETRY: &str = "the region geometry cannot be computed: a value is out of range";
+
+/// The distance (mm) within which a boundary vertex of the cutter-centre
+/// area counts as a vertex of the stock outline: the 1 um of the K0 laws.
+const ON_STOCK_TOL: f64 = 1e-3;
+
+fn geo<T, E>(r: Result<T, E>) -> Result<T, Refusal> {
+    r.map_err(|_| Refusal::new(Stage::Region, REGION_GEOMETRY))
+}
+
+/// True when `p` is on a loop of `r` within `tol`.
+fn on_outline(r: &Region, p: Point2, tol: f64) -> bool {
+    r.loops().iter().any(|l| {
+        let pts = l.points();
+        pts.iter().zip(pts.iter().cycle().skip(1)).any(|(a, b)| seg_dist(p, *a, *b) <= tol)
+    })
+}
+
+/// True when the region has an area above the kernel tolerance.
+fn has_area(r: &Region) -> bool {
+    let a = r.area();
+    !r.is_empty() && a.is_finite() && a > KERNEL_TOL
+}
+
+/// The area that the closed chains of `sel` enclose. Nested chains are
+/// holes; chains that do not nest add up.
+fn enclosed(sel: &Selection) -> Result<Region, Refusal> {
+    let loops: Vec<Loop> = sel.chains().iter().map(|c| geo(Loop::new(c.points().to_vec()))).collect::<Result<_, _>>()?;
+    geo(Region::new(loops))
+}
+
+/// The one region of a plan.
+///
+/// - `sel`: the picked chains, in the 2D coordinates of `plane`. Each
+///   chain must be closed.
+/// - `material`: `Inside` cuts the area that the chains enclose; `Outside`
+///   cuts the stock round it.
+/// - `bounds`: the stock (needed for `Outside`; for `Inside` the selection
+///   must meet it when it is known) and the keep-out area.
+/// - `tool`, `leave`: the cutter-centre area keeps the tool radius plus
+///   `leave` from the selection, and the tool radius from the keep-out.
+///
+/// The centre of an `Outside` region reaches the stock outline: the disc
+/// then sweeps past every stock edge and corner. Its loops on the stock
+/// outline are the stock edges, each other loop is a part wall. The air is
+/// the band of one tool radius outside the stock where the disc does not
+/// touch it, less the part zone (the part grown by the tool radius plus
+/// `leave`: a part can reach out of the stock, #4241). An `Inside` region is a closed area: its loops are all part
+/// walls and it has no air. A pure function of its inputs.
+pub fn region(
+    sel: &Selection,
+    material: MaterialSide,
+    bounds: &Bounds,
+    plane: WorkPlane,
+    tool: ToolShape,
+    leave: f64,
+) -> Result<KernelRegion, Refusal> {
+    if let Some(c) = sel.first_open() {
+        let r = Refusal::new(Stage::Region, OPEN_NEEDS_SIDE).fix("pick a closed chain, or join the points back to the first one");
+        return Err(match c.points().first() {
+            Some(p) => r.at(*p),
+            None => r,
+        });
+    }
+    let r = tool.radius();
+    let d = r + leave;
+    if !leave.is_finite() || !d.is_finite() || d <= KERNEL_TOL {
+        return Err(Refusal::new(Stage::Region, BAD_LEAVE));
+    }
+    let area = enclosed(sel)?;
+    if !has_area(&area) {
+        return Err(Refusal::new(Stage::Region, EMPTY_MATERIAL));
+    }
+    let keep = if bounds.keep_out().is_empty() { Region::empty() } else { geo(bounds.keep_out().offset(r))? };
+    let stock = bounds.stock();
+    if let Some(s) = stock
+        && !has_area(&geo(area.intersect(s))?)
+    {
+        return Err(Refusal::new(Stage::Region, OFF_STOCK).fix("pick a selection that meets the stock"));
+    }
+    let mut part_zone = Region::empty();
+    let (center, air) = match material {
+        MaterialSide::Inside => (geo(area.offset(-d))?, Region::empty()),
+        MaterialSide::Outside => {
+            let Some(s) = stock.filter(|s| has_area(s)) else {
+                return Err(Refusal::new(Stage::Region, NEEDS_STOCK).fix("define the stock of the setup"));
+            };
+            if !has_area(&geo(s.difference(&area))?) {
+                return Err(Refusal::new(Stage::Region, EMPTY_MATERIAL));
+            }
+            let air = geo(geo(s.offset(2.0 * r))?.difference(&geo(s.offset(r))?))?;
+            let zone = geo(area.offset(d))?;
+            let air = geo(geo(air.difference(&keep))?.difference(&zone))?;
+            part_zone = zone;
+            (geo(s.difference(&part_zone))?, air)
+        }
+    };
+    let mut center = if keep.is_empty() { center } else { geo(center.difference(&keep))? };
+    if !has_area(&center) {
+        return Err(Refusal::new(Stage::Region, crate::region::EMPTY_CENTER).fix("use a smaller tool or a larger selection"));
+    }
+    if oriented(&center).is_some() {
+        center = geo(Region::new(center.loops().to_vec()))?;
+    }
+    let (mut walls, mut edge) = (Vec::new(), Vec::new());
+    for l in center.loops() {
+        let on_stock = match (material, stock) {
+            (MaterialSide::Outside, Some(s)) => l.points().iter().all(|p| on_outline(s, *p, ON_STOCK_TOL)),
+            _ => false,
+        };
+        if on_stock { edge.push(l.clone()) } else { walls.push(l.clone()) }
+    }
+    let keep_out = bounds.keep_out().clone();
+    PlanarRegion::new(plane, center, material, walls, edge, air, keep_out, tool)?.with_part_zone(part_zone).map(KernelRegion::Planar)
+}
diff --git a/crates/pathkernel/src/region_chain.rs b/crates/pathkernel/src/region_chain.rs
new file mode 100644
index 000000000..84df45606
--- /dev/null
+++ b/crates/pathkernel/src/region_chain.rs
@@ -0,0 +1,62 @@
+//! Stage 1 for a guide that follows the selection itself (#4176: Trace,
+//! Engrave on a line, 2D Contour on an open chain, 2D Chamfer): the picked
+//! chains, open or closed, with no material side. The region of an area
+//! (`region.rs`) refuses an open chain; this region holds it.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region" ("a later phase adds a region that is not a planar
+//! area as a new variant") and `docs/decisions/4176-kernel-guides-medial-trace-helix.md`.
+
+use crate::frame::{ToolShape, WorkPlane};
+use crate::region::KernelRegion;
+use crate::selection::{Chain, Selection};
+use crate::verdict::{Refusal, Stage};
+use crate::{Region, region_finite};
+
+/// Refusal reason: a keep-out area with a point that is not finite.
+pub const KEEP_OUT_NOT_FINITE: &str = "the keep-out area has a point that is not a finite number";
+
+/// The picked chains of a trace in the frame of their work plane, the tool
+/// and the keep-out area (fixtures, Do not touch). It has no material side
+/// and no start side: the side of a trace is its offset in the guide
+/// choice. Valid by construction: the chains are a checked [`Selection`].
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChainRegion {
+    plane: WorkPlane,
+    chains: Vec<Chain>,
+    keep_out: Region,
+    tool: ToolShape,
+}
+
+impl ChainRegion {
+    /// Refused for a keep-out area that is not finite. The selection is
+    /// already checked (no crossing, no repeated point).
+    pub fn new(plane: WorkPlane, sel: &Selection, keep_out: Region, tool: ToolShape) -> Result<Self, Refusal> {
+        if !region_finite(&keep_out) {
+            return Err(Refusal::new(Stage::Region, KEEP_OUT_NOT_FINITE));
+        }
+        Ok(Self { plane, chains: sel.chains().to_vec(), keep_out, tool })
+    }
+    #[must_use]
+    pub fn plane(&self) -> WorkPlane {
+        self.plane
+    }
+    /// The picked chains, in the order of the selection.
+    #[must_use]
+    pub fn chains(&self) -> &[Chain] {
+        &self.chains
+    }
+    #[must_use]
+    pub fn keep_out(&self) -> &Region {
+        &self.keep_out
+    }
+    #[must_use]
+    pub fn tool(&self) -> ToolShape {
+        self.tool
+    }
+}
+
+/// The region of a trace: the chains of `sel` as they are. A pure function
+/// of its inputs; it takes no material side and no start side (laws 2, 3).
+pub fn chain_region(sel: &Selection, plane: WorkPlane, tool: ToolShape, keep_out: Region) -> Result<KernelRegion, Refusal> {
+    ChainRegion::new(plane, sel, keep_out, tool).map(KernelRegion::Chains)
+}
diff --git a/crates/pathkernel/src/region_check.rs b/crates/pathkernel/src/region_check.rs
new file mode 100644
index 000000000..011ef10da
--- /dev/null
+++ b/crates/pathkernel/src/region_check.rs
@@ -0,0 +1,88 @@
+//! The checks between the parts of a planar region (K1, #4025): the loops
+//! of the cutter-centre area are oriented by their nesting, and the part
+//! walls and the stock edges partition its boundary.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region" (the invariants); the crossing-parity point-in-polygon
+//! test of Shimrat, "Algorithm 112: Position of point relative to polygon"
+//! (CACM 5(8), 1962).
+
+use crate::{Loop, Point2, Region, near};
+
+/// Refusal reason: a loop of the cutter-centre area whose direction does
+/// not agree with its nesting (an outer loop counter-clockwise, a hole
+/// clockwise, an island in a hole counter-clockwise).
+pub const NOT_ORIENTED: &str = "a loop of the cutter-centre area is not oriented by its nesting";
+/// Refusal reason: part walls and stock edges that are not the boundary
+/// loops of the cutter-centre area, each one exactly one time.
+pub const NOT_A_PARTITION: &str =
+    "the part walls and the stock edges must be the boundary loops of the cutter-centre area, each one time";
+
+/// True when `p` is inside the polygon `pts` (crossing parity; a point on
+/// the boundary can read either way, so callers count many vertices).
+pub(crate) fn inside_loop(pts: &[Point2], p: Point2) -> bool {
+    let n = pts.len();
+    let mut inside = false;
+    for i in 0..n {
+        let (Some(a), Some(b)) = (pts.get(i), pts.get((i + 1) % n)) else { continue };
+        if (a.y > p.y) != (b.y > p.y) {
+            let t = (p.y - a.y) / (b.y - a.y);
+            if p.x < a.x + t * (b.x - a.x) {
+                inside = !inside;
+            }
+        }
+    }
+    inside
+}
+
+/// True when more than half of the vertices of `inner` are inside `outer`.
+/// Loops of a normalized region do not cross, so this is their nesting;
+/// the majority keeps a vertex that touches `outer` from deciding it.
+fn nested_in(inner: &Loop, outer: &Loop) -> bool {
+    let pts = inner.points();
+    let count = pts.iter().filter(|p| inside_loop(outer.points(), **p)).count();
+    count.saturating_mul(2) > pts.len()
+}
+
+/// The first vertex of the first loop of `r` whose direction disagrees with
+/// its nesting depth, or `None` when every loop is oriented.
+pub(crate) fn oriented(r: &Region) -> Option<Point2> {
+    let loops = r.loops();
+    loops.iter().enumerate().find_map(|(i, l)| {
+        let depth = loops.iter().enumerate().filter(|(j, o)| *j != i && nested_in(l, o)).count();
+        let want_ccw = depth % 2 == 0;
+        (l.is_ccw() != want_ccw).then(|| l.points().first().copied()).flatten()
+    })
+}
+
+/// True when `a` and `b` are the same cyclic sequence of points (the same
+/// direction, any start) within the kernel tolerance.
+pub(crate) fn same_cycle(a: &Loop, b: &Loop) -> bool {
+    let (pa, pb) = (a.points(), b.points());
+    let n = pa.len();
+    if n != pb.len() || n == 0 {
+        return false;
+    }
+    let Some(first) = pa.first() else { return false };
+    pb.iter().enumerate().filter(|(_, q)| near(*first, **q)).any(|(shift, _)| {
+        (0..n).all(|i| match (pa.get(i), pb.get((i + shift) % n)) {
+            (Some(p), Some(q)) => near(*p, *q),
+            _ => false,
+        })
+    })
+}
+
+/// The first point of the first edge loop that breaks the partition, or of
+/// the first boundary loop that no edge names; `None` when each loop of
+/// `center` is named by exactly one part wall or stock edge.
+pub(crate) fn partition(center: &Region, walls: &[Loop], edge: &[Loop]) -> Option<Point2> {
+    let loops = center.loops();
+    let mut used = vec![false; loops.len()];
+    for e in walls.iter().chain(edge) {
+        let hit = loops.iter().enumerate().find(|(i, l)| !used.get(*i).copied().unwrap_or(true) && same_cycle(e, l));
+        match hit.and_then(|(i, _)| used.get_mut(i)) {
+            Some(slot) => *slot = true,
+            None => return e.points().first().copied().or(Some(Point2::new(0.0, 0.0))),
+        }
+    }
+    used.iter().position(|u| !u).and_then(|i| loops.get(i)).and_then(|l| l.points().first().copied())
+}
diff --git a/crates/pathkernel/src/selection.rs b/crates/pathkernel/src/selection.rs
new file mode 100644
index 000000000..b6f5f6163
--- /dev/null
+++ b/crates/pathkernel/src/selection.rs
@@ -0,0 +1,237 @@
+//! The selection of stage 1 (K1, #4025): the picked chains in the plane of
+//! the recipe, valid by construction. An edge, a face boundary, a chain or a
+//! list of points that straight lines join all become a [`Chain`]: a
+//! polyline that is open or closed. A [`Selection`] holds one or more chains
+//! that do not cross themselves or each other.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region"; the segment intersection test is the orientation
+//! predicate of de Berg et al., "Computational Geometry" (3rd ed., 2008),
+//! section 2.1, with a sweep over the x-sorted segment boxes.
+
+use crate::verdict::{Refusal, Stage};
+use crate::{KERNEL_TOL, Point2, finite, near};
+
+/// Refusal reason: a chain with too few points (two for an open chain,
+/// three for a closed chain).
+pub const SHORT_CHAIN: &str = "a selected chain needs two points, or three points when it is closed";
+/// Refusal reason: a selection with a point that is not a finite number.
+pub const SELECTION_NOT_FINITE: &str = "a selected point is not a finite number";
+/// Refusal reason: two neighbour points of a chain at the same place.
+pub const REPEATED_POINT: &str = "a selected chain has two neighbour points at the same place";
+/// Refusal reason: a selection with no chain.
+pub const EMPTY_SELECTION: &str = "the selection is empty: pick an edge, a face, a chain or points";
+/// Refusal reason: a chain that crosses or touches itself.
+pub const SELF_CROSSING: &str = "a selected chain crosses itself";
+/// Refusal reason: two chains that cross or touch.
+pub const CHAINS_CROSS: &str = "two selected chains cross or touch each other";
+/// Refusal reason: a closed chain with no area (all its points on one line).
+pub const ZERO_AREA: &str = "a selected closed chain has no area";
+
+/// One picked polyline in the plane of the recipe: finite points, no two
+/// neighbours at the same place, open or closed. A closed chain does not
+/// repeat its first point at its end.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Chain {
+    pts: Vec<Point2>,
+    closed: bool,
+}
+
+impl Chain {
+    /// A closed chain (a face boundary, a closed edge loop, or points that
+    /// straight lines join back to the first point). A last point equal to
+    /// the first is dropped.
+    pub fn closed(pts: Vec<Point2>) -> Result<Self, Refusal> {
+        Self::new(pts, true)
+    }
+
+    /// An open chain (an edge or a run of edges, or points that straight
+    /// lines join, first to last).
+    pub fn open(pts: Vec<Point2>) -> Result<Self, Refusal> {
+        Self::new(pts, false)
+    }
+
+    fn new(mut pts: Vec<Point2>, closed: bool) -> Result<Self, Refusal> {
+        if !pts.iter().all(|p| finite(&[p.x, p.y])) {
+            return Err(Refusal::new(Stage::Region, SELECTION_NOT_FINITE));
+        }
+        if closed && pts.len() > 1 && pts.first().zip(pts.last()).is_some_and(|(a, b)| near(*a, *b)) {
+            pts.pop();
+        }
+        if pts.len() < if closed { 3 } else { 2 } {
+            return Err(Refusal::new(Stage::Region, SHORT_CHAIN));
+        }
+        let c = Self { pts, closed };
+        if let Some(a) = c.segments().find(|(a, b)| near(*a, *b)).map(|(a, _)| a) {
+            return Err(Refusal::new(Stage::Region, REPEATED_POINT).at(a));
+        }
+        if closed && collinear(&c.pts) {
+            let r = Refusal::new(Stage::Region, ZERO_AREA);
+            return Err(match c.pts.first() {
+                Some(p) => r.at(*p),
+                None => r,
+            });
+        }
+        if let Some(p) = first_crossing(&[&c]) {
+            return Err(Refusal::new(Stage::Region, SELF_CROSSING).at(p));
+        }
+        Ok(c)
+    }
+
+    #[must_use]
+    pub fn points(&self) -> &[Point2] {
+        &self.pts
+    }
+    #[must_use]
+    pub fn is_closed(&self) -> bool {
+        self.closed
+    }
+
+    /// The segments of the chain; a closed chain includes the closing one.
+    fn segments(&self) -> impl Iterator<Item = (Point2, Point2)> + '_ {
+        let n = self.pts.len();
+        let count = if self.closed { n } else { n.saturating_sub(1) };
+        (0..count).filter_map(move |i| Some((*self.pts.get(i)?, *self.pts.get((i + 1) % n)?)))
+    }
+}
+
+/// The selection of one plan: one or more chains, none of which crosses
+/// itself or another one. Nested closed chains are holes (even-odd).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Selection {
+    chains: Vec<Chain>,
+}
+
+impl Selection {
+    /// The selection of `chains`. Refused when it is empty, or when two
+    /// chains cross or touch.
+    pub fn new(chains: Vec<Chain>) -> Result<Self, Refusal> {
+        if chains.is_empty() {
+            return Err(Refusal::new(Stage::Region, EMPTY_SELECTION));
+        }
+        let refs: Vec<&Chain> = chains.iter().collect();
+        if let Some(p) = first_crossing(&refs) {
+            return Err(Refusal::new(Stage::Region, CHAINS_CROSS).at(p));
+        }
+        Ok(Self { chains })
+    }
+
+    /// A face: its outer boundary and its holes, each a closed chain.
+    pub fn face(outer: Vec<Point2>, holes: Vec<Vec<Point2>>) -> Result<Self, Refusal> {
+        let mut chains = vec![Chain::closed(outer)?];
+        for h in holes {
+            chains.push(Chain::closed(h)?);
+        }
+        Self::new(chains)
+    }
+
+    /// Points that straight lines join, first to last, and back to the
+    /// first when `closed`.
+    pub fn points(pts: Vec<Point2>, closed: bool) -> Result<Self, Refusal> {
+        Self::new(vec![Chain::new(pts, closed)?])
+    }
+
+    #[must_use]
+    pub fn chains(&self) -> &[Chain] {
+        &self.chains
+    }
+
+    /// The first open chain, if any.
+    #[must_use]
+    pub fn first_open(&self) -> Option<&Chain> {
+        self.chains.iter().find(|c| !c.closed)
+    }
+}
+
+/// True when all the points lie on one line within the kernel tolerance.
+fn collinear(pts: &[Point2]) -> bool {
+    let Some(a) = pts.first().copied() else { return true };
+    let far = pts.iter().copied().max_by(|p, q| (p.x - a.x).hypot(p.y - a.y).total_cmp(&(q.x - a.x).hypot(q.y - a.y)));
+    let Some(b) = far else { return true };
+    let len = (b.x - a.x).hypot(b.y - a.y);
+    len <= KERNEL_TOL || pts.iter().all(|p| orient(a, b, *p).abs() / len <= KERNEL_TOL)
+}
+
+fn orient(a: Point2, b: Point2, c: Point2) -> f64 {
+    (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
+}
+
+fn on_seg(a: Point2, b: Point2, p: Point2) -> bool {
+    p.x >= a.x.min(b.x) - KERNEL_TOL
+        && p.x <= a.x.max(b.x) + KERNEL_TOL
+        && p.y >= a.y.min(b.y) - KERNEL_TOL
+        && p.y <= a.y.max(b.y) + KERNEL_TOL
+}
+
+/// True when the closed segments `a-b` and `c-d` share a point (a touch
+/// within the tolerance counts).
+fn seg_meet(a: Point2, b: Point2, c: Point2, d: Point2) -> bool {
+    let tol = |p: Point2, q: Point2| KERNEL_TOL * (q.x - p.x).hypot(q.y - p.y).max(1.0);
+    let (d1, d2) = (orient(c, d, a), orient(c, d, b));
+    let (d3, d4) = (orient(a, b, c), orient(a, b, d));
+    let (t_cd, t_ab) = (tol(c, d), tol(a, b));
+    if ((d1 > t_cd && d2 < -t_cd) || (d1 < -t_cd && d2 > t_cd)) && ((d3 > t_ab && d4 < -t_ab) || (d3 < -t_ab && d4 > t_ab)) {
+        return true;
+    }
+    (d1.abs() <= t_cd && on_seg(c, d, a))
+        || (d2.abs() <= t_cd && on_seg(c, d, b))
+        || (d3.abs() <= t_ab && on_seg(a, b, c))
+        || (d4.abs() <= t_ab && on_seg(a, b, d))
+}
+
+/// A segment with its chain and its index in the chain.
+struct Seg {
+    chain: usize,
+    idx: usize,
+    a: Point2,
+    b: Point2,
+}
+
+/// True when two segments of one chain are neighbours (they share the
+/// vertex between them, which is not a crossing).
+fn neighbours(s: &Seg, t: &Seg, chains: &[&Chain]) -> bool {
+    if s.chain != t.chain {
+        return false;
+    }
+    let Some(c) = chains.get(s.chain) else { return false };
+    t.idx == s.idx.saturating_add(1) || (c.closed && s.idx.saturating_add(1) == c.pts.len() && t.idx == 0)
+}
+
+/// The first place where a chain crosses or touches itself or another
+/// chain, other than at the shared vertex of two neighbour segments. A
+/// sweep over the segments sorted by their least x.
+fn first_crossing(chains: &[&Chain]) -> Option<Point2> {
+    let mut segs: Vec<Seg> = chains
+        .iter()
+        .enumerate()
+        .flat_map(|(ci, c)| c.segments().enumerate().map(move |(idx, (a, b))| Seg { chain: ci, idx, a, b }))
+        .collect();
+    segs.sort_by(|s, t| s.a.x.min(s.b.x).total_cmp(&t.a.x.min(t.b.x)));
+    for (i, s) in segs.iter().enumerate() {
+        let s_max = s.a.x.max(s.b.x) + KERNEL_TOL;
+        for t in segs.iter().skip(i + 1) {
+            if t.a.x.min(t.b.x) > s_max {
+                break;
+            }
+            if neighbours(s, t, chains) || neighbours(t, s, chains) {
+                if s.chain == t.chain && overlap_back(s, t) {
+                    return Some(s.b);
+                }
+                continue;
+            }
+            if seg_meet(s.a, s.b, t.a, t.b) {
+                return Some(s.a);
+            }
+        }
+    }
+    None
+}
+
+/// Two neighbour segments that fold back on each other (a spike): the
+/// angle between them is zero.
+fn overlap_back(s: &Seg, t: &Seg) -> bool {
+    let (u, v) = if near(s.b, t.a) { ((s.a, s.b), (t.a, t.b)) } else { ((t.a, t.b), (s.a, s.b)) };
+    let (ux, uy, vx, vy) = (u.1.x - u.0.x, u.1.y - u.0.y, v.1.x - v.0.x, v.1.y - v.0.y);
+    let cross = ux * vy - uy * vx;
+    let dot = ux * vx + uy * vy;
+    cross.abs() <= KERNEL_TOL * ux.hypot(uy).max(1.0) * vx.hypot(vy).max(1.0) && dot < 0.0
+}
diff --git a/crates/pathkernel/src/verdict.rs b/crates/pathkernel/src/verdict.rs
new file mode 100644
index 000000000..568162540
--- /dev/null
+++ b/crates/pathkernel/src/verdict.rs
@@ -0,0 +1,250 @@
+//! The common result types of the stages: a refusal, a fallback, a gap and
+//! the verdict that carries them (record "Common result types").
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`;
+//! the Prime Directive of AGENTS.md (a result is correct or visibly refused).
+
+use crate::{Point2, finite};
+
+/// The stage that wrote a refusal, a fallback or a note.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+#[non_exhaustive]
+pub enum Stage {
+    Recipe,
+    Region,
+    Guide,
+    Order,
+    Load,
+    Link,
+    Entry,
+    Exit,
+}
+
+/// Refusal reason: a fallback, a note, a lift or a record with no reason text.
+pub const NO_REASON: &str = "a fallback, a note, a lift or a refusal must name its reason";
+
+/// A stage that cannot meet its law refuses with a named reason. Each
+/// `reason` is a named `const` of the stage that writes it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Refusal {
+    stage: Stage,
+    reason: &'static str,
+    at: Option<Point2>,
+    fix: Option<&'static str>,
+}
+
+impl Refusal {
+    /// A refusal. A blank reason becomes [`NO_REASON`]: a refusal is never
+    /// silent about why.
+    #[must_use]
+    pub fn new(stage: Stage, reason: &'static str) -> Self {
+        let reason = if reason.trim().is_empty() { NO_REASON } else { reason };
+        Self { stage, reason, at: None, fix: None }
+    }
+
+    /// The refusal at one spot. A spot that is not finite is dropped: the
+    /// refusal still stands, without a place.
+    #[must_use]
+    pub fn at(mut self, p: Point2) -> Self {
+        self.at = finite(&[p.x, p.y]).then_some(p);
+        self
+    }
+
+    /// The fix to show. A blank fix is dropped.
+    #[must_use]
+    pub fn fix(mut self, fix: &'static str) -> Self {
+        self.fix = (!fix.trim().is_empty()).then_some(fix);
+        self
+    }
+    #[must_use]
+    pub fn stage(&self) -> Stage {
+        self.stage
+    }
+    #[must_use]
+    pub fn reason(&self) -> &'static str {
+        self.reason
+    }
+    #[must_use]
+    pub fn place(&self) -> Option<Point2> {
+        self.at
+    }
+    #[must_use]
+    pub fn fix_text(&self) -> Option<&'static str> {
+        self.fix
+    }
+}
+
+impl std::fmt::Display for Refusal {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{:?}: {}", self.stage, self.reason)?;
+        if let Some(fix) = self.fix {
+            write!(f, " ({fix})")?;
+        }
+        Ok(())
+    }
+}
+
+/// A stage ran another behaviour than the one asked. The status line names
+/// it (law 4): a fallback is never silent.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Fallback {
+    stage: Stage,
+    asked: &'static str,
+    used: &'static str,
+    reason: &'static str,
+}
+
+/// Refusal reason: a fallback whose used behaviour is the asked one.
+pub const FALLBACK_SAME: &str = "a fallback must use another behaviour than the one asked";
+
+impl Fallback {
+    /// A fallback from `asked` to `used`, for `reason`. Refused when the two
+    /// are the same, or when a name is blank.
+    pub fn new(stage: Stage, asked: &'static str, used: &'static str, reason: &'static str) -> Result<Self, Refusal> {
+        if [reason, asked, used].iter().any(|s| s.trim().is_empty()) {
+            return Err(Refusal::new(stage, NO_REASON));
+        }
+        if asked.trim() == used.trim() {
+            return Err(Refusal::new(stage, FALLBACK_SAME));
+        }
+        Ok(Self { stage, asked, used, reason })
+    }
+    #[must_use]
+    pub fn stage(&self) -> Stage {
+        self.stage
+    }
+    #[must_use]
+    pub fn asked(&self) -> &'static str {
+        self.asked
+    }
+    #[must_use]
+    pub fn used(&self) -> &'static str {
+        self.used
+    }
+    #[must_use]
+    pub fn reason(&self) -> &'static str {
+        self.reason
+    }
+}
+
+/// An area of the cutter-centre region that no swept disc covers.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Gap {
+    area_mm2: f64,
+    at: Point2,
+}
+
+/// Refusal reason: a gap with no positive, finite area or no finite place.
+pub const BAD_GAP: &str = "a gap must have a positive finite area and a finite place";
+
+impl Gap {
+    pub fn new(area_mm2: f64, at: Point2) -> Result<Self, Refusal> {
+        if !finite(&[area_mm2, at.x, at.y]) || area_mm2 <= 0.0 {
+            return Err(Refusal::new(Stage::Guide, BAD_GAP));
+        }
+        Ok(Self { area_mm2, at })
+    }
+    #[must_use]
+    pub fn area_mm2(&self) -> f64 {
+        self.area_mm2
+    }
+    #[must_use]
+    pub fn at(&self) -> Point2 {
+        self.at
+    }
+}
+
+/// The gaps of an incomplete result: one or more.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Gaps(Vec<Gap>);
+
+/// Refusal reason: an incomplete verdict that names no gap.
+pub const INCOMPLETE_NO_GAP: &str = "an incomplete result must name at least one gap";
+
+impl Gaps {
+    pub fn new(stage: Stage, gaps: Vec<Gap>) -> Result<Self, Refusal> {
+        if gaps.is_empty() { Err(Refusal::new(stage, INCOMPLETE_NO_GAP)) } else { Ok(Self(gaps)) }
+    }
+    #[must_use]
+    pub fn list(&self) -> &[Gap] {
+        &self.0
+    }
+}
+
+/// A note for the status line, from one stage. Its text is not blank.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Note {
+    stage: Stage,
+    text: String,
+}
+
+impl Note {
+    pub fn new(stage: Stage, text: impl Into<String>) -> Result<Self, Refusal> {
+        let text = text.into();
+        if text.trim().is_empty() { Err(Refusal::new(stage, NO_REASON)) } else { Ok(Self { stage, text }) }
+    }
+    #[must_use]
+    pub fn stage(&self) -> Stage {
+        self.stage
+    }
+    #[must_use]
+    pub fn text(&self) -> &str {
+        &self.text
+    }
+}
+
+/// The result of a stage: done (with each fallback named), incomplete
+/// (with each gap named; never posted silently), or refused. Each variant
+/// holds only validated records.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Verdict<T> {
+    Done { out: T, fallbacks: Vec<Fallback>, notes: Vec<Note> },
+    Incomplete { out: T, gaps: Gaps, notes: Vec<Note> },
+    Refused(Refusal),
+}
+
+impl<T> Verdict<T> {
+    #[must_use]
+    pub fn done(out: T) -> Self {
+        Self::Done { out, fallbacks: Vec::new(), notes: Vec::new() }
+    }
+
+    /// An incomplete result. Refused when `gaps` is empty: "incomplete"
+    /// without a named gap would hide what is missing.
+    pub fn incomplete(stage: Stage, out: T, gaps: Vec<Gap>) -> Result<Self, Refusal> {
+        Ok(Self::Incomplete { out, gaps: Gaps::new(stage, gaps)?, notes: Vec::new() })
+    }
+
+    /// Adds a fallback. An incomplete verdict keeps its state, and the
+    /// fallback goes in as a note so that it is still named. A refused
+    /// verdict stays refused.
+    #[must_use]
+    pub fn with_fallback(self, fb: Fallback) -> Self {
+        match self {
+            Self::Done { out, mut fallbacks, notes } => {
+                fallbacks.push(fb);
+                Self::Done { out, fallbacks, notes }
+            }
+            Self::Incomplete { out, gaps, mut notes } => {
+                let text = format!("{} instead of {}: {}", fb.used, fb.asked, fb.reason);
+                notes.push(Note { stage: fb.stage, text });
+                Self::Incomplete { out, gaps, notes }
+            }
+            r @ Self::Refused(_) => r,
+        }
+    }
+
+    /// The output, if the stage gave one (done or incomplete).
+    #[must_use]
+    pub fn out(&self) -> Option<&T> {
+        match self {
+            Self::Done { out, .. } | Self::Incomplete { out, .. } => Some(out),
+            Self::Refused(_) => None,
+        }
+    }
+
+    /// Only a done verdict can reach the post.
+    #[must_use]
+    pub fn postable(&self) -> bool {
+        matches!(self, Self::Done { .. })
+    }
+}
