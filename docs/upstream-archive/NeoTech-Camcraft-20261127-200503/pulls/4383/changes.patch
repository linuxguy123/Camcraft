+        links: Links::PLANAR,
+        picks: PathPicks::default(),
+    }
+}
+
+#[test]
+fn kernel_baseline_contour() {
+    let square = region(vec![poly(&[(0.0, 0.0), (40.0, 0.0), (40.0, 40.0), (0.0, 40.0)])]);
+    let out = || params(Side::Outside);
