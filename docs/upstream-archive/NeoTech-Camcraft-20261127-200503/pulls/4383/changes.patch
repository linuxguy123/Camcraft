+//! #4154 (K7a of the path kernel, #4027): the law measures of
+//! `common/law_measure/`, their unit tests on hand-made toolpaths, and the
+//! readings of the OLD planners of the phase-1 kinds on the disc of #3934
+//! and the dog bone of #3741, pinned as they are today. A reading that
+//! breaks a law is not a failure here: the table marks it, and the kernel
+//! must improve it.
+//!
+//! Gate map: covers the test helpers `common/law_measure` and the old
+//! planners of camcraft_motion::machining2d and machining3d (read only),
+//! and the order and link stages of the kernel (camcraft_pathkernel::order,
+//! camcraft_pathkernel::link; #4177) and the load stage
+//! (camcraft_pathkernel::load; #4026) on the same fixtures, and the
+//! converter from a kernel plan to a toolpath (camcraft_motion::kernel_emit;
+//! #4269).
+//! Provenance: our own design record (#4024, "the laws as checks" and the
+//! switch-over proof); no vendor material consulted.
+
+mod common;
+#[path = "kernel_laws/measure_units.rs"]
+mod measure_units;
+#[path = "kernel_laws/fixture.rs"]
+mod fixture;
+#[path = "kernel_laws/laws_pockets.rs"]
+mod laws_pockets;
+#[path = "kernel_laws/laws_profiles.rs"]
+mod laws_profiles;
+#[path = "kernel_laws/laws_holes.rs"]
+mod laws_holes;
+#[path = "kernel_laws/laws_slots.rs"]
+mod laws_slots;
+#[path = "kernel_laws/k4_order_link.rs"]
+mod k4_order_link;
+#[path = "kernel_laws/k6a_plan_emit.rs"]
+mod k6a_plan_emit;
+#[path = "kernel_laws/k3_load.rs"]
+mod k3_load;
diff --git a/crates/motion/tests/kernel_laws/fixture.rs b/crates/motion/tests/kernel_laws/fixture.rs
new file mode 100644
index 000000000..e4859fd2e
--- /dev/null
+++ b/crates/motion/tests/kernel_laws/fixture.rs
@@ -0,0 +1,185 @@
+//! The test parts of the kernel law readings (#4154): the disc of #3934
+//! and the dog bone of #3741 (as in `pass_start_levels/ring_links.rs`) in
+//! a stock box of 80 x 50, a flat tool of radius 4, one level at Z -2 under
+//! a stock top at Z 0; and the table that pins the readings of a kind.
+
+use super::common::law_measure::{EntryKind, Readings, Spec, measure};
+use camcraft_motion::cl::Toolpath;
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::geometry::{Point3, Triangle};
+use camcraft_motion::links::Links;
+use camcraft_motion::machining2d::{PassStart, PocketParams, PocketStrategy, StartSide};
+
+/// The tool radius.
+pub const R: f64 = 4.0;
+/// The stock top.
+pub const TOP: f64 = 0.0;
+/// The one cut level.
+pub const Z: f64 = -2.0;
+/// The ring step of the pocket kinds.
+pub const STEP: f64 = 2.0;
+
+/// The engagement that a step `s` of the tool radius `r` plans, in
+/// degrees (`acos(1 - s / r)`).
+pub fn planned_deg(s: f64, r: f64) -> f64 {
+    (1.0 - s / r).clamp(-1.0, 1.0).acos().to_degrees()
+}
+
+pub fn region(loops: Vec<Vec<Point2>>) -> Region {
+    let loops = loops.into_iter().map(|l| Loop::new(l).expect("loop")).collect();
+    Region::new(loops).expect("region")
+}
+
+pub fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Vec<Point2> {
+    vec![
+        Point2::new(x0, y0),
+        Point2::new(x1, y0),
+        Point2::new(x1, y1),
+        Point2::new(x0, y1),
+    ]
+}
+
+fn disc_loop(cx: f64, r: f64) -> Vec<Point2> {
+    (0..128)
+        .map(|k| {
+            let a = f64::from(k) * std::f64::consts::TAU / 128.0;
+            Point2::new(cx + r * a.cos(), r * a.sin())
+        })
+        .collect()
+}
+
+pub fn stock() -> Region {
+    region(vec![rect(-40.0, -25.0, 40.0, 25.0)])
+}
+
+/// A disc of radius 12 in the middle of the box.
+pub fn disc() -> Region {
+    region(vec![disc_loop(0.0, 12.0)])
+}
+
+/// Two discs of radius 12 at X -15 and X 15, joined by a neck 8 mm wide.
+pub fn dog_bone() -> Region {
+    region(vec![disc_loop(-15.0, 12.0)])
+        .union(&region(vec![disc_loop(15.0, 12.0)]))
+        .and_then(|p| p.union(&region(vec![rect(-15.0, -4.0, 15.0, 4.0)])))
+        .expect("part")
+}
+
+/// The test parts by name.
+pub fn parts() -> [(&'static str, Region); 2] {
+    [("disc", disc()), ("dog bone", dog_bone())]
+}
+
+/// The band the tool centre may use round a part: the stock grown by the
+/// diameter (the Outside reach), less the part.
+pub fn band(part: &Region) -> Region {
+    stock()
+        .offset(2.0 * R)
+        .and_then(|s| s.difference(part))
+        .expect("band")
+}
+
+/// The area that the tool centre may use when it clears round `part`.
+pub fn centre_reach(part: &Region) -> Region {
+    stock()
+        .offset(R)
+        .and_then(|s| s.difference(&part.offset(R).expect("grown part")))
+        .expect("centre reach")
+}
+
+pub fn side(start: PassStart) -> StartSide {
+    StartSide {
+        start,
+        stock: Some(stock()),
+        around_part: true,
+    }
+}
+
+/// The pocket parameters of the ring cases (as `pass_start_levels`).
+pub fn pocket_params(strategy: PocketStrategy) -> PocketParams {
+    PocketParams {
+        tool_diameter: 2.0 * R,
+        stepover: STEP,
+        stock_to_leave: 0.0,
+        clearance_z: 10.0,
+        retract_z: Some(2.0),
+        top_z: TOP,
+        bottom_z: Z,
+        stepdown: 2.0,
+        feed: 1000.0,
+        plunge_feed: 300.0,
+        climb: true,
+        strategy,
+        entry: Entry3D::Helix,
+        helix_radius: 1.5,
+        optimal_load: 0.25,
+        blend_turns: false,
+        blend_radius: None,
+        links: Links::PLANAR,
+    }
+}
+
+/// The spec of a clearing round `part` in the stock box.
+pub fn spec_round(part: &Region, limit_deg: f64) -> Spec {
+    let mut s = Spec::new(R, stock(), TOP, limit_deg);
+    s.part = Some(part.clone());
+    s.reach = Some(centre_reach(part));
+    s.asked_entry = Some(EntryKind::Helix);
+    s
+}
+
+/// A closed prism of `outline` from `z0` to `z1`, as facets.
+pub fn prism(outline: &Region, z0: f64, z1: f64) -> Vec<Triangle> {
+    let mut out = Vec::new();
+    for t in outline.triangles().expect("triangles") {
+        let p = |q: Point2, z: f64| Point3::new(q.x, q.y, z);
+        out.push(Triangle::new(p(t[0], z1), p(t[1], z1), p(t[2], z1)));
+        out.push(Triangle::new(p(t[0], z0), p(t[2], z0), p(t[1], z0)));
+    }
+    for l in outline.loops() {
+        let pts = l.points();
+        for (k, &a) in pts.iter().enumerate() {
+            let b = pts[(k + 1) % pts.len()];
+            let (a0, a1) = (Point3::new(a.x, a.y, z0), Point3::new(a.x, a.y, z1));
+            let (b0, b1) = (Point3::new(b.x, b.y, z0), Point3::new(b.x, b.y, z1));
+            out.push(Triangle::new(a0, b0, b1));
+            out.push(Triangle::new(a0, b1, a1));
+        }
+    }
+    out
+}
+
+/// One pinned row: the case, the readings and the laws that they break.
+pub type Row = (&'static str, &'static str, &'static str);
+
+/// Measure each case and compare it with the pinned table. On a
+/// difference the message lists the whole table as read, ready to pin.
+pub fn pin(kind: &str, slot: bool, table: &[Row], cases: Vec<(String, Toolpath, Spec)>) {
+    let read: Vec<(String, Readings)> = cases
+        .into_iter()
+        .map(|(name, path, spec)| {
+            let r = measure(&path, &spec).unwrap_or_else(|e| panic!("{kind} {name}: {e}"));
+            (name, r)
+        })
+        .collect();
+    let got: Vec<(String, String, String)> = read
+        .iter()
+        .map(|(n, r)| (n.clone(), r.row(), r.breaks(slot)))
+        .collect();
+    let want: Vec<(String, String, String)> = table
+        .iter()
+        .map(|(n, r, b)| ((*n).to_string(), (*r).to_string(), (*b).to_string()))
+        .collect();
+    if got != want {
+        let mut text = String::new();
+        for ((n, row, b), (_, r)) in got.iter().zip(&read) {
+            text.push_str(&format!("    (\"{n}\",\n     \"{row}\",\n     \"{b}\"),\n"));
+            text.push_str(&format!(
+                "    // places: lifts {:?} over {:?} full {:?} entries {:?} fallbacks {:?}\n",
+                r.lifts.places, r.over.places, r.full_width.places, r.entries, r.fallbacks
+            ));
+        }
+        panic!("{kind}: the readings of the old planner differ from the pinned table:\n{text}");
+    }
+}
diff --git a/crates/motion/tests/kernel_laws/k3_load.rs b/crates/motion/tests/kernel_laws/k3_load.rs
new file mode 100644
index 000000000..ccf659940
--- /dev/null
+++ b/crates/motion/tests/kernel_laws/k3_load.rs
@@ -0,0 +1,78 @@
+//! #4026 (K3 of the path kernel): the kernel plan of K4 round the disc of
+//! #3934 and the dog bone of #3741, Inside and Outside, with the kernel's
+//! load stage at a constant engagement of 25 % (the planned 60 degrees of
+//! the old tables), read with the law measures of #4154. The readings are
+//! pinned as measured, against the kernel plan without load control and
+//! the old planners' rows (`laws_pockets.rs`). The path is the cuts of
+//! the plan without the entry leads (`cuts_path_with`, #4269).
+
+use super::common::law_measure::measure;
+use super::fixture::{R, STEP, parts, planned_deg, spec_round, stock};
+use super::k4_order_link::cuts_path_with;
+use camcraft_motion::geo2d::{Point2, Region};
+use camcraft_pathkernel::load::{LoadControl, LoadStage, Reach, StockRead};
+use camcraft_pathkernel::order::StartSide;
+
+/// The material that the tool can cut: the stock box less the part.
+struct Left(Region, Region);
+
+impl StockRead for Left {
+    fn material_at(&self, p: Point2) -> Option<bool> {
+        Some(self.0.contains(p) && !self.1.contains(p))
+    }
+}
+
+/// For each part and side, without load control (`None`: the K4 plan,
+/// each cut above the limit named) and with constant engagement:
+/// [feed moves above the limit, the worst engagement in degrees, the
+/// moves above the limit with no named place within one tool radius].
+/// Measured; the old 2D Pocket rows are over 20 worst 178 (disc) and over
+/// 32 worst 180 (dog bone). The worst Inside is the first ring round the
+/// part: a full-width cut with no pass beside it, named (`FRESH_CUT`). The
+/// unnamed moves of Outside are on the stock edge line, where a piece
+/// starts: there the kernel's read and the meter of #4154 differ
+/// (follow-up issue named in the decision file). Since #4254 a link comes
+/// in to such a start from the air, at depth: the approach is a stretch of
+/// a link, and the load stage reads the cuts only, so its moves above the
+/// limit are not named yet (#4272; before #4254 the Outside rows were
+/// [402, 145, 13], [334, 118, 74] on the disc and [724, 167, 3],
+/// [678, 143, 66] on the dog bone; with #4253 the disc row with constant
+/// engagement read [337, 118, 77], #4269). The path is the cuts-only path
+/// of the plan (`cuts_path_with`): the approach stretches are its feeds.
+const READ: [(&str, &str, [u32; 3], [u32; 3]); 4] = [
+    ("disc", "Inside", [3507, 173, 0], [833, 173, 1]),
+    ("disc", "Outside", [415, 145, 19], [344, 122, 81]),
+    ("dog bone", "Inside", [2587, 173, 0], [581, 173, 1]),
+    ("dog bone", "Outside", [739, 180, 13], [683, 143, 69]),
+];
+
+#[test]
+fn kernel_load_control_round_the_disc_and_the_dog_bone() {
+    let load = STEP / (2.0 * R);
+    let stage = LoadStage::new(load).unwrap();
+    let ce = LoadControl::constant(load, Reach::Rings).unwrap();
+    let mut got = Vec::new();
+    for (pname, part) in parts() {
+        let reader = Left(stock(), part.clone());
+        for (sname, side) in [("Inside", StartSide::Inside), ("Outside", StartSide::Outside)] {
+            let spec = spec_round(&part, planned_deg(STEP, R));
+            let mut rows = Vec::new();
+            for lc in [LoadControl::None, ce] {
+                let (path, _, v) = cuts_path_with(&part, side, Some((&stage, lc, &reader)));
+                let r = measure(&path, &spec).unwrap();
+                let ctl = v.as_ref().and_then(|v| v.out()).unwrap();
+                eprintln!("{pname} {sname} {lc:?}: {}", r.row());
+                eprintln!("  {} curves, {} named places; notes {:?}", ctl.set().curves().len(), ctl.over().len(), path.notes);
+                assert_eq!(r.crossings.count, 0, "{pname} {sname}: no feed crosses another");
+                assert_eq!(r.leaves.count, 0, "{pname} {sname}: each feed stays in the reach");
+                assert_eq!(r.named_lifts, r.lifts.count, "{pname} {sname}: each lift has a named reason");
+                let named = |q: &&Point2| ctl.over().iter().any(|o| (o.at().x - q.x).hypot(o.at().y - q.y) <= R);
+                let unnamed: Vec<&Point2> = r.over.places.iter().filter(|q| !named(q)).collect();
+                eprintln!("  unnamed over moves at {:?}", unnamed.iter().take(6).collect::<Vec<_>>());
+                rows.push([r.over.count as u32, r.worst_deg.round() as u32, unnamed.len() as u32]);
+            }
+            got.push((pname, sname, rows[0], rows[1]));
+        }
+    }
+    assert_eq!(got, READ.to_vec(), "the load readings of the kernel");
+}
diff --git a/crates/motion/tests/kernel_laws/k4_order_link.rs b/crates/motion/tests/kernel_laws/k4_order_link.rs
new file mode 100644
index 000000000..6c4306502
--- /dev/null
+++ b/crates/motion/tests/kernel_laws/k4_order_link.rs
@@ -0,0 +1,226 @@
+//! #4177 (K4 of the path kernel): the kernel's ring guide, order stage and
+//! link stage round the disc of #3934 and the dog bone of #3741, Inside and
+//! Outside, read with the same law measures as the old planners (#4154).
+//! The kernel plan of each case (guide, order, link, and the entry and
+//! exit stage) is made into a toolpath by the real converter of motion
+//! (`camcraft_motion::kernel_emit`, #4269), which writes one link note for
+//! each lift reason (the note text of `links.rs`).
+//! Pins: the crossing feeds as measured (`CROSSINGS`), each lift named,
+//! and the lift count. The test prints the places of the full-width feeds
+//! (load is K3's, #4254 reports them).
+
+use super::common::law_measure::{Readings, measure};
+use super::fixture::{R, STEP, TOP, Z, parts, planned_deg, spec_round, stock};
+use camcraft_motion::cl::{MoveKind, PathBuilder, Toolpath};
+use camcraft_motion::geometry::Point3;
+use camcraft_motion::geo2d::{Point2, Region};
+use camcraft_motion::kernel_emit::{EmitFeeds, EmitHeights, Emitted, emit_plan};
+use camcraft_pathkernel::entry::{ArcChoice, EntryChoice, EntryKind, EntryPlanner, EntryStage, Heights};
+use camcraft_pathkernel::guide::{GuideChoice, GuidePlanner, RingPlanner, RingRef, RingsChoice};
+use camcraft_pathkernel::link::{Hop, Level, LinkPolicy, LinkProof, LinkStage, LinkTally};
+use camcraft_pathkernel::load::{Controlled, LoadControl, LoadPlanner, StockRead};
+use camcraft_pathkernel::order::{Direction, OrderChoice, OrderPlanner, OrderStage, StartSide};
+use camcraft_pathkernel::plan::{Cut, Plan, Step};
+use camcraft_pathkernel::{Bounds, MaterialSide, Selection, ToolShape, Verdict, WorkPlane, region};
+
+/// The clearance height of the converted path (setup Z).
+pub const CLEARANCE: f64 = 10.0;
+
+/// The load stage of a kernel run (#4026): the planner, the choice and
+/// the stock reader; `None` runs no load stage.
+pub type Load<'a> = Option<(&'a dyn LoadPlanner, LoadControl, &'a dyn StockRead)>;
+
+/// The kernel plan of the material round `part` from `side` at the one
+/// level Z, with its link tally: the stages in the order of the law kit
+/// (`crates/pathkernel/tests/laws/kit.rs`), a helix asked for each entry.
+pub fn kernel_plan(part: &Region, side: StartSide) -> (Plan, LinkTally) {
+    let (plan, tally, _) = kernel_plan_with(part, side, None);
+    (plan, tally)
+}
+
+/// [`kernel_plan`] with the load stage `load` between order and link; the
+/// load verdict goes with it.
+pub fn kernel_plan_with(part: &Region, side: StartSide, load: Load) -> (Plan, LinkTally, Option<Verdict<Controlled>>) {
+    let sel = Selection::face(part.loops()[0].points().to_vec(), vec![]).unwrap();
+    let bounds = Bounds::new(Some(stock()), Region::empty(), TOP, Z).unwrap();
+    let tool = ToolShape::disc(R, 0.0, true, 30.0).unwrap();
+    let r = region(&sel, MaterialSide::Outside, &bounds, WorkPlane::setup_xy(Z).unwrap(), tool, 0.0).unwrap();
+    let g = GuideChoice::Rings(RingsChoice::new(RingRef::Part, 0.0, STEP, None, None).unwrap());
+    let set = RingPlanner.guide(&r, &g, 1e-3).unwrap().out().unwrap().clone();
+    let oc = OrderChoice { start: side, direction: Direction::Climb };
+    let ordered = OrderStage.order(set, &r, &oc, None).unwrap().out().unwrap().clone();
+    let controlled = load.map(|(stage, lc, reader)| stage.control(ordered.clone(), &r, reader, &lc, R).unwrap());
+    let curves = controlled.as_ref().and_then(Verdict::out).map_or(ordered.curves(), |c| c.set().curves());
+    let cuts: Vec<Cut> = curves.iter().map(|c| Cut::new(c.clone(), None).unwrap()).collect();
+    // The heights of the entry stage are along the plane normal above the level.
+    let stage = EntryStage::new(Heights::new(TOP - Z, 1.0, CLEARANCE - Z).unwrap(), ArcChoice::new(R, 90.0).unwrap(), 0.01).unwrap();
+    let choice = EntryChoice::new(EntryKind::Helix, 1.0, vec![]).unwrap();
+    let cleared = Region::empty();
+    let mut tally = LinkTally::default();
+    let mut paths: Vec<Vec<Point2>> = Vec::new();
+    let mut steps = Vec::new();
+    for (i, cut) in cuts.iter().enumerate() {
+        let lifted = match i.checked_sub(1) {
+            None => true,
+            Some(j) => {
+                let level = Level::new(&cuts[..i], &cuts[i..]).with_links(&paths);
+                let hop = LinkStage.link(&cuts[j], cut, &r, level, LinkPolicy::StayWhereProved, &mut tally);
+                if let Hop::Stay(path) = &hop {
+                    paths.push(path.points());
+                }
+                let lift = matches!(hop, Hop::Lift(_));
+                steps.push(Step::Link(hop));
+                lift
+            }
+        };
+        if lifted {
+            let e = stage.entry(cut, &r, &cleared, &choice).unwrap();
+            steps.push(Step::Entry(e.out().unwrap().clone()));
+        }
+        steps.push(Step::Cut(cut.clone()));
+    }
+    if let Some(last) = cuts.last() {
+        steps.push(Step::Exit(stage.exit(last, &r, &cleared).unwrap()));
+    }
+    (Plan::new(steps).unwrap(), tally, controlled)
+}
+
+/// The plan made into a toolpath by the converter.
+pub fn convert(plan: &Plan) -> Emitted {
+    let h = EmitHeights::new(CLEARANCE, TOP).unwrap();
+    let f = EmitFeeds::new(1000.0, 300.0).unwrap();
+    emit_plan(plan, WorkPlane::setup_xy(Z).unwrap(), h, f).unwrap()
+}
+
+/// The kernel plan of the material round `part` from `side`, as a
+/// toolpath, with its link tally.
+fn kernel_path(part: &Region, side: StartSide) -> (Toolpath, LinkTally) {
+    let (path, tally, _) = kernel_path_with(part, side, None);
+    (path, tally)
+}
+
+/// [`kernel_path`] with the load stage `load` between order and link; the
+/// load verdict goes with it, and each of its notes is a path note (the
+/// converter writes only the lift notes: the caller writes the notes of
+/// the stage verdicts).
+pub fn kernel_path_with(part: &Region, side: StartSide, load: Load) -> (Toolpath, LinkTally, Option<Verdict<Controlled>>) {
+    let (plan, tally, controlled) = kernel_plan_with(part, side, load);
+    let mut out = convert(&plan);
+    let cuts = plan.steps().iter().filter(|s| matches!(s, Step::Cut(_))).count();
+    assert_eq!(out.cut_moves.len(), cuts, "the converter emits each cut");
+    assert_eq!(out.lifts, tally.lifts() as usize, "the converter emits each lift");
+    let count = |f: fn(&Step) -> bool| plan.steps().iter().filter(|s| f(s)).count();
+    assert_eq!(out.entries, count(|s| matches!(s, Step::Entry(_))), "the converter emits each entry");
+    assert_eq!(out.stays, count(|s| matches!(s, Step::Link(Hop::Stay(_)))), "the converter emits each stay-down link");
+    assert_eq!(out.exits, count(|s| matches!(s, Step::Exit(_))), "the converter emits each exit");
+    if let Some(Verdict::Done { notes, .. }) = &controlled {
+        out.path.notes.extend(notes.iter().map(|n| n.text().to_string()));
+    }
+    (out.path, tally, controlled)
+}
+
+/// The retract plane of the cuts-only path.
+const RETRACT: f64 = 2.0;
+
+/// The cuts of the kernel plan with the load stage `load`, without the
+/// moves of the entry and exit stage: a rapid and a plunge at each entry
+/// to the start of its cut, a feed along each cut and each stay-down link,
+/// a rapid up at the end, and one link note for each lift reason. The load
+/// readings of `k3_load` (#4026) measure the cuts that the load stage
+/// gives, so the leads of the entry stage do not go into them.
+pub fn cuts_path_with(part: &Region, side: StartSide, load: Load) -> (Toolpath, LinkTally, Option<Verdict<Controlled>>) {
+    let (plan, tally, controlled) = kernel_plan_with(part, side, load);
+    let mut b = PathBuilder::new(Point3::new(0.0, 0.0, 10.0));
+    // A feed shorter than 1e-9 mm in XY is skipped, as the K4 test pen did.
+    let feed = |b: &mut PathBuilder, q: Point2| {
+        if (q.x - b.at().x).hypot(q.y - b.at().y) > 1e-9 {
+            b.push(MoveKind::Feed, Point3::new(q.x, q.y, Z), Some(1000.0));
+        }
+    };
+    let mut entered = false;
+    for step in plan.steps() {
+        match step {
+            Step::Entry(_) => entered = true,
+            Step::Cut(c) => {
+                let pts: Vec<Point2> = c.curve().pts().iter().map(|q| q.at()).collect();
+                if std::mem::take(&mut entered) {
+                    let at = b.at();
+                    b.push(MoveKind::Rapid, Point3::new(at.x, at.y, RETRACT), None);
+                    b.push(MoveKind::Rapid, Point3::new(pts[0].x, pts[0].y, RETRACT), None);
+                    b.push(MoveKind::Plunge, Point3::new(pts[0].x, pts[0].y, Z), Some(1000.0));
+                }
+                for q in &pts[1..] {
+                    feed(&mut b, *q);
+                }
+                if c.curve().closed() {
+                    feed(&mut b, pts[0]);
+                }
+            }
+            Step::Link(Hop::Stay(path)) => path.points().into_iter().for_each(|q| feed(&mut b, q)),
+            _ => {}
+        }
+    }
+    let at = b.at();
+    b.push(MoveKind::Rapid, Point3::new(at.x, at.y, RETRACT), None);
+    let mut path = b.finish();
+    for (why, n) in tally.by_reason() {
+        path.notes.push(format!("link: the tool lifted to the retract plane {n} time(s) instead of the keep-down link - {why}"));
+    }
+    if let Some(Verdict::Done { notes, .. }) = &controlled {
+        path.notes.extend(notes.iter().map(|n| n.text().to_string()));
+    }
+    (path, tally, controlled)
+}
+
+/// The lift count of the kernel for each part and side: (part, side, lifts).
+/// The old planners on the same fixtures (#4154 tables): 2D Pocket 18 on
+/// the disc and 26 on the dog bone, none named; 2D Offset 0. Outside starts
+/// at the stock edge. A link leaves a piece there through the edge band
+/// into the air (#4241) and comes back in to the start of the next piece
+/// with an approach from the air whose disc cuts only the swath of that
+/// piece (#4254, `docs/decisions/4254-kernel-air-approach.md`): no lift
+/// stays.
+const LIFTS: [(&str, &str, usize); 4] = [
+    ("disc", "Inside", 0),
+    ("disc", "Outside", 0),
+    ("dog bone", "Inside", 0),
+    ("dog bone", "Outside", 0),
+];
+
+/// The feed crossings of the converted plan for each part and side:
+/// (part, side, crossings). Measured on the merge of #4254 (the approach
+/// from the air) and #4269 (the real converter, which emits the arc lead
+/// of each entry). Each Outside crossing is in the air, one tool radius
+/// outside the stock: a link of #4254 runs along the air line (y -29) to
+/// the door of its approach and crosses the arc lead of the first entry
+/// (moves 2 to 11). The link stage proves a link against the cuts, the
+/// links and the planned cuts, not against the leads of the entry stage
+/// (follow-up issue named in `docs/decisions/4269-kernel-plan-converter.md`).
+/// The kernel's own test pen has no leads and reads 0 on each case.
+const CROSSINGS: [(&str, &str, usize); 4] = [
+    ("disc", "Inside", 0),
+    ("disc", "Outside", 3),
+    ("dog bone", "Inside", 0),
+    ("dog bone", "Outside", 1),
+];
+
+#[test]
+fn kernel_order_and_link_round_the_disc_and_the_dog_bone() {
+    let (mut got, mut crossed) = (Vec::new(), Vec::new());
+    for (pname, part) in parts() {
+        for (sname, side) in [("Inside", StartSide::Inside), ("Outside", StartSide::Outside)] {
+            let (path, tally) = kernel_path(&part, side);
+            let r: Readings = measure(&path, &spec_round(&part, planned_deg(STEP, R))).unwrap();
+            eprintln!("{pname} {sname}: {}", r.row());
+            eprintln!("  lift reasons {:?} at {:?}", tally.by_reason(), r.lifts.places);
+            eprintln!("  full-width feeds at {:?}", r.full_width.places);
+            eprintln!("  crossings {} at {:?}", r.crossings.count, r.crossings.places);
+            assert_eq!(r.named_lifts, r.lifts.count, "{pname} {sname}: each lift has a named reason");
+            assert_eq!(r.lifts.count, tally.lifts() as usize, "{pname} {sname}: the tally counts each lift");
+            got.push((pname, sname, r.lifts.count));
+            crossed.push((pname, sname, r.crossings.count));
+        }
+    }
+    assert_eq!(got, LIFTS.to_vec(), "the lift counts of the kernel");
+    assert_eq!(crossed, CROSSINGS.to_vec(), "the feed crossings of the converted plan");
+}
