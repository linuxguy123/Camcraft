+    for (case, p) in cases {
+        pin("chamfer", case, &chamfer(&square, &p).unwrap_or_else(|e| panic!("{case}: {e}")));
+    }
+    let run = vec![vec![Point2::new(-20.0, -20.0), Point2::new(20.0, -20.0)]];
