From b1fcc20ebe9daa6c47b97ec90e31b02d825ba63a Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Fri, 27 Nov 2026 14:18:41 +0000
Subject: [PATCH 6/6] fix(ui): the Break-through from reason shows on the
 disabled row's hover

A disabled widget shows no plain hover text, so the hint never reached
the user. The reason now rides on_disabled_hover_text of the row, and the
test hovers the label and reads the painted tooltip.

Refs #2528

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/holes_page.rs                | 11 +++++++++--
 crates/ui/src/egui_app/tests/holes_break_through.rs | 12 ++++++++++--
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/crates/ui/src/egui_app/holes_page.rs b/crates/ui/src/egui_app/holes_page.rs
index 8c6350045..087272c6e 100644
--- a/crates/ui/src/egui_app/holes_page.rs
+++ b/crates/ui/src/egui_app/holes_page.rs
@@ -334,13 +334,20 @@ fn break_through_from_row(ui: &mut Ui, from: &mut camcraft_app::drilling::BreakT
         BreakThroughFrom::Tip => 1,
     };
     let before = idx;
-    ui.add_enabled_ui(idle.is_none(), |ui| {
+    let row = ui.add_enabled_ui(idle.is_none(), |ui| {
         prop_row(ui, "Break-through from", |ui| combo(ui, "d_bt_from", &mut idx, &["Full diameter", "Tip"]));
     });
     if idx != before {
         *from = if idx == 1 { BreakThroughFrom::Tip } else { BreakThroughFrom::FullDiameter };
     }
-    hint(ui, idle.unwrap_or("Full diameter adds the drill point cone so the full diameter breaks through; Tip measures to the point tip"));
+    match idle {
+        // A disabled row shows no plain hover text: the reason rides the
+        // disabled hover of the whole row.
+        Some(why) => {
+            row.response.on_disabled_hover_text(why);
+        }
+        None => hint(ui, "Full diameter adds the drill point cone so the full diameter breaks through; Tip measures to the point tip"),
+    }
 }
 
 /// The hole kinds' depth override, inside the Levels group: off, every
diff --git a/crates/ui/src/egui_app/tests/holes_break_through.rs b/crates/ui/src/egui_app/tests/holes_break_through.rs
index 312394f36..5ed87e946 100644
--- a/crates/ui/src/egui_app/tests/holes_break_through.rs
+++ b/crates/ui/src/egui_app/tests/holes_break_through.rs
@@ -197,9 +197,17 @@ fn drill_break_through_from_is_disabled_where_it_has_no_effect() {
             .accesskit_node()
             .is_disabled()
     };
+    // The reason is the disabled row's hover text: hover the label.
+    let hover_says = |h: &mut Harness<'static, ShellUi>, w: &str| {
+        let at = h.get_by_label("Break-through from").rect().center();
+        h.input_mut().events.push(egui::Event::PointerMoved(at));
+        h.run_steps(60);
+        structural::painted(h).iter().any(|(t, _)| t.contains(w))
+    };
     assert!(disabled(&h), "no hole yet: the combo is disabled");
-    assert!(h.query_by_label("no effect: no hole in the list is through").is_some());
+    assert!(hover_says(&mut h, "no hole in the list is through"), "{:?}", structural::painted(&h));
     set_holes(&mut h, vec![through_hole()]);
     assert!(!disabled(&h), "a through hole: the combo is live");
-    assert!(h.query_by_label("no effect: no hole in the list is through").is_none());
+    assert!(!hover_says(&mut h, "no hole in the list is through"), "{:?}", structural::painted(&h));
+    assert!(hover_says(&mut h, "adds the drill point cone"), "{:?}", structural::painted(&h));
 }
