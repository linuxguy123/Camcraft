From 7e5349799bd152da010c4e2b87d7eeb180c21ecb Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Fri, 27 Nov 2026 10:42:35 +0000
Subject: [PATCH 3/6] fix(drilling): bound the radial peck loop by its full
 travel

Auto reads the depth in material, but the pecks run from the R
standoff. The peck budget now reads the full travel from the R plane,
and a peck that makes no progress is refused. A far standoff (30000 mm,
1e20) is refused by name; it is never looped over.

Refs #2443

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/motion/src/drilling/cross.rs            | 10 ++++++++--
 crates/motion/src/drilling/tests_auto_depth.rs | 18 ++++++++++++++++++
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/crates/motion/src/drilling/cross.rs b/crates/motion/src/drilling/cross.rs
index 569f7f55c7..5b29807366 100644
--- a/crates/motion/src/drilling/cross.rs
+++ b/crates/motion/src/drilling/cross.rs
@@ -257,7 +257,9 @@ pub fn cross_drill(p: &CrossParams) -> Result<Toolpath, GenError> {
             CycleKind::Peck | CycleKind::Deep => {
                 let auto = if kind == CycleKind::Peck { 3.0 * d } else { d };
                 let step = if p.peck > 0.0 { p.peck } else { auto }.max(0.25 * d);
-                if !(step.is_finite() && step > 0.0) || depth / step > 4096.0 {
+                // The pecks run from the R standoff: the budget reads the full travel.
+                let travel = p.r_d - bottom;
+                if !(step.is_finite() && step > 0.0 && travel.is_finite()) || travel / step > 4096.0 {
                     return Err(GenError::Invalid("peck plan unusable".into()));
                 }
                 let mut t = (p.r_d - step).max(bottom);
@@ -272,7 +274,11 @@ pub fn cross_drill(p: &CrossParams) -> Result<Toolpath, GenError> {
                         p.r_d
                     };
                     rapid(&mut b, along(h, up));
-                    t = (t - step).max(bottom);
+                    let next = (t - step).max(bottom);
+                    if next >= t {
+                        return Err(GenError::Invalid("peck plan unusable: a peck makes no progress".into()));
+                    }
+                    t = next;
                 }
                 rapid(&mut b, along(h, p.r_d));
             }
diff --git a/crates/motion/src/drilling/tests_auto_depth.rs b/crates/motion/src/drilling/tests_auto_depth.rs
index bdfe603b93..2014392a4f 100644
