+    ("3 mm", 3.0, 11.0, 15.0),
+    ("4 mm", 4.0, 14.0, 22.0),
+    ("5 mm", 5.0, 16.0, 22.0),
+    ("6 mm", 6.0, 21.0, 27.0),
