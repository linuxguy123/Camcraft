 crates/ui/src/egui_app/tests/tool_undercut.rs    |  3 +++
 .../ui/src/egui_app/tool_library_dialog/list.rs  |  8 ++++++--
 docs/decisions/4335-tool-list-search.md          |  8 +++++---
 4 files changed, 22 insertions(+), 13 deletions(-)

diff --git a/crates/ui/src/egui_app/tests/tool_icon_wiring.rs b/crates/ui/src/egui_app/tests/tool_icon_wiring.rs
