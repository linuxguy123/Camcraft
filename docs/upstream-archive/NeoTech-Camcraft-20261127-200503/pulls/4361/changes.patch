+//! Refusals: each Klartext function outside the first slice is refused by name, with its line and block number; the program frame is checked.
+
+use camcraft_gcode::{GcodeError, KlartextOptions};
+
+use super::{parse, pgm, refusal};
+
+#[test]
+fn klartext_functions_outside_the_slice_are_refused_by_name_and_block() {
+    let cases: [(&str, &str); 17] = [
+        ("RND R5", "RND"),
+        ("CHF 2", "CHF"),
+        ("LP PR+10 PA+0 R0 F100", "LP"),
+        ("CP IPA+90 DR+", "CP"),
+        ("L X+5 RL F100", "RL"),
+        ("L X+5 RR F100", "RR"),
+        ("LBL 1", "LBL"),
+        ("CALL LBL 1 REP 2", "CALL"),
+        ("APPR LT X+0 Y+0 LEN10 RL F100", "APPR"),
+        ("L A+90 FMAX", "axis A"),
+        ("L X+5 FAUTO", "FAUTO"),
+        ("L X+5 FMAX M91", "M91"),
+        ("M136", "M136"),
+        ("FN 1: Q1 = +1 + +2", "FN 1"),
+        ("Q1 = Q2 + 1", "Q1 = Q2+1"),
+        ("TOOL CALL 1 X S100", "TOOL CALL X"),
+        ("C X+10 Y+0 Z-5 DR+ F100", "helix"),
+    ];
+    for (line, code) in cases {
+        let nc = pgm(&["L X+0 Y+0 Z+10 R0 F100", "CC X+5 Y+0", line]);
+        let e = refusal(&nc);
+        match &e {
+            GcodeError::UnsupportedCode { code: c, .. } => assert_eq!(c, code, "{line}"),
+            other => panic!("{line}: expected an unsupported-code refusal, got {other}"),
+        }
+        assert_eq!(e.line(), 4, "{line}");
+        assert!(e.to_string().contains("block 3:"), "{line}: {e}");
+    }
+}
+
+#[test]
+fn klartext_inch_programs_and_unknown_words_are_refused() {
+    let e = refusal("0 BEGIN PGM T INCH\n1 END PGM T INCH\n");
+    assert!(
+        matches!(&e, GcodeError::UnsupportedCode { code, line: 1, .. } if code == "BEGIN PGM INCH"),
+        "{e}"
+    );
+    let e = refusal(&pgm(&["FOO X+1"]));
+    assert!(matches!(&e, GcodeError::UnknownWord { line: 2, .. }), "{e}");
+    let e = refusal(&pgm(&["L X+1 KK FMAX"]));
+    assert!(matches!(&e, GcodeError::UnknownWord { line: 2, .. }), "{e}");
+}
+
+#[test]
+fn klartext_program_frame_is_checked() {
+    let syntax_line = |nc: &str| match refusal(nc) {
+        GcodeError::Syntax { line, .. } => line,
+        other => panic!("expected a syntax refusal, got {other} for\n{nc}"),
+    };
+    // Motion before BEGIN PGM, a block after END PGM, a missing END PGM, a name mismatch.
+    assert_eq!(
+        syntax_line("0 L X+1 FMAX\n1 BEGIN PGM T MM\n2 END PGM T MM\n"),
+        1
+    );
+    assert_eq!(
+        syntax_line("0 BEGIN PGM T MM\n1 END PGM T MM\n2 L X+1 FMAX\n"),
+        3
+    );
+    assert_eq!(syntax_line("0 BEGIN PGM T MM\n1 L X+1 FMAX\n"), 2);
+    assert_eq!(syntax_line("0 BEGIN PGM T MM\n1 END PGM U MM\n"), 2);
+    // Motion after M30.
+    assert_eq!(syntax_line(&pgm(&["M30", "L X+1 FMAX"])), 3);
+    // A feed move without any F.
+    let e = refusal(&pgm(&["L X+1 Y+0"]));
+    assert!(matches!(e, GcodeError::InvalidModal { line: 2, .. }), "{e}");
+}
+
+#[test]
+fn klartext_arc_preconditions_are_refused() {
+    let invalid_arc = |body: &[&str]| match refusal(&pgm(body)) {
+        GcodeError::InvalidArc { .. } => {}
+        other => panic!("expected an invalid arc, got {other} for {body:?}"),
+    };
+    invalid_arc(&["L X+10 Y+0 Z+0 F100", "C X+0 Y+10 DR+"]); // no CC
+    invalid_arc(&["L X+10 Y+0 Z+0 F100", "CC X+0 Y+0", "C X+0 Y+10"]); // no DR
+    invalid_arc(&["L X+10 Y+0 Z+0 F100", "CC X+0 Y+0", "C X+0 Y+12 DR+"]); // radius mismatch
+    invalid_arc(&["L X+10 Y+0 Z+0 F100", "CR X+0 Y+50 R+10 DR+"]); // chord longer than 2R
+    invalid_arc(&["L X+0 Y+0 Z+0 F100", "CT X+10 Y+0"]); // pure Z before CT: no tangent
+    invalid_arc(&["L X+0 Y+0 Z+0 F100", "L X+10", "CT X+20 Y+0"]); // CT end on the tangent line
+    invalid_arc(&["L X+10 Y+0 Z+0 F100", "CC X+0", "C X+0 Y+10 DR+"]); // CC with one axis
+}
+
+#[test]
+fn klartext_m140_mb_max_needs_the_traverse_end() {
+    let nc = pgm(&["L M140 MB MAX"]);
+    let e = parse(&nc, &KlartextOptions::default()).expect_err("no traverse end");
+    assert!(
+        matches!(e, GcodeError::MissingReferencePosition { line: 2, .. }),
+        "{e}"
+    );
+    let low = KlartextOptions {
+        tool_axis_max_z: Some(-5.0),
+        ..KlartextOptions::default()
+    };
+    let e = parse(&nc, &low).expect_err("traverse end below the tool");
+    assert!(
+        matches!(e, GcodeError::UnsupportedCode { line: 2, .. }),
+        "{e}"
+    );
+    let bad = KlartextOptions {
+        tool_axis_max_z: Some(f64::NAN),
+        ..KlartextOptions::default()
+    };
+    assert!(matches!(
+        parse(&nc, &bad),
+        Err(GcodeError::InvalidOptions { .. })
+    ));
+}
diff --git a/crates/gcode/tests/klartext/round_trip.rs b/crates/gcode/tests/klartext/round_trip.rs
new file mode 100644
index 0000000000..30ce6e37fb
--- /dev/null
+++ b/crates/gcode/tests/klartext/round_trip.rs
@@ -0,0 +1,140 @@
+//! Round trip: the recorded Klartext post golden reads back into the motion of the recorded CL stream that the post was given.
+
+use camcraft_cl::cl::MoveKind;
+use camcraft_gcode::{ProgramEnd, SpindleDir, WorkOffset};
+
+use super::{assert_to, moves, near, ok};
+
+/// The golden that `crates/post/tests/script_heidenhain_klartext.rs` writes from `contour.cnc`.
+const GOLDEN: &str =
+    include_str!("../../../post/tests/recorded/golden/heidenhain-klartext/picomax.nc");
+/// The CL stream (machine frame, micrometres, feed in micrometres per minute) the post read.
+const STREAM: &str = include_str!("../../../post/tests/klartext/contour.cnc");
+
+#[derive(Debug)]
+struct StreamMove {
+    rapid: bool,
+    to: [f64; 3],
+    feed: Option<f64>,
+    arc: Option<(bool, [f64; 2])>,
+}
+
+fn param(name: &str) -> f64 {
+    STREAM
+        .lines()
+        .find_map(|l| l.strip_prefix(&format!("PARAM {name} ")))
+        .and_then(|v| v.trim().parse().ok())
+        .unwrap_or_else(|| panic!("stream has no PARAM {name}"))
+}
+
+/// The section moves of the stream, moved into the work frame (minus the origin).
+fn stream_moves() -> Vec<StreamMove> {
+    let origin = [param("OriginX"), param("OriginY"), param("OriginZ")];
+    let mut out = Vec::new();
+    for l in STREAM.lines().skip_while(|l| *l != "SECTION").skip(1) {
+        if l == "ENDSECTION" {
+            break;
+        }
+        let toks: Vec<&str> = l.split_whitespace().collect();
+        let word = |w: &str| {
+            toks.iter()
+                .position(|t| *t == w)
+                .and_then(|i| toks.get(i + 1))
+                .map(|v| v.parse::<f64>().expect("stream number") / 1000.0)
+        };
+        let xyz = |k: usize, w: &str| word(w).expect("stream axis") - origin[k];
+        let to = [xyz(0, "X"), xyz(1, "Y"), xyz(2, "Z")];
+        let arc = (toks[0] == "Arc").then(|| {
+            let ccw = toks[1] == "CCW";
+            (
+                ccw,
+                [
+                    word("I").expect("I") - origin[0],
+                    word("J").expect("J") - origin[1],
+                ],
+            )
+        });
+        out.push(StreamMove {
+            rapid: toks[0] == "Rapid",
+            to,
+            feed: word("F"),
+            arc,
+        });
+    }
+    out
+}
+
+#[test]
+fn klartext_post_golden_reads_back_into_the_stream_motion() {
+    let p = ok(GOLDEN);
+    let expected = stream_moves();
+    assert_eq!(expected.len(), 6, "the stream fixture changed");
+    let got = moves(&p);
+    assert!(got.len() >= expected.len());
+    let tail = &got[got.len() - expected.len()..];
+    for (m, e) in tail.iter().zip(&expected) {
+        assert_to(m, e.to[0], e.to[1], e.to[2]);
+        assert_eq!(
+            m.kind == MoveKind::Rapid,
+            e.rapid,
+            "rapid/feed kind of {e:?}"
+        );
+        match (m.feed, e.feed) {
+            (Some(a), Some(b)) => assert!(near(a, b), "feed {a} vs {b}"),
+            (None, None) => {}
+            (a, b) => panic!("feed {a:?} vs {b:?} for {e:?}"),
+        }
+        match (&m.arc, e.arc) {
+            (Some(a), Some((ccw, c))) => {
+                assert_eq!(a.ccw, ccw);
+                assert!(
+                    near(a.center.x, c[0]) && near(a.center.y, c[1]),
+                    "centre {:?} vs {c:?}",
+                    a.center
+                );
+            }
+            (None, None) => {}
+            (a, b) => panic!("arc {a:?} vs {b:?}"),
+        }
+    }
+    // The approach before the stream motion: M140 MB MAX, then XY, then Z, all rapid and above the first stream point.
+    let approach = &got[..got.len() - expected.len()];
+    assert_eq!(approach.len(), 2);
+    assert!(
+        approach
+            .iter()
+            .all(|m| m.kind == MoveKind::Rapid && m.to.z >= expected[0].to[2] - 1e-9)
+    );
+    assert_to(approach[0], 0.0, 0.0, 100.0);
+
+    // Program facts: tool 2 at 3500 rpm on preset 2 (G55), three M0 stops, M2 end.
+    let last = p.sections.last().expect("a section");
+    assert_eq!(
+        (last.tool_number, last.spindle_rpm, last.spindle_dir),
+        (Some(2), Some(3500.0), SpindleDir::Cw)
+    );
+    assert_eq!(last.work_offset, WorkOffset::G55);
+    assert_eq!(p.tools, vec![2]);
+    assert_eq!(p.ended, Some(ProgramEnd::M2));
+    assert_eq!(
+        p.stops.iter().map(|s| s.line).collect::<Vec<_>>(),
+        vec![12, 21, 26]
+    );
+    // Block 32 (the DR+ arc) is on physical line 34: line 14 is the Q339 continuation line.
+    let arc_line = last.move_lines[last.move_lines.len() - 4];
+    assert_eq!(arc_line, 34);
+}
+
+#[test]
+fn klartext_post_golden_needs_the_traverse_end_for_m140() {
+    let e = super::parse(GOLDEN, &camcraft_gcode::KlartextOptions::default())
+        .expect_err("M140 MB MAX needs the option");
+    assert!(
+        matches!(
+            e,
+            camcraft_gcode::GcodeError::MissingReferencePosition { line: 23, .. }
+        ),
+        "{e}"
+    );
+    assert!(e.to_string().contains("block 21"), "{e}");
+}
diff --git a/docs/decisions/2227-klartext-reader.md b/docs/decisions/2227-klartext-reader.md
new file mode 100644
index 0000000000..33cd47361d
--- /dev/null
+++ b/docs/decisions/2227-klartext-reader.md
@@ -0,0 +1,87 @@
+## #2227 - Klartext reader, first slice
+
+**What was decided.** `camcraft-gcode` gets a separate Klartext entry,
+`parse_klartext` / `parse_klartext_with(program, &KlartextOptions)`, in
+`crates/gcode/src/klartext/`. It produces the same `ParsedProgram` /
+`ParsedSection` / `cl::Toolpath` output as the RS-274 reader and reuses its
+section builder, arc resolver (`crate::arc`), numeric domain checks and the
+peck bound (`cycle_expand::peck_count`). The RS-274 word pipeline is not
+reused: Klartext has keyword blocks (`BEGIN PGM`, `TOOL CALL`, `CYCL DEF`),
+not address words, so a shared lexer would need a mode switch in every step.
+
+The slice reads: `BEGIN PGM <name> MM` / `END PGM` (names must match; a
+missing `END PGM` is refused as a truncated program), `BLK FORM 0.1 Z` /
+`0.2` (checked, not part of the toolpath), `TOOL CALL` (number or `"NAME"`,
+axis Z, `S`, `F`; `DL`/`DR` only when zero), `TOOL DEF` (no-op), `L` (X/Y/Z,
+IX/IY/IZ, `R0`, `F` modal, `FMAX` for the block only), `CC` (both axes or
+none), `C` with `DR+`/`DR-`, `CR` with `R+`/`R-` (minor/major arc, the RS-274
+R-sign rule), `CT` (tangent to the previous element), `CYCL DEF 247` (preset
+Q339 = 1..6, read as work offset G54..G59), `CYCL DEF 200`/`203`/`205` called
+by `CYCL CALL` or `M99`, `FN 0: Qn = <literal>` and `Qn = <literal>`, Q
+references in values (`X+Q1`, `X-Q1`), `STOP`, `;` comments, `*` structure
+blocks, `~` continuation lines, and the M functions 0, 1, 2, 3, 4, 5, 8, 9,
+13, 14, 30, 99, 137 and `M140 MB MAX` / `MB <n>`. All other blocks and words
+are refused by name with the physical line, and the message starts with
+`block N:`.
+
+**Why, item by item.**
+- *Line vs block number.* `GcodeError` keeps the 1-based physical line (the
+  same field as the RS-274 reader, so callers map errors the same way). The
+  block number goes into the message text, because the issue asks for it and
+  a continuation line makes the two numbers differ.
+- *`RL`/`RR` are refused.* The output is the tool-centre path. Reading a
+  compensated contour as if it were the centre path would cut in the wrong
+  place by one tool radius.
+- *`RND`/`CHF`, `LBL`/`CALL LBL`, polar `LP`/`CP`, `APPR`/`DEP`, FK are
+  refused.* Rounding and chamfer change the element before and after them
+  (look-ahead); label calls need a jump interpreter with its own loop bound.
+  Each is a follow-up, not a silent approximation.
+- *INCH programs are refused.* The TNC reads `F` in an inch program in units
+  of 0.1 inch/min; a wrong scale would be a wrong feed. MM only until a test
+  pins the inch rules.
+- *Helix (`C`/`CR`/`CT` with a Z change) is refused.* On the iTNC 530 a helix
+  is written with `CP` and `IZ`; the plain-arc Z change is control dependent
+  (docs/research/heidenhain/differences.md, helix row).
+- *`M140 MB MAX` needs `KlartextOptions::tool_axis_max_z`.* The end of the
+  traverse range is a machine value. Without it the reader cannot know the Z
+  of the retract, and every later move would start from a guessed height. It
+  is refused as `MissingReferencePosition`, the same way the RS-274 reader
+  refuses `G28` without a configured reference.
+- *`M0` switches the spindle and the coolant off.* The iTNC M function table
+  lists M0 as program stop, spindle stop, coolant off. `M1` records only an
+  optional stop, because a skipped M1 keeps the spindle on.
+- *Preset Q339 = n is read as work offset n.* CamCraft's own post writes
+  `Q339=+<work offset>` for work offsets 1..6; preset 0 and rows above 6 have
+  no `WorkOffset` and are refused.
+- *Drilling cycles.* Q meanings come from the public TNC cycle manuals and
+  general machining knowledge (our research notes list only the Q numbers):
+  Q200 set-up clearance, Q201 depth (negative), Q206 plunge feed, Q202
+  plunging depth, Q203 surface, Q204 2nd set-up clearance, Q211 dwell at
+  depth. Each infeed goes Q202 deeper from the surface (Q203), the tool
+  retracts at rapid to the set-up clearance between infeeds, and ends at the
+  higher of the set-up clearance and the 2nd set-up clearance. Options that
+  change the motion and that this slice does not model are refused when they
+  are not zero: Q210 (dwell at top), Q212 (decrement), Q213 (chip breaks),
+  Q257 (chip-break depth), Q379 (deepened start), Q395 (depth reference).
+  Accepted without effect: Q205, Q208, Q253, Q256, Q258, Q259 (they change
+  only the feed or the re-approach distance on the same line in the hole
+  axis, or need a non-zero Q212/Q213/Q257 to act).
+- *The re-approach after a retract is one feed move from the set-up
+  clearance to the next depth.* The TNC goes down at rapid to an advance
+  stop distance above the last depth and feeds from there. The reader's
+  line is the same line in the hole axis, so it cannot gouge; only the time
+  differs. The `cl::Cycle` record is `Deep` when there is more than one
+  infeed and `Drill` for one.
+- *`ParsedSection` gets a `tool_name` field.* A named `TOOL CALL "FLAT-6"`
+  has no number, so two named tools would merge into one section without
+  it. The RS-274 reader sets `None`. No crate outside `camcraft-gcode` reads
+  the type yet.
+
+**Dropped.** A Heidenhain `Dialect` preset for the RS-274 reader (wrong
+syntax model); a guessed default for `M140 MB MAX` (silent wrong height);
+reading `RL`/`RR` as `R0` (silent wrong path).
+
+**Cost to change later.** Each refused function is one new branch in
+`klartext/exec.rs` dispatch or `klartext/words.rs`, plus a test; no output
+type changes. `LBL` calls need a block list with a program counter instead
+of the single pass.

From d9470782329eab63fa5481b1bbd0aacf887effbc Mon Sep 17 00:00:00 2001
From: Quintin Smits <qd.smits@gmail.com>
Date: Fri, 27 Nov 2026 15:23:39 +0100
Subject: [PATCH 2/2] fix(gcode): a Klartext STOP block with M0 or M1 records
 one stop

STOP is an unconditional program stop. The reader recorded a second
stop for each M0 or M1 in the same block (STOP M1 gave a ProgramStop
and an OptionalStop). The block now records one ProgramStop; M0 keeps
its spindle stop and coolant off.

Pinned by klartext_stop_with_m0_or_m1_records_one_program_stop.

Refs #2227

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/gcode/src/klartext/blocks.rs  | 14 +++++++++++---
 crates/gcode/tests/klartext/paths.rs | 24 ++++++++++++++++++++++++
 2 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/crates/gcode/src/klartext/blocks.rs b/crates/gcode/src/klartext/blocks.rs
index 14a304c875..d3427dc816 100644
--- a/crates/gcode/src/klartext/blocks.rs
+++ b/crates/gcode/src/klartext/blocks.rs
@@ -5,7 +5,7 @@ use super::exec::Machine;
 use super::source::{Block, literal, q_index};
 use super::words::value;
 use crate::domain::check_feed;
-use crate::types::{GcodeError, StopEvent, StopKind};
+use crate::types::{GcodeError, SpindleDir, StopEvent, StopKind};
 
 impl Machine<'_> {
     /// `BLK FORM 0.1 Z X.. Y.. Z..` and `BLK FORM 0.2 X.. Y.. Z..`: checked, then
@@ -155,7 +155,10 @@ impl Machine<'_> {
         Ok(())
     }
 
-    /// `STOP` (optionally with M functions) is a programmed stop.
+    /// `STOP` (optionally with M functions) is a programmed stop. The block
+    /// records exactly one stop: `STOP` is unconditional, so an `M0` or `M1`
+    /// in the same block adds no second stop (an `M1` cannot weaken it). `M0`
+    /// keeps its modal effect (spindle stop, coolant off).
     pub fn stop_block(&mut self, b: &Block, toks: &[String]) -> Result<(), GcodeError> {
         let w = super::words::decode(b, toks, &self.q)?;
         if w.has_coords() || w.feed.is_some() || w.r0 {
@@ -169,6 +172,11 @@ impl Machine<'_> {
             section: self.current.index,
             after_move,
         });
-        self.post_m(b, &w.m, w.mb)
+        if w.m.contains(&0) {
+            self.modal.spindle_dir = SpindleDir::Off;
+            self.modal.coolant = Default::default();
+        }
+        let rest: Vec<u32> = w.m.iter().copied().filter(|&n| n != 0 && n != 1).collect();
+        self.post_m(b, &rest, w.mb)
     }
 }
