new file mode 100644
index 0000000000..99e123f2ae
--- /dev/null
+++ b/crates/gcode/src/klartext/exec.rs
@@ -0,0 +1,303 @@
+//! Klartext block dispatch and machine state: program frame (`BEGIN PGM` / `END PGM`), M functions, sections and the final `ParsedProgram`.
+//! Provenance: HEIDENHAIN iTNC 530 conversational user's manual 533 190-22 (program structure, M function table and effect at block start or end), as summarized in docs/research/heidenhain/.
+
+use camcraft_geometry::geo2d::Point2;
+use camcraft_geometry::geometry::Point3;
+use camcraft_geometry::geometry::units::Unit;
+
+use super::KlartextOptions;
+use super::cycles::DrillDef;
+use super::source::Block;
+use super::words::QTable;
+use crate::section::SectionBuilder;
+use crate::types::{
+    DwellEvent, GcodeError, LineMap, ModalState, MoveLine, ParseOptions, ParsedProgram,
+    ParsedSection, ProgramEnd, SpindleDir, StopEvent, StopKind,
+};
+
+pub struct Machine<'a> {
+    pub opts: &'a KlartextOptions,
+    pub modal: ModalState,
+    pub pos: Point3,
+    /// Circle centre of the last `CC` block (modal).
+    pub cc: Option<Point2>,
+    /// Unit XY direction at the end of the last move, for `CT`.
+    pub tangent: Option<Point2>,
+    pub cycle: Option<DrillDef>,
+    pub q: QTable,
+    pub tool_name: Option<String>,
+    section_tool_name: Option<String>,
+    pgm: Option<String>,
+    pgm_ended: bool,
+    ended: Option<ProgramEnd>,
+    pub sections: Vec<ParsedSection>,
+    pub current: SectionBuilder,
+    pub dwells: Vec<DwellEvent>,
+    stops: Vec<StopEvent>,
+    pub tools: Vec<u32>,
+}
+
+impl<'a> Machine<'a> {
+    pub fn new(opts: &'a KlartextOptions) -> Self {
+        let mut modal = ModalState::from_dialect(&ParseOptions::default().dialect);
+        modal.units = Some(Unit::Millimeters);
+        let pos = opts.initial_position;
+        let current = SectionBuilder::new(0, pos, &modal);
+        Self {
+            opts,
+            modal,
+            pos,
+            cc: None,
+            tangent: None,
+            cycle: None,
+            q: QTable::new(),
+            tool_name: None,
+            section_tool_name: None,
+            pgm: None,
+            pgm_ended: false,
+            ended: None,
+            sections: Vec::new(),
+            current,
+            dwells: Vec::new(),
+            stops: Vec::new(),
+            tools: Vec::new(),
+        }
+    }
+
+    pub fn step(&mut self, b: &Block) -> Result<(), GcodeError> {
+        let w: Vec<&str> = b.words.iter().map(String::as_str).collect();
+        if self.pgm_ended {
+            return Err(b.syntax("block after END PGM"));
+        }
+        if w.first() == Some(&"BEGIN") {
+            return self.begin(b, &w);
+        }
+        if self.pgm.is_none() {
+            return Err(b.syntax("the program must start with BEGIN PGM"));
+        }
+        if w.first() == Some(&"END") {
+            return self.end(b, &w);
+        }
+        if self.ended.is_some() {
+            return Err(b.syntax("executable block after program end (M2/M30)"));
+        }
+        self.dispatch(b, &w)
+    }
+
+    fn begin(&mut self, b: &Block, w: &[&str]) -> Result<(), GcodeError> {
+        if self.pgm.is_some() {
+            return Err(b.syntax("a second BEGIN PGM"));
+        }
+        match w {
+            ["BEGIN", "PGM", name, "MM"] => {
+                self.pgm = Some((*name).to_string());
+                Ok(())
+            }
+            ["BEGIN", "PGM", _, "INCH"] => {
+                Err(b.unsupported("BEGIN PGM INCH", "inch programs are not read (only MM)"))
+            }
+            _ => Err(b.syntax("expected BEGIN PGM <name> MM")),
+        }
+    }
+
+    fn end(&mut self, b: &Block, w: &[&str]) -> Result<(), GcodeError> {
+        let ["END", "PGM", name, unit] = w else {
+            return Err(b.syntax("expected END PGM <name> MM"));
+        };
+        if self.pgm.as_deref() != Some(*name) || *unit != "MM" {
+            return Err(b.syntax(&format!(
+                "END PGM {name} {unit} does not match BEGIN PGM {} MM",
+                self.pgm.as_deref().unwrap_or("")
+            )));
+        }
+        self.pgm_ended = true;
+        Ok(())
+    }
+
+    fn dispatch(&mut self, b: &Block, w: &[&str]) -> Result<(), GcodeError> {
+        let rest = &b.words[1..];
+        match w[0] {
+            "L" => self.line_block(b, rest),
+            "CC" => self.cc_block(b, rest),
+            "C" => self.arc_block(b, rest),
+            "CR" => self.radius_arc_block(b, rest),
+            "CT" => self.tangent_arc_block(b, rest),
+            "BLK" => self.blk_form(b, rest),
+            "TOOL" => self.tool_block(b, rest),
+            "CYCL" => self.cycle_block(b, rest),
+            "FN" => self.fn_block(b, rest),
+            "STOP" => self.stop_block(b, rest),
+            k if k.starts_with('Q') => self.q_assign(b, &b.words),
+            k if k.starts_with('M') && k.len() > 1 => {
+                // An M-only block, as written by the post (`M3`, `M0`, `M2`).
+                let words = super::words::decode(b, &b.words, &self.q)?;
+                if words.has_coords() || words.feed.is_some() || words.r0 {
+                    return Err(b.syntax("an M block takes only M functions"));
+                }
+                self.pre_m(b, &words.m)?;
+                self.post_m(b, &words.m, words.mb)
+            }
+            "RND" | "CHF" => Err(b.unsupported(
+                w[0],
+                "rounding and chamfer blocks change the neighbour elements; this reader version refuses them",
+            )),
+            "LP" | "CP" | "CTP" | "PA" => Err(b.unsupported(w[0], "polar coordinates are not read")),
+            "APPR" | "DEP" => Err(b.unsupported(w[0], "approach and departure functions are not read")),
+            "LBL" | "CALL" => Err(b.unsupported(
+                w[0],
+                "labels and program calls (LBL, CALL LBL, CALL PGM) are not read in this reader version",
+            )),
+            "FK" | "FL" | "FLT" | "FC" | "FCT" | "FPOL" => {
+                Err(b.unsupported(w[0], "FK free contour programming is not read"))
+            }
+            other => Err(b.unknown(other)),
+        }
+    }
+
+    /// M functions that act at the start of the block.
+    pub fn pre_m(&mut self, b: &Block, m: &[u32]) -> Result<(), GcodeError> {
+        for &n in m {
+            match n {
+                3 => self.modal.spindle_dir = SpindleDir::Cw,
+                4 => self.modal.spindle_dir = SpindleDir::Ccw,
+                8 => self.modal.coolant.flood = true,
+                13 | 14 => {
+                    self.modal.spindle_dir = if n == 13 {
+                        SpindleDir::Cw
+                    } else {
+                        SpindleDir::Ccw
+                    };
+                    self.modal.coolant.flood = true;
+                }
+                0 | 1 | 2 | 5 | 9 | 30 | 99 | 137 | 140 => {}
+                136 => return Err(b.unsupported("M136", "feed per revolution is not read")),
+                89 => {
+                    return Err(b.unsupported(
+                        "M89",
+                        "the modal cycle call is not read; use CYCL CALL or M99",
+                    ));
+                }
+                91 | 92 => {
+                    return Err(
+                        b.unsupported(&format!("M{n}"), "machine-based coordinates are not read")
+                    );
+                }
+                _ => return Err(b.unsupported(&format!("M{n}"), "this M function is not read")),
+            }
+        }
+        self.sync_section();
+        Ok(())
+    }
+
+    /// M functions that act at the end of the block. M99 calls the active cycle.
+    pub fn post_m(
+        &mut self,
+        b: &Block,
+        m: &[u32],
+        mb: Option<super::words::Mb>,
+    ) -> Result<(), GcodeError> {
+        if mb.is_some() && !m.contains(&140) {
+            return Err(b.syntax("MB without M140"));
+        }
+        if m.contains(&99) {
+            self.cycle_call(b)?;
+        }
+        if m.contains(&140) {
+            self.m140(b, mb)?;
+        }
+        for &n in m {
+            let after_move = self.current.builder.moves_len().checked_sub(1);
+            match n {
+                0 | 1 => {
+                    let kind = if n == 0 {
+                        StopKind::ProgramStop
+                    } else {
+                        StopKind::OptionalStop
+                    };
+                    self.stops.push(StopEvent {
+                        line: b.line,
+                        kind,
+                        section: self.current.index,
+                        after_move,
+                    });
+                    if n == 0 {
+                        // iTNC M0: program stop, spindle stop, coolant off.
+                        self.modal.spindle_dir = SpindleDir::Off;
+                        self.modal.coolant = Default::default();
+                    }
+                }
+                5 => self.modal.spindle_dir = SpindleDir::Off,
+                9 => self.modal.coolant = Default::default(),
+                2 => self.ended = Some(ProgramEnd::M2),
+                30 => self.ended = Some(ProgramEnd::M30),
+                _ => {}
+            }
+        }
+        if self.ended.is_some() {
+            self.cycle = None;
+        }
+        Ok(())
+    }
+
+    /// Start a new section when the tool, offset, spindle or coolant changed after a move.
+    pub fn sync_section(&mut self) {
+        if !self.current.has_moves() {
+            self.current = SectionBuilder::new(self.current.index, self.pos, &self.modal);
+            self.section_tool_name = self.tool_name.clone();
+            return;
+        }
+        if self.current.state_matches(&self.modal) && self.section_tool_name == self.tool_name {
+            return;
+        }
+        let next = self.sections.len() + 1;
+        let prev = std::mem::replace(
+            &mut self.current,
+            SectionBuilder::new(next, self.pos, &self.modal),
+        );
+        let name = std::mem::replace(&mut self.section_tool_name, self.tool_name.clone());
+        let mut s = prev.finish();
+        s.tool_name = name;
+        self.sections.push(s);
+    }
+
+    pub fn push_stop(&mut self, s: StopEvent) {
+        self.stops.push(s);
+    }
+
+    pub fn finish(mut self, lines: usize) -> Result<ParsedProgram, GcodeError> {
+        if !self.pgm_ended {
+            return Err(GcodeError::Syntax {
+                line: lines.max(1),
+                message: "the program has no END PGM block (truncated program?)".to_string(),
+            });
+        }
+        let idx = self.current.index;
+        let named = self.dwells.iter().any(|d| d.section == idx)
+            || self.stops.iter().any(|s| s.section == idx);
+        if self.current.has_moves() || named {
+            let mut s = self.current.finish();
+            s.tool_name = self.section_tool_name.take();
+            self.sections.push(s);
+        }
+        let mut entries = Vec::new();
+        for (section, sec) in self.sections.iter().enumerate() {
+            for (move_index, &line) in sec.move_lines.iter().enumerate() {
+                entries.push(MoveLine {
+                    section,
+                    move_index,
+                    line,
+                });
+            }
+        }
+        Ok(ParsedProgram {
+            program_number: None,
+            sections: self.sections,
+            line_map: LineMap { entries },
+            dwells: self.dwells,
+            stops: self.stops,
+            ended: self.ended,
+            tools: self.tools,
+            final_modal: self.modal,
+        })
+    }
+}
diff --git a/crates/gcode/src/klartext/mod.rs b/crates/gcode/src/klartext/mod.rs
new file mode 100644
index 0000000000..75e68aa223
--- /dev/null
+++ b/crates/gcode/src/klartext/mod.rs
@@ -0,0 +1,96 @@
+//! HEIDENHAIN Klartext (conversational, `.H`) reader, first slice: a 3-axis subset into the same `ParsedProgram` sections as the RS-274 reader.
+//! Provenance: HEIDENHAIN iTNC 530 conversational user's manual 533 190-22 and the TNC cycle manuals, as summarized in docs/research/heidenhain/; CamCraft's own Klartext post output (assets/posts/heidenhain-klartext.cps). Decisions: docs/decisions/2227-klartext-reader.md.
+
+mod blocks;
+mod cycles;
+mod exec;
+mod path;
+mod source;
+mod words;
+
+use camcraft_geometry::geometry::Point3;
+
+use crate::domain::MAX_ABS_MM;
+use crate::types::{GcodeError, ParsedProgram};
+
+/// Caller configuration for a Klartext program.
+#[derive(Clone, Debug, PartialEq)]
+pub struct KlartextOptions {
+    /// Tool position (work frame, mm) before the first block.
+    pub initial_position: Point3,
+    /// Largest start/end radius difference of a `C` arc, in mm.
+    pub arc_radius_tolerance_mm: f64,
+    /// Work-frame Z of the end of the tool-axis traverse range. `M140 MB MAX`
+    /// retracts to it; without it `M140 MB MAX` is refused.
+    pub tool_axis_max_z: Option<f64>,
+}
+
+impl Default for KlartextOptions {
+    fn default() -> Self {
+        Self {
+            initial_position: Point3::ZERO,
+            arc_radius_tolerance_mm: 0.02,
+            tool_axis_max_z: None,
+        }
+    }
+}
+
+/// Parse a HEIDENHAIN Klartext program with default options.
+///
+/// # Errors
+/// Returns a line-numbered [`GcodeError`]; a refusal names the block number and
+/// the Klartext function that this reader does not read.
+pub fn parse_klartext(program: &str) -> Result<ParsedProgram, GcodeError> {
+    parse_klartext_with(program, &KlartextOptions::default())
+}
+
+/// Parse a HEIDENHAIN Klartext program with caller options.
+///
+/// # Errors
+/// Returns a line-numbered [`GcodeError`] for bad options, syntax, an unsupported
+/// function, an invalid arc or cycle, or a missing `BEGIN PGM` / `END PGM`.
+pub fn parse_klartext_with(
+    program: &str,
+    options: &KlartextOptions,
+) -> Result<ParsedProgram, GcodeError> {
+    check_options(options)?;
+    let (blocks, lines) = source::split_blocks(program)?;
+    let mut m = exec::Machine::new(options);
+    for b in &blocks {
+        m.step(b)?;
+    }
+    m.finish(lines)
+}
+
+fn check_options(o: &KlartextOptions) -> Result<(), GcodeError> {
+    let p = o.initial_position;
+    let bad = |field: &str, v: String| GcodeError::InvalidOptions {
+        field: field.to_string(),
+        message: v,
+    };
+    if ![p.x, p.y, p.z]
+        .iter()
+        .all(|v| v.is_finite() && v.abs() <= MAX_ABS_MM)
+    {
+        return Err(bad(
+            "initial_position",
+            format!("({}, {}, {}) is not finite or out of range", p.x, p.y, p.z),
+        ));
+    }
+    let t = o.arc_radius_tolerance_mm;
+    if !(t.is_finite() && (0.0..=1.0e3).contains(&t)) {
+        return Err(bad(
+            "arc_radius_tolerance_mm",
+            format!("({t}) must be finite and in [0, 1000] mm"),
+        ));
+    }
+    if let Some(z) = o.tool_axis_max_z
+        && !(z.is_finite() && z.abs() <= MAX_ABS_MM)
+    {
+        return Err(bad(
+            "tool_axis_max_z",
+            format!("({z}) is not finite or out of range"),
+        ));
+    }
+    Ok(())
+}
diff --git a/crates/gcode/src/klartext/path.rs b/crates/gcode/src/klartext/path.rs
new file mode 100644
index 0000000000..dad973d44f
--- /dev/null
+++ b/crates/gcode/src/klartext/path.rs
@@ -0,0 +1,272 @@
+//! Klartext path blocks: `L` lines, `CC` circle centre, `C` / `CR` / `CT` arcs in the XY plane, and the `M140` tool-axis retract.
+//! Provenance: HEIDENHAIN iTNC 530 conversational user's manual 533 190-22 (path functions L, CC, C, CR, CT; M140), as summarized in docs/research/heidenhain/differences.md; arc resolution shared with the RS-274 reader (`crate::arc`).
+
+use camcraft_cl::cl::{ArcPlane, MoveKind};
+use camcraft_geometry::geo2d::Point2;
+use camcraft_geometry::geometry::Point3;
+
+use super::exec::Machine;
+use super::source::Block;
+use super::words::{Feed, Mb, Words, decode};
+use crate::arc::resolve_arc;
+use crate::domain::{check_feed, check_len, check_point};
+use crate::types::{ArcCenterMode, GcodeError};
+
+impl Machine<'_> {
+    pub fn line_block(&mut self, b: &Block, toks: &[String]) -> Result<(), GcodeError> {
+        let w = decode(b, toks, &self.q)?;
+        reject_arc_words(b, &w, "L")?;
+        self.pre_m(b, &w.m)?;
+        let rate = self.feed_words(b, &w)?;
+        if w.has_coords() {
+            let to = self.target(b, &w)?;
+            let (kind, feed) = match w.feed {
+                Some(Feed::Max) => (MoveKind::Rapid, None),
+                _ => (
+                    MoveKind::Feed,
+                    Some(rate.ok_or_else(|| b.invalid_modal("L needs a feed rate F or FMAX"))?),
+                ),
+            };
+            self.push_line(b, kind, to, feed);
+        }
+        self.post_m(b, &w.m, w.mb)
+    }
+
+    pub fn cc_block(&mut self, b: &Block, toks: &[String]) -> Result<(), GcodeError> {
+        let w = decode(b, toks, &self.q)?;
+        if w.abs[2].is_some() || w.inc[2].is_some() {
+            return Err(b.unsupported("CC Z", "only XY circle centres are read (tool axis Z)"));
+        }
+        if w.feed.is_some()
+            || w.r0
+            || w.ccw.is_some()
+            || w.radius.is_some()
+            || !w.m.is_empty()
+            || w.mb.is_some()
+        {
+            return Err(b.syntax("CC takes only X/Y or IX/IY"));
+        }
+        let given = |k: usize| w.abs[k].is_some() || w.inc[k].is_some();
+        if given(0) != given(1) {
+            return Err(
+                b.invalid_arc("CC needs both X and Y, or no coordinate (the last position)")
+            );
+        }
+        let axis = |k: usize, cur: f64| match (w.abs[k], w.inc[k]) {
+            (Some(v), _) => v,
+            (None, Some(d)) => cur + d,
+            (None, None) => cur,
+        };
+        let c = Point2::new(
+            check_len(b.line, "CC X", axis(0, self.pos.x))?,
+            check_len(b.line, "CC Y", axis(1, self.pos.y))?,
+        );
+        self.cc = Some(c);
+        Ok(())
+    }
+
+    pub fn arc_block(&mut self, b: &Block, toks: &[String]) -> Result<(), GcodeError> {
+        let w = decode(b, toks, &self.q)?;
+        if w.radius.is_some() {
+            return Err(b.syntax("C takes no radius; use CR for a radius arc"));
+        }
+        let ccw = w.ccw.ok_or_else(|| b.invalid_arc("C needs DR+ or DR-"))?;
+        let c = self
+            .cc
+            .ok_or_else(|| b.invalid_arc("C needs a circle centre CC before it"))?;
+        self.run_arc(b, &w, |m, to| {
+            resolve_arc(
+                b.line,
+                m.pos,
+                to,
+                ArcPlane::Xy,
+                ccw,
+                ArcCenterMode::Absolute,
+                [Some(c.x), Some(c.y), None],
+                None,
+                m.opts.arc_radius_tolerance_mm,
+            )
+            .map(|r| (r, ccw))
+        })
+    }
+
+    pub fn radius_arc_block(&mut self, b: &Block, toks: &[String]) -> Result<(), GcodeError> {
+        let w = decode(b, toks, &self.q)?;
+        let ccw = w.ccw.ok_or_else(|| b.invalid_arc("CR needs DR+ or DR-"))?;
+        let r = w
+            .radius
+            .ok_or_else(|| b.invalid_arc("CR needs a radius R+ or R-"))?;
+        let r = check_len(b.line, "CR radius", r)?;
+        self.run_arc(b, &w, |m, to| {
+            resolve_arc(
+                b.line,
+                m.pos,
+                to,
+                ArcPlane::Xy,
+                ccw,
+                ArcCenterMode::Absolute,
+                [None, None, None],
+                Some(r),
+                m.opts.arc_radius_tolerance_mm,
+            )
+            .map(|res| (res, ccw))
+        })
+    }
+
+    pub fn tangent_arc_block(&mut self, b: &Block, toks: &[String]) -> Result<(), GcodeError> {
+        let w = decode(b, toks, &self.q)?;
+        if w.ccw.is_some() || w.radius.is_some() {
+            return Err(b.syntax("CT takes no DR and no R; the tangent sets the arc"));
+        }
+        let t = self.tangent.ok_or_else(|| {
+            b.invalid_arc("CT needs a previous contour element with an XY direction")
+        })?;
+        self.run_arc(b, &w, |m, to| {
+            let d = Point2::new(to.x - m.pos.x, to.y - m.pos.y);
+            let n = Point2::new(-t.y, t.x);
+            let k = n.x * d.x + n.y * d.y;
+            if k.abs() <= 1e-9 * (1.0 + d.x.hypot(d.y)) {
+                return Err(
+                    b.invalid_arc("CT end point lies on the tangent line; no arc is possible")
+                );
+            }
+            let r = (d.x * d.x + d.y * d.y) / (2.0 * k);
+            let c = Point2::new(m.pos.x + n.x * r, m.pos.y + n.y * r);
+            check_len(b.line, "CT centre X", c.x)?;
+            check_len(b.line, "CT centre Y", c.y)?;
+            let ccw = k > 0.0;
+            resolve_arc(
+                b.line,
+                m.pos,
+                to,
+                ArcPlane::Xy,
+                ccw,
+                ArcCenterMode::Absolute,
+                [Some(c.x), Some(c.y), None],
+                None,
+                m.opts.arc_radius_tolerance_mm,
+            )
+            .map(|res| (res, ccw))
+        })
+    }
+
+    /// Shared arc tail: M functions, feed, end point, resolution and the moves.
+    fn run_arc<F>(&mut self, b: &Block, w: &Words, resolve: F) -> Result<(), GcodeError>
+    where
+        F: Fn(&Self, Point3) -> Result<(crate::arc::ResolvedArc, bool), GcodeError>,
+    {
+        if w.mb.is_some() {
+            return Err(b.syntax("MB on an arc block"));
+        }
+        if w.feed == Some(Feed::Max) {
+            return Err(b.invalid_arc("FMAX on an arc is not read; give a feed rate F"));
+        }
+        self.pre_m(b, &w.m)?;
+        let feed = self
+            .feed_words(b, w)?
+            .ok_or_else(|| b.invalid_modal("an arc needs a feed rate F"))?;
+        let to = self.target(b, w)?;
+        if (to.z - self.pos.z).abs() > 1e-9 {
+            return Err(b.unsupported(
+                "helix",
+                "an arc with a Z change is not read in this reader version",
+            ));
+        }
+        let (res, ccw) = resolve(self, to)?;
+        let c = res.center_words;
+        if let Some(mid) = res.split_mid {
+            check_point(b.line, "arc mid point", mid)?;
+            self.current
+                .push_arc(b.line, mid, feed, c, ccw, ArcPlane::Xy);
+        }
+        self.current
+            .push_arc(b.line, to, feed, c, ccw, ArcPlane::Xy);
+        let rx = to.x - c.x;
+        let ry = to.y - c.y;
+        let len = rx.hypot(ry);
+        self.tangent = (len > 1e-12).then(|| {
+            if ccw {
+                Point2::new(-ry / len, rx / len)
+            } else {
+                Point2::new(ry / len, -rx / len)
+            }
+        });
+        self.pos = to;
+        self.post_m(b, &w.m, None)
+    }
+
+    /// Apply an `F` word to the modal feed and return the active feed rate.
+    fn feed_words(&mut self, b: &Block, w: &Words) -> Result<Option<f64>, GcodeError> {
+        if let Some(Feed::Rate(f)) = w.feed {
+            self.modal.feed_rate_mm_min = Some(check_feed(b.line, f)?);
+        }
+        Ok(self.modal.feed_rate_mm_min)
+    }
+
+    /// End point of a path block; an axis that is not written keeps its position.
+    pub fn target(&self, b: &Block, w: &Words) -> Result<Point3, GcodeError> {
+        let cur = [self.pos.x, self.pos.y, self.pos.z];
+        let mut v = [0.0; 3];
+        for k in 0..3 {
+            v[k] = match (w.abs[k], w.inc[k]) {
+                (Some(a), _) => a,
+                (None, Some(d)) => cur[k] + d,
+                (None, None) => cur[k],
+            };
+        }
+        check_point(b.line, "end point", Point3::new(v[0], v[1], v[2]))
+    }
+
+    pub fn push_line(&mut self, b: &Block, kind: MoveKind, to: Point3, feed: Option<f64>) {
+        let dx = to.x - self.pos.x;
+        let dy = to.y - self.pos.y;
+        let len = dx.hypot(dy);
+        if len > 1e-9 {
+            self.tangent = Some(Point2::new(dx / len, dy / len));
+        } else if (to.z - self.pos.z).abs() > 1e-9 {
+            self.tangent = None;
+        }
+        self.current.push_move(b.line, kind, to, feed);
+        self.pos = to;
+    }
+
+    /// `M140 MB MAX` retracts to the configured traverse end; `M140 MB n` by n mm.
+    pub fn m140(&mut self, b: &Block, mb: Option<Mb>) -> Result<(), GcodeError> {
+        let z =
+            match mb {
+                Some(Mb::Max) => self.opts.tool_axis_max_z.ok_or_else(|| {
+                    GcodeError::MissingReferencePosition {
+                        line: b.line,
+                        code: format!("{}M140 MB MAX (KlartextOptions::tool_axis_max_z)", b.tag()),
+                    }
+                })?,
+                Some(Mb::Dist(d)) if d >= 0.0 => check_len(b.line, "M140 MB", self.pos.z + d)?,
+                Some(Mb::Dist(d)) => {
+                    return Err(
+                        b.unsupported("M140 MB", &format!("a negative retract ({d}) is not read"))
+                    );
+                }
+                None => return Err(b.syntax("M140 needs MB MAX or MB <distance>")),
+            };
+        if z < self.pos.z {
+            return Err(b.unsupported(
+                "M140 MB MAX",
+                &format!(
+                    "the traverse end Z {z} is below the tool position Z {}",
+                    self.pos.z
+                ),
+            ));
+        }
+        let to = Point3::new(self.pos.x, self.pos.y, z);
+        self.sync_section();
+        self.push_line(b, MoveKind::Rapid, to, None);
+        Ok(())
+    }
+}
+
+fn reject_arc_words(b: &Block, w: &Words, what: &str) -> Result<(), GcodeError> {
+    if w.ccw.is_some() || w.radius.is_some() {
+        return Err(b.syntax(&format!("{what} takes no DR and no R radius")));
+    }
+    Ok(())
+}
diff --git a/crates/gcode/src/klartext/source.rs b/crates/gcode/src/klartext/source.rs
new file mode 100644
index 0000000000..e78bccbef5
--- /dev/null
+++ b/crates/gcode/src/klartext/source.rs
@@ -0,0 +1,219 @@
+//! Klartext source splitting: physical lines into numbered blocks, `~` continuation lines, `;` comments, word tokens and literal numbers.
+//! Provenance: HEIDENHAIN iTNC 530 conversational user's manual 533 190-22 (block layout, `~` continuation, `;` comments) as summarized in docs/research/heidenhain/, and CamCraft's own Klartext post output (assets/posts/heidenhain-klartext.cps).
+
+use crate::types::GcodeError;
+
+/// One logical Klartext block: a numbered line plus its `~` continuation lines.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Block {
+    /// 1-based physical line where the block starts.
+    pub line: usize,
+    /// The block number written at the start of the line, if any.
+    pub number: Option<u64>,
+    /// Upper-case word tokens without comments; a quoted token keeps its quotes and case.
+    pub words: Vec<String>,
+}
+
+impl Block {
+    /// "block N: " for a numbered block, empty otherwise. Refusals start with it.
+    pub fn tag(&self) -> String {
+        match self.number {
+            Some(n) => format!("block {n}: "),
+            None => String::new(),
+        }
+    }
+
+    pub fn unsupported(&self, code: &str, why: &str) -> GcodeError {
+        GcodeError::UnsupportedCode {
+            line: self.line,
+            code: code.to_string(),
+            reason: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn syntax(&self, why: &str) -> GcodeError {
+        GcodeError::Syntax {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn unknown(&self, word: &str) -> GcodeError {
+        GcodeError::UnknownWord {
+            line: self.line,
+            word: format!("{}{word}", self.tag()),
+        }
+    }
+
+    pub fn invalid_arc(&self, why: &str) -> GcodeError {
+        GcodeError::InvalidArc {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn invalid_cycle(&self, why: &str) -> GcodeError {
+        GcodeError::InvalidCycle {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn invalid_modal(&self, why: &str) -> GcodeError {
+        GcodeError::InvalidModal {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+}
+
+/// Split a Klartext program into logical blocks. Blank and comment-only lines
+/// give no block. Returns the blocks and the count of physical lines.
+pub fn split_blocks(program: &str) -> Result<(Vec<Block>, usize), GcodeError> {
+    let mut blocks = Vec::new();
+    let mut pending: Option<(usize, String)> = None;
+    let mut count = 0;
+    for (idx, raw) in program.lines().enumerate() {
+        let line = idx + 1;
+        count = line;
+        let mut text = raw.trim();
+        let cont = text.ends_with('~');
+        if cont {
+            text = text[..text.len() - 1].trim_end();
+        }
+        let code = strip_comment(text);
+        let (start, mut buf) = pending.take().unwrap_or((line, String::new()));
+        buf.push(' ');
+        buf.push_str(code);
+        if cont {
+            pending = Some((start, buf));
+            continue;
+        }
+        if let Some(b) = make_block(start, &buf)? {
+            blocks.push(b);
+        }
+    }
+    if let Some((start, _)) = pending {
+        return Err(GcodeError::Syntax {
+            line: start,
+            message:
+                "the block ends with '~' but no continuation line follows (truncated program?)"
+                    .to_string(),
+        });
+    }
+    Ok((blocks, count))
+}
+
+/// The text before the first `;` that is not inside double quotes.
+fn strip_comment(text: &str) -> &str {
+    let mut quoted = false;
+    for (i, c) in text.char_indices() {
+        match c {
+            '"' => quoted = !quoted,
+            ';' if !quoted => return &text[..i],
+            _ => {}
+        }
+    }
+    text
+}
+
+fn make_block(line: usize, text: &str) -> Result<Option<Block>, GcodeError> {
+    let mut words = tokenize(line, text)?;
+    let mut number = None;
+    if let Some(first) = words.first()
+        && !first.is_empty()
+        && first.bytes().all(|b| b.is_ascii_digit())
+    {
+        let n = first.parse::<u64>().map_err(|_| GcodeError::Syntax {
+            line,
+            message: format!("block number '{first}' is too large"),
+        })?;
+        number = Some(n);
+        words.remove(0);
+    }
+    // A structure block (`* - text`) is a comment.
+    if words.is_empty() || words[0].starts_with('*') {
+        return Ok(None);
+    }
+    Ok(Some(Block {
+        line,
+        number,
+        words,
+    }))
+}
+
+/// Split on white space; a double-quoted run is one token (quotes and case kept).
+fn tokenize(line: usize, text: &str) -> Result<Vec<String>, GcodeError> {
+    let mut out = Vec::new();
+    let mut cur = String::new();
+    let mut quoted = false;
+    for c in text.chars() {
+        if quoted {
+            cur.push(c);
+            if c == '"' {
+                quoted = false;
+            }
+        } else if c == '"' {
+            cur.push(c);
+            quoted = true;
+        } else if c.is_whitespace() {
+            if !cur.is_empty() {
+                out.push(std::mem::take(&mut cur));
+            }
+        } else {
+            cur.extend(c.to_uppercase());
+        }
+    }
+    if quoted {
+        return Err(GcodeError::Syntax {
+            line,
+            message: "unterminated '\"' in the block".to_string(),
+        });
+    }
+    if !cur.is_empty() {
+        out.push(cur);
+    }
+    Ok(out)
+}
+
+/// A literal Klartext number: an optional sign, digits and one optional decimal
+/// point (`+10`, `-2.5`, `.5`). No exponent, no `inf`/`nan`; the value is finite.
+pub fn literal(tok: &str) -> Option<f64> {
+    let body = tok.strip_prefix(['+', '-']).unwrap_or(tok);
+    let mut digits = 0usize;
+    let mut points = 0usize;
+    for b in body.bytes() {
+        match b {
+            b'0'..=b'9' => digits += 1,
+            b'.' => points += 1,
+            _ => return None,
+        }
+    }
+    if digits == 0 || points > 1 {
+        return None;
+    }
+    tok.parse::<f64>().ok().filter(|v| v.is_finite())
+}
+
+/// A Q parameter reference `Q5`, `+Q5` or `-Q5`: the index and the sign.
+pub fn q_ref(tok: &str) -> Option<(u32, f64)> {
+    let (sign, body) = match tok.as_bytes().first() {
+        Some(b'-') => (-1.0, &tok[1..]),
+        Some(b'+') => (1.0, &tok[1..]),
+        _ => (1.0, tok),
+    };
+    let idx = q_index(body)?;
+    Some((idx, sign))
+}
+
+/// Highest Q parameter index of the iTNC 530 (Q0 to Q1999).
+pub const MAX_Q: u32 = 1999;
+
+/// The index of a `Q<n>` token, with `n` in 0..=[`MAX_Q`].
+pub fn q_index(tok: &str) -> Option<u32> {
+    let digits = tok.strip_prefix('Q')?;
+    if digits.is_empty() || digits.len() > 4 || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse::<u32>().ok().filter(|n| *n <= MAX_Q)
+}
