+"{head}: '{to}' holds the part turned X {x}°, Y {y}°, Z {z}° from how '{from}' holds it, and {e}" = "{head}：'{to}' 夹持零件时相对原方式旋转了 X {x}°、Y {y}°、Z {z}°（原方式为 '{from}'），且 {e}"
