  "title": "fix(adaptive): read the bore's star cell through offset rounding noise",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
