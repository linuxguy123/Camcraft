diff --git a/crates/post/tests/mach3_post.rs b/crates/post/tests/mach3_post.rs
new file mode 100644
index 0000000000..b97a962c2a
--- /dev/null
+++ b/crates/post/tests/mach3_post.rs
@@ -0,0 +1,91 @@
+//! Tests for Mach3 postprocessor (issue #4148):
+//! sequence-number limits, header path mode G64, and dialect conventions.
+
+use camcraft_post::post::engine;
+use serde_json::json;
+use std::path::{Path, PathBuf};
+
+fn repo(rel: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../")
+        .join(rel)
+}
+
+fn read(rel: &str) -> String {
+    std::fs::read_to_string(repo(rel)).unwrap_or_else(|e| panic!("{rel}: {e}"))
+}
+
+fn mach3_post() -> String {
+    read("assets/posts/mach3.cps")
+}
+
+fn default_vmc() -> serde_json::Value {
+    serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("vmc machine json")
+}
+
+const SIMPLE_STREAM: &str = "\
+PARAM WorkOffset 1
+PARAM ClearancePlane 25
+PARAM RetractPlane 5
+TOOL 1 \"FLAT ENDMILL\"
+PARAM ToolKind Flat Endmill
+PARAM ToolDiameter 10
+PARAM SpindleSpeed 8000
+SECTION Simple
+Rapid X 0 Y 0 Z 10
+Feed X 10 Y 0 Z 0 F 500
+Feed X 20 Y 0 Z 0 F 500
+ENDSECTION
+";
+
+#[test]
+fn mach3_header_writes_g64_path_mode() {
+    let cps = mach3_post();
+    let mch = default_vmc();
+    let out = engine::run(&cps, &mch, SIMPLE_STREAM).expect("mach3 runs");
+    assert!(out.warnings.is_empty(), "warnings: {:?}", out.warnings);
+    let header_line = out
+        .program
+        .lines()
+        .find(|l| l.contains("G90") && l.contains("G91.1"))
+        .expect("modal header line");
+    assert!(
+        header_line.split_whitespace().any(|w| w == "G64"),
+        "Mach3 header must include G64 path mode: {header_line}"
+    );
+}
+
+#[test]
+fn mach3_sequence_numbers_cap_and_refuse_over_99999() {
+    let cps = mach3_post();
+    let mch = default_vmc();
+
+    // Within limit: N99990, N99995
+    let ok_opts = json!({
+        "showSequenceNumbers": "every-block",
+        "sequenceNumberStart": 99990,
+        "sequenceNumberIncrement": 5
+    });
+    let out_ok = engine::run_with(&cps, &mch, SIMPLE_STREAM, &ok_opts).expect("posts");
+    assert!(out_ok.warnings.is_empty(), "{:?}", out_ok.warnings);
+    assert!(out_ok.program.contains("N99990"), "{}", out_ok.program);
+    assert!(out_ok.program.contains("N99995"), "{}", out_ok.program);
+
+    // Exceeds 99999 limit: refuses by name and does not emit 6-digit N word
+    let over_opts = json!({
+        "showSequenceNumbers": "every-block",
+        "sequenceNumberStart": 99995,
+        "sequenceNumberIncrement": 10
+    });
+    let out_over = engine::run_with(&cps, &mch, SIMPLE_STREAM, &over_opts).expect("posts");
+    assert!(
+        out_over.warnings.iter().any(|w| w.contains("exceeds Mach3 5-digit N99999 limit")),
+        "must refuse sequence numbers exceeding 99999: {:?}",
+        out_over.warnings
+    );
+    assert!(
+        !out_over.program.lines().any(|l| l.starts_with("N100005")),
+        "must not emit 6-digit sequence number: {}",
+        out_over.program
+    );
+}
diff --git a/crates/post/tests/mach4_post.rs b/crates/post/tests/mach4_post.rs
index af9ffe73df..75daf78aa4 100644
--- a/crates/post/tests/mach4_post.rs
+++ b/crates/post/tests/mach4_post.rs
@@ -281,3 +281,32 @@ fn mach4_supported_cycle_dwells_use_seconds_on_g82_and_g89_only() {
         );
     }
 }
+
+#[test]
+fn mach4_smoothing_request_emits_operator_notification_comment() {
+    let cps = mach4_post();
+    let mch = default_vmc();
+    let stream = "\
+PARAM WorkOffset 1
+PARAM ClearancePlane 25
+PARAM RetractPlane 5
+PARAM Smoothing 0.01
+PARAM SmoothingMode finish
+TOOL 1 \"10MM 4FL EM\"
+PARAM ToolKind Flat Endmill
+PARAM ToolDiameter 10
+PARAM SpindleSpeed 8000
+SECTION SmoothSection
+Rapid X 0 Y 0 Z 10
+Feed X 10 Y 0 Z 0 F 500
+ENDSECTION
+";
+    let out = engine::run(&cps, &mch, stream).expect("posts");
+    assert!(out.warnings.is_empty(), "warnings: {:?}", out.warnings);
+    assert!(
+        out.program.contains("(SMOOTHING NOT WRITTEN - MACH3 G64 HAS NO TOLERANCE)"),
+        "Mach4 must emit smoothing notice comment matching Mach3:\n{}",
+        out.program
+    );
+}
+

