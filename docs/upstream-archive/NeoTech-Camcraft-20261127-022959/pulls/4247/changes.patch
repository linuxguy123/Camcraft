diff --git a/docs/decisions/4101-build-step-stall.md b/docs/decisions/4101-build-step-stall.md
new file mode 100644
index 0000000000..85f53c637c
--- /dev/null
+++ b/docs/decisions/4101-build-step-stall.md
@@ -0,0 +1,36 @@
+# #4101: a build step gets the longer stall time
+
+The v0.27.0 cut gate stopped at its step [01] "debug build (--no-run)".
+Three cold `rust-lld` links of the `camcraft-ui` test binaries wrote no
+output for 15 minutes, and the stall watchdog killed the step. No test ran.
+
+## Decision
+
+- **Chosen: option 1 of the issue.** `watchdog::limit_for` gives a build
+  step the same longer limit (`SLOW_FACTOR`, 4x) that a `--release` or
+  `--ignored` step already gets. A build step is a `cargo test` step with
+  `--no-run`, or a `cargo build` step. With the default of 15 minutes, a
+  build step can be silent for 60 minutes. The plan line now says
+  "4x for --release, --ignored and build steps".
+- **Why:** a build step is a build, not a test. A link is silent by its
+  nature, and a cold link of a large test binary on a loaded runner can
+  take longer than a debug test step. A real hang of a build is rare, and
+  the 60-minute limit still ends it, below the 75-minute stop of the batch
+  step.
+- **Only the subcommand counts.** A test binary that is named `build`
+  (`--test build`) is not a build step.
+- **Clippy keeps the base time.** It checks and does not link, and it
+  writes a line for each crate.
+- **Dropped: option 2** (count the CPU time of the child processes as
+  progress). It is a better signal, but it needs a CPU-time reader for each
+  platform (`ps` and `Win32_Process`) and its own tests. It can come later
+  if a 60-minute silent link occurs.
+- **Dropped: option 3** (`CAMCRAFT_GATE_STALL_MIN` in `cut.yml`). It is a
+  workaround, and it also makes each test step wait longer before it is
+  stopped.
+
+## Not proven here
+
+The "Done means" of the issue asks for a cold release-tier gate on the cut
+runner that passes step [01]. Only a cut runner can show that. The unit
+test `build_steps_get_the_longer_stall_time` pins the limit.
diff --git a/xtask/src/watchdog.rs b/xtask/src/watchdog.rs
index 53f1ff5da7..38e37976e1 100644
--- a/xtask/src/watchdog.rs
+++ b/xtask/src/watchdog.rs
@@ -12,7 +12,9 @@ use std::time::{Duration, Instant};
 pub const ENV: &str = "CAMCRAFT_GATE_STALL_MIN";
 /// The stall time of a debug step, in minutes, when the environment does not set one.
 pub const DEFAULT_MIN: u64 = 15;
-/// A `--release` or `--ignored` step (a release link, a heavy test) may be quiet longer: this many times the stall time.
+/// A `--release` or `--ignored` step (a release link, a heavy test) and a build step (`--no-run` or
+/// `cargo build`: a cold link of a large test binary writes nothing for minutes, #4101) may be quiet
+/// longer: this many times the stall time.
 pub const SLOW_FACTOR: u64 = 4;
 /// The start of the log line that the watchdog writes when it kills a step. It starts with `error:`, so
 /// `--failed` selects the step again (`select::log_failed`).
@@ -23,7 +25,7 @@ pub const EXIT: i32 = 3;
 /// The stall time in minutes from the environment value, and a line for the plan output. A bad value
 /// uses the default and says so, as `budget::from_cpu_value` does for `CAMCRAFT_GATE_JOBS`.
 pub fn from_value(v: Option<&str>) -> (u64, String) {
-    let tail = format!("({}x for --release and --ignored steps)", SLOW_FACTOR);
+    let tail = format!("({}x for --release, --ignored and build steps)", SLOW_FACTOR);
     match v.map(str::trim) {
         None | Some("") => (DEFAULT_MIN, format!("gate stall watchdog: {DEFAULT_MIN} min with no step output {tail}; source: default")),
         Some(s) => match s.parse::<u64>() {
@@ -41,9 +43,11 @@ pub fn from_env() -> (u64, String) {
     from_value(std::env::var(ENV).ok().as_deref())
 }
 
-/// The stall time of a step with `args` when the base stall time is `minutes`.
+/// The stall time of a step with `args` when the base stall time is `minutes`. A build step is a
+/// build, not a test: its links can be silent longer than a debug test step (#4101).
 pub fn limit_for(args: &[String], minutes: u64) -> Duration {
-    let slow = args.iter().any(|a| a == "--release" || a == "--ignored");
+    let build = args.first().is_some_and(|a| a == "build") || args.iter().any(|a| a == "--no-run");
+    let slow = build || args.iter().any(|a| a == "--release" || a == "--ignored");
     let m = if slow { minutes.saturating_mul(SLOW_FACTOR) } else { minutes };
     Duration::from_secs(m.saturating_mul(60))
 }
diff --git a/xtask/src/watchdog_tests.rs b/xtask/src/watchdog_tests.rs
index 35dc40862e..5f165374cb 100644
--- a/xtask/src/watchdog_tests.rs
+++ b/xtask/src/watchdog_tests.rs
@@ -223,6 +223,24 @@ fn release_and_ignored_steps_get_the_longer_stall_time() {
     assert_eq!(watchdog::limit_for(&args(&["--release"]), u64::MAX), Duration::from_secs(u64::MAX), "no overflow");
 }
 
+/// #4101: a build step (a quick or batch gate's `--no-run` build, a `cargo build`) is a build, not a
+/// test - a cold link of a large test binary can be silent past the debug stall time - so it gets the
+/// longer stall time too. A debug test step, and clippy, keep the base time.
+#[test]
+fn build_steps_get_the_longer_stall_time() {
+    let args = |a: &[&str]| a.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+    let long = Duration::from_secs(15 * watchdog::SLOW_FACTOR * 60);
+    let build = ["test", "-j", "4", "-p", "camcraft-ui", "--no-run", "--lib"];
+    assert_eq!(watchdog::limit_for(&args(&build), 15), long, "the quick gate's ui build");
+    assert_eq!(watchdog::limit_for(&args(&["build", "-p", "camcraft-app", "--bin", "camcraft-cli"]), 15), long);
+    assert_eq!(watchdog::limit_for(&args(&["test", "-p", "camcraft-ui", "--lib"]), 15), Duration::from_secs(15 * 60));
+    assert_eq!(watchdog::limit_for(&args(&["clippy", "-p", "camcraft-ui", "--all-targets"]), 15), Duration::from_secs(15 * 60));
+    // A test binary named `build` is not a build step: only the subcommand counts.
+    assert_eq!(watchdog::limit_for(&args(&["test", "-p", "x", "--test", "build"]), 15), Duration::from_secs(15 * 60));
+    let (_, line) = watchdog::from_value(None);
+    assert!(line.contains("--release, --ignored and build steps"), "the plan line names the build steps: {line}");
+}
+
 #[test]
 fn a_stall_has_its_own_row_and_exit_code() {
     assert_eq!(crate::exec::row(true, false), "ok");
