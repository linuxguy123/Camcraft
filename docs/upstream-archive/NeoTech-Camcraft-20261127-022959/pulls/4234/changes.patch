     let (controlled, cs) = live(p.load.control(os, &region, c.reader.as_ref(), &c.recipe.load(), tool_r)?)?;
     let cuts = cs.set().curves().iter().map(|cv| Cut::new(cv.clone(), None)).collect::<Result<Vec<_>, _>>()?;
