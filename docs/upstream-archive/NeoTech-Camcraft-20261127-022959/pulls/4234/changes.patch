         let rev: Vec<PlanePoint> = self.pts.iter().rev().copied().collect();
         let matches = |seq: &[PlanePoint], s: usize| (0..n).all(|j| seq[(s + j) % n].near(&other.pts[j]));
         let starts = if self.closed { n } else { 1 };
