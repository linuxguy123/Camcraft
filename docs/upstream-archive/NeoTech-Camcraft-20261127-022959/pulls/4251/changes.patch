             rows.push(PickerRow::Entry(e));
             continue;
         };
-        let row = rows.iter_mut().find_map(|r| match (kind, r) {
-            (Kind::Weldon, PickerRow::Weldon { taper, bores }) | (Kind::Shrink, PickerRow::Shrink { taper, bores })
