diff --git a/crates/pathkernel/tests/laws/load_stage.rs b/crates/pathkernel/tests/laws/load_stage.rs
new file mode 100644
index 000000000..46aa6c3a1
--- /dev/null
+++ b/crates/pathkernel/tests/laws/load_stage.rs
@@ -0,0 +1,201 @@
+//! The K3 pins (#4026): the kernel's load stage, registered with the law
+//! kit and run with the ring planner of K2 and the order and link stages
+//! of K4, on the disc pocket, the pocket with an island and a pocket of
+//! two lobes joined by a neck (a full-width stretch). For each mode: None
+//! names every cut above the limit and keeps the curves; constant
+//! engagement leaves no unnamed cut above the limit and states the worst
+//! one; trochoidal leaves no full-width feed in the marked stretch. The
+//! negative pins: an unnamed cut above the limit, a limit that is not a
+//! number or not above 0, the stock reach, and a stretch with no room for
+//! a loop (named, never out of the area).
+
+use camcraft_pathkernel::entry::{EntryChoice, EntryKind};
+use camcraft_pathkernel::guide::{GuideChoice, GuidePlanner, MarkKind, RingPlanner, RingRef, RingsChoice, Span};
+use camcraft_pathkernel::link::{LinkPolicy, LinkStage};
+use camcraft_pathkernel::load::{
+    BAD_LOAD, Controlled, LoadControl, LoadPlanner, LoadStage, NO_CONTROL, NO_ROOM, PLAN_TOL, Reach, Reading, STOCK_REACH_ELSEWHERE, Trochoid,
+    UNNAMED_OVERLOAD,
+};
+use camcraft_pathkernel::order::{OrderChoice, OrderPlanner, OrderStage};
+use camcraft_pathkernel::{AxisControl, KernelRegion, Loop, MaterialSide, Point2, Recipe, Refusal, Region, WorkPlane};
+
+use super::grid::walk;
+use super::guide_kit::{outline, pocket, rect};
+use super::kit::{Case, Planners, Run, assert_held, dist, outside, planar, poly, poly_dist, run};
+use super::l6_load::check_l6;
+use super::order_link::{disc, stock_box};
+use super::standins::{ProvedEntry, ShapeReader, island_region, sq};
+
+fn area(pts: Vec<Point2>) -> Region {
+    Region::new(vec![Loop::new(pts).unwrap()]).unwrap()
+}
+
+/// Two 20 x 20 lobes joined by a neck 6 mm wide and 12 mm long.
+fn neck(_m: MaterialSide) -> Result<KernelRegion, Refusal> {
+    Ok(pocket(outline(&[rect(-26.0, -10.0, -6.0, 10.0), rect(6.0, -10.0, 26.0, 10.0), rect(-7.0, -3.0, 7.0, 3.0)]), vec![], 2.0))
+}
+
+/// A slot 4.1 mm wide for a tool of radius 2: no room for a loop.
+fn slot(_m: MaterialSide) -> Result<KernelRegion, Refusal> {
+    Ok(pocket(rect(-15.0, -2.05, 15.0, 2.05), vec![], 2.0))
+}
+
+fn recipe(step: f64, load: LoadControl) -> Recipe {
+    let guide = GuideChoice::Rings(RingsChoice::new(RingRef::Boundary, 0.0, step, None, None).unwrap());
+    let entry = EntryChoice::new(EntryKind::Helix, 2.0, vec![]).unwrap();
+    Recipe::new(WorkPlane::setup_xy(0.0).unwrap(), AxisControl::Normal, guide, load, OrderChoice::default(), LinkPolicy::StayWhereProved, entry).unwrap()
+}
+
+/// One fixture: its name, region, ring step and nominal load (step / D), and its stock.
+struct Fixture {
+    name: &'static str,
+    region: fn(MaterialSide) -> Result<KernelRegion, Refusal>,
+    step: f64,
+    load: f64,
+    stock: Region,
+}
+
+fn fixtures() -> Vec<Fixture> {
+    vec![
+        Fixture { name: "disc pocket", region: disc, step: 2.0, load: 0.25, stock: stock_box() },
+        Fixture { name: "pocket with an island", region: island_region, step: 0.8, load: 0.2, stock: Region::new(vec![sq(0.0, 0.0, 30.0).unwrap()]).unwrap() },
+        Fixture { name: "two lobes and a neck", region: neck, step: 1.6, load: 0.4, stock: area(rect(-30.0, -15.0, 30.0, 15.0)) },
+    ]
+}
+
+fn case(f: &Fixture, load: LoadControl) -> Case {
+    let reader = Box::new(ShapeReader(f.stock.clone()));
+    Case { name: f.name, region: f.region, material: MaterialSide::Inside, recipe: recipe(f.step, load), stock: f.stock.clone(), reader, no_split: false, recorded: None }
+}
+
+/// The kernel stages with the load stage that states `limit`.
+fn kernel(limit: f64) -> Planners {
+    Planners {
+        guide: Box::new(RingPlanner),
+        order: Box::new(OrderStage),
+        load: Box::new(LoadStage::new(limit).unwrap()),
+        link: Box::new(LinkStage),
+        entry: Box::new(ProvedEntry),
+    }
+}
+
+/// The reads of a run on the check grid above `cap`: (all, unnamed), and the worst.
+fn over(r: &Run, c: &Case, cap: f64) -> (usize, usize, f64) {
+    let ctl = r.controlled.out().unwrap();
+    let tool_r = planar(&r.region).unwrap().tool().radius();
+    let w = walk(&r.plan, &c.stock, tool_r).unwrap();
+    let hot: Vec<_> = w.cuts.iter().filter(|k| k.load > cap).collect();
+    let unnamed = hot.iter().filter(|k| !ctl.over().iter().any(|o| dist(o.at(), k.at) <= tool_r)).count();
+    (hot.len(), unnamed, w.cuts.iter().map(|k| k.load).fold(0.0, f64::max))
+}
+
+fn notes(r: &Run) -> Vec<String> {
+    match &r.controlled {
+        camcraft_pathkernel::Verdict::Done { notes, .. } => notes.iter().map(|n| n.text().to_string()).collect(),
+        _ => vec![],
+    }
+}
+
+/// Each curve of the controlled set is read: the clean-up rings too (#3849).
+fn each_curve_read(ctl: &Controlled) -> bool {
+    ctl.set().curves().iter().all(|c| ctl.readings().iter().any(|rd| poly_dist(rd.at(), &poly(c)) <= 1e-6))
+}
+
+#[test]
+fn k3_none_keeps_the_curves_and_names_every_cut_above_the_limit() {
+    for f in fixtures() {
+        let c = case(&f, LoadControl::None);
+        let r = run(&kernel(f.load), &c, Default::default()).unwrap();
+        let ctl = r.controlled.out().unwrap();
+        assert_eq!(ctl.set(), r.ordered.out().unwrap(), "{}: None is the identity", f.name);
+        assert!(each_curve_read(ctl), "{}: each curve is read", f.name);
+        let (hot, unnamed, worst) = over(&r, &c, f.load * (1.0 + PLAN_TOL));
+        eprintln!("{} None: {} records, {hot} hot reads ({unnamed} unnamed), worst {worst:.3}; {:?}", f.name, ctl.over().len(), notes(&r));
+        assert!(ctl.over().iter().all(|o| o.reason() == NO_CONTROL), "{}", f.name);
+        assert!(!ctl.over().is_empty() && !notes(&r).is_empty(), "{}: the first ring is a full-width cut, named on the status line", f.name);
+        assert_held(&check_l6(&Ok(r), &c));
+    }
+}
+
+#[test]
+fn k3_constant_engagement_leaves_no_unnamed_cut_above_the_limit() {
+    for f in fixtures() {
+        let ce = case(&f, LoadControl::constant(f.load, Reach::Rings).unwrap());
+        let none = case(&f, LoadControl::None);
+        let (a, b) = (run(&kernel(f.load), &none, Default::default()).unwrap(), run(&kernel(f.load), &ce, Default::default()).unwrap());
+        let cap = f.load * (1.0 + PLAN_TOL);
+        let (hot0, _, worst0) = over(&a, &none, cap);
+        let (hot1, unnamed, worst1) = over(&b, &ce, cap);
+        let ctl = b.controlled.out().unwrap();
+        let (n0, n1) = (a.controlled.out().unwrap().set().curves().len(), ctl.set().curves().len());
+        eprintln!("{}: None {n0} curves, {hot0} hot reads, worst {worst0:.3}; constant engagement {n1} curves, {hot1} hot reads ({unnamed} unnamed), worst {worst1:.3}", f.name);
+        for n in notes(&b) {
+            eprintln!("  {n}");
+        }
+        assert!(each_curve_read(ctl), "{}: each curve is read", f.name);
+        assert!(hot1 <= hot0, "{}: constant engagement does not add load", f.name);
+        assert!(ctl.over().is_empty() || notes(&b).iter().any(|n| n.contains("the worst")), "{}: the worst cut is stated", f.name);
+        assert_held(&check_l6(&Ok(b), &ce));
+    }
+}
+
+#[test]
+fn k3_trochoidal_leaves_no_full_width_feed_in_the_marked_stretch() {
+    let f = &fixtures()[2];
+    let region = neck(MaterialSide::Inside).unwrap();
+    let gs = RingPlanner.guide(&region, &recipe(f.step, LoadControl::None).guide(), 1e-3).unwrap().out().unwrap().clone();
+    let stretch: Vec<Point2> = gs
+        .marks()
+        .iter()
+        .filter(|m| m.kind() == MarkKind::FullWidth)
+        .flat_map(|m| match m.span() {
+            Span::Part(pts) => pts.iter().map(|q| q.at()).collect::<Vec<_>>(),
+            Span::Whole => poly(&gs.curves()[m.curve()]),
+        })
+        .collect();
+    assert!(!stretch.is_empty(), "the neck has a full-width stretch");
+    let c = case(f, LoadControl::Trochoidal(Trochoid::new(2.0, 0.8).unwrap()));
+    let r = run(&kernel(f.load), &c, Default::default()).unwrap();
+    let tool_r = planar(&r.region).unwrap().tool().radius();
+    let w = walk(&r.plan, &c.stock, tool_r).unwrap();
+    let in_stretch: Vec<_> = w.cuts.iter().filter(|k| poly_dist(k.at, &stretch) <= 0.5).collect();
+    let worst = in_stretch.iter().map(|k| k.load).fold(0.0, f64::max);
+    eprintln!("trochoidal: {} reads in the stretch, worst {worst:.3}; {:?}", in_stretch.len(), notes(&r));
+    assert!(!in_stretch.is_empty());
+    assert!(worst < 0.99, "no full-width feed in the marked stretch: {worst}");
+    let center = planar(&r.region).unwrap().center().clone();
+    for cv in r.controlled.out().unwrap().set().curves() {
+        assert!(poly(cv).iter().all(|q| outside(&center, *q) <= 1e-6), "each loop stays in the cutter-centre area");
+    }
+    assert_held(&check_l6(&Ok(r), &c));
+}
+
+#[test]
+fn k3_a_stretch_with_no_room_for_a_loop_stays_and_is_named() {
+    let f = Fixture { name: "slot", region: slot, step: 0.1, load: 0.4, stock: area(rect(-20.0, -5.0, 20.0, 5.0)) };
+    let c = case(&f, LoadControl::Trochoidal(Trochoid::new(2.0, 0.8).unwrap()));
+    let r = run(&kernel(f.load), &c, Default::default()).unwrap();
+    let ctl = r.controlled.out().unwrap();
+    assert_eq!(ctl.set(), r.ordered.out().unwrap(), "no loop fits: the curves stay");
+    assert!(ctl.over().iter().any(|o| o.reason() == NO_ROOM), "the full-width slot is named: {:?}", ctl.over().first());
+    assert_held(&check_l6(&Ok(r), &c));
+}
+
+#[test]
+fn k3_an_unnamed_cut_above_the_limit_and_a_bad_limit_are_refused() {
+    let f = &fixtures()[0];
+    let region = disc(MaterialSide::Inside).unwrap();
+    let gs = RingPlanner.guide(&region, &recipe(f.step, LoadControl::None).guide(), 1e-3).unwrap().out().unwrap().clone();
+    let os = OrderStage.order(gs, &region, &OrderChoice::default(), None).unwrap().out().unwrap().clone();
+    let hot = vec![Reading::new(Point2::new(0.0, 0.0), 1.0).unwrap()];
+    assert_eq!(Controlled::new(os.clone(), hot, vec![], 0.25).unwrap_err().reason(), UNNAMED_OVERLOAD);
+    for bad in [f64::NAN, -0.1, 0.0, 1.5] {
+        assert_eq!(LoadStage::new(bad).unwrap_err().reason(), BAD_LOAD, "{bad}");
+        assert_eq!(LoadControl::constant(bad, Reach::Rings).unwrap_err().reason(), BAD_LOAD, "{bad}");
+    }
+    let reader = ShapeReader(stock_box());
+    let stage = LoadStage::default();
+    let stock = LoadControl::constant(0.25, Reach::Stock).unwrap();
+    assert_eq!(stage.control(os.clone(), &region, &reader, &stock, 4.0).unwrap_err().reason(), STOCK_REACH_ELSEWHERE);
+    assert!(stage.control(os, &region, &reader, &LoadControl::None, f64::NAN).is_err(), "a tool radius that is not a number");
+}
diff --git a/docs/decisions/4026-kernel-load-control.md b/docs/decisions/4026-kernel-load-control.md
new file mode 100644
index 000000000..54c114c64
--- /dev/null
+++ b/docs/decisions/4026-kernel-load-control.md
@@ -0,0 +1,134 @@
+## #4026 - Path kernel K3: the load control stage
+
+Stage 3 (load control) of the K0 record (`## #4024` in `RECOMMENDED.md`).
+Sub-PR of `side/path-kernel`, on top of K4 (#4177). No old planner changes
+and no planner calls the new code yet: with the default switch the output
+is identical.
+
+**What was decided**
+
+1. **Files.** `crates/pathkernel/src/load/`: `law.rs` (the engagement
+   law), `stage.rs` (`LoadStage`, the planner), `rings.rs` (constant
+   engagement), `trochoid.rs` (trochoidal loops). `load.rs` keeps the
+   types. The kernel still depends on `camcraft-geometry` only; no
+   geometry function was added.
+2. **One law for every mode.** The stage makes a raster of the stock
+   reader (`StockRead`, 20 cells across the tool radius, at most 4
+   million cells; a cell that the reader does not know is material, so a
+   read can only be too high). It walks the curves in the cut order, 8
+   reads across the tool radius, and reads each place before it clears
+   the tool disc there. The read is the contact angle phi on the front
+   half of the cutting edge, as ae/D = (1 - cos phi) / 2 (Altintas 2000;
+   Stori & Wright 2000). The read comes after the tool disc at the place
+   is cleared, three quarters of a cell outside the edge, as the #4154
+   meter reads. The first form read half a cell inside the edge before
+   the clear: the disc of the read before had then cleared the side of
+   the arc, and an outward ring read 54 degrees where the geometry gives
+   64 (the meter of #4154 found 2297 unnamed moves on the disc). The
+   stage does not see the entry (stage 5 comes after it), so the first
+   cut is read without the bore of its entry: it can be named where the
+   entry clears its start. A read can be too high, not too low. Every curve is read, the clean-up rings too: the
+   law of #3849 (PR #4008 checks the clean-up passes as the lanes) holds
+   by construction, because no curve is skipped.
+3. **A stated limit for a choice without one.** `LoadControl::None` and
+   `Trochoidal` carry no engagement. `LoadStage::new(limit)` states the
+   limit that the stage names cuts against; the default is 0.5 (a 90
+   degree contact, the old default trochoid limit). A kind sets it to its
+   planned load (for rings: stepover / D). Dropped: a limit field on
+   `LoadControl::None` (it changes a public type that the other stages
+   and the kit build).
+4. **None is the identity.** The set is the input set (marks included);
+   each read above `limit x (1 + PLAN_TOL)` gets an over-limit record with
+   the reason `NO_CONTROL`, and the verdict has one status line note for
+   each reason (the count, the worst load and its place). `Controlled::new`
+   stays the single gate: an unnamed read above the limit is refused.
+5. **Constant engagement on rings inserts passes.** Where a ring reads
+   above the load, the stage finds the nearest curve cut before it at
+   the hot place. When both are rings of one distance field (the walls of
+   the centre area, or the part walls of a region with a stock edge: the
+   distance of each point agrees within 1 % of the tool radius), it
+   inserts the mid level of that field between them, only the pieces
+   within the gap of the hot ring, turned to run as that ring runs. It
+   reads the plan again, at most 12 rounds and at most 8 times the curves
+   (and 64). An insertion is kept only when it lowers the load of its ring
+   (no hot read left, or the worst excess halved, or a quarter of the hot
+   reads gone); else it is taken out and the ring is named `NOT_FIXED`.
+   That is the sharp corner of offset rings (the #3933 rectangle read
+   93.9 %): more passes do not help there, the corner is named, not
+   hidden, and the note names Adaptive. A ring with no earlier curve
+   within one diameter is `FRESH_CUT` (the first ring of a pocket), a
+   curve that is no ring is `NOT_A_RING`, a gap below 2 x 15 % of the load
+   width is `AT_FLOOR` (the floor of the held #3933 design). A
+   `FullWidth` mark with no hot read left is resolved and removed; a mark
+   that stays is named by its reads.
+   Dropped: the outward spiral and the morph of #3933 (Held & Spielberger
+   2009). A spiral is a link and an entry matter (record: load control
+   adds no link). Dropped too: a new spacing of the whole ladder by the
+   Stori & Wright law (fewer passes than a mid-level insertion, which
+   halves a gap). The insertion reads the true stock at each step, so it
+   is correct for any ring shape; the cost is more passes than an
+   optimal ladder.
+6. **The stock reach stays with the HSM planner.**
+   `ConstantEngagement { reach: Stock }` (Adaptive) is refused by this
+   stage with `STOCK_REACH_ELSEWHERE`: the K0 record revision 2 keeps the
+   HSM planner in `camcraft-motion` behind the load trait. So Offset
+   rings (Rings) and Adaptive (Stock) stay two behaviours, as the
+   maintainer answered (3).
+7. **Trochoidal replaces each full-width stretch.** Each `FullWidth`
+   stretch is cut as loops that walk the stretch itself (#3932: the path
+   follows the contour and does not slot to a wall). A loop is
+   `q + rho n (1 - cos t) + rho d sin t`: it leaves the stretch and comes
+   back to it, one loop a step. Its radius is the room on the side with
+   more room (the largest disc that touches the stretch there and lies in
+   the centre area), at most half the loop width; so a loop cannot leave
+   the area, and a point outside it is refused (`LOOP_LEAVES`). The step
+   is the trochoid pitch, at most the load width of the stated limit
+   (the front arc of a loop cuts about one step: Otkur & Lazoglu 2007,
+   Rauch, Duc & Hascoet 2009). A loop with less room than 5 % of the tool
+   radius is cut as the stretch: where no loop fits, the stretch stays and
+   its reads are named `NO_ROOM`. Reads above the limit on the loops are
+   `LOOPS_OVER`, on other curves `NOT_MARKED`. The marks of a changed
+   curve go (their reads name what stays). A closed curve keeps the
+   start that the order stage gave it.
+   Dropped: a microlift return between loops (a link matter; the kernel's
+   hop is stage 5); the loop sense from climb or conventional (the loop
+   runs forward on the stretch, as the ring runs).
+
+**Readings** (measured, not tuned).
+
+The law suite (`tests/laws/load_stage.rs`; the check grid of the suite
+walks the plan; hot = a read above `load x 1.05`):
+
+| Fixture (load) | None: curves, hot reads, worst | Constant engagement: curves, hot reads (unnamed), worst |
+|---|---|---|
+| disc pocket (0.25) | 4, 3, 0.413 | 9, 0 (0), 0.179 |
+| pocket with an island (0.20) | 12, 286, 0.999 | 29, 146 (0), 0.998 |
+| two lobes and a neck (0.40) | 9, 249, 0.998 | 27, 128 (0), 0.998 |
+
+The island and the neck keep their full-width first rings and their
+sharp corners: named (`FRESH_CUT`, `AT_FLOOR`). Trochoidal on the neck:
+the worst read in the marked stretch is 0.941 (was a full-width 1.0);
+the loops stay in the centre area.
+
+Motion `kernel_laws::k3_load` (the #4154 measures, limit 60 degrees,
+25 % load, the band round the part): feed moves above the limit, the
+worst in degrees, and the moves above the limit with no named place
+within one tool radius.
+
+| Case | Old 2D Pocket | Kernel, None | Kernel, constant engagement |
+|---|---|---|---|
+| disc Inside | 20, 178 | 3507, 173, 0 | 833, 173, 1 |
+| disc Outside | 20, 178 | 402, 145, 13 | 334, 118, 74 |
+| dog bone Inside | 32, 180 | 2587, 173, 0 | 581, 173, 1 |
+| dog bone Outside | 32, 180 | 724, 167, 3 | 678, 143, 66 |
+
+The kernel counts every short move of its dense rings (the old planner
+has fewer, longer moves), so the counts are not one to one. The worst
+Inside (173) is the first ring round the part: full width, named. The
+unnamed moves Outside are on the stock edge line, where a piece starts
+after a lift: there the kernel read and the #4154 meter differ. That is
+follow-up #4260 (P7). The one unnamed move Inside is a link feed (stage 5).
+
+**Cost of a change later.** A new spacing law is one function in
+`rings.rs` behind the same reads. A tool shape other than a disc changes
+only the edge read in `law.rs`.

