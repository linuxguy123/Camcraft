+#[test]
+fn wire_edm_2axis_and_4axis_ruled_cut_like_baked() {
+    let wire_doc = |mesh: Mesh, do_align: bool, baked_mode: bool, four_axis: bool| -> (World, Result<(), String>, Option<Mesh>) {
