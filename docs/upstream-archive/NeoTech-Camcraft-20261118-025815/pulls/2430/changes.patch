+fn mill_turn_milling_ops_match_baked_while_probe_5axis_and_tilt_stay_refused() {
+    let raw = unturn(&stepped_pad());
+    let mill_doc = |mesh: Mesh, do_align: bool| -> (World, Result<(), String>, Option<Mesh>) {
+        let w = new_world();
