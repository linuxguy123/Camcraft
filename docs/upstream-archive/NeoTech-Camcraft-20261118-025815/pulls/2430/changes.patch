+/// Inverse of `TURN` ([90, 0, 90] maps `(y, z, x)` to `(x, y, z)`).
+fn unturn(mesh: &Mesh) -> Mesh {
+    let mv = |p: Point3| Point3::new(p.y, p.z, p.x);
+    Mesh::from_facets(mesh.facets.iter().map(|t| Triangle::new(mv(t.a), mv(t.b), mv(t.c))).collect())
