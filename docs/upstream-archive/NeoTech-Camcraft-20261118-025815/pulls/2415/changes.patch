From 49d8889aebc10185d8e1876e0c39d69f83ada314 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 17 Nov 2026 15:31:11 -0800
Subject: [PATCH] fix(post): refuse unsupported Sinumerik G84 and G85 dwells

Pin positive TAP and REAM stream dwell requests and suppress refused cutting chains.

Fixes #2357

Co-Authored-By: Codex <noreply@openai.com>
---
 assets/posts/sinumerik.cps             |  14 ++-
 crates/post/tests/sinumerik_dwell.rs   | 168 +++++++++++++++++++++++++
 docs/decisions/2357-sinumerik-dwell.md |  32 +++++
 3 files changed, 213 insertions(+), 1 deletion(-)
 create mode 100644 crates/post/tests/sinumerik_dwell.rs
 create mode 100644 docs/decisions/2357-sinumerik-dwell.md

diff --git a/assets/posts/sinumerik.cps b/assets/posts/sinumerik.cps
index 75ac8f71e..45c6c9c89 100644
--- a/assets/posts/sinumerik.cps
+++ b/assets/posts/sinumerik.cps
@@ -739,6 +739,18 @@ function onCycle() {
     msg("canned cycle G73 (peck) dwell is not verified in Sinumerik ISO dialect mode - a " + p.P + " s dwell is refused, not dropped; set the dwell to 0");
     return;
   }
+  // #2357: Siemens ISO dialects Function Manual (07/2021), section 6.3,
+  // table 6-2 lists P on G84, but not G85. This post does not yet support
+  // tapping dwell; refuse it explicitly rather than silently omit it.
+  // Test the requested seconds before rounding to whole milliseconds.
+  if ((g === "G84" || g === "G85") && has(p.P) && p.P > 0) {
+    var reason = g === "G84" ? "G84 (tap) dwell is not supported by this post" : "G85 (ream) has no dwell word in Sinumerik ISO dialect mode";
+    msg("canned cycle " + reason + " - a " + p.P + " s dwell is refused, not dropped; set the dwell to 0");
+    // Keep the refused hole's expanded cuts from falling through to G1.
+    cycX = p.X; cycY = p.Y; cycR = p.R;
+    inCycle = true;
+    return;
+  }
   if (spindleStopped("canned cycle " + g)) return;
   if (!xyFirst(p.X, p.Y, p.R, false)) return;  // #1633: refused - the move is not written
   cycleSeat(p);
@@ -752,7 +764,7 @@ function onCycle() {
   // the control runs in ISO dialect mode. Siemens' "ISO dialects" Function
   // Manual (SINUMERIK ONE / 840D sl / 828D, 07/2021), section 6.3, lists
   // no P in its G73 and G83 formats; an unverified G73 dwell is refused
-  // above (#2354). G84 takes no P here.
+  // above (#2354). G84 and G85 dwells are refused above (#2357).
   if (ms > 0 && g !== "G73" && g !== "G84") words.push("P" + ms);
   words.push(fw(p.FeedRate));
   block(words);
diff --git a/crates/post/tests/sinumerik_dwell.rs b/crates/post/tests/sinumerik_dwell.rs
new file mode 100644
index 000000000..ec7b0cd78
--- /dev/null
+++ b/crates/post/tests/sinumerik_dwell.rs
@@ -0,0 +1,168 @@
+//! #2357: original dwell refusal regressions from Siemens ISO dialects 07/2021 §6.3.
+//! Gate map: covers assets/posts/sinumerik.cps, camcraft_post::post::engine,
+//! camcraft_post::post::cnc.
+
+use camcraft_post::cl::{CycleKind, MoveKind};
+use camcraft_post::post::{
+    cnc::{self, CycleRec, MoveRec, Record},
+    engine,
+};
+use serde_json::json;
+use std::path::Path;
+
+fn read(rel: &str) -> String {
+    std::fs::read_to_string(
+        Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("../../")
+            .join(rel),
+    )
+    .expect("fixture")
+}
+
+fn movement(kind: MoveKind, z: f64, feed: Option<f64>) -> Record {
+    Record::Move(MoveRec {
+        kind,
+        x: 10.0,
+        y: 10.0,
+        z,
+        feed,
+        center: None,
+        ccw: false,
+        plane: Default::default(),
+        abc: None,
+    })
+}
+
+fn stream(kind: CycleKind, dwell: f64) -> String {
+    let records = vec![
+        Record::Param {
+            name: "SpindleSpeed".into(),
+            value: json!(900.0),
+        },
+        Record::Param {
+            name: "ClearancePlane".into(),
+            value: json!(10.0),
+        },
+        Record::Param {
+            name: "RetractPlane".into(),
+            value: json!(10.0),
+        },
+        Record::Tool {
+            number: 4,
+            name: "CYCLE TOOL".into(),
+        },
+        Record::Section { begin: true },
+        movement(MoveKind::Rapid, 2.0, None),
+        Record::Cycle(CycleRec {
+            kind,
+            x: 10.0,
+            y: 10.0,
+            r_z: 2.0,
+            bottom_z: -12.0,
+            entry_z: 0.0,
+            peck: 0.0,
+            dwell,
+            first_move: 1,
+            feed: Some(120.0),
+        }),
+        movement(MoveKind::Feed, -12.0, Some(120.0)),
+        movement(MoveKind::Feed, 2.0, Some(120.0)),
+        movement(MoveKind::Rapid, 10.0, None),
+        Record::Section { begin: false },
+    ];
+    let stream = cnc::serialize(&records);
+    let parsed = cnc::parse(&stream).expect("fixture parses");
+    let cycle = parsed
+        .iter()
+        .find_map(|record| match record {
+            Record::Cycle(cycle) => Some(cycle),
+            _ => None,
+        })
+        .expect("cycle survives serialization");
+    assert_eq!(cycle.kind, kind);
+    assert!(
+        (cycle.dwell - dwell).abs() < 1e-10,
+        "positive TAP/REAM dwell reaches the engine"
+    );
+    stream
+}
+
+fn run(stream: &str) -> engine::PostOutput {
+    let machine = serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("machine");
+    engine::run(&read("assets/posts/sinumerik.cps"), &machine, stream).expect("post engine")
+}
+
+fn has_word(program: &str, word: &str) -> bool {
+    program.split_whitespace().any(|w| w == word)
+}
+
+fn refuses(kind: CycleKind, g: &str) {
+    for dwell in [0.001, 0.25] {
+        let out = run(&stream(kind, dwell));
+        assert!(
+            out.warnings
+                .iter()
+                .any(|w| w.contains(g) && w.contains("dwell")),
+            "{g} dwell {dwell} needs a named refusal: {:?}",
+            out.warnings
+        );
+        assert!(
+            !has_word(&out.program, g),
+            "refused {g} must not be posted:\n{}",
+            out.program
+        );
+        assert!(
+            !has_word(&out.program, "G1"),
+            "refused cycle must not fall back to cuts:\n{}",
+            out.program
+        );
+    }
+    // A hand-authored fractional millisecond must not round silently to zero.
+    let raw = stream(kind, 0.001).replace("P 1 ", "P 0.1 ");
+    let parsed = cnc::parse(&raw).expect("fractional millisecond fixture parses");
+    assert!(parsed.iter().any(|record| matches!(record,
+        Record::Cycle(cycle) if (cycle.dwell - 0.0001).abs() < 1e-10)));
+    let out = run(&raw);
+    assert!(
+        out.warnings
+            .iter()
+            .any(|w| w.contains(g) && w.contains("dwell")),
+        "{g} sub-ms dwell needs a named refusal: {:?}",
+        out.warnings
+    );
+    assert!(
+        !has_word(&out.program, g),
+        "refused sub-ms {g} must not be posted"
+    );
+}
+
+#[test]
+fn sinumerik_g84_dwell_is_refused_by_name() {
+    refuses(CycleKind::Tap, "G84");
+}
+
+#[test]
+fn sinumerik_g85_dwell_is_refused_by_name() {
+    refuses(CycleKind::Ream, "G85");
+}
+
+#[test]
+fn sinumerik_g84_and_g85_without_dwell_still_post() {
+    for (kind, g) in [(CycleKind::Tap, "G84"), (CycleKind::Ream, "G85")] {
+        let out = run(&stream(kind, 0.0));
+        assert!(out.warnings.is_empty(), "{g}: {:?}", out.warnings);
+        let line = out
+            .program
+            .lines()
+            .find(|line| has_word(line, g))
+            .expect("cycle posts");
+        assert!(
+            !line.split_whitespace().any(|word| word.starts_with('P')),
+            "{line}"
+        );
+        assert!(
+            !has_word(&out.program, "G1"),
+            "cycle replaces its expanded cuts"
+        );
+    }
+}
