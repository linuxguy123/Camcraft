+    );
+    let r = h.get_by_label("Cancel").rect();
+    assert!(screen.expand(1.0).contains_rect(r), "Unsaved changes modal: Cancel {r:?} leaves {screen:?}");
+}
+
+fn assert_fixture_modal(cmd: CommandKind, who: &str, anchors: &[&str]) {
+    let mut h = shell_harness();
