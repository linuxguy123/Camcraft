From 1f7b2cbac1e2e080f623934cf498ca9b9b0b2dc7 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Tue, 17 Nov 2026 13:34:34 -0800
Subject: [PATCH] fix(post): refuse unsupported G73 and G84 dwell

Refuse positive dwell requests before seating or reusing a canned cycle.
Pin all four posts, open-group requests, and sub-millisecond input.

Co-Authored-By: OpenAI Codex <noreply@openai.com>

Fixes #2356
---
 assets/posts/doosan-dnm.cps        |   6 +
 assets/posts/fanuc.cps             |   6 +
 assets/posts/haas.cps              |   6 +
 assets/posts/mazak.cps             |   6 +
 crates/post/tests/cycle_dwell.rs   | 191 +++++++++++++++++++++++++++++
 docs/decisions/2356-cycle-dwell.md |  40 ++++++
 6 files changed, 255 insertions(+)
 create mode 100644 crates/post/tests/cycle_dwell.rs
 create mode 100644 docs/decisions/2356-cycle-dwell.md

diff --git a/assets/posts/doosan-dnm.cps b/assets/posts/doosan-dnm.cps
index 8e4fd2f25..5a8af992e 100644
--- a/assets/posts/doosan-dnm.cps
+++ b/assets/posts/doosan-dnm.cps
@@ -1247,6 +1247,12 @@ function onCycle() {
     msg("canned cycle G83 (deep peck) dwell is not supported by this post - a " + p.P + " s dwell is refused, not dropped; set the dwell to 0");
     return;
   }
+  // #2356: this post does not map G73/G84 dwell across control modes.
+  // Use the raw positive ask so rounding and the open-cycle shortcut cannot drop it.
+  if ((g === "G73" || g === "G84") && p.P > 0) {
+    msg("canned cycle " + g + " dwell is not supported by this post - a " + p.P + " s dwell is refused, not dropped; set the dwell to 0");
+    return;
+  }
   if (spindleStopped("canned cycle " + g)) return;
   if (!xyFirst(p.X, p.Y, p.R, false)) return;  // #1633: refused - the move is not written
   cycleSeat(p);
