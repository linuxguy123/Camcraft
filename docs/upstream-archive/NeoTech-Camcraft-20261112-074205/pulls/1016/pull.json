  "title": "feat(app): refusal ghost for part-way refusals; ghost-aware match sites; ground-aware ghost colour",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
