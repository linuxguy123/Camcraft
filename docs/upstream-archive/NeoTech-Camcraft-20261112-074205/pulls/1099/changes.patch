diff --git a/crates/sim/src/verify/thread_bore.rs b/crates/sim/src/verify/thread_bore.rs
new file mode 100644
index 000000000..ad103a76d
--- /dev/null
+++ b/crates/sim/src/verify/thread_bore.rs
@@ -0,0 +1,82 @@
+//! The thread mill's grant in the solid law (#1071): a threaded hole's
+//! model shows its MINOR cylinder (what CAD draws of a tapped bore), and
+//! the helix cuts the thread depth past it, out to the major circle, by
+//! design. Material between the two circles is the thread being cut, not
+//! part the tool must keep. Specced from the ISO 724 minor/major relation
+//! the generator cites (`machining2d::thread_mill`) read against our own
+//! solid law ([`super::solid`]).
+//!
+//! The grant is narrow on purpose. A hit is excused only when BOTH hold:
+//! - the facet is the thread's own material: the hole's minor wall
+//!   (near-vertical, every vertex on the declared minor circle within
+//!   [`WALL_BAND`]), or the face the hole opens through (a facet with a
+//!   vertex on the minor circle, wholly at or above the hole's entry
+//!   height, where the thread breaks out at its mouth). A floor, a wall of
+//!   another radius, another hole, or anything below the entry that is
+//!   not the wall is never excused;
+//! - the swept cutter piece stays inside the major cylinder: the farther
+//!   tip end's distance from the axis plus the atom's radius is at most
+//!   the major radius plus the law's allowance.
+//!
+//! So a thread cut past its major circle, a thread declared wider than
+//! the model's hole, and a plunge through the hole's floor all still
+//! convict.
+
+use crate::geo2d::Point2;
+use crate::geometry::{Point3, Triangle};
+
+/// How far a wall vertex may stand off the declared minor circle and
+/// still be read as on it, mm, as a share of the radius with a floor:
+/// the drill rim law's own band (`rim_is` in the operation layer).
+const WALL_BAND_SHARE: f64 = 0.02;
+const WALL_BAND: f64 = 0.1;
+
+/// The most a wall facet's unit normal may lean out of the XY plane.
+const WALL_NZ: f64 = 0.1;
+
+/// One threaded hole: its axis in XY, the declared minor radius (the
+/// model's wall), the major radius the helix is cut to, and the height
+/// the hole opens at (its entry).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ThreadBore {
+    pub xy: Point2,
+    pub minor: f64,
+    pub major: f64,
+    pub top: f64,
+}
+
+impl ThreadBore {
+    fn rho(&self, p: Point3) -> f64 {
+        (p.x - self.xy.x).hypot(p.y - self.xy.y)
+    }
+
+    /// Whether `t` is the thread's own material (module doc): the minor
+    /// wall, or the face the hole opens through.
+    fn threaded(&self, t: &Triangle) -> bool {
+        let band = (WALL_BAND_SHARE * self.minor).max(WALL_BAND);
+        let on = |p: Point3| (self.rho(p) - self.minor).abs() <= band;
+        let ons = [t.a, t.b, t.c].into_iter().filter(|&p| on(p)).count();
+        if ons == 3 {
+            let (u, v) = (t.b - t.a, t.c - t.a);
+            let n = u.cross(v);
+            let len = n.dot(n).sqrt();
+            if len > f64::EPSILON && (n.z / len).abs() <= WALL_NZ {
+                return true;
+            }
+        }
+        ons > 0 && t.a.z.min(t.b.z).min(t.c.z) >= self.top - WALL_BAND
+    }
+
+    /// Whether a disc of radius `rho` swept between tips `p` and `q`
+    /// stays inside the major cylinder, `allow` granted. The farthest
+    /// point of a segment from the axis is one of its ends.
+    fn holds(&self, p: Point3, q: Point3, rho: f64, allow: f64) -> bool {
+        self.rho(p).max(self.rho(q)) + rho <= self.major + allow
+    }
+}
+
+/// Whether the hit of an upright cutter disc of radius `rho`, swept
+/// between tips `p` and `q`, on facet `t` is a thread being cut.
+pub(super) fn excused(bores: &[ThreadBore], t: &Triangle, p: Point3, q: Point3, rho: f64, allow: f64) -> bool {
+    bores.iter().any(|b| b.minor.is_finite() && b.major >= b.minor && b.top.is_finite() && b.threaded(t) && b.holds(p, q, rho, allow))
+}
diff --git a/crates/sim/tests/crossing_retrace.rs b/crates/sim/tests/crossing_retrace.rs
new file mode 100644
index 000000000..1b6e0f072
--- /dev/null
+++ b/crates/sim/tests/crossing_retrace.rs
@@ -0,0 +1,82 @@
+//! #1071: a path that runs back over its own trace - the thread mill's
+//! retract, its helix reversed at feed - is no crossing. The forward and
+//! reversed arcs put their chord joints a last bit apart, and the
+//! orientation predicate read those touches (and the collinear overlap)
+//! as proper crossings: a matched thread mill was blocked by a crossing
+//! pair per turn. A real crossing, at any angle a path can hold, still
+//! reads as one.
+//!
+//! Gate map (#1071): covers camcraft_sim::verify (crossing).
+//!
+//! Provenance: the orientation predicate (O'Rourke, "Computational
+//! Geometry in C") the law already cites; our own fixtures.
+
+use camcraft_sim::cl::{Move, MoveKind, Toolpath};
+use camcraft_sim::geo2d::Point2;
+use camcraft_sim::geometry::Point3;
+use camcraft_sim::verify::{crossed_pairs, crossed_pairs_all};
+
+fn feed(a: Point3, b: Point3) -> Move {
+    Move::new(MoveKind::Feed, a, b, Some(400.0))
+}
+
+/// Half-turn helix arcs of growing radius about the origin, descending
+/// half a pitch each, then the same ride reversed (the thread mill's
+/// retract), from radius `r0` in steps of `dr`.
+fn ride_and_retrace(r0: f64, dr: f64, turns: usize) -> Toolpath {
+    let o = Point2::new(0.0, 0.0);
+    let mut fwd = Vec::new();
+    let (mut r, mut z) = (r0, 20.0);
+    for _ in 0..turns {
+        let a = Point3::new(r, 0.0, z);
+        let b = Point3::new(-r, 0.0, z - 0.5);
+        let c = Point3::new(r, 0.0, z - 1.0);
+        fwd.push(feed(a, b).with_arc(o, true));
+        fwd.push(feed(b, c).with_arc(o, true));
+        let d = Point3::new(r + dr, 0.0, z - 1.0);
+        fwd.push(feed(c, d));
+        r += dr;
+        z -= 1.0;
+    }
+    let back: Vec<Move> = fwd
+        .iter()
+        .rev()
+        .map(|m| {
+            let mut n = feed(m.to, m.from);
+            if let Some(arc) = m.arc {
+                n = n.with_arc(arc.center, !arc.ccw);
+            }
+            n
+        })
+        .collect();
+    Toolpath { moves: fwd.into_iter().chain(back).collect(), ..Toolpath::default() }
+}
+
+#[test]
+fn a_helix_run_back_over_its_own_trace_is_no_crossing() {
+    // The #1071 thread mill's own numbers: r 2 stepping 0.1, and the
+    // 2.5413 major ride.
+    for (r0, dr) in [(2.0, 0.1), (2.5413, 0.0), (7.3, 0.037)] {
+        let t = ride_and_retrace(r0, dr, 6);
+        assert_eq!(crossed_pairs_all(&t, 0.01), Vec::<[usize; 2]>::new(), "r0 {r0}, dr {dr}");
+        assert_eq!(crossed_pairs(&t, 0.01), Vec::<[usize; 2]>::new(), "r0 {r0}, dr {dr}");
+    }
+}
+
+#[test]
+fn a_real_crossing_still_reads_as_one_at_any_angle() {
+    // Two planar feeds through one point at a shared depth, from square
+    // to a shallow 0.001 rad: the touch guard (1 nm) never hides them.
+    for ang in [std::f64::consts::FRAC_PI_2, 0.3, 0.01, 0.001] {
+        let (c, s) = (ang.cos(), ang.sin());
+        let t = Toolpath {
+            moves: vec![
+                feed(Point3::new(-10.0, 0.0, -1.0), Point3::new(10.0, 0.0, -1.0)),
+                feed(Point3::new(-10.0 * c, -10.0 * s, -1.0), Point3::new(10.0 * c, 10.0 * s, -1.0)),
+            ],
+            ..Toolpath::default()
+        };
+        assert_eq!(crossed_pairs_all(&t, 0.01), vec![[0, 1]], "angle {ang}");
+        assert_eq!(crossed_pairs(&t, 0.01), vec![[0, 1]], "angle {ang}");
+    }
+}
diff --git a/docs/decisions/1071-thread-mill-rim.md b/docs/decisions/1071-thread-mill-rim.md
new file mode 100644
index 000000000..223a9e948
--- /dev/null
+++ b/docs/decisions/1071-thread-mill-rim.md
@@ -0,0 +1,10 @@
+# #1071: a matched thread mill verifies clean; the gouge laws read its major circle
+
+- **Found:** the issue said a stock-sourced thread "never sees this". It does: the same matched thread from the stock source was blocked by 52 gouges and 21 crossing pairs. `mill2d_c` never asserted the warnings, so no thread mill could post from any source.
+- **Chosen (law (b)):** the Thread arm moves each declared hole's rim out to the thread's major circle (declared radius + 0.5413 x pitch, the depth the generator cuts to) after the region is built (`material_source::major_rims`). This covers every source and the area-controlled region alike. A loop that is the hole's minor rim (ours, or the model's own for a through hole) gives way to it; every other wall stays.
+- **Chosen (solid law):** for a thread mill, a hit is excused only when the facet is the thread's own material and the swept cutter stays inside the major cylinder (`sim::verify::thread_bore`). The thread's own material is the minor wall (near-vertical, every vertex on the declared minor circle within max(2 % r, 0.1 mm)), or the face the hole opens through (a facet with a vertex on the minor circle, wholly at or above the hole's entry). A floor, a wall of another radius and a cut past the major circle still convict. These are pinned: a thread past a nearby wall, a thread declared wider than the model's hole, and a thread taken below the model's floor.
+  - Dropped: pushing the mesh's wall vertices out to the major circle. With no vertex ring at the thread's floor, the wall becomes a slant below it, and a matched cutter still convicts.
+  - Dropped: dropping the wall facets. That breaks the solid's ray parity.
+- **Chosen (crossing law):** two chords only touching (an endpoint within 1 nm of the other's line) are no crossing. `proper_cross` excluded a touch only at an exactly zero orientation. The retract runs the ride backwards, so its joints stand a last bit off their twins, and both the touches and the collinear overlap read as crossings. A real crossing keeps every endpoint off the other line; it is pinned down to a 0.001 rad angle.
+  - Dropped: a parallel-only guard (sin < 1e-9). It removed 5 of the 21 pairs; the rest were touches at shared joints.
+- **Left:** the thread flanks are not modelled. The whole minor-to-major annulus is read as removable, which is what a thread mill cuts within its form. #986 owns the form.

