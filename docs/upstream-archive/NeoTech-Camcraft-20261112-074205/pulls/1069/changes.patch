From b1303881f938331eeab1ba7adf77ece898ce7852 Mon Sep 17 00:00:00 2001
From: ahmetv10 <ahmetv10@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:31:18 -0500
Subject: [PATCH] fix(ui): native dialogs are owned by the shell window (#1067)

Every picker was built without an owner, so Windows could put the Open or
Save dialog behind the app; a shell launched from a terminal was not the
foreground window either, so the first dialog of a session was the worst
case.

Publish the shell window once it exists (a thread-local: winit's Window is
!Send), hand it to rfd with set_parent, and raise it just before a picker
opens. The shell also asks for the foreground once at startup, and the GPU
refusal MessageDialog is owned the same way.

Hand-checked on Windows 11 at 125 %: launch from a terminal, first Ctrl+O,
the #32770 "Open" dialog is topmost and visible. No headless test: rfd
modals are hand-test-only here.

Fixes #1067
---
 crates/ui/src/egui_app/shell_window.rs | 18 ++++++++++---
 crates/ui/src/file_dialog.rs           | 36 ++++++++++++++++++++++++++
 2 files changed, 51 insertions(+), 3 deletions(-)

diff --git a/crates/ui/src/egui_app/shell_window.rs b/crates/ui/src/egui_app/shell_window.rs
index 588e24bb..e662c161 100644
--- a/crates/ui/src/egui_app/shell_window.rs
+++ b/crates/ui/src/egui_app/shell_window.rs
@@ -197,6 +197,13 @@ impl Shell {
                 return;
             }
         };
+        // #1067: the native pickers take the shell window as their owner, so
+        // an Open/Save dialog opens in front of the app rather than behind it.
+        crate::file_dialog::set_parent(&window);
+        // A window launched from a terminal or a script does not always get
+        // the foreground: ask for it once, so the shell is not born behind
+        // whatever launched it.
+        window.focus_window();
         // M4.2 + #74: the honest fallback chain, adapter by adapter inside
         // each backend mask (gpu_init); a refusal names every adapter tried.
         // The View3D pipelines are built per candidate: an adapter that
@@ -285,7 +292,7 @@ impl Shell {
 /// The GPU refusal, also as a native dialog: a console-less launch must
 /// not end in a window that silently vanishes (Prime Directive).
 fn refuse_dialog(err: &str) {
-    let _ = rfd::MessageDialog::new()
+    let dialog = rfd::MessageDialog::new()
         .set_level(rfd::MessageLevel::Error)
         .set_title("CamCraft cannot start the viewport")
         .set_description(format!(
@@ -293,8 +300,13 @@ fn refuse_dialog(err: &str) {
 
 Try --gpu <adapter name> (or CAMCRAFT_GPU) to choose an adapter, or --gpu-backend dx12|vulkan|gl."
         ))
-        .set_buttons(rfd::MessageButtons::Ok)
-        .show();
+        .set_buttons(rfd::MessageButtons::Ok);
+    // #1067: owned by the shell window, so the refusal is in front of the app.
+    let dialog = match crate::file_dialog::parent() {
+        Some(window) => dialog.set_parent(&*window),
+        None => dialog,
+    };
+    let _ = dialog.show();
 }
 
 impl Shell {
diff --git a/crates/ui/src/file_dialog.rs b/crates/ui/src/file_dialog.rs
index 7801da7a..b144011c 100644
--- a/crates/ui/src/file_dialog.rs
+++ b/crates/ui/src/file_dialog.rs
@@ -96,6 +96,34 @@ impl FileDialog {
     }
 }
 
+// The shell's window, published once it exists: rfd's dialogs take it as
+// their owner, so a picker opens in front of the app instead of behind it.
+// The window is `!Send`, so this is a thread-local rather than a `OnceLock`
+// - every picker runs on the thread that owns it.
+#[cfg(not(target_arch = "wasm32"))]
+thread_local! {
+    static PARENT: std::cell::RefCell<Option<std::sync::Arc<winit::window::Window>>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+/// Publish the window the native dialogs belong to, once it exists. Later
+/// calls are ignored: the shell opens one window.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn set_parent(window: &std::sync::Arc<winit::window::Window>) {
+    PARENT.with(|p| {
+        let mut p = p.borrow_mut();
+        if p.is_none() {
+            *p = Some(window.clone());
+        }
+    });
+}
+
+/// The published window, if the shell has opened one on this thread.
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn parent() -> Option<std::sync::Arc<winit::window::Window>> {
+    PARENT.with(|p| p.borrow().clone())
+}
+
 #[cfg(not(target_arch = "wasm32"))]
 mod imp {
     use super::FileDialog;
@@ -115,6 +143,14 @@ mod imp {
         if let Some(name) = d.file_name {
             out = out.set_file_name(name);
         }
+        // #1067: an unowned dialog can open behind the app window, and an
+        // owned one still follows an owner that is not the foreground window
+        // (a shell launched from a terminal). Raise the owner first, then
+        // hand the dialog to it.
+        if let Some(window) = super::parent() {
+            window.focus_window();
+            out = out.set_parent(&*window);
+        }
         out
     }
 
