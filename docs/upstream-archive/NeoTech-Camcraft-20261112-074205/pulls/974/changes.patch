+    assert_eq!(coolants, [("Air".to_owned(), "M7".to_owned())], "{text}");
+    assert_eq!(
+        camcraft_app::operation::CoolantMode::machine_default(&m.coolants),
+        camcraft_app::operation::CoolantMode::Air,
