From bf8069b11bd43d79bfc0c5531b11fe8611e7888d Mon Sep 17 00:00:00 2001
From: ahmetv10 <ahmetv10@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:04:21 -0500
Subject: [PATCH] fix(post): the plasma refusal reads plainly with no machine
 (#998)

The engine always publishes a machine object, so with no machine in the
document the name fell back to "no machine" and the refusal read "no
machine is not declared a plasma machine" - a double negative.

Say "no machine is stated, so none is declared a plasma machine" instead,
and pin both wordings in plasma_post_refusals.rs: a mill names itself, a
machine-less document says it states none.

Fixes #998
---
 assets/posts/tormach-plasma.cps          | 12 +++++++++---
 crates/app/tests/plasma_post_refusals.rs |  8 ++++++++
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/assets/posts/tormach-plasma.cps b/assets/posts/tormach-plasma.cps
index 98f717e0..ea55138f 100644
--- a/assets/posts/tormach-plasma.cps
+++ b/assets/posts/tormach-plasma.cps
@@ -77,13 +77,19 @@ function note(s) { block(["(" + s + ")"]); }
 // A plasma table cuts flat sheet - a stated rotary has no word here.
 function machineOk() {
   var m = typeof machine !== "undefined" ? machine : null;
-  var nm = (m && (m.name || m.model)) || "no machine";
+  var nm = (m && (m.name || m.model)) || "";
   if (!m || m.kind !== "plasma") {
-    refuse("kind", "the Tormach 1300PL plasma post writes torch words (M200, G15, G16, M205) only a plasma table reads - " + nm + " is not declared a plasma machine");
+    // The engine always publishes a machine object, with an empty name when
+    // the document states none: that fallback made the sentence a double
+    // negative ("no machine is not declared ..."). State it plainly (#998).
+    var why = nm
+      ? nm + " is not declared a plasma machine"
+      : "no machine is stated, so none is declared a plasma machine";
+    refuse("kind", "the Tormach 1300PL plasma post writes torch words (M200, G15, G16, M205) only a plasma table reads - " + why);
     return false;
   }
   if (m.rotaries && m.rotaries.length > 0) {
-    refuse("rotary", nm + " states a rotary axis - a plasma table cuts flat sheet in X and Y, and this post writes no rotary word");
+    refuse("rotary", (nm || "the machine") + " states a rotary axis - a plasma table cuts flat sheet in X and Y, and this post writes no rotary word");
     return false;
   }
   return true;
diff --git a/crates/app/tests/plasma_post_refusals.rs b/crates/app/tests/plasma_post_refusals.rs
index 1224d716..937c6309 100644
--- a/crates/app/tests/plasma_post_refusals.rs
+++ b/crates/app/tests/plasma_post_refusals.rs
@@ -123,6 +123,14 @@ fn the_post_refuses_what_a_plasma_table_cannot_say() {
     let vmc: Value = serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("json");
     let w = warnings(script(PLASMA), &vmc, &section("", HEAD, CUT));
     assert!(w.iter().any(|m| m.contains("is not declared a plasma machine")), "{w:?}");
+    // A document with no machine: the sentence must read, not double-negate
+    // ("no machine is not declared ...") - #998.
+    let w = warnings(script(PLASMA), &Value::Null, &section("", HEAD, CUT));
+    assert!(
+        w.iter().any(|m| m.contains("no machine is stated, so none is declared a plasma machine")),
+        "{w:?}"
+    );
+    assert!(!w.iter().any(|m| m.contains("no machine is not declared")), "{w:?}");
     let mut rot = pl1300();
     // (The mirror's door: the parsed 1300PL itself refuses a rotary.)
     rot["kinematics"]["static"] = serde_json::json!({ "rotaries": [{ "letter": "A", "direction": [1, 0, 0] }] });
