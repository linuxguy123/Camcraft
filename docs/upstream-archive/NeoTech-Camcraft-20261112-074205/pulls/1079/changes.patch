diff --git a/crates/app/src/geometry/import/step_depth.rs b/crates/app/src/geometry/import/step_depth.rs
new file mode 100644
index 00000000..63bb4436
--- /dev/null
+++ b/crates/app/src/geometry/import/step_depth.rs
@@ -0,0 +1,200 @@
+//! STEP nesting guard: one linear byte scan that refuses a record whose
+//! parentheses nest past [`MAX_NESTING`] before the recursive-descent
+//! parser can overflow its stack on it (#1075).
+//!
+//! Provenance: lexical rules (strings `'...'` with `''` as an escaped
+//! quote, comments `/* ... */`, entity ids `#n`) per ISO 10303-21; the cap
+//! is our own measurement, recorded in docs/decisions/1075-step-nesting-cap.md.
+//!
+//! The scan only measures depth. It does not judge syntax: an unbalanced
+//! `)` (depth would go negative), an unterminated string or comment are
+//! left for the parser to report.
+
+use super::ImportError;
+
+/// Deepest parenthesis nesting a STEP record may have. Real files nest a
+/// handful deep (our fixtures reach 3); ruststep's parser, in a debug
+/// build, dies at about 400 levels on a 1 MiB stack (the Windows main
+/// thread, where an inline import runs) and about 820 on 2 MiB (release:
+/// about 530 and 1080).
+pub const MAX_NESTING: usize = 64;
+
+/// Refuse `data` by name if any record nests deeper than [`MAX_NESTING`].
+pub fn check(data: &[u8]) -> Result<(), ImportError> {
+    check_with_cap(data, MAX_NESTING)
+}
+
+/// The deepest parenthesis nesting anywhere in `data` (strings and
+/// comments skipped). For tests and diagnostics.
+#[must_use]
+pub fn max_depth(data: &[u8]) -> usize {
+    let mut deepest = 0;
+    scan(data, |depth, _, _| {
+        deepest = deepest.max(depth);
+        true
+    });
+    deepest
+}
+
+fn check_with_cap(data: &[u8], cap: usize) -> Result<(), ImportError> {
+    let mut over: Option<(Option<u64>, usize)> = None;
+    scan(data, |depth, entity, line| {
+        if depth > cap {
+            over = Some((entity, line));
+            return false;
+        }
+        true
+    });
+    match over {
+        None => Ok(()),
+        Some((entity, line)) => {
+            let at = entity.map_or_else(
+                || "a record without an entity id".to_string(),
+                |id| format!("entity #{id}"),
+            );
+            Err(ImportError::Step(format!(
+                "record nests deeper than {cap} levels of parentheses at {at}, line {line}"
+            )))
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum State {
+    Code,
+    Str,
+    Comment,
+}
+
+/// Walk `data` once, calling `on_open(depth, entity, line)` after every `(`
+/// outside strings and comments; stop when it returns `false`. `entity` is
+/// the `#id` of the record being read (the id that opened it at depth 0),
+/// `line` is 1-based and counts `\n` only, so CRLF and LF agree.
+fn scan(data: &[u8], mut on_open: impl FnMut(usize, Option<u64>, usize) -> bool) {
+    let mut state = State::Code;
+    let mut depth: usize = 0;
+    let mut line: usize = 1;
+    let mut entity: Option<u64> = None;
+    let mut i = 0;
+    while let Some(&b) = data.get(i) {
+        let next = data.get(i + 1).copied();
+        if b == b'\n' {
+            line = line.saturating_add(1);
+        }
+        match state {
+            State::Str => {
+                if b == b'\'' {
+                    if next == Some(b'\'') {
+                        i += 1; // escaped quote, still inside the string
+                    } else {
+                        state = State::Code;
+                    }
+                }
+            }
+            State::Comment => {
+                if b == b'*' && next == Some(b'/') {
+                    state = State::Code;
+                    i += 1;
+                }
+            }
+            State::Code => match b {
+                b'\'' => state = State::Str,
+                b'/' if next == Some(b'*') => {
+                    state = State::Comment;
+                    i += 1;
+                }
+                b'(' => {
+                    depth = depth.saturating_add(1);
+                    if !on_open(depth, entity, line) {
+                        return;
+                    }
+                }
+                b')' => depth = depth.saturating_sub(1),
+                b';' if depth == 0 => entity = None,
+                b'#' if depth == 0 => {
+                    // The record's own id: `#` then digits, at depth 0.
+                    let mut id: u64 = 0;
+                    let mut j = i + 1;
+                    let mut any = false;
+                    while let Some(d) = data.get(j).filter(|d| d.is_ascii_digit()) {
+                        id = id.saturating_mul(10).saturating_add(u64::from(d - b'0'));
+                        any = true;
+                        j += 1;
+                    }
+                    if any {
+                        entity = Some(id);
+                        i = j - 1;
+                    }
+                }
+                _ => {}
+            },
+        }
+        i += 1;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn nested(depth: usize) -> String {
+        format!(
+            "#7 = THING({}1{});\n",
+            "(".repeat(depth - 1),
+            ")".repeat(depth - 1)
+        )
+    }
+
+    #[test]
+    fn depth_counts_parentheses_of_a_record() {
+        assert_eq!(max_depth(nested(5).as_bytes()), 5);
+        assert_eq!(max_depth(b"#1 = A(1.0, (2, 3), $);"), 2);
+    }
+
+    #[test]
+    fn strings_and_comments_do_not_count() {
+        assert_eq!(max_depth(b"#1 = A('(((((', 'it''s ((( ');"), 1);
+        assert_eq!(max_depth(b"/* ((((( */ #1 = A(1);"), 1);
+        // A `''` escape must not end the string early.
+        assert_eq!(max_depth(b"#1 = A('a''(((b');"), 1);
+    }
+
+    #[test]
+    fn refusal_names_cap_entity_and_line() {
+        let text = format!("DATA;\n#1 = A(1);\n{}ENDSEC;\n", nested(10));
+        let err = check_with_cap(text.as_bytes(), 8)
+            .err()
+            .map(|e| e.to_string())
+            .unwrap_or_default();
+        assert!(err.contains("deeper than 8"), "{err}");
+        assert!(err.contains("entity #7"), "{err}");
+        assert!(err.contains("line 3"), "{err}");
+    }
+
+    #[test]
+    fn at_the_cap_passes() {
+        assert!(check_with_cap(nested(8).as_bytes(), 8).is_ok());
+        assert!(check_with_cap(nested(9).as_bytes(), 8).is_err());
+    }
+
+    #[test]
+    fn crlf_and_lf_give_the_same_line() {
+        let lf = format!("A;\n\n#1 = B(1);\n{}", nested(10));
+        let crlf = lf.replace('\n', "\r\n");
+        let a = check_with_cap(lf.as_bytes(), 8)
+            .err()
+            .map(|e| e.to_string());
+        let b = check_with_cap(crlf.as_bytes(), 8)
+            .err()
+            .map(|e| e.to_string());
+        assert!(a.as_deref().is_some_and(|m| m.contains("line 4")), "{a:?}");
+        assert_eq!(a, b);
+    }
+
+    #[test]
+    fn unbalanced_and_non_utf8_are_left_to_the_parser() {
+        assert!(check(b"#1 = A(1)));)))(((;").is_ok());
+        assert!(check(&[0xff, 0xfe, b'(', 0x80, b')']).is_ok());
+        assert!(check(b"#1 = A('unterminated (((((").is_ok());
+    }
+}
diff --git a/crates/app/tests/step_nesting.rs b/crates/app/tests/step_nesting.rs
new file mode 100644
index 00000000..ef96a3cc
--- /dev/null
+++ b/crates/app/tests/step_nesting.rs
@@ -0,0 +1,122 @@
+//! #1075: a STEP record nested thousands of parentheses deep is refused by
+//! name before ruststep's recursive parser can overflow the stack - on the
+//! model import path and on the tool-body coordinate-system read. The deep
+//! inputs are built here from box.step, not committed as fixtures.
+//!
+//! Gate map: covers app::geometry::import::step_depth, step and step_csys.
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use camcraft_app::geometry::import::step_csys::read_tool_csys;
+use camcraft_app::geometry::import::step_depth::{max_depth, MAX_NESTING};
+use camcraft_app::geometry::import::{self, Format};
+
+fn models() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models")
+}
+
+/// box.step with one extra record `#999999` nested `depth` deep, put just
+/// before the DATA section's ENDSEC; and the 1-based line it starts on.
+fn box_with_deep_record(depth: usize, crlf: bool) -> (Vec<u8>, usize) {
+    let text = std::fs::read_to_string(models().join("box.step")).expect("box.step reads");
+    let text = text.replace("\r\n", "\n");
+    let at = text.rfind("ENDSEC;").expect("box.step has a DATA ENDSEC");
+    let line = text[..at].matches('\n').count() + 1;
+    let inner = depth.saturating_sub(1);
+    let record = format!(
+        "#999999 = DEEP_LIST({}1.0{});\n",
+        "(".repeat(inner),
+        ")".repeat(inner)
+    );
+    let mut out = format!("{}{record}{}", &text[..at], &text[at..]);
+    if crlf {
+        out = out.replace('\n', "\r\n");
+    }
+    (out.into_bytes(), line)
+}
+
+fn refusal(data: &[u8]) -> String {
+    match import::parse_model(data, Format::Step) {
+        Ok(_) => String::from("<imported>"),
+        Err(e) => e.to_string(),
+    }
+}
+
+#[test]
+fn a_record_nested_5000_deep_is_refused_by_name_quickly() {
+    let (data, line) = box_with_deep_record(5000, false);
+    let start = Instant::now();
+    let msg = refusal(&data);
+    let took = start.elapsed();
+    assert!(msg.contains(&format!("deeper than {MAX_NESTING}")), "{msg}");
+    assert!(msg.contains("entity #999999"), "{msg}");
+    assert!(msg.contains(&format!("line {line}")), "{msg}");
+    assert!(took < Duration::from_secs(1), "refusal took {took:?}");
+}
+
+#[test]
+fn crlf_and_lf_files_name_the_same_line() {
+    let (lf, line) = box_with_deep_record(5000, false);
+    let (crlf, _) = box_with_deep_record(5000, true);
+    let a = refusal(&lf);
+    assert!(a.contains(&format!("line {line}")), "{a}");
+    assert_eq!(a, refusal(&crlf));
+}
+
+#[test]
+fn a_record_at_the_cap_still_imports() {
+    let (data, _) = box_with_deep_record(MAX_NESTING, false);
+    assert_eq!(max_depth(&data), MAX_NESTING);
+    let mesh = import::parse_model(&data, Format::Step).expect("a record at the cap imports");
+    let plain = import::load_model(&models().join("box.step")).expect("box.step imports");
+    assert_eq!(
+        mesh.facets.len(),
+        plain.facets.len(),
+        "the dead record must not change the mesh"
+    );
+    let (over, _) = box_with_deep_record(MAX_NESTING + 1, false);
+    assert!(
+        refusal(&over).contains("deeper than"),
+        "one past the cap is refused"
+    );
+}
+
+#[test]
+fn the_tool_body_csys_read_is_guarded_too() {
+    let (data, line) = box_with_deep_record(5000, false);
+    let msg = read_tool_csys(&data)
+        .err()
+        .map(|e| e.to_string())
+        .unwrap_or_default();
+    assert!(
+        msg.contains("entity #999999") && msg.contains(&format!("line {line}")),
+        "{msg}"
+    );
+}
+
+/// Every committed STEP fixture nests far below the cap (they reach 3).
+#[test]
+fn every_step_fixture_is_under_the_cap() {
+    let mut seen = 0;
+    for entry in std::fs::read_dir(models()).expect("testdata/models lists") {
+        let path = entry.expect("dir entry").path();
+        let ext = path
+            .extension()
+            .and_then(|e| e.to_str())
+            .map(str::to_ascii_lowercase);
+        if !matches!(ext.as_deref(), Some("step" | "stp")) {
+            continue;
+        }
+        let depth = max_depth(&std::fs::read(&path).expect("fixture reads"));
+        println!("{}: max depth {depth}", path.display());
+        assert!(
+            depth <= 8,
+            "{} nests {depth} deep - re-check the cap's margin",
+            path.display()
+        );
+        assert!(depth < MAX_NESTING);
+        seen += 1;
+    }
+    assert!(seen >= 5, "found only {seen} STEP fixtures");
+}
diff --git a/docs/decisions/1075-step-nesting-cap.md b/docs/decisions/1075-step-nesting-cap.md
new file mode 100644
index 00000000..6891c8f9
--- /dev/null
+++ b/docs/decisions/1075-step-nesting-cap.md
@@ -0,0 +1,43 @@
+## #1075 - STEP records may nest at most 64 parentheses deep
+
+**Decided:** before ruststep parses a STEP file, one linear byte scan
+(`geometry::import::step_depth`) tracks parenthesis depth outside strings
+(`'...'`, `''` escaped) and comments (`/* ... */`) and refuses the file past
+`MAX_NESTING = 64`, naming the cap, the record's `#id` and the line
+(`\n`-counted, so CRLF and LF agree). Both functions that hand bytes to
+ruststep call it first: `step::parse_with_chord` (every model import:
+`ImportModel`, `ImportFixture` / fixture models, the tool-body mesh, the
+MCP `import_model` and script import all reach it through
+`import::load_model[_graded]`) and `step_csys::read_tool_csys` (the tool
+body's coordinate systems).
+
+**Why 64 - the evidence (2026-11-12, Windows 11, this machine):**
+
+| ruststep (pinned rev 90fdc935), one record nested N deep | 1 MiB stack | 2 MiB stack | 8 MiB stack |
+|---|---|---|---|
+| debug build, last N that survives | 400 | 821 | 3341 |
+| release build, last N that survives | 530 | 1086 | 4418 |
+
+About 2.5 KB of stack per level in debug, 1.9 KB in release. The smallest
+stack an import runs on by default is 1 MiB: the Windows main thread, where
+the GUI's import falls back to running inline when its worker thread cannot
+be spawned (the worker and test threads get Rust's 2 MiB). Every committed
+STEP fixture (`testdata/models/*.step`, a real AP214 export included) nests
+3 deep; real AP203/AP214 records rarely pass 4-5. 64 is about 20x the
+deepest real record and about 6x below the debug crash on 1 MiB, leaving
+room for whatever the caller already has on the stack. It also matches the
+cap the solidcore STEP importer (#916, PR #941) already uses.
+
+**Considered and dropped:**
+- (b) parse on a thread with a large, bounded stack and treat its death as
+  the refusal: a stack overflow aborts the whole process on every platform,
+  it cannot be caught on a thread; a bigger stack only moves the depth.
+- Hosting the scan in PR #1006's `step_diag.rs`: it is not merged; a new
+  file keeps the two PRs from colliding (both touch `parse_with_chord`, in
+  different hunks).
+- A cap near the crash depth (e.g. 256): no real file needs it and it eats
+  the headroom on a 1 MiB stack.
+
+**Cost to change later:** one constant; the measured table above says how
+far it can move. A ruststep that parses iteratively would make the scan
+redundant but harmless.

From 45472061461e630ae50d67501a2e1f374e390d2c Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Thu, 12 Nov 2026 06:47:41 +0100
Subject: [PATCH 2/2] fix(import): mirror ruststep's tokenizer in the STEP
 nesting scan

Review of PR #1079: a `<...>` REFERENCE resource or ANCHOR name holding
`/*` or `'` put the depth scan into a comment or string state ruststep
never entered, so a 5000-deep record after it passed the check and
overflowed the stack. The scan gains a `<...>` state and a binary `"..."`
state (parentheses still counted there), after an end-to-end read of
ruststep's tokenizer at the pinned rev; the construct table lives in the
module and the decision file, and the Cargo.toml pin comment says the scan
must be re-audited when the pin moves. Table-driven tests pin every
construct at the cap + 1.

Fixes #1075

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
