+        quad(p(o[k]), p(o[n]), p(i[n]), p(i[k]), &mut f);
+    }
+    f.extend(boss.iter().skip(if boss_top { 2 } else { 4 }).cloned());
     f
 }
 
+fn stepped() -> Vec<Triangle> {
+    stepped_shell(true)
