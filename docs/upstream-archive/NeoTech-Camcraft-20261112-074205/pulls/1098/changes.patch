@@ -0,0 +1,128 @@
+//! #1091: the stock-top re-reading of law (d)'s dives - pinned on a
+//! stepped slab (Z 20, a boss to Z 30 over x 10..20) with an 8 mm tool.
+
+use super::*;
+use crate::cl::Move;
+use crate::geometry::{Point3, cube};
+
+fn tool() -> ToolGeom {
+    ToolGeom {
+        radius: 4.0,
+        nose_radius: 0.0,
+        flute_len: 20.0,
+        shank_radius: 4.0,
+        shank_len: 30.0,
+        holder_radius: 16.0,
+        holder_len: 40.0,
+    }
+}
+
+/// The slab and the boss as two closed boxes (the bound only needs each
+/// facet's plan and height).
+fn stepped() -> Vec<Triangle> {
+    let mut f = cube(Point3::new(-30.0, -30.0, -10.0), Point3::new(30.0, 30.0, 20.0)).facets.to_vec();
+    f.extend(cube(Point3::new(10.0, -5.0, 20.0), Point3::new(20.0, 5.0, 30.0)).facets.iter().cloned());
+    f
+}
+
+fn dive_at(x: f64, z1: f64, axis: Option<[f64; 3]>) -> Toolpath {
+    Toolpath {
+        moves: vec![Move {
+            rotary: None,
+            kind: MoveKind::Rapid,
+            from: Point3::new(x, 0.0, 40.0),
+            to: Point3::new(x, 0.0, z1),
+            feed: None,
+            arc: None,
+            axis,
+        }],
+        cycles: Vec::new(),
+        notes: Vec::new(),
+        comps: Vec::new(),
+        threads: Vec::new(),
+        probes: Vec::new(),
+        breaks: Vec::new(),
+        plasma: None,
+    }
+}
+
+fn judged(path: &Toolpath, mode: Mode, solids: &[&[Triangle]], t: &ToolGeom) -> Vec<Warning> {
+    let mut w = vec![Warning::RapidInStock { at: 0 }];
+    acquit_by_stock_top(path, mode, solids, t, 1e-3, &mut w);
+    w
+}
+
+const CONVICTED: [Warning; 1] = [Warning::RapidInStock { at: 0 }];
+
+#[test]
+fn a_dive_over_the_low_step_is_acquitted() {
+    let s = stepped();
+    assert!(judged(&dive_at(0.0, 22.0, None), Mode::Area, &[&s], &tool()).is_empty());
+}
+
+#[test]
+fn a_dive_over_the_boss_stands() {
+    let s = stepped();
+    assert_eq!(judged(&dive_at(15.0, 22.0, None), Mode::Area, &[&s], &tool()), CONVICTED);
+}
+
+#[test]
+fn a_boss_under_the_rim_only_stands() {
+    // The centre 3 mm off the boss's edge, the 4 mm rim over it.
+    let s = stepped();
+    assert_eq!(judged(&dive_at(7.0, 22.0, None), Mode::Area, &[&s], &tool()), CONVICTED);
+    // 4.5 mm off: the flute clears it, and so do shank and holder (the
+    // holder's bottom stands 50 mm over the tip).
+    assert!(judged(&dive_at(5.5, 22.0, None), Mode::Area, &[&s], &tool()).is_empty());
+}
+
+#[test]
+fn a_holder_band_over_the_boss_stands() {
+    // A stubby stack: the holder (radius 16) starts 6 mm over the tip at
+    // Z 28, under the boss's top 6 mm away - a crash the flute disc misses.
+    let s = stepped();
+    let stub = ToolGeom { flute_len: 3.0, shank_len: 3.0, ..tool() };
+    assert_eq!(judged(&dive_at(0.0, 22.0, None), Mode::Area, &[&s], &stub), CONVICTED);
+}
+
+#[test]
+fn the_part_reading_counts_too() {
+    // A part standing to Z 25 under the dive, stock low: still convicted.
+    let s = stepped();
+    let part = cube(Point3::new(-3.0, -3.0, 0.0), Point3::new(3.0, 3.0, 25.0)).facets.to_vec();
+    assert_eq!(judged(&dive_at(0.0, 22.0, None), Mode::Area, &[&s, &part], &tool()), CONVICTED);
+}
+
+#[test]
+fn unknowns_fail_closed() {
+    let s = stepped();
+    // No facet under the flute: no proof.
+    assert_eq!(judged(&dive_at(100.0, 22.0, None), Mode::Area, &[&s], &tool()), CONVICTED);
+    // No solids at all.
+    assert_eq!(judged(&dive_at(0.0, 22.0, None), Mode::Area, &[], &tool()), CONVICTED);
+    // A non-finite vertex anywhere.
+    let mut bad = s.clone();
+    if let Some(t) = bad.get_mut(0) {
+        t.a.z = f64::NAN;
+    }
+    assert_eq!(judged(&dive_at(0.0, 22.0, None), Mode::Area, &[&bad], &tool()), CONVICTED);
+    // A stack band that is not a number.
+    let nan = ToolGeom { holder_radius: f64::NAN, ..tool() };
+    assert_eq!(judged(&dive_at(0.0, 22.0, None), Mode::Area, &[&s], &nan), CONVICTED);
+}
+
+#[test]
+fn only_upright_column_dives_are_re_read() {
+    let s = stepped();
+    // A posed dive, and the radial / revolved / rotary modes, keep it.
+    assert_eq!(judged(&dive_at(0.0, 22.0, Some([0.0, 0.6, 0.8])), Mode::Area, &[&s], &tool()), CONVICTED);
+    for mode in [Mode::Radial, Mode::Revolve, Mode::Rotary] {
+        assert_eq!(judged(&dive_at(0.0, 22.0, None), mode, &[&s], &tool()), CONVICTED);
+    }
+    // A lateral rapid is never re-read.
+    let mut lateral = dive_at(0.0, 22.0, None);
+    if let Some(m) = lateral.moves.get_mut(0) {
+        m.to.x = 3.0;
+    }
+    assert_eq!(judged(&lateral, Mode::Area, &[&s], &tool()), CONVICTED);
+}
diff --git a/docs/decisions/1091-rapid-law-local-top.md b/docs/decisions/1091-rapid-law-local-top.md
new file mode 100644
index 00000000..878e3dfa
--- /dev/null
+++ b/docs/decisions/1091-rapid-law-local-top.md
@@ -0,0 +1,88 @@
+## #1091 - The rapid law reads the stock's top under the dive, not its highest point
+
+**What was decided**
+
+1. **Reproduced with stock only.** A casting set as "from model" stock,
+   solid to Z 20 over a 16 mm hole's mouth with a boss to Z 30 18 mm
+   away, then removed from the tree (the stock keeps its copy) so the
+   program verdict does not judge it as a part. A part-sourced Bore
+   (part imported) and a stock-sourced Bore (no part at all) both
+   rapid to Z 22 and were convicted `RapidInStock { at: 0 }`.
+2. **Re-read the convicted dive, do not change the column law.** A new
+   sim reading, `verify::acquit_by_stock_top`, works the way
+   `acquit_by_prior` does: it only removes a conviction, and only from
+   an upright vertical rapid down in a column mode. The column law
+   (`rapids.rs`, `Rest::surface_before`) and its flat cap are
+   unchanged, so every other conviction - lateral rapids, the posed and
+   radial readings, the solid law - keeps its verdict.
+3. **The bound is exact and conservative.** The re-reading takes the
+   highest vertex of every stock or part facet whose plan comes within
+   the tool's disc. On a closed mesh that is never below the material
+   standing anywhere in the disc. It reads each band of the stack
+   separately: the flute at its full radius (not `r - gouge_tol`, and
+   with no ball lift) from the tip, the shank from the flute's top, and
+   the holder from the shank's top. The dive is acquitted only when
+   every band ends above its disc's top, less `Z_TOL`. A boss reaching
+   under the rim, or under a wide holder over a stubby tool, still
+   convicts. It fails closed: a non-finite vertex, a non-finite stack
+   number, no judged stock (the op's region stood in for it), or a
+   flute disc that meets no facet all leave the conviction standing.
+4. **The solids are `judged_stock` (the stock the column law judged,
+   #1066: the setup's or carried stock, or the stock itself for a
+   stock-sourced Bore/Thread) and the op's own material.** Both are
+   read in the path's frame: world at the upright site, and the
+   plane's local facets at the 3+2 site. Thread's descent is a
+   vertical rapid, so it is re-read the same way.
+   `acquit_by_prior` still runs afterwards, for stock the program ahead
+   removed.
+5. **Pinned by** `crates/app/tests/stepped_stock_rapid.rs` (the dive
+   over the low part passes and posts. With the boss over the hole, or
+   with its edge 1.5 mm beside the dive's centre under the 4 mm rim, the
+   dive is convicted and the post is blocked by the rapid law. Each
+   case runs for both sources) and by `sim::verify::stock_top`'s unit
+   tests (the holder band, the part counting too, the fail-closed
+   cases, and the posed, lateral and radial/revolved/rotary
+   exclusions). The `ladder_entry_height` pins and the #96 pins are
+   unchanged.
+
+**Why**
+
+The Prime Directive asks for correct output or a visible refusal. A
+refusal of a legal program is not a gouge, but it leaves a user with a
+casting no way to post. Loosening the law itself (a per-sample local
+cap inside `surface_before`) would move every column verdict and lean
+on the footprint's sampling bound. A re-reading that can only acquit,
+and only on an exact upper bound of the material, cannot let a dive
+into material pass.
+
+**Considered and dropped**
+
+- *A local cap per footprint sample inside `Rest::surface_before`.*
+  This would also cover lateral rapids, but it inherits the footprint's
+  sampling bound (a boss sliver between samples could pass) and it
+  changes every column law that reads the cap.
+- *The stock dexel (`stock_grid`) as the prior even when nothing is
+  ahead.* The grid samples cell centres, so a boss edge between centres
+  reads low. That is not an upper bound.
+- *A new `VerifyContext` field.* It would touch about 50 construction
+  sites for a reading that only needs the dive's convictions.
+
+**Left as it is (follow-ups filed)**
+
+- Lateral rapids under the clearance plane over a stepped stock still
+  read the flat cap. They over-report and do not hide anything (#1095).
+- A stock-from-model's source model left in the tree is judged as a
+  part by the program verdict, so the post reports a gouge. The
+  reproduction removes the casting to keep that out of the way (#1094).
+- A model that is neither the op's source nor inside the stock (a
+  second part poking up through a low step) is not in the solids. The
+  flat cap did not read it there either, since `stock_top_z` is the
+  stock's and the source's top.
+
+**What it would cost to change later**
+
+- Lateral rapids could take the same re-reading over the swept capsule.
+  That is a second reading in `stock_top.rs`, and the rest of the law
+  stays unchanged.
+- If verify ever gets a true stock model (#928), this re-reading is
+  replaced by the column law reading that model directly.

From 6440858bcd6c69b7807ef3535bff77d8e82caa85 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Thu, 12 Nov 2026 08:16:31 +0100
Subject: [PATCH 3/3] fix(verify): the stock-top re-reading proves nothing from
 an open mesh

PR #1098 review: acquit_by_stock_top's bound ("the material over a plan
point stands under a facet covering it") holds only for a closed
surface. A from-model stock whose boss lost its top facets let a
stock-sourced Bore's rapid to Z 22 into a boss standing to Z 30 post.

Every solid the re-reading reads must now pass
stock_top_shell::closed_shell or the conviction stands: non-empty,
finite, no 3-D degenerate facet, every undirected edge (exact endpoint
match) used by exactly two facets once each way, one edge-connected
shell, positive signed volume. Computed once per solid per operation,
O(F) with an edge hash map.

Pinned by stepped_stock_rapid::an_open_stock_mesh_proves_nothing_and_
the_dive_stays_convicted (part- and stock-sourced Bore; fails with the
gate off) and stock_top unit tests for an open shell, non-manifold and
duplicated edges, degenerate, inside-out, split, empty and non-finite
solids.

Refs #1091

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
