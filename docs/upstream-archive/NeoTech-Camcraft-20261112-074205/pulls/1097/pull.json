  "title": "fix(verify): a from-model stock's source is judged unless the user marks it raw stock only",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
