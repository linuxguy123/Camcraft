diff --git a/crates/kernel/tests/machining_mesh.rs b/crates/kernel/tests/machining_mesh.rs
new file mode 100644
index 00000000..2a25e632
--- /dev/null
+++ b/crates/kernel/tests/machining_mesh.rs
@@ -0,0 +1,296 @@
+//! The machining mesh's laws (M12.1, #940), default lane: a STEP solid
+//! meshed by solidcore-tess at a chord in mm is handed out only whole and
+//! measured inside its tolerance; every planner shortfall, a bad tolerance,
+//! a time-out and a measured deviation past the tolerance are named
+//! refusals. The per-fixture deviation table is the heavy bench
+//! (tests/mesh_deviation_bench.rs).
+//! Provenance: our own test design; fixtures are the repo's own.
+//!
+//! Gate map (M12.1): covers camcraft_kernel::machining_mesh,
+//! camcraft_kernel::mesh_deviation.
+
+use std::path::PathBuf;
+
+use camcraft_kernel::machining_mesh::{MeshRefusal, judge_stats, machining_mesh};
+use camcraft_kernel::mesh_deviation::{self, analytic_distance};
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::{StepSolid, import_step};
+use solidcore::kernel::CancelToken;
+use solidcore_record::Vec3;
+use solidcore_tess::{
+    Cap, CappedEdge, EdgeCap, MeshTolerance, OverTolerance, PlanStats, RefusedEdge, RefusedFace,
+};
+
+/// The app's chord cap (#689), mm.
+const TOL: f64 = 0.005;
+
+fn solid(file: &str) -> StepSolid {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("../../testdata/models")
+        .join(file);
+    let bytes = std::fs::read(&path).unwrap_or_default();
+    let mut k = SolidcoreKernel::default();
+    let mut import = match import_step(&mut k, &bytes, &CancelToken::new()) {
+        Ok(i) => i,
+        Err(e) => panic!("{file}: {e}"),
+    };
+    assert_eq!(import.solids.len(), 1, "{file}: one solid expected");
+    import.solids.remove(0)
+}
+
+#[test]
+fn machining_mesh_is_watertight_and_within_tolerance() {
+    for (file, faces) in [("box.step", 6), ("Milling-test.step", 0)] {
+        let s = solid(file);
+        let m = match machining_mesh(&s, TOL, &CancelToken::new()) {
+            Ok(m) => m,
+            Err(e) => panic!("{file}: {e}"),
+        };
+        let r = &m.report;
+        println!("{file}: {r:?}");
+        assert_eq!(r.open_sides, 0, "{file}");
+        assert!(r.deviation.largest() <= TOL, "{file}: {:?}", r.deviation);
+        assert!(r.deviation.samples > 0, "{file}");
+        assert_eq!(m.triangles.len(), r.triangles);
+        assert_eq!(m.tri_face.len(), r.triangles);
+        if faces > 0 {
+            assert_eq!(r.faces, faces, "{file}");
+        }
+        // The enclosed volume is the exact solid's, less the facets' sag.
+        let rel = (r.volume - s.measure.volume).abs() / s.measure.volume;
+        assert!(
+            rel < 1e-3,
+            "{file}: volume {} vs {}",
+            r.volume,
+            s.measure.volume
+        );
+    }
+}
+
+#[test]
+fn a_bad_tolerance_or_a_spent_time_bound_is_refused_by_name() {
+    let s = solid("box.step");
+    for tol in [f64::NAN, f64::INFINITY, 0.0, -0.005, 1e-9] {
+        match machining_mesh(&s, tol, &CancelToken::new()) {
+            Err(MeshRefusal::Tolerance { .. }) => {}
+            other => panic!("tolerance {tol}: {other:?}"),
+        }
+    }
+    let stop = CancelToken::new();
+    stop.cancel();
+    assert!(matches!(
+        machining_mesh(&s, TOL, &stop),
+        Err(MeshRefusal::TimedOut(_))
+    ));
+}
+
+/// Every PlanStats entry has its decided outcome (decision file, point 2).
+#[test]
+fn every_planner_shortfall_is_a_refusal_or_a_note() {
+    let face = |reason: &str| RefusedFace {
+        face: 3,
+        reason: reason.into(),
+    };
+    let edge = |reason: &str| RefusedEdge {
+        edge: 7,
+        reason: reason.into(),
+    };
+    let over = |within| OverTolerance {
+        face: 2,
+        sag: 0.009,
+        unmeasured: 0,
+        tol: TOL,
+        within,
+        caps: vec![Cap::Refine],
+    };
+    let capped = |within| CappedEdge {
+        edge: 5,
+        cap: EdgeCap::Nodes,
+        sag: if within { 0.001 } else { 0.02 },
+        excess: 4.0,
+        tol: TOL,
+        within,
+    };
+    let none = PlanStats::default();
+    assert_eq!(judge_stats(&none), Ok(vec![]));
+
+    let refused = [
+        (
+            PlanStats {
+                unmeshed: vec![face("no surface")],
+                ..none.clone()
+            },
+            "FaceLeftOut",
+        ),
+        (
+            PlanStats {
+                lenient: vec![face("pcurve off its edge")],
+                ..none.clone()
+            },
+            "Lenient",
+        ),
+        (
+            PlanStats {
+                unsampled_edges: vec![edge("no curve")],
+                ..none.clone()
+            },
+            "EdgeNotSampled",
+        ),
+        (
+            PlanStats {
+                over_tolerance: vec![over(false)],
+                ..none.clone()
+            },
+            "FaceCapped",
+        ),
+        (
+            PlanStats {
+                edges_capped: vec![capped(false)],
+                ..none.clone()
+            },
+            "EdgeCapped",
+        ),
+    ];
+    for (stats, name) in refused {
+        let got = judge_stats(&stats);
+        assert!(
+            format!("{got:?}").starts_with(&format!("Err({name}")),
+            "{name}: {got:?}"
+        );
+    }
+    // Within tolerance after all, or only finer: notes, not refusals.
+    let noted = PlanStats {
+        over_tolerance: vec![over(true)],
+        edges_capped: vec![capped(true)],
+        kept_strict: vec![edge("coarser sampling failed")],
+        ..none
+    };
+    match judge_stats(&noted) {
+        Ok(notes) => assert_eq!(notes.len(), 3, "{notes:?}"),
+        Err(e) => panic!("{e}"),
+    }
+}
+
+/// The deviation measure sees a moved edge node (parametric) and a surface
+/// put in the wrong place (analytic, independent of the plan's surface).
+#[test]
+fn the_deviation_measure_sees_a_moved_node_and_a_wrong_surface() {
+    let s = solid("box.step");
+    let (plan, _) = match solidcore_tess::plan(&s.record, &MeshTolerance::chord(TOL), 1.8) {
+        Ok(p) => p,
+        Err(e) => panic!("{e}"),
+    };
+    let stop = CancelToken::new();
+    let clean = match mesh_deviation::measure(&plan, &s.record, &stop) {
+        Ok(d) => d,
+        Err(e) => panic!("{e:?}"),
+    };
+    assert!(clean.largest() < 1e-9, "{clean:?}");
+    assert_eq!(clean.faces_analytic, 6);
+
+    // One shared edge node 0.1 mm off.
+    let mut moved = plan.clone();
+    let Some(p) = moved.faces.iter_mut().find_map(|f| f.fixed.first_mut()) else {
+        panic!("no edge node")
+    };
+    *p += Vec3::new(0.0, 0.0, 0.1);
+    let d = mesh_deviation::measure(&moved, &s.record, &stop);
+    assert!(
+        matches!(&d, Ok(d) if d.parametric > 0.05),
+        "moved node not seen: {d:?}"
+    );
+
+    // The record's own surface 0.1 mm off where the plan put the face: the
+    // plan's triangles agree with the plan's surface (parametric 0), the
+    // analytic measure, read from the record, sees the gap.
+    let mut wrong = s.record.clone();
+    let Some(solidcore_record::brep::Surface::Plane {
+        origin,
+        u_axis,
+        v_axis,
+    }) = wrong.faces.first_mut().map(|f| &mut f.surface)
+    else {
+        panic!("box.step face 0 is not a plane")
+    };
+    let n = [
+        u_axis[1] * v_axis[2] - u_axis[2] * v_axis[1],
+        u_axis[2] * v_axis[0] - u_axis[0] * v_axis[2],
+        u_axis[0] * v_axis[1] - u_axis[1] * v_axis[0],
+    ];
+    let len = (n[0] * n[0] + n[1] * n[1] + n[2] * n[2]).sqrt();
+    for i in 0..3 {
+        origin[i] += n[i] * 0.1 / len;
+    }
+    match mesh_deviation::measure(&plan, &wrong, &stop) {
+        Ok(d) => {
+            assert!(d.parametric < 1e-9 && d.analytic > 0.09, "{d:?}");
+            assert!(d.largest() > 0.09 && d.worst_face == Some(0), "{d:?}");
+        }
+        Err(e) => panic!("{e:?}"),
+    }
+    let cancelled = CancelToken::new();
+    cancelled.cancel();
+    assert!(mesh_deviation::measure(&plan, &s.record, &cancelled).is_err());
+}
+
+#[test]
+fn analytic_distances_are_the_closed_forms() {
+    use solidcore_record::brep::{Frame, Surface};
+    let frame = Frame {
+        origin: [0.0; 3],
+        x_axis: [1.0, 0.0, 0.0],
+        y_axis: [0.0, 1.0, 0.0],
+    };
+    let close = |s: &Surface, p: [f64; 3], want: f64| {
+        let got = analytic_distance(s, p);
+        assert!(
+            got.is_some_and(|d| (d - want).abs() < 1e-12),
+            "{s:?} at {p:?}: {got:?}, want {want}"
+        );
+    };
+    close(
+        &Surface::Plane {
+            origin: [0.0, 0.0, 1.0],
+            u_axis: [1.0, 0.0, 0.0],
+            v_axis: [0.0, 1.0, 0.0],
+        },
+        [3.0, 4.0, 3.5],
+        2.5,
+    );
+    close(
+        &Surface::Cylinder {
+            frame: frame.clone(),
+            radius: 2.0,
+        },
+        [3.0, 4.0, 9.0],
+        3.0,
+    );
+    close(
+        &Surface::Sphere {
+            frame: frame.clone(),
+            radius: 2.0,
+        },
+        [0.0, 3.0, 4.0],
+        3.0,
+    );
+    close(
+        &Surface::Torus {
+            frame: frame.clone(),
+            major_radius: 5.0,
+            minor_radius: 1.0,
+            tube_start: 0.0,
+        },
+        [5.0, 0.0, 3.0],
+        2.0,
+    );
+    // A 45-degree cone of radius 1 at z = 0, widening up: (3, 0, 0) is 2
+    // out radially, sqrt(2) off the slant line; past the apex (z = -1) the
+    // apex is the nearest point.
+    let cone = Surface::Cone {
+        frame,
+        radius_at_origin: 1.0,
+        half_angle: std::f64::consts::FRAC_PI_4,
+    };
+    close(&cone, [3.0, 0.0, 0.0], std::f64::consts::SQRT_2);
+    close(&cone, [0.0, 0.0, -3.0], 2.0);
+}
diff --git a/crates/kernel/tests/mesh_deviation_bench.rs b/crates/kernel/tests/mesh_deviation_bench.rs
new file mode 100644
index 00000000..b5a0e443
--- /dev/null
+++ b/crates/kernel/tests/mesh_deviation_bench.rs
@@ -0,0 +1,212 @@
+//! The machining-mesh deviation bench (M12.1, #940), kernel release lane:
+//! every STEP fixture under testdata/models meshed for machining at the
+//! app's chord caps (0.005 mm, #689; 0.01 mm, the metre file's floor in
+//! #864), with its triangle count, time and measured deviation, beside
+//! truck's mesh of the same file at the app's own target. The verdicts are
+//! pinned; the numbers are printed for the decision file.
+//!
+//! Both meshes are also judged by one common, mesher-blind measure: each
+//! triangle's 15 sample points against the NEAREST untrimmed analytic
+//! surface of the record's faces (a lower bound of the distance to the
+//! true face; "n/a" where the record has a spline or revolved face).
+//! Provenance: our own bench design; fixtures are the repo's own; truck's
+//! calls are the app's (crates/app/src/geometry/import/step.rs).
+//!
+//! Gate map (M12.1): covers camcraft_kernel::machining_mesh (heavy lane).
+
+mod step_util;
+
+use std::path::PathBuf;
+use std::time::Instant;
+
+use camcraft_kernel::P3;
+use camcraft_kernel::machining_mesh::machining_mesh;
+use camcraft_kernel::mesh_deviation::analytic_distance;
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::read_step;
+use solidcore::kernel::CancelToken;
+use solidcore_record::brep;
+use step_util::{CASE_TIMEOUT, TRUCK_MIN_TOL, bounded_cancel};
+use truck_meshalgo::prelude::*;
+use truck_stepio::r#in::Table;
+
+const TOLS: [f64; 2] = [0.005, 0.01];
+
+/// (file, mm per unit, pinned verdict at each of [`TOLS`]).
+const ROWS: &[(&str, f64, [&str; 2])] = &[
+    ("Milling-test-inch.step", 25.4, ["within", "within"]),
+    ("Milling-test.step", 1.0, ["within", "within"]),
+    ("box.step", 1.0, ["within", "within"]),
+    ("empty_list.step", 1.0, ["within", "within"]),
+    ("sample_ap214.step", 1000.0, ["within", "within"]),
+    ("tool_csys_box_iso13399.step", 1.0, ["within", "within"]),
+    ("tool_csys_degenerate.step", 1.0, ["no solid", "no solid"]),
+    ("tool_csys_iso13399.step", 1.0, ["no solid", "no solid"]),
+    ("tool_csys_none.step", 1.0, ["no solid", "no solid"]),
+];
+
+fn models() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models")
+}
+
+/// Barycentric 15-point grid (4 divisions a side).
+fn grid(a: P3, b: P3, c: P3) -> impl Iterator<Item = P3> {
+    (0..=4).flat_map(move |i| {
+        (0..=(4 - i)).map(move |j| {
+            let (u, v) = (i as f64 / 4.0, j as f64 / 4.0);
+            let w = 1.0 - u - v;
+            [0, 1, 2].map(|k| u * a[k] + v * b[k] + w * c[k])
+        })
+    })
+}
+
+/// The common measure: largest over samples of the distance to the nearest
+/// analytic face surface. `None` if any face is not analytic.
+fn nearest_analytic(records: &[&brep::Brep], pos: &[P3], tris: &[[usize; 3]]) -> Option<f64> {
+    let surfaces: Vec<&brep::Surface> = records
+        .iter()
+        .flat_map(|r| r.faces.iter().map(|f| &f.surface))
+        .collect();
+    if surfaces
+        .iter()
+        .any(|s| analytic_distance(s, [0.0; 3]).is_none())
+    {
+        return None;
+    }
+    let mut worst = 0.0_f64;
+    for t in tris {
+        let (a, b, c) = (*pos.get(t[0])?, *pos.get(t[1])?, *pos.get(t[2])?);
+        for p in grid(a, b, c) {
+            let d = surfaces
+                .iter()
+                .filter_map(|s| analytic_distance(s, p))
+                .fold(f64::INFINITY, f64::min);
+            worst = worst.max(d);
+        }
+    }
+    Some(worst)
+}
+
+/// truck's mesh of the file at the app's target for chord cap `cap` mm,
+/// scaled to mm: (positions, triangles, chord used in mm).
+/// A triangle soup and the chord it was made at (mm).
+type Soup = (Vec<P3>, Vec<[usize; 3]>, f64);
+
+fn truck_soup(bytes: &[u8], k: f64, cap: f64) -> Result<Soup, String> {
+    let text = std::str::from_utf8(bytes).map_err(|_| "not UTF-8".to_string())?;
+    let ex = ruststep::parser::parse(text).map_err(|e| format!("syntax: {e}"))?;
+    let table = Table::from_data_section(ex.data.first().ok_or("no DATA")?);
+    let mut ids: Vec<&u64> = table.shell.keys().collect();
+    ids.sort_unstable();
+    let (mut pos, mut tris, mut chord) = (Vec::new(), Vec::new(), 0.0_f64);
+    for id in ids {
+        let Some(shell) = table.shell.get(id) else {
+            continue;
+        };
+        let cs = table
+            .to_compressed_shell(shell)
+            .map_err(|e| e.to_string())?;
+        let extent = cs
+            .vertices
+            .iter()
+            .flat_map(|p| [p.x.abs(), p.y.abs(), p.z.abs()])
+            .fold(0.0_f64, f64::max);
+        let tol = (extent * 1e-3).min(cap / k).max(TRUCK_MIN_TOL);
+        chord = chord.max(tol * k);
+        let m = cs.robust_triangulation(tol).to_polygon();
+        let base = pos.len();
+        pos.extend(m.positions().iter().map(|p| [p.x * k, p.y * k, p.z * k]));
+        for f in m.face_iter() {
+            let Some(a) = f.first() else { continue };
+            for w in f.get(1..).unwrap_or_default().windows(2) {
+                if let [b, c] = w {
+                    tris.push([base + a.pos, base + b.pos, base + c.pos]);
+                }
+            }
+        }
+    }
+    if tris.is_empty() {
+        return Err("no triangles".into());
+    }
+    Ok((pos, tris, chord))
+}
+
+fn fmt(d: Option<f64>) -> String {
+    d.map_or("n/a".into(), |d| format!("{d:.2e}"))
+}
+
+#[test]
+#[ignore = "kernel release lane: meshes every STEP fixture twice per tolerance (cargo test --release -p camcraft-kernel -- --ignored)"]
+fn machining_mesh_deviation_bench() {
+    let mut observed = Vec::new();
+    for &(file, unit, _) in ROWS {
+        let bytes = std::fs::read(models().join(file)).unwrap_or_default();
+        assert!(!bytes.is_empty(), "{file}: fixture missing");
+        let b = bytes.clone();
+        let read = bounded_cancel(file, CASE_TIMEOUT, move |stop| {
+            read_step(&mut SolidcoreKernel::default(), &b, stop)
+        });
+        let solids = read.map(|r| r.solids).unwrap_or_default();
+        let mut verdicts = [String::new(), String::new()];
+        for (slot, tol) in verdicts.iter_mut().zip(TOLS) {
+            if solids.is_empty() {
+                *slot = "no solid".into();
+                println!("{file} @ {tol}: no solid");
+                continue;
+            }
+            let t0 = Instant::now();
+            let mut tris = 0usize;
+            let (mut par, mut ana, mut gate, mut mine) = (0.0_f64, 0.0_f64, 0.0_f64, Some(0.0_f64));
+            let mut verdict = "within".to_string();
+            let records: Vec<&brep::Brep> = solids.iter().map(|s| &s.record).collect();
+            for s in &solids {
+                match machining_mesh(s, tol, &CancelToken::new()) {
+                    Ok(m) => {
+                        tris += m.triangles.len();
+                        par = par.max(m.report.deviation.parametric);
+                        ana = ana.max(m.report.deviation.analytic);
+                        gate = gate.max(m.report.deviation.gated);
+                        let t: Vec<[usize; 3]> =
+                            m.triangles.iter().map(|t| t.map(|i| i as usize)).collect();
+                        mine = mine
+                            .zip(nearest_analytic(&records, &m.positions, &t))
+                            .map(|(a, b)| a.max(b));
+                        for n in &m.report.notes {
+                            println!("  note: {n}");
+                        }
+                    }
+                    Err(e) => verdict = format!("refused: {e}"),
+                }
+            }
+            let t_sc = t0.elapsed();
+            let t0 = Instant::now();
+            let truck = truck_soup(&bytes, unit, tol);
+            let t_tr = t0.elapsed();
+            let truck_line = match &truck {
+                Ok((p, t, chord)) => format!(
+                    "truck: tris={} chord={chord:.4} common={} ({t_tr:.1?})",
+                    t.len(),
+                    fmt(nearest_analytic(&records, p, t))
+                ),
+                Err(e) => format!("truck: {e}"),
+            };
+            println!(
+                "{file} @ {tol} mm: sc-tess tris={tris} judged={gate:.2e} parametric={par:.2e} analytic={ana:.2e} common={} ({t_sc:.1?}) | {truck_line} | {verdict}",
+                fmt(mine)
+            );
+            if verdict == "within" {
+                assert!(gate <= tol, "{file}: judged {gate} past {tol}");
+            }
+            *slot = verdict;
+        }
+        observed.push((file.to_string(), verdicts));
+    }
+    let pinned: Vec<(String, [String; 2])> = ROWS
+        .iter()
+        .map(|(f, _, v)| (f.to_string(), v.map(String::from)))
+        .collect();
+    assert_eq!(
+        observed, pinned,
+        "machining-mesh verdicts changed - re-triage"
+    );
+}
