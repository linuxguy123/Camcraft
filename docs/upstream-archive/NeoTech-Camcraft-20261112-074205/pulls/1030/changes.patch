@@ -0,0 +1,353 @@
+//! The machining mesh (M12.1, #940): a solidcore-imported solid meshed by
+//! solidcore-tess at a chord tolerance in millimetres, handed out ONLY when
+//! it is whole and measured inside the tolerance. solidcore-tess is a
+//! display mesher that names what it could not do and meshes the rest;
+//! here every such shortfall is a named [`MeshRefusal`] - a toolpath over
+//! a missing or loose face is a gouge. BENCH / SEAM ONLY: the app still
+//! meshes STEP through truck (#917 switches it).
+//! Provenance: our own seam design over the public API of solidcore-tess
+//! (the solidcore workspace's mesher, Apache-2.0, at the commit pinned in
+//! Cargo.toml; solidcore is the Apache-2.0 port of NVIDIA's SMLib). The
+//! watertightness count (each side used by exactly two triangles once
+//! equal positions are welded) is textbook mesh topology. No HSMWorks
+//! material consulted.
+
+use std::collections::HashMap;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+
+use solidcore::kernel::CancelToken;
+use solidcore_tess::{MeshTolerance, PlanStats, TessPlan};
+
+use crate::mesh_deviation::{self, Deviation, Unmeasured};
+use crate::solidcore_step::StepSolid;
+use crate::{P3, mesh_signed_volume};
+
+/// The most triangles one machining mesh may hold: the app's own import
+/// budget (`crates/app/src/geometry/import/mod.rs`, `MAX_FACETS`).
+pub const MAX_MACHINING_TRIANGLES: usize = 30_000_000;
+
+/// solidcore-tess silently meshes no finer than a millionth of the body's
+/// size; a tolerance under that is refused, never quietly coarsened.
+pub const MIN_TOL_FRACTION: f64 = 1e-6;
+
+/// A machining mesh: indexed triangles in millimetres, vertices welded by
+/// exact position (so a side is shared by index), outward-facing.
+#[derive(Debug, Clone, PartialEq)]
+pub struct MachiningMesh {
+    /// Welded vertex positions (mm).
+    pub positions: Vec<P3>,
+    /// Triangles, counter-clockwise seen from outside.
+    pub triangles: Vec<[u32; 3]>,
+    /// The record face of each triangle.
+    pub tri_face: Vec<u32>,
+    /// What was asked and what was measured.
+    pub report: MeshReport,
+}
+
+/// The guarantee a [`MachiningMesh`] comes with.
+#[derive(Debug, Clone, PartialEq)]
+pub struct MeshReport {
+    /// The chord tolerance asked for (mm).
+    pub tolerance_mm: f64,
+    /// Triangles in the mesh.
+    pub triangles: usize,
+    /// Record faces, every one with triangles.
+    pub faces: usize,
+    /// Sides used by one triangle only: always 0 in a handed-out mesh.
+    pub open_sides: usize,
+    /// The sampled deviation, `largest()` at or under `tolerance_mm`.
+    pub deviation: Deviation,
+    /// Enclosed volume of the mesh (mm^3), positive.
+    pub volume: f64,
+    /// What the planner noted that does not touch the guarantee (an edge
+    /// kept at a finer sampling, a display normal averaged at a pole, a
+    /// face the planner capped but measured within tolerance).
+    pub notes: Vec<String>,
+}
+
+/// Why no machining mesh was handed out. Each names what failed.
+#[derive(Debug, Clone, PartialEq, thiserror::Error)]
+pub enum MeshRefusal {
+    /// The tolerance is not a finite positive length, or is under
+    /// [`MIN_TOL_FRACTION`] of the body.
+    #[error("machining mesh: tolerance {tol} mm refused ({why})")]
+    Tolerance { tol: f64, why: String },
+    /// The planner refused the body.
+    #[error("machining mesh: the mesher refused the body: {0}")]
+    Planner(String),
+    /// A face has no triangles (planner or evaluator left it out).
+    #[error("machining mesh: face {face} left out: {reason}")]
+    FaceLeftOut { face: usize, reason: String },
+    /// A face every method refused and that was filled leniently.
+    #[error("machining mesh: face {face} filled leniently: {reason}")]
+    Lenient { face: usize, reason: String },
+    /// An edge that could not be sampled.
+    #[error("machining mesh: edge {edge} not sampled: {reason}")]
+    EdgeNotSampled { edge: usize, reason: String },
+    /// A memory bound of the planner left a face off its tolerance.
+    #[error("machining mesh: face {face} capped at {sag:.3e} mm sag, tolerance {tol:e} mm")]
+    FaceCapped { face: usize, sag: f64, tol: f64 },
+    /// An edge's sampling stopped with its chords off the curve.
+    #[error("machining mesh: edge {edge} capped at {sag:.3e} mm sag, tolerance {tol:e} mm")]
+    EdgeCapped { edge: usize, sag: f64, tol: f64 },
+    /// More triangles than [`MAX_MACHINING_TRIANGLES`].
+    #[error("machining mesh: {0} triangles is past the {MAX_MACHINING_TRIANGLES} budget")]
+    TooLarge(usize),
+    /// Sides used by one triangle (a hole), by more than two, or twice in
+    /// the same direction (a triangle turned over against its neighbour).
+    #[error(
+        "machining mesh: not watertight ({open} open, {over} over-shared, {turned} turned sides)"
+    )]
+    NotWatertight {
+        open: usize,
+        over: usize,
+        turned: usize,
+    },
+    /// The mesh encloses no positive volume (inside out or flat).
+    #[error("machining mesh: encloses volume {0} mm^3, not a positive one")]
+    Volume(f64),
+    /// A triangle could not be measured.
+    #[error("machining mesh: deviation not measurable: {0:?}")]
+    Unmeasured(Unmeasured),
+    /// The measured deviation is past the tolerance.
+    #[error(
+        "machining mesh: face {face:?} stands {measured:.3e} mm off its surface, tolerance {tol:e} mm"
+    )]
+    Deviation {
+        measured: f64,
+        tol: f64,
+        face: Option<u32>,
+    },
+    /// The caller's time bound.
+    #[error("machining mesh: stopped at its time bound ({0})")]
+    TimedOut(&'static str),
+}
+
+/// Every planner shortfall as a refusal or a note (decision per entry in
+/// docs/decisions/940-machining-mesh.md). `Err`: the first refusal.
+pub fn judge_stats(stats: &PlanStats) -> Result<Vec<String>, MeshRefusal> {
+    if let Some(r) = stats.unmeshed.first() {
+        return Err(MeshRefusal::FaceLeftOut {
+            face: r.face,
+            reason: r.reason.clone(),
+        });
+    }
+    if let Some(r) = stats.lenient.first() {
+        return Err(MeshRefusal::Lenient {
+            face: r.face,
+            reason: r.reason.clone(),
+        });
+    }
+    if let Some(r) = stats.unsampled_edges.first() {
+        return Err(MeshRefusal::EdgeNotSampled {
+            edge: r.edge,
+            reason: r.reason.clone(),
+        });
+    }
+    if let Some(o) = stats.over_tolerance.iter().find(|o| !o.within) {
+        return Err(MeshRefusal::FaceCapped {
+            face: o.face,
+            sag: o.sag,
+            tol: o.tol,
+        });
+    }
+    if let Some(c) = stats.edges_capped.iter().find(|c| !c.within) {
+        return Err(MeshRefusal::EdgeCapped {
+            edge: c.edge,
+            sag: c.sag,
+            tol: c.tol,
+        });
+    }
+    let mut notes = Vec::new();
+    for o in &stats.over_tolerance {
+        notes.push(format!(
+            "face {}: a planner bound limited it, measured {:.3e} mm within {:e} mm",
+            o.face, o.sag, o.tol
+        ));
+    }
+    for c in &stats.edges_capped {
+        notes.push(format!(
+            "edge {}: sampling stopped at {:?} with its chords within {:e} mm ({:.3e} mm)",
+            c.edge, c.cap, c.tol, c.sag
+        ));
+    }
+    for k in &stats.kept_strict {
+        notes.push(format!(
+            "edge {}: kept at its finer sampling ({})",
+            k.edge, k.reason
+        ));
+    }
+    for p in &stats.averaged_poles {
+        notes.push(format!(
+            "pole {p:?}: display normal averaged (positions unchanged)"
+        ));
+    }
+    Ok(notes)
+}
+
+/// The machining mesh of one imported solid at `tol_mm` (see the module
+/// docs). Bounds: the triangle budget, the planner's own memory bounds
+/// (each one that leaves the tolerance is a refusal), and `stop`, polled
+/// before and after planning and per face while measuring. The planner
+/// itself has no cancellation hook at the pinned commit: it runs to its
+/// end inside its memory bounds. A panic in the mesher becomes
+/// [`MeshRefusal::Planner`].
+pub fn machining_mesh(
+    solid: &StepSolid,
+    tol_mm: f64,
+    stop: &CancelToken,
+) -> Result<MachiningMesh, MeshRefusal> {
+    let record = &solid.record;
+    let size = body_size(record);
+    if !(tol_mm.is_finite() && tol_mm > 0.0) {
+        return Err(MeshRefusal::Tolerance {
+            tol: tol_mm,
+            why: "not a finite positive length".into(),
+        });
+    }
+    if !size.is_finite() || tol_mm < size * MIN_TOL_FRACTION {
+        return Err(MeshRefusal::Tolerance {
+            tol: tol_mm,
+            why: format!("under a millionth of the body's {size:.3e} mm size"),
+        });
+    }
+    if stop.is_cancelled() {
+        return Err(MeshRefusal::TimedOut("before planning"));
+    }
+    let tol = MeshTolerance::chord(tol_mm);
+    let planned = catch_unwind(AssertUnwindSafe(|| {
+        solidcore_tess::plan(record, &tol, size)
+    }))
+    .map_err(|_| MeshRefusal::Planner("the planner panicked".into()))?;
+    let (plan, stats) = planned.map_err(|e| MeshRefusal::Planner(e.to_string()))?;
+    if stop.is_cancelled() {
+        return Err(MeshRefusal::TimedOut("planning"));
+    }
+    let notes = judge_stats(&stats)?;
+    let planned_tris: usize = plan.faces.iter().map(|f| f.triangles.len()).sum();
+    if planned_tris > MAX_MACHINING_TRIANGLES {
+        return Err(MeshRefusal::TooLarge(planned_tris));
+    }
+    let deviation = mesh_deviation::measure(&plan, record, stop).map_err(|e| match e {
+        Unmeasured::Cancelled => MeshRefusal::TimedOut("measuring"),
+        other => MeshRefusal::Unmeasured(other),
+    })?;
+    // A NaN deviation is refused too.
+    if deviation.largest().is_nan() || deviation.largest() > tol_mm {
+        return Err(MeshRefusal::Deviation {
+            measured: deviation.largest(),
+            tol: tol_mm,
+            face: deviation.worst_face,
+        });
+    }
+    let mesh = evaluate(&plan, record.faces.len())?;
+    let (positions, triangles, tri_face) = weld(&mesh);
+    let (open, over, turned) = sides(&triangles);
+    if open > 0 || over > 0 || turned > 0 {
+        return Err(MeshRefusal::NotWatertight { open, over, turned });
+    }
+    let tris: Vec<[usize; 3]> = triangles.iter().map(|t| t.map(|i| i as usize)).collect();
+    let volume = mesh_signed_volume(&positions, &tris).unwrap_or(f64::NAN);
+    if !(volume.is_finite() && volume > 0.0) {
+        return Err(MeshRefusal::Volume(volume));
+    }
+    let report = MeshReport {
+        tolerance_mm: tol_mm,
+        triangles: triangles.len(),
+        faces: record.faces.len(),
+        open_sides: open,
+        deviation,
+        volume,
+        notes,
+    };
+    Ok(MachiningMesh {
+        positions,
+        triangles,
+        tri_face,
+        report,
+    })
+}
+
+/// The body's box diagonal from its vertices (the bench's size, mm).
+fn body_size(record: &solidcore_record::brep::Brep) -> f64 {
+    let (mut lo, mut hi) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+    for v in &record.vertices {
+        for (i, c) in v.point.into_iter().enumerate() {
+            lo[i] = lo[i].min(c);
+            hi[i] = hi[i].max(c);
+        }
+    }
+    let d = (0..3).map(|i| (hi[i] - lo[i]).powi(2)).sum::<f64>().sqrt();
+    if record.vertices.is_empty() { 0.0 } else { d }
+}
+
+/// The plan evaluated, every face with triangles, none refused.
+fn evaluate(plan: &TessPlan, faces: usize) -> Result<solidcore_tess::Mesh, MeshRefusal> {
+    let (mesh, refused) = catch_unwind(AssertUnwindSafe(|| plan.evaluate()))
+        .map_err(|_| MeshRefusal::Planner("the evaluator panicked".into()))?;
+    if let Some(r) = refused.first() {
+        return Err(MeshRefusal::FaceLeftOut {
+            face: r.face,
+            reason: r.reason.clone(),
+        });
+    }
+    let mut has = vec![false; faces];
+    for f in &mesh.tri_face {
+        if let Some(h) = has.get_mut(*f as usize) {
+            *h = true;
+        }
+    }
+    if let Some(face) = has.iter().position(|h| !h) {
+        return Err(MeshRefusal::FaceLeftOut {
+            face,
+            reason: "no triangles in the evaluated mesh".into(),
+        });
+    }
+    Ok(mesh)
+}
+
+/// Vertices welded by exact position (+0.0 and -0.0 are one); triangles
+/// that collapse onto a repeated vertex are dropped (they carry no area).
+fn weld(mesh: &solidcore_tess::Mesh) -> (Vec<P3>, Vec<[u32; 3]>, Vec<u32>) {
+    let mut ids: HashMap<[u64; 3], u32> = HashMap::new();
+    let mut positions: Vec<P3> = Vec::new();
+    let mut map: Vec<u32> = Vec::with_capacity(mesh.positions.len());
+    for p in &mesh.positions {
+        let q = [p.x, p.y, p.z];
+        let key = q.map(|c| (c + 0.0).to_bits());
+        let next = u32::try_from(positions.len()).unwrap_or(u32::MAX);
+        let id = *ids.entry(key).or_insert_with(|| {
+            positions.push(q);
+            next
+        });
+        map.push(id);
+    }
+    let mut tris = Vec::with_capacity(mesh.triangles.len());
+    let mut faces = Vec::with_capacity(mesh.triangles.len());
+    for (t, f) in mesh.triangles.iter().zip(&mesh.tri_face) {
+        let w = t.map(|i| map.get(i as usize).copied().unwrap_or(u32::MAX));
+        if w.contains(&u32::MAX) || w[0] == w[1] || w[1] == w[2] || w[2] == w[0] {
+            continue;
+        }
+        tris.push(w);
+        faces.push(*f);
+    }
+    (positions, tris, faces)
+}
+
+/// (sides used once, sides used more than twice, sides used twice in the
+/// same direction). Each use counts +1 running low-to-high index, -1 back.
+fn sides(tris: &[[u32; 3]]) -> (usize, usize, usize) {
+    let mut count: HashMap<(u32, u32), (u32, i32)> = HashMap::new();
+    for t in tris {
+        for (a, b) in [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])] {
+            let e = count.entry((a.min(b), a.max(b))).or_default();
+            e.0 = e.0.saturating_add(1);
+            e.1 += if a < b { 1 } else { -1 };
+        }
+    }
+    let open = count.values().filter(|n| n.0 == 1).count();
+    let over = count.values().filter(|n| n.0 > 2).count();
+    let turned = count.values().filter(|n| n.0 == 2 && n.1 != 0).count();
+    (open, over, turned)
+}
diff --git a/crates/kernel/src/mesh_deviation.rs b/crates/kernel/src/mesh_deviation.rs
new file mode 100644
index 00000000..c19e61b4
--- /dev/null
+++ b/crates/kernel/src/mesh_deviation.rs
@@ -0,0 +1,293 @@
+//! How far a solidcore-tess plan's triangles stand off the exact surfaces
+//! (M12.1, #940): sampled, per triangle, two ways - against the plan's own
+//! surface at the same (u, v), and against the record face's analytic
+//! surface by its closed-form distance. A measure, not a proof: see
+//! [`Deviation`] for exactly what is and is not covered.
+//! Provenance: our own design. Barycentric sampling and linear
+//! interpolation of a parametric triangle are textbook (Farin, "Curves and
+//! Surfaces for CAGD"); the point-to-plane, -cylinder, -cone, -sphere and
+//! -torus distances are closed-form (any analytic-geometry text). The
+//! plan's surfaces are evaluated through solidcore's public evaluator
+//! (Apache-2.0 port of NVIDIA's SMLib). No HSMWorks material consulted.
+
+use solidcore::kernel::CancelToken;
+use solidcore_record::brep::{self, Frame};
+use solidcore_tess::{EvalSurface, FacePlan, TessPlan};
+
+use crate::P3;
+
+/// Divisions per triangle side of the barycentric sampling grid: 4 gives
+/// 15 points per triangle - the corners, three points on each side
+/// (quarters and middle) and three inside.
+pub const SAMPLE_DIVISIONS: usize = 4;
+
+/// What [`measure`] found. Every distance in millimetres.
+///
+/// MEASURED, at each sample point of each triangle:
+/// - `parametric`: |S(u, v) - T(u, v)|, the distance between the plan
+///   surface's point at the sample's interpolated (u, v) and the triangle's
+///   own point there. It bounds, AT THE SAMPLE, both the distance from the
+///   triangle to the surface and from the surface to the triangle (each
+///   point is on its side), so it never under-reads there; on a strongly
+///   non-uniform parameterisation it can over-read (a false refusal, never
+///   a false pass). At a triangle corner on a shared edge node it is the
+///   gap between the edge's point and its face's surface.
+/// - `analytic`: the closed-form distance from the triangle's sample point
+///   to the record face's untrimmed analytic surface (plane, cylinder,
+///   cone, sphere, torus, the sphere of a ball patch). Independent of the
+///   mesher's own surface conversion: a conversion error shows here.
+///
+/// JUDGED (`gated`, what the tolerance is held against): per face, the
+/// `analytic` distance where the record face is analytic - the true
+/// distance from the triangle to the surface at the sample - else the
+/// `parametric` one. Why not `parametric` everywhere: on a rational
+/// spline's circle the parameter does not run at a constant speed along
+/// the arc, so the interpolated (u, v) lands a little along the arc from
+/// the triangle's point and the parametric distance over-reads the sag by
+/// a few per cent (Milling-test.step at 0.005 mm: 5.058e-3 parametric
+/// against 4.965e-3 true) - a refusal of a mesh that is inside its
+/// tolerance.
+///
+/// NOT MEASURED: the triangle between the samples (a sampled maximum is a
+/// lower bound of the true maximum; the error falls with the sampling
+/// density, not proven); the analytic measure on spline and revolved faces
+/// (counted in `faces_without_analytic`); the trim (a triangle sitting on
+/// the right surface outside its face's boundary is not caught here - the
+/// welded-mesh watertightness check is what binds faces to their edges).
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Deviation {
+    /// Largest `parametric` distance over every sample.
+    pub parametric: f64,
+    /// Largest `analytic` distance over every sample of an analytic face.
+    pub analytic: f64,
+    /// Largest judged distance (see above): what the tolerance binds.
+    pub gated: f64,
+    /// The record face of the largest judged distance.
+    pub worst_face: Option<u32>,
+    /// Sample points measured.
+    pub samples: usize,
+    /// Faces with triangles measured against an analytic surface too.
+    pub faces_analytic: usize,
+    /// Faces with triangles measured by `parametric` alone.
+    pub faces_without_analytic: usize,
+}
+
+impl Deviation {
+    /// The judged distance: what the tolerance is held against.
+    #[must_use]
+    pub fn largest(&self) -> f64 {
+        self.gated
+    }
+}
+
+/// Why a face's triangles could not be measured.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Unmeasured {
+    /// The face's triangles have no surface to evaluate.
+    NoSurface { face: u32 },
+    /// The surface has no point at a sample's parameters.
+    NoPoint { face: u32, uv: [f64; 2] },
+    /// A triangle names a node the face does not have.
+    BadIndex { face: u32 },
+    /// The caller's time bound.
+    Cancelled,
+}
+
+fn sub(a: P3, b: P3) -> P3 {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+fn dot(a: P3, b: P3) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+fn cross(a: P3, b: P3) -> P3 {
+    [
+        a[1] * b[2] - a[2] * b[1],
+        a[2] * b[0] - a[0] * b[2],
+        a[0] * b[1] - a[1] * b[0],
+    ]
+}
+fn norm(a: P3) -> f64 {
+    dot(a, a).sqrt()
+}
+fn unit(a: P3) -> Option<P3> {
+    let n = norm(a);
+    (n.is_finite() && n > 0.0).then(|| [a[0] / n, a[1] / n, a[2] / n])
+}
+
+/// The surface point at `(u, v)`, `None` where the surface has none.
+fn point(s: &EvalSurface, uv: [f64; 2]) -> Option<P3> {
+    let (p, _, _) = s.derivs(uv[0], uv[1])?;
+    let p = [p.x, p.y, p.z];
+    p.iter().all(|c| c.is_finite()).then_some(p)
+}
+
+/// A frame's origin, and its unit z axis and the point's height and radius
+/// about it.
+fn cylindrical(f: &Frame, p: P3) -> Option<(f64, f64)> {
+    let z = unit(cross(unit(f.x_axis)?, unit(f.y_axis)?))?;
+    let d = sub(p, f.origin);
+    let h = dot(d, z);
+    let rho = (dot(d, d) - h * h).max(0.0).sqrt();
+    Some((h, rho))
+}
+
+/// The distance from `p` to the untrimmed analytic surface of a record
+/// face, `None` for a surface with no closed form here (splines,
+/// revolutions) or a degenerate frame.
+#[must_use]
+pub fn analytic_distance(s: &brep::Surface, p: P3) -> Option<f64> {
+    use brep::Surface as S;
+    let d = match s {
+        S::Plane {
+            origin,
+            u_axis,
+            v_axis,
+        } => dot(sub(p, *origin), unit(cross(*u_axis, *v_axis))?).abs(),
+        S::PlaneThrough {
+            origin,
+            u_point,
+            v_point,
+        } => dot(
+            sub(p, *origin),
+            unit(cross(sub(*u_point, *origin), sub(*v_point, *origin)))?,
+        )
+        .abs(),
+        S::Cylinder { frame, radius } => (cylindrical(frame, p)?.1 - radius).abs(),
+        S::Sphere { frame, radius } => (norm(sub(p, frame.origin)) - radius).abs(),
+        S::BallPatch { center, radius } => (norm(sub(p, *center)) - radius).abs(),
+        S::Torus {
+            frame,
+            major_radius,
+            minor_radius,
+            ..
+        } => {
+            let (h, rho) = cylindrical(frame, p)?;
+            ((rho - major_radius).hypot(h) - minor_radius).abs()
+        }
+        S::Cone {
+            frame,
+            radius_at_origin,
+            half_angle,
+        } => {
+            // In the (radius, height) half-plane the cone is the half-line
+            // from (r0, 0) along (sin a, cos a), cut where the radius
+            // reaches 0 (the apex).
+            let (h, rho) = cylindrical(frame, p)?;
+            let (sa, ca) = half_angle.sin_cos();
+            let t = (rho - radius_at_origin) * sa + h * ca;
+            if radius_at_origin + t * sa >= 0.0 {
+                ((rho - radius_at_origin) * ca - h * sa).abs()
+            } else {
+                // Past the apex (only reachable with sin a != 0): r0 + h tan a = 0.
+                let apex_h = if sa != 0.0 {
+                    -radius_at_origin * ca / sa
+                } else {
+                    0.0
+                };
+                rho.hypot(h - apex_h)
+            }
+        }
+        S::Spline { .. } | S::RationalSpline { .. } | S::PlacedRevolution { .. } => return None,
+    };
+    d.is_finite().then_some(d)
+}
+
+/// The barycentric weights of the sampling grid.
+fn weights() -> Vec<[f64; 3]> {
+    let n = SAMPLE_DIVISIONS;
+    let mut w = Vec::with_capacity((n + 1) * (n + 2) / 2);
+    for i in 0..=n {
+        for j in 0..=(n - i) {
+            let (a, b) = (i as f64 / n as f64, j as f64 / n as f64);
+            w.push([a, b, (1.0 - a - b).max(0.0)]);
+        }
+    }
+    w
+}
+
+/// Measures every triangle of `plan` (see [`Deviation`]). `record` is the
+/// B-rep record the plan was made from (its face order). `stop` is polled
+/// per face.
+pub fn measure(
+    plan: &TessPlan,
+    record: &brep::Brep,
+    stop: &CancelToken,
+) -> Result<Deviation, Unmeasured> {
+    let w = weights();
+    let mut out = Deviation::default();
+    let mut worst = (0.0_f64, None);
+    for f in &plan.faces {
+        if stop.is_cancelled() {
+            return Err(Unmeasured::Cancelled);
+        }
+        if f.triangles.is_empty() {
+            continue;
+        }
+        let analytic = record.faces.get(f.face as usize).map(|rf| &rf.surface);
+        let has_analytic = analytic.is_some_and(|s| analytic_distance(s, [0.0; 3]).is_some());
+        if has_analytic {
+            out.faces_analytic += 1;
+        } else {
+            out.faces_without_analytic += 1;
+        }
+        let (p, a, n) = face(plan, f, analytic.filter(|_| has_analytic), &w)?;
+        out.parametric = out.parametric.max(p);
+        out.analytic = out.analytic.max(a);
+        out.samples = out.samples.saturating_add(n);
+        let g = if has_analytic { a } else { p };
+        out.gated = out.gated.max(g);
+        if g > worst.0 || worst.1.is_none() {
+            worst = (g, Some(f.face));
+        }
+    }
+    out.worst_face = worst.1;
+    Ok(out)
+}
+
+/// One face: (largest parametric, largest analytic, samples).
+fn face(
+    plan: &TessPlan,
+    f: &FacePlan,
+    analytic: Option<&brep::Surface>,
+    w: &[[f64; 3]],
+) -> Result<(f64, f64, usize), Unmeasured> {
+    let s = f
+        .surface
+        .and_then(|i| plan.surfaces.get(i as usize))
+        .ok_or(Unmeasured::NoSurface { face: f.face })?;
+    // The nodes as the evaluated mesh has them: a shared edge node's own
+    // point, else the surface's.
+    let mut nodes: Vec<P3> = Vec::with_capacity(f.uv.len());
+    for (k, uv) in f.uv.iter().enumerate() {
+        let p = match f.fixed.get(k) {
+            Some(q) => [q.x, q.y, q.z],
+            None => point(s, *uv).ok_or(Unmeasured::NoPoint {
+                face: f.face,
+                uv: *uv,
+            })?,
+        };
+        nodes.push(p);
+    }
+    let (mut pm, mut am, mut n) = (0.0_f64, 0.0_f64, 0usize);
+    for t in &f.triangles {
+        let get = |i: u32| {
+            let i = i as usize;
+            Some((*nodes.get(i)?, *f.uv.get(i)?))
+        };
+        let (Some(c0), Some(c1), Some(c2)) = (get(t[0]), get(t[1]), get(t[2])) else {
+            return Err(Unmeasured::BadIndex { face: f.face });
+        };
+        for b in w {
+            let mix = |x: [f64; 3]| b[0] * x[0] + b[1] * x[1] + b[2] * x[2];
+            let tp = [0, 1, 2].map(|i| mix([c0.0[i], c1.0[i], c2.0[i]]));
+            let uv = [0, 1].map(|i| mix([c0.1[i], c1.1[i], c2.1[i]]));
+            let sp = point(s, uv).ok_or(Unmeasured::NoPoint { face: f.face, uv })?;
+            pm = pm.max(norm(sub(sp, tp)));
+            if let Some(d) = analytic.and_then(|a| analytic_distance(a, tp)) {
+                am = am.max(d);
+            }
+            n = n.saturating_add(1);
+        }
+    }
+    Ok((pm, am, n))
+}
