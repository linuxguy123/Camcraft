+                Step::Add(name, _) => {
+                    if let Some(entity) = model::find_by_name(world, name) {
+                        model::remove(world, &entity);
+                    }
+                }
+                Step::Change { name, prev, .. } => put(world, name, prev),
+                Step::Remove(del) => del.invert(world),
             }
         }
     }
