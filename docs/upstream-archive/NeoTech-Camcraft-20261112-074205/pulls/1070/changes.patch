+fn put(world: &World, name: &str, tool: &Tool) {
+    if let Some(entity) = model::find_by_name(world, name) {
+        let number = model::tool_number_of(world, &entity);
+        entity.entity_view(world).set(ToolDef { tool: tool.clone(), number });
