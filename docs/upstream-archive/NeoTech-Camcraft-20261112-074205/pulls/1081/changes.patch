diff --git a/crates/sim/tests/coarse_collision.rs b/crates/sim/tests/coarse_collision.rs
new file mode 100644
index 000000000..1307db7c8
--- /dev/null
+++ b/crates/sim/tests/coarse_collision.rs
@@ -0,0 +1,257 @@
+//! #904: the collision laws on a model coarser than the importer
+//! promises. They judge clearance against material read off facets, and
+//! a facet of a convex wall stands INSIDE the true surface by its chord
+//! error - so a clearance can read that much too generous. With
+//! `VerifyContext::model_excess` set, while it leaves the gouge
+//! tolerance positive:
+//!
+//! - law (c), shank and holder reach, grows each band by the excess
+//!   (`VerifyContext::band_growth`), and its mid-turn sweep (c3) with it;
+//! - law (d), rapids in stock, gives the excess back out of the slack of
+//!   the footprint it marches, and its posed second reading out of the
+//!   depth it lets a leaning stack stand in the part.
+//!
+//! Past that every law reads exactly as at full fidelity (the program
+//! gate refuses the operation instead), and an excess of 0 changes
+//! nothing.
+//!
+//! Provenance: our own fixtures; the sagitta `R * (1 - cos(pi / n))` of
+//! an inscribed n-gon is elementary geometry. No vendor material.
+//!
+//! Gate map (#904): covers camcraft_sim::verify (excess, reach, sweep,
+//! rapids, rapids_posed).
+
+use camcraft_sim::cl::{Move, MoveKind, Toolpath};
+use camcraft_sim::geo2d::{Loop, Point2, Region};
+use camcraft_sim::geometry::{cube, Point3, Triangle};
+use camcraft_sim::verify::{verify, Mode, ToolGeom, VerifyContext, Warning};
+
+/// The importer's promise, the gouge tolerance, and an excess that
+/// leaves 0.003 mm of it (a 0.012 mm mesh).
+const CAP: f64 = 0.005;
+const TOL: f64 = 0.01;
+const EXCESS: f64 = 0.007;
+
+fn region(pts: Vec<Point2>) -> Region {
+    match Loop::new(pts).and_then(|l| Region::new(vec![l])) {
+        Ok(r) => r,
+        Err(e) => panic!("region: {e:?}"),
+    }
+}
+
+fn square(h: f64) -> Region {
+    region(vec![Point2::new(-h, -h), Point2::new(h, -h), Point2::new(h, h), Point2::new(-h, h)])
+}
+
+fn path(moves: Vec<Move>) -> Toolpath {
+    Toolpath { moves, cycles: Vec::new(), notes: Vec::new(), comps: Vec::new(), threads: Vec::new(), probes: Vec::new(), breaks: Vec::new(), plasma: None }
+}
+
+fn mv(kind: MoveKind, a: (f64, f64, f64), b: (f64, f64, f64), axis: Option<[f64; 3]>) -> Move {
+    let mut m = Move::new(kind, Point3::new(a.0, a.1, a.2), Point3::new(b.0, b.1, b.2), (kind != MoveKind::Rapid).then_some(300.0));
+    m.axis = axis;
+    m
+}
+
+// ---- (c) and (c3): the band stack ----------------------------------------
+
+/// A 6 mm cutter under a 20 mm holder whose bottom stands 10 mm above
+/// the tip.
+fn held() -> ToolGeom {
+    ToolGeom { radius: 3.0, nose_radius: 0.0, flute_len: 5.0, shank_radius: 3.0, shank_len: 5.0, holder_radius: 10.0, holder_len: 5.0 }
+}
+
+/// The 80 mm block's X = 40 wall is sampled 0.05 mm inside its middle
+/// (the reach law's own nudge): the holder's rim stands `gap` short of
+/// that sample when the tip is here.
+fn tip_x(gap: f64) -> f64 {
+    40.0 - 0.05 - 10.0 - gap
+}
+
+fn block_verdict(p: &Toolpath, excess: f64) -> Vec<Warning> {
+    let (block, tool) = (square(40.0), held());
+    let cx = VerifyContext {
+        region: &block,
+        stock: Some(&block),
+        tool: &tool,
+        mode: Mode::Area,
+        stock_top_z: 25.0,
+        clearance_z: 35.0,
+        gouge_tol: TOL,
+        z_tol: 1e-6,
+        model_excess: excess,
+        ..Default::default()
+    };
+    verify(p, &cx)
+}
+
+#[test]
+fn a_holder_clearing_a_wall_by_less_than_the_excess_is_convicted_on_a_coarse_model() {
+    // A plunge to Z 5: the holder's bottom at Z 15, under the Z 25 top,
+    // its rim 0.004 mm short of the uncut wall.
+    let plunge = |gap: f64| path(vec![mv(MoveKind::Plunge, (tip_x(gap), 0.0, 30.0), (tip_x(gap), 0.0, 5.0), None)]);
+    let near = plunge(0.004);
+    assert!(block_verdict(&near, 0.0).is_empty(), "full fidelity keeps today's verdict: {:?}", block_verdict(&near, 0.0));
+    assert_eq!(block_verdict(&near, EXCESS), vec![Warning::ShankHit { at: 0, part: false }]);
+    // Clear by more than the excess: clean on the coarse model too.
+    let clear = plunge(0.008);
+    assert!(block_verdict(&clear, EXCESS).is_empty(), "the growth is the excess, no more");
+    // In the wall: convicted either way.
+    let hit = plunge(-0.5);
+    assert!(!block_verdict(&hit, 0.0).is_empty() && !block_verdict(&hit, EXCESS).is_empty());
+    // Past the tolerance the law reads untightened (the gate refuses).
+    for excess in [TOL, 0.02, 0.5] {
+        assert_eq!(block_verdict(&near, excess), block_verdict(&near, 0.0), "excess {excess}");
+    }
+}
+
+#[test]
+fn the_mid_turn_sweep_grows_the_band_the_same_way() {
+    // The same plunge, turning 5 degrees AWAY from the wall as it sinks:
+    // at its end pose the leaning holder is a millimetre clear, so law
+    // (c) is silent - but the upright start pose is reachable all the way
+    // down (the head may arrive late), 0.004 mm from the wall.
+    let lean = [-(5.0_f64.to_radians().sin()), 0.0, 5.0_f64.to_radians().cos()];
+    let turning = path(vec![mv(MoveKind::Plunge, (tip_x(0.004), 0.0, 30.0), (tip_x(0.004), 0.0, 5.0), Some(lean))]);
+    assert!(block_verdict(&turning, 0.0).is_empty(), "{:?}", block_verdict(&turning, 0.0));
+    assert_eq!(block_verdict(&turning, EXCESS), vec![Warning::SweepHit { at: 0, part: false }]);
+    for excess in [TOL, 0.5] {
+        assert!(block_verdict(&turning, excess).is_empty(), "past the bound: untightened (excess {excess})");
+    }
+}
+
+// ---- (d): rapids ----------------------------------------------------------
+
+const BOSS_R: f64 = 20.0;
+const SIDES: usize = 90;
+
+/// A round boss as its coarse mesh shows it: the inscribed 90-gon, whose
+/// sides stand 0.0122 mm inside the true circle at their middles. One
+/// side's middle is at the top (+Y).
+fn coarse_boss() -> Region {
+    region(
+        (0..SIDES)
+            .map(|k| {
+                let a = std::f64::consts::TAU * k as f64 / SIDES as f64;
+                Point2::new(BOSS_R * a.cos(), BOSS_R * a.sin())
+            })
+            .collect(),
+    )
+}
+
+fn chord() -> f64 {
+    BOSS_R * (1.0 - (std::f64::consts::PI / SIDES as f64).cos())
+}
+
+/// A rapid at Z 5 (boss top Z 10) past the top of the boss, its 6 mm
+/// radius cutter standing `into` mm inside the TRUE circle.
+fn rapid_past(into: f64, excess: f64) -> Vec<Warning> {
+    let y = BOSS_R + 6.0 - into;
+    let p = path(vec![mv(MoveKind::Rapid, (-3.5, y, 5.0), (3.5, y, 5.0), None)]);
+    let boss = coarse_boss();
+    let tool = ToolGeom { radius: 6.0, nose_radius: 0.0, flute_len: 20.0, shank_radius: 6.0, shank_len: 20.0, holder_radius: 6.0, holder_len: 10.0 };
+    let cx = VerifyContext {
+        region: &boss,
+        stock: Some(&boss),
+        tool: &tool,
+        mode: Mode::Area,
+        stock_top_z: 10.0,
+        clearance_z: 20.0,
+        gouge_tol: TOL,
+        z_tol: 1e-6,
+        model_excess: excess,
+        ..Default::default()
+    };
+    verify(&p, &cx)
+}
+
+#[test]
+fn a_rapid_grazing_a_convex_wall_inside_the_mesh_error_is_convicted_on_a_coarse_model() {
+    let c = chord();
+    assert!(c > 0.012 && c < 0.0125, "the fixture's chord error: {c}");
+    let excess = c - CAP;
+    // 0.018 mm into the real boss. Against the mesh the cutter is only
+    // 0.0058 mm in, inside the footprint's 0.01 mm slack: clean today.
+    assert!(rapid_past(0.018, 0.0).is_empty(), "{:?}", rapid_past(0.018, 0.0));
+    assert_eq!(rapid_past(0.018, excess), vec![Warning::RapidInStock { at: 0 }], "the excess convicts it");
+    // A rapid tangent to the true circle is clean both ways; one a tenth
+    // of a millimetre in is convicted both ways.
+    assert!(rapid_past(0.0, 0.0).is_empty() && rapid_past(0.0, excess).is_empty());
+    assert!(!rapid_past(0.1, 0.0).is_empty() && !rapid_past(0.1, excess).is_empty());
+    // Past the tolerance: untightened.
+    for excess in [TOL, 0.5] {
+        assert!(rapid_past(0.018, excess).is_empty(), "excess {excess}");
+    }
+}
+
+// ---- (d), the posed second reading ---------------------------------------
+
+/// The posed-rapid suite's part: a post X/Y [-5, 5], Z [0, 10] under a
+/// ledge X [-5, 15], Y [-5, 5], Z [10, 12].
+fn ledge() -> Vec<Triangle> {
+    let mut f: Vec<Triangle> = cube(Point3::new(-5.0, -5.0, 0.0), Point3::new(5.0, 5.0, 10.0)).facets.to_vec();
+    f.extend(cube(Point3::new(-5.0, -5.0, 10.0), Point3::new(15.0, 5.0, 12.0)).facets.iter().cloned());
+    f
+}
+
+/// A rapid under the ledge in `Mode::Envelope` (the posed kinds' mode:
+/// the solid law (b2) stands down, so the posed reading is the rapid's
+/// whole verdict against the part), leaning 60 degrees toward -Y, its
+/// flute's top edge raised `up` mm past where it meets the ledge's
+/// underside. The cut it leaves was judged at a 0.05 mm finish
+/// tolerance, so the reading forgives 0.06 mm of the part - measured
+/// across the lean, which is 0.0486 mm of `up` here; with the excess
+/// taken out, 0.0405 mm.
+fn posed_under_ledge(up: f64, excess: f64) -> Vec<Warning> {
+    let lean = [0.0, -(60.0_f64.to_radians().sin()), 60.0_f64.to_radians().cos()];
+    // The flute's top edge: 4 mm up the axis, 3 mm out across it.
+    let rise = 4.0 * lean[2] + 3.0 * 60.0_f64.to_radians().sin();
+    let z = 10.0 - rise + up;
+    let p = path(vec![mv(MoveKind::Rapid, (9.0, 0.0, z), (13.0, 0.0, z), Some(lean))]);
+    let facets = ledge();
+    let shadow = region(vec![Point2::new(-5.0, -5.0), Point2::new(15.0, -5.0), Point2::new(15.0, 5.0), Point2::new(-5.0, 5.0)]);
+    let tool = ToolGeom { radius: 3.0, nose_radius: 0.0, flute_len: 4.0, shank_radius: 1.5, shank_len: 40.0, holder_radius: 1.5, holder_len: 10.0 };
+    let cx = VerifyContext {
+        region: &shadow,
+        stock: Some(&shadow),
+        model: Some(&facets),
+        tool: &tool,
+        mode: Mode::Envelope,
+        stock_top_z: 12.0,
+        clearance_z: 30.0,
+        gouge_tol: TOL,
+        z_tol: 1e-3,
+        finish_tol: Some(0.05),
+        model_excess: excess,
+        ..Default::default()
+    };
+    verify(&p, &cx).into_iter().filter(|w| matches!(w, Warning::RapidInStock { .. })).collect()
+}
+
+#[test]
+fn a_posed_rapid_standing_in_the_part_by_less_than_the_excess_is_convicted_on_a_coarse_model() {
+    // Between the two allowances: acquitted today, convicted on the
+    // coarse model.
+    assert!(posed_under_ledge(0.0445, 0.0).is_empty(), "{:?}", posed_under_ledge(0.0445, 0.0));
+    assert_eq!(posed_under_ledge(0.0445, EXCESS), vec![Warning::RapidInStock { at: 0 }]);
+    // Clear of the ledge: acquitted both ways. Well inside it: convicted.
+    assert!(posed_under_ledge(-0.05, 0.0).is_empty() && posed_under_ledge(-0.05, EXCESS).is_empty());
+    assert!(!posed_under_ledge(0.5, 0.0).is_empty() && !posed_under_ledge(0.5, EXCESS).is_empty());
+    // The allowance is gouge + finish tolerance, 0.06 mm: an excess that
+    // uses up the 0.01 mm gouge tolerance (where the gate refuses) still
+    // leaves it positive, so it keeps tightening - never loosening.
+    assert_eq!(posed_under_ledge(0.0445, 0.02), vec![Warning::RapidInStock { at: 0 }]);
+    // Nothing positive left: it reads untightened.
+    assert!(posed_under_ledge(0.0445, 0.5).is_empty());
+}
+
+#[test]
+fn full_fidelity_grows_nothing() {
+    let cx = VerifyContext { gouge_tol: TOL, ..Default::default() };
+    assert_eq!(cx.band_growth(), 0.0);
+    let coarse = VerifyContext { gouge_tol: TOL, model_excess: EXCESS, ..Default::default() };
+    assert!((coarse.band_growth() - EXCESS).abs() < 1e-12);
+    assert!((coarse.tightened(TOL) + coarse.band_growth() - TOL).abs() < 1e-12, "what the kerf loses, the band gains");
+    let past = VerifyContext { gouge_tol: TOL, model_excess: 0.02, ..Default::default() };
+    assert_eq!(past.band_growth(), 0.0, "past the bound the gate refuses; the laws read untightened");
+}
diff --git a/crates/sim/tests/model_excess.rs b/crates/sim/tests/model_excess.rs
index be859c5fa..de234c2ba 100644
--- a/crates/sim/tests/model_excess.rs
+++ b/crates/sim/tests/model_excess.rs
@@ -9,11 +9,12 @@
 //! Provenance: our own fixtures; the sagitta `R * (1 - cos(pi / n))` of an
 //! inscribed n-gon is elementary geometry. No vendor material.
 //!
-//! Gate map (#864): covers camcraft_sim::verify (types, section).
+//! Gate map (#864, #904): covers camcraft_sim::verify (excess, section,
+//! finish).
 
 use camcraft_sim::cl::{Move, MoveKind, Toolpath};
 use camcraft_sim::geo2d::{Loop, Point2, Region};
-use camcraft_sim::geometry::Point3;
+use camcraft_sim::geometry::{Point3, Triangle};
 use camcraft_sim::verify::{excess_floor, verify, Mode, ToolGeom, VerifyContext, Warning};
 
 /// The importer's promise and the verdict tolerance, mm.
@@ -156,3 +157,85 @@ fn the_excess_floor_only_ever_tightens() {
     assert_eq!(cx.model_excess, 0.0);
     assert_eq!(cx.tightened(TOL), TOL);
 }
+
+// ---- law (f): the envelope's gouge half (#904) ---------------------------
+
+/// A 6 mm ball rastered over a flat 40 mm plate (top Z 0) with its tip
+/// `d` mm below the surface: 0.5 mm passes, well inside the scallop.
+fn sunk_raster(d: f64) -> Toolpath {
+    let mut moves = Vec::new();
+    let (mut y, mut right) = (-12.0, true);
+    while y <= 12.0 + 1e-9 {
+        let (x0, x1) = if right { (-12.0, 12.0) } else { (12.0, -12.0) };
+        moves.push(Move::new(MoveKind::Feed, Point3::new(x0, y, -d), Point3::new(x1, y, -d), Some(600.0)));
+        if y + 0.5 <= 12.0 + 1e-9 {
+            moves.push(Move::new(MoveKind::Feed, Point3::new(x1, y, -d), Point3::new(x1, y + 0.5, -d), Some(600.0)));
+        }
+        y += 0.5;
+        right = !right;
+    }
+    Toolpath { moves, cycles: Vec::new(), notes: Vec::new(), comps: Vec::new(), threads: Vec::new(), probes: Vec::new(), breaks: Vec::new(), plasma: None }
+}
+
+fn plate() -> Vec<Triangle> {
+    let p = |x: f64, y: f64| Point3::new(x, y, 0.0);
+    vec![Triangle::new(p(-20.0, -20.0), p(20.0, -20.0), p(20.0, 20.0)), Triangle::new(p(-20.0, -20.0), p(20.0, 20.0), p(-20.0, 20.0))]
+}
+
+/// The envelope verdict's gouge reading of `path`, `None` when silent.
+fn envelope_gouge(path: &Toolpath, mode: Mode, finish_tol: f64, excess: f64) -> Option<f64> {
+    let (facets, wall) = (plate(), region(vec![Point2::new(-20.0, -20.0), Point2::new(20.0, -20.0), Point2::new(20.0, 20.0), Point2::new(-20.0, 20.0)]));
+    let ball = ToolGeom { radius: 3.0, nose_radius: 0.0, flute_len: 20.0, shank_radius: 3.0, shank_len: 20.0, holder_radius: 3.0, holder_len: 10.0 };
+    let cx = VerifyContext {
+        region: &wall,
+        model: Some(&facets),
+        tool: &ball,
+        mode,
+        stock_top_z: 0.0,
+        clearance_z: 20.0,
+        gouge_tol: TOL,
+        z_tol: 1e-6,
+        finish_tol: Some(finish_tol),
+        model_excess: excess,
+        ..Default::default()
+    };
+    verify(path, &cx).iter().find_map(|w| match w {
+        Warning::Envelope { gouge_mm, .. } => Some(*gouge_mm),
+        _ => None,
+    })
+}
+
+#[test]
+fn the_envelope_laws_gouge_half_answers_to_the_tolerance_less_the_excess() {
+    // The posed kinds (5-axis, rotary) and the turning nose kinds are
+    // judged by this law alone: a posed ball is the same ball about the
+    // same centre. Its gate is the finish tolerance plus the scan's own
+    // quantization floor (the ball's sagitta across one cell).
+    const FINISH: f64 = 0.05;
+    let cell = match camcraft_sim::stock_sim::envelope_scan(&plate(), &sunk_raster(0.0).moves, 3.0, FINISH) {
+        Ok(rep) => rep.cell,
+        Err(e) => panic!("the scan measures the plate: {e:?}"),
+    };
+    let gate = FINISH + cell * cell / 6.0;
+    let excess = 0.007;
+    for mode in [Mode::Envelope, Mode::Rotary] {
+        // 0.004 mm inside the gate: silent at full fidelity, convicted
+        // with a 0.007 mm excess - and measured, not invented.
+        let near = sunk_raster(gate - 0.004);
+        assert_eq!(envelope_gouge(&near, mode, FINISH, 0.0), None, "{mode:?}: today's verdict");
+        let g = envelope_gouge(&near, mode, FINISH, excess).unwrap_or(0.0);
+        assert!((g - (gate - 0.004)).abs() < 1e-6, "{mode:?}: convicted at its own depth, {g}");
+        // 0.009 mm inside the gate: silent on the coarse model too.
+        assert_eq!(envelope_gouge(&sunk_raster(gate - 0.009), mode, FINISH, excess), None, "{mode:?}");
+        // On the surface: never a gouge, whatever the excess.
+        for e in [0.0, excess, FINISH, 0.5] {
+            assert_eq!(envelope_gouge(&sunk_raster(0.0), mode, FINISH, e), None, "{mode:?}, excess {e}");
+        }
+        // Past the tolerance the law reads untightened; a real gouge
+        // is one at every excess.
+        assert_eq!(envelope_gouge(&near, mode, FINISH, FINISH), None, "{mode:?}: the gate refuses instead");
+        for e in [0.0, excess, FINISH, 0.5] {
+            assert!(envelope_gouge(&sunk_raster(0.3), mode, FINISH, e).is_some_and(|g| g > 0.29), "{mode:?}, excess {e}");
+        }
+    }
+}
diff --git a/docs/decisions/904-reduced-fidelity-laws.md b/docs/decisions/904-reduced-fidelity-laws.md
new file mode 100644
index 000000000..2c4f30f3b
--- /dev/null
+++ b/docs/decisions/904-reduced-fidelity-laws.md
@@ -0,0 +1,107 @@
+## #904 - reduced-fidelity models: turning, the rotary kinds and the multi-axis ball kinds are judged, not only refused; the collision laws read the excess
+
+**What was decided.** #864 flagged a STEP model imported coarser than
+promised, tightened the upright mill kinds' gouge laws by the model's excess
+(chord error less the 0.005 mm promise) and refused every other kind outright.
+This slice takes three families off the refused list and makes the collision
+laws read the excess. The rule is the one #864 set, unchanged: a tolerance
+gives the excess back while a positive tolerance is left
+(`verify::excess_floor`); past that the law reads untightened and the program
+gate refuses the operation by name.
+
+1. *Turning.* The band kinds (groove rough and finish, part, threading, form)
+   are judged by the meridian scan. Its gouge clause now answers to the
+   tolerance less the excess (`turning::gouge_tol_on`, the `_excess` twins of
+   `blade_warnings`, `thread_warnings`, `form_warnings` and
+   `blade_program_warnings`). The rest clause and the silhouette's chord
+   budget keep the operation's tolerance. The nose kinds (facing, profile,
+   chamfer, taper, multi-pass, boring) are judged by the envelope law (f),
+   which #864 already tightened. The meridian rapid, bar-feed and holder scans
+   take a tightened margin.
+2. *Rotary.* Law (f) again, plus the radial field law: its band allowance and
+   its rapid allowance each give the excess back (`rotary_law::rotary_into`).
+3. *Multi-axis ball kinds* (5-axis contour and parallel, flow, multi-axis
+   contour and rough). Their whole gouge verdict is law (f): a posed ball is
+   the same ball about the same centre, so the envelope scan does not see the
+   pose. Nothing new had to be tightened; they were refused only because the
+   generator's stamp and ramp proofs do not read the excess, and those proofs
+   are re-measured by (f).
+4. *Collision laws* (the P1 raise from PR #911's review). In `verify`: the
+   reach law (c) and its mid-turn sweep (c3) grow each shank and holder band
+   by the excess and shrink the kerf that excuses the flutes' own cut; the
+   rapid law (d) gives the excess back out of its footprint's slack, and its
+   posed second reading out of the depth it lets a leaning stack stand in the
+   part.
+5. *The floor is per kind* (`fidelity_law::floor_of`): the smallest of the
+   0.01 mm laws, the envelope tolerance, the meridian scan's tolerance and a
+   Part's inspection ask. A groove held to 0.004 mm is refused on a metre-unit
+   file (0.005 mm of excess) while a 0.05 mm groove on the same file is judged.
+6. *The setup's stock counts.* The collision laws read clearance against the
+   stock. The excess an operation is judged with is now the worse of its
+   source and its setup's stock (`material::judged_material`), and the gate
+   reads the same pair (`model_fidelity::op_coarse`).
+
+**Why.** A metre-unit STEP file is always reduced fidelity, so before this no
+lathe or 4/5-axis job could post from one. A refusal was the safe stand-in;
+the laws themselves are simple to tighten because each is a comparison of a
+measured depth with a tolerance. The collision laws were named by the
+high-tier review: while an operation still posts they could read a clearance
+up to 0.01 mm too generous on a convex wall.
+
+**Decisions taken unattended.**
+
+- *Swarf and advanced swarf stay refused.* The flank that does the cutting is
+  proved clear only inside the generator (`multiaxis::stamp_pose`,
+  `flank_clear` at the plan tolerance). No verify law re-measures it, so
+  there is no verdict to tighten. Making the proof read the excess changes
+  generated paths; it is filed as its own issue.
+- *The cone and engrave rides, probe, the cross drill and plasma stay
+  refused,* as #864 left them: construction laws or their own modules.
+  `rapids_radial` (the cross drill's rapid law) is not tightened either; it
+  only ever judges a kind that is refused.
+- *The excess is taken out along the law's own measure.* The radial field law
+  measures along a ray out of the axis, the posed rapid reading across the
+  lean. On a surface oblique to that measure the mesh can stand further off
+  than its chord error says. The field law's stated resolution is its 0.25 mm
+  cell, so this is inside what the law already declares it cannot see; #864's
+  laws make the same reading. Not corrected for curvature or obliquity.
+- *The stock's excess tightens the gouge laws too.* One number for every law
+  is the worse of source and stock. In the common cases (a box or cylinder
+  stock, or a stock copied from the part) it changes nothing. A fine part in
+  a stock copied from a different, coarser model is now tightened and can be
+  refused by that model's name, where #864 judged it plainly. Two numbers
+  (one for gouge laws, one for collision laws) were considered and dropped:
+  more plumbing through the job for a rare case, and the single number can
+  only be stricter.
+- *Each law tightens against its own tolerance, as #864's laws do.* A
+  threading scan held to 0.05 mm still has 0.025 mm left on a 0.030 mm mesh
+  and keeps convicting with it, although the 0.01 mm laws have nothing left
+  and the gate refuses the operation. The posed rapid reading (gouge plus
+  finish tolerance) behaves the same way. A law is never looser than at full
+  fidelity; "reads untightened" applies to each law past its own tolerance.
+- *Twins, not changed signatures.* `blade_warnings` and its siblings keep
+  their arguments and forward to `*_excess` with 0, so the 25 existing call
+  sites in the turning suites are untouched (#864 made the same choice with
+  `VerifyContext::default`).
+- *Three files were split to stay under the 400-line law:* the blade
+  judgments out of `revolve.rs` (`blade_law.rs`), the threading verdicts out
+  of `thread.rs` (`thread_law.rs`), and the excess readings out of
+  `verify/types.rs` (`verify/excess.rs`). Structure only.
+
+**Considered and dropped.**
+- Threading the excess into the multi-axis generators (stamp, ramp, link
+  proofs) for the ball kinds: not needed for soundness, because law (f)
+  re-measures every ball they place, and it would change generated paths.
+- Growing collision bands without a bound: past the tolerance the gate
+  refuses, and an untightened reading keeps the "no misleading verdict off a
+  mesh that cannot carry one" rule #864 set.
+- A document-level fixture for the turning margin and the rotary allowances:
+  no generator emits a marginal graze on demand. They are pinned at the law
+  with the value generation hands it; threading and the probe ask are pinned
+  through the document.
+
+**Cost to change later.** Low. Each tightening is one call to
+`excess_floor` at the law's own tolerance; the per-kind table is
+`operation::fidelity_law` (its header says which law judges which kind).
+Taking swarf off the refused list is threading the excess into `flank_clear`
+and deleting its line in `excess_aware`.

