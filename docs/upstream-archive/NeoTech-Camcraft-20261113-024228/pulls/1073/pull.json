  "title": "fix(sim,app): read a containment kind's declared rim at the plain gouge tolerance on a reduced-fidelity model",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
    "gravatar_id": "",
