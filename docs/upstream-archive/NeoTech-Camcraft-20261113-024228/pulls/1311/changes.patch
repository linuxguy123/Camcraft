--- a/crates/post/tests/recorded/mod.rs
+++ b/crates/post/tests/recorded/mod.rs
@@ -78,6 +78,42 @@ pub fn here() -> PathBuf {
     Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/recorded")
 }
 
+/// A recorded input of the suites that moved out of app (#926 slice 2):
+/// `recorded/inputs/<name>` (a `.cnc` stream or a `.cl` path), each
+/// written and guarded by its generator - app's `recorded_post_streams`
+/// (the probe cycles), motion's `vertical_arc_entry` (the contour paths),
+/// post's `inverted_post` (the inverted-axis fixture stream).
+pub fn input(name: &str) -> String {
+    let path = here().join("inputs").join(name);
+    std::fs::read_to_string(&path)
+        .unwrap_or_else(|e| panic!("no recorded input {}: {e}", path.display()))
+        .replace("\r\n", "\n")
+}
+
+/// [`input`] parsed as a `.cnc` record stream.
+pub fn input_records(name: &str) -> Vec<camcraft_post::post::cnc::Record> {
+    camcraft_post::post::cnc::parse(&input(name)).unwrap_or_else(|e| panic!("{name}: {e}"))
+}
+
+/// The conformance and dialect goldens of the moved suites stay where the
+/// rest of their family lives, `crates/app/tests/golden/` (one golden
+/// home is #919's sub-issue 6, not this move): compare `text` with
+/// `<rel>` there, or write it with WRITE_GOLDEN set.
+pub fn app_golden(rel: &str, text: &str) {
+    let path = repo().join("crates/app/tests/golden").join(rel);
+    if std::env::var_os("WRITE_GOLDEN").is_some() {
+        if let Some(dir) = path.parent() {
+            std::fs::create_dir_all(dir).expect("create the golden dir");
+        }
+        std::fs::write(&path, text).expect("write the golden");
+        return;
+    }
+    let want = std::fs::read_to_string(&path).unwrap_or_else(|e| {
+        panic!("cannot read golden {}: {e}; create it with WRITE_GOLDEN=1", path.display())
+    });
+    assert_eq!(want.replace("\r\n", "\n"), text, "golden {} is stale; regenerate with WRITE_GOLDEN=1", path.display());
+}
+
 pub fn stream_path(case: &str) -> PathBuf {
     here().join("streams").join(format!("{case}.cnc"))
 }
diff --git a/crates/post/tests/vertical_arc_entry.rs b/crates/post/tests/vertical_arc_entry.rs
new file mode 100644
index 000000000..4587ee784
--- /dev/null
+++ b/crates/post/tests/vertical_arc_entry.rs
@@ -0,0 +1,106 @@
+//! M11.2 B, the posting half: the arc entry's TRUE vertical-plane arc
+//! (one XZ arc per level for a first cut along X, one YZ arc for one
+//! along Y) posts with its plane stated by the G-word posts, and
+//! Heidenhain rides it as chords and never switches plane; an oblique
+//! first cut's chord fan states no vertical plane anywhere.
+//!
+//! The paths are recorded (#926): `recorded/inputs/vertical_arc_*.cl`,
+//! written and guarded by motion's `vertical_arc_entry`, which also holds
+//! the generator half (true arcs, tangency, the oblique note, verify).
+//!
+//! Provenance: RS-274/NGC and ISO 6983 G17/G18/G19 plane selection and
+//! G2/G3 sense (public standards); our own posts.
+//!
+//! Gate map (M11.2): covers post::post, post::dump, cl::text, assets/posts.
+
+mod recorded;
+
+use camcraft_post::cl::{text, ArcPlane, Toolpath};
+use camcraft_post::post::{cnc, dump, engine, Dump};
+use std::path::{Path, PathBuf};
+
+/// A recorded contour path of motion's vertical_arc_entry.
+fn path(name: &str) -> Toolpath {
+    text::from_text(&recorded::input(name)).unwrap_or_else(|e| panic!("{name}: {e}"))
+}
+
+fn repo(rel: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("../../").join(rel)
+}
+
+fn read(rel: &str) -> String {
+    std::fs::read_to_string(repo(rel)).unwrap_or_else(|e| panic!("{rel}: {e}")).replace("\r\n", "\n")
+}
+
+fn post(stem: &str, t: &Toolpath) -> String {
+    let d = Dump {
+        op_name: "Arc entry",
+        tool_number: 1,
+        tool_name: "8MM FLAT",
+        tool_diameter: 8.0,
+        rpm: 10000.0,
+        clearance_z: 5.0,
+        retract_z: 8.0,
+        top_z: 0.0,
+        ..Dump::default()
+    };
+    let s = cnc::serialize(&dump(t, &d));
+    let mch: serde_json::Value = serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("machine");
+    let cps = read(&format!("assets/posts/{stem}.cps"));
+    let out = engine::run(&cps, &mch, &s).unwrap_or_else(|e| panic!("{stem}: must post: {e}"));
+    assert!(out.warnings.is_empty(), "{stem}: {:?}", out.warnings);
+    out.program
+}
+
+/// The G-word posts: the plane word is stated, the other vertical one
+/// never, and exactly three arc blocks carry the plane's center words
+/// (`I`/`K` for G18, `J`/`K` for G19) - one per level. Heidenhain
+/// switches no plane.
+fn assert_posts(t: &Toolpath, plane: ArcPlane) {
+    let (word, other, centers) = match plane {
+        ArcPlane::Xz => ("G18", "G19", ('I', 'K')),
+        _ => ("G19", "G18", ('J', 'K')),
+    };
+    for stem in ["fanuc", "haas", "sinumerik", "mazak"] {
+        let out = post(stem, t);
+        let has = |l: &str, w: &str| l.split(' ').any(|x| x == w);
+        assert!(out.lines().any(|l| has(l, word)), "{stem} states {word}:\n{out}");
+        assert!(!out.lines().any(|l| has(l, other)), "{stem} never {other}:\n{out}");
+        let blocks = out
+            .lines()
+            .filter(|l| {
+                let w = |k: char| l.split(' ').any(|x| x.starts_with(k) && x.len() > 1 && x[1..].parse::<f64>().is_ok());
+                w(centers.0) && w(centers.1)
+            })
+            .count();
+        assert_eq!(blocks, 3, "{stem}: one {word} arc block per level:\n{out}");
+    }
+    let hh = post("heidenhain", t);
+    assert!(!hh.contains("G18") && !hh.contains("G19"), "Heidenhain switches no plane:\n{hh}");
+}
+
+#[test]
+fn an_x_aligned_first_cut_enters_on_one_g18_arc_per_level() {
+    // The linear lead runs along the bore's top wall (+X): the entry
+    // descends in the XZ plane through it.
+    assert_posts(&path("vertical_arc_x.cl"), ArcPlane::Xz);
+}
+
+#[test]
+fn a_y_aligned_first_cut_enters_on_one_g19_arc_per_level() {
+    // The arc lead-in leaves its start along +Y: the entry descends in
+    // the YZ plane onto it.
+    assert_posts(&path("vertical_arc_y.cl"), ArcPlane::Yz);
+}
+
+#[test]
+fn an_oblique_first_cut_stays_chords_and_says_so_once() {
+    // The bore turned 30 degrees: the lead runs along no axis, so no
+    // G17/G18/G19 names its vertical plane.
+    let t = path("vertical_arc_oblique.cl");
+    assert!(t.moves.iter().all(|m| m.arc.is_none_or(|a| a.plane.is_xy())), "no axis-plane arc for an oblique cut");
+    for stem in ["fanuc", "haas", "sinumerik", "mazak", "heidenhain"] {
+        let out = post(stem, &t);
+        assert!(!out.contains("G18") && !out.contains("G19"), "{stem}: no vertical plane:\n{out}");
+    }
+}
diff --git a/docs/decisions/926-recorded-app-post-tests.md b/docs/decisions/926-recorded-app-post-tests.md
new file mode 100644
index 000000000..37424835d
--- /dev/null
+++ b/docs/decisions/926-recorded-app-post-tests.md
@@ -0,0 +1,55 @@
+## #926 - The ten probe and arc post suites move to crates/post/tests (slice 2)
+
+**What was decided.**
+- The probe suites (`fanuc_post`, `probe_dialects`, `probe_guard`,
+  `probe_report`, `probe_tormach`, `inverted_probe`) read recorded `.cnc`
+  streams instead of calling `motion::probing::probe_cycle`. Each stream is
+  recorded once per distinct (cycle, dump) pair the old tests built (28 files
+  in `crates/post/tests/recorded/inputs/`). They are written and guarded by
+  app's `recorded_post_streams`, beside slice 1's probe and drill guards: app
+  is still the only crate that sees both motion and post, and the `.cnc`
+  stream is the dumped records, so the guard has to call `post::dump`.
+- `probe_guard`'s first test also compares every GUARD with the path's own
+  moves. `cl::text` carries no probe touches, so it now reads two recordings
+  per mode: the stream and the path as `.cl` (`probe_<mode>.cl`). The touch
+  moves are found from the stream's motion records (one record per move, in
+  order), and positions are compared on the micron lattice (1e-6, not 1e-9).
+- `vertical_arc_entry` is split. The generator half (true arcs, tangency, the
+  oblique note, verify) goes to `crates/motion/tests` (motion already sees
+  sim). Each of its three tests also guards its path's `.cl` recording. The
+  posting half goes to `crates/post/tests` and reads those recordings.
+- `arc_planes`, `inverted_equivalence` and `inverted_post` need no
+  recording: their inputs are built with cl's `PathBuilder` or by hand.
+  `common::gen_to_cltext` / `cl_read::parse_cl` became `cl::text::to_text` /
+  `from_text`; the golden still matches byte for byte. The one project-file
+  test (`ArcDto`) stays in app, in `float_roundtrip`.
+- `inverted_support` and `macro_b` move with their suites. App's
+  `inverted_axis_display` was the last app user of `inverted_support`. It now
+  reads the fixture stream as `recorded/inputs/inverted_probe.cnc`, which
+  post's `inverted_post` guards, so app keeps no second copy of the
+  300-line helper.
+- Every file in `recorded/inputs/` must have a generator.
+  `every_recorded_input_has_a_generator` (app) compares the directory with
+  the guard tables, so a file that nothing writes fails the build.
+- The goldens stay in `crates/app/tests/golden/` (the post suites use
+  `recorded::app_golden`). Other app suites, and xtask, read the same
+  goldens. One home for the goldens is #919's sub-issue 6.
+- xtask's asset and gate-map unit tests named `fanuc_post` / `arc_planes`
+  as app suites. They now read every crate's suites step, and that change
+  bumps PROCESS_VERSION.
+
+**Why.** This is the issue's Done means: the tests run outside app, read
+recorded input, add no crate edge, and each recording has a generator-side
+test that fails when the recording goes stale. It follows the pattern slice 1
+(PR #1002) already set.
+
+**Considered and dropped.**
+- Recording `.cl` paths only, and dumping them in post: `cl::text` has no
+  probe touch records.
+- Adding serde to `Toolpath` so the whole path could be recorded: this is a
+  new dependency in cl.
+- A dev-dependency of post on motion: this is a new crate edge (#919 Q4).
+- Moving the goldens into post: other app suites read them.
+
+**Cost to change later.** Low. The guard tables are one array in
+`recorded_post_streams.rs`, and `WRITE_GOLDEN=1` regenerates every recording.
