+fn params(mode: ProbeMode, dir: ProbeDir, dir_y: ProbeDir, t: [f64; 3], radius: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir,
+        dir_y,
+        target: Point3::new(t[0], t[1], t[2]),
+        radius,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
