+    assert_eq!(exec::read_log(log, 101).expect("note"), "failed: tests\\ops.rs");
+    assert_eq!(exec::read_log("error: could not compile `x`\n", 101).expect("note"), "compile error");
+    assert_eq!(exec::read_log("", 0).expect("note"), "");
