+++ b/crates/post/tests/arc_planes.rs
@@ -150,7 +150,7 @@ fn every_builtin_posts_the_plane_program_byte_exact() {
     let s = stream(&program());
     let write = std::env::var_os("WRITE_GOLDEN").is_some();
     for (name, stem, sub) in POSTS {
-        let out = common::with_synthetic_marker(stem, &post(stem, &s));
+        let out = recorded::with_synthetic_marker(stem, &post(stem, &s));
         let rel = if sub.is_empty() {
             "crates/app/tests/golden/nc/arc_planes.nc".to_string()
         } else {
diff --git a/crates/post/tests/recorded/mod.rs b/crates/post/tests/recorded/mod.rs
index 0565e5f6d..99c71de76 100644
--- a/crates/post/tests/recorded/mod.rs
+++ b/crates/post/tests/recorded/mod.rs
@@ -247,3 +247,16 @@ macro_rules! post_suite {
         }
     };
 }
+
+/// The line every conformance golden opens with (#1093): the program is
+/// synthetic, posted for syntax only. Same text and comment form as app's
+/// `common::with_synthetic_marker`, whose goldens these suites share.
+pub const SYNTHETIC_MARKER: &str = "synthetic program, posted for syntax conformance";
+
+/// Prefix `out` with [`SYNTHETIC_MARKER`] in the dialect's comment form.
+pub fn with_synthetic_marker(stem: &str, out: &str) -> String {
+    match stem {
+        "sinumerik" | "heidenhain" => format!("; {SYNTHETIC_MARKER}\n{out}"),
+        _ => format!("({SYNTHETIC_MARKER})\n{out}"),
+    }
+}

