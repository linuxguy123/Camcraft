+/// The plate with a notch `w` wide and `drop` deep cut into its top edge.
+fn notched(w: f64, drop: f64) -> Loop {
+    let top = 60.0;
+    Loop::new(vec![
+        Point2::new(0.0, 0.0),
+        Point2::new(100.0, 0.0),
+        Point2::new(100.0, top),
+        Point2::new(50.0 + w * 0.5, top),
+        Point2::new(50.0 + w * 0.5, top - drop),
+        Point2::new(50.0 - w * 0.5, top - drop),
+        Point2::new(50.0 - w * 0.5, top),
+        Point2::new(0.0, top),
+    ])
+    .unwrap()
+}
