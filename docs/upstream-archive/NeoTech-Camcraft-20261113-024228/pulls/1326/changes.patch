From e27c97a630b73e4c79430bf95c3927d0bba09207 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 15:11:49 -0800
Subject: [PATCH] fix(ui): Windows start-up box only for panics that escape run
 (#1325)

Drop the global panic hook; main wraps run in catch_unwind on Windows. A failed
CONOUT$ open after a successful attach counts as no console. Payload-to-text
lives in panic_text.rs with a unit test.

Fixes #1325

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/ui/src/main.rs        | 20 +++++++++++++------
 crates/ui/src/panic_text.rs  | 38 ++++++++++++++++++++++++++++++++++++
 crates/ui/src/win_console.rs | 24 +++++++++++------------
 3 files changed, 63 insertions(+), 19 deletions(-)
 create mode 100644 crates/ui/src/panic_text.rs

diff --git a/crates/ui/src/main.rs b/crates/ui/src/main.rs
index aa2b17f4..363b1984 100644
--- a/crates/ui/src/main.rs
+++ b/crates/ui/src/main.rs
@@ -1,20 +1,28 @@
 // GUI entry point. Windows: built as a GUI-subsystem exe so a double-click opens
 // no console window (#1278); the console and error-box plumbing is in win_console.
-// Spec: Microsoft's public documentation of the PE subsystem flag and the Win32
-// console and message-box APIs.
+// A panic the app handles itself shows nothing; only one escaping `run` shows the
+// box (#1325). Spec: Microsoft's public documentation of the PE subsystem flag and
+// the Win32 console and message-box APIs; std::panic::catch_unwind.
 #![cfg_attr(windows, windows_subsystem = "windows")]
 
+mod panic_text;
 #[cfg(windows)]
 mod win_console;
 
 fn main() {
     #[cfg(windows)]
-    {
-        win_console::attach_parent_console();
-        win_console::install_panic_hook();
-    }
+    win_console::attach_parent_console();
     camcraft_app::logging::init();
     let args: Vec<String> = std::env::args().skip(1).collect();
+    #[cfg(windows)]
+    let code = match std::panic::catch_unwind(|| camcraft_ui::run(&args)) {
+        Ok(code) => code,
+        Err(payload) => {
+            win_console::report_panic(&panic_text::payload_text(&*payload));
+            101
+        }
+    };
+    #[cfg(not(windows))]
     let code = camcraft_ui::run(&args);
     #[cfg(windows)]
     if code != 0 {
diff --git a/crates/ui/src/panic_text.rs b/crates/ui/src/panic_text.rs
new file mode 100644
index 00000000..8dc0d1ce
--- /dev/null
+++ b/crates/ui/src/panic_text.rs
@@ -0,0 +1,38 @@
+// Turns a caught panic payload into text for the Windows start-up error box (#1325).
+// Spec: std::panic::catch_unwind documents the payload as `Box<dyn Any + Send>`, in
+// practice a `&'static str` or a `String`. Pure, so it is tested on every OS.
+#![cfg_attr(not(windows), allow(dead_code))]
+
+use std::any::Any;
+
+/// Text of a panic payload; never panics. Anything but `&str` / `String` gets a generic text.
+pub fn payload_text(payload: &(dyn Any + Send)) -> String {
+    if let Some(s) = payload.downcast_ref::<&str>() {
+        (*s).to_string()
+    } else if let Some(s) = payload.downcast_ref::<String>() {
+        s.clone()
+    } else {
+        "an unknown error".to_string()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::payload_text;
+
+    #[test]
+    fn payload_text_reads_str_string_and_other() {
+        assert_eq!(payload_text(&"boom"), "boom");
+        assert_eq!(payload_text(&String::from("bang")), "bang");
+        assert_eq!(payload_text(&42_u32), "an unknown error");
+        let caught = std::panic::catch_unwind(|| {
+            let n = 3;
+            if n > 2 {
+                std::panic::panic_any(String::from("formatted 3"));
+            }
+        });
+        if let Err(p) = caught {
+            assert_eq!(payload_text(&*p), "formatted 3");
+        }
+    }
+}
diff --git a/crates/ui/src/win_console.rs b/crates/ui/src/win_console.rs
index e57dbbd7..5f00bc02 100644
--- a/crates/ui/src/win_console.rs
+++ b/crates/ui/src/win_console.rs
@@ -93,7 +93,10 @@ pub fn attach_parent_console() {
             )
         };
         if is_missing(handle) {
-            continue; // no console output possible; the log goes nowhere, as before
+            // Attached but no usable output: the log goes nowhere, so this counts as no
+            // console and a failure still gets its box (#1325).
+            CONSOLE_ATTACHED.store(false, Ordering::SeqCst);
+            continue;
         }
         // SAFETY: plain integer plus a handle we own; the handle stays open for the
         // process lifetime as the new std handle. A failure leaves the old (missing) one.
@@ -129,16 +132,11 @@ pub fn report_exit_failure(code: i32) {
     ));
 }
 
-/// Chain a hook after the current panic hook that shows the panic in a message box when
-/// no console was attached. The hook only formats and calls MessageBoxW: nothing in it
-/// unwraps or indexes, so it cannot panic itself (a panic in a hook would abort).
-pub fn install_panic_hook() {
-    let previous = std::panic::take_hook();
-    std::panic::set_hook(Box::new(move |info| {
-        previous(info);
-        show_error(&format!(
-            "CamCraft stopped unexpectedly.\n\n{info}\n\n\
-             Start camcraft-ui.exe from a terminal (Command Prompt or PowerShell) to see the log."
-        ));
-    }));
+/// A panic escaped `camcraft_ui::run` (caught by `main`'s `catch_unwind`): show it in the
+/// box when no console is attached. Handled panics inside the app never reach here (#1325).
+pub fn report_panic(text: &str) {
+    show_error(&format!(
+        "CamCraft stopped unexpectedly.\n\n{text}\n\n\
+         Start camcraft-ui.exe from a terminal (Command Prompt or PowerShell) to see the log."
+    ));
 }
