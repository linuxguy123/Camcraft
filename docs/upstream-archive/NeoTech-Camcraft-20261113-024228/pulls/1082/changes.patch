+            "the setup's stated nose_to_axis {v:.3} mm exceeds the machine's {machine:.3} mm less the {:.3} mm \
+             stack under the rotary ({})",
+            s.thickness,
+            s.describe()
+        ));
+    }
+    Ok(())
 }
 
