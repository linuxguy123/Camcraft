+                SinkerOrbitKindDto::Vector => SinkerOrbitKind::Vector,
+                SinkerOrbitKindDto::Planetary => SinkerOrbitKind::Planetary,
+            },
+            radius: self.radius,
+            vectors: self.vectors,
+            turns: self.turns,
