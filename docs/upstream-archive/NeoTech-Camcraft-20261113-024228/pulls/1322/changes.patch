From 73ed60a357d49df8cbf53b78326d05a63692f035 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 14:40:08 -0800
Subject: [PATCH] fix(ui): name the platform command key in pick hints

Pick hints (edge hint, Click selects hover, boundary picking hint) and the
shortcut comments say Ctrl (Cmd on macOS): add-to-selection uses egui's
command modifier, so a bare Ctrl hint is wrong on a Mac. First-run docs
name Cmd+Z / Cmd+Y on macOS too. Pinned by
pick_hints_name_the_platform_command_key.

Fixes #1238

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 crates/ui/src/boundary_draft.rs            |  4 ++--
 crates/ui/src/egui_app/boundary.rs         |  2 +-
 crates/ui/src/egui_app/geo_page.rs         |  4 ++--
 crates/ui/src/egui_app/shell.rs            |  2 +-
 crates/ui/src/egui_app/tests/structural.rs | 11 +++++++++++
 site/content/guide/first-run.md            |  2 +-
 6 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/crates/ui/src/boundary_draft.rs b/crates/ui/src/boundary_draft.rs
index 4f4ecc084..b7a304b06 100644
--- a/crates/ui/src/boundary_draft.rs
+++ b/crates/ui/src/boundary_draft.rs
@@ -4,8 +4,8 @@
 //! its picks spell, and the roles its shape cannot take, disabled with
 //! the reason. Viewport picks land here while the group is collecting:
 //! a plain click takes ONE edge (a run - one straight stretch or one
-//! arc, never the whole tangent loop), Ctrl toggles a run in or out
-//! (Ctrl on an edge of a picked loop breaks it open), Shift closes the
+//! arc, never the whole tangent loop), Ctrl (Cmd on macOS) toggles a run in or out
+//! (Ctrl, or Cmd on macOS, on an edge of a picked loop breaks it open), Shift closes the
 //! picks around their face loop, Alt narrows any of them to the single
 //! mesh segment. Everything here edits the page draft (`OpUi::area`):
 //! Apply commits it as one undoable `EditOperationParams::with_area`, so
diff --git a/crates/ui/src/egui_app/boundary.rs b/crates/ui/src/egui_app/boundary.rs
index 2193815c9..a24823e6e 100644
--- a/crates/ui/src/egui_app/boundary.rs
+++ b/crates/ui/src/egui_app/boundary.rs
@@ -38,7 +38,7 @@ use super::layout::{auto_value, consequence, group, group_open, hint, prop_row,
 pub const HINTS: [&str; 4] = [
     "Include adds the area a closed boundary encloses; Exclude keeps the whole tool out of it.",
     "Open: an open edge chain runs on straight to the stock and splits it - side A holds more of the selection's area, side B is the rest; arrows in the viewport point into the side machined.",
-    "Picking: click an edge to take that one edge, Ctrl-click to add or remove one (removing breaks a picked loop open), Shift-click to close the edges around their face loop, Alt for a single mesh segment; a face adds its loop.",
+    "Picking: click an edge to take that one edge, Ctrl-click (Cmd-click on macOS) to add or remove one (removing breaks a picked loop open), Shift-click to close the edges around their face loop, Alt for a single mesh segment; a face adds its loop.",
     "The filled area in the viewport is what the operation will machine after Apply.",
 ];
 
diff --git a/crates/ui/src/egui_app/geo_page.rs b/crates/ui/src/egui_app/geo_page.rs
index 687365015..e425987ea 100644
--- a/crates/ui/src/egui_app/geo_page.rs
+++ b/crates/ui/src/egui_app/geo_page.rs
@@ -17,7 +17,7 @@ use super::colorvision::text_inks;
 use super::layout::group;
 
 /// The Edge mode's one-line hint: how a loop gets closed.
-pub const EDGE_HINT: &str = "Ctrl+click adds an edge · Shift+click picks the whole loop";
+pub const EDGE_HINT: &str = "Ctrl+click (Cmd+click on macOS) adds an edge · Shift+click picks the whole loop";
 
 pub(super) fn pick_block(ui: &mut Ui, state: &mut State, target: &str, live_setup: Option<&str>) {
     group(ui, "Selection", None, |ui| body(ui, state, target, live_setup));
@@ -27,7 +27,7 @@ fn body(ui: &mut Ui, state: &mut State, target: &str, live_setup: Option<&str>)
     // Viewport pick mode - transient view state: the mode itself is not
     // undoable; what a Face/Edge click changes is.
     ui.horizontal_wrapped(|ui| {
-        ui.label("Click selects:").on_hover_text("Click in the viewport - Ctrl adds; in Edge mode Shift takes the whole loop and Alt one edge.");
+        ui.label("Click selects:").on_hover_text("Click in the viewport - Ctrl (Cmd on macOS) adds; in Edge mode Shift takes the whole loop and Alt one edge.");
         let mut pick_mode = match state.geo_pick {
             GeoPick::Model => 0,
             GeoPick::Face => 1,
diff --git a/crates/ui/src/egui_app/shell.rs b/crates/ui/src/egui_app/shell.rs
index c58116292..aed7b35b6 100644
--- a/crates/ui/src/egui_app/shell.rs
+++ b/crates/ui/src/egui_app/shell.rs
@@ -258,7 +258,7 @@ impl TabViewer for ShellTabs<'_> {
 
 /// The viewport tab: the 3D image, the pointer law, and the screen-space
 /// overlays. M-e moved the law to `crate::interact`, where the retired
-/// imgui shell had it first: a short LMB press picks (Ctrl adds, the
+/// imgui shell had it first: a short LMB press picks (Ctrl, or Cmd on macOS, adds, the
 /// gesture table), an LMB drag past the click-travel threshold orbits, MMB
 /// orbits, RMB pans, wheel dollies toward the cursor. egui's press/drag
 /// bookkeeping differs from winit's raw stream, so the gestures are read
diff --git a/crates/ui/src/egui_app/tests/structural.rs b/crates/ui/src/egui_app/tests/structural.rs
index bf4f0d933..b7515a93c 100644
--- a/crates/ui/src/egui_app/tests/structural.rs
+++ b/crates/ui/src/egui_app/tests/structural.rs
@@ -531,3 +531,14 @@ fn origin_names_paint_on_and_quiet_off_letters_and_lines_always() {
     }
     let _ = std::fs::remove_dir_all(&d);
 }
+
+/// #1238: every pick hint names the platform command key (Cmd on macOS,
+/// Ctrl elsewhere), not a bare Ctrl that a Mac user cannot press.
+#[test]
+fn pick_hints_name_the_platform_command_key() {
+    use crate::egui_app::{boundary::HINTS, geo_page::EDGE_HINT};
+    assert!(EDGE_HINT.contains("Cmd+click on macOS"), "edge hint: {EDGE_HINT}");
+    assert!(HINTS[2].contains("Cmd-click on macOS"), "boundary pick hint: {}", HINTS[2]);
+    let geo = include_str!("../geo_page.rs");
+    assert!(geo.contains("Ctrl (Cmd on macOS) adds"), "Click selects hover names Cmd");
+}
