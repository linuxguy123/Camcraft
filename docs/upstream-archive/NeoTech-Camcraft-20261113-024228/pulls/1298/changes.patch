@@ -0,0 +1,30 @@
+# #1256 - Escape closes dialogs: pinned, not changed
+
+**Decision (unattended):** no behaviour change. Escape already closes the
+modal dialogs the code comments name; this PR pins that with real key-event
+tests.
+
+**Reading:** the two comments that say Escape closes a dialog
+(`unsaved_prompt.rs`, `fixture_library_dialog.rs`) are both egui `Modal`s.
+egui 0.36's `Modal::should_close()` consumes Escape for the topmost modal
+with no popup open. The issue's premise ("no Escape key handler exists") is
+true of `panes::shortcuts` but not of the modals. Escape enqueues the same
+Cancel that the buttons send (`ResolveUnsaved(Cancel)` for the prompt,
+`Act::Close` for the fixture dialogs), so nothing is applied.
+
+**Chosen:** pin it. Three kittest tests in
+`crates/ui/src/egui_app/escape_tests.rs`: one press closes only the topmost
+of two open dialogs; a single fixture dialog closes with no library file
+written; Escape with nothing open changes nothing.
+
+**Considered and dropped:**
+- Adding a global Escape handler in `panes::shortcuts`. It would duplicate
+  egui's modal handling and risk closing dialogs twice.
+- Cancelling an in-progress pick or box-select draft on Escape. No code
+  comment says so, so it is out of scope for this issue. Filed for the
+  maintainer to decide if wanted.
+- Updating a keyboard reference page. None exists on `main` yet; the
+  reference from #1246 / PR #1255 is not merged. Nothing to update here.
+- egui `Window` panels (tool editor, G-code view, post refusal, machine
+  editor, debug info). They have no Escape comment and close with their
+  own button; left as is.

From c3be0a2cf5ab32471fbc78b9ce3a906e72e675c8 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 14:49:04 -0800
Subject: [PATCH 2/2] test(ui): Escape keeps pending fixture draft edits and
 the open document

The fixture Save draft now holds a pending edit before Escape, and the
unsaved-prompt test asserts the open document is still the same one.

Changelog: none
Fixes #1256

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/escape_tests.rs | 27 +++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/crates/ui/src/egui_app/escape_tests.rs b/crates/ui/src/egui_app/escape_tests.rs
index 1808ef48..9f5f56aa 100644
--- a/crates/ui/src/egui_app/escape_tests.rs
+++ b/crates/ui/src/egui_app/escape_tests.rs
@@ -7,6 +7,8 @@
 //! No pixels (the snapshot lane is release).
 //! Provenance: our own tests over our own shell; no vendor material.
 
+use std::path::PathBuf;
+
 use egui::{Event, Key, Modifiers, Vec2};
 use egui_kittest::Harness;
 
@@ -54,18 +56,39 @@ fn library_file_written(state: &State) -> bool {
     state.fixture_library_path().is_ok_and(|p| p.exists())
 }
 
+/// Put a pending, unapplied edit in the open fixture Save draft.
+const PENDING_NOTE: &str = "pending edit, must not apply";
+
+fn set_draft_note(h: &mut Harness<'static, State>) {
+    if let Some(FixtureLibDialog::Save(draft)) = h.state_mut().fixture_lib.as_mut() {
+        draft.note = PENDING_NOTE.to_string();
+    }
+}
+
+fn draft_note(state: &State) -> Option<&str> {
+    match state.fixture_lib.as_ref() {
+        Some(FixtureLibDialog::Save(draft)) => Some(draft.note.as_str()),
+        _ => None,
+    }
+}
+
 #[test]
 fn escape_closes_only_the_topmost_dialog_per_press() {
     let mut state = fresh_state("topmost");
     state.pending.push_back(CommandKind::FixtureLibrarySaveDialog(String::new()));
     state.drain_actions();
     state.unsaved_prompt = Some(CommandKind::NewDocument);
+    let open_doc = PathBuf::from("open-document.camcraft");
+    state.project_path = Some(open_doc.clone());
 
     let mut h = harness(state);
     h.run_steps(2);
+    set_draft_note(&mut h);
     press_escape(&mut h);
     assert!(h.state().unsaved_prompt.is_none(), "the topmost prompt closes");
     assert_eq!(h.state().status, "cancelled - the document stays open");
+    assert_eq!(h.state().project_path.as_deref(), Some(open_doc.as_path()), "the same document is still open");
+    assert_eq!(draft_note(h.state()), Some(PENDING_NOTE), "the fixture draft is unchanged by the first press");
     assert!(matches!(h.state().fixture_lib, Some(FixtureLibDialog::Save(_))), "one press closes one dialog");
 
     press_escape(&mut h);
@@ -80,9 +103,11 @@ fn escape_closes_the_fixture_dialog_without_applying() {
     state.drain_actions();
     let mut h = harness(state);
     h.run_steps(2);
+    set_draft_note(&mut h);
+    assert_eq!(draft_note(h.state()), Some(PENDING_NOTE), "the edit is in the draft before Escape");
     press_escape(&mut h);
 
-    assert!(h.state().fixture_lib.is_none(), "Escape closes the dialog");
+    assert!(h.state().fixture_lib.is_none(), "Escape closes the dialog and its draft with it");
     assert!(!library_file_written(h.state()), "Escape applies nothing: no library file");
     assert_eq!(h.state().status, "ready");
 }
