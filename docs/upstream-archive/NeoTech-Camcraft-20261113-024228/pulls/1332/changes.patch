From 55d40c618b1c47ebdbcfb64e713a1f44305c91c8 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Fri, 13 Nov 2026 00:40:52 +0100
Subject: [PATCH] test(xtask): gate maps name the owning crate for moved post
 suites

The Gate map headers of grblhal_post and tinyg_post named app::post, a
module that moved to camcraft_post, which no_gate_map_names_a_moved_module_as_app
rejects. Name camcraft_post::post and camcraft_post::machine instead; the
suites still import camcraft_app and stay in crates/app/tests.

Fixes #1331

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 crates/app/tests/grblhal_post.rs | 2 +-
 crates/app/tests/tinyg_post.rs   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/app/tests/grblhal_post.rs b/crates/app/tests/grblhal_post.rs
index 5b747c75d..bdcee98bf 100644
--- a/crates/app/tests/grblhal_post.rs
+++ b/crates/app/tests/grblhal_post.rs
@@ -11,7 +11,7 @@
 //! posts clean.
 //! Provenance: our own tests over our own post and machine file.
 //!
-//! Gate map (#710): covers app::post (grblhal.cps), post::machine
+//! Gate map (#710): covers camcraft_post::post (grblhal.cps), camcraft_post::machine
 //! (safeRetractZ, units), app::posting (registry, machine library).
 
 use camcraft_app::machine::parse_mch;
diff --git a/crates/app/tests/tinyg_post.rs b/crates/app/tests/tinyg_post.rs
index 64bf6fb43..41b0e1588 100644
--- a/crates/app/tests/tinyg_post.rs
+++ b/crates/app/tests/tinyg_post.rs
@@ -11,7 +11,7 @@
 //! Provenance: our own tests over our own post and machine file; the
 //! dialect facts from TinyG's public wiki ("Gcode Support").
 //!
-//! Gate map: covers app::post (tinyg.cps), post::machine (safeRetractZ,
+//! Gate map: covers camcraft_post::post (tinyg.cps), camcraft_post::machine (safeRetractZ,
 //! units), app::posting (registry, machine library).
 
 use camcraft_app::machine::parse_mch;
