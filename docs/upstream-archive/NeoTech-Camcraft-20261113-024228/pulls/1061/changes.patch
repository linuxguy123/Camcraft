+        // A tip crossing the axis sweeps the band through a revolved
+        // bore from the other side.
+        let ring = Steel::Revolved { s: (-1.0, 1.0), r: (20.0, 22.0) };
+        assert!(meets((0.0, 30.0), (0.0, -30.0), -0.5, 0.5, &reach(-1.0, 1.0, 0.0), &ring));
+    }
+}
