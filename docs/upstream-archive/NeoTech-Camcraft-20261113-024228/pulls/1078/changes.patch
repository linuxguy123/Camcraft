 /// (the add-to-selection keys), Edge or Face mode, an operation open, and
 /// no other pick draft (boundary, locate, plane, axis, points) collecting.
 pub(crate) fn armed(state: &State, mods: Mods) -> bool {
-    (mods.ctrl || mods.shift)
