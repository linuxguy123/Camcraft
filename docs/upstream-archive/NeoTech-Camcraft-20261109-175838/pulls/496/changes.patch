diff --git a/crates/app/src/fixture_struck.rs b/crates/app/src/fixture_struck.rs
new file mode 100644
index 00000000..34db4475
--- /dev/null
+++ b/crates/app/src/fixture_struck.rs
@@ -0,0 +1,151 @@
+//! Which fixture a warned move strikes (#339 slice 4): a `FixtureHit`
+//! names the op, the move and the band, never the steel - the laws judge
+//! every box at once. To tint the struck fixture, each fixture is judged
+//! ALONE with the very laws the post gate runs ([`op_hits`]), and the
+//! warned moves each one reproduces are its own. A warned move no single
+//! fixture reproduces (the steel moved since generation, or two boxes
+//! only convict together) is reported unresolved - never guessed.
+//!
+//! Display only: nothing here writes the world or feeds the post.
+//!
+//! Provenance: our own composition of the existing workholding laws
+//! (`camcraft_sim::verify`, the post gate's own call shape); no vendor
+//! material consulted.
+
+use flecs_ecs::prelude::World;
+
+use crate::cl::Toolpath as ClPath;
+use crate::fixture::{self, FixtureBox, MeshedFixture, MACHINE_TABLE};
+use crate::model;
+use crate::operation;
+use crate::schema::Operation;
+use crate::verify::Warning;
+
+/// The workholding laws (c2)/(d2), mesh-refined (#339), for one op's
+/// path against the given steel: exactly the post gate's per-op check.
+/// `Err` names a tool body that no longer fits its tool; a missing tool
+/// or no steel at all is no hit.
+pub fn op_hits(
+    world: &World,
+    op: &Operation,
+    path: &ClPath,
+    turning: &[FixtureBox],
+    fixed: &[FixtureBox],
+    meshes: &[MeshedFixture],
+) -> Result<Vec<Warning>, String> {
+    let Some((tool_entity, tool)) = model::find_by_name(world, &op.tool)
+        .and_then(|t| model::tool_of(world, &t).map(|d| (t, d)))
+    else {
+        return Ok(Vec::new());
+    };
+    // #368: the body's enclosing cylinder and band stack; a body that no
+    // longer fits its tool is itself the problem, by name.
+    let (tool, body) =
+        crate::tool_body::judged(world, &tool_entity, tool).map_err(|e| format!("tool {}: {e}", op.tool))?;
+    // `boxes_for` already folds in the machine-derived table, so empty
+    // lists mean no steel this op could strike at all.
+    if turning.is_empty() && fixed.is_empty() {
+        return Ok(Vec::new());
+    }
+    let spindle = crate::machine::of(world)
+        .1
+        .and_then(|m| m.spindle_d.zip(m.spindle_len))
+        .map(|(d, l)| (d * 0.5, l));
+    let wh = crate::verify::Workholding { turning, fixed, axis: fixture::rotary_axis_of(world, op) };
+    let geom = tool.geom();
+    let holder = crate::tool_body::stack(&geom, body.as_ref());
+    // #339: each law's hits on a meshed fixture re-read against its
+    // closed mesh - the mesh only ever acquits.
+    let stack = crate::verify::steel_stack(&geom, &holder, spindle);
+    let steel = crate::verify::MeshSteel { fixtures: meshes, stack: &stack, chord_tol: operation::GOUGE_TOL };
+    let mut hits = crate::verify::mesh_refined(path, &wh, &steel, false, |w| {
+        crate::verify::bands_vs_workholding_held(path, &geom, &holder, w, spindle, operation::GOUGE_TOL)
+    });
+    // The spindle housing rides posed rapids too (M13.8 (1)).
+    hits.extend(crate::verify::mesh_refined(path, &wh, &steel, true, |w| {
+        crate::verify::rapids_vs_workholding_held(path, &geom, &holder, w, spindle)
+    }));
+    Ok(hits)
+}
+
+/// The moves an op's cached warnings say strike a fixture, ascending.
+#[must_use]
+pub fn warned_moves(warnings: &[Warning]) -> Vec<usize> {
+    let mut at: Vec<usize> = warnings
+        .iter()
+        .filter_map(|w| match w {
+            Warning::FixtureHit { at, .. } => Some(*at),
+            _ => None,
+        })
+        .collect();
+    at.sort_unstable();
+    at.dedup();
+    at
+}
+
+/// Who an op's fixture warnings point at.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Struck {
+    /// The fixtures (tagged model names, and [`MACHINE_TABLE`] for the
+    /// derived table) that reproduce at least one warned move alone,
+    /// name order, table last.
+    pub fixtures: Vec<String>,
+    /// Warned moves no single fixture reproduces today.
+    pub unresolved: Vec<usize>,
+    /// Every warned move, ascending.
+    pub warned: Vec<usize>,
+}
+
+impl Struck {
+    /// Whether `name` is one of the struck fixtures.
+    #[must_use]
+    pub fn names(&self, name: &str) -> bool {
+        self.fixtures.iter().any(|f| f == name)
+    }
+}
+
+/// Resolve the op `op_name`'s cached `FixtureHit` warnings to the
+/// fixtures that cause them. `None`: no such op, no cached path, or no
+/// fixture warning to resolve.
+#[must_use]
+pub fn struck_by(world: &World, op_name: &str) -> Option<Struck> {
+    let e = model::find_by_name(world, op_name)?;
+    let op = model::operation_of(world, &e)?;
+    let cache = model::toolpath_of(world, &e)?;
+    let warned = warned_moves(&cache.warnings);
+    if warned.is_empty() {
+        return None;
+    }
+    let ctx = op.setup.as_deref();
+    let mut fixtures = Vec::new();
+    let mut covered: Vec<usize> = Vec::new();
+    let mut judge = |name: String, turning: Vec<FixtureBox>, fixed: Vec<FixtureBox>, meshes: Vec<MeshedFixture>| {
+        // A tool body that no longer fits is the post gate's refusal, not
+        // a fixture's: nothing is resolved through it.
+        let Ok(hits) = op_hits(world, &op, &cache.path, &turning, &fixed, &meshes) else {
+            return;
+        };
+        let mine: Vec<usize> = warned_moves(&hits).into_iter().filter(|a| warned.binary_search(a).is_ok()).collect();
+        if !mine.is_empty() {
+            fixtures.push(name);
+            covered.extend(mine);
+        }
+    };
+    for (name, entity) in fixture::tagged(world, ctx) {
+        let Some(b) = model::entity_world_aabb(world, &entity) else { continue };
+        let b = FixtureBox { min: b.min, max: b.max };
+        let meshes = model::world_facets(world, &entity)
+            .map(|tris| vec![MeshedFixture::new(name.clone(), b, tris.into())])
+            .unwrap_or_default();
+        if fixture::def_of(world, &entity).is_some_and(|d| d.fixed) {
+            judge(name, Vec::new(), vec![b], meshes);
+        } else {
+            judge(name, vec![b], Vec::new(), meshes);
+        }
+    }
+    if let Some(t) = fixture::table_box(world) {
+        judge(MACHINE_TABLE.to_string(), Vec::new(), vec![t], Vec::new());
+    }
+    let unresolved = warned.iter().copied().filter(|a| !covered.contains(a)).collect();
+    Some(Struck { fixtures, unresolved, warned })
+}
diff --git a/crates/app/src/fixture_view.rs b/crates/app/src/fixture_view.rs
new file mode 100644
index 00000000..98d945b6
--- /dev/null
+++ b/crates/app/src/fixture_view.rs
@@ -0,0 +1,198 @@
+//! What the fixture rows say about each fixture's collision truth (#339
+//! slice 4): judged by its closed mesh, or by its bounding box and why.
+//! The answer is the mesh law's own ([`FixtureMesh::build`], the very
+//! validation `camcraft_sim::verify::mesh_steel` runs), so the row can
+//! never claim a mesh the gate would refuse. Building it indexes the
+//! mesh, so the browser reads it through [`VersionCache`] - once per
+//! document version, never per frame.
+//!
+//! Provenance: our own view over #339 slice 1's mesh law; no vendor
+//! material consulted.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+pub use camcraft_sim::fixture_mesh::MeshError;
+use camcraft_sim::fixture_mesh::FixtureMesh;
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::World;
+
+use crate::fixture::{self, FixtureBox};
+use crate::{model, setup};
+
+/// Why a fixture is judged by its box.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BoxReason {
+    /// The mesh law refused the facets, by name.
+    Refused(MeshError),
+    /// Another fixture of the same setup has the identical world box:
+    /// a box hit cannot be pinned on either mesh, so both keep the box.
+    SharedBox,
+}
+
+/// A fixture's collision truth.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MeshState {
+    /// A closed mesh: the gate judges moves against the real steel.
+    Mesh,
+    /// The bounding box stands (conservative: a path through its gap
+    /// still reports).
+    BoxOnly(BoxReason),
+}
+
+impl BoxReason {
+    /// The few words a browser row has room for.
+    #[must_use]
+    pub const fn short(self) -> &'static str {
+        match self {
+            Self::Refused(MeshError::Empty) => "no facets",
+            Self::Refused(MeshError::NonFinite) => "non-finite",
+            Self::Refused(MeshError::Degenerate) => "collapsed",
+            Self::Refused(MeshError::TooLarge) => "over the facet cap",
+            Self::Refused(MeshError::Open) => "open mesh",
+            Self::SharedBox => "shared box",
+        }
+    }
+}
+
+impl MeshState {
+    /// The row suffix: `mesh`, or `box only: <reason>`.
+    #[must_use]
+    pub fn label(self) -> String {
+        match self {
+            Self::Mesh => "mesh".to_owned(),
+            Self::BoxOnly(why) => format!("box only: {}", why.short()),
+        }
+    }
+
+    /// The Fixtures page's sentence.
+    #[must_use]
+    pub fn detail(self) -> String {
+        match self {
+            Self::Mesh => "judged by its closed mesh - a path through its gaps is clear".to_owned(),
+            Self::BoxOnly(BoxReason::Refused(e)) => format!("judged by its bounding box: {e}"),
+            Self::BoxOnly(BoxReason::SharedBox) => {
+                "judged by its bounding box: another fixture of this setup has the identical box".to_owned()
+            }
+        }
+    }
+}
+
+/// The mesh state of one world mesh standing beside `others` (the
+/// world boxes of the rest of its setup's fixtures). The mesh's own
+/// refusal outranks a shared box: it is the one the user can fix.
+#[must_use]
+pub fn judge(tris: &[crate::geometry::Triangle], aabb: Option<FixtureBox>, others: &[FixtureBox]) -> MeshState {
+    if let Err(e) = FixtureMesh::build(tris) {
+        return MeshState::BoxOnly(BoxReason::Refused(e));
+    }
+    if aabb.is_some_and(|b| others.contains(&b)) {
+        return MeshState::BoxOnly(BoxReason::SharedBox);
+    }
+    MeshState::Mesh
+}
+
+/// Every fixture of setup context `declared`, name order, with its
+/// mesh state. A tagged model with no facets has no box and no mesh.
+#[must_use]
+pub fn mesh_states(world: &World, declared: Option<&str>) -> Vec<(String, MeshState)> {
+    let rows: Vec<(String, Vec<crate::geometry::Triangle>, Option<FixtureBox>)> = fixture::tagged(world, declared)
+        .into_iter()
+        .map(|(name, e)| {
+            let tris = model::world_facets(world, &e).unwrap_or_default();
+            let aabb = model::entity_world_aabb(world, &e).map(|b| FixtureBox { min: b.min, max: b.max });
+            (name, tris, aabb)
+        })
+        .collect();
+    rows.iter()
+        .enumerate()
+        .map(|(i, (name, tris, aabb))| {
+            let others: Vec<FixtureBox> =
+                rows.iter().enumerate().filter(|(j, _)| *j != i).filter_map(|(_, r)| r.2).collect();
+            (name.clone(), judge(tris, *aabb, &others))
+        })
+        .collect()
+}
+
+/// [`mesh_states`] over every setup context (the implicit one when the
+/// document has none), keyed by fixture name - a fixture belongs to
+/// exactly one context, so its name is the key.
+#[must_use]
+pub fn all_mesh_states(world: &World) -> HashMap<String, MeshState> {
+    let names = setup::names(world);
+    let ctxs: Vec<Option<&str>> =
+        if names.is_empty() { vec![None] } else { names.iter().map(|n| Some(n.as_str())).collect() };
+    let mut out = HashMap::new();
+    for ctx in ctxs {
+        out.extend(mesh_states(world, ctx));
+    }
+    out
+}
+
+/// One cached answer per key (a document version, an op): the view
+/// layer reads it every frame from `&self`, the work runs when the key
+/// moves. Interior mutability is a `Mutex` (a poisoned lock is taken
+/// back - the slot is a cache, never truth).
+pub struct VersionCache<K, T> {
+    slot: Mutex<Option<(K, Arc<T>)>>,
+}
+
+impl<K, T> Default for VersionCache<K, T> {
+    fn default() -> Self {
+        Self { slot: Mutex::new(None) }
+    }
+}
+
+impl<K: PartialEq, T> VersionCache<K, T> {
+    /// The cached answer for `key`, or `make()`'s, kept for next time.
+    pub fn get_or(&self, key: K, make: impl FnOnce() -> T) -> Arc<T> {
+        let mut slot = match self.slot.lock() {
+            Ok(g) => g,
+            Err(poisoned) => poisoned.into_inner(),
+        };
+        if let Some((k, v)) = slot.as_ref()
+            && *k == key
+        {
+            return Arc::clone(v);
+        }
+        let v = Arc::new(make());
+        *slot = Some((key, Arc::clone(&v)));
+        v
+    }
+}
+
+impl<K, T> std::fmt::Debug for VersionCache<K, T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("VersionCache")
+    }
+}
+
+/// The browser's cache of [`all_mesh_states`], per document version.
+pub type MeshStateCache = VersionCache<u64, HashMap<String, MeshState>>;
+
+/// [`all_mesh_states`] through `cache`, recomputed when `version` moves.
+pub fn mesh_states_cached(cache: &MeshStateCache, world: &World, version: u64) -> Arc<HashMap<String, MeshState>> {
+    cache.get_or(version, || all_mesh_states(world))
+}
+
+/// The op key a struck-fixture view is cached under: document version,
+/// op name, and the cached path's signature (a regeneration landing
+/// without a version bump still re-resolves).
+pub type StruckKey = (u64, String, u64);
+
+/// The viewport's cache of [`crate::fixture_struck::struck_by`].
+pub type StruckCache = VersionCache<StruckKey, Option<crate::fixture_struck::Struck>>;
+
+/// [`crate::fixture_struck::struck_by`] for `op_name` through `cache`.
+pub fn struck_cached(
+    cache: &StruckCache,
+    world: &World,
+    version: u64,
+    op_name: &str,
+) -> Arc<Option<crate::fixture_struck::Struck>> {
+    // The signature alone: a per-frame read must not clone the path.
+    let sig = model::find_by_name(world, op_name)
+        .and_then(|e| e.entity_view(world).try_get::<&crate::schema::Toolpath>(|tp| tp.path_sig()))
+        .unwrap_or(0);
+    cache.get_or((version, op_name.to_owned(), sig), || crate::fixture_struck::struck_by(world, op_name))
+}
