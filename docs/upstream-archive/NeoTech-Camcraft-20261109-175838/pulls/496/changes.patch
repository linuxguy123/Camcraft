diff --git a/crates/ui/src/state_fixture_library.rs b/crates/ui/src/state_fixture_library.rs
new file mode 100644
index 00000000..b758eab2
--- /dev/null
+++ b/crates/ui/src/state_fixture_library.rs
@@ -0,0 +1,219 @@
+//! The fixture library dialogs' state (#339 slice 6): "Save fixture to
+//! library…" and "Insert from library…" on a setup's Fixtures node.
+//! Saving and deleting entries are file edits of the user library
+//! (`app::fixture_library`), confirmed in the dialog and never undo
+//! entries - the #383 machine-file law. Inserting is a document change,
+//! so it is the undoable `InsertFixture` command, queued like any other.
+//! Provenance: our own dialog state over our own library format; no
+//! vendor fixture material consulted.
+
+use std::path::PathBuf;
+
+use camcraft_app::commands::InsertFixture;
+use camcraft_app::fixture;
+use camcraft_app::fixture_library::{self, DatumChoice, LibraryError};
+use camcraft_app::geometry::{Point3, quat_from_euler};
+use camcraft_app::model;
+use camcraft_app::schema::Location;
+
+use super::{ErrorScope, State};
+
+/// One library entry as the insert dialog lists it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct LibraryRow {
+    pub name: String,
+    pub note: Option<String>,
+    pub facets: usize,
+}
+
+/// "Save fixture to library…": which of the setup's fixtures, by which
+/// datum, with what note. `confirm_replace` holds the names already in
+/// the library while the dialog asks before replacing them.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SaveFixtureDraft {
+    /// The Fixtures node's setup (`""` - the implicit setup).
+    pub setup: String,
+    pub fixtures: Vec<(String, bool)>,
+    pub datum: DatumChoice,
+    pub note: String,
+    pub confirm_replace: Option<Vec<String>>,
+    pub error: Option<String>,
+}
+
+/// "Insert from library…": the listed entries, the picked one, the
+/// datum's placement (mm and degrees, R = Rz ⊗ Ry ⊗ Rx as the Model
+/// page) and a pending delete confirmation.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct InsertFixtureDraft {
+    pub setup: String,
+    pub rows: Vec<LibraryRow>,
+    pub selected: Option<String>,
+    pub pos: [f64; 3],
+    pub rpy_deg: [f64; 3],
+    pub confirm_delete: Option<String>,
+    pub error: Option<String>,
+}
+
+/// The open fixture library dialog, if any (view state, never saved).
+#[derive(Clone, Debug, PartialEq)]
+pub enum FixtureLibDialog {
+    Save(SaveFixtureDraft),
+    Insert(InsertFixtureDraft),
+}
+
+fn declared(setup: &str) -> Option<&str> {
+    (!setup.is_empty()).then_some(setup)
+}
+
+impl State {
+    /// The library file this window edits: the test override, else the
+    /// user fixtures folder (`CAMCRAFT_FIXTURES`, else the data dir).
+    pub fn fixture_library_path(&self) -> Result<PathBuf, String> {
+        self.fixture_lib_dir
+            .clone()
+            .or_else(fixture_library::user_dir)
+            .map(|d| fixture_library::library_path(&d))
+            .ok_or_else(|| format!("no user fixtures folder (set {} or a home folder)", fixture_library::ENV_VAR))
+    }
+
+    /// Open the save dialog over `setup`'s fixtures; the selected ones
+    /// start checked (the only one, when a setup has just one).
+    pub fn open_fixture_library_save(&mut self, setup: String) {
+        let w = &self.world;
+        let tagged = fixture::tagged(w, declared(&setup));
+        let lone = tagged.len() == 1;
+        let fixtures = tagged.iter().map(|(n, e)| (n.clone(), lone || model::is_selected(w, e))).collect();
+        self.fixture_lib = Some(FixtureLibDialog::Save(SaveFixtureDraft { setup, fixtures, ..Default::default() }));
+    }
+
+    /// Open the insert dialog over `setup`, listing the library afresh.
+    pub fn open_fixture_library_insert(&mut self, setup: String) {
+        let mut draft = InsertFixtureDraft { setup, ..Default::default() };
+        self.reload_library_rows(&mut draft);
+        self.fixture_lib = Some(FixtureLibDialog::Insert(draft));
+    }
+
+    fn reload_library_rows(&self, draft: &mut InsertFixtureDraft) {
+        let read = self.fixture_library_path().and_then(|p| fixture_library::load(&p).map_err(|e| e.to_string()));
+        match read {
+            Ok(lib) => {
+                draft.rows = lib
+                    .into_iter()
+                    .map(|e| LibraryRow { name: e.name, note: e.note, facets: e.facets.len() })
+                    .collect();
+                draft.error = None;
+            }
+            Err(err) => {
+                draft.rows.clear();
+                draft.error = Some(format!("library not read: {err}"));
+            }
+        }
+        if !draft.selected.as_ref().is_some_and(|s| draft.rows.iter().any(|r| &r.name == s)) {
+            draft.selected = draft.rows.first().map(|r| r.name.clone());
+        }
+    }
+
+    /// The save dialog's Save (and, after the replace prompt, Replace):
+    /// writes the checked fixtures into the library file. A clash asks
+    /// first (`confirm_replace`); a refusal stays in the dialog by name.
+    pub fn save_fixtures_to_library(&mut self, replace: bool) {
+        let Some(FixtureLibDialog::Save(draft)) = self.fixture_lib.as_ref() else {
+            return;
+        };
+        let names: Vec<String> = draft.fixtures.iter().filter(|(_, on)| *on).map(|(n, _)| n.clone()).collect();
+        let entries = if names.is_empty() {
+            Err("check a fixture to save".to_owned())
+        } else {
+            names
+                .iter()
+                .map(|n| fixture_library::entry_from_model(&self.world, n, draft.datum, Some(draft.note.as_str())))
+                .collect::<Result<Vec<_>, _>>()
+        };
+        let outcome = entries.and_then(|entries| {
+            let path = self.fixture_library_path()?;
+            Ok(fixture_library::add_entries(&path, entries, replace).map(|()| path))
+        });
+        let Some(FixtureLibDialog::Save(draft)) = self.fixture_lib.as_mut() else {
+            return;
+        };
+        match outcome {
+            Ok(Ok(path)) => {
+                self.status = format!("saved {} fixture(s) to {}", names.len(), path.display());
+                self.fixture_lib = None;
+            }
+            Ok(Err(LibraryError::Exists(taken))) => {
+                draft.confirm_replace = Some(taken);
+                draft.error = None;
+            }
+            Ok(Err(err)) => {
+                draft.confirm_replace = None;
+                draft.error = Some(format!("not saved: {err}"));
+            }
+            Err(err) => {
+                draft.confirm_replace = None;
+                draft.error = Some(format!("not saved: {err}"));
+            }
+        }
+    }
+
+    /// The insert dialog's confirmed Delete: removes the entry from the
+    /// library file (no undo - a file edit, asked first) and re-lists.
+    pub fn delete_library_entry(&mut self, name: &str) {
+        let done = self
+            .fixture_library_path()
+            .and_then(|p| fixture_library::delete_entry(&p, name).map_err(|e| e.to_string()));
+        let Some(FixtureLibDialog::Insert(mut draft)) = self.fixture_lib.take() else {
+            return;
+        };
+        draft.confirm_delete = None;
+        self.reload_library_rows(&mut draft);
+        match done {
+            Ok(()) => self.status = format!("deleted '{name}' from the fixture library"),
+            Err(err) => draft.error = Some(format!("not deleted: {err}")),
+        }
+        self.fixture_lib = Some(FixtureLibDialog::Insert(draft));
+    }
+
+    /// `CommandKind::InsertFixtureFromLibrary`: read the entry afresh and
+    /// execute `InsertFixture` - one undo unit. Closes the dialog on
+    /// success; a refusal names the entry and leaves the dialog open.
+    pub(super) fn insert_fixture_from_library(
+        &mut self,
+        entry: &str,
+        setup: Option<String>,
+        pos: [f64; 3],
+        rpy_deg: [f64; 3],
+    ) {
+        if rpy_deg.iter().any(|a| !a.is_finite()) {
+            self.refuse(ErrorScope::Setup, "fixture not inserted: rotation angles must be finite".into());
+            return;
+        }
+        let pick = Location {
+            pos: Point3::new(pos[0], pos[1], pos[2]),
+            rot: quat_from_euler(rpy_deg[0].to_radians(), rpy_deg[1].to_radians(), rpy_deg[2].to_radians()),
+        };
+        let planned = self
+            .fixture_library_path()
+            .and_then(|p| fixture_library::load(&p).map_err(|e| e.to_string()))
+            .and_then(|lib| {
+                lib.into_iter().find(|e| e.name == entry).ok_or_else(|| format!("no fixture '{entry}' in the library"))
+            })
+            .and_then(|e| InsertFixture::new(&self.world, &e, setup.as_deref(), pick).map_err(|e| e.to_string()));
+        match planned {
+            Ok(command) => {
+                let name = command.name().to_owned();
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = format!("inserted fixture {name} from the library");
+                self.fixture_lib = None;
+            }
+            Err(err) => {
+                let msg = format!("fixture '{entry}' not inserted: {err}");
+                if let Some(FixtureLibDialog::Insert(d)) = self.fixture_lib.as_mut() {
+                    d.error = Some(msg.clone());
+                }
+                self.refuse(ErrorScope::Setup, msg);
+            }
+        }
+    }
+}
diff --git a/docs/decisions/339-fixture-library.md b/docs/decisions/339-fixture-library.md
new file mode 100644
index 00000000..62c6cb12
--- /dev/null
+++ b/docs/decisions/339-fixture-library.md
@@ -0,0 +1,87 @@
+## #339 - fixture library (slice 6)
+
+**Decided:**
+
+- **One library file, `fixtures.camfixtures`, in the user fixtures
+  folder.** The folder is `CAMCRAFT_FIXTURES` (absolute), else
+  `<platform data dir>/camcraft/fixtures`. That is the sibling of the
+  `camcraft/machines` folder that #383 resolves the same way
+  (`fixture_library::user_dir_for`, a pure twin of that resolver). A
+  single file, not one file per fixture: the triage asked for "a library
+  file", and one file keeps entry names unique by construction. The
+  tool library (#300) has no fixed home; its files go wherever the user
+  saves them. Fixtures are picked from the browser, so they need a known
+  place.
+- **Format `camcraft-fixtures`, version 1**, the `camcraft-tools/1`
+  envelope shape: `{format, version, units: "mm", fixtures: [...]}`.
+  - Each entry is `{name, note?, datum: {origin, rot}, facets}`.
+  - Entries are written sorted by name, one facet per line, so a big
+    mesh is a list of lines rather than one number per line.
+  - save -> load -> save is byte-stable. The datum `rot` is kept exactly
+    as written; it is normalized only where it is placed.
+  - The reader refuses the whole file and names the entry for: bad JSON,
+    a wrong format, version or units, a missing name, datum or facets,
+    a name used twice, an empty mesh, a malformed facet, a non-rotation
+    `rot`, over 2,000,000 facets, or the reserved `Machine/Table` name.
+  - The writer runs the same per-entry check (`check_entry`), so a file
+    we write always reads back.
+- **What an entry stores.** Facets are the fixture's mesh in its own
+  model frame: the exact bytes of its `Facets`, without its document
+  pose. `datum` is a frame inside that model frame. On insert, the datum
+  lands on the picked frame, so the model's `Location = P ∘ D⁻¹`
+  (`insert_fixture::place_datum`).
+  - The save dialog offers two datums. **Model origin** (the default) is
+    identity, so a fixture saved and re-inserted at its old pose stands
+    exactly where it stood (pinned by test). **Bottom centre** is the
+    centre of the mesh's bounding-box bottom, which suits a vise or
+    plate dropped onto a table point.
+  - Dropped: storing the mesh re-expressed in the datum frame with no
+    datum. That loses the original bytes, and the triage asks for a
+    stored placement datum.
+- **Duplicate names.**
+  - **In the library: refuse, then ask.** Saving a name that is already
+    in the library returns `Exists(names)`, and the dialog asks
+    "Replace …?" (Replace / Cancel). In a library the name is the only
+    handle the user has, so a silent "(2)" would leave twins they cannot
+    tell apart.
+  - **In the document: suffix.** Inserting an entry whose name is taken
+    in the document lands as "Vise (2)", "Vise (3)", and so on
+    (`insert_fixture::free_name`). Two of the same vise on one table is
+    ordinary shop work.
+- **Insert is one undoable command.** `InsertFixture` spawns the model
+  (facets, rev 1), writes its pose and puts on the `FixtureDef` of the
+  Fixtures node's setup (`fixed: false`). It is one undo unit, and its
+  invert removes the model by name. It is refused at construction for:
+  a setup that is gone, a non-finite pick or non-rotation, or an entry
+  that fails `check_entry`. The UI re-reads the entry from the file at
+  Insert time, so the dialog never inserts a stale copy.
+- **No project-file change.** An inserted fixture is an ordinary tagged
+  model. The pinning test saves, reloads and resaves, and the two files
+  match byte for byte. The library source is not recorded: nothing reads
+  it yet, and an optional key can be added later without a version rung.
+- **Save and delete are file edits, not undo entries**, as with machine
+  files (#383).
+  - Delete asks first: "Delete '…' from the library? This edits the file
+    and cannot be undone." with Delete / Keep.
+  - Writes are atomic (temp file plus rename).
+  - A refused or unreadable library file is never overwritten.
+  - A missing file is the empty library. A corrupt file is named in the
+    dialog, never shown as empty.
+- **UI.**
+  - The Fixtures node menu (slice 4) gains "Save fixture to library…" and
+    "Insert from library…".
+  - Both open a modal, drawn like the unsaved prompt.
+  - **Save dialog:** the setup's fixtures as checkboxes. The selected
+    ones start checked; a setup with a single fixture starts with it
+    checked. Below them are the datum radio and a note.
+  - **Insert dialog:** the entries (name, facet count, note), the datum
+    origin (unit-lens fields, stored in mm) and roll / pitch / yaw
+    (degrees, R = Rz ⊗ Ry ⊗ Rx, the Model page's convention), then
+    Insert, Delete from library… and Close.
+  - Picking the datum in the viewport is a follow-up. This slice takes
+    numbers.
+- **Not shared with #383's store yet.** The atomic write is a ~20-line
+  copy of #383's `write_atomic`, because #383 is not merged under this
+  stack. Fold the two into one helper once both land.
+- **Clean room:** the library holds only what the user saves. No vendor
+  fixture library, asset or format was read, consulted or shipped.
