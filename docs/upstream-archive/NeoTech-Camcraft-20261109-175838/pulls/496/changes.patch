new file mode 100644
index 00000000..1cb664d1
--- /dev/null
+++ b/crates/sim/src/fixture_mesh/gjk.rs
@@ -0,0 +1,284 @@
+//! Separation of two convex shapes by the Gilbert-Johnson-Keerthi
+//! search (#339): is there a plane holding them apart by more than a
+//! margin? The narrow phase of the fixture mesh law - a swept tool band
+//! against one triangle, or against one BVH node's box.
+//!
+//! Provenance: Gilbert, Johnson, Keerthi, "A fast procedure for
+//! computing the distance between complex objects in three-dimensional
+//! space", IEEE J. Robotics and Automation 4(2), 1988; the lower-bound
+//! termination of van den Bergen, "A Fast and Robust GJK Implementation
+//! for Collision Detection of Convex Objects", J. Graphics Tools 4(2),
+//! 1999; the closest-point-on-simplex routines of Ericson, "Real-Time
+//! Collision Detection", 2005, ch. 5.1. Our own code.
+//!
+//! ## Why the answer is conservative
+//!
+//! "Separated" is only ever returned on a PROOF: a direction `v` and a
+//! support point `w` of the difference set A - B in direction `-v`, with
+//! `v.w / |v| > margin`. That is the supporting-hyperplane bound - every
+//! point x of A - B has `x.v >= w.v` - so every point of A sits more than
+//! `margin` from every point of B. The proof needs nothing from the
+//! simplex arithmetic: rounding or a degenerate simplex there can only
+//! slow the search or end it early, and an unfinished search answers
+//! "not separated" (a hit). The supports below are exact for the shapes
+//! they name, so the bound is exact up to float dust far below
+//! `FIXTURE_HIT_TOL`.
+
+pub(super) type V = [f64; 3];
+
+pub(super) fn sub(a: V, b: V) -> V {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+pub(super) fn add(a: V, b: V) -> V {
+    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
+}
+
+pub(super) fn dot(a: V, b: V) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+pub(super) fn cross(a: V, b: V) -> V {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn scale(a: V, s: f64) -> V {
+    [a[0] * s, a[1] * s, a[2] * s]
+}
+
+fn neg(a: V) -> V {
+    [-a[0], -a[1], -a[2]]
+}
+
+/// A convex shape known by its support mapping: the point of the shape
+/// farthest along `d`.
+pub(super) trait Support {
+    fn support(&self, d: V) -> V;
+}
+
+/// An upright tool band swept along a straight tip segment: the
+/// vertical cylinder of radius `r` standing `lo..hi` above the tip,
+/// carried from `p0` to `p1`. Exactly the Minkowski sum segment +
+/// axial segment + horizontal disc - convex, so its support is the sum
+/// of the three supports.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct SweptBand {
+    pub p0: V,
+    pub p1: V,
+    pub lo: f64,
+    pub hi: f64,
+    pub r: f64,
+}
+
+impl Support for SweptBand {
+    fn support(&self, d: V) -> V {
+        let run = sub(self.p1, self.p0);
+        let mut p = if dot(d, run) > 0.0 { self.p1 } else { self.p0 };
+        p[2] += if d[2] > 0.0 { self.hi } else { self.lo };
+        let h = d[0].hypot(d[1]);
+        if h > 0.0 && h.is_finite() {
+            p[0] += self.r * d[0] / h;
+            p[1] += self.r * d[1] / h;
+        }
+        p
+    }
+}
+
+impl SweptBand {
+    /// The band's axis-aligned bounds.
+    pub(super) fn bounds(&self) -> (V, V) {
+        let mut lo = [0.0; 3];
+        let mut hi = [0.0; 3];
+        for k in 0..2 {
+            lo[k] = self.p0[k].min(self.p1[k]) - self.r;
+            hi[k] = self.p0[k].max(self.p1[k]) + self.r;
+        }
+        lo[2] = self.p0[2].min(self.p1[2]) + self.lo;
+        hi[2] = self.p0[2].max(self.p1[2]) + self.hi;
+        (lo, hi)
+    }
+}
+
+/// A triangle (or a degenerate one: the support is still its hull's).
+pub(super) struct Tri(pub [V; 3]);
+
+impl Support for Tri {
+    fn support(&self, d: V) -> V {
+        let [a, b, c] = self.0;
+        let (da, db, dc) = (dot(a, d), dot(b, d), dot(c, d));
+        if da >= db && da >= dc {
+            a
+        } else if db >= dc {
+            b
+        } else {
+            c
+        }
+    }
+}
+
+/// An axis-aligned box.
+pub(super) struct Boxed {
+    pub lo: V,
+    pub hi: V,
+}
+
+impl Support for Boxed {
+    fn support(&self, d: V) -> V {
+        [0, 1, 2].map(|k| if d[k] > 0.0 { self.hi[k] } else { self.lo[k] })
+    }
+}
+
+/// Search cap: a search this long without a proof answers "hit".
+const MAX_ITERS: usize = 48;
+/// Relative progress under which the search has converged.
+const REL_EPS: f64 = 1e-12;
+
+/// Is there a plane holding `a` and `b` more than `margin` apart?
+/// `true` only with a proof (module header); anything else - touching,
+/// overlapping, non-finite input, an exhausted search - is `false`.
+pub(super) fn separated(a: &impl Support, b: &impl Support, margin: f64) -> bool {
+    let cso = |d: V| sub(a.support(d), b.support(neg(d)));
+    let mut v = cso([1.0, 0.0, 0.0]);
+    let mut simplex: Vec<V> = Vec::with_capacity(4);
+    for _ in 0..MAX_ITERS {
+        let vv = dot(v, v);
+        if !vv.is_finite() || vv <= 1e-30 {
+            return false;
+        }
+        let w = cso(neg(v));
+        let vw = dot(v, w);
+        if !vw.is_finite() {
+            return false;
+        }
+        // The proof: the whole difference set lies past the plane
+        // x.v = w.v, which stands vw/|v| from the origin.
+        if vw > 0.0 && vw > margin * vv.sqrt() {
+            return true;
+        }
+        if vv - vw <= REL_EPS * vv {
+            return false; // converged within the margin: contact
+        }
+        simplex.push(w);
+        match closest(&mut simplex) {
+            Some(nv) => v = nv,
+            None => return false,
+        }
+    }
+    false
+}
+
+/// The point of the simplex's hull closest to the origin, reducing the
+/// simplex to the smallest face holding it. None: the origin is inside
+/// a solid tetrahedron (overlap).
+fn closest(s: &mut Vec<V>) -> Option<V> {
+    match s.len() {
+        1 => Some(s[0]),
+        2 => {
+            let (p, keep) = on_segment(s[0], s[1]);
+            *s = keep;
+            Some(p)
+        }
+        3 => {
+            let (p, keep) = on_triangle(s[0], s[1], s[2]);
+            *s = keep;
+            Some(p)
+        }
+        _ => on_tetra(s),
+    }
+}
+
+fn on_segment(a: V, b: V) -> (V, Vec<V>) {
+    let ab = sub(b, a);
+    let den = dot(ab, ab);
+    let t = if den > 0.0 { (-dot(a, ab) / den).clamp(0.0, 1.0) } else { 0.0 };
+    if t <= 0.0 {
+        (a, vec![a])
+    } else if t >= 1.0 {
+        (b, vec![b])
+    } else {
+        (add(a, scale(ab, t)), vec![a, b])
+    }
+}
+
+/// Ericson's ClosestPtPointTriangle (Voronoi regions), with the origin
+/// as the query point, returning the feature that holds the answer.
+fn on_triangle(a: V, b: V, c: V) -> (V, Vec<V>) {
+    let (ab, ac, ap) = (sub(b, a), sub(c, a), neg(a));
+    let (d1, d2) = (dot(ab, ap), dot(ac, ap));
+    if d1 <= 0.0 && d2 <= 0.0 {
+        return (a, vec![a]);
+    }
+    let bp = neg(b);
+    let (d3, d4) = (dot(ab, bp), dot(ac, bp));
+    if d3 >= 0.0 && d4 <= d3 {
+        return (b, vec![b]);
+    }
+    let vc = d1 * d4 - d3 * d2;
+    if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
+        let t = d1 / (d1 - d3);
+        return (add(a, scale(ab, t)), vec![a, b]);
+    }
+    let cp = neg(c);
+    let (d5, d6) = (dot(ab, cp), dot(ac, cp));
+    if d6 >= 0.0 && d5 <= d6 {
+        return (c, vec![c]);
+    }
+    let vb = d5 * d2 - d1 * d6;
+    if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 {
+        let t = d2 / (d2 - d6);
+        return (add(a, scale(ac, t)), vec![a, c]);
+    }
+    let va = d3 * d6 - d5 * d4;
+    if va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0 {
+        let t = (d4 - d3) / ((d4 - d3) + (d5 - d6));
+        return (add(b, scale(sub(c, b), t)), vec![b, c]);
+    }
+    let den = va + vb + vc;
+    if den.abs() <= 0.0 || !den.is_finite() {
+        // A collinear simplex: the best of its edges.
+        return best_edge(a, b, c);
+    }
+    let (v, w) = (vb / den, vc / den);
+    (add(a, add(scale(ab, v), scale(ac, w))), vec![a, b, c])
+}
+
+fn best_edge(a: V, b: V, c: V) -> (V, Vec<V>) {
+    let cands = [on_segment(a, b), on_segment(b, c), on_segment(a, c)];
+    let mut best = cands[0].clone();
+    for cand in cands.into_iter().skip(1) {
+        if dot(cand.0, cand.0) < dot(best.0, best.0) {
+            best = cand;
+        }
+    }
+    best
+}
+
+/// The closest point of a tetrahedron: the origin strictly inside all
+/// four face planes is overlap (None); otherwise the nearest of the
+/// faces the origin lies outside of - every face when the tetrahedron
+/// is flat, so a degenerate simplex still answers its hull's point.
+fn on_tetra(s: &mut Vec<V>) -> Option<V> {
+    let (a, b, c, d) = (s[0], s[1], s[2], s[3]);
+    let faces = [(a, b, c, d), (a, c, d, b), (a, d, b, c), (b, d, c, a)];
+    let mut outside_any = false;
+    let mut best: Option<(V, Vec<V>)> = None;
+    for &(p, q, r, opp) in &faces {
+        let n = cross(sub(q, p), sub(r, p));
+        let side_o = dot(neg(p), n);
+        let side_opp = dot(sub(opp, p), n);
+        let flat = side_opp.abs() <= 1e-18 * (dot(n, n).sqrt() + 1.0);
+        if flat || side_o * side_opp < 0.0 {
+            outside_any = true;
+            let cand = on_triangle(p, q, r);
+            if best.as_ref().is_none_or(|b| dot(cand.0, cand.0) < dot(b.0, b.0)) {
+                best = Some(cand);
+            }
+        }
+    }
+    if !outside_any {
+        return None;
+    }
+    let (p, keep) = best?;
+    *s = keep;
+    Some(p)
+}
diff --git a/crates/sim/src/fixture_mesh/mod.rs b/crates/sim/src/fixture_mesh/mod.rs
new file mode 100644
index 00000000..6edf5bfc
--- /dev/null
+++ b/crates/sim/src/fixture_mesh/mod.rs
@@ -0,0 +1,217 @@
+//! A fixture's real triangle mesh as collision truth (#339): the
+//! narrow phase behind the world-AABB fixture laws. A vise is two jaws
+//! with a gap; its box is one block - every path through the gap was a
+//! false crash. This module answers, for one tool band swept along one
+//! tip segment, "does it come within a margin of the steel, or stand
+//! inside it?" against the mesh itself.
+//!
+//! Provenance: our own design on published methods - GJK separation
+//! ([`gjk`]), an axis-aligned BVH ([`bvh`]), ray-crossing point-in-solid
+//! ([`ray`]); a closed mesh as a 2-cycle (every edge used equally often
+//! in both directions) is the boundary condition of simplicial homology
+//! as stated in Botsch et al., "Polygon Mesh Processing", 2010, ch. 1.
+//! No vendor geometry, model, or implementation was inspected.
+//!
+//! ## The laws here
+//!
+//! - **Only a closed mesh judges.** Point-in-solid needs a solid: a
+//!   mesh whose edges do not pair up (an open sheet, a crack, a
+//!   T-junction) refuses by name ([`MeshError::Open`]) and its fixture
+//!   keeps the box verdict. Vertices pair by exact bits, the importers'
+//!   own sharing; `RepairModel` welds a cracked one.
+//! - **Hit = not proven clear.** A band is clear of the mesh only when
+//!   GJK proves a separating plane with more than the margin to spare
+//!   for every triangle near it, AND the band does not stand inside the
+//!   solid. Every unproven case is a hit.
+//! - **Degenerate input is named, never fatal.** No facets, non-finite
+//!   coordinates, all facets collapsed, or past [`MAX_MESH_TRIS`]: a
+//!   [`MeshError`], and the caller falls back to the box. Zero-area
+//!   facets inside a good mesh still pair edges and still meet tools;
+//!   only the ray test skips them (they have no interior to cross).
+
+mod bvh;
+mod gjk;
+mod ray;
+
+use std::collections::HashMap;
+use std::sync::{Arc, OnceLock};
+
+use crate::fixture::FixtureBox;
+use crate::geometry::{Point3, Triangle};
+
+use gjk::{Boxed, SweptBand, Tri, V};
+
+/// The most facets one fixture mesh is judged with; past it the box
+/// verdict stands (memory: ~200 bytes a facet with its BVH share).
+pub const MAX_MESH_TRIS: usize = 4_000_000;
+
+/// Why a fixture's mesh cannot judge. Each refusal names itself; the
+/// fixture then answers with its world box, as before #339.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MeshError {
+    Empty,
+    NonFinite,
+    Degenerate,
+    TooLarge,
+    /// Edges that do not pair up: no inside to speak of.
+    Open,
+}
+
+impl std::fmt::Display for MeshError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::Empty => "the fixture mesh has no facets",
+            Self::NonFinite => "the fixture mesh has non-finite coordinates",
+            Self::Degenerate => "every facet of the fixture mesh is collapsed",
+            Self::TooLarge => "the fixture mesh has more than 4,000,000 facets",
+            Self::Open => "the fixture mesh is not closed (open edges, cracks or T-junctions - Repair Model may close it)",
+        })
+    }
+}
+
+impl std::error::Error for MeshError {}
+
+/// A validated, closed fixture mesh with its BVH.
+#[derive(Clone, Debug)]
+pub struct FixtureMesh {
+    tris: Vec<[V; 3]>,
+    /// Zero-area facets (skipped by the ray test only).
+    flat: Vec<bool>,
+    bvh: bvh::Bvh,
+    /// Float-dust pad at this mesh's coordinate scale.
+    pad: f64,
+}
+
+fn v(p: Point3) -> V {
+    [p.x, p.y, p.z]
+}
+
+/// Exact-bits vertex key; -0.0 and 0.0 are one position.
+fn key(p: V) -> [u64; 3] {
+    p.map(|c| if c == 0.0 { 0u64 } else { c.to_bits() })
+}
+
+impl FixtureMesh {
+    /// Validate and index `tris` (world frame). Refuses by name; see
+    /// [`MeshError`].
+    pub fn build(tris: &[Triangle]) -> Result<Self, MeshError> {
+        if tris.is_empty() {
+            return Err(MeshError::Empty);
+        }
+        if tris.len() > MAX_MESH_TRIS {
+            return Err(MeshError::TooLarge);
+        }
+        if !tris.iter().all(|t| t.a.is_finite() && t.b.is_finite() && t.c.is_finite()) {
+            return Err(MeshError::NonFinite);
+        }
+        let mut ids: HashMap<[u64; 3], u32> = HashMap::with_capacity(tris.len());
+        let mut id = |p: V| {
+            let next = u32::try_from(ids.len()).unwrap_or(u32::MAX);
+            *ids.entry(key(p)).or_insert(next)
+        };
+        // Signed use count per undirected edge: +1 low->high, -1 back.
+        let mut edges: HashMap<(u32, u32), i32> = HashMap::with_capacity(tris.len() * 2);
+        let mut kept: Vec<[V; 3]> = Vec::with_capacity(tris.len());
+        let mut scale = 1.0f64;
+        for t in tris {
+            let c = [v(t.a), v(t.b), v(t.c)];
+            let (ia, ib, ic) = (id(c[0]), id(c[1]), id(c[2]));
+            if ia == ib || ib == ic || ia == ic {
+                continue; // collapsed: no edges, no steel
+            }
+            for (p, q) in [(ia, ib), (ib, ic), (ic, ia)] {
+                let (k, s) = if p < q { ((p, q), 1) } else { ((q, p), -1) };
+                *edges.entry(k).or_insert(0) += s;
+            }
+            for p in &c {
+                scale = scale.max(p[0].abs()).max(p[1].abs()).max(p[2].abs());
+            }
+            kept.push(c);
+        }
+        if kept.is_empty() {
+            return Err(MeshError::Degenerate);
+        }
+        if edges.values().any(|&s| s != 0) {
+            return Err(MeshError::Open);
+        }
+        let flat = kept
+            .iter()
+            .map(|[a, b, c]| {
+                let n = gjk::cross(gjk::sub(*b, *a), gjk::sub(*c, *a));
+                gjk::dot(n, n) <= 1e-24
+            })
+            .collect();
+        let bvh = bvh::Bvh::build(&kept);
+        Ok(Self { tris: kept, flat, bvh, pad: 1e-9 * scale })
+    }
+
+    /// Facets judged (collapsed ones dropped).
+    #[must_use]
+    pub fn len(&self) -> usize {
+        self.tris.len()
+    }
+
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.tris.is_empty()
+    }
+
+    /// Does the upright band of radius `r`, standing `lo..hi` above the
+    /// tip, swept as the tip runs `p0`->`p1`, come within `margin` of
+    /// any facet? (Not inside-the-solid: see [`Self::contains`].)
+    /// Non-finite input is a hit.
+    #[must_use]
+    pub fn band_meets(&self, p0: Point3, p1: Point3, lo: f64, hi: f64, r: f64, margin: f64) -> bool {
+        let band = SweptBand { p0: v(p0), p1: v(p1), lo: lo.min(hi), hi: hi.max(lo), r: r.max(0.0) };
+        if !(p0.is_finite() && p1.is_finite() && lo.is_finite() && hi.is_finite() && r.is_finite()) {
+            return true;
+        }
+        let margin = margin.max(0.0) + self.pad;
+        let (blo, bhi) = band.bounds();
+        self.bvh.walk(
+            |n| bvh::boxes_meet(n.lo, n.hi, blo, bhi, margin) && !gjk::separated(&band, &Boxed { lo: n.lo, hi: n.hi }, margin),
+            |t| {
+                let Some(tri) = self.tris.get(t) else { return false };
+                let (tlo, thi) = bvh::tri_box(tri);
+                bvh::boxes_meet(tlo, thi, blo, bhi, margin) && !gjk::separated(&band, &Tri(*tri), margin)
+            },
+        )
+    }
+
+    /// Is `p` inside the closed solid? Ambiguity reads as inside.
+    #[must_use]
+    pub fn contains(&self, p: Point3) -> bool {
+        ray::inside(self, v(p))
+    }
+}
+
+/// One fixture as the mesh law reads it: its world box (the very box
+/// the box laws judge, so the two can be paired) and its world facets,
+/// indexed on first use - a fixture no box law ever flags never pays
+/// for its BVH.
+#[derive(Debug)]
+pub struct MeshedFixture {
+    pub name: String,
+    pub aabb: FixtureBox,
+    tris: Arc<[Triangle]>,
+    mesh: OnceLock<Result<FixtureMesh, MeshError>>,
+}
+
+impl MeshedFixture {
+    #[must_use]
+    pub fn new(name: impl Into<String>, aabb: FixtureBox, tris: Arc<[Triangle]>) -> Self {
+        Self { name: name.into(), aabb, tris, mesh: OnceLock::new() }
+    }
+
+    /// The indexed mesh, built on first call.
+    pub fn mesh(&self) -> Result<&FixtureMesh, MeshError> {
+        self.mesh.get_or_init(|| FixtureMesh::build(&self.tris)).as_ref().map_err(|e| *e)
+    }
+
+    /// Why this fixture's mesh could not judge - only once something
+    /// asked it to (None before that, and None when it judged).
+    #[must_use]
+    pub fn refusal(&self) -> Option<MeshError> {
+        self.mesh.get().and_then(|r| r.as_ref().err().copied())
+    }
+}
diff --git a/crates/sim/src/fixture_mesh/ray.rs b/crates/sim/src/fixture_mesh/ray.rs
new file mode 100644
index 00000000..a076800b
--- /dev/null
+++ b/crates/sim/src/fixture_mesh/ray.rs
@@ -0,0 +1,119 @@
+//! Point-in-solid for a closed fixture mesh (#339): the one question the
+//! surface-distance test cannot answer - a tool band standing wholly
+//! INSIDE steel is far from every triangle, yet a crash.
+//!
+//! Provenance: ray-crossing inclusion with signed crossings (the winding
+//! number of a closed oriented surface; Haines, "Point in Polygon
+//! Strategies", Graphics Gems IV, 1994, and its 3-D form in O'Rourke,
+//! "Computational Geometry in C", 2nd ed., ch. 7); the ray-triangle test
+//! is Moller and Trumbore, "Fast, Minimum Storage Ray-Triangle
+//! Intersection", J. Graphics Tools 2(1), 1997. Our own code.
+//!
+//! ## Why the answer is conservative
+//!
+//! A ray that crosses only triangle interiors, transversally, counts
+//! the winding number of a closed oriented mesh exactly. Any crossing
+//! near an edge, a vertex, or a plane the ray runs along is AMBIGUOUS:
+//! that ray is discarded and the next fixed direction tried. "Outside"
+//! is answered only from an unambiguous ray that saw winding zero AND
+//! even parity; when every direction is ambiguous the point reads as
+//! inside - a hit, never a silent pass.
+
+use super::bvh::ray_meets;
+use super::gjk::{cross, dot, sub, V};
+use super::FixtureMesh;
+
+/// Fixed, deliberately non-axis-aligned directions (unit-ish - only the
+/// direction matters): axis-aligned vises then never present a face
+/// edge-on or an edge exactly in line.
+const DIRS: [V; 6] = [
+    [0.573_576_436, 0.611_483_773, 0.545_517_416],
+    [-0.433_012_702, 0.250_000_000, 0.866_025_404],
+    [0.316_227_766, -0.709_403_271, 0.629_861_003],
+    [-0.618_033_989, -0.381_966_011, -0.687_157_220],
+    [0.801_783_726, 0.267_261_242, -0.534_522_484],
+    [-0.267_261_242, 0.801_783_726, -0.534_522_484],
+];
+
+/// Barycentric margin under which a crossing is "at an edge".
+const EDGE_EPS: f64 = 1e-7;
+/// Sine of the angle under which the ray "runs along" a facet's plane.
+const GRAZE_SIN: f64 = 1e-6;
+
+/// One ray's reading: Some((winding, crossings)) or None (ambiguous).
+fn cast(mesh: &FixtureMesh, o: V, d: V) -> Option<(i64, u64)> {
+    let mut wind = 0i64;
+    let mut count = 0u64;
+    let mut ambiguous = false;
+    mesh.bvh.walk(
+        |n| ray_meets(o, d, n.lo, n.hi, mesh.pad),
+        |t| {
+            let Some(tri) = mesh.tris.get(t) else { return false };
+            if mesh.flat.get(t).copied().unwrap_or(false) {
+                return false; // no interior to cross; its neighbours' edges decide
+            }
+            let [a, b, c] = *tri;
+            let (e1, e2) = (sub(b, a), sub(c, a));
+            let n = cross(e1, e2);
+            let nn = dot(n, n).sqrt();
+            let dn = dot(d, n);
+            let p = cross(d, e2);
+            let det = dot(e1, p);
+            if !det.is_finite() {
+                ambiguous = true;
+                return true;
+            }
+            if dn.abs() <= GRAZE_SIN * dot(d, d).sqrt() * nn {
+                // The ray runs (nearly) along this facet's plane: if it
+                // can reach the facet's box at all, the count is not
+                // trusted.
+                let (lo, hi) = super::bvh::tri_box(tri);
+                if ray_meets(o, d, lo, hi, mesh.pad) {
+                    ambiguous = true;
+                    return true;
+                }
+                return false;
+            }
+            let inv = 1.0 / det;
+            let s = sub(o, a);
+            let u = dot(s, p) * inv;
+            let q = cross(s, e1);
+            let v = dot(d, q) * inv;
+            let tt = dot(e2, q) * inv;
+            let w = 1.0 - u - v;
+            if u < -EDGE_EPS || v < -EDGE_EPS || w < -EDGE_EPS {
+                return false; // misses the facet clear of its edges
+            }
+            if u <= EDGE_EPS || v <= EDGE_EPS || w <= EDGE_EPS {
+                ambiguous = true; // through an edge or a vertex
+                return true;
+            }
+            let reach = mesh.pad / dot(d, d).sqrt().max(f64::MIN_POSITIVE);
+            if tt.abs() <= reach {
+                ambiguous = true; // the origin is on the surface
+                return true;
+            }
+            if tt > 0.0 {
+                count += 1;
+                wind += if dn > 0.0 { 1 } else { -1 };
+            }
+            false
+        },
+    );
+    (!ambiguous).then_some((wind, count))
+}
+
+/// Is `q` inside the closed mesh's solid? Inside on any nonzero winding
+/// or odd crossing count (overlapping shells, an inside-out shell);
+/// inside when no direction gives an unambiguous count.
+pub(super) fn inside(mesh: &FixtureMesh, q: V) -> bool {
+    if !q.iter().all(|c| c.is_finite()) {
+        return true;
+    }
+    for d in DIRS {
+        if let Some((wind, count)) = cast(mesh, q, d) {
+            return wind != 0 || count % 2 == 1;
+        }
+    }
+    true
+}
