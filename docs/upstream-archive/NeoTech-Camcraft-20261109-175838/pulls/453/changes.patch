From 7fe6a65f4d346b117a669a54cd768a4cea373dbc Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 9 Nov 2026 13:55:13 +0100
Subject: [PATCH] chore(license): relicense CamCraft from MIT to Apache-2.0,
 copyright held by its contributors

Maintainer's choice. LICENSE (and aur/LICENSE) now carry the verbatim
Apache-2.0 text. A new NOTICE names "The CamCraft contributors" as
copyright holders. The README explains that contributors hold their own
rights and that pull requests are licensed under Apache-2.0 (license
section 5). The AUR, deb/rpm metadata say Apache-2.0, and every package
ships NOTICE next to LICENSE. The MIT terms the existing code was
contributed under are recorded in docs/decisions/452-license-apache.md;
MIT permits this redistribution.

Fixes #452

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/release.yml        |   2 +-
 LICENSE                              | 223 ++++++++++++++++++++++++---
 NOTICE                               |   9 ++
 README.md                            |  11 +-
 aur/.SRCINFO                         |   2 +-
 aur/LICENSE                          | 223 ++++++++++++++++++++++++---
 aur/PKGBUILD                         |   3 +-
 docs/decisions/452-license-apache.md |  41 +++++
 scripts/package-freebsd.sh           |   2 +-
 scripts/package-linux.sh             |   4 +-
 scripts/package-macos.sh             |   2 +-
 11 files changed, 471 insertions(+), 51 deletions(-)
 create mode 100644 NOTICE
 create mode 100644 docs/decisions/452-license-apache.md

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 66fc87a1..333de102 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -252,7 +252,7 @@ jobs:
           Copy-Item assets/ui/* "$stage/assets/ui"
           Copy-Item assets/scripts/* "$stage/assets/scripts"
           Copy-Item assets/themes/* "$stage/assets/themes"
-          Copy-Item RELEASE_NOTES.md, TESTING.md, LICENSE $stage
+          Copy-Item RELEASE_NOTES.md, TESTING.md, LICENSE, NOTICE $stage
           Compress-Archive -Path $stage -DestinationPath "dist/camcraft-$ver-win-x64.zip" -Force
           Get-ChildItem dist
       - name: Build installer (Inno Setup, same staged tree as the zip)
