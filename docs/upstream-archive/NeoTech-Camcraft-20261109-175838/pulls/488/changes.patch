new file mode 100644
index 00000000..818857c4
--- /dev/null
+++ b/crates/app/tests/fixture_mesh.rs
@@ -0,0 +1,155 @@
+//! #339 slice 1 end to end: a vise modelled as a closed mesh, its jaws
+//! clamping the stock with the face pass running between them. Its one
+//! world box covers the whole pass, so the box laws refused the post;
+//! the mesh law clears it, while the same vise as an open sheet keeps
+//! the box verdict and a jaw moved into the pass still blocks the post.
+//!
+//! Gate map (M4.4): covers app::fixture, app::operation, app::posting, app::verify.
+
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, SetStock, TagFixture};
+use camcraft_app::fixture;
+use camcraft_app::geometry::{Point3, Triangle};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+use camcraft_app::world::new_world;
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// The face world of the fixtures suite: 60 mm box stock, a 4 mm end
+/// mill, a face pass at z 19.5 under a 25 mm clearance.
+fn face_world() -> (flecs_ecs::prelude::World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(
+        &world,
+        SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location::default()).expect("stock"),
+    );
+    let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("catalog");
+    history.execute(&world, AddTool::new(&world, "EM-0400-2FL", tool).expect("tool"));
+    history.execute(
+        &world,
+        CreateOperation::new(
+            &world,
+            "Face1",
+            "EM-0400-2FL",
+            SrcRef::Stock,
+            OpParams::Face {
+                holes: Default::default(),
+                tilt: None,
+                blend_turns: false,
+                stepover: 3.0,
+                clearance_z: Height::fixed(25.0),
+                cut_z: Height::fixed(19.5),
+                top_z: None,
+                stepdown: None,
+                feed: 1200.0,
+                plunge_feed: 300.0,
+                climb: true,
+            },
+        )
+        .expect("face op"),
+    );
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    (world, history)
+}
+
+/// A closed, outward box: 12 facets on 8 exact corners.
+fn cube(lo: Point3, hi: Point3) -> Vec<Triangle> {
+    let c = |i: usize| {
+        p(if i & 1 == 0 { lo.x } else { hi.x }, if i & 2 == 0 { lo.y } else { hi.y }, if i & 4 == 0 { lo.z } else { hi.z })
+    };
+    let quads = [[0, 2, 3, 1], [4, 5, 7, 6], [0, 1, 5, 4], [2, 6, 7, 3], [0, 4, 6, 2], [1, 3, 7, 5]];
+    quads
+        .iter()
+        .flat_map(|q| [Triangle::new(c(q[0]), c(q[1]), c(q[2])), Triangle::new(c(q[0]), c(q[2]), c(q[3]))])
+        .collect()
+}
+
+/// The pass's XY extent (every move's endpoints).
+fn path_xy(world: &flecs_ecs::prelude::World) -> (f64, f64, f64, f64) {
+    let op = model::find_by_name(world, "Face1").expect("Face1");
+    let path = model::toolpath_of(world, &op).expect("generated").path;
+    path.moves.iter().flat_map(|m| [m.from, m.to]).fold(
+        (f64::MAX, f64::MAX, f64::MIN, f64::MIN),
+        |(x0, y0, x1, y1), q| (x0.min(q.x), y0.min(q.y), x1.max(q.x), y1.max(q.y)),
+    )
+}
+
+/// Jaws `gap` mm beyond the tool's edge on either side of the pass in
+/// y, standing to z 21 (1.5 mm over the cut, inside the flute's window)
+/// on a base under the stock: the vise's box covers the whole pass.
+fn vise(world: &flecs_ecs::prelude::World, gap: f64) -> Vec<Triangle> {
+    let (x0, y0, x1, y1) = path_xy(world);
+    let edge = 2.0 + gap; // the 4 mm cutter's radius, plus the gap
+    let (xa, xb) = (x0 - 10.0, x1 + 10.0);
+    let mut t = cube(p(xa, y0 - edge - 20.0, -15.0), p(xb, y1 + edge + 20.0, -5.0));
+    t.extend(cube(p(xa, y0 - edge - 20.0, -5.0), p(xb, y0 - edge, 21.0)));
+    t.extend(cube(p(xa, y1 + edge, -5.0), p(xb, y1 + edge + 20.0, 21.0)));
+    t
+}
+
+fn plant(world: &flecs_ecs::prelude::World, history: &mut History, name: &str, tris: Vec<Triangle>) {
+    let e = model::spawn(world, name);
+    model::set_facets(world, &e, tris.into());
+    model::set_rev(world, &e, 1);
+    history.execute(world, TagFixture::new(world, name, None).expect("tagged"));
+}
+
+fn struck(problems: &[String]) -> bool {
+    problems.iter().any(|pr| pr.starts_with("Face1:") && pr.contains("strikes a fixture"))
+}
+
+#[test]
+fn a_face_pass_between_closed_vise_jaws_posts() {
+    let (world, mut history) = face_world();
+    assert!(posting::verification_gate(&world).is_empty(), "a clean world posts");
+    plant(&world, &mut history, "Vise1", vise(&world, 3.0));
+    let boxes = fixture::boxes_for(&world, None);
+    assert_eq!(boxes.len(), 1, "one vise, one box");
+    let (x0, y0, x1, y1) = path_xy(&world);
+    assert!(
+        boxes[0].min.x < x0 && boxes[0].max.x > x1 && boxes[0].min.y < y0 && boxes[0].max.y > y1,
+        "the vise's box covers the whole pass"
+    );
+    let problems = posting::verification_gate(&world);
+    assert!(problems.is_empty(), "the jaws' real steel stands 3 mm off the cutter: {problems:?}");
+    // Generation speaks the gate's verdict (M13.8 owed): regenerated
+    // with the vise planted, the pass carries no fixture warning.
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("regenerate"));
+    let op = model::find_by_name(&world, "Face1").expect("Face1");
+    let warns = model::toolpath_of(&world, &op).expect("generated").warnings;
+    assert!(
+        !warns.iter().any(|w| matches!(w, Warning::FixtureHit { .. })),
+        "generation must not convict the gap pass either: {warns:?}"
+    );
+}
+
+#[test]
+fn the_same_vise_as_an_open_sheet_keeps_the_box_verdict() {
+    let (world, mut history) = face_world();
+    let mut open = vise(&world, 3.0);
+    open.truncate(open.len() - 2); // a jaw face missing: no inside to speak of
+    plant(&world, &mut history, "Vise1", open);
+    assert!(struck(&posting::verification_gate(&world)), "an open mesh is judged by its box");
+}
+
+#[test]
+fn a_jaw_moved_into_the_pass_still_blocks_the_post() {
+    let (world, mut history) = face_world();
+    // -1 mm: the jaws stand 1 mm INSIDE the cutter's reach at each
+    // side's outermost pass.
+    plant(&world, &mut history, "Vise1", vise(&world, -1.0));
+    let problems = posting::verification_gate(&world);
+    assert!(struck(&problems), "the gate must name op and hit: {problems:?}");
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("regenerate"));
+    let op = model::find_by_name(&world, "Face1").expect("Face1");
+    let warns = model::toolpath_of(&world, &op).expect("generated").warnings;
+    assert!(warns.iter().any(|w| matches!(w, Warning::FixtureHit { .. })), "and generation warns: {warns:?}");
+}
diff --git a/crates/sim/src/fixture_mesh/bvh.rs b/crates/sim/src/fixture_mesh/bvh.rs
new file mode 100644
index 00000000..bf421dd3
--- /dev/null
+++ b/crates/sim/src/fixture_mesh/bvh.rs
@@ -0,0 +1,169 @@
+//! A bounding-volume hierarchy over a fixture's triangles (#339): the
+//! broad phase that keeps the mesh law near O(log n) per tool band on
+//! 100k-triangle vises.
+//!
+//! Provenance: the axis-aligned BVH with object-median splits along the
+//! widest centroid axis is textbook (Ericson, "Real-Time Collision
+//! Detection", 2005, ch. 6; Pharr, Jakob, Humphreys, "Physically Based
+//! Rendering", ch. 4.3); the ray-box slab test is Kay and Kajiya,
+//! SIGGRAPH 1986. Our own code.
+//!
+//! Conservative by construction: a node's box is the exact union of its
+//! triangles' corner boxes, so pruning a node whose box a query provably
+//! misses can never drop a triangle the query meets.
+
+use super::gjk::V;
+
+/// Triangles per leaf.
+const LEAF: usize = 4;
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Node {
+    pub lo: V,
+    pub hi: V,
+    /// Leaf: first index into `order`; inner: the left child (the right
+    /// child is `first + 1`).
+    pub first: u32,
+    /// Leaf: triangle count (> 0); inner: 0.
+    pub count: u32,
+}
+
+/// The hierarchy: nodes (root first) and the triangle order the leaves
+/// index into.
+#[derive(Clone, Debug, Default)]
+pub(super) struct Bvh {
+    pub nodes: Vec<Node>,
+    pub order: Vec<u32>,
+}
+
+pub(super) fn tri_box(t: &[V; 3]) -> (V, V) {
+    let mut lo = t[0];
+    let mut hi = t[0];
+    for p in &t[1..] {
+        for k in 0..3 {
+            lo[k] = lo[k].min(p[k]);
+            hi[k] = hi[k].max(p[k]);
+        }
+    }
+    (lo, hi)
+}
+
+impl Bvh {
+    /// Build over `tris` (finite coordinates - the caller's check). The
+    /// build is iterative: no recursion depth to blow, whatever the
+    /// count.
+    pub(super) fn build(tris: &[[V; 3]]) -> Self {
+        let boxes: Vec<(V, V)> = tris.iter().map(tri_box).collect();
+        let cent: Vec<V> = boxes.iter().map(|(l, h)| [0, 1, 2].map(|k| 0.5 * (l[k] + h[k]))).collect();
+        let mut order: Vec<u32> = (0..tris.len()).filter_map(|i| u32::try_from(i).ok()).collect();
+        let mut nodes: Vec<Node> = Vec::with_capacity(2 * tris.len() / LEAF + 1);
+        if order.is_empty() {
+            return Self { nodes, order };
+        }
+        nodes.push(Node { lo: [0.0; 3], hi: [0.0; 3], first: 0, count: 0 });
+        // (node index, range start, range end) still to split.
+        let mut work: Vec<(usize, usize, usize)> = vec![(0, 0, order.len())];
+        while let Some((ni, s, e)) = work.pop() {
+            let (mut lo, mut hi) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+            let (mut clo, mut chi) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+            for &t in &order[s..e] {
+                let (l, h) = boxes[t as usize];
+                let c = cent[t as usize];
+                for k in 0..3 {
+                    lo[k] = lo[k].min(l[k]);
+                    hi[k] = hi[k].max(h[k]);
+                    clo[k] = clo[k].min(c[k]);
+                    chi[k] = chi[k].max(c[k]);
+                }
+            }
+            let axis = (0..3)
+                .max_by(|&a, &b| (chi[a] - clo[a]).total_cmp(&(chi[b] - clo[b])))
+                .unwrap_or(0);
+            let leaf = e - s <= LEAF || chi[axis] - clo[axis] <= 0.0;
+            let left = nodes.len();
+            let Some(node) = nodes.get_mut(ni) else { continue };
+            node.lo = lo;
+            node.hi = hi;
+            if leaf {
+                node.first = s as u32;
+                node.count = (e - s) as u32;
+                continue;
+            }
+            node.first = left as u32;
+            node.count = 0;
+            let mid = s + (e - s) / 2;
+            order[s..e].select_nth_unstable_by(mid - s, |&a, &b| {
+                cent[a as usize][axis].total_cmp(&cent[b as usize][axis])
+            });
+            let blank = Node { lo: [0.0; 3], hi: [0.0; 3], first: 0, count: 0 };
+            nodes.push(blank);
+            nodes.push(blank);
+            work.push((left, s, mid));
+            work.push((left + 1, mid, e));
+        }
+        Self { nodes, order }
+    }
+
+    /// Visit every triangle in a leaf whose box `keep` admits, depth
+    /// first; `visit` returns true to stop the walk. Returns whether
+    /// the walk was stopped.
+    pub(super) fn walk(&self, keep: impl Fn(&Node) -> bool, mut visit: impl FnMut(usize) -> bool) -> bool {
+        let mut stack: Vec<usize> = Vec::with_capacity(64);
+        if !self.nodes.is_empty() {
+            stack.push(0);
+        }
+        while let Some(ni) = stack.pop() {
+            let Some(n) = self.nodes.get(ni) else { continue };
+            if !keep(n) {
+                continue;
+            }
+            if n.count > 0 {
+                let (s, e) = (n.first as usize, n.first as usize + n.count as usize);
+                for &t in self.order.get(s..e).unwrap_or(&[]) {
+                    if visit(t as usize) {
+                        return true;
+                    }
+                }
+            } else {
+                stack.push(n.first as usize + 1);
+                stack.push(n.first as usize);
+            }
+        }
+        false
+    }
+}
+
+/// Do two closed boxes overlap, each grown by `pad`?
+pub(super) fn boxes_meet(alo: V, ahi: V, blo: V, bhi: V, pad: f64) -> bool {
+    (0..3).all(|k| alo[k] - pad <= bhi[k] && blo[k] - pad <= ahi[k])
+}
+
+/// Does the ray `o + t d` (t >= 0) meet the box grown by `pad`? The
+/// slab test; a zero direction component reads as "inside the slab or
+/// not", and anything non-finite reads as a meet (the caller then
+/// tests the triangles, which decide).
+pub(super) fn ray_meets(o: V, d: V, lo: V, hi: V, pad: f64) -> bool {
+    let (mut t0, mut t1) = (0.0f64, f64::INFINITY);
+    for k in 0..3 {
+        let (l, h) = (lo[k] - pad, hi[k] + pad);
+        if d[k] == 0.0 {
+            if o[k] < l || o[k] > h {
+                return false;
+            }
+            continue;
+        }
+        let (mut a, mut b) = ((l - o[k]) / d[k], (h - o[k]) / d[k]);
+        if a > b {
+            std::mem::swap(&mut a, &mut b);
+        }
+        if a.is_nan() || b.is_nan() {
+            return true;
+        }
+        t0 = t0.max(a);
+        t1 = t1.min(b);
+        if t0 > t1 {
+            return false;
+        }
+    }
+    true
+}
