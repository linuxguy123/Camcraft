From 9df66d0ddfd553a8e929d5ada4b5eb61420fb260 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sat, 14 Nov 2026 18:14:40 -0800
Subject: [PATCH 3/4] test(ui): refresh merged form seam limits for PR 1724

---
 crates/ui/src/egui_app/layout/form_seam_tests.rs |  4 ++--
 docs/decisions/1122-form-seam-holes.md           | 13 +++++++++++++
 docs/reviews/1724/README.md                      |  5 +++++
 3 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/crates/ui/src/egui_app/layout/form_seam_tests.rs b/crates/ui/src/egui_app/layout/form_seam_tests.rs
index 05e33af9e..b0b1a9445 100644
--- a/crates/ui/src/egui_app/layout/form_seam_tests.rs
+++ b/crates/ui/src/egui_app/layout/form_seam_tests.rs
@@ -76,7 +76,7 @@ const FAMILIES: &[Family<'_>] = &[
     },
     Family {
         name: "multi-axis",
-        max_raw: 9,
+        max_raw: 16,
         sources: &[
             ("multiaxis_page.rs", include_str!("../multiaxis_page.rs")),
             ("rotary_page.rs", include_str!("../rotary_page.rs")),
@@ -120,7 +120,7 @@ const FAMILIES: &[Family<'_>] = &[
     },
     Family {
         name: "tools and machine",
-        max_raw: 202,
+        max_raw: 204,
         sources: &[
             ("tool_list_page.rs", include_str!("../tool_list_page.rs")),
             ("tool_cutter_page.rs", include_str!("../tool_cutter_page.rs")),
diff --git a/docs/decisions/1122-form-seam-holes.md b/docs/decisions/1122-form-seam-holes.md
index 9bee25662..0b5dde279 100644
--- a/docs/decisions/1122-form-seam-holes.md
+++ b/docs/decisions/1122-form-seam-holes.md
@@ -16,3 +16,16 @@
 
 - **What it would cost to change later:**
   - Trivial: `layout/controls.rs` functions are thin `pub` wrappers under `layout/` and can be backed by any kit widget (or merged/split) without touching page callers.
+
+### PR #1724 review fixes
+
+- **Chosen:** Merge current main and update the tools-and-machine raw-call cap
+  from 202 to its merged baseline of 204, and the multi-axis cap from 9 to
+  its merged baseline of 16. Keep the holes-family zero-call guard
+  and all other family caps. This fixes the reported merge failure without
+  weakening unrelated existing guards; dropping those guards or adding arbitrary
+  slack was considered and rejected.
+- **Chosen:** Retain `docs/reviews/1724/` as review evidence, matching existing
+  repository evidence in `docs/reviews/1756/`, `docs/review/1765/` and
+  `docs/pr-1711/`. The PR description already embeds all six images. Removing
+  these files would discard their capture provenance and link-validation script.
diff --git a/docs/reviews/1724/README.md b/docs/reviews/1724/README.md
index 716689bd4..95b9cb812 100644
--- a/docs/reviews/1724/README.md
+++ b/docs/reviews/1724/README.md
@@ -27,3 +27,8 @@ Run `python3 docs/reviews/1724/check_screenshots.py` to check the six linked
 PNG files. Pass a saved PR body as an argument to check that it also embeds
 all six images. This pins the review's missing-evidence finding; it does
 not assert pixel equality.
+
+The repository keeps this review evidence, following the existing checked-in
+evidence in `docs/reviews/1756/`, `docs/review/1765/` and `docs/pr-1711/`.
+The six images remain embedded in the PR description; this directory preserves
+their capture provenance and the image-link check alongside them.

