+#[test]
+fn the_alternating_flag_rides_the_stream_and_the_file() {
+    let alt = ThreadInfeed { method: InfeedMethod::Alternating, flank_angle: 30.0, ..ThreadInfeed::default() };
+    let world = g76_world(0.4, alt);
