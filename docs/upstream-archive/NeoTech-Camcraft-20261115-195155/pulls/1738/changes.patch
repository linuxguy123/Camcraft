diff --git a/crates/app/tests/area_support/mod.rs b/crates/app/tests/area_support/mod.rs
index 56cc27e31..c422bde91 100644
--- a/crates/app/tests/area_support/mod.rs
+++ b/crates/app/tests/area_support/mod.rs
@@ -27,6 +27,7 @@ pub const EPS: f64 = 1e-3;
 
 pub fn pocket(top: f64, bottom: f64) -> OpParams {
     OpParams::Pocket {
+        blend_radius: None,
         stepover: 4.0,
