         );
+        // #1682: nor any other motion carrying X or Y - the combined
+        // `G0 X20 Y10 Z2` the refused rapid asked for, or a feed after it.
+        let xy: Vec<&str> = out
+            .program
+            .lines()
+            .filter(|l| is_motion(l) && l.split_whitespace().any(|w| w.starts_with('X') || w.starts_with('Y')))
