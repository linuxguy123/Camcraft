diff --git a/crates/app/tests/setup_align_3d.rs b/crates/app/tests/setup_align_3d.rs
new file mode 100644
index 000000000..2ce89a0f2
--- /dev/null
+++ b/crates/app/tests/setup_align_3d.rs
@@ -0,0 +1,337 @@
+//! Provenance: #1743, an analytic wedge and exact rigid half-turn; no vendor material consulted.
+//! Gate map (#1743): covers app::setup_align, app::operation (job, material, heights), app::posting.
+
+use camcraft_app::cl::Toolpath;
+use camcraft_app::commands::{
+    AddTool, AlignPartToSetup, CreateOperation, CreateSetup, EditOperationParams,
+    GenerateOperation, History, ImportModel, SetStock,
+};
+use camcraft_app::finishing3d::FinishPattern;
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::links::Links;
+use camcraft_app::machining2d::PocketStrategy;
+use camcraft_app::machining3d::Entry3D;
+use camcraft_app::operation::{
+    AreaControls, BoundaryMode, BoundaryShape, ExtraBoundary, FeatureSel, GeoSel, Height,
+    HeightReference, OpParams, SrcRef,
+};
+use camcraft_app::schema::Location;
+use camcraft_app::setup_align::AlignPreset;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::{model, posting, world::new_world};
+use flecs_ecs::prelude::World;
+
+/// A closed wedge: x [-8,8], y [-6,10], floor 0, sloping roof z=6+x/4.
+/// Its back edge tapers from y=6 at the left to y=10 at the right.
+/// Its X half-turn about (0,2,4) is (x,4-y,8-z), all exact arithmetic.
+fn wedge(flipped: bool) -> Mesh {
+    let p = |x: f64, y: f64, z: f64| {
+        if flipped {
+            Point3::new(x, 4.0 - y, 8.0 - z)
+        } else {
+            Point3::new(x, y, z)
+        }
+    };
+    let v = [
+        p(-8.0, -6.0, 0.0),
+        p(8.0, -6.0, 0.0),
+        p(8.0, 10.0, 0.0),
+        p(-8.0, 6.0, 0.0),
+        p(-8.0, -6.0, 4.0),
+        p(8.0, -6.0, 8.0),
+        p(8.0, 10.0, 8.0),
+        p(-8.0, 6.0, 4.0),
+    ];
+    let quads = [
+        [0, 3, 2, 1],
+        [4, 5, 6, 7],
+        [0, 1, 5, 4],
+        [1, 2, 6, 5],
+        [2, 3, 7, 6],
+        [3, 0, 4, 7],
+    ];
+    Mesh::from_facets(
+        quads
+            .into_iter()
+            .flat_map(|[a, b, c, d]| {
+                [
+                    Triangle::new(v[a], v[b], v[c]),
+                    Triangle::new(v[a], v[c], v[d]),
+                ]
+            })
+            .collect(),
+    )
+}
+
+fn document(aligned: bool, tool_name: &str) -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", wedge(aligned)));
+    let stock = StockShape::Box {
+        dx: 24.0,
+        dy: 24.0,
+        dz: 12.0,
+    };
+    let at = Location {
+        pos: Point3::new(0.0, 2.0, -2.0),
+        ..Default::default()
+    };
+    h.execute(&world, SetStock::new(&world, stock, at).expect("stock"));
+    let tool = catalog()
+        .into_iter()
+        .find(|(n, _)| *n == tool_name)
+        .expect("catalog tool")
+        .1;
+    h.execute(&world, AddTool::new(&world, tool_name, tool).expect("tool"));
+    h.execute(
+        &world,
+        CreateSetup::new(&world, None, None).expect("Setup1"),
+    );
+    h.execute(
+        &world,
+        CreateSetup::new(&world, None, Some("Setup1")).expect("Setup2"),
+    );
+    if aligned {
+        h.execute(
+            &world,
+            AlignPartToSetup::preset(&world, "Setup2", AlignPreset::FlipX).expect("flip"),
+        );
+    }
+    (world, h)
+}
+
+fn rough(strategy: PocketStrategy) -> OpParams {
+    OpParams::Pocket3D {
+        links: Links::ROUGH3D,
+        stepover: 1.5,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(16.0),
+        retract_z: None,
+        top_z: Height::fixed(10.0),
+        bottom_z: Height::fixed(4.0),
+        stepdown: 2.0,
+        feed: 800.0,
+        plunge_feed: 200.0,
+        climb: true,
+        strategy,
+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+        rest_rough: false,
+        optimal_load: camcraft_app::load::DEFAULT_OPTIMAL_LOAD,
+        feed_opt: false,
+        shell: true,
+    }
+}
+
+fn finish() -> OpParams {
+    OpParams::Finish3D {
+        pattern: FinishPattern::Waterline,
+        stepover: None,
+        tolerance: 0.1,
+        clearance_z: Height::fixed(16.0),
+        retract_z: None,
+        top_z: Height::of(HeightReference::TopOfModel, -0.5),
+        bottom_z: Height::of(HeightReference::BottomOfModel, 4.5),
+        feed: 500.0,
+        plunge_feed: 100.0,
+        climb: true,
+        ramp: false,
+        min_step: None,
+        ramp_angle: 45.0,
+        entry_ramp: false,
+        steep_stepover: None,
+        pencil_reference: None,
+        fill_openings: None,
+    }
+}
+
+fn generate(aligned: bool, tool: &str, params: OpParams) -> (Toolpath, String) {
+    generate_area(aligned, tool, params, AreaControls::default())
+}
+
+fn generate_area(
+    aligned: bool,
+    tool: &str,
+    params: OpParams,
+    area: AreaControls,
+) -> (Toolpath, String) {
+    generate_case(aligned, tool, params, area, false)
+}
+
+fn generate_case(
+    aligned: bool,
+    tool: &str,
+    params: OpParams,
+    mut area: AreaControls,
+    picked: bool,
+) -> (Toolpath, String) {
+    let (world, mut h) = document(aligned, tool);
+    let src = if picked {
+        let part = model::find_by_name(&world, "part").expect("part");
+        let features = model::features_of(&world, &part).expect("features");
+        let roof = features
+            .faces
+            .iter()
+            .find(|f| f.normal[0].abs() > 0.1 && f.normal[2].abs() > 0.8)
+            .expect("sloped roof");
+        let picks = vec![GeoSel {
+            entity: "part".into(),
+            feature: FeatureSel::Face(roof.id),
+        }];
+        area.extra.push(ExtraBoundary {
+            mode: BoundaryMode::Include,
+            shape: BoundaryShape::Picks(picks.clone()),
+        });
+        SrcRef::Selection(picks)
+    } else {
+        SrcRef::Entity("part".into())
+    };
+    h.execute(
+        &world,
+        CreateOperation::new(&world, "Cut", tool, src, params.clone()).expect("create"),
+    );
+    if !area.is_default() {
+        h.execute(
+            &world,
+            EditOperationParams::with_area(&world, "Cut", params, area).expect("area controls"),
+        );
+    }
+    h.execute(
+        &world,
+        GenerateOperation::new(&world, "Cut").expect("3D operation generates in Setup2"),
+    );
+    let entity = model::find_by_name(&world, "Cut").expect("op");
+    let cached = model::toolpath_of(&world, &entity).expect("path");
+    assert!(!cached.path.moves.is_empty(), "the cut contains moves");
+    assert!(
+        !cached.warnings.iter().any(|w| w.blocks_post()),
+        "unsafe path: {:?}",
+        cached.warnings
+    );
+    let sim =
+        camcraft_app::stock_sim::simulate_document(&world).expect("the flipped part is judged");
+    assert_eq!(
+        sim.dev.gouge_cells, 0,
+        "gouge {} at {:?}",
+        sim.dev.max_gouge, sim.dev.max_gouge_at
+    );
+    let nc = posting::post_setup_unwritten(&world)
+        .expect("clean flipped 3D path posts")
+        .program;
+    assert!(nc.contains("G54"), "setup offset posts");
+    (cached.path, nc)
+}
+
+fn equivalent(tool: &str, params: OpParams) {
+    let (aligned, nc) = generate(true, tool, params.clone());
+    let (baked, reference_nc) = generate(false, tool, params);
+    assert_eq!(
+        aligned, baked,
+        "the flip is baked into the part, never into the tool axis"
+    );
+    assert_eq!(
+        nc, reference_nc,
+        "identical setup geometry posts identical NC"
+    );
+}
+
+#[test]
+fn flipped_pocket3d_generates_verifies_and_posts_like_baked_geometry() {
+    equivalent("EM-0400-2FL", rough(PocketStrategy::OffsetRings));
+}
+
+#[test]
+fn flipped_adaptive3d_generates_verifies_and_posts_like_baked_geometry() {
+    equivalent("EM-0400-2FL", rough(PocketStrategy::Adaptive));
+}
+
+#[test]
+fn flipped_finish3d_generates_verifies_and_posts_like_baked_geometry() {
+    equivalent("BN-0600", finish());
+}
+
+#[test]
+fn flipped_pocket3d_area_controls_match_baked_geometry() {
+    let area = AreaControls {
+        offset: -0.25,
+        extra: vec![ExtraBoundary {
+            mode: BoundaryMode::Include,
+            shape: BoundaryShape::Silhouette,
+        }],
+        ..Default::default()
+    };
+    let (aligned, nc) = generate_area(
+        true,
+        "EM-0400-2FL",
+        rough(PocketStrategy::OffsetRings),
+        area.clone(),
+    );
+    let (baked, reference_nc) = generate_area(
+        false,
+        "EM-0400-2FL",
+        rough(PocketStrategy::OffsetRings),
+        area,
+    );
+    assert_eq!(
+        aligned, baked,
+        "the controlled region reads the aligned part"
+    );
+    assert_eq!(nc, reference_nc);
+    let (plain, _) = generate(false, "EM-0400-2FL", rough(PocketStrategy::OffsetRings));
+    assert_ne!(
+        baked.moves, plain.moves,
+        "the area restriction changes the path"
+    );
+}
+
+#[test]
+fn flipped_finish3d_picked_source_and_boundary_match_baked_geometry() {
+    let (aligned, nc) = generate_case(true, "BN-0600", finish(), AreaControls::default(), true);
+    let (baked, reference_nc) =
+        generate_case(false, "BN-0600", finish(), AreaControls::default(), true);
+    assert_eq!(
+        aligned, baked,
+        "picked geometry is read through the setup frame"
+    );
+    assert_eq!(nc, reference_nc);
+}
+
+#[test]
+fn enabling_aligned_3d_keeps_tilt_and_2d_area_refusals() {
+    let (world, _) = document(true, "EM-0400-2FL");
+    let mut params = camcraft_app::operation::retype_params(
+        &rough(PocketStrategy::OffsetRings),
+        camcraft_app::operation::OpType::Face as usize,
+    );
+    let OpParams::Face { tilt, .. } = &mut params else {
+        panic!("face params")
+    };
+    *tilt = Some(camcraft_app::operation::Tilt {
+        a_deg: 45.0,
+        b_deg: 0.0,
+        origin: [0.0; 3],
+    });
+    let mut op = camcraft_app::schema::Operation {
+        tool: "EM-0400-2FL".into(),
+        src: SrcRef::Entity("part".into()),
+        params,
+        stamp: None,
+        setup: Some("Setup2".into()),
+        area: AreaControls::default(),
+        coolant: Default::default(),
+        after: Default::default(),
+        suppressed: false,
+    };
+    let why =
+        camcraft_app::setup_align::generation_problem(&world, &op).expect("tilt is still refused");
+    assert!(why.contains("tilted plane is not supported yet"), "{why}");
+    let OpParams::Face { tilt, .. } = &mut op.params else {
+        panic!("face params")
+    };
+    *tilt = None;
+    op.area.offset = 0.25;
+    let why = camcraft_app::setup_align::generation_problem(&world, &op)
+        .expect("2D area is still refused");
+    assert!(why.contains("area controls are not supported yet"), "{why}");
+}
diff --git a/crates/app/tests/setup_carry_credits.rs b/crates/app/tests/setup_carry_credits.rs
new file mode 100644
index 000000000..15cdc61a8
--- /dev/null
+++ b/crates/app/tests/setup_carry_credits.rs
@@ -0,0 +1,214 @@
+//! #1806: retained verdicts credit only the earlier setup's declared cuts.
+//! Provenance: our own finished-block fixtures and cached-path fault injection.
+//! Gate map: covers app::stock_sim (carry::walk, simulate_document, marks).
+
+use camcraft_app::commands::{
+    AddTool, AlignPartToSetup, CreateOperation, CreateSetup, GenerateOperation, History,
+    ImportModel, SetSetupStockSource, SetStock,
+};
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::operation::{self, Height, OpParams, OpType, SrcRef};
+use camcraft_app::setup_align::{AlignPreset, parts_facets_in};
+use camcraft_app::setup_stock::StockSource;
+use camcraft_app::stock::StockShape;
+use camcraft_app::stock_sim::simulate_document;
+use camcraft_app::tools::catalog;
+use camcraft_app::{model, schema, world::new_world};
+use flecs_ecs::prelude::World;
+
+const CONE: &str = "CM-0600-90";
+const MILL: &str = "EM-0600-4FL";
+
+fn face(z: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(), tilt: None, blend_turns: false, stepover: 3.0,
+        clearance_z: Height::fixed(50.0), cut_z: Height::fixed(z), top_z: None,
+        stepdown: None, feed: 1200.0, plunge_feed: 300.0, climb: true,
+    }
+}
+
+fn params(kind: OpType) -> OpParams {
+    match kind {
+        OpType::Engrave => OpParams::Engrave {
+            clearance_z: Height::fixed(50.0), retract_z: None,
+            top_z: Height::fixed(16.0), bottom_z: Height::fixed(15.7),
+            stepdown: 1.0, feed: 800.0, plunge_feed: 200.0, climb: true, tilt: None,
+        },
+        OpType::Trace => OpParams::Trace {
+            clearance_z: Height::fixed(50.0), retract_z: None,
+            top_z: Height::fixed(16.0), bottom_z: Height::fixed(15.7),
+            stepdown: 1.0, feed: 800.0, plunge_feed: 200.0, climb: true, tilt: None,
+        },
+        _ => operation::retype_params(&face(16.0), kind.ordinal()),
+    }
+}
+
+fn add_op(world: &World, h: &mut History, name: &str, tool: &str, params: OpParams) {
+    h.execute(world, CreateOperation::new(world, name, tool, SrcRef::Entity("part".into()), params).expect("create"));
+    h.execute(world, GenerateOperation::new(world, name).expect("generate"));
+}
+
+fn job(kind: OpType, excess: f64, side_on: bool) -> World {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::new(-30.0, -30.0, 0.0), Point3::new(30.0, 30.0, 16.0))));
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 16.0 }, Default::default()).expect("stock"));
+    for name in [CONE, MILL] {
+        let tool = catalog().into_iter().find(|(n, _)| *n == name).expect("catalog tool").1;
+        h.execute(&world, AddTool::new(&world, name, tool).expect("tool"));
+    }
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("Setup1"));
+    let tool = if matches!(kind, OpType::Chamfer2D | OpType::Deburr) { CONE } else { MILL };
+    add_op(&world, &mut h, "Cut1", tool, params(kind));
+    if side_on {
+        // Keep a generated straight pass away from the ends of
+        // the new height axis. The final silhouette cannot see this cut;
+        // only the verdict taken before the turn can judge it.
+        let e = model::find_by_name(&world, "Cut1").expect("op");
+        let mut cached = model::toolpath_of(&world, &e).expect("cached path");
+        let mut pass = *cached.path.moves.iter().find(|m| {
+            m.kind != camcraft_app::cl::MoveKind::Rapid
+                && m.from.x.abs() > 29.0 && (m.from.x - m.to.x).abs() < 1e-9
+                && (m.from.y - m.to.y).abs() > 10.0 && m.to.z < 16.0
+        }).expect("straight edge pass");
+        pass.from.y = pass.from.y.clamp(-20.0, 20.0);
+        pass.to.y = pass.to.y.clamp(-20.0, 20.0);
+        cached.path.moves = vec![pass];
+        e.entity_view(&world).set(schema::Toolpath::new(cached.path, cached.warnings));
+    }
+    let single = simulate_document(&world).expect("single setup verdict").dev;
+    assert_eq!(single.gouge_cells, 0, "the declared cut is clean alone: worst {}", single.max_gouge);
+    if excess > 0.0 {
+        let e = model::find_by_name(&world, "Cut1").expect("op");
+        let mut cached = model::toolpath_of(&world, &e).expect("cached path");
+        for m in &mut cached.path.moves {
+            m.from.z -= excess;
+            m.to.z -= excess;
+        }
+        e.entity_view(&world).set(schema::Toolpath::new(cached.path, cached.warnings));
+    }
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup1")).expect("Setup2"));
+    let turn = if side_on {
+        AlignPartToSetup::angles(&world, "Setup2", [-90.0, 0.0, 0.0]).expect("side-on")
+    } else {
+        AlignPartToSetup::preset(&world, "Setup2", AlignPreset::FlipX).expect("flip")
+    };
+    h.execute(&world, turn);
+    if !side_on {
+        h.execute(&world, SetSetupStockSource::new(&world, "Setup2", StockSource::Own).expect("new block"));
+    }
+    let top = parts_facets_in(&world, Some("Setup2")).iter().flat_map(|t| [t.a.z, t.b.z, t.c.z]).fold(f64::NEG_INFINITY, f64::max);
+    add_op(&world, &mut h, "Face2", MILL, face(top));
+    world
+}
+
+fn clean(kind: OpType, side_on: bool) {
+    let world = job(kind, 0.0, side_on);
+    let dev = simulate_document(&world).expect("two setup verdict").dev;
+    assert_eq!(dev.gouge_cells, 0, "{kind:?}, side-on {side_on}: worst {} at {:?}", dev.max_gouge, dev.max_gouge_at);
+}
+
+#[test]
+fn earlier_breaks_are_credited_before_a_new_block() {
+    for kind in [OpType::Chamfer2D, OpType::Deburr] {
+        clean(kind, false);
+    }
+}
+
+#[test]
+fn earlier_marks_are_credited_before_a_new_block() {
+    for kind in [OpType::Engrave, OpType::Trace] {
+        clean(kind, false);
+    }
+}
+
+#[test]
+fn earlier_breaks_are_credited_before_a_side_on_turn() {
+    clean(OpType::Chamfer2D, true);
+}
+
+#[test]
+fn earlier_marks_are_credited_before_a_side_on_turn() {
+    clean(OpType::Trace, true);
+}
+
+#[test]
+fn real_gouges_under_earlier_breaks_and_marks_survive_both_transitions() {
+    for side_on in [false, true] {
+        for kind in [OpType::Chamfer2D, OpType::Trace] {
+            let world = job(kind, 0.3, side_on);
+            let dev = simulate_document(&world).expect("two setup verdict").dev;
+            assert!(dev.gouge_cells > 0, "{kind:?}, side-on {side_on}: a real gouge disappeared");
+            assert!((dev.max_gouge - 0.3).abs() < 1e-6, "{kind:?}, side-on {side_on}: charge only the excess: {}", dev.max_gouge);
+        }
+    }
+}
+
+#[test]
+fn a_mark_from_another_setup_cannot_credit_a_real_gouge() {
+    // Setup1 marks its block. Setup2 cuts the same numerical path with
+    // a Face operation, which declares no mark, into a different block.
+    // Setup3 leaves that block behind too, forcing its verdict to be kept.
+    let world = job(OpType::Trace, 0.0, false);
+    let cut = model::find_by_name(&world, "Cut1").expect("first op");
+    let second = model::find_by_name(&world, "Face2").expect("second op");
+    let path = model::toolpath_of(&world, &cut).expect("mark path");
+    second.entity_view(&world).set(path);
+    let mut h = History::default();
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup2")).expect("Setup3"));
+    h.execute(&world, AlignPartToSetup::preset(&world, "Setup3", AlignPreset::AsModelled).expect("turn back"));
+    h.execute(&world, SetSetupStockSource::new(&world, "Setup3", StockSource::Own).expect("new block"));
+    add_op(&world, &mut h, "Face3", MILL, face(16.0));
+    let dev = simulate_document(&world).expect("three setup verdict").dev;
+    assert!(dev.gouge_cells > 0, "Setup1's mark forgave a gouge in Setup2");
+    assert!((dev.max_gouge - 0.3).abs() < 1e-6, "the uncredited cut: {}", dev.max_gouge);
+}
+
+#[test]
+fn retained_top_credit_preserves_the_underside_gouge() {
+    // The two cuts share columns: a real 0.2 mm underside gouge and a
+    // deeper, declared 0.3 mm top mark. Crediting the top must leave the
+    // underside's own depth and location, not erase the combined cell.
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::new(-30.0, -30.0, 0.0), Point3::new(30.0, 30.0, 16.0))));
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 16.0 }, Default::default()).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == MILL).expect("catalog tool").1;
+    h.execute(&world, AddTool::new(&world, MILL, tool).expect("tool"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("Setup1"));
+    h.execute(&world, AlignPartToSetup::preset(&world, "Setup1", AlignPreset::FlipX).expect("underside"));
+    add_op(&world, &mut h, "Face1", MILL, face(16.0));
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup1")).expect("Setup2"));
+    h.execute(&world, AlignPartToSetup::preset(&world, "Setup2", AlignPreset::AsModelled).expect("top side"));
+    add_op(&world, &mut h, "Trace2", MILL, params(OpType::Trace));
+
+    let trace = model::find_by_name(&world, "Trace2").expect("trace");
+    let mut cached = model::toolpath_of(&world, &trace).expect("trace path");
+    for m in &mut cached.path.moves {
+        m.from.z += 0.1;
+        m.to.z += 0.1;
+    }
+    let first = model::find_by_name(&world, "Face1").expect("first face");
+    first.entity_view(&world).set(schema::Toolpath::new(cached.path, cached.warnings));
+    h.execute(&world, GenerateOperation::new(&world, "Trace2").expect("regenerate after changed incoming stock"));
+
+    // Read only the incoming body, before the top cut: this supplies the
+    // underside count and location independently of retained credits.
+    let incoming = camcraft_app::stock_sim::incoming_body(&world, "Setup2").expect("incoming damaged body");
+    let underside = incoming.deviate(&parts_facets_in(&world, Some("Setup2")), camcraft_app::stock_sim::DEV_TOL).expect("underside verdict");
+    assert!(underside.gouge_cells > 0);
+    assert!((underside.max_gouge - 0.2).abs() < 1e-6);
+    let at = underside.max_gouge_at.expect("underside location");
+    assert!((at.z - 0.2).abs() < 1e-6, "underside in Setup2's frame: {at:?}");
+
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup2")).expect("Setup3"));
+    h.execute(&world, AlignPartToSetup::preset(&world, "Setup3", AlignPreset::FlipX).expect("turn"));
+    h.execute(&world, SetSetupStockSource::new(&world, "Setup3", StockSource::Own).expect("new block"));
+    add_op(&world, &mut h, "Face3", MILL, face(16.0));
+    let dev = simulate_document(&world).expect("retained two-face verdict").dev;
+    assert!((dev.max_gouge - 0.2).abs() < 1e-6, "lost the underside depth: {}", dev.max_gouge);
+    assert_eq!(dev.max_gouge_at, underside.max_gouge_at, "keep the underside location in Setup2's frame");
+    assert_eq!(dev.gouge_cells, underside.gouge_cells, "count only the real underside damage");
+    assert!((dev.gouge_volume - underside.gouge_volume).abs() < 1e-6);
+    assert!(!dev.is_clean(), "retained underside damage cannot be clean");
+}
diff --git a/crates/app/tests/setup_carry_side.rs b/crates/app/tests/setup_carry_side.rs
new file mode 100644
index 000000000..0045623ba
--- /dev/null
+++ b/crates/app/tests/setup_carry_side.rs
@@ -0,0 +1,141 @@
+//! #874: the machined stock carried into a setup turned side-on - a plate
+//! faced flat in Setup1, stood on its edge in Setup2 with "what Setup1
+//! leaves behind" as its stock. The carried body is never smaller than
+//! the faced plate; Setup2's rest reading and the program verdict read
+//! it; a gouge Setup1 cut still reads after the turn; the verdict says
+//! the stock was turned; the field engine refuses by name.
+//! Provenance: our own fixtures (a faced block) over plain re-clamp
+//! practice; no vendor material consulted.
+//!
+//! Gate map (#874): covers app::stock_sim (carry: walk, entry,
+//! side_on_note; simulate_document, incoming_body), app::rest (across),
+//! app::setup_stock, app::posting (sim_clause), sim::stock_sim
+//! (carry_side).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    AddTool, AlignPartToSetup, CreateOperation, CreateSetup, GenerateOperation, History, ImportModel, SetStock,
+};
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::setup_align::{AlignPreset, parts_facets_in};
+use camcraft_app::setup_stock::{self, StockSource};
+use camcraft_app::stock::StockShape;
+use camcraft_app::stock_sim::{Backend, DEV_TOL, FIELD_BAND, FIELD_SIDE_CARRY_REFUSAL, simulate_document, with_carry_engine};
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+
+const TOOL: &str = "EM-0400-2FL";
+
+fn face(cut_z: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(cut_z + 30.0),
+        cut_z: Height::fixed(cut_z),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+/// A 60 x 60 x 16 part in a stock Z -2..18, Setup1 faced to `cut1`, and
+/// Setup2 holding the part as `turn` says.
+fn document(cut1: f64, turn: impl FnOnce(&World) -> AlignPartToSetup) -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::new(-30.0, -30.0, 0.0), Point3::new(30.0, 30.0, 16.0))));
+    let at = Location { pos: Point3::new(0.0, 0.0, -2.0), ..Default::default() };
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, at).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("tool");
+    h.execute(&world, AddTool::new(&world, TOOL, tool).expect("add tool"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("materialize Setup1"));
+    add_face(&world, &mut h, "Face1", SrcRef::Stock, cut1);
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup1")).expect("Setup2"));
+    h.execute(&world, turn(&world));
+    (world, h)
+}
+
+fn side_on(world: &World) -> AlignPartToSetup {
+    AlignPartToSetup::angles(world, "Setup2", [-90.0, 0.0, 0.0]).expect("stand it on its edge")
+}
+
+fn add_face(world: &World, h: &mut History, name: &str, src: SrcRef, cut: f64) {
+    let op = CreateOperation::new(world, name, TOOL, src, face(cut)).expect("create");
+    h.execute(world, op);
+    h.execute(world, GenerateOperation::new(world, name).expect("generate"));
+}
+
+/// The top of the part as Setup2 holds it.
+fn part_top(world: &World) -> f64 {
+    let tris = parts_facets_in(world, Some("Setup2"));
+    tris.iter().flat_map(|t| [t.a.z, t.b.z, t.c.z]).fold(f64::NEG_INFINITY, f64::max)
+}
+
+#[test]
+fn a_faced_plate_carries_side_on_with_its_volume_and_verdict() {
+    let (world, mut h) = document(16.0, side_on);
+    assert_eq!(setup_stock::carry_refusal(&world, "Setup2"), None);
+    assert_eq!(setup_stock::effective(&world, "Setup2"), Some(StockSource::FromPrevious));
+    // Setup2 faces the edge down to the part: its rest reading and the
+    // program verdict both read the carried body.
+    let top = part_top(&world);
+    add_face(&world, &mut h, "Face2", SrcRef::Entity("part".into()), top);
+    // Setup1 faced the block (Z -2..18) to 16: 60 x 60 x 18 reaches Setup2,
+    // 60 tall on its edge, as Face2 enters it. Never smaller; under one grid cell over a face.
+    let inc = setup_stock::incoming(&world, "Setup2").expect("the carried body");
+    let mut size = [inc.max[0] - inc.min[0], inc.max[1] - inc.min[1], inc.max[2] - inc.min[2]];
+    assert!((size[2] - 60.0).abs() < 1e-9, "the old Y is the height: {size:?}");
+    size.sort_by(f64::total_cmp);
+    assert!(size[0] >= 18.0 - 1e-9 && size[0] < 18.5 && (size[1] - 60.0).abs() < 1e-9, "{size:?}");
+    let real = 60.0 * 60.0 * 18.0;
+    assert!(inc.volume >= real - 1e-6 && inc.volume < real * 1.03, "volume {} vs {real}", inc.volume);
+    let sim = simulate_document(&world).expect("judged");
+    assert_eq!(sim.dev.gouge_cells, 0, "worst {}", sim.dev.max_gouge);
+    // One millimetre into the part from the new top is a gouge.
+    add_face(&world, &mut h, "Face3", SrcRef::Entity("part".into()), top - 1.0);
+    let sim = simulate_document(&world).expect("judged");
+    assert!(sim.dev.gouge_cells > 0 && (sim.dev.max_gouge - 1.0).abs() < 1e-6, "worst {}", sim.dev.max_gouge);
+}
+
+#[test]
+fn a_gouge_cut_before_a_side_on_turn_still_reads_in_the_verdict() {
+    // Setup1 faces 1 mm into the part. Side-on that face is a wall the
+    // new tool axis cannot see: the verdict taken before the turn keeps it.
+    let (world, mut h) = document(15.0, side_on);
+    add_face(&world, &mut h, "Face2", SrcRef::Entity("part".into()), part_top(&world));
+    let sim = simulate_document(&world).expect("judged");
+    assert!(sim.dev.gouge_cells > 0 && sim.dev.max_gouge > DEV_TOL, "the gouge is kept");
+    assert!((sim.dev.max_gouge - 1.0).abs() < 1e-6, "worst {}", sim.dev.max_gouge);
+}
+
+#[test]
+fn the_verdict_says_the_stock_was_turned_side_on() {
+    let (world, mut h) = document(16.0, side_on);
+    add_face(&world, &mut h, "Face2", SrcRef::Entity("part".into()), part_top(&world));
+    let clause = camcraft_app::posting::sim_clause(&world);
+    assert_eq!(clause.problem, None);
+    let line = clause.not_judged.expect("the note");
+    assert!(line.starts_with("note: the stock carried from setup 'Setup1' into setup 'Setup2' is turned side-on"), "{line}");
+    assert!(line.contains("never inside it"), "{line}");
+    // A flip keeps the tool axis: no note.
+    let flip = |w: &World| AlignPartToSetup::preset(w, "Setup2", AlignPreset::FlipX).expect("flip");
+    let (world, mut h) = document(16.0, flip);
+    add_face(&world, &mut h, "Face2", SrcRef::Entity("part".into()), part_top(&world));
+    assert_eq!(camcraft_app::posting::sim_clause(&world).not_judged, None);
+}
+
+#[test]
+fn the_field_engine_refuses_the_side_on_carry_by_name() {
+    let (world, mut h) = document(16.0, side_on);
+    add_face(&world, &mut h, "Face2", SrcRef::Entity("part".into()), part_top(&world));
+    let err = with_carry_engine(Backend::Field { band: FIELD_BAND }, || simulate_document(&world)).expect_err("refused");
+    assert!(err.contains(FIELD_SIDE_CARRY_REFUSAL), "{err}");
+}
