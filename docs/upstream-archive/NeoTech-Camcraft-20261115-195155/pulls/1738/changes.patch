diff --git a/site/static/style.css b/site/static/style.css
index ac62178ba..65b7c71c7 100644
--- a/site/static/style.css
+++ b/site/static/style.css
@@ -42,6 +42,19 @@ blockquote { margin: 1em 0; padding: 8px 16px; border-left: 4px solid var(--acce
 .pagetoc { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 8px 16px; margin-bottom: 1.5em; }
 .pagetoc ul { margin: 4px 0; }
 .toc li { margin: 4px 0; }
+.guide-layout { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 24px; }
+.guide-content { min-width: 0; }
+.guide-nav { align-self: start; position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow-y: auto; border-right: 1px solid var(--line); padding-right: 16px; font-size: 0.9rem; }
+.guide-groups { list-style: none; margin: 12px 0; padding: 0; }
+.guide-groups > li { margin: 8px 0; }
+.guide-groups summary { cursor: pointer; }
+.guide-groups ul { padding-left: 20px; }
+.guide-groups li li { margin: 6px 0; }
+.guide-nav [aria-current="page"] { color: var(--fg); font-weight: 700; }
+@media (max-width: 720px) {
+  .guide-layout { grid-template-columns: minmax(0, 1fr); }
+  .guide-nav { position: static; max-height: none; border-right: 0; border-bottom: 1px solid var(--line); padding-right: 0; }
+}
 .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 32px; padding-top: 12px; border-top: 1px solid var(--line); }
 .foot { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; padding-top: 12px; padding-bottom: 24px; }
 .small { font-size: 0.82rem; }
