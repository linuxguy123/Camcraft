+#[test]
+fn cross_part_gouge_between_the_tolerances_is_refused_only_on_a_coarse_model() {
+    let (stock, loc) = bar_stock();
+    let try_depth = |coarse: Option<f64>, depth: f64| {
+        let mut t = dr0400();
