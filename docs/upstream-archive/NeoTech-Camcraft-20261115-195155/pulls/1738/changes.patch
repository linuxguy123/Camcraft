+        pieces_len(&harness.state().state, MILL),
+        3,
+        "{}",
+        harness.state().state.status
+    );
+    assert!(harness.query_by_label("Assembly (3 piece(s))").is_some());
+}
+
+fn body(state: &State, tool: &str) -> camcraft_app::schema::ToolBody {
+    let entity = model::find_by_name(&state.world, tool).expect("tool");
+    tool_body::body_of(&state.world, &entity).expect("body")
+}
+
+fn assembly_editor(tool: &str) -> Harness<'static, ShellUi> {
+    let mut harness = editor_on(tool);
+    let head = if tool == MILL {
+        "tool_csys_box_iso13399.step"
+    } else {
+        "modular_lathe_head.step"
+    };
+    harness
+        .state_mut()
+        .state
+        .import_tool_body_from(&fixture(head));
+    if tool == INSERT {
+        harness
+            .state_mut()
+            .state
+            .tool_body_ui
+            .lathe
+            .as_mut()
+            .expect("lathe")
+            .place = LathePlacement {
+            radial: [1.0, 0.0, 0.0],
+            along: [0.0, 0.0, 1.0],
+            tip: [0.0; 3],
+        };
+    }
+    harness.run();
+    apply_body(&mut harness);
+    {
+        let st = &mut harness.state_mut().state;
+        st.tool_body_ui.assembly.target_csys = "MCS".into();
+        st.tool_body_ui.assembly.piece_csys = "CSW".into();
+        st.attach_tool_body_piece_from(&fixture("modular_clamp_unit.step"));
+    }
+    harness.run();
+    harness.run();
+    assert_eq!(pieces_len(&harness.state().state, tool), 2);
+    harness
+}
+
+fn apply_body(harness: &mut Harness<'static, ShellUi>) {
+    harness.get_by_label("Apply body").click();
+    harness.run();
+    harness.run();
+}
+
+#[test]
+fn editor_unchanged_apply_retains_modular_pieces_and_csys() {
+    for tool in [MILL, INSERT] {
+        let mut harness = assembly_editor(tool);
+        let original = body(&harness.state().state, tool);
+        assert!(original.pieces.iter().all(|p| !p.csys.is_empty()));
+        apply_body(&mut harness);
+        let applied = body(&harness.state().state, tool);
+        assert_eq!(
+            applied.pieces, original.pieces,
+            "Apply body must retain modular pieces: {tool}"
+        );
+        assert_eq!(applied.facets, original.facets);
+        // Separate pieces still support removal, and undo restores their records.
+        let mut buttons: Vec<_> = harness.get_all_by_label("Remove").collect();
+        buttons.swap_remove(1).click();
+        harness.run();
+        harness.run();
+        assert_eq!(pieces_len(&harness.state().state, tool), 1);
+        harness
+            .state_mut()
+            .state
+            .pending
+            .push_back(CommandKind::Undo);
+        harness.run();
+        harness.run();
+        assert_eq!(body(&harness.state().state, tool).pieces, original.pieces);
+        // A new import deliberately replaces, rather than reusing, the assembly.
+        let replacement = if tool == MILL { "tool_csys_box_iso13399.step" } else { "modular_lathe_head.step" };
+        harness.state_mut().state.import_tool_body_from(&fixture(replacement));
+        harness.run();
+        apply_body(&mut harness);
+        assert_eq!(pieces_len(&harness.state().state, tool), 1);
+    }
+}
+
+#[test]
+fn editor_placement_apply_transforms_all_modular_pieces_and_csys() {
+    use camcraft_app::tool_body_assembly::{transform_csys_lathe, transform_csys_spindle};
+    for tool in [MILL, INSERT] {
+        let mut harness = assembly_editor(tool);
+        let original = body(&harness.state().state, tool);
+        let mut expected = original.pieces.clone();
+        if tool == MILL {
+            let axis = [0.01, 0.0, 1.0];
+            let offset = 5.0;
+            harness.state_mut().state.tool_body_ui.axis = axis;
+            harness.state_mut().state.tool_body_ui.offset = offset;
+            for p in &mut expected {
+                p.facets = tool_body::place(&p.facets, axis, offset)
+                    .expect("placed piece")
+                    .into();
+                p.csys = transform_csys_spindle(&p.csys, axis, offset).expect("placed CSYS");
+            }
+        } else {
+            let place = LathePlacement {
+                radial: [0.0, 1.0, 0.0],
+                along: [0.0, 0.0, 1.0],
+                tip: [-3.0, 2.0, -5.0],
+            };
+            harness
+                .state_mut()
+                .state
+                .tool_body_ui
+                .lathe
+                .as_mut()
+                .expect("lathe")
+                .place = place;
+            for p in &mut expected {
+                p.facets = camcraft_app::tool_body_lathe::place(&p.facets, &place)
+                    .expect("placed piece")
+                    .into();
+                p.csys = transform_csys_lathe(&p.csys, &place).expect("placed CSYS");
+            }
+        }
+        harness.run();
+        apply_body(&mut harness);
+        let applied = body(&harness.state().state, tool);
+        assert_ne!(
+            applied.facets,
+            original.facets,
+            "placement must be applied: {}",
+            harness.state().state.status
+        );
+        assert_eq!(
+            applied.pieces, expected,
+            "all piece meshes and CSYS must move together: {tool}"
+        );
+        let combined: Vec<_> = applied
+            .pieces
+            .iter()
+            .flat_map(|p| p.facets.iter().copied())
+            .collect();
+        assert_eq!(applied.facets.as_ref(), combined);
+        harness
+            .state_mut()
+            .state
+            .pending
+            .push_back(CommandKind::Undo);
+        harness.run();
+        harness.run();
+        assert_eq!(body(&harness.state().state, tool).pieces, original.pieces);
+    }
+}
diff --git a/crates/ui/src/egui_app/tests/wire_sync_viewport.rs b/crates/ui/src/egui_app/tests/wire_sync_viewport.rs
new file mode 100644
index 000000000..3513a89ba
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/wire_sync_viewport.rs
@@ -0,0 +1,67 @@
+//! #1171's frame test: with the Wire Contour page's sync pick armed,
+//! real viewport clicks on corners of the seed's 60 x 60 x 30 block state
+//! a sync pair into the page draft (upper first, then a lower point below
+//! it), a flat second click is refused by name, and the stored pair is
+//! drawn as a ruling. The draft is not the command history: nothing is
+//! applied by a click.
+//! Provenance: our own pick law test over our own shell; no vendor
+//! material consulted.
+
+use camcraft_app::operation::{OpParams, WireFourAxis, WirePairingRule};
+
+use super::*;
+
+fn pixel(sh: &ShellUi, p: [f64; 3]) -> egui::Pos2 {
+    let ([x0, y0], [x1, y1]) = sh.state.viewport_rect;
+    let (w, hgt) = (x1 - x0, y1 - y0);
+    let mvp = sh.state.cam.mvp(f64::from(w / hgt));
+    let uv = interact::project_uv(&mvp, p).expect("the corner is in front of the camera");
+    egui::pos2(x0 + uv[0] * w, y0 + uv[1] * hgt)
+}
+
+fn sync(h: &Harness<'static, ShellUi>) -> Vec<camcraft_app::operation::WireSyncPair> {
+    match &h.state().state.op_ui.params {
+        OpParams::WireContour(w) => w.four_axis.as_ref().map(|f| f.sync.clone()).unwrap_or_default(),
+        _ => Vec::new(),
+    }
+}
+
+#[test]
+fn two_clicked_corners_state_a_sync_pair_and_a_flat_one_is_refused() {
+    let mut harness = shell_harness();
+    harness.run();
+    {
+        let st = &mut harness.state_mut().state;
+        let machine = camcraft_app::machine::parse_mch(include_str!("../../../../app/tests/edm/wire-iso-fixture.mch")).expect("fixture");
+        st.pending.push_back(CommandKind::EditMachineApply { path: "wire-test.mch".into(), machine: Box::new(machine) });
+        st.drain_actions();
+        let kind = camcraft_app::operation::KindInfo::ALL.iter().position(|k| k.label == "Wire Contour").expect("wire kind");
+        crate::actions::add_operation(st, kind);
+        st.drain_actions();
+        st.sync_ops_ui();
+        let OpParams::WireContour(w) = &mut st.op_ui.params else { panic!("a wire draft: {}", st.status) };
+        w.four_axis = Some(WireFourAxis { pairing: WirePairingRule::SyncPoints, ..WireFourAxis::default() });
+        crate::wire_sync_pick::arm(st);
+        assert_eq!(st.geo_pick, GeoPick::Vertex, "arming sets Vertex mode");
+    }
+    let geo_before = harness.state().state.op_ui.geo.clone();
+    let px = pixel(harness.state(), [0.0, 0.0, 30.0]);
+    click_viewport(&mut harness, px);
+    let s = sync(&harness);
+    assert_eq!(s.len(), 1, "{}", harness.state().state.status);
+    assert!(s[0].upper.is_some() && s[0].lower.is_none(), "{s:?}");
+    assert_eq!(crate::wire_sync_pick::next_click(&s), "click the lower point of pair 1 (a vertex of the lower profile)");
+    // A second corner at the same height is not below the first.
+    let px = pixel(harness.state(), [60.0, 0.0, 30.0]);
+    click_viewport(&mut harness, px);
+    assert!(harness.state().state.status.contains("must lie below"), "{}", harness.state().state.status);
+    assert!(sync(&harness)[0].lower.is_none(), "a refused click changes nothing");
+    let px = pixel(harness.state(), [60.0, 0.0, 0.0]);
+    click_viewport(&mut harness, px);
+    let s = sync(&harness);
+    assert_eq!(s[0].upper, Some([0.0, 0.0]), "{s:?}");
+    assert_eq!(s[0].lower, Some([60.0, 0.0]), "{s:?} ({})", harness.state().state.status);
+    let st = &harness.state().state;
+    assert_eq!(st.op_ui.geo, geo_before, "nothing joins the open operation");
+    assert!(!crate::wire_sync_pick::segments(st, 1.6).is_empty(), "the stored pair is drawn as a ruling");
+}
