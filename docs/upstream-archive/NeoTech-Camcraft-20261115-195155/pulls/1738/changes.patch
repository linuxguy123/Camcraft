+    let change = p.find("(T0202").expect("the second tool");
+    assert!(
+        p[..change].ends_with("G0 X16 Z-5\nM9\nM5\nG0 Z10\nG55\n"),
+        "+Z to the face, in the old frame - before the next work offset: {p}"
+    );
