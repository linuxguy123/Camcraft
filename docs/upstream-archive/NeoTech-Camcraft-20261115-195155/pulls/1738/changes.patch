+    }
+    if rc <= 2.0 * bore_floor_reach(tool_diameter, corner_radius, through) {
+        return Some(1);
+    }
+    let count = (rc / step).ceil();
+    if !count.is_finite() || count > MAX_BORE_RINGS as f64 {
+        return None;
+    }
+    Some(count as usize)
