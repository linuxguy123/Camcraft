+    assert_eq!(setup_stock::carry_refusal(&world, "Setup2"), None, "a side-on quarter turn carries");
+    assert_eq!(setup_stock::effective(&world, "Setup2"), Some(StockSource::FromPrevious), "a different hold carries");
