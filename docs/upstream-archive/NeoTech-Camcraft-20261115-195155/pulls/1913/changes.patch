From ca5a6826b80c75d0973852f04e8eff43b624758c Mon Sep 17 00:00:00 2001
From: mkinney <2219838+mkinney@users.noreply.github.com>
Date: Sun, 15 Nov 2026 06:17:49 -0800
Subject: [PATCH] fix(post): refuse Sodick control-side offset requests by name

Record why control-side H offsets remain unsupported and suppress cutting
after a compensation request until the wire section ends.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #1498
---
 assets/posts/sodick-wire.cps                 |  14 +-
 crates/post/tests/sodick_comp.rs             | 192 +++++++++++++++++++
 docs/decisions/1498-sodick-control-offset.md |  48 +++++
 3 files changed, 253 insertions(+), 1 deletion(-)
 create mode 100644 crates/post/tests/sodick_comp.rs
 create mode 100644 docs/decisions/1498-sodick-control-offset.md

diff --git a/assets/posts/sodick-wire.cps b/assets/posts/sodick-wire.cps
index 54b92bacb..7fddac2d5 100644
--- a/assets/posts/sodick-wire.cps
+++ b/assets/posts/sodick-wire.cps
@@ -48,6 +48,7 @@ var cutZ = null;           // the section's one programmed plane (2-axis)
 var awt = false;
 var taper = 0;             // the section's stated taper, degrees (0: vertical)
 var angleWord = false;    // WireAngle is unsupported, including a stated zero
+var controlOffset = false; // a COMP record refuses this section, even before SECTION
 var fourAxis = "";         // the section's 4-axis pairing rule ("": one profile)
 var leaning = false;       // the next move states an upper guide offset
 var machineGood = false;
@@ -162,6 +163,16 @@ function onToolChange(number, name) {
   refuse("tool" + opName, who() + "changes to tool " + number + " - a wire EDM mounts no tool (the wire is the condition's)");
 }
 
+// #1498: the wire laws judge the generated wire-centre path. No stored
+// H-register value ties a control-offset path to that judged geometry.
+// Refuse every COMP record (including wear and OFF); OFF cannot make a
+// refused section safe again. Section end resets the refusal.
+function onRadiusCompensation() {
+  controlOffset = true;
+  sectionOk = false;
+  refuse("offset" + opName, who() + "Sodick: control-side wire offset (G41/G42 H) is not supported - no verified H-register value is stored; post a generated wire-centre path without control or wear compensation");
+}
+
 // ------------------------------------------------------------- section
 function onSection() {
   inSection = true;
@@ -173,7 +184,7 @@ function onSection() {
     refuse("op" + opName, who() + "is not wire EDM work (no EDM condition) - the Sodick wire post posts Wire Contour operations only");
     return;
   }
-  var ok = machineGood;
+  var ok = machineGood && !controlOffset;
   // The manual's condition word: C and three digits (C000 to C999). The
   // operation's condition id is that word; anything else is refused.
   if (!/^C[0-9]{3}$/.test(condition)) {
@@ -333,6 +344,7 @@ function onSectionEnd() {
   afterOp = "";
   taper = 0;
   angleWord = false;
+  controlOffset = false;
   fourAxis = "";
   leaning = false;
 }
diff --git a/crates/post/tests/sodick_comp.rs b/crates/post/tests/sodick_comp.rs
new file mode 100644
index 000000000..8cafbe241
--- /dev/null
+++ b/crates/post/tests/sodick_comp.rs
@@ -0,0 +1,192 @@
+//! Provenance: synthetic CNC intermediate streams for the #1498 offset decision.
+//! Gate map: covers assets/posts/sodick-wire.cps, camcraft_post::post::engine,
+//! camcraft_post::post::cnc.
+
+use camcraft_post::cl::CompSide;
+use camcraft_post::post::{cnc, engine};
+use serde_json::json;
+
+const SCRIPT: &str = include_str!("../../../assets/posts/sodick-wire.cps");
+const STREAM: &str = "; HSMW-CNC v1
+PARAM OperationName Punch1
+PARAM WorkOffset G54
+PARAM EdmCondition C110
+SECTION
+Rapid X -30000 Y 0 Z 0
+Feed X -20000 Y 0 Z 0 F 2000
+Feed X -10000 Y 0 Z 0 F 2000
+ENDSECTION
+";
+
+fn run(stream: &str) -> engine::PostOutput {
+    let machine = json!({"kind": "wire_edm", "name": "Synthetic wire", "edm": {"awt": true}});
+    engine::run(SCRIPT, &machine, stream).expect("synthetic stream runs")
+}
+
+fn comp(side: Option<CompSide>, wear: bool) -> String {
+    cnc::serialize(&[cnc::Record::Comp {
+        side,
+        radius_mm: if side.is_some() { 0.165 } else { 0.0 },
+        wear,
+    }])
+    .lines()
+    .filter(|line| line.starts_with("COMP "))
+    .map(|line| format!("{line}\n"))
+    .collect()
+}
+
+fn assert_refused(out: &engine::PostOutput) {
+    assert!(
+        out.warnings.iter().any(|w| {
+            w.contains("Punch1") && w.contains("Sodick") && w.contains("control-side wire offset")
+        }),
+        "{:?}\n{}",
+        out.warnings,
+        out.program
+    );
+}
+
+fn has_word(out: &engine::PostOutput, word: &str) -> bool {
+    out.program
+        .lines()
+        .filter(|line| !line.starts_with('('))
+        .flat_map(str::split_whitespace)
+        .any(|actual| actual == word)
+}
+
+#[test]
+fn sodick_control_and_wear_offsets_before_section_refuse_without_cutting() {
+    for side in [CompSide::Left, CompSide::Right] {
+        for wear in [false, true] {
+            let stream = STREAM.replacen(
+                "SECTION\n",
+                &format!("{}SECTION\n", comp(Some(side), wear)),
+                1,
+            );
+            let out = run(&stream);
+            assert!(
+                !has_word(&out, "G01") && !has_word(&out, "T91"),
+                "{}",
+                out.program
+            );
+            assert_refused(&out);
+        }
+    }
+}
+
+#[test]
+fn sodick_control_and_wear_offsets_inside_section_stop_subsequent_cuts() {
+    for side in [CompSide::Left, CompSide::Right] {
+        for wear in [false, true] {
+            let stream = STREAM.replace(
+                "Feed X -10000",
+                &format!("{}Feed X -10000", comp(Some(side), wear)),
+            );
+            let out = run(&stream);
+            assert!(
+                out.program.lines().any(|line| line == "G01 X-20. Y0."),
+                "{}",
+                out.program
+            );
+            assert!(
+                !out.program.lines().any(|line| line == "G01 X-10. Y0."),
+                "{}",
+                out.program
+            );
+            assert_refused(&out);
+            // A wire already threaded must still be cut at the section's end.
+            assert!(has_word(&out, "T90"), "{}", out.program);
+        }
+    }
+}
+
+#[test]
+fn sodick_comp_cancel_does_not_reenable_a_refused_section() {
+    let request = format!(
+        "{}{}",
+        comp(Some(CompSide::Right), false),
+        comp(None, false)
+    );
+    let stream = STREAM.replace("Feed X -20000", &format!("{request}Feed X -20000"));
+    let out = run(&stream);
+    assert!(
+        !has_word(&out, "G01") && !has_word(&out, "T91"),
+        "{}",
+        out.program
+    );
+    assert_refused(&out);
+}
+
+#[test]
+fn sodick_comp_request_stops_a_following_arc() {
+    let stream = STREAM.replace(
+        "Feed X -10000 Y 0 Z 0 F 2000",
+        &format!(
+            "{}Arc CCW X -10000 Y 0 Z 0 F 2000 I -15000 J 0",
+            comp(Some(CompSide::Left), false)
+        ),
+    );
+    let out = run(&stream);
+    assert!(
+        !has_word(&out, "G02") && !has_word(&out, "G03"),
+        "{}",
+        out.program
+    );
+    assert_refused(&out);
+}
+
+#[test]
+fn sodick_standalone_comp_off_is_refused_as_an_unsupported_record() {
+    let stream = STREAM.replace(
+        "Feed X -20000",
+        &format!("{}Feed X -20000", comp(None, false)),
+    );
+    let out = run(&stream);
+    assert!(
+        !has_word(&out, "G01") && !has_word(&out, "T91"),
+        "{}",
+        out.program
+    );
+    assert_refused(&out);
+}
+
+#[test]
+fn sodick_comp_refusal_resets_for_the_next_plain_section() {
+    let refused = STREAM.replacen(
+        "SECTION\n",
+        &format!("{}SECTION\n", comp(Some(CompSide::Left), false)),
+        1,
+    );
+    let plain = STREAM.replace("Punch1", "Plain2");
+    let out = run(&format!("{refused}{plain}"));
+    assert_refused(&out);
+    for line in ["G01 X-20. Y0.", "G01 X-10. Y0.", "T91", "T90"] {
+        assert_eq!(
+            out.program.lines().filter(|actual| *actual == line).count(),
+            1,
+            "{}",
+            out.program
+        );
+    }
+    assert!(
+        !out.warnings.iter().any(|w| w.contains("Plain2")),
+        "{:?}",
+        out.warnings
+    );
+}
+
+#[test]
+fn sodick_plain_wire_centre_stream_still_posts() {
+    let out = run(STREAM);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(
+        has_word(&out, "G01") && has_word(&out, "T91") && has_word(&out, "T90"),
+        "{}",
+        out.program
+    );
+    assert!(
+        !has_word(&out, "G41") && !has_word(&out, "G42"),
+        "{}",
+        out.program
+    );
+}
diff --git a/docs/decisions/1498-sodick-control-offset.md b/docs/decisions/1498-sodick-control-offset.md
new file mode 100644
index 000000000..bc0bb96c1
--- /dev/null
+++ b/docs/decisions/1498-sodick-control-offset.md
@@ -0,0 +1,48 @@
+## #1498 - Keep Sodick control-side wire offsets unsupported
+
+**Decided:** The Sodick post continues to accept generated wire-centre
+paths only. Control-side G41/G42 with an H register, wear offsets, and
+skim passes that reuse one part path with different H values remain
+unsupported. This takes the issue's explicit "supported or not" decision
+option. No H number format is adopted because the post emits no H word.
+
+**Why:** `WireContourOp` and `WireSkim` store conditions, but no H-register
+identifiers or values. The generator uses each condition's wire radius
+and spark gap to generate a centre path. The wire laws judge that path
+against the part and stock. An operator's H value could move the actual
+wire away from the path those laws judged. The existing milling
+`CompSpan` contract assumes Fanuc-style engage and cancel geometry; it
+does not establish Sodick's geometry or the contents of an H register.
+This change makes no claim that those control semantics were verified.
+
+The post now handles every `COMP` record with a Sodick refusal that names
+the operation and explains the missing verified H-register value. It
+suppresses later cutting moves in that section. A request before
+`SECTION` stays refused when the section opens. `COMP OFF` is also
+unsupported and cannot clear a refusal. Section end still cuts an
+already-threaded wire and resets the state for a later plain section.
+The existing skim-condition refusal remains in place.
+
+The engine already counted a warning when the Sodick script lacked the
+compensation hook, so the app already blocked release of that program.
+The change replaces that generic warning and suppresses the affected
+cutting blocks in the diagnostic output; it does not repair a previously
+silent release by the app.
+
+**Considered and dropped:** Writing G41/G42 H around the current centre
+path could apply an additional offset. Posting a part path with an
+operator-chosen H value would disconnect the posted cut from the wire
+laws. Reusing milling compensation would assume control behaviour the
+Sodick implementation has not established. Accepting only `COMP OFF`
+would introduce a partial compensation contract without enabling the
+requested feature. Retaining only the generic engine warning would leave
+the affected cutting blocks in its diagnostic output.
+
+**Cost to change later:** Support needs published control semantics for
+H-register format, range and units, including metric formatting and
+condition changes between passes. The document must store each pass's
+register and offset value. Generation must prove that the programmed
+lead-in, contour and cancellation produce the centre path checked by the
+wire laws, and value changes must invalidate that proof and revalidate
+the cut. A rough-plus-skim punch golden and a refusal of a gouging offset
+must pin the resulting behaviour before the post enables it.
