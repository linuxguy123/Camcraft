+    c.ok(
+        "place_setup_origin",
+        json!({"source": "vertex", "pick": {"model": "part", "id": vertex["id"]}}),
+    );
+    assert_eq!(
+        c.ok("get_job", json!({}))["setups"][1]["wcs"]["origin"],
+        vertex["at"]
+    );
+    c.ok("undo", json!({}));
+    assert_eq!(
+        c.ok("get_job", json!({}))["setups"][1]["wcs"]["placed"],
+        false
+    );
+    c.ok(
+        "set_stock",
+        json!({"box": {"dx": 40.0, "dy": 50.0, "dz": 12.0}}),
+    );
+    c.ok(
+        "place_setup_origin",
+        json!({"source": "stock_box", "point": "corner"}),
+    );
+    assert_eq!(
+        c.ok("get_job", json!({}))["setups"][1]["wcs"]["origin"],
+        json!([-20.0, -25.0, 0.0])
+    );
+    c.ok("undo", json!({}));
+    assert_eq!(
+        c.ok("get_job", json!({}))["setups"][1]["wcs"]["placed"],
