@@ -0,0 +1,175 @@
+//! Issue #1620: a whole-model 2D Adaptive with default settings cut the
+//! user's `Milling-test.step` about 1 mm into its D wall at every level
+//! (the program sim read the column 10-25 mm deep at (-1.44, -29.94)).
+//! The part pinches the stock's band shut: the cutter-centre area is
+//! pieces whose walls lie on one line (the stock's offset edge), and the
+//! Offset rings the HSM plan fell back to joined two pieces with a feed
+//! along that line, across the gap where the part stands. The chord law
+//! (`machining2d::chord_clears`) read the graze along the second piece's
+//! wall and passed the whole chord on its midpoint; it now judges every
+//! piece of the chord between boundary touches.
+//!
+//! Gate map (#1620): covers app::operation (generate, area), motion
+//! machining2d (chord_clear, waterscan, pocket_hsm).
+//! Provenance: our own regression of the reviewer's reproduction; no
+//! vendor material consulted.
+
+use camcraft_app::cl::{MoveKind, Toolpath};
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, ImportModel, SetStock};
+use camcraft_app::geo2d::{Point2, Region};
+use camcraft_app::geometry::{Mesh, Point3, cylinder, quat_from_yaw, slice};
+use camcraft_app::model;
+use camcraft_app::operation::{self, Height, OpParams, OpType, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+
+const TOOL: &str = "EM-0600-4FL";
+const R: f64 = 3.0;
+
+/// `part` in a `side` x `side` box stock standing on Z `z0` .. `z0 + dz`,
+/// aligned or turned a quarter about Z (the same footprint).
+fn job(part: Mesh, side: f64, z0: f64, dz: f64, turned: bool) -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", part));
+    let rot = if turned { quat_from_yaw(std::f64::consts::FRAC_PI_2) } else { Location::default().rot };
+    let at = Location { pos: Point3::new(0.0, 0.0, z0), rot };
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: side, dy: side, dz }, at).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("catalog");
+    h.execute(&world, AddTool::new(&world, TOOL, tool).expect("tool"));
+    (world, h)
+}
+
+fn generated(world: &World, h: &mut History, src: &str, params: OpParams) -> (Toolpath, usize) {
+    h.execute(world, CreateOperation::new(world, "Op1", TOOL, SrcRef::Entity(src.into()), params).expect("create"));
+    h.execute(world, GenerateOperation::new(world, "Op1").expect("generate"));
+    let e = model::find_by_name(world, "Op1").expect("op");
+    let tp = model::toolpath_of(world, &e).expect("the op generates");
+    (tp.path.clone(), tp.warnings.len())
+}
+
+/// The least distance any cutting move's centre keeps from the Z axis
+/// below `top`, read along arcs on the arc.
+fn closest_to_axis(t: &Toolpath, top: f64) -> (f64, Point3) {
+    let mut worst = (f64::INFINITY, Point3::new(0.0, 0.0, 0.0));
+    for m in t.moves.iter().filter(|m| m.kind != MoveKind::Rapid && m.from.z.min(m.to.z) < top - 1e-6) {
+        for (a, b) in m.chords(0.01) {
+            for k in 0..=16 {
+                let s = f64::from(k) / 16.0;
+                let (x, y) = (a.x + (b.x - a.x) * s, a.y + (b.y - a.y) * s);
+                if x.hypot(y) < worst.0 {
+                    worst = (x.hypot(y), Point3::new(x, y, m.from.z.min(m.to.z)));
+                }
+            }
+        }
+    }
+    worst
+}
+
+fn retyped(kind: OpType, top: f64, bottom: f64) -> OpParams {
+    let mut p = operation::seed_params(kind.ordinal());
+    match &mut p {
+        OpParams::Adaptive2D { top_z, bottom_z, .. } | OpParams::Offset2D { top_z, bottom_z, .. } => {
+            *top_z = Height::fixed(top);
+            *bottom_z = Height::fixed(bottom);
+        }
+        _ => panic!("a pocket-family kind"),
+    }
+    p
+}
+
+/// A 20 mm disc standing in a 31 mm stock: the stock's band around it
+/// is 5.5 mm, under the 6 mm cutter, so the cutter-centre area is the four
+/// corners, whose walls lie on the stock's offset edges. Every cutting
+/// move keeps the cutter off the disc - on the aligned stock and the
+/// turned one, under 2D Adaptive and 2D Offset (both ride the rings).
+#[test]
+fn a_whole_model_clearing_never_joins_two_corners_across_the_part_that_pinches_them() {
+    // 64 facets: the circumradius is 10, every edge at least 9.99 out.
+    let rim = 10.0 * (std::f64::consts::PI / 64.0).cos();
+    for kind in [OpType::Adaptive2D, OpType::Offset2D] {
+        for turned in [false, true] {
+            let (world, mut h) = job(cylinder(20.0, 10.0, 64), 31.0, 0.0, 10.0, turned);
+            let (t, warns) = generated(&world, &mut h, "part", retyped(kind, 10.0, 5.0));
+            let tag = format!("{kind:?} turned {turned}");
+            assert!(t.moves.iter().any(|m| m.kind == MoveKind::Feed && m.to.z < 10.0 - 1e-6), "{tag}: the corners are cut");
+            let (d, at) = closest_to_axis(&t, 10.0);
+            assert!(d >= rim + R - 0.02, "{tag}: a cut at ({:.3}, {:.3}, {:.3}) stands {d:.3} from the axis - {:.3} into the disc", at.x, at.y, at.z, rim + R - d);
+            assert_eq!(warns, 0, "{tag}: the op verifies clean");
+        }
+    }
+}
+
+fn milling_test() -> Mesh {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models/Milling-test.step");
+    let imp = ImportModel::new(&path).expect("the user's STEP imports");
+    let world = new_world();
+    let mut h = History::default();
+    let name = imp.name.clone();
+    h.execute(&world, imp);
+    let e = model::find_by_name(&world, &name).expect("the part");
+    Mesh::from_facets(model::world_facets(&world, &e).expect("facets"))
+}
+
+fn seg_dist(p: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let l2 = dx * dx + dy * dy;
+    let t = if l2 > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+    (p.x - a.x - t * dx).hypot(p.y - a.y - t * dy)
+}
+
+/// How far a cutter of radius `R` centred at `p` reaches into `section`.
+fn reach_into(section: &Region, p: Point2) -> f64 {
+    let mut d = f64::INFINITY;
+    for l in section.loops() {
+        let q = l.points();
+        for i in 0..q.len() {
+            d = d.min(seg_dist(p, q[i], q[(i + 1) % q.len()]));
+        }
+    }
+    if section.contains(p) { R + d } else { R - d }
+}
+
+/// The issue's own job: the user's part (a D whose round side is
+/// tangent to Y -30 near X 0) in the 70 mm box with its top at Z 10,
+/// the kind's seed params (Top/Bottom of model, 5 mm steps, helix
+/// entry) and the 6 mm end mill. Before #1620 the Offset rings the HSM
+/// plan fell back to fed along Y -32 from (-8.05, -32) to (32, -32) at
+/// every level, 0.94 mm into the D. Read against the part's own section
+/// at each move's Z; the 0.06 allowance is the arc fit on the faceted
+/// round side (0.045 at worst), far under that cut.
+#[test]
+#[ignore = "heavy lane (release): the HSM plan grinds its budget on the user's part in debug (~90 s)"]
+fn the_users_part_with_default_adaptive_keeps_the_cutter_off_it() {
+    let part = milling_test();
+    let mut sections: Vec<(i64, Region)> = Vec::new();
+    for turned in [false, true] {
+        let (world, mut h) = job(part.clone(), 70.0, -7.0, 17.0, turned);
+        let (t, warns) = generated(&world, &mut h, "part", operation::seed_params(OpType::Adaptive2D.ordinal()));
+        let mut worst = (0.0f64, Point3::new(0.0, 0.0, 0.0));
+        for m in t.moves.iter().filter(|m| m.kind != MoveKind::Rapid) {
+            let z = m.from.z.min(m.to.z);
+            let key = (z * 1000.0).round() as i64;
+            if !sections.iter().any(|(k, _)| *k == key) {
+                sections.push((key, slice::material_above(&part.facets, z).expect("the part sections")));
+            }
+            let Some((_, sec)) = sections.iter().find(|(k, _)| *k == key) else { continue };
+            for (a, b) in m.chords(0.01) {
+                for k in 0..=8 {
+                    let s = f64::from(k) / 8.0;
+                    let p = Point2::new(a.x + (b.x - a.x) * s, a.y + (b.y - a.y) * s);
+                    let r = reach_into(sec, p);
+                    if r > worst.0 {
+                        worst = (r, Point3::new(p.x, p.y, z));
+                    }
+                }
+            }
+        }
+        let (r, at) = worst;
+        assert!(r < 0.06, "turned {turned}: a cut at ({:.3}, {:.3}, {:.3}) reaches {r:.3} into the part", at.x, at.y, at.z);
+        assert_eq!(warns, 0, "turned {turned}: the op verifies clean");
+    }
+}
diff --git a/crates/motion/src/machining2d/chord_clear.rs b/crates/motion/src/machining2d/chord_clear.rs
new file mode 100644
index 000000000..c607e2f69
--- /dev/null
+++ b/crates/motion/src/machining2d/chord_clear.rs
@@ -0,0 +1,134 @@
+//! The straight-chord law of the planar generators: does a chord stay
+//! inside (or on) a closed region? Split from `slots.rs` by #1620, which
+//! also closed its collinear hole (below).
+//!
+//! Provenance: segment/polygon intersection and point-in-polygon tests
+//! (O'Rourke, "Computational Geometry in C", 2nd ed., ch. 7); our own
+//! arrangement of them. No vendor material consulted.
+
+use crate::geo2d::{Point2, Region};
+
+use super::ring::on_boundary;
+
+/// Parameter slack along the chord: a touch closer than this to either
+/// end is the end itself.
+const EPS: f64 = 1e-9;
+
+/// True when the straight chord `a` -> `b` never passes outside the
+/// closed region: both ends in it, no loop edge properly crossing the
+/// open chord, and every piece of the chord between two points where it
+/// touches the boundary inside or on it. A chord running along a
+/// boundary edge is exactly the tangency a wall pass is, so grazing
+/// reads as clear.
+///
+/// Why pieces and not one midpoint (#1620): without a proper crossing
+/// the chord can still leave the region where it runs along an edge and
+/// slips off its end at a vertex whose other edge turns away - two
+/// pieces of one area that meet the chord line only along their own
+/// walls (the cutter-centre pieces either side of a part that pinches
+/// the stock's band shut). Every edge touch splits the chord, and the
+/// midpoint of each piece decides for that piece: between two touches
+/// it meets no boundary, so it lies wholly inside or wholly outside.
+pub fn chord_clears(region: &Region, a: Point2, b: Point2) -> bool {
+    if (!region.contains(a) && !on_boundary(region, a))
+        || (!region.contains(b) && !on_boundary(region, b))
+    {
+        return false;
+    }
+    if a == b {
+        return true;
+    }
+    let d = Point2::new(b.x - a.x, b.y - a.y);
+    let dd = d.x * d.x + d.y * d.y;
+    let mut cuts: Vec<f64> = vec![0.0, 1.0];
+    let along = |q: Point2| ((q.x - a.x) * d.x + (q.y - a.y) * d.y) / dd;
+    for l in region.loops() {
+        let pts = l.points();
+        let n = pts.len();
+        for i in 0..n {
+            let c = pts[i];
+            let e = pts[(i + 1) % n];
+            let g = Point2::new(e.x - c.x, e.y - c.y);
+            let ca = Point2::new(c.x - a.x, c.y - a.y);
+            let den = d.x * g.y - d.y * g.x;
+            if den == 0.0 {
+                // Parallel to this edge. On the chord's line (within
+                // the boundary tolerance) it is a graze: its ends split
+                // the chord, so the piece beyond the edge is judged on
+                // its own.
+                let off = ca.x * d.y - ca.y * d.x;
+                if off * off <= 1e-18 * dd {
+                    cuts.extend([along(c), along(e)].into_iter().filter(|t| EPS < *t && *t < 1.0 - EPS));
+                }
+                continue;
+            }
+            let t = (ca.x * g.y - ca.y * g.x) / den;
+            let u = (ca.x * d.y - ca.y * d.x) / den;
+            if !(EPS < t && t < 1.0 - EPS) {
+                continue;
+            }
+            if u > EPS && u < 1.0 - EPS {
+                return false; // crosses the open edge: a real crossing
+            }
+            if u >= -EPS && u <= 1.0 + EPS {
+                // The chord goes through a loop vertex. That cuts the
+                // boundary only if the two edges meeting there are on
+                // opposite sides of the chord line; both on one side is
+                // tangency (a fillet touching the straight it joins).
+                let j = if u < 0.5 { i } else { (i + 1) % n };
+                let p0 = pts[(j + n - 1) % n];
+                let p2 = pts[(j + 1) % n];
+                let h0 = (p0.x - a.x) * d.y - (p0.y - a.y) * d.x;
+                let h2 = (p2.x - a.x) * d.y - (p2.y - a.y) * d.x;
+                if h0 * h2 < 0.0 {
+                    return false;
+                }
+                cuts.push(t);
+            }
+        }
+    }
+    cuts.sort_by(f64::total_cmp);
+    cuts.dedup_by(|x, y| (*x - *y).abs() <= EPS);
+    cuts.windows(2).all(|w| {
+        let s = (w[0] + w[1]) * 0.5;
+        let m = Point2::new(a.x + d.x * s, a.y + d.y * s);
+        region.contains(m) || on_boundary(region, m)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geo2d::Loop;
+
+    fn sq(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+        let p = Point2::new;
+        Loop::new(vec![p(x0, y0), p(x1, y0), p(x1, y1), p(x0, y1)]).expect("loop")
+    }
+
+    /// #1620's shape: two pieces whose bottoms lie on one line with a
+    /// gap between them. The chord from one piece's inner corner along
+    /// the shared line to the far corner of the other grazes the second
+    /// piece's wall and leaves the area across the gap.
+    #[test]
+    fn a_chord_along_two_pieces_walls_across_the_gap_between_them_does_not_clear() {
+        let region = Region::new(vec![sq(-32.0, -32.0, -8.0, -8.0), sq(8.0, -32.0, 32.0, -8.0)]).expect("region");
+        let (a, b) = (Point2::new(-8.0, -32.0), Point2::new(32.0, -32.0));
+        assert!(!chord_clears(&region, a, b), "the gap x in (-8, 8) is outside the area");
+        assert!(!chord_clears(&region, b, a), "either way along it");
+        // Its two grazing halves on each piece's own wall still clear.
+        assert!(chord_clears(&region, Point2::new(-32.0, -32.0), a));
+        assert!(chord_clears(&region, Point2::new(8.0, -32.0), b));
+    }
+
+    /// The graze law the wall passes ride stays: a chord along one edge,
+    /// past a convex corner tangent to the chord, inside one piece.
+    #[test]
+    fn a_chord_grazing_one_pieces_wall_still_clears() {
+        let region = Region::new(vec![sq(0.0, 0.0, 30.0, 30.0)]).expect("region");
+        assert!(chord_clears(&region, Point2::new(0.0, 0.0), Point2::new(30.0, 0.0)));
+        assert!(chord_clears(&region, Point2::new(5.0, 0.0), Point2::new(25.0, 0.0)));
+        assert!(chord_clears(&region, Point2::new(0.0, 0.0), Point2::new(30.0, 30.0)));
+        assert!(!chord_clears(&region, Point2::new(0.0, 0.0), Point2::new(31.0, 0.0)));
+    }
+}
