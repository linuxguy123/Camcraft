diff --git a/crates/kernel/tests/machining_mesh_parity.rs b/crates/kernel/tests/machining_mesh_parity.rs
new file mode 100644
index 000000000..5e0c4544e
--- /dev/null
+++ b/crates/kernel/tests/machining_mesh_parity.rs
@@ -0,0 +1,138 @@
+//! The machining mesh's parity laws for the STEP switch (#917): positions
+//! snapped off their last-bit noise and never moved past the 1e-9 mm
+//! window, a solid whose faces all point inward turned outward and said,
+//! and the fillet fixture meshed at the app chord (adaptive refinement of
+//! the deviation bound).
+//! Provenance: our own test design; fixtures are the repo's own.
+//!
+//! Gate map (#917): covers camcraft_kernel::mesh_weld,
+//! camcraft_kernel::machining_mesh, camcraft_kernel::mesh_deviation.
+
+use std::path::PathBuf;
+
+use camcraft_kernel::machining_mesh::machining_mesh;
+use camcraft_kernel::mesh_weld::{SNAP_WINDOW_MM, snap};
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::{StepSolid, import_step};
+use solidcore::kernel::CancelToken;
+
+/// The app's chord cap (#689), mm.
+const TOL: f64 = 0.005;
+
+fn text(file: &str) -> String {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("../../testdata/models")
+        .join(file);
+    std::fs::read_to_string(&path).unwrap_or_default()
+}
+
+fn solid_of(file: &str, text: &str) -> StepSolid {
+    let mut k = SolidcoreKernel::default();
+    let mut import = match import_step(&mut k, text.as_bytes(), &CancelToken::new()) {
+        Ok(i) => i,
+        Err(e) => panic!("{file}: {e}"),
+    };
+    assert_eq!(import.solids.len(), 1, "{file}: one solid expected");
+    import.solids.remove(0)
+}
+
+#[test]
+fn the_snap_takes_the_last_bit_noise_off_a_grid_value() {
+    for (noisy, exact) in [
+        (20.000000000000004, 20.0_f64),
+        (19.999999999999996, 20.0),
+        (-5.000000000000001, -5.0),
+        (14.999999999999998, 15.0),
+        (0.1 + 0.2, 0.3),
+        (-1e-17, 0.0),
+        (12.5 + 1e-10, 12.5),
+    ] {
+        assert_eq!(snap(noisy).to_bits(), exact.to_bits(), "{noisy:e} -> {exact}");
+    }
+    // A grid value stays itself, and the result is +0.0, never -0.0.
+    for exact in [0.0_f64, 1.0, 0.001, 123.456, -98.765] {
+        assert_eq!(snap(exact).to_bits(), exact.to_bits(), "{exact}");
+    }
+    assert_eq!(snap(-0.0).to_bits(), 0.0_f64.to_bits());
+}
+
+#[test]
+fn a_coordinate_outside_the_window_is_never_moved() {
+    for c in [
+        12.5 + 1e-6,
+        12.5 - 1e-6,
+        20.0 + 2.0 * SNAP_WINDOW_MM,
+        12.499_999_9,
+        std::f64::consts::PI,
+        12.507_3,
+        f64::NAN,
+        f64::INFINITY,
+        1e300,
+    ] {
+        assert_eq!(snap(c).to_bits(), c.to_bits(), "{c:e} must stay");
+    }
+}
+
+#[test]
+fn the_bore_mesh_stands_on_its_exact_levels() {
+    let s = solid_of("Milling-test.step", &text("Milling-test.step"));
+    let m = machining_mesh(&s, TOL, &CancelToken::new()).unwrap_or_else(|e| panic!("{e}"));
+    let zs: Vec<f64> = m.positions.iter().map(|p| p[2]).collect();
+    let top = zs.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+    let bottom = zs.iter().copied().fold(f64::INFINITY, f64::min);
+    assert_eq!((top, bottom), (20.0, -5.0), "no last-bit noise on the levels");
+    for z in [0.0, 20.0] {
+        assert!(zs.contains(&z), "a vertex stands exactly on Z {z}");
+    }
+    assert_eq!(m.report.open_sides, 0);
+}
+
+/// box.step with every face and bound sense turned over: the same closed
+/// box, all faces pointing inward.
+fn inward(text: &str) -> String {
+    text.lines()
+        .map(|l| {
+            if l.contains("FACE_SURFACE(") || l.contains("FACE_BOUND(") {
+                l.replace(".T.)", ".X.)")
+                    .replace(".F.)", ".T.)")
+                    .replace(".X.)", ".F.)")
+            } else {
+                l.to_owned()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[test]
+fn an_inward_solid_is_turned_outward_and_said() {
+    let plain = solid_of("box.step", &text("box.step"));
+    let good = machining_mesh(&plain, TOL, &CancelToken::new()).unwrap_or_else(|e| panic!("{e}"));
+    assert!(
+        !good.report.notes.iter().any(|n| n.contains("inward")),
+        "an outward box says nothing: {:?}",
+        good.report.notes
+    );
+    let turned = inward(&text("box.step"));
+    assert_ne!(turned, text("box.step"), "the senses were turned");
+    let s = solid_of("box.step inward", &turned);
+    let m = machining_mesh(&s, TOL, &CancelToken::new())
+        .unwrap_or_else(|e| panic!("an inward closed box is the same box: {e}"));
+    assert!(m.report.volume > 0.0);
+    assert!((m.report.volume - good.report.volume).abs() <= good.report.volume * 1e-9);
+    assert!(
+        m.report.notes.iter().any(|n| n.contains("inward") && n.contains("turned outward")),
+        "the turn is said: {:?}",
+        m.report.notes
+    );
+}
+
+#[test]
+fn the_fillet_fixture_meshes_at_the_app_chord() {
+    let s = solid_of("fillet_corner.step", &text("fillet_corner.step"));
+    let m = machining_mesh(&s, TOL, &CancelToken::new())
+        .unwrap_or_else(|e| panic!("fillet_corner.step at {TOL} mm: {e}"));
+    assert!(m.report.deviation.largest() <= TOL, "{:?}", m.report.deviation);
+    assert_eq!(m.report.open_sides, 0);
+    assert!(m.report.volume > 0.0);
+}
diff --git a/crates/kernel/tests/step_curve_guard.rs b/crates/kernel/tests/step_curve_guard.rs
new file mode 100644
index 000000000..e4d3f0686
--- /dev/null
+++ b/crates/kernel/tests/step_curve_guard.rs
@@ -0,0 +1,77 @@
+//! Pins the curve guard of the solidcore STEP reader (#917): an edge or a
+//! swept surface on a B-spline curve that breaks at a repeated interior knot,
+//! or that has a weight that is not positive, is refused by name before the
+//! topology is read; a repeated knot with no break still imports.
+//! Fixtures: the tracked box.step with one line or one plane swapped for a
+//! hand-written spline (ISO 10303-42 entities).
+
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::import_step;
+use solidcore::kernel::CancelToken;
+
+const SPLINE: &str = "B_SPLINE_CURVE_WITH_KNOTS('', 1, (#158, #200, #201, #159), .UNSPECIFIED., .F., .F., (2, 2, 2), (0.0, 0.5, 1.0), .UNSPECIFIED.)";
+const RATIONAL: &str = "(BOUNDED_CURVE() B_SPLINE_CURVE(1, (#158, #200, #201, #159), .UNSPECIFIED., .F., .F.) B_SPLINE_CURVE_WITH_KNOTS((2, 2, 2), (0.0, 0.5, 1.0), .UNSPECIFIED.) CURVE() GEOMETRIC_REPRESENTATION_ITEM() RATIONAL_B_SPLINE_CURVE((0.0, 0.0, 0.0, 0.0)) REPRESENTATION_ITEM(''))";
+
+/// box.step with edge curve #110 (or plane #85, as a swept surface) on
+/// `spline`; the two inner control points are at x `a` and `b`.
+fn fixture(spline: &str, swept: bool, a: f64, b: f64) -> Vec<u8> {
+    let mut text = include_str!("../../../testdata/models/box.step").replace("\r\n", "\n");
+    let end = "ENDSEC;\nEND-ISO";
+    if swept {
+        text = text.replace(
+            "#85 = PLANE('', #86);",
+            "#85 = SURFACE_OF_LINEAR_EXTRUSION('', #202, #128);",
+        );
+        text = text.replace(end, &format!("#202 = {spline};\n{end}"));
+    } else {
+        text = text.replace("#110 = LINE('', #111, #112);", &format!("#110 = {spline};"));
+    }
+    text.replace(
+        end,
+        &format!(
+            "#200 = CARTESIAN_POINT('', ({a:?}, 0.0, 0.0));\n#201 = CARTESIAN_POINT('', ({b:?}, 0.0, 0.0));\n{end}"
+        ),
+    )
+    .into_bytes()
+}
+
+fn refusal(bytes: &[u8]) -> String {
+    match import_step(&mut SolidcoreKernel::default(), bytes, &CancelToken::new()) {
+        Ok(_) => panic!("the file must be refused"),
+        Err(e) => e.to_string(),
+    }
+}
+
+#[test]
+fn an_edge_spline_that_breaks_at_a_repeated_knot_is_refused_by_name() {
+    let msg = refusal(&fixture(SPLINE, false, 0.3, 0.7));
+    for word in ["edge #", "curve #110", "knot 0.5", "repeats 2 times", "degree 1", "subdivision"] {
+        assert!(msg.contains(word), "{word:?} missing in: {msg}");
+    }
+}
+
+#[test]
+fn a_swept_surface_on_a_breaking_spline_is_refused_by_name() {
+    let msg = refusal(&fixture(SPLINE, true, 0.3, 0.7));
+    for word in ["swept surface #85", "curve #202", "knot 0.5", "subdivision"] {
+        assert!(msg.contains(word), "{word:?} missing in: {msg}");
+    }
+}
+
+#[test]
+fn a_spline_with_a_zero_weight_is_refused_by_name() {
+    let msg = refusal(&fixture(RATIONAL, false, 0.3, 0.7));
+    for word in ["edge #", "curve #110", "weight 0", "not positive", "subdivision"] {
+        assert!(msg.contains(word), "{word:?} missing in: {msg}");
+    }
+}
+
+#[test]
+fn a_repeated_knot_with_no_break_still_imports() {
+    let read = import_step(
+        &mut SolidcoreKernel::default(),
+        &fixture(SPLINE, false, 0.5, 0.5),
+        &CancelToken::new(),
+    );
+    assert!(read.is_ok(), "a continuous spline must import: {:?}", read.err());
+}
diff --git a/docs/decisions/917-kernel-parity.md b/docs/decisions/917-kernel-parity.md
new file mode 100644
index 000000000..9caf8d528
--- /dev/null
+++ b/docs/decisions/917-kernel-parity.md
@@ -0,0 +1,140 @@
+## #917 - kernel and geometry parity for the solidcore STEP path (PR B0)
+
+PR B0 holds the items of #917 that we can pin under the app. PR B (the
+switch of the app to solidcore) is stacked on it.
+
+### The coordinate snap (`camcraft_kernel::mesh_weld`)
+
+- **Decided.** Before the exact-position weld of the machining mesh, each
+  coordinate goes through one rule:
+  - The grid is 1e-3 mm (`SNAP_GRID_MM`). The window is 1e-9 mm
+    (`SNAP_WINDOW_MM`).
+  - `k = round(c / 1e-3)`, `g = k / 1000` (one IEEE 754 division).
+  - If `|c - g| <= 1e-9`, the coordinate becomes `g + 0.0`. Otherwise it
+    stays bit for bit. A coordinate that is not finite, or with
+    `|k| > 9e15`, stays.
+  - `+0.0` replaces `-0.0`. Equal inputs always give equal outputs.
+- **Degenerate facets.** A triangle whose corners snap or weld onto a
+  repeated vertex has no area. The weld drops it. The side count after
+  the weld (`sides`) then refuses the mesh with `NotWatertight` if the
+  drop opened a hole. No facet is moved past the window to close a gap.
+- **Why.** The evaluator gives 20.000000000000004 for a face at Z 20. The
+  app's flat-level and floor logic compares levels exactly, so a level
+  read off the mesh by one ulp gives a wrong floor. The window is far under
+  any machining tolerance (the smallest tolerance is a millionth of the
+  body), so the measured deviation stays true to 1e-9 mm.
+- **Dropped.** A snap to the 1e-6 grid (it would move true model values
+  such as 12.5000004). A relative window (a large part would move more).
+  A snap after the weld (two near copies of one vertex then weld
+  differently).
+- **Pinned by** `the_snap_takes_the_last_bit_noise_off_a_grid_value`,
+  `a_coordinate_outside_the_window_is_never_moved` (12.5 +/- 1e-6 stays)
+  and `the_bore_mesh_stands_on_its_exact_levels`.
+- **Test location.** The coordinator asked for the snap pins in
+  `crates/geometry/tests`. They are in `crates/kernel/tests` because the
+  snap is in the kernel's machining mesh, and `geometry::step` is not on
+  `main`. A geometry test would need a new dependency edge
+  (geometry -> kernel), which the law does not permit without a decision.
+- **Cost to change.** One function and two constants.
+
+### An inward solid is turned outward (`machining_mesh`)
+
+- **Decided.** A watertight, consistently wound mesh with a finite
+  negative volume has all its faces pointed inward. The mesh swaps the
+  second and third corner of each triangle, negates the volume and adds
+  the note "the solid's faces all pointed inward (volume -X mm^3); the
+  mesh is turned outward". A zero or NaN volume is still the `Volume`
+  refusal.
+- **Why.** Main's truck path turned such a solid outward too
+  (`step_outward.rs`). A closed shell with all senses turned over is the
+  same solid.
+- **Dropped.** A refusal (a legal file would be refused). Turning only
+  part of the faces (a mixed winding is already refused by `sides`).
+- **Pinned by** `an_inward_solid_is_turned_outward_and_said`.
+
+### A breaking edge or swept spline is refused by name (`step_curve_guard`)
+
+- **Decided.** Before the topology read, the reader scans each B-spline
+  curve that an `EDGE_CURVE` (through `SURFACE_CURVE`, `SEAM_CURVE`,
+  `INTERSECTION_CURVE`) or a swept surface
+  (`SURFACE_OF_LINEAR_EXTRUSION`, `SURFACE_OF_REVOLUTION`) uses. It refuses
+  a weight that is not positive. It refuses an interior knot whose
+  multiplicity is above the degree when the control polygon jumps there
+  by more than 1e-9 x max(1, |coordinate|). The message names the role
+  ("edge #N" or "swept surface #N"), the curve, the knot, the
+  multiplicity, the degree and the jump, and says that the curve needs a
+  subdivision.
+- **Why.** Such a curve is two curves in one entity (ISO 10303-42 permits
+  a multiplicity of degree + 1 only at the ends). solidcore evaluates it
+  as one continuous curve and the mesh then has a gap or a wrong edge. A
+  repeated knot with no jump is continuous and still imports.
+- **Dropped.** A split of the curve at the knot (it changes the model's
+  topology, which is the exporter's job).
+- **Pinned by** the four tests in `crates/kernel/tests/step_curve_guard.rs`.
+
+### Adaptive refinement of the deviation bound (`mesh_deviation`)
+
+- **Decided.**
+  - `measure_within` refines a sub-triangle until its bound is in the
+    tolerance, down to depth 12, with a budget of 2^21 new samples for
+    one plan (3 for each split). Past either cap the bound found so far
+    is the judged one. `measure` keeps depth 3.
+  - The bound of each sub-triangle also takes the minimum with
+    `dmax + longest side`. The distance to a surface is 1-Lipschitz, and
+    no point of a flat triangle is farther from a corner than its longest
+    side, so this is a true upper bound.
+- **Why.** The fillet fixture has a pole. A sliver at the pole spans the
+  full u range in parameters, so the parametric Hessian bound did not
+  shrink with a split. The bound was about 12 times the true deviation and
+  a good mesh was refused. The Lipschitz bound shrinks with each split.
+- **Dropped.** A depth cap only (it cannot stop a plan with many bad
+  triangles from taking a long time). A larger fixed depth for `measure`
+  (the bench timings would change).
+- **Pinned by** `the_fillet_fixture_meshes_at_the_app_chord`.
+
+#### Changed pins (`crates/kernel/tests/machining_mesh.rs`)
+
+The tighter bound proves plans that the old bound could not prove. Each
+fixture that we measured now meshes at its first plan:
+
+| Fixture | Tolerance (mm) | Judged bound (mm) | Replan |
+|---|---|---|---|
+| Solidcraft sample | 0.005 | 0.0049999913 | no (was yes) |
+| Solidcraft sample | 0.1 | 0.0999999405 | no (was yes) |
+| fillet_corner.step | 0.005 | 0.0049998025 | no (was refused) |
+
+- `solidcraft_sample_meshes_within_the_app_chord`:
+  - old: the notes contain "replanned";
+  - new: the notes do not contain "replanned" (the first plan is proven).
+- `solidcraft_sample_still_refuses_an_out_of_tolerance_mesh`:
+  - old: `coarse_01.largest() > 0.1` (the coarse 0.1 mm plan measured over
+    0.1 mm);
+  - new: `coarse_01.parametric > 0.1 && coarse_01.largest() <= 0.1` (the
+    parametric reading still over-reads; the certified bound proves the
+    plan).
+  - Kept: the coarse plan exceeds 0.005 mm; the 0.1 mm request passes with
+    a parametric reading over 0.1 mm; the spline bump on box.step is still
+    refused with `Deviation` at face 0.
+- The replan branch is still run by the bump case (replan, then refusal).
+  No tracked fixture now passes only after a replan.
+
+### Solid ranges in the mesh (`camcraft_geometry::geometry::mesh_solids`)
+
+- **Decided.** `Mesh` has a `solids` field: one facet range per closed
+  solid, empty for one soup. `Mesh::from_solids` refuses ranges that do
+  not tile the facets in order. `slice::slice_of(facets, ranges, z)` slices
+  each solid on its own and unites the sections when the whole soup meets
+  the plane non-manifold. A solid with a volume that is not positive keeps
+  the soup's refusal.
+- **Why.** A STEP file with solids that share a wall line (the AP214
+  sample) gives one soup in which the shared edges are used four times.
+  The union fallback (`closed_solids`) must refuse it, because it cannot
+  tell the solids apart. The importer knows the solids, so it keeps them.
+- **Dropped.** Radial pairing of the facets around a non-manifold edge
+  (a guess where the importer has the truth). One part for each solid in
+  the app (it changes the model tree that the user sees).
+- **Cost.** The literal `Mesh { facets }` no longer compiles; eight app
+  tests use `Mesh::from_facets`. A transform that builds a new mesh from
+  facets drops the ranges, which gives the old soup behaviour.
+- **Pinned by** the five tests in `crates/geometry/tests/mesh_solids.rs`.
+  The app reads the ranges in PR B.

From eae027d5531d03d66176556149edf7a86a0b9623 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Fri, 20 Nov 2026 01:29:51 +0100
Subject: [PATCH 2/2] fix(kernel): turn only a one-shell solid outward; judge
 the snap move

Review of #2843:
- The inward turn now needs one shell (mesh_weld::shells). A solid with
  a void and a negative volume stays the Volume refusal.
- The tolerance check adds SNAP_MOVE_MM (sqrt(3) * SNAP_WINDOW_MM) to the
  measured deviation.
- The decision file says the adaptive bound is one-sided.

Refs #917

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
