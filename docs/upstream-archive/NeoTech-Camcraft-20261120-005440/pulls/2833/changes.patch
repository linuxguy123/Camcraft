     if p.strategy == PocketStrategy::Zigzag {
         passes = super::pocket_zigzag::rest_passes(&plan.center, p.tiling_step(), p.climb)?;
@@ -245,6 +266,7 @@ pub fn rest_pocket(region: &Region, p: &PocketParams, rest: &RestParams) -> Resu
             joins: Vec::new(),
             hold_crossings: true,
