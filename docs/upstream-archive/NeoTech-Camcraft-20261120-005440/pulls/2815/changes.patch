         }
-        if self.stepover <= 0.0 {
+        if !self.strategy.steps_by_load() && self.stepover <= 0.0 {
             return Err(GenError::Invalid("stepover must be positive".into()));
         }
         // The diameter bound is the reach law of the strategies that
diff --git a/crates/motion/tests/machining3d.rs b/crates/motion/tests/machining3d.rs
index 52d8c4699..a6f4ae604 100644
--- a/crates/motion/tests/machining3d.rs
+++ b/crates/motion/tests/machining3d.rs
@@ -736,11 +736,9 @@ fn adaptive_refuses_what_the_law_refuses() {
     // Finiteness is strategy-blind, as it has always been.
     assert!(at(PocketStrategy::Zigzag, f64::NAN, 3.0).is_err());
     assert!(at(PocketStrategy::Adaptive, f64::NAN, 3.0).is_err());
-    // A non-positive stepover is nonsense under every strategy. The
-    // diameter bound is the reach law of the strategies the stepover
-    // spaces; under Adaptive the number never spaces a ring (the page
-    // hides it, #1512), so a stale wide value must not refuse the job.
-    assert!(at(PocketStrategy::Adaptive, 45.0, 0.0).is_err());
+    // Strategies spaced by stepover require a positive value within the
+    // tool diameter. Adaptive ignores this hidden field (#1547).
+    assert!(at(PocketStrategy::Zigzag, 45.0, 0.0).is_err());
     assert!(at(PocketStrategy::Adaptive, 45.0, 9.0).is_ok(), "stepover unread under Adaptive");
     assert!(at(PocketStrategy::Zigzag, 45.0, 9.0).is_err(), "over the D under Zigzag");
 }
diff --git a/crates/motion/tests/radial_step.rs b/crates/motion/tests/radial_step.rs
index 68c91429f..c1c4dd556 100644
--- a/crates/motion/tests/radial_step.rs
+++ b/crates/motion/tests/radial_step.rs
@@ -175,3 +175,35 @@ fn pocket3d_offset_rings_ignore_a_stale_wide_stepover() {
         other => panic!("Zigzag at 25 mm on an 8 mm tool must refuse, got {other:?}"),
     }
 }
+
+#[test]
+fn pocket3d_load_strategies_ignore_nonpositive_stepover() {
+    let slab = box_facets([0.0, 0.0, -20.0], [16.0, 12.0, -10.0]);
+    let region = camcraft_motion::geometry::slice::project(&slab, 64).unwrap();
+    for strategy in [PocketStrategy::Adaptive, PocketStrategy::OffsetRings] {
+        let mut params = p3(strategy, 3.0);
+        params.stepdown = 10.0;
+        let sane = pocket3d(&slab, &region, &params).unwrap();
+        assert!(!sane.moves.is_empty(), "{strategy:?} must generate moves");
+        for stepover in [0.0, -1.0] {
+            params.stepover = stepover;
+            let stale = pocket3d(&slab, &region, &params)
+                .unwrap_or_else(|err| panic!("{strategy:?}, stepover {stepover}: {err}"));
+            assert_eq!(sane.moves, stale.moves, "{strategy:?}, stepover {stepover}");
+        }
+    }
+}
+
+#[test]
+fn pocket3d_stepover_strategies_refuse_nonpositive_and_wide_stepover() {
+    let slab = box_facets([0.0, 0.0, -20.0], [16.0, 12.0, -10.0]);
+    let region = camcraft_motion::geometry::slice::project(&slab, 64).unwrap();
+    for strategy in [PocketStrategy::Zigzag, PocketStrategy::Waterline, PocketStrategy::Auto] {
+        for stepover in [0.0, -1.0, 25.0] {
+            match pocket3d(&slab, &region, &p3(strategy, stepover)) {
+                Err(GenError::Invalid(msg)) => assert!(msg.contains("stepover"), "{msg}"),
+                other => panic!("{strategy:?}, stepover {stepover} must refuse, got {other:?}"),
+            }
+        }
+    }
+}
