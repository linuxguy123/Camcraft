diff --git a/xtask/src/release.rs b/xtask/src/release.rs
new file mode 100644
index 00000000..4895c331
--- /dev/null
+++ b/xtask/src/release.rs
@@ -0,0 +1,380 @@
+//! `cargo xtask release --version X.Y.Z --no-tag`: the release cut's ten phases (preflight, gate,
+//! version bump, commit, release build, version check, signing, zip / packages, installer, summary),
+//! one implementation on Windows, macOS and Linux. Signing and the Inno Setup installer stay in
+//! scripts/sign.ps1 / installer.ps1 (Windows); macOS, Linux and FreeBSD hand off to package-*.sh.
+//! Provenance: our own release law (AGENTS.md "A cut goes PR review -> merge to main -> tag"), ported
+//! from scripts/release.ps1 (#749).
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+use crate::decisions::valid_version;
+use crate::exec::{self, git};
+use crate::release_bump as bump;
+use crate::release_pack::{self as pack, Os};
+
+pub const CO_AUTHOR: &str = "Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>";
+
+/// Parsed `release` options (release.ps1's switches, in kebab case).
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct ReleaseArgs {
+    pub version: String,
+    pub title: String,
+    pub no_tag: bool,
+    pub skip_gate: bool,
+    pub skip_build: bool,
+    pub installer: bool,
+    pub dry: bool,
+}
+
+pub fn parse(args: &[String]) -> Result<ReleaseArgs, String> {
+    let mut r = ReleaseArgs { title: "release".into(), ..ReleaseArgs::default() };
+    let mut it = args.iter();
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "--version" => r.version = it.next().cloned().ok_or("--version needs X.Y.Z")?,
+            "--title" => r.title = it.next().cloned().ok_or("--title needs a value")?,
+            "--no-tag" => r.no_tag = true,
+            "--skip-gate" => r.skip_gate = true,
+            "--skip-build" => r.skip_build = true,
+            "--installer" => r.installer = true,
+            "--dry-run" => r.dry = true,
+            s => return Err(format!("unknown release option '{s}'")),
+        }
+    }
+    if r.version.is_empty() {
+        return Err("release needs --version X.Y.Z".into());
+    }
+    Ok(r)
+}
+
+/// One cut: its options, the host and every line it printed (the tests read them back).
+pub struct Cut {
+    pub root: PathBuf,
+    pub a: ReleaseArgs,
+    pub os: Os,
+    pub out: Vec<String>,
+}
+
+impl Cut {
+    pub fn new(root: &Path, a: ReleaseArgs, os: Os) -> Cut {
+        Cut { root: root.to_path_buf(), a, os, out: Vec::new() }
+    }
+
+    fn say(&mut self, line: impl Into<String>) {
+        let line = line.into();
+        println!("{line}");
+        self.out.push(line);
+    }
+
+    fn banner(&mut self, n: u8, text: &str) {
+        self.say("");
+        self.say(format!("=== Phase {n}/10: {text} ==="));
+    }
+
+    /// Runs a command at the root (or `cwd`); a dry run prints it instead. Non-zero exit fails the cut.
+    fn run(&mut self, exe: &str, args: &[String], env: &[(&str, &Path)]) -> Result<(), String> {
+        let line = format!("{exe} {}", args.join(" "));
+        if self.a.dry {
+            self.say(format!("[dry-run] {line}"));
+            return Ok(());
+        }
+        self.say(format!("> {line}"));
+        let program = if exe == "cargo" { exec::cargo() } else { exe.to_string() };
+        let mut c = Command::new(program);
+        c.args(args).current_dir(&self.root).stdin(Stdio::null());
+        for (k, v) in env {
+            c.env(k, v);
+        }
+        let st = c.status().map_err(|e| format!("'{line}': {e}"))?;
+        match st.code() {
+            Some(0) => Ok(()),
+            code => Err(format!("'{line}' exited with {}", code.map_or("a signal".into(), |c| c.to_string()))),
+        }
+    }
+
+    fn powershell(&mut self, script: &str, rest: &[String]) -> Result<(), String> {
+        let path = self.root.join("scripts").join(script);
+        let mut a: Vec<String> = ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"].map(String::from).to_vec();
+        a.push(path.display().to_string());
+        a.extend(rest.iter().cloned());
+        self.run("powershell", &a, &[])
+    }
+
+    fn dist(&self) -> PathBuf {
+        self.root.join("dist")
+    }
+
+    /// All ten phases; `Err` is the refusal printed as `RELEASE FAILED`.
+    pub fn phases(&mut self) -> Result<(), String> {
+        let v = self.a.version.clone();
+        if !valid_version(&v) {
+            return Err(format!("--version must be X.Y.Z, got '{v}'"));
+        }
+        if self.a.installer && self.os != Os::Windows {
+            return Err(format!(
+                "--installer builds the Inno Setup installer (scripts/installer.ps1), Windows only; not on {}",
+                self.os.name()
+            ));
+        }
+        if self.os == Os::Other {
+            return Err(format!("no release packaging for {}: windows, linux, macos and freebsd only", self.os.name()));
+        }
+        if self.a.dry {
+            self.say("DRY RUN: nothing below changes state.");
+        }
+        self.preflight(&v)?;
+        self.gate()?;
+        self.bump(&v)?;
+        self.commit(&v)?;
+        self.build()?;
+        self.verify(&v)?;
+        self.sign()?;
+        self.package(&v)?;
+        self.installer(&v)?;
+        self.summary(&v)
+    }
+
+    fn preflight(&mut self, v: &str) -> Result<(), String> {
+        self.banner(1, "preflight");
+        let dirty = bump::unexpected_changes(&git(&self.root, &["status", "--porcelain"])?);
+        if dirty.is_empty() {
+            self.say("tree clean (ignoring release files)");
+        } else {
+            self.say("Unexpected changes:");
+            for d in &dirty {
+                self.say(format!("  {d}"));
+            }
+            if !self.a.dry {
+                return Err("working tree not clean".into());
+            }
+            self.say("[dry-run] would fail here");
+        }
+        let branch = git(&self.root, &["rev-parse", "--abbrev-ref", "HEAD"])?.trim().to_string();
+        // Branch/PR flow: the bump is committed on release/vX.Y.Z with --no-tag, never on main; main is
+        // branch-protected, so a tagging run (the legacy direct cut) has nowhere left to run.
+        if self.a.no_tag && branch == "main" {
+            return Err(format!("--no-tag runs on a release/v{v} branch, not on main"));
+        }
+        if !self.a.no_tag {
+            return Err(format!(
+                "main is branch-protected (PR only): cut on release/v{v} with --no-tag and tag main after the release PR merges"
+            ));
+        }
+        if !git(&self.root, &["tag", "--list", &format!("v{v}")])?.trim().is_empty() {
+            return Err(format!("tag v{v} already exists"));
+        }
+        let notes = std::fs::read_to_string(self.root.join("RELEASE_NOTES.md"))
+            .map_err(|e| format!("RELEASE_NOTES.md: {e}"))?;
+        let n = bump::check_notes(&notes, v)?;
+        self.say(format!("RELEASE_NOTES.md: {v} section ({n} lines) above the history"));
+        self.say(format!("tag v{v} is free"));
+        Ok(())
+    }
+
+    /// The release gate tier, run in this process (not as a nested `cargo xtask gate release`, which
+    /// would make cargo rebuild the xtask exe that is running - locked on Windows).
+    fn gate(&mut self) -> Result<(), String> {
+        self.banner(2, "gate");
+        if self.a.skip_gate {
+            self.say("skipped (--skip-gate)");
+            return Ok(());
+        }
+        self.say("cargo xtask gate release (in process)");
+        let mut run = exec::Run::new(&self.root, "release", self.a.dry)?;
+        run.plan(&crate::plan::release(&self.root))?;
+        if run.summary() != 0 {
+            return Err("the release gate failed (logs under gate-logs/)".into());
+        }
+        Ok(())
+    }
+
+    fn bump(&mut self, v: &str) -> Result<(), String> {
+        self.banner(3, "version bump");
+        let toml_path = self.root.join("Cargo.toml");
+        let toml = std::fs::read_to_string(&toml_path).map_err(|e| format!("Cargo.toml: {e}"))?;
+        let (old, new_toml) = bump::bump_toml(&toml, v)?;
+        self.say(format!("workspace version: {old} -> {v}"));
+        if self.a.dry {
+            self.say("[dry-run] would rewrite Cargo.toml version and the workspace packages in Cargo.lock");
+            self.say("[dry-run] cargo update -w -q");
+            self.say("[dry-run] would assert Cargo.lock diff touches only version lines");
+            return Ok(());
+        }
+        std::fs::write(&toml_path, new_toml).map_err(|e| format!("write Cargo.toml: {e}"))?;
+        let lock_path = self.root.join("Cargo.lock");
+        let lock = std::fs::read_to_string(&lock_path).map_err(|e| format!("Cargo.lock: {e}"))?;
+        let (new_lock, n) = bump::bump_lock(&lock, &old, v);
+        std::fs::write(&lock_path, new_lock).map_err(|e| format!("write Cargo.lock: {e}"))?;
+        self.say(format!("Cargo.lock: {n} workspace package(s) moved to {v}"));
+        self.run("cargo", &["update".into(), "-w".into(), "-q".into()], &[])?;
+        let lines = bump::lock_diff_versions_only(&git(&self.root, &["diff", "Cargo.lock"])?)?;
+        self.say(format!("Cargo.lock: {lines} version lines changed, nothing else"));
+        Ok(())
+    }
+
+    fn commit(&mut self, v: &str) -> Result<(), String> {
+        self.banner(4, "commit and tag");
+        let title = self.a.title.clone();
+        if self.a.dry {
+            self.say("[dry-run] git add Cargo.toml RELEASE_NOTES.md TESTING.md RECOMMENDED.md (if changed)");
+            self.say(format!("[dry-run] git commit -m 'chore(release): {v} - {title}' (+ Co-Authored-By)"));
+            self.say(format!("[dry-run] git add Cargo.lock; git commit -m 'chore(release): sync Cargo.lock to {v}'"));
+            self.say("[dry-run] no tag (--no-tag): tag main after the release PR merges");
+            return Ok(());
+        }
+        for f in ["Cargo.toml", "RELEASE_NOTES.md", "TESTING.md", "RECOMMENDED.md"] {
+            if !git(&self.root, &["status", "--porcelain", "--", f])?.trim().is_empty() {
+                git(&self.root, &["add", "--", f])?;
+            }
+        }
+        let s = |x: &str| x.to_string();
+        self.run("git", &[s("commit"), s("-m"), format!("chore(release): {v} - {title}\n\n{CO_AUTHOR}")], &[])?;
+        self.run("git", &[s("add"), s("Cargo.lock")], &[])?;
+        self.run("git", &[s("commit"), s("-m"), format!("chore(release): sync Cargo.lock to {v}\n\n{CO_AUTHOR}")], &[])?;
+        self.say("no tag (--no-tag): tag main after the release PR merges");
+        Ok(())
+    }
+
+    fn build(&mut self) -> Result<(), String> {
+        self.banner(5, "release build");
+        if self.a.skip_build {
+            self.say("skipped (--skip-build)");
+            return Ok(());
+        }
+        for args in pack::build_steps(self.os) {
+            self.run("cargo", &args, &[])?;
+        }
+        Ok(())
+    }
+
+    fn verify(&mut self, v: &str) -> Result<(), String> {
+        let post = pack::bin_dir(&self.root, self.os).join(format!("post{}", self.os.exe()));
+        self.banner(6, &format!("verify post{} version", self.os.exe()));
+        if self.a.dry {
+            self.say(format!("[dry-run] {} --version must report {v}", post.display()));
+            return Ok(());
+        }
+        if !post.is_file() {
+            return Err(format!("{} missing (run without --skip-build)", post.display()));
+        }
+        let out = Command::new(&post).arg("--version").output().map_err(|e| format!("{}: {e}", post.display()))?;
+        if !out.status.success() {
+            return Err(format!("{} --version failed", post.display()));
+        }
+        let text = String::from_utf8_lossy(&out.stdout).into_owned();
+        let reported = text.split_whitespace().nth(1).unwrap_or_default().to_string();
+        if reported != v {
+            return Err(format!("post reports '{reported}', expected {v}"));
+        }
+        self.say(format!("post reports {reported}"));
+        Ok(())
+    }
+
+    /// Before staging, so the zip and the installer carry the same signed exes. sign.ps1 is a named
+    /// no-op without a CAMCRAFT_SIGN_* certificate: an unsigned cut is still a cut.
+    fn sign(&mut self) -> Result<(), String> {
+        self.banner(7, "sign binaries");
+        if self.os != Os::Windows {
+            self.say(format!(
+                "skipped on {}: sign.ps1 is Windows Authenticode (package-macos.sh codesigns its own bundle)",
+                self.os.name()
+            ));
+            return Ok(());
+        }
+        let bin = pack::bin_dir(&self.root, self.os);
+        let exes: Vec<String> = pack::EXES.iter().map(|e| bin.join(format!("{e}.exe")).display().to_string()).collect();
+        if self.a.skip_build && !self.a.dry && !exes.first().is_some_and(|e| Path::new(e).is_file()) {
+            self.say("skipped (no release exes; --skip-build)");
+            return Ok(());
+        }
+        let mut rest = vec!["-Path".to_string()];
+        rest.extend(exes);
+        self.powershell("sign.ps1", &rest)
+    }
+
+    fn package(&mut self, v: &str) -> Result<(), String> {
+        let bin = pack::bin_dir(&self.root, self.os);
+        let Some(script) = self.os.packager() else {
+            self.banner(8, "assemble zip");
+            let stage = self.dist().join(pack::stage_name(v));
+            let zip = self.dist().join(format!("{}.zip", pack::stage_name(v)));
+            let list = pack::stage_list(&self.root, &bin, self.os)?;
+            if self.a.dry {
+                let roots = "exes (camcraft-ui, camcraft-cli, post), assets/{posts,machines,ui,scripts,themes}, RELEASE_NOTES.md, TESTING.md, LICENSE, NOTICE";
+                self.say(format!("[dry-run] stage {} : {roots} ({} files)", stage.display(), list.len()));
+            } else {
+                let n = pack::stage(&list, &stage)?;
+                self.say(format!("staged {n} files in {}", stage.display()));
+            }
+            let cmd = format!(
+                "Compress-Archive -Path '{}' -DestinationPath '{}' -Force",
+                stage.display().to_string().replace('\'', "''"),
+                zip.display().to_string().replace('\'', "''")
+            );
+            return self.run("powershell", &["-NoProfile".into(), "-Command".into(), cmd], &[]);
+        };
+        self.banner(8, &format!("package ({script})"));
+        let bash_args = [self.root.join(script).display().to_string()];
+        self.run("bash", &bash_args, &[("CAMCRAFT_BIN_DIR", &bin)])
+    }
+
+    /// Opt-in, Windows only (refused by name elsewhere before phase 1): the same staged tree as the zip.
+    fn installer(&mut self, v: &str) -> Result<(), String> {
+        self.banner(9, "installer");
+        let setup = self.dist().join(format!("{}-setup.exe", pack::stage_name(v)));
+        if !self.a.installer {
+            let why = if self.os == Os::Windows {
+                format!("pass --installer to build {} with Inno Setup", pack::stage_name(v) + "-setup.exe")
+            } else {
+                "the Inno Setup installer is Windows only".into()
+            };
+            self.say(format!("skipped ({why})"));
+            return Ok(());
+        }
+        let stage = self.dist().join(pack::stage_name(v)).display().to_string();
+        let dist = self.dist().display().to_string();
+        let rest = ["-Version".to_string(), v.to_string(), "-Stage".into(), stage, "-OutDir".into(), dist];
+        self.powershell("installer.ps1", &rest)?;
+        // installer.ps1 signs the setup exe and its embedded uninstaller through ISCC's SignTool when a
+        // certificate is configured (sign.ps1 decides): no separate signing pass here.
+        if self.a.dry {
+            self.say("[dry-run] installer.ps1 signs setup + uninstaller via ISCC SignTool if CAMCRAFT_SIGN_* is set");
+        } else if !setup.is_file() {
+            self.say("no installer produced (ISCC.exe missing); the zip is the release");
+        }
+        Ok(())
+    }
+
+    fn summary(&mut self, v: &str) -> Result<(), String> {
+        self.banner(10, "done");
+        if self.os == Os::Windows {
+            let zip = self.dist().join(format!("{}.zip", pack::stage_name(v)));
+            self.say(format!("Zip: {}", zip.display()));
+            let setup = self.dist().join(format!("{}-setup.exe", pack::stage_name(v)));
+            if self.a.installer && setup.is_file() {
+                self.say(format!("Installer: {}", setup.display()));
+            }
+        } else {
+            self.say(format!("Packages: {}", self.dist().display()));
+        }
+        let branch = git(&self.root, &["rev-parse", "--abbrev-ref", "HEAD"])?.trim().to_string();
+        self.say(format!("Next: git push -u origin {branch}; gh pr create --base main --title 'chore(release): {v}'"));
+        self.say(format!("      record tip=$(git rev-parse {branch}) before merging; after it merges: git switch main; git pull --ff-only;"));
+        self.say(format!("      git diff $tip main must be empty, then git tag -a v{v} -m 'CamCraft {v}' main; git push origin v{v}"));
+        self.say("NOTHING WAS PUSHED. Pushing is left to you.");
+        Ok(())
+    }
+}
+
+/// `cargo xtask release`: the exit code (0 done, 1 refused or failed).
+pub fn release(root: &Path, a: ReleaseArgs) -> i32 {
+    let mut cut = Cut::new(root, a, Os::host());
+    match cut.phases() {
+        Ok(()) => 0,
+        Err(e) => {
+            cut.say(format!("RELEASE FAILED: {e}"));
+            1
+        }
+    }
+}
diff --git a/xtask/src/release_bump.rs b/xtask/src/release_bump.rs
new file mode 100644
index 00000000..5690ff3c
--- /dev/null
+++ b/xtask/src/release_bump.rs
@@ -0,0 +1,103 @@
+//! The text edits and checks of a release cut: the RELEASE_NOTES.md section check, the workspace
+//! version bump in Cargo.toml and Cargo.lock, the Cargo.lock diff guard and the preflight's dirty-tree
+//! filter. Pure functions on text, so the unit tests pin them on fixtures.
+//! Provenance: our own release law (AGENTS.md "Commits and Releases", #272), ported from
+//! scripts/release.ps1 phases 1 and 3 (#749); Cargo.lock's format per the Cargo book ("Cargo.lock").
+
+use crate::scan::re;
+
+/// Files a cut may find changed before it starts: it commits them itself.
+pub const ALLOWED_DIRTY: &[&str] = &["RELEASE_NOTES.md", "TESTING.md", "Cargo.toml", "Cargo.lock", "RECOMMENDED.md"];
+
+/// The paths `git status --porcelain` reports that a cut does not commit itself.
+pub fn unexpected_changes(porcelain: &str) -> Vec<String> {
+    porcelain
+        .lines()
+        .filter(|l| l.len() > 3)
+        .map(|l| l.get(3..).unwrap_or_default().trim_matches('"').to_string())
+        .filter(|p| !ALLOWED_DIRTY.contains(&p.as_str()))
+        .collect()
+}
+
+/// RELEASE_NOTES.md keeps every release, newest first; release.yml's publish job takes everything
+/// before the first `---` line as this version's notes. The section must be there, be this version's
+/// and not be empty (#272). The section's line count on success.
+pub fn check_notes(text: &str, version: &str) -> Result<usize, String> {
+    let lines: Vec<&str> = text.lines().map(str::trim_end).collect();
+    let end = lines.iter().position(|l| *l == "---").ok_or_else(|| {
+        "RELEASE_NOTES.md has no '---' line: put this version's section on top of the history, separated by '---'"
+            .to_string()
+    })?;
+    if end <= 1 {
+        return Err(format!("RELEASE_NOTES.md has no notes for {version} before its first '---'"));
+    }
+    let head = lines.first().map(|h| h.trim_start_matches('\u{feff}')).unwrap_or_default();
+    if !head.contains(version) {
+        return Err(format!("RELEASE_NOTES.md's first section is '{head}', not {version}"));
+    }
+    if lines.get(1..end).unwrap_or_default().join("\n").trim().is_empty() {
+        return Err(format!("RELEASE_NOTES.md's {version} section is empty"));
+    }
+    Ok(end - 1)
+}
+
+/// `[workspace.package] version = "..."` set to `new`: (old version, new text). Everything else in the
+/// manifest is kept byte for byte.
+pub fn bump_toml(text: &str, new: &str) -> Result<(String, String), String> {
+    let r = re(r#"(?s)(\[workspace\.package\].*?\r?\nversion\s*=\s*")([^"]+)(")"#)?;
+    let m = r
+        .captures(text)
+        .and_then(|c| c.get(2))
+        .ok_or_else(|| "no version in [workspace.package]".to_string())?;
+    let (head, tail) = (text.get(..m.start()), text.get(m.end()..));
+    let (head, tail) = head.zip(tail).ok_or_else(|| "version span off a char boundary".to_string())?;
+    Ok((m.as_str().to_string(), format!("{head}{new}{tail}")))
+}
+
+/// Every `[[package]]` of Cargo.lock without a `source` line (a workspace path package) at version
+/// `old` moved to `new`: (new text, packages changed). Registry and git packages are never touched,
+/// whatever their version. `cargo update -w` afterwards finds nothing left to do.
+pub fn bump_lock(text: &str, old: &str, new: &str) -> (String, usize) {
+    let from = format!("version = \"{old}\"");
+    let to = format!("version = \"{new}\"");
+    let mut blocks: Vec<Vec<&str>> = vec![Vec::new()];
+    for line in text.split_inclusive('\n') {
+        if line.trim_end() == "[[package]]" {
+            blocks.push(Vec::new());
+        }
+        if let Some(b) = blocks.last_mut() {
+            b.push(line);
+        }
+    }
+    let (mut out, mut n) = (String::with_capacity(text.len()), 0);
+    for (i, block) in blocks.iter().enumerate() {
+        let local = i > 0 && !block.iter().any(|l| l.starts_with("source = "));
+        for line in block {
+            if local && line.trim_end() == from {
+                out.push_str(&line.replacen(&from, &to, 1));
+                n += 1;
+            } else {
+                out.push_str(line);
+            }
+        }
+    }
+    (out, n)
+}
+
+/// `git diff Cargo.lock` after the bump may change version lines only: the number changed, or the
+/// refusal.
+pub fn lock_diff_versions_only(diff: &str) -> Result<usize, String> {
+    let changed = diff
+        .lines()
+        .filter(|l| {
+            let mut c = l.chars();
+            matches!(c.next(), Some('-' | '+')) && !matches!(c.next(), None | Some('-' | '+'))
+        })
+        .count();
+    let versions = diff.lines().filter(|l| l.starts_with("-version") || l.starts_with("+version")).count();
+    if changed == versions {
+        Ok(versions)
+    } else {
+        Err("Cargo.lock changed beyond version lines".into())
+    }
+}
diff --git a/xtask/src/release_pack.rs b/xtask/src/release_pack.rs
new file mode 100644
index 00000000..8b343f8f
--- /dev/null
+++ b/xtask/src/release_pack.rs
@@ -0,0 +1,162 @@
+//! What a release cut builds and ships per OS: the product packages, the binaries' dir, the portable
+//! zip's staged tree (the same layout as .github/workflows/release.yml's Windows job) and the
+//! packaging script each OS hands off to.
+//! Provenance: our own release law (AGENTS.md "Commits and Releases"), ported from scripts/release.ps1
+//! phases 5-8 and release.yml's staging (#749).
+
+use std::path::{Path, PathBuf};
+
+/// The host a cut runs on: decides the exe suffix, signing, the zip and the packager.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Os {
+    Windows,
+    Linux,
+    Macos,
+    FreeBsd,
+    Other,
+}
+
+impl Os {
+    pub fn host() -> Os {
+        match std::env::consts::OS {
+            "windows" => Os::Windows,
+            "linux" => Os::Linux,
+            "macos" => Os::Macos,
+            "freebsd" => Os::FreeBsd,
+            _ => Os::Other,
+        }
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            Os::Windows => "windows",
+            Os::Linux => "linux",
+            Os::Macos => "macos",
+            Os::FreeBsd => "freebsd",
+            Os::Other => std::env::consts::OS,
+        }
+    }
+    pub fn exe(self) -> &'static str {
+        if self == Os::Windows { ".exe" } else { "" }
+    }
+    /// The script that packages this OS's release, as release.yml runs it (AppImage, snap and flatpak
+    /// need CI-only tooling and stay in release.yml). Windows packs its zip here, in Rust.
+    pub fn packager(self) -> Option<&'static str> {
+        match self {
+            Os::Linux => Some("scripts/package-linux.sh"),
+            Os::Macos => Some("scripts/package-macos.sh"),
+            Os::FreeBsd => Some("scripts/package-freebsd.sh"),
+            Os::Windows | Os::Other => None,
+        }
+    }
+}
+
+/// The shipped executables (names without the OS suffix).
+pub const EXES: &[&str] = &["camcraft-ui", "camcraft-cli", "post"];
+/// The packages the release build compiles - the product only, as release.yml does. Never `xtask`:
+/// on Windows the running xtask.exe is locked, and rebuilding it mid-cut fails the build.
+pub const PRODUCT: &[&str] = &["camcraft-ui", "camcraft-app", "camcraft-post"];
+/// Asset dirs copied beside the executables, whole.
+pub const ASSET_DIRS: &[&str] = &["assets/posts", "assets/machines", "assets/ui", "assets/scripts", "assets/themes"];
+/// Top-level files copied beside the executables (release.yml ships NOTICE too).
+pub const DOCS: &[&str] = &["RELEASE_NOTES.md", "TESTING.md", "LICENSE", "NOTICE"];
+
+/// The macOS triple of this host's architecture; the universal build makes both.
+pub fn mac_triple() -> &'static str {
+    if std::env::consts::ARCH == "aarch64" { "aarch64-apple-darwin" } else { "x86_64-apple-darwin" }
+}
+
+/// cargo's target dir: CARGO_TARGET_DIR (relative to the workspace root) when set, else `target`.
+pub fn target_dir(root: &Path) -> PathBuf {
+    match std::env::var_os("CARGO_TARGET_DIR").filter(|v| !v.is_empty()) {
+        Some(v) => root.join(v),
+        None => root.join("target"),
+    }
+}
+
+/// Where the release build leaves this host's executables.
+pub fn bin_dir(root: &Path, os: Os) -> PathBuf {
+    let t = target_dir(root);
+    if os == Os::Macos { t.join(mac_triple()).join("release") } else { t.join("release") }
+}
+
+/// The cargo argument lists of the release build: the product packages, one build per target (macOS
+/// builds both architectures for the universal app, as release.yml does).
+pub fn build_steps(os: Os) -> Vec<Vec<String>> {
+    let base = |target: Option<&str>| {
+        let mut a: Vec<String> = ["build", "-j", "6", "--release"].iter().map(|s| (*s).to_string()).collect();
+        if let Some(t) = target {
+            a.push("--target".into());
+            a.push(t.into());
+        }
+        for p in PRODUCT {
+            a.push("-p".into());
+            a.push((*p).into());
+        }
+        a
+    };
+    if os == Os::Macos {
+        vec![base(Some("aarch64-apple-darwin")), base(Some("x86_64-apple-darwin"))]
+    } else {
+        vec![base(None)]
+    }
+}
+
+/// The Windows zip's stage dir name; the zip and the installer are named after it.
+pub fn stage_name(version: &str) -> String {
+    format!("camcraft-{version}-win-x64")
+}
+
+fn files_under(dir: &Path, out: &mut Vec<PathBuf>) -> Result<(), String> {
+    let rd = std::fs::read_dir(dir).map_err(|e| format!("{}: {e} (nothing to stage)", dir.display()))?;
+    let mut entries: Vec<PathBuf> = rd.filter_map(Result::ok).map(|e| e.path()).collect();
+    entries.sort();
+    for p in entries {
+        if p.is_dir() {
+            files_under(&p, out)?;
+        } else {
+            out.push(p);
+        }
+    }
+    Ok(())
+}
+
+/// Every file of the staged tree: (source, path inside the stage). The executables come from `bin`
+/// (they need not exist yet: a dry run lists them all the same); the assets and docs from `root`.
+pub fn stage_list(root: &Path, bin: &Path, os: Os) -> Result<Vec<(PathBuf, PathBuf)>, String> {
+    let mut list = Vec::new();
+    for e in EXES {
+        let name = format!("{e}{}", os.exe());
+        list.push((bin.join(&name), PathBuf::from(name)));
+    }
+    for d in ASSET_DIRS {
+        let mut files = Vec::new();
+        files_under(&root.join(d), &mut files)?;
+        for f in files {
+            let rel = f.strip_prefix(root).map_err(|e| format!("{}: {e}", f.display()))?.to_path_buf();
+            list.push((f, rel));
+        }
+    }
+    for d in DOCS {
+        let p = root.join(d);
+        if !p.is_file() {
+            return Err(format!("{d} missing: nothing to stage"));
+        }
+        list.push((p, PathBuf::from(d)));
+    }
+    Ok(list)
+}
+
+/// Builds the stage dir afresh from the list; the number of files copied.
+pub fn stage(list: &[(PathBuf, PathBuf)], dir: &Path) -> Result<usize, String> {
+    if dir.exists() {
+        std::fs::remove_dir_all(dir).map_err(|e| format!("remove {}: {e}", dir.display()))?;
+    }
+    for (src, rel) in list {
+        let dst = dir.join(rel);
+        if let Some(parent) = dst.parent() {
+            std::fs::create_dir_all(parent).map_err(|e| format!("create {}: {e}", parent.display()))?;
+        }
+        std::fs::copy(src, &dst).map_err(|e| format!("copy {} -> {}: {e}", src.display(), dst.display()))?;
+    }
+    Ok(list.len())
+}
diff --git a/xtask/src/release_tests.rs b/xtask/src/release_tests.rs
new file mode 100644
index 00000000..c968ab83
--- /dev/null
+++ b/xtask/src/release_tests.rs
@@ -0,0 +1,238 @@
+//! Pins the release cut: the version bump on Cargo.toml / Cargo.lock fixture text, the Cargo.lock diff
+//! guard, the RELEASE_NOTES.md check, the staged zip layout, and the dry run's phase list on a
+//! throwaway git repo.
+//! Provenance: our own release law (AGENTS.md "Commits and Releases"), #749.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use crate::release::{Cut, ReleaseArgs, parse};
+use crate::release_bump::{bump_lock, bump_toml, check_notes, lock_diff_versions_only, unexpected_changes};
+use crate::release_pack::{self as pack, Os};
+
+struct Repo(PathBuf);
+
+impl Drop for Repo {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn write(root: &Path, rel: &str, text: &str) {
+    let p = root.join(rel);
+    if let Some(d) = p.parent() {
+        std::fs::create_dir_all(d).expect("fixture dir");
+    }
+    std::fs::write(p, text).expect("fixture file");
+}
+
+fn git(root: &Path, args: &[&str]) {
+    let st = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(["-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false"])
+        .args(args)
+        .output()
+        .expect("git runs");
+    assert!(st.status.success(), "git {args:?}: {}", String::from_utf8_lossy(&st.stderr));
+}
+
+const TOML: &str = "[workspace]\nmembers = [\"a\"]\n\n[workspace.package]\nversion = \"0.16.0\"\nedition = \"2024\"\n\n[workspace.dependencies]\nregex = { version = \"1\" }\n";
+const LOCK: &str = "# auto\nversion = 4\n\n[[package]]\nname = \"camcraft-app\"\nversion = \"0.16.0\"\ndependencies = [\n \"regex\",\n]\n\n[[package]]\nname = \"other\"\nversion = \"0.16.0\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"ab\"\n\n[[package]]\nname = \"xtask\"\nversion = \"0.16.0\"\n";
+
+/// A fixture workspace: manifest, lock, notes for `version`, the shipped assets and docs.
+fn repo(branch: &str, version: &str) -> Repo {
+    static N: AtomicUsize = AtomicUsize::new(0);
+    let root = std::env::temp_dir().join(format!(
+        "xtask-release-{}-{}",
+        std::process::id(),
+        N.fetch_add(1, Ordering::SeqCst)
+    ));
+    let _ = std::fs::remove_dir_all(&root);
+    write(&root, "Cargo.toml", TOML);
+    write(&root, "Cargo.lock", LOCK);
+    write(&root, "RELEASE_NOTES.md", &format!("# CamCraft {version}\n\nnew things\n\n---\n\n# CamCraft 0.16.0\n"));
+    for f in [
+        "assets/posts/fanuc.cps",
+        "assets/machines/vmc.json",
+        "assets/ui/cube.png",
+        "assets/ui/fonts/sans.ttf",
+        "assets/scripts/job.js",
+        "assets/themes/dark.json",
+        "TESTING.md",
+        "LICENSE",
+        "NOTICE",
+    ] {
+        write(&root, f, "x");
+    }
+    git(&root, &["init", "-q", "-b", branch]);
+    git(&root, &["add", "-A"]);
+    git(&root, &["commit", "-q", "-m", "fixture"]);
+    Repo(root)
+}
+
+fn args(version: &str) -> ReleaseArgs {
+    ReleaseArgs { version: version.into(), title: "release".into(), no_tag: true, dry: true, ..ReleaseArgs::default() }
+}
+
+fn banners(cut: &Cut) -> Vec<String> {
+    cut.out.iter().filter(|l| l.starts_with("=== ")).cloned().collect()
+}
+
+#[test]
+fn bump_toml_moves_only_the_workspace_version() {
+    let (old, new) = bump_toml(TOML, "0.17.0").expect("bump");
+    assert_eq!(old, "0.16.0");
+    assert_eq!(new, TOML.replace("version = \"0.16.0\"", "version = \"0.17.0\""));
+    assert!(new.contains("regex = { version = \"1\" }"));
+    let crlf = TOML.replace('\n', "\r\n");
+    let (_, new) = bump_toml(&crlf, "0.17.0").expect("crlf bump");
+    assert!(new.contains("[workspace.package]\r\nversion = \"0.17.0\"\r\n"));
+    assert!(bump_toml("[package]\nversion = \"1.0.0\"\n", "2.0.0").is_err());
+}
+
+#[test]
+fn bump_lock_moves_workspace_packages_not_registry_ones() {
+    let (new, n) = bump_lock(LOCK, "0.16.0", "0.17.0");
+    assert_eq!(n, 2, "camcraft-app and xtask");
+    assert!(new.contains("name = \"camcraft-app\"\nversion = \"0.17.0\"\n"));
+    assert!(new.contains("name = \"xtask\"\nversion = \"0.17.0\"\n"));
+    assert!(new.contains("name = \"other\"\nversion = \"0.16.0\"\nsource"), "registry package untouched");
+    assert!(new.starts_with("# auto\nversion = 4\n"), "the lock format version is not a package version");
+    let (crlf, n) = bump_lock(&LOCK.replace('\n', "\r\n"), "0.16.0", "0.17.0");
+    assert_eq!(n, 2);
+    assert!(crlf.contains("name = \"xtask\"\r\nversion = \"0.17.0\"\r\n"));
+}
+
+#[test]
+fn lock_diff_guard_takes_version_lines_only() {
+    let ok = "--- a/Cargo.lock\n+++ b/Cargo.lock\n@@ -1 +1 @@\n-version = \"0.16.0\"\n+version = \"0.17.0\"\n \n";
+    assert_eq!(lock_diff_versions_only(ok), Ok(2));
+    let bad = format!("{ok}-checksum = \"a\"\n+checksum = \"b\"\n");
+    assert!(lock_diff_versions_only(&bad).is_err());
+}
+
+#[test]
+fn notes_need_this_versions_section_above_the_history() {
+    assert_eq!(check_notes("\u{feff}# CamCraft 0.17.0\n\nnew\n---\nold\n", "0.17.0"), Ok(2));
+    assert!(check_notes("# CamCraft 0.17.0\nnew\n", "0.17.0").expect_err("no ---").contains("no '---'"));
+    assert!(check_notes("# CamCraft 0.17.0\n---\n", "0.17.0").expect_err("none").contains("no notes"));
+    assert!(check_notes("# CamCraft 0.16.0\nx\n---\n", "0.17.0").expect_err("wrong").contains("not 0.17.0"));
+    assert!(check_notes("# CamCraft 0.17.0\n \n\n---\n", "0.17.0").expect_err("empty").contains("empty"));
+}
+
+#[test]
+fn preflight_ignores_the_files_the_cut_commits() {
+    let st = " M Cargo.toml\n M RELEASE_NOTES.md\n?? tmp/\n M \"odd name.rs\"\n";
+    assert_eq!(unexpected_changes(st), vec!["tmp/".to_string(), "odd name.rs".to_string()]);
+}
+
+#[test]
+fn zip_layout_mirrors_release_yml() {
+    let r = repo("release/v0.17.0", "0.17.0");
+    let bin = r.0.join("bin");
+    let list = pack::stage_list(&r.0, &bin, Os::Windows).expect("stage list");
+    let rel: Vec<String> = list.iter().map(|(_, p)| p.to_string_lossy().replace('\\', "/")).collect();
+    assert_eq!(
+        rel,
+        [
+            "camcraft-ui.exe",
+            "camcraft-cli.exe",
+            "post.exe",
+            "assets/posts/fanuc.cps",
+            "assets/machines/vmc.json",
+            "assets/ui/cube.png",
+            "assets/ui/fonts/sans.ttf",
+            "assets/scripts/job.js",
+            "assets/themes/dark.json",
+            "RELEASE_NOTES.md",
+            "TESTING.md",
+            "LICENSE",
+            "NOTICE",
+        ]
+    );
+    assert_eq!(list[0].0, bin.join("camcraft-ui.exe"));
+    let linux = pack::stage_list(&r.0, &bin, Os::Linux).expect("linux list");
+    assert_eq!(linux[2].1, PathBuf::from("post"), "no .exe off Windows");
+    // Staging copies every listed file (fake exes stand in for the build).
+    for e in pack::EXES {
+        write(&bin, &format!("{e}.exe"), "exe");
+    }
+    let stage = r.0.join("dist").join(pack::stage_name("0.17.0"));
+    assert_eq!(pack::stage(&list, &stage), Ok(13));
+    assert!(stage.join("assets/ui/fonts/sans.ttf").is_file());
+    std::fs::remove_file(r.0.join("NOTICE")).expect("rm NOTICE");
+    assert!(pack::stage_list(&r.0, &bin, Os::Windows).expect_err("no NOTICE").contains("NOTICE"));
+}
+
+#[test]
+fn release_build_never_builds_xtask() {
+    for os in [Os::Windows, Os::Linux, Os::Macos, Os::FreeBsd] {
+        for step in pack::build_steps(os) {
+            assert!(!step.iter().any(|a| a == "xtask"), "{os:?}: {step:?}");
+            assert!(step.iter().any(|a| a == "-p"), "{os:?} builds named packages only");
+        }
+    }
+    assert_eq!(pack::build_steps(Os::Macos).len(), 2, "universal: both architectures");
+}
+
+#[test]
+fn parse_takes_release_ps1s_switches() {
+    let a: Vec<String> =
+        ["--version", "1.2.3", "--no-tag", "--skip-gate", "--skip-build", "--installer", "--dry-run", "--title", "T"]
+            .map(String::from)
+            .to_vec();
+    let r = parse(&a).expect("parse");
+    assert!(r.no_tag && r.skip_gate && r.skip_build && r.installer && r.dry);
+    assert_eq!((r.version.as_str(), r.title.as_str()), ("1.2.3", "T"));
+    assert!(parse(&["--no-tag".to_string()]).is_err(), "--version is required");
+    assert!(parse(&["--version".to_string(), "1.2.3".into(), "--tag".into()]).is_err());
+}
+
+#[test]
+fn dry_run_walks_the_ten_phases_and_changes_nothing() {
+    let r = repo("release/v9.9.9", "9.9.9");
+    let mut cut = Cut::new(&r.0, args("9.9.9"), Os::Windows);
+    assert_eq!(cut.phases(), Ok(()));
+    let phases = [
+        "preflight",
+        "gate",
+        "version bump",
+        "commit and tag",
+        "release build",
+        "verify post.exe version",
+        "sign binaries",
+        "assemble zip",
+        "installer",
+        "done",
+    ];
+    let want: Vec<String> =
+        phases.iter().enumerate().map(|(i, p)| format!("=== Phase {}/10: {p} ===", i + 1)).collect();
+    assert_eq!(banners(&cut), want);
+    assert!(cut.out.iter().any(|l| l == "workspace version: 0.16.0 -> 9.9.9"));
+    assert!(cut.out.iter().any(|l| l.starts_with("[dry-run] cargo build -j 6 --release -p camcraft-ui")));
+    assert_eq!(std::fs::read_to_string(r.0.join("Cargo.toml")).expect("toml"), TOML, "dry run wrote nothing");
+    assert!(!r.0.join("dist").exists());
+
+    let mut linux = Cut::new(&r.0, ReleaseArgs { skip_gate: true, ..args("9.9.9") }, Os::Linux);
+    assert_eq!(linux.phases(), Ok(()));
+    assert!(banners(&linux).contains(&"=== Phase 8/10: package (scripts/package-linux.sh) ===".to_string()));
+    assert!(linux.out.iter().any(|l| l == "skipped (--skip-gate)"));
+}
+
+#[test]
+fn refusals_are_named() {
+    let r = repo("main", "9.9.9");
+    let mut on_main = Cut::new(&r.0, args("9.9.9"), Os::Windows);
+    assert!(on_main.phases().expect_err("main").contains("not on main"));
+    let mut tagging = Cut::new(&r.0, ReleaseArgs { no_tag: false, ..args("9.9.9") }, Os::Windows);
+    assert!(tagging.phases().expect_err("tag").contains("branch-protected"));
+    let mut installer = Cut::new(&r.0, ReleaseArgs { installer: true, ..args("9.9.9") }, Os::Linux);
+    assert!(installer.phases().expect_err("installer").contains("Windows only"));
+    let mut bad = Cut::new(&r.0, args("9.9"), Os::Windows);
+    assert!(bad.phases().expect_err("version").contains("X.Y.Z"));
+    let rb = repo("release/v9.9.9", "9.9.8");
+    let mut notes = Cut::new(&rb.0, args("9.9.9"), Os::Windows);
+    assert!(notes.phases().expect_err("notes").contains("not 9.9.9"));
+}
