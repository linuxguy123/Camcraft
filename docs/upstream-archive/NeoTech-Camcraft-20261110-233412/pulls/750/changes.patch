index 00000000..60344e7a
--- /dev/null
+++ b/xtask/src/exec.rs
@@ -0,0 +1,168 @@
+//! Running a gate plan: one cargo command per step, its output to its own log under
+//! gate-logs/<tier>-<timestamp>/, pass/fail and failing suites read back from the log, then the summary.
+//! Provenance: our own build law (AGENTS.md "Three gate tiers"), ported from scripts/gate.ps1 (#748).
+
+use std::fs::File;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+use crate::plan::{Plan, Step};
+use crate::scan::re;
+
+pub struct Run {
+    pub root: PathBuf,
+    pub label: String,
+    pub dry: bool,
+    log_dir: PathBuf,
+    clock: Instant,
+    done: Vec<Done>,
+}
+
+struct Done {
+    name: String,
+    ok: bool,
+    secs: u64,
+    note: String,
+}
+
+/// The cargo that launched us (`cargo xtask` sets CARGO), else the one on PATH.
+pub fn cargo() -> String {
+    std::env::var("CARGO").unwrap_or_else(|_| "cargo".into())
+}
+
+/// `git -C root <args>`, stdout as text; `Err` when git fails.
+pub fn git(root: &Path, args: &[&str]) -> Result<String, String> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(args)
+        .output()
+        .map_err(|e| format!("git {}: {e}", args.join(" ")))?;
+    if !out.status.success() {
+        return Err(format!(
+            "git {} failed: {}",
+            args.join(" "),
+            String::from_utf8_lossy(&out.stderr).trim()
+        ));
+    }
+    Ok(String::from_utf8_lossy(&out.stdout).into_owned())
+}
+
+/// `yyyyMMdd-HHmmss` (UTC) for the log dir name.
+pub fn stamp(now: SystemTime) -> String {
+    let secs = now.duration_since(UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0);
+    let (days, rem) = ((secs / 86_400) as i64, secs % 86_400);
+    // Civil date from days since 1970-01-01 (H. Hinnant, "chrono-Compatible Low-Level Date Algorithms").
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1_460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = yoe + era * 400 + i64::from(m <= 2);
+    format!("{y:04}{m:02}{d:02}-{:02}{:02}{:02}", rem / 3600, rem % 3600 / 60, rem % 60)
+}
+
+/// A log file name: the step name with each run of non-word characters folded to `_`.
+pub fn log_name(n: usize, name: &str) -> String {
+    let mut s = String::new();
+    let mut gap = false;
+    for c in name.chars() {
+        if c.is_alphanumeric() || c == '_' || c == '-' {
+            s.push(c);
+            gap = false;
+        } else if !gap {
+            s.push('_');
+            gap = true;
+        }
+    }
+    format!("{n:02}-{s}.log")
+}
+
+impl Run {
+    pub fn new(root: &Path, label: &str, dry: bool) -> Result<Run, String> {
+        let log_dir = root.join("gate-logs").join(format!("{label}-{}", stamp(SystemTime::now())));
+        std::fs::create_dir_all(&log_dir).map_err(|e| format!("create {}: {e}", log_dir.display()))?;
+        Ok(Run { root: root.to_path_buf(), label: label.into(), dry, log_dir, clock: Instant::now(), done: Vec::new() })
+    }
+
+    pub fn plan(&mut self, plan: &Plan) -> Result<(), String> {
+        for n in &plan.notes {
+            println!("{n}");
+        }
+        for s in &plan.steps {
+            self.step(s)?;
+        }
+        Ok(())
+    }
+
+    fn step(&mut self, s: &Step) -> Result<(), String> {
+        let n = self.done.len() + 1;
+        let log = self.log_dir.join(log_name(n, &s.name));
+        let dir = if s.in_ui { self.root.join("crates").join("ui") } else { self.root.clone() };
+        let leaf = dir.file_name().map(|x| x.to_string_lossy().into_owned()).unwrap_or_default();
+        println!("[{n:02}] {}", s.name);
+        println!("     (cwd {leaf}) cargo {}", s.args.join(" "));
+        if self.dry {
+            self.done.push(Done { name: s.name.clone(), ok: true, secs: 0, note: "dry run".into() });
+            return Ok(());
+        }
+        let t0 = Instant::now();
+        let file = File::create(&log).map_err(|e| format!("create {}: {e}", log.display()))?;
+        let err = file.try_clone().map_err(|e| format!("log {}: {e}", log.display()))?;
+        let code = Command::new(cargo())
+            .args(&s.args)
+            .current_dir(&dir)
+            .stdin(Stdio::null())
+            .stdout(file)
+            .stderr(err)
+            .status()
+            .map(|st| st.code().unwrap_or(-1))
+            .map_err(|e| format!("cargo {}: {e}", s.args.join(" ")))?;
+        let secs = t0.elapsed().as_secs();
+        let note = read_log(&std::fs::read_to_string(&log).unwrap_or_default(), code)?;
+        let ok = code == 0;
+        println!("     {} in {secs}s {note}", if ok { "ok" } else { "FAIL" });
+        self.done.push(Done { name: s.name.clone(), ok, secs, note });
+        Ok(())
+    }
+
+    /// Prints the summary table; the process exit code (0 all passed, 1 any failed).
+    pub fn summary(self) -> i32 {
+        println!("\n== gate summary ({}) - logs in {}", self.label, self.log_dir.display());
+        for d in &self.done {
+            println!("  {:<4} {:>5}s  {}  {}", if d.ok { "ok" } else { "FAIL" }, d.secs, d.name, d.note);
+        }
+        let bad = self.done.iter().filter(|d| !d.ok).count();
+        let mins = self.clock.elapsed().as_secs_f64() / 60.0;
+        println!("  wall {mins:.1} min, {} step(s), {bad} failed", self.done.len());
+        i32::from(bad > 0)
+    }
+}
+
+/// The step's note from its log: a compile error, the suites that failed, or a bare exit code.
+pub fn read_log(text: &str, code: i32) -> Result<String, String> {
+    let running = re(r"^\s+Running (\S+)")?;
+    let (mut cur, mut fails, mut compile) = (String::new(), Vec::new(), false);
+    for l in text.lines() {
+        if let Some(c) = running.captures(l) {
+            cur = c[1].to_string();
+        } else if l.starts_with("test result: FAILED") {
+            fails.push(cur.clone());
+        } else if l.starts_with("error: could not compile") {
+            compile = true;
+        }
+    }
+    Ok(if compile {
+        "compile error".into()
+    } else if !fails.is_empty() {
+        format!("failed: {}", fails.join(", "))
+    } else if code != 0 {
+        format!("exit {code}")
+    } else {
+        String::new()
+    })
+}
diff --git a/xtask/src/main.rs b/xtask/src/main.rs
new file mode 100644
index 00000000..2259dd66
--- /dev/null
+++ b/xtask/src/main.rs
@@ -0,0 +1,162 @@
+//! `cargo xtask`: the workspace's process tooling, one implementation for Windows, macOS and Linux -
+//! the gate tiers (`gate quick|batch|release|test`) and the decision collection (`decisions`).
+//! Provenance: our own build and process law (AGENTS.md "Three gate tiers", "Test the change",
+//! release step 2), replacing the scripts/gate.* and collect-decisions.* twins (#748).
+
+mod decisions;
+mod exec;
+mod plan;
+mod quick;
+mod scan;
+mod single;
+#[cfg(test)]
+mod tests;
+
+use std::path::{Path, PathBuf};
+use std::process::ExitCode;
+
+const USAGE: &str = "\
+usage:
+  cargo xtask gate quick [--base main] [--heavy]   tests the diff touches (test fns where it can)
+  cargo xtask gate batch                           every debug suite minus SLOW_BINARIES, ui, clippy
+  cargo xtask gate release                         everything, plus the --ignored heavy lanes and the ui snapshot lane
+  cargo xtask gate test <filter> [--crate c] [--binary b] [--exact]   exactly the matching test(s)
+      any gate: --dry-run (or --plan) prints the plan without running it. Logs: gate-logs/<tier>-<timestamp>/.
+  cargo xtask decisions --version X.Y.Z            gather docs/decisions/*.md into RECOMMENDED.md";
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    match run(&args) {
+        Ok(code) => ExitCode::from(u8::try_from(code).unwrap_or(1)),
+        Err(e) => {
+            eprintln!("xtask: {e}");
+            ExitCode::from(2)
+        }
+    }
+}
+
+/// The workspace root: the parent of xtask/ (CARGO_MANIFEST_DIR at run time under `cargo xtask`, else
+/// where this binary was built from).
+fn root() -> PathBuf {
+    let manifest = std::env::var_os("CARGO_MANIFEST_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from(env!("CARGO_MANIFEST_DIR")));
+    manifest.parent().map(Path::to_path_buf).unwrap_or(manifest)
+}
+
+/// Parsed `gate` options.
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct GateArgs {
+    pub tier: String,
+    pub filter: Option<String>,
+    pub base: String,
+    pub krate: Option<String>,
+    pub binary: Option<String>,
+    pub exact: bool,
+    pub heavy: bool,
+    pub dry: bool,
+}
+
+pub fn parse_gate(args: &[String]) -> Result<GateArgs, String> {
+    let mut g = GateArgs { base: "main".into(), ..GateArgs::default() };
+    let mut it = args.iter();
+    let value = |flag: &str, it: &mut std::slice::Iter<String>| {
+        it.next().cloned().ok_or_else(|| format!("{flag} needs a value"))
+    };
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "--base" => g.base = value(a, &mut it)?,
+            "--crate" => g.krate = Some(value(a, &mut it)?),
+            "--binary" => g.binary = Some(value(a, &mut it)?),
+            "--exact" => g.exact = true,
+            "--heavy" => g.heavy = true,
+            "--dry-run" | "--plan" => g.dry = true,
+            s if s.starts_with('-') => return Err(format!("unknown gate option '{s}'\n{USAGE}")),
+            s if g.tier.is_empty() => g.tier = s.to_string(),
+            s if g.tier == "test" && g.filter.is_none() => g.filter = Some(s.to_string()),
+            s => return Err(format!("unexpected argument '{s}'\n{USAGE}")),
+        }
+    }
+    if g.tier.is_empty() {
+        g.tier = "quick".into();
+    }
+    match g.tier.as_str() {
+        "quick" | "batch" | "release" => Ok(g),
+        "test" => match &g.filter {
+            Some(f) if !f.is_empty() && f.chars().all(|c| c.is_alphanumeric() || c == '_') => Ok(g),
+            Some(f) => Err(format!("test filter must be a fn name (letters, digits, _): '{f}'")),
+            None => Err(format!("gate test needs a filter\n{USAGE}")),
+        },
+        t => Err(format!("unknown tier '{t}' (quick | batch | release | test)\n{USAGE}")),
+    }
+}
+
+fn run(args: &[String]) -> Result<i32, String> {
+    match args.first().map(String::as_str) {
+        Some("gate") => gate(&root(), &parse_gate(&args[1..])?),
+        Some("decisions") => {
+            let version = match args.get(1..) {
+                Some([flag, v]) if flag == "--version" => v.clone(),
+                Some([v]) if !v.starts_with('-') => v.clone(),
+                _ => return Err(format!("decisions needs --version X.Y.Z\n{USAGE}")),
+            };
+            println!("{}", decisions::collect(&root(), &version)?);
+            Ok(0)
+        }
+        Some("-h" | "--help" | "help") | None => {
+            println!("{USAGE}");
+            Ok(0)
+        }
+        Some(other) => Err(format!("unknown task '{other}'\n{USAGE}")),
+    }
+}
+
+fn gate(root: &Path, g: &GateArgs) -> Result<i32, String> {
+    let mut run = exec::Run::new(root, &g.tier, g.dry)?;
+    if let Some(name) = &g.filter {
+        let f = single::Filter { name, krate: g.krate.as_deref(), binary: g.binary.as_deref(), exact: g.exact };
+        match single::plan(root, &f) {
+            Ok(p) => run.plan(&p)?,
+            Err(e) => {
+                println!("{e}");
+                return Ok(1);
+            }
+        }
+        return Ok(run.summary());
+    }
+    let plan = match g.tier.as_str() {
+        "quick" => {
+            let mb = exec::git(root, &["merge-base", &g.base, "HEAD"])
+                .map(|s| s.trim().to_string())
+                .ok()
+                .filter(|s| !s.is_empty())
+                .ok_or_else(|| format!("no merge base with '{}'", g.base))?;
+            let lines = |s: String| -> Vec<String> {
+                s.lines().filter(|l| !l.is_empty()).map(|l| l.replace('\\', "/")).collect()
+            };
+            let untracked = lines(exec::git(root, &["ls-files", "--others", "--exclude-standard"])?);
+            let mut changed = lines(exec::git(root, &["diff", "--name-only", &mb])?);
+            changed.extend(untracked.iter().cloned());
+            let changed = plan::ps_sorted(changed);
+            let short: String = mb.chars().take(7).collect();
+            println!("changed since {} ({short}): {} file(s)", g.base, changed.len());
+            let hunks = |f: &str| -> Vec<String> {
+                exec::git(root, &["diff", "-U0", &mb, "--", f])
+                    .map(|s| s.lines().filter(|l| l.starts_with("@@ ")).map(String::from).collect())
+                    .unwrap_or_default()
+            };
+            let diff = quick::Diff { changed: &changed, untracked: &untracked, hunks: &hunks };
+            match quick::plan(root, &diff, g.heavy)? {
+                quick::Quick::Plan(p) => p,
+                quick::Quick::Batch(f) => {
+                    println!("shared crate / workspace touched ({f}): quick falls back to batch");
+                    plan::batch(root)
+                }
+            }
+        }
+        "batch" => plan::batch(root),
+        _ => plan::release(root),
+    };
+    run.plan(&plan)?;
+    Ok(run.summary())
+}
diff --git a/xtask/src/plan.rs b/xtask/src/plan.rs
new file mode 100644
index 00000000..461502d9
--- /dev/null
+++ b/xtask/src/plan.rs
@@ -0,0 +1,192 @@
+//! The gate's fixed lists and the batch / release plans (AGENTS.md "Three gate tiers").
+//! Provenance: our own build law, ported from scripts/gate.ps1 (#748); drives only the public cargo / libtest CLI.
+
+use std::cmp::Ordering;
+use std::path::Path;
+
+use crate::scan;
+
+/// Debug test binaries over ~40 s: skipped by batch, run by release (and by quick when the diff maps to
+/// them). Format `crate-dir:binary`. Measured 2026-11-07 (debug, -j 6, 6 test threads).
+pub const SLOW_BINARIES: &[&str] = &[
+    "motion:finish3d",          // ~50 s
+    "motion:pivot5d",           // ~46 s
+    "motion:flow",              // ~42 s
+    "app:center_cut_multiaxis", // ~40 s
+];
+/// Crate dirs in dependency order. kernel builds a C chain (truck dev-dep) for its own tests: release
+/// tier and quick-when-touched only.
+pub const BATCH_CRATES: &[&str] = &["geometry", "cl", "tools", "post", "sim", "motion", "app"];
+pub const ALL_CRATES: &[&str] = &[
+    "geometry", "kernel", "cl", "tools", "post", "sim", "motion", "app", "ui",
+];
+/// A touch to a shared crate (or the workspace manifest) makes quick a batch.
+pub const SHARED: &[&str] = &["geometry", "cl"];
+pub const CLIPPY: &[&str] = &["geometry", "cl", "tools", "post", "sim", "motion", "app", "ui"];
+pub const J: &str = "6";
+pub const T: &str = "--test-threads=6";
+
+/// One cargo command of a plan. `in_ui` runs it with CWD `crates/ui` (the snapshot goldens resolve
+/// from there); every other step runs at the workspace root.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Step {
+    pub name: String,
+    pub args: Vec<String>,
+    pub in_ui: bool,
+}
+
+impl Step {
+    pub fn new(name: impl Into<String>, args: &[&str], dir: &str) -> Step {
+        Step {
+            name: name.into(),
+            args: args.iter().map(|a| (*a).to_string()).collect(),
+            in_ui: dir == "ui",
+        }
+    }
+    pub fn with(mut self, more: &[String]) -> Step {
+        self.args.extend(more.iter().cloned());
+        self
+    }
+}
+
+/// A plan: the lines it prints first, then its steps.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct Plan {
+    pub notes: Vec<String>,
+    pub steps: Vec<Step>,
+}
+
+pub fn pkg(dir: &str) -> String {
+    format!("camcraft-{dir}")
+}
+
+pub fn is_slow(dir: &str, bin: &str) -> bool {
+    let key = format!("{dir}:{bin}");
+    SLOW_BINARIES.contains(&key.as_str())
+}
+
+/// PowerShell's `Sort-Object` order for the ASCII names the gate sorts (crate dirs, suite names, fn
+/// names): case-insensitive, punctuation before digits before letters. Keeps step order identical to
+/// what gate.ps1 printed.
+pub fn ps_cmp(a: &str, b: &str) -> Ordering {
+    fn key(c: char) -> (u8, char) {
+        let class = if c.is_alphabetic() {
+            2
+        } else if c.is_numeric() {
+            1
+        } else {
+            0
+        };
+        (class, c.to_ascii_lowercase())
+    }
+    a.chars().map(key).cmp(b.chars().map(key)).then_with(|| a.cmp(b))
+}
+
+pub fn ps_sorted<I: IntoIterator<Item = String>>(items: I) -> Vec<String> {
+    let mut v: Vec<String> = items.into_iter().collect();
+    v.sort_by(|a, b| ps_cmp(a, b));
+    v.dedup();
+    v
+}
+
+fn strs(v: &[String]) -> Vec<&str> {
+    v.iter().map(String::as_str).collect()
+}
+
+/// Every suite of `dirs`; with `skip_slow` a crate runs `--lib` plus each non-slow binary by name.
+pub fn run_suites(root: &Path, dirs: &[&str], skip_slow: bool) -> Vec<Step> {
+    let mut out = Vec::new();
+    for &d in dirs {
+        let p = pkg(d);
+        if d == "ui" {
+            out.push(Step::new(
+                "ui suites (cwd crates/ui)",
+                &["test", "-j", J, "-p", &p, "--no-fail-fast", "--", T],
+                "ui",
+            ));
+            continue;
+        }
+        if !skip_slow {
+            out.push(Step::new(
+                format!("{d} suites"),
+                &["test", "-j", J, "-p", &p, "--no-fail-fast", "--", T],
+                "",
+            ));
+            continue;
+        }
+        let mut sel = vec!["--lib".to_string()];
+        let mut skipped = Vec::new();
+        for b in scan::binaries(root, d) {
+            if is_slow(d, &b) {
+                skipped.push(b);
+            } else {
+                sel.push("--test".into());
+                sel.push(b);
+            }
+        }
+        let name = if skipped.is_empty() {
+            format!("{d} suites")
+        } else {
+            format!("{d} suites (slow, release tier: {})", skipped.join(", "))
+        };
+        let mut args = vec!["test", "-j", J, "-p", &p, "--no-fail-fast"];
+        args.extend(strs(&sel));
+        args.extend(["--", T]);
+        out.push(Step::new(name, &args, ""));
+    }
+    out
+}
+
+pub fn clippy() -> Step {
+    let mut args: Vec<String> = vec!["clippy".into(), "-j".into(), J.into()];
+    for d in CLIPPY {
+        args.push("-p".into());
+        args.push(pkg(d));
+    }
+    for a in ["--all-targets", "--", "-D", "warnings"] {
+        args.push(a.into());
+    }
+    Step::new("clippy -D warnings", &[], "").with(&args)
+}
+
+pub fn batch(root: &Path) -> Plan {
+    let mut plan = Plan::default();
+    plan.notes.push(format!(
+        "batch: debug suites minus SLOW_BINARIES ({}), ui, clippy",
+        SLOW_BINARIES.join(", ")
+    ));
+    plan.steps.extend(run_suites(root, BATCH_CRATES, true));
+    plan.steps.extend(run_suites(root, &["ui"], false));
+    plan.steps.push(clippy());
+    plan
+}
+
+pub fn release(root: &Path) -> Plan {
+    let mut plan = Plan::default();
+    plan.notes.push(
+        "release: every debug suite, ui, clippy, then the --ignored heavy lanes in release and the ui snapshot lane"
+            .into(),
+    );
+    let non_ui: Vec<&str> = ALL_CRATES.iter().copied().filter(|d| *d != "ui").collect();
+    plan.steps.extend(run_suites(root, &non_ui, false));
+    plan.steps.extend(run_suites(root, &["ui"], false));
+    plan.steps.push(clippy());
+    for d in ["motion", "app"] {
+        let p = pkg(d);
+        plan.steps.push(Step::new(
+            format!("{d} heavy lane (release --ignored)"),
+            &["test", "--release", "-j", J, "-p", &p, "--no-fail-fast", "--", T, "--ignored"],
+            "",
+        ));
+    }
+    // The ui pixel snapshot goldens (#255): #[ignore]d out of quick/batch, run here only, debug like the
+    // goldens were made, CWD crates/ui so they resolve tests/snapshots/. Regenerated at the cut with
+    // UPDATE_SNAPSHOTS=1.
+    let p = pkg("ui");
+    plan.steps.push(Step::new(
+        "ui snapshot lane (debug --ignored, cwd crates/ui)",
+        &["test", "-j", J, "-p", &p, "--lib", "--no-fail-fast", "--", T, "--ignored", "snapshot"],
+        "ui",
+    ));
+    plan
+}
diff --git a/xtask/src/quick.rs b/xtask/src/quick.rs
new file mode 100644
index 00000000..65f02583
--- /dev/null
+++ b/xtask/src/quick.rs
@@ -0,0 +1,279 @@
+//! The quick tier's plan: from the files a diff touches to the test fns and suites that cover them.
+//! Provenance: our own build law (AGENTS.md "Three gate tiers", "Test the change"), ported from
+//! scripts/gate.ps1 (#748): changed #[test] fns run --exact, a changed src module runs the suites whose
+//! Gate map names it, shared test code runs the crate's suites, shared crates / the manifest -> batch.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::Path;
+
+use regex::escape;
+
+use crate::plan::{ALL_CRATES, J, Plan, SHARED, Step, T, pkg, ps_cmp, ps_sorted};
+use crate::scan::{self, re};
+
+/// What quick does with a diff.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Quick {
+    /// A shared crate or the workspace manifest changed (the first such file): run batch instead.
+    Batch(String),
+    Plan(Plan),
+}
+
+/// The diff, as quick reads it.
+pub struct Diff<'a> {
+    /// Changed and untracked files, `/`-separated, relative to the root.
+    pub changed: &'a [String],
+    pub untracked: &'a [String],
+    /// The `@@ ` hunk headers of one file's zero-context diff against the merge base.
+    pub hunks: &'a dyn Fn(&str) -> Vec<String>,
+}
+
+#[derive(Default)]
+struct Picks {
+    whole: BTreeSet<String>,
+    why: BTreeMap<String, String>,
+    fns: BTreeSet<(String, String)>,
+    ign: BTreeSet<(String, String)>,
+    libs: BTreeSet<String>,
+    mods: Vec<(String, String, String)>,
+}
+
+pub fn plan(root: &Path, diff: &Diff, heavy: bool) -> Result<Quick, String> {
+    let manifest = re(r"(?i)^(Cargo\.(toml|lock)$|\.cargo/|rust-toolchain)")?;
+    let shared_crate = re(&format!("(?i)^crates/({})/", SHARED.join("|")))?;
+    if let Some(f) = diff.changed.iter().find(|f| manifest.is_match(f) || shared_crate.is_match(f)) {
+        return Ok(Quick::Batch(f.clone()));
+    }
+    let mut p = Picks::default();
+    let mut plan = Plan::default();
+    let in_crate = re(r"(?i)^crates/([^/]+)/(.+)$")?;
+    let suite_file = re(r"(?i)^tests/([^/]+)\.rs$")?;
+    let src_file = re(r"(?i)^src/([^/]+?)(\.rs)?(/([^/]+?)(\.rs)?(/.*)?)?$")?;
+    let hunk_re = re(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@")?;
+    let xtask = diff.changed.iter().any(|f| f.starts_with("xtask/"));
+    for f in diff.changed {
+        let Some(c) = in_crate.captures(f) else { continue };
+        let (d, rest) = (c[1].to_string(), c[2].to_string());
+        if !ALL_CRATES.contains(&d.as_str()) {
+            continue;
+        }
+        let abs = root.join(f);
+        if let Some(t) = suite_file.captures(&rest) {
+            let key = format!("{d}:{}", &t[1]);
+            if !abs.is_file() {
+                continue;
+            }
+            if diff.untracked.iter().any(|u| u.eq_ignore_ascii_case(f)) {
+                p.whole.insert(key.clone());
+                p.why.insert(key, "new suite".into());
+                continue;
+            }
+            let all = scan::test_fns(&scan::read(&abs))?;
+            let mut outside = false;
+            for hk in (diff.hunks)(f) {
+                let Some(h) = hunk_re.captures(&hk) else { continue };
+                let s: usize = h[1].parse().unwrap_or(0);
+                let c: usize = h.get(2).and_then(|m| m.as_str().parse().ok()).unwrap_or(1);
+                let e = s.max((s + c).saturating_sub(1));
+                let lo = s.max(1);
+                let hit: Vec<_> = all.iter().filter(|t| t.start <= e && t.end >= lo).collect();
+                if hit.is_empty() {
+                    outside = true;
+                }
+                for t in hit {
+                    let set = if t.ignored { &mut p.ign } else { &mut p.fns };
+                    set.insert((key.clone(), t.name.clone()));
+                }
+            }
+            if outside {
+                p.whole.insert(key.clone());
+                p.why.insert(key, "suite changed outside its test fns".into());
+            }
+        } else if rest.to_ascii_lowercase().starts_with("tests/")
+            || rest.eq_ignore_ascii_case("Cargo.toml")
+            || rest.eq_ignore_ascii_case("build.rs")
+        {
+            for b in scan::binaries(root, &d) {
+                let key = format!("{d}:{b}");
+                p.whole.insert(key.clone());
+                p.why.insert(key, format!("shared test input {rest}"));
+            }
+            p.libs.insert(d);
+        } else if let Some(s) = src_file.captures(&rest) {
+            p.libs.insert(d.clone());
+            let m = s[1].to_string();
+            let sub = match s.get(4).map(|x| x.as_str()) {
+                Some(x) if x != "mod" && x != "tests" => x.to_string(),
+                _ => String::new(),
+            };
+            if !["lib", "main", "bin"].contains(&m.as_str()) {
+                p.mods.push((d, m, sub));
+            }
+        }
+    }
+    p.mods.sort_by(|a, b| {
+        ps_cmp(&a.0, &b.0).then_with(|| ps_cmp(&a.1, &b.1)).then_with(|| ps_cmp(&a.2, &b.2))
+    });
+    p.mods.dedup();
+    map_modules(root, &mut p, &mut plan.notes)?;
+    describe(&p, heavy, xtask, &mut plan.notes);
+    plan.steps = steps(p, heavy, xtask);
+    Ok(Quick::Plan(plan))
+}
+
+/// src modules -> the suites whose Gate map names them (own crate: `::mod` or `{..mod..}`; others:
+/// `crate::mod`). A file in a submodule picks the suites naming `mod::sub` or `mod (.. sub ..)` when
+/// there are any, else every suite naming the module.
+fn map_modules(root: &Path, p: &mut Picks, notes: &mut Vec<String>) -> Result<(), String> {
+    if p.mods.is_empty() {
+        return Ok(());
+    }
+    let mut maps: Vec<(String, String, String)> = Vec::new();
+    for d in ALL_CRATES {
+        for b in scan::binaries(root, d) {
+            let file = root.join("crates").join(d).join("tests").join(format!("{b}.rs"));
+            let gm = scan::gate_map(&scan::read(&file))?;
+            if !gm.is_empty() {
+                maps.push(((*d).to_string(), b, gm));
+            }
+        }
+    }
+    for (md, m, sub) in p.mods.clone() {
+        let (mm, ms) = (escape(&m), escape(&sub));
+        let own = re(&format!(r"(?i)::{mm}\b|\{{[^}}]*\b{mm}\b"))?;
+        let other = re(&format!(r"(?i)\b(camcraft_)?{md}::{mm}\b"))?;
+        let by_sub_re = re(&format!(r"(?i)(::|\{{[^}}]*\b){mm}(::{ms}\b|\s*\([^)]*\b{ms}\b)"))?;
+        let (mut by_sub, mut by_mod) = (Vec::new(), Vec::new());
+        for (d, b, gm) in &maps {
+            let hit = if *d == md { own.is_match(gm) } else { other.is_match(gm) };
+            if !hit {
+                continue;
+            }
+            by_mod.push(format!("{d}:{b}"));
+            if !sub.is_empty() && by_sub_re.is_match(gm) {
+                by_sub.push(format!("{d}:{b}"));
+            }
+        }
+        let use_sub = !by_sub.is_empty();
+        let pick = if use_sub { by_sub } else { by_mod };
+        let lbl = if use_sub { format!("{md}::{m}::{sub}") } else { format!("{md}::{m}") };
+        let shown_sub = if sub.is_empty() { String::new() } else { format!("::{sub}") };
+        notes.push(format!(
+            "  src {md}::{m}{shown_sub} -> {} suite(s) by gate map ({})",
+            pick.len(),
+            if use_sub { "submodule" } else { "module" }
+        ));
+        for k in pick {
+            p.whole.insert(k.clone());
+            p.why.entry(k).or_insert_with(|| format!("gate map names {lbl}"));
+        }
+    }
+    Ok(())
+}
+
+fn by_fn(set: &BTreeSet<(String, String)>) -> Vec<(String, String)> {
+    let mut v: Vec<_> = set.iter().cloned().collect();
+    v.sort_by(|a, b| ps_cmp(&a.0, &b.0).then_with(|| ps_cmp(&a.1, &b.1)));
+    v
+}
+
+fn describe(p: &Picks, heavy: bool, xtask: bool, notes: &mut Vec<String>) {
+    notes.push("quick plan:".into());
+    for d in ps_sorted(p.libs.iter().cloned()) {
+        notes.push(format!("  {d} lib (unit tests)"));
+    }
+    for k in ps_sorted(p.whole.iter().cloned()) {
+        let why = p.why.get(&k).map(String::as_str).unwrap_or("");
+        notes.push(format!("  {k}  whole suite - {why}"));
+    }
+    let ign_note = if heavy {
+        "  [ignored -> release --ignored]"
+    } else {
+        "  [ignored: heavy lane, skipped - pass --heavy or use `gate test <name>`]"
+    };
+    let mut both: Vec<(String, String, bool)> =
+        by_fn(&p.fns).into_iter().map(|(k, f)| (k, f, false)).collect();
+    both.extend(by_fn(&p.ign).into_iter().map(|(k, f)| (k, f, true)));
+    both.sort_by(|a, b| ps_cmp(&a.0, &b.0).then_with(|| ps_cmp(&a.1, &b.1)));
+    for (k, f, ig) in both {
+        if !p.whole.contains(&k) {
+            notes.push(format!("  {k}::{f}{}", if ig { ign_note } else { "" }));
+        }
+    }
+    if xtask {
+        notes.push("  xtask (unit tests) - xtask/ changed".into());
+    }
+    if p.libs.is_empty() && p.whole.is_empty() && p.fns.is_empty() && p.ign.is_empty() && !xtask {
+        notes.push("  nothing in crates/ changed: no tests to run".into());
+    }
+}
+
+fn steps(mut p: Picks, heavy: bool, xtask: bool) -> Vec<Step> {
+    let mut build_only: BTreeSet<String> = BTreeSet::new();
+    if !heavy {
+        build_only = p.ign.iter().map(|(k, _)| k.clone()).collect();
+        p.ign.clear();
+    }
+    let whole = ps_sorted(p.whole.iter().cloned());
+    let mut out = Vec::new();
+    for &d in ALL_CRATES {
+        let pk = pkg(d);
+        let mine = |k: &String| k.split(':').next() == Some(d);
+        let bin = |k: &String| k.split(':').nth(1).unwrap_or("").to_string();
+        let mut sel: Vec<String> = Vec::new();
+        if p.libs.contains(d) {
+            sel.push("--lib".into());
+        }
+        for k in whole.iter().filter(|k| mine(k)) {
+            sel.extend(["--test".to_string(), bin(k)]);
+        }
+        if !sel.is_empty() {
+            let base = Step::new(format!("{d} suites"), &["test", "-j", J, "-p", &pk, "--no-fail-fast"], d);
+            out.push(base.with(&sel).with(&["--".into(), T.into()]));
+        }
+        // A suite whose only changed fns are skipped heavy ones still has to compile.
+        let mut bo: Vec<String> = Vec::new();
+        for k in ps_sorted(build_only.iter().cloned()).iter().filter(|k| mine(k)) {
+            if !p.whole.contains(k) && !p.fns.iter().any(|(fk, _)| fk == k) {
+                bo.extend(["--test".to_string(), bin(k)]);
+            }
+        }
+        if !bo.is_empty() {
+            let name = format!("{d} build-only (changed fns are heavy lane)");
+            out.push(Step::new(name, &["test", "-j", J, "-p", &pk, "--no-run"], d).with(&bo));
+        }
+        for (set, is_ign) in [(&p.fns, false), (&p.ign, true)] {
+            let mut groups: BTreeMap<String, Vec<String>> = BTreeMap::new();
+            for (k, f) in by_fn(set) {
+                if mine(&k) && !p.whole.contains(&k) {
+                    groups.entry(k).or_default().push(f);
+                }
+            }
+            let mut keys: Vec<String> = groups.keys().cloned().collect();
+            keys.sort_by(|a, b| ps_cmp(a, b));
+            for k in keys {
+                let names = groups.remove(&k).unwrap_or_default();
+                let b = bin(&k);
+                let tag = if is_ign { ", ignored, release" } else { "" };
+                let name = format!("{d} {b} ({} fn{tag})", names.len());
+                let mut args: Vec<String> = vec!["test".into()];
+                if is_ign {
+                    args.push("--release".into());
+                }
+                for a in ["-j", J, "-p", &pk, "--test", &b, "--", T] {
+                    args.push(a.into());
+                }
+                if is_ign {
+                    args.push("--ignored".into());
+                }
+                args.push("--exact".into());
+                args.extend(names);
+                out.push(Step::new(name, &[], d).with(&args));
+            }
+        }
+    }
+    if xtask {
+        out.push(Step::new("xtask unit tests", &["test", "-j", J, "-p", "xtask", "--", T], ""));
+    }
+    out
+}
diff --git a/xtask/src/scan.rs b/xtask/src/scan.rs
new file mode 100644
index 00000000..81ed6f7f
--- /dev/null
+++ b/xtask/src/scan.rs
@@ -0,0 +1,139 @@
+//! Source scanning for the gate: test suites of a crate, the `#[test]` fns of a file with their line
+//! spans, and the "Gate map" paragraph of a suite header.
+//! Provenance: our own build law (AGENTS.md "Testing", gate maps of M4.4), ported from scripts/gate.ps1 (#748).
+
+use std::path::{Path, PathBuf};
+
+use regex::Regex;
+
+use crate::plan::ps_cmp;
+
+/// A `#[test]` fn: its name, its 1-based line span (doc/attr lines through the closing brace) and
+/// whether it carries `#[ignore]`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TestFn {
+    pub name: String,
+    pub start: usize,
+    pub end: usize,
+    pub ignored: bool,
+}
+
+/// Compiles a gate pattern; a bad one is an error by name, never a panic.
+pub fn re(pat: &str) -> Result<Regex, String> {
+    Regex::new(pat).map_err(|e| format!("bad gate pattern {pat:?}: {e}"))
+}
+
+pub fn read(path: &Path) -> String {
+    std::fs::read_to_string(path).unwrap_or_default()
+}
+
+/// The integration-test suites of `crates/<dir>/tests/*.rs`, by name, in gate order.
+pub fn binaries(root: &Path, dir: &str) -> Vec<String> {
+    let mut out: Vec<String> = rs_files(&root.join("crates").join(dir).join("tests"))
+        .iter()
+        .filter_map(|p| p.file_stem().map(|s| s.to_string_lossy().into_owned()))
+        .collect();
+    out.sort_by(|a, b| ps_cmp(a, b));
+    out
+}
+
+/// The `.rs` files directly in `dir`, sorted; empty when it does not exist.
+pub fn rs_files(dir: &Path) -> Vec<PathBuf> {
+    let mut out: Vec<PathBuf> = match std::fs::read_dir(dir) {
+        Ok(rd) => rd
+            .filter_map(Result::ok)
+            .map(|e| e.path())
+            .filter(|p| p.is_file() && p.extension().is_some_and(|x| x == "rs"))
+            .collect(),
+        Err(_) => Vec::new(),
+    };
+    out.sort_by(|a, b| ps_cmp(&a.to_string_lossy(), &b.to_string_lossy()));
+    out
+}
+
+/// The `.rs` files under `dir`, a directory's own files before its subdirectories (each sorted).
+pub fn rs_files_recursive(dir: &Path) -> Vec<PathBuf> {
+    let mut out = rs_files(dir);
+    let mut subs: Vec<PathBuf> = match std::fs::read_dir(dir) {
+        Ok(rd) => rd.filter_map(Result::ok).map(|e| e.path()).filter(|p| p.is_dir()).collect(),
+        Err(_) => Vec::new(),
+    };
+    subs.sort_by(|a, b| ps_cmp(&a.to_string_lossy(), &b.to_string_lossy()));
+    for s in subs {
+        out.extend(rs_files_recursive(&s));
+    }
+    out
+}
+
+/// The `#[test]` fns of a source text.
+pub fn test_fns(text: &str) -> Result<Vec<TestFn>, String> {
+    let test_attr = re(r"(?i)^\s*#\[test\]")?;
+    let lead = re(r"(?i)^\s*(///|#\[)")?;
+    let fn_re = re(r"(?i)^\s*(pub\s+)?(async\s+)?fn\s+(\w+)")?;
+    let lines: Vec<&str> = text.lines().collect();
+    let n = lines.len();
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < n {
+        if !test_attr.is_match(lines[i]) {
+            i += 1;
+            continue;
+        }
+        let mut s = i;
+        while s > 0 && lead.is_match(lines[s - 1]) {
+            s -= 1;
+        }
+        let mut ignored = false;
+        let mut k = i;
+        let mut name = None;
+        while k < n {
+            if let Some(c) = fn_re.captures(lines[k]) {
+                name = c.get(3).map(|m| m.as_str().to_string());
+                break;
+            }
+            if lines[k].to_ascii_lowercase().contains("#[ignore") {
+                ignored = true;
+            }
+            k += 1;
+        }
+        let Some(name) = name else { break };
+        let (mut depth, mut opened, mut e) = (0i64, false, k);
+        while e < n {
+            for ch in lines[e].chars() {
+                if ch == '{' {
+                    depth += 1;
+                    opened = true;
+                } else if ch == '}' {
+                    depth -= 1;
+                }
+            }
+            if opened && depth <= 0 {
+                break;
+            }
+            e += 1;
+        }
+        out.push(TestFn { name, start: s + 1, end: e + 1, ignored });
+        i = e + 1;
+    }
+    Ok(out)
+}
+
+/// The "Gate map" paragraph of a suite header (first 150 lines), as one string; empty when absent.
+pub fn gate_map(text: &str) -> Result<String, String> {
+    let start = re(r"(?i)Gate map")?;
+    let blank = re(r"^//!\s*$")?;
+    let mut on = false;
+    let mut acc: Vec<&str> = Vec::new();
+    for l in text.lines().take(150) {
+        if !on && start.is_match(l) {
+            on = true;
+        }
+        if on {
+            if !l.starts_with("//!") || blank.is_match(l) {
+                break;
+            }
+            acc.push(l);
+        }
+    }
+    Ok(acc.join(" "))
+}
diff --git a/xtask/src/single.rs b/xtask/src/single.rs
new file mode 100644
index 00000000..7cb39841
--- /dev/null
+++ b/xtask/src/single.rs
@@ -0,0 +1,145 @@
+//! `gate test <filter>`: exactly the `#[test]` fns whose name matches, in the crate and suite that
+//! hold them (ignored ones in release with --ignored).
+//! Provenance: our own build law (AGENTS.md "Test the change"), ported from scripts/gate.ps1 -Test (#748).
+
+use std::path::Path;
+
+use regex::escape;
+
+use crate::plan::{ALL_CRATES, J, Plan, Step, T, pkg};
+use crate::scan::{self, re};
+
+pub struct Filter<'a> {
+    pub name: &'a str,
+    pub krate: Option<&'a str>,
+    pub binary: Option<&'a str>,
+    pub exact: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Hit {
+    dir: String,
+    /// true: an integration suite in `crates/<dir>/tests/`; false: a unit test in the lib.
+    suite: bool,
+    bin: String,
+    func: String,
+    ignored: bool,
+}
+
+/// (crate dir, is a suite, suite name or empty for the lib, ignored).
+type Group = (String, bool, String, bool);
+
+/// The plan; `Err` names why nothing can run (no fn matches the filter).
+pub fn plan(root: &Path, f: &Filter) -> Result<Plan, String> {
+    let dirs: Vec<String> = match f.krate {
+        Some(c) => vec![c.strip_prefix("camcraft-").unwrap_or(c).to_string()],
+        None => ALL_CRATES.iter().map(|d| (*d).to_string()).collect(),
+    };
+    let t = escape(f.name);
+    let pat = if f.exact {
+        re(&format!(r"(?i)fn\s+{t}\s*[(<]"))?
+    } else {
+        re(&format!(r"(?i)fn\s+\w*{t}\w*\s*[(<]"))?
+    };
+    let mut hits: Vec<Hit> = Vec::new();
+    for d in &dirs {
+        let crate_dir = root.join("crates").join(d);
+        let tests_dir = crate_dir.join("tests");
+        let files = match f.binary {
+            Some(b) => {
+                let file = tests_dir.join(format!("{b}.rs"));
+                if file.is_file() { vec![file] } else { Vec::new() }
+            }
+            None => {
+                let mut v = scan::rs_files(&tests_dir);
+                v.extend(scan::rs_files_recursive(&crate_dir.join("src")));
+                v
+            }
+        };
+        for file in files {
+            let text = scan::read(&file);
+            if f.binary.is_none() && !pat.is_match(&text) {
+                continue;
+            }
+            // Only a file directly in crates/<dir>/tests is its own suite; a `tests/` module under
+            // src/ is part of the lib.
+            let suite = file.parent() == Some(tests_dir.as_path());
+            let bin = file.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+            for tf in scan::test_fns(&text)? {
+                let ok = if f.exact {
+                    tf.name.eq_ignore_ascii_case(f.name)
+                } else {
+                    tf.name.contains(f.name)
+                };
+                if ok {
+                    hits.push(Hit {
+                        dir: d.clone(),
+                        suite,
+                        bin: bin.clone(),
+                        func: tf.name,
+                        ignored: tf.ignored,
+                    });
+                }
+            }
+        }
+    }
+    if hits.is_empty() {
+        return Err(format!("no #[test] fn matches '{}'", f.name));
+    }
+    let mut plan = Plan::default();
+    plan.notes.push("matched:".into());
+    for h in &hits {
+        plan.notes.push(format!(
+            "  {} {} {}::{}{}",
+            h.dir,
+            if h.suite { "test" } else { "lib" },
+            h.bin,
+            h.func,
+            if h.ignored { "  [ignored -> release]" } else { "" }
+        ));
+    }
+    // One step per (crate, suite or lib, ignored), in the order they were found. The lib is one
+    // target however many src files matched, so its hits share a group.
+    let group = |h: &Hit| (h.dir.clone(), h.suite, if h.suite { h.bin.clone() } else { String::new() }, h.ignored);
+    let mut groups: Vec<(Group, Vec<String>)> = Vec::new();
+    for h in &hits {
+        let g = group(h);
+        match groups.iter_mut().find(|(k, _)| *k == g) {
+            Some((_, fns)) => fns.push(h.func.clone()),
+            None => groups.push((g, vec![h.func.clone()])),
+        }
+    }
+    for ((dir, suite, bin, ignored), fns) in groups {
+        let pk = pkg(&dir);
+        let mut args: Vec<String> = vec!["test".into()];
+        if ignored {
+            args.push("--release".into());
+        }
+        for a in ["-j", J, "-p", &pk] {
+            args.push(a.into());
+        }
+        if suite {
+            args.extend(["--test".to_string(), bin.clone()]);
+        } else {
+            args.push("--lib".into());
+        }
+        args.extend(["--".to_string(), T.to_string()]);
+        if ignored {
+            args.push("--ignored".into());
+        }
+        // --exact needs the full test path: top-level fns in suites; lib unit tests filter by substring.
+        if f.exact && suite {
+            args.push("--exact".into());
+            args.extend(fns);
+        } else {
+            args.push(f.name.to_string());
+        }
+        let name = format!(
+            "{dir} {}{}",
+            if suite { bin.as_str() } else { "lib" },
+            if ignored { " (ignored, release)" } else { "" }
+        );
+        plan.steps.push(Step::new(name, &[], &dir).with(&args));
+    }
+    Ok(plan)
+}
diff --git a/xtask/src/tests.rs b/xtask/src/tests.rs
new file mode 100644
index 00000000..18807491
--- /dev/null
+++ b/xtask/src/tests.rs
@@ -0,0 +1,243 @@
+//! Pins the gate's plan selection (changed files -> planned steps), the slow list, the scanners and the
+//! decision collection, on a throwaway workspace fixture.
+//! Provenance: our own build law (AGENTS.md "Three gate tiers"), #748.
+
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use crate::plan::{self, SLOW_BINARIES, Step};
+use crate::quick::{self, Diff, Quick};
+use crate::{decisions, exec, parse_gate, scan, single};
+
+struct Fixture(PathBuf);
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn fixture() -> Fixture {
+    static N: AtomicUsize = AtomicUsize::new(0);
+    let root = std::env::temp_dir().join(format!(
+        "xtask-fixture-{}-{}",
+        std::process::id(),
+        N.fetch_add(1, Ordering::SeqCst)
+    ));
+    let _ = std::fs::remove_dir_all(&root);
+    let w = |rel: &str, text: &str| {
+        let p = root.join(rel);
+        if let Some(d) = p.parent() {
+            std::fs::create_dir_all(d).expect("fixture dir");
+        }
+        std::fs::write(p, text).expect("fixture file");
+    };
+    w(
+        "crates/app/tests/ops.rs",
+        "//! Ops suite.\n//! Gate map (M4.4): covers app::operation (area,\n//! boundary), app::commands.\n//!\nuse x;\n\n#[test]\nfn op_area() {\n    assert!(true);\n}\n\n/// Heavy.\n#[test]\n#[ignore = \"heavy lane\"]\nfn op_heavy() {\n    big();\n}\n",
+    );
+    w(
+        "crates/app/tests/cmds.rs",
+        "//! Gate map: covers app::commands, motion::finish3d.\n\n#[test]\nfn cmd_undo() {}\n",
+    );
+    w("crates/app/tests/center_cut_multiaxis.rs", "//! Gate map: covers app::multiaxis.\n");
+    w("crates/app/src/operation/area.rs", "pub fn a() {}\n#[cfg(test)]\nmod tests {\n    #[test]\n    fn area_unit() {}\n}\n");
+    w("crates/app/src/commands.rs", "pub fn c() {}\n");
+    w("crates/motion/tests/finish3d.rs", "//! Gate map: covers motion::finish3d.\n#[test]\nfn f3d() {}\n");
+    w("crates/motion/tests/waterline.rs", "//! Gate map: covers motion::waterline.\n");
+    w("crates/ui/src/egui_app/tests/structural.rs", "#[test]\nfn op_area_label() {}\n");
+    w("docs/decisions/README.md", "format\n");
+    w("docs/decisions/12-b.md", "\u{feff}# 12 b\n\n");
+    w("docs/decisions/9-a.md", "# 9 a\n");
+    Fixture(root)
+}
+
+fn quick_plan(root: &Path, changed: &[&str], untracked: &[&str], hunks: &[(&str, &str)], heavy: bool) -> Quick {
+    let changed: Vec<String> = changed.iter().map(|s| (*s).to_string()).collect();
+    let untracked: Vec<String> = untracked.iter().map(|s| (*s).to_string()).collect();
+    let hunks: Vec<(String, String)> = hunks.iter().map(|(f, h)| ((*f).into(), (*h).into())).collect();
+    let provider = move |f: &str| -> Vec<String> {
+        hunks.iter().filter(|(hf, _)| hf == f).map(|(_, h)| h.clone()).collect()
+    };
+    let diff = Diff { changed: &changed, untracked: &untracked, hunks: &provider };
+    quick::plan(root, &diff, heavy).expect("quick plan")
+}
+
+fn steps(q: Quick) -> Vec<Step> {
+    match q {
+        Quick::Plan(p) => p.steps,
+        Quick::Batch(f) => panic!("unexpected batch fallback on {f}"),
+    }
+}
+
+fn line(s: &Step) -> String {
+    format!("{}{} | {}", if s.in_ui { "[ui] " } else { "" }, s.name, s.args.join(" "))
+}
