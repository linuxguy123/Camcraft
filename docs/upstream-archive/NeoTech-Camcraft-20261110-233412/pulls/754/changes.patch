+//! `cargo xtask decisions --version X.Y.Z`: gather docs/decisions/*.md into RECOMMENDED.md at a release
+//! cut (one file per PR keeps issue branches from conflicting on RECOMMENDED.md).
+//! Provenance: our own process law (AGENTS.md "Every recommendation is recorded", release step 2),
+//! ported from scripts/collect-decisions.ps1 (#748).
+
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+use crate::plan::ps_cmp;
+
+/// `X.Y.Z`, digits only.
+pub fn valid_version(v: &str) -> bool {
+    let parts: Vec<&str> = v.split('.').collect();
+    parts.len() == 3 && parts.iter().all(|p| !p.is_empty() && p.bytes().all(|b| b.is_ascii_digit()))
+}
+
+/// The decision files in collection order: by the issue number that leads the name, then by name.
+pub fn files(dir: &Path) -> Vec<PathBuf> {
+    let num = |p: &PathBuf| -> u64 {
+        let stem = p.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+        stem.split('-').next().and_then(|n| n.parse().ok()).unwrap_or(0)
+    };
+    let name = |p: &PathBuf| p.file_name().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+    let mut v: Vec<PathBuf> = match std::fs::read_dir(dir) {
+        Ok(rd) => rd
+            .filter_map(Result::ok)
+            .map(|e| e.path())
+            .filter(|p| p.is_file() && p.extension().is_some_and(|x| x == "md"))
+            .filter(|p| !name(p).eq_ignore_ascii_case("README.md"))
+            .collect(),
+        Err(_) => Vec::new(),
+    };
+    v.sort_by(|a, b| num(a).cmp(&num(b)).then_with(|| ps_cmp(&name(a), &name(b))));
+    v
+}
+
+/// The text appended to RECOMMENDED.md for these files.
+pub fn section(version: &str, files: &[PathBuf]) -> Result<String, String> {
+    let mut text = format!("\n## v{version} - decisions gathered at the cut\n");
+    for f in files {
+        let raw = std::fs::read_to_string(f).map_err(|e| format!("read {}: {e}", f.display()))?;
+        let body = raw.strip_prefix('\u{feff}').unwrap_or(&raw);
+        text.push('\n');
+        text.push_str(body.trim_end());
+        text.push('\n');
+    }
+    Ok(text)
+}
+
+/// Appends the section and removes the gathered files; the line printed for the operator.
+pub fn collect(root: &Path, version: &str) -> Result<String, String> {
+    if !valid_version(version) {
+        return Err(format!("--version must be X.Y.Z, got '{version}'"));
+    }
+    let list = files(&root.join("docs").join("decisions"));
+    if list.is_empty() {
+        return Ok("no decision files to collect".into());
+    }
+    let text = section(version, &list)?;
+    let out = root.join("RECOMMENDED.md");
+    let mut f = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(&out)
+        .map_err(|e| format!("open {}: {e}", out.display()))?;
+    f.write_all(text.as_bytes()).map_err(|e| format!("write {}: {e}", out.display()))?;
+    for p in &list {
+        std::fs::remove_file(p).map_err(|e| format!("remove {}: {e}", p.display()))?;
+    }
+    Ok(format!("collected {} decision file(s) into RECOMMENDED.md", list.len()))
+}
diff --git a/xtask/src/exec.rs b/xtask/src/exec.rs
new file mode 100644
index 00000000..60344e7a
--- /dev/null
+++ b/xtask/src/exec.rs
@@ -0,0 +1,168 @@
+//! Running a gate plan: one cargo command per step, its output to its own log under
+//! gate-logs/<tier>-<timestamp>/, pass/fail and failing suites read back from the log, then the summary.
+//! Provenance: our own build law (AGENTS.md "Three gate tiers"), ported from scripts/gate.ps1 (#748).
+
+use std::fs::File;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+use crate::plan::{Plan, Step};
+use crate::scan::re;
+
+pub struct Run {
+    pub root: PathBuf,
+    pub label: String,
+    pub dry: bool,
+    log_dir: PathBuf,
+    clock: Instant,
+    done: Vec<Done>,
+}
+
+struct Done {
+    name: String,
+    ok: bool,
+    secs: u64,
+    note: String,
+}
+
+/// The cargo that launched us (`cargo xtask` sets CARGO), else the one on PATH.
+pub fn cargo() -> String {
+    std::env::var("CARGO").unwrap_or_else(|_| "cargo".into())
+}
+
+/// `git -C root <args>`, stdout as text; `Err` when git fails.
+pub fn git(root: &Path, args: &[&str]) -> Result<String, String> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(args)
+        .output()
+        .map_err(|e| format!("git {}: {e}", args.join(" ")))?;
+    if !out.status.success() {
+        return Err(format!(
+            "git {} failed: {}",
+            args.join(" "),
+            String::from_utf8_lossy(&out.stderr).trim()
+        ));
+    }
+    Ok(String::from_utf8_lossy(&out.stdout).into_owned())
+}
+
+/// `yyyyMMdd-HHmmss` (UTC) for the log dir name.
+pub fn stamp(now: SystemTime) -> String {
+    let secs = now.duration_since(UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0);
+    let (days, rem) = ((secs / 86_400) as i64, secs % 86_400);
+    // Civil date from days since 1970-01-01 (H. Hinnant, "chrono-Compatible Low-Level Date Algorithms").
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1_460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = yoe + era * 400 + i64::from(m <= 2);
+    format!("{y:04}{m:02}{d:02}-{:02}{:02}{:02}", rem / 3600, rem % 3600 / 60, rem % 60)
+}
+
+/// A log file name: the step name with each run of non-word characters folded to `_`.
+pub fn log_name(n: usize, name: &str) -> String {
+    let mut s = String::new();
+    let mut gap = false;
+    for c in name.chars() {
+        if c.is_alphanumeric() || c == '_' || c == '-' {
+            s.push(c);
+            gap = false;
+        } else if !gap {
+            s.push('_');
+            gap = true;
+        }
+    }
+    format!("{n:02}-{s}.log")
+}
+
+impl Run {
+    pub fn new(root: &Path, label: &str, dry: bool) -> Result<Run, String> {
+        let log_dir = root.join("gate-logs").join(format!("{label}-{}", stamp(SystemTime::now())));
+        std::fs::create_dir_all(&log_dir).map_err(|e| format!("create {}: {e}", log_dir.display()))?;
+        Ok(Run { root: root.to_path_buf(), label: label.into(), dry, log_dir, clock: Instant::now(), done: Vec::new() })
+    }
+
+    pub fn plan(&mut self, plan: &Plan) -> Result<(), String> {
+        for n in &plan.notes {
+            println!("{n}");
+        }
+        for s in &plan.steps {
+            self.step(s)?;
+        }
+        Ok(())
+    }
+
+    fn step(&mut self, s: &Step) -> Result<(), String> {
+        let n = self.done.len() + 1;
+        let log = self.log_dir.join(log_name(n, &s.name));
+        let dir = if s.in_ui { self.root.join("crates").join("ui") } else { self.root.clone() };
+        let leaf = dir.file_name().map(|x| x.to_string_lossy().into_owned()).unwrap_or_default();
+        println!("[{n:02}] {}", s.name);
+        println!("     (cwd {leaf}) cargo {}", s.args.join(" "));
+        if self.dry {
+            self.done.push(Done { name: s.name.clone(), ok: true, secs: 0, note: "dry run".into() });
+            return Ok(());
+        }
+        let t0 = Instant::now();
+        let file = File::create(&log).map_err(|e| format!("create {}: {e}", log.display()))?;
+        let err = file.try_clone().map_err(|e| format!("log {}: {e}", log.display()))?;
+        let code = Command::new(cargo())
+            .args(&s.args)
+            .current_dir(&dir)
+            .stdin(Stdio::null())
+            .stdout(file)
+            .stderr(err)
+            .status()
+            .map(|st| st.code().unwrap_or(-1))
+            .map_err(|e| format!("cargo {}: {e}", s.args.join(" ")))?;
+        let secs = t0.elapsed().as_secs();
+        let note = read_log(&std::fs::read_to_string(&log).unwrap_or_default(), code)?;
+        let ok = code == 0;
+        println!("     {} in {secs}s {note}", if ok { "ok" } else { "FAIL" });
+        self.done.push(Done { name: s.name.clone(), ok, secs, note });
+        Ok(())
+    }
+
+    /// Prints the summary table; the process exit code (0 all passed, 1 any failed).
+    pub fn summary(self) -> i32 {
+        println!("\n== gate summary ({}) - logs in {}", self.label, self.log_dir.display());
+        for d in &self.done {
+            println!("  {:<4} {:>5}s  {}  {}", if d.ok { "ok" } else { "FAIL" }, d.secs, d.name, d.note);
+        }
+        let bad = self.done.iter().filter(|d| !d.ok).count();
+        let mins = self.clock.elapsed().as_secs_f64() / 60.0;
+        println!("  wall {mins:.1} min, {} step(s), {bad} failed", self.done.len());
+        i32::from(bad > 0)
+    }
+}
+
+/// The step's note from its log: a compile error, the suites that failed, or a bare exit code.
+pub fn read_log(text: &str, code: i32) -> Result<String, String> {
+    let running = re(r"^\s+Running (\S+)")?;
+    let (mut cur, mut fails, mut compile) = (String::new(), Vec::new(), false);
+    for l in text.lines() {
+        if let Some(c) = running.captures(l) {
+            cur = c[1].to_string();
+        } else if l.starts_with("test result: FAILED") {
+            fails.push(cur.clone());
+        } else if l.starts_with("error: could not compile") {
+            compile = true;
+        }
+    }
+    Ok(if compile {
+        "compile error".into()
+    } else if !fails.is_empty() {
+        format!("failed: {}", fails.join(", "))
+    } else if code != 0 {
+        format!("exit {code}")
+    } else {
+        String::new()
+    })
+}
diff --git a/xtask/src/main.rs b/xtask/src/main.rs
new file mode 100644
index 00000000..d1c95e06
--- /dev/null
+++ b/xtask/src/main.rs
@@ -0,0 +1,175 @@
+//! `cargo xtask`: the workspace's process tooling, one implementation for Windows, macOS and Linux -
+//! the gate tiers (`gate quick|batch|release|test`), the decision collection (`decisions`) and the
+//! release cut (`release`).
+//! Provenance: our own build and process law (AGENTS.md "Three gate tiers", "Test the change",
+//! release step 2), replacing the scripts/gate.*, collect-decisions.* and release.ps1 twins (#748, #749).
+
+mod decisions;
+mod exec;
+mod plan;
+mod quick;
+mod release;
+mod release_bump;
+mod release_pack;
+mod scan;
+mod single;
+#[cfg(test)]
+mod release_tests;
+#[cfg(test)]
+mod tests;
+
+use std::path::{Path, PathBuf};
+use std::process::ExitCode;
+
+const USAGE: &str = "\
+usage:
+  cargo xtask gate quick [--base main] [--heavy]   tests the diff touches (test fns where it can)
+  cargo xtask gate batch                           every debug suite minus SLOW_BINARIES, ui, clippy
+  cargo xtask gate release                         everything, plus the --ignored heavy lanes and the ui snapshot lane
+  cargo xtask gate test <filter> [--crate c] [--binary b] [--exact]   exactly the matching test(s)
+      any gate: --dry-run (or --plan) prints the plan without running it. Logs: gate-logs/<tier>-<timestamp>/.
+  cargo xtask decisions --version X.Y.Z            gather docs/decisions/*.md into RECOMMENDED.md
+  cargo xtask release --version X.Y.Z --no-tag [--title T] [--skip-gate] [--skip-build] [--installer] [--dry-run]
+                                                   the release cut on release/vX.Y.Z (scripts/release.ps1's phases)";
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    match run(&args) {
+        Ok(code) => ExitCode::from(u8::try_from(code).unwrap_or(1)),
+        Err(e) => {
+            eprintln!("xtask: {e}");
+            ExitCode::from(2)
+        }
+    }
+}
+
+/// The workspace root: the parent of xtask/ (CARGO_MANIFEST_DIR at run time under `cargo xtask`, else
+/// where this binary was built from).
+fn root() -> PathBuf {
+    let manifest = std::env::var_os("CARGO_MANIFEST_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from(env!("CARGO_MANIFEST_DIR")));
+    manifest.parent().map(Path::to_path_buf).unwrap_or(manifest)
+}
+
+/// Parsed `gate` options.
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct GateArgs {
+    pub tier: String,
+    pub filter: Option<String>,
+    pub base: String,
+    pub krate: Option<String>,
+    pub binary: Option<String>,
+    pub exact: bool,
+    pub heavy: bool,
+    pub dry: bool,
+}
+
+pub fn parse_gate(args: &[String]) -> Result<GateArgs, String> {
+    let mut g = GateArgs { base: "main".into(), ..GateArgs::default() };
+    let mut it = args.iter();
+    let value = |flag: &str, it: &mut std::slice::Iter<String>| {
+        it.next().cloned().ok_or_else(|| format!("{flag} needs a value"))
+    };
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "--base" => g.base = value(a, &mut it)?,
+            "--crate" => g.krate = Some(value(a, &mut it)?),
+            "--binary" => g.binary = Some(value(a, &mut it)?),
+            "--exact" => g.exact = true,
+            "--heavy" => g.heavy = true,
+            "--dry-run" | "--plan" => g.dry = true,
+            s if s.starts_with('-') => return Err(format!("unknown gate option '{s}'\n{USAGE}")),
+            s if g.tier.is_empty() => g.tier = s.to_string(),
+            s if g.tier == "test" && g.filter.is_none() => g.filter = Some(s.to_string()),
+            s => return Err(format!("unexpected argument '{s}'\n{USAGE}")),
+        }
+    }
+    if g.tier.is_empty() {
+        g.tier = "quick".into();
+    }
+    match g.tier.as_str() {
+        "quick" | "batch" | "release" => Ok(g),
+        "test" => match &g.filter {
+            Some(f) if !f.is_empty() && f.chars().all(|c| c.is_alphanumeric() || c == '_') => Ok(g),
+            Some(f) => Err(format!("test filter must be a fn name (letters, digits, _): '{f}'")),
+            None => Err(format!("gate test needs a filter\n{USAGE}")),
+        },
+        t => Err(format!("unknown tier '{t}' (quick | batch | release | test)\n{USAGE}")),
+    }
+}
+
+fn run(args: &[String]) -> Result<i32, String> {
+    match args.first().map(String::as_str) {
+        Some("gate") => gate(&root(), &parse_gate(&args[1..])?),
+        Some("decisions") => {
+            let version = match args.get(1..) {
+                Some([flag, v]) if flag == "--version" => v.clone(),
+                Some([v]) if !v.starts_with('-') => v.clone(),
+                _ => return Err(format!("decisions needs --version X.Y.Z\n{USAGE}")),
+            };
+            println!("{}", decisions::collect(&root(), &version)?);
+            Ok(0)
+        }
+        Some("release") => {
+            let a = release::parse(&args[1..]).map_err(|e| format!("{e}
+{USAGE}"))?;
+            Ok(release::release(&root(), a))
+        }
+        Some("-h" | "--help" | "help") | None => {
+            println!("{USAGE}");
+            Ok(0)
+        }
+        Some(other) => Err(format!("unknown task '{other}'\n{USAGE}")),
+    }
+}
+
+fn gate(root: &Path, g: &GateArgs) -> Result<i32, String> {
+    let mut run = exec::Run::new(root, &g.tier, g.dry)?;
+    if let Some(name) = &g.filter {
+        let f = single::Filter { name, krate: g.krate.as_deref(), binary: g.binary.as_deref(), exact: g.exact };
+        match single::plan(root, &f) {
+            Ok(p) => run.plan(&p)?,
+            Err(e) => {
+                println!("{e}");
+                return Ok(1);
+            }
+        }
+        return Ok(run.summary());
+    }
+    let plan = match g.tier.as_str() {
+        "quick" => {
+            let mb = exec::git(root, &["merge-base", &g.base, "HEAD"])
+                .map(|s| s.trim().to_string())
+                .ok()
+                .filter(|s| !s.is_empty())
+                .ok_or_else(|| format!("no merge base with '{}'", g.base))?;
+            let lines = |s: String| -> Vec<String> {
+                s.lines().filter(|l| !l.is_empty()).map(|l| l.replace('\\', "/")).collect()
+            };
+            let untracked = lines(exec::git(root, &["ls-files", "--others", "--exclude-standard"])?);
+            let mut changed = lines(exec::git(root, &["diff", "--name-only", &mb])?);
+            changed.extend(untracked.iter().cloned());
+            let changed = plan::ps_sorted(changed);
+            let short: String = mb.chars().take(7).collect();
+            println!("changed since {} ({short}): {} file(s)", g.base, changed.len());
+            let hunks = |f: &str| -> Vec<String> {
+                exec::git(root, &["diff", "-U0", &mb, "--", f])
+                    .map(|s| s.lines().filter(|l| l.starts_with("@@ ")).map(String::from).collect())
+                    .unwrap_or_default()
+            };
+            let diff = quick::Diff { changed: &changed, untracked: &untracked, hunks: &hunks };
+            match quick::plan(root, &diff, g.heavy)? {
+                quick::Quick::Plan(p) => p,
+                quick::Quick::Batch(f) => {
+                    println!("shared crate / workspace touched ({f}): quick falls back to batch");
+                    plan::batch(root)
+                }
+            }
+        }
+        "batch" => plan::batch(root),
+        _ => plan::release(root),
+    };
+    run.plan(&plan)?;
+    Ok(run.summary())
+}
diff --git a/xtask/src/plan.rs b/xtask/src/plan.rs
new file mode 100644
index 00000000..461502d9
--- /dev/null
+++ b/xtask/src/plan.rs
@@ -0,0 +1,192 @@
+//! The gate's fixed lists and the batch / release plans (AGENTS.md "Three gate tiers").
+//! Provenance: our own build law, ported from scripts/gate.ps1 (#748); drives only the public cargo / libtest CLI.
+
+use std::cmp::Ordering;
+use std::path::Path;
+
+use crate::scan;
+
+/// Debug test binaries over ~40 s: skipped by batch, run by release (and by quick when the diff maps to
+/// them). Format `crate-dir:binary`. Measured 2026-11-07 (debug, -j 6, 6 test threads).
+pub const SLOW_BINARIES: &[&str] = &[
+    "motion:finish3d",          // ~50 s
+    "motion:pivot5d",           // ~46 s
+    "motion:flow",              // ~42 s
+    "app:center_cut_multiaxis", // ~40 s
+];
+/// Crate dirs in dependency order. kernel builds a C chain (truck dev-dep) for its own tests: release
+/// tier and quick-when-touched only.
+pub const BATCH_CRATES: &[&str] = &["geometry", "cl", "tools", "post", "sim", "motion", "app"];
+pub const ALL_CRATES: &[&str] = &[
+    "geometry", "kernel", "cl", "tools", "post", "sim", "motion", "app", "ui",
+];
+/// A touch to a shared crate (or the workspace manifest) makes quick a batch.
+pub const SHARED: &[&str] = &["geometry", "cl"];
+pub const CLIPPY: &[&str] = &["geometry", "cl", "tools", "post", "sim", "motion", "app", "ui"];
+pub const J: &str = "6";
+pub const T: &str = "--test-threads=6";
+
+/// One cargo command of a plan. `in_ui` runs it with CWD `crates/ui` (the snapshot goldens resolve
+/// from there); every other step runs at the workspace root.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Step {
+    pub name: String,
+    pub args: Vec<String>,
+    pub in_ui: bool,
+}
+
+impl Step {
+    pub fn new(name: impl Into<String>, args: &[&str], dir: &str) -> Step {
+        Step {
+            name: name.into(),
+            args: args.iter().map(|a| (*a).to_string()).collect(),
+            in_ui: dir == "ui",
+        }
+    }
+    pub fn with(mut self, more: &[String]) -> Step {
+        self.args.extend(more.iter().cloned());
+        self
+    }
+}
+
+/// A plan: the lines it prints first, then its steps.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct Plan {
+    pub notes: Vec<String>,
+    pub steps: Vec<Step>,
+}
+
+pub fn pkg(dir: &str) -> String {
+    format!("camcraft-{dir}")
+}
+
+pub fn is_slow(dir: &str, bin: &str) -> bool {
+    let key = format!("{dir}:{bin}");
+    SLOW_BINARIES.contains(&key.as_str())
+}
+
+/// PowerShell's `Sort-Object` order for the ASCII names the gate sorts (crate dirs, suite names, fn
+/// names): case-insensitive, punctuation before digits before letters. Keeps step order identical to
+/// what gate.ps1 printed.
+pub fn ps_cmp(a: &str, b: &str) -> Ordering {
+    fn key(c: char) -> (u8, char) {
+        let class = if c.is_alphabetic() {
+            2
+        } else if c.is_numeric() {
+            1
+        } else {
+            0
+        };
+        (class, c.to_ascii_lowercase())
+    }
+    a.chars().map(key).cmp(b.chars().map(key)).then_with(|| a.cmp(b))
+}
+
+pub fn ps_sorted<I: IntoIterator<Item = String>>(items: I) -> Vec<String> {
+    let mut v: Vec<String> = items.into_iter().collect();
+    v.sort_by(|a, b| ps_cmp(a, b));
+    v.dedup();
+    v
+}
+
+fn strs(v: &[String]) -> Vec<&str> {
+    v.iter().map(String::as_str).collect()
+}
+
+/// Every suite of `dirs`; with `skip_slow` a crate runs `--lib` plus each non-slow binary by name.
+pub fn run_suites(root: &Path, dirs: &[&str], skip_slow: bool) -> Vec<Step> {
+    let mut out = Vec::new();
+    for &d in dirs {
+        let p = pkg(d);
+        if d == "ui" {
+            out.push(Step::new(
+                "ui suites (cwd crates/ui)",
+                &["test", "-j", J, "-p", &p, "--no-fail-fast", "--", T],
+                "ui",
+            ));
+            continue;
+        }
+        if !skip_slow {
+            out.push(Step::new(
+                format!("{d} suites"),
+                &["test", "-j", J, "-p", &p, "--no-fail-fast", "--", T],
+                "",
+            ));
+            continue;
+        }
+        let mut sel = vec!["--lib".to_string()];
+        let mut skipped = Vec::new();
+        for b in scan::binaries(root, d) {
+            if is_slow(d, &b) {
+                skipped.push(b);
+            } else {
+                sel.push("--test".into());
+                sel.push(b);
+            }
+        }
+        let name = if skipped.is_empty() {
+            format!("{d} suites")
+        } else {
+            format!("{d} suites (slow, release tier: {})", skipped.join(", "))
+        };
+        let mut args = vec!["test", "-j", J, "-p", &p, "--no-fail-fast"];
+        args.extend(strs(&sel));
+        args.extend(["--", T]);
+        out.push(Step::new(name, &args, ""));
+    }
+    out
+}
+
+pub fn clippy() -> Step {
+    let mut args: Vec<String> = vec!["clippy".into(), "-j".into(), J.into()];
+    for d in CLIPPY {
+        args.push("-p".into());
+        args.push(pkg(d));
+    }
+    for a in ["--all-targets", "--", "-D", "warnings"] {
+        args.push(a.into());
+    }
+    Step::new("clippy -D warnings", &[], "").with(&args)
+}
+
+pub fn batch(root: &Path) -> Plan {
+    let mut plan = Plan::default();
+    plan.notes.push(format!(
+        "batch: debug suites minus SLOW_BINARIES ({}), ui, clippy",
+        SLOW_BINARIES.join(", ")
+    ));
+    plan.steps.extend(run_suites(root, BATCH_CRATES, true));
+    plan.steps.extend(run_suites(root, &["ui"], false));
+    plan.steps.push(clippy());
+    plan
+}
+
+pub fn release(root: &Path) -> Plan {
+    let mut plan = Plan::default();
+    plan.notes.push(
+        "release: every debug suite, ui, clippy, then the --ignored heavy lanes in release and the ui snapshot lane"
+            .into(),
+    );
+    let non_ui: Vec<&str> = ALL_CRATES.iter().copied().filter(|d| *d != "ui").collect();
+    plan.steps.extend(run_suites(root, &non_ui, false));
+    plan.steps.extend(run_suites(root, &["ui"], false));
+    plan.steps.push(clippy());
+    for d in ["motion", "app"] {
+        let p = pkg(d);
+        plan.steps.push(Step::new(
+            format!("{d} heavy lane (release --ignored)"),
+            &["test", "--release", "-j", J, "-p", &p, "--no-fail-fast", "--", T, "--ignored"],
+            "",
+        ));
+    }
+    // The ui pixel snapshot goldens (#255): #[ignore]d out of quick/batch, run here only, debug like the
+    // goldens were made, CWD crates/ui so they resolve tests/snapshots/. Regenerated at the cut with
+    // UPDATE_SNAPSHOTS=1.
+    let p = pkg("ui");
+    plan.steps.push(Step::new(
+        "ui snapshot lane (debug --ignored, cwd crates/ui)",
+        &["test", "-j", J, "-p", &p, "--lib", "--no-fail-fast", "--", T, "--ignored", "snapshot"],
+        "ui",
+    ));
+    plan
+}
diff --git a/xtask/src/quick.rs b/xtask/src/quick.rs
new file mode 100644
index 00000000..65f02583
--- /dev/null
+++ b/xtask/src/quick.rs
@@ -0,0 +1,279 @@
+//! The quick tier's plan: from the files a diff touches to the test fns and suites that cover them.
+//! Provenance: our own build law (AGENTS.md "Three gate tiers", "Test the change"), ported from
+//! scripts/gate.ps1 (#748): changed #[test] fns run --exact, a changed src module runs the suites whose
+//! Gate map names it, shared test code runs the crate's suites, shared crates / the manifest -> batch.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::Path;
+
+use regex::escape;
+
+use crate::plan::{ALL_CRATES, J, Plan, SHARED, Step, T, pkg, ps_cmp, ps_sorted};
+use crate::scan::{self, re};
+
+/// What quick does with a diff.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Quick {
+    /// A shared crate or the workspace manifest changed (the first such file): run batch instead.
+    Batch(String),
+    Plan(Plan),
+}
+
+/// The diff, as quick reads it.
+pub struct Diff<'a> {
+    /// Changed and untracked files, `/`-separated, relative to the root.
+    pub changed: &'a [String],
+    pub untracked: &'a [String],
+    /// The `@@ ` hunk headers of one file's zero-context diff against the merge base.
+    pub hunks: &'a dyn Fn(&str) -> Vec<String>,
+}
+
+#[derive(Default)]
+struct Picks {
+    whole: BTreeSet<String>,
+    why: BTreeMap<String, String>,
+    fns: BTreeSet<(String, String)>,
+    ign: BTreeSet<(String, String)>,
+    libs: BTreeSet<String>,
+    mods: Vec<(String, String, String)>,
+}
+
+pub fn plan(root: &Path, diff: &Diff, heavy: bool) -> Result<Quick, String> {
+    let manifest = re(r"(?i)^(Cargo\.(toml|lock)$|\.cargo/|rust-toolchain)")?;
+    let shared_crate = re(&format!("(?i)^crates/({})/", SHARED.join("|")))?;
+    if let Some(f) = diff.changed.iter().find(|f| manifest.is_match(f) || shared_crate.is_match(f)) {
+        return Ok(Quick::Batch(f.clone()));
+    }
+    let mut p = Picks::default();
+    let mut plan = Plan::default();
+    let in_crate = re(r"(?i)^crates/([^/]+)/(.+)$")?;
+    let suite_file = re(r"(?i)^tests/([^/]+)\.rs$")?;
+    let src_file = re(r"(?i)^src/([^/]+?)(\.rs)?(/([^/]+?)(\.rs)?(/.*)?)?$")?;
+    let hunk_re = re(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@")?;
+    let xtask = diff.changed.iter().any(|f| f.starts_with("xtask/"));
+    for f in diff.changed {
+        let Some(c) = in_crate.captures(f) else { continue };
+        let (d, rest) = (c[1].to_string(), c[2].to_string());
+        if !ALL_CRATES.contains(&d.as_str()) {
+            continue;
+        }
+        let abs = root.join(f);
+        if let Some(t) = suite_file.captures(&rest) {
+            let key = format!("{d}:{}", &t[1]);
+            if !abs.is_file() {
+                continue;
+            }
+            if diff.untracked.iter().any(|u| u.eq_ignore_ascii_case(f)) {
+                p.whole.insert(key.clone());
+                p.why.insert(key, "new suite".into());
+                continue;
+            }
+            let all = scan::test_fns(&scan::read(&abs))?;
+            let mut outside = false;
+            for hk in (diff.hunks)(f) {
+                let Some(h) = hunk_re.captures(&hk) else { continue };
+                let s: usize = h[1].parse().unwrap_or(0);
+                let c: usize = h.get(2).and_then(|m| m.as_str().parse().ok()).unwrap_or(1);
+                let e = s.max((s + c).saturating_sub(1));
+                let lo = s.max(1);
+                let hit: Vec<_> = all.iter().filter(|t| t.start <= e && t.end >= lo).collect();
+                if hit.is_empty() {
+                    outside = true;
+                }
+                for t in hit {
+                    let set = if t.ignored { &mut p.ign } else { &mut p.fns };
+                    set.insert((key.clone(), t.name.clone()));
+                }
+            }
+            if outside {
+                p.whole.insert(key.clone());
+                p.why.insert(key, "suite changed outside its test fns".into());
+            }
+        } else if rest.to_ascii_lowercase().starts_with("tests/")
+            || rest.eq_ignore_ascii_case("Cargo.toml")
+            || rest.eq_ignore_ascii_case("build.rs")
+        {
+            for b in scan::binaries(root, &d) {
+                let key = format!("{d}:{b}");
+                p.whole.insert(key.clone());
+                p.why.insert(key, format!("shared test input {rest}"));
+            }
+            p.libs.insert(d);
+        } else if let Some(s) = src_file.captures(&rest) {
+            p.libs.insert(d.clone());
+            let m = s[1].to_string();
+            let sub = match s.get(4).map(|x| x.as_str()) {
+                Some(x) if x != "mod" && x != "tests" => x.to_string(),
+                _ => String::new(),
+            };
+            if !["lib", "main", "bin"].contains(&m.as_str()) {
+                p.mods.push((d, m, sub));
+            }
+        }
+    }
+    p.mods.sort_by(|a, b| {
+        ps_cmp(&a.0, &b.0).then_with(|| ps_cmp(&a.1, &b.1)).then_with(|| ps_cmp(&a.2, &b.2))
+    });
+    p.mods.dedup();
+    map_modules(root, &mut p, &mut plan.notes)?;
+    describe(&p, heavy, xtask, &mut plan.notes);
+    plan.steps = steps(p, heavy, xtask);
+    Ok(Quick::Plan(plan))
+}
+
+/// src modules -> the suites whose Gate map names them (own crate: `::mod` or `{..mod..}`; others:
+/// `crate::mod`). A file in a submodule picks the suites naming `mod::sub` or `mod (.. sub ..)` when
+/// there are any, else every suite naming the module.
+fn map_modules(root: &Path, p: &mut Picks, notes: &mut Vec<String>) -> Result<(), String> {
+    if p.mods.is_empty() {
+        return Ok(());
+    }
+    let mut maps: Vec<(String, String, String)> = Vec::new();
+    for d in ALL_CRATES {
+        for b in scan::binaries(root, d) {
+            let file = root.join("crates").join(d).join("tests").join(format!("{b}.rs"));
+            let gm = scan::gate_map(&scan::read(&file))?;
+            if !gm.is_empty() {
+                maps.push(((*d).to_string(), b, gm));
+            }
+        }
+    }
+    for (md, m, sub) in p.mods.clone() {
+        let (mm, ms) = (escape(&m), escape(&sub));
+        let own = re(&format!(r"(?i)::{mm}\b|\{{[^}}]*\b{mm}\b"))?;
+        let other = re(&format!(r"(?i)\b(camcraft_)?{md}::{mm}\b"))?;
+        let by_sub_re = re(&format!(r"(?i)(::|\{{[^}}]*\b){mm}(::{ms}\b|\s*\([^)]*\b{ms}\b)"))?;
+        let (mut by_sub, mut by_mod) = (Vec::new(), Vec::new());
+        for (d, b, gm) in &maps {
+            let hit = if *d == md { own.is_match(gm) } else { other.is_match(gm) };
+            if !hit {
+                continue;
+            }
+            by_mod.push(format!("{d}:{b}"));
+            if !sub.is_empty() && by_sub_re.is_match(gm) {
+                by_sub.push(format!("{d}:{b}"));
+            }
+        }
+        let use_sub = !by_sub.is_empty();
+        let pick = if use_sub { by_sub } else { by_mod };
+        let lbl = if use_sub { format!("{md}::{m}::{sub}") } else { format!("{md}::{m}") };
+        let shown_sub = if sub.is_empty() { String::new() } else { format!("::{sub}") };
+        notes.push(format!(
+            "  src {md}::{m}{shown_sub} -> {} suite(s) by gate map ({})",
+            pick.len(),
+            if use_sub { "submodule" } else { "module" }
+        ));
+        for k in pick {
+            p.whole.insert(k.clone());
+            p.why.entry(k).or_insert_with(|| format!("gate map names {lbl}"));
+        }
+    }
+    Ok(())
+}
+
+fn by_fn(set: &BTreeSet<(String, String)>) -> Vec<(String, String)> {
+    let mut v: Vec<_> = set.iter().cloned().collect();
+    v.sort_by(|a, b| ps_cmp(&a.0, &b.0).then_with(|| ps_cmp(&a.1, &b.1)));
+    v
+}
+
+fn describe(p: &Picks, heavy: bool, xtask: bool, notes: &mut Vec<String>) {
+    notes.push("quick plan:".into());
+    for d in ps_sorted(p.libs.iter().cloned()) {
+        notes.push(format!("  {d} lib (unit tests)"));
+    }
+    for k in ps_sorted(p.whole.iter().cloned()) {
+        let why = p.why.get(&k).map(String::as_str).unwrap_or("");
+        notes.push(format!("  {k}  whole suite - {why}"));
+    }
+    let ign_note = if heavy {
+        "  [ignored -> release --ignored]"
+    } else {
+        "  [ignored: heavy lane, skipped - pass --heavy or use `gate test <name>`]"
+    };
+    let mut both: Vec<(String, String, bool)> =
+        by_fn(&p.fns).into_iter().map(|(k, f)| (k, f, false)).collect();
+    both.extend(by_fn(&p.ign).into_iter().map(|(k, f)| (k, f, true)));
+    both.sort_by(|a, b| ps_cmp(&a.0, &b.0).then_with(|| ps_cmp(&a.1, &b.1)));
+    for (k, f, ig) in both {
+        if !p.whole.contains(&k) {
+            notes.push(format!("  {k}::{f}{}", if ig { ign_note } else { "" }));
+        }
+    }
+    if xtask {
+        notes.push("  xtask (unit tests) - xtask/ changed".into());
+    }
+    if p.libs.is_empty() && p.whole.is_empty() && p.fns.is_empty() && p.ign.is_empty() && !xtask {
+        notes.push("  nothing in crates/ changed: no tests to run".into());
+    }
+}
+
+fn steps(mut p: Picks, heavy: bool, xtask: bool) -> Vec<Step> {
+    let mut build_only: BTreeSet<String> = BTreeSet::new();
+    if !heavy {
+        build_only = p.ign.iter().map(|(k, _)| k.clone()).collect();
+        p.ign.clear();
+    }
+    let whole = ps_sorted(p.whole.iter().cloned());
+    let mut out = Vec::new();
+    for &d in ALL_CRATES {
+        let pk = pkg(d);
+        let mine = |k: &String| k.split(':').next() == Some(d);
+        let bin = |k: &String| k.split(':').nth(1).unwrap_or("").to_string();
+        let mut sel: Vec<String> = Vec::new();
+        if p.libs.contains(d) {
+            sel.push("--lib".into());
+        }
+        for k in whole.iter().filter(|k| mine(k)) {
+            sel.extend(["--test".to_string(), bin(k)]);
+        }
+        if !sel.is_empty() {
+            let base = Step::new(format!("{d} suites"), &["test", "-j", J, "-p", &pk, "--no-fail-fast"], d);
+            out.push(base.with(&sel).with(&["--".into(), T.into()]));
+        }
+        // A suite whose only changed fns are skipped heavy ones still has to compile.
+        let mut bo: Vec<String> = Vec::new();
+        for k in ps_sorted(build_only.iter().cloned()).iter().filter(|k| mine(k)) {
+            if !p.whole.contains(k) && !p.fns.iter().any(|(fk, _)| fk == k) {
+                bo.extend(["--test".to_string(), bin(k)]);
+            }
+        }
+        if !bo.is_empty() {
+            let name = format!("{d} build-only (changed fns are heavy lane)");
+            out.push(Step::new(name, &["test", "-j", J, "-p", &pk, "--no-run"], d).with(&bo));
+        }
+        for (set, is_ign) in [(&p.fns, false), (&p.ign, true)] {
+            let mut groups: BTreeMap<String, Vec<String>> = BTreeMap::new();
+            for (k, f) in by_fn(set) {
+                if mine(&k) && !p.whole.contains(&k) {
+                    groups.entry(k).or_default().push(f);
+                }
+            }
+            let mut keys: Vec<String> = groups.keys().cloned().collect();
+            keys.sort_by(|a, b| ps_cmp(a, b));
+            for k in keys {
+                let names = groups.remove(&k).unwrap_or_default();
+                let b = bin(&k);
+                let tag = if is_ign { ", ignored, release" } else { "" };
+                let name = format!("{d} {b} ({} fn{tag})", names.len());
+                let mut args: Vec<String> = vec!["test".into()];
+                if is_ign {
+                    args.push("--release".into());
+                }
+                for a in ["-j", J, "-p", &pk, "--test", &b, "--", T] {
+                    args.push(a.into());
+                }
+                if is_ign {
+                    args.push("--ignored".into());
+                }
+                args.push("--exact".into());
+                args.extend(names);
+                out.push(Step::new(name, &[], d).with(&args));
+            }
+        }
+    }
+    if xtask {
+        out.push(Step::new("xtask unit tests", &["test", "-j", J, "-p", "xtask", "--", T], ""));
+    }
+    out
+}
diff --git a/xtask/src/release.rs b/xtask/src/release.rs
new file mode 100644
index 00000000..4895c331
--- /dev/null
+++ b/xtask/src/release.rs
@@ -0,0 +1,380 @@
+//! `cargo xtask release --version X.Y.Z --no-tag`: the release cut's ten phases (preflight, gate,
+//! version bump, commit, release build, version check, signing, zip / packages, installer, summary),
+//! one implementation on Windows, macOS and Linux. Signing and the Inno Setup installer stay in
+//! scripts/sign.ps1 / installer.ps1 (Windows); macOS, Linux and FreeBSD hand off to package-*.sh.
+//! Provenance: our own release law (AGENTS.md "A cut goes PR review -> merge to main -> tag"), ported
+//! from scripts/release.ps1 (#749).
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+use crate::decisions::valid_version;
+use crate::exec::{self, git};
+use crate::release_bump as bump;
+use crate::release_pack::{self as pack, Os};
+
+pub const CO_AUTHOR: &str = "Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>";
+
+/// Parsed `release` options (release.ps1's switches, in kebab case).
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct ReleaseArgs {
+    pub version: String,
+    pub title: String,
+    pub no_tag: bool,
+    pub skip_gate: bool,
+    pub skip_build: bool,
+    pub installer: bool,
+    pub dry: bool,
+}
+
+pub fn parse(args: &[String]) -> Result<ReleaseArgs, String> {
+    let mut r = ReleaseArgs { title: "release".into(), ..ReleaseArgs::default() };
+    let mut it = args.iter();
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "--version" => r.version = it.next().cloned().ok_or("--version needs X.Y.Z")?,
+            "--title" => r.title = it.next().cloned().ok_or("--title needs a value")?,
+            "--no-tag" => r.no_tag = true,
+            "--skip-gate" => r.skip_gate = true,
+            "--skip-build" => r.skip_build = true,
+            "--installer" => r.installer = true,
+            "--dry-run" => r.dry = true,
+            s => return Err(format!("unknown release option '{s}'")),
+        }
+    }
+    if r.version.is_empty() {
+        return Err("release needs --version X.Y.Z".into());
+    }
+    Ok(r)
+}
+
+/// One cut: its options, the host and every line it printed (the tests read them back).
+pub struct Cut {
+    pub root: PathBuf,
+    pub a: ReleaseArgs,
+    pub os: Os,
+    pub out: Vec<String>,
+}
+
+impl Cut {
+    pub fn new(root: &Path, a: ReleaseArgs, os: Os) -> Cut {
+        Cut { root: root.to_path_buf(), a, os, out: Vec::new() }
+    }
+
+    fn say(&mut self, line: impl Into<String>) {
+        let line = line.into();
+        println!("{line}");
+        self.out.push(line);
+    }
+
+    fn banner(&mut self, n: u8, text: &str) {
+        self.say("");
+        self.say(format!("=== Phase {n}/10: {text} ==="));
+    }
+
+    /// Runs a command at the root (or `cwd`); a dry run prints it instead. Non-zero exit fails the cut.
+    fn run(&mut self, exe: &str, args: &[String], env: &[(&str, &Path)]) -> Result<(), String> {
+        let line = format!("{exe} {}", args.join(" "));
+        if self.a.dry {
+            self.say(format!("[dry-run] {line}"));
+            return Ok(());
+        }
+        self.say(format!("> {line}"));
+        let program = if exe == "cargo" { exec::cargo() } else { exe.to_string() };
+        let mut c = Command::new(program);
+        c.args(args).current_dir(&self.root).stdin(Stdio::null());
+        for (k, v) in env {
+            c.env(k, v);
+        }
+        let st = c.status().map_err(|e| format!("'{line}': {e}"))?;
+        match st.code() {
+            Some(0) => Ok(()),
+            code => Err(format!("'{line}' exited with {}", code.map_or("a signal".into(), |c| c.to_string()))),
+        }
+    }
+
+    fn powershell(&mut self, script: &str, rest: &[String]) -> Result<(), String> {
+        let path = self.root.join("scripts").join(script);
+        let mut a: Vec<String> = ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"].map(String::from).to_vec();
+        a.push(path.display().to_string());
+        a.extend(rest.iter().cloned());
+        self.run("powershell", &a, &[])
+    }
+
+    fn dist(&self) -> PathBuf {
+        self.root.join("dist")
+    }
+
+    /// All ten phases; `Err` is the refusal printed as `RELEASE FAILED`.
+    pub fn phases(&mut self) -> Result<(), String> {
+        let v = self.a.version.clone();
+        if !valid_version(&v) {
+            return Err(format!("--version must be X.Y.Z, got '{v}'"));
+        }
+        if self.a.installer && self.os != Os::Windows {
+            return Err(format!(
+                "--installer builds the Inno Setup installer (scripts/installer.ps1), Windows only; not on {}",
+                self.os.name()
+            ));
+        }
+        if self.os == Os::Other {
+            return Err(format!("no release packaging for {}: windows, linux, macos and freebsd only", self.os.name()));
+        }
+        if self.a.dry {
+            self.say("DRY RUN: nothing below changes state.");
+        }
+        self.preflight(&v)?;
+        self.gate()?;
+        self.bump(&v)?;
+        self.commit(&v)?;
+        self.build()?;
+        self.verify(&v)?;
+        self.sign()?;
+        self.package(&v)?;
+        self.installer(&v)?;
+        self.summary(&v)
+    }
+
+    fn preflight(&mut self, v: &str) -> Result<(), String> {
+        self.banner(1, "preflight");
+        let dirty = bump::unexpected_changes(&git(&self.root, &["status", "--porcelain"])?);
+        if dirty.is_empty() {
+            self.say("tree clean (ignoring release files)");
+        } else {
+            self.say("Unexpected changes:");
+            for d in &dirty {
+                self.say(format!("  {d}"));
+            }
+            if !self.a.dry {
+                return Err("working tree not clean".into());
+            }
+            self.say("[dry-run] would fail here");
+        }
+        let branch = git(&self.root, &["rev-parse", "--abbrev-ref", "HEAD"])?.trim().to_string();
+        // Branch/PR flow: the bump is committed on release/vX.Y.Z with --no-tag, never on main; main is
+        // branch-protected, so a tagging run (the legacy direct cut) has nowhere left to run.
+        if self.a.no_tag && branch == "main" {
+            return Err(format!("--no-tag runs on a release/v{v} branch, not on main"));
+        }
+        if !self.a.no_tag {
+            return Err(format!(
+                "main is branch-protected (PR only): cut on release/v{v} with --no-tag and tag main after the release PR merges"
+            ));
+        }
+        if !git(&self.root, &["tag", "--list", &format!("v{v}")])?.trim().is_empty() {
+            return Err(format!("tag v{v} already exists"));
+        }
+        let notes = std::fs::read_to_string(self.root.join("RELEASE_NOTES.md"))
+            .map_err(|e| format!("RELEASE_NOTES.md: {e}"))?;
+        let n = bump::check_notes(&notes, v)?;
+        self.say(format!("RELEASE_NOTES.md: {v} section ({n} lines) above the history"));
+        self.say(format!("tag v{v} is free"));
+        Ok(())
+    }
+
+    /// The release gate tier, run in this process (not as a nested `cargo xtask gate release`, which
+    /// would make cargo rebuild the xtask exe that is running - locked on Windows).
+    fn gate(&mut self) -> Result<(), String> {
+        self.banner(2, "gate");
+        if self.a.skip_gate {
+            self.say("skipped (--skip-gate)");
+            return Ok(());
+        }
+        self.say("cargo xtask gate release (in process)");
+        let mut run = exec::Run::new(&self.root, "release", self.a.dry)?;
+        run.plan(&crate::plan::release(&self.root))?;
+        if run.summary() != 0 {
+            return Err("the release gate failed (logs under gate-logs/)".into());
+        }
+        Ok(())
+    }
+
+    fn bump(&mut self, v: &str) -> Result<(), String> {
+        self.banner(3, "version bump");
+        let toml_path = self.root.join("Cargo.toml");
+        let toml = std::fs::read_to_string(&toml_path).map_err(|e| format!("Cargo.toml: {e}"))?;
+        let (old, new_toml) = bump::bump_toml(&toml, v)?;
+        self.say(format!("workspace version: {old} -> {v}"));
+        if self.a.dry {
+            self.say("[dry-run] would rewrite Cargo.toml version and the workspace packages in Cargo.lock");
+            self.say("[dry-run] cargo update -w -q");
+            self.say("[dry-run] would assert Cargo.lock diff touches only version lines");
+            return Ok(());
+        }
+        std::fs::write(&toml_path, new_toml).map_err(|e| format!("write Cargo.toml: {e}"))?;
+        let lock_path = self.root.join("Cargo.lock");
+        let lock = std::fs::read_to_string(&lock_path).map_err(|e| format!("Cargo.lock: {e}"))?;
+        let (new_lock, n) = bump::bump_lock(&lock, &old, v);
+        std::fs::write(&lock_path, new_lock).map_err(|e| format!("write Cargo.lock: {e}"))?;
+        self.say(format!("Cargo.lock: {n} workspace package(s) moved to {v}"));
+        self.run("cargo", &["update".into(), "-w".into(), "-q".into()], &[])?;
+        let lines = bump::lock_diff_versions_only(&git(&self.root, &["diff", "Cargo.lock"])?)?;
+        self.say(format!("Cargo.lock: {lines} version lines changed, nothing else"));
+        Ok(())
+    }
+
+    fn commit(&mut self, v: &str) -> Result<(), String> {
+        self.banner(4, "commit and tag");
+        let title = self.a.title.clone();
+        if self.a.dry {
+            self.say("[dry-run] git add Cargo.toml RELEASE_NOTES.md TESTING.md RECOMMENDED.md (if changed)");
+            self.say(format!("[dry-run] git commit -m 'chore(release): {v} - {title}' (+ Co-Authored-By)"));
+            self.say(format!("[dry-run] git add Cargo.lock; git commit -m 'chore(release): sync Cargo.lock to {v}'"));
+            self.say("[dry-run] no tag (--no-tag): tag main after the release PR merges");
+            return Ok(());
+        }
+        for f in ["Cargo.toml", "RELEASE_NOTES.md", "TESTING.md", "RECOMMENDED.md"] {
+            if !git(&self.root, &["status", "--porcelain", "--", f])?.trim().is_empty() {
+                git(&self.root, &["add", "--", f])?;
+            }
+        }
+        let s = |x: &str| x.to_string();
+        self.run("git", &[s("commit"), s("-m"), format!("chore(release): {v} - {title}\n\n{CO_AUTHOR}")], &[])?;
+        self.run("git", &[s("add"), s("Cargo.lock")], &[])?;
+        self.run("git", &[s("commit"), s("-m"), format!("chore(release): sync Cargo.lock to {v}\n\n{CO_AUTHOR}")], &[])?;
+        self.say("no tag (--no-tag): tag main after the release PR merges");
+        Ok(())
+    }
+
+    fn build(&mut self) -> Result<(), String> {
+        self.banner(5, "release build");
+        if self.a.skip_build {
+            self.say("skipped (--skip-build)");
+            return Ok(());
+        }
+        for args in pack::build_steps(self.os) {
+            self.run("cargo", &args, &[])?;
+        }
+        Ok(())
+    }
+
+    fn verify(&mut self, v: &str) -> Result<(), String> {
+        let post = pack::bin_dir(&self.root, self.os).join(format!("post{}", self.os.exe()));
+        self.banner(6, &format!("verify post{} version", self.os.exe()));
+        if self.a.dry {
+            self.say(format!("[dry-run] {} --version must report {v}", post.display()));
+            return Ok(());
+        }
+        if !post.is_file() {
+            return Err(format!("{} missing (run without --skip-build)", post.display()));
+        }
+        let out = Command::new(&post).arg("--version").output().map_err(|e| format!("{}: {e}", post.display()))?;
+        if !out.status.success() {
+            return Err(format!("{} --version failed", post.display()));
+        }
+        let text = String::from_utf8_lossy(&out.stdout).into_owned();
+        let reported = text.split_whitespace().nth(1).unwrap_or_default().to_string();
+        if reported != v {
+            return Err(format!("post reports '{reported}', expected {v}"));
+        }
+        self.say(format!("post reports {reported}"));
+        Ok(())
+    }
+
+    /// Before staging, so the zip and the installer carry the same signed exes. sign.ps1 is a named
+    /// no-op without a CAMCRAFT_SIGN_* certificate: an unsigned cut is still a cut.
+    fn sign(&mut self) -> Result<(), String> {
+        self.banner(7, "sign binaries");
+        if self.os != Os::Windows {
+            self.say(format!(
+                "skipped on {}: sign.ps1 is Windows Authenticode (package-macos.sh codesigns its own bundle)",
+                self.os.name()
+            ));
+            return Ok(());
+        }
+        let bin = pack::bin_dir(&self.root, self.os);
+        let exes: Vec<String> = pack::EXES.iter().map(|e| bin.join(format!("{e}.exe")).display().to_string()).collect();
+        if self.a.skip_build && !self.a.dry && !exes.first().is_some_and(|e| Path::new(e).is_file()) {
+            self.say("skipped (no release exes; --skip-build)");
+            return Ok(());
+        }
+        let mut rest = vec!["-Path".to_string()];
+        rest.extend(exes);
+        self.powershell("sign.ps1", &rest)
+    }
+
+    fn package(&mut self, v: &str) -> Result<(), String> {
+        let bin = pack::bin_dir(&self.root, self.os);
+        let Some(script) = self.os.packager() else {
+            self.banner(8, "assemble zip");
+            let stage = self.dist().join(pack::stage_name(v));
+            let zip = self.dist().join(format!("{}.zip", pack::stage_name(v)));
+            let list = pack::stage_list(&self.root, &bin, self.os)?;
+            if self.a.dry {
+                let roots = "exes (camcraft-ui, camcraft-cli, post), assets/{posts,machines,ui,scripts,themes}, RELEASE_NOTES.md, TESTING.md, LICENSE, NOTICE";
+                self.say(format!("[dry-run] stage {} : {roots} ({} files)", stage.display(), list.len()));
+            } else {
+                let n = pack::stage(&list, &stage)?;
+                self.say(format!("staged {n} files in {}", stage.display()));
+            }
+            let cmd = format!(
+                "Compress-Archive -Path '{}' -DestinationPath '{}' -Force",
+                stage.display().to_string().replace('\'', "''"),
+                zip.display().to_string().replace('\'', "''")
+            );
+            return self.run("powershell", &["-NoProfile".into(), "-Command".into(), cmd], &[]);
+        };
+        self.banner(8, &format!("package ({script})"));
+        let bash_args = [self.root.join(script).display().to_string()];
+        self.run("bash", &bash_args, &[("CAMCRAFT_BIN_DIR", &bin)])
+    }
+
+    /// Opt-in, Windows only (refused by name elsewhere before phase 1): the same staged tree as the zip.
+    fn installer(&mut self, v: &str) -> Result<(), String> {
+        self.banner(9, "installer");
+        let setup = self.dist().join(format!("{}-setup.exe", pack::stage_name(v)));
+        if !self.a.installer {
+            let why = if self.os == Os::Windows {
+                format!("pass --installer to build {} with Inno Setup", pack::stage_name(v) + "-setup.exe")
+            } else {
+                "the Inno Setup installer is Windows only".into()
+            };
+            self.say(format!("skipped ({why})"));
+            return Ok(());
+        }
+        let stage = self.dist().join(pack::stage_name(v)).display().to_string();
+        let dist = self.dist().display().to_string();
+        let rest = ["-Version".to_string(), v.to_string(), "-Stage".into(), stage, "-OutDir".into(), dist];
+        self.powershell("installer.ps1", &rest)?;
+        // installer.ps1 signs the setup exe and its embedded uninstaller through ISCC's SignTool when a
+        // certificate is configured (sign.ps1 decides): no separate signing pass here.
+        if self.a.dry {
+            self.say("[dry-run] installer.ps1 signs setup + uninstaller via ISCC SignTool if CAMCRAFT_SIGN_* is set");
+        } else if !setup.is_file() {
+            self.say("no installer produced (ISCC.exe missing); the zip is the release");
+        }
+        Ok(())
+    }
+
+    fn summary(&mut self, v: &str) -> Result<(), String> {
+        self.banner(10, "done");
+        if self.os == Os::Windows {
+            let zip = self.dist().join(format!("{}.zip", pack::stage_name(v)));
+            self.say(format!("Zip: {}", zip.display()));
+            let setup = self.dist().join(format!("{}-setup.exe", pack::stage_name(v)));
+            if self.a.installer && setup.is_file() {
+                self.say(format!("Installer: {}", setup.display()));
+            }
+        } else {
+            self.say(format!("Packages: {}", self.dist().display()));
+        }
+        let branch = git(&self.root, &["rev-parse", "--abbrev-ref", "HEAD"])?.trim().to_string();
+        self.say(format!("Next: git push -u origin {branch}; gh pr create --base main --title 'chore(release): {v}'"));
+        self.say(format!("      record tip=$(git rev-parse {branch}) before merging; after it merges: git switch main; git pull --ff-only;"));
+        self.say(format!("      git diff $tip main must be empty, then git tag -a v{v} -m 'CamCraft {v}' main; git push origin v{v}"));
+        self.say("NOTHING WAS PUSHED. Pushing is left to you.");
+        Ok(())
+    }
+}
+
+/// `cargo xtask release`: the exit code (0 done, 1 refused or failed).
+pub fn release(root: &Path, a: ReleaseArgs) -> i32 {
+    let mut cut = Cut::new(root, a, Os::host());
+    match cut.phases() {
+        Ok(()) => 0,
+        Err(e) => {
+            cut.say(format!("RELEASE FAILED: {e}"));
+            1
+        }
+    }
+}
diff --git a/xtask/src/release_bump.rs b/xtask/src/release_bump.rs
new file mode 100644
index 00000000..5690ff3c
--- /dev/null
+++ b/xtask/src/release_bump.rs
@@ -0,0 +1,103 @@
+//! The text edits and checks of a release cut: the RELEASE_NOTES.md section check, the workspace
+//! version bump in Cargo.toml and Cargo.lock, the Cargo.lock diff guard and the preflight's dirty-tree
+//! filter. Pure functions on text, so the unit tests pin them on fixtures.
+//! Provenance: our own release law (AGENTS.md "Commits and Releases", #272), ported from
+//! scripts/release.ps1 phases 1 and 3 (#749); Cargo.lock's format per the Cargo book ("Cargo.lock").
+
+use crate::scan::re;
+
+/// Files a cut may find changed before it starts: it commits them itself.
+pub const ALLOWED_DIRTY: &[&str] = &["RELEASE_NOTES.md", "TESTING.md", "Cargo.toml", "Cargo.lock", "RECOMMENDED.md"];
+
+/// The paths `git status --porcelain` reports that a cut does not commit itself.
+pub fn unexpected_changes(porcelain: &str) -> Vec<String> {
+    porcelain
+        .lines()
+        .filter(|l| l.len() > 3)
+        .map(|l| l.get(3..).unwrap_or_default().trim_matches('"').to_string())
+        .filter(|p| !ALLOWED_DIRTY.contains(&p.as_str()))
+        .collect()
+}
+
+/// RELEASE_NOTES.md keeps every release, newest first; release.yml's publish job takes everything
+/// before the first `---` line as this version's notes. The section must be there, be this version's
+/// and not be empty (#272). The section's line count on success.
+pub fn check_notes(text: &str, version: &str) -> Result<usize, String> {
+    let lines: Vec<&str> = text.lines().map(str::trim_end).collect();
+    let end = lines.iter().position(|l| *l == "---").ok_or_else(|| {
+        "RELEASE_NOTES.md has no '---' line: put this version's section on top of the history, separated by '---'"
+            .to_string()
+    })?;
+    if end <= 1 {
+        return Err(format!("RELEASE_NOTES.md has no notes for {version} before its first '---'"));
+    }
+    let head = lines.first().map(|h| h.trim_start_matches('\u{feff}')).unwrap_or_default();
+    if !head.contains(version) {
+        return Err(format!("RELEASE_NOTES.md's first section is '{head}', not {version}"));
+    }
+    if lines.get(1..end).unwrap_or_default().join("\n").trim().is_empty() {
+        return Err(format!("RELEASE_NOTES.md's {version} section is empty"));
+    }
+    Ok(end - 1)
+}
+
+/// `[workspace.package] version = "..."` set to `new`: (old version, new text). Everything else in the
+/// manifest is kept byte for byte.
+pub fn bump_toml(text: &str, new: &str) -> Result<(String, String), String> {
+    let r = re(r#"(?s)(\[workspace\.package\].*?\r?\nversion\s*=\s*")([^"]+)(")"#)?;
+    let m = r
+        .captures(text)
+        .and_then(|c| c.get(2))
+        .ok_or_else(|| "no version in [workspace.package]".to_string())?;
+    let (head, tail) = (text.get(..m.start()), text.get(m.end()..));
+    let (head, tail) = head.zip(tail).ok_or_else(|| "version span off a char boundary".to_string())?;
+    Ok((m.as_str().to_string(), format!("{head}{new}{tail}")))
+}
+
+/// Every `[[package]]` of Cargo.lock without a `source` line (a workspace path package) at version
+/// `old` moved to `new`: (new text, packages changed). Registry and git packages are never touched,
+/// whatever their version. `cargo update -w` afterwards finds nothing left to do.
+pub fn bump_lock(text: &str, old: &str, new: &str) -> (String, usize) {
+    let from = format!("version = \"{old}\"");
+    let to = format!("version = \"{new}\"");
+    let mut blocks: Vec<Vec<&str>> = vec![Vec::new()];
+    for line in text.split_inclusive('\n') {
+        if line.trim_end() == "[[package]]" {
+            blocks.push(Vec::new());
+        }
+        if let Some(b) = blocks.last_mut() {
+            b.push(line);
+        }
+    }
+    let (mut out, mut n) = (String::with_capacity(text.len()), 0);
+    for (i, block) in blocks.iter().enumerate() {
+        let local = i > 0 && !block.iter().any(|l| l.starts_with("source = "));
+        for line in block {
+            if local && line.trim_end() == from {
+                out.push_str(&line.replacen(&from, &to, 1));
+                n += 1;
+            } else {
+                out.push_str(line);
+            }
+        }
+    }
+    (out, n)
+}
+
+/// `git diff Cargo.lock` after the bump may change version lines only: the number changed, or the
+/// refusal.
+pub fn lock_diff_versions_only(diff: &str) -> Result<usize, String> {
+    let changed = diff
+        .lines()
+        .filter(|l| {
+            let mut c = l.chars();
+            matches!(c.next(), Some('-' | '+')) && !matches!(c.next(), None | Some('-' | '+'))
+        })
+        .count();
+    let versions = diff.lines().filter(|l| l.starts_with("-version") || l.starts_with("+version")).count();
+    if changed == versions {
+        Ok(versions)
+    } else {
+        Err("Cargo.lock changed beyond version lines".into())
+    }
+}
diff --git a/xtask/src/release_pack.rs b/xtask/src/release_pack.rs
new file mode 100644
index 00000000..8b343f8f
--- /dev/null
+++ b/xtask/src/release_pack.rs
@@ -0,0 +1,162 @@
+//! What a release cut builds and ships per OS: the product packages, the binaries' dir, the portable
+//! zip's staged tree (the same layout as .github/workflows/release.yml's Windows job) and the
+//! packaging script each OS hands off to.
+//! Provenance: our own release law (AGENTS.md "Commits and Releases"), ported from scripts/release.ps1
+//! phases 5-8 and release.yml's staging (#749).
+
+use std::path::{Path, PathBuf};
+
+/// The host a cut runs on: decides the exe suffix, signing, the zip and the packager.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Os {
+    Windows,
+    Linux,
+    Macos,
+    FreeBsd,
+    Other,
+}
+
+impl Os {
+    pub fn host() -> Os {
+        match std::env::consts::OS {
+            "windows" => Os::Windows,
+            "linux" => Os::Linux,
+            "macos" => Os::Macos,
+            "freebsd" => Os::FreeBsd,
+            _ => Os::Other,
+        }
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            Os::Windows => "windows",
+            Os::Linux => "linux",
+            Os::Macos => "macos",
+            Os::FreeBsd => "freebsd",
+            Os::Other => std::env::consts::OS,
+        }
+    }
+    pub fn exe(self) -> &'static str {
+        if self == Os::Windows { ".exe" } else { "" }
+    }
+    /// The script that packages this OS's release, as release.yml runs it (AppImage, snap and flatpak
+    /// need CI-only tooling and stay in release.yml). Windows packs its zip here, in Rust.
+    pub fn packager(self) -> Option<&'static str> {
+        match self {
+            Os::Linux => Some("scripts/package-linux.sh"),
+            Os::Macos => Some("scripts/package-macos.sh"),
+            Os::FreeBsd => Some("scripts/package-freebsd.sh"),
+            Os::Windows | Os::Other => None,
+        }
+    }
+}
+
+/// The shipped executables (names without the OS suffix).
+pub const EXES: &[&str] = &["camcraft-ui", "camcraft-cli", "post"];
+/// The packages the release build compiles - the product only, as release.yml does. Never `xtask`:
+/// on Windows the running xtask.exe is locked, and rebuilding it mid-cut fails the build.
+pub const PRODUCT: &[&str] = &["camcraft-ui", "camcraft-app", "camcraft-post"];
+/// Asset dirs copied beside the executables, whole.
+pub const ASSET_DIRS: &[&str] = &["assets/posts", "assets/machines", "assets/ui", "assets/scripts", "assets/themes"];
+/// Top-level files copied beside the executables (release.yml ships NOTICE too).
+pub const DOCS: &[&str] = &["RELEASE_NOTES.md", "TESTING.md", "LICENSE", "NOTICE"];
+
+/// The macOS triple of this host's architecture; the universal build makes both.
+pub fn mac_triple() -> &'static str {
+    if std::env::consts::ARCH == "aarch64" { "aarch64-apple-darwin" } else { "x86_64-apple-darwin" }
+}
+
+/// cargo's target dir: CARGO_TARGET_DIR (relative to the workspace root) when set, else `target`.
+pub fn target_dir(root: &Path) -> PathBuf {
+    match std::env::var_os("CARGO_TARGET_DIR").filter(|v| !v.is_empty()) {
+        Some(v) => root.join(v),
+        None => root.join("target"),
+    }
+}
+
+/// Where the release build leaves this host's executables.
+pub fn bin_dir(root: &Path, os: Os) -> PathBuf {
+    let t = target_dir(root);
+    if os == Os::Macos { t.join(mac_triple()).join("release") } else { t.join("release") }
+}
+
+/// The cargo argument lists of the release build: the product packages, one build per target (macOS
+/// builds both architectures for the universal app, as release.yml does).
+pub fn build_steps(os: Os) -> Vec<Vec<String>> {
+    let base = |target: Option<&str>| {
+        let mut a: Vec<String> = ["build", "-j", "6", "--release"].iter().map(|s| (*s).to_string()).collect();
+        if let Some(t) = target {
+            a.push("--target".into());
+            a.push(t.into());
+        }
+        for p in PRODUCT {
+            a.push("-p".into());
+            a.push((*p).into());
+        }
+        a
+    };
+    if os == Os::Macos {
+        vec![base(Some("aarch64-apple-darwin")), base(Some("x86_64-apple-darwin"))]
+    } else {
+        vec![base(None)]
+    }
+}
+
+/// The Windows zip's stage dir name; the zip and the installer are named after it.
+pub fn stage_name(version: &str) -> String {
+    format!("camcraft-{version}-win-x64")
+}
+
+fn files_under(dir: &Path, out: &mut Vec<PathBuf>) -> Result<(), String> {
+    let rd = std::fs::read_dir(dir).map_err(|e| format!("{}: {e} (nothing to stage)", dir.display()))?;
+    let mut entries: Vec<PathBuf> = rd.filter_map(Result::ok).map(|e| e.path()).collect();
+    entries.sort();
+    for p in entries {
+        if p.is_dir() {
+            files_under(&p, out)?;
+        } else {
+            out.push(p);
+        }
+    }
+    Ok(())
+}
+
+/// Every file of the staged tree: (source, path inside the stage). The executables come from `bin`
+/// (they need not exist yet: a dry run lists them all the same); the assets and docs from `root`.
+pub fn stage_list(root: &Path, bin: &Path, os: Os) -> Result<Vec<(PathBuf, PathBuf)>, String> {
+    let mut list = Vec::new();
+    for e in EXES {
+        let name = format!("{e}{}", os.exe());
+        list.push((bin.join(&name), PathBuf::from(name)));
+    }
+    for d in ASSET_DIRS {
+        let mut files = Vec::new();
+        files_under(&root.join(d), &mut files)?;
+        for f in files {
+            let rel = f.strip_prefix(root).map_err(|e| format!("{}: {e}", f.display()))?.to_path_buf();
+            list.push((f, rel));
+        }
+    }
+    for d in DOCS {
+        let p = root.join(d);
+        if !p.is_file() {
+            return Err(format!("{d} missing: nothing to stage"));
+        }
+        list.push((p, PathBuf::from(d)));
+    }
+    Ok(list)
+}
+
+/// Builds the stage dir afresh from the list; the number of files copied.
+pub fn stage(list: &[(PathBuf, PathBuf)], dir: &Path) -> Result<usize, String> {
+    if dir.exists() {
+        std::fs::remove_dir_all(dir).map_err(|e| format!("remove {}: {e}", dir.display()))?;
+    }
+    for (src, rel) in list {
+        let dst = dir.join(rel);
+        if let Some(parent) = dst.parent() {
+            std::fs::create_dir_all(parent).map_err(|e| format!("create {}: {e}", parent.display()))?;
+        }
+        std::fs::copy(src, &dst).map_err(|e| format!("copy {} -> {}: {e}", src.display(), dst.display()))?;
+    }
+    Ok(list.len())
+}
diff --git a/xtask/src/release_tests.rs b/xtask/src/release_tests.rs
new file mode 100644
index 00000000..c968ab83
--- /dev/null
+++ b/xtask/src/release_tests.rs
@@ -0,0 +1,238 @@
+//! Pins the release cut: the version bump on Cargo.toml / Cargo.lock fixture text, the Cargo.lock diff
+//! guard, the RELEASE_NOTES.md check, the staged zip layout, and the dry run's phase list on a
+//! throwaway git repo.
+//! Provenance: our own release law (AGENTS.md "Commits and Releases"), #749.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use crate::release::{Cut, ReleaseArgs, parse};
+use crate::release_bump::{bump_lock, bump_toml, check_notes, lock_diff_versions_only, unexpected_changes};
+use crate::release_pack::{self as pack, Os};
+
+struct Repo(PathBuf);
+
+impl Drop for Repo {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn write(root: &Path, rel: &str, text: &str) {
+    let p = root.join(rel);
+    if let Some(d) = p.parent() {
+        std::fs::create_dir_all(d).expect("fixture dir");
+    }
+    std::fs::write(p, text).expect("fixture file");
+}
+
+fn git(root: &Path, args: &[&str]) {
+    let st = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(["-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false"])
+        .args(args)
+        .output()
+        .expect("git runs");
+    assert!(st.status.success(), "git {args:?}: {}", String::from_utf8_lossy(&st.stderr));
+}
+
+const TOML: &str = "[workspace]\nmembers = [\"a\"]\n\n[workspace.package]\nversion = \"0.16.0\"\nedition = \"2024\"\n\n[workspace.dependencies]\nregex = { version = \"1\" }\n";
+const LOCK: &str = "# auto\nversion = 4\n\n[[package]]\nname = \"camcraft-app\"\nversion = \"0.16.0\"\ndependencies = [\n \"regex\",\n]\n\n[[package]]\nname = \"other\"\nversion = \"0.16.0\"\nsource = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"ab\"\n\n[[package]]\nname = \"xtask\"\nversion = \"0.16.0\"\n";
+
+/// A fixture workspace: manifest, lock, notes for `version`, the shipped assets and docs.
+fn repo(branch: &str, version: &str) -> Repo {
+    static N: AtomicUsize = AtomicUsize::new(0);
+    let root = std::env::temp_dir().join(format!(
+        "xtask-release-{}-{}",
+        std::process::id(),
+        N.fetch_add(1, Ordering::SeqCst)
+    ));
+    let _ = std::fs::remove_dir_all(&root);
+    write(&root, "Cargo.toml", TOML);
+    write(&root, "Cargo.lock", LOCK);
+    write(&root, "RELEASE_NOTES.md", &format!("# CamCraft {version}\n\nnew things\n\n---\n\n# CamCraft 0.16.0\n"));
+    for f in [
+        "assets/posts/fanuc.cps",
+        "assets/machines/vmc.json",
+        "assets/ui/cube.png",
+        "assets/ui/fonts/sans.ttf",
+        "assets/scripts/job.js",
+        "assets/themes/dark.json",
+        "TESTING.md",
+        "LICENSE",
+        "NOTICE",
+    ] {
+        write(&root, f, "x");
+    }
+    git(&root, &["init", "-q", "-b", branch]);
+    git(&root, &["add", "-A"]);
+    git(&root, &["commit", "-q", "-m", "fixture"]);
+    Repo(root)
+}
+
+fn args(version: &str) -> ReleaseArgs {
+    ReleaseArgs { version: version.into(), title: "release".into(), no_tag: true, dry: true, ..ReleaseArgs::default() }
+}
+
+fn banners(cut: &Cut) -> Vec<String> {
+    cut.out.iter().filter(|l| l.starts_with("=== ")).cloned().collect()
+}
+
+#[test]
+fn bump_toml_moves_only_the_workspace_version() {
+    let (old, new) = bump_toml(TOML, "0.17.0").expect("bump");
+    assert_eq!(old, "0.16.0");
+    assert_eq!(new, TOML.replace("version = \"0.16.0\"", "version = \"0.17.0\""));
+    assert!(new.contains("regex = { version = \"1\" }"));
+    let crlf = TOML.replace('\n', "\r\n");
+    let (_, new) = bump_toml(&crlf, "0.17.0").expect("crlf bump");
+    assert!(new.contains("[workspace.package]\r\nversion = \"0.17.0\"\r\n"));
+    assert!(bump_toml("[package]\nversion = \"1.0.0\"\n", "2.0.0").is_err());
+}
+
+#[test]
+fn bump_lock_moves_workspace_packages_not_registry_ones() {
+    let (new, n) = bump_lock(LOCK, "0.16.0", "0.17.0");
+    assert_eq!(n, 2, "camcraft-app and xtask");
+    assert!(new.contains("name = \"camcraft-app\"\nversion = \"0.17.0\"\n"));
+    assert!(new.contains("name = \"xtask\"\nversion = \"0.17.0\"\n"));
+    assert!(new.contains("name = \"other\"\nversion = \"0.16.0\"\nsource"), "registry package untouched");
+    assert!(new.starts_with("# auto\nversion = 4\n"), "the lock format version is not a package version");
+    let (crlf, n) = bump_lock(&LOCK.replace('\n', "\r\n"), "0.16.0", "0.17.0");
+    assert_eq!(n, 2);
+    assert!(crlf.contains("name = \"xtask\"\r\nversion = \"0.17.0\"\r\n"));
+}
+
+#[test]
+fn lock_diff_guard_takes_version_lines_only() {
+    let ok = "--- a/Cargo.lock\n+++ b/Cargo.lock\n@@ -1 +1 @@\n-version = \"0.16.0\"\n+version = \"0.17.0\"\n \n";
+    assert_eq!(lock_diff_versions_only(ok), Ok(2));
+    let bad = format!("{ok}-checksum = \"a\"\n+checksum = \"b\"\n");
+    assert!(lock_diff_versions_only(&bad).is_err());
+}
+
+#[test]
+fn notes_need_this_versions_section_above_the_history() {
+    assert_eq!(check_notes("\u{feff}# CamCraft 0.17.0\n\nnew\n---\nold\n", "0.17.0"), Ok(2));
+    assert!(check_notes("# CamCraft 0.17.0\nnew\n", "0.17.0").expect_err("no ---").contains("no '---'"));
+    assert!(check_notes("# CamCraft 0.17.0\n---\n", "0.17.0").expect_err("none").contains("no notes"));
+    assert!(check_notes("# CamCraft 0.16.0\nx\n---\n", "0.17.0").expect_err("wrong").contains("not 0.17.0"));
+    assert!(check_notes("# CamCraft 0.17.0\n \n\n---\n", "0.17.0").expect_err("empty").contains("empty"));
+}
+
+#[test]
+fn preflight_ignores_the_files_the_cut_commits() {
+    let st = " M Cargo.toml\n M RELEASE_NOTES.md\n?? tmp/\n M \"odd name.rs\"\n";
+    assert_eq!(unexpected_changes(st), vec!["tmp/".to_string(), "odd name.rs".to_string()]);
+}
+
+#[test]
+fn zip_layout_mirrors_release_yml() {
+    let r = repo("release/v0.17.0", "0.17.0");
+    let bin = r.0.join("bin");
+    let list = pack::stage_list(&r.0, &bin, Os::Windows).expect("stage list");
+    let rel: Vec<String> = list.iter().map(|(_, p)| p.to_string_lossy().replace('\\', "/")).collect();
+    assert_eq!(
+        rel,
+        [
+            "camcraft-ui.exe",
+            "camcraft-cli.exe",
+            "post.exe",
+            "assets/posts/fanuc.cps",
+            "assets/machines/vmc.json",
+            "assets/ui/cube.png",
+            "assets/ui/fonts/sans.ttf",
+            "assets/scripts/job.js",
+            "assets/themes/dark.json",
+            "RELEASE_NOTES.md",
+            "TESTING.md",
+            "LICENSE",
+            "NOTICE",
+        ]
+    );
+    assert_eq!(list[0].0, bin.join("camcraft-ui.exe"));
+    let linux = pack::stage_list(&r.0, &bin, Os::Linux).expect("linux list");
+    assert_eq!(linux[2].1, PathBuf::from("post"), "no .exe off Windows");
+    // Staging copies every listed file (fake exes stand in for the build).
+    for e in pack::EXES {
+        write(&bin, &format!("{e}.exe"), "exe");
+    }
+    let stage = r.0.join("dist").join(pack::stage_name("0.17.0"));
+    assert_eq!(pack::stage(&list, &stage), Ok(13));
+    assert!(stage.join("assets/ui/fonts/sans.ttf").is_file());
+    std::fs::remove_file(r.0.join("NOTICE")).expect("rm NOTICE");
+    assert!(pack::stage_list(&r.0, &bin, Os::Windows).expect_err("no NOTICE").contains("NOTICE"));
+}
+
+#[test]
+fn release_build_never_builds_xtask() {
+    for os in [Os::Windows, Os::Linux, Os::Macos, Os::FreeBsd] {
+        for step in pack::build_steps(os) {
+            assert!(!step.iter().any(|a| a == "xtask"), "{os:?}: {step:?}");
+            assert!(step.iter().any(|a| a == "-p"), "{os:?} builds named packages only");
+        }
+    }
+    assert_eq!(pack::build_steps(Os::Macos).len(), 2, "universal: both architectures");
+}
+
+#[test]
+fn parse_takes_release_ps1s_switches() {
+    let a: Vec<String> =
+        ["--version", "1.2.3", "--no-tag", "--skip-gate", "--skip-build", "--installer", "--dry-run", "--title", "T"]
+            .map(String::from)
+            .to_vec();
+    let r = parse(&a).expect("parse");
+    assert!(r.no_tag && r.skip_gate && r.skip_build && r.installer && r.dry);
+    assert_eq!((r.version.as_str(), r.title.as_str()), ("1.2.3", "T"));
+    assert!(parse(&["--no-tag".to_string()]).is_err(), "--version is required");
+    assert!(parse(&["--version".to_string(), "1.2.3".into(), "--tag".into()]).is_err());
+}
+
+#[test]
+fn dry_run_walks_the_ten_phases_and_changes_nothing() {
+    let r = repo("release/v9.9.9", "9.9.9");
+    let mut cut = Cut::new(&r.0, args("9.9.9"), Os::Windows);
+    assert_eq!(cut.phases(), Ok(()));
+    let phases = [
+        "preflight",
+        "gate",
+        "version bump",
+        "commit and tag",
+        "release build",
+        "verify post.exe version",
+        "sign binaries",
+        "assemble zip",
+        "installer",
+        "done",
+    ];
+    let want: Vec<String> =
+        phases.iter().enumerate().map(|(i, p)| format!("=== Phase {}/10: {p} ===", i + 1)).collect();
+    assert_eq!(banners(&cut), want);
+    assert!(cut.out.iter().any(|l| l == "workspace version: 0.16.0 -> 9.9.9"));
+    assert!(cut.out.iter().any(|l| l.starts_with("[dry-run] cargo build -j 6 --release -p camcraft-ui")));
+    assert_eq!(std::fs::read_to_string(r.0.join("Cargo.toml")).expect("toml"), TOML, "dry run wrote nothing");
+    assert!(!r.0.join("dist").exists());
+
+    let mut linux = Cut::new(&r.0, ReleaseArgs { skip_gate: true, ..args("9.9.9") }, Os::Linux);
+    assert_eq!(linux.phases(), Ok(()));
+    assert!(banners(&linux).contains(&"=== Phase 8/10: package (scripts/package-linux.sh) ===".to_string()));
+    assert!(linux.out.iter().any(|l| l == "skipped (--skip-gate)"));
+}
+
+#[test]
+fn refusals_are_named() {
+    let r = repo("main", "9.9.9");
+    let mut on_main = Cut::new(&r.0, args("9.9.9"), Os::Windows);
+    assert!(on_main.phases().expect_err("main").contains("not on main"));
+    let mut tagging = Cut::new(&r.0, ReleaseArgs { no_tag: false, ..args("9.9.9") }, Os::Windows);
+    assert!(tagging.phases().expect_err("tag").contains("branch-protected"));
+    let mut installer = Cut::new(&r.0, ReleaseArgs { installer: true, ..args("9.9.9") }, Os::Linux);
+    assert!(installer.phases().expect_err("installer").contains("Windows only"));
+    let mut bad = Cut::new(&r.0, args("9.9"), Os::Windows);
+    assert!(bad.phases().expect_err("version").contains("X.Y.Z"));
+    let rb = repo("release/v9.9.9", "9.9.8");
+    let mut notes = Cut::new(&rb.0, args("9.9.9"), Os::Windows);
+    assert!(notes.phases().expect_err("notes").contains("not 9.9.9"));
+}
diff --git a/xtask/src/scan.rs b/xtask/src/scan.rs
new file mode 100644
index 00000000..81ed6f7f
--- /dev/null
+++ b/xtask/src/scan.rs
@@ -0,0 +1,139 @@
+//! Source scanning for the gate: test suites of a crate, the `#[test]` fns of a file with their line
+//! spans, and the "Gate map" paragraph of a suite header.
+//! Provenance: our own build law (AGENTS.md "Testing", gate maps of M4.4), ported from scripts/gate.ps1 (#748).
+
+use std::path::{Path, PathBuf};
+
+use regex::Regex;
+
+use crate::plan::ps_cmp;
+
+/// A `#[test]` fn: its name, its 1-based line span (doc/attr lines through the closing brace) and
+/// whether it carries `#[ignore]`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TestFn {
+    pub name: String,
+    pub start: usize,
+    pub end: usize,
+    pub ignored: bool,
+}
+
+/// Compiles a gate pattern; a bad one is an error by name, never a panic.
+pub fn re(pat: &str) -> Result<Regex, String> {
+    Regex::new(pat).map_err(|e| format!("bad gate pattern {pat:?}: {e}"))
+}
+
+pub fn read(path: &Path) -> String {
+    std::fs::read_to_string(path).unwrap_or_default()
+}
+
+/// The integration-test suites of `crates/<dir>/tests/*.rs`, by name, in gate order.
+pub fn binaries(root: &Path, dir: &str) -> Vec<String> {
+    let mut out: Vec<String> = rs_files(&root.join("crates").join(dir).join("tests"))
+        .iter()
+        .filter_map(|p| p.file_stem().map(|s| s.to_string_lossy().into_owned()))
+        .collect();
+    out.sort_by(|a, b| ps_cmp(a, b));
+    out
+}
+
+/// The `.rs` files directly in `dir`, sorted; empty when it does not exist.
+pub fn rs_files(dir: &Path) -> Vec<PathBuf> {
+    let mut out: Vec<PathBuf> = match std::fs::read_dir(dir) {
+        Ok(rd) => rd
+            .filter_map(Result::ok)
+            .map(|e| e.path())
+            .filter(|p| p.is_file() && p.extension().is_some_and(|x| x == "rs"))
+            .collect(),
+        Err(_) => Vec::new(),
+    };
+    out.sort_by(|a, b| ps_cmp(&a.to_string_lossy(), &b.to_string_lossy()));
+    out
+}
+
+/// The `.rs` files under `dir`, a directory's own files before its subdirectories (each sorted).
+pub fn rs_files_recursive(dir: &Path) -> Vec<PathBuf> {
+    let mut out = rs_files(dir);
+    let mut subs: Vec<PathBuf> = match std::fs::read_dir(dir) {
+        Ok(rd) => rd.filter_map(Result::ok).map(|e| e.path()).filter(|p| p.is_dir()).collect(),
+        Err(_) => Vec::new(),
+    };
+    subs.sort_by(|a, b| ps_cmp(&a.to_string_lossy(), &b.to_string_lossy()));
+    for s in subs {
+        out.extend(rs_files_recursive(&s));
+    }
+    out
+}
+
+/// The `#[test]` fns of a source text.
+pub fn test_fns(text: &str) -> Result<Vec<TestFn>, String> {
+    let test_attr = re(r"(?i)^\s*#\[test\]")?;
+    let lead = re(r"(?i)^\s*(///|#\[)")?;
+    let fn_re = re(r"(?i)^\s*(pub\s+)?(async\s+)?fn\s+(\w+)")?;
+    let lines: Vec<&str> = text.lines().collect();
+    let n = lines.len();
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < n {
+        if !test_attr.is_match(lines[i]) {
+            i += 1;
+            continue;
+        }
+        let mut s = i;
+        while s > 0 && lead.is_match(lines[s - 1]) {
+            s -= 1;
+        }
+        let mut ignored = false;
+        let mut k = i;
+        let mut name = None;
+        while k < n {
+            if let Some(c) = fn_re.captures(lines[k]) {
+                name = c.get(3).map(|m| m.as_str().to_string());
+                break;
+            }
+            if lines[k].to_ascii_lowercase().contains("#[ignore") {
+                ignored = true;
+            }
+            k += 1;
+        }
+        let Some(name) = name else { break };
+        let (mut depth, mut opened, mut e) = (0i64, false, k);
+        while e < n {
+            for ch in lines[e].chars() {
+                if ch == '{' {
+                    depth += 1;
+                    opened = true;
+                } else if ch == '}' {
+                    depth -= 1;
+                }
+            }
+            if opened && depth <= 0 {
+                break;
+            }
+            e += 1;
+        }
+        out.push(TestFn { name, start: s + 1, end: e + 1, ignored });
+        i = e + 1;
+    }
+    Ok(out)
+}
+
+/// The "Gate map" paragraph of a suite header (first 150 lines), as one string; empty when absent.
+pub fn gate_map(text: &str) -> Result<String, String> {
+    let start = re(r"(?i)Gate map")?;
+    let blank = re(r"^//!\s*$")?;
+    let mut on = false;
+    let mut acc: Vec<&str> = Vec::new();
+    for l in text.lines().take(150) {
+        if !on && start.is_match(l) {
+            on = true;
+        }
+        if on {
+            if !l.starts_with("//!") || blank.is_match(l) {
+                break;
+            }
+            acc.push(l);
+        }
+    }
+    Ok(acc.join(" "))
+}
