@@ -0,0 +1,236 @@
+//! Provenance: Jordan-curve containment and post-order traversal; CamCraft plasma nesting and issue #2159 hold-down rules.
+//!
+//! Inputs are already placed, polygonal features in sheet millimeters. This
+//! module orders cuts; placement clearance and offset toolpaths remain the
+//! caller's responsibility. Diagnostics describe ideal sharp corners that
+//! a circular cutter cannot reach. They do not change the picked geometry.
+
+use crate::geo2d::{COORD_LIMIT, GeoError, Loop, Point2, SCALE};
+
+mod geometry;
+mod validate;
+
+/// A side is relative to the contour interior, or to the directed open chain.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CutSide {
+    Auto,
+    Outside,
+    OnLine,
+    Inside,
+    Left,
+    Right,
+}
+
+/// Global sheet phases. Marking and RoughProfile retain stock. Internal may
+/// contain blind pockets or through holes; release_phase distinguishes them.
+/// Breakthrough is always a through cut on a closed contour.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum CutPhase {
+    Marking,
+    Internal,
+    RoughProfile,
+    Breakthrough,
+}
+
+impl CutPhase {
+    const ALL: [Self; 4] = [
+        Self::Marking,
+        Self::Internal,
+        Self::RoughProfile,
+        Self::Breakthrough,
+    ];
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum CutGeometry {
+    Closed(Loop),
+    Open(Vec<Point2>),
+}
+
+/// Stable IDs must be unique across the sheet. Request each phase at most once.
+/// Multiple physical passes within a phase remain the caller's responsibility.
+#[derive(Clone, Debug, PartialEq)]
+pub struct CutFeature {
+    pub id: u64,
+    pub geometry: CutGeometry,
+    pub side: CutSide,
+    pub passes: Vec<CutPhase>,
+    /// The through pass that frees material. None means all passes retain
+    /// stock. Only a closed Internal or Breakthrough pass can release stock.
+    pub release_phase: Option<CutPhase>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CutRole {
+    PartOutline,
+    Hole,
+    OpenFeature,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ResolvedFeature {
+    pub id: u64,
+    pub parent: Option<u64>,
+    pub depth: usize,
+    pub role: CutRole,
+    /// Always explicit: the planner never returns Auto.
+    pub side: CutSide,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PlannedCut {
+    pub feature_id: u64,
+    pub phase: CutPhase,
+}
+
+/// A sharp corner needs at least tool_radius of rounding on the cutter side.
+#[derive(Clone, Debug, PartialEq)]
+pub struct CornerClearance {
+    pub feature_id: u64,
+    /// Index into the original input vertices (no winding reversal occurs).
+    pub vertex: usize,
+    pub tool_radius: f64,
+    /// Angle of the wedge on the cutter side, between zero and pi.
+    pub angle_radians: f64,
+    /// Distance left uncut from the ideal corner along its angle bisector.
+    pub min_unreachable_distance: f64,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct SheetCutPlan {
+    /// Sorted by stable ID, independent of input enumeration.
+    pub features: Vec<ResolvedFeature>,
+    pub cuts: Vec<PlannedCut>,
+    pub corner_limits: Vec<CornerClearance>,
+}
+
+fn invalid(message: impl Into<String>) -> GeoError {
+    GeoError::Invalid(message.into())
+}
+
+fn resolve(
+    features: &[CutFeature],
+    nodes: &[geometry::Node],
+) -> Result<Vec<ResolvedFeature>, GeoError> {
+    let mut resolved = Vec::with_capacity(features.len());
+    for (feature, node) in features.iter().zip(nodes) {
+        let role = if !node.closed {
+            CutRole::OpenFeature
+        } else if node.depth % 2 == 0 {
+            CutRole::PartOutline
+        } else {
+            CutRole::Hole
+        };
+        let side = match (node.closed, feature.side) {
+            (false, CutSide::Inside | CutSide::Outside) => {
+                return Err(invalid(format!(
+                    "open chain {} cannot use {:?}",
+                    feature.id, feature.side
+                )));
+            }
+            (true, CutSide::Left | CutSide::Right) => {
+                return Err(invalid(format!(
+                    "closed contour {} cannot use {:?}",
+                    feature.id, feature.side
+                )));
+            }
+            (false, CutSide::Auto) => CutSide::OnLine,
+            (true, CutSide::Auto) if role == CutRole::Hole => CutSide::Inside,
+            (true, CutSide::Auto) => CutSide::Outside,
+            (_, side) => side,
+        };
+        resolved.push(ResolvedFeature {
+            id: feature.id,
+            parent: node.parent.map(|p| features[p].id),
+            depth: node.depth,
+            role,
+            side,
+        });
+    }
+    Ok(resolved)
+}
+
+/// Construct the global forest, then visit siblings by increasing area with
+/// stable IDs breaking ties. Traversal uses a stack, including for deep nesting.
+fn post_order(features: &[CutFeature], nodes: &[geometry::Node]) -> Vec<usize> {
+    let mut roots = Vec::new();
+    let mut children = vec![Vec::new(); nodes.len()];
+    for (i, node) in nodes.iter().enumerate() {
+        if let Some(parent) = node.parent {
+            children[parent].push(i);
+        } else {
+            roots.push(i);
+        }
+    }
+    let sort = |list: &mut Vec<usize>| {
+        list.sort_by_key(|&i| (nodes[i].area2.unsigned_abs(), features[i].id));
+    };
+    sort(&mut roots);
+    for list in &mut children {
+        sort(list);
+    }
+    let mut stack: Vec<_> = roots.into_iter().rev().map(|i| (i, false)).collect();
+    let mut out = Vec::with_capacity(nodes.len());
+    while let Some((i, visited)) = stack.pop() {
+        if visited {
+            out.push(i);
+        } else {
+            stack.push((i, true));
+            stack.extend(children[i].iter().rev().map(|&child| (child, false)));
+        }
+    }
+    out
+}
+
+/// Plan one sheet. Refuse ambiguous geometry and phase requests that would cut
+/// a feature after its enclosing contour has freed the material.
+pub fn plan_sheet(features: &[CutFeature], cut_width: f64) -> Result<SheetCutPlan, GeoError> {
+    if !cut_width.is_finite() || !(1.0 / SCALE..COORD_LIMIT).contains(&cut_width) {
+        return Err(invalid(
+            "cut_width must be finite, at least one geometry grid unit, and within range",
+        ));
+    }
+    // Resolve IDs and pass requests before the geometric pair checks so duplicate
+    // IDs always get their own diagnostic, even when their geometry also overlaps.
+    validate::requests(features)?;
+    let nodes = geometry::forest(features)?;
+    let mut resolved = resolve(features, &nodes)?;
+    let order = post_order(features, &nodes);
+    let mut cuts = Vec::new();
+    for phase in CutPhase::ALL {
+        for &i in &order {
+            if features[i].passes.contains(&phase) {
+                cuts.push(PlannedCut {
+                    feature_id: features[i].id,
+                    phase,
+                });
+            }
+        }
+    }
+    validate::order(features, &nodes, &cuts)?;
+    let mut corner_limits = Vec::new();
+    for (i, node) in nodes.iter().enumerate() {
+        corner_limits.extend(geometry::corners(
+            features[i].id,
+            node,
+            resolved[i].side,
+            cut_width / 2.0,
+        ));
+    }
+    resolved.sort_by_key(|feature| feature.id);
+    corner_limits.sort_by_key(|corner| (corner.feature_id, corner.vertex));
+    Ok(SheetCutPlan {
+        features: resolved,
+        cuts,
+        corner_limits,
+    })
+}
+
+/// Check a caller-supplied schedule, including completeness and global phases.
+/// Safe sibling permutations are accepted; descendant cuts after release are not.
+pub fn validate_cut_order(features: &[CutFeature], cuts: &[PlannedCut]) -> Result<(), GeoError> {
+    validate::requests(features)?;
+    let nodes = geometry::forest(features)?;
+    resolve(features, &nodes)?;
+    validate::order(features, &nodes, cuts)
+}
diff --git a/crates/geometry/src/nesting/cut_order/geometry.rs b/crates/geometry/src/nesting/cut_order/geometry.rs
new file mode 100644
index 000000000..459002803
--- /dev/null
+++ b/crates/geometry/src/nesting/cut_order/geometry.rs
@@ -0,0 +1,244 @@
+//! Provenance: integer polygon predicates (Jordan parity) and circular-tool tangent geometry; CamCraft plasma nesting rules.
+
+use crate::geo2d::{COORD_LIMIT, SCALE};
+
+use super::{CornerClearance, CutFeature, CutGeometry, CutSide, GeoError, invalid};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct GridPoint {
+    x: i64,
+    y: i64,
+}
+
+pub(super) struct Node {
+    points: Vec<GridPoint>,
+    pub closed: bool,
+    pub area2: i128,
+    pub parent: Option<usize>,
+    pub depth: usize,
+}
+
+// |coordinate| < 1e18, so each difference is below 2e18 and the two
+// products and their difference fit i128. Area accumulation is checked.
+fn cross(a: GridPoint, b: GridPoint, c: GridPoint) -> i128 {
+    (i128::from(b.x) - i128::from(a.x)) * (i128::from(c.y) - i128::from(a.y))
+        - (i128::from(b.y) - i128::from(a.y)) * (i128::from(c.x) - i128::from(a.x))
+}
+
+fn dot(a: GridPoint, b: GridPoint, c: GridPoint) -> i128 {
+    (i128::from(a.x) - i128::from(b.x)) * (i128::from(c.x) - i128::from(b.x))
+        + (i128::from(a.y) - i128::from(b.y)) * (i128::from(c.y) - i128::from(b.y))
+}
+
+fn on(a: GridPoint, b: GridPoint, p: GridPoint) -> bool {
+    cross(a, b, p) == 0
+        && p.x >= a.x.min(b.x)
+        && p.x <= a.x.max(b.x)
+        && p.y >= a.y.min(b.y)
+        && p.y <= a.y.max(b.y)
+}
+
+fn intersects(a: GridPoint, b: GridPoint, c: GridPoint, d: GridPoint) -> bool {
+    if a.x.max(b.x) < c.x.min(d.x)
+        || c.x.max(d.x) < a.x.min(b.x)
+        || a.y.max(b.y) < c.y.min(d.y)
+        || c.y.max(d.y) < a.y.min(b.y)
+    {
+        return false;
+    }
+    let (ab_c, ab_d, cd_a, cd_b) = (
+        cross(a, b, c),
+        cross(a, b, d),
+        cross(c, d, a),
+        cross(c, d, b),
+    );
+    (ab_c.signum() != ab_d.signum()
+        && cd_a.signum() != cd_b.signum()
+        && ab_c != 0
+        && ab_d != 0
+        && cd_a != 0
+        && cd_b != 0)
+        || on(a, b, c)
+        || on(a, b, d)
+        || on(c, d, a)
+        || on(c, d, b)
+}
+
+impl Node {
+    fn segments(&self) -> impl Iterator<Item = (GridPoint, GridPoint)> + '_ {
+        let count = if self.closed {
+            self.points.len()
+        } else {
+            self.points.len() - 1
+        };
+        (0..count).map(|i| (self.points[i], self.points[(i + 1) % self.points.len()]))
+    }
+
+    fn contains(&self, p: GridPoint) -> bool {
+        let mut inside = false;
+        for (a, b) in self.segments() {
+            if (a.y > p.y) != (b.y > p.y) {
+                let turn = cross(a, b, p);
+                if (b.y > a.y && turn > 0) || (b.y < a.y && turn < 0) {
+                    inside = !inside;
+                }
+            }
+        }
+        inside
+    }
+}
+
+fn node(feature: &CutFeature) -> Result<Node, GeoError> {
+    let (raw, closed) = match &feature.geometry {
+        CutGeometry::Closed(ring) => (ring.points(), true),
+        CutGeometry::Open(points) => (points.as_slice(), false),
+    };
+    let fail = |why: &str| invalid(format!("feature {} {why}", feature.id));
+    if raw.len() < if closed { 3 } else { 2 } {
+        return Err(fail("has too few vertices"));
+    }
+    let mut points = Vec::with_capacity(raw.len());
+    for p in raw {
+        if !p.x.is_finite() || !p.y.is_finite() {
+            return Err(fail("has a non-finite vertex"));
+        }
+        if p.x.abs() >= COORD_LIMIT || p.y.abs() >= COORD_LIMIT {
+            return Err(fail("has a coordinate outside the machinable range"));
+        }
+        points.push(GridPoint {
+            x: (p.x * SCALE).round() as i64,
+            y: (p.y * SCALE).round() as i64,
+        });
+    }
+    let mut node = Node {
+        points,
+        closed,
+        area2: 0,
+        parent: None,
+        depth: 0,
+    };
+    for (a, b) in node.segments() {
+        if a == b {
+            return Err(fail("has a zero-length segment on the geometry grid"));
+        }
+    }
+    if !closed && node.points.first() == node.points.last() {
+        return Err(fail("is marked open but closes on itself"));
+    }
+    let n = node.points.len();
+    for i in 0..n {
+        if !closed && (i == 0 || i == n - 1) {
+            continue;
+        }
+        let (a, b, c) = (
+            node.points[(i + n - 1) % n],
+            node.points[i],
+            node.points[(i + 1) % n],
+        );
+        if cross(a, b, c) == 0 && dot(a, b, c) > 0 {
+            return Err(fail("retraces an adjacent segment (a slit or spike)"));
+        }
+    }
+    for (i, (a, b)) in node.segments().enumerate() {
+        for (j, (c, d)) in node.segments().enumerate().skip(i + 2) {
+            if closed && i == 0 && j == n - 1 {
+                continue;
+            }
+            if intersects(a, b, c, d) {
+                return Err(fail("crosses or touches itself"));
+            }
+        }
+    }
+    if closed {
+        let mut area2 = 0i128;
+        for (a, b) in node.segments() {
+            area2 = area2
+                .checked_add(cross(node.points[0], a, b))
+                .ok_or_else(|| fail("area exceeds the geometry range"))?;
+        }
+        // The simple, non-retracing closed ring already has nonzero area.
+        node.area2 = area2;
+    }
+    Ok(node)
+}
+
+pub(super) fn forest(features: &[CutFeature]) -> Result<Vec<Node>, GeoError> {
+    let mut nodes: Vec<_> = features.iter().map(node).collect::<Result<_, _>>()?;
+    // Intersections must be checked before testing a containment probe. Even
+    // two endpoints inside a concave contour can have an outside middle.
+    for i in 0..nodes.len() {
+        for j in i + 1..nodes.len() {
+            // Open features may meet each other; only a closed boundary
+            // separates material and determines containment.
+            if !nodes[i].closed && !nodes[j].closed {
+                continue;
+            }
+            if nodes[i]
+                .segments()
+                .any(|(a, b)| nodes[j].segments().any(|(c, d)| intersects(a, b, c, d)))
+            {
+                return Err(invalid(format!(
+                    "features {} and {} cross or touch",
+                    features[i].id, features[j].id
+                )));
+            }
+        }
+    }
+    for i in 0..nodes.len() {
+        nodes[i].parent = (0..nodes.len())
+            .filter(|&j| {
+                j != i
+                    && nodes[j].closed
+                    && nodes[j].area2.unsigned_abs() > nodes[i].area2.unsigned_abs()
+                    && nodes[j].contains(nodes[i].points[0])
+            })
+            .min_by_key(|&j| nodes[j].area2.unsigned_abs());
+    }
+    for i in 0..nodes.len() {
+        let mut at = nodes[i].parent;
+        let mut depth = 0;
+        while let Some(parent) = at {
+            // Every parent has strictly larger area, so no cycle is possible.
+            depth += 1;
+            at = nodes[parent].parent;
+        }
+        nodes[i].depth = depth;
+    }
+    Ok(nodes)
+}
+
+pub(super) fn corners(id: u64, node: &Node, side: CutSide, radius: f64) -> Vec<CornerClearance> {
+    let mut limits = Vec::new();
+    let n = node.points.len();
+    for i in 0..n {
+        if !node.closed && (i == 0 || i == n - 1) {
+            continue;
+        }
+        let (a, b, c) = (
+            node.points[(i + n - 1) % n],
+            node.points[i],
+            node.points[(i + 1) % n],
+        );
+        let turn = cross(a, b, c);
+        let inside_turn = turn.signum() == node.area2.signum();
+        let unreachable = turn != 0
+            && match side {
+                CutSide::Inside => inside_turn,
+                CutSide::Outside => !inside_turn,
+                CutSide::Left => turn > 0,
+                CutSide::Right => turn < 0,
+                _ => false,
+            };
+        if unreachable {
+            let angle = (turn.unsigned_abs() as f64).atan2(dot(a, b, c) as f64);
+            limits.push(CornerClearance {
+                feature_id: id,
+                vertex: i,
+                tool_radius: radius,
+                angle_radians: angle,
+                min_unreachable_distance: radius * (1.0 / (angle / 2.0).sin() - 1.0),
+            });
+        }
+    }
+    limits
+}
