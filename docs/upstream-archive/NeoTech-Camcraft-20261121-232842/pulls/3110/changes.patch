From 83ea68f1ea7af32f4fc18a7228188e07298e2a41 Mon Sep 17 00:00:00 2001
From: mechatronics-studio
 <67246298+mechatronics-studio@users.noreply.github.com>
Date: Fri, 20 Nov 2026 20:04:18 -0700
Subject: [PATCH] Publish SHA256SUMS.txt with every release

The publish job now writes SHA256SUMS.txt (sha256sum format) for all
release assets, checks it, and uploads it with the release, so downloads
can be verified and launchers such as ArtCraft Launcher can install
CamCraft (storytold/craft-launcher#1545).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/release.yml | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 1a937f959..b6734eb58 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -398,6 +398,19 @@ jobs:
             exit 1
           fi
           printf '%s\n' "${assets[@]}"
+      # SHA256SUMS.txt lists every published asset in sha256sum's own
+      # format ("<hash>  <file>"), so a download can be checked with
+      # `sha256sum -c --ignore-missing SHA256SUMS.txt`, and launchers that
+      # install CamCraft (ArtCraft Launcher requires it) can verify it.
+      - name: SHA256SUMS.txt for the assets
+        shell: bash
+        working-directory: dist
+        run: |
+          shopt -s nullglob
+          assets=(*.zip *-setup.exe *.tar.gz *.deb *.rpm *.dmg *.AppImage *.snap *.flatpak *.pkg.tar.zst)
+          sha256sum -- "${assets[@]}" > SHA256SUMS.txt
+          sha256sum -c SHA256SUMS.txt
+          cat SHA256SUMS.txt
       - name: Publish GitHub Release
         uses: softprops/action-gh-release@v2
         with:
@@ -412,6 +425,7 @@ jobs:
             dist/*.snap
             dist/*.flatpak
             dist/*.pkg.tar.zst
+            dist/SHA256SUMS.txt
           body_path: dist/release-body.md
           # A failed platform leaves its globs empty; the step above already
           # refused a release with no asset at all.
