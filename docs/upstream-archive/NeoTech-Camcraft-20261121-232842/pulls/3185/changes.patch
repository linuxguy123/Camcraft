     let concurrency = workflow
         .split_once("\nconcurrency:\n")
         .expect("the workflow has top-level concurrency")
@@ -12,12 +27,36 @@ fn post_merge_preserves_running_gate() {
         .split("\njobs:\n")
         .next()
