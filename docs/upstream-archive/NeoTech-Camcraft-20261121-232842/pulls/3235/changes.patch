From 13a51815a0a6ac4b5fb49555fe467ba55bc9a4db Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 20:58:44 +0100
Subject: [PATCH 1/2] test(ui): read the guide's legacy 3+2 warning and scroll
 to the 770M row

Two camcraft-ui lib tests went red on main after the merge batch of
ad0307b7a.

- guide_projects::indexed_guide_preserves_legacy_basis_and_path: #3080
  (#2991) gives a 3+2 FirstTraverseLow warning in the user's frame with
  `tilted: true`. The cache saved in examples/guide-multiaxis.camproj
  predates that. The test now accepts the regenerated form of a legacy
  warning only when it names the same move, the same stock or fixture
  top and the same raise. Every other warning still must match exactly.
- machines_pane::the_sheet_states_rigid_tapping_in_words: #3204 adds a
  row to the machine library, which moves the 770M row past the clip
  edge of the list. The test now scrolls the row into view before the
  click.

Fixes #3233

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/tests/guide_projects.rs | 17 ++++++++++++++++-
 crates/ui/src/egui_app/tests/machines_pane.rs  |  4 ++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/crates/ui/src/egui_app/tests/guide_projects.rs b/crates/ui/src/egui_app/tests/guide_projects.rs
index 807d89d23..1bd30e237 100644
--- a/crates/ui/src/egui_app/tests/guide_projects.rs
+++ b/crates/ui/src/egui_app/tests/guide_projects.rs
@@ -22,6 +22,7 @@ use camcraft_app::schema::Location;
 use camcraft_app::stock::StockShape;
 use camcraft_app::stock_fit::{self, FitKind};
 use camcraft_app::tools::{self, Tool};
+use camcraft_app::verify::Warning;
 use camcraft_app::vise::{ViseSize, size as vise_size};
 use flecs_ecs::prelude::World;
 
@@ -337,6 +338,20 @@ fn indexed_guide_preserves_legacy_basis_and_path() {
         }
     }
     for warning in &expected.warnings {
-        assert!(actual.warnings.contains(warning), "documented warning lost: {warning:?}");
+        assert!(actual.warnings.iter().any(|w| same_warning(warning, w)), "documented warning lost: {warning:?}");
+    }
+}
+
+/// #3233: the saved cache predates #2991, which gives a 3+2 first-traverse
+/// warning in the user's frame (`tilted`). The guide documents both forms:
+/// the same stock or fixture top and the same raise, along the tool axis.
+/// Every other warning must come back exactly.
+fn same_warning(saved: &Warning, regenerated: &Warning) -> bool {
+    match (saved, regenerated) {
+        (
+            Warning::FirstTraverseLow { at, height_mm, top_mm, fixture, tilted: false },
+            Warning::FirstTraverseLow { at: a, height_mm: h, top_mm: t, fixture: f, tilted: true },
+        ) => at == a && fixture == f && ((top_mm - height_mm) - (t - h)).abs() <= 0.000_001,
+        _ => saved == regenerated,
     }
 }
diff --git a/crates/ui/src/egui_app/tests/machines_pane.rs b/crates/ui/src/egui_app/tests/machines_pane.rs
index 05e015dcc..45817a7e7 100644
--- a/crates/ui/src/egui_app/tests/machines_pane.rs
+++ b/crates/ui/src/egui_app/tests/machines_pane.rs
@@ -119,6 +119,10 @@ fn the_sheet_states_rigid_tapping_in_words() {
         .as_ref()
         .and_then(|l| l.iter().find(|e| e.name == "Tormach 770M").cloned())
         .expect("the library lists the 770M");
+    // #3233: the list can push the row past the pane's clip edge, where a
+    // click lands on nothing. Scroll it into view first.
+    h.get_by_label(&row_label(&m)).scroll_to_me();
+    h.run();
     h.get_by_label(&row_label(&m)).click();
     h.run_steps(2);
     h.get_by_label("Rigid tapping");

From 338618477b618b35263f5007b659f4baf3d633e1 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 21:02:04 +0100
Subject: [PATCH 2/2] test(ui): pin that a legacy first-traverse warning needs
 the same raise

A negative pin for `same_warning`: a different raise, a fixture top, an
upright warning or another move does not match the saved warning. The
770M test also asserts that the row exists before the click.

Fixes #3233

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/tests/guide_projects.rs | 12 ++++++++++++
 crates/ui/src/egui_app/tests/machines_pane.rs  |  1 +
 2 files changed, 13 insertions(+)

diff --git a/crates/ui/src/egui_app/tests/guide_projects.rs b/crates/ui/src/egui_app/tests/guide_projects.rs
index 1bd30e237..3ea53a2da 100644
--- a/crates/ui/src/egui_app/tests/guide_projects.rs
+++ b/crates/ui/src/egui_app/tests/guide_projects.rs
@@ -355,3 +355,15 @@ fn same_warning(saved: &Warning, regenerated: &Warning) -> bool {
         _ => saved == regenerated,
     }
 }
+
+#[test]
+fn a_legacy_first_traverse_warning_matches_only_the_same_raise() {
+    let low = |height_mm, top_mm, fixture, tilted| Warning::FirstTraverseLow { at: 0, height_mm, top_mm, fixture, tilted };
+    let saved = low(10.0, 11.113_929, false, false);
+    assert!(same_warning(&saved, &low(30.0, 31.113_929, false, true)), "the same raise in the user's frame");
+    assert!(!same_warning(&saved, &low(30.0, 32.0, false, true)), "a different raise is lost");
+    assert!(!same_warning(&saved, &low(30.0, 31.113_929, true, true)), "a fixture top is not the stock top");
+    assert!(!same_warning(&saved, &low(30.0, 31.113_929, false, false)), "an upright warning matches only exactly");
+    assert!(!same_warning(&saved, &Warning::FirstTraverseLow { at: 1, height_mm: 30.0, top_mm: 31.113_929, fixture: false, tilted: true }));
+    assert!(same_warning(&saved, &saved.clone()), "an unchanged warning still matches");
+}
diff --git a/crates/ui/src/egui_app/tests/machines_pane.rs b/crates/ui/src/egui_app/tests/machines_pane.rs
index 45817a7e7..b55560d70 100644
--- a/crates/ui/src/egui_app/tests/machines_pane.rs
+++ b/crates/ui/src/egui_app/tests/machines_pane.rs
@@ -121,6 +121,7 @@ fn the_sheet_states_rigid_tapping_in_words() {
         .expect("the library lists the 770M");
     // #3233: the list can push the row past the pane's clip edge, where a
     // click lands on nothing. Scroll it into view first.
+    assert!(h.query_by_label(&row_label(&m)).is_some(), "the pane shows the 770M row");
     h.get_by_label(&row_label(&m)).scroll_to_me();
     h.run();
     h.get_by_label(&row_label(&m)).click();
