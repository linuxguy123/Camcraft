  "title": "fix(kernel): preserve validated STEP edges when healing exceeds the gap limit",
  "user": {
    "login": "qsmits",
    "id": 6771450,
    "node_id": "MDQ6VXNlcjY3NzE0NTA=",
    "avatar_url": "https://avatars.githubusercontent.com/u/6771450?v=4",
    "gravatar_id": "",
