  "title": "fix(2d): turn a contour seam lead only when it crosses its own ring",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
