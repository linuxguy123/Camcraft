From e81cf16e96a7250c84143383795dba03fd16e3c5 Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Fri, 20 Nov 2026 20:08:19 +0000
Subject: [PATCH] fix(ui): an undersize-hole warning no longer hides a shank
 avoid hit

fold_warnings_located grouped Warning::DrillUndersize under key 216,
the key of Warning::AvoidHit with FixturePart::Shank (avoid range
216..=220). A group prints only its first line, so a blocking "Do not
touch" shank hit could fold into the advisory undersize line as
"repeated on 1 more move". DrillUndersize now uses the free key 223
(222 is kept for UndercutLift, PR #2836).

Pinned by operations::warning_fold_tests::a_drill_undersize_never_hides_an_avoid_hit.

Fixes #3040

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ui/src/operations.rs                   | 23 +++++++++++++++++--
 .../3040-drill-undersize-fold-key.md          | 23 +++++++++++++++++++
 2 files changed, 44 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/3040-drill-undersize-fold-key.md

diff --git a/crates/ui/src/operations.rs b/crates/ui/src/operations.rs
index f520fb449..363c3e22f 100644
--- a/crates/ui/src/operations.rs
+++ b/crates/ui/src/operations.rs
@@ -288,8 +288,10 @@ pub fn fold_warnings_located(warnings: &[Warning]) -> Vec<(String, Option<usize>
             Warning::ProbeSearch { .. } => (214, false),
             // A sinker finish out of order (#543): advisory, its own line.
             Warning::SinkerFinishOrder { .. } => (215, false),
-            // A hole wider than its drill (#2496): advisory, its own line.
-            Warning::DrillUndersize { .. } => (216, false),
+            // A hole wider than its drill (#2496): advisory, its own line,
+            // clear of the avoid range (216..=220) and of 221 (#3040).
+            // 222 is kept for UndercutLift (PR #2836).
+            Warning::DrillUndersize { .. } => (223, false),
             // A lathe holder's rub (#369) splits part from stock too.
             Warning::HolderHit { part, .. } => (212 + *part as u8, false),
         }
@@ -608,6 +610,23 @@ mod warning_fold_tests {
         );
     }
 
+    /// #3040: `DrillUndersize` had the key of the shank `AvoidHit`
+    /// (216), so the advisory line hid a blocking "Do not touch" hit.
+    /// Each avoid part keeps its own line beside the undersize hole.
+    #[test]
+    fn a_drill_undersize_never_hides_an_avoid_hit() {
+        use camcraft_app::verify::FixturePart;
+        let parts = [FixturePart::Shank, FixturePart::Holder, FixturePart::Spindle, FixturePart::Rapid, FixturePart::Flute];
+        let mut w = vec![Warning::DrillUndersize { at: 3, hole_mm: 6.0, drill_mm: 5.0 }];
+        w.extend(parts.iter().enumerate().map(|(i, &part)| Warning::AvoidHit { at: 10 + i, item: 1, part, short_mm: 0.5 }));
+        let folded = fold_warnings(&w);
+        assert_eq!(folded.len(), 1 + parts.len(), "{folded:?}");
+        assert!(folded[0].contains("move 3"), "{folded:?}");
+        for (i, line) in folded[1..].iter().enumerate() {
+            assert!(line.contains(&format!("move {}", 10 + i)) && !line.contains("repeated"), "{folded:?}");
+        }
+    }
+
     #[test]
     fn flavors_group_apart_and_order_is_first_appearance() {
         let mut w = shank_run(10, 12, false);
diff --git a/docs/decisions/3040-drill-undersize-fold-key.md b/docs/decisions/3040-drill-undersize-fold-key.md
new file mode 100644
index 000000000..de34be2cb
--- /dev/null
+++ b/docs/decisions/3040-drill-undersize-fold-key.md
@@ -0,0 +1,23 @@
+## #3040 - DrillUndersize gets its own fold key in the Warnings pane
+
+**What was decided.** `fold_warnings_located` (`crates/ui/src/operations.rs`)
+groups `Warning::DrillUndersize` under key `223`. Before, it used `216`, the
+key of `Warning::AvoidHit` with `FixturePart::Shank` (the avoid range is
+`216..=220`). A new pin folds one `DrillUndersize` with one `AvoidHit` for
+each `FixturePart` and asserts one line for each.
+
+**Why.** A group prints only the line of its first warning. When the
+undersize hole came first, the blocking "Do not touch" shank hit was folded
+into the advisory line as "repeated on 1 more move", and the pane did not
+show it.
+
+**Considered and dropped.**
+- Key `222`: open PR #2836 moves `UndercutLift` to `222`. The next free key
+  is `223`, so the two PRs do not collide when the two merge.
+- A test that builds one value of each `Warning` kind and asserts distinct
+  keys: dropped for this fix. It does not stop a new kind from being left
+  out of the test, and the issue asks for the pin of the one collision.
+  An exhaustive key table (an enum of group kinds) is a larger refactor.
+
+**Cost to change later.** None. The key is display-only. The persisted
+cache stores each `Warning`, not the fold key.
