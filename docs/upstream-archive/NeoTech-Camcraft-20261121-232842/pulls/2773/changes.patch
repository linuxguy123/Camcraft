From ee65e8666dbec20a5832ae991b336ee1069137cf Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 18:07:13 +0100
Subject: [PATCH 4/4] fix(app): a laid cylinder still has no top face after
 #2758

Since #2758, stock_follow::sim_frame keeps a laid cylinder's turn
instead of refusing it, so sketch::stock_face returned the cylinder's
vertical end face as the profile face. stock_face now refuses by name
(NO_TOP_FACE) when the frame from sim_frame does not look up.

docs/agents/mcp-tools.md is written again from the live tool table
(set_stock axis/angles_deg, fit_stock frame note).

Pinned by a_profile_lies_on_a_laid_box_and_a_laid_cylinder_is_refused
and the_committed_reference_matches_the_live_tool_table.

Refs #2576

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/sketch.rs | 8 +++++++-
 docs/agents/mcp-tools.md | 4 ++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/crates/app/src/sketch.rs b/crates/app/src/sketch.rs
index f8122a896..7b6ebc513 100644
--- a/crates/app/src/sketch.rs
+++ b/crates/app/src/sketch.rs
@@ -117,7 +117,13 @@ pub fn stock_face(world: &World, declared: Option<&str>) -> Result<Option<Locati
     let (shape, at) = if matches!(shape, StockShape::FromModel { .. }) || up.z >= 1.0 - 1e-9 {
         (shape, at)
     } else {
-        crate::stock_follow::sim_frame(&shape, at).map_err(|_| NO_TOP_FACE)?
+        // Since #2758 the simulation keeps a laid cylinder's turn; its ends
+        // stand vertical, so it still has no flat face on top.
+        let (shape, at) = crate::stock_follow::sim_frame(&shape, at).map_err(|_| NO_TOP_FACE)?;
+        if crate::geometry::quat_rotate_point(at.rot, Point3::new(0.0, 0.0, 1.0)).z < 1.0 - 1e-9 {
+            return Err(NO_TOP_FACE);
+        }
+        (shape, at)
     };
     Ok(stock_top(world, &stock, &shape).map(|top| compose(at, Location { pos: Point3::new(0.0, 0.0, top), rot: IDENTITY_Q })))
 }
