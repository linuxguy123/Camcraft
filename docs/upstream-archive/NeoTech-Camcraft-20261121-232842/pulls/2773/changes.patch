diff --git a/crates/ui/src/state_stock_pose.rs b/crates/ui/src/state_stock_pose.rs
new file mode 100644
index 000000000..4d451ed42
--- /dev/null
+++ b/crates/ui/src/state_stock_pose.rs
@@ -0,0 +1,69 @@
+//! The Stock page's pose (#2576): the draft's turn from its axis choice,
+//! the one `SetStock` that Apply lands through, and the plain-English note
+//! the page shows before a simulation when the simulation cannot cut the
+//! drafted stock. The note asks the simulation's own law
+//! (`stock_follow::sim_frame`), so the page and the refusal never differ.
+//! Provenance: our own page state over our own stock command.
+
+use camcraft_app::commands::SetStock;
+use camcraft_app::geometry::Point3;
+use camcraft_app::geometry::stock_axis::stock_axis_rot;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::stock_follow::{LAID_CYLINDER, sim_frame};
+
+use super::{ErrorScope, State, StockUi};
+
+/// The note for a cylinder the simulation refuses as laid on its side.
+pub const SIM_NOTE_LAID: &str = "The simulation cannot cut a cylinder that lies along X or Y yet. \
+     The viewport shows it, but the simulation stops with a message.";
+/// The note for a stock the simulation refuses as tilted.
+pub const SIM_NOTE_TILTED: &str = "The simulation cannot cut a stock that is tilted off the X, Y and Z axes yet. \
+     The viewport shows it, but the simulation stops with a message.";
+
+impl StockUi {
+    /// The draft's shape, as Apply sends it.
+    #[must_use]
+    pub fn draft_shape(&self) -> StockShape {
+        match self.shape {
+            1 => StockShape::Cylinder { diameter: self.diameter, height: self.height },
+            2 => StockShape::FromModel { source: self.source.clone() },
+            _ => StockShape::Box { dx: self.dx, dy: self.dy, dz: self.dz },
+        }
+    }
+
+    /// The draft's turn; `None` when a Custom angle is not a number.
+    #[must_use]
+    pub fn draft_rot(&self) -> Option<[f64; 4]> {
+        stock_axis_rot(self.axis, self.angles_deg)
+    }
+
+    /// The note the page shows when the simulation cannot cut the
+    /// drafted stock as it is turned; `None` when it can.
+    #[must_use]
+    pub fn sim_note(&self) -> Option<&'static str> {
+        let rot = self.draft_rot()?;
+        let loc = Location { pos: Point3::new(self.x, self.y, self.z), rot };
+        match sim_frame(&self.draft_shape(), loc) {
+            Ok(_) => None,
+            Err(e) if e == LAID_CYLINDER => Some(SIM_NOTE_LAID),
+            Err(_) => Some(SIM_NOTE_TILTED),
+        }
+    }
+}
+
+impl State {
+    /// One undoable `SetStock` for the active setup's stock at `pos`
+    /// turned `rot`; a refusal is shown on the Setup scope.
+    pub(super) fn dispatch_set_stock(&mut self, shape: StockShape, pos: [f64; 3], rot: [f64; 4]) {
+        let location = Location { pos: Point3::new(pos[0], pos[1], pos[2]), rot };
+        match SetStock::new(&self.world, shape, location) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = String::from("stock set");
+            }
+            Err(err) => self.refuse(ErrorScope::Setup, format!("stock not set: {err}")),
+        }
+    }
+}
diff --git a/docs/decisions/2576-stock-axis.md b/docs/decisions/2576-stock-axis.md
new file mode 100644
index 000000000..048f4db8f
--- /dev/null
+++ b/docs/decisions/2576-stock-axis.md
@@ -0,0 +1,45 @@
+## #2576 - Stock axis on the Stock page: Along Z / X / Y / Custom
+
+**Decided.** The Stock page gets a "Stock axis" choice: Along Z (the
+default), Along X, Along Y and Custom. Custom shows three angles in
+degrees (turn about Z, tilt about Y, tilt about X). The choice applies to
+a box and to a cylinder. The turn is stored in the stock's existing
+`Location.rot`, so the project file does not change and needs no new
+version. The page reads a stored turn back: a preset turn shows its
+preset, any other turn shows Custom with its angles.
+
+- Apply sends the whole turn through the undoable `SetStock`. The UI has
+  a new queue entry `CommandKind::SetStockPose { shape, pos, rot }`. The
+  old `CommandKind::SetStock { shape, pos, yaw_deg }` stays as it is,
+  because about 96 test sites use it. The two run the same dispatch.
+- The MCP `set_stock` tool takes an optional `axis` ("z", "x", "y") or
+  `angles_deg` ({yaw, pitch, roll}), not both. It calls the same
+  `SetStock`.
+- The simulation laws do not change. `OBLIQUE_STOCK` and `LAID_CYLINDER`
+  still refuse a stock that the simulation cannot cut. The page shows a
+  plain note before any simulation, from the same law
+  (`stock_follow::sim_frame`), so the note and the refusal cannot differ.
+  A box laid along X or Y is a square turn: the simulation cuts it, and
+  no note shows.
+- A DXF profile lies on the stock's top face. That face was read in the
+  stock's own frame and ignored a tilt. Now an upright stock (any turn
+  about Z) keeps its own top face, a stock laid square is read as the
+  same solid unturned (the simulation's law), and a laid cylinder or a
+  tilted stock is refused by name (`sketch::NO_TOP_FACE`).
+
+**Why.** The maintainer asked for a cylinder that is not along Z. The
+turn already exists in the document (`Location.rot`), and the viewport
+already draws it. Only the page could not set it.
+
+**Dropped.**
+- An axis field in `StockShape::Cylinder`: it duplicates the turn that
+  `Location.rot` holds, and it needs a project-file version step.
+- Silent acceptance in the simulation: a laid cylinder would simulate as
+  an upright one, which is a wrong answer. The refusal stays until the
+  follow-up issue makes the simulation cut it.
+- A rename of the old `CommandKind::SetStock` fields: it touches about 96
+  test sites for no change in behaviour.
+
+**Cost to change later.** Low. The axis choice is a view of
+`Location.rot`. When the simulation cuts a laid stock, the note goes
+away by itself, because it asks the simulation's law.

From 7031b8045bfd16208f02cbd78099e94d7d40b4b0 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 11:15:18 +0100
Subject: [PATCH 2/4] fix(app): fit a laid stock in its own frame; move
 set_stock out of mcp/edit.rs

Review fix of PR #2773.

- Fit to Models (Stock page and MCP fit_stock) measures the parts in
  the stock's own frame (stock_fit::fitted_turned), so a stock laid
  along X or Y wraps the parts. Before, a world-frame size was put on
  the turned solid and did not hold the parts.
- mcp/edit.rs was over 400 lines: set_stock and its turn parser move
  to mcp/stock_tools.rs.
- The custom angle rows get hover text; the axis test pins redo.

Pinned by fit_to_models_wraps_the_part_in_a_laid_stocks_frame.

Refs #2576

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
