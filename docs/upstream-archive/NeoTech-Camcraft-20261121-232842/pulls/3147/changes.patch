From 583d05fdab639b43c3181e10f2b5e6dba46e47f1 Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Sat, 21 Nov 2026 10:39:43 +0000
Subject: [PATCH] test(app): the AI guide test reads a CRLF checkout of the
 guide

A Windows checkout with core.autocrlf writes
site/content/guide/automate/ai.md with CRLF line ends. The test split
the text on "```json\n", found no fence, and failed with "the four tasks
need complete tools/call examples".

The test now changes CRLF to LF after it reads the guide. A new test
makes a CRLF copy of the guide and checks that it gives the same
tools/call examples as the LF text.

Fixes #3119

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/ai_guide.rs         | 45 ++++++++++++++++++++++++----
 docs/decisions/3119-ai-guide-crlf.md | 19 ++++++++++++
 2 files changed, 59 insertions(+), 5 deletions(-)
 create mode 100644 docs/decisions/3119-ai-guide-crlf.md

diff --git a/crates/app/tests/ai_guide.rs b/crates/app/tests/ai_guide.rs
index 974ef073a..d53118d93 100644
--- a/crates/app/tests/ai_guide.rs
+++ b/crates/app/tests/ai_guide.rs
@@ -4,19 +4,33 @@
 use camcraft_app::{cli, mcp};
 use serde_json::{Value, json};
 
-fn guide() -> String {
+fn guide_raw() -> String {
     std::fs::read_to_string(concat!(
         env!("CARGO_MANIFEST_DIR"), "/../../site/content/guide/automate/ai.md"
     )).expect("the AI guide exists")
 }
 
-#[test]
-fn ai_guide_calls_match_live_tools_list() {
-    let text = guide();
+/// The guide text with LF line ends. A Windows checkout with
+/// `core.autocrlf` has CRLF in the file, and the fence and line splits
+/// below look for `\n` (#3119).
+fn guide_text(raw: &str) -> String {
+    raw.replace("\r\n", "\n")
+}
+
+fn guide() -> String {
+    guide_text(&guide_raw())
+}
+
+fn live_tools() -> Vec<Value> {
     let reply = mcp::Server::new().handle(&json!({
         "jsonrpc": "2.0", "id": 1, "method": "tools/list", "params": {}
     })).expect("tools/list response");
-    let tools = reply["result"]["tools"].as_array().expect("live tools");
+    reply["result"]["tools"].as_array().expect("live tools").clone()
+}
+
+/// Checks each fenced `tools/call` example against the live schema and
+/// returns how many there are.
+fn checked_calls(text: &str, tools: &[Value]) -> usize {
     let mut calls = 0;
     for block in text.split("```json\n").skip(1) {
         let value: Value = serde_json::from_str(block.split("```").next().expect("fence"))
@@ -37,6 +51,14 @@ fn ai_guide_calls_match_live_tools_list() {
         }
         calls += 1;
     }
+    calls
+}
+
+#[test]
+fn ai_guide_calls_match_live_tools_list() {
+    let text = guide();
+    let tools = live_tools();
+    let calls = checked_calls(&text, &tools);
     assert!(calls >= 12, "the four tasks need complete tools/call examples");
     // Also check inline tool names, so prose cannot drift beyond the fenced examples.
     for word in text.split('`').skip(1).step_by(2) {
@@ -64,3 +86,16 @@ fn ai_guide_camcraft_flags_match_parsers() {
     assert!(text.contains("camcraft-ui --mcp-port 7777"));
     assert!(text.contains("camcraft-cli mcp --connect 127.0.0.1:7777"));
 }
+
+#[test]
+fn a_crlf_checkout_of_the_guide_reads_the_same_examples() {
+    // #3119: what a Windows checkout with `core.autocrlf` gives.
+    let raw = guide_raw().replace("\r\n", "\n");
+    let crlf = raw.replace('\n', "\r\n");
+    assert!(crlf.contains("```json\r\n"), "the CRLF copy has CRLF fences");
+    let tools = live_tools();
+    let lf_calls = checked_calls(&guide_text(&raw), &tools);
+    assert!(lf_calls >= 12, "the LF guide has its examples: {lf_calls}");
+    assert_eq!(checked_calls(&guide_text(&crlf), &tools), lf_calls, "CRLF finds the same tools/call examples");
+    assert_eq!(guide_text(&crlf), guide_text(&raw), "CRLF normalizes to the LF text");
+}
diff --git a/docs/decisions/3119-ai-guide-crlf.md b/docs/decisions/3119-ai-guide-crlf.md
new file mode 100644
index 000000000..9595bec8b
--- /dev/null
+++ b/docs/decisions/3119-ai-guide-crlf.md
@@ -0,0 +1,19 @@
+## #3119 - The AI guide test reads a CRLF checkout
+
+**Decided:** `crates/app/tests/ai_guide.rs` changes CRLF to LF after it reads
+`site/content/guide/automate/ai.md`. A new test makes a CRLF copy of the
+guide and checks that it gives the same `tools/call` examples as the LF text.
+
+**Why:** a Windows checkout with `core.autocrlf` writes the guide with CRLF.
+The test split the text on "```json\n", found no fence, and failed. The fix is
+in the one place that reads the file, and it works in each checkout that
+exists now, with no new checkout or `git add --renormalize` step.
+
+**Dropped:** a `.gitattributes` rule (`site/content/** text eol=lf`). It
+makes Git write LF only in new checkouts. An existing Windows clone keeps
+CRLF until the user checks out the files again, so the test stays red for
+them. The rule also changes the bytes of the site sources for each Windows
+author, which is a larger change than a test fix.
+
+**Cost to change later:** low. A `.gitattributes` rule can come later. The
+normalization in the test then has no effect, and the test stays correct.
