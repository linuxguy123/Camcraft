+    fn square(h: f64) -> Region {
+        let p = |x: f64, y: f64| Point2::new(x, y);
+        Region::new(vec![Loop::new(vec![p(-h, -h), p(h, -h), p(h, h), p(-h, h)]).expect("loop")]).expect("region")
+    }
