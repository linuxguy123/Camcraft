+fn box_point(aabb: Option<crate::geometry::Aabb>, point: BoxPoint, empty: &str) -> Result<[f64; 3], CommandError> {
+    let b = aabb.ok_or_else(|| CommandError::Invalid(empty.to_string()))?;
+    Ok(match point {
+        BoxPoint::Corner => [b.min.x, b.min.y, b.min.z],
+        BoxPoint::Centre => [
+            (b.min.x + b.max.x) / 2.0,
+            (b.min.y + b.max.y) / 2.0,
+            (b.min.z + b.max.z) / 2.0,
+        ],
+    })
