+/// itself. `None` with no part geometry.
+#[must_use]
+pub fn held_centre(world: &World, held: Location) -> Option<Point3> {
+    if held == Location::default() {
+        return setup_align::part_centre(world);
+    }
+    let (mut lo, mut hi) = ([f64::MAX; 3], [f64::MIN; 3]);
+    let mut any = false;
