[
  {
    "sha": "34951dd413790f0f53e8df5f153674c092d14e09",
    "node_id": "C_kwDOVoU8JdoAKDM0OTUxZGQ0MTM3OTBmMGY1M2U4ZGY1ZjE1MzY3NGMwOTJkMTRlMDk",
    "commit": {
      "author": {
        "name": "Mike Kinney",
        "email": "mike.kinney@gmail.com",
        "date": "2026-11-08T19:25:26Z"
      },
      "committer": {
        "name": "Mike Kinney",
        "email": "mike.kinney@gmail.com",
        "date": "2026-11-08T19:25:26Z"
      },
      "message": "fix(ui): macOS Cmd+Q asks about unsaved changes\n\nwinit 0.30's default app menu Quit (Cmd+Q) sends terminate: to\nNSApplication, and winit's app delegate has no\napplicationShouldTerminate:, so the process ended at once and the\nSave / Don't Save / Cancel prompt (#107) was skipped. The same path\nserves the Dock's Quit, quit Apple Events and logout.\n\negui_app/os_quit.rs adds applicationShouldTerminate: to winit's\ndelegate class at startup (class_addMethod via objc2 0.5, already in\nthe lock; macOS only). It cancels the terminate and raises a flag that\nthe shell's about_to_wait turns into the same guarded Quit command the\nwindow X queues, bringing the window forward for the prompt. If winit\never ships its own handler, the add is refused, logged, and winit's\nbehaviour stands.\n\nPinned by os_quit_request_over_unsaved_changes_prompts_once.\n\nFixes #144\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>",
      "tree": {
        "sha": "91f5893879827bed9b5ac4f3bd416ae0642bfe43",
