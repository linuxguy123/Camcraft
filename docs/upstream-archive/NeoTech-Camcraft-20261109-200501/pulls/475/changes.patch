+    pub fn spun(world: &World, name: &str, points: Option<Vec<SpunPoint>>) -> Result<Self, CommandError> {
+        let Some(entity) = model::find_by_name(world, name) else {
+            return Err(CommandError::NotFound(name.to_string()));
