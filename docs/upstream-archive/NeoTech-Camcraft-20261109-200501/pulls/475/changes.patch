diff --git a/crates/ui/src/state_tool_profile.rs b/crates/ui/src/state_tool_profile.rs
new file mode 100644
index 00000000..b5fa561e
--- /dev/null
+++ b/crates/ui/src/state_tool_profile.rs
@@ -0,0 +1,152 @@
+//! The tool editor's spun-profile draft (#93): the holder of a milling
+//! tool drawn as a revolved half-outline - Parametric (the holder
+//! cylinder the tool's numbers state, regenerated as they change) or
+//! Custom (hand-edited points that survive number edits). The draft is
+//! ephemeral pane state like `ToolBodyUi`; Apply profile queues the one
+//! command (`SetToolBody::spun`: a drawn body, or a clear back to the
+//! cylinder), and its refusal lands on the Tool pane by name. Turning
+//! tools are not spun profiles and never get this draft (owner, #93).
+//! Provenance: our own pane state over `app::tool_body_view`; no vendor
+//! material consulted.
+
+use std::sync::Arc;
+
+use camcraft_app::commands::SetToolBody;
+use camcraft_app::geometry::Triangle;
+use camcraft_app::spun::{SpunPoint, SpunProfile};
+use camcraft_app::tools::{Tool, ToolKind};
+
+use super::{CommandKind, ErrorScope, State};
+
+/// Which section the editor's third column shows.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ToolColumn {
+    #[default]
+    Body,
+    Profile,
+}
+
+/// The editor's profile draft for the tool it is open on.
+#[derive(Clone, Default)]
+pub struct ToolProfileUi {
+    /// The tool the draft belongs to (the editor's `tool_ui.name`).
+    pub tool: String,
+    /// The third column's tab (view state only).
+    pub column: ToolColumn,
+    /// Custom: `points` are hand edits. Parametric: they are regenerated
+    /// from the draft tool's holder numbers every frame.
+    pub custom: bool,
+    /// The drawn holder outline, tip-up (z, r, arc).
+    pub points: Vec<SpunPoint>,
+    /// The world body the draft last mirrored (identity): Apply, Undo,
+    /// Redo or Open re-mirror.
+    seen: Option<Arc<[Triangle]>>,
+}
+
+/// Is `kind` a milling tool - one a spun profile describes?
+#[must_use]
+pub fn is_spun_kind(kind: ToolKind) -> bool {
+    !matches!(kind, ToolKind::Turning | ToolKind::Groove | ToolKind::Thread | ToolKind::Form)
+}
+
+/// The parametric holder of `tool` as table points (empty when it has
+/// no holder).
+#[must_use]
+pub fn parametric_points(tool: &Tool) -> Vec<SpunPoint> {
+    SpunProfile::holder_of(tool).map(|s| s.points().to_vec()).unwrap_or_default()
+}
+
+impl State {
+    /// Keep the draft on the editor's tool: a new tool, or a world body
+    /// that changed under it, re-mirrors - a drawn body re-edits as
+    /// Custom, anything else starts Parametric. In Parametric the points
+    /// follow the draft numbers.
+    pub(crate) fn sync_tool_profile_ui(&mut self) {
+        let landed = self.editor_tool_body();
+        let facets = landed.as_ref().map(|b| Arc::clone(&b.facets));
+        let same = match (&facets, &self.tool_profile_ui.seen) {
+            (None, None) => true,
+            (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+            _ => false,
+        };
+        if self.tool_profile_ui.tool != self.tool_ui.name || !same {
+            let column = self.tool_profile_ui.column;
+            let mut d = ToolProfileUi { tool: self.tool_ui.name.clone(), column, ..ToolProfileUi::default() };
+            if let Some(spun) = landed.and_then(|b| b.spun) {
+                d.custom = true;
+                d.points = spun.points().to_vec();
+            }
+            d.seen = facets;
+            self.tool_profile_ui = d;
+        }
+        if !self.tool_profile_ui.custom {
+            self.tool_profile_ui.points = parametric_points(&self.tool_ui.to_tool());
+        }
+    }
+
+    /// Flip Parametric/Custom. Custom starts from what is drawn now (the
+    /// parametric cylinder), so the hand edits begin on the tool's own
+    /// holder; Parametric drops the edits (they live on in the history
+    /// only once applied).
+    pub(crate) fn set_profile_custom(&mut self, custom: bool) {
+        let d = &mut self.tool_profile_ui;
+        if d.custom == custom {
+            return;
+        }
+        d.custom = custom;
+        if custom && d.points.is_empty() {
+            // No holder numbers to start from: a 20 mm collar on the
+            // shank top, a shape to edit rather than an empty table.
+            let t = self.tool_ui.to_tool();
+            let zs = (t.flute_len + t.shank_len).max(0.0);
+            let r = (t.shank_d * 0.5).max(1.0) + 5.0;
+            d.points = vec![SpunPoint::line(zs, 0.0), SpunPoint::line(zs, r), SpunPoint::line(zs + 20.0, r), SpunPoint::line(zs + 20.0, 0.0)];
+        }
+    }
+
+    /// Insert a point after row `i`, midway to the next (a Custom edit).
+    pub(crate) fn insert_profile_point(&mut self, i: usize) {
+        let d = &mut self.tool_profile_ui;
+        let (Some(a), Some(b)) = (d.points.get(i).copied(), d.points.get(i + 1).copied()) else {
+            return;
+        };
+        let mid = SpunPoint::line((a.z + b.z) * 0.5, (a.r + b.r) * 0.5);
+        d.points.insert(i + 1, mid);
+        d.custom = true;
+    }
+
+    /// Remove row `i` (a Custom edit); the validation names what is left.
+    pub(crate) fn remove_profile_point(&mut self, i: usize) {
+        let d = &mut self.tool_profile_ui;
+        if i < d.points.len() {
+            d.points.remove(i);
+            d.custom = true;
+        }
+    }
+
+    /// "Apply profile": Custom lands the drawn holder; Parametric clears
+    /// any body back to the cylinder. One command either way.
+    pub(crate) fn queue_apply_tool_profile(&mut self) {
+        let d = &self.tool_profile_ui;
+        let points = d.custom.then(|| d.points.clone());
+        self.pending.push_back(CommandKind::SetToolProfile { name: self.tool_ui.name.clone(), points });
+    }
+
+    /// The command handler: validate and judge now; a refusal lands on
+    /// the Tool pane by name and the draft stays for correction.
+    pub(crate) fn run_set_tool_profile(&mut self, name: &str, points: Option<Vec<SpunPoint>>) {
+        let clearing = points.is_none();
+        match SetToolBody::spun(&self.world, name, points) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = if clearing {
+                    format!("tool {name}: holder back to its parametric cylinder")
+                } else {
+                    format!("tool {name}: holder profile set")
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Tool, format!("holder profile not set: {err}")),
+        }
+    }
+}
diff --git a/docs/decisions/93-spun-tool-editor.md b/docs/decisions/93-spun-tool-editor.md
new file mode 100644
index 00000000..f7b9f55b
--- /dev/null
+++ b/docs/decisions/93-spun-tool-editor.md
@@ -0,0 +1,70 @@
+## #93 - spun (revolved-profile) holder editor for milling tools
+
+- **Chosen: the drawn holder is a `ToolBody`** - a spun profile is a body
+  whose envelope is known exactly. `SetToolBody::spun` builds one from
+  the outline (`tool_body::build_spun`): its facets are the revolve of
+  the outline (so the simulation's tool assembly, the Body tab and any
+  reader that only knows facets see it), its `HolderProfile` is the
+  outline's own bands (not re-derived from the facets), and a new
+  optional `ToolBody::spun` keeps the points for re-editing. Everything
+  downstream of #368 follows for free: the fixture laws read the bands,
+  the one-cylinder laws read `enclose`, the stamp hashes the bands, the
+  flutes/lathe fit law refuses by name, undo/redo/delete snapshot it.
+  Dropped: a separate component or new `Tool` fields - two writers of
+  "the holder" would have to agree, and every `Tool` literal would move.
+- **Storage: no new project rung.** `ToolBodyDto` gains an optional
+  `spun` key (`[z, r, arc]` per point), written only for a drawn body;
+  the facets are written too. A loader with `spun` re-draws the body
+  from it (refusing a bad outline by name: "holder profile: point 3
+  ..."). A v58 reader without the key loads the facets and judges their
+  envelope, whose ring vertices sit on the conservative outline - so it
+  can only over-report, never judge less steel. That is the old-reader
+  law's test, and it passes without a bump (#381 stays at v58).
+- **Outline law (`camcraft_tools::spun`):** (z, r) points tip-up, each
+  segment a line or a circular arc of signed radius (positive bulges
+  away from the axis). Refused by name: < 3 or > 64 points, non-finite,
+  r < 0, z < 0, an end off the axis, an interior point on it, a segment
+  < 0.01 mm, an arc tighter than half its chord, an outline that runs
+  back down the axis (also catches an arc on a flat step), no length,
+  past the 500 mm / 2000 mm body caps. Point numbers are 1-based as the
+  table shows them.
+- **Conservative arcs:** a convex arc flattens to its circumscribed
+  tangent polygon, a concave one to chords on the arc - neither ever
+  falls inside the drawn solid. Bands: one per climbing segment at its
+  larger radius, merged past 32 (merging only grows). A stepped profile
+  reads its bands exactly (no 1e-6 pad - there is no clipping dust).
+- **Parametric = no body.** `SpunProfile::holder_of(tool)` is the holder
+  cylinder from the very sums `HolderStack::cylinder` makes (pinned
+  bit-identical for every catalog mill), and `cutter_of(tool)` is
+  `Tool::profile` up to the shank top (cutter + holder rejoin to exactly
+  `Tool::profile`, pinned). Apply in Parametric mode clears any body, so
+  a tool that never went Custom keeps byte-identical stamps and paths.
+  Dropped: landing the parametric cylinder as a body - it would add
+  digest bytes and restale every op for no change in steel.
+- **UI: Body / Profile tabs in the editor's third column**, milling
+  kinds only; a turning tool's column is the Body section alone, as
+  before (owner, #93: lathe and milling tools keep separate editors;
+  turning tools are not spun profiles). Why tabs: the window is already
+  ~760 px wide and ~600 px tall (#371 note); a fourth column or a
+  section under the columns would push Apply off a 720 px screen. The
+  Profile tab: Parametric / Custom, the points table (z, r, arc R; +
+  inserts after a row, × removes; read-only in Parametric), a flat side
+  view to scale (cutter/shank from the numbers, holder from the draft -
+  amber when it validates, red outline when not) with flute, stickout
+  (holder foot) and gauge (holder top) ticks, Ø and shank Ø; the live
+  refusal by name under it; Apply profile. Parametric redraws from the
+  draft numbers every frame; Custom starts from the parametric outline
+  and keeps hand edits through number edits. The draft re-mirrors when
+  the world body changes by identity (Apply/Undo/Redo/Open), like the
+  Body draft: a drawn body re-opens as Custom, anything else as
+  Parametric. An imported body is replaced by Apply profile (said in
+  the tab).
+- **Snapshot:** the editor's pixels change (the tab row). Pixel
+  snapshots are release-lane (#255/#359); `egui_tool_editor.png` is not
+  regenerated. Structural tests pin the flow.
+- **Not in this slice (follow-ups):** a Custom cutter/neck/shank profile
+  (needs its own storage and the law "drawn ⊆ the numbers the cutting
+  laws read"; the type and `cutter_of` are in place), arcs drawn in the
+  table as fillets at a vertex rather than per-segment radii, dragging
+  points in the side view, and a spun profile in the tool library file
+  (#348 stores no bodies yet).

From 729a1bc09dbe4413d7282e6c3d122fe2a673635a Mon Sep 17 00:00:00 2001
From: Mike Kinney <mikekinney@Mikes-MacBook-Pro.local>
Date: Mon, 9 Nov 2026 11:34:49 -0800
Subject: [PATCH 2/3] fix(tools): a zero-height spike stays in the spun
 profile's envelope
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SpunProfile::bands() dropped every non-climbing segment of the outline,
trusting the bands either side to hold both radii at that height. A
flange drawn out and straight back at one z with no band above (the
top), below (the foot) or reaching it (mid-body) fell out of the
envelope: (55,0) (55,25) (90,25) (90,35) (90,0) showed holder Ø70 in
the Profile summary but was judged at r 25. A flat step's larger radius
is now folded into the band touching its height (the one ending there
first) when no touching band already reaches it - a plain step still
reads exactly. The summary reads the new SpunProfile::max_radius, the
same number the widest band now carries.

Pinned by spun::tests::a_zero_height_spike_stays_in_the_envelope and
tool_spun_profile::a_flat_top_flange_is_judged_at_its_full_radius (both
fail before the fix).

Refs #93

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
