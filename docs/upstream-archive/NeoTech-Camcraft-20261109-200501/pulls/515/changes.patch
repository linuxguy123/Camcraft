diff --git a/crates/ui/src/state_setup_post_options.rs b/crates/ui/src/state_setup_post_options.rs
new file mode 100644
index 00000000..7089111b
--- /dev/null
+++ b/crates/ui/src/state_setup_post_options.rs
@@ -0,0 +1,90 @@
+//! A setup's own post options and its tool-list export (#389). The post
+//! page's option widgets (skip pauses and homes, Output, threading) queue
+//! the same `CommandKind`s as before; they land on the ACTIVE setup's own
+//! options (`SetSetupPostOptions`) when it owns them and on the document's
+//! (`SetPostOptions`) when it follows - the `state::setup_mount` routing
+//! law, worn by the options. Every arm is one undoable command. The tool
+//! list export is a read of the document plus a file write: no command,
+//! no history (the setup-sheet law).
+//! Provenance: our own routing law (issue #389); no vendor material consulted.
+
+use std::path::{Path, PathBuf};
+
+use camcraft_app::commands::{CommandError, SetPostOptions, SetSetupPostOptions};
+use camcraft_app::schema::PostOptions;
+use camcraft_app::{setup, setup_post_options, tool_list_export};
+
+use super::{ErrorScope, State};
+
+impl State {
+    /// The active setup when it owns its post options: the setup the
+    /// option widgets edit. `None` - they edit the document's.
+    #[must_use]
+    pub fn post_options_owner(&self) -> Option<String> {
+        let active = setup::active(&self.world)?;
+        setup_post_options::own(&self.world, Some(&active)).map(|_| active)
+    }
+
+    /// Set the post options in force: the active setup's own when it has
+    /// them, else the document's. `done` is the status on success.
+    pub(super) fn route_post_options(&mut self, next: PostOptions, done: &str, refused: &str, scope: ErrorScope) {
+        let owner = self.post_options_owner();
+        let executed: Result<(), CommandError> = match &owner {
+            Some(s) => SetSetupPostOptions::new(&self.world, s, Some(next)).map(|c| self.history.execute(&self.world, c)),
+            None => SetPostOptions::new(&self.world, next).map(|c| self.history.execute(&self.world, c)),
+        };
+        match executed {
+            Ok(()) => {
+                self.doc_version += 1;
+                self.status = match owner {
+                    Some(s) => format!("{done} ({s})"),
+                    None => done.to_owned(),
+                };
+            }
+            Err(err) => self.refuse(scope, format!("{refused}: {err}")),
+        }
+    }
+
+    /// A setup takes its own post options (a copy of the ones it posts
+    /// with now, so nothing it posts changes) or follows the document's.
+    pub(super) fn own_post_options(&mut self, setup: &str, own: bool) {
+        let next = own.then(|| setup_post_options::of(&self.world, Some(setup)));
+        match SetSetupPostOptions::new(&self.world, setup, next) {
+            Ok(c) => {
+                self.history.execute(&self.world, c);
+                self.doc_version += 1;
+                self.status = if own {
+                    format!("{setup} has its own post options")
+                } else {
+                    format!("{setup} follows the document's post options")
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Setup, format!("post options not changed: {err}")),
+        }
+    }
+
+    /// Ask where to write `setup`'s tool list, then write it.
+    pub(super) fn tool_list_export_dialog(&mut self, setup: Option<String>) {
+        let stem = setup.clone().or_else(|| setup::effective(&self.world, None)).unwrap_or_else(|| "setup".to_owned());
+        let picked: Option<PathBuf> = rfd::FileDialog::new()
+            .add_filter("CSV", &["csv"])
+            .add_filter("Text", &["txt"])
+            .set_file_name(format!("{stem}-tools.csv"))
+            .save_file();
+        if let Some(path) = picked {
+            self.tool_list_export_path(setup.as_deref(), &path);
+        }
+    }
+
+    /// Write `setup`'s tool list to `path`: CSV for `.csv`, text
+    /// otherwise. A pure read of the document; the status line is the
+    /// only effect.
+    pub(super) fn tool_list_export_path(&mut self, setup: Option<&str>, path: &Path) {
+        let text = tool_list_export::for_path(&self.world, setup, path);
+        let count = tool_list_export::rows(&self.world, setup).len();
+        match std::fs::write(path, text) {
+            Ok(()) => self.status = format!("tool list ({count} tool(s)) written to {}", path.display()),
+            Err(err) => self.status = format!("tool list write failed: {err}"),
+        }
+    }
+}
diff --git a/docs/decisions/389-setup-tool-list.md b/docs/decisions/389-setup-tool-list.md
new file mode 100644
index 00000000..ceb4d843
--- /dev/null
+++ b/docs/decisions/389-setup-tool-list.md
@@ -0,0 +1,49 @@
+## #389 - Setup Tool list page: its own tool-list export, and per-setup post options (2026-11-08)
+
+- **Chosen: post options per setup as an override.** `SetupDef` gains
+  `post_options: Option<PostOptions>`; `None` (every older file, every new
+  setup) follows the document's `PostOptions` singleton - #343's own /
+  follow-the-document law for the post itself. New undoable command
+  `SetSetupPostOptions`; a datum transfer carries the source's options
+  with its post. The setup's Post page offers "Use the document's post
+  options" / "This setup has its own post options" (a copy of what it
+  posts with now, so nothing changes until edited); the existing option
+  widgets (Skip pauses and homes, Output, Threading) then land on the
+  active setup's own options when it has them, else the document's (the
+  `state::setup_mount` routing law). Why: one law for every mount-like
+  choice; the widgets did not have to move.
+- **Chosen: which options a program posts with.** `posting::post_options`
+  now reads the ACTIVE setup's options (own, else the document's), like
+  `posting::post_of`; the document singleton is
+  `setup_post_options::document`, which the save and `SetPostOptions`
+  read. "Skip pauses and homes" is per operation by nature (it mutes each
+  op's after-action), so each op reads its own setup's switch and setups
+  may differ. The Output (one file per op) and the thread output shape
+  the whole program, so a program whose setups disagree on either is
+  refused by name in the verification gate (beside #343's one-mount
+  clause) instead of being posted half one way. Dropped: refusing any
+  disagreement (needlessly blocks the common "skip stops on the proven
+  setup only" case); silently using the active setup's for all (a silent
+  wrong answer for the other setup).
+- **Chosen: additive file key, no version step.** `SetupDto.post_options`
+  (`{"threading": "g32"|"g76", "skip_stops", "per_op_files"}`, spelled in
+  full - absent already means "follows") is skipped when `None`, so a
+  document that never set per-setup options saves byte for byte as before
+  and keeps version 57. This follows the document's own #110 / #111
+  switches, which were also additive. Cost: an older build opening a file
+  with per-setup options ignores them and posts with the document's
+  options (as the #110/#111 keys already behave); a version step would
+  have changed every saved file and conflicted with the other open
+  setup-file PRs. Changing it later is one version rung.
+- **Chosen: tool-list export as CSV or text by extension.** "Export tool
+  list…" on the setup's Tool list page asks for a path (CSV filter first,
+  default `<setup>-tools.csv`); a `.csv` path writes RFC 4180 CSV (CRLF,
+  quoted fields), anything else a fixed-column text list. Columns: T
+  number, tool name, diameter (mm, three decimals - the setup sheet's
+  voice), kind, holder (`D x L` mm or `none`), operations (labels, in
+  program order). Rows in first-use order from `tool_list::for_setup`, so
+  the export, the sheet and the post agree on the list. A pure read in
+  `app::tool_list_export`; the UI writes the file, nothing enters the
+  history (the setup-sheet law). Dropped: a separate format picker
+  (the save dialog's extension is enough); document units (the sheet is
+  mm-only today; a unit-aware sheet and list belong together).
