+fn a_rotated_work_offset_reads_the_picks_in_the_setup_frame() {
+    use camcraft_app::commands::SetWcsOrigin;
+    use camcraft_app::geometry::{quat_from_euler, Point3};
+    use camcraft_app::schema::Location;
