+        capture: true,
+        both_pieces_restrained: false,
+        stock_centered_in_xy_travel: false,
+        taper_deg: 0.0,
+        burnout: None,
+        clearance: camcraft_app::operation::DEFAULT_CLEARANCE,
+        skims: Vec::new(),
+        four_axis: None,
+        sharp_corners: false,
+    });
