index 000000000..ef67e0d98
--- /dev/null
+++ b/examples/agie/reentrant-die.camscript
@@ -0,0 +1,28 @@
+// Original CAMCraft example. Run from the project root with a fresh output name.
+// A reentrant die opening of lines and arcs: rounded corners, a tooth with
+// sharp tips on the right wall and a tongue with a round tip on the top wall.
+cam.call("load_machine", {builtin: "AGIECUT Classic 2S (template)"});
+// This synthetic job explicitly selects the resident recipe and its preview gap.
+cam.call("edit_machine", {patch: {edm: {conditions: [{
+  id: "AGIE_QN2", role: "rough", gap: 0.005, wire_diameter: 0.25
+}]}}});
+cam.call("add_tool", {catalog: "EDM-W025"});
+cam.call("set_stock", {box: {dx: 80, dy: 60, dz: 20}});
+cam.call("import_dxf", {path: "examples/agie/reentrant-die.dxf"});
+cam.call("move_dxf_profile", {name: "reentrant-die", position: [0, 0], angle: 0});
+cam.call("set_wcs", {origin: [0, 0, 20]});
+cam.call("add_operation", {
+  kind: "Wire Contour", name: "Die1", source: "reentrant-die", tool: "EDM-W025",
+  params: {
+    top_z: 20, bottom_z: 0, side: "die", condition: "AGIE_QN2",
+    start: [0, -7], capture: true
+  }
+});
+// Select the closed chain of the drawing as the die opening.
+const outline = cam.call("list_features", {model: "reentrant-die", kinds: ["chains"]})
+  .chains.find(chain => chain.closed && chain.layer === "profile");
+cam.call("set_operation_geometry", {operation: "Die1",
+  picks: [{model: "reentrant-die", id: outline.id}]
+});
+cam.generate();
+cam.post({to: "REENT20", cps: "Agie Wire EDM (AgieVision)", options: {separationLengthMm: 1.0}});
