+/// The X and Y words of `line`, with the modal values of `at` where a word
+/// is not written.
+fn xy_of(line: &str, at: (f64, f64)) -> (f64, f64) {
+    let word = |c: char| line.split_whitespace().find_map(|w| w.strip_prefix(c).and_then(|v| v.parse::<f64>().ok()));
