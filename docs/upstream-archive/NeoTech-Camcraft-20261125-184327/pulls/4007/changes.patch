+    h.hover_at(h.get_by_label("Tolerance").rect().center());
+    h.run_steps(2);
+    let texts = painted_texts(&h);
+    assert!(
+        texts.iter().any(|t| t.contains("picked edge chains") && t.contains("Geometry tab")),
+        "the guide hint is painted; painted: {texts:?}"
