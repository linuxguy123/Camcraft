+        region: &region,
+        stock: Some(&region),
+        model: Some(&model),
+        tool: &tool,
+        mode: Mode::Area,
+        stock_top_z: 30.0,
+        clearance_z: 60.0,
+        gouge_tol: 0.01,
+        z_tol: 1e-6,
+        ..Default::default()
+    };
+    let moves = (0..500).map(|k| {
+        let z = 9.0 + z_offset - f64::from(k) * 8.0 / 500.0;
+        feed((x, y, z), (x, y, z - 8.0 / 500.0))
+    }).collect();
+    let path = Toolpath { moves, ..Toolpath::default() };
+    shank_hits(&super::verify(&path, &cx))
+}
