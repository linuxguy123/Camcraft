             let mut zs: Vec<u64> = rest.cut().iter().map(|c| c.2.to_bits()).collect();
             zs.sort_unstable();
             zs.dedup();
-            // #3831: the planes of one prismatic slab share one section
-            // (`Rest::island_slice`), read once here. Each plane used to
-            // put its own vertices on the slab's walls - a point that
-            // runs the length of every wall as the plane rises - so the
-            // shared section is sampled along its walls instead
-            // (`slab::wall_samples`), never at its corners alone.
-            let mut read: Vec<*const super::slice_index::IndexedSlice> = Vec::new();
+            // #3831: geometric slab sections may share their point set,
+            // but their vertices and vertex means depend on the plane.
+            // Neither spaced wall samples nor a band-width threshold
+            // proves coverage of their nudged boundary samples. Keep
+            // every plane's original samples, including narrow annuli
+            // and near-tangent contacts with uncut stock.
             for k in zs {
                 stats.slices += 1;
-                if let Some(s) = rest.island_slice(f, f64::from_bits(k)) {
-                    let id = std::rc::Rc::as_ptr(&s);
-                    if !read.contains(&id) {
-                        read.push(id);
-                        samples.extend(boundary_samples(s.region()));
-                        if rest.stands_for_slab(&s) {
-                            samples.extend(super::slab::wall_samples(s.region()));
-                        }
-                    }
+                if let Some(s) = rest.reach_slice(f, f64::from_bits(k)) {
+                    samples.extend(boundary_samples(s.region()));
                 }
             }
         }
diff --git a/crates/sim/src/verify/rest.rs b/crates/sim/src/verify/rest.rs
index 07e309f03..951be24de 100644
--- a/crates/sim/src/verify/rest.rs
+++ b/crates/sim/src/verify/rest.rs
@@ -212,11 +212,20 @@ impl<'c, 'a> Rest<'c, 'a> {
         self.slabs.get_or_init(|| Some(Slabs::new(model))).as_ref()?.of(z)
     }
 
-    /// Whether `s` is the one section of a prismatic slab (#3831): it
-    /// stands for every plane between the slab's flat ones, so the reach
-    /// law reads its walls along their length ([`super::slab::wall_samples`]).
-    pub(super) fn stands_for_slab(&self, s: &Rc<IndexedSlice>) -> bool {
-        self.slab_cache.borrow().values().any(|v| Rc::ptr_eq(v, s))
+    /// The section whose vertices law (c) samples at plane `z`.
+    /// A shared slab preserves geometric membership, but not the vertices
+    /// or their mean that `boundary_samples` nudges toward. No replacement
+    /// sample set proves coverage of those points, so section each such
+    /// plane exactly. Other planes reuse their exact cached section.
+    pub(super) fn reach_slice(&self, facets: &[Triangle], z: f64) -> Option<Rc<IndexedSlice>> {
+        let s = self.island_slice(facets, z)?;
+        if !self.slab_cache.borrow().values().any(|v| Rc::ptr_eq(v, &s)) {
+            return Some(s);
+        }
+        self.sliced.set(self.sliced.get().saturating_add(1));
+        crate::geometry::slice::material_above_of(facets, self.bodies, z)
+            .ok()
+            .map(|r| Rc::new(IndexedSlice::new(r)))
