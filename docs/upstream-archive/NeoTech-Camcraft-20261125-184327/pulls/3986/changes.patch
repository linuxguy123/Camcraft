@@ -0,0 +1,152 @@
+//! The plasma cut's start and exit picks (#3334, design #1448): which
+//! closed contour takes a pick, where the pick lands on its profile, and
+//! the run of the cut past its start to the exit. A pick is a wish: a pick
+//! that no closed profile is near, or that a law cannot hold, is refused
+//! by name - it is never moved.
+//!
+//! Provenance: first principles - the closest point of a polyline to a
+//! point (orthogonal projection clamped to each segment); the chosen
+//! pierce and exit position is general plasma practice (the pierce mark
+//! and the lead belong in the scrap). Our own code, no vendor material.
+
+use crate::cl::ContourRole;
+use crate::geo2d::Point2;
+use crate::machining2d::GenError;
+use crate::path_picks::{PathPicks, PickRole};
+use crate::sheet::nest::Contour;
+use crate::sheet::ring::{dist, nearest};
+use crate::sheet::Voice;
+
+use super::PlasmaParams;
+
+/// Why an exit pick is refused under control compensation: the control
+/// builds the G40 cancel over the programmed contour, and that contour
+/// ends at the seam. The application's door says the same words.
+pub const EXIT_WITH_CONTROL_COMP: &str = "an exit point is not taken with control compensation (G41/G42) yet - the programmed contour ends at its start; clear the exit point or compensate in the computer";
+
+/// How far (in kerf widths) a pick may sit from the profile it lands on:
+/// the 2D contour's measure (#1448), one and a half tool diameters.
+pub const PICK_REACH_KERFS: f64 = 1.5;
+
+/// A matched pick: the point as the user gave it (the refusals name it)
+/// and its projection on the profile of its contour.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Seat {
+    pub pick: Point2,
+    pub foot: Point2,
+}
+
+impl Seat {
+    /// The pick's name in a refusal or a note: `start point (x, y)`.
+    pub(super) fn at(&self, role: PickRole) -> String {
+        name(role, self.pick)
+    }
+}
+
+fn name(role: PickRole, q: Point2) -> String {
+    format!("{} point ({:.3}, {:.3})", role.word(), q.x, q.y)
+}
+
+/// What the picks ask of one contour. The default asks nothing: the
+/// automatic seam of every earlier file.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(super) struct Ask {
+    pub start: Option<Seat>,
+    pub exit: Option<Seat>,
+}
+
+/// Give each pick to the closed contour whose profile is nearest: one
+/// [`Ask`] for each contour of `cs`. No pick answers the default for all
+/// of them. Refused by name: a pick that no planner can read, an exit
+/// pick under control compensation, a pick with no closed contour to
+/// land on, and a pick farther than the reach from each profile.
+pub(super) fn assign(cs: &[Contour], picks: &PathPicks, p: &PlasmaParams) -> Result<Vec<Ask>, GenError> {
+    let mut asks = vec![Ask::default(); cs.len()];
+    if picks.is_empty() {
+        return Ok(asks);
+    }
+    let invalid = |why: String| Voice::PLASMA.invalid(why);
+    if let Some(why) = picks.refusal() {
+        return Err(invalid(why));
+    }
+    let reach = PICK_REACH_KERFS * p.kerf;
+    for role in [PickRole::Start, PickRole::Exit] {
+        let Some(q) = picks.first(role).map(|k| k.xy) else {
+            continue;
+        };
+        let (at, what) = (name(role, q), role.word());
+        if role == PickRole::Exit && p.control_comp {
+            return Err(invalid(format!("{at}: {EXIT_WITH_CONTROL_COMP}")));
+        }
+        let best = cs
+            .iter()
+            .enumerate()
+            .filter(|(_, c)| c.role != ContourRole::Open && !c.pts.is_empty())
+            .map(|(k, c)| {
+                let foot = nearest(&c.pts, q).1;
+                (k, foot, dist(foot, q))
+            })
+            .filter(|(_, _, d)| d.is_finite())
+            .min_by(|a, b| a.2.total_cmp(&b.2));
+        let Some((k, foot, d)) = best else {
+            return Err(invalid(format!(
+                "{at}: a {what} point is taken on a closed contour only - an open run is pierced at its first point; clear the {what} point"
+            )));
+        };
+        if d > reach {
+            return Err(invalid(format!(
+                "{at} is {d:.3} mm from the nearest closed profile, farther than the {reach:.3} mm a {what} point may sit from it - pick on the profile to cut, or clear the {what} point"
+            )));
+        }
+        let seat = Some(Seat { pick: q, foot });
+        if let Some(ask) = asks.get_mut(k) {
+            match role {
+                PickRole::Start => ask.start = seat,
+                PickRole::Exit => ask.exit = seat,
+            }
+        }
+    }
+    Ok(asks)
+}
+
+/// The run of the cut past its start to `e`: the points of the closed
+/// `walk` (start .. back to the start) after its first point, up to the
+/// point of the walk nearest `e`. Empty when `e` is the start itself.
+/// The nearest stretch wins and the first one wins a tie, so an exit at
+/// the start adds no second lap.
+pub(super) fn run_on(walk: &[Point2], e: Point2) -> Vec<Point2> {
+    // Under this distance two points of a walk are one (`ring::walk_from`).
+    const SAME: f64 = 1e-9;
+    let mut best: Option<(usize, Point2, f64)> = None;
+    for (i, w) in walk.windows(2).enumerate() {
+        let (a, b) = (w[0], w[1]);
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let dd = dx * dx + dy * dy;
+        let t = if dd > 0.0 { (((e.x - a.x) * dx + (e.y - a.y) * dy) / dd).clamp(0.0, 1.0) } else { 0.0 };
+        let f = Point2::new(a.x + t * dx, a.y + t * dy);
+        let d = dist(f, e);
+        if d.is_finite() && best.is_none_or(|(_, _, bd)| d < bd - SAME) {
+            best = Some((i, f, d));
+        }
+    }
+    let Some((i, f, _)) = best else {
+        return Vec::new();
+    };
+    let mut out: Vec<Point2> = walk[1..=i].to_vec();
+    let last = out.last().or(walk.first()).copied();
+    if last.is_none_or(|q| dist(q, f) > SAME) {
+        out.push(f);
+    }
+    out
+}
+
+/// The length of the stretch `from` .. `pts`, mm.
+pub(super) fn length(from: Point2, pts: &[Point2]) -> f64 {
+    let mut at = from;
+    let mut sum = 0.0;
+    for &q in pts {
+        sum += dist(at, q);
+        at = q;
+    }
+    sum
+}
diff --git a/crates/motion/src/plasma/picks_tests.rs b/crates/motion/src/plasma/picks_tests.rs
new file mode 100644
index 000000000..7dcbbdaf6
--- /dev/null
+++ b/crates/motion/src/plasma/picks_tests.rs
@@ -0,0 +1,225 @@
+//! The plasma profile's start and exit picks (#3334): the lead-in lands
+//! on the start pick, the cut runs on to the exit pick, each other
+//! contour keeps its automatic cut, and each pick that a law cannot hold
+//! is refused by name.
+//!
+//! Provenance: our own tests over our own fixtures.
+
+use super::picks::run_on;
+use super::*;
+use crate::cl::{ContourRole, Toolpath};
+use crate::path_picks::PathPick;
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+    Loop::new(vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)]).unwrap()
+}
+
+fn circle(cx: f64, cy: f64, r: f64) -> Loop {
+    Loop::new((0..96).map(|k| {
+        let t = std::f64::consts::TAU * f64::from(k) / 96.0;
+        Point2::new(cx + r * t.cos(), cy + r * t.sin())
+    }).collect()).unwrap()
+}
+
+fn params() -> PlasmaParams {
+    PlasmaParams {
+        kerf: 1.5,
+        control_comp: false,
+        reversed: false,
+        lead_in: 4.0,
+        lead_out: 3.0,
+        small_hole_dia: SMALL_HOLE_DIA,
+        small_hole_feed: SMALL_HOLE_FEED,
+        overburn: 2.0,
+        thickness: 6.0,
+        feed: Some(2500.0),
+        clearance_z: 10.0,
+        cut_z: 0.0,
+        pierce_height: None,
+        cut_height: None,
+        pierce_delay: None,
+        model_excess: 0.0,
+        file_tolerance: false,
+    }
+}
+
+/// A 100 x 60 plate with a Ø40 hole at (30, 30) and a Ø10 hole at (75, 30).
+fn plate() -> (Vec<Loop>, Region) {
+    let loops = vec![rect(0.0, 0.0, 100.0, 60.0), circle(30.0, 30.0, 20.0), circle(75.0, 30.0, 5.0)];
+    let part = Region::new(loops.clone()).unwrap();
+    (loops, part)
+}
+
+fn picks(start: Option<(f64, f64)>, exit: Option<(f64, f64)>) -> PathPicks {
+    let one = |p: Option<(f64, f64)>| p.map(|(x, y)| PathPick::xy(Point2::new(x, y))).into_iter().collect();
+    PathPicks { start: one(start), exit: one(exit) }
+}
+
+fn cut(p: &PlasmaParams, k: &PathPicks) -> Result<Toolpath, String> {
+    let (loops, part) = plate();
+    plasma_profile_picked(&loops, &[], &part, p, k).map_err(|e| e.to_string())
+}
+
+/// The lit moves of the contour whose first lit move is nearest `near`
+/// (the three contours of the plate stand far from each other).
+fn span(path: &Toolpath, small: bool, role: ContourRole) -> (usize, usize) {
+    let rec = path.plasma.as_ref().unwrap();
+    let t = rec.torches.iter().find(|t| t.role == role && t.small.is_some() == small).unwrap();
+    (t.on, t.off)
+}
+
+fn at(p: crate::geometry::Point3, x: f64, y: f64, tol: f64) -> bool {
+    (p.x - x).hypot(p.y - y) < tol
+}
+
+fn stretch(path: &Toolpath, (on, off): (usize, usize)) -> Vec<(crate::geometry::Point3, crate::geometry::Point3)> {
+    path.moves[on - 1..=off].iter().map(|m| (m.from, m.to)).collect()
+}
+
+#[test]
+fn no_pick_is_the_automatic_path_move_for_move() {
+    let (loops, part) = plate();
+    let plain = plasma_profile(&loops, &[], &part, &params()).unwrap();
+    let picked = plasma_profile_picked(&loops, &[], &part, &params(), &PathPicks::default()).unwrap();
+    assert_eq!(plain.moves, picked.moves);
+    assert_eq!(plain.notes, picked.notes);
+    assert_eq!(plain.plasma, picked.plasma);
+}
+
+/// The outline is cut clockwise: along the bottom edge the torch runs in
+/// -X, at y = -0.75.
+#[test]
+fn the_lead_in_lands_on_the_start_pick_and_the_other_contours_keep_their_cut() {
+    let auto = cut(&params(), &PathPicks::default()).unwrap();
+    let path = cut(&params(), &picks(Some((50.0, 0.0)), None)).unwrap();
+    let (on, off) = span(&path, false, ContourRole::Outer);
+    assert!(at(path.moves[on].to, 50.0, -0.75, 1e-6), "{:?}", path.moves[on].to);
+    assert!(path.moves[on].from.y < -0.75 - 1.0, "the pierce is in the scrap: {:?}", path.moves[on].from);
+    assert!(at(path.moves[off].from, 50.0, -0.75, 1e-6), "no exit pick: the lead-out leaves at the start");
+    assert!(path.moves[on + 1].to.x < 50.0, "the cut direction is not changed");
+    let (a_on, _) = span(&auto, false, ContourRole::Outer);
+    assert!(!at(auto.moves[a_on].to, 50.0, -0.75, 1.0), "the automatic seam is elsewhere");
+    for (small, role) in [(false, ContourRole::Inner), (true, ContourRole::Inner)] {
+        assert_eq!(stretch(&auto, span(&auto, small, role)), stretch(&path, span(&path, small, role)));
+    }
+    assert!(path.notes.iter().any(|n| n.contains("starts at the start point (50.000, 0.000)")), "{:?}", path.notes);
+    assert!(path.plasma.as_ref().unwrap().is_sane(&path.moves));
+}
+
+#[test]
+fn the_cut_runs_on_to_the_exit_pick_and_the_lead_out_leaves_there() {
+    let path = cut(&params(), &picks(Some((50.0, 0.0)), Some((40.0, 0.0)))).unwrap();
+    let (on, off) = span(&path, false, ContourRole::Outer);
+    assert!(at(path.moves[on].to, 50.0, -0.75, 1e-6));
+    assert!(at(path.moves[off].from, 40.0, -0.75, 1e-6), "{:?}", path.moves[off].from);
+    assert!(path.moves[off].to.y < -0.75 - 1.0, "the torch goes off in the scrap: {:?}", path.moves[off].to);
+    let laps = path.moves[on..=off].iter().filter(|m| at(m.to, 50.0, -0.75, 1e-6)).count();
+    assert_eq!(laps, 2, "the whole outline is cut before the run to the exit");
+    assert!(path.notes.iter().any(|n| n.contains("runs on 10.000 mm past its start to the exit point (40.000, 0.000)")), "{:?}", path.notes);
+    // An exit pick alone: the automatic start, and the same exit.
+    let auto = cut(&params(), &PathPicks::default()).unwrap();
+    let alone = cut(&params(), &picks(None, Some((40.0, 0.0)))).unwrap();
+    let ((a_on, _), (e_on, e_off)) = (span(&auto, false, ContourRole::Outer), span(&alone, false, ContourRole::Outer));
+    assert_eq!(auto.moves[a_on].to, alone.moves[e_on].to, "the start stays automatic");
+    assert!(at(alone.moves[e_off].from, 40.0, -0.75, 1e-6), "{:?}", alone.moves[e_off].from);
+    // An exit pick on the start adds no second lap.
+    let same = cut(&params(), &picks(Some((50.0, 0.0)), Some((50.0, 0.0)))).unwrap();
+    let start_only = cut(&params(), &picks(Some((50.0, 0.0)), None)).unwrap();
+    assert_eq!(same.moves, start_only.moves);
+}
+
+/// The Ø40 hole is not small: it is cut counter-clockwise with arc leads.
+#[test]
+fn a_pick_on_a_hole_lands_on_the_hole_and_pierces_in_its_slug() {
+    let path = cut(&params(), &picks(Some((50.0, 30.0)), Some((30.0, 50.0)))).unwrap();
+    let (on, off) = span(&path, false, ContourRole::Inner);
+    assert!(at(path.moves[on].to, 49.25, 30.0, 0.02), "{:?}", path.moves[on].to);
+    let pierce = path.moves[on].from;
+    assert!((pierce.x - 30.0).hypot(pierce.y - 30.0) < 19.25 - 1.0, "the pierce is in the slug: {pierce:?}");
+    assert!(at(path.moves[off].from, 30.0, 49.25, 0.02), "the lead-out leaves at the exit pick: {:?}", path.moves[off].from);
+    let off_at = path.moves[off].to;
+    assert!((off_at.x - 30.0).hypot(off_at.y - 30.0) < 19.25 - 1.0, "the torch goes off in the slug: {off_at:?}");
+}
+
+/// The Ø10 hole takes the small-hole rule: the pierce at its centre, no
+/// lead-out, and the overburn before the torch goes off.
+#[test]
+fn a_small_hole_keeps_its_rule_and_its_overburn() {
+    let start = cut(&params(), &picks(Some((80.0, 30.0)), None)).unwrap();
+    let (on, off) = span(&start, true, ContourRole::Inner);
+    assert!(at(start.moves[on].from, 75.0, 30.0, 0.01), "the pierce stays at the centre: {:?}", start.moves[on].from);
+    assert!(at(start.moves[on].to, 79.25, 30.0, 0.02), "{:?}", start.moves[on].to);
+    let end = start.moves[off].to;
+    assert!(end.y > 30.5 && (end.x - 75.0).hypot(end.y - 30.0) < 4.3, "the 2 mm overburn runs on past the start: {end:?}");
+    // The exit a quarter turn on is past the overburn: the torch goes off there.
+    let exit = cut(&params(), &picks(Some((80.0, 30.0)), Some((75.0, 35.0)))).unwrap();
+    let (_, off) = span(&exit, true, ContourRole::Inner);
+    assert!(at(exit.moves[off].to, 75.0, 34.25, 0.02), "{:?}", exit.moves[off].to);
+    assert!(exit.notes.iter().any(|n| n.contains("with no lead-out")), "{:?}", exit.notes);
+    // An exit inside the overburn is refused by name.
+    let near = (75.0 + 5.0 * 0.2f64.cos(), 30.0 + 5.0 * 0.2f64.sin());
+    let why = cut(&params(), &picks(Some((80.0, 30.0)), Some(near))).unwrap_err();
+    assert!(why.contains("exit point") && why.contains("inside its 2.000 mm overburn"), "{why}");
+}
+
+/// A small U-shaped hole: its centre is in the base, and the straight
+/// lead-in from the centre to the inner wall of an arm crosses the tongue
+/// of the part between the arms.
+#[test]
+fn a_small_hole_lead_in_that_would_cross_the_part_is_refused_by_name() {
+    let p = |x: f64, y: f64| Point2::new(x, y);
+    let u = Loop::new(vec![p(0.0, 0.0), p(20.0, 0.0), p(20.0, 14.0), p(16.0, 14.0), p(16.0, 8.0), p(4.0, 8.0), p(4.0, 14.0), p(0.0, 14.0)]).unwrap();
+    let loops = vec![rect(-20.0, -20.0, 40.0, 34.0), u];
+    let part = Region::new(loops.clone()).unwrap();
+    let cut = |k: &PathPicks| plasma_profile_picked(&loops, &[], &part, &params(), k).map_err(|e| e.to_string());
+    assert!(cut(&PathPicks::default()).is_ok(), "the hole is cut without a pick");
+    // The base wall is in sight of the centre: the pick is held.
+    assert!(cut(&picks(Some((10.0, 0.0)), None)).is_ok(), "a pick with a clear lead-in");
+    // The inner wall of the left arm is behind the tongue.
+    let why = cut(&picks(Some((4.0, 13.0)), None)).unwrap_err();
+    assert!(why.contains("start point (4.000, 13.000)") && why.contains("would cross the part"), "{why}");
+}
+
+#[test]
+fn a_pick_that_no_law_can_hold_is_refused_by_name() {
+    // Far from each closed profile.
+    let why = cut(&params(), &picks(Some((50.0, -10.0)), None)).unwrap_err();
+    assert!(why.contains("plasma profile: start point (50.000, -10.000) is 10.000 mm from the nearest closed profile"), "{why}");
+    assert!(why.contains("farther than the 2.250 mm"), "{why}");
+    let why = cut(&params(), &picks(None, Some((50.0, -10.0)))).unwrap_err();
+    assert!(why.contains("exit point (50.000, -10.000)"), "{why}");
+    // More than one pick of a role, and a pick that is not a number.
+    let mut two = picks(Some((50.0, 0.0)), None);
+    two.start.push(PathPick::xy(Point2::new(40.0, 0.0)));
+    assert!(cut(&params(), &two).unwrap_err().contains("only one start point"));
+    assert!(cut(&params(), &picks(Some((f64::NAN, 0.0)), None)).unwrap_err().contains("finite"));
+    // An open run takes no pick.
+    let run = vec![Point2::new(0.0, 0.0), Point2::new(20.0, 0.0)];
+    let e = plasma_profile_picked(&[], &[run], &Region::empty(), &params(), &picks(Some((10.0, 0.0)), None)).unwrap_err().to_string();
+    assert!(e.contains("start point (10.000, 0.000)") && e.contains("closed contour only"), "{e}");
+}
+
+#[test]
+fn control_compensation_holds_the_start_pick_and_refuses_the_exit_pick() {
+    let p = PlasmaParams { control_comp: true, lead_in: 2.0, lead_out: 2.0, ..params() };
+    let path = cut(&p, &picks(Some((50.0, 0.0)), None)).unwrap();
+    let (on, off) = span(&path, false, ContourRole::Outer);
+    assert!(at(path.moves[on].to, 50.0, -0.75, 1e-6), "{:?}", path.moves[on].to);
+    let comp = path.comps.iter().find(|c| c.first == on && c.last == off).expect("the outline's G41/G42 span");
+    assert!(comp.is_sane(&path.moves));
+    assert!(at(comp.programmed[0].to, 50.0, 0.0, 1e-6), "the programmed contour starts at the pick: {:?}", comp.programmed[0].to);
+    let why = cut(&p, &picks(None, Some((40.0, 0.0)))).unwrap_err();
+    assert!(why.contains("exit point (40.000, 0.000)") && why.contains(EXIT_WITH_CONTROL_COMP), "{why}");
+}
+
+#[test]
+fn the_run_on_follows_the_walk_and_never_adds_a_lap() {
+    let p = |x: f64, y: f64| Point2::new(x, y);
+    let walk = [p(5.0, 0.0), p(10.0, 0.0), p(10.0, 10.0), p(0.0, 10.0), p(0.0, 0.0), p(5.0, 0.0)];
+    assert!(run_on(&walk, p(5.0, 0.0)).is_empty(), "the exit at the start");
+    assert_eq!(run_on(&walk, p(8.0, 0.0)), vec![p(8.0, 0.0)]);
+    assert_eq!(run_on(&walk, p(10.0, 0.0)), vec![p(10.0, 0.0)]);
+    assert_eq!(run_on(&walk, p(10.0, 4.0)), vec![p(10.0, 0.0), p(10.0, 4.0)]);
+    assert_eq!(run_on(&walk, p(2.0, 0.0)), vec![p(10.0, 0.0), p(10.0, 10.0), p(0.0, 10.0), p(0.0, 0.0), p(2.0, 0.0)]);
+    assert!(run_on(&[], p(1.0, 1.0)).is_empty() && run_on(&[p(0.0, 0.0)], p(1.0, 1.0)).is_empty());
+}
diff --git a/docs/decisions/3334-plasma-start-exit.md b/docs/decisions/3334-plasma-start-exit.md
new file mode 100644
index 000000000..df3b1ddde
--- /dev/null
+++ b/docs/decisions/3334-plasma-start-exit.md
@@ -0,0 +1,75 @@
+## #3334 - Plasma Profile takes a start pick and an exit pick
+
+**What was decided**
+
+- `KindInfo::pick()` answers `PickCapability::Ring` for `OpType::PlasmaProfile`.
+  The picks are the operation-level `picks` of #3339 (`PlasmaOp.picks`). No new
+  field, command or MCP tool was added.
+- The generator has one new door, `camcraft_motion::plasma::plasma_profile_picked`.
+  `plasma_profile` calls it with no pick, so a cut without a pick is the same
+  path, move for move.
+- A pick goes to the closed contour whose part profile is nearest to it. Each
+  other contour keeps its automatic seam.
+- Start pick: the cut of that contour starts at the projection of the pick on
+  the kerf ring. The lead-in lands there. The pierce is where the lead-in
+  starts, in the scrap.
+- Exit pick: the torch cuts the full contour, then cuts on past its start to
+  the projection of the exit pick. The lead-out leaves there and the torch
+  goes off at its end. The cut direction does not change.
+- Small-hole rule: the pierce stays at the centre and there is no lead-out.
+  A start pick sets where the straight lead-in meets the hole. An exit pick
+  sets where the torch goes off, and it must be at or past the overburn.
+- Refused by name (the text names the role and the point of the pick), never
+  moved:
+  - a pick farther than 1.5 kerf widths from each closed profile
+    (`PICK_REACH_KERFS`; the 2D contour uses 1.5 tool diameters);
+  - a pick when the operation has open runs only;
+  - a lead-in or a lead-out that finds no room beside the part at the pick
+    (the pierce or the torch off would be on the part);
+  - a small-hole lead-in from the centre that would cross the part;
+  - a small-hole exit pick inside the overburn;
+  - an exit pick with control compensation (G41/G42). The command door
+    (`PlasmaOp::pick_refusal`) and the generator say the same words.
+- The kerf law and the cover law of `plasma::emit::cut` still judge the
+  complete path. The new guards only give the refusal the name of the pick.
+
+**Why**
+
+- The issue asks for the pierce at the lead-in start that lands on the
+  projection of the start pick, and for the lead-out and the torch off at the
+  projection of the exit pick. It asks that the laws refuse a pick and never
+  move it.
+- The run past the start is the only way to end the cut at a different place
+  and still cut the full contour. The stretch between the start and the exit
+  is cut two times. The note of the path says its length.
+- Under G41/G42 the control offsets the programmed contour, and that contour
+  ends at its start. A run past the start needs a longer programmed contour
+  and a new proof of the compensation span. A mutation check showed that the
+  generator would emit a path without that proof, so the pair is refused.
+
+**Considered and dropped**
+
+- End the cut at the exit pick without the full lap (an open cut). Dropped:
+  the part would stay attached.
+- Move a pick that has no lead room to the nearest place with room. Dropped:
+  the issue says "refused by name, never moved".
+- Change the cut direction so that the exit is reached sooner. Dropped: the
+  direction sets the good side of the kerf.
+- An exit pick with control compensation. Dropped for this PR (see "Why").
+- The waterjet slice. `WaterjetProfile` is on `main` now, with its own
+  planner and its tabs (`crates/motion/src/waterjet/`). Its capability stays
+  `NotTaken(PICK_OWED)`: a pick on a waterjet operation is still refused by
+  name. The follow-up issue for that slice is named in the PR body.
+- A new top-level test binary for the plasma pins. Dropped: the pins are the
+  submodule `crates/app/tests/start_exit_shared/plasma.rs` of the existing
+  `start_exit_shared` suite (**New tests join a directory suite**). The MCP
+  pin is in the existing `mcp_plasma.rs`.
+
+**Cost to change later**
+
+- The reach (`PICK_REACH_KERFS`) is one constant.
+- To permit an exit pick with G41/G42: extend the programmed contour in
+  `plan_closed`, remove the two refusals (generator and command door) and
+  add the pins for the compensation span.
+- The golden `crates/app/tests/golden/plasma_start_exit_picks.cl` pins the
+  picked path. A change of the run past the start moves that one file.
