@@ -0,0 +1,325 @@
+//! The Windows transport of the UI link (#3874): a named pipe with a
+//! security descriptor that admits the window's own user only
+//! (`link_pipe_acl`), so the kernel - not a token on the wire - decides
+//! who the peer is. The pipe name carries the window's process id, and
+//! the CLI asks the kernel which process serves the pipe before it
+//! sends the token: a TCP port cannot be verified this way, because a
+//! peer that never read the discovery file still receives the token
+//! and can answer anything.
+//!
+//! Every wait is bounded and every handle is closed on its owner's
+//! drop, never by a panic. The byte stream itself is `link_pipe_stream`.
+//!
+//! Provenance: our own FFI over the platform's published named-pipe
+//! API (Microsoft Learn: CreateNamedPipeW, ConnectNamedPipe,
+//! GetNamedPipeServerProcessId). Clean-room, public sources only.
+
+#![allow(clippy::undocumented_unsafe_blocks)] // every block names its API below
+
+use std::ffi::OsStr;
+use std::io;
+use std::os::windows::ffi::OsStrExt;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc::{self, Receiver, TryRecvError};
+use std::sync::{Arc, Mutex};
+
+use windows_sys::Win32::Foundation::{
+    CloseHandle, ERROR_IO_PENDING, ERROR_PIPE_BUSY, ERROR_PIPE_CONNECTED, GENERIC_READ,
+    GENERIC_WRITE, GetLastError, HANDLE, INVALID_HANDLE_VALUE, WAIT_TIMEOUT,
+};
+use windows_sys::Win32::Storage::FileSystem::{CreateFileW, FILE_FLAG_OVERLAPPED, OPEN_EXISTING};
+use windows_sys::Win32::System::IO::{CancelIoEx, GetOverlappedResultEx, OVERLAPPED};
+use windows_sys::Win32::System::Pipes::{ConnectNamedPipe, GetNamedPipeServerProcessId};
+
+use super::link_pipe_acl::{SecurityDescriptor, create_instance};
+// The stream type is this transport's public face: `wire` and the
+// tests name it through this module.
+pub use super::link_pipe_stream::PipeStream;
+use super::link_pipe_stream::OpEvent;
+
+/// How long one slice of the connect wait runs before the stop flag is
+/// looked at again: the bound on how long dropping the listener takes.
+const WAIT_SLICE: u32 = 50;
+
+/// The pipe name of the window with this process id: the discovery
+/// file's `address` field on Windows. Derived from the pid, so the CLI
+/// can refuse a file whose pipe name belongs to another pid.
+#[must_use]
+pub fn pipe_name(pid: u32) -> String {
+    format!(r"\\.\pipe\camcraft-ui-link-{pid}")
+}
+
+fn wide(text: &str) -> Vec<u16> {
+    OsStr::new(text).encode_wide().chain([0]).collect()
+}
+
+pub(super) fn close(handle: HANDLE) {
+    // Safety: the caller owns the handle; no other thread uses it.
+    unsafe {
+        if !handle.is_null() && handle != INVALID_HANDLE_VALUE {
+            CloseHandle(handle);
+        }
+    }
+}
+
+/// A raw pipe handle on its way between threads: the creator thread,
+/// the accept channel, the CLI's bridge threads. One owner at a time,
+/// so the move is sound even though a raw pointer is not `Send` alone.
+#[derive(Clone, Copy)]
+struct RawHandle(HANDLE);
+// Safety: a kernel handle is thread-agnostic; each move hands the only
+// user of this end of the pipe to the next thread.
+unsafe impl Send for RawHandle {}
+
+enum Connect {
+    /// A client took the instance.
+    Arrived,
+    /// The listener is gone: end without a client.
+    Cancelled,
+    /// The OS refused the wait; the caller makes a fresh instance.
+    Failed,
+}
+
+/// Wait for a client in short slices, so the stop flag is seen even
+/// while the wait is pending, and a cancel settles it at once.
+///
+/// # Safety
+/// `handle` is a listening pipe instance that no other thread uses.
+/// Wait for a client in short slices, so the stop flag is seen even
+/// while the wait is pending, and a cancel settles it at once.
+///
+/// # Errors
+/// The operation's event could not be made.
+///
+/// # Safety
+/// `handle` is a listening pipe instance that no other thread uses.
+unsafe fn wait_connect(handle: HANDLE, stop: &AtomicBool) -> std::io::Result<Connect> {
+    // The connect waits on its own event, like every other operation:
+    // a handle wait could see a stale signal of the instance object.
+    let event = OpEvent::new()?;
+    let mut overlapped: OVERLAPPED = unsafe { std::mem::zeroed() };
+    overlapped.hEvent = event.handle();
+    if unsafe { ConnectNamedPipe(handle, &mut overlapped) } != 0 {
+        return Ok(Connect::Arrived);
+    }
+    let pending = unsafe { GetLastError() };
+    if pending == ERROR_PIPE_CONNECTED {
+        return Ok(Connect::Arrived);
+    }
+    if pending != ERROR_IO_PENDING {
+        return Ok(Connect::Failed);
+    }
+    loop {
+        let mut taken = 0_u32;
+        if unsafe { GetOverlappedResultEx(handle, &overlapped, &mut taken, WAIT_SLICE, 0) } != 0 {
+            return Ok(Connect::Arrived);
+        }
+        let err = unsafe { GetLastError() };
+        if err == WAIT_TIMEOUT {
+            if stop.load(Ordering::Acquire) {
+                unsafe { CancelIoEx(handle, std::ptr::null()) };
+                return Ok(Connect::Cancelled);
+            }
+            continue;
+        }
+        // A client that connected and left before the wait: retry.
+        return Ok(Connect::Failed);
+    }
+}
+
+struct ListenerState {
+    stop: AtomicBool,
+    /// The instance whose connect wait is pending (or was just made):
+    /// Drop cancels it, and the thread closes it when it sees `stop`.
+    pending: Mutex<Option<RawHandle>>,
+}
+
+/// The window's end of the pipe: a thread that keeps one instance
+/// waiting for the next client, and hands each connected instance to
+/// [`accept`](Self::accept), which never blocks.
+pub struct PipeListener {
+    connected: Receiver<io::Result<PipeStream>>,
+    state: Arc<ListenerState>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+
+impl PipeListener {
+    /// Serve the pipe `name` (fail fast: the first instance exists, or
+    /// the name is taken and the error says so).
+    ///
+    /// # Errors
+    /// The security descriptor or the pipe creation failed.
+    pub fn new(name: &str) -> io::Result<Self> {
+        let wide = wide(name);
+        let state = Arc::new(ListenerState {
+            stop: AtomicBool::new(false),
+            pending: Mutex::new(None),
+        });
+        // The first instance exists before the link is said to be up:
+        // a taken name (a squatter) is an error now. The kernel copies
+        // the descriptor into the pipe, so it is freed right after.
+        let first = {
+            let sd = SecurityDescriptor::user_only()?;
+            create_instance(&wide, sd.attributes(), true)?
+        };
+        *state.pending.lock().expect("the listener lock") = Some(RawHandle(first));
+        // The thread's own copy: a raw handle crosses as `RawHandle`.
+        let first = RawHandle(first);
+        let (tx, connected) = mpsc::channel();
+        let worker = Arc::clone(&state);
+        let thread = std::thread::Builder::new()
+            .name("camcraft-ui-link-pipe".into())
+            .spawn(move || {
+                // Each later instance gets its own descriptor: one
+                // built here, never a captured pointer.
+                let sd = match SecurityDescriptor::user_only() {
+                    Ok(sd) => sd,
+                    Err(e) => {
+                        let _ = tx.send(Err(e));
+                        return;
+                    }
+                };
+                // The whole `RawHandle` crosses (a bare field capture
+                // would move the raw pointer itself, which is not Send).
+                let mut handle = first;
+                loop {
+                    if worker.stop.load(Ordering::Acquire) {
+                        close(handle.0);
+                        break;
+                    }
+                    let connect = match unsafe { wait_connect(handle.0, &worker.stop) } {
+                        Ok(c) => c,
+                        Err(e) => {
+                            close(handle.0);
+                            let _ = tx.send(Err(e));
+                            break;
+                        }
+                    };
+                    match connect {
+                        Connect::Arrived => {
+                            *worker.pending.lock().expect("the listener lock") = None;
+                            if worker.stop.load(Ordering::Acquire) {
+                                close(handle.0);
+                                break;
+                            }
+                            // The stream owns the instance from here:
+                            // the receiver drops it, or this send does
+                            // - a connected instance is never left open,
+                            // or the pipe's name could never free.
+                            if tx.send(Ok(PipeStream::from_handle(handle.0))).is_err() {
+                                break;
+                            }
+                        }
+                        Connect::Cancelled => {
+                            close(handle.0);
+                            break;
+                        }
+                        Connect::Failed => {
+                            close(handle.0);
+                            if worker.stop.load(Ordering::Acquire) {
+                                break;
+                            }
+                        }
+                    }
+                    // The next instance, so the next client connects
+                    // while this one is still served (the backlog).
+                    handle = match create_instance(&wide, sd.attributes(), false) {
+                        Ok(h) => RawHandle(h),
+                        Err(e) => {
+                            let _ = tx.send(Err(e));
+                            break;
+                        }
+                    };
+                    *worker.pending.lock().expect("the listener lock") = Some(handle);
+                }
+            })?;
+        Ok(Self {
+            connected,
+            state,
+            thread: Some(thread),
+        })
+    }
+
+    /// Take the next connected client, never blocking.
+    ///
+    /// # Errors
+    /// `WouldBlock` while no client waits; the creation error, once,
+    /// when the pipe could not make its next instance.
+    pub fn accept(&self) -> io::Result<(PipeStream, String)> {
+        match self.connected.try_recv() {
+            Ok(Ok(stream)) => Ok((stream, "named pipe".to_owned())),
+            Ok(Err(e)) => Err(e),
+            // The creator thread ended (its error was delivered once):
+            // report an empty listener, not a new error on every poll.
+            Err(TryRecvError::Empty) | Err(TryRecvError::Disconnected) => Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                "no pipe client waits",
+            )),
+        }
+    }
+
+    /// The accept loop polls; the pipe wait is sliced by itself.
+    pub fn set_nonblocking(&self, _on: bool) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Drop for PipeListener {
+    fn drop(&mut self) {
+        self.state.stop.store(true, Ordering::Release);
+        // Wake the thread out of a pending connect wait; a thread that
+        // has not started its wait sees `stop` at its next slice.
+        let pending = self.state.pending.lock().expect("the listener lock").take();
+        if let Some(handle) = pending {
+            unsafe { CancelIoEx(handle.0, std::ptr::null()) };
+        }
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+/// Open the client end of the pipe `name`.
+///
+/// # Errors
+/// `TimedOut` when every instance is busy (the window's one session is
+/// taken); the OS error otherwise.
+pub fn connect(name: &str) -> io::Result<PipeStream> {
+    let wide = wide(name);
+    let handle = unsafe {
+        CreateFileW(
+            wide.as_ptr(),
+            GENERIC_READ | GENERIC_WRITE,
+            0,
+            std::ptr::null(),
+            OPEN_EXISTING,
+            FILE_FLAG_OVERLAPPED,
+            std::ptr::null_mut(),
+        )
+    };
+    if handle == INVALID_HANDLE_VALUE {
+        let why = unsafe { GetLastError() };
+        if why == ERROR_PIPE_BUSY {
+            return Err(io::Error::new(
+                io::ErrorKind::TimedOut,
+                "the window's link is busy: another client holds the session",
+            ));
+        }
+        return Err(io::Error::from_raw_os_error(why as i32));
+    }
+    Ok(PipeStream::from_handle(handle))
+}
+
+/// The process id of the pipe's server side, as the kernel reports it.
+/// The CLI's proof that the peer is the process the link file names
+/// (#3874): it runs before one byte of the token crosses.
+///
+/// # Errors
+/// The kernel could not say (the handle is not a pipe).
+pub fn server_pid(stream: &PipeStream) -> io::Result<u32> {
+    let mut pid = 0_u32;
+    if unsafe { GetNamedPipeServerProcessId(stream.handle(), &mut pid) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(pid)
+}
diff --git a/crates/app/src/mcp/link_pipe_acl.rs b/crates/app/src/mcp/link_pipe_acl.rs
new file mode 100644
index 000000000..34abfc674
--- /dev/null
+++ b/crates/app/src/mcp/link_pipe_acl.rs
@@ -0,0 +1,157 @@
+//! The gate of the UI link's Windows pipe (#3874): the security
+//! descriptor that admits the window's own user only, and the pipe
+//! instance creation that carries it. The kernel - not a token on the
+//! wire - refuses another local user the pipe open, before our code
+//! runs.
+//!
+//! Provenance: our own FFI over the platform's published security API
+//! (Microsoft Learn: ConvertStringSecurityDescriptorToSecurityDescriptorW,
+//! GetTokenInformation, CreateNamedPipeW). Clean-room, public sources
+//! only.
+
+#![allow(clippy::undocumented_unsafe_blocks)] // every block names its API below
+
+use std::ffi::OsStr;
+use std::io;
+use std::os::windows::ffi::OsStrExt;
+
+use windows_sys::Win32::Foundation::{CloseHandle, HANDLE, INVALID_HANDLE_VALUE, LocalFree};
+use windows_sys::Win32::Security::Authorization::{
+    ConvertSidToStringSidW, ConvertStringSecurityDescriptorToSecurityDescriptorW, SDDL_REVISION_1,
+};
+use windows_sys::Win32::Security::{
+    GetTokenInformation, PSECURITY_DESCRIPTOR, PSID, SECURITY_ATTRIBUTES, TOKEN_QUERY, TOKEN_USER,
+    TokenUser,
+};
+use windows_sys::Win32::Storage::FileSystem::{
+    FILE_FLAG_FIRST_PIPE_INSTANCE, FILE_FLAG_OVERLAPPED,
+};
+use windows_sys::Win32::System::Pipes::{
+    CreateNamedPipeW, PIPE_READMODE_BYTE, PIPE_TYPE_BYTE, PIPE_UNLIMITED_INSTANCES, PIPE_WAIT,
+};
+use windows_sys::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+
+/// One read or write buffer of a pipe instance.
+const PIPE_BUF: u32 = 64 * 1024;
+
+/// The SDDL descriptor string `D:P(A;;GA;;;<user SID>)`: access granted
+/// to the current user and to nobody else.
+fn user_only_sddl() -> io::Result<String> {
+    unsafe {
+        let mut token: HANDLE = std::ptr::null_mut();
+        if OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let mut len = 0_u32;
+        let _ = GetTokenInformation(token, TokenUser, std::ptr::null_mut(), 0, &mut len);
+        let mut buf = vec![0_u8; len.max(4) as usize];
+        let said = GetTokenInformation(token, TokenUser, buf.as_mut_ptr().cast(), len, &mut len);
+        CloseHandle(token);
+        if said == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let user = buf.as_ptr().cast::<TOKEN_USER>();
+        let sid: PSID = (*user).User.Sid;
+        let mut text = std::ptr::null_mut();
+        if ConvertSidToStringSidW(sid, &mut text) == 0 || text.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        let mut utf16 = Vec::new();
+        let mut i = 0_usize;
+        while *text.add(i) != 0 {
+            utf16.push(*text.add(i));
+            i += 1;
+        }
+        LocalFree(text.cast());
+        let sid = String::from_utf16(&utf16)
+            .map_err(|_| io::Error::other("the user SID is not UTF-16"))?;
+        Ok(format!("D:P(A;;GA;;;{sid})"))
+    }
+}
+
+/// A pipe security descriptor that admits the current user only. The
+/// kernel copies it into each instance, so it is freed after the last
+/// `CreateNamedPipeW` that borrowed it (the listener's own lifetime).
+pub(super) struct SecurityDescriptor(SECURITY_ATTRIBUTES);
+
+impl SecurityDescriptor {
+    /// The `D:P(A;;GA;;;<user SID>)` descriptor of this process's user.
+    ///
+    /// # Errors
+    /// The token or the descriptor conversion failed.
+    pub(super) fn user_only() -> io::Result<Self> {
+        let wide = OsStr::new(&user_only_sddl()?)
+            .encode_wide()
+            .chain([0])
+            .collect::<Vec<_>>();
+        let mut sd: PSECURITY_DESCRIPTOR = std::ptr::null_mut();
+        let made = unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                wide.as_ptr(),
+                SDDL_REVISION_1,
+                &mut sd,
+                std::ptr::null_mut(),
+            )
+        };
+        if made == 0 || sd.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        let attributes = SECURITY_ATTRIBUTES {
+            nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: sd.cast(),
+            bInheritHandle: 0,
+        };
+        Ok(Self(attributes))
+    }
+
+    /// The raw attributes each `CreateNamedPipeW` call borrows.
+    pub(super) fn attributes(&self) -> &SECURITY_ATTRIBUTES {
+        &self.0
+    }
+}
+
+impl Drop for SecurityDescriptor {
+    fn drop(&mut self) {
+        unsafe { LocalFree(self.0.lpSecurityDescriptor.cast()) };
+    }
+}
+
+/// One pipe instance waiting for a client. `first` adds the
+/// anti-hijack flag: the name must be free, or the window's link fails
+/// to open (a squatter cannot shadow a real window).
+///
+/// # Errors
+/// The pipe creation failed (the name is taken, or the OS refused).
+pub(super) fn create_instance(
+    name: &[u16],
+    sd: &SECURITY_ATTRIBUTES,
+    first: bool,
+) -> io::Result<HANDLE> {
+    let mode = windows_sys::Win32::Storage::FileSystem::PIPE_ACCESS_DUPLEX
+        | FILE_FLAG_OVERLAPPED
+        | if first {
+            FILE_FLAG_FIRST_PIPE_INSTANCE
+        } else {
+            0
+        };
+    let kind = PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT;
+    // FILE_FLAG_OVERLAPPED: every wait on this handle carries its own
+    // deadline (the synchronous pipe API has none).
+    let handle = unsafe {
+        CreateNamedPipeW(
+            name.as_ptr(),
+            mode,
+            kind,
+            PIPE_UNLIMITED_INSTANCES,
+            PIPE_BUF,
+            PIPE_BUF,
+            0,
+            sd,
+        )
+    };
+    if handle == INVALID_HANDLE_VALUE {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(handle)
+    }
+}
diff --git a/crates/app/src/mcp/link_pipe_stream.rs b/crates/app/src/mcp/link_pipe_stream.rs
new file mode 100644
index 000000000..53be56376
--- /dev/null
+++ b/crates/app/src/mcp/link_pipe_stream.rs
@@ -0,0 +1,257 @@
+//! The byte stream of the UI link's Windows pipe (#3874): one
+//! connected end, read and written through overlapped I/O so every
+//! wait carries its own deadline - the synchronous pipe API has none,
+//! and the idle law of `listen.rs` and the hello deadline need one.
+//! Read and write deadlines are shared by every clone of one pipe, as
+//! a socket option is.
+//!
+//! Provenance: our own FFI over the platform's published pipe API
+//! (Microsoft Learn: ReadFile, WriteFile, GetOverlappedResultEx,
+//! CancelIoEx). Clean-room, public sources only.
+
+#![allow(clippy::undocumented_unsafe_blocks)] // every block names its API below
+
+use std::io;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use windows_sys::Win32::Foundation::{
+    DUPLICATE_SAME_ACCESS, DuplicateHandle, ERROR_BROKEN_PIPE, ERROR_IO_PENDING,
+    ERROR_NO_DATA, ERROR_OPERATION_ABORTED, GetLastError, HANDLE, INVALID_HANDLE_VALUE,
+    WAIT_TIMEOUT,
+};
+use windows_sys::Win32::Storage::FileSystem::{ReadFile, WriteFile};
+use windows_sys::Win32::System::IO::{CancelIoEx, GetOverlappedResultEx, OVERLAPPED};
+use windows_sys::Win32::System::Threading::{CreateEventW, GetCurrentProcess};
+
+use super::link_pipe::close;
+
+/// The event of one overlapped operation: each op waits on its own
+/// event, never on the pipe handle - completions signal the shared
+/// instance object, so a handle wait cannot tell one completion from
+/// another (the server's connect, this side's earlier write).
+pub(super) struct OpEvent(HANDLE);
+
+impl OpEvent {
+    /// A fresh unnamed auto-reset event.
+    ///
+    /// # Errors
+    /// The OS could not make the event.
+    pub(super) fn new() -> std::io::Result<Self> {
+        let made = unsafe { CreateEventW(std::ptr::null(), 0, 0, std::ptr::null()) };
+        if made.is_null() || made == INVALID_HANDLE_VALUE {
+            return Err(std::io::Error::last_os_error());
+        }
+        Ok(Self(made))
+    }
+
+    /// The raw event handle, set into an operation's OVERLAPPED.
+    pub(super) fn handle(&self) -> HANDLE {
+        self.0
+    }
+}
+
+impl Drop for OpEvent {
+    fn drop(&mut self) {
+        close(self.0);
+    }
+}
+
+/// Read and write deadlines, shared by every clone of one pipe.
+#[derive(Default)]
+struct StreamLimits(Mutex<(Option<Duration>, Option<Duration>)>);
+
+/// One connected end of a pipe: the window's accepted client, or the
+/// CLI's connection to the window.
+pub struct PipeStream {
+    handle: HANDLE,
+    limits: Arc<StreamLimits>,
+}
+
+impl PipeStream {
+    pub(super) fn from_handle(handle: HANDLE) -> Self {
+        Self {
+            handle,
+            limits: Arc::new(StreamLimits(Mutex::new((None, None)))),
+        }
+    }
+
+    /// The raw handle, for the kernel's own queries about this pipe.
+    pub(super) fn handle(&self) -> HANDLE {
+        self.handle
+    }
+
+    fn ms(limits: &StreamLimits, write: bool) -> u32 {
+        let guard = limits.0.lock().expect("the stream lock");
+        let set = if write { guard.1 } else { guard.0 };
+        // None: wait for ever, as a socket with no timeout does.
+        set.map_or(u32::MAX, |d| d.as_millis().min(u32::MAX as u128) as u32)
+    }
+
+    /// # Errors
+    /// A zero duration, like a socket timeout of zero.
+    pub fn set_read_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        if t.is_some_and(|d| d.is_zero()) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "a pipe read timeout cannot be zero",
+            ));
+        }
+        self.limits.0.lock().expect("the stream lock").0 = t;
+        Ok(())
+    }
+
+    /// # Errors
+    /// A zero duration, like a socket timeout of zero.
+    pub fn set_write_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        if t.is_some_and(|d| d.is_zero()) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "a pipe write timeout cannot be zero",
+            ));
+        }
+        self.limits.0.lock().expect("the stream lock").1 = t;
+        Ok(())
+    }
+
+    /// The pipe API has no non-blocking mode that our callers need:
+    /// every wait already runs under a deadline.
+    pub fn set_nonblocking(&self, _on: bool) -> io::Result<()> {
+        Ok(())
+    }
+
+    /// A second handle on the same pipe (one reads, one writes).
+    ///
+    /// # Errors
+    /// The OS could not duplicate the handle.
+    pub fn try_clone(&self) -> io::Result<Self> {
+        let mut twin: HANDLE = std::ptr::null_mut();
+        let made = unsafe {
+            DuplicateHandle(
+                GetCurrentProcess(),
+                self.handle,
+                GetCurrentProcess(),
+                &mut twin,
+                0,
+                0,
+                DUPLICATE_SAME_ACCESS,
+            )
+        };
+        if made == 0 || twin.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self {
+            handle: twin,
+            limits: Arc::clone(&self.limits),
+        })
+    }
+
+    /// A pipe cannot close one direction only. The caller's session
+    /// still ends cleanly: the idle drop on the window's side, or the
+    /// broken pipe when this process exits, closes it.
+    pub fn shutdown_write(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    /// One overlapped read under a deadline.
+    fn read_into(&self, buf: &mut [u8]) -> io::Result<usize> {
+        // Safety: the buffer is valid and only this call uses it.
+        unsafe { self.io(false, buf.as_mut_ptr(), buf.len()) }
+    }
+
+    /// One overlapped write under a deadline. The pointer is cast mut
+    /// for the shared core only; the OS reads from it, never writes.
+    fn write_from(&self, buf: &[u8]) -> io::Result<usize> {
+        // Safety: the buffer is valid for the length, and the OS only
+        // reads through it on the write path.
+        unsafe { self.io(true, buf.as_ptr() as *mut u8, buf.len()) }
+    }
+
+    /// One overlapped file operation under a deadline in milliseconds:
+    /// on timeout the operation is cancelled and reaped, so the handle
+    /// never keeps a pending operation past the caller's bounds.
+    ///
+    /// # Safety
+    /// `buf` is valid for `len` bytes; only this call uses the handle.
+    unsafe fn io(&self, write: bool, buf: *mut u8, len: usize) -> io::Result<usize> {
+        // Each operation carries its own event: the wait below must
+        // see THIS operation's completion, not the instance's last one.
+        let event = OpEvent::new()?;
+        let mut overlapped: OVERLAPPED = unsafe { std::mem::zeroed() };
+        overlapped.hEvent = event.handle();
+        let mut moved = 0_u32;
+        let said = unsafe {
+            if write {
+                WriteFile(self.handle, buf, len as u32, &mut moved, &mut overlapped)
+            } else {
+                ReadFile(self.handle, buf, len as u32, &mut moved, &mut overlapped)
+            }
+        };
+        if said != 0 {
+            return Ok(moved as usize);
+        }
+        let pending = unsafe { GetLastError() };
+        if pending != ERROR_IO_PENDING {
+            return self.finished(write, pending);
+        }
+        let wait = Self::ms(&self.limits, write);
+        if unsafe { GetOverlappedResultEx(self.handle, &overlapped, &mut moved, wait, 0) } != 0 {
+            return Ok(moved as usize);
+        }
+        let why = unsafe { GetLastError() };
+        if why == WAIT_TIMEOUT {
+            unsafe { CancelIoEx(self.handle, std::ptr::null()) };
+            // Reap the settled operation: data that raced the deadline
+            // still counts, a true timeout does not.
+            if unsafe { GetOverlappedResultEx(self.handle, &overlapped, &mut moved, u32::MAX, 0) }
+                != 0
+            {
+                return Ok(moved as usize);
+            }
+            return self.finished(write, unsafe { GetLastError() });
+        }
+        self.finished(write, why)
+    }
+
+    /// The error (or the end of input) of a completed operation.
+    fn finished(&self, write: bool, code: u32) -> io::Result<usize> {
+        match code {
+            // Reading a pipe whose writer hung up is the end of input.
+            ERROR_BROKEN_PIPE | ERROR_NO_DATA if !write => Ok(0),
+            ERROR_OPERATION_ABORTED => Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                "the pipe operation timed out",
+            )),
+            _ => Err(io::Error::from_raw_os_error(code as i32)),
+        }
+    }
+}
+
+impl Drop for PipeStream {
+    fn drop(&mut self) {
+        close(self.handle);
+    }
+}
+
+impl std::io::Read for PipeStream {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        if buf.is_empty() {
+            return Ok(0);
+        }
+        self.read_into(buf)
+    }
+}
+
+impl std::io::Write for PipeStream {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.write_from(buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(()) // byte pipes hand each written buffer to the peer at once
+    }
+}
+
+// Safety: a kernel handle is thread-agnostic; a clone is a separate
+// handle of its own, used by one thread at a time.
+unsafe impl Send for PipeStream {}
