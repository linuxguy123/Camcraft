diff --git a/crates/geometry/src/dxf/biarc.rs b/crates/geometry/src/dxf/biarc.rs
new file mode 100644
index 000000000..f3c06a56a
--- /dev/null
+++ b/crates/geometry/src/dxf/biarc.rs
@@ -0,0 +1,158 @@
+//! The biarc between two points with given unit tangents, and the exact closest point on it.
+//! Provenance: our own implementation of the equal-tangent-length biarc (K. M. Bolton,
+//! "Biarc curves", Computer-Aided Design 7(2), 1975) and plane geometry of the circle.
+use super::types::Primitive;
+use crate::geo2d::Point2;
+use std::f64::consts::TAU;
+
+/// One output segment, as the DXF reader emits it.
+#[derive(Clone, Copy, Debug)]
+pub(super) enum Seg {
+    Line {
+        a: Point2,
+        b: Point2,
+    },
+    /// `sweep` is signed: counter-clockwise positive.
+    Arc {
+        c: Point2,
+        r: f64,
+        a0: f64,
+        sweep: f64,
+    },
+}
+
+impl Seg {
+    pub fn length(&self) -> f64 {
+        match *self {
+            Seg::Line { a, b } => (b.x - a.x).hypot(b.y - a.y),
+            Seg::Arc { r, sweep, .. } => r * sweep.abs(),
+        }
+    }
+
+    pub fn primitive(self) -> Primitive {
+        match self {
+            Seg::Line { a, b } => Primitive::Line { start: a, end: b },
+            Seg::Arc { c, r, a0, sweep } => Primitive::Arc {
+                center: c,
+                radius: r,
+                start_angle: a0,
+                sweep_angle: sweep,
+            },
+        }
+    }
+
+    /// The distance from `q` and the arc length from this segment's start to its closest point.
+    fn closest(&self, q: Point2) -> (f64, f64) {
+        match *self {
+            Seg::Line { a, b } => {
+                let (dx, dy) = (b.x - a.x, b.y - a.y);
+                let len2 = dx * dx + dy * dy;
+                let t = (((q.x - a.x) * dx + (q.y - a.y) * dy) / len2).clamp(0.0, 1.0);
+                let (x, y) = (a.x + dx * t, a.y + dy * t);
+                ((q.x - x).hypot(q.y - y), t * len2.sqrt())
+            }
+            Seg::Arc { c, r, a0, sweep } => {
+                let phi = (q.y - c.y).atan2(q.x - c.x);
+                let turned = if sweep >= 0.0 {
+                    (phi - a0).rem_euclid(TAU)
+                } else {
+                    (a0 - phi).rem_euclid(TAU)
+                };
+                if turned <= sweep.abs() {
+                    let rho = (q.x - c.x).hypot(q.y - c.y);
+                    return ((rho - r).abs(), r * turned);
+                }
+                let at = |angle: f64| Point2::new(c.x + r * angle.cos(), c.y + r * angle.sin());
+                let (s, e) = (at(a0), at(a0 + sweep));
+                let ds = (q.x - s.x).hypot(q.y - s.y);
+                let de = (q.x - e.x).hypot(q.y - e.y);
+                if ds <= de {
+                    (ds, 0.0)
+                } else {
+                    (de, self.length())
+                }
+            }
+        }
+    }
+}
+
+/// The distance from `q` to the chain `segs` and the arc length to its closest point.
+pub(super) fn closest(segs: &[Seg], q: Point2) -> (f64, f64) {
+    let mut best = (f64::INFINITY, 0.0);
+    let mut offset = 0.0;
+    for seg in segs {
+        let (d, s) = seg.closest(q);
+        if d < best.0 {
+            best = (d, offset + s);
+        }
+        offset += seg.length();
+    }
+    best
+}
+
+/// The arc from `p` with unit tangent `t` to `q`; a line when its radius passes `max_radius`.
+fn arc(p: Point2, t: (f64, f64), q: Point2, max_radius: f64) -> Option<Seg> {
+    let (vx, vy) = (q.x - p.x, q.y - p.y);
+    let len2 = vx * vx + vy * vy;
+    if len2.is_nan() || len2 <= 0.0 {
+        return None;
+    }
+    // The left normal n; the centre is p + n s with |centre - q| = |s|.
+    let (nx, ny) = (-t.1, t.0);
+    let nv = nx * vx + ny * vy;
+    if nv == 0.0 || len2 / (2.0 * nv.abs()) > max_radius {
+        return Some(Seg::Line { a: p, b: q });
+    }
+    let s = len2 / (2.0 * nv);
+    let c = Point2::new(p.x + nx * s, p.y + ny * s);
+    let sweep = 2.0 * nv.atan2(t.0 * vx + t.1 * vy);
+    let seg = Seg::Arc {
+        c,
+        r: s.abs(),
+        a0: (p.y - c.y).atan2(p.x - c.x),
+        sweep,
+    };
+    (seg.length().is_finite() && sweep != 0.0).then_some(seg)
+}
+
+/// The biarc from `p0` (tangent `t0`) to `p1` (tangent `t1`) with equal tangent lengths.
+/// Two lines that lie on one line become one line. `None` when no such biarc exists.
+pub(super) fn biarc(
+    p0: Point2,
+    t0: (f64, f64),
+    p1: Point2,
+    t1: (f64, f64),
+    max_radius: f64,
+) -> Option<Vec<Seg>> {
+    let (vx, vy) = (p1.x - p0.x, p1.y - p0.y);
+    let vv = vx * vx + vy * vy;
+    let (tx, ty) = (t0.0 + t1.0, t0.1 + t1.1);
+    let vt = vx * tx + vy * ty;
+    let denom = 2.0 * (1.0 - (t0.0 * t1.0 + t0.1 * t1.1));
+    let d = if denom.abs() < 1e-12 {
+        let v1 = vx * t1.0 + vy * t1.1;
+        if v1.is_nan() || v1 <= 0.0 {
+            return None;
+        }
+        vv / (4.0 * v1)
+    } else {
+        (-vt + (vt * vt + denom * vv).sqrt()) / denom
+    };
+    if !(d > 0.0 && d.is_finite()) {
+        return None;
+    }
+    let m1 = (p0.x + t0.0 * d, p0.y + t0.1 * d);
+    let m2 = (p1.x - t1.0 * d, p1.y - t1.1 * d);
+    let joint = Point2::new(0.5 * (m1.0 + m2.0), 0.5 * (m1.1 + m2.1));
+    let (jx, jy) = (m2.0 - m1.0, m2.1 - m1.1);
+    let jl = jx.hypot(jy);
+    if !(jl > 0.0 && jl.is_finite()) {
+        return None;
+    }
+    let first = arc(p0, t0, joint, max_radius)?;
+    let second = arc(joint, (jx / jl, jy / jl), p1, max_radius)?;
+    if matches!(first, Seg::Line { .. }) && matches!(second, Seg::Line { .. }) {
+        return Some(vec![Seg::Line { a: p0, b: p1 }]);
+    }
+    Some(vec![first, second])
+}
diff --git a/crates/geometry/src/dxf/curve_fit.rs b/crates/geometry/src/dxf/curve_fit.rs
new file mode 100644
index 000000000..83e1548ae
--- /dev/null
+++ b/crates/geometry/src/dxf/curve_fit.rs
@@ -0,0 +1,249 @@
+//! A smooth DXF curve (SPLINE, ELLIPSE) laid as tangent-continuous circular arcs (biarcs) and
+//! lines, with a checked two-sided bound on the distance between the curve and the output.
+//!
+//! Provenance: our own implementation. The biarc with equal tangent lengths is the classical
+//! construction (K. M. Bolton, "Biarc curves", Computer-Aided Design 7(2), 1975; D. S. Meek and
+//! D. J. Walton, "Approximation of discrete data by G1 arc splines", CAD 24(6), 1992). The
+//! bound is our own: a Lipschitz bound on the curve's speed covers the curve between samples,
+//! and the unit speed of the output covers the output between the closest points of samples.
+//!
+//! The bound. For each accepted piece, every curve point is within `tol` of the output and
+//! every output point is within `tol` of the curve (a Hausdorff distance of at most `tol`).
+//! With samples `t_k` at spacing `h`, distances `d_k` to the output and closest output
+//! positions `s_k` (arc length, non-decreasing): a curve point is within `d_k + L h / 2`, and an
+//! output point within `d_k + (s_(k+1) - s_k) / 2`, where `L` bounds the curve's speed.
+use super::biarc::{Seg, biarc, closest};
+use super::types::{DxfError, Primitive, error};
+use crate::geo2d::Point2;
+
+/// A parametric plane curve that the fitter reads.
+pub(super) trait Curve {
+    fn point(&self, t: f64) -> Point2;
+    /// The unit tangent at `t` inside the smooth section `[lo, hi]`.
+    fn tangent(&self, t: f64, lo: f64, hi: f64) -> Option<(f64, f64)>;
+    /// An upper bound of the speed `|C'(t)|` on `[t0, t1]` (inside one knot span).
+    fn speed(&self, t0: f64, t1: f64) -> f64;
+}
+
+/// The halvings of one initial piece before the curve is refused.
+const MAX_DEPTH: u32 = 40;
+/// The most samples of one piece's dense check; a piece that needs more is halved first.
+/// The drawing's evaluation budget bounds the total.
+const MAX_SAMPLES: usize = 1 << 22;
+
+/// The shared limits of one drawing's curves.
+pub(super) struct Budget {
+    /// Curve evaluations left for the whole drawing.
+    pub evaluations: usize,
+    /// Output primitives left for the whole drawing.
+    pub primitives: usize,
+}
+
+/// The fit settings, in drawing units.
+pub(super) struct Fit<'a> {
+    pub kind: &'a str,
+    pub tol: f64,
+    pub max_radius: f64,
+}
+
+#[derive(Clone, Copy)]
+struct End {
+    t: f64,
+    p: Point2,
+    tan: (f64, f64),
+}
+
+impl Fit<'_> {
+    /// Fit the smooth section `[cuts[0], cuts.last()]`; `cuts` are the initial piece ends
+    /// (knot values, quarter turns). `last` replaces the end point (a closed curve's start).
+    pub fn section<C: Curve>(
+        &self,
+        curve: &C,
+        cuts: &[f64],
+        last: Option<Point2>,
+        budget: &mut Budget,
+        out: &mut Vec<Primitive>,
+    ) -> Result<(), DxfError> {
+        let (Some(&lo), Some(&hi)) = (cuts.first(), cuts.last()) else {
+            return Ok(());
+        };
+        let end = |t: f64, budget: &mut Budget| -> Result<End, DxfError> {
+            spend(budget, 2, self.kind)?;
+            let mut p = curve.point(t);
+            if t == hi
+                && let Some(q) = last
+            {
+                p = q;
+            }
+            let tan = curve
+                .tangent(t, lo, hi)
+                .ok_or_else(|| error(self.kind, "curve has no direction at a point"))?;
+            if !(p.x.is_finite() && p.y.is_finite()) {
+                return Err(error(self.kind, "curve point is not finite"));
+            }
+            Ok(End { t, p, tan })
+        };
+        // The dense checks alone need about L (t1 - t0) / tol samples: refuse a curve that
+        // cannot fit the budget before any work is spent on it.
+        let need: f64 = cuts
+            .windows(2)
+            .map(|w| curve.speed(w[0], w[1]) * (w[1] - w[0]) / self.tol)
+            .sum();
+        if need.is_nan() || need > budget.evaluations as f64 {
+            return Err(error(
+                self.kind,
+                "curve is too long for its tolerance within the import budget",
+            ));
+        }
+        let mut a = end(lo, budget)?;
+        for &t in &cuts[1..] {
+            let b = end(t, budget)?;
+            self.piece(curve, a, b, lo, hi, budget, out)?;
+            a = b;
+        }
+        Ok(())
+    }
+
+    /// Fit one initial piece, halving it until each part passes its check. Parts go out in
+    /// curve order (a stack of right halves).
+    #[allow(clippy::too_many_arguments)]
+    fn piece<C: Curve>(
+        &self,
+        curve: &C,
+        a: End,
+        b: End,
+        lo: f64,
+        hi: f64,
+        budget: &mut Budget,
+        out: &mut Vec<Primitive>,
+    ) -> Result<(), DxfError> {
+        let mut stack = vec![(a, b, 0_u32)];
+        while let Some((a, b, depth)) = stack.pop() {
+            if let Some(segs) = self.accept(curve, a, b, budget)? {
+                if segs.len() > budget.primitives {
+                    return Err(error(self.kind, "arc count exceeds limit"));
+                }
+                budget.primitives -= segs.len();
+                out.extend(segs.into_iter().map(Seg::primitive));
+                continue;
+            }
+            if depth >= MAX_DEPTH || b.t - a.t <= (hi - lo) * 1e-12 {
+                return Err(error(
+                    self.kind,
+                    &format!(
+                        "curve cannot be laid as arcs within {:e} drawing units (a cusp or a sharp turn)",
+                        self.tol
+                    ),
+                ));
+            }
+            let t = 0.5 * (a.t + b.t);
+            spend(budget, 2, self.kind)?;
+            let p = curve.point(t);
+            let tan = curve
+                .tangent(t, lo, hi)
+                .ok_or_else(|| error(self.kind, "curve has no direction at a point"))?;
+            let m = End { t, p, tan };
+            stack.push((m, b, depth + 1));
+            stack.push((a, m, depth + 1));
+        }
+        Ok(())
+    }
+
+    /// The output of one piece if it passes the bound, else `None` (halve it).
+    fn accept<C: Curve>(
+        &self,
+        curve: &C,
+        a: End,
+        b: End,
+        budget: &mut Budget,
+    ) -> Result<Option<Vec<Seg>>, DxfError> {
+        let span = b.t - a.t;
+        let speed = curve.speed(a.t, b.t);
+        if !speed.is_finite() {
+            return Ok(None);
+        }
+        // A piece whose whole length is under half the tolerance and whose ends meet is
+        // within the tolerance of a point: it adds nothing.
+        if a.p == b.p {
+            return Ok((speed * span <= 0.5 * self.tol).then(Vec::new));
+        }
+        // Samples so that the speed term L h / 2 is at most tol / 2.
+        let need = (speed * span / self.tol).ceil().max(8.0);
+        if need > MAX_SAMPLES as f64 {
+            return Ok(None);
+        }
+        let n = need as usize;
+        let Some(segs) = biarc(a.p, a.tan, b.p, b.tan, self.max_radius) else {
+            return Ok(None);
+        };
+        // A coarse look first, then the full check.
+        for stride in [n.div_ceil(64).max(1), 1] {
+            if !self.check(curve, &segs, a, b, n, stride, speed, budget)? {
+                return Ok(None);
+            }
+        }
+        Ok(Some(segs))
+    }
+
+    /// The bound of the module head over `n` intervals, read at every `stride`-th sample.
+    #[allow(clippy::too_many_arguments)]
+    fn check<C: Curve>(
+        &self,
+        curve: &C,
+        segs: &[Seg],
+        a: End,
+        b: End,
+        n: usize,
+        stride: usize,
+        speed: f64,
+        budget: &mut Budget,
+    ) -> Result<bool, DxfError> {
+        let total: f64 = segs.iter().map(Seg::length).sum();
+        let h = (b.t - a.t) / n as f64;
+        let mut worst: f64 = 0.0;
+        let mut gap: f64 = 0.0;
+        let mut previous = 0.0;
+        let mut k = 0;
+        loop {
+            let q = if k == 0 {
+                a.p
+            } else if k == n {
+                b.p
+            } else {
+                spend(budget, 1, self.kind)?;
+                curve.point(a.t + h * k as f64)
+            };
+            let (d, s) = closest(segs, q);
+            if !(d.is_finite() && s.is_finite()) || s + 1e-12 * total < previous {
+                return Ok(false);
+            }
+            worst = worst.max(d);
+            gap = gap.max(s - previous);
+            previous = s.max(previous);
+            if worst > 0.5 * self.tol {
+                return Ok(false);
+            }
+            if k == n {
+                break;
+            }
+            k = (k + stride).min(n);
+        }
+        gap = gap.max(total - previous);
+        if stride > 1 {
+            return Ok(true);
+        }
+        let reach = speed * h * 0.5;
+        Ok(worst + reach <= self.tol && worst + gap * 0.5 <= self.tol)
+    }
+}
+
+fn spend(budget: &mut Budget, n: usize, kind: &str) -> Result<(), DxfError> {
+    if budget.evaluations < n {
+        return Err(error(
+            kind,
+            "curve needs more work than the import budget allows",
+        ));
+    }
+    budget.evaluations -= n;
+    Ok(())
+}
diff --git a/crates/geometry/src/dxf/curves.rs b/crates/geometry/src/dxf/curves.rs
new file mode 100644
index 000000000..be7ba0f21
--- /dev/null
+++ b/crates/geometry/src/dxf/curves.rs
@@ -0,0 +1,305 @@
+//! DXF SPLINE and ELLIPSE entities read and laid as tangent arcs and lines (#1865).
+//! Provenance: the SPLINE and ELLIPSE group codes of Autodesk's published DXF Reference
+//! (format only); the ellipse in its standard parametric form `c + M cos t + m sin t`; our own
+//! implementation. The fit and its bound are in `curve_fit`, the B-spline in `nurbs`.
+//!
+//! The tolerance is [`CURVE_TOLERANCE_MM`] in millimetres, read in drawing units from the
+//! `$INSUNITS` stated before the entity. A drawing without a stated unit is read as inches,
+//! the largest unit a caller can state: the bound in drawing units is then the tightest. The
+//! tolerance used is kept on the document, and `SketchData` refuses a drawing whose applied
+//! unit makes it looser than the stated bound.
+use super::Units;
+use super::curve_fit::{Budget, Curve, Fit};
+use super::entities::{circle_range, common, coordinate, layer, point};
+use super::nurbs::{MAX_DEGREE, Nurbs};
+use super::pairs::{Record, integer, number};
+use super::types::{DxfError, Primitive, State, error};
+use crate::geo2d::Point2;
+use std::f64::consts::{FRAC_PI_2, TAU};
+
+/// The largest distance between a SPLINE or ELLIPSE and its arcs, in millimetres (both ways).
+pub const CURVE_TOLERANCE_MM: f64 = 0.001;
+/// An arc of a curve's fit with a larger radius is laid as a line, in millimetres.
+pub const CURVE_MAX_RADIUS_MM: f64 = 1000.0;
+/// The curve evaluations that one drawing may spend on its curves.
+pub(super) const EVALUATION_BUDGET: usize = 50_000_000;
+/// An ellipse whose axis ratio is this near 1 is a circle: kept as an exact arc.
+const ROUND: f64 = 1e-12;
+
+/// Millimetres per drawing unit for the fit: inches when the drawing states no unit.
+fn per_unit(units: Units) -> f64 {
+    match units {
+        Units::Known(unit) => unit.millimeters_per_unit(),
+        _ => 25.4,
+    }
+}
+
+fn fit_settings(state: &mut State, kind: &'static str) -> Fit<'static> {
+    let k = per_unit(state.doc.units);
+    let tol = CURVE_TOLERANCE_MM / k;
+    let used = state.doc.curve_tolerance.map_or(tol, |old| old.max(tol));
+    state.doc.curve_tolerance = Some(used);
+    Fit {
+        kind,
+        tol,
+        max_radius: CURVE_MAX_RADIUS_MM / k,
+    }
+}
+
+fn emit(state: &mut State, layer: &str, out: Vec<Primitive>, kind: &str) -> Result<(), DxfError> {
+    if out.is_empty() {
+        return Err(error(kind, "curve has zero length"));
+    }
+    for primitive in out {
+        state.vertex(kind)?;
+        state.push(layer, primitive);
+    }
+    Ok(())
+}
+
+struct Ellipse {
+    c: Point2,
+    major: (f64, f64),
+    minor: (f64, f64),
+}
+
+impl Curve for Ellipse {
+    fn point(&self, t: f64) -> Point2 {
+        let (cos, sin) = (t.cos(), t.sin());
+        Point2::new(
+            self.c.x + self.major.0 * cos + self.minor.0 * sin,
+            self.c.y + self.major.1 * cos + self.minor.1 * sin,
+        )
+    }
+
+    fn tangent(&self, t: f64, _: f64, _: f64) -> Option<(f64, f64)> {
+        let (cos, sin) = (t.cos(), t.sin());
+        let dx = -self.major.0 * sin + self.minor.0 * cos;
+        let dy = -self.major.1 * sin + self.minor.1 * cos;
+        let len = dx.hypot(dy);
+        (len > 0.0 && len.is_finite()).then(|| (dx / len, dy / len))
+    }
+
+    fn speed(&self, _: f64, _: f64) -> f64 {
+        // |C'(t)| <= |M| since |m| <= |M|.
+        self.major.0.hypot(self.major.1)
+    }
+}
+
+pub(super) fn ellipse(record: Record<'_>, state: &mut State) -> Result<(), DxfError> {
+    const KIND: &str = "ELLIPSE";
+    common(record)?;
+    let layer = layer(record)?;
+    let c = point(record, 10, 20)?;
+    let z = coordinate(record.number(30, Some(0.0))?, KIND)?;
+    state.elevation(KIND, z)?;
+    let m = point(record, 11, 21)?;
+    if record.number(31, Some(0.0))? != 0.0 {
+        return Err(error(KIND, "major axis leaves the drawing plane"));
+    }
+    let a = m.x.hypot(m.y);
+    let ratio = record.number(40, None)?;
+    if !(ratio > 0.0 && ratio <= 1.0) {
+        return Err(error(KIND, "axis ratio must be above 0 and at most 1"));
+    }
+    circle_range(c, a, KIND)?;
+    let t0 = record.number(41, Some(0.0))?;
+    let t1 = record.number(42, Some(TAU))?;
+    if t0.abs() > 1e6 || t1.abs() > 1e6 {
+        return Err(error(KIND, "parameter outside a plain angle range"));
+    }
+    let span = t1 - t0;
+    let full = span.abs() >= TAU || (span != 0.0 && span.rem_euclid(TAU) == 0.0);
+    let sweep = if full { TAU } else { span.rem_euclid(TAU) };
+    if sweep == 0.0 {
+        return Err(error(KIND, "zero-length parameter sweep"));
+    }
+    let start = t0.rem_euclid(TAU);
+    let axis = m.y.atan2(m.x);
+    if (1.0 - ratio).abs() <= ROUND {
+        let primitive = if full {
+            Primitive::Circle {
+                center: c,
+                radius: a,
+            }
+        } else {
+            Primitive::Arc {
+                center: c,
+                radius: a,
+                start_angle: (axis + start).rem_euclid(TAU),
+                sweep_angle: sweep,
+            }
+        };
+        state.vertex(KIND)?;
+        state.push(layer, primitive);
+        return Ok(());
+    }
+    let curve = Ellipse {
+        c,
+        major: (m.x, m.y),
+        minor: (-m.y * ratio, m.x * ratio),
+    };
+    // Pieces of at most a quarter turn, so each starts with a well-shaped biarc.
+    let quarters = (sweep / FRAC_PI_2).ceil().max(1.0) as usize;
+    let cuts: Vec<f64> = (0..=quarters)
+        .map(|i| start + sweep * i as f64 / quarters as f64)
+        .collect();
+    let fit = fit_settings(state, KIND);
+    let mut budget = budget(state);
+    let mut out = Vec::new();
+    let last = full.then(|| curve.point(start));
+    fit.section(&curve, &cuts, last, &mut budget, &mut out)?;
+    state.curve_work = budget.evaluations;
+    emit(state, layer, out, KIND)
+}
+
+fn budget(state: &State) -> Budget {
+    Budget {
+        evaluations: state.curve_work,
+        primitives: state
+            .limits
+            .max_vertices
+            .saturating_sub(state.doc.summary.vertices),
+    }
+}
+
+/// The SPLINE fields in their file order.
+#[derive(Default)]
+struct Fields {
+    knots: Vec<f64>,
+    weights: Vec<f64>,
+    points: Vec<Point2>,
+    fit: usize,
+    x: Option<f64>,
+    z: Option<f64>,
+}
+
+pub(super) fn spline(record: Record<'_>, state: &mut State) -> Result<(), DxfError> {
+    const KIND: &str = "SPLINE";
+    common(record)?;
+    let layer = layer(record)?;
+    let degree = usize::try_from(integer(record.required(71)?, KIND)?)
+        .map_err(|_| error(KIND, &format!("degree must be 1 to {MAX_DEGREE}")))?;
+    let count = |code: u16| -> Result<usize, DxfError> {
+        let n = usize::try_from(record.integer(code, 0)?)
+            .map_err(|_| error(KIND, &format!("negative count in group {code}")))?;
+        let room = state
+            .limits
+            .max_vertices
+            .saturating_sub(state.doc.summary.vertices);
+        if n > room {
+            return Err(error(KIND, "point or knot count exceeds limit"));
+        }
+        Ok(n)
+    };
+    let (knots, controls, fits) = (count(72)?, count(73)?, count(74)?);
+    let mut f = Fields::default();
+    let mut pairs = record.pairs();
+    while let Some(pair) = pairs.next()? {
+        let value = || number(pair.value, KIND);
+        match pair.code {
+            40 => push(&mut f.knots, value()?, knots, "knot")?,
+            41 => push(&mut f.weights, value()?, controls, "weight")?,
+            10 => {
+                if f.x.is_some() {
+                    return Err(error(KIND, "control point has no Y coordinate"));
+                }
+                f.x = Some(coordinate(value()?, KIND)?);
+            }
+            20 => {
+                let x =
+                    f.x.take()
+                        .ok_or_else(|| error(KIND, "Y before X in a control point"))?;
+                let p = Point2::new(x, coordinate(value()?, KIND)?);
+                if f.points.len() >= controls {
+                    return Err(error(KIND, "more control points than group 73 states"));
+                }
+                f.points.push(p);
+            }
+            30 => {
+                let z = coordinate(value()?, KIND)?;
+                if f.z.is_some_and(|old| old != z) {
+                    return Err(error(KIND, "control points are not in one Z plane"));
+                }
+                f.z = Some(z);
+            }
+            11 => {
+                coordinate(value()?, KIND)?;
+                f.fit += 1;
+                if f.fit > fits {
+                    return Err(error(KIND, "more fit points than group 74 states"));
+                }
+            }
+            _ => {}
+        }
+    }
+    if f.x.is_some() {
+        return Err(error(KIND, "control point has no Y coordinate"));
+    }
+    if f.fit != fits {
+        return Err(error(KIND, "fit point count does not match group 74"));
+    }
+    if controls == 0 && fits > 0 {
+        return Err(error(
+            KIND,
+            "fit points without control points are unsupported",
+        ));
+    }
+    if f.knots.len() != knots || f.points.len() != controls {
+        return Err(error(
+            KIND,
+            "knot or control point count does not match groups 72 and 73",
+        ));
+    }
+    state.elevation(KIND, f.z.unwrap_or(0.0))?;
+    for _ in 0..f.points.len() {
+        state.vertex(KIND)?;
+    }
+    let curve = Nurbs::new(degree, f.knots, f.points, f.weights)?;
+    let fit = fit_settings(state, KIND);
+    let mut budget = budget(state);
+    let mut out = Vec::new();
+    for cuts in sections(&curve) {
+        fit.section(&curve, &cuts, None, &mut budget, &mut out)?;
+    }
+    state.curve_work = budget.evaluations;
+    emit(state, layer, out, KIND)
+}
+
+fn push(list: &mut Vec<f64>, value: f64, cap: usize, what: &str) -> Result<(), DxfError> {
+    if list.len() >= cap {
+        return Err(error(
+            "SPLINE",
+            &format!("more {what} values than the stated count"),
+        ));
+    }
+    list.push(value);
+    Ok(())
+}
+
+/// The smooth sections of the spline: its spans, broken where the direction turns at a knot.
+fn sections(curve: &Nurbs) -> Vec<Vec<f64>> {
+    /// A turn at a knot above this angle (radians) is a corner.
+    const KINK: f64 = 1e-5;
+    let breaks = curve.breaks();
+    let (lo, hi) = curve.domain();
+    let mut out = vec![vec![lo]];
+    for (i, &u) in breaks.iter().enumerate().skip(1) {
+        if let Some(cur) = out.last_mut() {
+            cur.push(u);
+        }
+        if i + 1 == breaks.len() {
+            break;
+        }
+        let left = curve.tangent(u, lo, u);
+        let right = curve.tangent(u, u, hi);
+        let corner = match (left, right) {
+            (Some(l), Some(r)) => (l.0 * r.1 - l.1 * r.0).atan2(l.0 * r.0 + l.1 * r.1).abs() > KINK,
+            _ => true,
+        };
+        if corner {
+            out.push(vec![u]);
+        }
+    }
+    out
+}
