+    // #1868: a slot kind reads one picked chain of a profile; the whole
+    // profile names no slot.
+    if matches!(op.params, OpParams::Slot { .. } | OpParams::TrochoidalSlot { .. }) {
+        if matches!(op.src, SrcRef::Selection(_)) {
