index 000000000..46f85489c
--- /dev/null
+++ b/crates/motion/src/machining2d/vcarve.rs
@@ -0,0 +1,290 @@
+//! V-carve (#1443): a V-bit cuts a closed region with the tip on the
+//! medial axis. At each point the tip stands at the depth where the
+//! cone touches the walls, so a narrow stroke is cut shallow, a wide one
+//! deep, and a sharp corner rises to the surface. A maximum depth limits
+//! the cut; where the region is wider than the cone reaches there, the
+//! cone rides the walls and an optional pass clears the floor.
+//!
+//! Provenance: the medial axis transform and its simplification, from
+//! the papers named in `vcarve_axis` (Blum 1967; Choi, Choi and Moon
+//! 1997; Ma, Bae and Choi 2012; Foskey, Lin and Manocha 2003); the cone
+//! law `depth = radius / tan(included angle / 2)` is machine-tool
+//! handbook geometry; the floor rings are the offset pocketing of M.
+//! Held, "On the Computational Geometry of Pocket Machining" (LNCS 500,
+//! 1991). Written from those sources. No vendor material and no other
+//! program's code or output was consulted.
+//!
+//! The safety law: at tip depth `d` the cone's circle in the top plane
+//! has the radius `d * tan(angle / 2)`, and every lower circle of the
+//! cone is smaller. Each tool position is the centre of a circle inside
+//! the region, and the cone's circle is that circle less a wall
+//! allowance. Each straight move is measured against the outline before
+//! it is written; a move that fails is replaced by a retract. So the
+//! cone never cuts outside the region (Prime Directive).
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geo2d::{Point2, Region};
+use crate::geometry::Point3;
+
+use super::face::GenError;
+use super::vcarve_axis::Outline;
+use super::vcarve_walk::{link_ok, same, walk_loop, Keep, Pt, ALLOW};
+
+/// The tip rapids to this height over the top plane, then feeds.
+const PLUNGE_HEIGHT: f64 = crate::approach::DEFAULT_PLUNGE_HEIGHT;
+/// The floor rings stand this much farther from the wall than the cone
+/// pass: the offset's arcs are chords within 0.005 mm.
+const FLOOR_MARGIN: f64 = 0.01;
+/// The smallest floor stepover, mm.
+const MIN_STEPOVER: f64 = 0.01;
+/// The most floor rings one level may have.
+const MAX_RINGS: usize = 20_000;
+
+/// One V-carve's numbers.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct VCarveParams {
+    /// The V-bit's included angle across the axis, degrees in (0, 180).
+    pub angle_deg: f64,
+    /// The cone's widest diameter: the cone cuts no wider than this.
+    pub tool_diameter: f64,
+    pub clearance_z: f64,
+    /// Hop plane between strokes; `None` hops at clearance.
+    pub retract_z: Option<f64>,
+    /// The plane the carving starts in (the start depth).
+    pub top_z: f64,
+    /// The deepest plane the tip may reach: `top_z - bottom_z` is the
+    /// maximum depth.
+    pub bottom_z: f64,
+    /// The most one level cuts under the level before it.
+    pub stepdown: f64,
+    pub feed: f64,
+    pub plunge_feed: f64,
+    /// Clear the floor the cone cannot reach at each level.
+    pub flat_clear: bool,
+    /// The distance between two floor rings, mm.
+    pub flat_stepover: f64,
+}
+
+impl VCarveParams {
+    pub(super) fn validate(&self) -> Result<(), GenError> {
+        let mut finite = [
+            self.angle_deg,
+            self.tool_diameter,
+            self.clearance_z,
+            self.top_z,
+            self.bottom_z,
+            self.stepdown,
+            self.feed,
+            self.plunge_feed,
+            self.flat_stepover,
+        ]
+        .into_iter()
+        .all(f64::is_finite);
+        finite &= self.retract_z.is_none_or(f64::is_finite);
+        let bad = |msg: &str| Err(GenError::Invalid(msg.into()));
+        if !finite {
+            return bad("parameters must be finite");
+        }
+        if !(self.angle_deg > 0.0 && self.angle_deg < 180.0) {
+            return bad("V-bit angle must be between 0 and 180 degrees");
+        }
+        if self.tool_diameter <= 0.0 {
+            return bad("V-bit diameter must be positive");
+        }
+        if self.bottom_z >= self.top_z {
+            return bad("maximum depth must be positive: the bottom plane must be under the top plane");
+        }
+        if self.stepdown <= 0.0 {
+            return bad("stepdown must be positive");
+        }
+        if self.feed <= 0.0 || self.plunge_feed <= 0.0 {
+            return bad("feeds must be positive");
+        }
+        if self.clearance_z < self.top_z {
+            return bad("clearance plane below the carving's top plane");
+        }
+        if self.retract_z.is_some_and(|rz| rz < self.top_z) {
+            return bad("retract plane sits inside the material");
+        }
+        if self.flat_clear && self.flat_stepover < MIN_STEPOVER {
+            return bad("flat clearing stepover must be 0.01 mm or more");
+        }
+        Ok(())
+    }
+
+    /// `tan` of the cone's half angle: the cone's radius for each unit
+    /// of height above the tip.
+    #[must_use]
+    pub fn tan_half(&self) -> f64 {
+        (self.angle_deg.to_radians() * 0.5).tan()
+    }
+
+    /// The height of the cone: a deeper cut would bring the straight
+    /// land above the cone into the wall.
+    #[must_use]
+    pub fn cone_height(&self) -> f64 {
+        0.5 * self.tool_diameter / self.tan_half()
+    }
+}
+
+/// Writes the strokes. It feeds from one position to the next where the
+/// straight move keeps the cone inside the outline, and hops elsewhere.
+struct Carver<'a> {
+    b: PathBuilder,
+    outline: &'a Outline,
+    region: &'a Region,
+    p: &'a VCarveParams,
+    hop_z: f64,
+    tan_half: f64,
+    /// The position the tip stands at in the cut, if it is in the cut.
+    down: Option<Pt>,
+}
+
+impl Carver<'_> {
+    fn z(&self, pt: &Pt) -> f64 {
+        (self.p.top_z - (pt.rho - ALLOW).max(0.0) / self.tan_half).max(self.p.bottom_z)
+    }
+
+    fn go(&mut self, pt: &Pt) {
+        let to = Point3::new(pt.c.x, pt.c.y, self.z(pt));
+        if let Some(from) = self.down {
+            // The same place again: no move.
+            if same(&from, pt) {
+                return;
+            }
+            if link_ok(self.outline, self.region, &from, pt) {
+                self.b.push(MoveKind::Feed, to, Some(self.p.feed));
+                self.down = Some(*pt);
+                return;
+            }
+            self.lift();
+        }
+        let at = self.b.at();
+        self.b.push(MoveKind::Rapid, Point3::new(to.x, to.y, at.z), None);
+        let over = (self.p.top_z + PLUNGE_HEIGHT).min(at.z).max(to.z);
+        self.b.push(MoveKind::Rapid, Point3::new(to.x, to.y, over), None);
+        self.b.push(MoveKind::Plunge, to, Some(self.p.plunge_feed));
+        self.down = Some(*pt);
+    }
+
+    fn lift(&mut self) {
+        if self.down.take().is_some() {
+            let at = self.b.at();
+            self.b.push(MoveKind::Rapid, Point3::new(at.x, at.y, self.hop_z), None);
+        }
+    }
+
+    /// One closed ring of positions: enter at its shallowest point.
+    fn ring(&mut self, ring: &[Pt]) {
+        let Some(start) = (0..ring.len()).min_by(|&i, &j| ring[i].rho.total_cmp(&ring[j].rho)) else {
+            return;
+        };
+        for k in 0..=ring.len() {
+            self.go(&ring[(start + k) % ring.len()]);
+        }
+    }
+
+    /// A walked loop with dropped stretches: each kept run in order,
+    /// starting after a dropped stretch.
+    fn runs(&mut self, walk: &[Option<Pt>]) {
+        let Some(gap) = walk.iter().position(Option::is_none) else {
+            let ring: Vec<Pt> = walk.iter().flatten().copied().collect();
+            self.ring(&ring);
+            return;
+        };
+        for k in 1..=walk.len() {
+            if let Some(pt) = &walk[(gap + k) % walk.len()] {
+                self.go(pt);
+            }
+        }
+    }
+}
+
+/// V-carve `region`: one walk of each loop for each level, then that
+/// level's floor rings where flat clearing is on.
+pub fn v_carve(region: &Region, p: &VCarveParams) -> Result<Toolpath, GenError> {
+    p.validate()?;
+    if region.is_empty() {
+        return Err(GenError::Empty("empty V-carve region".into()));
+    }
+    let outline = Outline::new(region)?;
+    let tan_half = p.tan_half();
+    let cone_h = p.cone_height();
+    if !(tan_half.is_finite() && tan_half > 0.0 && cone_h.is_finite() && cone_h > 0.0) {
+        return Err(GenError::Invalid("V-bit angle leaves no cone".into()));
+    }
+    let asked = p.top_z - p.bottom_z;
+    let depth = asked.min(cone_h);
+    let zs = super::levels::cut_levels(p.top_z, p.top_z - depth, p.stepdown)?;
+
+    let hop_z = p.retract_z.unwrap_or(p.clearance_z).min(p.clearance_z);
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    if depth < asked {
+        b.note(format!(
+            "V-carve: the maximum depth is limited to the cone height {depth:.3} (the V-bit is {} wide at {} degrees)",
+            p.tool_diameter, p.angle_deg
+        ));
+    }
+    let mut carver = Carver { b, outline: &outline, region, p, hop_z, tan_half, down: None };
+    let mut done_r = -1.0;
+    for z in zs {
+        let cap_r = (p.top_z - z) * tan_half + ALLOW;
+        let keep = Keep { cap_r, done_r };
+        for pieces in &outline.loops {
+            let walk = walk_loop(&outline, pieces, &keep)?;
+            carver.runs(&walk);
+        }
+        if p.flat_clear {
+            floor(&mut carver, cap_r)?;
+        }
+        carver.lift();
+        done_r = cap_r;
+    }
+    carver.lift();
+    let mut b = carver.b;
+    let cur = b.at();
+    b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, p.clearance_z), None);
+
+    let path = b.finish();
+    if !path.all_finite() {
+        return Err(GenError::Invalid("path left the finite horizon".into()));
+    }
+    if !path.moves.iter().any(|m| m.kind != MoveKind::Rapid && m.to.z < p.top_z) {
+        return Err(GenError::Empty(
+            "the V-carve region is too narrow to cut: no place is wider than the wall allowance".into(),
+        ));
+    }
+    Ok(path)
+}
+
+/// The floor of one level: rings from the wall pass inward, one
+/// stepover apart, with the tip at the level's depth.
+fn floor(carver: &mut Carver<'_>, cap_r: f64) -> Result<(), GenError> {
+    let step = carver.p.flat_stepover;
+    for j in 1..=MAX_RINGS {
+        let inset = cap_r + FLOOR_MARGIN + step * j as f64;
+        let rings = carver.region.offset(-inset)?;
+        if rings.is_empty() {
+            return Ok(());
+        }
+        for l in rings.loops() {
+            // Start each ring at the point nearest to the tip.
+            let pts = l.points();
+            let at = carver.b.at();
+            let near = |q: &Point2| (q.x - at.x).hypot(q.y - at.y);
+            let Some(start) = (0..pts.len()).min_by(|&i, &k| near(&pts[i]).total_cmp(&near(&pts[k]))) else {
+                continue;
+            };
+            for k in 0..=pts.len() {
+                let c = pts[(start + k) % pts.len()];
+                // A ring point the outline does not clear is not cut.
+                if carver.outline.dist(c) < cap_r - 0.5 * ALLOW || !carver.region.contains(c) {
+                    carver.lift();
+                    continue;
+                }
+                carver.go(&Pt { c, rho: cap_r });
+            }
+        }
+    }
+    Err(GenError::Invalid("flat clearing needs more than 20000 rings; use a larger stepover".into()))
+}
diff --git a/crates/motion/src/machining2d/vcarve_axis.rs b/crates/motion/src/machining2d/vcarve_axis.rs
new file mode 100644
index 000000000..be18db13c
--- /dev/null
+++ b/crates/motion/src/machining2d/vcarve_axis.rs
@@ -0,0 +1,300 @@
+//! V-carve geometry (#1443): the largest circle inside a closed outline
+//! that touches the outline at one given point. Its centre is a point of
+//! the medial axis and its radius is the half width of the region there.
+//!
+//! Provenance: the medial axis transform as the set of maximal inscribed
+//! discs (H. Blum, "A transformation for extracting new descriptors of
+//! shape", 1967; Choi, Choi and Moon, "Mathematical theory of medial
+//! axis transform", Pacific J. Math. 181, 1997), computed for each
+//! boundary point with the tangent-circle shrink of Ma, Bae and Choi
+//! ("3D medial axis point approximation using nearest neighbors and the
+//! normal field", The Visual Computer 28, 2012), here in closed form
+//! against line segments. The branch that runs into a nearly straight
+//! corner is dropped by the separation angle of the simplified medial
+//! axis (Foskey, Lin and Manocha, "Efficient computation of a simplified
+//! medial axis", J. Comput. Inf. Sci. Eng. 3, 2003). Written from those
+//! papers and plane geometry. No vendor material and no other program's
+//! code or output was consulted.
+//!
+//! The circle through a point `q` that is tangent to the outline at `p`,
+//! on the side of the unit normal `n`, has the radius
+//! `|q - p|^2 / (2 n.(q - p))`. The smallest such radius over the whole
+//! outline is the inscribed radius at `p`: the circles tangent at `p`
+//! are nested, so a smaller one never holds a point of the outline.
+
+use crate::geo2d::{Point2, Region};
+
+use super::face::GenError;
+
+/// Two contacts count as one tie when their radii agree to this part.
+const TIE: f64 = 1e-4;
+/// A turn smaller than this is a straight joint, radians.
+const FLAT: f64 = 1e-9;
+
+/// One edge of the outline. The region is on its left.
+pub(super) struct Seg {
+    pub(super) a: Point2,
+    b: Point2,
+    /// `b - a`.
+    e: (f64, f64),
+    len2: f64,
+    /// Unit normal into the region.
+    pub(super) n: (f64, f64),
+    lo: (f64, f64),
+    hi: (f64, f64),
+    prev: usize,
+    next: usize,
+    /// The signed turn at `a`, radians: positive is a convex corner of
+    /// the region, negative a reflex corner.
+    pub(super) turn: f64,
+}
+
+impl Seg {
+    pub(super) fn len(&self) -> f64 {
+        self.len2.sqrt()
+    }
+
+    /// The smallest tangent-circle radius this edge allows at `p` with
+    /// the normal `n`, and the point of the edge that sets it.
+    fn limit(&self, p: Point2, n: (f64, f64)) -> (f64, Point2) {
+        let w0 = (self.a.x - p.x, self.a.y - p.y);
+        let a = w0.0 * self.e.0 + w0.1 * self.e.1;
+        let b = w0.0 * n.0 + w0.1 * n.1;
+        let c = self.e.0 * n.0 + self.e.1 * n.1;
+        let w = w0.0 * w0.0 + w0.1 * w0.1;
+        let e = self.len2;
+        let mut best = (f64::INFINITY, self.a);
+        let mut probe = |t: f64| {
+            if !t.is_finite() {
+                return;
+            }
+            let t = t.clamp(0.0, 1.0);
+            let q = (w0.0 + t * self.e.0, w0.1 + t * self.e.1);
+            let d = q.0 * n.0 + q.1 * n.1;
+            let qq = q.0 * q.0 + q.1 * q.1;
+            // Behind the tangent line, or on it: no circle reaches it.
+            if d <= 1e-12 * qq.sqrt() {
+                return;
+            }
+            let f = qq / (2.0 * d);
+            if f < best.0 {
+                best = (f, Point2::new(p.x + q.0, p.y + q.1));
+            }
+        };
+        probe(0.0);
+        probe(1.0);
+        // The stationary points of the radius along the edge: the roots
+        // of `e c t^2 + 2 e b t + (2 a b - w c)`.
+        if c.abs() <= 1e-12 * e.sqrt() {
+            probe(-a / e);
+        } else {
+            let disc = e * e * b * b - e * c * (2.0 * a * b - w * c);
+            if disc >= 0.0 {
+                let sq = disc.sqrt();
+                probe((-e * b + sq) / (e * c));
+                probe((-e * b - sq) / (e * c));
+            }
+        }
+        best
+    }
+
+    fn dist(&self, p: Point2) -> f64 {
+        let t = (((p.x - self.a.x) * self.e.0 + (p.y - self.a.y) * self.e.1) / self.len2).clamp(0.0, 1.0);
+        (p.x - self.a.x - t * self.e.0).hypot(p.y - self.a.y - t * self.e.1)
+    }
+
+    /// The edge's box misses the box of the circle about `c`.
+    fn misses(&self, c: Point2, r: f64) -> bool {
+        self.lo.0 > c.x + r || self.hi.0 < c.x - r || self.lo.1 > c.y + r || self.hi.1 < c.y - r
+    }
+}
+
+/// A place on the outline: on an edge, or in the fan of normals at a
+/// reflex corner (the circle rolls about the corner there).
+#[derive(Clone, Copy)]
+pub(super) enum Piece {
+    /// Edge `i`, from its start to its end.
+    Edge(usize),
+    /// The reflex corner at the start of edge `i`.
+    Fan(usize),
+}
+
+/// The inscribed circle at one place of the outline.
+#[derive(Clone, Copy)]
+pub(super) struct Sample {
+    /// The point of the outline.
+    pub(super) p: Point2,
+    /// The unit normal into the region at `p`.
+    pub(super) n: (f64, f64),
+    /// The inscribed radius.
+    pub(super) r: f64,
+    /// The angle at the circle's centre between `p` and the farthest
+    /// other contact, radians.
+    pub(super) sep: f64,
+}
+
+impl Sample {
+    /// The centre of the tangent circle of radius `rho`.
+    pub(super) fn centre(&self, rho: f64) -> Point2 {
+        Point2::new(self.p.x + rho * self.n.0, self.p.y + rho * self.n.1)
+    }
+}
+
+/// The outline of a region as edges, with the walk order of each loop.
+pub(super) struct Outline {
+    pub(super) segs: Vec<Seg>,
+    /// Each loop's places in walk order.
+    pub(super) loops: Vec<Vec<Piece>>,
+    /// Edge tests done so far: the work budget reads it.
+    pub(super) work: std::cell::Cell<u64>,
+}
+
+impl Outline {
+    /// Build the edges. The loops are sorted by `|area|`, the largest
+    /// first, so the path order does not depend on the input order.
+    pub(super) fn new(region: &Region) -> Result<Self, GenError> {
+        let mut loops: Vec<_> = region.loops().iter().collect();
+        loops.sort_by(|x, y| y.area().abs().total_cmp(&x.area().abs()));
+        let mut segs: Vec<Seg> = Vec::new();
+        let mut walks = Vec::with_capacity(loops.len());
+        for l in loops {
+            let pts: Vec<Point2> = l.points().to_vec();
+            let m = pts.len();
+            if m < 3 {
+                return Err(GenError::Invalid("V-carve needs a closed region: a loop has fewer than three points".into()));
+            }
+            let base = segs.len();
+            for i in 0..m {
+                let (a, b) = (pts[i], pts[(i + 1) % m]);
+                let e = (b.x - a.x, b.y - a.y);
+                let len2 = e.0 * e.0 + e.1 * e.1;
+                if !(len2.is_finite() && len2 > 0.0) {
+                    return Err(GenError::Invalid("V-carve region has an edge of no length".into()));
+                }
+                let len = len2.sqrt();
+                segs.push(Seg {
+                    a,
+                    b,
+                    e,
+                    len2,
+                    n: (-e.1 / len, e.0 / len),
+                    lo: (a.x.min(b.x), a.y.min(b.y)),
+                    hi: (a.x.max(b.x), a.y.max(b.y)),
+                    prev: base + (i + m - 1) % m,
+                    next: base + (i + 1) % m,
+                    turn: 0.0,
+                });
+            }
+            let mut walk = Vec::with_capacity(2 * m);
+            for i in base..base + m {
+                let d0 = segs[segs[i].prev].e;
+                let d1 = segs[i].e;
+                let turn = (d0.0 * d1.1 - d0.1 * d1.0).atan2(d0.0 * d1.0 + d0.1 * d1.1);
+                segs[i].turn = turn;
+                if turn < -FLAT {
+                    walk.push(Piece::Fan(i));
+                }
+                walk.push(Piece::Edge(i));
+            }
+            walks.push(walk);
+        }
+        Ok(Self { segs, loops: walks, work: std::cell::Cell::new(0) })
+    }
+
+    /// The length of a place, for the first split: millimetres for an
+    /// edge, radians for a fan.
+    pub(super) fn span(&self, piece: Piece) -> f64 {
+        match piece {
+            Piece::Edge(i) => self.segs[i].len(),
+            Piece::Fan(i) => self.segs[i].turn.abs(),
+        }
+    }
+
+    /// The inscribed circle at the parameter `t` in `[0, 1]` of a place.
+    pub(super) fn eval(&self, piece: Piece, t: f64) -> Sample {
+        match piece {
+            Piece::Edge(i) => {
+                let s = &self.segs[i];
+                let p = Point2::new(s.a.x + t * s.e.0, s.a.y + t * s.e.1);
+                let mut skip = [i, i, i];
+                // At a convex corner the circle is the corner itself.
+                if t <= 0.0 {
+                    if s.turn > FLAT {
+                        return Sample { p: s.a, n: s.n, r: 0.0, sep: s.turn };
+                    }
+                    skip[1] = s.prev;
+                }
+                if t >= 1.0 {
+                    let turn = self.segs[s.next].turn;
+                    if turn > FLAT {
+                        return Sample { p: s.b, n: s.n, r: 0.0, sep: turn };
+                    }
+                    skip[2] = s.next;
+                }
+                self.touch(p, s.n, skip)
+            }
+            Piece::Fan(i) => {
+                let s = &self.segs[i];
+                let n0 = self.segs[s.prev].n;
+                let (sin, cos) = (t * s.turn).sin_cos();
+                let n = (n0.0 * cos - n0.1 * sin, n0.0 * sin + n0.1 * cos);
+                self.touch(s.a, n, [i, s.prev, i])
+            }
+        }
+    }
+
+    /// The inscribed radius at `p` along `n`, and the widest angle to
+    /// another contact. The edges in `skip` meet the outline at `p`.
+    fn touch(&self, p: Point2, n: (f64, f64), skip: [usize; 3]) -> Sample {
+        let mut best = f64::INFINITY;
+        let mut contacts: Vec<(f64, Point2)> = Vec::new();
+        let mut work = 0u64;
+        for (j, s) in self.segs.iter().enumerate() {
+            if skip.contains(&j) {
+                continue;
+            }
+            work += 1;
+            let bound = best * (1.0 + TIE) + 1e-9;
+            if best.is_finite() && s.misses(Point2::new(p.x + best * n.0, p.y + best * n.1), bound) {
+                continue;
+            }
+            let (f, q) = s.limit(p, n);
+            if f <= bound {
+                contacts.push((f, q));
+                best = best.min(f);
+            }
+        }
+        self.work.set(self.work.get().saturating_add(work));
+        if !best.is_finite() {
+            return Sample { p, n, r: f64::INFINITY, sep: 0.0 };
+        }
+        let c = Point2::new(p.x + best * n.0, p.y + best * n.1);
+        let bound = best * (1.0 + TIE) + 1e-9;
+        let mut sep: f64 = 0.0;
+        for (f, q) in contacts {
+            if f > bound {
+                continue;
+            }
+            let v = (q.x - c.x, q.y - c.y);
+            let len = v.0.hypot(v.1);
+            if len > 0.0 {
+                let cos = (-(n.0 * v.0 + n.1 * v.1) / len).clamp(-1.0, 1.0);
+                sep = sep.max(cos.acos());
+            }
+        }
+        Sample { p, n, r: best, sep }
+    }
+
+    /// The distance from `c` to the outline.
+    pub(super) fn dist(&self, c: Point2) -> f64 {
+        let mut best = f64::INFINITY;
+        for s in &self.segs {
+            if best.is_finite() && s.misses(c, best) {
+                continue;
+            }
+            best = best.min(s.dist(c));
+        }
+        self.work.set(self.work.get().saturating_add(self.segs.len() as u64));
+        best
+    }
+}
diff --git a/crates/motion/src/machining2d/vcarve_walk.rs b/crates/motion/src/machining2d/vcarve_walk.rs
new file mode 100644
index 000000000..db9fdebc5
--- /dev/null
+++ b/crates/motion/src/machining2d/vcarve_walk.rs
@@ -0,0 +1,201 @@
+//! V-carve walk (#1443): roll the inscribed circle once around each
+//! loop of the outline and keep the tool positions, refined until the
+//! straight moves between them follow the true locus within the chord
+//! tolerance.
+//!
+//! Provenance: adaptive midpoint subdivision of a parametric curve
+//! (numerical-analysis textbooks) over the tangent-circle samples of
+//! `vcarve_axis`; the walk of the boundary that covers each branch of
+//! the medial axis from its two walls follows from the contact map of
+//! the medial axis transform (Choi, Choi and Moon, 1997). Our own code.
+//! No vendor material consulted.
+
+use crate::geo2d::Point2;
+
+use super::face::GenError;
+use super::vcarve_axis::{Outline, Piece, Sample};
+
+/// The first split of an edge, mm.
+const STEP: f64 = 0.5;
+/// The first split of a corner fan, radians (5 degrees).
+const FAN_STEP: f64 = 0.087_266_462_599_716_47;
+/// The deepest halving of one first-split interval.
+const MAX_HALVINGS: u32 = 12;
+/// A straight move may leave the true locus by this much, mm.
+pub(super) const CHORD_TOL: f64 = 0.005;
+/// The stock the cone leaves on the walls, mm: it covers the chord
+/// error of the centre and of the radius together.
+pub(super) const ALLOW: f64 = 2.0 * CHORD_TOL;
+/// A corner that turns less than this is a chord joint of a curve, not
+/// a corner of the drawing (20 degrees): the tip does not run into it.
+const MIN_CORNER: f64 = 0.349_065_850_398_865_9;
+/// The edge tests one V-carve may spend before it is refused.
+const MAX_WORK: u64 = 4_000_000_000;
+
+/// One tool position: the tip's XY and the radius of the cone's circle
+/// in the top plane, before the wall allowance.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Pt {
+    pub(super) c: Point2,
+    pub(super) rho: f64,
+}
+
+/// What one level keeps of the walk.
+#[derive(Clone, Copy)]
+pub(super) struct Keep {
+    /// The radius of the cone's circle at this level's depth.
+    pub(super) cap_r: f64,
+    /// A place whose inscribed radius is at or under this was cut to
+    /// its final depth by an earlier level.
+    pub(super) done_r: f64,
+}
+
+impl Keep {
+    fn keeps(&self, s: &Sample) -> bool {
+        if !s.r.is_finite() || s.r <= self.done_r {
+            return false;
+        }
+        // On the wall of a wide region the cone stands a full radius
+        // off the wall: no branch of the axis is ridden. Elsewhere a
+        // branch into a nearly straight corner is not ridden.
+        s.r >= self.cap_r || s.sep >= MIN_CORNER
+    }
+
+    fn pt(&self, s: &Sample) -> Pt {
+        let rho = s.r.min(self.cap_r);
+        Pt { c: s.centre(rho), rho }
+    }
+}
+
+/// The kept tool positions of one loop, in walk order, with `None`
+/// where the walk dropped a stretch.
+pub(super) fn walk_loop(outline: &Outline, pieces: &[Piece], keep: &Keep) -> Result<Vec<Option<Pt>>, GenError> {
+    let mut out: Vec<Option<Pt>> = Vec::new();
+    for &piece in pieces {
+        let span = outline.span(piece);
+        let n = match piece {
+            // An even count: the middle of each edge is a sample, where
+            // a regular polygon's inscribed circle touches every edge.
+            Piece::Edge(_) => (2.0 * (span / (2.0 * STEP)).ceil()).clamp(2.0, 4096.0),
+            Piece::Fan(_) => (span / FAN_STEP).ceil().clamp(1.0, 72.0),
+        } as usize;
+        let mut a = outline.eval(piece, 0.0);
+        emit(&mut out, keep, &a);
+        for i in 0..n {
+            let (t0, t1) = (i as f64 / n as f64, (i + 1) as f64 / n as f64);
+            let b = outline.eval(piece, t1);
+            refine(outline, piece, keep, (t0, &a), (t1, &b), MAX_HALVINGS, &mut out);
+            a = b;
+        }
+        if outline.work.get() > MAX_WORK {
+            return Err(GenError::Invalid(
+                "V-carve region has too much detail to carve in one operation; carve fewer shapes at a time".into(),
+            ));
+        }
+    }
+    Ok(thin(out))
+}
+
+/// Drop each position that lies on the straight move between its
+/// neighbours: a straight wall is one move, not one move for each
+/// sample. The centre and the radius must both be on the line.
+fn thin(walk: Vec<Option<Pt>>) -> Vec<Option<Pt>> {
+    let tol = 0.1 * CHORD_TOL;
+    let on_line = |a: &Pt, m: &Pt, b: &Pt| {
+        let d = (b.c.x - a.c.x, b.c.y - a.c.y, b.rho - a.rho);
+        let w = (m.c.x - a.c.x, m.c.y - a.c.y, m.rho - a.rho);
+        let dd = d.0 * d.0 + d.1 * d.1 + d.2 * d.2;
+        if dd <= 0.0 {
+            return false;
+        }
+        let t = (w.0 * d.0 + w.1 * d.1 + w.2 * d.2) / dd;
+        let e = (w.0 - t * d.0, w.1 - t * d.1, w.2 - t * d.2);
+        (0.0..=1.0).contains(&t) && (e.0 * e.0 + e.1 * e.1 + e.2 * e.2).sqrt() <= tol
+    };
+    let mut out: Vec<Option<Pt>> = Vec::with_capacity(walk.len());
+    // The positions dropped since the last kept one: each must stay on
+    // the line to the next candidate.
+    let mut dropped: Vec<Pt> = Vec::new();
+    for next in walk {
+        if let (Some(b), [.., Some(a), Some(m)]) = (&next, out.as_slice()) {
+            if on_line(a, m, b) && dropped.iter().all(|q| on_line(a, q, b)) {
+                dropped.push(*m);
+                out.pop();
+                out.push(next);
+                continue;
+            }
+        }
+        dropped.clear();
+        out.push(next);
+    }
+    out
+}
+
+fn emit(out: &mut Vec<Option<Pt>>, keep: &Keep, s: &Sample) {
+    let next = keep.keeps(s).then(|| keep.pt(s));
+    match (out.last(), &next) {
+        (Some(None), None) => {}
+        (Some(Some(last)), Some(pt)) if same(last, pt) => {}
+        _ => out.push(next),
+    }
+}
+
+pub(super) fn same(a: &Pt, b: &Pt) -> bool {
+    (a.c.x - b.c.x).hypot(a.c.y - b.c.y) + (a.rho - b.rho).abs() <= 0.25 * CHORD_TOL
+}
+
+/// Emit the samples after `a` up to and including `b`.
+fn refine(
+    outline: &Outline,
+    piece: Piece,
+    keep: &Keep,
+    a: (f64, &Sample),
+    b: (f64, &Sample),
+    halvings: u32,
+    out: &mut Vec<Option<Pt>>,
+) {
+    let (ka, kb) = (keep.keeps(a.1), keep.keeps(b.1));
+    if halvings == 0 || (!ka && !kb && halvings < MAX_HALVINGS) {
+        emit(out, keep, b.1);
+        return;
+    }
+    let tm = 0.5 * (a.0 + b.0);
+    let m = outline.eval(piece, tm);
+    let km = keep.keeps(&m);
+    if ka && kb && km {
+        let (pa, pm, pb) = (keep.pt(a.1), keep.pt(&m), keep.pt(b.1));
+        let ex = pm.c.x - 0.5 * (pa.c.x + pb.c.x);
+        let ey = pm.c.y - 0.5 * (pa.c.y + pb.c.y);
+        let er = pm.rho - 0.5 * (pa.rho + pb.rho);
+        if ex.hypot(ey) + er.abs() <= CHORD_TOL {
+            emit(out, keep, b.1);
+            return;
+        }
+    } else if !ka && !kb && !km {
+        emit(out, keep, b.1);
+        return;
+    }
+    refine(outline, piece, keep, a, (tm, &m), halvings - 1, out);
+    refine(outline, piece, keep, (tm, &m), b, halvings - 1, out);
+}
+
+/// May the tip feed straight from `a` to `b`? Each point between them
+/// must keep the cone's circle inside the outline with a quarter of the
+/// wall allowance to spare.
+pub(super) fn link_ok(outline: &Outline, region: &crate::geo2d::Region, a: &Pt, b: &Pt) -> bool {
+    let len = (b.c.x - a.c.x).hypot(b.c.y - a.c.y);
+    if !len.is_finite() {
+        return false;
+    }
+    let n = ((len / 0.25).ceil() as usize).clamp(1, 4096);
+    (0..=n + 1).all(|i| {
+        let t = i as f64 / (n + 1) as f64;
+        let rho = a.rho + t * (b.rho - a.rho);
+        // At the surface the tip cuts nothing.
+        if rho <= ALLOW {
+            return true;
+        }
+        let c = Point2::new(a.c.x + t * (b.c.x - a.c.x), a.c.y + t * (b.c.y - a.c.y));
+        region.contains(c) && outline.dist(c) >= rho - 0.75 * ALLOW
+    })
+}
diff --git a/crates/motion/tests/v_carve.rs b/crates/motion/tests/v_carve.rs
new file mode 100644
index 000000000..c7d2c2f50
--- /dev/null
+++ b/crates/motion/tests/v_carve.rs
@@ -0,0 +1,344 @@
+//! The V-carve kernel's laws (#1443): the tool centre rides the medial
+//! axis of the closed region, the depth at each point is the depth at
+//! which the cone touches the walls, and the cone never cuts outside
+//! the region at any depth. The sweep test reads every cutting move and
+//! measures the cone's circle in the top plane against the outline.
+//!
+//! Gate map (M4.4): covers camcraft_motion::cl, camcraft_motion::geo2d,
+//! camcraft_motion::machining2d (v_carve).
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::machining2d::{v_carve, GenError, VCarveParams};
+
+const TOP: f64 = 0.0;
+
+fn poly(pts: &[(f64, f64)]) -> Loop {
+    Loop::new(pts.iter().map(|&(x, y)| Point2::new(x, y)).collect()).unwrap()
+}
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Region {
+    Region::new(vec![poly(&[(x0, y0), (x1, y0), (x1, y1), (x0, y1)])]).unwrap()
+}
+
+fn ngon(cx: f64, cy: f64, r: f64, n: usize) -> Loop {
+    let pts: Vec<(f64, f64)> = (0..n)
+        .map(|i| {
+            let a = std::f64::consts::TAU * i as f64 / n as f64;
+            (cx + r * a.cos(), cy + r * a.sin())
+        })
+        .collect();
+    poly(&pts)
+}
+
+/// A 90 degree V-bit, 12 mm wide: the cut is as deep as it is wide on
+/// each side, so the numbers below read off the drawing.
+fn params() -> VCarveParams {
+    VCarveParams {
+        angle_deg: 90.0,
+        tool_diameter: 12.0,
+        clearance_z: 10.0,
+        retract_z: Some(3.0),
+        top_z: TOP,
+        bottom_z: -6.0,
+        stepdown: 6.0,
+        feed: 600.0,
+        plunge_feed: 200.0,
+        flat_clear: false,
+        flat_stepover: 0.25,
+    }
+}
+
+fn dist_to_seg(p: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let dd = dx * dx + dy * dy;
+    if dd == 0.0 {
+        return (p.x - a.x).hypot(p.y - a.y);
+    }
+    let t = (((p.x - a.x) * dx + (p.y - a.y) * dy) / dd).clamp(0.0, 1.0);
+    (p.x - a.x - t * dx).hypot(p.y - a.y - t * dy)
+}
+
+fn dist_to_outline(region: &Region, p: Point2) -> f64 {
+    let mut best = f64::INFINITY;
+    for l in region.loops() {
+        let pts = l.points();
+        for i in 0..pts.len() {
+            best = best.min(dist_to_seg(p, pts[i], pts[(i + 1) % pts.len()]));
+        }
+    }
+    best
+}
+
+/// Every point of every cutting move, at most 0.02 mm apart: (x, y, z).
+fn cut_samples(path: &Toolpath) -> Vec<(f64, f64, f64)> {
+    let mut out = Vec::new();
+    for m in &path.moves {
+        if m.kind == MoveKind::Rapid {
+            continue;
+        }
+        let len = ((m.to.x - m.from.x).powi(2) + (m.to.y - m.from.y).powi(2) + (m.to.z - m.from.z).powi(2)).sqrt();
+        let n = (len / 0.02).ceil().max(1.0) as usize;
+        for i in 0..=n {
+            let t = i as f64 / n as f64;
+            out.push((
+                m.from.x + t * (m.to.x - m.from.x),
+                m.from.y + t * (m.to.y - m.from.y),
+                m.from.z + t * (m.to.z - m.from.z),
+            ));
+        }
+    }
+    out
+}
+
+/// The safety law of the issue: sweep the cone along the path. At a tip
+/// depth `d` under the top plane the cone's circle in that plane has the
+/// radius `d * tan(angle / 2)`; it must lie inside the region. No
+/// tolerance is given to the cutter: the kernel keeps its own allowance.
+fn assert_cone_inside(region: &Region, path: &Toolpath, angle_deg: f64, top: f64) {
+    let tan_half = (angle_deg.to_radians() * 0.5).tan();
+    let mut cut = 0usize;
+    for (x, y, z) in cut_samples(path) {
+        let depth = top - z;
+        if depth <= 1e-9 {
+            continue;
+        }
+        cut += 1;
+        let p = Point2::new(x, y);
+        let r = depth * tan_half;
+        assert!(region.contains(p), "the tip is outside the region at ({x:.4}, {y:.4}, {z:.4})");
+        let d = dist_to_outline(region, p);
+        assert!(r <= d + 1e-9, "the cone leaves the region at ({x:.4}, {y:.4}, {z:.4}): cone radius {r:.5} over wall distance {d:.5}");
+    }
+    assert!(cut > 0, "the path cuts nothing");
+}
+
+fn min_z(path: &Toolpath) -> f64 {
+    cut_samples(path).iter().map(|s| s.2).fold(f64::INFINITY, f64::min)
+}
+
+fn letter_l() -> Region {
+    // One reflex corner at (4, 4): the L of a sign.
+    Region::new(vec![poly(&[(0.0, 0.0), (12.0, 0.0), (12.0, 4.0), (4.0, 4.0), (4.0, 14.0), (0.0, 14.0)])]).unwrap()
+}
+
+fn letter_o() -> Region {
+    // A stroke between two tessellated circles: outer wall and hole.
+    Region::new(vec![ngon(0.0, 0.0, 8.0, 48), ngon(0.0, 0.0, 5.0, 36)]).unwrap()
+}
+
+#[test]
+fn the_cone_never_leaves_the_region() {
+    let shapes: Vec<(&str, Region)> = vec![
+        ("rectangle", rect(0.0, 0.0, 10.0, 4.0)),
+        ("letter L", letter_l()),
+        ("letter O", letter_o()),
+        ("circle", Region::new(vec![ngon(0.0, 0.0, 5.0, 64)]).unwrap()),
+        ("triangle", Region::new(vec![poly(&[(0.0, 0.0), (9.0, 0.0), (1.0, 6.0)])]).unwrap()),
+    ];
+    for (name, region) in &shapes {
+        for angle in [30.0, 60.0, 90.0, 120.0] {
+            for (bottom, flat) in [(-20.0, false), (-1.0, false), (-1.0, true)] {
+                let p = VCarveParams { angle_deg: angle, bottom_z: bottom, stepdown: 0.7, flat_clear: flat, ..params() };
+                let path = v_carve(region, &p).unwrap_or_else(|e| panic!("{name} at {angle} degrees: {e}"));
+                assert!(path.all_finite() && path.is_chained(), "{name}: the path is not chained");
+                assert_cone_inside(region, &path, angle, TOP);
+                assert!(min_z(&path) >= bottom - 1e-9, "{name}: a move is under the maximum depth");
+            }
+        }
+    }
+}
+
+#[test]
+fn the_depth_follows_the_width_of_the_region() {
+    // A 10 x 4 slot under a 90 degree cone: the inscribed circle on the
+    // spine has the radius 2, so the tip stands 2 deep there.
+    let region = rect(0.0, 0.0, 10.0, 4.0);
+    let path = v_carve(&region, &params()).unwrap();
+    let floor = min_z(&path);
+    assert!((floor + 2.0).abs() < 0.02, "the spine is {floor}, not -2");
+    // The deepest points stand on the spine y = 2, between x = 2 and 8.
+    for (x, y, z) in cut_samples(&path) {
+        if z < -1.98 {
+            assert!((y - 2.0).abs() < 0.05 && (1.9..=8.1).contains(&x), "deep point off the spine: ({x}, {y}, {z})");
+        }
+    }
+    // A wider slot is cut deeper: twice the width, twice the depth.
+    let wide = v_carve(&rect(0.0, 0.0, 20.0, 8.0), &params()).unwrap();
+    assert!((min_z(&wide) + 4.0).abs() < 0.02, "the wide spine is {}", min_z(&wide));
+    // A narrower cone is cut deeper in the same slot.
+    let narrow = v_carve(&region, &VCarveParams { angle_deg: 60.0, ..params() }).unwrap();
+    let want = -2.0 / (30.0f64).to_radians().tan();
+    assert!((min_z(&narrow) - want).abs() < 0.03, "60 degrees: {} against {want}", min_z(&narrow));
+}
+
+#[test]
+fn a_sharp_corner_rises_to_the_surface() {
+    let region = rect(0.0, 0.0, 10.0, 4.0);
+    let path = v_carve(&region, &params()).unwrap();
+    let pts = cut_samples(&path);
+    for (cx, cy) in [(0.0, 0.0), (10.0, 0.0), (10.0, 4.0), (0.0, 4.0)] {
+        let near = pts.iter().any(|&(x, y, z)| (x - cx).hypot(y - cy) < 0.02 && (TOP - z) < 0.02);
+        assert!(near, "the path does not reach the corner ({cx}, {cy}) at the surface");
+    }
+}
+
+#[test]
+fn a_stroke_is_cut_in_one_engagement() {
+    // The walk around a loop is continuous: no retract inside a letter.
+    // A straight wall is one move, not one move for each sample.
+    let plunges = |path: &Toolpath| path.moves.iter().filter(|m| m.kind == MoveKind::Plunge).count();
+    let slot = v_carve(&rect(0.0, 0.0, 10.0, 4.0), &params()).unwrap();
+    assert_eq!(plunges(&slot), 1);
+    assert!(slot.moves.len() <= 20, "a slot took {} moves", slot.moves.len());
+    assert_eq!(plunges(&v_carve(&letter_l(), &params()).unwrap()), 1);
+    // The O has two loops: the outer wall and the hole.
+    assert!(plunges(&v_carve(&letter_o(), &params()).unwrap()) <= 2);
+}
+
+#[test]
+fn a_tessellated_circle_is_one_dip_not_a_star() {
+    // 64 chords of a circle of radius 5: the chord corners are not
+    // corners of the drawing. The tip must stay at the centre, deep, and
+    // must not rise to the surface at each chord end.
+    let region = Region::new(vec![ngon(0.0, 0.0, 5.0, 64)]).unwrap();
+    let path = v_carve(&region, &params()).unwrap();
+    let feeds: Vec<_> = path.moves.iter().filter(|m| m.kind == MoveKind::Feed).collect();
+    for m in &feeds {
+        assert!(m.to.x.hypot(m.to.y) < 0.1, "a feed leaves the centre: ({}, {})", m.to.x, m.to.y);
+        assert!(m.to.z < -4.8, "a feed rises to {}", m.to.z);
+    }
+    assert!((min_z(&path) + 5.0).abs() < 0.03, "the centre is {}", min_z(&path));
+}
+
+#[test]
+fn the_maximum_depth_limits_the_cut() {
+    let region = rect(0.0, 0.0, 20.0, 20.0);
+    let p = VCarveParams { bottom_z: -2.0, stepdown: 2.0, ..params() };
+    let path = v_carve(&region, &p).unwrap();
+    assert!((min_z(&path) + 2.0).abs() < 1e-9, "floor {}", min_z(&path));
+    // Without flat clearing the middle of the wide region is not cut.
+    assert!(cut_samples(&path).iter().all(|&(x, y, _)| (x - 10.0).hypot(y - 10.0) > 5.0));
+}
+
+#[test]
+fn flat_clearing_removes_the_floor_the_cone_cannot_reach() {
+    let region = rect(0.0, 0.0, 20.0, 20.0);
+    let p = VCarveParams { bottom_z: -2.0, stepdown: 2.0, flat_clear: true, flat_stepover: 0.5, ..params() };
+    let path = v_carve(&region, &p).unwrap();
+    assert_cone_inside(&region, &path, 90.0, TOP);
+    let floor: Vec<(f64, f64)> = cut_samples(&path).into_iter().filter(|s| (s.2 + 2.0).abs() < 1e-9).map(|s| (s.0, s.1)).collect();
+    // Each point of the floor (2 mm inside the outline) has a pass of
+    // the tip within one stepover.
+    let mut y = 2.5;
+    while y <= 17.5 {
+        let mut x = 2.5;
+        while x <= 17.5 {
+            let near = floor.iter().any(|&(fx, fy)| (fx - x).hypot(fy - y) <= 0.5);
+            assert!(near, "the floor at ({x}, {y}) is not cleared");
+            x += 0.5;
+        }
+        y += 0.5;
+    }
+}
+
+#[test]
+fn a_deep_carve_steps_down() {
+    let region = rect(0.0, 0.0, 20.0, 8.0);
+    let p = VCarveParams { stepdown: 1.5, ..params() };
+    let path = v_carve(&region, &p).unwrap();
+    assert_cone_inside(&region, &path, 90.0, TOP);
+    assert!((min_z(&path) + 4.0).abs() < 0.02);
+    // The first engagement is no deeper than one stepdown: read the
+    // cutting moves up to the first retract.
+    let mut first = f64::INFINITY;
+    let mut cutting = false;
+    for m in &path.moves {
+        if m.kind == MoveKind::Rapid {
+            if cutting {
+                break;
+            }
+            continue;
+        }
+        cutting = true;
+        first = first.min(m.to.z);
+    }
+    assert!(first >= -1.5 - 1e-9, "the first pass is {first} deep");
+    // The levels are distinct: -1.5, -3.0 and the spine at -4.0.
+    for level in [-1.5, -3.0] {
+        assert!(cut_samples(&path).iter().any(|s| (s.2 - level).abs() < 1e-9), "no pass at {level}");
+    }
+}
+
+#[test]
+fn a_cone_shorter_than_the_maximum_depth_limits_the_cut_and_says_so() {
+    // A 4 mm wide 90 degree cone is 2 mm high: it cannot cut 6 mm deep.
+    let region = rect(0.0, 0.0, 20.0, 20.0);
+    let path = v_carve(&region, &VCarveParams { tool_diameter: 4.0, ..params() }).unwrap();
+    assert!((min_z(&path) + 2.0).abs() < 1e-9, "floor {}", min_z(&path));
+    assert!(path.notes.iter().any(|n| n.contains("cone")), "no note: {:?}", path.notes);
+}
+
+#[test]
+fn bad_input_is_refused_by_name() {
+    let region = rect(0.0, 0.0, 10.0, 4.0);
+    let refused = |p: VCarveParams, word: &str| match v_carve(&region, &p) {
+        Err(GenError::Invalid(msg)) => assert!(msg.contains(word), "'{msg}' does not name '{word}'"),
+        other => panic!("expected a refusal that names '{word}', got {other:?}"),
+    };
+    refused(VCarveParams { angle_deg: 0.0, ..params() }, "angle");
+    refused(VCarveParams { angle_deg: 180.0, ..params() }, "angle");
+    refused(VCarveParams { tool_diameter: 0.0, ..params() }, "diameter");
+    refused(VCarveParams { bottom_z: 0.0, ..params() }, "maximum depth");
+    refused(VCarveParams { stepdown: 0.0, ..params() }, "stepdown");
+    refused(VCarveParams { feed: 0.0, ..params() }, "feed");
+    refused(VCarveParams { clearance_z: -1.0, ..params() }, "clearance");
+    refused(VCarveParams { retract_z: Some(-1.0), ..params() }, "retract");
+    refused(VCarveParams { flat_clear: true, flat_stepover: 0.0, ..params() }, "stepover");
+    refused(VCarveParams { feed: f64::NAN, ..params() }, "finite");
+    assert!(matches!(v_carve(&Region::empty(), &params()), Err(GenError::Empty(_))));
+}
+
+/// Degenerate regions give a clean error or a safe path. They do not
+/// crash and they do not hang. A deterministic generator makes the
+/// shapes, so a failure repeats.
+#[test]
+fn degenerate_regions_give_a_clean_answer() {
+    let mut seed = 0x1443_u64;
+    let mut next = move || {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        ((seed >> 33) as f64) / f64::from(1u32 << 31)
+    };
+    let mut shapes: Vec<Vec<(f64, f64)>> = vec![
+        // Zero width: all points on one line.
+        vec![(0.0, 0.0), (5.0, 0.0), (10.0, 0.0)],
+        // A sliver 1 micron wide.
+        vec![(0.0, 0.0), (10.0, 0.0), (10.0, 0.001), (0.0, 0.001)],
+        // A bow tie: the outline crosses itself.
+        vec![(0.0, 0.0), (10.0, 10.0), (10.0, 0.0), (0.0, 10.0)],
+        // A spike that returns on itself.
+        vec![(0.0, 0.0), (10.0, 0.0), (5.0, 0.0), (5.0, 5.0)],
+        // Far from the origin.
+        vec![(1e7, 1e7), (1e7 + 3.0, 1e7), (1e7 + 3.0, 1e7 + 3.0), (1e7, 1e7 + 3.0)],
+    ];
+    for _ in 0..40 {
+        let n = 3 + (next() * 7.0) as usize;
+        shapes.push((0..n).map(|_| ((next() * 12.0).round() * 0.5, (next() * 12.0).round() * 0.5)).collect());
+    }
+    for pts in &shapes {
+        let Ok(l) = Loop::new(pts.iter().map(|&(x, y)| Point2::new(x, y)).collect()) else { continue };
+        let Ok(region) = Region::new(vec![l]) else { continue };
+        for flat in [false, true] {
+            let p = VCarveParams { bottom_z: -1.0, stepdown: 1.0, flat_clear: flat, ..params() };
+            match v_carve(&region, &p) {
+                Ok(path) => {
+                    assert!(path.all_finite() && path.is_chained(), "{pts:?}");
+                    if path.moves.iter().any(|m| m.kind != MoveKind::Rapid && m.to.z < TOP - 1e-9) {
+                        assert_cone_inside(&region, &path, 90.0, TOP);
+                    }
+                }
+                Err(e) => assert!(!e.to_string().is_empty()),
+            }
+        }
+    }
+}

