+/// The widest drawn radius at height `z` on the outline `p`.
+fn drawn_at(p: &[(f64, f64)], z: f64) -> f64 {
+    p.windows(2)
+        .filter(|w| w[0].0.min(w[1].0) <= z && z <= w[0].0.max(w[1].0))
+        .map(|w| {
+            let (a, b) = (w[0], w[1]);
+            if (b.0 - a.0).abs() < 1e-12 { a.1.max(b.1) } else { a.1 + (b.1 - a.1) * (z - a.0) / (b.0 - a.0) }
+        })
+        .fold(0.0, f64::max)
+}
