From a36ced552be3360e9a0c810526a950c8e779ae9e Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 21:24:31 +0100
Subject: [PATCH 1/2] test(post): pin the wire-iso refusal of a non-finite wire
 number

Starts red on the parent head: the script skips the param and posts
the leaning move as a plain G1.

Refs #3236

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/post/tests/script_wire_iso.rs | 62 ++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/crates/post/tests/script_wire_iso.rs b/crates/post/tests/script_wire_iso.rs
index 347d3ae6c..e59210497 100644
--- a/crates/post/tests/script_wire_iso.rs
+++ b/crates/post/tests/script_wire_iso.rs
@@ -96,3 +96,65 @@ fn an_angle_word_section_posts_and_each_missing_piece_is_refused_by_name() {
     let w = warnings(&machine(None), &[("WireTaper", json!(3.0))]);
     assert!(says(&w, "an angle word in a section that states no angle-word taper"), "{w:?}");
 }
+
+// #3236: a non-finite wire number. The app's `json!(f64::NAN)` is JSON
+// null, so the stream says `PARAM WireU null`; a hand-written one can
+// say `nan` or `inf`. Before the fix the script skipped the param and
+// wrote the leaning move as a plain `G1 X Y` with no warning.
+
+/// One wire section: `params` before it, then a rapid, then each
+/// `(lean params, x)` feed to `(x, 0)`.
+fn section(params: &[(&str, Value)], feeds: &[(&[(&str, Value)], f64)]) -> String {
+    let mut recs = vec![
+        Record::Param { name: "OperationName".into(), value: json!("Punch1") },
+        Record::Param { name: "EdmCondition".into(), value: json!("C110") },
+        Record::Param { name: "WireSide".into(), value: json!("punch") },
+    ];
+    recs.extend(params.iter().map(|(n, v)| Record::Param { name: (*n).into(), value: v.clone() }));
+    recs.push(Record::Section { begin: true });
+    recs.push(mv(MoveKind::Rapid, -30.0, 0.0));
+    for (lean, x) in feeds {
+        recs.extend(lean.iter().map(|(n, v)| Record::Param { name: (*n).into(), value: v.clone() }));
+        recs.push(mv(MoveKind::Feed, *x, 0.0));
+    }
+    recs.push(Record::Section { begin: false });
+    cnc::serialize(&recs)
+}
+
+fn post(m: &Value, stream: &str) -> engine::PostOutput {
+    engine::run(&read("assets/posts/wire-iso.cps"), m, stream).expect("the wire post runs")
+}
+
+#[test]
+fn a_non_finite_wire_number_is_refused_by_name_and_writes_no_cut() {
+    let uv = machine(None);
+    let taper = [("WireTaper", json!(3.0))];
+    // The control case: two good leaning moves post their U V words.
+    let good: &[(&str, Value)] = &[("WireU", json!(0.5)), ("WireV", json!(0.0))];
+    let out = post(&uv, &section(&taper, &[(good, -20.0), (good, -10.0)]));
+    assert!(out.warnings.is_empty(), "the control section posts: {:?}", out.warnings);
+    assert!(out.program.contains("X-10.") && out.program.contains("U0.5"), "{}", out.program);
+    // A non-finite U on the second leaning move: refused by name, and its
+    // move is not written as a plain G1 (nor any later cut).
+    for bad in [json!(f64::NAN), json!("nan"), json!("inf")] {
+        let lean: &[(&str, Value)] = &[("WireU", bad.clone()), ("WireV", json!(0.0))];
+        let out = post(&uv, &section(&taper, &[(good, -20.0), (lean, -10.0)]));
+        assert!(says(&out.warnings, "operation Punch1: PARAM WireU is not a finite number"), "{bad}: {:?}", out.warnings);
+        assert!(!out.program.contains("X-10."), "{bad}: the move posts no G1:\n{}", out.program);
+    }
+    // A non-finite V: the same refusal, by its own name.
+    let lean: &[(&str, Value)] = &[("WireU", json!(0.5)), ("WireV", json!(f64::INFINITY))];
+    let out = post(&uv, &section(&taper, &[(lean, -20.0)]));
+    assert!(says(&out.warnings, "PARAM WireV is not a finite number"), "{:?}", out.warnings);
+    assert!(!out.program.contains("X-20."), "{}", out.program);
+    // A non-finite angle word on an angle-word machine.
+    let ang = machine(Some("FX-ANGLE A{angle}"));
+    let lean: &[(&str, Value)] = &[("WireAngle", json!(f64::NAN))];
+    let out = post(&ang, &section(&angle(&taper), &[(lean, -20.0)]));
+    assert!(says(&out.warnings, "PARAM WireAngle is not a finite number"), "{:?}", out.warnings);
+    assert!(!out.program.contains("X-20.") && !out.program.contains("ANaN"), "{}", out.program);
+    // A non-finite section taper is named as such, not as "no taper".
+    let out = post(&uv, &section(&[("WireTaper", json!(f64::NAN))], &[(good, -20.0)]));
+    assert!(says(&out.warnings, "PARAM WireTaper is not a finite number"), "{:?}", out.warnings);
+    assert!(!out.program.contains("X-20."), "{}", out.program);
+}

From d1169aa25b8115ed5fc431d137ab59c952f72609 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 21:24:31 +0100
Subject: [PATCH 2/2] fix(post): refuse a non-finite wire number in wire-iso by
 name

A PARAM WireTaper, WirePlane, WireAngle, WireU or WireV that is not a
finite number (null, nan, inf) was skipped without a word, so a leaning
move posted as a plain G1 X Y. The script now refuses it by name and
writes no cut of the section.

Fixes #3236

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 assets/posts/wire-iso.cps                    | 14 ++++++++++++
 docs/decisions/3236-wire-iso-finite-words.md | 24 ++++++++++++++++++++
 2 files changed, 38 insertions(+)
 create mode 100644 docs/decisions/3236-wire-iso-finite-words.md

diff --git a/assets/posts/wire-iso.cps b/assets/posts/wire-iso.cps
index 1001f9edf..a1b609754 100644
--- a/assets/posts/wire-iso.cps
+++ b/assets/posts/wire-iso.cps
@@ -76,6 +76,13 @@ var taperOk = true;
 var dialect = "";          // "angle": the machine tapers by angle word (#1164)
 var corner = "", plane = null;
 var angleNext = null;      // the next move's angle word (WireAngle)
+// A wire number the stream states but that is no finite number (#3236):
+// the param's name, "" for none. A non-finite f64 reaches the stream as
+// "null" (or "nan" / "inf" in a hand-written one); skipped, it would turn
+// a leaning move into a plain G1. Refused, and no cut of the section is
+// written.
+var WIRE_NUMBERS = ["WireTaper", "WirePlane", "WireAngle", "WireU", "WireV"];
+var notFinite = "";
 var codesOk = false;
 var refused = {};
 
@@ -183,6 +190,11 @@ function onOpen() {
 }
 
 function onParameter(name, value) {
+  if (WIRE_NUMBERS.indexOf(name) >= 0 && !has(value)) {
+    notFinite = name;
+    refuse("nf" + name + opName, who() + "PARAM " + name + " is not a finite number (" + (value === null || value === undefined ? "null" : clean(value)) + ") - refused, the wire post writes no cut from it");
+    return;
+  }
   if (name === "WorkOffset" && value) wcsWord = String(value);
   else if (name === "OriginX" && has(value)) orgX = Number(value);
   else if (name === "OriginY" && has(value)) orgY = Number(value);
@@ -320,6 +332,7 @@ function cutOk(p) {
     refuse("tilt" + opName, who() + "a posed move - this post writes a 2-axis (vertical wire) cut only");
     return false;
   }
+  if (notFinite !== "") return false; // refused by name in onParameter (#3236)
   if (!startCut(p)) return false;
   if (has(p.Z) && cutZ !== null && Math.abs(p.Z - cutZ) > 0.0005) {
     refuse("z" + opName, who() + "a move changes Z - a 2-axis wire cut rides one programmed plane");
@@ -438,6 +451,7 @@ function onSectionEnd() {
   corner = "";
   plane = null;
   angleNext = null;
+  notFinite = "";
 }
 
 // ------------------------------------------------------------ footer
diff --git a/docs/decisions/3236-wire-iso-finite-words.md b/docs/decisions/3236-wire-iso-finite-words.md
new file mode 100644
index 000000000..4abf03926
--- /dev/null
+++ b/docs/decisions/3236-wire-iso-finite-words.md
@@ -0,0 +1,24 @@
+## #3236 - wire-iso refuses a wire number that is not finite
+
+**Decided:** the generic ISO wire post (`assets/posts/wire-iso.cps`)
+refuses by name a `PARAM WireTaper`, `WirePlane`, `WireAngle`, `WireU`
+or `WireV` that the stream states but that is not a finite number
+(`null`, `nan`, `inf`). After that refusal the post writes no cut of the
+section.
+
+**Why:** the issue said that the post writes `UNaN` or `ANaN`. A test
+showed a different failure. The app writes a non-finite `f64` as JSON
+`null`, and the stream parser reads `nan` and `inf` as text. The script
+skipped each such param without a word, so a leaning move posted as a
+plain `G1 X Y` with no U V and no angle word. That is a silent wrong
+cut. The refusal blocks the NC file in the app (`posting.rs`, a
+`message()` is a blocking warning).
+
+**Dropped:**
+- A check on the Rust side only (`posting_wire.rs`). The script is the
+  guard for every stream, also a hand-written one that `post.exe` reads.
+- A refusal of the one move only. A section with one unreadable lean is
+  not a program to run, so no later cut of it is written either.
+
+**Cost to change later:** low. One list (`WIRE_NUMBERS`) and one guard
+in `cutOk` of the script.
