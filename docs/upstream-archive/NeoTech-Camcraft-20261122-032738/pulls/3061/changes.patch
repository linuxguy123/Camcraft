@@ -0,0 +1,106 @@
+//! Bounded SVG import (#1880): an SVG drawing read as the same 2D primitives as a DXF drawing,
+//! so the sketch chaining, nesting, profile entity and import command are shared.
+//! Provenance: the W3C SVG 1.1 Recommendation (structure, coordinate systems, paths, basic
+//! shapes and the arc implementation notes) and the CSS absolute-length table; original
+//! implementation, no vendor code or output consulted.
+//!
+//! Contract. The output is a [`Document`]: when the file states a physical size (`width` and
+//! `height` in mm, cm, in, pt, pc or px) its primitives are in millimetres and its units are
+//! [`Units::Known`] millimetres. Otherwise the size is never guessed: the units are
+//! [`Units::MissingOrUnitless`] and one drawing unit is the caller's unit, so
+//! [`crate::sketch_data::SketchData::from_dxf`] refuses the drawing until the caller states
+//! one. Y points up (the page's bottom edge on y = 0), as the drawing looks in an SVG editor.
+//! An elliptical arc that maps to a circular arc stays an analytic arc; Beziers and other
+//! ellipses become lines within [`CHORD_TOLERANCE_MM`]. Text, images, clipping, masks, styles
+//! and references to other files are not geometry: each is counted in `summary.skipped`.
+//! Malformed input is refused by name. This module has no file I/O and no application state.
+
+mod emit;
+mod number;
+mod path;
+mod shapes;
+mod transform;
+mod viewport;
+mod walk;
+mod xml;
+
+use crate::dxf::{Document, Limits, Unit, Units};
+use crate::sketch_chains::DEFAULT_JOIN_TOLERANCE;
+
+/// The largest distance of a flattened curve from the true curve, in millimetres.
+pub const CHORD_TOLERANCE_MM: f64 = 0.005;
+
+/// A refusal of an SVG file, in words a user can act on.
+#[derive(Clone, Debug, PartialEq, thiserror::Error)]
+pub enum SvgError {
+    #[error("SVG {0}")]
+    Invalid(String),
+    /// The file states its size and the caller stated a unit as well.
+    #[error(
+        "the SVG file states its size in physical units (width and height); \
+         leave the unit out, the file's size is used"
+    )]
+    SizeStated,
+}
+
+pub(crate) fn invalid(message: impl Into<String>) -> SvgError {
+    SvgError::Invalid(message.into())
+}
+
+/// [`parse_with_limits`] under the default import budget.
+pub fn parse(data: &[u8], unit: Option<Unit>) -> Result<Document, SvgError> {
+    parse_with_limits(data, unit, Limits::default())
+}
+
+/// Read an SVG file. `unit` is the caller's unit for one drawing unit of a file that states no
+/// physical size; a file that states one refuses it ([`SvgError::SizeStated`]).
+pub fn parse_with_limits(data: &[u8], unit: Option<Unit>, limits: Limits) -> Result<Document, SvgError> {
+    if data.len() > limits.max_bytes {
+        return Err(invalid(format!(
+            "file is {} bytes, larger than the import budget of {} bytes",
+            data.len(),
+            limits.max_bytes
+        )));
+    }
+    if data.starts_with(&[0x1f, 0x8b]) {
+        return Err(invalid("file is compressed (.svgz): save it as plain SVG"));
+    }
+    let text = std::str::from_utf8(data).map_err(|e| invalid(format!("file is not UTF-8 text: {e}")))?;
+    let tree = xml::parse(text.trim_start_matches('\u{feff}'), limits.max_entities)?;
+    let root = tree.nodes.first().ok_or_else(|| invalid("the file has no <svg> root element"))?;
+    let view = viewport::read(root)?;
+    if view.physical && unit.is_some() {
+        return Err(SvgError::SizeStated);
+    }
+    // The tolerances in output units: millimetres, or the caller's unit (millimetres when the
+    // caller has not answered yet; that drawing is refused for its units in any case).
+    let per_unit = match (view.physical, unit) {
+        (false, Some(u)) => u.millimeters_per_unit(),
+        _ => 1.0,
+    };
+    let sink = emit::Sink {
+        map: view.map,
+        chord: CHORD_TOLERANCE_MM / per_unit,
+        min_len: DEFAULT_JOIN_TOLERANCE * 1.5 / per_unit,
+        layer: walk::DEFAULT_LAYER.to_owned(),
+        max_vertices: limits.max_vertices,
+        out: Vec::new(),
+    };
+    let mut walk = walk::Walk {
+        tree: &tree,
+        sink,
+        summary: Default::default(),
+        max_entities: limits.max_entities,
+        max_cmds: limits.max_vertices,
+    };
+    walk.root(view.map)?;
+    walk.summary.vertices = walk.sink.out.len();
+    Ok(Document {
+        units: if view.physical { Units::Known(Unit::Millimeters) } else { Units::MissingOrUnitless },
+        layers: Vec::new(),
+        primitives: walk.sink.out,
+        annotations: Vec::new(),
+        elevation: None,
+        summary: walk.summary,
+    })
+}
diff --git a/crates/geometry/src/svg/number.rs b/crates/geometry/src/svg/number.rs
new file mode 100644
index 000000000..9c6164c13
--- /dev/null
+++ b/crates/geometry/src/svg/number.rs
@@ -0,0 +1,185 @@
+//! SVG number, flag, length and list scanning.
+//! Provenance: the W3C SVG 1.1 path-data and basic-data-type grammars (numbers that run
+//! together, single-character arc flags, CSS absolute length units at 96 px to the inch);
+//! original implementation.
+
+use super::{SvgError, invalid};
+
+/// A scanner over a list of numbers separated by white space and at most one comma.
+pub(super) struct Nums<'a> {
+    s: &'a [u8],
+    pub at: usize,
+}
+
+impl<'a> Nums<'a> {
+    pub fn new(text: &'a str) -> Self {
+        Nums { s: text.as_bytes(), at: 0 }
+    }
+
+    fn peek(&self) -> Option<u8> {
+        self.s.get(self.at).copied()
+    }
+
+    fn space(&mut self) {
+        while self.peek().is_some_and(|c| c.is_ascii_whitespace()) {
+            self.at += 1;
+        }
+    }
+
+    /// Skip white space and one optional comma.
+    pub fn sep(&mut self) {
+        self.space();
+        if self.peek() == Some(b',') {
+            self.at += 1;
+            self.space();
+        }
+    }
+
+    /// True at the end, after white space.
+    pub fn done(&mut self) -> bool {
+        self.space();
+        self.at >= self.s.len()
+    }
+
+    /// The next byte, if it is a letter (a path command).
+    pub fn letter(&mut self) -> Option<u8> {
+        self.space();
+        self.peek().filter(u8::is_ascii_alphabetic)
+    }
+
+    pub fn bump(&mut self) {
+        self.at += 1;
+    }
+
+    fn digits(&mut self) -> usize {
+        let start = self.at;
+        while self.peek().is_some_and(|c| c.is_ascii_digit()) {
+            self.at += 1;
+        }
+        self.at - start
+    }
+
+    /// One number, or `None` (cursor unmoved) when none starts here.
+    pub fn number(&mut self) -> Option<f64> {
+        self.space();
+        let start = self.at;
+        if matches!(self.peek(), Some(b'+' | b'-')) {
+            self.at += 1;
+        }
+        let whole = self.digits();
+        let mut frac = 0;
+        if self.peek() == Some(b'.') {
+            self.at += 1;
+            frac = self.digits();
+        }
+        if whole + frac == 0 {
+            self.at = start;
+            return None;
+        }
+        if matches!(self.peek(), Some(b'e' | b'E')) {
+            let mark = self.at;
+            self.at += 1;
+            if matches!(self.peek(), Some(b'+' | b'-')) {
+                self.at += 1;
+            }
+            if self.digits() == 0 {
+                self.at = mark; // "1em": the e is a unit, not an exponent
+            }
+        }
+        let text = std::str::from_utf8(self.s.get(start..self.at)?).ok()?;
+        text.parse().ok()
+    }
+
+    /// One arc flag: a single `0` or `1`.
+    pub fn flag(&mut self) -> Option<bool> {
+        self.space();
+        let flag = match self.peek()? {
+            b'0' => false,
+            b'1' => true,
+            _ => return None,
+        };
+        self.at += 1;
+        Some(flag)
+    }
+
+    /// The text after the cursor (a unit suffix).
+    pub fn tail(&self) -> &'a str {
+        std::str::from_utf8(self.s.get(self.at..).unwrap_or(&[])).unwrap_or("").trim()
+    }
+}
+
+/// A finite number, or a named refusal.
+pub(super) fn finite(v: f64, what: &str) -> Result<f64, SvgError> {
+    if v.is_finite() { Ok(v) } else { Err(invalid(format!("{what} is not a finite number"))) }
+}
+
+/// Every number of a list (`points`, `viewBox`), each finite.
+pub(super) fn list(text: &str, what: &str) -> Result<Vec<f64>, SvgError> {
+    let mut nums = Nums::new(text);
+    let mut out = Vec::new();
+    while !nums.done() {
+        let v = nums.number().ok_or_else(|| invalid(format!("{what} is not a list of numbers")))?;
+        out.push(finite(v, what)?);
+        nums.sep();
+    }
+    Ok(out)
+}
+
+/// The unit of a length.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum LenUnit {
+    None,
+    Px,
+    Mm,
+    Cm,
+    In,
+    Pt,
+    Pc,
+    /// `%`, `em` or `ex`: relative to something this reader does not know.
+    Relative,
+}
+
+impl LenUnit {
+    /// Millimetres per unit; `None` for a unitless or relative length.
+    pub fn mm(self) -> Option<f64> {
+        match self {
+            LenUnit::Px => Some(25.4 / 96.0),
+            LenUnit::Mm => Some(1.0),
+            LenUnit::Cm => Some(10.0),
+            LenUnit::In => Some(25.4),
+            LenUnit::Pt => Some(25.4 / 72.0),
+            LenUnit::Pc => Some(25.4 / 6.0),
+            LenUnit::None | LenUnit::Relative => None,
+        }
+    }
+}
+
+/// A number with an optional unit.
+pub(super) fn length(text: &str, what: &str) -> Result<(f64, LenUnit), SvgError> {
+    let mut nums = Nums::new(text);
+    let v = nums.number().ok_or_else(|| invalid(format!("{what} \"{text}\" is not a length")))?;
+    let v = finite(v, what)?;
+    let unit = match nums.tail() {
+        "" => LenUnit::None,
+        "px" => LenUnit::Px,
+        "mm" => LenUnit::Mm,
+        "cm" => LenUnit::Cm,
+        "in" => LenUnit::In,
+        "pt" => LenUnit::Pt,
+        "pc" => LenUnit::Pc,
+        "%" | "em" | "ex" => LenUnit::Relative,
+        other => return Err(invalid(format!("{what} has the unknown unit \"{other}\""))),
+    };
+    Ok((v, unit))
+}
+
+/// A length inside the drawing, in user units: an absolute unit converts at 96 px to the inch.
+/// A relative length (`%`, `em`, `ex`) is refused by name.
+pub(super) fn user_length(text: &str, what: &str) -> Result<f64, SvgError> {
+    let (v, unit) = length(text, what)?;
+    match unit {
+        LenUnit::None | LenUnit::Px => Ok(v),
+        LenUnit::Relative => Err(invalid(format!("{what} \"{text}\" is a percent or font-relative length, which is not supported"))),
+        absolute => Ok(v * absolute.mm().unwrap_or(1.0) * 96.0 / 25.4),
+    }
+}
diff --git a/crates/geometry/src/svg/path.rs b/crates/geometry/src/svg/path.rs
new file mode 100644
index 000000000..48172fc12
--- /dev/null
+++ b/crates/geometry/src/svg/path.rs
@@ -0,0 +1,145 @@
+//! SVG path data (`d`) to absolute drawing commands.
+//! Provenance: the W3C SVG 1.1 path-data grammar (M L H V C S Q T A Z, absolute and relative,
+//! implicit repeats, the S/T reflection rule and the Z current-point rule); original
+//! implementation.
+
+use super::number::{Nums, finite};
+use super::{SvgError, invalid};
+use crate::geo2d::Point2;
+
+/// One drawing command, absolute, in user units.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum Cmd {
+    Move(Point2),
+    Line(Point2),
+    Cubic(Point2, Point2, Point2),
+    Quad(Point2, Point2),
+    /// The endpoint form of an elliptical arc; `phi` in degrees.
+    Arc { rx: f64, ry: f64, phi: f64, large: bool, sweep: bool, to: Point2 },
+    Close,
+}
+
+fn add(a: Point2, b: Point2) -> Point2 {
+    Point2::new(a.x + b.x, a.y + b.y)
+}
+
+/// The reflection of `c` about `p`.
+fn reflect(c: Point2, p: Point2) -> Point2 {
+    Point2::new(2.0 * p.x - c.x, 2.0 * p.y - c.y)
+}
+
+fn bad(at: usize, why: &str) -> SvgError {
+    invalid(format!("malformed path data at byte {at}: {why}"))
+}
+
+/// One number of command `op`, or a named refusal.
+fn num(n: &mut Nums<'_>, op: u8, what: &str) -> Result<f64, SvgError> {
+    n.sep();
+    let at = n.at;
+    let v = n.number().ok_or_else(|| bad(at, &format!("{what} is missing after '{}'", op as char)))?;
+    finite(v, "a path value")
+}
+
+/// One point of command `op`, made absolute from `base`.
+fn pt(n: &mut Nums<'_>, op: u8, base: Point2) -> Result<Point2, SvgError> {
+    let x = num(n, op, "x")?;
+    let y = num(n, op, "y")?;
+    Ok(add(base, Point2::new(x, y)))
+}
+
+/// Parse `d`, refusing a malformed path by name. `max_cmds` bounds the command count.
+pub(super) fn parse(d: &str, max_cmds: usize) -> Result<Vec<Cmd>, SvgError> {
+    let mut nums = Nums::new(d);
+    let mut out: Vec<Cmd> = Vec::new();
+    let mut cur = Point2::default();
+    let mut start = Point2::default();
+    // The second control point of the last C/S, or the control point of the last Q/T.
+    let mut last_cubic: Option<Point2> = None;
+    let mut last_quad: Option<Point2> = None;
+    let mut cmd: Option<u8> = None;
+    loop {
+        if nums.done() {
+            break;
+        }
+        let letter = nums.letter();
+        let op = match (letter, cmd) {
+            (Some(l), _) => {
+                nums.bump();
+                l
+            }
+            // A number repeats the last command; after a moveto it is a lineto.
+            (None, Some(b'M')) => b'L',
+            (None, Some(b'm')) => b'l',
+            (None, Some(c)) if !matches!(c, b'Z' | b'z') => c,
+            _ => return Err(bad(nums.at, "a command letter is expected")),
+        };
+        if out.is_empty() && !matches!(op, b'M' | b'm') {
+            return Err(bad(nums.at, "path data must start with a moveto (M or m)"));
+        }
+        if out.len() >= max_cmds {
+            return Err(invalid(format!("path has more than {max_cmds} commands: larger than the import budget")));
+        }
+        let rel = op.is_ascii_lowercase();
+        let base = if rel { cur } else { Point2::default() };
+        let n = &mut nums;
+        let (next, keep_cubic, keep_quad) = match op.to_ascii_uppercase() {
+            b'M' => {
+                let p = pt(n, op, base)?;
+                start = p;
+                (Cmd::Move(p), None, None)
+            }
+            b'L' => (Cmd::Line(pt(n, op, base)?), None, None),
+            b'H' => {
+                let x = num(n, op, "x")?;
+                (Cmd::Line(Point2::new(if rel { cur.x + x } else { x }, cur.y)), None, None)
+            }
+            b'V' => {
+                let y = num(n, op, "y")?;
+                (Cmd::Line(Point2::new(cur.x, if rel { cur.y + y } else { y })), None, None)
+            }
+            b'C' => {
+                let (c1, c2, p) = (pt(n, op, base)?, pt(n, op, base)?, pt(n, op, base)?);
+                (Cmd::Cubic(c1, c2, p), Some(c2), None)
+            }
+            b'S' => {
+                let c1 = last_cubic.map_or(cur, |c| reflect(c, cur));
+                let (c2, p) = (pt(n, op, base)?, pt(n, op, base)?);
+                (Cmd::Cubic(c1, c2, p), Some(c2), None)
+            }
+            b'Q' => {
+                let (c, p) = (pt(n, op, base)?, pt(n, op, base)?);
+                (Cmd::Quad(c, p), None, Some(c))
+            }
+            b'T' => {
+                let c = last_quad.map_or(cur, |q| reflect(q, cur));
+                let p = pt(n, op, base)?;
+                (Cmd::Quad(c, p), None, Some(c))
+            }
+            b'A' => {
+                let rx = num(n, op, "rx")?;
+                let ry = num(n, op, "ry")?;
+                let phi = num(n, op, "the x-axis rotation")?;
+                n.sep();
+                let at = n.at;
+                let large = n.flag().ok_or_else(|| bad(at, "the large-arc flag must be 0 or 1"))?;
+                n.sep();
+                let at = n.at;
+                let sweep = n.flag().ok_or_else(|| bad(at, "the sweep flag must be 0 or 1"))?;
+                let to = pt(n, op, base)?;
+                (Cmd::Arc { rx, ry, phi, large, sweep, to }, None, None)
+            }
+            b'Z' => (Cmd::Close, None, None),
+            _ => return Err(bad(n.at.saturating_sub(1), &format!("'{}' is not a path command", op as char))),
+        };
+        cur = match next {
+            Cmd::Move(p) | Cmd::Line(p) | Cmd::Cubic(_, _, p) | Cmd::Quad(_, p) | Cmd::Arc { to: p, .. } => p,
+            Cmd::Close => start,
+        };
+        last_cubic = keep_cubic;
+        last_quad = keep_quad;
+        cmd = Some(op);
+        out.push(next);
+        nums.sep();
+    }
+    Ok(out)
+}
diff --git a/crates/geometry/src/svg/shapes.rs b/crates/geometry/src/svg/shapes.rs
new file mode 100644
index 000000000..5ac363caf
--- /dev/null
+++ b/crates/geometry/src/svg/shapes.rs
@@ -0,0 +1,141 @@
+//! The SVG basic shapes and paths drawn into a [`Sink`].
+//! Provenance: the W3C SVG 1.1 basic-shapes chapter (rect with the rx/ry auto and clamp rules,
+//! circle, ellipse, line, polyline, polygon) and path chapter; original implementation.
+
+use super::emit::Sink;
+use super::number::{list, user_length};
+use super::path::{self, Cmd};
+use super::xml::Node;
+use super::{SvgError, invalid};
+use crate::geo2d::Point2;
+use std::f64::consts::{FRAC_PI_2, PI, TAU};
+
+/// What drawing one element did.
+pub(super) enum Drawn {
+    Shape,
+    /// A zero size: SVG draws nothing (counted as skipped).
+    Empty,
+}
+
+fn len(node: &Node, name: &str) -> Result<f64, SvgError> {
+    let what = format!("<{}> {name}", node.name);
+    node.attr(name).map_or(Ok(0.0), |v| user_length(v, &what))
+}
+
+fn size(node: &Node, name: &str) -> Result<Option<f64>, SvgError> {
+    let what = format!("<{}> {name}", node.name);
+    let Some(v) = node.attr(name).filter(|v| v.trim() != "auto") else { return Ok(None) };
+    let v = user_length(v, &what)?;
+    if v < 0.0 {
+        return Err(invalid(format!("{what} is negative ({v})")));
+    }
+    Ok(Some(v))
+}
+
+/// Draw `node` (one of the shape elements) into `sink`; `max_cmds` bounds path data.
+pub(super) fn draw(node: &Node, sink: &mut Sink, max_cmds: usize) -> Result<Drawn, SvgError> {
+    let p = Point2::new;
+    match node.name.as_str() {
+        "line" => {
+            sink.line(p(len(node, "x1")?, len(node, "y1")?), p(len(node, "x2")?, len(node, "y2")?))?;
+        }
+        "rect" => {
+            let (x, y) = (len(node, "x")?, len(node, "y")?);
+            let (w, h) = (size(node, "width")?.unwrap_or(0.0), size(node, "height")?.unwrap_or(0.0));
+            if w == 0.0 || h == 0.0 {
+                return Ok(Drawn::Empty);
+            }
+            let (rx, ry) = match (size(node, "rx")?, size(node, "ry")?) {
+                (None, None) => (0.0, 0.0),
+                (Some(r), None) | (None, Some(r)) => (r, r),
+                (Some(a), Some(b)) => (a, b),
+            };
+            let (rx, ry) = (rx.min(w / 2.0), ry.min(h / 2.0));
+            if rx == 0.0 || ry == 0.0 {
+                let c = [p(x, y), p(x + w, y), p(x + w, y + h), p(x, y + h)];
+                for i in 0..4 {
+                    sink.line(c[i], c[(i + 1) % 4])?;
+                }
+            } else {
+                // Clockwise on the page from the top edge, each corner a quarter ellipse.
+                sink.line(p(x + rx, y), p(x + w - rx, y))?;
+                sink.ellipse(p(x + w - rx, y + ry), rx, ry, 0.0, -FRAC_PI_2, FRAC_PI_2)?;
+                sink.line(p(x + w, y + ry), p(x + w, y + h - ry))?;
+                sink.ellipse(p(x + w - rx, y + h - ry), rx, ry, 0.0, 0.0, FRAC_PI_2)?;
+                sink.line(p(x + w - rx, y + h), p(x + rx, y + h))?;
+                sink.ellipse(p(x + rx, y + h - ry), rx, ry, 0.0, FRAC_PI_2, FRAC_PI_2)?;
+                sink.line(p(x, y + h - ry), p(x, y + ry))?;
+                sink.ellipse(p(x + rx, y + ry), rx, ry, 0.0, PI, FRAC_PI_2)?;
+            }
+        }
+        "circle" | "ellipse" => {
+            let centre = p(len(node, "cx")?, len(node, "cy")?);
+            let (rx, ry) = if node.name == "circle" {
+                let r = size(node, "r")?.unwrap_or(0.0);
+                (r, r)
+            } else {
+                let (a, b) = (size(node, "rx")?, size(node, "ry")?);
+                let r = a.or(b).unwrap_or(0.0);
+                (a.unwrap_or(r), b.unwrap_or(r))
+            };
+            if rx == 0.0 || ry == 0.0 {
+                return Ok(Drawn::Empty);
+            }
+            sink.ellipse(centre, rx, ry, 0.0, 0.0, TAU)?;
+        }
+        "polyline" | "polygon" => {
+            let what = format!("<{}> points", node.name);
+            let v = list(node.attr("points").unwrap_or(""), &what)?;
+            if v.len() % 2 != 0 {
+                return Err(invalid(format!("{what} has an odd count of numbers ({})", v.len())));
+            }
+            let pts: Vec<Point2> = v.as_chunks::<2>().0.iter().map(|&[x, y]| p(x, y)).collect();
+            for pair in pts.windows(2) {
+                sink.line(pair[0], pair[1])?;
+            }
+            if let (true, Some(&last), Some(&first)) = (node.name == "polygon" && pts.len() > 2, pts.last(), pts.first()) {
+                sink.line(last, first)?;
+            }
+            if pts.len() < 2 {
+                return Ok(Drawn::Empty);
+            }
+        }
+        "path" => draw_path(node.attr("d").unwrap_or(""), sink, max_cmds)?,
+        _ => return Ok(Drawn::Empty),
+    }
+    Ok(Drawn::Shape)
+}
+
+fn draw_path(d: &str, sink: &mut Sink, max_cmds: usize) -> Result<(), SvgError> {
+    let mut cur = Point2::default();
+    let mut start = Point2::default();
+    for cmd in path::parse(d, max_cmds)? {
+        match cmd {
+            Cmd::Move(p) => {
+                start = p;
+                cur = p;
+            }
+            Cmd::Line(p) => {
+                sink.line(cur, p)?;
+                cur = p;
+            }
+            Cmd::Cubic(c1, c2, p) => {
+                sink.cubic(cur, c1, c2, p)?;
+                cur = p;
+            }
+            Cmd::Quad(c, p) => {
+                sink.quad(cur, c, p)?;
+                cur = p;
+            }
+            Cmd::Arc { rx, ry, phi, large, sweep, to } => {
+                sink.arc(cur, rx, ry, phi, large, sweep, to)?;
+                cur = to;
+            }
+            Cmd::Close => {
+                sink.line(cur, start)?;
+                cur = start;
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/crates/geometry/src/svg/transform.rs b/crates/geometry/src/svg/transform.rs
new file mode 100644
index 000000000..52a90c839
--- /dev/null
+++ b/crates/geometry/src/svg/transform.rs
@@ -0,0 +1,115 @@
+//! 2D affine transforms and the SVG `transform` attribute.
+//! Provenance: the W3C SVG 1.1 coordinate-systems chapter (the matrix form
+//! `[a c e; b d f; 0 0 1]` and the six transform functions); original implementation.
+
+use super::number::{Nums, finite};
+use super::{SvgError, invalid};
+use crate::geo2d::Point2;
+
+/// `x' = a x + c y + e`, `y' = b x + d y + f`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Affine {
+    pub a: f64,
+    pub b: f64,
+    pub c: f64,
+    pub d: f64,
+    pub e: f64,
+    pub f: f64,
+}
+
+impl Affine {
+    pub const IDENTITY: Affine = Affine { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 };
+
+    pub fn translate(x: f64, y: f64) -> Affine {
+        Affine { e: x, f: y, ..Affine::IDENTITY }
+    }
+
+    pub fn scale(x: f64, y: f64) -> Affine {
+        Affine { a: x, d: y, ..Affine::IDENTITY }
+    }
+
+    pub fn rotate_deg(deg: f64) -> Affine {
+        let (s, c) = deg.to_radians().sin_cos();
+        Affine { a: c, b: s, c: -s, d: c, e: 0.0, f: 0.0 }
+    }
+
+    /// `self` after `inner`: a point goes through `inner` first.
+    pub fn then(self, inner: Affine) -> Affine {
+        Affine {
+            a: self.a * inner.a + self.c * inner.b,
+            b: self.b * inner.a + self.d * inner.b,
+            c: self.a * inner.c + self.c * inner.d,
+            d: self.b * inner.c + self.d * inner.d,
+            e: self.a * inner.e + self.c * inner.f + self.e,
+            f: self.b * inner.e + self.d * inner.f + self.f,
+        }
+    }
+
+    pub fn apply(&self, p: Point2) -> Point2 {
+        Point2::new(self.a * p.x + self.c * p.y + self.e, self.b * p.x + self.d * p.y + self.f)
+    }
+
+    pub fn det(&self) -> f64 {
+        self.a * self.d - self.b * self.c
+    }
+
+    fn is_finite(&self) -> bool {
+        [self.a, self.b, self.c, self.d, self.e, self.f].iter().all(|v| v.is_finite())
+    }
+}
+
+/// The `transform` attribute: a list of functions applied right to left to a point.
+pub(super) fn parse(text: &str) -> Result<Affine, SvgError> {
+    let bad = |why: &str| invalid(format!("transform \"{text}\": {why}"));
+    let mut nums = Nums::new(text);
+    let mut out = Affine::IDENTITY;
+    loop {
+        nums.sep();
+        if nums.done() {
+            break;
+        }
+        let start = nums.at;
+        while nums.letter().is_some() {
+            nums.bump();
+        }
+        let name = text.get(start..nums.at).unwrap_or("").trim().to_owned();
+        if name.is_empty() {
+            return Err(bad("a transform function name is missing"));
+        }
+        nums.sep();
+        if text.as_bytes().get(nums.at) != Some(&b'(') {
+            return Err(bad("'(' is missing"));
+        }
+        nums.bump();
+        let mut args = Vec::new();
+        while let Some(v) = nums.number() {
+            args.push(finite(v, "a transform value")?);
+            nums.sep();
+        }
+        nums.done();
+        if text.as_bytes().get(nums.at) != Some(&b')') {
+            return Err(bad("')' is missing"));
+        }
+        nums.bump();
+        let step = match (name.as_str(), args.as_slice()) {
+            ("matrix", &[a, b, c, d, e, f]) => Affine { a, b, c, d, e, f },
+            ("translate", &[x]) => Affine::translate(x, 0.0),
+            ("translate", &[x, y]) => Affine::translate(x, y),
+            ("scale", &[s]) => Affine::scale(s, s),
+            ("scale", &[x, y]) => Affine::scale(x, y),
+            ("rotate", &[deg]) => Affine::rotate_deg(deg),
+            ("rotate", &[deg, cx, cy]) => {
+                Affine::translate(cx, cy).then(Affine::rotate_deg(deg)).then(Affine::translate(-cx, -cy))
+            }
+            ("skewX", &[deg]) => Affine { c: deg.to_radians().tan(), ..Affine::IDENTITY },
+            ("skewY", &[deg]) => Affine { b: deg.to_radians().tan(), ..Affine::IDENTITY },
+            _ => return Err(bad(&format!("{name} with {} values is not a transform function", args.len()))),
+        };
+        out = out.then(step);
+    }
+    // A transform that collapses the drawing onto a line or a point cannot be cut.
+    if !out.is_finite() || out.det().abs() < 1e-12 {
+        return Err(bad("the transform is singular or not finite"));
+    }
+    Ok(out)
+}
diff --git a/crates/geometry/src/svg/viewport.rs b/crates/geometry/src/svg/viewport.rs
new file mode 100644
index 000000000..8fcec145f
--- /dev/null
+++ b/crates/geometry/src/svg/viewport.rs
@@ -0,0 +1,96 @@
+//! The root `<svg>` viewport: its physical size, the `viewBox` mapping and the Y flip.
+//! Provenance: the W3C SVG 1.1 coordinate-systems chapter (`viewBox` and
+//! `preserveAspectRatio`, user units as CSS px without a viewBox) and the CSS absolute-length
+//! table (96 px to the inch); original implementation.
+
+use super::number::{LenUnit, length, list};
+use super::transform::Affine;
+use super::xml::Node;
+use super::{SvgError, invalid};
+
+/// Where user space goes.
+pub(super) struct Viewport {
+    /// User space to output space: millimetres when `physical`, else viewport units. Y is up.
+    pub map: Affine,
+    /// The file states a physical size.
+    pub physical: bool,
+}
+
+fn dimension(node: &Node, name: &str) -> Result<Option<(f64, LenUnit)>, SvgError> {
+    let Some(text) = node.attr(name) else { return Ok(None) };
+    let (v, unit) = length(text, &format!("<svg> {name}"))?;
+    if unit == LenUnit::Relative {
+        return Ok(None); // "100%": no size of its own
+    }
+    if v <= 0.0 {
+        return Err(invalid(format!("<svg> {name} \"{text}\" is a zero or negative size")));
+    }
+    Ok(Some((v, unit)))
+}
+
+/// The `preserveAspectRatio` placement of a `vw` x `vh` viewBox at (`vx`, `vy`) in a
+/// `w` x `h` viewport.
+fn fit(node: &Node, [vx, vy, vw, vh]: [f64; 4], w: f64, h: f64) -> Affine {
+    let par = node.attr("preserveAspectRatio").unwrap_or("xMidYMid meet");
+    let mut words = par.split_whitespace().filter(|w| *w != "defer");
+    let align = words.next().unwrap_or("xMidYMid");
+    let slice = words.next() == Some("slice");
+    let (sx, sy) = (w / vw, h / vh);
+    if align == "none" {
+        return Affine::scale(sx, sy).then(Affine::translate(-vx, -vy));
+    }
+    let s = if slice { sx.max(sy) } else { sx.min(sy) };
+    let share = |axis: &str, free: f64| {
+        if align.contains(&format!("{axis}Mid")) {
+            free / 2.0
+        } else if align.contains(&format!("{axis}Max")) {
+            free
+        } else {
+            0.0
+        }
+    };
+    let (tx, ty) = (share("x", w - vw * s), share("Y", h - vh * s));
+    Affine::translate(tx, ty).then(Affine::scale(s, s)).then(Affine::translate(-vx, -vy))
+}
+
+/// Read the root element's size and viewBox.
+pub(super) fn read(root: &Node) -> Result<Viewport, SvgError> {
+    let view_box = match root.attr("viewBox") {
+        None => None,
+        Some(text) => {
+            let v = list(text, "<svg> viewBox")?;
+            match *v.as_slice() {
+                [x, y, w, h] if w > 0.0 && h > 0.0 => Some([x, y, w, h]),
+                [_, _, _, _] => return Err(invalid(format!("<svg> viewBox \"{text}\" has a zero or negative size"))),
+                _ => return Err(invalid(format!("<svg> viewBox \"{text}\" must be four numbers"))),
+            }
+        }
+    };
+    let (width, height) = (dimension(root, "width")?, dimension(root, "height")?);
+    let stated = |d: Option<(f64, LenUnit)>| d.is_some_and(|(_, u)| u != LenUnit::None);
+    let physical = stated(width) || stated(height);
+    // A unitless number beside a stated unit is CSS px; alone it is no physical size.
+    let value = |d: Option<(f64, LenUnit)>| {
+        d.map(|(v, u)| if physical { v * u.mm().unwrap_or(25.4 / 96.0) } else { v })
+    };
+    let (w, h) = match (value(width), value(height), view_box) {
+        (Some(w), Some(h), _) => (Some(w), Some(h)),
+        (Some(w), None, Some([.., vw, vh])) => (Some(w), Some(w * vh / vw)),
+        (None, Some(h), Some([.., vw, vh])) => (Some(h * vw / vh), Some(h)),
+        (Some(_), None, None) => return Err(invalid("<svg> states a width but no height and no viewBox")),
+        (None, Some(_), None) => return Err(invalid("<svg> states a height but no width and no viewBox")),
+        (None, None, _) => (None, None),
+    };
+    // User space to the viewport, Y still down.
+    let (to_viewport, page_height) = match (view_box, w, h) {
+        (Some(vb), Some(w), Some(h)) => (fit(root, vb, w, h), Some(h)),
+        (Some([vx, vy, _, vh]), _, _) => (Affine::translate(-vx, -vy), Some(vh)),
+        // No viewBox: a user unit is one CSS px.
+        (None, _, h) if physical => (Affine::scale(25.4 / 96.0, 25.4 / 96.0), h),
+        (None, _, h) => (Affine::IDENTITY, h),
+    };
+    // Y up, the page's bottom edge on y = 0 (or the user-space origin when the page has no
+    // height).
+    let flip = Affine { d: -1.0, f: page_height.unwrap_or(0.0), ..Affine::IDENTITY };
+    Ok(Viewport { map: flip.then(to_viewport), physical })
+}
diff --git a/crates/geometry/src/svg/walk.rs b/crates/geometry/src/svg/walk.rs
new file mode 100644
index 000000000..6f5d80da5
--- /dev/null
+++ b/crates/geometry/src/svg/walk.rs
@@ -0,0 +1,150 @@
+//! The SVG element tree walked into sketch primitives: groups and their transforms, `use`
+//! references inside the file, layers from top-level groups, and the content that is skipped
+//! with a note.
+//! Provenance: the W3C SVG 1.1 structure chapter (g, defs, symbol, use, the `display`
+//! property) and Inkscape's public `inkscape:label` layer convention; original implementation.
+
+use super::emit::Sink;
+use super::shapes::{self, Drawn};
+use super::transform::{self, Affine};
+use super::xml::{Node, Tree};
+use super::{SvgError, invalid};
+use crate::dxf::ImportSummary;
+
+/// The deepest chain of `use` references followed.
+const MAX_USE_DEPTH: usize = 16;
+
+/// Never drawn and never noted: definitions and document furniture.
+const SILENT: &[&str] = &[
+    "defs", "symbol", "metadata", "title", "desc", "namedview", "linearGradient", "radialGradient",
+    "filter", "RDF", "perspective", "font", "font-face", "cursor",
+];
+
+/// The layer of elements outside any top-level group.
+pub(super) const DEFAULT_LAYER: &str = "0";
+
+pub(super) struct Walk<'a> {
+    pub tree: &'a Tree,
+    pub sink: Sink,
+    pub summary: ImportSummary,
+    pub max_entities: usize,
+    pub max_cmds: usize,
+}
+
+fn hidden(node: &Node) -> bool {
+    let style_none = node.attr("style").is_some_and(|s| {
+        s.split(';').any(|decl| {
+            let mut kv = decl.splitn(2, ':').map(str::trim);
+            matches!((kv.next(), kv.next()), (Some("display"), Some("none")))
+        })
+    });
+    style_none || node.attr("display").is_some_and(|d| d.trim() == "none")
+}
+
+impl<'a> Walk<'a> {
+    fn note(&mut self, kind: &str) -> Result<(), SvgError> {
+        self.count()?;
+        *self.summary.skipped.entry(kind.to_owned()).or_default() += 1;
+        Ok(())
+    }
+
+    fn count(&mut self) -> Result<(), SvgError> {
+        if self.summary.entities >= self.max_entities {
+            return Err(invalid(format!(
+                "more than {} elements: the file is larger than the import budget",
+                self.max_entities
+            )));
+        }
+        self.summary.entities += 1;
+        Ok(())
+    }
+
+    fn node(&self, index: usize) -> Option<&'a Node> {
+        self.tree.nodes.get(index)
+    }
+
+    /// Walk the children of the root element under the root transform.
+    pub fn root(&mut self, root_map: Affine) -> Result<(), SvgError> {
+        let children = self.node(0).map(|n| n.children.clone()).unwrap_or_default();
+        for child in children {
+            let layer = self.node(child).filter(|n| n.name == "g").map(|n| {
+                n.attr("inkscape:label").or_else(|| n.attr("id")).unwrap_or(DEFAULT_LAYER).to_owned()
+            });
+            self.sink.layer = layer.unwrap_or_else(|| DEFAULT_LAYER.to_owned());
+            self.element(child, root_map, 0)?;
+        }
+        Ok(())
+    }
+
+    /// Draw element `index` whose parent maps user space through `parent`.
+    fn element(&mut self, index: usize, parent: Affine, uses: usize) -> Result<(), SvgError> {
+        let Some(node) = self.node(index) else { return Ok(()) };
+        let name = node.name.clone();
+        if SILENT.contains(&name.as_str()) {
+            return Ok(());
+        }
+        if hidden(node) {
+            return self.note("hidden");
+        }
+        let map = match node.attr("transform") {
+            Some(t) => parent.then(transform::parse(t)?),
+            None => parent,
+        };
+        for attr in ["clip-path", "mask"] {
+            if node.attr(attr).is_some() {
+                self.note(attr)?;
+            }
+        }
+        match name.as_str() {
+            "g" | "a" | "switch" => {
+                for child in node.children.clone() {
+                    self.element(child, map, uses)?;
+                }
+                Ok(())
+            }
+            "use" => self.reference(node, map, uses),
+            "path" | "rect" | "circle" | "ellipse" | "line" | "polyline" | "polygon" => {
+                self.count()?;
+                let saved = std::mem::replace(&mut self.sink.map, map);
+                let drawn = shapes::draw(node, &mut self.sink, self.max_cmds);
+                self.sink.map = saved;
+                match drawn? {
+                    Drawn::Shape => Ok(()),
+                    Drawn::Empty => {
+                        self.summary.entities -= 1;
+                        self.note(&format!("{name} (empty)"))
+                    }
+                }
+            }
+            // Text, images, nested viewports, clipping and masking content, styles and the
+            // like are not cut; each is counted so the caller can say what was left out.
+            _ => self.note(&name),
+        }
+    }
+
+    /// A `use` of an element in this file: drawn at its x, y; any other reference is noted.
+    fn reference(&mut self, node: &'a Node, map: Affine, uses: usize) -> Result<(), SvgError> {
+        let href = node.attr("href").or_else(|| node.attr("xlink:href")).unwrap_or("").trim();
+        let tree = self.tree;
+        let target = href.strip_prefix('#').and_then(|id| tree.nodes.iter().position(|n| n.attr("id") == Some(id)));
+        let Some(target) = target else { return self.note("use") };
+        if uses >= MAX_USE_DEPTH {
+            return Err(invalid(format!("<use> references nest more than {MAX_USE_DEPTH} deep (a reference loop?)")));
+        }
+        let at = Affine::translate(
+            super::number::user_length(node.attr("x").unwrap_or("0"), "<use> x")?,
+            super::number::user_length(node.attr("y").unwrap_or("0"), "<use> y")?,
+        );
+        let map = map.then(at);
+        match self.node(target) {
+            // A symbol's content is drawn in place of the symbol.
+            Some(sym) if sym.name == "symbol" => {
+                for child in sym.children.clone() {
+                    self.element(child, map, uses + 1)?;
+                }
+                Ok(())
+            }
+            _ => self.element(target, map, uses + 1),
+        }
+    }
+}
diff --git a/crates/geometry/src/svg/xml.rs b/crates/geometry/src/svg/xml.rs
new file mode 100644
index 000000000..c94a9e895
--- /dev/null
+++ b/crates/geometry/src/svg/xml.rs
@@ -0,0 +1,235 @@
+//! A bounded XML reader for SVG files: elements, attributes and nesting only.
+//! Provenance: the W3C XML 1.0 syntax (tags, attributes, comments, CDATA, processing
+//! instructions, DOCTYPE, character references); original implementation.
+//!
+//! Text content is not kept. Entity references other than the five predefined ones and
+//! character references stay as written: a DOCTYPE entity is never expanded.
+
+use super::{SvgError, invalid};
+
+/// The deepest element nesting read; deeper input is refused, not followed.
+pub(super) const MAX_DEPTH: usize = 256;
+
+pub(super) struct Node {
+    /// The local name (`svg:path` reads `path`).
+    pub name: String,
+    /// Qualified attribute names (`xlink:href`, `inkscape:label`) and decoded values.
+    pub attrs: Vec<(String, String)>,
+    pub children: Vec<usize>,
+}
+
+impl Node {
+    pub fn attr(&self, name: &str) -> Option<&str> {
+        self.attrs.iter().find(|(n, _)| n == name).map(|(_, v)| v.as_str())
+    }
+}
+
+/// The element tree; node 0 is the root element.
+pub(super) struct Tree {
+    pub nodes: Vec<Node>,
+}
+
+struct Cursor<'a> {
+    text: &'a str,
+    at: usize,
+}
+
+impl Cursor<'_> {
+    fn rest(&self) -> &str {
+        self.text.get(self.at..).unwrap_or("")
+    }
+
+    fn starts(&self, prefix: &str) -> bool {
+        self.rest().starts_with(prefix)
+    }
+
+    /// Move past the next `end`, or refuse naming `what`.
+    fn skip_past(&mut self, end: &str, what: &str) -> Result<(), SvgError> {
+        let found = self.rest().find(end).ok_or_else(|| invalid(format!("unterminated {what}")))?;
+        self.at += found + end.len();
+        Ok(())
+    }
+
+    fn skip_space(&mut self) {
+        let rest = self.rest();
+        self.at += rest.len() - rest.trim_start().len();
+    }
+
+    fn name(&mut self) -> &str {
+        let rest = self.rest();
+        let len = rest.find(|c: char| c.is_whitespace() || matches!(c, '/' | '>' | '=' | '<')).unwrap_or(rest.len());
+        let start = self.at;
+        self.at += len;
+        self.text.get(start..self.at).unwrap_or("")
+    }
+
+    /// A DOCTYPE, with an internal subset in brackets if it has one.
+    fn skip_doctype(&mut self) -> Result<(), SvgError> {
+        let mut depth = 0usize;
+        let mut quote: Option<char> = None;
+        for (i, c) in self.rest().char_indices() {
+            match (quote, c) {
+                (Some(q), c) if c == q => quote = None,
+                (Some(_), _) => {}
+                (None, '"' | '\'') => quote = Some(c),
+                (None, '[') => depth += 1,
+                (None, ']') => depth = depth.saturating_sub(1),
+                (None, '>') if depth == 0 => {
+                    self.at += i + 1;
+                    return Ok(());
+                }
+                _ => {}
+            }
+        }
+        Err(invalid("unterminated DOCTYPE"))
+    }
+}
+
+/// Decode the predefined entities and character references; leave any other reference as is.
+fn decode(raw: &str) -> String {
+    let mut out = String::with_capacity(raw.len());
+    let mut rest = raw;
+    while let Some(amp) = rest.find('&') {
+        out.push_str(&rest[..amp]);
+        rest = &rest[amp..];
+        let Some(semi) = rest.find(';').filter(|&s| s <= 10) else {
+            out.push('&');
+            rest = &rest[1..];
+            continue;
+        };
+        let body = &rest[1..semi];
+        let ch = match body {
+            "lt" => Some('<'),
+            "gt" => Some('>'),
+            "amp" => Some('&'),
+            "quot" => Some('"'),
+            "apos" => Some('\''),
+            _ => body
+                .strip_prefix("#x")
+                .or_else(|| body.strip_prefix("#X"))
+                .map_or_else(|| body.strip_prefix('#').and_then(|d| d.parse().ok()), |h| u32::from_str_radix(h, 16).ok())
+                .and_then(char::from_u32),
+        };
+        match ch {
+            Some(c) => {
+                out.push(c);
+                rest = &rest[semi + 1..];
+            }
+            None => {
+                out.push('&');
+                rest = &rest[1..];
+            }
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+fn local(name: &str) -> &str {
+    name.rsplit(':').next().unwrap_or(name)
+}
+
+/// Read the element tree of `text`, refusing more than `max_elements` elements.
+pub(super) fn parse(text: &str, max_elements: usize) -> Result<Tree, SvgError> {
+    let mut cur = Cursor { text, at: 0 };
+    let mut nodes: Vec<Node> = Vec::new();
+    // Open elements: node index and qualified name.
+    let mut stack: Vec<(usize, String)> = Vec::new();
+    let mut root_done = false;
+    while let Some(lt) = cur.rest().find('<') {
+        cur.at += lt;
+        if cur.starts("<?") {
+            cur.skip_past("?>", "processing instruction")?;
+        } else if cur.starts("<!--") {
+            cur.skip_past("-->", "comment")?;
+        } else if cur.starts("<![CDATA[") {
+            cur.skip_past("]]>", "CDATA section")?;
+        } else if cur.starts("<!") {
+            cur.skip_doctype()?;
+        } else if cur.starts("</") {
+            cur.at += 2;
+            let name = cur.name().to_owned();
+            cur.skip_space();
+            if !cur.starts(">") {
+                return Err(invalid(format!("unterminated closing tag </{name}")));
+            }
+            cur.at += 1;
+            match stack.pop() {
+                Some((_, open)) if open == name => root_done = stack.is_empty(),
+                Some((_, open)) => return Err(invalid(format!("closing tag </{name}> does not match <{open}>"))),
+                None => return Err(invalid(format!("closing tag </{name}> has no opening tag"))),
+            }
+        } else {
+            cur.at += 1;
+            let qualified = cur.name().to_owned();
+            if qualified.is_empty() {
+                return Err(invalid("a '<' that starts no tag"));
+            }
+            if root_done && stack.is_empty() {
+                return Err(invalid("a second root element after the <svg> element"));
+            }
+            if nodes.len() >= max_elements {
+                return Err(invalid(format!("more than {max_elements} elements: the file is larger than the import budget")));
+            }
+            if stack.len() >= MAX_DEPTH {
+                return Err(invalid(format!("elements nested more than {MAX_DEPTH} deep")));
+            }
+            let attrs = attributes(&mut cur, &qualified)?;
+            let index = nodes.len();
+            nodes.push(Node { name: local(&qualified).to_owned(), attrs, children: Vec::new() });
+            if let Some(p) = stack.last().and_then(|(parent, _)| nodes.get_mut(*parent)) {
+                p.children.push(index);
+            }
+            if cur.starts("/>") {
+                cur.at += 2;
+                root_done |= stack.is_empty();
+            } else {
+                cur.at += 1; // '>'
+                stack.push((index, qualified));
+            }
+        }
+    }
+    if let Some((_, open)) = stack.last() {
+        return Err(invalid(format!("<{open}> is not closed")));
+    }
+    match nodes.first() {
+        Some(root) if root.name == "svg" => Ok(Tree { nodes }),
+        _ => Err(invalid("the file has no <svg> root element")),
+    }
+}
+
+/// The attributes of a start tag; leaves the cursor on `>` or `/>`.
+fn attributes(cur: &mut Cursor<'_>, tag: &str) -> Result<Vec<(String, String)>, SvgError> {
+    let mut attrs: Vec<(String, String)> = Vec::new();
+    loop {
+        cur.skip_space();
+        if cur.starts("/>") || cur.starts(">") {
+            return Ok(attrs);
+        }
+        if cur.rest().is_empty() {
+            return Err(invalid(format!("unterminated tag <{tag}")));
+        }
+        let name = cur.name().to_owned();
+        if name.is_empty() {
+            return Err(invalid(format!("unterminated tag <{tag}")));
+        }
+        cur.skip_space();
+        if !cur.starts("=") {
+            return Err(invalid(format!("attribute {name} of <{tag}> has no value")));
+        }
+        cur.at += 1;
+        cur.skip_space();
+        let quote = match cur.rest().chars().next() {
+            Some(q @ ('"' | '\'')) => q,
+            _ => return Err(invalid(format!("attribute {name} of <{tag}> must be quoted"))),
+        };
+        cur.at += 1;
+        let len = cur.rest().find(quote).ok_or_else(|| invalid(format!("unterminated tag <{tag}")))?;
+        let raw = cur.rest().get(..len).unwrap_or("");
+        let value = decode(raw);
+        cur.at += len + 1;
+        if !attrs.iter().any(|(n, _)| *n == name) {
+            attrs.push((name, value));
+        }
+    }
+}
diff --git a/crates/geometry/tests/svg.rs b/crates/geometry/tests/svg.rs
new file mode 100644
index 000000000..e6faa32bb
--- /dev/null
+++ b/crates/geometry/tests/svg.rs
@@ -0,0 +1,210 @@
+//! #1880: SVG drawings read as 2D sketch geometry - shapes, paths, curves, group transforms,
+//! units and the viewBox - and chained by the sketch chaining of #1861.
+//!
+//! Provenance: hand-written SVG fixtures from the W3C SVG 1.1 element and path grammar;
+//! the expected sizes are worked by hand. Gate map (M4.4): covers camcraft_geometry::svg and
+//! camcraft_geometry::sketch_data (from_dxf over an SVG document).
+
+use camcraft_geometry::dxf::{Primitive, Unit, Units};
+use camcraft_geometry::sketch_chains::LoopRole;
+use camcraft_geometry::sketch_data::SketchData;
+use camcraft_geometry::svg;
+
+const TOL: f64 = 1e-6;
+
+fn sketch(text: &str, unit: Option<Unit>) -> SketchData {
+    let doc = svg::parse(text.as_bytes(), unit).expect("the SVG reads");
+    SketchData::from_dxf(doc, unit, None).expect("the SVG chains")
+}
+
+fn size(data: &SketchData) -> (f64, f64, f64, f64) {
+    let (lo, hi) = data.bounds().expect("bounds");
+    (lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
+}
+
+fn near(a: f64, b: f64, tol: f64) -> bool {
+    (a - b).abs() <= tol
+}
+
+#[test]
+fn svg_rectangle_with_a_hole_in_mm_nests_and_flips_y() {
+    let text = r#"<?xml version="1.0"?>
+<!-- a plate with a hole -->
+<svg xmlns="http://www.w3.org/2000/svg" width="100mm" height="50mm" viewBox="0 0 100 50">
+  <rect x="10" y="5" width="80" height="30"/>
+  <circle cx="30" cy="15" r="5"/>
+</svg>"#;
+    let data = sketch(text, None);
+    assert_eq!(data.units().stated, Units::Known(Unit::Millimeters));
+    let chains = data.chains();
+    assert_eq!((chains.closed.len(), chains.open.len(), chains.rejected.len()), (2, 0, 0));
+    let roles: Vec<LoopRole> = chains.closed.iter().map(|c| c.nesting.clone().expect("nesting").role).collect();
+    assert!(roles.contains(&LoopRole::Outer) && roles.contains(&LoopRole::Hole), "{roles:?}");
+    // Y points down in SVG: the rectangle's top edge (y = 5) lies 45 mm up from the page bottom.
+    let (x, y, w, h) = size(&data);
+    assert!(near(x, 10.0, TOL) && near(y, 15.0, TOL) && near(w, 80.0, TOL) && near(h, 30.0, TOL), "{x} {y} {w} {h}");
+    let circle = data.primitives().iter().find_map(|p| match p.primitive {
+        Primitive::Circle { center, radius } => Some((center, radius)),
+        _ => None,
+    });
+    let (center, radius) = circle.expect("a circle stays a circle");
+    assert!(near(center.x, 30.0, TOL) && near(center.y, 35.0, TOL) && near(radius, 5.0, TOL));
+}
+
+#[test]
+fn svg_inch_and_point_documents_scale_to_mm() {
+    let inch = r#"<svg width="2in" height="1in" viewBox="0 0 200 100"><rect width="200" height="100"/></svg>"#;
+    let (_, _, w, h) = size(&sketch(inch, None));
+    assert!(near(w, 50.8, TOL) && near(h, 25.4, TOL), "{w} {h}");
+    // No viewBox: one user unit is one CSS px, 96 to the inch.
+    let px = r#"<svg width="96px" height="96px"><rect width="96" height="48"/></svg>"#;
+    let (_, _, w, h) = size(&sketch(px, None));
+    assert!(near(w, 25.4, TOL) && near(h, 12.7, TOL), "{w} {h}");
+    let pt = r#"<svg width="72pt" height="36pt" viewBox="0 0 72 36"><line x1="0" y1="0" x2="72" y2="0"/></svg>"#;
+    let (_, _, w, _) = size(&sketch(pt, None));
+    assert!(near(w, 25.4, TOL), "{w}");
+    let cm = r#"<svg width="10cm" height="5cm" viewBox="0 0 10 5"><polygon points="0,0 10,0 10,5"/></svg>"#;
+    let (_, _, w, h) = size(&sketch(cm, None));
+    assert!(near(w, 100.0, TOL) && near(h, 50.0, TOL), "{w} {h}");
+}
+
+#[test]
+fn svg_without_a_physical_size_is_never_guessed() {
+    let text = r#"<svg viewBox="0 0 40 20"><rect width="40" height="20"/></svg>"#;
+    let doc = svg::parse(text.as_bytes(), None).expect("reads");
+    assert_eq!(doc.units, Units::MissingOrUnitless);
+    let refusal = SketchData::from_dxf(doc, None, None).expect_err("no size, no unit: refused");
+    assert!(refusal.needs_units(), "{refusal}");
+    // The caller's unit is one drawing unit.
+    let (_, _, w, h) = size(&sketch(text, Some(Unit::Inches)));
+    assert!(near(w, 1016.0, TOL) && near(h, 508.0, TOL), "{w} {h}");
+    // A unitless width is not a stated size either.
+    let bare = r#"<svg width="40" height="20"><rect width="40" height="20"/></svg>"#;
+    assert_eq!(svg::parse(bare.as_bytes(), None).expect("reads").units, Units::MissingOrUnitless);
+    // A file that states its size refuses a caller's unit by name.
+    let sized = r#"<svg width="40mm" height="20mm"><rect width="40" height="20"/></svg>"#;
+    let why = svg::parse(sized.as_bytes(), Some(Unit::Inches)).expect_err("two sizes").to_string();
+    assert!(why.contains("states its size"), "{why}");
+}
+
+#[test]
+fn svg_path_commands_absolute_and_relative_give_the_same_closed_loop() {
+    let page = |d: &str| format!(r#"<svg width="100mm" height="100mm" viewBox="0 0 100 100"><path d="{d}"/></svg>"#);
+    for d in [
+        "M10 10 L60 10 L60 40 L10 40 Z",
+        "m10,10 l50,0 0,30 -50,0 z",
+        "M10 10H60V40H10Z",
+        "m10 10h50v30h-50z",
+    ] {
+        let data = sketch(&page(d), None);
+        assert_eq!(data.chains().closed.len(), 1, "{d}");
+        let (x, y, w, h) = size(&data);
+        assert!(near(x, 10.0, TOL) && near(y, 60.0, TOL) && near(w, 50.0, TOL) && near(h, 30.0, TOL), "{d}: {x} {y} {w} {h}");
+    }
+}
+
+#[test]
+fn svg_beziers_flatten_within_the_chord_tolerance_and_arcs_stay_arcs() {
+    // A circle of radius 20 drawn as two elliptical arcs stays two analytic arcs.
+    let arcs = r#"<svg width="100mm" height="100mm" viewBox="0 0 100 100">
+      <path d="M30 50 A20 20 0 0 1 70 50 A20 20 0 0 1 30 50 Z"/></svg>"#;
+    let data = sketch(arcs, None);
+    assert_eq!(data.chains().closed.len(), 1);
+    assert!(data.primitives().iter().all(|p| matches!(p.primitive, Primitive::Arc { .. })), "{:?}", data.primitives());
+    let (_, _, w, h) = size(&data);
+    assert!(near(w, 40.0, TOL) && near(h, 40.0, TOL), "{w} {h}");
+
+    // Cubic and quadratic Beziers (with the S and T shorthands) flatten to lines whose
+    // vertices lie on the curve, and the outline closes.
+    let curves = r#"<svg width="100mm" height="100mm" viewBox="0 0 100 100">
+      <path d="M10 50 C10 20 40 20 40 50 S70 80 70 50 Q85 20 90 50 T90 90 L10 90 Z"/></svg>"#;
+    let data = sketch(curves, None);
+    let chains = data.chains();
+    assert_eq!((chains.closed.len(), chains.rejected.len()), (1, 0), "{:?}", chains.rejected);
+    assert!(data.primitives().len() > 20, "the curves are flattened: {}", data.primitives().len());
+    // The first cubic peaks at y = 27.5 in SVG space (t = 0.5): 72.5 after the flip.
+    let top = data.primitives().iter().filter_map(|p| match p.primitive {
+        Primitive::Line { start, .. } if start.x <= 40.0 => Some(start.y),
+        _ => None,
+    });
+    let peak = top.fold(f64::MIN, f64::max);
+    assert!(near(peak, 72.5, svg::CHORD_TOLERANCE_MM), "{peak}");
+}
+
+#[test]
+fn svg_group_transforms_compose_and_an_ellipse_under_shear_is_flattened() {
+    let text = r#"<svg width="200mm" height="200mm" viewBox="0 0 200 200">
+      <g transform="translate(100,100)">
+        <g transform="rotate(90) scale(2)">
+          <rect x="0" y="0" width="10" height="5"/>
+        </g>
+        <circle cx="0" cy="0" r="4" transform="matrix(2 0 0 2 -50 0)"/>
+        <ellipse cx="0" cy="0" rx="10" ry="5" transform="translate(-60 -60) skewX(30)"/>
+      </g></svg>"#;
+    let data = sketch(text, None);
+    let chains = data.chains();
+    assert_eq!((chains.closed.len(), chains.rejected.len()), (3, 0), "{:?}", chains.rejected);
+    // rotate(90) scale(2): the 10 x 5 rectangle becomes 10 wide and 20 tall, left of x = 100.
+    let lines: Vec<_> = data.primitives().iter().filter_map(|p| match p.primitive {
+        Primitive::Line { start, end } => Some((start, end)),
+        _ => None,
+    }).filter(|(s, _)| s.x > 85.0).collect();
+    let xs = lines.iter().flat_map(|(s, e)| [s.x, e.x]);
+    let ys = lines.iter().flat_map(|(s, e)| [s.y, e.y]);
+    let (x0, x1) = xs.fold((f64::MAX, f64::MIN), |(a, b), v| (a.min(v), b.max(v)));
+    let (y0, y1) = ys.fold((f64::MAX, f64::MIN), |(a, b), v| (a.min(v), b.max(v)));
+    assert!(near(x0, 90.0, TOL) && near(x1, 100.0, TOL) && near(y0, 80.0, TOL) && near(y1, 100.0, TOL), "{x0} {x1} {y0} {y1}");
+    // A uniform scale keeps the circle a circle: radius 8 at (50, 100).
+    let circle = data.primitives().iter().find_map(|p| match p.primitive {
+        Primitive::Circle { center, radius } => Some((center, radius)),
+        _ => None,
+    });
+    let (center, radius) = circle.expect("circle");
+    assert!(near(center.x, 50.0, TOL) && near(center.y, 100.0, TOL) && near(radius, 8.0, TOL));
+}
+
+#[test]
+fn svg_rounded_rect_polyline_and_hidden_or_unsupported_content() {
+    let text = r##"<svg width="100mm" height="100mm" viewBox="0 0 100 100" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape">
+      <defs><rect id="tab" width="5" height="5"/></defs>
+      <g id="layer1" inkscape:label="Cut">
+        <rect x="10" y="10" width="40" height="20" rx="5"/>
+        <polyline points="60,10 70,20 80,10" fill="none" stroke="black"/>
+        <use href="#tab" x="60" y="60"/>
+      </g>
+      <text x="0" y="0">label</text>
+      <image href="photo.png" width="10" height="10"/>
+      <use xlink:href="other.svg#part"/>
+      <rect x="0" y="0" width="5" height="5" style="display:none"/>
+    </svg>"##;
+    let data = sketch(text, None);
+    let chains = data.chains();
+    assert_eq!((chains.closed.len(), chains.open.len(), chains.rejected.len()), (2, 1, 0), "{:?}", chains.rejected);
+    // A top-level group is a layer, named by its Inkscape label.
+    assert_eq!(data.layers(), ["Cut".to_owned()]);
+    let arcs = data.primitives().iter().filter(|p| matches!(p.primitive, Primitive::Arc { .. })).count();
+    assert_eq!(arcs, 4, "rx = ry corners are circular arcs");
+    let skipped = &data.summary().skipped;
+    for kind in ["text", "image", "use", "hidden"] {
+        assert_eq!(skipped.get(kind), Some(&1), "{kind}: {skipped:?}");
+    }
+}
+
+#[test]
+fn svg_bunched_curve_vertices_merge_so_no_piece_is_shorter_than_the_join_tolerance() {
+    // A cubic with both control points on its start runs as x = 10 t^3: evenly spaced t gives
+    // pieces far shorter than the 0.01 mm join tolerance near the start. They must merge.
+    let text = r#"<svg width="20mm" height="20mm" viewBox="0 0 20 20"><path d="M0 0 C0 0 0 0 10 0 L10 10 L0 10 Z"/></svg>"#;
+    let data = sketch(text, None);
+    let chains = data.chains();
+    assert_eq!((chains.closed.len(), chains.rejected.len()), (1, 0), "{:?}", chains.rejected);
+}
+
+#[test]
+fn svg_flags_and_numbers_in_compact_path_syntax() {
+    // Compact arc flags ("0 01") and numbers that run together ("10-5", ".5.5").
+    let text = r#"<svg width="100mm" height="100mm" viewBox="0 0 100 100">
+      <path d="M10,50a20,20 0 0110,0l10-5l.5.5L30.5,70L10,70z"/></svg>"#;
+    let data = sketch(text, None);
+    assert_eq!(data.chains().closed.len(), 1, "{:?}", data.chains().rejected);
+}
diff --git a/crates/geometry/tests/svg_refusals.rs b/crates/geometry/tests/svg_refusals.rs
new file mode 100644
index 000000000..57a3c7487
--- /dev/null
+++ b/crates/geometry/tests/svg_refusals.rs
@@ -0,0 +1,102 @@
+//! #1880: malformed SVG input is refused by name and never panics or hangs (Prime Directive).
+//!
+//! Provenance: hand-built malformed SVG text and deterministic byte mutations.
+//! Gate map (M4.4): covers camcraft_geometry::svg.
+
+use camcraft_geometry::dxf::Limits;
+use camcraft_geometry::svg;
+
+fn page(body: &str) -> String {
+    format!(r#"<svg width="100mm" height="100mm" viewBox="0 0 100 100">{body}</svg>"#)
+}
+
+fn refuses(text: &str, name: &str) {
+    let error = svg::parse(text.as_bytes(), None).expect_err("bad SVG must be refused").to_string();
+    assert!(error.to_lowercase().contains(&name.to_lowercase()), "{error:?} does not name {name:?}");
+}
+
+#[test]
+fn svg_malformed_documents_are_named() {
+    refuses("", "no <svg>");
+    refuses("hello", "no <svg>");
+    refuses("<html></html>", "no <svg>");
+    refuses("<svg", "unterminated");
+    refuses("<svg><g></svg>", "does not match");
+    refuses("<svg><rect/>", "not closed");
+    refuses("<svg><!-- open", "unterminated comment");
+    refuses("<svg width=100mm></svg>", "quoted");
+    let gzip: &[u8] = b"\x1f\x8b\x08\0";
+    assert!(svg::parse(gzip, None).expect_err("svgz").to_string().contains("compressed"));
+    let bad_utf8: &[u8] = b"<svg>\xff</svg>";
+    assert!(svg::parse(bad_utf8, None).expect_err("not UTF-8").to_string().contains("UTF-8"));
+}
+
+#[test]
+fn svg_malformed_paths_and_shapes_are_named() {
+    refuses(&page(r#"<path d="L10 10"/>"#), "malformed path");
+    refuses(&page(r#"<path d="M10 10 L20"/>"#), "malformed path");
+    refuses(&page(r#"<path d="M10 10 X20 20"/>"#), "malformed path");
+    refuses(&page(r#"<path d="M0 0 A0 5 0 0 1 10 10"/>"#), "degenerate arc from (0, 0) to (10, 10): a radius is zero");
+    refuses(&page(r#"<path d="M0 0 A5 5 0 2 1 10 10"/>"#), "malformed path");
+    refuses(&page(r#"<rect width="-5" height="5"/>"#), "negative");
+    refuses(&page(r#"<circle r="-1"/>"#), "negative");
+    refuses(&page(r#"<polyline points="0,0 10"/>"#), "points");
+    refuses(&page(r#"<rect width="5" height="5" transform="rotate(1 2)"/>"#), "transform");
+    refuses(&page(r#"<rect width="5" height="5" transform="scale(0)"/>"#), "transform");
+    refuses(&page(r#"<rect width="50%" height="5"/>"#), "percent");
+    refuses(&page(r#"<line x2="1e400"/>"#), "finite");
+}
+
+#[test]
+fn svg_zero_or_negative_document_sizes_are_refused() {
+    refuses(r#"<svg width="0mm" height="10mm"><rect width="1" height="1"/></svg>"#, "zero or negative");
+    refuses(r#"<svg width="10mm" height="-1mm"><rect width="1" height="1"/></svg>"#, "zero or negative");
+    refuses(r#"<svg viewBox="0 0 0 10"><rect width="1" height="1"/></svg>"#, "viewBox");
+    refuses(r#"<svg viewBox="0 0 10"><rect width="1" height="1"/></svg>"#, "viewBox");
+    refuses(r#"<svg width="10mm"><rect width="1" height="1"/></svg>"#, "no height");
+}
+
+#[test]
+fn svg_import_budget_is_enforced() {
+    let small = Limits { max_bytes: 64, max_entities: 4, max_vertices: 16 };
+    let big = page(&"<line x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"/>".repeat(4));
+    let error = svg::parse_with_limits(big.as_bytes(), None, small).expect_err("bytes").to_string();
+    assert!(error.contains("import budget"), "{error}");
+    let roomy = Limits { max_bytes: 1 << 20, ..small };
+    let many = page(&"<line x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"/>".repeat(8));
+    let error = svg::parse_with_limits(many.as_bytes(), None, roomy).expect_err("elements").to_string();
+    assert!(error.contains("import budget"), "{error}");
+    let curve = page(r#"<circle r="40" transform="scale(1 0.5)"/>"#);
+    let error = svg::parse_with_limits(curve.as_bytes(), None, roomy).expect_err("vertices").to_string();
+    assert!(error.contains("import budget"), "{error}");
+    let deep = format!("<svg width=\"1mm\" height=\"1mm\">{}{}</svg>", "<g>".repeat(5000), "</g>".repeat(5000));
+    let error = svg::parse(deep.as_bytes(), None).expect_err("depth").to_string();
+    assert!(error.contains("nested"), "{error}");
+    // A `use` that refers to itself is cut off, not followed for ever.
+    let looped = page(r##"<g id="a"><use href="#a"/><line x2="1"/></g>"##);
+    let error = svg::parse(looped.as_bytes(), None).expect_err("loop").to_string();
+    assert!(error.contains("use"), "{error}");
+}
+
+#[test]
+fn svg_deterministic_smoke_fuzz_never_panics() {
+    let seed = page(
+        r#"<g transform="translate(5 5) rotate(30)"><path d="M0 0 C10 0 10 10 0 10 S-10 20 0 20 Q5 25 10 20 T20 20 A5 3 20 1 0 30 30 Z"/>
+        <rect x="1" y="1" width="8" height="4" rx="2" ry="1"/><ellipse rx="3" ry="2"/><polygon points="0,0 4,0 4,4"/></g>"#,
+    )
+    .into_bytes();
+    for cut in 0..seed.len() {
+        let _ = svg::parse(&seed[..cut], None);
+    }
+    let mut state = 0x1880u64;
+    for _ in 0..1000 {
+        let mut bytes = seed.clone();
+        for _ in 0..4 {
+            state = state.wrapping_mul(6364136223846793005).wrapping_add(1);
+            let index = (state as usize) % bytes.len();
+            bytes[index] = (state >> 32) as u8;
+        }
+        let _ = svg::parse(&bytes, None);
+        let _ = svg::parse(&bytes, Some(camcraft_geometry::dxf::Unit::Inches));
+    }
+}
diff --git a/docs/decisions/1880-svg-import.md b/docs/decisions/1880-svg-import.md
new file mode 100644
index 000000000..993c2f672
--- /dev/null
+++ b/docs/decisions/1880-svg-import.md
@@ -0,0 +1,64 @@
+## #1880 - Import SVG drawings as 2D sketch profiles
+
+**What was decided.**
+
+- The SVG reader (`camcraft_geometry::svg`) gives the same `dxf::Document` as the DXF reader.
+  The sketch chaining, nesting, `SketchData`, the `Sketch` entity and the project file are
+  shared and do not change. The project file stores an SVG profile as it stores a DXF one.
+- The reader has its own small XML tokenizer. The rules forbid a new dependency in this PR,
+  and an SVG file needs only elements and attributes. A DOCTYPE entity is never expanded.
+- A file states a physical size when its `width` or `height` has a unit (mm, cm, in, pt, pc,
+  px). A unitless or missing size is no physical size, and the import asks for the unit of
+  one drawing unit (the DXF `MissingUnits` law). CSS reads a unitless width as px, but that
+  is a guess about the author's intent, and the issue says "never guesses silently".
+- A caller's unit for a file that states its size is refused (`SvgError::SizeStated`). For
+  DXF a caller's unit wins over the file's. For SVG two sizes would disagree silently.
+- The Y flip puts the page's bottom edge on y = 0 (y' = page height - y), so the drawing
+  sits in the first quadrant as it looks in the editor. With no height and no viewBox, the
+  flip is about the user-space origin.
+- An elliptical arc, circle or rounded-rect corner whose mapped shape is a circle stays an
+  analytic `Arc`/`Circle`. A Bezier, and an ellipse that maps to a true ellipse, becomes lines
+  within 0.005 mm (`CHORD_TOLERANCE_MM`), counted by Wang's second-difference bound. No
+  flattened vertex lies closer than 1.5 x the default join tolerance to its neighbour, so
+  chaining does not reject the short pieces.
+- A zero radius in an arc command is refused as a "degenerate arc", as the issue asks. The
+  SVG specification would draw a straight line there. An arc with equal end points draws
+  nothing, as the specification says.
+- A zero-size rect, circle or ellipse draws nothing and is counted as skipped ("rect
+  (empty)"). A negative size is refused.
+- A top-level `g` is a layer, named by `inkscape:label`, else `id`. Other elements are on
+  layer "0". Chains join only on one layer, as for DXF.
+- `use` of an element in the same file is drawn (16 levels at most, which also stops a loop).
+  A `use` of another file is skipped and counted. Text, images, nested `svg`, `style`,
+  `clip-path` and `mask` are counted by kind in `summary.skipped`. `display:none` content is
+  counted as "hidden". Fill and stroke are not read.
+- `ImportSvg` is its own command in `commands/import_svg.rs`. It wraps an `ImportDxf` value
+  (a new `ImportDxf::placed` constructor), so apply and invert are the same code. It repeats
+  the 10-line setup and stock check of `ImportDxf::build` instead of a change to `build`:
+  open PR #2773 changes those lines of `build`, and a stack on that PR would tie SVG import
+  to an unrelated Stock page feature.
+- The MCP tool is `import_svg` in a new file `mcp/svg_tools.rs`, and the script verb is
+  `cam.importSvg`. They take `import_dxf`'s options.
+
+- The missing-size refusal is a `CommandError::Needs` (a precondition the user can fix), and
+  every other SVG refusal is the one new variant `CommandError::Svg`. A typed
+  `SvgUnitsMissing` variant was dropped to keep `commands/mod.rs` (already over 400 lines)
+  from growing more.
+- The "posted 2D Contour golden" of the issue's Done means waits for #1864 (2D Contour on
+  sketches, PR #2716 open): on `main` a 2D Contour on a profile is accepted but does not
+  generate. It is filed as #3042.
+
+**Dropped.**
+
+- A shared `import_sketch` tool with a `format` field: two tools follow the file type, as
+  `import_model` and `import_dxf` do, and the DXF tool does not change.
+- Biarc fitting of Beziers (fewer, analytic segments): more code and risk; lines within
+  0.005 mm cut the same part.
+- A crate such as `roxmltree` or `usvg` (both are in `Cargo.lock` through the UI): a new
+  dependency of `camcraft-geometry` needs the maintainer.
+- Nested `<svg>` viewports, CSS stylesheets, text to outlines and embedded images: the issue
+  puts them out of scope; they are counted, not drawn.
+
+**Cost to change later.** The reader is one module behind `svg::parse`. A move to a library
+parser, or biarcs, changes only that module and its tests. Accepting a caller's unit for a
+sized file is a one-line change in `svg::parse_with_limits`.
