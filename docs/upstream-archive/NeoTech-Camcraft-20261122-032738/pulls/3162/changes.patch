@@ -0,0 +1,88 @@
+//! Provenance: our own generator refusal tests for malformed guide blocks (#2855).
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::path::PathBuf;
+
+use super::{END, PAGES, START, render, sync};
+use crate::catalog::CatalogCase;
+
+fn refuses(text: &str, message: &str) {
+    let err = render(
+        "operations/operations-2d.md",
+        text,
+        &BTreeSet::from(["Face".to_string()]),
+        &BTreeMap::new(),
+        &mut BTreeSet::new(),
+    )
+    .expect_err("malformed block must refuse");
+    assert!(err.contains(message), "got: {err}");
+}
+
+#[test]
+fn misplaced_example_markers_refuse() {
+    for marker in [START, END] {
+        refuses(&format!("# Guide\n{marker}\n"), "misplaced");
+    }
+}
+
+#[test]
+fn unclosed_example_blocks_refuse() {
+    refuses(&format!("## Face\n\n{START}\nA link\n"), "unclosed");
+}
+
+#[test]
+fn nested_markers_and_headings_inside_example_blocks_refuse() {
+    for line in [START, "## Drill"] {
+        refuses(&format!("## Face\n\n{START}\n{line}\n{END}\n"), "unclosed");
+    }
+}
+
+struct TempRoot(PathBuf);
+impl Drop for TempRoot {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+#[test]
+fn a_case_kind_without_a_guide_heading_refuses_before_writing() {
+    let tmp =
+        TempRoot(std::env::temp_dir().join(format!("catalog-no-heading-{}", std::process::id())));
+    let case_dir = tmp.0.join("examples/catalog/2d/sample");
+    fs::create_dir_all(&case_dir).expect("case dir");
+    fs::write(
+        case_dir.join("case.toml"),
+        "kinds = [\"Face\"]\nmachine = \"mill\"\nexpect = \"top\"\n",
+    )
+    .expect("metadata");
+    let registry = tmp.0.join("crates/app/src/operation");
+    fs::create_dir_all(&registry).expect("registry dir");
+    fs::write(
+        registry.join("kinds.rs"),
+        "pub const ALL: &[KindInfo] = &[\n label: \"Face\",\n    ];\n",
+    )
+    .expect("registry");
+    let guide = tmp.0.join("site/content/guide");
+    for page in PAGES {
+        let path = guide.join(page);
+        fs::create_dir_all(path.parent().expect("page parent")).expect("guide dir");
+        fs::write(path, "# Guide\n").expect("guide page");
+    }
+    let case = CatalogCase {
+        family: "2d".into(),
+        name: "sample".into(),
+        dir: case_dir,
+    };
+    let err = sync(&tmp.0, &[case], false).expect_err("uncovered kind must refuse");
+    assert!(
+        err.contains("Face") && err.contains("no operation guide heading"),
+        "got: {err}"
+    );
+    for page in PAGES {
+        assert_eq!(
+            fs::read_to_string(guide.join(page)).expect("page"),
+            "# Guide\n"
+        );
+    }
+}
diff --git a/xtask/src/catalog_metadata.rs b/xtask/src/catalog_metadata.rs
new file mode 100644
index 000000000..cf5624140
--- /dev/null
+++ b/xtask/src/catalog_metadata.rs
@@ -0,0 +1,123 @@
+//! Provenance: our own restricted, flat catalog metadata format (#2855).
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::path::Path;
+
+use regex::Regex;
+
+/// Flat TOML: quoted strings and arrays of quoted strings; no tables or escapes.
+/// Reject unsupported syntax rather than silently misreading it.
+pub fn parse(text: &str) -> Result<BTreeMap<String, Vec<String>>, String> {
+    let token = Regex::new(r#"\A([A-Za-z_]+|[=\[\],]|"[^"\\\x00-\x1f]*"|'[^'\x00-\x1f]*')"#)
+        .map_err(|e| e.to_string())?;
+    let whitespace = Regex::new(r"\A(?:\s+|#[^\n]*(?:\n|$))*").map_err(|e| e.to_string())?;
+    let mut rest = text;
+    let mut tokens = Vec::new();
+    while !rest.is_empty() {
+        if let Some(space) = whitespace.find(rest) {
+            if space.as_str().contains('\n') {
+                tokens.push("\n");
+            }
+            rest = &rest[space.end()..];
+        }
+        if rest.is_empty() {
+            break;
+        }
+        let caps = token
+            .captures(rest)
+            .ok_or("unsupported case.toml syntax (use quoted strings without escapes)")?;
+        let matched = caps.get(0).ok_or("missing metadata token")?;
+        let value = caps.get(1).ok_or("missing metadata value")?;
+        tokens.push(value.as_str());
+        rest = &rest[matched.end()..];
+    }
+    let mut input = tokens.into_iter().peekable();
+    let mut fields = BTreeMap::new();
+    while let Some(key) = input.next() {
+        if key == "\n" {
+            continue;
+        }
+        if !["kinds", "machine", "expect"].contains(&key) {
+            return Err(format!("unknown field '{key}'"));
+        }
+        if input.next() != Some("=") {
+            return Err(format!("{key}: expected '='"));
+        }
+        let mut values = Vec::new();
+        if key == "kinds" {
+            if input.next() != Some("[") {
+                return Err("kinds: expected an array of kind names".into());
+            }
+            while input.peek() != Some(&"]") {
+                while input.peek() == Some(&"\n") {
+                    input.next();
+                }
+                if input.peek() == Some(&"]") {
+                    break;
+                }
+                values.push(string(input.next())?);
+                while input.peek() == Some(&"\n") {
+                    input.next();
+                }
+                match input.peek() {
+                    Some(&",") => {
+                        input.next();
+                    }
+                    Some(&"]") => {}
+                    _ => return Err("kinds: expected ',' or ']'".into()),
+                }
+            }
+            input.next();
+        } else {
+            values.push(string(input.next())?);
+        }
+        if !matches!(input.peek(), None | Some(&"\n")) {
+            return Err(format!("{key}: expected a newline after the value"));
+        }
+        if values.is_empty() || values.iter().any(|v| v.trim().is_empty()) {
+            return Err(format!("{key}: must not be empty"));
+        }
+        if values.iter().collect::<BTreeSet<_>>().len() != values.len() {
+            return Err(format!("{key}: duplicate value"));
+        }
+        if fields.insert(key.to_string(), values).is_some() {
+            return Err(format!("duplicate field '{key}'"));
+        }
+    }
+    for key in ["kinds", "machine", "expect"] {
+        if !fields.contains_key(key) {
+            return Err(format!("missing {key}"));
+        }
+    }
+    Ok(fields)
+}
+
+fn string(value: Option<&str>) -> Result<String, String> {
+    let value = value.ok_or("expected quoted string")?;
+    if (value.starts_with('"') && value.ends_with('"'))
+        || (value.starts_with('\'') && value.ends_with('\''))
+    {
+        return Ok(value[1..value.len() - 1].to_string());
+    }
+    Err(format!("expected quoted string, got '{value}'"))
+}
+
+pub fn registry(root: &Path) -> Result<BTreeSet<String>, String> {
+    let path = root.join("crates/app/src/operation/kinds.rs");
+    let source = fs::read_to_string(&path).map_err(|e| format!("read {}: {e}", path.display()))?;
+    let rows = source
+        .split_once("pub const ALL:")
+        .and_then(|(_, tail)| tail.split_once("\n    ];"))
+        .map(|(rows, _)| rows)
+        .ok_or("cannot read KindInfo::ALL registry")?;
+    let labels = Regex::new(r#"(?m)^\s*label:\s*"([^"]+)""#).map_err(|e| e.to_string())?;
+    let out: BTreeSet<_> = labels
+        .captures_iter(rows)
+        .map(|c| c[1].to_string())
+        .collect();
+    if out.is_empty() {
+        return Err("KindInfo::ALL has no kind labels".into());
+    }
+    Ok(out)
+}
