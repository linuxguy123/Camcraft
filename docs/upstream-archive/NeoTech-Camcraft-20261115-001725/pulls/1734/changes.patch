 fn retyped(kind: OpType, top: f64, bottom: f64) -> OpParams {
     let mut p = operation::seed_params(kind.ordinal());
     match &mut p {
-        OpParams::Adaptive2D { top_z, bottom_z, .. } | OpParams::Offset2D { top_z, bottom_z, .. } => {
