--- a/assets/posts/tormach.cps
+++ b/assets/posts/tormach.cps
@@ -35,6 +35,7 @@ var sRpm = 0;              // spindle/T order follows the stream: PARAMs,
 var spindleWait = false;   // TOOL, SECTION - the preamble writes them
 var toolWait = false;      // when the first motion needs them legal
 var tNo = 0;
+var loadedTool = null;     // #1626: only the tool this program emitted M6 for is known
 var inCycle = false;       // a cycle group is open; its chain is suppressed
 var cycleSig = "";         // g|Z|R|Q of the open group (modal X Y holes)
 var cycX = 0, cycY = 0, cycR = 0; // the open group's hole XY and R plane (world, #994)
@@ -435,9 +436,14 @@ function startPreamble() {
   planeG = 17;              // the preamble states the plane
   if (toolWait) {
     toolNote();
-    retract();
-    xyUnknown = true;        // G30 (or the changer) may have moved X and Y
-    block(["T" + ni(tNo), "M6"]);
+    // The initial spindle tool is unknown. Only a repeated tool that this
+    // program already loaded can skip the trip to G30 and the tool change.
+    if (loadedTool !== tNo) {
+      retract();
+      block(["T" + ni(tNo), "M6"]);
+      loadedTool = tNo;
+    }
+    xyUnknown = true;        // restate clearance after G43/lift, even without a change
     block(["G43", "H" + ni(tNo)]);
     // #1596: Z straight up again (G53, so the G43 just applied does not
     // shift it) before the section's first X/Y or A move. The G30 above
diff --git a/crates/post/tests/tormach_same_tool.rs b/crates/post/tests/tormach_same_tool.rs
new file mode 100644
index 000000000..36abf32ff
--- /dev/null
+++ b/crates/post/tests/tormach_same_tool.rs
@@ -0,0 +1,81 @@
+//! Provenance: #1626, original tests of our stream and Tormach post contract.
+//! Gate map: covers assets/posts/tormach.cps, camcraft_post::post::engine.
+
+use camcraft_post::machine::parse_mch;
+use camcraft_post::post::{engine, machine};
+use std::path::Path;
+
+fn read(path: &str) -> String {
+    std::fs::read_to_string(
+        Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("../..")
+            .join(path),
+    )
+    .expect("fixture")
+}
+
+fn post(tools: &[u32]) -> String {
+    let mut stream = String::new();
+    for tool in tools {
+        stream.push_str(&format!(
+            "PARAM SpindleSpeed 1500\nTOOL {tool} DRILL\nPARAM ClearancePlane 25.4\nPARAM RetractPlane 12.7\nSECTION\nRapid 20000 10000 2000\nPlunge 20000 10000 -10000 F120000\nRapid 20000 10000 2000\nENDSECTION\n"
+        ));
+    }
+    let mch = parse_mch(&read("assets/machines/tormach-770mx.mch")).expect("machine");
+    let out = engine::run(
+        &read("assets/posts/tormach.cps"),
+        &machine::mirror(&mch),
+        &stream,
+    )
+    .expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    out.program
+}
+
+#[test]
+fn repeated_tool_skips_g30_and_m6_but_keeps_compensation_lift_and_clearance() {
+    let program = post(&[4, 4]);
+    let lines: Vec<_> = program.lines().collect();
+    assert_eq!(
+        lines.iter().filter(|line| **line == "G30").count(),
+        1,
+        "{program}"
+    );
+    assert_eq!(
+        lines.iter().filter(|line| **line == "T4 M6").count(),
+        1,
+        "{program}"
+    );
+    let compensation: Vec<_> = lines
+        .iter()
+        .enumerate()
+        .filter_map(|(index, line)| (*line == "G43 H4").then_some(index))
+        .collect();
+    assert_eq!(compensation.len(), 2, "{program}");
+    for index in compensation {
+        assert_eq!(lines.get(index + 1), Some(&"G53 G0 Z0"), "{program}");
+        let xy = lines[index + 1..]
+            .iter()
+            .position(|line| *line == "G0 X20 Y10")
+            .map(|offset| index + 1 + offset)
+            .expect("section traverse");
+        assert_eq!(lines.get(xy - 1), Some(&"G0 Z25.4"), "{program}");
+    }
+}
+
+#[test]
+fn a_different_tool_and_a_return_to_an_earlier_tool_each_change_again() {
+    let program = post(&[4, 4, 7, 4]);
+    let changes: Vec<_> = program
+        .lines()
+        .filter(|line| line.ends_with(" M6"))
+        .collect();
+    assert_eq!(changes, ["T4 M6", "T7 M6", "T4 M6"], "{program}");
+    assert_eq!(
+        program.lines().filter(|line| *line == "G30").count(),
+        3,
+        "{program}"
+    );
+    let first_change = program.find("T4 M6").expect("first tool change");
+    assert!(program[..first_change].contains("G30\n"), "{program}");
+}
