From deb884730be02149e386a589d1393e851aa03964 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sat, 14 Nov 2026 13:58:51 -0800
Subject: [PATCH] fix(packaging): name the hicolor icons in the RPM %files list

Commit 55c8bcc6 installs the logo in seven hicolor sizes under
/usr/share/icons/hicolor/<size>/apps/camcraft.png, but the RPM spec's
%files list did not name them, so rpmbuild stopped with "Installed (but
unpackaged) file(s) found" and the v0.20.0 release run (43644441134)
built no Linux packages. One glob line in %files covers all sizes.

Fixes #1719

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 scripts/package-linux.sh | 1 +
 1 file changed, 1 insertion(+)

diff --git a/scripts/package-linux.sh b/scripts/package-linux.sh
index e1afa8da3..f1a6a360e 100755
--- a/scripts/package-linux.sh
+++ b/scripts/package-linux.sh
@@ -121,6 +121,7 @@ cp -a "%{camcraft_package_root}/usr/." "%{buildroot}/usr/"
 /usr/lib/camcraft
 /usr/share/applications/camcraft.desktop
 /usr/share/pixmaps/camcraft.png
+/usr/share/icons/hicolor/*/apps/camcraft.png
 EOF
 rpmbuild -bb --define "_topdir $rpm_dir" \
     --define "camcraft_package_root $pkg_root" "$rpm_dir/SPECS/camcraft.spec"
