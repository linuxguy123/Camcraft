diff --git a/xtask/src/select.rs b/xtask/src/select.rs
new file mode 100644
index 000000000..ce89b17e5
--- /dev/null
+++ b/xtask/src/select.rs
@@ -0,0 +1,86 @@
+//! Step selection for `cargo xtask gate`: `--only <step>` and `--failed <gate-logs/run>` (#1702).
+//! Provenance: our own build law (AGENTS.md "Three gate tiers"); reads only our own gate logs.
+
+use std::path::Path;
+
+use crate::exec::log_name;
+use crate::plan::Plan;
+
+/// True when `name` is `word`, or starts with `word` followed by a non-word character
+/// ("kernel" selects "kernel suites"; "app" does not select "application"). Case-insensitive.
+pub fn name_matches(name: &str, word: &str) -> bool {
+    let (n, w) = (name.to_lowercase(), word.trim().to_lowercase());
+    if w.is_empty() {
+        return false;
+    }
+    match n.strip_prefix(&w) {
+        Some("") => true,
+        Some(rest) => rest.chars().next().is_some_and(|c| !(c.is_alphanumeric() || c == '_')),
+        None => false,
+    }
+}
+
+/// True when the log text of one step shows a failure: a failed libtest result, or a cargo error line.
+pub fn log_failed(text: &str) -> bool {
+    text.lines().any(|l| l.starts_with("test result: FAILED") || l.starts_with("error:"))
+}
+
+/// The step stems (log name without the `NN-` prefix and `.log`) of the failed steps of one run, from
+/// `(file name, log text)` pairs. A step without a log was never run and is not listed.
+pub fn failed_stems(logs: &[(String, String)]) -> Vec<String> {
+    let mut out = Vec::new();
+    for (file, text) in logs {
+        let Some(stem) = file.strip_suffix(".log") else { continue };
+        let Some((num, rest)) = stem.split_once('-') else { continue };
+        if num.is_empty() || !num.chars().all(|c| c.is_ascii_digit()) {
+            continue;
+        }
+        if log_failed(text) {
+            out.push(rest.to_string());
+        }
+    }
+    out
+}
+
+/// The failed step stems of the run in `dir` (a `gate-logs/<tier>-<stamp>` directory).
+pub fn failed_in_dir(dir: &Path) -> Result<Vec<String>, String> {
+    let rd = std::fs::read_dir(dir).map_err(|e| format!("--failed: cannot read {}: {e}", dir.display()))?;
+    let mut logs = Vec::new();
+    for e in rd.flatten() {
+        let file = e.file_name().to_string_lossy().into_owned();
+        if file.ends_with(".log") {
+            logs.push((file, std::fs::read_to_string(e.path()).unwrap_or_default()));
+        }
+    }
+    logs.sort();
+    let stems = failed_stems(&logs);
+    if stems.is_empty() {
+        return Err(format!("--failed: no failed step in {}", dir.display()));
+    }
+    Ok(stems)
+}
+
+/// Keeps the steps named by `only` (a step stays when any word matches) and, when `failed` is given,
+/// only those whose log stem is in it. An empty selection is an error that lists the step names.
+pub fn apply(mut plan: Plan, only: &[String], failed: Option<&[String]>) -> Result<Plan, String> {
+    if only.is_empty() && failed.is_none() {
+        return Ok(plan);
+    }
+    let all: Vec<String> = plan.steps.iter().map(|s| s.name.clone()).collect();
+    plan.steps.retain(|s| {
+        let by_only = only.is_empty() || only.iter().any(|w| name_matches(&s.name, w));
+        let stem = log_name(0, &s.name);
+        let stem = stem.split_once('-').map(|x| x.1).unwrap_or("").trim_end_matches(".log");
+        let by_failed = failed.is_none_or(|f| f.iter().any(|x| x == stem));
+        by_only && by_failed
+    });
+    if plan.steps.is_empty() {
+        return Err(format!(
+            "no step of this plan matches the selection (only: {only:?}, failed: {failed:?}); steps: {}",
+            all.join("; ")
+        ));
+    }
+    let names: Vec<&str> = plan.steps.iter().map(|s| s.name.as_str()).collect();
+    plan.notes.push(format!("selected {} of {} step(s): {}", names.len(), all.len(), names.join("; ")));
+    Ok(plan)
+}
diff --git a/xtask/src/select_tests.rs b/xtask/src/select_tests.rs
new file mode 100644
index 000000000..44b3202b7
--- /dev/null
+++ b/xtask/src/select_tests.rs
@@ -0,0 +1,86 @@
+//! Pins `--only` and `--failed` step selection and the kernel suites in batch (#1702).
+//! Provenance: our own build law (AGENTS.md "Three gate tiers").
+
+use crate::parse_gate;
+use crate::plan::{self, Plan, Step};
+use crate::select::{apply, failed_in_dir, failed_stems, log_failed, name_matches};
+
+fn a(s: &str) -> Vec<String> {
+    s.split_whitespace().map(String::from).collect()
+}
+
+fn plan3() -> Plan {
+    Plan {
+        notes: vec![],
+        steps: vec![
+            Step::new("geometry suites", &["test"], ""),
+            Step::new("kernel suites", &["test"], ""),
+            Step::new("clippy -D warnings", &["clippy"], ""),
+        ],
+    }
+}
+
+#[test]
+fn batch_runs_kernel_and_release_and_slow_list_are_unchanged() {
+    assert!(plan::BATCH_CRATES.contains(&"kernel"));
+    assert!(plan::ALL_CRATES.contains(&"kernel"));
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("..");
+    let b = plan::batch(&root);
+    assert!(b.steps.iter().any(|s| s.name.starts_with("kernel suites")));
+    let r = plan::release(&root);
+    assert!(r.steps.iter().any(|s| s.name == "kernel suites"));
+    assert!(plan::SLOW_BINARIES.iter().all(|k| !k.starts_with("kernel:")));
+}
+
+#[test]
+fn only_matches_a_whole_word_prefix() {
+    assert!(name_matches("kernel suites", "kernel"));
+    assert!(name_matches("Clippy -D warnings", "clippy"));
+    assert!(!name_matches("application suites", "app"));
+    assert!(!name_matches("kernel suites", ""));
+}
+
+#[test]
+fn only_keeps_named_steps_and_refuses_an_empty_selection() {
+    let p = apply(plan3(), &a("kernel"), None).expect("kernel");
+    assert_eq!(p.steps.len(), 1);
+    assert_eq!(p.steps[0].name, "kernel suites");
+    let p = apply(plan3(), &a("kernel clippy"), None).expect("two");
+    assert_eq!(p.steps.len(), 2);
+    assert!(apply(plan3(), &a("nothing"), None).is_err());
+    assert_eq!(apply(plan3(), &[], None).expect("all").steps.len(), 3);
+}
+
+#[test]
+fn failed_reads_the_logs_of_an_earlier_run() {
+    assert!(log_failed("running\ntest result: FAILED. 1 passed\n"));
+    assert!(log_failed("error: could not compile `x`\n"));
+    assert!(!log_failed("test result: ok. 3 passed\n"));
+    let logs = vec![
+        ("01-geometry_suites.log".to_string(), "test result: ok.\n".to_string()),
+        ("02-kernel_suites.log".to_string(), "test result: FAILED. 0 passed\n".to_string()),
+        ("notes.log".to_string(), "error: x\n".to_string()),
+    ];
+    let stems = failed_stems(&logs);
+    assert_eq!(stems, vec!["kernel_suites".to_string()]);
+    let p = apply(plan3(), &[], Some(&stems)).expect("failed");
+    assert_eq!(p.steps.len(), 1);
+    assert_eq!(p.steps[0].name, "kernel suites");
+    // --only and --failed together keep only the steps both name.
+    assert!(apply(plan3(), &a("clippy"), Some(&stems)).is_err());
+}
+
+#[test]
+fn failed_dir_that_is_missing_is_an_error() {
+    assert!(failed_in_dir(std::path::Path::new("no/such/gate-logs/dir")).is_err());
+}
+
+#[test]
+fn gate_options_parse() {
+    let g = parse_gate(&a("batch --only kernel --only clippy --dry-run")).expect("only");
+    assert_eq!(g.only, vec!["kernel".to_string(), "clippy".to_string()]);
+    let g = parse_gate(&a("release --failed gate-logs/release-1")).expect("failed");
+    assert_eq!(g.failed.as_deref(), Some("gate-logs/release-1"));
+    assert!(parse_gate(&a("batch --only")).is_err());
+    assert!(parse_gate(&a("test op_area --only kernel")).is_err());
+}
