diff --git a/crates/app/src/operation/keep_law.rs b/crates/app/src/operation/keep_law.rs
index 3060a62ec..b7780bf49 100644
--- a/crates/app/src/operation/keep_law.rs
+++ b/crates/app/src/operation/keep_law.rs
@@ -252,3 +252,22 @@ pub(super) fn kept_parts_named(
         .filter_map(|(name, e)| crate::setup_align::facets_in(world, &e, setup).map(|f| (name, f)))
