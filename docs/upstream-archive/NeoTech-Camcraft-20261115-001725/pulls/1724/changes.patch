+            ("heights_page.rs", include_str!("../heights_page.rs")),
+            ("feeds_page.rs", include_str!("../feeds_page.rs")),
+            ("geo_page.rs", include_str!("../geo_page.rs")),
+            ("boundary.rs", include_str!("../boundary.rs")),
+        ],
