+    Family {
+        name: "setup and fixtures",
+        max_raw: 245,
+        sources: &[
+            ("setup_pages.rs", include_str!("../setup_pages.rs")),
+            ("setup_settings_page.rs", include_str!("../setup_settings_page.rs")),
+            ("setup_post_page.rs", include_str!("../setup_post_page.rs")),
