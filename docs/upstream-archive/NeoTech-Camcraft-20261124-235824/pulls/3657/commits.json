[
  {
    "sha": "711314efdf67c5f7f222261529e5276bd1dd1f85",
    "node_id": "C_kwDOV1WsOtoAKDcxMTMxNGVmZGY2N2M1ZjdmMjIyMjYxNTI5ZTUyNzZiZDFkZDFmODU",
    "commit": {
      "author": {
        "name": "Mike Kinney",
        "email": "mike.kinney@gmail.com",
        "date": "2026-11-16T20:42:14Z"
      },
      "committer": {
        "name": "Mike Kinney",
        "email": "mike.kinney@gmail.com",
        "date": "2026-11-16T20:42:14Z"
      },
      "message": "feat(gcode): add camcraft-gcode crate for RS-274/ISO 6983 3-axis milling\n\nImplements pure-Rust 3-axis RS-274/NGC and ISO 6983 parsing into\n`cl::Toolpath` sections and 1-based line maps depending only on\n`camcraft-cl`, `camcraft-geometry`, and `thiserror`.\n\nIncludes dialect presets, modal group tracking, I/J/K and signed R arcs\nin G17/G18/G19, canned cycle expansion (G73/G81/G82/G83/G84/G85/G86/G89\nwith G98/G99 and L repeats), tool-change section splits, G53/G28/G30\nreference moves, named line-numbered refusals, pinning tests, xtask crate\nlist registration, and docs/decisions/2217-camcraft-gcode.md.\n\nPart of #2217 (held before PR: upstream/main fails batch build on #2244)",
