From ee24e1c73ef99a8923bb4565b4f19ae539eb004f Mon Sep 17 00:00:00 2001
From: Quintin Smits <qd.smits@gmail.com>
Date: Tue, 24 Nov 2026 22:51:21 +0100
Subject: [PATCH 5/5] fix(tools): a short-flute flat or ball taper meridian
 steps out to the full radius

A flute that ends on the cone (flute length under the height where the
cone meets the diameter) now ends its meridian with the radial shoulder
at the flute top, as Tool::profile draws it. Before, the meridian of a
6 mm, 90 degree taper with a 1 mm flat tip and a 1 mm flute ended at
r = 1.5 mm, and the profile at r = 3 mm (#3929 review, finding 1).
A sharp taper keeps its meridian bit for bit.

Pinned by taper::tests::short_flat_profile_and_meridian_agree,
taper::tests::short_ball_profile_and_meridian_agree, and two short-flute
tools in meridian::tests::a_flat_and_a_ball_taper_meridian_agrees_with_the_profile.

BREAKING CHANGE: a project that holds a flat or ball taper tip is
written as .camproj version 79, and older CamCraft builds refuse that
file. A project with only sharp tips stays version 78 and opens in
older builds as before. A tool library with a flat or ball tip is
written as .camtools version 6.
Fixes #3368
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/tools/src/meridian_tests.rs |  3 +++
 crates/tools/src/taper.rs          |  9 +++++++--
 crates/tools/src/taper_tests.rs    | 31 ++++++++++++++++++++++++++++++
 3 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/crates/tools/src/meridian_tests.rs b/crates/tools/src/meridian_tests.rs
index b5d369963..fdd84c2c4 100644
--- a/crates/tools/src/meridian_tests.rs
+++ b/crates/tools/src/meridian_tests.rs
@@ -354,6 +354,9 @@ fn a_flat_and_a_ball_taper_meridian_agrees_with_the_profile() {
         Tool { tip_form: TaperTip::Flat, tip_diameter: 4.0, ..mill(ToolKind::Taper, 10.0, 0.5, 60.0, 15.0) },
         Tool { tip_form: TaperTip::Ball, ..mill(ToolKind::Taper, 1.7, 0.5, 2.0, 20.0) },
         Tool { tip_form: TaperTip::Ball, ..mill(ToolKind::Taper, 6.0, 1.0, 90.0, 8.0) },
+        // Short flutes that end on the cone (#3929 review): the radial shoulder.
+        Tool { tip_form: TaperTip::Flat, tip_diameter: 1.0, ..mill(ToolKind::Taper, 6.0, 0.0, 90.0, 1.0) },
+        Tool { tip_form: TaperTip::Ball, ..mill(ToolKind::Taper, 6.0, 0.5, 90.0, 1.0) },
     ];
     for t in tools {
         let m = t.meridian().unwrap_or_else(|e| panic!("{t:?}: {e}"));
diff --git a/crates/tools/src/taper.rs b/crates/tools/src/taper.rs
index e4de55228..7c20c7f09 100644
--- a/crates/tools/src/taper.rs
+++ b/crates/tools/src/taper.rs
@@ -259,10 +259,15 @@ pub(crate) fn meridian_points(t: &Tool, r: f64, fl: f64) -> Option<Vec<SpunPoint
         p.push(SpunPoint::line(g.z_t, g.r_t));
     }
     let top = g.cone_z(r).min(fl);
+    let mut top_r = 0.0;
     if top > g.z_t {
-        p.push(SpunPoint::line(top, (g.r0 + top * g.tan_half).min(r)));
+        top_r = (g.r0 + top * g.tan_half).min(r);
+        p.push(SpunPoint::line(top, top_r));
     }
-    if fl > top {
+    // A flute that ends on the cone steps out to the full radius at its
+    // top, as `Tool::profile` draws it (#3929 review): the straight side
+    // above the cone, or the radial shoulder of a short flute.
+    if fl > top || r - top_r > 1e-9 {
         p.push(SpunPoint::line(fl, r));
     }
     Some(p)
diff --git a/crates/tools/src/taper_tests.rs b/crates/tools/src/taper_tests.rs
index 36adbcff5..2bccffc69 100644
--- a/crates/tools/src/taper_tests.rs
+++ b/crates/tools/src/taper_tests.rs
@@ -145,3 +145,34 @@ fn the_words_round_trip() {
     assert_eq!(TaperTip::from_word("round"), None);
     assert_eq!(TaperTip::default(), TaperTip::Sharp);
 }
+
+/// The widest radius the drawn profile reaches at the flute top, and the
+/// last point of the meridian: a short flute ends on the cone, and both
+/// must step out to the full radius there.
+fn flute_top_radii(t: &Tool) -> (f64, (f64, f64)) {
+    let fl = t.flute_len;
+    let prof = t.profile().into_iter().filter(|q| near(q.0, fl)).fold(0.0, |m: f64, q| m.max(q.1));
+    let m = t.meridian().unwrap_or_else(|e| panic!("{t:?}: {e}"));
+    let last = m.points().last().map(|p| (p.z, p.r)).unwrap_or_default();
+    (prof, last)
+}
+
+#[test]
+fn short_flat_profile_and_meridian_agree() {
+    // The cone of a 1 mm flat tip reaches the 3 mm radius 2.5 mm up; the
+    // flute ends 1 mm up, on the cone.
+    let t = taper(6.0, 90.0, 1.0, TaperTip::Flat, 1.0, 0.0);
+    assert_eq!(t.why_not_sane(), None);
+    let (prof, last) = flute_top_radii(&t);
+    assert!(near(prof, 3.0), "the profile's flute top: {prof}");
+    assert!(near(last.0, 1.0) && near(last.1, prof), "the meridian ends at {last:?}, the profile at r {prof}");
+}
+
+#[test]
+fn short_ball_profile_and_meridian_agree() {
+    let t = taper(6.0, 90.0, 1.0, TaperTip::Ball, 0.0, 0.5);
+    assert_eq!(t.why_not_sane(), None);
+    let (prof, last) = flute_top_radii(&t);
+    assert!(near(prof, 3.0), "the profile's flute top: {prof}");
+    assert!(near(last.0, 1.0) && near(last.1, prof), "the meridian ends at {last:?}, the profile at r {prof}");
+}
