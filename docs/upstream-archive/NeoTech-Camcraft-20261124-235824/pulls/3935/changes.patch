diff --git a/crates/ui/src/egui_app/tool_library_dialog/recipes_fill.rs b/crates/ui/src/egui_app/tool_library_dialog/recipes_fill.rs
new file mode 100644
index 000000000..58fbb2cb4
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/recipes_fill.rs
@@ -0,0 +1,164 @@
+//! #3896 (U5 of #3663): the arithmetic of the Recipes tab, over the
+//! window's draft only. Surface speed and feed per tooth are read from a
+//! row; "Suggest" and "Copy from tool" write the draft and queue nothing.
+//! Apply lands the draft as one `ChangeTool`, as for every other tool
+//! number.
+//! Provenance: the handbook relations Vc = pi x D x n / 1000 and
+//! fz = F / (n x z), and the cutting table of `camcraft_tools::cutting`
+//! through `camcraft_app::cutting::compute`; no HSMWorks material involved.
+
+use camcraft_app::cutting;
+use camcraft_app::machine::Machine;
+use camcraft_app::tool_cutting_rows::CuttingRow;
+use camcraft_app::tools::{ToolKind, WorkMaterial};
+
+use crate::state::{ToolUi, is_spun_kind};
+
+/// A rotating cutter: its rows have a spindle speed that the tool's own
+/// diameter turns into a surface speed. A lathe steel's surface speed is
+/// the work's diameter (its own turning data), and a torch, nozzle,
+/// electrode, wire or probe turns no spindle.
+#[must_use]
+pub(crate) fn rotating(kind: ToolKind) -> bool {
+    is_spun_kind(kind)
+        && !matches!(
+            kind,
+            ToolKind::Torch | ToolKind::Waterjet | ToolKind::Electrode | ToolKind::Wire | ToolKind::Probe
+        )
+}
+
+/// Surface speed, m/min: Vc = pi x D x n / 1000. `None` when the
+/// diameter or the spindle speed is not above zero.
+#[must_use]
+pub(crate) fn surface_speed(d: f64, rpm: f64) -> Option<f64> {
+    (d > 0.0 && rpm > 0.0 && d.is_finite() && rpm.is_finite())
+        .then(|| std::f64::consts::PI * d * rpm / 1000.0)
+}
+
+/// Feed per tooth, mm: fz = F / (n x z). `None` when the spindle speed
+/// is not above zero, or the flute count is not stated.
+#[must_use]
+pub(crate) fn feed_per_tooth(feed: f64, rpm: f64, flutes: Option<u32>) -> Option<f64> {
+    let z = flutes.filter(|z| *z > 0)?;
+    (rpm > 0.0 && rpm.is_finite() && feed.is_finite()).then(|| feed / (rpm * f64::from(z)))
+}
+
+/// Whether `rows` has a plain row that names material `m`.
+#[must_use]
+pub(crate) fn names_material(rows: &[CuttingRow], m: WorkMaterial) -> bool {
+    rows.iter().any(|r| r.material == Some(m) && !r.is_recipe())
+}
+
+/// Whether `row` is the row the document's material runs: the plain row
+/// that names it, else (`named` is false) the tool's default (`Unknown`)
+/// row. No row is marked when no material is stated.
+#[must_use]
+pub(crate) fn is_marked(row: &CuttingRow, doc: Option<WorkMaterial>, named: bool) -> bool {
+    match doc {
+        None => false,
+        Some(m) if named => row.material == Some(m) && !row.is_recipe(),
+        Some(_) => row.is_unknown(),
+    }
+}
+
+/// Why "Suggest" cannot speak for the draft, by name; `None` when it can.
+#[must_use]
+pub(crate) fn suggest_refusal(t: &ToolUi) -> Option<String> {
+    let kind = t.tool_kind();
+    if !cutting::tabulated(kind) {
+        return Some(format!(
+            "the cutting-data table speaks for end, ball, bull nose and chamfer mills, not for a {kind}"
+        ));
+    }
+    if !(t.diameter > 0.0 && t.diameter.is_finite()) {
+        return Some("the diameter must be above zero".into());
+    }
+    if t.tool_material.is_none() {
+        return Some("state the tool material (HSS or carbide) first".into());
+    }
+    if t.flutes.is_none_or(|z| z == 0) {
+        return Some("state the flute count first".into());
+    }
+    None
+}
+
+/// "Suggest": the table's spindle speed and feed for material `m` go
+/// into the draft's row for `m` (a new row when the draft has none). The
+/// row's stepdown and stepover stay. The machine's stated spindle range
+/// and feed ceiling clamp the numbers, as on the operation page. Writes
+/// only the draft; `Err` names why the table cannot speak.
+pub(crate) fn suggest(t: &mut ToolUi, m: WorkMaterial, machine: Option<&Machine>) -> Result<(), String> {
+    if let Some(why) = suggest_refusal(t) {
+        return Err(why);
+    }
+    let (Some(tm), Some(z)) = (t.tool_material, t.flutes) else {
+        return Err("state the tool material and the flute count first".into());
+    };
+    let s = cutting::compute(&t.name, &t.to_tool(), z, tm, m, None, machine);
+    if !(s.rpm > 0.0 && s.feed > 0.0) {
+        return Err(format!("the table gives no speed for {}", m.label()));
+    }
+    match t.cutting.iter_mut().find(|r| r.material == Some(m) && !r.is_recipe()) {
+        Some(row) => {
+            row.rpm = s.rpm;
+            row.feed = s.feed;
+        }
+        None => t.cutting.push(CuttingRow::plain(Some(m), s.rpm, s.feed)),
+    }
+    Ok(())
+}
+
+/// The rows "Copy from tool" takes: the plain material rows. The source's
+/// default row is its own running speed, and a torch or nozzle recipe
+/// belongs to its kind.
+pub(crate) fn copyable(rows: &[CuttingRow]) -> impl Iterator<Item = &CuttingRow> {
+    rows.iter().filter(|r| r.material.is_some() && !r.is_recipe())
+}
+
+/// "Copy from tool": each plain material row of `from` replaces the
+/// draft's row for the same material, or is added. The draft's default
+/// row, its recipes and its rows of other materials stay. Returns the
+/// count of rows copied.
+pub(crate) fn copy_rows(t: &mut ToolUi, from: &[CuttingRow]) -> usize {
+    let mut n = 0;
+    for src in copyable(from) {
+        match t.cutting.iter_mut().find(|r| r.material == src.material && !r.is_recipe()) {
+            Some(row) => *row = *src,
+            None => t.cutting.push(*src),
+        }
+        n += 1;
+    }
+    n
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn surface_speed_and_feed_per_tooth_follow_the_handbook_relations() {
+        let vc = surface_speed(10.0, 10_000.0).unwrap_or_default();
+        assert!((vc - 314.159).abs() < 1e-3, "{vc}");
+        let fz = feed_per_tooth(1200.0, 10_000.0, Some(3)).unwrap_or_default();
+        assert!((fz - 0.04).abs() < 1e-12, "{fz}");
+        assert_eq!(surface_speed(0.0, 1000.0), None);
+        assert_eq!(feed_per_tooth(1200.0, 0.0, Some(3)), None);
+        assert_eq!(feed_per_tooth(1200.0, 1000.0, None), None);
+        assert_eq!(feed_per_tooth(1200.0, 1000.0, Some(0)), None);
+    }
+
+    #[test]
+    fn the_marked_row_falls_back_to_the_default_row() {
+        let rows = [
+            CuttingRow::plain(None, 9000.0, 900.0),
+            CuttingRow::plain(Some(WorkMaterial::Brass), 8000.0, 800.0),
+        ];
+        let marks = |doc: Option<WorkMaterial>| -> Vec<bool> {
+            let named = doc.is_some_and(|m| names_material(&rows, m));
+            rows.iter().map(|r| is_marked(r, doc, named)).collect()
+        };
+        assert_eq!(marks(Some(WorkMaterial::Brass)), [false, true]);
+        assert_eq!(marks(Some(WorkMaterial::MildSteel)), [true, false], "no row names it: the default row runs");
+        assert_eq!(marks(None), [false, false]);
+    }
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/recipes_tab.rs b/crates/ui/src/egui_app/tool_library_dialog/recipes_tab.rs
new file mode 100644
index 000000000..c375e1215
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/recipes_tab.rs
@@ -0,0 +1,211 @@
+//! #3896 (U5 of #3663): the Recipes tab of the tool library window's
+//! editor - the tool's speeds and feeds for each workpiece material. It
+//! draws the same rows as Properties' Cutting data group
+//! (`tool_cutting_rows::cutting_rows_with`), with read-only columns for
+//! the surface speed and the feed per tooth, and a mark on the row that
+//! the document's material runs. "Suggest" fills a row from the cutting
+//! table and "Copy from tool" takes the rows of another tool. Both write
+//! the window's draft only: the editor's one Apply lands it as
+//! `ChangeTool`, one undo step. No command is new.
+//! Provenance: our own tab over the tool draft and the handbook relations
+//! in `recipes_fill`; no HSMWorks material involved.
+
+use egui::{Id, RichText, Ui};
+
+use camcraft_app::cutting;
+use camcraft_app::model;
+use camcraft_app::tool_cutting_rows::CuttingRow;
+use camcraft_app::tools::{ToolKind, ToolMaterial, WorkMaterial};
+use camcraft_app::units::Unit;
+
+use super::super::fields::combo;
+use super::super::layout::{prop_row, prop_row_hint};
+use super::super::tool_cutting_rows::{Extra, cutting_rows, cutting_rows_with};
+use super::recipes_fill::{
+    copy_rows, copyable, feed_per_tooth, is_marked, names_material, rotating, suggest, suggest_refusal,
+    surface_speed,
+};
+use crate::state::{State, ToolUi};
+
+/// The tab's name, and its AccessKit label.
+pub(crate) const TAB: &str = "Recipes";
+/// The mark on the row that the document's material runs.
+pub(crate) const MARK: &str = "document material";
+/// The button that fills a row from the cutting table.
+pub(crate) const SUGGEST: &str = "Suggest";
+/// The button that copies the rows of another tool.
+pub(crate) const COPY: &str = "Copy from tool";
+
+/// The flute counts the combo offers; a stated count outside it is shown
+/// as its own entry and never rewritten (the operation page's rule).
+const FLUTES: [u32; 7] = [1, 2, 3, 4, 5, 6, 8];
+
+pub(super) fn draw(ui: &mut Ui, state: &mut State) {
+    let kind = state.tool_ui.tool_kind();
+    if kind == ToolKind::Wire {
+        note(ui, "An EDM wire has no cutting rows: its cut is the machine's EDM condition.");
+        return;
+    }
+    let u = state.units();
+    let torch = matches!(kind, ToolKind::Torch | ToolKind::Waterjet);
+    if !rotating(kind) {
+        cutting_rows(ui, &mut state.tool_ui, u, torch);
+        return;
+    }
+    let doc = cutting::material_of(&state.world);
+    edge_rows(ui, &mut state.tool_ui);
+    suggest_row(ui, state, doc);
+    copy_row(ui, state);
+    note(ui, &match doc {
+        Some(m) => format!("Document material: {}. The marked row is the one its operations run.", m.label()),
+        None => "No workpiece material is stated (an operation's Feeds tab sets it), so no row is marked.".to_owned(),
+    });
+    let t = &state.tool_ui;
+    let (d, z) = (t.diameter, t.flutes);
+    let named = doc.is_some_and(|m| names_material(&t.cutting, m));
+    let cells = move |ui: &mut Ui, row: &CuttingRow| {
+        ui.label(surface_speed(d, row.rpm).map_or_else(|| "-".to_owned(), |vc| vc_text(vc, u)));
+        match feed_per_tooth(row.feed, row.rpm, z) {
+            Some(fz) => ui.label(fz_text(fz, u)),
+            None => ui.label("-").on_hover_text("needs a spindle speed and a stated flute count"),
+        };
+        if is_marked(row, doc, named) {
+            ui.label(RichText::new(MARK).strong())
+                .on_hover_text("the row that operations on the document's workpiece material run");
+        } else {
+            ui.label("");
+        }
+    };
+    let extra = Extra { heads: heads(u), cells: &cells };
+    cutting_rows_with(ui, &mut state.tool_ui, u, false, Some(&extra));
+}
+
+/// A dimmed line of the tab (the form's `hint` would turn into the
+/// tooltip of the row above).
+fn note(ui: &mut Ui, text: &str) {
+    ui.add(egui::Label::new(RichText::new(text).weak()).wrap());
+}
+
+/// The read-only column heads, in the document's units.
+fn heads(u: Unit) -> Vec<String> {
+    let (vc, fz) = match u {
+        Unit::Millimeters => ("Vc (m/min)", "fz (mm)"),
+        Unit::Inches => ("Vc (sfm)", "fz (in)"),
+    };
+    vec![vc.to_owned(), fz.to_owned(), String::new()]
+}
+
+/// Surface speed: m/min, or surface feet per minute in an inch document.
+fn vc_text(vc: f64, u: Unit) -> String {
+    match u {
+        Unit::Millimeters => format!("{vc:.0}"),
+        Unit::Inches => format!("{:.0}", vc * 1000.0 / 304.8),
+    }
+}
+
+/// Feed per tooth: mm, or inch in an inch document.
+fn fz_text(fz: f64, u: Unit) -> String {
+    match u {
+        Unit::Millimeters => format!("{fz:.3}"),
+        Unit::Inches => format!("{:.4}", fz / 25.4),
+    }
+}
+
+/// The tool's edge material and flute count: the inputs of the feed per
+/// tooth and of "Suggest". Draft fields; Apply lands them.
+fn edge_rows(ui: &mut Ui, t: &mut ToolUi) {
+    let tm_names = ["Not stated", ToolMaterial::Hss.label(), ToolMaterial::Carbide.label()];
+    let mut tm = t.tool_material.map_or(0, |m| m as usize + 1);
+    prop_row_hint(ui, "Tool material", "the cutting edge's material; the table's speeds depend on it", |ui| {
+        combo(ui, "tool_recipes_tool_material", &mut tm, &tm_names)
+    });
+    t.tool_material = tm.checked_sub(1).and_then(|i| ToolMaterial::ALL.get(i).copied());
+    let odd = t.flutes.filter(|z| !FLUTES.contains(z));
+    let names: Vec<String> = std::iter::once("Not stated".to_owned())
+        .chain(FLUTES.iter().chain(odd.iter()).map(u32::to_string))
+        .collect();
+    let refs: Vec<&str> = names.iter().map(String::as_str).collect();
+    let mut z = match (odd, t.flutes) {
+        (Some(_), _) => names.len() - 1,
+        (None, Some(n)) => FLUTES.iter().position(|f| *f == n).map_or(0, |i| i + 1),
+        (None, None) => 0,
+    };
+    prop_row(ui, "Flutes", |ui| combo(ui, "tool_recipes_flutes", &mut z, &refs));
+    t.flutes = names.get(z).and_then(|n| n.parse::<u32>().ok());
+}
+
+/// "Suggest for <material>": fills that material's row from the cutting
+/// table, clamped to the document machine's stated limits.
+fn suggest_row(ui: &mut Ui, state: &mut State, doc: Option<WorkMaterial>) {
+    let id = Id::new("tool_recipes_suggest_for");
+    let fallback = doc.map_or(0, |m| m as usize);
+    let mut idx = ui.data(|d| d.get_temp::<usize>(id)).unwrap_or(fallback);
+    let before = idx;
+    let labels: Vec<&str> = WorkMaterial::ALL.iter().map(|m| m.label()).collect();
+    let refusal = suggest_refusal(&state.tool_ui);
+    let clicked = prop_row_hint(ui, "Suggest for", "fill this material's row from the cutting table; Apply writes it", |ui| {
+        let b = ui
+            .add_enabled(refusal.is_none(), egui::Button::new(SUGGEST))
+            .on_hover_text("the table's spindle speed and feed for this tool on this material")
+            .on_disabled_hover_text(refusal.as_deref().unwrap_or_default())
+            .clicked();
+        combo(ui, "tool_recipes_suggest_for", &mut idx, &labels);
+        b
+    });
+    if idx != before {
+        ui.data_mut(|d| d.insert_temp(id, idx));
+    }
+    let Some(m) = WorkMaterial::ALL.get(idx).copied() else {
+        return;
+    };
+    if clicked {
+        let machine = camcraft_app::machine::of_setup(&state.world, None).1;
+        state.status = match suggest(&mut state.tool_ui, m, machine.as_ref()) {
+            Ok(()) => format!("{} row suggested - Apply writes it to the tool", m.label()),
+            Err(why) => format!("No suggestion: {why}"),
+        };
+    }
+}
+
+/// "Copy from tool": another document tool's material rows into the draft.
+fn copy_row(ui: &mut Ui, state: &mut State) {
+    let me = state.tool_ui.name.clone();
+    let others: Vec<String> = state.tool_names().into_iter().filter(|n| *n != me).collect();
+    let id = Id::new("tool_recipes_copy_from");
+    let kept = ui.data(|d| d.get_temp::<String>(id));
+    let mut idx = kept.and_then(|k| others.iter().position(|n| *n == k)).unwrap_or(0);
+    let before = idx;
+    let source = others.get(idx).cloned();
+    let rows: Vec<CuttingRow> = source
+        .as_deref()
+        .and_then(|n| model::find_by_name(&state.world, n))
+        .and_then(|e| model::tool_of(&state.world, &e))
+        .map(|t| copyable(&t.cutting).copied().collect())
+        .unwrap_or_default();
+    let why = match &source {
+        None => Some("no other tool is in the document".to_owned()),
+        Some(n) if rows.is_empty() => Some(format!("tool {n} has no material rows")),
+        Some(_) => None,
+    };
+    let names: Vec<&str> = others.iter().map(String::as_str).collect();
+    let clicked = prop_row_hint(ui, "Copy from", "the other tool's material rows replace or join this draft's", |ui| {
+        let b = ui
+            .add_enabled(why.is_none(), egui::Button::new(COPY))
+            .on_hover_text("copy the material rows into this draft; Apply writes them")
+            .on_disabled_hover_text(why.as_deref().unwrap_or_default())
+            .clicked();
+        if !names.is_empty() {
+            combo(ui, "tool_recipes_copy_from", &mut idx, &names);
+        }
+        b
+    });
+    if idx != before
+        && let Some(n) = others.get(idx)
+    {
+        ui.data_mut(|d| d.insert_temp(id, n.clone()));
+    }
+    if clicked && let Some(n) = source {
+        let count = copy_rows(&mut state.tool_ui, &rows);
+        state.status = format!("{count} rows copied from tool {n} - Apply writes them to the tool");
+    }
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/tool_tab.rs b/crates/ui/src/egui_app/tool_library_dialog/tool_tab.rs
index aee28836d..22d5351f1 100644
--- a/crates/ui/src/egui_app/tool_library_dialog/tool_tab.rs
+++ b/crates/ui/src/egui_app/tool_library_dialog/tool_tab.rs
@@ -4,7 +4,7 @@
 //! draws `kind_rows`), so a new kind row lands in one place. The preview
 //! stands above the tabs (U3, `preview`); #3895 (U4): the holder, the
 //! gauge length and the stick-out follow the rows (`assembly_group`). The
-//! recipes come to the window later (U5).
+//! cutting rows are on the Recipes tab (#3896, U5: `recipes_tab`).
 //! Provenance: our own tab over the tool draft; no HSMWorks material
 //! involved.
 
diff --git a/crates/ui/src/state_tool_library_dialog.rs b/crates/ui/src/state_tool_library_dialog.rs
index 6b44899dc..2531677cd 100644
--- a/crates/ui/src/state_tool_library_dialog.rs
+++ b/crates/ui/src/state_tool_library_dialog.rs
@@ -14,6 +14,7 @@
 //! its own draft too ([`ToolEditorView::holder`]), and a change of the
 //! stored tool's length re-seeds only that draft's projection (#808
 //! item 2). The stored `HolderRef` changes only through Apply holder.
+//! #3896 (U5): the editor's Recipes tab ([`ToolEditorTab::Recipes`]).
