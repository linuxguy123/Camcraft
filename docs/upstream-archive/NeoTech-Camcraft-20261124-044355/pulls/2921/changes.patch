From d4e7708bbb8a9675b034fd30cfe8401043472423 Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Fri, 20 Nov 2026 04:14:45 -0500
Subject: [PATCH 1/6] fix(ui): add tooltips to the main viewport controls

Add plain-English labels and descriptive hover tooltips to all 12 icon controls in the main viewport bottom bar (#2914). Toggle controls reflect their current on/off state, display mode, or latched navigation mode. Attach widget info for accessibility and keyboard focus support.

Pinned by:
- egui_app::viewport_bar::tests::nav_buttons_have_distinct_labels_and_descriptive_tooltips
- egui_app::viewport_bar::tests::nav_buttons_attach_tooltips_on_hover

Changelog: UI: add hover tooltips and accessibility labels to the 12 main viewport controls

Fixes #2914
---
 crates/ui/src/egui_app/viewport_bar.rs       | 111 ++++++++++++++++-
 crates/ui/src/egui_app/viewport_bar_tests.rs | 122 +++++++++++++++++++
 2 files changed, 232 insertions(+), 1 deletion(-)

diff --git a/crates/ui/src/egui_app/viewport_bar.rs b/crates/ui/src/egui_app/viewport_bar.rs
index 6511ef533..09e9ddcee 100644
--- a/crates/ui/src/egui_app/viewport_bar.rs
+++ b/crates/ui/src/egui_app/viewport_bar.rs
@@ -38,7 +38,7 @@ const BAR_RADIUS: f32 = 8.0;
 /// zoom tools latch the drag onto that mode and leave the shortcut to
 /// the vertex (a tool latched is a tool any drag obeys). View state
 /// like the camera - never commands, never saved.
-#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
 pub(crate) enum Nav {
     /// Reframe the whole document - the F key's button twin.
     Frame,
@@ -127,6 +127,107 @@ pub(crate) fn nav_tool_label(tool: DragMode) -> &'static str {
 /// The status line when a nav tool latches off.
 pub(crate) const NAV_TOOL_CLEAR: &str = "nav tool: off";
 
+/// The base plain-English label for each of the viewport controls.
+#[must_use]
+pub(crate) fn label(kind: Nav) -> &'static str {
+    match kind {
+        Nav::Frame => "Frame all",
+        Nav::Iso => "Isometric view",
+        Nav::Wire => "Display mode",
+        Nav::Paths => "Show all toolpaths",
+        Nav::Axes => "World axes",
+        Nav::PickThrough => "Pick through",
+        Nav::Move => "Move mode",
+        Nav::Rotate => "Rotate mode",
+        Nav::Projection => "Projection",
+        Nav::Orbit => "Orbit tool",
+        Nav::Pan => "Pan tool",
+        Nav::Zoom => "Zoom tool",
+    }
+}
+
+/// The descriptive hover tooltip for each of the viewport controls (#2914),
+/// reflecting the current state of toggle controls.
+#[must_use]
+pub(crate) fn tooltip(kind: Nav, state: &State) -> String {
+    match kind {
+        Nav::Frame => "Frame all (F): fit all objects in view".to_owned(),
+        Nav::Iso => "Isometric view: orient camera to isometric view".to_owned(),
+        Nav::Wire => match state.display {
+            DisplayMode::Wireframe => {
+                "Display mode: wireframe (click for shaded with edges)".to_owned()
+            }
+            DisplayMode::ShadedEdges => {
+                "Display mode: shaded with edges (click for wireframe)".to_owned()
+            }
+        },
+        Nav::Paths => {
+            if state.show_all_paths {
+                "Show all toolpaths: on".to_owned()
+            } else {
+                "Show all toolpaths: off".to_owned()
+            }
+        }
+        Nav::Axes => {
+            if state.show_world_axes {
+                "World axes: on".to_owned()
+            } else {
+                "World axes: off".to_owned()
+            }
+        }
+        Nav::PickThrough => {
+            if state.pick_through {
+                "Pick through: on (picks reach far side)".to_owned()
+            } else {
+                "Pick through: off (picks stop at front face)".to_owned()
+            }
+        }
+        Nav::Move => {
+            if state.move_handles {
+                "Move mode: on (drag handles to move part)".to_owned()
+            } else {
+                "Move mode: off (show move handles)".to_owned()
+            }
+        }
+        Nav::Rotate => {
+            if state.rotate_handles {
+                "Rotate mode: on (drag rings to rotate part)".to_owned()
+            } else {
+                "Rotate mode: off (show rotation rings)".to_owned()
+            }
+        }
+        Nav::Projection => match state.cam.projection {
+            ProjectionMode::Perspective => {
+                "Projection: perspective (P, click for orthographic)".to_owned()
+            }
+            ProjectionMode::Orthographic => {
+                "Projection: orthographic (P, click for perspective)".to_owned()
+            }
+        },
+        Nav::Orbit => {
+            if state.nav_tool == Some(DragMode::Orbit) {
+                "Orbit tool: active (drag to orbit)".to_owned()
+            } else {
+                "Orbit tool: click to latch orbit drag".to_owned()
+            }
+        }
+        Nav::Pan => {
+            if state.nav_tool == Some(DragMode::Pan) {
+                "Pan tool: active (drag to pan)".to_owned()
+            } else {
+                "Pan tool: click to latch pan drag".to_owned()
+            }
+        }
+        Nav::Zoom => {
+            if state.nav_tool == Some(DragMode::Zoom) {
+                "Zoom tool: active (drag to zoom)".to_owned()
+            } else {
+                "Zoom tool: click to latch zoom drag".to_owned()
+            }
+        }
+    }
+}
+
 /// The ribbon: centred on the pane's width, resting on its bottom edge at
 /// the same margin as before. Floats over the 3D view (#1198, maintainer:
 /// "bottom-center floating ontop of the 3D viewer").
@@ -279,6 +380,14 @@ pub(crate) fn draw(
         }
         let s = egui::Stroke::new(1.4, if active { ink.glyph_on } else { ink.glyph_off });
         glyphs::draw(ui, kind, r, s, ink.triad, state.cam.projection);
+
+        let lab = label(kind);
+        let tip = tooltip(kind, state);
+        let resp = ui.interact(r, ui.id().with(("viewport_nav", kind)), egui::Sense::hover());
+        resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, lab));
+        if state.drag.is_none() {
+            resp.on_hover_text(tip);
+        }
     }
 }
 
diff --git a/crates/ui/src/egui_app/viewport_bar_tests.rs b/crates/ui/src/egui_app/viewport_bar_tests.rs
index 251badcd1..7625d1e59 100644
--- a/crates/ui/src/egui_app/viewport_bar_tests.rs
+++ b/crates/ui/src/egui_app/viewport_bar_tests.rs
@@ -170,3 +170,125 @@ fn typed_move_and_turn_respect_units_and_refuse_bad_input() {
     assert!(!state.history.is_dirty());
     assert!(state.status.contains("part not turned"), "{}", state.status);
 }
+
+#[test]
+fn nav_buttons_have_distinct_labels_and_descriptive_tooltips() {
+    let mut state = State::new();
+    assert_eq!(NAVS.len(), NAV_COUNT);
+    for &kind in &NAVS {
+        let lab = label(kind);
+        assert!(!lab.is_empty(), "label for {:?} must not be empty", kind);
+        let tip = tooltip(kind, &state);
+        assert!(!tip.is_empty(), "tooltip for {:?} must not be empty", kind);
+    }
+
+    // Toggle states reflect in tooltips:
+    // Wireframe toggle
+    state.display = DisplayMode::ShadedEdges;
+    assert!(tooltip(Nav::Wire, &state).contains("shaded with edges"));
+    state.display = DisplayMode::Wireframe;
+    assert!(tooltip(Nav::Wire, &state).contains("wireframe"));
+
+    // Toolpaths toggle
+    state.show_all_paths = false;
+    assert!(tooltip(Nav::Paths, &state).contains("off"));
+    state.show_all_paths = true;
+    assert!(tooltip(Nav::Paths, &state).contains("on"));
+
+    // World axes toggle
+    state.show_world_axes = false;
+    assert!(tooltip(Nav::Axes, &state).contains("off"));
+    state.show_world_axes = true;
+    assert!(tooltip(Nav::Axes, &state).contains("on"));
+
+    // Pick through toggle
+    state.pick_through = false;
+    assert!(tooltip(Nav::PickThrough, &state).contains("off"));
+    state.pick_through = true;
+    assert!(tooltip(Nav::PickThrough, &state).contains("on"));
+
+    // Move handles toggle
+    state.move_handles = false;
+    assert!(tooltip(Nav::Move, &state).contains("off"));
+    state.move_handles = true;
+    assert!(tooltip(Nav::Move, &state).contains("on"));
+
+    // Rotate handles toggle
+    state.rotate_handles = false;
+    assert!(tooltip(Nav::Rotate, &state).contains("off"));
+    state.rotate_handles = true;
+    assert!(tooltip(Nav::Rotate, &state).contains("on"));
+
+    // Projection toggle
+    state.cam.projection = ProjectionMode::Perspective;
+    assert!(tooltip(Nav::Projection, &state).contains("perspective"));
+    state.cam.projection = ProjectionMode::Orthographic;
+    assert!(tooltip(Nav::Projection, &state).contains("orthographic"));
+
+    // Nav tools
+    state.nav_tool = None;
+    assert!(tooltip(Nav::Orbit, &state).contains("click to latch"));
+    assert!(tooltip(Nav::Pan, &state).contains("click to latch"));
+    assert!(tooltip(Nav::Zoom, &state).contains("click to latch"));
+    state.nav_tool = Some(DragMode::Orbit);
+    assert!(tooltip(Nav::Orbit, &state).contains("active"));
+    state.nav_tool = Some(DragMode::Pan);
+    assert!(tooltip(Nav::Pan, &state).contains("active"));
+    state.nav_tool = Some(DragMode::Zoom);
+    assert!(tooltip(Nav::Zoom, &state).contains("active"));
+}
+
+#[test]
+fn nav_buttons_attach_tooltips_on_hover() {
+    use egui_kittest::kittest::Queryable;
+    use egui_kittest::Harness;
+
+    let state = State::new();
+    let pane = egui::Rect::from_min_size(egui::pos2(0.0, 0.0), egui::vec2(900.0, 600.0));
+    let bar = bar_rect(pane);
+    let btns = buttons(bar);
+    let mut h = Harness::builder()
+        .with_size(egui::vec2(900.0, 600.0))
+        .build_ui(move |ui| {
+            draw(ui, bar, &btns, &state, None);
+        });
+
+    h.ctx.all_styles_mut(|s| {
+        s.interaction.tooltip_delay = 0.0;
+        s.interaction.show_tooltips_only_when_still = false;
+    });
+
+    h.run_steps(2);
+
+    fn walk(shape: &egui::Shape, out: &mut Vec<String>) {
+        match shape {
+            egui::Shape::Text(t) => out.push(t.galley.text().to_owned()),
+            egui::Shape::Vec(v) => v.iter().for_each(|s| walk(s, out)),
+            _ => {}
+        }
+    }
+
+    let all_buttons = buttons(bar);
+
+    // Verify all 12 buttons have accessible labels
+    for &(kind, btn_rect) in &all_buttons {
+        let lab = label(kind);
+        let node = h.get_by_label(lab);
+        assert_eq!(node.rect(), btn_rect, "node for {:?} must match button rect", kind);
+    }
+
+    // Verify hover tooltip is displayed when hovering over a button
+    h.hover_at(all_buttons[0].1.center());
+    h.run_steps(2);
+
+    let mut painted = Vec::new();
+    for shape in &h.output().shapes {
+        walk(&shape.shape, &mut painted);
+    }
+
+    assert!(
+        painted.iter().any(|s| s.contains("Frame all")),
+        "hovering over Frame button must paint a tooltip containing 'Frame all', got: {:?}",
+        painted
+    );
+}

