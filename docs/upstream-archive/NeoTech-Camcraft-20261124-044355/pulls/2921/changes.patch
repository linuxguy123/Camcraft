 .../ui/src/egui_app/viewport_bar_tooltip_tests.rs   |  7 +++++++
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/crates/ui/src/egui_app/viewport_bar_text.rs b/crates/ui/src/egui_app/viewport_bar_text.rs
