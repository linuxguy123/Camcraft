+    let find_btn = |nav: Nav| all_buttons.iter().position(|&(k, _)| k == nav);
+
+    let render_shot = |name: &str, mut setup: Box<dyn FnMut(&mut State)>, hover: Option<usize>| {
+        let mut state = State::new();
+        setup(&mut state);
