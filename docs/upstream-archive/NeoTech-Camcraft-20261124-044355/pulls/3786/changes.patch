From 473600714d1e3af9a9332bf2c9774882a956ba24 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Tue, 24 Nov 2026 00:32:28 +0100
Subject: [PATCH] test(app): rotary_verify pins the seam-ring move count of
 #3496

PR #3496 (#3168) closes each Auto/Zigzag rotary level with a seam ring.
The matching d12.4 bar now plans 2,110 moves, not 2,064 (d20 bar:
7,648 -> 7,578). All safety asserts of the test still pass. The pinned
count was obsolete; the air-lap law that it guards did not change.

Fixes #3774

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/rotary_verify.rs             |  5 ++-
 .../3774-rotary-verify-ring-reading.md        | 32 +++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/3774-rotary-verify-ring-reading.md

diff --git a/crates/app/tests/rotary_verify.rs b/crates/app/tests/rotary_verify.rs
index 774e62b64..6772b0d86 100644
--- a/crates/app/tests/rotary_verify.rs
+++ b/crates/app/tests/rotary_verify.rs
@@ -342,10 +342,13 @@ fn a_rough_over_an_oversized_bar_peels_from_the_stock_radius() {
     // matching bar; after: 7,082 - the seven air levels each sweep
     // half what they did. The matching bar has no air level, so its
     // program is the unsplit ladder's, move for move.
+    // #3168 (PR #3496) closes each Auto/Zigzag wrap level with a seam
+    // ring: the matching bar went 2,064 -> 2,110 moves (the rings), the
+    // d20 bar 7,648 -> 7,578. The air-lap law above is unchanged (#3774).
     let snug = cache(&world_for(Kind::Offset, 12.4, 25.0)).path.moves.len();
     let big = c.path.moves.len();
     eprintln!("ROTARY OFFSET | d20 bar {big} moves | d12.4 bar {snug} moves");
-    assert_eq!(snug, 2064, "the matching bar has no air level - its ladder must not move");
+    assert_eq!(snug, 2110, "the matching bar has no air level - its ladder must not move");
     assert!(big < 9000, "air levels still clear both laps: {big} moves (11,967 when they did)");
 }
 
diff --git a/docs/decisions/3774-rotary-verify-ring-reading.md b/docs/decisions/3774-rotary-verify-ring-reading.md
new file mode 100644
index 000000000..5eda36f04
--- /dev/null
+++ b/docs/decisions/3774-rotary-verify-ring-reading.md
@@ -0,0 +1,32 @@
+## #3774 - rotary_verify takes the seam-ring move count of #3496
+
+**What was decided.** The test
+`a_rough_over_an_oversized_bar_peels_from_the_stock_radius`
+(`crates/app/tests/rotary_verify.rs`) pins the d12.4 matching bar at
+2,110 moves, not 2,064. No code changes.
+
+**Why.** The run alone, debug, `--exact`:
+
+| Commit | d12.4 bar | d20 bar | Result |
+|---|---|---|---|
+| `7868d3786` (`6eff704f2^1`) | 2,064 | 7,648 | pass |
+| `6eff704f2` (merge of PR #3496) | 2,110 | 7,578 | fail at the 2,064 pin |
+| `436d38ffb` (main) | 2,110 | 7,578 | fail at the 2,064 pin |
+
+PR #3496 (#3168) removed the `seam.is_none()` guard in
+`machining3d::hsm::plan_level`, so each Auto/Zigzag rotary level now ends
+with a seam ring. This adds moves on purpose. All the safety asserts of
+the test still pass on the new path: the program verifies with no
+blocking warning, the top level starts at the stock radius, and the
+program posts. The d20 bar stays under the 9,000-move air-lap bound.
+The pinned count recorded the toolpath before the rings, so it is
+obsolete. The air-lap law that the pin guards did not change.
+
+**Considered and dropped.**
+- Fix forward: no rule broke. The only failing assert is a move count.
+- Revert PR #3496: it would remove the wall-cusp fix of #3168 for a
+  stale number.
+- A range instead of an exact count: the exact count keeps the guard
+  against a silent change of the matching bar's ladder.
+
+**Cost to change later.** One number in one test.
