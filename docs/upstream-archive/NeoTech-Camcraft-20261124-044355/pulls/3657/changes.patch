index 000000000..677263a69
--- /dev/null
+++ b/crates/gcode/src/arc.rs
@@ -0,0 +1,196 @@
+//! Arc geometry resolution (`I`/`J`/`K` center offsets and `R` radius arcs) in G17/G18/G19 planes.
+//! Provenance: RS-274/NGC circular/helical interpolation rules (NISTIR 6556 §3.5.3) and `camcraft_cl::cl::ArcPlane` handedness.
+
+use camcraft_cl::cl::ArcPlane;
+use camcraft_geometry::geo2d::Point2;
+use camcraft_geometry::geometry::Point3;
+
+use crate::types::{ArcCenterMode, GcodeError};
+
+/// Resolved arc geometry in millimeters.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ResolvedArc {
+    /// Center in `plane`'s word order: `(X, Y)`, `(X, Z)`, or `(Y, Z)`.
+    pub center_words: Point2,
+    /// Present for a full 360° `I/J/K` circle/helix so the caller splits it into two 180° pieces.
+    pub split_mid: Option<Point3>,
+}
+
+/// Resolve and validate an arc from `from` to `to` in `plane`.
+#[allow(clippy::too_many_arguments)]
+pub fn resolve_arc(
+    line: usize,
+    from: Point3,
+    to: Point3,
+    plane: ArcPlane,
+    ccw: bool,
+    center_mode: ArcCenterMode,
+    ijk_mm: [Option<f64>; 3],
+    r_mm: Option<f64>,
+    tol_mm: f64,
+) -> Result<ResolvedArc, GcodeError> {
+    let has_ijk = ijk_mm.iter().any(Option::is_some);
+    if r_mm.is_some() && has_ijk {
+        return Err(GcodeError::InvalidArc {
+            line,
+            message: "cannot specify both R radius and I/J/K center words".to_string(),
+        });
+    }
+
+    match plane {
+        ArcPlane::Xy if ijk_mm[2].is_some() => {
+            return Err(GcodeError::InvalidArc {
+                line,
+                message: "K offset is not valid in G17 (XY) arc plane".to_string(),
+            });
+        }
+        ArcPlane::Xz if ijk_mm[1].is_some() => {
+            return Err(GcodeError::InvalidArc {
+                line,
+                message: "J offset is not valid in G18 (XZ) arc plane".to_string(),
+            });
+        }
+        ArcPlane::Yz if ijk_mm[0].is_some() => {
+            return Err(GcodeError::InvalidArc {
+                line,
+                message: "I offset is not valid in G19 (YZ) arc plane".to_string(),
+            });
+        }
+        _ => {}
+    }
+
+    if let Some(r) = r_mm {
+        return resolve_r_arc(line, from, to, plane, ccw, r, tol_mm);
+    }
+    resolve_ijk_arc(line, from, to, plane, center_mode, ijk_mm, tol_mm)
+}
+
+fn resolve_r_arc(
+    line: usize,
+    from: Point3,
+    to: Point3,
+    plane: ArcPlane,
+    ccw: bool,
+    r: f64,
+    tol_mm: f64,
+) -> Result<ResolvedArc, GcodeError> {
+    if !r.is_finite() || r.abs() <= 1e-6 {
+        return Err(GcodeError::InvalidArc {
+            line,
+            message: "arc radius R must be finite and non-zero".to_string(),
+        });
+    }
+    let (u0, v0, _) = plane.uvw(from);
+    let (u1, v1, _) = plane.uvw(to);
+    let du = u1 - u0;
+    let dv = v1 - v0;
+    let d = du.hypot(dv);
+    if d <= 1e-6 {
+        return Err(GcodeError::InvalidArc {
+            line,
+            message: "full-circle or zero-length arc with R word is not supported; use I/J/K offsets".to_string(),
+        });
+    }
+
+    let r_abs = r.abs();
+    let max_chord = 2.0 * r_abs + tol_mm;
+    if d > max_chord {
+        return Err(GcodeError::InvalidArc {
+            line,
+            message: format!(
+                "arc endpoint distance {d:.4} mm exceeds diameter 2*|R| ({:.4} mm)",
+                2.0 * r_abs
+            ),
+        });
+    }
+
+    let half_d = 0.5 * d;
+    let h = (r_abs * r_abs - half_d * half_d).max(0.0).sqrt();
+    let tu = du / d;
+    let tv = dv / d;
+    // Left normal (-tv, tu) gives minor arc for CCW (G3) and major arc for CW (G2).
+    let sign = if (ccw && r > 0.0) || (!ccw && r < 0.0) {
+        1.0
+    } else {
+        -1.0
+    };
+    let cu = 0.5 * (u0 + u1) + sign * h * (-tv);
+    let cv = 0.5 * (v0 + v1) + sign * h * tu;
+    let center_words = plane.words(plane.point(cu, cv, 0.0));
+    Ok(ResolvedArc {
+        center_words,
+        split_mid: None,
+    })
+}
+
+fn resolve_ijk_arc(
+    line: usize,
+    from: Point3,
+    to: Point3,
+    plane: ArcPlane,
+    center_mode: ArcCenterMode,
+    ijk_mm: [Option<f64>; 3],
+    tol_mm: f64,
+) -> Result<ResolvedArc, GcodeError> {
+    let (a_opt, b_opt) = match plane {
+        ArcPlane::Xy => (ijk_mm[0], ijk_mm[1]),
+        ArcPlane::Xz => (ijk_mm[0], ijk_mm[2]),
+        ArcPlane::Yz => (ijk_mm[1], ijk_mm[2]),
+    };
+
+    let center_words = match center_mode {
+        ArcCenterMode::Incremental => {
+            if a_opt.is_none() && b_opt.is_none() {
+                return Err(GcodeError::InvalidArc {
+                    line,
+                    message: "arc requires I/J/K offsets or R radius".to_string(),
+                });
+            }
+            let fw = plane.words(from);
+            Point2::new(fw.x + a_opt.unwrap_or(0.0), fw.y + b_opt.unwrap_or(0.0))
+        }
+        ArcCenterMode::Absolute => {
+            let (Some(a), Some(b)) = (a_opt, b_opt) else {
+                return Err(GcodeError::InvalidArc {
+                    line,
+                    message: "G90.1 absolute arc requires both in-plane center words".to_string(),
+                });
+            };
+            Point2::new(a, b)
+        }
+    };
+
+    let (cu, cv) = plane.center_uv(center_words);
+    let (u0, v0, w0) = plane.uvw(from);
+    let (u1, v1, w1) = plane.uvw(to);
+    let r0 = (u0 - cu).hypot(v0 - cv);
+    let r1 = (u1 - cu).hypot(v1 - cv);
+    if !r0.is_finite() || !r1.is_finite() || r0 <= 1e-6 || r1 <= 1e-6 {
+        return Err(GcodeError::InvalidArc {
+            line,
+            message: "arc center coincides with endpoint (zero radius)".to_string(),
+        });
+    }
+    if (r0 - r1).abs() > tol_mm {
+        return Err(GcodeError::InvalidArc {
+            line,
+            message: format!(
+                "arc radius mismatch: start radius {r0:.4} mm vs end radius {r1:.4} mm"
+            ),
+        });
+    }
+
+    let split_mid = if (u1 - u0).hypot(v1 - v0) <= 1e-6 {
+        let mu = 2.0 * cu - u0;
+        let mv = 2.0 * cv - v0;
+        let mw = 0.5 * (w0 + w1);
+        Some(plane.point(mu, mv, mw))
+    } else {
+        None
+    };
+
+    Ok(ResolvedArc {
+        center_words,
+        split_mid,
+    })
+}
diff --git a/crates/gcode/src/block.rs b/crates/gcode/src/block.rs
new file mode 100644
index 000000000..dbd9afa34
--- /dev/null
+++ b/crates/gcode/src/block.rs
@@ -0,0 +1,267 @@
+//! Block-level representation and word-conflict validation for parsed NC lines.
+//! Provenance: block modal-group container and duplicate-word checks from RS-274/NGC (NISTIR 6556 §3.6).
+
+use camcraft_cl::cl::ArcPlane;
+use camcraft_geometry::geometry::units::Unit;
+
+use crate::block_codes::{apply_g, apply_m};
+use crate::lexer::{ParsedLine, Word};
+use crate::types::{
+    ArcCenterMode, CycleReturnMode, CycleType, DistanceMode, FeedMode, GcodeError, SpindleDir,
+    StopKind, WorkOffset,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NonModalG {
+    Dwell,
+    HomeG28,
+    SecondaryG30,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Group1G {
+    Rapid,
+    Linear,
+    ArcCw,
+    ArcCcw,
+    Cancel,
+    Cycle(CycleType),
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LengthOp {
+    Apply,
+    Cancel,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PathControlG {
+    ExactStop,
+    Continuous,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StopOrEnd {
+    Stop(StopKind),
+    EndM2,
+    EndM30,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct DecodedBlock {
+    pub line: usize,
+    pub is_percent: bool,
+    pub program_number: Option<u32>,
+    pub non_modal: Option<NonModalG>,
+    pub g53: bool,
+    pub group1: Option<Group1G>,
+    pub plane: Option<ArcPlane>,
+    pub distance: Option<DistanceMode>,
+    pub arc_center: Option<ArcCenterMode>,
+    pub feed_mode: Option<FeedMode>,
+    pub units: Option<Unit>,
+    pub comp_off: bool,
+    pub length_op: Option<LengthOp>,
+    pub work_offset: Option<WorkOffset>,
+    pub cycle_return: Option<CycleReturnMode>,
+    pub path_control: Option<PathControlG>,
+    pub spindle_dir: Option<SpindleDir>,
+    pub tool_change: bool,
+    pub stop_or_end: Option<StopOrEnd>,
+    pub mist_on: bool,
+    pub flood_on: bool,
+    pub coolant_off: bool,
+    pub tsc: Option<bool>,
+    pub x: Option<f64>,
+    pub y: Option<f64>,
+    pub z: Option<f64>,
+    pub i: Option<f64>,
+    pub j: Option<f64>,
+    pub k: Option<f64>,
+    pub r: Option<f64>,
+    pub p: Option<f64>,
+    pub q: Option<f64>,
+    pub f: Option<f64>,
+    pub s: Option<f64>,
+    pub t: Option<u32>,
+    pub h: Option<u32>,
+    pub l: Option<u32>,
+}
+
+impl DecodedBlock {
+    #[must_use]
+    pub fn has_executable_words(&self) -> bool {
+        self.non_modal.is_some()
+            || self.g53
+            || self.group1.is_some()
+            || self.plane.is_some()
+            || self.distance.is_some()
+            || self.arc_center.is_some()
+            || self.feed_mode.is_some()
+            || self.units.is_some()
+            || self.comp_off
+            || self.length_op.is_some()
+            || self.work_offset.is_some()
+            || self.cycle_return.is_some()
+            || self.path_control.is_some()
+            || self.spindle_dir.is_some()
+            || self.tool_change
+            || self.stop_or_end.is_some()
+            || self.mist_on
+            || self.flood_on
+            || self.coolant_off
+            || self.tsc.is_some()
+            || self.has_any_param_or_axis()
+    }
+
+    #[must_use]
+    pub fn has_any_param_or_axis(&self) -> bool {
+        self.x.is_some()
+            || self.y.is_some()
+            || self.z.is_some()
+            || self.i.is_some()
+            || self.j.is_some()
+            || self.k.is_some()
+            || self.r.is_some()
+            || self.p.is_some()
+            || self.q.is_some()
+            || self.f.is_some()
+            || self.s.is_some()
+            || self.t.is_some()
+            || self.h.is_some()
+            || self.l.is_some()
+    }
+}
+
+pub fn decode_block(parsed: &ParsedLine) -> Result<DecodedBlock, GcodeError> {
+    let line = parsed.line;
+    let mut b = DecodedBlock {
+        line,
+        is_percent: parsed.is_percent,
+        program_number: parsed.program_number,
+        ..DecodedBlock::default()
+    };
+
+    for w in &parsed.words {
+        match w.letter {
+            'G' => apply_g(line, &mut b, w)?,
+            'M' => apply_m(line, &mut b, w)?,
+            'X' => set_unique(line, 'X', &mut b.x, w.value)?,
+            'Y' => set_unique(line, 'Y', &mut b.y, w.value)?,
+            'Z' => set_unique(line, 'Z', &mut b.z, w.value)?,
+            'I' => set_unique(line, 'I', &mut b.i, w.value)?,
+            'J' => set_unique(line, 'J', &mut b.j, w.value)?,
+            'K' => set_unique(line, 'K', &mut b.k, w.value)?,
+            'R' => set_unique(line, 'R', &mut b.r, w.value)?,
+            'P' => set_unique(line, 'P', &mut b.p, w.value)?,
+            'Q' => set_unique(line, 'Q', &mut b.q, w.value)?,
+            'F' => set_unique(line, 'F', &mut b.f, w.value)?,
+            'S' => set_unique(line, 'S', &mut b.s, w.value)?,
+            'T' => set_unique_int(line, 'T', &mut b.t, w)?,
+            'H' => set_unique_int(line, 'H', &mut b.h, w)?,
+            'L' => set_unique_int(line, 'L', &mut b.l, w)?,
+            'A' | 'B' | 'C' => {
+                return Err(GcodeError::UnsupportedCode {
+                    line,
+                    code: w.raw.clone(),
+                    reason: format!(
+                        "rotary axis word '{}' is not supported in 3-axis milling mode",
+                        w.letter
+                    ),
+                });
+            }
+            'D' => {
+                return Err(GcodeError::UnsupportedCode {
+                    line,
+                    code: w.raw.clone(),
+                    reason: "cutter compensation register word 'D' is not supported".to_string(),
+                });
+            }
+            _ => {
+                return Err(GcodeError::UnknownWord {
+                    line,
+                    word: w.raw.clone(),
+                });
+            }
+        }
+    }
+
+    if b.g53 && b.non_modal.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "G53 cannot appear on the same block as G4, G28, or G30".to_string(),
+        });
+    }
+    if b.non_modal == Some(NonModalG::Dwell) && b.group1.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "G4 dwell cannot share a block with a Group 1 motion code".to_string(),
+        });
+    }
+    if b.path_control == Some(PathControlG::Continuous)
+        && (b.p.is_some() || b.q.is_some())
+        && (b.non_modal == Some(NonModalG::Dwell)
+            || matches!(b.group1, Some(Group1G::Cycle(_))))
+    {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "G64 P/Q cannot share a block with G4 or a canned cycle".to_string(),
+        });
+    }
+
+    Ok(b)
+}
+
+fn set_unique(
+    line: usize,
+    letter: char,
+    slot: &mut Option<f64>,
+    val: f64,
+) -> Result<(), GcodeError> {
+    if slot.is_some() {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("duplicate '{letter}' word on block"),
+        });
+    }
+    *slot = Some(val);
+    Ok(())
+}
+
+fn set_unique_int(
+    line: usize,
+    letter: char,
+    slot: &mut Option<u32>,
+    w: &Word,
+) -> Result<(), GcodeError> {
+    if slot.is_some() {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("duplicate '{letter}' word on block"),
+        });
+    }
+    if w.value < 0.0 || w.value.fract() != 0.0 || w.value > u32::MAX as f64 {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("word '{letter}' requires a non-negative integer, got '{}'", w.raw),
+        });
+    }
+    *slot = Some(w.value as u32);
+    Ok(())
+}
+
+pub fn set_group<T>(
+    line: usize,
+    group_name: &str,
+    slot: &mut Option<T>,
+    val: T,
+) -> Result<(), GcodeError> {
+    if slot.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: format!("multiple G-codes from {group_name} on one block"),
+        });
+    }
+    *slot = Some(val);
+    Ok(())
+}
