--- /dev/null
+++ b/crates/gcode/src/motion.rs
@@ -0,0 +1,374 @@
+//! Motion execution (`G0`/`G1`/`G2`/`G3`, `G4`, `G28`/`G30`/`G53`, canned cycles).
+//! Provenance: motion, reference return, and canned-cycle invocation semantics from RS-274/NGC (NISTIR 6556 §3.5) and ISO 6983.
+
+use camcraft_cl::cl::MoveKind;
+use camcraft_geometry::geometry::Point3;
+use camcraft_geometry::geometry::units::from_display;
+
+use crate::arc::resolve_arc;
+use crate::block::{DecodedBlock, Group1G, LengthOp, NonModalG, PathControlG};
+use crate::block_codes::check_unused_words;
+use crate::cycle::{execute_cycle_block, CycleBlockInput};
+use crate::interp::Interpreter;
+use crate::types::{DistanceMode, DwellEvent, DwellUnit, GcodeError, MotionMode};
+
+impl<'a> Interpreter<'a> {
+    pub(crate) fn execute_motion(&mut self, b: &DecodedBlock) -> Result<(), GcodeError> {
+        let line = b.line;
+        let g64_consumed = b.path_control == Some(PathControlG::Continuous);
+        let allow_h = b.length_op == Some(LengthOp::Apply);
+
+        if b.non_modal == Some(NonModalG::Dwell) {
+            return self.execute_dwell(b, allow_h);
+        }
+
+        if let Some(nm @ (NonModalG::HomeG28 | NonModalG::SecondaryG30)) = b.non_modal {
+            check_unused_words(b, false, false, g64_consumed, g64_consumed, allow_h, false)?;
+            if matches!(b.group1, Some(Group1G::ArcCw | Group1G::ArcCcw | Group1G::Cycle(_))) {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "G28/G30 cannot share a block with arcs or canned cycles".to_string(),
+                });
+            }
+            if let Some(g1) = b.group1 {
+                self.set_group1(g1);
+            }
+            return self.execute_reference_return(b, nm == NonModalG::HomeG28);
+        }
+
+        if b.g53 {
+            check_unused_words(b, false, false, g64_consumed, g64_consumed, allow_h, false)?;
+            if let Some(g1) = b.group1 {
+                self.set_group1(g1);
+            }
+            return self.execute_g53(b);
+        }
+
+        if let Some(g1) = b.group1 {
+            if g1 == Group1G::Cancel {
+                check_unused_words(b, false, false, g64_consumed, g64_consumed, allow_h, false)?;
+                if b.x.is_some() || b.y.is_some() || b.z.is_some() {
+                    return Err(GcodeError::InvalidModal {
+                        line,
+                        message: "axis coordinates are invalid on a G80 cancel block".to_string(),
+                    });
+                }
+                self.active_cycle = None;
+                self.modal.motion = MotionMode::None;
+                return Ok(());
+            }
+            self.set_group1(g1);
+        }
+
+        let has_coords = b.x.is_some()
+            || b.y.is_some()
+            || b.z.is_some()
+            || b.i.is_some()
+            || b.j.is_some()
+            || b.k.is_some()
+            || b.r.is_some()
+            || (!g64_consumed && (b.p.is_some() || b.q.is_some()))
+            || b.l.is_some();
+
+        if !has_coords && b.group1.is_none() {
+            return Ok(());
+        }
+
+        match self.modal.motion {
+            MotionMode::None => {
+                check_unused_words(b, false, false, g64_consumed, g64_consumed, allow_h, false)?;
+                Err(GcodeError::InvalidModal {
+                    line,
+                    message: "axis motion or parameters with no active motion mode (G0/G1/G2/G3/cycle)"
+                        .to_string(),
+                })
+            }
+            MotionMode::Rapid => self.execute_linear(b, false, g64_consumed, allow_h),
+            MotionMode::Linear => self.execute_linear(b, true, g64_consumed, allow_h),
+            MotionMode::ArcCw | MotionMode::ArcCcw => {
+                self.execute_arc(b, g64_consumed, allow_h)
+            }
+            MotionMode::Cycle(cycle_type) => {
+                self.execute_cycle(b, cycle_type, allow_h)
+            }
+        }
+    }
+
+    fn execute_dwell(&mut self, b: &DecodedBlock, allow_h: bool) -> Result<(), GcodeError> {
+        let line = b.line;
+        check_unused_words(b, false, false, true, false, allow_h, false)?;
+        if b.y.is_some() || b.z.is_some() {
+            return Err(GcodeError::InvalidModal {
+                line,
+                message: "Y/Z words are invalid with G4 dwell".to_string(),
+            });
+        }
+        if b.p.is_some() && b.x.is_some() {
+            return Err(GcodeError::InvalidModal {
+                line,
+                message: "G4 dwell accepts P or X, not both".to_string(),
+            });
+        }
+        let seconds = if let Some(p) = b.p {
+            dwell_to_seconds(line, p, self.options.dialect.g4_dwell_unit)?
+        } else if let Some(x) = b.x {
+            dwell_to_seconds(line, x, DwellUnit::Seconds)?
+        } else {
+            return Err(GcodeError::Syntax {
+                line,
+                message: "G4 dwell requires a P or X duration".to_string(),
+            });
+        };
+        self.dwells.push(DwellEvent {
+            line,
+            seconds,
+            section: self.current.index,
+            after_move: self.current.builder.moves_len().checked_sub(1),
+        });
+        Ok(())
+    }
+
+    fn execute_linear(
+        &mut self,
+        b: &DecodedBlock,
+        is_feed: bool,
+        g64_consumed: bool,
+        allow_h: bool,
+    ) -> Result<(), GcodeError> {
+        let line = b.line;
+        check_unused_words(b, false, false, g64_consumed, g64_consumed, allow_h, false)?;
+        if b.x.is_none() && b.y.is_none() && b.z.is_none() {
+            return Ok(());
+        }
+        let unit = self.require_unit(line)?;
+        let (kind, feed) = if is_feed {
+            (MoveKind::Feed, Some(self.require_feed(line, "G1")?))
+        } else {
+            (MoveKind::Rapid, None)
+        };
+        let to = self.target_point(b, unit);
+        self.current.push_move(line, kind, to, feed);
+        self.pos = to;
+        Ok(())
+    }
+
+    fn execute_arc(
+        &mut self,
+        b: &DecodedBlock,
+        g64_consumed: bool,
+        allow_h: bool,
+    ) -> Result<(), GcodeError> {
+        let line = b.line;
+        check_unused_words(b, true, true, g64_consumed, g64_consumed, allow_h, false)?;
+        if b.group1.is_none()
+            && b.x.is_none()
+            && b.y.is_none()
+            && b.z.is_none()
+            && b.i.is_none()
+            && b.j.is_none()
+            && b.k.is_none()
+            && b.r.is_none()
+        {
+            return Ok(());
+        }
+        let unit = self.require_unit(line)?;
+        let ccw = self.modal.motion == MotionMode::ArcCcw;
+        let feed = self.require_feed(line, if ccw { "G3" } else { "G2" })?;
+        let to = self.target_point(b, unit);
+        let ijk = [
+            b.i.map(|v| from_display(v, unit)),
+            b.j.map(|v| from_display(v, unit)),
+            b.k.map(|v| from_display(v, unit)),
+        ];
+        let r_mm = b.r.map(|v| from_display(v, unit));
+        let resolved = resolve_arc(
+            line,
+            self.pos,
+            to,
+            self.modal.plane,
+            ccw,
+            self.modal.arc_center,
+            ijk,
+            r_mm,
+            self.options.dialect.arc_radius_tolerance_mm,
+        )?;
+        if let Some(mid) = resolved.split_mid {
+            self.current.push_arc(
+                line,
+                mid,
+                feed,
+                resolved.center_words,
+                ccw,
+                self.modal.plane,
+            );
+        }
+        self.current.push_arc(
+            line,
+            to,
+            feed,
+            resolved.center_words,
+            ccw,
+            self.modal.plane,
+        );
+        self.pos = to;
+        Ok(())
+    }
+
+    fn execute_cycle(
+        &mut self,
+        b: &DecodedBlock,
+        cycle_type: crate::types::CycleType,
+        allow_h: bool,
+    ) -> Result<(), GcodeError> {
+        let line = b.line;
+        check_unused_words(b, false, true, true, true, allow_h, true)?;
+        let unit = self.require_unit(line)?;
+        let feed = self.require_feed(line, "canned cycle")?;
+        let repeat = b.l.unwrap_or(1);
+        if repeat > 10_000 {
+            return Err(GcodeError::InvalidCycle {
+                line,
+                message: format!("cycle repeat count L{repeat} exceeds 10000"),
+            });
+        }
+        let p_sec = match b.p {
+            Some(p) => Some(dwell_to_seconds(line, p, self.options.dialect.cycle_dwell_unit)?),
+            None => None,
+        };
+        let is_new_cycle = matches!(b.group1, Some(Group1G::Cycle(_)));
+        let input = CycleBlockInput {
+            line,
+            kind: cycle_type,
+            is_new_cycle,
+            distance: self.modal.distance,
+            return_mode: self.modal.cycle_return,
+            x_mm: b.x.map(|v| from_display(v, unit)),
+            y_mm: b.y.map(|v| from_display(v, unit)),
+            z_mm: b.z.map(|v| from_display(v, unit)),
+            r_mm: b.r.map(|v| from_display(v, unit)),
+            q_mm: b.q.map(|v| from_display(v, unit)),
+            p_sec,
+            repeat,
+            feed_mm_min: feed,
+            chip_break_retract_mm: self.options.dialect.chip_break_retract_mm,
+        };
+        execute_cycle_block(
+            input,
+            &mut self.active_cycle,
+            &mut self.pos,
+            &mut self.current.builder,
+            &mut self.current.move_lines,
+        )
+    }
+
+    pub(crate) fn set_group1(&mut self, g1: Group1G) {
+        let next = match g1 {
+            Group1G::Rapid => MotionMode::Rapid,
+            Group1G::Linear => MotionMode::Linear,
+            Group1G::ArcCw => MotionMode::ArcCw,
+            Group1G::ArcCcw => MotionMode::ArcCcw,
+            Group1G::Cancel => MotionMode::None,
+            Group1G::Cycle(ct) => MotionMode::Cycle(ct),
+        };
+        if !matches!(next, MotionMode::Cycle(_)) || self.modal.motion != next {
+            self.active_cycle = None;
+        }
+        self.modal.motion = next;
+    }
+
+    fn execute_reference_return(
+        &mut self,
+        b: &DecodedBlock,
+        is_g28: bool,
+    ) -> Result<(), GcodeError> {
+        let line = b.line;
+        let code = if is_g28 { "G28" } else { "G30" };
+        let unit = self.require_unit(line)?;
+        let ref_pt = if is_g28 {
+            self.options.references.g28
+        } else {
+            self.options.references.g30
+        }
+        .ok_or_else(|| GcodeError::MissingReferencePosition {
+            line,
+            code: code.to_string(),
+        })?;
+        let wcs_org = self
+            .options
+            .references
+            .wcs_origin(self.modal.work_offset)
+            .unwrap_or(Point3::ZERO);
+        let ref_wcs = Point3::new(
+            ref_pt.x - wcs_org.x,
+            ref_pt.y - wcs_org.y,
+            ref_pt.z - wcs_org.z,
+        );
+        if b.x.is_some() || b.y.is_some() || b.z.is_some() {
+            let inter = self.target_point(b, unit);
+            self.current.push_move(line, MoveKind::Rapid, inter, None);
+            self.pos = inter;
+            let final_pt = Point3::new(
+                if b.x.is_some() { ref_wcs.x } else { self.pos.x },
+                if b.y.is_some() { ref_wcs.y } else { self.pos.y },
+                if b.z.is_some() { ref_wcs.z } else { self.pos.z },
+            );
+            self.current.push_move(line, MoveKind::Rapid, final_pt, None);
+            self.pos = final_pt;
+        } else {
+            self.current.push_move(line, MoveKind::Rapid, ref_wcs, None);
+            self.pos = ref_wcs;
+        }
+        Ok(())
+    }
+
+    fn execute_g53(&mut self, b: &DecodedBlock) -> Result<(), GcodeError> {
+        let line = b.line;
+        let unit = self.require_unit(line)?;
+        if self.modal.distance != DistanceMode::Absolute {
+            return Err(GcodeError::InvalidModal {
+                line,
+                message: "G53 machine-coordinate move requires G90 absolute distance mode"
+                    .to_string(),
+            });
+        }
+        let wcs_org = self
+            .options
+            .references
+            .wcs_origin(self.modal.work_offset)
+            .ok_or_else(|| GcodeError::MissingReferencePosition {
+                line,
+                code: "G53".to_string(),
+            })?;
+        let (kind, feed) = match self.modal.motion {
+            MotionMode::Rapid => (MoveKind::Rapid, None),
+            MotionMode::Linear => (MoveKind::Feed, Some(self.require_feed(line, "G53 G1")?)),
+            _ => {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "G53 is valid only with G0 or G1 motion mode".to_string(),
+                });
+            }
+        };
+        let to = Point3::new(
+            b.x.map_or(self.pos.x, |v| from_display(v, unit) - wcs_org.x),
+            b.y.map_or(self.pos.y, |v| from_display(v, unit) - wcs_org.y),
+            b.z.map_or(self.pos.z, |v| from_display(v, unit) - wcs_org.z),
+        );
+        self.current.push_move(line, kind, to, feed);
+        self.pos = to;
+        Ok(())
+    }
+}
+
+fn dwell_to_seconds(line: usize, val: f64, unit: DwellUnit) -> Result<f64, GcodeError> {
+    if !val.is_finite() || val < 0.0 {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: format!("dwell duration ({val}) must be non-negative"),
+        });
+    }
+    Ok(match unit {
+        DwellUnit::Seconds => val,
+        DwellUnit::Milliseconds => val / 1000.0,
+    })
+}
diff --git a/crates/gcode/src/section.rs b/crates/gcode/src/section.rs
new file mode 100644
index 000000000..05e692532
--- /dev/null
+++ b/crates/gcode/src/section.rs
@@ -0,0 +1,91 @@
+//! Toolpath section accumulation and aligned 1-based move-to-line tracking.
+//! Provenance: binds RS-274 tool-change section splitting to CamCraft's `cl::PathBuilder` and `cl::Toolpath` contract.
+
+use camcraft_cl::cl::{ArcPlane, MoveKind, PathBuilder};
+use camcraft_geometry::geo2d::Point2;
+use camcraft_geometry::geometry::Point3;
+
+use crate::types::{CoolantState, ModalState, ParsedSection, SpindleDir, WorkOffset};
+
+pub struct SectionBuilder {
+    pub index: usize,
+    pub tool_number: Option<u32>,
+    pub work_offset: WorkOffset,
+    pub length_offset: Option<u32>,
+    pub spindle_rpm: Option<f64>,
+    pub spindle_dir: SpindleDir,
+    pub coolant: CoolantState,
+    pub builder: PathBuilder,
+    pub move_lines: Vec<usize>,
+}
+
+impl SectionBuilder {
+    pub fn new(index: usize, start: Point3, modal: &ModalState) -> Self {
+        Self {
+            index,
+            tool_number: modal.active_tool,
+            work_offset: modal.work_offset,
+            length_offset: modal.length_offset,
+            spindle_rpm: modal.spindle_rpm,
+            spindle_dir: modal.spindle_dir,
+            coolant: modal.coolant,
+            builder: PathBuilder::new(start),
+            move_lines: Vec::new(),
+        }
+    }
+
+    pub fn has_moves(&self) -> bool {
+        self.builder.moves_len() > 0
+    }
+
+    pub fn sync_pre_motion(&mut self, modal: &ModalState) {
+        if !self.has_moves() {
+            self.work_offset = modal.work_offset;
+            self.length_offset = modal.length_offset;
+            self.spindle_rpm = modal.spindle_rpm;
+            self.spindle_dir = modal.spindle_dir;
+            self.coolant = modal.coolant;
+        }
+    }
+
+    pub fn push_move(&mut self, line: usize, kind: MoveKind, to: Point3, feed: Option<f64>) {
+        let before = self.builder.moves_len();
+        self.builder.push(kind, to, feed);
+        let after = self.builder.moves_len();
+        for _ in before..after {
+            self.move_lines.push(line);
+        }
+    }
+
+    pub fn push_arc(
+        &mut self,
+        line: usize,
+        to: Point3,
+        feed: f64,
+        center: Point2,
+        ccw: bool,
+        plane: ArcPlane,
+    ) {
+        let before = self.builder.moves_len();
+        self.builder
+            .push_arc_in(MoveKind::Feed, to, Some(feed), center, ccw, plane);
+        let after = self.builder.moves_len();
+        for _ in before..after {
+            self.move_lines.push(line);
+        }
+    }
+
+    pub fn finish(self) -> ParsedSection {
+        ParsedSection {
+            index: self.index,
+            tool_number: self.tool_number,
+            work_offset: self.work_offset,
+            length_offset: self.length_offset,
+            spindle_rpm: self.spindle_rpm,
+            spindle_dir: self.spindle_dir,
+            coolant: self.coolant,
+            toolpath: self.builder.finish(),
+            move_lines: self.move_lines,
+        }
+    }
+}
diff --git a/crates/gcode/src/types.rs b/crates/gcode/src/types.rs
new file mode 100644
index 000000000..8e39d8e59
--- /dev/null
+++ b/crates/gcode/src/types.rs
@@ -0,0 +1,266 @@
+//! Public modal state, program output, and line-map types for `camcraft-gcode`.
+//! Provenance: modal groups and word meanings from RS-274/NGC (NISTIR 6556) and ISO 6983; output types bind to camcraft-cl (`cl::Toolpath`).
+
+use camcraft_cl::cl::Toolpath;
+
+pub use crate::dialect::{Dialect, DwellUnit, ModalState, ParseOptions, ReferencePositions};
+pub use crate::error::GcodeError;
+
+/// How `I`/`J`/`K` arc center words are interpreted.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ArcCenterMode {
+    /// `G91.1`: `I`/`J`/`K` are incremental offsets from the arc start point.
+    #[default]
+    Incremental,
+    /// `G90.1`: `I`/`J`/`K` are absolute coordinates in the active work offset.
+    Absolute,
+}
+
+/// Modal Group 3 distance mode.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum DistanceMode {
+    /// `G90`: axis words are absolute positions in the active work offset.
+    #[default]
+    Absolute,
+    /// `G91`: axis words are increments from the current position.
+    Incremental,
+}
+
+/// Modal Group 5 feed rate mode.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum FeedMode {
+    /// `G94`: feed rate in units per minute.
+    #[default]
+    PerMinute,
+}
+
+/// Modal Group 10 canned cycle return level.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum CycleReturnMode {
+    /// `G98`: return to the initial Z level held before the cycle started.
+    #[default]
+    InitialZ,
+    /// `G99`: return to the `R` retract plane.
+    RPlane,
+}
+
+/// Modal Group 13 path control mode.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum PathControlMode {
+    /// `G61`: exact stop / exact path mode.
+    ExactStop,
+    /// `G64`: continuous path blending, with optional `P` tolerance in mm.
+    Continuous { tolerance_mm: Option<f64> },
+}
+
+impl Default for PathControlMode {
+    fn default() -> Self {
+        PathControlMode::Continuous { tolerance_mm: None }
+    }
+}
+
+/// Spindle rotation state (`M3`/`M4`/`M5`).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum SpindleDir {
+    #[default]
+    Off,
+    Cw,
+    Ccw,
+}
+
+/// Active coolant channels (`M7`, `M8`, `M9`, `M88`, `M89`).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct CoolantState {
+    pub flood: bool,
+    pub mist: bool,
+    pub through_spindle: bool,
+}
+
+/// Modal Group 12 work coordinate system (`G54`..`G59`).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum WorkOffset {
+    #[default]
+    G54 = 1,
+    G55 = 2,
+    G56 = 3,
+    G57 = 4,
+    G58 = 5,
+    G59 = 6,
+}
+
+impl WorkOffset {
+    /// 1-based offset number (1 for `G54` .. 6 for `G59`).
+    #[must_use]
+    pub const fn number(self) -> u8 {
+        self as u8
+    }
+
+    /// 0-based array index (0..6).
+    #[must_use]
+    pub const fn index(self) -> usize {
+        (self as usize) - 1
+    }
+
+    /// RS-274 G-code integer (`54`..`59`).
+    #[must_use]
+    pub const fn g_code(self) -> u8 {
+        53 + (self as u8)
+    }
+}
+
+/// Active canned cycle variant.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CycleType {
+    /// `G73`: high-speed chip-breaking peck drilling.
+    ChipBreakPeck,
+    /// `G81`: plain drilling.
+    Drill,
+    /// `G82`: drilling with bottom dwell.
+    DwellDrill,
+    /// `G83`: deep-hole full-retract peck drilling.
+    DeepPeck,
+    /// `G84`: right-hand tapping.
+    Tap,
+    /// `G85`: reaming / boring feed-in, feed-out.
+    Ream,
+    /// `G86`: boring feed-in, spindle stop, rapid retract.
+    Bore,
+    /// `G89`: boring feed-in, bottom dwell, feed-out.
+    BackBore,
+}
+
+/// Active modal Group 1 motion state.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum MotionMode {
+    /// Cancelled (`G80`) or unset before the first Group 1 code.
+    #[default]
+    None,
+    /// `G0`: rapid positioning.
+    Rapid,
+    /// `G1`: linear interpolation at active feed rate.
+    Linear,
+    /// `G2`: clockwise circular/helical arc.
+    ArcCw,
+    /// `G3`: counterclockwise circular/helical arc.
+    ArcCcw,
+    /// `G73`/`G81`..`G89`: modal canned drilling/boring/tapping cycle.
+    Cycle(CycleType),
+}
+
+/// One `G4` dwell recorded in the program.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DwellEvent {
+    pub line: usize,
+    pub seconds: f64,
+    pub section: usize,
+    pub after_move: Option<usize>,
+}
+
+/// `M0` program stop or `M1` optional stop.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StopKind {
+    ProgramStop,
+    OptionalStop,
+}
+
+/// One `M0`/`M1` stop recorded in the program.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StopEvent {
+    pub line: usize,
+    pub kind: StopKind,
+    pub section: usize,
+    pub after_move: Option<usize>,
+}
+
+/// `M2` or `M30` program end marker.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ProgramEnd {
+    M2,
+    M30,
+}
+
+/// One move-to-source-line mapping entry (1-based line number).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct MoveLine {
+    pub section: usize,
+    pub move_index: usize,
+    pub line: usize,
+}
+
+/// Mapping between emitted `cl::Move` indices and 1-based NC source line numbers.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct LineMap {
+    pub entries: Vec<MoveLine>,
+}
+
+impl LineMap {
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.entries.is_empty()
+    }
+
+    #[must_use]
+    pub fn len(&self) -> usize {
+        self.entries.len()
+    }
+
+    /// 1-based line number for `(section, move_index)`.
+    #[must_use]
+    pub fn line_for(&self, section: usize, move_index: usize) -> Option<usize> {
+        self.entries
+            .iter()
+            .find(|e| e.section == section && e.move_index == move_index)
+            .map(|e| e.line)
+    }
+
+    /// All `(section, move_index)` pairs emitted by 1-based `line`.
+    pub fn moves_on_line(&self, line: usize) -> impl Iterator<Item = (usize, usize)> + '_ {
+        self.entries
+            .iter()
+            .filter(move |e| e.line == line)
+            .map(|e| (e.section, e.move_index))
+    }
+}
+
+/// One tool section of a parsed NC program.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ParsedSection {
+    pub index: usize,
+    pub tool_number: Option<u32>,
+    pub work_offset: WorkOffset,
+    pub length_offset: Option<u32>,
+    pub spindle_rpm: Option<f64>,
+    pub spindle_dir: SpindleDir,
+    pub coolant: CoolantState,
+    pub toolpath: Toolpath,
+    /// 1-based NC line number aligned 1-to-1 with `toolpath.moves`.
+    pub move_lines: Vec<usize>,
+}
+
+/// Complete parsed result for a 3-axis RS-274/ISO 6983 program.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ParsedProgram {
+    pub program_number: Option<u32>,
+    pub sections: Vec<ParsedSection>,
+    pub line_map: LineMap,
+    pub dwells: Vec<DwellEvent>,
+    pub stops: Vec<StopEvent>,
+    pub ended: Option<ProgramEnd>,
+    pub tools: Vec<u32>,
+    pub final_modal: ModalState,
+}
+
+impl ParsedProgram {
+    /// Iterator over each section's `cl::Toolpath`.
+    pub fn toolpaths(&self) -> impl Iterator<Item = &Toolpath> + '_ {
+        self.sections.iter().map(|s| &s.toolpath)
+    }
+
+    /// 1-based NC line number for `(section, move_index)`.
+    #[must_use]
+    pub fn line_for_move(&self, section: usize, move_index: usize) -> Option<usize> {
+        self.sections
+            .get(section)
+            .and_then(|s| s.move_lines.get(move_index).copied())
+    }
+}
diff --git a/crates/gcode/tests/dialects_and_planes.rs b/crates/gcode/tests/dialects_and_planes.rs
