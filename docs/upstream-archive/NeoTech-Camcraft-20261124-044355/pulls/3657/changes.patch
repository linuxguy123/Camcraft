index 000000000..ba9274ed3
--- /dev/null
+++ b/crates/gcode/src/interp.rs
@@ -0,0 +1,323 @@
+//! Modal state interpreter that executes decoded RS-274/ISO 6983 blocks into `cl::Toolpath` sections.
+//! Provenance: block execution order and modal group semantics from RS-274/NGC (NISTIR 6556 §3.8) and ISO 6983.
+
+use camcraft_geometry::geometry::Point3;
+use camcraft_geometry::geometry::units::{from_display, Unit, MM_PER_INCH};
+
+use crate::block::{decode_block, DecodedBlock, LengthOp, PathControlG, StopOrEnd};
+use crate::cycle::ActiveCycle;
+use crate::lexer::tokenize;
+use crate::section::SectionBuilder;
+use crate::types::{
+    DistanceMode, DwellEvent, GcodeError, LineMap, ModalState, MotionMode, MoveLine,
+    ParseOptions, ParsedProgram, ParsedSection, PathControlMode, ProgramEnd, StopEvent,
+};
+
+pub(crate) struct Interpreter<'a> {
+    pub(crate) options: &'a ParseOptions,
+    pub(crate) modal: ModalState,
+    pub(crate) pos: Point3,
+    pub(crate) active_cycle: Option<ActiveCycle>,
+    program_number: Option<u32>,
+    sections: Vec<ParsedSection>,
+    pub(crate) current: SectionBuilder,
+    pub(crate) dwells: Vec<DwellEvent>,
+    stops: Vec<StopEvent>,
+    ended: Option<ProgramEnd>,
+    tools: Vec<u32>,
+}
+
+impl<'a> Interpreter<'a> {
+    fn new(options: &'a ParseOptions) -> Self {
+        let modal = ModalState::from_dialect(&options.dialect);
+        let pos = options.dialect.initial_position;
+        let current = SectionBuilder::new(0, pos, &modal);
+        Self {
+            options,
+            modal,
+            pos,
+            active_cycle: None,
+            program_number: None,
+            sections: Vec::new(),
+            current,
+            dwells: Vec::new(),
+            stops: Vec::new(),
+            ended: None,
+            tools: Vec::new(),
+        }
+    }
+
+    fn step_block(&mut self, b: &DecodedBlock) -> Result<(), GcodeError> {
+        let line = b.line;
+        if self.ended.is_some() {
+            if b.is_percent || !b.has_executable_words() {
+                return Ok(());
+            }
+            return Err(GcodeError::Syntax {
+                line,
+                message: "executable words after program end (M2/M30)".to_string(),
+            });
+        }
+        if b.is_percent {
+            return Ok(());
+        }
+        if let Some(n) = b.program_number {
+            if self.program_number.is_none() {
+                self.program_number = Some(n);
+            }
+            return Ok(());
+        }
+        if !b.has_executable_words() {
+            return Ok(());
+        }
+
+        self.apply_modal_setup(b)?;
+        self.apply_tool_and_aux(b)?;
+        self.current.sync_pre_motion(&self.modal);
+        self.execute_motion(b)?;
+
+        if let Some(se) = b.stop_or_end {
+            let after_move = self.current.builder.moves_len().checked_sub(1);
+            match se {
+                StopOrEnd::Stop(kind) => self.stops.push(StopEvent {
+                    line,
+                    kind,
+                    section: self.current.index,
+                    after_move,
+                }),
+                StopOrEnd::EndM2 => {
+                    self.active_cycle = None;
+                    self.modal.motion = MotionMode::None;
+                    self.ended = Some(ProgramEnd::M2);
+                }
+                StopOrEnd::EndM30 => {
+                    self.active_cycle = None;
+                    self.modal.motion = MotionMode::None;
+                    self.ended = Some(ProgramEnd::M30);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn apply_modal_setup(&mut self, b: &DecodedBlock) -> Result<(), GcodeError> {
+        let line = b.line;
+        if let Some(u) = b.units {
+            self.modal.units = Some(u);
+        }
+        if let Some(fm) = b.feed_mode {
+            self.modal.feed_mode = fm;
+        }
+        if let Some(pl) = b.plane {
+            self.modal.plane = pl;
+        }
+        if let Some(d) = b.distance {
+            self.modal.distance = d;
+        }
+        if let Some(ac) = b.arc_center {
+            self.modal.arc_center = ac;
+        }
+        if let Some(cr) = b.cycle_return {
+            self.modal.cycle_return = cr;
+        }
+        if let Some(w) = b.work_offset {
+            self.modal.work_offset = w;
+        }
+        if let Some(pc) = b.path_control {
+            self.modal.path_control = match pc {
+                PathControlG::ExactStop => PathControlMode::ExactStop,
+                PathControlG::Continuous => {
+                    let tol = match b.p {
+                        Some(p) => {
+                            if !p.is_finite() || p < 0.0 {
+                                return Err(GcodeError::InvalidModal {
+                                    line,
+                                    message: format!("G64 P tolerance ({p}) must be non-negative"),
+                                });
+                            }
+                            let u = self.require_unit(line)?;
+                            Some(from_display(p, u))
+                        }
+                        None => None,
+                    };
+                    if let Some(q) = b.q {
+                        if !q.is_finite() || q < 0.0 {
+                            return Err(GcodeError::InvalidModal {
+                                line,
+                                message: format!("G64 Q tolerance ({q}) must be non-negative"),
+                            });
+                        }
+                        let _ = self.require_unit(line)?;
+                    }
+                    PathControlMode::Continuous { tolerance_mm: tol }
+                }
+            };
+        }
+        if let Some(f) = b.f {
+            if !f.is_finite() || f <= 0.0 {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: format!("feed rate F ({f}) must be positive"),
+                });
+            }
+            let u = self.require_unit(line)?;
+            self.modal.feed_rate_mm_min = Some(scale_rate(f, u));
+        }
+        if let Some(s) = b.s {
+            if !s.is_finite() || s < 0.0 {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: format!("spindle speed S ({s}) must be non-negative"),
+                });
+            }
+            self.modal.spindle_rpm = Some(s);
+        }
+        Ok(())
+    }
+
+    fn apply_tool_and_aux(&mut self, b: &DecodedBlock) -> Result<(), GcodeError> {
+        let line = b.line;
+        if let Some(t) = b.t {
+            self.modal.pending_tool = Some(t);
+        }
+        if b.tool_change {
+            let new_tool = self.modal.pending_tool.take().ok_or_else(|| GcodeError::InvalidModal {
+                line,
+                message: "M6 tool change requires a T tool number".to_string(),
+            })?;
+            if !self.tools.contains(&new_tool) {
+                self.tools.push(new_tool);
+            }
+            self.active_cycle = None;
+            if matches!(self.modal.motion, MotionMode::Cycle(_)) {
+                self.modal.motion = MotionMode::None;
+            }
+            self.modal.active_tool = Some(new_tool);
+            if self.current.has_moves() {
+                let next_idx = self.sections.len() + 1;
+                let prev = std::mem::replace(
+                    &mut self.current,
+                    SectionBuilder::new(next_idx, self.pos, &self.modal),
+                );
+                self.sections.push(prev.finish());
+            } else {
+                self.current.tool_number = Some(new_tool);
+            }
+        }
+        if let Some(lo) = b.length_op {
+            match lo {
+                LengthOp::Apply => {
+                    let h = b.h.ok_or_else(|| GcodeError::InvalidModal {
+                        line,
+                        message: "G43 requires an H length-offset number".to_string(),
+                    })?;
+                    self.modal.length_offset = Some(h);
+                }
+                LengthOp::Cancel => {
+                    if b.h.is_some() {
+                        return Err(GcodeError::InvalidModal {
+                            line,
+                            message: "H word is invalid with G49".to_string(),
+                        });
+                    }
+                    self.modal.length_offset = None;
+                }
+            }
+        } else if b.h.is_some() {
+            return Err(GcodeError::InvalidModal {
+                line,
+                message: "word 'H' requires G43 on the same block".to_string(),
+            });
+        }
+        if let Some(dir) = b.spindle_dir {
+            self.modal.spindle_dir = dir;
+        }
+        if b.mist_on {
+            self.modal.coolant.mist = true;
+        }
+        if b.flood_on {
+            self.modal.coolant.flood = true;
+        }
+        if b.coolant_off {
+            self.modal.coolant.flood = false;
+            self.modal.coolant.mist = false;
+        }
+        if let Some(tsc) = b.tsc {
+            self.modal.coolant.through_spindle = tsc;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn require_unit(&self, line: usize) -> Result<Unit, GcodeError> {
+        self.modal.units.ok_or(GcodeError::MissingUnitMode { line })
+    }
+
+    pub(crate) fn require_feed(&self, line: usize, what: &str) -> Result<f64, GcodeError> {
+        self.modal
+            .feed_rate_mm_min
+            .filter(|f| f.is_finite() && *f > 0.0)
+            .ok_or_else(|| GcodeError::InvalidModal {
+                line,
+                message: format!("{what} requires a positive active feed rate F"),
+            })
+    }
+
+    pub(crate) fn target_point(&self, b: &DecodedBlock, unit: Unit) -> Point3 {
+        let conv = |v: f64| from_display(v, unit);
+        match self.modal.distance {
+            DistanceMode::Absolute => Point3::new(
+                b.x.map_or(self.pos.x, conv),
+                b.y.map_or(self.pos.y, conv),
+                b.z.map_or(self.pos.z, conv),
+            ),
+            DistanceMode::Incremental => Point3::new(
+                self.pos.x + b.x.map_or(0.0, conv),
+                self.pos.y + b.y.map_or(0.0, conv),
+                self.pos.z + b.z.map_or(0.0, conv),
+            ),
+        }
+    }
+
+    fn finish(mut self) -> ParsedProgram {
+        if self.current.has_moves() {
+            self.sections.push(self.current.finish());
+        }
+        let mut entries = Vec::new();
+        for (sec_idx, sec) in self.sections.iter().enumerate() {
+            for (move_idx, &line) in sec.move_lines.iter().enumerate() {
+                entries.push(MoveLine {
+                    section: sec_idx,
+                    move_index: move_idx,
+                    line,
+                });
+            }
+        }
+        ParsedProgram {
+            program_number: self.program_number,
+            sections: self.sections,
+            line_map: LineMap { entries },
+            dwells: self.dwells,
+            stops: self.stops,
+            ended: self.ended,
+            tools: self.tools,
+            final_modal: self.modal,
+        }
+    }
+}
+
+fn scale_rate(v: f64, unit: Unit) -> f64 {
+    match unit {
+        Unit::Millimeters => v,
+        Unit::Inches => v * MM_PER_INCH,
+    }
+}
+
+pub fn interpret(program: &str, options: &ParseOptions) -> Result<ParsedProgram, GcodeError> {
+    let lines = tokenize(program)?;
+    let mut interp = Interpreter::new(options);
+    for parsed in &lines {
+        let block = decode_block(parsed)?;
+        interp.step_block(&block)?;
+    }
+    Ok(interp.finish())
+}
diff --git a/crates/gcode/src/lexer.rs b/crates/gcode/src/lexer.rs
new file mode 100644
index 000000000..49201af6b
--- /dev/null
+++ b/crates/gcode/src/lexer.rs
@@ -0,0 +1,359 @@
+//! Line-oriented RS-274/NGC and ISO 6983 block lexer.
+//! Provenance: block syntax, parenthesized/semicolon comments, and word addressing from NISTIR 6556 (§3.3) and ISO 6983; no external parser code consulted.
+
+use crate::types::GcodeError;
+
+/// Parsed G-code or M-code number (integer major plus optional trimmed decimal minor).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CodeNum {
+    pub major: u32,
+    pub minor: Option<u32>,
+    pub text: String,
+}
+
+impl CodeNum {
+    /// Formatted code name with letter prefix, e.g. `"G90.1"` or `"M30"`.
+    #[must_use]
+    pub fn label(&self, letter: char) -> String {
+        format!("{letter}{}", self.text)
+    }
+}
+
+/// One address-value word on a block (`G1`, `X10.5`, `F500`).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Word {
+    pub letter: char,
+    pub value: f64,
+    pub code: Option<CodeNum>,
+    pub raw: String,
+}
+
+/// Tokenized source line (1-based line number).
+#[derive(Clone, Debug, PartialEq)]
+pub struct ParsedLine {
+    pub line: usize,
+    pub is_percent: bool,
+    pub program_number: Option<u32>,
+    pub words: Vec<Word>,
+}
+
+const MACRO_KEYWORDS: &[&str] = &[
+    "IF",
+    "THEN",
+    "ELSE",
+    "ENDIF",
+    "WHILE",
+    "ENDWHILE",
+    "DO",
+    "END",
+    "GOTO",
+    "SUB",
+    "ENDSUB",
+    "CALL",
+    "REPEAT",
+    "ENDREPEAT",
+    "RETURN",
+];
+
+/// Tokenize an entire NC program into lines, preserving 1-based line numbers.
+pub fn tokenize(program: &str) -> Result<Vec<ParsedLine>, GcodeError> {
+    program
+        .lines()
+        .enumerate()
+        .map(|(idx, raw)| tokenize_line(idx + 1, raw))
+        .collect()
+}
+
+pub fn tokenize_line(line: usize, raw: &str) -> Result<ParsedLine, GcodeError> {
+    let bytes = raw.as_bytes();
+    let len = bytes.len();
+    let mut i = 0;
+    let mut is_percent = false;
+    let mut program_number: Option<u32> = None;
+    let mut words: Vec<Word> = Vec::new();
+
+    while i < len {
+        let b = bytes[i];
+        if b.is_ascii_whitespace() {
+            i += 1;
+            continue;
+        }
+        if b == b';' {
+            break;
+        }
+        if b == b'(' {
+            i = skip_paren_comment(line, raw, i)?;
+            continue;
+        }
+        if b == b'%' {
+            if !words.is_empty() || program_number.is_some() || is_percent {
+                return Err(GcodeError::Syntax {
+                    line,
+                    message: "unexpected '%' delimiter on block with words".to_string(),
+                });
+            }
+            is_percent = true;
+            i += 1;
+            continue;
+        }
+        if is_percent {
+            return Err(GcodeError::Syntax {
+                line,
+                message: "unexpected token after '%' delimiter".to_string(),
+            });
+        }
+        if b == b'#' {
+            return Err(GcodeError::UnsupportedCode {
+                line,
+                code: "#".to_string(),
+                reason: "macro variables and '#' expressions are not supported".to_string(),
+            });
+        }
+        if matches!(b, b'[' | b']' | b'=') {
+            return Err(GcodeError::UnsupportedCode {
+                line,
+                code: (b as char).to_string(),
+                reason: "macro expressions are not supported".to_string(),
+            });
+        }
+        if b == b'/' {
+            return Err(GcodeError::UnsupportedCode {
+                line,
+                code: "/".to_string(),
+                reason: "optional block delete '/' is not supported".to_string(),
+            });
+        }
+        if !b.is_ascii_alphabetic() {
+            let ch = raw[i..].chars().next().unwrap_or('?');
+            return Err(GcodeError::Syntax {
+                line,
+                message: format!("unexpected character '{ch}'"),
+            });
+        }
+
+        // Reject multi-letter alphabetic identifiers (e.g. IF, GOTO, SUB, MOTON, CYCLE832).
+        let alpha_end = scan_alpha(bytes, i);
+        if alpha_end - i > 1 {
+            let ident = raw[i..alpha_end].to_ascii_uppercase();
+            if MACRO_KEYWORDS.contains(&ident.as_str()) {
+                return Err(GcodeError::UnsupportedCode {
+                    line,
+                    code: ident,
+                    reason: "macro/subprogram control flow is not supported".to_string(),
+                });
+            }
+            return Err(GcodeError::UnknownWord { line, word: ident });
+        }
+
+        let letter = (b as char).to_ascii_uppercase();
+        i += 1;
+        while i < len && (bytes[i] == b' ' || bytes[i] == b'\t') {
+            i += 1;
+        }
+        if i < len && bytes[i] == b'#' {
+            return Err(GcodeError::UnsupportedCode {
+                line,
+                code: "#".to_string(),
+                reason: "macro variables and '#' expressions are not supported".to_string(),
+            });
+        }
+        if i < len && bytes[i] == b'[' {
+            return Err(GcodeError::UnsupportedCode {
+                line,
+                code: "[".to_string(),
+                reason: "macro expressions are not supported".to_string(),
+            });
+        }
+        if letter == 'O' && i < len && bytes[i] == b'<' {
+            return Err(GcodeError::UnsupportedCode {
+                line,
+                code: "O<...>".to_string(),
+                reason: "named O-word subprograms are not supported".to_string(),
+            });
+        }
+
+        let (num_str, next_i) = scan_number(line, letter, raw, i)?;
+        i = next_i;
+
+        let value: f64 = num_str.parse().map_err(|_| GcodeError::Syntax {
+            line,
+            message: format!("invalid number '{num_str}' on word '{letter}'"),
+        })?;
+        if !value.is_finite() {
+            return Err(GcodeError::Syntax {
+                line,
+                message: format!("non-finite number '{num_str}' on word '{letter}'"),
+            });
+        }
+
+        if letter == 'O' {
+            let prog = parse_u32_token(line, letter, num_str)?;
+            if program_number.is_some() {
+                return Err(GcodeError::Syntax {
+                    line,
+                    message: "multiple O program numbers on one block".to_string(),
+                });
+            }
+            program_number = Some(prog);
+            continue;
+        }
+
+        if letter == 'N' {
+            let _seq = parse_u32_token(line, letter, num_str)?;
+            continue;
+        }
+
+        let code = if letter == 'G' || letter == 'M' {
+            Some(parse_code_num(line, letter, num_str)?)
+        } else {
+            None
+        };
+
+        words.push(Word {
+            letter,
+            value,
+            code,
+            raw: format!("{letter}{num_str}"),
+        });
+    }
+
+    if program_number.is_some() && !words.is_empty() {
+        return Err(GcodeError::Syntax {
+            line,
+            message: "program O-number cannot share a block with motion or modal words".to_string(),
+        });
+    }
+
+    Ok(ParsedLine {
+        line,
+        is_percent,
+        program_number,
+        words,
+    })
+}
+
+fn skip_paren_comment(line: usize, raw: &str, start: usize) -> Result<usize, GcodeError> {
+    let bytes = raw.as_bytes();
+    let mut i = start + 1;
+    while i < bytes.len() {
+        if bytes[i] == b'(' {
+            return Err(GcodeError::Syntax {
+                line,
+                message: "nested '(' inside comment".to_string(),
+            });
+        }
+        if bytes[i] == b')' {
+            return Ok(i + 1);
+        }
+        i += 1;
+    }
+    Err(GcodeError::Syntax {
+        line,
+        message: "unclosed '(' comment".to_string(),
+    })
+}
+
+fn scan_alpha(bytes: &[u8], start: usize) -> usize {
+    let mut i = start;
+    while i < bytes.len() && bytes[i].is_ascii_alphabetic() {
+        i += 1;
+    }
+    i
+}
+
+fn scan_number(line: usize, letter: char, raw: &str, start: usize) -> Result<(&str, usize), GcodeError> {
+    let bytes = raw.as_bytes();
+    let len = bytes.len();
+    let mut i = start;
+    if i < len && (bytes[i] == b'+' || bytes[i] == b'-') {
+        i += 1;
+    }
+    let mut digits = 0usize;
+    while i < len && bytes[i].is_ascii_digit() {
+        digits += 1;
+        i += 1;
+    }
+    if i < len && bytes[i] == b'.' {
+        i += 1;
+        while i < len && bytes[i].is_ascii_digit() {
+            digits += 1;
+            i += 1;
+        }
+    }
+    if digits == 0 {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("missing numeric value after word '{letter}'"),
+        });
+    }
+    if i < len && bytes[i] == b'.' {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("malformed number after word '{letter}'"),
+        });
+    }
+    Ok((&raw[start..i], i))
+}
+
+fn parse_u32_token(line: usize, letter: char, num_str: &str) -> Result<u32, GcodeError> {
+    if num_str.starts_with('-') || num_str.contains('.') {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("{letter} word requires a non-negative integer, got '{num_str}'"),
+        });
+    }
+    let trimmed = num_str.strip_prefix('+').unwrap_or(num_str);
+    trimmed.parse::<u32>().map_err(|_| GcodeError::Syntax {
+        line,
+        message: format!("{letter} number '{num_str}' out of range"),
+    })
+}
+
+fn parse_code_num(line: usize, letter: char, num_str: &str) -> Result<CodeNum, GcodeError> {
+    if num_str.starts_with('-') || num_str.starts_with('+') {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("signed {letter} code '{letter}{num_str}' is invalid"),
+        });
+    }
+    let (lhs, rhs_opt) = match num_str.split_once('.') {
+        Some((a, b)) => (a, Some(b)),
+        None => (num_str, None),
+    };
+    if lhs.is_empty() {
+        return Err(GcodeError::Syntax {
+            line,
+            message: format!("invalid code '{letter}{num_str}'"),
+        });
+    }
+    let major = lhs.parse::<u32>().map_err(|_| GcodeError::Syntax {
+        line,
+        message: format!("invalid code '{letter}{num_str}'"),
+    })?;
+    let minor = match rhs_opt {
+        None => None,
+        Some(rhs) => {
+            let trimmed = rhs.trim_end_matches('0');
+            if trimmed.is_empty() {
+                None
+            } else {
+                if letter == 'M' {
+                    return Err(GcodeError::Syntax {
+                        line,
+                        message: format!("M-code '{letter}{num_str}' cannot be fractional"),
+                    });
+                }
+                let m = trimmed.parse::<u32>().map_err(|_| GcodeError::Syntax {
+                    line,
+                    message: format!("invalid code '{letter}{num_str}'"),
+                })?;
+                Some(m)
+            }
+        }
+    };
+    let text = match minor {
+        Some(m) => format!("{major}.{m}"),
+        None => format!("{major}"),
+    };
+    Ok(CodeNum { major, minor, text })
+}
