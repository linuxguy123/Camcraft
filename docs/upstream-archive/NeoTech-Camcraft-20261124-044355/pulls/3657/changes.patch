index 000000000..4d9f35e44
--- /dev/null
+++ b/crates/gcode/tests/dialects_and_planes.rs
@@ -0,0 +1,95 @@
+//! Additional dialect preset, vertical-plane R-arc, and M-code tests for `camcraft-gcode`.
+//! Provenance: verifies 3-axis dialect conventions and G18/G19 R-radius arcs against RS-274/NGC and CamCraft post formats.
+
+use camcraft_cl::cl::{ArcPlane, CycleKind, MoveKind};
+use camcraft_gcode::{
+    parse, parse_with, Dialect, DwellUnit, ParseOptions, PathControlMode,
+};
+use camcraft_geometry::geo2d::Point2;
+
+#[test]
+fn vertical_plane_r_arcs_xz_and_yz_minor_and_major() {
+    let nc = "\
+G21 G90 G94
+G0 X10. Y0. Z0.
+G18 G2 X0. Z10. R10. F400
+G0 X0. Y10. Z0.
+G19 G3 Y0. Z10. R10.
+G0 X10. Y0. Z0.
+G18 G2 X0. Z10. R-10.
+M30";
+    let parsed = parse(nc).expect("XZ and YZ R-arcs");
+    let moves = &parsed.sections[0].toolpath.moves;
+
+    let xz_minor = parsed
+        .line_map
+        .moves_on_line(3)
+        .map(|(_, idx)| moves[idx].arc.expect("XZ minor arc"))
+        .collect::<Vec<_>>();
+    assert!(!xz_minor.is_empty());
+    assert_eq!(xz_minor[0].plane, ArcPlane::Xz);
+    assert_eq!(xz_minor[0].center, Point2::new(0.0, 0.0));
+
+    let yz_minor = parsed
+        .line_map
+        .moves_on_line(5)
+        .map(|(_, idx)| moves[idx].arc.expect("YZ minor arc"))
+        .collect::<Vec<_>>();
+    assert!(!yz_minor.is_empty());
+    assert_eq!(yz_minor[0].plane, ArcPlane::Yz);
+    assert_eq!(yz_minor[0].center, Point2::new(0.0, 0.0));
+
+    let xz_major = parsed
+        .line_map
+        .moves_on_line(7)
+        .map(|(_, idx)| moves[idx].arc.expect("XZ major arc"))
+        .collect::<Vec<_>>();
+    assert!(!xz_major.is_empty());
+    assert_eq!(xz_major[0].plane, ArcPlane::Xz);
+    assert_eq!(xz_major[0].center, Point2::new(10.0, 10.0));
+}
+
+#[test]
+fn dialects_dwell_units_ream_and_m6_tool_order() {
+    let nc = "\
+; compact Tormach/grblHAL style with M6 before T and G85 ream
+G21 G90 G94 G64 P0.025
+M6 T3
+S1800 M3 M88
+G00 X10. Y20. Z5.
+G01X15.Y20.F250
+G04 P1.5
+G85 X25. Y20. Z-12. R2. F120
+G80
+M89 M5 M9
+M30";
+
+    let tormach_opts = ParseOptions {
+        dialect: Dialect::tormach(),
+        ..Default::default()
+    };
+    let p_tormach = parse_with(nc, &tormach_opts).expect("tormach dialected program");
+    assert_eq!(p_tormach.tools, vec![3]);
+    assert_eq!(p_tormach.sections[0].tool_number, Some(3));
+    assert_eq!(
+        p_tormach.final_modal.path_control,
+        PathControlMode::Continuous {
+            tolerance_mm: Some(0.025)
+        }
+    );
+    assert!((p_tormach.dwells[0].seconds - 1.5).abs() < 1e-9);
+    let cyc = p_tormach.sections[0].toolpath.cycles[0];
+    assert_eq!(cyc.kind, CycleKind::Ream);
+    let first = cyc.first_move;
+    assert_eq!(p_tormach.sections[0].toolpath.moves[first].kind, MoveKind::Plunge);
+    assert_eq!(p_tormach.sections[0].toolpath.moves[first + 1].kind, MoveKind::Feed);
+    assert!(!p_tormach.final_modal.coolant.through_spindle);
+
+    let fanuc_opts = ParseOptions {
+        dialect: Dialect::fanuc(),
+        ..Default::default()
+    };
+    assert_eq!(fanuc_opts.dialect.g4_dwell_unit, DwellUnit::Milliseconds);
+    let p_fanuc = parse_with(nc, &fanuc_opts).expect("fanuc dialected program");
+    assert!((p_fanuc.dwells[0].seconds - 0.0015).abs() < 1e-9);
+}
diff --git a/crates/gcode/tests/gcode_3axis.rs b/crates/gcode/tests/gcode_3axis.rs
new file mode 100644
index 000000000..8616b4fd4
--- /dev/null
+++ b/crates/gcode/tests/gcode_3axis.rs
@@ -0,0 +1,400 @@
+//! Pinning tests for `camcraft-gcode` RS-274/NGC and ISO 6983 3-axis milling parsing.
+//! Gate map: covers gcode::types, gcode::lexer, gcode::arc, gcode::cycle, gcode::interp.
+
+use camcraft_cl::cl::{ArcPlane, CycleKind, MoveKind};
+use camcraft_gcode::{
+    parse, parse_with, ArcCenterMode, CycleReturnMode, Dialect, DistanceMode, GcodeError,
+    MotionMode, ParseOptions, PathControlMode, ProgramEnd, ReferencePositions, SpindleDir,
+    StopKind, WorkOffset,
+};
+use camcraft_geometry::geo2d::Point2;
+use camcraft_geometry::geometry::Point3;
+use camcraft_geometry::geometry::units::{MM_PER_INCH, Unit};
+
+fn approx(a: f64, b: f64, tol: f64) -> bool {
+    (a - b).abs() <= tol
+}
+
+fn assert_pt_near(got: Point3, want: Point3, tol: f64) {
+    assert!(
+        approx(got.x, want.x, tol) && approx(got.y, want.y, tol) && approx(got.z, want.z, tol),
+        "point mismatch: got {got:?}, want {want:?}"
+    );
+}
+
+#[test]
+fn modal_groups_track_and_sections_split_on_tool_changes() {
+    let nc = "\
+%
+O0001 (TWO TOOL TEST)
+G21
+G17 G90 G91.1 G94 G55 G40 G49 G80
+G61
+T1 M6
+G43 H1
+S8000 M3
+M8
+G0 X10. Y20. Z5.
+G1 Z-2. F200
+G1 X30. F600
+G91
+G1 X5. Y-5.
+G90
+M9
+M5
+M1
+T2 M6
+G43 H2
+G56
+G64 P0.025
+S12000 M4
+M7
+M88
+G0 X0. Y0. Z10.
+G4 P0.5
+G1 Z-1. F300
+M89
+M9
+M5
+M30
+%";
+    let opts = ParseOptions {
+        dialect: Dialect::tormach(),
+        ..Default::default()
+    };
+    let parsed = parse_with(nc, &opts).expect("valid two-tool program");
+
+    assert_eq!(parsed.program_number, Some(1));
+    assert_eq!(parsed.tools, vec![1, 2]);
+    assert_eq!(parsed.ended, Some(ProgramEnd::M30));
+    assert_eq!(parsed.sections.len(), 2);
+
+    let s0 = &parsed.sections[0];
+    assert_eq!(s0.tool_number, Some(1));
+    assert_eq!(s0.work_offset, WorkOffset::G55);
+    assert_eq!(s0.length_offset, Some(1));
+    assert_eq!(s0.spindle_rpm, Some(8000.0));
+    assert_eq!(s0.spindle_dir, SpindleDir::Cw);
+    assert!(s0.toolpath.is_chained());
+    assert_eq!(s0.toolpath.moves.len(), 4);
+    assert_eq!(s0.move_lines, vec![10, 11, 12, 14]);
+    assert_eq!(s0.toolpath.moves[0].kind, MoveKind::Rapid);
+    assert_pt_near(s0.toolpath.moves[0].to, Point3::new(10.0, 20.0, 5.0), 1e-6);
+    assert_eq!(s0.toolpath.moves[1].kind, MoveKind::Feed);
+    assert_eq!(s0.toolpath.moves[1].feed, Some(200.0));
+    assert_pt_near(s0.toolpath.moves[1].to, Point3::new(10.0, 20.0, -2.0), 1e-6);
