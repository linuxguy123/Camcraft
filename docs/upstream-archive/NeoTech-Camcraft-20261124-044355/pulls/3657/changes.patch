+++ b/crates/gcode/src/block_codes.rs
@@ -0,0 +1,238 @@
+//! G-code and M-code modal-group decoding and parameter-word checks.
+//! Provenance: G/M code tables and unused parameter checks from RS-274/NGC (NISTIR 6556 Tables 4-7) and ISO 6983.
+
+use camcraft_cl::cl::ArcPlane;
+use camcraft_geometry::geometry::units::Unit;
+
+use crate::block::{set_group, DecodedBlock, Group1G, LengthOp, NonModalG, PathControlG, StopOrEnd};
+use crate::lexer::Word;
+use crate::types::{
+    ArcCenterMode, CycleReturnMode, CycleType, DistanceMode, FeedMode, GcodeError, SpindleDir,
+    StopKind, WorkOffset,
+};
+
+pub fn apply_g(line: usize, b: &mut DecodedBlock, w: &Word) -> Result<(), GcodeError> {
+    let Some(c) = &w.code else {
+        return Err(GcodeError::UnknownWord {
+            line,
+            word: w.raw.clone(),
+        });
+    };
+    let name = c.label('G');
+    match (c.major, c.minor) {
+        (0, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Rapid),
+        (1, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Linear),
+        (2, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::ArcCw),
+        (3, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::ArcCcw),
+        (4, None) => set_group(line, "Group 0 (non-modal)", &mut b.non_modal, NonModalG::Dwell),
+        (17, None) => set_group(line, "Group 2 (plane)", &mut b.plane, ArcPlane::Xy),
+        (18, None) => set_group(line, "Group 2 (plane)", &mut b.plane, ArcPlane::Xz),
+        (19, None) => set_group(line, "Group 2 (plane)", &mut b.plane, ArcPlane::Yz),
+        (20, None) => set_group(line, "Group 6 (units)", &mut b.units, Unit::Inches),
+        (21, None) => set_group(line, "Group 6 (units)", &mut b.units, Unit::Millimeters),
+        (28, None) => set_group(line, "Group 0 (non-modal)", &mut b.non_modal, NonModalG::HomeG28),
+        (30, None) => set_group(line, "Group 0 (non-modal)", &mut b.non_modal, NonModalG::SecondaryG30),
+        (40, None) => {
+            if b.comp_off {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "duplicate G40 on block".to_string(),
+                });
+            }
+            b.comp_off = true;
+            Ok(())
+        }
+        (43, None) => set_group(line, "Group 8 (length offset)", &mut b.length_op, LengthOp::Apply),
+        (49, None) => set_group(line, "Group 8 (length offset)", &mut b.length_op, LengthOp::Cancel),
+        (53, None) => {
+            if b.g53 {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "duplicate G53 on block".to_string(),
+                });
+            }
+            b.g53 = true;
+            Ok(())
+        }
+        (54, None) => set_group(line, "Group 12 (work offset)", &mut b.work_offset, WorkOffset::G54),
+        (55, None) => set_group(line, "Group 12 (work offset)", &mut b.work_offset, WorkOffset::G55),
+        (56, None) => set_group(line, "Group 12 (work offset)", &mut b.work_offset, WorkOffset::G56),
+        (57, None) => set_group(line, "Group 12 (work offset)", &mut b.work_offset, WorkOffset::G57),
+        (58, None) => set_group(line, "Group 12 (work offset)", &mut b.work_offset, WorkOffset::G58),
+        (59, None) => set_group(line, "Group 12 (work offset)", &mut b.work_offset, WorkOffset::G59),
+        (61, None) => set_group(line, "Group 13 (path control)", &mut b.path_control, PathControlG::ExactStop),
+        (64, None) => set_group(line, "Group 13 (path control)", &mut b.path_control, PathControlG::Continuous),
+        (73, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::ChipBreakPeck)),
+        (80, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cancel),
+        (81, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::Drill)),
+        (82, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::DwellDrill)),
+        (83, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::DeepPeck)),
+        (84, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::Tap)),
+        (85, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::Ream)),
+        (86, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::Bore)),
+        (89, None) => set_group(line, "Group 1 (motion)", &mut b.group1, Group1G::Cycle(CycleType::BackBore)),
+        (90, None) => set_group(line, "Group 3 (distance)", &mut b.distance, DistanceMode::Absolute),
+        (91, None) => set_group(line, "Group 3 (distance)", &mut b.distance, DistanceMode::Incremental),
+        (90, Some(1)) => set_group(line, "arc center mode", &mut b.arc_center, ArcCenterMode::Absolute),
+        (91, Some(1)) => set_group(line, "arc center mode", &mut b.arc_center, ArcCenterMode::Incremental),
+        (94, None) => set_group(line, "Group 5 (feed mode)", &mut b.feed_mode, FeedMode::PerMinute),
+        (98, None) => set_group(line, "Group 10 (cycle return)", &mut b.cycle_return, CycleReturnMode::InitialZ),
+        (99, None) => set_group(line, "Group 10 (cycle return)", &mut b.cycle_return, CycleReturnMode::RPlane),
+        (41 | 42, None) | (41 | 42, Some(1)) => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "cutter radius compensation (G41/G42) is not supported".to_string(),
+        }),
+        (65..=67, None) | (66, Some(1)) => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "macro calls (G65/G66/G67) are not supported".to_string(),
+        }),
+        (31, None) | (38, Some(2..=5)) => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "probing moves (G31/G38.2) are not supported".to_string(),
+        }),
+        (43, Some(4 | 5)) => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "RTCP (G43.4) is not supported in 3-axis milling mode".to_string(),
+        }),
+        (93 | 95, None) => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "only G94 feed-per-minute mode is supported".to_string(),
+        }),
+        _ => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "unsupported G-code in 3-axis ISO mode".to_string(),
+        }),
+    }
+}
+
+pub fn apply_m(line: usize, b: &mut DecodedBlock, w: &Word) -> Result<(), GcodeError> {
+    let Some(c) = &w.code else {
+        return Err(GcodeError::UnknownWord {
+            line,
+            word: w.raw.clone(),
+        });
+    };
+    let name = c.label('M');
+    match c.major {
+        0 => set_group(line, "program stop/end", &mut b.stop_or_end, StopOrEnd::Stop(StopKind::ProgramStop)),
+        1 => set_group(line, "program stop/end", &mut b.stop_or_end, StopOrEnd::Stop(StopKind::OptionalStop)),
+        2 => set_group(line, "program stop/end", &mut b.stop_or_end, StopOrEnd::EndM2),
+        30 => set_group(line, "program stop/end", &mut b.stop_or_end, StopOrEnd::EndM30),
+        3 => set_group(line, "spindle", &mut b.spindle_dir, SpindleDir::Cw),
+        4 => set_group(line, "spindle", &mut b.spindle_dir, SpindleDir::Ccw),
+        5 => set_group(line, "spindle", &mut b.spindle_dir, SpindleDir::Off),
+        6 => {
+            if b.tool_change {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "duplicate M6 on block".to_string(),
+                });
+            }
+            b.tool_change = true;
+            Ok(())
+        }
+        7 => {
+            if b.coolant_off {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "M7 cannot share a block with M9".to_string(),
+                });
+            }
+            b.mist_on = true;
+            Ok(())
+        }
+        8 => {
+            if b.coolant_off {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "M8 cannot share a block with M9".to_string(),
+                });
+            }
+            b.flood_on = true;
+            Ok(())
+        }
+        9 => {
+            if b.mist_on || b.flood_on {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: "M9 cannot share a block with M7 or M8".to_string(),
+                });
+            }
+            b.coolant_off = true;
+            Ok(())
+        }
+        88 => set_group(line, "through-spindle coolant", &mut b.tsc, true)
+            .map_err(|_| GcodeError::InvalidModal { line, message: "conflicting M88/M89 on block".into() }),
+        89 => set_group(line, "through-spindle coolant", &mut b.tsc, false)
+            .map_err(|_| GcodeError::InvalidModal { line, message: "conflicting M88/M89 on block".into() }),
+        98 | 99 => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "subprogram calls (M98/M99) are not supported".to_string(),
+        }),
+        _ => Err(GcodeError::UnsupportedCode {
+            line,
+            code: name,
+            reason: "unsupported M-code in 3-axis ISO mode".to_string(),
+        }),
+    }
+}
+
+pub fn check_unused_words(
+    b: &DecodedBlock,
+    allow_ijk: bool,
+    allow_r: bool,
+    allow_p: bool,
+    allow_q: bool,
+    allow_h: bool,
+    allow_l: bool,
+) -> Result<(), GcodeError> {
+    let line = b.line;
+    if !allow_ijk {
+        for (ch, v) in [('I', b.i), ('J', b.j), ('K', b.k)] {
+            if v.is_some() {
+                return Err(GcodeError::InvalidModal {
+                    line,
+                    message: format!("word '{ch}' is only valid in G2/G3 arc blocks"),
+                });
+            }
+        }
+    }
+    if !allow_r && b.r.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "word 'R' is only valid in G2/G3 arcs or canned cycles".to_string(),
+        });
+    }
+    if !allow_p && b.p.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "word 'P' is only valid with G4, G64, or canned cycles".to_string(),
+        });
+    }
+    if !allow_q && b.q.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "word 'Q' is only valid with G73, G83, or G64".to_string(),
+        });
+    }
+    if !allow_h && b.h.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "word 'H' requires G43 on the same block".to_string(),
+        });
+    }
+    if !allow_l && b.l.is_some() {
+        return Err(GcodeError::InvalidModal {
+            line,
+            message: "word 'L' is only valid in canned cycle blocks".to_string(),
+        });
+    }
+    Ok(())
+}
diff --git a/crates/gcode/src/cycle.rs b/crates/gcode/src/cycle.rs
new file mode 100644
index 000000000..46a484e28
--- /dev/null
+++ b/crates/gcode/src/cycle.rs
@@ -0,0 +1,393 @@
+//! Canned cycle validation and expansion into explicit `cl::Move` chains and `cl::Cycle` records.
+//! Provenance: cycle motion geometry from RS-274/NGC (NISTIR 6556 §3.5.16) and CamCraft's canonical drilling chains (`crates/motion/src/drilling/cycle.rs`).
+
+use camcraft_cl::cl::{lattice, Cycle, CycleKind, MoveKind, PathBuilder};
+use camcraft_geometry::geo2d::Point2;
+use camcraft_geometry::geometry::Point3;
+
+use crate::types::{CycleReturnMode, CycleType, DistanceMode, GcodeError};
+
+/// Sticky parameters for an active canned-cycle modal group.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ActiveCycle {
+    pub kind: CycleType,
+    pub initial_z: f64,
+    pub r_z: f64,
+    pub bottom_z: f64,
+    pub peck_mm: f64,
+    pub dwell_s: f64,
+}
+
+/// Parameters parsed from one canned-cycle block (in mm and seconds).
+#[derive(Clone, Copy, Debug)]
+pub struct CycleBlockInput {
+    pub line: usize,
+    pub kind: CycleType,
+    pub is_new_cycle: bool,
+    pub distance: DistanceMode,
+    pub return_mode: CycleReturnMode,
+    pub x_mm: Option<f64>,
+    pub y_mm: Option<f64>,
+    pub z_mm: Option<f64>,
+    pub r_mm: Option<f64>,
+    pub q_mm: Option<f64>,
+    pub p_sec: Option<f64>,
+    pub repeat: u32,
+    pub feed_mm_min: f64,
+    pub chip_break_retract_mm: f64,
+}
+
+const MAX_PECKS: f64 = 4096.0;
+
+/// Validate and expand one canned-cycle block (with optional `L` repeats) onto `builder`.
+pub fn execute_cycle_block(
+    input: CycleBlockInput,
+    active: &mut Option<ActiveCycle>,
+    cur: &mut Point3,
+    builder: &mut PathBuilder,
+    move_lines: &mut Vec<usize>,
+) -> Result<(), GcodeError> {
+    let line = input.line;
+    let same_active = active.filter(|a| a.kind == input.kind && !input.is_new_cycle);
+    let initial_z = same_active.map_or(cur.z, |a| a.initial_z);
+
+    let r_z = match input.r_mm {
+        Some(r) => match input.distance {
+            DistanceMode::Absolute => r,
+            DistanceMode::Incremental => initial_z + r,
+        },
+        None => same_active.map(|a| a.r_z).ok_or_else(|| GcodeError::InvalidCycle {
+            line,
+            message: format!("canned cycle {:?} requires R retract plane", input.kind),
+        })?,
+    };
+
+    let bottom_z = match input.z_mm {
+        Some(z) => match input.distance {
+            DistanceMode::Absolute => z,
+            DistanceMode::Incremental => r_z + z,
+        },
+        None => same_active.map(|a| a.bottom_z).ok_or_else(|| GcodeError::InvalidCycle {
+            line,
+            message: format!("canned cycle {:?} requires Z depth", input.kind),
+        })?,
+    };
+
+    if !r_z.is_finite() || !bottom_z.is_finite() || bottom_z >= r_z {
+        return Err(GcodeError::InvalidCycle {
+            line,
+            message: format!("bottom Z ({bottom_z:.4}) must be below R plane ({r_z:.4})"),
+        });
+    }
+
+    let peck_mm = resolve_peck(input, same_active, r_z, bottom_z)?;
+    let dwell_s = resolve_dwell(input, same_active)?;
+
+    *active = Some(ActiveCycle {
+        kind: input.kind,
+        initial_z,
+        r_z,
+        bottom_z,
+        peck_mm,
+        dwell_s,
+    });
+
+    if input.repeat == 0 {
+        return Ok(());
+    }
+
+    for rep in 0..input.repeat {
+        let (hx, hy) = match input.distance {
+            DistanceMode::Absolute => (
+                input.x_mm.unwrap_or(cur.x),
+                input.y_mm.unwrap_or(cur.y),
+            ),
+            DistanceMode::Incremental => (
+                cur.x + input.x_mm.unwrap_or(0.0),
+                cur.y + input.y_mm.unwrap_or(0.0),
+            ),
+        };
+        let _ = rep;
+        expand_single_hole(
+            input.line,
+            input.kind,
+            input.return_mode,
+            initial_z,
+            hx,
+            hy,
+            r_z,
+            bottom_z,
+            peck_mm,
+            dwell_s,
+            input.feed_mm_min,
+            input.chip_break_retract_mm,
+            cur,
+            builder,
+            move_lines,
+        );
+    }
+
+    Ok(())
+}
+
+fn resolve_peck(
+    input: CycleBlockInput,
+    same_active: Option<ActiveCycle>,
+    r_z: f64,
+    bottom_z: f64,
+) -> Result<f64, GcodeError> {
+    let needs_peck = matches!(input.kind, CycleType::ChipBreakPeck | CycleType::DeepPeck);
+    if !needs_peck {
+        if input.q_mm.is_some() {
+            return Err(GcodeError::InvalidCycle {
+                line: input.line,
+                message: format!("Q peck depth is not valid for {:?}", input.kind),
+            });
+        }
+        return Ok(0.0);
+    }
+
+    let q = match input.q_mm {
+        Some(v) => v,
+        None => same_active.map(|a| a.peck_mm).ok_or_else(|| GcodeError::InvalidCycle {
+            line: input.line,
+            message: format!("peck cycle {:?} requires positive Q increment", input.kind),
+        })?,
+    };
+    if !q.is_finite() || q <= 0.0 {
+        return Err(GcodeError::InvalidCycle {
+            line: input.line,
+            message: format!("peck increment Q ({q}) must be positive"),
+        });
+    }
+    if (r_z - bottom_z) / q > MAX_PECKS {
+        return Err(GcodeError::InvalidCycle {
+            line: input.line,
+            message: "peck increment Q is too small (exceeds 4096 pecks per hole)".to_string(),
+        });
+    }
+    Ok(q)
+}
+
+fn resolve_dwell(
+    input: CycleBlockInput,
+    same_active: Option<ActiveCycle>,
+) -> Result<f64, GcodeError> {
+    let allows_dwell = matches!(
+        input.kind,
+        CycleType::DwellDrill | CycleType::DeepPeck | CycleType::Bore | CycleType::BackBore
+    );
+    if !allows_dwell {
+        if input.p_sec.is_some() {
+            return Err(GcodeError::InvalidCycle {
+                line: input.line,
+                message: format!("P dwell is not valid for {:?}", input.kind),
+            });
+        }
+        return Ok(0.0);
+    }
+
+    let p = match input.p_sec {
+        Some(v) => v,
+        None if input.kind == CycleType::DwellDrill => {
+            same_active.map(|a| a.dwell_s).ok_or_else(|| GcodeError::InvalidCycle {
+                line: input.line,
+                message: "G82 dwell cycle requires P dwell word".to_string(),
+            })?
+        }
+        None => same_active.map_or(0.0, |a| a.dwell_s),
+    };
+    if !p.is_finite() || p < 0.0 {
+        return Err(GcodeError::InvalidCycle {
+            line: input.line,
+            message: format!("dwell P ({p}) must be non-negative"),
+        });
+    }
+    Ok(p)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn expand_single_hole(
+    line: usize,
+    kind: CycleType,
+    return_mode: CycleReturnMode,
+    initial_z: f64,
+    hx: f64,
+    hy: f64,
+    r_z: f64,
+    bottom_z: f64,
+    peck_mm: f64,
+    dwell_s: f64,
+    feed: f64,
+    chip_break_retract_mm: f64,
+    cur: &mut Point3,
+    builder: &mut PathBuilder,
+    move_lines: &mut Vec<usize>,
+) {
+    let push_tracked = |builder: &mut PathBuilder,
+                        move_lines: &mut Vec<usize>,
+                        k: MoveKind,
+                        to: Point3,
+                        f: Option<f64>| {
+        let before = builder.moves_len();
+        builder.push(k, to, f);
+        let after = builder.moves_len();
+        for _ in before..after {
+            move_lines.push(line);
+        }
+    };
+
+    // Preliminary positioning: lift to R first if currently below R, then XY, then R.
+    if cur.z < r_z - 1e-9 {
+        let p = Point3::new(cur.x, cur.y, r_z);
+        push_tracked(builder, move_lines, MoveKind::Rapid, p, None);
+        *cur = p;
+    }
+    let over_hole = Point3::new(hx, hy, cur.z);
+    push_tracked(builder, move_lines, MoveKind::Rapid, over_hole, None);
+    *cur = over_hole;
+
+    let at_r = Point3::new(hx, hy, r_z);
+    push_tracked(builder, move_lines, MoveKind::Rapid, at_r, None);
+    *cur = at_r;
+
+    let retract_z = match return_mode {
+        CycleReturnMode::InitialZ => initial_z.max(r_z),
+        CycleReturnMode::RPlane => r_z,
+    };
+    let first_move = builder.moves_len();
+
+    match kind {
+        CycleType::Drill | CycleType::DwellDrill | CycleType::Bore => {
+            push_tracked(
+                builder,
+                move_lines,
+                MoveKind::Plunge,
+                Point3::new(hx, hy, bottom_z),
+                Some(feed),
+            );
+            let out = Point3::new(hx, hy, retract_z);
+            push_tracked(builder, move_lines, MoveKind::Rapid, out, None);
+            *cur = out;
+        }
+        CycleType::ChipBreakPeck => {
+            let mut t = (r_z - peck_mm).max(bottom_z);
+            loop {
+                push_tracked(
+                    builder,
+                    move_lines,
+                    MoveKind::Plunge,
+                    Point3::new(hx, hy, t),
+                    Some(feed),
+                );
+                if t <= bottom_z + 1e-9 {
+                    break;
+                }
+                let up = (t + chip_break_retract_mm).min(r_z);
+                push_tracked(
+                    builder,
+                    move_lines,
+                    MoveKind::Rapid,
+                    Point3::new(hx, hy, up),
+                    None,
+                );
+                t = (t - peck_mm).max(bottom_z);
+            }
+            let out = Point3::new(hx, hy, retract_z);
+            push_tracked(builder, move_lines, MoveKind::Rapid, out, None);
+            *cur = out;
+        }
+        CycleType::DeepPeck => {
+            let mut t = (r_z - peck_mm).max(bottom_z);
+            loop {
+                push_tracked(
+                    builder,
+                    move_lines,
+                    MoveKind::Plunge,
+                    Point3::new(hx, hy, t),
+                    Some(feed),
+                );
+                if t <= bottom_z + 1e-9 {
+                    break;
+                }
+                push_tracked(
+                    builder,
+                    move_lines,
+                    MoveKind::Rapid,
+                    Point3::new(hx, hy, r_z),
+                    None,
+                );
+                t = (t - peck_mm).max(bottom_z);
+            }
+            let out = Point3::new(hx, hy, retract_z);
+            push_tracked(builder, move_lines, MoveKind::Rapid, out, None);
+            *cur = out;
+        }
+        CycleType::Tap => {
+            push_tracked(
+                builder,
+                move_lines,
+                MoveKind::Feed,
+                Point3::new(hx, hy, bottom_z),
+                Some(feed),
+            );
+            push_tracked(
+                builder,
+                move_lines,
+                MoveKind::Feed,
+                Point3::new(hx, hy, r_z),
+                Some(feed),
+            );
+            if retract_z > r_z + 1e-9 {
+                let out = Point3::new(hx, hy, retract_z);
+                push_tracked(builder, move_lines, MoveKind::Rapid, out, None);
+                *cur = out;
+            } else {
+                *cur = at_r;
+            }
+        }
+        CycleType::Ream | CycleType::BackBore => {
+            push_tracked(
+                builder,
+                move_lines,
+                MoveKind::Plunge,
+                Point3::new(hx, hy, bottom_z),
+                Some(feed),
+            );
+            push_tracked(
+                builder,
+                move_lines,
+                MoveKind::Feed,
+                Point3::new(hx, hy, r_z),
+                Some(feed),
+            );
+            if retract_z > r_z + 1e-9 {
+                let out = Point3::new(hx, hy, retract_z);
+                push_tracked(builder, move_lines, MoveKind::Rapid, out, None);
+                *cur = out;
+            } else {
+                *cur = at_r;
+            }
+        }
+    }
+
+    let cl_kind = match kind {
+        CycleType::ChipBreakPeck => CycleKind::Peck,
+        CycleType::Drill | CycleType::DwellDrill => CycleKind::Drill,
+        CycleType::DeepPeck => CycleKind::Deep,
+        CycleType::Tap => CycleKind::Tap,
+        CycleType::Ream => CycleKind::Ream,
+        CycleType::Bore => CycleKind::Bore,
+        CycleType::BackBore => CycleKind::BackBore,
+    };
+    builder.push_cycle(Cycle {
+        kind: cl_kind,
+        xy: Point2::new(lattice(hx), lattice(hy)),
+        r_z: lattice(r_z),
+        bottom_z: lattice(bottom_z),
+        entry_z: lattice(r_z),
+        peck: lattice(peck_mm),
+        dwell: dwell_s,
+        first_move,
+    });
+}
diff --git a/crates/gcode/src/dialect.rs b/crates/gcode/src/dialect.rs
new file mode 100644
index 000000000..12a949881
--- /dev/null
+++ b/crates/gcode/src/dialect.rs
@@ -0,0 +1,199 @@
+//! Caller dialect presets, machine reference positions, and initial modal state.
+//! Provenance: controller dwell/arc presets follow public Fanuc, Haas, LinuxCNC/PathPilot, grblHAL, TinyG, Carvera docs and CamCraft post contracts (`assets/posts/*.cps`).
+
+use camcraft_cl::cl::ArcPlane;
+use camcraft_geometry::geometry::Point3;
+use camcraft_geometry::geometry::units::Unit;
+
+use crate::types::{
+    ArcCenterMode, CoolantState, CycleReturnMode, DistanceMode, FeedMode, MotionMode,
+    PathControlMode, SpindleDir, WorkOffset,
+};
+
+/// How `P` dwell values are scaled to seconds.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum DwellUnit {
+    /// `P` is in seconds (RS-274/NGC, LinuxCNC, Tormach, grblHAL, TinyG, Carvera).
+    #[default]
+    Seconds,
+    /// `P` is in milliseconds (Fanuc, Haas).
+    Milliseconds,
+}
+
+/// Dialect configuration passed by the caller.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Dialect {
+    pub name: String,
+    pub default_arc_center: ArcCenterMode,
+    pub default_unit: Option<Unit>,
+    pub cycle_dwell_unit: DwellUnit,
+    pub g4_dwell_unit: DwellUnit,
+    pub arc_radius_tolerance_mm: f64,
+    pub chip_break_retract_mm: f64,
+    pub initial_position: Point3,
+}
+
+impl Default for Dialect {
+    fn default() -> Self {
+        Self::rs274()
+    }
+}
+
+impl Dialect {
+    /// Default RS-274/NGC dialect: `G91.1`, no fallback unit, dwell `P` in seconds.
+    #[must_use]
+    pub fn rs274() -> Self {
+        Self {
+            name: "rs274".to_string(),
+            default_arc_center: ArcCenterMode::Incremental,
+            default_unit: None,
+            cycle_dwell_unit: DwellUnit::Seconds,
+            g4_dwell_unit: DwellUnit::Seconds,
+            arc_radius_tolerance_mm: 0.02,
+            chip_break_retract_mm: 1.0,
+            initial_position: Point3::ZERO,
+        }
+    }
+
+    /// Fanuc 3-axis milling profile (`G91.1`, `P` in milliseconds).
+    #[must_use]
+    pub fn fanuc() -> Self {
+        Self {
+            name: "fanuc".to_string(),
+            cycle_dwell_unit: DwellUnit::Milliseconds,
+            g4_dwell_unit: DwellUnit::Milliseconds,
+            ..Self::rs274()
+        }
+    }
+
+    /// Haas 3-axis milling profile (`G91.1`, `P` in milliseconds).
+    #[must_use]
+    pub fn haas() -> Self {
+        Self {
+            name: "haas".to_string(),
+            cycle_dwell_unit: DwellUnit::Milliseconds,
+            g4_dwell_unit: DwellUnit::Milliseconds,
+            ..Self::rs274()
+        }
+    }
+
+    /// Tormach PathPilot 3-axis profile (`G91.1`, `P` in seconds).
+    #[must_use]
+    pub fn tormach() -> Self {
+        Self {
+            name: "tormach".to_string(),
+            ..Self::rs274()
+        }
+    }
+
+    /// grblHAL 3-axis profile (`G91.1`, `P` in seconds).
+    #[must_use]
+    pub fn grblhal() -> Self {
+        Self {
+            name: "grblhal".to_string(),
+            ..Self::rs274()
+        }
+    }
+
+    /// Synthetos TinyG 3-axis profile (`G91.1`, `P` in seconds).
+    #[must_use]
+    pub fn tinyg() -> Self {
+        Self {
+            name: "tinyg".to_string(),
+            ..Self::rs274()
+        }
+    }
+
+    /// Makera Carvera 3-axis profile (`G91.1`, `P` in seconds).
+    #[must_use]
+    pub fn carvera() -> Self {
+        Self {
+            name: "carvera".to_string(),
+            ..Self::rs274()
+        }
+    }
+}
+
+/// Optional machine reference points and work-offset origins (in machine mm).
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ReferencePositions {
+    /// Machine-coordinate `G28` home position (mm).
+    pub g28: Option<Point3>,
+    /// Machine-coordinate `G30` secondary reference position (mm).
+    pub g30: Option<Point3>,
+    /// Default machine-coordinate origin of the active work offset for `G53` moves (mm).
+    pub g53_origin: Option<Point3>,
+    /// Optional per-WCS origins in machine coordinates (`G54`..`G59`), overriding `g53_origin`.
+    pub wcs_origins: [Option<Point3>; 6],
+}
+
+impl ReferencePositions {
+    /// Convenience preset with `(0, 0, 0)` reference points for `G28`, `G30`, and `G53`.
+    #[must_use]
+    pub fn zero() -> Self {
+        Self {
+            g28: Some(Point3::ZERO),
+            g30: Some(Point3::ZERO),
+            g53_origin: Some(Point3::ZERO),
+            wcs_origins: [None; 6],
+        }
+    }
+
+    /// Machine-coordinate origin for `wcs`, falling back to `g53_origin`.
+    #[must_use]
+    pub fn wcs_origin(&self, wcs: WorkOffset) -> Option<Point3> {
+        self.wcs_origins[wcs.index()].or(self.g53_origin)
+    }
+}
+
+/// Caller configuration for parsing a 3-axis NC program.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ParseOptions {
+    pub dialect: Dialect,
+    pub references: ReferencePositions,
+}
+
+/// Snapshot of modal groups tracked during parsing.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ModalState {
+    pub motion: MotionMode,
+    pub plane: ArcPlane,
+    pub distance: DistanceMode,
+    pub arc_center: ArcCenterMode,
+    pub feed_mode: FeedMode,
+    pub units: Option<Unit>,
+    pub length_offset: Option<u32>,
+    pub work_offset: WorkOffset,
+    pub cycle_return: CycleReturnMode,
+    pub path_control: PathControlMode,
+    pub feed_rate_mm_min: Option<f64>,
+    pub spindle_rpm: Option<f64>,
+    pub spindle_dir: SpindleDir,
+    pub coolant: CoolantState,
+    pub active_tool: Option<u32>,
+    pub pending_tool: Option<u32>,
+}
+
+impl ModalState {
+    #[must_use]
+    pub fn from_dialect(dialect: &Dialect) -> Self {
+        Self {
+            motion: MotionMode::None,
+            plane: ArcPlane::Xy,
+            distance: DistanceMode::Absolute,
+            arc_center: dialect.default_arc_center,
+            feed_mode: FeedMode::PerMinute,
+            units: dialect.default_unit,
+            length_offset: None,
+            work_offset: WorkOffset::G54,
+            cycle_return: CycleReturnMode::InitialZ,
+            path_control: PathControlMode::default(),
+            feed_rate_mm_min: None,
+            spindle_rpm: None,
+            spindle_dir: SpindleDir::Off,
+            coolant: CoolantState::default(),
+            active_tool: None,
+            pending_tool: None,
+        }
+    }
+}
diff --git a/crates/gcode/src/error.rs b/crates/gcode/src/error.rs
new file mode 100644
index 000000000..1fd63b37a
--- /dev/null
+++ b/crates/gcode/src/error.rs
@@ -0,0 +1,51 @@
+//! Line-numbered error types for RS-274/ISO 6983 parsing and validation.
+//! Provenance: clean-room refusal taxonomy derived from RS-274/NGC (NISTIR 6556) and CamCraft's named-refusal contract.
+
+/// Line-numbered parser and validation errors.
+#[derive(Clone, Debug, PartialEq, thiserror::Error)]
+pub enum GcodeError {
+    #[error("line {line}: syntax error: {message}")]
+    Syntax { line: usize, message: String },
+
+    #[error("line {line}: unknown word '{word}'")]
+    UnknownWord { line: usize, word: String },
+
+    #[error("line {line}: missing unit mode (G20 or G21 must precede motion coordinates)")]
+    MissingUnitMode { line: usize },
+
+    #[error("line {line}: unsupported {code}: {reason}")]
+    UnsupportedCode {
+        line: usize,
+        code: String,
+        reason: String,
+    },
+
+    #[error("line {line}: {code} requires a configured machine reference position")]
+    MissingReferencePosition { line: usize, code: String },
+
+    #[error("line {line}: invalid arc: {message}")]
+    InvalidArc { line: usize, message: String },
+
+    #[error("line {line}: invalid canned cycle: {message}")]
+    InvalidCycle { line: usize, message: String },
+
+    #[error("line {line}: invalid modal state: {message}")]
+    InvalidModal { line: usize, message: String },
+}
+
+impl GcodeError {
+    /// 1-based NC line number where the error occurred.
+    #[must_use]
+    pub const fn line(&self) -> usize {
+        match self {
+            GcodeError::Syntax { line, .. }
+            | GcodeError::UnknownWord { line, .. }
+            | GcodeError::MissingUnitMode { line }
+            | GcodeError::UnsupportedCode { line, .. }
+            | GcodeError::MissingReferencePosition { line, .. }
+            | GcodeError::InvalidArc { line, .. }
+            | GcodeError::InvalidCycle { line, .. }
+            | GcodeError::InvalidModal { line, .. } => *line,
+        }
+    }
+}
diff --git a/crates/gcode/src/interp.rs b/crates/gcode/src/interp.rs
