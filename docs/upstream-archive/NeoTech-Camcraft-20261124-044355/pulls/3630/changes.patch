+fn a_model_with_a_non_finite_facet_is_refused_by_name() {
+    // The review's reproduction: one NaN facet on an otherwise valid
+    // model. The radius and distance folds dropped the NaN, and the
+    // kernel answered Ok.
+    let t = ball(6.0);
+    let mut facets = boxy();
+    facets.push(Triangle::new(
