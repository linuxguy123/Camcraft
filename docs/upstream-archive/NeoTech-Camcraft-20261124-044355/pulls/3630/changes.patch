+    let nb = boxes_of(&near);
+    let c = ball_center(&ax, &b, &near, &nb, -std::f64::consts::FRAC_PI_2, 0.3, 20.0, 1.0, 0.01).unwrap();
+    assert!(c.x > 21.0 && c.x < 21.1, "{c:?}");
+}
