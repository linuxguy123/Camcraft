diff --git a/crates/app/src/prefs_setups.rs b/crates/app/src/prefs_setups.rs
new file mode 100644
index 000000000..0b39b45da
--- /dev/null
+++ b/crates/app/src/prefs_setups.rs
@@ -0,0 +1,225 @@
+//! Saved panel setups (#2339): per-user dock arrangements stored in
+//! `panel-setups.json` beside `prefs.json`, split from `prefs.rs` along the
+//! domain seam for the 400-line law.
+//!
+//! Provenance: our own design specced from issue #2339; the folder and
+//! atomic write are `app::recent`'s (#662).
+
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+/// The saved panel-setup file's name inside the config folder. It is a
+/// file of its own: a corrupt or older setup never takes the theme and
+/// colour-vision preferences down with it.
+pub const SETUPS_FILE_NAME: &str = "panel-setups.json";
+/// The format tag the setups file carries; any other tag is refused.
+pub const SETUPS_FORMAT: &str = "camcraft-panel-setups/1";
+/// The longest setup name the store keeps, in characters.
+pub const SETUP_NAME_MAX: usize = 48;
+
+/// One named arrangement: the dock's own JSON, kept opaque here. The
+/// surface owns what a dock looks like (splits, tab order, a float rect);
+/// this module only keeps the value, writes it and gives it back.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SavedSetup {
+    pub name: String,
+    pub dock: serde_json::Value,
+}
+
+/// The person's saved panel setups (#2339): which panels are open, where
+/// each is attached and how. This is the screen's, not the part's, so it
+/// lives beside the theme and colour-vision preferences and never in the
+/// project file.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PanelSetups {
+    /// Show `last` at the next start.
+    pub auto_load: bool,
+    /// The setup the user saved or loaded most recently.
+    pub last: Option<String>,
+    /// In the order the user saved them.
+    pub setups: Vec<SavedSetup>,
+}
+
+impl Default for PanelSetups {
+    fn default() -> Self {
+        Self { auto_load: true, last: None, setups: Vec::new() }
+    }
+}
+
+/// The setups as the file spells them. A dock this module cannot judge is
+/// kept as it reads; the surface refuses it by name at the load.
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct SetupsOnDisk {
+    format: String,
+    /// Written only when off; absent reads as on.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    auto_load: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    last: Option<String>,
+    #[serde(default)]
+    setups: Vec<SavedOnDisk>,
+}
+
+#[derive(Serialize, Deserialize)]
+struct SavedOnDisk {
+    name: String,
+    dock: serde_json::Value,
+}
+
+/// Trim and check a setup name as the user typed it. The refusal is one
+/// sentence and reads on the status line.
+pub fn setup_name(raw: &str) -> Result<&str, String> {
+    let name = raw.trim();
+    if name.is_empty() {
+        return Err(String::from("the setup needs a name"));
+    }
+    if name.chars().count() > SETUP_NAME_MAX {
+        return Err(format!("the setup name is longer than {SETUP_NAME_MAX} characters"));
+    }
+    if name.chars().any(char::is_control) {
+        return Err(String::from("the setup name has a control character"));
+    }
+    Ok(name)
+}
+
+impl PanelSetups {
+    /// The file text: our own `camcraft-panel-setups/1` JSON.
+    #[must_use]
+    pub fn to_json(&self) -> String {
+        let disk = SetupsOnDisk {
+            format: SETUPS_FORMAT.to_owned(),
+            auto_load: (!self.auto_load).then_some(false),
+            last: self.last.clone(),
+            setups: self
+                .setups
+                .iter()
+                .map(|s| SavedOnDisk { name: s.name.clone(), dock: s.dock.clone() })
+                .collect(),
+        };
+        serde_json::to_string_pretty(&disk).unwrap_or_else(|e| {
+            tracing::warn!("panel setups not serialised: {e}");
+            String::new()
+        })
+    }
+
+    /// Read the file text. A wrong format tag or broken JSON refuses the
+    /// whole file. A setup with a bad name, a dock that is not an object,
+    /// or a name that stands twice is dropped, named in the notes.
+    pub fn from_json(text: &str) -> Result<(Self, Vec<String>), String> {
+        let disk: SetupsOnDisk =
+            serde_json::from_str(text).map_err(|e| format!("not a panel setup file ({e})"))?;
+        if disk.format != SETUPS_FORMAT {
+            return Err(format!("format '{}' is not {SETUPS_FORMAT}", disk.format));
+        }
+        let mut notes = Vec::new();
+        let mut setups: Vec<SavedSetup> = Vec::new();
+        for raw in disk.setups {
+            let name = match setup_name(&raw.name) {
+                Ok(n) => n.to_owned(),
+                Err(why) => {
+                    notes.push(format!("setup '{}' is dropped: {why}", raw.name));
+                    continue;
+                }
+            };
+            if !raw.dock.is_object() {
+                notes.push(format!("setup '{name}' is dropped: its arrangement is not a saved dock"));
+                continue;
+            }
+            if setups.iter().any(|s| s.name == name) {
+                notes.push(format!("setup '{name}' stands twice - the second one is dropped"));
+                continue;
+            }
+            setups.push(SavedSetup { name, dock: raw.dock });
+        }
+        let auto_load = disk.auto_load.unwrap_or(true);
+        let last = match disk.last.as_deref().map(setup_name) {
+            None => None,
+            Some(Ok(n)) if setups.iter().any(|s| s.name == n) => Some(n.to_owned()),
+            Some(Ok(n)) => {
+                notes.push(format!("the last setup '{n}' is not in the file - starting with the default"));
+                None
+            }
+            Some(Err(why)) => {
+                notes.push(format!("the last setup name is dropped: {why}"));
+                None
+            }
+        };
+        Ok((Self { auto_load, last, setups }, notes))
+    }
+
+    /// The setup under `name`, if it is saved.
+    #[must_use]
+    pub fn find(&self, name: &str) -> Option<&SavedSetup> {
+        self.setups.iter().find(|s| s.name == name)
+    }
+
+    /// Save an arrangement under `name`, replacing one of that name, and
+    /// remember it as the last one used.
+    pub fn upsert(&mut self, name: &str, dock: serde_json::Value) {
+        match self.setups.iter_mut().find(|s| s.name == name) {
+            Some(saved) => saved.dock = dock,
+            None => self.setups.push(SavedSetup { name: name.to_owned(), dock }),
+        }
+        self.last = Some(name.to_owned());
+    }
+
+    /// Forget one setup. The last-used name is forgotten with it.
+    pub fn remove(&mut self, name: &str) -> bool {
+        let before = self.setups.len();
+        self.setups.retain(|s| s.name != name);
+        let removed = self.setups.len() != before;
+        if removed && self.last.as_deref() == Some(name) {
+            self.last = None;
+        }
+        removed
+    }
+}
+
+/// This process's saved panel setups file, if a config folder resolves.
+#[must_use]
+pub fn setups_path() -> Option<PathBuf> {
+    crate::recent::config_dir_for(std::env::consts::OS, |k| std::env::var_os(k))
+        .map(|d| d.join(SETUPS_FILE_NAME))
+}
+
+/// Read the saved panel setups. No file yet is a quiet empty store; an
+/// unreadable or corrupt one is an empty store with the reason logged and
+/// returned - never a crash.
+pub fn load_setups(path: &Path) -> (PanelSetups, Option<String>) {
+    let text = match std::fs::read_to_string(path) {
+        Ok(t) => t,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+            return (PanelSetups::default(), None);
+        }
+        Err(e) => {
+            let why = format!("panel setups not read ({}): {e} - the defaults are used", path.display());
+            tracing::warn!("{why}");
+            return (PanelSetups::default(), Some(why));
+        }
+    };
+    match PanelSetups::from_json(&text) {
+        Ok((p, notes)) if notes.is_empty() => (p, None),
+        Ok((p, notes)) => {
+            let why = format!("panel setups ({}): {}", path.display(), notes.join("; "));
+            tracing::warn!("{why}");
+            (p, Some(why))
+        }
+        Err(e) => {
+            let why = format!("panel setups ignored ({}): {e} - the defaults are used", path.display());
+            tracing::warn!("{why}");
+            (PanelSetups::default(), Some(why))
+        }
+    }
+}
+
+/// Write the saved panel setups atomically, like the preferences. A
+/// refusal is logged here and returned.
+pub fn save_setups(path: &Path, setups: &PanelSetups) -> Result<(), String> {
+    crate::machine::store::write_atomic(path, &setups.to_json()).map_err(|e| {
+        let why = e.to_string();
+        tracing::warn!("panel setups {why} ({})", path.display());
+        why
+    })
+}
diff --git a/crates/app/src/update_check.rs b/crates/app/src/update_check.rs
new file mode 100644
index 000000000..ebc184faf
--- /dev/null
+++ b/crates/app/src/update_check.rs
@@ -0,0 +1,284 @@
+//! Startup GitHub release update check (#2428 Part B).
+//!
+//! Checks `api.github.com/repos/NeoTech/Camcraft/releases/latest` at most once
+//! every 24 hours when enabled by the user's `prefs.json` setting. Silent on
+//! offline, timeout, rate limit, or parse errors; never collects telemetry or
+//! credentials; disabled in the browser (`wasm32`) build.
+//!
+//! Provenance: our own client over the public GitHub Releases REST API docs
+//! and the Semantic Versioning 2.0.0 specification; no vendor material consulted.
+
+use serde::Deserialize;
+use url::Url;
+
+/// GitHub REST endpoint for the latest published non-prerelease release.
+pub const LATEST_RELEASE_API_URL: &str =
+    "https://api.github.com/repos/NeoTech/Camcraft/releases/latest";
+
+/// Canonical base URL for release-notes pages on GitHub.
+pub const RELEASES_TAG_BASE: &str = "https://github.com/NeoTech/Camcraft/releases/tag/";
+
+/// Minimum interval between automatic startup checks (24 hours in seconds).
+pub const CHECK_INTERVAL_SECS: u64 = 24 * 60 * 60;
+
+#[cfg(not(target_arch = "wasm32"))]
+const MAX_RESPONSE_BYTES: usize = 512 * 1024;
+#[cfg(not(target_arch = "wasm32"))]
+const CONNECT_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(4);
+#[cfg(not(target_arch = "wasm32"))]
+const TOTAL_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(6);
+
+/// Parsed semantic version (`MAJOR.MINOR.PATCH` with optional `-prerelease`).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SemVer {
+    pub major: u64,
+    pub minor: u64,
+    pub patch: u64,
+    pub pre: Option<String>,
+}
+
+impl SemVer {
+    /// Format `MAJOR.MINOR.PATCH` (without leading `v` or build metadata).
+    #[must_use]
+    pub fn canonical_core(&self) -> String {
+        format!("{}.{}.{}", self.major, self.minor, self.patch)
+    }
+}
+
+/// Information about a newer release available on GitHub.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReleaseInfo {
+    /// Canonical `MAJOR.MINOR.PATCH` version string (no leading `v`).
+    pub version: String,
+    /// Validated HTTPS release-notes page on GitHub.
+    pub release_notes_url: String,
+}
+
+#[derive(Deserialize)]
+struct LatestReleasePayload {
+    tag_name: String,
+    #[serde(default)]
+    html_url: Option<String>,
+    #[serde(default)]
+    prerelease: Option<bool>,
+    #[serde(default)]
+    draft: Option<bool>,
+}
+
+fn parse_core_part(raw: &str) -> Option<u64> {
+    if raw.is_empty() || !raw.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    if raw.len() > 1 && raw.starts_with('0') {
+        return None;
+    }
+    raw.parse::<u64>().ok()
+}
+
+fn valid_semver_meta(raw: &str) -> bool {
+    !raw.is_empty()
+        && raw.split('.').all(|seg| {
+            !seg.is_empty()
+                && seg
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+        })
+}
+
+/// Parse a `SemVer` tag such as `"v0.26.0"` or `"0.25.0-rc.1+build.2"`.
+#[must_use]
+pub fn parse_semver(raw: &str) -> Option<SemVer> {
+    let trimmed = raw.trim();
+    let without_v = trimmed
+        .strip_prefix('v')
+        .or_else(|| trimmed.strip_prefix('V'))
+        .unwrap_or(trimmed);
+    let core_and_pre = match without_v.split_once('+') {
+        Some((head, build)) => {
+            if !valid_semver_meta(build) {
+                return None;
+            }
+            head
+        }
+        None => without_v,
+    };
+    let (core, pre) = match core_and_pre.split_once('-') {
+        Some((head, pre)) => {
+            if !valid_semver_meta(pre) {
+                return None;
+            }
+            (head, Some(pre.to_owned()))
+        }
+        None => (core_and_pre, None),
+    };
+    let mut parts = core.split('.');
+    let major = parse_core_part(parts.next()?)?;
+    let minor = parse_core_part(parts.next()?)?;
+    let patch = parse_core_part(parts.next()?)?;
+    if parts.next().is_some() {
+        return None;
+    }
+    Some(SemVer { major, minor, patch, pre })
+}
+
+/// Return `true` when `candidate` is a stable release strictly newer than `current`.
+#[must_use]
+pub fn is_newer_version(current: &str, candidate: &str) -> bool {
+    let (Some(cur), Some(cand)) = (parse_semver(current), parse_semver(candidate)) else {
+        return false;
+    };
+    if cand.pre.is_some() {
+        return false;
+    }
+    let cur_tuple = (cur.major, cur.minor, cur.patch);
+    let cand_tuple = (cand.major, cand.minor, cand.patch);
+    cand_tuple > cur_tuple || (cand_tuple == cur_tuple && cur.pre.is_some())
+}
+
+/// Return `true` when automatic checking is enabled and at least 24 hours
+/// have elapsed since `last_check_utc` (or no previous check was recorded).
+#[must_use]
+pub fn should_check_now(check_for_updates: bool, last_check_utc: Option<u64>, now_utc: u64) -> bool {
+    if !check_for_updates {
+        return false;
+    }
+    match last_check_utc {
+        None => true,
+        Some(last) => {
+            now_utc.saturating_sub(last) >= CHECK_INTERVAL_SECS
+                || last.saturating_sub(now_utc) > CHECK_INTERVAL_SECS
+        }
+    }
+}
+
+/// Current UTC time as whole seconds since the Unix epoch (native only).
+#[cfg(not(target_arch = "wasm32"))]
+#[must_use]
+pub fn current_unix_secs() -> Option<u64> {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()
+        .map(|d| d.as_secs())
+}
+
+/// Canonical release-notes URL for a parsed version string (`"0.26.0"`).
+#[must_use]
+pub fn default_release_url(version: &str) -> String {
+    format!("{RELEASES_TAG_BASE}v{version}")
+}
+
+/// Confirm `raw` is a clean HTTPS release page on `github.com/NeoTech/Camcraft`.
+#[must_use]
+pub fn is_safe_release_url(raw: &str) -> bool {
+    if raw.chars().any(char::is_control) {
+        return false;
+    }
+    let Ok(parsed) = Url::parse(raw) else {
+        return false;
+    };
+    parsed.scheme() == "https"
+        && parsed
+            .host_str()
+            .is_some_and(|h| h.eq_ignore_ascii_case("github.com"))
+        && parsed
+            .path()
+            .to_ascii_lowercase()
+            .starts_with("/neotech/camcraft/releases/")
+}
+
+fn sanitize_release_url(html_url: Option<&str>, version: &str) -> String {
+    match html_url.map(str::trim) {
+        Some(raw) if is_safe_release_url(raw) => match Url::parse(raw) {
+            Ok(url) => url.into(),
+            Err(_) => default_release_url(version),
+        },
+        _ => default_release_url(version),
+    }
+}
+
+/// Parse GitHub's `/releases/latest` JSON body and return `Some(ReleaseInfo)`
+/// only when it names a stable release newer than `current_version`.
+pub fn parse_latest_release(current_version: &str, body: &str) -> Result<Option<ReleaseInfo>, String> {
+    let payload: LatestReleasePayload =
+        serde_json::from_str(body).map_err(|e| format!("release response is not valid JSON: {e}"))?;
+    if payload.draft == Some(true) || payload.prerelease == Some(true) {
+        return Ok(None);
+    }
+    let Some(parsed) = parse_semver(&payload.tag_name) else {
+        return Err(format!("release tag '{}' is not a semantic version", payload.tag_name));
+    };
+    if !is_newer_version(current_version, &payload.tag_name) {
+        return Ok(None);
+    }
+    let version = parsed.canonical_core();
+    let release_notes_url = sanitize_release_url(payload.html_url.as_deref(), &version);
+    Ok(Some(ReleaseInfo { version, release_notes_url }))
+}
+
+/// Query GitHub Releases for a version newer than `current_version` (native only).
+#[cfg(not(target_arch = "wasm32"))]
+pub fn fetch_latest_release(current_version: &str) -> Result<Option<ReleaseInfo>, String> {
+    fetch_latest_release_from(LATEST_RELEASE_API_URL, current_version)
+}
+
+/// Query `api_url` for a release JSON payload and compare it against `current_version`.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn fetch_latest_release_from(
+    api_url: &str,
+    current_version: &str,
+) -> Result<Option<ReleaseInfo>, String> {
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .map_err(|e| format!("HTTP runtime unavailable: {e}"))?;
+    runtime.block_on(fetch_latest_release_async(api_url, current_version))
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+async fn fetch_latest_release_async(
+    api_url: &str,
+    current_version: &str,
+) -> Result<Option<ReleaseInfo>, String> {
+    let is_loopback = Url::parse(api_url)
+        .ok()
+        .and_then(|u| u.host_str().map(|h| h.eq_ignore_ascii_case("localhost") || h == "127.0.0.1"))
+        .unwrap_or(false);
+    let mut builder = reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .connect_timeout(CONNECT_TIMEOUT)
+        .timeout(TOTAL_TIMEOUT)
+        .user_agent(concat!("camcraft/", env!("CARGO_PKG_VERSION")));
+    if is_loopback {
+        builder = builder.no_proxy();
+    }
+    let client = builder
+        .build()
+        .map_err(|_| String::from("update check HTTP client unavailable"))?;
+    let resp = client
+        .get(api_url)
+        .header("accept", "application/vnd.github+json")
+        .header("x-github-api-version", "2022-11-28")
+        .send()
+        .await
+        .map_err(|_| String::from("update check could not reach release server"))?;
+    let status = resp.status();
+    if !status.is_success() {
+        return Err(format!("release server returned HTTP {}", status.as_u16()));
+    }
+    if resp
+        .content_length()
+        .is_some_and(|len| len > MAX_RESPONSE_BYTES as u64)
+    {
+        return Err(String::from("release response exceeded size limit"));
+    }
+    let bytes = resp
+        .bytes()
+        .await
+        .map_err(|_| String::from("release response could not be read"))?;
+    if bytes.len() > MAX_RESPONSE_BYTES {
+        return Err(String::from("release response exceeded size limit"));
+    }
+    let text = std::str::from_utf8(&bytes)
+        .map_err(|_| String::from("release response was not UTF-8"))?;
+    parse_latest_release(current_version, text)
+}
diff --git a/crates/app/tests/update_check.rs b/crates/app/tests/update_check.rs
new file mode 100644
index 000000000..e36ca68f3
--- /dev/null
+++ b/crates/app/tests/update_check.rs
@@ -0,0 +1,165 @@
+//! Startup update check tests (#2428 Part B): semantic version comparison,
+//! once-per-day rate limiting, GitHub release payload parsing/sanitization,
+//! and silent HTTP failure handling via loopback fixtures (zero external calls).
+//!
+//! Provenance: our own tests specced from issue #2428 Part B; no vendor
+//! material consulted.
+//!
+//! Gate map (M4.4): covers app::update_check.
+
+use std::io::{Read, Write};
+use std::net::{TcpListener, TcpStream};
+use std::time::Duration;
+
+use camcraft_app::update_check::{
+    CHECK_INTERVAL_SECS, ReleaseInfo, default_release_url, fetch_latest_release_from,
+    is_newer_version, is_safe_release_url, parse_latest_release, parse_semver, should_check_now,
+};
+
+#[test]
+fn semver_parsing_and_comparison_cover_stable_prerelease_and_invalid_tags() {
+    let parsed = parse_semver("v0.26.1").expect("valid v-prefixed version");
+    assert_eq!((parsed.major, parsed.minor, parsed.patch, parsed.pre), (0, 26, 1, None));
+    assert_eq!(parse_semver("0.25.0-rc.1+build.9").and_then(|v| v.pre), Some("rc.1".into()));
+
+    assert!(is_newer_version("0.25.0", "v0.26.0"));
+    assert!(is_newer_version("0.25.0", "0.25.1"));
+    assert!(is_newer_version("0.25.0", "v1.0.0"));
+    assert!(is_newer_version("0.25.9", "v0.25.10"));
+    assert!(is_newer_version("0.25.0-rc.1", "v0.25.0"));
+
+    assert!(!is_newer_version("0.25.0", "v0.25.0"));
+    assert!(!is_newer_version("0.25.0", "0.25.0+meta"));
+    assert!(!is_newer_version("0.25.0", "v0.24.9"));
+    assert!(!is_newer_version("0.25.0", "v0.26.0-alpha.1"));
+
+    for bad in ["", "v0.25", "0.25.0.1", "v0.25.x", "0.01.0", "-0.25.0", "v0.25.0+"] {
+        assert_eq!(parse_semver(bad), None, "expected {bad:?} to be rejected");
+        assert!(!is_newer_version("0.25.0", bad));
+    }
+}
+
+#[test]
+fn once_per_day_throttle_enforces_24_hour_window_and_disabled_setting() {
+    let base = 1_795_000_000_u64;
+    assert!(!should_check_now(false, None, base));
+    assert!(!should_check_now(false, Some(base - CHECK_INTERVAL_SECS), base));
+    assert!(should_check_now(true, None, base));
+    assert!(!should_check_now(true, Some(base), base + CHECK_INTERVAL_SECS - 1));
+    assert!(should_check_now(true, Some(base), base + CHECK_INTERVAL_SECS));
+    assert!(!should_check_now(true, Some(base), base - 60));
+    assert!(should_check_now(true, Some(base + CHECK_INTERVAL_SECS + 1), base));
+}
+
+#[test]
+fn parse_latest_release_sanitizes_urls_and_ignores_non_upgrades() {
+    let newer = r#"{
+        "tag_name": "v0.26.0",
+        "html_url": "https://github.com/NeoTech/Camcraft/releases/tag/v0.26.0",
+        "draft": false,
+        "prerelease": false
+    }"#;
+    assert_eq!(
+        parse_latest_release("0.25.0", newer).expect("valid payload"),
+        Some(ReleaseInfo {
+            version: "0.26.0".into(),
+            release_notes_url: "https://github.com/NeoTech/Camcraft/releases/tag/v0.26.0".into(),
+        })
+    );
+
+    let same = r#"{"tag_name": "v0.25.0", "html_url": "https://github.com/NeoTech/Camcraft/releases/tag/v0.25.0"}"#;
+    assert_eq!(parse_latest_release("0.25.0", same).expect("same version"), None);
+
+    let draft = r#"{"tag_name": "v0.26.0", "draft": true}"#;
+    assert_eq!(parse_latest_release("0.25.0", draft).expect("draft ignored"), None);
+
+    let pre = r#"{"tag_name": "v0.26.0", "prerelease": true}"#;
+    assert_eq!(parse_latest_release("0.25.0", pre).expect("prerelease ignored"), None);
+
+    for unsafe_url in [
+        "http://github.com/NeoTech/Camcraft/releases/tag/v0.26.0",
+        "https://evil.example/NeoTech/Camcraft/releases/tag/v0.26.0",
+        "https://github.com/other/repo/releases/tag/v0.26.0",
+        "https://github.com/NeoTech/Camcraft/releases/tag/v0.26.0\ncmd",
+    ] {
+        assert!(!is_safe_release_url(unsafe_url), "{unsafe_url}");
+        let body = serde_json::json!({ "tag_name": "v0.26.0", "html_url": unsafe_url }).to_string();
+        let parsed = parse_latest_release("0.25.0", &body)
+            .expect("falls back to canonical URL")
+            .expect("newer version");
+        assert_eq!(parsed.release_notes_url, default_release_url("0.26.0"));
+    }
+
+    assert!(parse_latest_release("0.25.0", "{ not json").is_err());
+    assert!(parse_latest_release("0.25.0", r#"{"tag_name":"latest"}"#).is_err());
+}
+
+fn read_http_request(stream: &mut TcpStream) -> String {
+    stream.set_read_timeout(Some(Duration::from_secs(3))).expect("timeout");
+    let mut buf = Vec::new();
+    let mut chunk = [0_u8; 1024];
+    while !buf.windows(4).any(|w| w == b"\r\n\r\n") {
+        let n = stream.read(&mut chunk).expect("read request");
+        if n == 0 {
+            break;
+        }
+        buf.extend_from_slice(&chunk[..n]);
+    }
+    String::from_utf8_lossy(&buf).into_owned()
+}
+
+fn serve_once(status_line: &str, body: &str) -> (String, std::thread::JoinHandle<String>) {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind loopback");
+    let addr = listener.local_addr().expect("local addr");
+    let status = status_line.to_owned();
+    let payload = body.to_owned();
+    let handle = std::thread::spawn(move || {
+        let (mut stream, _) = listener.accept().expect("accept");
+        let req = read_http_request(&mut stream);
+        let response = format!(
+            "HTTP/1.1 {status}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{payload}",
+            payload.len()
+        );
+        stream.write_all(response.as_bytes()).expect("write reply");
+        req
+    });
+    (format!("http://{addr}/repos/NeoTech/Camcraft/releases/latest"), handle)
+}
+
+#[test]
+fn loopback_http_returns_newer_release_without_auth_and_handles_errors_cleanly() {
+    let newer_body = r#"{"tag_name":"v99.1.0","html_url":"https://github.com/NeoTech/Camcraft/releases/tag/v99.1.0"}"#;
+    let (url, server) = serve_once("200 OK", newer_body);
+    let info = fetch_latest_release_from(&url, "0.25.0")
+        .expect("200 OK parses")
+        .expect("99.1.0 is newer than 0.25.0");
+    assert_eq!(info.version, "99.1.0");
+    assert_eq!(info.release_notes_url, "https://github.com/NeoTech/Camcraft/releases/tag/v99.1.0");
+    let req = server.join().expect("server");
+    let req_lower = req.to_ascii_lowercase();
+    assert!(req_lower.contains("user-agent: camcraft/"), "User-Agent required by GitHub API: {req}");
+    assert!(!req_lower.contains("authorization:"), "no credentials or tokens sent: {req}");
+
+    let same_body = r#"{"tag_name":"v0.25.0"}"#;
+    let (url, server) = serve_once("200 OK", same_body);
+    assert_eq!(fetch_latest_release_from(&url, "0.25.0").expect("200 same"), None);
+    let _ = server.join();
+
+    let (url, server) = serve_once("403 Forbidden", r#"{"message":"API rate limit exceeded"}"#);
+    assert!(fetch_latest_release_from(&url, "0.25.0").is_err());
+    let _ = server.join();
+
+    let (url, server) = serve_once("500 Internal Server Error", "oops");
+    assert!(fetch_latest_release_from(&url, "0.25.0").is_err());
+    let _ = server.join();
+
+    let (url, server) = serve_once("200 OK", "not valid json");
+    assert!(fetch_latest_release_from(&url, "0.25.0").is_err());
+    let _ = server.join();
+
+    let dead = TcpListener::bind("127.0.0.1:0").expect("ephemeral port");
+    let closed_port = dead.local_addr().expect("addr").port();
+    drop(dead);
+    let closed_url = format!("http://127.0.0.1:{closed_port}/releases/latest");
+    assert!(fetch_latest_release_from(&closed_url, "0.25.0").is_err());
+}
diff --git a/crates/app/tests/view_prefs.rs b/crates/app/tests/view_prefs.rs
