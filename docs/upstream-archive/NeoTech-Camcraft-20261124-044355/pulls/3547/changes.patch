+    /// #2428: spawn the once-per-day GitHub release check on native desktop startup.
+    #[cfg(not(target_arch = "wasm32"))]
+    pub(crate) fn start_update_check(&mut self, wake: crate::update_check::WakeFn) {
+        if self.browser_build {
+            return;
+        }
+        self.update_watcher.spawn_if_due(
+            self.check_for_updates,
+            self.last_update_check_utc,
+            crate::build_info::VERSION,
+            wake,
+        );
+    }
+
+    /// #2428: non-blocking poll of the one-shot update check result.
+    pub(crate) fn poll_update_check(&mut self) {
+        let Some(outcome) = self.update_watcher.poll() else {
+            return;
+        };
+        if let Some(ts) = outcome.checked_at_utc {
+            self.last_update_check_utc = Some(ts);
+            self.persist_prefs();
+        }
+        if self.check_for_updates {
+            self.update_available = outcome.update;
+        }
+    }
