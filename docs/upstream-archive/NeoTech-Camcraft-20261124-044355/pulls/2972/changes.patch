+/// The complete approach stays on the waste side of this emitted face.
+fn clears_entry_line(a: Point, b: Point, hole: Point) -> bool {
+    let side = cross(a, b, hole);
+    let edge = vector(a, b);
+    side < 0 && side * side >= LEAD * LEAD * dot(edge, edge)
