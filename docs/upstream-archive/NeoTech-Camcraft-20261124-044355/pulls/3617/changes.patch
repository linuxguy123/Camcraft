+            let f = (overlap - acc) / d;
+            let end = Point2::new(prev.x + (q.x - prev.x) * f, prev.y + (q.y - prev.y) * f);
+            if out.last().is_none_or(|l| dist(*l, end) > 1e-9) {
+                out.push(end);
+            }
+            return out;
+        }
+        acc += d;
+        prev = q;
+        if out.last().is_none_or(|l| dist(*l, q) > 1e-9) {
+            out.push(q);
+        }
+    }
