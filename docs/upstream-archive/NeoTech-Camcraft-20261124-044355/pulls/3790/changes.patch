+    let shoe = ring.difference(&region(vec![rect(10.0, -1.0, 21.0, 1.0)])).expect("horseshoe");
+    let cavity = square.offset(2.0 * R).and_then(|r| r.difference(&shoe)).expect("reach");
+    let narrow = warnings(&cavity, on(PassStart::Outside));
+    assert!(narrow.iter().any(|n| n.contains("full tool width where the area is narrower")), "the cavity: {narrow:?}");
+}
+
+/// The start-side plan's walks meet only at shared points: the
+/// verifier's crossing law finds no two PLANAR feeds that cross (ring
+/// piece ends on the walls, lead-in chords, joins). The helix entries
+/// are the entry law's: two re-entries in one area can bore side by
+/// side (#3316 follow-up), so pairs with a descending move are not this
+/// plan's.
+#[test]
+fn the_start_side_plan_posts_no_crossing_feeds() {
+    let (_, _, reach) = band();
+    let mut fine = params();
+    fine.stepover = 3.0;
+    for (start, p) in [(PassStart::Outside, params()), (PassStart::Inside, params()), (PassStart::Outside, fine), (PassStart::Inside, fine)] {
+        let path = pocket_started(&reach, &p, &[], &CornerRelief::default(), start).expect("plan");
+        let planar = |i: usize| path.moves.get(i).is_some_and(|m| (m.from.z - m.to.z).abs() < 1e-9);
+        let crossed: Vec<[usize; 2]> = camcraft_motion::verify::crossed_pairs(&path, 0.01)
+            .into_iter()
+            .filter(|pr| planar(pr[0]) && planar(pr[1]))
+            .collect();
+        assert!(crossed.is_empty(), "{start:?} step {}: {crossed:?}", p.stepover);
+    }
+}
+
+/// What no tool of radius `r` reaches in `material` (its inside corners):
+/// the material less its opening by the tool disc, grown by a cell.
+fn unreachable(material: &Region, r: f64) -> Region {
+    let opened = material.offset(-r).and_then(|o| o.offset(r)).expect("opening");
+    material.difference(&opened).and_then(|u| u.offset(0.2)).expect("unreachable")
+}
+
+/// The leftover law on one fixture: the plan cuts every place the tool
+/// reaches (an Auto plan's area), none of it stays standing.
+fn cuts_whole(name: &str, reach: &Region, material: &Region, side: StartSide) {
+    let path = pocket_started_on(reach, &params(), &[], &CornerRelief::default(), &side).expect("plan");
+    mask(name, reach, &path).assert_no_overcut();
+    let m = mask(name, material, &path);
+    let got = m.metrics();
+    eprintln!("{name}: uncut {:.3} mm2, {} interior uncut cell(s)", got.uncut_area, got.interior_uncut_cells);
+    let allowed = unreachable(material, R);
+    m.assert_bounded_leftover(allowed.area().abs() + 8.0, Some(&allowed));
+}
+
+/// #3316 second read of 9939a6238: material nested in a hole (the stock
+/// inside a ring part) is cut whole, Outside and Inside.
+#[test]
+fn the_stock_inside_a_ring_part_is_cut_whole() {
+    let square = region(vec![rect(-40.0, -40.0, 40.0, 40.0)]);
+    let annulus = region(vec![circle(25.0), circle(15.0)]);
+    let reach = square.offset(2.0 * R).and_then(|r| r.difference(&annulus)).expect("reach");
+    let material = square.difference(&annulus).expect("material");
+    for start in [PassStart::Outside, PassStart::Inside] {
+        let side = StartSide { start, stock: Some(square.clone()), around_part: true };
+        cuts_whole(&format!("pass_start_ringed_{}", start.label()), &reach, &material, side);
+    }
+}
+
+/// A closed pocket with a hollow boss whose bore is cleared to the same
+/// floor: the bore is material nested in the boss's hole. Outside and
+/// Inside cut the pocket and the bore whole.
+#[test]
+fn a_pocket_with_a_hollow_boss_is_cut_whole() {
+    let pocket = region(vec![rect(-40.0, -30.0, 40.0, 30.0), circle(18.0), circle(10.0)]);
+    let block = region(vec![rect(-60.0, -50.0, 60.0, 50.0)]);
+    for start in [PassStart::Outside, PassStart::Inside] {
+        let side = StartSide { start, stock: Some(block.clone()), around_part: false };
+        cuts_whole(&format!("pass_start_hollow_boss_{}", start.label()), &pocket, &pocket, side);
+    }
+}
diff --git a/crates/motion/tests/pass_start_levels/one_ring_set.rs b/crates/motion/tests/pass_start_levels/one_ring_set.rs
new file mode 100644
index 000000000..ad59d0f4b
--- /dev/null
+++ b/crates/motion/tests/pass_start_levels/one_ring_set.rs
@@ -0,0 +1,135 @@
+//! #3744: one ring set round a part for Auto, Inside and Outside, on a
+//! dog-bone part (two discs of radius 12 at X -15 and X 15, joined by a
+//! neck 8 mm wide) in a stock box of 80 x 50, a tool of radius 4 and a
+//! step of 2, as a 2D Offset round the part plans it. The planner pins
+//! (the same multiset of rings) are in `machining2d::ring_side`; these
+//! read the posted path.
+
+use super::{params, rect, region};
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::geo2d::{Point2, Region};
+use camcraft_motion::machining2d::{CornerRelief, PassStart, StartSide, pocket_started_on, rings_fallbacks};
+
+const R: f64 = super::R;
+const Z: f64 = super::Z;
+
+fn disc(cx: f64, r: f64) -> Vec<Point2> {
+    (0..128)
+        .map(|k| {
+            let a = f64::from(k) * std::f64::consts::TAU / 128.0;
+            Point2::new(cx + r * a.cos(), r * a.sin())
+        })
+        .collect()
+}
+
+/// The part, the stock box, and the band the disc may sweep (the stock
+/// grown by the radius, less the part).
+fn dog_bone() -> (Region, Region, Region) {
+    let part = region(vec![disc(-15.0, 12.0)])
+        .union(&region(vec![disc(15.0, 12.0)]))
+        .and_then(|p| p.union(&region(vec![rect(-15.0, -4.0, 15.0, 4.0)])))
+        .expect("part");
+    let stock = region(vec![rect(-40.0, -25.0, 40.0, 25.0)]);
+    let band = stock.offset(R).and_then(|s| s.difference(&part)).expect("band");
+    (part, stock, band)
+}
+
+fn path(start: PassStart, stock: Option<Region>) -> Toolpath {
+    let (_, _, band) = dog_bone();
+    let mut p = params();
+    p.stepover = 2.0;
+    let side = StartSide { start, stock, around_part: true };
+    let path = pocket_started_on(&band, &p, &[], &CornerRelief::default(), &side).expect("plan");
+    assert_eq!(rings_fallbacks(&path.notes), 0, "{start:?}: the one ring set is kept: {:?}", path.notes);
+    path
+}
+
+/// The floor runs: each chain of planar feeds at the floor, by its two
+/// ends.
+fn floor_runs(path: &Toolpath) -> Vec<(Point2, Point2)> {
+    let floor = |i: usize| {
+        path.moves.get(i).is_some_and(|m| m.kind != MoveKind::Rapid && (m.from.z - Z).abs() < 1e-9 && (m.to.z - Z).abs() < 1e-9)
+    };
+    let mut runs = Vec::new();
+    let mut open: Option<Point2> = None;
+    for (i, m) in path.moves.iter().enumerate() {
+        if !floor(i) {
+            continue;
+        }
+        let start = open.get_or_insert(Point2::new(m.from.x, m.from.y));
+        let next = path.moves.get(i + 1).filter(|n| floor(i + 1) && n.from == m.to);
+        if next.is_none() {
+            runs.push((*start, Point2::new(m.to.x, m.to.y)));
+            open = None;
+        }
+    }
+    runs
+}
+
+fn edge_dist(q: Point2, r: &Region) -> f64 {
+    let seg = |a: Point2, b: Point2| {
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let dd = dx * dx + dy * dy;
+        let t = if dd > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / dd).clamp(0.0, 1.0) } else { 0.0 };
+        (q.x - a.x - t * dx).hypot(q.y - a.y - t * dy)
+    };
+    r.loops()
+        .iter()
+        .flat_map(|l| {
+            let p = l.points();
+            (0..p.len()).map(move |i| (p[i], p[(i + 1) % p.len()]))
+        })
+        .map(|(a, b)| seg(a, b))
+        .fold(f64::INFINITY, f64::min)
+}
+
+/// #3744 pin: the Outside rings follow the part. No open floor run of an
+/// Outside pass ends on the part wall (the tool centre one radius off the
+/// part) before the last, which is the part wall itself; on `main` before
+/// #3744, 14 of 14 runs did. A ring that the stock edge cuts ends on the
+/// stock edge, never on the part.
+#[test]
+fn outside_rings_follow_the_part() {
+    let (part, stock, _) = dog_bone();
+    let runs = floor_runs(&path(PassStart::Outside, Some(stock)));
+    assert!(!runs.is_empty(), "the pass cuts the floor");
+    let on_part = |q: Point2| (edge_dist(q, &part) - R).abs() < 0.05;
+    // The level ends with the part wall, the last ring of Outside.
+    let Some((last, early)) = runs.split_last() else { panic!("no run") };
+    assert!(on_part(last.1), "the level ends on the part wall: {last:?}");
+    let dead: Vec<&(Point2, Point2)> = early
+        .iter()
+        .filter(|(a, b)| (a.x - b.x).hypot(a.y - b.y) > 0.01 && (on_part(*a) || on_part(*b)))
+        .collect();
+    assert!(dead.is_empty(), "{} of {} Outside floor runs end on the part wall: {dead:?}", dead.len(), runs.len());
+}
+
+/// #3744 pin: Auto gives exactly the path of one of the two sides: of
+/// Outside when the stock box leaves the outer edge in air, of Inside
+/// when the stock is unknown.
+#[test]
+fn auto_is_inside_or_outside() {
+    let (_, stock, _) = dog_bone();
+    let auto = path(PassStart::Auto, Some(stock.clone()));
+    let outside = path(PassStart::Outside, Some(stock));
+    assert!(auto.moves == outside.moves, "Auto in open air is the Outside path");
+    let blind = path(PassStart::Auto, None);
+    let inside = path(PassStart::Inside, None);
+    assert!(blind.moves == inside.moves, "Auto with no stock footprint is the Inside path");
+}
+
+/// #3744: the one ring set posts no crossing feeds from either side (the
+/// verifier's crossing law blocks the post on a crossing, #3741).
+#[test]
+fn the_one_ring_set_posts_no_crossing_feeds() {
+    let (_, stock, _) = dog_bone();
+    for start in [PassStart::Inside, PassStart::Outside] {
+        let path = path(start, Some(stock.clone()));
+        let planar = |i: usize| path.moves.get(i).is_some_and(|m| (m.from.z - m.to.z).abs() < 1e-9);
+        let crossed: Vec<[usize; 2]> = camcraft_motion::verify::crossed_pairs(&path, 0.01)
+            .into_iter()
+            .filter(|pr| planar(pr[0]) && planar(pr[1]))
+            .collect();
+        assert!(crossed.is_empty(), "{start:?}: {crossed:?}");
+    }
+}
diff --git a/docs/decisions/3744-one-ring-set.md b/docs/decisions/3744-one-ring-set.md
new file mode 100644
index 000000000..34f529c5e
--- /dev/null
+++ b/docs/decisions/3744-one-ring-set.md
@@ -0,0 +1,50 @@
+## #3744 - 2D Offset "Pass starts at": one ring set round a part
+
+**Decided.** An area round a part (`StartSide::around_part`, the 2D Offset
+Outside band) has ONE ring set for Auto, Inside and Outside: the level
+curves of the distance from the part (the area's holes) at
+`off + k * stepover`, clipped to the cutter-centre area. The pieces that the
+stock edge cuts are open pieces of the same set.
+
+- Inside walks the set from the part out (the old Inside order, byte for
+  byte).
+- Outside walks the same pieces mirrored (`ring_side::mirror`): each piece
+  runs the other way (the cut and uncut sides swap, so climb stays climb),
+  the outer edge of the area is ring 0, ring `j` of `top` is ring
+  `top + 1 - j`, and the part wall is cut last.
+- Auto picks one side in one place (`ring_side::resolve`). Auto is Outside
+  when the stock footprint is known and no outer edge of the cutter-centre
+  area has its disc wholly in the stock (the same law as the "wall first"
+  warning: an Outside start there owes no full-width cut). Else Auto is
+  Inside. The resolved side then drives the rings, the links
+  (`cleared_links`) and the entry, so Auto is exactly the path of Inside or
+  of Outside. The 2D Offset op now sends the stock footprint for Auto round
+  a part too (`generate.rs`), so that the rule can read it.
+
+**Why.** The maintainer's rule (#3741): "Pass starts at" changes only where
+the tool starts and the ring order. Before, the three values called three
+planners: Outside offset the stock box (the part cut each ring into pieces
+that ended on the part wall, 14 of 14 runs on the dog bone), Inside offset
+the part, and Auto offset both edges (`waterline_passes`).
+
+**Scope kept small.**
+- Only `around_part` areas change. A pocket (no part to follow), the 3-D
+  levels (`level_ring_plan`, `around_part: false`) and the Adaptive plan keep
+  their old plans byte for byte. #3743 reviews them.
+- A part with no hole (stock nested in a ring part) keeps its old rings:
+  core first for Inside, from its own edge for Outside. Those are offsets of
+  the same edge already.
+- The completeness guard stays: a plan that leaves more than 0.1 mm2 of the
+  cutter-centre area unswept still takes the old Auto plan with the named
+  `StrategyFallback` note. Dropped for now: clean-up rings of the same set
+  for a leftover. The guard is the Prime Directive's net, and the dog-bone
+  pins assert that it does not fire. #3743 owns the replacement.
+- The #3567 dead-end ramp marks (`level_order`, Outside only) stay; #3748
+  retires them. The entry (#3746) and the links (#3747) are not changed.
+- When Auto resolves, the "Pass start" notes name the side that was cut
+  ("Inside" or "Outside"), not "Auto". Dropped: an extra note for Auto,
+  because each note shows as a warning line on the op page.
+
+**Cost to change later.** The rule lives in `ring_side::resolve`; a
+different Auto rule changes one function and its pin
+(`auto_picks_one_side_of_the_one_ring_set`).

From ef3372b11c35f62e3df69ab2d1795549011265a9 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 23 Nov 2026 23:32:42 +0100
Subject: [PATCH 2/6] fix(2d): share ring ends on the edge walk; no dead-end
 ramp round a part

A ring end that the clip puts some microns off its boundary chord is now
snapped onto the boundary walk (within 0.1 um, the closing chord of a
closed walk included), so the verifier reads a touch, not a crossing.
Round a part, Outside walks the Inside ring set and so enters as Inside
does: the #3567 dead-end ramp marks stay only for pockets. On fig8, two
dead-end ramps of the Auto (now Outside) pass crossed at shared depth.

Refs #3744

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
