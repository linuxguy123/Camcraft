+                &mut stock_facets,
+                &mut stock_aabb,
+                &mut picked_region,
+                &mut contour_sel,
+                &mut sketch_contour,
+                &mut drive_chains,
+                &mut slot_bound,
+                &mut prior,
+                &mut drills_ahead,
+                &mut keep_parts,
+                &mut neighbour_parts,
+                &mut area,
