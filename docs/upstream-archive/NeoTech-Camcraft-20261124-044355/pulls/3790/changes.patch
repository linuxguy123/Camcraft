+    eprintln!("fig8 Inside: {} full-width point(s)", full.len());
+    assert!(!full.is_empty(), "Inside starts on the part wall, so the meter reads full-width cuts");
+    assert_names_each_full_width_cut(&world, &name, &path, &full, true);
 }
 
