+//! 2D Offset / Pocket path planning with per-level "Do not touch" keep-outs (#2055).
+//! Provenance: our own per-Z-level region difference over `levels` and `verify::avoid`;
+//! no vendor material consulted.
+
+use camcraft_sim::verify::{AVOID_PAD, AvoidSpec};
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geo2d::Region;
+use crate::geometry::Point3;
+
+use super::arcs::{ARC_FIT_TOL, Seg, fit_arcs};
+use super::corner_relief::{CornerRelief, capsule_region, plan_corner_reliefs};
+use super::corner_relief_spur::inject_relief_spurs;
+use super::fillet::{Legal, fillet_corners};
+use super::fillet_tally::{FilletTally, corner_arc_radius, fillet_floor};
+use super::equal_steps::cut_levels_for;
+use super::levels::{Cert, Motion, WalkState, walk_one_level};
+use super::level_rings::ring_plan_ramped;
+use super::pass_start::{PassStart, StartSide};
+use super::pocket::{PocketParams, PocketStrategy, non_sliver_center};
+use super::pocket_zigzag::rest_passes;
+use super::GenError;
+
+/// Plan a 2D pocket/offset path whose tool assembly stays clear of `avoid`.
+pub fn pocket_avoid(
+    region: &Region,
+    p: &PocketParams,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    pocket_avoid_with_relief(region, p, avoid, &CornerRelief::default())
+}
+
+/// [`pocket_avoid`] with optional inside-corner reliefs (#2400).
+pub fn pocket_avoid_with_relief(
+    region: &Region,
+    p: &PocketParams,
+    avoid: &AvoidSpec,
+    relief: &CornerRelief,
+) -> Result<Toolpath, GenError> {
+    pocket_avoid_started(region, p, avoid, relief, PassStart::Auto)
+}
+
+/// [`pocket_avoid_with_relief`] with the side each level starts on
+/// (#3316); [`PassStart::Auto`] is that function, byte for byte.
+pub fn pocket_avoid_started(
+    region: &Region,
+    p: &PocketParams,
+    avoid: &AvoidSpec,
+    relief: &CornerRelief,
+    start: PassStart,
+) -> Result<Toolpath, GenError> {
+    pocket_avoid_started_on(region, p, avoid, relief, &StartSide::from(start))
+}
+
+/// [`pocket_avoid_started`] with the stock known (#3316): each level's
+/// keep-out edges are walls, cut after its rings.
+pub fn pocket_avoid_started_on(
+    region: &Region,
+    p: &PocketParams,
+    avoid: &AvoidSpec,
+    relief: &CornerRelief,
+    side: &StartSide,
+) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return super::pocket_started_on(region, p, &[], relief, side);
+    }
+    p.validate()?;
+    relief.validate()?;
+    if region.is_empty() {
+        return Err(GenError::Empty("empty pocket region".into()));
+    }
+    let off = p.tool_diameter * 0.5 + p.stock_to_leave;
+    let base_center = non_sliver_center(region, off)?;
+    if base_center.is_empty() {
+        return Err(GenError::Invalid("pocket is narrower than the tool".into()));
+    }
+    let relief_plan = plan_corner_reliefs(region, &base_center, off, relief)?;
+
+    let strategy = match p.strategy {
+        PocketStrategy::Auto => {
+            let outer = region
+                .loops()
+                .iter()
+                .max_by(|a, b| a.area().abs().total_cmp(&b.area().abs()))
+                .map(|l| l.points())
+                .unwrap_or(&[]);
+            p.strategy.resolve(outer, p.stepover, p.tool_diameter, ARC_FIT_TOL)
+        }
+        s => s,
+    };
+    let zs = cut_levels_for(p.top_z, &p.links.approach, p.bottom_z, p.stepdown)?;
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    let mut ws = WalkState::new(p.links.approach.entry_top(p.top_z));
+    let mut prev_center: Option<Region> = None;
+    let mut blocked_levels: Vec<f64> = Vec::new();
+    let mut notes: Vec<String> = Vec::new();
+    let mut tally = FilletTally::default();
+
+    for &z in &zs {
+        let ko = avoid
+            .keepout_region(z, z, AVOID_PAD)
+            .map_err(GenError::Invalid)?;
+        let level_center = if ko.is_empty() {
+            base_center.clone()
+        } else {
+            for r in &relief_plan.reliefs {
+                if let Ok(cap) = capsule_region(r.start, r.end, r.radius)
+                    && !cap.intersect(&ko).map(|i| i.is_empty()).unwrap_or(false)
+                {
+                    return Err(GenError::Invalid(format!(
+                        "corner relief at ({:.3}, {:.3}) enters protected 'Do not touch' zone ({})",
+                        r.corner.x,
+                        r.corner.y,
+                        avoid.names_list()
+                    )));
+                }
+            }
+            base_center.difference(&ko)?
+        };
+        if level_center.is_empty() {
+            blocked_levels.push(z);
+            continue;
+        }
+        // Check overhead protected obstacles along descent/plunge from top/retract plane.
+        let hop = if ws.last_cut_z.is_none()
+            || matches!(p.links.level, crate::links::Link::Clearance)
+            || matches!(p.links.pass, crate::links::Link::Clearance)
+        {
+            p.clearance_z
+        } else {
+            p.retract_z.unwrap_or(p.clearance_z)
+        };
+        let top_above = hop.max(z);
+        let ko_entry = avoid
+            .keepout_region(z, top_above, AVOID_PAD)
+            .map_err(GenError::Invalid)?;
+        let level_center = if ko_entry.is_empty() {
+            level_center
+        } else {
+            let sub = level_center.difference(&ko_entry)?;
+            if sub.is_empty() {
+                blocked_levels.push(z);
+                continue;
+            }
+            sub
+        };
+        // #3744: Auto round a part cuts the one ring set from one side.
+        let side = &super::ring_side::resolve(&level_center, strategy, p.tool_diameter * 0.5, side)?;
+        let (passes, actual, room, joins, ramp_starts) = if strategy == PocketStrategy::Adaptive {
+            let what = format!("level at Z {z:.2}");
+            let (ps, anotes, act, rm, js) =
+                super::pocket_hsm::adaptive_passes(&level_center, p, &what, true, None)?;
+            notes.extend(anotes);
+            (ps, act, rm, js, Vec::new())
+        } else if matches!(strategy, PocketStrategy::Zigzag | PocketStrategy::Auto) {
+            // #3129: rows alone leave a cusp between row ends on each wall,
+            // island and keep-out edge; the level closes with its rings.
+            (rest_passes(&level_center, p.tiling_step(), p.climb)?, strategy, None, Vec::new(), Vec::new())
+        } else {
+            let (ps, pnotes, ramps) = ring_plan_ramped(region, &level_center, p, strategy, side, true)?;
+            notes.extend(pnotes.into_iter().filter(|n| !notes.contains(n)).collect::<Vec<_>>());
+            (ps, strategy, None, Vec::new(), ramps)
+        };
+        let fit = match actual {
+            PocketStrategy::Waterline | PocketStrategy::OffsetRings => Some(ARC_FIT_TOL),
+            PocketStrategy::Zigzag | PocketStrategy::Auto | PocketStrategy::Adaptive => None,
+        };
+        let mut passes = if p.links.approach.arc_xy && actual != PocketStrategy::Adaptive {
+            super::descent_xy::reseat_first(passes)
+        } else {
+            passes
+        };
+        if passes.iter().all(|ps| ps.len() < 2) {
+            blocked_levels.push(z);
+            continue;
+        }
+        let mut runs: Option<Vec<Vec<Seg>>> = if p.blend_turns && actual != PocketStrategy::Adaptive {
+            let legal = Legal { region: &level_center, inside: true, air_left: None };
+            let rho = corner_arc_radius(p.blend_radius, p.tool_diameter).map_err(GenError::Invalid)?;
+            let r = passes
+                .iter()
+                .map(|pass| {
+                    let Some((first, rest)) = pass.split_first() else {
+                        return Vec::new();
+                    };
+                    let walk = match fit {
+                        Some(tol) => fit_arcs(pass, tol),
+                        None => vec![Seg::Line(rest.to_vec())],
+                    };
+                    let (walk, t) = fillet_corners(&walk, *first, rho, ARC_FIT_TOL, &legal);
+                    tally.add(t);
+                    walk
+                })
+                .collect();
+            Some(r)
+        } else {
+            fit.map(|tol| passes.iter().map(|ps| fit_arcs(ps, tol)).collect())
+        };
+        if !relief_plan.reliefs.is_empty() {
+            inject_relief_spurs(&mut passes, &mut runs, &level_center, &relief_plan.reliefs);
+        }
+        let hr = room.as_ref().map_or(p.helix_radius, |rm| p.helix_radius.min(rm.helix_r));
+        let level_motion = Motion::new(p.clearance_z, p.retract_z, p.feed, p.plunge_feed)
+            .with_entry(p.entry, hr)
+            .with_arc_radius(p.tool_diameter)
+            .with_links(p.links, hr)
+            .with_top(p.links.approach.entry_top(p.top_z))
+            .with_xy_arc(p.links.approach.arc_xy)
+            .with_microlift(joins)
+            .with_solid_restart()
+            .with_cleared_links(side.start != PassStart::Auto)
+            .with_ramp_starts(ramp_starts);
+        let cert_entry = room.as_ref().map(|rm| Cert::Region(&rm.tess));
+        let cert_links = Cert::Region(&level_center);
+        walk_one_level(
+            &mut b,
+            z,
+            &passes,
+            runs.as_deref(),
+            &level_motion,
+            Some(cert_entry.as_ref().unwrap_or(&cert_links)),
+            Some(&cert_links),
+            prev_center.as_ref(),
+            &mut ws,
+        );
+        prev_center = Some(level_center);
+    }
+
+    if ws.last_cut_z.is_none() {
+        return Err(GenError::Invalid(format!(
+            "cannot cut clear of protected 'Do not touch' {}: no safe cutting room remains",
+            avoid.names_list()
+        )));
+    }
+    for n in notes {
+        b.note(n);
+    }
+    for n in tally.notes("pass", fillet_floor(ARC_FIT_TOL)) {
+        b.note(n);
+    }
+    let end_motion = Motion::new(p.clearance_z, p.retract_z, p.feed, p.plunge_feed)
+        .with_entry(p.entry, p.helix_radius)
+        .with_arc_radius(p.tool_diameter)
+        .with_links(p.links, p.helix_radius)
+        .with_top(p.links.approach.entry_top(p.top_z));
+    ws.finish(&mut b, &end_motion);
+    let cur = b.at();
+    b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, p.clearance_z), None);
+    if !blocked_levels.is_empty() {
+        b.note(format!(
+            "Do not touch ({}) blocked {} cut level(s); remaining levels stayed clear",
+            avoid.names_list(),
+            blocked_levels.len()
+        ));
+    }
+    let mut path = b.finish();
+    let _ = camcraft_sim::verify::elevate_rapid_links(&mut path, avoid, None, AVOID_PAD);
+    if let Some(why) = crate::approach::refusal(&path) {
+        return Err(GenError::Invalid(why).with_ghost(&path));
+    }
+    if !path.all_finite() {
+        return Err(GenError::Invalid("path left the finite horizon".into()));
+    }
+    Ok(path)
+}
diff --git a/crates/motion/src/machining2d/ring_side.rs b/crates/motion/src/machining2d/ring_side.rs
new file mode 100644
index 000000000..18939b7ab
--- /dev/null
+++ b/crates/motion/src/machining2d/ring_side.rs
@@ -0,0 +1,122 @@
+//! One ring set for every start side of an area round a part (#3744).
+//! The rings are the level curves of the distance from the part (the
+//! area's holes), clipped to the cutter-centre area: Inside walks them
+//! from the part out, Outside walks the very same pieces from the far
+//! edge in ([`mirror`]), and Auto only picks one of the two ([`resolve`]).
+//! The start side changes the start point and the ring order, never the
+//! rings.
+//!
+//! Provenance: contour-parallel offset rings measured from the selected
+//! contour (Held, "On the Computational Geometry of Pocket Machining",
+//! Springer LNCS 500, 1991); the mirror and the Auto rule are ours. No
+//! vendor material consulted.
+
+use crate::geo2d::{Loop, Point2, Region};
+
+use super::face::GenError;
+use super::level_order::{Piece, WALL, on_wall};
+use super::pass_start::{PassStart, StartSide};
+use super::pocket_strategy::PocketStrategy;
+
+/// The pieces of one part's ring set, from the part out (the Inside
+/// walk), turned into the Outside walk of the same set: each piece runs
+/// the other way (the uncut side swaps with the cut side, so climb stays
+/// climb), the area's outer edge becomes ring 0, ring `j` of `top`
+/// becomes ring `top + 1 - j`, and the part wall is cut last. Core
+/// pieces (a part with no hole) keep their own order.
+pub(super) fn mirror(pieces: &mut [Piece]) {
+    let top = pieces.iter().filter(|p| !p.core && p.level != WALL).map(|p| p.level).max().unwrap_or(0);
+    for p in pieces.iter_mut().filter(|p| !p.core) {
+        p.pts.reverse();
+        p.level = match p.level {
+            WALL => 0,
+            0 => WALL,
+            j => top.saturating_add(1).saturating_sub(j),
+        };
+    }
+}
+
+/// The one place where Auto chooses a start side for the rings of an
+/// area round a part (#3744): Outside when the stock footprint is known
+/// and the outer edge of the cutter-centre area stands in open air all
+/// round (an Outside start there owes no wall-first cut), else Inside.
+/// Every other case (a pocket, a row strategy, a side already chosen)
+/// is returned as it is.
+pub(super) fn resolve(center: &Region, strategy: PocketStrategy, tool_r: f64, side: &StartSide) -> Result<StartSide, GenError> {
+    let rings = matches!(strategy, PocketStrategy::Waterline | PocketStrategy::OffsetRings);
+    if side.start != PassStart::Auto || !side.around_part || !rings {
+        return Ok(side.clone());
+    }
+    if !(tool_r.is_finite() && tool_r > 0.0) {
+        return Err(GenError::Invalid("the tool radius must be positive and finite".into()));
+    }
+    let open = match side.stock.as_ref() {
+        Some(stock) => {
+            let mut open = true;
+            for l in outer_loops(center)? {
+                if on_wall(l.points(), Some(stock), tool_r, 0.25 * tool_r) {
+                    open = false;
+                    break;
+                }
+            }
+            open
+        }
+        None => false,
+    };
+    let start = if open { PassStart::Outside } else { PassStart::Inside };
+    Ok(StartSide { start, ..side.clone() })
+}
+
+/// The counter-clockwise loops of `region` that no other one encloses:
+/// its outer edges (material nested in a hole has its own loop inside).
+fn outer_loops(region: &Region) -> Result<Vec<&Loop>, GenError> {
+    let ccw: Vec<&Loop> = region.loops().iter().filter(|l| l.is_ccw()).collect();
+    let mut out = Vec::new();
+    for (i, l) in ccw.iter().enumerate() {
+        let Some(&p) = l.points().first() else { continue };
+        let mut nested = false;
+        for (k, o) in ccw.iter().enumerate() {
+            if k != i && Region::new(vec![(*o).clone()])?.contains(p) {
+                nested = true;
+                break;
+            }
+        }
+        if !nested {
+            out.push(*l);
+        }
+    }
+    Ok(out)
+}
+
+/// A ring piece as a set of points: open pieces from the smaller end,
+/// closed rings from their smallest vertex and counter-clockwise. Two
+/// walks of one ring in any start point and sense read the same.
+#[cfg(test)]
+pub(super) fn normal(p: &Piece) -> (bool, Vec<Point2>) {
+    let lex = |a: &Point2, b: &Point2| a.x.total_cmp(&b.x).then(a.y.total_cmp(&b.y));
+    let mut pts = p.pts.clone();
+    if p.closed {
+        if pts.len() > 1 && pts.first() == pts.last() {
+            pts.pop();
+        }
+        let area: f64 = (0..pts.len()).map(|i| {
+            let (a, b) = (pts[i], pts[(i + 1) % pts.len()]);
+            a.x * b.y - b.x * a.y
+        }).sum();
+        if area < 0.0 {
+            pts.reverse();
+        }
+        if let Some(k) = (0..pts.len()).min_by(|&a, &b| lex(&pts[a], &pts[b])) {
+            pts.rotate_left(k);
+        }
+    } else if let (Some(a), Some(b)) = (pts.first(), pts.last())
+        && lex(b, a).is_lt()
+    {
+        pts.reverse();
+    }
+    (p.closed, pts)
+}
+
+#[cfg(test)]
+#[path = "ring_side_tests.rs"]
+mod tests;
diff --git a/crates/motion/src/machining2d/ring_side_tests.rs b/crates/motion/src/machining2d/ring_side_tests.rs
new file mode 100644
index 000000000..f4685c3ca
--- /dev/null
+++ b/crates/motion/src/machining2d/ring_side_tests.rs
@@ -0,0 +1,132 @@
+//! #3744 pins of the one ring set, on a dog-bone part (two discs of
+//! radius 12 at X -15 and X 15, joined by a neck 8 mm wide) in a stock
+//! box of 80 x 50, a tool of radius 4 and a step of 2.
+
+use super::{mirror, normal, resolve};
+use crate::geo2d::{Loop, Point2, Region};
+use crate::machining2d::level_order::{Piece, WALL};
+use crate::machining2d::level_rings::level_pieces;
+use crate::machining2d::pass_start::{PassStart, StartSide};
+use crate::machining2d::pocket_strategy::PocketStrategy;
+
+const R: f64 = 4.0;
+const STEP: f64 = 2.0;
+
+fn region(loops: Vec<Vec<Point2>>) -> Region {
+    let loops = loops.into_iter().map(|l| Loop::new(l).unwrap_or_else(|e| panic!("loop: {e:?}"))).collect();
+    Region::new(loops).unwrap_or_else(|e| panic!("region: {e:?}"))
+}
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Vec<Point2> {
+    vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)]
+}
+
+fn disc(cx: f64, r: f64) -> Vec<Point2> {
+    (0..128)
+        .map(|k| {
+            let a = f64::from(k) * std::f64::consts::TAU / 128.0;
+            Point2::new(cx + r * a.cos(), r * a.sin())
+        })
+        .collect()
+}
+
+/// The stock, and the band the tool's disc may sweep round the part: the
+/// stock grown by the tool radius less the part, and its cutter-centre
+/// area (the stock box less the part grown by the radius).
+fn dog_bone() -> (Region, Region, Region) {
+    let part = region(vec![disc(-15.0, 12.0)])
+        .union(&region(vec![disc(15.0, 12.0)]))
+        .and_then(|p| p.union(&region(vec![rect(-15.0, -4.0, 15.0, 4.0)])))
+        .unwrap_or_else(|e| panic!("part: {e:?}"));
+    let stock = region(vec![rect(-40.0, -25.0, 40.0, 25.0)]);
+    let band = stock.offset(R).and_then(|s| s.difference(&part)).unwrap_or_else(|e| panic!("band: {e:?}"));
+    let center = band.offset(-R).unwrap_or_else(|e| panic!("center: {e:?}"));
+    (stock, band, center)
+}
+
+fn pieces(start: PassStart) -> Vec<Piece> {
+    let (_, band, center) = dog_bone();
+    match level_pieces(&band, &center, R, STEP, true, start, true) {
+        Ok(Some(p)) => p,
+        other => panic!("{start:?}: {:?}", other.map(|o| o.map(|p| p.len()))),
+    }
+}
+
+/// Each piece in its normal form, sorted: the ring set as a multiset.
+fn set(ps: &[Piece]) -> Vec<(bool, Vec<Point2>)> {
+    let mut out: Vec<(bool, Vec<Point2>)> = ps.iter().map(normal).collect();
+    out.sort_by(|a, b| {
+        let key = |p: &(bool, Vec<Point2>)| p.1.first().map_or((0.0, 0.0), |q| (q.x, q.y));
+        let (ka, kb) = (key(a), key(b));
+        ka.0.total_cmp(&kb.0).then(ka.1.total_cmp(&kb.1)).then(a.1.len().cmp(&b.1.len()))
+    });
+    out
+}
+
+fn same(a: &[(bool, Vec<Point2>)], b: &[(bool, Vec<Point2>)]) -> bool {
+    a.len() == b.len()
+        && a.iter().zip(b).all(|(x, y)| {
+            x.0 == y.0 && x.1.len() == y.1.len() && x.1.iter().zip(&y.1).all(|(p, q)| (p.x - q.x).hypot(p.y - q.y) <= 1e-3)
+        })
+}
+
+/// #3744 pin: Inside and Outside cut the same multiset of rings (within
+/// a micron, after a start-point and sense normalisation). Only the ring
+/// order differs: Inside's first ring (on the part) is Outside's last,
+/// and Outside's first ring is the area's outer edge.
+#[test]
+fn inside_and_outside_cut_the_same_rings() {
+    let inside = pieces(PassStart::Inside);
+    let outside = pieces(PassStart::Outside);
+    assert!(inside.len() > 4, "the fixture has rings: {}", inside.len());
+    assert!(same(&set(&inside), &set(&outside)), "the ring sets differ: {} Inside pieces, {} Outside pieces", inside.len(), outside.len());
+    let at = |ps: &[Piece], lev: u32| set(&ps.iter().filter(|p| p.level == lev).map(|p| Piece { level: lev, pts: p.pts.clone(), closed: p.closed, core: p.core }).collect::<Vec<_>>());
+    assert!(same(&at(&inside, 0), &at(&outside, WALL)), "the part wall is Inside's first ring and Outside's last");
+    assert!(same(&at(&inside, WALL), &at(&outside, 0)), "the outer edge is Outside's first ring and Inside's last");
+    // The order runs the other way: the ring next to the part is cut
+    // early by Inside and late by Outside.
+    let top = inside.iter().filter(|p| p.level != WALL).map(|p| p.level).max().unwrap_or(0);
+    assert!(same(&at(&inside, 1), &at(&outside, top)), "ring 1 of Inside is ring {top} of Outside");
+}
+
+/// The mirror keeps the climb sense: a piece walked the other way has its
+/// uncut side on the other hand, so each Outside piece is the Inside
+/// piece reversed, never the same walk.
+#[test]
+fn the_mirror_reverses_each_piece_and_swaps_the_ends_of_the_order() {
+    let mut ps = vec![
+        Piece { level: 0, pts: vec![Point2::new(0.0, 0.0), Point2::new(1.0, 0.0)], closed: false, core: false },
+        Piece { level: 2, pts: vec![Point2::new(0.0, 1.0), Point2::new(1.0, 1.0)], closed: false, core: false },
+        Piece { level: 3, pts: vec![Point2::new(0.0, 2.0), Point2::new(1.0, 2.0)], closed: false, core: false },
+        Piece { level: WALL, pts: vec![Point2::new(0.0, 3.0), Point2::new(1.0, 3.0)], closed: false, core: false },
+        Piece { level: 5, pts: vec![Point2::new(9.0, 9.0), Point2::new(8.0, 9.0)], closed: true, core: true },
+    ];
+    mirror(&mut ps);
+    let levels: Vec<u32> = ps.iter().map(|p| p.level).collect();
+    assert_eq!(levels, vec![WALL, 2, 1, 0, 5]);
+    assert_eq!(ps[0].pts.first().map(|p| p.x), Some(1.0), "reversed");
+    assert_eq!(ps[4].pts.first().map(|p| p.x), Some(9.0), "a core piece keeps its walk");
+}
+
+fn side(start: PassStart, stock: Option<Region>, around_part: bool) -> StartSide {
+    StartSide { start, stock, around_part }
+}
+
+/// #3744 pin: Auto round a part takes one of the two sides of the one
+/// ring set: Outside when the stock box leaves the outer edge in air,
+/// Inside when the stock is unknown or the outer edge stands in the
+/// stock. A chosen side, a pocket and a row strategy stay as they are.
+#[test]
+fn auto_picks_one_side_of_the_one_ring_set() {
+    let (stock, _, center) = dog_bone();
+    let pick = |s: &StartSide, strategy| resolve(&center, strategy, R, s).map(|r| r.start).unwrap_or_else(|e| panic!("{e:?}"));
+    let w = PocketStrategy::Waterline;
+    assert_eq!(pick(&side(PassStart::Auto, Some(stock.clone()), true), w), PassStart::Outside);
+    assert_eq!(pick(&side(PassStart::Auto, None, true), w), PassStart::Inside);
+    let big = region(vec![rect(-60.0, -45.0, 60.0, 45.0)]);
+    assert_eq!(pick(&side(PassStart::Auto, Some(big.clone()), true), w), PassStart::Inside, "the outer edge stands in the stock");
+    assert_eq!(pick(&side(PassStart::Auto, Some(stock.clone()), false), w), PassStart::Auto, "a pocket keeps Auto");
+    assert_eq!(pick(&side(PassStart::Auto, Some(stock.clone()), true), PocketStrategy::Zigzag), PassStart::Auto);
+    assert_eq!(pick(&side(PassStart::Inside, Some(stock), true), w), PassStart::Inside);
+    assert!(resolve(&center, w, f64::NAN, &side(PassStart::Auto, Some(big), true)).is_err(), "NaN is refused");
+}
