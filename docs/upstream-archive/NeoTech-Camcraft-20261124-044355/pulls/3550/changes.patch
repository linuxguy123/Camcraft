+        "radio click stages draft only; Apply commits"
+    );
+
+    harness.get_by_label("Apply").scroll_to_me();
+    harness.run();
+    harness.get_by_label("Apply").click();
+    harness.run();
+
+    let live_wl = model::find_by_name(&harness.state().state.world, "3D Finish1")
