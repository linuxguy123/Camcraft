+        let six = camcraft_app::vise::size("6 in").map(camcraft_app::vise::ViseSize::half_open).expect("6 in");
+        st.pending.push_back(CommandKind::InsertBuiltinVise {
+            setup: Some("Setup1".into()),
+            params: six,
+            fit_stock: false,
+            pos: [0.0, 200.0, 0.0],
+            yaw_deg: 0.0,
