diff --git a/crates/app/src/mcp/plate_tools.rs b/crates/app/src/mcp/plate_tools.rs
new file mode 100644
index 00000000..12fc471a
--- /dev/null
+++ b/crates/app/src/mcp/plate_tools.rs
@@ -0,0 +1,241 @@
+//! The MCP fixture plate tools (#819): add a built-in grid plate, change
+//! its figures, place any fixture at a grid location or on a dowel pair,
+//! detect an imported plate's grid from its holes, and read a plate's
+//! grid. Each edit is the very undoable command the Fixtures page queues
+//! (`InsertPlate`, `SetPlate`, `PlaceOnPlate`, `SetPlateGrid`), one
+//! History step.
+//!
+//! Provenance: our own tool surface over this repo's plate commands.
+
+use serde_json::{Map, Value, json};
+
+use super::setup_tools::{cmd_err, loc_view, obj, opt_nums, point, setup_or_active};
+use super::tools::{Tool, req_str};
+use crate::commands::fixture_plate::plate_of;
+use crate::commands::{InsertPlate, PlaceOnPlate, PlatePlacement, SetPlate, SetPlateGrid};
+use crate::geometry::IDENTITY_Q;
+use crate::plate::{self, Counterbore, Dowels, Grid, MountAt, PlateDef, PlateParams, mount};
+use crate::schema::Location;
+use crate::script::{Env, fnum};
+
+pub(super) const TOOLS: &[Tool] = &[
+    Tool { name: "add_fixture_plate", description: "Place a built-in generic grid (tooling) plate as a fixture of a setup - the active one by default. Its frame's origin is the plate's corner on its TOP face (x along the length, y along the width, the slab below). Grid locations: rows lettered along +Y from A, columns numbered along +X from 1 (A1 nearest the origin corner). Either lay it centred on the machine's table (on_table) or give a position/rotation. Optional overrides in mm, thread, dowel pattern and counterbore. The collision mesh is a solid slab. One undoable step; nonsense figures are refused by name.", schema: s_add, run: add_fixture_plate },
+    Tool { name: "set_fixture_plate", description: "Change a placed built-in plate's figures (dimensions, thread, dowels, counterbore). The mesh is regenerated and every fixture on it is re-placed at its named location (refused if a location is gone or a fixture would hang off). One undoable step.", schema: s_set, run: set_fixture_plate },
+    Tool { name: "place_on_plate", description: "Place a fixture (a built-in vise, an imported fixture, another plate) on a plate: at a grid hole (\"C3\": its frame's origin on the hole at the plate top) or on a dowel pair ([\"A1\",\"A3\"]: origin on the first, +X toward the second), turned yaw degrees about the plate's Z. The place is remembered: moving the plate moves it. Refused by name: an unknown location, a fixture hanging off the plate. One undoable step.", schema: s_place, run: place_on_plate },
+    Tool { name: "detect_plate_grid", description: "Make an imported fixture a plate by detecting its hole grid (the Detect holes rule, read in the model's own frame: holes on its Z, an axis-aligned lattice). Refused by name when its holes form no regular grid. clear: true stops it being a plate. One undoable step.", schema: s_detect, run: detect_plate_grid },
+    Tool { name: "get_plate_grid", description: "Read a plate's grid: pitch, rows and columns, the location names, gaps, the dowel lattice, and the fixtures standing on it.", schema: s_name, run: get_plate_grid },
+];
+
+const DIMS: [&str; 8] = ["length", "width", "thickness", "pitch_x", "pitch_y", "offset_x", "offset_y", "thread_diameter"];
+
+fn num(v: &Value, k: &str) -> Result<f64, String> {
+    v.as_f64().ok_or_else(|| format!("\"{k}\" must be a number of mm"))
+}
+
+/// `p` with every override in `a` applied.
+fn with_overrides(mut p: PlateParams, a: &Map<String, Value>) -> Result<PlateParams, String> {
+    if let Some(d) = a.get("dimensions") {
+        let d = d.as_object().ok_or("\"dimensions\" must be an object of mm lengths")?;
+        for (k, v) in d {
+            let slot = match k.as_str() {
+                "length" => &mut p.length,
+                "width" => &mut p.width,
+                "thickness" => &mut p.thickness,
+                "pitch_x" => &mut p.pitch_x,
+                "pitch_y" => &mut p.pitch_y,
+                "offset_x" => &mut p.offset_x,
+                "offset_y" => &mut p.offset_y,
+                "thread_diameter" => &mut p.thread_diameter,
+                other => return Err(format!("unknown plate dimension \"{other}\" (one of {})", DIMS.join(", "))),
+            };
+            *slot = num(v, k)?;
+        }
+    }
+    if let Some(t) = a.get("thread") {
+        p.thread = t.as_str().ok_or("\"thread\" must be a string such as 3/8-16 or M10")?.to_owned();
+    }
+    match a.get("dowels") {
+        None => {}
+        Some(Value::Null | Value::Bool(false)) => p.dowels = None,
+        Some(Value::Object(o)) => {
+            let f = |k: &str| o.get(k).ok_or_else(|| format!("dowels needs \"{k}\"")).and_then(|v| num(v, k));
+            p.dowels = Some(Dowels { pitch_x: f("pitch_x")?, pitch_y: f("pitch_y")?, offset_x: f("offset_x")?, offset_y: f("offset_y")?, diameter: f("diameter")? });
+        }
+        Some(_) => return Err("\"dowels\" must be an object or null".into()),
+    }
+    match a.get("counterbore") {
+        None => {}
+        Some(Value::Null | Value::Bool(false)) => p.counterbore = None,
+        Some(Value::Object(o)) => {
+            let f = |k: &str| o.get(k).ok_or_else(|| format!("counterbore needs \"{k}\"")).and_then(|v| num(v, k));
+            p.counterbore = Some(Counterbore { diameter: f("diameter")?, depth: f("depth")? });
+        }
+        Some(_) => return Err("\"counterbore\" must be an object or null".into()),
+    }
+    Ok(p)
+}
+
+fn grid_view(g: &Grid) -> Value {
+    json!({
+        "first": [fnum(g.x0), fnum(g.y0)], "pitch": [fnum(g.pitch_x), fnum(g.pitch_y)],
+        "rows": g.rows, "cols": g.cols, "extent": g.extent(), "diameter": fnum(g.diameter), "missing": g.missing, "staggered": g.stagger.is_some(),
+    })
+}
+
+fn plate_view(d: &PlateDef) -> Value {
+    json!({
+        "builtin": d.params.is_some(),
+        "params": d.params.as_ref().map(|p| json!({
+            "size": p.size, "length": fnum(p.length), "width": fnum(p.width), "thickness": fnum(p.thickness),
+            "thread": p.thread, "thread_diameter": fnum(p.thread_diameter),
+            "counterbore": p.counterbore.as_ref().map(|c| json!({ "diameter": fnum(c.diameter), "depth": fnum(c.depth) })),
+        })),
+        "top_z": fnum(d.top_z),
+        "grid": grid_view(&d.holes),
+        "dowels": d.dowels.as_ref().map(grid_view),
+    })
+}
+
+fn add_fixture_plate(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let label = req_str(a, "preset")?;
+    let row = plate::preset(label).ok_or_else(|| {
+        let all: Vec<&str> = plate::PRESETS.iter().map(|s| s.label).collect();
+        format!("no built-in plate '{label}' (one of {})", all.join(", "))
+    })?;
+    let params = with_overrides(row.params(), a)?;
+    let target = setup_or_active(env, a)?;
+    let placement = if matches!(a.get("on_table"), Some(Value::Bool(true))) {
+        PlatePlacement::OnTable
+    } else {
+        let pos = opt_nums::<3>(a, "position")?.unwrap_or([0.0; 3]);
+        let rot = opt_nums::<4>(a, "rotation")?.unwrap_or(IDENTITY_Q);
+        PlatePlacement::At(Location { pos: point(pos), rot })
+    };
+    let cmd = InsertPlate::new(&env.world, &params, target.as_deref(), placement).map_err(cmd_err)?;
+    let name = cmd.name().to_owned();
+    let view = cmd.plate().map(plate_view);
+    let loc = cmd.location();
+    env.history.execute(&env.world, cmd);
+    let mut out = loc_view(&loc);
+    out["fixture"] = json!(name);
+    out["setup"] = json!(target);
+    out["plate"] = json!(view);
+    Ok(out)
+}
+
+fn set_fixture_plate(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let name = req_str(a, "name")?;
+    let current = plate_of(&env.world, name).map_err(cmd_err)?.params.ok_or_else(|| format!("'{name}' is not a built-in plate"))?;
+    let cmd = SetPlate::new(&env.world, name, with_overrides(current, a)?).map_err(cmd_err)?;
+    let moved: Vec<String> = cmd.moved().map(str::to_owned).collect();
+    env.history.execute(&env.world, cmd);
+    let view = plate_of(&env.world, name).ok().map(|d| plate_view(&d));
+    Ok(json!({ "fixture": name, "plate": view, "moved": moved }))
+}
+
+fn place_on_plate(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let name = req_str(a, "fixture")?;
+    let plate = req_str(a, "plate")?;
+    let at = match (a.get("hole"), a.get("dowels")) {
+        (Some(h), None) => MountAt::Hole(h.as_str().ok_or("\"hole\" must be a location such as C3")?.to_owned()),
+        (None, Some(Value::Array(d))) if d.len() == 2 => {
+            let s = |v: &Value| v.as_str().map(str::to_owned).ok_or("\"dowels\" must be two locations such as [\"A1\", \"A3\"]");
+            MountAt::Dowels([s(&d[0])?, s(&d[1])?])
+        }
+        (None, Some(_)) => return Err("\"dowels\" must be two locations such as [\"A1\", \"A3\"]".into()),
+        _ => return Err("give \"hole\" or \"dowels\", one of them".into()),
+    };
+    let yaw = match a.get("yaw") {
+        None | Some(Value::Null) => 0.0,
+        Some(v) => v.as_f64().ok_or("\"yaw\" must be degrees")?,
+    };
+    let label = at.label();
+    let cmd = PlaceOnPlate::new(&env.world, name, plate, at, yaw).map_err(cmd_err)?;
+    let loc = cmd.location();
+    env.history.execute(&env.world, cmd);
+    let mut out = loc_view(&loc);
+    out["fixture"] = json!(name);
+    out["plate"] = json!(plate);
+    out["at"] = json!(label);
+    Ok(out)
+}
+
+fn detect_plate_grid(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let name = req_str(a, "name")?;
+    let cmd = if matches!(a.get("clear"), Some(Value::Bool(true))) {
+        SetPlateGrid::clear(&env.world, name)
+    } else {
+        SetPlateGrid::detect(&env.world, name)
+    }
+    .map_err(cmd_err)?;
+    let view = cmd.plate().map(plate_view);
+    env.history.execute(&env.world, cmd);
+    Ok(json!({ "fixture": name, "plate": view }))
+}
+
+fn get_plate_grid(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let name = req_str(a, "name")?;
+    let d = plate_of(&env.world, name).map_err(cmd_err)?;
+    let names: Vec<String> = d.holes.holes().into_iter().map(|(n, _, _)| n).collect();
+    let mut out = plate_view(&d);
+    out["fixture"] = json!(name);
+    out["locations"] = json!(names);
+    out["carries"] = json!(mount::riders(&env.world, name));
+    Ok(out)
+}
+
+fn overrides_schema() -> Value {
+    let props: Map<String, Value> =
+        DIMS.iter().map(|d| ((*d).to_owned(), json!({ "type": "number", "description": "mm" }))).collect();
+    json!({
+        "dimensions": { "type": "object", "properties": props, "additionalProperties": false,
+            "description": "Override the preset's figures (mm). offset_x/offset_y place A1 from the origin corner." },
+        "thread": { "type": "string", "description": "The thread's name, e.g. 3/8-16 or M10." },
+        "dowels": { "type": ["object", "null"], "description": "A dowel lattice {pitch_x, pitch_y, offset_x, offset_y, diameter} mm, or null for none." },
+        "counterbore": { "type": ["object", "null"], "description": "Counterbored grid holes {diameter, depth} mm, or null for none." }
+    })
+}
+
+fn s_add() -> Value {
+    let presets: Vec<&str> = plate::PRESETS.iter().map(|s| s.label).collect();
+    let mut props = overrides_schema();
+    props["preset"] = json!({ "type": "string", "enum": presets, "description": "The preset plate." });
+    props["setup"] = json!({ "type": "string", "description": "The declared setup; defaults to the active one." });
+    props["on_table"] = json!({ "type": "boolean", "description": "Centre it on the setup machine's table, lying on its top (ignores position/rotation)." });
+    props["position"] = json!({ "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "Where the plate frame's origin goes [x, y, z] mm." });
+    props["rotation"] = json!({ "type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "Unit quaternion [x, y, z, w]." });
+    obj(props, &["preset"])
+}
+
+fn s_set() -> Value {
+    let mut props = overrides_schema();
+    props["name"] = json!({ "type": "string", "description": "A built-in plate fixture's name." });
+    obj(props, &["name"])
+}
+
+fn s_place() -> Value {
+    obj(
+        json!({
+            "fixture": { "type": "string", "description": "The fixture to place." },
+            "plate": { "type": "string", "description": "The plate fixture it stands on." },
+            "hole": { "type": "string", "description": "A grid location, e.g. C3 (row letter, column number)." },
+            "dowels": { "type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2, "description": "Two dowel-lattice locations." },
+            "yaw": { "type": "number", "description": "Turn about the plate's Z, degrees (default 0)." }
+        }),
+        &["fixture", "plate"],
+    )
+}
+
+fn s_detect() -> Value {
+    obj(
+        json!({
+            "name": { "type": "string", "description": "An imported fixture's name." },
+            "clear": { "type": "boolean", "description": "Stop it being a plate instead." }
+        }),
+        &["name"],
+    )
+}
+
+fn s_name() -> Value {
+    obj(json!({ "name": { "type": "string", "description": "A plate fixture's name." } }), &["name"])
+}
diff --git a/crates/app/src/mcp/tools.rs b/crates/app/src/mcp/tools.rs
index 813330a0..e7b683c0 100644
--- a/crates/app/src/mcp/tools.rs
+++ b/crates/app/src/mcp/tools.rs
@@ -59,6 +59,7 @@ fn all() -> impl Iterator<Item = &'static Tool> {
         .chain(super::align_tools::TOOLS)
         .chain(super::model_tools::TOOLS)
         .chain(super::vise_tools::TOOLS)
+        .chain(super::plate_tools::TOOLS)
 }
 
 /// The `tools/list` rows.
diff --git a/crates/app/src/plate.rs b/crates/app/src/plate.rs
new file mode 100644
index 00000000..23fedf2a
--- /dev/null
+++ b/crates/app/src/plate.rs
@@ -0,0 +1,330 @@
+//! Fixture plates (#819, part of #339): a grid (tooling) plate - a slab
+//! with a regular lattice of tapped holes, an optional dowel pattern
+//! and optional counterbores - placed as an ordinary fixture, and the
+//! grid other fixtures are placed on by named location.
+//!
+//! Two kinds of plate share one grid model ([`PlateDef`]): a built-in,
+//! parametric plate (`PlateParams`, its mesh generated as a SOLID slab -
+//! holes drawn solid, which is conservative for the fixture laws), and
+//! an imported plate whose grid is derived from its detected holes
+//! (`detect`).
+//!
+//! **The grid convention.** Locations are named like a spreadsheet:
+//! letters for the row, numbers for the column. In the plate's own
+//! frame, columns count along +X from 1 and rows along +Y from A (A, B,
+//! ..., Z, AA, AB, ...). A1 is the hole nearest the frame's origin
+//! corner; B3 is the second row's third hole. A built-in plate's frame
+//! has its origin at the plate's corner on its TOP face (x along the
+//! length, y along the width, the slab below z = 0), so fixtures stand
+//! on z = 0. Dowel holes form their own lattice, named the same way.
+//!
+//! Provenance: our own model and naming; grid plates with tapped and
+//! dowel lattices are common shop workholding (machine-shop handbooks).
+//! The presets are generic sizes of our own; no vendor model or
+//! dimension is copied (`docs/decisions/819-fixture-plates.md`).
+
+use serde::{Deserialize, Serialize};
+
+use crate::geometry::{Point3, Triangle};
+
+pub mod detect;
+pub mod grid;
+pub mod mount;
+pub mod table;
+
+pub use grid::{Grid, location_name, parse_location, row_letters};
+pub use mount::{MountAt, PlateMount, RiderMove};
+pub use table::{PRESETS, PlatePreset, preset};
+
+/// The most holes one lattice may name (a bound on every loop over it).
+pub const MAX_HOLES: u64 = 20_000;
+
+/// An optional dowel-hole lattice on a built-in plate (mm).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Dowels {
+    pub pitch_x: f64,
+    pub pitch_y: f64,
+    pub offset_x: f64,
+    pub offset_y: f64,
+    pub diameter: f64,
+}
+
+/// Optional counterbores on the grid holes (mm), recorded for the
+/// markers and the setup sheet; the collision slab stays solid.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Counterbore {
+    pub diameter: f64,
+    pub depth: f64,
+}
+
+/// A built-in plate's parameters (mm).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct PlateParams {
+    /// The preset it started from; free text once edited.
+    pub size: String,
+    /// Along the plate frame's X.
+    pub length: f64,
+    /// Along the plate frame's Y.
+    pub width: f64,
+    pub thickness: f64,
+    pub pitch_x: f64,
+    pub pitch_y: f64,
+    /// A1's distance from the origin corner, along X and Y. The lattice
+    /// runs on while a hole keeps at least this margin to the far edge.
+    pub offset_x: f64,
+    pub offset_y: f64,
+    /// The thread's name ("3/8-16", "M10").
+    pub thread: String,
+    /// The thread's major diameter.
+    pub thread_diameter: f64,
+    #[serde(default)]
+    pub dowels: Option<Dowels>,
+    #[serde(default)]
+    pub counterbore: Option<Counterbore>,
+}
+
+/// What makes a fixture a plate: its hole grid (and dowel grid) in its
+/// model frame, the top face fixtures stand on, and - for a built-in
+/// plate - the parameters its mesh and grid were generated from.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct PlateDef {
+    #[serde(default)]
+    pub params: Option<PlateParams>,
+    pub top_z: f64,
+    pub holes: Grid,
+    #[serde(default)]
+    pub dowels: Option<Grid>,
+}
+
+/// A fixture's plate roles, riding its `FixtureDef`: it may BE a plate,
+/// and it may be placed ON one (a subplate is both). Default: neither.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct PlateLink {
+    pub plate: Option<PlateDef>,
+    pub mount: Option<PlateMount>,
+}
+
+/// Lattice nodes from `offset` while a node keeps `offset` to the far
+/// edge `span` (the symmetric-margin rule), at least one.
+fn count(span: f64, offset: f64, pitch: f64) -> u64 {
+    let n = ((span - 2.0 * offset) / pitch + 1e-9).floor();
+    if n.is_finite() && n >= 0.0 { (n as u64).saturating_add(1) } else { 0 }
+}
+
+impl PlateParams {
+    fn named(&self) -> [(&'static str, f64); 7] {
+        [
+            ("length", self.length),
+            ("width", self.width),
+            ("thickness", self.thickness),
+            ("pitch X", self.pitch_x),
+            ("pitch Y", self.pitch_y),
+            ("thread diameter", self.thread_diameter),
+            ("first-hole offset X", self.offset_x),
+        ]
+    }
+
+    /// The plate law. Every figure a positive, finite length; the first
+    /// hole far enough in that the hole is on the plate; holes narrower
+    /// than the pitch; dowels clear of the tapped holes; a counterbore
+    /// wider than the thread, narrower than the pitch and shallower than
+    /// the plate. Refusals name the figure.
+    pub fn check(&self) -> Result<(), String> {
+        let mut figs = self.named().to_vec();
+        figs.push(("first-hole offset Y", self.offset_y));
+        for (what, v) in figs {
+            if !v.is_finite() {
+                return Err(format!("plate {what} must be a finite length (got {v})"));
+            }
+            if v <= 0.0 {
+                return Err(format!("plate {what} must be more than zero (got {v} mm)"));
+            }
+        }
+        let r = 0.5 * self.thread_diameter;
+        for (axis, off, span) in [("X", self.offset_x, self.length), ("Y", self.offset_y, self.width)] {
+            if off < r {
+                return Err(format!("plate first-hole offset {axis} {off:.3} mm puts the hole over the edge (thread radius {r:.3} mm)"));
+            }
+            if 2.0 * off > span {
+                return Err(format!("plate first-hole offset {axis} {off:.3} mm is more than half the plate ({span:.3} mm)"));
+            }
+        }
+        if self.thread_diameter >= self.pitch_x.min(self.pitch_y) {
+            return Err(format!(
+                "plate thread diameter {:.3} mm must be smaller than the pitch {:.3} mm",
+                self.thread_diameter,
+                self.pitch_x.min(self.pitch_y)
+            ));
+        }
+        if self.thread.trim().is_empty() {
+            return Err("plate thread needs a name (e.g. 3/8-16, M10)".into());
+        }
+        let holes = count(self.length, self.offset_x, self.pitch_x).saturating_mul(count(self.width, self.offset_y, self.pitch_y));
+        if holes > MAX_HOLES {
+            return Err(format!("plate grid has {holes} holes, more than {MAX_HOLES}"));
+        }
+        if let Some(c) = &self.counterbore {
+            for (what, v) in [("counterbore diameter", c.diameter), ("counterbore depth", c.depth)] {
+                if !(v.is_finite() && v > 0.0) {
+                    return Err(format!("plate {what} must be a length more than zero (got {v})"));
+                }
+            }
+            if c.diameter <= self.thread_diameter {
+                return Err(format!("plate counterbore diameter {:.3} mm must be wider than the thread {:.3} mm", c.diameter, self.thread_diameter));
+            }
+            if c.diameter >= self.pitch_x.min(self.pitch_y) {
+                return Err(format!("plate counterbore diameter {:.3} mm must be smaller than the pitch", c.diameter));
+            }
+            if c.depth >= self.thickness {
+                return Err(format!("plate counterbore depth {:.3} mm must be less than the thickness {:.3} mm", c.depth, self.thickness));
+            }
+        }
+        if let Some(d) = &self.dowels {
+            self.check_dowels(d)?;
+        }
+        Ok(())
+    }
+
+    fn check_dowels(&self, d: &Dowels) -> Result<(), String> {
+        for (what, v) in [
+            ("dowel pitch X", d.pitch_x),
+            ("dowel pitch Y", d.pitch_y),
+            ("dowel offset X", d.offset_x),
+            ("dowel offset Y", d.offset_y),
+            ("dowel diameter", d.diameter),
+        ] {
+            if !(v.is_finite() && v > 0.0) {
+                return Err(format!("plate {what} must be a length more than zero (got {v})"));
+            }
+        }
+        let r = 0.5 * d.diameter;
+        if d.offset_x < r || d.offset_y < r || 2.0 * d.offset_x > self.length || 2.0 * d.offset_y > self.width {
+            return Err("plate dowel offset puts the first dowel hole off the plate".into());
+        }
+        if d.diameter >= d.pitch_x.min(d.pitch_y) {
+            return Err(format!("plate dowel diameter {:.3} mm must be smaller than the dowel pitch", d.diameter));
+        }
+        let n = count(self.length, d.offset_x, d.pitch_x).saturating_mul(count(self.width, d.offset_y, d.pitch_y));
+        if n > MAX_HOLES {
+            return Err(format!("plate dowel pattern has {n} holes, more than {MAX_HOLES}"));
+        }
+        // Clear of every tapped hole: the nearest lattice node to each
+        // dowel, by rounding, is the only one that can touch it.
+        let g = self.grid();
+        let clear = 0.5 * (d.diameter + self.thread_diameter);
+        for (name, x, y) in self.dowel_grid().map(|g| g.holes()).unwrap_or_default() {
+            let c = ((x - g.x0) / g.pitch_x).round().clamp(0.0, f64::from(g.cols.saturating_sub(1)));
+            let r = ((y - g.y0) / g.pitch_y).round().clamp(0.0, f64::from(g.rows.saturating_sub(1)));
+            let (hx, hy) = g.node(r as u32, c as u32);
+            if (x - hx).hypot(y - hy) < clear {
+                return Err(format!(
+                    "plate dowel hole {name} runs into tapped hole {} - move the dowel pattern",
+                    location_name(r as u32, c as u32)
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    /// The tapped-hole lattice (unchecked params give an empty one).
+    #[must_use]
+    pub fn grid(&self) -> Grid {
+        let cols = u32::try_from(count(self.length, self.offset_x, self.pitch_x)).unwrap_or(0);
+        let rows = u32::try_from(count(self.width, self.offset_y, self.pitch_y)).unwrap_or(0);
+        Grid {
+            x0: self.offset_x,
+            y0: self.offset_y,
+            pitch_x: self.pitch_x,
+            pitch_y: self.pitch_y,
+            cols,
+            rows,
+            diameter: self.thread_diameter,
+            missing: Vec::new(),
+            stagger: None,
+        }
+    }
+
+    /// The dowel lattice, when the plate has one.
+    #[must_use]
+    pub fn dowel_grid(&self) -> Option<Grid> {
+        let d = self.dowels.as_ref()?;
+        Some(Grid {
+            x0: d.offset_x,
+            y0: d.offset_y,
+            pitch_x: d.pitch_x,
+            pitch_y: d.pitch_y,
+            cols: u32::try_from(count(self.length, d.offset_x, d.pitch_x)).unwrap_or(0),
+            rows: u32::try_from(count(self.width, d.offset_y, d.pitch_y)).unwrap_or(0),
+            diameter: d.diameter,
+            missing: Vec::new(),
+            stagger: None,
+        })
+    }
+
+    /// The checked plate's grid definition.
+    pub fn def(&self) -> Result<PlateDef, String> {
+        self.check()?;
+        Ok(PlateDef { params: Some(self.clone()), top_z: 0.0, holes: self.grid(), dowels: self.dowel_grid() })
+    }
+
+    /// The checked plate's solid slab: x in [0, length], y in [0, width],
+    /// z in [-thickness, 0]; 12 outward triangles, holes drawn solid.
+    pub fn mesh(&self) -> Result<Vec<Triangle>, String> {
+        self.check()?;
+        Ok(slab(self.length, self.width, self.thickness))
+    }
+
+    /// The model name a fresh plate lands under: "Plate 12 x 12 in".
+    #[must_use]
+    pub fn base_name(&self) -> String {
+        let s = self.size.trim();
+        if s.is_empty() { "Fixture plate".to_owned() } else { format!("Plate {s}") }
+    }
+}
+
+/// A closed box [0, l] x [0, w] x [-t, 0], outward normals.
+#[must_use]
+pub fn slab(l: f64, w: f64, t: f64) -> Vec<Triangle> {
+    let p = |i: usize| {
+        Point3::new(if i & 1 == 0 { 0.0 } else { l }, if i & 2 == 0 { 0.0 } else { w }, if i & 4 == 0 { -t } else { 0.0 })
+    };
+    // Each face as a quad (a, b, c, d) counter-clockwise seen from outside.
+    let quads = [
+        [0, 2, 3, 1], // bottom (-z)
+        [4, 5, 7, 6], // top (+z)
+        [0, 1, 5, 4], // -y
+        [2, 6, 7, 3], // +y
+        [0, 4, 6, 2], // -x
+        [1, 3, 7, 5], // +x
+    ];
+    quads
+        .iter()
+        .flat_map(|q| [Triangle::new(p(q[0]), p(q[1]), p(q[2])), Triangle::new(p(q[0]), p(q[2]), p(q[3]))])
+        .collect()
+}
+
+impl PlateDef {
+    /// The law a loaded or derived plate keeps: its grids are sane, and a
+    /// built-in plate's grids are the ones its parameters make.
+    pub fn check(&self) -> Result<(), String> {
+        if !self.top_z.is_finite() {
+            return Err("plate top must be finite".into());
+        }
+        self.holes.check("plate grid")?;
+        if let Some(d) = &self.dowels {
+            d.check("plate dowel pattern")?;
+        }
+        if let Some(p) = &self.params {
+            p.check()?;
+            if p.grid() != self.holes || p.dowel_grid() != self.dowels {
+                return Err("plate grid does not match its parameters".into());
+            }
+        }
+        Ok(())
+    }
+
+    /// The dowel lattice, or why the plate has none.
+    pub fn dowel_lattice(&self) -> Result<&Grid, String> {
+        self.dowels.as_ref().ok_or_else(|| "it has no dowel pattern".to_owned())
+    }
+}
diff --git a/crates/app/src/plate/detect.rs b/crates/app/src/plate/detect.rs
new file mode 100644
index 00000000..48a8616c
--- /dev/null
+++ b/crates/app/src/plate/detect.rs
@@ -0,0 +1,165 @@
+//! A plate's grid from its own holes (#819): for an imported plate, the
+//! holes found by the same recognition rule the Drill operation's
+//! "Detect holes" (and MCP `detect_holes`) runs - closed, round walls on
+//! the model's Z - are grouped by diameter, and the most numerous group
+//! that forms a regular rectangular lattice becomes the tapped grid;
+//! the next group that forms one becomes the dowel lattice. Nodes of the
+//! lattice without a hole are recorded as gaps (placing there is
+//! refused by name); a group that is not a lattice is refused with why.
+//! A checkerboard lattice (holes on every other place, alternating row
+//! by row - a staggered plate) is read as a staggered grid.
+//!
+//! The lattice is read in the plate's MODEL frame, axis-aligned: rows
+//! along +Y from A, columns along +X from 1 (the `plate` convention),
+//! the top face at the holes' entry. A plate whose holes do not stand on
+//! its model Z, or whose grid is turned in its model frame, is refused.
+//!
+//! Provenance: our own grouping and lattice fit over the repo's hole
+//! recognition (`drilling::recognize`).
+
+use crate::drilling::{self, Hole};
+use crate::geometry::Triangle;
+
+use super::{Grid, MAX_HOLES, PlateDef, location_name};
+
+/// Two hole diameters closer than this are one size (mm).
+const SAME_SIZE: f64 = 0.005;
+/// A hole within this of its lattice node is on it (mm).
+const ON_NODE: f64 = 0.05;
+/// At least this share of a lattice's nodes must hold a hole.
+const MIN_FILL: f64 = 0.5;
+
+/// Distinct values of `v` (sorted), clustered within `ON_NODE`.
+fn levels(mut v: Vec<f64>) -> Vec<f64> {
+    v.sort_by(f64::total_cmp);
+    let mut out: Vec<(f64, usize)> = Vec::new();
+    for x in v {
+        match out.last_mut() {
+            Some((sum, n)) if (x - *sum / *n as f64).abs() <= ON_NODE => {
+                *sum += x;
+                *n += 1;
+            }
+            _ => out.push((x, 1)),
+        }
+    }
+    out.into_iter().map(|(s, n)| s / n as f64).collect()
+}
+
+/// The pitch of sorted levels `l`, checked: every level on it.
+fn pitch(l: &[f64], axis: &str) -> Result<(f64, u32), String> {
+    let (Some(first), Some(last)) = (l.first(), l.last()) else {
+        return Err(format!("no {axis} positions"));
+    };
+    if l.len() < 2 {
+        return Err(format!("they stand in a single {}", if axis == "X" { "column" } else { "row" }));
+    }
+    let gap = l.windows(2).map(|w| w[1] - w[0]).fold(f64::MAX, f64::min);
+    let steps = ((last - first) / gap).round();
+    if !(steps.is_finite() && steps >= 1.0) || steps > MAX_HOLES as f64 {
+        return Err(format!("their {axis} spacing is not regular"));
+    }
+    let p = (last - first) / steps;
+    for x in l {
+        let k = ((x - first) / p).round();
+        if (x - (first + k * p)).abs() > ON_NODE {
+            return Err(format!("a hole at {axis} {x:.3} mm is off the {p:.3} mm pitch"));
+        }
+    }
+    Ok((p, steps as u32 + 1))
+}
+
+/// Fit one same-size group to a lattice.
+fn lattice(group: &[Hole]) -> Result<Grid, String> {
+    let xs = levels(group.iter().map(|h| h.xy.x).collect());
+    let ys = levels(group.iter().map(|h| h.xy.y).collect());
+    let (px, cols) = pitch(&xs, "X")?;
+    let (py, rows) = pitch(&ys, "Y")?;
+    let nodes = u64::from(cols) * u64::from(rows);
+    if nodes > MAX_HOLES {
+        return Err(format!("the lattice would hold {nodes} holes, more than {MAX_HOLES}"));
+    }
+    let (x0, y0) = (xs[0], ys[0]);
+    let mut filled = vec![false; nodes as usize];
+    for h in group {
+        let c = ((h.xy.x - x0) / px).round();
+        let r = ((h.xy.y - y0) / py).round();
+        let k = (r as usize).saturating_mul(cols as usize).saturating_add(c as usize);
+        match filled.get_mut(k) {
+            Some(slot) if !*slot => *slot = true,
+            Some(_) => return Err(format!("two holes stand at {}", location_name(r as u32, c as u32))),
+            None => return Err("a hole falls outside the lattice".into()),
+        }
+    }
+    let have = filled.iter().filter(|f| **f).count();
+    let at = |r: u32, c: u32| filled[(r as usize) * cols as usize + c as usize];
+    let all = || (0..rows).flat_map(move |r| (0..cols).map(move |c| (r, c)));
+    // A checkerboard (staggered) plate: every hole on one row + column
+    // parity, so half the full lattice's places are not places at all.
+    let parity: Vec<u32> = all().filter(|&(r, c)| at(r, c)).map(|(r, c)| (r + c) % 2).collect();
+    let stagger = match parity.first() {
+        Some(&p) if parity.iter().all(|q| *q == p) => Some(p as u8),
+        _ => None,
+    };
+    let places = all().filter(|&(r, c)| stagger.is_none_or(|p| (r + c) % 2 == u32::from(p))).count();
+    if (have as f64) < MIN_FILL * places as f64 {
+        return Err(format!("only {have} of the lattice's {places} places hold a hole"));
+    }
+    let missing = all()
+        .filter(|&(r, c)| stagger.is_none_or(|p| (r + c) % 2 == u32::from(p)) && !at(r, c))
+        .map(|(r, c)| location_name(r, c))
+        .collect();
+    let diameter = 2.0 * group.iter().map(|h| h.radius).sum::<f64>() / group.len() as f64;
+    Ok(Grid { x0, y0, pitch_x: px, pitch_y: py, cols, rows, diameter, missing, stagger })
+}
+
+/// Holes grouped by diameter, the most numerous group first.
+fn by_size(mut holes: Vec<Hole>) -> Vec<Vec<Hole>> {
+    holes.sort_by(|a, b| a.radius.total_cmp(&b.radius));
+    let mut groups: Vec<Vec<Hole>> = Vec::new();
+    for h in holes {
+        match groups.last_mut() {
+            Some(g) if g.last().is_some_and(|l| 2.0 * (h.radius - l.radius) <= SAME_SIZE) => g.push(h),
+            _ => groups.push(vec![h]),
+        }
+    }
+    groups.sort_by_key(|g| std::cmp::Reverse(g.len()));
+    groups
+}
+
+/// The plate grid of mesh `tris` (the plate's own model frame), or why
+/// its holes are not one.
+pub fn grid_from_facets(tris: &[Triangle]) -> Result<PlateDef, String> {
+    let holes: Vec<Hole> = drilling::recognize(tris).into_iter().filter(Hole::is_usable).collect();
+    if holes.is_empty() {
+        return Err("no holes found on its Z axis - is the plate's top face up (+Z) in its model?".into());
+    }
+    let groups = by_size(holes);
+    let mut first_err = None;
+    let mut found: Option<(Grid, f64)> = None;
+    let mut dowels = None;
+    for g in groups.iter().filter(|g| g.len() >= 4) {
+        match lattice(g) {
+            Ok(grid) => {
+                if found.is_none() {
+                    let top = g.iter().map(|h| h.entry_z).fold(f64::MIN, f64::max);
+                    found = Some((grid, top));
+                } else {
+                    dowels = Some(grid);
+                    break;
+                }
+            }
+            Err(e) => {
+                if first_err.is_none() {
+                    let d = 2.0 * g[0].radius;
+                    first_err = Some(format!("its {} holes of {d:.3} mm don't form a regular grid: {e}", g.len()));
+                }
+            }
+        }
+    }
+    let Some((holes, top_z)) = found else {
+        return Err(first_err.unwrap_or_else(|| "its holes don't form a regular grid: fewer than four holes of any one size".into()));
+    };
+    let def = PlateDef { params: None, top_z, holes, dowels };
+    def.check()?;
+    Ok(def)
+}
diff --git a/crates/app/src/plate/grid.rs b/crates/app/src/plate/grid.rs
new file mode 100644
index 00000000..3724359e
--- /dev/null
+++ b/crates/app/src/plate/grid.rs
@@ -0,0 +1,164 @@
+//! A plate's hole lattice and its names (#819): rows lettered along +Y
+//! from A (A..Z, AA, AB, ...), columns numbered along +X from 1; A1 is
+//! the node nearest the frame's origin corner. See `plate` for the frame.
+//!
+//! Provenance: our own naming (spreadsheet-style bijective base 26).
+
+use serde::{Deserialize, Serialize};
+
+use super::MAX_HOLES;
+
+/// A rectangular lattice of holes in a plate's model frame: A1 at
+/// (`x0`, `y0`), columns `pitch_x` apart along +X, rows `pitch_y` apart
+/// along +Y. `missing` names lattice nodes with no hole (an imported
+/// plate's gaps); placing there is refused by name. A STAGGERED grid
+/// (`stagger: Some(p)`, an imported checkerboard plate) has holes only
+/// at the nodes whose row + column parity is `p`; the names stay those
+/// of the full lattice.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Grid {
+    pub x0: f64,
+    pub y0: f64,
+    pub pitch_x: f64,
+    pub pitch_y: f64,
+    pub cols: u32,
+    pub rows: u32,
+    pub diameter: f64,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub missing: Vec<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub stagger: Option<u8>,
+}
+
+/// Row letters for zero-based row `r`: 0 -> A, 25 -> Z, 26 -> AA.
+#[must_use]
+pub fn row_letters(r: u32) -> String {
+    let mut n = u64::from(r) + 1;
+    let mut out = Vec::new();
+    while n > 0 {
+        let k = (n - 1) % 26;
+        out.push(b'A' + k as u8);
+        n = (n - 1) / 26;
+    }
+    out.reverse();
+    String::from_utf8(out).unwrap_or_default()
+}
+
+/// The name of zero-based (`row`, `col`): "B3" is row 1, column 2.
+#[must_use]
+pub fn location_name(row: u32, col: u32) -> String {
+    format!("{}{}", row_letters(row), u64::from(col) + 1)
+}
+
+/// Zero-based (row, col) of a location name (case and spaces ignored);
+/// `None` when it is not letters then a column number from 1.
+#[must_use]
+pub fn parse_location(s: &str) -> Option<(u32, u32)> {
+    let s: String = s.chars().filter(|c| !c.is_whitespace()).collect::<String>().to_ascii_uppercase();
+    let split = s.find(|c: char| c.is_ascii_digit())?;
+    let (letters, digits) = s.split_at(split);
+    if letters.is_empty() || letters.len() > 4 || !letters.bytes().all(|b| b.is_ascii_uppercase()) {
+        return None;
+    }
+    if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    let mut row: u64 = 0;
+    for b in letters.bytes() {
+        row = row * 26 + u64::from(b - b'A') + 1;
+    }
+    let col: u64 = digits.parse().ok()?;
+    if col == 0 {
+        return None;
+    }
+    Some((u32::try_from(row - 1).ok()?, u32::try_from(col - 1).ok()?))
+}
+
+impl Grid {
+    /// The grid's span of names, as refusals say it: "rows A-L, columns 1-12".
+    #[must_use]
+    pub fn extent(&self) -> String {
+        format!(
+            "rows A-{}, columns 1-{}",
+            row_letters(self.rows.saturating_sub(1)),
+            self.cols
+        )
+    }
+
+    /// The (x, y) of a node, unchecked.
+    #[must_use]
+    pub fn node(&self, row: u32, col: u32) -> (f64, f64) {
+        (self.x0 + f64::from(col) * self.pitch_x, self.y0 + f64::from(row) * self.pitch_y)
+    }
+
+    /// The (x, y) of location `name`, or why not (an unknown name, a
+    /// node off the lattice, or a node with no hole).
+    pub fn locate(&self, name: &str) -> Result<(f64, f64), String> {
+        let (row, col) =
+            parse_location(name).ok_or_else(|| format!("'{name}' is not a grid location (letters for the row, then the column number, e.g. B3)"))?;
+        if row >= self.rows || col >= self.cols {
+            return Err(format!("there is no location {} ({})", name.trim(), self.extent()));
+        }
+        let canon = location_name(row, col);
+        if self.off_stagger(row, col) {
+            return Err(format!("location {canon} has no hole (the grid is staggered: every other place along a row)"));
+        }
+        if self.missing.contains(&canon) {
+            return Err(format!("location {canon} has no hole"));
+        }
+        Ok(self.node(row, col))
+    }
+
+    /// Whether node (`row`, `col`) is a gap of a staggered grid.
+    #[must_use]
+    pub fn off_stagger(&self, row: u32, col: u32) -> bool {
+        self.stagger.is_some_and(|p| (u64::from(row) + u64::from(col)) % 2 != u64::from(p))
+    }
+
+    /// Every hole: (name, x, y), row by row from A1. Bounded by
+    /// [`MAX_HOLES`] (a checked grid never reaches it).
+    #[must_use]
+    pub fn holes(&self) -> Vec<(String, f64, f64)> {
+        let mut out = Vec::new();
+        'rows: for r in 0..self.rows {
+            for c in 0..self.cols {
+                if out.len() as u64 >= MAX_HOLES {
+                    break 'rows;
+                }
+                let name = location_name(r, c);
+                if self.off_stagger(r, c) || self.missing.contains(&name) {
+                    continue;
+                }
+                let (x, y) = self.node(r, c);
+                out.push((name, x, y));
+            }
+        }
+        out
+    }
+
+    /// The grid law: finite, positive pitches and diameter, at least one
+    /// node each way, at most [`MAX_HOLES`] nodes.
+    pub fn check(&self, what: &str) -> Result<(), String> {
+        for (k, v) in [("x", self.x0), ("y", self.y0)] {
+            if !v.is_finite() {
+                return Err(format!("{what} first hole {k} must be finite"));
+            }
+        }
+        for (k, v) in [("pitch X", self.pitch_x), ("pitch Y", self.pitch_y), ("hole diameter", self.diameter)] {
+            if !(v.is_finite() && v > 0.0) {
+                return Err(format!("{what} {k} must be a length more than zero (got {v})"));
+            }
+        }
+        if self.stagger.is_some_and(|p| p > 1) {
+            return Err(format!("{what} stagger must be 0 or 1"));
+        }
+        if self.rows == 0 || self.cols == 0 {
+            return Err(format!("{what} has no holes"));
+        }
+        if u64::from(self.rows) * u64::from(self.cols) > MAX_HOLES {
+            return Err(format!("{what} has more than {MAX_HOLES} holes"));
+        }
+        Ok(())
+    }
+}
+
diff --git a/crates/app/src/plate/mount.rs b/crates/app/src/plate/mount.rs
new file mode 100644
index 00000000..6da8550d
--- /dev/null
+++ b/crates/app/src/plate/mount.rs
@@ -0,0 +1,198 @@
+//! Placing a fixture on a plate's grid (#819): the fixture's model frame
+//! goes on a named hole (or on a dowel pair) at the plate's top face,
+//! turned by a yaw about the plate's Z. The location rides the placed
+//! fixture's marker, so moving the plate carries every fixture on it
+//! (transitively: a subplate carries its own riders) in the plate's
+//! one command.
+//!
+//! - **At a hole:** the fixture frame's origin over the hole's centre,
+//!   its axes the plate's turned by `yaw_deg`, and the fixture standing
+//!   on the plate: its lowest point on the top face (a vise's base, an
+//!   imported fixture's underside, whatever its model origin).
+//! - **On a dowel pair:** the origin on the first dowel hole, its +X
+//!   pointing at the second (then turned by `yaw_deg`) - the way a
+//!   two-pin locator sits.
+//! - **On the plate:** the fixture's footprint (its mesh's XY extent,
+//!   placed) must lie within the plate's; one hanging off is refused
+//!   with the side and the amount.
+//!
+//! Provenance: our own placement rules; rigid-frame composition from
+//! published quaternion algebra.
+
+use std::collections::HashSet;
+
+use flecs_ecs::prelude::World;
+use serde::{Deserialize, Serialize};
+
+use crate::fixture;
+use crate::geometry::{IDENTITY_Q, Point3, Triangle, quat_from_euler, transform_point};
+use crate::model;
+use crate::schema::Location;
+use crate::setup_align::{compose, inverse};
+
+use super::PlateDef;
+
+/// Where on a plate a fixture stands.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum MountAt {
+    /// A tapped-grid location ("C3").
+    Hole(String),
+    /// Two dowel-lattice locations: the origin on the first, +X toward
+    /// the second.
+    Dowels([String; 2]),
+}
+
+impl MountAt {
+    /// How the location reads: "C3", or "dowels A1-A3".
+    #[must_use]
+    pub fn label(&self) -> String {
+        match self {
+            MountAt::Hole(h) => h.trim().to_ascii_uppercase(),
+            MountAt::Dowels([a, b]) => format!("dowels {}-{}", a.trim().to_ascii_uppercase(), b.trim().to_ascii_uppercase()),
+        }
+    }
+}
+
+/// A fixture's place on a plate: the plate's model name, the location,
+/// and a turn about the plate's Z (degrees).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct PlateMount {
+    pub plate: String,
+    pub at: MountAt,
+    #[serde(default)]
+    pub yaw_deg: f64,
+}
+
+/// One carried fixture's pose before and after a plate command.
+#[derive(Clone, Debug, PartialEq)]
+pub struct RiderMove {
+    pub name: String,
+    pub before: Location,
+    pub after: Location,
+}
+
+impl PlateDef {
+    /// The fixture frame's pose in the plate's model frame for location
+    /// `at` turned `yaw_deg`, or why not (named).
+    pub fn local_pose(&self, at: &MountAt, yaw_deg: f64) -> Result<Location, String> {
+        if !yaw_deg.is_finite() {
+            return Err(format!("the turn on the plate must be finite (got {yaw_deg})"));
+        }
+        let (x, y, heading) = match at {
+            MountAt::Hole(h) => {
+                let (x, y) = self.holes.locate(h)?;
+                (x, y, 0.0)
+            }
+            MountAt::Dowels([a, b]) => {
+                let g = self.dowel_lattice()?;
+                let (ax, ay) = g.locate(a).map_err(|e| format!("dowel {e}"))?;
+                let (bx, by) = g.locate(b).map_err(|e| format!("dowel {e}"))?;
+                if (bx - ax).hypot(by - ay) < 1e-9 {
+                    return Err(format!("a dowel pair needs two different holes (got {} twice)", a.trim()));
+                }
+                (ax, ay, (by - ay).atan2(bx - ax))
+            }
+        };
+        let rot = quat_from_euler(0.0, 0.0, heading + yaw_deg.to_radians());
+        Ok(Location { pos: Point3::new(x, y, self.top_z), rot })
+    }
+}
+
+/// XY bounds of `pts`.
+fn xy_bounds(pts: impl Iterator<Item = Point3>) -> Option<[f64; 4]> {
+    let mut b = [f64::MAX, f64::MAX, f64::MIN, f64::MIN];
+    let mut any = false;
+    for p in pts {
+        any = true;
+        b[0] = b[0].min(p.x);
+        b[1] = b[1].min(p.y);
+        b[2] = b[2].max(p.x);
+        b[3] = b[3].max(p.y);
+    }
+    (any && b.iter().all(|v| v.is_finite())).then_some(b)
+}
+
+/// How far a footprint may stand past the plate edge (float dust).
+const EDGE_TOL: f64 = 1e-6;
+
+/// The on-the-plate law: `fixture` (its own mesh) placed at `local` in
+/// the plate's frame keeps its XY footprint inside `plate`'s (the
+/// plate's own mesh). Refused with the side and the overhang.
+pub fn on_the_plate(plate: &[Triangle], fixture: &[Triangle], local: Location) -> Result<(), String> {
+    let pb = xy_bounds(plate.iter().flat_map(|t| [t.a, t.b, t.c])).ok_or("the plate has no geometry")?;
+    let fb = xy_bounds(fixture.iter().flat_map(|t| [t.a, t.b, t.c]).map(|p| transform_point(p, local.pos, local.rot)))
+        .ok_or("the fixture has no geometry")?;
+    for (side, over) in [("-X", pb[0] - fb[0]), ("-Y", pb[1] - fb[1]), ("+X", fb[2] - pb[2]), ("+Y", fb[3] - pb[3])] {
+        if over > EDGE_TOL {
+            return Err(format!("it would hang {over:.3} mm off the plate's {side} edge"));
+        }
+    }
+    Ok(())
+}
+
+/// The fixtures placed directly on plate `plate`, by name.
+#[must_use]
+pub fn riders(world: &World, plate: &str) -> Vec<String> {
+    model::named_entities(world)
+        .into_iter()
+        .filter(|(_, e)| fixture::def_of(world, e).and_then(|d| d.plate.mount).is_some_and(|m| m.plate == plate))
+        .map(|(n, _)| n)
+        .collect()
+}
+
+/// The fixtures riding on `plate` - directly or on a subplate of it -
+/// each moved by the rigid `delta` (world frame). `skip` names fixtures
+/// the caller moves itself. Cycles end at the first revisit.
+#[must_use]
+pub fn carry(world: &World, plate: &str, delta: Location, skip: &[&str]) -> Vec<RiderMove> {
+    let mut seen: HashSet<String> = skip.iter().map(|s| (*s).to_owned()).collect();
+    seen.insert(plate.to_owned());
+    let mut out = Vec::new();
+    let mut queue = vec![plate.to_owned()];
+    while let Some(p) = queue.pop() {
+        for name in riders(world, &p) {
+            if !seen.insert(name.clone()) {
+                continue;
+            }
+            let Some(e) = model::find_by_name(world, &name) else { continue };
+            let before = model::transform_of(world, &e).unwrap_or_default();
+            out.push(RiderMove { name: name.clone(), before, after: compose(delta, before) });
+            queue.push(name);
+        }
+    }
+    out
+}
+
+/// The rigid move from pose `prev` to `next`: `next ∘ prev⁻¹`.
+#[must_use]
+pub fn delta(prev: Location, next: Location) -> Location {
+    compose(next, inverse(prev))
+}
+
+/// Write the carried poses: `after` forward, `before` on undo.
+pub fn write(world: &World, moves: &[RiderMove], forward: bool) {
+    for m in moves {
+        if let Some(e) = model::find_by_name(world, &m.name) {
+            model::set_transform(world, &e, if forward { m.after } else { m.before });
+        }
+    }
+}
+
+/// `local` lifted so `fixture` (its own mesh) stands on the plate top:
+/// its lowest point at `local`'s z. A yaw about Z keeps heights, so the
+/// mesh's own lowest z is the one that lands.
+#[must_use]
+pub fn stand(local: Location, fixture: &[Triangle]) -> Location {
+    let low = fixture.iter().flat_map(|t| [t.a.z, t.b.z, t.c.z]).fold(f64::INFINITY, f64::min);
+    if !low.is_finite() {
+        return local;
+    }
+    Location { pos: Point3::new(local.pos.x, local.pos.y, local.pos.z - low), rot: local.rot }
+}
+
+/// No turn.
+#[must_use]
+pub fn identity() -> Location {
+    Location { pos: Point3::ZERO, rot: IDENTITY_Q }
+}
