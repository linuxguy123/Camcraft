diff --git a/crates/ui/src/egui_app/fixture_plate_dialog.rs b/crates/ui/src/egui_app/fixture_plate_dialog.rs
new file mode 100644
index 00000000..75f8fe36
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_plate_dialog.rs
@@ -0,0 +1,132 @@
+//! The "Add fixture plate…" dialog body (#819), drawn inside the fixture
+//! library's modal: pick a preset, edit any figure to match the shop's
+//! plate (size, grid pitch and first-hole offset, thread, an optional
+//! dowel pattern and counterbores), then lay it centred on the machine
+//! table or type where its frame goes. Place queues one undoable
+//! `InsertPlate` through the command queue.
+//! Provenance: our own layout over our own plate commands.
+
+use egui::{RichText, Ui};
+
+use camcraft_app::plate;
+use camcraft_app::units::Unit;
+
+use crate::state::{CommandKind, PlateDraft};
+
+use super::fields::{num, num_plain};
+use super::fixture_vise_dialog::ViseAct;
+
+/// The Place button's command for this draft.
+#[must_use]
+pub(crate) fn place_command(d: &PlateDraft) -> CommandKind {
+    CommandKind::InsertFixturePlate {
+        setup: (!d.setup.is_empty()).then(|| d.setup.clone()),
+        params: d.landed(),
+        on_table: d.on_table,
+        pos: d.pos,
+        yaw_deg: d.yaw_deg,
+    }
+}
+
+fn grid(ui: &mut Ui, id: &str, u: Unit, rows: Vec<(&str, &mut f64)>) {
+    egui::Grid::new(id).num_columns(2).show(ui, |ui| {
+        for (label, v) in rows {
+            ui.label(label);
+            num(ui, u, v);
+            ui.end_row();
+        }
+    });
+}
+
+pub(crate) fn body(ui: &mut Ui, u: Unit, d: &mut PlateDraft) -> Option<ViseAct> {
+    let mut act = None;
+    ui.heading("Add fixture plate");
+    ui.label(
+        RichText::new(
+            "A generic grid plate; edit the figures to match yours. Holes are named by row letter (A, B, ... along +Y) \
+             and column number (1, 2, ... along +X); A1 is nearest the plate's origin corner.",
+        )
+        .small(),
+    );
+    ui.add_space(4.0);
+    ui.label("Preset");
+    let mut picked = None;
+    ui.horizontal_wrapped(|ui| {
+        for (k, row) in plate::PRESETS.iter().enumerate() {
+            if ui.selectable_label(d.preset == k, row.label).clicked() {
+                picked = Some(k);
+            }
+        }
+    });
+    if let Some(k) = picked {
+        d.pick(k);
+    }
+    let p = &mut d.params;
+    grid(
+        ui,
+        "plate-dims",
+        u,
+        vec![
+            ("Length (X)", &mut p.length),
+            ("Width (Y)", &mut p.width),
+            ("Thickness", &mut p.thickness),
+            ("Pitch X", &mut p.pitch_x),
+            ("Pitch Y", &mut p.pitch_y),
+            ("First hole X", &mut p.offset_x),
+            ("First hole Y", &mut p.offset_y),
+            ("Thread diameter", &mut p.thread_diameter),
+        ],
+    );
+    ui.horizontal(|ui| {
+        ui.label("Thread");
+        ui.add(egui::TextEdit::singleline(&mut p.thread).desired_width(80.0));
+    });
+    ui.checkbox(&mut d.dowels_on, "Dowel holes");
+    if d.dowels_on {
+        let w = &mut d.dowels;
+        grid(
+            ui,
+            "plate-dowels",
+            u,
+            vec![
+                ("Dowel pitch X", &mut w.pitch_x),
+                ("Dowel pitch Y", &mut w.pitch_y),
+                ("First dowel X", &mut w.offset_x),
+                ("First dowel Y", &mut w.offset_y),
+                ("Dowel diameter", &mut w.diameter),
+            ],
+        );
+    }
+    ui.checkbox(&mut d.counterbore_on, "Counterbored holes");
+    if d.counterbore_on {
+        let c = &mut d.counterbore;
+        grid(ui, "plate-cbore", u, vec![("Counterbore diameter", &mut c.diameter), ("Counterbore depth", &mut c.depth)]);
+    }
+    ui.checkbox(&mut d.on_table, "Lay it on the machine table (centred)");
+    if !d.on_table {
+        egui::Grid::new("plate-place").num_columns(2).show(ui, |ui| {
+            for (k, axis) in ["Corner X", "Corner Y", "Top Z"].iter().enumerate() {
+                ui.label(*axis);
+                num(ui, u, &mut d.pos[k]);
+                ui.end_row();
+            }
+            ui.label("Turn about Z (yaw)");
+            num_plain(ui, &mut d.yaw_deg);
+            ui.end_row();
+        });
+    }
+    ui.label(RichText::new("The collision check sees the plate as a solid slab (holes drawn solid).").small());
+    if let Some(err) = &d.error {
+        ui.colored_label(ui.visuals().error_fg_color, err);
+    }
+    ui.add_space(8.0);
+    ui.horizontal(|ui| {
+        if ui.button("Place").clicked() {
+            act = Some(ViseAct::Place(Box::new(place_command(d))));
+        }
+        if ui.button("Cancel").clicked() {
+            act = Some(ViseAct::Close);
+        }
+    });
+    act
+}
diff --git a/crates/ui/src/egui_app/fixture_plate_rows.rs b/crates/ui/src/egui_app/fixture_plate_rows.rs
new file mode 100644
index 00000000..4a47c4f1
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_plate_rows.rs
@@ -0,0 +1,130 @@
+//! A fixture row's plate lines (#819): a plate shows its grid and what
+//! stands on it; an imported fixture offers "Detect plate grid"; any
+//! fixture, while a plate exists, gets the grid-location picker - pick
+//! the plate, a row letter and a column number (or a dowel pair) and a
+//! turn, then "Place on grid" queues one `PlaceOnPlate`. A fixture on a
+//! plate says where it stands.
+//! Provenance: our own layout over our own plate commands.
+
+use egui::Ui;
+
+use camcraft_app::plate::{self, mount};
+use camcraft_app::{fixture, model, units};
+
+use crate::state::{CommandKind, State};
+
+use super::fields::num_plain;
+
+/// The plate lines of fixture `name`'s row.
+pub(super) fn plate_rows(ui: &mut Ui, state: &mut State, name: &str) {
+    let Some(def) = model::find_by_name(&state.world, name).and_then(|e| fixture::def_of(&state.world, &e)) else {
+        return;
+    };
+    let u = state.units();
+    if let Some(p) = &def.plate.plate {
+        let g = &p.holes;
+        let mut line = format!(
+            "Fixture plate: {}, pitch {} x {}",
+            g.extent(),
+            units::len(g.pitch_x, u, 3),
+            units::len(g.pitch_y, u, 3)
+        );
+        if g.stagger.is_some() {
+            line.push_str(", staggered");
+        }
+        if !g.missing.is_empty() {
+            line.push_str(&format!(", {} gaps", g.missing.len()));
+        }
+        ui.label(line);
+        if let Some(d) = &p.dowels {
+            ui.label(format!("Dowels: {}, pitch {}", d.extent(), units::len(d.pitch_x, u, 3)));
+        }
+        let on = mount::riders(&state.world, name);
+        if !on.is_empty() {
+            ui.label(format!("Carries: {}", on.join(", ")));
+        }
+        if p.params.is_none() && ui.small_button("Not a plate").on_hover_text("Forget the detected grid").clicked() {
+            state.pending.push_back(CommandKind::DetectPlateGrid { name: name.to_owned(), clear: true });
+        }
+    } else if def.vise.is_none()
+        && ui
+            .small_button("Detect plate grid")
+            .on_hover_text("Use this fixture as a grid plate: its holes (on its own Z) must form a regular grid")
+            .clicked()
+    {
+        state.pending.push_back(CommandKind::DetectPlateGrid { name: name.to_owned(), clear: false });
+    }
+    if let Some(m) = &def.plate.mount {
+        ui.label(format!("On plate {} at {}", m.plate, m.at.label()));
+    }
+    place_picker(ui, state, name);
+}
+
+/// The grid-location picker, when some other fixture is a plate.
+fn place_picker(ui: &mut Ui, state: &mut State, name: &str) {
+    let plates = state.plate_names(name);
+    if plates.is_empty() {
+        return;
+    }
+    let mut draft = state.plate_place_draft(name).clone();
+    if !plates.contains(&draft.plate) {
+        draft.plate = plates[0].clone();
+    }
+    let def = model::find_by_name(&state.world, &draft.plate)
+        .and_then(|e| fixture::def_of(&state.world, &e))
+        .and_then(|d| d.plate.plate);
+    let Some(def) = def else { return };
+    let mut go = false;
+    egui::CollapsingHeader::new("Place on plate…").id_salt(("plate-place", name)).show(ui, |ui| {
+        egui::ComboBox::from_id_salt(("plate-pick", name)).selected_text(draft.plate.clone()).show_ui(ui, |ui| {
+            for p in &plates {
+                ui.selectable_value(&mut draft.plate, p.clone(), p);
+            }
+        });
+        ui.horizontal(|ui| {
+            ui.radio_value(&mut draft.dowels, false, "Hole");
+            if def.dowels.is_some() {
+                ui.radio_value(&mut draft.dowels, true, "Dowel pair");
+            }
+        });
+        if draft.dowels {
+            ui.horizontal(|ui| {
+                ui.label("Dowels");
+                ui.add(egui::TextEdit::singleline(&mut draft.dowel_a).desired_width(40.0));
+                ui.add(egui::TextEdit::singleline(&mut draft.dowel_b).desired_width(40.0));
+            });
+        } else {
+            let g = &def.holes;
+            draft.row = draft.row.min(g.rows.saturating_sub(1));
+            draft.col = draft.col.min(g.cols.saturating_sub(1));
+            ui.horizontal(|ui| {
+                ui.label("Row");
+                egui::ComboBox::from_id_salt(("plate-row", name)).selected_text(plate::row_letters(draft.row)).show_ui(ui, |ui| {
+                    for r in 0..g.rows {
+                        ui.selectable_value(&mut draft.row, r, plate::row_letters(r));
+                    }
+                });
+                ui.label("Column");
+                egui::ComboBox::from_id_salt(("plate-col", name)).selected_text((draft.col + 1).to_string()).show_ui(ui, |ui| {
+                    for c in 0..g.cols {
+                        ui.selectable_value(&mut draft.col, c, (c + 1).to_string());
+                    }
+                });
+            });
+        }
+        ui.horizontal(|ui| {
+            ui.label("Turn (deg)");
+            num_plain(ui, &mut draft.yaw_deg);
+        });
+        go = ui.button("Place on grid").clicked();
+    });
+    if go {
+        state.pending.push_back(CommandKind::PlaceOnPlate {
+            fixture: name.to_owned(),
+            plate: draft.plate.clone(),
+            at: draft.at(),
+            yaw_deg: draft.yaw_deg,
+        });
+    }
+    *state.plate_place_draft(name) = draft;
+}
diff --git a/crates/ui/src/egui_app/fixture_plate_tests.rs b/crates/ui/src/egui_app/fixture_plate_tests.rs
new file mode 100644
index 00000000..375580f3
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_plate_tests.rs
@@ -0,0 +1,155 @@
+//! #819 in the shell, structurally: the Fixtures node's menu and the
+//! Fixtures page offer "Add fixture plate…"; the dialog lists the
+//! presets and its Place queues one `InsertPlate` (undo takes it away);
+//! a refusal is named in the dialog; a fixture row's "Place on plate…"
+//! picker puts a vise on a grid location through `PlaceOnPlate`, and the
+//! plate's row then names its grid and what it carries; an imported
+//! fixture offers "Detect plate grid". Driven through the real dialog and
+//! page code in a kittest harness - no pixels (the snapshot lane is release).
+//! Provenance: our own tests over our own shell.
+
+use egui::Vec2;
+use egui_kittest::Harness;
+use egui_kittest::kittest::Queryable;
+
+use camcraft_app::fixture;
+use camcraft_app::model;
+use camcraft_app::plate::{self, MountAt};
+
+use crate::state::{CommandKind, FixtureLibDialog, State, TreeMenuTarget};
+
+use super::fixture_library_dialog::window;
+use super::fixture_menu::menu_rows;
+
+fn dialog(state: State) -> Harness<'static, State> {
+    Harness::builder().with_size(Vec2::new(900.0, 1100.0)).build_ui_state(
+        |ui, st: &mut State| {
+            st.drain_actions();
+            window(ui.ctx(), st);
+        },
+        state,
+    )
+}
+
+fn page(state: State) -> Harness<'static, State> {
+    Harness::builder().with_size(Vec2::new(700.0, 1100.0)).build_ui_state(
+        |ui, st: &mut State| {
+            st.drain_actions();
+            egui::ScrollArea::vertical().show(ui, |ui| super::pages::fixtures_section(ui, st, None));
+        },
+        state,
+    )
+}
+
+fn mount(state: &State, name: &str) -> Option<plate::PlateMount> {
+    model::find_by_name(&state.world, name).and_then(|e| fixture::def_of(&state.world, &e)).and_then(|d| d.plate.mount)
+}
+
+#[test]
+fn the_menu_and_the_page_offer_add_fixture_plate() {
+    let state = State::new();
+    let rows = menu_rows(&state, &TreeMenuTarget::Fixtures("Setup2".into()));
+    let row = rows.iter().find(|(l, _)| l == "Add fixture plate…").expect("menu row");
+    assert!(matches!(&row.1, Some(CommandKind::FixturePlateDialog(s)) if s == "Setup2"));
+
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(600.0, 400.0))
+        .build_ui_state(|ui, st: &mut State| super::pages::fixtures_section(ui, st, None), State::new());
+    h.run();
+    h.get_by_label("Add fixture plate…").click();
+    h.run();
+    assert!(matches!(h.state().pending.back(), Some(CommandKind::FixturePlateDialog(s)) if s.is_empty()));
+}
+
+#[test]
+fn the_dialog_places_a_plate_in_one_undoable_step() {
+    let mut state = State::new();
+    state.pending.push_back(CommandKind::FixturePlateDialog(String::new()));
+    let mut h = dialog(state);
+    h.run();
+    for label in ["Add fixture plate", "12 x 12 in", "300 x 300 mm", "770MX table 28 x 15 in", "Pitch X", "Thread", "Dowel holes", "Place"] {
+        assert!(h.query_by_label(label).is_some(), "the dialog shows {label}");
+    }
+    let Some(FixtureLibDialog::Plate(d)) = &h.state().fixture_lib else { panic!("plate dialog open") };
+    assert_eq!(d.params.size, "300 x 300 mm", "a mm document starts on 300 mm");
+    assert!(!d.on_table, "no machine, so not on a table");
+    assert!(d.dowels_on, "the 300 mm preset has dowels");
+    h.get_by_label("12 x 12 in").click();
+    h.run();
+    h.get_by_label("Place").click();
+    h.run();
+    h.run();
+    assert!(h.state().fixture_lib.is_none(), "placed and closed: {:?}", h.state().fixture_lib);
+    let name = "Plate 12 x 12 in";
+    let def = model::find_by_name(&h.state().world, name).and_then(|e| fixture::def_of(&h.state().world, &e)).expect("placed");
+    assert_eq!(def.plate.plate.map(|p| (p.holes.rows, p.holes.cols)), Some((12, 12)));
+    let st = h.state_mut();
+    assert!(st.history.undo(&st.world));
+    assert!(model::find_by_name(&st.world, name).is_none(), "one undo takes the plate");
+}
+
+#[test]
+fn a_refused_plate_is_named_in_the_dialog() {
+    let mut state = State::new();
+    state.pending.push_back(CommandKind::FixturePlateDialog(String::new()));
+    state.drain_actions();
+    if let Some(FixtureLibDialog::Plate(d)) = state.fixture_lib.as_mut() {
+        d.on_table = true;
+    }
+    let mut h = dialog(state);
+    h.run();
+    h.get_by_label("Place").click();
+    h.run();
+    h.run();
+    let Some(FixtureLibDialog::Plate(d)) = &h.state().fixture_lib else { panic!("stays open") };
+    assert!(d.error.as_deref().is_some_and(|e| e.contains("no table")), "{:?}", d.error);
+    assert!(h.query_by_label_contains("no table").is_some(), "said in the dialog");
+}
+
+#[test]
+fn a_fixture_row_places_a_vise_on_a_grid_location() {
+    let mut state = State::new();
+    let p = plate::preset("770MX table 28 x 15 in").map(plate::PlatePreset::params).expect("preset");
+    state.pending.push_back(CommandKind::InsertFixturePlate { setup: None, params: p, on_table: false, pos: [0.0; 3], yaw_deg: 0.0 });
+    let six = camcraft_app::vise::size("6 in").map(camcraft_app::vise::ViseSize::half_open).expect("6 in");
+    state.pending.push_back(CommandKind::InsertBuiltinVise { setup: None, params: six, fit_stock: false, pos: [0.0, 0.0, 300.0], yaw_deg: 0.0 });
+    state.drain_actions();
+    let vise = "Vise 6 in";
+    {
+        let d = state.plate_place_draft(vise);
+        d.row = 7; // H
+        d.col = 9; // 10
+        d.yaw_deg = 90.0;
+    }
+    let mut h = page(state);
+    h.run();
+    assert!(h.query_by_label_contains("Fixture plate: rows A-O, columns 1-28").is_some(), "the plate's row names its grid");
+    assert!(h.query_by_label("Detect plate grid").is_none(), "a built-in plate needs no detection, a vise neither");
+    h.get_by_label("Place on plate…").click();
+    h.run();
+    h.get_by_label("Place on grid").click();
+    h.run();
+    h.run();
+    assert_eq!(mount(h.state(), vise).map(|m| m.at), Some(MountAt::Hole("H10".into())), "{}", h.state().status);
+    assert!(h.query_by_label_contains("Carries: Vise 6 in").is_some());
+    assert!(h.query_by_label_contains("On plate Plate 770MX table 28 x 15 in at H10").is_some());
+    let st = h.state_mut();
+    assert!(st.history.undo(&st.world));
+    assert!(mount(st, vise).is_none(), "one undo");
+}
+
+#[test]
+fn an_imported_fixture_offers_detect_plate_grid() {
+    let mut state = State::new();
+    state.history.execute(&state.world, camcraft_app::commands::ImportModel::from_mesh("Block", camcraft_app::geometry::Mesh::from_facets(plate::slab(10.0, 10.0, 10.0))));
+    state.history.execute(&state.world, camcraft_app::commands::TagFixture::new(&state.world, "Block", None).expect("tag"));
+    state.doc_version += 1;
+    let mut h = page(state);
+    h.run();
+    h.get_by_label("Detect plate grid").click();
+    h.run();
+    h.run();
+    assert!(h.state().status.contains("no plate grid") && h.state().status.contains("no holes found"), "{}", h.state().status);
+    let def = model::find_by_name(&h.state().world, "Block").and_then(|e| fixture::def_of(&h.state().world, &e)).expect("fixture");
+    assert!(def.plate.plate.is_none(), "a refused detection changes nothing");
+}
