+#[test]
+fn plates_and_places_survive_a_save_and_unreadable_keys_are_dropped() {
+    let world = new_world();
+    let mut history = History::default();
+    let plate = insert_plate(&world, &mut history, &preset("770MX table 28 x 15 in"), Point3::ZERO);
+    let (vise, _) = six_vise(&world, &mut history);
+    history.execute(&world, PlaceOnPlate::new(&world, &vise, &plate, MountAt::Hole("H10".into()), 90.0).expect("place"));
+    let path = std::env::temp_dir().join(format!("camcraft-plate-{}.camproj", std::process::id()));
+    project::save(&world, &path).expect("save");
+    let text = std::fs::read_to_string(&path).expect("read");
+    let back = new_world();
+    project::load(&back, &path).expect("load");
+    let def = |w: &World, n: &str| model::find_by_name(w, n).and_then(|e| fixture::def_of(w, &e)).expect(n);
+    assert_eq!(def(&back, &plate).plate.plate, def(&world, &plate).plate.plate, "the grid reloads");
+    assert_eq!(mount_of(&back, &vise), mount_of(&world, &vise), "the place reloads");
+    let mv = MoveFixture::new(&back, &plate, Location { pos: Point3::new(5.0, 0.0, 0.0), rot: IDENTITY_Q }).expect("move");
+    assert_eq!(mv.carried().count(), 1, "and the reloaded plate still carries its vise");
+
+    // Keys this build can't read: dropped and logged, the load goes on.
+    let mut j: serde_json::Value = serde_json::from_str(&text).expect("json");
+    assert_eq!(spoil(&mut j, "plate", &serde_json::json!({ "holes": "a future shape" })), 1 + 1, "the plate key, and the place's plate name");
+    assert_eq!(spoil(&mut j, "on_plate", &serde_json::json!({ "plate": "P", "at": { "teleport": "Z9" } })), 1);
+    std::fs::write(&path, j.to_string()).expect("write");
+    let spoiled = new_world();
+    let out = Captured::default();
+    let sub = tracing_subscriber::fmt().with_writer(out.clone()).with_ansi(false).finish();
+    let loaded = tracing::subscriber::with_default(sub, || project::load(&spoiled, &path));
+    let _ = std::fs::remove_file(&path);
+    loaded.expect("the file still loads");
+    let log = out.0.lock().map(|v| String::from_utf8_lossy(&v).into_owned()).unwrap_or_default();
+    assert!(log.contains("fixture plate key not understood") && log.contains("fixture plate location not understood"), "{log}");
+    assert!(def(&spoiled, &plate).plate.plate.is_none() && mount_of(&spoiled, &vise).is_none());
+    assert!(model::find_by_name(&spoiled, &plate).and_then(|e| model::facets_of(&spoiled, &e)).is_some_and(|f| f.len() == 12), "the steel stays");
+}
diff --git a/crates/app/tests/fixture_plate_detect.rs b/crates/app/tests/fixture_plate_detect.rs
new file mode 100644
index 00000000..b6c080fe
--- /dev/null
+++ b/crates/app/tests/fixture_plate_detect.rs
@@ -0,0 +1,138 @@
+//! Fixture plates (#819): an imported plate's grid derived from its own
+//! holes - a regular lattice with a gap and a dowel lattice, a staggered
+//! (checkerboard) lattice, and the refusals for holes off any pitch and
+//! a plate with no holes; fixtures snap to the derived grid.
+//!
+//! Gate map (M4.4): covers app::plate::detect, app::plate::grid,
+//! app::commands::fixture_plate (SetPlateGrid, PlaceOnPlate).
+
+use camcraft_app::commands::{History, ImportModel, PlaceOnPlate, SetPlateGrid, TagFixture};
+use camcraft_app::fixture;
+use camcraft_app::geometry::{Mesh, Point3, Triangle, quat_from_euler};
+use camcraft_app::model;
+use camcraft_app::plate::{self, MountAt};
+use camcraft_app::schema::Location;
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+
+fn close(a: f64, b: f64) -> bool {
+    (a - b).abs() < 1e-6
+}
+
+fn pose(world: &World, name: &str) -> Location {
+    model::find_by_name(world, name).and_then(|e| model::transform_of(world, &e)).expect(name)
+}
+
+fn same_turn(a: Location, rot: [f64; 4]) -> bool {
+    let q = (0..4).map(|k| (a.rot[k] - rot[k]).abs()).sum::<f64>().min((0..4).map(|k| (a.rot[k] + rot[k]).abs()).sum());
+    q < 1e-9
+}
+
+/// An imported plate's walls: a `w` x `h` outline and round holes
+/// (inward walls, 32 sides), z in [-20, 0].
+fn holed_plate(w: f64, h: f64, holes: &[(f64, f64, f64)]) -> Vec<Triangle> {
+    let ring = |poly: &[(f64, f64)]| {
+        let n = poly.len();
+        (0..n).flat_map(move |i| {
+            let ((x0, y0), (x1, y1)) = (poly[i], poly[(i + 1) % n]);
+            let (a, b) = (Point3::new(x0, y0, -20.0), Point3::new(x1, y1, -20.0));
+            let (c, d) = (Point3::new(x1, y1, 0.0), Point3::new(x0, y0, 0.0));
+            [Triangle::new(a, b, c), Triangle::new(a, c, d)]
+        }).collect::<Vec<_>>()
+    };
+    let mut t = ring(&[(0.0, 0.0), (w, 0.0), (w, h), (0.0, h)]);
+    for &(x, y, r) in holes {
+        let mut c: Vec<(f64, f64)> = (0..32).map(|i| {
+            let a = std::f64::consts::TAU * f64::from(i) / 32.0;
+            (x + r * a.cos(), y + r * a.sin())
+        }).collect();
+        c.reverse();
+        t.extend(ring(&c));
+    }
+    t
+}
+
+#[test]
+fn an_imported_plates_grid_comes_from_its_holes() {
+    let mut holes = Vec::new();
+    for r in 0..5 {
+        for c in 0..7 {
+            if (r, c) != (2, 3) {
+                holes.push((20.0 + 25.0 * f64::from(c), 20.0 + 25.0 * f64::from(r), 4.0));
+            }
+        }
+    }
+    for r in 0..2 {
+        for c in 0..3 {
+            holes.push((32.5 + 50.0 * f64::from(c), 32.5 + 50.0 * f64::from(r), 5.0));
+        }
+    }
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, ImportModel::from_mesh("Shop plate", Mesh::from_facets(holed_plate(200.0, 150.0, &holes))));
+    history.execute(&world, TagFixture::new(&world, "Shop plate", None).expect("tag"));
+    history.execute(&world, SetPlateGrid::detect(&world, "Shop plate").expect("a regular grid"));
+    let def = model::find_by_name(&world, "Shop plate").and_then(|e| fixture::def_of(&world, &e)).and_then(|d| d.plate.plate).expect("a plate");
+    let g = &def.holes;
+    assert_eq!((g.rows, g.cols), (5, 7));
+    assert!(close(g.x0, 20.0) && close(g.y0, 20.0) && close(g.pitch_x, 25.0) && close(g.pitch_y, 25.0), "{g:?}");
+    assert!((g.diameter - 8.0).abs() < 0.05, "{g:?}");
+    assert_eq!(g.missing, ["C4"], "the gap is named");
+    assert!(close(def.top_z, 0.0));
+    let d = def.dowels.as_ref().expect("the dowel lattice");
+    assert_eq!((d.rows, d.cols), (2, 3));
+    assert!(close(d.pitch_x, 50.0) && close(d.x0, 32.5));
+
+    // Fixtures snap to it.
+    let cube = plate::slab(10.0, 10.0, 10.0);
+    history.execute(&world, ImportModel::from_mesh("Block", Mesh::from_facets(cube)));
+    history.execute(&world, TagFixture::new(&world, "Block", None).expect("tag"));
+    history.execute(&world, PlaceOnPlate::new(&world, "Block", "Shop plate", MountAt::Hole("B2".into()), 0.0).expect("B2"));
+    let at = pose(&world, "Block");
+    assert!(close(at.pos.x, 45.0) && close(at.pos.y, 45.0) && close(at.pos.z, 10.0), "{at:?}");
+    let e = PlaceOnPlate::new(&world, "Block", "Shop plate", MountAt::Hole("C4".into()), 0.0).err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("C4 has no hole"), "{e}");
+    history.execute(&world, PlaceOnPlate::new(&world, "Block", "Shop plate", MountAt::Dowels(["A1".into(), "B1".into()]), 0.0).expect("dowels"));
+    let at = pose(&world, "Block");
+    assert!(close(at.pos.x, 32.5) && close(at.pos.y, 32.5), "{at:?}");
+    assert!(same_turn(at, quat_from_euler(0.0, 0.0, 90f64.to_radians())), "+X toward B1");
+    let e = SetPlateGrid::clear(&world, "Shop plate").err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("still carries Block"), "{e}");
+
+    // Holes off any regular pitch are refused by name.
+    let off: Vec<_> = [(20.0, 20.0), (45.0, 20.0), (80.0, 20.0), (20.0, 45.0), (45.0, 45.0), (80.0, 45.0)].iter().map(|&(x, y)| (x, y, 4.0)).collect();
+    history.execute(&world, ImportModel::from_mesh("Odd", Mesh::from_facets(holed_plate(120.0, 80.0, &off))));
+    history.execute(&world, TagFixture::new(&world, "Odd", None).expect("tag"));
+    let e = SetPlateGrid::detect(&world, "Odd").err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("don't form a regular grid") && e.contains("off the"), "{e}");
+    history.execute(&world, ImportModel::from_mesh("Blank", Mesh::from_facets(plate::slab(50.0, 50.0, 5.0))));
+    history.execute(&world, TagFixture::new(&world, "Blank", None).expect("tag"));
+    let e = SetPlateGrid::detect(&world, "Blank").err().map(|e| e.to_string()).unwrap_or_default();
+    assert!(e.contains("no holes found"), "{e}");
+}
+
+/// A checkerboard plate (every other place, alternating by row - a
+/// staggered grid) reads as a staggered grid: names from the full
+/// lattice, the off places refused by name.
+#[test]
+fn a_staggered_plates_grid_is_read_as_staggered() {
+    let mut holes = Vec::new();
+    for r in 0..6u32 {
+        for c in 0..8u32 {
+            if (r + c) % 2 == 0 {
+                holes.push((10.0 + 15.0 * f64::from(c), 10.0 + 15.0 * f64::from(r), 3.0));
+            }
+        }
+    }
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, ImportModel::from_mesh("Stagger", Mesh::from_facets(holed_plate(125.0, 95.0, &holes))));
+    history.execute(&world, TagFixture::new(&world, "Stagger", None).expect("tag"));
+    let cmd = SetPlateGrid::detect(&world, "Stagger").expect("a staggered grid");
+    let g = cmd.plate().map(|d| d.holes.clone()).expect("grid");
+    assert_eq!((g.rows, g.cols, g.stagger), (6, 8, Some(0)));
+    assert!(g.missing.is_empty(), "{g:?}");
+    assert_eq!(g.holes().len(), 24);
+    assert!(g.locate("A1").is_ok() && g.locate("B2").is_ok());
+    assert!(g.locate("A2").err().is_some_and(|e| e.contains("staggered")));
+}
diff --git a/crates/app/tests/mcp_plate.rs b/crates/app/tests/mcp_plate.rs
new file mode 100644
index 00000000..9d0b431a
--- /dev/null
+++ b/crates/app/tests/mcp_plate.rs
@@ -0,0 +1,96 @@
+//! The MCP fixture plate tools (#819), driven in-process over the
+//! server's JSON-RPC handler: a plate added, a vise placed at a grid
+//! location and carried by a plate edit, every step one undo, every bad input a named
+//! tool error.
+//!
+//! Gate map (M4.4): covers app::mcp::plate_tools.
+
+use camcraft_app::mcp::Server;
+
+use serde_json::{Value, json};
+
+struct Client {
+    server: Server,
+    next: i64,
+}
+
+impl Client {
+    fn new() -> Self {
+        let mut c = Self { server: Server::new(), next: 1 };
+        c.request("initialize", json!({ "protocolVersion": "2025-06-18" }));
+        c
+    }
+
+    fn request(&mut self, method: &str, params: Value) -> Value {
+        let id = self.next;
+        self.next += 1;
+        let msg = json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params });
+        self.server.handle(&msg).expect("a request gets a response")
+    }
+
+    fn call(&mut self, name: &str, args: Value) -> (bool, Value) {
+        let reply = self.request("tools/call", json!({ "name": name, "arguments": args }));
+        let result = &reply["result"];
+        assert!(result.is_object(), "tools/call answers with a result: {reply}");
+        let is_err = result["isError"] == json!(true);
+        let body = if is_err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() };
+        (is_err, body)
+    }
+
+    fn ok(&mut self, name: &str, args: Value) -> Value {
+        let (err, body) = self.call(name, args);
+        assert!(!err, "{name} refused: {body}");
+        body
+    }
+
+    fn refused(&mut self, name: &str, args: Value) -> String {
+        let (err, body) = self.call(name, args);
+        assert!(err, "{name} should have refused, got {body}");
+        body.as_str().unwrap_or_default().to_owned()
+    }
+}
+
+#[test]
+fn a_plate_is_added_a_vise_placed_on_its_grid_and_undone_over_mcp() {
+    let mut c = Client::new();
+    let names: Vec<String> = c.request("tools/list", json!({}))["result"]["tools"]
+        .as_array()
+        .map(|t| t.iter().filter_map(|t| t["name"].as_str().map(str::to_owned)).collect())
+        .unwrap_or_default();
+    for want in ["add_fixture_plate", "set_fixture_plate", "place_on_plate", "detect_plate_grid", "get_plate_grid"] {
+        assert!(names.iter().any(|n| n == want), "missing tool {want}");
+    }
+    let why = c.refused("add_fixture_plate", json!({ "preset": "9 x 9 in" }));
+    assert!(why.contains("no built-in plate") && why.contains("12 x 12 in"), "{why}");
+    let why = c.refused("add_fixture_plate", json!({ "preset": "12 x 12 in", "dimensions": { "thickness": 0.0 } }));
+    assert!(why.contains("thickness"), "{why}");
+    let why = c.refused("add_fixture_plate", json!({ "preset": "12 x 12 in", "on_table": true }));
+    assert!(why.contains("no table"), "{why}");
+
+    let added = c.ok("add_fixture_plate", json!({ "preset": "770MX table 28 x 15 in" }));
+    let plate = added["fixture"].as_str().expect("name").to_owned();
+    assert_eq!(added["plate"]["grid"]["extent"], json!("rows A-O, columns 1-28"), "{added}");
+    c.ok("add_builtin_vise", json!({ "size": "6 in", "position": [0.0, 0.0, 300.0] }));
+    let why = c.refused("place_on_plate", json!({ "fixture": "Vise 6 in", "plate": plate, "hole": "P1" }));
+    assert!(why.contains("no location P1"), "{why}");
+    let why = c.refused("place_on_plate", json!({ "fixture": "Vise 6 in", "plate": plate, "hole": "A1" }));
+    assert!(why.contains("off the plate"), "{why}");
+    let placed = c.ok("place_on_plate", json!({ "fixture": "Vise 6 in", "plate": plate, "hole": "H10", "yaw": 90.0 }));
+    assert_eq!(placed["at"], json!("H10"), "{placed}");
+    let x = placed["origin"][0].as_f64().unwrap_or_default();
+    assert!((x - 9.5 * 25.4).abs() < 1e-6, "{placed}");
+    let grid = c.ok("get_plate_grid", json!({ "name": plate }));
+    assert_eq!(grid["carries"], json!(["Vise 6 in"]), "{grid}");
+    assert_eq!(grid["locations"][0], json!("A1"));
+
+    let set = c.ok("set_fixture_plate", json!({ "name": plate, "dimensions": { "offset_x": 25.4 } }));
+    assert_eq!(set["moved"], json!(["Vise 6 in"]), "{set}");
+    let why = c.refused("detect_plate_grid", json!({ "name": "Vise 6 in" }));
+    assert!(why.contains("no holes found"), "{why}");
+
+    for _ in 0..4 {
+        c.ok("undo", json!({}));
+    }
+    let why = c.refused("get_plate_grid", json!({ "name": plate }));
+    assert!(why.contains(&plate), "four undos: the edit, the place, the vise, the plate: {why}");
+}
