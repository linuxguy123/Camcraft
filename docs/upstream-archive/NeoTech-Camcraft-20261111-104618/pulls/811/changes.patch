+    let rect = pane(&h);
+    for label in ["Vise 6 in", "Built-in vise 6 in", "Jaw opening", "Set opening", "Open to stock"] {
+        assert_inside(&h, rect, label);
+    }
+    assert!(h.state().state.pending.is_empty(), "{:?}", h.state().state.pending);
+}
