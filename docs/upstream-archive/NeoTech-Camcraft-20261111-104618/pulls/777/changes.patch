+++ b/site/templates/section.html
@@ -0,0 +1,15 @@
+{#- A docs section (#688): its intro and its pages in order. Provenance: our own template. -#}
+{% extends "base.html" %}
+{% block title %}{{ section.title }} - {{ config.title }}{% endblock title %}
+{% block description %}{{ section.description | default(value=config.description) }}{% endblock description %}
+{% block content %}
+<article class="doc">
+  <h1>{{ section.title }}</h1>
+  {{ section.content | safe }}
+  <ol class="toc">
+    {% for p in section.pages %}
+    <li><a href="{{ p.permalink }}">{{ p.title }}</a>{% if p.description %} - {{ p.description }}{% endif %}</li>
+    {% endfor %}
+  </ol>
+</article>
+{% endblock content %}

