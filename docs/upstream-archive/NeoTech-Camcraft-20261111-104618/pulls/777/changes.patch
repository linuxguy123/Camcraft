@@ -0,0 +1,30 @@
+{#- Front page (#688): the version the site was built from, and the browser-build note. -#}
+{% extends "base.html" %}
+{% block content %}
+<section class="hero">
+  <h1>CamCraft</h1>
+  <p class="lead">{{ config.description }}</p>
+  {% if version %}
+  <p class="version">This site documents <strong>CamCraft {{ version }}</strong>.
+    <a href="{{ config.extra.repo }}/releases/tag/v{{ version }}">Download {{ version }}</a></p>
+  {% else %}
+  <p class="version">This is a local preview of the site, not built from a release tag.
+    <a href="{{ config.extra.repo }}/releases/latest">Download the latest release</a></p>
+  {% endif %}
+</section>
+{{ section.content | safe }}
+<div class="cards">
+  {% set guide = get_section(path="guide/_index.md") %}
+  <div class="card">
+    <h2><a href="{{ guide.permalink }}">{{ guide.title }}</a></h2>
+    <p>{{ guide.description }}</p>
+    <ul>{% for p in guide.pages %}<li><a href="{{ p.permalink }}">{{ p.title }}</a></li>{% endfor %}</ul>
+  </div>
+  {% set dev = get_section(path="developers/_index.md") %}
+  <div class="card">
+    <h2><a href="{{ dev.permalink }}">{{ dev.title }}</a></h2>
+    <p>{{ dev.description }}</p>
+    <ul>{% for p in dev.pages %}<li><a href="{{ p.permalink }}">{{ p.title }}</a></li>{% endfor %}</ul>
+  </div>
+</div>
+{% endblock content %}
diff --git a/site/templates/page.html b/site/templates/page.html
new file mode 100644
index 00000000..ef43e125
--- /dev/null
+++ b/site/templates/page.html
@@ -0,0 +1,21 @@
+{#- One docs page (#688): its table of contents, body and previous/next links. Provenance: our own template. -#}
+{% extends "base.html" %}
+{% block title %}{{ page.title }} - {{ config.title }}{% endblock title %}
+{% block description %}{{ page.description | default(value=config.description) }}{% endblock description %}
+{% block content %}
+{% set parent = get_section(path=page.ancestors | last) %}
+<p class="crumbs"><a href="{{ parent.permalink }}">{{ parent.title }}</a></p>
+<article class="doc">
+  <h1>{{ page.title }}</h1>
+  {% if page.toc | length > 1 %}
+  <nav class="pagetoc"><strong>On this page</strong>
+    <ul>{% for h in page.toc %}<li><a href="#{{ h.id }}">{{ h.title }}</a></li>{% endfor %}</ul>
+  </nav>
+  {% endif %}
+  {{ page.content | safe }}
+</article>
+<nav class="pager">
+  {% if page.lower %}<a href="{{ page.lower.permalink }}">&larr; {{ page.lower.title }}</a>{% else %}<span></span>{% endif %}
+  {% if page.higher %}<a href="{{ page.higher.permalink }}">{{ page.higher.title }} &rarr;</a>{% endif %}
+</nav>
+{% endblock content %}
diff --git a/site/templates/section.html b/site/templates/section.html
