 name: Release
 on:
   push:
@@ -433,3 +437,66 @@ jobs:
           # A failed platform leaves its globs empty; the step above already
           # refused a release with no asset at all.
           fail_on_unmatched_files: false
+
+  site:
+    # #688: the documentation site, built with Zola from this run's tree
+    # (the tagged tree on a tag run). Read-only; a workflow_dispatch run
+    # builds it as a check and deploys nothing.
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install pinned Zola
+        run: |
+          curl -LfsS -o /tmp/zola.tar.gz https://github.com/getzola/zola/releases/download/v0.23.6/zola-v0.23.6-x86_64-unknown-linux-musl.tar.gz
+          echo '7d77a4220a4f699cba2fc0e0c7859f780e887e269159ad4fab90e11ea16c906f  /tmp/zola.tar.gz' | sha256sum -c -
+          tar -xzf /tmp/zola.tar.gz -C /tmp zola
+          /tmp/zola --version
+      - name: Version the site is built from
+        # The workspace version is the release's version (the publish job
+        # checks the tag names it too); the site's templates read it from
+        # site/version.toml, which only this step writes (gitignored).
+        shell: bash
+        run: |
+          ver=$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\(.*\)"$/\1/p' Cargo.toml)
+          if [ -z "$ver" ]; then echo "::error::no [workspace.package] version in Cargo.toml"; exit 1; fi
+          if [ "$GITHUB_REF_TYPE" = tag ] && [ "$GITHUB_REF_NAME" != "v$ver" ]; then
+            echo "::error::tag $GITHUB_REF_NAME does not name version v$ver"; exit 1
+          fi
+          printf 'version = "%s"\n' "$ver" > site/version.toml
+          cat site/version.toml
+      - name: Build the site
+        # The project Pages URL of whichever repo runs this (a fork's own
+        # Pages included), so every link resolves where it is deployed.
+        shell: bash
+        run: |
+          owner="${GITHUB_REPOSITORY_OWNER,,}"
+          repo="${GITHUB_REPOSITORY#*/}"
+          cd site
+          /tmp/zola build --base-url "https://${owner}.github.io/${repo}"
+          test -s public/index.html
+      - uses: actions/upload-pages-artifact@v5
+        with:
+          path: site/public
+
+  pages:
+    # #688: deploy the built site to GitHub Pages (repo setting: Pages
+    # source "GitHub Actions"). Only on a tag, only when the site built and
+    # the release page was published. The Pages write and OIDC token are
+    # scoped to this job alone.
+    needs: [site, publish]
+    if: ${{ !cancelled() && startsWith(github.ref, 'refs/tags/') && needs.site.result == 'success' && needs.publish.result == 'success' }}
+    runs-on: ubuntu-latest
