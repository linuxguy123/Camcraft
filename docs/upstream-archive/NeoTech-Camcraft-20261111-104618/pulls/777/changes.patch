+        <a href="{{ get_url(path='@/developers/_index.md') }}">Developers</a>
+        <a href="{{ config.extra.repo }}/releases">Downloads</a>
+        <a href="{{ config.extra.repo }}">Source</a>
+      </nav>
+    </div>
+  </header>
+  <main class="wrap">
+    {% block content %}{% endblock content %}
+  </main>
+  <footer class="wrap foot">
+    <p>
+      {% if version %}Built from CamCraft {{ version }}.{% else %}Development build of the site (not from a release tag).{% endif %}
+      CamCraft is open source under the Apache License 2.0.
+      Report problems on the <a href="{{ config.extra.repo }}/issues">issue tracker</a>.
+    </p>
+    <p class="small">
+      CamCraft is a clean-room implementation of HSMWorks' user-visible behaviour.
+      "HSMWorks" is a trademark of Autodesk; this project is independent and unaffiliated.
+    </p>
+  </footer>
+</body>
+</html>
