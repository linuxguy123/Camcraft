+/* CamCraft docs site stylesheet (#688). Provenance: our own CSS, no framework. */
+:root {
+  --bg: #ffffff; --fg: #1d232b; --muted: #5a6572; --line: #dde2e8;
+  --accent: #1f6feb; --code-bg: #f3f5f8; --card: #f8fafc;
+  color-scheme: light dark;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #14181d; --fg: #e3e8ee; --muted: #9aa5b1; --line: #2c333c;
+    --accent: #6ea8ff; --code-bg: #1e242b; --card: #1a1f25;
+  }
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0; background: var(--bg); color: var(--fg);
+  font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+}
+.wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
+a { color: var(--accent); }
+.top { border-bottom: 1px solid var(--line); }
+.top .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; padding-top: 12px; padding-bottom: 12px; }
+.brand { font-weight: 700; font-size: 1.15rem; color: var(--fg); text-decoration: none; }
+.top nav { display: flex; flex-wrap: wrap; gap: 4px 18px; }
+.top nav a { text-decoration: none; }
+main { padding-top: 24px; padding-bottom: 32px; }
+h1, h2, h3 { line-height: 1.25; }
+h2 { margin-top: 2em; padding-bottom: 4px; border-bottom: 1px solid var(--line); }
+code { background: var(--code-bg); padding: 1px 4px; border-radius: 4px; font-size: 0.92em; }
+pre { background: var(--code-bg); padding: 12px; border-radius: 6px; overflow-x: auto; }
+pre code { background: none; padding: 0; }
+table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
+th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; vertical-align: top; }
+blockquote { margin: 1em 0; padding: 8px 16px; border-left: 4px solid var(--accent); background: var(--card); }
+.hero h1 { font-size: 2.2rem; margin-bottom: 0.2em; }
+.lead { font-size: 1.15rem; color: var(--muted); }
+.version { padding: 10px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 6px; }
+.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 24px; }
+.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 4px 18px 12px; }
+.card h2 { border: 0; margin-top: 0.8em; }
+.crumbs { margin: 0; font-size: 0.9rem; }
+.pagetoc { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 8px 16px; margin-bottom: 1.5em; }
+.pagetoc ul { margin: 4px 0; }
+.toc li { margin: 4px 0; }
+.pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 32px; padding-top: 12px; border-top: 1px solid var(--line); }
+.foot { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; padding-top: 12px; padding-bottom: 24px; }
+.small { font-size: 0.82rem; }
