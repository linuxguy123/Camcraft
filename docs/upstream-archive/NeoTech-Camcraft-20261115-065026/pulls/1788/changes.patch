+//! Wall and corner clean-up peels for `adaptive_troch` (#1587): expands
+//! the already-cleared safe-air region outward in engagement-bounded steps
+//! inside the cutter-centre area and cuts only the exposed uncut arcs.
+//! Clean-room concentric boundary peeling from offset fronts (Held 1991).
+
+use crate::cl::{MoveKind, PathBuilder, lattice};
+use crate::geo2d::{Loop, Point2, Region};
+use crate::geometry::Point3;
+use crate::load::load_step;
+
+use super::adaptive::corner_radius;
+use super::face::GenError;
+use super::pocket::PocketParams;
+
+const MIN_REMOVED_AREA: f64 = 0.02;
+const UNCUT_SKIN_ERODE: f64 = 0.025;
+const MAX_PEEL_STEPS: usize = 64;
+
+/// One clean-up chain at a level: plunge into cut air at `pts[0]` and feed along `pts`.
+pub(super) struct CleanChain {
+    pub(super) pts: Vec<Point2>,
+}
+
+/// Peel outward from `cleared.offset(-(r + 0.02))` inside `center` up to `step <= 0.6*r`
+/// per ring, keeping only chains that remove real uncut stock inside `reach`.
+pub(super) fn plan_cleanup(
+    center: &Region,
+    reach: &Region,
+    used_center: &Region,
+    cleared: &Region,
+    d: f64,
+    optimal_load: f64,
+    climb: bool,
+) -> Result<(Vec<CleanChain>, Region), GenError> {
+    let r = 0.5 * d;
+    let raw_center = center.offset(-0.5e-3)?;
+    if raw_center.is_empty() {
+        return Ok((Vec::new(), cleared.clone()));
+    }
+    let mut cur_cleared = cleared.clone();
+    let mut cur_used = used_center.clone();
+    let mut uncut = reach.difference(&cur_cleared)?;
+    if uncut.offset(-UNCUT_SKIN_ERODE)?.is_empty() {
+        return Ok((Vec::new(), cur_cleared));
+    }
+    let air0 = cur_cleared.offset(-(r + 0.02))?.intersect(&raw_center)?;
+    let air0 = if air0.is_empty() { cur_used.intersect(&raw_center)? } else { air0 };
+    if air0.is_empty() {
+        return Ok((Vec::new(), cur_cleared));
+    }
+    // Round acute (< ~81 deg) convex corners by corner_radius and 90-deg corners lightly (0.15*r)
+    // so sharp corner cusps stay under 90 deg while narrow bridges stay open and rest matches HSM.
+    let rho_acute = corner_radius(center, r);
+    let safe_center = round_acute_corners(&raw_center, rho_acute, 0.20 * r)?
+        .union(&air0)?
+        .intersect(&raw_center)?;
+    let mut prev_safe = air0.clone();
+    // 0.18*r peel steps with 0.20*r 90-deg rounding hold <= 90 deg even into tight neck corners.
+    let step = load_step(d, optimal_load).min(0.18 * r).max(0.08 * r);
+    let mut chains = Vec::new();
+
+    for k in 1..=MAX_PEEL_STEPS {
+        if uncut.offset(-UNCUT_SKIN_ERODE)?.is_empty() || safe_center.difference(&prev_safe)?.area() < 0.02 {
+            break;
+        }
+        let a_k = air0.offset(k as f64 * step)?.intersect(&safe_center)?;
+        if a_k.is_empty() {
+            break;
+        }
+        let mask = prev_safe.offset(0.05)?.union(&cur_used.offset(0.03)?)?;
+        let mut step_used = Vec::new();
+
+        for lp in a_k.loops() {
+            let mut ring = lp.points().to_vec();
+            if ring.len() < 3 {
+                continue;
+            }
+            if climb {
+                ring.reverse();
+            }
+            let sampled = densify_ring(&ring, 1.2);
+            for pts in extract_open_chains(&sampled, &mask) {
+                if chain_len(&pts) < 0.05 {
+                    continue;
+                }
+                let sweep = Region::sweep(std::slice::from_ref(&pts), r)?;
+                if sweep.intersect(&uncut)?.area() < MIN_REMOVED_AREA {
+                    continue;
+                }
+                step_used.push(pts.clone());
+                chains.push(CleanChain { pts });
+            }
+        }
+        if !step_used.is_empty() {
+            cur_cleared = cur_cleared.union(&Region::sweep(&step_used, r)?)?;
+            cur_used = cur_used.union(&Region::sweep(&step_used, 0.02)?)?;
+            uncut = reach.difference(&cur_cleared)?;
+        }
+        prev_safe = a_k;
+    }
+    Ok((chains, cur_cleared))
+}
+
+/// Emit `chains` at level `z`: rapid over cut stock (`near >= above`) to `pts[0]`,
+/// plunge vertically to `z` outside prior cutter-centre sweeps, feed along `pts`, and retract.
+pub(super) fn emit_cleanup(bld: &mut PathBuilder, chains: &[CleanChain], p: &PocketParams, z: f64, above: f64, hop: f64) {
+    let p3 = |q: Point2, zz: f64| Point3::new(lattice(q.x), lattice(q.y), lattice(zz));
+    let near = (above + crate::approach::DEFAULT_PLUNGE_HEIGHT).min(hop).max(above);
+    for ch in chains {
+        let cur = bld.at();
+        if (cur.z - hop).abs() > 1e-6 {
+            bld.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, hop), None);
+        }
+        bld.push(MoveKind::Rapid, p3(ch.pts[0], hop), None);
+        bld.push(MoveKind::Rapid, p3(ch.pts[0], near), None);
+        bld.push(MoveKind::Feed, p3(ch.pts[0], z), Some(p.plunge_feed));
+        for &pt in ch.pts.iter().skip(1) {
+            bld.push(MoveKind::Feed, p3(pt, z), Some(p.feed));
+        }
+        let end = bld.at();
+        bld.push(MoveKind::Rapid, Point3::new(end.x, end.y, hop), None);
+    }
+}
+
+fn densify_ring(pts: &[Point2], max_seg: f64) -> Vec<Point2> {
+    let n = pts.len();
+    let mut out = Vec::with_capacity(n * 2);
+    for i in 0..n {
+        let (a, b) = (pts[i], pts[(i + 1) % n]);
+        let l = (b.x - a.x).hypot(b.y - a.y);
+        if l < 1e-6 {
+            continue;
+        }
+        let k = (l / max_seg).ceil() as usize;
+        for j in 0..k {
+            let t = j as f64 / k as f64;
+            out.push(Point2::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t));
+        }
+    }
+    out
+}
+
+fn extract_open_chains(ring: &[Point2], mask: &Region) -> Vec<Vec<Point2>> {
+    let n = ring.len();
+    if n < 3 {
+        return Vec::new();
+    }
+    let out: Vec<bool> = ring.iter().map(|&q| !mask.contains(q)).collect();
+    if out.iter().all(|&o| !o) {
+        return Vec::new();
+    }
+    if out.iter().all(|&o| o) {
+        let mut closed = ring.to_vec();
+        closed.push(ring[0]);
+        return vec![closed];
+    }
+    let Some(start_edge) = (0..n).find(|&i| !out[i] && out[(i + 1) % n]) else {
+        return Vec::new();
+    };
+    let mut chains = Vec::new();
+    let mut cur: Vec<Point2> = Vec::new();
+    for step in 1..=n {
+        let idx = (start_edge + step) % n;
+        let prev = (idx + n - 1) % n;
+        if out[idx] {
+            if cur.is_empty() {
+                cur.push(bisect_outside(ring[prev], ring[idx], mask));
+            }
+            push_distinct(&mut cur, ring[idx]);
+        } else if !cur.is_empty() {
+            let exit = bisect_outside(ring[idx], ring[prev], mask);
+            push_distinct(&mut cur, exit);
+            if cur.len() >= 2 {
+                chains.push(std::mem::take(&mut cur));
+            } else {
+                cur.clear();
+            }
+        }
+    }
+    if cur.len() >= 2 {
+        chains.push(cur);
+    }
+    chains
+}
+
+fn bisect_outside(inside: Point2, outside: Point2, mask: &Region) -> Point2 {
+    let (mut a, mut b) = (inside, outside);
+    for _ in 0..10 {
+        let mid = Point2::new(0.5 * (a.x + b.x), 0.5 * (a.y + b.y));
+        if mask.contains(mid) { a = mid } else { b = mid }
+    }
+    b
+}
+
+fn push_distinct(pts: &mut Vec<Point2>, q: Point2) {
+    if pts.last().is_none_or(|p| (p.x - q.x).hypot(p.y - q.y) > 1e-4) {
+        pts.push(q);
+    }
+}
+
+fn chain_len(pts: &[Point2]) -> f64 {
+    pts.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum()
+}
+
+fn round_acute_corners(reg: &Region, rho_acute: f64, rho_right: f64) -> Result<Region, GenError> {
+    if rho_acute <= 0.0 && rho_right <= 0.0 {
+        return Ok(reg.clone());
+    }
+    let mut loops = Vec::with_capacity(reg.loops().len());
+    for lp in reg.loops() {
+        let pts = lp.points();
+        let n = pts.len();
+        if n < 3 {
+            continue;
+        }
+        let mut ring = Vec::with_capacity(n * 2);
+        for i in 0..n {
+            let (p, v, q) = (pts[(i + n - 1) % n], pts[i], pts[(i + 1) % n]);
+            let d1 = (v.x - p.x).hypot(v.y - p.y);
+            let d2 = (q.x - v.x).hypot(q.y - v.y);
+            if d1 < 1e-6 || d2 < 1e-6 {
+                continue;
+            }
+            let (ux, uy) = ((v.x - p.x) / d1, (v.y - p.y) / d1);
+            let (wx, wy) = ((q.x - v.x) / d2, (q.y - v.y) / d2);
+            let cross = ux * wy - uy * wx;
+            let cos = (ux * wx + uy * wy).clamp(-1.0, 1.0);
+            if cross <= 1e-9 || cos > 0.25 {
+                ring.push(v);
+                continue;
+            }
+            let rho = if cos < -0.15 { rho_acute } else { rho_right };
+            let room = 0.45 * d1.min(d2);
+            let rr = rho.min(room * (1.0 + cos) / cross.max(1e-12));
+            if rr <= 1e-3 {
+                ring.push(v);
+                continue;
+            }
+            let t = rr * cross / (1.0 + cos).max(1e-12);
+            let t1 = Point2::new(v.x - ux * t, v.y - uy * t);
+            let t2 = Point2::new(v.x + wx * t, v.y + wy * t);
+            let c = Point2::new(t1.x - uy * rr, t1.y + ux * rr);
+            let a0 = (t1.y - c.y).atan2(t1.x - c.x);
+            let mut a1 = (t2.y - c.y).atan2(t2.x - c.x);
+            while a1 <= a0 {
+                a1 += std::f64::consts::TAU;
+            }
+            let steps = ((a1 - a0) / 0.1).ceil().max(2.0) as usize;
+            ring.push(t1);
+            for s in 1..steps {
+                let a = a0 + (a1 - a0) * (s as f64 / steps as f64);
+                ring.push(Point2::new(c.x + rr * a.cos(), c.y + rr * a.sin()));
+            }
+            ring.push(t2);
+        }
+        if ring.len() >= 3 {
+            loops.push(Loop::new(ring)?);
+        }
+    }
+    Ok(Region::new(loops)?)
+}
diff --git a/crates/motion/src/machining2d/adaptive_troch_lanes.rs b/crates/motion/src/machining2d/adaptive_troch_lanes.rs
new file mode 100644
index 000000000..e8114c0ac
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive_troch_lanes.rs
@@ -0,0 +1,334 @@
+//! Multi-lane decomposition and closed-spine routing for `adaptive_troch` (#1587):
+//! single open lanes, closed ring lanes round islands (`layout_closed`),
+//! oriented parallel scanline slicing, and residual medial lanes inside
+//! leftover pockets. Clean-room decomposition based on Blum (1967) and Held (1991).
+
+use crate::geo2d::{Point2, Region};
+use crate::load::load_step;
+
+use super::adaptive::{Spine, medial_spine, widest_point};
+use super::adaptive_troch_slice::{candidate_angles, dedup_open, layout_confined, rotate_to_longest_edge, slice_angle};
+pub(super) use super::adaptive_troch_slice::{clearance, rest_share, straightened};
+use super::face::GenError;
+use super::pocket::PocketParams;
+use super::pocket_hsm::{SMOOTH_PER_R, components};
+use super::trochoid_slot::{DEFAULT_MAX_ENGAGEMENT, DEFAULT_MICROLIFT, LaneLayout, MIN_BAND_PER_D, TrochoidParams, TrochoidReturn, plan_lane_layout};
+
+const SPINE_TOL: f64 = 0.05;
+const WALL_MARGIN: f64 = 0.01;
+const LANE_GAP: f64 = 0.25;
+const REST_MAX: f64 = 0.25;
+const WHO: &str = "2D Adaptive (Trochoidal)";
+
+pub(super) struct PlannedLanes {
+    pub(super) layouts: Vec<LaneLayout>,
+    pub(super) used_center: Region,
+    pub(super) cleared: Region,
+}
+
+pub(super) fn trochoid_params(b: f64, p: &PocketParams) -> TrochoidParams {
+    let r = 0.5 * p.tool_diameter;
+    let ret = if p.clearance_z - p.top_z >= DEFAULT_MICROLIFT {
+        TrochoidReturn::Microlift { height: DEFAULT_MICROLIFT }
+    } else {
+        TrochoidReturn::Retract
+    };
+    TrochoidParams {
+        tool_diameter: p.tool_diameter,
+        width: 2.0 * (b + r + p.stock_to_leave),
+        loop_width: None,
+        step: load_step(p.tool_diameter, p.optimal_load),
+        max_engagement: DEFAULT_MAX_ENGAGEMENT,
+        ret,
+        smoothing: r * SMOOTH_PER_R,
+        stock_to_leave: p.stock_to_leave,
+        clearance_z: p.clearance_z,
+        retract_z: p.retract_z,
+        top_z: p.top_z,
+        bottom_z: p.bottom_z,
+        stepdown: p.stepdown,
+        feed: p.feed,
+        return_feed: p.feed,
+        plunge_feed: p.plunge_feed,
+        climb: p.climb,
+    }
+}
+
+pub(super) fn narrow_err(clear: f64, p: &PocketParams) -> GenError {
+    let (d, r) = (p.tool_diameter, 0.5 * p.tool_diameter);
+    GenError::Invalid(format!(
+        "{WHO}: the region is {:.3} mm wide where the loops would run, too narrow for a {d:.3} mm tool to loop in (it needs more than {:.3} mm) - use a smaller tool, or cut it as a Slot",
+        2.0 * (clear.max(0.0) + r + p.stock_to_leave),
+        d * (1.0 + 2.0 * MIN_BAND_PER_D) + 2.0 * (p.stock_to_leave + WALL_MARGIN)
+    ))
+}
+
+pub(super) fn plan_all_lanes(region: &Region, center: &Region, p: &PocketParams) -> Result<PlannedLanes, GenError> {
+    let d = p.tool_diameter;
+    let Some((_, widest)) = widest_point(center) else {
+        return Err(narrow_err(0.0, p));
+    };
+    if widest - WALL_MARGIN <= MIN_BAND_PER_D * d {
+        return Err(narrow_err(widest, p));
+    }
+    let reach = if p.stock_to_leave > 0.0 { region.offset(-p.stock_to_leave)? } else { region.clone() };
+    let comps = components(center)?;
+    let mut layouts = Vec::new();
+    let mut used_center = Region::empty();
+    let mut cleared = Region::empty();
+
+    for comp in &comps {
+        if widest_point(comp).is_none_or(|(_, w)| w - WALL_MARGIN <= MIN_BAND_PER_D * d) {
+            continue;
+        }
+        if comps.len() == 1 && try_single_fast_path(comp, &reach, p, &mut layouts, &mut used_center, &mut cleared)? {
+            continue;
+        }
+        fill_component(comp, center, &reach, p, &mut layouts, &mut used_center, &mut cleared)?;
+    }
+    if layouts.is_empty() {
+        return Err(narrow_err(widest, p));
+    }
+    Ok(PlannedLanes { layouts, used_center, cleared })
+}
+
+fn plan_lane_safe(
+    chain: &[Point2],
+    b_room: f64,
+    loop_w: Option<f64>,
+    step_hint: Option<f64>,
+    open: bool,
+    closed: bool,
+    p: &PocketParams,
+) -> Result<LaneLayout, GenError> {
+    let mut tp = TrochoidParams { loop_width: loop_w, max_engagement: 88.5, ..trochoid_params(b_room, p) };
+    if let Some(s) = step_hint {
+        tp.step = tp.step.min(s);
+    }
+    match plan_lane_layout(chain, &tp, open, closed) {
+        Ok(lay) => Ok(lay),
+        Err(_) => {
+            tp.max_engagement = DEFAULT_MAX_ENGAGEMENT;
+            plan_lane_layout(chain, &tp, open, closed)
+        }
+    }
+}
+
+fn try_single_fast_path(
+    comp: &Region,
+    reach: &Region,
+    p: &PocketParams,
+    layouts: &mut Vec<LaneLayout>,
+    used_center: &mut Region,
+    cleared: &mut Region,
+) -> Result<bool, GenError> {
+    let (d, r) = (p.tool_diameter, 0.5 * p.tool_diameter);
+    match medial_spine(comp)? {
+        Ok((Spine::Open(pts), half)) => {
+            let chain = dedup_open(&straightened(&pts, SPINE_TOL * half));
+            if chain.len() < 2 {
+                return Ok(false);
+            }
+            let b = clearance(comp, &chain) - WALL_MARGIN;
+            if b <= MIN_BAND_PER_D * d || b > 2.2 * r {
+                return Ok(false);
+            }
+            let swept = Region::sweep(std::slice::from_ref(&chain), r + b)?;
+            if rest_share(reach, &swept) > REST_MAX {
+                return Ok(false);
+            }
+            let tp = trochoid_params(b, p);
+            let lay = plan_lane_layout(&chain, &tp, b > r, false).map_err(super::adaptive_troch::renamed)?;
+            if layout_confined(&lay, comp, false, p)? {
+                *used_center = used_center.union(&Region::sweep(std::slice::from_ref(&chain), b)?)?;
+                *cleared = cleared.union(&swept)?;
+                layouts.push(lay);
+                return Ok(true);
+            }
+        }
+        Ok((Spine::Closed(pts), half)) => {
+            let simplified = dedup_open(&straightened(&pts, 0.005 * half));
+            let rotated = rotate_to_longest_edge(&simplified);
+            let mut chain = dedup_open(&rotated);
+            if let Some(&first) = chain.first()
+                && chain.last().is_none_or(|&l| (l.x - first.x).hypot(l.y - first.y) > 1e-6)
+            {
+                chain.push(first);
+            }
+            if chain.len() < 4 {
+                return Ok(false);
+            }
+            let room_b = clearance(comp, &chain) - WALL_MARGIN;
+            let b_max = (room_b - (0.015 * half).max(WALL_MARGIN)).min(1.40 * r);
+            for scale in [0.95, 0.84, 0.70, 0.55] {
+                let b_loop = b_max * scale;
+                if b_loop <= MIN_BAND_PER_D * d {
+                    continue;
+                }
+                let swept = Region::sweep(std::slice::from_ref(&chain), r + b_loop)?;
+                if rest_share(reach, &swept) > REST_MAX {
+                    break;
+                }
+                if let Ok(lay) = plan_lane_safe(&chain, room_b, Some(2.0 * b_loop), None, b_loop > r, true, p)
+                    && layout_confined(&lay, comp, true, p)?
+                {
+                    *used_center = used_center.union(&Region::sweep(std::slice::from_ref(&chain), b_loop)?)?;
+                    *cleared = cleared.union(&swept)?;
+                    layouts.push(lay);
+                    return Ok(true);
+                }
+            }
+        }
+        Err(_) => {}
+    }
+    Ok(false)
+}
+
+fn fill_component(
+    comp: &Region,
+    center: &Region,
+    reach: &Region,
+    p: &PocketParams,
+    layouts: &mut Vec<LaneLayout>,
+    used_center: &mut Region,
+    cleared: &mut Region,
+) -> Result<(), GenError> {
+    let (d, r) = (p.tool_diameter, 0.5 * p.tool_diameter);
+    for pass in 0..3 {
+        let uncut = reach.difference(cleared)?;
+        if uncut.offset(-0.025)?.is_empty() {
+            break;
+        }
+        let avail = if used_center.is_empty() {
+            comp.clone()
+        } else {
+            comp.difference(&used_center.offset(LANE_GAP)?)?
+        };
+        if avail.is_empty() {
+            break;
+        }
+        let subs = components(&avail)?;
+        let min_w = if pass == 0 {
+            MIN_BAND_PER_D * d + WALL_MARGIN
+        } else {
+            (0.35 * r).max(MIN_BAND_PER_D * d + WALL_MARGIN)
+        };
+        let min_uncut = if pass == 0 { 0.25 } else { 2.0 };
+        let mut added = false;
+        for sub in &subs {
+            let Some((_, widest)) = widest_point(sub) else { continue };
+            if widest <= min_w {
+                continue;
+            }
+            if sub.offset(r - 0.02)?.intersect(&uncut)?.area() < min_uncut {
+                continue;
+            }
+            if pass > 0
+                && sub.loops().len() == 1
+                && try_residual_medial(sub, center, p, layouts, used_center, cleared)?
+            {
+                added = true;
+                continue;
+            }
+            if try_parallel_sub(sub, center, p, pass > 0, layouts, used_center, cleared)?
+                || try_residual_medial(sub, center, p, layouts, used_center, cleared)?
+            {
+                added = true;
+            }
+        }
+        if !added {
+            break;
+        }
+    }
+    Ok(())
+}
+
+fn try_residual_medial(
+    sub: &Region,
+    center: &Region,
+    p: &PocketParams,
+    layouts: &mut Vec<LaneLayout>,
+    used_center: &mut Region,
+    cleared: &mut Region,
+) -> Result<bool, GenError> {
+    let (d, r) = (p.tool_diameter, 0.5 * p.tool_diameter);
+    let Ok(Ok((Spine::Open(pts), half))) = medial_spine(sub) else {
+        return Ok(false);
+    };
+    let chain = dedup_open(&straightened(&pts, SPINE_TOL * half));
+    if chain.len() < 2 {
+        return Ok(false);
+    }
+    let margin = (0.025 * half).max(WALL_MARGIN);
+    let b = (clearance(sub, &chain) - margin).min(1.8 * r);
+    if b <= MIN_BAND_PER_D * d {
+        return Ok(false);
+    }
+    let sub_reach = sub.offset(r)?;
+    let swept = Region::sweep(std::slice::from_ref(&chain), r + b)?;
+    if rest_share(&sub_reach, &swept) > 0.40 {
+        return Ok(false);
+    }
+    let Ok(lay) = plan_lane_safe(&chain, b, None, None, b > r, false, p) else {
+        return Ok(false);
+    };
+    if !layout_confined(&lay, center, false, p)? {
+        return Ok(false);
+    }
+    *used_center = used_center.union(&Region::sweep(std::slice::from_ref(&chain), b)?)?;
+    *cleared = cleared.union(&swept)?;
+    layouts.push(lay);
+    Ok(true)
+}
+
+fn try_parallel_sub(
+    sub: &Region,
+    center: &Region,
+    p: &PocketParams,
+    allow_short: bool,
+    layouts: &mut Vec<LaneLayout>,
+    used_center: &mut Region,
+    cleared: &mut Region,
+) -> Result<bool, GenError> {
+    let (d, r) = (p.tool_diameter, 0.5 * p.tool_diameter);
+    let Some((_, widest)) = widest_point(sub) else {
+        return Ok(false);
+    };
+    let b_cap = (0.90 * r).min(0.75 * (widest - WALL_MARGIN));
+    if b_cap <= MIN_BAND_PER_D * d {
+        return Ok(false);
+    }
+    let candidates = candidate_angles(sub);
+    let mut best: Option<(f64, usize, f64, Vec<[Point2; 2]>)> = None;
+    for theta in candidates {
+        let Some((b_use, segs)) = slice_angle(sub, theta, b_cap, r, d, allow_short)? else {
+            continue;
+        };
+        if segs.is_empty() {
+            continue;
+        }
+        let chains: Vec<Vec<Point2>> = segs.iter().map(|s| s.to_vec()).collect();
+        let cov = Region::sweep(&chains, r + b_use)?.area();
+        if best.as_ref().is_none_or(|(bc, bn, _, _)| cov > bc + 1e-3 || ((cov - bc).abs() <= 1e-3 && segs.len() < *bn)) {
+            best = Some((cov, segs.len(), b_use, segs));
+        }
+    }
+    let Some((_, _, b_use, segs)) = best else {
+        return Ok(false);
+    };
+    let mut placed = false;
+    let mut step_hint: Option<f64> = None;
+    for seg in segs {
+        let chain = vec![seg[0], seg[1]];
+        if let Ok(lay) = plan_lane_safe(&chain, b_use, None, step_hint, b_use > r, false, p)
+            && layout_confined(&lay, center, false, p)?
+        {
+            step_hint = Some(step_hint.map_or(lay.step, |s| s.min(lay.step)));
+            *used_center = used_center.union(&Region::sweep(std::slice::from_ref(&chain), b_use)?)?;
+            *cleared = cleared.union(&Region::sweep(std::slice::from_ref(&chain), r + b_use)?)?;
+            layouts.push(lay);
+            placed = true;
+        }
+    }
+    Ok(placed)
+}
diff --git a/crates/motion/src/machining2d/adaptive_troch_slice.rs b/crates/motion/src/machining2d/adaptive_troch_slice.rs
new file mode 100644
index 000000000..a5ce575e2
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive_troch_slice.rs
@@ -0,0 +1,240 @@
+//! Scanline slicing and polyline geometry helpers for `adaptive_troch` (#1587);
+//! Douglas & Peucker (1973) line simplification and oriented bounding scanlines.
+
+use std::f64::consts::FRAC_PI_2;
+
+use crate::cl::{PathBuilder, lattice};
+use crate::geo2d::{Loop, Point2, Region};
+use crate::geometry::Point3;
+
+use super::adaptive::boundary_dist;
+use super::face::GenError;
+use super::pocket::PocketParams;
+use super::trochoid_slot::{LaneLayout, MIN_BAND_PER_D, emit_level};
+use super::waterscan::scan_row;
+
+const WALL_MARGIN: f64 = 0.01;
+const SAMPLE: f64 = 0.25;
+const LANE_GAP: f64 = 0.25;
+
+pub(super) type SlicedBand = (f64, Vec<[Point2; 2]>);
+
+pub(super) fn slice_angle(
+    sub: &Region,
+    theta: f64,
+    b_cap: f64,
+    r: f64,
+    d: f64,
+    allow_short: bool,
+) -> Result<Option<SlicedBand>, GenError> {
+    let rot = rotate_region(sub, -theta)?;
+    let eroded0 = rot.offset(-(b_cap + WALL_MARGIN))?;
+    if eroded0.is_empty() {
+        return Ok(None);
+    }
+    let Some((b0_lo, b0_hi)) = eroded0.bounds() else {
+        return Ok(None);
+    };
+    let (min_v, max_v) = (b0_lo.y, b0_hi.y);
+    let span = (max_v - min_v).max(0.0);
+    let target_pitch = 2.0 * b_cap + 0.45 * r;
+    let m = if span < 2.0 * b_cap + LANE_GAP {
+        1
+    } else {
+        ((span / target_pitch).ceil() as usize + 1).max(2)
+    };
+    let (b_use, eroded) = if m > 1 {
+        let dv = span / (m - 1) as f64;
+        if dv < 2.0 * b_cap + LANE_GAP {
+            let shrunk = ((dv - LANE_GAP) * 0.5).min(b_cap);
+            if shrunk <= MIN_BAND_PER_D * d {
+                (b_cap, eroded0)
+            } else {
+                (shrunk, rot.offset(-(shrunk + WALL_MARGIN))?)
+            }
+        } else {
+            (b_cap, eroded0)
+        }
+    } else {
+        (b_cap, eroded0)
+    };
+    let Some((b_lo, b_hi)) = eroded.bounds() else {
+        return Ok(None);
+    };
+    let (ev0, ev1) = (b_lo.y, b_hi.y);
+    let e_span = ev1 - ev0;
+    let vs: Vec<f64> = if e_span <= 2e-3 {
+        vec![0.5 * (ev0 + ev1)]
+    } else {
+        let count = ((e_span / (2.0 * b_use + LANE_GAP)).floor() as usize + 1).min(m.max(2));
+        if count <= 1 {
+            vec![0.5 * (ev0 + ev1)]
+        } else {
+            let (lo, hi) = (ev0 + 1e-3, ev1 - 1e-3);
+            (0..count).map(|k| lo + (hi - lo) * k as f64 / (count - 1) as f64).collect()
+        }
+    };
+    let min_keep = if allow_short { 0.25 } else { 2.2 * b_use };
+    let mut segs = Vec::new();
+    let mut all_segs = Vec::new();
+    for v in vs {
+        for (u0, u1) in scan_row(&eroded, v, true) {
+            let len = u1 - u0;
+            if len < 0.25 {
+                continue;
+            }
+            let trim = 0.02_f64.min(0.1 * len);
+            let a = rotate_pt(Point2::new(u0 + trim, v), theta);
+            let b = rotate_pt(Point2::new(u1 - trim, v), theta);
+            all_segs.push([a, b]);
+            if len >= min_keep {
+                segs.push([a, b]);
+            }
+        }
+    }
+    if segs.is_empty() {
+        segs = all_segs;
+    }
+    Ok((!segs.is_empty()).then_some((b_use, segs)))
+}
+
+pub(super) fn candidate_angles(reg: &Region) -> Vec<f64> {
+    let mut angles = vec![0.0, FRAC_PI_2];
+    let mut edges: Vec<(f64, f64)> = Vec::new();
+    for lp in reg.loops() {
+        let pts = lp.points();
+        for i in 0..pts.len() {
+            let (a, b) = (pts[i], pts[(i + 1) % pts.len()]);
+            let (dx, dy) = (b.x - a.x, b.y - a.y);
+            let l = dx.hypot(dy);
+            if l > 1e-3 {
+                edges.push((l, dy.atan2(dx).rem_euclid(std::f64::consts::PI)));
+            }
+        }
+    }
+    edges.sort_by(|x, y| y.0.total_cmp(&x.0));
+    for (_, a) in edges {
+        if angles.iter().all(|&ex| (ex - a).abs() > 0.05 && (ex - a).abs() < std::f64::consts::PI - 0.05) {
+            angles.push(a);
+            if angles.len() >= 4 {
+                break;
+            }
+        }
+    }
+    angles
+}
+
+fn rotate_pt(q: Point2, a: f64) -> Point2 {
+    let (s, c) = a.sin_cos();
+    Point2::new(q.x * c - q.y * s, q.x * s + q.y * c)
+}
+
+fn rotate_region(reg: &Region, a: f64) -> Result<Region, GenError> {
+    let mut loops = Vec::with_capacity(reg.loops().len());
+    for lp in reg.loops() {
+        let pts = lp.points().iter().map(|&q| rotate_pt(q, a)).collect();
+        loops.push(Loop::new(pts)?);
+    }
+    Ok(Region::new(loops)?)
+}
+
+pub(super) fn rotate_to_longest_edge(pts: &[Point2]) -> Vec<Point2> {
+    if pts.len() < 3 {
+        return pts.to_vec();
+    }
+    let open_n = if pts.first() == pts.last() { pts.len() - 1 } else { pts.len() };
+    let mut best = (0.0, 0usize);
+    for i in 0..open_n {
+        let (a, b) = (pts[i], pts[(i + 1) % open_n]);
+        let l = (b.x - a.x).hypot(b.y - a.y);
+        if l > best.0 {
+            best = (l, i);
+        }
+    }
+    let i = best.1;
+    let (a, b) = (pts[i], pts[(i + 1) % open_n]);
+    let mid = Point2::new(0.5 * (a.x + b.x), 0.5 * (a.y + b.y));
+    let mut out = Vec::with_capacity(open_n + 2);
+    out.push(mid);
+    for k in 1..=open_n {
+        out.push(pts[(i + k) % open_n]);
+    }
+    out.push(mid);
+    out
+}
+
+pub(super) fn dedup_open(pts: &[Point2]) -> Vec<Point2> {
+    let mut out: Vec<Point2> = Vec::with_capacity(pts.len());
+    for &q in pts {
+        if out.last().is_none_or(|p| (p.x - q.x).hypot(p.y - q.y) > 1e-6) {
+            out.push(q);
+        }
+    }
+    out
+}
