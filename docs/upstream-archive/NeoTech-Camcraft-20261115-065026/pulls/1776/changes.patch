From 24882cbac844fbb4a5d03a6b1f15a8b26c632b59 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 15 Nov 2026 01:16:05 +0100
Subject: [PATCH 1/3] feat(ui): edit a sinker condition's wear rate and notes
 in the Machine window

The condition table gets a wear-rate input (stated or not stated, the
#1157 law refuses bad values by name) and a notes input. Both ride the
undoable EditMachineApply.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

Fixes #1381
---
 crates/ui/src/egui_app/machine_edm_editor.rs  | 13 ++++
 .../ui/src/egui_app/sinker_machine_tests.rs   | 64 ++++++++++++++++++-
 2 files changed, 74 insertions(+), 3 deletions(-)

diff --git a/crates/ui/src/egui_app/machine_edm_editor.rs b/crates/ui/src/egui_app/machine_edm_editor.rs
index c90b944ec..5e48a45d5 100644
--- a/crates/ui/src/egui_app/machine_edm_editor.rs
+++ b/crates/ui/src/egui_app/machine_edm_editor.rs
@@ -55,6 +55,9 @@ pub(super) fn draw(ui: &mut Ui, u: Unit, m: &mut Machine) {
 const GAP_SEED_MM: f64 = 0.01;
 /// What ticking a condition's undersize seeds, mm (within (0, 1] mm).
 const UNDERSIZE_SEED_MM: f64 = 0.1;
+/// What ticking a condition's wear rate seeds: a ratio the wear law
+/// (`wear_rate_ok`, [0, 1)) accepts. It is the user's to correct.
+const WEAR_SEED: f64 = 0.1;
 
 fn stated_num(ui: &mut Ui, label: &str, v: &mut Option<f64>, seed: f64, show: impl FnOnce(&mut Ui, &mut f64)) {
     ui.horizontal(|ui| {
@@ -150,6 +153,16 @@ fn conditions(ui: &mut Ui, u: Unit, e: &mut Edm) {
                 remove = Some(i);
             }
         });
+        // A second line keeps the row inside the window (#1381): the wear
+        // rate and the notes.
+        ui.horizontal(|ui| {
+            ui.add_space(24.0);
+            // The axial wear rate (#1381): a ratio, so no unit lens. A value
+            // outside [0, 1) is named below and refused at Apply.
+            stated_num(ui, &format!("Condition {n} wear rate"), &mut c.wear, WEAR_SEED, pages::num_plain);
+            let l = ui.label(format!("Condition {n} notes"));
+            ui.add(TextEdit::singleline(&mut c.notes).desired_width(120.0).hint_text("free text")).labelled_by(l.id);
+        });
     }
     if let Some(i) = remove {
         e.conditions.remove(i);
diff --git a/crates/ui/src/egui_app/sinker_machine_tests.rs b/crates/ui/src/egui_app/sinker_machine_tests.rs
index b4ea1f0c7..383388f1b 100644
--- a/crates/ui/src/egui_app/sinker_machine_tests.rs
+++ b/crates/ui/src/egui_app/sinker_machine_tests.rs
@@ -7,7 +7,7 @@
 
 use egui::Vec2;
 use egui_kittest::Harness;
-use egui_kittest::kittest::Queryable;
+use egui_kittest::kittest::{NodeT, Queryable};
 
 use camcraft_app::machine::{self, parse_mch};
 use camcraft_app::operation::{OpParams, SinkerPass};
@@ -95,7 +95,7 @@ fn add_condition_then_apply_is_one_undo_step() {
     assert_eq!(conditions(&h), 1, "nothing is a command before Apply");
     // The fields scroll and Apply stands below them (#535): bring it in reach.
     h.get_by_label("Apply").scroll_to_me();
-    h.run_steps(4);
+    h.run_steps(10);
     h.get_by_label("Apply").click();
     h.run_steps(3);
     h.state_mut().drain_actions();
@@ -115,7 +115,7 @@ fn a_draft_the_loader_refuses_is_named_and_refused_at_apply() {
     assert!(h.query_all_by_label_contains("Apply will refuse: orbit 2 states no control word").count() >= 1);
     // The fields scroll and Apply stands below them (#535): bring it in reach.
     h.get_by_label("Apply").scroll_to_me();
-    h.run_steps(4);
+    h.run_steps(10);
     h.get_by_label("Apply").click();
     h.run_steps(3);
     h.state_mut().drain_actions();
@@ -211,3 +211,61 @@ fn the_burn_page_reads_the_conditions_gap_and_undersize() {
     assert!(h.query_all_by_label_contains("0.050 mm").count() >= 1, "the stated gap reads");
     assert!(h.query_all_by_label("not stated").count() >= 1, "the unstated undersize says so");
 }
+
+#[test]
+fn the_condition_row_edits_wear_rate_and_notes_through_one_undoable_apply() {
+    let mut h = open_editor();
+    for l in ["Condition 1 wear rate", "Condition 1 notes"] {
+        assert!(h.query_by_label(l).is_some(), "the condition row shows {l}");
+    }
+    // Tick the wear rate in and type a note; both stay in the draft until Apply.
+    h.get_by_label("Condition 1 wear rate").scroll_to_me();
+    h.run_steps(10);
+    h.get_by_label("Condition 1 wear rate").click();
+    h.run_steps(3);
+    assert_eq!(
+        h.get_by_label("Condition 1 wear rate").accesskit_node().toggled(),
+        Some(egui::accesskit::Toggled::True),
+        "the click ticks the wear rate in"
+    );
+    h.get_by_label("Condition 1 notes").click();
+    h.run_steps(2);
+    h.get_by_label("Condition 1 notes").type_text("graphite, 3 A");
+    h.run_steps(3);
+    let wear = |h: &Harness<'static, State>| machine::of(&h.state().world).1.and_then(|m| m.edm).and_then(|e| e.conditions[0].wear);
+    assert_eq!(wear(&h), None, "nothing is a command before Apply");
+    h.get_by_label("Apply").scroll_to_me();
+    h.run_steps(10);
+    h.get_by_label("Apply").click();
+    h.run_steps(3);
+    h.state_mut().drain_actions();
+    h.run();
+    let c = machine::of(&h.state().world).1.and_then(|m| m.edm).map(|e| e.conditions[0].clone()).expect("edm");
+    assert_eq!(c.wear, Some(0.1), "Apply mounts the seeded wear rate: {:?}", h.state().status);
+    assert_eq!(c.notes, "graphite, 3 A", "Apply mounts the note");
+    h.state_mut().pending.push_back(CommandKind::Undo);
+    h.state_mut().drain_actions();
+    h.run();
+    assert_eq!(wear(&h), None, "undo restores the machine without the wear rate");
+}
+
+#[test]
+fn a_bad_wear_rate_is_named_and_refused_like_the_loader_does() {
+    let none = std::collections::BTreeMap::new();
+    for bad in [-0.1, 1.0, 2.5, f64::NAN, f64::INFINITY] {
+        let mut m = sinker();
+        if let Some(e) = m.edm.as_mut() {
+            e.conditions[0].wear = Some(bad);
+            let p = super::machine_edm_editor::problems(e, &none).join(" | ");
+            assert!(p.contains("condition 1 wear"), "the page names wear {bad}: {p}");
+        }
+        assert!(!m.is_sane(), "the loader refuses wear {bad}");
+    }
+    let mut ok = sinker();
+    if let Some(e) = ok.edm.as_mut() {
+        e.conditions[0].wear = Some(0.0);
+        e.conditions[0].notes = "kept".into();
+        assert!(super::machine_edm_editor::problems(e, &none).is_empty());
+    }
+    assert!(ok.is_sane(), "a wear of 0 and a note pass");
+}

From 45748a1f7ed4c4360337ba55d755f2a2e6bb9007 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
