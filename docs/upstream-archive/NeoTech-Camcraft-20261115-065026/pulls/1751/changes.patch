From a1a32800a85ef2e6b70356b46ab3296952b9f02e Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sat, 14 Nov 2026 15:15:35 -0800
Subject: [PATCH] fix(motion): bound ring-prefix chord sagitta

Check every segment interior before replacing ramp chords with arcs.
Pin final and nonfinal D-shaped flats in both directions.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #1612
---
 crates/motion/src/ring_zig.rs             | 19 ++++++++++++++++++-
 crates/motion/src/ring_zig_tests.rs       | 18 ++++++++++++++++++
 docs/decisions/1612-ring-chord-sagitta.md | 20 ++++++++++++++++++++
 3 files changed, 56 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/1612-ring-chord-sagitta.md

diff --git a/crates/motion/src/ring_zig.rs b/crates/motion/src/ring_zig.rs
index 007c4198e..5878b5110 100644
--- a/crates/motion/src/ring_zig.rs
+++ b/crates/motion/src/ring_zig.rs
@@ -41,7 +41,8 @@ pub fn arc_chord(rho: f64, phi: f64) -> f64 {
 /// of radius `rho` in the sense `sense` (+1 CCW, -1 CW): every vertex
 /// but the last within [`ON_RING_TOL`] of the circle; the last (cut
 /// part-way along a chord of the ring's polygon) inside it by at most
-/// that polygon's own sagitta ([`ARC_FIT_TOL`]); its first step turning
+/// that polygon's own sagitta ([`ARC_FIT_TOL`]); every chord stays within
+/// that sagitta too (plus lattice tolerance); its first step turning
 /// in `sense`; and the leg's arc end (`a0 + sense * phi`) landing on the
 /// prefix's end within the arc-versus-chord length difference of a
 /// polygon held to [`ARC_FIT_TOL`] (under `2 pi / 3` of it, plus the
@@ -60,6 +61,22 @@ fn on_ring(pre: &[Point2], center: Point2, rho: f64, sense: f64, end: Point2) ->
     if !(rl <= rho + ON_RING_TOL && rl >= rho - ARC_FIT_TOL - ON_RING_TOL) {
         return false;
     }
+    if !pre.windows(2).all(|w| {
+        let dx = w[1].x - w[0].x;
+        let dy = w[1].y - w[0].y;
+        let len = dx.hypot(dy);
+        if len == 0.0 {
+            return true;
+        }
+        // The closest point also covers a final chord cut short of the circle.
+        let ux = dx / len;
+        let uy = dy / len;
+        let along = ((center.x - w[0].x) * ux + (center.y - w[0].y) * uy).clamp(0.0, len);
+        let nearest = Point2::new(w[0].x + along * ux, w[0].y + along * uy);
+        rho - r(&nearest) <= ARC_FIT_TOL + ON_RING_TOL
+    }) {
+        return false;
+    }
     let Some(next) = pre.get(1) else {
         return false;
     };
diff --git a/crates/motion/src/ring_zig_tests.rs b/crates/motion/src/ring_zig_tests.rs
index 2a86365b5..11ba52522 100644
--- a/crates/motion/src/ring_zig_tests.rs
+++ b/crates/motion/src/ring_zig_tests.rs
@@ -147,3 +147,21 @@ fn min_arc_chord_outlasts_four_decimal_inch() {
     assert!(MIN_ARC_CHORD >= 2f64.sqrt() * 0.00254);
     assert!((arc_chord(2.0, PI) - 4.0).abs() < 1e-12);
 }
+
+/// Ring vertices alone do not prove a long flat follows the ring.
+#[test]
+fn a_d_shaped_prefix_posts_its_chords() {
+    for ccw in [true, false] {
+        let sense = if ccw { 1.0 } else { -1.0 };
+        let angle: f64 = sense * 0.98;
+        let flat = vec![Point2::new(C.x + 1.0, C.y), Point2::new(C.x + angle.cos(), C.y + angle.sin())];
+        let mut followed_flat = flat.clone();
+        let end = angle + sense * 0.05;
+        followed_flat.push(Point2::new(C.x + end.cos(), C.y + end.sin()));
+        for pre in [flat, followed_flat] {
+            let moves = ring_ramp(&pre, ccw, 1, 0.1);
+            assert!(moves.iter().all(|m| m.arc.is_none()), "ccw {ccw}: the 0.98 rad flat must stay chords");
+            assert_eq!(moves, chord_ramp(&pre, 1, 0.1), "ccw {ccw}: preserve the planned flat exactly");
+        }
+    }
+}
diff --git a/docs/decisions/1612-ring-chord-sagitta.md b/docs/decisions/1612-ring-chord-sagitta.md
new file mode 100644
index 000000000..a383de453
--- /dev/null
+++ b/docs/decisions/1612-ring-chord-sagitta.md
@@ -0,0 +1,20 @@
+## #1612 - Bound every ring-prefix chord's sagitta
+
+**Decided:** Check each prefix segment's closest distance to the ring centre
+with a clamped projection. Require that distance to be at least
+`rho - ARC_FIT_TOL - ON_RING_TOL`. Keep the existing vertex, end and sense
+checks. A prefix that fails keeps the exact `push_zig` chord fallback.
+
+**Why:** Vertices on the circle do not prove that their connecting chords
+follow it closely. A radius-1 prefix with a 0.98-radian flat can otherwise
+fly arcs about 0.118 mm beyond that flat. The closest-point check also
+covers a final segment shortened part-way along a polygon chord.
+`ON_RING_TOL` accounts for the existing lattice tolerance.
+
+**Considered and dropped:** Endpoint-only checks leave the reported gap.
+A midpoint-only check can miss the closest point when the shortened final
+endpoint lies inside the ring. Rejecting every ring ramp would discard
+valid helical arcs that already meet the tolerance.
+
+**Cost to change later:** Adjust the local guard and its pinning tests.
+No format, dependency or caller contract changes are required.
