+    let mut old = doc.clone();
+    if let Some(rows) = old["entities"].as_array_mut() {
+        for row in rows {
+            if let Some(o) = row.as_object_mut() {
+                o.remove("flip");
+            }
+        }
+    }
+    let fresh = new_world();
+    project::open(&fresh, &serde_json::to_string(&old).expect("json")).expect("a file without the key opens");
