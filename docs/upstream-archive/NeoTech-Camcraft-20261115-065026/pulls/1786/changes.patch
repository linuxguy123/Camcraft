diff --git a/crates/ui/src/work_envelope.rs b/crates/ui/src/work_envelope.rs
new file mode 100644
index 000000000..a8678ed5d
--- /dev/null
+++ b/crates/ui/src/work_envelope.rs
@@ -0,0 +1,85 @@
+//! The work envelope in the viewport (#1567): a thin outline of the
+//! mounted machine's travel volume, drawn only while the Browser's "Show
+//! work envelope" box is on. Display only - view state, not undoable, never
+//! saved, and it never reaches posting, simulation or the collision and
+//! travel checks. The volume comes from the same travel figures and work
+//! origin those checks read (`camcraft_app::machine::work_envelope`).
+//! Provenance: our own view-state design (issue #1567); no vendor material.
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::machine::envelope::EnvelopeShape;
+use camcraft_app::machine;
+
+use crate::interact::push_line;
+use crate::state::State;
+
+/// Outline colour: a faint steel blue that stays behind the toolpaths.
+const ENVELOPE_RGB: [f32; 3] = [0.35, 0.55, 0.70];
+/// Segments of a lathe envelope's end circles.
+const RING_SEGMENTS: usize = 48;
+
+/// Why the box cannot show an envelope right now, `None` when it can.
+#[must_use]
+pub(crate) fn envelope_problem(state: &State) -> Option<String> {
+    machine::work_envelope(&state.world).err()
+}
+
+/// Is a machine mounted on the active setup (the box is enabled)?
+#[must_use]
+pub(crate) fn machine_mounted(state: &State) -> bool {
+    machine::of(&state.world).1.is_some()
+}
+
+/// The tooltip of the checkbox.
+#[must_use]
+pub(crate) fn tooltip(state: &State) -> String {
+    let what = "Outline of the tool-tip travel of the mounted machine, measured from the setup's work origin (not the table).";
+    match envelope_problem(state) {
+        None => what.to_owned(),
+        Some(why) => format!("Nothing to draw: {why}. {what}"),
+    }
+}
+
+/// The overlay segments of the envelope; empty when the box is off or the
+/// machine states no envelope.
+#[must_use]
+pub(crate) fn envelope_lines(state: &State) -> Vec<[f32; 6]> {
+    if !state.show_work_envelope {
+        return Vec::new();
+    }
+    let Ok(shape) = machine::work_envelope(&state.world) else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    match shape {
+        EnvelopeShape::Box { min, max } => box_lines(&mut out, min, max),
+        EnvelopeShape::Cylinder { cx, cy, radius, z0, z1 } => cylinder_lines(&mut out, cx, cy, radius, z0, z1),
+    }
+    out
+}
+
+fn box_lines(out: &mut Vec<[f32; 6]>, min: [f64; 3], max: [f64; 3]) {
+    let c = |i: usize| Point3::new(if i & 1 == 0 { min[0] } else { max[0] }, if i & 2 == 0 { min[1] } else { max[1] }, if i & 4 == 0 { min[2] } else { max[2] });
+    for i in 0..8usize {
+        for bit in [1usize, 2, 4] {
+            if i & bit == 0 {
+                push_line(out, c(i), c(i | bit), ENVELOPE_RGB);
+            }
+        }
+    }
+}
+
+fn cylinder_lines(out: &mut Vec<[f32; 6]>, cx: f64, cy: f64, r: f64, z0: f64, z1: f64) {
+    let at = |k: usize, z: f64| {
+        let a = std::f64::consts::TAU * (k % RING_SEGMENTS) as f64 / RING_SEGMENTS as f64;
+        Point3::new(cx + r * a.cos(), cy + r * a.sin(), z)
+    };
+    for k in 0..RING_SEGMENTS {
+        push_line(out, at(k, z0), at(k + 1, z0), ENVELOPE_RGB);
+        push_line(out, at(k, z1), at(k + 1, z1), ENVELOPE_RGB);
+    }
+    for q in 0..4 {
+        let k = q * RING_SEGMENTS / 4;
+        push_line(out, at(k, z0), at(k, z1), ENVELOPE_RGB);
+    }
+}
diff --git a/docs/decisions/1567-work-envelope.md b/docs/decisions/1567-work-envelope.md
new file mode 100644
index 000000000..c59ecf04d
--- /dev/null
+++ b/docs/decisions/1567-work-envelope.md
@@ -0,0 +1,34 @@
+## #1567 - Show the machine work envelope in the viewport
+
+**Context:** the maintainer asked for a Browser checkbox that draws the
+mounted machine's work envelope (issue 1567).
+
+**Decided and why:**
+- The envelope is the tool-tip travel volume in program coordinates, put in
+  the world at the setup's work origin. It uses the same travel figures,
+  axis directions and origin law (`posting::wcs_context`) as the program
+  stroke check. The picture cannot disagree with a refusal. The tooltip says
+  "measured from the setup's work origin (not the table)".
+- No table position exists in the machine data, and a stroke is stated in
+  program coordinates (`machine/mod.rs`, #457). So the envelope is not
+  "placed" on a floor under the fixtures. The suggested fallback (floor at
+  the lowest stock point, centred) would invent a number, so it was dropped.
+  The part and the fixtures stand where the work origin puts them.
+- Mill, mill-turn, plasma and EDM: a box of the X, Y and Z travel. Rotary
+  reach is not drawn (first slice, as the issue says).
+- Lathe: a cylinder on the spindle axis through the work origin. The radius
+  is the larger end of the X travel (X is a radius on a lathe, as the lathe
+  stroke check reads it). The length is the Z travel.
+- A missing axis or travel draws nothing. The tooltip names the missing
+  figure. The box is disabled only when no machine is mounted.
+- The box is immediate-mode view state (`State::show_work_envelope`), like
+  "Show world origin axes": no command, not saved, not in history. No MCP
+  tool is needed for display state.
+
+**Considered and dropped:**
+- Faint faces: the overlay buffer is a line list. Faces need a new GPU
+  path. Outline only in this slice.
+- Placing the box on the table or on a fixture stack: needs figures that
+  no machine file states.
+- A new envelope in the `app` crate: the shape maths is pure, so it lives in
+  `camcraft-post` (`machine/envelope.rs`). `app` only reads the world.
