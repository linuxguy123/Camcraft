+    assert!(ok(&good_lift_gen), "{good_lift_gen}");
+
+    let tight = call(&mut s, 13, "edit_operation", json!({ "name": "A1", "params": { "max_engagement": 10.0 } }));
+    assert!(ok(&tight), "{tight}");
