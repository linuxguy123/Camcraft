From baeebe4631498566c6205a94bd699b2be1b5516a Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sat, 14 Nov 2026 12:48:34 -0800
Subject: [PATCH 1/2] feat(ui): viewport hover over a picked feature marks its
 Geometry-tab row

The pointer over a picked face, chain or vertex in the viewport outlines
that pick's row in the Geometry tab and records it in State.geo_row_marked
(ephemeral, cleared each frame, no command). The reverse of #1507.

Refs #1507
Fixes #1519

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/geo_page.rs            |    7 +
 crates/ui/src/egui_app/shell.rs               | 2025 +++++++++--------
 crates/ui/src/egui_app/tests/geo_row_hover.rs |   28 +
 crates/ui/src/state.rs                        |    6 +
 4 files changed, 1054 insertions(+), 1012 deletions(-)

diff --git a/crates/ui/src/egui_app/geo_page.rs b/crates/ui/src/egui_app/geo_page.rs
index 0e76b9bf7..c7d69ca67 100644
--- a/crates/ui/src/egui_app/geo_page.rs
+++ b/crates/ui/src/egui_app/geo_page.rs
@@ -179,6 +179,13 @@ fn chips(ui: &mut Ui, state: &mut State, target: &str) {
                 }
                 x.clicked()
             });
+        // #1519: the viewport pointer over this pick's face, chain or vertex
+        // marks its row (an outline in the hover ink); gone with the pointer.
+        if state.hover.as_ref().is_some_and(|h| h.entity == sel.entity && h.feature == Some(sel.feature)) {
+            let ink = ui.visuals().selection.stroke.color;
+            ui.painter().rect_stroke(row.response.rect, 2.0, egui::Stroke::new(2.0, ink), egui::StrokeKind::Inside);
+            state.geo_row_marked.push(sel.clone());
+        }
         if row.response.hovered() || ui.rect_contains_pointer(row.response.rect) {
             state.geo_hover = Some(sel);
         }
diff --git a/crates/ui/src/egui_app/shell.rs b/crates/ui/src/egui_app/shell.rs
index 85926d25c..cf6920461 100644
--- a/crates/ui/src/egui_app/shell.rs
+++ b/crates/ui/src/egui_app/shell.rs
