+[package]
+name = "camcraft-simview"
+description = "The stand-alone camcraft-sim program: replays a CLFile or a posted 3-axis G-code file against stock, tools, a machine file and a post manifest, headless. No world, no entities, no UI. Clean-room implementation, public sources only."
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+
+# One binary, two subcommands (`cl`, `check`). The name is the one the
+# sim crate's binary had: two binaries with one name collide in target/.
+[[bin]]
+name = "camcraft-sim"
+path = "src/main.rs"
+
+[dependencies]
+# Edges and their imported items: docs/decisions/2574-standalone-camcraft-sim.md.
+camcraft-gcode = { workspace = true }
+camcraft-post = { workspace = true }
+camcraft-sim = { workspace = true }
+tracing-subscriber = { workspace = true }
diff --git a/crates/simview/src/check/args.rs b/crates/simview/src/check/args.rs
new file mode 100644
index 0000000000..9fe2a1632a
--- /dev/null
+++ b/crates/simview/src/check/args.rs
@@ -0,0 +1,199 @@
+//! The command line of `camcraft-sim check` (#2586): each value is read
+//! and refused by name here, before any file is judged.
+//! Provenance: our own command line; G54..G59 are the RS-274/NGC work
+//! offset words.
+
+use std::collections::BTreeMap;
+
+pub const USAGE: &str = "\
+camcraft-sim check - judge a posted 3-axis G-code file (headless)
+
+USAGE:
+    camcraft-sim check <file.nc> --stock <box> --tools <T map> (--post <file.cps> | --dialect <name>)
+                       [--machine <file.mch>] [--wcs G54=x,y,z]... [--fixture <box>]... [--cell <mm>]
+
+    <box>      x0,y0,z0,x1,y1,z1 in mm, in the frame of the program's first work offset
+    <T map>    T1=6,T2=10:ball,T3=8:flute=20:holder=40x50:shank=8x30
+               the diameter in mm, then optional words: `ball`, `flute=<length>`,
+               `shank=<diameter>x<length>`, `holder=<diameter>x<length>`
+    --post     the post's manifest gives the dialect, units, work offsets and kinds served
+    --dialect  rs274, fanuc, haas, tormach, grblhal, tinyg or carvera (overrides the post's)
+    --machine  the machine file: travel limits and the generated machine model
+    --wcs      the machine position of a work offset (one for each offset)
+    --fixture  a fixture box, in the frame of the stock
+    --cell     the stock grid cell in mm (default: from the smallest tool)
+
+EXIT:
+    0  each check ran and passed
+    1  bad input (a file that cannot be read, a malformed value, a word the slice refuses)
+    2  a check failed (each finding names its NC line)
+    3  one or more checks were not judged (each is named)
+";
+
+/// One tool of the T map, in mm.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ToolSpec {
+    pub diameter: f64,
+    pub ball: bool,
+    pub flute: Option<f64>,
+    /// (diameter, length)
+    pub shank: Option<(f64, f64)>,
+    /// (diameter, length)
+    pub holder: Option<(f64, f64)>,
+}
+
+/// The parsed command line.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Args {
+    pub program: String,
+    pub machine: Option<String>,
+    pub post: Option<String>,
+    pub dialect: Option<String>,
+    /// x0, y0, z0, x1, y1, z1
+    pub stock: [f64; 6],
+    pub tools: BTreeMap<u32, ToolSpec>,
+    /// Offset number (1 = G54 .. 6 = G59) to its machine position.
+    pub wcs: BTreeMap<u8, [f64; 3]>,
+    pub fixtures: Vec<[f64; 6]>,
+    pub cell: Option<f64>,
+}
+
+/// What the command line asks for: a run, or the help text.
+pub enum Parsed {
+    Run(Box<Args>),
+    Help,
+}
+
+/// Read the arguments after the word `check`.
+pub fn parse(args: &[String]) -> Result<Parsed, String> {
+    let mut a = Args::default();
+    let (mut stock, mut tools) = (None, false);
+    let mut it = args.iter();
+    while let Some(word) = it.next() {
+        let mut value = |name: &str| it.next().cloned().ok_or_else(|| format!("{name} needs a value"));
+        match word.as_str() {
+            "-h" | "--help" => return Ok(Parsed::Help),
+            "--machine" => a.machine = Some(value("--machine")?),
+            "--post" => a.post = Some(value("--post")?),
+            "--dialect" => a.dialect = Some(value("--dialect")?),
+            "--stock" => stock = Some(boxed("--stock", &value("--stock")?)?),
+            "--fixture" => a.fixtures.push(boxed("--fixture", &value("--fixture")?)?),
+            "--tools" => {
+                tool_map(&value("--tools")?, &mut a.tools)?;
+                tools = true;
+            }
+            "--wcs" => {
+                let (n, at) = wcs(&value("--wcs")?)?;
+                if a.wcs.insert(n, at).is_some() {
+                    return Err(format!("--wcs states G{} two times", 53 + u32::from(n)));
+                }
+            }
+            "--cell" => {
+                let v = value("--cell")?;
+                a.cell = Some(number("--cell", &v).filter(|c| *c > 0.0).ok_or("--cell must be a positive number")?);
+            }
+            o if o.starts_with("--") => return Err(format!("unknown option {o:?} (try check --help)")),
+            o if a.program.is_empty() => a.program = o.to_owned(),
+            o => return Err(format!("one G-code file only: {o:?} is a second one (try check --help)")),
+        }
+    }
+    if a.program.is_empty() {
+        return Err("expected a G-code file (try check --help)".into());
+    }
+    a.stock = stock.ok_or("--stock is required: the stock box x0,y0,z0,x1,y1,z1")?;
+    if !tools {
+        return Err("--tools is required: a T map such as T1=6,T2=10:ball".into());
+    }
+    if a.post.is_none() && a.dialect.is_none() {
+        return Err("name the post (--post <file.cps>) or the dialect (--dialect <name>)".into());
+    }
+    Ok(Parsed::Run(Box::new(a)))
+}
+
+/// A finite number, or `None`.
+fn number(_name: &str, s: &str) -> Option<f64> {
+    s.trim().parse::<f64>().ok().filter(|v| v.is_finite())
+}
+
+/// Finite numbers separated by `sep`, exactly `n` of them.
+fn numbers(name: &str, s: &str, sep: char, n: usize) -> Result<Vec<f64>, String> {
+    let v: Vec<Option<f64>> = s.split(sep).map(|w| number(name, w)).collect();
+    if v.len() != n || v.iter().any(Option::is_none) {
+        return Err(format!("{name} needs {n} finite numbers separated by '{sep}', not {s:?}"));
+    }
+    Ok(v.into_iter().flatten().collect())
+}
+
+/// A box x0,y0,z0,x1,y1,z1 with each minimum under its maximum.
+fn boxed(name: &str, s: &str) -> Result<[f64; 6], String> {
+    let v = numbers(name, s, ',', 6)?;
+    let b = [v[0], v[1], v[2], v[3], v[4], v[5]];
+    if !(b[0] < b[3] && b[1] < b[4] && b[2] < b[5]) {
+        return Err(format!("{name} needs x0 < x1, y0 < y1, z0 < z1, not {s:?}"));
+    }
+    Ok(b)
+}
+
+/// `G54=x,y,z`: the offset number (1..6) and its machine position.
+fn wcs(s: &str) -> Result<(u8, [f64; 3]), String> {
+    let (word, at) = s.split_once('=').ok_or_else(|| format!("--wcs needs G54=x,y,z, not {s:?}"))?;
+    let n = match word.trim().to_ascii_uppercase().as_str() {
+        "G54" => 1,
+        "G55" => 2,
+        "G56" => 3,
+        "G57" => 4,
+        "G58" => 5,
+        "G59" => 6,
+        other => return Err(format!("--wcs names {other:?}: use G54 to G59")),
+    };
+    let v = numbers("--wcs", at, ',', 3)?;
+    Ok((n, [v[0], v[1], v[2]]))
+}
+
+/// A positive length, by the name of its word.
+fn length(word: &str, s: &str) -> Result<f64, String> {
+    number(word, s).filter(|v| *v > 0.0).ok_or_else(|| format!("--tools: {word} must be a positive length, not {s:?}"))
+}
+
+/// `<diameter>x<length>`, each positive.
+fn band(word: &str, s: &str) -> Result<(f64, f64), String> {
+    let (d, l) = s.split_once(['x', 'X']).ok_or_else(|| format!("--tools: {word} needs <diameter>x<length>, not {s:?}"))?;
+    Ok((length(word, d)?, length(word, l)?))
+}
+
+/// `T1=6,T2=10:ball,...` into `out`. A tool stated two times refuses.
+fn tool_map(s: &str, out: &mut BTreeMap<u32, ToolSpec>) -> Result<(), String> {
+    if s.to_ascii_lowercase().ends_with(".camtools") {
+        return Err(format!(
+            "--tools {s:?}: a .camtools library is not read yet (#4465: its reader is in camcraft-app, \
+             and it states no T numbers); give a T map such as T1=6,T2=10:ball"
+        ));
+    }
+    for item in s.split(',').map(str::trim).filter(|w| !w.is_empty()) {
+        let (t, rest) = item.split_once('=').ok_or_else(|| format!("--tools: {item:?} needs T<n>=<diameter>"))?;
+        let n = t
+            .trim()
+            .strip_prefix(['T', 't'])
+            .and_then(|n| n.parse::<u32>().ok())
+            .ok_or_else(|| format!("--tools: {t:?} is not a tool number such as T1"))?;
+        let mut words = rest.split(':');
+        let d = length(&format!("T{n} diameter"), words.next().unwrap_or_default())?;
+        let mut spec = ToolSpec { diameter: d, ball: false, flute: None, shank: None, holder: None };
+        for w in words {
+            match w.split_once('=') {
+                None if w == "ball" => spec.ball = true,
+                Some(("flute", v)) => spec.flute = Some(length("flute", v)?),
+                Some(("shank", v)) => spec.shank = Some(band("shank", v)?),
+                Some(("holder", v)) => spec.holder = Some(band("holder", v)?),
+                _ => return Err(format!("--tools: T{n}: unknown word {w:?} (ball, flute=, shank=, holder=)")),
+            }
+        }
+        if out.insert(n, spec).is_some() {
+            return Err(format!("--tools states T{n} two times"));
+        }
+    }
+    if out.is_empty() {
+        return Err("--tools states no tool".into());
+    }
+    Ok(())
+}
diff --git a/crates/simview/src/check/fixtures.rs b/crates/simview/src/check/fixtures.rs
new file mode 100644
index 0000000000..6efee5598c
--- /dev/null
+++ b/crates/simview/src/check/fixtures.rs
@@ -0,0 +1,95 @@
+//! The fixture law of `camcraft-sim check` (#2586): the flute, shank
+//! and holder bands of each move, and the tool body of each rapid,
+//! against each `--fixture` box, by the region-free laws of `verify`.
+//! Provenance: the fixture laws of `camcraft_sim::verify` (M3.2 stage B).
+
+use std::collections::BTreeMap;
+
+use camcraft_sim::cl::Toolpath;
+use camcraft_sim::fixture::FixtureBox;
+use camcraft_sim::geometry::Point3;
+use camcraft_sim::tools::ToolGeom;
+use camcraft_sim::verify::{bands_vs_fixtures, rapids_vs_fixtures, FixturePart, Warning};
+
+use super::args::ToolSpec;
+use super::frames::{shift, shifted, span};
+use super::program::Program;
+use super::report::Report;
+
+const CHECK: &str = "fixture law";
+
+/// The tool stack of a T map entry, or `None` where it states no flute
+/// length and holder.
+fn geom(t: &ToolSpec) -> Option<ToolGeom> {
+    let (flute, holder) = (t.flute?, t.holder?);
+    let (shank_d, shank_len) = t.shank.unwrap_or((t.diameter, 0.0));
+    Some(ToolGeom {
+        radius: 0.5 * t.diameter,
+        nose_radius: 0.0,
+        flute_len: flute,
+        shank_radius: 0.5 * shank_d,
+        shank_len,
+        holder_radius: 0.5 * holder.0,
+        holder_len: holder.1,
+    })
+}
+
+/// Judge each section against the boxes (in the stock's frame).
+pub fn check(program: &Program, boxes: &[[f64; 6]], tools: &BTreeMap<u32, ToolSpec>, report: &mut Report) {
+    if boxes.is_empty() {
+        return report.pass(CHECK, "no fixture is stated (--fixture): nothing stands in the work area to strike");
+    }
+    let boxes: Vec<FixtureBox> = boxes
+        .iter()
+        .map(|b| FixtureBox { min: Point3::new(b[0], b[1], b[2]), max: Point3::new(b[3], b[4], b[5]) })
+        .collect();
+    let base = program.sections.first().map(|s| (s.offset, s.origin));
+    let (mut judged, mut found) = (0usize, 0usize);
+    for s in &program.sections {
+        let Some((first, last)) = span(&s.lines, &s.skip) else { continue };
+        let Some(d) = base.and_then(|b| shift(b, (s.offset, s.origin))) else {
+            report.not_judged(CHECK, &format!("lines {first}-{last}: the machine positions of G{} and the stock's offset are not both given (--wcs)", 53 + s.offset));
+            continue;
+        };
+        let Some(g) = s.tool.and_then(|n| tools.get(&n)).and_then(geom) else {
+            let t = s.tool.map_or_else(|| "no tool".to_owned(), |n| format!("T{n}"));
+            report.not_judged(CHECK, &format!("lines {first}-{last}: {t} has no flute length and holder in --tools"));
+            continue;
+        };
+        // Keep only the moves that the run knows, with their NC lines.
+        let (moves, lines): (Vec<_>, Vec<usize>) = s
+            .moves
+            .iter()
+            .zip(&s.lines)
+            .zip(&s.skip)
+            .filter(|(_, k)| !**k)
+            .map(|((m, l), _)| (shifted(m, d), *l))
+            .unzip();
+        let path = Toolpath::new(moves);
+        let mut hits: Vec<Warning> = bands_vs_fixtures(&path, &g, &boxes, None, 0.01);
+        hits.extend(rapids_vs_fixtures(&path, &g, &boxes));
+        let mut seen: Vec<usize> = Vec::new();
+        for w in hits {
+            if let Warning::FixtureHit { at, fixture_part } = w
+                && !seen.contains(&at)
+            {
+                seen.push(at);
+                found += 1;
+                let line = lines.get(at).copied().unwrap_or_default();
+                let part = match fixture_part {
+                    FixturePart::Shank => "shank",
+                    FixturePart::Holder => "holder",
+                    FixturePart::Spindle => "spindle housing",
+                    FixturePart::Rapid => "tool on a rapid",
+                    FixturePart::Flute => "flute",
+                };
+                let t = s.tool.unwrap_or_default();
+                report.fail(CHECK, &format!("line {line}: the {part} of T{t} strikes a fixture box"));
+            }
+        }
+        judged += lines.len();
+    }
+    if judged > 0 && found == 0 {
+        report.pass(CHECK, &format!("{judged} moves clear of {} fixture boxes", boxes.len()));
+    }
+}
diff --git a/crates/simview/src/check/frames.rs b/crates/simview/src/check/frames.rs
new file mode 100644
index 0000000000..e65cbfa4ec
--- /dev/null
+++ b/crates/simview/src/check/frames.rs
@@ -0,0 +1,43 @@
+//! The frames of `camcraft-sim check` (#2586): a section's moves are in
+//! its work offset; the stock and the fixtures are in the first
+//! section's. A machine position is the work position plus the origin.
+//! Provenance: the RS-274/NGC work offset rule (NISTIR 6556, G54..G59).
+
+use camcraft_sim::cl::Move;
+use camcraft_sim::geo2d::Point2;
+use camcraft_sim::geometry::Point3;
+
+/// The shift from the frame of `to` into the frame of `base`, each an
+/// (offset, origin) pair: zero for the same offset, the difference of
+/// the origins where both are given, else `None`.
+#[must_use]
+pub fn shift(base: (u8, Option<[f64; 3]>), to: (u8, Option<[f64; 3]>)) -> Option<[f64; 3]> {
+    if base.0 == to.0 {
+        return Some([0.0; 3]);
+    }
+    let (b, t) = (base.1?, to.1?);
+    Some([t[0] - b[0], t[1] - b[1], t[2] - b[2]])
+}
+
+/// `mv` moved by `d`.
+#[must_use]
+pub fn shifted(mv: &Move, d: [f64; 3]) -> Move {
+    let at = |p: Point3| Point3::new(p.x + d[0], p.y + d[1], p.z + d[2]);
+    let mut out = *mv;
+    out.from = at(mv.from);
+    out.to = at(mv.to);
+    if let Some(arc) = out.arc.as_mut() {
+        // The centre is the plane's word-order pair (`ArcPlane::words`).
+        let dd = arc.plane.words(Point3::new(d[0], d[1], d[2]));
+        arc.center = Point2::new(arc.center.x + dd.x, arc.center.y + dd.y);
+    }
+    out
+}
+
+/// The first and last NC line of the moves that are not skipped.
+#[must_use]
+pub fn span(lines: &[usize], skip: &[bool]) -> Option<(usize, usize)> {
+    let mut it = lines.iter().zip(skip).filter(|(_, k)| !**k).map(|(l, _)| *l);
+    let first = it.next()?;
+    Some((first, it.next_back().unwrap_or(first)))
+}
diff --git a/crates/simview/src/check/inputs.rs b/crates/simview/src/check/inputs.rs
new file mode 100644
index 0000000000..108e64f3ee
--- /dev/null
+++ b/crates/simview/src/check/inputs.rs
@@ -0,0 +1,105 @@
+//! The reference files of `camcraft-sim check` (#2586): the `.cps`
+//! manifest (read, no hook called), the dialect profile, and the `.mch`
+//! machine with its part tree.
+//! Provenance: our own post manifest and machine-file grammars
+//! (`assets/posts`, `assets/machines/AGENTS.md`); the dialect profiles
+//! are `camcraft-gcode`'s.
+
+use camcraft_gcode::Dialect;
+use camcraft_post::machine::{kind, parse_mch, parse_mch_tree, Kind, Machine, MachineTree};
+use camcraft_post::post::{dialect, engine, js::Script, work_offset};
+
+/// The dialect names that `--dialect` and a post's file name can give.
+pub const DIALECTS: &[&str] = &["rs274", "fanuc", "haas", "tormach", "grblhal", "tinyg", "carvera"];
+
+/// The profile of a dialect name, or `None` for a name this reader does not know.
+#[must_use]
+pub fn dialect_named(name: &str) -> Option<Dialect> {
+    match name.to_ascii_lowercase().as_str() {
+        "rs274" | "linuxcnc" => Some(Dialect::rs274()),
+        "fanuc" => Some(Dialect::fanuc()),
+        "haas" => Some(Dialect::haas()),
+        "tormach" => Some(Dialect::tormach()),
+        "grblhal" => Some(Dialect::grblhal()),
+        "tinyg" => Some(Dialect::tinyg()),
+        "carvera" => Some(Dialect::carvera()),
+        _ => None,
+    }
+}
+
+/// What a post's manifest states. Each field comes from a top-level
+/// variable of the script; no `on...` hook is called.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PostManifest {
+    /// The file name, for the report.
+    pub name: String,
+    pub extension: String,
+    /// `serves`, or `None` where the manifest states none.
+    pub serves: Option<Vec<Kind>>,
+    /// The words of `programUnits` (`mm`, `inch`), or `None`.
+    pub units: Option<Vec<String>>,
+    pub work_offset_max: u32,
+    /// The dialect that the post's file name names, if it names one.
+    pub dialect: Option<String>,
+}
+
+/// Read the manifest of the post at `path`.
+pub fn read_post(path: &str) -> Result<PostManifest, String> {
+    let text = std::fs::read_to_string(path).map_err(|e| format!("cannot read post {path}: {e}"))?;
+    let bad = |e: camcraft_post::post::PostError| format!("post {path}: {e}");
+    let extension = engine::extension_of(&text).map_err(bad)?;
+    let serves = dialect::declared_serves(&text).map_err(bad)?;
+    let units = Script::load(&text)
+        .and_then(|mut s| s.string_global("programUnits"))
+        .map_err(bad)?
+        .map(|u| u.split_whitespace().map(str::to_owned).collect());
+    let work_offset_max = work_offset::work_offsets(&text).map_err(bad)?.max;
+    let stem = std::path::Path::new(path).file_stem().and_then(|s| s.to_str()).unwrap_or_default();
+    let dialect = dialect_named(stem).map(|_| stem.to_ascii_lowercase());
+    let name = std::path::Path::new(path).file_name().and_then(|s| s.to_str()).unwrap_or(path).to_owned();
+    Ok(PostManifest { name, extension, serves, units, work_offset_max, dialect })
+}
+
+/// The kinds a post serves: what it states, or milling where it states
+/// none (the reading of a post with no `serves`, #1266).
+#[must_use]
+pub fn serves(post: &PostManifest, k: Kind) -> bool {
+    post.serves.as_ref().map_or(k == Kind::Mill, |list| list.contains(&k))
+}
+
+/// The machine of a `.mch` file: its limits and its part tree.
+#[derive(Clone, Debug)]
+pub struct MachineFile {
+    pub name: String,
+    pub machine: Machine,
+    pub tree: MachineTree,
+    pub kind: Kind,
+}
+
+/// Read the machine file at `path`. A machine that is not a mill
+/// refuses: this slice judges 3-axis milling only.
+pub fn read_machine(path: &str) -> Result<MachineFile, String> {
+    let text = std::fs::read_to_string(path).map_err(|e| format!("cannot read machine {path}: {e}"))?;
+    let machine = parse_mch(&text).map_err(|e| format!("machine {path}: {e}"))?;
+    let tree = parse_mch_tree(&text).map_err(|e| format!("machine {path}: {e}"))?;
+    let k = kind(Some(&machine));
+    if k != Kind::Mill {
+        return Err(format!("machine {path} is a {k:?} machine: this check judges 3-axis milling programs only"));
+    }
+    let name = std::path::Path::new(path).file_name().and_then(|s| s.to_str()).unwrap_or(path).to_owned();
+    Ok(MachineFile { name, machine, tree, kind: k })
+}
+
+/// The dialect for the run: `--dialect` first, then the post's file name.
+pub fn choose_dialect(flag: Option<&str>, post: Option<&PostManifest>) -> Result<Dialect, String> {
+    if let Some(name) = flag {
+        return dialect_named(name).ok_or_else(|| format!("--dialect {name:?} is not one of {}", DIALECTS.join(", ")));
+    }
+    match post.and_then(|p| p.dialect.as_deref()).and_then(dialect_named) {
+        Some(d) => Ok(d),
+        None => Err(format!(
+            "the post's file name names no dialect profile: give --dialect ({})",
+            DIALECTS.join(", ")
+        )),
+    }
+}
diff --git a/crates/simview/src/check/limits.rs b/crates/simview/src/check/limits.rs
new file mode 100644
index 0000000000..217ecd7a9f
--- /dev/null
+++ b/crates/simview/src/check/limits.rs
@@ -0,0 +1,54 @@
+//! The limit judgment of `camcraft-sim check` (#2586): each move against
+//! the machine's stated strokes and feed ceilings, by the pure machine
+//! check of #2585. A stroke of the machine file is in PROGRAM
+//! coordinates (`assets/machines/AGENTS.md`, `travel`), so the moves are
+//! judged as the program states them, with no work offset. A stroke that
+//! the machine file does not state is named as not judged.
+//! Provenance: general machine-tool practice; the judgment is
+//! `camcraft_post::machine::MachineCheck`.
+
+use camcraft_post::machine::{MachineCheck, SourceLocation};
+use camcraft_sim::cl::Toolpath;
+
+use super::inputs::MachineFile;
+use super::program::Program;
+use super::report::Report;
+
+const CHECK: &str = "machine limits";
+
+/// Judge each move that the run knows against `m`.
+pub fn check(program: &Program, m: Option<&MachineFile>, report: &mut Report) {
+    let Some(m) = m else {
+        return report.not_judged(CHECK, "no machine file is given (--machine)");
+    };
+    let unstated: Vec<&str> = ["X", "Y", "Z"]
+        .iter()
+        .enumerate()
+        .filter(|(k, _)| m.machine.axis(*k).and_then(|a| a.travel).is_none())
+        .map(|(_, l)| *l)
+        .collect();
+    if !unstated.is_empty() {
+        report.not_judged(CHECK, &format!("{} states no stroke for {}: travel is not judged on it", m.name, unstated.join(", ")));
+    }
+    let (mut judged, mut found) = (0usize, 0usize);
+    for s in &program.sections {
+        for ((mv, line), skip) in s.moves.iter().zip(&s.lines).zip(&s.skip) {
+            if *skip {
+                continue;
+            }
+            let mut c = MachineCheck::default();
+            let path = Toolpath::new(vec![*mv]);
+            // The NC moves are program coordinates already: the origin is zero.
+            c.check_path(&m.machine, Some(SourceLocation::NcLine(*line)), &path, [0.0; 3], [false; 3], true);
+            for p in &c.problems {
+                found += 1;
+                report.fail(CHECK, &p.replacen(": move 0 ", ": the move ", 1));
+            }
+            judged += 1;
+        }
+    }
+    if judged > 0 && found == 0 {
+        let what = if unstated.is_empty() { "each move is inside the strokes and feed ceilings" } else { "each move is inside the stated strokes and feed ceilings" };
+        report.pass(CHECK, &format!("{judged} moves: {what} of {}", m.name));
+    }
+}
diff --git a/crates/simview/src/check/mod.rs b/crates/simview/src/check/mod.rs
new file mode 100644
index 0000000000..86ef5abf47
--- /dev/null
+++ b/crates/simview/src/check/mod.rs
@@ -0,0 +1,136 @@
+//! `camcraft-sim check` (#2586): a posted 3-axis G-code file judged
+//! headless against a machine file, a post manifest, a stock box and
+//! the tools. Each check passes, fails with NC line numbers, or is named
+//! as not judged; the exit code says which (`crate::EXIT_*`).
+//! Provenance: our own command over the gcode, post and sim crates.
+
+pub mod args;
+mod fixtures;
+pub mod frames;
+pub mod inputs;
+mod limits;
+mod model;
+pub mod program;
+pub mod report;
+mod sat;
+mod stock;
+
+use crate::{die, EXIT_OK};
+use args::{Args, Parsed};
+use inputs::{MachineFile, PostManifest};
+use program::Program;
+use report::Report;
+
+const POST: &str = "post";
+
+/// Run the subcommand with its arguments (the word `check` removed).
+#[must_use]
+pub fn run(raw: &[String]) -> u8 {
+    let a = match args::parse(raw) {
+        Ok(Parsed::Run(a)) => a,
+        Ok(Parsed::Help) => {
+            print!("{}", args::USAGE);
+            return EXIT_OK;
+        }
+        Err(e) => return die(&e),
+    };
+    match judge(&a) {
+        Ok(report) => {
+            println!("{}", report.text());
+            report.exit_code()
+        }
+        Err(e) => die(&e),
+    }
+}
+
+/// Read the inputs and run each check. An `Err` is bad input.
+fn judge(a: &Args) -> Result<Report, String> {
+    let post = a.post.as_deref().map(inputs::read_post).transpose()?;
+    let machine = a.machine.as_deref().map(inputs::read_machine).transpose()?;
+    if let (Some(p), Some(m)) = (&post, &machine)
+        && !inputs::serves(p, m.kind)
+    {
+        return Err(format!("post {} does not serve the {:?} machine {} (its serves: {:?})", p.name, m.kind, m.name, p.serves));
+    }
+    let dialect = inputs::choose_dialect(a.dialect.as_deref(), post.as_ref())?;
+    let dialect_name = dialect.name.clone();
+    let text = std::fs::read_to_string(&a.program).map_err(|e| format!("cannot read {}: {e}", a.program))?;
+    let program = program::read(&text, dialect, &a.wcs).map_err(|e| format!("{}: {e}", a.program))?;
+    // An unmapped T refuses: a guessed tool gives a wrong verdict (#2213).
+    for s in &program.sections {
+        if let Some(n) = s.tool
+            && !a.tools.contains_key(&n)
+        {
+            let line = s.lines.first().copied().unwrap_or_default();
+            return Err(format!("{}: line {line}: the program uses T{n}, and --tools does not state it", a.program));
+        }
+    }
+
+    let mut r = Report::default();
+    r.note(&format!("program: {} ({} sections, dialect {dialect_name})", a.program, program.sections.len()));
+    header(&mut r, post.as_ref(), machine.as_ref());
+    if let Some(line) = program.first_line {
+        r.note(&format!("line {line}: the first move starts where the machine stands; only its end point is judged"));
+    }
+    post_checks(&program, post.as_ref(), machine.as_ref(), &mut r);
+    let skipped = program.skipped_lines();
+    if !skipped.is_empty() {
+        let list: Vec<String> = skipped.iter().map(ToString::to_string).collect();
+        r.not_judged(
+            "reference moves",
+            &format!(
+                "lines {}: a G28, G30 or G53 move (or the move after it) in a work offset with no --wcs has no known position",
+                list.join(", ")
+            ),
+        );
+    }
+    stock::check(&program, a.stock, &a.tools, a.cell, &mut r);
+    fixtures::check(&program, &a.fixtures, &a.tools, &mut r);
+    limits::check(&program, machine.as_ref(), &mut r);
+    model::check(&program, machine.as_ref(), &mut r);
+    Ok(r)
+}
+
+fn header(r: &mut Report, post: Option<&PostManifest>, machine: Option<&MachineFile>) {
+    if let Some(p) = post {
+        let units = p.units.as_ref().map_or_else(|| "not stated".to_owned(), |u| u.join(" "));
+        r.note(&format!(
+            "post: {} (extension {}, programUnits {units}, work offsets 1..{})",
+            p.name, p.extension, p.work_offset_max
+        ));
+    }
+    if let Some(m) = machine {
+        r.note(&format!("machine: {} ({:?})", m.name, m.kind));
+    }
+}
+
+/// What the post manifest states against what the program asks: the
+/// machine kind, the program units and the work offsets.
+fn post_checks(program: &Program, post: Option<&PostManifest>, machine: Option<&MachineFile>, r: &mut Report) {
+    let Some(p) = post else {
+        return r.not_judged(POST, "no post is given (--post): the units, work offsets and machine kind are not judged");
+    };
+    let before = r.failed();
+    let units = p.units.clone().unwrap_or_else(|| vec!["mm".to_owned()]);
+    for (asks, word, g) in [(program.inch, "inch", "G20"), (program.mm, "mm", "G21")] {
+        if asks && !units.iter().any(|u| u == word) {
+            r.fail(POST, &format!("the program states {g} ({word}), and {} writes {} programs only", p.name, units.join(" ")));
+        }
+    }
+    for s in &program.sections {
+        if u32::from(s.offset) > p.work_offset_max {
+            let line = s.lines.first().copied().unwrap_or_default();
+            r.fail(
+                POST,
+                &format!("line {line}: the program uses G{}, and {} posts work offsets 1..{} only", 53 + s.offset, p.name, p.work_offset_max),
+            );
+        }
+    }
+    match machine {
+        Some(m) => r.note(&format!("{} serves the {:?} machine {}", p.name, m.kind, m.name)),
+        None => r.not_judged(POST, "no machine file is given (--machine): the machine kind that the post serves is not judged"),
+    }
+    if !r.failed() || before {
+        r.pass(POST, &format!("the units and the work offsets agree with {}", p.name));
+    }
+}
diff --git a/crates/simview/src/check/model.rs b/crates/simview/src/check/model.rs
new file mode 100644
index 0000000000..2b9483409c
--- /dev/null
+++ b/crates/simview/src/check/model.rs
@@ -0,0 +1,183 @@
+//! The machine-part collision of `camcraft-sim check` (#2586): the part
+//! tree of the machine file is mapped to the generated model of #2584,
+//! the model is posed along each move at its machine position (work
+//! position + origin), and the spindle and the parts that carry it must
+//! not meet the table and the parts that carry the work. Each finding and
+//! each pass says "judged on a generated model": its bodies are loose.
+//! Provenance: ISO 841 axis nomenclature; the model is
+//! `camcraft_sim::machine_model`; the body test is the separating axis
+//! theorem (`sat`).
+
+use camcraft_post::machine::{MovingSide, PartKind, TreePart};
+use camcraft_sim::machine_model::{generate, Body, BodyKind, BodySource, JointKind, MachineSpec, PartSpec, SpindleSpec, ToolStationSpec};
+
+use super::frames::span;
+use super::inputs::MachineFile;
+use super::program::Program;
+use super::report::Report;
+use super::sat::{boxes_overlap, overlap, Hull};
+use super::stock::samples;
+
+const CHECK: &str = "machine model";
+/// The step between two poses along a move, mm.
+const STEP: f64 = 2.0;
+/// A touch closer than this is not a collision, mm.
+const TOL: f64 = 0.01;
+
+/// The letter (0 = X, 1 = Y, 2 = Z) that a linear part drives: its name, else its id.
+fn letter(p: &TreePart) -> Option<usize> {
+    [&p.name, &p.id].iter().find_map(|w| match w.to_ascii_uppercase().as_str() {
+        "X" => Some(0),
+        "Y" => Some(1),
+        "Z" => Some(2),
+        _ => None,
+    })
+}
+
+/// The model input of the tree, and for each part its pose letter and
+/// sign; a refusal names the part.
+/// For each part: the program letter it drives and the sign of its value.
+type Drives = Vec<Option<(usize, f64)>>;
+
+fn spec(m: &MachineFile) -> Result<(MachineSpec, Drives), String> {
+    let mut parts = Vec::with_capacity(m.tree.parts.len());
+    let mut drives = Vec::with_capacity(m.tree.parts.len());
+    for p in &m.tree.parts {
+        let joint = match p.kind {
+            PartKind::Table | PartKind::Head => JointKind::Fixed,
+            PartKind::Linear => JointKind::Linear,
+            PartKind::Rotary => JointKind::Rotary,
+        };
+        let mut s = PartSpec::new(&p.id, p.parent, joint);
+        s.travel = p.travel;
+        s.pivot = p.pivot;
+        s.offset = p.offset.unwrap_or([0.0; 3]);
+        s.axis = p.axis;
+        let mut drive = None;
+        if p.kind == PartKind::Linear {
+            let k = letter(p).ok_or_else(|| format!("linear part {} names no X, Y or Z", p.id))?;
+            let mut axis = p.axis.unwrap_or_else(|| {
+                let mut a = [0.0; 3];
+                a[k] = 1.0;
+                a
+            });
+            // A part on the table side moves the work: it runs against the program axis.
+            if p.moving_side == Some(MovingSide::Table) {
+                axis = [-axis[0], -axis[1], -axis[2]];
+            }
+            s.axis = Some(axis);
+            drive = Some((k, p.direction.sign()));
+        }
+        if p.kind == PartKind::Head {
+            let b = p.spindle_body.unwrap_or_default();
+            s.spindle = Some(SpindleSpec { diameter: b.diameter, length: b.length });
+            s.tool_station = p.tool_station.map(|t| ToolStationSpec { max_tool_length: t.max_tool_length, max_tool_diameter: t.max_tool_diameter });
+        }
+        parts.push(s);
+        drives.push(drive);
+    }
+    Ok((MachineSpec { parts }, drives))
+}
+
+/// For each part: whether it is on the spindle side - a head, or an axis
+/// that moves the tool (#2583's moving side). A table is on the work side.
+fn head_side(m: &MachineFile) -> Vec<bool> {
+    m.tree.parts.iter().map(|p| p.kind == PartKind::Head || p.moving_side == Some(MovingSide::Tool)).collect()
+}
+
+/// The first pair (head side, work side) that overlaps.
+fn first_hit<'a>(bodies: &'a [Body], head: &[bool]) -> Option<(&'a Body, &'a Body)> {
+    let hulls: Vec<Option<Hull>> = bodies.iter().map(|b| Hull::new(&b.triangles)).collect();
+    for (i, a) in bodies.iter().enumerate() {
+        if !head.get(a.part).copied().unwrap_or(false) || a.kind == BodyKind::ToolEnvelope {
+            continue;
+        }
+        for (j, b) in bodies.iter().enumerate() {
+            if head.get(b.part).copied().unwrap_or(true) || b.kind != BodyKind::Block {
+                continue;
+            }
+            if let (Some(ha), Some(hb)) = (&hulls[i], &hulls[j])
+                && boxes_overlap(ha, hb, TOL)
+                && overlap(ha, hb, TOL)
+            {
+                return Some((a, b));
+            }
+        }
+    }
+    None
+}
+
+/// Judge each section whose origin is given on the generated model of `m`.
+pub fn check(program: &Program, m: Option<&MachineFile>, report: &mut Report) {
+    let Some(m) = m else {
+        return report.not_judged(CHECK, "no machine file is given (--machine)");
+    };
+    if m.tree.parts.is_empty() {
+        return report.not_judged(CHECK, &format!("{} states no part tree (kinematics.default.parts): no model is generated", m.name));
+    }
+    let (spec, drives) = match spec(m) {
+        Ok(s) => s,
+        Err(e) => return report.not_judged(CHECK, &format!("{}: {e}", m.name)),
+    };
+    let model = match generate(&spec) {
+        Ok(model) => model,
+        Err(e) => return report.not_judged(CHECK, &e),
+    };
+    for n in &model.notes {
+        report.note(n);
+    }
+    let head = head_side(m);
+    let steel = |b: &Body, side: bool| head.get(b.part).copied() == Some(side) && b.kind != BodyKind::ToolEnvelope;
+    if !model.bodies.iter().any(|b| steel(b, true)) || !model.bodies.iter().any(|b| steel(b, false)) {
+        return report.not_judged(CHECK, &format!("{}: the model has no steel body on the spindle side or on the work side (see the notes)", m.name));
+    }
+    let ids: Vec<&str> = spec.parts.iter().map(|p| p.id.as_str()).collect();
+    let (mut judged, mut found) = (0usize, 0usize);
+    for s in &program.sections {
+        let Some((first, last)) = span(&s.lines, &s.skip) else { continue };
+        let Some(o) = s.origin else {
+            report.not_judged(CHECK, &format!("lines {first}-{last}: no machine position is given for G{} (--wcs)", 53 + s.offset));
+            continue;
+        };
+        for ((mv, line), skip) in s.moves.iter().zip(&s.lines).zip(&s.skip) {
+            if *skip {
+                continue;
+            }
+            judged += 1;
+            for p in samples(mv, STEP) {
+                let at = [p.x + o[0], p.y + o[1], p.z + o[2]];
+                let values: Vec<(&str, f64)> = ids
+                    .iter()
+                    .zip(&drives)
+                    .zip(&spec.parts)
+                    .filter(|(_, part)| part.joint != JointKind::Fixed)
+                    .map(|((id, d), _)| (*id, d.map_or(0.0, |(k, sign)| at[k] * sign)))
+                    .collect();
+                let posed = match model.pose(&values) {
+                    Ok(b) => b,
+                    Err(e) => return report.not_judged(CHECK, &format!("line {line}: {e}")),
+                };
+                if let Some((a, b)) = first_hit(&posed, &head) {
+                    found += 1;
+                    report.fail(
+                        CHECK,
+                        &format!(
+                            "line {line}: the {} body of part {} meets part {} at machine X{:.3} Y{:.3} Z{:.3} ({})",
+                            if a.kind == BodyKind::Spindle { "spindle" } else { "slide" },
+                            a.part_id,
+                            b.part_id,
+                            at[0],
+                            at[1],
+                            at[2],
+                            BodySource::Generated.judged_on()
+                        ),
+                    );
+                    break;
+                }
+            }
+        }
+    }
+    if judged > 0 && found == 0 {
+        report.pass(CHECK, &format!("{judged} moves: the spindle side clears the work side ({})", BodySource::Generated.judged_on()));
+    }
+}
diff --git a/crates/simview/src/check/program.rs b/crates/simview/src/check/program.rs
new file mode 100644
index 0000000000..67a25b36e9
--- /dev/null
+++ b/crates/simview/src/check/program.rs
@@ -0,0 +1,140 @@
+//! The program of `camcraft-sim check` (#2586): the NC file parsed into
+//! sections in the work frame, each move with its NC line, and each move
+//! whose position this run cannot know marked to skip.
+//! Provenance: RS-274/NGC (NISTIR 6556) and ISO 6983 for the G28, G30
+//! and G53 words and the work offsets; the parser is `camcraft-gcode`.
+
+use std::collections::BTreeMap;
+
+use camcraft_gcode::{parse_with, Dialect, ParseOptions, ReferencePositions};
+use camcraft_sim::cl::Move;
+use camcraft_sim::geometry::Point3;
+
+/// One section of the program: one tool, one work offset.
+#[derive(Clone, Debug)]
+pub struct Section {
+    pub tool: Option<u32>,
+    /// 1 = G54 .. 6 = G59.
+    pub offset: u8,
+    /// The machine position of the offset (`--wcs`), or `None`.
+    pub origin: Option<[f64; 3]>,
+    /// The moves in the frame of the section's work offset, in mm.
+    pub moves: Vec<Move>,
+    /// The 1-based NC line of each move.
+    pub lines: Vec<usize>,
+    /// A move whose start or end this run cannot know: a G28, G30 or
+    /// G53 move in an offset with no `--wcs`, and the move after it.
+    pub skip: Vec<bool>,
+}
+
+/// The parsed program.
+#[derive(Clone, Debug)]
+pub struct Program {
+    pub sections: Vec<Section>,
+    /// The unit words that the program states (`G20`, `G21`).
+    pub inch: bool,
+    pub mm: bool,
+    /// The NC line of the first move, whose start is not known.
+    pub first_line: Option<usize>,
+}
+
+impl Program {
+    /// The lines of the moves that are skipped, in order.
+    #[must_use]
+    pub fn skipped_lines(&self) -> Vec<usize> {
+        let mut out: Vec<usize> = self
+            .sections
+            .iter()
+            .flat_map(|s| s.skip.iter().zip(&s.lines).filter(|(k, _)| **k).map(|(_, l)| *l))
+            .collect();
+        out.dedup();
+        out
+    }
+}
+
+/// The G words of one NC line, comments removed.
+fn g_words(line: &str) -> Vec<f64> {
+    let mut text = String::new();
+    let mut depth = 0usize;
+    for c in line.chars() {
+        match c {
+            ';' if depth == 0 => break,
+            '(' => depth += 1,
+            ')' => depth = depth.saturating_sub(1),
+            c if depth == 0 => text.push(c.to_ascii_uppercase()),
+            _ => {}
+        }
+    }
+    let mut out = Vec::new();
+    let mut rest = text.as_str();
+    while let Some(at) = rest.find('G') {
+        let tail = &rest[at + 1..];
+        let end = tail.find(|c: char| !(c.is_ascii_digit() || c == '.' || c == ' ')).unwrap_or(tail.len());
+        let word: String = tail[..end].chars().filter(|c| !c.is_whitespace()).collect();
+        if let Ok(v) = word.parse::<f64>() {
+            out.push(v);
+        }
+        rest = &tail[end..];
+    }
+    out
+}
+
+/// Parse `text` with `dialect`. `wcs` maps the offsets that the run
+/// knows to their machine positions. G28 and G30 return to machine
+/// zero, the reference point of a control that states no other.
+pub fn read(text: &str, dialect: Dialect, wcs: &BTreeMap<u8, [f64; 3]>) -> Result<Program, String> {
+    let mut references = ReferencePositions {
+        g28: Some(Point3::ZERO),
+        g30: Some(Point3::ZERO),
+        ..ReferencePositions::default()
+    };
+    // An offset with no `--wcs` gets a stand-in origin so that the parse
+    // completes; each move that depends on it is marked to skip below.
+    for (i, slot) in references.wcs_origins.iter_mut().enumerate() {
+        let n = u8::try_from(i + 1).unwrap_or(u8::MAX);
+        let at = wcs.get(&n).copied().unwrap_or([0.0; 3]);
+        *slot = Some(Point3::new(at[0], at[1], at[2]));
+    }
+    let parsed = parse_with(text, &ParseOptions { dialect, references }).map_err(|e| e.to_string())?;
+    let source: Vec<&str> = text.lines().collect();
+    let words_at = |line: usize| source.get(line.wrapping_sub(1)).map(|l| g_words(l)).unwrap_or_default();
+    let mut sections = Vec::with_capacity(parsed.sections.len());
+    // The end of the last move is a point that this run cannot know.
+    let mut end_unknown = false;
+    let mut last_offset: Option<u8> = None;
+    for s in parsed.sections {
+        let offset = s.work_offset.number();
+        let origin = wcs.get(&offset).copied();
+        // A change of offset after motion moves the cursor by the two
+        // origins; with one of them unknown, the next start is unknown.
+        if last_offset.is_some_and(|o| o != offset && (origin.is_none() || !wcs.contains_key(&o))) {
+            end_unknown = true;
+        }
+        last_offset = Some(offset);
+        let mut skip = Vec::with_capacity(s.toolpath.moves.len());
+        for line in &s.move_lines {
+            let reference = words_at(*line).iter().any(|g| [28.0, 30.0, 53.0].contains(g));
+            let here = origin.is_none() && reference;
+            skip.push(here || end_unknown);
+            end_unknown = here;
+        }
+        sections.push(Section {
+            tool: s.tool_number,
+            offset,
+            origin,
+            moves: s.toolpath.moves,
+            lines: s.move_lines,
+            skip,
+        });
+    }
+    // The first move starts where the machine stands, which the program
+    // does not say: only its end is judged (the parser's start is a guess).
+    let mut first_line = None;
+    if let Some(mv) = sections.iter_mut().find_map(|s| s.moves.first_mut().map(|m| (m, s.lines.first().copied()))) {
+        mv.0.from = mv.0.to;
+        mv.0.arc = None;
+        first_line = mv.1;
+    }
+    let all: Vec<f64> = source.iter().flat_map(|l| g_words(l)).collect();
+    Ok(Program { sections, inch: all.contains(&20.0), mm: all.contains(&21.0), first_line })
+}
diff --git a/crates/simview/src/check/report.rs b/crates/simview/src/check/report.rs
new file mode 100644
index 0000000000..8a647b8210
--- /dev/null
+++ b/crates/simview/src/check/report.rs
@@ -0,0 +1,85 @@
+//! The report of `camcraft-sim check` (#2586): one line for each pass,
+//! each finding and each check that was not judged, and the exit code
+//! that they give. A check that did not run never reads as a pass.
+//! Provenance: our own report format.
+
+use crate::{EXIT_FAILED, EXIT_NOT_JUDGED, EXIT_OK};
+
+/// The most findings printed for one check; the count of the rest is
+/// printed, so the count never lies.
+pub const CAP: usize = 40;
+
+#[derive(Debug, Default)]
+pub struct Report {
+    lines: Vec<String>,
+    /// (check, findings withheld past the cap)
+    withheld: Vec<(String, usize)>,
+    failed: bool,
+    unjudged: bool,
+}
+
+impl Report {
+    /// A check ran and found nothing.
+    pub fn pass(&mut self, check: &str, what: &str) {
+        self.lines.push(format!("PASS        {check}: {what}"));
+    }
+
+    /// A check found a problem: `what` names the NC line.
+    pub fn fail(&mut self, check: &str, what: &str) {
+        self.failed = true;
+        let shown = self.lines.iter().filter(|l| l.starts_with("FAIL") && l.contains(&format!(" {check}: "))).count();
+        if shown < CAP {
+            self.lines.push(format!("FAIL        {check}: {what}"));
+        } else if let Some(w) = self.withheld.iter_mut().find(|(c, _)| c == check) {
+            w.1 += 1;
+        } else {
+            self.withheld.push((check.to_owned(), 1));
+        }
+    }
+
+    /// A check (or a part of it) did not run, and why.
+    pub fn not_judged(&mut self, check: &str, why: &str) {
+        self.unjudged = true;
+        self.lines.push(format!("NOT JUDGED  {check}: {why}"));
+    }
+
+    /// A fact for the reader that judges nothing.
+    pub fn note(&mut self, what: &str) {
+        self.lines.push(format!("note        {what}"));
+    }
+
+    #[must_use]
+    pub fn failed(&self) -> bool {
+        self.failed
+    }
+
+    /// 2 when a check failed, else 3 when one was not judged, else 0.
+    #[must_use]
+    pub fn exit_code(&self) -> u8 {
+        if self.failed {
+            EXIT_FAILED
+        } else if self.unjudged {
+            EXIT_NOT_JUDGED
+        } else {
+            EXIT_OK
+        }
+    }
+
+    /// The report text, the result line last.
+    #[must_use]
+    pub fn text(&self) -> String {
+        let mut out: Vec<String> = self.lines.clone();
+        for (check, n) in &self.withheld {
+            out.push(format!("FAIL        {check}: {n} more findings are not printed"));
+        }
+        out.push(
+            match self.exit_code() {
+                EXIT_FAILED => "result: FAILED",
+                EXIT_NOT_JUDGED => "result: NOT JUDGED (each check that did not run is named above)",
+                _ => "result: ok (each check ran and passed)",
+            }
+            .to_owned(),
+        );
+        out.join("\n")
+    }
+}
diff --git a/crates/simview/src/check/sat.rs b/crates/simview/src/check/sat.rs
new file mode 100644
index 0000000000..20a0bc31f7
--- /dev/null
+++ b/crates/simview/src/check/sat.rs
@@ -0,0 +1,114 @@
+//! Intersection of two closed convex bodies given as triangles (#2586):
+//! the bodies of the generated machine model are blocks and cylinders,
+//! each convex. Two convex polyhedra are apart if and only if a face
+//! normal of one or a cross product of two edge directions separates
+//! them (the separating axis theorem).
+//! Provenance: Gottschalk, Lin, Manocha, "OBBTree", SIGGRAPH 1996, and
+//! Ericson, "Real-Time Collision Detection", 2005, ch. 4-5. Our own code.
+
+use camcraft_sim::geometry::Triangle;
+
+type V = [f64; 3];
+
+fn sub(a: V, b: V) -> V {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+fn cross(a: V, b: V) -> V {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn dot(a: V, b: V) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn unit(a: V) -> Option<V> {
+    let n = dot(a, a).sqrt();
+    (n > 1e-12 && n.is_finite()).then(|| [a[0] / n, a[1] / n, a[2] / n])
+}
+
+/// A convex body: its corners, its face normals and its edge directions.
+pub struct Hull {
+    pub lo: V,
+    pub hi: V,
+    verts: Vec<V>,
+    normals: Vec<V>,
+    edges: Vec<V>,
+}
+
+/// Add `d` to `set` unless a parallel direction is in it.
+fn push_dir(set: &mut Vec<V>, d: V) {
+    if !set.iter().any(|s| dot(cross(*s, d), cross(*s, d)) < 1e-12) {
+        set.push(d);
+    }
+}
+
+impl Hull {
+    /// The hull of `tris`. `None` for no triangle or a non-finite one.
+    #[must_use]
+    pub fn new(tris: &[Triangle]) -> Option<Self> {
+        let mut h = Hull { lo: [f64::INFINITY; 3], hi: [f64::NEG_INFINITY; 3], verts: Vec::new(), normals: Vec::new(), edges: Vec::new() };
+        for t in tris {
+            let p = [[t.a.x, t.a.y, t.a.z], [t.b.x, t.b.y, t.b.z], [t.c.x, t.c.y, t.c.z]];
+            if p.iter().flatten().any(|v| !v.is_finite()) {
+                return None;
+            }
+            for v in p {
+                for (k, c) in v.iter().enumerate() {
+                    h.lo[k] = h.lo[k].min(*c);
+                    h.hi[k] = h.hi[k].max(*c);
+                }
+                h.verts.push(v);
+            }
+            if let Some(n) = unit(cross(sub(p[1], p[0]), sub(p[2], p[0]))) {
+                push_dir(&mut h.normals, n);
+            }
+            for (a, b) in [(0, 1), (1, 2), (2, 0)] {
+                if let Some(e) = unit(sub(p[b], p[a])) {
+                    push_dir(&mut h.edges, e);
+                }
+            }
+        }
+        (!h.verts.is_empty()).then_some(h)
+    }
+
+    fn range(&self, axis: V) -> (f64, f64) {
+        self.verts.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(lo, hi), v| {
+            let d = dot(*v, axis);
+            (lo.min(d), hi.max(d))
+        })
+    }
+}
+
+/// Whether the bounding boxes of `a` and `b` overlap by more than `tol`.
+#[must_use]
+pub fn boxes_overlap(a: &Hull, b: &Hull, tol: f64) -> bool {
+    (0..3).all(|k| a.lo[k] < b.hi[k] - tol && b.lo[k] < a.hi[k] - tol)
+}
+
+/// Whether `a` and `b` overlap by more than `tol` along every axis: a
+/// touch (faces in contact) is not an overlap.
+#[must_use]
+pub fn overlap(a: &Hull, b: &Hull, tol: f64) -> bool {
+    if !boxes_overlap(a, b, tol) {
+        return false;
+    }
+    let apart = |axis: V| {
+        let (alo, ahi) = a.range(axis);
+        let (blo, bhi) = b.range(axis);
+        ahi <= blo + tol || bhi <= alo + tol
+    };
+    if a.normals.iter().chain(&b.normals).any(|n| apart(*n)) {
+        return false;
+    }
+    for ea in &a.edges {
+        for eb in &b.edges {
+            if let Some(axis) = unit(cross(*ea, *eb))
+                && apart(axis)
+            {
+                return false;
+            }
+        }
+    }
+    true
+}
diff --git a/crates/simview/src/check/stock.rs b/crates/simview/src/check/stock.rs
new file mode 100644
index 0000000000..fa0f3bc819
--- /dev/null
+++ b/crates/simview/src/check/stock.rs
@@ -0,0 +1,200 @@
+//! The stock check of `camcraft-sim check` (#2586): the program cuts a
+//! stock box move by move, and before each move is cut it is judged
+//! against the material that is left: a rapid through material, and
+//! the holder law (the shank and holder
+//! bands over the flute must not meet material).
+//! Provenance: height-field and distance-field stock removal is general
+//! CAM verification practice from published literature (the `stock_sim`
+//! module states its sources); the band stack over the flute is the
+//! holder law of the `verify` module. The move-by-move order is ours.
+
+use std::collections::BTreeMap;
+
+use camcraft_sim::cl::{Move, MoveKind};
+use camcraft_sim::geometry::Point3;
+use camcraft_sim::stock_sim::{auto_cell, Backend, SimOp, Stock, FIELD_BAND};
+
+use super::args::ToolSpec;
+use super::frames::{shifted, span};
+use super::program::Program;
+use super::report::Report;
+
+const CHECK: &str = "stock";
+const HOLDER: &str = "holder law";
+/// The most sample points along one move.
+const MAX_SAMPLES: usize = 20_000;
+
+/// The sample points of the tool tip along `mv`, about `step` apart,
+/// the two ends exact.
+pub fn samples(mv: &Move, step: f64) -> Vec<Point3> {
+    let mut out = vec![mv.from];
+    for (a, b) in mv.segments3(step * 0.25) {
+        let len = ((b.x - a.x).powi(2) + (b.y - a.y).powi(2) + (b.z - a.z).powi(2)).sqrt();
+        let n = (len / step).ceil().clamp(1.0, MAX_SAMPLES as f64) as usize;
+        for k in 1..=n {
+            let f = k as f64 / n as f64;
+            out.push(Point3::new(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f, a.z + (b.z - a.z) * f));
+        }
+        if out.len() > MAX_SAMPLES {
+            break;
+        }
+    }
+    out
+}
+
+/// Whether the disc of radius `r` about `(x, y)` at height `z` holds
+/// material deeper than `thr`: its centre and eight points on its rim.
+fn disc_in_material(stock: &Stock, p: Point3, r: f64, thr: f64) -> bool {
+    let probe = |x: f64, y: f64| {
+        let d = stock.distance(Point3::new(x, y, p.z));
+        d.is_finite() && d < -thr
+    };
+    if probe(p.x, p.y) {
+        return true;
+    }
+    r > 0.0
+        && (0..8).any(|k| {
+            let a = f64::from(k) * std::f64::consts::FRAC_PI_4;
+            probe(p.x + r * a.cos(), p.y + r * a.sin())
+        })
+}
+
+/// The bands over the flute: (name, radius, height of the band bottom
+/// over the tip). `None` where the T map does not state the stack.
+fn bands(t: &ToolSpec) -> Option<Vec<(&'static str, f64, f64)>> {
+    let (flute, holder) = (t.flute?, t.holder?);
+    let (shank_d, shank_len) = t.shank.unwrap_or((t.diameter, 0.0));
+    let mut out = Vec::new();
+    if shank_len > 0.0 {
+        out.push(("shank", 0.5 * shank_d, flute));
+    }
+    out.push(("holder", 0.5 * holder.0, flute + shank_len));
+    Some(out)
+}
+
+/// Cut the pending moves into the stock, and empty the list.
+fn cut(stock: &mut Stock, pending: &mut Vec<Move>, r: f64, ball: bool) -> Result<(), String> {
+    if pending.is_empty() {
+        return Ok(());
+    }
+    let op = SimOp { moves: pending, radius: r, ball, cone: None, corner: None };
+    stock.simulate(&[op]).map_err(|e| e.to_string())?;
+    pending.clear();
+    Ok(())
+}
+
+/// What one move meets in a stock: the first point of a rapid in
+/// material, and the first band over the flute in material.
+struct Probe {
+    rapid: Option<Point3>,
+    band: Option<(&'static str, Point3)>,
+}
+
+impl Probe {
+    fn any(&self) -> bool {
+        self.rapid.is_some() || self.band.is_some()
+    }
+
+    fn run(st: &Stock, pts: &[Point3], rapid: bool, r: f64, stack: Option<&[(&'static str, f64, f64)]>, cell: f64, thr: f64) -> Self {
+        let rapid = if rapid { pts.iter().find(|p| disc_in_material(st, **p, (r - cell).max(0.0), thr)).copied() } else { None };
+        let band = stack.and_then(|stack| {
+            pts.iter().find_map(|p| {
+                stack
+                    .iter()
+                    .find(|(_, br, off)| disc_in_material(st, Point3::new(p.x, p.y, p.z + off), (br - cell).max(0.0), thr))
+                    .map(|(name, _, _)| (*name, *p))
+            })
+        });
+        Self { rapid, band }
+    }
+}
+
+/// Judge and cut each section in order. `tools` is the T map.
+pub fn check(program: &Program, stock_box: [f64; 6], tools: &BTreeMap<u32, ToolSpec>, cell: Option<f64>, report: &mut Report) {
+    let [x0, y0, _, x1, y1, z1] = stock_box;
+    let r_min = tools.values().map(|t| 0.5 * t.diameter).fold(f64::INFINITY, f64::min);
+    let cell = cell.unwrap_or_else(|| auto_cell(r_min, x1 - x0, y1 - y0));
+    let mut stock = match Stock::block(Backend::Field { band: FIELD_BAND }, x0, y0, x1, y1, z1, cell) {
+        Ok(s) => s,
+        Err(e) => return report.not_judged(CHECK, &format!("the stock box does not build: {e}")),
+    };
+    let thr = cell.max(0.01);
+    let base = program.sections.first().map(|s| (s.offset, s.origin));
+    let (mut judged, mut rapids, mut found, mut holder_found) = (0usize, 0usize, 0usize, 0usize);
+    let mut holder_unstated: Vec<u32> = Vec::new();
+    for s in &program.sections {
+        let Some((first, last)) = span(&s.lines, &s.skip) else { continue };
+        let Some(shift) = base.and_then(|b| super::frames::shift(b, (s.offset, s.origin))) else {
+            report.not_judged(
+                CHECK,
+                &format!("lines {first}-{last} (G{}): the machine positions of this work offset and the stock's are not both given (--wcs)", 53 + s.offset),
+            );
+            continue;
+        };
+        let tool = match s.tool.map(|n| (n, tools.get(&n))) {
+            Some((_, Some(t))) => *t,
+            Some((n, None)) => {
+                report.not_judged(CHECK, &format!("lines {first}-{last}: T{n} is not in --tools"));
+                continue;
+            }
+            None => {
+                report.not_judged(CHECK, &format!("lines {first}-{last}: no tool is loaded (no T word before them)"));
+                continue;
+            }
+        };
+        let t_no = s.tool.unwrap_or_default();
+        let r = 0.5 * tool.diameter;
+        let stack = bands(&tool);
+        if stack.is_none() && !holder_unstated.contains(&t_no) {
+            holder_unstated.push(t_no);
+        }
+        let mut pending: Vec<Move> = Vec::new();
+        for ((mv, line), skip) in s.moves.iter().zip(&s.lines).zip(&s.skip) {
+            if *skip {
+                continue;
+            }
+            let mv = shifted(mv, shift);
+            let pts = samples(&mv, cell);
+            let probe = |st: &Stock| Probe::run(st, &pts, mv.kind == MoveKind::Rapid, r, stack.as_deref(), cell, thr);
+            let mut hit = probe(&stock);
+            // Material only goes: a probe that is clean on the stock
+            // before the pending moves is clean after them. A suspected
+            // hit is read again on the exact stock.
+            if hit.any() && !pending.is_empty() {
+                if let Err(e) = cut(&mut stock, &mut pending, r, tool.ball) {
+                    return report.not_judged(CHECK, &format!("line {line}: the stock engine refuses a move: {e}; later moves are not judged"));
+                }
+                hit = probe(&stock);
+            }
+            if mv.kind == MoveKind::Rapid {
+                rapids += 1;
+            }
+            if let Some(p) = hit.rapid {
+                found += 1;
+                report.fail(CHECK, &format!("line {line}: the rapid runs T{t_no} through material at X{:.3} Y{:.3} Z{:.3}", p.x, p.y, p.z));
+            }
+            if let Some((name, p)) = hit.band {
+                holder_found += 1;
+                report.fail(HOLDER, &format!("line {line}: the {name} of T{t_no} meets material at X{:.3} Y{:.3} Z{:.3} (tip)", p.x, p.y, p.z));
+            }
+            pending.push(mv);
+            judged += 1;
+        }
+        if let Err(e) = cut(&mut stock, &mut pending, r, tool.ball) {
+            return report.not_judged(CHECK, &format!("lines {first}-{last}: the stock engine refuses a move: {e}; later moves are not judged"));
+        }
+    }
+    if judged == 0 {
+        report.not_judged(CHECK, "no move of the program was judged");
+        return;
+    }
+    if found == 0 {
+        report.pass(CHECK, &format!("{judged} moves cut, {rapids} rapids clear of material (cell {cell:.4} mm)"));
+    }
+    for t in &holder_unstated {
+        report.not_judged(HOLDER, &format!("T{t}: the T map states no flute length and holder (flute=, holder=)"));
+    }
+    if holder_found == 0 && judged > 0 && holder_unstated.is_empty() {
+        report.pass(HOLDER, "no shank or holder band meets material");
+    }
+}
