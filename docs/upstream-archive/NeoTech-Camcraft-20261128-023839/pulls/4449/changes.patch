From 0f816e13c8804f226631b73f8ad014bb92be28e1 Mon Sep 17 00:00:00 2001
From: Scott Miller <scott@360machineshop.com>
Date: Fri, 27 Nov 2026 15:22:04 -0600
Subject: [PATCH] fix(xtask): use native expected config paths on Windows

Build the hierarchical config test paths one component at a time.
Preserve the exact path-count and key/privacy assertions.

Co-Authored-By: Codex <noreply@openai.com>
Fixes #4426
---
 docs/decisions/4426-windows-config-paths.md | 17 +++++++++++++++++
 xtask/src/unit_env/config.rs                |  2 +-
 2 files changed, 18 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/4426-windows-config-paths.md

diff --git a/docs/decisions/4426-windows-config-paths.md b/docs/decisions/4426-windows-config-paths.md
new file mode 100644
index 000000000..f0f744abd
--- /dev/null
+++ b/docs/decisions/4426-windows-config-paths.md
@@ -0,0 +1,17 @@
+## #4426 - Build expected config paths with native separators
+
+- **Decided:** build the hierarchical config test's expected paths with one
+  `join` per component. Keep its exact path-count and key/privacy assertions.
+- **Why:** on Windows, `join(".cargo/config.toml")` retains `/`, while the
+  diagnostic builds `.cargo` and the file name separately and prints `\`.
+  The existing test fails even though it reports the correct files.
+  This follows the same test correction as #4120.
+- **Before reading:** the unchanged main at
+  `4d891498e7270eabba1b82809d08228b465c0aec` fails on Windows with
+  `cargo test -j 4 -p xtask unit_env::config::tests::hierarchical_configs_report_paths_and_key_hints_not_effective_values -- --exact --nocapture`.
+  The assertion at `config.rs:98` finds zero matching paths instead of one.
+- **Dropped:** changing runtime diagnostics or normalizing their text in the
+  assertion. Neither is needed, and normalization could hide a wrong path.
+  The independent failures in #4427 and #4428 remain outside this issue.
+- **Cost to change later:** this affects only three expected test paths.
+  Runtime behavior, dependencies and the test inventory stay unchanged.
diff --git a/xtask/src/unit_env/config.rs b/xtask/src/unit_env/config.rs
index 94959ab9f..65bd1bdfc 100644
--- a/xtask/src/unit_env/config.rs
+++ b/xtask/src/unit_env/config.rs
@@ -94,7 +94,7 @@ mod tests {
         for key in ["build.rustflags", "build.target", "profile.dev.opt-level", "target.'cfg(unix)'.rustflags", "profile"] {
             assert!(text.contains(key), "missing {key}: {text}");
         }
-        for path in [base.join(".cargo/config.toml"), root.join(".cargo/config.toml"), ui.join(".cargo/config"), home.join("config.toml")] {
+        for path in [base.join(".cargo").join("config.toml"), root.join(".cargo").join("config.toml"), ui.join(".cargo").join("config"), home.join("config.toml")] {
             assert_eq!(n.iter().filter(|s| s.contains(&path.display().to_string())).count(), 1, "{text}");
         }
         assert!(!text.contains("profile.ignored"));
