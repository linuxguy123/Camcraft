 docs/decisions/4454-win-ui-config-path.md | 21 +++++++++++++++++++++
 xtask/src/unit_env.rs                     | 18 ++++++++++++++++--
 2 files changed, 37 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/4454-win-ui-config-path.md

diff --git a/docs/decisions/4454-win-ui-config-path.md b/docs/decisions/4454-win-ui-config-path.md
new file mode 100644
index 000000000..080a96f54
--- /dev/null
+++ b/docs/decisions/4454-win-ui-config-path.md
@@ -0,0 +1,21 @@
+## #4454 - Windows: the UI config path of `plan_notes` uses one separator
+
+**Decided:** `unit_env::plan_notes` builds the UI directory as
+`root.join("crates").join("ui")`. The test builds its expected config path by
+components too. A source pin, `plan_notes_join_the_ui_directory_by_components`,
+keeps the production join in that form.
+
+**Why:** on Windows, `Path::join("crates/ui")` keeps the `/` in the path. The
+note then shows `...\crates/ui\.cargo\config.toml`. The test expected
+`...\crates/ui/.cargo\config.toml`. The two strings differ, so the test failed
+on Windows only. With joins by components, both sides show only `\`, and the
+printed note is a clean native path for the user too.
+
+**Dropped:**
+- A fix in the test only (compare with `Path` values, or normalize the
+  separators). It hides the mixed separator in the printed note.
+- A change to `config::notes` to normalize every path. That is a larger change
+  and it touches the code of #4427 and #4428 (the same kind of failure in
+  `config.rs` tests). Those issues stay separate.
+
+**Cost to change later:** none. It is a test helper path and one join.
diff --git a/xtask/src/unit_env.rs b/xtask/src/unit_env.rs
index 9a406f653..e8111eb13 100644
--- a/xtask/src/unit_env.rs
+++ b/xtask/src/unit_env.rs
@@ -65,7 +65,8 @@ pub fn notes(vars: &[(String, String)]) -> Vec<String> {
 pub fn plan_notes(vars: &[(String, String)], root: &Path, plan: &crate::plan::Plan) -> Vec<String> {
     let mut dirs = vec![root.to_path_buf()];
     if plan.steps.iter().any(|s| s.in_ui) {
-        dirs.push(root.join("crates/ui"));
+        // Two components: a "/" inside one join stays in the noted path on Windows (#4454).
+        dirs.push(root.join("crates").join("ui"));
     }
     let home = std::env::var_os("CARGO_HOME").filter(|s| !s.is_empty()).map(std::path::PathBuf::from)
         .or_else(|| std::env::var_os("HOME").or_else(|| std::env::var_os("USERPROFILE")).map(|p| std::path::PathBuf::from(p).join(".cargo")));
@@ -221,7 +222,9 @@ mod tests {
     #[test]
     fn plan_notes_only_scan_ui_config_for_ui_steps() {
         let root = std::env::temp_dir().join(format!("xtask-plan-config-{}", std::process::id()));
-        let ui = root.join("crates/ui/.cargo");
+        // Build the expected path by components: on Windows a "/" inside a join stays in the
+        // displayed path, and the note text then differs from this path (#4454).
+        let ui = root.join("crates").join("ui").join(".cargo");
         fs::create_dir_all(&ui).unwrap();
         fs::write(ui.join("config.toml"), "[profile.test]\ndebug = true\n").unwrap();
         let mut plan = crate::plan::Plan::default();
@@ -233,6 +236,17 @@ mod tests {
         let _ = fs::remove_dir_all(root);
     }
 
+    #[test]
+    fn plan_notes_join_the_ui_directory_by_components() {
+        // A "/" inside a join keeps a mixed separator on Windows, so the noted config path
+        // differs from a path built by components (#4454). Linux cannot show the mismatch.
+        let src = include_str!("unit_env.rs");
+        let body = src.split("pub fn plan_notes(").nth(1).unwrap_or_default();
+        let body = body.split("\n}\n").next().unwrap_or_default();
+        assert!(body.contains("join(\"crates\").join(\"ui\")"), "plan_notes must join crates and ui as two components");
+        assert!(!body.contains("join(\"crates/"), "plan_notes must not join a path that contains a separator");
+    }
+
     #[test]
     fn units_count_nested_unit_directories_only() {
         let root = std::env::temp_dir().join(format!("xtask-unit-env-{}", std::process::id()));
