From a6cf61ee8b1b2b3ef19a2745fef7f2145f085cc5 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Fri, 27 Nov 2026 13:06:04 -0800
Subject: [PATCH 2/2] docs(examples): the 3d/rest region is the channel only

The rib ends are convex corners. The 12 mm tool leaves no rest material
at the two channel mouths. Correct the README, the pin doc comment and
the decision file.

Refs #2867

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/example_catalog/case_3d_rest.rs |  6 ++++--
 docs/decisions/2867-3d-rest-case.md              |  3 ++-
 examples/catalog/3d/rest/README.md               | 11 +++++++----
 3 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/crates/app/tests/example_catalog/case_3d_rest.rs b/crates/app/tests/example_catalog/case_3d_rest.rs
index 3b47a5849..8bc651e81 100644
--- a/crates/app/tests/example_catalog/case_3d_rest.rs
+++ b/crates/app/tests/example_catalog/case_3d_rest.rs
@@ -31,8 +31,10 @@ mod catalog_3d_rest {
 
     /// #2867: the 12 mm pocket roughs down to the plate (Z4 + 0.2 mm stock
     /// to leave), and the 6 mm pocket after it cuts only the rest region:
-    /// the 8 mm channel between the ribs (X -4..4, Y -15..15) and its two
-    /// mouths. Between the ribs the 6 mm centre keeps 3 mm + 0.2 mm off
+    /// the 8 mm channel between the ribs (X -4..4, Y -15..15). The 6 mm
+    /// tool enters at the two mouths through space that the 12 mm tool
+    /// cleared, so its centre goes to |Y| <= 18, but it cuts only in the
+    /// channel. Between the ribs the 6 mm centre keeps 3 mm + 0.2 mm off
     /// each wall (|X| <= 0.8).
     #[test]
     fn the_small_tool_cuts_only_the_rest_region() {
diff --git a/docs/decisions/2867-3d-rest-case.md b/docs/decisions/2867-3d-rest-case.md
