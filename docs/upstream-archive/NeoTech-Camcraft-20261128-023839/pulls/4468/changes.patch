+    assert_to(moves(&p)[1], 0.0, 0.0, -1.0);
+    let body = ["CC X+0 Y+0", "L X+10 Y+0 Z-1 R0 F100", "LP PR+0", "LP PR+5"];
+    assert!(modal_refusal(&body, 5).contains("LP without PA"));
