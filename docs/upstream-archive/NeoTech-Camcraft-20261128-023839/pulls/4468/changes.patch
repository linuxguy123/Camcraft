From 007ec28b4ec7f28e552294373548f80ae69da28f Mon Sep 17 00:00:00 2001
From: Quintin Smits <qd.smits@gmail.com>
Date: Fri, 27 Nov 2026 23:31:40 +0100
Subject: [PATCH 3/6] fix(gcode): a line that waits for RND/CHF keeps the
 section start

Refs #2227

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/gcode/src/klartext/exec.rs       |  7 ++++++
 crates/gcode/tests/klartext/contours.rs | 33 +++++++++++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/crates/gcode/src/klartext/exec.rs b/crates/gcode/src/klartext/exec.rs
index 18a030944..1083512b7 100644
--- a/crates/gcode/src/klartext/exec.rs
+++ b/crates/gcode/src/klartext/exec.rs
@@ -262,6 +262,13 @@ impl<'a> Machine<'a> {
 
     /// Start a new section when the tool, offset, spindle or coolant changed after a move.
     pub fn sync_section(&mut self) {
+        // A line that waits for its RND / CHF is not in the builder yet: the
+        // builder start must stay at that line's start. No modal state can
+        // change while it waits (the transition and the line after it take
+        // no M function).
+        if self.pending.is_some() {
+            return;
+        }
         if !self.current.has_moves() {
             self.current = SectionBuilder::new(self.current.index, self.pos, &self.modal);
             self.section_tool_name = self.tool_name.clone();
diff --git a/crates/gcode/tests/klartext/contours.rs b/crates/gcode/tests/klartext/contours.rs
index 0d87fd74e..78db84d4a 100644
--- a/crates/gcode/tests/klartext/contours.rs
+++ b/crates/gcode/tests/klartext/contours.rs
@@ -164,3 +164,36 @@ fn klartext_transition_elements_refuse_what_is_not_exact() {
         assert_eq!(e.line(), 4, "{bad}: {e}");
     }
 }
+
+#[test]
+fn klartext_rnd_on_the_first_move_of_a_section_starts_at_the_line_start() {
+    // The first move of the program waits for its RND.
+    let p = ok(&pgm(&["L X+20 Y+0 F100", "RND R5", "L X+20 Y+20"]));
+    let m = moves(&p);
+    assert_eq!(m.len(), 3);
+    assert!(
+        near(m[0].from.x, 0.0) && near(m[0].from.y, 0.0),
+        "{:?}",
+        m[0].from
+    );
+    assert_to(m[0], 15.0, 0.0, 0.0);
+    assert_arc(m[1], 15.0, 5.0, true);
+    assert_to(m[2], 20.0, 20.0, 0.0);
+    // The first move after a tool change waits for its RND.
+    let p = ok(&pgm(&[
+        "L X+0 Y+0 Z-1 R0 F100",
+        "TOOL CALL 2 Z S1000",
+        "L X+20 Y+0",
+        "RND R5",
+        "L X+20 Y+20",
+    ]));
+    assert_eq!(p.sections.len(), 2);
+    let s = &p.sections[1].toolpath.moves;
+    assert!(
+        near(s[0].from.x, 0.0) && near(s[0].from.y, 0.0),
+        "{:?}",
+        s[0].from
+    );
+    assert_to(&s[0], 15.0, 0.0, -1.0);
+    assert_arc(&s[1], 15.0, 5.0, true);
+}

