diff --git a/crates/post/src/post/tilt_chain.rs b/crates/post/src/post/tilt_chain.rs
new file mode 100644
index 0000000000..fb8f2245b8
--- /dev/null
+++ b/crates/post/src/post/tilt_chain.rs
@@ -0,0 +1,85 @@
+//! The joint angles of a two-rotary tilt chain (#4417), in the prelude
+//! every post script sees: `chainAngles(p)` turns the stream's pose
+//! letters into the angles that the machine's A and B rotaries hold for
+//! the nest order of the machine file.
+//!
+//! Provenance: the JS mirror of `machine::tilt_chain` (the product of
+//! rotations along a serial chain, J. J. Craig, "Introduction to
+//! Robotics", ch. 2-3, and our `cl::pose` law). The rule and the refusal
+//! texts are the same word for word, so the machine check judges the
+//! angles that a G43.4 post writes.
+
+/// Appended to [`super::js::PRELUDE`]: plain JS, no host calls.
+pub const TILT_CHAIN_JS: &str = r#"
+// The rotary of `letter` whose direction lies along component k (0 X,
+// 1 Y) within 0.998 of its length squared, else null.
+function _tiltRotary(letter, k) {
+  var rs = (typeof machine !== "undefined" && machine && machine.rotaries) || [];
+  for (var i = 0; i < rs.length; i++) {
+    if (String(rs[i].name || "").toUpperCase() !== letter) continue;
+    var d = rs[i].direction;
+    if (!d || d.length !== 3) return null;
+    var x = Number(d[0]), y = Number(d[1]), z = Number(d[2]);
+    if (!isFinite(x) || !isFinite(y) || !isFinite(z)) return null;
+    var n2 = x * x + y * y + z * z, c = Number(d[k]);
+    return (n2 > 0 && c * c >= 0.998 * n2) ? rs[i] : null;
+  }
+  return null;
+}
+function _tiltHas(v) { return v !== null && v !== undefined && isFinite(v); }
+function _tiltSnap(v) { return Math.abs(v) < 1e-9 ? 0 : v; }
+function _tiltWrap(v) { var x = v % 360; if (x > 180) x -= 360; else if (x <= -180) x += 360; return x; }
+function _tiltIn(r, v) {
+  var t = r.travel;
+  if (!t || t.length !== 2 || !isFinite(Number(t[0])) || !isFinite(Number(t[1]))) return true;
+  return v >= Number(t[0]) - 1e-6 && v <= Number(t[1]) + 1e-6;
+}
+// "letters" (B is the outer factor, the pose law), "aOuter", or
+// "unstated" (the file does not say which rotary carries the other).
+function _tiltNest(ra, rb) {
+  var pa = String(ra.parent || "").toUpperCase(), pb = String(rb.parent || "").toUpperCase();
+  var ta = ra.turnsPart, tb = rb.turnsPart;
+  if (ta === false && tb === false) return pb === "A" ? "aOuter" : (pa === "B" ? "letters" : "unstated");
+  if (ta === true && tb === true) return pb === "A" ? "letters" : (pa === "B" ? "aOuter" : "unstated");
+  if (ta === true && tb === false) return "aOuter";
+  if (ta === false && tb === true) return "letters";
+  return "unstated";
+}
+var tiltChainWhy = "";  // the refusal of the last chainAngles that returned null
+// The joint angles {A, B, C} that the machine's rotaries hold for the
+// pose letters of `p`, or null (the reason in tiltChainWhy). A machine
+// without an A-about-X and B-about-Y pair, and a pose that turns at most
+// one of the two, keep the letters exactly.
+function chainAngles(p) {
+  var a = _tiltHas(p.A) ? Number(p.A) : 0, b = _tiltHas(p.B) ? Number(p.B) : 0, c = _tiltHas(p.C) ? Number(p.C) : 0;
+  var same = { A: p.A, B: p.B, C: p.C };
+  var ra = _tiltRotary("A", 0), rb = _tiltRotary("B", 1);
+  if (!ra || !rb) return same;
+  var turns = [[ra, a, 0, "X"], [rb, b, 1, "Y"]];
+  for (var i = 0; i < 2; i++) {
+    if (Math.abs(turns[i][1]) > 1e-9 && Number(turns[i][0].direction[turns[i][2]]) < 0) {
+      tiltChainWhy = "tilted move turns rotary " + String(turns[i][0].name).toUpperCase() + ", stated along -" + turns[i][3] + " in a two-rotary tilt chain - the post writes the pose angle unnegated, so the machine would turn the other way";
+      return null;
+    }
+  }
+  if (Math.abs(a) <= 1e-9 || Math.abs(b) <= 1e-9) return same;
+  var nest = _tiltNest(ra, rb);
+  if (nest === "letters") return same;
+  if (nest === "unstated") {
+    tiltChainWhy = "tilted move turns A and B - the machine file does not state which of the two rotaries carries the other, so their joint angles are unknown";
+    return null;
+  }
+  if (Math.abs(c) > 1e-9) {
+    tiltChainWhy = "tilted move turns A, B and C on a chain where A is the outer rotary - the joint angles of that pose are not solved";
+    return null;
+  }
+  var r = Math.PI / 180;
+  var vx = Math.sin(b * r) * Math.cos(a * r), vy = -Math.sin(a * r), vz = Math.cos(b * r) * Math.cos(a * r);
+  var b1 = Math.asin(Math.max(-1, Math.min(1, vx)));
+  var a1 = Math.cos(b1) < 1e-12 ? 0 : Math.atan2(-vy, vz);
+  a1 = _tiltSnap(a1 / r); b1 = _tiltSnap(b1 / r);
+  var a2 = _tiltSnap(_tiltWrap(a1 + 180)), b2 = _tiltSnap(_tiltWrap(180 - b1));
+  if (!(_tiltIn(ra, a1) && _tiltIn(rb, b1)) && _tiltIn(ra, a2) && _tiltIn(rb, b2)) return { A: a2, B: b2, C: p.C };
+  return { A: a1, B: b1, C: p.C };
+}
+"#;
diff --git a/crates/post/tests/tilt_chain_joints.rs b/crates/post/tests/tilt_chain_joints.rs
new file mode 100644
index 0000000000..ca668b112d
--- /dev/null
+++ b/crates/post/tests/tilt_chain_joints.rs
@@ -0,0 +1,199 @@
+//! #4417: a G43.4 post writes the joint angles of the machine's own
+//! tilt chain, not the stream's pose letters. On the tilt head (A carries
+//! B) the tool axis of the posted words is `Rx(A)·Ry(B)·Z`; the pose law
+//! of the letters is `Ry(B)·Rx(A)·Z`. Each posted block must give back
+//! the stream's tool axis on the machine's forward kinematics, and the
+//! machine check judges the same angles that the post writes.
+//!
+//! Gate map: covers post::tilt_chain (the prelude `chainAngles`),
+//! machine::tilt_chain, machine::judge, assets/posts/fanuc.cps,
+//! assets/posts/doosan-dnm.cps.
+
+use camcraft_post::cl::{Move, MoveKind, Toolpath};
+use camcraft_post::geometry::Point3;
+use camcraft_post::machine::{parse_mch, tilt_chain, Machine, MachineCheck};
+use camcraft_post::post::{engine, machine::mirror};
+use serde_json::Value;
+use std::path::Path;
+
+fn read(rel: &str) -> String {
+    let p = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../").join(rel);
+    std::fs::read_to_string(&p).unwrap_or_else(|e| panic!("{rel}: {e}"))
+}
+
+/// The tilt head with its two rotaries' names and axes swapped: B carries A.
+fn swap_nest(text: &str) -> String {
+    let mut v: Value = serde_json::from_str(text).expect("tilthead is JSON");
+    let a = v.pointer_mut("/kinematics/default/parts/0/parts/1/parts/0").expect("the A part");
+    let (an, aa) = (a["name"].clone(), a["axis"].clone());
+    let b = &mut a["parts"][0];
+    let (bn, ba) = (b["name"].clone(), b["axis"].clone());
+    b["name"] = an;
+    b["axis"] = aa;
+    let a = v.pointer_mut("/kinematics/default/parts/0/parts/1/parts/0").expect("the A part");
+    a["name"] = bn;
+    a["axis"] = ba;
+    v.to_string()
+}
+
+fn with_travel(text: &str, a: f64, b: f64) -> String {
+    let mut v: Value = serde_json::from_str(text).expect("JSON");
+    let outer = v.pointer_mut("/kinematics/default/parts/0/parts/1/parts/0").expect("outer rotary");
+    let set = |p: &mut Value, t: f64| p["travel"] = serde_json::json!({ "min": -t, "max": t });
+    let lim = |p: &Value| if p["name"] == "A" { a } else { b };
+    let t = lim(outer);
+    set(outer, t);
+    let inner = &mut outer["parts"][0];
+    let t = lim(inner);
+    set(inner, t);
+    v.to_string()
+}
+
+const POSES: [(f64, f64); 5] = [(30.0, 0.0), (-40.588, 68.859), (25.0, -50.0), (0.0, 45.0), (-60.0, -30.0)];
+
+fn stream() -> String {
+    let mut s = String::from("PARAM ClearancePlane 20\nTOOL 1 T1\nPARAM SpindleSpeed 6000\nSECTION\nRapid X 0 Y 0 Z 20000 A 30000 B 0 C 0\n");
+    for (k, (a, b)) in POSES.iter().enumerate().skip(1) {
+        let x = 10_000 * k;
+        s.push_str(&format!("Feed X {x} Y 0 Z 0 F 300000 A {} B {} C 0\n", (a * 1000.0).round(), (b * 1000.0).round()));
+    }
+    s.push_str("ENDSECTION\n");
+    s
+}
+
+fn pose_axis(a: f64, b: f64) -> [f64; 3] {
+    let (sa, ca) = a.to_radians().sin_cos();
+    let (sb, cb) = b.to_radians().sin_cos();
+    [sb * ca, -sa, cb * ca]
+}
+
+/// Forward kinematics of a head chain: `a_outer` is Rx(A)·Ry(B)·Z.
+fn chain_axis(a: f64, b: f64, a_outer: bool) -> [f64; 3] {
+    if !a_outer {
+        return pose_axis(a, b);
+    }
+    let (sa, ca) = a.to_radians().sin_cos();
+    let (sb, cb) = b.to_radians().sin_cos();
+    [sb, -sa * cb, ca * cb]
+}
+
+fn word(line: &str, k: char) -> Option<f64> {
+    line.split(' ').find_map(|w| w.strip_prefix(k).and_then(|r| r.parse::<f64>().ok()))
+}
+
+/// The modal (A, B) of each block that writes an X word and an angle word.
+fn posted_angles(program: &str) -> Vec<(f64, f64)> {
+    let (mut a, mut b) = (0.0, 0.0);
+    let mut out = Vec::new();
+    for l in program.lines() {
+        a = word(l, 'A').unwrap_or(a);
+        b = word(l, 'B').unwrap_or(b);
+        if word(l, 'X').is_some() && (l.contains(" A") || l.contains(" B")) {
+            out.push((a, b));
+        }
+    }
+    out
+}
+
+fn post(cps: &str, mch: &Machine) -> engine::PostOutput {
+    let options = serde_json::json!({ "rotaryBrake": true });
+    let out = engine::run_with(cps, &mirror(mch), &stream(), &options).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}\n{}", out.warnings, out.program);
+    out
+}
+
+fn assert_axes(out: &engine::PostOutput, mch: &Machine, a_outer: bool) {
+    let got = posted_angles(&out.program);
+    assert_eq!(got.len(), POSES.len(), "one angle block per pose: {}", out.program);
+    for ((pa, pb), (ja, jb)) in POSES.iter().zip(&got) {
+        let want = pose_axis(*pa, *pb);
+        let have = chain_axis(*ja, *jb, a_outer);
+        let err = (0..3).map(|k| (want[k] - have[k]).abs()).fold(0.0, f64::max);
+        assert!(err < 1e-4, "pose A{pa} B{pb}: posted A{ja} B{jb} gives {have:?}, the stream states {want:?}\n{}", out.program);
+        // The machine check judges these very angles.
+        let j = tilt_chain::joint_angles(mch, [*pa, *pb, 0.0]).expect("judged");
+        assert!((j[0] - ja).abs() < 1.5e-3 && (j[1] - jb).abs() < 1.5e-3, "check {j:?} vs posted A{ja} B{jb}");
+    }
+}
+
+#[test]
+fn fanuc_posts_the_joint_angles_of_a_chain_where_a_carries_b() {
+    let mch = parse_mch(&read("assets/machines/tilthead.mch")).expect("tilthead parses");
+    let out = post(&read("assets/posts/fanuc.cps"), &mch);
+    assert_axes(&out, &mch, true);
+}
+
+#[test]
+fn doosan_dnm_posts_the_joint_angles_of_a_chain_where_a_carries_b() {
+    let mch = parse_mch(&read("assets/machines/tilthead.mch")).expect("tilthead parses");
+    let out = post(&read("assets/posts/doosan-dnm.cps"), &mch);
+    assert_axes(&out, &mch, true);
+}
+
+#[test]
+fn a_chain_where_b_carries_a_posts_the_pose_letters() {
+    let mch = parse_mch(&swap_nest(&read("assets/machines/tilthead.mch"))).expect("swapped tilthead parses");
+    for cps in ["assets/posts/fanuc.cps", "assets/posts/doosan-dnm.cps"] {
+        let out = post(&read(cps), &mch);
+        assert_axes(&out, &mch, false);
+        assert!(out.program.contains("A-40.588 B68.859"), "{cps}: the letters as they come: {}", out.program);
+    }
+}
+
+#[test]
+fn a_chain_with_no_stated_nest_is_refused_by_name() {
+    let mch = serde_json::json!({
+        "kinematics": { "static": { "rotaries": [
+            { "letter": "A", "type": "rotary", "direction": [1.0, 0.0, 0.0] },
+            { "letter": "B", "type": "rotary", "direction": [0.0, 1.0, 0.0] } ] } }
+    });
+    let options = serde_json::json!({ "rotaryBrake": true });
+    for cps in ["assets/posts/fanuc.cps", "assets/posts/doosan-dnm.cps"] {
+        let out = engine::run_with(&read(cps), &mch, &stream(), &options).expect("post");
+        assert_eq!(
+            out.warnings,
+            vec!["tilted move turns A and B - the machine file does not state which of the two rotaries carries the other, so their joint angles are unknown"],
+            "{cps}"
+        );
+    }
+}
+
+fn leaning(a: f64, b: f64) -> Toolpath {
+    Toolpath::new(vec![Move::new(
+        MoveKind::Feed,
+        Point3 { x: 0.0, y: 0.0, z: 0.0 },
+        Point3 { x: 10.0, y: 0.0, z: 0.0 },
+        Some(100.0),
+    )
+    .with_axis(pose_axis(a, b))])
+}
+
+#[test]
+fn the_machine_check_judges_the_joint_angles_not_the_letters() {
+    // A -40.588 B 68.859 holds A -67.2 B 45.1 on the tilt head: inside
+    // the letters' 60/70 travel, outside the joint's.
+    let head = read("assets/machines/tilthead.mch");
+    let tight = parse_mch(&with_travel(&head, 60.0, 70.0)).expect("parses");
+    let mut out = MachineCheck::default();
+    out.check_path(&tight, None, &leaning(-40.588, 68.859), [0.0; 3], [false; 3], false);
+    assert!(out.problems.iter().any(|p| p.contains("commands A -67.")), "{:?}", out.problems);
+    // The same travel on the chain where B carries A holds the letters.
+    let swapped = parse_mch(&with_travel(&swap_nest(&head), 60.0, 70.0)).expect("parses");
+    let mut out = MachineCheck::default();
+    out.check_path(&swapped, None, &leaning(-40.588, 68.859), [0.0; 3], [false; 3], false);
+    assert!(out.problems.is_empty(), "{:?}", out.problems);
+}
+
+#[test]
+fn a_pose_past_ninety_takes_the_second_solution_inside_the_travel() {
+    // A 0 B 120 is the same rotation in either order; A 10 B 110 is not,
+    // and its principal solution (B in -90..90) holds A 152.7, outside
+    // the 120 travel - the other solution (A -27.3 B 112.3) is inside it.
+    let mch = parse_mch(&read("assets/machines/tilthead.mch")).expect("tilthead parses");
+    assert_eq!(tilt_chain::joint_angles(&mch, [0.0, 120.0, 0.0]).expect("ok"), [0.0, 120.0, 0.0]);
+    let j = tilt_chain::joint_angles(&mch, [10.0, 110.0, 0.0]).expect("ok");
+    assert!(j[0].abs() <= 120.0 && j[1].abs() <= 120.0, "{j:?}");
+    let want = pose_axis(10.0, 110.0);
+    let have = chain_axis(j[0], j[1], true);
+    assert!((0..3).all(|k| (want[k] - have[k]).abs() < 1e-9), "{have:?} vs {want:?}");
+}
diff --git a/docs/decisions/4417-tilt-chain-joint-angles.md b/docs/decisions/4417-tilt-chain-joint-angles.md
new file mode 100644
index 0000000000..11ac0f2440
--- /dev/null
+++ b/docs/decisions/4417-tilt-chain-joint-angles.md
@@ -0,0 +1,48 @@
+## #4417 - G43.4 posts write the joint angles of the machine's tilt chain
+
+**Decided.** The nest of `tilthead.mch` means "A carries B", as
+`assets/machines/AGENTS.md` says ("the nest chain is the kinematics"). The
+Fanuc and Doosan DNM posts no longer write the stream's pose letters as
+they come. A prelude function, `chainAngles(p)` (`post::tilt_chain`), gives
+the angles that the machine's A and B rotaries hold for the stream's tool
+axis, for the nest order of the machine file. The machine check
+(`machine::judge::pose_problems`) judges the same angles through
+`machine::tilt_chain::joint_angles`. The two copies of the rule have the
+same refusal texts, and a test compares their angles.
+
+The rule:
+
+- No A rotary about X with a B rotary about Y, or a pose that turns at most
+  one of the two: the letters are the joint angles (the two products are
+  then the same rotation, so no program that turns one rotary changes).
+- The outer factor of the tool-axis product is the parent rotary in a head
+  chain, the rotary nearest the work in a table chain, and the table in a
+  table-and-head machine. B outer: the letters. A outer: solved again.
+- A outer: two solutions exist away from B = 90 deg. The first one that both
+  travels hold is taken, else the principal one (B in -90..90), which the
+  travel check then refuses by name.
+
+**Refused by name** (post and check):
+
+- A and B both turn and the file does not state which rotary carries the
+  other (a static mirror with no `parent` and no `turnsPart`).
+- A rotary of the pair stated along -X or -Y turns: these posts write the
+  angle unnegated.
+- C turns as well on an A-outer chain: that pose is not solved.
+
+**Why.** The review of PR #4408 measured up to 27.3 deg between the
+programmed tool axis and the axis that the machine reads, and a tool up to
+0.37 mm into the model. A post must reproduce the CL axis or refuse.
+
+**Dropped.**
+
+- Refuse every pose that turns both A and B on an A-outer chain. Safe, but
+  it refuses the shipped five-axis example on the shipped tilt head.
+- Change the stream letters: the stream is machine-free and the sim and the
+  dump read it. The joint angles belong to the machine.
+- Re-read the nest as "B carries A": the machine file and its AGENTS.md
+  say the opposite.
+
+**Cost to change.** The rule is in two files (`machine/tilt_chain.rs` and
+`post/tilt_chain.rs`). The solution choice (travel first, then principal)
+is one line in each.

