+    assert!((g.twist - 30f64.to_radians().tan() / (d.diameter * 0.5)).abs() < 1e-12, "a 30-degree helix");
+    let tap = shipped("TAP-M6");
+    let g = Grooves::of(&tap).unwrap_or_else(|| panic!("a tap has grooves"));
