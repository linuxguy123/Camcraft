diff --git a/crates/app/src/mcp/bridge.rs b/crates/app/src/mcp/bridge.rs
new file mode 100644
index 00000000..8d066c00
--- /dev/null
+++ b/crates/app/src/mcp/bridge.rs
@@ -0,0 +1,44 @@
+//! `camcraft-cli mcp --connect <addr>` (#183): a stdio <-> TCP bridge, so
+//! an MCP client that only launches stdio servers can drive a running
+//! app's live session. Bytes are copied both ways untouched; the app
+//! end speaks the protocol.
+//!
+//! Provenance: our own std::net code; the MCP stdio transport
+//! (modelcontextprotocol.io, revision 2025-06-18) on the client side.
+//! Clean-room, public sources only.
+
+use std::io::{Read, Write};
+use std::net::{Shutdown, TcpStream, ToSocketAddrs};
+
+/// Copy `input` to the app at `addr` and its answers to `output` until
+/// the app closes the connection. End of `input` half-closes the socket,
+/// so the answers still in flight arrive before the bridge ends.
+///
+/// # Errors
+/// The address does not resolve or connect, or a stream fails.
+pub fn bridge(addr: &str, input: impl Read + Send + 'static, mut output: impl Write) -> std::io::Result<()> {
+    let target = addr
+        .to_socket_addrs()?
+        .next()
+        .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidInput, format!("'{addr}' names no address")))?;
+    let mut from_app = TcpStream::connect(target)?;
+    let mut to_app = from_app.try_clone()?;
+    // Detached on purpose: a blocked stdin read cannot be interrupted, and
+    // the process ends when the app's side closes anyway.
+    let _pump = std::thread::Builder::new().name("camcraft-mcp-bridge".into()).spawn(move || {
+        let mut input = input;
+        if let Err(e) = std::io::copy(&mut input, &mut to_app) {
+            eprintln!("camcraft-cli: mcp bridge: sending failed: {e}");
+        }
+        let _ = to_app.shutdown(Shutdown::Write);
+    })?;
+    let mut chunk = [0u8; 8192];
+    loop {
+        let n = from_app.read(&mut chunk)?;
+        if n == 0 {
+            return Ok(());
+        }
+        output.write_all(&chunk[..n])?;
+        output.flush()?;
+    }
+}
diff --git a/crates/app/src/mcp/listen.rs b/crates/app/src/mcp/listen.rs
new file mode 100644
index 00000000..f4795de2
--- /dev/null
+++ b/crates/app/src/mcp/listen.rs
@@ -0,0 +1,255 @@
+//! The live transport (#183): a loopback-only TCP listener carrying the
+//! same newline-delimited JSON-RPC `camcraft-cli mcp` speaks on stdio,
+//! handing each line to the owning (UI) thread over a channel and
+//! writing that thread's answer back to the client.
+//!
+//! Provenance: our own std::net + std::sync::mpsc code; the framing is
+//! the MCP stdio transport's (modelcontextprotocol.io, revision
+//! 2025-06-18: one JSON-RPC message per line), carried over a socket.
+//! Clean-room, public sources only.
+//!
+//! The thread never touches a world: it only moves text. One client at
+//! a time; a dropped client, a closed channel or an unreadable line is
+//! logged and the listener goes on (or ends with the app), never a panic.
+//! Dropping the [`Inbox`] stops and joins the thread.
+
+use std::io::{BufRead, BufReader, Write};
+use std::net::{Ipv4Addr, SocketAddr, TcpListener, TcpStream};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc::{self, Receiver, RecvTimeoutError, Sender};
+use std::sync::Arc;
+use std::thread::JoinHandle;
+use std::time::Duration;
+
+/// How often a blocked wait looks at the stop flag: the bound on how
+/// long dropping an [`Inbox`] can take.
+const POLL: Duration = Duration::from_millis(50);
+
+/// A line longer than this is refused and its client dropped - a client
+/// that never sends a newline must not grow the app's memory forever.
+const MAX_LINE: usize = 16 * 1024 * 1024;
+
+/// The waker the listener calls after queueing a request, so an idle
+/// GUI loop draws (and drains) a frame. Any thread may call it.
+pub type Wake = Box<dyn Fn() + Send + 'static>;
+
+/// One wire line from the client, waiting for the owning thread.
+pub struct Request {
+    line: String,
+    reply: Sender<Option<String>>,
+}
+
+impl Request {
+    /// An in-process request and the receiver its answer arrives on -
+    /// what the listener makes per line, and what a test or an embedder
+    /// hands an [`Inbox::channel`] directly.
+    #[must_use]
+    pub fn pair(line: impl Into<String>) -> (Self, Receiver<Option<String>>) {
+        let (reply, rx) = mpsc::channel();
+        (Self { line: line.into(), reply }, rx)
+    }
+
+    #[must_use]
+    pub fn line(&self) -> &str {
+        &self.line
+    }
+
+    /// Send the answer back (`None` for a notification). A client that
+    /// went away meanwhile is logged, not an error for the caller.
+    pub fn answer(self, reply: Option<String>) {
+        if self.reply.send(reply).is_err() {
+            tracing::info!("mcp: the client left before its answer was ready");
+        }
+    }
+}
+
+/// The owning thread's end: requests to answer, and (when listening on
+/// a socket) the listener thread it stops and joins on drop.
+pub struct Inbox {
+    rx: Receiver<Request>,
+    addr: Option<SocketAddr>,
+    stop: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl Inbox {
+    /// Listen on 127.0.0.1:`port` (0 picks a free port; [`Inbox::addr`]
+    /// says which). Loopback only by construction: no other interface
+    /// is ever bound.
+    ///
+    /// # Errors
+    /// The bind (port in use, no permission) or the thread spawn failed.
+    pub fn listen(port: u16, wake: Wake) -> std::io::Result<Self> {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, port))?;
+        listener.set_nonblocking(true)?;
+        let addr = listener.local_addr()?;
+        let (tx, rx) = mpsc::channel();
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = Arc::clone(&stop);
+        let thread = std::thread::Builder::new()
+            .name("camcraft-mcp".into())
+            .spawn(move || accept_loop(&listener, &tx, &flag, &wake))?;
+        tracing::info!("mcp: listening on {addr}");
+        Ok(Self { rx, addr: Some(addr), stop, thread: Some(thread) })
+    }
+
+    /// An inbox with no socket: requests arrive through the returned
+    /// sender. The in-process door the UI tests drive.
+    #[must_use]
+    pub fn channel() -> (Sender<Request>, Self) {
+        let (tx, rx) = mpsc::channel();
+        (tx, Self { rx, addr: None, stop: Arc::new(AtomicBool::new(false)), thread: None })
+    }
+
+    /// The next waiting request, never blocking.
+    #[must_use]
+    pub fn next(&self) -> Option<Request> {
+        // Empty and disconnected alike: nothing to answer this frame.
+        self.rx.try_recv().ok()
+    }
+
+    /// The bound address, when listening on a socket.
+    #[must_use]
+    pub fn addr(&self) -> Option<SocketAddr> {
+        self.addr
+    }
+}
+
+impl Drop for Inbox {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        if let Some(thread) = self.thread.take()
+            && thread.join().is_err()
+        {
+            tracing::warn!("mcp: the listener thread ended abnormally");
+        }
+    }
+}
+
+/// `--mcp-port <n>` / `--mcp-port=<n>` over `CAMCRAFT_MCP_PORT`: `None`
+/// when neither asks for the server (it is off by default).
+///
+/// # Errors
+/// The flag without a value, or a value that is not a port number.
+pub fn port_from(args: &[String], env: Option<&str>) -> Result<Option<u16>, String> {
+    let flag = args.iter().enumerate().find_map(|(i, a)| {
+        if a == "--mcp-port" {
+            Some(args.get(i + 1).cloned())
+        } else {
+            a.strip_prefix("--mcp-port=").map(|v| Some(v.to_owned()))
+        }
+    });
+    let text = match flag {
+        Some(None) => return Err("--mcp-port needs a port number".into()),
+        Some(Some(v)) => v,
+        None => match env.map(str::trim).filter(|v| !v.is_empty()) {
+            Some(v) => v.to_owned(),
+            None => return Ok(None),
+        },
+    };
+    text.trim()
+        .parse::<u16>()
+        .map(Some)
+        .map_err(|_| format!("MCP port must be a number from 0 to 65535, got '{text}'"))
+}
+
+fn accept_loop(listener: &TcpListener, tx: &Sender<Request>, stop: &AtomicBool, wake: &Wake) {
+    while !stop.load(Ordering::Relaxed) {
+        match listener.accept() {
+            Ok((stream, peer)) => {
+                tracing::info!("mcp: client {peer} connected");
+                match serve_client(stream, tx, stop, wake) {
+                    Ok(()) => tracing::info!("mcp: client {peer} left"),
+                    Err(e) => tracing::warn!("mcp: client {peer} dropped: {e}"),
+                }
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => std::thread::sleep(POLL),
+            Err(e) => {
+                tracing::warn!("mcp: accept failed: {e}");
+                std::thread::sleep(POLL);
+            }
+        }
+    }
+}
+
+/// One client until it hangs up, the app stops, or the app's end of
+/// the channel is gone.
+fn serve_client(stream: TcpStream, tx: &Sender<Request>, stop: &AtomicBool, wake: &Wake) -> std::io::Result<()> {
+    // An accepted socket may inherit the listener's non-blocking mode
+    // (BSD does); reads wait, but only a POLL at a time.
+    stream.set_nonblocking(false)?;
+    stream.set_read_timeout(Some(POLL))?;
+    let mut writer = stream.try_clone()?;
+    let mut reader = BufReader::new(stream);
+    let mut buf = Vec::new();
+    loop {
+        if stop.load(Ordering::Relaxed) {
+            return Ok(());
+        }
+        match reader.read_until(b'\n', &mut buf) {
+            Ok(0) => {
+                // End of input: a last unterminated line still counts,
+                // as it does on stdio.
+                if !buf.is_empty() {
+                    let line = std::mem::take(&mut buf);
+                    forward(&line, tx, &mut writer, stop, wake)?;
+                }
+                return Ok(());
+            }
+            Ok(_) if buf.ends_with(b"\n") => {
+                let line = std::mem::take(&mut buf);
+                if !forward(&line, tx, &mut writer, stop, wake)? {
+                    return Ok(());
+                }
+            }
+            // Bytes without a newline: the next read returns 0 (EOF).
+            Ok(_) => {}
+            Err(e)
+                if matches!(
+                    e.kind(),
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut | std::io::ErrorKind::Interrupted
+                ) => {}
+            Err(e) => return Err(e),
+        }
+        if buf.len() > MAX_LINE {
+            let refusal = r#"{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"message too long - the connection is closed"}}"#;
+            writeln!(writer, "{refusal}")?;
+            writer.flush()?;
+            return Ok(());
+        }
+    }
+}
+
+/// Hand one line to the owning thread and write its answer. `Ok(false)`
+/// when the session cannot go on (the app is stopping or gone).
+fn forward(bytes: &[u8], tx: &Sender<Request>, writer: &mut TcpStream, stop: &AtomicBool, wake: &Wake) -> std::io::Result<bool> {
+    let line = String::from_utf8_lossy(bytes).into_owned();
+    if line.trim().is_empty() {
+        return Ok(true);
+    }
+    let (request, answer) = Request::pair(line);
+    if tx.send(request).is_err() {
+        tracing::info!("mcp: the app closed its end; ending the session");
+        return Ok(false);
+    }
+    wake();
+    loop {
+        match answer.recv_timeout(POLL) {
+            Ok(Some(reply)) => {
+                writeln!(writer, "{reply}")?;
+                writer.flush()?;
+                return Ok(true);
+            }
+            Ok(None) => return Ok(true),
+            Err(RecvTimeoutError::Timeout) => {
+                if stop.load(Ordering::Relaxed) {
+                    return Ok(false);
+                }
+            }
+            Err(RecvTimeoutError::Disconnected) => {
+                tracing::warn!("mcp: a request was dropped unanswered");
+                return Ok(true);
+            }
+        }
+    }
+}
diff --git a/crates/app/src/mcp/live.rs b/crates/app/src/mcp/live.rs
new file mode 100644
index 00000000..19f7f812
--- /dev/null
+++ b/crates/app/src/mcp/live.rs
@@ -0,0 +1,72 @@
+//! The live seam (#183): one MCP wire line answered against a document
+//! the caller already owns - the GUI's world and its command History -
+//! instead of the headless session's own. Same tool table, same
+//! dispatch, same commands: an agent's step lands on the app's own
+//! History, so the app's Ctrl+Z undoes it like any user step.
+//!
+//! Provenance: our own seam over this module's JSON-RPC handler
+//! (JSON-RPC 2.0 framed as the public MCP specification, 2025-06-18).
+//! Clean-room, public sources only.
+
+use super::{tool_err, Server};
+use crate::commands::History;
+use crate::script::Env;
+
+use flecs_ecs::prelude::World;
+use serde_json::{json, Value};
+use std::path::Path;
+
+/// Tools the live session refuses, with the reason an agent reads. The
+/// app owns these: opening a file over the user's document skips the
+/// app's unsaved-changes prompt and its per-document reset.
+const LIVE_REFUSED: &[(&str, &str)] = &[(
+    "open_project",
+    "open_project is not available in a live app session - it would replace the user's document \
+without the app's unsaved-changes prompt; ask the user to open the file (File > Open)",
+)];
+
+/// What one live line did.
+#[derive(Debug, Default)]
+pub struct LiveAnswer {
+    /// The wire answer, `None` for a notification.
+    pub reply: Option<String>,
+    /// The tool a `tools/call` named, when the line was one: the document
+    /// may have changed (a read-only tool too - the caller refreshes its
+    /// views, which is cheap and never wrong).
+    pub tool: Option<String>,
+}
+
+/// Answer one wire line against `world` and `history`. `doc_path` is
+/// the file the app has open, so a bare `save_project` saves over it the
+/// way the app's Ctrl+S does. The world is shared by handle (a flecs
+/// world clone is a reference, not a copy); the history is lent for the
+/// call and handed back whatever happens - a refused or failed tool
+/// included.
+pub fn answer_live(world: &World, history: &mut History, doc_path: Option<&Path>, line: &str) -> LiveAnswer {
+    let parsed = serde_json::from_str::<Value>(line.trim()).ok();
+    let tool = parsed
+        .as_ref()
+        .filter(|m| m.get("method").and_then(Value::as_str) == Some("tools/call"))
+        .and_then(|m| m.get("params")?.get("name")?.as_str().map(str::to_owned));
+    if let (Some(msg), Some(name)) = (&parsed, &tool)
+        && let Some((_, why)) = LIVE_REFUSED.iter().find(|(n, _)| n == name)
+        && let Some(id) = msg.get("id")
+    {
+        let reply = json!({ "jsonrpc": "2.0", "id": id, "result": tool_err(why) });
+        return LiveAnswer { reply: Some(reply.to_string()), tool: None };
+    }
+    let mut server = Server {
+        env: Env {
+            world: world.clone(),
+            history: std::mem::take(history),
+            logs: Vec::new(),
+            errors: Vec::new(),
+            doc_path: doc_path.map(Path::to_path_buf),
+            posted: None,
+            last_value: Value::Null,
+        },
+    };
+    let reply = server.handle_line(line);
+    *history = std::mem::take(&mut server.env.history);
+    LiveAnswer { reply, tool }
+}
