diff --git a/crates/ui/src/egui_app/setup_axis_pick.rs b/crates/ui/src/egui_app/setup_axis_pick.rs
new file mode 100644
index 00000000..333cf4bd
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_axis_pick.rs
@@ -0,0 +1,128 @@
+//! The Setups page's "Axes in the plane" rows (#557): set the part's +Y
+//! and/or +X in the work plane from a straight edge or two points picked
+//! in the viewport, flip either, choose which one wins when both are
+//! picked, and Apply. The pick draft is view state (`crate::axis_pick`);
+//! Apply queues `CommandKind::TurnPartInPlane`, the undoable
+//! `AlignPartToSetup`. The app says whether the picks make a turn and,
+//! if not, why - shown on the disabled Apply. The work offset is not
+//! touched.
+//!
+//! Provenance: our own UI over plain fixture practice (indicate an edge
+//! along the table's travel); no vendor material consulted.
+
+use egui::{RichText, Ui};
+
+use camcraft_app::commands::AlignPartToSetup;
+use camcraft_app::pick::{self, InPlaneAxis};
+
+use crate::axis_pick::{self, AxisBy};
+use crate::state::{CommandKind, State};
+
+/// The rows of one setup.
+pub(super) fn rows(ui: &mut Ui, state: &mut State, setup: &str) {
+    ui.label("    Axes in the plane - pick an edge or two points for +Y and/or +X");
+    for axis in [InPlaneAxis::Y, InPlaneAxis::X] {
+        axis_row(ui, state, setup, axis);
+    }
+    let Some(d) = state.axis_pick.as_ref().filter(|d| d.setup == setup).cloned() else { return };
+    let axes = d.wanted();
+    if axes.y.is_none() && axes.x.is_none() {
+        return;
+    }
+    // The command's own check: a refused pick, or one that gives the
+    // alignment the setup already holds, greys Apply out with the why.
+    let check = AlignPartToSetup::check_turn(&state.world, setup, &axes).map_err(|e| e.to_string());
+    let turn = pick::in_plane_turn_deg(&state.world, setup, &axes).ok();
+    ui.horizontal(|ui| {
+        ui.label("      Primary");
+        let mut primary = d.axes.primary;
+        for axis in [InPlaneAxis::Y, InPlaneAxis::X] {
+            ui.radio_value(&mut primary, axis, axis.label())
+                .on_hover_text("With both axes picked, this one is kept exactly; the other is made square to it.");
+        }
+        if primary != d.axes.primary {
+            axis_pick::draft_for(state, setup).axes.primary = primary;
+        }
+        let tip = match &check {
+            Ok(()) => "Turn the part about Z so the picks run along their axes.".to_owned(),
+            Err(why) => why.clone(),
+        };
+        if ui
+            .add_enabled(check.is_ok(), egui::Button::new("Apply axes"))
+            .on_hover_text(&tip)
+            .on_disabled_hover_text(&tip)
+            .clicked()
+        {
+            state.pending.push_back(CommandKind::TurnPartInPlane { setup: setup.to_owned(), axes: axes.clone() });
+        }
+        if ui.button("Clear axes").on_hover_text("Drop the axis picks.").clicked() {
+            state.axis_pick = None;
+        }
+    });
+    let words = match (turn, &check) {
+        (_, Err(why)) => why.clone(),
+        (Some(deg), Ok(())) => format!("turns the part {} about Z", deg_words(deg)),
+        (None, Ok(())) => String::new(),
+    };
+    if !words.is_empty() {
+        ui.label(RichText::new(format!("      {words}")).weak());
+    }
+}
+
+fn deg_words(deg: f64) -> String {
+    let r = (deg * 1000.0).round() / 1000.0;
+    format!("{}°", if r == 0.0 { 0.0 } else { r })
+}
+
+/// One axis: what it is picked by, the pick toggle, flip, and the picks.
+fn axis_row(ui: &mut Ui, state: &mut State, setup: &str, axis: InPlaneAxis) {
+    let draft = state.axis_pick.as_ref().filter(|d| d.setup == setup);
+    let by = draft.map_or(AxisBy::Edge, |d| d.by(axis));
+    let armed = draft.is_some_and(|d| d.picking == Some(axis));
+    let slot = draft.and_then(|d| match axis {
+        InPlaneAxis::Y => d.axes.y.clone(),
+        InPlaneAxis::X => d.axes.x.clone(),
+    });
+    let picks = slot.as_ref().map(|s| s.picks.clone()).unwrap_or_default();
+    let mut flip = slot.is_some_and(|s| s.flip);
+    let name = axis.label();
+    ui.horizontal(|ui| {
+        ui.label(format!("      {name}"));
+        for (b, text) in [(AxisBy::Edge, "Edge"), (AxisBy::Points, "Two points")] {
+            if ui
+                .selectable_label(by == b, format!("{name} by {text}"))
+                .on_hover_text(format!("Set {name} from {}.", b.noun()))
+                .clicked()
+                && by != b
+            {
+                axis_pick::set_by(state, setup, axis, b);
+            }
+        }
+        let what = match by {
+            AxisBy::Edge => "edge",
+            AxisBy::Points => "points",
+        };
+        let text = if armed { format!("Stop picking {name}") } else { format!("Pick {name} {what}") };
+        if ui
+            .selectable_label(armed, text)
+            .on_hover_text(format!("Click {} in the viewport; it runs along {name}.", by.noun()))
+            .clicked()
+        {
+            if armed {
+                axis_pick::disarm(state);
+            } else {
+                axis_pick::arm(state, setup, axis);
+            }
+        }
+        if ui
+            .checkbox(&mut flip, format!("Flip {name}"))
+            .on_hover_text("Take the pick the other way (end to start).")
+            .changed()
+        {
+            axis_pick::draft_for(state, setup).slot(axis).flip = flip;
+        }
+        let words: Vec<String> = picks.iter().map(|g| format!("{} of '{}'", g.feature, g.entity)).collect();
+        let text = if words.is_empty() { "nothing picked".to_owned() } else { words.join(", ") };
+        ui.label(RichText::new(text).weak());
+    });
+}
diff --git a/crates/ui/src/egui_app/setup_axis_tests.rs b/crates/ui/src/egui_app/setup_axis_tests.rs
new file mode 100644
index 00000000..a773f2f1
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_axis_tests.rs
@@ -0,0 +1,181 @@
+//! #557 in the surface: the Setups page's "Axes in the plane" rows arm
+//! the axis draft (Edge mode for an edge, Vertex mode for two points), a
+//! pick lands in the draft (never in an operation), a face is refused by
+//! name, Apply queues `TurnPartInPlane` and the drain lands it as one
+//! undo unit. The work offset is not touched.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::{NodeT, Queryable};
+use egui_kittest::Harness;
+
+use camcraft_app::commands::ImportModel;
+use camcraft_app::geometry::{Point3, cube, feature, quat_rotate_point};
+use camcraft_app::model;
+use camcraft_app::operation::{FeatureSel, GeoSel};
+use camcraft_app::pick::InPlaneAxis;
+use camcraft_app::setup_align;
+
+use crate::axis_pick::AxisBy;
+use crate::state::{CommandKind, GeoPick, State};
+
+fn with_part() -> State {
+    let mut state = State::new();
+    let part = ImportModel::from_mesh("part", cube(Point3::new(0.0, 0.0, 0.0), Point3::new(20.0, 20.0, 10.0)));
+    state.history.execute(&state.world, part);
+    state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    state.drain_actions();
+    state
+}
+
+fn features(state: &State) -> std::sync::Arc<feature::Features> {
+    let e = model::find_by_name(&state.world, "part").expect("part");
+    model::features_of(&state.world, &e).expect("features")
+}
+
+/// The top front edge (local y = 0, z = 10), and its walk direction.
+fn front_top_edge(state: &State) -> (GeoSel, [f64; 3]) {
+    let f = features(state);
+    let (id, p) = feature::chains(&f)
+        .into_iter()
+        .find_map(|c| {
+            let p = feature::chain_points(&f, &c);
+            (p.len() == 2 && p.iter().all(|q| q[1] == 0.0 && q[2] == 10.0)).then_some((c.id, p))
+        })
+        .expect("a top edge");
+    (GeoSel { entity: "part".into(), feature: FeatureSel::Chain(id) }, [p[1][0] - p[0][0], 0.0, 0.0])
+}
+
+fn corner(state: &State, p: [f64; 3]) -> GeoSel {
+    let f = features(state);
+    let id = feature::corner_verts(&f)
+        .into_iter()
+        .find(|&vi| f.verts.get(vi as usize).is_some_and(|v| *v == p))
+        .and_then(|vi| feature::vertex_id(&f, vi))
+        .expect("a corner");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Vertex(id) }
+}
+
+fn top_face(state: &State) -> GeoSel {
+    let id = features(state).faces.iter().find(|f| f.normal[2] > 0.99).map(|f| f.id).expect("the top");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Face(id) }
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_axis_pick::rows(ui, st, "Setup1");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+/// A local direction of the part as Setup1 holds it.
+fn held_dir(state: &State, d: [f64; 3]) -> Option<[f64; 3]> {
+    let a = setup_align::stored(&state.world, "Setup1")?;
+    let v = quat_rotate_point(a.rot, Point3::new(d[0], d[1], d[2]));
+    let l = (v.x * v.x + v.y * v.y + v.z * v.z).sqrt();
+    Some([v.x / l, v.y / l, v.z / l])
+}
+
+fn harness() -> Harness<'static, State> {
+    let mut h = Harness::builder().with_size(Vec2::new(1000.0, 300.0)).build_ui_state(frame, with_part());
+    h.run();
+    h
+}
+
+fn apply_disabled(h: &Harness<'static, State>) -> bool {
+    h.get_by_label("Apply axes").accesskit_node().is_disabled()
+}
+
+#[test]
+fn an_edge_picked_for_y_turns_the_part_through_the_command_and_undoes() {
+    let mut h = harness();
+    assert!(h.state().pending.is_empty(), "drawing the rows queues nothing");
+    assert!(h.query_by_label_contains("pick an edge or two points").is_some(), "the rows say which pick they take");
+    h.get_by_label("Pick +Y edge").click();
+    h.run();
+    assert!(crate::axis_pick::collecting(h.state()), "the draft is armed");
+    assert_eq!(h.state().geo_pick, GeoPick::Edge, "an axis by edge picks edges");
+    // A face sets no direction: refused by name, nothing drafted.
+    let face = top_face(h.state());
+    crate::axis_pick::take(h.state_mut(), face);
+    assert!(h.state().status.contains("a face sets no direction"), "{}", h.state().status);
+    let (edge, d) = front_top_edge(h.state());
+    crate::axis_pick::take(h.state_mut(), edge);
+    h.run();
+    assert!(h.state().op_ui.geo.is_empty(), "a draft pick is not an operation pick");
+    assert!(h.query_by_label_contains("turns the part").is_some(), "the turn is shown before Apply");
+    assert!(!apply_disabled(&h));
+    h.get_by_label("Apply axes").click();
+    h.run();
+    let v = held_dir(h.state(), d).expect("Setup1 holds the part turned");
+    assert!((v[1] - 1.0).abs() < 1e-9, "the edge runs along +Y: {v:?}");
