+        yaw_deg: 0.0,
+    });
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("catalog tool");
+    state.pending.push_back(CommandKind::AddTool { name: TOOL.into(), tool });
+    state.drain_actions();
+    state.history.execute(
+        &state.world,
