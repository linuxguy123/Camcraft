From c9198785b8932d6e4091f8274b0c8236508ae594 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Tue, 17 Nov 2026 15:35:25 +0100
Subject: [PATCH 1/2] fix(post): refuse a Sinumerik G83 dwell that no public
 manual verifies

The Sinumerik post wrote P<ms> on its ISO-form G83. Siemens' published
SINUMERIK 840D sl ISO Milling manual gives G83 with no P word, so the
post now refuses a positive G83 dwell by name before it writes the
cycle. A G83 without a dwell and the G82 dwell do not change.

Fixes #2349

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 assets/posts/sinumerik.cps                 |   8 ++
 crates/post/tests/sinumerik_g83_dwell.rs   | 106 +++++++++++++++++++++
 docs/decisions/2349-sinumerik-g83-dwell.md |  34 +++++++
 3 files changed, 148 insertions(+)
 create mode 100644 crates/post/tests/sinumerik_g83_dwell.rs
 create mode 100644 docs/decisions/2349-sinumerik-g83-dwell.md

diff --git a/assets/posts/sinumerik.cps b/assets/posts/sinumerik.cps
index 320cee607..a7fb5fa74 100644
--- a/assets/posts/sinumerik.cps
+++ b/assets/posts/sinumerik.cps
@@ -715,6 +715,14 @@ function onCycle() {
     msg("canned cycle G86 (bore) has no dwell word on this control - a " + (ms / 1000) + " s dwell is refused, not dropped; set the dwell to 0");
     return;
   }
+  // #2349: Siemens' published SINUMERIK 840D sl ISO Milling programming
+  // manual gives G83 (deep hole, chip removal) as X Y Z R Q F K, with no
+  // P. A dwell word is not verified for this form, so a G83 dwell is
+  // refused by name before any line of the cycle is written.
+  if (g === "G83" && has(p.P) && p.P > 0) {
+    msg("canned cycle G83 (deep peck) dwell is not supported by this post - a " + p.P + " s dwell is refused, not dropped; set the dwell to 0");
+    return;
+  }
   if (spindleStopped("canned cycle " + g)) return;
   if (!xyFirst(p.X, p.Y, p.R, false)) return;  // #1633: refused - the move is not written
   cycleSeat(p);
diff --git a/crates/post/tests/sinumerik_g83_dwell.rs b/crates/post/tests/sinumerik_g83_dwell.rs
new file mode 100644
index 000000000..a8c94a02e
--- /dev/null
+++ b/crates/post/tests/sinumerik_g83_dwell.rs
@@ -0,0 +1,106 @@
+//! Sinumerik G83 dwell refusal, from Siemens' published SINUMERIK 840D sl ISO Milling manual (#2349).
+//! Gate map: covers assets/posts/sinumerik.cps, camcraft_post::post::engine
+//! and camcraft_post::post::cnc.
+
+use camcraft_post::cl::{CycleKind, MoveKind};
+use camcraft_post::post::{
+    cnc::{self, CycleRec, MoveRec, Record},
+    engine,
+};
+use serde_json::json;
+use std::path::Path;
+
+fn read(rel: &str) -> String {
+    std::fs::read_to_string(Path::new(env!("CARGO_MANIFEST_DIR")).join("../../").join(rel))
+        .expect("fixture")
+}
+
+fn stream(kind: CycleKind, dwell: f64) -> String {
+    let records = vec![
+        Record::Param { name: "SpindleSpeed".into(), value: json!(900.0) },
+        Record::Param { name: "ClearancePlane".into(), value: json!(10.0) },
+        Record::Param { name: "RetractPlane".into(), value: json!(10.0) },
+        Record::Tool { number: 4, name: "DRILL".into() },
+        Record::Section { begin: true },
+        Record::Move(MoveRec {
+            kind: MoveKind::Rapid,
+            x: 10.0,
+            y: 10.0,
+            z: 2.0,
+            feed: None,
+            center: None,
+            ccw: false,
+            plane: Default::default(),
+            abc: None,
+        }),
+        Record::Cycle(CycleRec {
+            kind,
+            x: 10.0,
+            y: 10.0,
+            r_z: 2.0,
+            bottom_z: -12.0,
+            entry_z: 0.0,
+            peck: 3.0,
+            dwell,
+            first_move: 1,
+            feed: Some(120.0),
+        }),
+        Record::Section { begin: false },
+    ];
+    cnc::serialize(&records)
+}
+
+fn run(kind: CycleKind, dwell: f64) -> engine::PostOutput {
+    let machine = serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("machine");
+    engine::run(&read("assets/posts/sinumerik.cps"), &machine, &stream(kind, dwell))
+        .expect("post engine")
+}
+
+fn lines_with<'a>(program: &'a str, word: &str) -> Vec<&'a str> {
+    program
+        .lines()
+        .filter(|line| line.split_whitespace().any(|w| w == word))
+        .collect()
+}
+
+#[test]
+fn sinumerik_refuses_g83_dwell() {
+    // The stream carries whole ms: 0.001 s is the smallest dwell it holds.
+    for dwell in [0.001, 0.5] {
+        let out = run(CycleKind::Deep, dwell);
+        assert!(
+            out.warnings.iter().any(|w| w.contains("G83") && w.contains("dwell")),
+            "G83 dwell {dwell} must be refused by name: {:?}",
+            out.warnings
+        );
+        assert!(
+            lines_with(&out.program, "G83").is_empty(),
+            "a refused G83 must not be written:\n{}",
+            out.program
+        );
+    }
+}
+
+#[test]
+fn sinumerik_g83_without_dwell_is_unchanged() {
+    let out = run(CycleKind::Deep, 0.0);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let lines = lines_with(&out.program, "G83");
+    assert_eq!(lines.len(), 1, "{}", out.program);
+    assert!(
+        !lines[0].split_whitespace().any(|w| w.starts_with('P')),
+        "G83 must carry no P word: {}",
+        lines[0]
+    );
+    assert!(lines[0].split_whitespace().any(|w| w == "Q3"), "{}", lines[0]);
+}
+
+#[test]
+fn sinumerik_g82_dwell_still_posts() {
+    // The refusal is G83 only: a spot-drill dwell keeps its G82 P word.
+    let out = run(CycleKind::Drill, 0.5);
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let lines = lines_with(&out.program, "G82");
+    assert_eq!(lines.len(), 1, "{}", out.program);
+    assert!(lines[0].split_whitespace().any(|w| w == "P500"), "{}", lines[0]);
+}
