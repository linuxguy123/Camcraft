  {
    "sha": "e6c1c121686c8adf758a5dd0638a4c2310ab69b1",
    "node_id": "C_kwDOVVonwNoAKGU2YzFjMTIxNjg2YzhhZGY3NThhNWRkMDYzOGE0YzIzMTBhYjY5YjE",
    "commit": {
      "author": {
        "name": "NeoTech",
        "email": "andreas@roughedge.se",
        "date": "2026-11-17T14:50:12Z"
