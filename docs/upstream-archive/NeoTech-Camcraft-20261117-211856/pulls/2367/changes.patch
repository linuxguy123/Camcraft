+    assert_eq!(helices, 2, "one helix per level: {:?}", t.notes);
+    assert_eq!(landed.len(), 2, "each helix ends: {landed:?}");
+    for (z, want) in landed.iter().zip([-2.0, -4.0]) {
+        assert!((z - want).abs() < 1e-6, "the helices land on -2 and -4: {landed:?}");
