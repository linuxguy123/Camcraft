+//! The playback keyframe store (#2181): snapshots of the cut stock at
+//! a fixed move stride, kept within a count cap and, once a calculation
+//! before playback asks for one, a byte budget. Provenance: plain
+//! periodic snapshotting with keyframe thinning (halve the keyframes,
+//! double the stride) for the memory bound; the order-free field
+//! subtraction (any prefix of the program is cut exactly by its own
+//! moves) makes each kept keyframe exact. Nothing from vendor binaries.
+//!
+//! ## The laws here
+//!
+//! - **Display only.** The keyframes are the playback picture's
+//!   checkpoints and nothing else reads them. The Deviate verdict and
+//!   the checks that block the post are walked elsewhere, unchanged.
+//! - **One insertion path.** Every keyframe enters through `offer`, the
+//!   calculation's and the live playback's alike, so the count cap and
+//!   the byte budget hold whoever cuts (the #2192 review: a live seek
+//!   after a cancel once added keyframes past the budget).
+//! - **Memory is bounded by a budget, never by the program.** With a
+//!   budget, the kept keyframes' bytes are summed as they are offered;
+//!   past the budget every other keyframe goes and the stride doubles,
+//!   so the store never holds more than the budget (at worst only the
+//!   uncut stock, which is key 0 and is never thinned).
+//! - **Incomplete is said, never shown as done.** A cancelled or failed
+//!   calculation is `Precalc::Incomplete` by name; the keyframes it made
+//!   stay valid (each is an exact prefix) and the moves past them are
+//!   cut live.
+
+use crate::stock_sim::{SdfField, Stock};
+
+/// The keyframe store's memory budget: 512 MiB of cut layers.
+pub const PRECALC_BUDGET: usize = 512 << 20;
+
+/// Keyframes at most in a calculation: its stride is at least the
+/// program over this.
+pub const MAX_KEYFRAMES: usize = 1024;
+
+/// Where the calculation before playback stands.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Precalc {
+    /// Not asked: playback cuts as the playhead moves.
+    Off,
+    /// Cutting: `done` of `total` moves have keyframes behind them.
+    Running { done: usize, total: usize },
+    /// Every move is calculated: a seek cuts at most `stride` moves.
+    Ready { keys: usize, bytes: usize, stride: usize, secs: f64 },
+    /// Stopped at `done` of `total` moves, and why: past `done` the
+    /// playback cuts live.
+    Incomplete { done: usize, total: usize, why: String },
+}
+
+/// What one kept keyframe costs, in bytes.
+pub trait KeyCost {
+    /// The bytes a clone of this value holds of its own.
+    fn key_bytes(&self) -> usize;
+}
+
+impl KeyCost for Stock {
+    /// A clone copies the cut layers only (the mesh layer is shared).
+    fn key_bytes(&self) -> usize {
+        self.field().map_or(0, SdfField::cut_layer_bytes)
+    }
+}
+
+/// The keyframes: `(moves cut, the value after them)`, ascending; key 0
+/// is the uncut value and always stays.
+#[derive(Clone, Debug)]
+pub struct Keyframes<T> {
+    keys: Vec<(usize, T)>,
+    stride: usize,
+    /// Keyframes past key 0 at most.
+    cap: usize,
+    /// The byte budget, once a calculation set one.
+    budget: Option<usize>,
+    /// Bytes the kept keyframes hold.
+    bytes: usize,
+}
+
+impl<T: KeyCost + Clone> Keyframes<T> {
+    /// The uncut value alone, a stride, a count cap and no byte budget.
+    pub fn new(uncut: T, stride: usize, cap: usize) -> Self {
+        Keyframes { keys: vec![(0, uncut)], stride: stride.max(1), cap, budget: None, bytes: 0 }
+    }
+
+    /// Back to the uncut value with a new stride, count cap and byte
+    /// budget (the calculation's start); the budget stays from here on.
+    pub fn restart(&mut self, stride: usize, cap: usize, budget: usize) {
+        self.keys.truncate(1);
+        self.stride = stride.max(1);
+        self.cap = cap;
+        self.budget = Some(budget);
+        self.bytes = 0;
+    }
+
+    /// The stride, in moves.
+    #[must_use]
+    pub const fn stride(&self) -> usize {
+        self.stride
+    }
+
+    /// Keyframes held, key 0 included.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        self.keys.len()
+    }
+
+    /// Never true: key 0 always stays.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.keys.is_empty()
+    }
+
+    /// Bytes the kept keyframes hold (within the budget, when set).
+    #[must_use]
+    pub const fn bytes(&self) -> usize {
+        self.bytes
+    }
+
+    /// The bytes the kept keyframes hold, summed again from them: the
+    /// audit of `bytes` (a walk over the keys; not for a frame loop).
+    #[must_use]
+    pub fn held_bytes(&self) -> usize {
+        self.keys.iter().map(|(_, s)| s.key_bytes()).fold(0, usize::saturating_add)
+    }
+
+    /// The byte budget, once a calculation set one.
+    #[must_use]
+    pub const fn budget(&self) -> Option<usize> {
+        self.budget
+    }
+
+    /// The newest keyframe at or before `k`.
+    #[must_use]
+    pub fn floor(&self, k: usize) -> Option<&(usize, T)> {
+        self.keys.iter().rev().find(|(n, _)| *n <= k)
+    }
+
+    /// The move index of `floor(k)` (0 when none is nearer).
+    #[must_use]
+    pub fn floor_at(&self, k: usize) -> usize {
+        self.floor(k).map_or(0, |c| c.0)
+    }
+
+    /// The first stride boundary past `at`, clamped to `total`.
+    #[must_use]
+    pub fn next_boundary(&self, at: usize, total: usize) -> usize {
+        (at / self.stride).saturating_add(1).saturating_mul(self.stride).min(total)
+    }
+
+    /// Keep `value` as the keyframe at move `at`, when it is past the
+    /// last one and the count cap has room; then thin to the budget.
+    /// `true` when it was kept and survived the thinning.
+    pub fn offer(&mut self, at: usize, value: &T) -> bool {
+        let last = self.keys.last().map_or(0, |c| c.0);
+        if at <= last || self.keys.len() > self.cap {
+            return false;
+        }
+        self.bytes = self.bytes.saturating_add(value.key_bytes());
+        self.keys.push((at, value.clone()));
+        if let Some(budget) = self.budget {
+            while self.bytes > budget && self.keys.len() > 1 {
+                self.thin();
+            }
+        }
+        self.keys.last().is_some_and(|c| c.0 == at)
+    }
+
+    /// Halve the keyframes: double the stride and keep only those on it.
+    fn thin(&mut self) {
+        self.stride = self.stride.saturating_mul(2).max(1);
+        let stride = self.stride;
+        self.keys.retain(|(n, _)| n % stride == 0);
+        self.bytes = self.held_bytes();
+    }
+}
diff --git a/crates/sim/src/play_precalc.rs b/crates/sim/src/play_precalc.rs
new file mode 100644
index 000000000..e5d03d75f
--- /dev/null
+++ b/crates/sim/src/play_precalc.rs
@@ -0,0 +1,84 @@
+//! The calculation before playback (#2181): cut the whole program once,
+//! stride by stride, keeping keyframes (`play_keys`), with a stop, a
+//! cancel and a progress report. Provenance: a plain cooperative work
+//! loop over our own playback cut; nothing from vendor binaries.
+//!
+//! ## The laws here
+//!
+//! - **Display only.** The loop drives the playback picture's cut and
+//!   nothing else; the verdict and the post gate never read it.
+//! - **Every end is said by name.** Each stride reports `Running`; the
+//!   end reports `Ready`, or `Incomplete` with "cancelled", "stopped"
+//!   or the cut's own refusal. No end is silent.
+//! - **A cancel keeps playback; a stop or a refusal ends it.** After a
+//!   cancel the keyframes made so far stay valid and the rest is cut
+//!   live; a stop is the owner going away; a refusal is published.
+
+use crate::play_keys::Precalc;
+
+/// The playback cut, as the calculation drives it.
+pub trait PrecalcCut {
+    /// Moves in the whole program.
+    fn total(&self) -> usize;
+    /// Moves the calculation has cut so far.
+    fn done(&self) -> usize;
+    /// Back to the uncut stock, keyframes and budget set.
+    fn begin(&mut self) -> Result<(), String>;
+    /// Cut one stride and offer its keyframe; `Ok(true)` at the end.
+    fn step(&mut self) -> Result<bool, String>;
+    /// The finished store's reading, `secs` after the start.
+    fn ready(&self, secs: f64) -> Precalc;
+}
+
+/// How the calculation ended.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum PrecalcEnd {
+    /// Ready, or cancelled: playback goes on.
+    Play,
+    /// The owner stopped: playback ends, nothing to publish.
+    Stopped,
+    /// The cut refused: playback ends and the refusal is published.
+    Refused(String),
+}
+
+/// The owner's side of the loop: what it asks and where it hears.
+pub trait PrecalcOwner {
+    /// The owner went away (the worker is dropped).
+    fn stopped(&self) -> bool;
+    /// The user cancelled the calculation.
+    fn cancelled(&self) -> bool;
+    /// Seconds since the start (the owner holds the clock).
+    fn elapsed(&self) -> f64;
+    /// The calculation's state, after each change.
+    fn report(&self, p: Precalc);
+}
+
+/// Run the calculation to an end (the module law).
+pub fn drive(cut: &mut impl PrecalcCut, owner: &impl PrecalcOwner) -> PrecalcEnd {
+    let total = cut.total();
+    if let Err(e) = cut.begin() {
+        owner.report(Precalc::Incomplete { done: 0, total, why: e.clone() });
+        return PrecalcEnd::Refused(e);
+    }
+    loop {
+        if owner.stopped() {
+            owner.report(Precalc::Incomplete { done: cut.done(), total, why: "stopped".into() });
+            return PrecalcEnd::Stopped;
+        }
+        if owner.cancelled() {
+            owner.report(Precalc::Incomplete { done: cut.done(), total, why: "cancelled".into() });
+            return PrecalcEnd::Play;
+        }
+        match cut.step() {
+            Ok(true) => {
+                owner.report(cut.ready(owner.elapsed()));
+                return PrecalcEnd::Play;
+            }
+            Ok(false) => owner.report(Precalc::Running { done: cut.done(), total }),
+            Err(e) => {
+                owner.report(Precalc::Incomplete { done: cut.done(), total, why: e.clone() });
+                return PrecalcEnd::Refused(e);
+            }
+        }
+    }
+}
diff --git a/crates/sim/tests/play_keys.rs b/crates/sim/tests/play_keys.rs
new file mode 100644
index 000000000..3a40f5973
--- /dev/null
+++ b/crates/sim/tests/play_keys.rs
@@ -0,0 +1,143 @@
+//! #2181 / #2192 review: the playback keyframe store and the
+//! calculation before playback, on plain values. Every insertion counts
+//! against the budget (the calculation's and the live playback's), the
+//! thinning doubles the stride, and every end of the calculation is
+//! said by name. Provenance: our own fixtures; nothing from vendor
+//! binaries.
+//!
+//! Gate map (M4.4): covers camcraft_sim::play_keys, camcraft_sim::play_precalc.
+
+use std::cell::{Cell, RefCell};
+
+use camcraft_sim::play_keys::{KeyCost, Keyframes, Precalc};
+use camcraft_sim::play_precalc::{drive, PrecalcCut, PrecalcEnd, PrecalcOwner};
+
+/// A keyframe that costs its own number of bytes.
+#[derive(Clone, Debug)]
+struct Key(usize);
+
+impl KeyCost for Key {
+    fn key_bytes(&self) -> usize {
+        self.0
+    }
+}
+
+#[test]
+fn without_a_budget_the_count_cap_alone_holds() {
+    let mut k = Keyframes::new(Key(0), 4, 2);
+    assert!(k.offer(4, &Key(10)) && k.offer(8, &Key(10)));
+    assert!(!k.offer(12, &Key(10)), "the cap of 2 keyframes past key 0 is full");
+    assert!(!k.offer(8, &Key(10)), "a keyframe at or before the last one is refused");
+    assert_eq!((k.len(), k.bytes(), k.held_bytes(), k.stride()), (3, 20, 20, 4));
+    assert_eq!((k.floor_at(11), k.floor_at(3), k.next_boundary(5, 7)), (8, 0, 7));
+}
+
+#[test]
+fn a_budget_thins_every_insertion_from_then_on() {
+    let mut k = Keyframes::new(Key(0), 1, 32);
+    k.restart(1, 1024, 25);
+    // The callers offer on the stride, as the live seek does.
+    for at in 1..=40 {
+        if at % k.stride() != 0 {
+            continue;
+        }
+        k.offer(at, &Key(10));
+        assert_eq!(k.bytes(), k.held_bytes(), "at {at}: each kept keyframe is counted");
+        assert!(k.bytes() <= 25, "at {at}: {} bytes over the budget", k.bytes());
+    }
+    assert!(k.stride() > 1 && k.len() > 1, "thinning doubled the stride: {} keys, stride {}", k.len(), k.stride());
+    assert_eq!(k.floor_at(0), 0, "key 0 stays");
+}
+
+#[test]
+fn a_zero_budget_keeps_only_key_zero() {
+    let mut k = Keyframes::new(Key(0), 2, 32);
+    k.restart(2, 1024, 0);
+    for at in (2..=20).step_by(2) {
+        assert!(!k.offer(at, &Key(1)));
+    }
+    assert_eq!((k.len(), k.bytes()), (1, 0));
+}
+
+/// A program of `total` moves cut `stride` at a time; `fail_at` refuses.
+struct Prog {
+    total: usize,
+    at: usize,
+    stride: usize,
+    fail_at: Option<usize>,
+}
+
+impl PrecalcCut for Prog {
+    fn total(&self) -> usize {
+        self.total
+    }
+    fn done(&self) -> usize {
+        self.at
+    }
+    fn begin(&mut self) -> Result<(), String> {
+        self.at = 0;
+        Ok(())
+    }
+    fn step(&mut self) -> Result<bool, String> {
+        if self.fail_at.is_some_and(|f| self.at >= f) {
+            return Err("refused".into());
+        }
+        self.at = (self.at + self.stride).min(self.total);
+        Ok(self.at >= self.total)
+    }
+    fn ready(&self, secs: f64) -> Precalc {
+        Precalc::Ready { keys: 1, bytes: 0, stride: self.stride, secs }
+    }
+}
+
+#[derive(Default)]
+struct Owner {
+    stop_after: Option<usize>,
+    cancel_after: Option<usize>,
+    reports: RefCell<Vec<Precalc>>,
+    asked: Cell<usize>,
+}
+
+impl PrecalcOwner for Owner {
+    fn stopped(&self) -> bool {
+        self.asked.set(self.asked.get() + 1);
+        self.stop_after.is_some_and(|n| self.asked.get() > n)
+    }
+    fn cancelled(&self) -> bool {
+        self.cancel_after.is_some_and(|n| self.asked.get() > n)
+    }
+    fn elapsed(&self) -> f64 {
+        0.5
+    }
+    fn report(&self, p: Precalc) {
+        self.reports.borrow_mut().push(p);
+    }
+}
+
+fn last(o: &Owner) -> Precalc {
+    o.reports.borrow().last().cloned().unwrap_or(Precalc::Off)
+}
+
+#[test]
+fn the_calculation_says_each_end_by_name() {
+    let mut p = Prog { total: 10, at: 0, stride: 3, fail_at: None };
+    let o = Owner::default();
+    assert_eq!(drive(&mut p, &o), PrecalcEnd::Play);
+    assert_eq!(last(&o), Precalc::Ready { keys: 1, bytes: 0, stride: 3, secs: 0.5 });
+    assert!(o.reports.borrow().iter().any(|r| matches!(r, Precalc::Running { done: 3, total: 10 })));
+
+    let mut p = Prog { total: 10, at: 0, stride: 3, fail_at: None };
+    let o = Owner { cancel_after: Some(1), ..Owner::default() };
+    assert_eq!(drive(&mut p, &o), PrecalcEnd::Play, "a cancel keeps playback");
+    assert_eq!(last(&o), Precalc::Incomplete { done: 3, total: 10, why: "cancelled".into() });
+
+    let mut p = Prog { total: 10, at: 0, stride: 3, fail_at: None };
+    let o = Owner { stop_after: Some(2), ..Owner::default() };
+    assert_eq!(drive(&mut p, &o), PrecalcEnd::Stopped);
+    assert_eq!(last(&o), Precalc::Incomplete { done: 6, total: 10, why: "stopped".into() });
+
+    let mut p = Prog { total: 10, at: 0, stride: 3, fail_at: Some(3) };
+    let o = Owner::default();
+    assert_eq!(drive(&mut p, &o), PrecalcEnd::Refused("refused".into()));
+    assert_eq!(last(&o), Precalc::Incomplete { done: 3, total: 10, why: "refused".into() });
+}
