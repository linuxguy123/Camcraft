From e354410a46352f05e45a56a92c342240b81c2233 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Tue, 17 Nov 2026 08:57:31 +0100
Subject: [PATCH] fix(cl): update move stats in headless_bin test for the
 regenerated golden

PR #2013 regenerated contour_disc_hole.cl without the air-level passes.
The test now expects the new counts.

Fixes #2332

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/cl/tests/headless_bin.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/cl/tests/headless_bin.rs b/crates/cl/tests/headless_bin.rs
index cccc1cf05..e88be9c46 100644
--- a/crates/cl/tests/headless_bin.rs
+++ b/crates/cl/tests/headless_bin.rs
@@ -46,7 +46,7 @@ fn cl_bin_prints_move_stats() {
     let o = run(&[p.as_os_str()]);
     let out = String::from_utf8_lossy(&o.stdout);
     assert!(o.status.success(), "{out}{}", String::from_utf8_lossy(&o.stderr));
-    assert!(out.contains("moves: 69 (rapid 12, feed 51, plunge 6, arcs 33)"), "{out}");
+    assert!(out.contains("moves: 46 (rapid 8, feed 34, plunge 4, arcs 22)"), "{out}");
     assert!(out.contains("chained: true"), "{out}");
 }
 
