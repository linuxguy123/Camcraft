 1 file changed, 28 insertions(+)

diff --git a/crates/motion/src/wire_edm/ruled_tests.rs b/crates/motion/src/wire_edm/ruled_tests.rs
index 31ed1754..97d1cac6 100644
--- a/crates/motion/src/wire_edm/ruled_tests.rs
+++ b/crates/motion/src/wire_edm/ruled_tests.rs
@@ -222,3 +222,31 @@ fn mismatched_profiles_and_steep_rulings_are_refused_by_name() {
     let why = refusal(&up, &lo, &WireRuled { tolerance: f64::NAN, ..r });
     assert!(why.contains("tolerance"), "{why}");
 }
+
+/// The die side: the wire runs inside both profiles of a conical
+/// opening, every ruling leaning by the cone's angle, and the widening
+/// is a constant taper's `1 / cos(angle)` - nothing more.
+#[test]
+fn a_conical_die_runs_inside_both_profiles() {
+    let (up, lo) = (round(8.0, 64), round(10.0, 64));
+    let p = WireParams { side: WireSide::Die, start: Some(Point2::new(-3.0, 0.0)), ..params() };
+    let path = wire_contour_ruled(
+        WireProfile { loops: std::slice::from_ref(&up), chains: &[] },
+        WireProfile { loops: std::slice::from_ref(&lo), chains: &[] },
+        &p,
+        &ruled(WirePairing::ArcLength),
+    )
+    .expect("a conical die generates");
+    let angle = (2.0f64 / H).atan();
+    let facet = (std::f64::consts::PI / 64.0).cos();
+    let wide = K / angle.cos() + 0.02;
+    for (l, u) in &rulings(&path) {
+        // Inside both profiles, by the kerf offset widened for the lean.
+        let (rl, ru) = (l.x.hypot(l.y), u.x.hypot(u.y));
+        assert!(rl < 10.0 - K && ru < 8.0 - K, "{rl} {ru}");
+        assert!(rl > 10.0 * facet - wide && ru > 8.0 * facet - wide, "{rl} {ru}");
+    }
+    let cut = &path.moves[..path.moves.len() - 1];
+    let lean = |a: [f64; 3]| a[0].hypot(a[1]).atan2(a[2]);
+    assert!(cut.iter().all(|m| m.axis.is_some_and(|a| (lean(a) - angle).abs() < 2e-3)), "every ruling leans the cone's angle");
+}

From 95f9467c60da52daacebd5dfc7380f0962d05cd6 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 05:38:30 -0800
Subject: [PATCH 11/12] feat(edm): wire taper by angle word - the control's
 corner rule as machine data

A wire EDM may state an angle-word taper dialect (edm.taper_angle: the
side a positive angle leans the top, and the corner rule mitre or cone,
each enumerated with no default) with edm.codes.taper_angle ({angle}).
The generator lays what the stated rule cuts - mitre is #536's path
byte for byte, cone pivots the wire about each top corner with its lean
held - so the wire laws judge the real lean and a corner the rule
gouges blocks the post. The post writes taper_on and the signed angle
word before the lead-in, X Y on the programmed (top) plane, no U/V, and
taper_off before the lead-out. An unstated rule, a machine stating
neither uv nor an angle word, and a 4-axis cut on an angle-word machine
are refused by name. U/V machines are byte-identical.

Fixes #1164

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
