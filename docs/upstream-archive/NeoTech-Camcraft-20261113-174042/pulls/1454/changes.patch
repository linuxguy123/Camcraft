Subject: [PATCH 2/6] test(xtask): pin the --no-snapshots wiring through gate()

Extract the pure tier_plan() that gate() uses for batch/release, and pin
that --no-snapshots on release drops the snapshot lanes through it.

Refs #1413

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 xtask/src/main.rs  | 12 ++++++++++--
 xtask/src/tests.rs | 15 ++++++++++++++-
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/xtask/src/main.rs b/xtask/src/main.rs
index e6d6b051..7e55f46f 100644
--- a/xtask/src/main.rs
+++ b/xtask/src/main.rs
@@ -212,9 +212,17 @@ fn gate(root: &Path, g: &GateArgs) -> Result<i32, String> {
                 }
             }
         }
-        "batch" => plan::batch(root),
-        _ => plan::release_with(root, !g.no_snapshots),
+        _ => tier_plan(root, g),
     };
     run.plan(&plan)?;
     Ok(run.summary())
 }
+
+/// The plan of a non-quick tier, pure (no cargo, no git): `gate()` runs exactly this, so the
+/// `--no-snapshots` wiring is pinned by `tests::gate_no_snapshots_reaches_the_release_plan`.
+pub(crate) fn tier_plan(root: &Path, g: &GateArgs) -> plan::Plan {
+    match g.tier.as_str() {
+        "batch" => plan::batch(root),
+        _ => plan::release_with(root, !g.no_snapshots),
+    }
+}
