+//! #548 (part of #290): a sinker EDM machine and a burn-to-depth op set
+//! up through the ui queue - the same commands the Machine window's
+//! Apply and the op page's Apply push - and undone step by step. The
+//! machine edit is validated at command creation (a blank orbit word is
+//! refused by the loader's law, the machine standing as it was). The
+//! pages themselves are pinned by the lib's `sinker_machine_tests`.
+//! Everything here is a SYNTHETIC fixture; not exercised on a real EDM
+//! control.
+//! Provenance: our own tests, specced from the issue's "Done means".
+//!
+//! Gate map (#548): covers ui::state, ui::egui_app::machine_edm_editor, app::machine, app::operation (sinker_op), app::tools.
+
+use camcraft_app::machine::{self, parse_mch};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SinkerBurnOp, SinkerDatum, SinkerPass, SrcRef};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::{Tool, ToolKind};
+use camcraft_ui::state::{CommandKind, State};
+
+const SINKER: &str = r#"{
+  "general": { "model": "SYNTH SINKER", "vendor": "Camcraft", "kind": "sinker_edm" },
+  "kinematics": { "default": {
+    "units": { "length": "mm", "angle": "degrees" },
+    "parts": [ { "id": "base", "name": "table", "type": "table", "parts": [
+      { "id": "x", "name": "X", "type": "linear", "parts": [ { "id": "y", "name": "Y", "type": "linear" } ] },
+      { "id": "z", "name": "Z", "type": "linear", "parts": [ { "id": "head", "name": "ram", "type": "head" } ] }
+    ] } ] } },
+  "edm": { "conditions": [ { "id": "S1", "name": "synthetic", "gap": 0.05, "undersize": 0.1, "role": "rough" } ] }
+}"#;
+
+fn electrode() -> Tool {
+    Tool {
+        kind: ToolKind::Electrode,
+        diameter: 10.0,
+        corner_r: 0.0,
+        tip_angle: 0.0,
+        pitch: 0.0,
+        nose_radius: 0.0,
+        width: 6.0,
+        flute_len: 30.0,
+        shank_d: 10.0,
+        shank_len: 15.0,
+        holder_d: 0.0,
+        holder_len: 0.0,
+        material_group: "graphite".into(),
+        rpm: 0.0,
+        feed: 50.0,
+        tool_material: None,
+        flutes: None,
+        center_cutting: true,
+        orientation: None,
+    }
+}
+
+fn burn() -> OpParams {
+    OpParams::SinkerBurn(SinkerBurnOp {
+        clearance_z: Height::fixed(25.0),
+        top_z: Height::fixed(20.0),
+        floor_z: Height::fixed(14.0),
+        datum: SinkerDatum::WorkTop,
+        depth: 6.0,
+        x: 0.0,
+        y: 0.0,
+        feed: 40.0,
+        condition: "S1".into(),
+        pass: SinkerPass::Single,
+        cavity_x: 0.0,
+        cavity_y: 0.0,
+    })
+}
+
+fn push(state: &mut State, c: CommandKind) {
+    state.pending.push_back(c);
+    state.drain_actions();
+}
+
+#[test]
+fn a_sinker_machine_and_a_burn_to_depth_are_set_up_and_undone() {
+    let mut state = State::new();
+    push(&mut state, CommandKind::SetStock { shape: StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, pos: [0.0; 3], yaw_deg: 0.0 });
+    let m = parse_mch(SINKER).expect("synthetic sinker");
+    push(&mut state, CommandKind::EditMachineApply { path: "synth.mch".into(), machine: Box::new(m.clone()) });
+    assert_eq!(machine::of(&state.world).1, Some(m.clone()), "{:?}", state.status);
+    push(&mut state, CommandKind::AddTool { name: "E-10x6".into(), tool: electrode() });
+    push(&mut state, CommandKind::CreateOperation { name: "Burn1".into(), tool: "E-10x6".into(), src: SrcRef::Stock, params: burn() });
+    assert_eq!(state.status, "operation Burn1 created", "a burn-to-depth enters the sinker");
+    assert!(model::find_by_name(&state.world, "Burn1").is_some());
+
+    // A machine edit the loader would refuse (an orbit with no word) is
+    // refused by name; the mounted machine stands.
+    let mut bad = m.clone();
+    bad.edm.as_mut().expect("edm").orbits.push(machine::OrbitWord { kind: "circular".into(), word: String::new() });
+    push(&mut state, CommandKind::EditMachineApply { path: "synth.mch".into(), machine: Box::new(bad) });
+    assert!(state.status.contains("machine edit refused"), "{:?}", state.status);
+    assert_eq!(machine::of(&state.world).1, Some(m.clone()));
+
+    // Undo walks it back: the op, the tool, the machine.
+    push(&mut state, CommandKind::Undo);
+    assert!(model::find_by_name(&state.world, "Burn1").is_none(), "undo removes the burn");
+    push(&mut state, CommandKind::Undo);
+    assert!(!state.tool_names().iter().any(|t| t == "E-10x6"));
+    push(&mut state, CommandKind::Undo);
+    assert!(machine::of(&state.world).1.is_none_or(|m| m.edm.is_none()), "undo unmounts the sinker");
+}
diff --git a/docs/decisions/548-sinker-ui.md b/docs/decisions/548-sinker-ui.md
new file mode 100644
index 00000000..54b49128
--- /dev/null
+++ b/docs/decisions/548-sinker-ui.md
@@ -0,0 +1,21 @@
+## #548 - Sinker EDM: machine setup and op pages in the UI
+
+**Decided:**
+- **The machine page is a section of the existing Machine window**, not a new window: `machine_edm_editor::draw`, shown only when the draft's kind is `sinker_edm`. It edits a COPY of the draft's `edm` and writes it back only when an edit changed it, so opening the window never turns an absent `edm` into an empty one. Sinker keys (max orbit radius, electrode pickup), the orbit list (CamCraft geometry + the control's word), the condition table (id, name, gap, undersize, role) and the seven `edm.codes` roles (#542) are all stated/"not stated" widgets: unticked = absent, never zero. Roles in `edm.codes` the sinker post does not read are left as written and listed read-only.
+- **No new command.** Edits ride the existing undoable `EditMachineApply` (-> `LoadMachine` / `SetSetupMachine`), so one Apply is one undo step and the mounted numbers return exactly. Validation is the loader's own law at command creation (`Machine::is_sane` -> `Edm::is_sane`); the page words each cause beside the section ("Apply will refuse: ...") so the refusal is never the generic "states a limit that cannot be meant".
+- **`Edm::is_sane` gained one rule**: a blank `pickup` is refused. The file loader already refused it (`parse_edm`), the in-memory door did not, so a GUI draft could have mounted a machine that would not reload. Now the two agree.
+- **Op page**: the Sinker Burn page (#541/#543 fields already in the tab pattern) now reads what the mounted machine states for the typed condition - "Condition gap" and "Electrode undersize", or "not stated" and a hint that the op will refuse - so the generator's inputs are visible before Generate.
+- **Seeds**: ticking a value on seeds one the field's law accepts (radius 1.0, gap / undersize 0.0, blank pickup / code as a flagged problem) - never a vendor value.
+- **Seam left for #544 / #545 / #547**: orbit and side-burn op pages are out of scope (those ops do not exist). The Sinker Burn page's tabs and the Machine section are where they join; the electrode-from-faces button (#547, `ElectrodeFromFaces`) belongs at the top of the Sinker Burn Geometry tab once that PR lands.
+- **MCP**: no new command, so no new tool. `EditMachineApply` itself has no MCP verb (an agent mounts a machine file with `load_machine`); filed as an `MCP:` follow-up.
+
+**Why:** #290 D4/D5 (conditions and codes are the user's data, "not stated" never zero); AGENTS.md "Everything is a command" (the history is the single source of undo) and "Validate early".
+
+**Considered and dropped:**
+- A separate EDM machine window. The kind picker already lives in the Machine window and a second window would fork the draft/Apply law.
+- A new `EditMachineEdm` command with finer-grained undo. The draft law (one Apply = one step, #373 style) is the existing convention for every machine edit.
+- Per-field validation messages from `post`. `Edm::is_sane` stays a boolean for the loader; the UI states the same laws in words, pinned against `is_sane` in a test.
+
+**Cost to change later:** low. The section is one file over `Edm`; new keys (#544 orbit limits, #546 wear) add rows.
+
+Not exercised on a real EDM control; pages need the maintainer's hand check.

