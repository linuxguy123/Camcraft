From 3d70df795579cc4e9aca5533bc12a2b046f989b5 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Fri, 13 Nov 2026 13:21:49 +0100
Subject: [PATCH] test(kernel): add step_agreement verdict rows for
 bad_entity_mid_data and lathe_holder_offset

Both fixtures were added since v0.18.0 without a row in the expected
table. Measured verdicts (release, step_agreement):
- bad_entity_mid_data.step: import both refuse by name (solidcore
  read_step STEP syntax error), mesh no exact solid to judge against
- lathe_holder_offset.step: import agree, mesh watertight within tolerance
Both are millimetre files (SI_UNIT MILLI METRE), so mm_per_unit 1.0,
the default the test already used for them. No fixture, golden or
product code changed.

Fixes #1400

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 crates/kernel/tests/step_agreement.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/crates/kernel/tests/step_agreement.rs b/crates/kernel/tests/step_agreement.rs
index b6930d17..be85a0df 100644
--- a/crates/kernel/tests/step_agreement.rs
+++ b/crates/kernel/tests/step_agreement.rs
@@ -65,6 +65,12 @@ const ROWS: &[Row] = &[
         import: "disagree: bounding box",
         mesh: "watertight, within tolerance",
     },
+    Row {
+        file: "bad_entity_mid_data.step",
+        mm_per_unit: 1.0,
+        import: "both refuse (solidcore: read_step: invalid input: STEP syntax error)",
+        mesh: "no exact solid to judge against",
+    },
     Row {
         file: "box.step",
         mm_per_unit: 1.0,
@@ -77,6 +83,12 @@ const ROWS: &[Row] = &[
         import: "agree",
         mesh: "watertight, within tolerance",
     },
+    Row {
+        file: "lathe_holder_offset.step",
+        mm_per_unit: 1.0,
+        import: "agree",
+        mesh: "watertight, within tolerance",
+    },
     Row {
         file: "sample_ap214.step",
         mm_per_unit: 1000.0,
