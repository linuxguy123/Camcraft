From ef125a892de0a44493696138a325bf294d0176b3 Mon Sep 17 00:00:00 2001
From: tbrasselle <tbrasselle@gmail.com>
Date: Fri, 13 Nov 2026 09:20:57 -0500
Subject: [PATCH] fix(motion): one flat plane per closed opening's lid

The closing levels a lid's cells a hair apart on any model whose
surface is not flat, and emitting each cell its own level tiled the
lid as steps. Across a step edge the ball can seat on neither plane
for a full ball-width annulus - the higher lid top blocks it from the
lower, and a lid top's free edge carries no fold support - so support
goes None and every step costs a retract and plunge: 166 feeds near
the bolt holes on the report's model, against 22 with the fill off.

Lift the whole lid - raised component and one-cell ring - to the
highest closed height over its cells before emitting, one plane per
opening. The plateau runs after the enclosed check, so enclosure is
still judged on the closing's own levels. Measured on the report's
model: 40 feeds near the holes, 57 elsewhere.
---
 crates/motion/src/finishing3d/fill.rs | 37 +++++++++++++++++++++++---
 crates/motion/tests/finish3d_land.rs  | 38 +++++++++++++++++++++++++++
 2 files changed, 72 insertions(+), 3 deletions(-)

diff --git a/crates/motion/src/finishing3d/fill.rs b/crates/motion/src/finishing3d/fill.rs
index 5c456ee5..439d2476 100644
--- a/crates/motion/src/finishing3d/fill.rs
+++ b/crates/motion/src/finishing3d/fill.rs
@@ -31,9 +31,17 @@
 //!   deeper than one planned on the model itself - the fill can raise
 //!   the path, never lower it. The verifier still judges the real
 //!   model (the caller hands it the model, not these facets).
+//! - **One plane per opening.** A closed opening's whole lid - its
+//!   cells and the ring around them - is one horizontal plane at the
+//!   highest of the lid cells' closed levels. The raster closing gives
+//!   those cells near-equal levels; keeping each cell its own would
+//!   tile the lid as steps, and a stepped lid catches the ball at
+//!   every step edge: across the edge is an annulus where the ball can
+//!   seat on neither plane, support goes None, and each step turns
+//!   into a retract-and-plunge.
 //! - **One cell of reach.** Lids cover the opening's cells plus the
-//!   ring of cells around it, at each cell's own closed height, so no
-//!   crack along the rim is wider than the grid's sampling error.
+//!   ring of cells around it, so no crack along the rim is wider than
+//!   the grid's sampling error.
 
 use crate::geometry::{Point3, Triangle};
 use crate::machining2d::GenError;
@@ -84,7 +92,7 @@ pub fn fill_openings(facets: &[Triangle], width: f64, tol: f64) -> Result<Filled
         return Err(GenError::Invalid("3D finish fill needs a finite positive tolerance".into()));
     }
     let grid = Grid::sample(facets, width)?;
-    let closed = grid.closing();
+    let mut closed = grid.closing();
     let raised: Vec<bool> = (0..grid.h.len()).map(|i| closed[i] > grid.floor_of(i) + tol).collect();
     let mut lid = vec![false; grid.h.len()];
     let mut seen = vec![false; grid.h.len()];
@@ -96,11 +104,14 @@ pub fn fill_openings(facets: &[Triangle], width: f64, tol: f64) -> Result<Filled
         let comp = grid.component(start, &raised, &mut seen);
         if grid.enclosed(&comp, &raised, &closed, tol) {
             openings += 1;
+            let mut cells = comp.clone();
             for &i in &comp {
                 for j in grid.ring8(i) {
                     lid[j] = true;
+                    cells.push(j);
                 }
             }
+            grid.plateau(&mut closed, &cells);
         }
     }
     let mut out = facets.to_vec();
@@ -288,6 +299,26 @@ impl Grid {
         comp
     }
 
+    /// One flat plane per opening: lift every cell of a closed opening's
+    /// lid - the raised component and its one-cell ring - to the
+    /// highest closed height over all of them, so the lid has no steps
+    /// anywhere on it. The closing's per-cell levels differ only by
+    /// raster slop, but a stepped lid is worse than flat: across each
+    /// step edge there is a full ball-width annulus where the ball
+    /// rests on neither plane - the higher lid's top blocks it from
+    /// seating on the lower one, and a lid top's free edge carries no
+    /// fold support - so the support field goes None there and every
+    /// step becomes a retract and plunge. One plane per opening removes
+    /// that annulus; the highest level keeps every lid cell at or above
+    /// its own closed height, so the lid still never digs below the
+    /// closing.
+    fn plateau(&self, closed: &mut [f64], cells: &[usize]) {
+        let top = cells.iter().fold(f64::NEG_INFINITY, |m, &i| m.max(closed[i]));
+        for &i in cells {
+            closed[i] = top;
+        }
+    }
+
     /// Closed: no cell on the border, and every cell bordering the
     /// opening is material standing at its lid's level (within one
     /// cell's rise, the 45-degree step, plus `tol`) - a lid that would
diff --git a/crates/motion/tests/finish3d_land.rs b/crates/motion/tests/finish3d_land.rs
index 0925bfbf..9979a978 100644
--- a/crates/motion/tests/finish3d_land.rs
+++ b/crates/motion/tests/finish3d_land.rs
@@ -295,3 +295,41 @@ fn the_note_says_so_when_nothing_was_filled() {
     let n = narrow.note(3.0);
     assert!(n.contains("no closed opening narrower than 3 mm found") && !n.contains("flown over"), "{n}");
 }
+
+/// The land model's churn (#1286 follow-up): its roof is not flat - it
+/// falls a little over every opening - so the closing's lid levels are
+/// not equal across one lid. Emitting each cell its own level tiled
+/// the lid as steps, and a ball crossing a step edge seats on neither
+/// plane: support goes None there and every step costs a retract and
+/// a plunge (166 feeds near the bolt holes on the report's model,
+/// against 22 with the fill off). The lid of a closed opening must be
+/// ONE plane: here a pocket under a shallow descending roof, whose
+/// lid cells close a hair apart, must come out coplanar.
+#[test]
+fn a_pocket_under_a_descending_roof_gets_one_flat_lid() {
+    let xs: Vec<f64> = (0..=20).map(|i| 2.0 * i as f64).collect();
+    let ys = [0.0, 9.0, 11.0, 20.0];
+    let plate = block(&xs, &ys, &|i, j| {
+        Some(if i == 5 && j == 1 {
+            4.0
+        } else {
+            8.0 - 0.01 * 2.0 * i as f64
+        })
+    });
+    let filled = fill_openings(&plate, 5.0, TOL).expect("fill");
+    assert_eq!(filled.openings, 1, "the pocket is closed under its roof, stepped or not");
+    let mut zs: Vec<f64> = filled.facets[plate.len()..]
+        .iter()
+        .flat_map(|f| [f.a.z, f.b.z, f.c.z])
+        .collect();
+    zs.sort_by(|a, b| a.total_cmp(b));
+    zs.dedup_by(|a, b| (*a - *b).abs() < 1e-9);
+    assert_eq!(zs.len(), 1, "one lid, one plane - the steps at {zs:?} are what churns the ball");
+    assert!(zs[0] > 7.7 && zs[0] < TOP, "the plane rides the lid's highest closing, not below its roof and not above it, at {}", zs[0]);
+    let land = parallel(&filled.facets, &fp(FinishPattern::Parallel)).expect("land path");
+    assert!(
+        !tips(&land).into_iter().any(|q| (q.x - 11.0).abs() < 1.0 && (q.y - 10.0).abs() < 1.0 && q.z < TOP - 1.0),
+        "the land never descends into the pocket"
+    );
+    assert!(deepest_bite(&land, &plate) <= TOL, "the land verifies on the real roof");
+}
