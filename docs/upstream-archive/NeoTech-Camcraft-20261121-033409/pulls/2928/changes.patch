From: Quintin Smits <qd.smits@gmail.com>
Date: Fri, 20 Nov 2026 10:30:16 +0100
Subject: [PATCH 1/4] fix(wire): refuse work outside the stated guide heights

Check the complete wire sweep against each stated guide in the setup frame before posting.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #2923
---
 crates/app/src/operation/wire_verify.rs | 21 +++++++++++++++
 crates/app/tests/wire_taper.rs          | 36 +++++++++++++++++++++++++
 docs/decisions/2923-wire-guide-span.md  |  7 +++++
 3 files changed, 64 insertions(+)
 create mode 100644 docs/decisions/2923-wire-guide-span.md

diff --git a/crates/app/src/operation/wire_verify.rs b/crates/app/src/operation/wire_verify.rs
index aae8421ba..46b68b5d7 100644
--- a/crates/app/src/operation/wire_verify.rs
+++ b/crates/app/src/operation/wire_verify.rs
@@ -40,6 +40,26 @@ fn planes(lo: f64, hi: f64) -> Vec<f64> {
     (0..n).map(|i| lo + eps + (span - 2.0 * eps) * i as f64 / (n - 1) as f64).collect()
 }
 
+/// Check the full height swept by the wire against each stated guide.
+fn check_guide_span(world: &World, setup: Option<&str>, lo: f64, hi: f64) -> Result<(), String> {
+    let (_, machine) = crate::machine::of_setup(world, setup);
+    let Some(edm) = machine.as_ref().and_then(|m| m.edm.as_ref()) else { return Ok(()) };
+    let (_, origin) = crate::posting::wcs_context(world, setup);
+    let bottom = lo - origin[2];
+    let top = hi - origin[2];
+    if let Some(lower) = edm.lower_guide_z
+        && bottom < lower
+    {
+        return Err(format!("work bottom Z{bottom:.3} is below the lower guide Z{lower:.3}, outside the guides' reach"));
+    }
+    if let Some(upper) = edm.upper_guide_z
+        && top > upper
+    {
+        return Err(format!("work top Z{top:.3} is above the upper guide Z{upper:.3}, outside the guides' reach"));
+    }
+    Ok(())
+}
+
 /// Judge one Wire Contour against the world as it stands now: `None`
 /// for any other kind; `Err` names why the laws cannot run (no path, no
 /// condition, no part to judge against, a section that cannot be cut).
@@ -78,6 +98,7 @@ pub fn wire_verdict(world: &World, e: &Entity) -> Option<Result<WireVerdict, Str
         if !(lo.is_finite() && hi.is_finite()) {
             return Err("the wire laws find no height to judge - neither the planes nor the part resolve".into());
         }
+        check_guide_span(world, setup, lo, hi)?;
         let cut = |f: &[Triangle], z: f64, what: &str| {
             slice::slice(f, z).map_err(|e| format!("the {what}'s section at Z{z:.3} cannot be cut: {e}"))
         };
diff --git a/crates/app/tests/wire_taper.rs b/crates/app/tests/wire_taper.rs
index 7ac05bb70..57a7e79df 100644
--- a/crates/app/tests/wire_taper.rs
+++ b/crates/app/tests/wire_taper.rs
@@ -178,6 +178,42 @@ fn a_uv_offset_past_the_stroke_or_the_guides_is_refused_by_name() {
     }
 }
 
+/// The base of this tapered cut fits between the guides. Its top must fit too.
+#[test]
+fn work_above_the_upper_guide_blocks_the_post() {
+    let short = FIXTURE.replace("\"upper_guide_z\": 25.0", "\"upper_guide_z\": 5.0");
+    let (world, made) = punch(&short, 3.0);
+    made.expect("the tapered punch generates");
+    let err = post(&world, "upper-guide").expect_err("the upper guide is inside the work");
+    assert!(err.contains("Punch1: work top Z12.000 is above the upper guide Z5.000"), "{err}");
+}
+
+#[test]
+fn guide_limits_use_the_setup_origin_and_include_stock_above_the_part() {
+    use camcraft_app::commands::{SetStock, SetWcsOrigin};
+    use camcraft_app::schema::Location;
+    use camcraft_app::stock::StockShape;
+
+    let (world, made) = punch(FIXTURE, 0.0);
+    made.expect("the vertical punch generates");
+    let mut history = History::default();
+    let origin = Location { pos: Point3::new(0.0, 0.0, -10.0), ..Location::default() };
+    history.execute(&world, SetWcsOrigin::new(&world, origin).expect("set the work origin"));
+    // The part spans machine Z10..22. The 15 mm stock just fits the upper guide at Z25.
+    for (stock_height, tag) in [(15.0, "guide-at-stock"), (16.0, "guide-in-stock")] {
+        let shape = StockShape::Box { dx: 80.0, dy: 50.0, dz: stock_height };
+        history.execute(&world, SetStock::new(&world, shape, Location::default()).expect("stock"));
+        history.execute(&world, GenerateOperation::new(&world, "Punch1").expect("regenerate"));
+        let posted = post(&world, tag);
+        if stock_height == 15.0 {
+            posted.expect("the work fits up to the stated upper guide");
+        } else {
+            let err = posted.expect_err("the stock extends beyond the upper guide");
+            assert!(err.contains("Punch1: work top Z26.000 is above the upper guide Z25.000"), "{err}");
+        }
+    }
+}
+
 /// Done means: a taper whose lower edge burns into the part blocks the
 /// post - the wire laws read the leaning kerf at every height.
 #[test]
diff --git a/docs/decisions/2923-wire-guide-span.md b/docs/decisions/2923-wire-guide-span.md
new file mode 100644
index 000000000..c606f1faf
--- /dev/null
+++ b/docs/decisions/2923-wire-guide-span.md
@@ -0,0 +1,7 @@
+## #2923 - Check the full work height against the wire guides
+
+Check each guide height stated by the operation's machine before slicing the work for verification. Use the same height span as the wire sweep. It includes the programmed planes, the source part and the stock. Subtract the setup origin's Z coordinate to compare that span with the machine's guide heights.
+
+A check on the programmed move alone passed a 12 mm workpiece with its upper guide at 5 mm. A check on the operation planes alone would also miss stock extending above the part. The check applies to vertical cuts and ruled cuts because both pass through the work. A guide may meet the surface. No machine clearance is assumed.
+
+Requiring both guide heights for every vertical cut would prevent use of machines with unstated heights. Enforcing an additional minimum clearance later would require a machine-specific value and a test for its boundary.

