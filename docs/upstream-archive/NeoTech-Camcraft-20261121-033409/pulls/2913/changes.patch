From 60a509027228013d8931fc548c8edda64af67e40 Mon Sep 17 00:00:00 2001
From: mkinney <mike.kinney@gmail.com>
Date: Fri, 20 Nov 2026 09:28:08 -0800
Subject: [PATCH 2/3] test(examples): give 2d/slots its case tests in the heavy
 lane

Main now needs a catalog_<family>_<case> module for each case. Add
catalog_2d_slots. Its two tests take about 40 s each in debug and go over
the 60 s budget in the parallel suite, so they run in the heavy lane.

Refs #2861

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/example_catalog.rs  | 17 +++++++++++++++++
 docs/decisions/2861-slots-example.md | 12 ++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/crates/app/tests/example_catalog.rs b/crates/app/tests/example_catalog.rs
index 9fa30ee30..c7c8a4a0b 100644
--- a/crates/app/tests/example_catalog.rs
+++ b/crates/app/tests/example_catalog.rs
@@ -85,6 +85,23 @@ mod catalog_2d_hole_work {
     }
 }
 
+// #2861: about 40 s each in debug alone, over the 60 s budget beside the
+// other cases. `slots_case_posts_a_slot_and_a_trochoidal_slot_to_the_same_floor`
+// keeps the committed program pinned in the default suite.
+mod catalog_2d_slots {
+    use super::*;
+    #[test]
+    #[ignore = "heavy lane (#2861 2d/slots): ~40 s in debug alone, over its 60 s budget under the parallel suite - run with --release -- --ignored"]
+    fn regenerates() {
+        run_case("2d", "slots", "regenerates", regenerate);
+    }
+    #[test]
+    #[ignore = "heavy lane (#2861 2d/slots): ~40 s in debug alone, over its 60 s budget under the parallel suite - run with --release -- --ignored"]
+    fn rebuilds() {
+        run_case("2d", "slots", "rebuilds", rebuild);
+    }
+}
+
 mod catalog_turning_cone_thread {
     use super::*;
