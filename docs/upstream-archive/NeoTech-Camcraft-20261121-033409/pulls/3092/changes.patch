From d0fe169a159a14dc5a5973a6c9af332ad70a6cc1 Mon Sep 17 00:00:00 2001
From: Quintin Smits <qd.smits@gmail.com>
Date: Fri, 20 Nov 2026 23:53:49 +0100
Subject: [PATCH] fix(post): name the operations that need the default machine

Keep the affected operations in the default machine diagnostic when verification refuses a per-operation post.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #3089
---
 crates/app/src/posting_default_machine.rs        | 5 +++--
 crates/app/tests/default_machine_missing.rs      | 2 ++
 docs/decisions/3089-default-machine-operation.md | 7 +++++++
 3 files changed, 12 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/3089-default-machine-operation.md

diff --git a/crates/app/src/posting_default_machine.rs b/crates/app/src/posting_default_machine.rs
index 9a9492b37..56e308eb7 100644
--- a/crates/app/src/posting_default_machine.rs
+++ b/crates/app/src/posting_default_machine.rs
@@ -133,10 +133,11 @@ pub(super) fn default_machine_problems(world: &World) -> Vec<String> {
     let v = match default_machine_checked() {
         Ok(v) => v,
         Err(why) => {
-            // #2319: the refusal names the setups that post with it.
+            // Name the setups and operations that need the default machine.
             let named: Vec<&str> = bare.iter().map(String::as_str).filter(|n| !n.is_empty()).collect();
             let who = if named.is_empty() { "the setup".to_owned() } else { named.join(", ") };
-            return vec![format!("machine of {who}: {why}")];
+            let operations: Vec<&str> = ops.iter().map(|(name, _)| name.as_str()).collect();
+            return vec![format!("machine of {who} for {}: {why}", operations.join(", "))];
         }
     };
     let m = default_limits(&v);
diff --git a/crates/app/tests/default_machine_missing.rs b/crates/app/tests/default_machine_missing.rs
index 092835c27..b2cfedf80 100644
--- a/crates/app/tests/default_machine_missing.rs
+++ b/crates/app/tests/default_machine_missing.rs
@@ -155,7 +155,9 @@ fn a_missing_default_machine_file_refuses_the_post_per_mount() {
 #[test]
 fn a_missing_default_machine_file_refuses_the_post_per_operation() {
     let err = assert_refused("per-op", Doc::PerOp, |_| {});
+    assert!(err.contains("Setup2"), "the refusal names the unmounted setup: {err}");
     assert!(err.contains("Face2"), "the refusal names the operation of the unmounted setup: {err}");
+    assert!(!err.contains("Face1"), "the mounted operation has its own machine: {err}");
 }
 
 #[test]
diff --git a/docs/decisions/3089-default-machine-operation.md b/docs/decisions/3089-default-machine-operation.md
new file mode 100644
index 000000000..4e6200f40
--- /dev/null
+++ b/docs/decisions/3089-default-machine-operation.md
@@ -0,0 +1,7 @@
+## #3089 - Name the operations that need the missing machine
+
+Include the affected operations in the shared default-machine refusal. The
+verification pass already knows which setups and operations use that machine.
+Listing them in posting order gives the operator the setup, operation and file
+to check. Moving the check into each output mode would duplicate the refusal.
+A future change to the wording only needs to update this diagnostic.
