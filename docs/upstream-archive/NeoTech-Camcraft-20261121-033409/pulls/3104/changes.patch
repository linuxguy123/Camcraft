+'$Include "jescript.sbh"
+sub SetOrigin
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_HEIGHT,"20.000",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_NOMEOBJ,"CCSEP20",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_MATERIAL,"0001",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_THREAD,"Berco Cut 0.25",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_POSX,"0",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_POSY,"0",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_POSZ,"0",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_ROTATION,"0",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_DIML,"80.000",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_DIMB,"60.000",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_POSPOSX,"-40.000",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_POSPOSY,"-30.000",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_POSPOSZ,"-20.000",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_VALSECP,"3.0",je_dim)
+  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_VALRETP,"30.0",je_dim)
+  ok=JE_GenerateAttrib(c_tecauto,c_tecauto_t)
+  ok=JE_GenerateAttrib(c_tecassign,c_tecass_fi)
+  ok=JE_GenerateAttrib(c_tecalert,c_tecalert_sea)
+end sub
+sub CutPunch
+  ok=JE_CreateQuality(je_piece,"CCB030","0.30,1.50,1.00,F,F,F",je_q1)
+  if (ok<>0) then
+    stop
+  end if
+  ok=JE_Create(GROUP,je_piece,"CCSEP20",NULL)
+  if (ok<>0) then
+    stop
+  end if
+  ok=JE_Create(WORK,je_piece,"CCSEP20","CUT1")
+  if (ok<>0) then
+    stop
+  end if
+  ok=JE_AttribObject(WORK,SETATTR,je_piece,"CCSEP20","CUT1",NULL,ID_GEOMETRY,"AGIE.USING_CCSEP20.ISO",je_dim)
+  ok=JE_AttribObject(WORK,SETATTR,je_piece,"CCSEP20","CUT1",NULL,ID_PUNCH,c_punch,je_dim)
+  ok=JE_AttribObject(WORK,SETATTR,je_piece,"CCSEP20","CUT1",NULL,ID_WORKCOND,"2",je_dim)
+  ok=JE_AttribObject(WORK,SETATTR,je_piece,"CCSEP20","CUT1",NULL,ID_QUALITY,je_q1,je_dim)
+  if (ok<>0) then
+    stop
+  end if
+  ok=JE_AttribObject(WORK,SETATTR,je_piece,"CCSEP20","CUT1",NULL,ID_THREAD,"Berco Cut 0.25",je_dim)
