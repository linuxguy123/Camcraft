+    one_refusal(&named("".into()), "controller.post", "must be the name of a post");
+    // A lathe names a lathe post.
+    let lathe = mill(|v| {
+        *at(v, "/general/kind") = "lathe".into();
+        at(v, "/controller")["post"] = "Tormach PathPilot Lathe".into();
