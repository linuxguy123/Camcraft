From 1057410787ce8d9545ac56546337d0ae014a4603 Mon Sep 17 00:00:00 2001
From: mkinney <mike.kinney@gmail.com>
Date: Sat, 21 Nov 2026 02:46:58 +0100
Subject: [PATCH] fix(test): isolate the default-machine refusal from logs

Pin INFO logging in the CLI fixture and check operation names only in
the post refusal. Generation logs can name mounted operations.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #3105
---
 crates/app/tests/default_machine_missing.rs       | 3 +++
 docs/decisions/3105-default-machine-diagnostic.md | 9 +++++++++
 2 files changed, 12 insertions(+)
 create mode 100644 docs/decisions/3105-default-machine-diagnostic.md

diff --git a/crates/app/tests/default_machine_missing.rs b/crates/app/tests/default_machine_missing.rs
index b2cfedf80..1f7100afb 100644
--- a/crates/app/tests/default_machine_missing.rs
+++ b/crates/app/tests/default_machine_missing.rs
@@ -121,6 +121,7 @@ fn post_with(root: &Path, doc: Doc) -> (i32, String, Vec<String>) {
     let exe = root.join(Path::new(env!("CARGO_BIN_EXE_camcraft-cli")).file_name().expect("exe name"));
     let o = Command::new(exe)
         .args(["process", proj.to_str().expect("utf8"), "-o", nc.to_str().expect("utf8")])
+        .env("CAMCRAFT_LOG", "info")
         .output()
         .expect("the CLI runs");
     let code = o.status.code().unwrap_or(-1);
@@ -155,6 +156,8 @@ fn a_missing_default_machine_file_refuses_the_post_per_mount() {
 #[test]
 fn a_missing_default_machine_file_refuses_the_post_per_operation() {
     let err = assert_refused("per-op", Doc::PerOp, |_| {});
+    // Generation logs name both operations; check only the CLI refusal.
+    let err = err.lines().find(|line| line.starts_with("camcraft-cli: post:")).expect("CLI post refusal");
     assert!(err.contains("Setup2"), "the refusal names the unmounted setup: {err}");
     assert!(err.contains("Face2"), "the refusal names the operation of the unmounted setup: {err}");
     assert!(!err.contains("Face1"), "the mounted operation has its own machine: {err}");
diff --git a/docs/decisions/3105-default-machine-diagnostic.md b/docs/decisions/3105-default-machine-diagnostic.md
new file mode 100644
index 000000000..af2f6bcc3
--- /dev/null
+++ b/docs/decisions/3105-default-machine-diagnostic.md
@@ -0,0 +1,9 @@
+## #3105 - Check the default-machine refusal separately from logs
+
+**Decision:** Check the per-operation refusal assertions against the CLI refusal line. Set `CAMCRAFT_LOG` to `info` for the child process so the test always includes generation logs.
+
+**Why:** The complete stderr stream includes a valid generation log for `Face1`. The refusal correctly names only the unmounted setup `Setup2` and its operation `Face2`. The test must check which operation the refusal names.
+
+**Dropped:** Disabling logging would hide the regression. Production posting changes are unnecessary because the refusal is correct. A broad exclusion from stderr would also reject valid generation logs.
+
+**Cost to change later:** Update the test if the CLI refusal prefix changes. Production posting behavior does not change.
