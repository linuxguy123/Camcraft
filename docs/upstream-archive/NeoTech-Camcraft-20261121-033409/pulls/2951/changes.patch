Subject: [PATCH 4/9] fix(wire): validate the mounted Agie condition role and
 diameter

Refuse a condition that a generic wire operation can preview if it does not explicitly select the supported rough wire row for native Agie output.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #2945
---
 crates/app/src/operation/agie_profile.rs |  4 ++++
 crates/app/tests/agie_native.rs          | 25 ++++++++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/crates/app/src/operation/agie_profile.rs b/crates/app/src/operation/agie_profile.rs
index 8fa3792c2..e30e39447 100644
--- a/crates/app/src/operation/agie_profile.rs
+++ b/crates/app/src/operation/agie_profile.rs
@@ -44,6 +44,10 @@ pub(crate) fn agie_job(world: &World, op: &Operation, name: &str) -> Result<agie
         .1
         .and_then(|m| m.edm)
         .ok_or("Agie requires a mounted wire EDM profile")?;
+    let row = edm.condition(&condition.machine, &condition.id, &[])?;
+    if row.role != "rough" || !row.wire_diameter.is_some_and(|d| (d - 0.25).abs() <= 1e-9) {
+        return Err("Agie requires the AGIE_QN2 machine condition to state role rough and wire diameter 0.25 mm".into());
+    }
     if edm.flushing.is_some() || edm.skim_flushing.is_some() || edm.tank.is_some() {
         return Err("Agie QN2 controls the dielectric settings; explicit tank or flushing modes are unsupported".into());
     }
