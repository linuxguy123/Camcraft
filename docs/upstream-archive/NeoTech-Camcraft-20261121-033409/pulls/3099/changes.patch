diff --git a/crates/sim/src/verify/live_traverse_tests.rs b/crates/sim/src/verify/live_traverse_tests.rs
new file mode 100644
index 000000000..ed72c2d43
--- /dev/null
+++ b/crates/sim/src/verify/live_traverse_tests.rs
@@ -0,0 +1,149 @@
+//! #3077: unit pins of the live-tool first-traverse law (`live_traverse`) - our own cases; no vendor material consulted.
+
+use super::*;
+
+const TOL: f64 = 1e-6;
+
+fn b(lo: [f64; 3], hi: [f64; 3]) -> FixtureBox {
+    FixtureBox { min: Point3::new(lo[0], lo[1], lo[2]), max: Point3::new(hi[0], hi[1], hi[2]) }
+}
+
+/// A plain Ø4 drill: 20 of flute, no shank or holder wider than it.
+fn drill() -> ToolGeom {
+    ToolGeom { radius: 2.0, nose_radius: 0.0, flute_len: 20.0, shank_radius: 2.0, shank_len: 10.0, holder_radius: 0.0, holder_len: 0.0 }
+}
+
+/// A start at radius 15 on +X, Z 10, a Ø4 drill: the swept solid is X 15
+/// and out, Y -2..2, Z 8 and up.
+fn start() -> LiveStart {
+    LiveStart { start: Point3::new(15.0, 0.0, 10.0), spindle: [0.0, 0.0], tool: drill() }
+}
+
+fn steel(s: &LiveStart, turning: &[FixtureBox], fixed: &[FixtureBox]) -> Result<Option<LiveHit>, LiveUnjudged> {
+    live_first_traverse(s, &LiveSolids { turning, fixed, ..LiveSolids::default() }, TOL, 0.0)
+}
+
+fn work_box(s: &LiveStart, bx: FixtureBox, excess: f64) -> Result<Option<LiveHit>, LiveUnjudged> {
+    live_first_traverse(s, &LiveSolids { work_boxes: &[bx], ..LiveSolids::default() }, TOL, excess)
+}
+
+#[test]
+fn a_tailstock_over_the_hole_is_in_the_way_and_a_chuck_under_it_is_not() {
+    let chuck = b([-40.0, -40.0, -110.0], [40.0, 40.0, -80.0]);
+    let tail = b([-30.0, -30.0, 25.0], [30.0, 30.0, 60.0]);
+    assert_eq!(steel(&start(), &[chuck], &[]), Ok(None));
+    let hit = steel(&start(), &[chuck], &[tail]);
+    let Ok(Some(LiveHit::Steel { index: 0, turning: false, along_mm, .. })) = hit else { panic!("{hit:?}") };
+    assert!((along_mm - 30.0 * 2f64.sqrt()).abs() < 1e-9, "{along_mm}");
+    // A thin tailstock centre inside the start's radius is passed.
+    let centre = b([-5.0, -5.0, 25.0], [5.0, 5.0, 60.0]);
+    assert_eq!(steel(&start(), &[], &[centre]), Ok(None));
+    // Fixed steel is read revolved: a block on the far side counts.
+    let far = b([-30.0, -10.0, 20.0], [-20.0, 10.0, 30.0]);
+    assert!(matches!(steel(&start(), &[], &[far]), Ok(Some(LiveHit::Steel { turning: false, .. }))));
+}
+
+#[test]
+fn steel_that_turns_is_read_in_the_station_band() {
+    let jaw = |top: f64| b([-30.0, -30.0, -40.0], [30.0, 30.0, top]);
+    // The band starts at Z 8 (the tip at Z 10, less the drill's radius).
+    assert_eq!(steel(&start(), &[jaw(7.9)], &[]), Ok(None));
+    assert!(matches!(steel(&start(), &[jaw(8.1)], &[]), Ok(Some(LiveHit::Steel { turning: true, .. }))));
+    // A jaw on the far side of the spindle stands out of the station's
+    // half-plane: C turned it there before X and Z move.
+    let far = b([-30.0, -10.0, -40.0], [-20.0, 10.0, 30.0]);
+    assert_eq!(steel(&start(), &[far], &[]), Ok(None));
+    // A jaw 3 mm beside the station's line (the drill is 2 mm each side).
+    let beside = b([20.0, 3.0, -40.0], [30.0, 10.0, 30.0]);
+    assert_eq!(steel(&start(), &[beside], &[]), Ok(None));
+    let touching = b([20.0, 1.9, -40.0], [30.0, 10.0, 30.0]);
+    assert!(matches!(steel(&start(), &[touching], &[]), Ok(Some(LiveHit::Steel { .. }))));
+}
+
+#[test]
+fn a_face_that_only_touches_the_first_points_radius_passes_unless_the_model_is_coarse() {
+    // A flange whose outer face is X 15 exactly, over the hole: the tip
+    // slides down its face and never enters it.
+    let flange = b([10.0, -5.0, 13.0], [15.0, 5.0, 15.0]);
+    assert_eq!(work_box(&start(), flange, 0.0), Ok(None));
+    // 0.01 mm past the first point's radius is inside the swept solid.
+    let proud = b([10.0, -5.0, 13.0], [15.01, 5.0, 15.0]);
+    let hit = work_box(&start(), proud, 0.0);
+    let Ok(Some(LiveHit::Work { index: 0, along_mm, z_mm })) = hit else { panic!("{hit:?}") };
+    assert!((along_mm - 15.01).abs() < 1e-9 && (13.0..=15.0).contains(&z_mm), "{along_mm} {z_mm}");
+    // A coarse model may stand its excess past its facets: the touch
+    // reads as a hit there.
+    assert!(matches!(work_box(&start(), flange, 0.05), Ok(Some(LiveHit::Work { .. }))));
+}
+
+#[test]
+fn the_shank_counts_only_from_where_it_stands_behind_the_tip() {
+    // A Ø4 drill, 20 of flute, then a Ø12 shank: a lump at Y 3..5 out to
+    // X 30 is beside the flute (|y| <= 2) and short of the shank (X 35).
+    let wide = ToolGeom { shank_radius: 6.0, ..drill() };
+    let s = LiveStart { tool: wide, ..start() };
+    let lump = b([10.0, 3.0, -5.0], [30.0, 5.0, 20.0]);
+    assert_eq!(work_box(&s, lump, 0.0), Ok(None));
+    // Out to X 36 it meets the shank's band.
+    let long = b([10.0, 3.0, -5.0], [36.0, 5.0, 20.0]);
+    assert!(matches!(work_box(&s, long, 0.0), Ok(Some(LiveHit::Work { .. }))));
+    // Past the whole stack the widest band runs on: the turret.
+    let beyond = b([60.0, 4.0, -5.0], [70.0, 5.0, 20.0]);
+    assert!(matches!(work_box(&s, beyond, 0.0), Ok(Some(LiveHit::Work { .. }))));
+}
+
+#[test]
+fn the_spindle_line_off_the_origin_moves_the_band() {
+    // The start at radius 15 about X 100: the band is X 115 and out.
+    let off = LiveStart { start: Point3::new(115.0, 0.0, 10.0), spindle: [100.0, 0.0], ..start() };
+    let near = b([110.0, -5.0, 0.0], [120.0, 5.0, 30.0]);
+    assert!(matches!(steel(&off, &[near], &[]), Ok(Some(LiveHit::Steel { turning: true, .. }))));
+    let world_origin = b([10.0, -5.0, 0.0], [20.0, 5.0, 30.0]);
+    assert_eq!(steel(&off, &[world_origin], &[]), Ok(None));
+}
+
+#[test]
+fn a_square_bar_is_read_at_the_face_the_station_looks_at() {
+    // A 44 square bar (corner radius 31.1): a station on its face's
+    // normal at radius 27 clears it; one on its diagonal at 27 does
+    // not, as its corner stands at 31.1 there.
+    let bar = b([-22.0, -22.0, -40.0], [22.0, 22.0, 20.0]);
+    assert_eq!(work_box(&LiveStart { start: Point3::new(27.0, 0.0, 10.0), ..start() }, bar, 0.0), Ok(None));
+    let d = 27.0 / 2f64.sqrt();
+    let hit = work_box(&LiveStart { start: Point3::new(d, d, 10.0), ..start() }, bar, 0.0);
+    assert!(matches!(hit, Ok(Some(LiveHit::Work { index: 0, .. }))), "{hit:?}");
+}
+
+#[test]
+fn a_flange_over_the_hole_is_read_where_its_facet_crosses_the_band() {
+    // One facet from (40, 0, 0) to (0, 0, 20) and (0, 1, 20): its
+    // vertices in the band are inside the start's radius, but where it
+    // crosses Z 8 it reaches X 24.
+    let t = Triangle::new(Point3::new(40.0, 0.0, 0.0), Point3::new(0.0, 0.0, 20.0), Point3::new(0.0, 1.0, 20.0));
+    let work: &[&[Triangle]] = &[&[t]];
+    let hit = live_first_traverse(&start(), &LiveSolids { work, ..LiveSolids::default() }, TOL, 0.0);
+    let Ok(Some(LiveHit::Work { index: 0, along_mm, z_mm })) = hit else { panic!("{hit:?}") };
+    // (The band's floor stands the touch tolerance over Z 8.)
+    assert!((along_mm - 24.0).abs() < 1e-5 && (z_mm - 8.0).abs() < 1e-5, "{along_mm} {z_mm}");
+    // A plain bar face of radius 10 is inside the start's radius.
+    let bar = Triangle::new(Point3::new(10.0, 0.0, -80.0), Point3::new(10.0, 0.0, 20.0), Point3::new(0.0, 10.0, 20.0));
+    let work: &[&[Triangle]] = &[&[bar]];
+    assert_eq!(live_first_traverse(&start(), &LiveSolids { work, ..LiveSolids::default() }, TOL, 0.0), Ok(None));
+}
+
+#[test]
+fn a_start_or_a_tool_that_cannot_be_read_is_not_judged() {
+    let mut s = start();
+    s.start.z = f64::NAN;
+    assert_eq!(steel(&s, &[], &[]), Err(LiveUnjudged));
+    let mut s = start();
+    s.tool.shank_radius = f64::INFINITY;
+    assert_eq!(steel(&s, &[], &[]), Err(LiveUnjudged));
+    let mut s = start();
+    s.tool.flute_len = -1.0;
+    assert_eq!(steel(&s, &[], &[]), Err(LiveUnjudged));
+    // A start on the spindle line has no station direction.
+    let on_axis = LiveStart { start: Point3::new(0.0, 0.0, 10.0), ..start() };
+    assert_eq!(steel(&on_axis, &[], &[]), Err(LiveUnjudged));
+    assert_eq!(live_first_traverse(&start(), &LiveSolids::default(), TOL, f64::NAN), Err(LiveUnjudged));
+}
diff --git a/docs/decisions/3077-lathe-cross-first-traverse.md b/docs/decisions/3077-lathe-cross-first-traverse.md
index 8635ed080..d15d3ea18 100644
--- a/docs/decisions/3077-lathe-cross-first-traverse.md
+++ b/docs/decisions/3077-lathe-cross-first-traverse.md
@@ -1,24 +1,29 @@
 ## #3077 - The first traverse of a cross drill on a lathe or a mill-turn
 
-- **What was decided** (issue worker, unattended; the maintainer can change it):
+- **What was decided** (issue workers, unattended; the maintainer can change it):
   1. **The premise is the maintainer's (#2987, #2997).** The unknown start is the top of the machine's travel: on a lathe the turret's index position (the tool-change position), at the top of the X and Z travel. This is the same premise as the upright law and the 3+2 table law. NOT covered: a program that starts with the tool low near the work, for example after a manual jog.
-  2. **The lathe post's real first move is judged.** `fanuc-lathe.cps` `liveMove` writes `G00 C` with the turret at the index position, then `G00 X Z` to the first point of the section. A G00 moves each axis at its own rate (RS-274 / ISO 6983), so the tip can pass any point of the box between the index position and the first point: every radius from the first point's radius out, at every height from its Z up. The tool body stands outward from the tip, so the band of heights starts one tool radius (the drill or a wider shank) under the tip.
-  3. **The law** (`camcraft_sim::verify::live_first_traverse`). The swept solid is a slab of the part frame, about the spindle line through the work offset: `u >= r`, `|v| <= tool radius`, `z >= z - tool radius` (`u` the first point's radial direction, `v` across it). Both ends of the first move are judged.
-     - Work and turning steel stand at the C angle the post states before X and Z move, so they are read in the slab exactly: each facet (a box as its twelve facets) is clipped by the slab's four planes. Work: the source (the part, or the stock on a stock source), the kept parts, the neighbour parts, and the setup's stock (its facets, or its box when it has no facets). Turning steel: the chuck (`fixture::workholding_for` `.0`).
-     - Fixed steel (a tailstock, the machine table) stands in the machine frame at an angle the part frame does not state. It is read revolved about the spindle: its largest radius (the four X/Y corners) when its top reaches the band's lowest height. That is stricter than its one angle, and it holds at any C.
-  4. **A refusal by name, not a warning.** The cross branch of generation refuses the drill (`GenError::Invalid`): "cross drill: the first rapid comes from the turret's index position ...". No toolpath, so nothing posts. A start that cannot be read (not finite) is refused by name too.
-  5. **A mill-turn answers to two laws.** Its default post is the mill post (`posting::default_post_for`: `Kind::MillTurn` gives the builtin Fanuc mill post). That post sends Z to the clearance height, then X/Y from an unknown X/Y, then the full block with the rotary words (decision #2965 item 1). So a mill-turn cross drill also answers to the upright law (`first_traverse::judge` with the cross drill's lifted start). The live-tool law also judges it: the last block goes down to the first point at its radius, inside the same band. A mill-turn that posts through a lathe post is judged by both laws, which is stricter than its own post.
+  2. **The lathe post's real first move is judged.** `fanuc-lathe.cps` `liveMove` writes `G00 C` with the turret at the index position, then `G00 X Z` to the first motion record. The record stream (`camcraft_post::post::dump`) writes each move's END only; the first move's start goes out only as the `StartX/Y/Z` parameters, and `liveMove` does not move there. So the first G00 X Z goes to the END of move 0: the R-plane point of the first hole, not the kernel's standoff (`crates/motion/src/drilling/cross.rs`: the path starts at the standoff, move 0 is the rapid to the R plane). `tormach-lathe.cps` states no `liveTooling` and refuses a live section. A G00 moves each axis at its own rate (RS-274 / ISO 6983), so the tip can pass any point of the box between the index position and the first point: every radius from the first point's radius out, at every height from its Z up.
+  3. **The law** (`camcraft_sim::verify::live_first_traverse`). The tool lies along the station's radius, its tip inward. The swept solid is read in the part frame about the spindle line through the work offset (`u` the first point's radial direction, `v` across it, `s = u - r`): `u >= r`, `|v| <= W(s)`, `z >= z - W(s)`. `W(s)` is the widest band of the tool stack (`ToolGeom`: flute, shank, holder) within `s` of the tip. Past the stack's end the widest band runs on, because the turret is not modelled. The move's end is judged, then its start (on one station line the start's swept solid lies inside the end's).
+     - Work and turning steel stand at the C angle the post states before X and Z move, so they are read exactly: each facet (a box as its twelve facets) is clipped by each band's planes. Work: the source (the part, or the stock on a stock source), the kept parts, the neighbour parts, and the setup's stock (its facets, or its box when it has no facets). Turning steel: the chuck (`fixture::workholding_for` `.0`).
+     - Fixed steel (a tailstock, the machine table) stands in the machine frame at an angle the part frame does not state. It is read revolved about the spindle: its nearest and farthest radius against each band, and its top against the band's floor. That holds at any C.
+     - **A touch passes.** A face within `Z_TOL` (1e-6 mm) of the swept solid's boundary is clear, as in the other traverse laws: the tip slides down a face flush with the R plane and does not enter it. The work's model excess (a coarse model, #842) grows the swept solid by that excess, so on a coarse model the touch is a hit unless the kernel moved its R plane out by the excess (it does).
+  4. **A refusal by name, not a warning.** The cross branch of generation refuses the drill (`GenError::Invalid`): "cross drill: the first rapid comes from the turret's index position ...". The refusal names the solid and how far out from the spindle it reaches, at which Z. No toolpath, so nothing posts. A start or a tool stack that cannot be read is refused by name too.
+  5. **A mill-turn answers to two laws.** Its default post is the mill post (`posting::default_post_for`: `Kind::MillTurn` gives the builtin Fanuc mill post). That post sends Z to the clearance height, then X/Y from an unknown X/Y, then the full block with the rotary words (decision #2965 item 1). So a mill-turn cross drill also answers to the upright law (`first_traverse::judge` with the cross drill's lifted start). The live-tool law also judges it. A mill-turn that posts through a lathe post is judged by both laws, which is stricter than its own post.
   6. **Cache.** The cross drill's op stamp takes one more word, `live-traverse-3077`. Such a cache reads Stale once and the post refuses it until a regenerate.
-- **Why.** The lathe post's move order is the fact that the law must follow. C is in position before X and Z move, so the work and the chuck have a known angle; the fixed steel has none in the part frame, so it is read at every angle.
-- **Pinning tests.** `crates/app/tests/lathe_cross_drill.rs`: `a_cross_drill_over_its_chuck_has_a_clear_first_traverse` (lathe and mill-turn: clear), `a_cross_drill_under_a_wide_tailstock_is_refused_by_name` (lathe and mill-turn: refused), `a_thin_tailstock_centre_is_clear_on_a_lathe_and_convicts_a_mill_turn`. The sim unit tests in `crates/sim/src/verify/live_traverse.rs` pin the slab (the tool width, the station's half-plane, a square bar's face and diagonal, the clipped facet, the spindle line off the origin, the fixed steel read revolved, a start that cannot be read).
+- **Why.** The lathe post's move order is the fact that the law must follow. C is in position before X and Z move, so the work and the chuck have a known angle; the fixed steel has none in the part frame, so it is read at every angle. The tool's own stack, not its widest band everywhere, is what the rapid carries past the work: a wide shank 30 mm behind the tip cannot meet a lump 3 mm beside the drill's line.
