+#[test]
+fn a_cross_drill_on_a_mill_starts_under_the_stock_top_and_is_held() {
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    tool(&world, &mut h, "DR-0400");
+    let at = Location { pos: Point3::new(0.0, 0.0, punched_bar::FOOT), rot: IDENTITY_Q };
+    h.execute(&world, SetStock::new(&world, StockShape::Cylinder { diameter: 40.0, height: 100.0 }, at).expect("stock"));
+    // One r2 hole plunging -X from the bar's face at z 0, 6 mm deep.
+    let hole = || CrossHole { origin: Point3::new(10.0, 0.0, 0.0), dir: Point3::new(-1.0, 0.0, 0.0), radius: 2.0, entry_d: 0.0, floor_d: -6.0, through: false };
+    h.execute(&world, ImportModel::from_mesh("B", punched_bar::punched_bar(10.0, punched_bar::FOOT, punched_bar::TOP, &[hole()])));
+    let p = OpParams::Drill {
+        break_through: None,
+        break_through_from: Default::default(),
+        clearance_z: Height::fixed(25.0),
+        retract_z: None,
+        top_z: Height::fixed(20.0),
+        bottom_z: None,
+        cycle: CycleChoice::Auto,
+        peck: 0.0,
+        dwell: 0.0,
+        feed: 120.0,
+        plunge_feed: 80.0,
+        holes: vec![],
+        cross: vec![hole()],
+    };
+    let (status, warns) = generate(&world, &mut h, "DR-0400", "B", p);
+    assert_eq!(status, OpStatus::Ok, "{warns:?}");
+    let (at, height, top, fixture) = first_low(&warns).unwrap_or_else(|| panic!("no first-traverse verdict in {warns:?}"));
+    assert_eq!((at, fixture), (0, false));
+    assert!(height.abs() < 1e-6, "the start stands on the hole's line at z 0: {height}");
+    assert!((top - punched_bar::TOP).abs() < 1e-6, "the bar stock's top: {top}");
+    held_by_name(&world, "under the stock top at Z20.000");
+}
