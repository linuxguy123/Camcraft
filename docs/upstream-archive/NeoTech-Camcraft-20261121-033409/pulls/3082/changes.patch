+    #[test]
+    fn the_catalog_tilted_pocket_reads_the_table_from_a_start_on_its_top() {
+        let axis = [3f64.sqrt() / 4.0, -0.5, 0.75];
+        let f = TiltedFrame { origin: Point3::new(0.0, 0.0, 0.0), u: [1.0, 0.0, 0.0], v: [0.0, 1.0, 0.0], axis };
