  "title": "fix(sim): judge the first traverse of a lathe or mill-turn cross drill from the turret's index position",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
