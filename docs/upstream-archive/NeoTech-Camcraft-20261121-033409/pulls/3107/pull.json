  "title": "fix(motion): turning offset claims a segment only where its tangent point lies on it",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
    "gravatar_id": "",
