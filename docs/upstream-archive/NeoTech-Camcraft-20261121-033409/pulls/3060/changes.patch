+        && runs.len() > 1
+        && runs.last().and_then(|r| r.last()) == runs.first().and_then(|r| r.first())
+        && let Some(mut last) = runs.pop()
+    {
+        last.extend(runs.remove(0).into_iter().skip(1));
+        runs.insert(0, last);
+    }
+    for mut run in runs {
+        let closed = closed && run.len() > 3 && run.first() == run.last();
+        if closed {
