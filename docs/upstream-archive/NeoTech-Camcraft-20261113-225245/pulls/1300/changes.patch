index fd9316a2b..1345c2d8b 100644
--- a/crates/app/src/cli.rs
+++ b/crates/app/src/cli.rs
@@ -27,6 +27,7 @@ USAGE:
     camcraft-cli mcp      [--connect <host:port>]
     camcraft-cli help
     camcraft-cli version
+    camcraft-cli <command> --help    the flags of one command
 
 COMMANDS:
     script    run a job script through the cam verbs (assets/scripts/
@@ -42,6 +43,67 @@ A clean run prints its logs, then the last verb's JSON answer on
 stdout; refusals print on stderr. Exit: 0 stood, 1 refused, 2 usage.
 ";
 
+/// Per-command usage (`camcraft-cli <command> --help` or `-h`): printed
+/// to stdout, exit 0, and the command never runs - `mcp --help` does
+/// not start the server.
+const SCRIPT_USAGE: &str = "\
+camcraft-cli script <job.js>
+
+    run a job script through the cam verbs (assets/scripts/cam.d.ts
+    types them; every world write rides the commands)
+
+ARGUMENTS:
+    <job.js>          the job file; must end in .js
+
+OPTIONS:
+    -h, --help        print this usage and exit 0
+
+Exit: 0 stood, 1 refused, 2 usage.
+";
+
+const PROCESS_USAGE: &str = "\
+camcraft-cli process <job.camproj> [-o <out.nc>] [--cps <name|file.cps>]
+
+    headless project processing: load, generate, and - with -o - post;
+    verify's verdict is the exit code
+
+ARGUMENTS:
+    <job.camproj>     the project to bring current
+
+OPTIONS:
+    -o, --out <out.nc>      post the program to this file
+    --cps <name|file.cps>   the post to use (takes effect with -o)
+    -h, --help              print this usage and exit 0
+
+Exit: 0 stood, 1 refused, 2 usage.
+";
+
+const MCP_USAGE: &str = "\
+camcraft-cli mcp [--connect <host:port>]
+
+    a Model Context Protocol server on stdio (JSON-RPC 2.0): an AI agent
+    drives one headless document through tools. Stdout carries the
+    protocol, so --help prints here and does not start the server.
+
+OPTIONS:
+    --connect <host:port>   bridge stdio to a running app started with
+                            --mcp-port (the agent drives the open window)
+    -h, --help              print this usage and exit 0
+
+Exit: 0 stood, 1 session ended with an error, 2 usage.
+";
+
+/// The usage text for a lane that takes `--help`, or `None` for any
+/// other word. Keeps the flag list next to the parser it describes.
+fn command_usage(cmd: &str) -> Option<&'static str> {
+    match cmd {
+        "script" => Some(SCRIPT_USAGE),
+        "process" => Some(PROCESS_USAGE),
+        "mcp" => Some(MCP_USAGE),
+        _ => None,
+    }
+}
+
 /// The process lane's generated job: the verbs a headless project
 /// run always means, spelled exactly as a hand-written script would.
 /// No second code path: the CLI's project processing IS a script run.
@@ -102,13 +164,23 @@ pub fn run(args: &[String]) -> i32 {
             println!("camcraft-cli {} (boa_engine)", env!("CARGO_PKG_VERSION"));
             0
         }
-        "script" => lane_script(&args[1..]),
-        "process" => lane_process(&args[1..]),
-        "mcp" => lane_mcp(&args[1..]),
-        other => {
-            eprintln!("camcraft-cli: unknown command {other:?} (try help)");
-            2
-        }
+        // Any position: `process x.camproj --help` answers too. Checked
+        // before the lane parses, so no lane starts (or reads stdin).
+        lane => match command_usage(lane) {
+            Some(text) if args[1..].iter().any(|a| a == "--help" || a == "-h") => {
+                print!("{text}");
+                0
+            }
+            _ => match lane {
+                "script" => lane_script(&args[1..]),
+                "process" => lane_process(&args[1..]),
+                "mcp" => lane_mcp(&args[1..]),
+                other => {
+                    eprintln!("camcraft-cli: unknown command {other:?} (try help)");
+                    2
+                }
+            },
+        },
     }
 }
 
diff --git a/crates/app/tests/cli.rs b/crates/app/tests/cli.rs
index f77437b67..80f96149e 100644
--- a/crates/app/tests/cli.rs
+++ b/crates/app/tests/cli.rs
@@ -153,3 +153,75 @@ fn a_post_that_refuses_exits_one_and_says_why() {
     assert!(err.contains("post:"), "the verb names itself: {err}");
     assert!(!o.stdout.contains(&b'{'), "a stopped script parks no answer: {}", String::from_utf8_lossy(&o.stdout));
 }
+
+/// Spawns the CLI with `stdin` piped in: a lane that starts serving
+/// (mcp) would answer the JSON-RPC line written here on stdout.
+fn cli_with_stdin(args: &[&str], stdin: &str) -> Output {
+    use std::io::Write;
+    use std::process::Stdio;
+    let mut child = Command::new(env!("CARGO_BIN_EXE_camcraft-cli"))
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("the CLI binary runs");
+    if let Some(mut pipe) = child.stdin.take() {
+        // A lane that exits before reading closes the pipe: not a failure here.
+        let _ = pipe.write_all(stdin.as_bytes());
+    }
+    child.wait_with_output().expect("the CLI finishes")
+}
+
+#[test]
+fn every_subcommand_answers_help_and_names_its_flags() {
+    // Each lane's usage names itself and every flag its parser reads.
+    let cases: [(&str, &[&str]); 3] = [
+        ("script", &["<job.js>", "--help", "-h"]),
+        ("process", &["<job.camproj>", "-o", "--out", "--cps", "--help", "-h"]),
+        ("mcp", &["--connect", "<host:port>", "--help", "-h"]),
+    ];
+    for (cmd, names) in cases {
+        for flag in ["--help", "-h"] {
+            let o = cli_str(&[cmd, flag]);
+            let text = String::from_utf8_lossy(&o.stdout);
+            assert_eq!(code(&o), 0, "{cmd} {flag} exits 0: {text}");
+            assert!(text.contains(&format!("camcraft-cli {cmd}")), "{cmd} {flag} names its command: {text}");
+            for name in names {
+                assert!(text.contains(name), "{cmd} {flag} names {name}: {text}");
+            }
+            assert!(o.stderr.is_empty(), "{cmd} {flag} is quiet on stderr");
+        }
+    }
+}
+
+#[test]
+fn help_flag_answers_anywhere_in_the_argv() {
+    // The project does not exist: the help answer must not read it.
+    let o = cli_str(&["process", "/no/such/project.camproj", "--help"]);
+    assert_eq!(code(&o), 0);
+    assert!(String::from_utf8_lossy(&o.stdout).contains("--cps"), "process help names --cps");
+}
+
+#[test]
+fn mcp_help_does_not_start_the_server() {
+    // A live server would answer this initialize line on stdout.
+    let init = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n";
+    let o = cli_with_stdin(&["mcp", "--help"], init);
+    assert_eq!(code(&o), 0);
+    let text = String::from_utf8_lossy(&o.stdout);
+    assert!(!text.contains("jsonrpc"), "help must not speak the protocol: {text}");
+    assert!(text.contains("--connect"), "mcp help names --connect");
+    // Control: the same line, no help, is answered - so the check above can fail.
+    let served = cli_with_stdin(&["mcp"], init);
+    assert!(String::from_utf8_lossy(&served.stdout).contains("jsonrpc"), "a plain mcp answers the line");
+}
+
+#[test]
+fn unknown_flags_still_refuse_with_a_two_and_help_lists_per_command() {
+    assert_eq!(code(&cli_str(&["process", "p.camproj", "--bogus"])), 2);
+    assert_eq!(code(&cli_str(&["script", "--bogus"])), 2);
+    assert_eq!(code(&cli_str(&["mcp", "--bogus"])), 2);
+    let o = cli_str(&["help"]);
+    assert!(String::from_utf8_lossy(&o.stdout).contains("<command> --help"), "top-level help points at per-command help");
+}
