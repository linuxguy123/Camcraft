diff --git a/xtask/src/asset_tests.rs b/xtask/src/asset_tests.rs
new file mode 100644
index 000000000..517d05792
--- /dev/null
+++ b/xtask/src/asset_tests.rs
@@ -0,0 +1,80 @@
+//! Pins the quick tier's asset selection (#923): a diff of only a post script or machine file runs the
+//! suites that post through it, and an asset no suite covers is reported, not skipped.
+//! Provenance: our own build law (AGENTS.md "Test the change, not everything"), #919 research.
+
+use std::path::{Path, PathBuf};
+
+use crate::quick::{self, Diff, Quick};
+
+fn root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).parent().map(Path::to_path_buf).unwrap_or_default()
+}
+
+fn plan_for(root: &Path, files: &[&str]) -> crate::plan::Plan {
+    let changed: Vec<String> = files.iter().map(|s| s.to_string()).collect();
+    let hunks = |_: &str| -> Vec<String> { Vec::new() };
+    let diff = Diff { changed: &changed, untracked: &[], hunks: &hunks };
+    match quick::plan(root, &diff, false) {
+        Ok(Quick::Plan(p)) => p,
+        other => panic!("{files:?} did not plan: {other:?}"),
+    }
+}
+
+fn app_suites(p: &crate::plan::Plan) -> Vec<String> {
+    let Some(s) = p.steps.iter().find(|s| s.name == "app suites") else { return Vec::new() };
+    s.args.iter().enumerate().filter(|(_, x)| *x == "--test").filter_map(|(i, _)| s.args.get(i + 1).cloned()).collect()
+}
+
+#[test]
+fn cps_only_change_selects_the_suites_posting_through_it() {
+    let p = plan_for(&root(), &["assets/posts/fanuc.cps"]);
+    let got = app_suites(&p);
+    for must in ["fanuc_post", "conformance"] {
+        assert!(got.iter().any(|b| b == must), "{must} missing from {got:?}");
+    }
+    assert!(!p.notes.iter().any(|n| n.contains("no tests to run")), "{:?}", p.notes);
+}
+
+#[test]
+fn a_cps_change_skips_suites_that_never_name_it() {
+    let got = app_suites(&plan_for(&root(), &["assets/posts/fanuc.cps"]));
+    assert!(!got.iter().any(|b| b == "heidenhain_block_form"), "{got:?}");
+    let got = app_suites(&plan_for(&root(), &["assets/posts/heidenhain.cps"]));
+    assert!(got.iter().any(|b| b == "heidenhain_cycles"), "{got:?}");
+}
+
+#[test]
+fn mch_only_change_selects_the_suites_using_that_machine() {
+    let got = app_suites(&plan_for(&root(), &["assets/machines/3axis-vmc.mch"]));
+    for must in ["arc_planes", "comment_escape", "conformance"] {
+        assert!(got.iter().any(|b| b == must), "{must} missing from {got:?}");
+    }
+}
+
+#[test]
+fn an_asset_no_suite_covers_is_reported_not_skipped() {
+    let dir = std::env::temp_dir().join(format!("xtask-asset-{}", std::process::id()));
+    let posts = dir.join("assets/posts");
+    assert!(std::fs::create_dir_all(&posts).is_ok());
+    assert!(std::fs::write(posts.join("orphan-lathe.cps"), "// x").is_ok());
+    let p = plan_for(&dir, &["assets/posts/orphan-lathe.cps"]);
+    let _ = std::fs::remove_dir_all(&dir);
+    assert!(
+        p.notes.iter().any(|n| n.contains("assets/posts/orphan-lathe.cps") && n.contains("NO SUITE")),
+        "{:?}",
+        p.notes
+    );
+    assert!(!p.notes.iter().any(|n| n.contains("no tests to run")), "{:?}", p.notes);
+}
+
+#[test]
+fn only_post_scripts_and_machine_files_count_as_assets() {
+    let a = crate::assets::changed_assets(&[
+        "assets/posts/AGENTS.md".into(),
+        "assets/posts/fanuc.cps".into(),
+        "assets/machines/vmc.mch".into(),
+        "assets/posts/sub/x.cps".into(),
+    ]);
+    let names: Vec<_> = a.iter().map(|a| a.path.as_str()).collect();
+    assert_eq!(names, ["assets/posts/fanuc.cps", "assets/machines/vmc.mch"]);
+}
diff --git a/xtask/src/assets.rs b/xtask/src/assets.rs
new file mode 100644
index 000000000..5d36fd428
--- /dev/null
+++ b/xtask/src/assets.rs
@@ -0,0 +1,65 @@
+//! Quick tier: a changed post script (`assets/posts/*.cps`) or machine file (`assets/machines/*.mch`)
+//! selects the suites that post through it (#923).
+//! Provenance: our own build law (AGENTS.md "Test the change, not everything"), #919 research.
+//!
+//! A suite posts through an asset when its source names the file (`fanuc.cps`), quotes its stem
+//! (`"fanuc"`, as the conformance tables do), or walks the whole asset directory
+//! (`assets/posts/{..}`, `read_dir` of `machines`). An asset no suite names is reported by the plan.
+
+use std::path::Path;
+
+use regex::escape;
+
+use crate::plan::ALL_CRATES;
+use crate::scan::{self, re};
+
+/// The asset kinds quick watches: (directory under `assets/`, file extension).
+const KINDS: [(&str, &str); 2] = [("posts", "cps"), ("machines", "mch")];
+
+/// One changed asset: its repo path, directory kind and file stem.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Asset {
+    pub path: String,
+    pub dir: &'static str,
+    pub ext: &'static str,
+    pub stem: String,
+}
+
+/// The post scripts and machine files among the changed files.
+pub fn changed_assets(changed: &[String]) -> Vec<Asset> {
+    let mut out = Vec::new();
+    for f in changed {
+        for (dir, ext) in KINDS {
+            let Some(name) = f.strip_prefix(&format!("assets/{dir}/")) else { continue };
+            let Some(stem) = name.strip_suffix(&format!(".{ext}")) else { continue };
+            if !stem.is_empty() && !stem.contains('/') {
+                out.push(Asset { path: f.clone(), dir, ext, stem: stem.to_string() });
+            }
+        }
+    }
+    out
+}
+
+/// Suites (`crate:binary`) whose source posts through `a`, with the reason.
+pub fn suites_for(root: &Path, a: &Asset) -> Result<Vec<(String, String)>, String> {
+    let file = re(&format!(r"(?i)\b{}\.{}\b", escape(&a.stem), a.ext))?;
+    let quoted = re(&format!(r#"(?i)"{}""#, escape(&a.stem)))?;
+    let walk = re(&format!(r#"(?i)assets/{}/\{{|read_dir\([^)]*{}"#, a.dir, a.dir))?;
+    let mut out = Vec::new();
+    for d in ALL_CRATES {
+        for b in scan::binaries(root, d) {
+            let text = scan::read(&root.join("crates").join(d).join("tests").join(format!("{b}.rs")));
+            let why = if file.is_match(&text) {
+                format!("names {}.{}", a.stem, a.ext)
+            } else if quoted.is_match(&text) {
+                format!("quotes \"{}\"", a.stem)
+            } else if walk.is_match(&text) {
+                format!("walks assets/{}", a.dir)
+            } else {
+                continue;
+            };
+            out.push((format!("{d}:{b}"), why));
+        }
+    }
+    Ok(out)
+}
diff --git a/xtask/src/icons.rs b/xtask/src/icons.rs
new file mode 100644
index 000000000..83ab2dffb
--- /dev/null
+++ b/xtask/src/icons.rs
@@ -0,0 +1,231 @@
+//! `cargo xtask icons`: rasterises the SVG icon masters (`assets/ui/svg/*.svg`) to the 32 px PNGs the
+//! UI loads (`assets/ui/<stem>.png`), checks the committed PNGs against their masters (`--check`), and
+//! draws a 16 px contact sheet on a dark and a light band (`--sheet <out.png>`) for a human look.
+//! Provenance: our own pipeline (#661, docs/decisions/661-icon-set.md); rendering by resvg
+//! (MIT OR Apache-2.0); the masters keep Tabler Icons' conventions (24-unit grid, 2-unit stroke,
+//! round caps and joins) so they sit with the Tabler glyphs we ship.
+
+use std::path::{Path, PathBuf};
+
+use resvg::tiny_skia::{Pixmap, Transform};
+use resvg::usvg;
+
+/// The edge of every committed PNG (AGENTS.md "Assets": 32x32, drawn at 16 px).
+pub const PNG_PX: u32 = 32;
+/// The masters' grid (Tabler's `viewBox="0 0 24 24"`).
+const GRID: f32 = 24.0;
+/// Largest per-channel difference `--check` accepts between a fresh render and the committed PNG:
+/// resvg's anti-aliasing may differ by a step or two across CPUs, a changed drawing differs by far more.
+const TOLERANCE: u8 = 8;
+/// The only stroke weights a master may use: Tabler's 2 for the object, 1.5 for a toolpath or
+/// detail line drawn over it.
+const WEIGHTS: [&str; 2] = ["1.5", "2"];
+
+/// The masters directory and the PNG directory, relative to the workspace root.
+pub fn dirs(root: &Path) -> (PathBuf, PathBuf) {
+    let ui = root.join("assets").join("ui");
+    (ui.join("svg"), ui)
+}
+
+/// Every `*.svg` master, sorted by name.
+pub fn masters(root: &Path) -> Result<Vec<PathBuf>, String> {
+    let (svg, _) = dirs(root);
+    let rd = std::fs::read_dir(&svg).map_err(|e| format!("{}: {e}", svg.display()))?;
+    let mut out: Vec<PathBuf> = rd
+        .filter_map(|e| e.ok().map(|e| e.path()))
+        .filter(|p| p.extension().is_some_and(|x| x == "svg"))
+        .collect();
+    out.sort();
+    Ok(out)
+}
+
+/// The house rules a master must keep; one line per breach (empty = clean). Shapes only: no raster,
+/// no external reference, no script, no font or text, no stylesheet; the 24-unit grid with no
+/// intrinsic size; round caps and joins; only the two stroke weights.
+pub fn lint(text: &str) -> Vec<String> {
+    let mut bad = Vec::new();
+    let lower = text.to_ascii_lowercase();
+    for banned in ["<image", "<script", "<text", "<foreignobject", "<style", "href", "url(", "font", "@import"] {
+        if lower.contains(banned) {
+            bad.push(format!("contains '{banned}' (shapes only)"));
+        }
+    }
+    let root_tag = lower.split_once("<svg").map(|(_, r)| r.split('>').next().unwrap_or("")).unwrap_or("");
+    if root_tag.is_empty() {
+        bad.push("no <svg> root".into());
+    }
+    if !root_tag.contains("viewbox=\"0 0 24 24\"") {
+        bad.push("root must carry viewBox=\"0 0 24 24\"".into());
+    }
+    if root_tag.contains(" width=") || root_tag.contains(" height=") {
+        bad.push("root must carry no intrinsic width/height".into());
+    }
+    for cap in ["butt", "square", "miter", "bevel"] {
+        if lower.contains(&format!("\"{cap}\"")) {
+            bad.push(format!("'{cap}' cap/join (round only)"));
+        }
+    }
+    if !root_tag.contains("stroke-linecap=\"round\"") || !root_tag.contains("stroke-linejoin=\"round\"") {
+        bad.push("root must set stroke-linecap and stroke-linejoin to round".into());
+    }
+    let mut rest = lower.as_str();
+    while let Some(i) = rest.find("stroke-width=\"") {
+        let tail = &rest[i + 14..];
+        let v = tail.split('"').next().unwrap_or("");
+        if !WEIGHTS.contains(&v) {
+            bad.push(format!("stroke-width {v} (allowed: {})", WEIGHTS.join(", ")));
+        }
+        rest = tail;
+    }
+    bad
+}
+
+/// Render one master at `px` x `px` (black ink with alpha coverage; the UI recolours it at load).
+pub fn render(svg: &[u8], px: u32) -> Result<Pixmap, String> {
+    let tree = usvg::Tree::from_data(svg, &usvg::Options::default()).map_err(|e| e.to_string())?;
+    let mut pm = Pixmap::new(px, px).ok_or_else(|| format!("cannot allocate a {px} px pixmap"))?;
+    let s = px as f32 / GRID;
+    resvg::render(&tree, Transform::from_scale(s, s), &mut pm.as_mut());
+    Ok(pm)
+}
+
+fn stem(p: &Path) -> Result<String, String> {
+    p.file_stem()
+        .and_then(|s| s.to_str())
+        .map(String::from)
+        .ok_or_else(|| format!("{}: no file stem", p.display()))
+}
+
+/// One master's problems against its committed PNG and the house rules (empty = in step).
+pub fn check_one(master: &Path, png_dir: &Path) -> Result<Vec<String>, String> {
+    let name = stem(master)?;
+    let bytes = std::fs::read(master).map_err(|e| format!("{}: {e}", master.display()))?;
+    let mut bad: Vec<String> = lint(&String::from_utf8_lossy(&bytes)).into_iter().map(|b| format!("{name}.svg: {b}")).collect();
+    let fresh = render(&bytes, PNG_PX).map_err(|e| format!("{name}.svg: {e}"))?;
+    let png = png_dir.join(format!("{name}.png"));
+    match std::fs::read(&png).map_err(|e| e.to_string()).and_then(|b| Pixmap::decode_png(&b).map_err(|e| e.to_string())) {
+        Err(e) => bad.push(format!("{name}.png: missing or unreadable ({e}) - run `cargo xtask icons`")),
+        Ok(old) if old.width() != PNG_PX || old.height() != PNG_PX => {
+            bad.push(format!("{name}.png: {}x{}, want {PNG_PX}x{PNG_PX}", old.width(), old.height()));
+        }
+        Ok(old) => {
+            let worst = old.data().iter().zip(fresh.data()).map(|(a, b)| a.abs_diff(*b)).max().unwrap_or(0);
+            if worst > TOLERANCE {
+                bad.push(format!("{name}.png: differs from its master by {worst} - run `cargo xtask icons`"));
+            }
+        }
+    }
+    Ok(bad)
+}
+
+/// `--check` over every master: the breaches, one per line.
+pub fn check(root: &Path) -> Result<Vec<String>, String> {
+    let (_, png_dir) = dirs(root);
+    let mut bad = Vec::new();
+    for m in masters(root)? {
+        bad.extend(check_one(&m, &png_dir)?);
+    }
+    Ok(bad)
+}
+
+/// Rasterise every master to its PNG; refuses (writes nothing for) a master that breaks the rules.
+pub fn build(root: &Path) -> Result<usize, String> {
+    let (_, png_dir) = dirs(root);
+    let mut n = 0;
+    for m in masters(root)? {
+        let name = stem(&m)?;
+        let bytes = std::fs::read(&m).map_err(|e| format!("{}: {e}", m.display()))?;
+        let bad = lint(&String::from_utf8_lossy(&bytes));
+        if !bad.is_empty() {
+            return Err(format!("{name}.svg: {}", bad.join("; ")));
+        }
+        let pm = render(&bytes, PNG_PX).map_err(|e| format!("{name}.svg: {e}"))?;
+        let png = pm.encode_png().map_err(|e| format!("{name}: {e}"))?;
+        std::fs::write(png_dir.join(format!("{name}.png")), png).map_err(|e| format!("{name}.png: {e}"))?;
+        n += 1;
+    }
+    Ok(n)
+}
+
+/// A contact sheet: every master at `px` on a dark band (light ink) above a light band (dark ink),
+/// `cols` per row, each pixel blown up `zoom` times (nearest) so a reviewer sees what 16 px shows.
+pub fn sheet(root: &Path, px: u32, cols: u32, zoom: u32) -> Result<Pixmap, String> {
+    let all = masters(root)?;
+    let cell = px + px / 2;
+    let rows = (all.len() as u32).div_ceil(cols.max(1)).max(1);
+    let (w, band) = (cols * cell, rows * cell);
+    let mut base = Pixmap::new(w, band * 2).ok_or("sheet too large")?;
+    let fill = |pm: &mut Pixmap, y0: u32, rgb: [u8; 3]| {
+        for (i, p) in pm.data_mut().as_chunks_mut::<4>().0.iter_mut().enumerate() {
+            if (i as u32 / w) >= y0 && (i as u32 / w) < y0 + band {
+                p.copy_from_slice(&[rgb[0], rgb[1], rgb[2], 255]);
+            }
+        }
+    };
+    let bands: [(u32, [u8; 3], [u8; 3]); 2] = [(0, [30, 30, 32], [235, 235, 235]), (band, [246, 246, 246], [32, 36, 44])];
+    for (y0, bg, _) in bands {
+        fill(&mut base, y0, bg);
+    }
+    for (k, m) in all.iter().enumerate() {
+        let bytes = std::fs::read(m).map_err(|e| format!("{}: {e}", m.display()))?;
+        let icon = render(&bytes, px)?;
+        let (cx, cy) = ((k as u32 % cols) * cell + px / 4, (k as u32 / cols) * cell + px / 4);
+        for (y0, _, ink) in bands {
+            for (j, p) in icon.data().as_chunks::<4>().0.iter().enumerate() {
+                let a = u32::from(p[3]);
+                let (x, y) = (cx + j as u32 % px, y0 + cy + j as u32 / px);
+                let o = ((y * w + x) * 4) as usize;
+                if let Some(d) = base.data_mut().get_mut(o..o + 3) {
+                    for (c, inkc) in d.iter_mut().zip(ink) {
+                        *c = ((u32::from(*c) * (255 - a) + u32::from(inkc) * a) / 255) as u8;
+                    }
+                }
+            }
+        }
+    }
+    let z = zoom.max(1);
+    let mut big = Pixmap::new(w * z, band * 2 * z).ok_or("sheet too large")?;
+    let src = base.data().to_vec();
+    for (i, p) in big.data_mut().as_chunks_mut::<4>().0.iter_mut().enumerate() {
+        let (x, y) = ((i as u32 % (w * z)) / z, (i as u32 / (w * z)) / z);
+        let o = ((y * w + x) * 4) as usize;
+        if let Some(s) = src.get(o..o + 4) {
+            p.copy_from_slice(s);
+        }
+    }
+    Ok(big)
+}
+
+/// `cargo xtask icons [--check | --sheet <out.png> [--px N] [--zoom N]]`.
+pub fn run(root: &Path, args: &[String]) -> Result<i32, String> {
+    match args.first().map(String::as_str) {
+        None => {
+            println!("icons: wrote {} PNG(s) from assets/ui/svg/", build(root)?);
+            Ok(0)
+        }
+        Some("--check") => {
+            let bad = check(root)?;
+            for b in &bad {
+                println!("{b}");
+            }
+            println!("icons: {} breach(es)", bad.len());
+            Ok(i32::from(!bad.is_empty()))
+        }
+        Some("--sheet") => {
+            let out = args.get(1).ok_or("--sheet needs an output path")?;
+            let num = |flag: &str, d: u32| -> Result<u32, String> {
+                match args.iter().position(|a| a == flag) {
+                    Some(i) => args.get(i + 1).and_then(|v| v.parse().ok()).ok_or(format!("{flag} needs a number")),
+                    None => Ok(d),
+                }
+            };
+            let pm = sheet(root, num("--px", 16)?, 8, num("--zoom", 4)?)?;
+            pm.save_png(out).map_err(|e| format!("{out}: {e}"))?;
+            for (k, m) in masters(root)?.iter().enumerate() {
+                println!("{k:>3} {}", stem(m)?);
+            }
+            Ok(0)
+        }
+        Some(o) => Err(format!("unknown icons option '{o}' (none | --check | --sheet <out.png>)")),
+    }
+}
diff --git a/xtask/src/icons_tests.rs b/xtask/src/icons_tests.rs
new file mode 100644
index 000000000..82bf6acb6
--- /dev/null
+++ b/xtask/src/icons_tests.rs
@@ -0,0 +1,58 @@
+//! Pins the icon pipeline (#661): the masters' house rules, the render, and that every committed
+//! PNG under assets/ui/ is in step with its SVG master (a master edited without `cargo xtask icons`
+//! fails here, not in the running app).
+//! Provenance: our own pipeline (docs/decisions/661-icon-set.md).
+
+use crate::icons::{self, PNG_PX};
+
+const CLEAN: &str = r#"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4 12H20"/></svg>"#;
+
+#[test]
+fn lint_accepts_a_clean_master() {
+    assert_eq!(icons::lint(CLEAN), Vec::<String>::new());
+}
+
+#[test]
+fn lint_refuses_raster_scripts_text_and_external_refs() {
+    for bad in [
+        r#"<image href="x.png"/>"#,
+        "<script>alert(1)</script>",
+        "<text>G0</text>",
+        r#"<use href="other.svg#a"/>"#,
+        r#"<rect fill="url(#g)"/>"#,
+        "<style>path{}</style>",
+    ] {
+        let svg = CLEAN.replace("</svg>", &format!("{bad}</svg>"));
+        assert!(!icons::lint(&svg).is_empty(), "lint let through {bad}");
+    }
+}
+
+#[test]
+fn lint_refuses_off_grid_sizes_caps_and_weights() {
+    let off_grid = CLEAN.replace("0 0 24 24", "0 0 64 64");
+    let sized = CLEAN.replace("<svg ", r#"<svg width="32" "#);
+    let butt = CLEAN.replace(r#"stroke-linecap="round""#, r#"stroke-linecap="butt""#);
