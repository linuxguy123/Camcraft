@@ -0,0 +1,89 @@
+//! #870: the WCS page applies its typed origin from a fixed footer -
+//! Set origin beside Close, apart from the per-field controls - flags
+//! edits that are not applied yet, and says where the origin is in
+//! words under its heading. Structural: painted text, AccessKit labels
+//! and coarse placement; no pixels.
+//! Provenance: our own page law, specced from the Makera Z1 user's
+//! first-cut report on #870; no vendor material consulted.
+
+use super::*;
+use camcraft_app::stock::StockShape;
+
+fn wcs_page_on_a_block() -> Harness<'static, ShellUi> {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(1280.0, 900.0))
+        .build_ui_state(frame, ShellUi::blank());
+    {
+        let st = &mut h.state_mut().state;
+        let shape = StockShape::Box { dx: 100.0, dy: 50.0, dz: 20.0 };
+        st.pending.push_back(CommandKind::SetStock { shape, pos: [0.0, 0.0, 0.0], yaw_deg: 0.0 });
+        st.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+        st.drain_actions();
+        let b = model::stock_world_aabb_for(&st.world, camcraft_app::setup::active(&st.world).as_deref())
+            .expect("stock box");
+        st.pending.push_back(CommandKind::SetWcs {
+            pos: [b.min.x, b.min.y, b.max.z],
+            roll_deg: 0.0,
+            pitch_deg: 0.0,
+            yaw_deg: 0.0,
+        });
+        st.drain_actions();
+        crate::actions::target(st, UiTarget::Wcs);
+    }
+    h.run_steps(3);
+    h
+}
+
+fn has_text(h: &Harness<'static, ShellUi>, want: &str) -> bool {
+    super::structural::painted(h).iter().any(|(t, _)| t == want)
+}
+
+#[test]
+fn the_page_says_where_the_origin_is_in_words() {
+    let _g = snapshot_guard();
+    let h = wcs_page_on_a_block();
+    let texts = super::structural::painted(&h);
+    assert!(
+        texts.iter().any(|(t, _)| t.ends_with(" origin: top of stock, front-left corner (X0 Y0 Z0)")),
+        "the WCS page states where its origin is: {texts:?}"
+    );
+}
+
+#[test]
+fn set_origin_sits_in_the_footer_beside_close_and_nowhere_else() {
+    let _g = snapshot_guard();
+    let h = wcs_page_on_a_block();
+    let set = h.get_by_label("Set origin").rect();
+    let close = h.get_by_label("Close").rect();
+    assert!((set.center().y - close.center().y).abs() < 2.0, "one row: {set:?} / {close:?}");
+    assert!(set.max.x <= close.min.x, "Set origin comes first, then Close: {set:?} / {close:?}");
+    // The footer is under every per-field control of the page.
+    let level = h.get_by_label("Level").rect();
+    assert!(set.min.y > level.max.y, "the footer is below the page body: {set:?} / {level:?}");
+    // The body no longer carries its own apply button.
+    assert!(h.query_all_by_label("Set Origin").count() == 0, "no second, body-level apply button");
+    assert!(h.query_all_by_label("Set origin").count() == 1, "exactly one Set origin");
+    assert!(!has_text(&h, super::super::wcs_footer::NOT_APPLIED), "nothing pending on a fresh page");
+}
+
+#[test]
+fn a_typed_origin_is_flagged_until_set_origin_applies_it() {
+    let _g = snapshot_guard();
+    let mut h = wcs_page_on_a_block();
+    h.state_mut().state.wcs_ui.x += 5.0;
+    h.run_steps(2);
+    assert!(has_text(&h, super::super::wcs_footer::NOT_APPLIED), "a typed, unapplied origin is flagged");
+    h.get_by_label("Set origin").click();
+    h.run_steps(3);
+    assert!(!has_text(&h, super::super::wcs_footer::NOT_APPLIED), "applied: no flag");
+    let st = &h.state().state;
+    let placed = camcraft_app::setup::wcs_entity(&st.world, camcraft_app::setup::active(&st.world).as_deref())
+        .and_then(|e| model::transform_of(&st.world, &e))
+        .expect("placed");
+    let b = model::stock_world_aabb_for(&st.world, camcraft_app::setup::active(&st.world).as_deref()).expect("box");
+    assert!((placed.pos.x - (b.min.x + 5.0)).abs() < 1e-9, "Set origin placed the typed X: {placed:?}");
+    // A turn typed as another angle triple of the same rotation is not pending.
+    h.state_mut().state.wcs_ui.yaw_deg = 360.0;
+    h.run_steps(2);
+    assert!(!has_text(&h, super::super::wcs_footer::NOT_APPLIED), "yaw 360 is the placed rotation");
+}
diff --git a/crates/ui/src/egui_app/wcs_footer.rs b/crates/ui/src/egui_app/wcs_footer.rs
new file mode 100644
index 000000000..67091a0a6
--- /dev/null
+++ b/crates/ui/src/egui_app/wcs_footer.rs
@@ -0,0 +1,60 @@
+//! Issue #870: the WCS page's fixed footer - Set origin beside Close, and an "Origin not applied" flag while the fields differ from the placed WCS - and the header line that says where the origin is in words; our own page law, specced from a user's first-cut report (they cut air, then hunted for the button that applies the origin), no vendor material consulted.
+
+use egui::{RichText, Ui};
+
+use camcraft_app::geometry::quat_from_euler;
+use camcraft_app::geometry::IDENTITY_Q;
+use camcraft_app::{model, setup, units};
+
+use crate::state::State;
+
+/// The flag shown beside the footer's buttons while edits are pending.
+pub(super) const NOT_APPLIED: &str = "Origin not applied";
+
+/// The header line: "G54 origin: top of stock, front-left corner (X0 Y0 Z0)".
+pub(super) fn origin_line(ui: &mut Ui, state: &State) {
+    ui.label(RichText::new(origin_text(state)).strong());
+}
+
+pub(super) fn origin_text(state: &State) -> String {
+    let active = setup::active(&state.world);
+    let label = setup::wcs_label(&state.world, active.as_deref());
+    let u = state.units();
+    let words = camcraft_app::setup_origin::origin_words(&state.world, active.as_deref(), &|v| units::len(v, u, 2));
+    format!("{label} origin: {words} (X0 Y0 Z0)")
+}
+
+/// Whether the page's fields hold edits the placed WCS does not carry
+/// yet. An unplaced WCS sits at the world origin, square.
+pub(super) fn pending(state: &State) -> bool {
+    let active = setup::active(&state.world);
+    let placed = setup::wcs_entity(&state.world, active.as_deref()).and_then(|e| model::transform_of(&state.world, &e));
+    let (pos, rot) = placed.map_or(([0.0; 3], IDENTITY_Q), |l| ([l.pos.x, l.pos.y, l.pos.z], l.rot));
+    let d = &state.wcs_ui;
+    // A non-finite draft counts as pending: it is not what is placed.
+    let moved = [d.x, d.y, d.z].iter().zip(pos).any(|(a, b)| (a - b).abs().partial_cmp(&1e-9).is_none_or(|o| o.is_gt()));
+    // Compared as rotations, not as angle triples: two triples can name
+    // one rotation (yaw 180 and -180).
+    let q = quat_from_euler(d.roll_deg.to_radians(), d.pitch_deg.to_radians(), d.yaw_deg.to_radians());
+    let dot: f64 = q.iter().zip(rot).map(|(a, b)| a * b).sum();
+    let turned = dot.abs().partial_cmp(&(1.0 - 1e-9)).is_none_or(|o| o.is_lt());
+    moved || turned
+}
+
+/// The footer row: Set origin, Close, and the pending flag. Returns
+/// whether Close was clicked.
+pub(super) fn footer(ui: &mut Ui, state: &mut State) -> bool {
+    let waiting = pending(state);
+    let warn = super::colorvision::text_inks(ui, &state.world).warn;
+    let mut close = false;
+    ui.horizontal(|ui| {
+        if ui.button("Set origin").clicked() {
+            super::pages::apply_wcs_drafts(state);
+        }
+        close = ui.button("Close").clicked();
+        if waiting {
+            ui.label(RichText::new(NOT_APPLIED).color(warn));
+        }
+    });
+    close
+}
diff --git a/docs/decisions/870-wcs-set-origin-footer.md b/docs/decisions/870-wcs-set-origin-footer.md
new file mode 100644
index 000000000..386a9d5b5
--- /dev/null
+++ b/docs/decisions/870-wcs-set-origin-footer.md
@@ -0,0 +1,17 @@
+# #870: the WCS page's Set origin in its footer, and the origin said in words
+
+- **Chosen:** *Set origin* moves out of the page body (where it sat beside *Level*, among the quarter turns) into the property pane's fixed footer, on one row with *Close*. The row is drawn by `egui_app::wcs_footer`; every other page keeps its plain *Close*.
+  - Why: the user's report. The button that applies typed values was hard to find among the per-field controls. The footer stays put while the body scrolls.
+  - Dropped: a second, body-level apply button kept for habit. Two buttons with one action is the clutter the report is about.
+- **Chosen:** an *Origin not applied* flag in the footer, in the warning ink, while the typed fields differ from the placed WCS. The position is compared to 1e-9 mm. The angles are compared as rotations (quaternion dot product), so yaw 360 or -180/180 never reads as an edit. A non-finite field reads as pending.
+  - Dropped: a confirm-on-close prompt. The drafts survive a close and reopen until the document changes (`sync_setup_ui`), so a close loses nothing silently, and the flag makes the state visible. A modal would add a click to every close.
+  - Dropped: applying on close. Close then becomes a second, hidden apply, and the Prime Directive prefers a visible commit for something that moves every coordinate of the program.
+- **Chosen:** the origin's place in words, from a new pure module `app::setup_origin` (`origin_words`, `words_on`). It is used by the WCS page's header line (`G54 origin: top of stock, front-left corner (X0 Y0 Z0)`) and by the setup sheet's new `origin:` line.
+  - The reference box is the one the page's anchor grid uses: the stock box, else the model's bounds.
+  - X is left/right, Y front/back (the operator at -Y), Z bottom/top. The 27 anchor points are named within 1 µm, the tolerance of the anchor buttons' exact writes.
+  - Any other point is given as signed distances from the box's left side, front and top. The words never claim a corner the origin is not on.
+  - A non-finite origin or box says "not known".
+- **Viewport marker:** the WCS axis triad already marks the origin in the viewport. Nothing was added there.
+- **Docs:** `docs/user-guide/work-origin.md`, a short page on where the origin is shown and how to change it.
+- **Kept out of #759's way:** #759 (open, draft) splits the WCS page body into `wcs_page.rs` and has its own *Set Origin* in the quarter-turn rows. This PR touches the body in one place (the button removed) and puts its new code in its own files. Whichever lands second drops the body button and keeps the footer.
+- **Left as is:** the words read the world-frame box. On a rotated or aligned setup (#326), "left" and "front" are the world's, as the anchor grid's compass names are.
