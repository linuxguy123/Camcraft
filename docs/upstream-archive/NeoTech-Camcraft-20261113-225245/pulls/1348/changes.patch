From b52999683ecaea38a485cb74cf1ec786d2132d15 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 17:49:02 -0800
Subject: [PATCH] test(app): coarse_rims sets the Tool cutting field

The Tool literal in coarse_rims.rs predates the cutting field and
stopped the app test build on main. Set it to an empty Vec, as the
other test literals do (a9a4bddd).

Fixes #1345

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/tests/coarse_rims.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/crates/app/tests/coarse_rims.rs b/crates/app/tests/coarse_rims.rs
index 7b67d4228..d10ddae9b 100644
--- a/crates/app/tests/coarse_rims.rs
+++ b/crates/app/tests/coarse_rims.rs
@@ -138,6 +138,7 @@ fn thread_mill(diameter: f64) -> Tool {
         orientation: None,
         turning: None,
         catalog: camcraft_tools::catalog_fields::ToolCatalog::default(),
+        cutting: Vec::new(),
     }
 }
 
