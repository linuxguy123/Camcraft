From ac201909276ec229e4baf5e28a2dbeae6366824f Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Fri, 13 Nov 2026 10:08:32 -0800
Subject: [PATCH] fix(ui): the window-icon fallback logs through the diag seam

window_icon() reported a failed icon decode with a direct eprintln!,
which the diag law test (shared_ui_code_prints_only_through_the_diag_seam)
rejects: a browser drops a direct print. The line now goes through
diag_warn!, same text, same behaviour (None, the window opens without
an icon).

Pinned by diag::tests::shared_ui_code_prints_only_through_the_diag_seam
(red with eprintln! restored at app_icon.rs:25, green here).

Fixes #1475
---
 crates/ui/src/egui_app/app_icon.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/ui/src/egui_app/app_icon.rs b/crates/ui/src/egui_app/app_icon.rs
index ea4b2062..54fd81fe 100644
--- a/crates/ui/src/egui_app/app_icon.rs
+++ b/crates/ui/src/egui_app/app_icon.rs
@@ -22,7 +22,7 @@ pub fn window_icon() -> Option<Icon> {
     match made {
         Ok(i) => Some(i),
         Err(e) => {
-            eprintln!("{e} - the window opens without an icon");
+            diag_warn!("{e} - the window opens without an icon");
             None
         }
     }
