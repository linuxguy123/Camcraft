+/// The A-turning feed words of `program`, in the program's own unit.
+fn a_feeds(program: &str) -> Vec<f64> {
+    program
+        .lines()
+        .filter(|l| (l.contains("G01") || l.contains("G02") || l.contains("G03")) && word(l, 'A').is_some())
+        .filter_map(|l| word(l, 'F'))
