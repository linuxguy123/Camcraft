diff --git a/crates/motion/src/sinker_cavity.rs b/crates/motion/src/sinker_cavity.rs
new file mode 100644
index 000000000..24c836cf2
--- /dev/null
+++ b/crates/motion/src/sinker_cavity.rs
@@ -0,0 +1,311 @@
+//! A sinker EDM cavity read from picked part faces (#547): one level
+//! floor and the vertical walls standing on every edge of it, checked
+//! face by face and edge by edge, and refused by name for anything
+//! else: nothing is guessed from a face set that does not spell one
+//! cavity.
+//!
+//! Provenance: our own reading over the planar-face boundary
+//! representation this repo machines from, by the published
+//! depression-feature rule (a pocket is a face whose boundary edges are
+//! concave: Joshi & Chang, "Graph-based heuristics for recognition of
+//! machined features from a 3D solid model", CAD 20(2), 1988), with
+//! Newell's method for a planar ring's vector area (Sutherland, Sproull
+//! & Schumacker, "A characterization of ten hidden-surface algorithms",
+//! ACM Computing Surveys 6(1), 1974). General die-sink EDM practice from
+//! public machine-tool handbooks: the electrode is the cavity's shape,
+//! fed down Z. No vendor material.
+//!
+//! Robustness (Prime Directive): total on any input. A non-finite or
+//! out-of-range coordinate, a face with no area, a boundary that does
+//! not close, a curved or leaning wall, a second floor, a wall of
+//! another cavity, or a floor edge no wall stands on is each a refusal
+//! that names the face; no arithmetic runs on an unchecked number.
+
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::machining2d::GenError;
+
+/// Two points this close are the same point, mm (1 nm: the weld lattice
+/// of `geometry::feature`).
+pub const TOL: f64 = 1e-6;
+/// A unit normal this close to +Z is level.
+const LEVEL: f64 = 0.999_999;
+/// A unit normal with |z| under this is vertical.
+const VERTICAL: f64 = 1e-6;
+/// A ring under this area bounds nothing, mm².
+const MIN_AREA: f64 = 1e-9;
+/// The least rise of a wall above its floor, mm.
+pub const MIN_DEPTH: f64 = 1e-3;
+/// Coordinates beyond this are no part on any machine, mm - and the
+/// bound that keeps every product below finite.
+const COORD_LIMIT: f64 = 1e6;
+
+/// One picked face, in world coordinates.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PickedFace {
+    /// How a refusal names it ("face 0x12ab of 'part'").
+    pub label: String,
+    /// The outward unit normal by the facets' winding: it points into
+    /// the air, so into the cavity for a cavity's own faces.
+    pub normal: Point3,
+    /// A welded smooth (curved) face rather than one plane.
+    pub curved: bool,
+    /// Its boundary refused to close into rings.
+    pub open: bool,
+    /// The outer boundary ring, in order (either winding).
+    pub outer: Vec<Point3>,
+}
+
+/// One cavity: its floor's outline and the heights its walls span.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Cavity {
+    /// The floor's outer ring in world XY, counter-clockwise from above.
+    pub outline: Vec<Point2>,
+    pub floor_z: f64,
+    /// The highest point of the picked walls: the cavity's mouth.
+    pub top_z: f64,
+    /// How many walls stand on the floor.
+    pub walls: usize,
+}
+
+fn refuse<T>(why: String) -> Result<T, GenError> {
+    Err(GenError::Invalid(format!("electrode from faces: {why}")))
+}
+
+fn in_range(p: Point3) -> bool {
+    p.is_finite() && p.x.abs() < COORD_LIMIT && p.y.abs() < COORD_LIMIT && p.z.abs() < COORD_LIMIT
+}
+
+/// Newell's vector area of a ring: its length is the ring's area, its
+/// direction the ring's plane normal.
+fn vector_area(ring: &[Point3]) -> Point3 {
+    let Some(&o) = ring.first() else { return Point3::ZERO };
+    let mut s = Point3::ZERO;
+    for w in ring.windows(2) {
+        if let [a, b] = w {
+            let c = (*a - o).cross(*b - o);
+            s = Point3::new(s.x + c.x, s.y + c.y, s.z + c.z);
+        }
+    }
+    Point3::new(0.5 * s.x, 0.5 * s.y, 0.5 * s.z)
+}
+
+/// Every refusal one face can earn on its own, by name.
+fn check_face(f: &PickedFace) -> Result<(), GenError> {
+    let l = &f.label;
+    if f.curved {
+        return refuse(format!(
+            "{l} is a curved wall - an electrode is generated from planar walls only (a non-planar wall is not modelled)"
+        ));
+    }
+    if f.open || f.outer.len() < 3 {
+        return refuse(format!("{l} has an open loop - its boundary does not close, so it bounds no face"));
+    }
+    if !f.normal.is_finite() || !f.outer.iter().all(|p| p.is_finite()) {
+        return refuse(format!("{l} has a coordinate that is not a finite number"));
+    }
+    if !f.outer.iter().copied().all(in_range) {
+        return refuse(format!("{l} lies outside the machinable range ({COORD_LIMIT:e} mm)"));
+    }
+    let len = f.normal.dot(f.normal).sqrt();
+    if (len - 1.0).abs() > 1e-6 {
+        return refuse(format!("{l} has no usable normal - re-pick it"));
+    }
+    let Some(&o) = f.outer.first() else {
+        return refuse(format!("{l} has an open loop - its boundary does not close, so it bounds no face"));
+    };
+    if let Some(off) = f.outer.iter().map(|p| (*p - o).dot(f.normal).abs()).find(|d| *d > 10.0 * TOL) {
+        return refuse(format!(
+            "{l} is not planar - its boundary leaves its plane by {off:.6} mm (a non-planar wall is not modelled)"
+        ));
+    }
+    let a = vector_area(&f.outer);
+    if a.dot(a).sqrt() < MIN_AREA {
+        return refuse(format!("{l} has zero area - it bounds nothing"));
+    }
+    Ok(())
+}
+
+fn xy(p: Point3) -> Point2 {
+    Point2::new(p.x, p.y)
+}
+
+/// The floor ring in world XY, counter-clockwise from above, with
+/// repeated points dropped.
+fn floor_ring(f: &PickedFace) -> Vec<Point2> {
+    let mut pts: Vec<Point2> = Vec::with_capacity(f.outer.len());
+    for p in f.outer.iter().copied().map(xy) {
+        if pts.last().is_none_or(|q| (q.x - p.x).hypot(q.y - p.y) > TOL) {
+            pts.push(p);
+        }
+    }
+    if pts.len() > 1 && pts.first().zip(pts.last()).is_some_and(|(a, b)| (a.x - b.x).hypot(a.y - b.y) <= TOL) {
+        pts.pop();
+    }
+    let n = pts.len();
+    let signed: f64 = (0..n)
+        .filter_map(|i| Some((pts.get(i)?, pts.get((i + 1) % n)?)))
+        .map(|(a, b)| a.x * b.y - b.x * a.y)
+        .sum();
+    if signed < 0.0 {
+        pts.reverse();
+    }
+    pts
+}
+
+/// One wall's stand on the floor ring: the spans `(edge, from, to)` in
+/// mm along each floor edge its bottom edge runs on.
+fn stand_of(w: &PickedFace, ring: &[Point2], floor_z: f64) -> Result<Vec<(usize, f64, f64)>, GenError> {
+    let l = &w.label;
+    let (lo, hi) = w.outer.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(lo, hi), p| (lo.min(p.z), hi.max(p.z)));
+    if lo < floor_z - TOL {
+        return refuse(format!(
+            "{l} reaches Z {lo:.3}, below the picked floor at Z {floor_z:.3} - it is not a wall of this cavity (faces from different cavities?)"
+        ));
+    }
+    if hi < floor_z + MIN_DEPTH {
+        return refuse(format!("{l} does not rise above the picked floor at Z {floor_z:.3} - it is not a wall of this cavity"));
+    }
+    let m = w.outer.len();
+    let bottoms: Vec<(Point2, Point2)> = (0..m)
+        .filter_map(|i| Some((*w.outer.get(i)?, *w.outer.get((i + 1) % m)?)))
+        .filter(|(p, q)| (p.z - floor_z).abs() <= TOL && (q.z - floor_z).abs() <= TOL)
+        .map(|(p, q)| (xy(p), xy(q)))
+        .collect();
+    let n = ring.len();
+    let mut spans = Vec::new();
+    for i in 0..n {
+        let (Some(&a), Some(&b)) = (ring.get(i), ring.get((i + 1) % n)) else { continue };
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        if len <= TOL {
+            continue;
+        }
+        let u = ((b.x - a.x) / len, (b.y - a.y) / len);
+        for (p, q) in &bottoms {
+            let off = |r: &Point2| (u.0 * (r.y - a.y) - u.1 * (r.x - a.x)).abs();
+            if off(p) > TOL || off(q) > TOL {
+                continue;
+            }
+            let along = |r: &Point2| u.0 * (r.x - a.x) + u.1 * (r.y - a.y);
+            let (tp, tq) = (along(p), along(q));
+            let (from, to) = (tp.min(tq).max(0.0), tp.max(tq).min(len));
+            if to - from <= TOL {
+                continue;
+            }
+            // Into the cavity is the left of a counter-clockwise ring.
+            if w.normal.x * -u.1 + w.normal.y * u.0 < LEVEL {
+                return refuse(format!(
+                    "{l} stands on the picked floor but faces away from it - it is the outside of a boss or of another cavity, not a wall of this one"
+                ));
+            }
+            spans.push((i, from, to));
+        }
+    }
+    if spans.is_empty() {
+        return refuse(format!(
+            "{l} does not stand on the picked floor - it is a face of a different cavity (or no wall of this one)"
+        ));
+    }
+    Ok(spans)
+}
+
+/// The cavity a face set spells: exactly one level floor facing up, and
+/// vertical planar walls standing on every edge of its outer ring.
+///
+/// # Errors
+/// By name: no faces; a face that is curved, open, non-finite, out of
+/// range, non-planar, zero-area, leaning or facing down; no floor or
+/// more than one; no walls; a wall of another cavity; a floor edge with
+/// no wall (the walls do not close).
+pub fn cavity_of(faces: &[PickedFace]) -> Result<Cavity, GenError> {
+    if faces.is_empty() {
+        return refuse("no faces are picked - pick the cavity's floor and the walls standing on it".into());
+    }
+    let (mut floors, mut walls) = (Vec::new(), Vec::new());
+    for f in faces {
+        check_face(f)?;
+        let nz = f.normal.z;
+        if nz >= LEVEL {
+            floors.push(f);
+        } else if nz.abs() <= VERTICAL {
+            walls.push(f);
+        } else if nz <= -LEVEL {
+            return refuse(format!("{} faces down - a cavity's floor faces up and its walls are vertical", f.label));
+        } else {
+            return refuse(format!(
+                "{} leans {:.3} degrees off vertical - a drafted wall or a tilted floor is not modelled",
+                f.label,
+                nz.abs().min(1.0).asin().to_degrees()
+            ));
+        }
+    }
+    let floor = match floors.as_slice() {
+        [one] => *one,
+        [] => return refuse("no floor is picked - pick the cavity's level floor with its walls".into()),
+        many => {
+            let names: Vec<&str> = many.iter().map(|f| f.label.as_str()).collect();
+            return refuse(format!(
+                "{} floors are picked ({}) - one cavity has one level floor; these are faces from different cavities, or a stepped cavity, which is not modelled",
+                many.len(),
+                names.join(", ")
+            ));
+        }
+    };
+    if walls.is_empty() {
+        return refuse(format!(
+            "only the floor ({}) is picked - pick the walls standing on it too (they give the cavity its depth)",
+            floor.label
+        ));
+    }
+    let ring = floor_ring(floor);
+    if ring.len() < 3 {
+        return refuse(format!("{} has zero area - it bounds nothing", floor.label));
+    }
+    let floor_z = floor.outer.iter().map(|p| p.z).sum::<f64>() / floor.outer.len() as f64;
+    if let Some(off) = floor.outer.iter().map(|p| (p.z - floor_z).abs()).find(|d| *d > 10.0 * TOL) {
+        return refuse(format!(
+            "{} is not level - its Z leaves the floor's by {off:.6} mm (a tilted floor is not modelled)",
+            floor.label
+        ));
+    }
+    let n = ring.len();
+    let mut cover: Vec<Vec<(f64, f64)>> = vec![Vec::new(); n];
+    let mut top_z = f64::NEG_INFINITY;
+    for w in &walls {
+        for (i, from, to) in stand_of(w, &ring, floor_z)? {
+            if let Some(c) = cover.get_mut(i) {
+                c.push((from, to));
+            }
+        }
+        top_z = w.outer.iter().fold(top_z, |t, p| t.max(p.z));
+    }
+    for (i, spans) in cover.iter_mut().enumerate() {
+        let (Some(&a), Some(&b)) = (ring.get(i), ring.get((i + 1) % n)) else { continue };
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        if len <= TOL {
+            continue;
+        }
+        spans.sort_by(|p, q| p.0.total_cmp(&q.0));
+        let mut reach = 0.0_f64;
+        for (from, to) in spans.iter() {
+            if *from > reach + TOL {
+                break;
+            }
+            reach = reach.max(*to);
+        }
+        if len - reach > TOL {
+            return refuse(format!(
+                "the picked walls do not close around the floor: its edge from ({:.3}, {:.3}) to ({:.3}, {:.3}) has no wall for {:.3} mm - pick every wall of the cavity (an open-sided cavity is not modelled)",
+                a.x,
+                a.y,
+                b.x,
+                b.y,
+                len - reach
+            ));
+        }
+    }
+    if !(top_z.is_finite() && top_z - floor_z >= MIN_DEPTH) {
+        return refuse(format!("the walls do not rise above the floor at Z {floor_z:.3} - the cavity has no depth"));
+    }
+    Ok(Cavity { outline: ring, floor_z, top_z, walls: walls.len() })
+}
diff --git a/crates/motion/src/sinker_electrode.rs b/crates/motion/src/sinker_electrode.rs
new file mode 100644
index 000000000..4198f3d22
--- /dev/null
+++ b/crates/motion/src/sinker_electrode.rs
@@ -0,0 +1,325 @@
+//! The sinker EDM electrode a cavity calls for (#547): the cavity's
+//! outline offset inward by the electrode's undersize (and an orbit
+//! radius, when one is stated), extended above the cavity's mouth to a
+//! holder stub - as the box electrode of #541, or a refusal by name.
+//!
+//! Provenance: general die-sink EDM practice from public machine-tool
+//! handbooks - an electrode is the cavity's shape made smaller by a
+//! per-side undersize, and smaller again by the radius of any orbit it
+//! is to run, so its burn reaches the finished size; it stands proud of
+//! the work so its holder never enters the cavity. The inward offset is
+//! the polygon offset of the geometry crate (`geo2d::Region`, Clipper2's
+//! published algorithm: Vatti clipping with mitred joins), and the
+//! obstruction test is Sutherland & Hodgman's polygon clipping
+//! ("Reentrant polygon clipping", CACM 17(1), 1974) of each facet
+//! against the cavity's column. The refusals are our own design (#290
+//! D1-D10). No vendor material.
+//!
+//! What it makes: the stock sim burns an electrode with the box atom
+//! (`stock_sim::simulate_box`, #541) - an axis-aligned rectangular face.
+//! So only a cavity whose outline IS an axis-aligned rectangle yields an
+//! electrode here; every other outline is refused by name rather than
+//! handed to a sim that would burn the wrong shape (#1152 owns the body
+//! electrode). The offset outline is still computed and carried, for
+//! that successor.
+
+use crate::geo2d::{Loop, Point2, Region};
+use crate::geometry::{Point3, Triangle};
+use crate::machining2d::GenError;
+use crate::sinker_cavity::{Cavity, MIN_DEPTH, TOL};
+use crate::tools::Tool;
+
+/// Largest electrode face side, mm - the bound `Tool::is_sane` puts on
+/// the record's sizes.
+const MAX_SIDE: f64 = 500.0;
+/// Smallest electrode face side - and holder stub - worth making, mm.
+const MIN_SIDE: f64 = 1e-3;
+/// Slack between the offset polygon and the arithmetic it must agree
+/// with, mm: a few units of the offset's own lattice.
+const OFFSET_SLACK: f64 = 1e-5;
+/// How far inside the cavity's column a facet must reach to stand in
+/// it, mm - the cavity's own walls and floor lie ON the column's faces.
+const CLEAR: f64 = 1e-4;
+
+/// The refusal of a cavity the box atom cannot burn, said once.
+pub const NON_RECTANGULAR: &str = "the stock sim burns a rectangular electrode face only, so an electrode for a non-rectangular cavity is not generated yet (#1152)";
+
+/// What the user states about the electrode, mm.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ElectrodeSpec {
+    /// The undersize per side: how far the electrode stands inside the
+    /// finished wall (the condition's, #543).
+    pub undersize: f64,
+    /// The radius of the orbit the electrode will run, when one is
+    /// stated (#544): the electrode is made that much smaller again, so
+    /// the orbit's sweep - not the electrode at rest - reaches the size.
+    pub orbit: Option<f64>,
+    /// How far the electrode stands above the cavity's mouth: the stub
+    /// its holder grips, kept out of the work.
+    pub stub: f64,
+    /// The pickup offset: from the electrode's top face up to the
+    /// reference the control measures it from.
+    pub pickup: f64,
+}
+
+/// The electrode a cavity calls for, world mm.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ElectrodeBox {
+    /// The electrode face's X and Y size.
+    pub face: (f64, f64),
+    /// The face centre: where the burn is made.
+    pub center: (f64, f64),
+    /// The finished cavity's X and Y size.
+    pub cavity: (f64, f64),
+    pub floor_z: f64,
+    pub top_z: f64,
+    /// The cavity's depth, mouth to floor.
+    pub depth: f64,
+    /// The electrode's length below its holder: the depth plus the stub.
+    pub length: f64,
+    pub pickup: f64,
+    /// The inward offset per side: the undersize plus the orbit radius.
+    pub inset: f64,
+    /// The orbit radius the electrode was made for (0 for none).
+    pub orbit: f64,
+    /// The offset outline, counter-clockwise: the electrode's section.
+    pub outline: Vec<Point2>,
+}
+
+impl ElectrodeBox {
+    /// The electrode as #541's tool record.
+    #[must_use]
+    pub fn tool(&self) -> Tool {
+        camcraft_tools::electrode::electrode_tool(self.face.0, self.face.1, self.length, self.pickup)
+    }
+}
+
+fn refuse<T>(why: String) -> Result<T, GenError> {
+    Err(GenError::Invalid(format!("electrode from faces: {why}")))
+}
+
+/// The axis-aligned rectangle a simple ring IS, within `tol`: every
+/// vertex on its bounds, all four corners present, and the ring's area
+/// the bounds' own. `None` for any other shape - a rotated rectangle, a
+/// rounded corner, a notch.
+#[must_use]
+pub fn rect_of(ring: &[Point2], tol: f64) -> Option<(Point2, Point2)> {
+    if ring.len() < 4 || !ring.iter().all(|p| p.x.is_finite() && p.y.is_finite()) {
+        return None;
+    }
+    let (mut lo, mut hi) = (Point2::new(f64::INFINITY, f64::INFINITY), Point2::new(f64::NEG_INFINITY, f64::NEG_INFINITY));
+    for p in ring {
+        lo = Point2::new(lo.x.min(p.x), lo.y.min(p.y));
+        hi = Point2::new(hi.x.max(p.x), hi.y.max(p.y));
+    }
+    let (w, h) = (hi.x - lo.x, hi.y - lo.y);
+    if !(w > tol && h > tol) {
+        return None;
+    }
+    let near = |a: f64, b: f64| (a - b).abs() <= tol;
+    if !ring.iter().all(|p| near(p.x, lo.x) || near(p.x, hi.x) || near(p.y, lo.y) || near(p.y, hi.y)) {
+        return None;
+    }
+    let corners = [(lo.x, lo.y), (hi.x, lo.y), (hi.x, hi.y), (lo.x, hi.y)];
+    if !corners.iter().all(|c| ring.iter().any(|p| near(p.x, c.0) && near(p.y, c.1))) {
+        return None;
+    }
+    let n = ring.len();
+    let area: f64 = (0..n)
+        .filter_map(|i| Some((ring.get(i)?, ring.get((i + 1) % n)?)))
+        .map(|(a, b)| a.x * b.y - b.x * a.y)
+        .sum::<f64>()
+        .abs()
+        * 0.5;
+    (area >= w * h - tol * 2.0 * (w + h)).then_some((lo, hi))
+}
+
+fn check_spec(s: &ElectrodeSpec) -> Result<f64, GenError> {
+    if !(s.undersize.is_finite() && s.undersize >= 0.0) {
+        return refuse(format!("the undersize {} is not a finite, non-negative number of mm", s.undersize));
+    }
+    let orbit = s.orbit.unwrap_or(0.0);
+    if !(orbit.is_finite() && orbit >= 0.0) {
+        return refuse(format!("the orbit radius {orbit} is not a finite, non-negative number of mm"));
+    }
+    if !(s.stub.is_finite() && s.stub >= MIN_SIDE) {
+        return refuse(format!(
+            "the holder stub {} must be a positive length (at least {MIN_SIDE} mm) - the electrode stands that far above the cavity so its holder stays out of the work",
+            s.stub
+        ));
+    }
+    if !(s.pickup.is_finite() && s.pickup >= 0.0) {
+        return refuse(format!("the pickup offset {} is not a finite, non-negative number of mm", s.pickup));
+    }
+    Ok(orbit)
+}
+
+/// The electrode `spec` asks for under `cavity`.
+///
+/// # Errors
+/// By name: a garbled spec; an outline that crosses itself; a cavity
+/// that is not an axis-aligned rectangle ([`NON_RECTANGULAR`]); an inset
+/// that consumes the cavity or splits it; a face beyond the tool
+/// record's bounds; an offset that disagrees with its own arithmetic.
+pub fn derive(cavity: &Cavity, spec: &ElectrodeSpec) -> Result<ElectrodeBox, GenError> {
+    let orbit = check_spec(spec)?;
+    let depth = cavity.top_z - cavity.floor_z;
+    if !(cavity.floor_z.is_finite() && cavity.top_z.is_finite() && depth >= MIN_DEPTH) {
+        return refuse(format!("the cavity has no depth (floor Z {}, mouth Z {})", cavity.floor_z, cavity.top_z));
+    }
+    let ring = Loop::new(cavity.outline.clone())
+        .map_err(|e| GenError::Invalid(format!("electrode from faces: the floor's outline is not a boundary - {e}")))?;
+    let region = Region::new(vec![ring]).map_err(|e| {
+        GenError::Invalid(format!(
+            "electrode from faces: the floor's outline is self-intersecting ({e}) - it bounds no cavity"
+        ))
+    })?;
+    let [outer] = region.loops() else {
+        return refuse(format!(
+            "the floor's outline is self-intersecting - it falls into {} pieces, not one cavity",
+            region.loops().len()
+        ));
+    };
+    // The rectangle is read off the picked ring itself (exact corners);
+    // the region's ring - the same shape on the offset's lattice - must
+    // read as one too.
+    let rect = rect_of(&cavity.outline, TOL).filter(|_| rect_of(outer.points(), 2.0 * TOL).is_some());
+    let Some((lo, hi)) = rect else {
+        return refuse(format!(
+            "the cavity's outline is not an axis-aligned rectangle (it has {} corners and fills {:.1}% of its bounds) - {NON_RECTANGULAR}",
+            outer.points().len(),
+            region.bounds().map_or(0.0, |(a, b)| 100.0 * region.area() / ((b.x - a.x) * (b.y - a.y)).max(f64::MIN_POSITIVE))
+        ));
+    };
+    let (cx, cy) = (hi.x - lo.x, hi.y - lo.y);
+    let inset = spec.undersize + orbit;
+    let face = (cx - 2.0 * inset, cy - 2.0 * inset);
+    let consumed = || {
+        refuse(format!(
+            "an inset of {inset:.3} per side (undersize {:.3} + orbit {orbit:.3}) leaves no electrode in the {cx:.3} x {cy:.3} cavity",
+            spec.undersize
+        ))
+    };
+    if !(face.0 >= MIN_SIDE && face.1 >= MIN_SIDE) {
+        return consumed();
+    }
+    // The published offset, and the arithmetic it must agree with: a
+    // rectangle's inward mitred offset is the rectangle shrunk per side.
+    let shrunk = if inset > 0.0 {
+        region
+            .offset_sharp(-inset)
+            .map_err(|e| GenError::Invalid(format!("electrode from faces: the inward offset refused - {e}")))?
+    } else {
+        region.clone()
+    };
+    let outline = match shrunk.loops() {
+        [one] => one.points().to_vec(),
+        [] => return consumed(),
+        many => {
+            return refuse(format!(
+                "an inset of {inset:.3} per side splits the electrode into {} pieces - one electrode burns one cavity",
+                many.len()
+            ));
+        }
+    };
+    let agrees = rect_of(&outline, OFFSET_SLACK).is_some_and(|(a, b)| {
+        let near = |p: f64, q: f64| (p - q).abs() <= OFFSET_SLACK;
+        near(a.x, lo.x + inset) && near(a.y, lo.y + inset) && near(b.x, hi.x - inset) && near(b.y, hi.y - inset)
+    });
+    if !agrees {
+        return refuse(
+            "the offset outline disagrees with the cavity's bounds shrunk by the inset - refused rather than guessed (a bug; please report it)".into(),
+        );
+    }
+    if face.0 > MAX_SIDE || face.1 > MAX_SIDE {
+        return refuse(format!(
+            "the electrode face {:.3} x {:.3} is larger than the {MAX_SIDE} mm a tool record holds",
+            face.0, face.1
+        ));
+    }
+    let length = depth + spec.stub;
+    if !(length.is_finite() && length > depth) {
+        return refuse(format!(
+            "the electrode's length {length} does not stand above the {depth:.3} deep cavity - its holder would enter the work"
+        ));
+    }
+    Ok(ElectrodeBox {
+        face,
+        center: (0.5 * (lo.x + hi.x), 0.5 * (lo.y + hi.y)),
+        cavity: (cx, cy),
+        floor_z: cavity.floor_z,
+        top_z: cavity.top_z,
+        depth,
+        length,
+        pickup: spec.pickup,
+        inset,
+        orbit,
+        outline,
+    })
+}
+
+/// Keep the part of a convex polygon where `side` is positive
+/// (Sutherland-Hodgman, one clip plane).
+fn clip(poly: &[Point3], side: impl Fn(Point3) -> f64) -> Vec<Point3> {
+    let n = poly.len();
+    let mut out = Vec::with_capacity(n + 1);
+    for i in 0..n {
+        let (Some(&a), Some(&b)) = (poly.get(i), poly.get((i + 1) % n)) else { continue };
+        let (da, db) = (side(a), side(b));
+        if da > 0.0 {
+            out.push(a);
+        }
+        if (da > 0.0) != (db > 0.0) && (da - db).abs() > 0.0 {
+            let t = da / (da - db);
+            out.push(Point3::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t));
+        }
+    }
+    out
+}
+
+/// A planar polygon's area (Newell's vector area, its length).
+fn area(poly: &[Point3]) -> f64 {
+    let Some(&o) = poly.first() else { return 0.0 };
+    let mut s = Point3::ZERO;
+    for w in poly.windows(2) {
+        if let [a, b] = w {
+            let c = (*a - o).cross(*b - o);
+            s = Point3::new(s.x + c.x, s.y + c.y, s.z + c.z);
+        }
+    }
+    0.5 * s.dot(s).sqrt()
+}
+
+/// Where the model stands inside the cavity's column above its floor -
+/// a boss on the floor, a rib, an overhang across the mouth - or `None`
+/// when the column is clear. The electrode is fed down that column, so
+/// anything in it is in the electrode's way. Facets with a non-finite
+/// corner are skipped: they bound nothing a burn could meet.
+#[must_use]
+pub fn standing_in(e: &ElectrodeBox, facets: &[Triangle]) -> Option<Point3> {
+    let (hx, hy) = (0.5 * e.cavity.0 - CLEAR, 0.5 * e.cavity.1 - CLEAR);
+    if !(hx > 0.0 && hy > 0.0) {
+        return None;
+    }
+    let (cx, cy, floor) = (e.center.0, e.center.1, e.floor_z + CLEAR);
+    for t in facets {
+        if !(t.a.is_finite() && t.b.is_finite() && t.c.is_finite()) {
+            continue;
+        }
+        let mut poly = vec![t.a, t.b, t.c];
+        poly = clip(&poly, |p| p.z - floor);
+        poly = clip(&poly, |p| p.x - (cx - hx));
+        poly = clip(&poly, |p| (cx + hx) - p.x);
+        poly = clip(&poly, |p| p.y - (cy - hy));
+        poly = clip(&poly, |p| (cy + hy) - p.y);
+        if poly.len() < 3 || area(&poly) < 1e-12 {
+            continue;
+        }
+        let k = poly.len() as f64;
+        let c = poly.iter().fold(Point3::ZERO, |s, p| Point3::new(s.x + p.x / k, s.y + p.y / k, s.z + p.z / k));
+        if c.is_finite() {
+            return Some(c);
+        }
+    }
+    None
+}
