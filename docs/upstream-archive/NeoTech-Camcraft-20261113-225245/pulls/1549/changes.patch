+#[test]
+fn a_nest_floor_touching_within_the_contact_tolerance_is_held() {
+    let (world, mut h) = flipped_hat();
+    soft_jaws(&world, &mut h, 25.05, 0.005);
+    let r = refusals(&world);
+    assert!(r.is_empty(), "contact within {CARRIED_CONTACT_TOL} mm: {r:?}");
+}
