+/// Material `lo..hi` overlapped by `spans`, in millimetres.
+fn overlap(spans: &[(f64, f64)], lo: f64, hi: f64) -> f64 {
+    spans.iter().map(|&(a, b)| (b.min(hi) - a.max(lo)).max(0.0)).sum()
+}
