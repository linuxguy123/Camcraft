diff --git a/crates/kernel/src/solidcraft/cache.rs b/crates/kernel/src/solidcraft/cache.rs
new file mode 100644
index 000000000..52b77ab9b
--- /dev/null
+++ b/crates/kernel/src/solidcraft/cache.rs
@@ -0,0 +1,193 @@
+//! The Solidcraft model cache (#1456): its key checked against the document
+//! and payload, and the final state's one body found and decoded.
+//! Provenance: Solidcraft's published source (tangency-labs/solidcraft,
+//! Apache-2.0): the manifest fields, slice rules and body table of
+//! crates/io/src/design/native_cache.rs (`read_geometry`), and the final
+//! state of crates/doc/src/model_cache.rs (`SavedModel::final_state`: the
+//! last feature not skipped names its state; a state lists its model
+//! bodies as runs `[first, count]`; a model body names its entry of the
+//! body table). Bodies are decoded by solidcore-record `native::decode`.
+
+use serde_json::Value;
+
+use super::sha256::hex_digest;
+use super::{CACHE_FORMATS, CACHE_KERNEL, CACHE_PRODUCER, refused};
+use crate::KernelError;
+
+pub const MANIFEST: &str = "cache/model.json";
+pub const PAYLOAD: &str = "cache/bodies.bin";
+/// Solidcraft's bounds: distinct stored bodies, and body records.
+const MAX_UNIQUE: usize = 100_000;
+const MAX_RECORDS: usize = 200_000;
+/// A mesh body's slice starts with this tag instead of the B-rep codec's.
+const MESH_TAG: &[u8; 8] = b"SCMESH01";
+
+/// The final state's body: its name in the design and its B-rep record.
+pub struct FinalBody {
+    pub name: String,
+    pub record: solidcore_record::brep::Brep,
+}
+
+fn text<'a>(v: &'a Value, key: &str) -> &'a str {
+    v.get(key).and_then(Value::as_str).unwrap_or("")
+}
+
+fn index(v: Option<&Value>, len: usize, what: &str) -> Result<usize, KernelError> {
+    v.and_then(Value::as_u64)
+        .and_then(|i| usize::try_from(i).ok())
+        .filter(|i| *i < len)
+        .ok_or_else(|| refused(format!("model cache: {what} out of range")))
+}
+
+fn list<'a>(v: &'a Value, key: &str, cap: usize) -> Result<&'a Vec<Value>, KernelError> {
+    v.get(key)
+        .and_then(Value::as_array)
+        .filter(|l| l.len() <= cap)
+        .ok_or_else(|| refused(format!("model cache: '{key}' missing or too long")))
+}
+
+/// The cache is one we read and is the evaluation of exactly this document
+/// (`document` digest) with exactly this payload (`payload` digest, checked
+/// in [`final_body`]).
+pub fn check_key(manifest: &Value, document: &[u8]) -> Result<(), KernelError> {
+    let format = text(manifest, "format");
+    if !CACHE_FORMATS.contains(&format) {
+        return Err(refused(format!(
+            "model cache format '{format}' is not one this reader knows ({})",
+            CACHE_FORMATS.join(", ")
+        )));
+    }
+    let producer = text(manifest, "producer");
+    if producer != CACHE_PRODUCER {
+        return Err(refused(format!(
+            "model cache producer '{producer}' is not {CACHE_PRODUCER}"
+        )));
+    }
+    let kernel = text(manifest, "kernel");
+    if kernel != CACHE_KERNEL {
+        return Err(refused(format!(
+            "model cache kernel '{kernel}' is not {CACHE_KERNEL}"
+        )));
+    }
+    if text(manifest, "document") != hex_digest(document) {
+        return Err(refused(
+            "model cache is stale: its document digest does not match document.json",
+        ));
+    }
+    Ok(())
+}
+
+/// The final state's single body, decoded from `payload`.
+pub fn final_body(manifest: &Value, payload: &[u8]) -> Result<FinalBody, KernelError> {
+    if text(manifest, "payload") != hex_digest(payload) {
+        return Err(refused(
+            "model cache payload digest does not match cache/bodies.bin",
+        ));
+    }
+    // The slices: contiguous, in order, covering the payload exactly.
+    let slices = list(manifest, "slices", MAX_UNIQUE)?;
+    let mut ranges = Vec::with_capacity(slices.len());
+    let mut end = 0usize;
+    for s in slices {
+        let num = |i: usize| {
+            s.get(i)
+                .and_then(Value::as_u64)
+                .and_then(|n| usize::try_from(n).ok())
+                .ok_or_else(|| refused("model cache: a slice is not two counts"))
+        };
+        let (offset, length) = (num(0)?, num(1)?);
+        if offset != end {
+            return Err(refused("model cache: slices overlap or leave gaps"));
+        }
+        end = offset
+            .checked_add(length)
+            .filter(|e| *e <= payload.len())
+            .ok_or_else(|| refused("model cache: a slice runs past cache/bodies.bin"))?;
+        ranges.push((offset, end));
+    }
+    if end != payload.len() {
+        return Err(refused("model cache: trailing data after the last slice"));
+    }
+    let table = list(manifest, "bodies", MAX_RECORDS)?;
+    let model = manifest
+        .get("model")
+        .ok_or_else(|| refused("model cache: no model records"))?;
+    let features = list(model, "features", usize::MAX)?;
+    let states = list(model, "states", usize::MAX)?;
+    let model_bodies = list(model, "model_bodies", MAX_RECORDS)?;
+    // The final state: the last feature not skipped names it.
+    let last = features
+        .iter()
+        .rev()
+        .find(|f| f.get("skipped").and_then(Value::as_bool) == Some(false))
+        .ok_or_else(|| refused("the design has no evaluated feature, so no body"))?;
+    let state = states
+        .get(index(last.get("state"), states.len(), "final state")?)
+        .ok_or_else(|| refused("model cache: final state missing"))?;
+    let mut held = Vec::new();
+    for run in state
+        .get("bodies")
+        .and_then(Value::as_array)
+        .ok_or_else(|| refused("model cache: final state lists no bodies"))?
+    {
+        let first = index(run.get(0), model_bodies.len(), "body run")?;
+        let count = run
+            .get(1)
+            .and_then(Value::as_u64)
+            .and_then(|n| usize::try_from(n).ok())
+            .filter(|n| {
+                first
+                    .checked_add(*n)
+                    .is_some_and(|e| e <= model_bodies.len())
+            })
+            .ok_or_else(|| refused("model cache: body run out of range"))?;
+        held.extend(first..first + count);
+        if held.len() > 1 {
+            break;
+        }
+    }
+    let m = match held.as_slice() {
+        [m] => *m,
+        [] => return Err(refused("the design's final state holds no body")),
+        _ => {
+            return Err(refused(
+                "the design's final state holds several bodies: multi-body designs are not \
+                 imported yet",
+            ));
+        }
+    };
+    let mb = model_bodies
+        .get(m)
+        .ok_or_else(|| refused("model cache: model body missing"))?;
+    let entry = table
+        .get(index(mb.get("body"), table.len(), "body table entry")?)
+        .and_then(Value::as_array)
+        .ok_or_else(|| refused("model cache: body table entry is not a list"))?;
+    if entry.len() != 1 {
+        return Err(refused(
+            "the final body is a placed copy of a part (an assembly instance): not imported yet",
+        ));
+    }
+    let (start, stop) = *ranges
+        .get(index(entry.first(), ranges.len(), "body slice")?)
+        .ok_or_else(|| refused("model cache: body slice missing"))?;
+    let bytes = payload
+        .get(start..stop)
+        .ok_or_else(|| refused("model cache: body slice missing"))?;
+    if bytes.starts_with(MESH_TAG) {
+        return Err(refused(
+            "the final body is a mesh body (an imported STL or 3MF), not a B-rep: import that mesh file instead",
+        ));
+    }
+    if !bytes.starts_with(solidcore_record::native::MAGIC) {
+        return Err(refused(
+            "the final body has a bad magic: not a solidcore B-rep record (SCBREP05)",
+        ));
+    }
+    let saved = solidcore_record::native::decode(bytes)
+        .map_err(|e| refused(format!("the final body does not decode: {e}")))?;
+    Ok(FinalBody {
+        name: text(mb, "name").to_owned(),
+        record: saved.solid,
+    })
+}
diff --git a/crates/kernel/src/solidcraft/mod.rs b/crates/kernel/src/solidcraft/mod.rs
new file mode 100644
index 000000000..5070a4160
--- /dev/null
+++ b/crates/kernel/src/solidcraft/mod.rs
@@ -0,0 +1,206 @@
+//! Solidcraft design import (#1456): the final body a `.sc` design keeps in
+//! its model cache, as a checked solidcore solid in millimetres. Only the
+//! cached final body is read - no parameters, sketches or feature history -
+//! and only when the cache is provably this document's: every version is
+//! one we read, the cache's SHA-256 digests match the document and the
+//! payload, and the body slice decodes. Anything else is refused by name,
+//! never shown stale or in part.
+//! Provenance: the container, model-cache and final-state layout are read
+//! from Solidcraft's published source and documentation (tangency-labs/
+//! solidcraft, Apache-2.0: docs/design-container.md "Model cache",
+//! crates/io/src/design/native_cache.rs `read_geometry`, crates/doc/src/
+//! model_cache.rs `SavedModel::final_state` and the state records). The
+//! body encoding (`SCBREP05`) is decoded by solidcore-record's own
+//! `native::decode` (solidcore workspace, Apache-2.0, at the commit pinned
+//! in Cargo.toml). No layout was worked out from sample bytes; no HSMWorks
+//! material consulted.
+
+mod cache;
+mod sha256;
+mod zip;
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+
+use serde_json::Value;
+use solidcore::kernel::CancelToken;
+
+use crate::KernelError;
+use crate::solidcore_impl::SolidcoreKernel;
+use crate::solidcore_step::{StepSolid, build_record};
+
+pub use sha256::hex_digest;
+pub use zip::looks_like_zip;
+
+const OP: &str = "import_solidcraft";
+
+/// Largest `.sc` file read (Solidcraft's own per-input bound, 256 MiB).
+pub const MAX_SC_BYTES: usize = 256 << 20;
+/// Largest `document.json` and `cache/bodies.bin` (Solidcraft's per-part bound).
+pub const MAX_PART_BYTES: usize = 256 << 20;
+/// Largest `cache/model.json` (Solidcraft's manifest bound).
+pub const MAX_MANIFEST_BYTES: usize = 32 << 20;
+/// Largest `container.json`.
+const MAX_CONTAINER_BYTES: usize = 4096;
+
+/// The container format read.
+pub const CONTAINER_FORMAT: &str = "solidcraft-container/1";
+/// The model-cache formats read: 8 (the sample in testdata) and 10 (the
+/// published source); every other version is refused.
+pub const CACHE_FORMATS: [&str; 2] = ["solidcraft-model-cache/8", "solidcraft-model-cache/10"];
+/// The producer (body adapter) read.
+pub const CACHE_PRODUCER: &str = "solidcraft-truck-adapter/4";
+/// The kernel whose bodies are read.
+pub const CACHE_KERNEL: &str = "solidcore";
+
+/// A Solidcraft design's final body.
+#[derive(Debug)]
+pub struct SolidcraftImport {
+    /// The final body: a checked solid in millimetres.
+    pub solid: StepSolid,
+    /// The design's own name (`document.json` `name`), may be empty.
+    pub design: String,
+    /// The document's length unit (always `"mm"`: others are refused).
+    pub units: String,
+    /// The Solidcraft version that wrote the cache (recorded, not compared).
+    pub app: String,
+}
+
+pub(crate) fn refused(detail: impl Into<String>) -> KernelError {
+    KernelError::InvalidInput {
+        op: OP,
+        detail: detail.into(),
+    }
+}
+
+/// Imports the final body of a Solidcraft `.sc` design. `stop` is the time
+/// bound (polled between stages and inside the kernel's loops). A panic in
+/// the decoder or the kernel is caught and reported; the kernel state is
+/// then replaced, as after a time-out.
+pub fn import_solidcraft(
+    k: &mut SolidcoreKernel,
+    bytes: &[u8],
+    stop: &CancelToken,
+) -> Result<SolidcraftImport, KernelError> {
+    if bytes.is_empty() {
+        return Err(refused("empty file"));
+    }
+    if bytes.len() > MAX_SC_BYTES {
+        return Err(refused(format!(
+            "{} bytes is past the {MAX_SC_BYTES}-byte limit",
+            bytes.len()
+        )));
+    }
+    let before = k.k.cancel.replace(stop.clone());
+    let guarded = catch_unwind(AssertUnwindSafe(|| import_guarded(k, bytes, stop)));
+    k.k.cancel = before;
+    let out = guarded.unwrap_or_else(|_| {
+        Err(KernelError::Failed {
+            kernel: CACHE_KERNEL,
+            op: OP,
+            detail: "the decoder or the kernel panicked on this file".into(),
+        })
+    });
+    if matches!(
+        out,
+        Err(KernelError::TimedOut { .. } | KernelError::Failed { .. })
+    ) {
+        k.k = solidcore::Kernel::default();
+    }
+    out
+}
+
+fn timed_out(stage: &'static str) -> KernelError {
+    KernelError::TimedOut { op: OP, stage }
+}
+
+fn json(bytes: &[u8], what: &str) -> Result<Value, KernelError> {
+    serde_json::from_slice(bytes).map_err(|e| refused(format!("{what} is not valid JSON ({e})")))
+}
+
+fn import_guarded(
+    k: &mut SolidcoreKernel,
+    bytes: &[u8],
+    stop: &CancelToken,
+) -> Result<SolidcraftImport, KernelError> {
+    let archive = zip::Archive::open(bytes).map_err(refused)?;
+    let container = json(
+        &archive
+            .read("container.json", MAX_CONTAINER_BYTES)
+            .map_err(refused)?,
+        "container.json",
+    )?;
+    let format = container.get("format").and_then(Value::as_str);
+    if format != Some(CONTAINER_FORMAT) {
+        return Err(refused(format!(
+            "container format {} is not {CONTAINER_FORMAT}",
+            format.unwrap_or("(none)")
+        )));
+    }
+    let document_bytes = archive
+        .read("document.json", MAX_PART_BYTES)
+        .map_err(refused)?;
+    let document = json(&document_bytes, "document.json")?;
+    let doc_format = document.get("format").and_then(Value::as_str).unwrap_or("");
+    let doc_version = doc_format
+        .strip_prefix("solidcraft/")
+        .and_then(|v| v.parse::<u32>().ok());
+    if doc_version.is_none() {
+        return Err(refused(format!(
+            "document format '{doc_format}' is not a Solidcraft document"
+        )));
+    }
+    let units = document.get("units").and_then(Value::as_str).unwrap_or("");
+    if units != "mm" {
+        return Err(refused(format!(
+            "document units '{units}': only millimetre designs are read (the format does not \
+             say how a design in other units stores its bodies)"
+        )));
+    }
+    if !archive.has(cache::MANIFEST) || !archive.has(cache::PAYLOAD) {
+        return Err(refused(
+            "the design keeps no model cache (cache/model.json and cache/bodies.bin): save it \
+             in Solidcraft with the model cache on",
+        ));
+    }
+    if stop.is_cancelled() {
+        return Err(timed_out("reading the container"));
+    }
+    let manifest = archive
+        .read(cache::MANIFEST, MAX_MANIFEST_BYTES)
+        .map_err(refused)?;
+    let manifest = json(&manifest, cache::MANIFEST)?;
+    cache::check_key(&manifest, &document_bytes)?;
+    let payload = archive
+        .read(cache::PAYLOAD, MAX_PART_BYTES)
+        .map_err(refused)?;
+    let body = cache::final_body(&manifest, &payload)?;
+    if stop.is_cancelled() {
+        return Err(timed_out("decoding the final body"));
+    }
+    let solid =
+        build_record(k, 0, body.name, body.record, Vec::new()).map_err(|(stage, why)| {
+            if stop.is_cancelled() {
+                timed_out("building the final body")
+            } else {
+                KernelError::InvalidResult {
+                    kernel: CACHE_KERNEL,
+                    op: OP,
+                    detail: format!("the final body was refused at {stage}: {why}"),
+                }
+            }
+        })?;
+    Ok(SolidcraftImport {
+        solid,
+        design: document
+            .get("name")
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .to_owned(),
+        units: units.to_owned(),
+        app: manifest
+            .get("app")
+            .and_then(Value::as_str)
+            .unwrap_or("")
+            .to_owned(),
+    })
+}
diff --git a/crates/kernel/src/solidcraft/sha256.rs b/crates/kernel/src/solidcraft/sha256.rs
new file mode 100644
index 000000000..5aa5a8a37
--- /dev/null
+++ b/crates/kernel/src/solidcraft/sha256.rs
@@ -0,0 +1,104 @@
+//! SHA-256 of a byte slice, as lowercase hex: the digest a Solidcraft model
+//! cache ties itself to its document and payload with (#1456).
+//! Provenance: written from FIPS PUB 180-4 (Secure Hash Standard), section
+//! 6.2 and the constants of section 4.2.2; test vectors from its examples.
+
+const K: [u32; 64] = [
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+];
+
+const H0: [u32; 8] = [
+    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+];
+
+fn compress(h: &mut [u32; 8], block: &[u8; 64]) {
+    let mut w = [0u32; 64];
+    for (slot, word) in w.iter_mut().zip(block.as_chunks::<4>().0) {
+        *slot = u32::from_be_bytes(*word);
+    }
+    for t in 16..64 {
+        let s0 = w[t - 15].rotate_right(7) ^ w[t - 15].rotate_right(18) ^ (w[t - 15] >> 3);
+        let s1 = w[t - 2].rotate_right(17) ^ w[t - 2].rotate_right(19) ^ (w[t - 2] >> 10);
+        w[t] = w[t - 16]
+            .wrapping_add(s0)
+            .wrapping_add(w[t - 7])
+            .wrapping_add(s1);
+    }
+    let [mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh] = *h;
+    for (k, wt) in K.iter().zip(w.iter()) {
+        let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
+        let ch = (e & f) ^ (!e & g);
+        let t1 = hh
+            .wrapping_add(s1)
+            .wrapping_add(ch)
+            .wrapping_add(*k)
+            .wrapping_add(*wt);
+        let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
+        let maj = (a & b) ^ (a & c) ^ (b & c);
+        let t2 = s0.wrapping_add(maj);
+        hh = g;
+        g = f;
+        f = e;
+        e = d.wrapping_add(t1);
+        d = c;
+        c = b;
+        b = a;
+        a = t1.wrapping_add(t2);
+    }
+    for (x, y) in h.iter_mut().zip([a, b, c, d, e, f, g, hh]) {
+        *x = x.wrapping_add(y);
+    }
+}
+
+/// The SHA-256 digest of `data`, 64 lowercase hex digits.
+pub fn hex_digest(data: &[u8]) -> String {
+    let mut h = H0;
+    let (blocks, rest) = data.as_chunks::<64>();
+    for block in blocks {
+        compress(&mut h, block);
+    }
+    // Padding: 0x80, zeros, then the bit length as a big-endian u64.
+    let mut tail = [0u8; 128];
+    tail[..rest.len()].copy_from_slice(rest);
+    tail[rest.len()] = 0x80;
+    let used = if rest.len() < 56 { 64 } else { 128 };
+    let bits = (data.len() as u64).wrapping_mul(8);
+    tail[used - 8..used].copy_from_slice(&bits.to_be_bytes());
+    for block in tail[..used].as_chunks::<64>().0 {
+        compress(&mut h, block);
+    }
+    h.iter().map(|x| format!("{x:08x}")).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::hex_digest;
+
+    /// FIPS 180-4's examples, plus the padding edge of 55/56/64 bytes.
+    #[test]
+    fn digests_match_the_standard() {
+        assert_eq!(
+            hex_digest(b"abc"),
+            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
+        );
+        assert_eq!(
+            hex_digest(b""),
+            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+        );
+        assert_eq!(
+            hex_digest(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
+            "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
+        );
+        assert_eq!(
+            hex_digest(&[b'a'; 64]),
+            "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"
+        );
+    }
+}
