+    assert!(judge(&rim, &drill, &plunge, near, &[]) > 0, "undeclared, the excess eats the rim's own sagitta");
+    assert_eq!(judge(&rim, &drill, &plunge, near, &declared), 0, "declared, the rim reads untightened");
