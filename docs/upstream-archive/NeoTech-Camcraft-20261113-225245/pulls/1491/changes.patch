diff --git a/crates/motion/src/machining2d/pocket_strategy.rs b/crates/motion/src/machining2d/pocket_strategy.rs
new file mode 100644
index 000000000..cf74f429c
--- /dev/null
+++ b/crates/motion/src/machining2d/pocket_strategy.rs
@@ -0,0 +1,59 @@
+//! How a 2D pocket is filled: the strategy choice and what Auto resolves
+//! to (split from `pocket.rs` for the 400-line law, #1446; structure
+//! only). Provenance: as `pocket.rs` - zigzag, ring and adaptive
+//! pocketing are textbook CAM strategies (machine-tool handbooks,
+//! published CAM literature); the Auto law is ours.
+
+use crate::geo2d::Point2;
+
+use super::ring::ring_is_circular;
+
+/// How a pocket is filled: straight rows back and forth, or closed rings
+/// marching inward.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PocketStrategy {
+    Zigzag,
+    Waterline,
+    /// HSM adaptive clearing (M11.4 C, `adaptive`): a spiral out of
+    /// the entry bore, then engagement fronts against the in-process
+    /// stock with smooth stay-down links and trochoidal arcs in narrow
+    /// channels, every cut measured to hold the `optimal_load` (ae/D,
+    /// `crate::load`). The 3-D ladder plans every closed level area
+    /// with the same planner (`machining3d::hsm`, M11.4's per-level
+    /// port) and falls back to [`PocketStrategy::OffsetRings`] by name
+    /// where the planner refuses a level.
+    Adaptive,
+    /// The pre-M11.4 C adaptive (M2.1c's law, planar since M5.1 H):
+    /// the Waterline ring tiling spaced at `optimal_load` x D instead
+    /// of a free stepover - concentric rings, kept as an explicit
+    /// choice so every program it posted stays byte-identical.
+    OffsetRings,
+    /// Waterline where the pocket's outer boundary is round enough for
+    /// rings to be the honest shape, Zigzag otherwise. The resolution is
+    /// [`PocketStrategy::resolve`] - the panel quotes it verbatim, so an
+    /// Auto pocket never hides which path it is cutting.
+    Auto,
+}
+
+impl PocketStrategy {
+    /// What Auto picks for a cutter-center ring: fitted arcs must carry
+    /// at least 90% of the boundary's length AND agree on a center
+    /// within a quarter stepover - a family of true circles, not corners
+    /// that happen to round - and the stepover must still be inside
+    /// waterline's reach (rings a whole stepover apart leave a band no
+    /// ring's edge reaches when the step exceeds one radius; zigzag
+    /// clears the same floor honestly). Any other strategy answers as
+    /// itself.
+    pub fn resolve(self, outer_ring: &[Point2], stepover: f64, tool_diameter: f64, tol: f64) -> Self {
+        match self {
+            PocketStrategy::Auto
+                if ring_is_circular(outer_ring, tol, stepover)
+                    && stepover <= tool_diameter * 0.5 =>
+            {
+                PocketStrategy::Waterline
+            }
+            PocketStrategy::Auto => PocketStrategy::Zigzag,
+            s => s,
+        }
+    }
+}
diff --git a/crates/motion/src/machining2d/rest2d.rs b/crates/motion/src/machining2d/rest2d.rs
new file mode 100644
index 000000000..64d8f73c4
--- /dev/null
+++ b/crates/motion/src/machining2d/rest2d.rs
@@ -0,0 +1,226 @@
+//! 2D rest machining (#1446): the part of a pocket a larger previous tool
+//! could not reach, and the pocket passes that cut only that part.
+//!
+//! Provenance: the area a cutter of radius R can sweep inside a pocket P
+//! is the morphological opening of P by a disc of radius R - erode P by R
+//! (the legal cutter centers), then dilate the result by R (what the
+//! cutter covers from them); the residue is P minus that opening (J.
+//! Serra, "Image Analysis and Mathematical Morphology", Academic Press
+//! 1982, for erosion, dilation and opening). In pocket machining the same
+//! construction is the inward offset of the boundary followed by an
+//! outward one (M. Held, "On the Computational Geometry of Pocket
+//! Machining", LNCS 500, Springer 1991), and the material a large cutter
+//! leaves for a smaller one is treated that way in D. Veeramani and Y.-S.
+//! Gau, "Selection of an optimal set of cutting-tool sizes for 2.5D pocket
+//! machining", Computer-Aided Design 29(12), 1997, and Z. Yao, S. K. Gupta
+//! and D. S. Nau, "Algorithms for selecting cutters in multi-part milling
+//! problems", Computer-Aided Design 35(9), 2003. Written from those and
+//! this project's own polygon offsets (`geo2d`); the margins, the film
+//! tolerance and every refusal are ours. No other CAM product's code or
+//! output was consulted.
+//!
+//! Prime Directive: the rest area is read large, never small. The cleared
+//! area is shrunk by [`REST_MARGIN`] before it is subtracted, a flat
+//! width the previous tool's corner radius does not cut is not counted as
+//! cleared, and the allowance only grows the area. The one thing dropped
+//! is a film thinner than [`REST_FILM`], which is below what the offsets
+//! resolve (without it every wall would read as rest material). The
+//! passes are the pocket's own: every move below the top of the cut is a
+//! feed or a plunge, so a wrong previous tool costs a heavier cut, never
+//! a rapid into stock.
+
+use crate::cl::Toolpath;
+use crate::geo2d::Region;
+
+use super::face::GenError;
+use super::pocket::{PocketParams, PocketStrategy, pocket_over};
+
+/// How far the previous tool's cleared area is shrunk before it is
+/// subtracted (mm): two polygon-offset arc tolerances (5 um each, one per
+/// offset of the opening), so chord error can only add rest material.
+pub const REST_MARGIN: f64 = 0.01;
+
+/// Residue thinner than this (mm) is not rest material: the band
+/// [`REST_MARGIN`] leaves along every wall is this thin, and a film of 20
+/// um is under what the region offsets resolve.
+pub const REST_FILM: f64 = 0.02;
+
+/// The tool's reach onto the rest area is read this much (mm) past its
+/// radius. The rest area shares the pocket's walls, so its offset by the
+/// bare radius would run along the pocket's own center boundary and the
+/// intersection of the two would leave slivers; with the reach read
+/// long the pocket's boundary decides there. Only adds tool positions,
+/// all of them inside the pocket's own center area.
+pub const REST_REACH: f64 = 0.05;
+
+/// The previous tool, as the user entered it. The generator trusts it:
+/// it cannot see what really cut the pocket.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RestParams {
+    /// Diameter of the tool that roughed the pocket; must be larger than
+    /// this operation's tool.
+    pub previous_tool_diameter: f64,
+    /// Corner (bull-nose) radius of that tool; 0 for a flat end mill. The
+    /// floor within this distance of a wall keeps a fillet, so that
+    /// width is not read as cleared.
+    pub previous_corner_radius: f64,
+    /// Radial stock the previous operation left on the walls.
+    pub previous_stock_to_leave: f64,
+    /// Grows the rest area by this much (mm) so the passes overlap the
+    /// previous tool's cut. Never shrinks it.
+    pub allowance: f64,
+}
+
+impl RestParams {
+    fn validate(&self, tool_diameter: f64) -> Result<(), GenError> {
+        let all = [
+            self.previous_tool_diameter,
+            self.previous_corner_radius,
+            self.previous_stock_to_leave,
+            self.allowance,
+        ];
+        if !all.into_iter().all(f64::is_finite) {
+            return Err(GenError::Invalid("rest machining parameters must be finite".into()));
+        }
+        if self.previous_tool_diameter <= tool_diameter {
+            return Err(GenError::Invalid(format!(
+                "rest machining needs a previous tool larger than this one: the previous tool is {} mm, this tool is {} mm",
+                self.previous_tool_diameter, tool_diameter
+            )));
+        }
+        if self.previous_corner_radius < 0.0 || self.previous_corner_radius > self.previous_tool_diameter * 0.5 {
+            return Err(GenError::Invalid(
+                "the previous tool's corner radius must be between 0 and its radius".into(),
+            ));
+        }
+        if self.previous_stock_to_leave < 0.0 {
+            return Err(GenError::Invalid("the previous stock to leave must not be negative".into()));
+        }
+        if self.allowance < 0.0 {
+            return Err(GenError::Invalid("the rest allowance must not be negative".into()));
+        }
+        Ok(())
+    }
+}
+
+/// What the previous tool left, and where this tool's center may go to
+/// cut it.
+#[derive(Clone, Debug)]
+pub struct RestPlan {
+    /// The rest material (a superset of it, see the module text), inside
+    /// the pocket less this operation's stock to leave.
+    pub rest: Region,
+    /// Cutter-center area: the pocket's own center area where the tool
+    /// touches `rest`. Empty exactly when `rest` is.
+    pub center: Region,
+    /// False when the previous tool fits nowhere in the pocket: nothing
+    /// was cleared and `rest` is the whole pocket.
+    pub previous_fits: bool,
+}
+
+/// The rest plan for `region` (the pocket, as [`super::pocket`] reads it)
+/// cut by a tool of `tool_diameter` leaving `stock_to_leave`, after the
+/// previous tool `rest` describes. An empty plan (the previous tool
+/// reached everything) is `Ok` with empty regions; the caller decides
+/// what that means.
+pub fn rest_plan(
+    region: &Region,
+    tool_diameter: f64,
+    stock_to_leave: f64,
+    rest: &RestParams,
+) -> Result<RestPlan, GenError> {
+    if !(tool_diameter.is_finite() && stock_to_leave.is_finite()) || tool_diameter <= 0.0 || stock_to_leave < 0.0 {
+        return Err(GenError::Invalid("tool diameter must be positive and stock to leave not negative".into()));
+    }
+    rest.validate(tool_diameter)?;
+    if region.is_empty() {
+        return Err(GenError::Empty("empty pocket region".into()));
+    }
+    let r = tool_diameter * 0.5;
+    let own_center = region.offset(-(r + stock_to_leave))?;
+    if own_center.is_empty() {
+        return Err(GenError::Invalid("pocket is narrower than the tool".into()));
+    }
+    // What this operation is to leave free of material.
+    let target = if stock_to_leave > 0.0 { region.offset(-stock_to_leave)? } else { region.clone() };
+    let big_r = rest.previous_tool_diameter * 0.5;
+    let previous_center = region.offset(-(big_r + rest.previous_stock_to_leave))?;
+    if previous_center.is_empty() {
+        // Nothing was cleared: the whole pocket is rest material, and
+        // the center area is the pocket's own, untouched.
+        return Ok(RestPlan { rest: target, center: own_center, previous_fits: false });
+    }
+    // The opening, read small: the flat of the previous tool, less the
+    // margin, swept from its legal centers.
+    let sweep = big_r - rest.previous_corner_radius - REST_MARGIN;
+    let cleared = if sweep > 0.0 { previous_center.offset(sweep)? } else { previous_center };
+    let raw = target.difference(&cleared)?;
+    // Drop the film (an opening by half its width), then grow by the
+    // allowance; never past the target.
+    let half = REST_FILM * 0.5;
+    let core = raw.offset(-half)?;
+    if core.is_empty() {
+        return Ok(RestPlan { rest: Region::empty(), center: Region::empty(), previous_fits: true });
+    }
+    let rest_area = core.offset(half + rest.allowance)?.intersect(&target)?;
+    // Centers from which the tool touches the rest area, kept inside the
+    // pocket's own center area: no wall is crossed that the plain pocket
+    // would not cross.
+    let center = rest_area.offset(r + REST_REACH)?.intersect(&own_center)?;
+    Ok(RestPlan { rest: rest_area, center, previous_fits: true })
+}
+
+/// Pocket `region` with the tool of `p`, cutting only what the previous
+/// tool of `rest` left. Levels, entries and links are [`super::pocket`]'s,
+/// planned as rings over the rest plan's center area: `Waterline` and
+/// `OffsetRings` as chosen, and `Auto` reads as `Waterline` here (the
+/// first ring of each rest area runs along the wall, which is what
+/// clears a corner).
+///
+/// Refused by name: a previous tool that is not larger than this one;
+/// `Zigzag` (rows leave cusps along the walls of a rest area, so the
+/// corner would not come clean); `Adaptive` (its entry and engagement
+/// plan assume a full pocket; not built for rest areas yet); nothing
+/// left to cut; rest material this tool cannot reach either.
+pub fn rest_pocket(region: &Region, p: &PocketParams, rest: &RestParams) -> Result<Toolpath, GenError> {
+    p.validate()?;
+    let strategy = match p.strategy {
+        PocketStrategy::Auto | PocketStrategy::Waterline => PocketStrategy::Waterline,
+        PocketStrategy::OffsetRings => PocketStrategy::OffsetRings,
+        PocketStrategy::Zigzag => {
+            return Err(GenError::Invalid(
+                "rest machining is not available with the Zigzag strategy: its rows leave cusps along the walls of a rest area; choose Waterline or Offset rings".into(),
+            ));
+        }
+        PocketStrategy::Adaptive => {
+            return Err(GenError::Invalid(
+                "rest machining is not available with the Adaptive strategy yet: choose Waterline or Offset rings".into(),
+            ));
+        }
+    };
+    let p = &PocketParams { strategy, ..*p };
+    let plan = rest_plan(region, p.tool_diameter, p.stock_to_leave, rest)?;
+    if plan.rest.is_empty() {
+        return Err(GenError::Empty(format!(
+            "no rest material: the previous {} mm tool reached everything in this pocket",
+            rest.previous_tool_diameter
+        )));
+    }
+    if plan.center.is_empty() {
+        return Err(GenError::Invalid(
+            "the rest material is narrower than the tool: no legal tool position touches it".into(),
+        ));
+    }
+    let mut notes = vec![format!(
+        "rest machining trusts the entered previous tool ({} mm, corner radius {} mm, {} mm left on the walls) to have cut this pocket to the same depth: {:.1} of {:.1} mm2 is read as rest material",
+        rest.previous_tool_diameter,
+        rest.previous_corner_radius,
+        rest.previous_stock_to_leave,
+        plan.rest.area().abs(),
+        region.area().abs(),
+    )];
+    if !plan.previous_fits {
+        notes.push("the previous tool fits nowhere in this pocket: the whole pocket is cut".into());
+    }
+    pocket_over(region, &plan.center, p, notes, true)
+}
diff --git a/crates/motion/tests/rest2d.rs b/crates/motion/tests/rest2d.rs
new file mode 100644
index 000000000..78144e3f0
--- /dev/null
+++ b/crates/motion/tests/rest2d.rs
@@ -0,0 +1,380 @@
+//! 2D rest machining (#1446): the rest area is what a larger previous
+//! tool could not reach, read large and never small; the rest passes stay
+//! where that material is, never rapid below the top of the cut, pass the
+//! verifier, and cover the material they were planned for. Refusals are
+//! named, and degenerate input errors instead of crashing.
+//!
+//! Gate map (#1446): covers camcraft_motion::machining2d (rest2d, pocket,
+//! pocket_strategy).
+
+use camcraft_motion::cl::{Move, MoveKind, Toolpath};
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::machining2d::{
+    pocket, rest_plan, rest_pocket, GenError, PocketParams, PocketStrategy, RestParams, REST_FILM,
+};
+use camcraft_motion::verify::{verify, Mode, ToolGeom, VerifyContext, Warning};
+
+const W: f64 = 60.0;
+const H: f64 = 40.0;
+const CORNER: f64 = 3.0;
+const PREV_D: f64 = 12.0;
+const TOOL_D: f64 = 4.0;
+
+fn poly(pts: Vec<Point2>) -> Region {
+    Region::new(vec![Loop::new(pts).unwrap()]).unwrap()
+}
+
+/// A `w` x `h` pocket from the origin with corner radius `cr` (64 chords
+/// per corner, vertices on the true arc).
+fn rounded(w: f64, h: f64, cr: f64) -> Region {
+    let centers = [(w - cr, cr, -90.0), (w - cr, h - cr, 0.0), (cr, h - cr, 90.0), (cr, cr, 180.0)];
+    let mut pts = Vec::new();
+    for (cx, cy, start) in centers {
+        for k in 0..=64 {
+            let a = (start + 90.0 * f64::from(k) / 64.0_f64).to_radians();
+            pts.push(Point2::new(cx + cr * a.cos(), cy + cr * a.sin()));
+        }
+    }
+    poly(pts)
+}
+
+/// Signed distance into the exact `W` x `H` rounded rectangle of corner
+/// radius `cr` (positive inside).
+fn depth_in(p: Point2, cr: f64) -> f64 {
+    let qx = (p.x - W * 0.5).abs() - (W * 0.5 - cr);
+    let qy = (p.y - H * 0.5).abs() - (H * 0.5 - cr);
+    let outside = (qx.max(0.0).powi(2) + qy.max(0.0).powi(2)).sqrt();
+    cr - outside - qx.max(qy).min(0.0)
+}
+
+fn prev() -> RestParams {
+    RestParams {
+        previous_tool_diameter: PREV_D,
+        previous_corner_radius: 0.0,
+        previous_stock_to_leave: 0.0,
+        allowance: 0.0,
+    }
+}
+
+fn pp(strategy: PocketStrategy) -> PocketParams {
+    PocketParams {
+        links: camcraft_motion::links::Links::PLANAR,
+        tool_diameter: TOOL_D,
+        stepover: 1.5,
+        stock_to_leave: 0.0,
+        clearance_z: 5.0,
+        retract_z: None,
+        top_z: 0.0,
+        bottom_z: -4.0,
+        stepdown: 2.0,
+        feed: 400.0,
+        plunge_feed: 80.0,
+        climb: true,
+        strategy,
+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+        optimal_load: camcraft_motion::load::DEFAULT_OPTIMAL_LOAD,
+        blend_turns: false,
+    }
+}
+
+fn check(path: &Toolpath, region: &Region, r: f64) -> Vec<Warning> {
+    let t = ToolGeom {
+        radius: r,
+        nose_radius: 0.0,
+        flute_len: 30.0,
+        shank_radius: r,
+        shank_len: 40.0,
+        holder_radius: 20.0,
+        holder_len: 60.0,
+    };
+    let cx = VerifyContext {
+        region,
+        stock: None,
+        model: None,
+        tool: &t,
+        cutter: None,
+        mode: Mode::Area,
+        stock_top_z: 0.0,
+        clearance_z: 5.0,
+        stock_to_leave: 0.0,
+        gouge_tol: 0.01,
+        z_tol: 1e-6,
+        finish_tol: None,
+        fixtures: &[],
+        spindle: None,
+        ..Default::default()
+    };
+    verify(path, &cx)
+}
+
+fn seg_dist(q: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / len2).clamp(0.0, 1.0) } else { 0.0 };
+    ((q.x - a.x - t * dx).powi(2) + (q.y - a.y - t * dy).powi(2)).sqrt()
+}
+
+/// XY chords of every feed that runs flat at `z`.
+fn cuts_at(path: &Toolpath, z: f64) -> Vec<(Point2, Point2)> {
+    path.moves
+        .iter()
+        .filter(|m| m.kind == MoveKind::Feed && (m.from.z - z).abs() < 1e-9 && (m.to.z - z).abs() < 1e-9)
+        .flat_map(|m| m.chords(0.005))
+        .collect()
+}
+
+/// The only rapid allowed below the top of the cut: straight up, out of
+/// where the tool has just cut.
+fn lifts_out(m: &Move) -> bool {
+    m.from.x == m.to.x && m.from.y == m.to.y && m.to.z > m.from.z
+}
+
+/// Grid points of the fixture pocket (0.1 mm pitch).
+fn grid() -> impl Iterator<Item = Point2> {
+    (0..=600).flat_map(|i| (0..=400).map(move |j| Point2::new(f64::from(i) * 0.1, f64::from(j) * 0.1)))
+}
+
+/// Material the Ø12 tool certainly left: inside the pocket and outside
+/// the radius-6 opening, each by more than the film tolerance.
+fn certain_residue(p: Point2) -> bool {
+    depth_in(p, CORNER) > REST_FILM + 0.01 && depth_in(p, PREV_D * 0.5) < -(REST_FILM + 0.01)
+}
+
+fn invalid(r: Result<Toolpath, GenError>) -> String {
+    match r {
+        Err(GenError::Invalid(s)) => s,
+        other => panic!("expected an Invalid refusal, got {other:?}"),
+    }
+}
+
+#[test]
+fn rest_area_is_the_four_corners_and_never_reads_small() {
+    let region = rounded(W, H, CORNER);
+    let plan = rest_plan(&region, TOOL_D, 0.0, &prev()).unwrap();
+    assert!(plan.previous_fits);
+    assert_eq!(plan.rest.loops().len(), 4, "one rest area per corner");
+    // Exact residue: 4 x ((36 - 9 pi) - (9 - 2.25 pi)) = 23.18 mm2; the
+    // margin may add to it, nothing may take from it.
+    let exact = 4.0 * ((36.0 - 9.0 * std::f64::consts::PI) - (9.0 - 2.25 * std::f64::consts::PI));
+    let area = plan.rest.area().abs();
+    assert!(area > exact - 0.05 && area < exact + 1.5, "rest area {area}, exact {exact}");
+    let (mut certain, mut missed, mut far_inside) = (0usize, 0usize, 0usize);
+    for p in grid() {
+        if certain_residue(p) {
+            certain += 1;
+            if !plan.rest.contains(p) {
+                missed += 1;
+            }
+        }
+        // Well inside what the previous tool cleared: not rest.
+        if depth_in(p, PREV_D * 0.5) > 0.2 && plan.rest.contains(p) {
+            far_inside += 1;
+        }
+    }
+    assert!(certain > 1500, "the fixture has residue to find ({certain} grid points)");
+    assert_eq!(missed, 0, "residue the previous tool left is missing from the rest area");
+    assert_eq!(far_inside, 0, "the rest area reaches into cleared floor");
+    // Every rest loop sits in a 6 mm corner box.
+    for l in plan.rest.loops() {
+        for q in l.points() {
+            let (dx, dy) = (q.x.min(W - q.x), q.y.min(H - q.y));
+            assert!(dx < 6.2 && dy < 6.2, "rest point ({}, {}) is outside the corners", q.x, q.y);
+        }
+    }
+}
+
+#[test]
+fn rest_passes_cut_only_the_corners_and_cover_them() {
+    let region = rounded(W, H, CORNER);
+    for strategy in [PocketStrategy::Waterline, PocketStrategy::OffsetRings, PocketStrategy::Auto] {
+        let p = pp(strategy);
+        let path = rest_pocket(&region, &p, &prev()).unwrap();
+        assert_eq!(check(&path, &region, TOOL_D * 0.5), Vec::new(), "{strategy:?}: verifier");
+        assert!(path.notes.iter().any(|n| n.contains("rest machining trusts the entered previous tool")));
+        let mut cutting = 0usize;
+        for m in &path.moves {
+            let below = m.from.z < p.top_z - 1e-9 || m.to.z < p.top_z - 1e-9;
+            if m.kind == MoveKind::Rapid {
+                assert!(!below || lifts_out(m), "{strategy:?}: a rapid moves below the top of the cut: {m:?}");
+                continue;
+            }
+            if !below {
+                continue;
+            }
+            cutting += 1;
+            // The tool center stays within tool radius of a 6 mm corner
+            // box: no pass over the floor the previous tool cleared.
+            for q in [m.from, m.to] {
+                let (dx, dy) = (q.x.min(W - q.x), q.y.min(H - q.y));
+                assert!(dx < 8.3 && dy < 8.3, "{strategy:?}: cut at ({}, {}) is outside the corners", q.x, q.y);
+            }
+        }
+        assert!(cutting > 8, "{strategy:?}: the corners are cut");
+        // Coverage at the floor: every certain residue point is under
+        // the tool on some pass.
+        let cuts = cuts_at(&path, p.bottom_z);
+        assert!(!cuts.is_empty());
+        let reach = TOOL_D * 0.5 + 0.02;
+        let uncut = grid()
+            .filter(|&q| certain_residue(q))
+            .filter(|&q| !cuts.iter().any(|&(a, b)| seg_dist(q, a, b) <= reach))
+            .count();
+        assert_eq!(uncut, 0, "{strategy:?}: residue left uncut at the floor");
+    }
+}
+
+#[test]
+fn rest_pass_is_far_shorter_than_the_full_pocket() {
+    let region = rounded(W, H, CORNER);
+    let p = pp(PocketStrategy::Waterline);
+    let len = |t: &Toolpath| -> f64 {
+        cuts_at(t, p.bottom_z).iter().map(|&(a, b)| ((b.x - a.x).powi(2) + (b.y - a.y).powi(2)).sqrt()).sum()
+    };
+    let full = len(&pocket(&region, &p).unwrap());
+    let rest = len(&rest_pocket(&region, &p, &prev()).unwrap());
+    assert!(rest > 0.0 && rest < full * 0.25, "rest {rest} mm against full {full} mm");
+}
+
+#[test]
+fn previous_tool_not_larger_is_refused_by_name() {
+    let region = rounded(W, H, CORNER);
+    let p = pp(PocketStrategy::Waterline);
+    for d in [TOOL_D, 3.0] {
+        let msg = invalid(rest_pocket(&region, &p, &RestParams { previous_tool_diameter: d, ..prev() }));
+        assert!(msg.contains("needs a previous tool larger than this one"), "{msg}");
+        assert!(msg.contains(&format!("{d} mm")), "{msg}");
+    }
+}
+
+#[test]
+fn bad_rest_parameters_are_refused_by_name() {
+    let region = rounded(W, H, CORNER);
+    let p = pp(PocketStrategy::Waterline);
+    let cases = [
+        (RestParams { previous_corner_radius: 6.5, ..prev() }, "corner radius"),
+        (RestParams { previous_corner_radius: -0.1, ..prev() }, "corner radius"),
+        (RestParams { previous_stock_to_leave: -0.1, ..prev() }, "previous stock to leave"),
+        (RestParams { allowance: -0.1, ..prev() }, "rest allowance"),
+        (RestParams { allowance: f64::NAN, ..prev() }, "must be finite"),
+        (RestParams { previous_tool_diameter: f64::INFINITY, ..prev() }, "must be finite"),
+    ];
+    for (rest, word) in cases {
+        let msg = invalid(rest_pocket(&region, &p, &rest));
+        assert!(msg.contains(word), "{rest:?}: {msg}");
+    }
+    let adaptive = invalid(rest_pocket(&region, &pp(PocketStrategy::Adaptive), &prev()));
+    assert!(adaptive.contains("not available with the Adaptive strategy yet"), "{adaptive}");
+    let zigzag = invalid(rest_pocket(&region, &pp(PocketStrategy::Zigzag), &prev()));
+    assert!(zigzag.contains("not available with the Zigzag strategy"), "{zigzag}");
+    assert!(rest_plan(&region, 0.0, 0.0, &prev()).is_err());
+    assert!(rest_plan(&region, f64::NAN, 0.0, &prev()).is_err());
+    assert!(rest_plan(&region, TOOL_D, -1.0, &prev()).is_err());
+    assert!(rest_plan(&Region::empty(), TOOL_D, 0.0, &prev()).is_err());
+}
+
+#[test]
+fn nothing_left_is_refused_not_cut() {
+    // The previous tool's own radius in the corners: it reached all of it.
+    let region = rounded(W, H, 6.0);
+    let plan = rest_plan(&region, TOOL_D, 0.0, &prev()).unwrap();
+    assert!(plan.rest.is_empty() && plan.center.is_empty());
+    match rest_pocket(&region, &pp(PocketStrategy::Waterline), &prev()) {
+        Err(GenError::Empty(s)) => assert!(s.contains("no rest material"), "{s}"),
+        other => panic!("expected Empty, got {other:?}"),
+    }
+}
+
+#[test]
+fn previous_tool_that_fits_nowhere_leaves_the_whole_pocket() {
+    // A 10 mm wide pocket: the Ø12 tool never entered it.
+    let region = rounded(40.0, 10.0, 2.5);
+    let p = pp(PocketStrategy::Waterline);
+    let plan = rest_plan(&region, TOOL_D, 0.0, &prev()).unwrap();
+    assert!(!plan.previous_fits);
+    assert!((plan.rest.area() - region.area()).abs() < 1e-9);
+    let rest = rest_pocket(&region, &p, &prev()).unwrap();
+    let full = pocket(&region, &p).unwrap();
+    assert_eq!(rest.moves, full.moves, "the whole pocket is cut, as the plain pocket cuts it");
+    assert!(rest.notes.iter().any(|n| n.contains("fits nowhere in this pocket")));
+}
+
+#[test]
+fn a_neck_the_previous_tool_could_not_pass_is_rest_material() {
+    // Two 30 x 30 bays joined by a 6 mm wide, 10 mm long neck.
+    let region = poly(vec![
+        Point2::new(0.0, 0.0),
+        Point2::new(30.0, 0.0),
+        Point2::new(30.0, 12.0),
+        Point2::new(40.0, 12.0),
+        Point2::new(40.0, 0.0),
+        Point2::new(70.0, 0.0),
+        Point2::new(70.0, 30.0),
+        Point2::new(40.0, 30.0),
+        Point2::new(40.0, 18.0),
+        Point2::new(30.0, 18.0),
+        Point2::new(30.0, 30.0),
+        Point2::new(0.0, 30.0),
+    ]);
+    let plan = rest_plan(&region, TOOL_D, 0.0, &prev()).unwrap();
+    // (A 12 mm tool noses 0.8 mm into each mouth, between the corners.)
+    for x in [31.5, 35.0, 38.5] {
+        for y in [12.1, 15.0, 17.9] {
+            assert!(plan.rest.contains(Point2::new(x, y)), "neck point ({x}, {y}) is rest material");
+        }
+    }
+    assert!(!plan.rest.contains(Point2::new(15.0, 15.0)), "the bay floor was cleared");
+    // No slivers in the center area: one body for the neck, one per
+    // bay corner.
+    assert_eq!(plan.center.loops().len(), 9, "center areas");
+    assert!(plan.center.loops().iter().all(|l| l.area().abs() > 1.0), "a sliver in the center area");
+    let p = pp(PocketStrategy::Waterline);
+    let path = rest_pocket(&region, &p, &prev()).unwrap();
+    assert_eq!(check(&path, &region, TOOL_D * 0.5), Vec::new());
+    let cuts = cuts_at(&path, p.bottom_z);
+    let mid = Point2::new(35.0, 15.0);
+    assert!(cuts.iter().any(|&(a, b)| seg_dist(mid, a, b) <= TOOL_D * 0.5), "the neck is cut through");
+    for m in &path.moves {
+        if m.kind == MoveKind::Rapid && (m.from.z < p.top_z - 1e-9 || m.to.z < p.top_z - 1e-9) {
+            assert!(lifts_out(m), "a rapid moves below the top of the cut: {m:?}");
+        }
+    }
+}
+
+#[test]
+fn allowance_stock_and_corner_radius_only_grow_the_rest_area() {
+    let region = rounded(W, H, CORNER);
+    let base = rest_plan(&region, TOOL_D, 0.0, &prev()).unwrap().rest;
+    let variants = [
+        RestParams { allowance: 0.5, ..prev() },
+        RestParams { previous_stock_to_leave: 0.3, ..prev() },
+        RestParams { previous_corner_radius: 1.0, ..prev() },
+    ];
+    for v in variants {
+        let grown = rest_plan(&region, TOOL_D, 0.0, &v).unwrap().rest;
+        assert!(grown.area().abs() > base.area().abs() + 0.5, "{v:?}: {} mm2", grown.area());
+        // Nothing of the base area is lost (20 um for the offset chords).
+        let lost = base.difference(&grown).unwrap().offset(-0.02).unwrap();
+        assert!(lost.is_empty(), "{v:?}: the grown rest area dropped part of the base one");
+        let within = grown.difference(&region).unwrap().offset(-0.02).unwrap();
+        assert!(within.is_empty(), "{v:?}: the rest area leaves the pocket");
+    }
+    // Stock left on the walls is rest material all the way round.
+    let walls = rest_plan(&region, TOOL_D, 0.0, &variants[1]).unwrap().rest;
+    assert!(walls.contains(Point2::new(30.0, 0.15)) && walls.contains(Point2::new(0.15, 20.0)));
+}
+
+#[test]
+fn degenerate_pockets_error_and_never_panic() {
+    let p = pp(PocketStrategy::Waterline);
+    // Narrower than this tool.
+    let sliver = rounded(20.0, 3.0, 0.5);
+    assert!(invalid(rest_pocket(&sliver, &p, &prev())).contains("narrower than the tool"));
+    // Sub-micron and huge shapes: any answer but a panic or a hang.
+    for (w, h) in [(1e-4, 1e-4), (1e5, 1e5), (60.0, 4.0 + 1e-7)] {
+        let _ = rest_pocket(&rounded(w, h, w.min(h) * 0.1), &p, &prev());
+    }
+    let bad = PocketParams { stepover: 0.0, ..p };
+    assert!(rest_pocket(&rounded(W, H, CORNER), &bad, &prev()).is_err());
+}
diff --git a/docs/decisions/1446-rest-2d.md b/docs/decisions/1446-rest-2d.md
new file mode 100644
index 000000000..7d6e393bb
--- /dev/null
+++ b/docs/decisions/1446-rest-2d.md
@@ -0,0 +1,80 @@
+## #1446 - 2D rest machining: the generator first, the operation wiring after
+
+**What was decided.** The first slice of #1446 is the motion crate only:
+`machining2d::rest_plan` (the rest area and the cutter-center area for it)
+and `machining2d::rest_pocket` (the pocket's ring passes over that area),
+with the previous tool entered by hand (`RestParams`: diameter, corner
+radius, stock left on the walls, allowance). The operation parameter
+(default off), its undoable edit, the project file, the dialog group, the
+MCP parameters, the golden CL through the app, the stock-simulation
+reading, the Adaptive strategy and "from previous operations" are follow-up
+issues named in the PR. The PR says `Refs`, not a closing keyword.
+
+**Why.** `OpParams::Pocket` is matched in about fifty files; wiring a new
+group through the command, the project file, the UI and MCP is a second
+piece of work of its own, and the geometry is the part that must be right
+first (Prime Directive). The generator is usable and tested on its own.
+
+**How the rest area is computed.** The area a tool of radius R sweeps in a
+pocket is the opening of the pocket by a disc: inward offset by R, then
+outward by R (Serra 1982; Held 1991; Veeramani and Gau 1997; Yao, Gupta and
+Nau 2003 - cited in the module header). Rest = pocket minus that. Choices
+that are ours:
+
+- **Read large, never small.** The cleared area is shrunk by `REST_MARGIN`
+  (0.01 mm, two offset arc tolerances) before it is subtracted. A previous
+  tool with a corner radius sweeps only its flat (R minus the corner
+  radius): the fillet it leaves at the wall is rest material. Stock the
+  previous operation left on the walls is rest material. The allowance
+  grows the area and is refused when negative.
+- **A 0.02 mm film is not rest material** (`REST_FILM`). Without it the
+  margin itself would make every wall a rest area. This is the one place
+  the area is reduced; it is under what the offsets resolve.
+- **The tool's reach is read 0.05 mm long** (`REST_REACH`). The rest area
+  shares the pocket's walls, so its offset by the bare tool radius runs
+  along the pocket's own center boundary and their intersection leaves
+  slivers. Reading the reach long lets the pocket's boundary decide. It
+  only adds tool positions inside the pocket's own center area.
+- **The center area is always inside the plain pocket's center area.** A
+  rest pass cannot touch a wall the plain pocket would not touch.
+- **No rapid relies on the cleared estimate.** The passes are the pocket's
+  own: plunges and feeds below the top of the cut, a retract between
+  separate rest areas. A wrong previous tool costs a heavier cut, not a
+  rapid into stock. "Entered from already-cut space" (a faster entry
+  through cleared floor) is left to the follow-up, because it is the one
+  feature that would make the estimate safety-critical.
+- **The previous tool is trusted and the path says so** in a note: the
+  generator cannot see what really cut the pocket, or to what depth.
+
+**Strategies.** `Waterline` and `OffsetRings` as chosen; `Auto` reads as
+`Waterline` for a rest pass. `Zigzag` is refused by name: its rows have no
+pass along the wall, and the coverage test showed residue left in the
+corner (378 of the fixture's grid points). `Adaptive` is refused by name as
+not built yet. Dropped: mapping Zigzag silently to rings (the user chose
+rows; a refusal is honest), and letting Zigzag run with a note (a rest pass
+that leaves the corner is not what was asked for).
+
+**Fitted arcs are held to the crossing law.** Rest areas have thin horns
+where the pocket's boundary and the reach boundary meet at a shallow angle;
+two arcs fitted there crossed each other within tolerance (the verifier's
+Crossing law, on the neck fixture). `pocket_over` takes a switch that sends
+the rings through the existing `arc_cross` proof (an arc that crosses
+another feed goes back to its chords), as the Adaptive plan already does.
+The plain pocket does not set it and posts as before. Dropped: a
+morphological opening of the center area (it rounds the pocket's sharp
+corners and leaves material there).
+
+**Nothing left is a refusal, not an empty path** (`GenError::Empty`, "no
+rest material"). **A previous tool that fits nowhere** leaves the whole
+pocket: the path is the plain pocket's, with a note.
+
+**Structure.** `rest_pocket` is its own entry beside `pocket` instead of a
+field on `PocketParams`: the struct is `Copy` and built in many places, and
+default-off then needs no change anywhere. `PocketStrategy` moved to
+`pocket_strategy.rs` (structure only) to bring `pocket.rs` back toward the
+400-line law. No new dependency between crates.
