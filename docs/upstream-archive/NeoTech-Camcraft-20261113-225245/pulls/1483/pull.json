  "title": "fix(sim): draw lathe chuck bores inscribed so the collision solid never drops steel",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/NeoTech",
    "html_url": "https://github.com/NeoTech",
