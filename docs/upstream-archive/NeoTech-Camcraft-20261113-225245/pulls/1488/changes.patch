--- /dev/null
+++ b/xtask/src/process_bump.rs
@@ -0,0 +1,29 @@
+//! `cargo xtask process-bump`: the one writer of `.claude/PROCESS_VERSION` (#1153). Process PRs no
+//! longer carry the bump; the merging session runs this after a merge batch that changed process files.
+//! Provenance: our own process law (AGENTS.md "Process changes bump PROCESS_VERSION").
+
+use std::path::Path;
+
+const FILE: &str = ".claude/PROCESS_VERSION";
+
+/// The text after the bump: the single integer in `text` plus one, newline-terminated. A file that is
+/// not exactly one non-negative integer is refused rather than guessed at.
+pub fn bumped(text: &str) -> Result<String, String> {
+    let t = text.trim_start_matches('\u{feff}').trim();
+    let n: u64 = t.parse().map_err(|_| format!("{FILE} must hold one integer, got '{t}'"))?;
+    let next = n.checked_add(1).ok_or_else(|| format!("{FILE} overflows at {n}"))?;
+    Ok(format!("{next}\n"))
+}
+
+/// Rewrites the file under `root` with the next number; returns `old -> new` for the operator.
+pub fn run(root: &Path, args: &[String]) -> Result<i32, String> {
+    if let Some(a) = args.first() {
+        return Err(format!("process-bump takes no arguments, got '{a}'"));
+    }
+    let path = root.join(FILE);
+    let old = std::fs::read_to_string(&path).map_err(|e| format!("read {}: {e}", path.display()))?;
+    let new = bumped(&old)?;
+    std::fs::write(&path, &new).map_err(|e| format!("write {}: {e}", path.display()))?;
+    println!("PROCESS_VERSION {} -> {}", old.trim(), new.trim());
+    Ok(0)
+}
diff --git a/xtask/src/process_bump_tests.rs b/xtask/src/process_bump_tests.rs
new file mode 100644
index 000000000..11839c415
--- /dev/null
+++ b/xtask/src/process_bump_tests.rs
@@ -0,0 +1,30 @@
+//! Tests for `process_bump` (#1153): the bump is +1, one integer only, and the file is rewritten whole.
+
+use crate::process_bump::{bumped, run};
+
+#[test]
+fn bump_adds_one_and_ends_with_a_newline() {
+    assert_eq!(bumped("62\n").as_deref(), Ok("63\n"));
+    assert_eq!(bumped("  9 \r\n").as_deref(), Ok("10\n"));
+    assert_eq!(bumped("\u{feff}0").as_deref(), Ok("1\n"));
+}
+
+#[test]
+fn bump_refuses_anything_but_one_integer() {
+    for bad in ["", "abc", "62 63", "-1", "6.2"] {
+        assert!(bumped(bad).is_err(), "{bad:?} must be refused");
+    }
+    assert!(bumped(&u64::MAX.to_string()).is_err());
+}
+
+#[test]
+fn run_rewrites_the_file_and_refuses_arguments() {
+    let dir = std::env::temp_dir().join(format!("camcraft-process-bump-{}", std::process::id()));
+    let claude = dir.join(".claude");
+    std::fs::create_dir_all(&claude).expect("temp dir");
+    std::fs::write(claude.join("PROCESS_VERSION"), "41\n").expect("seed");
+    assert_eq!(run(&dir, &[]), Ok(0));
+    assert_eq!(std::fs::read_to_string(claude.join("PROCESS_VERSION")).expect("read"), "42\n");
+    assert!(run(&dir, &["--x".into()]).is_err());
+    let _ = std::fs::remove_dir_all(&dir);
+}

