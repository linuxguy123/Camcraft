+//! #1445: the drill page's Cycle combo - every cycle has one label, the
+//! label picks the cycle back, and the ream reads in plain English. The
+//! combo's own data, asserted structurally (no pixels).
+
+use crate::operations::{cycle_from_index, cycle_index, cycle_names};
+use camcraft_app::drilling::CycleChoice;
+
+const ALL: [CycleChoice; 9] = [
+    CycleChoice::Auto,
+    CycleChoice::Spot,
+    CycleChoice::Drill,
+    CycleChoice::Peck,
+    CycleChoice::Tap,
+    CycleChoice::Bore,
+    CycleChoice::BackBore,
+    CycleChoice::FloatingTap,
+    CycleChoice::Ream,
+];
+
+#[test]
+fn every_cycle_has_one_label_and_picks_itself_back() {
+    let names = cycle_names();
+    assert_eq!(names.len(), ALL.len(), "one label per cycle: {names:?}");
+    let mut seen = vec![false; names.len()];
+    for c in ALL {
+        let i = cycle_index(&c);
+        assert!(i < names.len(), "{c:?} indexes past the list");
+        assert!(!seen[i], "{c:?} shares label {:?}", names[i]);
+        seen[i] = true;
+        assert_eq!(cycle_from_index(i), c, "label {:?} picks {c:?} back", names[i]);
+    }
+}
+
+#[test]
+fn the_ream_reads_in_plain_english_and_an_unknown_index_is_auto() {
+    assert_eq!(cycle_names()[cycle_index(&CycleChoice::Ream)], "Ream (feed in, feed out)");
+    assert_eq!(cycle_from_index(cycle_names().len()), CycleChoice::Auto, "never a neighbouring cycle");
+}
diff --git a/crates/ui/src/operations.rs b/crates/ui/src/operations.rs
index 3f53148ea..e8fa853a2 100644
--- a/crates/ui/src/operations.rs
+++ b/crates/ui/src/operations.rs
@@ -53,7 +53,7 @@ pub fn side_names() -> &'static [&'static str] {
 /// for a tap, a boring cycle for a bore, depth-vs-diameter otherwise),
 /// so the note next to the combo reads from the op's tool, not a guess.
 pub fn cycle_names() -> &'static [&'static str] {
-    &["Auto", "Spot", "Drill", "Peck", "Tap (rigid)", "Bore", "Back bore", "Tap (floating holder)"]
+    &["Auto", "Spot", "Drill", "Peck", "Tap (rigid)", "Bore", "Back bore", "Tap (floating holder)", "Ream (feed in, feed out)"]
 }
 
 /// Combo index for a cycle choice - the inverse of what picking names.
@@ -68,6 +68,24 @@ pub(crate) fn cycle_index(c: &camcraft_app::drilling::CycleChoice) -> usize {
         C::FloatingTap => 7,
         C::Bore => 5,
         C::BackBore => 6,
+        C::Ream => 8,
+    }
+}
+
+/// The cycle a combo index picks - the inverse of [`cycle_index`]. An
+/// index outside the list reads as Auto, never as a neighbouring cycle.
+pub(crate) fn cycle_from_index(i: usize) -> camcraft_app::drilling::CycleChoice {
+    use camcraft_app::drilling::CycleChoice as C;
+    match i {
+        1 => C::Spot,
+        2 => C::Drill,
+        3 => C::Peck,
+        4 => C::Tap,
+        5 => C::Bore,
+        6 => C::BackBore,
+        7 => C::FloatingTap,
+        8 => C::Ream,
+        _ => C::Auto,
     }
 }
 
