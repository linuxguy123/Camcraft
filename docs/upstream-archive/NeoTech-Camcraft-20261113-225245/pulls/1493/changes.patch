+fn with_the_flag_off_the_drill_is_never_read() {
+    let (_w, _h, t) = job(Some((5.0, 3.0, "DR-0600")), false);
+    assert!(centre_plunges(&t).is_empty());
+    assert!(!noted(&t, "pre-drilled"), "{:?}", t.notes);
+}
