@@ -136,8 +136,10 @@ pub fn align_roles(world: &World, picks: &[(GeoSel, Role)]) -> Result<Alignment,
             (x, cross(a, x), a)
         }
         (Role::Z, Role::Y) => {
-            let x = square_to(g2, d2.dir, a, tilt)?;
-            (x, a, cross(x, a))
