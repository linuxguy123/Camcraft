+    assert_fitted(&op(&world, "S1").params);
+    let (t, warns) = generate(&world, "S1").expect("generates");
+    assert!(warns.iter().all(|w| !w.blocks_post()), "{warns:?}");
+    assert_inside_pocket(&t);
+}
