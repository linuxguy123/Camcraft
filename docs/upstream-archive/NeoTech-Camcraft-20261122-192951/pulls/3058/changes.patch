@@ -0,0 +1,172 @@
+//! The waterjet cut's plans (#1883): per contour, where the jet pierces
+//! and what it rides - a closed contour with its leads (or the
+//! tight-hole rule), a tabbed contour as led-in stretches between its
+//! gaps, an open run on its stated side.
+//!
+//! Provenance: see the module head (`super`). Leads and rides are the
+//! shared sheet kernel's ([`crate::sheet::lead`]). Our own code.
+
+use crate::cl::{CompSide, ContourRole};
+use crate::geo2d::{Loop, Point2, Region};
+use crate::machining2d::GenError;
+use crate::sheet::lead::{clear, cross, lead, ride, LeadAsk, Piece, LEAD_TRIES};
+use crate::sheet::nest::Contour;
+use crate::sheet::open::offset;
+use crate::sheet::ring::{centroid, longest_mid, nearest, unit, walk_from};
+use crate::sheet::Voice;
+
+use super::{LeadShape, OpenSide, WaterjetParams};
+
+/// One pierce and what the jet rides from it: the lit pieces, and the
+/// programmed part contour under control compensation.
+pub(super) struct Plan {
+    pub pierce: Point2,
+    pub lit: Vec<Piece>,
+    pub comp: Option<(CompSide, Vec<Piece>)>,
+}
+
+fn invalid(why: String) -> GenError {
+    Voice::WATERJET.invalid(why)
+}
+
+/// The waste side's normal for travel `t`: a hole's waste is its
+/// interior, an outline's its exterior; a CCW walk has its ring's
+/// interior on the left.
+fn waste(t: Point2, inner: bool, ccw: bool) -> Point2 {
+    if inner == ccw { Point2::new(-t.y, t.x) } else { Point2::new(t.y, -t.x) }
+}
+
+/// Is a contour of this role cut counter-clockwise?
+pub(super) fn ccw_of(role: ContourRole, p: &WaterjetParams) -> bool {
+    (role == ContourRole::Inner) != p.reversed
+}
+
+/// The leads of a stretch from `s` (travel `t_in`) to `e` (travel
+/// `t_out`): the pierce and the lead pieces, or `None` when a lead
+/// finds no room even shortened.
+#[allow(clippy::type_complexity)]
+fn leads(
+    (s, t_in): (Point2, Point2),
+    (e, t_out): (Point2, Point2),
+    (inner, ccw): (bool, bool),
+    p: &WaterjetParams,
+    forbidden: Option<&Region>,
+    notes: &mut Vec<String>,
+    label: &str,
+) -> Result<(Point2, Vec<Piece>, Vec<Piece>), &'static str> {
+    let straight = p.control_comp || p.lead_shape == LeadShape::Straight;
+    let tries = if p.control_comp { 1 } else { LEAD_TRIES };
+    let ask_in = LeadAsk { s, t: t_in, n: waste(t_in, inner, ccw), len: p.lead_in, straight, entry: true };
+    let ask_out = LeadAsk { s: e, t: t_out, n: waste(t_out, inner, ccw), len: p.lead_out, straight, entry: false };
+    let (pierce, lead_in) = lead(ask_in, forbidden, tries, notes, ("waterjet", label)).ok_or("in")?;
+    let (_, lead_out) = lead(ask_out, forbidden, tries, notes, ("waterjet", label)).ok_or("out")?;
+    Ok((pierce, lead_in, lead_out))
+}
+
+/// Plan one closed contour with no tabs on its kerf `ring`.
+pub(super) fn closed(c: &Contour, ring: &[Point2], p: &WaterjetParams, forbidden: Option<&Region>, notes: &mut Vec<String>, label: &str) -> Result<Plan, GenError> {
+    let inner = c.role == ContourRole::Inner;
+    let ccw = ccw_of(c.role, p);
+    let (seg, s) = longest_mid(ring);
+    let walk = walk_from(ring, seg, s, ccw);
+    let (t_in, t_out) = (unit(s, walk[1]), unit(walk[walk.len() - 2], s));
+    match leads((s, t_in), (s, t_out), (inner, ccw), p, forbidden, notes, label) {
+        Ok((pierce, lead_in, lead_out)) => {
+            let mut lit = lead_in;
+            lit.extend(ride(&walk));
+            lit.extend(lead_out.iter().copied());
+            let comp = if p.control_comp {
+                // G41/G42: the control offsets the PART contour; the
+                // engage and cancel blocks are the straight leads.
+                let (nseg, s_nom) = nearest(&c.pts, s);
+                let nominal = walk_from(&c.pts, nseg, s_nom, ccw);
+                let far = lead_out.last().map_or(s, |q| q.to());
+                let mut prog = vec![Piece::Line(s_nom)];
+                prog.extend(ride(&nominal));
+                prog.push(Piece::Line(far));
+                let left = cross(t_in, waste(t_in, inner, ccw)) > 0.0;
+                Some((if left { CompSide::Left } else { CompSide::Right }, prog))
+            } else {
+                None
+            };
+            Ok(Plan { pierce, lit, comp })
+        }
+        Err(end) if inner => tight_hole(ring, (ccw, t_out), p, forbidden, notes, label).map_err(|e| {
+            invalid(format!("{label}: the lead-{end} finds no room beside the part, and {e}"))
+        }),
+        Err(end) => Err(invalid(format!(
+            "{label}: the lead-{end} finds no room beside the part - shorten it, or cut this contour with the leads off"
+        ))),
+    }
+}
+
+/// The tight-hole rule: a hole too tight for its leads, even shortened,
+/// is pierced at its centre and led in straight to its ring; the
+/// lead-out is kept only where it finds room.
+fn tight_hole(ring: &[Point2], (ccw, _t_out): (bool, Point2), p: &WaterjetParams, forbidden: Option<&Region>, notes: &mut Vec<String>, label: &str) -> Result<Plan, String> {
+    let cpt = centroid(ring);
+    let cut = Loop::new(ring.to_vec()).and_then(|l| Region::new(vec![l])).map_err(|e| format!("its ring is unusable: {e}"))?;
+    if !cut.contains(cpt) || !clear(forbidden, &[cpt]) {
+        return Err("its centre stands outside its own cut - a centre pierce has no room either".into());
+    }
+    let (seg, s) = nearest(ring, cpt);
+    let walk = walk_from(ring, seg, s, ccw);
+    let t_out = unit(walk[walk.len() - 2], s);
+    let mut lit = vec![Piece::Line(s)];
+    lit.extend(ride(&walk));
+    let mut quiet = Vec::new();
+    let ask_out = LeadAsk { s, t: t_out, n: waste(t_out, true, ccw), len: p.lead_out, straight: true, entry: false };
+    if let Some((_, out)) = lead(ask_out, forbidden, LEAD_TRIES, &mut quiet, ("waterjet", label)) {
+        lit.extend(out);
+    }
+    notes.push(format!(
+        "waterjet: {label} is a tight hole - pierced at its centre and led in straight, its arc leads have no room"
+    ));
+    if p.control_comp {
+        notes.push(format!("waterjet: {label} (tight hole) rides the computer's kerf offset - G41/G42 needs room for its leads"));
+    }
+    Ok(Plan { pierce: cpt, lit, comp: None })
+}
+
+/// Plan the stretches of a tabbed contour, each led in and out.
+pub(super) fn tabbed(c: &Contour, stretches: &[Vec<Point2>], p: &WaterjetParams, forbidden: Option<&Region>, notes: &mut Vec<String>, label: &str) -> Result<Vec<Plan>, GenError> {
+    let inner = c.role == ContourRole::Inner;
+    let ccw = ccw_of(c.role, p);
+    let mut out = Vec::with_capacity(stretches.len());
+    for (j, run) in stretches.iter().enumerate() {
+        let n = run.len();
+        let (s, e) = (run[0], run[n - 1]);
+        let (t_in, t_out) = (unit(s, run[1]), unit(run[n - 2], e));
+        let here = format!("{label} stretch {}", j + 1);
+        let (pierce, lead_in, lead_out) = leads((s, t_in), (e, t_out), (inner, ccw), p, forbidden, notes, &here)
+            .map_err(|end| invalid(format!("{here}: the lead-{end} beside a tab finds no room - move the tab, or shorten the lead")))?;
+        let mut lit = lead_in;
+        lit.extend(ride(run));
+        lit.extend(lead_out);
+        out.push(Plan { pierce, lit, comp: None });
+    }
+    if p.control_comp {
+        notes.push(format!("waterjet: {label} (tabbed) rides the computer's kerf offset - each stretch is too short a G41/G42 span to trust"));
+    }
+    Ok(out)
+}
+
+/// Plan an open run on the stated side.
+pub(super) fn open(c: &Contour, p: &WaterjetParams, notes: &mut Vec<String>, label: &str) -> Result<Plan, GenError> {
+    let r = p.kerf * 0.5;
+    let pts = match p.open_side {
+        OpenSide::Center => c.pts.clone(),
+        OpenSide::Left => offset(&c.pts, r, p.cut_z, Voice::WATERJET)?,
+        OpenSide::Right => offset(&c.pts, -r, p.cut_z, Voice::WATERJET)?,
+    };
+    let Some((&pierce, rest)) = pts.split_first() else {
+        return Err(invalid(format!("{label} has no length - there is nothing to cut along")));
+    };
+    let side = match p.open_side {
+        OpenSide::Center => "on its centre line",
+        OpenSide::Left => "with the kerf left of its travel",
+        OpenSide::Right => "with the kerf right of its travel",
+    };
+    notes.push(format!("waterjet: {label} is an open run, cut {side} - pierced at its start, no leads, not judged by the kerf law"));
+    Ok(Plan { pierce, lit: rest.iter().copied().map(Piece::Line).collect(), comp: None })
+}
diff --git a/crates/motion/src/waterjet/tabs.rs b/crates/motion/src/waterjet/tabs.rs
new file mode 100644
index 000000000..2210fbc71
--- /dev/null
+++ b/crates/motion/src/waterjet/tabs.rs
@@ -0,0 +1,139 @@
+//! Waterjet tabs (#1883): short uncut gaps in a closed contour's cut
+//! that hold the part in the sheet. Each tab is laid on the jet-centre
+//! ring nearest its stated position, as a gap of its width plus the
+//! kerf; the ring between gaps is cut as open stretches, each pierced
+//! and led in on its own.
+//!
+//! Provenance: general waterjet and laser practice (tabs or
+//! micro-joints hold a part in the skeleton) over plain arc-length
+//! geometry on the ring ([`crate::sheet::arclen`]). Our own code.
+
+use crate::geo2d::Point2;
+use crate::machining2d::GenError;
+use crate::sheet::arclen::ArcRing;
+use crate::sheet::ring::{dist, nearest};
+use crate::sheet::Voice;
+
+use super::{JetTabs, MAX_TABS};
+
+/// The shortest stretch (mm) of cut between two tabs.
+const MIN_RUN: f64 = 1e-3;
+
+fn invalid(why: String) -> GenError {
+    Voice::WATERJET.invalid(why)
+}
+
+/// The door: count, width and positions, by name.
+pub(super) fn door(t: &JetTabs) -> Result<(), GenError> {
+    if t.count == 0 || t.count > MAX_TABS {
+        return Err(invalid(format!("the tab count must be 1 to {MAX_TABS} (it states {}) - for no tabs, turn tabs off", t.count)));
+    }
+    if !(t.width.is_finite() && t.width > 0.0) {
+        return Err(invalid(format!("the tab width must be a positive number of mm (it states {})", t.width)));
+    }
+    if t.at.len() != t.count as usize {
+        return Err(invalid(format!(
+            "the tab count is {} but {} tab position(s) are stated - each tab needs exactly one position",
+            t.count,
+            t.at.len()
+        )));
+    }
+    if t.at.iter().any(|p| !(p.x.is_finite() && p.y.is_finite())) {
+        return Err(invalid("a tab position is not a finite point".into()));
+    }
+    Ok(())
+}
+
+/// One tab's gap on a ring, by arc length on the counter-clockwise ring
+/// (`lo < hi`, `lo` may be negative or `hi` past the length: wrapped).
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Gap {
+    pub no: usize,
+    pub lo: f64,
+    pub hi: f64,
+    /// The gap's middle on the ring (the cover law's exemption centre).
+    pub mid: Point2,
+    /// Half the gap: half the width plus the kerf radius.
+    pub half: f64,
+}
+
+/// Lay every tab on the ring nearest it. `rings[k]` is the jet-centre
+/// ring of contour `k` (counter-clockwise), `None` for an open run.
+/// Returns the gaps per contour, sorted along the ring.
+pub(super) fn lay(t: &JetTabs, rings: &[Option<Vec<Point2>>], r: f64) -> Result<Vec<Vec<Gap>>, GenError> {
+    let mut out: Vec<Vec<Gap>> = vec![Vec::new(); rings.len()];
+    let h = t.width * 0.5 + r;
+    for (i, at) in t.at.iter().enumerate() {
+        let no = i + 1;
+        let best = rings
+            .iter()
+            .enumerate()
+            .filter_map(|(k, ring)| ring.as_ref().filter(|g| g.len() >= 3).map(|g| (k, nearest(g, *at))))
+            .map(|(k, (seg, foot))| (k, seg, foot, dist(*at, foot)))
+            .min_by(|a, b| a.3.total_cmp(&b.3));
+        let Some((k, seg, foot, off)) = best else {
+            return Err(invalid(format!("tab {no} has no closed contour to lie on - tabs hold closed contours only")));
+        };
+        if !(off.is_finite() && off <= r + t.width + 1e-9) {
+            return Err(invalid(format!(
+                "tab {no} at X{:.3} Y{:.3} stands {off:.3} mm from the nearest cut - place it on a contour's edge",
+                at.x, at.y
+            )));
+        }
+        let Some(ring) = rings.get(k).and_then(Option::as_ref) else { continue };
+        let a = ArcRing::new(ring);
+        let c = a.cum.get(seg).copied().unwrap_or(0.0) + dist(ring[seg], foot);
+        out[k].push(Gap { no, lo: c - h, hi: c + h, mid: foot, half: h });
+    }
+    for (k, gaps) in out.iter_mut().enumerate() {
+        if gaps.is_empty() {
+            continue;
+        }
+        let Some(ring) = rings.get(k).and_then(Option::as_ref) else { continue };
+        let len = ArcRing::new(ring).len;
+        gaps.sort_by(|a, b| a.lo.total_cmp(&b.lo));
+        let n = gaps.len();
+        for i in 0..n {
+            let (g, next) = (gaps[i], gaps[(i + 1) % n]);
+            let next_lo = if i + 1 == n { next.lo + len } else { next.lo };
+            if next_lo - g.hi < MIN_RUN {
+                return Err(invalid(if n == 1 {
+                    format!("tab {} leaves no contour to cut - its gap ({:.3} mm) takes the whole cut", g.no, 2.0 * g.half)
+                } else {
+                    format!("tabs {} and {} overlap or leave no cut between them - spread them apart", g.no.min(next.no), g.no.max(next.no))
+                }));
+            }
+        }
+    }
+    Ok(out)
+}
+
+/// The stretches of a ring between its gaps, each as points in the
+/// direction of travel (`ccw`: along the ring, else against it).
+pub(super) fn stretches(ring: &[Point2], gaps: &[Gap], ccw: bool) -> Vec<Vec<Point2>> {
+    let a = ArcRing::new(ring);
+    let n = gaps.len();
+    let mut out = Vec::with_capacity(n);
+    for i in 0..n {
+        let from = gaps[i].hi;
+        let to = if i + 1 == n { gaps[0].lo + a.len } else { gaps[i + 1].lo };
+        let mut pts = vec![a.at(from)];
+        for q in a.walk(from, to) {
+            if pts.last().is_none_or(|l| dist(*l, q) > 1e-9) {
+                pts.push(q);
+            }
+        }
+        if !ccw {
+            pts.reverse();
+        }
+        if pts.len() >= 2 {
+            out.push(pts);
+        }
+    }
+    out
+}
+
+/// Is `q` (a point of the part edge) under one of the gaps' bridges?
+pub(super) fn bridged(gaps: &[Gap], q: Point2) -> bool {
+    gaps.iter().any(|g| dist(g.mid, q) <= g.half)
+}
diff --git a/crates/motion/src/waterjet/tests.rs b/crates/motion/src/waterjet/tests.rs
new file mode 100644
index 000000000..f8365db50
--- /dev/null
+++ b/crates/motion/src/waterjet/tests.rs
@@ -0,0 +1,229 @@
+//! The waterjet profile's laws (#1883): inner-first order, kerf side,
+//! leads with the pierce in the waste, tabs as uncut gaps, the
+//! tight-hole rule, open-run sides, arc linearization and refusals.
+
+use super::*;
+use crate::cl::{MoveKind, Toolpath};
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+    Loop::new(vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)]).unwrap()
+}
+
+fn circle(cx: f64, cy: f64, r: f64) -> Loop {
+    Loop::new(
+        (0..96)
+            .map(|k| {
+                let t = std::f64::consts::TAU * f64::from(k) / 96.0;
+                Point2::new(cx + r * t.cos(), cy + r * t.sin())
+            })
+            .collect(),
+    )
+    .unwrap()
+}
+
+fn params() -> WaterjetParams {
+    WaterjetParams {
+        kerf: 1.0,
+        control_comp: false,
+        reversed: false,
+        lead_shape: LeadShape::Arc,
+        lead_in: 3.0,
+        lead_out: 2.0,
+        open_side: OpenSide::Center,
+        tabs: None,
+        pierce_time: 1.5,
+        abrasive_delay: 0.5,
+        linearize: None,
+        feed: 300.0,
+        clearance_z: 10.0,
+        cut_z: 0.0,
+        model_excess: 0.0,
+    }
+}
+
+/// A 100 x 60 plate with a Ø30 hole and a 10 x 10 square hole.
+fn plate() -> (Vec<Loop>, Region) {
+    let loops = vec![rect(0.0, 0.0, 100.0, 60.0), circle(30.0, 30.0, 15.0), rect(70.0, 25.0, 80.0, 35.0)];
+    let part = Region::new(loops.clone()).unwrap();
+    (loops, part)
+}
+
+/// Each pierce: the rapid that descends to the cut plane.
+fn pierces(path: &Toolpath, cut_z: f64) -> Vec<Point2> {
+    path.moves
+        .iter()
+        .filter(|m| m.kind == MoveKind::Rapid && m.to.z == cut_z && m.from.z > cut_z)
+        .map(|m| Point2::new(m.to.x, m.to.y))
+        .collect()
+}
+
+fn feeds(path: &Toolpath) -> Vec<Point2> {
+    path.moves.iter().filter(|m| m.kind == MoveKind::Feed).map(|m| Point2::new(m.to.x, m.to.y)).collect()
+}
+
+#[test]
+fn holes_are_cut_before_the_outline_and_every_pierce_is_in_the_waste() {
+    let (loops, part) = plate();
+    let p = params();
+    let path = waterjet_profile(&loops, &[], &part, &p).unwrap();
+    let ps = pierces(&path, p.cut_z);
+    assert_eq!(ps.len(), 3, "one pierce per contour: {ps:?}");
+    // The two holes first (their pierces stand inside the holes), the
+    // outline last (its pierce stands outside the plate).
+    let outline = Region::new(vec![rect(0.0, 0.0, 100.0, 60.0)]).unwrap();
+    assert!(outline.contains(ps[0]) && outline.contains(ps[1]), "holes first: {ps:?}");
+    assert!(!outline.contains(ps[2]), "the outline last, pierced outside: {:?}", ps[2]);
+    for q in &ps {
+        assert!(!part.contains(*q), "a pierce on the part at {q:?}");
+    }
+    // The kerf side: every lit point stands at least r - tol off the part.
+    let grown = part.offset(0.5 - KERF_TOL).unwrap();
+    for q in feeds(&path) {
+        assert!(!grown.contains(q), "a lit point reaches the part at {q:?}");
+    }
+    assert!(path.has_arcs(), "arc leads and the round hole ride as arcs");
+    assert!(path.notes.iter().any(|n| n.contains("cut inner first (2 hole(s), 0 tab(s)), 3 pierce(s)")), "{:?}", path.notes);
+}
+
+#[test]
+fn straight_leads_lay_no_arc_on_a_square_part() {
+    let loops = vec![rect(0.0, 0.0, 50.0, 50.0)];
+    let part = Region::new(loops.clone()).unwrap();
+    let p = WaterjetParams { lead_shape: LeadShape::Straight, ..params() };
+    let path = waterjet_profile(&loops, &[], &part, &p).unwrap();
+    let lit: Vec<_> = path.moves.iter().filter(|m| m.kind == MoveKind::Feed).collect();
+    let (first, last) = (lit[0], lit[lit.len() - 1]);
+    assert!(first.arc.is_none() && last.arc.is_none(), "straight lead-in and lead-out: {first:?} {last:?}");
+    let ps = pierces(&path, p.cut_z);
+    // The lead-in is perpendicular: the pierce stands 3 mm + r square
+    // off the middle of one edge (the longest edge's middle is the start).
+    assert_eq!(ps.len(), 1);
+    let q = ps[0];
+    let off = [-q.x, q.x - 50.0, -q.y, q.y - 50.0].into_iter().fold(f64::NEG_INFINITY, f64::max);
+    assert!((off - 3.5).abs() < 1e-6, "the pierce stands r + 3 mm square off an edge: {q:?}");
+}
+
+#[test]
+fn tabs_leave_uncut_gaps_and_each_stretch_is_pierced_and_led_in() {
+    let loops = vec![rect(0.0, 0.0, 100.0, 60.0)];
+    let part = Region::new(loops.clone()).unwrap();
+    let at = vec![Point2::new(50.0, 0.0), Point2::new(50.0, 60.0)];
+    // 6 mm tabs: wide enough that the leads beside a gap cannot reach
+    // its middle, so the cover law must know the bridge is meant.
+    let p = WaterjetParams { tabs: Some(JetTabs { count: 2, width: 6.0, at }), ..params() };
+    let path = waterjet_profile(&loops, &[], &part, &p).unwrap();
+    let ps = pierces(&path, p.cut_z);
+    assert_eq!(ps.len(), 2, "two stretches between two tabs, each pierced: {ps:?}");
+    for q in &ps {
+        assert!(!part.contains(*q), "a stretch pierced on the part at {q:?}");
+    }
+    // Each 6 mm bridge stays: no lit chord comes within the kerf radius
+    // of the part edge along the tab (x 47..53 on both long edges).
+    let chords: Vec<(Point2, Point2)> =
+        path.moves.iter().filter(|m| m.kind == MoveKind::Feed).flat_map(|m| m.chords(0.005)).collect();
+    for k in 0..=59 {
+        let x = 47.05 + 0.1 * f64::from(k);
+        for edge in [Point2::new(x, 0.0), Point2::new(x, 60.0)] {
+            let d = chords.iter().map(|(a, b)| crate::sheet::laws::pt_seg(edge, *a, *b)).fold(f64::INFINITY, f64::min);
+            assert!(d > 0.5 - 1e-6, "the jet cuts the tab at {edge:?} ({d:.4} mm)");
+        }
+    }
+    assert!(path.notes.iter().any(|n| n.contains("2 tab(s)), 2 pierce(s)")), "{:?}", path.notes);
+}
+
+#[test]
+fn a_tight_hole_is_pierced_at_its_centre() {
+    // A Ø4 hole: the 3 mm arc lead-in has no room even halved four
+    // times (the ring is Ø3 with a 1 mm kerf), so it is centre-pierced.
+    let loops = vec![rect(0.0, 0.0, 40.0, 40.0), circle(20.0, 20.0, 2.0)];
+    let part = Region::new(loops.clone()).unwrap();
+    let p = WaterjetParams { lead_in: 20.0, ..params() };
+    let path = waterjet_profile(&loops, &[], &part, &p).unwrap();
+    let ps = pierces(&path, p.cut_z);
+    assert!((ps[0].x - 20.0).abs() < 0.05 && (ps[0].y - 20.0).abs() < 0.05, "centre pierce: {:?}", ps[0]);
+    assert!(path.notes.iter().any(|n| n.contains("tight hole")), "{:?}", path.notes);
+}
+
+#[test]
+fn linearize_sends_every_arc_as_chords() {
+    let (loops, part) = plate();
+    let p = WaterjetParams { linearize: Some(0.01), ..params() };
+    let path = waterjet_profile(&loops, &[], &part, &p).unwrap();
+    assert!(!path.has_arcs(), "no arc survives linearization");
+    let grown = part.offset(0.5 - KERF_TOL).unwrap();
+    for q in feeds(&path) {
+        assert!(!grown.contains(q), "a chord point reaches the part at {q:?}");
+    }
+    assert!(path.notes.iter().any(|n| n.contains("arcs sent as chords")));
+}
+
+#[test]
+fn an_open_run_rides_its_stated_side() {
+    let run = vec![Point2::new(0.0, 0.0), Point2::new(20.0, 0.0)];
+    for (side, y) in [(OpenSide::Center, 0.0), (OpenSide::Left, 0.5), (OpenSide::Right, -0.5)] {
+        let p = WaterjetParams { open_side: side, ..params() };
+        let path = waterjet_profile(&[], std::slice::from_ref(&run), &Region::empty(), &p).unwrap();
+        let f = feeds(&path);
+        assert!(f.iter().all(|q| (q.y - y).abs() < 1e-9), "{side:?}: {f:?}");
+    }
+}
+
+#[test]
+fn control_compensation_records_a_comp_span_per_untabbed_contour() {
+    let (loops, part) = plate();
+    let p = WaterjetParams { control_comp: true, lead_in: 3.0, lead_out: 3.0, ..params() };
+    let path = waterjet_profile(&loops, &[], &part, &p).unwrap();
+    assert_eq!(path.comps.len(), 3, "one G41/G42 span per contour");
+}
+
+#[test]
+fn bad_input_is_refused_by_name() {
+    let (loops, part) = plate();
+    let cases: Vec<(WaterjetParams, &str)> = vec![
+        (WaterjetParams { kerf: 0.0, ..params() }, "kerf width must be a positive"),
+        (WaterjetParams { feed: f64::NAN, ..params() }, "cut feed must be a positive"),
+        (WaterjetParams { pierce_time: -1.0, ..params() }, "pierce time must be zero or more"),
+        (WaterjetParams { linearize: Some(0.0), ..params() }, "linearization tolerance"),
+        (WaterjetParams { control_comp: true, lead_in: 0.2, ..params() }, "needs a straight lead-in"),
+        (
+            WaterjetParams { tabs: Some(JetTabs { count: 2, width: 2.0, at: vec![Point2::new(50.0, 0.0)] }), ..params() },
+            "tab count is 2 but 1 tab position",
+        ),
+        (
+            WaterjetParams { tabs: Some(JetTabs { count: 1, width: 2.0, at: vec![Point2::new(50.0, 30.0)] }), ..params() },
+            "place it on a contour's edge",
+        ),
+        (
+            WaterjetParams {
+                tabs: Some(JetTabs { count: 2, width: 4.0, at: vec![Point2::new(50.0, 0.0), Point2::new(52.0, 0.0)] }),
+                ..params()
+            },
+            "tabs 1 and 2 overlap",
+        ),
+    ];
+    for (p, want) in cases {
+        let e = waterjet_profile(&loops, &[], &part, &p).unwrap_err().to_string();
+        assert!(e.contains("waterjet profile") && e.contains(want), "want {want:?}, got {e}");
+    }
+    let e = waterjet_profile(&[], &[], &part, &params()).unwrap_err().to_string();
+    assert!(e.contains("no contour to cut"), "{e}");
+}
+
+#[test]
+fn a_slot_narrower_than_the_kerf_is_refused_not_bridged() {
+    // A 0.6 mm notch in the outline: the 1 mm kerf bridges it.
+    let notch = Loop::new(vec![
+        Point2::new(0.0, 0.0),
+        Point2::new(20.0, 0.0),
+        Point2::new(20.0, 10.0),
+        Point2::new(10.3, 10.0),
+        Point2::new(10.3, 5.0),
+        Point2::new(9.7, 5.0),
+        Point2::new(9.7, 10.0),
+        Point2::new(0.0, 10.0),
+    ])
+    .unwrap();
+    let part = Region::new(vec![notch.clone()]).unwrap();
+    let e = waterjet_profile(&[notch], &[], &part, &params()).unwrap_err().to_string();
+    assert!(e.contains("the jet never comes within a kerf"), "{e}");
+}
diff --git a/crates/motion/src/wire_edm/open.rs b/crates/motion/src/wire_edm/open.rs
index 8ba57e5da..4f933964b 100644
--- a/crates/motion/src/wire_edm/open.rs
+++ b/crates/motion/src/wire_edm/open.rs
@@ -33,6 +33,8 @@ use crate::geometry::Point3;
 use crate::machining2d::GenError;
 
