From d7e31fbea1545e2569e5602f6e6a93708e6295ec Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 22 Nov 2026 18:43:27 +0100
Subject: [PATCH 1/2] ci(post-merge): raise the batch gate step limit to 75
 minutes

The step "Batch gate tier" stopped at 45 minutes. After PR #3363 added
wgpu and the crate camcraft-gpu, each runner must build app, gpu and ui
from a cold state one time. That build did not finish in 45 minutes
(runs 45045638947 and 45046106061), so no test ran.

The step limit is now 75 minutes and the check in "Gate summary" is
74. The job limit of 90 minutes and the xtask watchdog do not change.

Fixes #3535

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .github/workflows/post-merge.yml | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/post-merge.yml b/.github/workflows/post-merge.yml
index cdcdf8119..01ee71233 100644
--- a/.github/workflows/post-merge.yml
+++ b/.github/workflows/post-merge.yml
@@ -83,9 +83,11 @@ jobs:
         if: ${{ steps.yield.outputs.skip != 'true' }}
         # Second line of defence against a hung step (#3303): a normal run
         # takes about 21 minutes, and the xtask watchdog kills a step that is
-        # silent for 15. The job cap (90) stays. "Gate summary" reads 44 or
-        # more minutes with no summary as this timeout.
-        timeout-minutes: 45
+        # silent for 15. A cold build of app, gpu and ui can take longer than
+        # 45 minutes (#3535), so the limit is 75. The job cap (90) stays.
+        # "Gate summary" reads 74 or more minutes with no summary as this
+        # timeout.
+        timeout-minutes: 75
         shell: bash
         # The UI suites open windows: inside xvfb-run when no display is set
         # (AGENTS.md "The cut runner"). sccache comes from the runner's
@@ -116,7 +118,7 @@ jobs:
             ! grep -qE '^ +FAIL in ' gate-output.txt 2>/dev/null; then
             start=$(cat gate-start.txt 2>/dev/null || echo 0)
             mins=$(( ($(date +%s) - start) / 60 ))
-            if [ "$start" -gt 0 ] && [ "$mins" -ge 44 ]; then
+            if [ "$start" -gt 0 ] && [ "$mins" -ge 74 ]; then
               last=$(grep -E '^\[[0-9]+\] ' gate-output.txt 2>/dev/null | tail -n 1 || true)
               echo "gate step TIMEOUT after ${mins} min; last started step: ${last:-none}" | tee -a gate-output.txt
             fi

