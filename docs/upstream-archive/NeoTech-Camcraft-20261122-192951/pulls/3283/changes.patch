+}
+
+#[test]
+fn an_obstacle_on_the_entry_line_is_skipped_while_clear_edges_still_cut() {
+    let mut facets = brick();
+    facets.extend(
+        cube(Point3::new(-2.0, -3.0, 21.0), Point3::new(2.0, 1.0, 23.0))
+            .facets
