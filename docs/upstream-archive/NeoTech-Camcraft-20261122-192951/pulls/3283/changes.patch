+                h.write_u32(sizing.passes);
+                h.write_u8(u8::from(*axis_mode == crate::multiaxis::DeburrAxisMode::Axis4));
+                for v in [*lead_deg, *lag_deg, *max_tilt_deg] {
+                    w(h, v);
+                }
+                h.write_u8(u8::from(*shank_avoid));
+            }
             _ => {}
         }
     }
