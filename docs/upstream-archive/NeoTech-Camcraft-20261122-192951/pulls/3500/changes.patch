+function _arcSweep(a, u, v) {
+  var s = a.start, e = a.end, c = a.center;
+  var a0 = Math.atan2(s[v] - c[v], s[u] - c[u]), a1 = Math.atan2(e[v] - c[v], e[u] - c[u]);
