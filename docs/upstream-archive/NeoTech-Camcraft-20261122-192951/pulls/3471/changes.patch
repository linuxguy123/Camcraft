+#[test]
+fn a_full_helical_turn_off_by_float_noise_stays_a_helix() {
+    let noisy = mill_stream("5432", "Arc CCW X 18123 Y 5432.001 Z 5000 F 180000 I 10123 J 5432\n", "X 18123 Y 5432");
