+}
+
+// ------------------------------------------------------- canned cycles
+// Mach3 lists G73, G81, G82, G83, G85, G86, G89 with G98/G99; this post
+// writes all of them (G85 for the ream cycle, #1445). One block per hole,
+// holes of an unchanged cycle continuing modally with bare X Y lines.
+// The dwell P is in seconds, or in milliseconds when the user's Mach3 has
+// "G04 Dwell param in ms" on (the dwellInMilliseconds option). Mach3's
+// G84 needs a spindle that follows the feed, which this post cannot
+// know, so a tap is refused by name - a tap cannot be plain moves.
+function secs(s) {
+  return optBool("dwellInMilliseconds", false) ? String(Math.round(Number(s) * 1000)) : trim(Number(s).toFixed(3));
+}
+function onCycle() {
+  startPreamble();
+  restorePlane();            // a cycle drills along G17's Z
+  var p = properties;
+  seeZ(p.R);
+  var dwell = has(p.P) && p.P > 0 ? p.P : 0; // P is seconds
+  var g = "G81";
