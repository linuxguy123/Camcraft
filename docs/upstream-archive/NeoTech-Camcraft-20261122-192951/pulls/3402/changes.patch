diff --git a/crates/motion/src/machining2d/pocket_hsm_start.rs b/crates/motion/src/machining2d/pocket_hsm_start.rs
new file mode 100644
index 000000000..1c9dc627b
--- /dev/null
+++ b/crates/motion/src/machining2d/pocket_hsm_start.rs
@@ -0,0 +1,73 @@
+//! "Pass starts at" for the planar Adaptive pocket (#3355): how the HSM
+//! plan honours the shared `PassStart` of #3316. Provenance: our own law
+//! from general machining practice (an adaptive cut starts from open
+//! air or grows from its own bore, never with a full-width slot along a
+//! wall) and the air-side plan of #1950 (Held 1991); no vendor material
+//! consulted.
+
+use crate::geo2d::Region;
+
+use super::face::GenError;
+use super::adaptive_method::AdaptiveMethod;
+use super::pass_start::PassStart;
+use super::pocket::{PocketParams, PocketStrategy, plan_passes_from};
+use super::pocket_hsm::{Planned, adaptive_ordered};
+
+/// The Adaptive pocket's passes under `start`. `stock` is the stock
+/// outline in the area's own frame (`None`: not known here).
+///
+/// - Auto: [`super::pocket_hsm::adaptive_passes`] with no stock, the plan
+///   every earlier file cut, byte for byte.
+/// - Outside: each piece is cut from the air past the stock edge inward
+///   and ends on its holes' walls (the #1950 air plan). Where a piece
+///   has no air side, the Offset rings cut the area from its outer
+///   boundary in, and the note says why.
+/// - Inside: an area without holes is the growth plan itself - it
+///   starts at its bore in the core and walks out to the outer wall. An
+///   area with holes cannot start on a hole wall without a full-width
+///   slot, so the Offset rings cut it from its holes out, said.
+///
+/// The trochoid fallback is tried only under Auto: its loops follow the
+/// medial line and have no ring order.
+pub(crate) fn adaptive_passes_from(center: &Region, p: &PocketParams, what: &str, stock: Option<&Region>, start: PassStart) -> Result<Planned, GenError> {
+    match start {
+        PassStart::Auto => adaptive_ordered(center, p, what, true, None, start),
+        PassStart::Outside => match stock.filter(|s| !s.is_empty()) {
+            Some(st) => adaptive_ordered(center, p, what, false, Some(st), start),
+            None => rings(center, p, what, start, "has no stock outline to start from in the air"),
+        },
+        PassStart::Inside if center.loops().iter().any(|l| l.area() < 0.0) => {
+            rings(center, p, what, start, "cannot start on a hole wall without a full-width slot")
+        }
+        PassStart::Inside => adaptive_ordered(center, p, what, false, None, start),
+    }
+}
+
+/// Why the Trochoidal method refuses `start` (#3355), or `None`. Its
+/// loops follow the area's medial line and have no ring order, so Inside
+/// and Outside are refused by name, never ignored.
+#[must_use]
+pub fn trochoidal_pass_start_refusal(method: AdaptiveMethod, start: PassStart) -> Option<String> {
+    (method == AdaptiveMethod::Trochoidal && start != PassStart::Auto).then(|| {
+        format!(
+            "Pass starts at {} is not available with the Trochoidal method - its loops follow the medial line and have no ring order; use Auto or Spiral",
+            start.label()
+        )
+    })
+}
+
+/// The Offset rings in the order `start` asks, with the note that names
+/// the switch (an order is never changed in silence).
+fn rings(center: &Region, p: &PocketParams, what: &str, start: PassStart, why: &str) -> Result<Planned, GenError> {
+    let s = PocketStrategy::OffsetRings;
+    let step = crate::load::load_step(p.tool_diameter, p.optimal_load);
+    let note = format!(
+        "adaptive: Pass starts at {} - the HSM plan {why}; Offset rings cut {what} in that order instead",
+        start.label()
+    );
+    Ok((plan_passes_from(center, step, p.climb, s, start)?, vec![note], s, None, Vec::new()))
+}
+
+#[cfg(test)]
+#[path = "pocket_hsm_start_tests.rs"]
+mod tests;
diff --git a/crates/motion/src/machining2d/pocket_hsm_start_tests.rs b/crates/motion/src/machining2d/pocket_hsm_start_tests.rs
new file mode 100644
index 000000000..9fe288ec8
--- /dev/null
+++ b/crates/motion/src/machining2d/pocket_hsm_start_tests.rs
@@ -0,0 +1,134 @@
+//! Pins of #3355 on a square boundary (a sketch 96 mm wide) over a
+//! 70 x 70 stock with a 30 x 30 part in its middle, one level: Outside
+//! cuts the open band from the air, Inside starts on the part wall, and
+//! Auto ignores the stock outline (byte for byte). Ours.
+
+use super::*;
+use crate::cl::{MoveKind, Toolpath};
+use crate::entry::Entry3D;
+use crate::geo2d::{Loop, Point2};
+use crate::geometry::Point3;
+use crate::load::DEFAULT_OPTIMAL_LOAD;
+use crate::machining2d::{CornerRelief, pocket_started, pocket_started_in};
+
+const R: f64 = 5.0;
+
+fn square(s: f64, ccw: bool) -> Loop {
+    let mut pts = vec![Point2::new(-s, -s), Point2::new(s, -s), Point2::new(s, s), Point2::new(-s, s)];
+    if !ccw {
+        pts.reverse();
+    }
+    let Ok(l) = Loop::new(pts) else { panic!("loop") };
+    l
+}
+
+fn reg(loops: Vec<Loop>) -> Region {
+    let Ok(r) = Region::new(loops) else { panic!("region") };
+    r
+}
+
+fn params() -> PocketParams {
+    PocketParams {
+        blend_radius: None,
+        tool_diameter: 2.0 * R,
+        stepover: 4.0,
+        stock_to_leave: 0.0,
+        clearance_z: 40.0,
+        retract_z: None,
+        top_z: 10.0,
+        bottom_z: 5.0,
+        stepdown: 5.0,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+        strategy: PocketStrategy::Adaptive,
+        entry: Entry3D::Helix,
+        helix_radius: 2.0,
+        optimal_load: DEFAULT_OPTIMAL_LOAD,
+        blend_turns: false,
+        links: crate::links::Links::PLANAR,
+    }
+}
+
+/// The band: the sketch less the part.
+fn band() -> Region {
+    reg(vec![square(48.0, true), square(15.0, false)])
+}
+
+fn stock() -> Region {
+    reg(vec![square(35.0, true)])
+}
+
+fn cut(region: &Region, start: PassStart, stock: Option<&Region>) -> Toolpath {
+    match pocket_started_in(region, &params(), &[], &CornerRelief::default(), start, stock) {
+        Ok(t) => t,
+        Err(e) => panic!("{start:?}: {e}"),
+    }
+}
+
+/// Where the first planar feed ends and where the last one ends.
+fn first_last(t: &Toolpath) -> (Point3, Point3) {
+    let mut planar = t.moves.iter().filter(|m| m.kind == MoveKind::Feed && (m.from.z - m.to.z).abs() < 1e-9);
+    let Some(first) = planar.next().map(|m| m.to) else { panic!("no planar feed") };
+    (first, planar.last().map_or(first, |m| m.to))
+}
+
+/// How far `p` stands outside the axis square of half-width `s`.
+fn outside(p: Point3, s: f64) -> f64 {
+    let (dx, dy) = ((p.x.abs() - s).max(0.0), (p.y.abs() - s).max(0.0));
+    dx.hypot(dy)
+}
+
+#[test]
+fn outside_cuts_the_band_from_the_air_and_ends_on_the_part_wall() {
+    let t = cut(&band(), PassStart::Outside, Some(&stock()));
+    assert!(t.notes.iter().any(|n| n.contains("air plan")), "the air plan cut it: {:?}", t.notes);
+    let (first, last) = first_last(&t);
+    assert!(outside(first, 35.0) >= R, "the first pass starts in the stock: {first:?}");
+    assert!((outside(last, 15.0) - R).abs() < 0.05, "the level ends off the part wall: {last:?}");
+}
+
+#[test]
+fn outside_without_a_stock_outline_rides_the_rings_from_the_outer_edge_said() {
+    let t = cut(&band(), PassStart::Outside, None);
+    assert!(t.notes.iter().any(|n| n.contains("Pass starts at Outside") && n.contains("no stock outline")), "{:?}", t.notes);
+    let (first, last) = first_last(&t);
+    assert!((first.x.abs().max(first.y.abs()) - (48.0 - R)).abs() < 0.05, "the first ring is off the outer edge: {first:?}");
+    assert!((outside(last, 15.0) - R).abs() < 0.05, "the level ends off the part wall: {last:?}");
+}
+
+/// A closed pocket inside the stock has no air side: the growth spiral
+/// would start in its core, so Outside rides the rings from its wall in.
+#[test]
+fn outside_on_a_closed_pocket_rides_the_rings_from_its_wall_said() {
+    let pocket = reg(vec![square(30.0, true)]);
+    let t = cut(&pocket, PassStart::Outside, Some(&stock()));
+    assert!(t.notes.iter().any(|n| n.contains("Pass starts at Outside") && n.contains("in the air")), "{:?}", t.notes);
+    let (first, _) = first_last(&t);
+    assert!((first.x.abs().max(first.y.abs()) - (30.0 - R)).abs() < 0.05, "the first ring is off the pocket wall: {first:?}");
+}
+
+#[test]
+fn inside_with_holes_starts_on_the_part_wall_said() {
+    let t = cut(&band(), PassStart::Inside, Some(&stock()));
+    assert!(t.notes.iter().any(|n| n.contains("Pass starts at Inside") && n.contains("hole wall")), "{:?}", t.notes);
+    let (first, _) = first_last(&t);
+    assert!((outside(first, 15.0) - R).abs() < 0.05, "the first ring is off the part wall: {first:?}");
+}
+
+#[test]
+fn inside_without_holes_is_the_growth_plan_and_auto_ignores_the_stock() {
+    let pocket = reg(vec![square(30.0, true)]);
+    let auto = cut(&pocket, PassStart::Auto, None);
+    assert_eq!(cut(&pocket, PassStart::Inside, Some(&stock())), auto, "Inside on a pocket is the growth plan");
+    let Ok(old) = pocket_started(&band(), &params(), &[], &CornerRelief::default(), PassStart::Auto) else { panic!("auto") };
+    assert_eq!(cut(&band(), PassStart::Auto, Some(&stock())), old, "Auto reads no stock outline");
+}
+
+#[test]
+fn trochoidal_refuses_a_forced_start_by_name() {
+    assert_eq!(trochoidal_pass_start_refusal(AdaptiveMethod::Spiral, PassStart::Outside), None);
+    assert_eq!(trochoidal_pass_start_refusal(AdaptiveMethod::Trochoidal, PassStart::Auto), None);
+    let Some(why) = trochoidal_pass_start_refusal(AdaptiveMethod::Trochoidal, PassStart::Inside) else { panic!("refused") };
+    assert!(why.contains("Pass starts at Inside") && why.contains("Trochoidal"), "{why}");
+}
