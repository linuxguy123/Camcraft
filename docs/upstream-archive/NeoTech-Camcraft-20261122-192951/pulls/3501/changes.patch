 use camcraft_post::cl::{Move, MoveKind, Toolpath};
 use camcraft_post::geometry::Point3;
@@ -189,3 +195,79 @@ fn an_upright_program_after_an_upright_section_writes_no_return() {
         assert!(!out.program.lines().any(|l| word(l, 'A').is_some() || word(l, 'B').is_some()), "{stem}:\n{}", out.program);
     }
 }
+
+/// Mach4 indexes an AC trunnion (3+2): the first section stands at one
+/// A angle. It already retracts and writes `G00 A0 C0` at the next
+/// upright section; this pins it (#3477, item 4).
+#[test]
+fn mach4_states_upright_after_an_indexed_section() {
+    let (s, c) = (30f64.to_radians().sin(), 30f64.to_radians().cos());
+    let lean = [0.0, -s, c];
+    let tilted = Toolpath::new(upright_path().moves.iter().map(|m| m.with_axis(lean)).collect());
+    for tool in [1, 2] {
+        let mut r = dump_of(&tilted, "Lean1", 1);
+        r.extend(dump_of(&upright_path(), "Flat2", tool));
+        let out = engine::run(&read("assets/posts/mach4.cps"), &ac_trunnion_support::review_trunnion(), &cnc::serialize(&r))
+            .expect("mach4 posts");
+        assert_returns("mach4", &out, 'A', &format!("tool {tool}"));
+    }
+}
+
+/// Each shipped post that writes tilted moves declares the return.
+#[test]
+fn each_shipped_rotary_post_declares_upright_after_tilt() {
+    for stem in ["fanuc", "doosan-dnm", "mach4", "tormach"] {
+        let cps = read(&format!("assets/posts/{stem}.cps"));
+        assert!(
+            cps.lines().any(|l| l.trim_start().starts_with("uprightReturn = true;")),
+            "{stem}.cps declares uprightReturn = true"
+        );
+    }
+}
+
+/// A user's copy of a shipped post without the declaration.
+fn undeclared(stem: &str) -> String {
+    read(&format!("assets/posts/{stem}.cps"))
+        .lines()
+        .filter(|l| !l.trim_start().starts_with("uprightReturn"))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn run_undeclared(stem: &str, r: &[cnc::Record]) -> engine::PostOutput {
+    engine::run_with(&undeclared(stem), &tilthead(), &cnc::serialize(r), &json!({ "rotaryBrake": true }))
+        .unwrap_or_else(|e| panic!("{stem}: the stream posts or refuses by warning: {e}"))
+}
+
+#[test]
+fn a_script_without_upright_after_tilt_is_refused_by_name() {
+    for stem in ["fanuc", "doosan-dnm"] {
+        for tool in [1, 2] {
+            let mut r = dump_of(&tilted_path(), "Lean1", 1);
+            r.extend(dump_of(&upright_path(), "Flat2", tool));
+            let out = run_undeclared(stem, &r);
+            assert!(
+                out.warnings.iter().any(|w| w.contains("uprightReturn") && w.contains("\"Flat2\"") && w.contains("\"Lean1\"")),
+                "{stem} (tool {tool}): the engine refuses the upright section by name: {:?}",
+                out.warnings
+            );
+        }
+    }
+}
+
+#[test]
+fn a_script_without_upright_after_tilt_posts_a_program_with_no_return_to_state() {
+    // No section opens upright after a tilted section: no refusal.
+    let tilted_then_tilted = [dump_of(&tilted_path(), "Lean1", 1), dump_of(&tilted_path(), "Lean2", 1)].concat();
+    let upright_then_tilted = [dump_of(&upright_path(), "Flat1", 1), dump_of(&tilted_path(), "Lean2", 1)].concat();
+    let upright_then_upright = [dump_of(&upright_path(), "Flat1", 1), dump_of(&upright_path(), "Flat2", 2)].concat();
+    for (case, r) in [
+        ("tilted only", dump_of(&tilted_path(), "Lean1", 1)),
+        ("tilted, tilted", tilted_then_tilted),
+        ("upright, tilted", upright_then_tilted),
+        ("upright, upright", upright_then_upright),
+    ] {
+        let out = run_undeclared("fanuc", &r);
+        assert!(!out.warnings.iter().any(|w| w.contains("uprightReturn")), "{case}: {:?}", out.warnings);
+    }
+}

From 5796026b43ce2821b5deb88b1cd42b83853dc5d3 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sun, 22 Nov 2026 07:53:54 -0800
Subject: [PATCH 3/3] docs(decisions): record the uprightReturn flag choice
 (#3477)

Refs #3477

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../decisions/3477-upright-after-tilt-flag.md | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)
 create mode 100644 docs/decisions/3477-upright-after-tilt-flag.md

diff --git a/docs/decisions/3477-upright-after-tilt-flag.md b/docs/decisions/3477-upright-after-tilt-flag.md
new file mode 100644
index 000000000..f584ef777
--- /dev/null
+++ b/docs/decisions/3477-upright-after-tilt-flag.md
@@ -0,0 +1,49 @@
+## #3477 - A script without the `uprightReturn` declaration gets no upright section after a tilt
+
+**What was decided.** A new manifest flag, `uprightReturn = true`, says
+that the script retracts to a safe height and commands the rotaries to
+zero at the start of each section that follows a tilted section. A new
+engine pass, `post::upright_after_tilt`, reads the stream before any hook
+runs. When the script does not declare the flag, the pass finds the first
+section that:
+
+1. comes after a section that left A, B or C away from zero (the modal
+   angles of the last move that stated them), and
+2. has a first move that states no A/B/C.
+
+The engine then adds one counted warning that names the two operations
+and the flag. A warning blocks the post in the app, as every engine
+refusal by warning does. The shipped posts that write tilted moves
+(fanuc, doosan-dnm, mach4, tormach) declare the flag. Each one has a
+posting test of the real order in `crates/post/tests/upright_after_tilt.rs`.
+The Mach4 AC trunnion fixture moved to `crates/post/tests/ac_trunnion_support/`
+so that this file can pin Mach4 too.
+
+**Why.** The angle words are modal. `post::dump` writes no angle on a
+move without a leaning axis, so only the script can command the return.
+The shipped posts do it (#3466), but no law makes a script of the user
+do it. A refusal by name is the Prime Directive's answer: no silent cut
+at the old lean.
+
+**Considered and dropped.**
+
+- *The name `uprightAfterTilt`* (the issue's example). PR #3466 already
+  defines a script function `uprightAfterTilt()` in fanuc.cps and
+  doosan-dnm.cps. A top-level `uprightAfterTilt = true` replaces that
+  function, and the post fails with "not a callable function". The flag
+  is `uprightReturn` instead.
+- *A hard `PostError::Refused` before the hooks.* That changes the first
+  refusal of programs that other laws already refuse. The warning is
+  added after the other warnings, so their order stays the same, and the
+  post is still blocked.
+- *Refuse each section after a tilted section* (also a tilted one). A
+  section whose first move states its angles commands the pose itself.
+  The order of that turn against the first X/Y traverse is the
+  first-traverse law (#3100, #3300), not this one.
+- *A C angle left by C-axis live-tool work.* The live-tool law (#33) is
+  section-scoped: the script disengages C at the section's end. A
+  section with `PARAM LiveTool` does not leave C as a tilt.
+- *A text check of the shipped posts' return in the engine.* The engine
+  cannot read what a script writes before it runs. The posting tests pin
+  the real order for each shipped post that declares the flag, as for
+  `rotariesBeforeTraverse`.
