+        assert_eq!(r.clip_ring(&ring(1.0, 1.0, 9.0, 9.0), true), Ok(RingClip::Whole));
+        assert_eq!(r.clip_ring(&ring(1.0, 1.0, 9.0, 9.0), false), Ok(RingClip::Pieces(Vec::new())));
+        // The ring (3,3)-(5,7) runs through the hole on x = 5 between
