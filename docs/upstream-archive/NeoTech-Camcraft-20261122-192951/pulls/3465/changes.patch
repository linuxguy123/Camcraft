From baa356d200ba5f4b2ded7989d5a702c9e402b09d Mon Sep 17 00:00:00 2001
From: mkinney <mike.kinney@gmail.com>
Date: Sun, 22 Nov 2026 15:50:47 +0100
Subject: [PATCH] fix(kernel): mesh capped pocket-wall cylinder faces

Try the existing constrained mesher when the display planner caps a face.
Keep the tolerance, topology and volume checks.
Pin the reported STEP and Solidcraft models.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #3444
---
 crates/kernel/src/machining_mesh.rs        |   9 +-
 crates/kernel/tests/hole_on_pocket_wall.rs |  44 ++
 crates/kernel/tests/step_agreement.rs      |   1 +
 crates/kernel/tests/step_agreement/rows.rs |   7 +
 docs/decisions/3444-hole-on-pocket-wall.md |  24 +
 testdata/models/hole_on_pocket_wall.sc     | Bin 0 -> 15877 bytes
 testdata/models/hole_on_pocket_wall.step   | 540 +++++++++++++++++++++
 7 files changed, 624 insertions(+), 1 deletion(-)
 create mode 100644 crates/kernel/tests/hole_on_pocket_wall.rs
 create mode 100644 docs/decisions/3444-hole-on-pocket-wall.md
 create mode 100644 testdata/models/hole_on_pocket_wall.sc
 create mode 100644 testdata/models/hole_on_pocket_wall.step

diff --git a/crates/kernel/src/machining_mesh.rs b/crates/kernel/src/machining_mesh.rs
index 30da419a9..89fc61ba9 100644
--- a/crates/kernel/src/machining_mesh.rs
+++ b/crates/kernel/src/machining_mesh.rs
@@ -297,7 +297,14 @@ pub(crate) fn planned(
         }
         let tol = MeshTolerance::chord(chord);
         let planned = catch_unwind(AssertUnwindSafe(|| {
-            solidcore_tess::plan(record, &tol, size)
+            let planned = solidcore_tess::plan(record, &tol, size)?;
+            // The display planner can exhaust its face refinement budget.
+            // Try the constrained mesh path; all acceptance checks still apply.
+            if planned.1.over_tolerance.iter().any(|o| !o.within) && !stop.is_cancelled() {
+                solidcore_tess::mesh(record, &solidcore_tess::MeshSpec::chord(chord), size, None)
+            } else {
+                Ok(planned)
+            }
         }))
         .map_err(|_| MeshRefusal::Planner("the planner panicked".into()))?;
         let (mut plan, stats) = planned.map_err(|e| MeshRefusal::Planner(e.to_string()))?;
diff --git a/crates/kernel/tests/hole_on_pocket_wall.rs b/crates/kernel/tests/hole_on_pocket_wall.rs
new file mode 100644
index 000000000..e084b6e52
--- /dev/null
+++ b/crates/kernel/tests/hole_on_pocket_wall.rs
@@ -0,0 +1,44 @@
+//! Provenance: regression from our SolidCraft plate fixture reported in #3444.
+//! Gate map (M12.1): covers camcraft_kernel::machining_mesh.
+
+use camcraft_kernel::machining_mesh::machining_mesh;
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::import_step;
+use solidcore::kernel::CancelToken;
+
+#[test]
+fn hole_on_pocket_wall_meshes_within_tolerance() {
+    let bytes = include_bytes!("../../../testdata/models/hole_on_pocket_wall.step");
+    let mut kernel = SolidcoreKernel::default();
+    let mut imported = import_step(&mut kernel, bytes, &CancelToken::new())
+        .expect("the hole on the pocket wall must import");
+    assert_eq!(imported.solids.len(), 1, "the plate has one solid");
+    let solid = imported.solids.remove(0);
+    let mesh = machining_mesh(&solid, 0.005, &CancelToken::new())
+        .expect("the hole on the pocket wall must mesh within 0.005 mm");
+    assert_eq!(mesh.report.open_sides, 0);
+    assert!(mesh.report.deviation.largest() <= 0.005, "{:?}", mesh.report.deviation);
+    assert_eq!(mesh.report.faces, 13);
+    assert!(mesh.report.volume > 0.0);
+    let expected_volume = 140_000.0 - 117.0 * std::f64::consts::PI;
+    assert!((mesh.report.volume - expected_volume).abs() < 1.0, "{:?}", mesh.report);
+}
+
+#[test]
+fn hole_on_pocket_wall_solidcraft_meshes_within_tolerance() {
+    let bytes = include_bytes!("../../../testdata/models/hole_on_pocket_wall.sc");
+    let imported = camcraft_kernel::solidcraft::import_solidcraft(
+        &mut SolidcoreKernel::default(),
+        bytes,
+        &CancelToken::new(),
+    )
+    .expect("the hole on the pocket wall must import from Solidcraft");
+    let mesh = machining_mesh(&imported.solid, 0.005, &CancelToken::new())
+        .expect("the Solidcraft hole on the pocket wall must mesh within 0.005 mm");
+    assert_eq!(mesh.report.open_sides, 0);
+    assert!(mesh.report.deviation.largest() <= 0.005, "{:?}", mesh.report.deviation);
+    assert_eq!(mesh.report.faces, 13);
+    assert!(mesh.report.volume > 0.0);
+    let expected_volume = 140_000.0 - 117.0 * std::f64::consts::PI;
+    assert!((mesh.report.volume - expected_volume).abs() < 1.0, "{:?}", mesh.report);
+}
