@@ -0,0 +1,60 @@
+//! ApplyCutRecipe (#3073): make a new operation from a saved cut recipe
+//! on new geometry, as one undoable step. The recipe's tool must still
+//! be in the document and its material must still be in the table and
+//! agree with the material in force; else it is refused with the
+//! recipe's name. Every creation gate then applies through
+//! `CreateOperation`, so a recipe can never make an operation the
+//! property panel could not.
+//!
+//! Provenance: our own command, a thin composite over CreateOperation.
+
+use flecs_ecs::prelude::World;
+
+use crate::commands::{Command, CommandError};
+use crate::cut_recipe::CutRecipe;
+use crate::model;
+use crate::operation::SrcRef;
+
+use super::CreateOperation;
+
+/// One undo step: the operation the recipe made.
+pub struct ApplyCutRecipe(CreateOperation);
+
+impl ApplyCutRecipe {
+    /// Operation `name` from `recipe` on `src`, in the active setup.
+    pub fn new(world: &World, recipe: &CutRecipe, name: &str, src: SrcRef) -> Result<Self, CommandError> {
+        let r = &recipe.name;
+        if !recipe.tool.is_empty() {
+            let found = model::find_by_name(world, &recipe.tool).is_some_and(|e| model::is_tool(world, &e));
+            if !found {
+                return Err(CommandError::Needs(format!(
+                    "cut recipe '{r}': its tool '{}' is not in the document - add it, or save the recipe again with a tool that is",
+                    recipe.tool
+                )));
+            }
+        }
+        let wanted = recipe.material().map_err(CommandError::Needs)?;
+        let setup = crate::setup::active(world);
+        if let (Some(wanted), Some(here)) = (wanted, crate::stock_material::in_force(world, setup.as_deref()))
+            && wanted != here
+        {
+            return Err(CommandError::Needs(format!(
+                "cut recipe '{r}' is for {} ('{}'), but this setup cuts {} - its feeds and steps do not fit",
+                wanted.label(),
+                wanted.word(),
+                here.label()
+            )));
+        }
+        CreateOperation::new(world, name, &recipe.tool, src, recipe.params.clone()).map(Self)
+    }
+}
+
+impl Command for ApplyCutRecipe {
+    fn apply(&self, world: &World) {
+        self.0.apply(world);
+    }
+
+    fn invert(&self, world: &World) {
+        self.0.invert(world);
+    }
+}
diff --git a/crates/app/src/cut_recipe.rs b/crates/app/src/cut_recipe.rs
new file mode 100644
index 000000000..29f1e6642
--- /dev/null
+++ b/crates/app/src/cut_recipe.rs
@@ -0,0 +1,140 @@
+//! Saved cut recipes (#3073): an operation's settings - its kind and
+//! every parameter (depths, stepdown, stepover, feeds, tabs, leads,
+//! ramps), its tool by name and the workpiece material it was cut in -
+//! stored under a name, so a repeat job applies them to new geometry in
+//! one step (`commands::ApplyCutRecipe`). The geometry is not part of a
+//! recipe: the caller names the new source when it applies one.
+//!
+//! The library is one `recipes.camrecipes` file in a small
+//! `camcraft-recipes/1` envelope, the fixture library's shape: a strict
+//! reader that refuses the whole file by entry name, and a writer whose
+//! save -> load -> save is byte-stable. Parameters are written in the
+//! exact form a `.camproj` holds them (`project::ParamsDto`).
+//!
+//! Provenance: our own format and domain model; no vendor recipe,
+//! template or wording was consulted (#3066 clean-room boundary).
+
+use flecs_ecs::prelude::World;
+use serde_json::{Value, json};
+
+use crate::model;
+use crate::operation::OpParams;
+use crate::project;
+use crate::tools::WorkMaterial;
+
+mod store;
+
+pub use store::{ENV_VAR, LIBRARY_FILE, LibraryError, add, find, library_path, load, user_dir, user_dir_for};
+
+/// The envelope's `format` tag.
+pub const FORMAT: &str = "camcraft-recipes";
+/// The envelope's `version`; a reader refuses any other.
+pub const VERSION: u64 = 1;
+
+/// One saved recipe.
+#[derive(Clone, Debug, PartialEq)]
+pub struct CutRecipe {
+    /// The user's handle for the recipe; unique in a library.
+    pub name: String,
+    /// The document tool the recipe cuts with, by name (empty for a kind
+    /// that mounts no tool).
+    pub tool: String,
+    /// The workpiece material word (`WorkMaterial::word`) in force when
+    /// it was saved; `None` = no material was stated.
+    pub material: Option<String>,
+    /// The operation kind and all its parameters.
+    pub params: OpParams,
+}
+
+impl CutRecipe {
+    /// The recipe of operation `operation` (its key) under `name`.
+    /// Refused by name: an empty name, or no such operation.
+    pub fn capture(world: &World, operation: &str, name: &str) -> Result<Self, String> {
+        let name = name.trim();
+        if name.is_empty() {
+            return Err("a cut recipe needs a name".into());
+        }
+        let op = model::find_by_name(world, operation)
+            .and_then(|e| model::operation_of(world, &e))
+            .ok_or_else(|| format!("no operation named '{operation}'"))?;
+        let material = crate::stock_material::in_force(world, op.setup.as_deref()).map(|m| m.word().to_owned());
+        Ok(Self { name: name.to_owned(), tool: op.tool, material, params: op.params })
+    }
+
+    /// The recipe's material as the table knows it. A word the table no
+    /// longer has is refused with the recipe's name and the word.
+    pub fn material(&self) -> Result<Option<WorkMaterial>, String> {
+        match &self.material {
+            None => Ok(None),
+            Some(w) => WorkMaterial::from_word(w)
+                .map(Some)
+                .ok_or_else(|| format!("cut recipe '{}': its material '{w}' is not a known workpiece material", self.name)),
+        }
+    }
+}
+
+fn entry_to_json(r: &CutRecipe) -> Result<Value, String> {
+    let params = project::params_to_json(&r.params);
+    if params.is_null() {
+        return Err(format!("cut recipe '{}': its parameters cannot be written", r.name));
+    }
+    Ok(json!({ "name": r.name, "tool": r.tool, "material": r.material, "params": params }))
+}
+
+fn entry_from_json(v: &Value, index: usize) -> Result<CutRecipe, String> {
+    let name = v
+        .get("name")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .filter(|n| !n.is_empty())
+        .ok_or_else(|| format!("cut recipe {index} has no name"))?
+        .to_owned();
+    let tool = match v.get("tool") {
+        Some(Value::String(t)) => t.clone(),
+        _ => return Err(format!("cut recipe '{name}' has no tool")),
+    };
+    let material = match v.get("material") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(m)) => Some(m.clone()),
+        Some(_) => return Err(format!("cut recipe '{name}': material is not a word")),
+    };
+    let params = v.get("params").ok_or_else(|| format!("cut recipe '{name}' has no params"))?;
+    let params = project::params_from_stored_json(params).map_err(|e| format!("cut recipe '{name}': {e}"))?;
+    Ok(CutRecipe { name, tool, material, params })
+}
+
+/// The library text for `recipes`. Two recipes with one name are refused.
+pub fn to_text(recipes: &[CutRecipe]) -> Result<String, String> {
+    let mut entries = Vec::with_capacity(recipes.len());
+    for (i, r) in recipes.iter().enumerate() {
+        if recipes[..i].iter().any(|o| o.name == r.name) {
+            return Err(format!("cut recipe '{}' is saved twice", r.name));
+        }
+        entries.push(entry_to_json(r)?);
+    }
+    let doc = json!({ "format": FORMAT, "version": VERSION, "recipes": entries });
+    serde_json::to_string_pretty(&doc).map_err(|e| e.to_string())
+}
+
+/// Read a library text. A wrong envelope, a malformed entry or a name
+/// used twice refuses the whole file, by entry name.
+pub fn parse(text: &str) -> Result<Vec<CutRecipe>, String> {
+    let doc: Value = serde_json::from_str(text).map_err(|e| format!("not a cut recipe library: {e}"))?;
+    if doc.get("format").and_then(Value::as_str) != Some(FORMAT) {
+        return Err(format!("not a cut recipe library (format is not '{FORMAT}')"));
+    }
+    match doc.get("version").and_then(Value::as_u64) {
+        Some(VERSION) => {}
+        other => return Err(format!("cut recipe library version {other:?} is not {VERSION}")),
+    }
+    let list = doc.get("recipes").and_then(Value::as_array).ok_or("cut recipe library has no recipes list")?;
+    let mut out: Vec<CutRecipe> = Vec::with_capacity(list.len());
+    for (i, v) in list.iter().enumerate() {
+        let r = entry_from_json(v, i)?;
+        if out.iter().any(|o| o.name == r.name) {
+            return Err(format!("cut recipe '{}' is in the library twice", r.name));
+        }
+        out.push(r);
+    }
+    Ok(out)
+}
diff --git a/crates/app/src/cut_recipe/store.rs b/crates/app/src/cut_recipe/store.rs
new file mode 100644
index 000000000..15cfc6834
--- /dev/null
+++ b/crates/app/src/cut_recipe/store.rs
@@ -0,0 +1,129 @@
+//! Where the user's cut recipe library lives and how it is edited
+//! (#3073): one `recipes.camrecipes` in the user recipes folder,
+//! resolved like the fixtures folder: `CAMCRAFT_RECIPES`, else
+//! `<platform data dir>/camcraft/recipes`. Saving a recipe is a file
+//! edit, not a document command: nothing here touches a world or the
+//! undo history, and every write is all or nothing.
+//!
+//! Provenance: our own resolver from the platforms' published per-user
+//! data locations (Windows `%APPDATA%`, macOS `~/Library/Application
+//! Support`, the XDG Base Directory spec); the atomic save is the
+//! write-temp-then-rename pattern from the `std::fs::rename` docs.
+
+use std::ffi::OsString;
+use std::fmt;
+use std::path::{Path, PathBuf};
+
+use super::{CutRecipe, parse, to_text};
+
+/// The override: an absolute folder holding the library file.
+pub const ENV_VAR: &str = "CAMCRAFT_RECIPES";
+/// The library's file name inside the folder.
+pub const LIBRARY_FILE: &str = "recipes.camrecipes";
+
+/// The user recipes folder from an environment lookup, for the named
+/// platform (`std::env::consts::OS`). Pure, so the order is testable.
+/// `None` = no home to put one in.
+#[must_use]
+pub fn user_dir_for(os: &str, get: impl Fn(&str) -> Option<OsString>) -> Option<PathBuf> {
+    let abs = |k: &str| get(k).map(PathBuf::from).filter(|p| p.is_absolute());
+    if let Some(dir) = abs(ENV_VAR) {
+        return Some(dir);
+    }
+    let data = match os {
+        "windows" => abs("APPDATA"),
+        "macos" => abs("HOME").map(|h| h.join("Library").join("Application Support")),
+        _ => abs("XDG_DATA_HOME").or_else(|| abs("HOME").map(|h| h.join(".local").join("share"))),
+    }?;
+    Some(data.join("camcraft").join("recipes"))
+}
+
+/// The user recipes folder for this process.
+#[must_use]
+pub fn user_dir() -> Option<PathBuf> {
+    user_dir_for(std::env::consts::OS, |k| std::env::var_os(k))
+}
+
+/// The library file in `dir`.
+#[must_use]
+pub fn library_path(dir: &Path) -> PathBuf {
+    dir.join(LIBRARY_FILE)
+}
+
+/// Why a library read or edit did not happen. Nothing was written.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum LibraryError {
+    /// The file (or a recipe to add) is refused, in words.
+    Refused(String),
+    /// This name is already in the library: ask before replacing.
+    Exists(String),
+    /// No recipe of this name.
+    NotFound(String),
+    /// The disk refused (the OS error, in words).
+    Io(String),
+}
+
+impl fmt::Display for LibraryError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            LibraryError::Refused(why) => write!(f, "{why}"),
+            LibraryError::Exists(n) => write!(f, "cut recipe '{n}' is already in the library"),
+            LibraryError::NotFound(n) => write!(f, "no cut recipe '{n}' in the library"),
+            LibraryError::Io(e) => write!(f, "{e}"),
+        }
+    }
+}
+
+/// The library at `path`. A missing file is the empty library; an
+/// unreadable or refused one is an error, never "empty".
+pub fn load(path: &Path) -> Result<Vec<CutRecipe>, LibraryError> {
+    match std::fs::read_to_string(path) {
+        Ok(text) => parse(&text).map_err(LibraryError::Refused),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(Vec::new()),
+        Err(e) => Err(LibraryError::Io(format!("{}: {e}", path.display()))),
+    }
+}
+
+/// The recipe `name` of the library at `path`.
+pub fn find(path: &Path, name: &str) -> Result<CutRecipe, LibraryError> {
+    load(path)?.into_iter().find(|r| r.name == name).ok_or_else(|| LibraryError::NotFound(name.to_owned()))
+}
+
+/// Add `recipe` to the library at `path`. A name already there is
+/// refused as `Exists` unless `replace`.
+pub fn add(path: &Path, recipe: CutRecipe, replace: bool) -> Result<(), LibraryError> {
+    let mut lib = load(path)?;
+    if lib.iter().any(|r| r.name == recipe.name) {
+        if !replace {
+            return Err(LibraryError::Exists(recipe.name));
+        }
+        lib.retain(|r| r.name != recipe.name);
+    }
+    lib.push(recipe);
+    save(path, &lib)
+}
+
+/// Write `recipes` to `path` atomically: a temp file in the same folder,
+/// flushed, then renamed over the target. The folder is created when
+/// missing; on any failure the temp file is removed.
+fn save(path: &Path, recipes: &[CutRecipe]) -> Result<(), LibraryError> {
+    use std::io::Write;
+    let text = to_text(recipes).map_err(LibraryError::Refused)?;
+    let io = |e: std::io::Error| LibraryError::Io(format!("{}: {e}", path.display()));
+    let dir = path.parent().ok_or_else(|| LibraryError::Io(format!("{} has no folder", path.display())))?;
+    std::fs::create_dir_all(dir).map_err(io)?;
+    let name = path.file_name().map_or_else(|| "recipes".into(), |n| n.to_string_lossy().into_owned());
+    let tmp = dir.join(format!(".{name}.{}.tmp", std::process::id()));
+    let wrote = (|| {
+        let mut f = std::fs::File::create(&tmp)?;
+        f.write_all(text.as_bytes())?;
+        f.sync_all()?;
+        drop(f);
+        std::fs::rename(&tmp, path)
+    })();
+    if let Err(e) = wrote {
+        let _ = std::fs::remove_file(&tmp);
+        return Err(io(e));
+    }
+    Ok(())
+}
