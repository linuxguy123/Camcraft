From 51e830f25fd4ed5c038896f0230d2ca9b3ab6198 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 22 Nov 2026 17:09:28 +0100
Subject: [PATCH] test(multiaxis): re-pin the inherited rapid pose to the
 upright home

#3300 made a leaning 5-axis path state the upright Z column on every
station before its first lean. Three motion tests started their
inherited-pose memory at None, the old law, so the opening rapid
read as a new pose. The rapid states the home it inherits (the stamp
holds UP there); no tilted pose is involved.

The tests now start the memory at the upright home, assert that the
path leans, and keep the strict equality for every rapid.

Fixes #3486
Refs #3300

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/motion/tests/multiaxis.rs       | 11 ++++++++---
 crates/motion/tests/multiaxis_avoid.rs |  5 ++++-
 crates/motion/tests/multiaxis_rough.rs |  8 ++++++--
 3 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/crates/motion/tests/multiaxis.rs b/crates/motion/tests/multiaxis.rs
index d0b3285d9..25c11fd8a 100644
--- a/crates/motion/tests/multiaxis.rs
+++ b/crates/motion/tests/multiaxis.rs
@@ -170,11 +170,16 @@ fn contour5d_balls_are_the_waterlines_balls() {
 #[test]
 fn rapids_hold_the_pose_they_inherit() {
     // The post keeps the tilt modal: a rapid travels under the pose
-    // it inherits (none before the first lean), never a new one - the
-    // ball lifts off its last contact along the axis it cut with.
+    // it inherits, never a new one - the ball lifts off its last
+    // contact along the axis it cut with. #3300: a path that leans
+    // inherits the upright home and states it before the first lean
+    // (the post commands it as zero angles); one that never leans
+    // states nothing.
     let facets = dome(15.0, 0.9, 8, 16);
     let got = contour5d(&facets, &finish(12.0, 9.8), &control(30.0, 0.0, None), None).unwrap();
-    let mut held: Option<[f64; 3]> = None;
+    let leans = got.moves.iter().any(|m| m.axis.is_some_and(|a| !camcraft_motion::cl::is_vertical(&a)));
+    assert!(leans, "the dome ladder must lean for this law to bite");
+    let mut held: Option<[f64; 3]> = Some([0.0, 0.0, 1.0]);
     for m in &got.moves {
         if m.kind == MoveKind::Rapid {
             assert_eq!(m.axis, held, "a rapid changed the pose it inherited: {m:?}");
diff --git a/crates/motion/tests/multiaxis_avoid.rs b/crates/motion/tests/multiaxis_avoid.rs
