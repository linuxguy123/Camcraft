From 3c6192f1e09dae51356805dfee134cddb7e46250 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 22 Nov 2026 13:03:12 +0100
Subject: [PATCH] fix(motion): the contour refusal for an Arc entry with no
 lead-in names the lead-in

A non-centre-cutting tool with the Arc entry and a None lead-in is refused
at the grazing dive. The old hint said "pick the Arc entry", which the user
had already set. The hint now says that the Arc entry does not run when the
lead-in is None, and that the user can set a Linear or Arc lead-in or use a
centre-cutting tool. The refusal condition is unchanged.

Fixes #3247

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/app/tests/contour_none_lead.rs         | 48 +++++++++++++++++--
 crates/motion/src/machining2d/contour_step.rs | 27 +++++++++--
 2 files changed, 66 insertions(+), 9 deletions(-)

diff --git a/crates/app/tests/contour_none_lead.rs b/crates/app/tests/contour_none_lead.rs
index 7e566aac3..3ef5b0b68 100644
--- a/crates/app/tests/contour_none_lead.rs
+++ b/crates/app/tests/contour_none_lead.rs
@@ -5,7 +5,9 @@
 //! from a linear lead to None through the command history, the way the
 //! Lead in / Lead out page applies its draft, and generated on the
 //! user's own part (`testdata/models/Milling-test.step`). Linear and Arc
-//! leads, and the Arc entry with a lead, keep their shapes.
+//! leads, and the Arc entry with a lead, keep their shapes. #3247: a tool
+//! that is not centre-cutting is refused there, and the refusal names the
+//! lead-in, not the Arc entry that is already set.
 //!
 //! Gate map: covers app::commands (EditOperationParams,
 //! GenerateOperation) over camcraft_motion::machining2d::contour.
@@ -16,12 +18,13 @@ use camcraft_app::geometry::Point3;
 use camcraft_app::links::{Approach, Links};
 use camcraft_app::machining2d::{Lead, Side};
 use camcraft_app::machining3d::Entry3D;
-use camcraft_app::operation::{Height, HeightReference, OpParams, SrcRef};
-use camcraft_app::schema::Location;
+use camcraft_app::operation::{self, Height, HeightReference, OpParams, SrcRef};
+use camcraft_app::schema::{Location, Operation};
 use camcraft_app::stock::StockShape;
-use camcraft_app::tools::catalog;
+use camcraft_app::tools::{catalog, Tool};
 use camcraft_app::world::new_world;
 use camcraft_app::{model, posting};
+use camcraft_motion::approach::CENTER_CUT_REFUSAL;
 use flecs_ecs::prelude::World;
 
 const TOOL: &str = "EM-1000-4FL";
@@ -164,3 +167,40 @@ fn arc_entry_with_a_linear_lead_still_descends_on_its_arc() {
     assert!(from.z > to.z, "the wall arc descends while it travels: {from:?} -> {to:?}");
     assert!(!t.notes.iter().any(|n| n.contains("arc stands down")), "{:?}", t.notes);
 }
+
+/// #3247: the part and stock of `job`, with a tool that is not
+/// centre-cutting, generated straight through `operation::generate`.
+fn refusal_for(lead: Lead) -> String {
+    let world = new_world();
+    let mut h = History::default();
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models/Milling-test.step");
+    let imp = ImportModel::new(&path).expect("the user's STEP imports");
+    let name = imp.name.clone();
+    h.execute(&world, imp);
+    let loc = Location { pos: Point3::new(0.0, 0.0, -7.0), ..Default::default() };
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 70.0, dy: 70.0, dz: 27.0 }, loc).expect("stock"));
+    let em = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("catalog");
+    h.execute(&world, AddTool::new(&world, "NC", Tool { center_cutting: false, ..em }).expect("tool"));
+    let params = contour(lead, Some(Lead::None), Entry3D::Arc);
+    let op = Operation {
+        tool: "NC".into(),
+        src: SrcRef::Entity(name),
+        params,
+        stamp: None,
+        setup: None,
+        area: Default::default(),
+        coolant: Default::default(),
+        after: Default::default(),
+        suppressed: false,
+    };
+    operation::generate(&world, &op, "Op1").map(|_| String::new()).unwrap_or_else(|e| e.to_string())
+}
+
+#[test]
+fn arc_entry_with_no_lead_in_refuses_a_non_centre_cutting_tool_and_names_the_lead_in() {
+    let msg = refusal_for(Lead::None);
+    assert!(msg.contains(CENTER_CUT_REFUSAL), "the refusal stands: {msg}");
+    assert!(msg.contains("the Arc entry does not run when the lead-in is None"), "{msg}");
+    assert!(msg.contains("set a Linear or Arc lead-in, or use a centre-cutting tool"), "{msg}");
+    assert!(!msg.contains("pick the Arc entry"), "the Arc entry is already set: {msg}");
+}
diff --git a/crates/motion/src/machining2d/contour_step.rs b/crates/motion/src/machining2d/contour_step.rs
index dd4b13b38..08a877cbb 100644
--- a/crates/motion/src/machining2d/contour_step.rs
+++ b/crates/motion/src/machining2d/contour_step.rs
@@ -20,6 +20,7 @@ use crate::approach::CENTER_CUT_REFUSAL;
 
 use super::contour_bore::{BoreStep, bore_entry};
 use super::contour_entry::Engage;
+use super::contour_params::Lead;
 use super::descent::feed_down;
 
 /// What one level's engagement reads beyond the shared [`Engage`].
@@ -98,7 +99,7 @@ pub(super) fn engage_level(b: &mut PathBuilder, eng: &Engage, s: &Step, lead: &[
         }
         let cur = b.at();
         b.push(MoveKind::Rapid, Point3::new(e2.x, e2.y, cur.z), None);
-        graze(b, eng, e2, s.lead_top);
+        graze(b, eng, e2, s.lead_top, s.arm);
         None
     } else if s.inside {
         // The bore side: the eroded region states the bounded air
@@ -126,7 +127,7 @@ pub(super) fn engage_level(b: &mut PathBuilder, eng: &Engage, s: &Step, lead: &[
         }
         let cur = b.at();
         b.push(MoveKind::Rapid, Point3::new(e2.x, e2.y, cur.z), None);
-        graze(b, eng, e2, s.lead_top);
+        graze(b, eng, e2, s.lead_top, s.arm);
         None
     }
 }
@@ -137,14 +138,30 @@ pub(super) fn engage_level(b: &mut PathBuilder, eng: &Engage, s: &Step, lead: &[
 /// A tool that is not centre-cutting may not plunge here (the stock
 /// beside the wall is not proved cleared): the operation is refused by
 /// name.
-fn graze(b: &mut PathBuilder, eng: &Engage, e2: Point2, z: f64) {
+fn graze(b: &mut PathBuilder, eng: &Engage, e2: Point2, z: f64, arm: Entry3D) {
     let p = eng.p;
     let a = &p.links.approach;
     if !a.center_cutting {
         b.note_once(&format!(
-            "{CENTER_CUT_REFUSAL} - the dive at the lead-in ({:.3}, {:.3}) is into material no helix or ramp can be proved beside; pick the Arc entry or a centre-cutting tool",
-            e2.x, e2.y
+            "{CENTER_CUT_REFUSAL} - the dive at the lead-in ({:.3}, {:.3}) is into material no helix or ramp can be proved beside; {}",
+            e2.x,
+            e2.y,
+            graze_hint(arm, p.lead == Lead::None)
         ));
     }
     feed_down(b, e2, z, p.entry_top(), eng.m, a.plunge(p.plunge_feed));
 }
+
+/// What the user can change to lift the refusal. The Arc entry is already
+/// chosen when it reaches this dive, so it never says "pick the Arc entry"
+/// (#3247): with no lead-in the arc stands down, so the lead-in is the
+/// thing to set.
+fn graze_hint(arm: Entry3D, no_lead_in: bool) -> &'static str {
+    match (arm, no_lead_in) {
+        (Entry3D::Arc, true) => {
+            "the Arc entry does not run when the lead-in is None; set a Linear or Arc lead-in, or use a centre-cutting tool"
+        }
+        (Entry3D::Arc, false) => "the Arc entry found no room here (see the entry note); use a centre-cutting tool",
+        _ => "pick the Arc entry or a centre-cutting tool",
+    }
+}
