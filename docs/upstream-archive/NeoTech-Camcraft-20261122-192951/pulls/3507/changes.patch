+#[test]
+fn a_part_top_does_not_clear_a_lateral_feed() {
+    let lateral = Move::new(MoveKind::Feed, Point3::new(0.0, 0.0, 10.0), Point3::new(0.2, 0.0, 10.0), Some(80.0));
+    let warnings = judge_with_part_top(lateral, 12.0);
