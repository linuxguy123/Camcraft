+#[test]
+fn individual_heads_compile_and_leave_no_trial_worktree() {
+    let r = Repo::new();
+    let before = r.git(&["status", "--porcelain"]);
+    let head = r.git(&["rev-parse", "HEAD"]);
+    for pr in ["1", "2"] {
