+        fs::write(p, text).unwrap();
+    }
+    fn git(&self, args: &[&str]) -> String {
+        let o = Command::new("git").current_dir(&self.0).args(args).output().unwrap();
+        assert!(o.status.success(), "git {args:?}: {}", String::from_utf8_lossy(&o.stderr));
