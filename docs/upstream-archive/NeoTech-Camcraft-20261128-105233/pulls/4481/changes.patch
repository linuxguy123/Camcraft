diff --git a/crates/ui/src/egui_app/tests/tool_library_convert.rs b/crates/ui/src/egui_app/tests/tool_library_convert.rs
new file mode 100644
index 000000000..ac4458cc7
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/tool_library_convert.rs
@@ -0,0 +1,103 @@
+//! #4339: the "Convert to components" preview of the tool library window.
+//! Three standalone tools: a 6 mm end mill on a BT30 ER20 holder (its
+//! stack gives the same tool), one with the old default stick-out (its
+//! stack needs a longer shank: different) and an 8 mm one with no holder
+//! (no match). Pinned: the header button opens the preview with one row
+//! for each tool and its result; only the "same" row starts ticked and the
+//! "no match" row cannot be ticked; "Convert selected" is one undo step
+//! that gives the ticked tool its stack; the preview follows the document;
+//! "Select every row that converts" ticks the different row; undo takes
+//! each stack away; Close goes back to the tool list.
+//! Gate map: covers ui::egui_app::tool_library_dialog, ui::state.
+//! Provenance: our own structural tests over the AccessKit tree and the
+//! command history; no HSMWorks material involved.
+
+use camcraft_app::commands::{AddTool, SetToolBody};
+use camcraft_app::tool_assembly as ta;
+use egui::accesskit::Role;
+use egui_kittest::kittest::NodeT;
+
+use super::tool_library_components::{done, lib_dir, shell, shows, undo};
+use super::tool_library_editor::{H, click_window_button, library_window};
+use super::*;
+use crate::egui_app::tool_library_dialog::{convert, list_header};
+
+const SIX: &str = "Six";
+const BARE: &str = "Bare";
+const LEGACY: &str = "Legacy";
+
+fn cat(name: &str) -> camcraft_app::tools::Tool {
+    let Some((_, t)) = camcraft_app::tools::catalog().into_iter().find(|(n, _)| *n == name) else {
+        panic!("the catalog has {name}");
+    };
+    t
+}
+
+fn shop(h: &mut H) {
+    let st = &mut h.state_mut().state;
+    for (name, c) in [(SIX, "EM-0600-4FL"), (LEGACY, "EM-0600-4FL"), (BARE, "EM-0800-4FL")] {
+        let add = AddTool::new(&st.world, name, cat(c)).expect("tool");
+        st.history.execute(&st.world, add);
+    }
+    // 10 mm of shank in the holder: the stack gives the same tool.
+    let six = cat("EM-0600-4FL");
+    let held = Some(six.flute_len + six.shank_len - 10.0);
+    let holder = SetToolBody::library(&st.world, SIX, "BT30 ER20", None, held).expect("holder");
+    st.history.execute(&st.world, holder);
+    let old = SetToolBody::library(&st.world, LEGACY, "BT30 ER20", None, None).expect("default holder");
+    st.history.execute(&st.world, old);
+    st.doc_version += 1;
+    h.run_steps(2);
+}
+
+fn has_stack(h: &H, name: &str) -> bool {
+    let st = &h.state().state;
+    model::find_by_name(&st.world, name).and_then(|e| ta::assembly_of(&st.world, &e)).is_some()
+}
+
+fn picked(h: &H) -> Vec<String> {
+    h.state().state.tool_library.as_ref().and_then(|v| v.convert.as_ref()).map(|c| c.selection()).unwrap_or_default()
+}
+
+fn tick_disabled(h: &H, tool: &str) -> bool {
+    library_window(h).get_by_label(&convert::tick_label(tool)).accesskit_node().is_disabled()
+}
+
+#[test]
+fn the_preview_converts_the_ticked_rows_in_one_undo_step() {
+    let dir = lib_dir("convert");
+    let mut h = shell(&dir);
+    shop(&mut h);
+    h.get_by_role_and_label(Role::Button, "Tools").click();
+    h.run_steps(2);
+    assert!(shows(&h, list_header::NEW), "the tool list first");
+    click_window_button(&mut h, convert::OPEN);
+    assert!(shows(&h, convert::HEADING), "the preview stands in for the list");
+    assert!(shows(&h, "BT30 ER20 > ER20 collet 6 mm > Six"), "the proposed stack of Six");
+    assert!(shows(&h, "same"), "Six derives the same tool");
+    assert!(shows(&h, "no match: no holder: the tool names no library holder"), "Bare names its reason");
+    let six = cat("EM-0600-4FL");
+    let diff = format!("different: shank length {:.3} -> {:.3} mm", six.shank_len, six.shank_len + six.shank_d);
+    assert!(shows(&h, &diff), "Legacy names its difference: {diff}");
+    assert!(!tick_disabled(&h, SIX) && !tick_disabled(&h, LEGACY) && tick_disabled(&h, BARE), "a no-match row cannot be ticked");
+    assert_eq!(picked(&h), vec![SIX.to_owned()], "only the same row starts ticked");
+
+    let before = done(&h);
+    click_window_button(&mut h, convert::APPLY);
+    assert_eq!(done(&h), before + 1, "Convert selected is one undo step");
+    assert!(has_stack(&h, SIX) && !has_stack(&h, LEGACY) && !has_stack(&h, BARE), "only the ticked row converts");
+    assert!(!shows(&h, "same"), "the preview follows the document: Six is no longer standalone");
+    let apply = library_window(&h).get_by_role_and_label(Role::Button, convert::APPLY).accesskit_node().is_disabled();
+    assert!(apply, "nothing is ticked");
+    click_window_button(&mut h, convert::EVERY);
+    assert_eq!(picked(&h), vec![LEGACY.to_owned()], "every row that converts");
+    click_window_button(&mut h, convert::APPLY);
+    assert!(has_stack(&h, LEGACY), "the ticked different row converts");
+    assert_eq!(done(&h), before + 2);
+
+    undo(&mut h);
+    undo(&mut h);
+    assert!(!has_stack(&h, SIX) && !has_stack(&h, LEGACY), "undo takes each stack away");
+    click_window_button(&mut h, convert::CLOSE);
+    assert!(!shows(&h, convert::HEADING) && shows(&h, list_header::NEW), "Close goes back to the tool list");
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/convert.rs b/crates/ui/src/egui_app/tool_library_dialog/convert.rs
new file mode 100644
index 000000000..62740283c
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/convert.rs
@@ -0,0 +1,130 @@
+//! #4339: the "Convert to components" preview of the tool library window.
+//! It stands in for the tool list while it is open. One row for each
+//! standalone document tool: a tick, the tool, the proposed stack (holder,
+//! collet, the tool as its cutting item) and the result - "same" (the
+//! stack derives the same tool record and gauge length), "different" with
+//! each difference, or "no match" with the reason. The "same" rows start
+//! ticked; a "different" row converts only when the user ticks it; a "no
+//! match" row cannot be ticked. "Convert selected" queues the ticked rows
+//! as one undoable `ConvertToComponents`. The rows are the window's own
+//! view state (`ConvertView`), computed on open and on Refresh only.
+//! Provenance: our own page over our own command; no HSMWorks material
+//! involved.
+
+use egui::{RichText, Ui};
+
+use camcraft_app::tool_convert::Verdict;
+
+use crate::state::{ComponentAction, State};
+
+/// The list header's button that opens the preview, and the page heading.
+pub(crate) const OPEN: &str = "Convert to components…";
+pub(crate) const HEADING: &str = "Convert to components";
+/// The page's buttons.
+pub(crate) const APPLY: &str = "Convert selected";
+pub(crate) const SAME: &str = "Select the same rows";
+pub(crate) const EVERY: &str = "Select every row that converts";
+pub(crate) const REFRESH: &str = "Refresh";
+pub(crate) const CLOSE: &str = "Close preview";
+/// The tick of row `tool` (its AccessKit name).
+#[must_use]
+pub(crate) fn tick_label(tool: &str) -> String {
+    format!("Convert {tool}")
+}
+const HEADS: [&str; 4] = ["", "Tool", "Proposed stack", "Result"];
+
+/// What the page asks for after it is drawn.
+enum Ask {
+    Convert(Vec<String>),
+    Same,
+    Every,
+    Refresh,
+    Close,
+}
+
+pub(super) fn draw(ui: &mut Ui, state: &mut State) {
+    let done = state.history.done_len();
+    let Some(view) = state.tool_library.as_mut().and_then(|v| v.convert.as_mut()) else {
+        return;
+    };
+    ui.strong(HEADING);
+    ui.weak("Each standalone tool of the document with the component stack that gives it. The ticked rows convert in one undo step; a tool record never changes without your tick.");
+    if let Some(e) = &view.error {
+        ui.weak(format!("No preview: {e}"));
+    }
+    if view.at != done {
+        ui.weak("The document changed after this preview: Refresh before you convert.");
+    }
+    let mut ask = None;
+    if view.rows.is_empty() && view.error.is_none() {
+        ui.weak("The document has no standalone tool: each tool has a component stack.");
+    } else {
+        egui::ScrollArea::vertical().max_height((ui.available_height() - 40.0).max(120.0)).show(ui, |ui| {
+            egui::Grid::new("tool_library_convert").striped(true).show(ui, |ui| {
+                for h in HEADS {
+                    ui.label(RichText::new(h).strong());
+                }
+                ui.end_row();
+                for (row, picked) in view.rows.iter().zip(view.picked.iter_mut()) {
+                    let can = !matches!(row.verdict, Verdict::NoMatch(_));
+                    let tick = ui.add_enabled(can, egui::Checkbox::without_text(picked));
+                    let name = tick_label(&row.tool);
+                    tick.widget_info(|| egui::WidgetInfo::selected(egui::WidgetType::Checkbox, can, *picked, &name));
+                    ui.label(&row.tool);
+                    ui.label(if row.names.is_empty() { "-".to_owned() } else { row.names.join(" > ") });
+                    ui.label(result_text(&row.verdict));
+                    ui.end_row();
+                }
+            });
+        });
+    }
+    let selection = view.selection();
+    ui.horizontal_wrapped(|ui| {
+        let fresh = view.at == done;
+        if ui
+            .add_enabled(fresh && !selection.is_empty(), egui::Button::new(APPLY))
+            .on_hover_text("give each ticked tool its component stack: one undo step")
+            .clicked()
+        {
+            ask = Some(Ask::Convert(selection.clone()));
+        }
+        if ui.button(SAME).on_hover_text("tick only the rows whose stack gives the same tool").clicked() {
+            ask = Some(Ask::Same);
+        }
+        if ui.button(EVERY).on_hover_text("tick the different rows too: read their differences first").clicked() {
+            ask = Some(Ask::Every);
+        }
+        if ui.button(REFRESH).on_hover_text("compute the preview again from the document").clicked() {
+            ask = Some(Ask::Refresh);
+        }
+        if ui.button(CLOSE).on_hover_text("back to the tool list; nothing changes").clicked() {
+            ask = Some(Ask::Close);
+        }
+    });
+    match ask {
+        Some(Ask::Convert(tools)) => state.queue_component(ComponentAction::Convert { tools }),
+        Some(Ask::Same) => {
+            for (row, picked) in view.rows.iter().zip(view.picked.iter_mut()) {
+                *picked = row.verdict == Verdict::Same;
+            }
+        }
+        Some(Ask::Every) => {
+            for (row, picked) in view.rows.iter().zip(view.picked.iter_mut()) {
+                *picked = !matches!(row.verdict, Verdict::NoMatch(_));
+            }
+        }
+        Some(Ask::Refresh) => state.open_convert(),
+        Some(Ask::Close) => state.close_convert(),
+        None => {}
+    }
+}
+
+/// The result column: the verdict and its differences or reason.
+#[must_use]
+pub(crate) fn result_text(v: &Verdict) -> String {
+    match v {
+        Verdict::Same => "same".to_owned(),
+        Verdict::Different(d) => format!("different: {}", d.join("; ")),
+        Verdict::NoMatch(why) => format!("no match: {why}"),
+    }
+}
