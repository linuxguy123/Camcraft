diff --git a/crates/app/src/project/pattern_dto.rs b/crates/app/src/project/pattern_dto.rs
new file mode 100644
index 000000000..9da9be436
--- /dev/null
+++ b/crates/app/src/project/pattern_dto.rs
@@ -0,0 +1,178 @@
+//! The file mirror of a pattern folder of the operation list (#3012).
+//! Provenance: our own project format.
+//!
+//! A folder is an entity row of kind `pattern` carrying this payload.
+//! No version rung: a document without folders writes no such row, so
+//! its bytes are unchanged, and a reader from before #3012 meets a kind
+//! word it does not know and refuses the file by name (serde's "unknown
+//! variant `pattern`") - never a silent load without the copies.
+
+use serde::{Deserialize, Serialize};
+
+use super::*;
+use crate::pattern_folder::{checked_kind, copy_count};
+use crate::schema::{PatternDef, PatternKind, PatternOrder};
+
+#[derive(Serialize, Deserialize, Clone, Copy, Debug, Default, PartialEq, Eq)]
+#[serde(rename_all = "kebab-case")]
+pub enum PatternOrderDto {
+    #[default]
+    ByTool,
+    ByPart,
+}
+
+/// The copies: `{"type": "linear", ...}` or `{"type": "grid", ...}`.
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+#[serde(tag = "type", rename_all = "lowercase")]
+pub enum PatternLayoutDto {
+    Linear { dir: [f64; 3], count: u32, spacing: f64 },
+    Grid { dir1: [f64; 3], count1: u32, spacing1: f64, dir2: [f64; 3], count2: u32, spacing2: f64 },
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+pub struct PatternDto {
+    pub layout: PatternLayoutDto,
+    #[serde(default, skip_serializing_if = "is_by_tool")]
+    pub order_mode: PatternOrderDto,
+    /// Member operation keys, in folder order.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub members: Vec<String>,
+    /// 1-based copy numbers left out of the program.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub disabled: Vec<u32>,
+    /// Position in the setup's list, the `OperationDto::order` law.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub order: Option<u32>,
+    /// The display name (`RenameOperation`); absent - the key.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub label: Option<String>,
+    /// The setup it stands in; absent - the first.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub setup: Option<String>,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub suppressed: bool,
+}
+
+fn is_by_tool(o: &PatternOrderDto) -> bool {
+    *o == PatternOrderDto::ByTool
+}
+
+fn to_kind(layout: &PatternLayoutDto) -> PatternKind {
+    match *layout {
+        PatternLayoutDto::Linear { dir, count, spacing } => PatternKind::Linear { dir, count, spacing },
+        PatternLayoutDto::Grid { dir1, count1, spacing1, dir2, count2, spacing2 } => {
+            PatternKind::Grid { dir1, count1, spacing1, dir2, count2, spacing2 }
+        }
+    }
+}
+
+/// The payload for a folder row, `None` on every other entity.
+pub(super) fn collect(world: &World, entity: &flecs_ecs::prelude::Entity) -> Option<PatternDto> {
+    crate::pattern_folder::pattern_of(world, entity).map(|p| PatternDto {
+        layout: match p.kind {
+            PatternKind::Linear { dir, count, spacing } => PatternLayoutDto::Linear { dir, count, spacing },
+            PatternKind::Grid { dir1, count1, spacing1, dir2, count2, spacing2 } => {
+                PatternLayoutDto::Grid { dir1, count1, spacing1, dir2, count2, spacing2 }
+            }
+        },
+        order_mode: match p.order_mode {
+            PatternOrder::ByTool => PatternOrderDto::ByTool,
+            PatternOrder::ByPart => PatternOrderDto::ByPart,
+        },
+        members: p.members,
+        disabled: p.disabled_instances,
+        order: model::operation_meta_of(world, entity).order,
+        label: model::operation_meta_of(world, entity).label,
+        setup: p.setup,
+        suppressed: p.suppressed,
+    })
+}
+
+/// The folder rows' structural law, run before any world write: the
+/// payload rides a `pattern` row and nothing else; the row is named,
+/// carries nothing but it, and its pattern passes the command's checks.
+pub(super) fn validate(dto: &EntityDto, kind: EntityKind) -> Result<(), ProjectError> {
+    let is_pattern = matches!(kind, EntityKind::Pattern);
+    if dto.pattern.is_some() != is_pattern {
+        return Err(corrupt(format!(
+            "'{}' {}",
+            dto.name,
+            if is_pattern { "is a pattern folder without its pattern" } else { "carries a pattern but is not a pattern folder" }
+        )));
+    }
+    let Some(p) = &dto.pattern else {
+        return Ok(());
+    };
+    if dto.name.is_empty() {
+        return Err(corrupt("a pattern folder must be named"));
+    }
+    if dto.facets.is_some() || dto.stock.is_some() || dto.tool.is_some() || dto.operation.is_some() || dto.setup.is_some() {
+        return Err(corrupt(format!("'{}' is a pattern folder, not a solid, tool, operation or setup", dto.name)));
+    }
+    let kind = checked_kind(&to_kind(&p.layout)).map_err(|why| corrupt(format!("pattern folder '{}': {why}", dto.name)))?;
+    let copies = copy_count(&kind);
+    if p.disabled.iter().any(|n| *n == 0 || *n > copies) || p.disabled.len() >= usize::try_from(copies).unwrap_or(usize::MAX) {
+        return Err(corrupt(format!("pattern folder '{}' turns off copies it does not have, or all of them", dto.name)));
+    }
+    for (i, m) in p.members.iter().enumerate() {
+        if m.is_empty() || p.members[..i].contains(m) {
+            return Err(corrupt(format!("pattern folder '{}' names an empty or repeated member", dto.name)));
+        }
+    }
+    if p.label.as_deref().is_some_and(|l| l.trim().is_empty() || l.len() > 120 || l.chars().any(char::is_control)) {
+        return Err(corrupt(format!("pattern folder '{}' has a display name that is not 1-120 printable characters", dto.name)));
+    }
+    if p.setup.as_deref().is_some_and(str::is_empty) {
+        return Err(corrupt(format!("pattern folder '{}' names an empty setup", dto.name)));
+    }
+    Ok(())
+}
+
+/// The membership law over the whole file, run before any world write:
+/// each member is an operation row of the file, and an operation is a
+/// member of one folder only. The commands refuse both
+/// (`checked_members`); a hand-edited file must not state them, because
+/// the post would then cut a copy that the list does not show.
+pub(super) fn validate_members(entities: &[EntityDto]) -> Result<(), ProjectError> {
+    let mut owner: std::collections::HashMap<&str, &str> = std::collections::HashMap::new();
+    for dto in entities {
+        let Some(p) = &dto.pattern else { continue };
+        for m in &p.members {
+            let is_op = entities.iter().any(|e| e.name == *m && matches!(e.kind, Some(EntityKind::Operation)));
+            if !is_op {
+                return Err(corrupt(format!("pattern folder '{}' names member '{m}', which is not an operation of this file", dto.name)));
+            }
+            if let Some(other) = owner.insert(m.as_str(), dto.name.as_str()) {
+                return Err(corrupt(format!(
+                    "operation '{m}' is a member of pattern folders '{other}' and '{}' - an operation belongs to one folder only",
+                    dto.name
+                )));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Land a folder row (validated already).
+pub(super) fn apply(world: &World, entity: &flecs_ecs::prelude::Entity, dto: Option<PatternDto>) -> Result<(), ProjectError> {
+    let p = dto.ok_or_else(|| corrupt("pattern folder entity without its pattern"))?;
+    let kind = checked_kind(&to_kind(&p.layout)).map_err(corrupt)?;
+    let mut disabled = p.disabled;
+    disabled.sort_unstable();
+    disabled.dedup();
+    entity.entity_view(world).set(PatternDef {
+        setup: p.setup,
+        suppressed: p.suppressed,
+        order_mode: match p.order_mode {
+            PatternOrderDto::ByTool => PatternOrder::ByTool,
+            PatternOrderDto::ByPart => PatternOrder::ByPart,
+        },
+        kind,
+        members: p.members,
+        disabled_instances: disabled,
+    });
+    if p.order.is_some() || p.label.is_some() {
+        entity.entity_view(world).set(OperationMeta { order: p.order, label: p.label, ..Default::default() });
+    }
+    Ok(())
+}
diff --git a/crates/app/src/project/source_faces_dto.rs b/crates/app/src/project/source_faces_dto.rs
new file mode 100644
index 000000000..9bb585b1e
--- /dev/null
+++ b/crates/app/src/project/source_faces_dto.rs
@@ -0,0 +1,139 @@
+//! The file mirror of a `.sc` model's source face record (#3915,
+//! `schema::SourceFaces`): SolidCraft's name for each record face, and the
+//! facet ranges each record face became.
+//!
+//! No version step (decision D4, the `solids` #917 precedent): an old
+//! reader drops the key and reads the model exactly as it does today; it
+//! loses only the follow by name at the next re-import. So the key never
+//! refuses a file: a record that does not read, or does not tile the
+//! facets it rides, is dropped at load with a logged note, never trusted.
+//! Provenance: our own DTO, the pattern of the other entity keys.
+
+use std::sync::Arc;
+
+use flecs_ecs::prelude::{Entity, World};
+use serde::{Deserialize, Deserializer, Serialize};
+
+use camcraft_geometry::source_faces::{FaceName, FacetRange, SourceFaces};
+
+use crate::model;
+
+/// The longest face name a file may hold, in bytes: the `.sc` reader's
+/// own bound (a longer name is damage, and the record is dropped).
+const NAME_MAX: usize = 1 << 14;
+
+/// One record face's SolidCraft name. `verified` absent is false: a lost
+/// flag can only stop a follow, never start one.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq)]
+pub struct FaceNameDto {
+    pub name: String,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub verified: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub former: Option<String>,
+}
+
+/// The record: the names in record order, and `[start, end, face]`
+/// triples - facets `start..end` came from record face `face`.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq)]
+pub struct SourceFacesDto {
+    pub names: Vec<FaceNameDto>,
+    pub ranges: Vec<[usize; 3]>,
+}
+
+impl SourceFacesDto {
+    #[must_use]
+    pub fn of(record: &SourceFaces) -> Self {
+        SourceFacesDto {
+            names: record
+                .names
+                .iter()
+                .map(|n| FaceNameDto {
+                    name: n.name.clone(),
+                    verified: n.verified,
+                    former: n.former.clone(),
+                })
+                .collect(),
+            ranges: record
+                .ranges
+                .iter()
+                .map(|r| [r.start, r.end, r.face as usize])
+                .collect(),
+        }
+    }
+
+    /// The record for a model of `len` facets, or `None` with a logged
+    /// note naming `owner`: a face index past `u32`, a name past
+    /// [`NAME_MAX`], or ranges that do not tile the facets.
+    #[must_use]
+    pub fn to_record(&self, len: usize, owner: &str) -> Option<SourceFaces> {
+        let dropped = |why: &str| {
+            tracing::warn!(
+                "project: model '{owner}' has a source face record that {why}; it is dropped, and its picks will not follow SolidCraft names"
+            );
+            None
+        };
+        let long = |s: &str| s.len() > NAME_MAX;
+        if self
+            .names
+            .iter()
+            .any(|n| long(&n.name) || n.former.as_deref().is_some_and(long))
+        {
+            return dropped("holds a name too long to be one");
+        }
+        let mut ranges = Vec::with_capacity(self.ranges.len());
+        for &[start, end, face] in &self.ranges {
+            let Ok(face) = u32::try_from(face) else {
+                return dropped("names a face past the list");
+            };
+            ranges.push(FacetRange { start, end, face });
+        }
+        let record = SourceFaces {
+            names: self
+                .names
+                .iter()
+                .map(|n| FaceName {
+                    name: n.name.clone(),
+                    verified: n.verified,
+                    former: n.former.clone(),
+                })
+                .collect(),
+            ranges,
+        };
+        if !record.tiles(len) {
+            return dropped(&format!("does not tile its {len} facets"));
+        }
+        Some(record)
+    }
+}
+
+/// Read the key without ever refusing the file: a value that is not a
+/// record is dropped with a logged note (the key carries no version step,
+/// so a file must open as it would without it).
+pub(super) fn lenient<'de, D: Deserializer<'de>>(d: D) -> Result<Option<SourceFacesDto>, D::Error> {
+    let value = serde_json::Value::deserialize(d)?;
+    match serde_json::from_value::<SourceFacesDto>(value) {
+        Ok(dto) => Ok(Some(dto)),
+        Err(e) => {
+            tracing::warn!("project: a source face record does not read ({e}); it is dropped");
+            Ok(None)
+        }
+    }
+}
+
+/// The saved form of `entity`'s record: only a record that tiles the
+/// facets it rides now.
+#[must_use]
+pub(super) fn collect(world: &World, entity: &Entity) -> Option<SourceFacesDto> {
+    let record = crate::source_faces::of(world, entity)?;
+    let len = model::facets_of(world, entity).map_or(0, |f| f.len());
+    record.tiles(len).then(|| SourceFacesDto::of(&record))
+}
+
+/// Land a loaded record on model `entity`, after its facets and its
+/// revision (the record is read only at the revision it lands with).
+pub(super) fn land(world: &World, entity: &Entity, dto: Option<&SourceFacesDto>, owner: &str) {
+    let len = model::facets_of(world, entity).map_or(0, |f| f.len());
+    let record = dto.and_then(|d| d.to_record(len, owner)).map(Arc::new);
+    crate::source_faces::set(world, entity, record.as_ref());
+}
