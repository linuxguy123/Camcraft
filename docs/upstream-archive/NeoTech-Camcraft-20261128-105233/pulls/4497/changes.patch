+    fn key_hints_do_not_read_multiline_values_as_keys() {
+        assert!(key_hints("[env]\nTEXT = '''\n[profile.fake]\ndebug = true\n'''\n").is_empty());
+        assert!(key_hints("[build] # ] a comment\nrustflags = []\n").contains(&"build.rustflags".into()));
