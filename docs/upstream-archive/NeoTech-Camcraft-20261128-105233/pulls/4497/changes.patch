index 000000000..e78bccbef
--- /dev/null
+++ b/crates/gcode/src/klartext/source.rs
@@ -0,0 +1,219 @@
+//! Klartext source splitting: physical lines into numbered blocks, `~` continuation lines, `;` comments, word tokens and literal numbers.
+//! Provenance: HEIDENHAIN iTNC 530 conversational user's manual 533 190-22 (block layout, `~` continuation, `;` comments) as summarized in docs/research/heidenhain/, and CamCraft's own Klartext post output (assets/posts/heidenhain-klartext.cps).
+
+use crate::types::GcodeError;
+
+/// One logical Klartext block: a numbered line plus its `~` continuation lines.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Block {
+    /// 1-based physical line where the block starts.
+    pub line: usize,
+    /// The block number written at the start of the line, if any.
+    pub number: Option<u64>,
+    /// Upper-case word tokens without comments; a quoted token keeps its quotes and case.
+    pub words: Vec<String>,
+}
+
+impl Block {
+    /// "block N: " for a numbered block, empty otherwise. Refusals start with it.
+    pub fn tag(&self) -> String {
+        match self.number {
+            Some(n) => format!("block {n}: "),
+            None => String::new(),
+        }
+    }
+
+    pub fn unsupported(&self, code: &str, why: &str) -> GcodeError {
+        GcodeError::UnsupportedCode {
+            line: self.line,
+            code: code.to_string(),
+            reason: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn syntax(&self, why: &str) -> GcodeError {
+        GcodeError::Syntax {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn unknown(&self, word: &str) -> GcodeError {
+        GcodeError::UnknownWord {
+            line: self.line,
+            word: format!("{}{word}", self.tag()),
+        }
+    }
+
+    pub fn invalid_arc(&self, why: &str) -> GcodeError {
+        GcodeError::InvalidArc {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn invalid_cycle(&self, why: &str) -> GcodeError {
+        GcodeError::InvalidCycle {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+
+    pub fn invalid_modal(&self, why: &str) -> GcodeError {
+        GcodeError::InvalidModal {
+            line: self.line,
+            message: format!("{}{why}", self.tag()),
+        }
+    }
+}
+
+/// Split a Klartext program into logical blocks. Blank and comment-only lines
+/// give no block. Returns the blocks and the count of physical lines.
+pub fn split_blocks(program: &str) -> Result<(Vec<Block>, usize), GcodeError> {
+    let mut blocks = Vec::new();
+    let mut pending: Option<(usize, String)> = None;
+    let mut count = 0;
+    for (idx, raw) in program.lines().enumerate() {
+        let line = idx + 1;
+        count = line;
+        let mut text = raw.trim();
+        let cont = text.ends_with('~');
+        if cont {
+            text = text[..text.len() - 1].trim_end();
+        }
+        let code = strip_comment(text);
+        let (start, mut buf) = pending.take().unwrap_or((line, String::new()));
+        buf.push(' ');
+        buf.push_str(code);
+        if cont {
+            pending = Some((start, buf));
+            continue;
+        }
+        if let Some(b) = make_block(start, &buf)? {
+            blocks.push(b);
+        }
+    }
+    if let Some((start, _)) = pending {
+        return Err(GcodeError::Syntax {
+            line: start,
+            message:
+                "the block ends with '~' but no continuation line follows (truncated program?)"
+                    .to_string(),
+        });
+    }
+    Ok((blocks, count))
+}
+
+/// The text before the first `;` that is not inside double quotes.
+fn strip_comment(text: &str) -> &str {
+    let mut quoted = false;
+    for (i, c) in text.char_indices() {
+        match c {
+            '"' => quoted = !quoted,
+            ';' if !quoted => return &text[..i],
+            _ => {}
+        }
+    }
+    text
+}
+
+fn make_block(line: usize, text: &str) -> Result<Option<Block>, GcodeError> {
+    let mut words = tokenize(line, text)?;
+    let mut number = None;
+    if let Some(first) = words.first()
+        && !first.is_empty()
+        && first.bytes().all(|b| b.is_ascii_digit())
+    {
+        let n = first.parse::<u64>().map_err(|_| GcodeError::Syntax {
+            line,
+            message: format!("block number '{first}' is too large"),
+        })?;
+        number = Some(n);
+        words.remove(0);
+    }
+    // A structure block (`* - text`) is a comment.
+    if words.is_empty() || words[0].starts_with('*') {
+        return Ok(None);
+    }
+    Ok(Some(Block {
+        line,
+        number,
+        words,
+    }))
+}
+
+/// Split on white space; a double-quoted run is one token (quotes and case kept).
+fn tokenize(line: usize, text: &str) -> Result<Vec<String>, GcodeError> {
+    let mut out = Vec::new();
+    let mut cur = String::new();
+    let mut quoted = false;
+    for c in text.chars() {
+        if quoted {
+            cur.push(c);
+            if c == '"' {
+                quoted = false;
+            }
+        } else if c == '"' {
+            cur.push(c);
+            quoted = true;
+        } else if c.is_whitespace() {
+            if !cur.is_empty() {
+                out.push(std::mem::take(&mut cur));
+            }
+        } else {
+            cur.extend(c.to_uppercase());
+        }
+    }
+    if quoted {
+        return Err(GcodeError::Syntax {
+            line,
+            message: "unterminated '\"' in the block".to_string(),
+        });
+    }
+    if !cur.is_empty() {
+        out.push(cur);
+    }
+    Ok(out)
+}
+
+/// A literal Klartext number: an optional sign, digits and one optional decimal
+/// point (`+10`, `-2.5`, `.5`). No exponent, no `inf`/`nan`; the value is finite.
+pub fn literal(tok: &str) -> Option<f64> {
+    let body = tok.strip_prefix(['+', '-']).unwrap_or(tok);
+    let mut digits = 0usize;
+    let mut points = 0usize;
+    for b in body.bytes() {
+        match b {
+            b'0'..=b'9' => digits += 1,
+            b'.' => points += 1,
+            _ => return None,
+        }
+    }
+    if digits == 0 || points > 1 {
+        return None;
+    }
+    tok.parse::<f64>().ok().filter(|v| v.is_finite())
+}
+
+/// A Q parameter reference `Q5`, `+Q5` or `-Q5`: the index and the sign.
+pub fn q_ref(tok: &str) -> Option<(u32, f64)> {
+    let (sign, body) = match tok.as_bytes().first() {
+        Some(b'-') => (-1.0, &tok[1..]),
+        Some(b'+') => (1.0, &tok[1..]),
+        _ => (1.0, tok),
+    };
+    let idx = q_index(body)?;
+    Some((idx, sign))
+}
+
+/// Highest Q parameter index of the iTNC 530 (Q0 to Q1999).
+pub const MAX_Q: u32 = 1999;
+
+/// The index of a `Q<n>` token, with `n` in 0..=[`MAX_Q`].
+pub fn q_index(tok: &str) -> Option<u32> {
+    let digits = tok.strip_prefix('Q')?;
+    if digits.is_empty() || digits.len() > 4 || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse::<u32>().ok().filter(|n| *n <= MAX_Q)
+}
diff --git a/crates/gcode/src/klartext/words.rs b/crates/gcode/src/klartext/words.rs
new file mode 100644
index 000000000..b5c55ad4e
--- /dev/null
+++ b/crates/gcode/src/klartext/words.rs
@@ -0,0 +1,195 @@
+//! Word decoding for Klartext path blocks (`L`, `CC`, `C`, `CR`, `CT`): coordinates, radius compensation, feed, direction, radius and M functions.
+//! Provenance: HEIDENHAIN iTNC 530 conversational user's manual 533 190-22 (path function words), as summarized in docs/research/heidenhain/differences.md, and the blocks of assets/posts/heidenhain-klartext.cps.
+
+use std::collections::HashMap;
+
+use super::source::{Block, literal, q_ref};
+use crate::types::GcodeError;
+
+/// The feed word of a path block.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Feed {
+    /// `FMAX`: rapid traverse for this block only.
+    Max,
+    /// `F<n>`: feed rate in mm/min, modal.
+    Rate(f64),
+}
+
+/// The `MB` word of `M140`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Mb {
+    /// `MB MAX`: retract to the end of the traverse range.
+    Max,
+    /// `MB <n>`: retract by `n` mm in the tool axis.
+    Dist(f64),
+}
+
+/// Decoded words of one path block.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Words {
+    /// Absolute `X`/`Y`/`Z`.
+    pub abs: [Option<f64>; 3],
+    /// Incremental `IX`/`IY`/`IZ`.
+    pub inc: [Option<f64>; 3],
+    /// `R0` was written.
+    pub r0: bool,
+    pub feed: Option<Feed>,
+    /// `DR+` (true, counter-clockwise) or `DR-` (false, clockwise).
+    pub ccw: Option<bool>,
+    /// `R+n` / `R-n` of a `CR` block.
+    pub radius: Option<f64>,
+    pub m: Vec<u32>,
+    pub mb: Option<Mb>,
+}
+
+impl Words {
+    pub fn has_coords(&self) -> bool {
+        self.abs.iter().chain(self.inc.iter()).any(Option::is_some)
+    }
+}
+
+/// Q parameter values set by `FN 0:` or `Qn =` blocks.
+pub type QTable = HashMap<u32, f64>;
+
+/// A numeric value: a literal, or a Q parameter that a literal assignment set.
+pub fn value(b: &Block, what: &str, tok: &str, q: &QTable) -> Result<f64, GcodeError> {
+    if let Some(v) = literal(tok) {
+        return Ok(v);
+    }
+    if let Some((idx, sign)) = q_ref(tok) {
+        return q.get(&idx).map(|v| sign * v).ok_or_else(|| {
+            b.syntax(&format!(
+                "{what} uses Q{idx}, but no block before sets Q{idx}"
+            ))
+        });
+    }
+    Err(b.syntax(&format!("{what} value '{tok}' is not a number")))
+}
+
+const AXES: [&str; 3] = ["X", "Y", "Z"];
+
+/// Decode the words after the block keyword.
+pub fn decode(b: &Block, toks: &[String], q: &QTable) -> Result<Words, GcodeError> {
+    let mut w = Words::default();
+    let mut i = 0;
+    while i < toks.len() {
+        let t = toks[i].as_str();
+        i += 1;
+        if t == "MB" {
+            let Some(arg) = toks.get(i) else {
+                return Err(b.syntax("MB needs MAX or a distance"));
+            };
+            i += 1;
+            set_mb(b, &mut w, arg, q)?;
+            continue;
+        }
+        if let Some(arg) = t.strip_prefix("MB") {
+            set_mb(b, &mut w, arg, q)?;
+            continue;
+        }
+        decode_one(b, &mut w, t, q)?;
+    }
+    Ok(w)
+}
+
+fn set_mb(b: &Block, w: &mut Words, arg: &str, q: &QTable) -> Result<(), GcodeError> {
+    if w.mb.is_some() {
+        return Err(b.syntax("MB appears twice"));
+    }
+    w.mb = Some(if arg == "MAX" {
+        Mb::Max
+    } else {
+        Mb::Dist(value(b, "MB", arg, q)?)
+    });
+    Ok(())
+}
+
+fn decode_one(b: &Block, w: &mut Words, t: &str, q: &QTable) -> Result<(), GcodeError> {
+    match t {
+        "R0" => return once(b, &mut w.r0, t),
+        "RL" | "RR" => return Err(b.unsupported(
+            t,
+            "radius compensation RL/RR is not read; this reader needs the tool-centre path (R0)",
+        )),
+        "FMAX" => return set(b, &mut w.feed, Feed::Max, "F"),
+        "FAUTO" | "FU" | "FZ" | "FT" => {
+            return Err(b.unsupported(t, "only F in mm/min and FMAX are read"));
+        }
+        "DR+" => return set(b, &mut w.ccw, true, "DR"),
+        "DR-" => return set(b, &mut w.ccw, false, "DR"),
+        _ => {}
+    }
+    for (k, axis) in AXES.iter().enumerate() {
+        if let Some(rest) = t.strip_prefix('I').and_then(|r| r.strip_prefix(axis)) {
+            if w.abs[k].is_some() {
+                return Err(b.syntax(&format!("{axis} and I{axis} in one block")));
+            }
+            let v = value(b, &format!("I{axis}"), rest, q)?;
+            return set(b, &mut w.inc[k], v, &format!("I{axis}"));
+        }
+        if let Some(rest) = t.strip_prefix(axis) {
+            if w.inc[k].is_some() {
+                return Err(b.syntax(&format!("{axis} and I{axis} in one block")));
+            }
+            let v = value(b, axis, rest, q)?;
+            return set(b, &mut w.abs[k], v, axis);
+        }
+    }
+    if let Some(rest) = t.strip_prefix('M')
+        && !rest.is_empty()
+        && rest.len() <= 4
+        && rest.bytes().all(|c| c.is_ascii_digit())
+    {
+        let n: u32 = rest
+            .parse()
+            .map_err(|_| b.syntax(&format!("bad M word '{t}'")))?;
+        w.m.push(n);
+        return Ok(());
+    }
+    if let Some(rest) = t.strip_prefix('F') {
+        let f = value(b, "F", rest, q)?;
+        return set(b, &mut w.feed, Feed::Rate(f), "F");
+    }
+    if let Some(rest) = t.strip_prefix('R')
+        && (rest.starts_with(['+', '-']) || literal(rest).is_some() || q_ref(rest).is_some())
+    {
+        let r = value(b, "R", rest, q)?;
+        return set(b, &mut w.radius, r, "R");
+    }
+    if let Some(axis) = [
+        "A", "B", "C", "U", "V", "W", "IA", "IB", "IC", "IU", "IV", "IW",
+    ]
+    .iter()
+    .find(|a| {
+        t.strip_prefix(**a)
+            .is_some_and(|r| literal(r).is_some() || q_ref(r).is_some())
+    }) {
+        return Err(b.unsupported(
+            &format!("axis {axis}"),
+            "only the X, Y and Z axes are read (3-axis reader)",
+        ));
+    }
+    if ["PA", "PR", "IPA", "IPR", "PDX", "PDY"]
+        .iter()
+        .any(|p| t.starts_with(p))
+    {
+        return Err(b.unsupported(t, "polar coordinates are not read"));
+    }
+    Err(b.unknown(t))
+}
+
+fn once(b: &Block, flag: &mut bool, t: &str) -> Result<(), GcodeError> {
+    if *flag {
+        return Err(b.syntax(&format!("{t} appears twice")));
+    }
+    *flag = true;
+    Ok(())
+}
+
+fn set<T>(b: &Block, slot: &mut Option<T>, v: T, name: &str) -> Result<(), GcodeError> {
+    if slot.is_some() {
+        return Err(b.syntax(&format!("{name} appears twice")));
+    }
+    *slot = Some(v);
+    Ok(())
+}
