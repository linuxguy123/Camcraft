+    let got = from_mesh.clearance.unwrap_or_else(|| panic!("no clearance"));
+    let (a, b): (Vec<f64>, Vec<f64>) = (got.words().collect(), want.words().collect());
+    assert!(a.len() == b.len() && a.iter().zip(&b).all(|(x, y)| (x - y).abs() < 1e-9), "{a:?} vs {b:?}");
