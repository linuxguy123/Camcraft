index 000000000..67c22eaf0
--- /dev/null
+++ b/crates/kernel/tests/solidcraft_import/names.rs
@@ -0,0 +1,325 @@
+//! The face names of a Solidcraft design (#3915): from model cache format
+//! 10, SolidCraft's name of each face of the final body is read beside it,
+//! one for each record face, in record order. Names never refuse an import:
+//! names that do not fit are dropped with one note. The fixture is the
+//! sample design marked as format 10, with its final body replaced by a
+//! block made and encoded with the pinned solidcore crates (`solidcore-ops`,
+//! `native::encode`), and with names of our own: each face is named by the
+//! plane it lies on, so a pin can check that every triangle of a named face
+//! lies on that plane. Tiling alone does not prove that: a shifted name list
+//! covers every face too.
+//! Provenance: our own fixture, built by the test. The names layout is
+//! SolidCraft's published crates/doc/src/model_cache.rs (v0.50.0).
+
+use std::path::PathBuf;
+
+use camcraft_kernel::machining_mesh::{MachiningMesh, machining_mesh};
+use camcraft_kernel::solidcraft::{NAMES_FORMAT, SolidcraftImport, SourceName};
+use serde_json::{Value, json};
+use solidcore::kernel::{CancelToken, UpstreamFixes};
+use solidcore_record::brep::{Brep as Record, Loop, envelope};
+use solidcore_record::native::{self, Runtime, Saved};
+
+use super::{import, last_slice};
+use crate::sc_util::{Parts, sample_bytes};
+
+/// The sample's final model body. Its body table entry and its payload
+/// slice have the same index, and so does its names record.
+pub(super) const FINAL: usize = 13;
+/// The format the sample was written in: its names are not read.
+const FORMAT_8: &str = "solidcraft-model-cache/8";
+/// The chord the pins mesh at (mm).
+const CHORD: f64 = 0.005;
+/// How far a corner may lie off its named plane (mm).
+const ON_PLANE: f64 = 1e-6;
+
+/// The 10 x 20 x 30 block as a record: six faces, each on an axis plane.
+pub(super) fn block() -> Record {
+    solidcore_ops::session::set_thread_fixes(UpstreamFixes::NAMES.iter().copied())
+        .expect("every fix on, as Solidcraft runs");
+    let b = solidcore_ops::make_box([0.0; 3], [10.0, 20.0, 30.0]).expect("block");
+    let (record, _) = b.to_record().expect("record of the block");
+    record
+}
+
+/// The axis and the coordinate that every corner of record face `f`
+/// shares. Read from the face's loops, not from its surface kind.
+fn plane_of(r: &Record, f: usize) -> (usize, f64) {
+    let mut corners: Vec<[f64; 3]> = Vec::new();
+    for l in &r.faces[f].loops {
+        match l {
+            Loop::Edges { edges } => {
+                for e in edges {
+                    for v in r.edges[e.edge as usize].vertices {
+                        corners.push(r.vertices[v as usize].point);
+                    }
+                }
+            }
+            Loop::Vertex { vertex } => corners.push(r.vertices[*vertex as usize].point),
+        }
+    }
+    let first = corners[0];
+    match (0..3).find(|&a| corners.iter().all(|p| p[a] == first[a])) {
+        Some(a) => (a, first[a]),
+        None => panic!("face {f} of the block lies on no axis plane: {corners:?}"),
+    }
+}
+
+/// Our own name of each record face, in record order: its plane, `x=10`.
+pub(super) fn names_of(r: &Record) -> Vec<String> {
+    (0..r.faces.len())
+        .map(|f| {
+            let (a, c) = plane_of(r, f);
+            format!("{}={c}", ["x", "y", "z"][a])
+        })
+        .collect()
+}
+
+/// The plane a name of [`names_of`] gives.
+fn plane_named(name: &str) -> (usize, f64) {
+    let (axis, at) = name
+        .split_once('=')
+        .unwrap_or_else(|| panic!("'{name}' is not a plane"));
+    let a = ["x", "y", "z"].iter().position(|x| *x == axis);
+    match (a, at.parse::<f64>()) {
+        (Some(a), Ok(c)) => (a, c),
+        _ => panic!("'{name}' is not a plane"),
+    }
+}
+
+/// One info item as SolidCraft writes it: `[aliases, bounds, verified,
+/// synonyms]`, and the former name as a fifth item when there is one.
+pub(super) fn info(verified: bool, former: Option<&str>) -> Value {
+    match former {
+        Some(f) => json!([[], [], verified, [], f]),
+        None => json!([[], [], verified, []]),
+    }
+}
+
+/// A names record `{faces, info}`, with `info(i)` the item of face `i`.
+pub(super) fn names_record(names: &[String], info: impl Fn(usize) -> Value) -> Value {
+    json!({ "faces": names, "info": (0..names.len()).map(info).collect::<Vec<_>>() })
+}
+
+/// The sample with `record` as its final body and `change` made to its
+/// manifest, re-keyed.
+pub(super) fn design_with(record: Record, change: impl FnOnce(&mut Value)) -> Vec<u8> {
+    let saved = Saved {
+        solid: record,
+        metadata: envelope::Metadata {
+            version: envelope::VERSION,
+            color: None,
+            paint: None,
+            boundaries: None,
+            face_sources: None,
+            history: None,
+            preserve_boundaries: false,
+        },
+        runtime: Runtime {
+            size: 0.0,
+            coarse_missing: None,
+        },
+    };
+    let body = native::encode(&saved).expect("encode the block");
+    let mut p = Parts::sample();
+    let (at, _) = last_slice(&p);
+    let mut payload = p.get("cache/bodies.bin");
+    payload.truncate(at);
+    payload.extend_from_slice(&body);
+    p.set("cache/bodies.bin", payload);
+    p.manifest(|m| {
+        m["slices"][FINAL][1] = json!(body.len());
+        change(m);
+    });
+    p.rekey();
+    p.build()
+}
+
+/// The sample with `record` as its final body, its cache marked `format`
+/// and `names` as its final body's names record.
+fn design(record: Record, format: &str, names: Value) -> Vec<u8> {
+    design_with(record, |m| {
+        m["format"] = json!(format);
+        m["model"]["model_bodies"][FINAL]["names"] = json!(FINAL);
+        m["model"]["names"][FINAL] = names;
+    })
+}
+
+#[track_caller]
+fn ok(bytes: &[u8]) -> SolidcraftImport {
+    match import(bytes) {
+        Ok(i) => i,
+        Err(e) => panic!("the design is refused: {e}"),
+    }
+}
+
+/// Every triangle of `mesh` lies on the plane that its face's name gives,
+/// and every name has a triangle. `Err` names the first that does not.
+fn aligned(mesh: &MachiningMesh, names: &[String]) -> Result<(), String> {
+    let mut seen = vec![false; names.len()];
+    for (t, (tri, f)) in mesh.triangles.iter().zip(&mesh.tri_face).enumerate() {
+        let f = *f as usize;
+        let name = names
+            .get(f)
+            .ok_or_else(|| format!("triangle {t}: face {f} has no name"))?;
+        let (a, c) = plane_named(name);
+        for v in tri {
+            let p = mesh.positions[*v as usize];
+            if (p[a] - c).abs() > ON_PLANE {
+                return Err(format!(
+                    "triangle {t} of face {f} ('{name}') has a corner at {p:?}"
+                ));
+            }
+        }
+        seen[f] = true;
+    }
+    match seen.iter().position(|s| !s) {
+        Some(f) => Err(format!("face {f} ('{}') has no triangle", names[f])),
+        None => Ok(()),
+    }
+}
+
+#[test]
+fn format_10_names_are_read_one_for_each_record_face() {
+    let record = block();
+    let names = names_of(&record);
+    assert_eq!(names.len(), 6, "a block has six faces");
+    // Face 0: a Split Face piece with its former name (five items). Face 1:
+    // a name worked out from geometry. Face 2: a former of null, which
+    // SolidCraft's reader takes as none. The rest: four items, verified.
+    let items = |i: usize| match i {
+        0 => info(true, Some("F1:side:l1")),
+        1 => info(false, None),
+        2 => json!([[], ["F1:start"], true, ["F1:other"], null]),
+        _ => info(true, None),
+    };
+    let i = ok(&design(record, NAMES_FORMAT, names_record(&names, items)));
+    assert_eq!(i.names_note, None);
+    let got = i.names.expect("format-10 names are read");
+    assert_eq!(got.len(), i.solid.record.faces.len());
+    let want: Vec<SourceName> = names
+        .iter()
+        .enumerate()
+        .map(|(k, n)| SourceName {
+            name: n.clone(),
+            verified: k != 1,
+            former: (k == 0).then(|| "F1:side:l1".to_owned()),
+        })
+        .collect();
+    assert_eq!(got, want);
+}
+
+#[test]
+fn every_triangle_of_a_named_face_lies_on_that_faces_plane() {
+    let record = block();
+    let names = names_of(&record);
+    let bytes = design(
+        record,
+        NAMES_FORMAT,
+        names_record(&names, |_| info(true, None)),
+    );
+    let i = ok(&bytes);
+    let read: Vec<String> = match &i.names {
+        Some(n) => n.iter().map(|n| n.name.clone()).collect(),
+        None => panic!("no names: {:?}", i.names_note),
+    };
+    assert_eq!(read, names, "the names come back in record order");
+    let mesh = match machining_mesh(&i.solid, CHORD, &CancelToken::new()) {
+        Ok(m) => m,
+        Err(e) => panic!("the block does not mesh: {e}"),
+    };
+    assert_eq!(mesh.tri_face.len(), mesh.triangles.len());
+    if let Err(e) = aligned(&mesh, &read) {
+        panic!("{e}");
+    }
+    // The pin can fail: the same names one place on cover every face too.
+    let mut shifted = read.clone();
+    shifted.rotate_left(1);
+    assert!(
+        aligned(&mesh, &shifted).is_err(),
+        "a shifted name list must not pass"
+    );
+}
+
+#[test]
+fn a_format_8_cache_reads_no_names_and_says_nothing() {
+    // The sample as written (format 8) holds names for its final body.
+    let m = Parts::sample().json("cache/model.json");
+    assert_eq!(m["format"], json!(FORMAT_8));
+    let held = m["model"]["names"][FINAL]["faces"]
+        .as_array()
+        .map_or(0, Vec::len);
+    assert!(held > 0, "the sample holds names");
+    // They are not read, and nothing is said: it imports as before.
+    let i = ok(&sample_bytes());
+    assert!(i.names.is_none());
+    assert_eq!(i.names_note, None);
+    // Names that fit, in a cache marked format 8: still none, no note.
+    let record = block();
+    let names = names_of(&record);
+    let i = ok(&design(
+        record,
+        FORMAT_8,
+        names_record(&names, |_| info(true, None)),
+    ));
+    assert!(i.names.is_none());
+    assert_eq!(i.names_note, None);
+}
+
+/// SolidCraft 0.46.2's own format-10 file, which `hole_on_pocket_wall.rs`
+/// already reads. Keep it only if the maintainer allows real files as
+/// fixtures here (C13 question Q4); the block pins above do not need it.
+#[test]
+fn a_solidcraft_written_file_names_its_faces_in_record_order() {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("../../testdata/models/hole_on_pocket_wall.sc");
+    let bytes = std::fs::read(&path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    let i = ok(&bytes);
+    let names = match &i.names {
+        Some(n) => n,
+        None => panic!("no names: {:?}", i.names_note),
+    };
+    assert_eq!(names.len(), i.solid.record.faces.len());
+    assert_eq!(names.len(), 13);
+    let mesh = match machining_mesh(&i.solid, CHORD, &CancelToken::new()) {
+        Ok(m) => m,
+        Err(e) => panic!("the file does not mesh: {e}"),
+    };
+    let corners = |name: &str| -> Vec<[f64; 3]> {
+        let f = match names.iter().position(|n| n.name == name) {
+            Some(f) => f as u32,
+            None => panic!("no face named {name}"),
+        };
+        mesh.triangles
+            .iter()
+            .zip(&mesh.tri_face)
+            .filter(|(_, g)| **g == f)
+            .flat_map(|(t, _)| t.map(|v| mesh.positions[v as usize]))
+            .collect()
+    };
+    // The plate's two caps: each flat on one axis plane, the same axis, and
+    // at the two ends of the body on it.
+    let (top, start) = (corners("F2:top"), corners("F2:start"));
+    let flat = |c: &[[f64; 3]]| {
+        (0..3).find(|&a| !c.is_empty() && c.iter().all(|p| (p[a] - c[0][a]).abs() < ON_PLANE))
+    };
+    let a = match (flat(&top), flat(&start)) {
+        (Some(a), Some(b)) if a == b => a,
+        other => panic!("the caps are not flat on one axis: {other:?}"),
+    };
+    let lo = mesh
+        .positions
+        .iter()
+        .map(|p| p[a])
+        .fold(f64::INFINITY, f64::min);
+    let hi = mesh
+        .positions
+        .iter()
+        .map(|p| p[a])
+        .fold(f64::NEG_INFINITY, f64::max);
+    let (t, s) = (top[0][a], start[0][a]);
+    assert!(
+        (t.min(s) - lo).abs() < ON_PLANE && (t.max(s) - hi).abs() < ON_PLANE,
+        "caps at {t} and {s}, body from {lo} to {hi}"
+    );
+}
diff --git a/crates/kernel/tests/solidcraft_import/names_misfit.rs b/crates/kernel/tests/solidcraft_import/names_misfit.rs
new file mode 100644
index 000000000..9d28bc4c8
--- /dev/null
+++ b/crates/kernel/tests/solidcraft_import/names_misfit.rs
@@ -0,0 +1,133 @@
+//! Face names that do not fit the body (#3915): each misfit of a format-10
+//! names record gives no names and one note that says why, and the import
+//! goes on as before. Never a refusal. The fixture is the one of `names`:
+//! the sample marked as format 10, its final body a block of our own.
+//! Provenance: our own fixture, built by the test. The names layout is
+//! SolidCraft's published crates/doc/src/model_cache.rs (v0.50.0).
+
+use camcraft_kernel::solidcraft::{MAX_NAME_BYTES, NAMES_FORMAT};
+use serde_json::{Value, json};
+
+use super::import;
+use super::names::{FINAL, block, design_with, info, names_of, names_record};
+
+/// A manifest edit, named in the misfit cases.
+type Edit = Box<dyn Fn(&mut Value)>;
+
+/// The edit that puts `v` at place `at` of the list `list` of the final
+/// body's names record.
+fn put(list: &'static str, at: usize, v: Value) -> Edit {
+    Box::new(move |m: &mut Value| {
+        if let Some(slot) = m["model"]["names"][FINAL][list].get_mut(at) {
+            *slot = v.clone();
+        }
+    })
+}
+
+/// The edit that takes `key` out of the final body's entry of the model
+/// list `list` (`names` or `model_bodies`).
+fn take(list: &'static str, key: &'static str) -> Edit {
+    Box::new(move |m: &mut Value| {
+        if let Some(n) = m["model"][list][FINAL].as_object_mut() {
+            n.remove(key);
+        }
+    })
+}
+
+/// Any other edit, boxed.
+fn edit(f: impl Fn(&mut Value) + 'static) -> Edit {
+    Box::new(f)
+}
+
+/// The edit that drops the last item of the list `list` of the final
+/// body's names record.
+fn pop(list: &'static str) -> Edit {
+    Box::new(move |m: &mut Value| {
+        if let Some(l) = m["model"]["names"][FINAL][list].as_array_mut() {
+            l.pop();
+        }
+    })
+}
+
+#[test]
+fn names_that_do_not_fit_give_a_note_never_a_refusal() {
+    let record = block();
+    let names = names_of(&record);
+    let good = names_record(&names, |_| info(true, None));
+    let long = "n".repeat(MAX_NAME_BYTES + 1);
+    let index = |v: Value| edit(move |m| m["model"]["model_bodies"][FINAL]["names"] = v.clone());
+    let cases: Vec<(&str, Edit, &str)> = vec![
+        ("one name short", pop("faces"), "5 names and 6 info items"),
+        (
+            "one info item short",
+            pop("info"),
+            "6 names and 5 info items",
+        ),
+        ("a name not a text", put("faces", 2, json!(7)), "name 2"),
+        ("an empty name", put("faces", 2, json!("")), "name 2"),
+        ("a name too long", put("faces", 2, json!(long)), "name 2"),
+        (
+            "info of three items",
+            put("info", 3, json!([[], [], true])),
+            "info 3",
+        ),
+        (
+            "info of six items",
+            put("info", 3, json!([[], [], true, [], "a", "b"])),
+            "info 3",
+        ),
+        (
+            "verified not a flag",
+            put("info", 3, json!([[], [], "yes", []])),
+            "info 3",
+        ),
+        (
+            "aliases not a list",
+            put("info", 3, json!(["a", [], true, []])),
+            "info 3",
+        ),
+        (
+            "former not a text",
+            put("info", 3, json!([[], [], true, [], 5])),
+            "info 3",
+        ),
+        ("no face list", take("names", "faces"), "no face list"),
+        ("no info list", take("names", "info"), "no info list"),
+        (
+            "record not an object",
+            edit(|m| m["model"]["names"][FINAL] = json!([1, 2])),
+            "no face list",
+        ),
+        ("index past the list", index(json!(99)), "past the"),
+        ("index a text", index(json!("13")), "no names record"),
+        ("index negative", index(json!(-1)), "no names record"),
+        ("no index", take("model_bodies", "names"), "no names record"),
+        (
+            "no names list",
+            edit(|m| m["model"]["names"] = json!({})),
+            "no names list",
+        ),
+    ];
+    for (case, change, want) in cases {
+        let bytes = design_with(record.clone(), |m| {
+            m["format"] = json!(NAMES_FORMAT);
+            m["model"]["model_bodies"][FINAL]["names"] = json!(FINAL);
+            m["model"]["names"][FINAL] = good.clone();
+            change(m);
+        });
+        let i = match import(&bytes) {
+            Ok(i) => i,
+            Err(e) => panic!("{case}: names refused the import: {e}"),
+        };
+        assert!(i.names.is_none(), "{case}: names kept");
+        let note = i.names_note.unwrap_or_default();
+        assert!(
+            note.contains("face names were not read"),
+            "{case}: note '{note}'"
+        );
+        assert!(
+            note.contains(want),
+            "{case}: note '{note}' does not say '{want}'"
+        );
+    }
+}
diff --git a/crates/motion/src/laser/mod.rs b/crates/motion/src/laser/mod.rs
new file mode 100644
index 000000000..d32efa815
--- /dev/null
+++ b/crates/motion/src/laser/mod.rs
@@ -0,0 +1,116 @@
+//! Laser profile cutting (#4081): 2D through-cuts of closed and open
+//! contours with a laser beam - the kerf offset, inner contours before
+//! the contour that frees them, straight or arc leads with the pierce
+//! in the waste, tabs left as uncut gaps, and the tight-hole rule.
+//!
+//! Provenance (public sources, behaviour only, our own words and code):
+//! - General laser-cutting shop practice: the kerf is the burnt width
+//!   of the focused beam, the cut path stands kerf / 2 off the part on
+//!   the waste side, a pierce is made in the scrap and led in, holes
+//!   are cut before the outline that frees the part, and tabs
+//!   (micro-joints) hold a part in the sheet. The same rules as the
+//!   abrasive waterjet, so this cut rides that generator
+//!   ([`crate::waterjet`]) under its own voice.
+//! - RS-274 / ISO 6983 for G41/G42 and for linear-only controls.
+//!
+//! The power is a fraction of the source's maximum (the Grbl laser
+//! mode reads it as the S word against `$30`); this module only checks
+//! and states it. Nothing here guesses: each refusal names its value.
+
+use crate::cl::Toolpath;
+use crate::geo2d::{Loop, Point2, Region};
+use crate::machining2d::GenError;
+use crate::sheet::Voice;
+use crate::waterjet::{waterjet_profile, WaterjetParams};
+
+pub use crate::waterjet::{JetTabs, LeadShape, OpenSide};
+
+/// Everything the generator reads, resolved to plain numbers (mm,
+/// mm/min, seconds, percent).
+#[derive(Clone, Debug, PartialEq)]
+pub struct LaserParams {
+    /// The kerf width (the laser head tool's diameter, or the op's
+    /// override).
+    pub kerf: f64,
+    /// Post G41/G42 instead of the offset path the computer walked.
+    pub control_comp: bool,
+    /// Run outer contours counter-clockwise and holes clockwise.
+    pub reversed: bool,
+    pub lead_shape: LeadShape,
+    /// Lead-in / lead-out length, mm (0 = none).
+    pub lead_in: f64,
+    pub lead_out: f64,
+    /// The kerf side of every open run.
+    pub open_side: OpenSide,
+    pub tabs: Option<JetTabs>,
+    /// The beam power while it cuts, percent of the source's maximum:
+    /// more than 0, at most 100.
+    pub power: f64,
+    /// Seconds the beam dwells to pierce.
+    pub pierce_time: f64,
+    /// Send every arc as chords at this tolerance (mm); `None` keeps
+    /// the arcs.
+    pub linearize: Option<f64>,
+    pub feed: f64,
+    /// The beam-off travel plane, and the plane the cut rides (the
+    /// sheet top).
+    pub clearance_z: f64,
+    pub cut_z: f64,
+    /// How much coarser than the importer's promise the model is, mm
+    /// (#1053).
+    pub model_excess: f64,
+}
+
+impl LaserParams {
+    /// The waterjet generator's numbers under the laser's voice: no
+    /// abrasive, the same geometry laws.
+    #[must_use]
+    pub fn as_sheet(&self) -> WaterjetParams {
+        WaterjetParams {
+            kerf: self.kerf,
+            control_comp: self.control_comp,
+            reversed: self.reversed,
+            lead_shape: self.lead_shape,
+            lead_in: self.lead_in,
+            lead_out: self.lead_out,
+            open_side: self.open_side,
+            tabs: self.tabs.clone(),
+            pierce_time: self.pierce_time,
+            abrasive_delay: 0.0,
+            linearize: self.linearize,
+            feed: self.feed,
+            clearance_z: self.clearance_z,
+            cut_z: self.cut_z,
+            model_excess: self.model_excess,
+            voice: Voice::LASER,
+        }
+    }
+
+    /// The door: the power by name, then every number the shared
+    /// generator checks, in the laser's voice.
+    pub fn door(&self) -> Result<(), GenError> {
+        if !(self.power.is_finite() && self.power > 0.0 && self.power <= 100.0) {
+            return Err(Voice::LASER.invalid(format!(
+                "the power must be more than 0 and at most 100 % of the source's maximum (it is {})",
+                self.power
+            )));
+        }
+        self.as_sheet().door()
+    }
+}
+
+/// Cut `loops` (closed contours) and `chains` (open runs) with the
+/// beam. `part` is the material the kerf must never reach; an empty
+/// region skips that law (said in the notes).
+pub fn laser_profile(loops: &[Loop], chains: &[Vec<Point2>], part: &Region, p: &LaserParams) -> Result<Toolpath, GenError> {
+    p.door()?;
+    let mut path = waterjet_profile(loops, chains, part, &p.as_sheet())?;
+    path.notes.push(format!(
+        "laser: requested power {:.1} % of the source's maximum at {:.0} mm/min; no power record is posted yet",
+        p.power, p.feed
+    ));
+    Ok(path)
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/motion/src/laser/tests.rs b/crates/motion/src/laser/tests.rs
new file mode 100644
index 000000000..185fd95c2
--- /dev/null
+++ b/crates/motion/src/laser/tests.rs
@@ -0,0 +1,96 @@
+//! The laser profile (#4081): the shared sheet laws under the laser's
+//! voice - the same cut as the waterjet's for the same numbers, every
+//! note and refusal in the laser's words, and the power door.
+
+use super::*;
+use crate::cl::MoveKind;
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+    Loop::new(vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)]).unwrap()
+}
+
+/// A 100 x 60 plate with a 10 x 10 square hole.
+fn plate() -> (Vec<Loop>, Region) {
+    let loops = vec![rect(0.0, 0.0, 100.0, 60.0), rect(70.0, 25.0, 80.0, 35.0)];
+    let part = Region::new(loops.clone()).unwrap();
+    (loops, part)
+}
+
+fn params() -> LaserParams {
+    LaserParams {
+        kerf: 0.2,
+        control_comp: false,
+        reversed: false,
+        lead_shape: LeadShape::Arc,
+        lead_in: 2.0,
+        lead_out: 1.0,
+        open_side: OpenSide::Center,
+        tabs: None,
+        power: 80.0,
+        pierce_time: 0.3,
+        linearize: None,
+        feed: 1500.0,
+        clearance_z: 5.0,
+        cut_z: 0.0,
+        model_excess: 0.0,
+    }
+}
+
+#[test]
+fn the_laser_cuts_what_the_waterjet_cuts_and_speaks_as_the_laser() {
+    let (loops, part) = plate();
+    let p = params();
+    let path = laser_profile(&loops, &[], &part, &p).unwrap();
+    let jet = waterjet_profile(&loops, &[], &part, &WaterjetParams { voice: Voice::WATERJET, ..p.as_sheet() }).unwrap();
+    assert_eq!(path.moves, jet.moves, "the same sheet laws, the same moves");
+    let pierces = path.moves.iter().filter(|m| m.kind == MoveKind::Rapid && m.to.z == 0.0 && m.from.z > 0.0).count();
+    assert_eq!(pierces, 2, "one pierce for the hole, one for the outline");
+    assert!(path.notes.iter().all(|n| n.starts_with("laser: ")), "{:?}", path.notes);
+    assert!(!path.notes.iter().any(|n| n.contains("abrasive") || n.contains("jet ")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("2 contour(s) cut inner first (1 hole(s), 0 tab(s)), 2 pierce(s), kerf 0.200 mm")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("pierce time 0.30 s at each pierce; beam and dwell records")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.contains("requested power 80.0 %")), "{:?}", path.notes);
+}
+
+#[test]
+fn the_power_is_refused_by_name_outside_its_range() {
+    let (loops, part) = plate();
+    for bad in [0.0, -5.0, 100.5, f64::NAN] {
+        let p = LaserParams { power: bad, ..params() };
+        let err = laser_profile(&loops, &[], &part, &p).unwrap_err().to_string();
+        assert!(err.contains("laser profile: the power must be more than 0 and at most 100 %"), "{bad}: {err}");
+    }
+    let p = LaserParams { power: 100.0, ..params() };
+    assert!(laser_profile(&loops, &[], &part, &p).is_ok(), "full power is legal");
+}
+
+#[test]
+fn the_shared_refusals_speak_as_the_laser_profile() {
+    let (loops, part) = plate();
+    let cases: [(LaserParams, &str); 4] = [
+        (LaserParams { kerf: 0.0, ..params() }, "laser profile: the kerf width must be a positive number"),
+        (LaserParams { clearance_z: -1.0, ..params() }, "laser profile: the clearance plane"),
+        (
+            LaserParams { tabs: Some(JetTabs { count: 2, width: 1.0, at: vec![Point2::new(50.0, 0.0)] }), ..params() },
+            "laser profile: the tab count is 2 but 1 tab position(s)",
+        ),
+        (
+            LaserParams { tabs: Some(JetTabs { count: 1, width: 1.0, at: vec![Point2::new(500.0, 500.0)] }), ..params() },
+            "laser profile: tab 1",
+        ),
+    ];
+    for (p, want) in cases {
+        let err = laser_profile(&loops, &[], &part, &p).unwrap_err().to_string();
+        assert!(err.contains(want), "want {want:?}: {err}");
+    }
+    let err = laser_profile(&[], &[], &Region::default(), &params()).unwrap_err().to_string();
+    assert!(err.contains("laser profile: no contour to cut"), "{err}");
+}
+
+#[test]
+fn an_open_run_and_a_missing_silhouette_say_so_in_the_lasers_words() {
+    let chain = vec![Point2::new(0.0, 0.0), Point2::new(40.0, 0.0)];
+    let path = laser_profile(&[], &[chain], &Region::default(), &params()).unwrap();
+    assert!(path.notes.iter().any(|n| n.starts_with("laser: contour C0 is an open run, cut on its centre line")), "{:?}", path.notes);
+    assert!(path.notes.iter().any(|n| n.starts_with("laser: no part silhouette to judge")), "{:?}", path.notes);
+}
