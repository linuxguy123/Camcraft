+
+    #[test]
+    fn relative_cargo_home_is_resolved_for_each_command_directory() {
+        let base = std::env::temp_dir().join(format!("xtask-relative-home-{}", std::process::id()));
+        for dir in [&base, &base.join("crates/ui")] {
