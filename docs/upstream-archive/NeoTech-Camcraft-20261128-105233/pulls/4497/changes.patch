+
+/// The way back from an editor to its list.
+pub(crate) const BACK: &str = "‹ List";
+/// The footer's button on a list page.
+pub(crate) const CLOSE: &str = "Close";
+/// The header's close button (its AccessKit name; it shows "×").
+pub(crate) const CLOSE_WINDOW: &str = "Close the tool library";
+pub(crate) const DUPLICATE: &str = "Duplicate";
+pub(crate) const CANCEL: &str = "Cancel";
+pub(crate) const APPLY: &str = "Apply";
+/// The footer hints.
+pub(crate) const HINT_TOOLS: &str = "Click a row to edit the tool.";
+pub(crate) const HINT_CATALOG: &str = "Add puts a catalog tool into the document.";
+pub(crate) const HINT_LIBRARY: &str = "Click a document component to edit it.";
+pub(crate) const HINT_HOLDERS: &str = "Click a holder to see its facts and the tools that use it.";
+pub(crate) const HINT_HOLDER: &str = "Copy as user holder to make a holder that you can edit.";
+pub(crate) const HINT_APPLY: &str = "Apply is one undo step.";
+pub(crate) const HINT_COMPONENT: &str = "Apply component changes each tool built from it in one undo step.";
+pub(crate) const HINT_USER_HOLDER: &str = "Apply updates each tool that uses the holder. It is one undo step.";
+/// The `frame_cost` names of the header and the footer (crates/ui/AGENTS.md "Frame cost").
+pub(crate) const HEADER_SPAN: &str = "ui/tool_library.header";
+pub(crate) const FOOTER_SPAN: &str = "ui/tool_library.footer";
+/// Why Duplicate is not offered yet (#4340).
+pub(crate) const NO_DUPLICATE: &str =
+    "a copy must keep the holder and the component stack of the tool; until it can, add a tool with New tool…";
+
+/// What the window shows; the header and the footer follow it.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum Face {
+    /// A list page: the tools (from a source) or the holders.
+    List(LibraryPage, ToolSource),
+    /// A built-in holder's read-only view.
+    Holder(String),
+    /// The tool editor: the name, the kind and the tool number (0: none).
+    Tool { name: String, kind: ToolKind, number: u32 },
+    /// The component editor, by the draft's name.
+    Component(String),
+    /// #4338: a user holder in the holder form: the draft's name and the
+    /// count of the tools that use the holder.
+    UserHolder { name: String, users: usize },
+}
+
+impl Face {
+    /// An editor (or a holder view) is open: the header offers the way back.
+    pub(crate) fn has_back(&self) -> bool {
+        !matches!(self, Face::List(..))
+    }
+}
+
+/// What the user asked of the frame this frame.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Ask {
+    Page(LibraryPage),
+    Back,
+    Close,
+    Cancel,
+    Apply,
+    /// #4338: copy the open user holder as a new user holder.
+    Duplicate,
+}
+
+/// The face of the open window, or `None` when it is closed.
+#[must_use]
+pub(crate) fn face(state: &State) -> Option<Face> {
+    let v = state.tool_library.as_ref()?;
+    if let Some(d) = &v.component_edit {
+        // The count of users is the window's to fill (`body`).
+        return Some(if d.shape.is_some() { Face::UserHolder { name: d.name.clone(), users: 0 } } else { Face::Component(d.name.clone()) });
+    }
+    Some(match v.page {
+        LibraryPage::Tools => match &v.editor {
+            Some(e) => Face::Tool { name: e.draft.name.clone(), kind: e.draft.tool_kind(), number: e.draft.number },
+            None => Face::List(LibraryPage::Tools, v.source),
+        },
+        LibraryPage::Holders => match &v.holders.open {
+            Some(n) => Face::Holder(n.clone()),
+            None => Face::List(LibraryPage::Holders, v.source),
+        },
+    })
+}
+
+/// The header row: back, title, tabs, then the close button at the right.
+pub(crate) fn header(ui: &mut Ui, state: &State, face: &Face) -> Option<Ask> {
+    let _s = crate::frame_cost::span(HEADER_SPAN);
+    let page = state.tool_library.as_ref().map_or(LibraryPage::Tools, |v| v.page);
+    let mut ask = None;
+    ui.horizontal(|ui| {
+        if face.has_back() && ui.button(BACK).on_hover_text("back to the list; an unapplied draft is dropped").clicked() {
+            ask = Some(Ask::Back);
+        }
+        match face {
+            Face::List(..) => {
+                ui.label(title(ui, super::TITLE));
+            }
+            Face::Tool { name, kind, number } => {
+                ui.label(title(ui, name));
+                let t = if *number > 0 { format!("T{number}") } else { "T?".to_owned() };
+                ui.weak(format!("{} · {t}", super::super::browser_tree::kind_name(*kind)));
+            }
+            Face::Holder(name) => {
+                ui.label(title(ui, name));
+                ui.weak("holder");
+            }
+            Face::Component(name) => {
+                ui.label(title(ui, name));
+                ui.weak("component");
+            }
+            Face::UserHolder { name, users } => {
+                ui.label(title(ui, name));
+                ui.weak(format!("holder · used by {}", super::holder_view::count(*users)));
+            }
+        }
+        ui.add_space(12.0);
+        let mut picked = page;
+        ui.selectable_value(&mut picked, LibraryPage::Tools, super::TOOLS_PAGE)
+            .on_hover_text("the tools: the document's and the catalog's");
+        ui.selectable_value(&mut picked, LibraryPage::Holders, super::HOLDERS_PAGE)
+            .on_hover_text("the built-in holders by spindle taper, with the tools that use each one");
+        if picked != page {
+            ask = Some(Ask::Page(picked));
+        }
+        ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
+            let r = ui.add(Button::new("×").frame(false));
+            r.widget_info(|| WidgetInfo::labeled(WidgetType::Button, true, CLOSE_WINDOW));
+            if r.on_hover_text("close the tool library; an unapplied draft is dropped").clicked() {
+                ask = Some(Ask::Close);
+            }
+        });
+    });
+    ask
+}
+
+/// What the footer reads that the frame cannot: whether the component or
+/// holder draft differs, and why the holder draft cannot be applied.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Draft {
+    pub changed: bool,
+    pub holder_refusal: Option<String>,
+}
+
+/// The footer: the tool editor's refusal (if any), then the hint on the
+/// left and the face's buttons on the right.
+pub(crate) fn footer(ui: &mut Ui, state: &State, face: &Face, draft: &Draft) -> Option<Ask> {
+    let component_changed = draft.changed;
+    let _s = crate::frame_cost::span(FOOTER_SPAN);
+    if matches!(face, Face::Tool { .. })
+        && let Some(msg) = state.error_for(ErrorScope::Tool)
+    {
+        error_text::error_text(ui, colorvision::text_inks(ui, &state.world).error, msg);
+    }
+    let mut ask = None;
+    ui.horizontal(|ui| {
+        match face {
+            Face::UserHolder { users, .. } if *users > 0 => {
+                ui.weak(format!("Apply updates {}. It is one undo step.", super::holder_view::count(*users)));
+            }
+            _ => {
+                ui.weak(hint(face));
+            }
+        }
+        ui.with_layout(Layout::right_to_left(Align::Center), |ui| match face {
+            Face::List(..) | Face::Holder(_) => {
+                if ui.button(CLOSE).on_hover_text("close the tool library").clicked() {
+                    ask = Some(Ask::Close);
+                }
+            }
+            Face::Tool { .. } => {
+                let refusal = tool_refusal(state);
+                if primary(ui, APPLY, refusal.is_none())
+                    .on_hover_text("write this draft to the tool (one undo step)")
+                    .on_disabled_hover_text(refusal.as_deref().unwrap_or_default())
+                    .clicked()
+                {
+                    ask = Some(Ask::Apply);
+                }
+                if ui.button(CANCEL).on_hover_text("drop the unapplied draft and go back to the list").clicked() {
+                    ask = Some(Ask::Cancel);
+                }
+                let _ = ui.add_enabled(false, Button::new(DUPLICATE)).on_disabled_hover_text(NO_DUPLICATE);
+            }
+            Face::Component(_) => {
+                if primary(ui, super::component_edit::APPLY, component_changed)
+                    .on_hover_text("write this draft to the component and each tool built from it (one undo step)")
+                    .on_disabled_hover_text("the draft does not differ from the component")
+                    .clicked()
+                {
+                    ask = Some(Ask::Apply);
+                }
+                if ui.button(CANCEL).on_hover_text("drop the unapplied draft and go back to the list").clicked() {
+                    ask = Some(Ask::Cancel);
+                }
+            }
+            Face::UserHolder { .. } => {
+                let why = draft.holder_refusal.clone().unwrap_or_else(|| "the draft does not differ from the holder".to_owned());
+                if primary(ui, APPLY, component_changed && draft.holder_refusal.is_none())
+                    .on_hover_text("write this draft to the holder and derive each tool that uses it again (one undo step)")
+                    .on_disabled_hover_text(why)
+                    .clicked()
+                {
+                    ask = Some(Ask::Apply);
+                }
+                if ui.button(CANCEL).on_hover_text("drop the unapplied draft and go back to the list").clicked() {
+                    ask = Some(Ask::Cancel);
+                }
+                if ui.button(DUPLICATE).on_hover_text("a new user holder, copied from this holder as it is applied (one undo step)").clicked() {
+                    ask = Some(Ask::Duplicate);
+                }
+            }
+        });
+    });
+    ask
+}
+
+/// The footer's hint for `face`.
+#[must_use]
+pub(crate) fn hint(face: &Face) -> &'static str {
+    match face {
+        Face::List(LibraryPage::Tools, ToolSource::Document) => HINT_TOOLS,
+        Face::List(LibraryPage::Tools, ToolSource::Catalog) => HINT_CATALOG,
+        Face::List(LibraryPage::Tools, ToolSource::Library) => HINT_LIBRARY,
+        Face::List(LibraryPage::Holders, _) => HINT_HOLDERS,
+        Face::Holder(_) => HINT_HOLDER,
+        Face::Tool { .. } => HINT_APPLY,
+        Face::Component(_) => HINT_COMPONENT,
+        Face::UserHolder { .. } => HINT_USER_HOLDER,
+    }
+}
+
+/// The header's title: a little larger than the body text, in the body
+/// ink (the theme's strong ink is not readable on every window fill).
+fn title(ui: &Ui, text: &str) -> RichText {
+    RichText::new(text).size(15.0).color(ui.visuals().text_color())
+}
+
+/// The primary button: filled with the theme's accent while enabled.
+fn primary(ui: &mut Ui, label: &str, enabled: bool) -> egui::Response {
+    let btn = if enabled {
+        let accent = theme::current().accent;
+        Button::new(RichText::new(label).strong().color(contrast::on_fill(accent))).fill(accent)
+    } else {
+        Button::new(label)
+    };
+    ui.add_enabled(enabled, btn)
+}
+
+/// Why the tool editor's draft cannot be applied (a torch that states a
+/// spindle speed), read from the window's draft.
+fn tool_refusal(state: &State) -> Option<String> {
+    let d = &state.tool_library.as_ref()?.editor.as_ref()?.draft;
+    (d.tool_kind() == ToolKind::Waterjet).then(|| d.to_tool().torch_refusal()).flatten()
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/holder_drawing.rs b/crates/ui/src/egui_app/tool_library_dialog/holder_drawing.rs
new file mode 100644
index 000000000..882d070b6
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_library_dialog/holder_drawing.rs
@@ -0,0 +1,183 @@
+//! #3897 (U6), #4338 (U12 of #3663): the holder drawing of the tool
+//! library window, shared by the read-only holder view and the holder
+//! form: the outline to scale, nose down, with the spindle nose as a
+//! dashed box above the gauge line and the shank range the holder clamps
+//! as a dashed ghost below the nose. The dimension lines give the gauge
+//! length, the largest and the nose diameter; the drawing keeps room for
+//! their labels, so no label is cut off at the edge.
+//! Frame cost (`crates/ui/AGENTS.md`): the shapes and labels are built
+//! when the holder, the rect, the unit, the dimension toggle or the
+//! drawing's theme inks change; a still frame builds nothing (`builds`).
+//! Provenance: our own drawing over `holder_library::HolderEntry::points`;
+//! the dimension style follows `side_view` (general drawing practice). No
+//! HSMWorks material involved.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use egui::{Align2, Color32, FontId, Pos2, Rect, Sense, Shape, Stroke, Ui, Vec2};
+
+use camcraft_app::holder_library::HolderEntry;
+use camcraft_app::units::{self, Unit};
+
+use crate::egui_app::tool_model_view::tool_ground;
+
+fn note_ink() -> Color32 {
+    crate::egui_app::theme::current().tool_note
+}
+/// The room (px) the labels keep at the right and the left of the outline.
+const LABEL_R: f32 = 150.0;
+const LABEL_L: f32 = 40.0;
+/// The spindle nose box and the shank ghost, as shares of the gauge length.
+const NOSE_BOX: f64 = 0.25;
+const SHANK: f64 = 0.35;
+/// The label of the spindle nose box.
+pub(crate) const SPINDLE: &str = "spindle nose";
+
+/// What the drawing was built from.
+#[derive(Clone, PartialEq)]
+struct Key {
+    entry: HolderEntry,
+    clamps: (f64, f64),
+    rect: Rect,
+    unit: Unit,
+    dims: bool,
+    inks: Inks,
+}
+
+/// The theme inks that the kept shapes carry. The ground and the labels
+/// are painted live each frame, so they are not in the key.
+#[derive(Clone, Copy, PartialEq)]
+struct Inks {
+    axis: Color32,
+    body: Color32,
+    edge: Color32,
+    dim: Color32,
+    note: Color32,
+}
+
+impl Inks {
+    fn current() -> Self {
+        let t = crate::egui_app::theme::current();
+        Self { axis: t.tool_axis, body: t.tool_body, edge: t.tool_edge, dim: t.tool_dim, note: t.tool_note }
+    }
+}
+
+/// The kept drawing: its shapes and its labels.
+struct Drawing {
+    shapes: Vec<Shape>,
+    labels: Vec<(Pos2, Align2, String)>,
+}
+
+thread_local! {
+    static KEPT: RefCell<Option<(Key, Rc<Drawing>)>> = const { RefCell::new(None) };
+    static BUILDS: Cell<u64> = const { Cell::new(0) };
+}
+
+/// The drawings built on this thread - a still frame adds none.
+#[cfg(test)]
+pub(crate) fn builds() -> u64 {
+    BUILDS.with(Cell::get)
+}
+
+/// The largest diameter of the holder: the flange's or the body's.
+pub(crate) fn largest_d(e: &HolderEntry) -> f64 {
+    e.taper.map_or(0.0, |t| t.flange_d).max(e.body_r() * 2.0)
+}
+
+/// Holder `e` (shank range `clamps`, mm) to scale in a `size` area.
+pub(crate) fn outline(ui: &mut Ui, e: &HolderEntry, clamps: (f64, f64), size: Vec2, u: Unit, dims: bool) {
+    let (resp, painter) = ui.allocate_painter(size, Sense::hover());
+    painter.rect_filled(resp.rect, 4.0, tool_ground());
+    let key = Key { entry: *e, clamps, rect: resp.rect, unit: u, dims, inks: Inks::current() };
+    let d = KEPT.with(|k| {
+        let mut k = k.borrow_mut();
+        if let Some((kk, d)) = k.as_ref()
+            && *kk == key
+        {
+            return Rc::clone(d);
+        }
+        BUILDS.with(|b| b.set(b.get().saturating_add(1)));
+        let d = Rc::new(build(e, clamps, resp.rect, u, dims, key.inks));
+        *k = Some((key, Rc::clone(&d)));
+        d
+    });
+    painter.extend(d.shapes.iter().cloned());
+    for (at, align, text) in &d.labels {
+        painter.text(*at, *align, text, FontId::proportional(11.0), note_ink());
+    }
+}
+
+fn build(e: &HolderEntry, clamps: (f64, f64), rect: Rect, u: Unit, dims: bool, inks: Inks) -> Drawing {
+    let mut d = Drawing { shapes: Vec::new(), labels: Vec::new() };
+    let Ok(points) = e.points(0.0, e.gauge_len) else {
+        d.labels.push((rect.center(), Align2::CENTER_CENTER, "no outline".to_owned()));
+        return d;
+    };
+    let pts: Vec<(f64, f64)> = points.iter().map(|p| (p.z, p.r)).filter(|(z, r)| z.is_finite() && r.is_finite()).collect();
+    let r_max = pts.iter().map(|p| p.1).fold(0.0f64, f64::max);
+    let z_max = pts.iter().map(|p| p.0).fold(0.0f64, f64::max);
+    if r_max <= 0.0 || z_max <= 0.0 {
+        return d;
+    }
+    // The spindle nose box is wider than the holder; the room left for
+    // the labels on both sides is kept out of the scale.
+    let r_box = r_max * 1.3;
+    let (top, bottom) = (z_max * (1.0 + NOSE_BOX), -z_max * SHANK);
+    let inner = Rect::from_min_max(
+        Pos2::new(rect.left() + LABEL_L, rect.top() + 12.0),
+        Pos2::new((rect.right() - LABEL_R).max(rect.left() + LABEL_L + 40.0), (rect.bottom() - 26.0).max(rect.top() + 52.0)),
+    );
+    let scale = (inner.width() / (2.0 * r_box as f32)).min(inner.height() / (top - bottom) as f32).max(f32::EPSILON);
+    let axis = inner.center().x;
+    let base = inner.bottom() + bottom as f32 * scale;
+    let at = |z: f64, r: f64| Pos2::new(axis + r as f32 * scale, base - z as f32 * scale);
+    d.shapes.push(Shape::line_segment(
+        [Pos2::new(axis, rect.top() + 4.0), Pos2::new(axis, rect.bottom() - 4.0)],
+        Stroke::new(1.0, inks.axis),
+    ));
+    for w in pts.windows(2) {
+        let ((z0, r0), (z1, r1)) = (w[0], w[1]);
+        if z1 > z0 {
+            d.shapes.push(Shape::convex_polygon(vec![at(z0, -r0), at(z0, r0), at(z1, r1), at(z1, -r1)], inks.body, Stroke::NONE));
+        }
+    }
+    let mut edge: Vec<Pos2> = pts.iter().map(|&(z, r)| at(z, r)).collect();
+    edge.extend(pts.iter().filter(|p| p.1 > 0.0).rev().map(|&(z, r)| at(z, -r)));
+    d.shapes.push(Shape::closed_line(edge, Stroke::new(1.0, inks.edge)));
+    let ghost = Stroke::new(1.0, inks.note);
+    let dashed = |d: &mut Drawing, pts: &[Pos2]| d.shapes.extend(Shape::dashed_line(pts, ghost, 5.0, 4.0));
+    // The spindle nose above the gauge line.
+    let sp = [at(z_max, -r_box), at(top, -r_box), at(top, r_box), at(z_max, r_box), at(z_max, -r_box)];
+    dashed(&mut d, &sp);
+    d.labels.push((Pos2::new(at(z_max, r_box).x + 6.0, at((z_max + top) * 0.5, 0.0).y), Align2::LEFT_CENTER, SPINDLE.to_owned()));
+    // The shank range below the nose: the largest shank, the smallest inside.
+    let (from, to) = clamps;
+    if to > 0.0 && to.is_finite() {
+        let (rt, rf) = (to * 0.5, from.max(0.0) * 0.5);
+        dashed(&mut d, &[at(0.0, -rt), at(bottom, -rt), at(bottom, rt), at(0.0, rt)]);
+        if rf > 0.0 && (rt - rf) > 1e-9 {
+            dashed(&mut d, &[at(0.0, -rf), at(bottom * 0.8, -rf), at(bottom * 0.8, rf), at(0.0, rf)]);
+        }
+        let len = |v: f64| units::len(v, u, 2);
+        let text = if (to - from).abs() < 1e-9 { format!("shank Ø{}", len(to)) } else { format!("shank Ø{} to {}", len(from), len(to)) };
+        d.labels.push((Pos2::new(at(0.0, rt).x + 6.0, at(bottom * 0.5, 0.0).y), Align2::LEFT_CENTER, text));
+    }
+    if dims {
+        let len = |v: f64| units::len(v, u, 2);
+        let stroke = Stroke::new(1.0, inks.dim);
+        // The gauge length on the right, the largest diameter over the top,
+        // the nose diameter under the nose.
+        let x = at(0.0, r_max).x + 14.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(x, at(0.0, 0.0).y), Pos2::new(x, at(z_max, 0.0).y)], stroke));
+        d.labels.push((Pos2::new(x + 4.0, at(z_max * 0.5, 0.0).y), Align2::LEFT_CENTER, format!("gauge length {}", len(e.gauge_len))));
+        let y = at(z_max, 0.0).y - 8.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(at(0.0, -r_max).x, y), Pos2::new(at(0.0, r_max).x, y)], stroke));
+        d.labels.push((Pos2::new(axis, y - 2.0), Align2::CENTER_BOTTOM, format!("Ø {}", len(largest_d(e)))));
+        let rn = e.body_r();
+        let y = at(0.0, 0.0).y + 8.0;
+        d.shapes.push(Shape::line_segment([Pos2::new(at(0.0, -rn).x, y), Pos2::new(at(0.0, rn).x, y)], stroke));
+        d.labels.push((Pos2::new(at(0.0, -rn).x - 4.0, y), Align2::RIGHT_CENTER, format!("nose Ø {}", len(rn * 2.0))));
+    }
+    d
+}
diff --git a/crates/ui/src/egui_app/tool_library_dialog/holder_form.rs b/crates/ui/src/egui_app/tool_library_dialog/holder_form.rs
