+/// The transport bar's right-hand text: `{op} · {verb}[ · A/B/C] ·
+/// {t}/{total} s`, the verb the current segment reports (RAPID, the live
+/// feed through the units lens, DWELL n s, END at the finish, STANDBY
+/// before the first move), and - since M5.1 stage G - the commanded
+/// letters whenever the head is off home. Pure and `pub(crate)` so the
+/// tests pin the string law without a window.
+pub(crate) fn sim_readout(
+    sc: &camcraft_app::sim::Script,
+    t: f64,
+    unit: camcraft_app::units::Unit,
+) -> String {
+    let f = sc.at(t);
+    let verb = match f.readout {
+        camcraft_app::sim::Readout::Rapid => "RAPID".to_owned(),
+        camcraft_app::sim::Readout::Feed(v) => {
+            format!("F {} {}", camcraft_app::units::feed(v, unit), unit.feed_suffix())
+        }
+        camcraft_app::sim::Readout::Dwell(x) => format!("DWELL {x:.1} s"),
+        camcraft_app::sim::Readout::Idle if f.done => "END".to_owned(),
+        camcraft_app::sim::Readout::Idle => "STANDBY".to_owned(),
+    };
+    let op = f
+        .op
+        .and_then(|i| sc.ops.get(i))
+        .map_or("(none)", |s| s.as_str());
+    // The head's letters (M5.1 stage G), stated only while it is off
+    // home: a prismatic program's readout is the exact string it
+    // always was (the transport-law tests pin it), and the moment
+    // the timeline carries a tilt, the numbers the post wrote and
+    // the mid-turn law judged become readable mid-swing.
+    let pose = if camcraft_app::cl::is_vertical(&f.axis) {
+        String::new()
+    } else {
+        let [a, b, c] = camcraft_app::cl::axis_to_angles(f.axis);
+        format!(" · A{a:.0} B{b:.0} C{c:.0}")
+    };
+    format!("{op} · {verb}{pose} · {t:.1}/{:.1} s", sc.total.max(0.0))
+}
+
+/// The timeline for this document version: `sim_script` once per
+/// `doc_version` bump, shared by the transport and the traced
+/// playback, so no frame re-walks (or re-clones) every op's path.
+pub(crate) fn cached_script(state: &mut State) -> std::sync::Arc<camcraft_app::sim::Script> {
+    if let Some((v, sc)) = &state.sim_script_cache
+        && *v == state.doc_version
+    {
+        return std::sync::Arc::clone(sc);
+    }
+    let sc = std::sync::Arc::new(sim_script(state));
+    state.sim_script_cache = Some((state.doc_version, std::sync::Arc::clone(&sc)));
+    sc
+}
+
+/// The playback marker's pose: the frame's program point and axis,
+/// carried by the frame's work turn when it has one (#4266) - the same
+/// pose the tool body draws from, one display frame. `None` past the
+/// timeline (the caller draws no marker).
+pub(crate) fn sim_marker_pose(sc: &camcraft_app::sim::Script, t: f64) -> Option<([f64; 3], [f64; 3])> {
+    let f = sc.at(t);
+    f.work
+        .as_ref()
+        .and_then(|w| camcraft_app::sim_machine_view::posed_tool([f.pos.x, f.pos.y, f.pos.z], f.axis, w))
+        .or(Some(([f.pos.x, f.pos.y, f.pos.z], f.axis)))
+}
+
+/// Rebuild the timeline from the live world (`cached_script` is the
+/// per-frame door): the same
+/// tree-order walk the post takes (hidden paths included - hidden is
+/// display, not suppression; the law stands on `State::has_toolpaths`),
+/// so the transport clock and the posted program count the same moves.
+pub(crate) fn sim_script(state: &State) -> camcraft_app::sim::Script {
+    use camcraft_app::{model, posting, setup, sim};
+    let tr = sim::Traverse::from_machine(&posting::machine_value(&state.world));
+    let paths: Vec<(String, camcraft_app::cl::Toolpath)> = setup::operation_order(&state.world)
+        .into_iter()
+        .filter_map(|(n, e)| model::toolpath_of(&state.world, &e).map(|tp| (n, tp.path)))
+        .collect();
+    let mut sc = sim::script(paths.iter().map(|(n, t)| (n.as_str(), t)), &tr);
+    // #4266, display only: each op's work-turn line, when its machine
+    // turns the work about one the gate would judge. `None` elsewhere.
+    let turns: Vec<Option<sim::WorkTurn>> = sc.ops.iter().map(|name| work_turn_of(state, name)).collect();
+    for seg in &mut sc.segs {
+        seg.work = turns[seg.op];
+    }
+    sc
+}
+
+/// #4266, display only: the rotary axis line the operation's work
+/// turns about - the very line the gate's posed-steel laws judge
+/// (`fixture::rotary_axis_of`: the stated op/machine line through the
+/// WCS origin, else the free fit), and only on a mounted machine that
+/// states a work-turning rotary (`turns_part`, the machine editor's
+/// flag). No machine, no work-turning rotary, a non-rotary kind, or a
+/// degenerate line: `None` - the playback keeps today's tip-relative
+/// draw, nothing guessed.
+fn work_turn_of(state: &State, op_name: &str) -> Option<camcraft_app::sim::WorkTurn> {
+    use camcraft_app::{fixture, machine, model};
+    let e = model::find_by_name(&state.world, op_name)?;
+    let op = model::operation_of(&state.world, &e)?;
+    let (_, m) = machine::of_setup(&state.world, op.setup.as_deref());
+    let turns_work = m.is_some_and(|m| m.axes.iter().any(|a| a.rotary && a.turns_part == Some(true)));
+    if !turns_work {
+        return None;
+    }
+    let ax = fixture::rotary_axis_of(&state.world, &op)?;
+    if !ax.dir.iter().all(|d| d.is_finite()) || ax.dir.iter().map(|d| d.abs()).sum::<f64>() < 1e-12 {
+        return None;
+    }
+    Some(camcraft_app::sim::WorkTurn { origin: [ax.origin.x, ax.origin.y, ax.origin.z], dir: ax.dir })
+}
+
+/// The move the G-code viewer's cursor points at, as the segment that
+/// arrives at it: the last recorded position at or before the scroll
+/// line, drawn from the one before that (so the highlight is the path's
+/// own polyline, not a floating point - the first move's segment
+/// collapses to its endpoint ring). None with no viewer up, the window
+/// closed, or a map that holds no position yet. Pure, like the readout
+/// - the viewport pass draws what this resolves, nothing more.
+pub(crate) fn gcode_segment(state: &State) -> Option<([f64; 3], [f64; 3])> {
+    let view = state.post_view.as_ref()?;
+    if !view.open {
+        return None;
+    }
+    let cursor = view.line.min(view.line_pos.len().saturating_sub(1));
+    let mut to = None;
+    let mut from = None;
+    for (i, p) in view.line_pos.iter().enumerate() {
+        if i > cursor {
+            break;
+        }
+        if let Some(p) = p {
+            from = to;
+            to = Some(*p);
+        }
+    }
+    let to = to?;
+    Some((from.unwrap_or(to), to))
+}
+
+/// egui Pos2 -> the `[f32; 2]` convention interact.rs speaks (0.36 has no
+/// `to_array` on Pos2).
+fn parr(p: egui::Pos2) -> [f32; 2] {
+    [p.x, p.y]
+}
+
+/// Headless proof (the M-a gate, graduated from the spike's S2 gate): no
+/// window, no surface - `headless_gpu::device()` (software adapter first,
+/// else hardware; the same choice as tests/gpu_render.rs), View3D on the shell's Rgba8Unorm offscreen
+/// format, the SEEDED document rendered (block + stock + region + cached
+/// path through set_overlay), and the readback showing a solid footprint of
+/// changed pixels. The second half of the proof is the world itself:
+/// Contour1 carries a non-empty cached toolpath, i.e. seed -> commands ->
+/// generate worked. Native only: it blocks on the adapter and on the
+/// readback, which a browser cannot (#31).
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) mod headless {
+    use camcraft_app::model;
+
+    use crate::state::{CommandKind, State};
+    use crate::viewport::{Camera, View3D};
+
+    use super::VIEW3D_FORMAT;
+    use super::wgpu;
+    use super::super::world;
+
+    /// `open`: the file named on the command line (#2648), drawn in place
+    /// of the seeded document; `None` runs the seeded proof. Ok carries
+    /// what was drawn, for the run's last line.
+    pub(crate) fn run(open: Option<CommandKind>) -> Result<String, String> {
+        let (state, cam, must_draw, said) = match open {
+            Some(cmd) => {
+                let opened = crate::headless_open::open(cmd)?;
+                let cam = opened.state.cam;
+                (opened.state, cam, opened.has_geometry, opened.said)
+            }
+            None => {
+                let (state, op_ok) = seeded()?;
+                // Same vantage the gpu_render smoke tests use on equivalent parts.
+                let cam = Camera {
+                    target: [0.0, 0.0, 20.0],
+                    yaw: 0.9,
+                    pitch: 0.5,
+                    dist: 160.0,
+                    ..Camera::default()
+                };
+                (state, cam, true, format!("seeded document, command world; Contour1 cached {op_ok} moves"))
+            }
+        };
+
+        // Software adapter first, else the hardware one (#615: macOS's
+        // Metal has no software fallback).
+        let gpu = crate::headless_gpu::device()?;
+        diag_info!("headless: {} adapter {}", gpu.kind.label(), gpu.name);
+        let (device, queue) = (gpu.device, gpu.queue);
+
+        let mut view = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            View3D::new(&device, VIEW3D_FORMAT, 320, 240)
+        }))
+        .map_err(|_| "View3D pipeline panicked on validation".to_string())?;
+        let scene = world::collect(&state);
+        view.set_document(&device, &queue, &scene.parts);
+        view.set_overlay(&device, &queue, &scene.overlay);
+
+        let (w, h) = view.extent();
+        let mvp = cam.mvp(f64::from(w.max(1)) / f64::from(h.max(1)));
+        let mut encoder = device.create_command_encoder(&wgpu::CommandEncoderDescriptor {
+            label: Some("egui-shell-headless"),
+        });
+        view.render(&queue, &mut encoder, &mvp, cam.eye_f32(), state.display);
+        queue.submit([encoder.finish()]);
+
+        let (rgba, w, h) = view
+            .snapshot_rgba(&device, &queue)
+            .ok_or_else(|| "no readback path".to_string())?;
+        // The corner pixel is untouched clear color; anything differing from
+        // it by the gpu_render epsilon is rasterized geometry (the format-
+        // agnostic assertion - no assumptions about shading brightness).
+        let bg: [u8; 4] = rgba
+            .first_chunk::<4>()
+            .copied()
+            .ok_or_else(|| "empty readback".to_string())?;
+        let changed = rgba
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .filter(|p| {
+                p.iter().zip(bg).any(|(a, b)| {
+                    i32::from(*a) - i32::from(b) > 6 || i32::from(b) - i32::from(*a) > 6
+                })
+            })
+            .count();
+        let total = (w as usize * h as usize).max(1);
+        if must_draw && changed * 20 < total {
+            // less than 5% of the frame: the document did not rasterize
+            return Err(format!("readback looks empty ({changed}/{total} changed px)"));
+        }
+        diag_info!("headless snapshot: {w}x{h}, {}% pixels changed", changed * 100 / total);
+        Ok(said)
+    }
+
+    /// The seeded proof document, with Contour1's cached move count.
+    fn seeded() -> Result<(State, usize), String> {
+        let mut state = State::new();
+        world::seed(&mut state);
+        state.pending.push_back(CommandKind::FrameAll);
+        state.drain_actions();
+        let op_ok = model::find_by_name(&state.world, "Contour1")
+            .and_then(|e| model::toolpath_of(&state.world, &e))
+            .map_or(0, |tp| tp.path.moves.len());
+        if op_ok == 0 {
+            return Err(format!(
+                "seed produced no cached toolpath for Contour1 (status: {})",
+                state.status
+            ));
+        }
+        Ok((state, op_ok))
+    }
+}
diff --git a/crates/ui/src/egui_app/tests/pane_fold.rs b/crates/ui/src/egui_app/tests/pane_fold.rs
index db967c23e..f9dc82cad 100644
--- a/crates/ui/src/egui_app/tests/pane_fold.rs
+++ b/crates/ui/src/egui_app/tests/pane_fold.rs
@@ -230,3 +230,87 @@ fn an_older_setup_loads_with_every_pane_unfolded() {
         assert!(!fold::is_folded(&loaded, &tab), "{tab:?} loads open");
     }
 }
+
+// ------------------------------------------------ the state on the chips
+
+/// The seeded shell (Contour1, generated) at the plan's screen size.
+fn seeded() -> H {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(1366.0, 768.0))
+        .build_ui_state(frame, ShellUi::seeded());
+    h.run_steps(3);
+    h
+}
+
+/// Make the seed's Contour1 stale through the command queue (an edit
+/// that changes what generation read).
+fn make_stale(h: &mut H) {
+    let edited = {
+        let st = &h.state().state;
+        let e = model::find_by_name(&st.world, "Contour1").expect("the seed's op");
+        let mut p = model::operation_of(&st.world, &e).expect("op").params;
+        if let OpParams::Contour { plunge_feed, .. } = &mut p {
+            *plunge_feed = 150.0;
+        }
+        p
+    };
+    h.state_mut()
+        .state
+        .pending
+        .push_back(CommandKind::EditOperationParams { name: "Contour1".into(), params: edited });
+    h.run_steps(3);
+}
+
+/// The texts painted inside the leaf of `tab`, under its tab bar.
+fn chip_texts(h: &H, tab: &Tab) -> Vec<String> {
+    let leaf = leaf_rect(&h.state().dock, tab).expect("docked");
+    super::structural::painted(h)
+        .into_iter()
+        .filter(|(_, p)| p.x >= leaf.left() - 1.0 && p.x <= leaf.right() + 1.0 && p.y > leaf.top() + 20.0)
+        .map(|(t, _)| t)
+        .collect()
+}
+
+#[test]
+fn a_stale_operation_shows_on_the_folded_browser_chip() {
+    let mut h = seeded();
+    assert!(fold::fold(&mut h.state_mut().dock, &Tab::Browser));
+    h.run_steps(3);
+    let texts = chip_texts(&h, &Tab::Browser);
+    assert!(texts.iter().any(|t| t == "\u{2714} Up to date"), "a current job says so: {texts:?}");
+    make_stale(&mut h);
+    let texts = chip_texts(&h, &Tab::Browser);
+    assert!(texts.iter().any(|t| t == "\u{26A0} 1 stale"), "the stale count stays on screen: {texts:?}");
+}
+
+#[test]
+fn the_folded_properties_chip_names_the_operation_state() {
+    let mut h = seeded();
+    crate::actions::target(&mut h.state_mut().state, UiTarget::Operation("Contour1".into()));
+    h.run_steps(2);
+    assert!(fold::fold(&mut h.state_mut().dock, &Tab::Properties));
+    h.run_steps(3);
+    let texts = chip_texts(&h, &Tab::Properties);
+    assert!(texts.iter().any(|t| t == "\u{2714} Up to date"), "the open operation is current: {texts:?}");
+    make_stale(&mut h);
+    let texts = chip_texts(&h, &Tab::Properties);
+    assert!(texts.iter().any(|t| t == "\u{26A0} Needs regenerate"), "the open operation needs work: {texts:?}");
+}
+
+#[test]
+fn a_fold_does_not_move_the_camera() {
+    let mut h = seeded();
+    let before = h.state().state.cam;
+    for tab in [Tab::Browser, Tab::Properties] {
+        assert!(fold::fold(&mut h.state_mut().dock, &tab));
+    }
+    h.run_steps(3);
+    let folded = h.state().state.cam;
+    h.state_mut().state.layout_request = Some(LayoutRequest::Reset);
+    h.run_steps(3);
+    let after = h.state().state.cam;
+    for cam in [folded, after] {
+        assert_eq!(cam.target, before.target, "the orbit target stays");
+        assert_eq!((cam.yaw, cam.pitch, cam.dist), (before.yaw, before.pitch, before.dist), "the view stays");
+    }
+}
