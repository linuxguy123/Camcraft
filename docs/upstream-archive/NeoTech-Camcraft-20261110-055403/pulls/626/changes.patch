+    }
+
+    /// Read a [`Self::word`] back; anything else is `None`.
+    #[must_use]
+    pub fn from_word(w: &str) -> Option<ThreadHand> {
+        match w {
+            "right" => Some(ThreadHand::Right),
+            "left" => Some(ThreadHand::Left),
