+    assert_eq!(posting::default_post_for(Kind::Lathe), PostRef::Named("Fanuc Lathe".into()));
+    let world = new_world();
+    assert!(SelectPost::new(&world, PostRef::Named(NAME.into())).is_ok());
+}
