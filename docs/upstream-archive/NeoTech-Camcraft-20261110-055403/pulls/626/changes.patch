+/// Which way a thread winds (issue #629): right-hand, the default every
+/// drawing means unless it says LH, or left-hand.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum ThreadHand {
+    #[default]
+    Right,
+    Left,
