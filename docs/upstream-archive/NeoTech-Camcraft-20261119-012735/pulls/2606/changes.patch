From 81691377182822cc5bb2792905910c1c6970a4df Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Wed, 18 Nov 2026 21:30:22 +0000
Subject: [PATCH] fix(ci): post-merge report job runs when the gate fails

The report job had `needs: gate` and an `if` with no status check
function, so GitHub added an implicit success(): a failed gate skipped
the job, and a red main opened no rolling issue. The `if` now starts
with always(); its other terms still exclude a cancelled or a
cut-skipped run.

Pinned by xtask/tests/post_merge_report.rs
(a_failed_gate_still_runs_the_report_job).

Fixes #1611

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/post-merge.yml |  4 +++-
 xtask/tests/post_merge_report.rs | 31 +++++++++++++++++++++++++++++++
 2 files changed, 34 insertions(+), 1 deletion(-)
 create mode 100644 xtask/tests/post_merge_report.rs

diff --git a/.github/workflows/post-merge.yml b/.github/workflows/post-merge.yml
index d714f97d9..755a3b4e6 100644
--- a/.github/workflows/post-merge.yml
+++ b/.github/workflows/post-merge.yml
@@ -107,8 +107,10 @@ jobs:
 
   report:
     # Red or green only: a cancelled run (a newer merge) or a skipped one says nothing.
+    # always() first (#1611): without a status function GitHub adds an implicit
+    # success(), which skips this job when the gate fails - a red main reported nothing.
     needs: gate
-    if: ${{ (needs.gate.result == 'success' || needs.gate.result == 'failure') && needs.gate.outputs.skipped != 'true' && (github.event_name == 'push' || inputs.ref == '' || inputs.ref == 'main') }}
+    if: ${{ always() && (needs.gate.result == 'success' || needs.gate.result == 'failure') && needs.gate.outputs.skipped != 'true' && (github.event_name == 'push' || inputs.ref == '' || inputs.ref == 'main') }}
     runs-on: [self-hosted, camcraft-post-merge]
     timeout-minutes: 10
     permissions:
diff --git a/xtask/tests/post_merge_report.rs b/xtask/tests/post_merge_report.rs
new file mode 100644
index 000000000..d54e602fb
--- /dev/null
+++ b/xtask/tests/post_merge_report.rs
@@ -0,0 +1,31 @@
+// Provenance: issue #1611 and the repository's post-merge workflow contract;
+// GitHub's public Actions documentation (status check functions in `if`).
+use std::{fs, path::Path};
+
+/// The `if:` line of the `report` job.
+fn report_if() -> String {
+    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join("../.github/workflows/post-merge.yml");
+    let workflow = fs::read_to_string(path).expect("read the post-merge workflow");
+    let report = workflow.split_once("\n  report:\n").expect("the workflow has a report job").1;
+    // The job's own lines: indented past the job key, up to the next job.
+    report
+        .lines()
+        .take_while(|line| line.is_empty() || line.starts_with("    "))
+        .find_map(|line| line.trim_start().strip_prefix("if: "))
+        .expect("the report job has an if")
+        .to_owned()
+}
+
+#[test]
+fn a_failed_gate_still_runs_the_report_job() {
+    let cond = report_if();
+    // Without a status function GitHub adds an implicit success(): a failed
+    // `needs: gate` then skips the job and a red main opens no issue (#1611).
+    assert!(cond.starts_with("${{ always() && "), "the report job's if starts with always(): {cond}");
+    // always() alone would also report a cancelled or a cut-skipped run.
+    assert!(
+        cond.contains("(needs.gate.result == 'success' || needs.gate.result == 'failure')"),
+        "only a green or a red gate reports: {cond}"
+    );
+    assert!(cond.contains("needs.gate.outputs.skipped != 'true'"), "a run that yields to a cut reports nothing: {cond}");
+}
