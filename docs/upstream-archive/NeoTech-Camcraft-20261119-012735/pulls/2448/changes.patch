diff --git a/crates/app/tests/import_solidcraft.rs b/crates/app/tests/import_solidcraft.rs
index 395e66364..9a44319d0 100644
--- a/crates/app/tests/import_solidcraft.rs
+++ b/crates/app/tests/import_solidcraft.rs
@@ -108,3 +108,35 @@ fn mcp_import_model_opens_a_solidcraft_design() {
     assert_ne!(ok["isError"], json!(true), "{ok}");
