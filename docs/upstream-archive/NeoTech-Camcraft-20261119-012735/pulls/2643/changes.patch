From 2e356f89872a26c822173f13650be2cdf0dfe902 Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Wed, 18 Nov 2026 23:09:05 +0000
Subject: [PATCH] ci(release): run the site tests in the site job

PR #1825 added site/tests/test_operation_reference.py, which pins the
operation reference pictures against OpType, but nothing ran it (nor the
other Zola-building site tests). The site job of release.yml now runs
`python3 -m unittest discover -s site/tests -v` with its pinned Zola
(ZOLA=/tmp/zola), right after the Zola install and before version.toml
is written, so a missing reference section or picture view fails the
site job. site/README.md says so.

Pinned by xtask/tests/release_site_tests.rs:
the_site_job_runs_the_site_tests_with_its_pinned_zola.

Fixes #1832

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/release.yml     | 10 ++++++++++
 site/README.md                    |  4 ++++
 xtask/tests/release_site_tests.rs | 30 ++++++++++++++++++++++++++++++
 3 files changed, 44 insertions(+)
 create mode 100644 xtask/tests/release_site_tests.rs

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 1a937f959..bbeecc63f 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -480,6 +480,16 @@ jobs:
           echo '7d77a4220a4f699cba2fc0e0c7859f780e887e269159ad4fab90e11ea16c906f  /tmp/zola.tar.gz' | sha256sum -c -
           tar -xzf /tmp/zola.tar.gz -C /tmp zola
           /tmp/zola --version
+      - name: Site tests
+        # #1832: the Python site tests (site/tests) pin the operation
+        # reference pictures against OpType, the guide navigation, links
+        # and images. Nothing else runs them: a missing section or picture
+        # view fails the site here. They run before version.toml exists, on
+        # the same tree as a local run (site/README.md), and build into
+        # their own temporary folders with this Zola.
+        env:
+          ZOLA: /tmp/zola
+        run: python3 -m unittest discover -s site/tests -v
       - name: Version the site is built from
         # The workspace version is the release's version (the publish job
         # checks the tag names it too); the site's templates read it from
diff --git a/site/README.md b/site/README.md
index dd4b997b6..ace4fbec3 100644
--- a/site/README.md
+++ b/site/README.md
@@ -32,6 +32,10 @@ python3 -m unittest discover -s site/tests -v
 
 They build the site under a URL prefix and check the guide navigation,
 legacy redirects, internal links and operation reference pictures.
+The `site` job of `.github/workflows/release.yml` runs the same command
+with its pinned Zola (`ZOLA=/tmp/zola`) before it builds the site, so a red
+site test fails the release's site (#1832). Each Zola test reads the binary
+from `ZOLA` and falls back to `zola` on `PATH`; without either it errors.
 
 The version shown on the site comes from `version.toml`, which the release
 workflow writes from the workspace version before it builds. Without it the
diff --git a/xtask/tests/release_site_tests.rs b/xtask/tests/release_site_tests.rs
new file mode 100644
index 000000000..5a4a7e312
--- /dev/null
+++ b/xtask/tests/release_site_tests.rs
@@ -0,0 +1,30 @@
+// Provenance: issue #1832 and the repository's release workflow contract.
+use std::{fs, path::Path};
+
+/// The `site` job of release.yml: from its `  site:` line up to the next
+/// job (a line indented two spaces) or the end of the file.
+fn site_job() -> String {
+    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join("../.github/workflows/release.yml");
+    let workflow = fs::read_to_string(path).expect("read the release workflow");
+    let body = workflow.split_once("\n  site:\n").expect("release.yml has a site job").1;
+    body.lines()
+        .take_while(|line| line.is_empty() || line.starts_with("   ") || line.starts_with("  #"))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[test]
+fn the_site_job_runs_the_site_tests_with_its_pinned_zola() {
+    let job = site_job();
+    let install = job.find("- name: Install pinned Zola").expect("the site job installs Zola");
+    let tests = job.find("- name: Site tests").expect("the site job runs the site tests (#1832)");
+    assert!(install < tests, "the site tests run after Zola is installed");
+    let step = &job[tests..];
+    let step = step[1..].split_once("\n      - ").map_or(step, |(s, _)| s);
+    assert!(
+        step.lines().any(|l| l.trim() == "run: python3 -m unittest discover -s site/tests -v"),
+        "the step runs every site test, the operation reference included:\n{step}"
+    );
+    assert!(step.lines().any(|l| l.trim() == "ZOLA: /tmp/zola"), "the tests build with the pinned Zola:\n{step}");
+    assert!(!step.contains("continue-on-error"), "a red site test fails the site job:\n{step}");
+}
