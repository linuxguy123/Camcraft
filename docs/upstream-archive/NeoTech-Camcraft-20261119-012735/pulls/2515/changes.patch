+  }
+  if (ask === "optional-stop") { block(["M1"]); return; }
+  if (ask === "stop") { block(["M0"]); return; }
+  if (ask === "home") {
+    msg(coolantWho() + "going home after an operation is not posted by the Mach3 post - the G28/G30 positions are controller settings it cannot see; pick Optional stop or Program stop");
