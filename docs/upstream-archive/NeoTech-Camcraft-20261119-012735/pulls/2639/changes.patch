@@ -0,0 +1,57 @@
+//! #2375: an orthographic pick ray starts at the ortho near plane, not at
+//! the eye plane. The ortho eye sits only `ORTHO_EYE_DIST` in front of the
+//! target, and the near plane reaches far behind it (#1689), so a face
+//! nearer the viewer than the eye plane is drawn - and must be pickable.
+//!
+//! Provenance: our own tests over our own camera and pick law; no vendor
+//! material consulted.
+
+use camcraft_app::commands::ImportModel;
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::pick;
+
+use crate::state::State;
+use crate::viewport::{Camera, ORTHO_EYE_DIST, ProjectionMode};
+
+/// Top view in ortho, looking down -Z at the origin: the eye plane is Z 100.
+fn top_ortho() -> Camera {
+    let cam = Camera { target: [0.0, 0.0, 0.0], dist: 50.0, projection: ProjectionMode::Orthographic, ..Camera::default() }
+        .toward([0.0, 0.0, 1.0]);
+    assert_eq!(cam.projection, ProjectionMode::Orthographic);
+    assert!((cam.eye()[2] - ORTHO_EYE_DIST).abs() < 1e-9, "the eye plane is Z {}", cam.eye()[2]);
+    cam
+}
+
+#[test]
+fn an_ortho_pick_hits_the_top_face_that_stands_above_the_eye_plane() {
+    let mut state = State::new();
+    // A 300 mm column: its top face is 200 mm nearer the viewer than the
+    // eye plane, and well inside the near plane, so the view draws it.
+    state.history.execute(
+        &state.world,
+        ImportModel::from_mesh("Column", cube(Point3::new(-10.0, -10.0, 0.0), Point3::new(10.0, 10.0, 300.0))),
+    );
+    let cam = top_ortho();
+    assert!(300.0 - ORTHO_EYE_DIST < cam.ortho_behind_eye(), "the top face is inside the drawn box");
+    let (origin, dir) = cam.ray_through([0.0, 0.0], 1.5).expect("finite ray");
+    let (name, _, at) = pick::first_hit_f(&state.world, origin, dir, |_| false).expect("the click finds the column");
+    assert_eq!(name, "Column");
+    assert!((at[2] - 300.0).abs() < 1e-6, "the nearest face is the top at Z 300, not {at:?}");
+}
+
+#[test]
+fn the_ortho_ray_starts_on_the_near_plane_and_keeps_its_line() {
+    let cam = top_ortho();
+    let e = cam.eye();
+    for ndc in [[0.0f32, 0.0], [0.6, -0.4], [-0.9, 0.8]] {
+        let (o, d) = cam.ray_through(ndc, 1.5).expect("finite ray");
+        // The view axis is -Z here: the origin is `ortho_behind_eye` above the eye plane.
+        assert!((o[2] - (e[2] + cam.ortho_behind_eye())).abs() < 1e-9, "origin {o:?} for {ndc:?}");
+        assert!(d[0].abs() < 1e-12 && d[1].abs() < 1e-12 && (d[2] + 1.0).abs() < 1e-12, "parallel rays: {d:?}");
+    }
+    // The near plane in the matrix and the ray agree: a point on it maps to clip depth 0.
+    let m = cam.mvp(1.5);
+    let z_near = e[2] + cam.ortho_behind_eye();
+    let depth = m[2][2] as f64 * z_near + m[3][2] as f64;
+    assert!(depth.abs() < 1e-3, "the near plane is the ray's start: clip z {depth}");
+}
diff --git a/crates/ui/src/viewport.rs b/crates/ui/src/viewport.rs
index 29d713662..c78a49b6f 100644
--- a/crates/ui/src/viewport.rs
+++ b/crates/ui/src/viewport.rs
@@ -1128,9 +1128,10 @@ impl Camera {
     /// Ray through an NDC cursor position (x right, y up, -1..1):
     /// (origin, normalized direction), or None on degenerate math.
     /// In [`ProjectionMode::Orthographic`] the ray is parallel to the
-    /// view axis and its origin is the cursor's point on the eye plane
-    /// - the mirror of the ortho box [`Camera::mvp`] draws, so a pick
-    ///   through the same matrix hits what the screen shows (#434).
+    /// view axis and its origin is the cursor's point on the near plane,
+    /// [`Camera::ortho_behind_eye`] behind the eye plane - the mirror of
+    /// the ortho box [`Camera::mvp`] draws, so a pick through the same
+    /// matrix hits what the screen shows (#434), nearer faces included (#2375).
     #[must_use]
     pub fn ray_through(&self, ndc: [f32; 2], aspect: f64) -> Option<([f64; 3], [f64; 3])> {
         let (fx, fy, fz) = self.fwd();
@@ -1147,10 +1148,11 @@ impl Camera {
             let h = self.ortho_half_height();
             let w = h * aspect;
             let e = self.eye();
+            let back = self.ortho_behind_eye();
             let origin = [
-                e[0] + nx * w * rx + ny * h * ux,
-                e[1] + nx * w * ry + ny * h * uy,
-                e[2] + nx * w * rz + ny * h * uz,
+                e[0] + nx * w * rx + ny * h * ux - back * fx,
+                e[1] + nx * w * ry + ny * h * uy - back * fy,
+                e[2] + nx * w * rz + ny * h * uz - back * fz,
             ];
             let dir = [fx, fy, fz];
             if !origin.iter().all(|v| v.is_finite())
@@ -1435,7 +1437,7 @@ impl Camera {
             // the target plane and any nearer geometry would vanish.
             // The near plane reaches far behind the eye plane so nothing
             // inside the visible box clips away.
-            let near = -((self.dist * 20.0).max(1000.0) - ORTHO_EYE_DIST);
+            let near = -self.ortho_behind_eye();
             // Parallel box (#434): half-height is what perspective sees at
             // the target plane, so `dist` keeps spelling zoom and the
             // mode switch never jumps the framing. Depth is linear and
@@ -1474,6 +1476,13 @@ impl Camera {
     pub(crate) fn ortho_half_height(&self) -> f64 {
         self.dist * (std::f64::consts::FRAC_PI_6).tan()
     }
+
+    /// How far the orthographic near plane sits behind the eye plane, mm:
+    /// [`Camera::mvp`] clips there and [`Camera::ray_through`] starts there.
+    #[must_use]
+    pub(crate) fn ortho_behind_eye(&self) -> f64 {
+        (self.dist * 20.0).max(1000.0) - ORTHO_EYE_DIST
+    }
 }
 
 fn normalize(v: [f64; 3]) -> (f64, f64, f64) {
