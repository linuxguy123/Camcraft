From d3b53cec9a2441d0f42a3ac82ca86321f47815d3 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sun, 22 Nov 2026 11:52:35 -0800
Subject: [PATCH 5/6] fix(geometry): refuse nested outlines whose winding
 nonzero fill fills

The sketch reads holes by nesting, but a TrueType font fills by the nonzero
winding rule. A contour inside another that runs in the same direction is
filled, not a hole. Refuse that arrangement by name (OutlineTextError::Winding)
so a pocket or cut-out never takes the wrong region.

Pinned by nested_outlines_follow_the_nonzero_winding_fill.

Refs #3072

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/geometry/src/outline_text/mod.rs | 54 ++++++++++++++++++++++++-
 crates/geometry/tests/outline_text.rs   | 32 +++++++++++++++
 2 files changed, 84 insertions(+), 2 deletions(-)

diff --git a/crates/geometry/src/outline_text/mod.rs b/crates/geometry/src/outline_text/mod.rs
index a60574d7c..1366fb723 100644
--- a/crates/geometry/src/outline_text/mod.rs
+++ b/crates/geometry/src/outline_text/mod.rs
@@ -8,8 +8,9 @@
 //!
 //! Contract. The shapes are in millimetres. The origin is the left end of the baseline, and
 //! `height` is the cap height of the font. Nothing is guessed: a font that cannot be read, a
-//! font with CFF outlines, a character the font does not have, and outlines that cross or
-//! touch are refused by name. The sketch that [`sketch`] returns has only closed chains, each
+//! font with CFF outlines, a character the font does not have, outlines that cross or touch,
+//! and a nested outline that runs in the same direction as the one around it (nonzero fill
+//! would make it filled, not a hole) are refused by name. The sketch that [`sketch`] returns has only closed chains, each
 //! with a clear nesting, or the call fails. This module has no file I/O and no application
 //! state.
 
@@ -82,6 +83,15 @@ pub enum OutlineTextError {
          or pick a font whose letters do not overlap"
     )]
     Shapes(String),
+    /// An outline inside another runs in the same direction as it. The font fills by the
+    /// nonzero winding rule, so the inner region is filled, not a hole: a nesting reading of
+    /// the shapes would cut the wrong region.
+    #[error(
+        "the outline near ({x:.3}, {y:.3}) mm is inside another outline that runs in the same \
+         direction, so the font fills it instead of making a hole: the shapes are not clear. \
+         Pick a different font"
+    )]
+    Winding { x: f64, y: f64 },
 }
 
 /// What to write: the font file's bytes, the string, the cap height in mm, and the extra gap
@@ -258,5 +268,45 @@ pub fn sketch(spec: &OutlineSpec) -> Result<SketchData, OutlineTextError> {
     if let Some(error) = chains.closed.iter().find_map(|chain| chain.nesting.as_ref().err()) {
         return Err(OutlineTextError::Shapes(error.to_string()));
     }
+    check_winding(&lines)?;
     Ok(data)
 }
+
+/// The font fills by the nonzero winding rule; the sketch reads holes by nesting (even-odd).
+/// The two agree only when each outline runs opposite to the innermost outline around it.
+/// Call this after the outlines are known not to cross or touch, so one vertex of an outline
+/// tells if another outline contains it.
+fn check_winding(lines: &[Vec<Point2>]) -> Result<(), OutlineTextError> {
+    let areas: Vec<f64> = lines.iter().map(|l| signed_area(l)).collect();
+    for (i, line) in lines.iter().enumerate() {
+        let Some(&p) = line.first() else { continue };
+        let parent = lines
+            .iter()
+            .enumerate()
+            .filter(|&(j, other)| j != i && areas[j].abs() > areas[i].abs() && contains(other, p))
+            .min_by(|a, b| areas[a.0].abs().total_cmp(&areas[b.0].abs()));
+        if let Some((j, _)) = parent
+            && areas[j].signum() == areas[i].signum()
+        {
+            return Err(OutlineTextError::Winding { x: p.x, y: p.y });
+        }
+    }
+    Ok(())
+}
+
+/// The shoelace area of a closed polyline: positive counterclockwise.
+fn signed_area(line: &[Point2]) -> f64 {
+    0.5 * line.windows(2).map(|w| w[0].x * w[1].y - w[1].x * w[0].y).sum::<f64>()
+}
+
+/// Is `p` inside the closed polyline `line` (crossing count of a ray to +x)?
+fn contains(line: &[Point2], p: Point2) -> bool {
+    let mut inside = false;
+    for w in line.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        if (a.y > p.y) != (b.y > p.y) && p.x < a.x + (p.y - a.y) * (b.x - a.x) / (b.y - a.y) {
+            inside = !inside;
+        }
+    }
+    inside
+}
diff --git a/crates/geometry/tests/outline_text.rs b/crates/geometry/tests/outline_text.rs
index e6d1603c7..85802466b 100644
--- a/crates/geometry/tests/outline_text.rs
+++ b/crates/geometry/tests/outline_text.rs
@@ -205,6 +205,38 @@ fn composite_offsets_use_the_component_transform() {
     );
 }
 
+/// Write the x coordinates of the eight points of `O` (outer box, then inner box) into the
+/// font as deltas. The y coordinates stay: each box keeps its corners, in a new direction.
+fn set_o_xs(font: &mut [u8], xs: [i16; 8]) {
+    let loca = table_offset(font, b"loca");
+    let glyph = u32::from_be_bytes(font[loca + 16..loca + 20].try_into().unwrap()) as usize;
+    // Header 10, two contour ends 4, instruction length 2, eight flags 8.
+    let at = table_offset(font, b"glyf") + glyph + 24;
+    let mut last = 0_i16;
+    for (k, x) in xs.into_iter().enumerate() {
+        font[at + 2 * k..at + 2 * k + 2].copy_from_slice(&(x - last).to_be_bytes());
+        last = x;
+    }
+}
+
+#[test]
+fn nested_outlines_follow_the_nonzero_winding_fill() {
+    let mut font = sample_font();
+    // The unchanged O: the box runs clockwise and its hole counterclockwise.
+    set_o_xs(&mut font, [0, 0, 600, 600, 450, 450, 150, 150]);
+    assert_eq!(roles(&font, "O"), (1, 1));
+    // The two directions swapped are still a box with a hole under nonzero fill.
+    set_o_xs(&mut font, [600, 600, 0, 0, 150, 150, 450, 450]);
+    assert_eq!(roles(&font, "O"), (1, 1));
+    // The inner box in the same direction as the outer one: nonzero fill makes it filled.
+    set_o_xs(&mut font, [0, 0, 600, 600, 150, 150, 450, 450]);
+    let err = sketch(&spec(&font, "O")).expect_err("a same-direction inner box is not a hole");
+    assert!(matches!(err, OutlineTextError::Winding { .. }), "{err}");
+    assert!(err.to_string().contains("runs in the same direction"), "{err}");
+    // Side by side, two outlines in the same direction stay two shapes.
+    assert_eq!(roles(&sample_font(), "II"), (2, 0));
+}
+
