From a9db53e3121b4dab8b77f9509fdb69ee8b194219 Mon Sep 17 00:00:00 2001
From: tbrasselle <tbrasselle@gmail.com>
Date: Sun, 22 Nov 2026 12:43:33 -0500
Subject: [PATCH] fix(ui): read the sketch height once for the Contour
 start/exit marks

The Lead tab start/exit marks resolved the draft top height outside the
display scope, so a Contour on a DXF sketch sampled the sketch Z span on
each frame. Wrap the resolve_height call in operation::display_heights,
so a still frame reads the frame memo (#3161). Pin it with a frame-cost
test: still frames build no sketch Z span and take no fresh read.

Fixes #3161
---
 .../src/egui_app/tests/contour_dxf_sketch.rs  | 37 +++++++++++++++++++
 crates/ui/src/start_exit_pick.rs              |  6 ++-
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/crates/ui/src/egui_app/tests/contour_dxf_sketch.rs b/crates/ui/src/egui_app/tests/contour_dxf_sketch.rs
index 153263d99..f12eb5dbb 100644
--- a/crates/ui/src/egui_app/tests/contour_dxf_sketch.rs
+++ b/crates/ui/src/egui_app/tests/contour_dxf_sketch.rs
@@ -314,3 +314,40 @@ fn sketch_frame_caches_skip_still_frames_and_track_changed_inputs() {
     harness.run_steps(2);
     assert_fresh(&harness);
 }
+
+#[test]
+fn start_exit_marks_read_the_sketch_height_through_the_display_memo() {
+    // #3161: the Lead tab's start/exit marks are a display read. A still
+    // frame must not resample a DXF sketch's Z span.
+    let mut st = sketch_shell().state;
+    if let OpParams::Contour { top_z, .. } = &mut st.op_ui.params {
+        *top_z = Height::of(HeightReference::TopOfSelection, 0.0);
+    }
+    st.ui_target = UiTarget::Operation("Contour1".into());
+    st.sync_ops_ui();
+    st.op_tab = crate::egui_app::op_tabs::SEC_LEADS;
+    st.properties_shown = true;
+
+    let z_prime = operation::sketch_z_builds();
+    let _ = crate::start_exit_pick::marks(&st, 1.5);
+    assert!(
+        operation::sketch_z_builds() > z_prime,
+        "the marks resolve the sketch height through the memo"
+    );
+
+    let z0 = operation::sketch_z_builds();
+    let f0 = operation::sketch_z_fresh_reads();
+    for _ in 0..3 {
+        let _ = crate::start_exit_pick::marks(&st, 1.5);
+    }
+    assert_eq!(
+        operation::sketch_z_builds() - z0,
+        0,
+        "a still frame resamples no sketch Z span"
+    );
+    assert_eq!(
+        operation::sketch_z_fresh_reads() - f0,
+        0,
+        "a still frame takes no authoritative sketch Z read"
+    );
+}
diff --git a/crates/ui/src/start_exit_pick.rs b/crates/ui/src/start_exit_pick.rs
index 1cf2a2aaa..c994a66e0 100644
--- a/crates/ui/src/start_exit_pick.rs
+++ b/crates/ui/src/start_exit_pick.rs
@@ -157,7 +157,11 @@ pub(crate) fn marks(state: &State, aspect: f64) -> (Vec<Seg>, Vec<Seg>) {
     else {
         return (start_segs, exit_segs);
     };
-    let Some(z) = operation::resolve_height(&state.world, op.setup.as_deref(), Some(&op.src), *top_z) else {
+    // A display read (#3161): inside this scope a DXF sketch's Z span
+    // reads the frame memo, so a still frame does not resample the sketch.
+    let Some(z) = operation::display_heights(|| {
+        operation::resolve_height(&state.world, op.setup.as_deref(), Some(&op.src), *top_z)
+    }) else {
         return (start_segs, exit_segs);
     };
     let mvp = state.cam.mvp(aspect);
