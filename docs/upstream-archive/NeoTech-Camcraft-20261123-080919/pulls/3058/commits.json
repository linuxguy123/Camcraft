    "node_id": "C_kwDOVoU8JdoAKDI5MDc3OGNhODE5YjE2ZDZlMmNmNTY5NDc2YTdhMDUyZDUyYWUxY2Q",
    "commit": {
      "author": {
        "name": "Mike Kinney",
