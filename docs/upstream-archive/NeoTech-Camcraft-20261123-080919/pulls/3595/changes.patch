diff --git a/crates/sim/src/verify/reach_reference.rs b/crates/sim/src/verify/reach_reference.rs
new file mode 100644
index 000000000..7e6aa23a2
--- /dev/null
+++ b/crates/sim/src/verify/reach_reference.rs
@@ -0,0 +1,262 @@
+//! The pre-#3588 law (c)/(c3) band reach, kept verbatim as a test-only reference for the equivalence pins of the indexed `band_reach` - our own code, moved from `reach.rs` (#3588).
+
+use super::laws::{boundary_samples, dist2_seg, law_points};
+use super::reach::ReachStats;
+use super::rest::Rest;
+use super::types::{Mode, VerifyContext, Warning};
+
+use super::upright::is_upright;
+use crate::cl::{MoveKind, Toolpath};
+use crate::geo2d::{Point2, Region};
+
+/// The old law (c) and (c3), line for line as `reach.rs` held it before
+/// #3588: every move against the pooled samples of every plane. Only
+/// two counters are added (`stats`); no verdict line is changed.
+pub(super) fn band_reach_reference(
+    path: &Toolpath,
+    cx: &VerifyContext,
+    rest: &Rest,
+    chord_tol: f64,
+    warns: &mut Vec<Warning>,
+) -> ReachStats {
+    let mut stats = ReachStats::default();
+    let r = cx.tool.radius;
+    // The kerf slack and the band growth on a coarse model (#904).
+    let (kerf_tol, grow) = (cx.tightened(cx.gouge_tol), cx.band_growth());
+    // Deepest plane the path cuts at (drives the island law of the
+    // reach samples and the part label below).
+    let z_deepest = path
+        .moves
+        .iter()
+        .filter(|m| m.kind != MoveKind::Rapid)
+        .map(|m| m.from.z.min(m.to.z))
+        .fold(f64::INFINITY, f64::min);
+
+    // The band stack, law (c) and its fixture twin (c2) both read -
+    // [ (bottom offset above the cut, radius, length) ] for shank, then
+    // what stands above it: the holder cylinder, or a modelled body's
+    // own bands (#835) - the very stack (c2) sweeps and the simulation
+    // draws, never the cylinder enclosing it. Each group convicts a
+    // move once, the worst offender over its bands, so a body's many
+    // bands report as the one holder they stand for.
+    // #852: a necked tool's shank is its drawn neck's bands, never
+    // wider than the stated cylinder; no neck reads that cylinder.
+    let judged = super::Cutter::judged(cx.tool, cx.cutter);
+    let shank = judged.shank_bands();
+    let holder = judged.holder_bands();
+    let groups: [&[(f64, f64, f64)]; 2] = [&shank, &holder];
+    let bands: Vec<(f64, f64, f64)> = groups.concat();
+
+    // #1444: an undercut path's bands answer to the undercut law.
+    if cx.mode == Mode::Undercut {
+        return stats;
+    }
+    if !matches!(cx.mode, Mode::Engrave | Mode::Carve | Mode::Radial | Mode::Rotary) {
+        // Both boundaries matter: the region's loops carry the part
+        // islands (holes in the region), the stock's carry its outer
+        // walls wherever they stand beyond the region. A model-driven
+        // path's islands are not holes in its silhouette region - they
+        // are computed per plane - so their walls join the sample set
+        // at every plane the ladder cuts at (M2.1a). The part flag
+        // follows the law that keeps them out of the cut: a column
+        // inside the deepest section is material the ladder swore
+        // never to chase below, stair left by a shallower pass
+        // notwithstanding - reported part, worst case.
+        let mut samples = boundary_samples(cx.region);
+        if let Some(s) = cx.stock {
+            samples.extend(boundary_samples(s));
+        }
+        if let Some(f) = cx.model {
+            let mut zs: Vec<u64> = rest.cut().iter().map(|c| c.2.to_bits()).collect();
+            zs.sort_unstable();
+            zs.dedup();
+            for k in zs {
+                stats.slices += 1;
+                if let Some(s) = rest.islands_at(f, f64::from_bits(k)) {
+                    samples.extend(boundary_samples(&s));
+                }
+            }
+        }
+        let deepest_island: Option<Option<Region>> =
+            cx.model.map(|f| rest.islands_at(f, z_deepest));
+        let part_at = |q: Point2| -> bool {
+            !cx.region.contains(q)
+                || deepest_island
+                    .as_ref()
+                    .and_then(|o| o.as_ref())
+                    .is_some_and(|s| s.contains(q))
+        };
+        let in_stock = |q: Point2| -> bool { rest.in_stock(q) };
+        // Cut order (M13.7): a band at move i meets the stock the cuts
+        // up to and including move i left - its own flute cuts beneath
+        // it, a later move's clearing is no alibi.
+        let surface = |q: Point2, upto: usize| -> f64 { rest.surface_before(q, upto) };
+        // Pose (M5.1 stage A): a leaning band is enclosed, exactly as
+        // in [`super::bands_vs_fixtures`], in a vertical column that is
+        // never smaller - shifted to the band's mid-height point on the
+        // leaning axis, widened by its half-length's horizontal spread,
+        // its bottom standing at the lower of the two axis-plane ends
+        // minus the rim's exact dip, RÂ·sin Î¸ ([`super::tilt_band`],
+        // #1303: the band's true lowest point, so the reading meets
+        // the upright one as the tilt goes to nothing - it was the
+        // whole radius, a cliff just above the upright tolerance).
+        // The annulus's inner edge stays about
+        // the TIP: the flute's kerf excuses that radius wherever the
+        // tip cuts, tilt or no tilt. Over-report a graze, never hide a
+        // gouge. The prismatic branch is the law's own history: same
+        // h0, same r2, point p unshifted.
+        // Moves law (c) convicted, for law (c3) below: a mid-turn
+        // sweep of the same band on the same move is the same event
+        // reported twice, and (c)'s verdict stands - when (c) already
+        // named the part (`shanked_part`, the worst there is). A move
+        // (c) convicted for stock only still has its sweep asked: a
+        // swing through the PART is a worse event than the stock (c)
+        // saw, and is never hidden behind it (#835 review); a stock-
+        // only sweep on such a move is the same event and is dropped.
+        let mut shanked: Vec<usize> = Vec::new();
+        let mut shanked_part: Vec<usize> = Vec::new();
+        for (i, m) in path.moves.iter().enumerate() {
+            if m.kind == MoveKind::Rapid {
+                continue;
+            }
+            let pts = law_points(m, chord_tol);
+            let lean = m.axis.filter(|a| !is_upright(a));
+            // Law (c)'s own last report for THIS move: the de-duplication
+            // below never merges with a warning an earlier law pushed.
+            let mut reported: Option<bool> = None;
+            for group in groups {
+                let mut convicted: Option<bool> = None;
+                for &(above, band_r, band_len) in group {
+                    if convicted == Some(true) {
+                        break; // the worst offender is already named
+                    }
+                    // A band within the cutter's radius stands in the
+                    // flutes' own kerf - upright only. Leaning, it stands
+                    // off the tip's column like any other band and is
+                    // judged, the tip-centred kerf below excusing just
+                    // the flutes' cut (#903: a plain or necked shank).
+                    if band_len <= 0.0 || band_r <= 0.0 || (lean.is_none() && band_r <= r) {
+                        continue;
+                    }
+                    let (offx, offy, r_band, h0) = match lean {
+                        None => (0.0, 0.0, band_r, m.to.z + above),
+                        Some(a) => {
+                            let col = super::tilt_band::lean(&a, above, band_r, band_len);
+                            (col.off.0, col.off.1, col.r, m.to.z + col.lo - col.dip)
+                        }
+                    };
+                    // Z-window skip (M2.5 E): the law convicts only where
+                    // `h0 < surface(q)`, and no column's surface stands
+                    // above the stock top (`surface` ends in that `min`,
+                    // and a cleared column cannot exceed the stock it was
+                    // cut from). A band whose bottom stands at or above
+                    // the ceiling has nothing to meet in any column -
+                    // this is the same predicate read one step earlier,
+                    // not an approximation: the old loop asked every
+                    // sample's annulus to learn the answer it could see
+                    // in the band's own numbers. A continuous-Z path (a
+                    // flow line) multiplies that blind ask by its plane
+                    // count; on a level ladder the test rarely fires.
+                    if h0 >= cx.stock_top_z {
+                        continue;
+                    }
+                    // #904: on a model coarser than promised the band
+                    // reaches the excess further and the flutes' kerf
+                    // excuses that much less - a convex wall may stand
+                    // that far outside the facets these samples sit on.
+                    let r2 = (r_band + grow + 1e-9) * (r_band + grow + 1e-9);
+                    let kerf2 = (r + kerf_tol) * (r + kerf_tol);
+                    let mut hit = None;
+                    'worst: {
+                        for p in &pts {
+                            // The band's disc stands at `pc`; the kerf the
+                            // flutes cleared stands at the TIP `p` (#903):
+                            // on a leaning move they part, and the disc
+                            // under the band is steel's, not the cut's.
+                            let pc = Point2::new(p.x + offx, p.y + offy);
+                            let tip = Point2::new(p.x, p.y);
+                            for q in &samples {
+                                stats.sample_tests += 1;
+                                if dist2_seg(*q, pc, pc) > r2 || dist2_seg(*q, tip, tip) <= kerf2 {
+                                    continue; // outside this band's annulus
+                                }
+                                if !in_stock(*q) {
+                                    continue;
+                                }
+                                if h0 < surface(*q, i + 1) {
+                                    hit = Some(part_at(*q));
+                                    if hit == Some(true) {
+                                        break 'worst; // report the worst offender
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    // The overhang backstop (M13.7 B): stock hidden under a
+                    // ledge stands outside every plane section, so no sample
+                    // above sees it - asked only where the section law found
+                    // nothing, it can add a conviction, never remove one.
+                    if hit.is_none()
+                        && pts.iter().any(|p| {
+                            let pc = Point2::new(p.x + offx, p.y + offy);
+                            let tip = Point2::new(p.x, p.y);
+                            rest.hidden_in_annulus(pc, tip, r + kerf_tol, r_band + grow, h0, i + 1)
+                        })
+                    {
+                        hit = Some(false);
+                    }
+                    if let Some(part) = hit {
+                        convicted = Some(convicted.unwrap_or(false) || part);
+                    }
+                }
+                if let Some(part) = convicted {
+                    shanked.push(i);
+                    if part {
+                        shanked_part.push(i);
+                    }
+                    // One move, one report per verdict (#938): a leaning
+                    // shank and holder both in the part are one event.
+                    if reported != Some(part) {
+                        reported = Some(part);
+                        warns.push(Warning::ShankHit { at: i, part });
+                    }
+                }
+            }
+        }
+
+        // (c3) The mid-turn sweep (M5.1 stage G): the reachable set
+        // between a move's commanded poses, on the grid and column
+        // laws of [`super::sweep`]. It runs exactly where its twin (c)
+        // runs - the same domain, the turn-aware reading - and the
+        // price stays honest because every posed kind verifies as
+        // Envelope: law (f) measures the BALL, rotation-invariant and
+        // pose-blind, and the POSE question of those programs is the
+        // band stack's, (c) and (c3) together. The sweep's per-move
+        // sample-union filter keeps the grid from costing twenty times
+        // on far-field samples. Engrave never poses. Paths no posed
+        // generator ever touched hold every pose at home and convict
+        // nothing, exactly as before this law existed.
+        if !matches!(cx.mode, Mode::Engrave | Mode::Carve) {
+            let columns = super::hidden_span::Columns::new(None);
+            let sweeps = super::sweep::mid_turn_sweeps(
+                path,
+                &bands,
+                r,
+                (kerf_tol, grow),
+                chord_tol,
+                &shanked_part,
+                &samples,
+                &in_stock,
+                &|q: Point2| rest.surface_steps(q),
+                &part_at,
+                &|bx, h, probes, heights, upto| rest.hidden_in_cover(bx, h, probes, heights, upto, &columns),
+            );
+            warns.extend(
+                sweeps
+                    .into_iter()
+                    .filter(|w| !matches!(w, Warning::SweepHit { at, part: false } if shanked.contains(at))),
+            );
+        }
+    }
+    stats
+}
diff --git a/crates/sim/src/verify/reach_tests.rs b/crates/sim/src/verify/reach_tests.rs
new file mode 100644
index 000000000..73bb19e8e
--- /dev/null
+++ b/crates/sim/src/verify/reach_tests.rs
@@ -0,0 +1,169 @@
+//! #3588: law (c)/(c3) band reach on an indexed sample set gives the findings of the old pooled scan, and its cost grows with the moves, not with moves x planes - our own fixtures.
+//!
+//! Gate map (#3588): covers camcraft_sim::verify (reach, sample_grid).
+
+use super::reach::{ReachStats, band_reach_counted};
+use super::reach_reference::band_reach_reference;
+use super::rest::Rest;
+use super::types::{Mode, ToolGeom, VerifyContext, Warning};
+use crate::cl::{Move, MoveKind, Toolpath};
+use crate::geo2d::{Loop, Point2, Region};
+use crate::geometry::{Point3, Triangle, cube};
+
+fn square(x0: f64, y0: f64, x1: f64, y1: f64) -> Region {
+    let pts = vec![Point2::new(x0, y0), Point2::new(x1, y0), Point2::new(x1, y1), Point2::new(x0, y1)];
+    match Loop::new(pts).and_then(|l| Region::new(vec![l])) {
+        Ok(r) => r,
+        Err(e) => panic!("region: {e:?}"),
+    }
+}
+
+/// A 6 mm cutter, a 10 mm shank 5 mm over the tip, a 30 mm holder.
+fn tool() -> ToolGeom {
+    ToolGeom { radius: 3.0, nose_radius: 0.0, flute_len: 5.0, shank_radius: 5.0, shank_len: 20.0, holder_radius: 15.0, holder_len: 30.0 }
+}
+
+/// A 20 mm boss (Z 0..10) on a 2 mm floor plate, in a 100 mm pocket.
+fn model() -> Vec<Triangle> {
+    let mut f = cube(Point3::new(0.0, 0.0, -2.0), Point3::new(100.0, 100.0, 0.0)).facets.to_vec();
+    f.extend(cube(Point3::new(40.0, 40.0, 0.0), Point3::new(60.0, 60.0, 10.0)).facets.iter().cloned());
+    f
+}
+
+fn feed(a: (f64, f64, f64), b: (f64, f64, f64)) -> Move {
+    Move::new(MoveKind::Feed, Point3::new(a.0, a.1, a.2), Point3::new(b.0, b.1, b.2), Some(500.0))
+}
+
+/// Run the new law and the old one, each on its own rest model (the
+/// island cache is per rest, so each pays its own slices).
+fn both(moves: Vec<Move>, mode: Mode) -> ((Vec<Warning>, ReachStats), (Vec<Warning>, ReachStats)) {
+    let (region, model, tool) = (square(0.0, 0.0, 100.0, 100.0), model(), tool());
+    let cx = VerifyContext {
+        region: &region,
+        stock: Some(&region),
+        model: Some(&model),
+        tool: &tool,
+        mode,
+        stock_top_z: 10.0,
+        clearance_z: 30.0,
+        gouge_tol: 0.01,
+        z_tol: 1e-6,
+        ..Default::default()
+    };
+    let path = Toolpath { moves, ..Toolpath::default() };
+    let mut new = Vec::new();
+    let s_new = band_reach_counted(&path, &cx, &Rest::new(&path, &cx, cx.gouge_tol, &[]), cx.gouge_tol, &mut new);
+    let mut old = Vec::new();
+    let s_old = band_reach_reference(&path, &cx, &Rest::new(&path, &cx, cx.gouge_tol, &[]), cx.gouge_tol, &mut old);
+    ((new, s_new), (old, s_old))
+}
+
+/// A ramp of `n` short moves along one straight pass at Y 34 (the
+/// tool's rim 3 mm from the boss wall, the shank's 2 mm short of it),
+/// X 10 to 90 and Z 9 down to Z 1 (a 5.7 degree ramp): every move
+/// ends at its own Z.
+fn ramp(n: usize) -> Vec<Move> {
+    ramp_at(n, 34.0)
+}
+
+/// The same ramp at Y `y`.
+fn ramp_at(n: usize, y: f64) -> Vec<Move> {
+    let (dz, dx) = (8.0 / n as f64, 80.0 / n as f64);
+    (0..n)
+        .map(|k| {
+            let (a, b) = (k as f64, (k + 1) as f64);
+            feed((10.0 + a * dx, y, 9.0 - a * dz), (10.0 + b * dx, y, 9.0 - b * dz))
+        })
+        .collect()
+}
+
+/// Square rings round the boss at four levels, `gap` mm from its walls,
+/// four moves a side (the law reads a straight move at its end).
+fn levels(gap: f64) -> Vec<Move> {
+    let (lo, hi) = (40.0 - 3.0 - gap, 60.0 + 3.0 + gap);
+    let corners = [(lo, lo), (hi, lo), (hi, hi), (lo, hi), (lo, lo)];
+    let mut v = Vec::new();
+    for z in [8.0, 6.0, 4.0, 2.0] {
+        for w in corners.windows(2) {
+            let (a, b) = (w[0], w[1]);
+            for k in 0..4 {
+                let at = |t: f64| (a.0 + (b.0 - a.0) * t, a.1 + (b.1 - a.1) * t, z);
+                v.push(feed(at(k as f64 / 4.0), at((k + 1) as f64 / 4.0)));
+            }
+        }
+    }
+    v
+}
+
+/// A helix of 3 turns round the boss centre, 72 chords a turn.
+fn helix() -> Vec<Move> {
+    let (c, rad, n) = (50.0, 20.0, 216);
+    let at = |k: usize| {
+        let t = k as f64 / 72.0 * std::f64::consts::TAU;
+        (c + rad * t.cos(), c + rad * t.sin(), 9.0 - 7.0 * k as f64 / n as f64)
+    };
+    (0..n).map(|k| feed(at(k), at(k + 1))).collect()
+}
+
+fn assert_same(name: &str, moves: Vec<Move>, mode: Mode) -> (Vec<Warning>, ReachStats, ReachStats) {
+    let ((new, s_new), (old, s_old)) = both(moves, mode);
+    assert_eq!(new, old, "{name}: the findings and their order must not move");
+    assert_eq!(s_new.slices, s_old.slices, "{name}: one slice per plane, as before");
+    assert!(s_new.sample_tests <= s_old.sample_tests, "{name}: {s_new:?} vs {s_old:?}");
+    (new, s_new, s_old)
+}
+
+#[test]
+fn indexed_band_reach_keeps_every_finding_of_the_pooled_scan() {
+    assert_same("levels clear", levels(3.0), Mode::Area);
+    assert_same("helix", helix(), Mode::Area);
+    assert_same("ramp", ramp(400), Mode::Area);
+    assert_same("boundary mode", levels(3.0), Mode::Boundary);
+    // A real finding: rings 1 mm off the boss walls put the 5 mm shank
+    // (bottom 5 mm over the tip, under the boss top below Z 5) in the
+    // boss - the part. Both laws must name the same moves.
+    let (hits, _, _) = assert_same("levels hit", levels(1.0), Mode::Area);
+    assert!(hits.iter().any(|w| matches!(w, Warning::ShankHit { part: true, .. })), "{hits:?}");
+    // Leaning moves whose pose changes every move run the sweep (c3).
+    let mut posed = levels(1.0);
+    for (k, m) in posed.iter_mut().enumerate() {
+        m.axis = Some(if k % 2 == 0 { [0.2, 0.0, 1.0] } else { [0.0, 0.2, 1.0] });
+    }
+    let (posed_hits, _, _) = assert_same("posed", posed, Mode::Area);
+    assert!(!posed_hits.is_empty(), "the leaning rings meet the boss");
+}
+
+#[test]
+fn degenerate_paths_match_the_pooled_scan_and_do_not_panic() {
+    assert_same("empty", Vec::new(), Mode::Area);
+    let mut bad = levels(1.0);
+    bad.push(feed((30.0, 30.0, f64::NAN), (31.0, 30.0, f64::NAN)));
+    bad.push(feed((f64::NAN, 30.0, 2.0), (31.0, f64::INFINITY, 2.0)));
+    assert_same("non-finite", bad, Mode::Area);
+}
+
+#[test]
+fn a_many_plane_ramp_reads_only_the_samples_near_its_discs() {
+    let (_, short_new, short_old) = assert_same("ramp 500", ramp(500), Mode::Area);
+    let (_, long_new, long_old) = assert_same("ramp 2000", ramp(2000), Mode::Area);
+    eprintln!("ramp 500: new {short_new:?}, old {short_old:?}");
+    eprintln!("ramp 2000: new {long_new:?}, old {long_old:?}");
+    // One slice per distinct plane: linear in the moves of a ramp.
+    assert!(long_new.slices <= 2001, "{long_new:?}");
+    // The old scan paid moves x planes x samples (about sixteen times
+    // for four times the moves); a disc clear of every wall reads at
+    // most a few samples a move.
+    assert!(long_old.sample_tests >= 15 * short_old.sample_tests, "{short_old:?} -> {long_old:?}");
+    assert!(long_new.sample_tests <= 2000, "{long_new:?}");
+    // A ramp whose shank reaches the boss wall (Y 36: the shank's rim
+    // 1 mm into it) must read that wall's samples of EVERY plane - the
+    // law reads no sample's plane, and each plane's section puts its
+    // own vertices on the wall. Exactness keeps that growth; the index
+    // only drops the samples no disc can hold, a fixed large share.
+    let (short_hits, s_new, s_old) = assert_same("wall ramp 500", ramp_at(500, 36.0), Mode::Area);
+    let (long_hits, l_new, l_old) = assert_same("wall ramp 2000", ramp_at(2000, 36.0), Mode::Area);
+    eprintln!("wall ramp 500: new {s_new:?}, old {s_old:?}; wall ramp 2000: new {l_new:?}, old {l_old:?}");
+    assert!(!short_hits.is_empty() && !long_hits.is_empty(), "the shank meets the boss");
+    assert!(s_new.sample_tests > 0, "{s_new:?}");
+    assert!(20 * l_new.sample_tests <= l_old.sample_tests, "{l_new:?} vs {l_old:?}");
+}
