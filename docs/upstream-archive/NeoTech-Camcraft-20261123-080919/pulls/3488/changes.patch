@@ -0,0 +1,231 @@
+//! The tool meridian (#3367): the cutting outline rho(z) of a rotating
+//! cutter, tip up, as lines and circular arcs, and its split into convex
+//! solids of revolution - elementary plane geometry (chord sag
+//! R (1 - cos(theta / 2))) and convexity of a revolved concave profile
+//! (Boyd and Vandenberghe, Convex Optimization, 3.2.5). The point form
+//! is the spun profile's ([`SpunPoint`]); the tip shapes are the
+//! machine-tool handbook side views [`Tool::profile`] draws. Our own
+//! design; no vendor source or file consulted.
+//!
+//! One shape for every consumer: the solid law, the simulation and the
+//! generators read a tool through its meridian (later sub-issues of
+//! #3351). A segment that is a pilot bearing band is flagged
+//! non-cutting; it still occupies space.
+
+use crate::spun::SpunPoint;
+use crate::tools::{Tool, ToolKind};
+use crate::undercut;
+
+#[path = "meridian_atoms.rs"]
+mod atoms;
+pub use atoms::{AtomShape, Bound, MeridianAtom, MAX_SPLIT};
+
+/// Shortest segment (mm) a meridian may have: under it, the segment is
+/// a duplicated point, not a shape.
+pub const MIN_LEN: f64 = 1e-6;
+/// Slack (mm) on the order and fold checks: float dust only.
+pub(crate) const EPS: f64 = 1e-9;
+
+/// Why a meridian is refused. Point numbers are 1-based; a segment is
+/// numbered by the point it starts from.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum MeridianError {
+    TooFew,
+    NonFinite(usize),
+    Negative(usize),
+    Short(usize),
+    ArcTooTight(usize),
+    ArcFolds(usize),
+    RunsBack(usize),
+    FlagCount,
+    BadSag,
+    SagTooFine(usize),
+    NotAMill(ToolKind),
+    Unsound(String),
+}
+
+impl core::fmt::Display for MeridianError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::TooFew => write!(f, "a tool meridian needs at least 2 points"),
+            Self::NonFinite(i) => write!(f, "meridian point {i} is not a finite number"),
+            Self::Negative(i) => write!(f, "meridian point or segment {i} has a negative radius"),
+            Self::Short(i) => write!(f, "the meridian segment from point {i} is shorter than {MIN_LEN} mm"),
+            Self::ArcTooTight(i) => write!(f, "the meridian arc from point {i} has a radius smaller than half its chord"),
+            Self::ArcFolds(i) => write!(f, "the meridian arc from point {i} turns back along the tool axis"),
+            Self::RunsBack(i) => write!(f, "the meridian segment from point {i} runs back down the tool axis"),
+            Self::FlagCount => write!(f, "a tool meridian needs one cutting flag for each segment"),
+            Self::BadSag => write!(f, "the sag limit of an arc split must be a finite number over 0 mm"),
+            Self::SagTooFine(i) => {
+                write!(f, "the arc from meridian point {i} needs more than {MAX_SPLIT} parts for this sag limit")
+            }
+            Self::NotAMill(k) => write!(f, "a {k} has no milling meridian"),
+            Self::Unsound(why) => f.write_str(why),
+        }
+    }
+}
+
+impl std::error::Error for MeridianError {}
+
+/// A validated meridian: points from the tip up, each segment a line or
+/// an arc (the [`SpunPoint`] law: `arc` signed, positive bulges away
+/// from the axis), with one cutting flag for each segment.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Meridian {
+    points: Vec<SpunPoint>,
+    cutting: Vec<bool>,
+}
+
+impl Meridian {
+    /// Validate an outline. Refuses by name: fewer than 2 points, a flag
+    /// count that is not the segment count, a non-finite number, a
+    /// negative radius (at a point or inside a concave arc), a segment
+    /// under [`MIN_LEN`], an arc tighter than its chord, an arc that is
+    /// not a function of z, a segment that runs back down the axis.
+    pub fn new(points: Vec<SpunPoint>, cutting: Vec<bool>) -> Result<Self, MeridianError> {
+        if points.len() < 2 {
+            return Err(MeridianError::TooFew);
+        }
+        if cutting.len() + 1 != points.len() {
+            return Err(MeridianError::FlagCount);
+        }
+        for (i, p) in points.iter().enumerate() {
+            if !(p.z.is_finite() && p.r.is_finite() && p.arc.is_finite()) {
+                return Err(MeridianError::NonFinite(i + 1));
+            }
+            if p.r < 0.0 {
+                return Err(MeridianError::Negative(i + 1));
+            }
+        }
+        for (i, w) in points.windows(2).enumerate() {
+            check_segment(w[0], w[1], i + 1)?;
+        }
+        Ok(Self { points, cutting })
+    }
+
+    #[must_use]
+    pub fn points(&self) -> &[SpunPoint] {
+        &self.points
+    }
+
+    /// One flag for each segment: true where the edge cuts.
+    #[must_use]
+    pub fn cutting(&self) -> &[bool] {
+        &self.cutting
+    }
+}
+
+fn check_segment(a: SpunPoint, b: SpunPoint, i: usize) -> Result<(), MeridianError> {
+    let (dz, dr) = (b.z - a.z, b.r - a.r);
+    let len = dz.hypot(dr);
+    if len.is_nan() || len < MIN_LEN {
+        return Err(MeridianError::Short(i));
+    }
+    if dz < -EPS {
+        return Err(MeridianError::RunsBack(i));
+    }
+    if a.arc == 0.0 {
+        return Ok(());
+    }
+    if a.arc.abs() < len * 0.5 - EPS {
+        return Err(MeridianError::ArcTooTight(i));
+    }
+    let g = atoms::ArcGeom::of(a, b).ok_or(MeridianError::ArcTooTight(i))?;
+    // A convex arc lies on the circle's far half from the axis, a
+    // concave one on its near half: only then is it a function of z.
+    let side = |r: f64| if g.convex() { r >= g.c.1 - EPS } else { r <= g.c.1 + EPS };
+    if !(side(a.r) && side(b.r)) {
+        return Err(MeridianError::ArcFolds(i));
+    }
+    // The near half reaches rc - R where its z range holds the centre.
+    if !g.convex() && a.z <= g.c.0 && g.c.0 <= b.z && g.c.1 - g.rad < -EPS {
+        return Err(MeridianError::Negative(i));
+    }
+    Ok(())
+}
+
+impl Tool {
+    /// The cutting meridian of a mill kind, from its numbers: the tip
+    /// face, the ball, corner or point, and the flute side to
+    /// `flute_len` (a lollipop's whole ball, to its pole). Each segment
+    /// cuts. It agrees with [`Tool::profile`] on the cutting band, and
+    /// its atoms are the solids the solid law builds for the cutter. A
+    /// kind that is no mill, or numbers that make no tool, are refused
+    /// by name.
+    pub fn meridian(&self) -> Result<Meridian, MeridianError> {
+        let (r, fl) = (self.diameter * 0.5, self.flute_len);
+        let line = SpunPoint::line;
+        let square = vec![line(0.0, 0.0), line(0.0, r), line(fl, r)];
+        let pts = match self.kind {
+            ToolKind::EndMill => square,
+            ToolKind::BallNose => tip_arc(r, r, fl),
+            ToolKind::BullNose => {
+                let cr = self.corner_r;
+                if cr.is_finite() && r.is_finite() && cr > r + EPS {
+                    return Err(MeridianError::Unsound(format!(
+                        "a bull-nose corner radius {cr} mm is over half its {} mm diameter",
+                        self.diameter
+                    )));
+                }
+                if cr > 0.0 { tip_arc(r, cr, fl) } else { square }
+            }
+            ToolKind::Drill | ToolKind::Taper => {
+                let tan = (self.tip_angle.to_radians() * 0.5).tan();
+                if self.tip_angle > 0.0 && tan.is_finite() && tan > 0.0 {
+                    let top = (r / tan).min(fl);
+                    let mut p = vec![line(0.0, 0.0), line(top, top * tan)];
+                    if fl > top {
+                        p.push(line(fl, r));
+                    }
+                    p
+                } else {
+                    square
+                }
+            }
+            ToolKind::TSlot | ToolKind::Keyseat | ToolKind::Dovetail | ToolKind::Lollipop => {
+                if let Some(why) = undercut::refusal(self) {
+                    return Err(MeridianError::Unsound(why));
+                }
+                match self.kind {
+                    ToolKind::Lollipop => vec![SpunPoint { z: 0.0, r: 0.0, arc: r }, line(2.0 * r, 0.0)],
+                    ToolKind::Dovetail => {
+                        let cot = 1.0 / self.tip_angle.to_radians().tan();
+                        vec![line(0.0, 0.0), line(0.0, r), line(fl, r - fl * cot)]
+                    }
+                    _ => square,
+                }
+            }
+            k => return Err(MeridianError::NotAMill(k)),
+        };
+        let n = pts.len().saturating_sub(1);
+        Meridian::new(pts, vec![true; n])
+    }
+}
+
+/// A rounded tip: the flat face to `r - cr`, the corner arc of radius
+/// `cr` (centre `cr` above the tip), the flute side to `fl`. A flute
+/// shorter than the corner ends the arc at `fl`, as the solid law does.
+fn tip_arc(r: f64, cr: f64, fl: f64) -> Vec<SpunPoint> {
+    let flat = r - cr;
+    let mut p = vec![SpunPoint::line(0.0, 0.0)];
+    if flat > 0.0 {
+        p.push(SpunPoint::line(0.0, flat));
+    }
+    if let Some(first) = p.last_mut() {
+        first.arc = cr;
+    }
+    if fl >= cr {
+        p.push(SpunPoint::line(cr, r));
+        if fl > cr {
+            p.push(SpunPoint::line(fl, r));
+        }
+    } else {
+        let e = cr - fl;
+        p.push(SpunPoint::line(fl, flat + (cr * cr - e * e).max(0.0).sqrt()));
+    }
+    p
+}
+
+#[cfg(test)]
+#[path = "meridian_tests.rs"]
+mod tests;
diff --git a/crates/tools/src/meridian_atoms.rs b/crates/tools/src/meridian_atoms.rs
new file mode 100644
index 000000000..0c4f6c919
--- /dev/null
+++ b/crates/tools/src/meridian_atoms.rs
@@ -0,0 +1,179 @@
+//! The tool meridian's split into convex atoms (#3367): a line is a
+//! frustum, an arc that bulges away from the axis a torus zone, an arc
+//! that bulges toward it chord frusta (outer bound) or tangent frusta
+//! (inner bound) under a sag limit - chord sag R (1 - cos(theta / 2)),
+//! tangent stand-off R (1 / cos(theta / 2) - 1), elementary plane
+//! geometry; a revolved concave profile is convex (Boyd and
+//! Vandenberghe, Convex Optimization, 3.2.5). Our own design.
+
+use super::{Meridian, MeridianError, EPS};
+use crate::spun::SpunPoint;
+
+/// Most frusta one concave arc splits into.
+pub const MAX_SPLIT: usize = 4096;
+
+/// Which side of a concave arc the split keeps.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Bound {
+    /// Chord frusta: their union contains the arc's solid.
+    Outer,
+    /// Tangent frusta: their union stays inside the arc's solid.
+    Inner,
+}
+
+/// The radius profile of one atom.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum AtomShape {
+    /// rho goes linearly from `r0` at `z0` to `r1` at `z1`.
+    Frustum { r0: f64, r1: f64 },
+    /// rho = rc + sqrt(rad^2 - (z - zc)^2): a torus zone (a sphere zone
+    /// when `rc` is 0).
+    Zone { zc: f64, rc: f64, rad: f64 },
+}
+
+/// One convex solid of revolution about the tool axis over `[z0, z1]`
+/// (its rho is concave in z), with the cutting flag of the segment it
+/// comes from.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct MeridianAtom {
+    pub z0: f64,
+    pub z1: f64,
+    pub shape: AtomShape,
+    pub cutting: bool,
+}
+
+impl MeridianAtom {
+    /// The radius at height `z`, read at the nearer end outside the span.
+    #[must_use]
+    pub fn rho(&self, z: f64) -> f64 {
+        let z = z.clamp(self.z0, self.z1);
+        match self.shape {
+            AtomShape::Frustum { r0, r1 } => {
+                let h = self.z1 - self.z0;
+                if h > 0.0 { r0 + (r1 - r0) * (z - self.z0) / h } else { r0.max(r1) }
+            }
+            AtomShape::Zone { zc, rc, rad } => {
+                let e = z - zc;
+                rc + (rad * rad - e * e).max(0.0).sqrt()
+            }
+        }
+    }
+}
+
+/// The circle of an arc segment: the [`SpunPoint`] law, as the spun
+/// profile reads it (the minor arc; the centre behind the chord for a
+/// convex arc, in front of it for a concave one).
+pub(super) struct ArcGeom {
+    /// Centre `(z, r)`.
+    pub c: (f64, f64),
+    pub rad: f64,
+    /// Half the arc's angle.
+    pub half: f64,
+    s: f64,
+    u: (f64, f64),
+    v: (f64, f64),
+}
+
+impl ArcGeom {
+    pub fn of(a: SpunPoint, b: SpunPoint) -> Option<Self> {
+        let (dz, dr) = (b.z - a.z, b.r - a.r);
+        let len = dz.hypot(dr);
+        let rad = a.arc.abs();
+        if a.arc == 0.0 || len.is_nan() || len <= 0.0 || !rad.is_finite() || rad < len * 0.5 - EPS {
+            return None;
+        }
+        let n = (-dr / len, dz / len);
+        let v = (dz / len, dr / len);
+        let half = (len * 0.5 / rad).clamp(-1.0, 1.0).asin();
+        let s = a.arc.signum();
+        let back = rad * half.cos();
+        let mut c = ((a.z + b.z) * 0.5 - s * back * n.0, (a.r + b.r) * 0.5 - s * back * n.1);
+        // An end at the centre's radius is the circle's z extreme, where
+        // rho = rc + sqrt(rad^2 - e^2) turns float dust in the centre into
+        // a visible error (1e-16 in, 1e-8 out). Snap the centre there: the
+        // move is under the 1e-9 slack, and a corner, a ball's tip or a
+        // lollipop's poles then read exact.
+        let near = |p: SpunPoint| (p.r - c.1).abs() <= EPS * rad.max(1.0);
+        if near(a) {
+            c = (a.z + rad, a.r);
+        } else if near(b) {
+            c = (b.z - rad, b.r);
+        }
+        Some(Self { c, rad, half, s, u: (s * n.0, s * n.1), v })
+    }
+
+    pub fn convex(&self) -> bool {
+        self.s > 0.0
+    }
+
+    /// The point at angle `th` from the arc's middle, `k` from the centre.
+    fn at(&self, th: f64, k: f64) -> (f64, f64) {
+        let (c, s) = (th.cos(), th.sin());
+        (self.c.0 + k * (c * self.u.0 + s * self.v.0), self.c.1 + k * (c * self.u.1 + s * self.v.1))
+    }
+}
+
+impl Meridian {
+    /// The convex atoms bottom-up. Lines and convex arcs are exact; a
+    /// concave arc splits to `bound` with each part within `sag` mm of
+    /// the arc. A flat (zero-height) segment is a face, not an atom.
+    /// Refuses a sag limit that is not a finite number over 0, and one
+    /// that needs more than [`MAX_SPLIT`] parts.
+    pub fn atoms(&self, bound: Bound, sag: f64) -> Result<Vec<MeridianAtom>, MeridianError> {
+        if !(sag.is_finite() && sag > 0.0) {
+            return Err(MeridianError::BadSag);
+        }
+        let mut out = Vec::with_capacity(self.points.len());
+        for (i, (w, &cutting)) in self.points.windows(2).zip(&self.cutting).enumerate() {
+            let (a, b) = (w[0], w[1]);
+            match ArcGeom::of(a, b) {
+                None => push_frustum(&mut out, (a.z, a.r), (b.z, b.r), cutting),
+                Some(g) if g.convex() => {
+                    if b.z - a.z > EPS {
+                        let shape = AtomShape::Zone { zc: g.c.0, rc: g.c.1, rad: g.rad };
+                        out.push(MeridianAtom { z0: a.z, z1: b.z, shape, cutting });
+                    }
+                }
+                Some(g) => {
+                    let pts = split_concave(&g, a, b, bound, sag).ok_or(MeridianError::SagTooFine(i + 1))?;
+                    for q in pts.windows(2) {
+                        push_frustum(&mut out, q[0], q[1], cutting);
+                    }
+                }
+            }
+        }
+        Ok(out)
+    }
+}
+
+fn push_frustum(out: &mut Vec<MeridianAtom>, p: (f64, f64), q: (f64, f64), cutting: bool) {
+    if q.0 - p.0 > EPS {
+        out.push(MeridianAtom { z0: p.0, z1: q.0, shape: AtomShape::Frustum { r0: p.1, r1: q.1 }, cutting });
+    }
+}
+
+/// The polyline of a concave arc's bound, both ends exact: chords on
+/// the arc (outer), or the tangents at the split points, meeting at the
+/// mid-angles (inner, clamped to the axis). `None` when the sag limit
+/// needs more than [`MAX_SPLIT`] parts.
+fn split_concave(g: &ArcGeom, a: SpunPoint, b: SpunPoint, bound: Bound, sag: f64) -> Option<Vec<(f64, f64)>> {
+    let off = |n: usize| {
+        let t = g.half / n as f64;
+        match bound {
+            Bound::Outer => g.rad * (1.0 - t.cos()),
+            Bound::Inner => g.rad * (1.0 / t.cos() - 1.0),
+        }
+    };
+    let n = (1..=MAX_SPLIT).find(|&n| off(n) <= sag)?;
+    let step = 2.0 * g.half / n as f64;
+    let mut pts = vec![(a.z, a.r)];
+    match bound {
+        Bound::Outer => pts.extend((1..n).map(|i| g.at(-g.half + i as f64 * step, g.rad))),
+        Bound::Inner => {
+            let k = g.rad / (step * 0.5).cos();
+            pts.extend((0..n).map(|i| g.at(-g.half + (i as f64 + 0.5) * step, k)).map(|(z, r)| (z, r.max(0.0))));
+        }
+    }
+    pts.push((b.z, b.r));
+    Some(pts)
+}
