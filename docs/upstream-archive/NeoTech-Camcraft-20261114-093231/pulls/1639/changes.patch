+            Nav::Orbit => {
+                // The orbit ring with the eye-satellite riding it.
+                let c = r.center();
+                let rad = NAV_PX * 0.27;
+                ui.painter().circle_stroke(c, rad, s);
+                let a = std::f32::consts::FRAC_PI_4;
+                let dot = c + egui::vec2(a.cos() * rad, -a.sin() * rad);
