+//! Unit tests of `step_nearest` (#1602): a boundary point's parameters are
+//! found on its own turn of a many-turn strip, inside the knot domain.
+
+use super::*;
+use crate::geometry::import::step_thread_fixture::{flank, root};
+use truck_stepio::r#in::alias::{BSplineSurface, KnotVec, ParametricSurface3D, SPHint2D};
+
+fn on_surface_inside(s: &Surface, p: Point3, uv: Option<(f64, f64)>) -> bool {
+    let Some(domain) = super::super::step_pole::knot_domain(s) else { return false };
+    uv.is_some_and(|uv| inside(uv, domain) && s.subs(uv.0, uv.1).distance(p) <= SAME_POINT)
+}
+
+/// The first boundary point of a 14-turn flank, searched with no hint:
+/// truck's 51 x 51 presearch lands on the neighbouring turn and Newton
+/// settles off the surface (the #1602 hole). The rescue finds it.
+#[test]
+fn a_point_on_a_many_turn_flank_is_found_on_its_own_turn() {
+    let s = flank(14);
+    let mut fixed = 0;
+    for k in 0..40 {
+        let v = (k as f64 + 0.37) / 40.0;
+        let p = s.subs(0.0, v);
+        let truck = s.search_nearest_parameter(p, SPHint2D::None, TRIALS);
+        let found = rescue(&s, p, truck);
+        assert!(on_surface_inside(&s, p, found), "v {v}: truck {truck:?} -> {found:?}");
+        fixed += usize::from(!on_surface_inside(&s, p, truck));
+    }
+    assert!(fixed > 0, "the fixture must reproduce truck's miss on some point");
+}
+
+/// A root band's straight rulings, extrapolated past u = 1, meet its other
+/// turns: truck can find the point exactly at a u outside [0, 1]. The
+/// answer must come back inside the domain, on the point's own turn.
+#[test]
+fn a_point_on_a_root_band_is_found_inside_the_knot_domain() {
+    let s = root(14);
+    let mut fixed = 0;
+    for k in 0..40 {
+        let v = (k as f64 + 0.37) / 40.0;
+        let p = s.subs(1.0, v);
+        // The hint a mesher would carry from a neighbouring turn.
+        let hint = (0.5, (v - 1.0 / 14.0).max(0.0));
+        let truck = s.search_nearest_parameter(p, hint, TRIALS);
+        let found = rescue(&s, p, truck);
+        assert!(on_surface_inside(&s, p, found), "v {v}: truck {truck:?} -> {found:?}");
+        fixed += usize::from(!on_surface_inside(&s, p, truck));
+    }
+    assert!(fixed > 0, "the fixture must reproduce truck's out-of-domain answer on some point");
+}
+
+/// A point the face really does not reach keeps truck's answer: on a flat
+/// unit square, a point past its edge is found on the extended plane,
+/// which no parameter inside the domain matches.
+#[test]
+fn a_point_off_the_face_keeps_trucks_answer() {
+    let k = KnotVec::bezier_knot(1);
+    let p = |x: f64, y: f64| Point3::new(x, y, 0.0);
+    let cps = vec![vec![p(0.0, 0.0), p(0.0, 1.0)], vec![p(1.0, 0.0), p(1.0, 1.0)]];
+    let s = Surface::BSplineSurface(Box::new(BSplineSurface::new((k.clone(), k), cps)));
+    let off = Point3::new(1.5, 0.5, 0.0);
+    let truck = s.search_nearest_parameter(off, (0.9, 0.5), TRIALS);
+    assert!(truck.is_some_and(|(u, _)| u > 1.4), "truck extends the plane: {truck:?}");
+    assert_eq!(rescue(&s, off, truck), truck);
+    // An answer already inside and on the surface is returned untouched.
+    let on = Point3::new(0.25, 0.75, 0.0);
+    assert_eq!(rescue(&s, on, Some((0.25, 0.75))), Some((0.25, 0.75)));
+}
+
+/// The sample grid has a few samples in every knot span and stays inside
+/// the evaluation bound however many spans a face has.
+#[test]
+fn the_sample_grid_covers_every_span_within_its_bound() {
+    let s = flank(14);
+    let Some(domain) = super::super::step_pole::knot_domain(&s) else { panic!("a NURBS has a knot domain") };
+    let (us, vs) = samples(&s, domain);
+    assert!(us.len() * vs.len() <= MAX_SAMPLES, "{} x {}", us.len(), vs.len());
+    assert!(vs.len() > 140, "every one of the 140 spans is sampled: {}", vs.len());
+    assert_eq!((us.first(), us.last()), (Some(&0.0), Some(&1.0)));
+}
+
+/// Whatever the samples' Newton runs find, the rescue never answers
+/// outside the knot domain: on a flat square, a point on the plane past
+/// its edge draws every run there, and truck's own (bogus) answer stands.
+#[test]
+fn a_rescue_never_answers_outside_the_knot_domain() {
+    let k = KnotVec::bezier_knot(1);
+    let p = |x: f64, y: f64| Point3::new(x, y, 0.0);
+    let cps = vec![vec![p(0.0, 0.0), p(0.0, 1.0)], vec![p(1.0, 0.0), p(1.0, 1.0)]];
+    let s = Surface::BSplineSurface(Box::new(BSplineSurface::new((k.clone(), k), cps)));
+    let bogus = Some((5.0, 0.5));
+    assert_eq!(rescue(&s, Point3::new(1.5, 0.5, 0.0), bogus), bogus);
+}
+
+/// A root band's point found exactly on an extrapolated ruling (u = 19.5,
+/// one pitch down at the same angle) is replaced by its own in-domain
+/// parameter, although that one is a rounding error farther away.
+#[test]
+fn an_exact_answer_outside_the_domain_gives_way_to_one_on_the_surface_inside() {
+    let s = root(14);
+    let v = 0.5;
+    let outside = (19.5, v + 1.0 / 14.0);
+    let p = s.subs(outside.0, outside.1);
+    let found = rescue(&s, p, Some(outside));
+    assert!(on_surface_inside(&s, p, found), "{found:?}");
+}
+
+/// A boundary point a little off its face (a file's own tolerance), whose
+/// first answer is a turn away, takes the nearer answer on its own turn
+/// although that one is not within the acceptance distance either.
+#[test]
+fn a_nearer_answer_replaces_a_far_one_off_the_surface() {
+    let s = flank(14);
+    let (u, v) = (0.0, 0.437);
+    let p = s.subs(u, v) + s.normal(u, v) * 1e-4;
+    let wrong_turn = Some((0.0, v - 1.0 / 14.0));
+    let found = rescue(&s, p, wrong_turn).expect("an answer");
+    assert!((found.1 - v).abs() < 1e-3, "{found:?}");
+}
diff --git a/crates/app/src/geometry/import/step_stretch.rs b/crates/app/src/geometry/import/step_stretch.rs
new file mode 100644
index 000000000..ece0295fe
--- /dev/null
+++ b/crates/app/src/geometry/import/step_stretch.rs
@@ -0,0 +1,116 @@
+//! An affine stretch of a B-spline or NURBS STEP face's parameters, so the
+//! mesher's parameter plane is about as long in each direction as the face
+//! is in space (#1602).
+//!
+//! Provenance: reparametrisation by a linear change of parameter (Piegl &
+//! Tiller, "The NURBS Book", 2nd ed., sec. 6.4: u = f(s) linear leaves the
+//! surface and its continuity unchanged and scales the derivatives by the
+//! constant f'); the reason it matters is the constrained Delaunay
+//! triangulation truck meshes a trimmed face with in its parameter plane
+//! (ricosjp, Apache-2.0; Delaunay's empty-circle rule is isotropic). Our
+//! own design around both. Nothing from any CAM vendor.
+//!
+//! Why: truck triangulates a trimmed face in (u, v), keeping a triangle
+//! when its circumcircle holds no other point - a rule that assumes a unit
+//! of u and a unit of v are about the same length on the face. A thread
+//! flank exported as one rational strip is 1.5 mm across u and ~500 mm
+//! along v (fourteen turns): its parameter square is 350 times too short
+//! in u. Where the grid leaves the plane free (next to the boundary, or
+//! everywhere when the face is straight across u), the empty-circle rule
+//! then joins a boundary point to the far end of the strip: triangles a
+//! quarter of the face long, cutting across the turns, on the #1602 models.
+//!
+//! How: the mean speed of the face along u and along v (the length of
+//! `S_u`, `S_v`) is sampled over its knot domain, and the faster direction
+//! is stretched by their ratio, so a parameter unit is about as long on
+//! the face either way; the slower direction keeps its own numbers. A face
+//! within [`THRESHOLD`] of square is left as it was, so a face that
+//! meshed well before meshes exactly as before.
+
+use truck_stepio::r#in::alias::{InnerSpace, ParametricSurface, Surface};
+
+/// Below this speed ratio a face keeps its own parameters.
+const THRESHOLD: f64 = 4.0;
+/// The largest stretch applied: past it a face is a sliver whose speed
+/// sample is not to be trusted with the parameter plane's numbers.
+const MAX_STRETCH: f64 = 1.0e6;
+/// Samples per direction for the mean speed.
+const SAMPLES: usize = 16;
+
+/// How much each parameter is multiplied by in the mesher's plane.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Stretch {
+    pub u: f64,
+    pub v: f64,
+}
+
+impl Stretch {
+    /// No stretch: the surface's own parameters.
+    pub(super) const NONE: Stretch = Stretch { u: 1.0, v: 1.0 };
+
+    /// The stretch for `surface`: [`Stretch::NONE`] for a kind that is not
+    /// a B-spline or NURBS, a face near square, or one whose speeds cannot
+    /// be measured.
+    pub(super) fn of(surface: &Surface) -> Stretch {
+        let Some(((u0, u1), (v0, v1))) = super::step_pole::knot_domain(surface) else {
+            return Stretch::NONE;
+        };
+        let (mut su, mut sv) = (0.0, 0.0);
+        for i in 0..SAMPLES {
+            let u = u0 + (u1 - u0) * (i as f64 + 0.5) / SAMPLES as f64;
+            for j in 0..SAMPLES {
+                let v = v0 + (v1 - v0) * (j as f64 + 0.5) / SAMPLES as f64;
+                su += surface.uder(u, v).magnitude();
+                sv += surface.vder(u, v).magnitude();
+            }
+        }
+        Self::from_speeds(su, sv)
+    }
+
+    /// The stretch for mean speeds `su` along u and `sv` along v (any
+    /// common factor).
+    fn from_speeds(su: f64, sv: f64) -> Stretch {
+        // A zero, NaN or infinite speed gives a ratio outside the range.
+        let ratio = (su / sv).max(sv / su);
+        if !(THRESHOLD..=MAX_STRETCH).contains(&ratio) {
+            return Stretch::NONE;
+        }
+        if su > sv {
+            Stretch { u: ratio, v: 1.0 }
+        } else {
+            Stretch { u: 1.0, v: ratio }
+        }
+    }
+
+    /// Mesher-plane parameters to the surface's own.
+    pub(super) fn inner(self, (u, v): (f64, f64)) -> (f64, f64) {
+        (u / self.u, v / self.v)
+    }
+
+    /// The surface's own parameters to the mesher's plane.
+    pub(super) fn outer(self, (u, v): (f64, f64)) -> (f64, f64) {
+        (u * self.u, v * self.v)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_face_near_square_keeps_its_parameters() {
+        assert_eq!(Stretch::from_speeds(1.0, 3.9), Stretch::NONE);
+        assert_eq!(Stretch::from_speeds(3.9, 1.0), Stretch::NONE);
+        assert_eq!(Stretch::from_speeds(1.0, 0.0), Stretch::NONE);
+        assert_eq!(Stretch::from_speeds(f64::NAN, 1.0), Stretch::NONE);
+        assert_eq!(Stretch::from_speeds(1.0, 2.0e6), Stretch::NONE, "past the cap");
+    }
+
+    #[test]
+    fn the_faster_direction_is_stretched_by_the_ratio() {
+        assert_eq!(Stretch::from_speeds(0.5, 175.0), Stretch { u: 1.0, v: 350.0 });
+        assert_eq!(Stretch::from_speeds(40.0, 4.0), Stretch { u: 10.0, v: 1.0 });
+        let s = Stretch { u: 1.0, v: 350.0 };
+        assert_eq!(s.inner(s.outer((0.25, 0.5))), (0.25, 0.5));
+    }
+}
diff --git a/crates/app/src/geometry/import/step_thread_fixture.rs b/crates/app/src/geometry/import/step_thread_fixture.rs
new file mode 100644
index 000000000..294c27d52
--- /dev/null
+++ b/crates/app/src/geometry/import/step_thread_fixture.rs
@@ -0,0 +1,62 @@
+//! Test fixture (#1602): a thread's faces as the CAD exports them - a
+//! rational strip, degree 1 across u, degree 2 along v in 36-degree circular
+//! arcs that climb one pitch a turn, many turns long.
+//!
+//! Provenance: the rational quadratic circular arc (Piegl & Tiller, "The
+//! NURBS Book", 2nd ed., sec. 7.2: end points on the circle, the middle
+//! control point at r / cos(half-angle), weight cos(half-angle)), with z
+//! linear in the angle. Our own fixture; no user file and no vendor data.
+
+use truck_stepio::r#in::alias::{BSplineSurface, KnotVec, NurbsSurface, Surface, Vector4};
+
+/// Degrees of arc per span along v.
+const ARC: f64 = 36.0;
+
+/// One rail of the strip: radius `r`, height `z0` at angle 0, rising
+/// `pitch` per turn, for `turns` turns - homogeneous control points.
+fn rail(r: f64, z0: f64, pitch: f64, turns: usize) -> Vec<Vector4> {
+    let arcs = turns * (360.0 / ARC) as usize;
+    let w = (ARC / 2.0).to_radians().cos();
+    let z = |a: f64| z0 + pitch * a / std::f64::consts::TAU;
+    let at = |rad: f64, a: f64, w: f64| Vector4::new(rad * a.cos() * w, rad * a.sin() * w, z(a) * w, w);
+    let mut out = vec![at(r, 0.0, 1.0)];
+    for k in 0..arcs {
+        let mid = (k as f64 * ARC + ARC / 2.0).to_radians();
+        let end = ((k + 1) as f64 * ARC).to_radians();
+        out.push(at(r / w, mid, w));
+        out.push(at(r, end, 1.0));
+    }
+    out
+}
+
+/// The knots along v: one span per arc on [0, 1], each inner knot doubled
+/// (a circle in arcs is only C0 in its parameter at the joins).
+pub(super) fn arc_knots(turns: usize) -> KnotVec {
+    let arcs = turns * (360.0 / ARC) as usize;
+    let mut k = vec![0.0; 3];
+    for i in 1..arcs {
+        let t = i as f64 / arcs as f64;
+        k.extend([t, t]);
+    }
+    k.extend([1.0; 3]);
+    KnotVec::from(k)
+}
+
+/// The strip between rail `(r0, z0)` (u = 0) and rail `(r1, z1)` (u = 1).
+/// A flank when the radii differ; a root or crest band when they match.
+pub(super) fn strip(turns: usize, pitch: f64, (r0, z0): (f64, f64), (r1, z1): (f64, f64)) -> Surface {
+    let net = vec![rail(r0, z0, pitch, turns), rail(r1, z1, pitch, turns)];
+    let knots = (KnotVec::bezier_knot(1), arc_knots(turns));
+    Surface::NurbsSurface(Box::new(NurbsSurface::new(BSplineSurface::new(knots, net))))
+}
+
+/// A thread flank in millimetres: 6.35 mm out to 5.08 mm in, 0.75 mm
+/// lower, 1.95 mm pitch - the proportions of the #1602 parts.
+pub(super) fn flank(turns: usize) -> Surface {
+    strip(turns, 1.95, (6.35, 0.0), (5.08, -0.75))
+}
+
+/// A thread root band: radius 5.08 mm, 0.1 mm wide along the axis.
+pub(super) fn root(turns: usize) -> Surface {
+    strip(turns, 1.95, (5.08, -0.75), (5.08, -0.85))
+}
diff --git a/crates/app/tests/import_step_thread.rs b/crates/app/tests/import_step_thread.rs
new file mode 100644
index 000000000..b98302019
--- /dev/null
+++ b/crates/app/tests/import_step_thread.rs
@@ -0,0 +1,279 @@
+//! #1602: a thread flank exported as one rational B-spline strip - degree
+//! 1 across, degree 2 along in 36-degree circular arcs, climbing one pitch
+//! a turn - imports at full fidelity in a bounded facet count, with no
+//! triangle cutting across the turns.
+//!
+//! Before #1602 the strip's four-turn fixture below meshed into 523 K facets
+//! (8 s in release; the 14-turn faces of the user's parts held 2 M facets
+//! each and took a minute), and once that runaway was bounded the mesher's
+//! parameter plane - 350 times too short across the strip - joined the
+//! strip's edges with triangles a quarter of it long.
+//!
+//! Fixture: generated here, our own geometry - the rational quadratic
+//! circular arc of Piegl & Tiller, "The NURBS Book" (2nd ed., sec. 7.2),
+//! with z linear in the angle, written as ISO 10303-21 entities (one
+//! `ADVANCED_FACE` in an `OPEN_SHELL`, two helical `B_SPLINE_CURVE` rails
+//! and two run-out curves crossing the strip on the bias, as polylines of
+//! points on the face). No user file.
+//!
+//! Gate map (M4.4): covers app::geometry::import::step,
+//! app::geometry::import::step_guard, app::geometry::import::step_division,
+//! app::geometry::import::step_stretch, app::geometry::import::step_nearest.
+
+use std::f64::consts::TAU;
+use std::fmt::Write as _;
+
+use camcraft_app::geometry::import::step;
+use camcraft_app::geometry::Point3;
+
+const ARC_DEG: f64 = 36.0;
+const PITCH: f64 = 1.95;
+/// Rail at u = 0: radius, height at angle 0. Rail at u = 1 likewise.
+const OUTER: (f64, f64) = (6.35, 0.0);
+const INNER: (f64, f64) = (5.08, -0.75);
+
+/// A real in STEP's exponent form.
+fn real(x: f64) -> String {
+    format!("{x:.17E}")
+}
+
+/// One rail's control points and weights.
+fn rail((r, z0): (f64, f64), turns: usize) -> (Vec<[f64; 3]>, Vec<f64>) {
+    let arcs = turns * (360.0 / ARC_DEG) as usize;
+    let w = (ARC_DEG / 2.0).to_radians().cos();
+    let z = |a: f64| z0 + PITCH * a / TAU;
+    let at = |rad: f64, a: f64| [rad * a.cos(), rad * a.sin(), z(a)];
+    let (mut pts, mut ws) = (vec![at(r, 0.0)], vec![1.0]);
+    for k in 0..arcs {
+        let mid = (k as f64 * ARC_DEG + ARC_DEG / 2.0).to_radians();
+        let end = ((k + 1) as f64 * ARC_DEG).to_radians();
+        pts.extend([at(r / w, mid), at(r, end)]);
+        ws.extend([w, 1.0]);
+    }
+    (pts, ws)
+}
+
+/// The rail through `pts`/`ws` at `v` in [0, 1]: each doubled-knot span is
+/// one rational quadratic Bezier arc.
+fn on_rail(pts: &[[f64; 3]], ws: &[f64], v: f64) -> [f64; 3] {
+    let arcs = (pts.len() - 1) / 2;
+    let s = v.clamp(0.0, 1.0) * arcs as f64;
+    let k = (s.floor() as usize).min(arcs - 1);
+    let t = s - k as f64;
+    let b = [(1.0 - t) * (1.0 - t), 2.0 * t * (1.0 - t), t * t];
+    let (mut num, mut den) = ([0.0; 3], 0.0);
+    for i in 0..3 {
+        let wb = ws[2 * k + i] * b[i];
+        for (n, c) in num.iter_mut().zip(pts[2 * k + i]) {
+            *n += wb * c;
+        }
+        den += wb;
+    }
+    num.map(|n| n / den)
+}
+
+/// Where the face is trimmed: from (u, v) = (0, 0) across to (1, CAP), and
+/// from (1, 1) back to (0, 1 - CAP) - a thread's run-out, crossing the
+/// strip on the bias, so the trimming curves carry points of their own.
+/// A whole number of arcs for every turn count, so the trim sits on knots.
+const CAP: f64 = 0.1;
+/// Points on each trimming curve.
+const CAP_POINTS: usize = 64;
+
+fn trimmed(u: f64, v: f64) -> bool {
+    v >= CAP * u && v <= 1.0 - CAP + CAP * u
+}
+
+/// The flank as a STEP file in millimetres.
+fn flank_step(turns: usize) -> String {
+    let arcs = turns * (360.0 / ARC_DEG) as usize;
+    let knots: Vec<String> = (0..=arcs).map(|i| real(i as f64 / arcs as f64)).collect();
+    let mults: Vec<String> =
+        (0..=arcs).map(|i| if i == 0 || i == arcs { "3" } else { "2" }.to_string()).collect();
+    let (knots, mults) = (knots.join(", "), mults.join(", "));
+    let (outer, ws) = rail(OUTER, turns);
+    let (inner, _) = rail(INNER, turns);
+    let weights: Vec<String> = ws.iter().map(|w| real(*w)).collect();
+    let weights = weights.join(", ");
+    // The rows share their weights, so the surface is linear across u.
+    let at = |u: f64, v: f64| {
+        let (a, b) = (on_rail(&outer, &ws, v), on_rail(&inner, &ws, v));
+        [0, 1, 2].map(|i| a[i] + (b[i] - a[i]) * u)
+    };
+    let cap = |from: (f64, f64), to: (f64, f64)| -> Vec<[f64; 3]> {
+        (0..=CAP_POINTS)
+            .map(|i| {
+                let t = i as f64 / CAP_POINTS as f64;
+                at(from.0 + (to.0 - from.0) * t, from.1 + (to.1 - from.1) * t)
+            })
+            .collect()
+    };
+    let cap_start = cap((0.0, 0.0), (1.0, CAP));
+    let cap_end = cap((1.0, 1.0), (0.0, 1.0 - CAP));
+
+    let mut out = String::new();
+    let mut id = 100;
+    let mut ent = |out: &mut String, body: String| -> String {
+        id += 1;
+        let _ = writeln!(out, "#{id} = {body};");
+        format!("#{id}")
+    };
+    let mut point = |out: &mut String, p: [f64; 3]| -> String {
+        let body = format!("CARTESIAN_POINT('', ({}, {}, {}))", real(p[0]), real(p[1]), real(p[2]));
+        ent(out, body)
+    };
+    // The points first, so `ent` is free for the rest.
+    let c_out: Vec<String> = outer.iter().map(|p| point(&mut out, *p)).collect();
+    let c_in: Vec<String> = inner.iter().map(|p| point(&mut out, *p)).collect();
+    let p_start: Vec<String> = cap_start.iter().map(|p| point(&mut out, *p)).collect();
+    let p_end: Vec<String> = cap_end.iter().map(|p| point(&mut out, *p)).collect();
+    // Corners: (0, 0), (1, CAP), (1, 1), (0, 1 - CAP).
+    let corners = [cap_start[0], cap_start[CAP_POINTS], cap_end[0], cap_end[CAP_POINTS]];
+    let v: Vec<String> = corners.iter().map(|p| point(&mut out, *p)).collect();
+    drop(point);
+    let mut e = |body: String| ent(&mut out, body);
+    let surface = e(format!(
+        "( BOUNDED_SURFACE() B_SPLINE_SURFACE(1, 2, (({}), ({})), .UNSPECIFIED., .F., .F., .F.) \
+         B_SPLINE_SURFACE_WITH_KNOTS((2, 2), ({mults}), (0.0, 1.0), ({knots}), .UNSPECIFIED.) \
+         GEOMETRIC_REPRESENTATION_ITEM() RATIONAL_B_SPLINE_SURFACE((({weights}), ({weights}))) \
+         REPRESENTATION_ITEM('') SURFACE() )",
+        c_out.join(", "),
+        c_in.join(", ")
+    ));
+    // A rail runs only between its trim corners: the arcs [a0, a1). The
+    // trim sits on knots (CAP times the arc count is whole), as an edge's
+    // curve in an exported file ends at its vertices.
+    let mut curve = |cps: &[String], (a0, a1): (usize, usize)| {
+        let knots: Vec<String> = (a0..=a1).map(|i| real(i as f64 / arcs as f64)).collect();
+        let mults: Vec<&str> = (a0..=a1).map(|i| if i == a0 || i == a1 { "3" } else { "2" }).collect();
+        let weights: Vec<String> = ws[2 * a0..=2 * a1].iter().map(|w| real(*w)).collect();
+        e(format!(
+            "( BOUNDED_CURVE() B_SPLINE_CURVE(2, ({}), .UNSPECIFIED., .F., .F.) \
+             B_SPLINE_CURVE_WITH_KNOTS(({}), ({}), .UNSPECIFIED.) CURVE() \
+             GEOMETRIC_REPRESENTATION_ITEM() RATIONAL_B_SPLINE_CURVE(({})) REPRESENTATION_ITEM('') )",
+            cps[2 * a0..=2 * a1].join(", "),
+            mults.join(", "),
+            knots.join(", "),
+            weights.join(", ")
+        ))
+    };
+    let cap_arcs = (CAP * arcs as f64).round() as usize;
+    let h_out = curve(&c_out, (0, arcs - cap_arcs));
+    let h_in = curve(&c_in, (cap_arcs, arcs));
+    let mut e = |body: String| ent(&mut out, body);
+    let mut polyline = |pts: &[String]| {
+        let n = pts.len() - 1;
+        let mults: Vec<&str> = (0..=n).map(|i| if i == 0 || i == n { "2" } else { "1" }).collect();
+        let knots: Vec<String> = (0..=n).map(|i| real(i as f64 / n as f64)).collect();
+        e(format!(
+            "B_SPLINE_CURVE_WITH_KNOTS('', 1, ({}), .POLYLINE_FORM., .F., .F., ({}), ({}), .UNSPECIFIED.)",
+            pts.join(", "),
+            mults.join(", "),
+            knots.join(", ")
+        ))
+    };
+    let l_start = polyline(&p_start);
+    let l_end = polyline(&p_end);
+    let mut e = |body: String| ent(&mut out, body);
+    let vp: Vec<String> = v.iter().map(|p| e(format!("VERTEX_POINT('', {p})"))).collect();
+    let start = e(format!("EDGE_CURVE('', {}, {}, {l_start}, .T.)", vp[0], vp[1]));
+    let rail_in = e(format!("EDGE_CURVE('', {}, {}, {h_in}, .T.)", vp[1], vp[2]));
+    let end = e(format!("EDGE_CURVE('', {}, {}, {l_end}, .T.)", vp[2], vp[3]));
+    let rail_out = e(format!("EDGE_CURVE('', {}, {}, {h_out}, .T.)", vp[0], vp[3]));
+    // Counter-clockwise in (u, v): across the start, up the inner rail,
+    // back across the end, down the outer rail.
+    let oriented: Vec<String> = [(start, ".T."), (rail_in, ".T."), (end, ".T."), (rail_out, ".F.")]
+        .into_iter()
+        .map(|(edge, sense)| e(format!("ORIENTED_EDGE('', *, *, {edge}, {sense})")))
+        .collect();
+    let lp = e(format!("EDGE_LOOP('', ({}))", oriented.join(", ")));
+    let bound = e(format!("FACE_OUTER_BOUND('', {lp}, .T.)"));
+    let face = e(format!("ADVANCED_FACE('', ({bound}), {surface}, .T.)"));
+    e(format!("OPEN_SHELL('', ({face}))"));
+    format!(
+        "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION(('CamCraft #1602 fixture: a thread flank'), '2;1');\n\
+         FILE_NAME('', '', (''), (''), '', '', '');\nFILE_SCHEMA(('AUTOMOTIVE_DESIGN'));\nENDSEC;\nDATA;\n\
+         #11 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#15)) \
+         GLOBAL_UNIT_ASSIGNED_CONTEXT((#12, #13, #14)) REPRESENTATION_CONTEXT('', '') );\n\
+         #12 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );\n\
+         #13 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );\n\
+         #14 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );\n\
+         #15 = UNCERTAINTY_MEASURE_WITH_UNIT(1.0E-6, #12, 'distance_accuracy_value', '');\n\
+         {out}ENDSEC;\nEND-ISO-10303-21;\n"
+    )
+}
+
+/// The area of the ideal flank (a helicoid between the two rails) inside
+/// the trim, summed over a fine grid: the rational arcs follow it to well
+/// under a micron.
+fn ideal_area(turns: usize) -> f64 {
+    let (nu, nt) = (64, 20_000 * turns);
+    let s = |u: f64, t: f64| {
+        let r = OUTER.0 + (INNER.0 - OUTER.0) * u;
+        let z = OUTER.1 + (INNER.1 - OUTER.1) * u + PITCH * t / TAU;
+        Point3::new(r * t.cos(), r * t.sin(), z)
+    };
+    let span = TAU * turns as f64;
+    let mut area = 0.0;
+    for i in 0..nu {
+        for j in 0..nt {
+            let (u0, u1) = (i as f64 / nu as f64, (i + 1) as f64 / nu as f64);
+            let (t0, t1) = (span * j as f64 / nt as f64, span * (j + 1) as f64 / nt as f64);
+            if !trimmed((u0 + u1) / 2.0, (j as f64 + 0.5) / nt as f64) {
+                continue;
+            }
+            let (a, b, c) = (s(u0, t0), s(u1, t0), s(u0, t1));
+            area += len((b - a).cross(c - a));
+        }
+    }
+    area
+}
+
+/// How far `p` stands off the ideal flank along the axis: its u from its
+/// radius, then its height against the flank's at that u and angle,
+/// reduced to the nearest turn. The flank is ~30 degrees off the axis, so
+/// this over-reads the true distance by under 15 %.
+fn axial_gap(p: Point3) -> f64 {
+    let r = p.x.hypot(p.y);
+    let u = ((r - OUTER.0) / (INNER.0 - OUTER.0)).clamp(0.0, 1.0);
+    let ideal = OUTER.1 + (INNER.1 - OUTER.1) * u + PITCH * p.y.atan2(p.x) / TAU;
+    let d = (p.z - ideal).rem_euclid(PITCH);
+    d.min(PITCH - d)
+}
+
+fn len(p: Point3) -> f64 {
+    p.dot(p).sqrt()
+}
+
+fn edge(a: Point3, b: Point3) -> f64 {
+    len(b - a)
+}
+
+#[test]
+fn a_four_turn_thread_flank_meshes_at_full_fidelity_in_a_bounded_count() {
+    let turns = 4;
+    let text = flank_step(turns);
+    let started = std::time::Instant::now();
+    let (mesh, chord) = step::parse_with_chord(text.as_bytes()).expect("the flank imports");
+    let took = started.elapsed();
+    let facets = &mesh.facets;
+    // ~80 steps a turn at 5 um on a 6.35 mm radius, two triangles each;
+    // the isotropic division made 523 K.
+    assert!(facets.len() < 5_000, "{} facets for a four-turn strip", facets.len());
+    assert!(step::coarse(chord).is_none(), "meshed at the promised chord, not reduced: {chord} mm");
+    // No triangle crosses the turns: the longest edge a sound mesh has is
+    // the strip's own diagonal (1.47 mm across, ~0.5 mm a step).
+    let longest = facets.iter().map(|t| edge(t.a, t.b).max(edge(t.b, t.c)).max(edge(t.c, t.a))).fold(0.0, f64::max);
+    assert!(longest < 2.0, "a triangle {longest} mm long cuts across the turns");
+    let area: f64 = facets.iter().map(|t| len((t.b - t.a).cross(t.c - t.a)) / 2.0).sum();
+    let ideal = ideal_area(turns);
+    assert!((area - ideal).abs() < 0.01 * ideal, "mesh area {area} mm2 against the flank's {ideal} mm2");
+    // Every facet lies on the flank: its centre within the chord promise
+    // (and the micron the rational arcs differ from the ideal helicoid).
+    let worst = facets
+        .iter()
+        .map(|t| axial_gap(Point3::new((t.a.x + t.b.x + t.c.x) / 3.0, (t.a.y + t.b.y + t.c.y) / 3.0, (t.a.z + t.b.z + t.c.z) / 3.0)))
+        .fold(0.0, f64::max);
+    assert!(worst < 0.01, "a facet stands {worst} mm off the flank");
+    assert!(took.as_secs() < 60, "bounded: {took:?}");
+}
