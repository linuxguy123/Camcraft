From ab87eb756257c7828429f3c4ed07bcb183727d9f Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Fri, 13 Nov 2026 21:08:40 -0800
Subject: [PATCH] fix(build): clippy 1.100 needless_range_loop on main

clippy 1.100 (the PR-test runner's toolchain) flags four indexed loops
on main as needless_range_loop, which turns `-D warnings` red for every
PR there: three in camcraft-geometry's feature.rs (481, 1205, 1486) and
one in camcraft-sim's fixture_mesh_convict test (152). Each is now an
iterator loop over the same elements (`e.facets.iter().take(n)` /
`moves.iter().enumerate().take(3)`); no behaviour change, and the facet
loops no longer index a fixed array.

Fixes #1624

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAgjpiZbXSvmXLvdmL
---
 crates/geometry/src/geometry/feature.rs  | 12 ++++++------
 crates/sim/tests/fixture_mesh_convict.rs |  4 ++--
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/crates/geometry/src/geometry/feature.rs b/crates/geometry/src/geometry/feature.rs
index cc55e03d9..b5bb94682 100644
--- a/crates/geometry/src/geometry/feature.rs
+++ b/crates/geometry/src/geometry/feature.rs
@@ -478,8 +478,8 @@ pub fn features_of_facets(facets: &[Triangle]) -> Features {
     for ((a, b), e) in ordered {
         let mut face_ids: Vec<u32> = Vec::new();
         let mut all_planar = true;
-        for slot in 0..e.count.min(3) as usize {
-            let t = e.facets[slot] as usize;
+        for &f in e.facets.iter().take(e.count.min(3) as usize) {
+            let t = f as usize;
             let fi = facet_face[t];
             if !face_ids.contains(&fi) {
                 face_ids.push(fi);
@@ -1202,10 +1202,10 @@ pub fn chains(features: &Features) -> Vec<Chain> {
         .iter()
         .map(|e| {
             let mut fs: Vec<u32> = Vec::new();
-            for slot in 0..(e.n_facets as usize).min(3) {
+            for &f in e.facets.iter().take((e.n_facets as usize).min(3)) {
                 let fi = features
                     .facet_face
-                    .get(e.facets[slot] as usize)
+                    .get(f as usize)
                     .copied()
                     .unwrap_or(u32::MAX);
                 if !fs.contains(&fi) {
@@ -1483,8 +1483,8 @@ fn smooth_band(
     for &(fi, _) in ra.iter().filter(|x| rb.contains(x)) {
         let flank_patch = |e: &TopEdge| -> Option<u32> {
             let mut root: Option<u32> = None;
-            for slot in 0..(e.n_facets as usize).min(3) {
-                let t = e.facets[slot] as usize;
+            for &f in e.facets.iter().take((e.n_facets as usize).min(3)) {
+                let t = f as usize;
                 if features.facet_face.get(t).copied() == Some(fi) {
                     continue; // the shared face's own facet is not a flank
                 }
diff --git a/crates/sim/tests/fixture_mesh_convict.rs b/crates/sim/tests/fixture_mesh_convict.rs
index 39f1a2599..27afb08db 100644
--- a/crates/sim/tests/fixture_mesh_convict.rs
+++ b/crates/sim/tests/fixture_mesh_convict.rs
@@ -149,9 +149,9 @@ fn a_mesh_top_face_keeps_the_strict_dip_and_a_dip_convicts() {
         feed(p(-50.0, 0.0, 19.999), p(50.0, 0.0, 19.999)),
     ]);
     let (boxed, meshed) = judge(&path, &f);
-    for i in 0..3 {
+    for (i, m) in path.moves.iter().enumerate().take(3) {
         assert_eq!(hit_at(&boxed, i), None, "flush is silent ({i}): {boxed:?}");
-        assert!(!penetrates(&f, &path.moves[i], 1e-6), "and the mesh agrees nothing goes in ({i})");
+        assert!(!penetrates(&f, m, 1e-6), "and the mesh agrees nothing goes in ({i})");
     }
     assert_eq!(hit_at(&meshed, 3), Some(FixturePart::Rapid), "{meshed:?}");
     assert_eq!(hit_at(&meshed, 4), Some(FixturePart::Flute), "{meshed:?}");
