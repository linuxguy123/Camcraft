From a5585a1f63cad707a22abb15af21619f41fb7f7f Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Fri, 13 Nov 2026 10:00:16 +0100
Subject: [PATCH] fix(post): sinker ISO post writes the document's unit, not
 the machine file's

sinker-iso.cps decided inch/mm from `machine.units`; since #902 the
program's unit is the document's (`postOptions.Units`). It now reads
postOptions.Units, as wire-iso.cps does, and declares
`programUnits = "mm inch"` (its lengths and feeds already convert, and
the unit word is the machine's edm.codes.metric / edm.codes.inch, an
inch document on a machine stating no inch code refused by name).

Pinned by script_sinker_iso's
the_sinker_program_posts_in_the_documents_unit_not_the_machine_files
(an inch machine file under an mm document posts the mm golden byte for
byte; an inch document writes G20 and every length / 25.4). The
missing-inch-code refusal now asks an inch document, not an inch
machine file. program_units' machine-file law is green again.

Fixes #1382

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 assets/posts/sinker-iso.cps            |  9 +++--
 crates/post/tests/script_sinker_iso.rs | 55 ++++++++++++++++++++++++--
 2 files changed, 58 insertions(+), 6 deletions(-)

diff --git a/assets/posts/sinker-iso.cps b/assets/posts/sinker-iso.cps
index ea9e0c5b2..087234c6a 100644
--- a/assets/posts/sinker-iso.cps
+++ b/assets/posts/sinker-iso.cps
@@ -28,12 +28,13 @@ setCodePage = "utf-8";
 capabilities = 1;          // reference contract: integer feature mask
 coolantModes = true;       // reads PARAM Coolant - to refuse every ask but Off
 serves = ["sinker_edm"];   // posts for sinker EDMs only (#1266 manifest; the app's serves door, #1232)
+programUnits = "mm inch"; // #902, #1382: writes the document's unit (postOptions.Units) with edm.codes.metric / edm.codes.inch
 
 // Determinism law: no timestamps, no randomness - the same stream always
 // posts to the same text (golden files depend on it).
 
 // ---------------------------------------------------------------- state
-var inch = false;          // the machine is programmed in inches (onOpen)
+var inch = false;          // the document is in inches (postOptions.Units, onOpen)
 var wcsWord = "G54";       // from the WorkOffset PARAM
 var orgX = 0, orgY = 0, orgZ = 0; // the WCS slot origin (OriginX/Y/Z PARAMs)
 var sectionOpen = false;   // preamble written (a legacy .cl has no SECTION)
@@ -47,7 +48,7 @@ var last = { X: null, Y: null, Z: null }; // the modal axis words written
 var refused = {};          // one named refusal per key, not one per line
 
 // ------------------------------------------------------------ helpers
-// The stream speaks mm and mm/min. An inch machine gets every length and
+// The stream speaks mm and mm/min. An inch program gets every length and
 // feed divided by 25.4 and written at four decimals; a metric one keeps
 // mm at three. Every length keeps its decimal point: an ISO control may
 // read a bare integer in its least increment.
@@ -154,7 +155,9 @@ function machineOk() {
 
 // -------------------------------------------------------------- header
 function onOpen() {
-  inch = typeof machine !== "undefined" && machine.units === "inch";
+  // #902, #1382: the document's unit, never the machine file's (that is
+  // only the unit the machine file was written in).
+  inch = typeof postOptions !== "undefined" && postOptions && postOptions.Units === "inch";
   note(clean(machineName()));
   if (!machineOk()) return;
   emit(code(inch ? "inch" : "metric"));
diff --git a/crates/post/tests/script_sinker_iso.rs b/crates/post/tests/script_sinker_iso.rs
index a54c65664..5aa3c97d1 100644
--- a/crates/post/tests/script_sinker_iso.rs
+++ b/crates/post/tests/script_sinker_iso.rs
@@ -86,6 +86,55 @@ fn post(mch: &Value, stream: &str) -> engine::PostOutput {
     engine::run(&sinker_cps(), mch, stream).expect("the sinker post runs")
 }
 
+/// [`post`] for a document in `units` (`postOptions.Units`, #902).
+fn post_in(mch: &Value, stream: &str, units: &str) -> engine::PostOutput {
+    engine::run_with(&sinker_cps(), mch, stream, &json!({ "Units": units })).expect("the sinker post runs")
+}
+
+/// #1382: the program's unit is the document's (#902), never the machine
+/// file's. An inch machine file under an mm document posts the mm golden
+/// byte for byte; an inch document on the mm fixture writes the machine's
+/// inch code and every length and feed / 25.4, the rest equal.
+#[test]
+fn the_sinker_program_posts_in_the_documents_unit_not_the_machine_files() {
+    let golden = read("crates/app/tests/golden/nc/sinker-iso/sinker_burn_cavity.nc");
+    let mut inch_machine = dialect();
+    inch_machine["kinematics"]["default"]["units"]["length"] = json!("inch");
+    inch_machine["units"] = json!("inch");
+    for out in [post(&inch_machine, &stream_with(&[])), post_in(&inch_machine, &stream_with(&[]), "mm")] {
+        assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+        assert_eq!(out.program, golden, "an inch machine file must not make an inch program");
+    }
+    let mm = post_in(&dialect(), &stream_with(&[]), "mm");
+    assert_eq!(mm.program, golden, "Units mm posts what no unit posted");
+    let inch = post_in(&dialect(), &stream_with(&[]), "inch");
+    assert!(inch.warnings.is_empty(), "{:?}", inch.warnings);
+    let (a, b): (Vec<&str>, Vec<&str>) = (mm.program.lines().collect(), inch.program.lines().collect());
+    assert_eq!(a.len(), b.len(), "mm:\n{}\ninch:\n{}", mm.program, inch.program);
+    for (la, lb) in a.iter().zip(&b) {
+        if *la == "G21" {
+            assert_eq!(*lb, "G20", "the inch code replaces the metric one");
+            continue;
+        }
+        let (wa, wb): (Vec<&str>, Vec<&str>) = (la.split_whitespace().collect(), lb.split_whitespace().collect());
+        assert_eq!(wa.len(), wb.len(), "`{la}` vs `{lb}`");
+        for (x, y) in wa.iter().zip(&wb) {
+            let num = |w: &str| w.get(1..).and_then(|s| s.parse::<f64>().ok()).map(|v| (w.as_bytes()[0], v));
+            match (num(x), num(y)) {
+                (Some((lx, vx)), Some((ly, vy))) if lx == ly && b"XYZHF".contains(&lx) && !la.starts_with('(') => {
+                    let want = vx / 25.4;
+                    assert!((vy - want).abs() <= 0.0005 / 25.4 + 0.00005 + 1e-9, "{x} -> {y} (want {want:.5})");
+                }
+                _ => assert_eq!(x, y, "`{la}` vs `{lb}`"),
+            }
+        }
+    }
+    assert!(!b.contains(&"G21"), "no metric code in an inch program:\n{}", inch.program);
+    assert!(b.iter().any(|l| l.starts_with("M100 H0.5906")), "the 15 mm pickup in inches:\n{}", inch.program);
+    // The burn's depth: 14.05 mm is 0.5531 in.
+    assert!(b.contains(&"M101 Z0.5531"), "the burn depth in inches:\n{}", inch.program);
+}
+
 #[test]
 fn the_sinker_burn_posts_to_its_golden_against_the_fixture_dialect() {
     let out = post(&dialect(), &stream_with(&[]));
@@ -114,11 +163,11 @@ fn every_missing_sinker_code_refuses_the_post_by_name() {
         let want = format!("states no edm.codes.{role}");
         assert!(out.warnings.iter().any(|w| w.contains(&want)), "{role}: {:?}", out.warnings);
     }
-    // An inch machine needs the inch word, not the metric one.
+    // An inch document needs the inch word, not the metric one (#902,
+    // #1382: the document's unit, not the machine file's).
     let mut m = dialect();
-    m["kinematics"]["default"]["units"]["length"] = json!("inch");
     m["edm"]["codes"].as_object_mut().expect("codes").remove("inch");
-    let out = post(&m, &stream_with(&[]));
+    let out = post_in(&m, &stream_with(&[]), "inch");
     assert!(out.warnings.iter().any(|w| w.contains("states no edm.codes.inch")), "{:?}", out.warnings);
     // No codes at all (the library template's section, before its
     // codes are filled from the manual).
