-    self, FeatureSel, GeoSel, Height, OpParams, OpStatus, SrcRef, WireContourOp, WireFourAxis, WirePairingRule, WireSide,
+    self, FeatureSel, GeoSel, Height, OpParams, OpStatus, SrcRef, WireContourOp, WireFourAxis, WirePairingRule, WireSide, WireTabs,
     WireSyncPair,
 };
 use camcraft_app::posting::{self, BUILTINS};
@@ -356,6 +356,16 @@ fn a_burnout_or_a_machine_missing_a_taper_code_refuses_the_4_axis_cut_by_name()
     }
 }
 
+/// M3's review of PR #1181: a 4-axis cut asked with tabs is refused at
+/// generation by name - the ruled generator does not cut tabs.
+#[test]
+fn tabs_beside_a_4_axis_cut_are_refused_by_name() {
+    let tabs = WireTabs { count: Some(1), width: Some(2.0), at: vec![[4.0, 0.0]], cutoff_condition: String::new() };
+    let (_, made) = punch(FIXTURE, loft(&square(8.0), &circle(9.6)), &[H, 0.0], WireContourOp { tabs: Some(tabs), ..wire_op(Some(arc())) });
+    let err = made.expect_err("a 4-axis cut with tabs");
+    assert!(err.contains("a 4-axis cut is asked with tabs - tabs are cut on a one-profile contour only"), "{err}");
+}
+
 /// Done means: a ruling whose kerf burns into the part blocks the post -
 /// the wire laws read the ruled kerf at every judged height.
 #[test]
diff --git a/crates/motion/src/wire_edm/ruled_tests.rs b/crates/motion/src/wire_edm/ruled_tests.rs
index e2615019a..491300afd 100644
--- a/crates/motion/src/wire_edm/ruled_tests.rs
+++ b/crates/motion/src/wire_edm/ruled_tests.rs
@@ -283,3 +283,17 @@ fn a_lead_whose_leaning_kerf_enters_the_paired_surface_is_refused_by_name() {
     assert!(why.contains("the lead from the start hole would bring the leaning wire's kerf"), "{why}");
     assert!(why.contains("into the paired surface") && why.contains("move the start hole"), "{why}");
 }
+
+/// The crossing law: rulings whose mid-height section is a bow tie
+/// (corners 2 and 3 swapped) are refused by name, a plain one passes.
+#[test]
+fn a_section_that_crosses_itself_is_refused_by_name() {
+    let ring = |c: [(f64, f64); 4]| -> Vec<(Point2, Point2)> {
+        c.iter().map(|&(x, y)| (Point2::new(x - 1.0, y - 1.0), Point2::new(x + 1.0, y + 1.0))).collect()
+    };
+    let bow = ring([(0.0, 0.0), (10.0, 10.0), (10.0, 0.0), (0.0, 10.0)]);
+    let why = ruled_laws::crossing(&bow, 0.0, 12.0).expect_err("a bow tie").to_string();
+    assert!(why.contains("the paired surface crosses itself at Z"), "{why}");
+    let square = ring([(0.0, 0.0), (10.0, 0.0), (10.0, 10.0), (0.0, 10.0)]);
+    ruled_laws::crossing(&square, 0.0, 12.0).expect("a simple section passes");
+}
