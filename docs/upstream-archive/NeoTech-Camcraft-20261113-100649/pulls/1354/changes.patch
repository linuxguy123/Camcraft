From 680801bdae65e2f5e466c0f81e82a2fb4e2cc3c5 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Fri, 13 Nov 2026 04:07:16 +0100
Subject: [PATCH] test(pick): give each MCP box_pick test its own temp STL dir

write_plate_stl() wrote into a pid-named directory and removed it first,
so the two MCP tests of the binary deleted each other's plate.stl when
they ran in parallel (import_model os error 3, a flaky red batch gate).
Each call now gets a directory unique by pid and a process-wide counter,
and nothing is removed.

Fixes #1353

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 crates/app/tests/box_pick.rs | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/crates/app/tests/box_pick.rs b/crates/app/tests/box_pick.rs
index f971c0dc5..429b2f499 100644
--- a/crates/app/tests/box_pick.rs
+++ b/crates/app/tests/box_pick.rs
@@ -13,6 +13,7 @@
 
 use std::path::PathBuf;
 use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
 
 use camcraft_app::geometry::{Point3, Triangle};
 use camcraft_app::mcp::Server;
@@ -184,10 +185,13 @@ fn degenerate_boxes_take_nothing() {
 
 // ---- the MCP twin --------------------------------------------------------
 
+/// Writes the plate STL into a directory unique to this call (pid plus a
+/// process-wide counter), so parallel tests never share or delete each other's file.
 fn write_plate_stl() -> PathBuf {
+    static CALLS: AtomicUsize = AtomicUsize::new(0);
+    let n = CALLS.fetch_add(1, Ordering::Relaxed);
     let mut dir = std::env::temp_dir();
-    dir.push(format!("camcraft-box-pick-{}", std::process::id()));
-    let _ = std::fs::remove_dir_all(&dir);
+    dir.push(format!("camcraft-box-pick-{}-{n}", std::process::id()));
     std::fs::create_dir_all(&dir).expect("temp dir");
     let path = dir.join("plate.stl");
     let mut s = String::from("solid plate\n");
