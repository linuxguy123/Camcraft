 fn a_peck_counts_the_inch_increment() {
     let peck = cnc::Record::Cycle(cnc::CycleRec {
         kind: CycleKind::Deep, x: 0.0, y: 0.0, r_z: 22.0, bottom_z: 10.0, entry_z: 20.0, peck: 1.0, dwell: 0.5,
