+    let cases: [(&str, &str, &str, &[&str]); 3] = [
+        ("fanuc", "assets/machines/tilthead.mch", rtcp, &["A37.5", "B0", "A0", "B12.25", "A-45"]),
+        ("doosan-dnm", "assets/machines/tilthead.mch", rtcp, &["A37.5", "B0", "A0", "B12.25", "A-45"]),
