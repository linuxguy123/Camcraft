+            let plain = engine::run(&cps, &mch, &stream).unwrap_or_else(|e| panic!("{stem} on {g}: {e}"));
+            assert_eq!(plain.program, mm.program, "{stem} on {g}: Units mm must post what no unit posted");
+        }
+        assert!(posted >= 5, "{stem}: most goldens post ({posted})");
+    }
+}
