From 0eb87801ab253176b9c1554c23014b5b616ff408 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Thu, 12 Nov 2026 22:57:58 -0800
Subject: [PATCH] test(sinker): write the rough/finish pair as two CL goldens,
 one stream each

sinker_undersize wrote the rough and finish CL texts concatenated into one
golden, so the file held two ; HSMW-CL headers. The CL reader merges them
into one path, so camcraft-cl's cl_text_round_trips_every_golden failed on
main. Each pass is now its own golden; the bytes are the same two streams.

Fixes #1374

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 ..._finish_pair.cl => sinker_rough_finish_pair_finish.cl} | 5 -----
 crates/app/tests/golden/sinker_rough_finish_pair_rough.cl | 5 +++++
 crates/app/tests/sinker_undersize.rs                      | 8 +++++---
 3 files changed, 10 insertions(+), 8 deletions(-)
 rename crates/app/tests/golden/{sinker_rough_finish_pair.cl => sinker_rough_finish_pair_finish.cl} (50%)
 create mode 100644 crates/app/tests/golden/sinker_rough_finish_pair_rough.cl

diff --git a/crates/app/tests/golden/sinker_rough_finish_pair.cl b/crates/app/tests/golden/sinker_rough_finish_pair_finish.cl
similarity index 50%
rename from crates/app/tests/golden/sinker_rough_finish_pair.cl
rename to crates/app/tests/golden/sinker_rough_finish_pair_finish.cl
index 5080f4060..1c3f3df80 100644
--- a/crates/app/tests/golden/sinker_rough_finish_pair.cl
+++ b/crates/app/tests/golden/sinker_rough_finish_pair_finish.cl
@@ -1,10 +1,5 @@
 ; HSMW-CL v1 scale=0.001mm moves=3
 START 0 0 25000
 Rapid 0 0 25000
-Feed 0 0 14300 F40000
-Rapid 0 0 25000
-; HSMW-CL v1 scale=0.001mm moves=3
-START 0 0 25000
-Rapid 0 0 25000
 Feed 0 0 14020 F40000
 Rapid 0 0 25000
diff --git a/crates/app/tests/golden/sinker_rough_finish_pair_rough.cl b/crates/app/tests/golden/sinker_rough_finish_pair_rough.cl
new file mode 100644
index 000000000..e62169198
--- /dev/null
+++ b/crates/app/tests/golden/sinker_rough_finish_pair_rough.cl
@@ -0,0 +1,5 @@
+; HSMW-CL v1 scale=0.001mm moves=3
+START 0 0 25000
+Rapid 0 0 25000
+Feed 0 0 14300 F40000
+Rapid 0 0 25000
diff --git a/crates/app/tests/sinker_undersize.rs b/crates/app/tests/sinker_undersize.rs
index 9bced30d6..2eb3a1878 100644
--- a/crates/app/tests/sinker_undersize.rs
+++ b/crates/app/tests/sinker_undersize.rs
@@ -171,9 +171,11 @@ fn a_rough_finish_pair_reaches_the_finished_size_in_the_sim() {
         sim.dev.max_gouge_at
     );
 
-    // The pair's CL, rough then finish, is golden.
-    let text = [common::gen_to_cltext(&path_of(&world, "Rough").path), common::gen_to_cltext(&path_of(&world, "Finish").path)].concat();
-    common::write_golden("sinker_rough_finish_pair.cl", &text);
+    // The pair's CL is golden, one stream per file (#1374): a single file
+    // holding two CL headers is not one CL text, so the CL reader's
+    // round trip over every golden (camcraft-cl headless_bin) could not read it back.
+    common::write_golden("sinker_rough_finish_pair_rough.cl", &common::gen_to_cltext(&path_of(&world, "Rough").path));
+    common::write_golden("sinker_rough_finish_pair_finish.cl", &common::gen_to_cltext(&path_of(&world, "Finish").path));
 }
 
 #[test]
