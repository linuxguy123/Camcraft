index 000000000..c7a369c0e
--- /dev/null
+++ b/crates/ui/src/egui_app/ai_chat/transport.rs
@@ -0,0 +1,347 @@
+//! Provider transport abstraction, offline/confirmation guards, and envelope helpers (#1946).
+//! Provenance: our own code wrapping camcraft-app's provider schemas and fallback helpers; no vendor material involved.
+
+use std::io::Cursor;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use camcraft_app::mcp::provider::{FallbackMode, Provider, prompt_context, qa_context, tools};
+use serde_json::{Value, json};
+
+/// Whether a preset targets a remote cloud API or a local/loopback model runtime.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum EndpointKind {
+    Cloud,
+    Local,
+}
+
+/// Static configuration for one selectable AI provider/endpoint option in the panel.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ProviderPreset {
+    pub id: String,
+    pub label: String,
+    pub provider: Provider,
+    pub endpoint_kind: EndpointKind,
+    pub default_model: String,
+    pub fallback_mode: FallbackMode,
+}
+
+/// Optional snapshot of currently selected document entities/operation sent only on opt-in.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct SelectionSnapshot {
+    pub selected_entities: Vec<String>,
+    pub active_setup: Option<String>,
+    pub selected_operation: Option<String>,
+}
+
+/// Optional PNG viewport screenshot attachment sent only on opt-in.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ScreenshotAttachment {
+    pub mime_type: String,
+    pub data_base64: String,
+}
+
+/// One message entry carried in a provider request across tool steps.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct TurnMessage {
+    pub role: String,
+    pub text: String,
+    pub selection: Option<SelectionSnapshot>,
+    pub screenshot: Option<ScreenshotAttachment>,
+    pub raw: Option<Value>,
+}
+
+/// Complete request passed to a [`ChatTransport`] for one model completion step.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct TransportRequest {
+    pub preset: ProviderPreset,
+    pub model: String,
+    pub offline_only: bool,
+    pub fallback_mode: FallbackMode,
+    pub tools_payload: Value,
+    pub messages: Vec<TurnMessage>,
+}
+
+/// Normalized response from a [`ChatTransport`].
+// Constructed by scripted test backends and the upcoming live HTTP provider (#1945).
+#[cfg_attr(not(test), allow(dead_code))]
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum TransportOutput {
+    AssistantResponse {
+        text: String,
+        envelope: Value,
+        fallback_override: Option<FallbackMode>,
+    },
+}
+
+/// Boundary between the background chat worker and network/scripted transports.
+pub(crate) trait ChatTransport: Send + Sync {
+    fn complete(
+        &self,
+        req: &TransportRequest,
+        cancel: &AtomicBool,
+    ) -> Result<TransportOutput, String>;
+}
+
+/// Default offline-safe transport used until an HTTP endpoint transport (#1945) is wired.
+pub(crate) struct DefaultTransport;
+
+impl ChatTransport for DefaultTransport {
+    fn complete(
+        &self,
+        req: &TransportRequest,
+        cancel: &AtomicBool,
+    ) -> Result<TransportOutput, String> {
+        if cancel.load(Ordering::Relaxed) {
+            return Err("cancelled".to_owned());
+        }
+        check_offline_policy(req.offline_only, req.preset.endpoint_kind, &req.preset.label)?;
+        Err(format!(
+            "no live transport endpoint is configured for '{}'",
+            req.preset.label
+        ))
+    }
+}
+
+/// Built-in provider presets offered in the AI Chat panel's Provider selector.
+#[must_use]
+pub(crate) fn default_presets() -> Vec<ProviderPreset> {
+    vec![
+        ProviderPreset {
+            id: "anthropic".to_owned(),
+            label: "Anthropic (Cloud)".to_owned(),
+            provider: Provider::Anthropic,
+            endpoint_kind: EndpointKind::Cloud,
+            default_model: "claude-sonnet-4-20250514".to_owned(),
+            fallback_mode: FallbackMode::Native,
+        },
+        ProviderPreset {
+            id: "openai-responses".to_owned(),
+            label: "OpenAI Responses (Cloud)".to_owned(),
+            provider: Provider::OpenAiResponses,
+            endpoint_kind: EndpointKind::Cloud,
+            default_model: "gpt-4.1".to_owned(),
+            fallback_mode: FallbackMode::Native,
+        },
+        ProviderPreset {
+            id: "openai-chat".to_owned(),
+            label: "OpenAI Chat (Cloud)".to_owned(),
+            provider: Provider::OpenAiChat,
+            endpoint_kind: EndpointKind::Cloud,
+            default_model: "gpt-4.1".to_owned(),
+            fallback_mode: FallbackMode::Native,
+        },
+        ProviderPreset {
+            id: "gemini".to_owned(),
+            label: "Gemini (Cloud)".to_owned(),
+            provider: Provider::Gemini,
+            endpoint_kind: EndpointKind::Cloud,
+            default_model: "gemini-2.5-flash".to_owned(),
+            fallback_mode: FallbackMode::Native,
+        },
+        ProviderPreset {
+            id: "local-ollama".to_owned(),
+            label: "Offline local (Ollama)".to_owned(),
+            provider: Provider::OpenAiChat,
+            endpoint_kind: EndpointKind::Local,
+            default_model: "qwen2.5:14b".to_owned(),
+            fallback_mode: FallbackMode::Native,
+        },
+        ProviderPreset {
+            id: "local-prompt-json".to_owned(),
+            label: "Local Prompt-JSON".to_owned(),
+            provider: Provider::OpenAiChat,
+            endpoint_kind: EndpointKind::Local,
+            default_model: "qwen2.5:7b".to_owned(),
+            fallback_mode: FallbackMode::PromptJson,
+        },
+        ProviderPreset {
+            id: "local-readonly".to_owned(),
+            label: "Local Q&A (Read-Only)".to_owned(),
+            provider: Provider::OpenAiChat,
+            endpoint_kind: EndpointKind::Local,
+            default_model: "llama3.2".to_owned(),
+            fallback_mode: FallbackMode::ReadOnly,
+        },
+    ]
+}
+
+/// Guard that refuses any cloud preset when offline-only mode is active.
+pub(crate) fn check_offline_policy(
+    offline_only: bool,
+    endpoint: EndpointKind,
+    preset_label: &str,
+) -> Result<(), String> {
+    if offline_only && endpoint == EndpointKind::Cloud {
+        return Err(format!(
+            "offline-only mode blocks cloud provider '{preset_label}'"
+        ));
+    }
+    Ok(())
+}
+
+/// Allowlist of read-only inspection/suggestion MCP tools that need no user confirmation.
+fn is_read_only_tool(name: &str) -> bool {
+    matches!(
+        name,
+        "get_job"
+            | "list_operation_types"
+            | "list_tool_catalog"
+            | "list_holder_library"
+            | "list_features"
+            | "get_operation_geometry"
+            | "get_tool_cutter_profile"
+            | "suggest_cutting_data"
+    )
+}
+
+/// Guard deciding whether a tool invocation must wait for explicit inline Allow/Deny.
+#[must_use]
+pub(crate) fn requires_confirmation(tool_name: &str, mode: FallbackMode) -> bool {
+    match mode {
+        FallbackMode::ReadOnly => true,
+        FallbackMode::PromptJson => !is_read_only_tool(tool_name),
+        FallbackMode::Native => matches!(
+            tool_name,
+            "post"
+                | "open_project"
+                | "save_project"
+                | "import_model"
+                | "import_tool_library"
+                | "export_tool_library"
+        ),
+    }
+}
+
+/// Build the provider/fallback tool schema payload sent alongside chat messages.
+#[must_use]
+pub(crate) fn build_tools_payload(provider: Provider, mode: FallbackMode, project: &Value) -> Value {
+    match mode {
+        FallbackMode::Native => json!({ "tools": tools(provider) }),
+        FallbackMode::PromptJson => prompt_context(project),
+        FallbackMode::ReadOnly => qa_context(project),
+    }
+}
+
+/// Extract readable assistant prose from an explicit string or provider response envelope.
+#[must_use]
+pub(crate) fn extract_assistant_text(
+    provider: Provider,
+    envelope: &Value,
+    explicit_text: &str,
+) -> String {
+    if !explicit_text.is_empty() {
+        return explicit_text.to_owned();
+    }
+    let mut parts = Vec::new();
+    match provider {
+        Provider::Anthropic => {
+            if let Some(items) = envelope.get("content").and_then(Value::as_array) {
+                for item in items {
+                    if item.get("type").and_then(Value::as_str) == Some("text")
+                        && let Some(t) = item.get("text").and_then(Value::as_str)
+                    {
+                        parts.push(t);
+                    }
+                }
+            }
+        }
+        Provider::OpenAiChat => {
+            if let Some(msg) = envelope
+                .get("choices")
+                .and_then(|c| c.get(0))
+                .and_then(|c| c.get("message"))
+                .and_then(|m| m.get("content"))
+                .and_then(Value::as_str)
+            {
+                parts.push(msg);
+            }
+        }
+        Provider::OpenAiResponses => {
+            if let Some(t) = envelope.get("output_text").and_then(Value::as_str) {
+                parts.push(t);
+            } else if let Some(items) = envelope.get("output").and_then(Value::as_array) {
+                for item in items {
+                    if let Some(content) = item.get("content").and_then(Value::as_array) {
+                        for block in content {
+                            if let Some(t) = block.get("text").and_then(Value::as_str) {
+                                parts.push(t);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        Provider::Gemini => {
+            if let Some(items) = envelope
+                .get("candidates")
+                .and_then(|c| c.get(0))
+                .and_then(|c| c.get("content"))
+                .and_then(|c| c.get("parts"))
+                .and_then(Value::as_array)
+            {
+                for item in items {
+                    if let Some(t) = item.get("text").and_then(Value::as_str) {
+                        parts.push(t);
+                    }
+                }
+            }
+        }
+    }
+    parts.join("\n")
+}
+
+/// Encode RGBA pixels into an in-memory PNG byte buffer without unwrap/expect.
+pub(crate) fn encode_png_rgba(width: u32, height: u32, rgba: Vec<u8>) -> Result<Vec<u8>, String> {
+    let img = image::RgbaImage::from_raw(width, height, rgba)
+        .ok_or_else(|| "screenshot buffer size did not match image dimensions".to_owned())?;
+    let mut out = Vec::new();
+    img.write_to(&mut Cursor::new(&mut out), image::ImageFormat::Png)
+        .map_err(|e| format!("failed to encode PNG screenshot: {e}"))?;
+    Ok(out)
+}
+
+/// Standard RFC 4648 base64 encoder for inline PNG attachments.
+#[must_use]
+pub(crate) fn encode_base64(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let b0 = usize::from(chunk[0]);
+        let b1 = usize::from(chunk.get(1).copied().unwrap_or(0));
+        let b2 = usize::from(chunk.get(2).copied().unwrap_or(0));
+        let triple = (b0 << 16) | (b1 << 8) | b2;
+        out.push(char::from(TABLE[(triple >> 18) & 0x3f]));
+        out.push(char::from(TABLE[(triple >> 12) & 0x3f]));
+        out.push(if chunk.len() > 1 {
+            char::from(TABLE[(triple >> 6) & 0x3f])
+        } else {
+            '='
+        });
+        out.push(if chunk.len() > 2 {
+            char::from(TABLE[triple & 0x3f])
+        } else {
+            '='
+        });
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn offline_policy_refuses_cloud_and_allows_local() {
+        assert!(check_offline_policy(true, EndpointKind::Cloud, "Anthropic").is_err());
+        assert!(check_offline_policy(true, EndpointKind::Local, "Ollama").is_ok());
+        assert!(check_offline_policy(false, EndpointKind::Cloud, "Anthropic").is_ok());
+    }
+
+    #[test]
+    fn base64_and_png_round_trip() {
+        assert_eq!(encode_base64(b"hi!"), "aGkh");
+        let png = encode_png_rgba(2, 2, vec![40; 16]).expect("valid png");
+        assert!(png.starts_with(b"\x89PNG"));
+        assert!(!encode_base64(&png).is_empty());
+    }
+}
diff --git a/crates/ui/src/egui_app/ai_chat/turn.rs b/crates/ui/src/egui_app/ai_chat/turn.rs
new file mode 100644
index 000000000..bf468eb7c
--- /dev/null
+++ b/crates/ui/src/egui_app/ai_chat/turn.rs
@@ -0,0 +1,179 @@
+//! Per-turn transcript record, history span tracking, and undo guard (#1946).
+//! Provenance: our own turn model over camcraft-app History; no vendor material involved.
+
+use camcraft_app::commands::History;
+use flecs_ecs::prelude::World;
+
+use super::transport::{ScreenshotAttachment, SelectionSnapshot, TurnMessage};
+use super::worker::{ToolCard, ToolCardStatus, TurnFinish};
+
+/// Lifecycle state of one submitted user/assistant turn in the panel log.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum TurnStatus {
+    Running,
+    Completed,
+    Cancelled,
+    Failed(String),
+}
+
+/// One user prompt plus the streamed assistant reply, tool cards, and undo span.
+#[derive(Clone, Debug)]
+pub(crate) struct ChatTurn {
+    pub id: u64,
+    pub prompt: String,
+    pub assistant_text: String,
+    pub tool_cards: Vec<ToolCard>,
+    pub status: TurnStatus,
+    pub start_depth: usize,
+    pub end_depth: Option<usize>,
+    pub change_count: usize,
+    pub undone: bool,
+    selection: Option<SelectionSnapshot>,
+    screenshot: Option<ScreenshotAttachment>,
+}
+
+impl ChatTurn {
+    /// Construct a turn record that immediately failed pre-flight policy checks.
+    pub(super) fn failed(id: u64, prompt: String, start_depth: usize, err: String) -> Self {
+        Self {
+            id,
+            prompt,
+            assistant_text: String::new(),
+            tool_cards: Vec::new(),
+            status: TurnStatus::Failed(err),
+            start_depth,
+            end_depth: None,
+            change_count: 0,
+            undone: false,
+            selection: None,
+            screenshot: None,
+        }
+    }
+
+    /// Construct a running turn capturing the baseline history depth and optional attachments.
+    pub(super) fn running(
+        id: u64,
+        prompt: String,
+        start_depth: usize,
+        selection: Option<SelectionSnapshot>,
+        screenshot: Option<ScreenshotAttachment>,
+    ) -> Self {
+        Self {
+            id,
+            prompt,
+            assistant_text: String::new(),
+            tool_cards: Vec::new(),
+            status: TurnStatus::Running,
+            start_depth,
+            end_depth: None,
+            change_count: 0,
+            undone: false,
+            selection,
+            screenshot,
+        }
+    }
+
+    /// True only while this turn sits at the very top of `History` and has not yet been undone.
+    #[must_use]
+    pub(crate) fn can_undo(&self, current_done_len: usize) -> bool {
+        !matches!(self.status, TurnStatus::Running)
+            && !self.undone
+            && self.change_count > 0
+            && self.end_depth == Some(current_done_len)
+    }
+
+    /// Append assistant output streamed from the worker.
+    pub(super) fn append_assistant_text(&mut self, text: &str) {
+        if !self.assistant_text.is_empty() {
+            self.assistant_text.push('\n');
+        }
+        self.assistant_text.push_str(text);
+    }
+
+    /// Update one inline tool card's status and summary in place.
+    pub(super) fn update_tool_card(&mut self, id: &str, status: ToolCardStatus, summary: String) {
+        if let Some(card) = self.tool_cards.iter_mut().find(|c| c.id == id) {
+            card.status = status;
+            card.summary = summary;
+        }
+    }
+
+    /// Finalize this turn's terminal status and close its undo depth span.
+    pub(super) fn finish(&mut self, status: TurnFinish, current_done_len: usize) -> Option<String> {
+        // Only record an undo span when every post-turn command belongs to this turn contiguously.
+        self.end_depth = (self.change_count > 0
+            && current_done_len == self.start_depth + self.change_count)
+            .then_some(current_done_len);
+        match status {
+            TurnFinish::Completed => {
+                self.status = TurnStatus::Completed;
+                None
+            }
+            TurnFinish::Cancelled => {
+                self.status = TurnStatus::Cancelled;
+                None
+            }
+            TurnFinish::Failed(msg) => {
+                self.status = TurnStatus::Failed(msg.clone());
+                Some(msg)
+            }
+        }
+    }
+
+    /// Revert all contiguous commands created during this turn, refusing if later edits exist.
+    pub(super) fn undo(
+        &mut self,
+        world: &World,
+        history: &mut History,
+        doc_version: &mut u64,
+    ) -> Result<String, String> {
+        if !self.can_undo(history.done_len()) {
+            return Err(
+                "cannot undo AI turn: later document edits exist or turn already undone".to_owned(),
+            );
+        }
+        let steps = self.change_count;
+        for _ in 0..steps {
+            let _ = history.undo(world);
+        }
+        self.undone = true;
+        *doc_version += 1;
+        Ok(format!("undid AI turn ({steps} changes)"))
+    }
+}
+
+/// Assemble ordered conversation messages from prior turns plus the new prompt and opt-in context.
+pub(super) fn build_turn_messages(
+    prior_turns: &[ChatTurn],
+    prompt: &str,
+    selection: Option<SelectionSnapshot>,
+    screenshot: Option<ScreenshotAttachment>,
+) -> Vec<TurnMessage> {
+    let mut messages = Vec::new();
+    for prior in prior_turns {
+        messages.push(TurnMessage {
+            role: "user".to_owned(),
+            text: prior.prompt.clone(),
+            selection: prior.selection.clone(),
+            screenshot: prior.screenshot.clone(),
+            raw: None,
+        });
+        if !prior.assistant_text.is_empty() {
+            messages.push(TurnMessage {
+                role: "assistant".to_owned(),
+                text: prior.assistant_text.clone(),
+                selection: None,
+                screenshot: None,
+                raw: None,
+            });
+        }
+    }
+    messages.push(TurnMessage {
+        role: "user".to_owned(),
+        text: prompt.to_owned(),
+        selection,
+        screenshot,
+        raw: None,
+    });
+    messages
+}
