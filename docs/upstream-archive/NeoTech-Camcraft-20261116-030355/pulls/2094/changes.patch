+    let transport = ScriptedTransport::new(vec![Ok(TransportOutput::AssistantResponse {
+        text: r#"{"tool":"post","arguments":{"output":"/tmp/should-not-run.nc"}}"#.to_owned(),
+        envelope: Value::Null,
