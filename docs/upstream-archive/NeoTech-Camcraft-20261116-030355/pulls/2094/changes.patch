+//! Native egui layout for the `Tab::AiChat` dock pane (#1946).
+//! Provenance: our own egui layout using CamCraft tokens and colorvision text inks; no vendor material involved.
+
+use camcraft_app::mcp::provider::FallbackMode;
+use egui::{Color32, RichText, ScrollArea, Ui};
+
+use crate::state::State;
+
+use super::super::{colorvision, theme};
+use super::turn::{ChatTurn, TurnStatus};
+use super::worker::{ConfirmRequest, ToolCardStatus};
+
+/// Render the AI Chat panel inside its dock leaf.
+pub(crate) fn draw(ui: &mut Ui, state: &mut State) {
+    let pal = theme::current();
+    let inks = colorvision::text_inks(ui, &state.world);
+    let mut actions = PanelActions::default();
+
+    egui::Frame::NONE
+        .inner_margin(egui::Margin::same(8))
+        .show(ui, |ui| {
+            draw_header(ui, state, &pal);
+            draw_banners(ui, state, inks);
+            ui.add_space(4.0);
+
+            if let Some(req) = state.ai_chat.pending_confirm().cloned() {
+                draw_confirm_banner(ui, &req, inks, &pal, &mut actions);
+                ui.add_space(4.0);
+            }
+
+            let done_len = state.history.done_len();
+            let avail_h = (ui.available_height() - 88.0).max(80.0);
+            ScrollArea::vertical()
+                .id_salt("ai_chat_transcript")
+                .max_height(avail_h)
+                .stick_to_bottom(true)
+                .show(ui, |ui| {
+                    draw_transcript(ui, state.ai_chat.turns(), done_len, inks, &pal, &mut actions);
+                });
+
+            ui.add_space(6.0);
+            draw_composer(ui, state, &mut actions);
+        });
+
+    apply_panel_actions(state, actions);
+}
+
+#[derive(Default)]
+struct PanelActions {
+    submit: bool,
+    cancel: bool,
+    confirm_choice: Option<bool>,
+    undo_turn_id: Option<u64>,
+}
+
+fn draw_header(ui: &mut Ui, state: &mut State, pal: &theme::Tokens) {
+    let selected_idx = state.ai_chat.selected_preset_index();
+    let current_label = state.ai_chat.selected_preset().label.clone();
+    let mut next_preset = None;
+    ui.horizontal(|ui| {
+        egui::ComboBox::from_label("Provider")
+            .selected_text(current_label)
+            .width(185.0)
+            .show_ui(ui, |ui| {
+                for (i, preset) in state.ai_chat.presets().iter().enumerate() {
+                    if ui.selectable_label(i == selected_idx, &preset.label).clicked() {
+                        next_preset = Some(i);
+                    }
+                }
+            });
+    });
+    if let Some(idx) = next_preset {
+        state.ai_chat.select_preset(idx);
+    }
+
+    ui.horizontal(|ui| {
+        let model_lbl = ui.label("Model");
+        ui.add(
+            egui::TextEdit::singleline(&mut state.ai_chat.model_input)
+                .desired_width(f32::INFINITY),
+        )
+        .labelled_by(model_lbl.id);
+    });
+
+    ui.horizontal_wrapped(|ui| {
+        ui.checkbox(&mut state.ai_chat.offline_only, "Offline only");
+        ui.checkbox(&mut state.ai_chat.attach_selection, "Attach selection");
+        ui.checkbox(&mut state.ai_chat.attach_screenshot, "Attach screenshot");
+    });
+
+    let preset = state.ai_chat.selected_preset();
+    ui.label(
+        RichText::new(format!(
+            "Mode: {} · Endpoint: {}",
+            mode_label(preset.fallback_mode),
+            match preset.endpoint_kind {
+                super::EndpointKind::Cloud => "Cloud",
+                super::EndpointKind::Local => "Local",
+            }
+        ))
+        .small()
+        .color(pal.text_dim),
+    );
+}
+
+fn mode_label(mode: FallbackMode) -> &'static str {
+    match mode {
+        FallbackMode::Native => "Native tools",
+        FallbackMode::PromptJson => "Prompt JSON (confirm every edit)",
+        FallbackMode::ReadOnly => "Read-only Q&A",
+    }
+}
+
+fn draw_banners(ui: &mut Ui, state: &State, inks: colorvision::TextInks) {
+    if state.ai_chat.selected_preset().fallback_mode == FallbackMode::ReadOnly {
+        ui.add_space(4.0);
+        egui::Frame::group(ui.style())
+            .stroke(egui::Stroke::new(1.0, inks.warn))
+            .show(ui, |ui| {
+                ui.label(
+                    RichText::new("Read-only Q&A mode: tool execution is disabled.")
+                        .color(inks.warn)
+                        .strong(),
+                );
+            });
+    }
+    if let Some(err) = state.ai_chat.last_error() {
+        ui.add_space(4.0);
+        ui.label(RichText::new(err).color(inks.error));
+    }
+}
+
+fn draw_confirm_banner(
+    ui: &mut Ui,
+    req: &ConfirmRequest,
+    inks: colorvision::TextInks,
+    pal: &theme::Tokens,
+    actions: &mut PanelActions,
+) {
+    egui::Frame::group(ui.style())
+        .fill(pal.well)
+        .stroke(egui::Stroke::new(1.5, inks.warn))
+        .show(ui, |ui| {
+            ui.label(
+                RichText::new("Confirmation required")
+                    .color(inks.warn)
+                    .strong(),
+            );
+            ui.label(format!("Tool: {}", req.tool_name));
+            if let Ok(args) = serde_json::to_string_pretty(&req.arguments) {
+                ui.label(RichText::new(args).monospace().small().color(pal.text_dim));
+            }
+            ui.horizontal(|ui| {
+                if ui.button("Allow").clicked() {
+                    actions.confirm_choice = Some(true);
+                }
+                if ui.button("Deny").clicked() {
+                    actions.confirm_choice = Some(false);
+                }
+            });
+        });
+}
+
+fn draw_transcript(
+    ui: &mut Ui,
+    turns: &[ChatTurn],
+    done_len: usize,
+    inks: colorvision::TextInks,
+    pal: &theme::Tokens,
+    actions: &mut PanelActions,
+) {
+    if turns.is_empty() {
+        ui.label(
+            RichText::new("Ask a question or propose CAM edits.")
+                .color(pal.text_dim)
+                .small(),
+        );
+        return;
+    }
+    for turn in turns {
+        egui::Frame::group(ui.style())
+            .fill(pal.ink_alt)
+            .inner_margin(egui::Margin::same(6))
+            .show(ui, |ui| {
+                ui.label(RichText::new("You").strong().small().color(pal.text_dim));
+                ui.label(&turn.prompt);
+
+                ui.add_space(4.0);
+                for card in &turn.tool_cards {
+                    let status_color = match card.status {
+                        ToolCardStatus::Succeeded => pal.accent,
+                        ToolCardStatus::AwaitingConfirmation => inks.warn,
+                        ToolCardStatus::Failed | ToolCardStatus::Denied => inks.error,
+                        ToolCardStatus::Pending | ToolCardStatus::Running => pal.text_dim,
+                    };
+                    egui::Frame::group(ui.style())
+                        .fill(pal.well)
+                        .inner_margin(egui::Margin::same(4))
+                        .show(ui, |ui| {
+                            ui.horizontal_wrapped(|ui| {
+                                ui.label(RichText::new(&card.name).strong());
+                                ui.label(RichText::new(card.status.label()).color(status_color));
+                            });
+                            if !card.summary.is_empty() {
+                                ui.label(RichText::new(&card.summary).small().color(pal.text_dim));
+                            }
+                        });
+                }
+
+                if !turn.assistant_text.is_empty() {
+                    ui.add_space(3.0);
+                    ui.label(&turn.assistant_text);
+                }
+
+                match &turn.status {
+                    TurnStatus::Running => {
+                        ui.label(RichText::new("Working...").small().color(pal.accent));
+                    }
+                    TurnStatus::Cancelled => {
+                        ui.label(RichText::new("Cancelled").small().color(inks.warn));
+                    }
+                    TurnStatus::Failed(err) => {
+                        ui.label(RichText::new(format!("Failed: {err}")).small().color(inks.error));
+                    }
+                    TurnStatus::Completed => {}
+                }
+
+                if !matches!(turn.status, TurnStatus::Running) && turn.change_count > 0 {
+                    ui.add_space(4.0);
+                    ui.horizontal(|ui| {
+                        let note = if turn.undone {
+                            format!("Undone ({} changes reverted)", turn.change_count)
+                        } else {
+                            format!("{} changes in this turn", turn.change_count)
+                        };
+                        ui.label(RichText::new(note).small().color(pal.text_dim));
+                        if ui
+                            .add_enabled(turn.can_undo(done_len), egui::Button::new("Undo Turn"))
+                            .clicked()
+                        {
+                            actions.undo_turn_id = Some(turn.id);
+                        }
+                    });
+                }
+            });
+        ui.add_space(4.0);
+    }
+}
+
+fn draw_composer(ui: &mut Ui, state: &mut State, actions: &mut PanelActions) {
+    let prompt_lbl = ui.label("Prompt");
+    let resp = ui
+        .add(
+            egui::TextEdit::singleline(&mut state.ai_chat.prompt_draft)
+                .desired_width(f32::INFINITY),
+        )
+        .labelled_by(prompt_lbl.id);
+    if resp.lost_focus() && ui.input(|i| i.key_pressed(egui::Key::Enter)) {
+        actions.submit = true;
+    }
+
+    let running = state.ai_chat.is_running();
+    ui.horizontal(|ui| {
+        if ui
+            .add_enabled(!running, egui::Button::new("Send"))
+            .clicked()
+        {
+            actions.submit = true;
+        }
+        if ui
+            .add_enabled(running, egui::Button::new("Cancel"))
+            .clicked()
+        {
+            actions.cancel = true;
+        }
+    });
+}
+
+fn apply_panel_actions(state: &mut State, actions: PanelActions) {
+    if let Some(allow) = actions.confirm_choice {
+        state.ai_chat.resolve_confirmation(allow);
+    }
+    if actions.cancel {
+        state.ai_chat.cancel();
+    }
+    if let Some(turn_id) = actions.undo_turn_id {
+        state.ai_chat.undo_turn(
+            turn_id,
+            &state.world,
+            &mut state.history,
+            &mut state.doc_version,
+            &mut state.status,
+        );
+    }
+    if actions.submit {
+        state.submit_ai_prompt();
+    }
+}
+
+/// Default 32x32 RGBA viewport fill PNG used when no GPU frame hook is installed.
+pub(crate) fn fallback_viewport_png(bg: Color32) -> Result<Vec<u8>, String> {
+    let pixel = [bg.r(), bg.g(), bg.b(), 255];
+    let mut buf = Vec::with_capacity(32 * 32 * 4);
+    for _ in 0..(32 * 32) {
+        buf.extend_from_slice(&pixel);
+    }
+    super::transport::encode_png_rgba(32, 32, buf)
+}
diff --git a/crates/ui/src/egui_app/ai_chat/state.rs b/crates/ui/src/egui_app/ai_chat/state.rs
new file mode 100644
index 000000000..72cb88ade
--- /dev/null
+++ b/crates/ui/src/egui_app/ai_chat/state.rs
@@ -0,0 +1,355 @@
+//! Panel conversation state, opt-in context capture, and worker event draining (#1946).
+//! Provenance: our own state model over camcraft-app History and mpsc worker events; no vendor material involved.
+
+use std::sync::atomic::Ordering;
+use std::sync::{Arc, mpsc};
+
+use camcraft_app::commands::History;
+use camcraft_app::mcp::Request;
+use camcraft_app::model;
+use flecs_ecs::prelude::World;
+use serde_json::Value;
+
+use super::transport::{
+    ChatTransport, DefaultTransport, ProviderPreset, ScreenshotAttachment, SelectionSnapshot,
+    check_offline_policy, default_presets, encode_base64,
+};
+use super::turn::{ChatTurn, TurnStatus, build_turn_messages};
+use super::worker::{
+    ConfirmRequest, TurnFinish, TurnInput, WakeFn, WorkerEvent, WorkerHandle, spawn_turn,
+};
+
+/// UI-side state for the AI Chat dock tab, isolated from the CAM document.
+pub struct AiChatState {
+    presets: Vec<ProviderPreset>,
+    selected_preset: usize,
+    pub(crate) model_input: String,
+    pub offline_only: bool,
+    pub attach_selection: bool,
+    pub attach_screenshot: bool,
+    pub(crate) prompt_draft: String,
+    turns: Vec<ChatTurn>,
+    next_turn_id: u64,
+    pending_confirm: Option<ConfirmRequest>,
+    last_error: Option<String>,
+    worker: Option<(u64, WorkerHandle)>,
+    wake: Option<WakeFn>,
+    transport: Arc<dyn ChatTransport>,
+}
+
+impl Default for AiChatState {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl AiChatState {
+    /// Construct initial AI Chat state with the first preset active and attachments off by default.
+    #[must_use]
+    pub fn new() -> Self {
+        let presets = default_presets();
+        let model_input = presets
+            .first()
+            .map_or_else(String::new, |p| p.default_model.clone());
+        Self {
+            presets,
+            selected_preset: 0,
+            model_input,
+            offline_only: false,
+            attach_selection: false,
+            attach_screenshot: false,
+            prompt_draft: String::new(),
+            turns: Vec::new(),
+            next_turn_id: 1,
+            pending_confirm: None,
+            last_error: None,
+            worker: None,
+            wake: None,
+            transport: Arc::new(DefaultTransport),
+        }
+    }
+
+    pub(crate) fn presets(&self) -> &[ProviderPreset] {
+        &self.presets
+    }
+
+    pub(crate) fn selected_preset_index(&self) -> usize {
+        self.selected_preset.min(self.presets.len().saturating_sub(1))
+    }
+
+    pub(crate) fn selected_preset(&self) -> &ProviderPreset {
+        let idx = self.selected_preset_index();
+        &self.presets[idx]
+    }
+
+    /// Switch active preset and reset the model input to that preset's default model.
+    pub(crate) fn select_preset(&mut self, index: usize) {
+        if let Some(p) = self.presets.get(index) {
+            self.selected_preset = index;
+            self.model_input = p.default_model.clone();
+            self.last_error = None;
+        }
+    }
+
+    /// Replace the transport backend (used by offline tests and live provider configuration).
+    // Constructed by offline tests today and the live HTTP backend in #1945.
+    #[cfg_attr(not(test), allow(dead_code))]
+    pub(crate) fn set_transport(&mut self, transport: Arc<dyn ChatTransport>) {
+        self.transport = transport;
+    }
+
+    /// Register the UI event-loop wakeup callback invoked from background threads.
+    pub(crate) fn set_wake(&mut self, wake: WakeFn) {
+        self.wake = Some(wake);
+    }
+
+    /// True while a background worker thread is currently executing a turn.
+    #[must_use]
+    pub fn is_running(&self) -> bool {
+        self.worker.is_some()
+    }
+
+    pub(crate) fn turns(&self) -> &[ChatTurn] {
+        &self.turns
+    }
+
+    pub(crate) fn pending_confirm(&self) -> Option<&ConfirmRequest> {
+        self.pending_confirm.as_ref()
+    }
+
+    #[must_use]
+    pub fn last_error(&self) -> Option<&str> {
+        self.last_error.as_deref()
+    }
+
+    /// Capture state and launch one asynchronous turn on the background thread.
+    pub(crate) fn submit(
+        &mut self,
+        world: &World,
+        selected_op: Option<String>,
+        history_done_len: usize,
+        mcp_tx: &mpsc::Sender<Request>,
+        screenshot_png: Option<Result<Vec<u8>, String>>,
+        project_snapshot: Value,
+    ) {
+        if self.is_running() {
+            return;
+        }
+        let prompt = self.prompt_draft.trim().to_owned();
+        if prompt.is_empty() {
+            self.last_error = Some("Enter a prompt before sending.".to_owned());
+            return;
+        }
+        let preset = self.selected_preset().clone();
+        if let Err(err) =
+            check_offline_policy(self.offline_only, preset.endpoint_kind, &preset.label)
+        {
+            self.last_error = Some(err.clone());
+            self.prompt_draft.clear();
+            let turn_id = self.next_turn_id;
+            self.next_turn_id += 1;
+            self.turns
+                .push(ChatTurn::failed(turn_id, prompt, history_done_len, err));
+            return;
+        }
+
+        let screenshot = match self.capture_opt_in_screenshot(screenshot_png) {
+            Ok(shot) => shot,
+            Err(err) => {
+                self.last_error = Some(err);
+                return;
+            }
+        };
+        let selection = self.attach_selection.then(|| SelectionSnapshot {
+            selected_entities: model::selected_names(world),
+            active_setup: camcraft_app::setup::active(world),
+            selected_operation: selected_op,
+        });
+
+        self.prompt_draft.clear();
+        self.last_error = None;
+        self.pending_confirm = None;
+
+        let turn_id = self.next_turn_id;
+        self.next_turn_id += 1;
+        let initial_messages = build_turn_messages(&self.turns, &prompt, selection.clone(), screenshot.clone());
+        self.turns.push(ChatTurn::running(
+            turn_id,
+            prompt,
+            history_done_len,
+            selection,
+            screenshot,
+        ));
+
+        let model = if self.model_input.trim().is_empty() {
+            preset.default_model.clone()
+        } else {
+            self.model_input.trim().to_owned()
+        };
+        let handle = spawn_turn(TurnInput {
+            turn_id,
+            preset,
+            model,
+            offline_only: self.offline_only,
+            initial_messages,
+            project_snapshot,
+            transport: Arc::clone(&self.transport),
+            mcp_tx: mcp_tx.clone(),
+            wake: self.wake.clone(),
+        });
+        self.worker = Some((turn_id, handle));
+    }
+
+    fn capture_opt_in_screenshot(
+        &self,
+        screenshot_png: Option<Result<Vec<u8>, String>>,
+    ) -> Result<Option<ScreenshotAttachment>, String> {
+        if !self.attach_screenshot {
+            return Ok(None);
+        }
+        match screenshot_png {
+            Some(Ok(bytes)) => Ok(Some(ScreenshotAttachment {
+                mime_type: "image/png".to_owned(),
+                data_base64: encode_base64(&bytes),
+            })),
+            Some(Err(err)) => Err(format!("screenshot capture failed: {err}")),
+            None => Err("screenshot capture unavailable".to_owned()),
+        }
+    }
+
+    /// Record command commits performed by an in-app MCP tool call on the running turn.
+    pub(crate) fn note_mcp_execution(&mut self, delta_commands: usize) {
+        if delta_commands == 0 {
+            return;
+        }
+        if let Some((turn_id, _)) = &self.worker
+            && let Some(turn) = self.turns.iter_mut().find(|t| t.id == *turn_id)
+        {
+            turn.change_count += delta_commands;
+        }
+    }
+
+    /// Drain pending worker events onto UI state without blocking.
+    pub fn poll(&mut self, current_done_len: usize) {
+        let mut events = Vec::new();
+        let mut disconnected_turn = None;
+        if let Some((turn_id, handle)) = &self.worker {
+            loop {
+                match handle.rx.try_recv() {
+                    Ok(ev) => events.push(ev),
+                    Err(mpsc::TryRecvError::Empty) => break,
+                    Err(mpsc::TryRecvError::Disconnected) => {
+                        disconnected_turn = Some(*turn_id);
+                        break;
+                    }
+                }
+            }
+        }
+        for ev in events {
+            self.apply_event(ev, current_done_len);
+        }
+        if let Some(turn_id) = disconnected_turn
+            && self.worker.as_ref().is_some_and(|(id, _)| *id == turn_id)
+        {
+            self.finish_turn(
+                turn_id,
+                TurnFinish::Failed("AI chat worker disconnected unexpectedly".to_owned()),
+                current_done_len,
+            );
+        }
+    }
+
+    fn apply_event(&mut self, ev: WorkerEvent, current_done_len: usize) {
+        match ev {
+            WorkerEvent::AssistantText { turn_id, text } => {
+                if let Some(turn) = self.turns.iter_mut().find(|t| t.id == turn_id) {
+                    turn.append_assistant_text(&text);
+                }
+            }
+            WorkerEvent::ToolCardAdded { turn_id, card } => {
+                if let Some(turn) = self.turns.iter_mut().find(|t| t.id == turn_id) {
+                    turn.tool_cards.push(card);
+                }
+            }
+            WorkerEvent::ToolCardUpdated {
+                turn_id,
+                id,
+                status,
+                summary,
+            } => {
+                if let Some(turn) = self.turns.iter_mut().find(|t| t.id == turn_id) {
+                    turn.update_tool_card(&id, status, summary);
+                }
+            }
+            WorkerEvent::ConfirmNeeded(req) => {
+                self.pending_confirm = Some(req);
+            }
+            WorkerEvent::Finished { turn_id, status } => {
+                self.finish_turn(turn_id, status, current_done_len);
+            }
+        }
+    }
+
+    fn finish_turn(&mut self, turn_id: u64, status: TurnFinish, current_done_len: usize) {
+        self.pending_confirm = None;
+        self.worker = None;
+        if let Some(turn) = self.turns.iter_mut().find(|t| t.id == turn_id)
+            && let Some(err) = turn.finish(status, current_done_len)
+        {
+            self.last_error = Some(err);
+        }
+    }
+
+    /// Deliver the user's inline Allow or Deny choice back to the waiting worker.
+    pub(crate) fn resolve_confirmation(&mut self, allow: bool) {
+        if let Some(req) = self.pending_confirm.take() {
+            let _ = req.decision_tx.send(allow);
+        }
+    }
+
+    /// Signal the active worker via `Arc<AtomicBool>` to cancel promptly.
+    pub(crate) fn cancel(&mut self) {
+        if let Some((_, handle)) = &self.worker {
+            handle.cancel.store(true, Ordering::Relaxed);
+        }
+        self.pending_confirm = None;
+    }
+
+    /// Revert all contiguous commands executed during `turn_id` when no later edits exist.
+    pub(crate) fn undo_turn(
+        &mut self,
+        turn_id: u64,
+        world: &World,
+        history: &mut History,
+        doc_version: &mut u64,
+        status: &mut String,
+    ) {
+        let Some(turn) = self.turns.iter_mut().find(|t| t.id == turn_id) else {
+            return;
+        };
+        match turn.undo(world, history, doc_version) {
+            Ok(msg) => {
+                self.last_error = None;
+                *status = msg;
+            }
+            Err(msg) => {
+                self.last_error = Some(msg.clone());
+                *status = msg;
+            }
+        }
+    }
+
+    /// Cancel and join any running worker thread cleanly before shutdown or document reset.
+    pub fn shutdown(&mut self) {
+        self.pending_confirm = None;
+        if let Some((turn_id, handle)) = self.worker.take() {
+            handle.cancel.store(true, Ordering::Relaxed);
+            drop(handle);
+            if let Some(turn) = self.turns.iter_mut().find(|t| t.id == turn_id)
+                && matches!(turn.status, TurnStatus::Running)
+            {
+                turn.status = TurnStatus::Cancelled;
+            }
+        }
+    }
+}
diff --git a/crates/ui/src/egui_app/ai_chat/transport.rs b/crates/ui/src/egui_app/ai_chat/transport.rs
