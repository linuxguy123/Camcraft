diff --git a/crates/app/src/tool_profile_dxf.rs b/crates/app/src/tool_profile_dxf.rs
new file mode 100644
index 000000000..827cb03ed
--- /dev/null
+++ b/crates/app/src/tool_profile_dxf.rs
@@ -0,0 +1,173 @@
+//! DXF half-profile conversion for tool holders (#743): exports `SpunProfile`
+//! and aligned STEP holder envelopes to clean-room ASCII DXF (explicit
+//! `CENTRELINE` layer + open `PROFILE` chain of lines and arcs), and imports
+//! DXF half-profiles back into validated [`SpunProfile`] values with named
+//! refusals for every invalid or unaligned case.
+//! Provenance: Autodesk DXF Reference (ASCII HEADER/TABLES/ENTITIES) and planar
+//! projection onto the ISO 13399 aligned tool axis; original implementation.
+
+use std::f64::consts::TAU;
+use std::path::Path;
+
+use camcraft_geometry::dxf::{self, Layer, LayeredPrimitive, Primitive, Unit, Units, write};
+use camcraft_geometry::geo2d::Point2;
+use camcraft_tools::holder_profile::HolderProfile;
+use camcraft_tools::spun::{MIN_SEGMENT, SpunPoint, SpunProfile};
+
+use crate::commands::ToolBodySpec;
+use crate::geometry::Triangle;
+use crate::schema::ToolBody;
+use crate::tool_body::{self, BodyFrame};
+
+#[path = "tool_profile_dxf_import.rs"]
+mod import;
+pub use import::{dxf_to_spun, dxf_to_spun_with_unit};
+
+pub const CENTRELINE_LAYER: &str = "CENTRELINE";
+pub const PROFILE_LAYER: &str = "PROFILE";
+
+/// Export a validated [`SpunProfile`] as ASCII DXF in millimetres with a
+/// `CENTRELINE` line from `(0, 0)` to `(0, z_top)` and open `PROFILE`
+/// entities in `(x = r, y = z)` on the `+X` side.
+pub fn spun_to_dxf(profile: &SpunProfile) -> Result<String, String> {
+    let points = profile.points();
+    if points.len() < 3 {
+        return Err("cannot export empty holder profile to DXF".into());
+    }
+    let z_top = points.iter().map(|p| p.z).fold(0.0_f64, f64::max);
+    if !(z_top.is_finite() && z_top >= MIN_SEGMENT) {
+        return Err("holder profile has no positive length along the tool axis".into());
+    }
+    let mut doc = dxf::Document {
+        units: Units::Known(Unit::Millimeters),
+        elevation: Some(0.0),
+        layers: vec![
+            Layer {
+                name: CENTRELINE_LAYER.into(),
+                flags: 0,
+                color: 5,
+                line_type: "CENTER".into(),
+            },
+            Layer {
+                name: PROFILE_LAYER.into(),
+                flags: 0,
+                color: 7,
+                line_type: "CONTINUOUS".into(),
+            },
+        ],
+        primitives: Vec::with_capacity(points.len()),
+        ..dxf::Document::default()
+    };
+    doc.primitives.push(LayeredPrimitive {
+        layer: CENTRELINE_LAYER.into(),
+        primitive: Primitive::Line {
+            start: Point2::new(0.0, 0.0),
+            end: Point2::new(0.0, z_top),
+        },
+    });
+    for w in points.windows(2) {
+        doc.primitives.push(LayeredPrimitive {
+            layer: PROFILE_LAYER.into(),
+            primitive: segment_to_dxf(w[0], w[1])?,
+        });
+    }
+    write(&doc).map_err(|e| format!("DXF export failed: {e}"))
+}
+
+fn segment_to_dxf(a: SpunPoint, b: SpunPoint) -> Result<Primitive, String> {
+    let pa = Point2::new(a.r, a.z);
+    let pb = Point2::new(b.r, b.z);
+    if a.arc == 0.0 {
+        return Ok(Primitive::Line { start: pa, end: pb });
+    }
+    let dz = b.z - a.z;
+    let dr = b.r - a.r;
+    let len = dz.hypot(dr);
+    if !(len.is_finite() && len > 0.0) {
+        return Err("holder profile has a zero-length arc segment".into());
+    }
+    let rad = a.arc.abs().max(len * 0.5);
+    let half = (len * 0.5 / rad).clamp(0.0, 1.0).asin();
+    let back = rad * half.cos();
+    let n = (dz / len, -dr / len);
+    let mid = ((a.r + b.r) * 0.5, (a.z + b.z) * 0.5);
+    let s = a.arc.signum();
+    let center = Point2::new(mid.0 - s * back * n.0, mid.1 - s * back * n.1);
+    let ta = (a.z - center.y).atan2(a.r - center.x);
+    let tb = (b.z - center.y).atan2(b.r - center.x);
+    let (start_angle, sweep_angle) = if a.arc > 0.0 {
+        (ta, (tb - ta).rem_euclid(TAU))
+    } else {
+        (tb, (ta - tb).rem_euclid(TAU))
+    };
+    Ok(Primitive::Arc {
+        center,
+        radius: rad,
+        start_angle,
+        sweep_angle: sweep_angle.clamp(1e-12, TAU - 1e-12),
+    })
+}
+
+/// Convert a spindle-frame [`ToolBody`] to a conservative [`SpunProfile`].
+pub fn tool_body_to_spun(body: &ToolBody) -> Result<SpunProfile, String> {
+    if let Some(ref spun) = body.spun {
+        return Ok(spun.clone());
+    }
+    match &body.frame {
+        BodyFrame::Spindle { profile, .. } => {
+            SpunProfile::conservative_from_bands(profile.bands())
+                .map_err(|e| format!("holder profile conversion failed: {e}"))
+        }
+        BodyFrame::Lathe { .. } => {
+            Err("a lathe-frame holder body has no revolved spindle half-profile".into())
+        }
+    }
+}
+
+/// Export a spindle-frame [`ToolBody`] as a conservative half-profile DXF.
+pub fn tool_body_to_dxf(body: &ToolBody) -> Result<String, String> {
+    let spun = tool_body_to_spun(body)?;
+    spun_to_dxf(&spun)
+}
+
+/// Convert placed tool-frame triangles (axis `+Z`, tip at `z = 0`) to a
+/// conservative [`SpunProfile`] that envelops every non-revolved feature.
+pub fn placed_mesh_to_spun_profile(tris: &[Triangle]) -> Result<SpunProfile, String> {
+    let raw: Vec<[[f64; 3]; 3]> = tris
+        .iter()
+        .map(|t| {
+            [
+                [t.a.x, t.a.y, t.a.z],
+                [t.b.x, t.b.y, t.b.z],
+                [t.c.x, t.c.y, t.c.z],
+            ]
+        })
+        .collect();
+    let hp = HolderProfile::envelope(&raw).map_err(|e| e.to_string())?;
+    SpunProfile::conservative_from_bands(hp.bands())
+        .map_err(|e| format!("conservative half-profile conversion failed: {e}"))
+}
+
+/// Read a STEP file, require an unambiguous ISO 13399 alignment (#370), and
+/// convert its conservative outer envelope into an editable [`SpunProfile`].
+pub fn step_to_spun_profile(path: &Path) -> Result<SpunProfile, String> {
+    let ext = path
+        .extension()
+        .and_then(|e| e.to_str())
+        .map(str::to_ascii_lowercase)
+        .unwrap_or_default();
+    if ext != "step" && ext != "stp" {
+        return Err(
+            "expected a STEP (.step or .stp) file with ISO 13399 coordinate systems; refusing to guess an axis".into(),
+        );
+    }
+    let spec = ToolBodySpec::from_step_auto(path)?;
+    let placed = tool_body::place(&spec.facets, spec.axis, spec.offset)?;
+    placed_mesh_to_spun_profile(&placed)
+}
+
+/// Convert an ISO 13399 aligned STEP holder/body directly into ASCII DXF.
+pub fn step_to_dxf(path: &Path) -> Result<String, String> {
+    let spun = step_to_spun_profile(path)?;
+    spun_to_dxf(&spun)
+}
diff --git a/crates/app/src/tool_profile_dxf_import.rs b/crates/app/src/tool_profile_dxf_import.rs
new file mode 100644
index 000000000..e40672f1c
--- /dev/null
+++ b/crates/app/src/tool_profile_dxf_import.rs
@@ -0,0 +1,336 @@
+//! ASCII DXF half-profile importer (#743): validates an explicit single
+//! `CENTRELINE` line segment, explicit `$INSUNITS` length units, and one
+//! open continuous `LINE`/`ARC` chain lying wholly on one side of the axis.
+//! Provenance: Autodesk DXF Reference (ASCII DXF geometry and $INSUNITS) and
+//! standard 2D vector projection; original implementation.
+
+use std::f64::consts::PI;
+
+use camcraft_geometry::dxf::{self, Primitive, Unit, Units, parse};
+use camcraft_geometry::geo2d::Point2;
+use camcraft_tools::spun::{MIN_SEGMENT, SpunPoint, SpunProfile};
+
+use super::CENTRELINE_LAYER;
+
+const JOIN_TOL: f64 = 1e-4;
+const CROSS_TOL: f64 = 1e-5;
+const AXIS_SNAP_TOL: f64 = 1e-5;
+const ARC_SAMPLE_STEPS: usize = 16;
+
+/// Import an ASCII DXF half-profile requiring explicit `$INSUNITS`.
+pub fn dxf_to_spun(bytes: &[u8]) -> Result<SpunProfile, String> {
+    dxf_to_spun_with_unit(bytes, None)
+}
+
+/// Import an ASCII DXF half-profile, using `default_unit` only when unitless.
+pub fn dxf_to_spun_with_unit(bytes: &[u8], default_unit: Option<Unit>) -> Result<SpunProfile, String> {
+    let doc = parse(bytes).map_err(|e| e.to_string())?;
+    let scale = match doc.units {
+        Units::Known(u) => u.millimeters_per_unit(),
+        Units::MissingOrUnitless => match default_unit {
+            Some(u) => u.millimeters_per_unit(),
+            None => {
+                return Err(
+                    "DXF specifies no $INSUNITS header unit - set drawing units in the DXF or state millimetres/inches".into(),
+                );
+            }
+        },
+        Units::Unsupported(code) => {
+            return Err(format!("DXF has unsupported $INSUNITS unit code {code}"));
+        }
+    };
+    if !(scale.is_finite() && scale > 0.0) {
+        return Err("DXF length unit scale is invalid".into());
+    }
+    let (cl, segs) = extract_segments(&doc, scale)?;
+    let ordered = order_open_chain(&segs, cl.start, cl.axis)?;
+    project_to_spun(&ordered, cl.start, cl.axis, cl.normal)
+}
+
+struct Centreline {
+    start: Point2,
+    axis: Point2,
+    normal: Point2,
+}
+
+#[derive(Clone, Copy)]
+enum SegKind {
+    Line,
+    Arc {
+        center: Point2,
+        radius: f64,
+        start_angle: f64,
+        sweep_angle: f64,
+    },
+}
+
+#[derive(Clone, Copy)]
+struct Seg {
+    a: Point2,
+    b: Point2,
+    kind: SegKind,
+}
+
+fn is_centreline_layer(layer: &str) -> bool {
+    let t = layer.trim();
+    t.eq_ignore_ascii_case(CENTRELINE_LAYER) || t.eq_ignore_ascii_case("CENTERLINE")
+}
+
+fn scale_pt(p: Point2, s: f64) -> Result<Point2, String> {
+    let x = p.x * s;
+    let y = p.y * s;
+    if !(x.is_finite() && y.is_finite()) {
+        return Err("DXF coordinates overflow millimetre conversion".into());
+    }
+    Ok(Point2::new(x, y))
+}
+
+fn extract_segments(doc: &dxf::Document, scale: f64) -> Result<(Centreline, Vec<Seg>), String> {
+    let mut centrelines = Vec::new();
+    let mut segs = Vec::new();
+    for item in &doc.primitives {
+        if matches!(item.primitive, Primitive::Circle { .. }) {
+            return Err(
+                "DXF contains a CIRCLE entity - expected a centreline LINE and one open half-profile".into(),
+            );
+        }
+        if is_centreline_layer(&item.layer) {
+            let Primitive::Line { start, end } = item.primitive else {
+                return Err("DXF centreline entity must be a LINE".into());
+            };
+            centrelines.push((scale_pt(start, scale)?, scale_pt(end, scale)?));
+            continue;
+        }
+        push_primitive(&mut segs, &item.primitive, scale)?;
+    }
+    match centrelines.as_slice() {
+        [] => Err("DXF has no centreline - draw one LINE on layer 'CENTRELINE'".into()),
+        [one] => {
+            let dc = Point2::new(one.1.x - one.0.x, one.1.y - one.0.y);
+            let len = dc.x.hypot(dc.y);
+            if !(len.is_finite() && len >= MIN_SEGMENT) {
+                return Err(format!("DXF centreline is shorter than {MIN_SEGMENT} mm"));
+            }
+            if segs.is_empty() {
+                return Err("DXF has no half-profile geometry beside the centreline".into());
+            }
+            let axis = Point2::new(dc.x / len, dc.y / len);
+            let normal = Point2::new(axis.y, -axis.x);
+            Ok((Centreline { start: one.0, axis, normal }, segs))
+        }
+        many => Err(format!(
+            "DXF has {} centreline entities on layer 'CENTRELINE' - expected exactly one LINE",
+            many.len()
+        )),
+    }
+}
+
+fn push_primitive(segs: &mut Vec<Seg>, p: &Primitive, scale: f64) -> Result<(), String> {
+    match *p {
+        Primitive::Line { start, end } => {
+            let a = scale_pt(start, scale)?;
+            let b = scale_pt(end, scale)?;
+            segs.push(Seg { a, b, kind: SegKind::Line });
+        }
+        Primitive::Arc {
+            center,
+            radius,
+            start_angle,
+            sweep_angle,
+        } => {
+            let c = scale_pt(center, scale)?;
+            let r = radius * scale;
+            if !(r.is_finite() && r > 0.0) {
+                return Err("DXF arc radius is out of range in millimetres".into());
+            }
+            if sweep_angle > PI + 1e-6 {
+                let half = sweep_angle * 0.5;
+                push_arc(segs, c, r, start_angle, half);
+                push_arc(segs, c, r, start_angle + half, half);
+            } else {
+                push_arc(segs, c, r, start_angle, sweep_angle);
+            }
+        }
+        Primitive::Circle { .. } => {}
+    }
+    Ok(())
+}
+
+fn push_arc(segs: &mut Vec<Seg>, c: Point2, r: f64, start: f64, sweep: f64) {
+    let end = start + sweep;
+    let a = Point2::new(c.x + r * start.cos(), c.y + r * start.sin());
+    let b = Point2::new(c.x + r * end.cos(), c.y + r * end.sin());
+    segs.push(Seg {
+        a,
+        b,
+        kind: SegKind::Arc {
+            center: c,
+            radius: r,
+            start_angle: start,
+            sweep_angle: sweep,
+        },
+    });
+}
+
+fn dot2(a: Point2, b: Point2) -> f64 {
+    a.x * b.x + a.y * b.y
+}
+
+fn sub2(a: Point2, b: Point2) -> Point2 {
+    Point2::new(a.x - b.x, a.y - b.y)
+}
+
+#[derive(Clone, Copy)]
+struct OrderedSeg {
+    start: Point2,
+    end: Point2,
+    kind: SegKind,
+}
+
+fn order_open_chain(segs: &[Seg], c0: Point2, axis: Point2) -> Result<Vec<OrderedSeg>, String> {
+    let mut nodes: Vec<Point2> = Vec::new();
+    let mut intern = |p: Point2| -> usize {
+        if let Some(i) = nodes.iter().position(|n| sub2(p, *n).x.hypot(sub2(p, *n).y) <= JOIN_TOL) {
+            return i;
+        }
+        nodes.push(p);
+        nodes.len() - 1
+    };
+    let edges: Vec<(usize, usize)> = segs.iter().map(|s| (intern(s.a), intern(s.b))).collect();
+    let mut adj: Vec<Vec<usize>> = vec![Vec::new(); nodes.len()];
+    for (ei, &(u, v)) in edges.iter().enumerate() {
+        if u == v {
+            return Err("DXF half-profile has a zero-length or closed loop segment".into());
+        }
+        adj[u].push(ei);
+        adj[v].push(ei);
+    }
+    if let Some((vi, list)) = adj.iter().enumerate().find(|(_, l)| l.len() > 2) {
+        return Err(format!(
+            "DXF half-profile branches ({} segments meet at ({:.3}, {:.3}))",
+            list.len(),
+            nodes[vi].x,
+            nodes[vi].y
+        ));
+    }
+    let ends: Vec<usize> = adj.iter().enumerate().filter(|(_, l)| l.len() == 1).map(|(i, _)| i).collect();
+    if ends.is_empty() {
+        return Err("DXF profile forms a closed loop instead of an open half-profile between axis ends".into());
+    }
+    if ends.len() != 2 {
+        return Err(format!(
+            "DXF half-profile is disconnected ({} open endpoints instead of 2)",
+            ends.len()
+        ));
+    }
+    let z_of = |vi: usize| dot2(sub2(nodes[vi], c0), axis);
+    let mut cur = if z_of(ends[0]) <= z_of(ends[1]) { ends[0] } else { ends[1] };
+    let mut used = vec![false; segs.len()];
+    let mut chain = Vec::with_capacity(segs.len());
+    while let Some(&ei) = adj[cur].iter().find(|&&e| !used[e]) {
+        used[ei] = true;
+        let (u, v) = edges[ei];
+        let s = segs[ei];
+        let (start, end, next) = if u == cur { (s.a, s.b, v) } else { (s.b, s.a, u) };
+        chain.push(OrderedSeg { start, end, kind: s.kind });
+        cur = next;
+    }
+    if chain.len() != segs.len() {
+        return Err("DXF half-profile has disconnected extra segments".into());
+    }
+    Ok(chain)
+}
+
+fn project_to_spun(
+    chain: &[OrderedSeg],
+    c0: Point2,
+    axis: Point2,
+    n_ref: Point2,
+) -> Result<SpunProfile, String> {
+    let mut min_sr = f64::INFINITY;
+    let mut max_sr = f64::NEG_INFINITY;
+    for s in chain {
+        for p in sample_seg_points(s) {
+            let sr = dot2(sub2(p, c0), n_ref);
+            min_sr = min_sr.min(sr);
+            max_sr = max_sr.max(sr);
+        }
+    }
+    if max_sr > CROSS_TOL && min_sr < -CROSS_TOL {
+        return Err(format!(
+            "DXF half-profile crosses the centreline (points reach {min_sr:.3} mm and {max_sr:.3} mm)"
+        ));
+    }
+    if max_sr.abs() <= CROSS_TOL && min_sr.abs() <= CROSS_TOL {
+        return Err("DXF half-profile lies flat along the centreline (zero radius)".into());
+    }
+    let n_r = if max_sr > CROSS_TOL {
+        n_ref
+    } else {
+        Point2::new(-n_ref.x, -n_ref.y)
+    };
+    let proj = |p: Point2| (dot2(sub2(p, c0), axis), dot2(sub2(p, c0), n_r));
+    let mut pts = Vec::with_capacity(chain.len() + 1);
+    for (i, s) in chain.iter().enumerate() {
+        let (za, mut ra) = proj(s.start);
+        let (zb, mut rb) = proj(s.end);
+        if i == 0 && ra.abs() <= AXIS_SNAP_TOL {
+            ra = 0.0;
+        }
+        if i + 1 == chain.len() && rb.abs() <= AXIS_SNAP_TOL {
+            rb = 0.0;
+        }
+        let za = if za.abs() <= 1e-12 { 0.0 } else { za };
+        let arc = match s.kind {
+            SegKind::Line => 0.0,
+            SegKind::Arc {
+                center,
+                radius,
+                start_angle,
+                sweep_angle,
+            } => {
+                let len = (zb - za).hypot(rb - ra);
+                if len <= 0.0 {
+                    return Err("DXF half-profile contains a zero-length arc".into());
+                }
+                let mid_ang = start_angle + 0.5 * sweep_angle;
+                let mid = Point2::new(center.x + radius * mid_ang.cos(), center.y + radius * mid_ang.sin());
+                let (zm, rm) = proj(mid);
+                let n_zr = (-(rb - ra) / len, (zb - za) / len);
+                let c_mid = ((za + zb) * 0.5, (ra + rb) * 0.5);
+                let dot_out = (zm - c_mid.0) * n_zr.0 + (rm - c_mid.1) * n_zr.1;
+                let r_eff = if len * 0.5 > radius && (len * 0.5 - radius) <= 1e-5 {
+                    len * 0.5
+                } else {
+                    radius
+                };
+                if dot_out >= 0.0 { r_eff } else { -r_eff }
+            }
+        };
+        pts.push(SpunPoint { z: za, r: ra, arc });
+        if i + 1 == chain.len() {
+            let zb = if zb.abs() <= 1e-12 { 0.0 } else { zb };
+            pts.push(SpunPoint::line(zb, rb));
+        }
+    }
+    SpunProfile::new(pts).map_err(|e| format!("DXF half-profile invalid: {e}"))
+}
+
+fn sample_seg_points(s: &OrderedSeg) -> Vec<Point2> {
+    match s.kind {
+        SegKind::Line => vec![s.start, s.end],
+        SegKind::Arc {
+            center,
+            radius,
+            start_angle,
+            sweep_angle,
+        } => {
+            let mut out = Vec::with_capacity(ARC_SAMPLE_STEPS + 1);
+            for i in 0..=ARC_SAMPLE_STEPS {
+                let th = start_angle + sweep_angle * (i as f64 / ARC_SAMPLE_STEPS as f64);
+                out.push(Point2::new(center.x + radius * th.cos(), center.y + radius * th.sin()));
+            }
+            out
+        }
+    }
+}
diff --git a/crates/app/tests/tool_dxf_profile.rs b/crates/app/tests/tool_dxf_profile.rs
new file mode 100644
index 000000000..26a34cf78
--- /dev/null
+++ b/crates/app/tests/tool_dxf_profile.rs
@@ -0,0 +1,396 @@
+//! #743 part 2 acceptance tests:
+//! - STEP -> DXF half-profile with centreline (sampling STEP mesh proves every
+//!   point lies inside the revolved profile, non-revolved features enveloped)
+//! - Named refusal when converting a STEP body without a clear ISO 13399 axis
+//! - Direct DXF half-profile import (lines + arcs, units) and named error
+//!   refusals (no centreline, spline, crossing centreline, etc.)
+//! - Round trip STEP -> DXF -> body -> DXF stability within tolerance.
+//!
+//! Gate map (M4.4): covers app::commands, app::tool_body, app::tool_profile_dxf,
+//! tools::spun, geometry::dxf.
+
+use std::f64::consts::TAU;
+use std::path::{Path, PathBuf};
+
+use camcraft_app::commands::{AddTool, CommandError, History, SetToolBody};
+use camcraft_app::geometry::{self, Triangle};
+use camcraft_app::model;
+use camcraft_app::project;
+use camcraft_app::spun::{SpunPoint, SpunProfile};
+use camcraft_app::tool_body;
+use camcraft_app::tool_profile_dxf::{
+    CENTRELINE_LAYER, PROFILE_LAYER, dxf_to_spun, dxf_to_spun_with_unit,
+    placed_mesh_to_spun_profile, spun_to_dxf, step_to_dxf, step_to_spun_profile,
+    tool_body_to_dxf,
+};
+use camcraft_app::tools::{Tool, catalog};
+use camcraft_app::world::new_world;
+use camcraft_geometry::dxf::{Primitive, Unit, Units, parse};
+
+const TOOL: &str = "EM-0400-2FL";
+
+fn testdata(name: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../testdata/models")
+        .join(name)
+}
+
+fn catalog_tool(name: &str) -> Tool {
+    catalog()
+        .into_iter()
+        .find(|(n, _)| *n == name)
+        .map(|(_, t)| t)
+        .expect("catalog entry")
+}
+
+fn world_with_tool() -> (flecs_ecs::prelude::World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, AddTool::new(&world, TOOL, catalog_tool(TOOL)).expect("tool"));
+    (world, history)
+}
+
+/// Evaluate the conservative maximum radius of `spun` at axial height `z`.
+fn profile_radius_at(spun: &SpunProfile, z: f64) -> f64 {
+    let eps = 1e-6;
+    spun.holder_profile()
+        .bands()
+        .iter()
+        .filter(|b| z >= b.above - eps && z <= b.above + b.len + eps)
+        .map(|b| b.r)
+        .fold(0.0, f64::max)
+}
+
+/// Sample vertices, edge midpoints, centroid, and a 5x5 barycentric grid per triangle.
+fn sample_triangles(tris: &[Triangle]) -> Vec<[f64; 3]> {
+    let mut out = Vec::new();
+    for t in tris {
+        for i in 0..=5 {
+            for j in 0..=(5 - i) {
+                let u = i as f64 / 5.0;
+                let v = j as f64 / 5.0;
+                let w = 1.0 - u - v;
+                out.push([
+                    u * t.a.x + v * t.b.x + w * t.c.x,
+                    u * t.a.y + v * t.b.y + w * t.c.y,
+                    u * t.a.z + v * t.b.z + w * t.c.z,
+                ]);
+            }
+        }
+    }
+    out
+}
+
+#[test]
+fn step_to_dxf_half_profile_envelops_every_sampled_mesh_point() {
+    let path = testdata("tool_csys_box_iso13399.step");
+    let dxf = step_to_dxf(&path).expect("ISO 13399 STEP converts to DXF");
+    let doc = parse(dxf.as_bytes()).expect("written DXF parses cleanly");
+    assert_eq!(doc.units, Units::Known(Unit::Millimeters));
+
+    let centrelines: Vec<_> = doc
+        .primitives
+        .iter()
+        .filter(|p| p.layer.eq_ignore_ascii_case(CENTRELINE_LAYER))
+        .collect();
+    assert_eq!(centrelines.len(), 1, "DXF carries one centreline entity");
+    assert!(matches!(centrelines[0].primitive, Primitive::Line { .. }));
+    assert!(
+        doc.primitives
+            .iter()
+            .any(|p| p.layer.eq_ignore_ascii_case(PROFILE_LAYER)),
+        "DXF carries profile entities on {PROFILE_LAYER}"
+    );
+
+    let spun = dxf_to_spun(dxf.as_bytes()).expect("exported DXF re-imports as SpunProfile");
+
+    // Reconstruct the placed STEP mesh via the exact ISO 13399 CSYS alignment
+    // and verify every sampled point lies inside the revolved half-profile.
+    let spec = camcraft_app::commands::ToolBodySpec::from_step_auto(&path).expect("step auto");
+    let placed = tool_body::place(&spec.facets, spec.axis, spec.offset).expect("places");
+    let samples = sample_triangles(&placed);
+    assert!(!samples.is_empty());
+
+    let mut saw_corner = false;
+    for p in samples {
+        let z = p[2];
+        let rho = p[0].hypot(p[1]);
+        let r_env = profile_radius_at(&spun, z);
+        assert!(
+            rho <= r_env + 1e-6,
+            "mesh sample ({}, {}, {z}) has rho={rho} > envelope r={r_env}",
+            p[0],
+            p[1]
+        );
+        if (rho - 10.0 * std::f64::consts::SQRT_2).abs() < 1e-3 {
+            saw_corner = true;
+        }
+    }
+    assert!(saw_corner, "fixture box must exercise corners at r ~ 14.142");
+    // Flats at x=+/-10 must be conservatively enveloped to >= 14.142, never cut away to 10.
+    assert!(profile_radius_at(&spun, 55.0) >= 10.0 * std::f64::consts::SQRT_2 - 1e-4);
+}
+
+#[test]
+fn non_revolved_step_or_fine_32_plus_band_mesh_is_conservatively_enveloped() {
+    // 40 stepped rings with a simulated axial drive slot/flat cutout on one quadrant:
+    // forces > MAX_BANDS reduction (32 -> <=31) and verifies flats/slots never cut away material.
+    let mut tris = Vec::new();
+    let rings = 40;
+    let sides = 16;
+    let z_base = 25.0;
+    let ring_h = 2.0;
+    for k in 0..rings {
+        let z0 = z_base + k as f64 * ring_h;
+        let z1 = z0 + ring_h;
+        let r_base = 12.0 + (k as f64 * 0.4);
+        for s in 0..sides {
+            let a0 = s as f64 * TAU / sides as f64;
+            let a1 = (s + 1) as f64 * TAU / sides as f64;
+            // Drive slot: pull radius inward on one angular sector; envelope must keep r_base!
+            let r0 = if s == 2 { r_base * 0.55 } else { r_base };
+            let r1 = if (s + 1) % sides == 2 { r_base * 0.55 } else { r_base };
+            let p00 = geometry::Point3::new(r0 * a0.cos(), r0 * a0.sin(), z0);
+            let p10 = geometry::Point3::new(r1 * a1.cos(), r1 * a1.sin(), z0);
+            let p11 = geometry::Point3::new(r1 * a1.cos(), r1 * a1.sin(), z1);
+            let p01 = geometry::Point3::new(r0 * a0.cos(), r0 * a0.sin(), z1);
+            tris.push(Triangle::new(p00, p10, p11));
+            tris.push(Triangle::new(p00, p11, p01));
+        }
+    }
+    let spun = placed_mesh_to_spun_profile(&tris).expect("40-band tapered mesh simplifies within MAX_POINTS");
+    assert!(spun.points().len() <= camcraft_app::spun::MAX_POINTS);
+    let dxf = spun_to_dxf(&spun).expect("exports to DXF");
+    let reparsed = dxf_to_spun(dxf.as_bytes()).expect("re-imports");
+    for p in sample_triangles(&tris) {
+        let rho = p[0].hypot(p[1]);
+        let r_env = profile_radius_at(&reparsed, p[2]);
+        assert!(rho <= r_env + 1e-6, "sample z={} rho={rho} > r_env={r_env}", p[2]);
+    }
+}
+
+#[test]
+fn step_conversion_refuses_missing_or_ambiguous_axis_by_name() {
+    let err_none = step_to_dxf(&testdata("box.step"))
+        .expect_err("STEP without ISO 13399 CSYS must be refused, never guessed as +Z");
+    assert!(
+        err_none.contains("coordinate system") || err_none.contains("CIP") || err_none.contains("ISO 13399"),
+        "{err_none}"
+    );
+
+    // Derive a valid closed-shell STEP whose ISO 13399 CIP placement is duplicated & conflicting
+    // (removing PCS/MCS/CSW1_2 so ambiguous CIP is not rescued by another valid role).
+    let src = std::fs::read_to_string(testdata("tool_csys_box_iso13399.step")).expect("fixture");
+    let ambig = src
+        .replace("AXIS2_PLACEMENT_3D('PCS',", "AXIS2_PLACEMENT_3D('NONE',")
+        .replace("AXIS2_PLACEMENT_3D('MCS',", "AXIS2_PLACEMENT_3D('NONE',")
+        .replace("AXIS2_PLACEMENT_3D('CSW1_2',", "AXIS2_PLACEMENT_3D('NONE',")
+        .replace(
+            "#220 = AXIS2_PLACEMENT_3D('CIP', #221, #202, #203);",
+            "#220 = AXIS2_PLACEMENT_3D('CIP', #221, #202, #203);\n#222 = AXIS2_PLACEMENT_3D('CIP', #201, #202, #203);",
+        );
+    let tmp = std::env::temp_dir().join(format!("camcraft_ambig_csys_{}.step", std::process::id()));
+    std::fs::write(&tmp, ambig).expect("write ambig step");
+    let err_ambig = step_to_spun_profile(&tmp);
+    let _ = std::fs::remove_file(&tmp);
+    let err_ambig = err_ambig.expect_err("ambiguous CIP STEP must be refused by name");
+    assert!(
+        err_ambig.contains("refused") || err_ambig.contains("coordinate system") || err_ambig.contains("2 different placements"),
+        "{err_ambig}"
+    );
+
+    let err_stl = step_to_dxf(&testdata("cube.stl"))
+        .expect_err("non-STEP STL without ISO 13399 CSYS must be refused by name");
+    assert!(!err_stl.is_empty());
+}
