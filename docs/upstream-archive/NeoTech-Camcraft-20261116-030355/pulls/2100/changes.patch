@@ -247,3 +247,154 @@ impl State {
         self.feedback_ctx = None;
     }
 }
+
+impl State {
+    fn clear_tool_scope_refusal(&mut self) {
+        if self.feedback.as_ref().is_some_and(|(s, _)| *s == ErrorScope::Tool) {
+            if let Some((_, msg)) = self.feedback.take()
+                && self.status == msg
+            {
+                self.status = String::from("ready");
+            }
+            self.feedback_ctx = None;
+        }
+    }
+
+    fn export_profile_dxf_string(&self) -> Result<String, String> {
+        if !self.tool_profile_ui.points.is_empty() {
+            let spun = SpunProfile::new(self.tool_profile_ui.points.clone())
+                .map_err(|e| format!("holder profile invalid: {e}"))?;
+            return camcraft_app::tool_profile_dxf::spun_to_dxf(&spun);
+        }
+        if let Some(body) = self.editor_tool_body() {
+            return camcraft_app::tool_profile_dxf::tool_body_to_dxf(&body);
+        }
+        Err("no holder body or spun profile to export".into())
+    }
+
+    fn apply_imported_spun(&mut self, spun: SpunProfile, label: &str) {
+        self.sync_tool_profile_ui();
+        self.tool_profile_ui.points = spun.points().to_vec();
+        self.tool_profile_ui.custom = true;
+        self.tool_profile_ui.refused = None;
+        self.clear_tool_scope_refusal();
+        self.status = format!("tool {}: loaded half-profile from {label}; edit or Apply profile", self.tool_ui.name);
+    }
+
+    /// "Import DXF…": pick an ASCII DXF file and load its half-profile.
+    pub(crate) fn import_profile_dxf_dialog(&mut self) {
+        if self.refuse_in_browser(crate::browser_files::NEEDS_PICKER) {
+            return;
+        }
+        if let Some(path) = crate::file_dialog::FileDialog::new()
+            .add_filter("DXF", &["dxf", "DXF"])
+            .pick_file()
+        {
+            self.import_profile_dxf_from(&path);
+        }
+    }
+
+    /// Load a DXF half-profile from `path` into the Custom profile editor.
+    pub(crate) fn import_profile_dxf_from(&mut self, path: &std::path::Path) {
+        let label = path.file_name().and_then(|s| s.to_str()).unwrap_or("DXF");
+        match std::fs::read(path)
+            .map_err(|e| format!("DXF unreadable: {e}"))
+            .and_then(|bytes| camcraft_app::tool_profile_dxf::dxf_to_spun(&bytes))
+        {
+            Ok(spun) => self.apply_imported_spun(spun, label),
+            Err(err) => self.refuse(ErrorScope::Tool, format!("DXF half-profile not imported: {err}")),
+        }
+    }
+
+    /// "Export DXF…": pick a path and write the current profile as ASCII DXF.
+    pub(crate) fn export_profile_dxf_dialog(&mut self) {
+        if self.refuse_in_browser(crate::browser_files::NO_EXPORT) {
+            return;
+        }
+        let default_name = format!(
+            "{}_holder.dxf",
+            if self.tool_ui.name.trim().is_empty() { "tool" } else { self.tool_ui.name.trim() }
+        );
+        if let Some(path) = crate::file_dialog::FileDialog::new()
+            .add_filter("DXF", &["dxf"])
+            .set_file_name(&default_name)
+            .save_file()
+            && let Err(err) = self.export_profile_dxf_to(&path)
+        {
+            self.refuse(ErrorScope::Tool, format!("DXF not exported: {err}"));
+        }
+    }
+
+    /// Write the active half-profile or tool body to `path` as ASCII DXF (mm).
+    pub(crate) fn export_profile_dxf_to(&self, path: &std::path::Path) -> Result<(), String> {
+        let dxf = self.export_profile_dxf_string()?;
+        std::fs::write(path, dxf).map_err(|e| format!("failed to write DXF: {e}"))
+    }
+
+    /// "Import STEP…": pick a STEP file with ISO 13399 CSYS and convert to profile.
+    pub(crate) fn import_step_profile_dialog(&mut self) {
+        if self.refuse_in_browser(crate::browser_files::NEEDS_PICKER) {
+            return;
+        }
+        if let Some(path) = crate::file_dialog::FileDialog::new()
+            .add_filter("STEP", &["step", "stp", "STEP", "STP"])
+            .pick_file()
+        {
+            self.import_step_profile_from(&path);
+        }
+    }
+
+    /// Convert an ISO 13399 aligned STEP body from `path` into the Custom profile editor.
+    pub(crate) fn import_step_profile_from(&mut self, path: &std::path::Path) {
+        let label = path.file_name().and_then(|s| s.to_str()).unwrap_or("STEP");
+        match camcraft_app::tool_profile_dxf::step_to_spun_profile(path) {
+            Ok(spun) => self.apply_imported_spun(spun, label),
+            Err(err) => self.refuse(ErrorScope::Tool, format!("STEP profile not imported: {err}")),
+        }
+    }
+
+    /// Body tab "Convert to profile": require an explicit/ISO 13399 axis, envelope
+    /// conservatively into an editable half-profile, and land it via `SetToolBody`.
+    pub(crate) fn convert_body_draft_to_profile(&mut self) {
+        let d = &self.tool_body_ui;
+        if d.facets.is_empty() {
+            self.refuse(ErrorScope::Tool, "cannot convert body: no body draft loaded".into());
+            return;
+        }
+        if d.lathe.is_some() {
+            self.refuse(
+                ErrorScope::Tool,
+                "cannot convert body: lathe tool bodies have no revolved spindle half-profile".into(),
+            );
+            return;
+        }
+        if let Some(reason) = d.align_note.as_deref().and_then(|s| s.strip_prefix("numeric placement (")) {
+            let why = reason.strip_suffix(')').unwrap_or(reason);
+            self.refuse(
+                ErrorScope::Tool,
+                format!("cannot convert body to half-profile without a clear tool axis ({why}) - align by ISO 13399 CSYS or set axis and tip first"),
+            );
+            return;
+        }
+        let name = self.tool_ui.name.clone();
+        let res = SetToolBody::from_placed_profile(
+            &self.world,
+            &name,
+            &d.source,
+            &d.facets,
+            d.axis,
+            d.offset,
+        );
+        match res {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.clear_tool_scope_refusal();
+                self.sync_tool_profile_ui();
+                self.tool_profile_ui.column = ToolColumn::Profile;
+                self.status = format!("tool {name}: converted body to half-profile");
+            }
+            Err(err) => self.refuse(ErrorScope::Tool, format!("holder profile not converted: {err}")),
+        }
+    }
+}
diff --git a/docs/decisions/743-step-dxf-half-profile.md b/docs/decisions/743-step-dxf-half-profile.md
new file mode 100644
index 000000000..27e4d5494
--- /dev/null
+++ b/docs/decisions/743-step-dxf-half-profile.md
@@ -0,0 +1,72 @@
+## #743 - STEP-to-DXF half-profile conversion and DXF half-profile writer/importer
+
+**What was decided.**
+
+- **Clean-room ASCII DXF writer (`crates/geometry/src/dxf/{writer.rs,units.rs,mod.rs}`).**
+  Added `dxf::write`, `dxf::write_bytes`, and `Unit::code()`, pairing with the
+  existing reader (`#1860`) to emit `HEADER` (`$INSUNITS`), `TABLES` (`LAYER`),
+  and `ENTITIES` (`LINE`, `ARC`, `CIRCLE`). Invalid coordinates, zero-length
+  `LINE` entities, non-positive or `>= 2*pi` `ARC` sweeps, unsupported
+  `$INSUNITS` codes, duplicate or newline-containing layer names, and limit
+  overflows are refused by entity or section name without panicking.
+- **Conservative stepped-band reduction (`crates/tools/src/spun_envelope.rs`).**
+  Added `SpunProfile::conservative_from_bands(&[HolderBand])` because a full
+  `MAX_BANDS` (`32`) `HolderProfile` produces `2 * 32 + 2 = 66` vertices,
+  exceeding `MAX_POINTS` (`64`). Adjacent bands merge greedily by minimum
+  added swept volume taking `max(r)` until equal or tiny segments clear
+  `MIN_SEGMENT` and band count fits `MAX_STEPPED_BANDS = 31` (`<= 64`
+  points), strictly preserving outer radius across non-revolved features such
+  as drive slots and flats.
+- **STEP / `ToolBody` <-> DXF half-profile pipeline (`crates/app/src/{tool_profile_dxf.rs,tool_profile_dxf_import.rs}`).**
+  Exports `SpunProfile` (lines and signed circular arcs) and spindle
+  `ToolBody` envelopes to millimetre ASCII DXF (`$INSUNITS = 4`) with an
+  explicit `CENTRELINE` `LINE` (`(0, 0) -> (0, z_top)`) and an open `PROFILE`
+  chain in `(x = r, y = z)`. Converting a STEP file (`step_to_spun_profile`,
+  `step_to_dxf`) routes exclusively through `ToolBodySpec::from_step_auto`,
+  refusing missing, degenerate, or ambiguous ISO 13399 coordinate systems and
+  non-STEP meshes by name rather than guessing `+Z`. Importing DXF
+  (`dxf_to_spun`, `dxf_to_spun_with_unit`) accepts one `LINE` on layer
+  `CENTRELINE`/`CENTERLINE` in any 2D orientation plus one continuous open
+  chain wholly on one side of the centreline, refusing missing or multiple
+  centrelines, `CIRCLE`, `SPLINE` (via reader), crossing geometry, closed
+  loops, branching, disconnected segments, unitless DXF (when no fallback unit
+  is supplied), axial reversals (`RunsBack`), and below-tip geometry by name.
+- **Commands, MCP, and UI (`crates/app/src/{commands/tool_body_dxf.rs,mcp/holder_dxf_tools.rs}`, `crates/ui/src/{state_tool_profile.rs,egui_app/tool_profile_page.rs,egui_app/tool_body_page.rs}`).**
+  Added undoable `SetToolBody` constructors (`from_dxf_bytes`, `from_dxf`,
+  `from_step_profile`, `from_placed_profile`) over `tool_body::build_spun`.
+  Exposed MCP tools `import_tool_holder_dxf`, `export_tool_holder_dxf`, and
+  `convert_tool_step_to_profile`. Updated the Profile tab with an explicit
+  notice that non-revolved features are enveloped conservatively (never cut
+  away) and only the half-profile is editable, plus `Import DXF…`,
+  `Export DXF…`, and `Import STEP…`, and added Body tab `Convert to profile`
+  (refusing drafts whose placement is still the unaligned numeric fallback).
+
+**Why.**
+
+Holder collision checking relies on `SpunProfile` never undercutting the
+actual 3D tool assembly; merging bands only upward in radius guarantees that
+slots, flats, and polygon corners stay enveloped inside the revolved
+silhouette. Refusing STEP conversion when ISO 13399 CSYS is absent or
+ambiguous prevents silently spinning a holder about the wrong axis. Separating
+the new modules (`tool_body_dxf.rs`, `holder_dxf_tools.rs`,
+`tool_profile_dxf_import.rs`) and appending UI helpers avoids overlapping
+edits with open PRs `#2092`, `#2054`, `#2077`, and `#2023`, and keeps every
+file at or under 400 lines.
+
+**Considered and dropped.**
+
+- Guessing `+Z` when a STEP file lacks ISO 13399 coordinate systems: unsafe
+  for vendor STEP assemblies whose local frame is arbitrary.
+- Sampling or truncating STEP bands without conservative `max(r)` merging:
+  would cut away flats or drive slots and risk undetected collisions.
+- Supporting `SPLINE` or `ELLIPSE` entities in DXF half-profile import or
+  export: left out of scope; ASCII `LINE` and `ARC` on explicit `CENTRELINE`
+  and `PROFILE` layers represent `SpunProfile` segments losslessly.
+- Writing `ToolBody { ... }` struct literals directly in `tool_body_dxf.rs`:
+  dropped so open PR `#2092`'s `library` field causes no unnecessary conflict.
+
+**Cost to change later.**
+
+Low. Conversions sit behind dedicated modules and `SetToolBody` constructors,
+and saved `.camproj` files continue storing `SpunProfile` without format
+migration.

From 02c8aaa7079f3d0bef55a3e7eab790c1826583e2 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sun, 15 Nov 2026 17:52:53 -0800
Subject: [PATCH 2/2] fix(app): preserve clockwise major DXF profile arcs

Split major arcs for either sweep direction before converting to signed-radius spun segments. Pin both windings and the source arc extent so axial reversals cannot silently truncate holder material.
---
 crates/app/src/tool_profile_dxf_import.rs |  4 +-
 crates/app/tests/tool_dxf_profile.rs      | 49 +++++++++++++++++++++++
 2 files changed, 52 insertions(+), 1 deletion(-)

diff --git a/crates/app/src/tool_profile_dxf_import.rs b/crates/app/src/tool_profile_dxf_import.rs
