 crates/ui/src/egui_app/tests/machines_pane.rs | 36 +++++++++++++++++++
 docs/decisions/2030-edm-kind-filter.md        | 18 ++++++++++
 3 files changed, 58 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/2030-edm-kind-filter.md

diff --git a/crates/ui/src/egui_app/machines_pane.rs b/crates/ui/src/egui_app/machines_pane.rs
index 653026b7a..71a135c94 100644
--- a/crates/ui/src/egui_app/machines_pane.rs
+++ b/crates/ui/src/egui_app/machines_pane.rs
@@ -59,7 +59,10 @@ pub struct MachinesPane {
 }
 
 /// The kinds New blank offers, in the combo's order.
-const KINDS: [Kind; 4] = [Kind::Mill, Kind::Lathe, Kind::MillTurn, Kind::Plasma];
+const KINDS: [Kind; 7] = [
+    Kind::Mill, Kind::Lathe, Kind::MillTurn, Kind::Plasma,
+    Kind::Waterjet, Kind::WireEdm, Kind::SinkerEdm,
+];
 
 /// The dropdown's first entry: no filter, New blank shut.
 pub(crate) const ALL_KINDS: &str = "All";
diff --git a/crates/ui/src/egui_app/tests/machines_pane.rs b/crates/ui/src/egui_app/tests/machines_pane.rs
index 9d81e49e0..7a379484e 100644
--- a/crates/ui/src/egui_app/tests/machines_pane.rs
+++ b/crates/ui/src/egui_app/tests/machines_pane.rs
@@ -329,3 +329,39 @@ fn the_machines_pane_names_every_input() {
     assert!(seen >= 1, "only {seen} inputs found in the machines pane");
     assert!(bad.is_empty(), "unnamed inputs in machines pane: {bad:?}");
 }
+
+/// #2030: every machine kind has a filter entry, including both EDM kinds.
+#[test]
+fn the_kind_filter_offers_every_machine_kind_and_filters_its_rows() {
+    use camcraft_app::machine::Kind;
+    use egui::accesskit::Role;
+    let kinds = [
+        Kind::Mill, Kind::Lathe, Kind::MillTurn, Kind::Plasma,
+        Kind::Waterjet, Kind::WireEdm, Kind::SinkerEdm,
+    ];
+    let mut h = blank_harness();
+    h.run();
+    open_machines(&mut h);
+    h.run_steps(3);
+    let rows: Vec<_> = h.state().state.machines_pane.list.as_ref()
+        .expect("the catalogue was read").iter()
+        .map(|e| (e.kind, row_label(e))).collect();
+    let mut current = "All";
+    for kind in kinds {
+        let at = h.get_by(|n| n.role() == Role::ComboBox
+            && n.value().as_deref() == Some(current)).rect().center();
+        click(&mut h, at);
+        h.run_steps(10);
+        for entry in kinds {
+            h.get_by_label(entry.word());
+        }
+        h.get_by_label(kind.word()).click();
+        h.run_steps(3);
+        for (row_kind, label) in &rows {
+            assert_eq!(h.query_by_label(label).is_some(), *row_kind == Some(kind),
+                "{label} under the {} filter", kind.word());
+        }
+        current = kind.word();
+    }
+    assert_no_commands(&h);
+}
diff --git a/docs/decisions/2030-edm-kind-filter.md b/docs/decisions/2030-edm-kind-filter.md
new file mode 100644
index 000000000..3137875c9
--- /dev/null
+++ b/docs/decisions/2030-edm-kind-filter.md
@@ -0,0 +1,18 @@
+## #2030 - Offer every machine kind in the Machines pane filter
+
+**Decided:** Append Waterjet, Wire EDM and Sinker EDM to the private
+`KINDS` array. Keep the first four entries in their existing order.
+Use a structural test to check all seven kinds through the dropdown and
+check the filtered machine rows.
+
+**Why:** The filter must offer each kind that the machine library can
+hold. The missing entries include Waterjet as well as the two EDM kinds.
+The existing array controls both the filter and the New blank kind.
+Appending entries preserves the existing filter indices.
+
+**Dropped:** Adding only the EDM kinds would leave Waterjet unavailable.
+A shared enum list or a wider API change is unnecessary for this fix.
+
+**Cost to change later:** Add a filter entry and a test entry when a new
+machine kind becomes available. A shared list can replace the private
+array if more callers need the same complete list.
