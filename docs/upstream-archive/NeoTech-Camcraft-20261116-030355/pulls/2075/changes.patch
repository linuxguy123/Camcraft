index d6dfaa124..a0b8cbd62 100644
--- a/crates/app/tests/shared_face_bodies_finish.rs
+++ b/crates/app/tests/shared_face_bodies_finish.rs
@@ -155,3 +155,170 @@ fn the_3d_finish_bands_tile_the_whole_span() {
         assert_eq!(band_heights(k - 1)["bottom_z"], band_heights(k)["top_z"], "band {k} starts where band {} ends", k - 1);
