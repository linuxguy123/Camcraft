+    let bite = deg_at_rim(super::BITE_LOAD, d, rim);
+    let mut passes: Vec<Vec<Point2>> = Vec::new();
+    let mut worst = (0.0f64, s.start);
+    let mut ends = (0.0f64, s.start);
+    let mut spiral: Vec<Point2> = Vec::new();
