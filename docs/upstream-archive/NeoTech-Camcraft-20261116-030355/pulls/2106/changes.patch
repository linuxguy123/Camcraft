@@ -0,0 +1,300 @@
+//! Provenance: oriented line/arc/circle pieces of a sketch chain. Arc area by Green's theorem
+//! (any calculus text, e.g. Stewart, "Calculus", ch. 16.4); arc extents from the quadrant points.
+//! Original implementation; no vendor material consulted.
+
+use super::ChainError;
+use crate::dxf::Primitive;
+use crate::geo2d::Point2;
+use std::f64::consts::{FRAC_PI_2, PI, TAU};
+
+/// Sketch coordinates stay below this magnitude (mm, ten kilometres) so that the quotient
+/// `coordinate / tolerance`, the identity quantization and the contact slack keep their meaning
+/// in `f64`.
+pub(super) const SKETCH_LIMIT: f64 = 1e7;
+
+/// Identity quantum: 1e-6 mm per unit.
+const ID_SCALE: f64 = 1e6;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum Shape {
+    Line,
+    /// As drawn: the arc runs from `start` by the signed `sweep`, whatever the traversal.
+    Arc {
+        center: Point2,
+        radius: f64,
+        start: f64,
+        sweep: f64,
+    },
+    Circle {
+        center: Point2,
+        radius: f64,
+    },
+}
+
+/// One curve piece in traversal direction: it is walked from `a` to `b`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Piece {
+    pub shape: Shape,
+    pub a: Point2,
+    pub b: Point2,
+    /// The traversal runs against the drawn direction.
+    pub reversed: bool,
+}
+
+pub(super) fn sub(p: Point2, q: Point2) -> Point2 {
+    Point2::new(p.x - q.x, p.y - q.y)
+}
+
+pub(super) fn cross(p: Point2, q: Point2) -> f64 {
+    p.x * q.y - p.y * q.x
+}
+
+pub(super) fn dot(p: Point2, q: Point2) -> f64 {
+    p.x * q.x + p.y * q.y
+}
+
+pub(super) fn dist(p: Point2, q: Point2) -> f64 {
+    (p.x - q.x).hypot(p.y - q.y)
+}
+
+pub(super) fn same(p: Point2, q: Point2) -> bool {
+    p.x == q.x && p.y == q.y
+}
+
+fn on_circle(center: Point2, radius: f64, angle: f64) -> Point2 {
+    Point2::new(
+        center.x + radius * angle.cos(),
+        center.y + radius * angle.sin(),
+    )
+}
+
+fn in_range(index: usize, values: &[f64]) -> Result<(), ChainError> {
+    if values.iter().any(|v| !v.is_finite()) {
+        return Err(ChainError::NonFinite { primitive: index });
+    }
+    if values.iter().any(|v| v.abs() >= SKETCH_LIMIT) {
+        return Err(ChainError::OutOfRange { primitive: index });
+    }
+    Ok(())
+}
+
+fn invalid(primitive: usize, reason: &'static str) -> ChainError {
+    ChainError::InvalidPrimitive { primitive, reason }
+}
+
+impl Piece {
+    pub fn line(a: Point2, b: Point2) -> Piece {
+        Piece {
+            shape: Shape::Line,
+            a,
+            b,
+            reversed: false,
+        }
+    }
+
+    /// Validate one input primitive and return it in its drawn direction.
+    pub fn from_primitive(index: usize, primitive: &Primitive) -> Result<Piece, ChainError> {
+        match *primitive {
+            Primitive::Line { start, end } => {
+                in_range(index, &[start.x, start.y, end.x, end.y])?;
+                Ok(Piece::line(start, end))
+            }
+            Primitive::Arc {
+                center,
+                radius,
+                start_angle,
+                sweep_angle,
+            } => {
+                in_range(
+                    index,
+                    &[center.x, center.y, radius, start_angle, sweep_angle],
+                )?;
+                in_range(index, &[center.x.abs() + radius, center.y.abs() + radius])?;
+                if radius <= 0.0 {
+                    return Err(invalid(index, "arc radius must be positive"));
+                }
+                if sweep_angle == 0.0 || sweep_angle.abs() > TAU + 1e-12 {
+                    return Err(invalid(
+                        index,
+                        "arc sweep must be non-zero and at most a turn",
+                    ));
+                }
+                let shape = Shape::Arc {
+                    center,
+                    radius,
+                    start: start_angle,
+                    sweep: sweep_angle,
+                };
+                let a = on_circle(center, radius, start_angle);
+                let b = on_circle(center, radius, start_angle + sweep_angle);
+                Ok(Piece {
+                    shape,
+                    a,
+                    b,
+                    reversed: false,
+                })
+            }
+            Primitive::Circle { center, radius } => {
+                in_range(index, &[center.x, center.y, radius])?;
+                in_range(index, &[center.x.abs() + radius, center.y.abs() + radius])?;
+                if radius <= 0.0 {
+                    return Err(invalid(index, "circle radius must be positive"));
+                }
+                let a = Point2::new(center.x + radius, center.y);
+                Ok(Piece {
+                    shape: Shape::Circle { center, radius },
+                    a,
+                    b: a,
+                    reversed: false,
+                })
+            }
+        }
+    }
+
+    /// The same curve walked the other way. A circle has no ends and stays as it is.
+    pub fn flipped(self) -> Piece {
+        match self.shape {
+            Shape::Circle { .. } => self,
+            _ => Piece {
+                shape: self.shape,
+                a: self.b,
+                b: self.a,
+                reversed: !self.reversed,
+            },
+        }
+    }
+
+    /// The signed sweep in traversal direction (zero for a line).
+    pub fn travel_sweep(&self) -> f64 {
+        match self.shape {
+            Shape::Line => 0.0,
+            Shape::Arc { sweep, .. } => {
+                if self.reversed {
+                    -sweep
+                } else {
+                    sweep
+                }
+            }
+            Shape::Circle { .. } => TAU,
+        }
+    }
+
+    /// The piece as an analytic primitive in traversal direction.
+    pub fn oriented(&self) -> Primitive {
+        match self.shape {
+            Shape::Line => Primitive::Line {
+                start: self.a,
+                end: self.b,
+            },
+            Shape::Arc {
+                center,
+                radius,
+                start,
+                sweep,
+            } => {
+                let (start_angle, sweep_angle) = if self.reversed {
+                    (start + sweep, -sweep)
+                } else {
+                    (start, sweep)
+                };
+                Primitive::Arc {
+                    center,
+                    radius,
+                    start_angle,
+                    sweep_angle,
+                }
+            }
+            Shape::Circle { center, radius } => Primitive::Circle { center, radius },
+        }
+    }
+
+    /// Green's theorem term `1/2 * integral(x dy - y dx)` along the piece; the terms of a
+    /// closed walk sum to its signed area (counterclockwise positive).
+    pub fn area_term(&self) -> f64 {
+        match self.shape {
+            Shape::Line => 0.5 * cross(self.a, self.b),
+            Shape::Arc { center, radius, .. } => {
+                0.5 * (radius * radius * self.travel_sweep() + center.x * (self.b.y - self.a.y)
+                    - center.y * (self.b.x - self.a.x))
+            }
+            Shape::Circle { radius, .. } => PI * radius * radius,
+        }
+    }
+
+    /// Axis-aligned bounds: the ends, plus every quadrant point an arc passes.
+    pub fn bounds(&self) -> (Point2, Point2) {
+        let mut lo = Point2::new(self.a.x.min(self.b.x), self.a.y.min(self.b.y));
+        let mut hi = Point2::new(self.a.x.max(self.b.x), self.a.y.max(self.b.y));
+        match self.shape {
+            Shape::Line => {}
+            Shape::Circle { center, radius } => {
+                lo = Point2::new(center.x - radius, center.y - radius);
+                hi = Point2::new(center.x + radius, center.y + radius);
+            }
+            Shape::Arc {
+                center,
+                radius,
+                start,
+                sweep,
+            } => {
+                let (from, to) = if sweep < 0.0 {
+                    (start + sweep, start)
+                } else {
+                    (start, start + sweep)
+                };
+                let mut k = (from / FRAC_PI_2).ceil();
+                // At most five quadrant points lie in one turn.
+                for _ in 0..5 {
+                    let angle = k * FRAC_PI_2;
+                    if angle > to {
+                        break;
+                    }
+                    let (dx, dy) = match (k as i64).rem_euclid(4) {
+                        0 => (radius, 0.0),
+                        1 => (0.0, radius),
+                        2 => (-radius, 0.0),
+                        _ => (0.0, -radius),
+                    };
+                    lo = Point2::new(lo.x.min(center.x + dx), lo.y.min(center.y + dy));
+                    hi = Point2::new(hi.x.max(center.x + dx), hi.y.max(center.y + dy));
+                    k += 1.0;
+                }
+            }
+        }
+        (lo, hi)
+    }
+
+    /// Whether `p`, a point of the support circle, lies in the arc's angular span.
+    pub fn spans(&self, p: Point2, eps: f64) -> bool {
+        match self.shape {
+            Shape::Line | Shape::Circle { .. } => true,
+            Shape::Arc {
+                center,
+                radius,
+                start,
+                sweep,
+            } => {
+                let angle = (p.y - center.y).atan2(p.x - center.x);
+                let along = if sweep < 0.0 {
+                    start - angle
+                } else {
+                    angle - start
+                }
+                .rem_euclid(TAU);
+                let slack = (eps / radius).min(PI);
+                along <= sweep.abs() + slack || along >= TAU - slack
+            }
+        }
+    }
+}
+
+pub(super) type Key = (i64, i64);
+
+/// Quantize a validated coordinate; `SKETCH_LIMIT * ID_SCALE` is far inside `i64`.
+pub(super) fn quantum(v: f64) -> i64 {
+    (v * ID_SCALE).round() as i64
+}
+
+pub(super) fn key(p: Point2) -> Key {
+    (quantum(p.x), quantum(p.y))
+}
diff --git a/crates/geometry/src/sketch_chains/identity.rs b/crates/geometry/src/sketch_chains/identity.rs
new file mode 100644
index 000000000..d25bfbc1a
--- /dev/null
+++ b/crates/geometry/src/sketch_chains/identity.rs
@@ -0,0 +1,133 @@
+//! Provenance: canonical order and identity of a sketch chain. A closed chain is turned
+//! counterclockwise by its signed area (Green's theorem) and started at its lowest joint; an
+//! open chain starts at its lower end. The identity is the 128-bit FNV-1a hash (Fowler, Noll
+//! and Vo; IETF draft-eastlake-fnv, "The FNV Non-Cryptographic Hash Algorithm") of the layer
+//! name and the quantized curves in that order. Original implementation.
+
+use super::ChainId;
+use super::connect::Walk;
+use super::curve::{Key, Piece, Shape, cross, dist, key, quantum};
+
+const FNV_OFFSET: u128 = 0x6c62_272e_07bb_0142_62b8_2175_6295_c58d;
+const FNV_PRIME: u128 = 0x0000_0000_0100_0000_0000_0000_0000_013b;
+/// Mixed in first; raise the version when the fed bytes change, so old ids never alias new ones.
+const DOMAIN: &[u8] = b"camcraft-sketch-chain-v1";
+
+struct Fnv(u128);
+
+impl Fnv {
+    fn bytes(&mut self, bytes: &[u8]) {
+        for &byte in bytes {
+            self.0 = (self.0 ^ u128::from(byte)).wrapping_mul(FNV_PRIME);
+        }
+    }
+
+    fn int(&mut self, v: i64) {
+        self.bytes(&v.to_le_bytes());
+    }
+
+    fn key(&mut self, k: Key) {
+        self.int(k.0);
+        self.int(k.1);
+    }
+}
+
+/// Signed area of a closed walk, its joint gaps bridged by straight lines.
+pub(super) fn signed_area(pieces: &[(usize, Piece)]) -> f64 {
+    let mut area = 0.0;
+    for (i, (_, piece)) in pieces.iter().enumerate() {
+        area += piece.area_term();
+        if let Some((_, next)) = pieces.get((i + 1) % pieces.len()) {
+            area += 0.5 * cross(piece.b, next.a);
+        }
+    }
+    area
+}
+
+/// The widest joint gap the walk bridges (a closed walk includes its closing joint).
+pub(super) fn max_gap(walk: &Walk) -> f64 {
+    let n = walk.pieces.len();
+    let joints = if walk.closed { n } else { n.saturating_sub(1) };
+    let mut gap = 0.0f64;
+    for i in 0..joints {
+        if let (Some((_, from)), Some((_, to))) = (walk.pieces.get(i), walk.pieces.get((i + 1) % n))
+        {
+            gap = gap.max(dist(from.b, to.a));
+        }
+    }
+    gap
+}
+
+fn reverse(walk: &mut Walk) {
+    walk.pieces.reverse();
+    for (_, piece) in &mut walk.pieces {
+        *piece = piece.flipped();
+    }
+}
+
+/// Put the walk in its canonical direction and start. Returns the area of a closed walk
+/// (positive after the turn; zero for an open one).
+pub(super) fn canonicalize(walk: &mut Walk) -> f64 {
+    if walk.closed {
+        let mut area = signed_area(&walk.pieces);
+        if area < 0.0 {
+            reverse(walk);
+            area = -area;
+        }
+        // Joints are farther apart than the tolerance, which is above the quantum, so the
+        // lowest key is unique and the start does not depend on the input order.
+        let lowest = walk
+            .pieces
+            .iter()
+            .enumerate()
+            .min_by_key(|(_, (_, piece))| key(piece.a));
+        if let Some((at, _)) = lowest {
+            walk.pieces.rotate_left(at);
+        }
+        return area;
+    }
+    let first = walk.pieces.first().map(|(_, piece)| key(piece.a));
+    let last = walk.pieces.last().map(|(_, piece)| key(piece.b));
+    if last < first {
+        reverse(walk);
+    }
+    0.0
+}
+
+/// The key the chains of a layer are sorted by: where the canonical walk starts.
+pub(super) fn start_key(walk: &Walk) -> Key {
+    walk.pieces
+        .first()
+        .map_or((0, 0), |(_, piece)| key(piece.a))
+}
+
+pub(super) fn chain_id(layer: &str, walk: &Walk) -> ChainId {
+    let mut hash = Fnv(FNV_OFFSET);
+    hash.bytes(DOMAIN);
+    hash.int(layer.len() as i64);
+    hash.bytes(layer.as_bytes());
+    hash.bytes(&[u8::from(walk.closed)]);
+    hash.int(walk.pieces.len() as i64);
+    for (_, piece) in &walk.pieces {
+        match piece.shape {
+            Shape::Line => {
+                hash.bytes(&[1]);
+                hash.key(key(piece.a));
+                hash.key(key(piece.b));
+            }
+            Shape::Arc { center, radius, .. } => {
+                hash.bytes(&[2, u8::from(piece.travel_sweep() > 0.0)]);
+                hash.key(key(piece.a));
+                hash.key(key(piece.b));
+                hash.key(key(center));
+                hash.int(quantum(radius));
+            }
+            Shape::Circle { center, radius } => {
+                hash.bytes(&[3]);
+                hash.key(key(center));
+                hash.int(quantum(radius));
+            }
+        }
+    }
+    ChainId(hash.0)
+}
diff --git a/crates/geometry/src/sketch_chains/intersect.rs b/crates/geometry/src/sketch_chains/intersect.rs
new file mode 100644
index 000000000..7a180a29f
--- /dev/null
+++ b/crates/geometry/src/sketch_chains/intersect.rs
@@ -0,0 +1,146 @@
+//! Provenance: contact points of two line/arc/circle pieces. Segment-segment by the parametric
+//! cross-product test (O'Rourke, "Computational Geometry in C", 2nd ed., sec. 7.2); line-circle
+//! and circle-circle by the closed forms in Schneider and Eberly, "Geometric Tools for Computer
+//! Graphics" (2003), sec. 7.3 and 7.5. An end of one piece lying on the other also counts, which
+//! covers collinear and co-circular overlap. Original implementation.
+
+use super::curve::{Piece, Shape, cross, dist, dot, sub};
+use crate::geo2d::Point2;
+
+fn along(p: Point2, d: Point2, t: f64) -> Point2 {
+    Point2::new(p.x + d.x * t, p.y + d.y * t)
+}
+
+/// Distance from `p` to the piece's curve.
+fn distance(piece: &Piece, p: Point2, eps: f64) -> f64 {
+    match piece.shape {
+        Shape::Line => {
+            let d = sub(piece.b, piece.a);
+            let len2 = dot(d, d);
+            if len2 == 0.0 {
+                return dist(p, piece.a);
+            }
+            let t = (dot(sub(p, piece.a), d) / len2).clamp(0.0, 1.0);
+            dist(p, along(piece.a, d, t))
+        }
+        Shape::Circle { center, radius } => (dist(p, center) - radius).abs(),
+        Shape::Arc { center, radius, .. } => {
+            let ends = dist(p, piece.a).min(dist(p, piece.b));
+            if piece.spans(p, eps) {
+                ends.min((dist(p, center) - radius).abs())
+            } else {
+                ends
+            }
+        }
+    }
+}
+
+fn round(piece: &Piece) -> Option<(Point2, f64)> {
+    match piece.shape {
+        Shape::Line => None,
+        Shape::Arc { center, radius, .. } | Shape::Circle { center, radius } => {
+            Some((center, radius))
+        }
+    }
+}
+
+fn line_line(p: &Piece, q: &Piece, eps: f64, out: &mut Vec<Point2>) {
+    let (r, s) = (sub(p.b, p.a), sub(q.b, q.a));
+    let (lr, ls) = (dot(r, r).sqrt(), dot(s, s).sqrt());
+    let denom = cross(r, s);
+    // Parallel or point-like lines have no single crossing; their overlap shows at the ends.
+    if lr == 0.0 || ls == 0.0 || denom.abs() <= 1e-12 * lr * ls {
+        return;
+    }
+    let w = sub(q.a, p.a);
+    let (t, u) = (cross(w, s) / denom, cross(w, r) / denom);
+    if t >= -eps / lr && t <= 1.0 + eps / lr && u >= -eps / ls && u <= 1.0 + eps / ls {
+        out.push(along(p.a, r, t.clamp(0.0, 1.0)));
+    }
+}
+
+fn line_round(
+    line: &Piece,
+    arc: &Piece,
+    center: Point2,
+    radius: f64,
+    eps: f64,
+    out: &mut Vec<Point2>,
+) {
+    let d = sub(line.b, line.a);
+    let len = dot(d, d).sqrt();
+    if len == 0.0 {
+        return;
+    }
+    let f = sub(line.a, center);
+    let off = cross(f, d).abs() / len;
+    if off > radius + eps {
+        return;
+    }
+    let mid = -dot(f, d) / (len * len);
+    let half = (radius * radius - off * off).max(0.0).sqrt() / len;
+    for t in [mid - half, mid + half] {
+        if t >= -eps / len && t <= 1.0 + eps / len {
+            let at = along(line.a, d, t.clamp(0.0, 1.0));
+            if arc.spans(at, eps) {
+                out.push(at);
+            }
+        }
+    }
+}
+
+fn round_round(
+    p: &Piece,
+    q: &Piece,
+    (c1, r1): (Point2, f64),
+    (c2, r2): (Point2, f64),
+    eps: f64,
+    out: &mut Vec<Point2>,
+) {
+    let gap = dist(c1, c2);
+    if gap <= eps {
+        // Concentric: equal radii overlap. Arcs show that at their ends; two full circles
+        // have no ends, so name a point of the shared circle.
+        let circles = matches!(
+            (p.shape, q.shape),
+            (Shape::Circle { .. }, Shape::Circle { .. })
+        );
+        if circles && (r1 - r2).abs() <= eps {
+            out.push(p.a);
+        }
+        return;
+    }
+    if gap > r1 + r2 + eps || gap < (r1 - r2).abs() - eps {
+        return;
+    }
+    let a = (gap * gap + r1 * r1 - r2 * r2) / (2.0 * gap);
+    let h = (r1 * r1 - a * a).max(0.0).sqrt();
+    let u = Point2::new((c2.x - c1.x) / gap, (c2.y - c1.y) / gap);
+    let foot = along(c1, u, a);
+    for side in [-1.0, 1.0] {
+        let at = Point2::new(foot.x - side * h * u.y, foot.y + side * h * u.x);
+        if p.spans(at, eps) && q.spans(at, eps) {
+            out.push(at);
+        }
+    }
+}
+
+/// Append every point where `p` and `q` cross, touch or overlap within `eps`.
+pub(super) fn contacts(p: &Piece, q: &Piece, eps: f64, out: &mut Vec<Point2>) {
+    match (round(p), round(q)) {
+        (None, None) => line_line(p, q, eps, out),
+        (None, Some((center, radius))) => line_round(p, q, center, radius, eps, out),
+        (Some((center, radius)), None) => line_round(q, p, center, radius, eps, out),
+        (Some(a), Some(b)) => round_round(p, q, a, b, eps, out),
+    }
+    for (piece, other) in [(p, q), (q, p)] {
+        if matches!(piece.shape, Shape::Circle { .. }) {
+            continue;
+        }
+        for end in [piece.a, piece.b] {
+            if distance(other, end, eps) <= eps {
+                out.push(end);
+            }
+        }
+    }
+}
diff --git a/crates/geometry/src/sketch_chains/mod.rs b/crates/geometry/src/sketch_chains/mod.rs
new file mode 100644
index 000000000..a1f2bf6ae
--- /dev/null
+++ b/crates/geometry/src/sketch_chains/mod.rs
@@ -0,0 +1,286 @@
+//! Sketch chaining: join 2D line, arc and circle primitives into closed loops and open chains,
+//! give each a stable identity, and read the closed loops as outer boundaries or holes.
+//!
+//! Provenance: our own design from published computational-geometry literature; each submodule
+//! names its sources (grid neighbour search and union-find in `connect`, FNV-1a in `identity`,
+//! sweep and prune in `crossing`, closed-form contacts in `intersect`, crossing-number
+//! containment in `nesting`). No vendor code or output was consulted.
+//!
+//! Contract. Primitives and the join tolerance are in millimetres (scale a DXF document by its
+//! units first). Ends join only when they lie within the tolerance, and only on the same layer;
+//! a wider gap stays open and is reported, never closed. Curves are kept analytic: every chain
+//! segment is the input line, arc or circle, turned to the walk direction. Anything that cannot
+//! be a chain is listed in `rejected` with a named error, never dropped silently and never
+//! repaired. Nesting is read over all closed chains passed in, whatever their layers: filter the
+//! primitives first to nest a subset. This module has no file I/O and no application state.
+
+mod connect;
+mod crossing;
+mod curve;
+mod identity;
+mod intersect;
+mod nesting;
+mod types;
+
+use crate::dxf::LayeredPrimitive;
+use connect::{Component, Walk};
+use crossing::{Sealed, Search};
+use curve::{Key, Piece, Shape};
+use std::collections::{BTreeMap, HashMap, HashSet};
+
+pub use types::*;
+
+/// Pair tests one call may spend on joining, crossing search and nesting before it is refused.
+const WORK_LIMIT: u64 = 200_000_000;
+
+pub(crate) struct Budget(u64);
+
+impl Budget {
+    fn spend(&mut self, work: usize) -> Result<(), ChainError> {
+        self.0 = self
+            .0
+            .checked_sub(work as u64)
+            .ok_or(ChainError::TooComplex)?;
+        Ok(())
+    }
+}
+
+/// Geometry of a primitive as a key that is equal for a repeat drawn in either direction.
+fn repeat_key(piece: &Piece) -> (u8, [Key; 3], i64) {
+    let (a, b) = (curve::key(piece.a), curve::key(piece.b));
+    match piece.shape {
+        Shape::Line => (1, [a.min(b), a.max(b), (0, 0)], 0),
+        Shape::Arc {
+            center,
+            radius,
+            sweep,
+            ..
+        } => {
+            let (from, to) = if sweep < 0.0 { (b, a) } else { (a, b) };
+            (2, [from, to, curve::key(center)], curve::quantum(radius))
+        }
+        Shape::Circle { center, radius } => (3, [curve::key(center); 3], curve::quantum(radius)),
+    }
+}
+
+struct Draft {
+    layer: String,
+    walk: Walk,
+    id: ChainId,
+    area: f64,
+}
+
+impl Draft {
+    fn order(&self) -> (&str, Key, ChainId) {
+        (&self.layer, identity::start_key(&self.walk), self.id)
+    }
+
+    fn indices(&self) -> Vec<usize> {
+        let mut indices: Vec<usize> = self.walk.pieces.iter().map(|(index, _)| *index).collect();
+        indices.sort_unstable();
+        indices
+    }
+
+    fn segments(&self) -> Vec<ChainSegment> {
+        let segment = |&(primitive, piece): &(usize, Piece)| ChainSegment {
+            primitive,
+            curve: piece.oriented(),
+            reversed: piece.reversed,
+            start: piece.a,
+            end: piece.b,
+        };
+        self.walk.pieces.iter().map(segment).collect()
+    }
+}
+
+/// Chain `primitives` (millimetres) by `options`. `Err` is for input no chain can be read
+/// from at all: a bad tolerance, a non-finite, out-of-range or invalid primitive, or a drawing
+/// over the size and work limits. Everything else is in the result, chained or rejected by name.
+pub fn chain(
+    primitives: &[LayeredPrimitive],
+    options: ChainOptions,
+) -> Result<SketchChains, ChainError> {
+    let tol = options.join_tolerance;
+    if !(tol.is_finite() && (MIN_JOIN_TOLERANCE..=MAX_JOIN_TOLERANCE).contains(&tol)) {
+        return Err(ChainError::InvalidTolerance);
+    }
+    if primitives.len() > MAX_PRIMITIVES {
+        return Err(ChainError::TooComplex);
+    }
+    let mut budget = Budget(WORK_LIMIT);
+    let mut out = SketchChains::default();
+    let mut layers: BTreeMap<&str, Vec<(usize, Piece)>> = BTreeMap::new();
+    let mut seen = HashMap::new();
+    let mut extent = 0.0f64;
+    for (index, item) in primitives.iter().enumerate() {
+        let piece = Piece::from_primitive(index, &item.primitive)?;
+        let (lo, hi) = piece.bounds();
+        extent = [lo.x, lo.y, hi.x, hi.y]
+            .iter()
+            .fold(extent, |m, v| m.max(v.abs()));
+        let first = *seen
+            .entry((item.layer.as_str(), repeat_key(&piece)))
+            .or_insert(index);
+        if first == index {
+            layers
+                .entry(item.layer.as_str())
+                .or_default()
+                .push((index, piece));
+        } else {
+            let error = ChainError::DuplicatePrimitive {
+                primitive: index,
+                of: first,
+            };
+            out.rejected.push(Rejected {
+                layer: item.layer.clone(),
+                primitives: vec![index],
+                error,
+            });
+        }
+    }
+    // Absolute slack of the contact tests: above float noise at this extent, and (coordinates
+    // are below 1e7 mm) never above the smallest join tolerance.
+    let eps = 1e-12 * (1.0 + extent);
+
+    let mut drafts = Vec::new();
+    for (layer, pieces) in &layers {
+        for component in connect::connect(pieces, tol, &mut budget)? {
+            match component {
+                Component::Rejected(mut primitives, error) => {
+                    primitives.sort_unstable();
+                    out.rejected.push(Rejected {
+                        layer: (*layer).into(),
+                        primitives,
+                        error,
+                    });
+                }
+                Component::Walk(mut walk) => {
+                    let area = identity::canonicalize(&mut walk);
+                    let id = identity::chain_id(layer, &walk);
+                    drafts.push(Draft {
+                        layer: (*layer).into(),
+                        walk,
+                        id,
+                        area,
+                    });
+                }
+            }
+        }
+    }
+    drafts.sort_by(|p, q| p.order().cmp(&q.order()));
+    let mut ids = HashSet::new();
+    let mut closed = Vec::new();
+    for draft in drafts {
+        if !ids.insert(draft.id) {
+            let error = ChainError::DuplicateChain { of: draft.id };
+            out.rejected.push(Rejected {
+                layer: draft.layer.clone(),
+                primitives: draft.indices(),
+                error,
+            });
+        } else if draft.walk.closed {
+            closed.push(draft);
+        } else {
+            let (first, last) = (draft.walk.pieces.first(), draft.walk.pieces.last());
+            let (Some((_, first)), Some((_, last))) = (first, last) else {
+                continue;
+            };
+            out.open.push(OpenChain {
+                id: draft.id,
+                layer: draft.layer.clone(),
+                segments: draft.segments(),
+                start: first.a,
+                end: last.b,
+                max_gap: identity::max_gap(&draft.walk),
+            });
+        }
+    }
+    nest(closed, tol, eps, &mut budget, &mut out)?;
+    out.rejected
+        .sort_by(|p, q| (&p.layer, &p.primitives).cmp(&(&q.layer, &q.primitives)));
+    Ok(out)
+}
+
+/// Refuse the self-crossing and the empty loops, then read the nesting of the rest.
+fn nest(
+    closed: Vec<Draft>,
+    tol: f64,
+    eps: f64,
+    budget: &mut Budget,
+    out: &mut SketchChains,
+) -> Result<(), ChainError> {
+    let loops: Vec<Sealed> = closed
+        .iter()
+        .map(|draft| {
+            Sealed::new(
+                &draft
+                    .walk
+                    .pieces
+                    .iter()
+                    .map(|(_, piece)| *piece)
+                    .collect::<Vec<_>>(),
+            )
+        })
+        .collect();
+    let within = crossing::search(
+        &loops,
+        &vec![false; loops.len()],
+        Search::Within,
+        tol,
+        eps,
+        budget,
+    )?;
+    // A loop that crosses itself or encloses nothing is refused and takes no part in nesting.
+    let refusal = |i: usize| match (within.get(i), closed.get(i)) {
+        (Some(&Some((_, at))), _) => Some(ChainError::SelfCrossing { at }),
+        (_, Some(draft)) if draft.area <= tol * tol => Some(ChainError::ZeroArea),
+        _ => None,
+    };
+    let refused: Vec<bool> = (0..loops.len()).map(|i| refusal(i).is_some()).collect();
+    let between = crossing::search(&loops, &refused, Search::Between, tol, eps, budget)?;
+    let containers = nesting::containers(&loops, &refused, budget)?;
+    let id_of = |i: usize| closed.get(i).map(|draft| draft.id);
+    let ambiguous = |i: usize| match between.get(i) {
+        Some(&Some((other, at))) => {
+            id_of(other).map(|other| ChainError::NestingAmbiguous { other, at })
+        }
+        _ => None,
+    };
+    for (i, draft) in closed.iter().enumerate() {
+        if let Some(error) = refusal(i) {
+            out.rejected.push(Rejected {
+                layer: draft.layer.clone(),
+                primitives: draft.indices(),
+                error,
+            });
+            continue;
+        }
+        let around = containers.get(i).map_or(&[][..], Vec::as_slice);
+        let depth_of = |j: usize| containers.get(j).map_or(0, Vec::len);
+        let nesting = match ambiguous(i).or_else(|| around.iter().find_map(|&j| ambiguous(j))) {
+            Some(error) => Err(error),
+            None => Ok(Nesting {
+                role: if around.len().is_multiple_of(2) {
+                    LoopRole::Outer
+                } else {
+                    LoopRole::Hole
+                },
+                depth: around.len(),
+                parent: around
+                    .iter()
+                    .copied()
+                    .max_by_key(|&j| depth_of(j))
+                    .and_then(id_of),
+            }),
+        };
+        out.closed.push(ClosedChain {
+            id: draft.id,
+            layer: draft.layer.clone(),
+            segments: draft.segments(),
+            area: draft.area,
+            max_gap: identity::max_gap(&draft.walk),
+            nesting,
+        });
+    }
+    Ok(())
+}
diff --git a/crates/geometry/src/sketch_chains/nesting.rs b/crates/geometry/src/sketch_chains/nesting.rs
