diff --git a/crates/ui/src/egui_app/tests/body_drag.rs b/crates/ui/src/egui_app/tests/body_drag.rs
index de68ff26a..2a0529b8f 100644
--- a/crates/ui/src/egui_app/tests/body_drag.rs
+++ b/crates/ui/src/egui_app/tests/body_drag.rs
@@ -177,3 +177,101 @@ fn focus_loss_mid_drag_cancels_and_a_later_release_sends_no_move() {
