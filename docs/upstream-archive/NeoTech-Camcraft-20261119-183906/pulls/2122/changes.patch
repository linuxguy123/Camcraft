index 000000000..a8a928f66
--- /dev/null
+++ b/crates/app/src/ai/mod.rs
@@ -0,0 +1,26 @@
+//! AI provider transport (#1945): where a chat step may go (endpoint and
+//! offline law), what it looks like on the wire, where the API key comes
+//! from, and the native HTTP client that sends it.
+//!
+//! The browser build links none of the socket or keychain code: `http`
+//! and `keychain` exist only off `wasm32`, the rest is plain data.
+//!
+//! Provenance: our own policy code over the public Anthropic Messages,
+//! OpenAI Chat Completions and Responses, Google Gemini `generateContent`
+//! and Ollama `/api/show` API documentation.
+
+pub mod endpoint;
+pub mod presets;
+pub mod probe;
+pub mod secret;
+pub mod wire;
+
+#[cfg(not(target_arch = "wasm32"))]
+pub mod http;
+#[cfg(not(target_arch = "wasm32"))]
+pub mod keychain;
+
+pub use endpoint::{Endpoint, Scheme, admit, is_loopback_host};
+pub use presets::{ENDPOINTS, ProviderEndpoint, by_id};
+pub use secret::{ApiKey, KeyName, KeySource};
+pub use wire::{ChatMessage, ChatRequest, Image, WireRequest};
diff --git a/crates/app/src/ai/presets.rs b/crates/app/src/ai/presets.rs
new file mode 100644
index 000000000..6a0fd88eb
--- /dev/null
+++ b/crates/app/src/ai/presets.rs
@@ -0,0 +1,121 @@
+//! The provider endpoints CamCraft knows (#1945): three public cloud APIs
+//! over https and four OpenAI-compatible model runtimes on loopback.
+//!
+//! Provenance: base URLs and paths from each provider's public API
+//! documentation (Anthropic Messages, OpenAI Chat Completions and
+//! Responses, Google Gemini `generateContent`), and the documented default
+//! ports of Ollama, LM Studio and llama.cpp's `llama-server`; Unsloth
+//! Studio's from issue #1945.
+
+use crate::mcp::provider::Provider;
+
+use super::secret::KeyName;
+
+/// One selectable endpoint: its wire format, default base URL, and the
+/// key it needs (cloud) or the capability probe it offers (Ollama).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ProviderEndpoint {
+    pub id: &'static str,
+    pub label: &'static str,
+    pub provider: Provider,
+    /// The default base URL; a user may point a local runtime elsewhere.
+    pub base_url: &'static str,
+    /// The API key this endpoint needs; `None` for a local runtime.
+    pub key: Option<KeyName>,
+    /// Ollama's native `/api/show` probe answers "does this model call
+    /// tools / see images" (beside the `/v1` OpenAI-compatible base).
+    pub ollama_probe: bool,
+}
+
+/// Every endpoint, cloud first.
+pub const ENDPOINTS: &[ProviderEndpoint] = &[
+    ProviderEndpoint {
+        id: "anthropic",
+        label: "Anthropic Messages",
+        provider: Provider::Anthropic,
+        base_url: "https://api.anthropic.com/v1",
+        key: Some(KeyName::Anthropic),
+        ollama_probe: false,
+    },
+    ProviderEndpoint {
+        id: "openai-chat",
+        label: "OpenAI Chat Completions",
+        provider: Provider::OpenAiChat,
+        base_url: "https://api.openai.com/v1",
+        key: Some(KeyName::OpenAi),
+        ollama_probe: false,
+    },
+    ProviderEndpoint {
+        id: "openai-responses",
+        label: "OpenAI Responses (GPT, Codex)",
+        provider: Provider::OpenAiResponses,
+        base_url: "https://api.openai.com/v1",
+        key: Some(KeyName::OpenAi),
+        ollama_probe: false,
+    },
+    ProviderEndpoint {
+        id: "gemini",
+        label: "Google Gemini",
+        provider: Provider::Gemini,
+        base_url: "https://generativelanguage.googleapis.com/v1beta",
+        key: Some(KeyName::Gemini),
+        ollama_probe: false,
+    },
+    ProviderEndpoint {
+        id: "ollama",
+        label: "Ollama (local)",
+        provider: Provider::OpenAiChat,
+        base_url: "http://localhost:11434/v1",
+        key: None,
+        ollama_probe: true,
+    },
+    ProviderEndpoint {
+        id: "unsloth-studio",
+        label: "Unsloth Studio (local)",
+        provider: Provider::OpenAiChat,
+        base_url: "http://127.0.0.1:8888/v1",
+        key: None,
+        ollama_probe: false,
+    },
+    ProviderEndpoint {
+        id: "lm-studio",
+        label: "LM Studio (local)",
+        provider: Provider::OpenAiChat,
+        base_url: "http://localhost:1234/v1",
+        key: None,
+        ollama_probe: false,
+    },
+    ProviderEndpoint {
+        id: "llama-server",
+        label: "llama.cpp llama-server (local, start with --jinja for tools)",
+        provider: Provider::OpenAiChat,
+        base_url: "http://127.0.0.1:8080/v1",
+        key: None,
+        ollama_probe: false,
+    },
+];
+
+/// Look an endpoint up by its id.
+#[must_use]
+pub fn by_id(id: &str) -> Option<&'static ProviderEndpoint> {
+    ENDPOINTS.iter().find(|e| e.id == id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ai::endpoint::{Endpoint, Scheme};
+
+    #[test]
+    fn cloud_is_https_with_a_key_and_local_is_loopback_without() {
+        for e in ENDPOINTS {
+            let ep = Endpoint::parse(e.base_url).expect("preset parses");
+            if e.key.is_some() {
+                assert_eq!(ep.scheme, Scheme::Https, "{}", e.id);
+                assert!(!ep.is_loopback(), "{}", e.id);
+            } else {
+                assert!(ep.is_loopback(), "{}", e.id);
+            }
+        }
+    }
+}
diff --git a/crates/app/src/ai/probe.rs b/crates/app/src/ai/probe.rs
new file mode 100644
index 000000000..120dc8229
--- /dev/null
+++ b/crates/app/src/ai/probe.rs
@@ -0,0 +1,65 @@
+//! What a local Ollama model can do (#1945), read from its `/api/show`
+//! answer: native tool calls, image input, and the chat fallback mode
+//! that follows (native tools, else prompt JSON for a completion model,
+//! else read-only Q&A).
+//!
+//! Provenance: Ollama's public API documentation (`POST /api/show`, the
+//! `capabilities` list); older servers without that list are read from
+//! the model template's `.Tools` variable, as that documentation shows.
+
+use serde_json::{Value, json};
+
+use crate::mcp::provider::FallbackMode;
+
+/// A local model's capabilities.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Capabilities {
+    pub tools: bool,
+    pub vision: bool,
+    pub mode: FallbackMode,
+}
+
+/// The `/api/show` request body for `model`.
+#[must_use]
+pub fn show_request(model: &str) -> Value {
+    json!({ "model": model })
+}
+
+/// Read an `/api/show` answer.
+pub fn parse_show(answer: &Value) -> Result<Capabilities, String> {
+    if !answer.is_object() {
+        return Err("Ollama /api/show did not answer an object".into());
+    }
+    if let Some(e) = answer.get("error").and_then(Value::as_str) {
+        return Err(format!("Ollama /api/show: {e}"));
+    }
+    let (tools, vision, completion) = match answer.get("capabilities").and_then(Value::as_array) {
+        Some(caps) => {
+            let has = |c: &str| caps.iter().any(|v| v.as_str() == Some(c));
+            (has("tools"), has("vision"), has("completion"))
+        }
+        None => {
+            let template = answer.get("template").and_then(Value::as_str).unwrap_or_default();
+            (template.contains(".Tools"), false, true)
+        }
+    };
+    Ok(Capabilities { tools, vision, mode: FallbackMode::for_capabilities(tools, completion) })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn capabilities_pick_the_fallback() {
+        let c = parse_show(&json!({"capabilities":["completion","tools","vision"]})).expect("ok");
+        assert_eq!((c.tools, c.vision, c.mode), (true, true, FallbackMode::Native));
+        let c = parse_show(&json!({"capabilities":["completion"]})).expect("ok");
+        assert_eq!(c.mode, FallbackMode::PromptJson);
+        let c = parse_show(&json!({"capabilities":["embedding"]})).expect("ok");
+        assert_eq!(c.mode, FallbackMode::ReadOnly);
+        let c = parse_show(&json!({"template":"{{ if .Tools }}x{{ end }}"})).expect("ok");
+        assert!(c.tools);
+        assert!(parse_show(&json!({"error":"model 'x' not found"})).is_err());
+    }
+}
diff --git a/crates/app/src/ai/secret.rs b/crates/app/src/ai/secret.rs
new file mode 100644
index 000000000..fce4ac811
--- /dev/null
+++ b/crates/app/src/ai/secret.rs
@@ -0,0 +1,133 @@
+//! API keys (#1945): a key lives in the OS keychain or in an environment
+//! variable, never in `prefs.json` or a project file. The `ApiKey` type
+//! has no `Display` and a redacted `Debug`, so a key cannot reach a log,
+//! a status line or an error message by formatting.
+//!
+//! Provenance: our own design; the variable names are the ones each
+//! provider's public SDK documentation reads (`ANTHROPIC_API_KEY`,
+//! `OPENAI_API_KEY`, `GEMINI_API_KEY`).
+
+use std::fmt;
+
+/// Which provider account a key belongs to.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum KeyName {
+    Anthropic,
+    OpenAi,
+    Gemini,
+}
+
+impl KeyName {
+    pub const ALL: [Self; 3] = [Self::Anthropic, Self::OpenAi, Self::Gemini];
+
+    /// The environment variable read before the keychain.
+    #[must_use]
+    pub fn env_var(self) -> &'static str {
+        match self {
+            Self::Anthropic => "ANTHROPIC_API_KEY",
+            Self::OpenAi => "OPENAI_API_KEY",
+            Self::Gemini => "GEMINI_API_KEY",
+        }
+    }
+
+    /// The keychain account name (under the service `KEYCHAIN_SERVICE`).
+    #[must_use]
+    pub fn account(self) -> &'static str {
+        match self {
+            Self::Anthropic => "anthropic",
+            Self::OpenAi => "openai",
+            Self::Gemini => "gemini",
+        }
+    }
+
+    /// The provider's name for messages.
+    #[must_use]
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Anthropic => "Anthropic",
+            Self::OpenAi => "OpenAI",
+            Self::Gemini => "Gemini",
+        }
+    }
+}
+
+/// The keychain service every CamCraft AI key is filed under.
+pub const KEYCHAIN_SERVICE: &str = "camcraft-ai";
+
+/// Where a key was found.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum KeySource {
+    Environment,
+    Keychain,
+}
+
+/// A provider API key. Opaque: no `Display`, `Debug` prints `ApiKey(***)`.
+#[derive(Clone, PartialEq, Eq)]
+pub struct ApiKey(String);
+
+impl ApiKey {
+    /// Accept a key. Refuses an empty one and any control character (a
+    /// newline in a header value would split the request).
+    pub fn new(text: &str) -> Result<Self, String> {
+        let t = text.trim();
+        if t.is_empty() {
+            return Err("the API key is empty".into());
+        }
+        if t.chars().any(char::is_control) {
+            return Err("the API key holds a control character".into());
+        }
+        Ok(Self(t.to_owned()))
+    }
+
+    /// The key text, for the auth header only.
+    #[must_use]
+    pub fn expose(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Debug for ApiKey {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("ApiKey(***)")
+    }
+}
+
+/// Find the key for `name`: the environment variable first, then the
+/// keychain. `env` and `keychain` are passed in so the order is testable
+/// without a real keychain (the native one is `keychain::load`).
+pub fn lookup(
+    name: KeyName,
+    env: impl Fn(&str) -> Option<String>,
+    keychain: impl Fn(KeyName) -> Result<Option<ApiKey>, String>,
+) -> Result<Option<(ApiKey, KeySource)>, String> {
+    if let Some(v) = env(name.env_var()).filter(|v| !v.trim().is_empty()) {
+        let key = ApiKey::new(&v).map_err(|e| format!("{}: {e}", name.env_var()))?;
+        return Ok(Some((key, KeySource::Environment)));
+    }
+    Ok(keychain(name)?.map(|k| (k, KeySource::Keychain)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn debug_never_shows_the_key() {
+        let k = ApiKey::new("  placeholder-not-a-key ").expect("accepted");
+        assert_eq!(format!("{k:?}"), "ApiKey(***)");
+        assert_eq!(k.expose(), "placeholder-not-a-key");
+        assert!(ApiKey::new("a\r\nX-Evil: 1").is_err());
+        assert!(ApiKey::new("   ").is_err());
+    }
+
+    #[test]
+    fn environment_wins_over_the_keychain() {
+        let env = |v: &str| (v == "OPENAI_API_KEY").then(|| "from-env".to_owned());
+        let chain = |_| Ok(Some(ApiKey::new("from-chain").expect("ok")));
+        let (k, src) = lookup(KeyName::OpenAi, env, chain).expect("ok").expect("found");
+        assert_eq!((k.expose(), src), ("from-env", KeySource::Environment));
+        let (k, src) = lookup(KeyName::Gemini, env, chain).expect("ok").expect("found");
+        assert_eq!((k.expose(), src), ("from-chain", KeySource::Keychain));
+        assert!(lookup(KeyName::Anthropic, |_| None, |_| Ok(None)).expect("ok").is_none());
+    }
+}
diff --git a/crates/app/src/ai/wire.rs b/crates/app/src/ai/wire.rs
new file mode 100644
index 000000000..5c64e19aa
--- /dev/null
+++ b/crates/app/src/ai/wire.rs
@@ -0,0 +1,262 @@
+//! One chat step on the wire (#1945): the request path and JSON body for
+//! each provider, from a provider-neutral message list. Tool-call and
+//! tool-result envelopes (`raw`) are echoed in the provider's own shape,
+//! so reasoning items and thought signatures survive a tool round trip.
+//!
+//! Provenance: the public request formats of the Anthropic Messages API,
+//! OpenAI Chat Completions and Responses APIs and the Gemini
+//! `generateContent` API.
+
+use serde_json::{Value, json};
+
+use crate::mcp::provider::Provider;
+
+/// An inline image (a viewport screenshot), base64 encoded.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Image {
+    pub mime_type: String,
+    pub data_base64: String,
+}
+
+/// One message: `role` is `user`, `assistant` or `tool`. `raw` is the
+/// provider envelope of an assistant step or a `tool_result` item.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChatMessage {
+    pub role: String,
+    pub text: String,
+    pub image: Option<Image>,
+    pub raw: Option<Value>,
+}
+
+/// What one step asks of the model.
+#[derive(Clone, Debug)]
+pub struct ChatRequest<'a> {
+    pub provider: Provider,
+    pub model: &'a str,
+    pub system: Option<String>,
+    pub messages: &'a [ChatMessage],
+    /// Native tool declarations, already in the provider's shape
+    /// (`mcp::provider::tools`); empty sends none.
+    pub tools: &'a [Value],
+    pub max_tokens: u32,
+}
+
+/// The path under the endpoint base, and the body. Never holds a key.
+#[derive(Clone, Debug, PartialEq)]
+pub struct WireRequest {
+    pub path: String,
+    pub body: Value,
+    /// Fixed, non-secret headers (Anthropic's API version).
+    pub headers: Vec<(String, String)>,
+}
+
+/// The default answer budget (Anthropic requires one).
+pub const DEFAULT_MAX_TOKENS: u32 = 4096;
+
+/// A model id goes into a URL path for Gemini: letters, digits and
+/// `.-_:/` only, so it can never add a query or climb the path.
+pub fn check_model(model: &str) -> Result<(), String> {
+    let ok = !model.is_empty()
+        && model.len() <= 200
+        && !model.contains("..")
+        && model.chars().all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '-' | '_' | ':' | '/'));
+    if ok { Ok(()) } else { Err(format!("model id '{model}' is not a valid model name")) }
+}
+
+/// Split the chat panel's tools payload: `{"tools":[...]}` is native
+/// tools; a fallback context (`{"instructions", ...}`) goes into the
+/// system prompt as JSON, with no tools sent.
+#[must_use]
+pub fn split_payload(payload: &Value) -> (Vec<Value>, Option<String>) {
+    if payload.get("instructions").is_some() {
+        let instructions = payload["instructions"].as_str().unwrap_or_default();
+        return (Vec::new(), Some(format!("{instructions}\n\nContext (JSON):\n{payload}")));
+    }
+    let tools = payload.get("tools").and_then(Value::as_array).cloned().unwrap_or_default();
+    (tools, None)
+}
+
+/// Build the request for `req.provider`.
+pub fn build(req: &ChatRequest<'_>) -> Result<WireRequest, String> {
+    check_model(req.model)?;
+    let mut headers = Vec::new();
+    let (path, body) = match req.provider {
+        Provider::Anthropic => {
+            headers.push(("anthropic-version".to_owned(), "2023-06-01".to_owned()));
+            ("/messages".to_owned(), anthropic(req))
+        }
+        Provider::OpenAiChat => ("/chat/completions".to_owned(), openai_chat(req)),
+        Provider::OpenAiResponses => ("/responses".to_owned(), openai_responses(req)),
+        Provider::Gemini => {
+            if req.model.contains('/') {
+                return Err(format!("Gemini model id '{}' must not hold '/'", req.model));
+            }
+            (format!("/models/{}:generateContent", req.model), gemini(req))
+        }
+    };
+    Ok(WireRequest { path, body, headers })
+}
+
+fn data_url(img: &Image) -> String {
+    format!("data:{};base64,{}", img.mime_type, img.data_base64)
+}
+
+/// Push `item` into the trailing message of `role` when there is one,
+/// else open a new one. Anthropic wants every tool result of a step in
+/// one user message; Gemini every function response in one turn.
+fn push_merged(out: &mut Vec<Value>, role: &str, key: &str, item: Value) {
+    if let Some(last) = out.last_mut()
+        && last["role"] == role
+        && last.get("__merge").is_some()
+        && let Some(items) = last[key].as_array_mut()
+    {
+        items.push(item);
+        return;
+    }
+    out.push(json!({"role": role, key: [item], "__merge": true}));
+}
+
+fn strip_merge_marks(out: &mut [Value]) {
+    for m in out {
+        if let Some(o) = m.as_object_mut() {
+            o.remove("__merge");
+        }
+    }
+}
+
+fn anthropic(req: &ChatRequest<'_>) -> Value {
+    let mut msgs: Vec<Value> = Vec::new();
+    for m in req.messages {
+        match (m.role.as_str(), &m.raw) {
+            ("tool", Some(raw)) => push_merged(&mut msgs, "user", "content", raw.clone()),
+            ("assistant", Some(raw)) if raw["content"].is_array() => {
+                msgs.push(json!({"role":"assistant","content":raw["content"]}));
+            }
+            ("assistant", _) if !m.text.is_empty() => msgs.push(json!({"role":"assistant","content":m.text})),
+            ("user", _) => {
+                let mut content = vec![json!({"type":"text","text":m.text})];
+                if let Some(img) = &m.image {
+                    content.push(json!({"type":"image","source":{
+                        "type":"base64","media_type":img.mime_type,"data":img.data_base64}}));
+                }
+                msgs.push(json!({"role":"user","content":content}));
+            }
+            _ => {}
+        }
+    }
+    strip_merge_marks(&mut msgs);
+    let mut body = json!({"model":req.model,"max_tokens":req.max_tokens,"messages":msgs});
+    if let Some(s) = &req.system {
+        body["system"] = json!(s);
+    }
+    if !req.tools.is_empty() {
+        body["tools"] = json!(req.tools);
+    }
+    body
+}
+
+fn openai_chat(req: &ChatRequest<'_>) -> Value {
+    let mut msgs: Vec<Value> = Vec::new();
+    if let Some(s) = &req.system {
+        msgs.push(json!({"role":"system","content":s}));
+    }
+    for m in req.messages {
+        match (m.role.as_str(), &m.raw) {
+            ("tool", Some(raw)) => msgs.push(raw.clone()),
+            ("assistant", Some(raw)) if raw["choices"][0]["message"].is_object() => {
+                msgs.push(raw["choices"][0]["message"].clone());
+            }
+            ("assistant", _) if !m.text.is_empty() => msgs.push(json!({"role":"assistant","content":m.text})),
+            ("user", _) => match &m.image {
+                None => msgs.push(json!({"role":"user","content":m.text})),
+                Some(img) => msgs.push(json!({"role":"user","content":[
+                    {"type":"text","text":m.text},
+                    {"type":"image_url","image_url":{"url":data_url(img)}}]})),
+            },
+            _ => {}
+        }
+    }
+    let mut body = json!({"model":req.model,"messages":msgs,"max_tokens":req.max_tokens});
+    if !req.tools.is_empty() {
+        body["tools"] = json!(req.tools);
+    }
+    body
+}
+
+fn openai_responses(req: &ChatRequest<'_>) -> Value {
+    let mut input: Vec<Value> = Vec::new();
+    for m in req.messages {
+        match (m.role.as_str(), &m.raw) {
+            ("tool", Some(raw)) => input.push(raw.clone()),
+            ("assistant", Some(raw)) if raw["output"].is_array() => {
+                input.extend(raw["output"].as_array().into_iter().flatten().cloned());
+            }
+            ("assistant", _) if !m.text.is_empty() => input.push(json!({"role":"assistant","content":m.text})),
+            ("user", _) => {
+                let mut content = vec![json!({"type":"input_text","text":m.text})];
+                if let Some(img) = &m.image {
+                    content.push(json!({"type":"input_image","image_url":data_url(img)}));
+                }
+                input.push(json!({"role":"user","content":content}));
+            }
+            _ => {}
+        }
+    }
+    let mut body = json!({"model":req.model,"input":input,"max_output_tokens":req.max_tokens});
+    if let Some(s) = &req.system {
+        body["instructions"] = json!(s);
+    }
+    if !req.tools.is_empty() {
+        body["tools"] = json!(req.tools);
+    }
+    body
+}
+
+fn gemini(req: &ChatRequest<'_>) -> Value {
+    let mut contents: Vec<Value> = Vec::new();
+    for m in req.messages {
+        match (m.role.as_str(), &m.raw) {
+            ("tool", Some(raw)) => push_merged(&mut contents, "user", "parts", raw.clone()),
+            ("assistant", Some(raw)) if raw["candidates"][0]["content"].is_object() => {
+                let mut c = raw["candidates"][0]["content"].clone();
+                c["role"] = json!("model");
+                contents.push(c);
+            }
+            ("assistant", _) if !m.text.is_empty() => {
+                contents.push(json!({"role":"model","parts":[{"text":m.text}]}));
+            }
+            ("user", _) => {
+                let mut parts = vec![json!({"text":m.text})];
+                if let Some(img) = &m.image {
+                    parts.push(json!({"inlineData":{"mimeType":img.mime_type,"data":img.data_base64}}));
+                }
+                contents.push(json!({"role":"user","parts":parts}));
+            }
+            _ => {}
+        }
+    }
+    strip_merge_marks(&mut contents);
+    let mut body = json!({"contents":contents,"generationConfig":{"maxOutputTokens":req.max_tokens}});
+    if let Some(s) = &req.system {
+        body["systemInstruction"] = json!({"parts":[{"text":s}]});
+    }
+    if !req.tools.is_empty() {
+        body["tools"] = json!(req.tools);
+    }
+    body
+}
+
+#[cfg(test)]
