diff --git a/crates/app/src/ai/endpoint.rs b/crates/app/src/ai/endpoint.rs
new file mode 100644
index 000000000..5d0db16fc
--- /dev/null
+++ b/crates/app/src/ai/endpoint.rs
@@ -0,0 +1,161 @@
+//! Where an AI chat step may be sent (#1945): the endpoint URL, the
+//! loopback test, and the two laws checked before any socket opens -
+//! offline-only reaches loopback hosts alone, and nothing leaves this
+//! machine over plain `http://` (a key or a prompt would travel in clear).
+//!
+//! Provenance: our own policy; loopback per RFC 6761 ("localhost") and
+//! RFC 5735 / RFC 4291 (127.0.0.0/8, ::1). URLs parse with the WHATWG
+//! `url` crate, the same parser the HTTP client uses, so the host checked
+//! here is the host it connects to.
+
+use std::net::{IpAddr, SocketAddr};
+
+/// The URL scheme of an endpoint. Nothing else is accepted.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Scheme {
+    Http,
+    Https,
+}
+
+/// A parsed provider base URL, e.g. `https://api.openai.com/v1` or
+/// `http://localhost:11434/v1`. No user info, query or fragment.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Endpoint {
+    pub scheme: Scheme,
+    /// The host without IPv6 brackets, lower-cased.
+    pub host: String,
+    pub port: u16,
+    /// The base path without a trailing slash (`""` for the root).
+    pub base_path: String,
+}
+
+impl Endpoint {
+    /// Parse a base URL, refusing anything a provider base has no use
+    /// for and anything that could hide the real host.
+    pub fn parse(text: &str) -> Result<Self, String> {
+        let url = url::Url::parse(text.trim()).map_err(|e| format!("endpoint '{text}' is not a URL ({e})"))?;
+        let scheme = match url.scheme() {
+            "http" => Scheme::Http,
+            "https" => Scheme::Https,
+            other => return Err(format!("endpoint scheme '{other}' is not http or https")),
+        };
+        if !url.username().is_empty() || url.password().is_some() {
+            return Err("endpoint must not carry a user name or password".into());
+        }
+        if url.query().is_some() || url.fragment().is_some() {
+            return Err("endpoint must not carry a query or fragment".into());
+        }
+        let host = match url.host() {
+            Some(url::Host::Domain(d)) => d.to_ascii_lowercase(),
+            Some(url::Host::Ipv4(ip)) => ip.to_string(),
+            Some(url::Host::Ipv6(ip)) => ip.to_string(),
+            None => return Err(format!("endpoint '{text}' has no host")),
+        };
+        let port = url.port_or_known_default().ok_or_else(|| format!("endpoint '{text}' has no port"))?;
+        let base_path = url.path().trim_end_matches('/').to_owned();
+        Ok(Self { scheme, host, port, base_path })
+    }
+
+    /// True for `localhost`, 127.0.0.0/8 and `::1` (also IPv4-mapped).
+    #[must_use]
+    pub fn is_loopback(&self) -> bool {
+        is_loopback_host(&self.host)
+    }
+
+    /// The full URL of `path` (which starts with `/`) under this base.
+    #[must_use]
+    pub fn url(&self, path: &str) -> String {
+        let scheme = match self.scheme {
+            Scheme::Http => "http",
+            Scheme::Https => "https",
+        };
+        let host = if self.host.contains(':') { format!("[{}]", self.host) } else { self.host.clone() };
+        format!("{scheme}://{host}:{}{}{path}", self.port, self.base_path)
+    }
+
+    /// The same host and port with another base path (the Ollama probe
+    /// lives at `/api/show`, beside its `/v1` chat base).
+    #[must_use]
+    pub fn with_base_path(&self, base_path: &str) -> Self {
+        Self { base_path: base_path.trim_end_matches('/').to_owned(), ..self.clone() }
+    }
+}
+
+/// True when `host` names this machine's loopback interface. Only the
+/// literal name `localhost` counts by name; any other name is remote
+/// until resolved (and the client re-checks resolved addresses).
+#[must_use]
+pub fn is_loopback_host(host: &str) -> bool {
+    let h = host.trim_start_matches('[').trim_end_matches(']');
+    if h.eq_ignore_ascii_case("localhost") {
+        return true;
+    }
+    h.parse::<IpAddr>().is_ok_and(is_loopback_ip)
+}
+
+/// Loopback test on an address, IPv4-mapped IPv6 included.
+#[must_use]
+pub fn is_loopback_ip(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v4) => v4.is_loopback(),
+        IpAddr::V6(v6) => v6.is_loopback() || v6.to_ipv4_mapped().is_some_and(|v4| v4.is_loopback()),
+    }
+}
+
+/// The two laws, checked before the client resolves or connects:
+/// offline-only admits loopback hosts alone, and a host off this machine
+/// is reached over `https://` only.
+pub fn admit(endpoint: &Endpoint, offline_only: bool) -> Result<(), String> {
+    let local = endpoint.is_loopback();
+    if offline_only && !local {
+        return Err(format!(
+            "offline-only mode blocks '{}': only localhost, 127.0.0.1 and [::1] are reachable",
+            endpoint.host
+        ));
+    }
+    if !local && endpoint.scheme == Scheme::Http {
+        return Err(format!(
+            "plain http:// to '{}' is refused: off this machine a provider is reached over https:// only",
+            endpoint.host
+        ));
+    }
+    Ok(())
+}
+
+/// The resolver's half of the law: when only loopback is allowed, every
+/// resolved address must be loopback (a hosts-file `localhost` pointing
+/// elsewhere is refused, not followed).
+pub fn admit_addrs(addrs: Vec<SocketAddr>, loopback_only: bool) -> Result<Vec<SocketAddr>, String> {
+    if addrs.is_empty() {
+        return Err("the host resolved to no address".into());
+    }
+    if loopback_only && let Some(bad) = addrs.iter().find(|a| !is_loopback_ip(a.ip())) {
+        return Err(format!("refused: the host resolved to {} which is not loopback", bad.ip()));
+    }
+    Ok(addrs)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn loopback_names_and_addresses() {
+        for h in ["localhost", "LOCALHOST", "127.0.0.1", "127.8.9.1", "::1", "[::1]", "::ffff:127.0.0.1"] {
+            assert!(is_loopback_host(h), "{h}");
+        }
+        for h in ["api.openai.com", "10.0.0.1", "192.168.1.5", "localhost.evil.com", "0.0.0.0", "::"] {
+            assert!(!is_loopback_host(h), "{h}");
+        }
+    }
+
+    #[test]
+    fn parse_refuses_hidden_hosts_and_odd_schemes() {
+        assert!(Endpoint::parse("http://127.0.0.1@evil.example/v1").is_err());
+        assert!(Endpoint::parse("ftp://localhost/").is_err());
+        assert!(Endpoint::parse("https://api.openai.com/v1?x=1").is_err());
+        let e = Endpoint::parse("http://[::1]:1234/v1/").expect("v6 loopback");
+        assert_eq!(e.url("/chat/completions"), "http://[::1]:1234/v1/chat/completions");
+        assert!(e.is_loopback());
+    }
+}
diff --git a/crates/app/src/ai/http.rs b/crates/app/src/ai/http.rs
new file mode 100644
index 000000000..03eb28d80
--- /dev/null
+++ b/crates/app/src/ai/http.rs
@@ -0,0 +1,165 @@
+//! The native HTTP client for AI providers (#1945). Every request passes
+//! the endpoint laws (`endpoint::admit`) before anything resolves, then
+//! the resolver re-checks the addresses: offline-only, or plain `http`,
+//! reaches loopback addresses alone. No redirect is followed (a local
+//! server could otherwise bounce a call off the machine), no proxy is
+//! read from the environment, and no error message carries the key.
+//!
+//! Provenance: our own policy over the `ureq` crate's public API; the
+//! auth headers are each provider's documented ones (`x-api-key`,
+//! `Authorization: Bearer`, `x-goog-api-key`).
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+use serde_json::Value;
+
+use crate::mcp::provider::Provider;
+
+use super::endpoint::{self, Endpoint, Scheme};
+use super::probe::{self, Capabilities};
+use super::secret::ApiKey;
+use super::wire::{self, ChatRequest};
+
+/// How long one call may take: connect, then the whole answer.
+#[derive(Clone, Copy, Debug)]
+pub struct Timeouts {
+    pub connect: Duration,
+    pub total: Duration,
+}
+
+impl Default for Timeouts {
+    fn default() -> Self {
+        Self { connect: Duration::from_secs(10), total: Duration::from_secs(300) }
+    }
+}
+
+/// The client: the offline switch and the timeouts. An agent is built
+/// per request, so each carries its own loopback rule.
+#[derive(Clone, Copy, Debug)]
+pub struct Client {
+    pub offline_only: bool,
+    pub timeouts: Timeouts,
+}
+
+/// The longest provider error text kept in a message.
+const ERROR_TEXT: usize = 400;
+
+impl Client {
+    #[must_use]
+    pub fn new(offline_only: bool) -> Self {
+        Self { offline_only, timeouts: Timeouts::default() }
+    }
+
+    fn agent(&self, loopback_only: bool) -> ureq::Agent {
+        ureq::AgentBuilder::new()
+            .redirects(0)
+            .try_proxy_from_env(false)
+            .timeout_connect(self.timeouts.connect)
+            .timeout(self.timeouts.total)
+            .user_agent(concat!("camcraft/", env!("CARGO_PKG_VERSION")))
+            .resolver(move |netloc: &str| -> std::io::Result<Vec<std::net::SocketAddr>> {
+                let addrs = std::net::ToSocketAddrs::to_socket_addrs(netloc)?.collect();
+                endpoint::admit_addrs(addrs, loopback_only)
+                    .map_err(|e| std::io::Error::new(std::io::ErrorKind::PermissionDenied, e))
+            })
+            .build()
+    }
+
+    /// POST `body` as JSON to `path` under `ep`, with `auth` as the auth
+    /// header when given, and read a JSON answer. A non-2xx status is an
+    /// error naming the status and the provider's message.
+    pub fn post_json(
+        &self,
+        ep: &Endpoint,
+        path: &str,
+        headers: &[(String, String)],
+        auth: Option<(&'static str, String)>,
+        body: &Value,
+    ) -> Result<Value, String> {
+        endpoint::admit(ep, self.offline_only)?;
+        let loopback_only = self.offline_only || ep.scheme == Scheme::Http;
+        let url = ep.url(path);
+        let mut req = self.agent(loopback_only).post(&url).set("content-type", "application/json");
+        for (k, v) in headers {
+            req = req.set(k, v);
+        }
+        if let Some((name, value)) = &auth {
+            req = req.set(name, value);
+        }
+        let resp = match req.send_string(&body.to_string()) {
+            Ok(r) => r,
+            Err(ureq::Error::Status(code, r)) => {
+                let text = r.into_string().unwrap_or_default();
+                return Err(format!("{} answered HTTP {code}: {}", ep.host, provider_message(&text)));
+            }
+            Err(ureq::Error::Transport(t)) => {
+                return Err(with_detail(format!("{} could not be reached: {}", ep.host, t.kind()), &t));
+            }
+        };
+        let status = resp.status();
+        if !(200..300).contains(&status) {
+            return Err(format!("{} answered HTTP {status} (redirects are not followed)", ep.host));
+        }
+        let text = resp.into_string().map_err(|e| format!("{} answer not read: {e}", ep.host))?;
+        serde_json::from_str(&text).map_err(|e| format!("{} answer is not JSON ({e})", ep.host))
+    }
+}
+
+/// A transport error's own message, minus anything after the URL (ureq
+/// prints the request URL, which never holds a key: keys ride headers).
+fn with_detail(base: String, t: &ureq::Transport) -> String {
+    match t.message() {
+        Some(m) => format!("{base} ({m})"),
+        None => base,
+    }
+}
+
+/// The provider's error message if it sent one, else the start of the body.
+fn provider_message(text: &str) -> String {
+    let parsed: Option<Value> = serde_json::from_str(text).ok();
+    let msg = parsed
+        .as_ref()
+        .and_then(|v| v["error"]["message"].as_str().or_else(|| v["error"].as_str()).map(str::to_owned))
+        .unwrap_or_else(|| text.to_owned());
+    msg.chars().take(ERROR_TEXT).collect()
+}
+
+/// The auth header for `provider`, per its documentation.
+#[must_use]
+pub fn auth_header(provider: Provider, key: &ApiKey) -> (&'static str, String) {
+    match provider {
+        Provider::Anthropic => ("x-api-key", key.expose().to_owned()),
+        Provider::OpenAiChat | Provider::OpenAiResponses => ("authorization", format!("Bearer {}", key.expose())),
+        Provider::Gemini => ("x-goog-api-key", key.expose().to_owned()),
+    }
+}
+
+/// Send one chat step and return the provider's response envelope.
+pub fn send_chat(
+    client: &Client,
+    ep: &Endpoint,
+    req: &ChatRequest<'_>,
+    key: Option<&ApiKey>,
+    cancel: &AtomicBool,
+) -> Result<Value, String> {
+    if cancel.load(Ordering::Relaxed) {
+        return Err("cancelled".into());
+    }
+    let w = wire::build(req)?;
+    let auth = key.map(|k| auth_header(req.provider, k));
+    let out = client.post_json(ep, &w.path, &w.headers, auth, &w.body)?;
+    if cancel.load(Ordering::Relaxed) {
+        return Err("cancelled".into());
+    }
+    Ok(out)
+}
+
+/// Ask an Ollama server what `model` can do. `ep` is the chat base
+/// (`.../v1`); the probe goes to `/api/show` on the same host and port.
+pub fn probe_ollama(client: &Client, ep: &Endpoint, model: &str) -> Result<Capabilities, String> {
+    wire::check_model(model)?;
+    let root = ep.with_base_path("");
+    let answer = client.post_json(&root, "/api/show", &[], None, &probe::show_request(model))?;
+    probe::parse_show(&answer)
+}
