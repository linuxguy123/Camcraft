+            }
+        }
+        Prof::Bull { flat, cr } => {
+            let z_arc = atom.z0 + cr;
+            if w < z_arc {
+                flat + ((cr + m).powi(2) - (z_arc - w).powi(2)).max(0.0).sqrt()
+            } else if w <= atom.z1 {
+                flat + cr + m
+            } else {
+                flat + cr + (m * m - (w - atom.z1).powi(2)).max(0.0).sqrt()
+            }
