@@ -0,0 +1,29 @@
+## #2740 - Select quick suites for changed fixtures and importers
+
+**What was decided:** Add fixture readers to the existing quick selection.
+Scan the source files of each integration suite, including declared helper modules.
+Match quoted paths against directories that contain changed test data, fixtures, goldens, or snapshots.
+Resolve paths from the repository root, crate root, and source directory.
+Use the static prefix of a formatted fixture path to select readers of nested golden directories.
+Use lexical path resolution so new and deleted files do not need to exist.
+Keep all suites selected by the existing rules.
+
+Changes to the app STEP/mesh importer or kernel Solidcraft and STEP import code also select three suites:
+
+- `app:feature_edge_g1_join`
+- `kernel:step_agreement`
+- `kernel:machining_mesh`
+
+**Why:** PR #2664 changed the importer and added a STEP fixture.
+The quick gate omitted suites that read the model directory or use an independent importer.
+The new rules select these checks before the change reaches main.
+The directory scan is conservative and does not interpret test I/O.
+
+**Considered and dropped:** Gate maps alone cannot detect a changed fixture that a suite reads.
+A full batch gate for every fixture change adds work unrelated to the changed directory.
+Coverage-based selection belongs to #2738 and is outside this fix.
+
+**Cost to change later:** Update the importer path list when an importer moves or a required suite changes.
+The text scan can select extra suites when they name a sibling fixture in the same directory.
+A computed path without a fixture directory name can need an explicit rule or coverage-based selection.
+Future selection can replace this helper while the plan tests preserve the required checks.
diff --git a/xtask/src/fixture_inputs.rs b/xtask/src/fixture_inputs.rs
new file mode 100644
index 000000000..6ff9f847d
--- /dev/null
+++ b/xtask/src/fixture_inputs.rs
@@ -0,0 +1,119 @@
+//! Provenance: issue #2740 and our gate law: changed fixtures and importers select their readers.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Component, Path, PathBuf};
+
+use crate::plan::ALL_CRATES;
+use crate::{scan, suites};
+
+fn fixture_component(path: &Path) -> bool {
+    path.components().any(|c| {
+        matches!(
+            c.as_os_str().to_str(),
+            Some("testdata" | "fixture" | "fixtures" | "golden" | "goldens" | "snapshots")
+        )
+    })
+}
+
+// Lexical resolution also works for deleted inputs; canonicalize would lose their readers.
+fn normalize(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for part in path.components() {
+        match part {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                out.pop();
+            }
+            other => out.push(other.as_os_str()),
+        }
+    }
+    out
+}
+
+pub fn map(
+    root: &Path,
+    changed: &[String],
+    whole: &mut BTreeSet<String>,
+    why: &mut BTreeMap<String, String>,
+) -> Result<(), String> {
+    if changed.iter().any(|p| {
+        p.starts_with("crates/app/src/geometry/import/")
+            || p.starts_with("crates/kernel/src/solidcraft/")
+            || matches!(
+                p.as_str(),
+                "crates/kernel/src/solidcore_step.rs" | "crates/kernel/src/solidcore_import.rs"
+            )
+    }) {
+        for (dir, binary) in [
+            ("app", "feature_edge_g1_join"),
+            ("kernel", "step_agreement"),
+            ("kernel", "machining_mesh"),
+        ] {
+            if suites::entry(root, dir, binary).is_file() {
+                let key = format!("{dir}:{binary}");
+                whole.insert(key.clone());
+                why.insert(key, "STEP/mesh importer changed".into());
+            }
+        }
+    }
+
+    let inputs: Vec<_> = changed
+        .iter()
+        .filter_map(|file| {
+            let path = Path::new(file);
+            let parent = path.parent()?;
+            fixture_component(parent).then(|| (file, normalize(&root.join(parent))))
+        })
+        .collect();
+    if inputs.is_empty() {
+        return Ok(());
+    }
+    // A plain text path scan is conservative. It does not try to interpret test I/O.
+    let quoted = scan::re(r#""([^"\r\n]+)""#)?;
+    for dir in ALL_CRATES {
+        let crate_root = root.join("crates").join(dir);
+        for binary in scan::binaries(root, dir) {
+            let mut hit = None;
+            for source in suites::sources(&suites::entry(root, dir, &binary))? {
+                let text = std::fs::read_to_string(&source.path)
+                    .map_err(|e| format!("fixture reader {}: {e}", source.path.display()))?;
+                for literal in quoted.captures_iter(&text) {
+                    let value = literal[1].replace('\\', "/");
+                    // A formatted suffix can name any child of its static directory prefix.
+                    let prefix = value.split('{').next().unwrap_or(&value);
+                    let path = Path::new(prefix);
+                    // Bare "..", "tests" or an error message must not select every input.
+                    if !fixture_component(path) {
+                        continue;
+                    }
+                    for base in [
+                        root,
+                        crate_root.as_path(),
+                        source.path.parent().unwrap_or(root),
+                    ] {
+                        let reference = normalize(&base.join(path));
+                        if let Some((file, _)) = inputs.iter().find(|(_, input)| {
+                            reference.starts_with(input) || input.starts_with(&reference)
+                        }) {
+                            hit = Some((*file).clone());
+                            break;
+                        }
+                    }
+                    if hit.is_some() {
+                        break;
+                    }
+                }
+                if hit.is_some() {
+                    break;
+                }
+            }
+            if let Some(file) = hit {
+                let key = format!("{dir}:{binary}");
+                whole.insert(key.clone());
+                why.entry(key)
+                    .or_insert_with(|| format!("fixture directory read by suite: {file}"));
+            }
+        }
+    }
+    Ok(())
+}
