     let mut lines = vec![
         format!("CamCraft {} ({profile} build)", build_info::VERSION),
@@ -44,14 +64,15 @@ pub(crate) fn report(state: &State) -> String {
         format!("GPU: {}", state.gpu_line.as_deref().unwrap_or("none (headless)")),
         format!(
