From f4ac21ecd3f738699987875c7ea35f6139456705 Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Thu, 26 Nov 2026 04:30:31 -0500
Subject: [PATCH] fix(post): write decimal point on Mach4 whole-second dwells

Write whole-second dwell values with a decimal point in Mach4 post.

Fixes #4141
---
 assets/posts/mach4.cps          |  2 +-
 crates/post/tests/mach4_post.rs | 29 ++++++++++++++++++-----------
 2 files changed, 19 insertions(+), 12 deletions(-)

diff --git a/assets/posts/mach4.cps b/assets/posts/mach4.cps
index 26a6d82c2d..5ac1819075 100644
--- a/assets/posts/mach4.cps
+++ b/assets/posts/mach4.cps
@@ -838,7 +838,7 @@ function onCycle() {
     block(["G99"]);
     var ws = [g, "X" + fu(qBot[0]), "Y" + fu(qBot[1]), "Z" + fu(qBot[2]), "R" + fu(qR[2])];
     if ((p.CycleType === "PECK" || p.CycleType === "DEEP") && has(p.Q) && Number(p.Q) > 0) ws.push("Q" + fu(Number(p.Q)));
-    if (secDwell > 0 && (g === "G82" || g === "G89")) ws.push("P" + trimDec(secDwell, 3, false));
+    if (secDwell > 0 && (g === "G82" || g === "G89")) ws.push("P" + trimDec(secDwell, 3, true));
     ws.push(g === "G84" ? "F" + fn(Number(p.FeedRate)) : ff(Number(p.FeedRate)));
     block(ws);
     cycleSig = sig;
diff --git a/crates/post/tests/mach4_post.rs b/crates/post/tests/mach4_post.rs
index af9ffe73df..0f709541d2 100644
--- a/crates/post/tests/mach4_post.rs
+++ b/crates/post/tests/mach4_post.rs
@@ -268,16 +268,23 @@ fn mach4_supported_cycle_dwells_use_seconds_on_g82_and_g89_only() {
     let cps = mach4_post();
     let mch = default_vmc();
     for (cycle, g) in [("DRILL", "G82"), ("SPOT", "G82"), ("BACKBORE", "G89")] {
-        let out = engine::run(&cps, &mch, &cycle_stream(cycle, 250)).expect("dwell cycle runs");
-        assert!(out.warnings.is_empty(), "{cycle}: {:?}", out.warnings);
-        let line = out
-            .program
-            .lines()
-            .find(|line| line.split_whitespace().any(|w| w == g))
-            .unwrap_or_else(|| panic!("missing {g}:\n{}", out.program));
-        assert!(
-            line.split_whitespace().any(|w| w == "P0.25"),
-            "{g} needs seconds dwell: {line}"
-        );
+        for (dwell_ms, want_p) in [(250, "P0.25"), (1000, "P1."), (2000, "P2.")] {
+            let out =
+                engine::run(&cps, &mch, &cycle_stream(cycle, dwell_ms)).expect("dwell cycle runs");
+            assert!(
+                out.warnings.is_empty(),
+                "{cycle} {dwell_ms}ms: {:?}",
+                out.warnings
+            );
+            let line = out
+                .program
+                .lines()
+                .find(|line| line.split_whitespace().any(|w| w == g))
+                .unwrap_or_else(|| panic!("missing {g}:\n{}", out.program));
+            assert!(
+                line.split_whitespace().any(|w| w == want_p),
+                "{g} dwell {dwell_ms}ms must write {want_p}: {line}"
+            );
+        }
     }
 }
