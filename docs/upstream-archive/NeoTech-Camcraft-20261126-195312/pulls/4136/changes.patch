+++ b/crates/motion/src/machining2d/contour_avoid_emit.rs
@@ -0,0 +1,326 @@
+//! Closed-loop and trimmed-piece band emission for 2D Contour "Do not touch" (#3344).
+//! Provenance: clean-room per-level keep-out emission over `contour` helpers; no vendor material consulted.
+
+use camcraft_sim::verify::{AVOID_PAD, AvoidSpec};
+
+use crate::cl::{MoveKind, PathBuilder};
+use crate::entry::Entry3D;
+use crate::geo2d::Point2;
+use crate::geometry::Point3;
+use crate::links::Link;
+
+use super::arcs::push_segs;
+use super::contour::{ContourParams, Lead, PreparedBand};
+use super::contour_avoid_clip::{Clip, clip_polyline, legal_regions, segs_clear_of};
+pub(super) use super::contour_avoid_piece::AvoidSink;
+use super::contour_avoid_piece::{check_pick_clear, plan_window_avoid, push_open_piece, rotate_clear_start};
+use super::contour_comp::{self, SpanCtx};
+use super::contour_depth::Ladder;
+use super::contour_entry::{Engage, crosses, flatten, say, seam_leads, wall_arc, wall_arc_top};
+use super::contour_link::{Stay, guard, plan_links, push_stay, ring_link};
+use super::contour_start;
+use super::contour_step::{Step, engage_level};
+use super::face::GenError;
+use super::fillet::Legal;
+use super::lead_ext::{extend_leads, retrace};
+use super::levels::{Cert, Motion};
+use super::ring::Ring;
+use super::tab_bridge::{cached, fit_tabs};
+use super::tab_clear::fit_loops;
+
+/// Emit all levels & rings of one band while keeping every move clear of `avoid`.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn emit_band_avoid(
+    b: &mut PathBuilder,
+    band: &PreparedBand,
+    p: &ContourParams,
+    lad: &Ladder,
+    pick: Option<(usize, Point2)>,
+    exit: Option<(usize, Point2)>,
+    avoid: &AvoidSpec,
+    sink: &mut AvoidSink,
+) -> Result<(), GenError> {
+    let inside = p.side == Side::Inside;
+    let m = Motion::new(p.clearance_z, Some(p.retract_z), p.feed, p.plunge_feed)
+        .with_entry(p.entry, p.helix_radius)
+        .with_arc_radius(p.tool_diameter)
+        .with_links(p.links, p.helix_radius);
+    let base_legal = band.room.as_ref().unwrap_or(&band.center);
+    let prog = &band.prog;
+    let hop = p.retract_z.min(p.clearance_z);
+    let pad = AVOID_PAD.max(p.tolerance.min(0.05) + 0.01);
+
+    let mut dives: (f64, Vec<Vec<Point2>>) = (f64::NAN, Vec::new());
+    let mut last_leads: Vec<Vec<Point2>> = Vec::new();
+    let mut prior_at_z: (f64, Vec<Vec<Point2>>) = (f64::NAN, Vec::new());
+    let mut unclipped_last: Vec<bool> = vec![false; band.loops.len()];
+
+    let is_tabbed = |z: f64| p.tab_count > 0 && z < p.bottom_z + p.tab_height;
+    let tab_levels: Vec<Vec<u64>> = (0..band.loops.len())
+        .map(|li| lad.ring(li).iter().filter(|&&z| is_tabbed(z)).map(|z| z.to_bits()).collect())
+        .collect();
+    let legal_base_only = Legal { region: base_legal, inside, air_left: Some(p.climb) };
+    let mut fits = fit_loops(&band.loops, &tab_levels, pick, p, &legal_base_only);
+    let (sched, stay) = plan_links(p, lad, &band.plan, &mut sink.lead_notes);
+
+    for (si, &(z, li)) in sched.iter().enumerate() {
+        let l = &band.loops[li];
+        let tabbed = is_tabbed(z);
+        let hop_z = if tabbed { hop.max(p.bottom_z + p.tab_height) } else { hop };
+        let same_level = si > 0 && sched[si - 1].0.to_bits() == z.to_bits();
+        if prior_at_z.0.to_bits() != z.to_bits() {
+            prior_at_z = (z, Vec::new());
+        }
+
+        let ko_cut = avoid.keepout_region(z, z, pad).map_err(GenError::Invalid)?;
+        let rz = lad.ring(li);
+        let rzi = rz.iter().position(|q| q.to_bits() == z.to_bits()).unwrap_or(0);
+        let arc_top = wall_arc_top(p, rz, rzi, hop_z);
+        let drop_hi = (if sink.first_entry || p.links.level == Link::Clearance { p.clearance_z } else { hop_z })
+            .max(arc_top)
+            .max(z);
+        let ko_entry = avoid.keepout_region(z, drop_hi, pad).map_err(GenError::Invalid)?;
+        let (cut_reg, entry_reg) = legal_regions(base_legal, inside, &ko_cut, &ko_entry)?;
+        let legal_cut = Legal { region: &cut_reg, inside, air_left: Some(p.climb) };
+        let legal_entry = Legal { region: &entry_reg, inside, air_left: Some(p.climb) };
+        let center_avoid = if ko_entry.is_empty() { band.center.clone() } else { band.center.difference(&ko_entry)? };
+        let cert_avoid = Cert::Region(&center_avoid);
+
+        let pts: Vec<Point2> = super::ring::walked(l.points(), p.climb == inside, inside);
+        let picked = pick.filter(|&(pi, _)| pi == li).map(|(_, q)| q);
+        let exit_q = exit.filter(|&(ei, _)| ei == li).map(|(_, q)| q);
+        check_pick_clear(picked, exit_q, &pts, &ko_cut, &ko_entry, avoid)?;
+
+        match clip_polyline(&pts, &ko_cut, true) {
+            Clip::AllBlocked => {
+                if prog.is_some() {
+                    return Err(contour_comp::refused_as(
+                        p,
+                        format!("cannot keep clear of protected 'Do not touch' {}: closed ring is blocked", avoid.names_list()),
+                    )
+                    .with_ghost_moves(b.moves()));
+                }
+                sink.blocked_any = true;
+                unclipped_last[li] = false;
+                continue;
+            }
+            Clip::Pieces(pieces) => {
+                if prog.is_some() {
+                    return Err(contour_comp::refused_as(
+                        p,
+                        format!("cannot keep clear of protected 'Do not touch' {}: partial trim breaks closed compensation ring", avoid.names_list()),
+                    )
+                    .with_ghost_moves(b.moves()));
+                }
+                sink.clipped_any = true;
+                unclipped_last[li] = false;
+                for piece in pieces {
+                    push_open_piece(
+                        b, &piece, z, hop_z, inside, tabbed, p, band, &legal_cut, &legal_entry,
+                        &ko_cut, &ko_entry, &center_avoid, &cert_avoid, &m, &mut prior_at_z.1, &mut dives, &mut last_leads, sink,
+                    )?;
+                }
+                continue;
+            }
+            Clip::Unclipped => {}
+        }
+
+        let seated = contour_start::seat(pts, picked, tabbed, prog.is_some(), p, &legal_entry, &mut sink.lead_notes);
+        let seated = if picked.is_none() && !tabbed && p.lead == Lead::None && ko_entry.contains(seated[0]) {
+            match rotate_clear_start(seated.clone(), &ko_entry) {
+                Some(r) => r,
+                None => {
+                    sink.clipped_any = true;
+                    unclipped_last[li] = false;
+                    push_open_piece(
+                        b, &seated, z, hop_z, inside, tabbed, p, band, &legal_cut, &legal_entry,
+                        &ko_cut, &ko_entry, &center_avoid, &cert_avoid, &m, &mut prior_at_z.1, &mut dives, &mut last_leads, sink,
+                    )?;
+                    continue;
+                }
+            }
+        } else {
+            seated
+        };
+
+        let ap = &p.links.approach;
+        let ring = Ring::new(seated);
+        let ov = if tabbed || ap.overlap <= 0.0 {
+            0.0
+        } else if p.links.level == Link::KeepDown {
+            say(&mut sink.lead_notes, "lead: the overlap stands down under the keep-down level link - the next level descends from the seam".into());
+            0.0
+        } else {
+            ap.overlap.min(ring.len)
+        };
+        let keeps = if tabbed {
+            cached(&mut fits, li, || fit_tabs(&ring, p, picked.is_some(), &legal_entry), &mut sink.lead_notes)
+        } else {
+            vec![(0.0, ring.len)]
+        };
+
+        let stay_in = if unclipped_last[li] { stay[si] } else { None };
+        let stay_out = stay.get(si + 1).copied().flatten().is_some();
+        unclipped_last[li] = !tabbed;
+
+        for (k, &ke) in keeps.iter().enumerate() {
+            let Some(mut window) = plan_window_avoid(&ring, ke, p, &legal_cut, &legal_entry, &ko_cut, &ko_entry, &prior_at_z.1, sink) else {
+                continue;
+            };
+            if picked.is_some() && k == 0 {
+                contour_start::lead_held(p, window.0[0], &window.3)?;
+            }
+            if let Some(q) = exit_q {
+                window = contour_start::exit_at(window, q, p, &legal_entry, &mut sink.lead_notes)?;
+            } else if ov > 0.0 {
+                let (rpoly, rwalk) = retrace(&window.0, &window.1, ov);
+                let (en, li_segs, lo_segs) = seam_leads(&rwalk, &rpoly, p, &legal_entry, &mut sink.lead_notes);
+                let (en, li_segs, lo_segs) = extend_leads(en, li_segs, lo_segs, &rwalk, &rpoly, p, &legal_entry, &mut sink.lead_notes);
+                let last = rpoly[rpoly.len() - 1];
+                if !crosses(en, &li_segs, last, &lo_segs)
+                    && segs_clear_of(en, &li_segs, &ko_cut)
+                    && !ko_entry.contains(en)
+                    && segs_clear_of(last, &lo_segs, &ko_cut)
+                {
+                    window = (rpoly, rwalk, en, li_segs, lo_segs);
+                }
+            }
+            let (poly, walk, entry, mut lead, mut lead_off) = window;
+            if prog.is_some() && !segs_clear_of(entry, &lead, &ko_cut) {
+                return Err(contour_comp::refused_as(
+                    p,
+                    format!("cannot keep clear of protected 'Do not touch' {}: lead-in enters keep-out", avoid.names_list()),
+                )
+                .with_ghost_moves(b.moves()));
+            }
+            if prog.is_none() && (ko_entry.contains(entry) || !segs_clear_of(entry, &lead, &ko_cut)) {
+                lead.clear();
+            }
+            let e2 = if lead.is_empty() { poly[0] } else { Point2::new(entry.x, entry.y) };
+            if ko_entry.contains(e2) || ko_cut.contains(e2) {
+                if prog.is_some() || picked.is_some() {
+                    return Err(GenError::Invalid(format!(
+                        "cannot cut clear of protected 'Do not touch' {}: entry ({:.3}, {:.3}) is blocked",
+                        avoid.names_list(),
+                        e2.x,
+                        e2.y
+                    ))
+                    .with_ghost_moves(b.moves()));
+                }
+                sink.clipped_any = true;
+                unclipped_last[li] = false;
+                push_open_piece(
+                    b, &poly, z, hop_z, inside, tabbed, p, band, &legal_cut, &legal_entry,
+                    &ko_cut, &ko_entry, &center_avoid, &cert_avoid, &m, &mut prior_at_z.1, &mut dives, &mut last_leads, sink,
+                )?;
+                continue;
+            }
+            let here = vec![flatten(e2, &lead), flatten(poly.last().copied().unwrap_or(e2), &lead_off)];
+            let link_leads: Vec<Vec<Point2>> = std::mem::replace(&mut last_leads, here.clone()).into_iter().chain(here).collect();
+            let lf = ap.lead_feed(p.feed);
+            let lead_top = if ap.lead_height > 0.0 && !lead.is_empty() { z + ap.lead_height } else { z };
+
+            if let (Some(s), Some(&zp)) = (stay_in, rzi.checked_sub(1).and_then(|i| rz.get(i))) {
+                let ko_stay = avoid.keepout_region(z, zp, pad).map_err(GenError::Invalid)?;
+                let stay_ok = match s {
+                    Stay::Laps(_) => segs_clear_of(poly[0], &walk, &ko_stay),
+                    Stay::Plunge | Stay::Arc => !ko_stay.contains(poly[0]),
+                };
+                if stay_ok {
+                    let (_, stay_reg) = legal_regions(base_legal, inside, &ko_stay, &ko_stay)?;
+                    let legal_stay = Legal { region: &stay_reg, inside, air_left: Some(p.climb) };
+                    push_stay(b, s, &poly, &walk, zp, z, p, &legal_stay, &mut sink.lead_notes);
+                    sink.first_entry = false;
+                    push_segs(b, &walk, z, p.feed);
+                    if !stay_out {
+                        push_segs(b, &lead_off, z, p.feed);
+                    }
+                    continue;
+                }
+            }
+
+            let arm = if sink.first_entry { p.entry } else { p.links.arm(p.entry) };
+            let ring_to_ring = k == 0 && same_level && !sink.first_entry;
+            let wall_arc_on = !inside && arm == Entry3D::Arc && k == 0 && !(ring_to_ring && p.links.pass == Link::KeepDown);
+            let eng = Engage { p, center: &center_avoid, cert: &cert_avoid, plan: &band.plan, m: &m, legal: &legal_entry };
+
+            if wall_arc_on && ring_to_ring && p.links.pass == Link::Clearance {
+                let cur = b.at();
+                b.push(MoveKind::Feed, Point3::new(cur.x, cur.y, hop_z), Some(p.feed));
+                b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, p.clearance_z), None);
+            }
+            let mut arced = false;
+            if wall_arc_on && !tabbed && p.lead != Lead::None {
+                let first = lead.first().or(walk.first());
+                if wall_arc(b, &eng, e2, z, arc_top, hop_z, first).is_ok() {
+                    arced = true;
+                }
+            }
+            if !arced {
+                if ring_to_ring {
+                    let cut = if dives.0.to_bits() == z.to_bits() { dives.1.as_slice() } else { &[] };
+                    ring_link(b, p, &legal_cut, &[&band.plan, cut, &link_leads, &prior_at_z.1], e2, z, hop_z, tabbed, &mut sink.lifted);
+                } else if k == 0 {
+                    let prev_z = if rzi == 0 { p.clearance_z } else { rz[rzi - 1] };
+                    let opened = rzi >= 2 || (rzi == 1 && arm == p.entry);
+                    let use_inside = inside && center_avoid.contains(e2);
+                    let step = Step { arm, e2, z, prev_z, first: sink.first_entry, opened, inside: use_inside, tabbed, lead_top };
+                    if let Some(d) = engage_level(b, &eng, &step, &lead, &walk, &mut sink.said) {
+                        if dives.0.to_bits() != z.to_bits() {
+                            dives = (z, Vec::new());
+                        }
+                        dives.1.push(vec![d, e2]);
+                    }
+                } else {
+                    let cur = b.at();
+                    b.push(MoveKind::Feed, Point3::new(cur.x, cur.y, hop_z), Some(p.feed));
+                    b.push(MoveKind::Rapid, Point3::new(e2.x, e2.y, hop_z), None);
+                    guard(b, p, e2, lead_top, p.entry_top(), "the dive past a tab");
+                    b.push(MoveKind::Plunge, Point3::new(e2.x, e2.y, lead_top), Some(p.plunge_feed));
+                }
+            }
+            sink.first_entry = false;
+            let at = b.at();
+            let lead_at = b.moves_len();
+            if at.x == e2.x && at.y == e2.y && at.z > z {
+                super::lead_ext::push_lead_down(b, &lead, at.z, z, lf);
+            } else {
+                push_segs(b, &lead, z, lf);
+            }
+            let walk_at = b.moves_len();
+            push_segs(b, &walk, z, p.feed);
+            let out_at = b.moves_len();
+            if !stay_out {
+                let end_pt = poly[poly.len() - 1];
+                let exit_end = flatten(end_pt, &lead_off).last().copied().unwrap_or(end_pt);
+                if !segs_clear_of(end_pt, &lead_off, &ko_cut) || ko_entry.contains(exit_end) {
+                    lead_off.clear();
+                }
+                push_segs(b, &lead_off, z, p.feed);
+            }
+            if let Some(prog) = prog {
+                if walk_at == lead_at || b.moves_len() == out_at {
+                    return Err(contour_comp::refused_as(
+                        p,
+                        format!(
+                            "needs a lead-in and a lead-out clear of protected 'Do not touch' {} at ({:.3}, {:.3})",
+                            avoid.names_list(),
+                            e2.x,
+                            e2.y
+                        ),
+                    )
+                    .with_ghost_moves(b.moves()));
+                }
+                contour_comp::push_span(b, &SpanCtx { prog, p }, walk_at - 1, out_at)
+                    .map_err(|e| e.with_ghost_moves(b.moves()))?;
+            }
+            let end = poly[poly.len() - 1];
+            prior_at_z.1.push(flatten(e2, &lead));
+            prior_at_z.1.push(poly);
+            prior_at_z.1.push(flatten(end, &lead_off));
+        }
+    }
+    Ok(())
+}
+
+use super::contour_params::Side;
diff --git a/crates/motion/src/machining2d/contour_avoid_open.rs b/crates/motion/src/machining2d/contour_avoid_open.rs
new file mode 100644
index 0000000000..5bc0913cfa
--- /dev/null
+++ b/crates/motion/src/machining2d/contour_avoid_open.rs
@@ -0,0 +1,328 @@
+//! Open-chain and open-run 2D Contour planning with "Do not touch" protection (#3344).
+//! Provenance: clean-room per-Z-level open polyline clipping, lead shrinking, and keep-out checks over `contour_chain` / `contour_run_side`; no vendor material consulted.
+
+use camcraft_sim::verify::{AVOID_PAD, AvoidSpec};
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::entry::Entry3D;
+use crate::geo2d::{Point2, Region};
+use crate::geometry::Point3;
+use crate::links::Link;
+use crate::plunge_law;
+
+use super::arcs::{Seg, fit_arcs_sided, lead_in, lead_out, push_segs, walk_tangent};
+use super::contour::{ContourParams, Side, air_side};
+use super::contour_avoid_clip::{Clip, clip_polyline, finalize_avoid, segs_clear_of, segs_cross_prior};
+use super::contour_chain::contour_along_chain;
+use super::contour_entry::{flatten, say};
+use super::contour_run_side::{SectionAt, contour_open_run, open_run_ride};
+use super::contour_run_stock::{contour_open_run_sided, sided_run_ride};
+use super::face::GenError;
+
+const LEAD_SHRINKS: usize = 4;
+
+fn scaled_lead(lead: super::contour_params::Lead, f: f64) -> super::contour_params::Lead {
+    use super::contour_params::Lead;
+    match lead {
+        Lead::None => Lead::None,
+        Lead::Linear { length } => Lead::Linear { length: length * f },
+        Lead::Arc { radius } => Lead::Arc { radius: radius * f },
+        Lead::Tangential { radius } => Lead::Tangential { radius: radius * f },
+        Lead::Perpendicular { length } => Lead::Perpendicular { length: length * f },
+    }
+}
+
+fn open_piece_leads(
+    walk: &[Seg],
+    poly: &[Point2],
+    p: &ContourParams,
+    ko_cut: &Region,
+    ko_entry: &Region,
+    prior: &[Vec<Point2>],
+    notes: &mut Vec<String>,
+) -> (Point2, Vec<Seg>, Vec<Seg>) {
+    let (Some(&s), Some(&e)) = (poly.first(), poly.last()) else {
+        return (Point2::new(0.0, 0.0), Vec::new(), Vec::new());
+    };
+    let t0 = walk_tangent(walk, poly, true);
+    let t1 = walk_tangent(walk, poly, false);
+    let a = &p.links.approach;
+    let out_shape = p.lead_out_shape();
+
+    let (mut entry, mut lead) = (s, Vec::new());
+    for k in 0..=LEAD_SHRINKS {
+        let f = 0.5f64.powi(k as i32);
+        let (cand_e, cand_segs) = lead_in(s, t0, air_side(t0, p.climb), scaled_lead(p.lead, f));
+        if a.ext_in > 0.0 && a.ext_in.is_finite() {
+            let dir = super::contour_entry::flatten(cand_e, &cand_segs);
+            let u = dir
+                .windows(2)
+                .next()
+                .map(|w| super::contour::unit(w[1].x - w[0].x, w[1].y - w[0].y))
+                .unwrap_or(t0);
+            let mut ext_ok = false;
+            for ek in 0..=LEAD_SHRINKS {
+                let len = a.ext_in * 0.5f64.powi(ek as i32);
+                let q = Point2::new(cand_e.x - u.x * len, cand_e.y - u.y * len);
+                let mut with = vec![Seg::Line(vec![cand_e])];
+                with.extend(cand_segs.iter().cloned());
+                if segs_clear_of(q, &with, ko_cut)
+                    && !ko_entry.contains(q)
+                    && !segs_cross_prior(q, &with, prior)
+                {
+                    entry = q;
+                    lead = with;
+                    ext_ok = true;
+                    break;
+                }
+            }
+            if ext_ok {
+                break;
+            }
+        }
+        if segs_clear_of(cand_e, &cand_segs, ko_cut)
+            && !ko_entry.contains(cand_e)
+            && !segs_cross_prior(cand_e, &cand_segs, prior)
+        {
+            entry = cand_e;
+            lead = cand_segs;
+            break;
+        }
+        if k == LEAD_SHRINKS && p.lead != super::contour_params::Lead::None {
+            say(notes, "lead: open-contour lead-in enters protected 'Do not touch' zone - dropped".into());
+        }
+    }
+
+    let mut lead_off = Vec::new();
+    for k in 0..=LEAD_SHRINKS {
+        let f = 0.5f64.powi(k as i32);
+        let cand_segs = lead_out(e, t1, air_side(t1, p.climb), scaled_lead(out_shape, f));
+        if a.ext_out > 0.0 && a.ext_out.is_finite() {
+            let flat = flatten(e, &cand_segs);
+            let (end_pt, u) = flat
+                .windows(2)
+                .last()
+                .map(|w| (w[1], super::contour::unit(w[1].x - w[0].x, w[1].y - w[0].y)))
+                .unwrap_or((e, t1));
+            for ek in 0..=LEAD_SHRINKS {
+                let len = a.ext_out * 0.5f64.powi(ek as i32);
+                let q = Point2::new(end_pt.x + u.x * len, end_pt.y + u.y * len);
+                let mut with = cand_segs.clone();
+                with.push(Seg::Line(vec![q]));
+                if segs_clear_of(e, &with, ko_cut)
+                    && !segs_cross_prior(e, &with, prior)
+                    && !super::contour_entry::crosses(entry, &lead, e, &with)
+                {
+                    lead_off = with;
+                    break;
+                }
+            }
+            if !lead_off.is_empty() {
+                break;
+            }
+        }
+        if segs_clear_of(e, &cand_segs, ko_cut)
+            && !segs_cross_prior(e, &cand_segs, prior)
+            && !super::contour_entry::crosses(entry, &lead, e, &cand_segs)
+        {
+            lead_off = cand_segs;
+            break;
+        }
+        if k == LEAD_SHRINKS && out_shape != super::contour_params::Lead::None {
+            say(notes, "lead: open-contour lead-out enters protected 'Do not touch' zone - dropped".into());
+        }
+    }
+
+    (entry, lead, lead_off)
+}
+
+/// [`contour_along_chain`] with "Do not touch" protection across flutes, shank, and holder.
+pub fn contour_along_chain_avoid(
+    pts: &[Point2],
+    p: &ContourParams,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return contour_along_chain(pts, p);
+    }
+    p.validate()?;
+    if pts.len() < 2 {
+        return Err(GenError::Empty("a centerline run needs at least two points".into()));
+    }
+    if let Some(q) = p.links.approach.start_point {
+        return Err(GenError::Invalid(format!(
+            "start point ({:.3}, {:.3}): an open chain starts at its end - a picked start is \
+             taken only on closed contours yet; clear the start point",
+            q.x, q.y
+        )));
+    }
+    if let Some(q) = p.links.approach.exit_point {
+        return Err(GenError::Invalid(format!(
+            "exit point ({:.3}, {:.3}): an open chain leaves at its end - a picked exit is \
+             taken only on closed contours yet; clear the exit point",
+            q.x, q.y
+        )));
+    }
+    let poly: Vec<Point2> = if p.climb {
+        pts.to_vec()
+    } else {
+        let mut v = pts.to_vec();
+        v.reverse();
+        v
+    };
+    let zs = p.levels()?;
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    let mut notes = Vec::new();
+    if p.blend_turns {
+        b.note("turn blends: an open centerline run bounds no area to prove a fillet against - its corners kept sharp");
+    }
+    let arm = p.links.arm(p.entry);
+    for (i, e) in [p.entry, arm].into_iter().enumerate() {
+        if e != Entry3D::Plunge && !(i == 1 && e == p.entry) {
+            let w = match e {
+                Entry3D::Ramp => "ramp",
+                Entry3D::Helix => "helix",
+                Entry3D::Arc => "arc",
+                Entry3D::Plunge => "plunge",
+            };
+            b.note(format!(
+                "entry: an open centerline run bounds no air to certify the {w} against - dive \
+                 at the run start, unchanged"
+            ));
+        }
+    }
+    let hop = p.retract_z.min(p.clearance_z);
+    let lift_z = match p.links.level {
+        Link::Clearance => p.clearance_z,
+        Link::Retract => hop,
+        Link::KeepDown => {
+            if zs.len() > 1 {
+                say(
+                    &mut notes,
+                    "link: an open centerline run bounds no area to prove a keep-down link \
+                     against - lifted to the retract plane between levels"
+                        .into(),
+                );
+            }
+            hop
+        }
+    };
+    let pad = AVOID_PAD.max(p.tolerance.min(0.05) + 0.01);
+    let mut first = true;
+    let mut clipped_any = false;
+    let mut blocked_levels = 0usize;
+
+    for &z in &zs {
+        let ko_cut = avoid.keepout_region(z, z, pad).map_err(GenError::Invalid)?;
+        let drop_z = if first { p.clearance_z } else { lift_z };
+        let ko_entry = avoid.keepout_region(z, drop_z.max(z), pad).map_err(GenError::Invalid)?;
+        let pieces = match clip_polyline(&poly, &ko_cut, false) {
+            Clip::AllBlocked => {
+                blocked_levels += 1;
+                continue;
+            }
+            Clip::Unclipped => vec![poly.clone()],
+            Clip::Pieces(ps) => {
+                clipped_any = true;
+                ps
+            }
+        };
+        let mut prior_at_z: Vec<Vec<Point2>> = Vec::new();
+        for piece in pieces {
+            // Also trim ends out of ko_entry so vertical plunge points cannot hit overhead tools.
+            let sub_pieces = match clip_polyline(&piece, &ko_entry, false) {
+                Clip::Unclipped => vec![piece],
+                Clip::AllBlocked => {
+                    clipped_any = true;
+                    continue;
+                }
+                Clip::Pieces(sp) => {
+                    clipped_any = true;
+                    sp
+                }
+            };
+            for sub in sub_pieces {
+                let raw_walk = fit_arcs_sided(&sub, p.tolerance, Some(p.climb));
+                let walk = if segs_clear_of(sub[0], &raw_walk, &ko_cut) {
+                    raw_walk
+                } else {
+                    vec![Seg::Line(sub[1..].to_vec())]
+                };
+                let (entry, lead, lead_off) = open_piece_leads(&walk, &sub, p, &ko_cut, &ko_entry, &prior_at_z, &mut notes);
+                if ko_entry.contains(entry) || ko_cut.contains(entry) {
+                    clipped_any = true;
+                    continue;
+                }
+                if !first {
+                    let cur = b.at();
+                    if cur.z < lift_z {
+                        b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, lift_z), None);
+                    }
+                }
+                let cur = b.at();
+                b.push(MoveKind::Rapid, Point3::new(entry.x, entry.y, cur.z), None);
+                let cc = p.links.approach.center_cutting;
+                plunge_law::guard(&mut b, cc, p.tool_diameter * 0.5, entry, z, p.entry_top(), "the dive at the lead-in");
+                b.push(MoveKind::Plunge, Point3::new(entry.x, entry.y, z), Some(p.plunge_feed));
+                push_segs(&mut b, &lead, z, p.feed);
+                push_segs(&mut b, &walk, z, p.feed);
+                push_segs(&mut b, &lead_off, z, p.feed);
+                let end = sub[sub.len() - 1];
+                prior_at_z.push(flatten(entry, &lead));
+                prior_at_z.push(sub);
+                prior_at_z.push(flatten(end, &lead_off));
+                first = false;
+            }
+        }
+    }
+    let cur = b.at();
+    b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, p.clearance_z), None);
+    if blocked_levels > 0 || clipped_any {
+        b.note(format!(
+            "Do not touch ({}): skipped or trimmed blocked open-contour portion(s)",
+            avoid.names_list()
+        ));
+    }
+    for n in notes {
+        b.note(n);
+    }
+    finalize_avoid(b.finish(), avoid)
+}
+
+/// [`contour_open_run`] with "Do not touch" protection.
+pub fn contour_open_run_avoid(
+    pts: &[Point2],
+    p: &ContourParams,
+    section: &SectionAt,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return contour_open_run(pts, p, section);
+    }
+    let (ride, note) = open_run_ride(pts, p, section)?;
+    let mut path = contour_along_chain_avoid(&ride, p, avoid)?;
+    if !path.notes.contains(&note) {
+        path.notes.push(note);
+    }
+    Ok(path)
+}
+
+/// [`contour_open_run_sided`] with "Do not touch" protection.
+pub fn contour_open_run_sided_avoid(
+    pts: &[Point2],
+    p: &ContourParams,
+    side: Side,
+    stock: &SectionAt,
+    part: &SectionAt,
+    avoid: &AvoidSpec,
+) -> Result<Toolpath, GenError> {
+    if avoid.is_empty() {
+        return contour_open_run_sided(pts, p, side, stock, part);
+    }
+    let (ride, note) = sided_run_ride(pts, p, side, stock, part)?;
+    let mut path = contour_along_chain_avoid(&ride, p, avoid)?;
+    if !path.notes.contains(&note) {
+        path.notes.push(note);
+    }
+    Ok(path)
+}
diff --git a/crates/motion/src/machining2d/contour_avoid_piece.rs b/crates/motion/src/machining2d/contour_avoid_piece.rs
new file mode 100644
index 0000000000..8fc309aaa8
--- /dev/null
+++ b/crates/motion/src/machining2d/contour_avoid_piece.rs
@@ -0,0 +1,270 @@
+//! Helper routines for closed/clipped contour piece emission with "Do not touch" (#3344).
+//! Provenance: clean-room per-level keep-out checking for contour segments, picks, and exit retracts; no vendor material consulted.
+
+use camcraft_sim::verify::AvoidSpec;
+
+use crate::cl::{MoveKind, PathBuilder};
+use crate::geo2d::{Point2, Region};
+use crate::geometry::Point3;
+use crate::links::LinkTally;
+
+use super::arcs::{Seg, push_segs};
+use super::contour::{ContourParams, PreparedBand};
+use super::contour_avoid_clip::{Clip, clip_polyline, safe_walk, segs_clear_of, segs_cross_prior};
+use super::contour_entry::{Engage, crosses, flatten, seam_leads};
+use super::contour_link::{guard, ring_link};
+use super::contour_step::{Said, Step, engage_level};
+use super::fillet::{Legal, fillet_corners};
+use super::fillet_tally::FilletTally;
+use super::lead_ext::extend_leads;
+use super::levels::{Cert, Motion};
+use super::ring::{Ring, dist};
+use super::face::GenError;
+
+/// Mutable cross-band emission state shared by single-band and whole-model avoid contours.
+pub(super) struct AvoidSink {
+    pub said: Said,
+    pub lead_notes: Vec<String>,
+    pub tally: FilletTally,
+    pub first_entry: bool,
+    pub lifted: LinkTally,
+    pub clipped_any: bool,
+    pub blocked_any: bool,
+}
+
+impl Default for AvoidSink {
+    fn default() -> Self {
+        Self {
+            said: Said::default(),
+            lead_notes: Vec::new(),
+            tally: FilletTally::default(),
+            first_entry: true,
+            lifted: LinkTally::default(),
+            clipped_any: false,
+            blocked_any: false,
+        }
+    }
+}
+
+fn poly_closest(pts: &[Point2], q: Point2) -> Point2 {
+    let mut best = (f64::INFINITY, pts.first().copied().unwrap_or(q));
+    for w in pts.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let ll = dx * dx + dy * dy;
+        let t = if ll > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / ll).clamp(0.0, 1.0) } else { 0.0 };
+        let f = Point2::new(a.x + dx * t, a.y + dy * t);
+        let d2 = (f.x - q.x).powi(2) + (f.y - q.y).powi(2);
+        if d2 < best.0 {
+            best = (d2, f);
+        }
+    }
+    best.1
+}
+
+pub(super) fn check_pick_clear(
+    picked: Option<Point2>,
+    exit_q: Option<Point2>,
+    pts: &[Point2],
+    ko_cut: &Region,
+    ko_entry: &Region,
+    avoid: &AvoidSpec,
+) -> Result<(), GenError> {
+    if let Some(q) = picked {
+        let f = poly_closest(pts, q);
+        if ko_cut.contains(f) || ko_entry.contains(f) {
+            return Err(GenError::Invalid(format!(
+                "start point ({:.3}, {:.3}) is blocked by protected 'Do not touch' {}",
+                q.x, q.y, avoid.names_list()
+            )));
+        }
+    }
+    if let Some(q) = exit_q {
+        let f = poly_closest(pts, q);
+        if ko_cut.contains(f) || ko_entry.contains(f) {
+            return Err(GenError::Invalid(format!(
+                "exit point ({:.3}, {:.3}) is blocked by protected 'Do not touch' {}",
+                q.x, q.y, avoid.names_list()
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// Rotate an unclipped closed ring if `Lead::None` landed its start inside `ko_entry`.
+pub(super) fn rotate_clear_start(pts: Vec<Point2>, ko_entry: &Region) -> Option<Vec<Point2>> {
+    if pts.len() < 3 || !ko_entry.contains(pts[0]) {
+        return Some(pts);
+    }
+    let open = if dist(pts[0], pts[pts.len() - 1]) <= 1e-9 { &pts[..pts.len() - 1] } else { &pts[..] };
+    let m = open.len();
+    for i in 0..m {
+        let a = open[i];
+        let b = open[(i + 1) % m];
+        let mid = Point2::new((a.x + b.x) * 0.5, (a.y + b.y) * 0.5);
+        if !ko_entry.contains(mid) {
+            let mut v = Vec::with_capacity(m + 2);
+            v.push(mid);
+            for k in 1..=m {
+                v.push(open[(i + k) % m]);
+            }
+            v.push(mid);
+            return Some(v);
+        }
+    }
+    None
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn plan_window_avoid(
+    ring: &Ring,
+    ke: (f64, f64),
+    p: &ContourParams,
+    legal_cut: &Legal,
+    legal_entry: &Legal,
+    ko_cut: &Region,
+    ko_entry: &Region,
+    prior_z: &[Vec<Point2>],
+    sink: &mut AvoidSink,
+) -> Option<(Vec<Point2>, Vec<Seg>, Point2, Vec<Seg>, Vec<Seg>)> {
+    let poly = ring.arc_between(ke.0, ke.1);
+    if poly.len() < 2 {
+        return None;
+    }
+    let mut walk = safe_walk(&poly, p, legal_cut, ko_cut);
+    if p.blend_turns {
+        let (filleted, t) = fillet_corners(&walk, poly[0], p.tool_diameter * 0.5, p.tolerance, legal_cut);
+        if segs_clear_of(poly[0], &filleted, ko_cut) {
+            walk = filleted;
+            sink.tally.add(t);
+        }
+    }
+    let (mut entry, mut lead, mut lead_off) = seam_leads(&walk, &poly, p, legal_entry, &mut sink.lead_notes);
+    let ext = extend_leads(entry, lead, lead_off, &walk, &poly, p, legal_entry, &mut sink.lead_notes);
+    entry = ext.0;
+    lead = ext.1;
+    lead_off = ext.2;
+    if !segs_clear_of(entry, &lead, ko_cut) || ko_entry.contains(entry) || segs_cross_prior(entry, &lead, prior_z) {
+        lead.clear();
+        entry = poly[0];
+    }
+    let end = poly[poly.len() - 1];
+    let exit_end = flatten(end, &lead_off).last().copied().unwrap_or(end);
+    if !segs_clear_of(end, &lead_off, ko_cut) || ko_entry.contains(exit_end) || segs_cross_prior(end, &lead_off, prior_z) {
+        lead_off.clear();
+    }
+    Some((poly, walk, entry, lead, lead_off))
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn push_open_piece(
+    b: &mut PathBuilder,
+    piece: &[Point2],
+    z: f64,
+    hop_z: f64,
+    inside: bool,
+    tabbed: bool,
+    p: &ContourParams,
+    band: &PreparedBand,
+    legal_cut: &Legal,
+    legal_entry: &Legal,
+    ko_cut: &Region,
+    ko_entry: &Region,
+    center_avoid: &Region,
+    cert_avoid: &Cert<'_>,
+    m: &Motion,
+    prior_z: &mut Vec<Vec<Point2>>,
+    dives: &mut (f64, Vec<Vec<Point2>>),
+    last_leads: &mut Vec<Vec<Point2>>,
+    sink: &mut AvoidSink,
+) -> Result<(), GenError> {
+    let sub_pieces = if ko_entry.contains(piece[0]) || ko_entry.contains(piece[piece.len() - 1]) {
+        match clip_polyline(piece, ko_entry, false) {
+            Clip::Unclipped => vec![piece.to_vec()],
+            Clip::AllBlocked => {
+                sink.clipped_any = true;
+                return Ok(());
+            }
+            Clip::Pieces(ps) => {
+                sink.clipped_any = true;
+                ps
+            }
+        }
+    } else {
+        vec![piece.to_vec()]
+    };
+
+    for sub in sub_pieces {
+        let mut walk = safe_walk(&sub, p, legal_cut, ko_cut);
+        if p.blend_turns {
+            let (filleted, t) = fillet_corners(&walk, sub[0], p.tool_diameter * 0.5, p.tolerance, legal_cut);
+            if segs_clear_of(sub[0], &filleted, ko_cut) {
+                walk = filleted;
+                sink.tally.add(t);
+            }
+        }
+        let (mut entry, mut lead, mut lead_off) = seam_leads(&walk, &sub, p, legal_entry, &mut sink.lead_notes);
+        let ext = extend_leads(entry, lead, lead_off, &walk, &sub, p, legal_entry, &mut sink.lead_notes);
+        entry = ext.0;
+        lead = ext.1;
+        lead_off = ext.2;
+        if !segs_clear_of(entry, &lead, ko_cut) || ko_entry.contains(entry) || segs_cross_prior(entry, &lead, prior_z) {
+            lead.clear();
+            entry = sub[0];
+        }
+        if ko_entry.contains(entry) || ko_cut.contains(entry) {
+            sink.clipped_any = true;
+            continue;
+        }
+        let end = sub[sub.len() - 1];
+        let exit_end = flatten(end, &lead_off).last().copied().unwrap_or(end);
+        if !segs_clear_of(end, &lead_off, ko_cut)
+            || ko_entry.contains(exit_end)
+            || segs_cross_prior(end, &lead_off, prior_z)
+            || crosses(entry, &lead, end, &lead_off)
+        {
+            lead_off.clear();
+        }
+        let e2 = Point2::new(entry.x, entry.y);
+        let here = vec![flatten(e2, &lead), flatten(end, &lead_off)];
+        let link_leads: Vec<Vec<Point2>> = std::mem::replace(last_leads, here.clone()).into_iter().chain(here).collect();
+        let ap = &p.links.approach;
+        let lf = ap.lead_feed(p.feed);
+        let lead_top = if ap.lead_height > 0.0 && !lead.is_empty() { z + ap.lead_height } else { z };
+        let arm = if sink.first_entry { p.entry } else { p.links.arm(p.entry) };
+
+        if !sink.first_entry {
+            let cut_dives = if dives.0.to_bits() == z.to_bits() { dives.1.as_slice() } else { &[] };
+            ring_link(b, p, legal_cut, &[&band.plan, cut_dives, &link_leads, prior_z], e2, z, hop_z, tabbed, &mut sink.lifted);
+            if b.at().z > lead_top + 1e-9 {
+                guard(b, p, e2, lead_top, p.entry_top(), "the dive onto clipped contour");
+                b.push(MoveKind::Plunge, Point3::new(e2.x, e2.y, lead_top), Some(p.plunge_feed));
+            }
+        } else {
+            let step_center = if inside && !center_avoid.contains(e2) { &band.center } else { center_avoid };
+            let _ = cert_avoid;
+            let step_cert = Cert::Region(step_center);
+            let eng = Engage { p, center: step_center, cert: &step_cert, plan: &band.plan, m, legal: legal_entry };
+            let step = Step { arm, e2, z, prev_z: p.clearance_z, first: true, opened: false, inside: inside && !center_avoid.is_empty(), tabbed, lead_top };
+            if let Some(d) = engage_level(b, &eng, &step, &lead, &walk, &mut sink.said) {
+                if dives.0.to_bits() != z.to_bits() {
+                    *dives = (z, Vec::new());
+                }
+                dives.1.push(vec![d, e2]);
+            }
+        }
+        sink.first_entry = false;
+        let at = b.at();
+        if at.x == e2.x && at.y == e2.y && at.z > z {
+            super::lead_ext::push_lead_down(b, &lead, at.z, z, lf);
+        } else {
+            push_segs(b, &lead, z, lf);
+        }
+        push_segs(b, &walk, z, p.feed);
+        push_segs(b, &lead_off, z, p.feed);
+        prior_z.push(flatten(e2, &lead));
+        prior_z.push(sub);
+        prior_z.push(flatten(end, &lead_off));
+    }
+    Ok(())
+}
diff --git a/crates/motion/src/machining2d/contour_avoid_whole.rs b/crates/motion/src/machining2d/contour_avoid_whole.rs
new file mode 100644
index 0000000000..ff5177142a
--- /dev/null
+++ b/crates/motion/src/machining2d/contour_avoid_whole.rs
@@ -0,0 +1,196 @@
+//! Whole-model 2D Contour planning with "Do not touch" protection (#3344).
+//! Provenance: clean-room per-band region fencing and avoid emission extending `contour_whole`; no vendor material consulted.
+
+use std::ops::Range;
+
+use camcraft_sim::verify::AvoidSpec;
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geo2d::Region;
+use crate::geometry::{Point3, Triangle};
+
+use super::contour::prepare_band;
+use super::contour_avoid::{contour_on_bodies_avoid, finish_avoid_contour};
+use super::contour_avoid_emit::{AvoidSink, emit_band_avoid};
+use super::contour_comp;
+use super::contour_depth::ladder;
+use super::contour_entry::say;
+use super::contour_params::{ContourParams, Side};
+use super::contour_start;
+use super::contour_whole::{
+    SAME_LEVEL, check_unread, first_split, forward_band_notes, match_pick, note_rings_without_floor, stopped, trim_ladder,
+};
+use super::contour_whole_fence::{Planned, room};
+use super::contour_whole_reach::{band_sweep, reach_up};
+use super::contour_whole_slice::next_region;
+use super::face::GenError;
+
+fn flush_avoid(
+    b: &mut PathBuilder,
+    planned: &mut Vec<Planned>,
+    p: &ContourParams,
+    avoid: &AvoidSpec,
+    sink: &mut AvoidSink,
+) -> Result<(), GenError> {
+    let rooms = (0..planned.len()).map(|i| room(planned, i)).collect::<Result<Vec<_>, _>>()?;
+    for (mut pl, rm) in planned.drain(..).zip(rooms) {
+        pl.band.room = rm;
+        emit_band_avoid(b, &pl.band, p, &pl.lad, pl.pick, pl.exit, avoid, sink)?;
+    }
+    Ok(())
+}
+
+/// Whole-model [`super::contour_whole::contour_whole_bodies_with`] with "Do not touch" protection.
+pub fn contour_whole_bodies_with_avoid(
+    top_region: &Region,
+    part: &[Triangle],
+    bodies: &[Range<usize>],
+    p: &ContourParams,
+    avoid: &AvoidSpec,
+    area_at: &mut dyn FnMut(Region) -> Result<Region, GenError>,
+) -> Result<(Toolpath, Vec<Region>), GenError> {
+    if avoid.is_empty() {
+        return super::contour_whole::contour_whole_bodies_with(top_region, part, bodies, p, area_at);
+    }
+    if p.side == Side::Inside {
+        let path = contour_on_bodies_avoid(top_region, part, bodies, p, avoid)?;
+        return Ok((path, vec![top_region.clone()]));
+    }
+    p.validate()?;
+    contour_comp::door(p)?;
+    if top_region.is_empty() {
+        return Err(GenError::Empty("empty footprint".into()));
+    }
+    let flat = p.ring_levels()?;
+    let r = p.tool_diameter * 0.5;
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    let mut sink = AvoidSink::default();
+    let mut walked = Vec::new();
+    let mut cover = Region::empty();
+    let mut remaining: &[f64] = &flat;
+    let mut current_region = top_region.clone();
+    let mut ceiling = p.top_z;
+    let mut used_fallback = false;
+    let mut pick_matched = p.links.approach.start_point.is_none();
+    let mut exit_matched = p.links.approach.exit_point.is_none();
+    let mut deferred_pick = None;
+    let mut deferred_exit = None;
+    let mut planned: Vec<Planned> = Vec::new();
+
+    let mut mid = false;
+    let max_bands = flat.len().saturating_mul(2).saturating_add(part.len().saturating_mul(3)).saturating_add(2);
+    let mut band_idx = 0usize;
+    while !remaining.is_empty() && band_idx <= max_bands {
+        let last_z = remaining[remaining.len() - 1];
+        let band = prepare_band(&current_region, p)?;
+        let refs: Vec<&crate::geo2d::Loop> = band.loops.iter().collect();
+        let pick = match_pick(contour_start::pick_ring(&refs, p), &mut pick_matched, &mut deferred_pick)?;
+        let exit = match_pick(contour_start::pick_exit(&refs, p), &mut exit_matched, &mut deferred_exit)?;
+
+        let mut ring_notes = Vec::new();
+        let lad = ladder(&band.plan, part, bodies, remaining, ceiling, r, p.stock_to_leave, &mut ring_notes);
+        if check_unread(&lad, remaining, p, &b).is_err() {
+            flush_avoid(&mut b, &mut planned, p, avoid, &mut sink)?;
+            check_unread(&lad, remaining, p, &b)?;
+        }
+        let lad = reach_up(&band, lad, &cover, &flat, part, bodies, p)?;
+        let split = if mid { Some(0) } else { first_split(&band, &lad, remaining, part, bodies, p)? };
+        match split {
+            Some(0) if mid || (band_idx == 0 && !used_fallback) => {
+                let trimmed = trim_ladder(&lad, remaining[0]);
+                let emitted = trimmed.zs.last().is_some_and(|&z| z < ceiling - SAME_LEVEL);
+                if emitted {
+                    note_rings_without_floor(&band, &lad, &trimmed, remaining[0], ceiling, &mut sink.lead_notes);
+                    forward_band_notes(&band, &lad, last_z, true, ring_notes, &mut sink.lead_notes);
+                    walked.push(current_region.clone());
+                    cover = cover.union(&band_sweep(&band.center, r)?)?;
+                    ceiling = trimmed.zs.last().copied().unwrap_or(ceiling);
+                    planned.push(Planned { band, lad: trimmed, pick, exit });
+                } else if mid {
+                    say(
+                        &mut sink.lead_notes,
+                        format!(
+                            "whole-model contour: the outline changes between Z {:.3} and Z {:.3} but has no floor level there - that wall is not cut; reduce the stepdown",
+                            remaining[0], ceiling
+                        ),
+                    );
+                }
+                used_fallback = true;
+                let (raw, next_mid) = next_region(part, bodies, p, ceiling, remaining[0], emitted)?;
+                mid = next_mid;
+                current_region = area_at(raw)?;
+            }
+            Some(0) => {
+                let msg = format!(
+                    "whole-model contour cannot cut Z {:.3} (Bottom Z {:.3}) without gouging ({})",
+                    remaining[0],
+                    p.bottom_z,
+                    ring_notes.join("; ")
+                );
+                flush_avoid(&mut b, &mut planned, p, avoid, &mut sink)?;
+                return Err(stopped(msg, b));
+            }
+            Some(j) => {
+                let z_next = remaining[j];
+                let trimmed = trim_ladder(&lad, z_next);
+                if trimmed.zs.is_empty() {
+                    return Err(GenError::Invalid(format!(
+                        "whole-model contour produced no cut levels above Z {z_next:.3}"
+                    )));
+                }
+                forward_band_notes(&band, &lad, last_z, true, ring_notes, &mut sink.lead_notes);
+                walked.push(current_region.clone());
+                cover = cover.union(&band_sweep(&band.center, r)?)?;
+                ceiling = trimmed.zs.last().copied().unwrap_or(remaining[j - 1]);
+                planned.push(Planned { band, lad: trimmed, pick, exit });
+                remaining = &remaining[j..];
+                used_fallback = true;
+                let (raw, next_mid) = next_region(part, bodies, p, ceiling, remaining[0], true)?;
+                mid = next_mid;
+                current_region = match area_at(raw) {
+                    Ok(r) => r,
+                    Err(e) => {
+                        let msg = format!(
+                            "whole-model contour stopped at Z {ceiling:.3} (Bottom Z {:.3}): no machinable region at Z {:.3} ({e})",
+                            p.bottom_z, remaining[0]
+                        );
+                        flush_avoid(&mut b, &mut planned, p, avoid, &mut sink)?;
+                        return Err(stopped(msg, b));
+                    }
+                };
+            }
+            None => {
+                forward_band_notes(&band, &lad, last_z, false, ring_notes, &mut sink.lead_notes);
+                planned.push(Planned { band, lad, pick, exit });
+                walked.push(current_region);
+                remaining = &[];
+                break;
+            }
+        }
+        band_idx += 1;
+    }
+    if let Some(z) = remaining.first() {
+        let msg = format!(
+            "whole-model contour stopped at Z {ceiling:.3} (Bottom Z {:.3}): too many outline changes above Z {z:.3}",
+            p.bottom_z
+        );
+        flush_avoid(&mut b, &mut planned, p, avoid, &mut sink)?;
+        return Err(stopped(msg, b));
+    }
+    flush_avoid(&mut b, &mut planned, p, avoid, &mut sink)?;
+    let cur = b.at();
+    b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, p.clearance_z), None);
+
+    if !pick_matched
+        && let Some(e) = deferred_pick
+    {
+        return Err(e);
+    }
+    if !exit_matched
+        && let Some(e) = deferred_exit
+    {
+        return Err(e);
+    }
+    let path = finish_avoid_contour(b, sink, p, avoid)?;
+    Ok((path, walked))
+}
