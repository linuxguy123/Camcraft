diff --git a/crates/app/tests/start_exit_shared/finish3d.rs b/crates/app/tests/start_exit_shared/finish3d.rs
new file mode 100644
index 000000000..9abea6ec0
--- /dev/null
+++ b/crates/app/tests/start_exit_shared/finish3d.rs
@@ -0,0 +1,198 @@
+//! The 3D Finish's start and exit picks (#3329, slice 2) through the
+//! application: on the Parallel pattern a pick chooses the raster corner
+//! where the cut starts and where the last pass ends, the cut geometry
+//! stays the automatic raster's, and what moves a picked corner (the
+//! waterline rings, the area controls, another pattern) is refused by
+//! name. A module of the `start_exit_shared` suite.
+
+use super::*;
+
+/// The catalog ball, 6 mm across.
+const BALL: &str = "BN-0600";
+const R: f64 = 3.0;
+
+/// A closed 30 x 20 x 10 box on z = 0, centred on the origin, in a
+/// 40 x 40 x 12 stock, with the ball.
+fn block_world() -> flecs_ecs::prelude::World {
+    use camcraft_app::commands::{AddTool, History, ImportModel, SetStock};
+    use camcraft_app::geometry::{cube, Point3, IDENTITY_Q};
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    let at = camcraft_app::schema::Location { pos: Point3::ZERO, rot: IDENTITY_Q };
+    let stock = SetStock::new(&world, camcraft_app::stock::StockShape::Box { dx: 40.0, dy: 40.0, dz: 12.0 }, at);
+    h.execute(&world, stock.expect("stock"));
+    let t = camcraft_app::tools::catalog().into_iter().find(|(n, _)| *n == BALL).map(|(_, t)| t).expect("catalog ball");
+    h.execute(&world, AddTool::new(&world, BALL, t).expect("tool"));
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::new(-15.0, -10.0, 0.0), Point3::new(15.0, 10.0, 10.0))));
+    world
+}
+
+type Pick = Option<(f64, f64)>;
+
+/// The Parallel 3D Finish on the block's top, passes along +Y.
+fn finish3d(start: Pick, exit: Pick, waterlines: bool) -> camcraft_app::schema::Operation {
+    let pick = |(x, y)| camcraft_app::path_picks::PathPick::xy(Point2::new(x, y));
+    let params = OpParams::Finish3D {
+        pattern: camcraft_app::finishing3d::FinishPattern::Parallel,
+        direction_angle: 90.0,
+        stepover: Some(4.0),
+        tolerance: 0.1,
+        clearance_z: Height::fixed(25.0),
+        retract_z: None,
+        top_z: Height::fixed(11.0),
+        bottom_z: Height::fixed(7.0),
+        feed: 500.0,
+        plunge_feed: 100.0,
+        climb: true,
+        ramp: false,
+        min_step: None,
+        ramp_angle: 45.0,
+        entry_ramp: false,
+        steep_stepover: None,
+        pencil_reference: None,
+        fill_openings: None,
+        gap_link: camcraft_app::finishing3d::GapLink::Jump,
+        waterlines,
+        pass_start: Default::default(),
+        picks: camcraft_app::path_picks::PathPicks { start: start.map(pick).into_iter().collect(), exit: exit.map(pick).into_iter().collect() },
+    };
+    camcraft_app::schema::Operation {
+        tool: BALL.into(),
+        src: camcraft_app::operation::SrcRef::Entity("part".into()),
+        params,
+        stamp: None,
+        setup: None,
+        area: Default::default(),
+        coolant: Default::default(),
+        after: Default::default(),
+        suppressed: false,
+    }
+}
+
+type Seg = ([f64; 3], [f64; 3]);
+
+/// The ball centre segments of the cuts on the top: feeds that travel in
+/// XY at the top's centre height.
+fn top_cuts(t: &camcraft_app::cl::Toolpath) -> Vec<Seg> {
+    let c = |p: camcraft_app::geometry::Point3| [p.x, p.y, p.z + R];
+    t.moves
+        .iter()
+        .filter(|m| m.kind == camcraft_app::cl::MoveKind::Feed && (m.from.x - m.to.x).hypot(m.from.y - m.to.y) > 1e-9)
+        .map(|m| (c(m.from), c(m.to)))
+        .filter(|(a, b)| (a[2] - 13.0).abs() < 0.2 && (b[2] - 13.0).abs() < 0.2)
+        .collect()
+}
+
+fn first_plunge(t: &camcraft_app::cl::Toolpath) -> [f64; 3] {
+    t.moves.iter().find(|m| m.kind == camcraft_app::cl::MoveKind::Plunge).map(|m| [m.to.x, m.to.y, m.to.z]).expect("a plunge")
+}
+
+fn last_feed(t: &camcraft_app::cl::Toolpath) -> usize {
+    t.moves.iter().rposition(|m| m.kind == camcraft_app::cl::MoveKind::Feed).expect("a feed")
+}
+
+/// Every top cut of `got` lies on a top cut of `auto` along its whole
+/// length, sampled every 0.25 mm, and the other way round.
+fn same_top_cuts(auto: &camcraft_app::cl::Toolpath, got: &camcraft_app::cl::Toolpath) {
+    let off = |c: [f64; 3], segs: &[Seg]| {
+        segs.iter().map(|(a, b)| {
+            let d = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];
+            let l2 = d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
+            let t = if l2 > 0.0 { (((c[0] - a[0]) * d[0] + (c[1] - a[1]) * d[1] + (c[2] - a[2]) * d[2]) / l2).clamp(0.0, 1.0) } else { 0.0 };
+            (0..3).map(|i| (c[i] - a[i] - d[i] * t).powi(2)).sum::<f64>().sqrt()
+        }).fold(f64::INFINITY, f64::min)
+    };
+    for (from, to) in [(got, auto), (auto, got)] {
+        let segs = top_cuts(to);
+        assert!(!segs.is_empty(), "the raster cuts the top");
+        for (a, b) in top_cuts(from) {
+            let len = (0..3).map(|i| (b[i] - a[i]).powi(2)).sum::<f64>().sqrt();
+            let n = ((len / 0.25).ceil() as usize).max(1);
+            for k in 0..=n {
+                let t = k as f64 / n as f64;
+                let c = [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
+                assert!(off(c, &segs) < 1e-6, "a top cut leaves the automatic raster at {c:?}");
+            }
+        }
+    }
+}
+
+fn same(p: [f64; 3], q: [f64; 3]) -> bool {
+    (0..3).all(|i| (p[i] - q[i]).abs() < 1e-6)
+}
+
+#[test]
+fn finish3d_starts_at_the_picked_corner_and_ends_at_the_picked_exit() {
+    let world = block_world();
+    let generate = |op| camcraft_app::operation::generate(&world, &op, "").map(|(t, _)| t);
+    let auto = generate(finish3d(None, None, false)).expect("the automatic raster");
+    let a = first_plunge(&auto);
+    // The far end of the first pass (the passes run along Y).
+    let started = generate(finish3d(Some((a[0], -a[1])), None, false)).expect("the started raster");
+    let s = first_plunge(&started);
+    assert!(s[1] * a[1] < 0.0 && (s[1] + a[1]).abs() < 0.5 && (s[0] - a[0]).abs() < 1e-6, "the cut starts at the picked corner: {s:?} (automatic {a:?})");
+    same_top_cuts(&auto, &started);
+    // An exit at the automatic start: the whole raster runs back, the
+    // last cut ends at the automatic first corner, and the tool rises
+    // straight up from there.
+    let exited = generate(finish3d(None, Some((a[0], a[1])), false)).expect("the exited raster");
+    let k = last_feed(&exited);
+    let end = exited.moves[k].to;
+    assert!(same([end.x, end.y, end.z], a), "the cut ends at the exit corner: {end:?} (automatic start {a:?})");
+    let rise = &exited.moves[k + 1];
+    assert!(rise.from.x == rise.to.x && rise.from.y == rise.to.y && rise.to.z > rise.from.z, "the tool leaves straight up: {rise:?}");
+    same_top_cuts(&auto, &exited);
+    // Without a pick the path is the automatic raster, move for move.
+    assert_eq!(generate(finish3d(None, None, false)).expect("again"), auto);
+}
+
+#[test]
+fn finish3d_refuses_an_impossible_pick_by_name() {
+    let world = block_world();
+    let auto = camcraft_app::operation::generate(&world, &finish3d(None, None, false), "").map(|(t, _)| t).expect("auto");
+    let a = first_plunge(&auto);
+    let mut clipped = finish3d(Some((a[0], a[1])), None, false);
+    clipped.area.offset = -6.0;
+    let cases = [
+        (finish3d(Some((0.0, 0.0)), None, false), "start point (0.000, 0.000)", "only at a corner"),
+        (finish3d(None, Some((a[0], a[1])), true), "exit point", "the waterline rings cut after the raster"),
+        (clipped, "start point", "the area controls clip the raster"),
+    ];
+    for (op, what, why) in cases {
+        let e = camcraft_app::operation::generate(&world, &op, "").err().map(|e| format!("{e:?}"));
+        assert!(e.as_deref().is_some_and(|m| m.contains(what) && m.contains(why)), "{what}, {why}: {e:?}");
+    }
+    // The same start with the rings on holds: the raster cuts first.
+    let t = camcraft_app::operation::generate(&world, &finish3d(Some((a[0], -a[1])), None, true), "").map(|(t, _)| t).expect("a start with rings");
+    assert!(first_plunge(&t)[1] * a[1] < 0.0, "the cut starts at the picked corner: {:?}", first_plunge(&t));
+}
+
+#[test]
+fn finish3d_picks_ride_edit_operation_and_another_pattern_is_refused_at_the_door() {
+    let mut s = job();
+    assert!(!call(&mut s, "add_tool", json!({ "catalog": BALL })).0);
+    let (err, r) = call(&mut s, "add_operation", json!({ "kind": "3D Finish", "tool": BALL, "name": "F3" }));
+    assert!(!err, "{r}");
+    let patch = json!({ "name": "F3", "params": { "pattern": "parallel", "picks": { "start": [[-27.25, -17.75]], "exit": [[27.25, 17.75]] } } });
+    let (err, r) = call(&mut s, "edit_operation", patch);
+    assert!(!err, "the Parallel 3D Finish takes both picks: {r}");
+    let held = |s: &mut Server| call(s, "get_job", json!({})).1.to_string();
+    assert!(held(&mut s).contains("27.25"), "the job carries the picks");
+    // Another pattern with the picks is refused by name, and changes nothing.
+    let (err, r) = call(&mut s, "edit_operation", json!({ "name": "F3", "params": { "pattern": "waterline" } }));
+    let text = r.to_string();
+    assert!(err && text.contains("3D Finish") && text.contains("Parallel pattern only"), "{text}");
+    assert!(held(&mut s).contains("27.25"), "the refused edit keeps the picks");
+    assert!(!call(&mut s, "undo", json!({})).0);
+    let job_text = held(&mut s);
+    assert!(!job_text.contains("27.25") && !job_text.contains("17.75"), "undo restores the automatic order");
+    assert!(!call(&mut s, "redo", json!({})).0);
+    assert!(held(&mut s).contains("27.25"), "redo states the picks again");
+    let reply = s.handle(&json!({ "jsonrpc": "2.0", "id": 1, "method": "tools/list", "params": {} })).expect("an answer");
+    let doc = reply["result"]["tools"]
+        .as_array()
+        .and_then(|t| t.iter().find(|t| t["name"] == "edit_operation"))
+        .map(|t| t["inputSchema"]["properties"]["params"]["description"].as_str().unwrap_or_default().to_owned())
+        .unwrap_or_default();
+    assert!(doc.contains("3D Finish (the Parallel pattern only"), "the schema names the 3D Finish and its limit: {doc}");
+}
diff --git a/crates/motion/src/finishing3d/finish_seam.rs b/crates/motion/src/finishing3d/finish_seam.rs
new file mode 100644
index 000000000..e8244a028
--- /dev/null
+++ b/crates/motion/src/finishing3d/finish_seam.rs
@@ -0,0 +1,179 @@
+//! The user's start and exit points on the 3D Finish (#3329, the 3D
+//! Finish slice of #1448). The picks are read on the Parallel pattern,
+//! the one-direction zigzag raster, at any pass direction. The raster's
+//! passes are kept as they are; the pick only chooses the corner where
+//! the cut starts and the corner where the last pass ends, by the
+//! raster seam's law (`raster_seam::order`, shared with the 5-Axis
+//! Parallel):
+//!
+//! - **Start:** the raster corner nearest the start pick. The pass
+//!   order is reversed when that corner is on the last pass, and each
+//!   pass runs the other way when that corner is the far end of its
+//!   pass.
+//! - **Exit:** the order whose last pass ends nearest the exit pick.
+//!   With a start pick, the exit must be near the end that the start's
+//!   order gives.
+//!
+//! What a pick cannot keep is refused by name, never moved:
+//!
+//! - a pick on a pattern other than Parallel;
+//! - a pick farther than its reach from every corner, and an exit that
+//!   the start's order cannot end at (`raster_seam`);
+//! - a plunge column at the picked start, or a retract column at the
+//!   picked exit, that comes within the ball radius of the part. The
+//!   check is exact: the distance from the column's segment to each
+//!   facet (`support::column_clear`), no sampling;
+//! - a start or an exit that a later stage moves: the waterline rings
+//!   that cut after the raster, or (in the application) the area
+//!   controls that clip it. The finished path is read again, and its
+//!   first cut and its last cut must be the picked corners.
+//!
+//! No pick is the automatic raster, byte for byte.
+//!
+//! Provenance: first principles - the four end corners of a serpentine
+//! raster, the swept ball of a vertical move as its segment inflated by
+//! the radius; the entry and exit position is the common vocabulary of
+//! published CAM practice. No vendor material consulted.
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geometry::{Point3, Triangle};
+use crate::machining2d::GenError;
+use crate::path_picks::{PathPick, PickRole};
+
+use super::grid::SupSet;
+use super::params::{validate, Finish3DParams, FinishPattern, TOUCH_EPS};
+use super::raster::{parallel_angle_refusal, parallel_with_angle, raster_pass_seamed, rings_and_tail};
+use super::raster_seam::{RasterEnds, RasterSeam};
+use super::support::{build_sups, column_clear};
+
+/// The unit pass direction of the Parallel pattern at `direction_angle`
+/// degrees counterclockwise from +X; the four axis angles are exact.
+pub(super) fn parallel_direction(direction_angle: f64) -> (f64, f64) {
+    match direction_angle {
+        0.0 => (1.0, 0.0),
+        90.0 => (0.0, 1.0),
+        180.0 => (-1.0, 0.0),
+        270.0 => (0.0, -1.0),
+        _ => {
+            let (sin, cos) = direction_angle.to_radians().sin_cos();
+            (cos, sin)
+        }
+    }
+}
+
+/// "start point (x, y)" or "exit point (x, y, z)", the refusals' lead.
+fn named(role: PickRole, p: &PathPick) -> String {
+    match p.z {
+        Some(z) => format!("{} point ({:.3}, {:.3}, {:.3})", role.word(), p.xy.x, p.xy.y, z),
+        None => format!("{} point ({:.3}, {:.3})", role.word(), p.xy.x, p.xy.y),
+    }
+}
+
+fn at(q: Point3) -> String {
+    format!("({:.3}, {:.3}, {:.3})", q.x, q.y, q.z)
+}
+
+/// The first pick of the seam, with its role: the subject of a refusal
+/// that is not about one role.
+fn any_pick(seam: &RasterSeam) -> Option<(PickRole, PathPick)> {
+    seam.start.map(|q| (PickRole::Start, q)).or(seam.exit.map(|q| (PickRole::Exit, q)))
+}
+
+/// The 3D Finish's Parallel raster at `direction_angle` degrees with the
+/// user's start and exit points: the passes ordered for the picks, then
+/// the waterline rings and the clearance exit, as the automatic path.
+/// Returns the path and where the raster starts and ends. An empty
+/// `seam` is [`parallel_with_angle`], byte for byte, with no ends.
+pub fn finish_seamed(
+    facets: &[Triangle],
+    p: &Finish3DParams,
+    direction_angle: f64,
+    seam: &RasterSeam,
+) -> Result<(Toolpath, Option<RasterEnds>), GenError> {
+    let Some((role, q)) = any_pick(seam) else {
+        return Ok((parallel_with_angle(facets, p, direction_angle)?, None));
+    };
+    if !matches!(p.pattern, FinishPattern::Parallel) {
+        return Err(GenError::Invalid(format!(
+            "{}: the 3D Finish reads a start or exit point on the Parallel pattern only, not on {:?} - pick \
+             the Parallel pattern, or clear the {} point",
+            named(role, &q),
+            p.pattern,
+            role.word()
+        )));
+    }
+    if let Some(why) = parallel_angle_refusal(direction_angle) {
+        return Err(GenError::Invalid(why.into()));
+    }
+    validate(p, facets)?;
+    let r = p.tool_diameter * 0.5;
+    let sups = build_sups(facets, r);
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    let dir = parallel_direction(direction_angle);
+    let Some(ends) = raster_pass_seamed(&mut b, p, r, &sups, dir, false, p.tolerance, seam)? else {
+        return Err(GenError::Invalid(format!(
+            "{}: the raster has no pass to read it on - no shallow ground stands inside the depths",
+            named(role, &q)
+        )));
+    };
+    ends_clear(ends, seam, r, p.clearance_z, &sups)?;
+    let path = rings_and_tail(b, p, r, facets, true)?;
+    raster_ends_kept(
+        &path,
+        ends,
+        seam,
+        "the waterline rings cut after the raster",
+        "turn off the waterline rings, or clear the exit point",
+    )?;
+    Ok((path, Some(ends)))
+}
+
+/// The exact column law at each picked end of the ordered raster: the
+/// ball's plunge from the clearance plane down to the first tip, and
+/// its retract from the last tip up to the clearance plane, keep a full
+/// radius from every facet (`support::column_clear`: the distance from
+/// the column's segment to each facet, no sampling). The raster's own
+/// ground law gives the same answer for each sample it keeps; this is
+/// the seam's own proof at the ends that a pick moves.
+pub(super) fn ends_clear(ends: RasterEnds, seam: &RasterSeam, r: f64, clearance_z: f64, sups: &SupSet) -> Result<(), GenError> {
+    let top = clearance_z + r;
+    let picked = [(seam.start, ends.start, PickRole::Start, "plunge column to"), (seam.exit, ends.exit, PickRole::Exit, "retract column from")];
+    for (pick, tip, role, what) in picked {
+        let Some(q) = pick else { continue };
+        if !column_clear(tip.x, tip.y, tip.z + r, top, r - TOUCH_EPS, sups) {
+            return Err(GenError::Invalid(format!(
+                "{}: the {what} the raster corner {} comes within the ball radius {r:.3} mm of the part - \
+                 pick another corner, or clear the {} point",
+                named(role, &q),
+                at(tip),
+                role.word()
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// The finished path keeps the picked corners: its first cut lands on
+/// the raster's first tip when a start is picked, and its last cut ends
+/// on the raster's last tip when an exit is picked. Else the refusal
+/// names the pick, where the path starts or ends instead, the `cause`
+/// (what moved it) and the `fix`. A pick is never moved in silence.
+pub fn raster_ends_kept(path: &Toolpath, ends: RasterEnds, seam: &RasterSeam, cause: &str, fix: &str) -> Result<(), GenError> {
+    let same = |a: Point3, b: Point3| (a.x - b.x).abs() <= 1e-9 && (a.y - b.y).abs() <= 1e-9 && (a.z - b.z).abs() <= 1e-9;
+    let first = path.moves.iter().find(|m| m.kind != MoveKind::Rapid).map(|m| m.to);
+    let last = path.moves.iter().rev().find(|m| m.kind == MoveKind::Feed).map(|m| m.to);
+    let checks = [(seam.start, first, ends.start, PickRole::Start, "starts"), (seam.exit, last, ends.exit, PickRole::Exit, "ends")];
+    for (pick, got, want, role, verb) in checks {
+        let Some(q) = pick else { continue };
+        if got.is_some_and(|g| same(g, want)) {
+            continue;
+        }
+        let instead = got.map_or_else(|| "nowhere".to_owned(), at);
+        return Err(GenError::Invalid(format!(
+            "{}: {cause}, so the cut {verb} at {instead}, not at the picked raster corner {} - {fix}",
+            named(role, &q),
+            at(want)
+        )));
+    }
+    Ok(())
+}
