diff --git a/crates/motion/src/machining2d/chamfer_lead.rs b/crates/motion/src/machining2d/chamfer_lead.rs
new file mode 100644
index 0000000000..aef4077993
--- /dev/null
+++ b/crates/motion/src/machining2d/chamfer_lead.rs
@@ -0,0 +1,261 @@
+//! 2D Chamfer lead planning: shared lead shapes, the Chamfer-specific
+//! air/transition policy, whole-tool collision checks and hard refusal.
+//!
+//! Provenance: the five shape constructors are the shared machining
+//! handbook geometry in `arc_leads`; the fit, move-crossing and full
+//! tool-assembly checks are this codebase's safety laws. No vendor source
+//! was consulted.
+
+use crate::cl::{Move, PathBuilder, Toolpath};
+use crate::geo2d::{Point2, Region};
+use crate::geometry::Point3;
+
+use super::arc_cross::moves_cross_prior;
+use super::arc_leads::{lead_in, lead_out};
+use super::arcs::{Seg, push_segs, walk_tangent};
+use super::chamfer::ChamferParams;
+use super::chamfer_lead_check::{ChamferLeadSafety, LeadProbe, full_tool_holds};
+use super::contour::{Lead, air_side};
+use super::face::GenError;
+
+/// Four half-steps are enough to keep a lead local to the picked edge.
+const LEAD_SHRINKS: usize = 4;
+
+/// One accepted pass for `run_level_walks`.
+pub(super) struct PlannedWalk {
+    pub pass: Vec<Point2>,
+    pub segs: Vec<Seg>,
+}
+
+/// All accepted Chamfer runs, plus the named half-step notes they earned.
+pub(super) struct PlannedWalks {
+    pub passes: Vec<Vec<Point2>>,
+    pub runs: Vec<Vec<Seg>>,
+    pub notes: Vec<String>,
+}
+
+/// Plan explicit lead-in/out motion for each selected path. A missing
+/// outer lead-in is the v82-and-earlier compatibility marker, not an
+/// explicit `Lead::None`, and is rejected here by construction.
+pub(super) fn plan_walks(
+    paths: &[Vec<Point2>],
+    p: &ChamferParams,
+    safety: Option<&ChamferLeadSafety<'_>>,
+) -> Result<PlannedWalks, GenError> {
+    let lead = p.lead.ok_or_else(|| {
+        GenError::Invalid("legacy Chamfer motion cannot enter the explicit lead planner".into())
+    })?;
+    let lead_out_shape = p.lead_out.unwrap_or(lead);
+    let mut prior: Vec<Move> = Vec::new();
+    let mut passes = Vec::with_capacity(paths.len());
+    let mut runs = Vec::with_capacity(paths.len());
+    let mut notes = Vec::new();
+    for path in paths {
+        let (walk, mut said) =
+            plan_one(path, lead, lead_out_shape, p, safety, &prior)?;
+        let probe = feed_path(&walk.pass, &walk.segs, p.tip_z(), p.feed);
+        prior.extend(probe.moves);
+        notes.append(&mut said);
+        passes.push(walk.pass);
+        runs.push(walk.segs);
+    }
+    Ok(PlannedWalks { passes, runs, notes })
+}
+
+fn plan_one(
+    path: &[Point2],
+    requested_in: Lead,
+    requested_out: Lead,
+    p: &ChamferParams,
+    safety: Option<&ChamferLeadSafety<'_>>,
+    prior: &[Move],
+) -> Result<(PlannedWalk, Vec<String>), GenError> {
+    let Some(&first) = path.first() else {
+        return Err(GenError::Empty("a Chamfer lead needs a selected path".into()));
+    };
+    let Some(&last) = path.last() else {
+        return Err(GenError::Empty("a Chamfer lead needs a selected path".into()));
+    };
+    if path.len() < 2 {
+        return Err(GenError::Empty("a Chamfer lead needs at least two path points".into()));
+    }
+    let path_segs = vec![Seg::Line(path[1..].to_vec())];
+    let t_in = walk_tangent(&path_segs, path, true);
+    let t_out = walk_tangent(&path_segs, path, false);
+    let mut last_reason = "the candidate did not fit".to_owned();
+    for budget in 0..=LEAD_SHRINKS {
+        for in_step in 0..=budget {
+            for out_step in 0..=budget {
+                if in_step != budget && out_step != budget {
+                    continue;
+                }
+                let shaped_in =
+                    requested_in.scaled(0.5f64.powi(in_step as i32));
+                let shaped_out =
+                    requested_out.scaled(0.5f64.powi(out_step as i32));
+                let (entry, segs_in) =
+                    lead_in(first, t_in, air_side(t_in, p.climb), shaped_in);
+                let segs_out =
+                    lead_out(last, t_out, air_side(t_out, p.climb), shaped_out);
+                let mut segs = Vec::with_capacity(segs_in.len() + segs_out.len() + 1);
+                segs.extend(segs_in.iter().cloned());
+                segs.push(Seg::Line(path[1..].to_vec()));
+                segs.extend(segs_out.iter().cloned());
+                let pass = endpoints(entry, &segs);
+                let probe = feed_path(&pass, &segs, p.tip_z(), p.feed);
+                if !probe.all_finite() {
+                    last_reason = "the candidate left the finite horizon".into();
+                    continue;
+                }
+                if crosses_itself(&probe.moves) {
+                    last_reason = "the lead crossed its own Chamfer ride".into();
+                    continue;
+                }
+                if moves_cross_prior(&probe.moves, prior) {
+                    last_reason = "the lead crossed an earlier Chamfer ride".into();
+                    continue;
+                }
+                match full_tool_holds(
+                    LeadProbe {
+                        path,
+                        entry,
+                        segs_in: &segs_in,
+                        segs_out: &segs_out,
+                        shaped_in,
+                        shaped_out,
+                    },
+                    p,
+                    safety,
+                ) {
+                    Ok(()) => {
+                        let mut notes = Vec::new();
+                        shrink_note(
+                            &mut notes,
+                            "lead-in",
+                            requested_in,
+                            shaped_in,
+                            in_step,
+                        );
+                        shrink_note(
+                            &mut notes,
+                            "lead-out",
+                            requested_out,
+                            shaped_out,
+                            out_step,
+                        );
+                        return Ok((PlannedWalk { pass, segs }, notes));
+                    }
+                    Err(why) => last_reason = why,
+                }
+            }
+        }
+    }
+    Err(GenError::Invalid(format!(
+        "2D Chamfer {} lead-in and {} lead-out cannot fit after four halvings: {last_reason}; shorten the requested lead or move the selected edge into air",
+        requested_in.kind(),
+        requested_out.kind(),
+    )))
+}
+
+fn feed_path(
+    pass: &[Point2],
+    segs: &[Seg],
+    z: f64,
+    feed: f64,
+) -> Toolpath {
+    let at = pass.first().copied().unwrap_or(Point2::new(0.0, 0.0));
+    let mut b = PathBuilder::new(Point3::new(at.x, at.y, z));
+    push_segs(&mut b, segs, z, feed);
+    b.finish()
+}
+
+fn endpoints(entry: Point2, segs: &[Seg]) -> Vec<Point2> {
+    let mut points = vec![entry];
+    for seg in segs {
+        match seg {
+            Seg::Line(qs) => points.extend(qs.iter().copied()),
+            Seg::Arc { to, .. } => points.push(*to),
+        }
+    }
+    points
+}
+
+fn crosses_itself(moves: &[Move]) -> bool {
+    moves
+        .iter()
+        .enumerate()
+        .any(|(i, m)| moves_cross_prior(std::slice::from_ref(m), &moves[..i]))
+}
+
+fn shrink_note(notes: &mut Vec<String>, end: &str, requested: Lead, used: Lead, steps: usize) {
+    if steps == 0 || used.size() == 0.0 {
+        return;
+    }
+    let note = format!(
+        "2D Chamfer {end} {} lead was halved {} time(s): requested {:.3} mm, used {:.3} mm",
+        requested.kind(),
+        steps,
+        requested.size(),
+        used.size(),
+    );
+    if !notes.contains(&note) {
+        notes.push(note);
+    }
+}
+
+/// Preserve the pre-v83 open-chain air extension exactly. This is the
+/// compatibility path selected by an absent persisted `lead` key.
+pub(super) fn legacy_open_ride(
+    pass: &[Point2],
+    p: &ChamferParams,
+    levels: &[(f64, Region)],
+) -> Result<Vec<Point2>, GenError> {
+    let (Some(&first), Some(&second), Some(&last), Some(&before_last)) = (
+        pass.first(),
+        pass.get(1),
+        pass.last(),
+        pass.get(pass.len().saturating_sub(2)),
+    ) else {
+        return Err(GenError::Empty("a chamfer edge needs at least two points".into()));
+    };
+    let entry_air = air_side(tangent(first, second)?, p.climb);
+    let exit_air = air_side(tangent(before_last, last)?, p.climb);
+    let mut ride = Vec::with_capacity(pass.len() + 2);
+    ride.push(Point2::new(
+        first.x + entry_air.x * p.width,
+        first.y + entry_air.y * p.width,
+    ));
+    ride.extend_from_slice(pass);
+    ride.push(Point2::new(
+        last.x + exit_air.x * p.width,
+        last.y + exit_air.y * p.width,
+    ));
+    if p.minimum_cone_radius > 0.0 {
+        let swept = Region::sweep(&[ride.clone()], 1e-3).map_err(GenError::Geo)?;
+        for (z, region) in levels {
+            let hit = swept.intersect(region).map_err(GenError::Geo)?;
+            if !hit.is_empty()
+                && let Some(q) = hit.loops().first().and_then(|l| l.points().first())
+            {
+                return Err(GenError::invalid_at(
+                    format!(
+                        "the tip offset reaches selected-model material on the air side at Z {z:.3} near ({:.3}, {:.3}); pick a smaller offset or a different Side",
+                        q.x, q.y
+                    ),
+                    Point3::new(q.x, q.y, *z),
+                ));
+            }
+        }
+    }
+    Ok(ride)
+}
+
+fn tangent(a: Point2, b: Point2) -> Result<Point2, GenError> {
+    let len = (b.x - a.x).hypot(b.y - a.y);
+    if !len.is_finite() || len <= 1e-9 {
+        return Err(GenError::Empty(
+            "a chamfer edge holds a collapsed segment - re-pick the edge".into(),
+        ));
+    }
+    Ok(Point2::new((b.x - a.x) / len, (b.y - a.y) / len))
+}
diff --git a/crates/motion/src/machining2d/chamfer_lead_check.rs b/crates/motion/src/machining2d/chamfer_lead_check.rs
new file mode 100644
index 0000000000..32ebde32e0
--- /dev/null
+++ b/crates/motion/src/machining2d/chamfer_lead_check.rs
@@ -0,0 +1,294 @@
+//! Chamfer lead's exact cone/body adapter to the existing solid verifier.
+//!
+//! Provenance: this module only adapts lead moves and the Chamfer seam
+//! allowance to `verify::solid_hits` / `stack_hits`; the assembly sweep,
+//! cone profile and mesh law stay in `camcraft-sim`.
+
+use crate::cl::{MoveKind, PathBuilder};
+use crate::geo2d::Point2;
+use crate::geometry::{Point3, Triangle};
+use crate::verify::{Cutter, SolidLaw, Warning, solid_hits, stack_hits};
+
+use super::arcs::{Seg, push_segs};
+use super::chamfer::ChamferParams;
+use super::contour::Lead;
+
+/// Exact verification inputs for a requested Chamfer lead. The verifier
+/// sweeps the cone, flute, shank, modelled body and holder; no radius
+/// approximation is introduced here.
+#[derive(Clone, Copy, Debug)]
+pub struct ChamferLeadSafety<'a> {
+    facets: &'a [Triangle],
+    cutter: &'a Cutter,
+    law: SolidLaw,
+}
+
+impl<'a> ChamferLeadSafety<'a> {
+    #[must_use]
+    pub fn new(facets: &'a [Triangle], cutter: &'a Cutter, law: SolidLaw) -> Self {
+        Self { facets, cutter, law }
+    }
+}
+
+pub(super) struct LeadProbe<'a> {
+    pub path: &'a [Point2],
+    pub entry: Point2,
+    pub segs_in: &'a [Seg],
+    pub segs_out: &'a [Seg],
+    pub shaped_in: Lead,
+    pub shaped_out: Lead,
+}
+
+pub(super) fn full_tool_holds(
+    candidate: LeadProbe<'_>,
+    p: &ChamferParams,
+    safety: Option<&ChamferLeadSafety<'_>>,
+) -> Result<(), String> {
+    if candidate.shaped_in.size() == 0.0 && candidate.shaped_out.size() == 0.0 {
+        return Ok(());
+    }
+    let safety = safety.ok_or_else(|| {
+        "the selected model and complete cutter were not supplied for full lead collision checking"
+            .to_owned()
+    })?;
+    if candidate.shaped_in.size() > 0.0 {
+        let Some(&next) = candidate.path.get(1) else {
+            return Err("the lead-in has no cut transition".into());
+        };
+        let mut b = PathBuilder::new(Point3::new(
+            candidate.entry.x,
+            candidate.entry.y,
+            p.clearance_z,
+        ));
+        b.push(
+            MoveKind::Plunge,
+            Point3::new(candidate.entry.x, candidate.entry.y, p.tip_z()),
+            Some(p.plunge_feed),
+        );
+        let terminal = push_checked_lead(
+            &mut b,
+            candidate.segs_in,
+            p.tip_z(),
+            p.feed,
+            p.minimum_cone_radius + p.width,
+            SeamEnd::AtEnd,
+        );
+        let cut_move = b.moves_len();
+        push_segs(&mut b, &[Seg::Line(vec![next])], p.tip_z(), p.feed);
+        let mut exempt = vec![cut_move];
+        if let Some(at) = terminal {
+            exempt.push(at);
+        }
+        verify_probe(&b.finish(), safety, &exempt)?;
+    }
+    if candidate.shaped_out.size() > 0.0 {
+        let Some(&before_last) =
+            candidate.path.get(candidate.path.len().saturating_sub(2))
+        else {
+            return Err("the lead-out has no cut transition".into());
+        };
+        let Some(&last) = candidate.path.last() else {
+            return Err("the lead-out has no selected endpoint".into());
+        };
+        let mut b = PathBuilder::new(Point3::new(before_last.x, before_last.y, p.tip_z()));
+        push_segs(&mut b, &[Seg::Line(vec![last])], p.tip_z(), p.feed);
+        let terminal = push_checked_lead(
+            &mut b,
+            candidate.segs_out,
+            p.tip_z(),
+            p.feed,
+            p.minimum_cone_radius + p.width,
+            SeamEnd::AtStart,
+        );
+        let mut exempt = vec![0];
+        if let Some(at) = terminal {
+            exempt.push(at);
+        }
+        verify_probe(&b.finish(), safety, &exempt)?;
+    }
+    Ok(())
+}
+
+fn verify_probe(
+    path: &crate::cl::Toolpath,
+    safety: &ChamferLeadSafety<'_>,
+    exempt_gouges: &[usize],
+) -> Result<(), String> {
+    for warning in solid_hits(path, safety.facets, safety.cutter, &safety.law) {
+        if matches!(warning, Warning::Gouge { at } if exempt_gouges.contains(&at)) {
+            continue;
+        }
+        if matches!(warning, Warning::ShankHit { .. } | Warning::RapidInPart { .. }) {
+            return Err(format!("full body collision: {warning}"));
+        }
+        return Err(format!("full cone collision: {warning}"));
+    }
+    if let Some(warning) =
+        stack_hits(path, safety.facets, safety.cutter, &safety.law)
+            .into_iter()
+            .next()
+    {
+        return Err(format!("full body collision: {warning}"));
+    }
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum SeamEnd {
+    AtStart,
+    AtEnd,
+}
+
+/// Keep the full shape, but isolate its cone-contact piece as an exact,
+/// shorter line or arc move. Only that seam piece and the selected cut
+/// transition may enter the authored chamfer volume.
+fn push_checked_lead(
+    b: &mut PathBuilder,
+    segs: &[Seg],
+    z: f64,
+    feed: f64,
+    contact: f64,
+    seam: SeamEnd,
+) -> Option<usize> {
+    match seam {
+        SeamEnd::AtStart => push_checked_lead_start(b, segs, z, feed, contact),
+        SeamEnd::AtEnd => push_checked_lead_end(b, segs, z, feed, contact),
+    }
+}
+
+fn push_checked_lead_start(
+    b: &mut PathBuilder,
+    segs: &[Seg],
+    z: f64,
+    feed: f64,
+    contact: f64,
+) -> Option<usize> {
+    let (first, after) = segs.split_first()?;
+    match first {
+        Seg::Line(points) => {
+            let (&to, after_points) = points.split_first()?;
+            let from = Point2::new(b.at().x, b.at().y);
+            let d = (to.x - from.x).hypot(to.y - from.y);
+            let at = b.moves_len();
+            if d > contact && contact > 0.0 {
+                let join = Point2::new(
+                    from.x + (to.x - from.x) * contact / d,
+                    from.y + (to.y - from.y) * contact / d,
+                );
+                b.push(MoveKind::Feed, Point3::new(join.x, join.y, z), Some(feed));
+                b.push(MoveKind::Feed, Point3::new(to.x, to.y, z), Some(feed));
+            } else {
+                b.push(MoveKind::Feed, Point3::new(to.x, to.y, z), Some(feed));
+            }
+            if !after_points.is_empty() {
+                push_segs(b, &[Seg::Line(after_points.to_vec())], z, feed);
+            }
+            push_segs(b, after, z, feed);
+            Some(at)
+        }
+        Seg::Arc { center, ccw, to } => {
+            let from = Point2::new(b.at().x, b.at().y);
+            let radius = (from.x - center.x).hypot(from.y - center.y);
+            let a0 = (from.y - center.y).atan2(from.x - center.x);
+            let a1 = (to.y - center.y).atan2(to.x - center.x);
+            let sweep = if *ccw {
+                (a1 - a0).rem_euclid(std::f64::consts::TAU)
+            } else {
+                (a0 - a1).rem_euclid(std::f64::consts::TAU)
+            };
+            let length = radius * sweep;
+            let at = b.moves_len();
+            if length > contact && radius > 0.0 && contact > 0.0 {
+                let direction = if *ccw { 1.0 } else { -1.0 };
+                let join_angle = a0 + direction * contact / radius;
+                let join = Point2::new(
+                    center.x + radius * join_angle.cos(),
+                    center.y + radius * join_angle.sin(),
+                );
+                b.push_arc(
+                    MoveKind::Feed,
+                    Point3::new(join.x, join.y, z),
+                    Some(feed),
+                    *center,
+                    *ccw,
+                );
+            }
+            b.push_arc(
+                MoveKind::Feed,
+                Point3::new(to.x, to.y, z),
+                Some(feed),
+                *center,
+                *ccw,
+            );
+            push_segs(b, after, z, feed);
+            Some(at)
+        }
+    }
+}
+
+fn push_checked_lead_end(
+    b: &mut PathBuilder,
+    segs: &[Seg],
+    z: f64,
+    feed: f64,
+    contact: f64,
+) -> Option<usize> {
+    let (last, before) = segs.split_last()?;
+    push_segs(b, before, z, feed);
+    match last {
+        Seg::Line(points) => {
+            let (&to, before_points) = points.split_last()?;
+            if !before_points.is_empty() {
+                push_segs(b, &[Seg::Line(before_points.to_vec())], z, feed);
+            }
+            let from = Point2::new(b.at().x, b.at().y);
+            let d = (to.x - from.x).hypot(to.y - from.y);
+            if d > contact && contact > 0.0 {
+                let join = Point2::new(
+                    to.x - (to.x - from.x) * contact / d,
+                    to.y - (to.y - from.y) * contact / d,
+                );
+                b.push(MoveKind::Feed, Point3::new(join.x, join.y, z), Some(feed));
+            }
+            let at = b.moves_len();
+            b.push(MoveKind::Feed, Point3::new(to.x, to.y, z), Some(feed));
+            (b.moves_len() > at).then_some(at)
+        }
+        Seg::Arc { center, ccw, to } => {
+            let from = Point2::new(b.at().x, b.at().y);
+            let radius = (from.x - center.x).hypot(from.y - center.y);
+            let a0 = (from.y - center.y).atan2(from.x - center.x);
+            let a1 = (to.y - center.y).atan2(to.x - center.x);
+            let sweep = if *ccw {
+                (a1 - a0).rem_euclid(std::f64::consts::TAU)
+            } else {
+                (a0 - a1).rem_euclid(std::f64::consts::TAU)
+            };
+            let length = radius * sweep;
+            if length > contact && radius > 0.0 && contact > 0.0 {
+                let direction = if *ccw { 1.0 } else { -1.0 };
+                let join_angle = a1 - direction * contact / radius;
+                let join = Point2::new(
+                    center.x + radius * join_angle.cos(),
+                    center.y + radius * join_angle.sin(),
+                );
+                b.push_arc(
+                    MoveKind::Feed,
+                    Point3::new(join.x, join.y, z),
+                    Some(feed),
+                    *center,
+                    *ccw,
+                );
+            }
+            let at = b.moves_len();
+            b.push_arc(
+                MoveKind::Feed,
+                Point3::new(to.x, to.y, z),
+                Some(feed),
+                *center,
+                *ccw,
+            );
+            (b.moves_len() > at).then_some(at)
+        }
+    }
+}
diff --git a/crates/motion/src/machining2d/chamfer_open.rs b/crates/motion/src/machining2d/chamfer_open.rs
