diff --git a/crates/pathkernel/tests/laws/guide_kit.rs b/crates/pathkernel/tests/laws/guide_kit.rs
new file mode 100644
index 000000000..ff8e0b444
--- /dev/null
+++ b/crates/pathkernel/tests/laws/guide_kit.rs
@@ -0,0 +1,130 @@
+//! Shared builders of the guide planner pins (#4176): regions through the
+//! public `region` stage and the measures that the pins read.
+
+use camcraft_pathkernel::guide::{Curve, GuideSet, Mark, MarkKind, Span};
+use camcraft_pathkernel::{Bounds, KernelRegion, MaterialSide, Point2, Region, Selection, ToolShape, WorkPlane, region};
+
+pub fn p(x: f64, y: f64) -> Point2 {
+    Point2::new(x, y)
+}
+
+/// The counter-clockwise polygon of `n` points on a circle.
+pub fn circle(cx: f64, cy: f64, r: f64, n: usize) -> Vec<Point2> {
+    (0..n)
+        .map(|i| {
+            let a = std::f64::consts::TAU * i as f64 / n as f64;
+            p(cx + r * a.cos(), cy + r * a.sin())
+        })
+        .collect()
+}
+
+pub fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Vec<Point2> {
+    vec![p(x0, y0), p(x1, y0), p(x1, y1), p(x0, y1)]
+}
+
+pub fn tool(r: f64) -> ToolShape {
+    ToolShape::disc(r, 0.0, true, 30.0).unwrap()
+}
+
+pub fn xy() -> WorkPlane {
+    WorkPlane::setup_xy(0.0).unwrap()
+}
+
+/// A pocket (material inside) of one outline with holes, no stock.
+pub fn pocket(outer: Vec<Point2>, holes: Vec<Vec<Point2>>, r: f64) -> KernelRegion {
+    let sel = Selection::face(outer, holes).unwrap();
+    let b = Bounds::new(None, Region::empty(), 0.0, -5.0).unwrap();
+    region(&sel, MaterialSide::Inside, &b, xy(), tool(r), 0.0).unwrap()
+}
+
+/// The single outline of the union of some polygons.
+pub fn outline(parts: &[Vec<Point2>]) -> Vec<Point2> {
+    let mut u = Region::empty();
+    for q in parts {
+        u = u.union(&Region::new(vec![camcraft_pathkernel::Loop::new(q.clone()).unwrap()]).unwrap()).unwrap();
+    }
+    assert_eq!(u.loops().len(), 1, "one outline");
+    u.loops()[0].points().to_vec()
+}
+
+/// The material round a part (2D Offset round the part), in a stock.
+pub fn around(part: Vec<Point2>, stock: Vec<Point2>, r: f64) -> KernelRegion {
+    let sel = Selection::face(part, vec![]).unwrap();
+    let st = Region::new(vec![camcraft_pathkernel::Loop::new(stock).unwrap()]).unwrap();
+    let b = Bounds::new(Some(st), Region::empty(), 0.0, -5.0).unwrap();
+    region(&sel, MaterialSide::Outside, &b, xy(), tool(r), 0.0).unwrap()
+}
+
+pub fn center(r: &KernelRegion) -> &Region {
+    r.planar().unwrap().center()
+}
+
+/// The distance from `q` to the segment `a`-`b`.
+pub fn seg(q: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let l2 = dx * dx + dy * dy;
+    let t = if l2 > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+    (q.x - a.x - t * dx).hypot(q.y - a.y - t * dy)
+}
+
+/// The points of a curve in the plane.
+pub fn xy_of(c: &Curve) -> Vec<Point2> {
+    c.pts().iter().map(|q| q.at()).collect()
+}
+
+/// The segments of a curve (the closing one of a closed curve included).
+pub fn segs(c: &Curve) -> Vec<(Point2, Point2)> {
+    let v = xy_of(c);
+    let mut s: Vec<(Point2, Point2)> = v.windows(2).map(|w| (w[0], w[1])).collect();
+    if c.closed() {
+        s.push((v[v.len() - 1], v[0]));
+    }
+    s
+}
+
+/// The distance from `q` to the boundary of `r`.
+pub fn to_edge(r: &Region, q: Point2) -> f64 {
+    r.loops()
+        .iter()
+        .flat_map(|l| {
+            let v = l.points();
+            (0..v.len()).map(move |i| seg(q, v[i], v[(i + 1) % v.len()]))
+        })
+        .fold(f64::INFINITY, f64::min)
+}
+
+/// The distance from `q` to the nearest curve of `set`.
+pub fn to_set(set: &GuideSet, q: Point2) -> f64 {
+    set.curves().iter().flat_map(segs).map(|(a, b)| seg(q, a, b)).fold(f64::INFINITY, f64::min)
+}
+
+/// True when every point of every curve of `set` is in `area` or within
+/// `tol` of its boundary.
+pub fn all_inside(set: &GuideSet, area: &Region, tol: f64) -> bool {
+    set.curves().iter().flat_map(xy_of).all(|q| area.contains(q) || to_edge(area, q) <= tol)
+}
+
+/// The two sets have the same count and each curve of one is within `tol`
+/// of the same curve of the other, both ways (the law-1 measure).
+pub fn same_set(a: &GuideSet, b: &GuideSet, tol: f64) -> bool {
+    a.curves().len() == b.curves().len()
+        && a.curves().iter().zip(b.curves()).all(|(x, y)| {
+            x.k() == y.k()
+                && x.closed() == y.closed()
+                && xy_of(x).iter().all(|q| segs(y).iter().any(|(s, e)| seg(*q, *s, *e) <= tol))
+                && xy_of(y).iter().all(|q| segs(x).iter().any(|(s, e)| seg(*q, *s, *e) <= tol))
+        })
+}
+
+/// The marks of one kind.
+pub fn marks(set: &GuideSet, kind: MarkKind) -> Vec<&Mark> {
+    set.marks().iter().filter(|m| m.kind() == kind).collect()
+}
+
+/// The points of a marked stretch (all the curve's points for a whole mark).
+pub fn mark_pts(set: &GuideSet, m: &Mark) -> Vec<Point2> {
+    match m.span() {
+        Span::Whole => xy_of(&set.curves()[m.curve()]),
+        Span::Part(v) => v.iter().map(|q| q.at()).collect(),
+    }
+}
diff --git a/crates/pathkernel/tests/laws/guide_rings.rs b/crates/pathkernel/tests/laws/guide_rings.rs
new file mode 100644
index 000000000..2c4fa6b98
--- /dev/null
+++ b/crates/pathkernel/tests/laws/guide_rings.rs
@@ -0,0 +1,201 @@
+//! The ring guide planner (#4176, K2): the rings are the level sets of the
+//! distance to the walls, spaced by the choice's stepover; a full-width
+//! stretch is named (#3788); a small piece is kept; each refusal is named.
+
+use super::guide_kit::{around, center, circle, marks, mark_pts, outline, p, pocket, rect, same_set, to_edge, to_set, all_inside};
+use camcraft_pathkernel::guide::rings::{BAND_NOT_YET, CIRCLE_NOT_YET, NOT_RINGS, NO_RING, OFFSET_BELOW_CENTER, TOO_MANY_RINGS};
+use camcraft_pathkernel::guide::{
+    BAD_TOL, Circle, FAMILY_NOT_YET, Family, GuideChoice, GuidePlanner, GuideSet, Guides, MarkKind, RingPlanner, RingRef,
+    RingsChoice, RowsChoice, STEP_ABOVE_DIAMETER, Span,
+};
+use camcraft_pathkernel::{KernelRegion, Refusal, Verdict};
+
+const TOL: f64 = 1e-3;
+
+fn rings(reference: RingRef, first: f64, step: f64, count: Option<u32>) -> GuideChoice {
+    GuideChoice::Rings(RingsChoice::new(reference, first, step, None, count).unwrap())
+}
+
+fn plan(r: &KernelRegion, g: &GuideChoice) -> Verdict<GuideSet> {
+    RingPlanner.guide(r, g, TOL).unwrap()
+}
+
+fn done(v: &Verdict<GuideSet>) -> &GuideSet {
+    assert!(v.postable(), "a done verdict: {v:?}");
+    v.out().unwrap()
+}
+
+fn refused(r: Result<Verdict<GuideSet>, Refusal>) -> &'static str {
+    r.unwrap_err().reason()
+}
+
+/// A disc pocket of radius 20 with a tool of radius 3: the centre is a
+/// disc of radius 17.
+fn disc() -> KernelRegion {
+    pocket(circle(0.0, 0.0, 20.0, 256), vec![], 3.0)
+}
+
+/// Two lobes (radius 15, centres 50 mm apart) joined by a neck 8 mm wide.
+/// With a tool of radius 2 the neck of the centre is 4 mm wide: narrower
+/// than two steps of 3 mm.
+fn waist() -> KernelRegion {
+    let shape = outline(&[circle(-25.0, 0.0, 15.0, 192), circle(25.0, 0.0, 15.0, 192), rect(-12.0, -4.0, 12.0, 4.0)]);
+    pocket(shape, vec![], 2.0)
+}
+
+#[test]
+fn the_guide_stage_takes_no_start_side() {
+    // Laws 2 and 3 in the type system: a region, a guide choice and a
+    // tolerance; no start side, no order, no link.
+    type Stage = fn(&RingPlanner, &KernelRegion, &GuideChoice, f64) -> Result<Verdict<GuideSet>, Refusal>;
+    let _: Stage = <RingPlanner as GuidePlanner>::guide;
+}
+
+#[test]
+fn disc_rings_are_level_sets_spaced_by_the_stepover() {
+    let r = disc();
+    let set = plan(&r, &rings(RingRef::Boundary, 0.0, 4.0, None));
+    let set = done(&set);
+    // Radii 17, 13, 9, 5, 1: one closed ring each, index 0 to 4.
+    assert_eq!(set.curves().len(), 5);
+    for (k, c) in set.curves().iter().enumerate() {
+        assert_eq!((c.k() as usize, c.closed(), c.family()), (k, true, Family::Ring));
+        let worst = c.pts().iter().map(|q| (to_edge(center(&r), q.at()) - 4.0 * k as f64).abs()).fold(0.0, f64::max);
+        assert!(worst < 0.01, "ring {k} is 4 mm per index from the wall: off by {worst}");
+    }
+    assert!(all_inside(set, center(&r), TOL));
+    assert!(marks(set, MarkKind::Fill).is_empty(), "a step under the tool diameter covers the disc");
+}
+
+#[test]
+fn the_same_region_and_choice_give_the_same_curves_from_any_pick_order() {
+    let g = rings(RingRef::Boundary, 0.0, 4.0, None);
+    let a = plan(&disc(), &g);
+    let mut turned = circle(0.0, 0.0, 20.0, 256);
+    turned.rotate_left(77);
+    turned.reverse();
+    let b = plan(&pocket(turned, vec![], 3.0), &g);
+    assert!(same_set(a.out().unwrap(), b.out().unwrap(), TOL), "law 1: same curves within 1 um");
+    assert_eq!(plan(&disc(), &g), a, "law 1: a pure function");
+}
+
+#[test]
+fn part_and_boundary_rings_agree_where_there_is_no_stock_edge() {
+    let r = waist();
+    let a = plan(&r, &rings(RingRef::Boundary, 0.0, 3.0, None));
+    let b = plan(&r, &rings(RingRef::Part, 0.0, 3.0, None));
+    assert_eq!(a, b);
+}
+
+#[test]
+fn the_full_width_stretch_through_a_waist_is_named() {
+    let r = waist();
+    let v = plan(&r, &rings(RingRef::Boundary, 0.0, 3.0, None));
+    let set = done(&v);
+    // Ring 0 runs through the neck; ring 1 is one loop in each lobe. The
+    // two mouths of the neck, which neither ring 0 nor ring 1 reaches, get
+    // one clean-up ring each, with the index of ring 1.
+    let fills: Vec<usize> = marks(set, MarkKind::Fill).iter().map(|m| m.curve()).collect();
+    let regular = |k: u32| set.curves().iter().enumerate().filter(|(i, c)| c.k() == k && !fills.contains(i)).count();
+    assert_eq!((regular(0), regular(1)), (1, 2));
+    assert_eq!(fills.len(), 2);
+    for i in &fills {
+        let c = &set.curves()[*i];
+        assert_eq!(c.k(), 1);
+        assert!(c.pts().iter().all(|q| (q.at().x.abs() - 11.5).abs() < 1.0 && q.at().y.abs() < 2.0), "a clean-up ring in a mouth");
+    }
+    let wide = marks(set, MarkKind::FullWidth);
+    let named: Vec<_> = wide.iter().filter(|m| set.curves()[m.curve()].k() == 0 && matches!(m.span(), Span::Part(_))).collect();
+    // Each strand of ring 0 in the neck is one named stretch. It ends where
+    // the clean-up rings of the mouths come within the tool diameter.
+    assert_eq!(named.len(), 2, "each strand of ring 0 in the neck is one named stretch");
+    for m in &named {
+        let pts = mark_pts(set, m);
+        let (lo, hi) = pts.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), q| (a.min(q.x), b.max(q.x)));
+        assert!(lo < -6.0 && hi > 6.0, "the stretch runs along the neck to the mouths: x {lo} to {hi}");
+        assert!(pts.iter().all(|q| (q.y.abs() - 2.0).abs() < 0.05), "on a strand of the neck");
+        assert!(pts.iter().all(|q| q.x.abs() < 11.0), "the stretch stays in the neck: {:?}", pts.first());
+    }
+    // Far from the neck, ring 0 has ring 1 within the tool diameter: not named.
+    assert!(to_set(set, p(-37.0, 0.0)) < 1.0);
+    assert!(!named.iter().flat_map(|m| mark_pts(set, m)).any(|q| q.x < -20.0));
+}
+
+#[test]
+fn a_step_above_the_tool_radius_gets_clean_up_rings_and_covers_the_area() {
+    // Rings at depth 0, 6 and 12 leave the core of radius 5 uncut beyond 3 mm.
+    let r = disc();
+    let v = plan(&r, &rings(RingRef::Boundary, 0.0, 6.0, None));
+    let set = done(&v);
+    let fills = marks(set, MarkKind::Fill);
+    assert!(!fills.is_empty(), "the core gets a clean-up ring");
+    for m in fills {
+        let c = &set.curves()[m.curve()];
+        assert_eq!((c.k(), c.closed()), (3, true), "the clean-up ring sorts after the deepest ring");
+    }
+    assert!(all_inside(set, center(&r), TOL));
+}
+
+#[test]
+fn a_small_piece_of_the_area_is_kept() {
+    // A 6.1 mm square with a tool of radius 3 leaves a 0.1 mm square of
+    // centre (0.01 mm2): it is a ring, not dropped (the #2232 sliver drop
+    // is not ported).
+    let r = pocket(rect(0.0, 0.0, 40.0, 30.0), vec![], 3.0);
+    let small = pocket(rect(50.0, 0.0, 56.1, 6.1), vec![], 3.0);
+    let s = plan(&small, &rings(RingRef::Boundary, 0.0, 2.0, None));
+    let s = done(&s);
+    assert_eq!(s.curves().len(), 1);
+    assert!(s.curves()[0].pts().iter().all(|q| (q.at().x - 53.05).abs() < 0.06 && (q.at().y - 3.05).abs() < 0.06));
+    assert!(plan(&r, &rings(RingRef::Boundary, 0.0, 2.0, None)).postable());
+}
+
+#[test]
+fn a_ring_count_gives_that_many_rings_and_no_clean_up() {
+    let v = plan(&disc(), &rings(RingRef::Boundary, 0.0, 6.0, Some(1)));
+    let set = done(&v);
+    assert_eq!(set.curves().len(), 1);
+    assert!(marks(set, MarkKind::Fill).is_empty());
+}
+
+#[test]
+fn rings_round_a_part_end_at_the_stock_edge() {
+    // A 20 mm square part in a 60 by 40 stock, tool radius 4: the rings
+    // round the part are cut open where they meet the stock outline.
+    let r = around(rect(0.0, 0.0, 20.0, 20.0), rect(-20.0, -10.0, 40.0, 30.0), 4.0);
+    let v = plan(&r, &rings(RingRef::Part, 0.0, 2.0, None));
+    let set = done(&v);
+    assert!(set.curves().iter().any(|c| !c.closed()), "rings meet the stock edge");
+    assert!(set.curves().iter().any(|c| c.closed() && c.k() == 0), "the first ring goes round the part");
+    assert!(all_inside(set, center(&r), TOL));
+    // Within a tool radius of the stock outline the disc is in air: no
+    // full-width stretch there.
+    let off_air = |q: &camcraft_pathkernel::Point2| q.x > -16.0 - TOL && q.x < 36.0 + TOL && q.y > -6.0 - TOL && q.y < 26.0 + TOL;
+    assert!(marks(set, MarkKind::FullWidth).iter().flat_map(|m| mark_pts(set, m)).all(|q| off_air(&q)));
+}
+
+#[test]
+fn each_ring_refusal_is_named() {
+    let r = disc();
+    let row = GuideChoice::Rows(RowsChoice::new(0.0, 2.0, false).unwrap());
+    assert_eq!(refused(RingPlanner.guide(&r, &row, TOL)), NOT_RINGS);
+    let circ = Circle::new(p(0.0, 0.0), 17.0).unwrap();
+    let g = GuideChoice::Rings(RingsChoice::new(RingRef::Boundary, 0.0, 2.0, Some(circ), None).unwrap());
+    assert_eq!(refused(RingPlanner.guide(&r, &g, TOL)), CIRCLE_NOT_YET);
+    assert_eq!(refused(RingPlanner.guide(&r, &rings(RingRef::Band, 0.0, 2.0, None), TOL)), BAND_NOT_YET);
+    assert_eq!(refused(RingPlanner.guide(&r, &rings(RingRef::Boundary, -0.5, 2.0, None), TOL)), OFFSET_BELOW_CENTER);
+    assert_eq!(refused(RingPlanner.guide(&r, &rings(RingRef::Boundary, 18.0, 2.0, None), TOL)), NO_RING);
+    assert_eq!(refused(RingPlanner.guide(&r, &rings(RingRef::Boundary, 0.0, 6.5, None), TOL)), STEP_ABOVE_DIAMETER);
+    assert_eq!(refused(RingPlanner.guide(&r, &rings(RingRef::Boundary, 0.0, 1e-3, None), TOL)), TOO_MANY_RINGS);
+    for bad in [f64::NAN, 0.0, 1e-9, f64::INFINITY] {
+        assert_eq!(refused(RingPlanner.guide(&r, &rings(RingRef::Boundary, 0.0, 2.0, None), bad)), BAD_TOL);
+    }
+}
+
+#[test]
+fn the_guide_stage_sends_each_family_to_its_planner_or_refuses_it_by_name() {
+    let r = disc();
+    let g = rings(RingRef::Boundary, 0.0, 4.0, None);
+    assert_eq!(Guides.guide(&r, &g, TOL).unwrap(), plan(&r, &g));
+    assert_eq!(refused(Guides.guide(&r, &GuideChoice::Medial, TOL)), FAMILY_NOT_YET);
+}
diff --git a/crates/pathkernel/tests/laws/guide_rows.rs b/crates/pathkernel/tests/laws/guide_rows.rs
new file mode 100644
index 000000000..3e4e753e2
--- /dev/null
+++ b/crates/pathkernel/tests/laws/guide_rows.rs
@@ -0,0 +1,123 @@
+//! The row guide planner (#4176, K2): parallel rows at the angle, spaced
+//! at the stepover or less, clipped to the centre area; a closing ring on
+//! request; uncovered area named; each refusal named. Also the marks of a
+//! guide set: each mark is checked against its curve.
+
+use super::common::curve;
+use super::guide_kit::{all_inside, center, circle, marks, p, pocket, rect, same_set, xy_of};
+use camcraft_pathkernel::guide::mark::{BAD_STRETCH, MARK_NO_CURVE, MARK_OFF_CURVE};
+use camcraft_pathkernel::guide::rows::{NOT_ROWS, TOO_MANY_ROWS};
+use camcraft_pathkernel::guide::{
+    Family, GuideChoice, GuidePlanner, GuideSet, Mark, MarkKind, RingRef, RingsChoice, RowPlanner, RowsChoice,
+    STEP_ABOVE_DIAMETER,
+};
+use camcraft_pathkernel::{KernelRegion, PlanePoint, Refusal, Verdict};
+
+const TOL: f64 = 1e-3;
+
+fn rows(angle: f64, step: f64, closing: bool) -> GuideChoice {
+    GuideChoice::Rows(RowsChoice::new(angle, step, closing).unwrap())
+}
+
+fn plan(r: &KernelRegion, g: &GuideChoice) -> Verdict<GuideSet> {
+    RowPlanner.guide(r, g, TOL).unwrap()
+}
+
+fn refused(r: Result<Verdict<GuideSet>, Refusal>) -> &'static str {
+    r.unwrap_err().reason()
+}
+
+/// A 40 by 30 pocket with a tool of radius 3: the centre is 34 by 24.
+fn box_pocket() -> KernelRegion {
+    pocket(rect(0.0, 0.0, 40.0, 30.0), vec![], 3.0)
+}
+
+#[test]
+fn rows_run_at_the_angle_spaced_evenly_at_the_stepover_or_less() {
+    let r = box_pocket();
+    let v = plan(&r, &rows(0.0, 4.0, false));
+    assert!(v.postable(), "{v:?}");
+    let set = v.out().unwrap();
+    // 24 mm across at 4 mm: 7 rows on y = 3, 7, ... 27, each from x 3 to 37.
+    assert_eq!(set.curves().len(), 7);
+    for (i, c) in set.curves().iter().enumerate() {
+        let pts = xy_of(c);
+        assert_eq!((c.k() as usize, c.closed(), c.family(), pts.len()), (i, false, Family::Row, 2));
+        let y = 3.0 + 4.0 * i as f64;
+        assert!(pts.iter().all(|q| (q.y - y).abs() < 1e-6), "row {i} on y = {y}");
+        assert!((pts[0].x - 3.0).abs() < 1e-3 && (pts[1].x - 37.0).abs() < 1e-3, "row {i} spans the centre");
+    }
+    assert!(all_inside(set, center(&r), TOL));
+}
+
+#[test]
+fn rows_at_an_angle_with_a_closing_ring_cover_a_disc() {
+    let r = pocket(circle(0.0, 0.0, 20.0, 256), vec![], 3.0);
+    let v = plan(&r, &rows(30.0, 4.0, true));
+    assert!(v.postable(), "{v:?}");
+    let set = v.out().unwrap();
+    let (dx, dy) = (30f64.to_radians().cos(), 30f64.to_radians().sin());
+    for c in set.curves().iter().filter(|c| c.family() == Family::Row) {
+        let q = xy_of(c);
+        let (ux, uy) = (q[1].x - q[0].x, q[1].y - q[0].y);
+        assert!((ux * dy - uy * dx).abs() < 1e-6 * ux.hypot(uy), "each row runs at 30 degrees");
+    }
+    let closing = marks(set, MarkKind::Closing);
+    assert_eq!(closing.len(), 1);
+    let ring = &set.curves()[closing[0].curve()];
+    assert_eq!((ring.family(), ring.closed(), ring.k()), (Family::Ring, true, 0));
+    assert!(all_inside(set, center(&r), TOL));
+}
+
+#[test]
+fn rows_without_a_closing_ring_name_the_area_that_they_leave() {
+    // At a step of the tool diameter the caps of a disc between the row
+    // ends stay uncut: the result is incomplete with each gap named.
+    let r = pocket(circle(0.0, 0.0, 20.0, 256), vec![], 3.0);
+    let v = plan(&r, &rows(0.0, 6.0, false));
+    let Verdict::Incomplete { gaps, .. } = &v else { panic!("an incomplete verdict: {v:?}") };
+    let total: f64 = gaps.list().iter().map(|g| g.area_mm2()).sum();
+    assert!(total > 0.1, "the gaps are above the 0.1 mm2 guard: {total}");
+    let closed = plan(&r, &rows(0.0, 6.0, true));
+    assert!(closed.postable(), "the closing ring cuts the caps: {closed:?}");
+}
+
+#[test]
+fn the_same_region_and_choice_give_the_same_rows_from_any_pick_order() {
+    let g = rows(15.0, 3.0, true);
+    let a = plan(&box_pocket(), &g);
+    let mut turned = rect(0.0, 0.0, 40.0, 30.0);
+    turned.rotate_left(2);
+    turned.reverse();
+    let b = plan(&pocket(turned, vec![], 3.0), &g);
+    assert!(same_set(a.out().unwrap(), b.out().unwrap(), TOL), "law 1: same rows within 1 um");
+    assert_eq!(plan(&box_pocket(), &g), a);
+}
+
+#[test]
+fn each_row_refusal_is_named() {
+    let r = box_pocket();
+    let ring = GuideChoice::Rings(RingsChoice::new(RingRef::Boundary, 0.0, 2.0, None, None).unwrap());
+    assert_eq!(refused(RowPlanner.guide(&r, &ring, TOL)), NOT_ROWS);
+    assert_eq!(refused(RowPlanner.guide(&r, &rows(0.0, 6.5, false), TOL)), STEP_ABOVE_DIAMETER);
+    assert_eq!(refused(RowPlanner.guide(&r, &rows(0.0, 1e-4, false), TOL)), TOO_MANY_ROWS);
+}
+
+#[test]
+fn a_mark_is_checked_against_its_curve() {
+    let c = || curve(&[(0.0, 0.0), (10.0, 0.0), (10.0, 10.0)], true, 0, Family::Ring);
+    let on = |xy: &[(f64, f64)]| xy.iter().map(|&(x, y)| PlanePoint::flat(p(x, y)).unwrap()).collect::<Vec<_>>();
+    assert_eq!(Mark::part(0, MarkKind::FullWidth, on(&[(1.0, 0.0)])).unwrap_err().reason(), BAD_STRETCH);
+    assert_eq!(Mark::part(0, MarkKind::FullWidth, on(&[(1.0, 0.0), (1.0, 0.0)])).unwrap_err().reason(), BAD_STRETCH);
+    let off = Mark::part(0, MarkKind::FullWidth, on(&[(1.0, 0.0), (1.0, 0.5)])).unwrap();
+    assert_eq!(GuideSet::with_marks(vec![c()], vec![off]).unwrap_err().reason(), MARK_OFF_CURVE);
+    assert_eq!(GuideSet::with_marks(vec![c()], vec![Mark::whole(1, MarkKind::Fill)]).unwrap_err().reason(), MARK_NO_CURVE);
+    // A stretch on the closing segment is on the curve; the mark follows
+    // its curve into the canonical order.
+    let late = curve(&[(0.0, 5.0), (3.0, 5.0)], false, 4, Family::Ring);
+    let set = GuideSet::with_marks(vec![late, c()], vec![Mark::part(1, MarkKind::FullWidth, on(&[(8.0, 8.0), (5.0, 5.0)])).unwrap(), Mark::whole(0, MarkKind::Fill)]).unwrap();
+    assert_eq!(set.marks().len(), 2);
+    assert_eq!((set.marks()[0].curve(), set.marks()[0].kind()), (0, MarkKind::FullWidth));
+    assert_eq!((set.marks()[1].curve(), set.marks()[1].kind()), (1, MarkKind::Fill));
+    assert_eq!(set.curves()[1].k(), 4);
+}
