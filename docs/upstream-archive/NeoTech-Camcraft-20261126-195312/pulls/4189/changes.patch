@@ -0,0 +1,165 @@
+//! The shared parts of the guide planners (#4176): the checked inputs, the
+//! raw curves before they are checked, and the completeness guard of the
+//! record (#3744: the swept discs cover the cutter-centre area up to
+//! 0.1 mm2, else the result is incomplete with each gap named).
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 2: Guide curves"; the swept area of a disc as the Minkowski sum of
+//! a path and the disc (the published polygon-offsetting literature).
+
+use super::{Curve, Family, GuideSet};
+use crate::frame::PlanePoint;
+use crate::guide::mark::Mark;
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Gap, Note, Refusal, Stage, Verdict};
+use crate::{KERNEL_TOL, Loop, Point2, Region};
+
+/// Refusal reason: a guide tolerance that is not a finite number at or
+/// above the kernel tolerance.
+pub const BAD_TOL: &str = "the guide tolerance must be a finite number at or above the kernel tolerance";
+/// Refusal reason: a region that is not a planar area.
+pub const NOT_PLANAR: &str = "this guide planner plans only a planar region";
+/// Refusal reason: a polygon operation that cannot be computed.
+pub const GUIDE_GEOMETRY: &str = "the guide geometry cannot be computed: a value is out of range";
+/// Refusal reason: a stepover larger than the tool diameter.
+pub const STEP_ABOVE_DIAMETER: &str = "the stepover is larger than the tool diameter: material between two curves stays uncut";
+
+/// The largest flattening error (mm) of a round join of the polygon
+/// offset of `camcraft-geometry` (5 um): a swept disc can fall short of the
+/// true disc by this much.
+pub(crate) const ARC_SAG: f64 = 5e-3;
+/// The total uncovered area (mm2) that the completeness guard accepts
+/// (record "Stage 2": 0.1 mm2).
+pub(crate) const GUARD_AREA: f64 = 0.1;
+/// The area (mm2) under which an uncovered piece is polygon noise of the
+/// micron lattice, not a gap (one square micron).
+pub(crate) const NOISE_AREA: f64 = 1e-6;
+
+/// A curve before its checks: plane points at depth 0 and its index.
+#[derive(Clone, Debug)]
+pub(crate) struct Raw {
+    pub pts: Vec<Point2>,
+    pub closed: bool,
+    pub k: u32,
+}
+
+impl Raw {
+    /// The walk of the curve as an open path (a closed curve repeats its
+    /// first point at the end), for a sweep or a clip.
+    pub fn walk(&self) -> Vec<Point2> {
+        let mut w = self.pts.clone();
+        if self.closed
+            && let Some(&f) = self.pts.first()
+        {
+            w.push(f);
+        }
+        w
+    }
+}
+
+/// The planar region of `r`, or the refusal.
+pub(crate) fn planar(r: &KernelRegion) -> Result<&PlanarRegion, Refusal> {
+    r.planar().ok_or(Refusal::new(Stage::Guide, NOT_PLANAR))
+}
+
+/// The guide tolerance, checked.
+pub(crate) fn check_tol(tol: f64) -> Result<f64, Refusal> {
+    if tol.is_finite() && tol >= KERNEL_TOL { Ok(tol) } else { Err(Refusal::new(Stage::Guide, BAD_TOL)) }
+}
+
+/// The stepover, checked against the tool diameter.
+pub(crate) fn check_step(step: f64, tool_r: f64) -> Result<f64, Refusal> {
+    let limit = 2.0 * tool_r + KERNEL_TOL;
+    if step > limit { Err(Refusal::new(Stage::Guide, STEP_ABOVE_DIAMETER).fix("use a stepover of the tool diameter or less")) } else { Ok(step) }
+}
+
+/// A geometry result as a guide refusal.
+pub(crate) fn geo<T, E>(r: Result<T, E>) -> Result<T, Refusal> {
+    r.map_err(|_| Refusal::new(Stage::Guide, GUIDE_GEOMETRY))
+}
+
+/// The closed walks of loops, for a sweep.
+pub(crate) fn loop_walks(loops: &[Loop]) -> Vec<Vec<Point2>> {
+    loops.iter().map(|l| l.points().iter().chain(l.points().first()).copied().collect()).collect()
+}
+
+/// The area of `target` that the discs of radius `r` along `curves` do not
+/// cover, with `margin` for the polygon flattening.
+pub(crate) fn uncovered(target: &Region, curves: &[Raw], r: f64, margin: f64) -> Result<Region, Refusal> {
+    let walks: Vec<Vec<Point2>> = curves.iter().map(Raw::walk).collect();
+    geo(target.difference(&geo(Region::sweep(&walks, r + margin))?))
+}
+
+/// The pieces of a region: each outer loop with the holes inside it, as
+/// its own region, with its area (mm2), largest first; then by place.
+pub(crate) fn pieces(r: &Region) -> Result<Vec<(Region, f64)>, Refusal> {
+    let (outer, holes): (Vec<&Loop>, Vec<&Loop>) = r.loops().iter().partition(|l| l.area() > 0.0);
+    let mut out = Vec::with_capacity(outer.len());
+    for o in outer {
+        let shell = geo(Region::new(vec![o.clone()]))?;
+        let mine: Vec<Loop> = holes.iter().filter(|h| h.points().first().is_some_and(|p| shell.contains(*p))).map(|h| (*h).clone()).collect();
+        let mut loops = vec![o.clone()];
+        loops.extend(mine);
+        let piece = geo(Region::new(loops))?;
+        let area = piece.area();
+        out.push((piece, area));
+    }
+    out.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| low(&a.0).total_cmp(&low(&b.0))));
+    Ok(out)
+}
+
+/// A sort key of a region: the least y of its points.
+fn low(r: &Region) -> f64 {
+    r.loops().iter().flat_map(|l| l.points()).map(|p| p.y).fold(f64::INFINITY, f64::min)
+}
+
+/// The lowest point of a region (least y, then x): the place of a gap.
+pub(crate) fn lowest(r: &Region) -> Point2 {
+    r.loops().iter().flat_map(|l| l.points()).copied().min_by(|a, b| a.y.total_cmp(&b.y).then(a.x.total_cmp(&b.x))).unwrap_or_default()
+}
+
+/// The checked curves, their marks and the notes of [`finish`].
+pub(crate) type Finished = (Vec<Curve>, Vec<Mark>, Vec<Note>);
+
+/// The checked curves of the raw curves, with each mark moved to the index
+/// of its curve. A raw curve that the curve checks refuse (a piece below the
+/// kernel tolerance) is named in a note, never dropped silently.
+pub(crate) fn finish(raws: &[Raw], marks: Vec<(usize, Mark)>, family: impl Fn(&Raw) -> Family) -> Result<Finished, Refusal> {
+    let mut curves = Vec::with_capacity(raws.len());
+    let mut index = vec![None; raws.len()];
+    let mut notes = Vec::new();
+    for (i, raw) in raws.iter().enumerate() {
+        let pts: Result<Vec<PlanePoint>, Refusal> = raw.pts.iter().map(|p| PlanePoint::flat(*p)).collect();
+        match Curve::new(pts?, None, raw.closed, raw.k, family(raw)) {
+            Ok(c) => {
+                index[i] = Some(curves.len());
+                curves.push(c);
+            }
+            Err(e) => {
+                let at = raw.pts.first().copied().unwrap_or_default();
+                notes.push(Note::new(Stage::Guide, format!("a piece of curve {} at ({:.3}, {:.3}) is not a curve: {}", raw.k, at.x, at.y, e.reason()))?);
+            }
+        }
+    }
+    let marks = marks.into_iter().filter_map(|(i, m)| index.get(i).copied().flatten().map(|j| m.renumber(j))).collect();
+    Ok((curves, marks, notes))
+}
+
+/// The verdict of a guide set by the completeness guard: done when the
+/// uncovered area of `target` is at most [`GUARD_AREA`] (a remnant above
+/// the noise is named in a note); else incomplete with each gap named.
+pub(crate) fn judge(set: GuideSet, left: &Region, mut notes: Vec<Note>) -> Result<Verdict<GuideSet>, Refusal> {
+    let gaps: Vec<(Region, f64)> = pieces(left)?.into_iter().filter(|(_, a)| *a > NOISE_AREA).collect();
+    let total: f64 = gaps.iter().map(|(_, a)| a).sum();
+    if total > GUARD_AREA {
+        let list: Result<Vec<Gap>, Refusal> = gaps.iter().map(|(g, a)| Gap::new(*a, lowest(g))).collect();
+        let mut v = Verdict::incomplete(Stage::Guide, set, list?)?;
+        if let Verdict::Incomplete { notes: n, .. } = &mut v {
+            n.append(&mut notes);
+        }
+        return Ok(v);
+    }
+    if total > 0.0 {
+        notes.push(Note::new(Stage::Guide, format!("{} uncovered piece(s) of {total:.4} mm2 in all stay under the 0.1 mm2 guard", gaps.len()))?);
+    }
+    Ok(Verdict::Done { out: set, fallbacks: Vec::new(), notes })
+}
diff --git a/crates/pathkernel/src/guide/mark.rs b/crates/pathkernel/src/guide/mark.rs
new file mode 100644
index 000000000..62f5feeae
--- /dev/null
+++ b/crates/pathkernel/src/guide/mark.rs
@@ -0,0 +1,122 @@
+//! Named stretches of a guide set (#4176): a guide planner names a stretch
+//! that a later stage must act on, in place of a silent choice. The ring
+//! planner names a full-width stretch (#3788, the merge of two lobes) and
+//! a clean-up ring; the row planner names its closing ring.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 2: Guide curves" and the Prime Directive (a full-width cut is
+//! named, not hidden); `docs/decisions/4176-kernel-guides-rings-rows.md`.
+
+use std::cmp::Ordering;
+
+use super::{Curve, cmp_seq};
+use crate::frame::PlanePoint;
+use crate::verdict::{Refusal, Stage};
+use crate::{KERNEL_TOL, seg_dist};
+
+/// What a mark names.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+#[non_exhaustive]
+pub enum MarkKind {
+    /// The tool disc on this stretch overlaps the disc of no deeper curve
+    /// and no air: when the deeper curves are cut first, the tool cuts
+    /// here at full width (180 degrees). The load stage (K3) and the order
+    /// and link stage (K4) act on it.
+    FullWidth,
+    /// A clean-up ring: it cuts an area that the regular rings leave, so
+    /// that the swept discs cover the cutter-centre area.
+    Fill,
+    /// The closing ring that a row choice asks for.
+    Closing,
+}
+
+/// The part of a curve that a mark names.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Span {
+    /// The whole curve.
+    Whole,
+    /// A stretch of the curve: two or more points on it, in its direction.
+    Part(Vec<PlanePoint>),
+}
+
+/// A named stretch of curve `curve` of its guide set.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Mark {
+    curve: usize,
+    kind: MarkKind,
+    span: Span,
+}
+
+/// Refusal reason: a stretch with fewer than two points or no length.
+pub const BAD_STRETCH: &str = "a marked stretch needs two or more points and a length above the kernel tolerance";
+/// Refusal reason: a mark on a curve that the set does not have.
+pub const MARK_NO_CURVE: &str = "a mark names a curve that the guide set does not have";
+/// Refusal reason: a marked stretch with a point off its curve.
+pub const MARK_OFF_CURVE: &str = "a marked stretch has a point that is not on its curve";
+
+impl Mark {
+    /// A mark on the whole of curve `curve`.
+    #[must_use]
+    pub fn whole(curve: usize, kind: MarkKind) -> Self {
+        Self { curve, kind, span: Span::Whole }
+    }
+
+    /// A mark on a stretch of curve `curve`. Refused for fewer than two
+    /// points or a stretch with no length; [`super::GuideSet::with_marks`]
+    /// checks that each point is on the curve.
+    pub fn part(curve: usize, kind: MarkKind, pts: Vec<PlanePoint>) -> Result<Self, Refusal> {
+        let length: f64 = pts.windows(2).map(|w| (w[1].at().x - w[0].at().x).hypot(w[1].at().y - w[0].at().y)).sum();
+        if pts.len() < 2 || !length.is_finite() || length <= KERNEL_TOL {
+            return Err(Refusal::new(Stage::Guide, BAD_STRETCH));
+        }
+        Ok(Self { curve, kind, span: Span::Part(pts) })
+    }
+    /// The index of the marked curve in [`super::GuideSet::curves`].
+    #[must_use]
+    pub fn curve(&self) -> usize {
+        self.curve
+    }
+    #[must_use]
+    pub fn kind(&self) -> MarkKind {
+        self.kind
+    }
+    #[must_use]
+    pub fn span(&self) -> &Span {
+        &self.span
+    }
+
+    /// This mark on curve index `i` of a list that a planner builds.
+    pub(crate) fn renumber(self, i: usize) -> Self {
+        Self { curve: i, ..self }
+    }
+
+    /// This mark moved to curve index `i`, checked against that curve.
+    pub(super) fn onto(self, i: usize, c: &Curve) -> Result<Self, Refusal> {
+        if let Span::Part(pts) = &self.span
+            && !pts.iter().all(|p| on_curve(c, p))
+        {
+            return Err(Refusal::new(Stage::Guide, MARK_OFF_CURVE).at(pts.first().map_or_else(Default::default, PlanePoint::at)));
+        }
+        Ok(Self { curve: i, ..self })
+    }
+
+    /// The total order of the marks of a set: curve, kind, the whole curve
+    /// before a stretch, then the points.
+    pub(super) fn cmp_set(&self, o: &Self) -> Ordering {
+        self.curve.cmp(&o.curve).then(self.kind.cmp(&o.kind)).then_with(|| match (&self.span, &o.span) {
+            (Span::Whole, Span::Whole) => Ordering::Equal,
+            (Span::Whole, Span::Part(_)) => Ordering::Less,
+            (Span::Part(_), Span::Whole) => Ordering::Greater,
+            (Span::Part(a), Span::Part(b)) => cmp_seq(a, b),
+        })
+    }
+}
+
+/// True when `p` is on curve `c` (a segment of it, the closing one of a
+/// closed curve included) within [`KERNEL_TOL`] in place and depth.
+fn on_curve(c: &Curve, p: &PlanePoint) -> bool {
+    let pts = c.pts();
+    let close = c.closed().then(|| (pts.last(), pts.first()));
+    let segs = pts.windows(2).map(|w| (&w[0], &w[1])).chain(close.into_iter().filter_map(|(a, b)| a.zip(b)));
+    let flat = pts.iter().all(|q| (q.depth() - p.depth()).abs() <= KERNEL_TOL);
+    flat && segs.into_iter().any(|(a, b)| seg_dist(p.at(), a.at(), b.at()) <= KERNEL_TOL)
+}
diff --git a/crates/pathkernel/src/guide/rings.rs b/crates/pathkernel/src/guide/rings.rs
new file mode 100644
index 000000000..0f7aebb56
--- /dev/null
+++ b/crates/pathkernel/src/guide/rings.rs
@@ -0,0 +1,232 @@
+//! The ring guide (#4176, K2): contour-parallel rings as the level sets of
+//! the distance to the walls of the cutter-centre area, spaced by the
+//! choice's stepover, with clean-up rings where the regular rings leave an
+//! area uncut, and each full-width stretch named (#3788).
+//! Provenance: contour-parallel pocketing as level sets of the distance to
+//! the boundary, Held, "On the Computational Geometry of Pocket Machining"
+//! (1991), computed by the polygon offset of `camcraft-geometry`; our own
+//! design record `docs/decisions/4024-path-kernel-design.md` "Stage 2" and
+//! `docs/decisions/4176-kernel-guides-rings-rows.md`. Written new: no code
+//! path of the old ring planners of `camcraft-motion` is ported.
+
+use camcraft_geometry::geo2d::RingClip;
+
+use super::cover::{
+    ARC_SAG, Raw, check_step, check_tol, finish, geo, judge, loop_walks, pieces, planar, uncovered,
+};
+use super::mark::{Mark, MarkKind};
+use super::{Family, GuideChoice, GuidePlanner, GuideSet, RingRef, RingsChoice};
+use crate::frame::PlanePoint;
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Refusal, Stage, Verdict};
+use crate::{Loop, Point2, Region, in_area};
+
+/// Refusal reason: the ring planner was given another guide choice.
+pub const NOT_RINGS: &str = "the ring planner plans only a rings choice";
+/// Refusal reason: exact circle rings (Circular, Bore) are not planned yet.
+pub const CIRCLE_NOT_YET: &str = "exact circle rings are not planned yet: they come with the helix guide (#4176, second part)";
+/// Refusal reason: the band reference is not planned yet.
+pub const BAND_NOT_YET: &str = "the band ring reference is not planned yet: it comes with the order stage (K4, #3934)";
+/// Refusal reason: a first ring offset below zero.
+pub const OFFSET_BELOW_CENTER: &str = "a ring offset below zero puts the ring outside the cutter-centre area";
+/// Refusal reason: the first ring offset leaves no area.
+pub const NO_RING: &str = "the first ring offset leaves no area: there is no ring";
+/// Refusal reason: more rings than the planner makes.
+pub const TOO_MANY_RINGS: &str = "the area needs more rings than the planner makes (10000)";
+
+/// The most regular rings of one plan.
+const MAX_RINGS: u32 = 10_000;
+/// The most rounds of clean-up rings.
+const MAX_FILL_ROUNDS: u32 = 6;
+/// The area (mm2) from which an uncovered piece gets a clean-up ring: a
+/// square of 10 um. A smaller piece stays, named by the guard.
+const FILL_MIN: f64 = 1e-4;
+
+/// The ring guide planner. It reads only the region and the rings choice:
+/// no start side, no order, no link (laws 2 and 3).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RingPlanner;
+
+impl GuidePlanner for RingPlanner {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Rings(c) = g else {
+            return Err(Refusal::new(Stage::Guide, NOT_RINGS));
+        };
+        plan(planar(r)?, c, check_tol(tol)?)
+    }
+}
+
+/// The distance field whose level sets are the rings.
+enum Field {
+    /// The distance to every edge of the area: the erosion of the area.
+    Boundary,
+    /// The distance to the part walls only; the stretches on the stock edge
+    /// (`edge`, a thin band round it) are not rings.
+    Part { walls: Vec<Vec<Point2>>, edge: Region },
+}
+
+impl Field {
+    fn new(p: &PlanarRegion, reference: RingRef, tol: f64) -> Result<Self, Refusal> {
+        if reference == RingRef::Boundary || p.stock_edge().is_empty() {
+            return Ok(Self::Boundary);
+        }
+        Ok(Self::Part { walls: loop_walks(p.part_walls()), edge: geo(Region::sweep(&loop_walks(p.stock_edge()), tol))? })
+    }
+
+    /// The area at distance `d` or more from the reference walls.
+    fn level(&self, center: &Region, d: f64) -> Result<Region, Refusal> {
+        if d <= 0.0 {
+            return Ok(center.clone());
+        }
+        match self {
+            Self::Boundary => geo(center.offset(-d)),
+            Self::Part { walls, .. } => geo(center.difference(&geo(Region::sweep(walls, d))?)),
+        }
+    }
+
+    /// The rings of index `k` on the boundary of a level area.
+    fn rings(&self, level: &Region, k: u32) -> Result<Vec<Raw>, Refusal> {
+        let mut out = Vec::new();
+        for l in level.loops() {
+            let pts = l.points().to_vec();
+            match self {
+                Self::Boundary => out.push(Raw { pts, closed: true, k }),
+                Self::Part { edge, .. } => match geo(edge.clip_ring(&pts, false))? {
+                    RingClip::Whole => out.push(Raw { pts, closed: true, k }),
+                    RingClip::Pieces(ps) => out.extend(ps.into_iter().filter(|s| s.len() >= 2).map(|s| Raw { pts: s, closed: false, k })),
+                },
+            }
+        }
+        Ok(out)
+    }
+}
+
+fn plan(p: &PlanarRegion, c: &RingsChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    if c.circle().is_some() {
+        return Err(Refusal::new(Stage::Guide, CIRCLE_NOT_YET));
+    }
+    if c.reference() == RingRef::Band {
+        return Err(Refusal::new(Stage::Guide, BAND_NOT_YET));
+    }
+    let rad = p.tool().radius();
+    let step = check_step(c.stepover(), rad)?;
+    let d0 = c.first_offset();
+    if d0 < 0.0 {
+        return Err(Refusal::new(Stage::Guide, OFFSET_BELOW_CENTER));
+    }
+    let reach = p.center().bounds().map_or(0.0, |(lo, hi)| (hi.x - lo.x).hypot(hi.y - lo.y));
+    if (reach - d0) / step > f64::from(MAX_RINGS) {
+        return Err(Refusal::new(Stage::Guide, TOO_MANY_RINGS).fix("use a larger stepover"));
+    }
+    let margin = tol + ARC_SAG;
+    let field = Field::new(p, c.reference(), tol)?;
+    let (mut raws, levels) = regular(p.center(), &field, d0, step, c.count())?;
+    if raws.is_empty() {
+        return Err(Refusal::new(Stage::Guide, NO_RING).fix("use a smaller first offset"));
+    }
+    let mut marks = Vec::new();
+    // A ring count asks for that many rings, not for a cleared area: the
+    // guard and the clean-up rings apply to a choice without a count.
+    let left = match c.count() {
+        None => {
+            let target = if d0 > rad { geo(p.center().offset(rad - d0))? } else { p.center().clone() };
+            fill(&target, &levels, &mut raws, &mut marks, rad.min(step), (rad, margin))?
+        }
+        Some(_) => Region::empty(),
+    };
+    full_width(p, &raws, &mut marks, rad, (margin, tol))?;
+    let (curves, marks, notes) = finish(&raws, marks, |_| Family::Ring)?;
+    judge(GuideSet::with_marks(curves, marks)?, &left, notes)
+}
+
+/// The regular rings, level by level from the first offset, and the level
+/// areas (nested, the first one outermost).
+fn regular(center: &Region, field: &Field, d0: f64, step: f64, count: Option<u32>) -> Result<(Vec<Raw>, Vec<Region>), Refusal> {
+    let (mut raws, mut levels) = (Vec::new(), Vec::new());
+    for k in 0u32.. {
+        if count.is_some_and(|n| k >= n) {
+            break;
+        }
+        if k >= MAX_RINGS {
+            return Err(Refusal::new(Stage::Guide, TOO_MANY_RINGS).fix("use a larger stepover"));
+        }
+        let level = field.level(center, d0 + f64::from(k) * step)?;
+        if level.is_empty() {
+            break;
+        }
+        raws.extend(field.rings(&level, k)?);
+        levels.push(level);
+    }
+    Ok((raws, levels))
+}
+
+/// Adds clean-up rings until the discs cover `target`, at most
+/// [`MAX_FILL_ROUNDS`] rounds; returns the area that stays uncovered. A
+/// clean-up ring of an uncovered piece is the boundary of the piece eroded
+/// by half of `inset` (the piece itself when it is thinner).
+fn fill(target: &Region, levels: &[Region], raws: &mut Vec<Raw>, marks: &mut Vec<(usize, Mark)>, inset: f64, (rad, margin): (f64, f64)) -> Result<Region, Refusal> {
+    for _ in 0..MAX_FILL_ROUNDS {
+        let left = uncovered(target, raws, rad, margin)?;
+        let big: Vec<Region> = pieces(&left)?.into_iter().filter(|(_, a)| *a >= FILL_MIN).map(|(g, _)| g).collect();
+        if big.is_empty() {
+            return Ok(left);
+        }
+        for g in big {
+            let core = geo(g.offset(-0.5 * inset))?;
+            let src = if core.is_empty() { &g } else { &core };
+            for l in src.loops() {
+                marks.push((raws.len(), Mark::whole(0, MarkKind::Fill)));
+                raws.push(Raw { pts: l.points().to_vec(), closed: true, k: fill_index(l, levels) });
+            }
+        }
+    }
+    uncovered(target, raws, rad, margin)
+}
+
+/// The index of a clean-up ring: one more than the deepest level area that
+/// holds all of it, so that it sorts with the next deeper rings.
+fn fill_index(l: &Loop, levels: &[Region]) -> u32 {
+    let deepest = levels.iter().rposition(|lv| l.points().iter().all(|p| in_area(lv, *p)));
+    deepest.map_or(0, |j| u32::try_from(j).map_or(u32::MAX, |j| j.saturating_add(1)))
+}
+
+/// Names each full-width stretch: a stretch of a curve of index `k` whose
+/// tool disc overlaps no disc of a curve of index `k + 1` (the next deeper
+/// curves; a deeper curve is farther, behind them) and no air beyond the
+/// stock edge. When the deeper curves are cut first, the tool cuts there
+/// at full width (#3788: the strands of a ring through the neck between two
+/// lobes). A crumb of `tol` or less where the test is tangent is no stretch.
+fn full_width(p: &PlanarRegion, raws: &[Raw], marks: &mut Vec<(usize, Mark)>, rad: f64, (margin, tol): (f64, f64)) -> Result<(), Refusal> {
+    let air = if p.stock_edge().is_empty() { Region::empty() } else { geo(Region::sweep(&loop_walks(p.stock_edge()), rad))? };
+    let Some(top) = raws.iter().map(|r| r.k).max() else {
+        return Ok(());
+    };
+    for k in 0..=top {
+        let deeper: Vec<Vec<Point2>> = raws.iter().filter(|r| r.k == k.saturating_add(1)).map(Raw::walk).collect();
+        let near = if deeper.is_empty() { Region::empty() } else { geo(Region::sweep(&deeper, 2.0 * rad + margin))? };
+        let reach = if air.is_empty() { near } else { geo(near.union(&air))? };
+        for (i, raw) in raws.iter().enumerate().filter(|(_, r)| r.k == k) {
+            let stretches = if raw.closed {
+                match geo(reach.clip_ring(&raw.pts, false))? {
+                    RingClip::Whole => {
+                        marks.push((i, Mark::whole(0, MarkKind::FullWidth)));
+                        continue;
+                    }
+                    RingClip::Pieces(ps) => ps,
+                }
+            } else {
+                geo(reach.clip_polyline(&raw.pts, false))?
+            };
+            for s in stretches.into_iter().filter(|s| length(s) > tol) {
+                let pts: Result<Vec<PlanePoint>, Refusal> = s.into_iter().map(PlanePoint::flat).collect();
+                marks.push((i, Mark::part(0, MarkKind::FullWidth, pts?)?));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The length of a polyline.
+pub(crate) fn length(pts: &[Point2]) -> f64 {
+    pts.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum()
+}
diff --git a/crates/pathkernel/src/guide/rows.rs b/crates/pathkernel/src/guide/rows.rs
new file mode 100644
index 000000000..21a359b58
--- /dev/null
+++ b/crates/pathkernel/src/guide/rows.rs
@@ -0,0 +1,97 @@
+//! The row guide (#4176, K2): parallel rows at the choice's angle, spaced
+//! evenly at the stepover or less across the cutter-centre area and
+//! clipped to it, for Face and Zigzag; with the area's boundary as a
+//! closing ring when the choice asks for one.
+//! Provenance: direction-parallel (zigzag) area clearing as in Held, "On
+//! the Computational Geometry of Pocket Machining" (1991); the clip of a
+//! line by a polygon from the published computer-graphics literature
+//! (`Region::clip_polyline` of `camcraft-geometry`); our own design record
+//! `docs/decisions/4024-path-kernel-design.md` "Stage 2" and
+//! `docs/decisions/4176-kernel-guides-rings-rows.md`. Written new: no code
+//! path of the old Face and Zigzag planners of `camcraft-motion` is ported.
+
+use super::cover::{ARC_SAG, Raw, check_step, check_tol, finish, geo, judge, planar, uncovered};
+use super::mark::{Mark, MarkKind};
+use super::rings::length;
+use super::{Family, GuideChoice, GuidePlanner, GuideSet, RowsChoice};
+use crate::region::{KernelRegion, PlanarRegion};
+use crate::verdict::{Note, Refusal, Stage, Verdict};
+use crate::Point2;
+
+/// Refusal reason: the row planner was given another guide choice.
+pub const NOT_ROWS: &str = "the row planner plans only a rows choice";
+/// Refusal reason: more rows than the planner makes.
+pub const TOO_MANY_ROWS: &str = "the area needs more rows than the planner makes (100000)";
+
+/// The most rows of one plan.
+const MAX_ROWS: f64 = 100_000.0;
+
+/// The row guide planner. It reads only the region and the rows choice: no
+/// start side, no order, no link (laws 2 and 3). Each row piece is an open
+/// curve of family `Row` with the index of its row; the closing ring is of
+/// family `Ring`, index 0, marked [`MarkKind::Closing`].
+#[derive(Clone, Copy, Debug, Default)]
+pub struct RowPlanner;
+
+impl GuidePlanner for RowPlanner {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Rows(c) = g else {
+            return Err(Refusal::new(Stage::Guide, NOT_ROWS));
+        };
+        plan(planar(r)?, c, check_tol(tol)?)
+    }
+}
+
+fn plan(p: &PlanarRegion, c: &RowsChoice, tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+    let rad = p.tool().radius();
+    let step = check_step(c.stepover(), rad)?;
+    let (s, co) = c.angle().to_radians().sin_cos();
+    let (u, n) = ((co, s), (-s, co));
+    let center = p.center();
+    let pts: Vec<Point2> = center.loops().iter().flat_map(|l| l.points()).copied().collect();
+    let Some((lo, hi)) = center.bounds() else {
+        return Err(Refusal::new(Stage::Guide, crate::region::EMPTY_CENTER));
+    };
+    // Coordinates about the middle of the area keep the row math small.
+    let mid = Point2::new(0.5 * (lo.x + hi.x), 0.5 * (lo.y + hi.y));
+    let along = |q: &Point2, d: (f64, f64)| (q.x - mid.x) * d.0 + (q.y - mid.y) * d.1;
+    let (vmin, vmax) = pts.iter().map(|q| along(q, n)).fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), v| (a.min(v), b.max(v)));
+    let half = 1.0 + (hi.x - lo.x).hypot(hi.y - lo.y);
+    let span = vmax - vmin;
+    let gaps = (span / step).ceil().max(1.0);
+    if !gaps.is_finite() || gaps > MAX_ROWS {
+        return Err(Refusal::new(Stage::Guide, TOO_MANY_ROWS).fix("use a larger stepover"));
+    }
+    // The rows run on the boundary at the two extremes, so that a wall
+    // parallel to the rows is cut; the clip area is the centre grown by a
+    // quarter of the tolerance, so that a row on the boundary is kept.
+    let clip = geo(center.offset(0.25 * tol))?;
+    let mut raws = Vec::new();
+    let mut crumbs = 0usize;
+    let count = gaps as u32;
+    for i in 0..=count {
+        let v = if i == count { vmax } else { vmin + f64::from(i) * span / gaps };
+        let at = |t: f64| Point2::new(mid.x + v * n.0 + t * u.0, mid.y + v * n.1 + t * u.1);
+        for piece in geo(clip.clip_polyline(&[at(-half), at(half)], true))? {
+            if length(&piece) < tol {
+                crumbs += 1;
+            } else {
+                raws.push(Raw { pts: piece, closed: false, k: i });
+            }
+        }
+    }
+    let mut marks = Vec::new();
+    if c.closing_ring() {
+        for l in center.loops() {
+            marks.push((raws.len(), Mark::whole(0, MarkKind::Closing)));
+            raws.push(Raw { pts: l.points().to_vec(), closed: true, k: 0 });
+        }
+    }
+    let left = uncovered(center, &raws, rad, tol + ARC_SAG)?;
+    let (curves, marks, mut notes) = finish(&raws, marks, |r| if r.closed { Family::Ring } else { Family::Row })?;
+    if crumbs > 0 {
+        let text = format!("{crumbs} row piece(s) shorter than the tolerance touch the area at one point and are not rows");
+        notes.push(Note::new(Stage::Guide, text)?);
+    }
+    judge(GuideSet::with_marks(curves, marks)?, &left, notes)
+}
