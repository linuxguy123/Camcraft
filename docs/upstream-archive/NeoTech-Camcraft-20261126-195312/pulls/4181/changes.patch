@@ -0,0 +1,140 @@
+//! Stage 1 builder (K1, #4025): one region value from a selection, the
+//! material side and the bounds. Each planner reads this value; the
+//! material side is an input of its own, and no start side reaches it.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region"; the cutter-centre area as the Minkowski erosion of the
+//! machinable area by the tool disc (Held, "On the Computational Geometry of
+//! Pocket Machining", 1991, ch. 2), computed with the polygon offset and the
+//! booleans of `camcraft-geometry`.
+
+use crate::frame::{ToolShape, WorkPlane};
+use crate::region::{Bounds, KernelRegion, MaterialSide, PlanarRegion};
+use crate::region_check::oriented;
+use crate::selection::Selection;
+use crate::verdict::{Refusal, Stage};
+use crate::{KERNEL_TOL, Loop, Point2, Region, seg_dist};
+
+/// Refusal reason: an open chain, which encloses no area and so has no
+/// inside or outside.
+pub const OPEN_NEEDS_SIDE: &str = "an open chain encloses no area, so it has no inside or outside material side";
+/// Refusal reason: a stock to leave that is not finite, or that cancels
+/// the tool radius.
+pub const BAD_LEAVE: &str = "the stock to leave must be a finite number greater than minus the tool radius";
+/// Refusal reason: an Outside material side with no stock to bound it.
+pub const NEEDS_STOCK: &str = "an Outside material side needs the stock: the area outside the selection has no limit";
+/// Refusal reason: a selection that does not meet the stock.
+pub const OFF_STOCK: &str = "the selection is outside the stock: there is no material to cut";
+/// Refusal reason: a material side with no area (an Outside selection
+/// that covers all of the stock).
+pub const EMPTY_MATERIAL: &str = "the material side of the selection has no area";
+/// Refusal reason: the polygon offset or a boolean refused its input.
+pub const REGION_GEOMETRY: &str = "the region geometry cannot be computed: a value is out of range";
+
+/// The distance (mm) within which a boundary vertex of the cutter-centre
+/// area counts as a vertex of the stock outline: the 1 um of the K0 laws.
+const ON_STOCK_TOL: f64 = 1e-3;
+
+fn geo<T, E>(r: Result<T, E>) -> Result<T, Refusal> {
+    r.map_err(|_| Refusal::new(Stage::Region, REGION_GEOMETRY))
+}
+
+/// True when `p` is on a loop of `r` within `tol`.
+fn on_outline(r: &Region, p: Point2, tol: f64) -> bool {
+    r.loops().iter().any(|l| {
+        let pts = l.points();
+        pts.iter().zip(pts.iter().cycle().skip(1)).any(|(a, b)| seg_dist(p, *a, *b) <= tol)
+    })
+}
+
+/// True when the region has an area above the kernel tolerance.
+fn has_area(r: &Region) -> bool {
+    let a = r.area();
+    !r.is_empty() && a.is_finite() && a > KERNEL_TOL
+}
+
+/// The area that the closed chains of `sel` enclose. Nested chains are
+/// holes; chains that do not nest add up.
+fn enclosed(sel: &Selection) -> Result<Region, Refusal> {
+    let loops: Vec<Loop> = sel.chains().iter().map(|c| geo(Loop::new(c.points().to_vec()))).collect::<Result<_, _>>()?;
+    geo(Region::new(loops))
+}
+
+/// The one region of a plan.
+///
+/// - `sel`: the picked chains, in the 2D coordinates of `plane`. Each
+///   chain must be closed.
+/// - `material`: `Inside` cuts the area that the chains enclose; `Outside`
+///   cuts the stock round it.
+/// - `bounds`: the stock (needed for `Outside`; for `Inside` the selection
+///   must meet it when it is known) and the keep-out area.
+/// - `tool`, `leave`: the cutter-centre area keeps the tool radius plus
+///   `leave` from the selection, and the tool radius from the keep-out.
+///
+/// The centre of an `Outside` region reaches the stock outline: the disc
+/// then sweeps past every stock edge and corner. Its loops on the stock
+/// outline are the stock edges, each other loop is a part wall. The air is
+/// the band of one tool radius outside the stock where the disc does not
+/// touch it. An `Inside` region is a closed area: its loops are all part
+/// walls and it has no air. A pure function of its inputs.
+pub fn region(
+    sel: &Selection,
+    material: MaterialSide,
+    bounds: &Bounds,
+    plane: WorkPlane,
+    tool: ToolShape,
+    leave: f64,
+) -> Result<KernelRegion, Refusal> {
+    if let Some(c) = sel.first_open() {
+        let r = Refusal::new(Stage::Region, OPEN_NEEDS_SIDE).fix("pick a closed chain, or join the points back to the first one");
+        return Err(match c.points().first() {
+            Some(p) => r.at(*p),
+            None => r,
+        });
+    }
+    let r = tool.radius();
+    let d = r + leave;
+    if !leave.is_finite() || !d.is_finite() || d <= KERNEL_TOL {
+        return Err(Refusal::new(Stage::Region, BAD_LEAVE));
+    }
+    let area = enclosed(sel)?;
+    if !has_area(&area) {
+        return Err(Refusal::new(Stage::Region, EMPTY_MATERIAL));
+    }
+    let keep = if bounds.keep_out().is_empty() { Region::empty() } else { geo(bounds.keep_out().offset(r))? };
+    let stock = bounds.stock();
+    if let Some(s) = stock
+        && !has_area(&geo(area.intersect(s))?)
+    {
+        return Err(Refusal::new(Stage::Region, OFF_STOCK).fix("pick a selection that meets the stock"));
+    }
+    let (center, air) = match material {
+        MaterialSide::Inside => (geo(area.offset(-d))?, Region::empty()),
+        MaterialSide::Outside => {
+            let Some(s) = stock.filter(|s| has_area(s)) else {
+                return Err(Refusal::new(Stage::Region, NEEDS_STOCK).fix("define the stock of the setup"));
+            };
+            if !has_area(&geo(s.difference(&area))?) {
+                return Err(Refusal::new(Stage::Region, EMPTY_MATERIAL));
+            }
+            let air = geo(geo(s.offset(2.0 * r))?.difference(&geo(s.offset(r))?))?;
+            (geo(s.difference(&geo(area.offset(d))?))?, geo(air.difference(&keep))?)
+        }
+    };
+    let mut center = if keep.is_empty() { center } else { geo(center.difference(&keep))? };
+    if !has_area(&center) {
+        return Err(Refusal::new(Stage::Region, crate::region::EMPTY_CENTER).fix("use a smaller tool or a larger selection"));
+    }
+    if oriented(&center).is_some() {
+        center = geo(Region::new(center.loops().to_vec()))?;
+    }
+    let (mut walls, mut edge) = (Vec::new(), Vec::new());
+    for l in center.loops() {
+        let on_stock = match (material, stock) {
+            (MaterialSide::Outside, Some(s)) => l.points().iter().all(|p| on_outline(s, *p, ON_STOCK_TOL)),
+            _ => false,
+        };
+        if on_stock { edge.push(l.clone()) } else { walls.push(l.clone()) }
+    }
+    let keep_out = bounds.keep_out().clone();
+    PlanarRegion::new(plane, center, material, walls, edge, air, keep_out, tool).map(KernelRegion::Planar)
+}
diff --git a/crates/pathkernel/src/region_check.rs b/crates/pathkernel/src/region_check.rs
new file mode 100644
index 000000000..011ef10da
--- /dev/null
+++ b/crates/pathkernel/src/region_check.rs
@@ -0,0 +1,88 @@
+//! The checks between the parts of a planar region (K1, #4025): the loops
+//! of the cutter-centre area are oriented by their nesting, and the part
+//! walls and the stock edges partition its boundary.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region" (the invariants); the crossing-parity point-in-polygon
+//! test of Shimrat, "Algorithm 112: Position of point relative to polygon"
+//! (CACM 5(8), 1962).
+
+use crate::{Loop, Point2, Region, near};
+
+/// Refusal reason: a loop of the cutter-centre area whose direction does
+/// not agree with its nesting (an outer loop counter-clockwise, a hole
+/// clockwise, an island in a hole counter-clockwise).
+pub const NOT_ORIENTED: &str = "a loop of the cutter-centre area is not oriented by its nesting";
+/// Refusal reason: part walls and stock edges that are not the boundary
+/// loops of the cutter-centre area, each one exactly one time.
+pub const NOT_A_PARTITION: &str =
+    "the part walls and the stock edges must be the boundary loops of the cutter-centre area, each one time";
+
+/// True when `p` is inside the polygon `pts` (crossing parity; a point on
+/// the boundary can read either way, so callers count many vertices).
+pub(crate) fn inside_loop(pts: &[Point2], p: Point2) -> bool {
+    let n = pts.len();
+    let mut inside = false;
+    for i in 0..n {
+        let (Some(a), Some(b)) = (pts.get(i), pts.get((i + 1) % n)) else { continue };
+        if (a.y > p.y) != (b.y > p.y) {
+            let t = (p.y - a.y) / (b.y - a.y);
+            if p.x < a.x + t * (b.x - a.x) {
+                inside = !inside;
+            }
+        }
+    }
+    inside
+}
+
+/// True when more than half of the vertices of `inner` are inside `outer`.
+/// Loops of a normalized region do not cross, so this is their nesting;
+/// the majority keeps a vertex that touches `outer` from deciding it.
+fn nested_in(inner: &Loop, outer: &Loop) -> bool {
+    let pts = inner.points();
+    let count = pts.iter().filter(|p| inside_loop(outer.points(), **p)).count();
+    count.saturating_mul(2) > pts.len()
+}
+
+/// The first vertex of the first loop of `r` whose direction disagrees with
+/// its nesting depth, or `None` when every loop is oriented.
+pub(crate) fn oriented(r: &Region) -> Option<Point2> {
+    let loops = r.loops();
+    loops.iter().enumerate().find_map(|(i, l)| {
+        let depth = loops.iter().enumerate().filter(|(j, o)| *j != i && nested_in(l, o)).count();
+        let want_ccw = depth % 2 == 0;
+        (l.is_ccw() != want_ccw).then(|| l.points().first().copied()).flatten()
+    })
+}
+
+/// True when `a` and `b` are the same cyclic sequence of points (the same
+/// direction, any start) within the kernel tolerance.
+pub(crate) fn same_cycle(a: &Loop, b: &Loop) -> bool {
+    let (pa, pb) = (a.points(), b.points());
+    let n = pa.len();
+    if n != pb.len() || n == 0 {
+        return false;
+    }
+    let Some(first) = pa.first() else { return false };
+    pb.iter().enumerate().filter(|(_, q)| near(*first, **q)).any(|(shift, _)| {
+        (0..n).all(|i| match (pa.get(i), pb.get((i + shift) % n)) {
+            (Some(p), Some(q)) => near(*p, *q),
+            _ => false,
+        })
+    })
+}
+
+/// The first point of the first edge loop that breaks the partition, or of
+/// the first boundary loop that no edge names; `None` when each loop of
+/// `center` is named by exactly one part wall or stock edge.
+pub(crate) fn partition(center: &Region, walls: &[Loop], edge: &[Loop]) -> Option<Point2> {
+    let loops = center.loops();
+    let mut used = vec![false; loops.len()];
+    for e in walls.iter().chain(edge) {
+        let hit = loops.iter().enumerate().find(|(i, l)| !used.get(*i).copied().unwrap_or(true) && same_cycle(e, l));
+        match hit.and_then(|(i, _)| used.get_mut(i)) {
+            Some(slot) => *slot = true,
+            None => return e.points().first().copied().or(Some(Point2::new(0.0, 0.0))),
+        }
+    }
+    used.iter().position(|u| !u).and_then(|i| loops.get(i)).and_then(|l| l.points().first().copied())
+}
diff --git a/crates/pathkernel/src/selection.rs b/crates/pathkernel/src/selection.rs
new file mode 100644
index 000000000..b6f5f6163
--- /dev/null
+++ b/crates/pathkernel/src/selection.rs
@@ -0,0 +1,237 @@
+//! The selection of stage 1 (K1, #4025): the picked chains in the plane of
+//! the recipe, valid by construction. An edge, a face boundary, a chain or a
+//! list of points that straight lines join all become a [`Chain`]: a
+//! polyline that is open or closed. A [`Selection`] holds one or more chains
+//! that do not cross themselves or each other.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! "Stage 1: Region"; the segment intersection test is the orientation
+//! predicate of de Berg et al., "Computational Geometry" (3rd ed., 2008),
+//! section 2.1, with a sweep over the x-sorted segment boxes.
+
+use crate::verdict::{Refusal, Stage};
+use crate::{KERNEL_TOL, Point2, finite, near};
+
+/// Refusal reason: a chain with too few points (two for an open chain,
+/// three for a closed chain).
+pub const SHORT_CHAIN: &str = "a selected chain needs two points, or three points when it is closed";
+/// Refusal reason: a selection with a point that is not a finite number.
+pub const SELECTION_NOT_FINITE: &str = "a selected point is not a finite number";
+/// Refusal reason: two neighbour points of a chain at the same place.
+pub const REPEATED_POINT: &str = "a selected chain has two neighbour points at the same place";
+/// Refusal reason: a selection with no chain.
+pub const EMPTY_SELECTION: &str = "the selection is empty: pick an edge, a face, a chain or points";
+/// Refusal reason: a chain that crosses or touches itself.
+pub const SELF_CROSSING: &str = "a selected chain crosses itself";
+/// Refusal reason: two chains that cross or touch.
+pub const CHAINS_CROSS: &str = "two selected chains cross or touch each other";
+/// Refusal reason: a closed chain with no area (all its points on one line).
+pub const ZERO_AREA: &str = "a selected closed chain has no area";
+
+/// One picked polyline in the plane of the recipe: finite points, no two
+/// neighbours at the same place, open or closed. A closed chain does not
+/// repeat its first point at its end.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Chain {
+    pts: Vec<Point2>,
+    closed: bool,
+}
+
+impl Chain {
+    /// A closed chain (a face boundary, a closed edge loop, or points that
+    /// straight lines join back to the first point). A last point equal to
+    /// the first is dropped.
+    pub fn closed(pts: Vec<Point2>) -> Result<Self, Refusal> {
+        Self::new(pts, true)
+    }
+
+    /// An open chain (an edge or a run of edges, or points that straight
+    /// lines join, first to last).
+    pub fn open(pts: Vec<Point2>) -> Result<Self, Refusal> {
+        Self::new(pts, false)
+    }
+
+    fn new(mut pts: Vec<Point2>, closed: bool) -> Result<Self, Refusal> {
+        if !pts.iter().all(|p| finite(&[p.x, p.y])) {
+            return Err(Refusal::new(Stage::Region, SELECTION_NOT_FINITE));
+        }
+        if closed && pts.len() > 1 && pts.first().zip(pts.last()).is_some_and(|(a, b)| near(*a, *b)) {
+            pts.pop();
+        }
+        if pts.len() < if closed { 3 } else { 2 } {
+            return Err(Refusal::new(Stage::Region, SHORT_CHAIN));
+        }
+        let c = Self { pts, closed };
+        if let Some(a) = c.segments().find(|(a, b)| near(*a, *b)).map(|(a, _)| a) {
+            return Err(Refusal::new(Stage::Region, REPEATED_POINT).at(a));
+        }
+        if closed && collinear(&c.pts) {
+            let r = Refusal::new(Stage::Region, ZERO_AREA);
+            return Err(match c.pts.first() {
+                Some(p) => r.at(*p),
+                None => r,
+            });
+        }
+        if let Some(p) = first_crossing(&[&c]) {
+            return Err(Refusal::new(Stage::Region, SELF_CROSSING).at(p));
+        }
+        Ok(c)
+    }
+
+    #[must_use]
+    pub fn points(&self) -> &[Point2] {
+        &self.pts
+    }
+    #[must_use]
+    pub fn is_closed(&self) -> bool {
+        self.closed
+    }
+
+    /// The segments of the chain; a closed chain includes the closing one.
+    fn segments(&self) -> impl Iterator<Item = (Point2, Point2)> + '_ {
+        let n = self.pts.len();
+        let count = if self.closed { n } else { n.saturating_sub(1) };
+        (0..count).filter_map(move |i| Some((*self.pts.get(i)?, *self.pts.get((i + 1) % n)?)))
+    }
+}
+
+/// The selection of one plan: one or more chains, none of which crosses
+/// itself or another one. Nested closed chains are holes (even-odd).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Selection {
+    chains: Vec<Chain>,
+}
+
+impl Selection {
+    /// The selection of `chains`. Refused when it is empty, or when two
+    /// chains cross or touch.
+    pub fn new(chains: Vec<Chain>) -> Result<Self, Refusal> {
+        if chains.is_empty() {
+            return Err(Refusal::new(Stage::Region, EMPTY_SELECTION));
+        }
+        let refs: Vec<&Chain> = chains.iter().collect();
+        if let Some(p) = first_crossing(&refs) {
+            return Err(Refusal::new(Stage::Region, CHAINS_CROSS).at(p));
+        }
+        Ok(Self { chains })
+    }
+
+    /// A face: its outer boundary and its holes, each a closed chain.
+    pub fn face(outer: Vec<Point2>, holes: Vec<Vec<Point2>>) -> Result<Self, Refusal> {
+        let mut chains = vec![Chain::closed(outer)?];
+        for h in holes {
+            chains.push(Chain::closed(h)?);
+        }
+        Self::new(chains)
+    }
+
+    /// Points that straight lines join, first to last, and back to the
+    /// first when `closed`.
+    pub fn points(pts: Vec<Point2>, closed: bool) -> Result<Self, Refusal> {
+        Self::new(vec![Chain::new(pts, closed)?])
+    }
+
+    #[must_use]
+    pub fn chains(&self) -> &[Chain] {
+        &self.chains
+    }
+
+    /// The first open chain, if any.
+    #[must_use]
+    pub fn first_open(&self) -> Option<&Chain> {
+        self.chains.iter().find(|c| !c.closed)
+    }
+}
+
+/// True when all the points lie on one line within the kernel tolerance.
+fn collinear(pts: &[Point2]) -> bool {
+    let Some(a) = pts.first().copied() else { return true };
+    let far = pts.iter().copied().max_by(|p, q| (p.x - a.x).hypot(p.y - a.y).total_cmp(&(q.x - a.x).hypot(q.y - a.y)));
+    let Some(b) = far else { return true };
+    let len = (b.x - a.x).hypot(b.y - a.y);
+    len <= KERNEL_TOL || pts.iter().all(|p| orient(a, b, *p).abs() / len <= KERNEL_TOL)
+}
+
+fn orient(a: Point2, b: Point2, c: Point2) -> f64 {
+    (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
+}
+
+fn on_seg(a: Point2, b: Point2, p: Point2) -> bool {
+    p.x >= a.x.min(b.x) - KERNEL_TOL
+        && p.x <= a.x.max(b.x) + KERNEL_TOL
+        && p.y >= a.y.min(b.y) - KERNEL_TOL
+        && p.y <= a.y.max(b.y) + KERNEL_TOL
+}
+
+/// True when the closed segments `a-b` and `c-d` share a point (a touch
+/// within the tolerance counts).
+fn seg_meet(a: Point2, b: Point2, c: Point2, d: Point2) -> bool {
+    let tol = |p: Point2, q: Point2| KERNEL_TOL * (q.x - p.x).hypot(q.y - p.y).max(1.0);
+    let (d1, d2) = (orient(c, d, a), orient(c, d, b));
+    let (d3, d4) = (orient(a, b, c), orient(a, b, d));
+    let (t_cd, t_ab) = (tol(c, d), tol(a, b));
+    if ((d1 > t_cd && d2 < -t_cd) || (d1 < -t_cd && d2 > t_cd)) && ((d3 > t_ab && d4 < -t_ab) || (d3 < -t_ab && d4 > t_ab)) {
+        return true;
+    }
+    (d1.abs() <= t_cd && on_seg(c, d, a))
+        || (d2.abs() <= t_cd && on_seg(c, d, b))
+        || (d3.abs() <= t_ab && on_seg(a, b, c))
+        || (d4.abs() <= t_ab && on_seg(a, b, d))
+}
+
+/// A segment with its chain and its index in the chain.
+struct Seg {
+    chain: usize,
+    idx: usize,
+    a: Point2,
+    b: Point2,
+}
+
+/// True when two segments of one chain are neighbours (they share the
+/// vertex between them, which is not a crossing).
+fn neighbours(s: &Seg, t: &Seg, chains: &[&Chain]) -> bool {
+    if s.chain != t.chain {
+        return false;
+    }
+    let Some(c) = chains.get(s.chain) else { return false };
+    t.idx == s.idx.saturating_add(1) || (c.closed && s.idx.saturating_add(1) == c.pts.len() && t.idx == 0)
+}
+
+/// The first place where a chain crosses or touches itself or another
+/// chain, other than at the shared vertex of two neighbour segments. A
+/// sweep over the segments sorted by their least x.
+fn first_crossing(chains: &[&Chain]) -> Option<Point2> {
+    let mut segs: Vec<Seg> = chains
+        .iter()
+        .enumerate()
+        .flat_map(|(ci, c)| c.segments().enumerate().map(move |(idx, (a, b))| Seg { chain: ci, idx, a, b }))
+        .collect();
+    segs.sort_by(|s, t| s.a.x.min(s.b.x).total_cmp(&t.a.x.min(t.b.x)));
+    for (i, s) in segs.iter().enumerate() {
+        let s_max = s.a.x.max(s.b.x) + KERNEL_TOL;
+        for t in segs.iter().skip(i + 1) {
+            if t.a.x.min(t.b.x) > s_max {
+                break;
+            }
+            if neighbours(s, t, chains) || neighbours(t, s, chains) {
+                if s.chain == t.chain && overlap_back(s, t) {
+                    return Some(s.b);
+                }
+                continue;
+            }
+            if seg_meet(s.a, s.b, t.a, t.b) {
+                return Some(s.a);
+            }
+        }
+    }
+    None
+}
+
+/// Two neighbour segments that fold back on each other (a spike): the
+/// angle between them is zero.
+fn overlap_back(s: &Seg, t: &Seg) -> bool {
+    let (u, v) = if near(s.b, t.a) { ((s.a, s.b), (t.a, t.b)) } else { ((t.a, t.b), (s.a, s.b)) };
+    let (ux, uy, vx, vy) = (u.1.x - u.0.x, u.1.y - u.0.y, v.1.x - v.0.x, v.1.y - v.0.y);
+    let cross = ux * vy - uy * vx;
+    let dot = ux * vx + uy * vy;
+    cross.abs() <= KERNEL_TOL * ux.hypot(uy).max(1.0) * vx.hypot(vy).max(1.0) && dot < 0.0
+}
diff --git a/crates/pathkernel/tests/laws.rs b/crates/pathkernel/tests/laws.rs
index 369ae3c22..6333f3c50 100644
--- a/crates/pathkernel/tests/laws.rs
+++ b/crates/pathkernel/tests/laws.rs
@@ -3,7 +3,7 @@
 //! test builds the invalid cases and expects a named refusal. The K7 law
 //! suite (#4027) joins this directory suite.
 //!
-//! Gate map: covers pathkernel::{frame, verdict, region, guide, order, load, link, entry, plan, recipe}.
+//! Gate map: covers pathkernel::{frame, verdict, region, region_build, region_check, selection, guide, order, load, link, entry, plan, recipe}.
 //! Provenance: our own design record docs/decisions/4024-path-kernel-design.md.
 
 #[path = "laws/common.rs"]
@@ -20,3 +20,5 @@ mod load;
 mod order;
 #[path = "laws/plan.rs"]
 mod plan;
