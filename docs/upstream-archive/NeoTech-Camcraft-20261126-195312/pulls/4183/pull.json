    "gists_url": "https://api.github.com/users/dylanoliverdo-coder/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/dylanoliverdo-coder/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/dylanoliverdo-coder/subscriptions",
    "organizations_url": "https://api.github.com/users/dylanoliverdo-coder/orgs",
    "repos_url": "https://api.github.com/users/dylanoliverdo-coder/repos",
    "events_url": "https://api.github.com/users/dylanoliverdo-coder/events{/privacy}",
    "received_events_url": "https://api.github.com/users/dylanoliverdo-coder/received_events",
