diff --git a/crates/geometry/src/geo2d/arc.rs b/crates/geometry/src/geo2d/arc.rs
new file mode 100644
index 0000000000..54f30163c3
--- /dev/null
+++ b/crates/geometry/src/geo2d/arc.rs
@@ -0,0 +1,149 @@
+//! Circular arcs as chord points, and the test that a polyline stays in a
+//! region (#4178: the arc leads of the path kernel's entry and exit stage).
+//! Provenance: the sagitta of a chord, s = r (1 - cos(t / 2)), from any
+//! geometry handbook; the containment test rides [`Region::clip_polyline`].
+//! Our own code, no vendor material consulted.
+
+use super::{COORD_LIMIT, GeoError, Point2, Region};
+
+/// The most chords that one arc may have. A finer request is refused, not
+/// cut short: a caller that needs more asks for a coarser tolerance.
+pub const MAX_ARC_CHORDS: usize = 4096;
+
+/// The largest turn of one chord (radians): a coarse tolerance still gives
+/// an arc that looks like an arc.
+const MAX_CHORD_TURN: f64 = std::f64::consts::FRAC_PI_4;
+
+/// A stretch of a path outside a region that is shorter than this (mm) is
+/// a touch at one point, not a stretch.
+const TOUCH: f64 = 1e-9;
+
+/// The points of the arc about `center` that starts at `start` and turns by
+/// `sweep` radians (positive is counter-clockwise), with no chord farther
+/// than `chord_tol` from the arc. The first point is `start` exactly; the
+/// last point is the end of the arc. Refused: a value that is not finite, a
+/// radius of zero, a sweep of zero or of more than one full turn, a
+/// tolerance of zero or less, or more than [`MAX_ARC_CHORDS`] chords.
+pub fn arc_points(center: Point2, start: Point2, sweep: f64, chord_tol: f64) -> Result<Vec<Point2>, GeoError> {
+    let values = [center.x, center.y, start.x, start.y, sweep, chord_tol];
+    if values.iter().any(|v| !v.is_finite()) {
+        return Err(GeoError::Invalid("non-finite arc value".into()));
+    }
+    if values[..4].iter().any(|v| v.abs() >= COORD_LIMIT) {
+        return Err(GeoError::OutOfRange);
+    }
+    let r = (start.x - center.x).hypot(start.y - center.y);
+    let full = std::f64::consts::TAU;
+    if !(r > 0.0 && chord_tol > 0.0 && sweep != 0.0 && sweep.abs() <= full * (1.0 + 1e-12)) {
+        return Err(GeoError::Invalid("an arc needs a radius, a sweep up to one turn and a tolerance above zero".into()));
+    }
+    let turn = if chord_tol < r { (2.0 * (1.0 - chord_tol / r).acos()).min(MAX_CHORD_TURN) } else { MAX_CHORD_TURN };
+    let steps = (sweep.abs() / turn).ceil();
+    if !(steps.is_finite() && steps >= 1.0 && steps <= MAX_ARC_CHORDS as f64) {
+        return Err(GeoError::Invalid("the arc needs more chords than the limit".into()));
+    }
+    // `steps` is a whole number in [1, MAX_ARC_CHORDS]: the cast is exact.
+    let n = steps as usize;
+    let a0 = (start.y - center.y).atan2(start.x - center.x);
+    let mut pts = Vec::with_capacity(n + 1);
+    pts.push(start);
+    for i in 1..=n {
+        let a = a0 + sweep * (i as f64) / steps;
+        pts.push(Point2::new(center.x + r * a.cos(), center.y + r * a.sin()));
+    }
+    Ok(pts)
+}
+
+impl Region {
+    /// True when no stretch of the open polyline `path` lies outside this
+    /// region. A single point is held when the region contains it. On the
+    /// boundary, [`Region::contains`]' half-open rule decides: a caller
+    /// that needs a definite answer there tests against the region grown
+    /// by its tolerance. A non-finite or out-of-range vertex is refused.
+    pub fn holds_path(&self, path: &[Point2]) -> Result<bool, GeoError> {
+        match path {
+            [] => Ok(true),
+            [p] => {
+                if !(p.x.is_finite() && p.y.is_finite()) {
+                    return Err(GeoError::Invalid("non-finite path vertex".into()));
+                }
+                Ok(self.contains(*p))
+            }
+            _ => {
+                let outside = self.clip_polyline(path, false)?;
+                let len = |s: &Vec<Point2>| s.windows(2).map(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y)).sum::<f64>();
+                Ok(outside.iter().all(|s| len(s) <= TOUCH))
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geo2d::Loop;
+    use std::f64::consts::{FRAC_PI_2, PI, TAU};
+
+    fn p(x: f64, y: f64) -> Point2 {
+        Point2::new(x, y)
+    }
+
+    fn annulus() -> Region {
+        let sq = |a: f64, b: f64| {
+            let Ok(l) = Loop::new(vec![p(a, a), p(b, a), p(b, b), p(a, b)]) else { panic!("loop") };
+            l
+        };
+        let Ok(r) = Region::new(vec![sq(0.0, 10.0), sq(4.0, 6.0)]) else { panic!("region") };
+        r
+    }
+
+    #[test]
+    fn a_quarter_arc_starts_and_ends_on_its_circle_within_the_tolerance() {
+        let Ok(pts) = arc_points(p(0.0, 0.0), p(5.0, 0.0), FRAC_PI_2, 0.01) else { panic!("arc") };
+        assert_eq!(pts.first().copied(), Some(p(5.0, 0.0)));
+        let end = pts.last().copied().unwrap_or_default();
+        assert!((end.x).abs() < 1e-9 && (end.y - 5.0).abs() < 1e-9, "{end:?}");
+        for w in pts.windows(2) {
+            let mid = p(0.5 * (w[0].x + w[1].x), 0.5 * (w[0].y + w[1].y));
+            assert!(5.0 - mid.x.hypot(mid.y) <= 0.01 + 1e-12, "a chord leaves the tolerance");
+            assert!((w[0].x.hypot(w[0].y) - 5.0).abs() < 1e-9);
+        }
+        // A clockwise sweep turns the other way.
+        let Ok(cw) = arc_points(p(0.0, 0.0), p(5.0, 0.0), -FRAC_PI_2, 0.01) else { panic!("arc") };
+        let end = cw.last().copied().unwrap_or_default();
+        assert!((end.y + 5.0).abs() < 1e-9, "{end:?}");
+    }
+
+    #[test]
+    fn a_coarse_tolerance_still_turns_at_most_an_eighth_of_a_turn_a_chord() {
+        let Ok(pts) = arc_points(p(0.0, 0.0), p(1.0, 0.0), PI, 10.0) else { panic!("arc") };
+        assert_eq!(pts.len(), 5);
+        let Ok(full) = arc_points(p(0.0, 0.0), p(1.0, 0.0), TAU, 10.0) else { panic!("arc") };
+        assert_eq!(full.len(), 9);
+    }
+
+    #[test]
+    fn a_bad_arc_is_refused() {
+        let o = p(0.0, 0.0);
+        assert!(arc_points(o, o, 1.0, 0.01).is_err(), "radius zero");
+        assert!(arc_points(o, p(1.0, 0.0), 0.0, 0.01).is_err(), "sweep zero");
+        assert!(arc_points(o, p(1.0, 0.0), 7.0, 0.01).is_err(), "more than one turn");
+        assert!(arc_points(o, p(1.0, 0.0), 1.0, 0.0).is_err(), "tolerance zero");
+        assert!(arc_points(o, p(f64::NAN, 0.0), 1.0, 0.01).is_err(), "not finite");
+        assert!(arc_points(o, p(1e13, 0.0), 1.0, 0.01).is_err(), "out of range");
+        assert!(arc_points(o, p(1000.0, 0.0), TAU, 1e-9).is_err(), "too many chords");
+    }
+
+    #[test]
+    fn a_path_is_held_only_when_no_stretch_leaves_the_region() {
+        let r = annulus();
+        assert!(matches!(r.holds_path(&[p(1.0, 1.0), p(9.0, 1.0), p(9.0, 9.0)]), Ok(true)));
+        assert!(matches!(r.holds_path(&[p(1.0, 1.0), p(9.0, 9.0)]), Ok(false)), "crosses the hole");
+        assert!(matches!(r.holds_path(&[p(1.0, 1.0), p(12.0, 1.0)]), Ok(false)), "leaves the outline");
+        assert!(matches!(r.holds_path(&[p(5.0, 5.0)]), Ok(false)), "a point in the hole");
+        assert!(matches!(r.holds_path(&[p(1.0, 5.0)]), Ok(true)));
+        assert!(matches!(r.holds_path(&[]), Ok(true)));
+        assert!(r.holds_path(&[p(f64::NAN, 1.0)]).is_err());
+        assert!(r.holds_path(&[p(1.0, 1.0), p(f64::NAN, 1.0)]).is_err());
+    }
+}
diff --git a/crates/pathkernel/src/entry/air.rs b/crates/pathkernel/src/entry/air.rs
new file mode 100644
index 0000000000..e93a4c77f9
--- /dev/null
+++ b/crates/pathkernel/src/entry/air.rs
@@ -0,0 +1,125 @@
+//! The entry in air (#3746): the tool feeds down in the air outside the
+//! stock, clear of it by the approach distance, then moves in the cut plane
+//! onto the start of the cut - a straight lead in air where one is needed,
+//! then one arc of the asked radius and sweep, tangent to the cut at its
+//! start. The arc and the lead stay in the legal room; the straight lead
+//! does not enter the cutter-centre area. Where no arc fits at a smaller
+//! radius either, a cut that starts in the air zone is entered straight
+//! down; else the stage tries the next kind.
+//!
+//! Provenance: the tangential arc lead-in of general machining practice
+//! (RS-274 / ISO 6983 G17 G2/G3), entered from outside the stock as public
+//! machining handbooks describe it. A port of the rule of
+//! `crates/motion/src/machining2d/air_entry.rs` (#3746, #3810) onto the
+//! region of K1; the old code reads a stock box, this reads the air band.
+
+use super::proof::{Area, Entry, Lead, Proof};
+use super::room::{Ctx, ROOM_TOL, air_zone, geo};
+use super::EntryKind;
+use camcraft_geometry::geo2d::arc_points;
+use crate::{Point2, Region};
+
+/// The radii tried for the arc: the asked one, then halving.
+const RADIUS_TRIES: usize = 5;
+/// The steps of the search back along the arc's tangent for a descent in air.
+const MARCH_STEPS: u32 = 512;
+
+/// The arc of `radius` and `sweep` that ends at `s` tangent to `u`, turning
+/// counter-clockwise when `ccw`: its start and its points (the last is `s`).
+pub(super) fn arc_onto(s: Point2, u: Point2, radius: f64, sweep: f64, ccw: bool, tol: f64) -> Result<(Point2, Point2, Vec<Point2>), crate::Refusal> {
+    let n = if ccw { Point2::new(-u.y, u.x) } else { Point2::new(u.y, -u.x) };
+    let c = Point2::new(s.x + radius * n.x, s.y + radius * n.y);
+    let back = if ccw { -sweep } else { sweep };
+    let (vx, vy) = (s.x - c.x, s.y - c.y);
+    let (sin, cos) = back.sin_cos();
+    let a = Point2::new(c.x + vx * cos - vy * sin, c.y + vx * sin + vy * cos);
+    let mut pts = geo(arc_points(c, a, -back, tol))?;
+    if let Some(last) = pts.last_mut() {
+        *last = s;
+    }
+    Ok((a, c, pts))
+}
+
+/// The direction of travel at `a` on the arc about `c`.
+fn tangent(a: Point2, c: Point2, ccw: bool) -> Option<Point2> {
+    let (vx, vy) = (a.x - c.x, a.y - c.y);
+    super::room::unit(if ccw { Point2::new(-vy, vx) } else { Point2::new(vy, -vx) })
+}
+
+/// The first point in `zone` back along `-t` from `a`, within `reach`.
+fn march(zone: &Region, a: Point2, t: Point2, reach: f64) -> Option<Point2> {
+    let step = reach / f64::from(MARCH_STEPS);
+    (1..=MARCH_STEPS).map(|i| f64::from(i) * step).map(|l| Point2::new(a.x - t.x * l, a.y - t.y * l)).find(|q| zone.contains(*q))
+}
+
+/// The air entry at the start of the first cut, if one fits.
+pub(super) fn enter(ctx: &mut Ctx<'_>) -> Result<Option<Entry>, crate::Refusal> {
+    let p = ctx.region;
+    if p.air().is_empty() {
+        return Ok(None);
+    }
+    let (zone, capped) = air_zone(p, ctx.choice.approach())?;
+    let Ok(zone_area) = Area::new(zone.clone()) else {
+        return Ok(None);
+    };
+    let inner = geo(p.center().offset(-ROOM_TOL))?;
+    let into_center = |a: Point2, b: Point2| match inner.clip_polyline(&[a, b], true) {
+        Ok(pieces) => pieces.iter().any(|s| s.windows(2).any(|w| (w[1].x - w[0].x).hypot(w[1].y - w[0].y) > ROOM_TOL)),
+        Err(_) => true,
+    };
+    let (s, u, arc, tol) = (ctx.start.at(), ctx.dir, ctx.stage.arc(), ctx.stage.chord_tol());
+    let reach = 3.0 * ctx.r() + ctx.choice.approach() + 2.0 * arc.radius();
+    let mut radius = arc.radius();
+    let mut with_line: Option<(Point2, Vec<Point2>, f64)> = None;
+    for _ in 0..RADIUS_TRIES {
+        for ccw in [true, false] {
+            let (a, c, pts) = arc_onto(s, u, radius, arc.sweep(), ccw, tol)?;
+            if !ctx.holds(&pts) {
+                continue;
+            }
+            if zone.contains(a) {
+                return found(ctx, a, pts, radius, capped, zone_area);
+            }
+            if with_line.is_some() {
+                continue;
+            }
+            let Some(q) = tangent(a, c, ccw).and_then(|t| march(&zone, a, t, reach)) else { continue };
+            if ctx.holds(&[q, a]) && !into_center(q, a) {
+                let mut lead = vec![q];
+                lead.extend(pts);
+                with_line = Some((q, lead, radius));
+            }
+        }
+        if with_line.is_some() {
+            break;
+        }
+        radius *= 0.5;
+    }
+    if let Some((q, lead, radius)) = with_line {
+        return found(ctx, q, lead, radius, capped, zone_area);
+    }
+    if zone.contains(s) {
+        let entry = Entry::new(EntryKind::Air, vec![ctx.above(s)?], vec![ctx.start], Proof::InAir(zone_area), ctx.choice, ctx.tool());
+        return Ok(entry.ok());
+    }
+    Ok(None)
+}
+
+/// The arc-lead entry: down at `at` in the air zone, then the lead `xy`.
+fn found(ctx: &mut Ctx<'_>, at: Point2, xy: Vec<Point2>, radius: f64, capped: Option<f64>, zone: Area) -> Result<Option<Entry>, crate::Refusal> {
+    let pts = xy.iter().map(|q| ctx.at_depth(*q)).collect::<Result<Vec<_>, _>>()?;
+    let Ok(lead) = Lead::new(pts, &ctx.legal_area) else {
+        return Ok(None);
+    };
+    let (approach, descent) = (vec![ctx.above(at)?], vec![ctx.at_depth(at)?]);
+    let Ok(entry) = Entry::led(EntryKind::ArcLead, approach, descent, Some(lead), Proof::InAir(zone), ctx.choice, ctx.tool()) else {
+        return Ok(None);
+    };
+    if let Some(a) = capped {
+        ctx.note(format!("entry: the approach distance is limited to {a:.3} mm by the air band round the stock"))?;
+    }
+    if radius < ctx.stage.arc().radius() {
+        ctx.note(format!("entry: the arc lead fits only under its radius - flown at {radius:.3} mm"))?;
+    }
+    Ok(Some(entry))
+}
