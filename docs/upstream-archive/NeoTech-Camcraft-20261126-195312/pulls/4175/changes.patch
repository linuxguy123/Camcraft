index 000000000..ab6e143e3
--- /dev/null
+++ b/crates/pathkernel/tests/laws/grid.rs
@@ -0,0 +1,187 @@
+//! The stock grid that the law checks own (#4027): a raster of the stock
+//! footprint, written apart from any planner's stock reader (record "The
+//! laws as checks": an independent stock grid). It walks a plan step by
+//! step, reads each entry and each cut on the stock as it is at that step,
+//! and clears the swept disc of the tool.
+//! Provenance: our own design record; the radial engagement ae/D from the
+//! contact angle of the cutting edge (Stori & Wright 2000).
+
+use camcraft_pathkernel::entry::Proof;
+use camcraft_pathkernel::plan::{Plan, Step};
+use camcraft_pathkernel::{Point2, Region};
+
+use super::kit::{dist, poly};
+
+/// The grid cell is this part of the tool radius.
+pub const CELL: f64 = 0.1;
+/// The read error of an engagement on the grid: one cell at each side of
+/// the width, over the diameter.
+pub const GRID_TOL: f64 = CELL;
+
+pub struct Grid {
+    x0: f64,
+    y0: f64,
+    h: f64,
+    nx: usize,
+    ny: usize,
+    cells: Vec<bool>,
+}
+
+impl Grid {
+    /// The raster of `stock` with the cell side `h`, or `None` for an
+    /// empty stock or a bad cell side.
+    pub fn new(stock: &Region, h: f64) -> Option<Self> {
+        let (lo, hi) = stock.bounds()?;
+        if !(h > 0.0 && h.is_finite()) {
+            return None;
+        }
+        let nx = ((hi.x - lo.x) / h).ceil() as usize + 1;
+        let ny = ((hi.y - lo.y) / h).ceil() as usize + 1;
+        let mut g = Self { x0: lo.x, y0: lo.y, h, nx, ny, cells: Vec::with_capacity(nx * ny) };
+        for j in 0..ny {
+            for i in 0..nx {
+                let c = g.centre(i, j);
+                g.cells.push(stock.contains(c));
+            }
+        }
+        Some(g)
+    }
+
+    fn centre(&self, i: usize, j: usize) -> Point2 {
+        Point2::new(self.x0 + (i as f64 + 0.5) * self.h, self.y0 + (j as f64 + 0.5) * self.h)
+    }
+
+    /// The index and the centre of each cell whose centre is within `r` of `c`.
+    fn disc(&self, c: Point2, r: f64) -> Vec<(usize, Point2)> {
+        let span = |v: f64, v0: f64, n: usize| {
+            let lo = ((v - r - v0) / self.h).floor().max(0.0) as usize;
+            let hi = (((v + r - v0) / self.h).ceil().max(0.0) as usize).min(n);
+            lo..hi
+        };
+        let mut out = Vec::new();
+        for j in span(c.y, self.y0, self.ny) {
+            for i in span(c.x, self.x0, self.nx) {
+                let q = self.centre(i, j);
+                if dist(q, c) <= r {
+                    out.push((j * self.nx + i, q));
+                }
+            }
+        }
+        out
+    }
+
+    pub fn clear_disc(&mut self, c: Point2, r: f64) {
+        for (k, _) in self.disc(c, r) {
+            self.cells[k] = false;
+        }
+    }
+
+    /// The share of the disc that holds material (cells off the grid are air).
+    pub fn fill(&self, c: Point2, r: f64) -> f64 {
+        let all = std::f64::consts::PI * r * r / (self.h * self.h);
+        let hit = self.disc(c, r).iter().filter(|(k, _)| self.cells[*k]).count();
+        if all > 0.0 { (hit as f64 / all).min(1.0) } else { 0.0 }
+    }
+
+    /// True when the cell at `p` holds material (off the grid: air).
+    fn material(&self, p: Point2) -> bool {
+        let (fx, fy) = ((p.x - self.x0) / self.h, (p.y - self.y0) / self.h);
+        if !(fx >= 0.0 && fy >= 0.0) {
+            return false;
+        }
+        let (i, j) = (fx as usize, fy as usize);
+        i < self.nx && j < self.ny && self.cells[j * self.nx + i]
+    }
+
+    /// ae/D at `c` for the motion direction `d` (a unit vector), from the
+    /// contact angle: the angle of the front half of the cutting edge that
+    /// touches material, read each degree half a cell inside the edge, as
+    /// `(1 - cos angle) / 2` (1 for a full-width slot).
+    pub fn engagement(&self, c: Point2, d: Point2, r: f64) -> f64 {
+        let n = Point2::new(-d.y, d.x);
+        let edge = r - self.h / 2.0;
+        let touch = (-90..=90)
+            .filter(|deg| {
+                let t = f64::from(*deg).to_radians();
+                let (a, b) = (t.cos() * edge, t.sin() * edge);
+                self.material(Point2::new(c.x + a * d.x + b * n.x, c.y + a * d.y + b * n.y))
+            })
+            .count();
+        let angle = (touch as f64).to_radians().min(std::f64::consts::PI);
+        (1.0 - angle.cos()) / 2.0
+    }
+}
+
+/// One read of an entry descent point: the material share under the tool.
+pub struct EntryRead {
+    pub index: usize,
+    pub at: Point2,
+    pub fill: f64,
+    pub into_material: bool,
+}
+
+/// One read of a cut point: its engagement on the stock of that moment.
+pub struct CutRead {
+    pub index: usize,
+    pub at: Point2,
+    pub load: f64,
+}
+
+#[derive(Default)]
+pub struct Walk {
+    pub entries: Vec<EntryRead>,
+    pub cuts: Vec<CutRead>,
+}
+
+/// The points of a polyline at most `step` apart, each with its unit direction.
+pub fn samples(line: &[Point2], step: f64) -> Vec<(Point2, Point2)> {
+    let mut out = Vec::new();
+    for w in line.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        let len = dist(a, b);
+        if len <= 0.0 {
+            continue;
+        }
+        let d = Point2::new((b.x - a.x) / len, (b.y - a.y) / len);
+        let n = (len / step).ceil().max(1.0) as usize;
+        for k in 0..n {
+            let t = k as f64 / n as f64;
+            out.push((Point2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y)), d));
+        }
+    }
+    if let (Some(&(_, d)), Some(&p)) = (out.last(), line.last()) {
+        out.push((p, d));
+    }
+    out
+}
+
+/// Walks `plan` on a fresh grid of `stock` for a tool of radius `r`. An
+/// entry is read before its descent clears the disc; a cut point is read
+/// before the tool clears its disc there. `None` for an empty stock.
+pub fn walk(plan: &Plan, stock: &Region, r: f64) -> Option<Walk> {
+    let mut g = Grid::new(stock, r * CELL)?;
+    let (mut w, mut ne, mut nc) = (Walk::default(), 0, 0);
+    for s in plan.steps() {
+        match s {
+            Step::Entry(e) => {
+                let into_material = matches!(e.proof(), Proof::IntoMaterial { .. });
+                for p in e.descent() {
+                    w.entries.push(EntryRead { index: ne, at: p.at(), fill: g.fill(p.at(), r), into_material });
+                }
+                for p in e.descent() {
+                    g.clear_disc(p.at(), r);
+                }
+                ne += 1;
+            }
+            Step::Cut(c) => {
+                for (p, d) in samples(&poly(c.curve()), r / 4.0) {
+                    w.cuts.push(CutRead { index: nc, at: p, load: g.engagement(p, d, r) });
+                    g.clear_disc(p, r);
+                }
+                nc += 1;
+            }
+            _ => {}
+        }
+    }
+    Some(w)
+}
diff --git a/crates/pathkernel/tests/laws/kit.rs b/crates/pathkernel/tests/laws/kit.rs
new file mode 100644
index 000000000..73c83c81e
--- /dev/null
+++ b/crates/pathkernel/tests/laws/kit.rs
@@ -0,0 +1,333 @@
+//! The law kit of the K7 suite (#4027): the verdict of a law check, the
+//! planner set of a kind (its five stage planners), one case (a region, a
+//! recipe of choices and a stock), and the run of the stages into a plan.
+//! A kind that moves to the kernel registers its planner set and its cases
+//! in `registry.rs`; each law check reads only what this kit gives it.
+//! Provenance: our own design record (RECOMMENDED.md "#4024 - Path kernel
+//! K0", "The laws as checks").
+
+use std::fmt;
+
+use camcraft_pathkernel::entry::EntryPlanner;
+use camcraft_pathkernel::guide::{Curve, GuidePlanner, GuideSet};
+use camcraft_pathkernel::link::{Hop, LinkProof, LinkTally};
+use camcraft_pathkernel::load::{Controlled, LoadPlanner, StockRead};
+use camcraft_pathkernel::order::{OrderChoice, OrderPlanner, OrderedSet, StartSide};
+use camcraft_pathkernel::plan::{Cut, Plan, Step};
+use camcraft_pathkernel::region::{KernelRegion, MaterialSide, PlanarRegion};
+use camcraft_pathkernel::{Loop, Point2, Recipe, Refusal, Region, Stage, Verdict};
+
+/// Two curves match within 1 um (record "The laws as checks").
+pub const MATCH_TOL: f64 = 1e-3;
+/// The tolerance that the runner gives to the guide stage.
+pub const GUIDE_TOL: f64 = 1e-3;
+/// Refusal reason of the kit: a region that is not planar (phase 1 has only planar ones).
+pub const NOT_PLANAR: &str = "the law kit reads planar regions only";
+/// Refusal reason of the kit: a stage that is not refused gave no output.
+pub const NO_OUTPUT: &str = "a stage that is not refused gave no output";
+
+/// The laws of #4023 as the record numbers them, and the link rule.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Law {
+    L1,
+    L2,
+    L3,
+    L4,
+    L5,
+    L6,
+    L7,
+    Link,
+}
+
+impl Law {
+    pub fn text(self) -> &'static str {
+        match self {
+            Self::L1 => "the same region and the same guide choice give the same curves",
+            Self::L2 => "the material side and the start side are separate parameters",
+            Self::L3 => "the start side changes only the order and the start point",
+            Self::L4 => "a fallback is visible: the status line names it",
+            Self::L5 => "an entry into material needs a proof",
+            Self::L6 => "a cut above the engagement limit is prevented or named",
+            Self::L7 => "a move that migrates keeps its output",
+            Self::Link => "stay at depth; lift only with a named reason",
+        }
+    }
+}
+
+/// One measured value of a check, the limit that it is held to, and its place.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Measure {
+    pub value: f64,
+    pub limit: f64,
+    pub place: String,
+    pub at: Option<Point2>,
+}
+
+impl Measure {
+    pub fn new(value: f64, limit: f64, place: impl Into<String>, at: Option<Point2>) -> Self {
+        Self { value, limit, place: place.into(), at }
+    }
+    /// A count of events that must not occur (limit 0).
+    pub fn count(n: usize, place: impl Into<String>, at: Option<Point2>) -> Self {
+        Self::new(n as f64, 0.0, place, at)
+    }
+    fn held(&self) -> bool {
+        self.value <= self.limit
+    }
+    fn excess(&self) -> f64 {
+        if self.value.is_nan() { f64::INFINITY } else { self.value - self.limit }
+    }
+}
+
+/// The verdict of one law on one case: the law, held or broken, and the
+/// worst measure (its place and value).
+#[derive(Clone, Debug, PartialEq)]
+pub struct LawVerdict {
+    pub law: Law,
+    pub held: bool,
+    pub worst: Measure,
+}
+
+impl fmt::Display for LawVerdict {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let state = if self.held { "held" } else { "BROKEN" };
+        let w = &self.worst;
+        write!(f, "{:?} {state} ({}): at {}", self.law, self.law.text(), w.place)?;
+        if let Some(p) = w.at {
+            write!(f, " ({:.4}, {:.4})", p.x, p.y)?;
+        }
+        write!(f, ", measured {:.6} against the limit {:.6}", w.value, w.limit)
+    }
+}
+
+/// The verdict of `law` over its measures: held when each measure is at or
+/// below its limit; the worst measure is the one with the largest excess.
+pub fn judge(law: Law, measures: Vec<Measure>) -> LawVerdict {
+    let held = measures.iter().all(Measure::held);
+    let worst = measures
+        .into_iter()
+        .max_by(|a, b| a.excess().total_cmp(&b.excess()))
+        .unwrap_or_else(|| Measure::new(0.0, 0.0, "nothing to measure", None));
+    LawVerdict { law, held, worst }
+}
+
+/// A law that holds because a stage refused with a named reason (the
+/// Prime Directive: refused is a legal result).
+pub fn refused_held(law: Law, e: &Refusal) -> LawVerdict {
+    judge(law, vec![Measure::new(0.0, 0.0, format!("refused by {:?}: {}", e.stage(), e.reason()), e.place())])
+}
+
+/// The five stage planners of one kind.
+pub struct Planners {
+    pub guide: Box<dyn GuidePlanner>,
+    pub order: Box<dyn OrderPlanner>,
+    pub load: Box<dyn LoadPlanner>,
+    pub link: Box<dyn LinkProof>,
+    pub entry: Box<dyn EntryPlanner>,
+}
+
+/// One case of a kind: its region stage, a recipe and the stock.
+pub struct Case {
+    pub name: &'static str,
+    /// The region of the kind for a material side (K1 supplies the real one).
+    pub region: fn(MaterialSide) -> Result<KernelRegion, Refusal>,
+    pub material: MaterialSide,
+    pub recipe: Recipe,
+    /// The stock footprint at the start of the level: the check grid reads it.
+    pub stock: Region,
+    /// The planner's own stock reader, given to the load stage.
+    pub reader: Box<dyn StockRead>,
+    /// The fixture has no split ring: each link must stay at depth.
+    pub no_split: bool,
+    /// The recorded old output (L7): the cut curves in order.
+    pub recorded: Option<Vec<Curve>>,
+}
+
+/// The outputs of the stages of one run, for one start side.
+pub struct Run {
+    pub side: StartSide,
+    pub region: KernelRegion,
+    pub guide: Verdict<GuideSet>,
+    pub ordered: Verdict<OrderedSet>,
+    pub controlled: Verdict<Controlled>,
+    pub plan: Plan,
+    pub tally: LinkTally,
+}
+
+fn live<T: Clone>(v: Verdict<T>) -> Result<(Verdict<T>, T), Refusal> {
+    match v {
+        Verdict::Refused(r) => Err(r),
+        v => {
+            let out = v.out().cloned().ok_or_else(|| Refusal::new(Stage::Recipe, NO_OUTPUT))?;
+            Ok((v, out))
+        }
+    }
+}
+
+pub fn planar(r: &KernelRegion) -> Result<&PlanarRegion, Refusal> {
+    r.planar().ok_or_else(|| Refusal::new(Stage::Region, NOT_PLANAR))
+}
+
+/// Runs the stages of `p` on `c` for the start side `side`: region, guide,
+/// order, load, then one entry, the cuts with a link between each two (a
+/// lift needs a new entry), and one exit.
+pub fn run(p: &Planners, c: &Case, side: StartSide) -> Result<Run, Refusal> {
+    let region = (c.region)(c.material)?;
+    let tool_r = planar(&region)?.tool().radius();
+    let (guide, gs) = live(p.guide.guide(&region, &c.recipe.guide(), GUIDE_TOL)?)?;
+    let oc = OrderChoice { start: side, direction: c.recipe.order().direction };
+    let (ordered, os) = live(p.order.order(gs, &region, &oc, None)?)?;
+    let (controlled, cs) = live(p.load.control(os, &region, c.reader.as_ref(), &c.recipe.load(), tool_r)?)?;
+    let cuts = cs.set().curves().iter().map(|cv| Cut::new(cv.clone(), None)).collect::<Result<Vec<_>, _>>()?;
+    let (mut steps, mut tally, cleared) = (Vec::new(), LinkTally::default(), Region::empty());
+    for (i, cut) in cuts.iter().enumerate() {
+        let lifted = match i.checked_sub(1).and_then(|j| cuts.get(j)) {
+            None => true,
+            Some(prev) => {
+                let hop = p.link.link(prev, cut, &region, &cuts[..i], c.recipe.link(), &mut tally);
+                let lift = matches!(hop, Hop::Lift(_));
+                steps.push(Step::Link(hop));
+                lift
+            }
+        };
+        if lifted {
+            steps.push(Step::Entry(p.entry.entry(cut, &region, &cleared, c.recipe.entry())?));
+        }
+        steps.push(Step::Cut(cut.clone()));
+    }
+    if let Some(last) = cuts.last() {
+        steps.push(Step::Exit(p.entry.exit(last, &region, &cleared)?));
+    }
+    let plan = Plan::new(steps)?;
+    Ok(Run { side, region, guide, ordered, controlled, plan, tally })
+}
+
+/// The region `p` rebuilt with another material side and other part walls.
+pub fn rebuild(p: &PlanarRegion, material: MaterialSide, center: Region, walls: Vec<Loop>) -> Result<KernelRegion, Refusal> {
+    PlanarRegion::new(center, material, walls, p.stock_edge().to_vec(), p.air().clone(), p.keep_out().clone(), p.tool())
+        .map(KernelRegion::Planar)
+}
+
+/// The same region given another way: the loops in reverse order, each
+/// started at its next vertex (L1's permutation).
+pub fn permuted(p: &PlanarRegion) -> Result<KernelRegion, Refusal> {
+    let turn = |ls: &[Loop]| -> Result<Vec<Loop>, Refusal> {
+        ls.iter()
+            .rev()
+            .map(|l| {
+                let mut pts = l.points().to_vec();
+                pts.rotate_left(1);
+                Loop::new(pts).map_err(|_| Refusal::new(Stage::Region, NOT_PLANAR))
+            })
+            .collect()
+    };
+    let center = Region::new(turn(p.center().loops())?).map_err(|_| Refusal::new(Stage::Region, NOT_PLANAR))?;
+    rebuild(p, p.material(), center, turn(p.part_walls())?)
+}
+
+/// The cut curves of a plan, in order.
+pub fn plan_cuts(plan: &Plan) -> Vec<&Curve> {
+    plan.steps().iter().filter_map(|s| if let Step::Cut(c) = s { Some(c.curve()) } else { None }).collect()
+}
+
+/// The points of a curve as a polyline (a closed curve repeats its start).
+pub fn poly(c: &Curve) -> Vec<Point2> {
+    let mut v: Vec<Point2> = c.pts().iter().map(|p| p.at()).collect();
+    if let Some(&p) = v.first().filter(|_| c.closed()) {
+        v.push(p);
+    }
+    v
+}
+
+pub fn dist(a: Point2, b: Point2) -> f64 {
+    (a.x - b.x).hypot(a.y - b.y)
+}
+
+pub fn seg_dist(p: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let len2 = dx * dx + dy * dy;
+    let t = if len2 > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / len2).clamp(0.0, 1.0) } else { 0.0 };
+    dist(p, Point2::new(a.x + t * dx, a.y + t * dy))
+}
+
+pub fn poly_dist(p: Point2, line: &[Point2]) -> f64 {
+    match line {
+        [only] => dist(p, *only),
+        _ => line.windows(2).map(|w| seg_dist(p, w[0], w[1])).fold(f64::INFINITY, f64::min),
+    }
+}
+
+/// The distance of `p` outside `area` (0 inside).
+pub fn outside(area: &Region, p: Point2) -> f64 {
+    if area.contains(p) {
+        return 0.0;
+    }
+    let ring = |l: &Loop| {
+        let mut v = l.points().to_vec();
+        v.extend(l.points().first().copied());
+        poly_dist(p, &v)
+    };
+    area.loops().iter().map(ring).fold(f64::INFINITY, f64::min)
+}
+
+/// The Hausdorff distance of two curves in the plane, read at the vertices.
+pub fn curve_gap(a: &Curve, b: &Curve) -> f64 {
+    let (pa, pb) = (poly(a), poly(b));
+    let one = |from: &[Point2], to: &[Point2]| from.iter().map(|p| poly_dist(*p, to)).fold(0.0, f64::max);
+    one(&pa, &pb).max(one(&pb, &pa))
+}
+
+/// The gap of two curve multisets (order and direction free): each curve of
+/// `a` matched to its nearest unused curve of `b`. A count that differs is
+/// an infinite gap.
+pub fn set_gap(a: &[&Curve], b: &[&Curve]) -> (f64, String) {
+    if a.len() != b.len() {
+        return (f64::INFINITY, format!("{} curves against {}", a.len(), b.len()));
+    }
+    let (mut used, mut worst) = (vec![false; b.len()], (0.0, String::from("each curve")));
+    for (i, ca) in a.iter().enumerate() {
+        let best = b.iter().enumerate().filter(|(j, _)| !used[*j]).map(|(j, cb)| (curve_gap(ca, cb), j)).min_by(|x, y| x.0.total_cmp(&y.0));
+        let Some((g, j)) = best else {
+            return (f64::INFINITY, format!("curve {i} has no partner"));
+        };
+        used[j] = true;
+        if g > worst.0 {
+            worst = (g, format!("curve {i} (k {})", ca.k()));
+        }
+    }
+    worst
+}
+
+/// The gap of two curve sequences, point by point (order and direction
+/// count). A count that differs is an infinite gap.
+pub fn seq_gap(a: &[&Curve], b: &[&Curve]) -> (f64, String) {
+    if a.len() != b.len() {
+        return (f64::INFINITY, format!("{} cuts against {}", a.len(), b.len()));
+    }
+    let mut worst = (0.0, String::from("each cut"));
+    for (i, (ca, cb)) in a.iter().zip(b).enumerate() {
+        let g = if ca.pts().len() == cb.pts().len() {
+            let d = |(p, q): (&camcraft_pathkernel::PlanePoint, &camcraft_pathkernel::PlanePoint)| {
+                dist(p.at(), q.at()).max((p.depth() - q.depth()).abs())
+            };
+            ca.pts().iter().zip(cb.pts()).map(d).fold(0.0, f64::max)
+        } else {
+            f64::INFINITY
+        };
+        if g > worst.0 {
+            worst = (g, format!("cut {i} (k {})", ca.k()));
+        }
+    }
+    worst
+}
+
+pub fn assert_held(v: &LawVerdict) {
+    eprintln!("{v}");
+    assert!(v.held, "{v}");
+}
+
+/// Asserts that the check broke `law` at a place whose text holds `place`.
+pub fn assert_broken(v: &LawVerdict, law: Law, place: &str) {
+    eprintln!("{v}");
+    assert!(!v.held && v.law == law && v.worst.place.contains(place), "expected {law:?} broken at '{place}', got: {v}");
+}
diff --git a/crates/pathkernel/tests/laws/l1_guide.rs b/crates/pathkernel/tests/laws/l1_guide.rs
new file mode 100644
index 000000000..c7733120a
--- /dev/null
+++ b/crates/pathkernel/tests/laws/l1_guide.rs
@@ -0,0 +1,129 @@
+//! L1 (#4027): the same region and the same guide choice give the same
+//! curves. The check calls the guide stage twice, once more on the same
+//! region given another way (loops reversed, each started at its next
+//! vertex), and through each other kind that shares the guide choice. The
+//! canonical sets must match within 1 um (Hausdorff per curve, same count).
+
+use std::cell::Cell;
+
+use camcraft_pathkernel::guide::{GuideChoice, GuidePlanner, GuideSet};
+use camcraft_pathkernel::region::{KernelRegion, MaterialSide};
+use camcraft_pathkernel::{Point2, Refusal, Verdict};
+
+use super::kit::{GUIDE_TOL, Law, LawVerdict, MATCH_TOL, Measure, assert_broken, assert_held, judge, permuted, planar, set_gap};
+use super::standins::{RingGuide, loop_curve, rings, rings_choice, square_region};
+
+type GuideResult = Result<Verdict<GuideSet>, Refusal>;
+
+/// The gap of two guide results: two refusals with the same reason match;
+/// a refusal against curves is an infinite gap.
+fn curves(r: &GuideResult) -> Option<Vec<&camcraft_pathkernel::guide::Curve>> {
+    r.as_ref().ok().and_then(Verdict::out).map(|g| g.curves().iter().collect())
+}
+
+fn gap(a: &GuideResult, b: &GuideResult, what: &str) -> Measure {
+    let reason = |r: &GuideResult| match r {
+        Err(e) | Ok(Verdict::Refused(e)) => Some(e.reason()),
+        Ok(_) => None,
+    };
+    match (curves(a), curves(b)) {
+        (Some(x), Some(y)) => {
+            let (g, place) = set_gap(&x, &y);
+            Measure::new(g, MATCH_TOL, format!("{what}: {place}"), None)
+        }
+        _ if reason(a) == reason(b) => Measure::new(0.0, MATCH_TOL, format!("{what}: refused the same way"), None),
+        _ => Measure::new(f64::INFINITY, MATCH_TOL, format!("{what}: a refusal against curves"), None),
+    }
+}
+
+/// L1 over `guide` on `region` with `choice`; `others` are the guide
+/// planners of other kinds that share the choice.
+pub fn check_l1(guide: &dyn GuidePlanner, region: &KernelRegion, choice: &GuideChoice, others: &[&dyn GuidePlanner]) -> LawVerdict {
+    let base = guide.guide(region, choice, GUIDE_TOL);
+    let mut m = vec![gap(&base, &guide.guide(region, choice, GUIDE_TOL), "a second call")];
+    match planar(region).and_then(permuted) {
+        Ok(turned) => m.push(gap(&base, &guide.guide(&turned, choice, GUIDE_TOL), "the loops permuted and restarted")),
+        Err(e) => m.push(Measure::new(f64::INFINITY, MATCH_TOL, format!("the permuted region: {}", e.reason()), None)),
+    }
+    for (i, o) in others.iter().enumerate() {
+        m.push(gap(&base, &o.guide(region, choice, GUIDE_TOL), &format!("shared guide {i}")));
+    }
+    judge(Law::L1, m)
+}
+
+/// Breaks L1 one way: each call moves the rings a little (hidden state).
+struct Drifting(Cell<u32>);
+
+impl GuidePlanner for Drifting {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, tol: f64) -> GuideResult {
+        let n = self.0.get();
+        self.0.set(n + 1);
+        RingGuide { extra: 0.01 * f64::from(n) }.guide(r, g, tol)
+    }
+}
+
+/// Breaks L1 the other way: the first ring has a seam step at the first
+/// vertex of the first part wall, so the curves depend on how the loops
+/// are given.
+struct Seam;
+
+impl GuidePlanner for Seam {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, _tol: f64) -> GuideResult {
+        let p = planar(r)?;
+        let GuideChoice::Rings(rc) = g else {
+            return RingGuide { extra: 0.0 }.guide(r, g, GUIDE_TOL);
+        };
+        let mut curves = rings(p.center(), rc.first_offset(), rc.stepover(), rc.count())?;
+        if let (Some(w), Some(first)) = (p.part_walls().first().and_then(|l| l.points().first()), curves.first().cloned()) {
+            let seam = camcraft_pathkernel::Loop::new(
+                first
+                    .pts()
+                    .iter()
+                    .map(|q| {
+                        if (q.at().x - w.x).abs() < 3.0 && (q.at().y - w.y).abs() < 3.0 {
+                            Point2::new(q.at().x + 0.5, q.at().y + 0.5)
+                        } else {
+                            q.at()
+                        }
+                    })
+                    .collect(),
+            );
+            if let Ok(l) = seam {
+                curves[0] = loop_curve(&l, first.k())?;
+            }
+        }
+        Ok(Verdict::done(GuideSet::new(curves)))
+    }
+}
+
+fn region() -> KernelRegion {
+    square_region(MaterialSide::Inside).expect("fixture")
+}
+
+#[test]
+fn l1_holds_for_a_pure_guide_and_a_shared_guide() {
+    let (g, other) = (RingGuide { extra: 0.0 }, RingGuide { extra: 0.0 });
+    let v = check_l1(&g, &region(), &rings_choice().unwrap(), &[&other]);
+    assert_held(&v);
+    assert_eq!(v.worst.value, 0.0, "{v}");
+}
+
+#[test]
+fn l1_breaks_for_a_guide_with_hidden_state() {
+    let v = check_l1(&Drifting(Cell::new(0)), &region(), &rings_choice().unwrap(), &[]);
+    // Each later call drifts more: the third call (the permuted region) is the worst.
+    assert_broken(&v, Law::L1, "curve");
+    assert!(v.worst.value >= 0.01 - MATCH_TOL, "{v}");
+}
+
+#[test]
+fn l1_breaks_for_a_guide_that_reads_the_loop_start() {
+    let v = check_l1(&Seam, &region(), &rings_choice().unwrap(), &[]);
+    assert_broken(&v, Law::L1, "permuted");
+}
+
+#[test]
+fn l1_breaks_when_two_kinds_with_one_guide_choice_differ() {
+    let v = check_l1(&RingGuide { extra: 0.0 }, &region(), &rings_choice().unwrap(), &[&RingGuide { extra: 0.05 }]);
+    assert_broken(&v, Law::L1, "shared guide 0");
+}
diff --git a/crates/pathkernel/tests/laws/l2_sides.rs b/crates/pathkernel/tests/laws/l2_sides.rs
new file mode 100644
index 000000000..1d470eab2
--- /dev/null
+++ b/crates/pathkernel/tests/laws/l2_sides.rs
@@ -0,0 +1,113 @@
+//! L2 (#4027): the material side and the start side are separate
+//! parameters. At compile level the region stage takes no start side and
+//! the order stage takes no material side (the trait signatures). The check
+//! reads the behaviour: flipping the material side changes the centre area,
+//! and the order stage gives the same sequence for two regions that differ
+//! only in their material side.
+
+use camcraft_pathkernel::guide::GuideSet;
+use camcraft_pathkernel::order::{OrderChoice, OrderPlanner, OrderedSet, StartSide};
+use camcraft_pathkernel::region::{KernelRegion, MaterialSide};
+use camcraft_pathkernel::{Refusal, Region, Verdict};
+
+use super::kit::{Law, LawVerdict, MATCH_TOL, Measure, assert_broken, assert_held, dist, judge, planar, rebuild, seq_gap};
+use super::standins::{RingGuide, SideOrder, order_curves, resolve, rings_choice, square_region};
+
+/// The compile-level half: a region stage is a function of the material
+/// side alone. This line stops compiling if a start side is added.
+const _REGION_STAGE: fn(MaterialSide) -> Result<KernelRegion, Refusal> = square_region;
+
+/// The area of the symmetric difference of two regions.
+fn sym_diff(a: &Region, b: &Region) -> f64 {
+    let one = |x: &Region, y: &Region| x.difference(y).map_or(f64::INFINITY, |d| d.area().abs());
+    one(a, b) + one(b, a)
+}
+
+fn ordered(o: &dyn OrderPlanner, g: &GuideSet, r: &KernelRegion, oc: &OrderChoice) -> Option<OrderedSet> {
+    o.order(g.clone(), r, oc, None).ok().and_then(|v| v.out().cloned())
+}
+
+/// L2 over the region stage `region` and the order stage `order` on the
+/// guide set `guide`, for each start side with the direction of `choice`.
+pub fn check_l2(
+    region: fn(MaterialSide) -> Result<KernelRegion, Refusal>,
+    order: &dyn OrderPlanner,
+    guide: &GuideSet,
+    choice: OrderChoice,
+) -> LawVerdict {
+    let mut m = Vec::new();
+    match (region(MaterialSide::Inside), region(MaterialSide::Outside)) {
+        (Ok(a), Ok(b)) => {
+            let d = match (planar(&a), planar(&b)) {
+                (Ok(pa), Ok(pb)) => sym_diff(pa.center(), pb.center()),
+                _ => 0.0,
+            };
+            let same = usize::from(d <= MATCH_TOL);
+            m.push(Measure::count(same, format!("region: Inside and Outside centres differ by {d:.4} mm2"), None));
+        }
+        (Err(e), _) | (_, Err(e)) => m.push(Measure::new(0.0, 0.0, format!("region: one side refused ({})", e.reason()), None)),
+    }
+    let Ok(inside) = region(MaterialSide::Inside) else {
+        return judge(Law::L2, m);
+    };
+    let flipped = planar(&inside).and_then(|p| rebuild(p, MaterialSide::Outside, p.center().clone(), p.part_walls().to_vec()));
+    let Ok(flipped) = flipped else {
+        return judge(Law::L2, m);
+    };
+    for side in [StartSide::Auto, StartSide::Inside, StartSide::Outside] {
+        let oc = OrderChoice { start: side, direction: choice.direction };
+        let place = format!("order, start side {side:?}: the material side changed");
+        match (ordered(order, guide, &inside, &oc), ordered(order, guide, &flipped, &oc)) {
+            (Some(a), Some(b)) => {
+                let (x, y): (Vec<_>, Vec<_>) = (a.curves().iter().collect(), b.curves().iter().collect());
+                let (g, at) = seq_gap(&x, &y);
+                m.push(Measure::new(g.max(dist(a.start(), b.start())), MATCH_TOL, format!("{place} {at}"), Some(a.start())));
+            }
+            (None, None) => m.push(Measure::new(0.0, MATCH_TOL, format!("{place}: refused both times"), None)),
+            _ => m.push(Measure::new(f64::INFINITY, MATCH_TOL, format!("{place}: refused one time"), None)),
+        }
+    }
+    judge(Law::L2, m)
+}
+
+/// Breaks L2: the centre does not follow the material side.
+fn blind_region(_m: MaterialSide) -> Result<KernelRegion, Refusal> {
+    square_region(MaterialSide::Inside)
+}
+
+/// Breaks L2: the order reads the material side and starts outside for it.
+struct MaterialOrder;
+
+impl OrderPlanner for MaterialOrder {
+    fn order(&self, g: GuideSet, r: &KernelRegion, o: &OrderChoice, _s: Option<&Region>) -> Result<Verdict<OrderedSet>, Refusal> {
+        let side = match planar(r)?.material() {
+            MaterialSide::Outside => StartSide::Outside,
+            MaterialSide::Inside => resolve(o.start),
+        };
+        Ok(Verdict::done(order_curves(&g, g.curves().to_vec(), side, o.direction)?))
+    }
+}
+
+fn guide() -> GuideSet {
+    use camcraft_pathkernel::guide::GuidePlanner;
+    let r = square_region(MaterialSide::Inside).unwrap();
+    RingGuide { extra: 0.0 }.guide(&r, &rings_choice().unwrap(), 1e-3).unwrap().out().unwrap().clone()
+}
+
+#[test]
+fn l2_holds_for_a_region_and_an_order_that_keep_the_sides_apart() {
+    assert_held(&check_l2(square_region, &SideOrder, &guide(), OrderChoice::default()));
+}
+
+#[test]
+fn l2_breaks_for_a_region_that_ignores_the_material_side() {
+    assert_broken(&check_l2(blind_region, &SideOrder, &guide(), OrderChoice::default()), Law::L2, "region: Inside and Outside");
+}
+
+#[test]
+fn l2_breaks_for_an_order_that_reads_the_material_side() {
+    let v = check_l2(square_region, &MaterialOrder, &guide(), OrderChoice::default());
+    assert_broken(&v, Law::L2, "order, start side");
+    assert!(!v.worst.place.contains("Outside"), "the Outside start reads the same for both sides: {v}");
+    assert!(v.worst.value > 1.0, "{v}");
+}
diff --git a/crates/pathkernel/tests/laws/l3_order.rs b/crates/pathkernel/tests/laws/l3_order.rs
new file mode 100644
index 000000000..56b0f8af9
--- /dev/null
+++ b/crates/pathkernel/tests/laws/l3_order.rs
@@ -0,0 +1,103 @@
+//! L3 (#4027): the start side changes only the order and the start point.
+//! The check runs the stages for Auto, Inside and Outside. For each side the
+//! ordered curves must be the guide curves as an undirected multiset, and
+//! the guide output and the ordered multiset must be the same for each
+//! side (within 1 um). The kernel's `OrderedSet` already refuses a set that
+//! is not a permutation of its input; this check also catches an order
+//! stage that gives the set another input.
+
+use camcraft_pathkernel::guide::{Curve, GuideSet};
+use camcraft_pathkernel::order::{OrderChoice, OrderPlanner, OrderedSet, StartSide};
+use camcraft_pathkernel::region::KernelRegion;
+use camcraft_pathkernel::{PlanePoint, Point2, Refusal, Region, Verdict};
+
+use super::kit::{Case, Law, LawVerdict, MATCH_TOL, Measure, Planners, Run, assert_broken, assert_held, judge, run, set_gap};
+use super::standins::{SideOrder, good, order_curves, resolve, square_case};
+
+const SIDES: [StartSide; 3] = [StartSide::Auto, StartSide::Inside, StartSide::Outside];
+
+fn guide_curves(r: &Run) -> Vec<&Curve> {
+    r.guide.out().map(|g| g.curves().iter().collect()).unwrap_or_default()
+}
+
+fn order_curves_of(r: &Run) -> Vec<&Curve> {
+    r.ordered.out().map(|o| o.curves().iter().collect()).unwrap_or_default()
+}
+
+/// L3 over the planners `p` on the case `c`.
+pub fn check_l3(p: &Planners, c: &Case) -> LawVerdict {
+    let runs: Vec<(StartSide, Result<Run, Refusal>)> = SIDES.iter().map(|&s| (s, run(p, c, s))).collect();
+    let mut m = Vec::new();
+    let ok: Vec<&Run> = runs.iter().filter_map(|(_, r)| r.as_ref().ok()).collect();
+    if ok.len() != runs.len() {
+        let refused: Vec<String> = runs.iter().filter_map(|(s, r)| r.as_ref().err().map(|e| format!("{s:?} ({})", e.reason()))).collect();
+        let n = if ok.is_empty() { 0 } else { refused.len() };
+        m.push(Measure::count(n, format!("refused for {}", refused.join(", ")), None));
+    }
+    for r in &ok {
+        let (g, at) = set_gap(&order_curves_of(r), &guide_curves(r));
+        m.push(Measure::new(g, MATCH_TOL, format!("start side {:?}: the ordered curves against the guide, {at}", r.side), None));
+    }
+    if let Some((first, rest)) = ok.split_first() {
+        for r in rest {
+            let (g, at) = set_gap(&guide_curves(first), &guide_curves(r));
+            m.push(Measure::new(g, MATCH_TOL, format!("guide, {:?} against {:?}: {at}", first.side, r.side), None));
+            let (g, at) = set_gap(&order_curves_of(first), &order_curves_of(r));
+            m.push(Measure::new(g, MATCH_TOL, format!("ordered set, {:?} against {:?}: {at}", first.side, r.side), None));
+        }
+    }
+    judge(Law::L3, m)
+}
+
+/// The guide set of `g` with each point moved by `dx` and with the last
+/// `drop` curves left out: another input for the ordered set.
+fn other_input(g: &GuideSet, dx: f64, drop: usize) -> Result<GuideSet, Refusal> {
+    let keep = g.curves().len().saturating_sub(drop);
+    let moved = g.curves()[..keep]
+        .iter()
+        .map(|c| {
+            let pts =
+                c.pts().iter().map(|p| PlanePoint::new(Point2::new(p.at().x + dx, p.at().y), p.depth())).collect::<Result<Vec<_>, _>>()?;
+            Curve::new(pts, c.arc(), c.closed(), c.k(), c.family())
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok(GuideSet::new(moved))
+}
+
+/// Breaks L3: for the Outside start it moves the curves 0.1 mm, or drops
+/// one, and gives the moved set to the ordered set as its input.
+struct SideMoves {
+    dx: f64,
+    drop: usize,
+}
+
+impl OrderPlanner for SideMoves {
+    fn order(&self, g: GuideSet, r: &KernelRegion, o: &OrderChoice, s: Option<&Region>) -> Result<Verdict<OrderedSet>, Refusal> {
+        if o.start != StartSide::Outside {
+            return SideOrder.order(g, r, o, s);
+        }
+        let other = other_input(&g, self.dx, self.drop)?;
+        Ok(Verdict::done(order_curves(&other, other.curves().to_vec(), resolve(o.start), o.direction)?))
+    }
+}
+
+#[test]
+fn l3_holds_for_an_order_that_only_permutes_restarts_and_reverses() {
+    assert_held(&check_l3(&good(), &square_case().unwrap()));
+}
+
+#[test]
+fn l3_breaks_for_an_order_that_moves_the_curves_for_one_side() {
+    let p = Planners { order: Box::new(SideMoves { dx: 0.1, drop: 0 }), ..good() };
+    let v = check_l3(&p, &square_case().unwrap());
+    assert_broken(&v, Law::L3, "Outside");
+    assert!((v.worst.value - 0.1).abs() < 1e-6, "{v}");
+}
+
+#[test]
+fn l3_breaks_for_an_order_that_drops_a_curve_for_one_side() {
+    let p = Planners { order: Box::new(SideMoves { dx: 0.0, drop: 1 }), ..good() };
+    let v = check_l3(&p, &square_case().unwrap());
+    assert_broken(&v, Law::L3, "Outside");
+    assert!(v.worst.value.is_infinite(), "{v}");
+}
diff --git a/crates/pathkernel/tests/laws/l4_fallback.rs b/crates/pathkernel/tests/laws/l4_fallback.rs
new file mode 100644
index 000000000..33aefeffb
--- /dev/null
+++ b/crates/pathkernel/tests/laws/l4_fallback.rs
@@ -0,0 +1,118 @@
+//! L4 (#4027): a fallback is visible; the status line names it. The check
+//! reads what each stage used against what the recipe asked: a guide whose
+//! curves are of another family than the asked guide, or an entry into
+//! material of another kind than the asked one, must carry a named
+//! fallback of its stage. An entry into air, a pre-drilled hole or a
+//! cleared column is the safer entry of the record's order of tries, not a
+//! fallback.
+
+use camcraft_pathkernel::entry::{Entry, EntryChoice, EntryKind, EntryPlanner, Exit};
+use camcraft_pathkernel::guide::{Family, GuideChoice, GuidePlanner, GuideSet, RowsChoice};
+use camcraft_pathkernel::link::LinkPolicy;
+use camcraft_pathkernel::plan::{Cut, Step};
+use camcraft_pathkernel::region::KernelRegion;
+use camcraft_pathkernel::{Fallback, Recipe, Refusal, Region, Stage, Verdict};
+
+use super::kit::{Case, Law, LawVerdict, Measure, Planners, Run, assert_broken, assert_held, judge, planar, run};
+use super::standins::{ProvedEntry, STEP, good, helix, recipe, rings, rings_choice, square_case, start_of};
+
+fn family(g: &GuideChoice) -> Option<Family> {
+    match g {
+        GuideChoice::Rings(_) => Some(Family::Ring),
+        GuideChoice::Rows(_) => Some(Family::Row),
+        GuideChoice::Medial => Some(Family::Medial),
+        GuideChoice::Trace(_) => Some(Family::Trace),
+        _ => None,
+    }
+}
+
+/// The fallbacks and notes of one stage in a verdict.
+fn named<T>(v: &Verdict<T>, stage: Stage) -> usize {
+    match v {
+        Verdict::Done { fallbacks, .. } => fallbacks.iter().filter(|f| f.stage() == stage).count(),
+        Verdict::Incomplete { notes, .. } => notes.iter().filter(|n| n.stage() == stage).count(),
+        Verdict::Refused(_) => 0,
+    }
+}
+
+fn into_material(k: EntryKind) -> bool {
+    !matches!(k, EntryKind::Air | EntryKind::Predrilled | EntryKind::ClearedColumn)
+}
+
+/// L4 over one run of the recipe `recipe`.
+pub fn check_l4(run: &Run, recipe: &Recipe) -> LawVerdict {
+    let mut m = Vec::new();
+    let asked = family(&recipe.guide());
+    let rows_ring = |f: Family| matches!(recipe.guide(), GuideChoice::Rows(r) if r.closing_ring()) && f == Family::Ring;
+    let used: Vec<Family> = run.guide.out().map(|g| g.curves().iter().map(|c| c.family()).collect()).unwrap_or_default();
+    let other = used.iter().filter(|&&f| Some(f) != asked && !rows_ring(f)).count();
+    let names = named(&run.guide, Stage::Guide);
+    let silent = if other > 0 && names == 0 { other } else { 0 };
+    m.push(Measure::count(silent, format!("guide: {other} curves of another family than asked ({asked:?}), {names} named"), None));
+    let entries = run.plan.steps().iter().filter_map(|s| if let Step::Entry(e) = s { Some(e) } else { None });
+    for (i, e) in entries.enumerate() {
+        let wrong = into_material(e.kind()) && e.kind() != recipe.entry().asked();
+        let at = e.descent().first().map(|p| p.at());
+        let place =
+            format!("entry {i}: used {:?}, asked {:?}, and the entry stage has no fallback record", e.kind(), recipe.entry().asked());
+        m.push(Measure::count(usize::from(wrong), place, at));
+    }
+    judge(Law::L4, m)
+}
+
+/// Plans rings where rows were asked (a narrow neck); `named` says so.
+struct RowsAsRings {
+    named: bool,
+}
+
+impl GuidePlanner for RowsAsRings {
+    fn guide(&self, r: &KernelRegion, _g: &GuideChoice, _tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let v = Verdict::done(GuideSet::new(rings(planar(r)?.center(), 0.0, STEP, None)?));
+        if !self.named {
+            return Ok(v);
+        }
+        Ok(v.with_fallback(Fallback::new(Stage::Guide, "rows", "rings", "the rows do not fit the narrow neck")?))
+    }
+}
+
+/// Breaks L4: a ramp where a helix was asked, with no record.
+struct RampInstead;
+
+impl EntryPlanner for RampInstead {
+    fn entry(&self, first: &Cut, r: &KernelRegion, _cleared: &Region, e: &EntryChoice) -> Result<Entry, Refusal> {
+        helix(start_of(first), r, e, EntryKind::Ramp)
+    }
+    fn exit(&self, last: &Cut, r: &KernelRegion, cleared: &Region) -> Result<Exit, Refusal> {
+        ProvedEntry.exit(last, r, cleared)
+    }
+}
+
+fn rows_case() -> Case {
+    let rows = GuideChoice::Rows(RowsChoice::new(0.0, STEP, false).unwrap());
+    Case { recipe: recipe(rows, EntryKind::Helix, LinkPolicy::StayWhereProved).unwrap(), ..square_case().unwrap() }
+}
+
+fn l4(p: &Planners, c: &Case) -> LawVerdict {
+    check_l4(&run(p, c, Default::default()).unwrap(), &c.recipe)
+}
+
+#[test]
+fn l4_holds_for_the_asked_stages_and_for_a_named_fallback() {
+    let c = square_case().unwrap();
+    assert_eq!(c.recipe.guide(), rings_choice().unwrap());
+    assert_held(&l4(&good(), &c));
+    assert_held(&l4(&Planners { guide: Box::new(RowsAsRings { named: true }), ..good() }, &rows_case()));
+}
+
+#[test]
+fn l4_breaks_for_a_silent_guide_fallback() {
+    let v = l4(&Planners { guide: Box::new(RowsAsRings { named: false }), ..good() }, &rows_case());
+    assert_broken(&v, Law::L4, "guide:");
+    assert!(v.worst.value >= 1.0, "{v}");
+}
+
+#[test]
+fn l4_breaks_for_a_silent_entry_fallback() {
+    let v = l4(&Planners { entry: Box::new(RampInstead), ..good() }, &square_case().unwrap());
+    assert_broken(&v, Law::L4, "entry 0: used Ramp, asked Helix");
+}
diff --git a/crates/pathkernel/tests/laws/l5_entry.rs b/crates/pathkernel/tests/laws/l5_entry.rs
new file mode 100644
index 000000000..1337006af
--- /dev/null
+++ b/crates/pathkernel/tests/laws/l5_entry.rs
@@ -0,0 +1,105 @@
+//! L5 (#4027): an entry into material needs a proof; else the kernel
+//! refuses with a reason. The kernel's `Entry` already binds each descent
+//! to the place that its proof names. This check reads each descent on the
+//! check's own stock grid, as the stock is at that step of the plan: a
+//! descent onto material with a proof other than `IntoMaterial` (air, a
+//! hole, a cleared column) is a breach.
+
+use camcraft_pathkernel::entry::{Area, Entry, EntryChoice, EntryKind, EntryPlanner, Exit, Proof};
+use camcraft_pathkernel::plan::Cut;
+use camcraft_pathkernel::region::KernelRegion;
+use camcraft_pathkernel::{PlanePoint, Refusal, Region};
+
+use super::grid::walk;
+use super::kit::{Case, Law, LawVerdict, Measure, Planners, Run, assert_broken, assert_held, judge, planar, refused_held, run};
+use super::standins::{ProvedEntry, good, square_area, square_case, start_of};
+
+/// A descent whose tool disc holds more material than this share is a
+/// descent into material.
+pub const ENTRY_FILL: f64 = 0.02;
+
+/// Refusal reason of the check: the stock of the case is empty.
+pub const NO_STOCK: &str = "the case has no stock to read";
+
+/// L5 over one run of the case `c`, or over its refusal.
+pub fn check_l5(run: &Result<Run, Refusal>, c: &Case) -> LawVerdict {
+    let r = match run {
+        Ok(r) => r,
+        Err(e) => return refused_held(Law::L5, e),
+    };
+    let Ok(tool_r) = planar(&r.region).map(|p| p.tool().radius()) else {
+        return judge(Law::L5, vec![Measure::new(f64::INFINITY, 0.0, "the region is not planar", None)]);
+    };
+    let Some(w) = walk(&r.plan, &c.stock, tool_r) else {
+        return judge(Law::L5, vec![Measure::new(f64::INFINITY, 0.0, NO_STOCK, None)]);
+    };
+    let m = w
+        .entries
+        .iter()
+        .map(|e| {
+            let v = if e.into_material { 0.0 } else { e.fill };
+            let place = format!("entry {}: material share {:.3} under the tool, proof into material: {}", e.index, e.fill, e.into_material);
+            Measure::new(v, ENTRY_FILL, place, Some(e.at))
+        })
+        .collect();
+    judge(Law::L5, m)
+}
+
+/// Breaks L5: claims air (or a cleared column) at each entry, wherever it is.
+struct ClaimsFree {
+    column: bool,
+}
+
+impl EntryPlanner for ClaimsFree {
+    fn entry(&self, first: &Cut, r: &KernelRegion, _cleared: &Region, e: &EntryChoice) -> Result<Entry, Refusal> {
+        let at = start_of(first);
+        let tool = planar(r)?.tool();
+        let area = Area::new(square_area(at, 2.0)?)?;
+        let (kind, proof) =
+            if self.column { (EntryKind::ClearedColumn, Proof::InColumn(area)) } else { (EntryKind::Air, Proof::InAir(area)) };
+        Entry::new(kind, vec![], vec![PlanePoint::flat(at)?], proof, e, tool)
+    }
+    fn exit(&self, last: &Cut, r: &KernelRegion, cleared: &Region) -> Result<Exit, Refusal> {
+        ProvedEntry.exit(last, r, cleared)
+    }
+}
+
+/// Refuses each entry with a reason (no legal entry).
+struct NoEntry;
+
+const NO_LEGAL_ENTRY: &str = "no legal entry: the helix does not fit and no hole is pre-drilled";
+
+impl EntryPlanner for NoEntry {
+    fn entry(&self, _f: &Cut, _r: &KernelRegion, _c: &Region, _e: &EntryChoice) -> Result<Entry, Refusal> {
+        Err(Refusal::new(camcraft_pathkernel::Stage::Entry, NO_LEGAL_ENTRY))
+    }
+    fn exit(&self, last: &Cut, r: &KernelRegion, cleared: &Region) -> Result<Exit, Refusal> {
+        ProvedEntry.exit(last, r, cleared)
+    }
+}
+
+fn l5(p: &Planners) -> LawVerdict {
+    let c = square_case().unwrap();
+    check_l5(&run(p, &c, Default::default()), &c)
+}
+
+#[test]
+fn l5_holds_for_a_proved_helix_and_for_a_named_refusal() {
+    assert_held(&l5(&good()));
+    let v = l5(&Planners { entry: Box::new(NoEntry), ..good() });
+    assert_held(&v);
+    assert!(v.worst.place.contains(NO_LEGAL_ENTRY), "{v}");
+}
+
+#[test]
+fn l5_breaks_for_an_air_proof_on_material() {
+    let v = l5(&Planners { entry: Box::new(ClaimsFree { column: false }), ..good() });
+    assert_broken(&v, Law::L5, "entry 0: material share");
+    assert!(v.worst.value > 0.9, "{v}");
+}
+
+#[test]
+fn l5_breaks_for_a_cleared_column_proof_on_material() {
+    let v = l5(&Planners { entry: Box::new(ClaimsFree { column: true }), ..good() });
+    assert_broken(&v, Law::L5, "entry 0");
+}
diff --git a/crates/pathkernel/tests/laws/l6_load.rs b/crates/pathkernel/tests/laws/l6_load.rs
new file mode 100644
index 000000000..0bae12f33
--- /dev/null
+++ b/crates/pathkernel/tests/laws/l6_load.rs
@@ -0,0 +1,61 @@
+//! L6 (#4027): a cut above the engagement limit is prevented or named. The
+//! kernel's `Controlled` already refuses a reading above the limit that its
+//! over-limit list does not name. This check reads each cut again on the
+//! check's own stock grid, as the stock is at that step of the plan: each
+//! read above `limit x (1 + PLAN_TOL)` (plus the grid's read error) must
+//! have an over-limit record within one tool radius of its place.
+
+use camcraft_pathkernel::Refusal;
+use camcraft_pathkernel::load::PLAN_TOL;
+
+use super::grid::{GRID_TOL, walk};
+use super::kit::{Case, Law, LawVerdict, Measure, Planners, Run, assert_broken, assert_held, dist, judge, planar, refused_held, run};
+use super::l5_entry::NO_STOCK;
+use super::standins::{LIMIT, ReadLoad, good, island_case, square_case};
+
+/// L6 over one run of the case `c`, or over its refusal.
+pub fn check_l6(run: &Result<Run, Refusal>, c: &Case) -> LawVerdict {
+    let r = match run {
+        Ok(r) => r,
+        Err(e) => return refused_held(Law::L6, e),
+    };
+    let (Some(ctl), Ok(tool_r)) = (r.controlled.out(), planar(&r.region).map(|p| p.tool().radius())) else {
+        return judge(Law::L6, vec![Measure::new(f64::INFINITY, 0.0, "no load output or no planar region", None)]);
+    };
+    let Some(w) = walk(&r.plan, &c.stock, tool_r) else {
+        return judge(Law::L6, vec![Measure::new(f64::INFINITY, 0.0, NO_STOCK, None)]);
+    };
+    let cap = ctl.limit() * (1.0 + PLAN_TOL) + GRID_TOL;
+    let mut m: Vec<Measure> = w
+        .cuts
+        .iter()
+        .map(|k| {
+            let named = ctl.over().iter().any(|o| dist(o.at(), k.at) <= tool_r);
+            let v = if named { 0.0 } else { k.load };
+            Measure::new(v, cap, format!("cut {}: ae/D {:.3}, named: {named}", k.index, k.load), Some(k.at))
+        })
+        .collect();
+    let top = w.cuts.iter().map(|k| k.load).fold(0.0, f64::max);
+    m.push(Measure::new(0.0, cap, format!("the highest read ae/D is {top:.3}"), None));
+    judge(Law::L6, m)
+}
+
+fn l6(p: &Planners, c: &Case) -> LawVerdict {
+    check_l6(&run(p, c, Default::default()), c)
+}
+
+#[test]
+fn l6_holds_when_each_full_width_cut_is_named() {
+    for c in [square_case().unwrap(), island_case().unwrap()] {
+        let v = l6(&good(), &c);
+        assert_held(&v);
+        assert!((v.worst.limit - (LIMIT * (1.0 + PLAN_TOL) + GRID_TOL)).abs() < 1e-12, "{}: {v}", c.name);
+    }
+}
+
+#[test]
+fn l6_breaks_for_a_load_stage_that_reads_a_slot_as_a_side_cut() {
+    let v = l6(&Planners { load: Box::new(ReadLoad { blind: true }), ..good() }, &square_case().unwrap());
+    assert_broken(&v, Law::L6, "named: false");
+    assert!(v.worst.value > 0.9, "a full-width slot: {v}");
+}
diff --git a/crates/pathkernel/tests/laws/l7_move.rs b/crates/pathkernel/tests/laws/l7_move.rs
new file mode 100644
index 000000000..9c12af588
--- /dev/null
+++ b/crates/pathkernel/tests/laws/l7_move.rs
@@ -0,0 +1,81 @@
+//! L7 (#4027): a move that migrates keeps its output. The check compares
+//! the cuts of the kernel's plan, in order and point by point, with the
+//! recorded old output of the case (within 1 um). The comparison harness of
+//! `camcraft-app` gives the record from the golden `.cl` of the old planner;
+//! a case with no record is a breach, so that no kind moves without one.
+
+use camcraft_pathkernel::Refusal;
+use camcraft_pathkernel::guide::Curve;
+use camcraft_pathkernel::order::Direction;
+use camcraft_pathkernel::plan::Plan;
+
+use super::kit::{Law, LawVerdict, MATCH_TOL, Measure, Planners, Run, assert_broken, assert_held, judge, plan_cuts, run, seq_gap};
+use super::standins::{RingGuide, good, square_case};
+
+/// L7 of the kernel plan `plan` against the record `recorded`.
+pub fn check_l7(recorded: Option<&[Curve]>, plan: &Result<Plan, Refusal>) -> LawVerdict {
+    let Some(old) = recorded else {
+        return judge(Law::L7, vec![Measure::new(f64::INFINITY, MATCH_TOL, "the case has no recorded old output", None)]);
+    };
+    let old: Vec<&Curve> = old.iter().collect();
+    let m = match plan {
+        Ok(p) => {
+            let (g, at) = seq_gap(&old, &plan_cuts(p));
+            Measure::new(g, MATCH_TOL, at, None)
+        }
+        Err(e) if old.is_empty() => Measure::new(0.0, MATCH_TOL, format!("no old cuts, refused: {}", e.reason()), None),
+        Err(e) => Measure::new(f64::INFINITY, MATCH_TOL, format!("the old planner cut, the kernel refused: {}", e.reason()), None),
+    };
+    judge(Law::L7, vec![m])
+}
+
+fn record() -> Vec<Curve> {
+    let r = run(&good(), &square_case().unwrap(), Default::default()).unwrap();
+    plan_cuts(&r.plan).into_iter().cloned().collect()
+}
+
+fn l7(p: &Planners, conventional: bool) -> LawVerdict {
+    let mut c = square_case().unwrap();
+    if conventional {
+        let o = c.recipe.order();
+        let flip = camcraft_pathkernel::order::OrderChoice { direction: Direction::Conventional, ..o };
+        c.recipe = camcraft_pathkernel::Recipe::new(
+            *c.recipe.plane(),
+            c.recipe.axis(),
+            c.recipe.guide(),
+            c.recipe.load(),
+            flip,
+            c.recipe.link(),
+            c.recipe.entry().clone(),
+        )
+        .unwrap();
+    }
+    let rec = record();
+    check_l7(Some(&rec), &run(p, &c, Default::default()).map(|r: Run| r.plan))
+}
+
+#[test]
+fn l7_holds_for_the_same_output() {
+    let v = l7(&good(), false);
+    assert_held(&v);
+    assert_eq!(v.worst.value, 0.0, "{v}");
+}
+
+#[test]
+fn l7_breaks_for_a_moved_ring() {
+    let v = l7(&Planners { guide: Box::new(RingGuide { extra: 0.01 }), ..good() }, false);
+    assert_broken(&v, Law::L7, "cut");
+}
+
+#[test]
+fn l7_breaks_for_another_direction() {
+    let v = l7(&good(), true);
+    assert_broken(&v, Law::L7, "cut");
+    assert!(v.worst.value > 1.0, "a reversed ring: {v}");
+}
+
+#[test]
+fn l7_breaks_without_a_record() {
+    let r = run(&good(), &square_case().unwrap(), Default::default()).map(|r| r.plan);
+    assert_broken(&check_l7(None, &r), Law::L7, "no recorded old output");
+}
diff --git a/crates/pathkernel/tests/laws/link_rule.rs b/crates/pathkernel/tests/laws/link_rule.rs
new file mode 100644
index 000000000..cb10e786b
--- /dev/null
+++ b/crates/pathkernel/tests/laws/link_rule.rs
@@ -0,0 +1,116 @@
+//! The link rule (#4023 stage 5, #4027): stay at depth; lift only with a
+//! named reason. The check counts the lifts of the plan against the link
+//! tally (in total and by reason), counts the lifts on a fixture with no
+//! split ring (there must be none), and reads each stay-down hop - from
+//! the end of its cut, along its points, to the start of the next cut - for
+//! a crossing out of the centre area and the air.
+
+use std::collections::BTreeMap;
+
+use camcraft_pathkernel::link::{Hop, LinkPolicy, LinkProof, LinkTally};
+use camcraft_pathkernel::plan::{Cut, Step};
+use camcraft_pathkernel::region::KernelRegion;
+use camcraft_pathkernel::{Point2, Refusal};
+
+use super::grid::samples;
+use super::kit::{
+    Case, Law, LawVerdict, MATCH_TOL, Measure, Planners, Run, assert_broken, assert_held, judge, outside, planar, refused_held, run,
+};
+use super::standins::{LEAVES_AREA, end_of, good, island_case, square_case, start_of};
+
+/// L-link over one run of the case `c`, or over its refusal.
+pub fn check_link(run: &Result<Run, Refusal>, c: &Case) -> LawVerdict {
+    let r = match run {
+        Ok(r) => r,
+        Err(e) => return refused_held(Law::Link, e),
+    };
+    let steps = r.plan.steps();
+    let mut by_reason: BTreeMap<&'static str, u32> = BTreeMap::new();
+    for s in steps {
+        if let Step::Link(Hop::Lift(why)) = s {
+            *by_reason.entry(why.get()).or_insert(0) += 1;
+        }
+    }
+    let lifts: u32 = by_reason.values().sum();
+    let tally = r.tally.lifts();
+    let mut m =
+        vec![Measure::new(f64::from(lifts.abs_diff(tally)), 0.0, format!("lifts: {lifts} in the plan, {tally} in the tally"), None)];
+    let odd = by_reason.iter().filter(|(k, v)| r.tally.by_reason().get(*k) != Some(*v)).count();
+    m.push(Measure::count(odd, format!("lift reasons: {by_reason:?} in the plan, {:?} in the tally", r.tally.by_reason()), None));
+    if c.no_split {
+        m.push(Measure::new(f64::from(lifts), 0.0, format!("lifts on a fixture with no split ring: {by_reason:?}"), None));
+    }
+    let Ok(p) = planar(&r.region) else {
+        return judge(Law::Link, m);
+    };
+    for (i, s) in steps.iter().enumerate() {
+        let Step::Link(Hop::Stay(path)) = s else {
+            continue;
+        };
+        let cut = |j: Option<usize>| match j.and_then(|j| steps.get(j)) {
+            Some(Step::Cut(c)) => Some(c),
+            _ => None,
+        };
+        let mut line: Vec<Point2> = cut(i.checked_sub(1)).map(end_of).into_iter().collect();
+        line.extend(path.points());
+        line.extend(cut(i.checked_add(1)).map(start_of));
+        let worst = samples(&line, 0.05)
+            .iter()
+            .map(|(q, _)| (outside(p.center(), *q).min(outside(p.air(), *q)), *q))
+            .max_by(|a, b| a.0.total_cmp(&b.0));
+        if let Some((d, q)) = worst {
+            m.push(Measure::new(d, MATCH_TOL, format!("stay link at step {i}: a crossing out of the area"), Some(q)));
+        }
+    }
+    judge(Law::Link, m)
+}
+
+/// Breaks the link rule one of three ways.
+enum BadLink {
+    /// Lifts and does not count the lift.
+    Silent,
+    /// Lifts (counted) where the straight hop could stay.
+    Always,
+    /// Stays at depth across the island.
+    Across,
+}
+
+impl LinkProof for BadLink {
+    fn link(&self, _from: &Cut, _to: &Cut, _r: &KernelRegion, _planned: &[Cut], _policy: LinkPolicy, tally: &mut LinkTally) -> Hop {
+        let lift = || Hop::lift(LEAVES_AREA).expect("a named lift");
+        match self {
+            Self::Silent => lift(),
+            Self::Always => tally.record(lift()),
+            // The island of the fixture is the square from (10, 10) to (20, 20).
+            Self::Across => Hop::stay(vec![Point2::new(15.0, 15.0)]).expect("a stay hop"),
+        }
+    }
+}
+
+fn link(p: &Planners, c: &Case) -> LawVerdict {
+    check_link(&run(p, c, Default::default()), c)
+}
+
+#[test]
+fn link_rule_holds_for_counted_lifts_and_proved_stays() {
+    assert_held(&link(&good(), &square_case().unwrap()));
+    assert_held(&link(&good(), &island_case().unwrap()));
+}
+
+#[test]
+fn link_rule_breaks_for_an_uncounted_lift() {
+    assert_broken(&link(&Planners { link: Box::new(BadLink::Silent), ..good() }, &island_case().unwrap()), Law::Link, "in the tally");
+}
+
+#[test]
+fn link_rule_breaks_for_a_lift_on_a_fixture_with_no_split_ring() {
+    let v = link(&Planners { link: Box::new(BadLink::Always), ..good() }, &square_case().unwrap());
+    assert_broken(&v, Law::Link, "no split ring");
+}
+
+#[test]
+fn link_rule_breaks_for_a_stay_across_the_island() {
+    let v = link(&Planners { link: Box::new(BadLink::Across), ..good() }, &island_case().unwrap());
+    assert_broken(&v, Law::Link, "a crossing out of the area");
+    assert!(v.worst.value > 1.0, "{v}");
+}
diff --git a/crates/pathkernel/tests/laws/registry.rs b/crates/pathkernel/tests/laws/registry.rs
new file mode 100644
index 000000000..291a688be
--- /dev/null
+++ b/crates/pathkernel/tests/laws/registry.rs
@@ -0,0 +1,173 @@
+//! The registry of the K7 suite (#4027): the 16 phase-1 kinds (record
+//! "Phase 1, exactly") and their state on the kernel. It is the progress
+//! list of the migration. A kind that moves to the kernel changes its row
+//! to `Moved` and registers its recipe (its planners and cases, with the
+//! record fixtures and the recorded old output); `each_moved_kind_obeys_every_law`
+//! then runs every law check on it. No new law test is written for a kind.
+
+use camcraft_pathkernel::order::StartSide;
+use camcraft_pathkernel::{Refusal, Stage};
+
+use super::kit::{Case, Law, LawVerdict, NO_OUTPUT, Planners, plan_cuts, refused_held, run};
+use super::l1_guide::check_l1;
+use super::l2_sides::check_l2;
+use super::l3_order::check_l3;
+use super::l4_fallback::check_l4;
+use super::l5_entry::check_l5;
+use super::l6_load::check_l6;
+use super::l7_move::check_l7;
+use super::link_rule::check_link;
+use super::standins::{good, island_case, square_case};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum State {
+    /// The old planner of `camcraft-motion` plans the kind.
+    NotYet,
+    /// The kernel plans the kind; the law suite checks it.
+    Moved,
+}
+
+/// The planners of a kind and its cases.
+pub struct KindRecipe {
+    pub planners: Planners,
+    pub cases: Vec<Case>,
+}
+
+pub struct Kind {
+    pub name: &'static str,
+    pub state: State,
+    pub recipe: Option<fn() -> KindRecipe>,
+}
+
+const fn not_yet(name: &'static str) -> Kind {
+    Kind { name, state: State::NotYet, recipe: None }
+}
+
+/// The 16 phase-1 kinds. A row that moves: `Kind { name, state: State::Moved, recipe: Some(<fn>) }`.
+pub const KINDS: [Kind; 16] = [
+    not_yet("Face"),
+    not_yet("2D Contour"),
+    not_yet("2D Pocket"),
+    not_yet("2D Adaptive"),
+    not_yet("2D Offset"),
+    not_yet("Engrave"),
+    not_yet("V-Carve"),
+    not_yet("2D Chamfer"),
+    not_yet("Circular"),
+    not_yet("Slot"),
+    not_yet("Trochoidal slot"),
+    not_yet("Trace"),
+    not_yet("Slot Undercut"),
+    not_yet("Thread"),
+    not_yet("Bore"),
+    not_yet("3D Pocket"),
+];
+
+/// The rows whose state and recipe do not agree, each with its fix.
+pub fn gaps(kinds: &[Kind]) -> Vec<String> {
+    kinds
+        .iter()
+        .filter_map(|k| match (k.state, k.recipe.is_some()) {
+            (State::Moved, false) => Some(format!(
+                "{} is marked as moved to the kernel but registers no recipe: add its planners and cases to its row in KINDS",
+                k.name
+            )),
+            (State::NotYet, true) => Some(format!("{} registers a recipe but is not marked as moved: set its state to Moved", k.name)),
+            _ => None,
+        })
+        .collect()
+}
+
+/// Every law check on one case of a kind.
+pub fn check_all(p: &Planners, c: &Case) -> Vec<LawVerdict> {
+    let mut v = Vec::new();
+    match (c.region)(c.material) {
+        Ok(r) => v.push(check_l1(p.guide.as_ref(), &r, &c.recipe.guide(), &[])),
+        Err(e) => v.push(refused_held(Law::L1, &e)),
+    }
+    let auto = run(p, c, StartSide::Auto);
+    match &auto {
+        Ok(r) => match r.guide.out() {
+            Some(g) => v.push(check_l2(c.region, p.order.as_ref(), g, c.recipe.order())),
+            None => v.push(refused_held(Law::L2, &Refusal::new(Stage::Guide, NO_OUTPUT))),
+        },
+        Err(e) => v.push(refused_held(Law::L2, e)),
+    }
+    v.push(check_l3(p, c));
+    match &auto {
+        Ok(r) => v.push(check_l4(r, &c.recipe)),
+        Err(e) => v.push(refused_held(Law::L4, e)),
+    }
+    v.push(check_l5(&auto, c));
+    v.push(check_l6(&auto, c));
+    v.push(check_l7(c.recorded.as_deref(), &auto.as_ref().map(|r| r.plan.clone()).map_err(Clone::clone)));
+    v.push(check_link(&auto, c));
+    v
+}
+
+fn assert_all_held(kind: &str, c: &Case, verdicts: &[LawVerdict]) {
+    assert_eq!(verdicts.len(), 8, "each law and the link rule");
+    for v in verdicts {
+        assert!(v.held, "{kind} / {}: {v}", c.name);
+    }
+}
+
+#[test]
+fn the_table_lists_the_16_phase_1_kinds_once() {
+    let mut names: Vec<&str> = KINDS.iter().map(|k| k.name).collect();
+    names.sort_unstable();
+    names.dedup();
+    assert_eq!(names.len(), 16, "{names:?}");
+}
+
+#[test]
+fn a_kind_marked_as_moved_registers_a_recipe() {
+    let g = gaps(&KINDS);
+    assert!(g.is_empty(), "the registry of the law suite:\n{}", g.join("\n"));
+}
+
+#[test]
+fn the_registry_guard_names_a_moved_kind_without_a_recipe() {
+    let rows = [
+        Kind { name: "2D Offset", state: State::Moved, recipe: None },
+        Kind { name: "Face", state: State::NotYet, recipe: Some(stand_in_kind) },
+        not_yet("Bore"),
+    ];
+    let g = gaps(&rows);
+    assert_eq!(g.len(), 2, "{g:?}");
+    assert!(g[0].starts_with("2D Offset is marked as moved") && g[0].contains("registers no recipe"), "{}", g[0]);
+    assert!(g[1].starts_with("Face registers a recipe"), "{}", g[1]);
+}
+
+#[test]
+fn each_moved_kind_obeys_every_law() {
+    for k in KINDS.iter().filter(|k| k.state == State::Moved) {
+        let Some(make) = k.recipe else { continue };
+        let kr = make();
+        for c in &kr.cases {
+            let v = check_all(&kr.planners, c);
+            for x in &v {
+                assert!(x.held, "{} / {}: {x}", k.name, c.name);
+            }
+        }
+    }
+}
+
+/// The obeying stand-ins as one registered kind, with the old output
+/// recorded from their own run: the path that a moved kind takes.
+fn stand_in_kind() -> KindRecipe {
+    let mut cases = vec![square_case().expect("fixture"), island_case().expect("fixture")];
+    for c in &mut cases {
+        let r = run(&good(), c, StartSide::Auto).expect("the stand-ins plan the fixture");
+        c.recorded = Some(plan_cuts(&r.plan).into_iter().cloned().collect());
+    }
+    KindRecipe { planners: good(), cases }
+}
+
+#[test]
+fn the_law_runner_passes_a_registered_kind_that_obeys_every_law() {
+    let kr = stand_in_kind();
+    for c in &kr.cases {
+        assert_all_held("stand-in", c, &check_all(&kr.planners, c));
+    }
+}
diff --git a/crates/pathkernel/tests/laws/standins.rs b/crates/pathkernel/tests/laws/standins.rs
new file mode 100644
index 000000000..c5ed09a7e
--- /dev/null
+++ b/crates/pathkernel/tests/laws/standins.rs
@@ -0,0 +1,286 @@
+//! The stand-in stage planners of the K7 suite (#4027). No kind plans on
+//! the kernel yet, so these small planners prove the law checks: the ones
+//! here obey every law; each law file adds the planners that break its law
+//! in one named way. They are test code, not a design of the K2-K5 stages.
+//! Provenance: our own design record; sharp offset rings of a pocket as in
+//! Held (1991).
+
+use camcraft_pathkernel::entry::{Area, Entry, EntryChoice, EntryKind, EntryPlanner, Exit, Proof};
+use camcraft_pathkernel::guide::{Curve, Family, GuideChoice, GuidePlanner, GuideSet, RingRef, RingsChoice};
+use camcraft_pathkernel::link::{Hop, LinkPolicy, LinkProof, LinkTally, USER_RETRACT};
+use camcraft_pathkernel::load::{Controlled, LoadControl, LoadPlanner, OverLimit, PLAN_TOL, Reach, Reading, StockRead};
+use camcraft_pathkernel::order::{Direction, OrderChoice, OrderPlanner, OrderedSet, StartSide};
+use camcraft_pathkernel::plan::Cut;
+use camcraft_pathkernel::region::{KernelRegion, MaterialSide, PlanarRegion};
+use camcraft_pathkernel::{AxisControl, Loop, PlanePoint, Point2, Positive, Recipe, Refusal, Region, Stage, ToolShape, Verdict, WorkPlane};
+
+use super::grid::samples;
+use super::kit::{Case, Planners, dist, outside, planar, poly, poly_dist};
+
+/// The tool radius of the fixtures (mm).
+pub const R: f64 = 2.0;
+/// The ring stepover of the fixtures (mm): ae/D 0.2.
+pub const STEP: f64 = 0.8;
+/// The engagement limit of the fixtures (ae/D).
+pub const LIMIT: f64 = 0.5;
+/// The most rings that a stand-in plans.
+const MAX_RINGS: u32 = 200;
+
+pub const GEO_FAILED: &str = "the stand-in geometry failed";
+pub const RINGS_ONLY: &str = "the stand-in guide plans rings only";
+pub const LEAVES_AREA: &str = "the straight hop leaves the cutter-centre area";
+pub const FRESH: &str = "a full-width cut where no ring cut before";
+
+fn geo<E>(_: E) -> Refusal {
+    Refusal::new(Stage::Region, GEO_FAILED)
+}
+
+pub fn sq(x0: f64, y0: f64, s: f64) -> Result<Loop, Refusal> {
+    let p = Point2::new;
+    Loop::new(vec![p(x0, y0), p(x0 + s, y0), p(x0 + s, y0 + s), p(x0, y0 + s)]).map_err(geo)
+}
+
+pub fn square_area(c: Point2, s: f64) -> Result<Region, Refusal> {
+    Region::new(vec![sq(c.x - s / 2.0, c.y - s / 2.0, s)?]).map_err(geo)
+}
+
+/// The region of a pocket `part` (the area to clear). Inside: the
+/// cutter-centre area is `part` less the tool radius. Outside: a band
+/// around `part`, so that the material side changes the centre.
+fn pocket_region(part: Region, m: MaterialSide) -> Result<KernelRegion, Refusal> {
+    let tool = ToolShape::disc(R, 0.0, false, 20.0)?;
+    let center = match m {
+        MaterialSide::Inside => part.offset_sharp(-R).map_err(geo)?,
+        MaterialSide::Outside => part.offset_sharp(R + 6.0).map_err(geo)?.difference(&part.offset_sharp(R).map_err(geo)?).map_err(geo)?,
+    };
+    let walls = part.loops().to_vec();
+    PlanarRegion::new(center, m, walls, vec![], Region::empty(), Region::empty(), tool).map(KernelRegion::Planar)
+}
+
+/// A 20 mm square pocket: concentric rings, no split ring.
+pub fn square_region(m: MaterialSide) -> Result<KernelRegion, Refusal> {
+    pocket_region(Region::new(vec![sq(0.0, 0.0, 20.0)?]).map_err(geo)?, m)
+}
+
+/// A 30 mm square pocket with a 10 mm square island in its middle.
+pub fn island_region(m: MaterialSide) -> Result<KernelRegion, Refusal> {
+    pocket_region(Region::new(vec![sq(0.0, 0.0, 30.0)?, sq(10.0, 10.0, 10.0)?]).map_err(geo)?, m)
+}
+
+pub fn rings_choice() -> Result<GuideChoice, Refusal> {
+    Ok(GuideChoice::Rings(RingsChoice::new(RingRef::Boundary, 0.0, STEP, None, None)?))
+}
+
+pub fn recipe(guide: GuideChoice, entry: EntryKind, link: LinkPolicy) -> Result<Recipe, Refusal> {
+    let load = LoadControl::constant(LIMIT, Reach::Stock)?;
+    let entry = EntryChoice::new(entry, 2.0, vec![])?;
+    Recipe::new(WorkPlane::setup_xy(0.0)?, AxisControl::Normal, guide, load, OrderChoice::default(), link, entry)
+}
+
+/// The planner's own stock reader: the stock area, read point by point.
+pub struct ShapeReader(pub Region);
+
+impl StockRead for ShapeReader {
+    fn material_at(&self, p: Point2) -> Option<bool> {
+        Some(self.0.contains(p))
+    }
+}
+
+fn case(name: &'static str, region: fn(MaterialSide) -> Result<KernelRegion, Refusal>, side: f64, no_split: bool) -> Result<Case, Refusal> {
+    let stock = Region::new(vec![sq(0.0, 0.0, side)?]).map_err(geo)?;
+    let recipe = recipe(rings_choice()?, EntryKind::Helix, LinkPolicy::StayWhereProved)?;
+    let reader = Box::new(ShapeReader(stock.clone()));
+    Ok(Case { name, region, material: MaterialSide::Inside, recipe, stock, reader, no_split, recorded: None })
+}
+
+pub fn square_case() -> Result<Case, Refusal> {
+    case("square pocket", square_region, 20.0, true)
+}
+
+pub fn island_case() -> Result<Case, Refusal> {
+    case("pocket with an island", island_region, 30.0, false)
+}
+
+/// The planner set that obeys every law.
+pub fn good() -> Planners {
+    Planners {
+        guide: Box::new(RingGuide { extra: 0.0 }),
+        order: Box::new(SideOrder),
+        load: Box::new(ReadLoad { blind: false }),
+        link: Box::new(StraightLink),
+        entry: Box::new(ProvedEntry),
+    }
+}
+
+pub fn loop_curve(l: &Loop, k: u32) -> Result<Curve, Refusal> {
+    let pts = l.points().iter().map(|p| PlanePoint::flat(*p)).collect::<Result<Vec<_>, _>>()?;
+    Curve::new(pts, None, true, k, Family::Ring)
+}
+
+/// The sharp offset rings of `center`, from `first` inward each `step`.
+pub fn rings(center: &Region, first: f64, step: f64, count: Option<u32>) -> Result<Vec<Curve>, Refusal> {
+    let mut out = Vec::new();
+    for k in 0..count.unwrap_or(MAX_RINGS) {
+        let ring = center.offset_sharp(-(first + f64::from(k) * step)).map_err(geo)?;
+        if ring.is_empty() {
+            break;
+        }
+        for l in ring.loops() {
+            out.push(loop_curve(l, k)?);
+        }
+    }
+    Ok(out)
+}
+
+/// Rings of the centre area; `extra` adds to the stepover (0 obeys).
+pub struct RingGuide {
+    pub extra: f64,
+}
+
+impl GuidePlanner for RingGuide {
+    fn guide(&self, r: &KernelRegion, g: &GuideChoice, _tol: f64) -> Result<Verdict<GuideSet>, Refusal> {
+        let GuideChoice::Rings(rc) = g else {
+            return Err(Refusal::new(Stage::Guide, RINGS_ONLY));
+        };
+        let curves = rings(planar(r)?.center(), rc.first_offset(), rc.stepover() + self.extra, rc.count())?;
+        Ok(Verdict::done(GuideSet::new(curves)))
+    }
+}
+
+/// `c` in the other direction, from the same start point.
+pub fn reversed(c: &Curve) -> Result<Curve, Refusal> {
+    let mut p = c.pts().to_vec();
+    if c.closed() {
+        p[1..].reverse();
+    } else {
+        p.reverse();
+    }
+    Curve::new(p, c.arc(), c.closed(), c.k(), c.family())
+}
+
+/// Inside: the highest ring index first; Outside: the lowest first. Auto
+/// resolves to Inside. Conventional reverses each curve.
+pub fn order_curves(input: &GuideSet, mut curves: Vec<Curve>, side: StartSide, dir: Direction) -> Result<OrderedSet, Refusal> {
+    curves.sort_by_key(Curve::k);
+    if side == StartSide::Inside {
+        curves.reverse();
+    }
+    if dir == Direction::Conventional {
+        curves = curves.iter().map(reversed).collect::<Result<_, _>>()?;
+    }
+    let start = curves.first().and_then(|c| c.pts().first()).map_or(Point2::new(0.0, 0.0), |p| p.at());
+    OrderedSet::new(input, curves, start, side)
+}
+
+pub fn resolve(s: StartSide) -> StartSide {
+    if s == StartSide::Outside { StartSide::Outside } else { StartSide::Inside }
+}
+
+pub struct SideOrder;
+
+impl OrderPlanner for SideOrder {
+    fn order(&self, g: GuideSet, _r: &KernelRegion, o: &OrderChoice, _stock: Option<&Region>) -> Result<Verdict<OrderedSet>, Refusal> {
+        Ok(Verdict::done(order_curves(&g, g.curves().to_vec(), resolve(o.start), o.direction)?))
+    }
+}
+
+/// Reads each cut every half tool radius: a full-width slot where no
+/// earlier cut is within a diameter and within one diameter of a corner,
+/// else the width left by the nearest earlier cut. `blind` reads every cut
+/// as a light side cut (an L6 breaker).
+pub struct ReadLoad {
+    pub blind: bool,
+}
+
+impl LoadPlanner for ReadLoad {
+    fn control(
+        &self,
+        s: OrderedSet,
+        _r: &KernelRegion,
+        stock: &dyn StockRead,
+        lc: &LoadControl,
+        tool_r: f64,
+    ) -> Result<Verdict<Controlled>, Refusal> {
+        let limit = match lc {
+            LoadControl::ConstantEngagement(c) => c.load(),
+            _ => 1.0,
+        };
+        let cap = limit * (1.0 + PLAN_TOL);
+        let lines: Vec<Vec<Point2>> = s.curves().iter().map(poly).collect();
+        let (mut readings, mut over) = (Vec::new(), Vec::new());
+        for (i, line) in lines.iter().enumerate() {
+            let mut pts = samples(line, tool_r / 2.0);
+            // A closed curve ends at its start: one reading for one place.
+            if s.curves()[i].closed() {
+                pts.pop();
+            }
+            for (p, _) in pts {
+                let near = lines[..i].iter().map(|e| poly_dist(p, e)).fold(f64::INFINITY, f64::min);
+                // The engagement climbs at a ring corner: read it as a slot there.
+                let corner = line.iter().any(|v| dist(*v, p) <= 2.0 * tool_r);
+                let load = match (self.blind, stock.material_at(p)) {
+                    (true, _) => 0.2,
+                    (false, Some(true)) if corner => 1.0,
+                    (false, Some(true)) => (near / (2.0 * tool_r)).min(1.0),
+                    (false, _) => 0.0,
+                };
+                readings.push(Reading::new(p, load)?);
+                if load > cap {
+                    over.push(OverLimit::new(p, load, FRESH)?);
+                }
+            }
+        }
+        Ok(Verdict::done(Controlled::new(s, readings, over, limit)?))
+    }
+}
+
+pub fn start_of(c: &Cut) -> Point2 {
+    c.curve().pts().first().map_or(Point2::new(0.0, 0.0), |p| p.at())
+}
+
+pub fn end_of(c: &Cut) -> Point2 {
+    poly(c.curve()).last().copied().unwrap_or(Point2::new(0.0, 0.0))
+}
+
+/// Stays on the straight hop where it stays in the centre area, else lifts.
+pub struct StraightLink;
+
+impl LinkProof for StraightLink {
+    fn link(&self, from: &Cut, to: &Cut, r: &KernelRegion, _planned: &[Cut], policy: LinkPolicy, tally: &mut LinkTally) -> Hop {
+        let (a, b) = (end_of(from), start_of(to));
+        let inside = |p: &PlanarRegion| samples(&[a, b], 0.05).iter().all(|(q, _)| outside(p.center(), *q) <= 1e-3);
+        let hop = match (policy, planar(r)) {
+            (LinkPolicy::StayWhereProved, Ok(p)) if inside(p) => Hop::stay(vec![a, b]),
+            (LinkPolicy::StayWhereProved, _) => Hop::lift(LEAVES_AREA),
+            _ => Hop::lift(USER_RETRACT),
+        };
+        tally.record(hop.or_else(|_| Hop::lift(LEAVES_AREA)).expect("a named lift"))
+    }
+}
+
+/// A helix where the tool enters material (the area that the plan has not
+/// cleared and that is not air), with its proof.
+pub struct ProvedEntry;
+
+pub fn helix(at: Point2, r: &KernelRegion, e: &EntryChoice, kind: EntryKind) -> Result<Entry, Refusal> {
+    let tool = planar(r)?.tool();
+    let area = Area::new(square_area(at, 4.0 * tool.radius())?)?;
+    let proof = Proof::IntoMaterial { area, angle_or_pitch: Positive::new(Stage::Entry, 1.0)? };
+    Entry::new(kind, vec![PlanePoint::new(at, 5.0)?], vec![PlanePoint::flat(at)?], proof, e, tool)
+}
+
+impl EntryPlanner for ProvedEntry {
+    fn entry(&self, first: &Cut, r: &KernelRegion, cleared: &Region, e: &EntryChoice) -> Result<Entry, Refusal> {
+        let at = start_of(first);
+        let tool = planar(r)?.tool();
+        let free = planar(r)?.air().union(cleared).map_err(geo)?;
+        if free.contains(at) {
+            let area = Area::new(square_area(at, tool.radius())?)?;
+            return Entry::new(EntryKind::Air, vec![], vec![PlanePoint::flat(at)?], Proof::InAir(area), e, tool);
+        }
+        helix(at, r, e, EntryKind::Helix)
+    }
+    fn exit(&self, _last: &Cut, _r: &KernelRegion, _cleared: &Region) -> Result<Exit, Refusal> {
+        Exit::new(None, 5.0)
+    }
+}
diff --git a/docs/decisions/4027-kernel-law-suite.md b/docs/decisions/4027-kernel-law-suite.md
new file mode 100644
index 000000000..568bb39e3
--- /dev/null
+++ b/docs/decisions/4027-kernel-law-suite.md
@@ -0,0 +1,110 @@
+## #4027 - Path kernel K7: the law suite and its stand-in proofs
+
+**What was decided**
+
+1. **The suite is the existing directory suite `crates/pathkernel/tests/laws/`.**
+   The issue text says "an existing directory suite"; the K0 record says
+   `crates/pathkernel/tests/laws/`. The record is the approved design, and
+   the crate skeleton (#4055, PR #4123) already made `tests/laws.rs` with
+   its invariant tests and wrote that "the K7 law suite (#4027) joins this
+   directory suite". So the two texts agree: K7 adds submodules to the one
+   binary `laws`, and adds no new top-level test file. No xtask list
+   changes: the gate already maps `crates/pathkernel/tests/laws/` to that
+   binary.
+2. **One generic check for each law.** Each check is a function over the
+   stage traits (`GuidePlanner`, `OrderPlanner`, `LoadPlanner`,
+   `LinkProof`, `EntryPlanner`) and the stage outputs of one run. It
+   returns a `LawVerdict`: the law, held or broken, and the worst measure
+   (its place, its point, its measured value and its limit).
+   - L1 `check_l1`: two calls, the region given another way (loops
+     reversed, each started at its next vertex), and each guide planner of
+     another kind with the same choice. Curve multisets within 1 um
+     (Hausdorff per curve, same count).
+   - L2 `check_l2`: compile-level (a region stage is a
+     `fn(MaterialSide) -> ...`), then the centre changes with the material
+     side, and the order stage gives the same sequence for two regions that
+     differ only in their material side.
+   - L3 `check_l3`: Auto, Inside and Outside; the ordered curves against
+     the guide curves, and the guide and the ordered multiset across the
+     sides, within 1 um.
+   - L4 `check_l4`: a guide family other than the asked one, or an entry
+     into material of another kind than the asked one, needs a named
+     fallback of its stage.
+   - L5 `check_l5`, L6 `check_l6`: read on a stock grid that the checks own
+     (`grid.rs`), written apart from the planner's stock reader. The walk
+     reads each entry and each cut on the stock as it is at that step and
+     clears the swept disc. L5: a descent onto material needs an
+     `IntoMaterial` proof. L6: the engagement is read from the contact
+     angle of the front half of the cutting edge, `ae/D = (1 - cos angle) / 2`
+     (the record names the contact-angle law). Each read above
+     `limit x (1 + PLAN_TOL)` plus the grid read error (0.1 ae/D) needs an
+     over-limit record within one tool radius. The first version of the
+     check found a real under-read of the first stand-in load planner at
+     the corners of sharp offset rings (ae/D 0.75 against the limit 0.5).
+     A hand estimate of the contact angle there gives about 0.77. The
+     stand-in now names the corners.
+   - L7 `check_l7`: the cuts in order, point by point, against the
+     recorded old output, within 1 um. A case with no record is a breach,
+     so that no kind moves without its golden output.
+   - Link rule `check_link`: the plan's lifts against the tally (total and
+     by reason), no lift on a fixture with no split ring, and no stay-down
+     hop that leaves the centre area and the air.
+3. **The mutation proof uses stand-in planners in the test.** No kind has
+   a kernel planner yet. `standins.rs` holds one planner set that obeys
+   each law (sharp offset rings, a side order, a load reader, a straight
+   link, a helix entry). Each law file holds one or more planners that
+   break its law in one named way, and a test that the check names the law
+   and the place. The stand-ins are test code, not a design of K2-K5.
+4. **The registry is the progress list.** `registry.rs` holds the 16
+   phase-1 kinds of the record, each `NotYet`. A kind that moves sets its
+   row to `Moved` and registers its recipe (planners and cases); the test
+   `each_moved_kind_obeys_every_law` then runs `check_all` (all eight
+   checks) on each case. The guard test fails with a clear message when a
+   row is `Moved` with no recipe, or has a recipe and is not `Moved`. The
+   test `the_law_runner_passes_a_registered_kind_that_obeys_every_law` runs
+   the stand-ins through the same path.
+5. **No change in `crates/pathkernel/src`.** Each law can be read through
+   the public API. The kit rebuilds a `PlanarRegion` (for L1's permutation
+   and L2's flipped material side) in one place, `kit::rebuild`, so a K1
+   change of the constructor changes one function.
+
+**How the two halves meet at the switch-over.** The stage-level laws are
+here: they read the kernel's own outputs (`GuideSet`, `OrderedSet`,
+`Controlled`, `Plan`, `LinkTally`) for each moved kind. The toolpath-level
+readings (lifts, crossings, entries into material, engagement and
+fallbacks of a finished toolpath, old against new) are in PR #4167
+(#4154), in the tests of `camcraft-motion`. The kernel crate must not
+depend on motion (a dependency cycle), and motion's `tests/common` is not
+a library. At the switch-over proof (record, point 1 and 2): point 1 is
+this suite green for each of the 16 rows; point 2 is the #4154 readings
+table, old against new, on the disc, the dog bone and `fig8.step`. A kind
+PR fills both: its row and recipe here, and its readings there.
+
+**What was dropped**
+
+- A new top-level test binary: the suite exists, and a new binary costs
+  about the size of a test build.
+- A dev-dependency of the kernel on motion, to share the #4154 measures:
+  it makes a second copy of the kernel types, and the record forbids the
+  edge.
+- Reading the posted CL in this crate: the kernel must not depend on
+  `camcraft-cl`. The checks read the kernel's `Plan` instead; the CL
+  readings are #4154's half.
+
+**Known limits, for K5 and the first kind PR**
+
+- The entry stage has no channel to name a fallback: `EntryPlanner::entry`
+  returns `Result<Entry, Refusal>`, not a `Verdict`. The record says "an
+  entry where the user asked for another kind is a `Fallback`". Today
+  `check_l4` reports such an entry as a breach. K5 must add the record
+  (for example a `Verdict<Entry>`), and `check_l4` then reads it.
+- Under `LoadControl::None` the limit is 1, so the `Controlled` constructor
+  cannot name a full-width cut. The record's "full-width cuts outside a
+  named slot = 0" is not checked for that control.
+- The record's fixtures (the dog bone of #3741, the disc of #3934, the
+  narrow neck, the open-side band) join with the first kind that moves:
+  each kind registers its cases. The stand-ins use a square pocket and a
+  pocket with an island.
+
+**Cost to change later**: a check is one function in one file. A new law
+adds one file and one line in `check_all`.

