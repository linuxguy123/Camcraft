+    assert_eq!(cut(&second), ["TP13.", "TN25.", "G74", "G01 X-24.1 Y10. U0.6 V0.", "G01 X-24.1 Y-10. U0.6 V0.", "G01 X-22. Y10. U0. V0.", "G75"], "{}", out.program);
