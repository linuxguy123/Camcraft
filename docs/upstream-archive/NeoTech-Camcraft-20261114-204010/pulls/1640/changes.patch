+    let cases = [
+        ("engrave", TOP, mark(false, TOP, 7.7)),
+        ("trace", TOP, mark(true, TOP, 7.7)),
+        ("contour", TOP, contour(TOP, 1.0, Side::Outside)),
+        ("slot", TOP, slot(-6.0, 6.0, FLOOR)),
+        ("face", 10.0, face(TOP)),
