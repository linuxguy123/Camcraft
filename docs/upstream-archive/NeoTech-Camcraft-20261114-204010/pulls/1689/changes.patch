From af0f17478d8bbc86145ffc6eb1d4420745eddbad Mon Sep 17 00:00:00 2001
From: ahmetv10 <ahmetv10@users.noreply.github.com>
Date: Sat, 14 Nov 2026 13:23:15 -0500
Subject: [PATCH] fix(ui): the near plane and the ortho eye stay with the zoom

Two ways the viewport ate the model from its own camera:

- Perspective: the near plane was a fixed 0.1 mm from the eye, so at
  close zoom (the minimum dolly is 0.5 mm) the geometry in front of
  the near plane clipped instead of rendering - the view went through
  the model. The near plane now rides dist (0.1 % of the view depth,
  clamped to 1e-5 min, 0.1 max).
- Orthographic: the eye travelled with dist, so zooming dollied the
  eye into the model and clipped through its faces from inside. The
  eye now sits at a fixed nominal distance (100 mm) behind the target
  and dist is only a scale factor, the way the view box's half-height
  was always meant to work.
---
 crates/ui/src/law_tests.rs | 13 +++++++++----
 crates/ui/src/viewport.rs  | 25 +++++++++++++++++++++----
 2 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/crates/ui/src/law_tests.rs b/crates/ui/src/law_tests.rs
index 83485991b..950da0df4 100644
--- a/crates/ui/src/law_tests.rs
+++ b/crates/ui/src/law_tests.rs
@@ -2198,7 +2198,7 @@ mod projection_tests {
                 ],
             )
         };
-        let near = 0.1f64;
+        let near = (cam.dist * 0.001).clamp(1e-5, 0.1);
         let far = (cam.dist * 40.0).max(1000.0);
         assert!((at(near) - 0.0).abs() < 1e-3, "the near plane sits at {}", at(near));
         assert!((at(far) - 1.0).abs() < 1e-3, "the far plane sits at {}", at(far));
@@ -2284,10 +2284,15 @@ mod projection_tests {
         let mp = p.mvp(ASPECT);
         for (nx, ny) in [(-0.9, -0.9), (-0.3, 0.2), (0.0, 0.0), (0.6, 0.85)] {
             let (origin, dir) = o.ray_through([nx, ny], ASPECT).expect("ortho ray");
+            let dd = dir[0] * dir[0] + dir[1] * dir[1] + dir[2] * dir[2];
+            let t = ((o.target[0] - origin[0]) * dir[0]
+                + (o.target[1] - origin[1]) * dir[1]
+                + (o.target[2] - origin[2]) * dir[2])
+                / dd;
             let hit = [
-                origin[0] + dir[0] * o.dist,
-                origin[1] + dir[1] * o.dist,
-                origin[2] + dir[2] * o.dist,
+                origin[0] + dir[0] * t,
+                origin[1] + dir[1] * t,
+                origin[2] + dir[2] * t,
             ];
             let a = project(&mo, hit);
             let b = project(&mp, hit);
diff --git a/crates/ui/src/viewport.rs b/crates/ui/src/viewport.rs
index 1fb6d6adb..3362ec113 100644
--- a/crates/ui/src/viewport.rs
+++ b/crates/ui/src/viewport.rs
@@ -1078,6 +1078,14 @@ impl Default for Camera {
     }
 }
 
+/// The distance behind the target the orthographic camera sits at. Its
+/// framing is independent of distance (the half-height is `dist * tan
+/// (fov/2)`), so nothing useful comes of pushing the eye toward the
+/// model - dollying along the view direction with `dist` only swallowed
+/// the model's near faces behind the camera as the zoom shrank. The
+/// ortho `dist` is a zoom factor; the eye stays at a nominal distance.
+pub(crate) const ORTHO_EYE_DIST: f64 = 100.0;
+
 impl Camera {
     pub fn orbit(&mut self, dx: f32, dy: f32) {
         self.yaw -= f64::from(dx) * 0.01;
@@ -1313,11 +1321,16 @@ impl Camera {
 
     #[must_use]
     pub(crate) fn eye(&self) -> [f64; 3] {
+        let d = if self.projection == ProjectionMode::Orthographic {
+            ORTHO_EYE_DIST
+        } else {
+            self.dist
+        };
         let cp = self.pitch.cos();
         [
-            self.target[0] + self.dist * cp * self.yaw.cos(),
-            self.target[1] + self.dist * cp * self.yaw.sin(),
-            self.target[2] + self.dist * self.pitch.sin(),
+            self.target[0] + d * cp * self.yaw.cos(),
+            self.target[1] + d * cp * self.yaw.sin(),
+            self.target[2] + d * self.pitch.sin(),
         ]
     }
 
@@ -1378,7 +1391,11 @@ impl Camera {
                 1.0,
             ],
         ];
-        let near = 0.1f64;
+        // The near plane rides the view distance (minimally far from
+        // the eye): a fixed 0.1 clipped against any part smaller than
+        // half a millimetre near the camera, so zooming magnified cut
+        // the near faces away at the surface.
+        let near = (self.dist * 0.001).clamp(1e-5, 0.1);
         let far = (self.dist * 40.0).max(1000.0);
         let aspect = if aspect.is_finite() && aspect > 1e-6 {
             aspect
