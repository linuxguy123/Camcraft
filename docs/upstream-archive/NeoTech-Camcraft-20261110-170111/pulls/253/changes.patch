From 99c3072c6fd4db7fd007b440f6923300691b2597 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 8 Nov 2026 03:41:21 +0100
Subject: [PATCH] test(app): add the coolant field to the two cross-drill test
 operations

PR #147 added Operation.coolant; drilling_cross_holder.rs (#119) and
drilling_cross_part.rs (#117) were written before it and broke the
camcraft-app test build on main.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/drilling_cross_holder.rs | 1 +
 crates/app/tests/drilling_cross_part.rs   | 1 +
 2 files changed, 2 insertions(+)

diff --git a/crates/app/tests/drilling_cross_holder.rs b/crates/app/tests/drilling_cross_holder.rs
index 8b91a3e2..4e278866 100644
--- a/crates/app/tests/drilling_cross_holder.rs
+++ b/crates/app/tests/drilling_cross_holder.rs
@@ -63,6 +63,7 @@ fn op() -> Operation {
         stamp: None,
         setup: None,
         area: Default::default(),
+        coolant: Default::default(),
     }
 }
 
diff --git a/crates/app/tests/drilling_cross_part.rs b/crates/app/tests/drilling_cross_part.rs
index 4214297e..d9963252 100644
--- a/crates/app/tests/drilling_cross_part.rs
+++ b/crates/app/tests/drilling_cross_part.rs
@@ -54,6 +54,7 @@ fn op(cross: Vec<CrossHole>) -> Operation {
         stamp: None,
         setup: None,
         area: Default::default(),
+        coolant: Default::default(),
     }
 }
 
