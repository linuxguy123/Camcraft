From c0b9ac6c91fac2ba1d9fcabe20cc6735f3d48103 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 9 Nov 2026 16:20:56 +0100
Subject: [PATCH] fix(app): warned moves name a lathe HolderHit's move

main stopped compiling after two merges that each passed alone: PR #454
(#349) added warned_moves::moves_named, which matches every verify::Warning,
and PR #395 (#369) added Warning::HolderHit. HolderHit names one move
(`at`), like FixtureHit, so it joins the single-move arm.

Fixes #460

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/warned_moves.rs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/crates/app/src/warned_moves.rs b/crates/app/src/warned_moves.rs
index 985f03b2..91705bd8 100644
--- a/crates/app/src/warned_moves.rs
+++ b/crates/app/src/warned_moves.rs
@@ -27,6 +27,7 @@ pub fn moves_named(w: &Warning) -> [Option<usize>; 2] {
         | Warning::SweepHit { at, .. }
         | Warning::RapidInStock { at }
         | Warning::FixtureHit { at, .. }
+        | Warning::HolderHit { at, .. }
         | Warning::NonFinite { at }
         | Warning::Envelope { at, .. }
         | Warning::Scallop { at, .. } => [Some(*at), None],
@@ -88,6 +89,8 @@ mod tests {
         assert_eq!(first_move(&Warning::ShankHit { at: 84, part: true }), Some(84));
         assert_eq!(first_move(&Warning::RapidInStock { at: 2 }), Some(2));
         assert_eq!(first_move(&Warning::FixtureHit { at: 5, fixture_part: FixturePart::Holder }), Some(5));
+        // #460: a lathe holder rubbing the stock names its move too.
+        assert_eq!(moves_named(&Warning::HolderHit { at: 11, part: true, short_mm: 0.4 }), [Some(11), None]);
         assert_eq!(first_move(&Warning::Envelope { at: 7, gouge_mm: 0.1, rest_mm: 0.0 }), Some(7));
         assert_eq!(moves_named(&Warning::RestUnjudged { at: 0, cells: 1, claims: 1 }), [None, None]);
     }
