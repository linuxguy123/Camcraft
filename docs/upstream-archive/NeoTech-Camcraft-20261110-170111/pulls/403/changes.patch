diff --git a/crates/ui/src/axis_note.rs b/crates/ui/src/axis_note.rs
new file mode 100644
index 00000000..2085b98e
--- /dev/null
+++ b/crates/ui/src/axis_note.rs
@@ -0,0 +1,30 @@
+//! The inverted-machine-axis note on the viewport's origin triad (#375).
+//!
+//! Provenance: our own design. The triad stays the right-handed ISO 841
+//! program frame the whole CAM side keeps; a machine whose slide runs
+//! the other way (#373, posted mirrored by #374) is stated beside the
+//! axis letter in the same words as the setup sheet and the NC header
+//! (`machine::inverted_axis_line`) - never by flipping the arrow, which
+//! would draw a left-handed frame the toolpaths are not in.
+
+use crate::state::State;
+
+/// The triad's axis letters, in [`triad_notes`] order.
+const LETTERS: [&str; 3] = ["X", "Y", "Z"];
+
+/// One note per triad axis (X, Y, Z): `Some("Machine X+ moves left
+/// (inverted axis)")` when the machine the shown setup mounts states
+/// that linear axis inverted, `None` otherwise - all `None` for a
+/// standard machine or no machine at all.
+pub(crate) fn triad_notes(state: &State) -> [Option<String>; 3] {
+    let setup = crate::interact::shown_setup(state);
+    let (_, machine) = camcraft_app::machine::of_setup(&state.world, setup.as_deref());
+    let inverted: Vec<String> = machine
+        .map(|m| m.inverted_axes().into_iter().map(str::to_owned).collect())
+        .unwrap_or_default();
+    LETTERS.map(|l| inverted.iter().any(|i| i == l).then(|| camcraft_app::machine::inverted_axis_line(l)))
+}
+
+/// How far below its axis letter a note sits, in viewport uv (the
+/// letter is drawn at 1.4x the body font, so a note under it clears it).
+pub(crate) const NOTE_DROP_UV: f32 = 0.045;
diff --git a/crates/ui/src/axis_note_tests.rs b/crates/ui/src/axis_note_tests.rs
new file mode 100644
index 00000000..c408c757
--- /dev/null
+++ b/crates/ui/src/axis_note_tests.rs
@@ -0,0 +1,53 @@
+//! #375 in the viewport: the origin triad notes an inverted machine axis
+//! beside its letter, once, and keeps its right-handed arrows; a
+//! standard machine adds no label.
+//!
+//! Provenance: our own test over ISO 841's right-handed program frame.
+
+use camcraft_app::commands::LoadMachine;
+use camcraft_app::machine::{AxisDirection, AxisLimits, Machine};
+
+use crate::interact::{gizmo_segments, overlay_labels};
+use crate::state::State;
+
+fn mounted(inverted: &[&str]) -> State {
+    let axis = |n: &str| AxisLimits {
+        name: n.into(),
+        travel: Some((-100.0, 100.0)),
+        direction: if inverted.contains(&n) { AxisDirection::Inverted } else { AxisDirection::Standard },
+        ..Default::default()
+    };
+    let m = Machine { model: "Flip 1".into(), axes: vec![axis("X"), axis("Y"), axis("Z")], ..Default::default() };
+    let mut state = State::new();
+    let load = LoadMachine::new(&state.world, "flip.mch".into(), Some(m)).expect("load");
+    state.history.execute(&state.world, load);
+    state
+}
+
+fn texts(state: &State) -> Vec<String> {
+    overlay_labels(state, 800.0 / 600.0).into_iter().map(|(_, _, t)| t).collect()
+}
+
+#[test]
+fn an_inverted_axis_is_noted_beside_its_triad_letter() {
+    let state = mounted(&["X"]);
+    let labels = overlay_labels(&state, 800.0 / 600.0);
+    let x = labels.iter().find(|(_, _, t)| t == "X").expect("the X letter stays");
+    let note = labels
+        .iter()
+        .find(|(_, _, t)| t == "Machine X+ moves left (inverted axis)")
+        .expect("the inverted X is noted");
+    assert_eq!(note.1, x.1, "the note wears the axis colour");
+    assert!(note.0[1] > x.0[1] && (note.0[0] - x.0[0]).abs() < 1e-6, "just under the letter");
+    assert_eq!(texts(&state).iter().filter(|t| t.contains("inverted")).count(), 1, "one note, X only");
+    // The arrows are the program frame: identical to a standard machine's.
+    assert_eq!(gizmo_segments(&state, 1.0), gizmo_segments(&mounted(&[]), 1.0));
+}
+
+#[test]
+fn a_standard_machine_adds_no_triad_label() {
+    assert_eq!(texts(&mounted(&[])), texts(&State::new()));
+    assert_eq!(texts(&State::new()), ["X", "Y", "Z"]);
+    let both = texts(&mounted(&["X", "Y"]));
+    assert!(both.iter().any(|t| t == "Machine Y+ moves toward the front (inverted axis)"), "{both:?}");
+}
diff --git a/crates/ui/src/interact.rs b/crates/ui/src/interact.rs
