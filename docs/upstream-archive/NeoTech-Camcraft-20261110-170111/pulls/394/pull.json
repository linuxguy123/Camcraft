  "title": "fix(post): engage cutter compensation in G17, never in a stale G18/G19",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/NeoTech",
    "html_url": "https://github.com/NeoTech",
    "followers_url": "https://api.github.com/users/NeoTech/followers",
    "following_url": "https://api.github.com/users/NeoTech/following{/other_user}",
    "gists_url": "https://api.github.com/users/NeoTech/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/NeoTech/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/NeoTech/subscriptions",
    "organizations_url": "https://api.github.com/users/NeoTech/orgs",
    "repos_url": "https://api.github.com/users/NeoTech/repos",
    "events_url": "https://api.github.com/users/NeoTech/events{/privacy}",
