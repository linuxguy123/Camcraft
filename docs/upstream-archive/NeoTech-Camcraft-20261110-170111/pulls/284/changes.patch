+/// [`ring`] turned `rot` radians about the axis.
+fn turned(ring: Vec<Point3>, rot: f64) -> Vec<Point3> {
+    let (c, s) = (rot.cos(), rot.sin());
+    ring.into_iter().map(|q| Point3::new(q.x * c - q.y * s, q.x * s + q.y * c, q.z)).collect()
+}
