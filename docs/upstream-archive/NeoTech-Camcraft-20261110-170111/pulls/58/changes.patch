From 3e9c30d5bc3f2d0953ab27d21e88e8582f4518df Mon Sep 17 00:00:00 2001
From: linuxguy123 <linuxguy123@gmail.com>
Date: Fri, 6 Nov 2026 20:45:00 -0600
Subject: [PATCH 02/11] docs(changelog): record operation order and project
 filename updates

---
 CHANGELOG.md | 1 +
 1 file changed, 1 insertion(+)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 693278c4..89486913 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -9,6 +9,7 @@ v0.8.1).
 
 | Commit | Date | Change | Version |
 |---|---|---|---|
+| a128a51 | 2026-11-06 | feat(app,ui): rename and reorder operations within a setup; show project filename in the title, add Save As, and make status text copyable (#45) | Unreleased |
 | 4e27eea | 2026-11-07 | fix(motion): 2D Adaptive refuses a long thin channel by name in a second instead of grinding for minutes (#13) | Unreleased |
 | 619e479 | 2026-11-07 | fix(sim): Contour moves answer to the part walls along their length; pocket chord law only below the stock top (#43) | 0.8.3 |
 | 5083771 | 2026-11-07 | fix(motion): control compensation refuses a contour the controller cannot offset (#40) | 0.8.3 |

From b3fecb3c465b2bf4ddfd33eb61646dffeb98a405 Mon Sep 17 00:00:00 2001
From: linuxguy123 <linuxguy123@gmail.com>
Date: Fri, 6 Nov 2026 23:48:15 -0600
Subject: [PATCH 03/11] feat(ui): collapse and expand browser sections

---
 crates/ui/src/egui_app/painted.rs |  10 ++
 crates/ui/src/egui_app/panes.rs   | 269 +++++++++++++++++-------------
 crates/ui/src/state.rs            |   3 +
 3 files changed, 163 insertions(+), 119 deletions(-)

diff --git a/crates/ui/src/egui_app/painted.rs b/crates/ui/src/egui_app/painted.rs
index 5e22ad65..b76006d8 100644
--- a/crates/ui/src/egui_app/painted.rs
+++ b/crates/ui/src/egui_app/painted.rs
@@ -147,6 +147,8 @@ pub struct Row {
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]
 pub enum Kind {
     Section,
+    /// A browser parent; true points down, false points right.
+    Parent(bool),
     Model,
     /// A model wearing the fixture marker (M3.2 B): the vise row, not
     /// the part row - same hideability, different noun.
@@ -324,6 +326,14 @@ pub fn tree(
 fn glyph(shapes: &mut Vec<Shape>, c: Pos2, kind: Kind, pal: &Tokens) {
     let s = Stroke::new(1.0, pal.text_dim);
     match kind {
+        Kind::Parent(expanded) => {
+            let points = if expanded {
+                vec![c + Vec2::new(-4.0, -2.0), c + Vec2::new(4.0, -2.0), c + Vec2::new(0.0, 3.0)]
+            } else {
+                vec![c + Vec2::new(-2.0, -4.0), c + Vec2::new(3.0, 0.0), c + Vec2::new(-2.0, 4.0)]
+            };
+            shapes.push(Shape::convex_polygon(points, pal.text_dim, Stroke::NONE));
+        }
         Kind::Section => {
             // Open folder: a body with a back-tab.
             let body = Rect::from_min_size(c + Vec2::new(-5.0, -3.0), Vec2::new(10.0, 7.0));
diff --git a/crates/ui/src/egui_app/panes.rs b/crates/ui/src/egui_app/panes.rs
index 1d256f8f..efbafe63 100644
--- a/crates/ui/src/egui_app/panes.rs
+++ b/crates/ui/src/egui_app/panes.rs
@@ -1263,9 +1263,24 @@ pub fn status(ui: &mut Ui, state: &mut State, pal: &Tokens) {
 // ------------------------------------------------------------------ browser
 
 /// What a browser row's click means. Parallel to the painted Row list.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum BrowserSection {
+    Setup,
+    Models,
+    Tools,
+    Operations,
+}
+
+impl BrowserSection {
+    const fn index(self) -> usize {
+        self as usize
+    }
+}
+
 #[derive(Clone)]
 pub(crate) enum Leaf {
     Section,
+    Parent(BrowserSection),
     /// The Setups page row (M3.2 A): one row over the document's whole
     /// setups list, like Tool rows - target-only, never arms Del.
     Setups,
@@ -1343,137 +1358,149 @@ pub(crate) fn browser_rows(state: &State) -> (Vec<painted::Row>, Vec<Leaf>) {
     let mut leaves = Vec::new();
     let t = state.pane_target();
 
-    push_row(&mut rows, &mut leaves, "Setup".into(), String::new(), painted::Kind::Section, None, false, false, 0, Leaf::Section);
-    // As before, the manager appears only after the document has an
-    // explicit setup. Stock and WCS follow the active setup.
-    let active = camcraft_app::setup::active(&state.world);
-    if !camcraft_app::setup::names(&state.world).is_empty() {
-        push_row(
-            &mut rows,
-            &mut leaves,
-            "Setups".to_owned(),
-            active.clone().unwrap_or_default(),
-            painted::Kind::Section,
-            Some(Icon::WorkOffset),
-            matches!(t, UiTarget::Setups),
-            false,
-            1,
-            Leaf::Setups,
-        );
-    }
-    let stock_name = camcraft_app::setup::stock_entity_name(&state.world, active.as_deref());
-    push_row(
-        &mut rows,
-        &mut leaves,
-        stock_name,
-        String::new(),
-        painted::Kind::Stock,
-        Some(Icon::Stock),
-        matches!(t, UiTarget::Stock),
-        false,
-        1,
-        Leaf::Stock,
-    );
-    for (i, slot) in WCS_SLOTS.iter().enumerate() {
-        let placed =
-            camcraft_app::setup::wcs_entity(&state.world, active.as_deref(), i).is_some();
+    let setup_open = state.browser_expanded[BrowserSection::Setup.index()];
+    push_row(&mut rows, &mut leaves, "Setup".into(), String::new(), painted::Kind::Parent(setup_open), None, false, false, 0, Leaf::Parent(BrowserSection::Setup));
+    if setup_open {
+        // As before, the manager appears only after the document has an
+        // explicit setup. Stock and WCS follow the active setup.
+        let active = camcraft_app::setup::active(&state.world);
+        if !camcraft_app::setup::names(&state.world).is_empty() {
+            push_row(
+                &mut rows,
+                &mut leaves,
+                "Setups".to_owned(),
+                active.clone().unwrap_or_default(),
+                painted::Kind::Section,
+                Some(Icon::WorkOffset),
+                matches!(t, UiTarget::Setups),
+                false,
+                1,
+                Leaf::Setups,
+            );
+        }
+        let stock_name = camcraft_app::setup::stock_entity_name(&state.world, active.as_deref());
         push_row(
             &mut rows,
             &mut leaves,
-            (*slot).to_owned(),
-            if placed { String::new() } else { "not placed".into() },
-            painted::Kind::Wcs,
-            Some(Icon::WorkOffset),
-            matches!(t, UiTarget::WcsSlot(j) if j == i),
+            stock_name,
+            String::new(),
+            painted::Kind::Stock,
+            Some(Icon::Stock),
+            matches!(t, UiTarget::Stock),
             false,
             1,
