+    assert_eq!(camcraft_app::setup::operation_order(&shell.state.world)
+        .into_iter().map(|(name, _)| name).collect::<Vec<_>>(),
+        ["Contour1", "AContour"]);
+    let script = super::shell::sim_script(&shell.state);
+    assert_eq!(script.ops, ["Contour1", "AContour"]);
+}
