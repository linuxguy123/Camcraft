@@ -0,0 +1,38 @@
+ISO-10303-21;
+HEADER;
+FILE_DESCRIPTION(('CamCraft test fixture, hand-written'), '2;1');
+FILE_NAME('tool_csys_iso13399.step', '2026-11-08T00:00:00', (''), (''), 'camcraft', '', '');
+FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
+ENDSEC;
+DATA;
+#10 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#12, #13, #14)) REPRESENTATION_CONTEXT('', '') );
+#12 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
+#13 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
+#14 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
+#20 = SHAPE_REPRESENTATION('tool', (#30, #40, #50, #60, #61, #70), #10);
+/* PCS: tool axis on z, the workpiece side toward -z */
+#30 = AXIS2_PLACEMENT_3D('PCS', #31, #32, #33);
+#31 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
+#32 = DIRECTION('', (0.0, 0.0, 1.0));
+#33 = DIRECTION('', (1.0, 0.0, 0.0));
+/* MCS 40 mm down the tool axis */
+#40 = AXIS2_PLACEMENT_3D('MCS', #41, #32, #33);
+#41 = CARTESIAN_POINT('', (0.0, 0.0, -40.0));
+/* CIP at the cutting part 75 mm down, z pointing back to the PCS */
+#50 = AXIS2_PLACEMENT_3D('CIP', #51, #52, #53);
+#51 = CARTESIAN_POINT('', (0.0, 0.0, -75.0));
+#52 = DIRECTION('', (0.0, 0.0, 1.0));
+#53 = DIRECTION('', (2.0, 0.0, 0.5));
+/* CSW1_2 off axis, written twice at the same placement */
+#60 = AXIS2_PLACEMENT_3D('CSW1_2', #62, #63, #64);
+#61 = AXIS2_PLACEMENT_3D('CSW1_2', #62, #63, #64);
+#62 = CARTESIAN_POINT('', (10.0, 0.0, -20.0));
+#63 = DIRECTION('', (1.0, 0.0, 0.0));
+#64 = DIRECTION('', (0.0, 1.0, 0.0));
+/* A vendor's own label: kept as data, not a role */
+#70 = AXIS2_PLACEMENT_3D('VENDOR_REF', #31, $, $);
+/* An unnamed placement locating a surface: not a coordinate system */
+#80 = PLANE('', #81);
+#81 = AXIS2_PLACEMENT_3D('', #51, #32, #33);
+ENDSEC;
+END-ISO-10303-21;
