diff --git a/crates/ui/src/state_per_op.rs b/crates/ui/src/state_per_op.rs
new file mode 100644
index 00000000..4b8deb21
--- /dev/null
+++ b/crates/ui/src/state_per_op.rs
@@ -0,0 +1,83 @@
+//! The post page's Output choice and the per-operation post (#111):
+//! the switch rides `SetPostOptions` (one undo unit), and a per-op
+//! post asks for a folder instead of a file.
+//! Provenance: our own page law (issue #111); no vendor material consulted.
+
+use std::path::{Path, PathBuf};
+
+use camcraft_app::posting;
+
+use super::{ErrorScope, PostView, State};
+
+impl State {
+    /// The Output choice: `true` writes one file per operation.
+    pub(super) fn set_per_op_output(&mut self, per_op: bool) {
+        let next = camcraft_app::schema::PostOptions { per_op, ..posting::post_options_of(&self.world) };
+        match camcraft_app::commands::SetPostOptions::new(&self.world, next) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = if per_op {
+                    "post writes one file per operation".to_owned()
+                } else {
+                    "post writes one combined program".to_owned()
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Operation, format!("post options not changed: {err}")),
+        }
+    }
+
+    /// The program name a per-op post stamps on its files: the
+    /// project's file stem, or `program` for an unsaved document.
+    #[must_use]
+    pub fn program_name(&self) -> String {
+        self.project_path
+            .as_deref()
+            .and_then(Path::file_stem)
+            .and_then(|s| s.to_str())
+            .unwrap_or("program")
+            .to_owned()
+    }
+
+    /// Post one file per operation into `dir`, or be refused by name -
+    /// writing nothing (posting's own law). The viewer shows the first
+    /// file; the status line names how many were written and where.
+    pub(super) fn post_program_folder(&mut self, dir: PathBuf) {
+        let program = self.program_name();
+        match posting::post_per_op(&self.world, &dir, &program) {
+            Ok(files) => {
+                let lines: usize = files.iter().map(|f| f.posted.lines).sum();
+                self.status = format!("posted {} file(s), one per operation, {lines} lines to {}", files.len(), dir.display());
+                if let Some(line) = files.first().and_then(|f| f.posted.not_judged.clone()) {
+                    self.status = format!("{} - WARNING: {line}", self.status);
+                }
+                if let Some(first) = files.into_iter().next() {
+                    let p = first.posted;
+                    self.post_view = Some(PostView {
+                        path: first.path,
+                        program: p.program,
+                        line_pos: p.line_pos,
+                        open: true,
+                        line: 0,
+                        blocks: p.blocks,
+                        trace: false,
+                        not_judged: p.not_judged,
+                    });
+                }
+            }
+            Err(err) => self.status = format!("post refused: {err}"),
+        }
+    }
+
+    /// The post's front door: a folder when the Output is one file per
+    /// operation, the program file otherwise.
+    pub(super) fn post_program_dialog(&mut self) {
+        if posting::post_options_of(&self.world).per_op {
+            if let Some(dir) = rfd::FileDialog::new().set_title("Post one file per operation into").pick_folder() {
+                self.post_program_folder(dir);
+            }
+        } else if let Some(path) = super::post_program_dialog() {
+            self.post_program_path(path);
+        }
+    }
+}

From 6a8511e853db5f9f6aa9547a10628812753d5961 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 8 Nov 2026 18:10:03 +0100
Subject: [PATCH 3/3] fix(post): refuse a post that drops a suppressed cut a
 later op assumed; afterModes manifest flag

Review B1: rest machining and the generation-time rapid verdicts walk
the setup's operation order with no suppressed filter, so a later op
is generated against a suppressed op's cut. verification_report now
refuses by name when a posted op that reads the program ahead
(operation::reads_prior) has a suppressed, cutting op ahead of it in
its setup (rest::suppressed_cuts_ahead): "operation Rest2 was
generated against the cut of suppressed Rough1; unsuppress Rough1 or
suppress Rest2 too". The per-op post runs the same gate.

Review B2: the engine refuses any PARAM AfterOperation, by operation
name, for a script that does not declare afterModes = true (the
coolantModes pattern of #150); the six shipped posts that write
afterOp() declare it.

Review notes: Fanuc drops TCPM (G49) before a Go-home reference
return; the Heidenhain home refusal and every unknown-ask refusal name
the operation. The engine's coolantModes refusal text loses a run of
stray spaces.

Pinned by suppressed_rest (both tests) and
post_engine::a_stop_asked_of_a_script_without_after_modes_is_refused_by_name.

Refs #110
Refs #111

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
