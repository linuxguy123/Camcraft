From 385339f01b4be142eb403172639059e10edb5955 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Tue, 10 Nov 2026 17:09:21 +0100
Subject: [PATCH] test(app): lathe_thread_travel builds and passes on main
 again

Two merges collided with #643's new test. #639 added `hand` to
OpParams::Threading, and the test didn't set it (E0063). 53e4aebb moved
the built-in Lathe's X min to -2.5, so the over-travel fixture's string
replace no longer matched. The fixture now rewrites only the X max: the
X stroke is the only one that reaches 320, since Z runs to +-615.

Fixes #711

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/lathe_thread_travel.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/crates/app/tests/lathe_thread_travel.rs b/crates/app/tests/lathe_thread_travel.rs
index 9ab166ac..38eaf358 100644
--- a/crates/app/tests/lathe_thread_travel.rs
+++ b/crates/app/tests/lathe_thread_travel.rs
@@ -90,6 +90,7 @@ fn thread_on(mch: &str) -> World {
         infeed: 0.4,
         feed: 120.0,
         plunge_feed: 40.0,
+        hand: camcraft_app::cl::ThreadHand::Right,
     };
     h.execute(&world, CreateOperation::new(&world, "TH1", "TD-1732-60", SrcRef::Entity("bar".into()), params).expect("create"));
     h.execute(&world, GenerateOperation::new(&world, "TH1").expect("generate"));
@@ -117,7 +118,8 @@ fn a_thread_passes_the_built_in_lathe() {
 #[test]
 fn a_real_over_travel_on_a_lathe_is_still_refused() {
     // The same lathe with an X stroke short of the thread's radius (3 mm).
-    let short = builtin_lathe().replacen("\"min\": 0.0, \"max\": 320.0", "\"min\": 0.0, \"max\": 2.0", 1);
+    // Only the X stroke reaches 320 (Z is +-615); its min is left as shipped.
+    let short = builtin_lathe().replacen("\"max\": 320.0", "\"max\": 2.0", 1);
     assert_ne!(short, builtin_lathe(), "fixture: the X band was rewritten");
     let world = thread_on(&short);
     let p = travel_problems(&world);
