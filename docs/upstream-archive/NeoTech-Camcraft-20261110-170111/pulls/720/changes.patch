index 44916e33..45b1129a 100644
--- a/crates/app/src/recognize/mod.rs
+++ b/crates/app/src/recognize/mod.rs
@@ -105,6 +105,15 @@ pub fn pockets_of(world: &World, name: &str) -> Result<Vec<Pocket>, String> {
     if tris.is_empty() {
         return Err(format!("'{name}' has no geometry"));
     }
+    // #718: "up" and "leans into" are read straight off the facet winding,
+    // so a body whose outside cannot be trusted is refused first - an
+    // inside-out cube otherwise reads its own outline as a part-deep
+    // pocket. The verdict is #387's, the one the pick tools ask.
+    let all: Vec<u32> = (0..tris.len()).filter_map(|i| u32::try_from(i).ok()).collect();
+    let verdict = crate::pick::winding::verdict_for(&crate::pick::winding::winding_of(&tris), &all);
+    if let Some(why) = winding_refusal(verdict) {
+        return Err(format!("'{name}' {why}"));
+    }
     let loc = model::transform_of(world, &e).unwrap_or_default();
     let mesh = walls::Mesh::new(&tris, &loc);
     if mesh.usable == 0 {
@@ -135,3 +144,28 @@ pub fn pockets_of(world: &World, name: &str) -> Result<Vec<Pocket>, String> {
     });
     Ok(out)
 }
+
+/// Why pockets cannot be read off a body with winding verdict `v`, as the
+/// tail of a refusal ("'part' {why}"); `None` for a closed, outward body.
+fn winding_refusal(v: Option<crate::pick::winding::BodyWinding>) -> Option<&'static str> {
+    use crate::pick::winding::BodyWinding;
+    let Some(v) = v else {
+        return Some("has no readable facets, so its pockets cannot be told from its outside");
+    };
+    Some(match v {
+        BodyWinding::Outward => return None,
+        BodyWinding::InsideOut => {
+            "is inside-out (its facets are wound inward), so its floors and walls would be read backwards - fix the model's facet winding (re-export it) before detecting pockets"
+        }
+        BodyWinding::Open => {
+            "is an open body (its shell has holes), so its inside cannot be told from its outside - repair the mesh (fill its holes) before detecting pockets"
+        }
+        BodyWinding::NonManifold => {
+            "is non-manifold (an edge is shared by more than two facets), so its inside cannot be told from its outside - repair the model before detecting pockets"
+        }
+        BodyWinding::Mixed => {
+            "has facets wound both ways, so its floors and walls cannot be read - fix the model's facet winding before detecting pockets"
+        }
+        BodyWinding::Flat => "has no volume, so it has no pockets to detect",
+    })
+}
diff --git a/crates/app/tests/pocket_recognition.rs b/crates/app/tests/pocket_recognition.rs
index 47c77f40..a9ec19eb 100644
--- a/crates/app/tests/pocket_recognition.rs
+++ b/crates/app/tests/pocket_recognition.rs
@@ -154,10 +154,36 @@ fn degenerate_input_refuses_cleanly() {
     }
     // A half-built pocket (floor and one wall, no top): nothing to read
     // as a pocket, and no panic on its open rims.
+    // #718: an open shell's inside cannot be told from its outside, so it
+    // is refused by name, never read.
     let mut torn = pocket_block(4.0).facets.to_vec();
     torn.truncate(torn.len() / 3);
     let (world, _h) = world_with(Mesh::from_facets(torn));
-    assert!(recognize::pockets_of(&world, "part").is_ok());
+    let e = recognize::pockets_of(&world, "part").expect_err("an open shell is refused");
+    assert!(e.contains("'part'") && e.contains("open body"), "{e}");
+}
+
+/// Every facet wound the other way: the body's outside is now its inside.
+fn reversed(mesh: &Mesh) -> Mesh {
+    Mesh::from_facets(mesh.facets.iter().map(|t| Triangle::new(t.a, t.c, t.b)).collect())
+}
+
+/// #718 (the review of #512): an inside-out cube's bottom face "faces up"
+/// and its outer walls "lean in", so without the winding verdict its own
+/// outline read as a part-deep closed pocket - a Pocket over the whole
+/// footprint, cut to the base. It is refused by name; so is a reversed
+/// pocketed block.
+#[test]
+fn an_inside_out_mesh_is_refused_never_read_as_a_pocket() {
+    let cube = cube(Point3::new(0.0, 0.0, 0.0), Point3::new(10.0, 10.0, 10.0));
+    for (label, mesh) in [("cube", reversed(&cube)), ("pocket block", reversed(&pocket_block(4.0)))] {
+        let (world, _h) = world_with(mesh);
+        let e = recognize::pockets_of(&world, "part").expect_err(label);
+        assert!(e.contains("'part'") && e.contains("inside-out"), "{label}: {e}");
+    }
+    // The same block wound outward still reads its one pocket.
+    let (world, _h) = world_with(pocket_block(4.0));
+    assert_eq!(recognize::pockets_of(&world, "part").map(|v| v.len()), Ok(1));
 }
 
