From ee1eb260cdeb52b1367604a38d2f9b582884421b Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 9 Nov 2026 11:34:20 +0100
Subject: [PATCH] fix(ui): pin the toolbar version in tests so a version bump
 leaves the shell snapshots alone

The toolbar build badge pinned its build time and source sha under
cfg(test) but still rendered the real CARGO_PKG_VERSION, so every
release bump changed one glyph in the three shell snapshots. The badge
now reads a toolbar-only TOOLBAR_VERSION ("0.0.0" under test), through
toolbar_lines and the new toolbar_version() used by the narrow label in
panes.rs. The debug-info dialog keeps the real version. Snapshots
regenerated; only the badge (x 1224-1253, y 25-33) differs.

Fixes #449

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ui/src/build_info.rs                   |  32 +++++++++++++++++-
 crates/ui/src/egui_app/panes.rs               |   2 +-
 crates/ui/tests/snapshots/egui_app.png        | Bin 193293 -> 193285 bytes
 crates/ui/tests/snapshots/egui_app_light.png  | Bin 193334 -> 193366 bytes
 .../ui/tests/snapshots/egui_tool_editor.png   | Bin 247491 -> 247483 bytes
 docs/decisions/449-pin-toolbar-version.md     |  21 ++++++++++++
 6 files changed, 53 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/449-pin-toolbar-version.md

diff --git a/crates/ui/src/build_info.rs b/crates/ui/src/build_info.rs
index 38dcca43..b31a6767 100644
--- a/crates/ui/src/build_info.rs
+++ b/crates/ui/src/build_info.rs
@@ -4,6 +4,15 @@ pub(crate) const VERSION: &str = env!("CARGO_PKG_VERSION");
 pub(crate) const BUILT_UTC: &str = env!("CAMCRAFT_BUILD_UTC");
 pub(crate) const SOURCE_SHA: &str = env!("CAMCRAFT_SOURCE_SHA");
 
+// The toolbar label is pinned under test (version, build time and source)
+// so the shell snapshots do not change with every version bump or commit.
+// "0.0.0" is never a released version. The debug-info dialog keeps the real
+// values.
+#[cfg(test)]
+const TOOLBAR_VERSION: &str = "0.0.0";
+#[cfg(not(test))]
+const TOOLBAR_VERSION: &str = VERSION;
+
 #[cfg(test)]
 const TOOLBAR_BUILD_UTC: &str = "2000-01-01 00:00 UTC";
 #[cfg(not(test))]
@@ -24,8 +33,13 @@ pub(crate) fn short_source() -> String {
     "test".to_owned()
 }
 
+/// The bare version label the toolbar shows at its narrowest width.
+pub(crate) fn toolbar_version() -> String {
+    format!("v{TOOLBAR_VERSION}")
+}
+
 pub(crate) fn toolbar_lines(compact: bool) -> (String, String) {
-    let top = format!("v{VERSION} · {}", short_source());
+    let top = format!("{} · {}", toolbar_version(), short_source());
     let bottom = if compact {
         format!("{} UTC", TOOLBAR_BUILD_UTC.get(5..16).unwrap_or(TOOLBAR_BUILD_UTC))
     } else {
@@ -33,3 +47,19 @@ pub(crate) fn toolbar_lines(compact: bool) -> (String, String) {
     };
     (top, bottom)
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn toolbar_label_pins_the_test_version_not_the_package_version() {
+        assert_eq!(toolbar_version(), "v0.0.0");
+        assert_ne!(TOOLBAR_VERSION, env!("CARGO_PKG_VERSION"));
+        for compact in [false, true] {
+            let (top, _) = toolbar_lines(compact);
+            assert_eq!(top, "v0.0.0 · test");
+            assert!(!top.contains(env!("CARGO_PKG_VERSION")));
+        }
+    }
+}
diff --git a/crates/ui/src/egui_app/panes.rs b/crates/ui/src/egui_app/panes.rs
index d712e89e..5a6152aa 100644
--- a/crates/ui/src/egui_app/panes.rs
+++ b/crates/ui/src/egui_app/panes.rs
@@ -1364,7 +1364,7 @@ pub fn ribbon(
     } else if badge_rect.width() >= 145.0 {
         Some(build_info::toolbar_lines(true))
     } else if badge_rect.width() >= 50.0 {
-        Some((format!("v{}", build_info::VERSION), String::new()))
+        Some((build_info::toolbar_version(), String::new()))
     } else {
         None
     };
