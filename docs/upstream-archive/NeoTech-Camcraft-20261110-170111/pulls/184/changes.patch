@@ -0,0 +1,223 @@
+//! The read side of the MCP tools (#128): the job as JSON, the kind and
+//! tool catalogs, and the verifier's findings as data. Nothing here
+//! writes the world; every number is read from the seams the app's own
+//! views read (the operation order, the file DTOs, the post gate).
+//!
+//! Provenance: our own views over this repo's document model.
+
+use crate::geometry::Aabb;
+use crate::model;
+use crate::operation::{self, KindInfo, SrcRef};
+use crate::project;
+use crate::schema::WCS_SLOTS;
+use crate::script::{api, fnum, inventory, Env};
+use crate::setup;
+use crate::verify::Warning;
+
+use serde_json::{json, Map, Value};
+
+fn aabb(b: &Aabb) -> Value {
+    json!({
+        "min": [fnum(b.min.x), fnum(b.min.y), fnum(b.min.z)],
+        "max": [fnum(b.max.x), fnum(b.max.y), fnum(b.max.z)],
+    })
+}
+
+fn src_view(src: &SrcRef) -> Value {
+    match src {
+        SrcRef::Stock => json!("stock"),
+        SrcRef::Entity(n) => json!({ "model": n }),
+        SrcRef::Selection(items) => json!({ "selection": items.len() }),
+    }
+}
+
+/// The setup slice of the job: the implicit first setup (`null`) when
+/// none is declared, else every declared one, each with its stock and
+/// the work offsets that have been placed.
+fn setups_view(env: &Env) -> Vec<Value> {
+    let w = &env.world;
+    let mut declared: Vec<Option<String>> = setup::names(w).into_iter().map(Some).collect();
+    if declared.is_empty() {
+        declared.push(None);
+    }
+    declared
+        .iter()
+        .map(|s| {
+            let d = s.as_deref();
+            let stock = setup::stock_entity(w, d).and_then(|e| model::stock_def_of(w, &e));
+            let wcs: Vec<Value> = (0..WCS_SLOTS.len())
+                .filter_map(|i| {
+                    let e = setup::wcs_entity(w, d, i)?;
+                    let loc = model::transform_of(w, &e)?;
+                    Some(json!({
+                        "slot": WCS_SLOTS.get(i).copied().unwrap_or("?"),
+                        "entity": model::name_of(w, &e),
+                        "origin": [fnum(loc.pos.x), fnum(loc.pos.y), fnum(loc.pos.z)],
+                        "rotation": loc.rot.iter().map(|v| fnum(*v)).collect::<Vec<_>>(),
+                    }))
+                })
+                .collect();
+            json!({
+                "name": s,
+                "stock": stock.as_ref().map(project::stock_to_json),
+                "stock_bounds": model::stock_world_aabb_for(w, d).as_ref().map(aabb),
+                "wcs": wcs,
+            })
+        })
+        .collect()
+}
+
+/// One operation with its whole definition: what `edit_operation`
+/// patches is `params[<kind key>]`.
+fn op_full(env: &Env, key: &str, e: &flecs_ecs::prelude::Entity, status: operation::OpStatus) -> Value {
+    let w = &env.world;
+    let op = model::operation_of(w, e);
+    let warnings = model::toolpath_of(w, e).map_or(0, |t| t.warnings.len());
+    json!({
+        "name": model::operation_label(w, key, e),
+        "key": key,
+        "kind": op.as_ref().map(|o| o.params.kind().info().label),
+        "setup": op.as_ref().and_then(|o| o.setup.clone()),
+        "tool": op.as_ref().map(|o| o.tool.clone()),
+        "source": op.as_ref().map(|o| src_view(&o.src)),
+        "status": api::st_str(status),
+        "warnings": warnings,
+        "params": op.as_ref().map(|o| project::params_to_json(&o.params)),
+    })
+}
+
+pub(super) fn get_job(env: &mut Env, _a: &Map<String, Value>) -> Result<Value, String> {
+    let w = &env.world;
+    let models: Vec<Value> = model::model_entities(w)
+        .iter()
+        .filter(|(_, e)| !model::is_stock(w, e))
+        .map(|(n, e)| {
+            json!({
+                "name": n,
+                "facets": model::facets_of(w, e).map_or(0, |f| f.len()),
+                "bounds": model::entity_world_aabb(w, e).as_ref().map(aabb),
+                "fixture": model::is_fixture(w, e),
+            })
+        })
+        .collect();
+    let tools: Vec<Value> = model::named_entities(w)
+        .iter()
+        .filter_map(|(n, e)| model::tool_of(w, e).map(|t| json!({ "name": n, "definition": project::tool_to_json(&t) })))
+        .collect();
+    let ops: Vec<Value> = inventory(env).iter().map(|(k, e, s)| op_full(env, k, e, *s)).collect();
+    Ok(json!({
+        "document": env.doc_path.as_ref().map(|p| p.display().to_string()),
+        "active_setup": setup::active(w),
+        "setups": setups_view(env),
+        "models": models,
+        "tools": tools,
+        "operations": ops,
+        "can_undo": env.history.can_undo(),
+        "can_redo": env.history.can_redo(),
+    }))
+}
+
+/// The kind's file key (`"face"`, `"pocket3d"` ...) and its default
+/// field object, read off the same default `add_operation` seeds.
+pub(super) fn kind_defaults(index: usize) -> (String, Value) {
+    let p = super::edit::seed(index);
+    match project::params_to_json(&p) {
+        Value::Object(m) => m.into_iter().next().unwrap_or((String::new(), Value::Null)),
+        _ => (String::new(), Value::Null),
+    }
+}
+
+fn json_type(v: &Value) -> &'static str {
+    match v {
+        Value::Null => "null",
+        Value::Bool(_) => "boolean",
+        Value::Number(_) => "number",
+        Value::String(_) => "string",
+        Value::Array(_) => "array",
+        Value::Object(_) => "object",
+    }
+}
+
+pub(super) fn list_operation_types(_env: &mut Env, _a: &Map<String, Value>) -> Result<Value, String> {
+    let kinds: Vec<Value> = KindInfo::ALL
+        .iter()
+        .enumerate()
+        .map(|(i, k)| {
+            let (key, defaults) = kind_defaults(i);
+            let fields: Vec<Value> = defaults
+                .as_object()
+                .map(|m| m.iter().map(|(n, v)| json!({ "name": n, "type": json_type(v), "default": v })).collect())
+                .unwrap_or_default();
+            json!({
+                "label": k.label,
+                "key": key,
+                "section": format!("{:?}", k.section),
+                "tool_kinds": k.tool_kinds.iter().map(|t| format!("{t:?}")).collect::<Vec<_>>(),
+                "fields": fields,
+            })
+        })
+        .collect();
+    Ok(json!({
+        "kinds": kinds,
+        "note": "Fields absent from the defaults are optional and off; set them in a params patch to turn them on.",
+    }))
+}
+
+pub(super) fn list_tool_catalog(_env: &mut Env, _a: &Map<String, Value>) -> Result<Value, String> {
+    let tools: Vec<Value> = crate::tools::catalog()
+        .iter()
+        .map(|(n, t)| json!({ "name": n, "definition": project::tool_to_json(t) }))
+        .collect();
+    Ok(json!({ "tools": tools }))
+}
+
+/// One verifier warning as data. Exhaustive on purpose: a new warning
+/// kind fails to compile here until it says what it is called.
+fn finding(op: &str, w: &Warning) -> Value {
+    let (kind, at) = match w {
+        Warning::Crossing { moves } => ("crossing", moves[0]),
+        Warning::Gouge { at } => ("gouge", *at),
+        Warning::ShankHit { at, .. } => ("shank_hit", *at),
+        Warning::SweepHit { at, .. } => ("sweep_hit", *at),
+        Warning::RapidInStock { at } => ("rapid_in_stock", *at),
+        Warning::FixtureHit { at, .. } => ("fixture_hit", *at),
+        Warning::NonFinite { at } => ("non_finite", *at),
+        Warning::Envelope { at, .. } => ("envelope", *at),
+        Warning::RestUnjudged { at, .. } => ("rest_unjudged", *at),
+        Warning::Scallop { at, .. } => ("scallop", *at),
+    };
+    json!({
+        "op": op,
+        "move": at,
+        "kind": kind,
+        "message": w.to_string(),
+        "blocks_post": w.blocks_post(),
+    })
+}
+
+pub(super) fn verify(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let name = super::tools::opt_str(a, "name")?;
+    let args = name.map(|n| vec![json!(n)]).unwrap_or_default();
+    let mut report = api::v_verify(env, args)?;
+    let scope: Vec<String> = report["operations"]
+        .as_array()
+        .map(|ops| ops.iter().filter_map(|o| o["key"].as_str().map(str::to_owned)).collect())
+        .unwrap_or_default();
+    let mut findings = Vec::new();
+    for key in &scope {
+        let Some(e) = model::find_by_name(&env.world, key) else { continue };
+        let label = model::operation_label(&env.world, key, &e);
+        if let Some(t) = model::toolpath_of(&env.world, &e) {
+            findings.extend(t.warnings.iter().map(|w| finding(&label, w)));
+        }
+    }
+    // The program gate's problems speak of the whole program, not one
+    // move: they ride as findings with no op and no move index.
+    if let Some(problems) = report["gate"]["problems"].as_array() {
+        for p in problems {
+            findings.push(json!({ "op": null, "move": null, "kind": "post_gate", "message": p, "blocks_post": true }));
+        }
+    }
+    report["findings"] = Value::Array(findings);
+    Ok(report)
+}
diff --git a/crates/app/src/mcp/mod.rs b/crates/app/src/mcp/mod.rs
new file mode 100644
index 00000000..cadb7823
--- /dev/null
+++ b/crates/app/src/mcp/mod.rs
@@ -0,0 +1,186 @@
+//! `camcraft-cli mcp` (#128): a Model Context Protocol server on stdio,
+//! so an AI agent can drive a headless CamCraft document a step at a
+//! time - import, set up, add and tune operations, generate, verify,
+//! post - and read every answer back as JSON.
+//!
+//! Provenance: the wire is JSON-RPC 2.0 (jsonrpc.org/specification) as
+//! the public MCP specification (modelcontextprotocol.io, revision
+//! 2025-06-18) frames it: newline-delimited messages on stdin/stdout,
+//! the `initialize` handshake, `tools/list` and `tools/call`. Our own
+//! code over serde_json; no MCP SDK. Clean-room, public sources only.
+//!
+//! The seam laws hold here exactly as in the script host (script/mod.rs):
+//! the server owns one document and one command History, every world
+//! write a tool makes rides a real command (so `undo` / `redo` walk it),
+//! and every failure is an MCP tool error (`isError: true`) naming the
+//! reason - never a panic, never a silent success.
+
+mod edit;
+mod job;
+mod tools;
+
+use crate::script::Env;
+
+use serde_json::{json, Value};
+use std::io::{BufRead, Write};
+
+/// The protocol revisions this server speaks, newest first. A client
+/// asking for one of them gets it echoed; anything else gets the newest
+/// (the spec's negotiation rule - the client decides whether to stay).
+pub const PROTOCOL_VERSIONS: [&str; 3] = ["2025-06-18", "2025-03-26", "2024-11-05"];
+
+// JSON-RPC 2.0's reserved error codes.
+const PARSE_ERROR: i64 = -32700;
+const INVALID_REQUEST: i64 = -32600;
+const METHOD_NOT_FOUND: i64 = -32601;
+const INVALID_PARAMS: i64 = -32602;
+
+/// One MCP session: one headless document and its history. In-process
+/// testable - `handle` is the whole protocol, `serve` only moves lines.
+pub struct Server {
+    env: Env,
+}
+
+impl Default for Server {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Server {
+    #[must_use]
+    pub fn new() -> Self {
+        Self { env: Env::fresh() }
+    }
+
+    /// One wire line in, at most one wire line out (notifications get
+    /// no answer). Unparseable text is a JSON-RPC parse error, not a
+    /// crash: the session goes on reading.
+    pub fn handle_line(&mut self, line: &str) -> Option<String> {
+        let text = line.trim();
+        if text.is_empty() {
+            return None;
+        }
+        let reply = match serde_json::from_str::<Value>(text) {
+            Ok(msg) => self.handle(&msg),
+            Err(e) => Some(rpc_error(Value::Null, PARSE_ERROR, &format!("parse error: {e}"))),
+        };
+        reply.map(|v| v.to_string())
+    }
+
+    /// One JSON-RPC message. Requests (with an `id`) get a response;
+    /// notifications (no `id`) get none, as the spec requires.
+    pub fn handle(&mut self, msg: &Value) -> Option<Value> {
+        let Value::Object(obj) = msg else {
+            // Batches left the protocol at 2025-06-18; a bare array or
+            // scalar is an invalid request, answered once.
+            return Some(rpc_error(Value::Null, INVALID_REQUEST, "a single JSON-RPC object was expected"));
+        };
+        let id = obj.get("id").cloned();
+        if obj.get("jsonrpc") != Some(&json!("2.0")) {
+            return id.map(|id| rpc_error(id, INVALID_REQUEST, "\"jsonrpc\" must be \"2.0\""));
+        }
+        let Some(method) = obj.get("method").and_then(Value::as_str) else {
+            // A response from the client (we send no requests) or junk.
+            return id.map(|id| rpc_error(id, INVALID_REQUEST, "a \"method\" string is required"));
+        };
+        let params = obj.get("params").cloned().unwrap_or(Value::Null);
+        let Some(id) = id else {
+            // Notifications: `notifications/initialized`, cancellations.
+            // Nothing to answer, nothing to do for a synchronous server.
+            return None;
+        };
+        let answer = match method {
+            "initialize" => Ok(initialize(&params)),
+            "ping" => Ok(json!({})),
+            "tools/list" => Ok(json!({ "tools": tools::list() })),
+            "tools/call" => self.call(&params),
+            other => Err((METHOD_NOT_FOUND, format!("method not found: {other}"))),
+        };
+        Some(match answer {
+            Ok(result) => json!({ "jsonrpc": "2.0", "id": id, "result": result }),
+            Err((code, msg)) => rpc_error(id, code, &msg),
+        })
+    }
+
+    /// `tools/call`: malformed call params are a protocol error; anything
+    /// the tool itself refuses - unknown tool name included - is a tool
+    /// result with `isError`, which is what an agent can read and act on.
+    fn call(&mut self, params: &Value) -> Result<Value, (i64, String)> {
+        let Some(name) = params.get("name").and_then(Value::as_str) else {
+            return Err((INVALID_PARAMS, "tools/call needs a \"name\" string".into()));
+        };
+        let args = match params.get("arguments") {
+            None | Some(Value::Null) => json!({}),
+            Some(v @ Value::Object(_)) => v.clone(),
+            Some(_) => return Err((INVALID_PARAMS, "\"arguments\" must be an object".into())),
+        };
+        // Backstop only: no tool path panics by law, but a bug in a
+        // generator must still come back as a refusal, not kill the
+        // session the agent is driving.
+        let env = &mut self.env;
+        let run = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| tools::call(env, name, &args)));
+        let outcome = match run {
+            Ok(r) => r,
+            Err(_) => Err(format!("{name}: internal error - the tool stopped unexpectedly (a bug; please report it)")),
+        };
+        Ok(match outcome {
+            Ok(value) => tool_ok(value),
+            Err(msg) => tool_err(&msg),
+        })
+    }
+}
+
+fn initialize(params: &Value) -> Value {
+    let asked = params.get("protocolVersion").and_then(Value::as_str);
+    let version = asked
+        .and_then(|a| PROTOCOL_VERSIONS.iter().find(|v| **v == a))
+        .copied()
+        .unwrap_or(PROTOCOL_VERSIONS[0]);
+    json!({
+        "protocolVersion": version,
+        "capabilities": { "tools": { "listChanged": false } },
+        "serverInfo": { "name": "camcraft", "version": env!("CARGO_PKG_VERSION") },
+        "instructions": "CamCraft headless CAM document. Typical flow: import_model, set_stock, \
+add_tool, add_operation, generate, verify, post. Every change is undoable (undo / redo); \
+get_job shows the whole document; list_operation_types shows each kind's parameters.",
+    })
+}
+
+/// A tool answer: the JSON as text (every client reads that) and as
+/// `structuredContent` (clients that read data take it from there).
+fn tool_ok(value: Value) -> Value {
+    let structured = match value {
+        Value::Object(_) => value,
+        other => json!({ "result": other }),
+    };
+    let text = serde_json::to_string_pretty(&structured).unwrap_or_default();
+    json!({
+        "content": [{ "type": "text", "text": text }],
+        "structuredContent": structured,
+        "isError": false,
+    })
+}
+
+fn tool_err(msg: &str) -> Value {
+    json!({ "content": [{ "type": "text", "text": msg }], "isError": true })
+}
+
+fn rpc_error(id: Value, code: i64, msg: &str) -> Value {
+    json!({ "jsonrpc": "2.0", "id": id, "error": { "code": code, "message": msg } })
+}
+
+/// The stdio loop: one message per line in, one per line out, flushed
+/// at once (the client waits on it). Ends cleanly at end of input.
+/// Diagnostics never go to stdout - that stream is the protocol's.
+pub fn serve(input: impl BufRead, mut output: impl Write) -> std::io::Result<()> {
+    let mut server = Server::new();
+    for line in input.lines() {
+        let line = line?;
+        if let Some(reply) = server.handle_line(&line) {
+            writeln!(output, "{reply}")?;
+            output.flush()?;
+        }
+    }
+    Ok(())
+}
diff --git a/crates/app/src/mcp/tools.rs b/crates/app/src/mcp/tools.rs
new file mode 100644
index 00000000..a97bf915
--- /dev/null
+++ b/crates/app/src/mcp/tools.rs
@@ -0,0 +1,229 @@
+//! The MCP tool table (#128): name, description, JSON input schema and
+//! the Rust handler, one row each - `tools/list` and `tools/call` read
+//! the same rows, so a listed tool always runs and a running one is
+//! always listed (the script host's VERBS law, at the MCP door).
+//!
+//! Provenance: our own tool surface over this repo's commands and the
+//! script verbs; schemas are JSON Schema as the MCP spec carries them.
+
+use super::{edit, job};
+use crate::script::{api, Env};
+
+use serde_json::{json, Map, Value};
+
+type Handler = fn(&mut Env, &Map<String, Value>) -> Result<Value, String>;
+
+struct Tool {
+    name: &'static str,
+    description: &'static str,
+    schema: fn() -> Value,
+    run: Handler,
+}
+
+const TOOLS: &[Tool] = &[
+    Tool { name: "open_project", description: "Open a .camproj project file, replacing the current document and clearing undo history.", schema: s_path, run: open_project },
+    Tool { name: "save_project", description: "Save the document as a .camproj file. Without a path, saves over the file last opened or saved.", schema: s_opt_path, run: save_project },
+    Tool { name: "import_model", description: "Import a mesh model (STL, STEP or OBJ) through the app's importers. A name already used by a model updates that model.", schema: s_import, run: import_model },
+    Tool { name: "get_job", description: "The whole document as JSON: setups, stock, work offsets, models, tools, and operations with their parameters and status.", schema: s_empty, run: job::get_job },
+    Tool { name: "list_operation_types", description: "Every operation kind with its parameter fields, JSON types and default values, and the tool kinds it accepts.", schema: s_empty, run: job::list_operation_types },
+    Tool { name: "list_tool_catalog", description: "The built-in tool catalog: names and definitions add_tool can copy into the document.", schema: s_empty, run: job::list_tool_catalog },
+    Tool { name: "add_tool", description: "Add a tool to the document, from the catalog by name or from a full definition (the shape get_job shows).", schema: s_add_tool, run: edit::add_tool },
+    Tool { name: "set_stock", description: "Set the active setup's stock: a box, a cylinder, or a copy of a model.", schema: s_stock, run: edit::set_stock },
+    Tool { name: "add_operation", description: "Add an operation of a kind (see list_operation_types) with a tool, on the stock or a model, seeded with the kind's defaults and an optional params patch. Not generated until generate runs.", schema: s_add_op, run: edit::add_operation },
+    Tool { name: "edit_operation", description: "Patch an operation's parameters: the given fields replace the current ones (JSON merge patch over the kind's fields; null clears an optional field). One undo step.", schema: s_edit_op, run: edit::edit_operation },
+    Tool { name: "delete_operation", description: "Delete an operation and its cached toolpath.", schema: s_name, run: edit::delete_operation },
+    Tool { name: "set_tool", description: "Assign a document tool to an operation (the tool must suit the operation's kind).", schema: s_set_tool, run: edit::set_tool },
+    Tool { name: "undo", description: "Undo the last document change.", schema: s_empty, run: edit::undo },
+    Tool { name: "redo", description: "Redo the last undone change.", schema: s_empty, run: edit::redo },
+    Tool { name: "generate", description: "Generate toolpaths: one named operation (always regenerated) or, with no name, every operation that is not current.", schema: s_opt_name, run: generate },
+    Tool { name: "verify", description: "Verify the job without posting: per-operation status and findings (op, move index, kind, message, whether it blocks the post) plus the program-level post gate.", schema: s_opt_name, run: job::verify },
+    Tool { name: "post", description: "Post the program to an NC file through a post processor (a built-in name or a .cps path; default the document's own). Returns the written files, or refuses with the reasons.", schema: s_post, run: post },
+];
+
+/// The `tools/list` rows.
+pub(super) fn list() -> Vec<Value> {
+    TOOLS
+        .iter()
+        .map(|t| json!({ "name": t.name, "description": t.description, "inputSchema": (t.schema)() }))
+        .collect()
+}
+
+/// Run one tool by name. An unknown name is a refusal like any other.
+pub(super) fn call(env: &mut Env, name: &str, args: &Value) -> Result<Value, String> {
+    let Some(tool) = TOOLS.iter().find(|t| t.name == name) else {
+        let names: Vec<&str> = TOOLS.iter().map(|t| t.name).collect();
+        return Err(format!("unknown tool '{name}' - tools: {}", names.join(", ")));
+    };
+    let empty = Map::new();
+    let map = args.as_object().unwrap_or(&empty);
+    // Typos are refused, never ignored: an argument the schema does not
+    // name would otherwise read as "done as asked".
+    let schema = (tool.schema)();
+    let known = schema["properties"].as_object();
+    for key in map.keys() {
+        if known.is_none_or(|k| !k.contains_key(key)) {
+            return Err(format!("{name}: unknown argument \"{key}\""));
+        }
+    }
+    (tool.run)(env, map).map_err(|e| format!("{name}: {e}"))
+}
+
+// ---- argument readers -------------------------------------------------
+
+pub(super) fn req_str<'a>(a: &'a Map<String, Value>, key: &str) -> Result<&'a str, String> {
+    match a.get(key) {
+        Some(Value::String(s)) if !s.is_empty() => Ok(s),
+        None | Some(Value::Null) => Err(format!("\"{key}\" is required")),
+        Some(other) => Err(format!("\"{key}\" must be a non-empty string, got {other}")),
+    }
+}
+
+pub(super) fn opt_str<'a>(a: &'a Map<String, Value>, key: &str) -> Result<Option<&'a str>, String> {
+    match a.get(key) {
+        None | Some(Value::Null) => Ok(None),
+        Some(Value::String(s)) => Ok(Some(s)),
+        Some(other) => Err(format!("\"{key}\" must be a string, got {other}")),
+    }
+}
+
+// ---- handlers that are a script verb, re-dressed ----------------------
+
+fn open_project(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let path = req_str(a, "path")?;
+    api::v_load(env, vec![json!(path)])
+}
+
+fn save_project(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let args = opt_str(a, "path")?.map(|p| vec![json!(p)]).unwrap_or_default();
+    api::v_save(env, args)
+}
+
+fn import_model(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let mut args = vec![json!(req_str(a, "path")?)];
+    if let Some(n) = opt_str(a, "name")? {
+        args.push(json!(n));
+    }
+    api::v_import(env, args)
+}
+
+fn generate(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let args = opt_str(a, "name")?.map(|n| vec![json!(n)]).unwrap_or_default();
+    let ops = api::v_generate(env, args)?;
+    Ok(json!({ "generated": ops }))
+}
+
+fn post(env: &mut Env, a: &Map<String, Value>) -> Result<Value, String> {
+    let to = req_str(a, "output")?;
+    let mut opts = json!({ "to": to });
+    if let Some(p) = opt_str(a, "post")? {
+        opts["cps"] = json!(p);
+    }
+    let mut out = api::v_post(env, vec![opts])?;
+    out["files"] = json!([to]);
+    Ok(out)
+}
+
+// ---- input schemas ----------------------------------------------------
+
+fn obj(props: Value, required: &[&str]) -> Value {
+    json!({ "type": "object", "properties": props, "required": required, "additionalProperties": false })
+}
+
+fn s_empty() -> Value {
+    obj(json!({}), &[])
+}
+
+fn s_path() -> Value {
+    obj(json!({ "path": { "type": "string", "description": "File path." } }), &["path"])
+}
+
+fn s_opt_path() -> Value {
+    obj(json!({ "path": { "type": "string", "description": "File path (optional)." } }), &[])
+}
+
+fn s_import() -> Value {
+    obj(
+        json!({
+            "path": { "type": "string", "description": "An .stl, .step/.stp or .obj file." },
+            "name": { "type": "string", "description": "Model name; defaults to the file stem." }
+        }),
+        &["path"],
+    )
+}
+
+fn s_name() -> Value {
+    obj(json!({ "name": { "type": "string", "description": "Operation name (key or label)." } }), &["name"])
+}
+
+fn s_opt_name() -> Value {
+    obj(json!({ "name": { "type": "string", "description": "Operation name; omit for all." } }), &[])
+}
+
+fn s_add_tool() -> Value {
+    obj(
+        json!({
+            "name": { "type": "string", "description": "Tool name in the document; defaults to the catalog name." },
+            "catalog": { "type": "string", "description": "A list_tool_catalog name to copy." },
+            "definition": { "type": "object", "description": "A full tool definition (get_job's tool shape)." }
+        }),
+        &[],
+    )
+}
+
+fn s_stock() -> Value {
+    obj(
+        json!({
+            "box": { "type": "object", "description": "{dx, dy, dz} in mm; centered in XY, z from 0 to dz.",
+                "properties": { "dx": {"type": "number"}, "dy": {"type": "number"}, "dz": {"type": "number"} },
+                "required": ["dx", "dy", "dz"] },
+            "cylinder": { "type": "object", "description": "{diameter, height} in mm.",
+                "properties": { "diameter": {"type": "number"}, "height": {"type": "number"} },
+                "required": ["diameter", "height"] },
+            "from_model": { "type": "string", "description": "A model name whose mesh becomes the stock." }
+        }),
+        &[],
+    )
+}
+
+fn s_add_op() -> Value {
+    obj(
+        json!({
+            "kind": { "type": "string", "description": "Operation kind: label or key from list_operation_types." },
+            "tool": { "type": "string", "description": "A document tool name (add_tool first)." },
+            "name": { "type": "string", "description": "Operation name; defaults to the kind's label plus a number." },
+            "source": { "type": "string", "description": "\"stock\" (default) or a model name." },
+            "params": { "type": "object", "description": "Fields to change from the kind's defaults." }
+        }),
+        &["kind", "tool"],
+    )
+}
+
+fn s_edit_op() -> Value {
+    obj(
+        json!({
+            "name": { "type": "string", "description": "Operation name (key or label)." },
+            "params": { "type": "object", "description": "Fields to change (see get_job for the current ones)." }
+        }),
+        &["name", "params"],
+    )
+}
+
+fn s_set_tool() -> Value {
+    obj(
+        json!({
+            "operation": { "type": "string", "description": "Operation name (key or label)." },
+            "tool": { "type": "string", "description": "A document tool name." }
+        }),
+        &["operation", "tool"],
+    )
+}
+
+fn s_post() -> Value {
+    obj(
+        json!({
+            "output": { "type": "string", "description": "The .nc file to write." },
+            "post": { "type": "string", "description": "A built-in post name (Fanuc, Haas, Siemens 840D, Heidenhain, Mazak) or a .cps path." }
+        }),
+        &["output"],
+    )
+}
