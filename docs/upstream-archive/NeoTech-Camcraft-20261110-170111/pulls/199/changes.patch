 crates/app/src/operation/generate.rs |  3 ++
 crates/app/tests/drill_prior.rs      | 63 +++++++++++++++++++++++++---
 crates/motion/src/turning/face.rs    | 30 ++++++++++---
 crates/motion/tests/turning_face.rs  | 57 +++++++++++++++++++------
 5 files changed, 152 insertions(+), 23 deletions(-)

