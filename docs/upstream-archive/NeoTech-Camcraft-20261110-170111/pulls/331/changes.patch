 crates/app/tests/setup_wcs.rs             |  4 ++--
 crates/ui/src/egui_app/setup_wcs_tests.rs |  4 ++--
 crates/ui/src/state.rs                    |  2 +-
 4 files changed, 11 insertions(+), 13 deletions(-)

