+## #198 - box stock fitted per side (2026-11-07)
+
+- **Chosen:** for box stock the Stock page offers "Per side": six
+  allowances (-X, +X, -Y, +Y, bottom, top) replace the single fit margin,
+  and Fit to Models sends `StockFitSides`, which wraps the models' box by
+  each side's own amount (`stock::fit_box_sides`: each face its own
+  allowance off the models; refused by name for a negative or
+  non-finite allowance) through the same undoable `SetStock` as the
+  single-margin fit (both now share `State::apply_stock_fit`). Equal
+  sides read exactly as the single-margin fit.
+- **Why:** a blank is rarely padded evenly - a facing allowance on top,
+  nothing under a flat bottom, more on the side a vise jaw grips.
+- **Dropped:** per-side for cylinders (a radial allowance is one number;
+  bottom/top could follow if asked); storing the allowances in the
+  document (they are a fit recipe, not stock - the stock stays the
+  explicit box the fit produced).
diff --git a/crates/geometry/src/geometry/stock.rs b/crates/geometry/src/geometry/stock.rs
index 7f1e7b17..a36e5a9b 100644
--- a/crates/geometry/src/geometry/stock.rs
+++ b/crates/geometry/src/geometry/stock.rs
@@ -122,6 +122,31 @@ pub fn fit_box(bounds: &Aabb, margin: f64) -> Option<(StockShape, Point3)> {
     Some((StockShape::Box { dx, dy, dz }, pos))
 }
 
+/// Box stock that wraps `bounds` by a separate allowance on each side
+/// (#198): `sides` is `[-X, +X, -Y, +Y, bottom, top]`, each a finite
+/// non-negative length. The box is placed so each face stands its own
+/// allowance off the models (XY centre between the padded faces, bottom at
+/// `min.z - bottom`). Degenerate input yields `None`, as [`fit_box`].
+#[must_use]
+pub fn fit_box_sides(bounds: &Aabb, sides: [f64; 6]) -> Option<(StockShape, Point3)> {
+    if !sides.iter().all(|s| s.is_finite() && *s >= 0.0) {
+        return None;
+    }
+    let (min, max) = (bounds.min, bounds.max);
+    if !(min.is_finite() && max.is_finite()) {
+        return None;
+    }
+    let [xm, xp, ym, yp, zb, zt] = sides;
+    let (x0, x1) = (min.x - xm, max.x + xp);
+    let (y0, y1) = (min.y - ym, max.y + yp);
+    let (z0, z1) = (min.z - zb, max.z + zt);
+    let (dx, dy, dz) = (x1 - x0, y1 - y0, z1 - z0);
+    if !(positive(dx) && positive(dy) && positive(dz)) {
+        return None;
+    }
+    Some((StockShape::Box { dx, dy, dz }, Point3::new((x0 + x1) * 0.5, (y0 + y1) * 0.5, z0)))
+}
+
