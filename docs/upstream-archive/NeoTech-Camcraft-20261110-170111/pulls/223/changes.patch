+/// `t` turned by `ang` radians about X.
+fn tilt_x(t: &Triangle, ang: f64) -> Triangle {
+    let (c, s) = (ang.cos(), ang.sin());
+    let r = |p: Point3| Point3::new(p.x, c * p.y - s * p.z, s * p.y + c * p.z);
+    Triangle::new(r(t.a), r(t.b), r(t.c))
+}
