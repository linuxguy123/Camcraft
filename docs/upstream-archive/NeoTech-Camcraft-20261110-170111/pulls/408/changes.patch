+            mm(i.min[1]),
+            mm(i.min[2]),
+            mm(i.max[0]),
+            mm(i.max[1]),
+            mm(i.max[2]),
+            mm(i.volume),
+        )),
+        Err(why) => out.push_str(&format!("  incoming not known: {why}
+")),
+    }
+}
