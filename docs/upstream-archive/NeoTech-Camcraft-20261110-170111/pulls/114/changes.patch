From 4408343981b71250c54fe28f6d7aad707e95ee43 Mon Sep 17 00:00:00 2001
From: linuxguy123 <linuxguy123@gmail.com>
Date: Sat, 7 Nov 2026 12:50:36 -0600
Subject: [PATCH 3/4] fix(aur): disable makepkg LTO for Flecs linking

Arch's default GCC LTO makes the bundled Flecs C archive incompatible with rust-lld. Disable package LTO and keep AUR metadata in sync.

Refs #72
---
 RECOMMENDED.md | 5 +++++
 aur/.SRCINFO   | 1 +
 aur/PKGBUILD   | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/RECOMMENDED.md b/RECOMMENDED.md
index 5c0da85e..19764e44 100644
--- a/RECOMMENDED.md
+++ b/RECOMMENDED.md
@@ -12991,3 +12991,8 @@ keeps the part-only chain bit for bit.
   and upload the result. Keep this out of `release.yml` because the source
   recipe follows tagged versions and AUR updates, while `release.yml`
   assembles assets only for a CamCraft release.
+- The first Arch build reached `ld.lld` but could not resolve Flecs C symbols.
+  The likely cause is makepkg's default LTO compiling the bundled Flecs C into
+  GCC LTO objects that rust-lld cannot consume. Set `options=('!lto')` in the
+  package recipe, as the Arch Rust package guidelines prescribe for mixed
+  Rust/C projects, and verify the fix with another Arch package build.
diff --git a/aur/.SRCINFO b/aur/.SRCINFO
index fd214cb7..e3a9737f 100644
--- a/aur/.SRCINFO
+++ b/aur/.SRCINFO
@@ -5,6 +5,7 @@ pkgbase = camcraft
 	url = https://github.com/NeoTech/Camcraft
 	arch = x86_64
 	license = MIT
+	options = !lto
 	makedepends = cargo
 	makedepends = pkgconf
 	depends = glibc
diff --git a/aur/PKGBUILD b/aur/PKGBUILD
index 267a7bba..68844d0d 100644
--- a/aur/PKGBUILD
+++ b/aur/PKGBUILD
@@ -10,6 +10,9 @@ license=('MIT')
 depends=('glibc' 'libgcc' 'libxkbcommon' 'libxkbcommon-x11' 'libx11'
          'wayland' 'vulkan-icd-loader' 'libglvnd')
 makedepends=('cargo' 'pkgconf')
+# Flecs compiles bundled C with cc-rs; Arch GCC LTO objects cannot be linked
+# by rust-lld, leaving every Flecs C symbol undefined at the final link.
+options=('!lto')
 source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
         'camcraft.desktop')
 sha256sums=('3b36cfef889001d3692d079a99db3b51fa313737782169519144564dd61c66a6'

