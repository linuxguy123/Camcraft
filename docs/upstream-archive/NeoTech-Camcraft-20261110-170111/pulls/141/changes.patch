+## #107 - unsaved changes: a dirty flag and a save prompt on exit (2026-11-07)
+
+- **Chosen:** the document is dirty when the command history's undo
+  depth differs from the depth recorded at the last save or load
+  (`History::is_dirty` / `History::mark_clean` in `camcraft_app::commands`).
+  Undo back to the saved point is clean again; a redo past it is dirty
+  again; a fresh command while the saved state sits on the redo stack
+  makes the saved point unreachable (`None`), so the same depth on a new
+  branch stays dirty. `History::clear` (New, Open) starts clean. Ephemeral
+  state (selection via `execute_ephemeral`, camera, hover, layout) never
+  touches the history, so it never dirties.
+- **Why on `History`, not `project::is_dirty(world)`:** the history lives
+  in the UI's `State`, not in the world, and the flag is a property of the
+  history position; putting it next to `undo`/`redo` keeps it exact by
+  construction and still in the app layer. Cost to move: a thin
+  `project::is_dirty(&History)` wrapper if a non-UI caller wants one.
+- **UI:** the window title leads with `*` while dirty. New, Open (the
+  dialog arm) and Quit over a dirty document are held in
+  `State::unsaved_prompt` and an egui `Modal` asks Save / Don't Save /
+  Cancel (Escape or the backdrop = Cancel); the answer is a queued
+  `CommandKind::ResolveUnsaved`. Save without a path asks for one; a
+  cancelled or failed save keeps the document and the app open. The
+  window X now queues a Quit like Ctrl+Q (a shell whose GPU failed still
+  closes at once, since it never drains the queue).
+- **The shell is winit, not eframe:** the brief's
+  `viewport().close_requested()` + `CancelClose` does not apply - the
+  shell owns `WindowEvent::CloseRequested`, so it simply does not exit
+  there.
+- **Dropped:** guarding the headless `OpenProjectFile` / `SaveProjectFile`
+  arms (scripts and tests drive them; a prompt there would hang a
+  headless run); a dirty counter bumped per command (cannot know when an
+  undo returns to the saved state); hashing the document (costly, and
+  derived caches such as toolpaths would make it noisy).
diff --git a/crates/app/src/commands/mod.rs b/crates/app/src/commands/mod.rs
index dd9c55be..a81e3a72 100644
--- a/crates/app/src/commands/mod.rs
+++ b/crates/app/src/commands/mod.rs
@@ -78,14 +78,30 @@ pub trait Command {
 
 /// Linear undo/redo over executed commands. Executing a fresh command clears
 /// the redo stack (standard history semantics).
-#[derive(Default)]
+///
+/// The history also knows whether the document has unsaved changes (#107):
+/// `saved` is the undo depth at the last save or load. The document is
+/// clean exactly when the current depth equals it - so undoing back to the
+/// saved point is clean again, and redoing past it is dirty again. A fresh
+/// command executed while the saved point sits on the redo stack discards
+/// that state for good, so the saved point becomes unreachable (`None`).
 pub struct History {
     done: Vec<Box<dyn Command>>,
     redo: Vec<Box<dyn Command>>,
+    saved: Option<usize>,
+}
+
+impl Default for History {
+    fn default() -> Self {
+        Self { done: Vec::new(), redo: Vec::new(), saved: Some(0) }
+    }
 }
 
 impl History {
     pub fn execute(&mut self, world: &World, command: impl Command + 'static) {
+        if self.saved.is_some_and(|depth| depth > self.done.len()) {
+            self.saved = None;
+        }
         command.apply(world);
         self.done.push(Box::new(command));
         self.redo.clear();
@@ -120,9 +136,23 @@ impl History {
     }
 
     /// Drop all history; used when a document replaces the current one.
+    /// The replacing document (blank or loaded) starts clean.
     pub fn clear(&mut self) {
         self.done.clear();
         self.redo.clear();
+        self.saved = Some(0);
+    }
+
+    /// Record the current position as the saved state (after a save or a
+    /// load succeeded).
+    pub fn mark_clean(&mut self) {
+        self.saved = Some(self.done.len());
+    }
+
+    /// True when the document differs from the last save or load: the
+    /// history position is not the recorded saved position.
+    pub fn is_dirty(&self) -> bool {
+        self.saved != Some(self.done.len())
     }
 
     pub fn can_undo(&self) -> bool {
diff --git a/crates/app/tests/dirty_flag.rs b/crates/app/tests/dirty_flag.rs
new file mode 100644
index 00000000..b9206ed6
--- /dev/null
+++ b/crates/app/tests/dirty_flag.rs
@@ -0,0 +1,71 @@
+//! #107: the unsaved-changes flag. The document is dirty exactly when the
+//! command history sits away from the position of the last save or load:
+//! a command dirties it, a save cleans it, undoing back to the saved point
+//! cleans it again and redoing past it dirties it again.
+//!
+//! Gate map: covers app::commands (History's saved point), app::project
+//! (save/load as the clean points).
+//!
+//! Provenance: our own tests of standard document-editor semantics; no
+//! HSMWorks material involved.
+
+use camcraft_app::commands::{History, ImportModel, SetUnits};
+use camcraft_app::geometry::{cube, Point3};
+use camcraft_app::project;
+use camcraft_app::units::Unit;
+use camcraft_app::world::new_world;
+
+fn temp_project(tag: &str) -> std::path::PathBuf {
+    std::env::temp_dir().join(format!("camcraft-dirty-{tag}-{}.camproj", std::process::id()))
+}
+
+#[test]
+fn dirty_tracks_the_saved_point_through_undo_and_redo() {
+    let world = new_world();
+    let mut history = History::default();
+    assert!(!history.is_dirty(), "a fresh document is clean");
+
+    history.execute(&world, ImportModel::from_mesh("a", cube(Point3::ZERO, Point3::new(1.0, 1.0, 1.0))));
+    assert!(history.is_dirty(), "a command dirties the document");
+
+    let path = temp_project("roundtrip");
+    let saved = project::save(&world, &path);
+    assert!(saved.is_ok(), "save: {saved:?}");
+    history.mark_clean();
+    assert!(!history.is_dirty(), "a save cleans the document");
+
+    history.execute(&world, SetUnits::new(&world, Unit::Inches).expect("to inches"));
+    assert!(history.is_dirty(), "a command after the save dirties it");
+    assert!(history.undo(&world));
+    assert!(!history.is_dirty(), "undo back to the saved point is clean");
+    assert!(history.undo(&world));
+    assert!(history.is_dirty(), "undo past the saved point is dirty");
+    assert!(history.redo(&world));
+    assert!(!history.is_dirty(), "redo back onto the saved point is clean");
+    assert!(history.redo(&world));
+    assert!(history.is_dirty(), "redo past the saved point is dirty again");
+
+    // A load replaces the document: the timeline clears and the loaded
+    // state is the new clean point.
+    history.clear();
+    let loaded = project::load(&world, &path);
+    let _ = std::fs::remove_file(&path);
+    assert!(loaded.is_ok(), "load: {loaded:?}");
+    assert!(!history.is_dirty(), "a loaded document is clean");
+}
+
+#[test]
+fn a_new_branch_makes_the_saved_point_unreachable() {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, ImportModel::from_mesh("a", cube(Point3::ZERO, Point3::new(1.0, 1.0, 1.0))));
+    history.execute(&world, SetUnits::new(&world, Unit::Inches).expect("to inches"));
+    history.mark_clean();
+    assert!(history.undo(&world));
+    // A fresh command discards the saved state from the redo stack: the
+    // depth matches again, but the document is not the saved one.
+    history.execute(&world, ImportModel::from_mesh("b", cube(Point3::ZERO, Point3::new(2.0, 2.0, 2.0))));
+    assert!(history.is_dirty(), "same depth on a new branch is still dirty");
+    assert!(history.undo(&world));
+    assert!(history.is_dirty(), "the saved point is gone for good");
+}
