From 42733cf9febab2e5aa29d3f001aa659afbd0eb41 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 8 Nov 2026 00:19:45 +0100
Subject: [PATCH] test(app): order the lathe rough ahead of its finish in the
 field-sim fixture

The fixture named its ops PR1 and PF1. CreateOperation stores no
explicit position, so operation_order breaks the tie by name and PF1
sorted ahead of PR1: the finish was created in front of the already
generated rough. Since #109 (PR #153) every unposed op's stamp reads
the program ahead, so PR1's stamp gained a prior term and it correctly
read Stale - the stamp's tool, params, source and stock terms were
unchanged, only the prior digest was new.

Rename the ops R1/S1 (the lathe_post fixture's names) and assert the
program order, so the fixture machines rough then finish.

Fixes #186

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/lathe_field_sim.rs | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/crates/app/tests/lathe_field_sim.rs b/crates/app/tests/lathe_field_sim.rs
index edca91e0..d7e50d22 100644
--- a/crates/app/tests/lathe_field_sim.rs
+++ b/crates/app/tests/lathe_field_sim.rs
@@ -254,9 +254,16 @@ fn profile_rough_and_finish_simulate_with_meridian_parity() {
         feed: 120.0,
         plunge_feed: 60.0,
     };
-    generate(&world, &mut history, "PR1", "TN-1600-0R8", rough);
-    generate(&world, &mut history, "PF1", "TN-1600-0R8", finish);
-    assert_parity("profile rough+finish", &world, &["PR1", "PF1"], 0.8);
+    // Names are the program order's tie-break for ops created without an
+    // explicit position (`setup::operation_order`), so they must sort
+    // rough first: "PF1" sorted ahead of "PR1" and slipped the finish in
+    // front of the already-generated rough, which (#109: the rough reads
+    // the program ahead) correctly read Stale (#186). Same as lathe_post.
+    generate(&world, &mut history, "R1", "TN-1600-0R8", rough);
+    generate(&world, &mut history, "S1", "TN-1600-0R8", finish);
+    let order: Vec<String> = camcraft_app::setup::operation_order(&world).into_iter().map(|(n, _)| n).collect();
+    assert_eq!(order, ["R1", "S1"], "fixture: the rough machines ahead of the finish");
+    assert_parity("profile rough+finish", &world, &["R1", "S1"], 0.8);
 }
 
 #[test]
