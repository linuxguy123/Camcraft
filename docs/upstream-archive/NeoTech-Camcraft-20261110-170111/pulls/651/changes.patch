+    // a point inside the cut within half a cell of the wall used to read
+    // the shell floor. Every point inside the slot is refused now.
+    let mut s = Stock::Field(plate());
+    let p = |x: f64, y: f64, z: f64| Point3::new(x, y, z);
+    let moves = [
