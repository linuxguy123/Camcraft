From d4b0445f71099ed17b99e5ff09d58ecd6459971f Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 7 Nov 2026 23:17:15 +0100
Subject: [PATCH 1/2] fix(sim): march sideways rapids along their whole length

Law (d) judged a lateral rapid under the clearance plane at its start,
midpoint and end only, and on 2.5-D paths hidden_along returns early
with no model - so a floor-depth link between two pockets whose three
samples stood in cut air drove through the uncut wall between them and
posted.

The column reading now marches the rapid at stations every d / RINGS
(the footprint's ring spacing, floored at 0.01 mm), both ends included,
and applies the #106 footprint test at each, with or without a model.
The footprint reaches d ahead of and behind each station, so no wall
slips between stations (step minus reach is non-positive); the only
remaining bound is the footprint's own sampling. A rapid needing more
than 2^18 stations fails closed (convicted) rather than being thinned.

Pinned by sideways_rapids: the issue's 4 mm wall and a 1 mm wall are
refused; a 68 mm link over a fully cut slot stays clean.

Fixes #140

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/sim/src/verify/rapids.rs     |  65 ++++++++++++--
 crates/sim/tests/sideways_rapids.rs | 129 ++++++++++++++++++++++++++++
 2 files changed, 189 insertions(+), 5 deletions(-)
 create mode 100644 crates/sim/tests/sideways_rapids.rs

diff --git a/crates/sim/src/verify/rapids.rs b/crates/sim/src/verify/rapids.rs
index e49c6978..93c7990b 100644
--- a/crates/sim/src/verify/rapids.rs
+++ b/crates/sim/src/verify/rapids.rs
@@ -25,6 +25,28 @@
 //! between two samples of a ring by less than the chord bulge
 //! `rho (1 - cos(pi / (2 k)))` (about `0.019 d` at the rim, the bound
 //! [`super::rapids_radial`] states), can pass.
+//!
+//! Marched (issue #140): a lateral rapid is judged along its whole
+//! length, never at its start, midpoint and end alone - a link at floor
+//! depth whose three samples all stand in cut air can still drive
+//! through a narrow uncut wall between two pockets. The footprint is
+//! read at stations every `s = d / RINGS` (the ring spacing; floored at
+//! [`MIN_STEP`] for a tool no wider than the gouge tolerance), both ends
+//! included, so the step count is `ceil(len / s)`. The bound: the
+//! footprint reaches `d` ahead of and behind each station, so the swept
+//! stations overlap and a wall across the rapid can slip between them
+//! only by being thinner than the step minus that reach - a non-positive
+//! gap here (`s <= d`); what remains is the footprint's own sampling
+//! bound above, the same at every station (stock between two samples
+//! of one footprint by less than `d / RINGS` or the chord bulge). The
+//! centre sample alone, read at the tip plane, already catches any wall
+//! crossing the centre line thicker than `s`. This reading runs with or
+//! without a model: [`Rest::hidden_along`] returns early on a 2.5-D
+//! path, the column reading never does. Cost: a `RINGS`-ring footprint
+//! (73 samples) per station; a rapid longer than [`MAX_STATIONS`]
+//! steps (about 98 m for a 6 mm tool, 2.6 m at the floor step) is not
+//! thinned to fit - it fails closed and is convicted, a refusal with a
+//! name rather than a silent pass.
 use super::laws::xy;
 use super::midpose;
 use super::probe::Cutter;
@@ -102,17 +124,19 @@ pub(super) fn rapids_in_stock(
             if low >= cx.clearance_z - cx.z_tol {
                 continue;
             }
-            let mid = Point2::new((a.x + b.x) * 0.5, (a.y + b.y) * 0.5);
             // The overhang backstop (M13.7 B, [`super::hidden`]): the
             // tool disc swept through stock hidden under a ledge, which
             // no column surface shows - asked only when the column law
             // is silent, so it adds convictions, never removes one.
             // Cut order (M13.7): the rapid meets the stock as the cuts
             // BEFORE it left it - a later feed's clearing is no alibi.
-            let bad = [a, mid, b]
-                .into_iter()
-                .flat_map(|c| footprint(c, d))
-                .any(|(q, rho)| rest.in_stock(q) && low + cutter.lift_at(rho) < rest.surface_before(q, i))
+            // Issue #140: every station along the rapid, not three.
+            let bad = stations(a, b, d).is_none_or(|mut it| {
+                it.any(|c| {
+                    footprint(c, d)
+                        .any(|(q, rho)| rest.in_stock(q) && low + cutter.lift_at(rho) < rest.surface_before(q, i))
+                })
+            })
                 || rest.hidden_along(a, b, low, cx.tool.radius - cx.gouge_tol, i);
             if !bad {
                 continue;
@@ -152,3 +176,34 @@ fn footprint(c: Point2, d: f64) -> impl Iterator<Item = (Point2, f64)> {
         })
     }))
 }
+
+/// The smallest march step, mm - a tool no wider than the gouge
+/// tolerance still marches at a finite count.
+const MIN_STEP: f64 = 0.01;
+
+/// The most stations one rapid is marched at (issue #140); past it the
+/// rapid fails closed rather than marching at a thinned step.
+const MAX_STATIONS: usize = 1 << 18;
+
+/// The footprint centres along `a -> b` every `d / RINGS` at most
+/// (see the module doc), both ends included. `None` is a rapid that
+/// cannot be marched at that step - a non-finite length or more than
+/// [`MAX_STATIONS`] steps - and the caller convicts it (fail closed).
+fn stations(a: Point2, b: Point2, d: f64) -> Option<impl Iterator<Item = Point2>> {
+    let d = if d.is_finite() && d > 0.0 { d } else { 0.0 };
+    let step = (d / RINGS as f64).max(MIN_STEP);
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let len = (dx * dx + dy * dy).sqrt();
+    if !len.is_finite() {
+        return None;
+    }
+    let n = (len / step).ceil();
+    if n > MAX_STATIONS as f64 {
+        return None;
+    }
+    let n = (n as usize).max(1);
+    Some((0..=n).map(move |k| {
+        let t = k as f64 / n as f64;
+        Point2::new(a.x + dx * t, a.y + dy * t)
+    }))
+}
diff --git a/crates/sim/tests/sideways_rapids.rs b/crates/sim/tests/sideways_rapids.rs
new file mode 100644
index 00000000..463d3509
--- /dev/null
+++ b/crates/sim/tests/sideways_rapids.rs
@@ -0,0 +1,129 @@
+//! Issue #140: law (d) judges a lateral rapid under the clearance plane
+//! along its whole length - a link at floor depth between two pockets
+//! whose start, midpoint and end all stand in cut air still drives
+//! through the uncut wall between them, and is a rapid in stock; a long
+//! link over fully cut floor stays clean.
+//!
+//! Provenance: our own fixtures, specced from the Prime Directive and the
+//! shop rule "never traverse through uncut stock"; no vendor material.
+//!
+//! Gate map (#140): covers camcraft_sim::verify (rapids, rest).
+
+use camcraft_sim::cl::{Move, MoveKind, Toolpath};
+use camcraft_sim::geo2d::{Loop, Point2, Region};
+use camcraft_sim::geometry::Point3;
+use camcraft_sim::verify::{Mode, ToolGeom, VerifyContext, Warning, verify};
+
+/// Tool radius, mm: a slot chord along x = 0 clears |x| <= R.
+const R: f64 = 3.0;
+/// The pockets' floor, under the Z 25 stock top.
+const FLOOR: f64 = 15.0;
+
+fn rect() -> Region {
+    let l = Loop::new(vec![
+        Point2::new(-40.0, -40.0),
+        Point2::new(40.0, -40.0),
+        Point2::new(40.0, 40.0),
+        Point2::new(-40.0, 40.0),
+    ]);
+    match l.and_then(|l| Region::new(vec![l])) {
+        Ok(r) => r,
+        Err(e) => panic!("rect: {e:?}"),
+    }
+}
+
+fn at(kind: MoveKind, a: (f64, f64, f64), b: (f64, f64, f64)) -> Move {
+    Move {
+        kind,
+        from: Point3::new(a.0, a.1, a.2),
+        to: Point3::new(b.0, b.1, b.2),
+        feed: if kind == MoveKind::Rapid { None } else { Some(80.0) },
+        arc: None,
+        axis: None,
+    }
+}
+
+/// A slot pocket along x = 0 whose tool centre runs y0 -> y1 at the
+/// floor: it clears y in [y0 - R, y1 + R]. Enters from above the stock
+/// top by a plunge, leaves by a retract to clearance.
+fn slot(y0: f64, y1: f64) -> Vec<Move> {
+    vec![
+        at(MoveKind::Rapid, (0.0, y0, 35.0), (0.0, y0, 26.0)),
+        at(MoveKind::Plunge, (0.0, y0, 26.0), (0.0, y0, FLOOR)),
+        at(MoveKind::Feed, (0.0, y0, FLOOR), (0.0, y1, FLOOR)),
+    ]
+}
+
+/// `pockets` (each a slot), then a feed back to (0, y_a) at the floor
+/// and the link rapid (0, y_a) -> (0, y_b) at the floor - the judged
+/// move, whose index is returned - and a retract.
+fn link_after(pockets: &[(f64, f64)], y_a: f64, y_b: f64) -> (Vec<Warning>, usize) {
+    let mut moves = Vec::new();
+    for &(y0, y1) in pockets {
+        moves.extend(slot(y0, y1));
+        moves.push(at(MoveKind::Rapid, (0.0, y1, FLOOR), (0.0, y1, 35.0)));
+    }
+    let end = pockets.last().map_or(y_a, |p| p.1);
+    moves.pop(); // the last pocket's retract: the link starts at its floor
+    moves.push(at(MoveKind::Feed, (0.0, end, FLOOR), (0.0, y_a, FLOOR)));
+    let link = moves.len();
+    moves.push(at(MoveKind::Rapid, (0.0, y_a, FLOOR), (0.0, y_b, FLOOR)));
+    moves.push(at(MoveKind::Rapid, (0.0, y_b, FLOOR), (0.0, y_b, 35.0)));
+    (judge(moves), link)
+}
+
+fn judge(moves: Vec<Move>) -> Vec<Warning> {
+    let p = Toolpath { moves, cycles: Vec::new(), notes: Vec::new(), comps: Vec::new() };
+    let region = rect();
+    let tool = ToolGeom {
+        radius: R,
+        nose_radius: 0.0,
+        flute_len: 30.0,
+        shank_radius: R,
+        shank_len: 20.0,
+        holder_radius: R,
+        holder_len: 1.0,
+    };
+    let cx = VerifyContext {
+        region: &region,
+        stock: Some(&region),
+        model: None,
+        tool: &tool,
+        cutter: None,
+        mode: Mode::Area,
+        stock_top_z: 25.0,
+        clearance_z: 35.0,
+        stock_to_leave: 0.0,
+        gouge_tol: 0.01,
+        z_tol: 1e-3,
+        finish_tol: None,
+        fixtures: &[],
+        spindle: None,
+    };
+    verify(&p, &cx)
+}
+
+#[test]
+fn a_floor_link_through_a_4mm_wall_between_two_pockets_is_a_rapid_in_stock() {
+    // The issue's scenario: pockets cut over y in [-8, 30] then
+    // [-30, -12] leave the wall y in [-12, -8]; the link (0, -20) ->
+    // (0, 20) has its start, mid and end all in cut air.
+    let (w, link) = link_after(&[(-5.0, 27.0), (-27.0, -15.0)], -20.0, 20.0);
+    assert!(w.contains(&Warning::RapidInStock { at: link }), "{w:?}");
+}
+
+#[test]
+fn a_floor_link_through_a_1mm_wall_is_a_rapid_in_stock() {
+    // The wall y in [-12, -11], thinner than the tool radius and well
+    // under the gap three samples leave.
+    let (w, link) = link_after(&[(-8.0, 27.0), (-27.0, -15.0)], -20.0, 20.0);
+    assert!(w.contains(&Warning::RapidInStock { at: link }), "{w:?}");
+}
+
+#[test]
+fn a_long_floor_link_over_a_fully_cut_slot_is_clean() {
+    // One slot clears y in [-40, 40]; the link runs 68 mm over its floor.
+    let (w, link) = link_after(&[(-37.0, 37.0)], -34.0, 34.0);
+    assert!(!w.contains(&Warning::RapidInStock { at: link }), "{w:?}");
+    assert!(w.is_empty(), "{w:?}");
+}

From ff28923e6b21704ae3024065a142a506f659785a Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 7 Nov 2026 23:24:14 +0100
Subject: [PATCH 2/2] perf(sim): skip the sideways march for a rapid at or
 above the stock top

surface_before is capped at the stock top and the tip lift is never
negative, so such a rapid can never be convicted by the march; the
common retract-height link no longer samples ~19.5k points (PR #160
review). A NaN height still marches (fails closed).

Refs #140

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/sim/src/verify/rapids.rs | 20 +++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/crates/sim/src/verify/rapids.rs b/crates/sim/src/verify/rapids.rs
index 93c7990b..bcfa32dd 100644
--- a/crates/sim/src/verify/rapids.rs
+++ b/crates/sim/src/verify/rapids.rs
@@ -131,13 +131,19 @@ pub(super) fn rapids_in_stock(
             // Cut order (M13.7): the rapid meets the stock as the cuts
             // BEFORE it left it - a later feed's clearing is no alibi.
             // Issue #140: every station along the rapid, not three.
-            let bad = stations(a, b, d).is_none_or(|mut it| {
-                it.any(|c| {
-                    footprint(c, d)
-                        .any(|(q, rho)| rest.in_stock(q) && low + cutter.lift_at(rho) < rest.surface_before(q, i))
-                })
-            })
-                || rest.hidden_along(a, b, low, cx.tool.radius - cx.gouge_tol, i);
+            // A rapid at or above the stock top cannot meet the column -
+            // `surface_before` is capped at the stock top and the lift is
+            // never negative - so the march is skipped (PR #160 review):
+            // same verdict, far fewer samples. A NaN height still marches.
+            let above = low >= cx.stock_top_z;
+            let marched = !above
+                && stations(a, b, d).is_none_or(|mut it| {
+                    it.any(|c| {
+                        footprint(c, d)
+                            .any(|(q, rho)| rest.in_stock(q) && low + cutter.lift_at(rho) < rest.surface_before(q, i))
+                    })
+                });
+            let bad = marched || rest.hidden_along(a, b, low, cx.tool.radius - cx.gouge_tol, i);
             if !bad {
                 continue;
             }
