@@ -0,0 +1,235 @@
+//! The render lattice's eikonal band re-normalization (M7.1's owed
+//! "re-normalize the band with one eikonal sweep before the render
+//! pass", M13.1, issue #22): one bounded fast-sweeping pass over the
+//! packed lattice's narrow band, so the shading gradient of the
+//! sphere-traced view reads |grad phi| ~ 1 where the BFS magnitudes and
+//! the CSG `max` of the cut layer leave it bent.
+//!
+//! Provenance: the fast sweeping method - Gauss-Seidel over the 2^d
+//! alternating sweep orders with the first-order Godunov upwind update
+//! of |grad u| = 1 (H. Zhao, "A fast sweeping method for Eikonal
+//! equations", Math. Comp. 74, 2005) - and the frozen-interface
+//! re-initialization of a level-set function near its zero set
+//! (Sussman, Smereka & Osher, J. Comput. Phys. 114, 1994; the
+//! interface-preserving variant of Russo & Smereka, JCP 163, 2000).
+//! Our own Rust over this codebase's own lattice; nothing from vendor
+//! binaries.
+//!
+//! ## The laws here
+//!
+//! - **The surface never moves.** Every texel with a 26-neighbour of
+//!   the other sign (or a zero, or a non-finite neighbour) is FROZEN:
+//!   its composed value is kept bit for bit, so every lattice edge,
+//!   face diagonal and cube diagonal that crosses the zero set keeps
+//!   both endpoint values, and the crossing a trilinear or a
+//!   marching-tetrahedra read takes from them is unchanged. Every
+//!   other band texel keeps its SIGN: the solved magnitude is at
+//!   least a frozen value plus `cell / sqrt(3)`, never zero.
+//! - **Band only, bounded.** A texel whose composed magnitude is at
+//!   or past `cap` is out of band and untouched (a no-op, by
+//!   construction - it is not even read as anything but `cap`); a
+//!   solved magnitude is clamped at `cap`, the field's own far-field
+//!   law. One cycle of the eight sweep orders, no iteration to
+//!   convergence: the cost is `8 x texels` cheap updates, stated up
+//!   front and deterministic (fixed orders, no hashing, no threads).
+//! - **The cut layer stays the cut layer.** The re-normalized composed
+//!   value `max(mesh, cut)` is written into the MESH layer and the cut
+//!   layer is left as packed: at every texel `max(new_mesh, cut)` has
+//!   the old composed sign (a negative composed value bounds `cut`
+//!   below zero too), and playback's later cut layers only lift
+//!   cells, never un-remove one - so a base re-normalized once stays
+//!   sign-exact under every frame that cuts more.
+//! - **Display only.** This is the render's lattice. The verdict paths
+//!   (`march`, `deviate_field`) read the sparse field, whose
+//!   under-reporting magnitude is the blessed pessimism; nothing here
+//!   ever reaches a verdict.
+
+use crate::stock_sim::kernel::StockError;
+
+use super::pack::FieldLattice;
+
+/// Sweep orders: every sign combination of the three axes once
+/// (Zhao's 2^d Gauss-Seidel orderings, d = 3).
+const ORDERS: [[bool; 3]; 8] = [
+    [false, false, false],
+    [true, false, false],
+    [false, true, false],
+    [true, true, false],
+    [false, false, true],
+    [true, false, true],
+    [false, true, true],
+    [true, true, true],
+];
+
+/// What one re-normalization did - the cost and the coverage, stated.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Renormalized {
+    /// Texels kept bit for bit at the zero set.
+    pub frozen: usize,
+    /// Band texels whose magnitude was re-solved.
+    pub solved: usize,
+    /// Texel updates spent (`sweeps x solved`): the bounded cost.
+    pub updates: usize,
+    /// Sweep orders run.
+    pub sweeps: u32,
+}
+
+/// Per-texel role in the sweep.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Role {
+    /// Out of band (or non-finite): never written, read as `cap`.
+    Far,
+    /// At the zero set: kept, read as its own magnitude.
+    Frozen,
+    /// In band: re-solved.
+    Band,
+}
+
+impl FieldLattice {
+    /// Re-normalize the lattice's narrow band in place with one cycle
+    /// of fast sweeping (the module laws). Refuses, unchanged, a
+    /// lattice whose layers do not match its own dimensions.
+    pub fn renormalize(&mut self) -> Result<Renormalized, StockError> {
+        let [nx, ny, nz] = self.meta.dims.map(|d| d as usize);
+        let n = nx.checked_mul(ny).and_then(|v| v.checked_mul(nz));
+        if n != Some(self.mesh.len()) || self.cut.len() != self.mesh.len() {
+            return Err(StockError::Invalid(format!(
+                "eikonal: a {nx}x{ny}x{nz} lattice cannot hold {} mesh and {} cut texels",
+                self.mesh.len(),
+                self.cut.len()
+            )));
+        }
+        let (cell, cap) = (self.meta.cell, self.meta.cap);
+        if !(cell.is_finite() && cell > 0.0 && cap.is_finite() && cap > 0.0) {
+            return Err(StockError::Invalid(format!("eikonal: cell {cell} and cap {cap} must be finite and positive")));
+        }
+        let phi: Vec<f64> = self.mesh.iter().zip(&self.cut).map(|(m, c)| f64::from(m.max(*c))).collect();
+        let (u, role, stats) = solve(&phi, [nx, ny, nz], cell, cap);
+        for i in 0..phi.len() {
+            if role[i] == Role::Band {
+                let mag = u[i].min(cap);
+                self.mesh[i] = (if phi[i] < 0.0 { -mag } else { mag }) as f32;
+            } else if role[i] == Role::Frozen {
+                // Keep the composed value: max(new, cut) == old composed.
+                self.mesh[i] = phi[i] as f32;
+            }
+        }
+        Ok(stats)
+    }
+}
+
+/// The sweep proper over a dense composed field `phi` (x fastest):
+/// magnitudes per texel, roles, and the cost spent.
+fn solve(phi: &[f64], dims: [usize; 3], cell: f64, cap: f64) -> (Vec<f64>, Vec<Role>, Renormalized) {
+    let [nx, ny, nz] = dims;
+    let idx = |x: usize, y: usize, z: usize| (z * ny + y) * nx + x;
+    let class = |v: f64| if v < 0.0 { 1u8 } else { 0u8 };
+    let mut role = vec![Role::Far; phi.len()];
+    let mut u = vec![cap; phi.len()];
+    let mut stats = Renormalized { sweeps: ORDERS.len() as u32, ..Renormalized::default() };
+    for z in 0..nz {
+        for y in 0..ny {
+            for x in 0..nx {
+                let i = idx(x, y, z);
+                let v = phi[i];
+                if !v.is_finite() {
+                    continue;
+                }
+                let mut frozen = v == 0.0;
+                'n: for dz in -1i64..=1 {
+                    for dy in -1i64..=1 {
+                        for dx in -1i64..=1 {
+                            let (a, b, c) = (x as i64 + dx, y as i64 + dy, z as i64 + dz);
+                            if frozen {
+                                break 'n;
+                            }
+                            if a < 0 || b < 0 || c < 0 || a >= nx as i64 || b >= ny as i64 || c >= nz as i64 {
+                                continue;
+                            }
+                            let w = phi[idx(a as usize, b as usize, c as usize)];
+                            frozen = !w.is_finite() || class(w) != class(v) || w == 0.0;
+                        }
+                    }
+                }
+                if frozen {
+                    role[i] = Role::Frozen;
+                    u[i] = v.abs();
+                    stats.frozen += 1;
+                } else if v.abs() < cap {
+                    role[i] = Role::Band;
+                    stats.solved += 1;
+                }
+            }
+        }
+    }
+    // Neighbour magnitude along one axis: off-lattice reads `cap`.
+    let h = cell;
+    for order in ORDERS {
+        let walk = |n: usize, rev: bool| -> Box<dyn Iterator<Item = usize>> {
+            if rev {
+                Box::new((0..n).rev())
+            } else {
+                Box::new(0..n)
+            }
+        };
+        for z in walk(nz, order[2]) {
+            for y in walk(ny, order[1]) {
+                for x in walk(nx, order[0]) {
+                    let i = idx(x, y, z);
+                    if role[i] != Role::Band {
+                        continue;
+                    }
+                    let pick = |lo: Option<usize>, hi: Option<usize>| {
+                        let r = |j: Option<usize>| j.map_or(cap, |j| u[j]);
+                        r(lo).min(r(hi))
+                    };
+                    let a = pick(x.checked_sub(1).map(|x| idx(x, y, z)), (x + 1 < nx).then(|| idx(x + 1, y, z)));
+                    let b = pick(y.checked_sub(1).map(|y| idx(x, y, z)), (y + 1 < ny).then(|| idx(x, y + 1, z)));
+                    let c = pick(z.checked_sub(1).map(|z| idx(x, y, z)), (z + 1 < nz).then(|| idx(x, y, z + 1)));
+                    let next = godunov(a, b, c, h);
+                    if next < u[i] {
+                        u[i] = next;
+                    }
+                    stats.updates += 1;
+                }
+            }
+        }
+    }
+    (u, role, stats)
+}
+
+/// Zhao's first-order Godunov update of |grad u| = 1 on a uniform
+/// grid of spacing `h`, from the smaller neighbour per axis: the
+/// largest root that stays above every neighbour it uses.
+fn godunov(a: f64, b: f64, c: f64, h: f64) -> f64 {
+    let mut s = [a, b, c];
+    s.sort_by(f64::total_cmp);
+    let [a1, a2, a3] = s;
+    let one = a1 + h;
+    if one <= a2 {
+        return one;
+    }
+    let two = 0.5 * (a1 + a2 + (2.0 * h * h - (a1 - a2) * (a1 - a2)).max(0.0).sqrt());
+    if two <= a3 {
+        return two;
+    }
+    let sum = a1 + a2 + a3;
+    let disc = sum * sum - 3.0 * (a1 * a1 + a2 * a2 + a3 * a3 - h * h);
+    (sum + disc.max(0.0).sqrt()) / 3.0
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_godunov_update_is_exact_on_planes_and_diagonals() {
+        let inf = f64::INFINITY;
+        assert!((godunov(2.0, inf, inf, 1.0) - 3.0).abs() < 1e-12, "1-D: one step on");
+        // A 45-degree plane: both neighbours at d, the point at d + h/sqrt2.
+        let two = godunov(1.0, 1.0, inf, 1.0);
+        assert!((two - (1.0 + std::f64::consts::FRAC_1_SQRT_2)).abs() < 1e-12, "{two}");
+        let three = godunov(1.0, 1.0, 1.0, 1.0);
+        assert!((three - (1.0 + 1.0 / 3f64.sqrt())).abs() < 1e-12, "{three}");
+    }
+}
diff --git a/crates/sim/tests/stock_eikonal.rs b/crates/sim/tests/stock_eikonal.rs
new file mode 100644
index 00000000..927eeb04
--- /dev/null
+++ b/crates/sim/tests/stock_eikonal.rs
@@ -0,0 +1,242 @@
+//! #22 (M7.1 / M13.1): one eikonal sweep re-normalizes the render
+//! lattice's band before the render pass. The sweep must bring the
+//! band's |grad phi| back to one after CSG-style cuts bent it, must
+//! never move the surface (every texel keeps its sign, every texel at
+//! the zero set keeps its value), must agree with the exact distance of
+//! a plain cut within a cell, and must leave out-of-band texels alone.
+//! Provenance: Zhao's fast sweeping (Math. Comp. 2005) checked against
+//! closed-form box/cylinder distances; nothing from vendor binaries.
+//!
+//! Gate map (M4.4): covers camcraft_sim::stock_sim::preview::eikonal
+//! (FieldLattice::renormalize) over pack_field.
+
+use camcraft_sim::cl::{Move, MoveKind};
+use camcraft_sim::geometry::{cube, Point3};
+use camcraft_sim::stock_sim::preview::{pack_field, FieldLattice};
+use camcraft_sim::stock_sim::{Backend, SimOp, Stock, FIELD_BAND};
+
+const CELL: f64 = 0.5;
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn feed(from: Point3, to: Point3) -> Move {
+    Move { kind: MoveKind::Feed, from, to, feed: Some(500.0), arc: None, axis: None }
+}
+
+/// The 10 x 10 x 5 box stock.
+fn box_stock() -> Stock {
+    let c = cube(p(0.0, 0.0, 0.0), p(10.0, 10.0, 5.0));
+    Stock::from_facets(Backend::Field { band: FIELD_BAND }, &c.facets, CELL).expect("box field")
+}
+
+/// A flat r-2 plunge at (5, 5) to z = 2: a cylinder pocket.
+fn pocket(stock: &mut Stock) {
+    let mv = [feed(p(5.0, 5.0, 8.0), p(5.0, 5.0, 2.0))];
+    stock.simulate(&[SimOp { moves: &mv, radius: 2.0, ball: false, cone: None, corner: None }]).expect("cut");
+}
+
+/// Composed texel value, `max(mesh, cut)`: what the march reads at a centre.
+fn composed(l: &FieldLattice) -> Vec<f32> {
+    l.mesh.iter().zip(&l.cut).map(|(m, c)| m.max(*c)).collect()
+}
+
+fn centre(l: &FieldLattice, i: usize) -> Point3 {
+    let [nx, ny, _] = l.meta.dims.map(|d| d as usize);
+    let (x, y, z) = (i % nx, (i / nx) % ny, i / (nx * ny));
+    let c = |k: usize, a: usize| (l.meta.origin[a] as f64 + k as f64 + 0.5) * l.meta.cell;
+    p(c(x, 0), c(y, 1), c(z, 2))
+}
+
+/// Mean | |grad phi| - 1 | over interior band texels (central
+/// differences, every 6-neighbour in band and of the same sign), plus
+/// the share within 0.1 of one, and the count measured.
+fn gradient_deviation(l: &FieldLattice) -> (f64, f64, usize) {
+    let v = composed(l);
+    let [nx, ny, nz] = l.meta.dims.map(|d| d as usize);
+    let (cap, h) = (l.meta.cap as f32, l.meta.cell);
+    let idx = |x: usize, y: usize, z: usize| (z * ny + y) * nx + x;
+    let (mut sum, mut good, mut n) = (0.0, 0usize, 0usize);
+    for z in 1..nz - 1 {
+        for y in 1..ny - 1 {
+            for x in 1..nx - 1 {
+                let c = v[idx(x, y, z)];
+                let nb = [
+                    v[idx(x - 1, y, z)], v[idx(x + 1, y, z)],
+                    v[idx(x, y - 1, z)], v[idx(x, y + 1, z)],
+                    v[idx(x, y, z - 1)], v[idx(x, y, z + 1)],
+                ];
+                let band = |w: f32| w.abs() < cap - 1e-3 && (w < 0.0) == (c < 0.0) && w != 0.0;
+                if !band(c) || !nb.iter().all(|w| band(*w)) {
+                    continue;
+                }
+                // Off the medial axis only: where the two one-sided
+                // differences of an axis disagree by half a slope, the
+                // texel straddles a kink and |grad| is undefined there.
+                let kink = (0..3).any(|k| {
+                    let (bk, fw) = (f64::from(c - nb[2 * k]) / h, f64::from(nb[2 * k + 1] - c) / h);
+                    (fw - bk).abs() > 0.5
+                });
+                if kink {
+                    continue;
+                }
+                let g = |a: f32, b: f32| f64::from(b - a) / (2.0 * h);
+                let m = (g(nb[0], nb[1]).powi(2) + g(nb[2], nb[3]).powi(2) + g(nb[4], nb[5]).powi(2)).sqrt();
+                sum += (m - 1.0).abs();
+                good += usize::from((m - 1.0).abs() < 0.1);
+                n += 1;
+            }
+        }
+    }
+    (sum / n.max(1) as f64, good as f64 / n.max(1) as f64, n)
+}
+
+/// A box cut by three overlapping sweeps: a cylinder pocket, a ball
+/// slot across it and a flat slot along the other side - the max of
+/// several SDFs, the composition that bends the band.
+fn csg_lattice() -> FieldLattice {
+    let mut s = box_stock();
+    pocket(&mut s);
+    let slot = [feed(p(1.0, 5.0, 3.5), p(9.0, 5.0, 3.5))];
+    let side = [feed(p(2.0, 1.5, 4.0), p(2.0, 8.5, 2.5))];
+    s.simulate(&[
+        SimOp { moves: &slot, radius: 1.5, ball: true, cone: None, corner: None },
+        SimOp { moves: &side, radius: 1.0, ball: false, cone: None, corner: None },
+    ])
+    .expect("cuts");
+    pack_field(s.field().expect("field arm")).expect("packs")
+}
+
+#[test]
+fn csg_cuts_bend_the_band_and_one_sweep_straightens_it() {
+    let mut l = csg_lattice();
+    let (before, good_before, n0) = gradient_deviation(&l);
+    let stats = l.renormalize().expect("sweep");
+    let (after, good_after, n1) = gradient_deviation(&l);
+    eprintln!("deviation {before:.3} -> {after:.3}; within 0.1: {good_before:.2} -> {good_after:.2}; texels {n0} -> {n1}; {stats:?}");
+    assert!(n1 > 1000, "the band is measured over real texels: {n1}");
+    assert!(after < 0.08, "mean | |grad| - 1 | after the sweep: {after}");
+    assert!(after < 0.5 * before, "the sweep must at least halve the deviation: {before} -> {after}");
+    assert!(good_after > 0.75 && good_before < 0.1, "most band texels read a unit gradient: {good_before} -> {good_after}");
+    assert_eq!(stats.updates, stats.solved * 8, "one cycle of eight orders, bounded: {stats:?}");
+}
+
+#[test]
+fn the_surface_never_moves() {
+    let mut l = csg_lattice();
+    let old = composed(&l);
+    let stats = l.renormalize().expect("sweep");
+    let new = composed(&l);
+    let [nx, ny, nz] = l.meta.dims.map(|d| d as usize);
+    let idx = |x: usize, y: usize, z: usize| (z * ny + y) * nx + x;
+    for (i, (a, b)) in old.iter().zip(&new).enumerate() {
+        assert_eq!(*a < 0.0, *b < 0.0, "texel {i} at {:?} flipped sign: {a} -> {b}", centre(&l, i));
+    }
+    // Every lattice edge that crosses the zero set keeps both values,
+    // so the crossing a trilinear or an iso extraction reads is equal.
+    let mut crossings = 0;
+    for z in 0..nz {
+        for y in 0..ny {
+            for x in 0..nx {
+                let i = idx(x, y, z);
+                for j in [(x + 1 < nx).then(|| idx(x + 1, y, z)), (y + 1 < ny).then(|| idx(x, y + 1, z)), (z + 1 < nz).then(|| idx(x, y, z + 1))]
+                    .into_iter()
+                    .flatten()
+                {
+                    if (old[i] < 0.0) != (old[j] < 0.0) {
+                        crossings += 1;
+                        assert_eq!(old[i].to_bits(), new[i].to_bits(), "zero-set texel {i} moved");
+                        assert_eq!(old[j].to_bits(), new[j].to_bits(), "zero-set texel {j} moved");
+                    }
+                }
+            }
+        }
+    }
+    assert!(crossings > 500 && stats.frozen > 0, "the cut box has a surface: {crossings} {stats:?}");
+}
+
+#[test]
+fn out_of_band_texels_are_untouched_and_the_sweep_is_deterministic() {
+    let mut l = csg_lattice();
+    let (mesh0, cut0) = (l.mesh.clone(), l.cut.clone());
+    let cap = l.meta.cap as f32;
+    l.renormalize().expect("sweep");
+    assert_eq!(l.cut, cut0, "the cut layer stays as packed");
+    let old = mesh0.iter().zip(&cut0).map(|(m, c)| m.max(*c));
+    for (i, (o, (m0, m1))) in old.zip(mesh0.iter().zip(&l.mesh)).enumerate() {
+        if o.abs() >= cap {
+            assert_eq!(m0.to_bits(), m1.to_bits(), "out-of-band texel {i} was written");
+        }
+        assert!(m1.abs() <= cap, "texel {i} past cap: {m1}");
+    }
+    let mut again = csg_lattice();
+    again.renormalize().expect("sweep");
+    assert_eq!(again.mesh, l.mesh, "same input, same bits");
+}
+
+#[test]
+fn a_cylinder_pocket_reads_its_exact_distance_within_a_cell() {
+    let mut s = box_stock();
+    pocket(&mut s);
+    let mut l = pack_field(s.field().expect("field arm")).expect("packs");
+    l.renormalize().expect("sweep");
+    let v = composed(&l);
+    let (cap, cell) = (l.meta.cap, l.meta.cell);
+    let (mut worst, mut n) = (0.0f64, 0usize);
+    for (i, d) in v.iter().enumerate() {
+        let q = centre(&l, i);
+        let r = ((q.x - 5.0).powi(2) + (q.y - 5.0).powi(2)).sqrt();
+        let in_box = (0.0..=10.0).contains(&q.x) && (0.0..=10.0).contains(&q.y) && (0.0..=5.0).contains(&q.z);
+        // Closed forms: material inside the box (distance to the box's
+        // faces or to the half-infinite r-2 cylinder above z = 2), and
+        // pocket air below the top (the wall or the floor).
+        let exact = if !in_box {
+            continue;
+        } else if r < 2.0 && q.z > 2.0 {
+            (2.0 - r).min(q.z - 2.0)
+        } else {
+            let faces = q.x.min(10.0 - q.x).min(q.y).min(10.0 - q.y).min(q.z).min(5.0 - q.z);
+            let cyl = ((r - 2.0).max(0.0).powi(2) + (2.0 - q.z).max(0.0).powi(2)).sqrt();
+            -faces.min(cyl)
+        };
+        if exact.abs() > cap - 2.0 * cell {
+            continue; // the cap clamp is the field's law, not the sweep's
+        }
+        worst = worst.max((f64::from(*d) - exact).abs());
+        n += 1;
+    }
+    eprintln!("cylinder pocket: worst {worst:.3} over {n} texels (cell {cell})");
+    assert!(n > 1000, "measured over the band: {n}");
+    assert!(worst <= cell, "within one cell of the exact distance: {worst}");
+}
