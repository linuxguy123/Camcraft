From 92ebbc3f2e49c2f66c046aae07000ef3a11fa2d4 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sun, 8 Nov 2026 12:59:23 -0800
Subject: [PATCH] test(probe): stop pinning the project version in the probe's
 kind-order test

every_older_kind_keeps_its_stored_id_and_digest_tag asserted
PROJECT_VERSION == 51, so #329's v52 rung left it red on main. The kind
id / digest-tag loop is what proves the Probe kind needed no format rung;
the hard-coded version proved nothing about the probe and goes stale on
every unrelated rung. The loop stays as the pin.

Fixes #344

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/probe_op.rs            |  5 +++--
 docs/decisions/344-probe-version-pin.md | 16 ++++++++++++++++
 2 files changed, 19 insertions(+), 2 deletions(-)
 create mode 100644 docs/decisions/344-probe-version-pin.md

diff --git a/crates/app/tests/probe_op.rs b/crates/app/tests/probe_op.rs
index 8532c5d1..61a6a039 100644
--- a/crates/app/tests/probe_op.rs
+++ b/crates/app/tests/probe_op.rs
@@ -352,8 +352,9 @@ fn every_older_kind_keeps_its_stored_id_and_digest_tag() {
         assert_eq!(KindInfo::ALL[i].ty, *ty, "id {i} moved");
         assert_eq!(usize::from(ty.info().tag), i, "{ty:?}'s digest tag moved");
     }
-    // v51 is #196's setup work-offset rung, not the probe's.
-    assert_eq!(project::PROJECT_VERSION, 51, "the probe arrives without a format rung");
+    // No PROJECT_VERSION pin here (#344): the loop above is what proves
+    // the probe needed no format rung, and a hard-coded version number
+    // went stale on every unrelated rung (#196's v51, #329's v52).
 }
 
 /// The posted Z of every G31 for a probe whose length register is
diff --git a/docs/decisions/344-probe-version-pin.md b/docs/decisions/344-probe-version-pin.md
new file mode 100644
index 00000000..c76f15f6
--- /dev/null
+++ b/docs/decisions/344-probe-version-pin.md
@@ -0,0 +1,16 @@
+## #344 - probe_op stops pinning the project version
+
+**Decided:** `every_older_kind_keeps_its_stored_id_and_digest_tag` drops its
+`assert_eq!(project::PROJECT_VERSION, 51, ..)` line and keeps the kind
+id / digest-tag loop as its pin.
+
+**Why:** the loop is what proves adding the Probe kind needed no format
+rung (every older kind keeps its stored id and tag, so an older file loads
+with no op going Stale). The hard-coded version proves nothing about the
+probe and went red on every unrelated rung - #196 moved it to 51, #329's
+v52 left it red on main, #326's v53 would again.
+
+**Considered and dropped:** updating the number to 52 (stale again at the
+next rung); asserting `>= 51` (still says nothing about the probe).
+
+**Cost to change:** none - a test-only line.
