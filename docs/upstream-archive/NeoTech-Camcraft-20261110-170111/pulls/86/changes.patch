+/// An axis with no XY part sweeps a disk of radius `w`.
+fn slab_approach(a: Point3, b: Point3, axis: [f64; 3], w: f64) -> f64 {
+    let l = axis[0].hypot(axis[1]);
+    if l.is_nan() || l <= 1e-9 {
+        return (approach(a, b) - w).max(0.0);
