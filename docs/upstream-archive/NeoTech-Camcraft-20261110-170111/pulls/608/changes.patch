From 849ff88c5823311ca3321d105a4627f132eee2c5 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mikekinney@Mikes-MacBook-Pro.local>
Date: Mon, 9 Nov 2026 17:07:37 -0800
Subject: [PATCH] test(ui): structural tests no longer race on the live theme
 table

The live theme (`theme::current()`, the process-wide `LIVE` cell in
theme.rs) is one table per test binary. The structural/snapshot tests
serialise on SNAPSHOT_LOCK, but `the_theme_door_switches_the_theme_and_
undo_restores_it` drives the real pick -> frame-edge sync path
(light, undo, redo, undo) without the lock, so a parallel run flipped
the table under shell_structure_light ("frame-edge sync rode the
world's reference") or shell_structure_dark (the dark-table assert).

Choice: serialise, not per-State. The table is process-wide by design
(one UI per process; ~44 read sites call `theme::current()` with no
State or Context in hand), so threading it per-harness would be a large
production change for a test-only race. The theme-door test now takes
the same snapshot_guard; the lock's doc names the rule for any future
test whose frames move the world's theme. No product behaviour change.

Fixes #605

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAgjpiZbXSvmXLvdmL
---
 crates/ui/src/egui_app/tests.rs            | 2 ++
 crates/ui/src/egui_app/tests/theme_door.rs | 5 +++++
 2 files changed, 7 insertions(+)

diff --git a/crates/ui/src/egui_app/tests.rs b/crates/ui/src/egui_app/tests.rs
index 0e99f2d5..ca15d0c1 100644
--- a/crates/ui/src/egui_app/tests.rs
+++ b/crates/ui/src/egui_app/tests.rs
@@ -1736,6 +1736,8 @@ fn egui_shell_snapshot() {
 /// The dark snapshot tests (and their structural twins) read that same
 /// table through their frames, so all of them share this lock - without it a parallel dark frame
 /// could catch the light table and fail its own golden, and vice versa.
+/// Any other test whose frames move the world's theme (the Theme door's
+/// switch, #605) writes that table too and must take this lock as well.
 static SNAPSHOT_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
 
 fn snapshot_guard() -> std::sync::MutexGuard<'static, ()> {
diff --git a/crates/ui/src/egui_app/tests/theme_door.rs b/crates/ui/src/egui_app/tests/theme_door.rs
index 1f50e6a3..73a7d9e6 100644
--- a/crates/ui/src/egui_app/tests/theme_door.rs
+++ b/crates/ui/src/egui_app/tests/theme_door.rs
@@ -52,6 +52,11 @@ fn the_theme_door_sits_right_of_panels() {
 
 #[test]
 fn the_theme_door_switches_the_theme_and_undo_restores_it() {
+    // #605: the pick lands through the frame-edge sync, which writes the
+    // ONE process-wide live table (`theme::current()`); the structural
+    // and snapshot tests assert on that table, so this test shares their
+    // lock or a parallel run flips their look mid-frame.
+    let _g = snapshot_guard();
     let mut harness = shell_harness();
     harness.run();
     assert_eq!(theme_of(&harness.state().state.world), ThemeRef::Dark);
