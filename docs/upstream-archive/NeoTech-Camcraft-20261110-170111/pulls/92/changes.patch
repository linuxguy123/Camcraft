From 60a752c2e1f97e9bd66c1ae10c166da2a89e9b04 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 7 Nov 2026 17:17:04 +0100
Subject: [PATCH 1/2] ci(release): the GitHub release page shows only this
 version's notes

RELEASE_NOTES.md keeps every release (newest first, sections separated
by '---'); the release body is now its first section, written to
dist/release-body.md, instead of the whole file.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/release.yml | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index b869fef6..b1fb2b40 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -104,6 +104,20 @@ jobs:
         with:
           name: installer
           path: dist/*-setup.exe
+      # The release page shows only this version's notes: RELEASE_NOTES.md
+      # keeps every release, newest first, separated by a line "---"; the
+      # body is its first section (user, 2026-11-07: "just what is in that
+      # specific release").
+      - name: Release notes for this version only
+        if: startsWith(github.ref, 'refs/tags/')
+        shell: pwsh
+        run: |
+          $lines = Get-Content RELEASE_NOTES.md
+          $end = [Array]::IndexOf($lines, '---')
+          if ($end -lt 0) { $end = $lines.Count }
+          if ($end -eq 0) { throw "RELEASE_NOTES.md starts with '---': no notes for this version" }
+          $lines[0..($end - 1)] | Set-Content -Encoding utf8 dist/release-body.md
+          Get-Content dist/release-body.md
       - name: Publish GitHub Release
         if: startsWith(github.ref, 'refs/tags/')
         uses: softprops/action-gh-release@v2
@@ -111,5 +125,5 @@ jobs:
           files: |
             dist/*.zip
             dist/*-setup.exe
-          body_path: RELEASE_NOTES.md
+          body_path: dist/release-body.md
           fail_on_unmatched_files: true

From 562b0a1ab908aa7ffb3ba2e7beec21d3350cf910 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 7 Nov 2026 17:20:40 +0100
Subject: [PATCH 2/2] ci(release): review fixes - strict separator match, fail
 when missing, the first section must name the tag's version

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/release.yml | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index b1fb2b40..b35449f6 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -112,10 +112,14 @@ jobs:
         if: startsWith(github.ref, 'refs/tags/')
         shell: pwsh
         run: |
-          $lines = Get-Content RELEASE_NOTES.md
+          $lines = @(Get-Content RELEASE_NOTES.md | ForEach-Object { $_.TrimEnd() })
           $end = [Array]::IndexOf($lines, '---')
-          if ($end -lt 0) { $end = $lines.Count }
+          if ($end -lt 0) { throw "RELEASE_NOTES.md has no '---' line: cannot tell this version's notes from the history" }
           if ($end -eq 0) { throw "RELEASE_NOTES.md starts with '---': no notes for this version" }
+          $head = $lines[0].TrimStart([char]0xFEFF)
+          if ($head -notmatch [regex]::Escape($env:CAMCRAFT_VERSION)) {
+            throw "RELEASE_NOTES.md's first section is '$head', not $env:CAMCRAFT_VERSION - update the notes before tagging"
+          }
           $lines[0..($end - 1)] | Set-Content -Encoding utf8 dist/release-body.md
           Get-Content dist/release-body.md
       - name: Publish GitHub Release
