From 20911d68c4481d7338618288e640f4fea4de113e Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 8 Nov 2026 16:38:23 +0100
Subject: [PATCH 4/5] fix(ui): the Debug info door stays on the strip under a
 long status line

With main's status line (#232's body-ink label, a long generate summary)
the left-to-right label pushed the right-hand widgets - the Debug info
glyph and the faint shell label - off the strip. The right-hand widgets
are now laid out first and the status line takes the remaining width,
truncated, keeping its hover text and "Copy message". The glyph is
tinted with the body ink so it reads on the light theme (it is white at
load, as the ribbon's glyphs are).

Refs #157

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/debug_info.rs | 10 +++++++---
 crates/ui/src/egui_app/panes.rs      | 22 ++++++++++++++--------
 2 files changed, 21 insertions(+), 11 deletions(-)

diff --git a/crates/ui/src/egui_app/debug_info.rs b/crates/ui/src/egui_app/debug_info.rs
index 686d4cd3..e9cbaed0 100644
--- a/crates/ui/src/egui_app/debug_info.rs
+++ b/crates/ui/src/egui_app/debug_info.rs
@@ -17,9 +17,13 @@ use crate::state::State;
 /// set is up, the words when it is not. Both answer to "Debug info".
 pub(super) fn button(ui: &mut Ui, icons: Option<&IconSet>) -> Response {
     let resp = match icons.and_then(|s| s.texture(Icon::DebugInfo)) {
-        Some(tex) => ui
-            .add(Button::image(Image::new(tex).fit_to_exact_size(Vec2::splat(16.0))).frame(false))
-            .on_hover_text("Debug info"),
+        // The glyph is white at load; tint it with the body ink (as the
+        // ribbon cells do) so it reads on the light theme too.
+        Some(tex) => {
+            let ink = ui.visuals().text_color();
+            let glyph = Image::new(tex).fit_to_exact_size(Vec2::splat(16.0)).tint(ink);
+            ui.add(Button::image(glyph).frame(false)).on_hover_text("Debug info")
+        }
         None => ui.small_button("Debug info"),
     };
     resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, "Debug info"));
diff --git a/crates/ui/src/egui_app/panes.rs b/crates/ui/src/egui_app/panes.rs
index ff312aa6..2933753a 100644
--- a/crates/ui/src/egui_app/panes.rs
+++ b/crates/ui/src/egui_app/panes.rs
@@ -1352,14 +1352,10 @@ pub fn status(ui: &mut Ui, state: &mut State, pal: &Tokens, icons: Option<&IconS
         RichText::new(text.as_str()).color(ui.visuals().text_color())
     };
     ui.horizontal(|ui| {
-        ui.add(Label::new(line).selectable(true))
-            .on_hover_text(text.as_str())
-            .context_menu(|ui| {
-                if ui.button("Copy message").clicked() {
-                    ui.ctx().copy_text(text.clone());
-                    ui.close();
-                }
-            });
+        // The right-hand widgets are laid out first so a long status line
+        // can never push them off the strip (#157: the Debug info door
+        // must stay reachable); the line takes what is left, truncated,
+        // with the full text on hover and in "Copy message".
         ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
             // #157: the Debug info door, rightmost - the glyph when the
             // icon set is up, its name when it is not (headless frames
@@ -1378,6 +1374,16 @@ pub fn status(ui: &mut Ui, state: &mut State, pal: &Tokens, icons: Option<&IconS
                     state.pending.push_back(CommandKind::RegenerateAll);
                 }
             }
+            ui.with_layout(egui::Layout::left_to_right(egui::Align::Center), |ui| {
+                ui.add(Label::new(line).selectable(true).truncate())
+                    .on_hover_text(text.as_str())
+                    .context_menu(|ui| {
+                        if ui.button("Copy message").clicked() {
+                            ui.ctx().copy_text(text.clone());
+                            ui.close();
+                        }
+                    });
+            });
         });
     });
     ui.allocate_rect(rect, Sense::hover());

