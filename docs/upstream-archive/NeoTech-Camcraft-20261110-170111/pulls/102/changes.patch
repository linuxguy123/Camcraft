From 658c76765b5fe2154dd6f5a73fe13dc33a7bd73d Mon Sep 17 00:00:00 2001
From: linuxguy123 <linuxguy123@gmail.com>
Date: Sat, 7 Nov 2026 11:59:13 -0600
Subject: [PATCH 1/2] Preserve executable startup code in AppImage package

Refs #72
---
 .github/workflows/release.yml |  1 +
 RECOMMENDED.md                |  5 ++++
 scripts/package-appimage.sh   | 50 +++++++++++++++++++++++++----------
 3 files changed, 42 insertions(+), 14 deletions(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index b5bc1408..9d16c230 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -54,6 +54,7 @@ jobs:
           dpkg-deb --contents dist/*.deb | grep '/usr/lib/camcraft/camcraft-ui$'
           rpm -qpl dist/*.rpm | grep '/usr/lib/camcraft/camcraft-ui$'
           test -s dist/*.AppImage
+          APPIMAGE_EXTRACT_AND_RUN=1 dist/*.AppImage --headless
       - uses: actions/upload-artifact@v4
         with:
           name: linux-packages
diff --git a/RECOMMENDED.md b/RECOMMENDED.md
index 85930a31..c6f8218d 100644
--- a/RECOMMENDED.md
+++ b/RECOMMENDED.md
@@ -12882,3 +12882,8 @@ keeps the part-only chain bit for bit.
   GPU, and project-file access. Both are downloadable release files; store
   publication and runtime validation still require a successful runner build
   and desktop hand test.
+- The first AppImage crashed before `main`: linuxdeploy rewrote the executable
+  and replaced its `.init` instructions with ELF header data. Assemble the
+  AppDir directly and use the appimagetool already bundled in the pinned
+  linuxdeploy download. The release job now runs the finished AppImage in
+  headless mode so a packaged startup crash fails the build.
diff --git a/scripts/package-appimage.sh b/scripts/package-appimage.sh
index e355c021..5e03083a 100755
--- a/scripts/package-appimage.sh
+++ b/scripts/package-appimage.sh
@@ -36,11 +36,15 @@ dist=$(cd "$dist" && pwd)
 work=$(mktemp -d "$dist/.package-appimage.XXXXXX")
 trap 'rm -rf "$work"' EXIT
 appdir="$work/CamCraft.AppDir"
-mkdir -p "$appdir/usr/bin/assets"
+mkdir -p "$appdir/usr/bin/assets" "$appdir/usr/share/applications" \
+    "$appdir/usr/share/icons/hicolor/256x256/apps"
+for binary in camcraft-ui camcraft-cli post; do
+    install -m 755 "$bin_dir/$binary" "$appdir/usr/bin/$binary"
+done
 for asset in posts machines ui scripts themes; do
     cp -a "assets/$asset" "$appdir/usr/bin/assets/$asset"
 done
-cat > "$work/camcraft.desktop" <<'EOF'
+cat > "$appdir/usr/share/applications/camcraft.desktop" <<'EOF'
 [Desktop Entry]
 Type=Application
 Name=CamCraft
@@ -50,17 +54,35 @@ Icon=camcraft
 Terminal=false
 Categories=Graphics;Engineering;
 EOF
-convert assets/ui/cube.png -resize 256x256 "$work/camcraft.png"
-APPIMAGE_EXTRACT_AND_RUN=1 \
-LDAI_NO_APPSTREAM=1 \
-LDAI_OUTPUT="$dist/camcraft-$version-linux-x86_64.AppImage" \
-LINUXDEPLOY_OUTPUT_VERSION="$version" \
-    "$linuxdeploy" --appdir "$appdir" \
-    --executable "$bin_dir/camcraft-ui" \
-    --executable "$bin_dir/camcraft-cli" \
-    --executable "$bin_dir/post" \
-    --desktop-file "$work/camcraft.desktop" \
-    --icon-file "$work/camcraft.png" \
-    --output appimage
+convert assets/ui/cube.png -resize 256x256 \
+    "$appdir/usr/share/icons/hicolor/256x256/apps/camcraft.png"
+ln -s usr/share/applications/camcraft.desktop "$appdir/camcraft.desktop"
+ln -s usr/share/icons/hicolor/256x256/apps/camcraft.png "$appdir/camcraft.png"
+cat > "$appdir/AppRun" <<'EOF'
+#!/bin/sh
+appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+exec "$appdir/usr/bin/camcraft-ui" "$@"
+EOF
+chmod 755 "$appdir/AppRun"
+# linuxdeploy rewrites ELF headers even for binaries already in the AppDir.
+# That overwrites .init in CamCraft and crashes before main on Fedora. Use
+# the appimagetool bundled in our pinned linuxdeploy download directly.
+before=$(sha256sum "$appdir/usr/bin/camcraft-ui" | awk '{print $1}')
+(
+    cd "$work"
+    "$linuxdeploy" --appimage-extract >/dev/null
+)
+appimagetool="$work/squashfs-root/plugins/linuxdeploy-plugin-appimage/usr/bin/appimagetool"
+if [[ ! -x $appimagetool ]]; then
+    echo "package-appimage: pinned linuxdeploy has no bundled appimagetool" >&2
+    exit 1
+fi
+ARCH=x86_64 "$appimagetool" "$appdir" \
+    "$dist/camcraft-$version-linux-x86_64.AppImage" --no-appstream
+after=$(sha256sum "$appdir/usr/bin/camcraft-ui" | awk '{print $1}')
+if [[ $before != "$after" ]]; then
+    echo "package-appimage: appimagetool modified camcraft-ui; refusing broken image" >&2
+    exit 1
+fi
 test -s "$dist/camcraft-$version-linux-x86_64.AppImage"
 echo "AppImage: $dist/camcraft-$version-linux-x86_64.AppImage"

From bfe174670603c9c02242e642b29165f102789e39 Mon Sep 17 00:00:00 2001
From: linuxguy123 <linuxguy123@gmail.com>
Date: Sat, 7 Nov 2026 12:17:09 -0600
Subject: [PATCH 2/2] Verify AppImage binary without a CI graphics adapter

Refs #72
---
 .github/workflows/release.yml | 8 +++++++-
 RECOMMENDED.md                | 6 ++++--
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 9d16c230..49617358 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -54,7 +54,13 @@ jobs:
           dpkg-deb --contents dist/*.deb | grep '/usr/lib/camcraft/camcraft-ui$'
           rpm -qpl dist/*.rpm | grep '/usr/lib/camcraft/camcraft-ui$'
           test -s dist/*.AppImage
-          APPIMAGE_EXTRACT_AND_RUN=1 dist/*.AppImage --headless
+          # This runner has no GPU adapter, so compare the packaged ELF to
+          # the binary we just built. This catches linuxdeploy's .init damage.
+          appimage_check=$(mktemp -d "$RUNNER_TEMP/camcraft-appimage.XXXXXX")
+          (cd "$appimage_check" && "$GITHUB_WORKSPACE"/dist/*.AppImage --appimage-extract)
+          cmp target/release/camcraft-ui "$appimage_check/squashfs-root/usr/bin/camcraft-ui"
+          test -x "$appimage_check/squashfs-root/AppRun"
+          test -d "$appimage_check/squashfs-root/usr/bin/assets/themes"
       - uses: actions/upload-artifact@v4
         with:
           name: linux-packages
diff --git a/RECOMMENDED.md b/RECOMMENDED.md
index c6f8218d..d06f0d0e 100644
--- a/RECOMMENDED.md
+++ b/RECOMMENDED.md
@@ -12885,5 +12885,7 @@ keeps the part-only chain bit for bit.
 - The first AppImage crashed before `main`: linuxdeploy rewrote the executable
   and replaced its `.init` instructions with ELF header data. Assemble the
   AppDir directly and use the appimagetool already bundled in the pinned
-  linuxdeploy download. The release job now runs the finished AppImage in
-  headless mode so a packaged startup crash fails the build.
+  linuxdeploy download. The release job extracts the finished AppImage and
+  compares its ELF to the built binary byte for byte. The Ubuntu runner has
+  no graphics adapter for a headless launch; the desktop run was checked on
+  Fedora.
