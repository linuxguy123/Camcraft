diff --git a/crates/ui/src/egui_app/gpu_init.rs b/crates/ui/src/egui_app/gpu_init.rs
new file mode 100644
index 00000000..1f991c34
--- /dev/null
+++ b/crates/ui/src/egui_app/gpu_init.rs
@@ -0,0 +1,127 @@
+// Windowed GPU bring-up (#74): enumerate every adapter, log each, and try
+// them adapter-by-adapter (gpu_select::order) inside the backend fallback
+// chain (gpu::attempts) until one gives a device AND a configured surface.
+// Provenance: our own code, specced from the wgpu 30 public API docs
+// (Instance::enumerate_adapters, RequestAdapterOptions::power_preference,
+// Adapter::request_device, Surface::get_capabilities/configure,
+// Device::push_error_scope) - no vendor reference consulted.
+
+use std::collections::HashSet;
+use std::sync::Arc;
+
+use egui_wgpu::wgpu;
+use winit::window::Window;
+
+use super::gpu;
+use super::gpu_select::{self, AdapterDesc};
+
+/// What a successful bring-up hands the shell.
+pub struct Bring {
+    pub surface: wgpu::Surface<'static>,
+    pub adapter: wgpu::Adapter,
+    pub device: wgpu::Device,
+    pub queue: wgpu::Queue,
+    pub config: wgpu::SurfaceConfiguration,
+}
+
+/// Bring the window's GPU up, or refuse naming every adapter tried and
+/// why each failed. `want` is the `--gpu` / `CAMCRAFT_GPU` substring.
+pub fn bring_up(window: &Arc<Window>, pick: &gpu::GpuPick, want: Option<&str>) -> Result<Bring, String> {
+    let size = window.inner_size();
+    let mut seen: HashSet<(String, u32, u32, &'static str)> = HashSet::new();
+    let mut tried: HashSet<(String, u32, u32, &'static str)> = HashSet::new();
+    let mut failures: Vec<String> = Vec::new();
+    for (label, backends) in gpu::attempts(pick) {
+        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+            backends,
+            ..wgpu::InstanceDescriptor::new_without_display_handle()
+        });
+        // SAFETY: the shell keeps `window` alive in its own field and drops
+        // the surface first (its field-order note); the handle stays valid.
+        let target = unsafe { wgpu::SurfaceTargetUnsafe::from_display_and_window(window, window) }
+            .map_err(|e| format!("surface handle: {e}"))?;
+        // SAFETY: same argument - the window outlives the surface.
+        let surface = match unsafe { instance.create_surface_unsafe(target) } {
+            Ok(s) => s,
+            Err(err) => {
+                eprintln!("gpu: {label}: surface creation failed ({err}) - falling back");
+                failures.push(format!("{label}: surface creation failed ({err})"));
+                continue;
+            }
+        };
+        let adapters = pollster::block_on(instance.enumerate_adapters(backends));
+        let descs: Vec<AdapterDesc> = adapters
+            .iter()
+            .map(|a| AdapterDesc::from_info(&a.get_info(), a.is_surface_supported(&surface)))
+            .collect();
+        for d in &descs {
+            if seen.insert(d.key()) {
+                println!("{}", d.log_line());
+            }
+        }
+        if descs.is_empty() {
+            eprintln!("gpu: {label}: no adapters enumerated - falling back");
+        }
+        let hp = pollster::block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
+            power_preference: wgpu::PowerPreference::HighPerformance,
+            compatible_surface: Some(&surface),
+            ..Default::default()
+        }))
+        .ok()
+        .map(|a| AdapterDesc::from_info(&a.get_info(), true));
+        let (order, notes) = gpu_select::order(&descs, want, hp.as_ref());
+        for n in notes {
+            println!("gpu: {label}: {n}");
+        }
+        for i in order {
+            let (Some(adapter), Some(desc)) = (adapters.get(i), descs.get(i)) else { continue };
+            if !tried.insert(desc.key()) {
+                continue; // already failed under an earlier mask
+            }
+            let who = format!("\"{}\" via {}", desc.name, gpu::backend_name(desc.backend));
+            match try_adapter(&surface, adapter, size.width, size.height) {
+                Ok((device, queue, config)) => {
+                    println!(
+                        "gpu: using {who} ({}; {:?} {:?} {:?})",
+                        gpu_select::type_name(desc.device_type),
+                        config.format,
+                        config.present_mode,
+                        config.alpha_mode
+                    );
+                    return Ok(Bring { surface, adapter: adapter.clone(), device, queue, config });
+                }
+                Err(why) => {
+                    eprintln!("gpu: {who} failed: {why} - trying the next adapter");
+                    failures.push(format!("{who}: {why}"));
+                }
+            }
+        }
+    }
+    if failures.is_empty() {
+        failures.push("no GPU adapter was found on any backend".into());
+    }
+    Err(format!("no GPU adapter could render to this window; tried: {}", failures.join("; ")))
+}
+
+/// One candidate: device, capability-driven config, and a configure that
+/// is checked (validation scope + unwind guard) instead of assumed.
+fn try_adapter(
+    surface: &wgpu::Surface<'static>,
+    adapter: &wgpu::Adapter,
+    w: u32,
+    h: u32,
+) -> Result<(wgpu::Device, wgpu::Queue, wgpu::SurfaceConfiguration), String> {
+    let (device, queue) = pollster::block_on(adapter.request_device(&wgpu::DeviceDescriptor::default()))
+        .map_err(|e| format!("device request refused ({e})"))?;
+    let config = gpu_select::surface_config(&surface.get_capabilities(adapter), w, h)?;
+    let scope = device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let configured = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| surface.configure(&device, &config)));
+    let err = pollster::block_on(scope.pop());
+    if configured.is_err() {
+        return Err(format!("surface configure aborted ({:?}, {:?})", config.format, config.present_mode));
+    }
+    if let Some(e) = err {
+        return Err(format!("surface configure refused ({e})"));
+    }
+    Ok((device, queue, config))
+}
diff --git a/crates/ui/src/egui_app/gpu_select.rs b/crates/ui/src/egui_app/gpu_select.rs
new file mode 100644
index 00000000..1ed3bd87
--- /dev/null
+++ b/crates/ui/src/egui_app/gpu_select.rs
@@ -0,0 +1,182 @@
+// Adapter ordering and surface configuration for the viewport (#74).
+// Provenance: our own design, specced from the wgpu 30 public API docs
+// (Instance::enumerate_adapters, Adapter::get_info / is_surface_supported,
+// RequestAdapterOptions::power_preference, Surface::get_capabilities and
+// SurfaceCapabilities) - no vendor reference consulted.
+//
+// Pure functions over plain descriptors, so the hybrid-laptop ordering is
+// testable without the hardware: shell init feeds it what wgpu reported.
+
+use egui_wgpu::wgpu;
+
+/// What wgpu told us about one enumerated adapter.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AdapterDesc {
+    pub name: String,
+    pub vendor: u32,
+    pub device: u32,
+    pub device_type: wgpu::DeviceType,
+    pub backend: wgpu::Backend,
+    /// `Adapter::is_surface_supported` for the window's surface.
+    pub surface_ok: bool,
+}
+
+impl AdapterDesc {
+    pub fn from_info(info: &wgpu::AdapterInfo, surface_ok: bool) -> Self {
+        AdapterDesc {
+            name: info.name.clone(),
+            vendor: info.vendor,
+            device: info.device,
+            device_type: info.device_type,
+            backend: info.backend,
+            surface_ok,
+        }
+    }
+
+    /// One startup log line per adapter seen.
+    pub fn log_line(&self) -> String {
+        format!(
+            "gpu: seen \"{}\" vendor 0x{:04x} device 0x{:04x} {} via {}{}",
+            self.name,
+            self.vendor,
+            self.device,
+            type_name(self.device_type),
+            super::gpu::backend_name(self.backend),
+            if self.surface_ok { "" } else { " (cannot present to this window)" }
+        )
+    }
+
+    /// The same physical GPU (any backend): vendor + device + name.
+    fn same_gpu(&self, other: &AdapterDesc) -> bool {
+        self.vendor == other.vendor && self.device == other.device && self.name == other.name
+    }
+
+    /// Identity across instances (the fallback masks re-enumerate).
+    pub fn key(&self) -> (String, u32, u32, &'static str) {
+        (self.name.clone(), self.vendor, self.device, super::gpu::backend_name(self.backend))
+    }
+}
+
+pub fn type_name(t: wgpu::DeviceType) -> &'static str {
+    match t {
+        wgpu::DeviceType::DiscreteGpu => "discrete",
+        wgpu::DeviceType::IntegratedGpu => "integrated",
+        wgpu::DeviceType::VirtualGpu => "virtual",
+        wgpu::DeviceType::Cpu => "cpu",
+        wgpu::DeviceType::Other => "other",
+    }
+}
+
+fn type_rank(t: wgpu::DeviceType) -> u8 {
+    match t {
+        wgpu::DeviceType::DiscreteGpu => 0,
+        wgpu::DeviceType::IntegratedGpu => 1,
+        wgpu::DeviceType::VirtualGpu => 2,
+        wgpu::DeviceType::Other => 3,
+        wgpu::DeviceType::Cpu => 4,
+    }
+}
+
+/// The platform's native presentation API first: on Windows DX12 presents
+/// through DXGI on hybrid laptops without a Vulkan cross-adapter blit.
+fn backend_rank(b: wgpu::Backend) -> u8 {
+    let native = if cfg!(target_os = "windows") {
+        wgpu::Backend::Dx12
+    } else if cfg!(any(target_os = "macos", target_os = "ios")) {
+        wgpu::Backend::Metal
+    } else {
+        wgpu::Backend::Vulkan
+    };
+    match b {
+        b if b == native => 0,
+        wgpu::Backend::Vulkan | wgpu::Backend::Dx12 | wgpu::Backend::Metal => 1,
+        wgpu::Backend::Gl => 2,
+        _ => 3,
+    }
+}
+
+/// Does the user's `--gpu` / `CAMCRAFT_GPU` substring name this adapter?
+pub fn wanted(desc: &AdapterDesc, want: &str) -> bool {
+    let w = want.trim().to_ascii_lowercase();
+    !w.is_empty() && desc.name.to_ascii_lowercase().contains(&w)
+}
+
+/// The order to try adapters in (indices into `adapters`), plus a note for
+/// every adapter left out. Order: a user-named adapter, then the GPU wgpu's
+/// HighPerformance request answered with (on its best backend), then every
+/// other surface-compatible adapter - discrete, integrated, virtual,
+/// other, cpu - native backend first, enumeration order last. Adapters
+/// that cannot present to the window are skipped by name.
+pub fn order(
+    adapters: &[AdapterDesc],
+    want: Option<&str>,
+    high_perf: Option<&AdapterDesc>,
+) -> (Vec<usize>, Vec<String>) {
+    let mut notes = Vec::new();
+    let mut idx: Vec<usize> = Vec::new();
+    for (i, a) in adapters.iter().enumerate() {
+        if a.surface_ok {
+            idx.push(i);
+        } else {
+            notes.push(format!(
+                "\"{}\" via {}: skipped - cannot present to this window",
+                a.name,
+                super::gpu::backend_name(a.backend)
+            ));
+        }
+    }
+    let want = want.map(str::trim).filter(|w| !w.is_empty());
+    if let Some(w) = want
+        && !idx.iter().any(|&i| wanted(&adapters[i], w))
+    {
+        notes.push(format!("no presentable adapter matches the --gpu/CAMCRAFT_GPU choice \"{w}\" - automatic order"));
+    }
+    idx.sort_by_key(|&i| {
+        let a = &adapters[i];
+        let user = !want.is_some_and(|w| wanted(a, w));
+        let hp = !high_perf.is_some_and(|h| h.same_gpu(a));
+        (user, hp, type_rank(a.device_type), backend_rank(a.backend), i)
+    });
+    (idx, notes)
+}
+
+/// Build the surface configuration from what the surface reports for this
+/// adapter, never from assumptions: the surface's preferred format, Fifo
+/// (vsync, always offered per the spec) unless absent, Opaque alpha when
+/// offered else the first reported mode, two frames in flight. `None` when
+/// the surface reports nothing usable for this adapter.
+pub fn surface_config(
+    caps: &wgpu::SurfaceCapabilities,
+    width: u32,
+    height: u32,
+) -> Result<wgpu::SurfaceConfiguration, String> {
+    let format = *caps.formats.first().ok_or("the surface reports no texture format for this adapter")?;
+    let present_mode = if caps.present_modes.contains(&wgpu::PresentMode::Fifo) {
+        wgpu::PresentMode::Fifo
+    } else {
+        *caps.present_modes.first().ok_or("the surface reports no present mode for this adapter")?
+    };
+    let alpha_mode = if caps.alpha_modes.contains(&wgpu::CompositeAlphaMode::Opaque) {
+        wgpu::CompositeAlphaMode::Opaque
+    } else {
+        *caps.alpha_modes.first().ok_or("the surface reports no alpha mode for this adapter")?
+    };
+    if !caps.usages.contains(wgpu::TextureUsages::RENDER_ATTACHMENT) {
+        return Err("the surface cannot be rendered to on this adapter".into());
+    }
+    Ok(wgpu::SurfaceConfiguration {
+        usage: wgpu::TextureUsages::RENDER_ATTACHMENT,
+        format,
+        color_space: wgpu::SurfaceColorSpace::Auto,
+        width: width.max(1),
+        height: height.max(1),
+        desired_maximum_frame_latency: 2,
+        present_mode,
+        alpha_mode,
+        view_formats: vec![],
+    })
+}
