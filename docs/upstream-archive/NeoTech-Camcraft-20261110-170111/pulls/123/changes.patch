+    create(&world, &mut h, "Op1", "EM-0600-4FL", "block", pocket(FLOOR));
+    generate(&world, &mut h, "Op1").expect("Op1");
+    create(&world, &mut h, "Op2", "DR-0400", "block", drill(FLOOR, HOLE_FLOOR, TOP));
+    generate(&world, &mut h, "Op2").expect("Op2");
