diff --git a/crates/ui/src/egui_app/machine_file_editor.rs b/crates/ui/src/egui_app/machine_file_editor.rs
new file mode 100644
index 00000000..d396b772
--- /dev/null
+++ b/crates/ui/src/egui_app/machine_file_editor.rs
@@ -0,0 +1,271 @@
+//! The Machines pane's file editor (issue #383): one machine file as a
+//! property grid in collapsible groups, each field's key in its tooltip
+//! and its refusals under it; Save / Save As with their own
+//! confirmation; the save blocked while any refusal stands.
+//!
+//! Provenance: the workflow is specced from the issue (new from
+//! template, new blank, edit, Save / Save As to the user machines
+//! folder, validation blocks the save); every word and widget is ours.
+//! The draft, the grid, the rules and the write live in the app layer
+//! (`camcraft_app::machine::{draft, fields, store, validate}`): this
+//! file draws what they answer and calls them on a click.
+//!
+//! Editing a machine FILE is a save with its own confirmation, not a
+//! document edit: nothing here queues a command or touches the history
+//! (#287 rules). The editor's state is view state like the pane's. It
+//! is not the Setup pane's machine window (`machine_editor`), which
+//! edits the MOUNTED machine through the undoable `EditMachineApply`.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use egui::{Label, RichText, TextEdit, Ui};
+
+use camcraft_app::machine::draft::MachineDraft;
+use camcraft_app::machine::fields;
+use camcraft_app::machine::store::SaveError;
+
+use super::layout::{group_open, prop_grid};
+use super::theme::Tokens;
+
+/// The confirmation step a save is waiting on.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Prompt {
+    /// Save over the file the draft came from.
+    Save(PathBuf),
+    /// Pick a file name in the user machines folder.
+    SaveAs,
+    /// Save As found the name taken: replace it?
+    Replace(String),
+    /// Close with unsaved edits?
+    Discard,
+}
+
+/// One machine open in the editor.
+pub struct MachineFileEditor {
+    pub draft: MachineDraft,
+    /// The typed text per field pointer, so a half-typed number (`1.`)
+    /// stays as typed while the file holds what it reads as.
+    pub buffers: HashMap<String, String>,
+    /// The Save As file name being typed.
+    pub save_as_name: String,
+    /// The new coolant's name being typed.
+    pub new_coolant: String,
+    pub prompt: Option<Prompt>,
+    /// The last save's outcome: (it worked, the words).
+    pub status: Option<(bool, String)>,
+}
+
+/// What a frame of the editor asks of the pane.
+#[derive(Default)]
+pub struct EditorOut {
+    /// A file was written: re-read the catalogue and select it.
+    pub saved: Option<PathBuf>,
+    /// The editor closed.
+    pub close: bool,
+}
+
+impl MachineFileEditor {
+    #[must_use]
+    pub fn new(draft: MachineDraft) -> Self {
+        let save_as_name = draft.suggested_name();
+        Self { draft, buffers: HashMap::new(), save_as_name, new_coolant: String::new(), prompt: None, status: None }
+    }
+}
+
+/// The verdict line for the draft.
+pub(crate) fn verdict(n: usize) -> String {
+    match n {
+        0 => "Validation: passes".to_owned(),
+        1 => "Validation: 1 refusal - save blocked".to_owned(),
+        n => format!("Validation: {n} refusals - save blocked"),
+    }
+}
+
+fn saved_words(p: &Path) -> String {
+    format!("Saved {}", p.display())
+}
+
+/// Run one save and turn its answer into the editor's state.
+fn finish(ed: &mut MachineFileEditor, out: &mut EditorOut, r: Result<PathBuf, SaveError>) {
+    ed.prompt = None;
+    match r {
+        Ok(p) => {
+            ed.status = Some((true, saved_words(&p)));
+            out.saved = Some(p);
+        }
+        Err(SaveError::Exists(p)) => {
+            ed.prompt = Some(Prompt::Replace(p.display().to_string()));
+        }
+        Err(e) => ed.status = Some((false, e.to_string())),
+    }
+}
+
+fn prompt(ui: &mut Ui, ed: &mut MachineFileEditor, dir: Option<&Path>, out: &mut EditorOut, pal: &Tokens) {
+    let Some(p) = ed.prompt.clone() else { return };
+    ui.group(|ui| match p {
+        Prompt::Save(path) => {
+            ui.add(Label::new(format!("Write {}?", path.display())).wrap());
+            ui.horizontal(|ui| {
+                if ui.button("Write file").clicked() {
+                    let r = ed.draft.save();
+                    finish(ed, out, r);
+                }
+                if ui.button("Cancel").clicked() {
+                    ed.prompt = None;
+                }
+            });
+        }
+        Prompt::SaveAs => {
+            let where_ = dir.map_or_else(|| "no user machines folder".to_owned(), |d| d.display().to_string());
+            ui.add(Label::new(RichText::new(format!("Save to {where_}")).color(pal.text_dim)).wrap());
+            ui.horizontal(|ui| {
+                let l = ui.label("File name");
+                ui.add(TextEdit::singleline(&mut ed.save_as_name).desired_width(160.0))
+                    .labelled_by(l.id)
+                    .on_hover_text("A plain name; .mch is added");
+            });
+            ui.horizontal(|ui| {
+                if ui.button("Write file").clicked() {
+                    let name = ed.save_as_name.clone();
+                    let r = ed.draft.save_as(dir, &name, false);
+                    finish(ed, out, r);
+                }
+                if ui.button("Cancel").clicked() {
+                    ed.prompt = None;
+                }
+            });
+        }
+        Prompt::Replace(path) => {
+            ui.add(Label::new(format!("{path} exists. Replace it?")).wrap());
+            ui.horizontal(|ui| {
+                if ui.button("Replace file").clicked() {
+                    let name = ed.save_as_name.clone();
+                    let r = ed.draft.save_as(dir, &name, true);
+                    finish(ed, out, r);
+                }
+                if ui.button("Cancel").clicked() {
+                    ed.prompt = Some(Prompt::SaveAs);
+                }
+            });
+        }
+        Prompt::Discard => {
+            ui.label("Discard the unsaved edits?");
+            ui.horizontal(|ui| {
+                if ui.button("Discard edits").clicked() {
+                    out.close = true;
+                }
+                if ui.button("Keep editing").clicked() {
+                    ed.prompt = None;
+                }
+            });
+        }
+    });
+}
+
+/// Draw the editor. `dir` is the user machines folder Save As writes to.
+pub(crate) fn draw(ui: &mut Ui, ed: &mut MachineFileEditor, dir: Option<&Path>, pal: &Tokens, error: egui::Color32) -> EditorOut {
+    let mut out = EditorOut::default();
+    let refusals = ed.draft.refusals();
+    let groups = ed.draft.groups();
+
+    let title = if ed.draft.model().is_empty() { "(no model)".to_owned() } else { ed.draft.model() };
+    ui.add(Label::new(RichText::new(format!("Editing {title}{}", if ed.draft.dirty { " *" } else { "" })).strong()).wrap());
+    let at = match (&ed.draft.path, ed.draft.read_only) {
+        (_, true) => "Shipped machine - read-only; Save As writes your own copy".to_owned(),
+        (Some(p), false) => p.display().to_string(),
+        (None, false) => "Not saved yet".to_owned(),
+    };
+    ui.add(Label::new(RichText::new(at).small().color(pal.text_dim)).wrap());
+
+    ui.horizontal_wrapped(|ui| {
+        let blocked = !refusals.is_empty();
+        let save = ui
+            .add_enabled(!blocked, egui::Button::new("Save machine"))
+            .on_hover_text("Write this machine file (asks first)")
+            .on_disabled_hover_text("Fix every refusal first - a refused file is never written");
+        if save.clicked() {
+            ed.prompt = Some(match (&ed.draft.path, ed.draft.read_only) {
+                (Some(p), false) => Prompt::Save(p.clone()),
+                _ => Prompt::SaveAs,
+            });
+        }
+        let save_as = ui
+            .add_enabled(!blocked, egui::Button::new("Save machine as..."))
+            .on_hover_text("Write a copy to your machines folder")
+            .on_disabled_hover_text("Fix every refusal first - a refused file is never written");
+        if save_as.clicked() {
+            ed.prompt = Some(Prompt::SaveAs);
+        }
+        if ui.button("Close editor").on_hover_text("Leave the editor").clicked() {
+            if ed.draft.dirty {
+                ed.prompt = Some(Prompt::Discard);
+            } else {
+                out.close = true;
+            }
+        }
+    });
+    prompt(ui, ed, dir, &mut out, pal);
+    if let Some((ok, words)) = &ed.status {
+        let ink = if *ok { pal.accent } else { error };
+        ui.add(Label::new(RichText::new(words.as_str()).color(ink)).wrap());
+    }
+
+    let ink = if refusals.is_empty() { pal.accent } else { error };
+    ui.label(RichText::new(verdict(refusals.len())).color(ink).strong());
+    for r in fields::unplaced(&groups, &refusals) {
+        ui.add(Label::new(RichText::new(r.to_string()).color(error)).wrap());
+    }
+    ui.add_space(4.0);
+
+    let mut edits: Vec<(String, fields::FieldKind, String)> = Vec::new();
+    let mut add_coolant = false;
+    for g in &groups {
+        group_open(ui, &g.title, None, true, |ui| {
+            if g.fields.is_empty() {
+                ui.label(RichText::new("none stated").color(pal.text_dim));
+            }
+            prop_grid(ui, &format!("machine-edit-{}", g.title), |ui| {
+                for f in &g.fields {
+                    let tip = format!("Key: {}", f.key);
+                    let l = ui.label(&f.label).on_hover_text(&tip);
+                    let buf = ed.buffers.entry(f.pointer.clone()).or_insert_with(|| f.value.clone());
+                    let r = ui
+                        .add(TextEdit::singleline(buf).desired_width(140.0).hint_text("not stated"))
+                        .labelled_by(l.id)
+                        .on_hover_text(&tip);
+                    if r.changed() {
+                        edits.push((f.pointer.clone(), f.kind, buf.clone()));
+                    }
+                    ui.end_row();
+                    for refusal in f.refusals(&refusals) {
+                        ui.label("");
+                        ui.add(Label::new(RichText::new(refusal.to_string()).color(error)).wrap());
+                        ui.end_row();
+                    }
+                }
+            });
+            if g.title == "Coolant codes" {
+                ui.horizontal(|ui| {
+                    let l = ui.label("New coolant");
+                    ui.add(TextEdit::singleline(&mut ed.new_coolant).desired_width(100.0)).labelled_by(l.id);
+                    if ui.button("Add coolant").on_hover_text("Add a named coolant to the tool station").clicked() {
+                        add_coolant = true;
+                    }
+                });
+            }
+        });
+    }
+    for (pointer, kind, text) in edits {
+        if let Err(e) = ed.draft.set(&pointer, kind, &text) {
+            ed.status = Some((false, e));
+        }
+    }
+    if add_coolant {
+        let name = std::mem::take(&mut ed.new_coolant);
+        if let Err(e) = ed.draft.add_coolant(&name) {
+            ed.status = Some((false, e));
+        }
+    }
+    out
+}
diff --git a/crates/ui/src/egui_app/machines_pane.rs b/crates/ui/src/egui_app/machines_pane.rs
new file mode 100644
index 00000000..3e1530ac
--- /dev/null
+++ b/crates/ui/src/egui_app/machines_pane.rs
@@ -0,0 +1,258 @@
+//! The Machines pane (issue #287, first slice): a dockable, read-only
+//! browser of every machine definition the app can name - the shipped
+//! library and the document's own `.mch` file - with each machine's
+//! grouped properties and its validation, refusal by refusal.
+//!
+//! Provenance: the workflow is specced from the issue (list, inspect,
+//! validate machine configurations); every word and widget here is
+//! ours. The catalogue, the sheet and the rules live in the app layer
+//! (`camcraft_app::machine::library` / `validate`): this pane only draws
+//! what they answer - it reads no file itself.
+//!
+//! View state only: which row is selected and the cached catalogue are
+//! ephemeral like the dock (never a command, never saved). #383 adds
+//! the file editor (`machine_file_editor`): New blank, New from
+//! template and Edit open a machine FILE for editing, saved with its
+//! own confirmation - still no command, no history. The one document
+//! change the pane makes is "Use for this setup" (#384): it only queues
+//! `CommandKind::UseCatalogueMachine`, routed like every machine verb
+//! (#343): the undoable `SetSetupMachine` when the active setup owns its
+//! machine, else `LoadMachine`; a refused or already-mounted machine
+//! leaves the button disabled with the reason beside it.
+
+use std::path::PathBuf;
+
+use egui::{Label, RichText, ScrollArea, Ui};
+
+use camcraft_app::machine::draft::MachineDraft;
+use camcraft_app::machine::library::{self, MachineEntry, MachineSource};
+use camcraft_app::machine::{store, Kind};
+
+use super::machine_file_editor::{self as file_editor, MachineFileEditor};
+
+use super::colorvision::text_inks;
+use super::layout::{group_open, prop_grid};
+use super::theme::Tokens;
+use crate::state::{CommandKind, State};
+
+/// The pane's view state.
+#[derive(Default)]
+pub struct MachinesPane {
+    /// The catalogue as last read; `None` = read it on the next draw.
+    pub list: Option<Vec<MachineEntry>>,
+    /// The document's machine path the catalogue was read for - a new
+    /// mount re-reads it (the document's file is one of the entries).
+    pub listed_for: String,
+    /// The selected row, an index into `list`.
+    pub selected: Option<usize>,
+    /// The user machines folder: `None` = not resolved yet (resolved
+    /// once, `store::user_dir`); `Some(None)` = there is none. Tests
+    /// point it at a temp folder.
+    pub user_dir: Option<Option<PathBuf>>,
+    /// The machine file open in the editor, if any.
+    pub editor: Option<MachineFileEditor>,
+    /// The kind New blank starts.
+    pub new_kind: usize,
+}
+
+/// The kinds New blank offers, in the combo's order.
+const KINDS: [Kind; 3] = [Kind::Mill, Kind::Lathe, Kind::MillTurn];
+
+/// A list row's words: name, then kind, axes and units - unique per
+/// entry in practice, and what a test finds the row by.
+pub(crate) fn row_label(e: &MachineEntry) -> String {
+    let kind = e.kind.map_or("?", |k| k.word());
+    let mut axes: String = e.axes.concat();
+    axes.push_str(&e.rotaries.concat());
+    if axes.is_empty() {
+        axes.push('?');
+    }
+    let mark = if e.is_valid() { "" } else { "  [refused]" };
+    format!("{}  ({kind}, {axes}, {}){mark}", e.name, e.units)
+}
+
+/// The validation heading for an entry.
+pub(crate) fn verdict(e: &MachineEntry) -> String {
+    match e.refusals.len() {
+        0 => "Validation: passes".to_owned(),
+        1 => "Validation: 1 refusal".to_owned(),
+        n => format!("Validation: {n} refusals"),
+    }
+}
+
+/// Make sure the catalogue is current: read once, and again when the
+/// document mounts a different machine.
+fn refresh(state: &mut State) {
+    let (path, _) = camcraft_app::machine::of(&state.world);
+    let p = &mut state.machines_pane;
+    let dir = p.user_dir.get_or_insert_with(store::user_dir).clone();
+    if p.list.is_none() || p.listed_for != path {
+        let list = library::enumerate_with(&state.world, dir.as_deref());
+        if p.selected.is_some_and(|i| i >= list.len()) {
+            p.selected = None;
+        }
+        p.list = Some(list);
+        p.listed_for = path;
+    }
+}
+
+/// The pane's assign button label (a test finds it by these words).
+pub(crate) const USE_FOR_SETUP: &str = "Use for this setup";
+
+pub(crate) fn draw(ui: &mut Ui, state: &mut State, pal: &Tokens) {
+    refresh(state);
+    let inks = text_inks(ui, &state.world);
+    // Why the selected machine can't be assigned (read before the pane
+    // borrow below takes `state`).
+    let block = state
+        .machines_pane
+        .selected
+        .and_then(|i| state.machines_pane.list.as_ref().and_then(|l| l.get(i)))
+        .map(|e| e.assign_block(&state.world));
+    let mut assign = None;
+    let p = &mut state.machines_pane;
+    let Some(list) = p.list.as_ref() else { return };
+    let mut reread = false;
+    ui.horizontal(|ui| {
+        ui.label(RichText::new(format!("{} machines", list.len())).color(pal.text_dim));
+        if ui
+            .button("Refresh")
+            .on_hover_text("Read the machine files again")
+            .clicked()
+        {
+            reread = true;
+        }
+    });
+    let picked = p.selected.and_then(|i| list.get(i)).map(|e| e.source.clone());
+    let mut open: Option<Result<MachineDraft, String>> = None;
+    if p.editor.is_none() {
+        ui.horizontal_wrapped(|ui| {
+            let kind = KINDS.get(p.new_kind).copied().unwrap_or(Kind::Mill);
+            egui::ComboBox::from_id_salt("machines-new-kind")
+                .selected_text(kind.word())
+                .show_ui(ui, |ui| {
+                    for (i, k) in KINDS.iter().enumerate() {
+                        ui.selectable_value(&mut p.new_kind, i, k.word());
+                    }
+                });
+            if ui.button("New blank").on_hover_text("A new machine file with the keys its kind requires").clicked() {
+                open = Some(Ok(MachineDraft::blank(kind)));
+            }
+            let has = picked.is_some();
+            if ui
+                .add_enabled(has, egui::Button::new("New from template"))
+                .on_hover_text("A new machine file copied from the selected machine")
+                .on_disabled_hover_text("Select a machine to copy")
+                .clicked()
+                && let Some(src) = &picked
+            {
+                open = Some(MachineDraft::from_template(src).map_err(|r| r.to_string()));
+            }
+            if ui
+                .add_enabled(has, egui::Button::new("Edit machine"))
+                .on_hover_text("Edit the selected machine file (a shipped one saves as a copy)")
+                .on_disabled_hover_text("Select a machine to edit")
+                .clicked()
+                && let Some(src) = &picked
+            {
+                open = Some(MachineDraft::open(src).map_err(|r| r.to_string()));
+            }
+        });
+    }
+    match open {
+        Some(Ok(d)) => p.editor = Some(MachineFileEditor::new(d)),
+        Some(Err(e)) => {
+            ui.label(RichText::new(format!("Cannot open: {e}")).color(inks.error));
+        }
+        None => {}
+    }
+    ui.separator();
+    let mut chose = None;
+    ScrollArea::vertical()
+        .id_salt("machines-list")
+        .max_height((ui.available_height() * 0.4).max(80.0))
+        .auto_shrink([false, true])
+        .show(ui, |ui| {
+            for (i, e) in list.iter().enumerate() {
+                let r = ui
+                    .selectable_label(p.selected == Some(i), row_label(e))
+                    .on_hover_text(e.source.label());
+                if r.clicked() {
+                    chose = Some(i);
+                }
+            }
+        });
+    if let Some(i) = chose {
+        p.selected = Some(i);
+    }
+    ui.separator();
+    if let Some(ed) = p.editor.as_mut() {
+        let dir = p.user_dir.clone().flatten();
+        let out = ScrollArea::vertical()
+            .id_salt("machines-editor")
+            .show(ui, |ui| file_editor::draw(ui, ed, dir.as_deref(), pal, inks.error))
+            .inner;
+        if out.close {
+            p.editor = None;
+        }
+        if let Some(saved) = out.saved {
+            // Re-read the catalogue and select the file just written.
+            let world_list = library::enumerate_with(&state.world, dir.as_deref());
+            let p = &mut state.machines_pane;
+            p.selected = world_list
+                .iter()
+                .position(|e| matches!(&e.source, MachineSource::File(f) if *f == saved));
+            p.list = Some(world_list);
+        } else if reread {
+            p.list = None;
+        }
+        return;
+    }
+    let Some(e) = p.selected.and_then(|i| list.get(i)) else {
+        ui.label(RichText::new("Select a machine to see its properties.").color(pal.text_dim));
+        if reread {
+            p.list = None;
+        }
+        return;
+    };
+    ScrollArea::vertical().id_salt("machines-detail").show(ui, |ui| {
+        ui.add(Label::new(RichText::new(&e.name).strong()).wrap());
+        ui.add(Label::new(RichText::new(e.source.label()).small().color(pal.text_dim)).wrap());
+        let ink = if e.is_valid() { pal.accent } else { inks.error };
+        ui.label(RichText::new(verdict(e)).color(ink).strong());
+        for r in &e.refusals {
+            ui.add(Label::new(RichText::new(r.to_string()).color(inks.error)).wrap());
+        }
+        let why = block.clone().flatten();
+        let r = ui.add_enabled(why.is_none(), egui::Button::new(USE_FOR_SETUP));
+        match &why {
+            None => {
+                if r.on_hover_text("Make this the setup's machine (Ctrl+Z undoes it)").clicked() {
+                    assign = Some(e.source.clone());
+                }
+            }
+            Some(why) => {
+                r.on_disabled_hover_text(format!("Cannot assign: {why}"));
+                ui.add(Label::new(RichText::new(format!("Cannot assign: {why}")).color(pal.text_dim)).wrap());
+            }
+        }
+        ui.add_space(4.0);
+        for g in &e.groups {
+            group_open(ui, &g.title, None, true, |ui| {
+                prop_grid(ui, &format!("machine-{}", g.title), |ui| {
+                    for (label, value) in &g.rows {
+                        ui.label(label);
+                        ui.add(Label::new(value).wrap());
+                        ui.end_row();
+                    }
+                });
+            });
+        }
+    });
+    if reread {
+        p.list = None;
+    }
+    if let Some(source) = assign {
+        state.pending.push_back(CommandKind::UseCatalogueMachine(source));
+    }
+}
