diff --git a/crates/app/tests/wcs_view_pose.rs b/crates/app/tests/wcs_view_pose.rs
new file mode 100644
index 00000000..4e642ae9
--- /dev/null
+++ b/crates/app/tests/wcs_view_pose.rs
@@ -0,0 +1,108 @@
+//! #558: a setup's WCS is a point fixed on the part in ITS setup's frame.
+//! The viewport shows the active setup's frame, so another setup's WCS
+//! is drawn through the part's transform between the two setups
+//! (`setup_relative::wcs_view_pose`) - it stays on the same spot of the
+//! part, never at its raw stored place. The active setup's own WCS, and
+//! every document without setups, draw the stored pose unchanged.
+//!
+//! Gate map (#558): covers app::setup_relative (wcs_view_pose,
+//! transform_between), app::setup (wcs_entity_name).
+//! Provenance: our own fixtures; rigid-body transform algebra.
+
+use camcraft_app::commands::{ActivateSetup, AlignPartToSetup, CreateSetup, History, ImportModel, SetStock, SetWcsOrigin};
+use camcraft_app::geometry::{cube, transform_point, Point3};
+use camcraft_app::schema::Location;
+use camcraft_app::setup_align::{self, AlignPreset};
+use camcraft_app::stock::StockShape;
+use camcraft_app::world::new_world;
+use camcraft_app::{model, setup, setup_relative};
+use flecs_ecs::prelude::World;
+
+/// The part's top corner the user zeroes Setup1 on (document frame).
+const CORNER: [f64; 3] = [40.0, 20.0, 10.0];
+
+fn activate(world: &World, h: &mut History, s: &str) {
+    if setup::active(world).as_deref() != Some(s) {
+        h.execute(world, ActivateSetup::new(world, Some(s)).expect("activate"));
+    }
+}
+
+/// A 40 x 20 x 10 block; Setup1 as modelled with its WCS on the block's
+/// top corner; Setup2 holding the part turned (`preset`), active.
+fn two_setups(preset: AlignPreset) -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::new(0.0, 0.0, 0.0), Point3::new(40.0, 20.0, 10.0))));
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 12.0 }, Location::default()).expect("stock"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("Setup1"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("Setup2"));
+    activate(&world, &mut h, "Setup1");
+    let at = Location { pos: Point3::new(CORNER[0], CORNER[1], CORNER[2]), ..Default::default() };
+    h.execute(&world, SetWcsOrigin::new(&world, at).expect("Setup1's WCS on the corner"));
+    activate(&world, &mut h, "Setup2");
+    h.execute(&world, AlignPartToSetup::preset(&world, "Setup2", preset).expect("turn the part in Setup2"));
+    (world, h)
+}
+
+/// Where the corner sits in `s`'s frame: the part's own alignment there.
+fn corner_in(world: &World, s: &str) -> Point3 {
+    let c = Point3::new(CORNER[0], CORNER[1], CORNER[2]);
+    match setup_align::stored(world, s) {
+        Some(a) => transform_point(c, a.pos, a.rot),
+        None => c,
+    }
+}
+
+fn stored(world: &World, name: &str) -> Location {
+    let e = model::find_by_name(world, name).expect("wcs entity");
+    model::transform_of(world, &e).expect("wcs pose")
+}
+
+fn close(a: Point3, b: Point3) -> bool {
+    (a.x - b.x).abs() < 1e-6 && (a.y - b.y).abs() < 1e-6 && (a.z - b.z).abs() < 1e-6
+}
+
+#[test]
+fn another_setups_wcs_stays_on_its_spot_of_the_part() {
+    for preset in [AlignPreset::TurnZ90, AlignPreset::FlipX, AlignPreset::TurnZ180] {
+        let (world, _h) = two_setups(preset);
+        let s1 = setup::wcs_entity_name(&world, Some("Setup1"));
+        let pose = setup_relative::wcs_view_pose(&world, &s1, stored(&world, &s1))
+            .expect("mappable")
+            .expect("another setup's WCS is mapped");
+        let want = corner_in(&world, "Setup2");
+        assert!(close(pose.pos, want), "{preset:?}: drawn at {:?}, the corner is at {want:?}", pose.pos);
+        assert!(!close(pose.pos, stored(&world, &s1).pos), "{preset:?}: not left at its raw stored place");
+    }
+}
+
+#[test]
+fn the_active_setups_own_wcs_and_a_setupless_document_draw_as_stored() {
+    let (world, mut h) = two_setups(AlignPreset::TurnZ90);
+    let s2 = setup::wcs_entity_name(&world, Some("Setup2"));
+    if model::find_by_name(&world, &s2).is_some() {
+        assert_eq!(setup_relative::wcs_view_pose(&world, &s2, stored(&world, &s2)), Ok(None), "the active setup's own WCS");
+    }
+    // Showing Setup1 again: its own WCS is drawn where it is stored.
+    activate(&world, &mut h, "Setup1");
+    let s1 = setup::wcs_entity_name(&world, Some("Setup1"));
+    assert_eq!(setup_relative::wcs_view_pose(&world, &s1, stored(&world, &s1)), Ok(None));
+
+    let bare = new_world();
+    assert_eq!(setup_relative::wcs_view_pose(&bare, "G54", Location::default()), Ok(None), "no setups: unchanged");
+}
+
+#[test]
+fn switching_the_shown_setup_keeps_the_wcs_on_the_part() {
+    let (world, mut h) = two_setups(AlignPreset::TurnZ90);
+    let s1 = setup::wcs_entity_name(&world, Some("Setup1"));
+    let in_s2 = setup_relative::wcs_view_pose(&world, &s1, stored(&world, &s1)).expect("ok").expect("mapped");
+    activate(&world, &mut h, "Setup1");
+    // Back in its own setup it is the stored corner again, and the part is
+    // as modelled there - the same physical spot.
+    assert_eq!(setup_relative::wcs_view_pose(&world, &s1, stored(&world, &s1)), Ok(None));
+    assert!(close(stored(&world, &s1).pos, corner_in(&world, "Setup1")));
+    activate(&world, &mut h, "Setup2");
+    let again = setup_relative::wcs_view_pose(&world, &s1, stored(&world, &s1)).expect("ok").expect("mapped");
+    assert!(close(in_s2.pos, again.pos), "the same spot every time Setup2 is shown");
+}
diff --git a/crates/app/tests/winding_align.rs b/crates/app/tests/winding_align.rs
new file mode 100644
index 00000000..25086926
--- /dev/null
+++ b/crates/app/tests/winding_align.rs
@@ -0,0 +1,192 @@
+//! #366: face-normal alignment picks trust a face's facet winding only on
+//! a body that is closed and wound outward (positive signed volume). An
+//! inside-out cube refuses the plane lay and the 3-2-1 by name (#554:
+//! two edges no longer lay a plane - refused as edges, whatever the
+//! winding); the same cube wound outward still works; an open box, a body
+//! wound both ways and a non-manifold body refuse by name. The shipped
+//! test models (STL, OBJ, STEP) read as outward.
+//! Provenance: our own fixtures over the divergence-theorem volume sign.
+//!
+//! Gate map (#366): covers app::pick::winding, app::pick::align
+//! (outward_normal), app::pick::plane (face datum, edge refusal).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use std::path::Path;
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::cl::ArcPlane;
+use camcraft_app::commands::{CreateSetup, History, ImportModel};
+use camcraft_app::geometry::import;
+use camcraft_app::geometry::{Mesh, Point3, Triangle, cube, feature};
+use camcraft_app::model;
+use camcraft_app::operation::{FeatureSel, GeoSel};
+use camcraft_app::pick::winding::{BodyWinding, verdict_for, winding_of};
+use camcraft_app::pick::{PlaneLay, align_321, lay_on_plane, plane_side};
+
+const G17: PlaneLay = PlaneLay { plane: ArcPlane::Xy, flip: false, place: false };
+
+fn block() -> Mesh {
+    cube(Point3::new(0.0, 0.0, 0.0), Point3::new(20.0, 20.0, 10.0))
+}
+
+/// Every facet wound the other way: the classic inside-out STL.
+fn inverted(m: &Mesh) -> Mesh {
+    Mesh::from_facets(m.facets.iter().map(|t| Triangle::new(t.a, t.c, t.b)).collect())
+}
+
+fn world_of(mesh: Mesh) -> World {
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("p", mesh));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("Setup1"));
+    world
+}
+
+fn features(w: &World) -> std::sync::Arc<feature::Features> {
+    let e = model::find_by_name(w, "p").expect("part");
+    model::features_of(w, &e).expect("features")
+}
+
+/// The face of `p` whose plane holds point `at`.
+fn face(w: &World, at: [f64; 3]) -> GeoSel {
+    let f = features(w);
+    let id = f
+        .faces
+        .iter()
+        .find(|f| (f.normal[0] * at[0] + f.normal[1] * at[1] + f.normal[2] * at[2] - f.offset).abs() < 1e-9)
+        .map(|f| f.id)
+        .expect("the part has that face");
+    GeoSel { entity: "p".into(), feature: FeatureSel::Face(id) }
+}
+
+fn edge(w: &World, a: [f64; 3], b: [f64; 3]) -> GeoSel {
+    let f = features(w);
+    let id = feature::chains(&f)
+        .into_iter()
+        .find(|c| {
+            let p = feature::chain_points(&f, c);
+            p.len() == 2 && ((p[0] == a && p[1] == b) || (p[0] == b && p[1] == a))
+        })
+        .map(|c| c.id)
+        .expect("the part has that edge");
+    GeoSel { entity: "p".into(), feature: FeatureSel::Chain(id) }
+}
+
+const TOP: [f64; 3] = [10.0, 10.0, 10.0];
+const FRONT_TOP: ([f64; 3], [f64; 3]) = ([0.0, 0.0, 10.0], [20.0, 0.0, 10.0]);
+const RIGHT_TOP: ([f64; 3], [f64; 3]) = ([20.0, 0.0, 10.0], [20.0, 20.0, 10.0]);
+
+fn assert_named(e: &str, what: &str) {
+    assert!(e.starts_with("face "), "the refusal names the face: {e}");
+    assert!(e.contains("of 'p'"), "the refusal names the part: {e}");
+    assert!(e.contains(what), "the refusal says why ({what}): {e}");
+}
+
+#[test]
+fn an_inside_out_cube_refuses_the_face_lay_by_name() {
+    let w = world_of(inverted(&block()));
+    let top = face(&w, TOP);
+    let e = lay_on_plane(&w, std::slice::from_ref(&top), G17).expect_err("refused");
+    assert_named(&e, "inside-out");
+    assert!(e.starts_with(&top.feature.to_string()), "names the picked face: {e}");
+    let e = plane_side(&w, &[top]).expect_err("the side readout refuses too");
+    assert_named(&e, "inside-out");
+}
+
+#[test]
+fn an_inside_out_cube_refuses_two_edges_as_edges() {
+    // #554: the two-edge lay is gone; the refusal is the edge's, before
+    // any winding is read.
+    let w = world_of(inverted(&block()));
+    let picks = [edge(&w, FRONT_TOP.0, FRONT_TOP.1), edge(&w, RIGHT_TOP.0, RIGHT_TOP.1)];
+    let e = lay_on_plane(&w, &picks, G17).expect_err("refused");
+    assert!(e.contains("an edge cannot set a plane"), "{e}");
+}
+
+#[test]
+fn an_inside_out_cube_refuses_the_321_by_name() {
+    let w = world_of(inverted(&block()));
+    let picks = [face(&w, TOP), edge(&w, FRONT_TOP.0, FRONT_TOP.1)];
+    let e = align_321(&w, &picks).expect_err("refused");
+    assert_named(&e, "inside-out");
+}
+
+#[test]
+fn the_same_cube_wound_outward_still_aligns() {
+    let w = world_of(block());
+    let a = lay_on_plane(&w, &[face(&w, TOP)], PlaneLay { plane: ArcPlane::Xy, flip: true, place: false })
+        .expect("face lay");
+    // Flipped onto -Z: the top (local +Z) turns over, a half turn.
+    assert!(a.rot[3].abs() < 1e-9, "a half turn: {a:?}");
+    let a = align_321(&w, &[face(&w, TOP), edge(&w, FRONT_TOP.0, FRONT_TOP.1)]).expect("3-2-1");
+    assert!((a.z[2] - 1.0).abs() < 1e-9, "Z out of the top: {:?}", a.z);
+}
+
+#[test]
+fn an_open_box_refuses_face_normal_picks_by_name() {
+    // The block with its bottom (z = 0) torn off.
+    let f: Vec<Triangle> = block()
+        .facets
+        .iter()
+        .copied()
+        .filter(|t| !(t.a.z == 0.0 && t.b.z == 0.0 && t.c.z == 0.0))
+        .collect();
+    let w = world_of(Mesh::from_facets(f));
+    let e = lay_on_plane(&w, &[face(&w, TOP)], G17).expect_err("refused");
+    assert_named(&e, "open body");
+    let picks = [face(&w, TOP), edge(&w, FRONT_TOP.0, FRONT_TOP.1)];
+    assert_named(&align_321(&w, &picks).expect_err("refused"), "open body");
+}
+
+#[test]
+fn mixed_and_non_manifold_bodies_refuse_by_name() {
+    // One facet of the bottom flipped: wound both ways.
+    let mut f = block().facets.to_vec();
+    let i = f.iter().position(|t| t.a.z == 0.0 && t.b.z == 0.0 && t.c.z == 0.0).expect("a bottom facet");
+    f[i] = Triangle::new(f[i].a, f[i].c, f[i].b);
+    let w = world_of(Mesh::from_facets(f));
+    assert_named(&lay_on_plane(&w, &[face(&w, TOP)], G17).expect_err("refused"), "wound both ways");
+    // A fin hung off the top's front edge: three facets on one edge.
+    let mut f = block().facets.to_vec();
+    f.push(Triangle::new(Point3::new(0.0, 0.0, 10.0), Point3::new(20.0, 0.0, 10.0), Point3::new(10.0, -5.0, 15.0)));
+    let w = world_of(Mesh::from_facets(f));
+    assert_named(&lay_on_plane(&w, &[face(&w, TOP)], G17).expect_err("refused"), "non-manifold");
+}
+
+#[test]
+fn bodies_are_judged_one_by_one() {
+    // An outward block beside an inside-out one, in one mesh: the good
+    // body's face still lays, the bad body's face refuses.
+    let good = block();
+    let bad = inverted(&cube(Point3::new(40.0, 0.0, 0.0), Point3::new(60.0, 20.0, 5.0)));
+    let w = world_of(Mesh::from_facets(good.facets.iter().chain(bad.facets.iter()).copied().collect()));
+    let wind = winding_of(&model::facets_of(&w, &model::find_by_name(&w, "p").expect("p")).expect("facets"));
+    assert_eq!(wind.bodies.len(), 2, "two bodies");
+    lay_on_plane(&w, &[face(&w, TOP)], G17).expect("the good block lays");
+    let e = lay_on_plane(&w, &[face(&w, [50.0, 10.0, 5.0])], G17).expect_err("the bad block refuses");
+    assert_named(&e, "inside-out");
+}
+
+#[test]
+fn the_shipped_test_models_read_as_outward() {
+    let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models");
+    for name in ["cube.stl", "box.obj", "box.step", "Milling-test.step", "sample_ap214.step"] {
+        let m = import::load_model(&dir.join(name)).unwrap_or_else(|e| panic!("{name}: {e:?}"));
+        let w = winding_of(&m.facets);
+        let all: Vec<u32> = (0..m.facets.len() as u32).collect();
+        assert_eq!(verdict_for(&w, &all), Some(BodyWinding::Outward), "{name}: bodies {:?}", w.bodies);
+    }
+}
+
+#[test]
+fn the_inside_out_stl_fixture_reads_inside_out_and_refuses() {
+    // testdata/models/cube_inside_out.stl: a 20 x 20 x 10 block exported
+    // inside-out (winding and stored normals both inward) - the GUI repro.
+    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models/cube_inside_out.stl");
+    let m = import::load_model(&path).expect("the fixture imports");
+    let wind = winding_of(&m.facets);
+    assert_eq!(wind.bodies, vec![BodyWinding::InsideOut]);
+    let w = world_of(m);
+    assert_named(&lay_on_plane(&w, &[face(&w, TOP)], G17).expect_err("refused"), "inside-out");
+}
diff --git a/crates/app/tests/world_init_race.rs b/crates/app/tests/world_init_race.rs
new file mode 100644
index 00000000..a6877ce5
--- /dev/null
+++ b/crates/app/tests/world_init_race.rs
@@ -0,0 +1,111 @@
+//! The first-world race (#379): flecs keeps its OS API (malloc, free,
+//! abort, the clock) in one process-global struct, and the first world
+//! a process creates fills it in without a lock. Two threads creating
+//! their first worlds at the same moment could see it half-written:
+//! `ecs_mini` aborted with ECS_MISSING_OS_API (SIGABRT) or called a NULL
+//! hook (SIGSEGV). Under load, the scripting suite crashed that way in
+//! about 1 run out of 170. project_roundtrip's one SIGABRT looks the
+//! same. `world::new_world` now finishes that
+//! initialisation once, behind a `Once`, before any world exists.
+//!
+//! The race only happens on a process's FIRST worlds, so one in-process
+//! test proves nothing once any world exists. This binary therefore
+//! re-runs itself as child processes. Each child releases a crowd of
+//! threads at one barrier, and every thread builds its first world at
+//! once. Every child must exit cleanly.
+//!
+//! Gate map (M4.4): covers app::world.
+
+use camcraft_app::world::new_world;
+use std::process::{Command, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Barrier};
+
+const CHILD_ENV: &str = "CAMCRAFT_WORLD_RACE_CHILD";
+/// Before the fix, about 3 children in 1000 crashed under this load
+/// (6 of 1920). With 720 children, a run took about 4 s and failed in 4
+/// of 6 runs. After the fix, 3840 of 3840 children passed. It is a
+/// stress test, so a pass is evidence, not proof. The scripting
+/// suite's stress loop in docs/decisions/379-scripting-sigsegv.md is
+/// the larger check.
+const CHILDREN: usize = 720;
+/// How many children run at once.
+const WAVE: usize = 24;
+const THREADS: usize = 32;
+
+/// One child's whole job: a crowd of threads released at one barrier,
+/// each building the first world it sees.
+fn crowd() {
+    let gate = Arc::new(Barrier::new(THREADS));
+    let handles: Vec<_> = (0..THREADS)
+        .map(|_| {
+            let gate = Arc::clone(&gate);
+            std::thread::spawn(move || {
+                gate.wait();
+                drop(new_world());
+            })
+        })
+        .collect();
+    for h in handles {
+        h.join().expect("a world-building thread panicked");
+    }
+}
+
+#[test]
+fn first_worlds_on_many_threads_never_crash() {
+    if std::env::var_os(CHILD_ENV).is_some() {
+        crowd();
+        return;
+    }
+    let exe = std::env::current_exe().expect("own test binary");
+    // Spinners keep every core busy while the children run, so a thread
+    // can be preempted in the middle of the first initialisation. That
+    // is how the gate's concurrent suites hit the race.
+    let stop = Arc::new(AtomicBool::new(false));
+    let cores = std::thread::available_parallelism().map_or(4, |n| n.get());
+    let spinners: Vec<_> = (0..cores)
+        .map(|_| {
+            let stop = Arc::clone(&stop);
+            std::thread::spawn(move || {
+                while !stop.load(Ordering::Relaxed) {
+                    std::hint::spin_loop();
+                }
+            })
+        })
+        .collect();
+    let mut crashed = Vec::new();
+    for wave in 0..CHILDREN / WAVE {
+        let children: Vec<_> = (0..WAVE)
+            .map(|_| {
+                Command::new(&exe)
+                    .args(["--exact", "first_worlds_on_many_threads_never_crash", "--test-threads=1", "-q"])
+                    .env(CHILD_ENV, "1")
+                    .stdout(Stdio::piped())
+                    .stderr(Stdio::piped())
+                    .spawn()
+                    .expect("spawn child")
+            })
+            .collect();
+        for (i, child) in children.into_iter().enumerate() {
+            let out = child.wait_with_output().expect("child output");
+            if !out.status.success() {
+                crashed.push(format!(
+                    "wave {wave} child {i}: {:?}\n{}{}",
+                    out.status,
+                    String::from_utf8_lossy(&out.stdout),
+                    String::from_utf8_lossy(&out.stderr)
+                ));
+            }
+        }
+    }
+    stop.store(true, Ordering::Relaxed);
+    for s in spinners {
+        s.join().expect("spinner thread panicked");
+    }
+    assert!(
+        crashed.is_empty(),
+        "{} of {CHILDREN} children crashed building their first worlds:\n{}",
+        crashed.len(),
+        crashed.join("\n")
+    );
+}
