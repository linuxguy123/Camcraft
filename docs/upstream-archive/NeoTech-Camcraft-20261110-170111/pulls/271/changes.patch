@@ -0,0 +1,136 @@
+//! #575 acceptance: a probe program reports the deviation it measured on
+//! the control before it writes the work offset, in the dialect's own
+//! non-stopping message, or writes nothing where the dialect has none.
+//! - Tormach PathPilot / LinuxCNC: one `(DEBUG, PROBE <axis> ERROR #19n
+//!   <unit>)` per probed axis, after that axis's tolerance test and before
+//!   the `G10 L20` (or the measure-only MSG/M0 stop); the unit word is
+//!   `IN` in a G20 program and `MM` in a G21 one.
+//! - Fanuc (custom macro B): no non-stopping display exists (#3000 alarms,
+//!   #3006 stops), so nothing is added before the `G10 L2`.
+//!
+//! Provenance: the LinuxCNC G-code reference ("Messages" / "Comments":
+//! DEBUG shows like MSG and substitutes #n), Fanuc's published custom
+//! macro B documentation (#3000 / #3006); our own fixtures.
+//!
+//! Gate map (M4.4): covers assets/posts (tormach + fanuc probe result),
+//! post::probe_rec, motion::probing.
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::machine::parse_mch;
+use camcraft_app::post::{self, cnc, engine, machine};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+
+const TORMACH: &str = include_str!("../../../assets/posts/tormach.cps");
+const FANUC: &str = include_str!("../../../assets/posts/fanuc.cps");
+const MX770: &str = include_str!("../../../assets/machines/tormach-770mx.mch");
+
+fn cycle(mode: ProbeMode, dir: ProbeDir, target: Point3, radius: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir,
+        dir_y: ProbeDir::YPos,
+        target,
+        radius,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+fn face() -> ProbeParams {
+    cycle(ProbeMode::Face, ProbeDir::ZNeg, Point3::new(10.0, 5.0, 20.0), 0.0)
+}
+fn corner() -> ProbeParams {
+    cycle(ProbeMode::Corner, ProbeDir::XPos, Point3::new(0.0, 0.0, 20.0), 0.0)
+}
+
+fn stream(p: &ProbeParams, set_wcs: Option<u8>) -> String {
+    let t = probe_cycle(p).expect("probe cycle");
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 99,
+        tool_name: "PROBE-4",
+        tool_diameter: 4.0,
+        rpm: 0.0,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        probe_result: Some(post::probe_rec::ProbeResult { set_wcs, tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    cnc::serialize(&post::dump(&t, &d))
+}
+
+fn tormach(p: &ProbeParams, set_wcs: Option<u8>) -> String {
+    let m = machine::mirror(&parse_mch(MX770).expect("770MX parses"));
+    engine::run(TORMACH, &m, &stream(p, set_wcs)).expect("post").program
+}
+
+/// A machine with no machine file posts in mm (G21).
+fn tormach_mm(p: &ProbeParams, set_wcs: Option<u8>) -> String {
+    engine::run(TORMACH, &serde_json::Value::Null, &stream(p, set_wcs)).expect("post").program
+}
+
+fn line_of(prog: &str, text: &str) -> usize {
+    prog.lines().position(|l| l == text).unwrap_or_else(|| panic!("no line {text:?}:\n{prog}"))
+}
+
+fn line_starting(prog: &str, prefix: &str) -> usize {
+    prog.lines().position(|l| l.starts_with(prefix)).unwrap_or_else(|| panic!("no line {prefix:?}..:\n{prog}"))
+}
+
+#[test]
+fn tormach_face_reports_z_after_its_tolerance_test_and_before_g10() {
+    let prog = tormach(&face(), Some(1));
+    assert!(prog.starts_with("(Tormach 770MX)\nG20 "), "the 770MX is an inch machine:\n{prog}");
+    let report = line_of(&prog, "(DEBUG, PROBE Z ERROR #190 IN)");
+    assert_eq!(prog.matches("(DEBUG,").count(), 1, "one report per probed axis:\n{prog}");
+    assert!(report > line_of(&prog, "(MSG, PROBE Z OUT OF TOLERANCE)"), "after the tolerance test:\n{prog}");
+    assert!(prog.contains("o901 endif\n(DEBUG, PROBE Z ERROR #190 IN)\nG10 L20 P2 Z[#5422-#190]\n"), "{prog}");
+}
+
+/// The report names the program's unit: a G21 program says MM, so the
+/// operator never reads a mm deviation as inches (or the other way round).
+#[test]
+fn tormach_mm_program_reports_in_mm() {
+    let prog = tormach_mm(&face(), Some(1));
+    assert!(prog.contains("\nG21 "), "a metric program:\n{prog}");
+    assert!(prog.contains("o901 endif\n(DEBUG, PROBE Z ERROR #190 MM)\nG10 L20 P2 Z[#5422-#190]\n"), "{prog}");
+    assert!(!prog.contains(" IN)"), "no inch word in a G21 program:\n{prog}");
+    let both = tormach_mm(&corner(), Some(0));
+    assert!(both.contains("(DEBUG, PROBE X ERROR #190 MM)\n"), "{both}");
+    assert!(both.contains("(DEBUG, PROBE Y ERROR #191 MM)\n"), "{both}");
+}
+
+#[test]
+fn tormach_corner_reports_each_axis_before_g10() {
+    let prog = tormach(&corner(), Some(0));
+    let g10 = line_starting(&prog, "G10 L20 ");
+    let x = line_of(&prog, "(DEBUG, PROBE X ERROR #190 IN)");
+    let y = line_of(&prog, "(DEBUG, PROBE Y ERROR #191 IN)");
+    assert!(x > line_of(&prog, "(MSG, PROBE X OUT OF TOLERANCE)") && x < g10, "{prog}");
+    assert!(y > line_of(&prog, "(MSG, PROBE Y OUT OF TOLERANCE)") && y < g10, "{prog}");
+    assert_eq!(prog.matches("(DEBUG,").count(), 2, "{prog}");
+}
+
+#[test]
+fn tormach_measure_only_reports_before_its_stop() {
+    let prog = tormach(&face(), None);
+    assert!(!prog.contains("G10"), "nothing is set:\n{prog}");
+    assert!(prog.contains("(DEBUG, PROBE Z ERROR #190 IN)\n(MSG, CHECK PROBE RESULT #190..)\nM0\n"), "{prog}");
+}
+
+#[test]
+fn fanuc_has_no_non_stopping_message_so_writes_no_report() {
+    let out = engine::run(FANUC, &serde_json::Value::Null, &stream(&corner(), Some(0))).expect("post");
+    let prog = out.program;
+    let g10 = line_starting(&prog, "G10 L2 ");
+    let y_test = line_starting(&prog, "IF[ABS[#191]GT");
+    assert_eq!(g10, y_test + 1, "the offset write follows the last tolerance test directly:\n{prog}");
+    assert!(!prog.contains("DEBUG") && !prog.contains("#3006"), "no report and no stop on a good probe:\n{prog}");
+}
diff --git a/crates/app/tests/probe_search.rs b/crates/app/tests/probe_search.rs
new file mode 100644
index 00000000..15649b70
--- /dev/null
+++ b/crates/app/tests/probe_search.rs
@@ -0,0 +1,108 @@
+//! #570, found on a real Tormach 770MX: a probe op searched 5 mm past the
+//! expected face by default (deep enough to bottom a stylus when the face
+//! is missing) and rapided down to the approach point over the part. Now:
+//! a new op searches `max(2 x tolerance, 1 mm)`, a search past 2 mm is
+//! named by a non-blocking advisory, and below the safe plane the probe
+//! only ever feeds.
+//!
+//! Gate map (#570): covers app::operation::probe_op (default_overtravel,
+//! search_advisory), app::operation::kinds (seed_probe), motion::probing
+//! (probe_cycle's opening).
+//! Provenance: touch-probe practice (protected positioning, rated stylus
+//! overtravel); our own fixtures.
+
+use camcraft_app::cl::MoveKind;
+use camcraft_app::operation::probe_op::{SEARCH_LIMIT_MM, default_overtravel, search_advisory};
+use camcraft_app::operation::{self, Height, HeightReference, OpParams, OpType};
+use camcraft_app::probing::{ProbeDir, ProbeMode, ProbeParams, probe_cycle};
+use camcraft_app::geometry::Point3;
+use camcraft_app::verify::Warning;
+
+fn params(mode: ProbeMode, overtravel: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir: ProbeDir::ZNeg,
+        dir_y: ProbeDir::YPos,
+        target: Point3::new(0.0, 0.0, 10.0),
+        radius: 10.0,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+#[test]
+fn a_new_probe_op_searches_a_short_way_past_the_face() {
+    assert_eq!(default_overtravel(0.5), 1.0);
+    assert_eq!(default_overtravel(0.1), 1.0, "never under 1 mm");
+    assert_eq!(default_overtravel(0.8), 1.6, "twice a looser tolerance");
+    // What the Create ribbon / Type combo seeds: a fresh Probe draft from
+    // an op whose own probe distance was the old 5 mm - the seed never
+    // carries it over.
+    let old = OpParams::Probe {
+        clearance_z: Height::of(HeightReference::TopOfStock, 15.0),
+        mode: ProbeMode::Face,
+        dir: ProbeDir::ZNeg,
+        dir_y: ProbeDir::YPos,
+        target: [0.0; 3],
+        radius: 10.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        set_wcs: Some(0),
+        tolerance: 0.5,
+    };
+    let seeded = operation::retype_params(&old, OpType::Probe.ordinal());
+    let OpParams::Probe { overtravel, tolerance, .. } = seeded else {
+        panic!("a probe seed: {seeded:?}");
+    };
+    assert_eq!(overtravel, default_overtravel(tolerance), "the seed follows its tolerance");
+    assert!(overtravel <= SEARCH_LIMIT_MM, "a new op draws no advisory");
+}
+
+#[test]
+fn a_deep_search_is_named_and_never_holds_the_post() {
+    let path = probe_cycle(&params(ProbeMode::Face, 5.0)).expect("cycle");
+    let w = search_advisory(&path, 5.0).expect("5 mm past the face is named");
+    assert!(matches!(w, Warning::ProbeSearch { mm, limit_mm, .. } if mm == 5.0 && limit_mm == SEARCH_LIMIT_MM));
+    assert!(!w.blocks_post(), "advisory: an old document still posts");
+    assert!(w.to_string().contains("probe distance 5.000 mm"), "{w}");
+    let short = probe_cycle(&params(ProbeMode::Face, SEARCH_LIMIT_MM)).expect("cycle");
+    assert_eq!(search_advisory(&short, SEARCH_LIMIT_MM), None, "at the limit: silent");
+}
+
+#[test]
+fn below_the_safe_plane_a_probe_only_feeds() {
+    for mode in [ProbeMode::Face, ProbeMode::Edge, ProbeMode::Corner, ProbeMode::Bore, ProbeMode::Boss] {
+        let mut p = params(mode, 1.0);
+        if mode != ProbeMode::Face {
+            p.dir = ProbeDir::XPos; // an edge or corner is touched along X / Y
+        }
+        let path = probe_cycle(&p).expect("cycle");
+        // The path states tips; the safe plane is a tip height.
+        let safe = p.clearance_z - 1e-9;
+        let first = path.moves.first().expect("a move");
+        assert_eq!(first.kind, MoveKind::Rapid, "{mode:?}: opens with the positioning rapid");
+        assert!(first.to.z >= safe, "{mode:?}: positioning ends at the safe plane, not {}", first.to.z);
+        for (i, m) in path.moves.iter().enumerate() {
+            if m.kind == MoveKind::Rapid {
+                assert!(
+                    m.from.z >= safe && m.to.z >= safe,
+                    "{mode:?}: move {i} rapids below the safe plane ({} -> {})",
+                    m.from.z,
+                    m.to.z
+                );
+            }
+        }
+    }
+}
diff --git a/crates/app/tests/probe_spindle_range.rs b/crates/app/tests/probe_spindle_range.rs
new file mode 100644
index 00000000..fa5e34b2
--- /dev/null
+++ b/crates/app/tests/probe_spindle_range.rs
@@ -0,0 +1,111 @@
+//! #565: the machine's spindle-range law judges the speed a program
+//! COMMANDS. A touch probe is never spun (the post commands rpm 0 for it,
+//! `posting::posted_rpm`), so its catalog rpm is not judged against the
+//! machine's spindle window - every probing program on a machine that
+//! states a spindle minimum (the Tormach 770MX: 175 rpm) was refused at
+//! post. Every cutter is still judged by its own rpm.
+//!
+//! Gate map (#565): covers app::machine (check_document spindle clause),
+//! app::posting (posted_rpm).
+//! Provenance: our own fixtures; the shipped Tormach 770MX machine file.
+
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, SetStock};
+use camcraft_app::machine::{check_document, parse_mch};
+use camcraft_app::operation::{Height, HeightReference, OpParams, SrcRef};
+use camcraft_app::probing::{ProbeDir, ProbeMode};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+use camcraft_app::{posting, tools};
+use flecs_ecs::prelude::World;
+
+const PROBE: &str = "PRB-0400";
+
+fn tormach_770mx() -> camcraft_app::machine::Machine {
+    let (_, text) = posting::MACHINES.iter().find(|(n, _)| *n == "Tormach 770MX").expect("shipped 770MX");
+    let m = parse_mch(text).expect("parses");
+    assert!(m.spindle_min.is_some_and(|lo| lo > 1.0), "the 770MX states a spindle minimum: {:?}", m.spindle_min);
+    m
+}
+
+fn add(world: &World, h: &mut History, name: &str) -> tools::Tool {
+    let t = catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog tool");
+    h.execute(world, AddTool::new(world, name, t.clone()).expect("add tool"));
+    t
+}
+
+/// A 50 x 50 x 25 block and one touch straight down on its top centre.
+fn probe_doc() -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    let stock = SetStock::new(&world, StockShape::Box { dx: 50.0, dy: 50.0, dz: 25.0 }, Default::default());
+    h.execute(&world, stock.expect("stock"));
+    let probe = add(&world, &mut h, PROBE);
+    assert!(probe.rpm < 175.0, "the catalog probe states a token rpm the post never commands: {}", probe.rpm);
+    let p = OpParams::Probe {
+        clearance_z: Height::of(HeightReference::TopOfStock, 25.0),
+        mode: ProbeMode::Face,
+        dir: ProbeDir::ZNeg,
+        dir_y: ProbeDir::YPos,
+        target: [0.0, 0.0, 25.0],
+        radius: 10.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        set_wcs: Some(0),
+        tolerance: 0.5,
+    };
+    h.execute(&world, CreateOperation::new(&world, "Probe1", PROBE, SrcRef::Stock, p).expect("probe op"));
+    h.execute(&world, GenerateOperation::new(&world, "Probe1").expect("generate"));
+    (world, h)
+}
+
+#[test]
+fn a_probe_program_passes_the_spindle_range_of_a_tormach() {
+    let (world, _h) = probe_doc();
+    let c = check_document(&world, &tormach_770mx()).expect("checks");
+    assert!(
+        !c.problems.iter().any(|p| p.contains("rpm")),
+        "a probe is never spun - its catalog rpm is not a spindle word: {:?}",
+        c.problems
+    );
+}
+
+#[test]
+fn a_probe_posts_no_speed_and_a_cutter_its_own() {
+    let probe = catalog().into_iter().find(|(n, _)| *n == PROBE).map(|(_, t)| t).expect("probe");
+    assert_eq!(posting::posted_rpm(&probe), 0.0);
+    let em = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("end mill");
+    assert_eq!(posting::posted_rpm(&em), em.rpm);
+}
+
+#[test]
+fn a_cutter_below_the_minimum_is_still_refused_beside_a_probe() {
+    let (world, mut h) = probe_doc();
+    let mut em = add(&world, &mut h, "EM-0400-2FL");
+    em.rpm = 100.0; // under the 770MX's 175
+    h.execute(&world, camcraft_app::commands::ChangeTool::new(&world, "EM-0400-2FL", em).expect("slow cutter"));
+    let face = OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        stepover: 3.0,
+        clearance_z: Height::of(HeightReference::TopOfStock, 25.0),
+        cut_z: Height::of(HeightReference::TopOfStock, 0.0),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+        blend_turns: false,
+    };
+    h.execute(&world, CreateOperation::new(&world, "Face1", "EM-0400-2FL", SrcRef::Stock, face).expect("face"));
+    h.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    let c = check_document(&world, &tormach_770mx()).expect("checks");
+    let rpm: Vec<&String> = c.problems.iter().filter(|p| p.contains("rpm")).collect();
+    assert_eq!(rpm.len(), 1, "only the cutter is judged: {:?}", c.problems);
+    assert!(rpm[0].starts_with("Face1:") && rpm[0].contains("below the machine's 175"), "{rpm:?}");
+}
diff --git a/crates/app/tests/probe_tormach.rs b/crates/app/tests/probe_tormach.rs
new file mode 100644
index 00000000..e563197a
--- /dev/null
+++ b/crates/app/tests/probe_tormach.rs
@@ -0,0 +1,195 @@
+//! #362 acceptance: the probing hooks of the Tormach PathPilot post. Every
+//! probe mode the generic dialect covers (face, edge, outside corner, bore,
+//! boss; tests/probe_op.rs) posts through the whole post seam (dump ->
+//! stream text -> engine -> tormach.cps) as LinuxCNC words: G38.2 touches
+//! (the control alarms on no contact), trips read from #5061-#5063, an
+//! incremental back-off, an O-word `if` tolerance test that ends the
+//! program, and the work offset set with G10 L20 from the current position.
+//!
+//! Provenance: the LinuxCNC G-code reference (G38.n, G10 L20, numbered
+//! parameters #5061-#5070 / #5420-#5428, O-code conditionals, (MSG,...))
+//! and Tormach's PathPilot post-processor guidelines; our own fixtures.
+//!
+//! Gate map (M4.4): covers assets/posts (tormach probing), post::probe_rec,
+//! motion::probing, post::machine (the 770MX's inch units and coolant).
+
+mod common;
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::machine::parse_mch;
+use camcraft_app::post::{self, cnc, engine, machine};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+
+const TORMACH: &str = include_str!("../../../assets/posts/tormach.cps");
+const MX770: &str = include_str!("../../../assets/machines/tormach-770mx.mch");
+
+/// The 770MX as the app hands it to a post (parser, then mirror): an
+/// inch machine with a flood coolant entry.
+fn mx770() -> serde_json::Value {
+    machine::mirror(&parse_mch(MX770).expect("770MX parses"))
+}
+
+fn cycle(mode: ProbeMode, dir: ProbeDir, target: Point3, radius: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir,
+        dir_y: ProbeDir::YPos,
+        target,
+        radius,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+/// The five modes of tests/probe_op.rs `each_mode_lays_down_its_touches`.
+fn mode(name: &str) -> ProbeParams {
+    match name {
+        "face" => cycle(ProbeMode::Face, ProbeDir::ZNeg, Point3::new(10.0, 5.0, 20.0), 0.0),
+        "edge" => cycle(ProbeMode::Edge, ProbeDir::XPos, Point3::new(0.0, 5.0, 20.0), 0.0),
+        "corner" => cycle(ProbeMode::Corner, ProbeDir::XPos, Point3::new(0.0, 0.0, 20.0), 0.0),
+        "boss" => cycle(ProbeMode::Boss, ProbeDir::ZNeg, Point3::new(30.0, 30.0, 20.0), 10.0),
+        _ => cycle(ProbeMode::Bore, ProbeDir::ZNeg, Point3::new(30.0, 30.0, 20.0), 10.0),
+    }
+}
+
+fn stream(p: &ProbeParams, set_wcs: Option<u8>) -> String {
+    let t = probe_cycle(p).expect("probe cycle");
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 99, // PathPilot's conventional probe tool number
+        tool_name: "PROBE-4",
+        tool_diameter: 4.0,
+        rpm: 0.0,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        probe_result: Some(post::probe_rec::ProbeResult { set_wcs, tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    let recs = post::dump(&t, &d);
+    assert!(!recs.iter().any(|r| matches!(r, cnc::Record::Warn { .. })), "a sane probe path carries no WARN");
+    cnc::serialize(&recs)
+}
+
+fn post_ok(machine: &serde_json::Value, stream: &str) -> String {
+    let out = engine::run(TORMACH, machine, stream).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let prog = out.program;
+    assert!(
+        !prog.lines().any(|l| l.split_whitespace().any(|w| w == "M3" || w == "M8" || w.starts_with('S'))),
+        "a touch probe starts no spindle and no coolant:\n{prog}"
+    );
+    assert!(!prog.contains("G31"), "PathPilot probes with G38.x, not G31:\n{prog}");
+    prog
+}
+
+/// Each O-word test opens and closes under one number, used by no other.
+fn o_blocks_pair_uniquely(prog: &str) {
+    let ifs: Vec<&str> = prog.lines().filter(|l| l.contains(" if [")).map(|l| l.split(' ').next().unwrap_or("")).collect();
+    let ends: Vec<&str> = prog.lines().filter(|l| l.ends_with(" endif")).map(|l| l.split(' ').next().unwrap_or("")).collect();
+    assert_eq!(ifs, ends, "every if has its endif:\n{prog}");
+    let mut uniq = ifs.clone();
+    uniq.sort_unstable();
+    uniq.dedup();
+    assert_eq!(uniq.len(), ifs.len(), "unique O numbers: {ifs:?}");
+}
+
+fn count(prog: &str, prefix: &str) -> usize {
+    prog.lines().filter(|l| l.starts_with(prefix)).count()
+}
+
+#[test]
+fn face_posts_g38_2_and_sets_z_on_the_770mx() {
+    let prog = post_ok(&mx770(), &stream(&mode("face"), Some(1)));
+    assert!(prog.starts_with("(Tormach 770MX)\nG20 "), "an inch machine posts G20:\n{prog}");
+    assert_eq!(count(&prog, "G38.2 "), 2, "a seek and a measure");
+    assert!(prog.contains("#100=#5061\n#101=#5062\n#102=#5063\n"), "the measured trip is kept");
+    assert!(prog.contains("G91 G1 X0 Y0 Z0.0394 F11.81\nG90\n"), "the back-off is incremental, in inches:\n{prog}");
+    assert!(prog.contains("#190=[#102-0.7874]\no901 if [ABS[#190] GT 0.0197]\n(MSG, PROBE Z OUT OF TOLERANCE)\nM2\no901 endif\n"), "{prog}");
+    assert!(prog.contains("G10 L20 P2 Z[#5422-#190]"), "the result sets G55 Z: {prog}");
+    o_blocks_pair_uniquely(&prog);
+    assignments_are_bracketed(&prog);
+    common::write_golden("nc/tormach/probe_face.nc", &prog);
+}
+
+#[test]
+fn edge_posts_g38_2_and_sets_x_on_the_770mx() {
+    let prog = post_ok(&mx770(), &stream(&mode("edge"), Some(1)));
+    assert_eq!(count(&prog, "G38.2 "), 2, "a seek and a measure");
+    assert!(prog.contains("G10 L20 P2 X[#5420-#190]\n"), "the result sets G55 X: {prog}");
+    o_blocks_pair_uniquely(&prog);
+    assignments_are_bracketed(&prog);
+    common::write_golden("nc/tormach/probe_edge.nc", &prog);
+}
+
+#[test]
+fn corner_posts_g38_2_and_sets_x_and_y_on_the_770mx() {
+    let prog = post_ok(&mx770(), &stream(&mode("corner"), Some(1)));
+    assert_eq!(count(&prog, "G38.2 "), 4, "two touches, seek + measure");
+    assert!(prog.contains("G10 L20 P2 X[#5420-#190] Y[#5421-#191]\n"), "{prog}");
+    assert_eq!(prog.lines().filter(|l| l.ends_with(" OUT OF TOLERANCE)")).count(), 2, "one tolerance test per axis");
+    o_blocks_pair_uniquely(&prog);
+    assignments_are_bracketed(&prog);
+    common::write_golden("nc/tormach/probe_corner.nc", &prog);
+}
+
+#[test]
+fn bore_posts_g38_2_and_sets_the_centre_on_the_770mx() {
+    let prog = post_ok(&mx770(), &stream(&mode("bore"), Some(1)));
+    assert_eq!(count(&prog, "G38.2 "), 8, "four touches, seek + measure");
+    assert!(prog.contains("#190=[[[#100+#103]/2]-1.1811]\n"), "the centre is the mean of opposite trips: {prog}");
+    assert!(prog.contains("G10 L20 P2 X[#5420-#190] Y[#5421-#191]\n"), "{prog}");
+    o_blocks_pair_uniquely(&prog);
+    assignments_are_bracketed(&prog);
+    common::write_golden("nc/tormach/probe_bore_centre.nc", &prog);
+}
+
+#[test]
+fn boss_posts_g38_2_and_sets_the_centre_on_the_770mx() {
+    let prog = post_ok(&mx770(), &stream(&mode("boss"), Some(1)));
+    assert_eq!(count(&prog, "G38.2 "), 8, "four touches, seek + measure");
+    assert!(prog.contains("G10 L20 P2 X[#5420-#190] Y[#5421-#191]\n"), "{prog}");
+    o_blocks_pair_uniquely(&prog);
+    assignments_are_bracketed(&prog);
+    common::write_golden("nc/tormach/probe_boss_centre.nc", &prog);
+}
+
+/// A metric machine posts the same program in mm (the bore centre of
+/// nc/fanuc/probe_bore_centre.nc, word for word in the LinuxCNC dialect).
+#[test]
+fn bore_posts_in_mm_on_a_metric_machine() {
+    let prog = post_ok(&serde_json::Value::Null, &stream(&mode("bore"), Some(1)));
+    assert!(prog.contains("\nG21 "), "{prog}");
+    assert!(prog.contains("G38.2 X43 Y30 Z15 F300\n"), "{prog}");
+    assert!(prog.contains("G91 G1 X-1 Y0 Z0 F300\nG90\n"), "{prog}");
+    assert!(prog.contains("o901 if [ABS[#190] GT 0.5]\n"), "{prog}");
+    assert!(prog.contains("G10 L20 P2 X[#5420-#190] Y[#5421-#191]\n"), "{prog}");
+    assignments_are_bracketed(&prog);
+    common::write_golden("nc/tormach/probe_bore_centre_mm.nc", &prog);
+}
+
+#[test]
+fn without_an_offset_to_set_it_stops_for_the_operator() {
+    let prog = post_ok(&mx770(), &stream(&mode("bore"), None));
+    assert!(!prog.contains("G10"), "nothing is set");
+    assert!(prog.contains("(MSG, CHECK PROBE RESULT #190..)\nM0\n"), "{prog}");
+}
+
+/// LinuxCNC evaluates arithmetic only inside brackets: a parameter
+/// assignment is `#n=#m` or `#n=[expr]`, never a bare `#n=#m-0.7874`
+/// (PathPilot Hub 2.14.4 refused that with "Bad character '-' used"),
+/// and no `--` / `+-` is ever written.
+fn assignments_are_bracketed(prog: &str) {
+    for l in prog.lines().filter(|l| l.starts_with('#')) {
+        let Some((_, rhs)) = l.split_once('=') else { panic!("an assignment without '=': {l}") };
+        let plain = rhs.starts_with('#') && rhs[1..].chars().all(|c| c.is_ascii_digit());
+        assert!(plain || (rhs.starts_with('[') && rhs.ends_with(']')), "unbracketed expression: {l}");
+        assert!(!rhs.contains("--") && !rhs.contains("+-"), "a doubled sign: {l}");
+    }
+}
diff --git a/crates/app/tests/program_comments.rs b/crates/app/tests/program_comments.rs
new file mode 100644
index 00000000..53801804
--- /dev/null
+++ b/crates/app/tests/program_comments.rs
@@ -0,0 +1,327 @@
+//! #257: a posted program says what it is - the setup, each operation
+//! (name, kind, work offset) and each tool (number, name, kind, size) -
+//! in every dialect's own comment syntax, with the user's text cleaned
+//! of anything that would end the comment early or read as a word. Only
+//! comment lines are added: the conformance goldens (legacy streams,
+//! no PARAMs) post byte-identical, which `conformance.rs` locks.
+//! Provenance: our own fixtures; comment forms from RS-274 / ISO 6983
+//! `( )`, DIN 66025 `;`, and the TNC ISO manual's numbered blocks.
+//!
+//! Gate map (#257): covers app::post (the seven assets/posts/*.cps
+//! comment helpers, post::dump's commentary PARAMs), app::posting
+//! (op_streams' op kind / setup / tool kind context).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use camcraft_app::cl::{Move, MoveKind, Toolpath};
+use camcraft_app::commands::{
+    AddTool, CreateOperation, CreateSetup, GenerateOperation, History, SetStock,
+};
+use camcraft_app::geometry::Point3;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::post::{Dump, cnc, dump, engine};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+use std::path::Path;
+
+fn read(rel: &str) -> String {
+    let p = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../")
+        .join(rel);
+    std::fs::read_to_string(&p).unwrap_or_else(|e| panic!("{rel}: {e}"))
+}
+
+fn mill() -> serde_json::Value {
+    serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("machine json")
+}
+
+/// A short contour pass: enough motion for every preamble to open.
+fn path() -> Toolpath {
+    let p = |x, y, z| Point3 { x, y, z };
+    Toolpath::new(vec![
+        Move::new(MoveKind::Rapid, p(0.0, 0.0, 10.0), p(5.0, 5.0, 10.0), None),
+        Move::new(
+            MoveKind::Plunge,
+            p(5.0, 5.0, 10.0),
+            p(5.0, 5.0, -1.0),
+            Some(200.0),
+        ),
+        Move::new(
+            MoveKind::Feed,
+            p(5.0, 5.0, -1.0),
+            p(25.0, 5.0, -1.0),
+            Some(800.0),
+        ),
+        Move::new(
+            MoveKind::Rapid,
+            p(25.0, 5.0, -1.0),
+            p(25.0, 5.0, 10.0),
+            None,
+        ),
+    ])
+}
+
+fn post(stem: &str, op_name: &str, tool_name: &str, setup: &str) -> String {
+    let d = Dump {
+        op_name,
+        op_kind: "2D Contour",
+        setup_name: setup,
+        tool_number: 3,
+        tool_name,
+        tool_kind: "bull-nose",
+        tool_diameter: 6.0,
+        tool_corner_r: 0.5,
+        rpm: 8000.0,
+        clearance_z: 10.0,
+        retract_z: 5.0,
+        ..Default::default()
+    };
+    // Two sections of one setup: the second restates its operation and
+    // tool, never the setup.
+    let mut records = dump(&path(), &d);
+    records.extend(dump(&path(), &d));
+    let stream = cnc::serialize(&records);
+    let out = engine::run(&read(&format!("assets/posts/{stem}.cps")), &mill(), &stream)
+        .unwrap_or_else(|e| panic!("{stem}: must post: {e}"));
+    assert!(out.warnings.is_empty(), "{stem}: {:?}", out.warnings);
+    out.program
+}
+
+/// Each mill dialect: its setup, operation and tool comment lines, in
+/// order, and the motion word the tool comment must sit just above.
+const MILL: &[(&str, [&str; 3], &str)] = &[
+    (
+        "fanuc",
+        [
+            "(SETUP: Setup1)",
+            "(OPERATION: Contour1 - 2D CONTOUR - G54)",
+            "(T03 EM-0600 - BULL-NOSE D6 R0.5)",
+        ],
+        "T03 M6",
+    ),
+    (
+        "haas",
+        [
+            "(SETUP: Setup1)",
+            "(OPERATION: Contour1 - 2D CONTOUR - G54)",
+            "(T3 EM-0600 - BULL-NOSE D6 R0.5)",
+        ],
+        "T3 M6",
+    ),
+    (
+        "mazak",
+        [
+            "(SETUP: Setup1)",
+            "(OPERATION: Contour1 - 2D CONTOUR - G54)",
+            "(T3 EM-0600 - BULL-NOSE D6 R0.5)",
+        ],
+        "T3 M6",
+    ),
+    (
+        "tormach",
+        [
+            "(SETUP: Setup1)",
+            "(OPERATION: Contour1 - 2D CONTOUR - G54)",
+            "(T3 EM-0600 - BULL-NOSE D6 R0.5)",
+        ],
+        "T3 M6",
+    ),
+    (
+        "sinumerik",
+        [
+            "; SETUP: Setup1",
+            "; OPERATION: Contour1 - 2D CONTOUR - G54",
+            "; T3 EM-0600 - BULL-NOSE D6 R0.5",
+        ],
+        "T3 D3 M6",
+    ),
+    (
+        "heidenhain",
+        [
+            "; SETUP: Setup1*",
+            "; OPERATION: Contour1 - 2D CONTOUR*",
+            "; T3 EM-0600 - BULL-NOSE D6 R0.5*",
+        ],
+        "T3 G17 S8000*",
+    ),
+];
+
+/// A line's text with the dialect's block number stripped (`N20 `).
+fn body(line: &str) -> &str {
+    match line.strip_prefix('N').and_then(|r| r.split_once(' ')) {
+        Some((n, rest)) if n.chars().all(|c| c.is_ascii_digit()) => rest,
+        _ => line,
+    }
+}
+
+#[test]
+fn every_mill_dialect_comments_the_setup_operation_and_tool_in_its_own_syntax() {
+    for (stem, notes, tool_call) in MILL {
+        let nc = post(stem, "Contour1", "EM-0600", "Setup1");
+        let lines: Vec<&str> = nc.lines().map(body).collect();
+        let at = |s: &str| {
+            lines
+                .iter()
+                .position(|l| *l == s)
+                .unwrap_or_else(|| panic!("{stem}: no {s:?} in\n{nc}"))
+        };
+        let (s, o, t) = (at(notes[0]), at(notes[1]), at(notes[2]));
+        assert!(
+            s < o && o < t,
+            "{stem}: setup, then operation, then tool:\n{nc}"
+        );
+        // The note leads its tool-change sequence (Tormach's Z-up and G30
+        // run first, then the call).
+        assert!(
+            lines.iter().skip(t + 1).take(3).any(|l| l == tool_call),
+            "{stem}: the tool comment leads its tool call:\n{nc}"
+        );
+        let count = |s: &str| lines.iter().filter(|l| **l == s).count();
+        assert_eq!(
+            [count(notes[0]), count(notes[1]), count(notes[2])],
+            [1, 2, 2],
+            "{stem}: the setup once, the rest per section:\n{nc}"
+        );
+    }
+}
+
+#[test]
+fn user_text_never_breaks_a_comment() {
+    let op = "Pocket (rough); 50% \u{e9}t\u{e9} and a very long name that goes on and on";
+    let tool = "EM(6)*;%";
+    for (stem, _, _) in MILL {
+        let nc = post(stem, op, tool, "Set(up);1");
+        for l in nc
+            .lines()
+            .filter(|l| l.contains("SETUP:") || l.contains("OPERATION:") || l.contains("EM 6"))
+        {
+            assert!(l.is_ascii(), "{stem}: {l:?}");
+            let b = body(l);
+            match *stem {
+                "sinumerik" => {
+                    assert!(
+                        b.starts_with("; ") && b.matches(';').count() == 1,
+                        "{stem}: {l:?}"
+                    );
+                    assert!(
+                        !b.contains('(') && !b.contains(')') && !b.contains('%'),
+                        "{stem}: {l:?}"
+                    );
+                }
+                "heidenhain" => {
+                    assert!(b.starts_with("; ") && b.ends_with('*'), "{stem}: {l:?}");
+                    assert!(
+                        b.matches(';').count() == 1 && b.matches('*').count() == 1,
+                        "{stem}: {l:?}"
+                    );
+                    assert!(
+                        !b.contains('(') && !b.contains(')') && !b.contains('%'),
+                        "{stem}: {l:?}"
+                    );
+                }
+                _ => {
+                    assert!(b.starts_with('(') && b.ends_with(')'), "{stem}: {l:?}");
+                    assert!(
+                        b.matches('(').count() == 1 && b.matches(')').count() == 1,
+                        "{stem}: nested parens {l:?}"
+                    );
+                    assert!(!b.contains(';') && !b.contains('%'), "{stem}: {l:?}");
+                }
+            }
+        }
+        // Capped: the operation's name is cut at 40 characters.
+        assert!(
+            nc.contains("OPERATION: Pocket rough 50 ?t? and a very long name"),
+            "{stem}:\n{nc}"
+        );
+        assert!(
+            !nc.contains("goes on and on"),
+            "{stem}: the cap holds:\n{nc}"
+        );
+    }
+}
+
+#[test]
+fn a_stream_without_the_commentary_params_writes_no_comment() {
+    // A legacy .cl carries no PARAM and no TOOL: its program is the
+    // same bytes it always was (the conformance goldens lock the rest).
+    let stream = read("crates/app/tests/golden/contour_disc_hole.cl");
+    for (stem, _, _) in MILL {
+        let out = engine::run(&read(&format!("assets/posts/{stem}.cps")), &mill(), &stream)
+            .expect("posts");
+        for word in ["SETUP:", "OPERATION:", "BULL-NOSE"] {
+            assert!(
+                !out.program.contains(word),
+                "{stem}: {word} from nowhere:\n{}",
+                out.program
+            );
+        }
+    }
+}
+
+#[test]
+fn a_document_posts_its_setup_operation_kind_and_tool_kind() {
+    const TOOL: &str = "EM-0400-2FL";
+    let world = new_world();
+    let mut h = History::default();
+    let stock = SetStock::new(
+        &world,
+        StockShape::Box {
+            dx: 60.0,
+            dy: 60.0,
+            dz: 20.0,
+        },
+        Default::default(),
+    );
+    h.execute(&world, stock.expect("box stock"));
+    let tool = catalog()
+        .into_iter()
+        .find(|(n, _)| *n == TOOL)
+        .map(|(_, t)| t)
+        .expect("tool");
+    h.execute(&world, AddTool::new(&world, TOOL, tool).expect("add tool"));
+    h.execute(
+        &world,
+        CreateSetup::new(&world, None, None).expect("materialize Setup1"),
+    );
+    let face = OpParams::Face {
+        holes: Default::default(),
+        blend_turns: false,
+        tilt: None,
+        stepover: 3.0,
+        clearance_z: Height::fixed(25.0),
+        cut_z: Height::fixed(19.5),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    };
+    h.execute(
+        &world,
+        CreateOperation::new(&world, "Face1", TOOL, SrcRef::Stock, face).expect("create"),
+    );
+    h.execute(
+        &world,
+        GenerateOperation::new(&world, "Face1").expect("generate"),
+    );
+    let streams = camcraft_app::posting::op_streams(&world).expect("streams");
+    let records: Vec<cnc::Record> = streams.into_iter().flat_map(|(_, r)| r).collect();
+    let out = engine::run(
+        &read("assets/posts/fanuc.cps"),
+        &mill(),
+        &cnc::serialize(&records),
+    )
+    .expect("posts");
+    for want in [
+        "(SETUP: Setup1)",
+        "(OPERATION: Face1 - FACE - G54)",
+        "(T01 EM-0400-2FL - FLAT END MILL D4)",
+    ] {
+        assert!(
+            out.program.lines().any(|l| l == want),
+            "no {want:?} in\n{}",
+            out.program
+        );
+    }
+}
diff --git a/crates/app/tests/program_entry.rs b/crates/app/tests/program_entry.rs
new file mode 100644
index 00000000..5edf4c67
--- /dev/null
+++ b/crates/app/tests/program_entry.rs
@@ -0,0 +1,398 @@
+//! Standalone Pause and Home entries in the operation list (#155): add,
+//! reorder, delete and undo; the words the post writes for them (the
+//! per-op after-action's own); Suppress and "Skip pauses and homes";
+//! the project file; and the program walks that must not see them.
+//!
+//! Gate map (M4.4): covers app::program_entry, app::commands
+//! (AddProgramEntry, EditProgramEntry, ReorderOperation, DeleteEntity,
+//! CreateOperation, DeleteSetup), app::posting (op_streams,
+//! stream_records), app::project (program_entry_dto), app::model
+//! (is_model), assets/posts/fanuc.cps, haas.cps, mazak.cps, sinumerik.cps,
+//! fanuc-lathe.cps, tormach.cps.
+
+mod common;
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    AddProgramEntry, AddTool, CreateOperation, DeleteEntity, EditOperationParams, EditProgramEntry,
+    GenerateOperation, History, ReorderOperation, SetPostOptions, SetStock,
+};
+use camcraft_app::model;
+use camcraft_app::operation::{self, AfterOperation, Height, OpParams, SrcRef};
+use camcraft_app::post::{self, cnc};
+use camcraft_app::posting;
+use camcraft_app::program_entry;
+use camcraft_app::schema::PostOptions;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+
+fn face_params(cut_z: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        blend_turns: false,
+        tilt: None,
+        stepover: 3.0,
+        clearance_z: Height::fixed(25.0),
+        cut_z: Height::fixed(cut_z),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+/// Two generated face ops on two tools, nothing between them.
+fn two_faces() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    let stock = SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Default::default());
+    history.execute(&world, stock.expect("box stock"));
+    for t in ["EM-0400-2FL", "EM-0600-4FL"] {
+        let tool = catalog().into_iter().find(|(n, _)| *n == t).map(|(_, t)| t).expect("catalog entry");
+        history.execute(&world, AddTool::new(&world, t, tool).expect("catalog tool"));
+    }
+    for (name, tool, z) in [("Face1", "EM-0400-2FL", 19.5), ("Face2", "EM-0600-4FL", 19.0)] {
+        let cmd = CreateOperation::new(&world, name, tool, SrcRef::Stock, face_params(z));
+        history.execute(&world, cmd.expect("create"));
+        history.execute(&world, GenerateOperation::new(&world, name).expect("generate"));
+    }
+    (world, history)
+}
+
+fn add(world: &World, history: &mut History, action: AfterOperation, after: Option<&str>) -> String {
+    let cmd = AddProgramEntry::new(world, action, after).expect("add entry");
+    let name = cmd.name().to_owned();
+    history.execute(world, cmd);
+    name
+}
+
+fn list(world: &World) -> Vec<String> {
+    program_entry::sequence(world).into_iter().map(|(n, _)| n).collect()
+}
+
+fn ops(world: &World) -> Vec<String> {
+    camcraft_app::setup::operation_order(world).into_iter().map(|(n, _)| n).collect()
+}
+
+fn stream(world: &World) -> String {
+    cnc::serialize(&posting::stream_records(world).expect("a fresh world streams"))
+}
+
+fn script(name: &str) -> &'static str {
+    posting::BUILTINS.iter().find(|(n, _)| *n == name).map(|(_, s)| *s).expect("a built-in")
+}
+
+fn post_with(world: &World, name: &str) -> post::PostOutput {
+    post::post(script(name), &posting::machine_value(world), &stream(world)).expect("the script runs")
+}
+
+fn has_word(line: &str, code: &str) -> bool {
+    line.split_whitespace().any(|w| w.trim_end_matches('*') == code)
+}
+
+#[test]
+fn an_entry_is_added_reordered_deleted_and_undone() {
+    let (world, mut h) = two_faces();
+    let pause = add(&world, &mut h, AfterOperation::ProgramStop, Some("Face1"));
+    assert_eq!(pause, "Pause1");
+    assert_eq!(list(&world), ["Face1", "Pause1", "Face2"], "inserted after the row it was asked of");
+    assert_eq!(ops(&world), ["Face1", "Face2"], "the op walk never sees an entry");
+    let home = add(&world, &mut h, AfterOperation::GoHome, None);
+    assert_eq!(home, "Home1");
+    assert_eq!(list(&world), ["Face1", "Pause1", "Face2", "Home1"], "no row: the setup's end");
+
+    // Reordered like an op, by the op's own command.
+    h.execute(&world, ReorderOperation::new(&world, "Pause1", "Home1", true).expect("reorder"));
+    assert_eq!(list(&world), ["Face1", "Face2", "Home1", "Pause1"]);
+    h.undo(&world);
+    assert_eq!(list(&world), ["Face1", "Pause1", "Face2", "Home1"], "undo puts it back");
+    // An op dragged past an entry keeps every other row in place.
+    h.execute(&world, ReorderOperation::new(&world, "Face2", "Face1", false).expect("reorder"));
+    assert_eq!(list(&world), ["Face2", "Face1", "Pause1", "Home1"]);
+    h.undo(&world);
+
+    // Deleted by the generic delete (Del and the menu), undone whole.
+    h.execute(&world, DeleteEntity::new(&world, "Pause1").expect("delete"));
+    assert_eq!(list(&world), ["Face1", "Face2", "Home1"]);
+    h.undo(&world);
+    assert_eq!(list(&world), ["Face1", "Pause1", "Face2", "Home1"], "undo restores the entry at its place");
+    let e = model::find_by_name(&world, "Pause1").expect("restored");
+    assert_eq!(program_entry::entry_of(&world, &e).map(|x| x.action), Some(AfterOperation::ProgramStop));
+
+    // Undoing the adds removes them and restores the old positions.
+    h.undo(&world);
+    h.undo(&world);
+    assert_eq!(list(&world), ["Face1", "Face2"]);
+    h.redo(&world);
+    assert_eq!(list(&world), ["Face1", "Pause1", "Face2"], "redo reapplies");
+
+    // A new op lands after the entries, never on one's position.
+    let cmd = CreateOperation::new(&world, "Face3", "EM-0400-2FL", SrcRef::Stock, face_params(18.5));
+    h.execute(&world, cmd.expect("create"));
+    assert_eq!(list(&world), ["Face1", "Pause1", "Face2", "Face3"]);
+
+    // Refusals by name.
+    assert!(AddProgramEntry::new(&world, AfterOperation::None, None).is_err(), "continue is no entry");
+    assert!(AddProgramEntry::new(&world, AfterOperation::GoHome, Some("Nope")).is_err());
+    assert!(!model::model_entities(&world).iter().any(|(n, _)| n == "Pause1"), "an entry is not a model");
+}
+
+#[test]
+fn an_entry_posts_the_per_op_words_and_changes_no_op() {
+    for action in [AfterOperation::OptionalStop, AfterOperation::ProgramStop, AfterOperation::GoHome] {
+        let (per_op, mut h1) = two_faces();
+        h1.execute(&per_op, EditOperationParams::with_after(&per_op, "Face1", action).expect("after"));
+        let (entry, mut h2) = two_faces();
+        add(&entry, &mut h2, action, Some("Face1"));
