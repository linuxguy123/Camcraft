diff --git a/crates/tools/src/orientation.rs b/crates/tools/src/orientation.rs
new file mode 100644
index 00000000..44de713d
--- /dev/null
+++ b/crates/tools/src/orientation.rs
@@ -0,0 +1,268 @@
+//! Lathe tool orientation (#630): where a nose-radiused insert's
+//! CONTROL POINT stands relative to its nose circle's centre, numbered
+//! 1-9 the way the LinuxCNC tool table numbers it.
+//!
+//! The control point is the point a control drives along the
+//! programmed path when nose compensation is off (G40): the
+//! intersection of the X-parallel and Z-parallel lines tangent to the
+//! nose circle - the "imaginary tip" the operator touches the tool off
+//! on (LinuxCNC Lathe User Information, section 7.1 "Control point",
+//! and its section 3 "Lathe Tool Orientation" figure). Read off that
+//! figure, in the control's own X (radius) and Z coordinates, the tip
+//! stands at `centre + r * tip_offset(q)`:
+//!
+//! | q | tip offset (X, Z) | the tool, read in program words |
+//! |---|---|---|
+//! | 1 | (-1, +1) | OD side, cutting away from the chuck (+Z) |
+//! | 2 | (-1, -1) | OD side, cutting toward the chuck (-Z): a right-hand turning tool |
+//! | 3 | (+1, -1) | ID side, cutting toward the chuck: a boring bar |
+//! | 4 | (+1, +1) | ID side, cutting away from the chuck |
+//! | 5 | ( 0, +1) | pointing +Z (X is read at the nose centre) |
+//! | 6 | (-1,  0) | pointing -X, neutral (Z is read at the nose centre) |
+//! | 7 | ( 0, -1) | pointing -Z |
+//! | 8 | (+1,  0) | pointing +X |
+//! | 9 | ( 0,  0) | the nose centre itself (touched off on the centre) |
+//!
+//! The numbering is stated in X/Z coordinates, so it does not change
+//! with the turret side: the figure is drawn for a front tool post
+//! (X+ toward the operator) and a rear turret reads the same numbers
+//! with its own X+. Fanuc-style "imaginary tool nose" tip numbers are
+//! a different chart (the usual OD tool is tip 3 there); no post of
+//! ours writes either number to the control - they post G40 and the
+//! control point itself - so the LinuxCNC numbering is the one the
+//! user edits and the PathPilot tool table checks against.
+//!
+//! What an orientation can cut: an insert presents its cutting nose
+//! arc around its tip direction. A corner orientation (1-4) cuts with
+//! the quarter of the nose between its two tangent lines - a contact
+//! normal within 45 degrees of the tip direction; an axis orientation
+//! (5-8) presents the half of the nose facing its point - within 90
+//! degrees; 9 says nothing about the insert and refuses nothing. This
+//! is the reading under which PathPilot's conversational refusal
+//! ("the X and Z inputs call for orientation [1, 5, 6]") is
+//! reproduced for a cut needing the -X and +Z contacts.
+//!
+//! Blades (#641): a grooving/parting blade has no nose circle - its
+//! CL is the middle of its tip edge (the band's centre at the tip
+//! line), and the operator touches it off on one CORNER of that edge
+//! (LinuxCNC Lathe User Information section 4.2 works its parting-tool
+//! example from the left side). The same chart names the corner: the
+//! blade plunges toward the axis, so its tip is on the -X side and
+//! only the Z sign is left to say -
+//!
+//! | q | the blade's control point |
+//! |---|---|
+//! | 1 | the +Z corner of the tip edge (right, toward the free end) |
+//! | 2 | the -Z corner (left, toward the chuck) - the default |
+//! | 6 | the middle of the tip edge (touched off on the width centre) |
+//! | 9 | read as 6 (a blade states no nose circle to centre on) |
+//!
+//! Every other code states an ID or a face blade, which no OD groove or
+//! part-off rides: [`blade_corner`] says None and the post refuses it by
+//! name. A radiused corner changes nothing: the imaginary tip of a
+//! rounded corner is where its tip line and flank line meet - the
+//! sharp rectangle's corner, `width / 2` from the edge's middle.
+//!
+//! Provenance: LinuxCNC Lathe User Information (public docs, sections
+//! 3, 4.1, 4.2 and 7.1) for the numbering and the control point; machine-
+//! tool handbook practice for nose-radius compensation. Behaviour
+//! only - no vendor text or post consulted.
+
+use crate::tools::ToolKind;
+
+/// The tool table's centre code: the control point IS the nose centre.
+pub const CENTRE: u8 = 9;
+
+/// A contact normal the cut needs the insert's nose to present, in the
+/// control's X (radius, + away from the axis) and Z (+ away from the
+/// chuck) - the direction from the nose centre to the material.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Contact {
+    PlusX,
+    MinusX,
+    PlusZ,
+    MinusZ,
+}
+
+impl Contact {
+    fn vector(self) -> (f64, f64) {
+        match self {
+            Contact::PlusX => (1.0, 0.0),
+            Contact::MinusX => (-1.0, 0.0),
+            Contact::PlusZ => (0.0, 1.0),
+            Contact::MinusZ => (0.0, -1.0),
+        }
+    }
+}
+
+impl core::fmt::Display for Contact {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.write_str(match self {
+            Contact::PlusX => "+X",
+            Contact::MinusX => "-X",
+            Contact::PlusZ => "+Z",
+            Contact::MinusZ => "-Z",
+        })
+    }
+}
+
+/// The unit offset from the nose centre to the control point for
+/// orientation `q`, in (radius X, Z) - multiply by the nose radius.
+/// None for anything outside 1..=9.
+#[must_use]
+pub fn tip_offset(q: u8) -> Option<(f64, f64)> {
+    Some(match q {
+        1 => (-1.0, 1.0),
+        2 => (-1.0, -1.0),
+        3 => (1.0, -1.0),
+        4 => (1.0, 1.0),
+        5 => (0.0, 1.0),
+        6 => (-1.0, 0.0),
+        7 => (0.0, -1.0),
+        8 => (1.0, 0.0),
+        9 => (0.0, 0.0),
+        _ => return None,
+    })
+}
+
+/// Whether an orientation is one the tool table knows.
+#[must_use]
+pub fn is_valid(q: u8) -> bool {
+    (1..=9).contains(&q)
+}
+
+/// Can an insert of orientation `q` present a nose contact with normal
+/// `c`? See the module law: 45 degrees about a corner tip, 90 about an
+/// axis tip, anything at the centre code.
+#[must_use]
+pub fn covers(q: u8, c: Contact) -> bool {
+    let Some((ox, oz)) = tip_offset(q) else { return false };
+    let len = (ox * ox + oz * oz).sqrt();
+    if len == 0.0 {
+        return true;
+    }
+    let (nx, nz) = c.vector();
+    let cos = (ox * nx + oz * nz) / len;
+    // Corner tips (|offset| = sqrt 2) reach 45 degrees, axis tips 90.
+    let limit = if len > 1.5 { core::f64::consts::FRAC_1_SQRT_2 } else { 0.0 };
+    cos >= limit - 1e-9
+}
+
+/// The orientations 1-8 that present every contact in `need` - the
+/// list a refusal names. (9 is left out: it states no insert.)
+#[must_use]
+pub fn fitting(need: &[Contact]) -> Vec<u8> {
+    (1..=8u8).filter(|q| need.iter().all(|c| covers(*q, *c))).collect()
+}
+
+/// The orientation a kind takes when the library states none: the
+/// right-hand OD turning tool cutting toward the chuck (2) for a
+/// turning insert, the boring bar cutting toward the chuck (3) for a
+/// boring bar, the left (-Z, chuck-side) corner (2) for a grooving or
+/// parting blade (#641). None for every kind whose posted point is not
+/// a touched-off tip (the mills, threading V, form gauges, cycle
+/// tools).
+#[must_use]
+pub fn default_for(kind: ToolKind) -> Option<u8> {
+    match kind {
+        ToolKind::Turning | ToolKind::Groove => Some(2),
+        ToolKind::Bore => Some(3),
+        _ => None,
+    }
+}
+
+/// The codes an OD grooving/parting blade can be touched off as
+/// (#641): its +Z corner, its -Z corner, its width centre.
+pub const BLADE_FITTING: [u8; 3] = [1, 2, 6];
+
+/// Which way a blade's control point stands from the middle of its tip
+/// edge, in half-widths along Z: +1 the +Z corner, -1 the -Z corner,
+/// 0 the middle. None for a code that states no OD blade.
+#[must_use]
+pub fn blade_corner(q: u8) -> Option<f64> {
+    match q {
+        1 => Some(1.0),
+        2 => Some(-1.0),
+        6 | 9 => Some(0.0),
+        _ => None,
+    }
+}
+
+/// A short label for the editor's list, read for a blade.
+#[must_use]
+pub fn blade_label(q: u8) -> &'static str {
+    match q {
+        1 => "1 - right corner (+Z, toward the free end)",
+        2 => "2 - left corner (-Z, toward the chuck)",
+        6 => "6 - width centre",
+        9 => "9 - width centre",
+        _ => "not an OD blade",
+    }
+}
+
+/// A short label for the editor's list.
+#[must_use]
+pub fn label(q: u8) -> &'static str {
+    match q {
+        1 => "1 - OD, cuts away from the chuck",
+        2 => "2 - OD, cuts toward the chuck",
+        3 => "3 - ID, cuts toward the chuck",
+        4 => "4 - ID, cuts away from the chuck",
+        5 => "5 - points +Z",
+        6 => "6 - points -X (neutral OD)",
+        7 => "7 - points -Z",
+        8 => "8 - points +X (neutral ID)",
+        9 => "9 - nose centre",
+        _ => "unknown",
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_corner_tips_sit_on_both_tangent_lines() {
+        // Orientation 2: an OD tool toward the chuck touches the
+        // diameter at -X and the face at -Z of its nose.
+        assert_eq!(tip_offset(2), Some((-1.0, -1.0)));
+        assert_eq!(tip_offset(3), Some((1.0, -1.0)));
+        assert_eq!(tip_offset(9), Some((0.0, 0.0)));
+        assert_eq!(tip_offset(0), None);
+        assert_eq!(tip_offset(10), None);
+    }
+
+    #[test]
+    fn the_pathpilot_listing_is_reproduced() {
+        // A cut needing the -X and +Z contacts fits 1, 5 and 6 only.
+        assert_eq!(fitting(&[Contact::MinusX, Contact::PlusZ]), vec![1, 5, 6]);
+        // An OD diameter alone: every tip with a -X reach.
+        assert_eq!(fitting(&[Contact::MinusX]), vec![1, 2, 5, 6, 7]);
+        // A bore wall: the +X family.
+        assert_eq!(fitting(&[Contact::PlusX]), vec![3, 4, 5, 7, 8]);
+        // Facing inward: the face below and the pass's leading -X.
+        assert_eq!(fitting(&[Contact::MinusX, Contact::MinusZ]), vec![2, 6, 7]);
+    }
+
+    #[test]
+    fn defaults_are_the_lathe_kinds_only() {
+        assert_eq!(default_for(ToolKind::Turning), Some(2));
+        assert_eq!(default_for(ToolKind::Bore), Some(3));
+        assert_eq!(default_for(ToolKind::EndMill), None);
+        assert_eq!(default_for(ToolKind::Groove), Some(2), "the left corner (#641)");
+        assert_eq!(default_for(ToolKind::Thread), None);
+        assert!(covers(9, Contact::PlusX) && covers(9, Contact::MinusZ));
+    }
+
+    #[test]
+    fn a_blade_names_its_corner_by_the_chart() {
+        assert_eq!(blade_corner(1), Some(1.0));
+        assert_eq!(blade_corner(2), Some(-1.0));
+        assert_eq!(blade_corner(6), Some(0.0));
+        assert_eq!(blade_corner(9), Some(0.0));
+        for q in [0, 3, 4, 5, 7, 8, 10] {
+            assert_eq!(blade_corner(q), None, "{q} states no OD blade");
+        }
+        assert!(BLADE_FITTING.iter().all(|q| blade_corner(*q).is_some()));
+    }
+}
diff --git a/crates/tools/src/spun.rs b/crates/tools/src/spun.rs
new file mode 100644
index 00000000..c7e8dd4a
--- /dev/null
+++ b/crates/tools/src/spun.rs
@@ -0,0 +1,330 @@
+//! A spun (revolved) profile (#93): the half-outline of a milling tool
+//! or holder as (z, r) points from the tip upward, closed to the axis at
+//! both ends, each segment a straight line or a circular arc - the side
+//! view the holder catalogs and machine-tool handbooks draw, spun about
+//! the spindle axis. Circle/chord geometry (sagitta, tangent polygon) is
+//! elementary plane geometry. Our own design; no vendor source or file
+//! consulted.
+//!
+//! Conservative by construction: an arc is flattened to points that
+//! never fall inside the material - a convex arc (bulging away from the
+//! axis) by its circumscribed tangent polygon, a concave one by chords
+//! on the arc - so the bands read off the flattened outline are never
+//! smaller than the drawn solid. A stepped (straight-segment) profile
+//! reads exactly: one band per climbing segment at its larger end, a
+//! zero-height spike folded into the band it touches.
+
+use crate::holder_profile::{HolderBand, HolderProfile, MAX_BODY_HEIGHT, MAX_BODY_RADIUS};
+use crate::tools::{Tool, ToolKind};
+
+/// One vertex of the outline: `z` above the tip, `r` from the axis, and
+/// the segment to the NEXT point: `arc` = 0 for a straight line, else
+/// the signed radius of a circular arc through both points - positive
+/// bulges away from the axis (convex), negative toward it (concave).
+/// The last point's `arc` is never read.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SpunPoint {
+    pub z: f64,
+    pub r: f64,
+    pub arc: f64,
+}
+
+impl SpunPoint {
+    #[must_use]
+    pub const fn line(z: f64, r: f64) -> Self {
+        Self { z, r, arc: 0.0 }
+    }
+}
+
+/// Most points one drawn profile carries.
+pub const MAX_POINTS: usize = 64;
+/// Shortest segment (mm) a drawn profile may have - a typo'd duplicate
+/// point is refused, not silently drawn as a zero-length step.
+pub const MIN_SEGMENT: f64 = 0.01;
+/// Facets per flattened arc.
+const ARC_STEPS: usize = 16;
+/// Slack (mm) on the closing and monotonic checks: float dust only.
+const EPS: f64 = 1e-9;
+
+/// Why a drawn profile is refused. Point numbers are 1-based, as the
+/// editor's table shows them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SpunError {
+    TooFew,
+    TooMany,
+    NonFinite(usize),
+    Negative(usize),
+    BelowTip(usize),
+    OpenStart,
+    OpenEnd,
+    TouchesAxis(usize),
+    Short(usize),
+    ArcTooTight(usize),
+    RunsBack(usize),
+    Flat,
+    TooLarge,
+}
+
+impl core::fmt::Display for SpunError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match *self {
+            Self::TooFew => write!(f, "the profile needs at least 3 points (on the axis, out, back to the axis)"),
+            Self::TooMany => write!(f, "the profile has more than {MAX_POINTS} points"),
+            Self::NonFinite(i) => write!(f, "point {i} is not a finite number"),
+            Self::Negative(i) => write!(f, "point {i} has a negative radius"),
+            Self::BelowTip(i) => write!(f, "point {i} is below the tool tip (z < 0)"),
+            Self::OpenStart => write!(f, "the profile must start on the axis (first point r = 0)"),
+            Self::OpenEnd => write!(f, "the profile must end on the axis (last point r = 0)"),
+            Self::TouchesAxis(i) => write!(f, "point {i} touches the axis between the ends - one solid only"),
+            Self::Short(i) => write!(f, "the segment from point {i} is shorter than {MIN_SEGMENT} mm"),
+            Self::ArcTooTight(i) => {
+                write!(f, "the arc from point {i} has a radius smaller than half its chord")
+            }
+            Self::RunsBack(i) => write!(
+                f,
+                "the segment from point {i} runs back down the axis - a spun outline climbs from the tip to the top"
+            ),
+            Self::Flat => write!(f, "the profile has no length along the tool axis"),
+            Self::TooLarge => write!(
+                f,
+                "the profile is larger than any tool a spindle carries ({MAX_BODY_RADIUS} mm from the axis, {MAX_BODY_HEIGHT} mm long)"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for SpunError {}
+
+/// A validated spun profile.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SpunProfile {
+    points: Vec<SpunPoint>,
+}
+
+impl SpunProfile {
+    /// Validate a drawn outline. Refuses by name: too few or too many
+    /// points, a non-finite number, a negative radius, a point below the
+    /// tip, an end off the axis, an interior point on it, a segment
+    /// shorter than [`MIN_SEGMENT`], an arc tighter than its chord, an
+    /// outline that runs back down the axis, no length, or one past the
+    /// body size caps.
+    pub fn new(points: Vec<SpunPoint>) -> Result<Self, SpunError> {
+        let n = points.len();
+        if n < 3 {
+            return Err(SpunError::TooFew);
+        }
+        if n > MAX_POINTS {
+            return Err(SpunError::TooMany);
+        }
+        for (i, p) in points.iter().enumerate() {
+            if !(p.z.is_finite() && p.r.is_finite() && p.arc.is_finite()) {
+                return Err(SpunError::NonFinite(i + 1));
+            }
+            if p.r < 0.0 {
+                return Err(SpunError::Negative(i + 1));
+            }
+            if p.z < 0.0 {
+                return Err(SpunError::BelowTip(i + 1));
+            }
+        }
+        if points[0].r > EPS {
+            return Err(SpunError::OpenStart);
+        }
+        if points[n - 1].r > EPS {
+            return Err(SpunError::OpenEnd);
+        }
+        if let Some(i) = points[1..n - 1].iter().position(|p| p.r <= EPS) {
+            return Err(SpunError::TouchesAxis(i + 2));
+        }
+        for (i, w) in points.windows(2).enumerate() {
+            let len = (w[1].z - w[0].z).hypot(w[1].r - w[0].r);
+            if len < MIN_SEGMENT {
+                return Err(SpunError::Short(i + 1));
+            }
+            if w[0].arc != 0.0 && w[0].arc.abs() < len * 0.5 - EPS {
+                return Err(SpunError::ArcTooTight(i + 1));
+            }
+            let seg = flatten(w[0], w[1]);
+            if seg.windows(2).any(|q| q[1].0 < q[0].0 - EPS) {
+                return Err(SpunError::RunsBack(i + 1));
+            }
+            if seg.iter().any(|q| q.1 < -EPS) {
+                return Err(SpunError::Negative(i + 1));
+            }
+        }
+        let p = Self { points };
+        let out = p.outline();
+        let (lo, hi) = out.iter().fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), q| (a.min(q.0), b.max(q.0)));
+        if hi - lo <= 1e-6 {
+            return Err(SpunError::Flat);
+        }
+        if hi > MAX_BODY_HEIGHT || out.iter().any(|q| q.1 > MAX_BODY_RADIUS) {
+            return Err(SpunError::TooLarge);
+        }
+        Ok(p)
+    }
+
+    /// The tool's cutter and shank as drawn from its numbers: exactly
+    /// [`Tool::profile`] up to the shank's top, closed there to the
+    /// axis. Display data straight off the record the laws read, so it
+    /// takes no drawn-profile validation. `None` for the lathe insert
+    /// kinds - turning tools are not spun profiles (they keep their own
+    /// editor) - and for a draft with no outline.
+    #[must_use]
+    pub fn cutter_of(t: &Tool) -> Option<Self> {
+        if is_lathe(t.kind) {
+            return None;
+        }
+        let points: Vec<SpunPoint> =
+            Tool { holder_len: 0.0, ..t.clone() }.profile().into_iter().map(|(z, r)| SpunPoint::line(z, r)).collect();
+        let ok = points.len() >= 3 && points.iter().all(|p| p.z.is_finite() && p.r.is_finite());
+        ok.then_some(Self { points })
+    }
+
+    /// The tool's holder as its numbers state it: the Ø `holder_d` ×
+    /// `holder_len` cylinder on the shank's top - the very sums
+    /// `HolderStack::cylinder` makes, so its bands read bit-identically.
+    /// `None` for the lathe kinds and for a tool with no holder.
+    #[must_use]
+    pub fn holder_of(t: &Tool) -> Option<Self> {
+        if is_lathe(t.kind) {
+            return None;
+        }
+        let zs = t.flute_len + t.shank_len;
+        let (hr, zh) = (t.holder_d * 0.5, zs + t.holder_len);
+        Self::new(vec![SpunPoint::line(zs, 0.0), SpunPoint::line(zs, hr), SpunPoint::line(zh, hr), SpunPoint::line(zh, 0.0)])
+            .ok()
+    }
+
+    /// A drawn outline of the stepped bands of a body envelope (an
+    /// imported body re-drawn as a profile): each band a cylinder,
+    /// joined by flat steps.
+    #[must_use]
+    pub fn from_bands(bands: &[HolderBand]) -> Option<Self> {
+        let first = bands.first()?;
+        let mut pts = vec![SpunPoint::line(first.above, 0.0)];
+        for b in bands {
+            pts.push(SpunPoint::line(b.above, b.r));
+            pts.push(SpunPoint::line(b.above + b.len, b.r));
+        }
+        pts.push(SpunPoint::line(pts.last()?.z, 0.0));
+        pts.dedup_by(|b, a| (a.z - b.z).hypot(a.r - b.r) < MIN_SEGMENT);
+        Self::new(pts).ok()
+    }
+
+    #[must_use]
+    pub fn points(&self) -> &[SpunPoint] {
+        &self.points
+    }
+
+    /// The outline as a (z, r) polyline with every arc flattened
+    /// conservatively (the module's law). The display mesh and the
+    /// bands both read this one polyline, so they cannot disagree.
+    #[must_use]
+    pub fn outline(&self) -> Vec<(f64, f64)> {
+        let mut out = Vec::with_capacity(self.points.len() + ARC_STEPS);
+        for w in self.points.windows(2) {
+            let seg = flatten(w[0], w[1]);
+            let skip = usize::from(!out.is_empty());
+            out.extend(seg.into_iter().skip(skip));
+        }
+        out
+    }
+
+    /// The contiguous bands the stack laws sweep: one per climbing
+    /// segment of the outline at its larger radius. A flat (zero-height)
+    /// step carries no length of its own, so its larger radius is folded
+    /// into a band touching its height when none already reaches it - a
+    /// plain step is held by the bands either side, but a flange drawn
+    /// out and back at one z (at the top, the foot or mid-body) would
+    /// otherwise fall out of the envelope. Never smaller than the
+    /// outline: every outline radius is inside a band at its height.
+    #[must_use]
+    pub fn bands(&self) -> Vec<HolderBand> {
+        let out = self.outline();
+        let mut bands: Vec<HolderBand> = out
+            .windows(2)
+            .filter(|w| w[1].0 > w[0].0)
+            .map(|w| HolderBand { above: w[0].0, len: w[1].0 - w[0].0, r: w[0].1.max(w[1].1) })
+            .collect();
+        for w in out.windows(2).filter(|w| w[1].0 <= w[0].0) {
+            let (z, r) = (w[0].0.max(w[1].0), w[0].1.max(w[1].1));
+            let touches = |b: &HolderBand| b.above - EPS <= z && z <= b.above + b.len + EPS;
+            if bands.iter().any(|b| touches(b) && b.r >= r) {
+                continue;
+            }
+            // The band ending at z (below the step) first, else the one
+            // starting there; `Flat` validation means one always exists.
+            let below = bands.iter().position(|b| (b.above + b.len - z).abs() <= EPS);
+            let pick = below.or_else(|| bands.iter().position(touches));
+            if let Some(b) = pick.and_then(|i| bands.get_mut(i)) {
+                b.r = b.r.max(r);
+            }
+        }
+        bands
+    }
+
+    /// The largest radius on the outline - what the editor's summary
+    /// reports as the body's diameter, and what the bands never fall
+    /// under.
+    #[must_use]
+    pub fn max_radius(&self) -> f64 {
+        self.outline().iter().fold(0.0, |m, q| m.max(q.1))
+    }
+
+    /// The body envelope the judging laws read (`HolderProfile`): these
+    /// bands, merged only past `MAX_BANDS` (and merging only grows).
+    #[must_use]
+    pub fn holder_profile(&self) -> HolderProfile {
+        HolderProfile::from_bands(self.bands())
+    }
+}
+
+fn is_lathe(k: ToolKind) -> bool {
+    matches!(k, ToolKind::Turning | ToolKind::Groove | ToolKind::Thread | ToolKind::Form)
+}
+
+/// The segment `a` → `b` as (z, r) points, both ends included: a line
+/// is its two ends; an arc of signed radius `a.arc` is its circumscribed
+/// tangent polygon when convex (the centre on the material side) and
+/// its inscribed chords when concave - never inside the drawn solid.
+fn flatten(a: SpunPoint, b: SpunPoint) -> Vec<(f64, f64)> {
+    let (dz, dr) = (b.z - a.z, b.r - a.r);
+    let len = dz.hypot(dr);
+    if a.arc == 0.0 || len.is_nan() || len <= 0.0 || a.arc.abs() < len * 0.5 - EPS {
+        return vec![(a.z, a.r), (b.z, b.r)];
+    }
+    let rad = a.arc.abs();
+    // n: the chord's normal away from the material (outward for an
+    // outline climbing the axis); v: the chord direction.
+    let n = (-dr / len, dz / len);
+    let v = (dz / len, dr / len);
+    let half = (len * 0.5 / rad).clamp(-1.0, 1.0).asin();
+    let s = a.arc.signum();
+    let mid = ((a.z + b.z) * 0.5, (a.r + b.r) * 0.5);
+    let back = rad * half.cos();
+    // Convex (s > 0): the bulge is along +n, the centre behind the chord.
+    let c = (mid.0 - s * back * n.0, mid.1 - s * back * n.1);
+    let u = (s * n.0, s * n.1);
+    let at = |th: f64, k: f64| (c.0 + k * (th.cos() * u.0 + th.sin() * v.0), c.1 + k * (th.cos() * u.1 + th.sin() * v.1));
+    let step = 2.0 * half / ARC_STEPS as f64;
+    let mut out = vec![(a.z, a.r)];
+    if s > 0.0 {
+        // Tangent lines at -half + k*step meet at the mid-angles, on the
+        // circle of radius rad / cos(step / 2).
+        let k = rad / (step * 0.5).cos();
+        for i in 0..ARC_STEPS {
+            out.push(at(-half + (i as f64 + 0.5) * step, k));
+        }
+    } else {
+        for i in 1..ARC_STEPS {
+            out.push(at(-half + i as f64 * step, rad));
+        }
+    }
+    out.push((b.z, b.r));
+    out
+}
