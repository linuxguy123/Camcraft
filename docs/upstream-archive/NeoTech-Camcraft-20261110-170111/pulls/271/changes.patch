+    assert_eq!(sc["stock_bounds"]["max"][2], json!(15.0), "{sc}");
+    assert_eq!(sc["rest"]["cells"], json!(0), "{sc}");
+    assert_eq!(sc["rest"]["volume"], json!(0.0), "{sc}");
+    assert!(sc["rest"]["top_bounds"].is_null(), "{sc}");
