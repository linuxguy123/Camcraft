+    let zs = g32_zs(&text);
+    assert_eq!(zs.len(), 18, "three passes of six half-turns: {text}");
+    for pass in zs.chunks(6) {
+        assert!(pass.windows(2).all(|w| w[1] < w[0]), "every G32 pass descends: {pass:?}");
+        assert_eq!((pass[0], pass[5]), (13.0, 8.0), "{pass:?}");
+    }
