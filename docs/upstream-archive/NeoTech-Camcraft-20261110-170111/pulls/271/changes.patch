diff --git a/crates/ui/src/state_fixture.rs b/crates/ui/src/state_fixture.rs
new file mode 100644
index 00000000..9c870bed
--- /dev/null
+++ b/crates/ui/src/state_fixture.rs
@@ -0,0 +1,73 @@
+//! The fixture views a frame reads (#339 slice 4): each fixture's mesh
+//! state for the browser rows and the Fixtures page, and the fixtures
+//! the selected op's `FixtureHit` warnings strike, for the viewport tint
+//! and the op banner. Both answers are the app's
+//! (`camcraft_app::fixture_view`), cached per document version; this
+//! file only picks the key. Display only - nothing here is a command.
+//! Provenance: our own view law; no vendor material consulted.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use camcraft_app::fixture::MACHINE_TABLE;
+use camcraft_app::fixture_struck::Struck;
+use camcraft_app::fixture_view::{self, MeshState};
+
+use super::State;
+
+/// At most this many unresolved moves are listed by number.
+const LISTED_MOVES: usize = 5;
+
+impl State {
+    /// Every fixture's mesh state, keyed by name (this document version).
+    #[must_use]
+    pub fn fixture_mesh_states(&self) -> Arc<HashMap<String, MeshState>> {
+        fixture_view::mesh_states_cached(&self.fixture_mesh_cache, &self.world, self.doc_version)
+    }
+
+    /// One fixture's mesh state, if `name` is a fixture.
+    #[must_use]
+    pub fn fixture_mesh_state(&self, name: &str) -> Option<MeshState> {
+        self.fixture_mesh_states().get(name).copied()
+    }
+
+    /// Who `op`'s fixture warnings strike (`None`: no fixture warning).
+    #[must_use]
+    pub fn struck_by(&self, op: &str) -> Option<Struck> {
+        Option::clone(&fixture_view::struck_cached(&self.struck_cache, &self.world, self.doc_version, op))
+    }
+
+    /// The fixtures the viewport tints: those the SELECTED op's warnings
+    /// strike (the derived table is not an entity, so it is never drawn).
+    #[must_use]
+    pub fn fixture_highlight(&self) -> Vec<String> {
+        self.selected_operation()
+            .and_then(|op| self.struck_by(&op))
+            .map(|s| s.fixtures.into_iter().filter(|f| f != MACHINE_TABLE).collect())
+            .unwrap_or_default()
+    }
+
+    /// The op banner's fixture lines: who is struck, and - said, never
+    /// guessed - which warned moves no fixture reproduces today.
+    #[must_use]
+    pub fn struck_lines(&self, op: &str) -> Vec<String> {
+        let Some(s) = self.struck_by(op) else {
+            return Vec::new();
+        };
+        let mut out = Vec::new();
+        if !s.fixtures.is_empty() {
+            out.push(format!("Strikes fixture: {} - tinted in the viewport while selected", s.fixtures.join(", ")));
+        }
+        if !s.unresolved.is_empty() {
+            let mut moves: Vec<String> = s.unresolved.iter().take(LISTED_MOVES).map(usize::to_string).collect();
+            if s.unresolved.len() > LISTED_MOVES {
+                moves.push(format!("and {} more", s.unresolved.len() - LISTED_MOVES));
+            }
+            out.push(format!(
+                "Fixture not resolved for move {}: no single fixture reproduces the hit as the steel stands now - regenerate to re-check",
+                moves.join(", ")
+            ));
+        }
+        out
+    }
+}
diff --git a/crates/ui/src/state_fixture_library.rs b/crates/ui/src/state_fixture_library.rs
new file mode 100644
index 00000000..b758eab2
--- /dev/null
+++ b/crates/ui/src/state_fixture_library.rs
@@ -0,0 +1,219 @@
+//! The fixture library dialogs' state (#339 slice 6): "Save fixture to
+//! library…" and "Insert from library…" on a setup's Fixtures node.
+//! Saving and deleting entries are file edits of the user library
+//! (`app::fixture_library`), confirmed in the dialog and never undo
+//! entries - the #383 machine-file law. Inserting is a document change,
+//! so it is the undoable `InsertFixture` command, queued like any other.
+//! Provenance: our own dialog state over our own library format; no
+//! vendor fixture material consulted.
+
+use std::path::PathBuf;
+
+use camcraft_app::commands::InsertFixture;
+use camcraft_app::fixture;
+use camcraft_app::fixture_library::{self, DatumChoice, LibraryError};
+use camcraft_app::geometry::{Point3, quat_from_euler};
+use camcraft_app::model;
+use camcraft_app::schema::Location;
+
+use super::{ErrorScope, State};
+
+/// One library entry as the insert dialog lists it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct LibraryRow {
+    pub name: String,
+    pub note: Option<String>,
+    pub facets: usize,
+}
+
+/// "Save fixture to library…": which of the setup's fixtures, by which
+/// datum, with what note. `confirm_replace` holds the names already in
+/// the library while the dialog asks before replacing them.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SaveFixtureDraft {
+    /// The Fixtures node's setup (`""` - the implicit setup).
+    pub setup: String,
+    pub fixtures: Vec<(String, bool)>,
+    pub datum: DatumChoice,
+    pub note: String,
+    pub confirm_replace: Option<Vec<String>>,
+    pub error: Option<String>,
+}
+
+/// "Insert from library…": the listed entries, the picked one, the
+/// datum's placement (mm and degrees, R = Rz ⊗ Ry ⊗ Rx as the Model
+/// page) and a pending delete confirmation.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct InsertFixtureDraft {
+    pub setup: String,
+    pub rows: Vec<LibraryRow>,
+    pub selected: Option<String>,
+    pub pos: [f64; 3],
+    pub rpy_deg: [f64; 3],
+    pub confirm_delete: Option<String>,
+    pub error: Option<String>,
+}
+
+/// The open fixture library dialog, if any (view state, never saved).
+#[derive(Clone, Debug, PartialEq)]
+pub enum FixtureLibDialog {
+    Save(SaveFixtureDraft),
+    Insert(InsertFixtureDraft),
+}
+
+fn declared(setup: &str) -> Option<&str> {
+    (!setup.is_empty()).then_some(setup)
+}
+
+impl State {
+    /// The library file this window edits: the test override, else the
+    /// user fixtures folder (`CAMCRAFT_FIXTURES`, else the data dir).
+    pub fn fixture_library_path(&self) -> Result<PathBuf, String> {
+        self.fixture_lib_dir
+            .clone()
+            .or_else(fixture_library::user_dir)
+            .map(|d| fixture_library::library_path(&d))
+            .ok_or_else(|| format!("no user fixtures folder (set {} or a home folder)", fixture_library::ENV_VAR))
+    }
+
+    /// Open the save dialog over `setup`'s fixtures; the selected ones
+    /// start checked (the only one, when a setup has just one).
+    pub fn open_fixture_library_save(&mut self, setup: String) {
+        let w = &self.world;
+        let tagged = fixture::tagged(w, declared(&setup));
+        let lone = tagged.len() == 1;
+        let fixtures = tagged.iter().map(|(n, e)| (n.clone(), lone || model::is_selected(w, e))).collect();
+        self.fixture_lib = Some(FixtureLibDialog::Save(SaveFixtureDraft { setup, fixtures, ..Default::default() }));
+    }
+
+    /// Open the insert dialog over `setup`, listing the library afresh.
+    pub fn open_fixture_library_insert(&mut self, setup: String) {
+        let mut draft = InsertFixtureDraft { setup, ..Default::default() };
+        self.reload_library_rows(&mut draft);
+        self.fixture_lib = Some(FixtureLibDialog::Insert(draft));
+    }
+
+    fn reload_library_rows(&self, draft: &mut InsertFixtureDraft) {
+        let read = self.fixture_library_path().and_then(|p| fixture_library::load(&p).map_err(|e| e.to_string()));
+        match read {
+            Ok(lib) => {
+                draft.rows = lib
+                    .into_iter()
+                    .map(|e| LibraryRow { name: e.name, note: e.note, facets: e.facets.len() })
+                    .collect();
+                draft.error = None;
+            }
+            Err(err) => {
+                draft.rows.clear();
+                draft.error = Some(format!("library not read: {err}"));
+            }
+        }
+        if !draft.selected.as_ref().is_some_and(|s| draft.rows.iter().any(|r| &r.name == s)) {
+            draft.selected = draft.rows.first().map(|r| r.name.clone());
+        }
+    }
+
+    /// The save dialog's Save (and, after the replace prompt, Replace):
+    /// writes the checked fixtures into the library file. A clash asks
+    /// first (`confirm_replace`); a refusal stays in the dialog by name.
+    pub fn save_fixtures_to_library(&mut self, replace: bool) {
+        let Some(FixtureLibDialog::Save(draft)) = self.fixture_lib.as_ref() else {
+            return;
+        };
+        let names: Vec<String> = draft.fixtures.iter().filter(|(_, on)| *on).map(|(n, _)| n.clone()).collect();
+        let entries = if names.is_empty() {
+            Err("check a fixture to save".to_owned())
+        } else {
+            names
+                .iter()
+                .map(|n| fixture_library::entry_from_model(&self.world, n, draft.datum, Some(draft.note.as_str())))
+                .collect::<Result<Vec<_>, _>>()
+        };
+        let outcome = entries.and_then(|entries| {
+            let path = self.fixture_library_path()?;
+            Ok(fixture_library::add_entries(&path, entries, replace).map(|()| path))
+        });
+        let Some(FixtureLibDialog::Save(draft)) = self.fixture_lib.as_mut() else {
+            return;
+        };
+        match outcome {
+            Ok(Ok(path)) => {
+                self.status = format!("saved {} fixture(s) to {}", names.len(), path.display());
+                self.fixture_lib = None;
+            }
+            Ok(Err(LibraryError::Exists(taken))) => {
+                draft.confirm_replace = Some(taken);
+                draft.error = None;
+            }
+            Ok(Err(err)) => {
+                draft.confirm_replace = None;
+                draft.error = Some(format!("not saved: {err}"));
+            }
+            Err(err) => {
+                draft.confirm_replace = None;
+                draft.error = Some(format!("not saved: {err}"));
+            }
+        }
+    }
+
+    /// The insert dialog's confirmed Delete: removes the entry from the
+    /// library file (no undo - a file edit, asked first) and re-lists.
+    pub fn delete_library_entry(&mut self, name: &str) {
+        let done = self
+            .fixture_library_path()
+            .and_then(|p| fixture_library::delete_entry(&p, name).map_err(|e| e.to_string()));
+        let Some(FixtureLibDialog::Insert(mut draft)) = self.fixture_lib.take() else {
+            return;
+        };
+        draft.confirm_delete = None;
+        self.reload_library_rows(&mut draft);
+        match done {
+            Ok(()) => self.status = format!("deleted '{name}' from the fixture library"),
+            Err(err) => draft.error = Some(format!("not deleted: {err}")),
+        }
+        self.fixture_lib = Some(FixtureLibDialog::Insert(draft));
+    }
+
+    /// `CommandKind::InsertFixtureFromLibrary`: read the entry afresh and
+    /// execute `InsertFixture` - one undo unit. Closes the dialog on
+    /// success; a refusal names the entry and leaves the dialog open.
+    pub(super) fn insert_fixture_from_library(
+        &mut self,
+        entry: &str,
+        setup: Option<String>,
+        pos: [f64; 3],
+        rpy_deg: [f64; 3],
+    ) {
+        if rpy_deg.iter().any(|a| !a.is_finite()) {
+            self.refuse(ErrorScope::Setup, "fixture not inserted: rotation angles must be finite".into());
+            return;
+        }
+        let pick = Location {
+            pos: Point3::new(pos[0], pos[1], pos[2]),
+            rot: quat_from_euler(rpy_deg[0].to_radians(), rpy_deg[1].to_radians(), rpy_deg[2].to_radians()),
+        };
+        let planned = self
+            .fixture_library_path()
+            .and_then(|p| fixture_library::load(&p).map_err(|e| e.to_string()))
+            .and_then(|lib| {
+                lib.into_iter().find(|e| e.name == entry).ok_or_else(|| format!("no fixture '{entry}' in the library"))
+            })
+            .and_then(|e| InsertFixture::new(&self.world, &e, setup.as_deref(), pick).map_err(|e| e.to_string()));
+        match planned {
+            Ok(command) => {
+                let name = command.name().to_owned();
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = format!("inserted fixture {name} from the library");
+                self.fixture_lib = None;
+            }
+            Err(err) => {
+                let msg = format!("fixture '{entry}' not inserted: {err}");
+                if let Some(FixtureLibDialog::Insert(d)) = self.fixture_lib.as_mut() {
+                    d.error = Some(msg.clone());
+                }
+                self.refuse(ErrorScope::Setup, msg);
+            }
+        }
+    }
+}
diff --git a/crates/ui/src/state_per_op.rs b/crates/ui/src/state_per_op.rs
new file mode 100644
index 00000000..0c643d86
--- /dev/null
+++ b/crates/ui/src/state_per_op.rs
@@ -0,0 +1,120 @@
+//! The post page's Output choice and the per-operation post (#111):
+//! the switch rides `SetPostOptions` (one undo unit), and a per-op
+//! post asks for a folder instead of a file. A program whose setups run
+//! on different machines or posts writes one file per mount (#388).
+//! Provenance: our own page law (issue #111); no vendor material consulted.
+
+use std::path::{Path, PathBuf};
+
+use camcraft_app::posting;
+
+use super::{ErrorScope, PostView, State};
+
+impl State {
+    /// The Output choice: `true` writes one file per operation.
+    pub(super) fn set_per_op_output(&mut self, per_op: bool) {
+        let next = camcraft_app::schema::PostOptions { per_op, ..posting::post_options(&self.world) };
+        match camcraft_app::commands::SetPostOptions::new(&self.world, next) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = if per_op {
+                    "post writes one file per operation".to_owned()
+                } else {
+                    "post writes one combined program".to_owned()
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Operation, format!("post options not changed: {err}")),
+        }
+    }
+
+    /// The program name a per-op post stamps on its files: the
+    /// project's file stem, or `program` for an unsaved document.
+    #[must_use]
+    pub fn program_name(&self) -> String {
+        self.project_path
+            .as_deref()
+            .and_then(Path::file_stem)
+            .and_then(|s| s.to_str())
+            .unwrap_or("program")
+            .to_owned()
+    }
+
+    /// Post one file per operation into `dir`, or be refused by name -
+    /// writing nothing (posting's own law). The viewer shows the first
+    /// file; the status line names how many were written and where.
+    pub(super) fn post_program_folder(&mut self, dir: PathBuf) {
+        let program = self.program_name();
+        match posting::post_per_op(&self.world, &dir, &program) {
+            Ok(files) => {
+                let lines: usize = files.iter().map(|f| f.posted.lines).sum();
+                self.status = format!("posted {} file(s), one per operation, {lines} lines to {}", files.len(), dir.display());
+                if let Some(line) = files.first().and_then(|f| f.posted.not_judged.clone()) {
+                    self.status = format!("{} - WARNING: {line}", self.status);
+                }
+                if let Some(first) = files.into_iter().next() {
+                    let p = first.posted;
+                    self.post_view = Some(PostView {
+                        path: first.path,
+                        program: p.program,
+                        line_pos: p.line_pos,
+                        open: true,
+                        line: 0,
+                        blocks: p.blocks,
+                        trace: false,
+                        not_judged: p.not_judged,
+                    });
+                }
+            }
+            Err(err) => self.status = format!("post refused: {err}"),
+        }
+    }
+
+    /// A per-mount post's outcome (#388): the status line names every
+    /// file and its setups; the viewer shows the first.
+    pub(super) fn show_posted_mounts(&mut self, files: Vec<posting::PostedMount>) {
+        let names: Vec<String> = files
+            .iter()
+            .map(|f| {
+                let file = f.path.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+                format!("{file} ({})", f.mount.setups.join(", "))
+            })
+            .collect();
+        self.status = format!("posted {} file(s), one per machine and post: {}", files.len(), names.join("; "));
+        if let Some(line) = files.first().and_then(|f| f.posted.not_judged.clone()) {
+            self.status = format!("{} - WARNING: {line}", self.status);
+        }
+        if let Some(first) = files.into_iter().next() {
+            let p = first.posted;
+            self.post_view = Some(PostView {
+                path: first.path,
+                program: p.program,
+                line_pos: p.line_pos,
+                open: true,
+                line: 0,
+                blocks: p.blocks,
+                trace: false,
+                not_judged: p.not_judged,
+            });
+        }
+    }
+
+    /// The post's front door: a folder when the Output is one file per
+    /// operation, the program file otherwise.
+    pub(super) fn post_program_dialog(&mut self) {
+        // #258: both pickers open where this document last posted, else
+        // beside the saved project (`post_file::for_document`).
+        let target = crate::post_file::for_document(self);
+        if posting::post_options(&self.world).per_op {
+            let mut picker = rfd::FileDialog::new().set_title("Post one file per operation into");
+            if let Some(dir) = &target.dir {
+                picker = picker.set_directory(dir);
+            }
+            if let Some(dir) = picker.pick_folder() {
+                self.post_program_folder(dir);
+            }
+        } else if let Some(path) = super::post_program_dialog(&target) {
+            self.post_program_path(path);
+        }
+    }
+}
diff --git a/crates/ui/src/state_program_entry.rs b/crates/ui/src/state_program_entry.rs
new file mode 100644
index 00000000..3fe11c64
--- /dev/null
+++ b/crates/ui/src/state_program_entry.rs
@@ -0,0 +1,61 @@
+//! The operation list's Pause / Home entries (#155), as the UI queues
+//! them: add one after a row (or at the active setup's end), change what
+//! it does, suppress it. Each verb is one undoable app command; delete
+//! rides `DeleteByName` and reorder `ReorderOperation`, as for an op.
+//! Provenance: our own routing; no vendor material consulted.
+
+use camcraft_app::commands::{AddProgramEntry, EditProgramEntry};
+use camcraft_app::operation::AfterOperation;
+use camcraft_app::program_entry;
+
+use super::{ErrorScope, State};
+
+/// One entry verb, carried by `CommandKind::ProgramEntry`.
+#[derive(Clone, Debug, PartialEq)]
+pub enum EntryVerb {
+    /// Add an entry asking `action`: right after the row `after` names,
+    /// or at the end of the active setup's list.
+    Add { action: AfterOperation, after: Option<String> },
+    /// What the machine does at the entry.
+    SetAction { name: String, action: AfterOperation },
+    /// Leave the entry out of the posted program, or put it back.
+    Suppress { name: String, suppressed: bool },
+}
+
+impl State {
+    pub(super) fn program_entry_verb(&mut self, verb: EntryVerb) {
+        match verb {
+            EntryVerb::Add { action, after } => match AddProgramEntry::new(&self.world, action, after.as_deref()) {
+                Ok(command) => {
+                    let name = command.name().to_owned();
+                    self.history.execute(&self.world, command);
+                    self.doc_version += 1;
+                    self.status = format!("{name} added: {}", program_entry::action_label(action));
+                }
+                Err(err) => self.refuse(ErrorScope::Operation, format!("entry not added: {err}")),
+            },
+            EntryVerb::SetAction { name, action } => match EditProgramEntry::with_action(&self.world, &name, action) {
+                Ok(command) => {
+                    self.history.execute(&self.world, command);
+                    self.doc_version += 1;
+                    self.status = format!("{name}: {}", program_entry::action_label(action));
+                }
+                Err(err) => self.refuse(ErrorScope::Operation, format!("entry not changed: {err}")),
+            },
+            EntryVerb::Suppress { name, suppressed } => {
+                match EditProgramEntry::with_suppressed(&self.world, &name, suppressed) {
+                    Ok(command) => {
+                        self.history.execute(&self.world, command);
+                        self.doc_version += 1;
+                        self.status = if suppressed {
+                            format!("{name} suppressed: left out of the posted program")
+                        } else {
+                            format!("{name} back in the posted program")
+                        };
+                    }
+                    Err(err) => self.refuse(ErrorScope::Operation, format!("suppression not changed: {err}")),
+                }
+            }
+        }
+    }
+}
diff --git a/crates/ui/src/state_recent.rs b/crates/ui/src/state_recent.rs
new file mode 100644
index 00000000..f8ca98f2
--- /dev/null
+++ b/crates/ui/src/state_recent.rs
@@ -0,0 +1,90 @@
+//! Recent projects and models on the State (issue #662): the lists are
+//! `camcraft_app::recent` preference state - read once at startup from
+//! the per-user file, noted after a successful open / import / save,
+//! written back atomically. Opening an entry rides the same paths as the
+//! dialogs (`open_project_path`, `import_path`), so the unsaved-changes
+//! prompt, the import worker and every status line are the ones Open and
+//! Model already use; the lists themselves are outside the history.
+//! Provenance: our own wiring over our own `app::recent`; no HSMWorks
+//! material.
+
+use std::path::{Path, PathBuf};
+
+use camcraft_app::recent::{self, RecentEntry, RecentKind};
+
+use super::State;
+
+impl State {
+    /// Startup: the per-user recents file (the real window only - the
+    /// headless suites never touch the user's file). A corrupt or
+    /// unreadable file starts empty and says so on the status line.
+    pub(crate) fn load_recent(&mut self) {
+        let Some(path) = recent::store_path() else {
+            eprintln!("recent files: no config folder - the lists last for this session only");
+            return;
+        };
+        self.load_recent_from(path);
+    }
+
+    /// Read the recents from `path` and keep writing back there.
+    pub fn load_recent_from(&mut self, path: PathBuf) {
+        let (lists, note) = recent::load(&path);
+        self.recent = lists;
+        self.recent_store = Some(path);
+        if let Some(why) = note {
+            self.status = why;
+        }
+    }
+
+    /// The entries one drop-down lists, newest first, each probed for
+    /// a missing file.
+    #[must_use]
+    pub fn recent_entries(&self, kind: RecentKind) -> Vec<RecentEntry> {
+        self.recent.list(kind).iter().map(|p| RecentEntry::of(p)).collect()
+    }
+
+    /// Note a successful open / import / save. A failed write is
+    /// logged (by `recent::save`), never shown over the open's own
+    /// status line.
+    pub(crate) fn note_recent(&mut self, kind: RecentKind, path: &Path) {
+        if self.recent.add(kind, path) {
+            self.persist_recent();
+        }
+    }
+
+    /// A landed import's source file (none: an inline test import).
+    pub(crate) fn note_recent_model(&mut self, file: Option<&Path>) {
+        if let Some(path) = file {
+            self.note_recent(RecentKind::Model, path);
+        }
+    }
+
+    /// Open one entry through the dialog's own path. A file that is
+    /// gone is refused by name and nothing else changes.
+    pub(crate) fn open_recent(&mut self, kind: RecentKind, path: PathBuf) {
+        let entry = RecentEntry::of(&path);
+        if entry.missing {
+            self.status = entry.refusal(kind);
+            return;
+        }
+        match kind {
+            RecentKind::Project => self.open_project_path(path),
+            RecentKind::Model => self.import_path(path),
+        }
+    }
+
+    /// "Clear recent": empty one list and write it back.
+    pub(crate) fn clear_recent(&mut self, kind: RecentKind) {
+        if self.recent.clear(kind) {
+            self.persist_recent();
+        }
+        self.status = format!("recent {}s cleared", kind.noun());
+    }
+
+    fn persist_recent(&self) {
+        let Some(path) = &self.recent_store else { return };
+        // The refusal is logged where it happens (app::recent::save);
+        // the lists in memory stay right for this session either way.
+        let _ = recent::save(path, &self.recent);
+    }
+}
diff --git a/crates/ui/src/state_setup_mount.rs b/crates/ui/src/state_setup_mount.rs
new file mode 100644
index 00000000..3cd89374
--- /dev/null
+++ b/crates/ui/src/state_setup_mount.rs
@@ -0,0 +1,164 @@
+//! The machine and post verbs, routed to whoever owns the mount (#343).
+//! The ribbon, the Stock page's machine/post groups and a setup's own
+//! Machine / Post pages all queue the same `CommandKind`s; they land on
+//! the ACTIVE setup's own machine/post (`SetSetupMachine` / `SetSetupPost`)
+//! when it owns one, and on the document's (`LoadMachine` / `SelectPost`)
+//! when it follows the document - so a verb never edits a mount the
+//! active setup does not use. Every arm is one undoable command, and a
+//! refusal names itself on the status line.
+//! Provenance: our own routing law (issue #343); no vendor material consulted.
+
+use std::path::Path;
+
+use camcraft_app::commands::{CommandError, LoadMachine, SelectPost, SetSetupMachine, SetSetupPost};
+use camcraft_app::machine::library::{self, MachineSource};
+use camcraft_app::machine::Machine;
+use camcraft_app::schema::PostRef;
+use camcraft_app::{machine, posting, setup, setup_mount};
+
+use super::{ErrorScope, State};
+
+/// Which command a routed machine verb builds.
+enum MachineVerb<'a> {
+    Builtin(&'a str),
+    File(&'a Path),
+    Mount(String, Option<Box<Machine>>),
+}
+
+impl State {
+    /// The active setup when it owns its machine: the setup the machine
+    /// verbs edit. `None` - they edit the document's.
+    #[must_use]
+    pub fn machine_owner(&self) -> Option<String> {
+        let active = setup::active(&self.world)?;
+        setup_mount::own_machine(&self.world, Some(&active)).map(|_| active)
+    }
+
+    /// The active setup when it owns its post.
+    #[must_use]
+    pub fn post_owner(&self) -> Option<String> {
+        let active = setup::active(&self.world)?;
+        setup_mount::own_post(&self.world, Some(&active)).map(|_| active)
+    }
+
+    fn route_machine(&mut self, verb: MachineVerb<'_>, done: &str, refused: &str) -> bool {
+        let executed: Result<(), CommandError> = match self.machine_owner() {
+            Some(s) => match verb {
+                MachineVerb::Builtin(n) => SetSetupMachine::builtin(&self.world, &s, n),
+                MachineVerb::File(p) => SetSetupMachine::from_file(&self.world, &s, p),
+                MachineVerb::Mount(p, m) => SetSetupMachine::new(&self.world, &s, Some((p, m.map(|b| *b)))),
+            }
+            .map(|c| self.history.execute(&self.world, c)),
+            None => match verb {
+                MachineVerb::Builtin(n) => LoadMachine::builtin(&self.world, n),
+                MachineVerb::File(p) => LoadMachine::from_file(&self.world, p),
+                MachineVerb::Mount(p, m) => LoadMachine::new(&self.world, p, m.map(|b| *b)),
+            }
+            .map(|c| self.history.execute(&self.world, c)),
+        };
+        match executed {
+            Ok(()) => {
+                self.doc_version += 1;
+                self.machine_editor = None;
+                let whose = self.machine_owner().map_or_else(String::new, |s| format!(" ({s})"));
+                self.status = format!("{done}{whose}");
+                true
+            }
+            // Refused edits keep the editor open: the draft is someone's work.
+            Err(err) => {
+                self.refuse(ErrorScope::Setup, format!("{refused}: {err}"));
+                false
+            }
+        }
+    }
+
+    /// Mount a shipped library machine by name.
+    pub(super) fn mount_builtin(&mut self, name: &str) {
+        let _ = self.route_machine(MachineVerb::Builtin(name), &format!("machine: {name} (built-in)"), "machine not loaded");
+    }
+
+    /// Mount a `.mch` file.
+    pub(super) fn mount_file(&mut self, path: &Path) {
+        if self.route_machine(MachineVerb::File(path), "machine loaded", "machine not loaded") {
+            let summary = machine::of(&self.world).1.map(|m| m.summary()).unwrap_or_default();
+            self.status = format!("machine: {summary}");
+        }
+    }
+
+    /// State the absence of a machine.
+    pub(super) fn mount_clear(&mut self) {
+        let _ = self.route_machine(MachineVerb::Mount(String::new(), None), "machine cleared", "machine not cleared");
+    }
+
+    /// The machine editor's Apply.
+    pub(super) fn mount_edited(&mut self, path: String, m: Machine) {
+        let _ = self.route_machine(MachineVerb::Mount(path, Some(Box::new(m))), "machine edited", "machine edit refused");
+    }
+
+    /// The Machines pane's "Use for this setup" (#384): the catalogue
+    /// machine is read and validated again (a refused file never
+    /// mounts), then routed like every machine verb - onto the active
+    /// setup's own machine when it has one, else the document's.
+    pub(super) fn mount_catalogue(&mut self, source: &MachineSource) {
+        match library::read_for_assign(source) {
+            Ok((path, m)) => {
+                let done = format!("machine: {path}");
+                let _ = self.route_machine(MachineVerb::Mount(path, Some(Box::new(m))), &done, "machine not assigned");
+            }
+            Err(err) => self.refuse(ErrorScope::Setup, format!("machine not assigned: {err}")),
+        }
+    }
+
+    /// Choose the post script (M3.3 A), for the active setup's own post
+    /// when it has one. Validation lives in the command constructors, so
+    /// a script that cannot run is refused at the pick, never at the post.
+    pub(super) fn choose_post(&mut self, next: PostRef) {
+        let executed = match self.post_owner() {
+            Some(s) => SetSetupPost::new(&self.world, &s, Some(next)).map(|c| self.history.execute(&self.world, c)),
+            None => SelectPost::new(&self.world, next).map(|c| self.history.execute(&self.world, c)),
+        };
+        match executed {
+            Ok(()) => {
+                self.doc_version += 1;
+                self.status = format!("post: {}", posting::post_label(&self.world));
+            }
+            Err(err) => self.refuse(ErrorScope::Setup, format!("post not selected: {err}")),
+        }
+    }
+
+    /// A setup takes its own machine (a copy of the one it mounts now, so
+    /// nothing it cuts changes) or follows the document's again.
+    pub(super) fn own_machine(&mut self, setup: &str, own: bool) {
+        let next = own.then(|| machine::of_setup(&self.world, Some(setup)));
+        match SetSetupMachine::new(&self.world, setup, next) {
+            Ok(c) => {
+                self.history.execute(&self.world, c);
+                self.doc_version += 1;
+                self.status = if own {
+                    format!("{setup} has its own machine")
+                } else {
+                    format!("{setup} follows the document's machine")
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Setup, format!("machine not changed: {err}")),
+        }
+    }
+
+    /// A setup takes its own post (a copy of the one it posts with now)
+    /// or follows the document's again.
+    pub(super) fn own_post(&mut self, setup: &str, own: bool) {
+        let next = own.then(|| setup_mount::post_of(&self.world, Some(setup)));
+        match SetSetupPost::new(&self.world, setup, next) {
+            Ok(c) => {
+                self.history.execute(&self.world, c);
+                self.doc_version += 1;
+                self.status = if own {
+                    format!("{setup} has its own post")
+                } else {
+                    format!("{setup} follows the document's post")
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Setup, format!("post not changed: {err}")),
+        }
+    }
+}
diff --git a/crates/ui/src/state_tool_body.rs b/crates/ui/src/state_tool_body.rs
new file mode 100644
index 00000000..c6c17133
--- /dev/null
+++ b/crates/ui/src/state_tool_body.rs
@@ -0,0 +1,269 @@
+//! The tool editor's body draft (#371): an imported holder mesh in its
+//! own model frame, the numeric placement (axis preset or picked face
+//! normal, tip offset), the pick mode, and the one command Apply body
+//! queues. The draft is ephemeral pane state like `ToolUi`: picks and
+//! previews only fill it; `SetToolBody` (one undo step) is the only
+//! thing that reaches the world, and its refusal lands on the Tool pane
+//! by name. Provenance: our own pane state over `app::tool_body_view`;
+//! no vendor material consulted.
+
+use std::path::Path;
+use std::sync::Arc;
+
+use camcraft_app::commands::{SetToolBody, ToolBodySpec};
+use camcraft_app::geometry::Triangle;
+use camcraft_app::schema::ToolBody;
+use camcraft_app::tool_body_view::{self, BodyPick};
+use camcraft_app::{model, tool_body};
+
+use super::{CommandKind, ErrorScope, State};
+
+/// What the next click on the editor's body preview does.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum BodyPickMode {
+    /// Drag orbits; clicks do nothing.
+    #[default]
+    Off,
+    /// The click's nearest facet corner becomes the tool tip.
+    Tip,
+    /// The clicked facet's outward normal becomes the tool axis.
+    Axis,
+}
+
+/// The editor's body draft for the tool it is open on.
+#[derive(Clone, Default)]
+pub struct ToolBodyUi {
+    /// The tool the draft belongs to (the editor's `tool_ui.name`).
+    pub tool: String,
+    /// Where the mesh came from, for display.
+    pub source: String,
+    /// The mesh in its own frame: as imported, or a landed body's
+    /// tool-frame facets (tip at the origin, +Z up) when re-edited.
+    pub facets: Arc<[Triangle]>,
+    /// The model direction that is the tool axis (tip to spindle).
+    pub axis: [f64; 3],
+    /// The model origin's height above the tip, along `axis`.
+    pub offset: f64,
+    pub pick: BodyPickMode,
+    /// The preview's orbit, radians off its default view.
+    pub yaw: f32,
+    pub pitch: f32,
+    /// The preview's zoom, log2 of the magnification over the fit view
+    /// (0 = fit), clamped to [`ZOOM_MIN`, `ZOOM_MAX`].
+    pub zoom: f32,
+    /// The view centre's shift off the fit centre, view units (right,
+    /// up): what keeps the point under the cursor fixed while zooming.
+    pub pan: [f64; 2],
+    /// The world body the draft last mirrored (identity, not value):
+    /// a change there (Apply, Undo, Redo, Open) re-mirrors.
+    seen: Option<Arc<[Triangle]>>,
+    /// Placement preview, cached against the (mesh, axis, offset) it read.
+    preview: Option<(PreviewKey, Result<ToolBody, String>)>,
+}
+
+type PreviewKey = (usize, [u64; 4]);
+
+/// The preview zoom's bounds, log2: a quarter of the fit view out to
+/// 32x in - far enough to pick a corner on a fine holder, never so far
+/// a wheel spin loses the body.
+pub const ZOOM_MIN: f32 = -2.0;
+pub const ZOOM_MAX: f32 = 5.0;
+
+/// The zoom law: `z` moved by `by` (log2), clamped; non-finite input
+/// leaves it where it was.
+#[must_use]
+pub fn clamp_zoom(z: f32, by: f32) -> f32 {
+    let next = z + by;
+    if next.is_finite() { next.clamp(ZOOM_MIN, ZOOM_MAX) } else { z.clamp(ZOOM_MIN, ZOOM_MAX) }
+}
+
+/// A body as Apply body states it, for the command queue. Debug prints
+/// the facet count, never the mesh.
+#[derive(Clone)]
+pub struct BodyDraft {
+    pub source: String,
+    pub facets: Arc<[Triangle]>,
+    pub axis: [f64; 3],
+    pub offset: f64,
+}
+
+impl std::fmt::Debug for BodyDraft {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("BodyDraft")
+            .field("source", &self.source)
+            .field("facets", &self.facets.len())
+            .field("axis", &self.axis)
+            .field("offset", &self.offset)
+            .finish()
+    }
+}
+
+fn same(a: Option<&Arc<[Triangle]>>, b: Option<&Arc<[Triangle]>>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(x), Some(y)) => Arc::ptr_eq(x, y),
+        _ => false,
+    }
+}
+
+impl State {
+    /// The body landed on the editor's tool, if any.
+    pub(crate) fn editor_tool_body(&self) -> Option<ToolBody> {
+        let e = model::find_by_name(&self.world, &self.tool_ui.name)?;
+        tool_body::body_of(&self.world, &e)
+    }
+
+    /// Keep the draft on the editor's tool: a new tool, or a world body
+    /// that changed under it, re-mirrors (a landed body re-edits in its
+    /// tool frame: +Z, offset 0, which re-applies to the same facets).
+    /// An unapplied import survives unrelated document edits.
+    pub(crate) fn sync_tool_body_ui(&mut self) {
+        let world = self.editor_tool_body();
+        let facets = world.as_ref().map(|b| Arc::clone(&b.facets));
+        if self.tool_body_ui.tool == self.tool_ui.name && same(facets.as_ref(), self.tool_body_ui.seen.as_ref()) {
+            return;
+        }
+        let mut d = ToolBodyUi { tool: self.tool_ui.name.clone(), axis: [0.0, 0.0, 1.0], ..ToolBodyUi::default() };
+        if let Some(b) = world {
+            d.source = b.source;
+            d.facets = b.facets;
+        }
+        d.seen = facets;
+        self.tool_body_ui = d;
+    }
+
+    /// "Import body…": pick a mesh file, then read it into the draft.
+    pub(crate) fn import_tool_body_dialog(&mut self) {
+        if let Some(path) = super::pick_mesh_file() {
+            self.import_tool_body_from(&path);
+        }
+    }
+
+    /// Read a STEP / STL / OBJ into the draft (+Z axis, origin at the
+    /// tip until placed). Nothing reaches the world until Apply body.
+    pub(crate) fn import_tool_body_from(&mut self, path: &Path) {
+        self.sync_tool_body_ui();
+        match tool_body_view::load(path) {
+            Ok((source, facets)) => {
+                let d = &mut self.tool_body_ui;
+                self.status = format!(
+                    "body {source}: {} facets - set the axis and tip, then Apply body",
+                    facets.len()
+                );
+                d.source = source;
+                d.facets = Arc::from(facets);
+                d.axis = [0.0, 0.0, 1.0];
+                d.offset = 0.0;
+                d.pick = BodyPickMode::Off;
+                d.preview = None;
+            }
+            Err(err) => self.refuse(ErrorScope::Tool, format!("tool body not imported: {err}")),
+        }
+    }
+
+    /// The draft's placement as `SetToolBody` would read it, cached.
+    pub(crate) fn tool_body_preview(&mut self) -> Option<&Result<ToolBody, String>> {
+        let d = &mut self.tool_body_ui;
+        if d.facets.is_empty() {
+            return None;
+        }
+        let key: PreviewKey = (
+            d.facets.as_ptr() as usize,
+            [d.axis[0].to_bits(), d.axis[1].to_bits(), d.axis[2].to_bits(), d.offset.to_bits()],
+        );
+        if d.preview.as_ref().is_none_or(|(k, _)| *k != key) {
+            d.preview = Some((key, tool_body_view::preview(&d.facets, d.axis, d.offset)));
+        }
+        d.preview.as_ref().map(|(_, r)| r)
+    }
+
+    /// A click on the preview in a pick mode fills the numbers (ephemeral).
+    pub(crate) fn apply_body_pick(&mut self, hit: BodyPick) {
+        let d = &mut self.tool_body_ui;
+        match d.pick {
+            BodyPickMode::Off => return,
+            BodyPickMode::Tip => match tool_body_view::tip_offset_at(hit.vertex, d.axis) {
+                Some(o) => {
+                    d.offset = o;
+                    let u = self.units();
+                    self.status = format!(
+                        "tip picked: offset {} {} along the axis",
+                        camcraft_app::units::len(o, u, 3),
+                        u.suffix()
+                    );
+                }
+                None => self.status = "tip not picked: set a usable axis first".into(),
+            },
+            BodyPickMode::Axis => match hit.normal {
+                Some(n) => {
+                    d.axis = n;
+                    self.status = format!(
+                        "axis picked: {}",
+                        tool_body_view::axis_label(n).map_or_else(|| format!("({:.3}, {:.3}, {:.3})", n[0], n[1], n[2]), str::to_owned)
+                    );
+                }
+                None => self.status = "axis not picked: that facet has no area".into(),
+            },
+        }
+        self.tool_body_ui.pick = BodyPickMode::Off;
+    }
+
+    /// Zoom the body preview by `by` (log2) about `about` - the cursor's
+    /// offset from the view centre in view units (right, up) at the
+    /// current zoom - so the point under it stays put. View state only.
+    pub(crate) fn zoom_body_preview(&mut self, by: f32, about: [f64; 2]) {
+        let d = &mut self.tool_body_ui;
+        let next = clamp_zoom(d.zoom, by);
+        let k = f64::from(next - d.zoom).exp2();
+        if k.is_finite() && k > 0.0 && about.iter().all(|v| v.is_finite()) {
+            d.pan[0] += about[0] * (1.0 - 1.0 / k);
+            d.pan[1] += about[1] * (1.0 - 1.0 / k);
+        }
+        d.zoom = next;
+    }
+
+    /// Fit: the default view again - orbit, zoom and pan reset.
+    pub(crate) fn fit_body_preview(&mut self) {
+        let d = &mut self.tool_body_ui;
+        (d.yaw, d.pitch, d.zoom, d.pan) = (0.0, 0.0, 0.0, [0.0; 2]);
+    }
+
+    /// "Apply body": queue the one `SetToolBody` for the draft.
+    pub(crate) fn queue_apply_tool_body(&mut self) {
+        let d = &self.tool_body_ui;
+        if d.facets.is_empty() {
+            return;
+        }
+        let body = BodyDraft { source: d.source.clone(), facets: Arc::clone(&d.facets), axis: d.axis, offset: d.offset };
+        self.pending.push_back(CommandKind::SetToolBody { name: self.tool_ui.name.clone(), body: Some(body) });
+    }
+
+    /// "Clear body": a landed body is cleared by command (undoable); an
+    /// unapplied import is only dropped from the draft.
+    pub(crate) fn clear_tool_body(&mut self) {
+        if self.editor_tool_body().is_some() {
+            self.pending.push_back(CommandKind::SetToolBody { name: self.tool_ui.name.clone(), body: None });
+        } else {
+            self.tool_body_ui = ToolBodyUi { tool: self.tool_ui.name.clone(), axis: [0.0, 0.0, 1.0], ..ToolBodyUi::default() };
+        }
+    }
+
+    /// The command handler: build (place, envelope, fit) now; a refusal
+    /// lands on the Tool pane by name and the draft stays for correction.
+    pub(crate) fn run_set_tool_body(&mut self, name: &str, body: Option<BodyDraft>) {
+        let clearing = body.is_none();
+        let spec = body.map(|b| ToolBodySpec { source: b.source, facets: b.facets.to_vec(), axis: b.axis, offset: b.offset });
+        match SetToolBody::new(&self.world, name, spec) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = if clearing {
+                    format!("tool {name}: body cleared")
+                } else {
+                    format!("tool {name}: body set")
+                };
+            }
+            Err(err) => self.refuse(ErrorScope::Tool, format!("tool body not set: {err}")),
+        }
+    }
+}
diff --git a/crates/ui/src/state_tool_library.rs b/crates/ui/src/state_tool_library.rs
new file mode 100644
index 00000000..c146ea21
--- /dev/null
+++ b/crates/ui/src/state_tool_library.rs
@@ -0,0 +1,62 @@
+//! The Tool library page's Export / Import library buttons (#300): a
+//! file dialog, then `tool_library::export_tool_library` to write, or
+//! `parse_tool_library` + `ImportTools` (one undo unit) to read. A
+//! refusal lands on the Tool pane by name, never swallowed.
+//! Provenance: our own `camcraft-tools/1` format (app::tool_library); no
+//! vendor tool-library format consulted.
+
+use std::path::{Path, PathBuf};
+
+use camcraft_app::commands::ImportTools;
+use camcraft_app::tool_library::{self, EXTENSION};
+
+use super::{ErrorScope, State};
+
+impl State {
+    /// "Export library…": ask where, then write every document tool.
+    pub(crate) fn export_tool_library_dialog(&mut self) {
+        let Some(path) = rfd::FileDialog::new()
+            .add_filter("CamCraft Tool Library", &[EXTENSION])
+            .set_file_name(format!("tools.{EXTENSION}"))
+            .save_file()
+        else {
+            return;
+        };
+        self.export_tool_library_to(&tool_library::with_library_extension(&path));
+    }
+
+    /// "Import library…": pick a file, then import it.
+    pub(crate) fn import_tool_library_dialog(&mut self) {
+        let picked: Option<PathBuf> = rfd::FileDialog::new()
+            .add_filter("CamCraft Tool Library", &[EXTENSION, "json"])
+            .pick_file();
+        if let Some(path) = picked {
+            self.import_tool_library_from(&path);
+        }
+    }
+
+    pub(crate) fn export_tool_library_to(&mut self, path: &Path) {
+        let written = tool_library::export_tool_library(&self.world)
+            .and_then(|text| std::fs::write(path, text).map_err(|e| e.to_string()));
+        match written {
+            Ok(()) => self.status = format!("tool library written to {}", path.display()),
+            Err(err) => self.refuse(ErrorScope::Tool, format!("tool library not exported: {err}")),
+        }
+    }
+
+    pub(crate) fn import_tool_library_from(&mut self, path: &Path) {
+        let planned = std::fs::read_to_string(path)
+            .map_err(|e| e.to_string())
+            .and_then(|text| tool_library::parse_tool_library(&text))
+            .and_then(|lib| ImportTools::new(&self.world, lib).map_err(|e| e.to_string()));
+        match planned {
+            Ok(command) => {
+                let summary = command.report().summary();
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = summary;
+            }
+            Err(err) => self.refuse(ErrorScope::Tool, format!("tool library not imported: {err}")),
+        }
+    }
+}
diff --git a/crates/ui/src/state_tool_profile.rs b/crates/ui/src/state_tool_profile.rs
new file mode 100644
index 00000000..0a54385e
--- /dev/null
+++ b/crates/ui/src/state_tool_profile.rs
@@ -0,0 +1,186 @@
+//! The tool editor's spun-profile draft (#93): the holder of a milling
+//! tool drawn as a revolved half-outline - Parametric (the holder
+//! cylinder the tool's numbers state, regenerated as they change) or
+//! Custom (hand-edited points that survive number edits). The draft is
+//! ephemeral pane state like `ToolBodyUi`; Apply profile queues the one
+//! command (`SetToolBody::spun`: a drawn body, or a clear back to the
+//! cylinder), and its refusal lands on the Tool pane by name. Turning
+//! tools are not spun profiles and never get this draft (owner, #93).
+//! Provenance: our own pane state over `app::tool_body_view`; no vendor
+//! material consulted.
+
+use std::sync::Arc;
+
+use camcraft_app::commands::SetToolBody;
+use camcraft_app::geometry::Triangle;
+use camcraft_app::spun::{SpunPoint, SpunProfile};
+use camcraft_app::tools::{Tool, ToolKind};
+
+use super::{CommandKind, ErrorScope, State};
+
+/// The head of an Apply profile refusal, so a later valid outline can
+/// retire exactly that message.
+const PROFILE_REFUSED: &str = "holder profile not set: ";
+
+/// Which section the editor's third column shows.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ToolColumn {
+    #[default]
+    Body,
+    Profile,
+}
+
+/// The editor's profile draft for the tool it is open on.
+#[derive(Clone, Default)]
+pub struct ToolProfileUi {
+    /// The tool the draft belongs to (the editor's `tool_ui.name`).
+    pub tool: String,
+    /// The third column's tab (view state only).
+    pub column: ToolColumn,
+    /// Custom: `points` are hand edits. Parametric: they are regenerated
+    /// from the draft tool's holder numbers every frame.
+    pub custom: bool,
+    /// The drawn holder outline, tip-up (z, r, arc).
+    pub points: Vec<SpunPoint>,
+    /// The world body the draft last mirrored (identity): Apply, Undo,
+    /// Redo or Open re-mirror.
+    seen: Option<Arc<[Triangle]>>,
+    /// The outline an Apply refused (`None` after any other outcome):
+    /// once the draft moves off it and validates, the refusal retires.
+    refused: Option<Vec<SpunPoint>>,
+}
+
+/// Is `kind` a milling tool - one a spun profile describes?
+#[must_use]
+pub fn is_spun_kind(kind: ToolKind) -> bool {
+    !matches!(kind, ToolKind::Turning | ToolKind::Groove | ToolKind::Thread | ToolKind::Form)
+}
+
+/// The parametric holder of `tool` as table points (empty when it has
+/// no holder).
+#[must_use]
+pub fn parametric_points(tool: &Tool) -> Vec<SpunPoint> {
+    SpunProfile::holder_of(tool).map(|s| s.points().to_vec()).unwrap_or_default()
+}
+
+impl State {
+    /// Keep the draft on the editor's tool: a new tool, or a world body
+    /// that changed under it, re-mirrors - a drawn body re-edits as
+    /// Custom, anything else starts Parametric. In Parametric the points
+    /// follow the draft numbers.
+    pub(crate) fn sync_tool_profile_ui(&mut self) {
+        let landed = self.editor_tool_body();
+        let facets = landed.as_ref().map(|b| Arc::clone(&b.facets));
+        let same = match (&facets, &self.tool_profile_ui.seen) {
+            (None, None) => true,
+            (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+            _ => false,
+        };
+        if self.tool_profile_ui.tool != self.tool_ui.name || !same {
+            let column = self.tool_profile_ui.column;
+            let mut d = ToolProfileUi { tool: self.tool_ui.name.clone(), column, ..ToolProfileUi::default() };
+            if let Some(spun) = landed.and_then(|b| b.spun) {
+                d.custom = true;
+                d.points = spun.points().to_vec();
+            }
+            d.seen = facets;
+            self.tool_profile_ui = d;
+        }
+        if !self.tool_profile_ui.custom {
+            self.tool_profile_ui.points = parametric_points(&self.tool_ui.to_tool());
+        }
+    }
+
+    /// Flip Parametric/Custom. Custom starts from what is drawn now (the
+    /// parametric cylinder), so the hand edits begin on the tool's own
+    /// holder; Parametric drops the edits (they live on in the history
+    /// only once applied).
+    pub(crate) fn set_profile_custom(&mut self, custom: bool) {
+        let d = &mut self.tool_profile_ui;
+        if d.custom == custom {
+            return;
+        }
+        d.custom = custom;
+        if custom && d.points.is_empty() {
+            // No holder numbers to start from: a 20 mm collar on the
+            // shank top, a shape to edit rather than an empty table.
+            let t = self.tool_ui.to_tool();
+            let zs = (t.flute_len + t.shank_len).max(0.0);
+            let r = (t.shank_d * 0.5).max(1.0) + 5.0;
+            d.points = vec![SpunPoint::line(zs, 0.0), SpunPoint::line(zs, r), SpunPoint::line(zs + 20.0, r), SpunPoint::line(zs + 20.0, 0.0)];
+        }
+    }
+
+    /// Insert a point after row `i`, midway to the next (a Custom edit).
+    pub(crate) fn insert_profile_point(&mut self, i: usize) {
+        let d = &mut self.tool_profile_ui;
+        let (Some(a), Some(b)) = (d.points.get(i).copied(), d.points.get(i + 1).copied()) else {
+            return;
+        };
+        let mid = SpunPoint::line((a.z + b.z) * 0.5, (a.r + b.r) * 0.5);
+        d.points.insert(i + 1, mid);
+        d.custom = true;
+    }
+
+    /// Remove row `i` (a Custom edit); the validation names what is left.
+    pub(crate) fn remove_profile_point(&mut self, i: usize) {
+        let d = &mut self.tool_profile_ui;
+        if i < d.points.len() {
+            d.points.remove(i);
+            d.custom = true;
+        }
+    }
+
+    /// "Apply profile": Custom lands the drawn holder; Parametric clears
+    /// any body back to the cylinder. One command either way.
+    pub(crate) fn queue_apply_tool_profile(&mut self) {
+        let d = &self.tool_profile_ui;
+        let points = d.custom.then(|| d.points.clone());
+        self.pending.push_back(CommandKind::SetToolProfile { name: self.tool_ui.name.clone(), points });
+    }
+
+    /// The command handler: validate and judge now; a refusal lands on
+    /// the Tool pane by name and the draft stays for correction.
+    pub(crate) fn run_set_tool_profile(&mut self, name: &str, points: Option<Vec<SpunPoint>>) {
+        let clearing = points.is_none();
+        self.tool_profile_ui.refused = None;
+        let tried = points.clone();
+        match SetToolBody::spun(&self.world, name, points) {
+            Ok(command) => {
+                self.history.execute(&self.world, command);
+                self.doc_version += 1;
+                self.status = if clearing {
+                    format!("tool {name}: holder back to its parametric cylinder")
+                } else {
+                    format!("tool {name}: holder profile set")
+                };
+            }
+            Err(err) => {
+                self.tool_profile_ui.refused = tried;
+                self.refuse(ErrorScope::Tool, format!("{PROFILE_REFUSED}{err}"));
+            }
+        }
+    }
+
+    /// The draft outline validates: an Apply refusal of a DIFFERENT
+    /// earlier outline no longer describes it, so it leaves the banner
+    /// (and the status line, when that still shows it). A refusal of
+    /// this very outline (e.g. the tool is gone) and any other refusal
+    /// stand.
+    pub(crate) fn retire_profile_refusal(&mut self) {
+        let d = &self.tool_profile_ui;
+        if d.refused.as_ref().is_none_or(|r| *r == d.points) {
+            return;
+        }
+        self.tool_profile_ui.refused = None;
+        if !self.error_for(ErrorScope::Tool).is_some_and(|m| m.starts_with(PROFILE_REFUSED)) {
+            return;
+        }
+        if let Some((_, msg)) = self.feedback.take()
+            && self.status == msg
+        {
+            self.status = String::from("ready");
+        }
+        self.feedback_ctx = None;
+    }
+}
