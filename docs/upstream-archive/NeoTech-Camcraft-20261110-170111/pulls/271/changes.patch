+    /// number, a quaternion off unit length by more than float noise).
+    #[must_use]
+    pub fn to_location(&self) -> Option<crate::schema::Location> {
+        let [x, y, z] = self.translation;
+        let q = self.rotation;
+        let n2 = q.iter().map(|v| v * v).sum::<f64>();
