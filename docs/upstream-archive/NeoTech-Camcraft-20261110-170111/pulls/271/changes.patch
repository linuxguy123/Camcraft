diff --git a/crates/app/src/setup_align.rs b/crates/app/src/setup_align.rs
new file mode 100644
index 00000000..80259683
--- /dev/null
+++ b/crates/app/src/setup_align.rs
@@ -0,0 +1,385 @@
+//! Part alignment per setup (#326): how the part sits on the machine for
+//! one setup - which face is up, which edge runs along X - as a rigid
+//! transform from the document frame into that setup's frame.
+//!
+//! Provenance: our own design; re-clamping a workpiece face-down or
+//! turned on the table between operations is plain shop practice, and
+//! the transform algebra is standard rigid-body math (unit quaternions,
+//! R = Rz * Ry * Rx). No vendor implementation inspected.
+//!
+//! ## The laws here
+//!
+//! - **Two frames, kept apart.** The setup frame is where the part sits
+//!   on the table; the work offset (`G54`..`G59`, [`crate::setup::wcs_slot`])
+//!   is a plain translation placed in that frame. This module never
+//!   touches the offset, and a rotated offset stays refused at the post.
+//! - **Only parts move.** The stock, the work offsets and the fixtures
+//!   of a setup are setup furniture: they are placed IN the setup frame
+//!   already, so they read their own `Location` unchanged. A part (a
+//!   model that is not a fixture) in an aligned setup reads
+//!   `alignment * Location`.
+//! - **Identity is absence.** `None` is "as modelled": every read below
+//!   then calls the very function it called before #326, so an untouched
+//!   setup is byte-identical (paths, stamps, posts and saved files).
+//! - **Refuse what is not verified.** Generation in an aligned setup is
+//!   wired for the 2D milling kinds over a whole model or the stock;
+//!   every other kind, a pick, area controls, a tilt and a non-mill
+//!   machine are refused by name ([`generation_problem`]) - never cut in
+//!   the unaligned frame.
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::{Entity, World};
+
+use crate::geometry::{Aabb, Point3, Triangle, quat_conjugate, quat_mul, quat_rotate_point, transform_point};
+use crate::model;
+use crate::schema::{Location, SetupDef};
+
+/// The alignment STORED on a named setup (`None` = as modelled, or the
+/// name wears no setup).
+#[must_use]
+pub fn stored(world: &World, setup: &str) -> Option<Location> {
+    model::find_by_name(world, setup)
+        .and_then(|e| e.entity_view(world).try_get::<&SetupDef>(|d| d.part_alignment))
+        .flatten()
+}
+
+/// The alignment of a declared setup context: the effective setup's
+/// stored transform. A document without setups has none.
+#[must_use]
+pub fn alignment(world: &World, declared: Option<&str>) -> Option<Location> {
+    crate::setup::effective(world, declared).and_then(|s| stored(world, &s))
+}
+
+/// Does any setup of the document hold the part aligned?
+#[must_use]
+pub fn any_aligned(world: &World) -> bool {
+    crate::setup::names(world).iter().any(|s| stored(world, s).is_some())
+}
+
+/// A part: a model that is not workholding. The only entities an
+/// alignment moves.
+#[must_use]
+pub fn is_part(world: &World, entity: &Entity) -> bool {
+    model::is_model(world, entity) && !model::is_fixture(world, entity)
+}
+
+/// `a` applied after `l`: the pose of something placed at `l`, seen
+/// through the rigid transform `a`.
+#[must_use]
+pub fn compose(a: Location, l: Location) -> Location {
+    Location { pos: transform_point(l.pos, a.pos, a.rot), rot: quat_mul(a.rot, l.rot) }
+}
+
+/// The inverse rigid transform (unit rotation assumed - every stored
+/// alignment passed `check_location`).
+#[must_use]
+pub fn inverse(a: Location) -> Location {
+    let rot = quat_conjugate(a.rot);
+    let p = quat_rotate_point(rot, a.pos);
+    Location { pos: Point3::new(-p.x, -p.y, -p.z), rot }
+}
+
+/// An entity's pose in a setup's frame: a part reads the setup's
+/// alignment composed onto its document `Location`; everything else -
+/// and every part of an unaligned setup - reads `transform_of` as is.
+#[must_use]
+pub fn pose_in(world: &World, entity: &Entity, declared: Option<&str>) -> Option<Location> {
+    let loc = model::transform_of(world, entity)?;
+    match alignment(world, declared) {
+        Some(a) if is_part(world, entity) => Some(compose(a, loc)),
+        _ => Some(loc),
+    }
+}
+
+/// The pose the viewport draws and picks in: the ACTIVE setup's frame.
+#[must_use]
+pub fn view_pose(world: &World, entity: &Entity) -> Option<Location> {
+    pose_in(world, entity, crate::setup::active(world).as_deref())
+}
+
+/// An entity's facets in a setup's frame ([`model::world_facets`] when
+/// nothing is aligned).
+#[must_use]
+pub fn facets_in(world: &World, entity: &Entity, declared: Option<&str>) -> Option<Vec<Triangle>> {
+    let Some(a) = alignment(world, declared).filter(|_| is_part(world, entity)) else {
+        return model::world_facets(world, entity);
+    };
+    let tris = model::facets_of(world, entity)?;
+    let loc = compose(a, model::transform_of(world, entity).unwrap_or_default());
+    Some(
+        tris.iter()
+            .map(|t| Triangle::new(
+                transform_point(t.a, loc.pos, loc.rot),
+                transform_point(t.b, loc.pos, loc.rot),
+                transform_point(t.c, loc.pos, loc.rot),
+            ))
+            .collect(),
+    )
+}
+
+fn bounds(points: impl Iterator<Item = Point3>) -> Option<Aabb> {
+    let mut min = [f64::MAX; 3];
+    let mut max = [f64::MIN; 3];
+    let mut any = false;
+    for p in points {
+        for (axis, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+            if v.is_finite() {
+                min[axis] = min[axis].min(v);
+                max[axis] = max[axis].max(v);
+                any = true;
+            }
+        }
+    }
+    any.then(|| Aabb {
+        min: Point3::new(min[0], min[1], min[2]),
+        max: Point3::new(max[0], max[1], max[2]),
+    })
+}
+
+/// One entity's bounds in a setup's frame.
+#[must_use]
+pub fn entity_aabb_in(world: &World, entity: &Entity, declared: Option<&str>) -> Option<Aabb> {
+    if alignment(world, declared).is_none() {
+        return model::entity_world_aabb(world, entity);
+    }
+    let tris = facets_in(world, entity, declared)?;
+    bounds(tris.iter().flat_map(|t| [t.a, t.b, t.c]))
+}
+
+/// [`model::solid_world_aabb`] in a setup's frame: the same entity set
+/// (every model), the parts aligned.
+#[must_use]
+pub fn solid_aabb_in(world: &World, declared: Option<&str>) -> Option<Aabb> {
+    if alignment(world, declared).is_none() {
+        return model::solid_world_aabb(world);
+    }
+    let tris: Vec<Triangle> = model::model_entities(world)
+        .into_iter()
+        .filter_map(|(_, e)| facets_in(world, &e, declared))
+        .flatten()
+        .collect();
+    bounds(tris.iter().flat_map(|t| [t.a, t.b, t.c]))
+}
+
+/// [`model::solid_world_radius_about`] in a setup's frame.
+#[must_use]
+pub fn solid_radius_about_in(world: &World, declared: Option<&str>, c: [f64; 2]) -> Option<f64> {
+    if alignment(world, declared).is_none() {
+        return model::solid_world_radius_about(world, c);
+    }
+    model::model_entities(world)
+        .into_iter()
+        .filter_map(|(_, e)| facets_in(world, &e, declared))
+        .flatten()
+        .flat_map(|t| [t.a, t.b, t.c])
+        .map(|p| (p.x - c[0]).hypot(p.y - c[1]))
+        .filter(|r| r.is_finite())
+        .reduce(f64::max)
+}
+
+/// The parts (fixtures left out) as the machine must leave them, in a
+/// setup's frame - the program sim's gouge target.
+#[must_use]
+pub fn parts_facets_in(world: &World, declared: Option<&str>) -> Vec<Triangle> {
+    model::model_entities(world)
+        .into_iter()
+        .filter(|(_, e)| !model::is_fixture(world, e))
+        .filter_map(|(_, e)| facets_in(world, &e, declared))
+        .flatten()
+        .collect()
+}
+
+/// The quick choices the Setups page offers. Absolute: each one REPLACES
+/// the setup's alignment (they do not stack), turning the part about the
+/// centre of its bounds so it stays where it was on the table.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AlignPreset {
+    AsModelled,
+    FlipX,
+    FlipY,
+    TurnZ90,
+    TurnZ180,
+    TurnZ270,
+}
+
+impl AlignPreset {
+    pub const ALL: [AlignPreset; 6] = [
+        AlignPreset::AsModelled,
+        AlignPreset::FlipX,
+        AlignPreset::FlipY,
+        AlignPreset::TurnZ90,
+        AlignPreset::TurnZ180,
+        AlignPreset::TurnZ270,
+    ];
+
+    #[must_use]
+    pub fn label(self) -> &'static str {
+        match self {
+            AlignPreset::AsModelled => "As modelled",
+            AlignPreset::FlipX => "Flip over X",
+            AlignPreset::FlipY => "Flip over Y",
+            AlignPreset::TurnZ90 => "Turn 90° about Z",
+            AlignPreset::TurnZ180 => "Turn 180° about Z",
+            AlignPreset::TurnZ270 => "Turn 270° about Z",
+        }
+    }
+
+    /// The preset as (about X, about Y, about Z) degrees.
+    #[must_use]
+    pub fn angles(self) -> [f64; 3] {
+        match self {
+            AlignPreset::AsModelled => [0.0, 0.0, 0.0],
+            AlignPreset::FlipX => [180.0, 0.0, 0.0],
+            AlignPreset::FlipY => [0.0, 180.0, 0.0],
+            AlignPreset::TurnZ90 => [0.0, 0.0, 90.0],
+            AlignPreset::TurnZ180 => [0.0, 0.0, 180.0],
+            AlignPreset::TurnZ270 => [0.0, 0.0, 270.0],
+        }
+    }
+}
+
+/// A rotation about one axis (0 = X, 1 = Y, 2 = Z) by `deg` degrees,
+/// exact for the quarter turns (a preset flip moves vertices by exact
+/// sign changes, not by a 1e-16 cosine). `None` for a non-finite angle.
+#[must_use]
+pub fn axis_quat(axis: usize, deg: f64) -> Option<[f64; 4]> {
+    if !deg.is_finite() || axis > 2 {
+        return None;
+    }
+    let turn = deg.rem_euclid(360.0);
+    let h = std::f64::consts::FRAC_1_SQRT_2;
+    let (s, c) = if turn == 0.0 {
+        (0.0, 1.0)
+    } else if turn == 90.0 {
+        (h, h)
+    } else if turn == 180.0 {
+        (1.0, 0.0)
+    } else if turn == 270.0 {
+        (h, -h)
+    } else {
+        (0.5 * turn.to_radians()).sin_cos()
+    };
+    let mut q = [0.0, 0.0, 0.0, c];
+    q[axis] = s;
+    Some(q)
+}
+
+/// The rotation for (about X, about Y, about Z) degrees, applied X first,
+/// then Y, then Z (R = Rz * Ry * Rx, `quat_from_euler`'s order).
+#[must_use]
+pub fn rotation_from_angles(deg: [f64; 3]) -> Option<[f64; 4]> {
+    let [x, y, z] = [axis_quat(0, deg[0])?, axis_quat(1, deg[1])?, axis_quat(2, deg[2])?];
+    Some(quat_mul(z, quat_mul(y, x)))
+}
+
+/// Is this rotation the identity (within a micro-radian)?
+#[must_use]
+pub fn is_identity_rot(q: [f64; 4]) -> bool {
+    q[3].abs() >= 1.0 - 1e-12
+}
+
+/// The preset a stored rotation is, if any (a quaternion and its negation
+/// are one rotation).
+#[must_use]
+pub fn preset_of(rot: [f64; 4]) -> Option<AlignPreset> {
+    AlignPreset::ALL.into_iter().find(|p| {
+        // q^-1 * rot is the identity when they are the same turn.
+        rotation_from_angles(p.angles()).is_some_and(|q| is_identity_rot(quat_mul(quat_conjugate(q), rot)))
+    })
+}
+
+/// A stored alignment as (about X, about Y, about Z) degrees, rounded to
+/// a millionth so a quarter turn reads 90, not 89.99999999.
+#[must_use]
+pub fn angles_of(a: Option<Location>) -> [f64; 3] {
+    let Some(a) = a else { return [0.0; 3] };
+    let (r, p, y) = crate::geometry::quat_to_euler(a.rot);
+    [r, p, y].map(|v| {
+        let d = (v.to_degrees() * 1e6).round() / 1e6;
+        if d == 0.0 { 0.0 } else { d } // no "-0"
+    })
+}
+
+/// The plain words for a setup's alignment - a preset's name, or the
+/// three angles - shared by the Setups page and the setup sheet.
+#[must_use]
+pub fn describe(a: Option<Location>) -> String {
+    let Some(loc) = a else { return AlignPreset::AsModelled.label().to_owned() };
+    if let Some(p) = preset_of(loc.rot) {
+        return p.label().to_owned();
+    }
+    let [x, y, z] = angles_of(a);
+    format!("turned X {x}°, Y {y}°, Z {z}°")
+}
+
+/// The parts' bounds centre in the DOCUMENT frame - the pivot every
+/// preset and numeric turn rotates about. `None` with no part geometry.
+#[must_use]
+pub fn part_centre(world: &World) -> Option<Point3> {
+    let tris: Vec<Triangle> = model::model_entities(world)
+        .into_iter()
+        .filter(|(_, e)| !model::is_fixture(world, e))
+        .filter_map(|(_, e)| model::world_facets(world, &e))
+        .flatten()
+        .collect();
+    let b = bounds(tris.iter().flat_map(|t| [t.a, t.b, t.c]))?;
+    Some(Point3::new(
+        0.5 * (b.min.x + b.max.x),
+        0.5 * (b.min.y + b.max.y),
+        0.5 * (b.min.z + b.max.z),
+    ))
+}
+
+/// The alignment that turns the parts by `rot` about their bounds centre
+/// `c`: p' = R (p - c) + c. The identity rotation is `None` (as modelled).
+#[must_use]
+pub fn about_centre(rot: [f64; 4], c: Point3) -> Option<Location> {
+    if is_identity_rot(rot) {
+        return None;
+    }
+    let rc = quat_rotate_point(rot, c);
+    Some(Location { pos: Point3::new(c.x - rc.x, c.y - rc.y, c.z - rc.z), rot })
+}
+
+/// The op kinds whose every world read is wired through this module's
+/// setup-frame helpers, and pinned by tests in an aligned setup.
+fn verified_kind(params: &crate::operation::OpParams) -> bool {
+    use crate::operation::OpParams;
+    matches!(
+        params,
+        OpParams::Face { .. } | OpParams::Pocket { .. } | OpParams::Contour { .. } | OpParams::Adaptive2D { .. }
+    )
+}
+
+/// Why an operation may not be generated in its setup's aligned frame
+/// yet - `None` when the setup is unaligned (nothing changes) or the op
+/// is one this slice verified. Read at the door of every generation
+/// (`collect_job`), so an unverified op is refused by name and never cut
+/// in the unaligned frame.
+#[must_use]
+pub fn generation_problem(world: &World, op: &crate::schema::Operation) -> Option<String> {
+    use crate::operation::SrcRef;
+    let setup = crate::setup::effective(world, op.setup.as_deref())?;
+    stored(world, &setup)?;
+    let head = format!("setup '{setup}' holds the part turned (part alignment)");
+    if crate::machine::kind_of_setup(world, Some(&setup)) != crate::machine::Kind::Mill {
+        return Some(format!("{head} - an aligned part is not supported yet on a lathe or mill-turn machine"));
+    }
+    if !verified_kind(&op.params) {
+        return Some(format!(
+            "{head} - {} is not supported yet in an aligned setup (Face, 2D Contour, 2D Pocket and \
+             2D Adaptive are); set the setup's part alignment back to As modelled, or machine it in another setup",
+            op.params.kind().info().label
+        ));
+    }
+    if op.params.tilt().is_some() {
+        return Some(format!("{head} - a tilted plane is not supported yet in an aligned setup"));
+    }
+    if matches!(op.src, SrcRef::Selection(_)) {
+        return Some(format!("{head} - picked faces and edges are not supported yet in an aligned setup; pick a whole model or the stock"));
+    }
+    if !op.area.is_default() {
+        return Some(format!("{head} - area controls are not supported yet in an aligned setup"));
+    }
+    None
+}
diff --git a/crates/app/src/setup_mount.rs b/crates/app/src/setup_mount.rs
new file mode 100644
index 00000000..6bed64e0
--- /dev/null
+++ b/crates/app/src/setup_mount.rs
@@ -0,0 +1,168 @@
+//! Each setup's machine and post (#343): which `.mch` a setup is clamped
+//! on and which post script writes its program. A setup either owns its
+//! mount (`SetupDef::machine` / `SetupDef::post` set) or follows the
+//! document's (`None` - every file before v55), so an untouched document
+//! mounts and posts byte for byte as before.
+//!
+//! ## Every op on its own mount (#388)
+//!
+//! The ACTIVE setup's mount ([`crate::machine::of`],
+//! [`crate::posting::post_of`]) is what the ribbon, the Setup pane and
+//! the new-op door read - a new op joins the active setup. Every law
+//! that judges an EXISTING operation reads that operation's own setup
+//! instead ([`machine_of`], [`crate::machine::kind_of_setup`],
+//! [`crate::posting::post_of_setup`]): generation, the spindle law, the
+//! rest reading, the fixture table, the limit check. So an inactive
+//! setup's op is generated against its own machine without activating
+//! it - never against whatever steel happens to be active.
+//!
+//! A program whose setups mount different machines or posts posts as
+//! one file per [`Mount`] ([`program_mounts`];
+//! `posting::post_mounts`), each through its own post for its own
+//! machine; with one mount (the default) the post is one file, byte for
+//! byte as before.
+//!
+//! Provenance: our own design; a setup being one clamping on one
+//! machine, posted by that machine's post, is general machine-shop
+//! practice - no vendor implementation inspected.
+
+use flecs_ecs::core::WorldGet;
+use flecs_ecs::prelude::World;
+
+use crate::machine::Machine;
+use crate::model;
+use crate::schema::{MachineDef, PostRef};
+use crate::setup;
+
+/// The document's machine as stored (the singleton), what setups that
+/// own no machine follow. `("", None)` when none was ever loaded.
+#[must_use]
+pub fn document_machine(world: &World) -> (String, Option<Machine>) {
+    world
+        .try_get::<&MachineDef>(|d| (d.path.clone(), d.machine.clone()))
+        .unwrap_or_default()
+}
+
+/// The document's post as stored (the singleton).
+#[must_use]
+pub fn document_post(world: &World) -> PostRef {
+    world.try_get::<&PostRef>(|p| p.clone()).unwrap_or_default()
+}
+
+/// The machine a declared setup context mounts: its own, else the
+/// document's. `None` resolves to the first setup (the implicit-setup
+/// law); a document without setups mounts the document's machine.
+#[must_use]
+pub fn machine_of(world: &World, declared: Option<&str>) -> (String, Option<Machine>) {
+    match own_machine(world, declared) {
+        Some(m) => (m.path, m.machine),
+        None => document_machine(world),
+    }
+}
+
+/// The post a declared setup context runs: its own, else the document's.
+#[must_use]
+pub fn post_of(world: &World, declared: Option<&str>) -> PostRef {
+    own_post(world, declared).unwrap_or_else(|| document_post(world))
+}
+
+/// The kind of the machine a declared setup context mounts (#388) -
+/// what every law judging one operation reads, so an inactive setup's
+/// op is judged on its own steel (`crate::machine::kind_of_setup`).
+/// Reads the singleton without a clone unless the setup owns its machine.
+#[must_use]
+pub fn kind_of_setup(world: &World, declared: Option<&str>) -> crate::machine::Kind {
+    if let Some(own) = own_machine(world, declared) {
+        return crate::machine::kind(own.machine.as_ref());
+    }
+    world
+        .try_get::<&MachineDef>(|d| crate::machine::kind(d.machine.as_ref()))
+        .unwrap_or(crate::machine::Kind::Mill)
+}
+
+/// The setup's own machine, `None` when it follows the document.
+#[must_use]
+pub fn own_machine(world: &World, declared: Option<&str>) -> Option<MachineDef> {
+    let name = setup::effective(world, declared)?;
+    setup::def_of(world, &name)?.machine
+}
+
+/// The setup's own post, `None` when it follows the document.
+#[must_use]
+pub fn own_post(world: &World, declared: Option<&str>) -> Option<PostRef> {
+    let name = setup::effective(world, declared)?;
+    setup::def_of(world, &name)?.post
+}
+
+/// A machine's display name: the file's model, else its path, else
+/// "no machine".
+#[must_use]
+pub fn machine_label(m: &(String, Option<Machine>)) -> String {
+    match &m.1 {
+        Some(def) if !def.model.is_empty() => def.model.clone(),
+        _ if !m.0.is_empty() => m.0.clone(),
+        Some(_) => "unnamed machine".to_owned(),
+        None => "no machine".to_owned(),
+    }
+}
+
+/// One mount of the program (#388): the setups (program order) that
+/// share one machine and one post - what one NC file is written by.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Mount {
+    /// Effective setup names, program order; `""` for the implicit
+    /// setup of a document that declares none.
+    pub setups: Vec<String>,
+    pub machine: (String, Option<Machine>),
+    pub post: PostRef,
+}
+
+impl Mount {
+    /// The mount as a refusal or a status line names it.
+    #[must_use]
+    pub fn label(&self) -> String {
+        let names = if self.setups.iter().all(String::is_empty) {
+            "the setup".to_owned()
+        } else {
+            self.setups.join(", ")
+        };
+        format!(
+            "{names} ({}, {})",
+            machine_label(&self.machine),
+            crate::posting::post_ref_label(&self.post)
+        )
+    }
+}
+
+/// The program's mounts in program order of first use: every
+/// unsuppressed operation's setup, grouped with the setups that mount
+/// the same machine and - when `by_post` - the same post (a caller
+/// overriding the post groups by machine alone). One entry for every
+/// document whose setups own no mount; empty when nothing would post.
+#[must_use]
+pub fn program_mounts(world: &World, by_post: bool) -> Vec<Mount> {
+    let mut out: Vec<Mount> = Vec::new();
+    for (_, e) in setup::operation_order(world) {
+        let Some(op) = model::operation_of(world, &e) else {
+            continue;
+        };
+        if op.suppressed {
+            continue;
+        }
+        let here = setup::effective(world, op.setup.as_deref());
+        let name = here.clone().unwrap_or_default();
+        if out.iter().any(|m| m.setups.contains(&name)) {
+            continue;
+        }
+        let machine = machine_of(world, here.as_deref());
+        let post = post_of(world, here.as_deref());
+        match out
+            .iter_mut()
+            .find(|m| m.machine == machine && (!by_post || m.post == post))
+        {
+            Some(m) => m.setups.push(name),
+            None => out.push(Mount { setups: vec![name], machine, post }),
+        }
+    }
+    out
+}
diff --git a/crates/app/src/setup_relative.rs b/crates/app/src/setup_relative.rs
new file mode 100644
index 00000000..d219141f
--- /dev/null
+++ b/crates/app/src/setup_relative.rs
@@ -0,0 +1,261 @@
+//! Setup-to-setup transforms (#316): how the part moved between two
+//! setups (a flip, a turn on the table), and the link that makes one
+//! setup a re-clamp of another.
+//!
+//! Provenance: our own design; re-clamping a part flipped or turned
+//! between operations is plain shop practice, and the algebra is
+//! standard rigid-body composition (T = A_to * A_from^-1). No vendor
+//! implementation inspected.
+//!
+//! ## The laws here
+//!
+//! - **One transform, not two.** Each setup stores ONE rigid transform,
+//!   its part alignment (#326, document -> setup frame). The transform
+//!   between two setups is derived from those two
+//!   ([`transform_between`]); nothing here stores a second one.
+//! - **On the part, never the work offset.** The work offset is a plain
+//!   translation placed in the setup frame (`G54`..`G59` from
+//!   [`crate::setup::wcs_slot`]); it says where zero is, not how the
+//!   part moved, so no transform is read from it.
+//! - **A link carries edits.** A setup placed relative to another keeps
+//!   the transform between them when that other setup's alignment
+//!   changes ([`carried`]): `AlignPartToSetup` re-places every linked
+//!   setup in the same undo unit, or refuses the whole change by name.
+//! - **Refuse what is not rigid.** A missing setup, a name that is no
+//!   setup, a non-finite or non-unit stored transform: named errors,
+//!   never an identity guess.
+
+use flecs_ecs::prelude::World;
+
+use crate::geometry::{Point3, transform_point};
+use crate::schema::Location;
+use crate::setup;
+use crate::setup_align::{self, compose, inverse};
+
+/// Is this transform the identity (a micron, a micro-radian)?
+#[must_use]
+pub fn is_still(a: Location) -> bool {
+    let p = a.pos;
+    p.x.abs() <= 1e-9 && p.y.abs() <= 1e-9 && p.z.abs() <= 1e-9 && setup_align::is_identity_rot(a.rot)
+}
+
+/// Identity is absence: the stored form of an alignment.
+#[must_use]
+pub fn normalised(a: Location) -> Option<Location> {
+    (!is_still(a)).then_some(a)
+}
+
+/// Do two stored alignments hold the part the same way?
+#[must_use]
+pub fn same(a: Option<Location>, b: Option<Location>) -> bool {
+    is_still(compose(a.unwrap_or_default(), inverse(b.unwrap_or_default())))
+}
+
+/// The setup a setup is placed relative to (`None`: not linked, or no
+/// such setup).
+#[must_use]
+pub fn relative_to(world: &World, name: &str) -> Option<String> {
+    setup::def_of(world, name).and_then(|d| d.relative_to)
+}
+
+/// The setups placed directly relative to `parent`, in setup order.
+#[must_use]
+pub fn dependents(world: &World, parent: &str) -> Vec<String> {
+    setup::names(world)
+        .into_iter()
+        .filter(|n| relative_to(world, n).as_deref() == Some(parent))
+        .collect()
+}
+
+/// Does following the links up from `from` reach `target` (or is `from`
+/// itself)? Bounded by the setup count, so a looped world cannot hang.
+#[must_use]
+pub fn links_back_to(world: &World, from: &str, target: &str) -> bool {
+    let mut at = Some(from.to_owned());
+    for _ in 0..=setup::names(world).len() {
+        match at {
+            Some(n) if n == target => return true,
+            Some(n) => at = relative_to(world, &n),
+            None => return false,
+        }
+    }
+    true // a loop: treat as reaching, so the caller refuses
+}
+
+/// A setup's stored alignment, checked rigid; refused by name.
+fn rigid_alignment(world: &World, name: &str) -> Result<Location, String> {
+    let def = setup::def_of(world, name).ok_or_else(|| {
+        if crate::model::find_by_name(world, name).is_some() {
+            format!("'{name}' is not a setup")
+        } else {
+            format!("there is no setup named '{name}'")
+        }
+    })?;
+    let Some(a) = def.part_alignment else { return Ok(Location::default()) };
+    let [x, y, z, w] = a.rot;
+    let norm = (x * x + y * y + z * z + w * w).sqrt();
+    if !a.pos.is_finite() || !norm.is_finite() || (norm - 1.0).abs() > 1e-9 {
+        return Err(format!("setup '{name}' holds the part at a placement that is not a rigid transform"));
+    }
+    Ok(a)
+}
+
+/// The rigid transform that takes the part as it sits in setup `from` to
+/// where it sits in setup `to`: `p_to = T * p_from`, with
+/// `T = A_to * A_from^-1` from the two part alignments. The identity for
+/// `from == to` and for two setups holding the part alike. Composes
+/// (A -> C = (B -> C) * (A -> B)) and inverts (B -> A = (A -> B)^-1).
+///
+/// # Errors
+/// A name that is no setup, or a stored alignment that is not rigid -
+/// named, never read as the identity.
+pub fn transform_between(world: &World, from: &str, to: &str) -> Result<Location, String> {
+    let a_from = rigid_alignment(world, from)?;
+    let a_to = rigid_alignment(world, to)?;
+    let t = compose(a_to, inverse(a_from));
+    if !t.pos.is_finite() || t.rot.iter().any(|v| !v.is_finite()) {
+        return Err(format!("the transform from setup '{from}' to setup '{to}' is not finite"));
+    }
+    Ok(t)
+}
+
+/// The alignment of a setup turned by `rot` RELATIVE to setup `parent`:
+/// the part as `parent` holds it, turned in `parent`'s frame about the
+/// centre of its bounds there (so a flip keeps it on the same spot of
+/// the table). `Ok(None)` is "as modelled" (the identity overall).
+///
+/// # Errors
+/// `parent` is no rigid setup, or there is no part to turn.
+pub fn relative_alignment(world: &World, parent: &str, rot: [f64; 4]) -> Result<Option<Location>, String> {
+    let p = rigid_alignment(world, parent)?;
+    if setup_align::is_identity_rot(rot) {
+        return Ok(normalised(p));
+    }
+    let c = setup_align::part_centre(world).ok_or_else(|| "there is no part to turn - import a model first".to_owned())?;
+    let c_in_parent = transform_point(c, p.pos, p.rot);
+    let turn = setup_align::about_centre(rot, c_in_parent).unwrap_or_default();
+    Ok(normalised(compose(turn, p)))
+}
+
+/// Every setup linked (directly or through others) below `parent`, with
+/// its alignment before and after `parent`'s changes from `prev` to
+/// `next` - each keeps the transform it had to the setup it is linked
+/// to. Parents come before their children; a setup whose alignment would
+/// not change is left out. Loops are cut (each setup visited once).
+#[must_use]
+pub fn carried(
+    world: &World,
+    parent: &str,
+    prev: Option<Location>,
+    next: Option<Location>,
+) -> Vec<(String, Option<Location>, Option<Location>)> {
+    let mut out = Vec::new();
+    let mut seen = vec![parent.to_owned()];
+    let mut queue = vec![(parent.to_owned(), prev, next)];
+    while let Some((p, p_prev, p_next)) = queue.pop() {
+        for child in dependents(world, &p) {
+            if seen.contains(&child) {
+                continue;
+            }
+            seen.push(child.clone());
+            let c_prev = setup_align::stored(world, &child);
+            let rel = compose(c_prev.unwrap_or_default(), inverse(p_prev.unwrap_or_default()));
+            let moved = compose(rel, p_next.unwrap_or_default());
+            let c_next = normalised(Location { rot: unit(moved.rot), ..moved });
+            if !same(c_prev, c_next) {
+                out.push((child.clone(), c_prev, c_next));
+            }
+            queue.push((child, c_prev, c_next));
+        }
+    }
+    out
+}
+
+/// Re-normalise a product of unit quaternions (float drift only).
+fn unit(q: [f64; 4]) -> [f64; 4] {
+    let n = q.iter().map(|v| v * v).sum::<f64>().sqrt();
+    if n.is_finite() && n > 0.0 { q.map(|v| v / n) } else { q }
+}
+
+/// The plain words for how a linked setup sits against the setup it is
+/// placed relative to: "Same as Setup1", "Flip over X from Setup1", or
+/// the three angles. `None` for a setup that is not linked.
+#[must_use]
+pub fn describe(world: &World, name: &str) -> Option<String> {
+    let parent = relative_to(world, name)?;
+    let Ok(t) = transform_between(world, &parent, name) else {
+        return Some(format!("placed relative to {parent} (the transform cannot be read)"));
+    };
+    if is_still(t) {
+        return Some(format!("Same as {parent}"));
+    }
+    let words = match setup_align::preset_of(t.rot) {
+        Some(p) if p != setup_align::AlignPreset::AsModelled => p.label().to_owned(),
+        Some(_) => "Moved".to_owned(),
+        None => {
+            let [x, y, z] = setup_align::angles_of(Some(t));
+            format!("Turned X {x}°, Y {y}°, Z {z}°")
+        }
+    };
+    Some(format!("{words} from {parent}"))
+}
+
+/// The turn (about X, then Y, then Z) a linked setup holds against its
+/// parent, in degrees - the typed-angle draft of the page.
+#[must_use]
+pub fn angles(world: &World, name: &str) -> [f64; 3] {
+    relative_to(world, name)
+        .and_then(|p| transform_between(world, &p, name).ok())
+        .map_or([0.0; 3], |t| setup_align::angles_of(Some(t)))
+}
+
+/// The rotation part of a turn given as angles, refused when not finite.
+///
+/// # Errors
+/// A non-finite angle.
+pub fn rotation(deg: [f64; 3]) -> Result<[f64; 4], String> {
+    setup_align::rotation_from_angles(deg).ok_or_else(|| "the turn angles must be finite numbers".to_owned())
+}
+
+/// A point carried from one setup's frame into another's.
+///
+/// # Errors
+/// As [`transform_between`].
+pub fn carry_point(world: &World, from: &str, to: &str, p: Point3) -> Result<Point3, String> {
+    let t = transform_between(world, from, to)?;
+    Ok(transform_point(p, t.pos, t.rot))
+}
+
+/// Where a setup's WCS (work offset) is drawn while the viewport shows
+/// the ACTIVE setup's frame (#558). A WCS is setup furniture: placed in
+/// its own setup's frame, so a point fixed on the part there. Another
+/// setup's WCS therefore goes through the same rigid transform the part
+/// goes through between the two frames ([`transform_between`]) - it stays
+/// on the same spot of the part, wherever the active setup holds it.
+///
+/// `Ok(Some(pose))`: draw it there. `Ok(None)`: the name is no setup's
+/// WCS, or the document has no active setup - the caller draws the
+/// stored pose (every document before #326, and every WCS of the active
+/// setup itself, map through the identity).
+///
+/// # Errors
+/// The owning setup's transform to the active one is refused (no rigid
+/// alignment) - the caller must not draw it at a guessed place.
+pub fn wcs_view_pose(world: &World, wcs_name: &str, stored: Location) -> Result<Option<Location>, String> {
+    let Some(active) = setup::active(world) else {
+        return Ok(None);
+    };
+    let owners: Vec<String> = setup::names(world)
+        .into_iter()
+        .filter(|s| setup::wcs_entity_name(world, Some(s)) == wcs_name)
+        .collect();
+    if owners.is_empty() || owners.contains(&active) {
+        return Ok(None); // not a setup's WCS, or the active setup's own
+    }
+    // A WCS two setups share sits in each one's frame alike only when they
+    // hold the part alike; map from the first owner, refused by name else.
+    let t = transform_between(world, &owners[0], &active).inspect_err(|e| {
+        tracing::debug!(wcs = wcs_name, "not drawn in setup '{active}' frame: {e}");
+    })?;
+    Ok(Some(compose(t, stored)))
+}
diff --git a/crates/app/src/setup_sheet/mod.rs b/crates/app/src/setup_sheet/mod.rs
index ca142979..28d772f7 100644
--- a/crates/app/src/setup_sheet/mod.rs
+++ b/crates/app/src/setup_sheet/mod.rs
