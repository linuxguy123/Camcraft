+    // y = z x x is model -Z here; only |y| is ever read.
+    assert!((placed[0][2][1].abs() - 5.0).abs() < 1e-12 && placed[0][2][0].abs() < 1e-12 && placed[0][2][2].abs() < 1e-12);
+}
