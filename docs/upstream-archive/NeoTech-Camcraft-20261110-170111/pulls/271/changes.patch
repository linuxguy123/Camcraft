diff --git a/crates/app/src/posting_suppressed.rs b/crates/app/src/posting_suppressed.rs
new file mode 100644
index 00000000..611ed8e3
--- /dev/null
+++ b/crates/app/src/posting_suppressed.rs
@@ -0,0 +1,38 @@
+//! The suppression clause of the verification gate (#110 review B1): a
+//! posted operation whose verdicts read the program ahead was generated
+//! against every earlier same-setup cut, suppressed ones included. Left
+//! out of the NC, that cut is never made - the later op's rapids and
+//! full-engagement passes would land in stock nothing judged - so the
+//! post refuses by name instead of assuming the part is already cut.
+//!
+//! Provenance: our own design notes (the rest-machining dependency of
+//! `rest.rs` read back at post time); no vendor material consulted.
+
+use flecs_ecs::prelude::World;
+
+use crate::model;
+
+/// One line per (posted op, suppressed cut ahead of it) pair, in
+/// program order. Empty when nothing suppressed cut ahead of an op that
+/// reads the program ahead.
+#[must_use]
+pub(super) fn suppressed_problems(world: &World) -> Vec<String> {
+    let mut out = Vec::new();
+    for (name, e) in crate::setup::operation_order(world) {
+        let Some(op) = model::operation_of(world, &e) else {
+            continue;
+        };
+        // A suppressed op posts nothing, and an op whose verdicts never
+        // read the program ahead (a posed op) assumed nothing of it.
+        if op.suppressed || !crate::operation::reads_prior(&op.params) {
+            continue;
+        }
+        for gone in crate::rest::suppressed_cuts_ahead(world, &name, op.setup.as_deref()) {
+            out.push(format!(
+                "operation {name} was generated against the cut of suppressed {gone}; \
+                 unsuppress {gone} or suppress {name} too"
+            ));
+        }
+    }
+    out
+}
diff --git a/crates/app/src/posting_wcs_rotation.rs b/crates/app/src/posting_wcs_rotation.rs
new file mode 100644
index 00000000..1811ca3c
--- /dev/null
+++ b/crates/app/src/posting_wcs_rotation.rs
@@ -0,0 +1,133 @@
+//! The rotated-work-offset clause of the verification gate (#315). A
+//! work offset may carry a rotation (`SetWcsOrigin`, the 3-2-1
+//! alignment of #187), but the post speaks translation only: the
+//! stream carries `OriginX/Y/Z` and every shipped script subtracts that
+//! origin from world coordinates. A rotated offset would therefore post
+//! a program turned against the part. Until the rotation is carried
+//! (baked into the coordinates or a control cycle - #315 step 3), the
+//! post refuses it by name; an offset within [`ROT_TOL_RAD`] of the
+//! identity posts exactly as before.
+//!
+//! Provenance: our own design notes (the G54 register is translation
+//! only - public RS-274 / ISO 6983 work-offset semantics); no vendor
+//! material consulted.
+
+use flecs_ecs::prelude::World;
+
+use crate::model;
+use crate::schema::{Location, WCS_SLOTS};
+
+use super::wcs_slot::wcs_slot;
+
+/// Rotation angle below which an offset counts as unrotated: 1e-9 rad
+/// turns a point 1 m out by 1 nm - far under any machine resolution,
+/// and far over the float noise of a normalized identity quaternion.
+pub(crate) const ROT_TOL_RAD: f64 = 1e-9;
+
+/// Angle (rad, in [0, pi]) and unit axis of a unit quaternion (x, y, z, w).
+/// `atan2` rather than `acos(w)`, which is ill-conditioned near identity.
+fn angle_axis(q: [f64; 4]) -> (f64, [f64; 3]) {
+    let s = (q[0] * q[0] + q[1] * q[1] + q[2] * q[2]).sqrt();
+    if !s.is_finite() || s <= 0.0 {
+        return (0.0, [0.0, 0.0, 1.0]);
+    }
+    let sign = if q[3] < 0.0 { -1.0 } else { 1.0 };
+    let angle = 2.0 * s.atan2(q[3].abs());
+    (angle, [sign * q[0] / s, sign * q[1] / s, sign * q[2] / s])
+}
+
+/// The axis as the user reads it: `X`/`Y`/`Z` (signed) when it is a
+/// principal axis, else its components.
+fn axis_word(a: [f64; 3]) -> String {
+    for (i, w) in ["X", "Y", "Z"].iter().enumerate() {
+        if (a[i].abs() - 1.0).abs() < 1e-9 {
+            return if a[i] < 0.0 { format!("-{w}") } else { (*w).to_string() };
+        }
+    }
+    format!("({:.4}, {:.4}, {:.4})", a[0], a[1], a[2])
+}
+
+/// What an offset's placement says beyond its translation (#327).
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) enum OffsetFrame {
+    /// Finite, and within [`ROT_TOL_RAD`] of the identity.
+    Square,
+    /// Finite and turned: the angle (deg) and the axis as the user reads it.
+    Rotated { deg: f64, axis: String },
+    /// A NaN / infinite origin or rotation, or a zero-norm quaternion:
+    /// no frame at all. Never "unrotated" - refused by name.
+    NonFinite,
+}
+
+/// Classify a work-offset placement. A non-finite or degenerate value is
+/// its own verdict, never folded into "unrotated" (#327).
+#[must_use]
+pub(crate) fn offset_frame(loc: &Location) -> OffsetFrame {
+    let q = loc.rot;
+    let norm2 = q.iter().map(|v| v * v).sum::<f64>();
+    if !loc.pos.is_finite() || !q.iter().all(|v| v.is_finite()) || !norm2.is_finite() || norm2 <= 0.0 {
+        return OffsetFrame::NonFinite;
+    }
+    let (angle, axis) = angle_axis(q);
+    if angle <= ROT_TOL_RAD {
+        OffsetFrame::Square
+    } else {
+        OffsetFrame::Rotated { deg: angle.to_degrees(), axis: axis_word(axis) }
+    }
+}
+
+/// One line per rotated (or non-finite, #327) work-offset entity a
+/// posted operation uses, naming the setup, the G-word, the rotation and
+/// the operations. Empty when every offset in the program is unrotated.
+#[must_use]
+pub(super) fn rotated_wcs_problems(world: &World) -> Vec<String> {
+    // (entity name, line prefix, ops), in first-use program order.
+    let mut hits: Vec<(String, String, Vec<String>)> = Vec::new();
+    for (name, e) in crate::setup::operation_order(world) {
+        let Some(op) = model::operation_of(world, &e) else {
+            continue;
+        };
+        if op.suppressed {
+            continue; // not in the program (#110)
+        }
+        let setup = op.setup.as_deref();
+        let slot = wcs_slot(world, setup);
+        let Some(wcs) = crate::setup::wcs_entity(world, setup) else {
+            continue; // never placed: the identity at the origin
+        };
+        let Some(loc) = model::transform_of(world, &wcs) else {
+            continue;
+        };
+        let frame = offset_frame(&loc);
+        if frame == OffsetFrame::Square {
+            continue;
+        }
+        let entity = crate::setup::wcs_entity_name(world, setup);
+        let label = model::operation_label(world, &name, &e);
+        if let Some(hit) = hits.iter_mut().find(|h| h.0 == entity) {
+            hit.2.push(label);
+            continue;
+        }
+        let word = WCS_SLOTS.get(slot).copied().unwrap_or("G54");
+        let owner = match crate::setup::effective(world, setup) {
+            Some(s) => format!("setup {s}: its WCS ({word})"),
+            None => format!("the WCS ({word})"),
+        };
+        let prefix = match frame {
+            OffsetFrame::Rotated { deg, axis } => format!(
+                "{owner} is rotated {deg:.3} deg about {axis}; posting a rotated work offset is not \
+                 supported yet - re-align it without rotation or post from an unrotated setup"
+            ),
+            // #327: a NaN / infinite / zero-norm placement is no frame at
+            // all - refused by name, never posted as unrotated.
+            _ => format!(
+                "{owner} has a non-finite placement (origin or rotation) - re-place the \
+                 offset before posting"
+            ),
+        };
+        hits.push((entity, prefix, vec![label]));
+    }
+    hits.into_iter()
+        .map(|(_, prefix, ops)| format!("{prefix} (operations: {})", ops.join(", ")))
+        .collect()
+}
diff --git a/crates/app/src/posting_wcs_slot.rs b/crates/app/src/posting_wcs_slot.rs
new file mode 100644
index 00000000..c88a6381
--- /dev/null
+++ b/crates/app/src/posting_wcs_slot.rs
@@ -0,0 +1,114 @@
+//! The work-offset slot law (#196, #329): which `G54`..`G59` word an
+//! operation posts at, and the one-file refusal a per-setup pick brings.
+//!
+//! - **The setup governs.** Every operation of a setup posts at the
+//!   setup's work-offset word (`SetupDef::work_offset`, set by
+//!   `SetSetupWorkOffset`; unlabelled = `G54`), measured from the setup's
+//!   one WCS (#342) - [`crate::setup::wcs_slot`] is the word law. A
+//!   height measured from the work offset reads the same WCS (#329), so
+//!   an operation cannot disagree with its setup by construction.
+//! - **One program, one register per word.** A single NC file in which
+//!   two setups post the same word with different placements would run
+//!   the second setup in the first one's zero - the controller holds one
+//!   `G54`. The one-file post refuses it by name; per-operation files
+//!   are exempt (each file is one setup's, and its offset is set for it).
+//!
+//! Provenance: our own design notes over RS-274 / ISO 6983 work-offset
+//! semantics (G54..G59 select one of six controller-held zero registers);
+//! no vendor material consulted.
+
+use flecs_ecs::prelude::World;
+
+use crate::model;
+use crate::schema::{Location, WCS_SLOTS};
+
+/// Placement difference below which two offsets are the same zero:
+/// 1 nm, far under any machine resolution.
+const SAME_MM: f64 = 1e-6;
+
+/// The work-offset slot an operation of the `setup` context posts at -
+/// the setup's ([`crate::setup::wcs_slot`]). [`crate::posting::wcs_context`]
+/// and the one-file clause read it.
+pub(crate) fn wcs_slot(world: &World, setup: Option<&str>) -> usize {
+    crate::setup::wcs_slot(world, setup)
+}
+
+fn word(slot: usize) -> &'static str {
+    WCS_SLOTS.get(slot).copied().unwrap_or("G54")
+}
+
+/// The placement a setup's WCS sits at (unplaced = the origin, the law
+/// `wcs_context` reads).
+fn placement(world: &World, setup: Option<&str>) -> Location {
+    crate::setup::wcs_entity(world, setup)
+        .and_then(|e| model::transform_of(world, &e))
+        .unwrap_or_default()
+}
+
+fn same_zero(a: &Location, b: &Location) -> bool {
+    let pos = (a.pos.x - b.pos.x).abs() <= SAME_MM
+        && (a.pos.y - b.pos.y).abs() <= SAME_MM
+        && (a.pos.z - b.pos.z).abs() <= SAME_MM;
+    // q and -q are one rotation.
+    let rot = |s: f64| (0..4).all(|i| (a.rot[i] - s * b.rot[i]).abs() <= 1e-9);
+    pos && (rot(1.0) || rot(-1.0))
+}
+
+/// The one-file clause (module header): one line per word that two
+/// setups of the program post at from different placements. Empty when
+/// every word means one zero.
+#[must_use]
+pub(super) fn shared_word_problems(world: &World) -> Vec<String> {
+    shared_word_problems_in(world, None)
+}
+
+/// [`shared_word_problems`] over one file's setups (#388: a mount's
+/// file holds its own setups' registers, another machine's are its own).
+/// `None` is the whole program.
+#[must_use]
+pub(super) fn shared_word_problems_in(world: &World, only: Option<&[String]>) -> Vec<String> {
+    // (slot, setup, placement), first use in program order.
+    let mut seen: Vec<(usize, String, Location)> = Vec::new();
+    let mut out: Vec<String> = Vec::new();
+    for (_, e) in crate::setup::operation_order(world) {
+        let Some(op) = model::operation_of(world, &e) else {
+            continue;
+        };
+        if op.suppressed {
+            continue;
+        }
+        let setup = op.setup.as_deref();
+        let slot = wcs_slot(world, setup);
+        let name = crate::setup::effective(world, setup).unwrap_or_default();
+        if only.is_some_and(|keep| !keep.contains(&name)) {
+            continue;
+        }
+        let here = placement(world, setup);
+        match seen.iter().find(|(s, n, _)| *s == slot && *n != name) {
+            Some((_, first, there)) if !same_zero(there, &here) => {
+                let line = format!(
+                    "setups {first} and {name} both post at {} from different placements \
+                     ({first}: X{:.3} Y{:.3} Z{:.3}, {name}: X{:.3} Y{:.3} Z{:.3}) - one program \
+                     holds one {} register; pick another work offset for {name} on the Setups \
+                     page, or post one file per operation",
+                    word(slot),
+                    there.pos.x,
+                    there.pos.y,
+                    there.pos.z,
+                    here.pos.x,
+                    here.pos.y,
+                    here.pos.z,
+                    word(slot)
+                );
+                if !out.contains(&line) {
+                    out.push(line);
+                }
+            }
+            _ => {}
+        }
+        if !seen.iter().any(|(s, n, _)| *s == slot && *n == name) {
+            seen.push((slot, name, here));
+        }
+    }
+    out
+}
diff --git a/crates/app/src/program_entry.rs b/crates/app/src/program_entry.rs
new file mode 100644
index 00000000..551e5fc2
--- /dev/null
+++ b/crates/app/src/program_entry.rs
@@ -0,0 +1,174 @@
+//! Standalone Pause and Home entries in the operation list (#155): where
+//! they stand among the operations, and what the post makes of them.
+//! Provenance: the RS-274 / ISO 6983 program stop (M0), optional stop
+//! (M1) and reference return, as #110's per-operation after-action
+//! already posts them; our own sequencing law, no vendor material.
+//!
+//! The law: an entry is NOT an operation. It owns no tool and no
+//! toolpath, so `setup::operation_order` - and every walk built on it
+//! (the post's tool and freshness gate, `rest::ahead_of`, the program
+//! sim, the setup sheet, the tool list, verify) - never sees one. Only
+//! two walks know entries exist: [`sequence`] (the operation list's
+//! order, which reorder and append number) and [`posted_afters`] (the
+//! post, which folds each entry into the after-action of the posted
+//! operation before it - the same `PARAM AfterOperation` word the
+//! per-op choice writes, so a document without entries posts byte for
+//! byte as before).
+
+use std::collections::HashMap;
+
+use flecs_ecs::core::EntityViewGet; // not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::{Entity, World};
+
+use crate::model;
+use crate::operation::AfterOperation;
+use crate::schema::ProgramEntry;
+use crate::setup;
+
+/// The entry on `entity`, if it is one.
+#[must_use]
+pub fn entry_of(world: &World, entity: &Entity) -> Option<ProgramEntry> {
+    entity.entity_view(world).try_get::<&ProgramEntry>(Clone::clone)
+}
+
+/// Is this named entity a program entry?
+#[must_use]
+pub fn is_entry(world: &World, entity: &Entity) -> bool {
+    entity.entity_view(world).try_get::<&ProgramEntry>(|_| ()).is_some()
+}
+
+/// An operation or an entry: a row of the operation list.
+#[must_use]
+pub fn is_sequenced(world: &World, entity: &Entity) -> bool {
+    model::is_operation(world, entity) || is_entry(world, entity)
+}
+
+/// The setup an operation or an entry declares (`None` - the first).
+#[must_use]
+pub fn declared_setup(world: &World, entity: &Entity) -> Option<String> {
+    model::operation_of(world, entity)
+        .map(|op| op.setup)
+        .or_else(|| entry_of(world, entity).map(|e| e.setup))
+        .flatten()
+}
+
+/// The setup an operation or an entry machines in, resolved.
+#[must_use]
+pub fn effective_setup(world: &World, entity: &Entity) -> Option<String> {
+    setup::effective(world, declared_setup(world, entity).as_deref())
+}
+
+/// Every operation AND entry in list order: setup rank, then position,
+/// then key - `setup::operation_order`'s exact sort, entries included.
+/// On a document without entries it IS that order.
+#[must_use]
+pub fn sequence(world: &World) -> Vec<(String, Entity)> {
+    let order = setup::names(world);
+    let mut rows: Vec<(usize, u32, String, Entity)> = model::named_entities(world)
+        .into_iter()
+        .filter(|(_, e)| is_sequenced(world, e))
+        .map(|(n, e)| {
+            let declared = declared_setup(world, &e);
+            let position = model::operation_meta_of(world, &e).order.unwrap_or(u32::MAX);
+            (setup::rank(&order, declared.as_deref()), position, n, e)
+        })
+        .collect();
+    rows.sort_by_key(|(r, position, _, _)| (*r, *position)); // stable: key order breaks ties
+    rows.into_iter().map(|(_, _, n, e)| (n, e)).collect()
+}
+
+/// The list row's words for an entry's action.
+#[must_use]
+pub fn action_label(action: AfterOperation) -> &'static str {
+    match action {
+        AfterOperation::None => "Continue",
+        AfterOperation::OptionalStop => "Optional stop (M1)",
+        AfterOperation::ProgramStop => "Pause (M0)",
+        AfterOperation::GoHome => "Go home",
+    }
+}
+
+/// The key prefix a new entry's name takes.
+#[must_use]
+pub fn key_prefix(action: AfterOperation) -> &'static str {
+    match action {
+        AfterOperation::GoHome => "Home",
+        AfterOperation::OptionalStop => "OptionalStop",
+        _ => "Pause",
+    }
+}
+
+/// Two after-actions in one gap, as one: equal asks are one ask, and a
+/// program stop holds everything an optional stop could (M0 always
+/// stops), so it absorbs it. A stop and a trip home are two different
+/// motions with no single word - `None`, and the caller refuses.
+fn merge(a: AfterOperation, b: AfterOperation) -> Option<AfterOperation> {
+    use AfterOperation::{None as Carry, OptionalStop, ProgramStop};
+    match (a, b) {
+        (Carry, x) | (x, Carry) => Some(x),
+        (x, y) if x == y => Some(x),
+        (OptionalStop, ProgramStop) | (ProgramStop, OptionalStop) => Some(ProgramStop),
+        _ => None,
+    }
+}
+
+/// What each posted operation does once it is done, entries folded in:
+/// `ops` is the program `posting::program_ops` blessed (suppressed ops
+/// already out). An entry joins the gap after the last posted operation
+/// before it in list order; a suppressed entry is out of the program.
+/// With `skip` ("Skip pauses and homes") every action is muted and no
+/// entry can refuse. Refusals name the entry: one before every posted
+/// operation (there is no section end to stop after), and a stop and a
+/// trip home asked of the same gap (one word per gap).
+pub fn posted_afters(
+    world: &World,
+    ops: &[(String, Entity)],
+    skip: bool,
+) -> Result<HashMap<String, AfterOperation>, String> {
+    let mut out: HashMap<String, AfterOperation> = HashMap::with_capacity(ops.len());
+    if skip {
+        for (name, _) in ops {
+            out.insert(name.clone(), AfterOperation::None);
+        }
+        return Ok(out);
+    }
+    for (name, e) in ops {
+        let after = model::operation_of(world, e).map_or(AfterOperation::None, |op| op.after);
+        out.insert(name.clone(), after);
+    }
+    let mut last: Option<String> = None;
+    for (name, e) in sequence(world) {
+        if out.contains_key(&name) && model::is_operation(world, &e) {
+            last = Some(name);
+            continue;
+        }
+        let Some(entry) = entry_of(world, &e) else {
+            continue; // a suppressed operation: not a gap of the program
+        };
+        if entry.suppressed || entry.action == AfterOperation::None {
+            continue;
+        }
+        let Some(op) = last.as_ref() else {
+            return Err(format!(
+                "{name}: a {} entry before the first posted operation has no operation to follow - move it after one, or suppress it",
+                action_label(entry.action)
+            ));
+        };
+        let now = out.get(op).copied().unwrap_or_default();
+        match merge(now, entry.action) {
+            Some(m) => {
+                out.insert(op.clone(), m);
+            }
+            None => {
+                let label = model::find_by_name(world, op)
+                    .map_or_else(|| op.clone(), |oe| model::operation_label(world, op, &oe));
+                return Err(format!(
+                    "{name}: {label} already ends with {} - the post writes one after-action per gap, and {} after it would need a second; remove one of them",
+                    action_label(now),
+                    action_label(entry.action)
+                ));
+            }
+        }
+    }
+    Ok(out)
+}
