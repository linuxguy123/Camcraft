diff --git a/crates/app/src/tool_body.rs b/crates/app/src/tool_body.rs
new file mode 100644
index 00000000..362a08b9
--- /dev/null
+++ b/crates/app/src/tool_body.rs
@@ -0,0 +1,220 @@
+//! Tool bodies (#368): a holder or assembly mesh attached to a tool,
+//! placed in the tool frame by numbers (the model direction that is the
+//! tool axis, the model origin's height above the tip), and the reads
+//! every judging law takes from it - the tool with its holder widened to
+//! the cylinder enclosing the body, and the body's own band stack for
+//! the fixture laws. Specced from the revolved-solid reading of a tool
+//! assembly in machine-tool handbooks; the frame change is plain linear
+//! algebra. Our own design; no vendor file or source consulted.
+//!
+//! The laws here:
+//! - **No body, no change.** A tool without a [`ToolBody`] reads exactly
+//!   its own record, so every output stays byte-identical.
+//! - **Never smaller than the body.** Laws that read one holder cylinder
+//!   get the cylinder enclosing the body ([`HolderProfile::enclose`]);
+//!   the fixture laws, the ones that name a collision, read its bands.
+//! - **Refusals by name**, at the command and again at use: a body that
+//!   is empty, non-finite, degenerate, flat, off the axis, below the
+//!   tip, too large, or reaching into the flutes.
+//! - **One body, one frame (#369).** A milling body is placed along the
+//!   spindle axis ([`BodyFrame::Spindle`]); a lathe steel's in the
+//!   turning tool frame ([`BodyFrame::Lathe`], `crate::tool_body_lathe`).
+//!   The milling laws read only the first; a lathe body leaves the tool
+//!   record as it is for them and is judged by the revolved-stock law.
+
+use std::sync::Arc;
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::{Entity, World};
+
+use camcraft_tools::holder_profile::{HolderProfile, HolderStack, MAX_BODY_HEIGHT};
+use camcraft_tools::spun::SpunProfile;
+use camcraft_tools::lathe_holder::{LatheClearance, LathePlacement};
+use camcraft_tools::lathe_insert_zone::InsertZone;
+
+use crate::geometry::{Point3, Triangle};
+use crate::schema::ToolBody;
+use crate::tools::{Tool, ToolGeom, ToolKind};
+
+/// The frame a body is placed in, the placement it landed with, and
+/// what the laws read off it.
+#[derive(Debug, Clone, PartialEq)]
+pub enum BodyFrame {
+    /// #368: a milling body - the model direction that became the tool
+    /// axis, the model origin's height above the tip, and its revolved
+    /// envelope.
+    Spindle { axis: [f64; 3], offset: f64, profile: HolderProfile },
+    /// #369: a lathe-held body - its placement in the turning tool
+    /// frame, its optional insert zone (#396: the insert plate the
+    /// judge leaves out), and its clearance bands along the spindle.
+    Lathe { place: LathePlacement, zone: Option<InsertZone>, clearance: Arc<LatheClearance> },
+}
+
+/// The tool kinds a lathe holds: they take a lathe-frame body only
+/// (`Bore` serves both machines and takes either).
+pub const LATHE_HELD: [ToolKind; 4] = [ToolKind::Turning, ToolKind::Groove, ToolKind::Thread, ToolKind::Form];
+
+/// The body on a tool entity, if it has one.
+#[must_use]
+pub fn body_of(world: &World, entity: &Entity) -> Option<ToolBody> {
+    entity.entity_view(world).try_get::<&ToolBody>(|b| b.clone())
+}
+
+/// Land (`Some`) or clear (`None`) a tool's body - the one writer,
+/// called by `SetToolBody` and the project loader.
+pub fn set_body(world: &World, entity: &Entity, body: Option<&ToolBody>) {
+    let view = entity.entity_view(world);
+    match body {
+        Some(b) => {
+            view.set(b.clone());
+        }
+        None => {
+            view.remove(world.component::<ToolBody>());
+        }
+    }
+}
+
+/// Place a model-frame mesh in the tool frame: `axis` (any non-zero
+/// direction, model frame) becomes +Z through the model origin, and the
+/// origin stands `offset` above the tip. Refuses a zero or non-finite
+/// axis and a non-finite or absurd offset by name.
+pub fn place(model: &[Triangle], axis: [f64; 3], offset: f64) -> Result<Vec<Triangle>, String> {
+    let n = (axis[0] * axis[0] + axis[1] * axis[1] + axis[2] * axis[2]).sqrt();
+    if !(n.is_finite() && n > 1e-12) {
+        return Err("the tool axis direction must be a finite, non-zero vector".into());
+    }
+    if !(offset.is_finite() && offset.abs() <= MAX_BODY_HEIGHT) {
+        return Err(format!("the tip offset must be a finite length within {MAX_BODY_HEIGHT} mm"));
+    }
+    let a = [axis[0] / n, axis[1] / n, axis[2] / n];
+    // The perpendicular pair: +Z maps X to X and Y to Y (the identity
+    // a vendor file modelled along Z expects); any other axis takes a
+    // right-handed pair off the least-aligned helper.
+    let helper = if a[1].abs() < 0.9 { [0.0, 1.0, 0.0] } else { [1.0, 0.0, 0.0] };
+    let u = unit(cross(helper, a)).ok_or("the tool axis direction must be a finite, non-zero vector")?;
+    let v = cross(a, u);
+    let map = |p: Point3| {
+        let q = [p.x, p.y, p.z];
+        Point3::new(dot(q, u), dot(q, v), dot(q, a) + offset)
+    };
+    Ok(model.iter().map(|t| Triangle::new(map(t.a), map(t.b), map(t.c))).collect())
+}
+
+/// A body built from placed facets: its envelope derived, refused by
+/// name when the mesh is no tool body.
+pub fn build(source: &str, axis: [f64; 3], offset: f64, placed: Vec<Triangle>) -> Result<ToolBody, String> {
+    let tris: Vec<[[f64; 3]; 3]> = placed
+        .iter()
+        .map(|t| [[t.a.x, t.a.y, t.a.z], [t.b.x, t.b.y, t.b.z], [t.c.x, t.c.y, t.c.z]])
+        .collect();
+    let profile = HolderProfile::envelope(&tris).map_err(|e| e.to_string())?;
+    Ok(ToolBody { source: source.to_owned(), facets: Arc::from(placed), frame: BodyFrame::Spindle { axis, offset, profile }, spun: None })
+}
+
+/// What a drawn (spun) holder body is called where a file name would be.
+pub const SPUN_SOURCE: &str = "drawn profile";
+
+/// A body drawn as a spun profile (#93), already in the tool frame (a
+/// spindle-frame body, axis +Z, origin on the tip): its facets the
+/// revolve of the conservative outline (for display and for any reader
+/// that only has facets), its envelope the profile's exact bands. The
+/// validation is the profile's own (`SpunProfile::new`).
+#[must_use]
+pub fn build_spun(spun: SpunProfile) -> ToolBody {
+    let facets = crate::tool_body_view::revolve(&spun.outline());
+    ToolBody {
+        source: SPUN_SOURCE.to_owned(),
+        facets: Arc::from(facets),
+        frame: BodyFrame::Spindle { axis: [0.0, 0.0, 1.0], offset: 0.0, profile: spun.holder_profile() },
+        spun: Some(spun),
+    }
+}
+
+/// Can `tool` carry `body`? A lathe-held insert takes a lathe-frame
+/// body (#369) and a lathe-frame body needs a lathe steel; a spindle
+/// body reaching into the flutes has no cylinder stack that could
+/// stand it.
+pub fn fits(tool: &Tool, body: &ToolBody) -> Result<(), String> {
+    let profile = match &body.frame {
+        BodyFrame::Lathe { zone, .. } => return crate::tool_body_lathe::fits(tool, zone.as_ref()),
+        BodyFrame::Spindle { profile, .. } => profile,
+    };
+    if LATHE_HELD.contains(&tool.kind) {
+        return Err(format!(
+            "a {} is lathe-held - lathe holders are placed in the turning tool frame (radial and spindle directions, tip point), not along a spindle axis",
+            tool.kind
+        ));
+    }
+    if profile.enclose(tool).is_none() {
+        return Err(format!(
+            "the tool body reaches into the flutes (its foot is {:.3} mm above the tip, the flutes run {:.3} mm)",
+            profile.bottom(),
+            tool.flute_len
+        ));
+    }
+    Ok(())
+}
+
+/// The tool as every judging law should read it, and the body behind
+/// it: unchanged with no body; with one, the holder widened to the
+/// cylinder enclosing the body. Refuses by name when the body no longer
+/// fits the tool (a later edit shortened the shank under it). A lathe
+/// body (#369) leaves the record as it is: the revolved-stock law
+/// reads it (`tool_body_lathe::clearance_of`), no cylinder law does.
+pub fn judged(world: &World, entity: &Entity, tool: Tool) -> Result<(Tool, Option<HolderProfile>), String> {
+    let Some(body) = body_of(world, entity) else {
+        return Ok((tool, None));
+    };
+    fits(&tool, &body)?;
+    match body.frame {
+        BodyFrame::Lathe { .. } => Ok((tool, None)),
+        BodyFrame::Spindle { profile, .. } => {
+            let enclosed = profile.enclose(&tool).ok_or("the tool body reaches into the flutes")?;
+            Ok((enclosed, Some(profile)))
+        }
+    }
+}
+
+/// What the fixture laws sweep above the shank of `geom`: the body's
+/// bands, or the holder cylinder when there is no body.
+#[must_use]
+pub fn stack(geom: &ToolGeom, body: Option<&HolderProfile>) -> HolderStack {
+    body.map_or_else(|| HolderStack::cylinder(geom), |p| p.stack(geom))
+}
+
+/// The body's term in an operation's stamp: nothing without one (no
+/// digest moves), the envelope's bands with one - the only numbers a
+/// law reads off it.
+pub fn digest(world: &World, entity: &Entity, h: &mut impl std::hash::Hasher) {
+    match body_of(world, entity).map(|b| b.frame) {
+        None => {}
+        Some(BodyFrame::Spindle { profile, .. }) => {
+            h.write(b"tool-body");
+            for band in profile.bands() {
+                for v in [band.above, band.len, band.r] {
+                    h.write(&v.to_bits().to_le_bytes());
+                }
+            }
+        }
+        // #369: the clearance bands, the only numbers its law reads.
+        Some(BodyFrame::Lathe { clearance, .. }) => {
+            h.write(b"lathe-body");
+            for v in clearance.words() {
+                h.write(&v.to_bits().to_le_bytes());
+            }
+        }
+    }
+}
+
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn cross(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn unit(a: [f64; 3]) -> Option<[f64; 3]> {
+    let n = dot(a, a).sqrt();
+    (n.is_finite() && n > 1e-12).then(|| [a[0] / n, a[1] / n, a[2] / n])
+}
diff --git a/crates/app/src/tool_body_lathe.rs b/crates/app/src/tool_body_lathe.rs
new file mode 100644
index 00000000..fc4656f4
--- /dev/null
+++ b/crates/app/src/tool_body_lathe.rs
@@ -0,0 +1,101 @@
+//! Lathe-held tool bodies (#369): a holder or boring-bar mesh placed in
+//! the turning tool frame by numbers (the model directions that are
+//! radial and along the spindle, the model point that is the tip), the
+//! clearance bands the revolved-stock law reads off it, and which tools
+//! may carry one. Specced from the handbook turning-tool convention (X
+//! radial, Z along the spindle); the frame change is plain linear
+//! algebra. Our own design; no vendor file or source consulted.
+//!
+//! The laws here:
+//! - **Lathe steel only.** A turning insert, grooving blade, threading
+//!   insert, form gauge or boring bar may carry a lathe body; any other
+//!   kind is refused by name, at the command, at `ChangeTool` and on
+//!   load (`tool_body::fits`).
+//! - **Refusals by name** for a placement that is no frame (a zero or
+//!   non-finite direction, directions not square, a wild tip) and a mesh
+//!   that is no body (empty, non-finite, degenerate, flat along the
+//!   spindle, too large, its tip far from it) -
+//!   `camcraft_tools::lathe_holder`.
+//! - **An insert zone holds one insert, never the holder** (#396): a box
+//!   about the tip the judge leaves out, reaching no farther along any
+//!   axis than the tool's own record allows an insert to - its body size
+//!   (`diameter`), a blade's half width along the spindle, and 25.4 mm
+//!   (the largest ISO turning insert) at most - and never the whole
+//!   body. Refused by name at the command, at `ChangeTool` and on load.
+
+use std::sync::Arc;
+
+use flecs_ecs::prelude::{Entity, World};
+
+use camcraft_tools::lathe_holder::{LatheClearance, LathePlacement};
+use camcraft_tools::lathe_insert_zone::{InsertZone, MAX_INSERT_REACH};
+
+use crate::geometry::{Point3, Triangle};
+use crate::schema::ToolBody;
+use crate::tool_body::{body_of, BodyFrame, LATHE_HELD};
+use crate::tools::{Tool, ToolKind};
+
+/// The informational note a turning op carries when its tool has no
+/// lathe body: only the cutting footprint was judged.
+pub const HOLDER_NOTE: &str = "holder not judged - the turning tool carries no modelled body, so only its cutting footprint was judged against the stock";
+
+/// Place model-frame facets in the turning tool frame.
+pub fn place(model: &[Triangle], place: &LathePlacement) -> Result<Vec<Triangle>, String> {
+    let tris: Vec<[[f64; 3]; 3]> = model.iter().map(tri).collect();
+    let placed = place.place(&tris).map_err(|e| e.to_string())?;
+    Ok(placed.iter().map(|t| Triangle::new(pt(t[0]), pt(t[1]), pt(t[2]))).collect())
+}
+
+/// A lathe body built from facets already placed in the turning tool
+/// frame: its clearance bands derived (less its insert zone, #396),
+/// refused by name when the mesh is no lathe body or the zone no zone.
+pub fn build(source: &str, place: LathePlacement, zone: Option<InsertZone>, placed: Vec<Triangle>) -> Result<ToolBody, String> {
+    place.basis().map_err(|e| e.to_string())?;
+    if let Some(z) = &zone {
+        z.check([MAX_INSERT_REACH; 3]).map_err(|e| e.to_string())?;
+    }
+    let tris: Vec<[[f64; 3]; 3]> = placed.iter().map(tri).collect();
+    let clearance = LatheClearance::of_zoned(&tris, zone.as_ref()).map_err(|e| e.to_string())?;
+    Ok(ToolBody { source: source.to_owned(), facets: Arc::from(placed), frame: BodyFrame::Lathe { place, zone, clearance: Arc::new(clearance) }, spun: None })
+}
+
+/// Can `tool` carry a lathe body (with insert zone `zone`)? Only a
+/// lathe steel can, and only with a zone one of its inserts could fill.
+pub fn fits(tool: &Tool, zone: Option<&InsertZone>) -> Result<(), String> {
+    if !(LATHE_HELD.contains(&tool.kind) || tool.kind == ToolKind::Bore) {
+        return Err(format!("a {} is no lathe steel - a lathe-frame body needs a turning, grooving, threading or form insert or a boring bar", tool.kind));
+    }
+    zone.map_or(Ok(()), |z| z.check(zone_cap(tool)).map_err(|e| e.to_string()))
+}
+
+/// How far from the tip, per axis (x radial, y normal, z along the
+/// spindle), an insert of `tool` can reach: its body size, which no
+/// insert clamped on it outgrows, and along the spindle a grooving or
+/// form blade's half width (the tip is the band centre and the blade is
+/// the band). A thread insert's laydown plate is wider than its V, so
+/// it takes the body size. `InsertZone::check` holds each to 25.4 mm.
+fn zone_cap(tool: &Tool) -> [f64; 3] {
+    let body = if tool.diameter.is_finite() { tool.diameter.max(0.0) } else { 0.0 };
+    let z = match tool.kind {
+        ToolKind::Groove | ToolKind::Form => body.min(tool.width.max(0.0) * 0.5),
+        _ => body,
+    };
+    [body, body, z]
+}
+
+/// The clearance bands of the tool entity's lathe body, if it has one.
+#[must_use]
+pub fn clearance_of(world: &World, entity: &Entity) -> Option<Arc<LatheClearance>> {
+    match body_of(world, entity)?.frame {
+        BodyFrame::Lathe { clearance, .. } => Some(clearance),
+        BodyFrame::Spindle { .. } => None,
+    }
+}
+
+fn tri(t: &Triangle) -> [[f64; 3]; 3] {
+    [[t.a.x, t.a.y, t.a.z], [t.b.x, t.b.y, t.b.z], [t.c.x, t.c.y, t.c.z]]
+}
+
+fn pt(p: [f64; 3]) -> Point3 {
+    Point3::new(p[0], p[1], p[2])
+}
diff --git a/crates/app/src/tool_body_view.rs b/crates/app/src/tool_body_view.rs
new file mode 100644
index 00000000..bfb2951f
--- /dev/null
+++ b/crates/app/src/tool_body_view.rs
@@ -0,0 +1,252 @@
+//! Tool-body editing and display reads (#371): what the tool editor and
+//! the simulation need from a body without committing anything - the
+//! file read, the six axis presets, the placement preview (the same
+//! place-and-envelope `SetToolBody` runs), the tip/axis picks on the
+//! model-frame mesh, the body posed at a tool position for drawing, and
+//! the drawn spun holder's preview (#93).
+//! Specced from plain linear algebra (Rodrigues' rotation formula, the
+//! ray/triangle crossing `pick::soup_hit` already uses); our own design,
+//! no vendor file or source consulted.
+//!
+//! Nothing here writes the world: picks and previews are ephemeral, and
+//! the one writer stays `SetToolBody` (AGENTS.md: everything is a
+//! command).
+
+use std::path::Path;
+
+use flecs_ecs::prelude::World;
+
+use crate::geometry::{Point3, Triangle};
+use crate::model;
+use crate::schema::ToolBody;
+use crate::tool_body;
+use crate::tools::{Tool, ToolKind};
+use camcraft_tools::spun::{SpunPoint, SpunProfile};
+
+/// The six model directions the editor offers as the tool axis.
+pub const AXIS_CHOICES: [(&str, [f64; 3]); 6] = [
+    ("+Z", [0.0, 0.0, 1.0]),
+    ("-Z", [0.0, 0.0, -1.0]),
+    ("+X", [1.0, 0.0, 0.0]),
+    ("-X", [-1.0, 0.0, 0.0]),
+    ("+Y", [0.0, 1.0, 0.0]),
+    ("-Y", [0.0, -1.0, 0.0]),
+];
+
+/// The preset name of `axis`, if it is one of [`AXIS_CHOICES`] (within
+/// float dust after normalizing).
+#[must_use]
+pub fn axis_label(axis: [f64; 3]) -> Option<&'static str> {
+    let a = unit(axis)?;
+    AXIS_CHOICES.iter().find(|(_, d)| dot(a, *d) > 1.0 - 1e-9).map(|(n, _)| *n)
+}
+
+/// Read a STEP / STL / OBJ for a tool body: its file name and its
+/// model-frame facets. Refuses an unreadable or empty file by name.
+pub fn load(path: &Path) -> Result<(String, Vec<Triangle>), String> {
+    let mesh = crate::geometry::import::load_model(path).map_err(|e| e.to_string())?;
+    if mesh.facets.is_empty() {
+        return Err("the file holds no facets".into());
+    }
+    let source = path.file_name().map_or_else(|| path.display().to_string(), |f| f.to_string_lossy().into_owned());
+    Ok((source, mesh.facets.to_vec()))
+}
+
+/// The placement as `SetToolBody` would judge it, without landing it:
+/// the body placed in the tool frame with its envelope, or the refusal
+/// by name. (The tool-fit law is the command's; this sees the mesh.)
+pub fn preview(model: &[Triangle], axis: [f64; 3], offset: f64) -> Result<ToolBody, String> {
+    let placed = tool_body::place(model, axis, offset)?;
+    tool_body::build("preview", axis, offset, placed)
+}
+
+/// A drawn holder profile (#93) as `SetToolBody::spun` would judge it
+/// against `tool`, without landing it: the validated profile, or the
+/// refusal by name (the outline's own law, then the tool fit - lathe
+/// kinds and a holder reaching into the flutes). Builds no facets, so
+/// the editor can run it every frame while the table is edited.
+pub fn spun_preview(tool: &Tool, points: &[SpunPoint]) -> Result<SpunProfile, String> {
+    let spun = SpunProfile::new(points.to_vec()).map_err(|e| format!("holder profile: {e}"))?;
+    let probe = ToolBody {
+        source: tool_body::SPUN_SOURCE.to_owned(),
+        facets: std::sync::Arc::from(Vec::new()),
+        frame: tool_body::BodyFrame::Spindle { axis: [0.0, 0.0, 1.0], offset: 0.0, profile: spun.holder_profile() },
+        spun: None,
+    };
+    tool_body::fits(tool, &probe)?;
+    Ok(spun)
+}
+
+/// What a click on the model-frame body found: the facet, the hit
+/// point, the facet's corner nearest the hit, and its unit normal (`None`
+/// for a zero-area facet).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct BodyPick {
+    pub facet: usize,
+    pub hit: [f64; 3],
+    pub vertex: [f64; 3],
+    pub normal: Option<[f64; 3]>,
+}
+
+/// Cast `origin + t*dir` at the body's facets (model frame).
+#[must_use]
+pub fn pick(model: &[Triangle], origin: [f64; 3], dir: [f64; 3]) -> Option<BodyPick> {
+    let (facet, hit) = crate::pick::soup_hit(model, origin, dir)?;
+    let t = model.get(facet)?;
+    let corners = [t.a, t.b, t.c].map(|p| [p.x, p.y, p.z]);
+    let d2 = |q: [f64; 3]| {
+        let e = sub(q, hit);
+        dot(e, e)
+    };
+    let vertex = corners.into_iter().min_by(|a, b| d2(*a).total_cmp(&d2(*b)))?;
+    let normal = unit(cross(sub(corners[1], corners[0]), sub(corners[2], corners[0])));
+    Some(BodyPick { facet, hit, vertex, normal })
+}
+
+/// The tip offset that puts `point` (model frame) at the tool tip along
+/// `axis`: the placement maps height as `dot(q, axis) + offset`, so the
+/// tip (height 0) at `point` is `-dot(point, axis)`.
+#[must_use]
+pub fn tip_offset_at(point: [f64; 3], axis: [f64; 3]) -> Option<f64> {
+    let a = unit(axis)?;
+    let o = -dot(point, a);
+    o.is_finite().then_some(o)
+}
+
+/// Tool-frame facets (tip at the origin, +Z to the spindle) posed at a
+/// tool position: `tip` in world, `axis` the unit tip-to-spindle
+/// direction (`sim::Frame::axis`). +Z maps onto `axis` by the shortest
+/// rotation; the turn about the axis is free (the body is judged by its
+/// revolved envelope), and a vertical tool takes the identity.
+#[must_use]
+pub fn posed(facets: &[Triangle], tip: [f64; 3], axis: [f64; 3]) -> Vec<Triangle> {
+    let a = unit(axis).unwrap_or([0.0, 0.0, 1.0]);
+    let (c, k) = (a[2], cross([0.0, 0.0, 1.0], a));
+    let s = dot(k, k).sqrt();
+    let rot = |v: [f64; 3]| -> [f64; 3] {
+        if s < 1e-12 {
+            // Parallel: identity, or a half turn about X when flipped.
+            return if c >= 0.0 { v } else { [v[0], -v[1], -v[2]] };
+        }
+        // Rodrigues about the unit k by the angle whose cos is c, sin s.
+        let k = [k[0] / s, k[1] / s, k[2] / s];
+        let kv = cross(k, v);
+        let kd = dot(k, v) * (1.0 - c);
+        [v[0] * c + kv[0] * s + k[0] * kd, v[1] * c + kv[1] * s + k[1] * kd, v[2] * c + kv[2] * s + k[2] * kd]
+    };
+    let map = |p: Point3| {
+        let r = rot([p.x, p.y, p.z]);
+        Point3::new(r[0] + tip[0], r[1] + tip[1], r[2] + tip[2])
+    };
+    facets.iter().map(|t| Triangle::new(map(t.a), map(t.b), map(t.c))).collect()
+}
+
+/// Facets around the axis per revolved display ring.
+const RING: usize = 32;
+
+/// The whole tool for display, tool frame (tip at the origin, +Z up):
+/// the cutter and shank revolved from `Tool::profile` up to the shank
+/// top - carried up to the body's foot when the body stands clear of it,
+/// the gap the fixture laws also fill with shank - and then the body's
+/// own facets in place of the holder cylinder. Without the steel below
+/// it a body floats a shank length above the tip, off the frame of a
+/// part-sized view (#371 feedback).
+#[must_use]
+pub fn assembly(tool: &Tool, body: &ToolBody) -> Vec<Triangle> {
+    let zs = tool.flute_len.max(0.0) + tool.shank_len.max(0.0);
+    // A lathe-frame body (#369) has no spindle envelope: the shank stops at its own top.
+    let top = body.profile().map_or(zs, |p| zs.max(p.bottom()));
+    let rs = tool.shank_d.max(0.0) * 0.5;
+    let mut prof: Vec<(f64, f64)> =
+        tool.profile().into_iter().filter(|&(z, r)| z.is_finite() && r.is_finite() && z < zs - 1e-9).collect();
+    prof.extend([(zs, rs), (top, rs), (top, 0.0)]);
+    let mut out = revolve(&prof);
+    out.extend(body.facets.iter().copied());
+    out
+}
+
+/// A `(z, r)` meridian spun about +Z into triangles; rings at r = 0
+/// close to a point, flat steps make annuli.
+pub(crate) fn revolve(prof: &[(f64, f64)]) -> Vec<Triangle> {
+    let at = |z: f64, r: f64, k: usize| {
+        let a = std::f64::consts::TAU * k as f64 / RING as f64;
+        Point3::new(r * a.cos(), r * a.sin(), z)
+    };
+    let mut out = Vec::new();
+    for w in prof.windows(2) {
+        let ((z0, r0), (z1, r1)) = (w[0], w[1]);
+        if (z0 - z1).abs() < 1e-12 && (r0 - r1).abs() < 1e-12 {
+            continue;
+        }
+        for k in 0..RING {
+            let (a, b, c, d) = (at(z0, r0, k), at(z0, r0, k + 1), at(z1, r1, k + 1), at(z1, r1, k));
+            if r0 > 1e-12 {
+                out.push(Triangle::new(a, b, c));
+            }
+            if r1 > 1e-12 {
+                out.push(Triangle::new(a, c, d));
+            }
+        }
+    }
+    out
+}
+
+/// The tool with no body, for display, tool frame: its whole
+/// `Tool::profile` revolved - cutter, shank, and the holder cylinder
+/// (Ø holder_d × holder_len on the shank top), the very cylinder
+/// `HolderStack::cylinder` hands the collision laws. `None` for the
+/// lathe insert kinds: their profile is a stand-in envelope (the truth
+/// lives in the work's meridian), so drawing it spun would show a tool
+/// that is not there - they keep the axis marker only.
+#[must_use]
+pub fn bare_assembly(tool: &Tool) -> Option<Vec<Triangle>> {
+    if matches!(tool.kind, ToolKind::Turning | ToolKind::Groove | ToolKind::Thread | ToolKind::Form) {
+        return None;
+    }
+    let prof: Vec<(f64, f64)> = tool.profile().into_iter().filter(|&(z, r)| z.is_finite() && r.is_finite()).collect();
+    let tris = revolve(&prof);
+    (!tris.is_empty()).then_some(tris)
+}
+
+/// The display assembly of the tool operation `op` runs, tool frame:
+/// with a body, [`assembly`]; without one, [`bare_assembly`] (`None`
+/// for the lathe insert kinds, which keep the marker only).
+#[must_use]
+pub fn assembly_for_operation(world: &World, op: &str) -> Option<Vec<Triangle>> {
+    let e = model::find_by_name(world, op)?;
+    let tool_name = model::operation_of(world, &e)?.tool;
+    let te = model::find_by_name(world, &tool_name)?;
+    let tool = model::tool_of(world, &te)?;
+    match tool_body::body_of(world, &te) {
+        // A lathe-frame body (#369) sits in the turning tool frame, not
+        // the spindle frame this assembly draws in: the bare tool stands.
+        Some(body) if body.profile().is_some() => Some(assembly(&tool, &body)),
+        _ => bare_assembly(&tool),
+    }
+}
+
+/// The body on the tool operation `op` runs, if that tool has one.
+#[must_use]
+pub fn body_for_operation(world: &World, op: &str) -> Option<ToolBody> {
+    let e = model::find_by_name(world, op)?;
+    let tool = model::operation_of(world, &e)?.tool;
+    let te = model::find_by_name(world, &tool)?;
+    tool_body::body_of(world, &te)
+}
+
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn sub(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+fn cross(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn unit(a: [f64; 3]) -> Option<[f64; 3]> {
+    let n = dot(a, a).sqrt();
+    (n.is_finite() && n > 1e-12).then(|| [a[0] / n, a[1] / n, a[2] / n])
+}
