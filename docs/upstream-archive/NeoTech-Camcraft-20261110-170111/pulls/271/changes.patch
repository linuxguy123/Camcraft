+//! Issue #323: contour turning leaves a cut inside a longer bar at feed.
+//! Provenance: the stock/rapid law and command fixtures from turning_axial_rapids.
+//! Gate map (M4.4): covers app::operation (turning_stock, generate, turning_rapids), app::posting.
+//! Lane shape (M4.4): small revolved fixtures; all tests run in seconds.
+
+use camcraft_app::cl::MoveKind;
+use camcraft_app::commands::{
+    AddTool, CreateOperation, GenerateOperation, History, ImportModel, LoadMachine, SetStock,
+};
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::machine::Machine;
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, OpStatus, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+
+fn revolve(meridian: &[(f64, f64)]) -> Mesh {
+    let v = |j: usize, r: f64, z: f64| {
+        let th = std::f64::consts::TAU * j as f64 / 16.0;
+        Point3::new(r * th.cos(), r * th.sin(), z)
+    };
+    let mut facets = Vec::new();
+    for seg in meridian.windows(2) {
+        let ((ra, za), (rb, zb)) = (seg[0], seg[1]);
+        for j in 0..16 {
+            let (a, b, c, d) = (
+                v(j, ra, za),
+                v(j + 1, ra, za),
+                v(j, rb, zb),
+                v(j + 1, rb, zb),
+            );
+            if ra <= 1e-12 {
+                facets.push(Triangle::new(a, d, c));
+            } else if rb <= 1e-12 {
+                facets.push(Triangle::new(a, b, d));
+            } else {
+                facets.push(Triangle::new(a, b, d));
+                facets.push(Triangle::new(a, d, c));
+            }
+        }
+    }
+    Mesh::from_facets(facets)
+}
+
+fn assert_long_bar_exit(tag: &str, mesh: Mesh, diameter: f64, params: OpParams, top: f64) {
+    let world = camcraft_app::world::new_world();
+    let mut history = History::default();
+    let stock = SetStock::new(
+        &world,
+        StockShape::Cylinder {
+            diameter,
+            height: 64.0,
+        },
+        Location {
+            pos: Point3::new(0.0, 0.0, -16.0),
+            ..Location::default()
+        },
+    )
+    .expect("bar to Z48");
+    history.execute(&world, stock);
+    history.execute(
+        &world,
+        LoadMachine::new(
+            &world,
+            "lathe.mch".into(),
+            Some(Machine {
+                model: "TestBench lathe".into(),
+                kind: Some("lathe".into()),
+                ..Default::default()
+            }),
+        )
+        .expect("lathe"),
+    );
+    let name = "TN-1600-0R8";
+    let tool = catalog()
+        .into_iter()
+        .find(|(n, _)| *n == name)
+        .map(|(_, t)| t)
+        .expect("insert");
+    history.execute(&world, AddTool::new(&world, name, tool).expect("tool"));
+    history.execute(&world, ImportModel::from_mesh("part", mesh));
+    history.execute(
+        &world,
+        CreateOperation::new(&world, tag, name, SrcRef::Entity("part".into()), params)
+            .expect("create"),
+    );
+    history.execute(
+        &world,
+        GenerateOperation::new(&world, tag).expect("generate"),
+    );
+    let e = model::find_by_name(&world, tag).expect("operation");
+    let c = model::toolpath_of(&world, &e).expect("cached path");
+    // Establish the consumer's actual end and retained stock, not just authored heights.
+    let ends: Vec<_> = c
+        .path
+        .moves
+        .iter()
+        .filter(|m| {
+            (m.from.z - top).abs() < 1e-8
+                && (m.to.z - top).abs() < 1e-8
+                && m.to.x.hypot(m.to.y) > m.from.x.hypot(m.from.y) + 1e-6
+        })
+        .collect();
+    assert!(!ends.is_empty(), "the generated pass must end at Z{top}");
+    assert!(
+        top < 48.0
+            && ends
+                .iter()
+                .any(|m| m.from.x.hypot(m.from.y) < diameter * 0.5),
+        "exit begins inside the uncut bar"
+    );
+    let out = std::env::temp_dir().join(format!("camcraft-323-{tag}-{}.nc", std::process::id()));
+    let posted = posting::post_setup(&world, &out);
+    let _ = std::fs::remove_file(&out);
+    eprintln!(
+        "{tag}: exits={ends:?}; warnings={:?}; posted={posted:?}",
+        c.warnings
+    );
+    assert!(
+        ends.iter()
+            .all(|m| m.kind == MoveKind::Feed && m.feed == Some(50.0)),
+        "exit through retained stock must use the plunge feed"
+    );
+    assert!(
+        !c.warnings
+            .iter()
+            .any(|w| matches!(w, Warning::RapidInStock { .. })),
+        "{:?}",
+        c.warnings
+    );
+    assert_eq!(
+        camcraft_app::operation::status_of(&world, &e),
+        OpStatus::Ok,
+        "{:?}",
+        c.warnings
+    );
+    assert!(posted.is_ok(), "{posted:?}");
+}
+
+#[test]
+fn a_multipass_in_a_longer_bar_exits_at_feed_and_posts() {
+    let part = revolve(&[
+        (0.0, -16.0),
+        (6.0, -16.0),
+        (6.0, 2.0),
+        (3.5, 2.0),
+        (3.5, 40.0),
+        (0.0, 40.0),
+    ]);
+    assert_long_bar_exit(
+        "multi",
+        part,
+        12.0,
+        OpParams::MultiPassTurning {
+            tolerance: 0.05,
+            clearance_z: Height::fixed(56.0),
+            top_z: Height::fixed(40.0),
+            bottom_z: Height::fixed(-16.0),
+            stepdown: 0.5,
+            stock_to_leave: 0.25,
+            passes: 3,
+            feed: 200.0,
+            plunge_feed: 50.0,
+        },
+        40.0,
+    );
+}
+
+#[test]
+fn a_chamfer_in_a_longer_bar_exits_at_feed_and_posts() {
+    let part = revolve(&[
+        (0.0, -16.0),
+        (10.0, -16.0),
+        (10.0, 38.0),
+        (8.0, 40.0),
+        (0.0, 40.0),
+    ]);
+    assert_long_bar_exit(
+        "chamfer",
+        part,
+        20.0,
+        OpParams::Chamfering {
+            tolerance: 0.05,
+            clearance_z: Height::fixed(56.0),
+            top_z: Height::fixed(40.0),
+            bottom_z: Height::fixed(38.0),
+            angle_deg: 45.0,
+            feed: 200.0,
+            plunge_feed: 50.0,
+        },
+        40.0,
+    );
+}
+
+#[test]
+fn a_taper_in_a_longer_bar_exits_at_feed_and_posts() {
+    let part = revolve(&[(0.0, -16.0), (10.0, -16.0), (8.0, 40.0), (0.0, 40.0)]);
+    assert_long_bar_exit(
+        "taper",
+        part,
+        20.0,
+        OpParams::TaperTurning {
+            tolerance: 0.05,
+            clearance_z: Height::fixed(56.0),
+            top_z: Height::fixed(40.0),
+            bottom_z: Height::fixed(-16.0),
+            bottom_dia: 20.0,
+            top_dia: 16.0,
+            feed: 200.0,
+            plunge_feed: 50.0,
+        },
+        40.0,
+    );
+}
diff --git a/crates/app/tests/turning_face_approach.rs b/crates/app/tests/turning_face_approach.rs
new file mode 100644
index 00000000..04386a98
--- /dev/null
+++ b/crates/app/tests/turning_face_approach.rs
@@ -0,0 +1,176 @@
+//! #632: lathe facing approaches at RAPID and lifts off each face
+//! before it retracts. The posted program's first move after the tool
+//! call is a G0 to the clearance point (never a G1 from wherever the
+//! turret parked), every pass's retract lifts Z off the face it just
+//! made before the radial G0 out, the meridian rapid law (#103) finds
+//! no rapid in stock on the facing, and a clearance plane set inside
+//! the bar is convicted by that law and blocks the post - the
+//! approach is judged, never trusted.
+//!
+//! Gate map (M4.4): covers motion::turning::face (approach and lift)
+//! through app::operation (the meridian rapid law on a facing) and
+//! app::posting (the Fanuc lathe program).
+//! Lane shape: seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, ImportModel, LoadMachine, SetStock};
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::machine::Machine;
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::post::{cnc, engine};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+use camcraft_app::world::new_world;
+
+const TAU: f64 = std::f64::consts::TAU;
+const LATHE_CPS: &str = include_str!("../../../assets/posts/fanuc-lathe.cps");
+const TN: &str = "TN-1600-0R8";
+/// A Ø12 part, z -16..15, in a Ø12 bar 1 mm longer (to Z16): the
+/// facing takes the bar's end down to the part's, Z16 to Z15.
+const BAR: [(f64, f64); 4] = [(0.0, -16.0), (6.0, -16.0), (6.0, 15.0), (0.0, 15.0)];
+
+fn revolve(meridian: &[(f64, f64)], segs: usize) -> Mesh {
+    let v = |j: usize, r: f64, z: f64| {
+        let th = TAU * j as f64 / segs as f64;
+        Point3::new(r * th.cos(), r * th.sin(), z)
+    };
+    let mut facets = Vec::new();
+    for seg in meridian.windows(2) {
+        let ((ra, za), (rb, zb)) = (seg[0], seg[1]);
+        for j in 0..segs {
+            let (a1, a2, b1, b2) = (v(j, ra, za), v(j + 1, ra, za), v(j, rb, zb), v(j + 1, rb, zb));
+            if ra <= 1e-12 {
+                facets.push(Triangle::new(a1, b2, b1));
+            } else if rb <= 1e-12 {
+                facets.push(Triangle::new(a1, a2, b2));
+            } else {
+                facets.push(Triangle::new(a1, a2, b2));
+                facets.push(Triangle::new(a1, b2, b1));
+            }
+        }
+    }
+    Mesh::from_facets(facets)
+}
+
+fn bar_world() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    let at = Location { pos: Point3::new(0.0, 0.0, -16.0), ..Location::default() };
+    let cmd = SetStock::new(&world, camcraft_app::stock::StockShape::Cylinder { diameter: 12.0, height: 32.0 }, at);
+    history.execute(&world, cmd.expect("bar stock"));
+    let lathe = Machine {
+        model: "TestBench lathe".into(),
+        kind: Some("lathe".into()),
+        spindle_max: Some(12000.0),
+        ..Default::default()
+    };
+    history.execute(&world, LoadMachine::new(&world, "lathe.mch".into(), Some(lathe)).expect("lathe"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == TN).map(|(_, t)| t).expect("catalog entry");
+    history.execute(&world, AddTool::new(&world, TN, tool).expect("insert"));
+    history.execute(&world, ImportModel::from_mesh("bar", revolve(&BAR, 16)));
+    (world, history)
+}
+
+fn facing(clearance: f64) -> OpParams {
+    OpParams::Facing {
+        tolerance: 0.05,
+        clearance_z: Height::fixed(clearance),
+        top_z: Height::fixed(16.0),
+        bottom_z: Height::fixed(15.0),
+        stepdown: 0.5,
+        feed: 150.0,
+        plunge_feed: 80.0,
+    }
+}
+
+fn create(world: &World, history: &mut History, clearance: f64) -> Vec<Warning> {
+    let cmd = CreateOperation::new(world, "F1", TN, SrcRef::Entity("bar".into()), facing(clearance)).expect("create");
+    history.execute(world, cmd);
+    history.execute(world, GenerateOperation::new(world, "F1").expect("generate"));
+    let e = model::find_by_name(world, "F1").expect("op");
+    model::toolpath_of(world, &e).expect("cache").warnings.clone()
+}
+
+/// The posted program's motion lines (G0/G1), in order.
+fn motion(world: &World) -> Vec<String> {
+    let records = posting::stream_records(world).expect("posts");
+    let text = engine::run(LATHE_CPS, &posting::machine_value(world), &cnc::serialize(&records))
+        .expect("the lathe script runs")
+        .program;
+    text.lines().filter(|l| l.starts_with("G00 ") || l.starts_with("G01 ")).map(str::to_owned).collect()
+}
+
+/// A motion line's (X, Z) words.
+fn xz(line: &str) -> (f64, f64) {
+    let word = |c: char| {
+        line.split_whitespace()
+            .find_map(|w| w.strip_prefix(c).and_then(|v| v.parse::<f64>().ok()))
+            .unwrap_or(f64::NAN)
+    };
+    (word('X'), word('Z'))
+}
+
+#[test]
+fn the_first_posted_move_is_a_rapid_to_the_clearance_point() {
+    let (world, mut history) = bar_world();
+    let warns = create(&world, &mut history, 25.0);
+    let lines = motion(&world);
+    let first = lines.first().expect("a program");
+    assert!(first.starts_with("G00 "), "the first move after the tool call is a rapid: {lines:?}");
+    let (x, z) = xz(first);
+    assert!((z - 25.0).abs() < 1e-9, "on the clearance plane: {first}");
+    assert!(x > 12.0, "outside the Ø12 bar: {first}");
+    let plunge = &lines[1];
+    assert!(plunge.starts_with("G01 ") && (xz(plunge).0 - x).abs() < 1e-9, "then the plunge feeds in at that X: {lines:?}");
+    // The approach and every other rapid are judged in the meridian
+    // and found in air: nothing named, and the post writes.
+    assert!(!warns.iter().any(|w| matches!(w, Warning::RapidInStock { .. })), "{warns:?}");
+    let out = std::env::temp_dir().join(format!("camcraft-face-approach-{}.nc", std::process::id()));
+    let _ = std::fs::remove_file(&out);
+    let posted = posting::post_setup(&world, &out);
+    let _ = std::fs::remove_file(&out);
+    assert!(posted.is_ok(), "{posted:?}");
+}
+
+#[test]
+fn every_facing_retract_lifts_z_before_it_moves_out_in_x() {
+    let (world, mut history) = bar_world();
+    create(&world, &mut history, 25.0);
+    let lines = motion(&world);
+    let mut passes = 0;
+    for (i, l) in lines.iter().enumerate() {
+        // A pass ends on the axis: the most negative X posted (the
+        // control point r past the nose centre on the axis).
+        if !(l.starts_with("G01 ") && xz(l).0 < 0.0) {
+            continue;
+        }
+        passes += 1;
+        let (x, z) = xz(l);
+        let (up, out) = (&lines[i + 1], &lines[i + 2]);
+        let (ux, uz) = xz(up);
+        assert!(up.starts_with("G00 ") && (ux - x).abs() < 1e-9 && uz > z + 1e-9, "the lift off Z{z}: {up}");
+        assert!(uz - z <= 0.5 + 1e-9, "a lift no taller than the stepdown: {up}");
+        let (ox, oz) = xz(out);
+        assert!(out.starts_with("G00 ") && (oz - uz).abs() < 1e-9 && ox > 12.0, "then out in X at the lifted Z: {out}");
+    }
+    assert_eq!(passes, 3, "three passes, Z16 to Z15 by 0.5: {lines:?}");
+}
+
+#[test]
+fn a_clearance_plane_inside_the_bar_is_convicted_not_posted() {
+    // The approach is a judged rapid: on a clearance plane at Z5 -
+    // inside the bar - it would traverse through solid stock, and the
+    // meridian law names it and the post refuses.
+    let (world, mut history) = bar_world();
+    let warns = create(&world, &mut history, 5.0);
+    assert!(warns.contains(&Warning::RapidInStock { at: 0 }), "the approach through the bar went unnamed: {warns:?}");
+    let out = std::env::temp_dir().join(format!("camcraft-face-inside-{}.nc", std::process::id()));
+    let _ = std::fs::remove_file(&out);
+    let posted = posting::post_setup(&world, &out);
+    let _ = std::fs::remove_file(&out);
+    assert!(posted.is_err(), "an approach through the bar posted");
+}
diff --git a/crates/app/tests/turning_holder.rs b/crates/app/tests/turning_holder.rs
new file mode 100644
index 00000000..18ac0744
--- /dev/null
+++ b/crates/app/tests/turning_holder.rs
@@ -0,0 +1,362 @@
+//! Issue #369 at the app level: a lathe holder body, placed in the
+//! turning tool frame, judged on every move against the revolved part
+//! and the stock standing at each instant. An offset OD holder that
+//! reaches the shoulder of a stepped part, and a boring bar too fat for
+//! its bore, are HolderHits that block the post; a holder clear of the
+//! work passes, a holder trailing where a rough cut passes, and a turning
+//! tool with no body is unchanged but for its "holder not judged" note.
+//!
+//! Gate map (M4.4): covers camcraft_app::operation::turning_holder and
+//! turning_holder_scene (the holder law), camcraft_app::tool_body_lathe
+//! (placement, fits), commands::tool_body (SetToolBody::lathe),
+//! project::tool_body_wire (the lathe body on file).
+//! Lane shape (M4.4): all tests here run in seconds.
+//!
+//! Provenance: our own fixtures, specced from the turning kernel's
+//! design notes; no vendor material consulted.
+
+mod common;
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    CommandError, CreateOperation, GenerateOperation, History, ImportModel, LatheBodySpec, LoadMachine, SetStock, SetToolBody,
+};
+use camcraft_app::geometry::{Point3, Triangle};
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::tool_body_lathe::HOLDER_NOTE;
+use camcraft_app::verify::Warning;
+use camcraft_app::{model, posting, project, tool_body};
+use camcraft_tools::lathe_holder::LathePlacement;
+
+use common::bore::*;
+
+const INSERT: &str = "TN-1600-0R8";
+
+/// A closed axis-aligned box over `[lo, hi]`, 12 facets.
+fn cuboid(lo: [f64; 3], hi: [f64; 3]) -> Vec<Triangle> {
+    let c = |i: usize| Point3::new(if i & 1 == 0 { lo[0] } else { hi[0] }, if i & 2 == 0 { lo[1] } else { hi[1] }, if i & 4 == 0 { lo[2] } else { hi[2] });
+    let quads = [[0, 1, 3, 2], [4, 6, 7, 5], [0, 4, 5, 1], [2, 3, 7, 6], [0, 2, 6, 4], [1, 5, 7, 3]];
+    quads.iter().flat_map(|q| [Triangle::new(c(q[0]), c(q[1]), c(q[2])), Triangle::new(c(q[0]), c(q[2]), c(q[3]))]).collect()
+}
+
+/// The mesh modelled in the turning tool frame itself.
+const AS_MODELLED: LathePlacement = LathePlacement { radial: [1.0, 0.0, 0.0], along: [0.0, 0.0, 1.0], tip: [0.0, 0.0, 0.0] };
+
+fn body(source: &str, facets: Vec<Triangle>) -> LatheBodySpec {
+    LatheBodySpec { source: source.into(), facets, place: AS_MODELLED, zone: None }
+}
+
+/// An OD holder shank standing radially out from the tip: x 2..40,
+/// y -6..6, its foot `reach` below the tip along the spindle (toward the
+/// chuck) and 10 above it.
+fn od_holder(reach: f64) -> LatheBodySpec {
+    body("od.step", cuboid([2.0, -6.0, -reach], [40.0, 6.0, 10.0]))
+}
+
+/// The stepped part: r 12 below z 0 (the shoulder), r 6 above to z 20.
+fn stepped() -> camcraft_app::geometry::Mesh {
+    revolve(&[(0.0, -16.0), (12.0, -16.0), (12.0, 0.0), (6.0, 0.0), (6.0, 20.0), (0.0, 20.0)])
+}
+
+/// A lathe document holding the stepped part, the insert on the rack,
+/// and a bar of Ø24 from z -16 to 20 when `bar`.
+fn od_world(bar: bool) -> (World, History) {
+    let world = camcraft_app::world::new_world();
+    let mut history = History::default();
+    if bar {
+        let at = Location { pos: Point3::new(0.0, 0.0, -16.0), ..Location::default() };
+        let shape = camcraft_app::stock::StockShape::Cylinder { diameter: 24.0, height: 36.0 };
+        history.execute(&world, SetStock::new(&world, shape, at).expect("bar stock"));
+    }
+    history.execute(&world, LoadMachine::new(&world, "lathe.mch".into(), Some(machine("lathe"))).expect("lathe"));
+    add_tool(&world, &mut history, INSERT);
+    history.execute(&world, ImportModel::from_mesh("step", stepped()));
+    (world, history)
+}
+
+/// The finish ride down the r 6 neck to 2 above the shoulder.
+fn finish() -> OpParams {
+    OpParams::ProfileFinish {
+        tolerance: 0.05,
+        clearance_z: Height::fixed(30.0),
+        top_z: Height::fixed(20.0),
+        bottom_z: Height::fixed(2.0),
+        feed: 150.0,
+        plunge_feed: 80.0,
+    }
+}
+
+fn op(world: &World, history: &mut History, name: &str, tool: &str, src: &str, params: OpParams) {
+    history.execute(world, CreateOperation::new(world, name, tool, SrcRef::Entity(src.into()), params).expect("create"));
+    history.execute(world, GenerateOperation::new(world, name).expect("generate"));
+}
+
+fn regen(world: &World, history: &mut History, name: &str) {
+    history.execute(world, GenerateOperation::new(world, name).expect("regenerate"));
+}
+
+fn holder_hits(warns: &[Warning]) -> Vec<(usize, bool, f64)> {
+    warns.iter().filter_map(|w| match *w {
+        Warning::HolderHit { at, part, short_mm } => Some((at, part, short_mm)),
+        _ => None,
+    }).collect()
+}
+
+fn refused_post(world: &World, tag: &str) -> String {
+    let out = std::env::temp_dir().join(format!("camcraft-holder-369-{tag}-{}.nc", std::process::id()));
+    let _ = std::fs::remove_file(&out);
+    let r = posting::post_setup(world, &out);
+    let wrote = out.exists();
+    let _ = std::fs::remove_file(&out);
+    assert!(!wrote, "a refused post writes nothing");
+    match r {
+        Ok(_) => panic!("a holder rub posted"),
+        Err(e) => e,
+    }
+}
+
+#[test]
+fn an_offset_od_holder_reaching_the_shoulder_is_convicted_and_the_bare_insert_is_unchanged() {
+    let (world, mut history) = od_world(false);
+    op(&world, &mut history, "F1", INSERT, "step", finish());
+    let bare = cache(&world, "F1").expect("cached");
+    assert!(holder_hits(&bare.warnings).is_empty(), "{:?}", bare.warnings);
+    assert!(bare.path.notes.iter().any(|n| n == HOLDER_NOTE), "the bare insert says its holder went unjudged: {:?}", bare.path.notes);
+
+    // The holder's foot reaches 8 below the tip: at the ride's foot (2
+    // above the shoulder) it stands at r 8.8 over the r 12 shoulder.
+    history.execute(&world, SetToolBody::lathe(&world, INSERT, Some(od_holder(8.0))).expect("a sane holder"));
+    regen(&world, &mut history, "F1");
+    let held = cache(&world, "F1").expect("cached");
+    assert_eq!(held.path.moves, bare.path.moves, "the body never moves the path");
+    assert!(!held.path.notes.iter().any(|n| n == HOLDER_NOTE), "a judged holder carries no note: {:?}", held.path.notes);
+    let hits = holder_hits(&held.warnings);
+    assert!(!hits.is_empty() && hits.iter().all(|h| h.1), "the shoulder rub went unnamed: {:?}", held.warnings);
+    // The shortfall is the radial depth into the shoulder: the foot at
+    // r 8.8 (nose centre 6.8 + 2) under the r 12 skin.
+    let worst = hits.iter().map(|h| h.2).fold(0.0, f64::max);
+    assert!((worst - (12.0 - 8.8)).abs() < 0.02, "shortfall {worst}");
+    let first = hits[0].0;
+    let e = refused_post(&world, "od");
+    assert!(e.contains("post blocked") && e.contains(&format!("holder body at move {first} rubs the part")), "{e}");
+    assert!(e.contains("mm short of clearance"), "{e}");
+
+    // Cleared, the op is the bare one again, note and all.
+    history.execute(&world, SetToolBody::lathe(&world, INSERT, None).expect("clear"));
+    regen(&world, &mut history, "F1");
+    let again = cache(&world, "F1").expect("cached");
+    assert_eq!((again.path.moves, again.warnings, again.path.notes), (bare.path.moves, bare.warnings, bare.path.notes));
+}
+
+#[test]
+fn a_holder_clear_of_the_work_passes_and_posts() {
+    let (world, mut history) = od_world(false);
+    // The same shank standing only above the tip's station: it never
+    // reaches the shoulder.
+    history.execute(&world, SetToolBody::lathe(&world, INSERT, Some(body("od.step", cuboid([2.0, -6.0, 0.5], [40.0, 6.0, 10.0])))).expect("a sane holder"));
+    op(&world, &mut history, "F1", INSERT, "step", finish());
+    let c = cache(&world, "F1").expect("cached");
+    assert!(holder_hits(&c.warnings).is_empty(), "{:?}", c.warnings);
+    let out = std::env::temp_dir().join(format!("camcraft-holder-369-clear-{}.nc", std::process::id()));
+    let posted = posting::post_setup(&world, &out);
+    let _ = std::fs::remove_file(&out);
+    assert!(posted.is_ok(), "{posted:?}");
+}
+
+#[test]
+fn uncut_stock_under_the_holder_is_named_and_a_rough_ahead_clears_it() {
+    // In a Ø24 bar, a finish alone leaves the shell outside its nose
+    // band standing: the shank 2 above the tip rides through it.
+    let (world, mut history) = od_world(true);
+    let clear = || body("od.step", cuboid([2.0, -6.0, 0.5], [40.0, 6.0, 10.0]));
+    history.execute(&world, SetToolBody::lathe(&world, INSERT, Some(clear())).expect("a sane holder"));
+    op(&world, &mut history, "F2", INSERT, "step", finish());
+    let c = cache(&world, "F2").expect("cached");
+    let hits = holder_hits(&c.warnings);
+    assert!(!hits.is_empty() && hits.iter().all(|h| !h.1), "the stock rub went unnamed (or named the part): {:?}", c.warnings);
+    // A rough ahead of the finish eats the shell down to the leave: the
+    // same holder then trails through air.
