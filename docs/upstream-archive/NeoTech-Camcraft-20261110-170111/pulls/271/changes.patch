+/// tangent ball can reach is the scallop; an unreachable one is a
+/// crease no spacing would reach, excused by name in `ridge`.
+pub(super) fn ridge_rest(
+    facets: &[Triangle],
+    segs: &[Seg],
+    arcs: &[Option<ScanArc>],
+    rings: &[u32],
+    lat: &Lattice,
