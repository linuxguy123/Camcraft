+++ b/crates/ui/src/axis_pick.rs
@@ -0,0 +1,272 @@
+//! The axes-in-the-plane pick draft (#557): while a Setups page row
+//! collects picks for +Y or +X, a viewport Edge or Vertex click lands
+//! here instead of in the open operation's geometry. Each axis takes one
+//! straight edge (Edge mode) or two points (Vertex mode); a face sets no
+//! direction and is refused by name in the status line. Ephemeral view
+//! state like the lay-on-a-plane draft - nothing here writes the world;
+//! Apply queues the undoable `AlignPartToSetup` through
+//! `CommandKind::TurnPartInPlane`.
+//!
+//! Provenance: our own UI over plain fixture practice (indicate an edge
+//! along the table's travel); no vendor material consulted.
+
+use camcraft_app::operation::{FeatureSel, GeoSel};
+use camcraft_app::pick::{self, AxisPick, InPlaneAxes, InPlaneAxis};
+use camcraft_app::units::{self, Unit};
+use flecs_ecs::prelude::World;
+
+use crate::state::{GeoPick, State};
+
+/// What one axis is picked by.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum AxisBy {
+    /// One straight edge, start to end.
+    #[default]
+    Edge,
+    /// Two points (feature corners), first to second.
+    Points,
+}
+
+impl AxisBy {
+    /// What a click takes in this mode, in plain words.
+    #[must_use]
+    pub fn noun(self) -> &'static str {
+        match self {
+            AxisBy::Edge => "a straight edge",
+            AxisBy::Points => "two points",
+        }
+    }
+}
+
+/// One setup's in-plane axis picks.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct AxisDraft {
+    /// The setup the picks will turn.
+    pub setup: String,
+    /// The axis viewport clicks land in; `None` is not collecting.
+    pub picking: Option<InPlaneAxis>,
+    pub y_by: AxisBy,
+    pub x_by: AxisBy,
+    /// The picks and flips, per axis (an empty pick list is "not given").
+    pub axes: InPlaneAxes,
+    /// These picks were just applied: they stay, so a Flip re-applies
+    /// (the turn composes onto what the setup now holds).
+    pub applied: bool,
+}
+
+impl AxisDraft {
+    fn new(setup: &str) -> Self {
+        AxisDraft {
+            setup: setup.to_owned(),
+            axes: InPlaneAxes { y: Some(AxisPick::default()), x: Some(AxisPick::default()), primary: InPlaneAxis::Y },
+            ..AxisDraft::default()
+        }
+    }
+
+    #[must_use]
+    pub fn by(&self, axis: InPlaneAxis) -> AxisBy {
+        match axis {
+            InPlaneAxis::Y => self.y_by,
+            InPlaneAxis::X => self.x_by,
+        }
+    }
+
+    /// One axis's picks and flip (always present in a live draft).
+    pub fn slot(&mut self, axis: InPlaneAxis) -> &mut AxisPick {
+        let s = match axis {
+            InPlaneAxis::Y => &mut self.axes.y,
+            InPlaneAxis::X => &mut self.axes.x,
+        };
+        s.get_or_insert_with(AxisPick::default)
+    }
+
+    /// What Apply sends: an axis with no picks is not given.
+    #[must_use]
+    pub fn wanted(&self) -> InPlaneAxes {
+        let given = |p: &Option<AxisPick>| p.clone().filter(|p| !p.picks.is_empty());
+        InPlaneAxes { y: given(&self.axes.y), x: given(&self.axes.x), primary: self.axes.primary }
+    }
+}
+
+/// The draft of `setup`, created when there is none (or it is another
+/// setup's).
+pub fn draft_for<'a>(state: &'a mut State, setup: &str) -> &'a mut AxisDraft {
+    if state.axis_pick.as_ref().is_none_or(|d| d.setup != setup) {
+        state.axis_pick = Some(AxisDraft::new(setup));
+    }
+    state.axis_pick.get_or_insert_with(|| AxisDraft::new(setup))
+}
+
+fn mode_of(by: AxisBy) -> GeoPick {
+    match by {
+        AxisBy::Edge => GeoPick::Edge,
+        AxisBy::Points => GeoPick::Vertex,
+    }
+}
+
+/// Start collecting picks for `axis` of `setup`: Edge mode for an edge,
+/// Vertex mode for two points. The lay-on-a-plane draft stops.
+pub fn arm(state: &mut State, setup: &str, axis: InPlaneAxis) {
+    state.plane_pick = None;
+    let d = draft_for(state, setup);
+    d.picking = Some(axis);
+    let by = d.by(axis);
+    state.geo_pick = mode_of(by);
+    state.status = format!("{setup}: pick {} for {}", by.noun(), axis.label());
+}
+
+/// Stop collecting; the picks stay for Apply.
+pub fn disarm(state: &mut State) {
+    if let Some(d) = state.axis_pick.as_mut() {
+        d.picking = None;
+    }
+}
+
+/// Disarm every Setups page pick whose rows were not drawn this frame
+/// (#664): a page change, an operation opened, the section closed - an
+/// armed axis or plane pick must not feed a hidden draft. The shell
+/// calls it once a frame after the dock, whatever the dock shows (#667),
+/// and it consumes the frame's row marks; the picks themselves stay, so
+/// the page re-opens disarmed with them shown. Ephemeral view state, no
+/// command.
+pub fn disarm_hidden(state: &mut State) {
+    let shown = std::mem::take(&mut state.setup_pick_rows);
+    // #557's stray-click hint holds while the rows are on screen; the
+    // plane row and the axes rows draw together, so either mark counts.
+    state.axis_rows_shown = !shown.is_empty();
+    if let Some(d) = state.axis_pick.as_mut().filter(|d| !shown.contains(&d.setup)) {
+        d.picking = None;
+    }
+    if state.plane_pick.as_ref().is_some_and(|d| !shown.contains(&d.setup)) {
+        crate::plane_pick::pause(state);
+    }
+}
+
+/// Disarm every Setups page pick at once (#667): the shell calls it
+/// before the dock draws when the properties pane is closed or hidden
+/// behind another tab, so no viewport click that frame - the viewport
+/// draws inside the dock - can feed a draft whose rows are off screen.
+pub fn disarm_all(state: &mut State) {
+    state.setup_pick_rows.clear();
+    disarm_hidden(state);
+}
+
+/// Is a Setups page row collecting axis picks?
+#[must_use]
+pub fn collecting(state: &State) -> bool {
+    state.axis_pick.as_ref().is_some_and(|d| d.picking.is_some())
+}
+
+/// Choose what `axis` is picked by, and arm its pick at once: choosing
+/// "by Edge" / "by Two points" means "I am about to pick". A changed
+/// mode drops the axis's picks (an edge and two points do not mix);
+/// re-choosing the current one keeps them.
+pub fn set_by(state: &mut State, setup: &str, axis: InPlaneAxis, by: AxisBy) {
+    let d = draft_for(state, setup);
+    if d.by(axis) != by {
+        match axis {
+            InPlaneAxis::Y => d.y_by = by,
+            InPlaneAxis::X => d.x_by = by,
+        }
+        d.slot(axis).picks.clear();
+        d.applied = false;
+    }
+    arm(state, setup, axis);
+}
+
+/// A feature click while the axes rows are on screen but no axis is
+/// armed (and no lay-on-a-plane pick collects) would fall through to
+/// the operation pick - with no operation open on a Setups page. Say
+/// what to do instead and swallow the click. `true` when handled.
+pub fn hint_stray(state: &mut State) -> bool {
+    if !state.axis_rows_shown || collecting(state) || crate::plane_pick::collecting(state) {
+        return false;
+    }
+    let (y, x) = state.axis_pick.as_ref().map_or((AxisBy::Edge, AxisBy::Edge), |d| (d.y_by, d.x_by));
+    let what = |b: AxisBy| match b {
+        AxisBy::Edge => "edge",
+        AxisBy::Points => "points",
+    };
+    state.status = format!(
+        "no axis is being picked - click Pick +Y {} or Pick +X {} first",
+        what(y),
+        what(x)
+    );
+    true
+}
+
+/// One viewport pick into the axis being collected. An edge replaces
+/// the axis's edge; a point joins, the last two kept. A pick of the
+/// wrong kind is refused by name and changes nothing.
+pub fn take(state: &mut State, pick: GeoSel) {
+    let Some(d) = state.axis_pick.as_mut() else { return };
+    let Some(axis) = d.picking else { return };
+    d.applied = false;
+    let by = d.by(axis);
+    let setup = d.setup.clone();
+    let words = format!("{} of '{}'", pick.feature, pick.entity);
+    let refuse = |what: &str| format!("{setup}: {words} is {what} - {} takes {}", axis.label(), by.noun());
+    let status = match (by, pick.feature) {
+        (AxisBy::Edge, FeatureSel::Chain(_)) => {
+            d.slot(axis).picks = vec![pick];
+            format!("{setup}: edge picked for {}", axis.label())
+        }
+        (AxisBy::Points, FeatureSel::Vertex(_)) => {
+            let picks = &mut d.slot(axis).picks;
+            picks.push(pick);
+            let extra = picks.len().saturating_sub(2);
+            picks.drain(..extra);
+            format!("{setup}: {} point{} for {}", picks.len(), if picks.len() == 1 { "" } else { "s" }, axis.label())
+        }
+        (_, FeatureSel::Face(_) | FeatureSel::Patch(_)) => refuse("a face (a face sets no direction)"),
+        (AxisBy::Edge, FeatureSel::Vertex(_)) => refuse("a point"),
+        (AxisBy::Points, FeatureSel::Chain(_)) => refuse("an edge"),
+    };
+    state.status = status;
+}
+
+/// The picked row's words (#557 hand check): what was picked and where,
+/// in the document's units - never an internal feature id. Points read
+/// "1 of 2 points on 'block' (x, y, z) mm" / "2 points on 'block' (..)
+/// -> (..) mm"; an edge reads "edge on 'block', 50.000 mm long, along
+/// (dx, dy, dz)". Coordinates are the document frame (as modelled).
+#[must_use]
+pub fn picks_text(world: &World, picks: &[GeoSel], unit: Unit) -> String {
+    let Some(first) = picks.first() else { return "nothing picked".to_owned() };
+    let mut names: Vec<&str> = Vec::new();
+    for g in picks {
+        if !names.contains(&g.entity.as_str()) {
+            names.push(&g.entity);
+        }
+    }
+    let on = names.iter().map(|n| format!("'{n}'")).collect::<Vec<_>>().join(", ");
+    let at = |p: &[f64; 3]| {
+        let c: Vec<String> = p.iter().map(|v| units::len(*v, unit, 3)).collect();
+        format!("({})", c.join(", "))
+    };
+    let coords: Vec<Vec<[f64; 3]>> = picks.iter().filter_map(|g| pick::pick_coords(world, g)).collect();
+    let suffix = unit.suffix();
+    match first.feature {
+        FeatureSel::Chain(_) => match coords.first().map(Vec::as_slice) {
+            Some([a, b]) => {
+                let d = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];
+                let l = (d[0] * d[0] + d[1] * d[1] + d[2] * d[2]).sqrt();
+                let dir = if l > 0.0 && l.is_finite() {
+                    format!(", along ({:.3}, {:.3}, {:.3})", d[0] / l, d[1] / l, d[2] / l)
+                } else {
+                    String::new()
+                };
+                format!("edge on {on}, {} {suffix} long{dir}", units::len(l, unit, 3))
+            }
+            _ => format!("edge on {on} (no longer straight or in the model - re-pick it)"),
+        },
+        _ => {
+            let pts: Vec<String> = coords.iter().filter_map(|c| c.first()).map(at).collect();
+            let head = match picks.len() {
+                1 => format!("1 of 2 points on {on}"),
+                n => format!("{n} points on {on}"),
+            };
+            if pts.is_empty() { head } else { format!("{head} {} {suffix}", pts.join(" -> ")) }
+        }
+    }
+}
diff --git a/crates/ui/src/build_info.rs b/crates/ui/src/build_info.rs
new file mode 100644
index 00000000..b31a6767
--- /dev/null
+++ b/crates/ui/src/build_info.rs
@@ -0,0 +1,65 @@
+//! Identification embedded when the UI crate is compiled.
+
+pub(crate) const VERSION: &str = env!("CARGO_PKG_VERSION");
+pub(crate) const BUILT_UTC: &str = env!("CAMCRAFT_BUILD_UTC");
+pub(crate) const SOURCE_SHA: &str = env!("CAMCRAFT_SOURCE_SHA");
+
+// The toolbar label is pinned under test (version, build time and source)
+// so the shell snapshots do not change with every version bump or commit.
+// "0.0.0" is never a released version. The debug-info dialog keeps the real
+// values.
+#[cfg(test)]
+const TOOLBAR_VERSION: &str = "0.0.0";
+#[cfg(not(test))]
+const TOOLBAR_VERSION: &str = VERSION;
+
+#[cfg(test)]
+const TOOLBAR_BUILD_UTC: &str = "2000-01-01 00:00 UTC";
+#[cfg(not(test))]
+const TOOLBAR_BUILD_UTC: &str = BUILT_UTC;
+
+#[cfg(not(test))]
+pub(crate) fn short_source() -> String {
+    if SOURCE_SHA == "Custom Build" {
+        SOURCE_SHA.to_owned()
+    } else {
+        let modified = if SOURCE_SHA.ends_with("-dirty") { "*" } else { "" };
+        format!("{}{modified}", &SOURCE_SHA[..8])
+    }
+}
+
+#[cfg(test)]
+pub(crate) fn short_source() -> String {
+    "test".to_owned()
+}
+
+/// The bare version label the toolbar shows at its narrowest width.
+pub(crate) fn toolbar_version() -> String {
+    format!("v{TOOLBAR_VERSION}")
+}
+
+pub(crate) fn toolbar_lines(compact: bool) -> (String, String) {
+    let top = format!("{} · {}", toolbar_version(), short_source());
+    let bottom = if compact {
+        format!("{} UTC", TOOLBAR_BUILD_UTC.get(5..16).unwrap_or(TOOLBAR_BUILD_UTC))
+    } else {
+        format!("Built {TOOLBAR_BUILD_UTC}")
+    };
+    (top, bottom)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn toolbar_label_pins_the_test_version_not_the_package_version() {
+        assert_eq!(toolbar_version(), "v0.0.0");
+        assert_ne!(TOOLBAR_VERSION, env!("CARGO_PKG_VERSION"));
+        for compact in [false, true] {
+            let (top, _) = toolbar_lines(compact);
+            assert_eq!(top, "v0.0.0 · test");
+            assert!(!top.contains(env!("CARGO_PKG_VERSION")));
+        }
+    }
+}
diff --git a/crates/ui/src/egui_app/after_op_tests.rs b/crates/ui/src/egui_app/after_op_tests.rs
new file mode 100644
index 00000000..5564ddce
--- /dev/null
+++ b/crates/ui/src/egui_app/after_op_tests.rs
@@ -0,0 +1,92 @@
+//! The op menu's suppress and after-action rows and the post page's
+//! "Skip pauses and homes" switch (#110): each queues its command, and
+//! each rides the history - undo and redo included.
+//! Provenance: our own page law; no vendor material consulted.
+
+use camcraft_app::model;
+use camcraft_app::operation::AfterOperation;
+use camcraft_app::posting;
+
+use super::dialog_tests::{face, opened};
+use crate::state::{CommandKind, State};
+
+fn op(state: &State) -> camcraft_app::schema::Operation {
+    model::find_by_name(&state.world, "Op")
+        .and_then(|e| model::operation_of(&state.world, &e))
+        .expect("the op")
+}
+
+fn run(state: &mut State, kind: CommandKind) {
+    state.pending.push_back(kind);
+    state.drain_actions();
+}
+
+#[test]
+fn after_suppress_and_skip_commands_commit_and_undo() {
+    let mut state = opened(face());
+    assert_eq!(op(&state).after, AfterOperation::None, "a new op carries on");
+    run(&mut state, CommandKind::EditOperationAfter { name: "Op".into(), after: AfterOperation::ProgramStop });
+    assert_eq!(op(&state).after, AfterOperation::ProgramStop);
+    run(&mut state, CommandKind::Undo);
+    assert_eq!(op(&state).after, AfterOperation::None, "Ctrl+Z restores it");
+    run(&mut state, CommandKind::Redo);
+    assert_eq!(op(&state).after, AfterOperation::ProgramStop, "Ctrl+Y reapplies it");
+
+    run(&mut state, CommandKind::SuppressOperation { name: "Op".into(), suppressed: true });
+    assert!(op(&state).suppressed);
+    run(&mut state, CommandKind::Undo);
+    assert!(!op(&state).suppressed, "undo unsuppresses");
+
+    run(&mut state, CommandKind::SetSkipStops(true));
+    assert!(posting::post_options(&state.world).skip_stops);
+    run(&mut state, CommandKind::Undo);
+    assert!(!posting::post_options(&state.world).skip_stops, "undo turns the switch off");
+}
+
+/// #111: the Output choice queues `SetPerOpOutput`, rides the history,
+/// and a per-op post into a folder writes one file per operation.
+#[test]
+fn output_per_op_commits_undoes_and_posts_into_a_folder() {
+    let mut state = opened(face());
+    assert!(!posting::post_options(&state.world).per_op, "one program by default");
+    run(&mut state, CommandKind::SetSkipStops(true));
+    run(&mut state, CommandKind::SetPerOpOutput(true));
+    let opts = posting::post_options(&state.world);
+    assert!(opts.per_op && opts.skip_stops, "the two options are independent: {opts:?}");
+    run(&mut state, CommandKind::Undo);
+    assert!(!posting::post_options(&state.world).per_op, "Ctrl+Z restores one program");
+    assert!(posting::post_options(&state.world).skip_stops, "and leaves the other switch");
+    run(&mut state, CommandKind::Redo);
+    assert!(posting::post_options(&state.world).per_op);
+    let generate = camcraft_app::commands::GenerateOperation::new(&state.world, "Op").expect("generate");
+    state.history.execute(&state.world, generate);
+    let dir = std::env::temp_dir().join(format!("camcraft-egui-per-op-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).expect("temp folder");
+    run(&mut state, CommandKind::PostProgramFolder(dir.clone()));
+    let names: Vec<String> = std::fs::read_dir(&dir)
+        .map(|it| it.filter_map(Result::ok).map(|e| e.file_name().to_string_lossy().into_owned()).collect())
+        .unwrap_or_default();
+    let _ = std::fs::remove_dir_all(&dir);
+    assert_eq!(names, vec!["program_01_Op.nc".to_owned()], "status: {}", state.status);
+    assert!(state.status.contains("one per operation"), "{}", state.status);
+}
+
+/// #596: the Tormach end-units row queues `SetPostOptions`, which rides
+/// the history and leaves the other options as they were.
+#[test]
+fn end_units_choice_commits_and_undoes() {
+    use camcraft_app::schema::{EndUnits, PostOptions};
+    let mut state = opened(face());
+    run(&mut state, CommandKind::SetSkipStops(true));
+    let now = posting::post_options(&state.world);
+    assert_eq!(now.end_units, EndUnits::Leave, "left modal by default");
+    run(&mut state, CommandKind::SetPostOptions(PostOptions { end_units: EndUnits::Inch, ..now }));
+    let opts = posting::post_options(&state.world);
+    assert!(opts.end_units == EndUnits::Inch && opts.skip_stops, "{opts:?}");
+    run(&mut state, CommandKind::Undo);
+    assert_eq!(posting::post_options(&state.world).end_units, EndUnits::Leave, "Ctrl+Z restores it");
+    assert!(posting::post_options(&state.world).skip_stops, "and leaves the other switch");
+    run(&mut state, CommandKind::Redo);
+    assert_eq!(posting::post_options(&state.world).end_units, EndUnits::Inch, "Ctrl+Y reapplies it");
+}
diff --git a/crates/ui/src/egui_app/ball_corner_tests.rs b/crates/ui/src/egui_app/ball_corner_tests.rs
new file mode 100644
index 00000000..e7440cff
--- /dev/null
+++ b/crates/ui/src/egui_app/ball_corner_tests.rs
@@ -0,0 +1,93 @@
+//! #263 in the surface: a ball nose's corner is its ball. The tool
+//! editor shows half the diameter as text with no field to edit, Apply
+//! saves that number, and the library summary reads it; a bull nose
+//! keeps its editable corner.
+//! Provenance: our own tests over our own tool editor page.
+
+use egui::Vec2;
+use egui::accesskit::Role;
+use egui_kittest::Harness;
+use egui_kittest::kittest::Queryable;
+
+use camcraft_app::model;
+use camcraft_app::tools::{Tool, catalog};
+
+use crate::actions;
+use crate::state::{CommandKind, State, UiTarget};
+
+/// A 6 mm ball nose from the catalog, saved with a corner field of 0 -
+/// what a document holds after a draft is retyped from an end mill.
+const BALL: &str = "BN-0600";
+/// A 10 mm bull nose with a 1 mm corner: the one kind that reads its field.
+const BULL: &str = "BB-1000-R1";
+
+fn catalog_tool(name: &str) -> Tool {
+    catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog tool")
+}
+
+/// A document holding `tool` as `name`, with nothing else in it.
+fn with_tool(name: &str, tool: Tool) -> State {
+    let mut state = State::new();
+    state.pending.push_back(CommandKind::AddTool { name: name.to_owned(), tool });
+    state.drain_actions();
+    state
+}
+
+fn saved(state: &State, name: &str) -> Tool {
+    model::find_by_name(&state.world, name).and_then(|e| model::tool_of(&state.world, &e)).expect("the tool")
+}
+
+/// The editor window open on `name`, drawn alone.
+fn editor(mut state: State, name: &str) -> Harness<'static, State> {
+    actions::open_tool_editor(&mut state, name);
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(900.0, 1000.0))
+        .build_ui_state(|ui, st: &mut State| super::pages::tool_editor_window(ui.ctx(), st), state);
+    h.run();
+    h
+}
+
+/// How many number fields sit between the "Corner radius" label and the
+/// next field's label: the editor stacks each value under its label.
+fn corner_fields(h: &Harness<'static, State>) -> usize {
+    let top = h.get_by_label("Corner radius").rect().bottom();
+    let bottom = h.get_by_label("Flute length").rect().top();
+    h.query_all_by(|n| n.role() == Role::SpinButton)
+        .filter(|n| (top..bottom).contains(&n.rect().center().y))
+        .count()
+}
+
+#[test]
+fn a_ball_noses_corner_is_shown_as_its_ball_with_no_field_to_edit() {
+    let ball = Tool { corner_r: 0.0, ..catalog_tool(BALL) };
+    let h = editor(with_tool(BALL, ball), BALL);
+    assert_eq!(corner_fields(&h), 0, "a ball's corner is not an input");
+    assert!(h.query_by_label("3.000 mm").is_some(), "the corner shows half the 6 mm diameter");
+}
+
+#[test]
+fn applying_a_ball_nose_saves_its_corner_as_half_the_diameter() {
+    let ball = Tool { corner_r: 0.0, ..catalog_tool(BALL) };
+    let mut h = editor(with_tool(BALL, ball), BALL);
+    h.get_by_label("Apply").click();
+    h.run();
+    h.state_mut().drain_actions();
+    assert_eq!(saved(h.state(), BALL).corner_r, 3.0);
+}
+
+#[test]
+fn the_library_summary_reads_a_ball_noses_corner_as_its_ball() {
+    let mut state = with_tool(BALL, Tool { corner_r: 0.0, ..catalog_tool(BALL) });
+    state.ui_target = UiTarget::Tool(BALL.to_owned());
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(620.0, 900.0))
+        .build_ui_state(|ui, st: &mut State| super::pages::properties(ui, st, &super::theme::current()), state);
+    h.run();
+    assert!(h.query_by_label_contains("corner r 3.00").is_some(), "the summary names the ball's corner");
+}
+
+#[test]
+fn a_bull_nose_keeps_its_corner_field() {
+    let h = editor(with_tool(BULL, catalog_tool(BULL)), BULL);
+    assert_eq!(corner_fields(&h), 1, "the bull nose reads its corner, so it is edited");
+}
diff --git a/crates/ui/src/egui_app/browser_pane.rs b/crates/ui/src/egui_app/browser_pane.rs
new file mode 100644
index 00000000..008422ba
--- /dev/null
+++ b/crates/ui/src/egui_app/browser_pane.rs
@@ -0,0 +1,205 @@
+//! The browser pane (#343, split from `panes`): the global view toggles,
+//! then the painted tree with its click law. A setup node's radio queues
+//! `ActivateSetup` (undoable); its row opens the setup's settings. Every
+//! node UNDER a setup opens that setup's page - and when the setup is not
+//! the active one it is activated first (the same undoable command), so
+//! the Stock, WCS, Machine, Post and Fixtures editors - which edit the
+//! active setup's furniture and mount - never edit a setup the clicked
+//! node does not belong to.
+//! Provenance: our own port of the imgui browser (our code) and the
+//! maintainer's per-node behaviour (#343); no HSMWorks material consulted.
+
+use egui::{Rect, Sense, Ui, Vec2};
+
+use camcraft_app::{model, setup};
+
+use crate::actions;
+use crate::state::{CommandKind, DisplayMode, SetupPage, State, TreeMenuTarget, UiTarget};
+use crate::viewport::ProjectionMode;
+
+use super::browser_tree::{Leaf, browser_rows};
+use super::icons::IconSet;
+use super::painted;
+use super::theme::Tokens;
+
+/// The browser pane.
+pub fn browser(ui: &mut Ui, state: &mut State, pal: &Tokens, icons: Option<&IconSet>) {
+    ui.checkbox(&mut state.show_world_axes, "Show world origin axes");
+    let mut show_all_paths = state.show_all_paths;
+    if ui.checkbox(&mut show_all_paths, "Show all toolpaths").changed() {
+        if show_all_paths {
+            state.show_all_toolpaths();
+        } else {
+            state.hide_all_toolpaths();
+        }
+    }
+    // The display mode is view state (a direct field flip, never a command).
+    ui.horizontal(|ui| {
+        ui.label("Solids");
+        ui.radio_value(&mut state.display, DisplayMode::ShadedEdges, "Shaded");
+        ui.radio_value(&mut state.display, DisplayMode::Wireframe, "Wireframe");
+    });
+    // Projection is view state the same way (#434): orthographic keeps
+    // a side view straight - parallel edges, no converging - which is
+    // what CAM eyeballing wants most of the time.
+    ui.horizontal(|ui| {
+        ui.label("Projection");
+        ui.radio_value(&mut state.cam.projection, ProjectionMode::Perspective, "Perspective");
+        ui.radio_value(&mut state.cam.projection, ProjectionMode::Orthographic, "Ortho");
+    });
+    ui.separator();
+    let (rows, leaves) = browser_rows(state);
+    let rect = Rect::from_min_size(
+        ui.cursor().min,
+        Vec2::new(ui.available_width(), rows.len() as f32 * pal.row_height),
+    );
+    let hit = painted::tree(ui, rect, &rows, pal, icons);
+    drag_ops(ui, state, pal, rect, &leaves, hit.drag_started);
+    if let Some(ix) = hit.radio
+        && let Some(Leaf::Setup(name)) = leaves.get(ix)
+    {
+        focus(state, name);
+    }
+    if let Some(leaf) = hit.eye.and_then(|ix| leaves.get(ix)) {
+        eye(state, leaf);
+    }
+    if let Some(leaf) = hit.row.and_then(|ix| leaves.get(ix)).cloned() {
+        click(state, leaf);
+    }
+    // Operation rows offer the operation verbs; a setup's Operations row
+    // offers Paste even when it has no operation rows yet (activating
+    // the setup, so the menu anchors on the row that was clicked). Model
+    // rows offer Use / Stop using as fixture, a setup's Fixtures node
+    // Import fixture… (#339 slice 4).
+    if let Some(ix) = hit.menu {
+        let target = match leaves.get(ix) {
+            Some(Leaf::Op(name)) => Some(TreeMenuTarget::Operation(name.clone())),
+            Some(Leaf::Entry(name)) => Some(TreeMenuTarget::Entry(name.clone())),
+            Some(Leaf::SetupOps(setup)) => {
+                focus(state, setup);
+                Some(TreeMenuTarget::Operations)
+            }
+            // #339 slice 4: the fixture verbs.
+            Some(Leaf::Model(name)) => Some(TreeMenuTarget::Model { name: name.clone(), row: ix }),
+            Some(Leaf::Page(setup, SetupPage::Fixtures)) => {
+                focus(state, setup);
+                Some(TreeMenuTarget::Fixtures(setup.clone()))
+            }
+            _ => None,
+        };
+        state.tree_menu = target.filter(|target| state.tree_menu.as_ref() != Some(target));
+        state.retype_confirm = None;
+    }
+    super::tree_menu::tree_menu(ui, state, pal, rect, &leaves);
+    ui.allocate_rect(rect, Sense::hover());
+}
+
+/// Make `setup` the active setup (one undoable `ActivateSetup`) unless it
+/// already is, or it is the implicit setup of a setup-free document.
+pub(super) fn focus(state: &mut State, name: &str) {
+    if name.is_empty() || setup::active(&state.world).as_deref() == Some(name) {
+        return;
+    }
+    state.pending.push_back(CommandKind::ActivateSetup(Some(name.to_owned())));
+}
+
+fn ctx(name: &str) -> Option<&str> {
+    (!name.is_empty()).then_some(name)
+}
+
+fn eye(state: &mut State, leaf: &Leaf) {
+    match leaf {
+        Leaf::Model(n) => State::toggle_visibility(&mut state.hidden_models, n),
+        Leaf::Stock(s) => {
+            let name = setup::stock_entity_name(&state.world, ctx(s));
+            State::toggle_visibility(&mut state.hidden_stocks, &name);
+        }
+        Leaf::Wcs(s) => {
+            let name = setup::wcs_entity_name(&state.world, ctx(s));
+            State::toggle_visibility(&mut state.hidden_offsets, &name);
+        }
+        Leaf::Op(n) => State::toggle_visibility(&mut state.hidden_paths, n),
+        _ => {}
+    }
+}
+
+pub(super) fn click(state: &mut State, leaf: Leaf) {
+    match leaf {
+        Leaf::Section => {}
+        Leaf::Parent(section) => {
+            let expanded = &mut state.browser_expanded[section.index()];
+            *expanded = !*expanded;
+        }
+        // Target-only, like the Tool rows: browsing setups never arms Del.
+        Leaf::Setups => actions::target(state, UiTarget::Setups),
+        Leaf::Setup(name) => actions::target(state, UiTarget::SetupNode(name, SetupPage::Settings)),
+        Leaf::Stock(s) => {
+            focus(state, &s);
+            actions::target(state, UiTarget::Stock);
+            let name = setup::stock_entity_name(&state.world, ctx(&s));
+            if model::find_by_name(&state.world, &name).is_some() {
+                state.pending.push_back(CommandKind::Select(Some(name)));
+            }
+        }
+        Leaf::Wcs(s) => {
+            focus(state, &s);
+            actions::target(state, UiTarget::Wcs);
+            let name = setup::wcs_entity_name(&state.world, ctx(&s));
+            if model::find_by_name(&state.world, &name).is_some() {
+                state.pending.push_back(CommandKind::Select(Some(name)));
+            }
+        }
+        Leaf::Page(s, page) => {
+            focus(state, &s);
+            actions::target(state, UiTarget::SetupNode(s, page));
+        }
+        Leaf::SetupOps(s) => focus(state, &s),
+        Leaf::Model(n) => {
+            actions::target(state, UiTarget::Model(n.clone()));
+            state.pending.push_back(CommandKind::Select(Some(n)));
+        }
+        // Target only: no Select, so browsing tools never arms Del.
+        Leaf::Tool(n) => actions::target(state, UiTarget::Tool(n)),
+        Leaf::Op(n) => {
+            actions::target(state, UiTarget::Operation(n.clone()));
+            state.pending.push_back(CommandKind::Select(Some(n)));
+        }
+        // #155: selected, so Del deletes it (undoable); no page of its own.
+        Leaf::Entry(n) => state.pending.push_back(CommandKind::Select(Some(n))),
+    }
+}
+
+/// Drag an operation row onto another of the SAME setup: the insertion
+/// line and the `ReorderOperation` command use the same target row.
+fn drag_ops(ui: &mut Ui, state: &mut State, pal: &Tokens, rect: Rect, leaves: &[Leaf], started: Option<usize>) {
+    if let Some(ix) = started
+        && let Some(Leaf::Op(name) | Leaf::Entry(name)) = leaves.get(ix)
+    {
+        state.dragging_op = Some(name.clone());
+    }
+    let Some(source) = state.dragging_op.clone() else {
+        return;
+    };
+    let (released, pointer) = ui.input(|i| (i.pointer.any_released(), i.pointer.hover_pos()));
+    let drop = pointer.filter(|p| rect.contains(*p)).and_then(|p| {
+        let ix = ((p.y - rect.top()) / pal.row_height) as usize;
+        let (Leaf::Op(target) | Leaf::Entry(target)) = leaves.get(ix)? else { return None };
+        // #155: entries drag and take drops like operations.
+        let setup_of = |name: &str| {
+            model::find_by_name(&state.world, name)
+                .and_then(|e| camcraft_app::program_entry::effective_setup(&state.world, &e))
+        };
+        let after = p.y > rect.top() + (ix as f32 + 0.5) * pal.row_height;
+        (source != *target && setup_of(&source) == setup_of(target)).then_some((ix, target.clone(), after))
+    });
+    if let Some((ix, target, after)) = drop {
+        let y = rect.top() + (ix + usize::from(after)) as f32 * pal.row_height;
+        ui.painter().hline(rect.x_range(), y, egui::Stroke::new(2.0, pal.accent));
+        if released {
+            state.pending.push_back(CommandKind::ReorderOperation { name: source, target, after });
+        }
+    }
+    if released {
+        state.dragging_op = None;
+    }
+}
diff --git a/crates/ui/src/egui_app/browser_tree.rs b/crates/ui/src/egui_app/browser_tree.rs
new file mode 100644
index 00000000..99abccb8
--- /dev/null
+++ b/crates/ui/src/egui_app/browser_tree.rs
@@ -0,0 +1,332 @@
+//! The browser tree's rows (#343, split from `panes`): each setup is a
+//! node with a radio (the active setup) and its own children, in order -
+//! WCS, Stock, Machine, Post, Fixtures (each fixture a child), Tool list,
+//! Operations (its 1+n operations, in machining order). A document without
+//! setups shows the same children straight under the Setup section, for
+//! its implicit setup. Models and the document's tool library follow.
+//! Rows are pure data (`painted::Row` plus a parallel `Leaf`), so the
+//! tree's shape is testable without a harness; the click law is
+//! `browser_pane`.
+//! Provenance: our own tree layout (issue #343, the maintainer's node
+//! list); no HSMWorks material consulted.
+
+use camcraft_app::model;
+use camcraft_app::operation;
+use camcraft_app::schema::WCS_SLOTS;
+use camcraft_app::tools::ToolKind;
+use camcraft_app::{setup, setup_mount};
+
+use crate::state::{SetupPage, State, UiTarget};
+
+use super::icons::Icon;
+use super::painted;
+use super::panes::op_icon;
+
+/// The tree's collapsible top-level sections.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum BrowserSection {
+    Setup,
+    Models,
+    Tools,
+}
+
+impl BrowserSection {
+    pub(super) const fn index(self) -> usize {
+        self as usize
+    }
+}
+
+/// What a browser row's click means. Parallel to the painted Row list.
+/// Setup-scoped rows carry their setup's name (`""` - the implicit setup
+/// of a document without setups).
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum Leaf {
+    Section,
+    Parent(BrowserSection),
+    /// The Setups manager row (M3.2 A, #322): target-only, never arms Del.
+    Setups,
+    /// A setup node: the radio activates it, the row opens its settings.
+    Setup(String),
+    Wcs(String),
+    Stock(String),
+    /// The Machine / Post / Fixtures / Tool list nodes.
+    Page(String, SetupPage),
+    /// A setup's Operations node: the menu row for Paste.
+    SetupOps(String),
+    Model(String),
+    Tool(String),
+    Op(String),
+    /// A Pause / Home entry of the operation list (#155).
+    Entry(String),
+}
+
+/// Append one tree row and its parallel leaf. `icon` is the bundled glyph
+/// for the row's subject, `None` for headers (and the setup radio).
+#[allow(clippy::too_many_arguments)]
+pub(super) fn push_row(
+    rows: &mut Vec<painted::Row>,
+    leaves: &mut Vec<Leaf>,
+    label: String,
+    suffix: String,
+    kind: painted::Kind,
+    icon: Option<Icon>,
+    selected: bool,
+    hidden: bool,
+    depth: usize,
+    leaf: Leaf,
+) {
+    rows.push(painted::Row { label, suffix, kind, icon, selected, hidden, depth });
+    leaves.push(leaf);
+}
+
+/// What a Models row says about its model (M3.2 B): the fixture marker
+/// rides the suffix column ahead of the hidden marker, and the kind/icon
+/// pair picks the vise glyph for steel the program must dodge.
+pub(crate) fn model_row_marks(is_fixture: bool, hidden: bool) -> (String, painted::Kind, Icon) {
+    let mut suffix = String::new();
+    if is_fixture {
+        suffix.push_str(" (fixture)");
+    }
+    if hidden {
+        suffix.push_str(" (hidden)");
+    }
+    (
+        suffix,
+        if is_fixture { painted::Kind::Fixture } else { painted::Kind::Model },
+        if is_fixture { Icon::Fixture } else { Icon::Model },
+    )
+}
+
+/// A Fixtures child row's suffix (#339 slice 4): how the gate judges
+/// the steel - `mesh`, or `box only: <reason>` - then the hidden marker.
+pub(crate) fn fixture_row_suffix(mesh: Option<camcraft_app::fixture_view::MeshState>, hidden: bool) -> String {
+    let mut suffix = mesh.map(|m| m.label()).unwrap_or_default();
+    if hidden {
+        suffix.push_str(" (hidden)");
+    }
+    suffix
+}
+
+pub(crate) fn kind_name(k: ToolKind) -> &'static str {
+    match k {
+        ToolKind::EndMill => "end mill",
+        ToolKind::BallNose => "ball nose",
+        ToolKind::BullNose => "bull nose",
+        ToolKind::Drill => "drill",
+        ToolKind::Tap => "tap",
+        ToolKind::Bore => "boring bar",
+        ToolKind::Turning => "turning insert",
+        ToolKind::Groove => "grooving blade",
+        ToolKind::Thread => "threading insert",
+        ToolKind::Form => "form gauge",
+        ToolKind::Taper => "chamfer mill",
+        ToolKind::Probe => "touch probe",
+    }
+}
+
+/// The whole tree: the Setup section (the manager row, then one node per
+/// setup - or the implicit setup's children), Models, and the document's
+/// tool library. Empty lists show a faint placeholder row.
+pub(crate) fn browser_rows(state: &State) -> (Vec<painted::Row>, Vec<Leaf>) {
+    let mut rows = Vec::new();
+    let mut leaves = Vec::new();
+    let t = state.pane_target();
+
+    let setup_open = state.browser_expanded[BrowserSection::Setup.index()];
+    push_row(&mut rows, &mut leaves, "Setup".into(), String::new(), painted::Kind::Parent(setup_open), None, false, false, 0, Leaf::Parent(BrowserSection::Setup));
+    if setup_open {
+        // The manager row stands whenever the section is open (#322): its
+        // page is where the FIRST setup is created.
+        push_row(&mut rows, &mut leaves, "Setups".to_owned(), String::new(), painted::Kind::Section, Some(Icon::Fixture), matches!(t, UiTarget::Setups), false, 1, Leaf::Setups);
+        let names = setup::names(&state.world);
+        if names.is_empty() {
+            setup_children(state, &t, "", 1, &mut rows, &mut leaves);
+        }
+        let active = setup::active(&state.world);
+        for name in names {
+            let is_active = active.as_deref() == Some(name.as_str());
+            let selected = matches!(&t, UiTarget::SetupNode(n, SetupPage::Settings) if *n == name);
+            let suffix = if is_active { "active".to_owned() } else { String::new() };
+            push_row(&mut rows, &mut leaves, name.clone(), suffix, painted::Kind::Setup(is_active), None, selected, false, 1, Leaf::Setup(name.clone()));
+            setup_children(state, &t, &name, 2, &mut rows, &mut leaves);
+        }
+    }
+
+    let models_open = state.browser_expanded[BrowserSection::Models.index()];
+    push_row(&mut rows, &mut leaves, "Models".into(), String::new(), painted::Kind::Parent(models_open), None, false, false, 0, Leaf::Parent(BrowserSection::Models));
+    if models_open {
+        let entities = model::model_entities(&state.world);
+        if entities.is_empty() {
+            push_row(&mut rows, &mut leaves, "(no models yet)".into(), String::new(), painted::Kind::Section, None, false, true, 1, Leaf::Section);
+        }
+        for (name, entity) in entities {
+            let selected = model::is_selected(&state.world, &entity);
+            let hidden = state.hidden_models.contains(&name);
+            let (suffix, kind, icon) = model_row_marks(model::is_fixture(&state.world, &entity), hidden);
+            let target = matches!(&t, UiTarget::Model(n) if *n == name) || selected;
+            push_row(&mut rows, &mut leaves, name.clone(), suffix, kind, Some(icon), target, hidden, 1, Leaf::Model(name));
+        }
+    }
+
+    // The document's tool LIBRARY (decision #343 (b)): every setup's Tool
+    // list is a view over these entries.
+    let tools_open = state.browser_expanded[BrowserSection::Tools.index()];
+    push_row(&mut rows, &mut leaves, "Tools".into(), String::new(), painted::Kind::Parent(tools_open), None, false, false, 0, Leaf::Parent(BrowserSection::Tools));
+    if tools_open {
+        let tools: Vec<(String, camcraft_app::tools::Tool)> = model::named_entities(&state.world)
+            .into_iter()
+            .filter(|(_, e)| model::is_tool(&state.world, e))
+            .filter_map(|(name, e)| model::tool_of(&state.world, &e).map(|t| (name, t)))
+            .collect();
+        if tools.is_empty() {
+            push_row(&mut rows, &mut leaves, "(no tools yet)".into(), String::new(), painted::Kind::Section, None, false, true, 1, Leaf::Section);
+        }
+        for (name, tool) in tools {
+            let suffix = format!("Ø{} {}", tool.diameter, kind_name(tool.kind));
+            let selected = matches!(&t, UiTarget::Tool(n) if *n == name);
+            push_row(&mut rows, &mut leaves, name.clone(), suffix, painted::Kind::Tool, Some(Icon::Tools), selected, false, 1, Leaf::Tool(name));
+        }
+    }
+    (rows, leaves)
+}
+
+/// One setup's children at `depth` (`name` `""` - the implicit setup).
+fn setup_children(
+    state: &State,
+    t: &UiTarget,
+    name: &str,
+    depth: usize,
+    rows: &mut Vec<painted::Row>,
+    leaves: &mut Vec<Leaf>,
+) {
+    let w = &state.world;
+    let ctx = (!name.is_empty()).then_some(name);
+    let is_active = ctx.is_none() || setup::active(w).as_deref() == ctx;
+    let page_open = |p: SetupPage| matches!(t, UiTarget::SetupNode(n, q) if n == name && *q == p);
+    // #342: one WCS per setup - plain "WCS", the word its post writes beside it.
+    let word = WCS_SLOTS.get(setup::wcs_slot(w, ctx)).copied().unwrap_or("G54");
+    let wcs_hidden = state.hidden_offsets.contains(&setup::wcs_entity_name(w, ctx));
+    push_row(rows, leaves, "WCS".to_owned(), word.to_owned(), painted::Kind::Wcs, Some(Icon::WorkOffset), is_active && matches!(t, UiTarget::Wcs), wcs_hidden, depth, Leaf::Wcs(name.to_owned()));
+    let stock_hidden = state.hidden_stocks.contains(&setup::stock_entity_name(w, ctx));
+    push_row(rows, leaves, "Stock".to_owned(), String::new(), painted::Kind::Stock, Some(Icon::Stock), is_active && matches!(t, UiTarget::Stock), stock_hidden, depth, Leaf::Stock(name.to_owned()));
+    let own = |owns: bool| if owns { "  (own)" } else { "" };
+    let machine = format!(
+        "{}{}",
+        setup_mount::machine_label(&setup_mount::machine_of(w, ctx)),
+        own(setup_mount::own_machine(w, ctx).is_some()),
+    );
+    push_row(rows, leaves, "Machine".to_owned(), machine, painted::Kind::Section, Some(Icon::Simulate), page_open(SetupPage::Machine), false, depth, Leaf::Page(name.to_owned(), SetupPage::Machine));
+    let post = format!(
+        "{}{}",
+        camcraft_app::posting::post_ref_label(&setup_mount::post_of(w, ctx)),
+        own(setup_mount::own_post(w, ctx).is_some()),
+    );
+    push_row(rows, leaves, "Post".to_owned(), post, painted::Kind::Section, Some(Icon::Post), page_open(SetupPage::Post), false, depth, Leaf::Page(name.to_owned(), SetupPage::Post));
+    let fixtures = camcraft_app::fixture::tagged(w, ctx);
+    push_row(rows, leaves, "Fixtures".to_owned(), count(fixtures.len(), "fixture"), painted::Kind::Section, Some(Icon::Fixture), page_open(SetupPage::Fixtures), false, depth, Leaf::Page(name.to_owned(), SetupPage::Fixtures));
+    for (fixture, entity) in fixtures {
+        let hidden = state.hidden_models.contains(&fixture);
+        let selected = matches!(t, UiTarget::Model(n) if *n == fixture) || model::is_selected(w, &entity);
+        let suffix = fixture_row_suffix(state.fixture_mesh_state(&fixture), hidden);
+        push_row(rows, leaves, fixture.clone(), suffix, painted::Kind::Fixture, Some(Icon::Fixture), selected, hidden, depth + 1, Leaf::Model(fixture));
+    }
+    let ops = setup_ops(state, ctx);
+    let tools = count(distinct_tools(state, &ops), "tool");
+    push_row(rows, leaves, "Tool list".to_owned(), tools, painted::Kind::Section, Some(Icon::Tools), page_open(SetupPage::Tools), false, depth, Leaf::Page(name.to_owned(), SetupPage::Tools));
+    push_row(rows, leaves, "Operations".to_owned(), String::new(), painted::Kind::Section, Some(Icon::Generate), false, false, depth, Leaf::SetupOps(name.to_owned()));
+    if ops.is_empty() {
+        push_row(rows, leaves, "(no operations yet)".into(), String::new(), painted::Kind::Section, None, false, true, depth + 1, Leaf::Section);
+    }
+    for (key, entity) in ops {
+        if camcraft_app::program_entry::is_entry(w, &entity) {
+            super::tree_entry::entry_row(state, &key, &entity, depth + 1, rows, leaves);
+        } else {
+            op_row(state, t, &key, &entity, depth + 1, rows, leaves);
+        }
+    }
+}
+
+fn count(n: usize, word: &str) -> String {
+    match n {
+        0 => String::new(),
+        1 => format!("1 {word}"),
+        n => format!("{n} {word}s"),
+    }
+}
+
+/// The setup's operations in program order (`None` - every operation),
+/// its Pause / Home entries among them (#155).
+fn setup_ops(state: &State, ctx: Option<&str>) -> Vec<(String, flecs_ecs::prelude::Entity)> {
+    let w = &state.world;
+    camcraft_app::program_entry::sequence(w)
+        .into_iter()
+        .filter(|(_, e)| {
+            ctx.is_none_or(|s| {
+                setup::belongs(w, camcraft_app::program_entry::declared_setup(w, e).as_deref(), s)
+            })
+        })
+        .collect()
+}
+
+fn distinct_tools(state: &State, ops: &[(String, flecs_ecs::prelude::Entity)]) -> usize {
+    let mut seen: Vec<String> = Vec::new();
+    for (_, e) in ops {
+        if let Some(op) = model::operation_of(&state.world, e)
+            && !seen.contains(&op.tool)
+        {
+            seen.push(op.tool);
+        }
+    }
+    seen.len()
+}
+
+/// One operation row: kind, generation tag, warnings, flow marks, and a
+/// BLOCKED reason when the tool law refuses it.
+fn op_row(
+    state: &State,
+    t: &UiTarget,
+    name: &str,
+    entity: &flecs_ecs::prelude::Entity,
+    depth: usize,
+    rows: &mut Vec<painted::Row>,
+    leaves: &mut Vec<Leaf>,
+) {
+    let w = &state.world;
+    let (kind, icon) = model::operation_of(w, entity)
+        .map(|op| {
+            let k = op.params.kind();
+            (k.to_string(), op_icon(k))
+        })
+        .unwrap_or_else(|| (String::new(), Icon::Generate));
+    let tag = match operation::status_of(w, entity) {
+        operation::OpStatus::Never => "never",
+        operation::OpStatus::Ok => "ok",
+        operation::OpStatus::Stale => "STALE",
+    };
+    let warns = model::toolpath_of(w, entity).map_or(0, |tp| tp.warnings.len());
+    let warn_text = match warns {
+        0 => String::new(),
+        1 => "  1 warning".to_owned(),
+        n => format!("  {n} warnings"),
+    };
+    // #110: a suppressed op and a stop / home after it say so on the row.
+    let flow = model::operation_of(w, entity).map_or_else(String::new, |op| {
+        let mut s = String::new();
+        if op.suppressed {
+            s.push_str("  SUPPRESSED");
+        }
+        if !op.after.is_default() {
+            s.push_str("  then ");
+            s.push_str(op.after.label());
+        }
+        s
+    });
+    let suffix = match operation::tool_gate::tool_problem_of(w, entity) {
+        Some(why) => format!("{kind}  BLOCKED{warn_text}{flow}  {why}"),
+        None => format!("{kind}  {tag}{warn_text}{flow}"),
+    };
+    let hidden = state.hidden_paths.iter().any(|p| p == name);
+    let selected = matches!(t, UiTarget::Operation(n) if n == name);
+    let label = model::operation_label(w, name, entity);
+    push_row(rows, leaves, label, suffix, painted::Kind::Op, Some(icon), selected, hidden, depth, Leaf::Op(name.to_owned()));
+}
diff --git a/crates/ui/src/egui_app/colorvision.rs b/crates/ui/src/egui_app/colorvision.rs
