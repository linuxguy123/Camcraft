diff --git a/crates/app/src/fixture_carried.rs b/crates/app/src/fixture_carried.rs
new file mode 100644
index 00000000..02c6cfb1
--- /dev/null
+++ b/crates/app/src/fixture_carried.rs
@@ -0,0 +1,141 @@
+//! Workholding in a carried setup (#321): a setup entered with the body
+//! the earlier setups machined (#317) holds THAT body, not its declared
+//! block - so its fixtures are read against the carried stock. A fixture
+//! standing inside the material the program really carries in (a vise
+//! jaw modelled into a wall setup 1 left standing, a clamp on a face that
+//! is still there) is workholding that cannot be where it is modelled:
+//! every fixture verdict of that setup judged steel the machine will not
+//! hold there, and the post is refused by name.
+//!
+//! Provenance: our own design per #308's research decision (the carried
+//! body is the incoming stock, read through each setup's transform);
+//! plain re-clamp practice from machine-tool handbooks. No vendor
+//! material consulted.
+//!
+//! ## The laws here
+//!
+//! - **The carried body, not the declared block.** Only the body the
+//!   setup is ENTERED with is read (`rest::entered_body`, the carried-body
+//!   cache's entry): a clamp seated in a pocket setup 1 cut, inside the
+//!   declared block but clear of the real material, is no conflict.
+//! - **Penetration, not contact.** A column counts when its centre lies
+//!   strictly inside the fixture's footprint and its material
+//!   (`floor..top`) overlaps the fixture's Z span by more than
+//!   [`FIXTURE_HIT_TOL`] - jaws gripping a side face and a part seated on
+//!   a plate are contact by design. A footprint narrower than a cell
+//!   (holding no centre) is judged by the column under its own centre. The column sampling resolves to the
+//!   carried grid's pitch: an overlap narrower than half a cell beside a
+//!   face can pass, and is stated so in the decision record.
+//! - **Live, like every workholding law.** Read at the post gate against
+//!   the steel as it stands now, never baked into a stamp (`fixture`'s
+//!   live-gate law). The machine table is not read: the table is what the
+//!   setup's stock stands on, not steel placed against it.
+//! - **Unreadable is not clear.** A carry the gate cannot read leaves the
+//!   ops of that setup refused by their own generation (#318/#319); this
+//!   clause adds nothing for it, it never reads the declared block instead.
+
+use flecs_ecs::prelude::World;
+
+use crate::fixture::{FIXTURE_HIT_TOL, FixtureBox};
+use crate::geo2d::Point2;
+use crate::model;
+use crate::stock_sim::Body;
+
+/// The phrase every carried-workholding refusal carries.
+pub const FIXTURE_IN_CARRIED: &str = "stands inside the stock carried from";
+
+/// How deep `b` stands in `body`'s material: the largest Z overlap of a
+/// column whose centre lies strictly inside the box's footprint, or
+/// `None` when no column overlaps beyond [`FIXTURE_HIT_TOL`].
+#[must_use]
+pub fn penetration(body: &Body, b: &FixtureBox) -> Option<f64> {
+    let dex = &body.dex;
+    let (bx0, bx1) = (b.min.x.min(b.max.x), b.max.x.max(b.min.x));
+    let (by0, by1) = (b.min.y.min(b.max.y), b.max.y.max(b.min.y));
+    let (bz0, bz1) = (b.min.z.min(b.max.z), b.max.z.max(b.min.z));
+    if !(bx0.is_finite() && bx1.is_finite() && by0.is_finite() && by1.is_finite() && bz0.is_finite() && bz1.is_finite())
+        || !(dex.cell.is_finite() && dex.cell > 0.0)
+    {
+        return None;
+    }
+    // The cell index span the footprint covers, clamped to the grid
+    // (float -> index through a clamp, never an unchecked cast).
+    let span = |lo: f64, hi: f64, o: f64, n: usize| -> (usize, usize) {
+        let top = n as f64;
+        let i0 = ((lo - o) / dex.cell - 1.0).floor().clamp(0.0, top);
+        let i1 = ((hi - o) / dex.cell + 1.0).ceil().clamp(0.0, top);
+        (i0 as usize, i1 as usize)
+    };
+    let (ix0, ix1) = span(bx0, bx1, dex.x0, dex.nx);
+    let (iy0, iy1) = span(by0, by1, dex.y0, dex.ny);
+    let mut worst: Option<f64> = None;
+    let mut any_inside = false;
+    let judge = |k: usize, worst: &mut Option<f64>| {
+        if body.empty_at(k) {
+            return;
+        }
+        let depth = dex.top_at(k).min(bz1) - body.floor_at(k).max(bz0);
+        if depth.is_finite() && depth > FIXTURE_HIT_TOL {
+            *worst = Some(worst.map_or(depth, |w: f64| w.max(depth)));
+        }
+    };
+    for iy in iy0..iy1 {
+        for ix in ix0..ix1 {
+            let c = dex.center(ix, iy);
+            let inside = c.x > bx0 + FIXTURE_HIT_TOL
+                && c.x < bx1 - FIXTURE_HIT_TOL
+                && c.y > by0 + FIXTURE_HIT_TOL
+                && c.y < by1 - FIXTURE_HIT_TOL;
+            if inside {
+                any_inside = true;
+                judge(ix + iy * dex.nx, &mut worst);
+            }
+        }
+    }
+    // A footprint narrower than a cell holds no column centre: the column
+    // under its own centre speaks for it, never nothing.
+    if !any_inside && let Some(k) = dex.col(Point2::new((bx0 + bx1) * 0.5, (by0 + by1) * 0.5)) {
+        judge(k, &mut worst);
+    }
+    worst
+}
+
+/// The gate's carried-workholding clause: per setup entered with a
+/// carried body, one problem per tagged fixture standing in it. The
+/// setup's first op in program order reads the chain (every op of a
+/// setup is entered with the same body).
+#[must_use]
+pub fn carried_fixture_problems(world: &World) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut seen: Vec<Option<String>> = Vec::new();
+    for (name, e) in crate::setup::operation_order(world) {
+        let Some(op) = model::operation_of(world, &e) else { continue };
+        let setup = crate::setup::effective(world, op.setup.as_deref());
+        if seen.contains(&setup) {
+            continue;
+        }
+        seen.push(setup.clone());
+        let fixtures = crate::fixture::tagged(world, setup.as_deref());
+        if fixtures.is_empty() {
+            continue;
+        }
+        let tool_r = model::find_by_name(world, &op.tool)
+            .and_then(|t| model::tool_of(world, &t))
+            .map_or(0.0, |t| t.diameter * 0.5);
+        // A refused carry is refused by every op's own generation.
+        let Ok(Some((origin, body))) = crate::rest::entered_body(world, &name, setup.as_deref(), tool_r) else {
+            continue;
+        };
+        let to = setup.as_deref().unwrap_or_default();
+        for (fname, fe) in fixtures {
+            let Some(b) = model::entity_world_aabb(world, &fe) else { continue };
+            if let Some(d) = penetration(&body, &FixtureBox { min: b.min, max: b.max }) {
+                out.push(format!(
+                    "setup '{to}': fixture '{fname}' {FIXTURE_IN_CARRIED} setup '{origin}' ({d:.2} mm deep) - \
+                     the part that setup leaves cannot be held as modelled; move the fixture or re-check the hold"
+                ));
+            }
+        }
+    }
+    out
+}
diff --git a/crates/app/src/fixture_library.rs b/crates/app/src/fixture_library.rs
new file mode 100644
index 00000000..85662764
--- /dev/null
+++ b/crates/app/src/fixture_library.rs
@@ -0,0 +1,270 @@
+//! The fixture library file (#339 slice 6): user-saved workholding
+//! solids (vises, chuck jaws, plates), each a named mesh with the datum
+//! it is placed by, inside a small `camcraft-fixtures/1` envelope - the
+//! tool library's `camcraft-tools/1` shape (#300): a versioned JSON
+//! envelope, a strict reader that refuses the whole file by entry name,
+//! and a writer whose save -> load -> save is byte-stable.
+//!
+//! An entry's facets are the fixture's mesh in its OWN model frame,
+//! exactly the bytes its `Facets` carry; `datum` is a frame inside that
+//! model frame - the point and orientation that land on the picked
+//! placement when the entry is inserted (`commands::InsertFixture`).
+//! The default datum is the model origin (identity), so a fixture saved
+//! and re-inserted at its old pose stands exactly where it stood.
+//!
+//! Provenance: our own format, built from our own model components; the
+//! shapes in a library are whatever the user saved - no vendor fixture
+//! library or asset was read, consulted or shipped (#339 triage).
+
+use serde_json::{Value, json};
+
+use crate::geometry::{IDENTITY_Q, Point3, Triangle, normalize_quat};
+use crate::model;
+use crate::schema::Location;
+
+mod store;
+
+pub use store::{
+    ENV_VAR, LIBRARY_FILE, LibraryError, add_entries, delete_entry, library_path, load, save, user_dir,
+    user_dir_for,
+};
+
+/// The envelope's `format` tag.
+pub const FORMAT: &str = "camcraft-fixtures";
+/// The envelope's `version`; a reader refuses any other.
+pub const VERSION: u64 = 1;
+/// The extension of a library file.
+pub const EXTENSION: &str = "camfixtures";
+/// A sanity cap on one entry's facets (a library entry is a vise, not
+/// a scanned building); larger is refused by name, never truncated.
+pub const MAX_FACETS: usize = 2_000_000;
+
+/// One named fixture of a library file.
+#[derive(Clone, Debug, PartialEq)]
+pub struct FixtureEntry {
+    pub name: String,
+    /// Free text the user saved with it (`None` writes no key).
+    pub note: Option<String>,
+    /// The placement datum, in the mesh's own frame (a rotation,
+    /// normalized when placed).
+    pub datum: Location,
+    /// The mesh in the fixture's own model frame.
+    pub facets: Vec<Triangle>,
+}
+
+/// Which frame of the fixture a saved entry is placed by.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum DatumChoice {
+    /// The model's own origin and axes (the default).
+    #[default]
+    ModelOrigin,
+    /// The centre of the mesh's bounding box bottom, model axes - the
+    /// face a vise or plate sits on.
+    BottomCentre,
+}
+
+/// The bottom-centre point of a mesh's bounds (finite vertices only).
+fn bottom_centre(tris: &[Triangle]) -> Option<Point3> {
+    let mut lo = [f64::MAX; 3];
+    let mut hi = [f64::MIN; 3];
+    let mut any = false;
+    for p in tris.iter().flat_map(|t| [t.a, t.b, t.c]) {
+        if p.is_finite() {
+            any = true;
+            for (k, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+                lo[k] = lo[k].min(v);
+                hi[k] = hi[k].max(v);
+            }
+        }
+    }
+    any.then(|| Point3::new(0.5 * (lo[0] + hi[0]), 0.5 * (lo[1] + hi[1]), lo[2]))
+}
+
+/// The library entry for model `name` of this document: its facets in
+/// its own frame and the chosen datum. Refused by name when the model
+/// has no geometry, or a non-finite vertex (the library never carries
+/// a mesh it would refuse to read back).
+pub fn entry_from_model(
+    world: &flecs_ecs::prelude::World,
+    name: &str,
+    datum: DatumChoice,
+    note: Option<&str>,
+) -> Result<FixtureEntry, String> {
+    let e = model::find_by_name(world, name)
+        .filter(|e| model::is_model(world, e))
+        .ok_or_else(|| format!("no model named '{name}'"))?;
+    let facets: Vec<Triangle> = model::facets_of(world, &e).map(|f| f.to_vec()).unwrap_or_default();
+    let origin = match datum {
+        DatumChoice::ModelOrigin => Point3::ZERO,
+        DatumChoice::BottomCentre => bottom_centre(&facets).unwrap_or(Point3::ZERO),
+    };
+    let entry = FixtureEntry {
+        name: name.trim().to_owned(),
+        note: note.map(str::trim).filter(|n| !n.is_empty()).map(str::to_owned),
+        datum: Location { pos: origin, rot: IDENTITY_Q },
+        facets,
+    };
+    check_entry(&entry)?;
+    Ok(entry)
+}
+
+/// The per-entry law the reader and every writer share.
+pub fn check_entry(e: &FixtureEntry) -> Result<(), String> {
+    let name = &e.name;
+    if name.trim().is_empty() {
+        return Err("a fixture has no name".into());
+    }
+    if name.trim() != name {
+        return Err(format!("fixture '{name}': the name has leading or trailing spaces"));
+    }
+    if name == crate::fixture::MACHINE_TABLE {
+        return Err(format!("fixture '{name}': that name is the derived machine table"));
+    }
+    if e.facets.is_empty() {
+        return Err(format!("fixture '{name}' has no facets"));
+    }
+    if e.facets.len() > MAX_FACETS {
+        return Err(format!("fixture '{name}' has {} facets (at most {MAX_FACETS})", e.facets.len()));
+    }
+    if e.facets.iter().any(|t| !(t.a.is_finite() && t.b.is_finite() && t.c.is_finite())) {
+        return Err(format!("fixture '{name}' has a non-finite vertex"));
+    }
+    if !e.datum.pos.is_finite() || normalize_quat(e.datum.rot).is_none() {
+        return Err(format!("fixture '{name}': the datum must be a finite point and a rotation"));
+    }
+    Ok(())
+}
+
+fn num3(p: Point3) -> Value {
+    json!([p.x, p.y, p.z])
+}
+
+/// Library text for `entries`, sorted by name: an indented envelope a
+/// person can read, one facet per line so a large mesh stays a list of
+/// lines rather than one number per line. Lengths are millimetres.
+/// Refuses an entry the reader would refuse, so a written file always
+/// reads back.
+pub fn to_text(entries: &[FixtureEntry]) -> Result<String, String> {
+    let mut sorted: Vec<&FixtureEntry> = entries.iter().collect();
+    sorted.sort_by(|a, b| a.name.cmp(&b.name));
+    for w in sorted.windows(2) {
+        if let [a, b] = w
+            && a.name == b.name
+        {
+            return Err(format!("fixture '{}' appears twice in the library", a.name));
+        }
+    }
+    let s = |v: &Value| serde_json::to_string(v).map_err(|e| format!("fixture library not written: {e}"));
+    let mut out = String::new();
+    out.push_str(&format!(
+        "{{\n  \"format\": {},\n  \"version\": {VERSION},\n  \"units\": \"mm\",\n  \"fixtures\": [",
+        s(&json!(FORMAT))?
+    ));
+    for (i, e) in sorted.iter().enumerate() {
+        check_entry(e)?;
+        out.push_str(if i == 0 { "\n" } else { ",\n" });
+        out.push_str(&format!("    {{\n      \"name\": {},\n", s(&json!(e.name))?));
+        if let Some(note) = &e.note {
+            out.push_str(&format!("      \"note\": {},\n", s(&json!(note))?));
+        }
+        let datum = json!({ "origin": num3(e.datum.pos), "rot": e.datum.rot });
+        out.push_str(&format!("      \"datum\": {},\n      \"facets\": [\n", s(&datum)?));
+        for (k, t) in e.facets.iter().enumerate() {
+            let tri = json!([num3(t.a), num3(t.b), num3(t.c)]);
+            out.push_str(&format!("        {}{}\n", s(&tri)?, if k + 1 < e.facets.len() { "," } else { "" }));
+        }
+        out.push_str("      ]\n    }");
+    }
+    out.push_str(if sorted.is_empty() { "]\n}\n" } else { "\n  ]\n}\n" });
+    Ok(out)
+}
+
+fn point(v: Option<&Value>) -> Option<Point3> {
+    let a = v?.as_array()?;
+    match a.as_slice() {
+        [x, y, z] => Some(Point3::new(x.as_f64()?, y.as_f64()?, z.as_f64()?)),
+        _ => None,
+    }
+}
+
+fn read_entry(row: &Value, n: usize) -> Result<FixtureEntry, String> {
+    let name = row
+        .get("name")
+        .and_then(Value::as_str)
+        .filter(|s| !s.trim().is_empty())
+        .ok_or_else(|| format!("fixture #{n} has no name"))?
+        .to_owned();
+    let note = match row.get("note") {
+        None | Some(Value::Null) => None,
+        Some(v) => Some(v.as_str().ok_or_else(|| format!("fixture '{name}': the note is not text"))?.to_owned()),
+    };
+    let d = row.get("datum").ok_or_else(|| format!("fixture '{name}' has no datum"))?;
+    let pos = point(d.get("origin")).ok_or_else(|| format!("fixture '{name}': the datum origin is not [x, y, z]"))?;
+    let rot: Vec<f64> = d
+        .get("rot")
+        .and_then(Value::as_array)
+        .map(|a| a.iter().filter_map(Value::as_f64).collect())
+        .unwrap_or_default();
+    let rot: [f64; 4] = rot
+        .try_into()
+        .map_err(|_| format!("fixture '{name}': the datum rot is not [x, y, z, w]"))?;
+    // Kept as written (the insert normalizes at its chokepoint), so a
+    // read -> write round trip is byte-stable; only a non-rotation fails.
+    if normalize_quat(rot).is_none() {
+        return Err(format!("fixture '{name}': the datum rot is not a rotation"));
+    }
+    let rows = row
+        .get("facets")
+        .and_then(Value::as_array)
+        .ok_or_else(|| format!("fixture '{name}' has no \"facets\" array"))?;
+    let mut facets = Vec::with_capacity(rows.len().min(MAX_FACETS));
+    for (k, t) in rows.iter().enumerate() {
+        let tri = t.as_array().and_then(|v| match v.as_slice() {
+            [a, b, c] => Some(Triangle::new(point(Some(a))?, point(Some(b))?, point(Some(c))?)),
+            _ => None,
+        });
+        let tri = tri.ok_or_else(|| format!("fixture '{name}': facet #{} is not three [x, y, z] points", k + 1))?;
+        facets.push(tri);
+    }
+    let entry = FixtureEntry { name, note, datum: Location { pos, rot }, facets };
+    check_entry(&entry)?;
+    Ok(entry)
+}
+
+/// Read a library file's text. The whole file is checked before anything
+/// is returned: malformed JSON, a wrong format tag, version or units, an
+/// entry without a name, datum or facets, a name twice, an empty mesh or
+/// a non-finite number each refuse the whole file, naming the entry.
+/// An empty `fixtures` array is a valid (empty) library.
+pub fn parse(text: &str) -> Result<Vec<FixtureEntry>, String> {
+    let root: Value = serde_json::from_str(text).map_err(|e| format!("not a fixture library (bad JSON: {e})"))?;
+    let o = root.as_object().ok_or("not a fixture library: expected an object")?;
+    match o.get("format").and_then(Value::as_str) {
+        Some(FORMAT) => {}
+        Some(other) => return Err(format!("not a fixture library: format is '{other}', not '{FORMAT}'")),
+        None => return Err(format!("not a fixture library: no \"format\": \"{FORMAT}\"")),
+    }
+    match o.get("version").and_then(Value::as_u64) {
+        Some(VERSION) => {}
+        Some(v) => return Err(format!("fixture library version {v} is not supported (this build reads {VERSION})")),
+        None => return Err("not a fixture library: no \"version\"".into()),
+    }
+    if let Some(u) = o.get("units").and_then(Value::as_str)
+        && u != "mm"
+    {
+        return Err(format!("fixture library units '{u}' are not supported (lengths are mm)"));
+    }
+    let rows = o
+        .get("fixtures")
+        .and_then(Value::as_array)
+        .ok_or("not a fixture library: no \"fixtures\" array")?;
+    let mut out: Vec<FixtureEntry> = Vec::with_capacity(rows.len());
+    for (i, row) in rows.iter().enumerate() {
+        let entry = read_entry(row, i.saturating_add(1))?;
+        if out.iter().any(|e| e.name == entry.name) {
+            return Err(format!("fixture '{}' appears twice in the library", entry.name));
+        }
+        out.push(entry);
+    }
+    Ok(out)
+}
diff --git a/crates/app/src/fixture_library/store.rs b/crates/app/src/fixture_library/store.rs
new file mode 100644
index 00000000..66928179
--- /dev/null
+++ b/crates/app/src/fixture_library/store.rs
@@ -0,0 +1,152 @@
+//! Where the user's fixture library lives and how it is edited (#339
+//! slice 6): one `fixtures.camfixtures` in the user fixtures folder,
+//! resolved like the user machines folder (#383 / the #287 decision):
+//! `CAMCRAFT_FIXTURES`, else `<platform data dir>/camcraft/fixtures` -
+//! a sibling of `camcraft/machines`. Saving an entry and deleting one
+//! are file edits, not document commands: nothing here touches a world
+//! or the undo history, and every write is all or nothing.
+//!
+//! Provenance: our own resolver from the platforms' published per-user
+//! data locations (Windows `%APPDATA%`, macOS `~/Library/Application
+//! Support`, the XDG Base Directory spec's `$XDG_DATA_HOME` /
+//! `~/.local/share`); the atomic save is the write-temp-then-rename
+//! pattern from the `std::fs::rename` docs.
+
+use std::ffi::OsString;
+use std::fmt;
+use std::path::{Path, PathBuf};
+
+use super::{FixtureEntry, check_entry, parse, to_text};
+
+/// The override: an absolute folder holding the library file.
+pub const ENV_VAR: &str = "CAMCRAFT_FIXTURES";
+/// The library's file name inside the folder.
+pub const LIBRARY_FILE: &str = "fixtures.camfixtures";
+
+/// The user fixtures folder from an environment lookup, for the named
+/// platform (`std::env::consts::OS`). Pure, so the order is testable
+/// without touching the process environment. `None` = no home to put
+/// one in (the dialogs then say why they cannot save).
+#[must_use]
+pub fn user_dir_for(os: &str, get: impl Fn(&str) -> Option<OsString>) -> Option<PathBuf> {
+    let abs = |k: &str| get(k).map(PathBuf::from).filter(|p| p.is_absolute());
+    if let Some(dir) = abs(ENV_VAR) {
+        return Some(dir);
+    }
+    let data = match os {
+        "windows" => abs("APPDATA"),
+        "macos" => abs("HOME").map(|h| h.join("Library").join("Application Support")),
+        _ => abs("XDG_DATA_HOME").or_else(|| abs("HOME").map(|h| h.join(".local").join("share"))),
+    }?;
+    Some(data.join("camcraft").join("fixtures"))
+}
+
+/// The user fixtures folder for this process.
+#[must_use]
+pub fn user_dir() -> Option<PathBuf> {
+    user_dir_for(std::env::consts::OS, |k| std::env::var_os(k))
+}
+
+/// The library file in `dir`.
+#[must_use]
+pub fn library_path(dir: &Path) -> PathBuf {
+    dir.join(LIBRARY_FILE)
+}
+
+/// Why a library edit did not happen. Nothing was written in every case.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum LibraryError {
+    /// The file (or an entry to add) is refused, in words.
+    Refused(String),
+    /// These names are already in the library: ask before replacing.
+    Exists(Vec<String>),
+    /// No such entry to delete.
+    NotFound(String),
+    /// The disk refused (the OS error, in words).
+    Io(String),
+}
+
+impl fmt::Display for LibraryError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            LibraryError::Refused(why) => write!(f, "{why}"),
+            LibraryError::Exists(names) => write!(f, "already in the library: {}", names.join(", ")),
+            LibraryError::NotFound(n) => write!(f, "no fixture '{n}' in the library"),
+            LibraryError::Io(e) => write!(f, "{e}"),
+        }
+    }
+}
+
+/// The library at `path`. A missing file is the empty library (nothing
+/// saved yet); an unreadable or refused one is an error, never "empty".
+pub fn load(path: &Path) -> Result<Vec<FixtureEntry>, LibraryError> {
+    match std::fs::read_to_string(path) {
+        Ok(text) => parse(&text).map_err(LibraryError::Refused),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(Vec::new()),
+        Err(e) => Err(LibraryError::Io(format!("{}: {e}", path.display()))),
+    }
+}
+
+/// Write `entries` to `path` atomically: a temp file in the same folder,
+/// flushed, then renamed over the target. The folder is created when
+/// missing; on any failure the temp file is removed and the target is
+/// as it was.
+pub fn save(path: &Path, entries: &[FixtureEntry]) -> Result<(), LibraryError> {
+    use std::io::Write;
+    let text = to_text(entries).map_err(LibraryError::Refused)?;
+    let io = |e: std::io::Error| LibraryError::Io(format!("{}: {e}", path.display()));
+    let dir = path.parent().ok_or_else(|| LibraryError::Io(format!("{} has no folder", path.display())))?;
+    std::fs::create_dir_all(dir).map_err(io)?;
+    let name = path.file_name().map_or_else(|| "fixtures".into(), |n| n.to_string_lossy().into_owned());
+    let tmp = dir.join(format!(".{name}.{}.tmp", std::process::id()));
+    let wrote = (|| {
+        let mut f = std::fs::File::create(&tmp)?;
+        f.write_all(text.as_bytes())?;
+        f.sync_all()?;
+        drop(f);
+        std::fs::rename(&tmp, path)
+    })();
+    if let Err(e) = wrote {
+        let _ = std::fs::remove_file(&tmp);
+        return Err(io(e));
+    }
+    Ok(())
+}
+
+/// Add `new` to the library at `path`. A name already there is refused
+/// as `Exists` (every clashing name) unless `replace` - the dialog asks
+/// first; there is no silent "(2)" in a library, where the name is the
+/// only handle the user has. Two entries of `new` with one name are
+/// refused outright.
+pub fn add_entries(path: &Path, new: Vec<FixtureEntry>, replace: bool) -> Result<(), LibraryError> {
+    if new.is_empty() {
+        return Err(LibraryError::Refused("no fixture to save".into()));
+    }
+    for (i, e) in new.iter().enumerate() {
+        check_entry(e).map_err(LibraryError::Refused)?;
+        if new[..i].iter().any(|o| o.name == e.name) {
+            return Err(LibraryError::Refused(format!("fixture '{}' is saved twice", e.name)));
+        }
+    }
+    let mut lib = load(path)?;
+    let clash: Vec<String> =
+        new.iter().filter(|e| lib.iter().any(|o| o.name == e.name)).map(|e| e.name.clone()).collect();
+    if !clash.is_empty() && !replace {
+        return Err(LibraryError::Exists(clash));
+    }
+    lib.retain(|o| !new.iter().any(|e| e.name == o.name));
+    lib.extend(new);
+    save(path, &lib)
+}
+
+/// Remove entry `name` from the library at `path` (a confirmed file
+/// edit; there is no undo, as for a deleted machine file).
+pub fn delete_entry(path: &Path, name: &str) -> Result<(), LibraryError> {
+    let mut lib = load(path)?;
+    let before = lib.len();
+    lib.retain(|e| e.name != name);
+    if lib.len() == before {
+        return Err(LibraryError::NotFound(name.to_owned()));
+    }
+    save(path, &lib)
+}
diff --git a/crates/app/src/fixture_struck.rs b/crates/app/src/fixture_struck.rs
new file mode 100644
index 00000000..abea96b1
--- /dev/null
+++ b/crates/app/src/fixture_struck.rs
@@ -0,0 +1,152 @@
+//! Which fixture a warned move strikes (#339 slice 4): a `FixtureHit`
+//! names the op, the move and the band, never the steel - the laws judge
+//! every box at once. To tint the struck fixture, each fixture is judged
+//! ALONE with the very laws the post gate runs ([`op_hits`]), and the
+//! warned moves each one reproduces are its own. A warned move no single
+//! fixture reproduces (the steel moved since generation, or two boxes
+//! only convict together) is reported unresolved - never guessed.
+//!
+//! Display only: nothing here writes the world or feeds the post.
+//!
+//! Provenance: our own composition of the existing workholding laws
+//! (`camcraft_sim::verify`, the post gate's own call shape); no vendor
+//! material consulted.
+
+use flecs_ecs::prelude::World;
+
+use crate::cl::Toolpath as ClPath;
+use crate::fixture::{self, FixtureBox, MeshedFixture, MACHINE_TABLE};
+use crate::model;
+use crate::operation;
+use crate::schema::Operation;
+use crate::verify::Warning;
+
+/// The workholding laws (c2)/(d2), mesh-refined (#339), for one op's
+/// path against the given steel: exactly the post gate's per-op check.
+/// `Err` names a tool body that no longer fits its tool; a missing tool
+/// or no steel at all is no hit.
+pub fn op_hits(
+    world: &World,
+    op: &Operation,
+    path: &ClPath,
+    turning: &[FixtureBox],
+    fixed: &[FixtureBox],
+    meshes: &[MeshedFixture],
+) -> Result<Vec<Warning>, String> {
+    let Some((tool_entity, tool)) = model::find_by_name(world, &op.tool)
+        .and_then(|t| model::tool_of(world, &t).map(|d| (t, d)))
+    else {
+        return Ok(Vec::new());
+    };
+    // #368: the body's enclosing cylinder and band stack; a body that no
+    // longer fits its tool is itself the problem, by name.
+    let (tool, body) =
+        crate::tool_body::judged(world, &tool_entity, tool).map_err(|e| format!("tool {}: {e}", op.tool))?;
+    // `boxes_for` already folds in the machine-derived table, so empty
+    // lists mean no steel this op could strike at all.
+    if turning.is_empty() && fixed.is_empty() {
+        return Ok(Vec::new());
+    }
+    // #388: the op's own setup's machine, never the active one.
+    let spindle = crate::machine::of_setup(world, op.setup.as_deref())
+        .1
+        .and_then(|m| m.spindle_d.zip(m.spindle_len))
+        .map(|(d, l)| (d * 0.5, l));
+    let wh = crate::verify::Workholding { turning, fixed, axis: fixture::rotary_axis_of(world, op) };
+    let geom = tool.geom();
+    let holder = crate::tool_body::stack(&geom, body.as_ref());
+    // #339: each law's hits on a meshed fixture re-read against its
+    // closed mesh - the mesh only ever acquits.
+    let stack = crate::verify::steel_stack(&geom, &holder, spindle);
+    let steel = crate::verify::MeshSteel { fixtures: meshes, stack: &stack, chord_tol: operation::GOUGE_TOL };
+    let mut hits = crate::verify::mesh_refined(path, &wh, &steel, false, |w| {
+        crate::verify::bands_vs_workholding_held(path, &geom, &holder, w, spindle, operation::GOUGE_TOL)
+    });
+    // The spindle housing rides posed rapids too (M13.8 (1)).
+    hits.extend(crate::verify::mesh_refined(path, &wh, &steel, true, |w| {
+        crate::verify::rapids_vs_workholding_held(path, &geom, &holder, w, spindle)
+    }));
+    Ok(hits)
+}
+
+/// The moves an op's cached warnings say strike a fixture, ascending.
+#[must_use]
+pub fn warned_moves(warnings: &[Warning]) -> Vec<usize> {
+    let mut at: Vec<usize> = warnings
+        .iter()
+        .filter_map(|w| match w {
+            Warning::FixtureHit { at, .. } => Some(*at),
+            _ => None,
+        })
+        .collect();
+    at.sort_unstable();
+    at.dedup();
+    at
+}
+
+/// Who an op's fixture warnings point at.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Struck {
+    /// The fixtures (tagged model names, and [`MACHINE_TABLE`] for the
+    /// derived table) that reproduce at least one warned move alone,
+    /// name order, table last.
+    pub fixtures: Vec<String>,
+    /// Warned moves no single fixture reproduces today.
+    pub unresolved: Vec<usize>,
+    /// Every warned move, ascending.
+    pub warned: Vec<usize>,
+}
+
+impl Struck {
+    /// Whether `name` is one of the struck fixtures.
+    #[must_use]
+    pub fn names(&self, name: &str) -> bool {
+        self.fixtures.iter().any(|f| f == name)
+    }
+}
+
+/// Resolve the op `op_name`'s cached `FixtureHit` warnings to the
+/// fixtures that cause them. `None`: no such op, no cached path, or no
+/// fixture warning to resolve.
+#[must_use]
+pub fn struck_by(world: &World, op_name: &str) -> Option<Struck> {
+    let e = model::find_by_name(world, op_name)?;
+    let op = model::operation_of(world, &e)?;
+    let cache = model::toolpath_of(world, &e)?;
+    let warned = warned_moves(&cache.warnings);
+    if warned.is_empty() {
+        return None;
+    }
+    let ctx = op.setup.as_deref();
+    let mut fixtures = Vec::new();
+    let mut covered: Vec<usize> = Vec::new();
+    let mut judge = |name: String, turning: Vec<FixtureBox>, fixed: Vec<FixtureBox>, meshes: Vec<MeshedFixture>| {
+        // A tool body that no longer fits is the post gate's refusal, not
+        // a fixture's: nothing is resolved through it.
+        let Ok(hits) = op_hits(world, &op, &cache.path, &turning, &fixed, &meshes) else {
+            return;
+        };
+        let mine: Vec<usize> = warned_moves(&hits).into_iter().filter(|a| warned.binary_search(a).is_ok()).collect();
+        if !mine.is_empty() {
+            fixtures.push(name);
+            covered.extend(mine);
+        }
+    };
+    for (name, entity) in fixture::tagged(world, ctx) {
+        let Some(b) = model::entity_world_aabb(world, &entity) else { continue };
+        let b = FixtureBox { min: b.min, max: b.max };
+        let meshes = model::world_facets(world, &entity)
+            .map(|tris| vec![MeshedFixture::new(name.clone(), b, tris.into())])
+            .unwrap_or_default();
+        if fixture::def_of(world, &entity).is_some_and(|d| d.fixed) {
+            judge(name, Vec::new(), vec![b], meshes);
+        } else {
+            judge(name, vec![b], Vec::new(), meshes);
+        }
+    }
+    if let Some(t) = fixture::table_box(world, ctx) {
+        judge(MACHINE_TABLE.to_string(), Vec::new(), vec![t], Vec::new());
+    }
+    let unresolved = warned.iter().copied().filter(|a| !covered.contains(a)).collect();
+    Some(Struck { fixtures, unresolved, warned })
+}
diff --git a/crates/app/src/fixture_view.rs b/crates/app/src/fixture_view.rs
new file mode 100644
index 00000000..98d945b6
--- /dev/null
+++ b/crates/app/src/fixture_view.rs
@@ -0,0 +1,198 @@
+//! What the fixture rows say about each fixture's collision truth (#339
+//! slice 4): judged by its closed mesh, or by its bounding box and why.
+//! The answer is the mesh law's own ([`FixtureMesh::build`], the very
+//! validation `camcraft_sim::verify::mesh_steel` runs), so the row can
+//! never claim a mesh the gate would refuse. Building it indexes the
+//! mesh, so the browser reads it through [`VersionCache`] - once per
+//! document version, never per frame.
+//!
+//! Provenance: our own view over #339 slice 1's mesh law; no vendor
+//! material consulted.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+pub use camcraft_sim::fixture_mesh::MeshError;
+use camcraft_sim::fixture_mesh::FixtureMesh;
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::World;
+
+use crate::fixture::{self, FixtureBox};
+use crate::{model, setup};
+
+/// Why a fixture is judged by its box.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BoxReason {
+    /// The mesh law refused the facets, by name.
+    Refused(MeshError),
+    /// Another fixture of the same setup has the identical world box:
+    /// a box hit cannot be pinned on either mesh, so both keep the box.
+    SharedBox,
+}
+
+/// A fixture's collision truth.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MeshState {
+    /// A closed mesh: the gate judges moves against the real steel.
+    Mesh,
+    /// The bounding box stands (conservative: a path through its gap
+    /// still reports).
+    BoxOnly(BoxReason),
+}
+
+impl BoxReason {
+    /// The few words a browser row has room for.
+    #[must_use]
+    pub const fn short(self) -> &'static str {
+        match self {
+            Self::Refused(MeshError::Empty) => "no facets",
+            Self::Refused(MeshError::NonFinite) => "non-finite",
+            Self::Refused(MeshError::Degenerate) => "collapsed",
+            Self::Refused(MeshError::TooLarge) => "over the facet cap",
+            Self::Refused(MeshError::Open) => "open mesh",
+            Self::SharedBox => "shared box",
+        }
+    }
+}
+
+impl MeshState {
+    /// The row suffix: `mesh`, or `box only: <reason>`.
+    #[must_use]
+    pub fn label(self) -> String {
+        match self {
+            Self::Mesh => "mesh".to_owned(),
+            Self::BoxOnly(why) => format!("box only: {}", why.short()),
+        }
+    }
+
+    /// The Fixtures page's sentence.
+    #[must_use]
+    pub fn detail(self) -> String {
+        match self {
+            Self::Mesh => "judged by its closed mesh - a path through its gaps is clear".to_owned(),
+            Self::BoxOnly(BoxReason::Refused(e)) => format!("judged by its bounding box: {e}"),
+            Self::BoxOnly(BoxReason::SharedBox) => {
+                "judged by its bounding box: another fixture of this setup has the identical box".to_owned()
+            }
+        }
+    }
+}
+
+/// The mesh state of one world mesh standing beside `others` (the
+/// world boxes of the rest of its setup's fixtures). The mesh's own
+/// refusal outranks a shared box: it is the one the user can fix.
+#[must_use]
+pub fn judge(tris: &[crate::geometry::Triangle], aabb: Option<FixtureBox>, others: &[FixtureBox]) -> MeshState {
+    if let Err(e) = FixtureMesh::build(tris) {
+        return MeshState::BoxOnly(BoxReason::Refused(e));
+    }
+    if aabb.is_some_and(|b| others.contains(&b)) {
+        return MeshState::BoxOnly(BoxReason::SharedBox);
+    }
+    MeshState::Mesh
+}
+
+/// Every fixture of setup context `declared`, name order, with its
+/// mesh state. A tagged model with no facets has no box and no mesh.
+#[must_use]
+pub fn mesh_states(world: &World, declared: Option<&str>) -> Vec<(String, MeshState)> {
+    let rows: Vec<(String, Vec<crate::geometry::Triangle>, Option<FixtureBox>)> = fixture::tagged(world, declared)
+        .into_iter()
+        .map(|(name, e)| {
+            let tris = model::world_facets(world, &e).unwrap_or_default();
+            let aabb = model::entity_world_aabb(world, &e).map(|b| FixtureBox { min: b.min, max: b.max });
+            (name, tris, aabb)
+        })
+        .collect();
+    rows.iter()
+        .enumerate()
+        .map(|(i, (name, tris, aabb))| {
+            let others: Vec<FixtureBox> =
+                rows.iter().enumerate().filter(|(j, _)| *j != i).filter_map(|(_, r)| r.2).collect();
+            (name.clone(), judge(tris, *aabb, &others))
+        })
+        .collect()
+}
+
+/// [`mesh_states`] over every setup context (the implicit one when the
+/// document has none), keyed by fixture name - a fixture belongs to
+/// exactly one context, so its name is the key.
+#[must_use]
+pub fn all_mesh_states(world: &World) -> HashMap<String, MeshState> {
+    let names = setup::names(world);
+    let ctxs: Vec<Option<&str>> =
+        if names.is_empty() { vec![None] } else { names.iter().map(|n| Some(n.as_str())).collect() };
+    let mut out = HashMap::new();
+    for ctx in ctxs {
+        out.extend(mesh_states(world, ctx));
+    }
+    out
+}
+
+/// One cached answer per key (a document version, an op): the view
+/// layer reads it every frame from `&self`, the work runs when the key
+/// moves. Interior mutability is a `Mutex` (a poisoned lock is taken
+/// back - the slot is a cache, never truth).
+pub struct VersionCache<K, T> {
+    slot: Mutex<Option<(K, Arc<T>)>>,
+}
+
+impl<K, T> Default for VersionCache<K, T> {
+    fn default() -> Self {
+        Self { slot: Mutex::new(None) }
+    }
+}
+
+impl<K: PartialEq, T> VersionCache<K, T> {
+    /// The cached answer for `key`, or `make()`'s, kept for next time.
+    pub fn get_or(&self, key: K, make: impl FnOnce() -> T) -> Arc<T> {
+        let mut slot = match self.slot.lock() {
+            Ok(g) => g,
+            Err(poisoned) => poisoned.into_inner(),
+        };
+        if let Some((k, v)) = slot.as_ref()
+            && *k == key
+        {
+            return Arc::clone(v);
+        }
+        let v = Arc::new(make());
+        *slot = Some((key, Arc::clone(&v)));
+        v
+    }
+}
+
+impl<K, T> std::fmt::Debug for VersionCache<K, T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("VersionCache")
+    }
+}
+
+/// The browser's cache of [`all_mesh_states`], per document version.
+pub type MeshStateCache = VersionCache<u64, HashMap<String, MeshState>>;
+
+/// [`all_mesh_states`] through `cache`, recomputed when `version` moves.
+pub fn mesh_states_cached(cache: &MeshStateCache, world: &World, version: u64) -> Arc<HashMap<String, MeshState>> {
+    cache.get_or(version, || all_mesh_states(world))
+}
+
+/// The op key a struck-fixture view is cached under: document version,
+/// op name, and the cached path's signature (a regeneration landing
+/// without a version bump still re-resolves).
+pub type StruckKey = (u64, String, u64);
+
+/// The viewport's cache of [`crate::fixture_struck::struck_by`].
+pub type StruckCache = VersionCache<StruckKey, Option<crate::fixture_struck::Struck>>;
+
+/// [`crate::fixture_struck::struck_by`] for `op_name` through `cache`.
+pub fn struck_cached(
+    cache: &StruckCache,
+    world: &World,
+    version: u64,
+    op_name: &str,
+) -> Arc<Option<crate::fixture_struck::Struck>> {
+    // The signature alone: a per-frame read must not clone the path.
+    let sig = model::find_by_name(world, op_name)
+        .and_then(|e| e.entity_view(world).try_get::<&crate::schema::Toolpath>(|tp| tp.path_sig()))
+        .unwrap_or(0);
+    cache.get_or((version, op_name.to_owned(), sig), || crate::fixture_struck::struck_by(world, op_name))
+}
