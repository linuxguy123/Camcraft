+        let s = seed(&world, &sel);
+        assert_eq!(s.mode, ProbeMode::Boss, "{sel:?}: the wall faces away from its axis");
+        assert!(near(s.target, [100.0, 0.0, 12.0], 1e-6), "{s:?}");
+        assert!((s.radius.expect("a radius") - 8.0).abs() < 0.01, "{s:?}");
