diff --git a/crates/ui/src/egui_app/theme_drop.rs b/crates/ui/src/egui_app/theme_drop.rs
new file mode 100644
index 00000000..b742a858
--- /dev/null
+++ b/crates/ui/src/egui_app/theme_drop.rs
@@ -0,0 +1,148 @@
+//! The ribbon's Theme door (#441): the document's look moved off the
+//! Stock page onto its own ribbon cell, right of the View door. Its list
+//! offers the switcher rows `State::theme_options` builds (the two
+//! built-ins, the discovered `assets/themes/*.json` files by name, and
+//! Browse for any other file), then the colour-vision modes. A pick
+//! queues `SelectTheme` / `SelectThemeDialog` / `SelectColorVision` -
+//! the same commands the old page combo queued - so Ctrl+Z puts the
+//! previous look back; opening and closing the list is view state.
+//! Provenance: our own code, the hand-drawn dropdown law of the View
+//! and machine doors (panes.rs, layout/mod.rs); no HSMWorks material.
+
+use camcraft_app::commands::{color_vision_of, theme_of};
+use camcraft_app::schema::{ColorVision, ThemeRef};
+use egui::{Rect, Sense, Ui, Vec2};
+
+use super::panes::{DROP_GAP, DROP_W};
+use super::theme::Tokens;
+use crate::state::{CommandKind, State};
+
+/// One row of the Theme door's list.
+#[derive(Clone, Debug, PartialEq)]
+pub(super) enum ThemeRow {
+    /// A theme switcher row: its label and the reference it selects
+    /// (`None`: the Browse row, which opens the file pick).
+    Theme(String, Option<ThemeRef>),
+    /// The inert caption over the colour-vision rows.
+    VisionCaption,
+    /// One colour-vision mode.
+    Vision(ColorVision),
+}
+
+/// The command a theme row queues.
+fn command_of(pick: Option<&ThemeRef>) -> CommandKind {
+    match pick {
+        Some(r) => CommandKind::SelectTheme(r.clone()),
+        None => CommandKind::SelectThemeDialog,
+    }
+}
+
+/// The door's rows, pure geometry in the strip's global frame (the View
+/// door's law): hung under the button, pulled left so the list never
+/// runs off the strip's right edge. The tests click through these rects.
+pub(super) fn rows_of(state: &State, button: Rect, strip: Rect, pal: &Tokens) -> Vec<(ThemeRow, Rect)> {
+    let mut rows: Vec<ThemeRow> = state
+        .theme_options()
+        .into_iter()
+        .filter_map(|(label, cmd)| match cmd {
+            CommandKind::SelectTheme(r) => Some(ThemeRow::Theme(label, Some(r))),
+            CommandKind::SelectThemeDialog => Some(ThemeRow::Theme(label, None)),
+            _ => None,
+        })
+        .collect();
+    rows.push(ThemeRow::VisionCaption);
+    rows.extend(ColorVision::ALL.into_iter().map(ThemeRow::Vision));
+    let left = button.left().min(strip.right() - DROP_W).max(strip.left());
+    rows.into_iter()
+        .enumerate()
+        .map(|(k, r)| {
+            let min = egui::Pos2::new(left, button.bottom() + DROP_GAP + k as f32 * pal.row_height);
+            (r, Rect::from_min_size(min, Vec2::new(DROP_W, pal.row_height)))
+        })
+        .collect()
+}
+
+/// The open Theme door's dropdown: a foreground Area of rows, the
+/// current theme and mode marked. A press on a live row queues its
+/// command and closes the door; an outside press closes it.
+pub(super) fn show(
+    ui: &mut Ui,
+    state: &mut State,
+    pal: &Tokens,
+    id: egui::Id,
+    button: Rect,
+    rows: &[(ThemeRow, Rect)],
+) {
+    let Some(top) = rows.first().map(|(_, r)| r.min) else {
+        state.ribbon_theme_open = false;
+        return;
+    };
+    let panel = Rect::from_min_size(top, Vec2::new(DROP_W, rows.len() as f32 * pal.row_height));
+    let theme = theme_of(&state.world);
+    let vision = color_vision_of(&state.world);
+    let mut chose: Option<Option<CommandKind>> = None;
+    egui::Area::new(id)
+        .fixed_pos(panel.min)
+        .order(egui::Order::Foreground)
+        .movable(false)
+        .show(ui.ctx(), |ui| {
+            let p = ui.painter();
+            p.rect_filled(panel, pal.radius_menu, pal.ink);
+            p.rect_stroke(
+                panel,
+                pal.radius_menu,
+                egui::Stroke::new(1.0, pal.border),
+                egui::StrokeKind::Outside,
+            );
+            for (k, (row, r)) in rows.iter().enumerate() {
+                let resp = ui.interact(*r, id.with(("theme-row", k)), Sense::click());
+                let (label, current, live) = match row {
+                    ThemeRow::Theme(label, pick) => (label.clone(), pick.as_ref() == Some(&theme), true),
+                    ThemeRow::VisionCaption => ("Colour vision".to_owned(), false, false),
+                    ThemeRow::Vision(mode) => (format!("  {}", mode.label()), *mode == vision, true),
+                };
+                if resp.hovered() && live {
+                    p.rect_filled(*r, 0.0, pal.field_hover);
+                }
+                if matches!(row, ThemeRow::VisionCaption) {
+                    p.hline(r.x_range(), r.top(), egui::Stroke::new(1.0, pal.border));
+                }
+                let text = if current { format!("{label}  (current)") } else { label };
+                p.text(
+                    r.left_center() + Vec2::new(8.0, 0.0),
+                    egui::Align2::LEFT_CENTER,
+                    text,
+                    egui::FontId::proportional(pal.font_row),
+                    if live && !current { pal.text } else { pal.text_faint },
+                );
+                if resp.clicked() && live {
+                    // The current row is a choice too: it closes the
+                    // list and queues nothing.
+                    chose = Some(match row {
+                        ThemeRow::Theme(_, pick) if !current => Some(command_of(pick.as_ref())),
+                        ThemeRow::Vision(mode) if !current => Some(CommandKind::SelectColorVision(*mode)),
+                        _ => None,
+                    });
+                }
+            }
+        });
+    match chose {
+        Some(cmd) => {
+            if let Some(cmd) = cmd {
+                state.pending.push_back(cmd);
+            }
+            state.ribbon_theme_open = false;
+        }
+        None => {
+            let outside = ui.input(|i| {
+                i.pointer.button_pressed(egui::PointerButton::Primary)
+                    && i.pointer.interact_pos().is_none_or(|p| {
+                        !button.expand(DROP_GAP).contains(p) && !rows.iter().any(|(_, r)| r.contains(p))
+                    })
+            });
+            if outside {
+                state.ribbon_theme_open = false;
+            }
+        }
+    }
+}
diff --git a/crates/ui/src/egui_app/thread_hand_tests.rs b/crates/ui/src/egui_app/thread_hand_tests.rs
new file mode 100644
index 00000000..e4e186e7
--- /dev/null
+++ b/crates/ui/src/egui_app/thread_hand_tests.rs
@@ -0,0 +1,87 @@
+//! The threading page's Hand row (#629): Right hand / Left hand by name
+//! on the Passes tab, the pick editing the page draft and Apply riding
+//! `EditOperationParams` - undo restores the hand.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui_kittest::kittest::Queryable;
+
+use camcraft_app::cl::ThreadHand;
+use camcraft_app::commands::{AddTool, CreateOperation};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+
+use super::dialog_tests::page;
+use crate::state::{CommandKind, State, UiTarget};
+
+fn threading() -> OpParams {
+    OpParams::Threading {
+        tolerance: 0.05,
+        clearance_z: Height::fixed(24.0),
+        top_z: Height::fixed(14.3),
+        bottom_z: Height::fixed(7.7),
+        pitch: 2.0,
+        depth: 1.2,
+        infeed: 0.4,
+        feed: 120.0,
+        plunge_feed: 40.0,
+        hand: ThreadHand::Right,
+    }
+}
+
+/// A mounted lathe, bar stock, the threading insert and one threading
+/// op named "Op", opened on the page's Passes tab.
+fn opened() -> State {
+    let mut state = State::new();
+    state.pending.push_back(CommandKind::LoadBuiltinMachine("Lathe".to_string()));
+    state.pending.push_back(CommandKind::SetStock {
+        shape: StockShape::Cylinder { diameter: 12.0, height: 56.0 },
+        pos: [0.0, 0.0, -16.0],
+        yaw_deg: 0.0,
+    });
+    state.drain_actions();
+    let td = catalog().into_iter().find(|(n, _)| *n == "TD-1732-60").map(|(_, t)| t).expect("catalog insert");
+    state.history.execute(&state.world, AddTool::new(&state.world, "TD-1732-60", td).expect("tool"));
+    state.history.execute(
+        &state.world,
+        CreateOperation::new(&state.world, "Op", "TD-1732-60", SrcRef::Stock, threading()).expect("operation"),
+    );
+    state.pending.push_back(CommandKind::Select(Some("Op".into())));
+    state.drain_actions();
+    state.ui_target = UiTarget::Operation("Op".into());
+    state.sync_ops_ui();
+    state.op_tab = super::op_tabs::SEC_PASSES;
+    state
+}
+
+fn hand(state: &State) -> ThreadHand {
+    match model::find_by_name(&state.world, "Op").and_then(|e| model::operation_of(&state.world, &e)).map(|o| o.params) {
+        Some(OpParams::Threading { hand, .. }) => hand,
+        other => panic!("a threading op expected, got {other:?}"),
+    }
+}
+
+#[test]
+fn the_hand_row_names_both_hands_and_its_pick_applies_and_undoes() {
+    let mut harness = page(opened());
+    harness.run();
+    assert!(harness.query_by_label("Hand").is_some(), "the Passes tab carries the Hand row");
+    assert!(harness.query_by_label("Right hand").is_some() && harness.query_by_label("Left hand").is_some());
+    assert_eq!(hand(harness.state()), ThreadHand::Right, "right-hand unless the drawing says LH");
+    harness.get_by_label("Left hand").click();
+    harness.run();
+    assert_eq!(hand(harness.state()), ThreadHand::Right, "the world waits for Apply");
+    harness.get_by_label("Apply").click();
+    harness.run();
+    harness.state_mut().drain_actions();
+    assert_eq!(hand(harness.state()), ThreadHand::Left, "Apply committed the hand");
+    let st = harness.state_mut();
+    st.pending.push_back(CommandKind::Undo);
+    st.drain_actions();
+    assert_eq!(hand(harness.state()), ThreadHand::Right, "Ctrl+Z restores it");
+    let st = harness.state_mut();
+    st.pending.push_back(CommandKind::Redo);
+    st.drain_actions();
+    assert_eq!(hand(harness.state()), ThreadHand::Left, "Ctrl+Y reapplies it");
+}
diff --git a/crates/ui/src/egui_app/tool_body_page.rs b/crates/ui/src/egui_app/tool_body_page.rs
new file mode 100644
index 00000000..4f70eb64
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_body_page.rs
@@ -0,0 +1,312 @@
+//! The tool editor's Body section (#371): Import body… / Clear body, the
+//! placement (axis preset or picked face normal, tip offset), Pick tip /
+//! Pick axis on a small orbitable 3D preview of the mesh in its own
+//! frame, and Apply body - which queues the one `SetToolBody`. The
+//! preview is painted with egui (flat-shaded, depth-sorted triangles),
+//! so it needs no GPU and runs under the test harness. Picks and orbit
+//! are ephemeral; only Apply body / Clear body reach the history.
+//! Provenance: our own pane over `app::tool_body_view` (orthographic
+//! projection and ray casting from general graphics practice); no vendor
+//! material consulted.
+
+use egui::{Color32, ComboBox, Mesh, Pos2, Rect, Sense, Shape, Stroke, Ui, Vec2};
+
+use camcraft_app::geometry::Triangle;
+use camcraft_app::tool_body_view::{self, AXIS_CHOICES};
+use camcraft_app::units::{self, Unit};
+
+use super::fields::{field, num};
+use crate::state::{BodyPickMode, State};
+
+/// The preview's side, logical px.
+const SIDE: Vec2 = Vec2::new(260.0, 200.0);
+/// Past this many facets the preview paints every n-th one (picking
+/// still reads them all) - a vendor STEP can carry 10^5+.
+const MAX_PAINTED: usize = 30_000;
+/// The default view: a three-quarter look from +X-Y, above.
+const YAW0: f32 = -0.9;
+const PITCH0: f32 = 0.45;
+
+/// The envelope bands of the draft's placed body, for the profile
+/// preview: `(above, len, r)` per band, or `None` with no usable draft.
+/// Re-mirrors the world's body first (a no-op unless it changed), so
+/// the preview follows Apply profile, undo and reload whichever tab
+/// shows - not only once the Body tab has been drawn.
+pub(super) fn envelope(state: &mut State) -> Option<Vec<(f64, f64, f64)>> {
+    state.sync_tool_body_ui();
+    match state.tool_body_preview()? {
+        Ok(b) => Some(b.profile()?.bands().iter().map(|q| (q.above, q.len, q.r)).collect()),
+        Err(_) => None,
+    }
+}
+
+/// The section, the editor's third column beside the profile preview. A new (unsaved) tool
+/// takes no body until it exists - the command names an existing tool.
+pub(super) fn body_section(ui: &mut Ui, state: &mut State, exists: bool, u: Unit) {
+    ui.strong("Tool body");
+    if !exists {
+        ui.label("Add the tool first, then import its holder or assembly.");
+        return;
+    }
+    state.sync_tool_body_ui();
+    let landed = state.editor_tool_body().map(|b| b.source);
+    let draft_src = state.tool_body_ui.source.clone();
+    let has_draft = !state.tool_body_ui.facets.is_empty();
+    ui.label(match (&landed, has_draft) {
+        (Some(src), _) if *src == draft_src => format!("body: {src}"),
+        (_, true) => format!("draft: {draft_src} (not applied)"),
+        _ => "none - the holder cylinder is judged".to_owned(),
+    });
+    let (import, clear) = ui
+        .horizontal(|ui| {
+            let import = ui
+                .button("Import body…")
+                .on_hover_text("read a STEP, STL or OBJ holder/assembly; place it, then Apply body")
+                .clicked();
+            let clear = ui
+                .add_enabled(landed.is_some() || has_draft, egui::Button::new("Clear body"))
+                .on_hover_text("remove the body - the holder cylinder is judged again (undoable)")
+                .clicked();
+            (import, clear)
+        })
+        .inner;
+    if import {
+        state.import_tool_body_dialog();
+    }
+    if clear {
+        state.clear_tool_body();
+    }
+    if state.tool_body_ui.facets.is_empty() {
+        return;
+    }
+    field(ui, "Tool axis (model direction, tip to spindle)");
+    axis_combo(ui, &mut state.tool_body_ui.axis);
+    field(ui, "Tip offset (model origin above the tip)");
+    num(ui, u, &mut state.tool_body_ui.offset);
+    let pick = state.tool_body_ui.pick;
+    ui.horizontal(|ui| {
+        if ui
+            .selectable_label(pick == BodyPickMode::Tip, "Pick tip")
+            .on_hover_text("click the body in the preview: the nearest corner becomes the tool tip")
+            .clicked()
+        {
+            state.tool_body_ui.pick = if pick == BodyPickMode::Tip { BodyPickMode::Off } else { BodyPickMode::Tip };
+        }
+        if ui
+            .selectable_label(pick == BodyPickMode::Axis, "Pick axis")
+            .on_hover_text("click a face that looks toward the spindle: its normal becomes the tool axis")
+            .clicked()
+        {
+            state.tool_body_ui.pick = if pick == BodyPickMode::Axis { BodyPickMode::Off } else { BodyPickMode::Axis };
+        }
+        if ui.button("Fit").on_hover_text("reset the preview's orbit and zoom (or double-click it)").clicked() {
+            state.fit_body_preview();
+        }
+    });
+    preview_3d(ui, state);
+    let note = match state.tool_body_preview() {
+        Some(Ok(b)) => match b.profile() {
+            Some(p) => format!(
+                "placed: foot {} to top {} {} above the tip",
+                units::len(p.bottom(), u, 1),
+                units::len(p.top(), u, 1),
+                u.suffix()
+            ),
+            None => String::new(),
+        },
+        Some(Err(e)) => format!("placement: {e}"),
+        None => String::new(),
+    };
+    ui.label(note);
+    if ui.button("Apply body").on_hover_text("attach the body with this placement (one undo step)").clicked() {
+        state.queue_apply_tool_body();
+    }
+}
+
+fn axis_combo(ui: &mut Ui, axis: &mut [f64; 3]) {
+    let text = tool_body_view::axis_label(*axis)
+        .map_or_else(|| format!("picked ({:.2}, {:.2}, {:.2})", axis[0], axis[1], axis[2]), str::to_owned);
+    ComboBox::from_id_salt("tool_body_axis").selected_text(text).show_ui(ui, |ui| {
+        for (name, d) in AXIS_CHOICES {
+            if ui.selectable_label(tool_body_view::axis_label(*axis) == Some(name), name).clicked() {
+                *axis = d;
+            }
+        }
+    });
+}
+
+/// The orthographic view: a center, a scale, and the right/up/forward
+/// basis (forward points into the screen).
+struct View {
+    c: [f64; 3],
+    s: f64,
+    r: [f64; 3],
+    up: [f64; 3],
+    f: [f64; 3],
+    mid: Pos2,
+    reach: f64,
+}
+
+impl View {
+    fn new(tris: &[Triangle], rect: Rect, d: &crate::state::ToolBodyUi) -> Option<Self> {
+        let (yaw, pitch) = (d.yaw, d.pitch);
+        let mut lo = [f64::INFINITY; 3];
+        let mut hi = [f64::NEG_INFINITY; 3];
+        for t in tris {
+            for p in [t.a, t.b, t.c] {
+                for (i, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+                    if v.is_finite() {
+                        lo[i] = lo[i].min(v);
+                        hi[i] = hi[i].max(v);
+                    }
+                }
+            }
+        }
+        // The model origin is always in view: the axis and tip live there.
+        for i in 0..3 {
+            lo[i] = lo[i].min(0.0);
+            hi[i] = hi[i].max(0.0);
+        }
+        let c = [(lo[0] + hi[0]) * 0.5, (lo[1] + hi[1]) * 0.5, (lo[2] + hi[2]) * 0.5];
+        let reach = ((hi[0] - lo[0]).powi(2) + (hi[1] - lo[1]).powi(2) + (hi[2] - lo[2]).powi(2)).sqrt() * 0.5;
+        if !(reach.is_finite() && reach > 1e-9) {
+            return None;
+        }
+        let (y, p) = (f64::from(YAW0 + yaw), f64::from((PITCH0 + pitch).clamp(-1.5, 1.5)));
+        let f = [-(p.cos() * y.cos()), -(p.cos() * y.sin()), -p.sin()];
+        let r = norm([f[1], -f[0], 0.0]).unwrap_or([1.0, 0.0, 0.0]);
+        let up = cross(r, f);
+        let zoom = f64::from(crate::state::clamp_zoom(d.zoom, 0.0)).exp2();
+        let s = f64::from(rect.width().min(rect.height())) * 0.45 / reach * zoom;
+        let pan = if d.pan.iter().all(|v| v.is_finite()) { d.pan } else { [0.0; 2] };
+        let c = [0, 1, 2].map(|i| c[i] + r[i] * pan[0] + up[i] * pan[1]);
+        Some(Self { c, s, r, up, f, mid: rect.center(), reach })
+    }
+
+    fn screen(&self, q: [f64; 3]) -> Pos2 {
+        let d = [q[0] - self.c[0], q[1] - self.c[1], q[2] - self.c[2]];
+        Pos2::new(
+            self.mid.x + (dot(d, self.r) * self.s) as f32,
+            self.mid.y - (dot(d, self.up) * self.s) as f32,
+        )
+    }
+
+    fn depth(&self, q: [f64; 3]) -> f64 {
+        dot([q[0] - self.c[0], q[1] - self.c[1], q[2] - self.c[2]], self.f)
+    }
+
+    /// Screen point `at` as view units (right, up) off the view centre.
+    fn offset(&self, at: Pos2) -> [f64; 2] {
+        [f64::from(at.x - self.mid.x) / self.s, -f64::from(at.y - self.mid.y) / self.s]
+    }
+
+    /// The ray under screen point `at`: from in front of the body, into it.
+    fn ray(&self, at: Pos2) -> ([f64; 3], [f64; 3]) {
+        let (dx, dy) = (f64::from(at.x - self.mid.x) / self.s, -f64::from(at.y - self.mid.y) / self.s);
+        let back = 4.0 * self.reach;
+        let o = [0, 1, 2].map(|i| self.c[i] + self.r[i] * dx + self.up[i] * dy - self.f[i] * back);
+        (o, self.f)
+    }
+}
+
+fn preview_3d(ui: &mut Ui, state: &mut State) {
+    let (resp, painter) = ui.allocate_painter(SIDE, Sense::click_and_drag());
+    let rect = resp.rect;
+    painter.rect_filled(rect, 4.0, Color32::from_rgb(24, 26, 31));
+    let d = &state.tool_body_ui;
+    let Some(view) = View::new(&d.facets, rect, d) else {
+        return;
+    };
+    // Painter's algorithm: far facets first, shaded by how squarely
+    // they face the eye.
+    let stride = d.facets.len().div_ceil(MAX_PAINTED).max(1);
+    let mut order: Vec<(f64, &Triangle)> = d
+        .facets
+        .iter()
+        .step_by(stride)
+        .map(|t| (view.depth(centroid(t)), t))
+        .filter(|(z, _)| z.is_finite())
+        .collect();
+    order.sort_by(|a, b| b.0.total_cmp(&a.0));
+    let mut mesh = Mesh::default();
+    for (_, t) in order {
+        let [a, b, c] = [t.a, t.b, t.c].map(|p| [p.x, p.y, p.z]);
+        let lit = norm(cross(sub(b, a), sub(c, a))).map_or(0.3, |n| dot(n, view.f).abs());
+        let g = (60.0 + 150.0 * lit).clamp(0.0, 255.0) as u8;
+        let col = Color32::from_rgb(g, g, g.saturating_add(12));
+        let base = mesh.vertices.len() as u32;
+        for q in [a, b, c] {
+            mesh.colored_vertex(view.screen(q), col);
+        }
+        mesh.add_triangle(base, base + 1, base + 2);
+    }
+    painter.add(Shape::mesh(mesh));
+    // The placement over it: the axis from the tip up, the tip, and the
+    // model origin.
+    if let Some(a) = norm(d.axis) {
+        let tip = [-d.offset * a[0], -d.offset * a[1], -d.offset * a[2]];
+        let top = [0, 1, 2].map(|i| tip[i] + a[i] * view.reach * 2.0);
+        painter.line_segment([view.screen(tip), view.screen(top)], Stroke::new(1.5, Color32::from_rgb(90, 200, 230)));
+        painter.circle_filled(view.screen(tip), 4.0, Color32::from_rgb(240, 150, 40));
+    }
+    painter.circle_stroke(view.screen([0.0; 3]), 3.0, Stroke::new(1.0, Color32::from_rgb(160, 160, 170)));
+    let mode = d.pick;
+    if mode != BodyPickMode::Off {
+        painter.text(
+            rect.min + Vec2::new(6.0, 6.0),
+            egui::Align2::LEFT_TOP,
+            if mode == BodyPickMode::Tip { "click the tip" } else { "click a spindle-facing face" },
+            egui::FontId::proportional(10.0),
+            Color32::from_rgb(240, 200, 120),
+        );
+    }
+    // Zoom: the wheel or a pinch (Ctrl+wheel too) while hovered, about
+    // the cursor; a double-click fits. View state only.
+    if resp.hovered() {
+        let (scroll, pinch) = ui.input(|i| (i.smooth_scroll_delta.y, i.zoom_delta()));
+        let by = scroll * 0.004 + pinch.max(1e-3).log2();
+        if by.abs() > 1e-6 {
+            let about = resp.hover_pos().map_or([0.0; 2], |p| view.offset(p));
+            state.zoom_body_preview(by, about);
+        }
+    }
+    if resp.double_clicked() {
+        state.fit_body_preview();
+    }
+    if resp.dragged() && mode == BodyPickMode::Off {
+        let dv = resp.drag_delta();
+        state.tool_body_ui.yaw -= dv.x * 0.01;
+        state.tool_body_ui.pitch = (state.tool_body_ui.pitch + dv.y * 0.01).clamp(-1.9, 1.0);
+    }
+    if resp.clicked()
+        && mode != BodyPickMode::Off
+        && let Some(at) = resp.interact_pointer_pos()
+    {
+        let (o, dir) = view.ray(at);
+        match tool_body_view::pick(&state.tool_body_ui.facets, o, dir) {
+            Some(hit) => state.apply_body_pick(hit),
+            None => state.status = "pick: no facet under the cursor".into(),
+        }
+    }
+}
+
+fn centroid(t: &Triangle) -> [f64; 3] {
+    [(t.a.x + t.b.x + t.c.x) / 3.0, (t.a.y + t.b.y + t.c.y) / 3.0, (t.a.z + t.b.z + t.c.z) / 3.0]
+}
+
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn sub(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+fn cross(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn norm(a: [f64; 3]) -> Option<[f64; 3]> {
+    let n = dot(a, a).sqrt();
+    (n.is_finite() && n > 1e-12).then(|| [a[0] / n, a[1] / n, a[2] / n])
+}
diff --git a/crates/ui/src/egui_app/tool_orientation_row.rs b/crates/ui/src/egui_app/tool_orientation_row.rs
new file mode 100644
index 00000000..a262a455
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_orientation_row.rs
@@ -0,0 +1,72 @@
+//! The tool editor's lathe orientation row (#630): the LinuxCNC 1-9
+//! code that says which point of a turning insert's or boring bar's
+//! nose the operator touches off - the point the lathe posts write.
+//! For a grooving blade (#641) the same code names the touched-off
+//! corner of its tip edge, and only the OD blade codes are offered.
+//! The draft field only; Apply carries it through `ChangeTool` like
+//! every other tool number, so it is undoable.
+//!
+//! Provenance: LinuxCNC Lathe User Information (tool orientation
+//! chart, public docs); our own widget.
+
+use egui::Ui;
+
+use camcraft_app::orientation;
+use camcraft_app::tools::ToolKind;
+
+use crate::state::State;
+
+use super::fields::field;
+
+/// The row, shown for the kinds that ride a nose centre.
+pub(super) fn orientation_row(ui: &mut Ui, state: &mut State) {
+    let kind = state.tool_ui.tool_kind();
+    let Some(default) = orientation::default_for(kind) else { return };
+    let blade = kind == ToolKind::Groove;
+    let label = if blade { orientation::blade_label } else { orientation::label };
+    let codes: &[u8] = if blade { &orientation::BLADE_FITTING } else { &[1, 2, 3, 4, 5, 6, 7, 8, 9] };
+    field(ui, if blade { "Touched-off corner" } else { "Lathe orientation" });
+    let shown = match state.tool_ui.orientation {
+        Some(q) => label(q).to_owned(),
+        None => format!("default: {}", label(default)),
+    };
+    egui::ComboBox::from_id_salt("tool_lathe_orientation")
+        .selected_text(shown)
+        .width(200.0)
+        .show_ui(ui, |ui| {
+            let none = state.tool_ui.orientation.is_none();
+            if ui.selectable_label(none, format!("default: {}", label(default))).clicked() {
+                state.tool_ui.orientation = None;
+            }
+            for &q in codes {
+                let on = state.tool_ui.orientation == Some(q);
+                if ui.selectable_label(on, label(q)).clicked() {
+                    state.tool_ui.orientation = Some(q);
+                }
+            }
+        });
+    ui.label(if blade {
+        "which corner of the tip edge was touched off - the lathe posts write that corner, not the middle of the blade"
+    } else {
+        "where the touched-off tip sits on the nose (LinuxCNC tool table chart) - the lathe posts write that point, not the nose centre"
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use camcraft_app::tools::catalog;
+
+    use crate::state::ToolUi;
+
+    #[test]
+    fn the_editor_draft_carries_the_orientation_through_apply() {
+        let insert = catalog().into_iter().find(|(n, _)| *n == "TN-1600-0R8").map(|(_, t)| t);
+        let Some(mut t) = insert else { panic!("catalog insert") };
+        assert_eq!(ToolUi::from_tool("TN", &t, true).to_tool().orientation, None, "unstated stays unstated");
+        t.orientation = Some(6);
+        let mut draft = ToolUi::from_tool("TN", &t, true);
+        assert_eq!(draft.to_tool().orientation, Some(6), "a stated code survives an Apply");
+        draft.orientation = Some(1);
+        assert_eq!(draft.to_tool().orientation, Some(1), "the row's pick is what Apply sends");
+    }
+}
diff --git a/crates/ui/src/egui_app/tool_profile_page.rs b/crates/ui/src/egui_app/tool_profile_page.rs
new file mode 100644
index 00000000..159907d1
--- /dev/null
+++ b/crates/ui/src/egui_app/tool_profile_page.rs
@@ -0,0 +1,243 @@
+//! The tool editor's Profile section (#93): a milling tool's holder as a
+//! spun (revolved) half-outline - Parametric (the cylinder its numbers
+//! state) or Custom (a table of points with optional arcs), a flat side
+//! view of cutter, shank and holder with their key dimensions that
+//! follows every keystroke, the live refusal by name, and Apply profile,
+//! which queues the one command. Turning tools are not spun profiles:
+//! for them the column stays the Body section alone (owner, #93).
+//! Provenance: our own pane over `app::tool_body_view` and
+//! `app::spun`; the side view is the handbook's tool drawing. No vendor
+//! material consulted.
+
+use egui::{Align2, Color32, FontId, Pos2, Sense, Shape, Stroke, Ui, Vec2};
+
+use camcraft_app::spun::{SpunPoint, SpunProfile};
+use camcraft_app::tool_body_view;
+use camcraft_app::tools::Tool;
+use camcraft_app::units::{self, Unit};
+
+use crate::state::{State, ToolColumn, is_spun_kind};
+
+/// The side view's size, logical px.
+const VIEW: Vec2 = Vec2::new(260.0, 230.0);
+const NOTE: Color32 = Color32::from_rgb(0x9E, 0xA8, 0xB8);
+const HOLDER: Color32 = Color32::from_rgb(230, 160, 60);
+const BAD: Color32 = Color32::from_rgb(230, 90, 80);
+
+/// The editor's third column: Body / Profile tabs for a milling tool,
+/// the Body section alone for a turning tool.
+pub(super) fn third_column(ui: &mut Ui, state: &mut State, exists: bool, u: Unit) {
+    let milling = is_spun_kind(state.tool_ui.tool_kind());
+    if milling {
+        ui.horizontal(|ui| {
+            let c = state.tool_profile_ui.column;
+            if ui.selectable_label(c == ToolColumn::Body, "Body").on_hover_text("import a holder or assembly mesh").clicked() {
+                state.tool_profile_ui.column = ToolColumn::Body;
+            }
+            if ui
+                .selectable_label(c == ToolColumn::Profile, "Profile")
+                .on_hover_text("draw the holder as a revolved outline")
+                .clicked()
+            {
+                state.tool_profile_ui.column = ToolColumn::Profile;
+            }
+        });
+    }
+    if milling && state.tool_profile_ui.column == ToolColumn::Profile {
+        profile_section(ui, state, exists, u);
+    } else {
+        super::tool_body_page::body_section(ui, state, exists, u);
+    }
+}
+
+fn profile_section(ui: &mut Ui, state: &mut State, exists: bool, u: Unit) {
+    ui.strong("Holder profile");
+    if !exists {
+        ui.label("Add the tool first, then draw its holder.");
+        return;
+    }
+    state.sync_tool_profile_ui();
+    let landed = state.editor_tool_body();
+    ui.label(match &landed {
+        Some(b) if b.spun.is_some() => "landed: a drawn profile".to_owned(),
+        Some(b) => format!("landed: imported body {} - Apply profile replaces it", b.source),
+        None => "landed: the holder cylinder from the numbers".to_owned(),
+    });
+    let custom = state.tool_profile_ui.custom;
+    ui.horizontal(|ui| {
+        if ui
+            .selectable_label(!custom, "Parametric")
+            .on_hover_text("the holder is the Ø × length cylinder of the numbers, redrawn as they change")
+            .clicked()
+        {
+            state.set_profile_custom(false);
+        }
+        if ui.selectable_label(custom, "Custom").on_hover_text("edit the outline point by point; number edits leave it alone").clicked() {
+            state.set_profile_custom(true);
+        }
+    });
+    points_table(ui, state, u);
+    let tool = state.tool_ui.to_tool();
+    let points = state.tool_profile_ui.points.clone();
+    let check = if points.is_empty() { Err("no holder - the tool states none".to_owned()) } else { tool_body_view::spun_preview(&tool, &points) };
+    side_view(ui, &tool, &points, check.as_ref().ok(), u);
+    match &check {
+        Ok(s) => {
+            state.retire_profile_refusal();
+            let top = s.points().last().map_or(0.0, |p| p.z);
+            let foot = s.points().first().map_or(0.0, |p| p.z);
+            let wide = s.max_radius();
+            ui.label(format!(
+                "holder Ø {} × {} {}, gauge {} {}",
+                units::len(2.0 * wide, u, 1),
+                units::len(top - foot, u, 1),
+                u.suffix(),
+                units::len(top, u, 1),
+                u.suffix()
+            ));
+        }
+        Err(e) => {
+            ui.colored_label(BAD, e);
+        }
+    }
+    let state_custom = state.tool_profile_ui.custom;
+    let can = state_custom || landed.is_some();
+    if ui
+        .add_enabled(can, egui::Button::new("Apply profile"))
+        .on_hover_text(if state_custom {
+            "land the drawn holder as the tool's body (one undo step)"
+        } else {
+            "drop the landed body: the holder cylinder is judged again (one undo step)"
+        })
+        .clicked()
+    {
+        state.queue_apply_tool_profile();
+    }
+}
+
+/// The points, tip-up: z, r, arc radius (0 = line), insert after,
+/// remove. Read-only in Parametric.
+fn points_table(ui: &mut Ui, state: &mut State, u: Unit) {
+    let custom = state.tool_profile_ui.custom;
+    let n = state.tool_profile_ui.points.len();
+    let mut insert = None;
+    let mut remove = None;
+    egui::ScrollArea::vertical().max_height(150.0).id_salt("tool_profile_points").show(ui, |ui| {
+        ui.add_enabled_ui(custom, |ui| {
+            egui::Grid::new("tool_profile_grid").num_columns(6).spacing([4.0, 2.0]).show(ui, |ui| {
+                for h in ["#", &format!("z {}", u.suffix()), &format!("r {}", u.suffix()), "arc R", "", ""] {
+                    ui.label(h);
+                }
+                ui.end_row();
+                for i in 0..n {
+                    ui.label(format!("{}", i + 1));
+                    if let Some(p) = state.tool_profile_ui.points.get_mut(i) {
+                        len_cell(ui, u, &mut p.z);
+                        len_cell(ui, u, &mut p.r);
+                        len_cell(ui, u, &mut p.arc);
+                    }
+                    if i + 1 < n && ui.small_button("+").on_hover_text("insert a point after this one").clicked() {
+                        insert = Some(i);
+                    } else if i + 1 >= n {
+                        ui.label("");
+                    }
+                    if ui.small_button("×").on_hover_text("remove this point").clicked() {
+                        remove = Some(i);
+                    }
+                    ui.end_row();
+                }
+            });
+        });
+    });
+    if let Some(i) = insert {
+        state.insert_profile_point(i);
+    }
+    if let Some(i) = remove {
+        state.remove_profile_point(i);
+    }
+}
+
+/// A compact unit-lens length cell (the `fields::num` law, narrower).
+fn len_cell(ui: &mut Ui, u: Unit, v: &mut f64) {
+    let w = [54.0, ui.spacing().interact_size.y];
+    if u == Unit::Millimeters {
+        ui.add_sized(w, egui::DragValue::new(v).speed(0.1));
+    } else {
+        let mut d = units::to_display(*v, u);
+        if ui.add_sized(w, egui::DragValue::new(&mut d).speed(0.1 / 25.4)).changed() {
+            *v = units::from_display(d, u);
+        }
+    }
+}
+
+/// The flat side view: cutter and shank from the tool's numbers, the
+/// holder from the draft (amber when it validates, a red outline when
+/// not), to scale, tip at the bottom, with the key dimensions.
+fn side_view(ui: &mut Ui, tool: &Tool, points: &[SpunPoint], spun: Option<&SpunProfile>, u: Unit) {
+    const PAD: f32 = 16.0;
+    let (resp, painter) = ui.allocate_painter(VIEW, Sense::hover());
+    let rect = resp.rect;
+    painter.rect_filled(rect, 4.0, Color32::from_rgb(24, 26, 31));
+    let cutter = SpunProfile::cutter_of(tool).map(|c| c.outline()).unwrap_or_default();
+    let holder: Vec<(f64, f64)> = spun.map_or_else(|| points.iter().map(|p| (p.z, p.r)).collect(), SpunProfile::outline);
+    let all = || cutter.iter().chain(holder.iter()).filter(|q| q.0.is_finite() && q.1.is_finite());
+    let r_max = all().fold(0.0f64, |a, q| a.max(q.1));
+    let z_max = all().fold(0.0f64, |a, q| a.max(q.0));
+    if r_max <= 0.0 || z_max <= 0.0 {
+        painter.text(rect.center(), Align2::CENTER_CENTER, "enter dimensions", FontId::proportional(11.0), NOTE);
+        return;
+    }
+    // The tool sits left of centre; the right margin holds the labels.
+    let axis_x = rect.min.x + rect.width() * 0.38;
+    let base_y = rect.max.y - PAD;
+    let scale = ((rect.width() * 0.34) / r_max as f32).min((rect.height() - 2.0 * PAD) / z_max as f32).max(f32::EPSILON);
+    let at = |z: f64, r: f64| Pos2::new(axis_x + r as f32 * scale, base_y - z as f32 * scale);
+    painter.line_segment([Pos2::new(axis_x, rect.min.y + 4.0), Pos2::new(axis_x, rect.max.y - 4.0)], Stroke::new(1.0, Color32::from_rgb(70, 74, 84)));
+    let zc = tool.flute_len.max(0.0);
+    let slices = |o: &[(f64, f64)], fill: &dyn Fn(f64) -> Color32| {
+        for w in o.windows(2) {
+            let ((z0, r0), (z1, r1)) = (w[0], w[1]);
+            if z1 > z0 && [z0, z1, r0, r1].iter().all(|v| v.is_finite()) {
+                painter.add(Shape::convex_polygon(vec![at(z0, -r0), at(z0, r0), at(z1, r1), at(z1, -r1)], fill((z0 + z1) * 0.5), Stroke::NONE));
+            }
+        }
+    };
+    slices(&cutter, &|zm| if zm < zc { Color32::from_rgb(168, 178, 192) } else { Color32::from_rgb(122, 130, 142) });
+    let ok = spun.is_some();
+    if ok {
+        slices(&holder, &|_| Color32::from_rgba_unmultiplied(230, 160, 60, 90));
+    }
+    let outline = |o: &[(f64, f64)], ink: Color32| {
+        let mut pts: Vec<Pos2> = o.iter().map(|&(z, r)| at(z, r)).collect();
+        pts.extend(o.iter().filter(|q| q.1 > 0.0).rev().map(|&(z, r)| at(z, -r)));
+        if pts.len() >= 2 {
+            painter.add(Shape::closed_line(pts, Stroke::new(1.0, ink)));
+        }
+    };
+    outline(&cutter, Color32::from_rgb(214, 220, 228));
+    outline(&holder, if ok { HOLDER } else { BAD });
+    // Heights: flute top, the holder's foot (stickout) and top (gauge).
+    let small = FontId::proportional(10.0);
+    let tick = |z: f64, what: &str| {
+        if z.is_finite() && z > 0.0 {
+            let y = base_y - z as f32 * scale;
+            painter.line_segment([Pos2::new(axis_x + 4.0, y), Pos2::new(rect.max.x - 4.0, y)], Stroke::new(0.5, Color32::from_rgb(80, 86, 98)));
+            painter.text(Pos2::new(rect.max.x - 4.0, y - 1.0), Align2::RIGHT_BOTTOM, format!("{what} {}", units::len(z, u, 1)), small.clone(), NOTE);
+        }
+    };
+    tick(zc, "flutes");
+    if let (Some(foot), Some(top)) = (holder.first().map(|q| q.0), holder.last().map(|q| q.0)) {
+        tick(foot, "stickout");
+        tick(top, "gauge");
+    } else {
+        tick(zc + tool.shank_len.max(0.0), "shank");
+    }
+    painter.text(Pos2::new(axis_x, rect.max.y - 2.0), Align2::CENTER_BOTTOM, format!("Ø {}", units::len(tool.diameter, u, 2)), small.clone(), NOTE);
+    painter.text(
+        rect.min + Vec2::new(6.0, 4.0),
+        Align2::LEFT_TOP,
+        format!("shank Ø {} {}", units::len(tool.shank_d, u, 2), u.suffix()),
+        small,
+        NOTE,
+    );
+}
diff --git a/crates/ui/src/egui_app/tree_entry.rs b/crates/ui/src/egui_app/tree_entry.rs
new file mode 100644
index 00000000..db1bfb07
--- /dev/null
+++ b/crates/ui/src/egui_app/tree_entry.rs
@@ -0,0 +1,107 @@
+//! The operation list's Pause / Home entries (#155) in the browser: the
+//! entry row, and the menu rows that add one (on an operation, an entry,
+//! or a setup's Operations row) or change one. Every row queues one
+//! undoable command; delete is `DeleteByName`, as for any named row.
+//! Provenance: our own tree law (issue #155); no vendor material consulted.
+
+use flecs_ecs::prelude::Entity;
+
+use camcraft_app::operation::AfterOperation;
+use camcraft_app::program_entry::{self, action_label};
+use camcraft_app::schema::ProgramEntry;
+
+use crate::state::{CommandKind, EntryVerb, State};
+
+use super::browser_tree::{push_row, Leaf};
+use super::icons::Icon;
+use super::painted;
+
+/// Menu items, keyed past every kind ordinal and `tree_menu`'s own verbs.
+pub(super) const ADD_PAUSE: usize = usize::MAX - 16;
+pub(super) const ADD_HOME: usize = usize::MAX - 17;
+pub(super) const ADD_OPTIONAL: usize = usize::MAX - 18;
+const DELETE: usize = usize::MAX - 19;
+const SUPPRESS: usize = usize::MAX - 20;
+const STEP_ACTION: usize = usize::MAX - 21;
+
+/// The actions an entry can ask, in menu order.
+const ACTIONS: [AfterOperation; 3] = [AfterOperation::ProgramStop, AfterOperation::GoHome, AfterOperation::OptionalStop];
+
+/// One entry row: its key, what it does, and SUPPRESSED when left out.
+pub(super) fn entry_row(
+    state: &State,
+    name: &str,
+    entity: &Entity,
+    depth: usize,
+    rows: &mut Vec<painted::Row>,
+    leaves: &mut Vec<Leaf>,
+) {
+    let entry = program_entry::entry_of(&state.world, entity);
+    let mut suffix = entry.as_ref().map_or_else(String::new, |e| action_label(e.action).to_owned());
+    if entry.as_ref().is_some_and(|e| e.suppressed) {
+        suffix.push_str("  SUPPRESSED");
+    }
+    let selected = camcraft_app::model::is_selected(&state.world, entity);
+    push_row(rows, leaves, name.to_owned(), suffix, painted::Kind::Section, Some(Icon::Post), selected, false, depth, Leaf::Entry(name.to_owned()));
+}
+
+/// The add rows every operation-list menu carries.
+pub(super) fn add_lines() -> [(&'static str, bool, Option<usize>); 3] {
+    [
+        ("Add pause (M0) after", true, Some(ADD_PAUSE)),
+        ("Add go home after", true, Some(ADD_HOME)),
+        ("Add optional stop (M1) after", true, Some(ADD_OPTIONAL)),
+    ]
+}
+
+/// Queue the add `item` names, after the row `after` names (`None` - at
+/// the active setup's end). Returns false when `item` is no add row.
+pub(super) fn add(state: &mut State, item: usize, after: Option<&str>) -> bool {
+    let action = match item {
+        ADD_PAUSE => AfterOperation::ProgramStop,
+        ADD_HOME => AfterOperation::GoHome,
+        ADD_OPTIONAL => AfterOperation::OptionalStop,
+        _ => return false,
+    };
+    state.pending.push_back(CommandKind::ProgramEntry(EntryVerb::Add { action, after: after.map(str::to_owned) }));
+    true
+}
+
+/// The entry menu's rows.
+pub(super) fn entry_lines(entry: &ProgramEntry) -> Vec<(&'static str, bool, Option<usize>)> {
+    let mut lines = vec![("Entry", false, None)];
+    lines.push((step_label(entry.action), true, Some(STEP_ACTION)));
+    lines.push((if entry.suppressed { "Unsuppress entry" } else { "Suppress entry" }, true, Some(SUPPRESS)));
+    lines.push(("Delete entry (undoable)", true, Some(DELETE)));
+    lines.extend(add_lines());
+    lines
+}
+
+fn step_label(a: AfterOperation) -> &'static str {
+    match a {
+        AfterOperation::GoHome => "Does: go home (click to change)",
+        AfterOperation::OptionalStop => "Does: optional stop (M1)",
+        _ => "Does: pause (M0)",
+    }
+}
+
+/// Act on an entry menu row.
+pub(super) fn act(state: &mut State, item: usize, name: &str, entry: &ProgramEntry) {
+    if add(state, item, Some(name)) {
+        return;
+    }
+    let verb = match item {
+        DELETE => {
+            state.pending.push_back(CommandKind::DeleteByName(name.to_owned()));
+            return;
+        }
+        SUPPRESS => EntryVerb::Suppress { name: name.to_owned(), suppressed: !entry.suppressed },
+        STEP_ACTION => {
+            let k = ACTIONS.iter().position(|a| *a == entry.action).unwrap_or(0);
+            let action = ACTIONS.get((k + 1) % ACTIONS.len()).copied().unwrap_or(AfterOperation::ProgramStop);
+            EntryVerb::SetAction { name: name.to_owned(), action }
+        }
+        _ => return,
+    };
+    state.pending.push_back(CommandKind::ProgramEntry(verb));
+}
diff --git a/crates/ui/src/egui_app/tree_glyphs.rs b/crates/ui/src/egui_app/tree_glyphs.rs
new file mode 100644
index 00000000..12668efe
--- /dev/null
+++ b/crates/ui/src/egui_app/tree_glyphs.rs
@@ -0,0 +1,100 @@
+//! The browser tree's painted marks (split from `painted`, #343): the
+//! ~9-px per-kind glyphs - the no-GPU twins of the bundled PNGs - and the
+//! eye. Original geometry.
+//! Provenance: our own drawings; no vendor material consulted.
+
+use egui::{Color32, Pos2, Rect, Shape, Stroke, Vec2};
+
+use super::painted::Kind;
+use super::theme::Tokens;
+
+/// The ~9-px marks, per kind: original geometry, one stroke family.
+pub(super) fn glyph(shapes: &mut Vec<Shape>, c: Pos2, kind: Kind, pal: &Tokens) {
+    let s = Stroke::new(1.0, pal.text_dim);
+    match kind {
+        Kind::Parent(expanded) => {
+            let points = if expanded {
+                vec![c + Vec2::new(-4.0, -2.0), c + Vec2::new(4.0, -2.0), c + Vec2::new(0.0, 3.0)]
+            } else {
+                vec![c + Vec2::new(-2.0, -4.0), c + Vec2::new(3.0, 0.0), c + Vec2::new(-2.0, 4.0)]
+            };
+            shapes.push(Shape::convex_polygon(points, pal.text_dim, Stroke::NONE));
+        }
+        Kind::Section => {
+            // Open folder: a body with a back-tab.
+            let body = Rect::from_min_size(c + Vec2::new(-5.0, -3.0), Vec2::new(10.0, 7.0));
+            shapes.push(Shape::rect_stroke(body, 1.0, s, egui::StrokeKind::Middle));
+            shapes.push(Shape::rect_filled(
+                Rect::from_min_size(body.left_top() + Vec2::new(1.0, -2.5), Vec2::new(4.0, 2.5)),
+                0.0,
+                pal.text_dim,
+            ));
+        }
+        Kind::Model => {
+            let r = Rect::from_center_size(c, Vec2::new(9.0, 7.0));
+            shapes.push(Shape::rect_stroke(r, 0.0, s, egui::StrokeKind::Middle));
+        }
+        Kind::Fixture => {
+            // The vise: two parallel jaws, the screw shaft running from
+            // the movable one, a solid knob. The PNG twin's geometry at
+            // tree scale, drawn from what it names - original.
+            let jaw = Vec2::Y * 3.5;
+            for dx in [-4.0, -0.5] {
+                let p = c + Vec2::X * dx;
+                shapes.push(Shape::line_segment([p - jaw, p + jaw], s));
+            }
+            shapes.push(Shape::line_segment(
+                [c + Vec2::X * -0.5, c + Vec2::X * 2.8],
+                s,
+            ));
+            shapes.push(Shape::circle_filled(c + Vec2::X * 4.0, 1.3, pal.text_dim));
+        }
+        Kind::Stock => {
+            let r = Rect::from_center_size(c, Vec2::new(9.0, 8.0));
+            shapes.push(Shape::rect_stroke(r, 0.0, s, egui::StrokeKind::Middle));
+            shapes.push(Shape::line_segment([r.left_top(), r.right_bottom()], s));
+        }
+        Kind::Wcs => {
+            shapes.push(Shape::line_segment([c - Vec2::X * 4.5, c + Vec2::X * 4.5], s));
+            shapes.push(Shape::line_segment([c - Vec2::Y * 4.5, c + Vec2::Y * 4.5], s));
+        }
+        Kind::Tool => {
+            shapes.push(Shape::circle_stroke(c, 4.0, s));
+        }
+        Kind::Setup(active) => {
+            shapes.push(Shape::circle_stroke(c, 5.0, Stroke::new(1.5, pal.text_dim)));
+            if active {
+                shapes.push(Shape::circle_filled(c, 2.8, pal.accent));
+            }
+        }
+        Kind::Op => {
+            // A play-triangle in a square frame: "this op owns a path",
+            // drawn from what it names, original.
+            let r = Rect::from_center_size(c, Vec2::new(9.0, 9.0));
+            shapes.push(Shape::rect_stroke(r, 1.0, s, egui::StrokeKind::Middle));
+            shapes.push(Shape::convex_polygon(
+                vec![
+                    Pos2::new(c.x - 1.8, c.y - 3.0),
+                    Pos2::new(c.x + 3.0, c.y),
+                    Pos2::new(c.x - 1.8, c.y + 3.0),
+                ],
+                Color32::TRANSPARENT,
+                Stroke::new(1.0, pal.text_dim),
+            ));
+        }
+    }
+}
+
+/// The browser eye: an outlined lid-rect with a pupil, or crossed when
+/// hidden (display state - the row click still selects, the eye never
+/// destroys).
+pub(super) fn eye_glyph(shapes: &mut Vec<Shape>, r: Rect, hidden: bool, pal: &Tokens) {
+    let s = Stroke::new(1.0, if hidden { pal.text_faint } else { pal.text_dim });
+    shapes.push(Shape::rect_stroke(r, 4.0, s, egui::StrokeKind::Middle));
+    if hidden {
+        shapes.push(Shape::line_segment([r.left_top(), r.right_bottom()], s));
+        shapes.push(Shape::line_segment([r.left_bottom(), r.right_top()], s));
+    } else {
+        shapes.push(Shape::circle_filled(r.center(), 2.2, pal.text_dim));
+    }
+}
diff --git a/crates/ui/src/egui_app/tree_ink_tests.rs b/crates/ui/src/egui_app/tree_ink_tests.rs
new file mode 100644
index 00000000..22dfaae4
--- /dev/null
+++ b/crates/ui/src/egui_app/tree_ink_tests.rs
@@ -0,0 +1,72 @@
+//! #506: the browser tree's row ink reads on the ground it is painted on,
+//! in both built-in themes and whichever appearance the OS reports.
+//! Structural (no pixels, no GPU): the inks `painted::row_inks` hands the
+//! tree are measured against the grounds the tree paints on, with the
+//! same WCAG floor `contrast::readable` holds the theme table to; and the
+//! egui context a theme is applied to carries that table in BOTH of its
+//! theme slots, so the panel the tree sits on is the table's own fill.
+//! Provenance: our own tests over our own palettes.
+
+use super::contrast;
+use super::painted::row_inks;
+use super::theme::{self, Tokens};
+
+const THEMES: [(&str, Tokens); 2] = [("dark", Tokens::DARK), ("light", Tokens::LIGHT)];
+
+/// Every ground a tree row can sit on: the panel, the strip, and the
+/// row's own hover and selection fills.
+fn grounds(t: &Tokens) -> [(&'static str, egui::Color32); 4] {
+    [
+        ("ink", t.ink),
+        ("strip", t.strip_fill()),
+        ("field_hover", t.field_hover),
+        ("selection_bg", t.selection_bg),
+    ]
+}
+
+#[test]
+fn tree_row_ink_clears_body_contrast_on_every_row_ground() {
+    for (name, t) in THEMES {
+        for hidden in [false, true] {
+            for (ground, bg) in grounds(&t) {
+                // Only a selected row sits on the selection fill.
+                let selected = ground == "selection_bg";
+                let (label, suffix) = row_inks(&t, hidden, selected);
+                for (part, ink) in [("label", label), ("suffix", suffix)] {
+                    let r = contrast::ratio(ink, bg);
+                    assert!(
+                        r >= contrast::BODY,
+                        "{name}: {part} (hidden={hidden}) {ink:?} on {ground} {bg:?} reads {r:.2}:1"
+                    );
+                }
+            }
+        }
+        assert_eq!(row_inks(&t, false, false).0, t.text, "{name}: a row label is body text");
+    }
+}
+
+/// The root cause: egui keeps a dark AND a light style and follows the
+/// OS appearance. A light-mode system must not swap the table out from
+/// under the painted tree - both slots carry the applied table.
+#[test]
+fn applied_theme_fills_both_egui_theme_slots() {
+    for (name, t) in THEMES {
+        let ctx = egui::Context::default();
+        theme::apply_to(&ctx, &t);
+        for slot in [egui::Theme::Dark, egui::Theme::Light] {
+            let v = &ctx.style_of(slot).visuals;
+            assert_eq!(v.panel_fill, t.ink, "{name}: {slot:?} slot's panel is the table's ink");
+            assert_eq!(v.window_fill, t.ink_alt, "{name}: {slot:?} slot's window is the table's");
+            assert_eq!(v.override_text_color, Some(t.text), "{name}: {slot:?} slot's text");
+            let (label, _) = row_inks(&t, false, false);
+            let r = contrast::ratio(label, v.panel_fill);
+            assert!(r >= contrast::BODY, "{name}: {slot:?} slot tree label reads {r:.2}:1");
+        }
+        // The appearance the OS reports flips the active slot; the panel
+        // the tree is drawn on stays the table's.
+        for os in [egui::Theme::Light, egui::Theme::Dark] {
+            ctx.set_theme(os);
+            assert_eq!(ctx.global_style().visuals.panel_fill, t.ink, "{name}: OS {os:?} kept the table");
+        }
+    }
+}
diff --git a/crates/ui/src/egui_app/tree_menu.rs b/crates/ui/src/egui_app/tree_menu.rs
new file mode 100644
index 00000000..73f3f1e9
--- /dev/null
+++ b/crates/ui/src/egui_app/tree_menu.rs
@@ -0,0 +1,304 @@
+//! The browser's operation menu (split from `panes`, #343): a right-click
+//! on an operation row - or on a setup's Operations row, for Paste - opens
+//! the verbs and the retype list; every row is one undoable command.
+//! Provenance: our own port of the imgui tree menu (our code); no HSMWorks
+//! material consulted.
+
+use egui::{Rect, Sense, Ui, Vec2};
+
+use camcraft_app::model;
+use camcraft_app::operation;
+
+use crate::actions;
+use crate::state::{CommandKind, State, TreeMenuTarget, UiTarget};
+
+use super::browser_tree::Leaf;
+use super::tree_entry;
+use super::panes::{DROP_GAP, DROP_W};
+use super::theme::Tokens;
+
+/// The tree menu's verb rows, keyed past every kind ordinal.
+const MENU_CLEAR: usize = usize::MAX;
+const MENU_DELETE: usize = usize::MAX - 1;
+const MENU_RENAME: usize = usize::MAX - 2;
+const MENU_COPY: usize = usize::MAX - 3;
+const MENU_PASTE: usize = usize::MAX - 4;
+/// #110: suppress / unsuppress, and the after-action row that steps
+/// through `AfterOperation::ALL`.
+const MENU_SUPPRESS: usize = usize::MAX - 5;
+const MENU_AFTER: usize = usize::MAX - 6;
+
+/// The after-action row's text: what happens now; a click steps on.
+fn after_row_label(a: operation::AfterOperation) -> &'static str {
+    match a {
+        operation::AfterOperation::None => "After: continue (click to change)",
+        operation::AfterOperation::OptionalStop => "After: optional stop (M1)",
+        operation::AfterOperation::ProgramStop => "After: program stop (M0)",
+        operation::AfterOperation::GoHome => "After: go home",
+    }
+}
+
+/// The operation's retype menu (M9.1): what replaced the page's Type
+/// combo. Grouping is the retired combo's law restated once -
+/// `Section::ORDER` headers, `KindInfo::admits` hiding a section none
+/// of whose kinds the machine can run (M13.5 B: the lathe's Drilling
+/// header fronts the axial Drill alone, every other row of it dark),
+/// and the current kind's section staying listed even when the
+/// machine says no, so a mid-edit machine swap never erases the
+/// operation's own name. A kind row needs a second click before it queues
+/// `ChangeOperationKind` - one undo unit, the numbers carried by the
+/// one retype law below; a dark row is queued too, because the refusal
+/// belongs at the command door (`family_gate`), where it names itself
+/// on the status line - never a silent dead pixel. Hand-drawn like the
+/// ribbon's dropdowns (the panel is geometry, not a Widget): an Area
+/// at Foreground order, so a press on a row belongs to the row, never
+/// to the tree behind it; any other primary press closes it.
+pub(super) fn tree_menu(ui: &mut Ui, state: &mut State, pal: &Tokens, rect: Rect, leaves: &[Leaf]) {
+    let Some(target) = state.tree_menu.clone() else {
+        return;
+    };
+    // #339 slice 4: model rows and a setup's Fixtures node carry the
+    // fixture verbs, drawn by their own menu.
+    if matches!(target, TreeMenuTarget::Model { .. } | TreeMenuTarget::Fixtures(_)) {
+        super::fixture_menu::fixture_menu(ui, state, pal, rect, leaves, &target);
+        return;
+    }
+    // A setup's Operations row anchors Paste: the active setup's (the
+    // menu's click activated it), else - for the frame its activation is
+    // still queued - the first one.
+    let active = camcraft_app::setup::active(&state.world).unwrap_or_default();
+    let row_ix = leaves.iter().position(|leaf| match (&target, leaf) {
+        (TreeMenuTarget::Operation(name), Leaf::Op(row)) => name == row,
+        (TreeMenuTarget::Operations, Leaf::SetupOps(setup)) => *setup == active,
+        (TreeMenuTarget::Entry(name), Leaf::Entry(row)) => name == row,
+        _ => false,
+    }).or_else(|| match target {
+        TreeMenuTarget::Operations => leaves.iter().position(|leaf| matches!(leaf, Leaf::SetupOps(_))),
+        TreeMenuTarget::Operation(_)
+        | TreeMenuTarget::Entry(_)
+        | TreeMenuTarget::Model { .. }
+        | TreeMenuTarget::Fixtures(_) => None,
+    });
+    let Some(ix) = row_ix else {
+        state.tree_menu = None;
+        state.retype_confirm = None;
+        return;
+    };
+    // #155: a Pause / Home entry's own menu (gone - the menu closes).
+    let entry = match &target {
+        TreeMenuTarget::Entry(n) => {
+            let Some(e) = model::find_by_name(&state.world, n)
+                .and_then(|e| camcraft_app::program_entry::entry_of(&state.world, &e))
+            else {
+                state.tree_menu = None;
+                state.retype_confirm = None;
+                return;
+            };
+            Some((n.clone(), e))
+        }
+        _ => None,
+    };
+    let name = match &target {
+        TreeMenuTarget::Operation(name) => {
+            if model::find_by_name(&state.world, name)
+                .and_then(|entity| model::operation_of(&state.world, &entity))
+                .is_none()
+            {
+                state.tree_menu = None;
+                state.retype_confirm = None;
+                return;
+            }
+            Some(name.as_str())
+        }
+        TreeMenuTarget::Operations
+        | TreeMenuTarget::Entry(_)
+        | TreeMenuTarget::Model { .. }
+        | TreeMenuTarget::Fixtures(_) => None,
+    };
+    let here = name.and_then(|name| model::find_by_name(&state.world, name))
+        .and_then(|entity| model::operation_of(&state.world, &entity))
+        .map(|op| op.params.kind().ordinal());
+    // #110: the op's suppression and after-action, for the menu rows.
+    let flow = name.and_then(|name| model::find_by_name(&state.world, name))
+        .and_then(|entity| model::operation_of(&state.world, &entity))
+        .map(|op| (op.suppressed, op.after));
+    // #388: an op's rows (its retype) read its own setup's machine, the
+    // one the retype gate judges; a new op joins the active setup.
+    let machine = match name.and_then(|name| model::find_by_name(&state.world, name))
+        .and_then(|entity| model::operation_of(&state.world, &entity))
+    {
+        Some(op) => camcraft_app::machine::kind_of_setup(&state.world, op.setup.as_deref()),
+        None => camcraft_app::machine::kind_of(&state.world),
+    };
+    // The rows: section headers and kinds, in registry order, read
+    // from the same taxonomy as the ribbon's cells - never a list.
+    let mut lines: Vec<(&'static str, bool, Option<usize>)> = Vec::new();
+    // The row's verbs first: clearing the generated path (keeps the
+    // operation) and deleting the operation are two different asks,
+    // and the menu names both - each one undoable command.
+    lines.push(("Operation", false, None));
+    if name.is_some() {
+        lines.push(("Rename operation", true, Some(MENU_RENAME)));
+        lines.push(("Copy operation", true, Some(MENU_COPY)));
+    }
+    lines.push(("Paste operation", state.operation_clipboard.is_some(), Some(MENU_PASTE)));
+    if name.is_some() {
+        lines.push(("Clear toolpath", true, Some(MENU_CLEAR)));
+        lines.push(("Delete operation (undoable)", true, Some(MENU_DELETE)));
+        // #110: beside the verbs, so they stay on screen however long
+        // the kind list below runs.
+        let suppressed = flow.is_some_and(|(s, _)| s);
+        lines.push((if suppressed { "Unsuppress operation" } else { "Suppress operation" }, true, Some(MENU_SUPPRESS)));
+        // One row that steps through the after-actions (a click is one
+        // undoable edit), so the menu grows by two rows, not six.
+        lines.push((after_row_label(flow.map_or(operation::AfterOperation::None, |(_, a)| a)), true, Some(MENU_AFTER)));
+    }
+    // #155: a Pause / Home entry after this row (a setup's: at its end),
+    // last of the verbs so every row above keeps its place.
+    lines.extend(tree_entry::add_lines());
+    let here_section = here.and_then(|index| operation::KindInfo::ALL.get(index).map(|k| k.section));
+    for s in operation::Section::ORDER.into_iter().filter(|_| name.is_some()) {
+        // The current kind's own section keeps every row (dark where
+        // the machine says no); any other section lists only what the
+        // door admits, and leaves the menu when that is nothing.
+        let rows = if here_section == Some(s) {
+            s.kinds()
+        } else {
+            s.kinds_for(machine)
+        };
+        if rows.is_empty() {
+            continue;
+        }
+        lines.push((s.label(), false, None));
+        for i in rows {
+            if let Some(k) = operation::KindInfo::ALL.get(i) {
+                lines.push((k.label, k.admits(machine), Some(i)));
+            }
+        }
+    }
+    if let Some((_, e)) = &entry {
+        lines = tree_entry::entry_lines(e);
+    }
+    let anchor = egui::Pos2::new(
+        rect.left(),
+        rect.top() + (ix + 1) as f32 * pal.row_height + DROP_GAP,
+    );
+    let panel = Rect::from_min_size(
+        anchor,
+        Vec2::new(DROP_W, lines.len() as f32 * pal.row_height),
+    );
+    let mut chosen: Option<usize> = None;
+    egui::Area::new(ui.id().with(("tree-menu", ix)))
+        .fixed_pos(anchor)
+        .order(egui::Order::Foreground)
+        .movable(false)
+        .show(ui.ctx(), |ui| {
+            let p = ui.painter();
+            p.rect_filled(panel, pal.radius_menu, pal.ink);
+            p.rect_stroke(
+                panel,
+                pal.radius_menu,
+                egui::Stroke::new(1.0, pal.border),
+                egui::StrokeKind::Outside,
+            );
+            for (k, (label, runnable, item)) in lines.iter().enumerate() {
+                let r = Rect::from_min_size(
+                    egui::Pos2::new(anchor.x, anchor.y + k as f32 * pal.row_height),
+                    Vec2::new(DROP_W, pal.row_height),
+                );
+                let is_current = item.is_some_and(|i| Some(i) == here);
+                if is_current {
+                    p.rect_filled(r, 0.0, pal.selection_bg);
+                }
+                let resp = item.map(|_| {
+                    ui.interact(r, ui.id().with(("tree-menu-row", k)), Sense::click())
+                });
+                if let Some(resp) = &resp
+                    && resp.hovered()
+                    && !is_current
+                {
+                    p.rect_filled(r, 0.0, pal.field_hover);
+                }
+                let armed = name.is_some_and(|name| state.retype_confirm.as_ref()
+                    .is_some_and(|(pending_name, pending_kind)|
+                        pending_name == name && *item == Some(*pending_kind)));
+                let text = if is_current {
+                    format!("{label} (current)")
+                } else if armed {
+                    format!("Confirm change to {label}")
+                } else {
+                    (*label).to_owned()
+                };
+                p.text(
+                    r.left_center() + Vec2::new(8.0, 0.0),
+                    egui::Align2::LEFT_CENTER,
+                    &text,
+                    egui::FontId::proportional(pal.font_row),
+                    match item {
+                        None => pal.text_dim,
+                        Some(_) if !runnable || is_current => pal.text_faint,
+                        Some(_) => pal.text,
+                    },
+                );
+                if let Some(resp) = resp
+                    && resp.clicked()
+                    && (*runnable || *item != Some(MENU_PASTE))
+                {
+                    chosen = *item;
+                }
+            }
+        });
+    if let Some(i) = chosen {
+        if let Some((n, e)) = &entry {
+            tree_entry::act(state, i, n, e);
+        } else if tree_entry::add(state, i, name) {
+            // queued: the add rows of an operation or a setup's list
+        } else if i == MENU_PASTE {
+            actions::paste_operation(state);
+        } else if let Some(name) = name {
+            if i == MENU_RENAME {
+                let label = model::find_by_name(&state.world, name)
+                    .map(|e| model::operation_label(&state.world, name, &e))
+                    .unwrap_or_else(|| name.to_owned());
+                state.rename_draft = Some((name.to_owned(), label));
+                actions::target(state, UiTarget::Operation(name.to_owned()));
+            } else if i == MENU_COPY {
+                actions::copy_operation(state, name);
+            } else if i == MENU_CLEAR {
+                state.pending.push_back(CommandKind::ClearToolpath(name.to_owned()));
+            } else if i == MENU_DELETE {
+                state.pending.push_back(CommandKind::DeleteOperation(name.to_owned()));
+            } else if i == MENU_SUPPRESS {
+                let suppressed = !flow.is_some_and(|(s, _)| s);
+                state.pending.push_back(CommandKind::SuppressOperation { name: name.to_owned(), suppressed });
+            } else if i == MENU_AFTER {
+                let all = operation::AfterOperation::ALL;
+                let now = flow.map_or(operation::AfterOperation::None, |(_, a)| a);
+                let k = all.iter().position(|a| *a == now).unwrap_or(0);
+                let after = all.get((k + 1) % all.len()).copied().unwrap_or_default();
+                state.pending.push_back(CommandKind::EditOperationAfter { name: name.to_owned(), after });
+            } else if Some(i) != here {
+                let choice = (name.to_owned(), i);
+                if state.retype_confirm.as_ref() == Some(&choice) {
+                    state.pending.push_back(CommandKind::ChangeOperationKind {
+                        name: name.to_owned(), kind: i,
+                    });
+                } else {
+                    state.retype_confirm = Some(choice);
+                    return;
+                }
+            }
+        }
+        state.tree_menu = None;
+        state.retype_confirm = None;
+    } else if ui.input(|i| {
+        i.pointer.button_pressed(egui::PointerButton::Primary)
+            && i.pointer.hover_pos().is_none_or(|pos| !panel.contains(pos))
+    }) {
+        // The dropdowns' close law: a primary press that is nobody's
+        // row is the menu's - it never stacks and never stalks a
+        // document the user has moved on from.
+        state.tree_menu = None;
+        state.retype_confirm = None;
+    }
+}
