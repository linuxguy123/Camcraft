index 00000000..b3b0e009
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/machines_edit.rs
@@ -0,0 +1,234 @@
+//! The Machines pane's file editor through the real shell (issue #383):
+//! a machine made from a template has its travels and coolant and
+//! live-tool codes typed in and is saved to the user machines folder;
+//! a refusal sits on its field and blocks the save; a shipped machine's
+//! Save becomes Save As; a hand-written file keeps its unknown keys.
+//! None of it touches the command queue or the history - editing a
+//! machine FILE is a save with its own confirmation, not a document edit.
+//! Provenance: our own tests, specced from the issue's "Done means" and
+//! the egui_kittest vendored sources; no HSMWorks material involved.
+//! Structural only: no golden PNG.
+//!
+//! Gate map (M4.4): covers ui::egui_app::machines_pane, ui::egui_app::machine_file_editor, app::machine::draft, app::machine::fields, app::machine::store.
+
+use std::path::{Path, PathBuf};
+
+use egui::accesskit::Role;
+
+use super::machines_pane::{assert_no_commands, harness_with_user_dir, open_machines};
+use super::*;
+use crate::egui_app::machine_file_editor::Prompt;
+
+/// A fresh, empty user machines folder for one test.
+fn user_dir(tag: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("camcraft_ui_machines_edit_{tag}_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).expect("make the test folder");
+    d
+}
+
+fn select_row(h: &mut Harness<'static, ShellUi>, name: &str) {
+    let label = h
+        .state()
+        .state
+        .machines_pane
+        .list
+        .as_ref()
+        .and_then(|l| l.iter().find(|e| e.name == name))
+        .map(super::super::machines_pane::row_label)
+        .unwrap_or_else(|| panic!("the catalogue lists {name}"));
+    h.get_by_label(&label).scroll_to_me();
+    h.run_steps(10);
+    h.get_by_label(&label).click();
+    h.run_steps(2);
+}
+
+fn press(h: &mut Harness<'static, ShellUi>, label: &str) {
+    h.get_by_label(label).scroll_to_me();
+    h.run_steps(4);
+    h.get_by_label(label).click();
+    h.run_steps(3);
+}
+
+/// Replace a grid field's text the way a user does: click it, select
+/// all, type.
+fn type_into(h: &mut Harness<'static, ShellUi>, field: &str, text: &str) {
+    h.get_by_role_and_label(Role::TextInput, field).scroll_to_me();
+    h.run_steps(6);
+    h.get_by_role_and_label(Role::TextInput, field).click();
+    h.run();
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: Key::A,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run();
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::NONE));
+    h.get_by_role_and_label(Role::TextInput, field).type_text(text);
+    h.run_steps(3);
+}
+
+fn draft_at(h: &Harness<'static, ShellUi>, pointer: &str) -> Option<serde_json::Value> {
+    h.state().state.machines_pane.editor.as_ref().and_then(|e| e.draft.value.pointer(pointer).cloned())
+}
+
+fn prompt(h: &Harness<'static, ShellUi>) -> Option<Prompt> {
+    h.state().state.machines_pane.editor.as_ref().and_then(|e| e.prompt.clone())
+}
+
+fn read_json(p: &Path) -> serde_json::Value {
+    serde_json::from_str(&std::fs::read_to_string(p).expect("read back")).expect("json")
+}
+
+#[test]
+fn a_template_machine_takes_new_travels_and_codes_and_saves_to_the_user_folder() {
+    let dir = user_dir("template");
+    let mut h = harness_with_user_dir(Some(dir.clone()));
+    h.run();
+    open_machines(&mut h);
+    select_row(&mut h, "Lathe");
+    press(&mut h, "New from template");
+    let model = h.state().state.machines_pane.editor.as_ref().map(|e| e.draft.model());
+    assert_eq!(model.as_deref(), Some("TURNING CENTER 2-AXIS copy"));
+    // Travels: the lathe's X turret is the first part under the bed.
+    type_into(&mut h, "X travel max", "350");
+    let x = "/kinematics/default/parts/0/parts/0";
+    assert_eq!(draft_at(&h, &format!("{x}/travel/max")).and_then(|v| v.as_f64()), Some(350.0));
+    type_into(&mut h, "Z travel min", "-700");
+    assert_eq!(draft_at(&h, &format!("{x}/parts/0/travel/min")).and_then(|v| v.as_f64()), Some(-700.0));
+    // Coolant code.
+    type_into(&mut h, "Coolant Flood code", "M7");
+    // Live-tool codes: one alone is refused on its field and blocks the save.
+    type_into(&mut h, "Live tool C on", "M154");
+    h.get_by_label("Validation: 1 refusal - save blocked");
+    assert!(h.query_all_by_label_contains("live_tool: states 1 of the 4 words").count() >= 1);
+    press(&mut h, "Save machine");
+    assert_eq!(prompt(&h), None, "a blocked save asks nothing");
+    for (f, c) in [("Live tool C off", "M155"), ("Live tool spindle on", "M133"), ("Live tool spindle off", "M135")] {
+        type_into(&mut h, f, c);
+    }
+    h.get_by_label("Validation: passes");
+    // Save on a never-saved copy is Save As, named from the model.
+    press(&mut h, "Save machine");
+    assert_eq!(prompt(&h), Some(Prompt::SaveAs));
+    press(&mut h, "Write file");
+    let path = dir.join("turning-center-2-axis-copy.mch");
+    assert!(path.is_file(), "the machine was written to the user folder");
+    let v = read_json(&path);
+    assert_eq!(v.pointer(&format!("{x}/travel/max")).and_then(|v| v.as_f64()), Some(350.0));
+    assert_eq!(v.pointer(&format!("{x}/parts/0/travel/min")).and_then(|v| v.as_f64()), Some(-700.0));
+    let ts = "/kinematics/default/parts/0/parts/1/tool_station";
+    assert_eq!(v.pointer(&format!("{ts}/coolants/0/mCode")).and_then(|v| v.as_str()), Some("M7"));
+    assert_eq!(v.pointer(&format!("{ts}/live_tool/spindle_off")).and_then(|v| v.as_str()), Some("M135"));
+    // The catalogue re-read lists it, selected; the editor says so.
+    let st = &h.state().state.machines_pane;
+    let sel = st.selected.and_then(|i| st.list.as_ref().and_then(|l| l.get(i)));
+    assert_eq!(sel.map(|e| e.name.as_str()), Some("TURNING CENTER 2-AXIS copy"));
+    assert!(sel.is_some_and(|e| e.is_valid()));
+    h.get_by_label(&format!("Saved {}", path.display()));
+    assert_no_commands(&h);
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn a_backwards_travel_is_refused_on_its_field_and_nothing_is_written() {
+    let dir = user_dir("refused");
+    let mut h = harness_with_user_dir(Some(dir.clone()));
+    h.run();
+    open_machines(&mut h);
+    press(&mut h, "New blank");
+    type_into(&mut h, "X travel min", "100");
+    type_into(&mut h, "X travel max", "50");
+    h.get_by_label("Validation: 1 refusal - save blocked");
+    // Shown under both ends of the stroke.
+    assert_eq!(h.query_all_by_label("X travel: min 100 must be below max 50").count(), 2);
+    press(&mut h, "Save machine");
+    press(&mut h, "Save machine as...");
+    assert_eq!(prompt(&h), None, "both saves are blocked");
+    assert_eq!(std::fs::read_dir(&dir).map(|d| d.count()).unwrap_or(0), 0, "nothing written");
+    // Fixing the field unblocks it.
+    type_into(&mut h, "X travel max", "150");
+    h.get_by_label("Validation: passes");
+    assert_no_commands(&h);
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// GUI-test finding on PR #478: a bare `M` in an M-code field passed
+/// validation. It is refused under its field and blocks both saves.
+#[test]
+fn a_bare_m_code_is_refused_on_its_field_and_blocks_the_save() {
+    let dir = user_dir("bare_m");
+    let mut h = harness_with_user_dir(Some(dir.clone()));
+    h.run();
+    open_machines(&mut h);
+    select_row(&mut h, "Lathe");
+    press(&mut h, "New from template");
+    for (f, c) in [("Live tool C on", "M154"), ("Live tool C off", "M155"), ("Live tool spindle on", "M133"), ("Live tool spindle off", "M135")] {
+        type_into(&mut h, f, c);
+    }
+    h.get_by_label("Validation: passes");
+    type_into(&mut h, "Live tool C on", "M");
+    h.get_by_label("Validation: 1 refusal - save blocked");
+    h.get_by_label(r#"live_tool.c_axis_on: code "M" is not an M word like M8 (no number after M)"#);
+    type_into(&mut h, "Coolant Flood code", "M");
+    h.get_by_label("Validation: 2 refusals - save blocked");
+    h.get_by_label(r#"coolant Flood: code "M" is not an M word like M8 (no number after M)"#);
+    press(&mut h, "Save machine");
+    press(&mut h, "Save machine as...");
+    assert_eq!(prompt(&h), None, "both saves are blocked");
+    assert_eq!(std::fs::read_dir(&dir).map(|d| d.count()).unwrap_or(0), 0, "nothing written");
+    type_into(&mut h, "Live tool C on", "M08");
+    type_into(&mut h, "Coolant Flood code", "M7");
+    h.get_by_label("Validation: passes");
+    assert_no_commands(&h);
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn editing_a_shipped_machine_saves_as_a_copy() {
+    let dir = user_dir("shipped");
+    let mut h = harness_with_user_dir(Some(dir.clone()));
+    h.run();
+    open_machines(&mut h);
+    select_row(&mut h, "VMC 3-axis");
+    press(&mut h, "Edit machine");
+    assert!(h.state().state.machines_pane.editor.as_ref().is_some_and(|e| e.draft.read_only));
+    h.get_by_label("Shipped machine - read-only; Save As writes your own copy");
+    press(&mut h, "Save machine");
+    assert_eq!(prompt(&h), Some(Prompt::SaveAs), "Save on a shipped machine is Save As");
+    assert_no_commands(&h);
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn a_hand_written_user_file_keeps_its_unknown_keys_through_an_edit_and_save() {
+    let dir = user_dir("unknown");
+    let path = dir.join("shop.mch");
+    let text = r#"{
+      "general": { "model": "SHOP MILL", "kind": "mill" },
+      "kinematics": { "default": { "units": { "length": "mm" }, "parts": [
+        { "name": "X", "type": "linear", "travel": { "min": -100.0, "max": 100.0 } },
+        { "name": "Y", "type": "linear" }, { "name": "Z", "type": "linear" }
+      ] } },
+      "x_shop_notes": { "probe": "OMP40" }
+    }"#;
+    std::fs::write(&path, text).expect("write");
+    let mut h = harness_with_user_dir(Some(dir.clone()));
+    h.run();
+    open_machines(&mut h);
+    select_row(&mut h, "SHOP MILL");
+    press(&mut h, "Edit machine");
+    type_into(&mut h, "X travel max", "120");
+    press(&mut h, "Save machine");
+    assert_eq!(prompt(&h), Some(Prompt::Save(path.clone())), "Save over its own file asks first");
+    assert_eq!(read_json(&path).pointer("/kinematics/default/parts/0/travel/max").and_then(|v| v.as_f64()), Some(100.0));
+    press(&mut h, "Write file");
+    let v = read_json(&path);
+    assert_eq!(v.pointer("/kinematics/default/parts/0/travel/max").and_then(|v| v.as_f64()), Some(120.0));
+    assert_eq!(v.pointer("/x_shop_notes/probe").and_then(|v| v.as_str()), Some("OMP40"), "unknown key kept");
+    assert_no_commands(&h);
+    let _ = std::fs::remove_dir_all(&dir);
+}
diff --git a/crates/ui/src/egui_app/tests/machines_pane.rs b/crates/ui/src/egui_app/tests/machines_pane.rs
new file mode 100644
index 00000000..b2d97ba3
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/machines_pane.rs
@@ -0,0 +1,298 @@
+//! The Machines pane's frame tests (issue #287): the View door opens it
+//! beside the properties pane, it lists the shipped library, selecting a
+//! machine shows its properties and its validation - a clean pass, or
+//! each refusal by name - and none of it touches the command queue (the
+//! pane is view state) except "Use for this setup" (#384), which queues
+//! the undoable machine assignment and is disabled, with its reason
+//! shown, for a refused machine.
+//! Provenance: our own tests, specced from the issue and the egui_dock /
+//! egui_kittest vendored sources; no HSMWorks material involved.
+//!
+//! Gate map (M4.4): covers ui::egui_app::machines_pane, ui::egui_app::layout, ui::state, app::machine::library, app::machine::validate, app::commands::load_machine, ui::state_setup_mount.
+
+use super::super::layout::{self, ViewRow};
+use super::super::machines_pane::{row_label, verdict, USE_FOR_SETUP};
+use super::*;
+use crate::state::Panel;
+
+fn blank_harness() -> Harness<'static, ShellUi> {
+    harness_with_user_dir(None)
+}
+
+/// A blank shell whose Machines pane lists `dir` as the user machines
+/// folder (`None`: no user folder) - never the tester's real one.
+pub(super) fn harness_with_user_dir(dir: Option<std::path::PathBuf>) -> Harness<'static, ShellUi> {
+    let mut sh = ShellUi::blank();
+    sh.state.machines_pane.user_dir = Some(dir);
+    Harness::builder()
+        .with_size(Vec2::new(1280.0, 720.0))
+        .build_ui_state(frame, sh)
+}
+
+pub(super) fn click(h: &mut Harness<'static, ShellUi>, at: egui::Pos2) {
+    set_pos(h, at);
+    button_at(h, egui::PointerButton::Primary, at, true);
+    button_at(h, egui::PointerButton::Primary, at, false);
+    h.run_steps(2);
+}
+
+/// Open the Machines pane the way a user does: the ribbon's View door,
+/// then its "Machines" row.
+pub(super) fn open_machines(h: &mut Harness<'static, ShellUi>) {
+    let strip =
+        egui::Rect::from_min_size(egui::Pos2::ZERO, Vec2::new(1280.0, super::super::shell::RIBBON_H));
+    let (cells, _) = mill_plan_at(1280.0);
+    let button = cells
+        .iter()
+        .find(|c| c.cmd == Cmd::View)
+        .expect("the View door stands on the bar")
+        .rect;
+    let rows = panes::view_rows_of(button, strip, &theme::current());
+    let at = rows
+        .iter()
+        .find(|(r, _)| *r == ViewRow::Panel(Panel::Machines))
+        .expect("the View door lists Machines")
+        .1
+        .center();
+    click(h, button.center());
+    click(h, at);
+}
+
+pub(super) fn assert_no_commands(h: &Harness<'static, ShellUi>) {
+    let st = &h.state().state;
+    assert!(st.pending.is_empty(), "the pane queued a command: {:?}", st.pending);
+    assert!(st.history.is_empty(), "the pane landed in the history");
+}
+
+#[test]
+fn the_view_door_opens_the_machines_pane_beside_properties() {
+    let mut h = blank_harness();
+    h.run();
+    assert!(!layout::is_open(&h.state().dock, &Tab::Machines), "closed by default");
+    open_machines(&mut h);
+    let dock = &h.state().dock;
+    let m = dock.find_tab(&Tab::Machines).expect("the pane opened");
+    let p = dock.find_tab(&Tab::Properties).expect("properties still open");
+    assert_eq!(m.node_path(), p.node_path(), "a tab in the properties pane's leaf");
+    assert!(h.state().state.panels_open.machines);
+    // The pane read the catalogue: the whole shipped library, in order.
+    let names: Vec<String> = h
+        .state()
+        .state
+        .machines_pane
+        .list
+        .as_ref()
+        .expect("the catalogue was read")
+        .iter()
+        .map(|e| e.name.clone())
+        .collect();
+    let want: Vec<String> = camcraft_app::posting::MACHINES.iter().map(|(n, _)| (*n).to_owned()).collect();
+    assert_eq!(names, want);
+    // The same door closes it.
+    open_machines(&mut h);
+    assert!(!layout::is_open(&h.state().dock, &Tab::Machines));
+    assert_no_commands(&h);
+}
+
+#[test]
+fn selecting_a_shipped_machine_shows_its_sheet_and_a_clean_validation() {
+    let mut h = blank_harness();
+    h.run();
+    open_machines(&mut h);
+    let lathe = h
+        .state()
+        .state
+        .machines_pane
+        .list
+        .as_ref()
+        .and_then(|l| l.iter().find(|e| e.name == "Lathe").cloned())
+        .expect("the library lists the lathe");
+    h.get_by_label(&row_label(&lathe)).click();
+    h.run_steps(2);
+    let sel = h.state().state.machines_pane.selected;
+    let picked = h.state().state.machines_pane.list.as_ref().and_then(|l| sel.and_then(|i| l.get(i)));
+    assert_eq!(picked.map(|e| e.name.as_str()), Some("Lathe"));
+    h.get_by_label("Validation: passes");
+    h.get_by_label("Axes");
+    h.get_by_label("Spindle");
+    assert_no_commands(&h);
+}
+
+#[test]
+fn a_refused_machine_file_shows_each_refusal_by_name() {
+    let text = r#"{
+      "general": { "model": "BACKWARDS MILL", "kind": "mill" },
+      "kinematics": { "default": { "units": { "length": "mm" }, "parts": [
+        { "name": "X", "type": "linear", "travel": { "min": 10.0, "max": 5.0 } },
+        { "name": "Y", "type": "linear" }, { "name": "Z", "type": "linear" }
+      ] } }
+    }"#;
+    let path = std::env::temp_dir().join(format!("camcraft_ui_machines_pane_{}.mch", std::process::id()));
+    std::fs::write(&path, text).expect("write the fixture file");
+    let mut h = blank_harness();
+    let m = camcraft_app::machine::parse_mch(text).expect("the reader takes it (it drops the travel)");
+    camcraft_app::machine::set(&h.state().state.world, &path.display().to_string(), Some(&m));
+    h.run();
+    open_machines(&mut h);
+    let bad = h
+        .state()
+        .state
+        .machines_pane
+        .list
+        .as_ref()
+        .and_then(|l| l.last().cloned())
+        .expect("the document's file is listed last");
+    assert_eq!(bad.name, "BACKWARDS MILL");
+    let label = row_label(&bad);
+    // The document's row is last, below the list's fold: scroll it in,
+    // let the scroll settle, then press it with the real pointer.
+    h.get_by_label(&label).scroll_to_me();
+    h.run_steps(10);
+    let at = h.get_by_label(&label).rect().center();
+    click(&mut h, at);
+    assert_eq!(verdict(&bad), "Validation: 1 refusal");
+    h.get_by_label("Validation: 1 refusal");
+    h.get_by_label("X travel: min 10 must be below max 5");
+    assert_no_commands(&h);
+    let _ = std::fs::remove_file(&path);
+}
+
+fn ctrl_z(h: &mut Harness<'static, ShellUi>) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: Key::Z,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+fn button_disabled(h: &Harness<'static, ShellUi>) -> bool {
+    use egui_kittest::kittest::NodeT;
+    h.get_by_label(USE_FOR_SETUP).accesskit_node().is_disabled()
+}
+
+#[test]
+fn use_for_this_setup_assigns_the_selected_machine_and_undo_restores_it() {
+    let mut h = blank_harness();
+    h.run();
+    let before = camcraft_app::machine::of(&h.state().state.world);
+    let lathe_path = camcraft_app::posting::builtin_path("Lathe");
+    assert_ne!(before.0, lathe_path, "the fixture must start on another machine");
+    open_machines(&mut h);
+    let lathe = h
+        .state()
+        .state
+        .machines_pane
+        .list
+        .as_ref()
+        .and_then(|l| l.iter().find(|e| e.name == "Lathe").cloned())
+        .expect("the library lists the lathe");
+    h.get_by_label(&row_label(&lathe)).click();
+    h.run_steps(2);
+    assert!(!button_disabled(&h), "a valid, unmounted machine can be assigned");
+    h.get_by_label(USE_FOR_SETUP).click();
+    h.run_steps(3);
+    let st = &h.state().state;
+    assert!(st.pending.is_empty(), "the queued command was drained: {:?}", st.pending);
+    assert_eq!(camcraft_app::machine::of(&st.world).0, lathe_path, "status: {}", st.status);
+    assert_eq!(camcraft_app::machine::kind_of(&st.world), camcraft_app::machine::Kind::Lathe);
+    assert!(!st.history.is_empty(), "the assignment is in the history");
+    // Now it is the setup's machine: the button says so and stays shut.
+    assert!(button_disabled(&h), "the mounted machine cannot be assigned again");
+    h.get_by_label("Cannot assign: it is already this setup's machine");
+    // Ctrl+Z puts the previous machine back exactly.
+    ctrl_z(&mut h);
+    assert_eq!(camcraft_app::machine::of(&h.state().state.world), before, "undo restores the machine");
+}
+
+#[test]
+fn a_refused_machine_cannot_be_assigned_and_names_why() {
+    let text = r#"{
+      "general": { "model": "BACKWARDS MILL", "kind": "mill" },
+      "kinematics": { "default": { "units": { "length": "mm" }, "parts": [
+        { "name": "X", "type": "linear", "travel": { "min": 10.0, "max": 5.0 } },
+        { "name": "Y", "type": "linear" }, { "name": "Z", "type": "linear" }
+      ] } }
+    }"#;
+    let path = std::env::temp_dir().join(format!("camcraft_ui_machines_assign_{}.mch", std::process::id()));
+    std::fs::write(&path, text).expect("write the fixture file");
+    let mut h = blank_harness();
+    h.run();
+    let before = camcraft_app::machine::of(&h.state().state.world);
+    open_machines(&mut h);
+    // The refused file is in the catalogue but NOT mounted, so the only
+    // thing keeping the button shut is its validation.
+    let bad = camcraft_app::machine::library::MachineEntry::from_file(&path);
+    assert!(!bad.is_valid());
+    {
+        let p = &mut h.state_mut().state.machines_pane;
+        let list = p.list.as_mut().expect("the catalogue was read");
+        list.push(bad.clone());
+        p.selected = Some(list.len() - 1);
+    }
+    h.run_steps(2);
+    assert!(button_disabled(&h), "a refused machine's button is disabled");
+    h.get_by_label("Cannot assign: fails validation - X travel: min 10 must be below max 5");
+    // Pressing the disabled button does nothing.
+    let at = h.get_by_label(USE_FOR_SETUP).rect().center();
+    click(&mut h, at);
+    assert_no_commands(&h);
+    assert_eq!(camcraft_app::machine::of(&h.state().state.world), before);
+    // Even queued directly, the command door refuses it by name.
+    h.state_mut()
+        .state
+        .pending
+        .push_back(CommandKind::UseCatalogueMachine(bad.source.clone()));
+    h.run_steps(2);
+    let st = &h.state().state;
+    assert!(st.history.is_empty(), "a refused machine never lands in the history");
+    assert!(st.status.contains("X travel: min 10 must be below max 5"), "status: {}", st.status);
+    assert_eq!(camcraft_app::machine::of(&st.world), before);
+    let _ = std::fs::remove_file(&path);
+}
+
+#[test]
+fn use_for_this_setup_replaces_an_own_machine_and_leaves_the_document_alone() {
+    let mut h = blank_harness();
+    h.run();
+    {
+        let st = &mut h.state_mut().state;
+        st.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    }
+    h.run_steps(2);
+    let s = camcraft_app::setup::active(&h.state().state.world).expect("a setup is active");
+    h.state_mut().state.pending.push_back(CommandKind::SetupOwnMachine { setup: s.clone(), own: true });
+    h.run_steps(2);
+    let world = &h.state().state.world;
+    assert!(camcraft_app::setup_mount::own_machine(world, Some(&s)).is_some(), "the setup owns its machine");
+    let doc_before = camcraft_app::machine::document_of(world);
+    let own_before = camcraft_app::machine::of(world);
+    let lathe_path = camcraft_app::posting::builtin_path("Lathe");
+    assert_ne!(own_before.0, lathe_path);
+    open_machines(&mut h);
+    let lathe = h
+        .state()
+        .state
+        .machines_pane
+        .list
+        .as_ref()
+        .and_then(|l| l.iter().find(|e| e.name == "Lathe").cloned())
+        .expect("the library lists the lathe");
+    h.get_by_label(&row_label(&lathe)).click();
+    h.run_steps(2);
+    h.get_by_label(USE_FOR_SETUP).click();
+    h.run_steps(3);
+    let st = &h.state().state;
+    assert_eq!(camcraft_app::machine::of(&st.world).0, lathe_path, "status: {}", st.status);
+    let own = camcraft_app::setup_mount::own_machine(&st.world, Some(&s)).map(|d| d.path);
+    assert_eq!(own.as_deref(), Some(lathe_path.as_str()), "the setup's own machine took the pick");
+    assert_eq!(camcraft_app::machine::document_of(&st.world), doc_before, "the document's machine is untouched");
+    assert!(button_disabled(&h));
+    ctrl_z(&mut h);
+    let world = &h.state().state.world;
+    assert_eq!(camcraft_app::machine::of(world), own_before, "undo restores the setup's machine");
+    assert_eq!(camcraft_app::machine::document_of(world), doc_before);
+}
diff --git a/crates/ui/src/egui_app/tests/mcp_live.rs b/crates/ui/src/egui_app/tests/mcp_live.rs
new file mode 100644
index 00000000..7a96380d
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/mcp_live.rs
@@ -0,0 +1,97 @@
+//! #183 in the window: an agent's `add_operation`, queued on the live MCP
+//! inbox, is answered by the shell's own frame loop against the window's
+//! document - the browser shows the operation - and the user's Ctrl+Z
+//! removes it, because the agent's step sits on the window's History.
+//! Provenance: our own tests over our own shell; no HSMWorks material.
+
+use super::*;
+use super::super::browser_tree::Leaf;
+use camcraft_app::mcp::{Inbox, Request};
+use serde_json::{Value, json};
+use std::sync::mpsc::Receiver;
+
+fn call(id: u64, name: &str, args: Value) -> String {
+    json!({ "jsonrpc": "2.0", "id": id, "method": "tools/call", "params": { "name": name, "arguments": args } })
+        .to_string()
+}
+
+/// The browser pane paints exactly these rows (they are not egui labels).
+fn has_op_row(state: &State, name: &str) -> bool {
+    let (_, leaves) = panes::browser_rows(state);
+    leaves.iter().any(|l| *l == Leaf::Op(name.to_owned()))
+}
+
+/// The answer a frame gave, as JSON; it must be a tool success.
+fn answered(rx: &Receiver<Option<String>>) -> Value {
+    let line = rx.try_recv().expect("the frame answered").expect("a reply line");
+    let v: Value = serde_json::from_str(&line).expect("json");
+    assert_eq!(v["result"]["isError"], json!(false), "{v}");
+    v
+}
+
+fn ctrl_z(harness: &mut Harness<'static, ShellUi>) {
+    harness.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    harness.input_mut().events.push(Event::Key {
+        key: Key::Z,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    harness.run_steps(2);
+}
+
+#[test]
+fn an_agents_operation_shows_in_the_browser_and_ctrl_z_removes_it() {
+    let mut harness = Harness::builder()
+        .with_size(Vec2::new(1280.0, 720.0))
+        .build_ui_state(frame, ShellUi::blank());
+    let (tx, inbox) = Inbox::channel();
+    harness.state_mut().state.mcp = Some(inbox);
+
+    let mut answers = Vec::new();
+    for line in [
+        call(1, "set_stock", json!({ "box": { "dx": 60.0, "dy": 60.0, "dz": 20.0 } })),
+        call(2, "add_tool", json!({ "catalog": "EM-0400-2FL" })),
+        call(3, "add_operation", json!({ "kind": "Face", "tool": "EM-0400-2FL" })),
+    ] {
+        let (req, rx) = Request::pair(line);
+        tx.send(req).expect("inbox open");
+        answers.push(rx);
+    }
+    // Nothing runs off the frame loop: the queue waits for a frame.
+    assert!(!has_op_row(&harness.state().state, "Face1"));
+    harness.run();
+    for rx in &answers {
+        answered(rx);
+    }
+    let st = &harness.state().state;
+    assert!(has_op_row(st, "Face1"), "the browser lists the agent's operation");
+    assert_eq!(st.status, "agent: add_operation");
+
+    // The user's own Ctrl+Z undoes the agent's last step.
+    ctrl_z(&mut harness);
+    let st = &harness.state().state;
+    assert!(!has_op_row(st, "Face1"), "Ctrl+Z removed the agent's operation");
+    assert!(st.history.can_redo());
+
+    // And the agent sees the user's undo: its own redo brings it back.
+    let (req, rx) = Request::pair(call(4, "redo", json!({})));
+    tx.send(req).expect("inbox open");
+    harness.run();
+    answered(&rx);
+    assert!(has_op_row(&harness.state().state, "Face1"));
+}
+
+#[test]
+fn the_status_strip_says_the_server_is_listening() {
+    let mut harness = Harness::builder()
+        .with_size(Vec2::new(1280.0, 720.0))
+        .build_ui_state(frame, ShellUi::blank());
+    assert!(harness.query_by_label_contains("MCP listening").is_none(), "off by default");
+    let inbox = Inbox::listen(0, Box::new(|| {})).expect("listen on loopback");
+    let addr = inbox.addr().expect("addr");
+    harness.state_mut().state.mcp = Some(inbox);
+    harness.run();
+    assert!(harness.query_by_label(&format!("MCP listening on {addr}")).is_some());
+}
diff --git a/crates/ui/src/egui_app/tests/one_wcs.rs b/crates/ui/src/egui_app/tests/one_wcs.rs
new file mode 100644
index 00000000..3410b70c
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/one_wcs.rs
@@ -0,0 +1,67 @@
+//! #342 in the browser: a setup shows ONE work coordinate system - a
+//! single row labelled plain "WCS" (the word its post writes beside it),
+//! never G54..G59 slot rows. Clicking it targets the WCS page, which
+//! edits that setup's one origin through the undoable `SetWcs`; the
+//! Setups page's word only relabels it.
+//! Provenance: our own tests over our own shell; no HSMWorks material.
+
+use super::*;
+
+fn wcs_rows(state: &State) -> Vec<(String, String)> {
+    let (rows, leaves) = panes::browser_rows(state);
+    leaves
+        .iter()
+        .enumerate()
+        .filter(|(_, l)| matches!(l, panes::Leaf::Wcs(_)))
+        .map(|(i, _)| (rows[i].label.clone(), rows[i].suffix.clone()))
+        .collect()
+}
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+#[test]
+fn the_browser_shows_one_wcs_per_setup_and_no_slot_rows() {
+    let mut state = State::new();
+    assert_eq!(wcs_rows(&state), [("WCS".to_owned(), "G54".to_owned())], "a document without setups");
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::SetSetupWorkOffset { setup: "Setup2".into(), slot: Some(1) });
+    // #343: every setup node shows its own one WCS.
+    let both = [("WCS".to_owned(), "G54".to_owned()), ("WCS".to_owned(), "G55".to_owned())];
+    assert_eq!(wcs_rows(&state), both, "Setup1's and Setup2's one WCS each");
+    let (rows, _) = panes::browser_rows(&state);
+    for slot in ["G54", "G55", "G56", "G57", "G58", "G59"] {
+        assert!(!rows.iter().any(|r| r.label == slot), "no {slot} slot row");
+    }
+    assert!(!rows.iter().any(|r| r.suffix == "not placed"), "no unplaced slot rows");
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup1".into())));
+    assert_eq!(wcs_rows(&state), both, "activation moves no row");
+}
+
+#[test]
+fn the_wcs_row_edits_the_active_setups_origin_undoably() {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::SetWcs { pos: [7.0, 0.0, 0.0], roll_deg: 0.0, pitch_deg: 0.0, yaw_deg: 0.0 });
+    assert_eq!(state.status, "WCS (G54) origin set");
+    let x = |s: &State, setup: &str| {
+        camcraft_app::setup::wcs_entity(&s.world, Some(setup))
+            .and_then(|e| model::transform_of(&s.world, &e))
+            .map(|l| l.pos.x)
+    };
+    assert_eq!(x(&state, "Setup2"), Some(7.0));
+    assert_eq!(x(&state, "Setup1"), None, "the other setup's WCS is untouched");
+    // Relabelling it moves nothing.
+    run(&mut state, CommandKind::SetSetupWorkOffset { setup: "Setup2".into(), slot: Some(3) });
+    assert_eq!(x(&state, "Setup2"), Some(7.0));
+    assert!(UiTarget::Wcs.resolves_in(&state.world));
+    run(&mut state, CommandKind::Undo);
+    run(&mut state, CommandKind::Undo);
+    assert_eq!(x(&state, "Setup2"), None, "undo removes the placement");
+    run(&mut state, CommandKind::Redo);
+    assert_eq!(x(&state, "Setup2"), Some(7.0), "redo puts it back");
+}
diff --git a/crates/ui/src/egui_app/tests/plane_face_pick.rs b/crates/ui/src/egui_app/tests/plane_face_pick.rs
new file mode 100644
index 00000000..5926ad19
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/plane_face_pick.rs
@@ -0,0 +1,110 @@
+//! #554's frame test: with the Setups page's plane row armed, a real
+//! viewport click a few pixels inside a face, right beside its edge (well
+//! within the edge-snap radius), takes the FACE - the row picks faces
+//! only. The same click with an axis row armed (#557) takes the edge,
+//! because an edge does set a direction.
+//! Provenance: our own pick law test over our own shell; no vendor
+//! material consulted.
+
+use camcraft_app::pick::InPlaneAxis;
+
+use super::*;
+
+/// A pixel 4 px inside the most camera-facing side face of the seed's
+/// 60 x 60 x 30 block, toward its centre from its top edge's midpoint.
+fn beside_an_edge(sh: &ShellUi) -> egui::Pos2 {
+    let ([x0, y0], [x1, y1]) = sh.state.viewport_rect;
+    let (w, hgt) = (x1 - x0, y1 - y0);
+    let mvp = sh.state.cam.mvp(f64::from(w / hgt));
+    let eye = sh.state.cam.eye_f32();
+    let sides = [
+        ([60.0, 30.0, 15.0], [1.0, 0.0, 0.0]),
+        ([0.0, 30.0, 15.0], [-1.0, 0.0, 0.0]),
+        ([30.0, 60.0, 15.0], [0.0, 1.0, 0.0]),
+        ([30.0, 0.0, 15.0], [0.0, -1.0, 0.0]),
+    ];
+    let px = |p: [f64; 3]| interact::project_uv(&mvp, p).map(|uv| egui::pos2(x0 + uv[0] * w, y0 + uv[1] * hgt));
+    let mut best: Option<(f32, egui::Pos2)> = None;
+    for (c, n) in sides {
+        let facing = ((f64::from(eye[0]) - c[0]) * n[0]
+            + (f64::from(eye[1]) - c[1]) * n[1]
+            + (f64::from(eye[2]) - c[2]) * n[2]) as f32;
+        let (Some(pc), Some(pm)) = (px(c), px([c[0], c[1], 30.0])) else { continue };
+        let d = pc - pm;
+        if facing <= 0.0 || d.length() < 20.0 {
+            continue;
+        }
+        let p = pm + d.normalized() * 4.0;
+        if best.is_none_or(|(bf, _)| facing > bf) {
+            best = Some((facing, p));
+        }
+    }
+    best.expect("the block shows a side face to the default camera").1
+}
+
+#[test]
+fn a_click_beside_an_edge_picks_the_face_for_the_plane_and_the_edge_for_an_axis() {
+    let mut harness = shell_harness();
+    // #664: a pick collects only while its setup page is shown.
+    harness.state_mut().state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    harness.run();
+    crate::actions::target(
+        &mut harness.state_mut().state,
+        UiTarget::SetupNode("Setup1".into(), crate::state::SetupPage::Settings),
+    );
+    harness.run();
+    let p = beside_an_edge(harness.state());
+    assert!(
+        interact::edge_nearest(&harness.state().state, [p.x, p.y], interact::PICK_EDGE_PX).is_some(),
+        "the pixel is inside the edge-snap radius - an Edge-mode click there would take the edge"
+    );
+    crate::plane_pick::arm(&mut harness.state_mut().state, "Setup1");
+    assert_eq!(harness.state().state.geo_pick, GeoPick::Face, "the plane row arms faces only");
+    click_viewport(&mut harness, p);
+    let picks = harness.state().state.plane_pick.as_ref().map(|d| d.picks.clone()).unwrap_or_default();
+    assert_eq!(picks.len(), 1, "one pick drafted: {picks:?} ({})", harness.state().state.status);
+    assert!(matches!(picks[0].feature, FeatureSel::Face(_)), "the face, not the edge: {picks:?}");
+    assert!(harness.state().state.op_ui.geo.len() <= 1, "nothing joins an operation");
+
+    // The axis row takes the edge at the same pixel.
+    crate::axis_pick::arm(&mut harness.state_mut().state, "Setup1", InPlaneAxis::Y);
+    assert!(harness.state().state.plane_pick.is_none(), "one draft collects at a time");
+    assert_eq!(harness.state().state.geo_pick, GeoPick::Edge, "an axis by edge picks edges");
+    click_viewport(&mut harness, p);
+    let d = harness.state().state.axis_pick.clone().expect("the axis draft");
+    let y = d.wanted().y.map(|a| a.picks).unwrap_or_default();
+    assert_eq!(y.len(), 1, "one edge for +Y: {y:?} ({})", harness.state().state.status);
+    assert!(matches!(y[0].feature, FeatureSel::Chain(_)), "the edge: {y:?}");
+}
+
+/// #573 hand check: on a setup page with the axes rows open and no axis
+/// armed, a real Edge-mode viewport click on the part says what to do -
+/// never "open an operation first" - and nothing is picked anywhere.
+/// Choosing "+Y by Two points" then arms vertex picking at once.
+#[test]
+fn a_stray_click_on_the_setup_page_names_the_axis_pick_and_a_mode_choice_arms() {
+    let mut harness = shell_harness();
+    harness.state_mut().state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    harness.run();
+    crate::actions::target(
+        &mut harness.state_mut().state,
+        UiTarget::SetupNode("Setup1".into(), crate::state::SetupPage::Settings),
+    );
+    harness.run();
+    assert!(harness.state().state.axis_rows_shown, "the setup page draws the axes rows");
+    harness.state_mut().state.geo_pick = GeoPick::Edge;
+    let geo_before = harness.state().state.op_ui.geo.clone();
+    let p = beside_an_edge(harness.state());
+    click_viewport(&mut harness, p);
+    let status = harness.state().state.status.clone();
+    assert!(status.contains("click Pick +Y edge or Pick +X edge first"), "{status}");
+    assert!(!status.contains("open an operation"), "{status}");
+    assert_eq!(harness.state().state.op_ui.geo, geo_before, "nothing joins an operation");
+    assert!(!crate::axis_pick::collecting(&harness.state().state));
+
+    harness.get_by_label("+Y by Two points").click();
+    harness.run();
+    assert!(crate::axis_pick::collecting(&harness.state().state), "choosing the mode arms it");
+    assert_eq!(harness.state().state.geo_pick, GeoPick::Vertex);
+    assert!(harness.query_by_label("Stop picking +Y").is_some());
+}
diff --git a/crates/ui/src/egui_app/tests/post_refusal.rs b/crates/ui/src/egui_app/tests/post_refusal.rs
new file mode 100644
index 00000000..28cc706a
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/post_refusal.rs
@@ -0,0 +1,188 @@
+//! #265 in the shell: a refused post's reason stays on screen in its own
+//! window after the status line moves on. A viewport click writes the
+//! status line, never the window. The window goes when the user closes
+//! it, a later post succeeds, or the document is switched; an edit only
+//! adds a note that the document has changed since.
+//! Provenance: our own tests over our own shell; no HSMWorks material
+//! involved.
+
+use super::*;
+
+/// The refusal window's title.
+const TITLE: &str = "Post refused";
+/// The note the window adds once the document has changed after the
+/// refusal (an edit, a regenerate).
+const CHANGED_NOTE: &str =
+    "The document has changed since this post was refused - post again to check it.";
+
+fn program_path(tag: &str) -> std::path::PathBuf {
+    std::env::temp_dir().join(format!("camcraft-refusal-{tag}-{}.nc", std::process::id()))
+}
+
+/// Post the seed as shipped. Its contour takes the full block height,
+/// and plunging that rim beside 30 mm of uncut wall is a shank hit, so
+/// the gate refuses it (the M1.7b test at the head of `tests.rs`).
+/// Returns the reason the status line gave.
+fn post_the_seed(h: &mut Harness<'static, ShellUi>, path: &std::path::Path) -> String {
+    h.state_mut()
+        .state
+        .pending
+        .push_back(CommandKind::PostProgramFile(path.to_path_buf()));
+    h.run();
+    let status = h.state().state.status.clone();
+    status
+        .strip_prefix("post refused: ")
+        .unwrap_or_else(|| panic!("the seed's post is refused (status: {status})"))
+        .to_owned()
+}
+
+/// Re-cut the seed's contour as a 0.5 mm top skim and regenerate it:
+/// legal geometry the gate posts. Both go through the command queue, so
+/// the document version moves the way a user's edit moves it.
+fn make_the_seed_postable(h: &mut Harness<'static, ShellUi>) {
+    let mut skim = {
+        let st = &h.state().state;
+        let e = model::find_by_name(&st.world, "Contour1").expect("the seed's op");
+        model::operation_of(&st.world, &e)
+            .expect("op")
+            .params
+            .clone()
+    };
+    if let OpParams::Contour { bottom_z, .. } = &mut skim {
+        *bottom_z = Height::fixed(29.5);
+    }
+    let pending = &mut h.state_mut().state.pending;
+    pending.push_back(CommandKind::EditOperationParams {
+        name: "Contour1".into(),
+        params: skim,
+    });
+    pending.push_back(CommandKind::GenerateOperation("Contour1".into()));
+    h.run();
+}
+
+#[test]
+fn a_refused_posts_reason_survives_a_viewport_click() {
+    let mut harness = shell_harness();
+    let path = program_path("click");
+    let _ = std::fs::remove_file(&path);
+    let reason = post_the_seed(&mut harness, &path);
+    harness.run();
+    assert!(
+        harness.query_by_label(TITLE).is_some(),
+        "a refused post opens its window"
+    );
+    assert!(
+        harness.query_by_label(&reason).is_some(),
+        "the window shows the gate's reason: {reason}"
+    );
+
+    // The issue's gesture: a click in the viewport. It picks (or misses)
+    // a model and writes that to the status line, as it always has.
+    let c = vp_center(harness.state());
+    click_viewport(&mut harness, c);
+    let status = harness.state().state.status.clone();
+    assert!(
+        !status.contains("post refused"),
+        "the click reached the viewport and wrote the status line (status: {status})"
+    );
+    assert!(
+        harness.query_by_label(&reason).is_some(),
+        "the reason outlives the status line: {reason}"
+    );
+    assert!(
+        harness.query_by_label(CHANGED_NOTE).is_none(),
+        "a pick is not an edit"
+    );
+    assert!(!path.exists(), "a refused post writes nothing");
+}
+
+#[test]
+fn an_edit_after_the_refusal_notes_it_and_a_successful_post_retires_it() {
+    let mut harness = shell_harness();
+    let path = program_path("retire");
+    let _ = std::fs::remove_file(&path);
+    let reason = post_the_seed(&mut harness, &path);
+
+    make_the_seed_postable(&mut harness);
+    harness.run();
+    assert!(
+        harness.query_by_label(&reason).is_some(),
+        "an edit keeps the reason on screen"
+    );
+    assert!(
+        harness.query_by_label(CHANGED_NOTE).is_some(),
+        "but says it may no longer hold"
+    );
+
+    harness
+        .state_mut()
+        .state
+        .pending
+        .push_back(CommandKind::PostProgramFile(path.clone()));
+    harness.run();
+    let st = &harness.state().state;
+    assert!(
+        st.status.starts_with("posted"),
+        "the skim posts (status: {})",
+        st.status
+    );
+    assert!(
+        st.post_refusal.is_none(),
+        "a program went out: the refusal is retired"
+    );
+    assert!(
+        harness.query_by_label(TITLE).is_none(),
+        "and its window is gone"
+    );
+    let _ = std::fs::remove_file(&path);
+}
+
+#[test]
+fn closing_the_refusal_window_retires_it() {
+    let mut harness = shell_harness();
+    let path = program_path("close");
+    post_the_seed(&mut harness, &path);
+    harness.run();
+    // egui's title-bar ✖; the refusal is the only window a refused post
+    // opens on the seed.
+    harness.get_by_label("Close window").click();
+    harness.run();
+    assert!(
+        harness.state().state.post_refusal.is_none(),
+        "the ✖ drops the refusal"
+    );
+    assert!(harness.query_by_label(TITLE).is_none(), "and its window");
+}
+
+#[test]
+fn a_new_document_retires_the_refusal() {
+    let mut harness = shell_harness();
+    let path = program_path("new");
+    post_the_seed(&mut harness, &path);
+    assert!(
+        harness.state().state.post_refusal.is_some(),
+        "the refusal is kept"
+    );
+    harness
+        .state_mut()
+        .state
+        .pending
+        .push_back(CommandKind::NewDocument);
+    // The seed is unsaved: New waits for the prompt's answer (#107).
+    harness
+        .state_mut()
+        .state
+        .pending
+        .push_back(CommandKind::ResolveUnsaved(
+            crate::unsaved::UnsavedChoice::DontSave,
+        ));
+    harness.run();
+    assert!(
+        harness.state().state.post_refusal.is_none(),
+        "a refusal is about the old document's program, never the new one's"
+    );
+    assert!(
+        harness.query_by_label(TITLE).is_none(),
+        "and its window is gone"
+    );
+}
diff --git a/crates/ui/src/egui_app/tests/program_entry.rs b/crates/ui/src/egui_app/tests/program_entry.rs
new file mode 100644
index 00000000..9e5197ef
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/program_entry.rs
@@ -0,0 +1,106 @@
+//! #155 in the browser: the operation list's menu adds a Pause / Home
+//! entry after the row it was opened on, the entry is a row of its own
+//! with its own menu (change, suppress, delete, add after), and every
+//! row queues one undoable command - Ctrl+Z puts the list back.
+//! Provenance: our own tests over our own shell; no vendor material.
+
+use super::*;
+use super::super::browser_tree::Leaf;
+use super::super::tree_entry;
+use camcraft_app::operation::AfterOperation;
+use camcraft_app::program_entry;
+use crate::state::EntryVerb;
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+fn list(state: &State) -> Vec<String> {
+    program_entry::sequence(&state.world).into_iter().map(|(n, _)| n).collect()
+}
+
+fn entry(state: &State, name: &str) -> Option<camcraft_app::schema::ProgramEntry> {
+    model::find_by_name(&state.world, name).and_then(|e| program_entry::entry_of(&state.world, &e))
+}
+
+/// The menu's add rows and an entry's own rows, by label: the structure
+/// the click test below leans on.
+#[test]
+fn the_menus_carry_the_entry_rows() {
+    let adds: Vec<&str> = tree_entry::add_lines().iter().map(|(l, _, _)| *l).collect();
+    assert_eq!(adds, ["Add pause (M0) after", "Add go home after", "Add optional stop (M1) after"]);
+    let e = camcraft_app::schema::ProgramEntry { action: AfterOperation::ProgramStop, setup: None, suppressed: false };
+    let rows: Vec<&str> = tree_entry::entry_lines(&e).iter().map(|(l, _, _)| *l).collect();
+    assert_eq!(rows[..4], ["Entry", "Does: pause (M0)", "Suppress entry", "Delete entry (undoable)"]);
+    assert!(rows.ends_with(&adds), "an entry adds after itself too: {rows:?}");
+}
+
+#[test]
+fn an_entry_is_a_row_of_the_list_and_undoes() {
+    let mut harness = shell_harness();
+    harness.run_steps(2);
+    let state = &mut harness.state_mut().state;
+    let first = list(state).first().cloned().expect("the seeded op");
+    run(state, CommandKind::ProgramEntry(EntryVerb::Add { action: AfterOperation::ProgramStop, after: Some(first.clone()) }));
+    assert_eq!(list(state), [first.clone(), "Pause1".to_owned()]);
+    let (rows, leaves) = panes::browser_rows(state);
+    let ix = leaves.iter().position(|l| *l == Leaf::Entry("Pause1".into())).expect("the entry row");
+    assert!(matches!(&leaves[ix - 1], Leaf::Op(n) if *n == first), "right under its op");
+    assert!(rows[ix].suffix.contains("Pause (M0)"), "{}", rows[ix].suffix);
+    run(state, CommandKind::ProgramEntry(EntryVerb::Suppress { name: "Pause1".into(), suppressed: true }));
+    let (rows, _) = panes::browser_rows(state);
+    assert!(rows[ix].suffix.contains("SUPPRESSED"), "{}", rows[ix].suffix);
+    run(state, CommandKind::DeleteByName("Pause1".into()));
+    assert!(entry(state, "Pause1").is_none());
+    run(state, CommandKind::Undo);
+    assert!(entry(state, "Pause1").is_some_and(|e| e.suppressed), "undo restores it as it was");
+    run(state, CommandKind::Undo);
+    run(state, CommandKind::Undo);
+    assert_eq!(list(state), [first], "undo removes the add");
+}
+
+/// The op row's menu: its first add row queues the pause after the op;
+/// then the entry row's own menu suppresses and deletes it.
+#[test]
+fn the_operation_menu_adds_an_entry_and_its_own_menu_edits_it() {
+    let mut harness = shell_harness();
+    harness.run_steps(2);
+    let (_, leaves) = panes::browser_rows(&harness.state().state);
+    let row = leaves.iter().position(|leaf| matches!(leaf, Leaf::Op(name) if name == "Contour1"))
+        .expect("operation row");
+    let row_height = theme::current().row_height;
+    let at_row = |r: usize| egui::pos2(90.0, 200.0 + (r as f32 + 0.5) * row_height);
+    let open = |harness: &mut Harness<'static, ShellUi>, r: usize| {
+        set_pos(harness, at_row(r));
+        button_at(harness, egui::PointerButton::Secondary, at_row(r), true);
+        button_at(harness, egui::PointerButton::Secondary, at_row(r), false);
+    };
+    let pick = |harness: &mut Harness<'static, ShellUi>, r: usize, k: f32| {
+        let at = egui::pos2(90.0, 200.0 + (r as f32 + 1.0) * row_height + panes::DROP_GAP + k * row_height);
+        set_pos(harness, at);
+        button_at(harness, egui::PointerButton::Primary, at, true);
+        button_at(harness, egui::PointerButton::Primary, at, false);
+        harness.run_steps(2);
+    };
+    // Operation, Rename, Copy, Paste, Clear, Delete, Suppress, After,
+    // then the add rows (#155).
+    open(&mut harness, row);
+    pick(&mut harness, row, 8.5);
+    let state = &harness.state().state;
+    assert_eq!(entry(state, "Pause1").map(|e| e.action), Some(AfterOperation::ProgramStop), "{}", state.status);
+    let (_, leaves) = panes::browser_rows(state);
+    let entry_row = leaves.iter().position(|l| *l == Leaf::Entry("Pause1".into())).expect("the entry row");
+    assert_eq!(entry_row, row + 1, "right under the op");
+
+    open(&mut harness, entry_row);
+    assert_eq!(harness.state().state.tree_menu, Some(TreeMenuTarget::Entry("Pause1".into())));
+    // Entry, Does, Suppress, Delete.
+    pick(&mut harness, entry_row, 2.5);
+    assert!(entry(&harness.state().state, "Pause1").is_some_and(|e| e.suppressed));
+    open(&mut harness, entry_row);
+    pick(&mut harness, entry_row, 3.5);
+    assert!(entry(&harness.state().state, "Pause1").is_none(), "deleted");
+    run(&mut harness.state_mut().state, CommandKind::Undo);
+    assert!(entry(&harness.state().state, "Pause1").is_some(), "Ctrl+Z restores it");
+}
diff --git a/crates/ui/src/egui_app/tests/recent_door.rs b/crates/ui/src/egui_app/tests/recent_door.rs
new file mode 100644
index 00000000..314bb662
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/recent_door.rs
@@ -0,0 +1,235 @@
+//! #662: recent projects and models on the ribbon's Open and Model
+//! buttons. A save / open / import fills the lists; with entries the
+//! button opens a list (AccessKit-labelled rows: the files by name,
+//! then "Clear recent" and "Browse…"); a click on an entry opens it
+//! through Open's own path (the unsaved prompt included); a missing
+//! file is greyed and refused by name; Clear recent empties the list;
+//! with no entries the button is the dialog, as before. The lists
+//! survive a restart through the per-user file.
+//! Provenance: our own tests over our own shell; no HSMWorks material.
+//!
+//! Gate map (M4.4): covers ui::egui_app::recent_drop, ui::state (state_recent), ui::unsaved.
+
+use std::path::PathBuf;
+
+use camcraft_app::recent::{RecentFiles, RecentKind};
+
+use super::super::recent_drop::{self, BROWSE, CLEAR, RecentRow};
+use super::*;
+use crate::unsaved::UnsavedChoice;
+
+fn click(h: &mut Harness<'static, ShellUi>, at: egui::Pos2) {
+    set_pos(h, at);
+    button_at(h, egui::PointerButton::Primary, at, true);
+    button_at(h, egui::PointerButton::Primary, at, false);
+    h.run_steps(2);
+}
+
+/// A fresh folder for one test, canonical (macOS temp is a symlink).
+fn temp_dir(tag: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("camcraft-recent-ui-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).expect("make the test folder");
+    std::fs::canonicalize(&d).expect("canonical folder")
+}
+
+fn cube_path() -> PathBuf {
+    std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models/cube.stl")
+}
+
+/// A saved copy of the seeded document at `path`, written by another
+/// State so the harness's own document stays as it is.
+fn saved_project(path: &std::path::Path) {
+    let mut other = State::new();
+    world::seed(&mut other);
+    other.save_project_path(path.to_path_buf());
+    assert!(path.is_file(), "fixture project saved: {}", other.status);
+}
+
+fn button(cmd: Cmd) -> egui::Rect {
+    let (cells, _) = mill_plan_at(1280.0);
+    cells.iter().find(|c| c.cmd == cmd).expect("the File cell stands on the bar").rect
+}
+
+fn rows(state: &State, kind: RecentKind) -> Vec<(RecentRow, egui::Rect)> {
+    let cmd = if kind == RecentKind::Project { Cmd::Project } else { Cmd::Model };
+    let strip =
+        egui::Rect::from_min_size(egui::Pos2::ZERO, Vec2::new(1280.0, super::super::shell::RIBBON_H));
+    recent_drop::rows_of(state, kind, button(cmd), strip, &theme::current())
+}
+
+fn row_rect(state: &State, kind: RecentKind, label: &str) -> egui::Rect {
+    rows(state, kind)
+        .into_iter()
+        .find(|(r, _)| r.label() == label)
+        .unwrap_or_else(|| panic!("the list has a '{label}' row"))
+        .1
+}
+
+#[test]
+fn the_door_lists_entries_then_clear_and_browse_with_accesskit_labels() {
+    let d = temp_dir("structural");
+    let (a, b) = (d.join("a.camproj"), d.join("b.camproj"));
+    saved_project(&a);
+    saved_project(&b);
+    let mut h = shell_harness();
+    {
+        let st = &mut h.state_mut().state;
+        st.recent.add(RecentKind::Project, &a);
+        st.recent.add(RecentKind::Project, &b);
+        st.recent.add(RecentKind::Project, &d.join("gone.camproj"));
+    }
+    h.run();
+    assert!(h.query_by_label(CLEAR).is_none(), "the list is closed until pressed");
+    click(&mut h, button(Cmd::Project).center());
+    assert_eq!(h.state().state.ribbon_recent_open, Some(RecentKind::Project));
+    let labels: Vec<String> = rows(&h.state().state, RecentKind::Project).iter().map(|(r, _)| r.label()).collect();
+    assert_eq!(labels, ["gone.camproj (missing)", "b.camproj", "a.camproj", CLEAR, BROWSE], "newest first");
+    for label in &labels {
+        h.get_by_label(label);
+    }
+    // The Model list is its own, and empty.
+    assert!(h.state().state.recent.list(RecentKind::Model).is_empty());
+}
+
+#[test]
+fn a_click_on_an_entry_opens_it_through_open() {
+    let d = temp_dir("open");
+    let path = d.join("job.camproj");
+    let mut h = shell_harness();
+    // Saving fills the list (Save / Save As are noted) and leaves the
+    // document clean, so the open needs no prompt.
+    h.state_mut().state.pending.push_back(CommandKind::SaveProjectFile(path.clone()));
+    h.run_steps(2);
+    assert_eq!(h.state().state.recent.list(RecentKind::Project), std::slice::from_ref(&path));
+    h.state_mut().state.pending.push_back(CommandKind::NewDocument);
+    h.run_steps(2);
+    assert_eq!(h.state().state.project_path, None);
+    click(&mut h, button(Cmd::Project).center());
+    let at = row_rect(&h.state().state, RecentKind::Project, "job.camproj").center();
+    click(&mut h, at);
+    h.run_steps(2);
+    let st = &h.state().state;
+    assert_eq!(st.ribbon_recent_open, None, "a choice closes the list");
+    assert_eq!(st.project_path.as_deref(), Some(path.as_path()), "status: {}", st.status);
+    assert!(st.status.starts_with("opened"), "{}", st.status);
+    assert!(model::find_by_name(&st.world, "Block").is_some(), "the saved document came back");
+}
+
+#[test]
+fn a_recent_project_over_unsaved_changes_takes_opens_prompt() {
+    let d = temp_dir("unsaved");
+    let path = d.join("other.camproj");
+    saved_project(&path);
+    let mut h = shell_harness();
+    assert!(h.state().state.history.is_dirty(), "the seed is unsaved work");
+    h.state_mut().state.recent.add(RecentKind::Project, &path);
+    click(&mut h, button(Cmd::Project).center());
+    let at = row_rect(&h.state().state, RecentKind::Project, "other.camproj").center();
+    click(&mut h, at);
+    assert!(h.state().state.unsaved_prompt.is_some(), "the open is held for the prompt");
+    h.get_by_label("Unsaved changes");
+    crate::actions::resolve_unsaved(&mut h.state_mut().state, UnsavedChoice::DontSave);
+    h.run_steps(2);
+    assert_eq!(h.state().state.project_path.as_deref(), Some(path.as_path()));
+}
+
+#[test]
+fn a_missing_entry_is_refused_by_name() {
+    let d = temp_dir("missing");
+    let gone = d.join("gone.camproj");
+    let mut h = shell_harness();
+    h.state_mut().state.recent.add(RecentKind::Project, &gone);
+    let dirty = h.state().state.history.is_dirty();
+    click(&mut h, button(Cmd::Project).center());
+    h.get_by_label("gone.camproj (missing)");
+    let at = row_rect(&h.state().state, RecentKind::Project, "gone.camproj (missing)").center();
+    click(&mut h, at);
+    h.run_steps(2);
+    let st = &h.state().state;
+    assert!(st.status.contains("gone.camproj is missing"), "refused by name: {}", st.status);
+    assert!(st.unsaved_prompt.is_none(), "a missing file asks nothing");
+    assert_eq!(st.project_path, None, "nothing opened");
+    assert_eq!(st.history.is_dirty(), dirty, "the document is untouched");
+    assert!(model::find_by_name(&st.world, "Block").is_some());
+    // The same refusal holds for a queued command (the file went
+    // between the frame that drew it and the click).
+    h.state_mut().state.pending.push_back(CommandKind::OpenRecent(RecentKind::Model, d.join("gone.stl")));
+    h.run_steps(2);
+    assert!(h.state().state.status.contains("gone.stl is missing"), "{}", h.state().state.status);
+}
+
+#[test]
+fn clear_recent_empties_the_list() {
+    let mut h = shell_harness();
+    h.state_mut().state.recent.add(RecentKind::Model, &cube_path());
+    click(&mut h, button(Cmd::Model).center());
+    assert_eq!(h.state().state.ribbon_recent_open, Some(RecentKind::Model));
+    let at = row_rect(&h.state().state, RecentKind::Model, CLEAR).center();
+    click(&mut h, at);
+    h.run_steps(2);
+    let st = &h.state().state;
+    assert!(st.recent.list(RecentKind::Model).is_empty(), "Clear recent empties it");
+    assert_eq!(st.ribbon_recent_open, None);
+    assert!(h.query_by_label(CLEAR).is_none(), "the list is gone");
+}
+
+#[test]
+fn a_recent_model_imports_through_the_worker_and_is_noted() {
+    let d = temp_dir("model");
+    let copy = d.join("bracket.stl");
+    std::fs::copy(cube_path(), &copy).expect("copy the cube fixture");
+    let mut h = shell_harness();
+    h.state_mut().state.recent.add(RecentKind::Model, &copy);
+    h.state_mut().state.recent.add(RecentKind::Model, &cube_path());
+    click(&mut h, button(Cmd::Model).center());
+    let at = row_rect(&h.state().state, RecentKind::Model, "bracket.stl").center();
+    click(&mut h, at);
+    h.state_mut().state.settle();
+    h.run_steps(2);
+    let st = &h.state().state;
+    assert!(model::find_by_name(&st.world, "bracket").is_some(), "status: {}", st.status);
+    assert_eq!(st.recent.list(RecentKind::Model).first(), Some(&copy), "the import moved it to the top");
+}
+
+#[test]
+fn an_empty_list_and_browse_open_todays_dialog() {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(1280.0, 720.0))
+        .build_ui_state(frame_undrained, ShellUi::seeded());
+    h.run();
+    click(&mut h, button(Cmd::Project).center());
+    let queued = |h: &Harness<'static, ShellUi>| {
+        h.state().state.pending.iter().any(|c| matches!(c, CommandKind::OpenProjectDialog))
+    };
+    assert!(queued(&h), "no recents: the button is the dialog, as before");
+    assert_eq!(h.state().state.ribbon_recent_open, None);
+    h.state_mut().state.pending.clear();
+    h.state_mut().state.recent.add(RecentKind::Project, &cube_path());
+    click(&mut h, button(Cmd::Project).center());
+    assert!(!queued(&h), "with recents the button opens its list");
+    let at = row_rect(&h.state().state, RecentKind::Project, BROWSE).center();
+    click(&mut h, at);
+    assert!(queued(&h), "Browse… opens the dialog");
+    h.state_mut().state.pending.clear();
+}
+
+#[test]
+fn the_lists_survive_a_restart_and_a_corrupt_file_starts_empty() {
+    let d = temp_dir("restart");
+    let file = d.join("recent.json");
+    let project = d.join("kept.camproj");
+    let mut first = State::new();
+    world::seed(&mut first);
+    first.load_recent_from(file.clone());
+    first.save_project_path(project.clone());
+    // A "restart": a new State reading the same file.
+    let mut second = State::new();
+    second.load_recent_from(file.clone());
+    assert_eq!(second.recent.list(RecentKind::Project), &[project]);
+    std::fs::write(&file, "{ not json").expect("corrupt the file");
+    let mut third = State::new();
+    third.load_recent_from(file);
+    assert_eq!(third.recent, RecentFiles::default(), "a corrupt file starts empty");
+    assert!(third.status.contains("starting empty"), "and says so: {}", third.status);
+}
diff --git a/crates/ui/src/egui_app/tests/setup_picks_disarm.rs b/crates/ui/src/egui_app/tests/setup_picks_disarm.rs
new file mode 100644
index 00000000..14d03fc6
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/setup_picks_disarm.rs
@@ -0,0 +1,318 @@
+//! #664's frame tests: a Setups page pick (an axis by Edge, an axis by
+//! Two points, the lay-on-a-plane face) armed on the setup page stops
+//! collecting the moment its page is left. A real viewport click on the
+//! operation page then fills the open operation's geometry, never the
+//! hidden setup draft; back on the setup page the pick shows disarmed,
+//! its picked item kept. #667 adds the same law for a Properties pane
+//! closed, or hidden behind another tab: the shell's per-frame sweep.
+//! Provenance: our own page law test over our own shell; no vendor
+//! material consulted.
+
+use super::*;
+
+/// A pixel 4 px inside the most camera-facing side face of the seed's
+/// block, beside its top edge (within the edge-snap radius).
+fn beside_an_edge(sh: &ShellUi) -> egui::Pos2 {
+    let ([x0, y0], [x1, y1]) = sh.state.viewport_rect;
+    let (w, hgt) = (x1 - x0, y1 - y0);
+    let mvp = sh.state.cam.mvp(f64::from(w / hgt));
+    let eye = sh.state.cam.eye_f32();
+    let sides = [
+        ([60.0, 30.0, 15.0], [1.0, 0.0, 0.0]),
+        ([0.0, 30.0, 15.0], [-1.0, 0.0, 0.0]),
+        ([30.0, 60.0, 15.0], [0.0, 1.0, 0.0]),
+        ([30.0, 0.0, 15.0], [0.0, -1.0, 0.0]),
+    ];
+    let px = |p: [f64; 3]| interact::project_uv(&mvp, p).map(|uv| egui::pos2(x0 + uv[0] * w, y0 + uv[1] * hgt));
+    let mut best: Option<(f32, egui::Pos2)> = None;
+    for (c, n) in sides {
+        let facing = ((f64::from(eye[0]) - c[0]) * n[0]
+            + (f64::from(eye[1]) - c[1]) * n[1]
+            + (f64::from(eye[2]) - c[2]) * n[2]) as f32;
+        let (Some(pc), Some(pm)) = (px(c), px([c[0], c[1], 30.0])) else { continue };
+        let d = pc - pm;
+        if facing <= 0.0 || d.length() < 20.0 {
+            continue;
+        }
+        let p = pm + d.normalized() * 4.0;
+        if best.is_none_or(|(bf, _)| facing > bf) {
+            best = Some((facing, p));
+        }
+    }
+    best.expect("the block shows a side face to the default camera").1
+}
+
+/// The block's corner nearest the eye, inside the pane.
+fn a_corner(sh: &ShellUi) -> egui::Pos2 {
+    let ([x0, y0], [x1, y1]) = sh.state.viewport_rect;
+    let (w, hgt) = (x1 - x0, y1 - y0);
+    let mvp = sh.state.cam.mvp(f64::from(w / hgt));
+    let eye = sh.state.cam.eye();
+    let mut best: Option<(f64, egui::Pos2)> = None;
+    for x in [0.0, 60.0] {
+        for y in [0.0, 60.0] {
+            for z in [0.0, 30.0] {
+                let c = [x, y, z];
+                let Some(uv) = interact::project_uv(&mvp, c) else { continue };
+                if !(uv[0] > 0.05 && uv[0] < 0.95 && uv[1] > 0.05 && uv[1] < 0.95) {
+                    continue;
+                }
+                let d = (c[0] - eye[0]).powi(2) + (c[1] - eye[1]).powi(2) + (c[2] - eye[2]).powi(2);
+                if best.is_none_or(|(bd, _)| d < bd) {
+                    best = Some((d, egui::pos2(x0 + uv[0] * w, y0 + uv[1] * hgt)));
+                }
+            }
+        }
+    }
+    best.expect("the block shows a corner to the default camera").1
+}
+
+/// The seeded shell with Setup1 made and its setup page shown.
+fn on_setup_page() -> Harness<'static, ShellUi> {
+    let mut harness = shell_harness();
+    harness.state_mut().state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    harness.run();
+    show_setup_page(&mut harness);
+    harness
+}
+
+fn show_setup_page(harness: &mut Harness<'static, ShellUi>) {
+    crate::actions::target(
+        &mut harness.state_mut().state,
+        UiTarget::SetupNode("Setup1".into(), crate::state::SetupPage::Settings),
+    );
+    harness.run();
+    assert!(harness.state().state.axis_rows_shown, "the setup page draws the pick rows");
+}
+
+/// Leave for Contour1's page, click `p` there: the operation's geometry
+/// takes the pick. Returns the operation's picks.
+fn click_on_operation_page(harness: &mut Harness<'static, ShellUi>, p: egui::Pos2) -> Vec<camcraft_app::operation::GeoSel> {
+    crate::actions::target(&mut harness.state_mut().state, UiTarget::Operation("Contour1".into()));
+    harness.run();
+    assert!(!crate::axis_pick::collecting(&harness.state().state), "leaving the page disarms the axis pick");
+    assert!(!crate::plane_pick::collecting(&harness.state().state), "leaving the page disarms the plane pick");
+    click_viewport(harness, p);
+    let st = &harness.state().state;
+    assert_eq!(st.status, "geometry selection updated for Contour1", "the open operation takes the click");
+    let op = model::find_by_name(&st.world, "Contour1").expect("seed has Contour1");
+    match model::operation_of(&st.world, &op).map(|o| o.src) {
+        Some(SrcRef::Selection(items)) => items,
+        other => panic!("Contour1's source became {other:?}"),
+    }
+}
+
+fn axis_y_picks(sh: &ShellUi) -> Vec<camcraft_app::operation::GeoSel> {
+    sh.state.axis_pick.as_ref().and_then(|d| d.axes.y.clone()).map(|a| a.picks).unwrap_or_default()
+}
+
+#[test]
+fn an_axis_edge_pick_disarms_when_its_page_is_left() {
+    let mut harness = on_setup_page();
+    harness.get_by_label("+Y by Edge").click();
+    harness.run();
+    assert!(crate::axis_pick::collecting(&harness.state().state), "choosing the mode arms it");
+    let p = beside_an_edge(harness.state());
+    click_viewport(&mut harness, p);
+    let drafted = axis_y_picks(harness.state());
+    assert_eq!(drafted.len(), 1, "the setup draft takes the edge: {}", harness.state().state.status);
+
+    let items = click_on_operation_page(&mut harness, p);
+    assert_eq!(items.len(), 1);
+    assert!(matches!(items[0].feature, FeatureSel::Chain(_)), "an edge joins Contour1: {items:?}");
+    assert_eq!(axis_y_picks(harness.state()), drafted, "the hidden draft is untouched");
+
+    show_setup_page(&mut harness);
+    assert!(!crate::axis_pick::collecting(&harness.state().state), "back on the page, disarmed");
+    assert!(harness.query_by_label("Pick +Y edge").is_some(), "the row offers to pick again");
+    assert!(harness.query_by_label("Stop picking +Y").is_none());
+    assert_eq!(axis_y_picks(harness.state()), drafted, "the picked edge is kept");
+}
+
+#[test]
+fn an_axis_two_points_pick_disarms_when_its_page_is_left() {
+    let mut harness = on_setup_page();
+    harness.get_by_label("+Y by Two points").click();
+    harness.run();
+    assert_eq!(harness.state().state.geo_pick, GeoPick::Vertex);
+    let p = a_corner(harness.state());
+    click_viewport(&mut harness, p);
+    let drafted = axis_y_picks(harness.state());
+    assert_eq!(drafted.len(), 1, "the setup draft takes the point: {}", harness.state().state.status);
+
+    let items = click_on_operation_page(&mut harness, p);
+    assert_eq!(items.len(), 1);
+    assert!(matches!(items[0].feature, FeatureSel::Vertex(_)), "the corner joins Contour1: {items:?}");
+    assert_eq!(axis_y_picks(harness.state()), drafted, "the hidden draft keeps one point, not two");
+
+    show_setup_page(&mut harness);
+    assert!(!crate::axis_pick::collecting(&harness.state().state), "back on the page, disarmed");
+    assert!(harness.query_by_label("Pick +Y points").is_some(), "the row offers to pick again");
+    assert_eq!(axis_y_picks(harness.state()), drafted, "the picked point is kept");
+}
+
+#[test]
+fn a_plane_face_pick_disarms_when_its_page_is_left() {
+    let mut harness = on_setup_page();
+    harness.get_by_label("Pick a face").click();
+    harness.run();
+    assert!(crate::plane_pick::collecting(&harness.state().state), "the plane row arms");
+    let p = beside_an_edge(harness.state());
+    click_viewport(&mut harness, p);
+    let drafted = harness.state().state.plane_pick.as_ref().map(|d| d.picks.clone()).unwrap_or_default();
+    assert_eq!(drafted.len(), 1, "the setup draft takes the face: {}", harness.state().state.status);
+    let face = drafted[0].clone();
+
+    // The same pixel on the operation page: the face goes to Contour1.
+    let items = click_on_operation_page(&mut harness, p);
+    assert_eq!(items.len(), 1);
+    assert_eq!(items[0], face, "the face joins Contour1, not the hidden plane draft");
+    let kept = harness.state().state.plane_pick.clone().expect("the paused draft is kept");
+    assert!(!kept.picking);
+    assert_eq!(kept.picks, drafted, "the hidden draft is untouched");
+
+    show_setup_page(&mut harness);
+    assert!(!crate::plane_pick::collecting(&harness.state().state), "back on the page, disarmed");
+    assert!(harness.query_by_label("Stop picking").is_none(), "the row is not collecting");
+    assert!(harness.query_by_label("Pick a face").is_some(), "the row offers to pick again");
+    let kept = harness.state().state.plane_pick.as_ref().map(|d| d.picks.clone()).unwrap_or_default();
+    assert_eq!(kept, drafted, "the picked face is kept");
+
+    // Re-arming resumes the same draft with its face.
+    harness.get_by_label("Pick a face").click();
+    harness.run();
+    assert!(crate::plane_pick::collecting(&harness.state().state));
+    let resumed = harness.state().state.plane_pick.as_ref().map(|d| d.picks.clone()).unwrap_or_default();
+    assert_eq!(resumed, drafted, "re-arming keeps the pick");
+}
+
+// ------------------------------------------------------------- #667
+// The sweep runs every frame from the shell, whatever the dock shows:
+// a Properties pane closed, or behind another tab in its leaf, disarms
+// its picks before the viewport can route a click into them.
+
+/// Press the ribbon's View door, then its `panel` row - the user's way
+/// to close or reopen a pane.
+fn view_door_toggle(harness: &mut Harness<'static, ShellUi>, panel: crate::state::Panel) {
+    let strip = egui::Rect::from_min_size(egui::Pos2::ZERO, Vec2::new(1280.0, super::super::shell::RIBBON_H));
+    let (cells, _) = mill_plan_at(1280.0);
+    let button = cells.iter().find(|c| c.cmd == Cmd::View).expect("the View door stands on the bar").rect;
+    let rows = panes::view_rows_of(button, strip, &theme::current());
+    let at = rows
+        .iter()
+        .find(|(r, _)| *r == super::super::layout::ViewRow::Panel(panel))
+        .expect("the View door lists the panel")
+        .1
+        .center();
+    super::machines_pane::click(harness, button.center());
+    super::machines_pane::click(harness, at);
+}
+
+fn properties_shown(harness: &Harness<'static, ShellUi>) -> bool {
+    super::super::layout::is_shown(&harness.state().dock, &Tab::Properties)
+}
+
+#[test]
+fn an_axis_pick_disarms_when_the_properties_tab_is_closed() {
+    let mut harness = on_setup_page();
+    harness.get_by_label("+Y by Edge").click();
+    harness.run();
+    let p = beside_an_edge(harness.state());
+    click_viewport(&mut harness, p);
+    let drafted = axis_y_picks(harness.state());
+    assert_eq!(drafted.len(), 1, "the setup draft takes the edge: {}", harness.state().state.status);
+    assert!(crate::axis_pick::collecting(&harness.state().state), "still armed for another pick");
+
+    view_door_toggle(&mut harness, crate::state::Panel::Properties);
+    assert!(!super::super::layout::is_open(&harness.state().dock, &Tab::Properties), "the pane closed");
+    assert!(!crate::axis_pick::collecting(&harness.state().state), "a closed pane disarms its pick");
+    assert!(!harness.state().state.axis_rows_shown, "the rows are off screen");
+    click_viewport(&mut harness, p);
+    assert_eq!(axis_y_picks(harness.state()), drafted, "the click never reaches the hidden draft");
+    assert!(!harness.state().state.status.contains("+Y"), "{}", harness.state().state.status);
+
+    view_door_toggle(&mut harness, crate::state::Panel::Properties);
+    assert!(properties_shown(&harness), "the pane reopened");
+    assert!(!crate::axis_pick::collecting(&harness.state().state), "reopened, disarmed");
+    assert!(harness.query_by_label("Pick +Y edge").is_some(), "the row offers to pick again");
+    assert!(harness.query_by_label("Stop picking +Y").is_none());
+    assert_eq!(axis_y_picks(harness.state()), drafted, "the picked edge is kept");
+}
+
+#[test]
+fn a_plane_pick_disarms_when_another_tab_hides_the_properties_pane() {
+    let mut harness = on_setup_page();
+    // The Machines pane lists no user folder - never the tester's own.
+    harness.state_mut().state.machines_pane.user_dir = Some(None);
+    harness.get_by_label("Pick a face").click();
+    harness.run();
+    let p = beside_an_edge(harness.state());
+    click_viewport(&mut harness, p);
+    let drafted = harness.state().state.plane_pick.as_ref().map(|d| d.picks.clone()).unwrap_or_default();
+    assert_eq!(drafted.len(), 1, "the setup draft takes the face: {}", harness.state().state.status);
+    assert!(crate::plane_pick::collecting(&harness.state().state));
+
+    // The Machines pane opens as the front tab of the properties leaf.
+    view_door_toggle(&mut harness, crate::state::Panel::Machines);
+    assert!(super::super::layout::is_open(&harness.state().dock, &Tab::Properties), "still in the dock");
+    assert!(!properties_shown(&harness), "behind the Machines tab");
+    assert!(!crate::plane_pick::collecting(&harness.state().state), "a hidden pane disarms its pick");
+    click_viewport(&mut harness, p);
+    let now = harness.state().state.plane_pick.clone().expect("the paused draft is kept");
+    assert!(!now.picking);
+    assert_eq!(now.picks, drafted, "the click never reaches the hidden draft");
+
+    // Closing the Machines tab brings the properties pane to the front.
+    view_door_toggle(&mut harness, crate::state::Panel::Machines);
+    assert!(properties_shown(&harness), "the pane is in front again");
+    assert!(!crate::plane_pick::collecting(&harness.state().state), "in front again, disarmed");
+    assert!(harness.query_by_label("Stop picking").is_none(), "the row is not collecting");
+    assert!(harness.query_by_label("Pick a face").is_some(), "the row offers to pick again");
+    let kept = harness.state().state.plane_pick.as_ref().map(|d| d.picks.clone()).unwrap_or_default();
+    assert_eq!(kept, drafted, "the picked face is kept");
+}
+
+/// The pre-dock half of the sweep: the pane is hidden in the SAME frame
+/// a click reaches the viewport. The View door's ask settles before the
+/// dock draws, and the viewport routes its click inside the dock, before
+/// the after-dock sweep runs - so only the before-dock disarm keeps the
+/// click off the hidden draft. The press lands a frame earlier (the pick
+/// fires on release), and the Machines tab hides the pane without moving
+/// the viewport, so the pixel still lands on the same corner. Two points
+/// mode, so a leaked click would show: a second point joins the draft.
+#[test]
+fn a_click_in_the_frame_the_pane_hides_misses_the_hidden_draft() {
+    let mut harness = on_setup_page();
+    harness.state_mut().state.machines_pane.user_dir = Some(None);
+    harness.get_by_label("+Y by Two points").click();
+    harness.run();
+    let p = a_corner(harness.state());
+    click_viewport(&mut harness, p);
+    let drafted = axis_y_picks(harness.state());
+    assert_eq!(drafted.len(), 1, "the setup draft takes the point: {}", harness.state().state.status);
+    assert!(crate::axis_pick::collecting(&harness.state().state), "still armed for another pick");
+
+    set_pos(&mut harness, p);
+    button_at(&mut harness, egui::PointerButton::Primary, p, true);
+    assert!(properties_shown(&harness), "the pane still shows at the press");
+    assert!(crate::axis_pick::collecting(&harness.state().state), "armed at the press");
+
+    // One frame: the View door's ask (the Machines tab to the front of
+    // the properties leaf) and the release that completes the click.
+    harness.state_mut().state.layout_request =
+        Some(crate::state::LayoutRequest::Toggle(crate::state::Panel::Machines));
+    harness.state_mut().state.status.clear();
+    harness.input_mut().events.push(Event::PointerButton {
+        pos: p,
+        button: egui::PointerButton::Primary,
+        pressed: false,
+        modifiers: Modifiers::NONE,
+    });
+    harness.step();
+    assert!(!properties_shown(&harness), "the pane hid this frame");
+    assert!(!crate::axis_pick::collecting(&harness.state().state), "hidden, disarmed");
+    assert_eq!(axis_y_picks(harness.state()), drafted, "the click never reaches the hidden draft: one point, not two");
+    assert!(!harness.state().state.status.contains("+Y"), "{}", harness.state().state.status);
+    harness.run();
+    assert_eq!(axis_y_picks(harness.state()), drafted, "nor in the frames after");
+}
diff --git a/crates/ui/src/egui_app/tests/setup_tree.rs b/crates/ui/src/egui_app/tests/setup_tree.rs
new file mode 100644
index 00000000..bacd0f15
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/setup_tree.rs
@@ -0,0 +1,166 @@
+//! #343 in the browser: each setup is a node with a radio (the active
+//! setup) and its own WCS, Stock, Machine, Post, Fixtures (each fixture a
+//! child), Tool list and Operations; a document without setups shows the
+//! same children for its implicit setup. The radio activates undoably;
+//! each node opens its page - activating its setup first, so no editor
+//! ever edits a setup the node does not belong to; the machine and post
+//! verbs land on the active setup's own mount when it has one.
+//! Provenance: our own tests over our own shell; no HSMWorks material.
+
+use super::*;
+use crate::state::SetupPage;
+use camcraft_app::posting;
+use camcraft_app::schema::PostRef;
+use super::super::browser_pane;
+use super::super::browser_tree::Leaf;
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+/// (label, depth, leaf) for every row.
+fn tree(state: &State) -> Vec<(String, usize, Leaf)> {
+    let (rows, leaves) = panes::browser_rows(state);
+    rows.iter().zip(leaves).map(|(r, l)| (r.label.clone(), r.depth, l)).collect()
+}
+
+/// The labels of `setup`'s children, in order, from its node to the next
+/// row at its own depth.
+fn children(state: &State, setup: &str) -> Vec<String> {
+    let rows = tree(state);
+    let Some(at) = rows.iter().position(|(_, _, l)| *l == Leaf::Setup(setup.to_owned())) else {
+        return Vec::new();
+    };
+    let depth = rows[at].1;
+    rows[at + 1..].iter().take_while(|(_, d, _)| *d > depth).filter(|(_, d, _)| *d == depth + 1).map(|(n, _, _)| n.clone()).collect()
+}
+
+const NODES: [&str; 7] = ["WCS", "Stock", "Machine", "Post", "Fixtures", "Tool list", "Operations"];
+
+#[test]
+fn every_setup_owns_its_nodes_in_order() {
+    let mut state = State::new();
+    // No setups: the implicit setup's nodes stand straight under Setup.
+    let rows = tree(&state);
+    let flat: Vec<&str> = rows.iter().filter(|(_, d, _)| *d == 1).map(|(n, _, _)| n.as_str()).collect();
+    assert_eq!(&flat[..9], ["Setups", "WCS", "Stock", "Machine", "Post", "Fixtures", "Tool list", "Operations", "(no models yet)"]);
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    for s in ["Setup1", "Setup2"] {
+        assert_eq!(children(&state, s), NODES, "{s}'s nodes");
+    }
+    let (rows, leaves) = panes::browser_rows(&state);
+    let node = |s: &str| leaves.iter().position(|l| *l == Leaf::Setup(s.to_owned())).expect("setup node");
+    assert_eq!(rows[node("Setup2")].kind, painted::Kind::Setup(true), "the last created is active");
+    assert_eq!(rows[node("Setup1")].kind, painted::Kind::Setup(false));
+    assert!(!rows.iter().any(|r| r.label == "Operations" && r.depth == 0), "no document-wide Operations section");
+}
+
+#[test]
+fn operations_and_fixtures_sit_under_their_own_setup() {
+    let mut shell = ShellUi::seeded();
+    let state = &mut shell.state;
+    run(state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(state, CommandKind::CreateSetup { name: None, datum_from: None });
+    let source = model::find_by_name(&state.world, "Contour1").expect("seed op");
+    let def = model::operation_of(&state.world, &source).expect("definition");
+    run(state, CommandKind::CreateOperation { name: "Contour2".into(), tool: def.tool, src: def.src, params: def.params });
+    let rows = tree(state);
+    let op = |n: &str| rows.iter().position(|(_, _, l)| *l == Leaf::Op(n.to_owned())).expect("op row");
+    let node = |s: &str| rows.iter().position(|(_, _, l)| *l == Leaf::Setup(s.to_owned())).expect("node");
+    assert!(node("Setup1") < op("Contour1") && op("Contour1") < node("Setup2"), "Contour1 is Setup1's");
+    assert!(op("Contour2") > node("Setup2"), "Contour2 joined the active Setup2");
+    assert_eq!(rows[op("Contour1")].1, 3, "setup / Operations / op");
+    // Setup1's tool list counts the seed's tool.
+    let (r, l) = panes::browser_rows(state);
+    let tools = l.iter().position(|x| *x == Leaf::Page("Setup1".into(), SetupPage::Tools)).expect("tool list");
+    assert_eq!(r[tools].suffix, "1 tool");
+}
+
+#[test]
+fn the_radio_activates_a_setup_undoably() {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup2"));
+    browser_pane::focus(&mut state, "Setup1");
+    state.drain_actions();
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup1"));
+    browser_pane::focus(&mut state, "Setup1");
+    assert!(state.pending.is_empty(), "the active setup's radio queues nothing");
+    run(&mut state, CommandKind::Undo);
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup2"), "undo restores");
+}
+
+#[test]
+fn each_node_opens_its_page_and_activates_its_setup_first() {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    for (leaf, want) in [
+        (Leaf::Wcs("Setup1".into()), UiTarget::Wcs),
+        (Leaf::Stock("Setup1".into()), UiTarget::Stock),
+        (Leaf::Page("Setup1".into(), SetupPage::Machine), UiTarget::SetupNode("Setup1".into(), SetupPage::Machine)),
+        (Leaf::Page("Setup1".into(), SetupPage::Post), UiTarget::SetupNode("Setup1".into(), SetupPage::Post)),
+        (Leaf::Page("Setup1".into(), SetupPage::Fixtures), UiTarget::SetupNode("Setup1".into(), SetupPage::Fixtures)),
+        (Leaf::Page("Setup1".into(), SetupPage::Tools), UiTarget::SetupNode("Setup1".into(), SetupPage::Tools)),
+    ] {
+        run(&mut state, CommandKind::ActivateSetup(Some("Setup2".into())));
+        browser_pane::click(&mut state, leaf.clone());
+        state.drain_actions();
+        assert_eq!(state.pane_target(), want, "{leaf:?}");
+        assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup1"), "{leaf:?} activates Setup1");
+    }
+    // The setup row opens its settings and activates nothing.
+    browser_pane::click(&mut state, Leaf::Setup("Setup2".into()));
+    state.drain_actions();
+    assert_eq!(state.pane_target(), UiTarget::SetupNode("Setup2".into(), SetupPage::Settings));
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup1"));
+}
+
+#[test]
+fn the_machine_and_post_pages_render_for_a_setup() {
+    let mut harness = shell_harness();
+    harness.state_mut().state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    harness.run_steps(2);
+    for (page, heading) in [
+        (SetupPage::Machine, "Machine - Setup1"),
+        (SetupPage::Post, "Post - Setup1"),
+        (SetupPage::Fixtures, "Fixtures - Setup1"),
+        (SetupPage::Tools, "Tool list - Setup1"),
+        (SetupPage::Settings, "Setup1"),
+    ] {
+        crate::actions::target(&mut harness.state_mut().state, UiTarget::SetupNode("Setup1".into(), page));
+        harness.run_steps(2);
+        assert!(harness.query_by_label(heading).is_some(), "{heading}");
+    }
+    assert!(harness.query_by_label_contains("This setup has its own post").is_none(), "settings page shows no mount radio");
+}
+
+#[test]
+fn machine_and_post_verbs_land_on_the_active_setups_own_mount() {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    // Setup2 (active) takes its own post: the post verbs now edit only it.
+    run(&mut state, CommandKind::SetupOwnPost { setup: "Setup2".into(), own: true });
+    assert_eq!(camcraft_app::setup_mount::own_post(&state.world, Some("Setup2")), Some(PostRef::Builtin));
+    run(&mut state, CommandKind::SelectPostNamed("Haas".into()));
+    assert_eq!(camcraft_app::setup_mount::own_post(&state.world, Some("Setup2")), Some(PostRef::Named("Haas".into())));
+    assert_eq!(posting::document_post_of(&state.world), PostRef::Builtin, "the document's post is untouched");
+    assert_eq!(camcraft_app::setup_mount::post_of(&state.world, Some("Setup1")), PostRef::Builtin);
+    // The machine verbs the same way.
+    run(&mut state, CommandKind::SetupOwnMachine { setup: "Setup2".into(), own: true });
+    run(&mut state, CommandKind::LoadBuiltinMachine("Lathe".into()));
+    assert_eq!(camcraft_app::machine::kind_of(&state.world), camcraft_app::machine::Kind::Lathe);
+    assert!(camcraft_app::machine::document_of(&state.world).1.is_none(), "the document mounts nothing still");
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup1".into())));
+    assert_eq!(camcraft_app::machine::kind_of(&state.world), camcraft_app::machine::Kind::Mill, "Setup1 follows the document");
+    // Undo walks every step back: Setup2 follows the document again.
+    for _ in 0..5 {
+        run(&mut state, CommandKind::Undo);
+    }
+    assert_eq!(camcraft_app::setup_mount::own_post(&state.world, Some("Setup2")), None);
+    assert_eq!(camcraft_app::setup_mount::own_machine(&state.world, Some("Setup2")), None);
+}
