+
+/// The C letter gate (issue #33): a move stating spindle C angle `c`
+/// needs a rotary named C on the machine, and a stated C travel must
+/// hold the unwrapped angle. None when it is fine.
+fn c_letter_problem(machine: &Machine, i: usize, c: f64) -> Option<String> {
+    let Some(ax) = machine.axes.iter().find(|x| x.rotary && x.name.eq_ignore_ascii_case("C")) else {
+        return Some(format!("move {i} turns the spindle as C {c:.3} deg; {} states no C axis", machine.model));
+    };
+    let (lo, hi) = ax.travel?;
+    (c < lo - 1e-9 || c > hi + 1e-9)
+        .then(|| format!("move {i} commands C {c:.3} deg, the travel is {lo:.3}..{hi:.3}"))
+}
diff --git a/crates/app/src/machine/order.rs b/crates/app/src/machine/order.rs
new file mode 100644
index 00000000..7a637625
--- /dev/null
+++ b/crates/app/src/machine/order.rs
@@ -0,0 +1,160 @@
+//! Key order of a `.mch` file (issue #480): the editor writes a saved
+//! machine with its keys in the order the file was read, new keys
+//! appended at the end of their object.
+//!
+//! Provenance: our own writer, specced from the issue's "Done means"
+//! and the JSON grammar (RFC 8259); the pretty layout is the one
+//! `serde_json::to_string_pretty` writes (two-space indent, `": "`).
+//!
+//! The workspace `serde_json` keeps object keys sorted (no
+//! `preserve_order`, which would change every JSON writer, project
+//! files included). Rather than a new dependency, the order is recorded
+//! beside the value: one pass over the source text with a visitor that
+//! notes each object's keys as they come, then a writer that walks the
+//! value in that order.
+
+use std::fmt;
+
+use serde::de::{Deserialize, Deserializer, MapAccess, SeqAccess, Visitor};
+use serde_json::{Map, Value};
+
+/// The order keys were read in: per object its keys (each with the
+/// order below it), per array its items. Scalars carry nothing.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct KeyOrder {
+    keys: Vec<(String, KeyOrder)>,
+    items: Vec<KeyOrder>,
+}
+
+impl KeyOrder {
+    /// The order of `text`'s keys; empty (= sorted output) when the
+    /// text is not readable JSON.
+    #[must_use]
+    pub fn of_text(text: &str) -> Self {
+        serde_json::from_str(text).unwrap_or_default()
+    }
+
+    fn key(&self, k: &str) -> Option<&KeyOrder> {
+        self.keys.iter().find(|(n, _)| n == k).map(|(_, o)| o)
+    }
+}
+
+struct OrderVisitor;
+
+impl<'de> Visitor<'de> for OrderVisitor {
+    type Value = KeyOrder;
+
+    fn expecting(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.write_str("any JSON value")
+    }
+
+    fn visit_bool<E>(self, _: bool) -> Result<KeyOrder, E> {
+        Ok(KeyOrder::default())
+    }
+    fn visit_i64<E>(self, _: i64) -> Result<KeyOrder, E> {
+        Ok(KeyOrder::default())
+    }
+    fn visit_u64<E>(self, _: u64) -> Result<KeyOrder, E> {
+        Ok(KeyOrder::default())
+    }
+    fn visit_f64<E>(self, _: f64) -> Result<KeyOrder, E> {
+        Ok(KeyOrder::default())
+    }
+    fn visit_str<E>(self, _: &str) -> Result<KeyOrder, E> {
+        Ok(KeyOrder::default())
+    }
+    fn visit_unit<E>(self) -> Result<KeyOrder, E> {
+        Ok(KeyOrder::default())
+    }
+    fn visit_none<E>(self) -> Result<KeyOrder, E> {
+        Ok(KeyOrder::default())
+    }
+
+    fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<KeyOrder, A::Error> {
+        let mut items = Vec::new();
+        while let Some(item) = seq.next_element::<KeyOrder>()? {
+            items.push(item);
+        }
+        Ok(KeyOrder { keys: Vec::new(), items })
+    }
+
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<KeyOrder, A::Error> {
+        let mut keys: Vec<(String, KeyOrder)> = Vec::new();
+        while let Some(k) = map.next_key::<String>()? {
+            let sub = map.next_value::<KeyOrder>()?;
+            // A repeated key keeps its first place; its last value wins,
+            // as it does in `serde_json::Value`.
+            match keys.iter_mut().find(|(n, _)| *n == k) {
+                Some(slot) => slot.1 = sub,
+                None => keys.push((k, sub)),
+            }
+        }
+        Ok(KeyOrder { keys, items: Vec::new() })
+    }
+}
+
+impl<'de> Deserialize<'de> for KeyOrder {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        d.deserialize_any(OrderVisitor)
+    }
+}
+
+/// `value` as pretty JSON, each object's keys in `order` (keys the
+/// order does not know follow, sorted). No trailing newline.
+#[must_use]
+pub fn to_pretty(value: &Value, order: &KeyOrder) -> String {
+    let mut out = String::new();
+    write(&mut out, value, order, 0);
+    out
+}
+
+fn indent(out: &mut String, depth: usize) {
+    for _ in 0..depth {
+        out.push_str("  ");
+    }
+}
+
+fn ordered<'a>(map: &'a Map<String, Value>, order: &KeyOrder) -> Vec<&'a String> {
+    let mut keys: Vec<&String> = order.keys.iter().filter_map(|(k, _)| map.get_key_value(k).map(|(k, _)| k)).collect();
+    keys.extend(map.keys().filter(|k| order.key(k).is_none()));
+    keys
+}
+
+fn write(out: &mut String, value: &Value, order: &KeyOrder, depth: usize) {
+    let empty = KeyOrder::default();
+    match value {
+        Value::Object(map) if !map.is_empty() => {
+            out.push_str("{\n");
+            for (i, k) in ordered(map, order).into_iter().enumerate() {
+                if i > 0 {
+                    out.push_str(",\n");
+                }
+                indent(out, depth + 1);
+                out.push_str(&serde_json::to_string(k).unwrap_or_else(|_| "\"\"".to_owned()));
+                out.push_str(": ");
+                if let Some(v) = map.get(k) {
+                    write(out, v, order.key(k).unwrap_or(&empty), depth + 1);
+                }
+            }
+            out.push('\n');
+            indent(out, depth);
+            out.push('}');
+        }
+        Value::Array(items) if !items.is_empty() => {
+            out.push_str("[\n");
+            for (i, v) in items.iter().enumerate() {
+                if i > 0 {
+                    out.push_str(",\n");
+                }
+                indent(out, depth + 1);
+                write(out, v, order.items.get(i).unwrap_or(&empty), depth + 1);
+            }
+            out.push('\n');
+            indent(out, depth);
+            out.push(']');
+        }
+        // Scalars and empty containers: serde_json's own compact text
+        // (`{}`, `[]`), the same the pretty writer emits.
+        other => out.push_str(&serde_json::to_string(other).unwrap_or_else(|_| "null".to_owned())),
+    }
+}
diff --git a/crates/app/src/machine/sheet.rs b/crates/app/src/machine/sheet.rs
new file mode 100644
index 00000000..397fad8e
--- /dev/null
+++ b/crates/app/src/machine/sheet.rs
@@ -0,0 +1,151 @@
+//! The machine property sheet (issue #287): a `.mch` restated as
+//! grouped, read-only rows for the Machines pane.
+//!
+//! Provenance: our own layout, specced from the `.mch` grammar in
+//! `assets/machines/AGENTS.md`; group names and row words are ours.
+//!
+//! Numbers are shown AS THE FILE STATES THEM, in the file's own length
+//! unit - the reader scales an inch file to mm for the checker, but a
+//! person reading their machine wants the numbers they typed. An
+//! unstated value says so; it is never shown as a zero.
+
+use serde_json::Value;
+
+use super::validate::{axis_parts, head_parts};
+use super::{Kind, Machine};
+
+/// One collapsible group of the sheet: a title and its (label, value)
+/// rows.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PropGroup {
+    pub title: String,
+    pub rows: Vec<(String, String)>,
+}
+
+impl PropGroup {
+    fn new(title: &str) -> Self {
+        Self { title: title.to_owned(), rows: Vec::new() }
+    }
+
+    fn row(&mut self, label: impl Into<String>, value: impl Into<String>) {
+        self.rows.push((label.into(), value.into()));
+    }
+}
+
+const UNSTATED: &str = "not stated";
+
+/// A stated value as text: a number plainly, anything else as its JSON
+/// (so a malformed value is visible as itself), absence as "not stated".
+fn val(v: Option<&Value>, unit: &str) -> String {
+    match v {
+        None | Some(Value::Null) => UNSTATED.to_owned(),
+        Some(Value::Number(n)) => match n.as_f64() {
+            Some(x) if unit.is_empty() => format!("{x}"),
+            Some(x) => format!("{x} {unit}"),
+            None => n.to_string(),
+        },
+        Some(Value::String(s)) => s.clone(),
+        Some(other) => other.to_string(),
+    }
+}
+
+/// The sheet's groups: General, Axes, Spindle, Tool station, Coolants,
+/// Posts. `raw` is the file's JSON, `m` the reader's view of it.
+pub(crate) fn groups(raw: &Value, m: &Machine, k: Option<Kind>, posts: &[&str]) -> Vec<PropGroup> {
+    let len = if m.units.as_deref() == Some("inch") { "in" } else { "mm" };
+    let mut out = Vec::new();
+
+    let mut g = PropGroup::new("General");
+    g.row("Model", val(raw.pointer("/general/model"), ""));
+    g.row("Vendor", val(raw.pointer("/general/vendor"), ""));
+    let declared = raw.pointer("/general/kind").and_then(Value::as_str).filter(|w| !w.is_empty());
+    g.row(
+        "Kind",
+        match (declared, k) {
+            (Some(w), _) => w.to_owned(),
+            (None, Some(k)) => format!("{} (inferred from the axes)", k.word()),
+            (None, None) => UNSTATED.to_owned(),
+        },
+    );
+    g.row("Length unit", val(raw.pointer("/kinematics/default/units/length"), ""));
+    g.row("Angle unit", val(raw.pointer("/kinematics/default/units/angle"), ""));
+    g.row("Spindles", m.spindles.map_or_else(|| UNSTATED.to_owned(), |n| n.to_string()));
+    out.push(g);
+
+    let mut g = PropGroup::new("Axes");
+    let ctrl = raw.pointer("/controller/synced_configuration/parts");
+    for (name, part, rotary) in axis_parts(raw) {
+        let (dist, rate) = if rotary { ("deg", "deg/min") } else { (len, if len == "in" { "in/min" } else { "mm/min" }) };
+        let t = part.get("travel");
+        let travel = match (t.and_then(|t| t.get("min")), t.and_then(|t| t.get("max"))) {
+            (None, None) => UNSTATED.to_owned(),
+            (lo, hi) => format!("{} .. {}", val(lo, ""), val(hi, dist)),
+        };
+        let c = ctrl.and_then(|c| c.get(name.as_str()));
+        let mut s = format!(
+            "{}, travel {travel}, feed {}, rapid {}",
+            if rotary { "rotary" } else { "linear" },
+            val(c.and_then(|c| c.get("max_normal_speed")), rate),
+            val(c.and_then(|c| c.get("max_rapid_speed")), rate),
+        );
+        if rotary {
+            s.push_str(&format!(", about {}", val(part.get("axis"), "")));
+        }
+        g.row(name, s);
+    }
+    if g.rows.is_empty() {
+        g.row("Axes", "none stated");
+    }
+    out.push(g);
+
+    let heads = head_parts(raw);
+    let head = heads.iter().find(|h| h.get("spindle").is_some_and(|s| !s.is_null())).or(heads.first());
+    let sp = head.and_then(|h| h.get("spindle"));
+    let mut g = PropGroup::new("Spindle");
+    g.row("Min speed", val(sp.and_then(|s| s.get("min_speed")), "rpm"));
+    g.row("Max speed", val(sp.and_then(|s| s.get("max_speed")), "rpm"));
+    g.row("Power", val(sp.and_then(|s| s.get("power")), "kW"));
+    if let Some(r) = sp.and_then(|s| s.get("ranges")).and_then(Value::as_array) {
+        for (i, r) in r.iter().enumerate() {
+            g.row(
+                format!("Range {}", i + 1),
+                format!("{} .. {}", val(r.get("min_speed"), ""), val(r.get("max_speed"), "rpm")),
+            );
+        }
+    }
+    g.row("Rigid tapping", val(sp.and_then(|s| s.get("rigid_tapping")), ""));
+    g.row("Body diameter", val(sp.and_then(|s| s.get("body_diameter")), len));
+    g.row("Body length", val(sp.and_then(|s| s.get("body_length")), len));
+    out.push(g);
+
+    let ts = head.and_then(|h| h.get("tool_station"));
+    let mut g = PropGroup::new("Tool station");
+    g.row("Max tool length", val(ts.and_then(|t| t.get("max_tool_length")), len));
+    g.row("Max tool diameter", val(ts.and_then(|t| t.get("max_tool_diameter")), len));
+    g.row("Tools", val(raw.pointer("/tooling/number_of_tools"), ""));
+    g.row(
+        "Live tool",
+        match &m.live_tool {
+            Some(l) => format!(
+                "C on {}, C off {}, spindle on {}, spindle off {}",
+                l.c_axis_on, l.c_axis_off, l.spindle_on, l.spindle_off
+            ),
+            None => UNSTATED.to_owned(),
+        },
+    );
+    out.push(g);
+
+    let mut g = PropGroup::new("Coolants");
+    for c in &m.coolants {
+        g.row(c.name.clone(), if c.m_code.is_empty() { "no code".to_owned() } else { c.m_code.clone() });
+    }
+    if g.rows.is_empty() {
+        g.row("Coolants", "none stated");
+    }
+    out.push(g);
+
+    let mut g = PropGroup::new("Posts");
+    g.row("Built-in posts", if posts.is_empty() { "none".to_owned() } else { posts.join(", ") });
+    out.push(g);
+    out
+}
diff --git a/crates/app/src/machine/store.rs b/crates/app/src/machine/store.rs
new file mode 100644
index 00000000..5512e703
--- /dev/null
+++ b/crates/app/src/machine/store.rs
@@ -0,0 +1,132 @@
+//! Where the user's machine files live and how one is written (issue
+//! #383): the user machines folder, resolved per the #287 decision, and
+//! the validated, atomic save.
+//!
+//! Provenance: our own resolver, specced from the decision recorded on
+//! #287 (`CAMCRAFT_MACHINES`, else `<platform data dir>/camcraft/machines`)
+//! and the platforms' published per-user data locations (Windows
+//! `%APPDATA%`, macOS `~/Library/Application Support`, the XDG Base
+//! Directory spec's `$XDG_DATA_HOME` / `~/.local/share`); the atomic save
+//! is the write-temp-then-rename pattern from the `std::fs::rename` docs.
+//!
+//! A save is all or nothing: the text is validated first and a refused
+//! file is never written; a good one goes to a temp file beside the
+//! target and is renamed over it, so a crash mid-write leaves the old
+//! file whole, never half a machine.
+
+use std::ffi::OsString;
+use std::fmt;
+use std::path::{Path, PathBuf};
+
+use super::validate::{validate_text, Refusal};
+
+/// The override: an absolute folder of user `.mch` files.
+pub const ENV_VAR: &str = "CAMCRAFT_MACHINES";
+
+/// The user machines folder from an environment lookup, for the named
+/// platform (`std::env::consts::OS`). Pure, so the order is testable
+/// without touching the process environment. `None` = no home to put
+/// one in (the pane then lists the shipped library only, and Save As
+/// says why it cannot save).
+#[must_use]
+pub fn user_dir_for(os: &str, get: impl Fn(&str) -> Option<OsString>) -> Option<PathBuf> {
+    let abs = |k: &str| get(k).map(PathBuf::from).filter(|p| p.is_absolute());
+    if let Some(dir) = abs(ENV_VAR) {
+        return Some(dir);
+    }
+    let data = match os {
+        "windows" => abs("APPDATA"),
+        "macos" => abs("HOME").map(|h| h.join("Library").join("Application Support")),
+        _ => abs("XDG_DATA_HOME").or_else(|| abs("HOME").map(|h| h.join(".local").join("share"))),
+    }?;
+    Some(data.join("camcraft").join("machines"))
+}
+
+/// The user machines folder for this process.
+#[must_use]
+pub fn user_dir() -> Option<PathBuf> {
+    user_dir_for(std::env::consts::OS, |k| std::env::var_os(k))
+}
+
+/// Why a save did not happen. Nothing was written in every case.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SaveError {
+    /// The validator refused the file; each refusal by name.
+    Refused(Vec<Refusal>),
+    /// A shipped machine, or one never saved: it needs Save As.
+    NeedsSaveAs,
+    /// Save As would replace this file; ask before replacing.
+    Exists(PathBuf),
+    /// No user machines folder could be resolved.
+    NoFolder,
+    /// The file name is not a plain name.
+    BadName(String),
+    /// The disk refused (the OS error, in words).
+    Io(String),
+}
+
+impl fmt::Display for SaveError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            SaveError::Refused(r) => {
+                write!(f, "not saved - {} refusal{}", r.len(), if r.len() == 1 { "" } else { "s" })
+            }
+            SaveError::NeedsSaveAs => write!(f, "a shipped or new machine is saved with Save As"),
+            SaveError::Exists(p) => write!(f, "{} already exists", p.display()),
+            SaveError::NoFolder => {
+                write!(f, "no user machines folder (set {ENV_VAR} or a home folder)")
+            }
+            SaveError::BadName(why) => write!(f, "file name {why}"),
+            SaveError::Io(e) => write!(f, "not saved - {e}"),
+        }
+    }
+}
+
+/// A Save As name made into a `.mch` file name in `dir`: refused when
+/// empty or when it names a folder (`/`, `\`, `..`), so a save can only
+/// ever land in the user machines folder.
+pub fn file_in(dir: &Path, name: &str) -> Result<PathBuf, SaveError> {
+    let n = name.trim();
+    if n.is_empty() {
+        return Err(SaveError::BadName("is empty".to_owned()));
+    }
+    if n.contains(['/', '\\', ':']) || n.starts_with('.') {
+        return Err(SaveError::BadName(format!("'{n}' must be a plain name, not a path")));
+    }
+    let file = if n.to_ascii_lowercase().ends_with(".mch") { n.to_owned() } else { format!("{n}.mch") };
+    Ok(dir.join(file))
+}
+
+/// Write `text` to `path` atomically: a temp file in the same folder,
+/// flushed, then renamed over the target. The folder is created when
+/// missing. On any failure the temp file is removed and the target is
+/// as it was.
+pub fn write_atomic(path: &Path, text: &str) -> Result<(), SaveError> {
+    use std::io::Write;
+    let io = |e: std::io::Error| SaveError::Io(e.to_string());
+    let dir = path.parent().ok_or_else(|| SaveError::Io(format!("{} has no folder", path.display())))?;
+    std::fs::create_dir_all(dir).map_err(io)?;
+    let name = path.file_name().map_or_else(|| "machine".into(), |n| n.to_string_lossy().into_owned());
+    let tmp = dir.join(format!(".{name}.{}.tmp", std::process::id()));
+    let wrote = (|| {
+        let mut f = std::fs::File::create(&tmp)?;
+        f.write_all(text.as_bytes())?;
+        f.sync_all()?;
+        drop(f);
+        std::fs::rename(&tmp, path)
+    })();
+    if let Err(e) = wrote {
+        let _ = std::fs::remove_file(&tmp);
+        return Err(io(e));
+    }
+    Ok(())
+}
+
+/// Validate, then write atomically. A refused file is not written.
+pub fn save_text(path: &Path, text: &str) -> Result<(), SaveError> {
+    let refusals = validate_text(text);
+    if !refusals.is_empty() {
+        return Err(SaveError::Refused(refusals));
+    }
+    write_atomic(path, text)
+}
diff --git a/crates/app/src/machine/validate.rs b/crates/app/src/machine/validate.rs
new file mode 100644
index 00000000..138ab216
--- /dev/null
+++ b/crates/app/src/machine/validate.rs
@@ -0,0 +1,376 @@
+//! Machine-file validation (issue #287): the named refusals a `.mch`
+//! must clear before the Machines pane calls it good - and, in a later
+//! slice, before the editor may save it.
+//!
+//! Provenance: our own rules, specced from the `.mch` grammar in
+//! `assets/machines/AGENTS.md` and general machine-tool practice (a
+//! stroke runs from a lower to a higher bound, a feed or a spindle speed
+//! is a positive rate, a coolant word is an RS-274 `M` number); no
+//! vendor validator or file was consulted.
+//!
+//! The reader (`parse_mch`) is deliberately forgiving: an unreadable
+//! travel is DROPPED, a zero rate reads "not stated". That is right for
+//! a checker - and wrong for a file a person is about to trust, where a
+//! stroke typed backwards should be named, not silently ignored. So the
+//! validator reads the raw JSON, and every refusal names the key it is
+//! about and the rule it breaks. Absent stays legal (the unstated-limit
+//! law): only what a file STATES is judged, plus the few keys every
+//! machine of its kind must carry.
+
+use std::fmt;
+
+use serde_json::Value;
+
+use super::{kind, parse_mch, Kind};
+
+/// One named refusal: the key it is about and the rule it breaks.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Refusal {
+    /// The key, in words a reader can find in the file (`X travel`,
+    /// `general.kind`, `coolant Flood`).
+    pub key: String,
+    /// The rule, with the offending value where there is one.
+    pub rule: String,
+}
+
+impl Refusal {
+    fn new(key: impl Into<String>, rule: impl Into<String>) -> Self {
+        Self { key: key.into(), rule: rule.into() }
+    }
+}
+
+impl fmt::Display for Refusal {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}: {}", self.key, self.rule)
+    }
+}
+
+/// An axis part of the kinematics tree, as the file states it: its
+/// letter, its JSON, and whether it is a rotary. Depth-first, the walk
+/// `parse_mch` makes - the pane's property sheet reads the same list.
+pub(crate) fn axis_parts(v: &Value) -> Vec<(String, &Value, bool)> {
+    fn walk<'a>(parts: Option<&'a Value>, out: &mut Vec<(String, &'a Value, bool)>) {
+        let Some(arr) = parts.and_then(Value::as_array) else { return };
+        for p in arr {
+            let ty = p.get("type").and_then(Value::as_str);
+            let rotary = ty == Some("rotary");
+            let name = p
+                .get("name")
+                .and_then(Value::as_str)
+                .or_else(|| p.get("id").and_then(Value::as_str))
+                .unwrap_or("");
+            if (ty == Some("linear") || rotary) && !name.is_empty() {
+                out.push((name.to_owned(), p, rotary));
+            }
+            walk(p.get("parts"), out);
+        }
+    }
+    let mut out = Vec::new();
+    walk(v.pointer("/kinematics/default/parts"), &mut out);
+    out
+}
+
+/// Every `type: "head"` part, depth-first.
+pub(crate) fn head_parts(v: &Value) -> Vec<&Value> {
+    fn walk<'a>(parts: Option<&'a Value>, out: &mut Vec<&'a Value>) {
+        let Some(arr) = parts.and_then(Value::as_array) else { return };
+        for p in arr {
+            if p.get("type").and_then(Value::as_str) == Some("head") {
+                out.push(p);
+            }
+            walk(p.get("parts"), out);
+        }
+    }
+    let mut out = Vec::new();
+    walk(v.pointer("/kinematics/default/parts"), &mut out);
+    out
+}
+
+/// Validate a machine file's text. Empty = the file is good. Never
+/// panics: malformed JSON is itself a refusal by name.
+#[must_use]
+pub fn validate_text(text: &str) -> Vec<Refusal> {
+    let v: Value = match serde_json::from_str(text) {
+        Ok(v) => v,
+        Err(e) => return vec![Refusal::new("file", format!("not readable JSON ({e})"))],
+    };
+    if !v.is_object() {
+        return vec![Refusal::new("file", "must be one machine object { ... }")];
+    }
+    let mut out = Vec::new();
+    general(&v, &mut out);
+    units(&v, &mut out);
+    let axes = axis_parts(&v);
+    axis_rules(&axes, &mut out);
+    for head in head_parts(&v) {
+        spindle(head.get("spindle"), &mut out);
+        station(head.get("tool_station"), &mut out);
+    }
+    coolants(v.pointer("/tooling/coolants"), &mut out);
+    controller(&v, &mut out);
+    if let Some(n) = v.pointer("/tooling/number_of_tools")
+        && !n.is_null()
+        && n.as_u64().is_none_or(|n| n == 0)
+    {
+        out.push(Refusal::new("tooling.number_of_tools", format!("{n} must be a whole number above 0")));
+    }
+    required_by_kind(&v, text, &axes, &mut out);
+    // Anything the reader still refuses that no rule above named (it
+    // should be none - the reader's refusals are covered by name).
+    if out.is_empty()
+        && let Err(e) = parse_mch(text)
+    {
+        out.push(Refusal::new("file", e.trim_start_matches("machine file: ").to_owned()));
+    }
+    out
+}
+
+fn general(v: &Value, out: &mut Vec<Refusal>) {
+    let g = v.get("general");
+    let model = g.and_then(|g| g.get("model")).and_then(Value::as_str);
+    if model.is_none_or(|m| m.trim().is_empty()) {
+        out.push(Refusal::new("general.model", "required - the machine's name"));
+    }
+    match g.and_then(|g| g.get("kind")) {
+        None | Some(Value::Null) => {}
+        Some(Value::String(w)) if w.is_empty() || Kind::from_word(w).is_some() => {}
+        Some(other) => out.push(Refusal::new("general.kind", format!("{other} is not mill, lathe or mill-turn"))),
+    }
+}
+
+fn units(v: &Value, out: &mut Vec<Refusal>) {
+    let u = v.pointer("/kinematics/default/units");
+    match u.and_then(|u| u.get("length")) {
+        None | Some(Value::Null) => {}
+        Some(Value::String(s)) if matches!(s.as_str(), "mm" | "inch" | "inches") => {}
+        Some(other) => out.push(Refusal::new("units.length", format!("{other} is not mm or inch"))),
+    }
+    match u.and_then(|u| u.get("angle")) {
+        None | Some(Value::Null) => {}
+        Some(Value::String(s)) if matches!(s.as_str(), "degrees" | "degree" | "deg") => {}
+        Some(other) => out.push(Refusal::new("units.angle", format!("{other} is not degrees"))),
+    }
+}
+
+fn axis_rules(axes: &[(String, &Value, bool)], out: &mut Vec<Refusal>) {
+    let mut seen: Vec<String> = Vec::new();
+    for (name, part, rotary) in axes {
+        let up = name.to_ascii_uppercase();
+        if seen.contains(&up) {
+            out.push(Refusal::new(name.clone(), "is stated twice in the axis tree"));
+        }
+        seen.push(up);
+        if let Some(t) = part.get("travel").filter(|t| !t.is_null()) {
+            travel(&format!("{name} travel"), t, out);
+        }
+        if let Some(r) = part.get("resolution") {
+            positive(&format!("{name} resolution"), r, out);
+        }
+        if let Some(a) = part.get("axis") {
+            let d: Option<Vec<f64>> = a
+                .as_array()
+                .filter(|v| v.len() == 3)
+                .and_then(|v| v.iter().map(Value::as_f64).collect());
+            match d {
+                Some(d) if d.iter().all(|x| x.is_finite()) => {
+                    if *rotary && d.iter().all(|x| *x == 0.0) {
+                        out.push(Refusal::new(format!("{name} axis"), "states the zero direction"));
+                    }
+                }
+                _ => out.push(Refusal::new(format!("{name} axis"), format!("{a} must be three finite numbers"))),
+            }
+        }
+    }
+}
+
+fn travel(key: &str, t: &Value, out: &mut Vec<Refusal>) {
+    let lo = t.get("min").and_then(Value::as_f64).filter(|x| x.is_finite());
+    let hi = t.get("max").and_then(Value::as_f64).filter(|x| x.is_finite());
+    match (lo, hi) {
+        (Some(lo), Some(hi)) if lo < hi => {}
+        (Some(lo), Some(hi)) => out.push(Refusal::new(key, format!("min {lo} must be below max {hi}"))),
+        _ => out.push(Refusal::new(key, "min and max must both be numbers")),
+    }
+}
+
+/// A stated rate must be a number above zero. A null reads unstated
+/// (legal); a zero is refused here even though the reader would read it
+/// as unstated - a file someone validates should say what it means.
+fn positive(key: &str, x: &Value, out: &mut Vec<Refusal>) {
+    if x.is_null() {
+        return;
+    }
+    if !x.as_f64().is_some_and(|x| x.is_finite() && x > 0.0) {
+        out.push(Refusal::new(key, format!("{x} must be a number above 0 (leave the key out when unstated)")));
+    }
+}
+
+fn spindle(sp: Option<&Value>, out: &mut Vec<Refusal>) {
+    let Some(sp) = sp.filter(|s| !s.is_null()) else { return };
+    for k in ["min_speed", "max_speed", "power"] {
+        if let Some(x) = sp.get(k) {
+            positive(&format!("spindle {k}"), x, out);
+        }
+    }
+    let lo = sp.get("min_speed").and_then(Value::as_f64);
+    let hi = sp.get("max_speed").and_then(Value::as_f64);
+    if let (Some(lo), Some(hi)) = (lo, hi)
+        && lo > hi
+    {
+        out.push(Refusal::new("spindle", format!("min_speed {lo} must not exceed max_speed {hi}")));
+    }
+    if let Some(ranges) = sp.get("ranges").filter(|r| !r.is_null()) {
+        let Some(arr) = ranges.as_array() else {
+            out.push(Refusal::new("spindle ranges", "must be a list of { min_speed, max_speed }"));
+            return;
+        };
+        for (i, r) in arr.iter().enumerate() {
+            let key = format!("spindle range {}", i + 1);
+            let lo = r.get("min_speed").and_then(Value::as_f64).filter(|x| x.is_finite() && *x > 0.0);
+            let hi = r.get("max_speed").and_then(Value::as_f64).filter(|x| x.is_finite() && *x > 0.0);
+            match (lo, hi) {
+                (Some(lo), Some(hi)) if lo < hi => {}
+                (Some(lo), Some(hi)) => out.push(Refusal::new(key, format!("min_speed {lo} must be below max_speed {hi}"))),
+                _ => out.push(Refusal::new(key, "min_speed and max_speed must both be numbers above 0")),
+            }
+        }
+    }
+}
+
+fn station(ts: Option<&Value>, out: &mut Vec<Refusal>) {
+    let Some(ts) = ts.filter(|t| !t.is_null()) else { return };
+    coolants(ts.get("coolants"), out);
+    if let Some(lt) = ts.get("live_tool").filter(|l| !l.is_null()) {
+        let words = ["c_axis_on", "c_axis_off", "spindle_on", "spindle_off"];
+        let stated = words
+            .iter()
+            .filter(|k| lt.get(**k).and_then(Value::as_str).is_some_and(|w| !w.trim().is_empty()))
+            .count();
+        if stated != words.len() {
+            out.push(Refusal::new(
+                "live_tool",
+                format!("states {stated} of the 4 words (c_axis_on, c_axis_off, spindle_on, spindle_off) - all four or none"),
+            ));
+        }
+        // Each stated word is written as a block of its own: it must be
+        // a well-formed M word (an unstated one is the rule above's).
+        for k in words {
+            if let Some(w) = lt.get(k).and_then(Value::as_str).filter(|w| !w.trim().is_empty())
+                && let Err(why) = m_word(w.trim())
+            {
+                out.push(Refusal::new(format!("live_tool.{k}"), format!("code \"{w}\" is not an M word like M8 ({why})")));
+            }
+        }
+    }
+}
+
+/// The highest M number a machine file may state. RS-274/NGC (NIST
+/// IR 6556) and ISO 6983-1 give M a two-digit standard range; controls
+/// extend it (LinuxCNC user codes M100-M199, three-digit builder codes),
+/// so four digits is a sanity bound, not a standard's ceiling - see
+/// `docs/decisions/383-machines-edit.md`.
+pub const M_WORD_MAX: u32 = 9999;
+
+/// Is `s` an M word: an uppercase `M` and a whole number
+/// 0..=[`M_WORD_MAX`], leading zeros allowed (`M8`, `M08`, `M155`)?
+/// `Err` says what is wrong with it. One word only - a post writes the
+/// statement as it stands, so `M8 M7` or `M8.5` would reach the program.
+fn m_word(s: &str) -> Result<(), &'static str> {
+    let rest = match s.strip_prefix('M') {
+        Some(r) => r,
+        None if s.starts_with('m') => return Err("write it with an uppercase M"),
+        None => return Err("it must start with M"),
+    };
+    if rest.is_empty() {
+        return Err("no number after M");
+    }
+    if !rest.bytes().all(|b| b.is_ascii_digit()) {
+        return Err("only digits may follow M");
+    }
+    let digits = rest.trim_start_matches('0');
+    match digits.parse::<u32>() {
+        _ if digits.is_empty() => Ok(()),
+        Ok(n) if digits.len() <= 4 && n <= M_WORD_MAX => Ok(()),
+        _ => Err("above M9999"),
+    }
+}
+
+fn coolants(list: Option<&Value>, out: &mut Vec<Refusal>) {
+    let Some(list) = list.filter(|l| !l.is_null()) else { return };
+    let Some(arr) = list.as_array() else {
+        out.push(Refusal::new("coolants", "must be a list"));
+        return;
+    };
+    for (i, e) in arr.iter().enumerate() {
+        if let Some(name) = e.as_str() {
+            if name.trim().is_empty() {
+                out.push(Refusal::new(format!("coolant {}", i + 1), "has an empty name"));
+            }
+            continue;
+        }
+        let name = e.get("name").and_then(Value::as_str).unwrap_or("");
+        if name.trim().is_empty() {
+            out.push(Refusal::new(format!("coolant {}", i + 1), "needs a name"));
+            continue;
+        }
+        let key = format!("coolant {name}");
+        match e.get("mCode").or_else(|| e.get("mcode")) {
+            None | Some(Value::Null) => {}
+            Some(Value::Number(n)) if n.as_u64().is_some_and(|n| n <= u64::from(M_WORD_MAX)) => {}
+            Some(Value::String(s)) => {
+                if let Err(why) = m_word(s.trim()) {
+                    out.push(Refusal::new(key, format!("code \"{s}\" is not an M word like M8 ({why})")));
+                }
+            }
+            Some(other) => out.push(Refusal::new(key, format!("code {other} is not an M word like M8"))),
+        }
+    }
+}
+
+fn controller(v: &Value, out: &mut Vec<Refusal>) {
+    let Some(parts) = v.pointer("/controller/synced_configuration/parts").filter(|p| !p.is_null()) else {
+        return;
+    };
+    let Some(map) = parts.as_object() else {
+        out.push(Refusal::new("controller parts", "must be keyed by axis letter"));
+        return;
+    };
+    for (letter, c) in map {
+        for (k, word) in [("max_normal_speed", "feed"), ("max_rapid_speed", "rapid")] {
+            if let Some(x) = c.get(k) {
+                positive(&format!("{letter} {word} ({k})"), x, out);
+            }
+        }
+    }
+}
+
+/// The keys every machine of its kind must carry: the kinematics tree,
+/// and the linear axes the kind moves - X/Y/Z for a mill, X/Z for a
+/// lathe, X/Y/Z and a rotary for a mill-turn. The kind is the declared
+/// word, else the reader's axis-inventory inference.
+fn required_by_kind(v: &Value, text: &str, axes: &[(String, &Value, bool)], out: &mut Vec<Refusal>) {
+    if !v.pointer("/kinematics/default/parts").is_some_and(Value::is_array) {
+        out.push(Refusal::new("kinematics.default.parts", "required - the machine's axis tree"));
+        return;
+    }
+    let declared = v
+        .pointer("/general/kind")
+        .and_then(Value::as_str)
+        .and_then(Kind::from_word);
+    let Some(k) = declared.or_else(|| parse_mch(text).ok().map(|m| kind(Some(&m)))) else {
+        return;
+    };
+    let has_linear = |l: &str| axes.iter().any(|(n, _, r)| !r && n.eq_ignore_ascii_case(l));
+    let need: &[&str] = match k {
+        Kind::Lathe => &["X", "Z"],
+        Kind::Mill | Kind::MillTurn => &["X", "Y", "Z"],
+    };
+    for l in need {
+        if !has_linear(l) {
+            out.push(Refusal::new(format!("{l} axis"), format!("required for a {} machine", k.word())));
+        }
+    }
+    if k == Kind::MillTurn && !axes.iter().any(|(_, _, r)| *r) {
+        out.push(Refusal::new("rotary axis", "required for a mill-turn machine (the turning spindle, C)"));
+    }
+}
