new file mode 100644
index 00000000..0d02ccda
--- /dev/null
+++ b/crates/app/tests/inverted_probe.rs
@@ -0,0 +1,400 @@
+//! Probing on a machine with an inverted X / Y (#392): the posted Fanuc
+//! and Haas probing blocks, run by a macro B controller (`macro_b`) on a
+//! simulated machine whose inverted axis moves the other way, against a
+//! part sitting off its model position, write the PHYSICALLY correct
+//! work offset - the part datum in the controller's coordinates - for
+//! face, edge, corner, bore and boss probing. The same reader on a
+//! standard machine finds the same physical answer (the interpreter is
+//! checked too); a part out of reach alarms; and the standard-sign
+//! program, or a translation missing any one of its probing words, does
+//! NOT find it on the inverted machine (the reader is no tautology).
+//!
+//! Provenance: Fanuc's published operator documentation (G31, custom
+//! macro B, G10 L2); the Haas Mill Operator's Manual (G31 Feed Until
+//! Skip, macro variables #5061-#5063 / #5221.., #3000 / #3006, G10 L2
+//! P1..P6) - the same words with the same meaning, so one reader runs
+//! both; touch-probe practice. Fixture values are our own.
+//!
+//! Gate map (M4.4): covers post::invert (probing), post::js (manifest
+//! flags), assets/posts fanuc.cps + haas.cps (probing hooks),
+//! motion::probing.
+
+mod inverted_support;
+mod macro_b;
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::post::cnc::{self, Record};
+use camcraft_app::post::{self, engine, invert, probe_rec};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+use inverted_support::{cps, machine};
+use macro_b::{Pt, Run, Stop};
+
+/// The setup's work-offset origin in the model (CAM world) frame.
+const ORIGIN: Pt = [12.5, -7.25, 3.0];
+/// The machine's physical position of that origin as the model places
+/// it: G54 holds it (negated on an inverted axis) before probing.
+const DATUM: Pt = [-312.5, -201.25, -405.0];
+/// Where the real part sits relative to the model: what probing finds.
+const SHIFT: Pt = [0.37, -0.21, -0.13];
+/// Stylus ball radius.
+const R: f64 = 2.0;
+/// G55 before the program writes it: an unwritten axis stays this.
+const UNSET: f64 = 999.0;
+/// Program words carry three decimals.
+const TOL: f64 = 0.002;
+
+const MACHINES: &[&[&str]] = &[&[], &["X"], &["Y"], &["X", "Y"]];
+/// The posts that declare `probeAxisInversion = true`.
+const POSTS: &[&str] = &["fanuc", "haas"];
+
+/// The part, in model coordinates of the stylus ball CENTRE.
+#[derive(Clone, Debug)]
+enum Shape {
+    /// The intersection of half-spaces: (surface point, outward normal).
+    Solid(Vec<(Pt, Pt)>),
+    /// Material outside a vertical bore (centre, radius) below `top`.
+    Bore(Pt, f64),
+    /// Material inside a vertical boss (centre, radius) below its top.
+    Boss(Pt, f64),
+}
+
+impl Shape {
+    fn holds(&self, c: Pt) -> bool {
+        let rho = |o: Pt| ((c[0] - o[0]).powi(2) + (c[1] - o[1]).powi(2)).sqrt();
+        match self {
+            Shape::Solid(faces) => faces
+                .iter()
+                .all(|(q, n)| (c[0] - q[0]) * n[0] + (c[1] - q[1]) * n[1] + (c[2] - q[2]) * n[2] < R),
+            Shape::Bore(o, rad) => rho(*o) > rad - R && c[2] - o[2] < R,
+            Shape::Boss(o, rad) => rho(*o) < rad + R && c[2] - o[2] < R,
+        }
+    }
+}
+
+struct Case {
+    name: &'static str,
+    params: ProbeParams,
+    shape: Shape,
+    /// The axes the probing finds (0 X, 1 Y, 2 Z).
+    found: &'static [usize],
+}
+
+fn params(mode: ProbeMode, dir: ProbeDir, dir_y: ProbeDir, t: Pt, radius: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir,
+        dir_y,
+        target: Point3::new(t[0], t[1], t[2]),
+        radius,
+        ball_diameter: 2.0 * R,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+fn wall(t: Pt, d: ProbeDir) -> (Pt, Pt) {
+    let u = d.unit();
+    (t, [-u.x, -u.y, -u.z])
+}
+
+fn cases() -> Vec<Case> {
+    use ProbeDir::{XNeg, XPos, YNeg, YPos, ZNeg};
+    use ProbeMode::{Boss, Bore, Corner, Edge, Face};
+    let up = |t: Pt| (t, [0.0, 0.0, 1.0]);
+    let (tz, tx, te) = ([10.0, 5.0, 20.0], [40.0, 5.0, 15.0], [20.0, 40.0, 20.0]);
+    let (tc, tn, tb) = ([0.0, 0.0, 20.0], [80.0, 60.0, 20.0], [30.0, 30.0, 20.0]);
+    vec![
+        Case {
+            name: "face -Z",
+            params: params(Face, ZNeg, YPos, tz, 0.0),
+            shape: Shape::Solid(vec![up(tz)]),
+            found: &[2],
+        },
+        Case {
+            name: "face -X",
+            params: params(Face, XNeg, YPos, tx, 0.0),
+            shape: Shape::Solid(vec![wall(tx, XNeg)]),
+            found: &[0],
+        },
+        Case {
+            name: "edge -Y",
+            params: params(Edge, YNeg, YPos, te, 0.0),
+            shape: Shape::Solid(vec![wall(te, YNeg), up(te)]),
+            found: &[1],
+        },
+        Case {
+            name: "corner +X+Y",
+            params: params(Corner, XPos, YPos, tc, 0.0),
+            shape: Shape::Solid(vec![wall(tc, XPos), wall(tc, YPos), up(tc)]),
+            found: &[0, 1],
+        },
+        Case {
+            name: "corner -X-Y",
+            params: params(Corner, XNeg, YNeg, tn, 0.0),
+            shape: Shape::Solid(vec![wall(tn, XNeg), wall(tn, YNeg), up(tn)]),
+            found: &[0, 1],
+        },
+        Case { name: "bore", params: params(Bore, ZNeg, YPos, tb, 10.0), shape: Shape::Bore(tb, 10.0), found: &[0, 1] },
+        Case { name: "boss", params: params(Boss, ZNeg, YPos, tb, 8.0), shape: Shape::Boss(tb, 8.0), found: &[0, 1] },
+    ]
+}
+
+/// The case's probing records: set G55 from the trips, tolerance 0.5.
+fn records(c: &Case) -> Vec<Record> {
+    let t = probe_cycle(&c.params).unwrap_or_else(|e| panic!("{}: {e:?}", c.name));
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 7,
+        tool_name: "PROBE-4",
+        tool_diameter: 2.0 * R,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        wcs: "G54",
+        origin: ORIGIN,
+        probe_result: Some(probe_rec::ProbeResult { set_wcs: Some(1), tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    post::dump(&t, &d)
+}
+
+fn post_for(post: &str, records: &[Record], letters: &[&str]) -> String {
+    post_with(&cps(post), records, letters)
+}
+
+fn post_with(script: &str, records: &[Record], letters: &[&str]) -> String {
+    let out = engine::run(script, &machine(letters), &cnc::serialize(records))
+        .unwrap_or_else(|e| panic!("inverted {letters:?}: {e}"));
+    assert!(out.warnings.is_empty(), "inverted {letters:?}: {:?}", out.warnings);
+    out.program
+}
+
+/// `post`'s script with its `probeAxisInversion` line taken out.
+fn without_probe_flag(post: &str) -> String {
+    let s = cps(post);
+    let line = s.lines().find(|l| l.starts_with("probeAxisInversion = true;")).expect("declares the flag");
+    s.replacen(line, "", 1)
+}
+
+fn sign(flip: [bool; 3]) -> Pt {
+    flip.map(|f| if f { -1.0 } else { 1.0 })
+}
+
+fn flip_of(letters: &[&str]) -> [bool; 3] {
+    [letters.contains(&"X"), letters.contains(&"Y"), false]
+}
+
+/// Run `program` on the machine with `flip` inverted, the part shifted
+/// by `shift` off its model position.
+fn simulate(program: &str, flip: [bool; 3], shape: &Shape, shift: Pt) -> Run {
+    let s = sign(flip);
+    let mut offsets = [[UNSET; 3]; 6];
+    offsets[0] = [0, 1, 2].map(|a| s[a] * DATUM[a]);
+    // Physical tip -> model coordinates of the ball centre, with the
+    // part moved by `shift` (so the part's model point m sits at m+shift).
+    let material = |p: Pt| {
+        let c = [0, 1, 2].map(|a| p[a] - DATUM[a] + ORIGIN[a] - shift[a] + if a == 2 { R } else { 0.0 });
+        shape.holds(c)
+    };
+    macro_b::run(program, flip, offsets, &material).unwrap_or_else(|e| panic!("{e}\n{program}"))
+}
+
+/// The register the probing must write: the real part's datum in the
+/// controller's coordinates (negated on an inverted axis).
+fn want(flip: [bool; 3], shift: Pt) -> Pt {
+    let s = sign(flip);
+    [0, 1, 2].map(|a| s[a] * (DATUM[a] + shift[a]))
+}
+
+/// True when the run ends cleanly with G55 right on every found axis
+/// and G54 untouched.
+fn correct(run: &Run, c: &Case, flip: [bool; 3], shift: Pt) -> bool {
+    let (w, g54) = (want(flip, shift), want(flip, [0.0; 3]));
+    run.stop == Stop::End
+        && c.found.iter().all(|&a| (run.offsets[1][a] - w[a]).abs() <= TOL)
+        && (0..3).all(|a| c.found.contains(&a) || run.offsets[1][a] == UNSET)
+        && (0..3).all(|a| (run.offsets[0][a] - g54[a]).abs() < 1e-12)
+}
+
+#[test]
+fn every_mode_sets_the_physical_offset_on_every_machine() {
+    for (post, c) in POSTS.iter().flat_map(|p| cases().into_iter().map(move |c| (*p, c))) {
+        let recs = records(&c);
+        let touches = recs.iter().filter(|r| matches!(r, Record::Touch(_))).count();
+        for letters in MACHINES {
+            let flip = flip_of(letters);
+            let program = post_for(post, &recs, letters);
+            let run = simulate(&program, flip, &c.shape, SHIFT);
+            let what = format!("{post}: {} on inverted {letters:?}", c.name);
+            assert_eq!(run.stop, Stop::End, "{what}\n{program}");
+            assert_eq!(run.trips.len(), touches, "{what}: every touch trips once\n{program}");
+            assert!(
+                correct(&run, &c, flip, SHIFT),
+                "{what}: G55 {:?}, want {:?} on axes {:?}\n{program}",
+                run.offsets[1],
+                want(flip, SHIFT),
+                c.found
+            );
+        }
+    }
+}
+
+#[test]
+fn a_part_where_the_model_says_sets_the_unchanged_datum() {
+    for (post, c) in POSTS.iter().flat_map(|p| cases().into_iter().map(move |c| (*p, c))) {
+        for letters in MACHINES {
+            let flip = flip_of(letters);
+            let run = simulate(&post_for(post, &records(&c), letters), flip, &c.shape, [0.0; 3]);
+            assert!(correct(&run, &c, flip, [0.0; 3]), "{post}: {} on {letters:?}: {:?}", c.name, run);
+        }
+    }
+}
+
+#[test]
+fn a_part_out_of_reach_alarms_no_contact_and_writes_nothing() {
+    let c = cases().into_iter().find(|c| c.name == "face -X").expect("face -X");
+    // Travelling -X onto a part 7 mm further -X: past the 5 mm overtravel.
+    for (post, letters) in POSTS.iter().flat_map(|p| MACHINES.iter().map(move |l| (*p, *l))) {
+        let run = simulate(&post_for(post, &records(&c), letters), flip_of(letters), &c.shape, [-7.0, 0.0, 0.0]);
+        assert_eq!(run.stop, Stop::Alarm(2, "PROBE NO CONTACT".into()), "{post} {letters:?}");
+        assert_eq!(run.offsets[1], [UNSET; 3], "{post} {letters:?}: no offset is written");
+    }
+}
+
+#[test]
+fn a_part_off_by_more_than_the_tolerance_alarms() {
+    let c = cases().into_iter().find(|c| c.name == "bore").expect("bore");
+    for (post, letters) in POSTS.iter().flat_map(|p| MACHINES.iter().map(move |l| (*p, *l))) {
+        let run = simulate(&post_for(post, &records(&c), letters), flip_of(letters), &c.shape, [0.8, 0.0, 0.0]);
+        assert_eq!(run.stop, Stop::Alarm(1, "PROBE X OUT OF TOLERANCE".into()), "{post} {letters:?}");
+        assert_eq!(run.offsets[1], [UNSET; 3], "{post} {letters:?}");
+    }
+}
+
+#[test]
+fn the_standard_program_on_an_inverted_machine_does_not_find_the_part() {
+    for (post, c) in POSTS.iter().flat_map(|p| cases().into_iter().map(move |c| (*p, c))) {
+        if !c.found.iter().any(|&a| a < 2) {
+            continue;
+        }
+        let program = post_for(post, &records(&c), &[]);
+        for letters in &MACHINES[1..] {
+            let flip = flip_of(letters);
+            if !c.found.iter().any(|&a| flip[a]) {
+                continue; // nothing measured on the inverted axis
+            }
+            let run = simulate(&program, flip, &c.shape, SHIFT);
+            assert!(!correct(&run, &c, flip, SHIFT), "{post}: {} untranslated on {letters:?} passed: {run:?}", c.name);
+        }
+    }
+}
+
+/// What a probing program must do on the machine `flip`: set the right
+/// offset for a part within reach, and alarm "no contact" (writing
+/// nothing) for one 7 mm past the first touch's overtravel.
+fn behaves(program: &str, c: &Case, flip: [bool; 3]) -> bool {
+    let u = c.params.dir.unit();
+    let away = [7.0 * u.x, 7.0 * u.y, 7.0 * u.z];
+    let far = simulate(program, flip, &c.shape, away);
+    correct(&simulate(program, flip, &c.shape, SHIFT), c, flip, SHIFT)
+        && far.stop == Stop::Alarm(2, "PROBE NO CONTACT".into())
+        && far.offsets[1] == [UNSET; 3]
+}
+
+/// Undo one word of the translation in a record.
+type Undo = fn(&mut Record);
+
+/// Each probing word the translation negates is load-bearing: undo one
+/// (after the engine's own translation) and the inverted machine
+/// crashes, alarms or sets a wrong offset - or, for the touch target,
+/// probes past its overtravel instead of alarming "no contact" (the
+/// skip runs on toward the wrong end, so a part out of reach is driven
+/// into rather than reported).
+#[test]
+fn every_translated_probing_word_is_needed() {
+    let (x, flip) = (invert::Flip { x: true, y: false, z: false }, [true, false, false]);
+    let corners = || cases().into_iter().filter(|c| c.name.starts_with("corner"));
+    for (post, c) in POSTS.iter().flat_map(|p| corners().map(move |c| (*p, c))) {
+        let mirrored = invert::translate_with(records(&c), x, true).expect("translates");
+        // The pre-translated stream on a standard post is the engine's
+        // own (less the header line naming the machine's inverted axis).
+        let body = |p: String| p.lines().filter(|l| !l.starts_with("(MACHINE ")).collect::<Vec<_>>().join("\n");
+        assert_eq!(body(post_for(post, &mirrored, &[])), body(post_for(post, &records(&c), &["X"])), "{post}: {}", c.name);
+        assert!(behaves(&post_for(post, &mirrored, &[]), &c, flip), "{post}: {}: the full translation", c.name);
+        let undo: [(&str, Undo); 3] = [
+            ("touch target", |r| {
+                if let Record::Touch(t) = r {
+                    t.target[0] = -t.target[0];
+                }
+            }),
+            ("back-off delta", |r| {
+                if let Record::Retreat(t) = r {
+                    t.delta[0] = -t.delta[0];
+                }
+            }),
+            ("found expected", |r| {
+                if let Record::Found(f) = r {
+                    f.axes.iter_mut().filter(|a| a.axis == 0).for_each(|a| a.expected = -a.expected);
+                }
+            }),
+        ];
+        for (what, f) in undo {
+            let mut broken = mirrored.clone();
+            broken.iter_mut().for_each(f);
+            assert!(!behaves(&post_for(post, &broken, &[]), &c, flip), "{post}: {}: passes without the {what}", c.name);
+        }
+    }
+}
+
+/// Every shipped post that translates an inverted axis now also
+/// declares its probing verified, so the refusal is pinned on a shipped
+/// script with the flag taken out: still refused by name.
+#[test]
+fn probing_through_an_unverified_script_still_refuses_by_name() {
+    let c = cases().into_iter().find(|c| c.name == "bore").expect("bore");
+    let stream = cnc::serialize(&records(&c));
+    for post in POSTS {
+        let e = engine::run(&without_probe_flag(post), &machine(&["X"]), &stream)
+            .map(|o| o.program)
+            .expect_err("refused")
+            .to_string();
+        assert_eq!(
+            e,
+            "machine VMC 3-AXIS has an inverted X axis: operation Probe1: probing with a post script that does \
+             not declare probeAxisInversion = true (Fanuc and Haas do) is not supported for an inverted axis yet",
+            "{post}"
+        );
+    }
+    let probing = invert::translate(records(&c), invert::Flip { x: false, y: true, z: false });
+    assert!(probing.is_err_and(|e| e.iter().any(|l| l.contains("probeAxisInversion"))), "plain translate refuses");
+}
+
+/// Declaring the flag changes nothing on a standard machine: every
+/// case posts byte for byte as the script without it (the Haas probe
+/// golden from #173 stays as it was, too).
+#[test]
+fn an_uninverted_program_is_unchanged_by_the_flag() {
+    for (post, c) in POSTS.iter().flat_map(|p| cases().into_iter().map(move |c| (*p, c))) {
+        let recs = records(&c);
+        assert_eq!(post_for(post, &recs, &[]), post_with(&without_probe_flag(post), &recs, &[]), "{post}: {}", c.name);
+    }
+}
+
+/// The reader itself: both deviation forms (main's `a--b` and #377's
+/// folded `a+b`) read alike, brackets and ABS nest, IF..GOTO jumps, and
+/// an unmodelled word is an error rather than a pass.
+#[test]
+fn the_macro_reader_reads_both_sign_forms() {
+    let program = "#100=5\n#101=#100--2.5\n#102=#100+2.5\n#103=[[#101+#102]/2]-ABS[-1]\n\
+                   IF[#101EQ#102]GOTO7\n#3000=9(NOT EQUAL)\nN7G10L2P3X[#101]Y[#102]Z#103\nM30";
+    let run = macro_b::run(program, [false; 3], [[0.0; 3]; 6], &|_| false).expect("reads");
+    assert_eq!(run.stop, Stop::End);
+    assert_eq!(run.offsets[2], [7.5, 7.5, 6.5]);
+    let bad = macro_b::run("G90 G02 X1 Y1 I1", [false; 3], [[0.0; 3]; 6], &|_| false);
+    assert!(bad.is_err_and(|e| e.contains("G2 is not modelled")), "an arc is not a probing block");
+}
diff --git a/crates/app/tests/inverted_support/mod.rs b/crates/app/tests/inverted_support/mod.rs
new file mode 100644
index 00000000..82c38f6a
--- /dev/null
+++ b/crates/app/tests/inverted_support/mod.rs
@@ -0,0 +1,328 @@
+//! Shared fixtures for the inverted-axis post suites (#374): the probe
+//! stream (lines, G2/G3 in all three planes, cutter compensation, a
+//! drilled hole, a non-zero work-offset origin), the inverted machines,
+//! and a small RS-274 interpreter that reads a posted program the way a
+//! controller with inverted axes does and maps it back to the physical
+//! (CAM) frame.
+//!
+//! Provenance: RS-274 / NIST RS274NGC (NISTIR 6300) word semantics - G0
+//! G1 G2 G3, G17/G18/G19 plane select, I/J/K as start-relative centre
+//! increments, G2/G3 sense seen from the plane normal's positive end,
+//! G41/G42 left/right of the travel, G81-family holes at X Y. Fixture
+//! values are our own invention.
+#![allow(dead_code)]
+
+use camcraft_app::cl::{ArcPlane, CompSide, CycleKind, MoveKind};
+use camcraft_app::post::cnc::{self, CycleRec, MoveRec, Record};
+use serde_json::{json, Value};
+use std::path::{Path, PathBuf};
+
+pub const ORIGIN: [f64; 3] = [10.0, 20.0, 0.0];
+
+pub fn repo(rel: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("../../").join(rel)
+}
+
+pub fn read(rel: &str) -> String {
+    std::fs::read_to_string(repo(rel)).unwrap_or_else(|e| panic!("{rel}: {e}"))
+}
+
+pub fn cps(stem: &str) -> String {
+    read(&format!("assets/posts/{stem}.cps"))
+}
+
+/// The shipped 3-axis machine, stating `letters` inverted the way the
+/// mirror does (`invertedAxes`).
+pub fn machine(letters: &[&str]) -> Value {
+    let mut m: Value = serde_json::from_str(&read("assets/machines/3axis-vmc.mch")).expect("machine json");
+    if !letters.is_empty()
+        && let Some(o) = m.as_object_mut()
+    {
+        o.insert("invertedAxes".into(), json!(letters));
+    }
+    m
+}
+
+pub fn mv(kind: MoveKind, p: [f64; 3], feed: Option<f64>) -> Record {
+    Record::Move(MoveRec { kind, x: p[0], y: p[1], z: p[2], feed, center: None, ccw: false, plane: ArcPlane::Xy, abc: None })
+}
+
+pub fn arc(p: [f64; 3], center: (f64, f64), ccw: bool, plane: ArcPlane) -> Record {
+    Record::Move(MoveRec {
+        kind: MoveKind::Feed,
+        x: p[0],
+        y: p[1],
+        z: p[2],
+        feed: Some(400.0),
+        center: Some(center),
+        ccw,
+        plane,
+        abc: None,
+    })
+}
+
+/// The probe stream: every word the translation touches.
+pub fn probe_records() -> Vec<Record> {
+    use MoveKind::{Feed, Plunge, Rapid};
+    let mut r = vec![
+        Record::Param { name: "OperationName".into(), value: json!("Mirror probe") },
+        Record::Param { name: "SpindleSpeed".into(), value: json!(8000) },
+        Record::Param { name: "WorkOffset".into(), value: json!("G54") },
+        Record::Param { name: "OriginX".into(), value: json!(ORIGIN[0]) },
+        Record::Param { name: "OriginY".into(), value: json!(ORIGIN[1]) },
+        Record::Param { name: "OriginZ".into(), value: json!(ORIGIN[2]) },
+        Record::Param { name: "StockXYLeft".into(), value: json!(0.0) },
+        Record::Param { name: "StockXYRight".into(), value: json!(80.0) },
+        Record::Param { name: "StockXYFront".into(), value: json!(0.0) },
+        Record::Param { name: "StockXYBack".into(), value: json!(60.0) },
+        Record::Tool { number: 1, name: "6MM END MILL".into() },
+        Record::Section { begin: true },
+        mv(Rapid, [30.0, 30.0, 5.0], None),
+        mv(Plunge, [30.0, 30.0, -1.0], Some(200.0)),
+        mv(Feed, [50.0, 30.0, -1.0], Some(600.0)),
+        // G17: a CCW quarter, then a CW three-quarter about one centre.
+        arc([60.0, 40.0, -1.0], (50.0, 40.0), true, ArcPlane::Xy),
+        arc([50.0, 50.0, -1.0], (50.0, 40.0), false, ArcPlane::Xy),
+        mv(Feed, [40.0, 50.0, -1.0], Some(600.0)),
+        // G18 (centre X Z) and G19 (centre Y Z) quarters.
+        arc([35.0, 50.0, 4.0], (35.0, -1.0), true, ArcPlane::Xz),
+        arc([35.0, 45.0, -1.0], (45.0, 4.0), false, ArcPlane::Yz),
+        // Back in G17 before compensation engages (the comp plane).
+        arc([35.0, 35.0, -1.0], (35.0, 40.0), true, ArcPlane::Xy),
+        // Control compensation: engage on a straight lead, a compensated
+        // arc, cancel on a straight lead-out.
+        Record::Comp { side: Some(CompSide::Left), radius_mm: 3.0, wear: false },
+        mv(Feed, [35.0, 30.0, -1.0], Some(600.0)),
+        mv(Feed, [20.0, 30.0, -1.0], Some(600.0)),
+        arc([20.0, 10.0, -1.0], (20.0, 20.0), true, ArcPlane::Xy),
+        Record::Comp { side: None, radius_mm: 3.0, wear: false },
+        mv(Feed, [35.0, 10.0, -1.0], Some(600.0)),
+        mv(Rapid, [35.0, 10.0, 5.0], None),
+    ];
+    let first = r.iter().filter(|x| matches!(x, Record::Move(_))).count();
+    r.push(Record::Cycle(CycleRec {
+        kind: CycleKind::Drill,
+        x: 70.0,
+        y: 20.0,
+        r_z: 2.0,
+        bottom_z: -5.0,
+        entry_z: 0.0,
+        peck: 0.0,
+        dwell: 0.0,
+        first_move: first,
+        feed: Some(150.0),
+    }));
+    r.push(mv(Rapid, [70.0, 20.0, 2.0], None));
+    r.push(mv(Plunge, [70.0, 20.0, -5.0], Some(150.0)));
+    r.push(mv(Rapid, [70.0, 20.0, 2.0], None));
+    r.push(Record::Section { begin: false });
+    r
+}
+
+pub fn probe_stream() -> String {
+    cnc::serialize(&probe_records())
+}
+
+// ------------------------------------------------------------ the physical path
+
+/// One physical event: a motion's sampled points (end last), a hole
+/// centre, or a compensation engage with the physical side.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Event {
+    Motion(Vec<[f64; 3]>),
+    Hole([f64; 2]),
+    Engage(CompSide),
+}
+
+const SAMPLES: usize = 8;
+
+fn normal(plane: u8) -> [f64; 3] {
+    match plane {
+        18 => [0.0, 1.0, 0.0],
+        19 => [1.0, 0.0, 0.0],
+        _ => [0.0, 0.0, 1.0],
+    }
+}
+
+fn cross(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+/// Points along an arc from `s` to `e` about `c` in the plane with
+/// normal `n`, CCW = a positive rotation about `n` (the RS-274 sense:
+/// counter-clockwise seen from the normal's positive end). Rodrigues'
+/// rotation of the start radius; the end is appended exactly.
+pub fn arc_points(s: [f64; 3], e: [f64; 3], c: [f64; 3], n: [f64; 3], ccw: bool) -> Vec<[f64; 3]> {
+    let u = [s[0] - c[0], s[1] - c[1], s[2] - c[2]];
+    let v = [e[0] - c[0], e[1] - c[1], e[2] - c[2]];
+    let mut t = dot(n, cross(u, v)).atan2(dot(u, v));
+    let tau = std::f64::consts::TAU;
+    if ccw && t <= 1e-12 {
+        t += tau;
+    }
+    if !ccw && t >= -1e-12 {
+        t -= tau;
+    }
+    let mut out = Vec::new();
+    for k in 1..SAMPLES {
+        let a = t * k as f64 / SAMPLES as f64;
+        let (sn, cs) = a.sin_cos();
+        let nxu = cross(n, u);
+        let ndu = dot(n, u);
+        let mut p = [0.0; 3];
+        for i in 0..3 {
+            p[i] = c[i] + u[i] * cs + nxu[i] * sn + n[i] * ndu * (1.0 - cs);
+        }
+        out.push(p);
+    }
+    out.push(e);
+    out
+}
+
+/// The CAM path of the probe stream, in world (= physical) millimetres:
+/// what the machine must do. The drilled hole's expanded chain is the
+/// cycle's business, so it is the hole, not three moves.
+pub fn cam_events(records: &[Record]) -> Vec<Event> {
+    let mut ev = Vec::new();
+    let mut pos = [0.0; 3];
+    let mut chain_from = usize::MAX;
+    let mut k = 0usize;
+    for r in records {
+        match r {
+            Record::Move(m) => {
+                let e = [m.x, m.y, m.z];
+                if k < chain_from {
+                    let pts = match m.center {
+                        None => vec![e],
+                        Some((a, b)) => {
+                            let (c, n) = match m.plane {
+                                ArcPlane::Xy => ([a, b, m.z], normal(17)),
+                                ArcPlane::Xz => ([a, m.y, b], normal(18)),
+                                ArcPlane::Yz => ([m.x, a, b], normal(19)),
+                            };
+                            arc_points(pos, e, c, n, m.ccw)
+                        }
+                    };
+                    ev.push(Event::Motion(pts));
+                }
+                pos = e;
+                k += 1;
+            }
+            Record::Cycle(c) => {
+                chain_from = c.first_move;
+                ev.push(Event::Hole([c.x, c.y]));
+            }
+            Record::Comp { side: Some(s), .. } => ev.push(Event::Engage(*s)),
+            _ => {}
+        }
+    }
+    ev
+}
+
+/// Read a posted Fanuc/Haas-family program as a controller whose axes
+/// `flip` are inverted does, and return what the machine physically
+/// does: controller coordinate `c` on an inverted axis is physical
+/// `-c`, plus the work-offset origin. Panics (test-only) on a word this
+/// reader does not model, so an unexpected dialect turn cannot pass.
+pub fn controller_events(program: &str, flip: [bool; 3]) -> Vec<Event> {
+    let sign = |i: usize| if flip[i] { -1.0 } else { 1.0 };
+    let phys = |c: [f64; 3]| [sign(0) * c[0] + ORIGIN[0], sign(1) * c[1] + ORIGIN[1], sign(2) * c[2] + ORIGIN[2]];
+    let mut ev = Vec::new();
+    let (mut pos, mut motion, mut plane, mut in_cycle) = ([0.0f64; 3], 0u32, 17u8, false);
+    let mut comp_pending: Option<u32> = None;
+    for line in program.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('(') || line.starts_with('%') || line.starts_with('O') {
+            continue;
+        }
+        let words: Vec<(char, f64)> = line
+            .split_whitespace()
+            .filter_map(|w| {
+                let mut ch = w.chars();
+                let l = ch.next()?;
+                ch.as_str().parse::<f64>().ok().map(|v| (l, v))
+            })
+            .collect();
+        let gs: Vec<u32> = words.iter().filter(|(l, _)| *l == 'G').map(|(_, v)| (v * 10.0).round() as u32).collect();
+        if gs.contains(&280) {
+            continue; // the reference return home is no part of the path
+        }
+        assert!(!gs.contains(&910), "incremental mode is not modelled: {line}");
+        let get = |l: char| words.iter().find(|(c, _)| *c == l).map(|(_, v)| *v);
+        for g in &gs {
+            match g {
+                0 | 10 | 20 | 30 => {
+                    motion = *g;
+                    in_cycle = false;
+                }
+                170 => plane = 17,
+                180 => plane = 18,
+                190 => plane = 19,
+                410 | 420 => comp_pending = Some(*g),
+                800 => in_cycle = false,
+                730 | 810 | 820 | 830 | 840 | 860 | 890 => {
+                    in_cycle = true;
+                }
+                _ => {}
+            }
+        }
+        let (x, y, z) = (get('X'), get('Y'), get('Z'));
+        if x.is_none() && y.is_none() && z.is_none() {
+            continue;
+        }
+        if in_cycle {
+            let h = phys([x.unwrap_or(pos[0]), y.unwrap_or(pos[1]), 0.0]);
+            ev.push(Event::Hole([h[0], h[1]]));
+            continue;
+        }
+        let end = [x.unwrap_or(pos[0]), y.unwrap_or(pos[1]), z.unwrap_or(pos[2])];
+        if let Some(g) = comp_pending.take() {
+            assert_eq!(motion, 10, "comp engages on a G1: {line}");
+            // The controller offsets left (G41) / right (G42) of its own
+            // travel; map both vectors to the physical frame and read
+            // which side that is there.
+            let d = [end[0] - pos[0], end[1] - pos[1], 0.0];
+            let left = [-d[1], d[0], 0.0];
+            let off = if g == 410 { left } else { [-left[0], -left[1], 0.0] };
+            let dp = [sign(0) * d[0], sign(1) * d[1], 0.0];
+            let op = [sign(0) * off[0], sign(1) * off[1], 0.0];
+            let side = if cross(dp, op)[2] > 0.0 { CompSide::Left } else { CompSide::Right };
+            ev.push(Event::Engage(side));
+        }
+        let pts = match motion {
+            20 | 30 => {
+                let (i, j, k) = (get('I').unwrap_or(0.0), get('J').unwrap_or(0.0), get('K').unwrap_or(0.0));
+                let c = [pos[0] + i, pos[1] + j, pos[2] + k];
+                arc_points(pos, end, c, normal(plane), motion == 30)
+            }
+            _ => vec![end],
+        };
+        ev.push(Event::Motion(pts.into_iter().map(phys).collect()));
+        pos = end;
+    }
+    ev
+}
+
+/// The two event lists agree within `tol` mm, event by event.
+pub fn assert_same_path(want: &[Event], got: &[Event], tol: f64, what: &str) {
+    assert_eq!(want.len(), got.len(), "{what}: event count\nwant {want:?}\ngot  {got:?}");
+    for (n, (a, b)) in want.iter().zip(got).enumerate() {
+        match (a, b) {
+            (Event::Motion(pa), Event::Motion(pb)) => {
+                assert_eq!(pa.len(), pb.len(), "{what}: event {n} sample count");
+                for (p, q) in pa.iter().zip(pb) {
+                    let d = ((p[0] - q[0]).powi(2) + (p[1] - q[1]).powi(2) + (p[2] - q[2]).powi(2)).sqrt();
+                    assert!(d <= tol, "{what}: event {n} strays {d:.4} mm: CAM {p:?} vs machine {q:?}");
+                }
+            }
+            (Event::Hole(p), Event::Hole(q)) => {
+                assert!((p[0] - q[0]).abs() <= tol && (p[1] - q[1]).abs() <= tol, "{what}: hole {n}: {p:?} vs {q:?}");
+            }
+            _ => assert_eq!(a, b, "{what}: event {n}"),
+        }
+    }
+}
diff --git a/crates/app/tests/lathe_blade_corner.rs b/crates/app/tests/lathe_blade_corner.rs
new file mode 100644
index 00000000..4dc105cd
--- /dev/null
+++ b/crates/app/tests/lathe_blade_corner.rs
@@ -0,0 +1,222 @@
+//! #641: a grooving/parting blade is touched off on a CORNER of its tip
+//! edge (LinuxCNC Lathe User Information 4.2), and the lathe posts
+//! write that corner - the blade kernels' CL (the middle of the tip
+//! edge) moved half a width along Z. A 3 mm groove centred at Z-10
+//! posts Z-11.5 on the default left corner, Z-8.5 on the right one, and
+//! Z-10 only on a blade touched off at its width centre; a part-off
+//! leaves the part the verified kerf leaves; a code that is no OD blade
+//! is refused by name; the corner edit is one undoable command; the
+//! cached toolpath the verifier and the stock sim judge stays the
+//! middle of the edge.
+//!
+//! Gate map (M4.4): covers app::posting (op_streams, the nose module's
+//! blade branch), app::orientation (blade corners), app::commands
+//! (ChangeTool on a blade).
+//! Lane shape: seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    AddTool, ChangeTool, CreateOperation, GenerateOperation, History, ImportModel, LoadMachine, SetStock,
+};
+use camcraft_app::cl::MoveKind;
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::machine::{Coolant, Machine};
+use camcraft_app::model;
+use camcraft_app::operation::{self, Height, OpParams, OpStatus, SrcRef};
+use camcraft_app::post::{cnc, engine};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+
+const TAU: f64 = std::f64::consts::TAU;
+const LATHE_CPS: &str = include_str!("../../../assets/posts/fanuc-lathe.cps");
+/// A 3 mm grooving/parting blade.
+const GT: &str = "GT-0300";
+const W: f64 = 3.0;
+/// The bar: Ø12, Z-40..0, a 3 mm groove to r4 centred at Z-10.
+const BAR: [(f64, f64); 8] =
+    [(0.0, -40.0), (6.0, -40.0), (6.0, -11.5), (4.0, -11.5), (4.0, -8.5), (6.0, -8.5), (6.0, 0.0), (0.0, 0.0)];
+
+fn revolve(meridian: &[(f64, f64)], segs: usize) -> Mesh {
+    let v = |j: usize, r: f64, z: f64| {
+        let th = TAU * j as f64 / segs as f64;
+        Point3::new(r * th.cos(), r * th.sin(), z)
+    };
+    let mut facets = Vec::new();
+    for seg in meridian.windows(2) {
+        let ((ra, za), (rb, zb)) = (seg[0], seg[1]);
+        for j in 0..segs {
+            let (a1, a2, b1, b2) = (v(j, ra, za), v(j + 1, ra, za), v(j, rb, zb), v(j + 1, rb, zb));
+            if ra <= 1e-12 {
+                facets.push(Triangle::new(a1, b2, b1));
+            } else if rb <= 1e-12 {
+                facets.push(Triangle::new(a1, a2, b2));
+            } else {
+                facets.push(Triangle::new(a1, a2, b2));
+                facets.push(Triangle::new(a1, b2, b1));
+            }
+        }
+    }
+    Mesh::from_facets(facets)
+}
+
+fn bar_world() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    let at = Location { pos: Point3::new(0.0, 0.0, -40.0), ..Location::default() };
+    let cmd = SetStock::new(&world, camcraft_app::stock::StockShape::Cylinder { diameter: 12.0, height: 40.0 }, at);
+    history.execute(&world, cmd.expect("bar stock"));
+    let lathe = Machine {
+        model: "TestBench lathe".into(),
+        kind: Some("lathe".into()),
+        spindle_max: Some(12000.0),
+        coolants: vec![Coolant { name: "Flood".into(), m_code: "M8".into() }],
+        ..Default::default()
+    };
+    history.execute(&world, LoadMachine::new(&world, "lathe.mch".into(), Some(lathe)).expect("lathe"));
+    let blade = catalog().into_iter().find(|(n, _)| *n == GT).map(|(_, t)| t).expect("catalog blade");
+    assert!((blade.width - W).abs() < 1e-12, "the fixture's blade is 3 mm wide");
+    history.execute(&world, AddTool::new(&world, GT, blade).expect("blade"));
+    history.execute(&world, ImportModel::from_mesh("bar", revolve(&BAR, 32)));
+    (world, history)
+}
+
+fn create(world: &World, history: &mut History, name: &str, params: OpParams) {
+    let cmd = CreateOperation::new(world, name, GT, SrcRef::Entity("bar".into()), params).expect("create");
+    history.execute(world, cmd);
+    history.execute(world, GenerateOperation::new(world, name).expect("generate"));
+    let e = model::find_by_name(world, name).expect("op");
+    assert_eq!(operation::status_of(world, &e), OpStatus::Ok, "{name} generates");
+}
+
+fn groove() -> OpParams {
+    OpParams::GrooveFinish {
+        tolerance: 0.05,
+        clearance_z: Height::fixed(10.0),
+        top_z: Height::fixed(-8.5),
+        bottom_z: Height::fixed(-11.5),
+        feed: 120.0,
+        plunge_feed: 60.0,
+    }
+}
+
+fn part() -> OpParams {
+    OpParams::Part {
+        tolerance: 0.05,
+        clearance_z: Height::fixed(10.0),
+        top_z: Height::fixed(0.0),
+        bottom_z: Height::fixed(-20.0),
+        stepdown: 1.0,
+        feed: 120.0,
+        plunge_feed: 60.0,
+        bar_load: false,
+        bar_advance: 0.0,
+        bar_unload: false,
+        bar_transfer: false,
+        inspect_tol: 0.0,
+    }
+}
+
+fn set_corner(world: &World, history: &mut History, q: Option<u8>) {
+    let e = model::find_by_name(world, GT).expect("tool");
+    let mut t = model::tool_of(world, &e).expect("a tool");
+    t.orientation = q;
+    history.execute(world, ChangeTool::new(world, GT, t).expect("a sane corner"));
+}
+
+/// The posted feed moves' Z (the plunges), in stream order.
+fn posted_plunge_z(world: &World) -> Vec<f64> {
+    posting::stream_records(world)
+        .expect("posts")
+        .into_iter()
+        .filter_map(|r| match r {
+            cnc::Record::Move(m) if m.kind != MoveKind::Rapid => Some(m.z),
+            _ => None,
+        })
+        .collect()
+}
+
+fn cached_z(world: &World, op: &str) -> Vec<f64> {
+    let e = model::find_by_name(world, op).expect("op");
+    model::toolpath_of(world, &e).expect("cache").path.moves.iter().map(|m| m.to.z).collect()
+}
+
+fn program(world: &World) -> String {
+    let records = posting::stream_records(world).expect("posts");
+    engine::run(LATHE_CPS, &posting::machine_value(world), &cnc::serialize(&records))
+        .expect("the lathe script runs")
+        .program
+}
+
+fn all_at(zs: &[f64], z: f64, what: &str) {
+    assert!(!zs.is_empty(), "{what}: no plunges posted");
+    assert!(zs.iter().all(|v| (v - z).abs() < 1e-6), "{what}: plunges at {zs:?}, wanted Z{z}");
+}
+
+#[test]
+fn a_3mm_groove_at_z_minus_10_posts_the_touched_off_corner() {
+    let (world, mut history) = bar_world();
+    create(&world, &mut history, "G1", groove());
+    all_at(&posted_plunge_z(&world), -11.5, "the default left corner");
+    let text = program(&world);
+    assert!(text.contains("X8 Z-11.5 "), "the r4 floor at the left corner: {text}");
+    assert!(!text.contains("Z-10 "), "never the middle of the blade: {text}");
+    assert!(text.contains("ORIENTATION 2)"), "the tool note names the corner: {text}");
+    set_corner(&world, &mut history, Some(1));
+    all_at(&posted_plunge_z(&world), -8.5, "the right corner");
+    set_corner(&world, &mut history, Some(6));
+    all_at(&posted_plunge_z(&world), -10.0, "the width centre");
+    // The verifier's and the stock sim's truth is untouched: the
+    // cache is still the middle of the tip edge.
+    let e = model::find_by_name(&world, "G1").expect("op");
+    assert_eq!(operation::status_of(&world, &e), OpStatus::Ok, "a corner edit never stales the path");
+    let cz = cached_z(&world, "G1");
+    assert!(cz.iter().any(|z| (z + 10.0).abs() < 1e-6), "the cache plunges at the centre: {cz:?}");
+}
+
+#[test]
+fn a_part_off_leaves_the_part_the_verified_kerf_leaves() {
+    // Parting plane Z-20, a 3 mm kerf centred on it: the part keeps
+    // Z-18.5..0. Whichever corner the blade was touched off on, the
+    // posted plunge puts the kerf's free-end face at Z-18.5 - before
+    // #641 the left-corner blade posted Z-20 and left 17 mm.
+    for (q, side) in [(None, -1.0), (Some(2), -1.0), (Some(1), 1.0), (Some(6), 0.0)] {
+        let (world, mut history) = bar_world();
+        create(&world, &mut history, "P1", part());
+        set_corner(&world, &mut history, q);
+        let zs = posted_plunge_z(&world);
+        all_at(&zs, -20.0 + side * W * 0.5, &format!("corner {q:?}"));
+        let face = zs[0] - side * W * 0.5 + W * 0.5;
+        assert!((face + 18.5).abs() < 1e-6, "corner {q:?}: the part's back face at {face}, wanted -18.5");
+    }
+}
+
+#[test]
+fn a_code_that_is_no_od_blade_is_refused_by_name() {
+    let (world, mut history) = bar_world();
+    create(&world, &mut history, "G1", groove());
+    for q in [3u8, 4, 5, 7, 8] {
+        set_corner(&world, &mut history, Some(q));
+        let e = posting::stream_records(&world).expect_err("no OD blade");
+        assert!(e.contains("orientation [1, 2, 6]") && e.contains(&format!("is orientation {q}")), "{e}");
+        assert!(e.contains("G1") && e.contains(GT), "the refusal names the operation and the blade: {e}");
+    }
+}
+
+#[test]
+fn the_corner_edit_is_one_undoable_command() {
+    let (world, mut history) = bar_world();
+    create(&world, &mut history, "G1", groove());
+    let e = model::find_by_name(&world, GT).expect("tool");
+    assert_eq!(model::tool_of(&world, &e).and_then(|t| t.lathe_orientation()), Some(2), "the left-corner default");
+    set_corner(&world, &mut history, Some(1));
+    all_at(&posted_plunge_z(&world), -8.5, "after the edit");
+    assert!(history.undo(&world));
+    assert_eq!(model::tool_of(&world, &e).and_then(|t| t.orientation), None, "undo restores the unstated default");
+    all_at(&posted_plunge_z(&world), -11.5, "after undo");
+    assert!(history.redo(&world));
+    assert_eq!(model::tool_of(&world, &e).and_then(|t| t.orientation), Some(1));
+    all_at(&posted_plunge_z(&world), -8.5, "after redo");
+}
