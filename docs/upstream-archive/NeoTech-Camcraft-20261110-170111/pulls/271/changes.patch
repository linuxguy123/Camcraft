+fn the_file_read_refuses_missing_and_unknown_files_by_name() {
+    let dir = std::env::temp_dir().join(format!("cc-371-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("temp dir");
+    let missing = view::load(&dir.join("absent.stl")).expect_err("missing file");
+    assert!(!missing.is_empty());
+    let odd = dir.join("body.txt");
+    std::fs::write(&odd, "x").expect("write");
+    let e = view::load(&odd).expect_err("unknown extension");
+    assert!(e.contains("unsupported"), "{e}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn the_display_assembly_runs_from_the_tip_through_the_shank_into_the_body() {
+    let t = catalog_tool(TOOL);
+    let zs = t.flute_len + t.shank_len;
+    let zr = |tris: &[Triangle]| {
+        tris.iter().flat_map(|q| [q.a.z, q.b.z, q.c.z]).fold((f64::INFINITY, f64::NEG_INFINITY), |a, z| (a.0.min(z), a.1.max(z)))
+    };
+    let r_at = |tris: &[Triangle], z: f64| {
+        tris.iter().flat_map(|q| [q.a, q.b, q.c]).filter(|p| (p.z - z).abs() < 1e-9).map(|p| p.x.hypot(p.y)).fold(0.0, f64::max)
+    };
+    // Seated on the shank top.
+    let body = view::preview(&prism(20.0, 0.0, 30.0, 16), [0.0, 0.0, 1.0], zs).expect("seated");
+    let all = view::assembly(&t, &body);
+    assert_eq!(zr(&all), (0.0, zs + 30.0));
+    let steel = &all[..all.len() - body.facets.len()];
+    assert_eq!(zr(steel), (0.0, zs), "cutter and shank stop at the shank top");
+    assert!((r_at(steel, 0.0) - t.diameter * 0.5).abs() < 1e-9, "the cutter's radius at the tip");
+    assert!((r_at(steel, zs) - t.shank_d * 0.5).abs() < 1e-9, "the shank's radius at its top");
+    // Standing 10 mm clear: the shank is carried up to the body's foot.
+    let high = view::preview(&prism(20.0, 0.0, 30.0, 16), [0.0, 0.0, 1.0], zs + 10.0).expect("clear");
+    let all = view::assembly(&t, &high);
+    let steel = &all[..all.len() - high.facets.len()];
+    assert!((zr(steel).1 - (zs + 10.0)).abs() < 1e-9, "no floating body");
+}
+
+#[test]
+fn without_a_body_the_display_is_the_profile_with_its_holder_cylinder() {
+    let t = catalog_tool(TOOL);
+    let tris = view::bare_assembly(&t).expect("a mill draws");
+    let zh = t.flute_len + t.shank_len + t.holder_len;
+    let (lo, hi) = tris.iter().flat_map(|q| [q.a.z, q.b.z, q.c.z]).fold((f64::INFINITY, f64::NEG_INFINITY), |a, z| (a.0.min(z), a.1.max(z)));
+    assert_eq!((lo, hi), (0.0, zh), "tip to the holder's top");
+    let r_top = tris.iter().flat_map(|q| [q.a, q.b, q.c]).filter(|p| (p.z - zh).abs() < 1e-9).map(|p| p.x.hypot(p.y)).fold(0.0, f64::max);
+    assert!((r_top - t.holder_d * 0.5).abs() < 1e-9, "the holder cylinder's radius");
+    // The lathe insert kinds keep the marker only.
+    let insert = catalog().into_iter().map(|(_, t)| t).find(|t| t.kind == camcraft_app::tools::ToolKind::Turning).expect("a turning insert in the catalog");
+    assert!(view::bare_assembly(&insert).is_none());
+}
diff --git a/crates/app/tests/tool_csys.rs b/crates/app/tests/tool_csys.rs
new file mode 100644
index 00000000..8482fd68
--- /dev/null
+++ b/crates/app/tests/tool_csys.rs
@@ -0,0 +1,189 @@
+//! #370: a vendor tool STEP's named coordinate systems (ISO 13399 PCS,
+//! MCS, CIP, CSW...) read as plain data; a file without them names why;
+//! degenerate, non-finite or ambiguous ones are refused by name.
+//! Fixtures are hand-written Part 21 text in testdata/models/.
+//!
+//! Gate map (M4.4): covers app::geometry.
+
+use std::path::{Path, PathBuf};
+
+use camcraft_app::geometry::import::step_csys::{read_tool_csys, CsysRole, ToolCsysReport};
+use camcraft_app::geometry::import::ImportError;
+
+fn testdata(name: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../testdata/models")
+        .join(name)
+}
+
+fn read(name: &str) -> ToolCsysReport {
+    let bytes = std::fs::read(testdata(name)).expect("fixture reads");
+    read_tool_csys(&bytes).expect("fixture parses")
+}
+
+fn close(a: [f64; 3], b: [f64; 3]) -> bool {
+    a.iter().zip(b).all(|(u, v)| (u - v).abs() < 1e-12)
+}
+
+#[test]
+fn iso_13399_coordinate_systems_are_found_and_classified() {
+    let r = read("tool_csys_iso13399.step");
+    assert!(r.refused.is_empty(), "{:?}", r.refused);
+    assert_eq!(r.none_found(), None);
+
+    let pcs = r.find(CsysRole::Primary).expect("PCS");
+    assert!(close(pcs.origin, [0.0, 0.0, 0.0]));
+    assert!(close(pcs.z, [0.0, 0.0, 1.0]) && close(pcs.x, [1.0, 0.0, 0.0]));
+
+    let mcs = r.find(CsysRole::Mounting).expect("MCS");
+    assert!(close(mcs.origin, [0.0, 0.0, -40.0]), "{:?}", mcs.origin);
+
+    // The CIP's ref direction (2, 0, 0.5) is not normal to its axis: the
+    // x axis is its projection, unit length, and y completes the frame.
+    let cip = r.find(CsysRole::InProcess).expect("CIP");
+    assert!(close(cip.origin, [0.0, 0.0, -75.0]));
+    assert!(close(cip.x, [1.0, 0.0, 0.0]), "{:?}", cip.x);
+    assert!(close(cip.y(), [0.0, 1.0, 0.0]), "{:?}", cip.y());
+
+    // Written twice at one placement: one coordinate system, not two.
+    let csw = r
+        .find(CsysRole::WorkpieceSide {
+            level: Some(1),
+            number: Some(2),
+        })
+        .expect("CSW1_2");
+    assert_eq!(csw.entity, 60);
+    assert!(close(csw.origin, [10.0, 0.0, -20.0]));
+
+    // A vendor's own name is data, not a role; unnamed placements are
+    // surfaces, not coordinate systems.
+    let names: Vec<&str> = r.systems.iter().map(|c| c.name.as_str()).collect();
+    assert_eq!(names, ["PCS", "MCS", "CIP", "CSW1_2", "VENDOR_REF"]);
+    let vendor = r.systems.iter().find(|c| c.role == CsysRole::Other);
+    assert!(vendor.is_some_and(|c| close(c.z, [0.0, 0.0, 1.0])));
+}
+
+#[test]
+fn a_file_without_tool_coordinate_systems_says_so_by_name() {
+    let r = read("tool_csys_none.step");
+    assert!(r.systems.is_empty() && r.refused.is_empty(), "{r:?}");
+    assert_eq!(
+        r.none_found().as_deref(),
+        Some("the file names no coordinate systems")
+    );
+    let missing = r.find(CsysRole::Primary).expect_err("no PCS");
+    assert!(missing.contains("no Primary"), "{missing}");
+
+    // Named, but none of them an ISO 13399 name: the reason lists them.
+    let text = std::fs::read_to_string(testdata("tool_csys_none.step"))
+        .expect("fixture reads")
+        .replace(
+            "AXIS2_PLACEMENT_3D('', #31",
+            "AXIS2_PLACEMENT_3D('Origin', #31",
+        );
+    let r = read_tool_csys(text.as_bytes()).expect("parses");
+    let why = r.none_found().expect("falls back");
+    assert!(
+        why.contains("no named coordinate system is an ISO 13399 one"),
+        "{why}"
+    );
+    assert!(why.contains("Origin"), "{why}");
+}
+
+#[test]
+fn degenerate_or_ambiguous_coordinate_systems_are_refused_by_name() {
+    let r = read("tool_csys_degenerate.step");
+    assert!(r.systems.is_empty(), "{:?}", r.systems);
+    let reason = |name: &str| {
+        r.refused
+            .iter()
+            .find(|f| f.name == name)
+            .map(|f| f.reason.clone())
+            .unwrap_or_default()
+    };
+    assert!(
+        reason("PCS").contains("axis has no direction"),
+        "{:?}",
+        r.refused
+    );
+    assert!(
+        reason("MCS").contains("origin is not finite"),
+        "{:?}",
+        r.refused
+    );
+    assert!(
+        reason("CIP").contains("2 different placements"),
+        "{:?}",
+        r.refused
+    );
+    assert!(
+        reason("CSW").contains("parallel to its axis"),
+        "{:?}",
+        r.refused
+    );
+
+    let why = r.none_found().expect("falls back");
+    assert!(
+        why.starts_with("every ISO 13399 coordinate system was refused"),
+        "{why}"
+    );
+    let pcs = r.find(CsysRole::Primary).expect_err("PCS refused");
+    assert!(pcs.contains("Primary refused"), "{pcs}");
+}
+
+#[test]
+fn origins_read_in_the_files_length_unit() {
+    let text = std::fs::read_to_string(testdata("tool_csys_iso13399.step"))
+        .expect("fixture reads")
+        .replace(
+            "#12 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );",
+            "#12 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.CENTI.,.METRE.) );",
+        );
+    let r = read_tool_csys(text.as_bytes()).expect("parses");
+    let mcs = r.find(CsysRole::Mounting).expect("MCS");
+    assert!(close(mcs.origin, [0.0, 0.0, -400.0]), "{:?}", mcs.origin);
+}
+
+#[test]
+fn iso_13399_names_classify_and_others_do_not() {
+    use CsysRole::*;
+    assert_eq!(CsysRole::classify(" pcs "), Primary);
+    assert_eq!(CsysRole::classify("MCS"), Mounting);
+    assert_eq!(CsysRole::classify("CIP"), InProcess);
+    assert_eq!(CsysRole::classify("CSIF"), Interface);
+    let csw = |level, number| WorkpieceSide { level, number };
+    assert_eq!(CsysRole::classify("CSW"), csw(None, None));
+    assert_eq!(CsysRole::classify("CSW2"), csw(Some(2), None));
+    assert_eq!(CsysRole::classify("CSW1_3"), csw(Some(1), Some(3)));
+    for other in ["PCS_1", "CSW_", "CSW1_", "CSWA", "CSW1_2_3", "CSW-1", ""] {
+        assert_eq!(CsysRole::classify(other), Other, "{other}");
+    }
+}
+
+#[test]
+fn unreadable_input_is_a_clean_error_never_a_panic() {
+    assert!(matches!(read_tool_csys(b""), Err(ImportError::Empty)));
+    assert!(matches!(
+        read_tool_csys(b"\xff\xfe"),
+        Err(ImportError::Step(_))
+    ));
+    assert!(matches!(
+        read_tool_csys(b"ISO-10303-21; junk"),
+        Err(ImportError::Step(_))
+    ));
+    // Dangling references and wrong entity kinds refuse the placement.
+    let text = std::fs::read_to_string(testdata("tool_csys_none.step"))
+        .expect("fixture reads")
+        .replace(
+            "AXIS2_PLACEMENT_3D('', #31, #32, #33)",
+            "AXIS2_PLACEMENT_3D('PCS', #99, #20, #33)",
+        );
+    let r = read_tool_csys(text.as_bytes()).expect("parses");
+    assert!(
+        r.refused
+            .iter()
+            .any(|f| f.name == "PCS" && f.reason.contains("#99")),
+        "{:?}",
+        r.refused
+    );
+}
diff --git a/crates/app/tests/tool_library.rs b/crates/app/tests/tool_library.rs
new file mode 100644
index 00000000..54b487ee
--- /dev/null
+++ b/crates/app/tests/tool_library.rs
@@ -0,0 +1,228 @@
+//! #300: the native tool library file. Export writes the document's tools
+//! as `camcraft-tools/1` JSON; import reads it back as one undo unit. The
+//! laws pinned: the round trip is exact; a duplicate name is never
+//! overwritten (identical tool skipped, different tool renamed); a tool
+//! `is_sane` refuses, a corrupt file or malformed JSON refuse the whole
+//! import by name with nothing applied; undo removes exactly the imported
+//! tools and redo brings them back.
+//! Provenance: our own tests over our own format and commands.
+//!
+//! Gate map (M4.4): covers app::tool_library, app::commands (tool_import, tool).
+
+use camcraft_app::commands::{AddTool, History, ImportTools};
+use camcraft_app::model;
+use camcraft_app::project;
+use camcraft_app::tool_library::{
+    LibraryTool, export_tool_library, parse_tool_library, with_library_extension,
+};
+use camcraft_app::tools::{Tool, catalog};
+use camcraft_app::world::new_world;
+use flecs_ecs::prelude::World;
+use serde_json::{Value, json};
+
+fn cat(name: &str) -> Tool {
+    catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog tool")
+}
+
+fn first_two() -> Vec<(&'static str, Tool)> {
+    catalog().into_iter().take(2).collect()
+}
+
+fn world_with(tools: &[(&str, Tool)]) -> (World, History) {
+    let w = new_world();
+    let mut h = History::default();
+    for (n, t) in tools {
+        h.execute(&w, AddTool::new(&w, n, t.clone()).expect("add tool"));
+    }
+    (w, h)
+}
+
+fn tool_named(w: &World, n: &str) -> Option<Tool> {
+    model::find_by_name(w, n).and_then(|e| model::tool_of(w, &e))
+}
+
+fn tool_names(w: &World) -> Vec<String> {
+    model::named_entities(w).into_iter().filter(|(_, e)| model::tool_of(w, e).is_some()).map(|(n, _)| n).collect()
+}
+
+fn import(w: &World, h: &mut History, text: &str) -> Result<camcraft_app::commands::ImportReport, String> {
+    let lib = parse_tool_library(text)?;
+    let cmd = ImportTools::new(w, lib).map_err(|e| e.to_string())?;
+    let report = cmd.report().clone();
+    h.execute(w, cmd);
+    Ok(report)
+}
+
+#[test]
+fn export_then_import_roundtrips_exactly() {
+    let tools = first_two();
+    let (src, _) = world_with(&tools);
+    let text = export_tool_library(&src).expect("export");
+    let v: Value = serde_json::from_str(&text).expect("json");
+    assert_eq!(v["format"], "camcraft-tools");
+    assert_eq!(v["version"], 1);
+    assert_eq!(v["tools"].as_array().map(Vec::len), Some(2));
+    // The MCP definition shape, verbatim.
+    assert_eq!(v["tools"][0]["definition"], project::tool_to_json(&tools[0].1));
+
+    let (dst, mut h) = world_with(&[]);
+    let report = import(&dst, &mut h, &text).expect("import");
+    assert_eq!(report.added.len(), 2);
+    for (n, t) in &tools {
+        assert_eq!(tool_named(&dst, n).as_ref(), Some(t), "{n} round-trips exactly");
+    }
+    // And the second export of the imported document is the same file.
+    assert_eq!(export_tool_library(&dst).expect("re-export"), text);
+}
+
+#[test]
+fn bare_mcp_array_imports_too() {
+    let (n, t) = first_two().remove(0);
+    let text = json!([{ "name": n, "definition": project::tool_to_json(&t) }]).to_string();
+    let (w, mut h) = world_with(&[]);
+    import(&w, &mut h, &text).expect("bare array import");
+    assert_eq!(tool_named(&w, n), Some(t));
+}
+
+#[test]
+fn empty_document_refuses_export() {
+    let (w, _) = world_with(&[]);
+    let err = export_tool_library(&w).expect_err("nothing to export");
+    assert!(err.contains("no tools"), "{err}");
+}
+
+#[test]
+fn duplicate_identical_is_skipped_and_different_is_renamed_never_overwritten() {
+    let tools = first_two();
+    let (src, _) = world_with(&tools);
+    let text = export_tool_library(&src).expect("export");
+
+    // The document already holds tool 0 identically, and a DIFFERENT
+    // tool under tool 1's name.
+    let other = cat("EM-0600-4FL");
+    assert_ne!(other, tools[1].1);
+    let (w, mut h) = world_with(&[(tools[0].0, tools[0].1.clone()), (tools[1].0, other.clone())]);
+    let report = import(&w, &mut h, &text).expect("import");
+    assert_eq!(report.skipped, vec![tools[0].0.to_owned()]);
+    let renamed = format!("{} (2)", tools[1].0);
+    assert_eq!(report.renamed, vec![(tools[1].0.to_owned(), renamed.clone())]);
+    assert!(report.added.is_empty());
+    // The existing tool is untouched; the library's copy sits beside it.
+    assert_eq!(tool_named(&w, tools[1].0), Some(other));
+    assert_eq!(tool_named(&w, &renamed), Some(tools[1].1.clone()));
+    assert!(report.summary().contains("1 renamed"), "{}", report.summary());
+
+    // Importing the same file again renames once more (` (3)`), never overwrites.
+    let report2 = import(&w, &mut h, &text).expect("second import");
+    assert_eq!(report2.renamed[0].1, format!("{} (3)", tools[1].0));
+}
+
+#[test]
+fn library_already_in_document_refuses_with_nothing_applied() {
+    let tools = first_two();
+    let (w, mut h) = world_with(&tools);
+    let text = export_tool_library(&w).expect("export");
+    let before = tool_names(&w);
+    let err = import(&w, &mut h, &text).expect_err("all present");
+    assert!(err.contains("already in the document"), "{err}");
+    assert_eq!(tool_names(&w), before);
+}
+
+#[test]
+fn insane_tool_refuses_whole_file_by_name() {
+    let tools = first_two();
+    let (src, _) = world_with(&tools);
+    let mut v: Value = serde_json::from_str(&export_tool_library(&src).expect("export")).expect("json");
+    v["tools"][1]["definition"]["diameter"] = json!(-3.0);
+    let (w, mut h) = world_with(&[]);
+    let err = import(&w, &mut h, &v.to_string()).expect_err("insane tool");
+    assert!(err.contains(tools[1].0), "names the tool: {err}");
+    assert!(tool_names(&w).is_empty(), "nothing applied");
+    assert!(!h.can_undo());
+}
+
+#[test]
+fn missing_required_field_refuses_by_name() {
+    let tools = first_two();
+    let (src, _) = world_with(&tools);
+    let mut v: Value = serde_json::from_str(&export_tool_library(&src).expect("export")).expect("json");
+    if let Some(d) = v["tools"][0]["definition"].as_object_mut() {
+        d.remove("diameter");
+    }
+    let err = parse_tool_library(&v.to_string()).expect_err("missing diameter");
+    assert!(err.contains(tools[0].0) && err.contains("diameter"), "{err}");
+}
+
+#[test]
+fn malformed_and_foreign_files_refuse_cleanly() {
+    for (text, want) in [
+        ("", "bad JSON"),
+        ("{not json", "bad JSON"),
+        ("42", "expected an object or an array"),
+        (r#"{"format":"something-else","version":1,"tools":[]}"#, "something-else"),
+        (r#"{"format":"camcraft-tools","version":99,"tools":[]}"#, "version 99"),
+        (r#"{"format":"camcraft-tools","version":1}"#, "no \"tools\""),
+        (r#"{"format":"camcraft-tools","version":1,"units":"inch","tools":[]}"#, "units"),
+        (r#"{"format":"camcraft-tools","version":1,"tools":[]}"#, "no tools"),
+        (r#"[{"definition":{}}]"#, "tool #1 has no name"),
+        (r#"[{"name":"A"}]"#, "'A' has no definition"),
+        (r#"[{"name":"A","definition":"x"}]"#, "tool 'A'"),
+    ] {
+        let err = parse_tool_library(text).expect_err(text);
+        assert!(err.contains(want), "{text:?} -> {err}");
+    }
+}
+
+#[test]
+fn name_twice_in_file_refuses() {
+    let (n, t) = first_two().remove(0);
+    let d = project::tool_to_json(&t);
+    let text = json!([{ "name": n, "definition": d }, { "name": n, "definition": d }]).to_string();
+    let err = parse_tool_library(&text).expect_err("twice");
+    assert!(err.contains("twice") && err.contains(n), "{err}");
+}
+
+#[test]
+fn reserved_name_refuses_with_nothing_applied() {
+    let (_, t) = first_two().remove(0);
+    let (w, _) = world_with(&[]);
+    let lib = vec![
+        LibraryTool { name: "Mine".into(), tool: t.clone() },
+        LibraryTool { name: "Stock".into(), tool: t },
+    ];
+    let err = ImportTools::new(&w, lib).err().expect("reserved").to_string();
+    assert!(err.contains("Stock"), "{err}");
+    assert!(tool_names(&w).is_empty());
+}
+
+#[test]
+fn import_is_one_undo_unit_and_redo_restores_it() {
+    let tools = first_two();
+    let (src, _) = world_with(&tools);
+    let text = export_tool_library(&src).expect("export");
+    let keep = cat("EM-0600-4FL");
+    let (w, mut h) = world_with(&[("Keep", keep.clone())]);
+    import(&w, &mut h, &text).expect("import");
+    assert_eq!(tool_names(&w).len(), 3);
+
+    assert!(h.undo(&w));
+    assert_eq!(tool_names(&w), vec!["Keep".to_owned()], "undo removes exactly the imported tools");
+    assert_eq!(tool_named(&w, "Keep"), Some(keep));
+
+    assert!(h.redo(&w));
+    for (n, t) in &tools {
+        assert_eq!(tool_named(&w, n).as_ref(), Some(t));
+    }
+}
+
+/// A name typed without a suffix still writes a `.camtools` file
+/// (macOS's save panel keeps the typed name as is); a name that already
+/// has an extension is kept as typed. Hands-on finding on PR #348.
+#[test]
+fn an_export_name_without_a_suffix_gets_the_library_extension() {
+    use std::path::Path;
+    assert_eq!(with_library_extension(Path::new("/tmp/shop")), Path::new("/tmp/shop.camtools"));
+    assert_eq!(with_library_extension(Path::new("/tmp/shop.camtools")), Path::new("/tmp/shop.camtools"));
+    assert_eq!(with_library_extension(Path::new("/tmp/shop.json")), Path::new("/tmp/shop.json"));
+    assert_eq!(with_library_extension(Path::new("/tmp/my.tools/shop")), Path::new("/tmp/my.tools/shop.camtools"));
+}
diff --git a/crates/app/tests/tool_spun_profile.rs b/crates/app/tests/tool_spun_profile.rs
new file mode 100644
index 00000000..5d8bb93c
--- /dev/null
+++ b/crates/app/tests/tool_spun_profile.rs
@@ -0,0 +1,266 @@
+//! #93 acceptance: a milling tool's holder drawn as a spun (revolved)
+//! profile lands as the tool's body through one undoable command: its
+//! bands are exactly the drawn steps, a drawn collar is judged by the
+//! fixture laws, it saves/loads/undoes, refuses nonsense by name, and
+//! the parametric profile changes nothing for an existing tool.
+//!
+//! Gate map (M4.4): covers app::commands, app::tool_body, app::tool_body_view, app::project, app::schema, app::tools.
+
+use camcraft_app::commands::{AddTool, CommandError, CreateOperation, GenerateOperation, History, SetStock, SetToolBody, TagFixture};
+use camcraft_app::geometry::{Point3, Triangle};
+use camcraft_app::model;
+use camcraft_app::operation::{self, Height, OpParams, SrcRef};
+use camcraft_app::project;
+use camcraft_app::schema::Location;
+use camcraft_app::spun::{SpunPoint, SpunProfile};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tool_body;
+use camcraft_app::tool_body_view;
+use camcraft_app::tools::{catalog, Tool};
+use camcraft_app::verify::{FixturePart, Warning};
+use camcraft_app::world::new_world;
+use camcraft_tools::holder_profile::{HolderBand, HolderStack};
+use flecs_ecs::prelude::World;
+
+const TOOL: &str = "EM-0400-2FL";
+const CUT_Z: f64 = 19.5;
+
+fn catalog_tool(name: &str) -> Tool {
+    catalog().into_iter().find(|(n, _)| *n == name).map(|(_, t)| t).expect("catalog entry")
+}
+
+fn shank_top() -> f64 {
+    let t = catalog_tool(TOOL);
+    t.flute_len + t.shank_len
+}
+
+fn pt(z: f64, r: f64) -> SpunPoint {
+    SpunPoint::line(z, r)
+}
+
+/// A drawn holder: a 15 mm nose over 20 mm, then a 40 mm flange over
+/// 15 mm, on the shank's top.
+fn drawn_collar() -> Vec<SpunPoint> {
+    let z0 = shank_top();
+    vec![pt(z0, 0.0), pt(z0, 15.0), pt(z0 + 20.0, 15.0), pt(z0 + 20.0, 40.0), pt(z0 + 35.0, 40.0), pt(z0 + 35.0, 0.0)]
+}
+
+fn face_world() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(
+        &world,
+        SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location::default()).expect("stock"),
+    );
+    history.execute(&world, AddTool::new(&world, TOOL, catalog_tool(TOOL)).expect("tool"));
+    history.execute(
+        &world,
+        CreateOperation::new(
+            &world,
+            "Face1",
+            TOOL,
+            SrcRef::Stock,
+            OpParams::Face {
+                holes: Default::default(),
+                tilt: None,
+                blend_turns: false,
+                stepover: 3.0,
+                clearance_z: Height::fixed(25.0),
+                cut_z: Height::fixed(CUT_Z),
+                top_z: None,
+                stepdown: None,
+                feed: 1200.0,
+                plunge_feed: 300.0,
+                climb: true,
+            },
+        )
+        .expect("face op"),
+    );
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    (world, history)
+}
+
+fn tool_entity(world: &World) -> flecs_ecs::prelude::Entity {
+    model::find_by_name(world, TOOL).expect("tool")
+}
+
+fn stamp(world: &World) -> Option<u64> {
+    let op = model::operation_of(world, &model::find_by_name(world, "Face1").expect("Face1")).expect("an op");
+    operation::current_stamp(world, &op.tool, &op.src, &op.params, "Face1", op.setup.as_deref()).map(|g| g.0)
+}
+
+/// A post 30 mm off the path's +X edge, `zb` up, `h` tall.
+fn plant_post_at(world: &World, history: &mut History, zb: f64, h: f64) {
+    let op = model::find_by_name(world, "Face1").expect("Face1");
+    let cache = model::toolpath_of(world, &op).expect("generated");
+    let xmax = cache.path.moves.iter().flat_map(|m| [m.from.x, m.to.x]).fold(f64::NEG_INFINITY, f64::max);
+    let (y0, y1) = cache
+        .path
+        .moves
+        .iter()
+        .flat_map(|m| [m.from.y, m.to.y])
+        .fold((f64::INFINITY, f64::NEG_INFINITY), |(a, b), y| (a.min(y), b.max(y)));
+    let (min, max) = (Point3::new(xmax + 30.0, y0, zb), Point3::new(xmax + 34.0, y1, zb + h));
+    let e = model::spawn(world, "Post1");
+    model::set_facets(world, &e, vec![Triangle::new(min, max, Point3::new(min.x, max.y, max.z))].into());
+    model::set_rev(world, &e, 1);
+    history.execute(world, TagFixture::new(world, "Post1", None).expect("tagged"));
+}
+
+fn holder_hits(world: &World) -> usize {
+    let op = model::find_by_name(world, "Face1").expect("Face1");
+    let cache = model::toolpath_of(world, &op).expect("generated");
+    cache.warnings.iter().filter(|w| matches!(w, Warning::FixtureHit { fixture_part: FixturePart::Holder, .. })).count()
+}
+
+#[test]
+fn a_drawn_holder_lands_with_its_bands_exact() {
+    let (world, mut history) = face_world();
+    history.execute(&world, SetToolBody::spun(&world, TOOL, Some(drawn_collar())).expect("a sane profile"));
+    let body = tool_body::body_of(&world, &tool_entity(&world)).expect("landed");
+    assert_eq!(body.source, tool_body::SPUN_SOURCE);
+    assert_eq!(body.spun.as_ref().map(|s| s.points().to_vec()), Some(drawn_collar()));
+    let z0 = shank_top();
+    let profile = body.profile().expect("a spindle-frame body");
+    assert_eq!(
+        profile.bands(),
+        &[HolderBand { above: z0, len: 20.0, r: 15.0 }, HolderBand { above: z0 + 20.0, len: 15.0, r: 40.0 }]
+    );
+    let g = catalog_tool(TOOL).geom();
+    assert_eq!(tool_body::stack(&g, Some(profile)), HolderStack { bands: profile.bands().to_vec(), top: z0 + 35.0 });
+    // The display assembly carries the revolve of the drawn outline.
+    let asm = tool_body_view::assembly(&catalog_tool(TOOL), &body);
+    let top = asm.iter().flat_map(|t| [t.a.z, t.b.z, t.c.z]).fold(0.0f64, f64::max);
+    assert!((top - (z0 + 35.0)).abs() < 1e-9, "the assembly tops out at the drawn top: {top}");
+}
+
+#[test]
+fn a_drawn_flange_is_judged_by_the_fixture_laws() {
+    let (world, mut history) = face_world();
+    // Beside the flange (z0 + 20 .. z0 + 35), 30 mm off the path: the
+    // 22 mm holder cylinder passes, the drawn 40 mm flange strikes.
+    plant_post_at(&world, &mut history, CUT_Z + shank_top() + 25.0, 5.0);
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("regenerate"));
+    assert_eq!(holder_hits(&world), 0, "the cylinder passes");
+    history.execute(&world, SetToolBody::spun(&world, TOOL, Some(drawn_collar())).expect("a sane profile"));
+    history.execute(&world, GenerateOperation::new(&world, "Face1").expect("regenerate"));
+    assert!(holder_hits(&world) > 0, "the drawn flange strikes the post");
+}
+
+#[test]
+fn the_parametric_profile_changes_nothing() {
+    let (world, mut history) = face_world();
+    let before = stamp(&world);
+    // Parametric = the tool's own holder cylinder: its drawn profile
+    // stacks bit-identically, and Apply in Parametric mode is a clear,
+    // which leaves no digest bytes behind.
+    let t = catalog_tool(TOOL);
+    let h = SpunProfile::holder_of(&t).expect("the catalog tool has a holder");
+    assert_eq!(h.holder_profile().stack(&t.geom()), HolderStack::cylinder(&t.geom()));
+    history.execute(&world, SetToolBody::spun(&world, TOOL, Some(drawn_collar())).expect("custom"));
+    assert_ne!(stamp(&world), before, "a custom profile moves the stamp");
+    history.execute(&world, SetToolBody::spun(&world, TOOL, None).expect("back to parametric"));
+    assert_eq!(stamp(&world), before, "parametric again: byte-identical stamp");
+    assert!(tool_body::body_of(&world, &tool_entity(&world)).is_none());
+}
+
+/// A flange drawn out to r 35 and straight back to the axis at the top
+/// (no height of its own) is judged at r 35: the envelope the laws read
+/// is never smaller than the drawn outline (#475 hands-on finding).
+#[test]
+fn a_flat_top_flange_is_judged_at_its_full_radius() {
+    let (world, mut history) = face_world();
+    let z0 = shank_top();
+    let pts = vec![pt(z0, 0.0), pt(z0, 25.0), pt(z0 + 35.0, 25.0), pt(z0 + 35.0, 35.0), pt(z0 + 35.0, 0.0)];
+    history.execute(&world, SetToolBody::spun(&world, TOOL, Some(pts)).expect("a sane profile"));
+    let (judged, body) = tool_body::judged(&world, &tool_entity(&world), catalog_tool(TOOL)).expect("judged");
+    let body = body.expect("a spindle-frame body");
+    assert!(judged.holder_d >= 70.0 - 1e-9, "the judged holder is Ø{} - the drawn flange is Ø70", judged.holder_d);
+    let wide = tool_body::stack(&catalog_tool(TOOL).geom(), Some(&body)).bands.iter().fold(0.0f64, |m, b| m.max(b.r));
+    assert!(wide >= 35.0 - 1e-9, "the swept stack reaches r {wide} - the drawn flange is r 35");
+}
+
+#[test]
+fn undo_and_redo_walk_the_drawn_profile() {
+    let (world, mut history) = face_world();
+    let b = |w: &World| tool_body::body_of(w, &tool_entity(w)).and_then(|b| b.spun).map(|s| s.points().len());
+    history.execute(&world, SetToolBody::spun(&world, TOOL, Some(drawn_collar())).expect("custom"));
+    let mut slim = drawn_collar();
+    slim.drain(3..5);
+    history.execute(&world, SetToolBody::spun(&world, TOOL, Some(slim)).expect("slimmer"));
+    assert_eq!(b(&world), Some(4));
+    assert!(history.undo(&world));
+    assert_eq!(b(&world), Some(6));
+    assert!(history.undo(&world));
+    assert_eq!(b(&world), None);
+    assert!(history.redo(&world) && history.redo(&world));
+    assert_eq!(b(&world), Some(4));
+}
+
+#[test]
+fn nonsense_profiles_refuse_by_name_at_the_command() {
+    let (world, _history) = face_world();
+    let refuse = |pts: Vec<SpunPoint>, says: &str| match SetToolBody::spun(&world, TOOL, Some(pts)) {
+        Err(CommandError::Invalid(m)) => assert!(m.contains(says), "{m:?} should say {says:?}"),
+        Err(e) => panic!("wrong refusal {e}"),
+        Ok(_) => panic!("accepted a profile that should say {says:?}"),
+    };
+    let mut open = drawn_collar();
+    open.pop();
+    refuse(open, "must end on the axis");
+    let mut back = drawn_collar();
+    back[2].z = shank_top() - 5.0;
+    refuse(back, "point 2 runs back down");
+    let mut nan = drawn_collar();
+    nan[3].r = f64::NAN;
+    refuse(nan, "point 4 is not a finite");
+    // Into the flutes: a holder whose foot is below the flute top.
+    refuse(vec![pt(1.0, 0.0), pt(1.0, 10.0), pt(30.0, 10.0), pt(30.0, 0.0)], "reaches into the flutes");
+    // Turning tools are not spun profiles.
+    let world2 = new_world();
+    let lathe = catalog().into_iter().find(|(_, t)| t.kind == camcraft_app::tools::ToolKind::Turning).expect("an insert");
+    let mut h = History::default();
+    h.execute(&world2, AddTool::new(&world2, lathe.0, lathe.1.clone()).expect("tool"));
+    match SetToolBody::spun(&world2, lathe.0, Some(drawn_collar())) {
+        Err(CommandError::Invalid(m)) => assert!(m.contains("lathe"), "{m}"),
+        _ => panic!("a turning tool takes no spun holder"),
+    }
+}
+
+#[test]
+fn the_drawn_profile_round_trips_and_an_old_reader_over_reports() {
+    let (world, mut history) = face_world();
+    let mut pts = drawn_collar();
+    pts[1].arc = 30.0; // a convex flank on the nose
+    history.execute(&world, SetToolBody::spun(&world, TOOL, Some(pts)).expect("custom"));
+    let path = std::env::temp_dir().join(format!("camcraft_spun_{}.camproj", std::process::id()));
+    project::save(&world, &path).expect("save");
+    let first = std::fs::read_to_string(&path).expect("read");
+    let world2 = new_world();
+    project::load(&world2, &path).expect("load");
+    project::save(&world2, &path).expect("resave");
+    let second = std::fs::read_to_string(&path).expect("reread");
+    let _ = std::fs::remove_file(&path);
+    assert!(first.contains("\"spun\""));
+    assert_eq!(first, second, "save-load-save is byte-identical");
+    let landed = tool_body::body_of(&world, &tool_entity(&world)).expect("landed");
+    assert_eq!(tool_body::body_of(&world2, &tool_entity(&world2)).as_ref(), Some(&landed));
+    // A reader that drops `spun` judges the written facets: their ring
+    // vertices sit on the (conservative) outline, so the envelope never
+    // reads less than the drawn outline at any of its heights.
+    let mut v: serde_json::Value = serde_json::from_str(&first).expect("json");
+    for e in v["entities"].as_array_mut().expect("entities") {
+        if let Some(b) = e.get_mut("tool").and_then(|t| t.get_mut("body")).and_then(|b| b.as_object_mut()) {
+            b.remove("spun");
+        }
+    }
+    let world3 = new_world();
+    project::open(&world3, &serde_json::to_string(&v).expect("json")).expect("facets alone load");
+    let old = tool_body::body_of(&world3, &tool_entity(&world3)).expect("a body");
+    assert!(old.spun.is_none());
+    let outline = landed.spun.as_ref().expect("drawn").outline();
+    let old_profile = old.profile().expect("a spindle-frame body");
+    for &(z, r) in &outline {
+        assert!(old_profile.reach_over(z, z) >= r - 1e-6, "at {z}: {} < {r}", old_profile.reach_over(z, z));
+    }
+}
