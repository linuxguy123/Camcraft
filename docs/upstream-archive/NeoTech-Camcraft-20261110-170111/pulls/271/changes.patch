+        model: "Flip 1".into(),
+        vendor: "CamCraft Testbench".into(),
+        axes: vec![
+            axis("X", (-100.0, 100.0), AxisDirection::Inverted),
+            axis("Y", (-100.0, 100.0), AxisDirection::Standard),
+            axis("Z", (-100.0, 100.0), AxisDirection::Standard),
