+//! Fixed steel under a spindle-C live-tool op (issue #486), end to
+//! end: a Rotary Contour on a mill-turn's C turns the bar under the
+//! fixed radial tool, so on the machine the tool stands on the +X
+//! station at every C. A block declared FIXED where the station's
+//! shank passes is struck on moves whose part-frame tip is on the far
+//! side of the bar - the box laws used to read fixed steel in the part
+//! frame there and stayed silent. Generation and the post gate now
+//! both convict those moves.
+//!
+//! Gate map (M4.4): covers app::fixture, app::operation (rotary_gate's
+//! C stamp, the workholding verdict at generation), app::posting (the
+//! fixture walk), sim::verify::c_steel.
+//! Lane shape (M4.4): all tests here run in seconds.
+//! Provenance: our own fixtures (c_axis_live's standing bar); the law
+//! is the Prime Directive's "never crash".
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    AddTool, CreateOperation, GenerateOperation, History, ImportModel, LoadMachine, SetFixtureFixed, SetStock,
+    TagFixture,
+};
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::machine::{AxisLimits, Machine};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+
+const TAU: f64 = std::f64::consts::TAU;
+
+fn mill_turn() -> Machine {
+    Machine {
+        model: "TestBench mill-turn".into(),
+        kind: Some("mill-turn".into()),
+        axes: vec![
+            AxisLimits { name: "X".into(), feed: Some(4000.0), ..Default::default() },
+            AxisLimits { name: "Y".into(), feed: Some(4000.0), ..Default::default() },
+            AxisLimits { name: "Z".into(), feed: Some(4000.0), ..Default::default() },
+            AxisLimits { name: "C".into(), rotary: true, axis: Some([0.0, 0.0, 1.0]), ..Default::default() },
+        ],
+        ..Default::default()
+    }
+}
+
+/// The turned bar standing on the spindle (c_axis_live's): wall r6,
+/// shoulder, neck r5.
+fn bar() -> Vec<Triangle> {
+    const MERIDIAN: [(f64, f64); 6] = [(0.0, -16.0), (6.0, -16.0), (6.0, -2.0), (5.0, 2.0), (5.0, 16.0), (0.0, 16.0)];
+    let pt = |rho: f64, s: f64, j: usize| {
+        let th = TAU * j as f64 / 16.0;
+        Point3::new(rho * th.cos(), rho * th.sin(), s)
+    };
+    let mut f = Vec::new();
+    for w in MERIDIAN.windows(2) {
+        let ((ra, za), (rb, zb)) = (w[0], w[1]);
+        for j in 0..16 {
+            let k = (j + 1) % 16;
+            let (a1, a2, b1, b2) = (pt(ra, za, j), pt(ra, za, k), pt(rb, zb, j), pt(rb, zb, k));
+            if ra <= 1e-12 {
+                f.push(Triangle::new(a1, b2, b1));
+            } else if rb <= 1e-12 {
+                f.push(Triangle::new(a1, a2, b2));
+            } else {
+                f.push(Triangle::new(a1, a2, b2));
+                f.push(Triangle::new(a1, b2, b1));
+            }
+        }
+    }
+    f
+}
+
+fn world() -> (World, History) {
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    let tool = catalog().into_iter().find(|(n, _)| *n == "BN-0600").map(|(_, t)| t).expect("catalog ball");
+    h.execute(&world, AddTool::new(&world, "BN-0600", tool).expect("tool"));
+    let stock = SetStock::new(&world, StockShape::Box { dx: 14.0, dy: 14.0, dz: 34.0 }, Location::default());
+    h.execute(&world, stock.expect("stock"));
+    h.execute(&world, ImportModel::from_mesh("bar", Mesh::from_facets(bar())));
+    h.execute(&world, LoadMachine::new(&world, "millturn.mch".into(), Some(mill_turn())).expect("machine"));
+    let params = OpParams::RotaryContour {
+        tolerance: 0.05,
+        clearance_z: Height::fixed(25.0),
+        retract_z: None,
+        top_z: Height::fixed(6.0),
+        bottom_z: Height::fixed(-8.0),
+        feed: 500.0,
+        plunge_feed: 100.0,
+        climb: true,
+        lead_deg: 0.0,
+        lag_deg: 0.0,
+        max_tilt_deg: 60.0,
+    };
+    let op = CreateOperation::new(&world, "OP", "BN-0600", SrcRef::Entity("bar".into()), params);
+    h.execute(&world, op.expect("create"));
+    h.execute(&world, GenerateOperation::new(&world, "OP").expect("generate"));
+    (world, h)
+}
+
+fn cache(world: &World) -> camcraft_app::schema::Toolpath {
+    model::find_by_name(world, "OP").and_then(|e| model::toolpath_of(world, &e)).expect("cached")
+}
+
+/// The C (degrees) folded into (-180, 180].
+fn wrap(c: f64) -> f64 {
+    let w = c.rem_euclid(360.0);
+    if w > 180.0 { w - 360.0 } else { w }
+}
+
+/// The feed move whose tip stands nearest the far side of the bar (C
+/// 180), and the machine-frame point its shank's middle passes: the
+/// station ray at the tip's radius plus flute and half the shank.
+fn far_side_shank() -> (usize, Point3) {
+    let (world, _) = world();
+    let path = cache(&world).path;
+    let g = catalog().into_iter().find(|(n, _)| *n == "BN-0600").map(|(_, t)| t).expect("ball").geom();
+    let (i, m) = path
+        .moves
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| m.kind == camcraft_app::cl::MoveKind::Feed && m.rotary.is_some())
+        .min_by(|a, b| {
+            let d = |m: &camcraft_app::cl::Move| (180.0 - wrap(m.rotary.unwrap_or(0.0)).abs()).abs();
+            d(a.1).total_cmp(&d(b.1))
+        })
+        .expect("the contour cuts under C");
+    let c = wrap(m.rotary.unwrap_or(0.0));
+    assert!(c.abs() > 170.0, "a cut on the far side of the bar: C {c}");
+    let rho = m.to.x.hypot(m.to.y);
+    (i, Point3::new(rho + g.flute_len + 0.5 * g.shank_len, 0.0, m.to.z))
+}
+
+fn plant_fixed(world: &World, h: &mut History, at: Point3) {
+    let e = 1.0;
+    let (lo, hi) = (Point3::new(at.x - e, at.y - e, at.z - e), Point3::new(at.x + e, at.y + e, at.z + e));
+    let cube = vec![Triangle::new(lo, Point3::new(hi.x, hi.y, hi.z), Point3::new(lo.x, hi.y, hi.z))];
+    h.execute(world, ImportModel::from_mesh("steady", Mesh::from_facets(cube)));
+    h.execute(world, TagFixture::new(world, "steady", None).expect("tag the steel"));
+    h.execute(world, SetFixtureFixed::new(world, "steady", true).expect("declare it fixed"));
+}
+
+/// Hits on moves whose tip is more than 120 deg round from the station
+/// side - where the part-frame reading of fixed steel at +X is blind.
+fn far_side_hits(world: &World) -> Vec<usize> {
+    let c = cache(world);
+    c.warnings
+        .iter()
+        .filter_map(|w| match w {
+            Warning::FixtureHit { at, .. } => Some(*at),
+            _ => None,
+        })
+        .filter(|&at| c.path.moves.get(at).and_then(|m| m.rotary).is_some_and(|c| wrap(c).abs() > 120.0))
+        .collect()
+}
+
+#[test]
+fn fixed_steel_at_the_station_convicts_cuts_on_the_far_side_of_the_bar() {
+    let (k, steady) = far_side_shank();
+    let (world, mut h) = world();
+    plant_fixed(&world, &mut h, steady);
+    h.execute(&world, GenerateOperation::new(&world, "OP").expect("regenerate"));
+    let far = far_side_hits(&world);
+    assert!(far.contains(&k), "the far-side cut {k} meets the steady at the station: {far:?}");
+    let gate = posting::fixture_findings(&world).expect("judged");
+    assert!(gate.hits.iter().any(|(_, w)| matches!(w, Warning::FixtureHit { at, .. } if *at == k)), "the post gate convicts it too");
+}
+
+#[test]
+fn fixed_steel_off_the_station_stays_clear() {
+    // The same steady carried 200 mm out along the station: past the
+    // whole stack at every C.
+    let (_, steady) = far_side_shank();
+    let (world, mut h) = world();
+    plant_fixed(&world, &mut h, Point3::new(steady.x + 200.0, steady.y, steady.z));
+    h.execute(&world, GenerateOperation::new(&world, "OP").expect("regenerate"));
+    let hits: Vec<_> = cache(&world).warnings.into_iter().filter(|w| matches!(w, Warning::FixtureHit { .. })).collect();
+    assert!(hits.is_empty(), "{hits:?}");
+    assert!(posting::fixture_findings(&world).expect("judged").hits.is_empty());
+}
diff --git a/crates/app/tests/c_axis_live.rs b/crates/app/tests/c_axis_live.rs
new file mode 100644
index 00000000..6615af9a
--- /dev/null
+++ b/crates/app/tests/c_axis_live.rs
@@ -0,0 +1,237 @@
+//! Continuous C-axis live tooling (issue #33): a rotary kind on a
+//! mill-turn's spindle-as-C generates a path that STATES its C angle
+//! on every move (`cl::Move::rotary`), split so the machine's C-linear
+//! motion follows each verified part-frame chord; the stream carries
+//! the C word and a `PARAM LiveTool`; the Fanuc lathe post writes X
+//! (diameter) Z C under G98 with the machine's own engage words, and
+//! refuses by name what it cannot voice - a machine without live-tool
+//! words, a tip C does not turn onto the station - while a post that
+//! does not declare `liveTooling` (every mill post) is refused by the
+//! engine.
+//!
+//! Regenerate the golden after an intentional change:
+//! `WRITE_GOLDEN=1 cargo test -p camcraft-app --test c_axis_live`
+//!
+//! Gate map (M4.4): covers camcraft_app::operation (rotary_gate's C
+//! stamp), camcraft_app::cl (stamp_c), camcraft_app::post (the dump's
+//! C word, the engine's liveTooling refusal, fanuc-lathe.cps).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+mod common;
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::cl::{stamp_c, Move, MoveKind, Toolpath};
+use camcraft_app::commands::{AddTool, History, ImportModel, LoadMachine, SetStock};
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::machine::{AxisLimits, Coolant, LiveToolCodes, Machine};
+use camcraft_app::operation::{self, Height, OpParams, SrcRef};
+use camcraft_app::post::{self, cnc, engine};
+use camcraft_app::schema::{Location, Operation};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+
+const TAU: f64 = std::f64::consts::TAU;
+const LATHE_CPS: &str = include_str!("../../../assets/posts/fanuc-lathe.cps");
+const MILL_CPS: &str = include_str!("../../../assets/posts/fanuc.cps");
+
+/// Test-bench words - placeholders, not any builder's codes.
+fn codes() -> LiveToolCodes {
+    LiveToolCodes {
+        c_axis_on: "M1001".into(),
+        c_axis_off: "M1002".into(),
+        spindle_on: "M1003".into(),
+        spindle_off: "M1004".into(),
+    }
+}
+
+fn mill_turn(live: Option<LiveToolCodes>) -> Machine {
+    Machine {
+        model: "TestBench mill-turn".into(),
+        kind: Some("mill-turn".into()),
+        spindle_max: Some(6000.0),
+        coolants: vec![Coolant { name: "Flood".into(), m_code: "M8".into() }],
+        axes: vec![
+            AxisLimits { name: "X".into(), feed: Some(4000.0), ..Default::default() },
+            AxisLimits { name: "Y".into(), feed: Some(4000.0), ..Default::default() },
+            AxisLimits { name: "Z".into(), feed: Some(4000.0), ..Default::default() },
+            AxisLimits { name: "C".into(), rotary: true, axis: Some([0.0, 0.0, 1.0]), ..Default::default() },
+        ],
+        live_tool: live,
+        ..Default::default()
+    }
+}
+
+/// The turned bar standing on the spindle: wall r6, shoulder, neck r5.
+fn bar() -> Vec<Triangle> {
+    const MERIDIAN: [(f64, f64); 6] = [(0.0, -16.0), (6.0, -16.0), (6.0, -2.0), (5.0, 2.0), (5.0, 16.0), (0.0, 16.0)];
+    let pt = |rho: f64, s: f64, j: usize| {
+        let th = TAU * j as f64 / 16.0;
+        Point3::new(rho * th.cos(), rho * th.sin(), s)
+    };
+    let mut f = Vec::new();
+    for w in MERIDIAN.windows(2) {
+        let ((ra, za), (rb, zb)) = (w[0], w[1]);
+        for j in 0..16 {
+            let k = (j + 1) % 16;
+            let (a1, a2, b1, b2) = (pt(ra, za, j), pt(ra, za, k), pt(rb, zb, j), pt(rb, zb, k));
+            if ra <= 1e-12 {
+                f.push(Triangle::new(a1, b2, b1));
+            } else if rb <= 1e-12 {
+                f.push(Triangle::new(a1, a2, b2));
+            } else {
+                f.push(Triangle::new(a1, a2, b2));
+                f.push(Triangle::new(a1, b2, b1));
+            }
+        }
+    }
+    f
+}
+
+fn world() -> World {
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    let tool = catalog().into_iter().find(|(n, _)| *n == "BN-0600").map(|(_, t)| t).expect("catalog ball");
+    h.execute(&world, AddTool::new(&world, "BN-0600", tool).expect("tool"));
+    let stock = SetStock::new(&world, StockShape::Box { dx: 14.0, dy: 14.0, dz: 34.0 }, Location::default());
+    h.execute(&world, stock.expect("stock"));
+    h.execute(&world, ImportModel::from_mesh("bar", Mesh::from_facets(bar())));
+    let cmd = LoadMachine::new(&world, "millturn.mch".into(), Some(mill_turn(Some(codes()))));
+    h.execute(&world, cmd.expect("machine"));
+    world
+}
+
+fn contour() -> Operation {
+    Operation {
+        tool: "BN-0600".into(),
+        src: SrcRef::Entity("bar".into()),
+        params: OpParams::RotaryContour {
+            tolerance: 0.05,
+            clearance_z: Height::fixed(25.0),
+            retract_z: None,
+            top_z: Height::fixed(6.0),
+            bottom_z: Height::fixed(-8.0),
+            feed: 500.0,
+            plunge_feed: 100.0,
+            climb: true,
+            lead_deg: 0.0,
+            lag_deg: 0.0,
+            max_tilt_deg: 60.0,
+        },
+        stamp: None,
+        setup: None,
+        area: Default::default(),
+        coolant: Default::default(),
+        after: Default::default(),
+        suppressed: false,
+    }
+}
+
+/// The stream a path posts as, with the context the lathe post reads.
+fn stream(path: &Toolpath) -> String {
+    let d = post::Dump { op_name: "C wrap", tool_number: 1, tool_name: "BN-0600", tool_diameter: 6.0, rpm: 3000.0, ..Default::default() };
+    cnc::serialize(&post::dump(path, &d))
+}
+
+/// Rz(C) of the part-frame tip, as the post reads it.
+fn on_station(m: &Move) -> bool {
+    let Some(c) = m.rotary else { return false };
+    let (s, co) = c.to_radians().sin_cos();
+    let y = m.to.x * s + m.to.y * co;
+    let x = m.to.x * co - m.to.y * s;
+    y.abs() < 1e-6 && x > -1e-6
+}
+
+#[test]
+fn a_rotary_contour_on_the_spindle_states_c_on_every_move_and_posts() {
+    let w = world();
+    let (path, _warns) = operation::generate(&w, &contour(), "C wrap").expect("the spindle's C holds the standing bar");
+    assert!(!path.moves.is_empty());
+    assert!(path.moves.iter().all(on_station), "every move turns its tip onto the station");
+    // Continuous: no move swings C more than the split law allows a
+    // chord at these radii (a jump would be a whole-turn unwrap slip).
+    let worst = path
+        .moves
+        .windows(2)
+        .filter_map(|w| Some((w[1].rotary? - w[0].rotary?).abs()))
+        .fold(0.0, f64::max);
+    assert!(worst < 90.0, "C steps stay continuous, worst {worst}");
+    let out = engine::run(LATHE_CPS, &post::machine::mirror(&mill_turn(Some(codes()))), &stream(&path)).expect("runs");
+    assert!(out.warnings.is_empty(), "the lathe post voices the C section: {:?}", out.warnings);
+    for word in ["G98", "M1001", "M1003 S3000", "M1004", "M1002", "G99"] {
+        assert!(out.program.contains(word), "{word} in the program");
+    }
+    assert!(out.program.lines().any(|l| l.starts_with("G01 X") && l.contains(" C")), "X Z C blocks");
+    assert!(!out.program.contains("M03"), "no turning spindle in a C section");
+}
+
+/// One and a half turns of a wrapped helix at r 10, 2 mm a turn,
+/// posed radially: the smallest honest C-continuous path.
+fn helix() -> Toolpath {
+    let at = |k: usize| {
+        let th = (k as f64 * 30.0).to_radians();
+        Point3::new(10.0 * th.cos(), 10.0 * th.sin(), -(k as f64) * 2.0 / 12.0)
+    };
+    let radial = |p: Point3| [p.x / 10.0, p.y / 10.0, 0.0];
+    let start = Point3::new(20.0, 0.0, 0.0);
+    let mut moves = vec![
+        Move::new(MoveKind::Rapid, start, Point3::new(12.0, 0.0, 0.0), None).with_axis([1.0, 0.0, 0.0]),
+        Move::new(MoveKind::Feed, Point3::new(12.0, 0.0, 0.0), at(0), Some(200.0)).with_axis([1.0, 0.0, 0.0]),
+    ];
+    for k in 0..18 {
+        moves.push(Move::new(MoveKind::Feed, at(k), at(k + 1), Some(400.0)).with_axis(radial(at(k + 1))));
+    }
+    let end = at(18);
+    let out = Point3::new(end.x * 2.0, end.y * 2.0, end.z);
+    moves.push(Move::new(MoveKind::Rapid, end, out, None).with_axis(radial(end)));
+    Toolpath::new(moves)
+}
+
+#[test]
+fn the_wrapped_helix_posts_to_its_golden() {
+    let path = stamp_c(&helix(), [0.0, 0.0], 0.01).expect("the helix stamps");
+    let last = path.moves.last().and_then(|m| m.rotary);
+    assert!(last.is_some_and(|c| (c + 540.0).abs() < 1e-6), "one and a half turns read -540: {last:?}");
+    let out = engine::run(LATHE_CPS, &post::machine::mirror(&mill_turn(Some(codes()))), &stream(&path)).expect("runs");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    common::write_golden("nc/fanuc-lathe/c_axis_helix.nc", &out.program);
+}
+
+#[test]
+fn every_post_without_c_or_without_the_machines_words_refuses_by_name() {
+    let path = stamp_c(&helix(), [0.0, 0.0], 0.01).expect("the helix stamps");
+    let text = stream(&path);
+    // A mill post: the engine refuses the section for want of liveTooling.
+    let mill = engine::run(MILL_CPS, &post::machine::mirror(&mill_turn(Some(codes()))), &text).expect("runs");
+    assert!(mill.warnings.iter().any(|w| w.contains("liveTooling")), "{:?}", mill.warnings);
+    // The lathe post on a machine that states no live-tool words.
+    let bare = engine::run(LATHE_CPS, &post::machine::mirror(&mill_turn(None)), &text).expect("runs");
+    assert!(bare.warnings.iter().any(|w| w.contains("live_tool words")), "{:?}", bare.warnings);
+    // A C that does not turn the tip onto the station: refused, never projected.
+    let mut bad = path.clone();
+    if let Some(m) = bad.moves.get_mut(5) {
+        m.rotary = m.rotary.map(|c| c + 10.0);
+    }
+    let out = engine::run(LATHE_CPS, &post::machine::mirror(&mill_turn(Some(codes()))), &stream(&bad)).expect("runs");
+    assert!(out.warnings.iter().any(|w| w.contains("live-tool station")), "{:?}", out.warnings);
+}
+
+#[test]
+fn the_c_word_rides_the_stream_and_parses_back() {
+    let path = stamp_c(&helix(), [0.0, 0.0], 0.01).expect("the helix stamps");
+    let recs = cnc::parse(&stream(&path)).expect("parses");
+    assert!(recs.iter().any(|r| matches!(r, cnc::Record::Param { name, .. } if name == "LiveTool")));
+    let cs: Vec<f64> = recs
+        .iter()
+        .filter_map(|r| match r {
+            cnc::Record::Move(m) => m.abc.map(|[_, _, c]| c),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(cs.len(), path.moves.len(), "every move carries its C");
+    // A path with no C writes no LiveTool and no letters - byte-shape
+    // identical to every stream before #33.
+    let plain = Toolpath::new(vec![Move::new(MoveKind::Feed, Point3::new(0.0, 0.0, 0.0), Point3::new(1.0, 0.0, 0.0), Some(100.0))]);
+    let t = stream(&plain);
+    assert!(!t.contains("LiveTool") && !t.contains(" A 0 B 0 C "), "{t}");
+}
diff --git a/crates/app/tests/carried_fixtures_cache.rs b/crates/app/tests/carried_fixtures_cache.rs
new file mode 100644
index 00000000..34e62355
--- /dev/null
+++ b/crates/app/tests/carried_fixtures_cache.rs
@@ -0,0 +1,218 @@
+//! #321: carried stock - workholding, the lathe second op, the cache. A
+//! 10x10x5 part sits in a 100 mm block Setup1 faces; Setup2 holds the body
+//! Setup1 left ("Same as") and carries a jaw fixture beside the part. The
+//! jaw is refused at the post where Setup1 left material standing in it,
+//! and clear where Setup1 faced that material away (even though Setup2's
+//! declared block still reaches through it); a carry on a lathe or
+//! mill-turn is refused by name (generation and the rest chain name it,
+//! the sim and the post refuse the path it staled); the carried body is not
+//! recomputed on an unrelated edit, and is on an upstream one.
+//! Provenance: our own fixtures (carried_verify.rs's faced block and
+//! contour) over plain re-clamp practice; no vendor material consulted.
+//!
+//! Gate map (#321): covers app::fixture_carried (carried_fixture_problems,
+//! penetration), app::rest::carried_cache (body, computes, clear),
+//! app::rest::across (carried_body, entered_body), app::stock_sim::carry
+//! (CARRY_MACHINE_REFUSAL), app::posting (the workholding clause).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::cl::MoveKind;
+use camcraft_app::commands::{
+    AddTool, CreateOperation, CreateSetup, EditOperationParams, GenerateOperation, History, ImportModel,
+    LoadMachine, RenameOperation, SetSetupRelative, SetStock, TagFixture,
+};
+use camcraft_app::fixture_carried::{FIXTURE_IN_CARRIED, carried_fixture_problems};
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::machining2d::{Lead, Side};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::rest::{carried_body_computes, carry_refusal};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::stock_sim::{CARRY_MACHINE_REFUSAL, simulate_document};
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+use camcraft_app::world::new_world;
+
+const TOOL: &str = "EM-0600-4FL";
+
+fn contour(feed: f64) -> OpParams {
+    OpParams::Contour {
+        tilt: None,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(12.0),
+        retract_z: Height::fixed(8.0),
+        top_z: Height::fixed(5.0),
+        bottom_z: Height::fixed(0.0),
+        stepdown: 2.5,
+        feed,
+        plunge_feed: 200.0,
+        climb: true,
+        side: Side::Auto,
+        lead: Lead::None,
+        tolerance: 0.01,
+        tab_count: 0,
+        tab_width: 0.0,
+        tab_height: 0.0,
+        entry: camcraft_app::machining3d::Entry3D::Plunge,
+        helix_radius: 1.0,
+        blend_turns: false,
+        links: camcraft_app::links::Links::PLANAR,
+    }
+}
+
+fn face(cut_z: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 4.0,
+        clearance_z: Height::fixed(30.0),
+        cut_z: Height::fixed(cut_z),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+fn block(world: &World, w: f64, z0: f64, dz: f64) -> SetStock {
+    let at = Location { pos: Point3::new(5.0, 5.0, z0), ..Default::default() };
+    SetStock::new(world, StockShape::Box { dx: w, dy: w, dz }, at).expect("stock")
+}
+
+/// The part in Setup1's 100 mm block Z -5..10 faced to `cut1`; Setup2
+/// "Same as" Setup1 declaring a `w2`-wide block Z -5..(-5 + `dz2`), a
+/// jaw (x 20..30, y 0..10, z 5..8) tagged to it, and Contour2.
+fn program(cut1: f64, w2: f64, dz2: f64) -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::ZERO, Point3::new(10.0, 10.0, 5.0))));
+    h.execute(&world, block(&world, 100.0, -5.0, 15.0));
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("tool");
+    h.execute(&world, AddTool::new(&world, TOOL, tool).expect("add tool"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("materialize Setup1"));
+    h.execute(&world, CreateOperation::new(&world, "Face1", TOOL, SrcRef::Stock, face(cut1)).expect("create"));
+    h.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup1")).expect("Setup2"));
+    h.execute(&world, SetSetupRelative::link(&world, "Setup2", "Setup1", [0.0; 3]).expect("same as"));
+    h.execute(&world, block(&world, w2, -5.0, dz2));
+    h.execute(&world, ImportModel::from_mesh("Jaw", cube(Point3::new(20.0, 0.0, 5.0), Point3::new(30.0, 10.0, 8.0))));
+    h.execute(&world, TagFixture::new(&world, "Jaw", Some("Setup2")).expect("tag jaw"));
+    let op = CreateOperation::new(&world, "Contour2", TOOL, SrcRef::Entity("part".into()), contour(800.0)).expect("create");
+    h.execute(&world, op);
+    h.execute(&world, GenerateOperation::new(&world, "Contour2").expect("generate"));
+    (world, h)
+}
+
+fn jaw_lines(world: &World) -> Vec<String> {
+    posting::verification_gate(world).into_iter().filter(|p| p.contains(FIXTURE_IN_CARRIED)).collect()
+}
+
+#[test]
+fn a_jaw_modelled_into_material_setup1_left_refuses_the_post() {
+    // Setup1 faces only to 9: material stands to Z 9 under the jaw (Z 5..8),
+    // all of it outside Setup2's small declared block - only the carried
+    // stock says the jaw is modelled into material.
+    let (world, _h) = program(9.0, 12.0, 10.0);
+    let p = carried_fixture_problems(&world);
+    assert_eq!(p.len(), 1, "{p:?}");
+    assert!(
+        p[0].contains("setup 'Setup2'") && p[0].contains("fixture 'Jaw'") && p[0].contains("setup 'Setup1'") && p[0].contains("3.00 mm deep"),
+        "{}",
+        p[0]
+    );
+    assert_eq!(jaw_lines(&world), p, "the post gate reads the same clause");
+    let dir = std::env::temp_dir().join(format!("cc-321-{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&dir);
+    let posted = posting::post_setup(&world, &dir.join("jaw.nc"));
+    let _ = std::fs::remove_dir_all(&dir);
+    match posted {
+        Ok(_) => panic!("a jaw inside the carried stock posted"),
+        Err(e) => assert!(e.contains(FIXTURE_IN_CARRIED), "{e}"),
+    }
+}
+
+#[test]
+fn a_jaw_where_setup1_faced_the_material_away_is_clear() {
+    // Setup1 faces to 5: the jaw sits ON the face it left (contact, not
+    // penetration). Setup2's declared block (to Z 10) still reaches through
+    // the jaw - the carried body, not the declared block, is read.
+    let (world, _h) = program(5.0, 100.0, 15.0);
+    assert!(carried_fixture_problems(&world).is_empty(), "{:?}", carried_fixture_problems(&world));
+    assert!(jaw_lines(&world).is_empty());
+}
+
+#[test]
+fn the_carried_body_is_not_recomputed_on_an_unrelated_edit() {
+    let (world, mut h) = program(9.0, 100.0, 10.0);
+    let n0 = carried_body_computes();
+    assert!(n0 >= 1, "Contour2's generation read the carried body");
+    // Edits that do not feed the carry: the consumer's own feed, a label
+    // upstream, the post gate reading the same entry - all hits.
+    h.execute(&world, EditOperationParams::new(&world, "Contour2", contour(600.0)).expect("edit"));
+    h.execute(&world, GenerateOperation::new(&world, "Contour2").expect("regenerate"));
+    h.execute(&world, RenameOperation::new(&world, "Face1", "Top face").expect("rename"));
+    h.execute(&world, GenerateOperation::new(&world, "Contour2").expect("regenerate"));
+    let _ = posting::verification_report(&world);
+    assert_eq!(carried_body_computes(), n0, "an unrelated edit recomputed the carried body");
+    // An upstream edit moves the key: recomputed, and never served stale -
+    // Setup1 now faces to 5, so the dive beside the part meets air.
+    h.execute(&world, EditOperationParams::new(&world, "Face1", face(5.0)).expect("edit face"));
+    h.execute(&world, GenerateOperation::new(&world, "Face1").expect("regenerate face"));
+    h.execute(&world, GenerateOperation::new(&world, "Contour2").expect("regenerate"));
+    assert!(carried_body_computes() > n0, "an upstream edit served the cached body");
+    let cached = model::find_by_name(&world, "Contour2").and_then(|e| model::toolpath_of(&world, &e)).expect("cached");
+    assert!(cached.path.moves.iter().any(|m| m.kind == MoveKind::Rapid), "the contour has rapids");
+    assert!(
+        !cached.warnings.iter().any(|w| matches!(w, Warning::RapidInStock { .. })),
+        "the body Setup1 faced to 5 was judged: {:?}",
+        cached.warnings
+    );
+}
+
+#[test]
+fn a_new_document_starts_with_no_carried_body_cached() {
+    let (world, mut h) = program(9.0, 100.0, 10.0);
+    drop(new_world());
+    let n0 = carried_body_computes();
+    h.execute(&world, GenerateOperation::new(&world, "Contour2").expect("regenerate"));
+    assert!(carried_body_computes() > n0, "the cache outlived its document");
+}
+
+#[test]
+fn a_carry_on_a_lathe_or_mill_turn_is_refused_by_name_on_every_path() {
+    for machine in ["Lathe", "Mill-turn"] {
+        let (world, mut h) = program(9.0, 100.0, 10.0);
+        h.execute(&world, LoadMachine::builtin(&world, machine).expect("load machine"));
+        let generated = GenerateOperation::new(&world, "Contour2").map(|_| ()).expect_err("refused").to_string();
+        assert!(
+            generated.contains(CARRY_MACHINE_REFUSAL) && generated.contains("from setup 'Setup1' into setup 'Setup2'"),
+            "{machine}: {generated}"
+        );
+        // The rest chain names it too (the stamp digests that refusal, so
+        // the path cut on the mill goes stale).
+        let rest = carry_refusal(&world, "Contour2", Some("Setup2")).expect("the rest chain refuses");
+        assert!(rest.contains(CARRY_MACHINE_REFUSAL), "{machine}: {rest}");
+        // The sim never judges it: the op cut on the mill is stale by name.
+        let sim = simulate_document(&world).map(|_| ()).expect_err("the program sim never judges it");
+        assert!(sim.contains("Contour2") && sim.contains("regenerate"), "{machine}: {sim}");
+        let gate = posting::verification_report(&world).problems;
+        assert!(gate.iter().any(|p| p.contains("Contour2")), "{machine}: the carried program posted: {gate:?}");
+    }
+}
+
+#[test]
+fn a_fixture_narrower_than_a_cell_is_judged_by_the_column_under_it() {
+    // A 0.1 mm dowel pin (no column centre inside its footprint) standing
+    // Z 2..8 in material Setup1 left to Z 5: 3 mm deep, never skipped.
+    let (world, mut h) = program(5.0, 100.0, 15.0);
+    h.execute(&world, ImportModel::from_mesh("Pin", cube(Point3::new(40.0, 5.0, 2.0), Point3::new(40.1, 5.1, 8.0))));
+    h.execute(&world, TagFixture::new(&world, "Pin", Some("Setup2")).expect("tag pin"));
+    let p = carried_fixture_problems(&world);
+    assert!(p.len() == 1 && p[0].contains("fixture 'Pin'") && p[0].contains("3.00 mm deep"), "{p:?}");
+}
diff --git a/crates/app/tests/carried_verify.rs b/crates/app/tests/carried_verify.rs
new file mode 100644
index 00000000..0dba2d44
--- /dev/null
+++ b/crates/app/tests/carried_verify.rs
@@ -0,0 +1,311 @@
+//! #319: verification in a later setup judges the carried body. A 10x10x5
+//! part sits in a block Setup1 faces; Setup2 holds the body Setup1 left
+//! ("Same as", or flipped) but declares a stock whose top is the part's.
+//! Setup2's contour dives from its retract plane beside the part: where
+//! Setup1 left material standing above the declared top the dive is
+//! refused, where Setup1 faced it away it is allowed, a declared stock
+//! larger than the carried block is judged present, the mismatch is said
+//! by name, and the post agrees.
+//! Provenance: our own fixtures (vertical_rapid_stock.rs's contour over a
+//! box, setup_carry.rs's faced block) over plain re-clamp practice; no
+//! vendor material consulted.
+//!
+//! Gate map (#319): covers app::operation (carried_stock, job, stamp),
+//! app::rest::across (carried_stock_block, carried_stock_body,
+//! carried_digest), app::stock_sim (simulate_document's carry refusal),
+//! app::posting (the gate's cached warnings).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::cl::MoveKind;
+use camcraft_app::commands::{
+    AddTool, AlignPartToSetup, CreateOperation, CreateSetup, EditOperationParams, GenerateOperation, History, ImportModel,
+    SetSetupRelative, SetStock,
+};
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::machining2d::{Lead, Side};
+use camcraft_app::model;
+use camcraft_app::operation::{self, CARRIED_OUTSIDE_DECLARED, CARRIED_OUTSIDE_NOTED, Height, OpParams, OpStatus, SrcRef, Tilt};
+use camcraft_app::posting;
+use camcraft_app::schema::Location;
+use camcraft_app::setup_align::AlignPreset;
+use camcraft_app::stock::StockShape;
+use camcraft_app::stock_sim::{CARRY_TURN_REFUSAL, simulate_document};
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+use camcraft_app::world::new_world;
+
+const TOOL: &str = "EM-0600-4FL";
+
+/// A contour of the part: top 5, clearance 12, retract 8 - its dive from
+/// the retract plane lands below Z 8, beside the part.
+fn contour() -> OpParams {
+    OpParams::Contour {
+        tilt: None,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(12.0),
+        retract_z: Height::fixed(8.0),
+        top_z: Height::fixed(5.0),
+        bottom_z: Height::fixed(0.0),
+        stepdown: 2.5,
+        feed: 800.0,
+        plunge_feed: 200.0,
+        climb: true,
+        side: Side::Auto,
+        lead: Lead::None,
+        tolerance: 0.01,
+        tab_count: 0,
+        tab_width: 0.0,
+        tab_height: 0.0,
+        entry: camcraft_app::machining3d::Entry3D::Plunge,
+        helix_radius: 1.0,
+        blend_turns: false,
+        links: camcraft_app::links::Links::PLANAR,
+    }
+}
+
+fn face(cut_z: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 4.0,
+        clearance_z: Height::fixed(30.0),
+        cut_z: Height::fixed(cut_z),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+/// A box stock `w` x `w` centred on the part, Z `z0` up `dz`.
+fn block(world: &World, w: f64, z0: f64, dz: f64) -> SetStock {
+    let at = Location { pos: Point3::new(5.0, 5.0, z0), ..Default::default() };
+    SetStock::new(world, StockShape::Box { dx: w, dy: w, dz }, at).expect("stock")
+}
+
+/// How Setup2 holds the body Setup1 leaves.
+#[derive(Clone, Copy, PartialEq)]
+enum Hold {
+    SameAs,
+    FlipX,
+    /// Same hold, not linked: the clip, nothing carried.
+    Clip,
+}
+
+/// The part (0..10)^2 x [0, 5] in Setup1's `w1`-wide block Z -5..10,
+/// faced to `cut1`; Setup2 held as `hold`, declaring a `w2`-wide block
+/// Z -5..5 (top at the part's), and Contour2 round the part.
+fn program(w1: f64, cut1: f64, hold: Hold, w2: f64) -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::ZERO, Point3::new(10.0, 10.0, 5.0))));
+    h.execute(&world, block(&world, w1, -5.0, 15.0));
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("tool");
+    h.execute(&world, AddTool::new(&world, TOOL, tool).expect("add tool"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("materialize Setup1"));
+    let op = CreateOperation::new(&world, "Face1", TOOL, SrcRef::Stock, face(cut1)).expect("create");
+    h.execute(&world, op);
+    h.execute(&world, GenerateOperation::new(&world, "Face1").expect("generate"));
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup1")).expect("Setup2"));
+    match hold {
+        Hold::SameAs => h.execute(&world, SetSetupRelative::link(&world, "Setup2", "Setup1", [0.0; 3]).expect("same as")),
+        Hold::FlipX => h.execute(&world, AlignPartToSetup::preset(&world, "Setup2", AlignPreset::FlipX).expect("flip")),
+        Hold::Clip => {}
+    }
+    h.execute(&world, block(&world, w2, -5.0, 10.0));
+    let op = CreateOperation::new(&world, "Contour2", TOOL, SrcRef::Entity("part".into()), contour()).expect("create");
+    h.execute(&world, op);
+    h.execute(&world, GenerateOperation::new(&world, "Contour2").expect("generate"));
+    (world, h)
+}
+
+fn cached(world: &World, name: &str) -> camcraft_app::schema::Toolpath {
+    model::find_by_name(world, name).and_then(|e| model::toolpath_of(world, &e)).expect("cached")
+}
+
+/// Contour2's vertical rapid dives below Z 8 (the retract plane).
+fn dives(world: &World) -> Vec<usize> {
+    let moves = cached(world, "Contour2").path.moves;
+    let out: Vec<usize> = moves
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| {
+            m.kind == MoveKind::Rapid
+                && m.to.z < m.from.z
+                && m.to.z < 8.0 - 1e-6
+                && (m.to.x - m.from.x).hypot(m.to.y - m.from.y) < 1e-6
+        })
+        .map(|(i, _)| i)
+        .collect();
+    assert!(!out.is_empty(), "the fixture must dive below the retract plane: {moves:?}");
+    out
+}
+
+fn convicted(world: &World) -> Vec<usize> {
+    cached(world, "Contour2")
+        .warnings
+        .iter()
+        .filter_map(|w| match w {
+            Warning::RapidInStock { at } => Some(*at),
+            _ => None,
+        })
+        .collect()
+}
+
+fn noted(world: &World) -> bool {
+    let notes = cached(world, "Contour2").path.notes;
+    notes.iter().any(|n| n.starts_with(CARRIED_OUTSIDE_DECLARED) && n.contains("'Setup1'") && n.contains("'Setup2'"))
+}
+
+#[test]
+fn a_dive_clear_of_the_declared_block_into_carried_material_is_refused() {
+    // Setup1 faces only to 9: the carried body stands to Z 9 round the
+    // part, 4 mm above Setup2's declared top - the dive is clear of the
+    // declared block and inside the real one.
+    let (world, _h) = program(100.0, 9.0, Hold::SameAs, 100.0);
+    let (d, c) = (dives(&world), convicted(&world));
+    assert!(c.contains(&d[0]), "dives {d:?}, convicted {c:?}");
+    assert!(noted(&world), "{:?}", cached(&world, "Contour2").path.notes);
+    let dir = std::env::temp_dir().join(format!("cc-319-{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&dir);
+    let out = dir.join("refused.nc");
+    let posted = posting::post_setup(&world, &out);
+    let _ = std::fs::remove_dir_all(&dir);
+    match posted {
+        Ok(_) => panic!("the carried-stock dive posted"),
+        Err(e) => assert!(
+            e.contains("post blocked") && e.contains("operation Contour2: ") && e.contains(CARRIED_OUTSIDE_DECLARED),
+            "{e}"
+        ),
+    }
+}
+
+#[test]
+fn a_dive_into_material_setup1_removed_is_allowed() {
+    // Setup1 faces the block down to the part's top: the dive meets air,
+    // as the declared stock says too - no note, no conviction.
+    let (world, _h) = program(100.0, 5.0, Hold::SameAs, 100.0);
+    dives(&world);
+    assert!(convicted(&world).is_empty(), "{:?}", cached(&world, "Contour2").warnings);
+    assert!(!noted(&world));
+}
+
+#[test]
+fn a_flipped_carry_judges_the_dive_against_the_flipped_body() {
+    // Flipped about the part's centre (Z 2.5): Setup1's unfaced bottom
+    // (-5) stands on top at Z 10 - the dive meets it.
+    let (world, _h) = program(100.0, 9.0, Hold::FlipX, 100.0);
+    let (d, c) = (dives(&world), convicted(&world));
+    assert!(c.contains(&d[0]), "dives {d:?}, convicted {c:?}");
+    assert!(noted(&world));
+}
+
+#[test]
+fn declared_stock_beyond_the_carried_block_is_judged_present() {
+    // Setup1 holds only a 12 mm block (x, y -1..11), faced to the part's
+    // top; Setup2 declares 100 mm standing to Z 10. The dive beside the
+    // part (past the carried block) lands in declared material the
+    // carried grid does not cover: it is never read as air.
+    let (world, mut h) = program(12.0, 5.0, Hold::SameAs, 100.0);
+    h.execute(&world, block(&world, 100.0, -5.0, 15.0));
+    h.execute(&world, GenerateOperation::new(&world, "Contour2").expect("regenerate"));
+    let (d, c) = (dives(&world), convicted(&world));
+    assert!(c.contains(&d[0]), "dives {d:?}, convicted {c:?}");
+}
+
+#[test]
+fn a_turn_off_the_quarter_with_only_a_non_rest_op_after_it_is_refused_by_name() {
+    // Contour2 (no rest reading) was generated while Setup2 held the part
+    // like Setup1; the part is then turned 30 degrees in Setup2. Its
+    // regeneration is refused by name, never cut against the declared
+    // block, and the program sim never judges the turned program.
+    let (world, mut h) = program(100.0, 5.0, Hold::SameAs, 100.0);
+    h.execute(&world, SetSetupRelative::unlink(&world, "Setup2").expect("unlink"));
+    h.execute(&world, AlignPartToSetup::angles(&world, "Setup2", [0.0, 0.0, 30.0]).expect("30 degrees"));
+    let generated = GenerateOperation::new(&world, "Contour2").err().expect("refused").to_string();
+    assert!(
+        generated.contains("Contour2")
+            && generated.contains(CARRY_TURN_REFUSAL)
+            && generated.contains("from setup 'Setup1' into setup 'Setup2'"),
+        "{generated}"
+    );
+    assert!(simulate_document(&world).is_err(), "the turned program is never judged");
+    assert!(!posting::verification_report(&world).problems.is_empty(), "nor posted");
+}
+
+#[test]
+fn an_overhang_no_feed_move_reaches_is_noted_and_posts() {
+    // Setup1 holds a 140 mm block faced to the part's top; Setup2 declares
+    // 100 mm. The carried rim stands 20 mm beside the declared stock, far
+    // from the contour round the part: noted by name, never refused.
+    let (world, _h) = program(140.0, 5.0, Hold::SameAs, 100.0);
+    let notes = cached(&world, "Contour2").path.notes;
+    assert!(!noted(&world), "{notes:?}");
+    assert!(notes.iter().any(|n| n.starts_with(CARRIED_OUTSIDE_NOTED) && n.contains("'Setup2'")), "{notes:?}");
+    let problems = posting::verification_report(&world).problems;
+    assert!(!problems.iter().any(|p| p.contains(CARRIED_OUTSIDE_DECLARED)), "{problems:?}");
+}
+
+/// A posed (3+2, untilted angles) face in the active setup, created only:
+/// its stamp is read, never cut.
+fn posed(world: &World, h: &mut History, name: &str) {
+    let mut p = face(5.0);
+    if let OpParams::Face { tilt, .. } = &mut p {
+        *tilt = Some(Tilt { a_deg: 0.0, b_deg: 0.0, origin: [0.0; 3] });
+    }
+    h.execute(world, CreateOperation::new(world, name, TOOL, SrcRef::Stock, p).expect("create posed"));
+}
+
+fn stamp(world: &World, name: &str) -> Option<operation::GenStamp> {
+    let e = model::find_by_name(world, name).expect("op");
+    let op = model::operation_of(world, &e).expect("operation");
+    operation::current_stamp(world, &op.tool, &op.src, &op.params, name, op.setup.as_deref())
+}
+
+/// Re-face Setup1 one millimetre deeper and regenerate it.
+fn reface(world: &World, h: &mut History) {
+    h.execute(world, EditOperationParams::new(world, "Face1", face(8.0)).expect("edit"));
+    h.execute(world, GenerateOperation::new(world, "Face1").expect("regenerate"));
+}
+
+#[test]
+fn a_setup1_change_restamps_the_carried_setups_ops_whose_stock_grew() {
+    // Setup2's job stock grew to the carried body (Z 9 over a declared 5):
+    // re-facing Setup1 moves both a non-rest op's and a posed op's stamp.
+    let (world, mut h) = program(100.0, 9.0, Hold::SameAs, 100.0);
+    posed(&world, &mut h, "Posed2");
+    assert!(camcraft_app::rest::carried_digest(&world, "Posed2", Some("Setup2")).is_some());
+    let before = (stamp(&world, "Contour2"), stamp(&world, "Posed2"));
+    reface(&world, &mut h);
+    let after = (stamp(&world, "Contour2"), stamp(&world, "Posed2"));
+    assert_ne!(before.0, after.0, "the non-rest op reads the carried body");
+    assert_ne!(before.1, after.1, "the posed op judges the stock the carried body spans");
+    assert_eq!(operation::status_of(&world, &model::find_by_name(&world, "Contour2").expect("op")), OpStatus::Stale);
+}
+
+#[test]
+fn single_setup_and_clip_entered_stamps_do_not_read_the_carry() {
+    // Clip-entered Setup2: nothing is carried, so re-facing Setup1 moves
+    // neither Setup2 stamp, and no carried term exists.
+    let (world, mut h) = program(100.0, 9.0, Hold::Clip, 100.0);
+    posed(&world, &mut h, "Posed2");
+    assert!(camcraft_app::rest::carried_digest(&world, "Contour2", Some("Setup2")).is_none());
+    assert!(camcraft_app::rest::carried_digest(&world, "Posed2", Some("Setup2")).is_none());
+    let before = (stamp(&world, "Contour2"), stamp(&world, "Posed2"));
+    reface(&world, &mut h);
+    assert_eq!(before, (stamp(&world, "Contour2"), stamp(&world, "Posed2")));
+    assert_eq!(operation::status_of(&world, &model::find_by_name(&world, "Contour2").expect("op")), OpStatus::Ok);
+    // One setup: a posed op after Face1 never digests the program ahead,
+    // so its stamp is the pre-#319 one whatever Face1 cuts.
+    let (one, mut h1) = program(100.0, 9.0, Hold::Clip, 100.0);
+    h1.execute(&one, camcraft_app::commands::ActivateSetup::new(&one, Some("Setup1")).expect("activate Setup1"));
+    posed(&one, &mut h1, "Posed1");
+    assert!(camcraft_app::rest::carried_digest(&one, "Posed1", Some("Setup1")).is_none());
+    let before = stamp(&one, "Posed1");
+    reface(&one, &mut h1);
+    assert_eq!(before, stamp(&one, "Posed1"));
+}
