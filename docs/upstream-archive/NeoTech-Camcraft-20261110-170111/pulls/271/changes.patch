diff --git a/crates/ui/src/egui_app/fixture_library_dialog.rs b/crates/ui/src/egui_app/fixture_library_dialog.rs
new file mode 100644
index 00000000..d83421d9
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_library_dialog.rs
@@ -0,0 +1,169 @@
+//! The fixture library dialogs (#339 slice 6), opened from a setup's
+//! Fixtures node menu: "Save fixture to library" (check the setup's
+//! fixtures, pick the datum, add a note; a name already in the library
+//! asks before it is replaced) and "Insert from library" (pick an entry,
+//! type the datum's origin and rotation, Insert - one undoable
+//! `InsertFixture` through the queue; Delete removes the entry from the
+//! library file after a confirmation). A modal like the unsaved prompt;
+//! Escape or the backdrop closes it.
+//! Provenance: our own layout over our own library format; no vendor
+//! fixture material consulted.
+
+use egui::{Id, Modal, RichText, ScrollArea, TextEdit};
+
+use camcraft_app::fixture_library::DatumChoice;
+
+use crate::state::{CommandKind, FixtureLibDialog, InsertFixtureDraft, State};
+
+use super::fields::{num, num_plain};
+
+/// What a click asked for; applied after the dialog is drawn.
+enum Act {
+    Close,
+    Save { replace: bool },
+    Insert(Box<CommandKind>),
+    Delete(String),
+}
+
+/// The Insert button's command for this draft (`None`: nothing picked).
+#[must_use]
+pub(crate) fn insert_command(d: &InsertFixtureDraft) -> Option<CommandKind> {
+    let entry = d.selected.clone()?;
+    Some(CommandKind::InsertFixtureFromLibrary {
+        entry,
+        setup: (!d.setup.is_empty()).then(|| d.setup.clone()),
+        pos: d.pos,
+        rpy_deg: d.rpy_deg,
+    })
+}
+
+fn setup_label(setup: &str) -> &str {
+    if setup.is_empty() { "the setup" } else { setup }
+}
+
+pub(crate) fn window(ctx: &egui::Context, state: &mut State) {
+    let u = state.units();
+    let path = state.fixture_library_path().map(|p| p.display().to_string()).unwrap_or_else(|e| e);
+    let Some(dialog) = state.fixture_lib.as_mut() else {
+        return;
+    };
+    let mut act: Option<Act> = None;
+    let response = Modal::new(Id::new("fixture-library")).show(ctx, |ui| {
+        ui.set_max_width(420.0);
+        match dialog {
+            FixtureLibDialog::Save(d) => {
+                ui.heading("Save fixture to library");
+                ui.label(RichText::new(&path).small());
+                ui.add_space(4.0);
+                if d.fixtures.is_empty() {
+                    ui.label(format!("{} has no fixtures to save.", setup_label(&d.setup)));
+                }
+                for (name, on) in &mut d.fixtures {
+                    ui.checkbox(on, name.as_str());
+                }
+                ui.label("Placed by");
+                ui.radio_value(&mut d.datum, DatumChoice::ModelOrigin, "Model origin");
+                ui.radio_value(&mut d.datum, DatumChoice::BottomCentre, "Bottom centre");
+                ui.label("Note");
+                ui.add(TextEdit::singleline(&mut d.note).desired_width(320.0));
+                if let Some(err) = &d.error {
+                    ui.colored_label(ui.visuals().error_fg_color, err);
+                }
+                ui.add_space(8.0);
+                if let Some(taken) = &d.confirm_replace {
+                    ui.label(format!("Replace {} in the library?", taken.join(", ")));
+                    ui.horizontal(|ui| {
+                        if ui.button("Replace").clicked() {
+                            act = Some(Act::Save { replace: true });
+                        }
+                        if ui.button("Cancel").clicked() {
+                            act = Some(Act::Close);
+                        }
+                    });
+                } else {
+                    ui.horizontal(|ui| {
+                        if ui.button("Save").clicked() {
+                            act = Some(Act::Save { replace: false });
+                        }
+                        if ui.button("Cancel").clicked() {
+                            act = Some(Act::Close);
+                        }
+                    });
+                }
+            }
+            FixtureLibDialog::Insert(d) => {
+                ui.heading("Insert from library");
+                ui.label(RichText::new(&path).small());
+                ui.add_space(4.0);
+                if d.rows.is_empty() && d.error.is_none() {
+                    ui.label("The library is empty - save a fixture to it first.");
+                }
+                ScrollArea::vertical().max_height(180.0).show(ui, |ui| {
+                    for r in &d.rows {
+                        let text = match &r.note {
+                            Some(n) => format!("{} - {} facets - {n}", r.name, r.facets),
+                            None => format!("{} - {} facets", r.name, r.facets),
+                        };
+                        if ui.selectable_label(d.selected.as_ref() == Some(&r.name), text).clicked() {
+                            d.selected = Some(r.name.clone());
+                            d.confirm_delete = None;
+                        }
+                    }
+                });
+                ui.label(format!("Datum at (into {})", setup_label(&d.setup)));
+                egui::Grid::new("fixture-lib-datum").num_columns(2).show(ui, |ui| {
+                    for (k, axis) in ["X", "Y", "Z"].iter().enumerate() {
+                        ui.label(*axis);
+                        num(ui, u, &mut d.pos[k]);
+                        ui.end_row();
+                    }
+                    for (k, axis) in ["Tilt about X (roll)", "Tilt about Y (pitch)", "Turn about Z (yaw)"].iter().enumerate() {
+                        ui.label(*axis);
+                        num_plain(ui, &mut d.rpy_deg[k]);
+                        ui.end_row();
+                    }
+                });
+                if let Some(err) = &d.error {
+                    ui.colored_label(ui.visuals().error_fg_color, err);
+                }
+                ui.add_space(8.0);
+                if let Some(name) = d.confirm_delete.clone() {
+                    ui.label(format!("Delete '{name}' from the library? This edits the file and cannot be undone."));
+                    ui.horizontal(|ui| {
+                        if ui.button("Delete").clicked() {
+                            act = Some(Act::Delete(name.clone()));
+                        }
+                        if ui.button("Keep").clicked() {
+                            d.confirm_delete = None;
+                        }
+                    });
+                } else {
+                    ui.horizontal(|ui| {
+                        let cmd = insert_command(d);
+                        if ui.add_enabled(cmd.is_some(), egui::Button::new("Insert")).clicked()
+                            && let Some(cmd) = cmd
+                        {
+                            act = Some(Act::Insert(Box::new(cmd)));
+                        }
+                        if ui.add_enabled(d.selected.is_some(), egui::Button::new("Delete from library…")).clicked() {
+                            d.confirm_delete = d.selected.clone();
+                        }
+                        if ui.button("Close").clicked() {
+                            act = Some(Act::Close);
+                        }
+                    });
+                }
+            }
+        }
+    });
+    if act.is_none() && response.should_close() {
+        act = Some(Act::Close);
+    }
+    match act {
+        Some(Act::Close) => state.fixture_lib = None,
+        Some(Act::Save { replace }) => state.save_fixtures_to_library(replace),
+        Some(Act::Insert(cmd)) => state.pending.push_back(*cmd),
+        Some(Act::Delete(name)) => state.delete_library_entry(&name),
+        None => {}
+    }
+}
diff --git a/crates/ui/src/egui_app/fixture_library_tests.rs b/crates/ui/src/egui_app/fixture_library_tests.rs
new file mode 100644
index 00000000..3315dd25
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_library_tests.rs
@@ -0,0 +1,150 @@
+//! #339 slice 6 in the shell, structurally: the Fixtures node's menu
+//! offers "Save fixture to library…" and "Insert from library…"; the
+//! save dialog writes the checked fixture into the library file and
+//! asks before replacing a name; the insert dialog lists the entries,
+//! and its Insert queues one `InsertFixture` (undo takes it away);
+//! Delete edits the file only after its confirmation. Driven through
+//! the real dialog code in a kittest harness - no pixels (the snapshot
+//! lane is release).
+//! Provenance: our own tests over our own shell; no vendor material.
+
+use egui::Vec2;
+use egui_kittest::Harness;
+use egui_kittest::kittest::Queryable;
+
+use camcraft_app::commands::{ImportModel, TagFixture};
+use camcraft_app::fixture;
+use camcraft_app::fixture_library;
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::model;
+
+use crate::state::{CommandKind, FixtureLibDialog, State, TreeMenuTarget};
+
+use super::fixture_library_dialog::{insert_command, window};
+use super::fixture_menu::menu_rows;
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn cube(lo: Point3, hi: Point3) -> Vec<Triangle> {
+    let c = |i: usize| {
+        p(if i & 1 == 0 { lo.x } else { hi.x }, if i & 2 == 0 { lo.y } else { hi.y }, if i & 4 == 0 { lo.z } else { hi.z })
+    };
+    let quads = [[0, 2, 3, 1], [4, 5, 7, 6], [0, 1, 5, 4], [2, 6, 7, 3], [0, 4, 6, 2], [1, 3, 7, 5]];
+    quads
+        .iter()
+        .flat_map(|q| [Triangle::new(c(q[0]), c(q[1]), c(q[2])), Triangle::new(c(q[0]), c(q[2]), c(q[3]))])
+        .collect()
+}
+
+/// A state with one fixture "Vise" and its own library folder.
+fn state_with_vise(tag: &str) -> State {
+    let mut state = State::new();
+    let dir = std::env::temp_dir().join(format!("camcraft-ui-fixlib-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    state.fixture_lib_dir = Some(dir);
+    state.history.execute(&state.world, ImportModel::from_mesh("Vise", Mesh::from_facets(cube(p(0.0, 0.0, 0.0), p(80.0, 30.0, 20.0)))));
+    state.history.execute(&state.world, TagFixture::new(&state.world, "Vise", None).expect("tag"));
+    state.doc_version += 1;
+    state
+}
+
+fn harness(state: State) -> Harness<'static, State> {
+    Harness::builder().with_size(Vec2::new(900.0, 900.0)).build_ui_state(|ui, st: &mut State| window(ui.ctx(), st), state)
+}
+
+fn library_names(state: &State) -> Vec<String> {
+    let path = state.fixture_library_path().expect("path");
+    fixture_library::load(&path).expect("reads").into_iter().map(|e| e.name).collect()
+}
+
+#[test]
+fn the_fixtures_node_menu_offers_save_and_insert_from_library() {
+    let state = State::new();
+    let rows = menu_rows(&state, &TreeMenuTarget::Fixtures("Setup2".into()));
+    let labels: Vec<&str> = rows.iter().map(|(l, _)| l.as_str()).collect();
+    assert_eq!(labels, ["Fixtures", "Import fixture…", "Save fixture to library…", "Insert from library…"]);
+    assert!(matches!(&rows[2].1, Some(CommandKind::FixtureLibrarySaveDialog(s)) if s == "Setup2"));
+    assert!(matches!(&rows[3].1, Some(CommandKind::FixtureLibraryInsertDialog(s)) if s == "Setup2"));
+}
+
+#[test]
+fn the_save_dialog_writes_the_fixture_and_asks_before_replacing() {
+    let mut state = state_with_vise("save");
+    state.pending.push_back(CommandKind::FixtureLibrarySaveDialog(String::new()));
+    state.drain_actions();
+    let Some(FixtureLibDialog::Save(d)) = &state.fixture_lib else { panic!("save dialog open") };
+    assert_eq!(d.fixtures, [("Vise".to_owned(), true)], "a lone fixture starts checked");
+    let mut h = harness(state);
+    h.run();
+    h.get_by_label("Save").click();
+    h.run();
+    assert!(h.state().fixture_lib.is_none(), "saved and closed: {:?}", h.state().fixture_lib);
+    assert_eq!(library_names(h.state()), ["Vise"]);
+
+    h.state_mut().open_fixture_library_save(String::new());
+    h.run();
+    h.get_by_label("Save").click();
+    h.run();
+    let Some(FixtureLibDialog::Save(d)) = &h.state().fixture_lib else { panic!("still open") };
+    assert_eq!(d.confirm_replace.as_deref(), Some(&["Vise".to_owned()][..]), "a clash asks first");
+    h.get_by_label("Replace").click();
+    h.run();
+    assert!(h.state().fixture_lib.is_none(), "replaced and closed");
+    assert_eq!(library_names(h.state()), ["Vise"]);
+}
+
+#[test]
+fn the_insert_dialog_queues_one_undoable_insert_and_delete_asks_first() {
+    let mut state = state_with_vise("insert");
+    state.open_fixture_library_save(String::new());
+    state.save_fixtures_to_library(false);
+    state.open_fixture_library_insert(String::new());
+    let Some(FixtureLibDialog::Insert(d)) = state.fixture_lib.as_mut() else { panic!("insert dialog open") };
+    assert_eq!(d.rows.iter().map(|r| r.name.as_str()).collect::<Vec<_>>(), ["Vise"]);
+    assert_eq!(d.selected.as_deref(), Some("Vise"), "the first entry is picked");
+    d.pos = [100.0, 0.0, 0.0];
+    let cmd = insert_command(d).expect("a command");
+    assert!(matches!(&cmd, CommandKind::InsertFixtureFromLibrary { entry, setup: None, pos, .. } if entry == "Vise" && pos[0] == 100.0));
+
+    let mut h = harness(state);
+    h.run();
+    h.get_by_label("Insert").click();
+    h.run();
+    h.state_mut().drain_actions();
+    let w = &h.state().world;
+    let copy = model::find_by_name(w, "Vise (2)").expect("inserted under the next free name");
+    assert!(fixture::def_of(w, &copy).is_some(), "tagged as a fixture");
+    assert_eq!(model::transform_of(w, &copy).map(|l| l.pos.x), Some(100.0));
+    assert!(h.state().fixture_lib.is_none(), "insert closes the dialog");
+    let st = h.state_mut();
+    assert!(st.history.undo(&st.world));
+    assert!(model::find_by_name(&st.world, "Vise (2)").is_none(), "one undo takes the insert");
+
+    h.state_mut().open_fixture_library_insert(String::new());
+    h.run();
+    h.get_by_label("Delete from library…").click();
+    h.run();
+    assert_eq!(library_names(h.state()), ["Vise"], "nothing deleted before the confirmation");
+    h.get_by_label("Delete").click();
+    h.run();
+    assert!(library_names(h.state()).is_empty(), "confirmed delete edits the file");
+    let Some(FixtureLibDialog::Insert(d)) = &h.state().fixture_lib else { panic!("still open") };
+    assert!(d.rows.is_empty() && d.selected.is_none());
+}
+
+#[test]
+fn a_corrupt_library_is_named_in_the_dialog_not_listed_as_empty() {
+    let mut state = State::new();
+    let dir = std::env::temp_dir().join(format!("camcraft-ui-fixlib-bad-{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&dir);
+    std::fs::write(dir.join(fixture_library::LIBRARY_FILE), "{\"format\":\"camcraft-fixtures\",\"version\":9}")
+        .expect("write");
+    state.fixture_lib_dir = Some(dir.clone());
+    state.open_fixture_library_insert(String::new());
+    let Some(FixtureLibDialog::Insert(d)) = &state.fixture_lib else { panic!("open") };
+    assert!(d.error.as_deref().is_some_and(|e| e.contains("version 9")), "{:?}", d.error);
+    assert!(insert_command(d).is_none(), "nothing to insert");
+    let _ = std::fs::remove_dir_all(&dir);
+}
diff --git a/crates/ui/src/egui_app/fixture_menu.rs b/crates/ui/src/egui_app/fixture_menu.rs
new file mode 100644
index 00000000..10c4030e
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_menu.rs
@@ -0,0 +1,123 @@
+//! The browser's fixture menu (#339 slice 4): a right-click on a model
+//! row offers "Use as fixture" (the active setup's) or "Stop using as
+//! fixture"; on a setup's Fixtures node, "Import fixture…" and the
+//! fixture library's "Save fixture to library…" / "Insert from
+//! library…" (#339 slice 6, `fixture_library_dialog`). Every row
+//! of slice 4 queues the very command the setup's Fixtures page queues
+//! (`TagFixture`, `UntagFixture`, `ImportFixtureDialog`) - one undo unit
+//! each, never a world poke. Hand-drawn like the operation menu
+//! (`tree_menu`): an Area at Foreground order; any other primary press
+//! closes it.
+//! Provenance: our own menu over our own commands; no HSMWorks material
+//! consulted.
+
+use egui::{Rect, Sense, Ui, Vec2};
+
+use camcraft_app::{model, setup};
+
+use crate::state::{CommandKind, SetupPage, State, TreeMenuTarget};
+
+use super::browser_tree::Leaf;
+use super::panes::{DROP_GAP, DROP_W};
+use super::theme::Tokens;
+
+/// The menu's rows: a header (no command), then the verbs. Empty when
+/// the target no longer stands (the menu then closes).
+pub(crate) fn menu_rows(state: &State, target: &TreeMenuTarget) -> Vec<(String, Option<CommandKind>)> {
+    let w = &state.world;
+    match target {
+        TreeMenuTarget::Model { name, .. } => {
+            let Some(e) = model::find_by_name(w, name).filter(|e| model::is_model(w, e)) else {
+                return Vec::new();
+            };
+            let verb = if model::is_fixture(w, &e) {
+                ("Stop using as fixture".to_owned(), CommandKind::UntagFixture(name.clone()))
+            } else {
+                // Workholding of the ACTIVE setup: the context every
+                // setup editor works in (a click on a setup's node
+                // activates it first).
+                let setup = setup::active(w);
+                let label = match &setup {
+                    Some(s) => format!("Use as fixture ({s})"),
+                    None => "Use as fixture".to_owned(),
+                };
+                (label, CommandKind::TagFixture { name: name.clone(), setup })
+            };
+            vec![("Fixture".to_owned(), None), (verb.0, Some(verb.1))]
+        }
+        TreeMenuTarget::Fixtures(s) => vec![
+            ("Fixtures".to_owned(), None),
+            ("Import fixture…".to_owned(), Some(CommandKind::ImportFixtureDialog)),
+            // #339 slice 6: the user fixture library.
+            ("Save fixture to library…".to_owned(), Some(CommandKind::FixtureLibrarySaveDialog(s.clone()))),
+            ("Insert from library…".to_owned(), Some(CommandKind::FixtureLibraryInsertDialog(s.clone()))),
+        ],
+        TreeMenuTarget::Operation(_) | TreeMenuTarget::Operations | TreeMenuTarget::Entry(_) => Vec::new(),
+    }
+}
+
+/// The row the menu hangs under.
+fn anchor_row(target: &TreeMenuTarget, leaves: &[Leaf]) -> Option<usize> {
+    match target {
+        TreeMenuTarget::Model { name, row } => {
+            (leaves.get(*row) == Some(&Leaf::Model(name.clone()))).then_some(*row).or_else(|| {
+                leaves.iter().position(|l| *l == Leaf::Model(name.clone()))
+            })
+        }
+        TreeMenuTarget::Fixtures(s) => leaves.iter().position(|l| *l == Leaf::Page(s.clone(), SetupPage::Fixtures)),
+        TreeMenuTarget::Operation(_) | TreeMenuTarget::Operations | TreeMenuTarget::Entry(_) => None,
+    }
+}
+
+/// Draw the menu for a model or Fixtures target; a click queues its
+/// command and closes the menu.
+pub(super) fn fixture_menu(ui: &mut Ui, state: &mut State, pal: &Tokens, rect: Rect, leaves: &[Leaf], target: &TreeMenuTarget) {
+    let lines = menu_rows(state, target);
+    let Some(ix) = anchor_row(target, leaves).filter(|_| !lines.is_empty()) else {
+        state.tree_menu = None;
+        return;
+    };
+    let anchor = egui::Pos2::new(rect.left(), rect.top() + (ix + 1) as f32 * pal.row_height + DROP_GAP);
+    let panel = Rect::from_min_size(anchor, Vec2::new(DROP_W, lines.len() as f32 * pal.row_height));
+    let mut chosen: Option<usize> = None;
+    egui::Area::new(ui.id().with(("fixture-menu", ix)))
+        .fixed_pos(anchor)
+        .order(egui::Order::Foreground)
+        .movable(false)
+        .show(ui.ctx(), |ui| {
+            let p = ui.painter();
+            p.rect_filled(panel, pal.radius_menu, pal.ink);
+            p.rect_stroke(panel, pal.radius_menu, egui::Stroke::new(1.0, pal.border), egui::StrokeKind::Outside);
+            for (k, (label, cmd)) in lines.iter().enumerate() {
+                let r = Rect::from_min_size(
+                    egui::Pos2::new(anchor.x, anchor.y + k as f32 * pal.row_height),
+                    Vec2::new(DROP_W, pal.row_height),
+                );
+                let resp = cmd.as_ref().map(|_| ui.interact(r, ui.id().with(("fixture-menu-row", k)), Sense::click()));
+                if resp.as_ref().is_some_and(egui::Response::hovered) {
+                    p.rect_filled(r, 0.0, pal.field_hover);
+                }
+                p.text(
+                    r.left_center() + Vec2::new(8.0, 0.0),
+                    egui::Align2::LEFT_CENTER,
+                    label,
+                    egui::FontId::proportional(pal.font_row),
+                    if cmd.is_some() { pal.text } else { pal.text_dim },
+                );
+                if resp.is_some_and(|r| r.clicked()) {
+                    chosen = Some(k);
+                }
+            }
+        });
+    if let Some(k) = chosen {
+        if let Some((_, Some(cmd))) = lines.into_iter().nth(k) {
+            state.pending.push_back(cmd);
+        }
+        state.tree_menu = None;
+    } else if ui.input(|i| {
+        i.pointer.button_pressed(egui::PointerButton::Primary)
+            && i.pointer.hover_pos().is_none_or(|pos| !panel.contains(pos))
+    }) {
+        state.tree_menu = None;
+    }
+}
diff --git a/crates/ui/src/egui_app/fixture_rows.rs b/crates/ui/src/egui_app/fixture_rows.rs
new file mode 100644
index 00000000..cbab658e
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_rows.rs
@@ -0,0 +1,108 @@
+//! One fixture's row on the Fixtures page (#509): drawn to fit a
+//! default-width properties pane - the name and its position wrap on
+//! one line, the verbs (Place, Unmark, Delete) stand on the next, the
+//! Fixed caption wraps instead of truncating, and the place draft is a
+//! labelled X / Y / Z / yaw form one click from every row. Every edit
+//! still lands through the same commands (`MoveFixture`,
+//! `SetFixtureFixed`, `UntagFixture`, `DeleteFixture`); the draft is
+//! view state, never history.
+//! Provenance: our own layout over our own commands; specced from the
+//! contributor's hands-on report on #509, no HSMWorks material involved.
+
+use egui::Ui;
+
+use camcraft_app::schema::Location;
+use camcraft_app::units;
+
+use crate::state::{CommandKind, FixtureUi, State, quat_yaw_deg};
+
+use super::layout::prop_row;
+use super::fields::{num, num_plain};
+
+const FIXED_HELP: &str = "On: a table or tailstock - it stands still while a rotary turns the part, \
+     so it is collision-checked in the machine frame. Off: a chuck, turning with the part.";
+
+/// The draft that opens `name`'s place form at where it stands now.
+fn draft_of(name: &str, loc: &Location) -> FixtureUi {
+    FixtureUi {
+        name: name.to_owned(),
+        x: loc.pos.x,
+        y: loc.pos.y,
+        z: loc.pos.z,
+        yaw_deg: quat_yaw_deg(loc.rot),
+    }
+}
+
+/// Draw one fixture: `loc` is where it stands, `fixed` its current
+/// turns-with-the-part flag (both read by the caller from the world).
+pub(super) fn row(ui: &mut Ui, state: &mut State, name: &str, loc: &Location, fixed: bool) {
+    let u = state.units();
+    let is_draft = state.fixture_ui.name == name;
+    // Line 1: the name and where it stands, wrapping inside the pane.
+    ui.horizontal_wrapped(|ui| {
+        if ui.selectable_label(is_draft, name).clicked() {
+            state.fixture_ui = draft_of(name, loc);
+        }
+        ui.label(format!(
+            "{}, {}, {}  yaw {:.1}°",
+            units::len(loc.pos.x, u, 2),
+            units::len(loc.pos.y, u, 2),
+            units::len(loc.pos.z, u, 2),
+            quat_yaw_deg(loc.rot)
+        ));
+    });
+    // Line 2: the verbs, left-aligned so none falls off the right edge.
+    ui.horizontal_wrapped(|ui| {
+        ui.add_space(12.0);
+        if ui
+            .selectable_label(is_draft, "Place…")
+            .on_hover_text("Set this fixture's X / Y / Z and yaw")
+            .clicked()
+        {
+            state.fixture_ui = if is_draft { FixtureUi::default() } else { draft_of(name, loc) };
+        }
+        if ui.small_button("Unmark").clicked() {
+            state.pending.push_back(CommandKind::UntagFixture(name.to_owned()));
+        }
+        if ui.small_button("Delete").clicked() {
+            state.pending.push_back(CommandKind::DeleteFixture(name.to_owned()));
+        }
+    });
+    if is_draft {
+        place_form(ui, state, name);
+    }
+    // #339 slice 4: how the gate judges this steel, and why a box.
+    if let Some(m) = state.fixture_mesh_state(name) {
+        ui.label(format!("Collision: {}", m.detail()));
+    }
+    // Whether the steel turns with the part (M13.8 (2)): a chuck rides
+    // the rotary, a tailstock or a table stands still and is judged in
+    // the machine frame. The box edits a copy - the flag lands through
+    // `SetFixtureFixed`, one undo unit, never a poke. Its caption is the
+    // checkbox's own text, so it wraps in the pane rather than truncating.
+    let mut on = fixed;
+    if ui.checkbox(&mut on, "Fixed (does not turn with the part)").on_hover_text(FIXED_HELP).changed() {
+        state.pending.push_back(CommandKind::SetFixtureFixed { name: name.to_owned(), fixed: on });
+    }
+}
+
+/// The place draft: one labelled field per axis, then Apply, which
+/// queues `MoveFixture` - the one undoable way a fixture moves.
+fn place_form(ui: &mut Ui, state: &mut State, name: &str) {
+    let u = state.units();
+    let d = &mut state.fixture_ui;
+    prop_row(ui, "Place X", |ui| num(ui, u, &mut d.x));
+    prop_row(ui, "Place Y", |ui| num(ui, u, &mut d.y));
+    prop_row(ui, "Place Z", |ui| num(ui, u, &mut d.z));
+    prop_row(ui, "Place yaw", |ui| num_plain(ui, &mut d.yaw_deg));
+    ui.horizontal(|ui| {
+        ui.add_space(12.0);
+        if ui.small_button("Apply").clicked() {
+            state.pending.push_back(CommandKind::MoveFixture {
+                name: name.to_owned(),
+                pos: [state.fixture_ui.x, state.fixture_ui.y, state.fixture_ui.z],
+                yaw_deg: state.fixture_ui.yaw_deg,
+            });
+        }
+    });
+}
diff --git a/crates/ui/src/egui_app/fixture_ux_tests.rs b/crates/ui/src/egui_app/fixture_ux_tests.rs
new file mode 100644
index 00000000..c05eaf61
--- /dev/null
+++ b/crates/ui/src/egui_app/fixture_ux_tests.rs
@@ -0,0 +1,222 @@
+//! #339 slice 4 in the shell, structurally: the browser's fixture menu
+//! rows (Use / Stop using as fixture on a model row, Import fixture… on
+//! a setup's Fixtures node) queue the Fixtures page's own commands and
+//! undo through the history; each Fixtures child row says how the gate
+//! judges it (`mesh` / `box only: <reason>`); and a selected op whose
+//! warnings strike a fixture raises the viewport tint flag and names
+//! the fixture in its banner. No pixels: the snapshot lane is release.
+//! Provenance: our own tests over our own shell; no HSMWorks material.
+
+use camcraft_app::commands::{
+    AddTool, CreateOperation, GenerateOperation, ImportModel, MoveFixture, SetStock, TagFixture,
+};
+use camcraft_app::fixture;
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+
+use crate::state::{CommandKind, SetupPage, State, TreeMenuTarget};
+
+use super::browser_tree::{Leaf, browser_rows};
+use super::fixture_menu::menu_rows;
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// A closed, outward box.
+fn cube(lo: Point3, hi: Point3) -> Vec<Triangle> {
+    let c = |i: usize| {
+        p(if i & 1 == 0 { lo.x } else { hi.x }, if i & 2 == 0 { lo.y } else { hi.y }, if i & 4 == 0 { lo.z } else { hi.z })
+    };
+    let quads = [[0, 2, 3, 1], [4, 5, 7, 6], [0, 1, 5, 4], [2, 6, 7, 3], [0, 4, 6, 2], [1, 3, 7, 5]];
+    quads
+        .iter()
+        .flat_map(|q| [Triangle::new(c(q[0]), c(q[1]), c(q[2])), Triangle::new(c(q[0]), c(q[2]), c(q[3]))])
+        .collect()
+}
+
+fn import(state: &mut State, name: &str, tris: Vec<Triangle>) {
+    state.history.execute(&state.world, ImportModel::from_mesh(name, Mesh::from_facets(tris)));
+    state.doc_version += 1;
+}
+
+fn mark(state: &mut State, name: &str) {
+    state.history.execute(&state.world, TagFixture::new(&state.world, name, None).expect("mark"));
+    state.doc_version += 1;
+}
+
+fn is_fixture(state: &State, name: &str) -> bool {
+    model::find_by_name(&state.world, name).is_some_and(|e| fixture::def_of(&state.world, &e).is_some())
+}
+
+fn labels(rows: &[(String, Option<CommandKind>)]) -> Vec<&str> {
+    rows.iter().map(|(l, _)| l.as_str()).collect()
+}
+
+#[test]
+fn a_model_row_menu_marks_and_unmarks_through_undoable_commands() {
+    let mut state = State::new();
+    import(&mut state, "Vise", cube(p(0.0, 0.0, 0.0), p(5.0, 5.0, 5.0)));
+    let target = TreeMenuTarget::Model { name: "Vise".into(), row: 0 };
+    let rows = menu_rows(&state, &target);
+    assert_eq!(labels(&rows), ["Fixture", "Use as fixture"]);
+    assert!(rows[0].1.is_none(), "the header is no verb");
+    let Some((_, Some(cmd))) = rows.into_iter().nth(1) else { panic!("a verb") };
+    assert!(matches!(&cmd, CommandKind::TagFixture { name, setup: None } if name == "Vise"), "{cmd:?}");
+    state.pending.push_back(cmd);
+    state.drain_actions();
+    assert!(is_fixture(&state, "Vise"));
+
+    let rows = menu_rows(&state, &target);
+    assert_eq!(labels(&rows), ["Fixture", "Stop using as fixture"]);
+    let Some((_, Some(cmd))) = rows.into_iter().nth(1) else { panic!("a verb") };
+    assert!(matches!(&cmd, CommandKind::UntagFixture(n) if n == "Vise"), "{cmd:?}");
+    state.pending.push_back(cmd);
+    state.drain_actions();
+    assert!(!is_fixture(&state, "Vise"));
+    state.pending.push_back(CommandKind::Undo);
+    state.drain_actions();
+    assert!(is_fixture(&state, "Vise"), "undo re-marks");
+    state.pending.push_back(CommandKind::Undo);
+    state.drain_actions();
+    assert!(!is_fixture(&state, "Vise"), "undo walks the mark back too");
+    assert!(model::find_by_name(&state.world, "Vise").is_some(), "the solid stays");
+}
+
+#[test]
+fn use_as_fixture_binds_to_the_active_setup_and_fixtures_offers_import() {
+    let mut state = State::new();
+    state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    state.drain_actions();
+    import(&mut state, "Vise", cube(p(0.0, 0.0, 0.0), p(5.0, 5.0, 5.0)));
+    let rows = menu_rows(&state, &TreeMenuTarget::Model { name: "Vise".into(), row: 0 });
+    assert_eq!(labels(&rows), ["Fixture", "Use as fixture (Setup1)"]);
+    assert!(matches!(&rows[1].1, Some(CommandKind::TagFixture { setup: Some(s), .. }) if s == "Setup1"));
+
+    let rows = menu_rows(&state, &TreeMenuTarget::Fixtures("Setup1".into()));
+    assert_eq!(labels(&rows), ["Fixtures", "Import fixture…", "Save fixture to library…", "Insert from library…"]);
+    assert!(matches!(rows[1].1, Some(CommandKind::ImportFixtureDialog)));
+    // The Fixtures node the menu anchors on stands in the tree.
+    let (_, leaves) = browser_rows(&state);
+    assert!(leaves.contains(&Leaf::Page("Setup1".into(), SetupPage::Fixtures)));
+    // A row whose model is gone offers nothing (the menu closes).
+    assert!(menu_rows(&state, &TreeMenuTarget::Model { name: "Gone".into(), row: 0 }).is_empty());
+}
+
+#[test]
+fn each_fixture_row_says_mesh_or_box_only_and_why() {
+    let mut state = State::new();
+    import(&mut state, "Closed", cube(p(0.0, 0.0, 0.0), p(10.0, 5.0, 20.0)));
+    let mut open = cube(p(20.0, 0.0, 0.0), p(30.0, 5.0, 20.0));
+    open.truncate(open.len() - 1);
+    import(&mut state, "Open", open);
+    mark(&mut state, "Closed");
+    mark(&mut state, "Open");
+    let (rows, leaves) = browser_rows(&state);
+    let suffix = |name: &str| {
+        // The Fixtures child (depth 2 under the implicit setup), not the
+        // Models row of the same name.
+        rows.iter()
+            .zip(&leaves)
+            .find(|(r, l)| **l == Leaf::Model(name.into()) && r.depth == 2)
+            .map(|(r, _)| r.suffix.clone())
+    };
+    assert_eq!(suffix("Closed").as_deref(), Some("mesh"));
+    assert_eq!(suffix("Open").as_deref(), Some("box only: open mesh"));
+    state.hidden_models.push("Open".into());
+    let (rows, leaves) = browser_rows(&state);
+    let hidden = rows.iter().zip(&leaves).find(|(r, l)| **l == Leaf::Model("Open".into()) && r.depth == 2);
+    assert_eq!(hidden.map(|(r, _)| r.suffix.as_str()), Some("box only: open mesh (hidden)"));
+}
+
+/// A face pass with one jaw reaching 1 mm into its low-y edge.
+fn struck_world() -> State {
+    let mut state = State::new();
+    let w = &state.world;
+    state.history.execute(
+        w,
+        SetStock::new(w, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Location::default()).expect("stock"),
+    );
+    let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0400-2FL").map(|(_, t)| t).expect("catalog");
+    state.history.execute(w, AddTool::new(w, "EM-0400-2FL", tool).expect("tool"));
+    let params = OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(25.0),
+        cut_z: Height::fixed(19.5),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    };
+    state.history.execute(w, CreateOperation::new(w, "Face1", "EM-0400-2FL", SrcRef::Stock, params).expect("op"));
+    state.history.execute(w, GenerateOperation::new(w, "Face1").expect("generate"));
+    let op = model::find_by_name(w, "Face1").expect("Face1");
+    let path = model::toolpath_of(w, &op).expect("path").path;
+    let (x0, y0, x1) = path.moves.iter().flat_map(|m| [m.from, m.to]).fold(
+        (f64::MAX, f64::MAX, f64::MIN),
+        |(a, b, c), q| (a.min(q.x), b.min(q.y), c.max(q.x)),
+    );
+    import(&mut state, "JawLo", cube(p(x0 - 10.0, y0 - 25.0, -5.0), p(x1 + 10.0, y0 - 1.0, 21.0)));
+    mark(&mut state, "JawLo");
+    state.history.execute(&state.world, GenerateOperation::new(&state.world, "Face1").expect("regenerate"));
+    state.doc_version += 1;
+    state
+}
+
+#[test]
+fn a_selected_op_tints_the_fixture_it_strikes_and_names_it() {
+    let mut state = struck_world();
+    assert!(state.fixture_highlight().is_empty(), "nothing selected, nothing tinted");
+    state.pending.push_back(CommandKind::Select(Some("Face1".into())));
+    state.drain_actions();
+    assert_eq!(state.fixture_highlight(), vec!["JawLo".to_owned()]);
+    let tinted = super::world::collect(&state)
+        .parts
+        .iter()
+        .filter(|g| !g.stock && !g.fill && !g.classes.is_empty())
+        .filter(|g| g.classes.iter().all(|c| *c == crate::viewport::STRUCK_CLASS))
+        .count();
+    assert_eq!(tinted, 1, "exactly the struck jaw wears the tint");
+    let (_, _, details) = super::op_page::status_text(&state, "Face1");
+    assert!(details.iter().any(|d| d.starts_with("Strikes fixture: JawLo")), "{details:?}");
+    // Display only: the tint queued nothing and changed no document.
+    assert!(state.pending.is_empty());
+}
+
+#[test]
