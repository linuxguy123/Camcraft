diff --git a/crates/app/src/commands/setup_align.rs b/crates/app/src/commands/setup_align.rs
new file mode 100644
index 00000000..1ec47e6a
--- /dev/null
+++ b/crates/app/src/commands/setup_align.rs
@@ -0,0 +1,325 @@
+//! `AlignPartToSetup` (#326): set how the part sits in one setup - the
+//! rigid transform from the document frame into the setup frame - or
+//! clear it back to "as modelled". The work offset is not touched: it is
+//! a plain translation placed in the setup frame (`SetSetupWorkOffset`,
+//! `SetWcsOrigin`).
+//!
+//! Provenance: our own design; re-clamping a part flipped or turned on
+//! the table is general shop practice, and the transform math is
+//! standard rigid-body algebra. No vendor implementation inspected.
+//!
+//! ## The laws this command keeps
+//!
+//! - **Validated and snapshotted at construction.** A finite position
+//!   and a quaternion that normalizes (`check_location`), a live setup,
+//!   a change from what is stored. `apply`/`invert` are pure writes.
+//! - **Identity is absence.** An alignment that does nothing is stored
+//!   as `None`, so "As modelled" restores the pre-#326 bytes.
+//! - **The stock follows like it follows `MoveModel`.** A stock made
+//!   from a part, or the stock of a one-part document, is re-placed by
+//!   the change and rebuilt square to the setup frame (a box or a
+//!   cylinder re-fits to the turned block's bounds). A cylinder whose
+//!   axis would leave the vertical, or a following stock another setup
+//!   shares, is refused by name - never silently left behind.
+//! - **The pivot is the parts' centre.** The presets and the numeric
+//!   angles turn the parts about the centre of their bounds, so a flip
+//!   leaves them on the same spot of the table. [`AlignPartToSetup::new`]
+//!   takes any rigid transform - the door the face pick (#330) uses,
+//!   through [`AlignPartToSetup::lay_on_plane`], and the in-plane axis
+//!   picks (#557), through [`AlignPartToSetup::turn_in_plane`].
+//! - **Linked setups follow (#316).** Every setup placed relative to
+//!   this one (directly or through others, [`crate::setup_relative`])
+//!   keeps its transform to it: the command re-places each of them, with
+//!   its following stock, in the same undo unit - or refuses the whole
+//!   change, naming the setup that cannot follow.
+
+use flecs_ecs::prelude::World;
+
+use crate::commands::fixture::check_location;
+use crate::commands::{Command, CommandError};
+use crate::geometry::{Point3, Triangle, transform_point};
+use crate::model;
+use crate::schema::{Location, SetupDef, StockDef};
+use crate::setup_align::{self, AlignPreset};
+use crate::stock::{self, StockShape};
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+
+type StockState = (StockShape, Location, std::sync::Arc<[Triangle]>);
+
+/// The setup's (held, new) alignment for `alignment`, normalised (the
+/// identity is "as modelled"); refused when nothing would change.
+fn change_of(
+    world: &World,
+    setup: &str,
+    alignment: Option<Location>,
+) -> Result<(Option<Location>, Option<Location>), CommandError> {
+    let entity = model::find_by_name(world, setup).ok_or_else(|| CommandError::NotFound(setup.to_string()))?;
+    let prev = entity
+        .entity_view(world)
+        .try_get::<&SetupDef>(|d| d.part_alignment)
+        .ok_or_else(|| CommandError::Invalid(format!("'{setup}' is not a setup")))?;
+    let next = match alignment {
+        None => None,
+        Some(a) => {
+            let a = check_location(a, "the part alignment")?;
+            let still = a.pos == Point3::ZERO && setup_align::is_identity_rot(a.rot);
+            (!still).then_some(a)
+        }
+    };
+    if next == prev {
+        return Err(CommandError::Invalid(format!("setup '{setup}' already holds the part that way")));
+    }
+    Ok((prev, next))
+}
+
+/// One setup's alignment change, with its following stock.
+struct Step {
+    setup: String,
+    prev: Option<Location>,
+    next: Option<Location>,
+    /// The following stock: entity name, before, after.
+    stock: Option<(String, StockState, StockState)>,
+}
+
+/// Write (or clear) a setup's part alignment.
+pub struct AlignPartToSetup {
+    main: Step,
+    /// #316: the setups linked below this one, re-placed with it (parents
+    /// before children).
+    carried: Vec<Step>,
+}
+
+impl AlignPartToSetup {
+    /// Any rigid transform document -> setup frame; `None` clears.
+    pub fn new(world: &World, setup: &str, alignment: Option<Location>) -> Result<Self, CommandError> {
+        let (prev, next) = change_of(world, setup, alignment)?;
+        let stock = following_stock(world, setup, prev, next)?;
+        let mut carried = Vec::new();
+        for (child, c_prev, c_next) in crate::setup_relative::carried(world, setup, prev, next) {
+            let follow = |e: CommandError| {
+                let why = match e {
+                    CommandError::Invalid(m) => m,
+                    other => other.to_string(),
+                };
+                CommandError::Invalid(format!(
+                    "setup '{child}' is placed relative to '{setup}' and must follow the change, but {why}"
+                ))
+            };
+            let c_next = c_next.map(|a| check_location(a, "the carried part alignment")).transpose().map_err(follow)?;
+            let stock = following_stock(world, &child, c_prev, c_next).map_err(follow)?;
+            carried.push(Step { setup: child, prev: c_prev, next: c_next, stock });
+        }
+        Ok(AlignPartToSetup { main: Step { setup: setup.to_string(), prev, next, stock }, carried })
+    }
+
+    /// How many linked setups this change re-places with it (#316).
+    #[must_use]
+    pub fn carried_count(&self) -> usize {
+        self.carried.len()
+    }
+
+    /// Would [`Self::lay_on_plane`] be accepted? The same refusals, by
+    /// name ("already holds the part that way" included), without
+    /// building the command: the Setups page greys Apply out with it.
+    pub fn check_lay(
+        world: &World,
+        setup: &str,
+        picks: &[crate::operation::GeoSel],
+        lay: crate::pick::PlaneLay,
+    ) -> Result<(), CommandError> {
+        let at = crate::pick::lay_on_plane(world, picks, lay).map_err(CommandError::Invalid)?;
+        change_of(world, setup, Some(at)).map(|_| ())
+    }
+
+    /// Lay the part on a G17 / G18 / G19 plane from a pick (#330): one
+    /// flat face, read by [`crate::pick::lay_on_plane`] (an edge is
+    /// refused by name, #554).
+    /// A refused pick is refused here, by name, before anything is written.
+    pub fn lay_on_plane(
+        world: &World,
+        setup: &str,
+        picks: &[crate::operation::GeoSel],
+        lay: crate::pick::PlaneLay,
+    ) -> Result<Self, CommandError> {
+        let at = crate::pick::lay_on_plane(world, picks, lay).map_err(CommandError::Invalid)?;
+        Self::new(world, setup, Some(at))
+    }
+
+    /// Would [`Self::turn_in_plane`] be accepted? The same refusals, by
+    /// name, without building the command (the Setups page's Apply).
+    pub fn check_turn(world: &World, setup: &str, axes: &crate::pick::InPlaneAxes) -> Result<(), CommandError> {
+        let at = crate::pick::turn_in_plane(world, setup, axes).map_err(CommandError::Invalid)?;
+        change_of(world, setup, Some(at)).map(|_| ())
+    }
+
+    /// Turn the part in the work plane from picks (#557): a straight edge
+    /// or two points for +Y and/or +X, read by
+    /// [`crate::pick::turn_in_plane`] in the setup's current frame and
+    /// composed onto its alignment. Refused by name before any write.
+    pub fn turn_in_plane(world: &World, setup: &str, axes: &crate::pick::InPlaneAxes) -> Result<Self, CommandError> {
+        let at = crate::pick::turn_in_plane(world, setup, axes).map_err(CommandError::Invalid)?;
+        Self::new(world, setup, Some(at))
+    }
+
+    /// One of the Setups page's quick choices.
+    pub fn preset(world: &World, setup: &str, preset: AlignPreset) -> Result<Self, CommandError> {
+        Self::angles(world, setup, preset.angles())
+    }
+
+    /// Turn the parts about X, then Y, then Z (degrees) about the centre
+    /// of their bounds. All zero is "as modelled".
+    pub fn angles(world: &World, setup: &str, deg: [f64; 3]) -> Result<Self, CommandError> {
+        let rot = setup_align::rotation_from_angles(deg)
+            .ok_or_else(|| CommandError::Invalid("the alignment angles must be finite numbers".into()))?;
+        if setup_align::is_identity_rot(rot) {
+            return Self::new(world, setup, None);
+        }
+        let c = setup_align::part_centre(world)
+            .ok_or_else(|| CommandError::Invalid("there is no part to align - import a model first".into()))?;
+        Self::new(world, setup, setup_align::about_centre(rot, c))
+    }
+}
+
+impl Step {
+    fn write(&self, world: &World, alignment: Option<Location>, stock: Option<&StockState>) {
+        if let Some(entity) = model::find_by_name(world, &self.setup) {
+            let view = entity.entity_view(world);
+            if let Some(mut def) = view.try_get::<&SetupDef>(|d| d.clone()) {
+                def.part_alignment = alignment;
+                view.set(def);
+            }
+        }
+        if let (Some((name, before, after)), Some((shape, loc, facets))) = (&self.stock, stock)
+            && let Some(entity) = model::find_by_name(world, name)
+        {
+            model::set_transform(world, &entity, *loc);
+            // Re-mesh only a block that changed size: a flip that keeps
+            // the box moves it, and its geometry revision stays put.
+            if before.0 != after.0 {
+                model::set_facets(world, &entity, facets.clone());
+                entity.entity_view(world).set(StockDef { shape: shape.clone() });
+            }
+        }
+    }
+}
+
+impl Command for AlignPartToSetup {
+    fn apply(&self, world: &World) {
+        for step in std::iter::once(&self.main).chain(&self.carried) {
+            step.write(world, step.next, step.stock.as_ref().map(|(_, _, after)| after));
+        }
+    }
+
+    fn invert(&self, world: &World) {
+        for step in self.carried.iter().rev().chain(std::iter::once(&self.main)) {
+            step.write(world, step.prev, step.stock.as_ref().map(|(_, before, _)| before));
+        }
+    }
+}
+
+/// The setup's stock as it must stand after the alignment changes from
+/// `prev` to `next`, when it follows the part; `None` when it does not
+/// follow (or there is no stock yet).
+fn following_stock(
+    world: &World,
+    setup: &str,
+    prev: Option<Location>,
+    next: Option<Location>,
+) -> Result<Option<(String, StockState, StockState)>, CommandError> {
+    let name = crate::setup::stock_entity_name(world, Some(setup));
+    let Some(entity) = model::find_by_name(world, &name) else { return Ok(None) };
+    let Some(shape) = model::stock_def_of(world, &entity) else { return Ok(None) };
+    let parts = model::model_entities(world)
+        .into_iter()
+        .filter(|(_, e)| !model::is_fixture(world, e))
+        .map(|(n, _)| n)
+        .collect::<Vec<_>>();
+    let follows = match &shape {
+        StockShape::FromModel { source } => parts.contains(source),
+        _ => parts.len() == 1,
+    };
+    if !follows {
+        return Ok(None);
+    }
+    if crate::setup::is_furniture_of_other(world, &name, setup) {
+        return Err(CommandError::Invalid(format!(
+            "the stock '{name}' is shared with another setup - turning the part here would move it there too; \
+             give this setup its own stock first"
+        )));
+    }
+    let loc = model::transform_of(world, &entity).unwrap_or_default();
+    let facets = model::facets_of(world, &entity).unwrap_or_default();
+    // The change as one transform: undo the old alignment, apply the new.
+    let undo = prev.map_or_else(Location::default, setup_align::inverse);
+    let delta = setup_align::compose(next.unwrap_or_default(), undo);
+    let after = match &shape {
+        StockShape::FromModel { .. } => {
+            let moved = check_location(setup_align::compose(delta, loc), &format!("stock '{name}'"))?;
+            (shape.clone(), moved, facets.clone())
+        }
+        StockShape::Box { dx, dy, dz } => {
+            let corners = [-0.5, 0.5]
+                .into_iter()
+                .flat_map(|x| [-0.5, 0.5].map(|y| (x, y)))
+                .flat_map(|(x, y)| [0.0, 1.0].map(|z| Point3::new(x * dx, y * dy, z * dz)));
+            let moved: Vec<Point3> = corners.map(|p| place(delta, loc, p)).collect();
+            refit_box(&name, &moved)?
+        }
+        StockShape::Cylinder { diameter, height } => {
+            let bottom = place(delta, loc, Point3::ZERO);
+            let top = place(delta, loc, Point3::new(0.0, 0.0, *height));
+            let axis = Point3::new(top.x - bottom.x, top.y - bottom.y, top.z - bottom.z);
+            // Written so a NaN reads as "not upright" and refuses.
+            let upright = axis.z.abs() >= height * (1.0 - 1e-9);
+            if !upright {
+                return Err(CommandError::Invalid(format!(
+                    "the cylinder stock '{name}' would lie on its side - only turns that keep it upright \
+                     can carry it; set the stock again after aligning"
+                )));
+            }
+            let pos = Point3::new(bottom.x, bottom.y, bottom.z.min(top.z));
+            let shape = StockShape::Cylinder { diameter: *diameter, height: *height };
+            let mesh = mesh_of(&shape, &name)?;
+            (shape, check_location(Location { pos, ..Location::default() }, &format!("stock '{name}'"))?, mesh)
+        }
+    };
+    Ok(Some((name, (shape, loc, facets), after)))
+}
+
+/// A stock-local point through its placement, then through the change.
+fn place(delta: Location, loc: Location, p: Point3) -> Point3 {
+    let world_p = transform_point(p, loc.pos, loc.rot);
+    transform_point(world_p, delta.pos, delta.rot)
+}
+
+/// The box square to the setup frame that holds the turned block.
+fn refit_box(name: &str, pts: &[Point3]) -> Result<StockState, CommandError> {
+    let (mut lo, mut hi) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+    for p in pts {
+        for (i, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+            lo[i] = lo[i].min(v);
+            hi[i] = hi[i].max(v);
+        }
+    }
+    // A micron of float noise on a quarter turn is not a new size.
+    let snap = |v: f64| (v * 1e6).round() / 1e6;
+    let shape = StockShape::Box {
+        dx: snap(hi[0] - lo[0]),
+        dy: snap(hi[1] - lo[1]),
+        dz: snap(hi[2] - lo[2]),
+    };
+    let mesh = mesh_of(&shape, name)?;
+    let pos = Point3::new(snap(0.5 * (lo[0] + hi[0])), snap(0.5 * (lo[1] + hi[1])), snap(lo[2]));
+    let at = check_location(Location { pos, ..Location::default() }, &format!("stock '{name}'"))?;
+    Ok((shape, at, mesh))
+}
+
+fn mesh_of(shape: &StockShape, name: &str) -> Result<std::sync::Arc<[Triangle]>, CommandError> {
+    if !shape.is_sane() || !shape.is_bounded() {
+        return Err(CommandError::Invalid(format!("the stock '{name}' cannot be rebuilt in the turned frame")));
+    }
+    stock::stock_mesh(shape)
+        .map(Into::into)
+        .ok_or_else(|| CommandError::Invalid(format!("the stock '{name}' cannot be rebuilt in the turned frame")))
+}
diff --git a/crates/app/src/commands/setup_delete.rs b/crates/app/src/commands/setup_delete.rs
new file mode 100644
index 00000000..c460b21e
--- /dev/null
+++ b/crates/app/src/commands/setup_delete.rs
@@ -0,0 +1,125 @@
+//! Setup deletion and its guards, split from commands::setup (#398).
+//! Provenance: our own design over general re-clamp practice; no vendor implementation inspected.
+
+use flecs_ecs::core::EntityViewGet;
+use flecs_ecs::prelude::World;
+
+use super::setup::StockSnap;
+use crate::commands::{Command, CommandError};
+use crate::model;
+use crate::schema::{Location, STOCK_NAME, SetupDef, StockDef, WCS_SLOTS, Wcs};
+use crate::setup;
+
+/// Delete a setup, its private furniture, and its claim on the program.
+/// Refused while any operation still machines in it.
+pub struct DeleteSetup {
+    name: String,
+    def: SetupDef,
+    /// Furniture that goes with the setup: entities this setup alone
+    /// names. Shared legacy names (`Stock`, `G54`..) and anything
+    /// another setup points at are NOT deleted.
+    stock: Option<StockSnap>,
+    wcs: Option<(String, Location)>,
+    prev_active: Option<String>,
+}
+
+impl DeleteSetup {
+    pub fn new(world: &World, name: &str) -> Result<Self, CommandError> {
+        let entity = model::find_by_name(world, name)
+            .ok_or_else(|| CommandError::NotFound(name.to_string()))?;
+        let def = entity
+            .entity_view(world)
+            .try_get::<&SetupDef>(|d| d.clone())
+            .ok_or_else(|| CommandError::Invalid(format!("'{name}' is not a setup")))?;
+        // Refusal: an operation that would orphan its own program
+        // position. `belongs` is the single predicate the order law uses.
+        // #155: a Pause / Home entry of its list holds it the same way.
+        for (op_name, op_e) in crate::program_entry::sequence(world) {
+            let declared = crate::program_entry::declared_setup(world, &op_e);
+            if setup::belongs(world, declared.as_deref(), name) {
+                return Err(CommandError::Invalid(format!(
+                    "'{op_name}' machines in '{name}' - move or delete it first"
+                )));
+            }
+        }
+        // #316: a setup placed relative to this one would lose the setup
+        // its edits follow - refused by name, like an operation.
+        if let Some(child) = crate::setup_relative::dependents(world, name).first() {
+            return Err(CommandError::Invalid(format!(
+                "'{child}' is placed relative to '{name}' - unlink it first"
+            )));
+        }
+        let owned = |n: &str| {
+            n != STOCK_NAME
+                && !WCS_SLOTS.contains(&n)
+                && !setup::is_furniture_of_other(world, n, name)
+        };
+        let stock = if owned(&def.stock) {
+            model::find_by_name(world, &def.stock).and_then(|e| {
+                model::stock_def_of(world, &e).map(|shape| StockSnap {
+                    name: def.stock.clone(),
+                    shape,
+                    location: model::transform_of(world, &e).unwrap_or_default(),
+                    facets: model::facets_of(world, &e).unwrap_or_default(),
+                })
+            })
+        } else {
+            None
+        };
+        let wcs = if owned(&def.wcs) {
+            model::find_by_name(world, &def.wcs)
+                .filter(|e| model::is_wcs(world, e))
+                .and_then(|e| model::transform_of(world, &e))
+                .map(|loc| (def.wcs.clone(), loc))
+        } else {
+            None
+        };
+        Ok(DeleteSetup {
+            name: name.to_string(),
+            def,
+            stock,
+            wcs,
+            prev_active: setup::active(world),
+        })
+    }
+}
+
+impl Command for DeleteSetup {
+    fn apply(&self, world: &World) {
+        if let Some(s) = &self.stock
+            && let Some(e) = model::find_by_name(world, &s.name)
+        {
+            model::remove(world, &e);
+        }
+        if let Some((wname, _)) = &self.wcs
+            && let Some(e) = model::find_by_name(world, wname)
+        {
+            model::remove(world, &e);
+        }
+        if let Some(e) = model::find_by_name(world, &self.name) {
+            model::remove(world, &e);
+        }
+        // The active-setup singleton is left pointing where it pointed:
+        // `setup::active`'s existence fallback makes a deleted name read
+        // as the first remaining setup, exactly the law.
+    }
+
+    fn invert(&self, world: &World) {
+        let entity = model::spawn(world, &self.name);
+        entity.entity_view(world).set(self.def.clone());
+        if let Some(s) = &self.stock {
+            let e = model::spawn(world, &s.name);
+            model::set_transform(world, &e, s.location);
+            model::set_facets(world, &e, s.facets.clone());
+            e.entity_view(world).set(StockDef {
+                shape: s.shape.clone(),
+            });
+        }
+        if let Some((wname, loc)) = &self.wcs {
+            let e = model::spawn(world, wname);
+            e.entity_view(world).add(Wcs);
+            model::set_transform(world, &e, *loc);
+        }
+        setup::set_active(world, self.prev_active.clone());
+    }
+}
diff --git a/crates/app/src/commands/setup_mount.rs b/crates/app/src/commands/setup_mount.rs
new file mode 100644
index 00000000..202b1f6f
--- /dev/null
+++ b/crates/app/src/commands/setup_mount.rs
@@ -0,0 +1,159 @@
+//! `SetSetupMachine` / `SetSetupPost` (#343): give a setup its own machine
+//! or post, change it, or let it follow the document's again (`None`).
+//! Construction validates exactly like `LoadMachine` / `SelectPost` (a
+//! machine stating an impossible limit, an unreadable or broken `.cps`, a
+//! registry name that does not exist - each refused by name) and
+//! snapshots both values; `apply` / `invert` are pure writes, so undo puts
+//! the previous mount back byte for byte.
+//!
+//! Provenance: our own design (setup furniture, the `SetSetupWorkOffset`
+//! shape); no vendor implementation inspected.
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::World;
+
+use crate::commands::{Command, CommandError};
+use crate::machine::Machine;
+use crate::model;
+use crate::schema::{MachineDef, PostRef, SetupDef};
+
+fn def_of(world: &World, setup: &str) -> Result<SetupDef, CommandError> {
+    let entity = model::find_by_name(world, setup)
+        .ok_or_else(|| CommandError::NotFound(setup.to_string()))?;
+    entity
+        .entity_view(world)
+        .try_get::<&SetupDef>(|d| d.clone())
+        .ok_or_else(|| CommandError::Invalid(format!("'{setup}' is not a setup")))
+}
+
+fn write(world: &World, setup: &str, edit: impl FnOnce(&mut SetupDef)) {
+    let Some(entity) = model::find_by_name(world, setup) else {
+        return;
+    };
+    let view = entity.entity_view(world);
+    if let Some(mut def) = view.try_get::<&SetupDef>(|d| d.clone()) {
+        edit(&mut def);
+        view.set(def);
+    }
+}
+
+/// Write a setup's own machine; `None` follows the document's.
+#[derive(Debug)]
+pub struct SetSetupMachine {
+    setup: String,
+    prev: Option<MachineDef>,
+    next: Option<MachineDef>,
+}
+
+impl SetSetupMachine {
+    /// `next`: `Some((path, machine))` mounts that machine on the setup
+    /// (`machine: None` - deliberately no machine); `None` follows the
+    /// document again.
+    pub fn new(
+        world: &World,
+        setup: &str,
+        next: Option<(String, Option<Machine>)>,
+    ) -> Result<Self, CommandError> {
+        let def = def_of(world, setup)?;
+        if let Some((_, Some(m))) = &next
+            && !m.is_sane()
+        {
+            return Err(CommandError::Invalid(
+                "machine states a limit that cannot be meant".to_owned(),
+            ));
+        }
+        let next = next.map(|(path, machine)| MachineDef { path, machine });
+        if def.machine == next {
+            return Err(CommandError::Invalid(match next {
+                None => format!("setup '{setup}' already follows the document's machine"),
+                Some(_) => format!("setup '{setup}' already mounts that machine"),
+            }));
+        }
+        Ok(Self { setup: setup.to_owned(), prev: def.machine, next })
+    }
+
+    /// Mount a shipped library machine by NAME (the `LoadMachine::builtin`
+    /// law: a stale name refuses, never mounts another machine).
+    pub fn builtin(world: &World, setup: &str, name: &str) -> Result<Self, CommandError> {
+        let text = crate::posting::MACHINES
+            .iter()
+            .find(|(n, _)| *n == name)
+            .map(|(_, t)| *t)
+            .ok_or_else(|| CommandError::Invalid(format!("machine {name} is not in the built-in library")))?;
+        let m = crate::machine::parse_mch(text).map_err(CommandError::Invalid)?;
+        Self::new(world, setup, Some((crate::posting::builtin_path(name), Some(m))))
+    }
+
+    /// Read and parse a `.mch` file, then mount it; the refusal names the file.
+    pub fn from_file(world: &World, setup: &str, path: &std::path::Path) -> Result<Self, CommandError> {
+        let text = std::fs::read_to_string(path)
+            .map_err(|e| CommandError::Invalid(format!("machine file {}: {e}", path.display())))?;
+        let m = crate::machine::parse_mch(&text).map_err(CommandError::Invalid)?;
+        Self::new(world, setup, Some((path.display().to_string(), Some(m))))
+    }
+
+    /// Mount a Machines-pane catalogue machine (#384), read and
+    /// validated again (`library::read_for_assign`): a refused file
+    /// never becomes the setup's machine.
+    pub fn from_catalogue(
+        world: &World,
+        setup: &str,
+        source: &crate::machine::library::MachineSource,
+    ) -> Result<Self, CommandError> {
+        let (path, m) = crate::machine::library::read_for_assign(source).map_err(CommandError::Invalid)?;
+        Self::new(world, setup, Some((path, Some(m))))
+    }
+
+    #[must_use]
+    pub fn setup(&self) -> &str {
+        &self.setup
+    }
+}
+
+impl Command for SetSetupMachine {
+    fn apply(&self, world: &World) {
+        let next = self.next.clone();
+        write(world, &self.setup, |d| d.machine = next);
+    }
+
+    fn invert(&self, world: &World) {
+        let prev = self.prev.clone();
+        write(world, &self.setup, |d| d.machine = prev);
+    }
+}
+
+/// Write a setup's own post; `None` follows the document's.
+#[derive(Debug)]
+pub struct SetSetupPost {
+    setup: String,
+    prev: Option<PostRef>,
+    next: Option<PostRef>,
+}
+
+impl SetSetupPost {
+    pub fn new(world: &World, setup: &str, next: Option<PostRef>) -> Result<Self, CommandError> {
+        let def = def_of(world, setup)?;
+        if let Some(p) = &next {
+            super::post::validate(p)?;
+        }
+        if def.post == next {
+            return Err(CommandError::Invalid(match next {
+                None => format!("setup '{setup}' already follows the document's post"),
+                Some(_) => format!("setup '{setup}' already posts with that post"),
+            }));
+        }
+        Ok(Self { setup: setup.to_owned(), prev: def.post, next })
+    }
+}
+
+impl Command for SetSetupPost {
+    fn apply(&self, world: &World) {
+        let next = self.next.clone();
+        write(world, &self.setup, |d| d.post = next);
+    }
+
+    fn invert(&self, world: &World) {
+        let prev = self.prev.clone();
+        write(world, &self.setup, |d| d.post = prev);
+    }
+}
diff --git a/crates/app/src/commands/setup_relative.rs b/crates/app/src/commands/setup_relative.rs
new file mode 100644
index 00000000..8780ad9d
--- /dev/null
+++ b/crates/app/src/commands/setup_relative.rs
@@ -0,0 +1,116 @@
+//! `SetSetupRelative` (#316): place a setup relative to another - "this
+//! setup is that one flipped over X / turned 90° about Z / turned by
+//! these angles" - or unlink it. The turn is resolved into the setup's
+//! part alignment (#326) through `AlignPartToSetup`, so there is still
+//! one transform per setup; the link only makes a later change of the
+//! other setup's alignment carry into this one
+//! ([`crate::setup_relative::carried`]).
+//!
+//! Provenance: our own design; re-clamping a part flipped or turned
+//! between setups is plain shop practice, the algebra standard rigid-
+//! body composition. No vendor implementation inspected.
+//!
+//! ## The laws this command keeps
+//!
+//! - **Validated and snapshotted at construction.** Both setups live,
+//!   not the same setup, no loop of links, finite angles, and a change
+//!   from what is held. `apply`/`invert` are pure writes.
+//! - **The work offset is not touched.** The turn is on the part; the
+//!   `G54`..`G59` word and the WCS origin stay as they are.
+//! - **Unlinking keeps the part where it is.** Only the link goes; the
+//!   alignment stays, so nothing moves and no path goes stale.
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::World;
+
+use crate::commands::{AlignPartToSetup, Command, CommandError};
+use crate::model;
+use crate::schema::SetupDef;
+use crate::setup;
+use crate::setup_relative;
+
+/// Link (or unlink) a setup to the setup it is a re-clamp of.
+pub struct SetSetupRelative {
+    setup: String,
+    prev_link: Option<String>,
+    next_link: Option<String>,
+    /// The alignment change the turn needs (`None`: the part already sits
+    /// that way).
+    align: Option<AlignPartToSetup>,
+}
+
+impl SetSetupRelative {
+    /// Place `name` relative to `parent`, turned by `deg` (about X, then
+    /// Y, then Z, degrees) in `parent`'s frame about the parts' centre.
+    /// All zero is "the same as `parent`".
+    pub fn link(world: &World, name: &str, parent: &str, deg: [f64; 3]) -> Result<Self, CommandError> {
+        let prev_link = held_link(world, name)?;
+        if !setup::exists(world, parent) {
+            return Err(CommandError::NotFound(parent.to_string()));
+        }
+        if parent == name {
+            return Err(CommandError::Invalid(format!("setup '{name}' cannot be placed relative to itself")));
+        }
+        if setup_relative::links_back_to(world, parent, name) {
+            return Err(CommandError::Invalid(format!(
+                "'{parent}' is already placed relative to '{name}' - linking back would make a loop"
+            )));
+        }
+        let rot = setup_relative::rotation(deg).map_err(CommandError::Invalid)?;
+        let next = setup_relative::relative_alignment(world, parent, rot).map_err(CommandError::Invalid)?;
+        let held = crate::setup_align::stored(world, name);
+        let align = if setup_relative::same(held, next) {
+            None
+        } else {
+            Some(AlignPartToSetup::new(world, name, next)?)
+        };
+        if align.is_none() && prev_link.as_deref() == Some(parent) {
+            return Err(CommandError::Invalid(format!("setup '{name}' already sits that way relative to '{parent}'")));
+        }
+        Ok(SetSetupRelative { setup: name.to_string(), prev_link, next_link: Some(parent.to_string()), align })
+    }
+
+    /// Unlink `name`: the part stays where it is.
+    pub fn unlink(world: &World, name: &str) -> Result<Self, CommandError> {
+        let prev_link = held_link(world, name)?;
+        if prev_link.is_none() {
+            return Err(CommandError::Invalid(format!("setup '{name}' is not placed relative to another setup")));
+        }
+        Ok(SetSetupRelative { setup: name.to_string(), prev_link, next_link: None, align: None })
+    }
+
+    fn write(&self, world: &World, link: Option<String>) {
+        if let Some(entity) = model::find_by_name(world, &self.setup) {
+            let view = entity.entity_view(world);
+            if let Some(mut def) = view.try_get::<&SetupDef>(|d| d.clone()) {
+                def.relative_to = link;
+                view.set(def);
+            }
+        }
+    }
+}
+
+/// The link a live setup holds now.
+fn held_link(world: &World, name: &str) -> Result<Option<String>, CommandError> {
+    let entity = model::find_by_name(world, name).ok_or_else(|| CommandError::NotFound(name.to_string()))?;
+    entity
+        .entity_view(world)
+        .try_get::<&SetupDef>(|d| d.relative_to.clone())
+        .ok_or_else(|| CommandError::Invalid(format!("'{name}' is not a setup")))
+}
+
+impl Command for SetSetupRelative {
+    fn apply(&self, world: &World) {
+        self.write(world, self.next_link.clone());
+        if let Some(a) = &self.align {
+            a.apply(world);
+        }
+    }
+
+    fn invert(&self, world: &World) {
+        if let Some(a) = &self.align {
+            a.invert(world);
+        }
+        self.write(world, self.prev_link.clone());
+    }
+}
diff --git a/crates/app/src/commands/setup_stock.rs b/crates/app/src/commands/setup_stock.rs
new file mode 100644
index 00000000..d2676e9b
--- /dev/null
+++ b/crates/app/src/commands/setup_stock.rs
@@ -0,0 +1,80 @@
+//! `SetSetupStockSource` (#320): pick where a setup's stock comes from -
+//! its own stock, or what the setup before it leaves behind.
+//!
+//! Provenance: our own design; "stock from the preceding setup" is a
+//! plain CAM workflow (public documentation, behaviour only). No vendor
+//! implementation inspected.
+//!
+//! ## The laws this command keeps
+//!
+//! - **Validated and snapshotted at construction.** A live setup, not the
+//!   first (nothing before it), a carry the sim can verify when taking
+//!   what the setup before leaves (refused by name otherwise), and a
+//!   change from what the setup uses now. `apply`/`invert` are pure
+//!   writes; undo restores the stored pick, "never picked" included.
+//! - **Nothing else moves.** The stock entity, the part alignment and the
+//!   work offset are untouched; the setup's operations read Stale
+//!   (the pick rides their stamp).
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::World;
+
+use crate::commands::{Command, CommandError};
+use crate::model;
+use crate::schema::SetupDef;
+use crate::setup_stock::{self, StockSource};
+
+/// Pick a setup's stock source.
+pub struct SetSetupStockSource {
+    setup: String,
+    prev: Option<StockSource>,
+    next: StockSource,
+}
+
+impl SetSetupStockSource {
+    /// Make `name` start from `source`.
+    pub fn new(world: &World, name: &str, source: StockSource) -> Result<Self, CommandError> {
+        let entity = model::find_by_name(world, name).ok_or_else(|| CommandError::NotFound(name.to_string()))?;
+        let prev = entity
+            .entity_view(world)
+            .try_get::<&SetupDef>(|d| d.stock_source)
+            .ok_or_else(|| CommandError::Invalid(format!("'{name}' is not a setup")))?;
+        let Some(now) = setup_stock::effective(world, name) else {
+            return Err(CommandError::Invalid(format!(
+                "'{name}' is the first setup - it always starts from its own stock"
+            )));
+        };
+        if source == StockSource::FromPrevious
+            && let Some(why) = setup_stock::carry_refusal(world, name)
+        {
+            return Err(CommandError::Invalid(why));
+        }
+        if now == source {
+            return Err(CommandError::Invalid(format!(
+                "setup '{name}' already uses that stock ({})",
+                setup_stock::describe(world, name).unwrap_or_default()
+            )));
+        }
+        Ok(SetSetupStockSource { setup: name.to_string(), prev, next: source })
+    }
+
+    fn write(&self, world: &World, source: Option<StockSource>) {
+        if let Some(entity) = model::find_by_name(world, &self.setup) {
+            let view = entity.entity_view(world);
+            if let Some(mut def) = view.try_get::<&SetupDef>(|d| d.clone()) {
+                def.stock_source = source;
+                view.set(def);
+            }
+        }
+    }
+}
+
+impl Command for SetSetupStockSource {
+    fn apply(&self, world: &World) {
+        self.write(world, Some(self.next));
+    }
+
+    fn invert(&self, world: &World) {
+        self.write(world, self.prev);
+    }
+}
diff --git a/crates/app/src/commands/setup_wcs.rs b/crates/app/src/commands/setup_wcs.rs
new file mode 100644
index 00000000..f6677e67
--- /dev/null
+++ b/crates/app/src/commands/setup_wcs.rs
@@ -0,0 +1,74 @@
+//! `SetSetupWorkOffset` (#196, #342): label a setup's one WCS with the
+//! `G54`..`G59` word the post writes for it, or clear the label back to
+//! the `G54` default. Only the word changes - the setup's WCS origin, and
+//! every height measured from it, stay where they are.
+//!
+//! Provenance: our own design; RS-274 / ISO 6983 work-offset selection
+//! (one of six controller zero registers per clamping) is general
+//! machine-shop practice - no vendor implementation inspected. Like its
+//! setup siblings, construction validates and snapshots both values;
+//! `apply`/`invert` are pure writes of the snapshot.
+
+use flecs_ecs::core::EntityViewGet; // try_get is not re-exported in prelude (0.2.2)
+use flecs_ecs::prelude::World;
+
+use crate::commands::{Command, CommandError};
+use crate::model;
+use crate::schema::{SetupDef, WCS_SLOTS};
+
+/// Write a setup's work-offset word. `None` clears the label.
+pub struct SetSetupWorkOffset {
+    setup: String,
+    prev: Option<usize>,
+    next: Option<usize>,
+}
+
+impl SetSetupWorkOffset {
+    pub fn new(world: &World, setup: &str, slot: Option<usize>) -> Result<Self, CommandError> {
+        let entity = model::find_by_name(world, setup)
+            .ok_or_else(|| CommandError::NotFound(setup.to_string()))?;
+        let prev = entity
+            .entity_view(world)
+            .try_get::<&SetupDef>(|d| d.work_offset)
+            .ok_or_else(|| CommandError::Invalid(format!("'{setup}' is not a setup")))?;
+        if let Some(i) = slot
+            && i >= WCS_SLOTS.len()
+        {
+            return Err(CommandError::Invalid(format!(
+                "work offset #{i} does not exist - the slots are G54 to G59"
+            )));
+        }
+        if prev == slot {
+            return Err(CommandError::Invalid(format!(
+                "setup '{setup}' already posts at {}",
+                slot.and_then(|i| WCS_SLOTS.get(i)).copied().unwrap_or("G54")
+            )));
+        }
+        Ok(SetSetupWorkOffset {
+            setup: setup.to_string(),
+            prev,
+            next: slot,
+        })
+    }
+
+    fn write(&self, world: &World, slot: Option<usize>) {
+        let Some(entity) = model::find_by_name(world, &self.setup) else {
+            return;
+        };
+        let view = entity.entity_view(world);
+        if let Some(mut def) = view.try_get::<&SetupDef>(|d| d.clone()) {
+            def.work_offset = slot;
+            view.set(def);
+        }
+    }
+}
+
+impl Command for SetSetupWorkOffset {
+    fn apply(&self, world: &World) {
+        self.write(world, self.next);
+    }
+
+    fn invert(&self, world: &World) {
+        self.write(world, self.prev);
+    }
+}
