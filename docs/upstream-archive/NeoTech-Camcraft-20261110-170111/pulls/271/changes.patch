diff --git a/crates/sim/tests/arc_sweep.rs b/crates/sim/tests/arc_sweep.rs
new file mode 100644
index 00000000..9bc473af
--- /dev/null
+++ b/crates/sim/tests/arc_sweep.rs
@@ -0,0 +1,259 @@
+//! #402: the column engine sweeps XY arcs EXACTLY. Inscribed chords
+//! stood a sagitta nearer the arc's centre than the real G2/G3: on a
+//! convex corner (centre = the part's corner) that clipped a column the
+//! tool never touched and the height verdict read it as a full-wall
+//! gouge; on a concave corner (the part outside the arc) the same chord
+//! stayed short of the wall and hid a real gouge. The laws pinned here:
+//! a column is cut iff the true arc's tool reaches it, to the depth a
+//! dense scan of the true arc finds, for every atom, level or helical,
+//! either direction; the issue's own column stands; and real gouges on
+//! convex and concave arcs are still convicted.
+//! Provenance: plane geometry and RS-274 helical interpolation; our own
+//! code, per the Clean-Room Protocol.
+//!
+//! Gate map (M4.4): covers camcraft_sim::stock_sim.
+
+use camcraft_sim::cl::{ArcMove, Move, MoveKind};
+use camcraft_sim::geo2d::Point2;
+use camcraft_sim::geometry::{cube, Point3, Triangle};
+use camcraft_sim::stock_sim::{deviate, Dexel, DEV_TOL};
+use std::f64::consts::PI;
+
+#[derive(Clone, Copy, Debug)]
+enum Kind {
+    Flat,
+    Ball,
+    Cone(f64),
+    Bull(f64),
+}
+
+/// Lowest steel above the tip at horizontal distance `d <= r`.
+fn lift(k: Kind, d: f64, r: f64) -> f64 {
+    match k {
+        Kind::Flat => 0.0,
+        Kind::Ball => r - (r * r - d * d).max(0.0).sqrt(),
+        Kind::Cone(cot) => cot * d,
+        Kind::Bull(c) => {
+            let e = (d - (r - c)).max(0.0);
+            c - (c * c - e * e).max(0.0).sqrt()
+        }
+    }
+}
+
+/// An XY arc about `(ox, oy)` of radius `rad`, from bearing `a0` swept
+/// `sweep` radians (positive = CCW), Z from `z0` to `z1`.
+fn arc(ox: f64, oy: f64, rad: f64, a0: f64, sweep: f64, z0: f64, z1: f64) -> Move {
+    let a1 = a0 + sweep;
+    Move {
+        rotary: None,
+        kind: MoveKind::Feed,
+        from: Point3::new(ox + rad * a0.cos(), oy + rad * a0.sin(), z0),
+        to: Point3::new(ox + rad * a1.cos(), oy + rad * a1.sin(), z1),
+        feed: Some(500.0),
+        arc: Some(ArcMove::xy(Point2::new(ox, oy), sweep > 0.0)),
+        axis: None,
+    }
+}
+
+fn subtract(d: &mut Dexel, m: &Move, r: f64, k: Kind) {
+    // A coarse chord budget on purpose: XY arcs no longer read it.
+    let tol = 0.5;
+    match k {
+        Kind::Flat => d.subtract(m, r, tol),
+        Kind::Ball => d.subtract_ball(m, r, tol),
+        Kind::Cone(cot) => d.subtract_cone(m, r, cot, tol),
+        Kind::Bull(c) => d.subtract_bull(m, r, c, tol),
+    }
+}
+
+/// XY distance from `(qx, qy)` to the arc's path (independent of the
+/// kernel: bearing inside the sweep -> radial gap, else nearest end).
+fn dist_to_arc(qx: f64, qy: f64, ox: f64, oy: f64, rad: f64, a0: f64, sweep: f64) -> f64 {
+    let (wx, wy) = (qx - ox, qy - oy);
+    let b = wy.atan2(wx);
+    let off = if sweep > 0.0 { b - a0 } else { a0 - b }.rem_euclid(2.0 * PI);
+    let ends = [a0, a0 + sweep].map(|a| (qx - ox - rad * a.cos()).hypot(qy - oy - rad * a.sin()));
+    let e = ends[0].min(ends[1]);
+    if off <= sweep.abs() { (wx.hypot(wy) - rad).abs().min(e) } else { e }
+}
+
+#[test]
+fn a_level_disc_arc_cuts_exactly_the_columns_within_reach() {
+    // CCW and CW, short and long sweeps, one straddling the +-pi seam:
+    // a column drops iff its centre is within r of the TRUE arc, with
+    // no sagitta band on either side.
+    let cases = [(0.3, 1.2), (2.9, 0.8), (-2.0, -1.5), (1.0, 5.5), (-0.4, -4.0)];
+    for (a0, sweep) in cases {
+        for (rad, r) in [(6.0, 1.5), (3.0, 3.0), (1.2, 2.0)] {
+            let mut d = Dexel::block(-10.0, -10.0, 10.0, 10.0, 5.0, 0.13).unwrap();
+            d.subtract(&arc(0.07, -0.11, rad, a0, sweep, 1.0, 1.0), r, 0.5);
+            for iy in 0..d.ny {
+                for ix in 0..d.nx {
+                    let q = d.center(ix, iy);
+                    let dist = dist_to_arc(q.x, q.y, 0.07, -0.11, rad, a0, sweep);
+                    if (dist - r).abs() < 1e-9 {
+                        continue;
+                    }
+                    let got = d.top_at(ix + iy * d.nx);
+                    let want = if dist < r { 1.0 } else { 5.0 };
+                    assert_eq!(got, want, "a0 {a0} sweep {sweep} R {rad} r {r} at {q:?}: dist {dist}");
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn every_atom_matches_a_dense_scan_of_the_true_arc() {
+    // Level and helical arcs, CW and CCW, an arc wider than the tool
+    // and one narrower (the ball's C > B bend): every column's cut is
+    // the minimum over the true arc a brute-force scan finds - never
+    // above it (no rest invented), never measurably below (no gouge).
+    let atoms = [Kind::Flat, Kind::Ball, Kind::Cone(1.0 / 0.6), Kind::Bull(1.0)];
+    let arcs = [
+        (5.0, 0.4, 2.3, 2.0, 2.0),
+        (5.0, 0.4, 2.3, 4.0, 1.0),
+        (4.0, 2.5, -3.6, 0.5, 3.5),
+        (1.5, -1.0, 5.0, 3.0, 0.0),
+    ];
+    let r = 2.5;
+    for k in atoms {
+        for (rad, a0, sweep, z0, z1) in arcs {
+            let mut d = Dexel::block(-9.0, -9.0, 9.0, 9.0, 50.0, 0.29).unwrap();
+            subtract(&mut d, &arc(0.0, 0.0, rad, a0, sweep, z0, z1), r, k);
+            let (mut n, mut tight) = (0, 0);
+            for iy in 0..d.ny {
+                for ix in 0..d.nx {
+                    let q = d.center(ix, iy);
+                    let g = |t: f64| {
+                        let a = a0 + sweep * t;
+                        let dd = (q.x - rad * a.cos()).hypot(q.y - rad * a.sin());
+                        if dd <= r { z0 + (z1 - z0) * t + lift(k, dd, r) } else { f64::INFINITY }
+                    };
+                    let (mut want, mut ts) = (f64::INFINITY, 0.0);
+                    for s in 0..=6000 {
+                        let t = s as f64 / 6000.0;
+                        if g(t) < want {
+                            (want, ts) = (g(t), t);
+                        }
+                    }
+                    for s in 0..=4000 {
+                        let t = (ts - 1.0 / 6000.0 + s as f64 / 2.0e6).clamp(0.0, 1.0);
+                        want = want.min(g(t));
+                    }
+                    let got = d.top_at(ix + iy * d.nx);
+                    if want.is_finite() {
+                        assert!(
+                            got <= want + 1e-9 && got >= want - 1e-2,
+                            "{k:?} arc {rad}/{a0}/{sweep} z {z0}->{z1} at {q:?}: {got} vs scan {want}"
+                        );
+                        n += 1;
+                        // The fine scan steps 5e-7 in t: a helix's
+                        // window end is resolved to ~1e-5 in Z.
+                        if (got - want).abs() < 1e-5 {
+                            tight += 1;
+                        }
+                    } else if got != 50.0 {
+                        // Only a window-edge graze the scan stepped over.
+                        let dist = dist_to_arc(q.x, q.y, 0.0, 0.0, rad, a0, sweep);
+                        assert!(dist <= r + 1e-9, "{k:?}: phantom cut at {q:?} ({dist} from the arc): {got}");
+                    }
+                }
+            }
+            assert!(n > 200, "{k:?}: {n} columns compared");
+            assert!(tight * 10 >= n * 9, "{k:?} arc {rad}/{sweep}: {tight} of {n} within 1e-5 of the scan");
+        }
+    }
+}
+
+/// The issue's lattice and part: stock 90x70 from (-45,-35), cell
+/// 0.375, top 28; the riser x < 10, y > -30, 25 high. The contour's
+/// corner arc about the riser's corner (10,-30), R = r = 3, at `z`.
+fn riser() -> Vec<Triangle> {
+    cube(Point3::new(-45.0, -30.0, 0.0), Point3::new(10.0, 35.0, 25.0)).facets.to_vec()
+}
+
+fn corner_arc(rad: f64, z: f64) -> Move {
+    // The issue's move 4 starts at (10.346, -32.980) on the R = 3 circle.
+    let a0 = (-2.980f64).atan2(0.346);
+    arc(10.0, -30.0, rad, a0, -a0, z, z)
+}
+
+#[test]
+fn the_issue_402_convex_corner_column_stands() {
+    let mut d = Dexel::block(-45.0, -35.0, 45.0, 35.0, 28.0, 0.375).unwrap();
+    for z in [25.0, 20.0, 15.0] {
+        d.subtract(&corner_arc(3.0, z), 3.0, d.cell * 0.25);
+    }
+    // Column (146, 13), centre (9.9375, -29.9375): 0.088 mm inside the
+    // corner, 3.06 mm from the nearest true tool centre.
+    let q = d.center(146, 13);
+    assert!((q.x - 9.9375).abs() < 1e-12 && (q.y + 29.9375).abs() < 1e-12);
+    assert_eq!(d.top_at(146 + 13 * d.nx), 28.0, "the real arc never reaches this column");
+    let dev = deviate(&d, &riser(), DEV_TOL).unwrap();
+    assert_eq!(dev.gouge_cells, 0, "a clean corner arc reads a gouge: {:?}", dev.max_gouge_at);
+}
+
+#[test]
+fn a_convex_corner_arc_cut_too_tight_is_still_a_gouge() {
+    // The planted twin: the same corner swept at R = 2.5 with r = 3,
+    // the tool 0.5 mm into the riser's corner. Convicted, located at
+    // the corner, the full 10 mm the riser stands above the cut.
+    let mut d = Dexel::block(-45.0, -35.0, 45.0, 35.0, 28.0, 0.375).unwrap();
+    d.subtract(&corner_arc(2.5, 15.0), 3.0, d.cell * 0.25);
+    let dev = deviate(&d, &riser(), DEV_TOL).unwrap();
+    assert!(dev.gouge_cells > 0, "a corner cut into the part must convict");
+    assert!((dev.max_gouge - 10.0).abs() < 1e-9, "{}", dev.max_gouge);
+    let at = dev.max_gouge_at.unwrap();
+    assert!((at.x - 10.0).hypot(at.y + 30.0) < 3.0, "located at the corner: {at:?}");
+}
+
+/// A pocket corner's wall: material outside the radius `rw` about the
+/// origin in the first quadrant, as the count of columns the cut put
+/// below `wall_z` there (columns hugging `rw` within 1e-9 are skipped).
+fn wall_hits(d: &Dexel, rw: f64, wall_z: f64) -> usize {
+    let mut n = 0;
+    for iy in 0..d.ny {
+        for ix in 0..d.nx {
+            let q = d.center(ix, iy);
+            let rho = q.x.hypot(q.y);
+            if q.x > 0.0 && q.y > 0.0 && rho > rw + 1e-9 && d.top_at(ix + iy * d.nx) < wall_z {
+                n += 1;
+            }
+        }
+    }
+    n
+}
+
+#[test]
+fn a_concave_corner_arc_is_exact_on_the_wall_side() {
+    // A 6 mm fillet wall, a 4 mm-radius cutter: the clean path is the
+    // R = 2 quarter arc, which touches the wall and never crosses it.
+    // Over-cut by 0.06 mm - under the 0.094 mm sagitta budget the
+    // chords had at this cell, and on the side the inscribed chords
+    // fell short of - the columns in that band are convicted, every
+    // one the true arc reaches and no other.
+    let (rw, r, cell) = (6.0, 4.0, 0.375);
+    let clean = {
+        let mut d = Dexel::block(-8.0, -8.0, 10.0, 10.0, 20.0, cell).unwrap();
+        d.subtract(&arc(0.0, 0.0, rw - r, 0.0, PI / 2.0, 5.0, 5.0), r, cell * 0.25);
+        d
+    };
+    assert_eq!(wall_hits(&clean, rw, 20.0), 0, "the clean fillet path crosses the wall");
+    let over = 0.06;
+    let mut d = Dexel::block(-8.0, -8.0, 10.0, 10.0, 20.0, cell).unwrap();
+    d.subtract(&arc(0.0, 0.0, rw - r + over, 0.0, PI / 2.0, 5.0, 5.0), r, cell * 0.25);
+    let mut want = 0;
+    for iy in 0..d.ny {
+        for ix in 0..d.nx {
+            let q = d.center(ix, iy);
+            let rho = q.x.hypot(q.y);
+            let dist = dist_to_arc(q.x, q.y, 0.0, 0.0, rw - r + over, 0.0, PI / 2.0);
+            if q.x > 0.0 && q.y > 0.0 && rho > rw + 1e-9 && dist <= r {
+                want += 1;
+            }
+        }
+    }
+    assert!(want > 0, "the lattice must put a column in the over-cut band");
+    assert_eq!(wall_hits(&d, rw, 20.0), want, "every wall column the true arc reaches, and no other");
+}
diff --git a/crates/sim/tests/c_axis_fixture.rs b/crates/sim/tests/c_axis_fixture.rs
new file mode 100644
index 00000000..5e368297
--- /dev/null
+++ b/crates/sim/tests/c_axis_fixture.rs
@@ -0,0 +1,220 @@
+//! The fixture laws (c2)/(d2) on a spindle-C turning move (issue
+//! #486): the part turns under a fixed radial live tool, so the
+//! machine's tool stands on the +X station of the spindle line at
+//! every instant while the part-frame path swings round it. Steel
+//! declared FIXED (a tailstock, a steady, a fixed clamp) stays in the
+//! machine frame and meets the station tool wherever it stands; steel
+//! RIDING the part (a chuck jaw) meets the radial tool at every pose
+//! the turn passes through, not only the pose the move states at its
+//! end (`cl::stamp_c` cuts one move into many pieces).
+//!
+//! Every hit asserted here is first shown by hand: the stack placed
+//! where the machine places it at mid-turn, inside the box. Clear
+//! cases are the same moves with the steel moved off that place.
+//!
+//! Gate map (M4.4): covers camcraft_sim::verify::workholding,
+//! camcraft_sim::verify::c_steel, camcraft_sim::cl (stamp_c).
+//! Lane shape (M4.4): all tests here run in well under a second.
+//! Provenance: our own fixtures; the law is the Prime Directive's, the
+//! C convention `cl::rotary`'s.
+
+use camcraft_sim::cl::{stamp_c, Move, MoveKind, Toolpath};
+use camcraft_sim::fixture::FixtureBox;
+use camcraft_sim::geometry::Point3;
+use camcraft_sim::verify::{
+    bands_vs_workholding, rapids_vs_workholding, FixturePart, RotaryAxis, ToolGeom, Warning, Workholding,
+};
+
+fn tool() -> ToolGeom {
+    ToolGeom {
+        radius: 3.0,
+        nose_radius: 0.0,
+        flute_len: 15.0,
+        shank_radius: 3.0,
+        shank_len: 20.0,
+        holder_radius: 10.0,
+        holder_len: 30.0,
+    }
+}
+
+/// The spindle line: world Z through the origin.
+fn spindle() -> RotaryAxis {
+    RotaryAxis { origin: Point3::new(0.0, 0.0, 0.0), dir: [0.0, 0.0, 1.0] }
+}
+
+/// The tip at azimuth `deg` on radius `rho`, height `z`, and its
+/// radial pose.
+fn at(rho: f64, deg: f64, z: f64) -> (Point3, [f64; 3]) {
+    let (s, c) = deg.to_radians().sin_cos();
+    (Point3::new(rho * c, rho * s, z), [c, s, 0.0])
+}
+
+/// One live-tool turn from radius 10 at azimuth 0 to radius 10 at
+/// azimuth 90 (C 0 to -90), z from `z0` to `z1`, stamped to 0.01 mm.
+/// The verified path is the part-frame chord - its midpoint at (5, 5),
+/// radius 7.07, C -45 - and the stamp splits it until the machine's
+/// C-linear motion follows that chord.
+fn quarter_turn(kind: MoveKind, z0: f64, z1: f64) -> Toolpath {
+    let (a, _) = at(10.0, 0.0, z0);
+    let (b, pb) = at(10.0, 90.0, z1);
+    let raw = Toolpath::new(vec![Move::new(kind, a, b, Some(400.0)).with_axis(pb)]);
+    stamp_c(&raw, [0.0, 0.0], 0.01).unwrap_or_else(|e| panic!("the turn stamps: {e}"))
+}
+
+/// Is `p` inside the box?
+fn inside(p: Point3, b: &FixtureBox) -> bool {
+    (b.min.x..=b.max.x).contains(&p.x) && (b.min.y..=b.max.y).contains(&p.y) && (b.min.z..=b.max.z).contains(&p.z)
+}
+
+/// Fixed steel on the station side of the line at z -6..-4, x 24..28:
+/// where the machine's shank (x 22..42 along +X) passes when the tip,
+/// descending from z 0 to -10, is near z -5 - mid-turn, C near -45.
+/// Short of the holder (x 42 on, radius 10), and below the stack at
+/// the turn's start (tip z 0, shank down to z -3).
+fn station_block() -> FixtureBox {
+    FixtureBox { min: Point3::new(24.0, -3.0, -6.0), max: Point3::new(28.0, 3.0, -4.0) }
+}
+
+/// The stamped pieces of the turn, judged against `fixed` steel.
+fn fixed_hits(path: &Toolpath, block: FixtureBox, rapids: bool, axis: Option<RotaryAxis>) -> Vec<Warning> {
+    let b = [block];
+    let wh = Workholding { turning: &[], fixed: &b, axis };
+    if rapids {
+        rapids_vs_workholding(path, &tool(), &wh, None)
+    } else {
+        bands_vs_workholding(path, &tool(), &wh, None, 0.01)
+    }
+}
+
+#[test]
+fn the_machine_meets_fixed_steel_at_the_station_mid_turn() {
+    // By hand: at mid-turn the tip (radius 7.07) stands at (7.07, 0, -5)
+    // on the machine and the shank's axis runs x 22.07..42.07 along +X
+    // at y 0 - its point 20 mm up the tool is inside the block.
+    let shank_mid = Point3::new(50f64.sqrt() + 20.0, 0.0, -5.0);
+    assert!(inside(shank_mid, &station_block()));
+    let path = quarter_turn(MoveKind::Feed, 0.0, -10.0);
+    assert!(path.moves.len() > 4, "the turn is cut into pieces: {}", path.moves.len());
+    for axis in [Some(spindle()), None] {
+        let w = fixed_hits(&path, station_block(), false, axis);
+        assert!(!w.is_empty(), "fixed steel at the station must convict the turn (axis {axis:?})");
+        // The piece the machine strikes the block on - the one passing
+        // z -5, mid-turn - is convicted. (Pieces near the turn's start
+        // may report a graze too: the stack there stands 0.06 mm over
+        // the block's top, inside the enclosures' growth.)
+        let mid = path.moves.iter().position(|m| m.from.z >= -5.0 && m.to.z <= -5.0);
+        assert!(
+            mid.is_some_and(|k| w.iter().any(|x| matches!(x, Warning::FixtureHit { at, .. } if *at == k))),
+            "the mid-turn piece {mid:?} must convict (axis {axis:?}): {w:?}"
+        );
+    }
+}
+
+#[test]
+fn a_rapid_turn_past_fixed_steel_convicts_as_a_rapid() {
+    let path = quarter_turn(MoveKind::Rapid, 0.0, -10.0);
+    let w = fixed_hits(&path, station_block(), true, Some(spindle()));
+    let mid = path.moves.iter().position(|m| m.from.z >= -5.0 && m.to.z <= -5.0);
+    assert!(
+        mid.is_some_and(|k| w.iter().any(|x| matches!(x, Warning::FixtureHit { at, fixture_part: FixturePart::Rapid } if *at == k))),
+        "the mid-turn rapid piece {mid:?} must convict as a rapid: {w:?}"
+    );
+}
+
+#[test]
+fn fixed_steel_off_the_station_stays_clear() {
+    // The same block on the far side of the line (-X), and the block
+    // at the station but below the turn's deepest stack (z -30..-20):
+    // the machine never meets either.
+    let path = quarter_turn(MoveKind::Feed, 0.0, -10.0);
+    let far = FixtureBox { min: Point3::new(-28.0, -3.0, -6.0), max: Point3::new(-24.0, 3.0, -4.0) };
+    let low = FixtureBox { min: Point3::new(24.0, -3.0, -30.0), max: Point3::new(28.0, 3.0, -20.0) };
+    for b in [far, low] {
+        let w = fixed_hits(&path, b, false, Some(spindle()));
+        assert!(w.is_empty(), "{b:?} is nowhere the machine's tool goes: {w:?}");
+        let r = fixed_hits(&quarter_turn(MoveKind::Rapid, 0.0, -10.0), b, true, Some(spindle()));
+        assert!(r.is_empty(), "{b:?}: {r:?}");
+    }
+}
+
+/// A chuck jaw riding the part on the 45 deg diagonal, radius 60, at
+/// the turn's height: where the radial holder (radius 42..72 from the
+/// line) stands at mid-turn, and nowhere the stack stands at the pose
+/// the move states at its end (+Y).
+fn diagonal_jaw() -> FixtureBox {
+    let c = 60.0 * std::f64::consts::FRAC_1_SQRT_2;
+    FixtureBox { min: Point3::new(c - 1.5, c - 1.5, -1.5), max: Point3::new(c + 1.5, c + 1.5, 1.5) }
+}
+
+#[test]
+fn steel_riding_the_part_meets_the_pose_the_turn_passes_through() {
+    // By hand: at mid-turn (C -45) the tip is at (5, 5), radius 7.07,
+    // and the holder runs radius 42.07..72.07 along the diagonal - the
+    // jaw's centre (radius 60) is on its axis.
+    let (tip, pose) = at(50f64.sqrt(), 45.0, 0.0);
+    let on_holder = Point3::new(tip.x + (60.0 - tip.x.hypot(tip.y)) * pose[0], tip.y + (60.0 - tip.x.hypot(tip.y)) * pose[1], 0.0);
+    assert!(inside(on_holder, &diagonal_jaw()));
+    let path = quarter_turn(MoveKind::Feed, 0.0, 0.0);
+    let j = [diagonal_jaw()];
+    for axis in [Some(spindle()), None] {
+        let wh = Workholding { turning: &j, fixed: &[], axis };
+        let w = bands_vs_workholding(&path, &tool(), &wh, None, 0.01);
+        assert!(!w.is_empty(), "the jaw on the diagonal must convict the turn (axis {axis:?})");
+    }
+}
+
+#[test]
+fn steel_riding_the_part_off_the_turns_reach_stays_clear() {
+    // The jaw moved out to radius 120 on the diagonal: past the whole
+    // stack (tip r10 + 65), at every pose of the turn.
+    let c = 120.0 * std::f64::consts::FRAC_1_SQRT_2;
+    let far = [FixtureBox { min: Point3::new(c - 1.5, c - 1.5, -1.5), max: Point3::new(c + 1.5, c + 1.5, 1.5) }];
+    let path = quarter_turn(MoveKind::Feed, 0.0, 0.0);
+    let wh = Workholding { turning: &far, fixed: &[], axis: Some(spindle()) };
+    let w = bands_vs_workholding(&path, &tool(), &wh, None, 0.01);
+    assert!(w.is_empty(), "{w:?}");
+}
+
+#[test]
+fn every_stamped_piece_states_the_station_pose_at_its_own_c() {
+    let path = quarter_turn(MoveKind::Feed, 0.0, -10.0);
+    for (i, m) in path.moves.iter().enumerate() {
+        let (Some(c), Some(a)) = (m.rotary, m.axis) else { panic!("piece {i} states C and a pose") };
+        // Rz(C) of the pose is the station's +X.
+        let (s, co) = c.to_radians().sin_cos();
+        let (x, y) = (a[0] * co - a[1] * s, a[0] * s + a[1] * co);
+        assert!((x - 1.0).abs() < 1e-9 && y.abs() < 1e-9 && a[2].abs() < 1e-12, "piece {i} at C {c}: {a:?}");
+    }
+}
+
+#[test]
+fn a_path_stamped_before_486_is_read_at_the_pose_its_c_states() {
+    // Before #486 every piece stated the whole move's axis (+Y here):
+    // the laws read the C, not that axis, so a cached path convicts too.
+    let mut path = quarter_turn(MoveKind::Feed, 0.0, 0.0);
+    let end = path.moves.last().and_then(|m| m.axis);
+    for m in &mut path.moves {
+        m.axis = end;
+    }
+    let j = [diagonal_jaw()];
+    let wh = Workholding { turning: &j, fixed: &[], axis: Some(spindle()) };
+    assert!(!bands_vs_workholding(&path, &tool(), &wh, None, 0.01).is_empty());
+}
+
+#[test]
+fn fixed_steel_under_a_c_no_line_places_fails_closed() {
+    // Every C word off by 30 deg from its tip: no line stands every tip
+    // on its ray, so the machine frame is unknown - each C move against
+    // fixed steel reports, even steel far from anything.
+    let mut path = quarter_turn(MoveKind::Feed, 0.0, 0.0);
+    for (k, m) in path.moves.iter_mut().enumerate() {
+        m.rotary = m.rotary.map(|c| c + if k % 2 == 0 { 30.0 } else { -30.0 });
+    }
+    let far = FixtureBox { min: Point3::new(500.0, 500.0, 500.0), max: Point3::new(510.0, 510.0, 510.0) };
+    let w = fixed_hits(&path, far, false, Some(spindle()));
+    assert_eq!(w.len(), path.moves.len(), "{w:?}");
+    // The same steel riding the part needs no line: clear.
+    let f = [far];
+    let wh = Workholding { turning: &f, fixed: &[], axis: Some(spindle()) };
+    assert!(bands_vs_workholding(&path, &tool(), &wh, None, 0.01).is_empty());
+}
diff --git a/crates/sim/tests/edge_break_credit.rs b/crates/sim/tests/edge_break_credit.rs
new file mode 100644
index 00000000..7d0f806b
--- /dev/null
+++ b/crates/sim/tests/edge_break_credit.rs
@@ -0,0 +1,126 @@
+//! #303: the operation owns its break. A chamfer cone ridden along a
+//! finished part's top edge is judged against the bevel the op declared
+//! (`cl::EdgeBreak`), not the model's sharp edge: down to the bevel is
+//! clean, past it is still a gouge charged at its depth under the
+//! bevel, and an edge nothing declared keeps the model's verdict.
+//!
+//! Gate map (#303): covers camcraft_sim::stock_sim (edge_break,
+//! deviate) and camcraft_sim::cl (EdgeBreak).
+
+use camcraft_sim::cl::{EdgeBreak, Move, MoveKind};
+use camcraft_sim::geometry::{cube, Point3, Triangle};
+use camcraft_sim::stock_sim::{self, credit_breaks, deviate, Dexel, SimOp, DEV_TOL};
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn feed(from: Point3, to: Point3) -> Move {
+    Move { rotary: None, kind: MoveKind::Feed, from, to, feed: Some(500.0), arc: None, axis: None }
+}
+
+/// The finished part: a 20 x 20 x 10 block, its top edge the loop.
+fn part() -> Vec<Triangle> {
+    cube(p(0.0, 0.0, 0.0), p(20.0, 20.0, 10.0)).facets.to_vec()
+}
+
+const LOOP: [(f64, f64); 5] = [(0.0, 0.0), (20.0, 0.0), (20.0, 20.0), (0.0, 20.0), (0.0, 0.0)];
+
+/// A 90-degree cone (slope 1) riding the top loop with its tip at `z`.
+fn ride(tip_z: f64) -> Vec<Move> {
+    LOOP.windows(2).map(|w| feed(p(w[0].0, w[0].1, tip_z), p(w[1].0, w[1].1, tip_z))).collect()
+}
+
+/// The break a 1 mm, 45-degree chamfer of that loop declares.
+fn declared(edge: &[(f64, f64)]) -> EdgeBreak {
+    EdgeBreak { edge: edge.iter().map(|&(x, y)| p(x, y, 10.0)).collect(), depth: 1.0, slope: 1.0 }
+}
+
+fn cut(tip_z: f64) -> Dexel {
+    let facets = part();
+    let mut d = Dexel::from_facets(&facets, 0.25).expect("the finished part as stock");
+    let moves = ride(tip_z);
+    let op = SimOp { moves: &moves, radius: 3.0, ball: false, cone: Some(1.0), corner: None };
+    stock_sim::simulate(&mut d, &[op]).expect("the ride cuts");
+    d
+}
+
+#[test]
+fn the_declared_chamfer_is_the_finished_part_not_a_gouge() {
+    let d = cut(9.0);
+    let facets = part();
+    let mut dev = deviate(&d, &facets, DEV_TOL).expect("verdict");
+    assert!(dev.gouge_cells > 0, "the sharp model convicts the bevel - the bug's own reading");
+    let credited = credit_breaks(&mut dev, &d, &facets, &[declared(&LOOP)]);
+    assert!(credited > 0);
+    assert_eq!(dev.gouge_cells, 0, "worst {} at {:?}", dev.max_gouge, dev.max_gouge_at);
+    assert!(dev.is_clean());
+}
+
+#[test]
+fn a_ride_deeper_than_its_declared_break_is_still_a_gouge_at_its_excess() {
+    // The same declaration, the ride 0.3 mm lower: every bevel column
+    // stands 0.3 under the bevel, and that is what the verdict charges.
+    let d = cut(8.7);
+    let facets = part();
+    let mut dev = deviate(&d, &facets, DEV_TOL).expect("verdict");
+    let before = dev.max_gouge;
+    credit_breaks(&mut dev, &d, &facets, &[declared(&LOOP)]);
+    assert!(dev.gouge_cells > 0, "an over-deep chamfer passed");
+    assert!((dev.max_gouge - 0.3).abs() < 1e-6, "charged {} (was {before})", dev.max_gouge);
+    assert!(dev.max_gouge_at.is_some(), "the worst gouge still locates itself");
+}
+
+#[test]
+fn an_edge_no_operation_declared_keeps_the_models_verdict() {
+    // Only the y = 0 edge is declared: the other three sides' bevels
+    // are cuts nobody asked for, convicted at their full depth.
+    let d = cut(9.0);
+    let facets = part();
+    let mut dev = deviate(&d, &facets, DEV_TOL).expect("verdict");
+    let before = dev.gouge_cells;
+    credit_breaks(&mut dev, &d, &facets, &[declared(&LOOP[..2])]);
+    assert!(dev.gouge_cells > 0 && dev.gouge_cells < before, "{} of {before}", dev.gouge_cells);
+    assert!(dev.max_gouge > 0.85, "the undeclared bevel is charged whole (centres 1/8 mm in): {}", dev.max_gouge);
+    let at = dev.max_gouge_at.expect("located");
+    assert!(at.y > 0.9, "the worst gouge is on an undeclared side: {at:?}");
+}
+
+#[test]
+fn a_model_top_above_the_edge_is_never_the_bevels() {
+    // A boss standing 5 mm over the declared edge's level, inside the
+    // bevel's width: cutting it is a gouge whatever the break says.
+    let mut facets = part();
+    facets.extend(cube(p(0.3, 5.0, 10.0), p(0.8, 6.0, 15.0)).facets.iter().copied());
+    let mut d = Dexel::from_facets(&facets, 0.25).expect("stock");
+    let moves = ride(9.0);
+    let op = SimOp { moves: &moves, radius: 3.0, ball: false, cone: Some(1.0), corner: None };
+    stock_sim::simulate(&mut d, &[op]).expect("the ride cuts");
+    let mut dev = deviate(&d, &facets, DEV_TOL).expect("verdict");
+    credit_breaks(&mut dev, &d, &facets, &[declared(&LOOP)]);
+    assert!(dev.gouge_cells > 0, "the boss was credited to the bevel");
+    assert!(dev.max_gouge > 5.0, "the boss is charged from its own top: {}", dev.max_gouge);
+}
+
+#[test]
+fn a_sloped_edge_bevel_is_the_cone_swept_along_it() {
+    // An edge climbing 1 in 2 under a 90-degree cone: directly over the
+    // edge the bevel stands exactly `depth` under it; beside it, the
+    // swept cone's lowest point - checked against a brute-force sweep.
+    let b = EdgeBreak { edge: vec![p(0.0, 0.0, 0.0), p(10.0, 0.0, 5.0)], depth: 1.0, slope: 1.0 };
+    let (f, z) = b.floor_at(5.0, 0.0).expect("on the edge");
+    assert!((f - 1.5).abs() < 1e-12 && (z - 2.5).abs() < 1e-12, "{f} {z}");
+    for (x, y) in [(5.0, 0.6), (2.0, 0.9), (9.5, 0.3), (0.0, 0.5)] {
+        let (f, _) = b.floor_at(x, y).expect("inside the width");
+        let brute = (0..=100_000)
+            .map(|i| {
+                let u = 10.0 * f64::from(i) / 100_000.0;
+                0.5 * u - 1.0 + ((x - u).powi(2) + y * y).sqrt()
+            })
+            .fold(f64::INFINITY, f64::min);
+        assert!((f - brute).abs() < 1e-6, "({x},{y}): {f} vs {brute}");
+    }
+    assert!(b.floor_at(5.0, 1.5).is_none(), "past the width nothing is declared");
+    let bad = EdgeBreak { depth: f64::NAN, ..b };
+    assert!(!bad.is_sane() && bad.floor_at(5.0, 0.0).is_none(), "an insane record declares nothing");
+}
diff --git a/crates/sim/tests/field_arc_sweep.rs b/crates/sim/tests/field_arc_sweep.rs
new file mode 100644
index 00000000..8ecb8d4c
--- /dev/null
+++ b/crates/sim/tests/field_arc_sweep.rs
@@ -0,0 +1,246 @@
+//! #413: the field engine sweeps XY arcs on the TRUE circle, as the
+//! column engine has since #402. Inscribed chords stood a sagitta
+//! nearer the arc's centre than the real G2/G3: on a convex corner the
+//! displayed stock lost material the tool never touched, and on a
+//! concave corner or a bull-nose helix it kept material the tool cut
+//! (a rim column the true arc cuts 2.5 mm deep stood uncut). The laws
+//! pinned here: both engines read the same top over every column the
+//! arc reaches, for every tool, level or helical, either direction;
+//! the bull helix's rim columns are cut on the field too; a clean
+//! convex corner reads no gouge while a planted one still convicts;
+//! and a concave fillet's wall loses exactly the columns the true arc
+//! reaches.
+//! Provenance: plane geometry and RS-274 helical interpolation; our own
+//! code, per the Clean-Room Protocol.
+//!
+//! Gate map (M4.4): covers camcraft_sim::stock_sim::field_arc and the
+//! arc arms of camcraft_sim::stock_sim::{field_cut, field_sweep,
+//! field_ray}.
+
+use camcraft_sim::cl::{ArcMove, Move, MoveKind};
+use camcraft_sim::geo2d::Point2;
+use camcraft_sim::geometry::{cube, Point3, Triangle};
+use camcraft_sim::stock_sim::{Backend, SimOp, Stock, DEV_TOL, FIELD_BAND};
+use std::f64::consts::PI;
+
+const FIELD: Backend = Backend::Field { band: FIELD_BAND };
+
+/// An XY arc about `(ox, oy)` of radius `rad`, from bearing `a0` swept
+/// `sweep` radians (positive = CCW), Z from `z0` to `z1`.
+fn arc(ox: f64, oy: f64, rad: f64, a0: f64, sweep: f64, z0: f64, z1: f64) -> Move {
+    let a1 = a0 + sweep;
+    Move {
+        rotary: None,
+        kind: MoveKind::Feed,
+        from: Point3::new(ox + rad * a0.cos(), oy + rad * a0.sin(), z0),
+        to: Point3::new(ox + rad * a1.cos(), oy + rad * a1.sin(), z1),
+        feed: Some(500.0),
+        arc: Some(ArcMove::xy(Point2::new(ox, oy), sweep > 0.0)),
+        axis: None,
+    }
+}
+
+/// XY distance from `(qx, qy)` to the arc's path (bearing inside the
+/// sweep -> radial gap, else the nearest end).
+fn dist_to_arc(qx: f64, qy: f64, ox: f64, oy: f64, rad: f64, a0: f64, sweep: f64) -> f64 {
+    let (wx, wy) = (qx - ox, qy - oy);
+    let off = if sweep > 0.0 { wy.atan2(wx) - a0 } else { a0 - wy.atan2(wx) }.rem_euclid(2.0 * PI);
+    let ends = [a0, a0 + sweep].map(|a| (qx - ox - rad * a.cos()).hypot(qy - oy - rad * a.sin()));
+    let e = ends[0].min(ends[1]);
+    if off <= sweep.abs() { (wx.hypot(wy) - rad).abs().min(e) } else { e }
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Tool {
+    Flat,
+    Ball,
+    Cone(f64),
+    Bull(f64),
+}
+
+fn op(moves: &[Move], r: f64, t: Tool) -> SimOp<'_> {
+    let (ball, cone, corner) = match t {
+        Tool::Flat => (false, None, None),
+        Tool::Ball => (true, None, None),
+        Tool::Cone(cot) => (false, Some(cot), None),
+        Tool::Bull(c) => (false, None, Some(c)),
+    };
+    SimOp { moves, radius: r, ball, cone, corner }
+}
+
+/// The column centres of a block from `(x0, y0)`, `n` by `n` cells.
+fn centres(x0: f64, y0: f64, cell: f64, n: usize) -> impl Iterator<Item = (f64, f64)> {
+    (0..n * n).map(move |k| (x0 + ((k % n) as f64 + 0.5) * cell, y0 + ((k / n) as f64 + 0.5) * cell))
+}
+
+#[test]
+fn the_field_cuts_every_tool_on_the_true_arc_like_the_column() {
+    // Level and helical, CW and CCW, a sweep past half a turn and one
+    // whose radius is under the tool's: away from the reach rim (where
+    // the engines' tie laws, not the arc, decide), the two engines read
+    // the same top to the straight moves' 1e-5. The rim band is a half
+    // cell wide, and a skim under a cell deep is skipped too: a sliver
+    // of cut thinner than that is under the field's own sampling (a
+    // straight move's reads the same way).
+    let (cell, n, top) = (0.4, 30usize, 5.0);
+    let base = |b| Stock::block(b, -6.0, -6.0, 6.0, 6.0, top, cell).expect("test block");
+    let (col0, fld0) = (base(Backend::Column), base(FIELD));
+    // The cone is steep enough to stand over the stock top from every
+    // tip (the field's cone has no shank above its widest radius).
+    let tools = [Tool::Flat, Tool::Ball, Tool::Cone(2.5), Tool::Bull(1.0)];
+    let arcs = [(3.5, 0.4, 2.3, 2.0, 2.0), (3.5, 0.4, 2.3, 2.5, 1.0), (3.0, 2.5, -3.6, 0.5, 2.5), (1.5, -1.0, 5.0, 2.0, 0.5)];
+    let r = 2.0;
+    for t in tools {
+        for (rad, a0, sweep, z0, z1) in arcs {
+            let m = [arc(0.0, 0.0, rad, a0, sweep, z0, z1)];
+            let (mut c, mut f) = (col0.clone(), fld0.clone());
+            c.simulate(&[op(&m, r, t)]).expect("column program");
+            f.simulate(&[op(&m, r, t)]).expect("field program");
+            let mut cut = 0;
+            for (qx, qy) in centres(-6.0, -6.0, cell, n) {
+                let d = dist_to_arc(qx, qy, 0.0, 0.0, rad, a0, sweep);
+                if (d - r).abs() < 0.5 * cell {
+                    continue; // the reach rim: sampling, not arc law
+                }
+                // An uncut column reads each engine's own block top (the
+                // field's sits on its lattice).
+                let (zc, zf) = (c.top(qx, qy), f.top(qx, qy));
+                let zc = if zc >= top { fld0.top(qx, qy) } else { zc };
+                if zc < top && zc > top - cell {
+                    continue; // a skim thinner than a cell: field sampling
+                }
+                assert!(
+                    (zc - zf).abs() <= 1e-5,
+                    "{t:?} arc {rad}/{a0}/{sweep} z {z0}->{z1} at ({qx}, {qy}), {d} from the arc: column {zc} vs field {zf}"
+                );
+                if zf < fld0.top(qx, qy) {
+                    cut += 1;
+                }
+            }
+            assert!(cut > 50, "{t:?} arc {rad}/{sweep}: only {cut} columns cut");
+        }
+    }
+}
+
+#[test]
+fn the_bull_helix_rim_is_cut_on_the_field_too() {
+    // `stock_bull_nose`'s helix: centre (6,6), R 3, (9,6,3) -> (3,6,2)
+    // CCW, bull r 2 corner 0.75. The chorded field stood at the stock
+    // top over rim columns the true arc cuts ~2.5 mm deep; now every
+    // column the true arc reaches is cut, as deep as the column says.
+    let (cell, top) = (0.5, 5.0);
+    let m = [arc(6.0, 6.0, 3.0, 0.0, PI, 3.0, 2.0)];
+    let mut c = Stock::block(Backend::Column, 0.0, 0.0, 12.0, 12.0, top, cell).expect("block");
+    let uncut = Stock::block(FIELD, 0.0, 0.0, 12.0, 12.0, top, cell).expect("block");
+    let mut f = uncut.clone();
+    c.simulate(&[op(&m, 2.0, Tool::Bull(0.75))]).expect("column program");
+    f.simulate(&[op(&m, 2.0, Tool::Bull(0.75))]).expect("field program");
+    let (mut rim, mut deep) = (0, 0.0f64);
+    for (qx, qy) in centres(0.0, 0.0, cell, 24) {
+        let d = dist_to_arc(qx, qy, 6.0, 6.0, 3.0, 0.0, PI);
+        let (zc, zf) = (c.top(qx, qy), f.top(qx, qy));
+        let zc = if zc >= top { uncut.top(qx, qy) } else { zc };
+        assert!((zc - zf).abs() <= 1e-5, "({qx}, {qy}), {d} from the arc: column {zc} vs field {zf}");
+        // The outer band of the reach, where the chords fell short.
+        if d < 2.0 && d > 1.75 && zc < top {
+            rim += 1;
+            deep = deep.max(top - zf);
+        }
+    }
+    assert!(rim > 0, "the rim band must hold a cut column");
+    assert!(deep > 2.0, "the rim is cut deep on the field: {deep}");
+}
+
+/// The riser's corner: x < CX, y > CY, 25 high. Placed (as #402's
+/// was, by accident) so a lattice column stands just inside it, 0.06 mm
+/// from the corner, opposite the middle chord of the corner arc below:
+/// the inscribed chords' sagitta (0.087 mm) reached it, the true arc,
+/// standing exactly `r` from the corner, never does.
+const CX: f64 = 9.9375 + 0.045;
+const CY: f64 = -29.8125 - 0.040;
+const PROBE: (f64, f64) = (9.9375, -29.8125);
+
+fn riser() -> Vec<Triangle> {
+    cube(Point3::new(-20.0, CY, 0.0), Point3::new(CX, -10.0, 25.0)).facets.to_vec()
+}
+
+/// The #402 contour's corner arc about the riser's corner, R `rad`.
+fn corner_arc(rad: f64, z: f64) -> Move {
+    let a0 = (-2.980f64).atan2(0.346);
+    arc(CX, CY, rad, a0, -a0, z, z)
+}
+
+/// The #402 cell size (0.375) over the corner.
+fn corner_stock() -> Stock {
+    Stock::block(FIELD, -4.5, -35.0, 16.5, -23.0, 28.0, 0.375).expect("corner block")
+}
+
+#[test]
+fn a_clean_convex_corner_arc_reads_no_gouge_on_the_field() {
+    let uncut = corner_stock();
+    let mut f = uncut.clone();
+    let moves: Vec<Move> = [25.0, 20.0, 15.0].map(|z| corner_arc(3.0, z)).to_vec();
+    f.simulate(&[op(&moves, 3.0, Tool::Flat)]).expect("field program");
+    let (px, py) = PROBE;
+    assert!((px - CX).hypot(py - CY) < 0.087 && px < CX && py > CY, "the probe sits inside the corner");
+    assert_eq!(f.top(px, py), uncut.top(px, py), "the real arc never reaches this column");
+    let dev = f.deviate(&riser(), DEV_TOL).expect("field deviate");
+    assert_eq!(dev.gouge_cells, 0, "a clean corner arc reads a gouge: {:?}", dev.max_gouge_at);
+}
+
+#[test]
+fn a_convex_corner_arc_cut_too_tight_is_still_a_gouge_on_the_field() {
+    let mut f = corner_stock();
+    let m = [corner_arc(2.5, 15.0)];
+    f.simulate(&[op(&m, 3.0, Tool::Flat)]).expect("field program");
+    let dev = f.deviate(&riser(), DEV_TOL).expect("field deviate");
+    assert!(dev.gouge_cells > 0, "a corner cut into the part must convict");
+    assert!((dev.max_gouge - 10.0).abs() < 1e-3, "{}", dev.max_gouge);
+    let at = dev.max_gouge_at.expect("located");
+    assert!((at.x - CX).hypot(at.y - CY) < 3.0, "located at the corner: {at:?}");
+}
+
+#[test]
+fn a_concave_fillet_wall_loses_exactly_the_columns_the_true_arc_reaches() {
+    // A 6 mm fillet wall, a 4 mm flat cutter: the clean R 2 quarter arc
+    // touches the wall and never crosses it; over-cut by 0.06 mm (under
+    // the 0.094 mm sagitta the chords had, on the side they fell
+    // short of) the field cuts every wall column the true arc reaches
+    // and no other.
+    let (rw, r, cell) = (6.0, 4.0, 0.375);
+    let base = Stock::block(FIELD, -7.5, -7.5, 9.75, 9.75, 20.0, cell).expect("fillet block");
+    let n = 46usize;
+    let wall_hits = |s: &Stock, path_r: f64| {
+        let (mut got, mut want) = (0, 0);
+        for (qx, qy) in centres(-7.5, -7.5, cell, n) {
+            let rho = qx.hypot(qy);
+            if !(qx > 0.0 && qy > 0.0 && rho > rw + 1e-9) {
+                continue;
+            }
+            let d = dist_to_arc(qx, qy, 0.0, 0.0, path_r, 0.0, PI / 2.0);
+            if (d - r).abs() < 1e-6 {
+                continue; // on the reach rim itself
+            }
+            if s.top(qx, qy) < 20.0 {
+                got += 1;
+            }
+            if d < r {
+                want += 1;
+            }
+        }
+        (got, want)
+    };
+    let mut clean = base.clone();
+    let m = [arc(0.0, 0.0, rw - r, 0.0, PI / 2.0, 5.0, 5.0)];
+    clean.simulate(&[op(&m, r, Tool::Flat)]).expect("clean program");
+    assert_eq!(wall_hits(&clean, rw - r), (0, 0), "the clean fillet path crosses the wall");
+    let over = 0.06;
+    let mut cut = base.clone();
+    let m = [arc(0.0, 0.0, rw - r + over, 0.0, PI / 2.0, 5.0, 5.0)];
+    cut.simulate(&[op(&m, r, Tool::Flat)]).expect("over-cut program");
+    let (got, want) = wall_hits(&cut, rw - r + over);
+    assert!(want > 0, "the lattice must put a column in the over-cut band");
+    assert_eq!(got, want, "every wall column the true arc reaches, and no other");
+}
+
+
diff --git a/crates/sim/tests/field_block_cost.rs b/crates/sim/tests/field_block_cost.rs
new file mode 100644
index 00000000..b2053884
--- /dev/null
+++ b/crates/sim/tests/field_block_cost.rs
@@ -0,0 +1,81 @@
+//! #633: a block stock on the field engine builds in closed form. The
+//! band fill along a floorless block's ten-span walls made a 120 mm
+//! block take ~58 s in release (its cuts took milliseconds); the box's
+//! exact distance now answers the mesh layer, so the build stores no
+//! band at all - and reads the same stock as the mesh-seeded field.
+//!
+//! Gate map (#633): covers sim::stock_sim::field_box (AnalyticBox,
+//! SdfField::from_box), field::mag_at, backend_build::block_field.
+//! Provenance: our own fixtures; the closed-form box distance.
+
+use std::time::Instant;
+
+use camcraft_sim::cl::{Move, MoveKind};
+use camcraft_sim::geometry::{cube, Point3};
+use camcraft_sim::stock_sim::{auto_cell, Backend, SdfField, SimOp, Stock, FIELD_BAND};
+
+fn field_block(x0: f64, y0: f64, x1: f64, y1: f64, top: f64, cell: f64) -> Stock {
+    match Stock::block(Backend::Field { band: FIELD_BAND }, x0, y0, x1, y1, top, cell) {
+        Ok(s) => s,
+        Err(e) => panic!("block: {e:?}"),
+    }
+}
+
+#[test]
+fn a_block_stores_no_band_at_build() {
+    // The case that took ~58 s: 120 mm square at a 0.375 mm cell.
+    let s = field_block(-60.0, -60.0, 60.0, 60.0, 0.0, 0.375);
+    let f = s.field().expect("a field stock");
+    assert_eq!(f.brick_count(), 0, "no band is filled at build - the box answers in closed form");
+}
+
+#[test]
+fn the_closed_form_reads_the_stock_the_band_fill_read() {
+    // A small block both ways: band-filled from its shell, and closed-form.
+    let (lo, hi, cell) = (Point3::new(0.0, 0.0, -6.0), Point3::new(10.0, 8.0, 0.0), 0.5);
+    let meshed = match SdfField::from_mesh(&cube(lo, hi).facets, cell, FIELD_BAND) {
+        Ok(f) => f,
+        Err(e) => panic!("mesh field: {e:?}"),
+    };
+    let boxed = match SdfField::from_box(lo, hi, cell, FIELD_BAND) {
+        Ok(f) => f,
+        Err(e) => panic!("box field: {e:?}"),
+    };
+    let mut worst = 0.0f64;
+    for i in -6..=26 {
+        for j in -6..=22 {
+            for k in -18..=6 {
+                let p = Point3::new(f64::from(i) * 0.5 + 0.25, f64::from(j) * 0.5 + 0.25, f64::from(k) * 0.5 + 0.25);
+                let (a, b) = (meshed.mesh_distance(p), boxed.mesh_distance(p));
+                // Same side of the surface everywhere (the verdicts' sign).
+                assert!(a.signum() == b.signum() || a == 0.0 || b == 0.0, "{p:?}: mesh {a} vs box {b}");
+                worst = worst.max((a - b).abs());
+            }
+        }
+    }
+    // The band fill is a graph-distance bound within a few cells of the
+    // truth; the closed form IS the truth, so they agree to that bound.
+    assert!(worst <= 2.0 * cell, "worst |mesh - box| = {worst}");
+}
+
+#[test]
+#[ignore = "heavy lane (#633 cost): a 120 mm field block, drill program, release ~ms - run with --release -- --ignored"]
+fn a_large_field_block_runs_a_drill_program_quickly() {
+    let p = |x: f64, y: f64, z: f64| Point3::new(x, y, z);
+    let mut moves = Vec::new();
+    for (x, y) in [(-30.0, -30.0), (30.0, -30.0), (30.0, 30.0), (-30.0, 30.0)] {
+        moves.push(Move::new(MoveKind::Rapid, p(x, y, 5.0), p(x, y, 1.0), None));
+        moves.push(Move::new(MoveKind::Feed, p(x, y, 1.0), p(x, y, -5.0), Some(200.0)));
+        moves.push(Move::new(MoveKind::Rapid, p(x, y, -5.0), p(x, y, 5.0), None));
+    }
+    let cell = auto_cell(3.0, 120.0, 120.0);
+    let t0 = Instant::now();
+    let mut s = field_block(-60.0, -60.0, 60.0, 60.0, 0.0, cell);
+    if let Err(e) = s.simulate(&[SimOp { moves: &moves, radius: 3.0, ball: false, cone: None, corner: None }]) {
+        panic!("simulate: {e:?}");
+    }
+    let dt = t0.elapsed();
+    // Budget: the build plus four plunges, on a 320 x 320 lattice. Was
+    // ~58 s; a regression to a band fill blows through this at once.
+    assert!(dt.as_secs_f64() < 2.0, "field block + drill took {dt:?}");
+}
diff --git a/crates/sim/tests/fixture_arc_sagitta.rs b/crates/sim/tests/fixture_arc_sagitta.rs
new file mode 100644
index 00000000..16282ad3
--- /dev/null
+++ b/crates/sim/tests/fixture_arc_sagitta.rs
@@ -0,0 +1,213 @@
+//! The fixture laws read an arc's true reach, not its inscribed chords
+//! (#491). The box laws sweep an arc along its chords at the chord
+//! tolerance; the circle bulges past each chord by up to its sagitta, so
+//! a band at its bare radius missed steel standing in that sliver. Each
+//! arc chord's band is now padded by what the arc adds to it. Steel
+//! beyond the true reach by more than the pad stays clean, straight
+//! moves keep their verdicts, and the strict-dip silence still holds on
+//! a vertical arc landing tangent on a mounting face.
+//!
+//! Gate map (M4.4): covers sim::verify::arc_bulge, sim::verify::stack_span,
+//! sim::verify::posed_steel, sim::verify::laws.
+//! Provenance: our own fixtures; the law is the Prime Directive's.
+
+use std::f64::consts::FRAC_PI_2;
+
+use camcraft_sim::cl::{ArcMove, ArcPlane, Move, MoveKind, Toolpath};
+use camcraft_sim::fixture::FixtureBox;
+use camcraft_sim::geo2d::Point2;
+use camcraft_sim::geometry::Point3;
+use camcraft_sim::verify::{bands_vs_fixtures, rapids_vs_fixtures, FixturePart, ToolGeom, Warning};
+
+/// Flute 0..20 r3, shank 20..50 r5, holder 50..90 r20 above the tip.
+fn tool() -> ToolGeom {
+    ToolGeom {
+        radius: 3.0,
+        nose_radius: 0.0,
+        flute_len: 20.0,
+        shank_radius: 5.0,
+        shank_len: 30.0,
+        holder_radius: 20.0,
+        holder_len: 40.0,
+    }
+}
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn bx(min: Point3, max: Point3) -> FixtureBox {
+    FixtureBox { min, max }
+}
+
+fn hit(part: FixturePart) -> Vec<Warning> {
+    vec![Warning::FixtureHit { at: 0, fixture_part: part }]
+}
+
+const R: f64 = 30.0;
+/// Sweep 0.15 rad at R30 and chord tolerance 0.01: three chords of
+/// 0.05 rad each, the middle one centred on the arc's apex.
+const SWEEP: f64 = 0.15;
+const TOL: f64 = 0.01;
+
+/// The sagitta of one 0.05 rad chord at R30: 0.00937 mm.
+fn sagitta() -> f64 {
+    R * (1.0 - (0.5 * SWEEP / 3.0).cos())
+}
+
+/// A ccw XY arc of R30 about the origin, level at `z`, symmetric about
+/// its apex at +Y (the tool's true reach there is y = 33).
+fn xy_arc(kind: MoveKind, z: f64) -> Move {
+    let (a0, a1) = (FRAC_PI_2 - 0.5 * SWEEP, FRAC_PI_2 + 0.5 * SWEEP);
+    let mut m = Move::new(kind, p(R * a0.cos(), R * a0.sin(), z), p(R * a1.cos(), R * a1.sin(), z), Some(500.0));
+    m.arc = Some(ArcMove { center: Point2::new(0.0, 0.0), ccw: true, plane: ArcPlane::Xy });
+    m
+}
+
+/// The three chords the laws sweep, middle one at the apex: what the
+/// fixtures below are placed against.
+#[test]
+fn the_apex_sits_mid_chord() {
+    let segs = xy_arc(MoveKind::Feed, 0.0).segments3(TOL);
+    assert_eq!(segs.len(), 3);
+    let (a, b) = segs[1];
+    assert!((a.y - b.y).abs() < 1e-12 && (a.x + b.x).abs() < 1e-12);
+    assert!((R - a.y - sagitta()).abs() < 1e-12, "chord stands a sagitta in");
+    assert!(sagitta() > 0.008 && sagitta() < 0.010);
+}
+
+/// The issue's measured repro: a box face half a sagitta inside the
+/// tool's true reach at the apex. The chords at the bare radius reach
+/// only 33 - sagitta, so the box went unseen; the tool really goes
+/// 0.0047 mm into it.
+#[test]
+fn an_arc_reaching_steel_within_its_sagitta_reports() {
+    let face = R + 3.0 - 0.5 * sagitta();
+    let jaw = bx(p(-1.0, face, -5.0), p(1.0, face + 10.0, 5.0));
+    let path = Toolpath::new(vec![xy_arc(MoveKind::Feed, 0.0)]);
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[jaw], None, TOL), hit(FixturePart::Flute));
+    // A rapid on the same arc: law (d2)'s flute column carries the pad.
+    let path = Toolpath::new(vec![xy_arc(MoveKind::Rapid, 0.0)]);
+    assert_eq!(rapids_vs_fixtures(&path, &tool(), &[jaw]), hit(FixturePart::Rapid));
+}
+
+/// Steel past the true reach by more than the pad (the lattice's 1 um
+/// plus the chord's along-offset) stays clean.
+#[test]
+fn steel_beyond_the_true_reach_stays_clean() {
+    let face = R + 3.0 + 0.002;
+    let jaw = bx(p(-1.0, face, -5.0), p(1.0, face + 10.0, 5.0));
+    let path = Toolpath::new(vec![xy_arc(MoveKind::Feed, 0.0)]);
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[jaw], None, TOL), Vec::new());
+    let path = Toolpath::new(vec![xy_arc(MoveKind::Rapid, 0.0)]);
+    assert_eq!(rapids_vs_fixtures(&path, &tool(), &[jaw]), Vec::new());
+}
+
+/// The upper bands ride the same pad: a holder (r20) passing a post
+/// within the sagitta of its true reach.
+#[test]
+fn the_holder_band_is_padded_too() {
+    let face = R + 20.0 - 0.5 * sagitta();
+    let post = bx(p(-1.0, face, 60.0), p(1.0, face + 10.0, 80.0));
+    let path = Toolpath::new(vec![xy_arc(MoveKind::Feed, 0.0)]);
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[post], None, TOL), hit(FixturePart::Holder));
+    let clear = bx(p(-1.0, R + 20.002, 60.0), p(1.0, R + 30.0, 80.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[clear], None, TOL), Vec::new());
+}
+
+/// An XZ arc bulging toward +X past a jaw: the chord deviation there is
+/// horizontal, and pads the band's radius.
+#[test]
+fn an_xz_arc_bulging_sideways_reports() {
+    // In XZ, (u, v) = (z, x): the apex x = 30 is at angle pi/2. Centre
+    // (X0, Z10), ccw from pi/2 - 0.075 to pi/2 + 0.075 (z falls).
+    let (a0, a1) = (FRAC_PI_2 - 0.5 * SWEEP, FRAC_PI_2 + 0.5 * SWEEP);
+    let at = |a: f64| p(R * a.sin(), 0.0, 10.0 + R * a.cos());
+    let mut m = Move::new(MoveKind::Feed, at(a0), at(a1), Some(500.0));
+    m.arc = Some(ArcMove { center: Point2::new(0.0, 10.0), ccw: true, plane: ArcPlane::Xz });
+    assert_eq!(m.segments3(TOL).len(), 3);
+    let path = Toolpath::new(vec![m]);
+    let face = R + 3.0 - 0.5 * sagitta();
+    let jaw = bx(p(face, -1.0, 9.0), p(face + 10.0, 1.0, 11.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[jaw], None, TOL), hit(FixturePart::Flute));
+    let clear = bx(p(R + 3.002, -1.0, 9.0), p(R + 13.0, 1.0, 11.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[clear], None, TOL), Vec::new());
+}
+
+/// The same in YZ, (u, v) = (y, z): the apex y = 30 at angle 0.
+#[test]
+fn a_yz_arc_bulging_sideways_reports() {
+    let at = |a: f64| p(0.0, R * a.cos(), 10.0 + R * a.sin());
+    let mut m = Move::new(MoveKind::Feed, at(-0.5 * SWEEP), at(0.5 * SWEEP), Some(500.0));
+    m.arc = Some(ArcMove { center: Point2::new(0.0, 10.0), ccw: true, plane: ArcPlane::Yz });
+    assert_eq!(m.segments3(TOL).len(), 3);
+    let path = Toolpath::new(vec![m]);
+    let face = R + 3.0 - 0.5 * sagitta();
+    let jaw = bx(p(-1.0, face, 9.0), p(1.0, face + 10.0, 11.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[jaw], None, TOL), hit(FixturePart::Flute));
+    let clear = bx(p(-1.0, R + 3.002, 9.0), p(1.0, R + 13.0, 11.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[clear], None, TOL), Vec::new());
+}
+
+/// An XZ lead arc landing tangent on a mounting face keeps the
+/// strict-dip silence: its z window is the joints', so the flush
+/// landing is contact, not a crash. A thousandth deeper reports.
+#[test]
+fn an_xz_arc_landing_tangent_on_a_face_stays_silent() {
+    // Quarter circle r5 about (X0, Z5): from (-5, 0, 5) cw down to the
+    // circle's bottom (0, 0, 0).
+    let mut m = Move::new(MoveKind::Feed, p(-5.0, 0.0, 5.0), p(0.0, 0.0, 0.0), Some(500.0));
+    m.arc = Some(ArcMove { center: Point2::new(0.0, 5.0), ccw: false, plane: ArcPlane::Xz });
+    let path = Toolpath::new(vec![m]);
+    let face = bx(p(-10.0, -10.0, -10.0), p(10.0, 10.0, 0.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[face], None, TOL), Vec::new());
+    let dip = bx(p(-10.0, -10.0, -10.0), p(10.0, 10.0, 0.001));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[dip], None, TOL), hit(FixturePart::Flute));
+}
+
+/// An XZ arc built straight through its circle's bottom (the builder
+/// splits these; a hand-built move does not): its bottom chord stands a
+/// sagitta above the true low point, and steel in between is struck.
+#[test]
+fn an_unsplit_xz_arc_dipping_past_its_chords_reports() {
+    // Half circle r5 about (X0, Z5), cw from (-5, 5) through the bottom
+    // to (5, 5): 25 chords, the middle one centred on the bottom.
+    let mut m = Move::new(MoveKind::Feed, p(-5.0, 0.0, 5.0), p(5.0, 0.0, 5.0), Some(500.0));
+    m.arc = Some(ArcMove { center: Point2::new(0.0, 5.0), ccw: false, plane: ArcPlane::Xz });
+    let segs = m.segments3(TOL);
+    let low = segs.iter().map(|(a, b)| a.z.min(b.z)).fold(f64::INFINITY, f64::min);
+    assert!(low > 0.008, "the bottom chord stands {low} above the true low point");
+    let path = Toolpath::new(vec![m]);
+    let face = bx(p(-10.0, -10.0, -10.0), p(10.0, 10.0, 0.5 * low));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[face], None, TOL), hit(FixturePart::Flute));
+}
+
+/// A posed arc (constant lean) reads the same pad on its capsules. The
+/// posed walk's interval travel (up to a quarter millimetre) already
+/// covered most of this sliver; the bulge makes the enclosure hold
+/// for intervals shorter than the sagitta too. Pinned, not a repro.
+#[test]
+fn a_posed_arc_reaching_steel_within_its_sagitta_reports() {
+    let lean = [0.0, -0.2, 1.0];
+    let m = xy_arc(MoveKind::Feed, 0.0).with_axis(lean);
+    let path = Toolpath::new(vec![m]);
+    // The flute tip's true reach at the apex, along +Y: 33. A box
+    // standing just below the tip, half a sagitta in.
+    let face = R + 3.0 - 0.5 * sagitta();
+    let jaw = bx(p(-1.0, face, -5.0), p(1.0, face + 10.0, 0.5));
+    assert!(!bands_vs_fixtures(&path, &tool(), &[jaw], None, TOL).is_empty());
+}
+
+/// Straight moves keep their verdicts sum for sum: a level feed's
+/// flute grazing a face exactly at its radius still counts (touching in
+/// XY is contact), one a micron clear does not.
+#[test]
+fn straight_moves_keep_their_verdicts() {
+    let path = Toolpath::new(vec![Move::new(MoveKind::Feed, p(-10.0, 30.0, 0.0), p(10.0, 30.0, 0.0), Some(500.0))]);
+    let touch = bx(p(-1.0, 33.0, -5.0), p(1.0, 40.0, 5.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[touch], None, TOL), hit(FixturePart::Flute));
+    let clear = bx(p(-1.0, 33.000_001, -5.0), p(1.0, 40.0, 5.0));
+    assert_eq!(bands_vs_fixtures(&path, &tool(), &[clear], None, TOL), Vec::new());
+    let rapid = Toolpath::new(vec![Move::new(MoveKind::Rapid, p(-10.0, 30.0, 0.0), p(10.0, 30.0, 0.0), None)]);
+    assert_eq!(rapids_vs_fixtures(&rapid, &tool(), &[clear]), Vec::new());
+}
diff --git a/crates/sim/tests/fixture_mesh.rs b/crates/sim/tests/fixture_mesh.rs
new file mode 100644
index 00000000..2dc7efad
--- /dev/null
+++ b/crates/sim/tests/fixture_mesh.rs
@@ -0,0 +1,330 @@
+//! The fixture laws against a fixture's real mesh (#339): a vise is two
+//! jaws with a gap, and its world box is one block. A path down the gap
+//! was a false crash under the box; under the mesh it is clean, while a
+//! flute clipping a jaw corner, a rapid dipping into a jaw, and a tool
+//! standing wholly inside steel still convict. Open and non-finite
+//! meshes keep the box verdict.
+//! Provenance: our own geometry; the law is the Prime Directive's.
+
+use std::sync::Arc;
+use std::time::Instant;
+
+use camcraft_sim::cl::{Move, MoveKind, Toolpath};
+use camcraft_sim::fixture::FixtureBox;
+use camcraft_sim::fixture_mesh::{FixtureMesh, MeshError, MeshedFixture};
+use camcraft_sim::geo2d::Point2;
+use camcraft_sim::geometry::{Point3, Triangle};
+use camcraft_sim::verify::{
+    bands_vs_workholding, mesh_refined, rapids_vs_workholding, steel_stack, FixturePart, MeshSteel, ToolGeom,
+    Warning, Workholding,
+};
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// Flute r4 x 30, shank r5 x 20, holder r20 x 40: in the vise's gap
+/// (|y| < 15) with the tip at z 25, the flute and shank stand between
+/// the jaws and the holder (75 mm up) clears their tops at z 50.
+fn tool() -> ToolGeom {
+    ToolGeom {
+        radius: 4.0,
+        nose_radius: 0.0,
+        flute_len: 30.0,
+        shank_radius: 5.0,
+        shank_len: 20.0,
+        holder_radius: 20.0,
+        holder_len: 40.0,
+    }
+}
+
+/// A closed, outward box: 12 facets sharing 8 exact corners.
+fn cube(lo: Point3, hi: Point3) -> Vec<Triangle> {
+    let c = |i: usize| {
+        p(if i & 1 == 0 { lo.x } else { hi.x }, if i & 2 == 0 { lo.y } else { hi.y }, if i & 4 == 0 { lo.z } else { hi.z })
+    };
+    let quads = [[0, 2, 3, 1], [4, 5, 7, 6], [0, 1, 5, 4], [2, 6, 7, 3], [0, 4, 6, 2], [1, 3, 7, 5]];
+    quads
+        .iter()
+        .flat_map(|q| [Triangle::new(c(q[0]), c(q[1]), c(q[2])), Triangle::new(c(q[0]), c(q[2]), c(q[3]))])
+        .collect()
+}
+
+/// Base x[-50,50] y[-40,40] z[0,20]; jaws y[-40,-15] and y[15,40],
+/// z[20,50]. Three closed shells (they touch, they do not share
+/// edges): the gap is |y| < 15 above z 20.
+fn vise() -> Vec<Triangle> {
+    let mut t = cube(p(-50.0, -40.0, 0.0), p(50.0, 40.0, 20.0));
+    t.extend(cube(p(-50.0, -40.0, 20.0), p(50.0, -15.0, 50.0)));
+    t.extend(cube(p(-50.0, 15.0, 20.0), p(50.0, 40.0, 50.0)));
+    t
+}
+
+fn aabb(tris: &[Triangle]) -> FixtureBox {
+    let mut lo = p(f64::MAX, f64::MAX, f64::MAX);
+    let mut hi = p(f64::MIN, f64::MIN, f64::MIN);
+    for q in tris.iter().flat_map(|t| [t.a, t.b, t.c]) {
+        lo = p(lo.x.min(q.x), lo.y.min(q.y), lo.z.min(q.z));
+        hi = p(hi.x.max(q.x), hi.y.max(q.y), hi.z.max(q.z));
+    }
+    FixtureBox { min: lo, max: hi }
+}
+
+fn fixture(tris: Vec<Triangle>) -> MeshedFixture {
+    MeshedFixture::new("Vise1", aabb(&tris), Arc::<[Triangle]>::from(tris))
+}
+
+fn feed(a: Point3, b: Point3) -> Move {
+    Move::new(MoveKind::Feed, a, b, Some(800.0))
+}
+
+/// Both laws (c2)/(d2), box-only and mesh-refined, for one fixture.
+fn judge(path: &Toolpath, f: &MeshedFixture) -> (Vec<Warning>, Vec<Warning>) {
+    let boxes = [f.aabb];
+    let wh = Workholding { turning: &boxes, fixed: &[], axis: None };
+    let t = tool();
+    let stack = steel_stack(&t, &camcraft_tools::holder_profile::HolderStack::cylinder(&t), None);
+    let fixtures = std::slice::from_ref(f);
+    let steel = MeshSteel { fixtures, stack: &stack, chord_tol: 0.01 };
+    let mut boxed = bands_vs_workholding(path, &t, &wh, None, 0.01);
+    boxed.extend(rapids_vs_workholding(path, &t, &wh, None));
+    let mut meshed = mesh_refined(path, &wh, &steel, false, |w| bands_vs_workholding(path, &t, w, None, 0.01));
+    meshed.extend(mesh_refined(path, &wh, &steel, true, |w| rapids_vs_workholding(path, &t, w, None)));
+    (boxed, meshed)
+}
+
+fn hit_at(ws: &[Warning], i: usize) -> Option<FixturePart> {
+    ws.iter().find_map(|w| match w {
+        Warning::FixtureHit { at, fixture_part } if *at == i => Some(*fixture_part),
+        _ => None,
+    })
+}
+
+#[test]
+fn a_path_down_the_vise_gap_is_clean_under_the_mesh() {
+    let f = fixture(vise());
+    let path = Toolpath::new(vec![
+        Move::new(MoveKind::Rapid, p(-60.0, 0.0, 60.0), p(-60.0, 0.0, 25.0), None),
+        feed(p(-60.0, 0.0, 25.0), p(60.0, 0.0, 25.0)),
+        // A plunge straight down the gap, and an XY arc inside it.
+        Move::new(MoveKind::Rapid, p(60.0, 0.0, 25.0), p(0.0, 0.0, 70.0), None),
+        Move::new(MoveKind::Rapid, p(0.0, 0.0, 70.0), p(6.0, 0.0, 25.0), None),
+        feed(p(6.0, 0.0, 25.0), p(-6.0, 0.0, 25.0)).with_arc(Point2::new(0.0, 0.0), true),
+    ]);
+    let (boxed, meshed) = judge(&path, &f);
+    assert!(hit_at(&boxed, 1).is_some(), "the world box convicts the gap pass: {boxed:?}");
+    assert!(hit_at(&boxed, 4).is_some(), "and the arc in the gap: {boxed:?}");
+    assert!(meshed.is_empty(), "the jaws' real steel is nowhere near: {meshed:?}");
+    assert_eq!(f.refusal(), None, "the closed vise judged");
+}
+
+#[test]
+fn a_flute_clipping_a_jaw_corner_still_blocks() {
+    let f = fixture(vise());
+    // The diagonal y = x - 40 passes 3.54 mm from jaw B's corner edge
+    // (x 50, y 15) - inside the flute's 4 mm. Shifted to y = x - 42 it
+    // passes 4.95 mm off: clear.
+    let path = Toolpath::new(vec![
+        feed(p(40.0, 0.0, 25.0), p(60.0, 20.0, 25.0)),
+        feed(p(40.0, -2.0, 25.0), p(60.0, 18.0, 25.0)),
+        // A pass 12 mm off centre: the flute reaches y 16, into jaw B.
+        feed(p(-60.0, 12.0, 25.0), p(60.0, 12.0, 25.0)),
+    ]);
+    let (boxed, meshed) = judge(&path, &f);
+    assert_eq!(hit_at(&boxed, 1), Some(FixturePart::Flute), "the box flags the near miss too: {boxed:?}");
+    assert_eq!(hit_at(&meshed, 0), Some(FixturePart::Flute), "the corner clip convicts: {meshed:?}");
+    assert_eq!(hit_at(&meshed, 1), None, "the near miss is acquitted: {meshed:?}");
+    assert_eq!(hit_at(&meshed, 2), Some(FixturePart::Flute), "the jaw-face clip convicts: {meshed:?}");
+}
+
+#[test]
+fn a_shank_or_holder_through_a_jaw_names_the_band() {
+    let f = fixture(vise());
+    // A pass beside the vise, 15 mm off jaw B's outer face (y 40), tip
+    // at z -5: the flute (r4) and the shank (r5, z 25..45) stay clear,
+    // the holder (r20, z 45..85) reaches 5 mm into the jaw's top.
+    let path = Toolpath::new(vec![feed(p(-30.0, 55.0, -5.0), p(30.0, 55.0, -5.0))]);
+    let (boxed, meshed) = judge(&path, &f);
+    assert_eq!(hit_at(&boxed, 0), Some(FixturePart::Holder), "{boxed:?}");
+    assert_eq!(hit_at(&meshed, 0), Some(FixturePart::Holder), "{meshed:?}");
+}
+
+#[test]
+fn a_rapid_dipping_into_a_jaw_top_still_blocks() {
+    let f = fixture(vise());
+    let path = Toolpath::new(vec![
+        Move::new(MoveKind::Rapid, p(0.0, 30.0, 70.0), p(0.0, 30.0, 45.0), None),
+        Move::new(MoveKind::Rapid, p(0.0, 0.0, 70.0), p(0.0, 0.0, 45.0), None),
+    ]);
+    let (boxed, meshed) = judge(&path, &f);
+    assert!(hit_at(&boxed, 1).is_some(), "the box flags the gap retract: {boxed:?}");
+    assert_eq!(hit_at(&meshed, 0), Some(FixturePart::Rapid), "into jaw B: {meshed:?}");
+    assert_eq!(hit_at(&meshed, 1), None, "down the gap: {meshed:?}");
+}
+
+#[test]
+fn a_rapid_kept_by_the_mesh_names_its_band_like_law_d2() {
+    // Two meshed fixtures: the vise acquits the rapid down its gap, a
+    // bar at shank height (z 60..65, 35 mm over the tip) convicts it.
+    // Law (d2) reads the whole upright stack since #424 and names a
+    // band above the flute by its part - the mesh's verdict must name
+    // it the same way, not as the flute's Rapid.
+    let vise = fixture(vise());
+    let bar_tris = cube(p(70.0, -3.0, 60.0), p(90.0, 3.0, 65.0));
+    let bar = MeshedFixture::new("Bar1", aabb(&bar_tris), Arc::<[Triangle]>::from(bar_tris));
+    let boxes = [vise.aabb, bar.aabb];
+    let wh = Workholding { turning: &boxes, fixed: &[], axis: None };
+    let t = tool();
+    let stack = steel_stack(&t, &camcraft_tools::holder_profile::HolderStack::cylinder(&t), None);
+    let fixtures = [vise, bar];
+    let steel = MeshSteel { fixtures: &fixtures, stack: &stack, chord_tol: 0.01 };
+    let path = Toolpath::new(vec![Move::new(MoveKind::Rapid, p(-60.0, 0.0, 25.0), p(100.0, 0.0, 25.0), None)]);
+    let boxed = rapids_vs_workholding(&path, &t, &wh, None);
+    assert_eq!(hit_at(&boxed, 0), Some(FixturePart::Rapid), "the vise box's flute disc: {boxed:?}");
+    let meshed = mesh_refined(&path, &wh, &steel, true, |w| rapids_vs_workholding(&path, &t, w, None));
+    assert_eq!(hit_at(&meshed, 0), Some(FixturePart::Shank), "the bar strikes the shank: {meshed:?}");
+}
+
+#[test]
+fn a_tool_standing_wholly_inside_steel_is_a_hit() {
+    // A tall block: the whole stack (175 mm tall from z 60) sits inside
+    // it, far from every facet - only the inside test can see it.
+    let f = fixture(cube(p(-50.0, -50.0, 0.0), p(50.0, 50.0, 300.0)));
+    let path = Toolpath::new(vec![feed(p(-10.0, 0.0, 60.0), p(10.0, 0.0, 60.0))]);
+    let (_, meshed) = judge(&path, &f);
+    assert!(hit_at(&meshed, 0).is_some(), "buried in steel is a crash: {meshed:?}");
+    let mesh = f.mesh().expect("closed");
+    assert!(!mesh.band_meets(p(-10.0, 0.0, 60.0), p(10.0, 0.0, 60.0), 0.0, 115.0, 20.0, 1e-9), "no facet is near");
+    assert!(mesh.contains(p(0.0, 0.0, 100.0)), "so the inside test decides");
+    let v = fixture(vise());
+    let vm = v.mesh().expect("closed");
+    assert!(vm.contains(p(0.0, 30.0, 30.0)), "in jaw B");
+    assert!(vm.contains(p(0.0, 0.0, 10.0)), "in the base");
+    assert!(!vm.contains(p(0.0, 0.0, 30.0)), "in the gap");
+    assert!(!vm.contains(p(0.0, 0.0, 80.0)), "above it all");
+}
+
+#[test]
+fn an_open_or_broken_mesh_keeps_the_box_verdict_by_name() {
+    let path = Toolpath::new(vec![feed(p(-60.0, 0.0, 25.0), p(60.0, 0.0, 25.0))]);
+    let mut open = vise();
+    open.truncate(open.len() - 2); // one jaw face gone
+    let f = fixture(open);
+    let (boxed, meshed) = judge(&path, &f);
+    assert_eq!(boxed, meshed, "an open mesh judges nothing");
+    assert_eq!(f.refusal(), Some(MeshError::Open));
+
+    let mut nan = vise();
+    nan.push(Triangle::new(p(f64::NAN, 0.0, 0.0), p(1.0, 0.0, 0.0), p(0.0, 1.0, 0.0)));
+    let g = MeshedFixture::new("Vise2", aabb(&vise()), Arc::<[Triangle]>::from(nan));
+    let (boxed, meshed) = judge(&path, &g);
+    assert_eq!(boxed, meshed);
+    assert_eq!(g.refusal(), Some(MeshError::NonFinite));
+    assert_eq!(FixtureMesh::build(&[]).err(), Some(MeshError::Empty));
+    let flat = vec![Triangle::new(p(0.0, 0.0, 0.0), p(0.0, 0.0, 0.0), p(1.0, 0.0, 0.0))];
+    assert_eq!(FixtureMesh::build(&flat).err(), Some(MeshError::Degenerate));
+}
+
+#[test]
+fn unpaired_boxes_keep_the_box_verdict_and_posed_moves_are_read() {
+    let f = fixture(vise());
+    // Slice 3: a posed pass down the gap is the mesh's to read too
+    // (tests/fixture_mesh_posed.rs holds the posed laws).
+    let path = Toolpath::new(vec![feed(p(-60.0, 0.0, 25.0), p(60.0, 0.0, 25.0)).with_axis([0.0, 0.1, 0.995])]);
+    let (boxed, meshed) = judge(&path, &f);
+    assert!(!boxed.is_empty());
+    assert!(meshed.is_empty(), "leaning 6 deg in the gap, the stack clears both jaws: {meshed:?}");
+
+    // A box no fixture owns (the machine table) stays a box.
+    let upright = Toolpath::new(vec![feed(p(-60.0, 0.0, 25.0), p(60.0, 0.0, 25.0))]);
+    let t = tool();
+    let stack = steel_stack(&t, &camcraft_tools::holder_profile::HolderStack::cylinder(&t), None);
+    let table = [FixtureBox { min: p(-100.0, -100.0, -1000.0), max: p(100.0, 100.0, 30.0) }];
+    let wh = Workholding { turning: &[], fixed: &table, axis: None };
+    let steel = MeshSteel { fixtures: std::slice::from_ref(&f), stack: &stack, chord_tol: 0.01 };
+    let law = |w: &Workholding<'_>| bands_vs_workholding(&upright, &t, w, None, 0.01);
+    assert_eq!(mesh_refined(&upright, &wh, &steel, false, law), law(&wh));
+}
+
+/// A closed UV sphere: `lat` x `lon` quads on one shared vertex grid,
+/// fans at the poles - 2 * lon * (lat - 1) facets.
+fn sphere(r: f64, lat: usize, lon: usize) -> Vec<Triangle> {
+    use std::f64::consts::PI;
+    let ring = |i: usize| -> Vec<Point3> {
+        let th = PI * i as f64 / lat as f64;
+        (0..lon)
+            .map(|j| {
+                let ph = 2.0 * PI * j as f64 / lon as f64;
+                p(r * th.sin() * ph.cos(), r * th.sin() * ph.sin(), 50.0 + r * th.cos())
+            })
+            .collect()
+    };
+    let (top, bot) = (p(0.0, 0.0, 50.0 + r), p(0.0, 0.0, 50.0 - r));
+    let rings: Vec<Vec<Point3>> = (1..lat).map(ring).collect();
+    let mut t = Vec::new();
+    for j in 0..lon {
+        let k = (j + 1) % lon;
+        t.push(Triangle::new(top, rings[0][j], rings[0][k]));
+        for w in rings.windows(2) {
+            t.push(Triangle::new(w[0][j], w[1][j], w[1][k]));
+            t.push(Triangle::new(w[0][j], w[1][k], w[0][k]));
+        }
+        let last = &rings[rings.len() - 1];
+        t.push(Triangle::new(bot, last[k], last[j]));
+    }
+    t
+}
+
+fn sphere_run(lat: usize, lon: usize, moves: usize) -> (usize, f64, f64, usize) {
+    let tris = sphere(50.0, lat, lon);
+    let n = tris.len();
+    let f = fixture(tris);
+    let built = Instant::now();
+    assert!(f.mesh().is_ok(), "the sphere is closed");
+    let build_s = built.elapsed().as_secs_f64();
+    // A zig-zag across the sphere's box at the equator: passes through
+    // the ball convict, passes in the box's corners clear it.
+    let mut v = Vec::new();
+    for i in 0..moves {
+        let y = -48.0 + 96.0 * (i as f64 / moves as f64);
+        v.push(feed(p(-60.0, y, 95.0), p(60.0, y + 0.5, 95.0)));
+    }
+    let path = Toolpath::new(v);
+    let t0 = Instant::now();
+    let (_, meshed) = judge(&path, &f);
+    (n, build_s, t0.elapsed().as_secs_f64(), meshed.len())
+}
+
+#[test]
+fn a_fine_mesh_judges_in_bounded_time() {
+    // 30k facets, 100 passes: the debug-lane guard. The 200k-facet
+    // reading is the heavy lane's (below).
+    let (n, build, judge_s, hits) = sphere_run(100, 150, 100);
+    eprintln!("sphere {n} facets: build {build:.3}s, judge 100 moves {judge_s:.3}s, {hits} hits");
+    assert!(hits > 0 && hits < 100, "some passes clip the ball, the corner ones clear: {hits}");
+}
+
+#[test]
+#[ignore = "heavy lane (release): 200k-facet fixture timing"]
+fn a_200k_facet_fixture_judges_in_bounded_time() {
+    let (n, build, judge_s, hits) = sphere_run(300, 340, 2000);
+    eprintln!("sphere {n} facets: build {build:.3}s, judge 2000 moves {judge_s:.3}s, {hits} hits");
+    assert!(n > 200_000 && hits > 0 && hits < 2000);
+    // The worst case for the narrow phase: 2000 passes grazing the ball
+    // 0.05 mm off its equator, every one inside its box - each sweeps
+    // past thousands of facets and must prove every gap.
+    let f = fixture(sphere(50.0, 300, 340));
+    let c = 54.05 * std::f64::consts::SQRT_2;
+    let v: Vec<Move> = (0..2000)
+        .map(|i| {
+            let z = 50.0 + 0.002 * i as f64;
+            feed(p(c - 16.0, 16.0, z), p(16.0, c - 16.0, z))
+        })
+        .collect();
+    let path = Toolpath::new(v);
+    let t0 = Instant::now();
+    let (boxed, meshed) = judge(&path, &f);
+    eprintln!("grazing 2000 moves: {:.3}s, box hits {}, mesh hits {}", t0.elapsed().as_secs_f64(), boxed.len(), meshed.len());
+    assert_eq!(boxed.len(), 2000);
+    assert!(meshed.is_empty(), "0.05 mm off the ball is clear: {:?}", meshed.first());
+}
diff --git a/crates/sim/tests/fixture_mesh_convict.rs b/crates/sim/tests/fixture_mesh_convict.rs
new file mode 100644
index 00000000..39f1a259
--- /dev/null
+++ b/crates/sim/tests/fixture_mesh_convict.rs
@@ -0,0 +1,300 @@
+//! Can a real mesh penetration pass the fixture box laws (#339 slice
+//! 2)? A meshed fixture's box is the exact AABB of the very vertices its
+//! mesh judges (`app::model::entity_world_aabb`), so the mesh lies
+//! inside it; every z silence of the box laws (the strict-dip rule:
+//! flush contact with a box top or bottom, a retract off a mounting
+//! face) only ever spares an overlap of float dust with the BOX, so it
+//! can spare no more than that with the mesh. These pins hold the
+//! claim on the shapes that look like they might break it: a rotated
+//! fixture whose top is an edge, an overhanging clamp arm, a ramp and
+//! an upright rapid under steel (#424/#425 with a closed mesh), and a
+//! seeded sweep of straight moves - many flush with a face - asserting
+//! that wherever the box laws stay silent the true swept stack stands
+//! clear of the mesh.
+//!
+//! Gate map (M4.4): covers sim::verify::laws, sim::verify::stack_span,
+//! sim::verify::mesh_steel, sim::fixture, sim::fixture_mesh.
+//! Provenance: our own fixtures; the law is the Prime Directive's.
+
+use std::sync::Arc;
+
+use camcraft_sim::cl::{Move, MoveKind, Toolpath};
+use camcraft_sim::fixture::FixtureBox;
+use camcraft_sim::fixture_mesh::MeshedFixture;
+use camcraft_sim::geometry::{Point3, Triangle};
+use camcraft_sim::verify::{
+    bands_vs_workholding, mesh_refined, rapids_vs_workholding, steel_stack, FixturePart, MeshSteel, SteelBand,
+    ToolGeom, Warning, Workholding,
+};
+use camcraft_tools::holder_profile::HolderStack;
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// Flute 0..20 r3, shank 20..50 r5, holder 50..90 r20 above the tip:
+/// the #424/#425 repros' tool.
+fn tool() -> ToolGeom {
+    ToolGeom {
+        radius: 3.0,
+        nose_radius: 0.0,
+        flute_len: 20.0,
+        shank_radius: 5.0,
+        shank_len: 30.0,
+        holder_radius: 20.0,
+        holder_len: 40.0,
+    }
+}
+
+/// A closed, outward box: 12 facets sharing 8 exact corners.
+fn cube(lo: Point3, hi: Point3) -> Vec<Triangle> {
+    let c = |i: usize| {
+        p(if i & 1 == 0 { lo.x } else { hi.x }, if i & 2 == 0 { lo.y } else { hi.y }, if i & 4 == 0 { lo.z } else { hi.z })
+    };
+    let quads = [[0, 2, 3, 1], [4, 5, 7, 6], [0, 1, 5, 4], [2, 6, 7, 3], [0, 4, 6, 2], [1, 3, 7, 5]];
+    quads
+        .iter()
+        .flat_map(|q| [Triangle::new(c(q[0]), c(q[1]), c(q[2])), Triangle::new(c(q[0]), c(q[2]), c(q[3]))])
+        .collect()
+}
+
+/// `tris` turned by `deg` about the unit axis `k` through the origin
+/// (Rodrigues), then moved by `d`. A shared vertex maps to the same
+/// bits every time, so a closed mesh stays closed.
+fn turned(tris: &[Triangle], k: [f64; 3], deg: f64, d: Point3) -> Vec<Triangle> {
+    let l = (k[0] * k[0] + k[1] * k[1] + k[2] * k[2]).sqrt();
+    let k = [k[0] / l, k[1] / l, k[2] / l];
+    let (s, c) = deg.to_radians().sin_cos();
+    let f = |v: Point3| {
+        let w = [v.x, v.y, v.z];
+        let kx = [k[1] * w[2] - k[2] * w[1], k[2] * w[0] - k[0] * w[2], k[0] * w[1] - k[1] * w[0]];
+        let e = (k[0] * w[0] + k[1] * w[1] + k[2] * w[2]) * (1.0 - c);
+        p(
+            w[0] * c + kx[0] * s + k[0] * e + d.x,
+            w[1] * c + kx[1] * s + k[1] * e + d.y,
+            w[2] * c + kx[2] * s + k[2] * e + d.z,
+        )
+    };
+    tris.iter().map(|t| Triangle::new(f(t.a), f(t.b), f(t.c))).collect()
+}
+
+/// The exact AABB of the vertices - what `entity_world_aabb` reports.
+fn aabb(tris: &[Triangle]) -> FixtureBox {
+    let mut lo = p(f64::MAX, f64::MAX, f64::MAX);
+    let mut hi = p(f64::MIN, f64::MIN, f64::MIN);
+    for q in tris.iter().flat_map(|t| [t.a, t.b, t.c]) {
+        lo = p(lo.x.min(q.x), lo.y.min(q.y), lo.z.min(q.z));
+        hi = p(hi.x.max(q.x), hi.y.max(q.y), hi.z.max(q.z));
+    }
+    FixtureBox { min: lo, max: hi }
+}
+
+fn fixture(tris: Vec<Triangle>) -> MeshedFixture {
+    MeshedFixture::new("Fixture1", aabb(&tris), Arc::<[Triangle]>::from(tris))
+}
+
+fn stack(t: &ToolGeom) -> Vec<SteelBand> {
+    steel_stack(t, &HolderStack::cylinder(t), None)
+}
+
+/// Both laws (c2)/(d2), box-only and mesh-refined, for one fixture -
+/// the app's own composition (`posting::fixture_problems`).
+fn judge(path: &Toolpath, f: &MeshedFixture) -> (Vec<Warning>, Vec<Warning>) {
+    let boxes = [f.aabb];
+    let wh = Workholding { turning: &boxes, fixed: &[], axis: None };
+    let t = tool();
+    let st = stack(&t);
+    let steel = MeshSteel { fixtures: std::slice::from_ref(f), stack: &st, chord_tol: 0.01 };
+    let mut boxed = bands_vs_workholding(path, &t, &wh, None, 0.01);
+    boxed.extend(rapids_vs_workholding(path, &t, &wh, None));
+    let mut meshed = mesh_refined(path, &wh, &steel, false, |w| bands_vs_workholding(path, &t, w, None, 0.01));
+    meshed.extend(mesh_refined(path, &wh, &steel, true, |w| rapids_vs_workholding(path, &t, w, None)));
+    (boxed, meshed)
+}
+
+fn hit_at(ws: &[Warning], i: usize) -> Option<FixturePart> {
+    ws.iter().find_map(|w| match w {
+        Warning::FixtureHit { at, fixture_part } if *at == i => Some(*fixture_part),
+        _ => None,
+    })
+}
+
+fn rapid(a: Point3, b: Point3) -> Move {
+    Move::new(MoveKind::Rapid, a, b, None)
+}
+
+fn feed(a: Point3, b: Point3) -> Move {
+    Move::new(MoveKind::Feed, a, b, Some(500.0))
+}
+
+/// Does the TRUE swept stack - every band shrunk by `d` on every side,
+/// so flush contact does not count - reach into the mesh along the
+/// straight move? (A facet met, or a band standing inside the solid.)
+fn penetrates(f: &MeshedFixture, m: &Move, d: f64) -> bool {
+    let Ok(mesh) = f.mesh() else { return false };
+    stack(&tool()).iter().filter(|b| b.hi - b.lo > 2.0 * d && b.r > d).any(|b| {
+        mesh.band_meets(m.from, m.to, b.lo + d, b.hi - d, b.r - d, 0.0)
+            || mesh.contains(p(m.from.x, m.from.y, m.from.z + 0.5 * (b.lo + b.hi)))
+    })
+}
+
+#[test]
+fn a_mesh_top_face_keeps_the_strict_dip_and_a_dip_convicts() {
+    let f = fixture(cube(p(-30.0, -30.0, 0.0), p(30.0, 30.0, 20.0)));
+    let path = Toolpath::new(vec![
+        rapid(p(0.0, 0.0, 20.0), p(0.0, 0.0, 80.0)), // retract off the face
+        rapid(p(-50.0, 0.0, 20.0), p(50.0, 0.0, 20.0)), // traverse riding it
+        feed(p(-50.0, 0.0, 20.0), p(50.0, 0.0, 20.0)), // a cut riding it
+        rapid(p(0.0, 0.0, 19.999), p(0.0, 0.0, 80.0)), // a thousandth in
+        feed(p(-50.0, 0.0, 19.999), p(50.0, 0.0, 19.999)),
+    ]);
+    let (boxed, meshed) = judge(&path, &f);
+    for i in 0..3 {
