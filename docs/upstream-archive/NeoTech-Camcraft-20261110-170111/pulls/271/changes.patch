diff --git a/crates/app/tests/probe_dialects.rs b/crates/app/tests/probe_dialects.rs
new file mode 100644
index 00000000..9ac854fc
--- /dev/null
+++ b/crates/app/tests/probe_dialects.rs
@@ -0,0 +1,256 @@
+//! #173 acceptance: the probing hooks of the Haas, Mazak and Siemens 840D
+//! posts, and the Heidenhain post's named refusal. Each voiced dialect
+//! posts the same bore-centre probe the generic dialect's golden
+//! (`nc/fanuc/probe_bore_centre.nc`, tests/probe_op.rs) posts, through
+//! the whole post seam (dump -> stream text -> engine -> <dialect>.cps).
+//!
+//! Provenance: the public programming documentation each post cites in
+//! its probing section (Haas Mill Operator's Manual; Mazak EIA/ISO
+//! programming manual; SINUMERIK 840D sl Fundamentals / Job Planning);
+//! our own fixtures.
+//!
+//! #174 on these dialects: every positioning feed of the cycle (GUARD)
+//! posts as a protected move that alarms on an unexpected trip, with an
+//! alarm distinct from the no-contact one.
+//!
+//! Gate map (M4.4): covers assets/posts (haas, mazak, sinumerik,
+//! heidenhain probing; onProbeGuard), post::probe_rec (GUARD),
+//! motion::probing.
+
+mod common;
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::post::{self, cnc, engine};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+
+const HAAS: &str = include_str!("../../../assets/posts/haas.cps");
+const MAZAK: &str = include_str!("../../../assets/posts/mazak.cps");
+const SINUMERIK: &str = include_str!("../../../assets/posts/sinumerik.cps");
+const HEIDENHAIN: &str = include_str!("../../../assets/posts/heidenhain.cps");
+
+/// The bore centre of tests/probe_op.rs: a 20 mm bore at (30, 30),
+/// rim Z 20, four touches (seek + measure each).
+fn bore_stream(set_wcs: Option<u8>, wcs: &str) -> String {
+    probe_stream(ProbeMode::Bore, ProbeDir::ZNeg, Point3::new(30.0, 30.0, 20.0), 10.0, set_wcs, wcs)
+}
+
+/// An edge +X touch at the part edge X 0: the 4 mm ball trips at X -2,
+/// so the expected value is negative.
+fn edge_stream() -> String {
+    probe_stream(ProbeMode::Edge, ProbeDir::XPos, Point3::new(0.0, 5.0, 20.0), 0.0, Some(1), "G54")
+}
+
+fn probe_stream(mode: ProbeMode, dir: ProbeDir, target: Point3, radius: f64, set_wcs: Option<u8>, wcs: &str) -> String {
+    let p = ProbeParams {
+        mode,
+        dir,
+        dir_y: ProbeDir::YPos,
+        target,
+        radius,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    };
+    let t = probe_cycle(&p).expect("probe cycle");
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 7,
+        tool_name: "PROBE-4",
+        tool_diameter: 4.0,
+        rpm: 0.0,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        wcs,
+        probe_result: Some(post::probe_rec::ProbeResult { set_wcs, tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    let recs = post::dump(&t, &d);
+    assert!(!recs.iter().any(|r| matches!(r, cnc::Record::Warn { .. })), "a sane probe path carries no WARN");
+    cnc::serialize(&recs)
+}
+
+fn post_ok(cps: &str, stream: &str) -> String {
+    let out = engine::run(cps, &serde_json::Value::Null, stream).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(
+        !out.program.lines().any(|l| l.split_whitespace().any(|w| w == "M3" || w == "M8" || w == "MOTON")),
+        "a touch probe starts no spindle and no coolant:\n{}",
+        out.program
+    );
+    out.program
+}
+
+#[test]
+fn haas_bore_centre_posts_g31_skips() {
+    let stream = bore_stream(Some(1), "G54");
+    let prog = post_ok(HAAS, &stream);
+    let n = 8 + guard_count(&stream);
+    assert_eq!(prog.lines().filter(|l| l.starts_with("G31 ")).count(), n, "four touches (seek + measure) + guards");
+    assert!(prog.contains("IF[ABS[#5061-43]LT0.001]THEN#3000=2(PROBE NO CONTACT)"), "{prog}");
+    assert!(prog.contains("#100=#5061"), "the measured trip is kept");
+    assert!(prog.contains("G91 G1 X-1 Y0 Z0 F300"), "the back-off is incremental");
+    assert!(prog.contains("G10 L2 P2 X[#5221+#190] Y[#5222+#191]"), "the result sets G55 from G54: {prog}");
+    common::write_golden("nc/haas/probe_bore_centre.nc", &prog);
+}
+
+#[test]
+fn haas_without_an_offset_to_set_stops_for_the_operator() {
+    let prog = post_ok(HAAS, &bore_stream(None, "G54"));
+    assert!(!prog.contains("G10"), "nothing is set");
+    assert!(prog.contains("#3006=1(CHECK PROBE RESULT #190..)"), "{prog}");
+}
+
+#[test]
+fn mazak_bore_centre_posts_g31_skips_with_goto_tests() {
+    let stream = bore_stream(Some(1), "G54");
+    let prog = post_ok(MAZAK, &stream);
+    let n = 8 + guard_count(&stream);
+    assert_eq!(prog.lines().filter(|l| l.starts_with("G31 ")).count(), n, "four touches (seek + measure) + guards");
+    assert!(!prog.contains("THEN"), "the branch is IF..GOTO, not IF..THEN");
+    assert!(prog.contains("IF[ABS[#5061-43]GE0.001]GOTO9002\n#3000=2(PROBE NO CONTACT)\nN9002\n"), "{prog}");
+    assert!(prog.contains("G91 G01 X-1 Y0 Z0 F300"), "the back-off is incremental");
+    assert!(prog.contains("G10 L2 P2 X[#5221+#190] Y[#5222+#191]"), "the result sets G55 from G54: {prog}");
+    // Every GOTO label is unique, so no jump can land on another test's.
+    let labels: Vec<&str> = prog.lines().filter(|l| l.starts_with("N9")).collect();
+    let mut uniq = labels.clone();
+    uniq.sort_unstable();
+    uniq.dedup();
+    assert_eq!(labels.len(), uniq.len(), "unique labels: {labels:?}");
+    common::write_golden("nc/mazak/probe_bore_centre.nc", &prog);
+}
+
+#[test]
+fn mazak_without_an_offset_to_set_stops_for_the_operator() {
+    let prog = post_ok(MAZAK, &bore_stream(None, "G54"));
+    assert!(!prog.contains("G10"), "nothing is set");
+    assert!(prog.contains("(CHECK PROBE RESULT #190..)\nM00\n"), "{prog}");
+}
+
+#[test]
+fn sinumerik_bore_centre_posts_meas_blocks() {
+    let stream = bore_stream(Some(1), "G54");
+    let prog = post_ok(SINUMERIK, &stream);
+    let n = 8 + guard_count(&stream);
+    assert_eq!(prog.lines().filter(|l| l.contains(" MEAS=1 G1 ")).count(), n, "four touches (seek + measure) + guards");
+    assert!(!prog.contains("G31"), "a Siemens control measures with MEAS, not G31");
+    assert!(prog.contains(" IF $AC_MEA[1]==0\n"), "a touch that never trips alarms: {prog}");
+    assert!(prog.contains(" R50=$AA_MW[X]\n"), "the trip is read in workpiece coordinates");
+    assert!(prog.contains(" G91 G1 X-1 Y0 Z0 F300\n"), "the back-off is incremental");
+    assert!(prog.contains(" $P_UIFR[2,X,TR]=$P_UIFR[1,X,TR]+R90\n"), "the result sets G55 from G54: {prog}");
+    assert!(prog.contains(" $P_UIFR[2,X,FI]=$P_UIFR[1,X,FI]\n"), "the fine part follows the active frame");
+    common::write_golden("nc/sinumerik/probe_bore_centre.nc", &prog);
+}
+
+/// G58 / G59 are axial programmable offsets on an 840D, not settable
+/// frames: a probe asked to set one is refused by name, never posted.
+#[test]
+fn sinumerik_refuses_setting_g59_by_name() {
+    let out = engine::run(SINUMERIK, &serde_json::Value::Null, &bore_stream(Some(5), "G54")).expect("post");
+    assert!(out.warnings.iter().any(|w| w.contains("G59") && w.contains("settable frames")), "{:?}", out.warnings);
+    assert!(!out.program.contains("$P_UIFR"), "nothing is set");
+}
+
+/// Heidenhain's ISO manual states no skip move and no trip-position
+/// variable (probing is the touch-probe cycles, another manual): the
+/// post defines no probing hook and the engine refuses by name - a
+/// counted warning, which blocks the post (posting::post_script).
+#[test]
+fn heidenhain_refuses_a_probe_by_name() {
+    let out = engine::run(HEIDENHAIN, &serde_json::Value::Null, &bore_stream(Some(1), "G54")).expect("engine runs");
+    for hook in ["onProbeMove", "onProbeRetreat", "onProbeResult"] {
+        assert!(out.warnings.iter().any(|w| w.contains(hook)), "refused by {hook}: {:?}", out.warnings);
+    }
+}
+
+/// A negative expected value (edge probe) folds its sign into the
+/// operator: no doubled sign like `#190=#100--2` is ever written.
+fn no_doubled_sign(prog: &str) {
+    assert!(!prog.contains("--") && !prog.contains("+-") && !prog.contains("-+"), "doubled sign:\n{prog}");
+}
+
+#[test]
+fn haas_edge_deviation_folds_its_sign() {
+    let prog = post_ok(HAAS, &edge_stream());
+    no_doubled_sign(&prog);
+    assert!(prog.contains("#190=#100+2\n"), "{prog}");
+}
+
+#[test]
+fn mazak_edge_deviation_folds_its_sign() {
+    let prog = post_ok(MAZAK, &edge_stream());
+    no_doubled_sign(&prog);
+    assert!(prog.contains("#190=#100+2\n"), "{prog}");
+}
+
+#[test]
+fn sinumerik_edge_deviation_folds_its_sign() {
+    let prog = post_ok(SINUMERIK, &edge_stream());
+    no_doubled_sign(&prog);
+    assert!(prog.contains(" R90=R50+2\n"), "{prog}");
+}
+
+/// #174: the bore's GUARD records - the descent from the rapid plane to
+/// the touch depth and the rise back - in the stream every dialect posts.
+fn guard_count(stream: &str) -> usize {
+    stream.lines().filter(|l| l.starts_with("GUARD ")).count()
+}
+
+/// Haas: each guard is a G31 followed by one #5061+ test per moving
+/// axis, alarming #3000=3 - not the no-contact alarm 2.
+#[test]
+fn haas_guards_positioning_moves_with_a_hit_alarm() {
+    let stream = bore_stream(Some(1), "G54");
+    let guards = guard_count(&stream);
+    assert!(guards > 0, "the bore has protected moves:\n{stream}");
+    let prog = post_ok(HAAS, &stream);
+    let lines: Vec<&str> = prog.lines().collect();
+    assert!(!lines.iter().any(|l| l.starts_with("G1 ") || l.starts_with("G01 ")), "no plain feed:\n{prog}");
+    let hits = lines.iter().filter(|l| l.ends_with("]GT0.001]THEN#3000=3(PROBE HIT ON POSITIONING)")).count();
+    assert!(hits >= guards, "a test per guard's moving axis:\n{prog}");
+    // The descent to the touch depth (Z 15) is guarded on Z, the axis it moves.
+    assert!(prog.contains("IF[ABS[#5063-15]GT0.001]THEN#3000=3(PROBE HIT ON POSITIONING)"), "{prog}");
+    assert_eq!(lines.iter().filter(|l| l.starts_with("G31 ")).count(), 8 + guards, "touches + guards");
+}
+
+/// Mazak: the same test in the IF[..]GOTOn form, jumping past a
+/// #3000=3 alarm only when the move reached its target.
+#[test]
+fn mazak_guards_positioning_moves_with_a_hit_alarm() {
+    let stream = bore_stream(Some(1), "G54");
+    let guards = guard_count(&stream);
+    let prog = post_ok(MAZAK, &stream);
+    assert!(!prog.contains("THEN"), "IF..GOTO, not IF..THEN");
+    assert!(!prog.lines().any(|l| l.starts_with("G1 ") || l.starts_with("G01 ")), "no plain feed:\n{prog}");
+    assert!(prog.matches("#3000=3(PROBE HIT ON POSITIONING)").count() >= guards, "{prog}");
+    let at = prog.find("IF[ABS[#5063-15]LE0.001]GOTO").expect("the descent's Z test");
+    let tail = &prog[at..];
+    let label = tail["IF[ABS[#5063-15]LE0.001]GOTO".len()..].lines().next().unwrap_or_default();
+    assert!(
+        tail.contains(&format!("GOTO{label}\n#3000=3(PROBE HIT ON POSITIONING)\nN{label}\n")),
+        "the alarm sits between the test and its label:\n{prog}"
+    );
+    assert_eq!(prog.lines().filter(|l| l.starts_with("G31 ")).count(), 8 + guards, "touches + guards");
+}
+
+/// Sinumerik: each guard is a MEAS=1 G1 block followed by a $AC_MEA[1]
+/// test that alarms SETAL(65002) - not the no-contact 65000 - and stops.
+#[test]
+fn sinumerik_guards_positioning_moves_with_a_hit_alarm() {
+    let stream = bore_stream(Some(1), "G54");
+    let guards = guard_count(&stream);
+    let prog = post_ok(SINUMERIK, &stream);
+    assert_eq!(prog.lines().filter(|l| l.contains(" MEAS=1 G1 ")).count(), 8 + guards, "touches + guards");
+    assert_eq!(prog.matches(" IF $AC_MEA[1]==1\n").count(), guards, "{prog}");
+    assert_eq!(prog.matches(" SETAL(65002)\n").count(), guards, "{prog}");
+    let at = prog.find(" IF $AC_MEA[1]==1\n").expect("a guard test");
+    let block: Vec<&str> = prog[at..].lines().take(5).collect();
+    assert!(block[1].ends_with(" MSG(\"PROBE HIT ON POSITIONING\")"), "{block:?}");
+    assert!(block[2].ends_with(" SETAL(65002)") && block[3].ends_with(" M0") && block[4].ends_with(" ENDIF"), "{block:?}");
+    assert!(!prog.lines().any(|l| l.contains(" G1 ") && !l.contains("MEAS=1") && !l.contains("G91")), "no plain feed:\n{prog}");
+}
diff --git a/crates/app/tests/probe_guard.rs b/crates/app/tests/probe_guard.rs
new file mode 100644
index 00000000..6c98ba14
--- /dev/null
+++ b/crates/app/tests/probe_guard.rs
@@ -0,0 +1,187 @@
+//! #174 acceptance: the positioning feeds of a probe cycle - the descent
+//! from the rapid / safe plane to each touch's start, the travel between
+//! touches, the rise - are protected moves. The dump marks them in the
+//! stream (`GUARD`), and each probing post writes them as a stop-on-
+//! contact move that ALARMS on an unexpected trip: the G31 skip read
+//! the other way round (#5061-#5063 not at the target) on the Fanuc
+//! dialect, G38.3 + a #5070 test on Tormach PathPilot (LinuxCNC). A
+//! probing script that cannot voice the move is refused by name.
+//!
+//! Provenance: Fanuc's published operator documentation (G31 skip,
+//! custom macro B system variables, #3000 alarms); the LinuxCNC G-code
+//! reference (G38.3, #5070, O-code conditionals, MSG); our own fixtures.
+//!
+//! Gate map (M4.4): covers post::probe_rec (GUARD), post::cnc, post::engine,
+//! post::invert, motion::probing, assets/posts fanuc.cps + tormach.cps
+//! (onProbeGuard).
+
+mod common;
+
+use camcraft_app::cl::{MoveKind, Toolpath};
+use camcraft_app::geometry::Point3;
+use camcraft_app::post::{self, cnc, engine};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
+
+const FANUC: &str = include_str!("../../../assets/posts/fanuc.cps");
+const TORMACH: &str = include_str!("../../../assets/posts/tormach.cps");
+
+fn cycle(mode: ProbeMode, dir: ProbeDir, dir_y: ProbeDir, target: Point3, radius: f64) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir,
+        dir_y,
+        target,
+        radius,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+fn corner() -> Toolpath {
+    probe_cycle(&cycle(ProbeMode::Corner, ProbeDir::XPos, ProbeDir::YPos, Point3::new(0.0, 0.0, 20.0), 0.0))
+        .expect("corner")
+}
+
+fn records(t: &Toolpath) -> Vec<cnc::Record> {
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 7,
+        tool_name: "PROBE-4",
+        tool_diameter: 4.0,
+        rpm: 0.0,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        probe_result: Some(post::probe_rec::ProbeResult { set_wcs: Some(0), tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    post::dump(t, &d)
+}
+
+/// Every motion of a probe path is a touch, a back-off, a protected
+/// move or a rapid - never a plain feed - and each mode's positioning
+/// feeds (descent, travel, rise) are exactly the GUARD records. Since
+/// #570 every path opens with a protected descent from the safe plane to
+/// the approach plane; a -Z face then starts its touch there, so its
+/// other feed is its rise.
+#[test]
+fn the_positioning_feeds_of_a_probe_path_are_marked_protected() {
+    let modes = [
+        ("face", cycle(ProbeMode::Face, ProbeDir::ZNeg, ProbeDir::YPos, Point3::new(10.0, 5.0, 20.0), 0.0), 2),
+        ("edge", cycle(ProbeMode::Edge, ProbeDir::XPos, ProbeDir::YPos, Point3::new(0.0, 5.0, 20.0), 0.0), 3),
+        ("corner", cycle(ProbeMode::Corner, ProbeDir::XPos, ProbeDir::YPos, Point3::new(0.0, 0.0, 20.0), 0.0), 5),
+        ("bore", cycle(ProbeMode::Bore, ProbeDir::ZNeg, ProbeDir::YPos, Point3::new(30.0, 30.0, 20.0), 10.0), 3),
+        ("boss", cycle(ProbeMode::Boss, ProbeDir::ZNeg, ProbeDir::YPos, Point3::new(30.0, 30.0, 20.0), 10.0), 9),
+    ];
+    for (name, p, want) in modes {
+        let t = probe_cycle(&p).expect(name);
+        let recs = records(&t);
+        assert!(!recs.iter().any(|r| matches!(r, cnc::Record::Warn { .. })), "{name}: no WARN");
+        let feeds = recs.iter().filter(|r| matches!(r, cnc::Record::Move(m) if m.kind != MoveKind::Rapid)).count();
+        assert_eq!(feeds, 0, "{name}: no positioning feed posts as a plain G1");
+        let guards: Vec<[f64; 3]> = recs
+            .iter()
+            .filter_map(|r| match r {
+                cnc::Record::Guard(g) => Some(g.to),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(guards.len(), want, "{name}: the descents, the travel and the rises");
+        // Each guard is one of the path's non-rapid moves, not a touch.
+        let touch_ix: Vec<usize> = t.probes.iter().map(|p| p.index).collect();
+        for g in &guards {
+            assert!(
+                t.moves.iter().enumerate().any(|(i, m)| m.kind != MoveKind::Rapid
+                    && !touch_ix.contains(&i)
+                    && (m.to.x - g[0]).abs() < 1e-9
+                    && (m.to.y - g[1]).abs() < 1e-9
+                    && (m.to.z - g[2]).abs() < 1e-9),
+                "{name}: guard {g:?} is a positioning feed of the path"
+            );
+        }
+        // The motion count the viewer map relies on is unchanged.
+        let motions = recs
+            .iter()
+            .filter(|r| {
+                matches!(r, cnc::Record::Move(_) | cnc::Record::Touch(_) | cnc::Record::Retreat(_) | cnc::Record::Guard(_))
+            })
+            .count();
+        assert_eq!(motions, t.moves.len(), "{name}: one record per move");
+    }
+    // A cutting path (no touches) carries no GUARD.
+    let mut plain = corner();
+    plain.probes.clear();
+    let d = post::Dump { op_name: "Cut", tool_number: 1, tool_name: "EM", tool_diameter: 6.0, ..post::Dump::default() };
+    assert!(!post::dump(&plain, &d).iter().any(|r| matches!(r, cnc::Record::Guard(_))));
+}
+
+/// GUARD round-trips through the stream text, and malformed lines are
+/// refused by the parser, not guessed at.
+#[test]
+fn the_guard_record_round_trips_and_refuses_malformed_lines() {
+    let recs = records(&corner());
+    let stream = cnc::serialize(&recs);
+    assert!(stream.contains("\nGUARD "), "{stream}");
+    assert_eq!(cnc::parse(&stream).expect("parse"), recs);
+    for bad in ["GUARD 1 2 3\n", "GUARD 1 2 F 300\n", "GUARD 1 2 3 F 0\n", "GUARD 1 2 x F 300\n"] {
+        assert!(cnc::parse(bad).is_err(), "{bad:?} is refused");
+    }
+}
+
+/// The Fanuc dialect: each guard is a G31 followed by one alarm test
+/// per moving axis; the corner golden pins the travel between touches.
+#[test]
+fn fanuc_writes_protected_moves_as_g31_with_a_contact_alarm() {
+    let stream = cnc::serialize(&records(&corner()));
+    let out = engine::run(FANUC, &serde_json::Value::Null, &stream).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    let lines: Vec<&str> = out.program.lines().collect();
+    assert!(
+        !lines.iter().any(|l| l.starts_with("G01 ") || l.starts_with("G1 ")),
+        "no absolute feed is left in a probe program:\n{}",
+        out.program
+    );
+    let alarms = lines.iter().filter(|l| l.ends_with("THEN#3000=3(PROBE HIT ON POSITIONING)")).count();
+    assert_eq!(alarms, 5, "the opening descent (#570), then a descent and a rise per touch, each a Z test:\n{}", out.program);
+    // The first descent (#570): from the safe plane to the approach plane.
+    let at = lines.iter().position(|l| l.starts_with("G31 ") && l.contains("F300")).expect("a G31");
+    assert_eq!(lines[at + 1], "IF[ABS[#5063-25]GT0.001]THEN#3000=3(PROBE HIT ON POSITIONING)", "\n{}", out.program);
+    common::write_golden("nc/fanuc/probe_corner.nc", &out.program);
+}
+
+/// Tormach PathPilot: G38.3 then the #5070 test that ends the program.
+/// The touches themselves (G38.2) are #362's; this golden pins the
+/// protected moves alone (the corner's guard records and rapids).
+#[test]
+fn tormach_writes_protected_moves_as_g38_3_with_a_trip_test() {
+    let recs: Vec<cnc::Record> = records(&corner())
+        .into_iter()
+        .filter(|r| !matches!(r, cnc::Record::Touch(_) | cnc::Record::Retreat(_) | cnc::Record::Found(_)))
+        .collect();
+    let out = engine::run(TORMACH, &serde_json::Value::Null, &cnc::serialize(&recs)).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert_eq!(out.program.matches("G38.3 ").count(), 5, "\n{}", out.program);
+    assert_eq!(out.program.matches("[#5070 EQ 1]").count(), 5, "\n{}", out.program);
+    assert!(out.program.contains("o5001 if [#5070 EQ 1]\n(MSG, PROBE HIT ON POSITIONING)\nM2\no5001 endif\n"));
+    assert!(!out.program.lines().any(|l| l.starts_with("G1 ")), "no plain feed:\n{}", out.program);
+    common::write_golden("nc/tormach/probe_guard_moves.nc", &out.program);
+}
+
+/// A post that probes but cannot write a protected move is refused by
+/// name, once per operation - never a plain G1 in its place.
+#[test]
+fn a_probing_post_without_on_probe_guard_is_refused_by_name() {
+    let script = FANUC.replace("function onProbeGuard()", "function onProbeGuardNotHere()");
+    let stream = cnc::serialize(&records(&corner()));
+    let out = engine::run(&script, &serde_json::Value::Null, &stream).expect("post");
+    let named: Vec<&String> = out.warnings.iter().filter(|w| w.contains("onProbeGuard")).collect();
+    assert_eq!(named.len(), 1, "one refusal for the operation: {:?}", out.warnings);
+    assert!(named[0].contains("Probe1"), "names the operation: {}", named[0]);
+    assert!(!out.program.lines().any(|l| l.starts_with("G01 ")), "no plain feed stands in:\n{}", out.program);
+}
