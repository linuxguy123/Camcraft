diff --git a/crates/app/tests/inverted_axis_display.rs b/crates/app/tests/inverted_axis_display.rs
new file mode 100644
index 00000000..3192a66d
--- /dev/null
+++ b/crates/app/tests/inverted_axis_display.rs
@@ -0,0 +1,106 @@
+//! Showing an inverted machine axis (#375): the setup sheet states each
+//! inverted axis of the machine its setup mounts, the posts that
+//! translate an inverted axis (Fanuc, Haas) write it in the program
+//! header, and a standard machine adds no line anywhere.
+//!
+//! Provenance: our own tests over ISO 841's right-handed program frame
+//! and RS-274 comment syntax; fixture values are our own invention.
+//!
+//! Gate map (M4.4): covers app::setup_sheet, machine::direction, post::machine, assets/posts.
+
+mod inverted_support;
+
+use camcraft_app::commands::{CreateSetup, History, LoadMachine, SetSetupMachine};
+use camcraft_app::machine::{self, AxisDirection, AxisLimits, Machine};
+use camcraft_app::post::engine;
+use camcraft_app::setup_sheet;
+use camcraft_app::world::new_world;
+use inverted_support::{cps, machine as mch, probe_stream};
+
+fn mill(inverted: &[&str]) -> Machine {
+    let axis = |n: &str| AxisLimits {
+        name: n.into(),
+        travel: Some((-100.0, 100.0)),
+        direction: if inverted.contains(&n) { AxisDirection::Inverted } else { AxisDirection::Standard },
+        ..Default::default()
+    };
+    Machine { model: "Flip 1".into(), axes: vec![axis("X"), axis("Y"), axis("Z")], ..Default::default() }
+}
+
+fn sheet_for(inverted: &[&str]) -> String {
+    let world = new_world();
+    let mut history = History::default();
+    let load = LoadMachine::new(&world, "flip.mch".into(), Some(mill(inverted))).expect("load");
+    history.execute(&world, load);
+    setup_sheet::render(&world, None).expect("sheet")
+}
+
+#[test]
+fn the_setup_sheet_states_each_inverted_axis() {
+    let sheet = sheet_for(&["X"]);
+    assert!(sheet.contains("MACHINE AXES\n"), "{sheet}");
+    assert!(
+        sheet.contains("  Machine X+ moves left (inverted axis) - the program is mirrored in X for this machine\n"),
+        "{sheet}"
+    );
+    let both = sheet_for(&["X", "Y"]);
+    assert!(both.contains("Machine X+ moves left (inverted axis)"), "{both}");
+    assert!(both.contains("Machine Y+ moves toward the front (inverted axis) - the program is mirrored in Y"), "{both}");
+    assert_eq!(both.matches("(inverted axis)").count(), 2, "one line per axis:\n{both}");
+}
+
+#[test]
+fn a_standard_machine_adds_no_sheet_line() {
+    let std_sheet = sheet_for(&[]);
+    assert!(!std_sheet.contains("MACHINE AXES"), "{std_sheet}");
+    assert!(!std_sheet.contains("inverted"), "{std_sheet}");
+    let none = setup_sheet::render(&new_world(), None).expect("sheet");
+    assert!(!none.contains("MACHINE AXES"), "no machine, no section:\n{none}");
+    // The section is the only difference an inverted X makes to a sheet.
+    let inv = sheet_for(&["X"]);
+    let stripped = inv.replace(
+        "MACHINE AXES\n  Machine X+ moves left (inverted axis) - the program is mirrored in X for this machine\n\n",
+        "",
+    );
+    assert_eq!(stripped, std_sheet);
+}
+
+#[test]
+fn the_sheet_reads_the_machine_its_own_setup_mounts() {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(&world, LoadMachine::new(&world, "std.mch".into(), Some(mill(&[]))).expect("load"));
+    for _ in 0..2 {
+        history.execute(&world, CreateSetup::new(&world, None, None).expect("setup"));
+    }
+    let own = SetSetupMachine::new(&world, "Setup2", Some(("flip.mch".into(), Some(mill(&["X"])))));
+    history.execute(&world, own.expect("mount"));
+    let s1 = setup_sheet::render(&world, Some("Setup1")).expect("sheet 1");
+    let s2 = setup_sheet::render(&world, Some("Setup2")).expect("sheet 2");
+    assert!(!s1.contains("MACHINE AXES"), "Setup1 follows the standard document machine:\n{s1}");
+    assert!(s2.contains("Machine X+ moves left (inverted axis)"), "Setup2 mounts the inverted one:\n{s2}");
+}
+
+#[test]
+fn the_header_states_the_inverted_axis_for_every_translating_post() {
+    for stem in ["fanuc", "haas"] {
+        let inv = engine::run(&cps(stem), &mch(&["X"]), &probe_stream()).expect("posts");
+        let std = engine::run(&cps(stem), &mch(&[]), &probe_stream()).expect("posts");
+        let note = "(MACHINE X+ MOVES LEFT - INVERTED AXIS)";
+        let at = inv.program.lines().position(|l| l == note);
+        assert!(at.is_some_and(|i| i <= 2), "{stem}: the note rides the header:\n{}", inv.program);
+        assert_eq!(inv.program.matches(note).count(), 1, "{stem}: once");
+        assert!(!std.program.contains("INVERTED"), "{stem}: a standard machine writes no note");
+        let both = engine::run(&cps(stem), &mch(&["X", "Y"]), &probe_stream()).expect("posts");
+        assert!(both.program.contains(note), "{stem}");
+        assert!(both.program.contains("(MACHINE Y+ MOVES TOWARD THE FRONT - INVERTED AXIS)"), "{stem}");
+    }
+}
+
+#[test]
+fn one_wording_table_for_every_display() {
+    assert_eq!(machine::inverted_axis_line("X"), "Machine X+ moves left (inverted axis)");
+    assert_eq!(machine::inverted_motion("Y"), "toward the front");
+    assert_eq!(machine::inverted_motion("Z"), "down");
+    assert_eq!(machine::inverted_motion("U"), "the other way");
+}
diff --git a/crates/app/tests/inverted_equivalence.rs b/crates/app/tests/inverted_equivalence.rs
new file mode 100644
index 00000000..dbf4d3db
--- /dev/null
+++ b/crates/app/tests/inverted_equivalence.rs
@@ -0,0 +1,56 @@
+//! The key safety law of #374: a program posted for a machine with an
+//! inverted axis, read by THAT machine's controller (its + on the
+//! inverted axis moves the other way), drives the tool along the CAM path:
+//! lines, G2/G3 in G17/G18/G19 with their I/J/K, the work-offset
+//! origin, the drilled hole, and the physical side cutter compensation
+//! offsets to. And the converse: the standard-sign program on that
+//! machine does NOT (the reader is not a tautology).
+//!
+//! Gate map (M4.4): covers post::invert, post::engine, assets/posts fanuc.cps + haas.cps.
+
+mod inverted_support;
+
+use camcraft_app::post::engine;
+use inverted_support::{
+    assert_same_path, cam_events, controller_events, cps, machine, probe_records, probe_stream, Event,
+};
+
+/// The posted program's physical path within this of the CAM path: the
+/// dialects write three decimals.
+const TOL: f64 = 0.002;
+
+const CASES: &[(&[&str], [bool; 3])] = &[
+    (&["X"], [true, false, false]),
+    (&["Y"], [false, true, false]),
+    (&["X", "Y"], [true, true, false]),
+];
+
+#[test]
+fn an_inverted_machine_cuts_the_cam_path() {
+    let want = cam_events(&probe_records());
+    assert!(want.iter().any(|e| matches!(e, Event::Engage(_))) && want.iter().any(|e| matches!(e, Event::Hole(_))));
+    for stem in ["fanuc", "haas"] {
+        // The reader itself, on a standard machine: the CAM path.
+        let out = engine::run(&cps(stem), &machine(&[]), &probe_stream()).expect("standard posts");
+        assert!(out.warnings.is_empty(), "{stem}: {:?}", out.warnings);
+        assert_same_path(&want, &controller_events(&out.program, [false; 3]), TOL, &format!("{stem} standard"));
+        for (letters, flip) in CASES {
+            let what = format!("{stem} inverted {letters:?}");
+            let out =
+                engine::run(&cps(stem), &machine(letters), &probe_stream()).unwrap_or_else(|e| panic!("{what}: {e}"));
+            assert!(out.warnings.is_empty(), "{what}: {:?}", out.warnings);
+            assert_same_path(&want, &controller_events(&out.program, *flip), TOL, &what);
+        }
+    }
+}
+
+#[test]
+fn the_standard_program_on_an_inverted_machine_strays() {
+    let want = cam_events(&probe_records());
+    let out = engine::run(&cps("fanuc"), &machine(&[]), &probe_stream()).expect("standard posts");
+    for (letters, flip) in CASES {
+        let got = controller_events(&out.program, *flip);
+        let same = std::panic::catch_unwind(|| assert_same_path(&want, &got, TOL, "probe"));
+        assert!(same.is_err(), "inverted {letters:?}: the untranslated program must not pass the reader");
+    }
+}
diff --git a/crates/app/tests/inverted_post.rs b/crates/app/tests/inverted_post.rs
new file mode 100644
index 00000000..933dcc3b
--- /dev/null
+++ b/crates/app/tests/inverted_post.rs
@@ -0,0 +1,260 @@
+//! Posting for a machine with an inverted axis (#374): conformance
+//! goldens for an inverted-X Fanuc and Haas program (lines, G2/G3 in
+//! G17/G18/G19, I/J/K, G41/G42, a drilled hole, a work-offset origin);
+//! every refusal by name; and a standard machine untouched.
+//!
+//! Regenerate after an intentional change:
+//! `WRITE_GOLDEN=1 cargo test -p camcraft-app --test inverted_post`
+//!
+//! Gate map (M4.4): covers post::invert, post::engine, post::machine, machine::direction, assets/posts.
+
+mod inverted_support;
+
+use camcraft_app::cl::{ArcPlane, MoveKind};
+use camcraft_app::machine::{AxisDirection, AxisLimits, Machine};
+use camcraft_app::post::cnc::{self, Record};
+use camcraft_app::post::{engine, invert, probe_rec};
+use inverted_support::{arc, cps, machine, mv, probe_records, probe_stream, read, repo};
+use serde_json::json;
+
+#[test]
+fn inverted_x_goldens_for_fanuc_and_haas() {
+    let write = std::env::var_os("WRITE_GOLDEN").is_some();
+    for stem in ["fanuc", "haas"] {
+        let out =
+            engine::run(&cps(stem), &machine(&["X"]), &probe_stream()).unwrap_or_else(|e| panic!("{stem}: {e}"));
+        assert!(out.warnings.is_empty(), "{stem}: {:?}", out.warnings);
+        let rel = format!("crates/app/tests/golden/nc/inverted/{stem}_x.nc");
+        if write {
+            let path = repo(&rel);
+            std::fs::create_dir_all(path.parent().expect("dir")).expect("golden dir");
+            std::fs::write(&path, &out.program).expect("write golden");
+            continue;
+        }
+        assert_eq!(out.program, read(&rel), "{rel} is stale; regenerate with WRITE_GOLDEN=1");
+    }
+}
+
+#[test]
+fn the_inverted_x_golden_carries_the_translated_words() {
+    let out = engine::run(&cps("fanuc"), &machine(&["X"]), &probe_stream()).expect("posts");
+    let std = engine::run(&cps("fanuc"), &machine(&[]), &probe_stream()).expect("posts");
+    let (s, p) = (&std.program, &out.program);
+    let both = |a: &str, b: &str| {
+        assert!(s.contains(a), "standard lacks {a}:\n{s}");
+        assert!(p.contains(b), "inverted lacks {b}:\n{p}");
+    };
+    // X 50 - origin 10 = 40 in the program; the inverted controller reads -40.
+    both("G01 X40 Y10 Z-1 F600", "G01 X-40 Y10 Z-1 F600");
+    // G17: the CCW quarter becomes a G02; I stays 0 (it is an X increment).
+    both("G03 X50 Y20 Z-1 I0 J10", "G02 X-50 Y20 Z-1 I0 J10");
+    // G18 holds X: the sense reverses and I flips sign.
+    both("G18 G03 X25 Y30 Z4 I-5 K0", "G18 G02 X-25 Y30 Z4 I5 K0");
+    // G19 holds no X: its sense and J/K are unchanged.
+    both("G19 G02 X25 Y25 Z-1 J-5 K0", "G19 G02 X-25 Y25 Z-1 J-5 K0");
+    // Left compensation is right in the mirrored controller frame.
+    both("G17 G03 X25 Y15 Z-1 I0 J-5", "G17 G02 X-25 Y15 Z-1 I0 J-5");
+    both("G01 G41 X25 Y10", "G01 G42 X-25 Y10");
+    // The hole.
+    both("G81 X60 Y0", "G81 X-60 Y0");
+}
+
+#[test]
+fn a_standard_machine_posts_byte_identical() {
+    for stem in ["fanuc", "haas"] {
+        let a = engine::run(&cps(stem), &machine(&[]), &probe_stream()).expect("posts");
+        let mut no_key = machine(&[]);
+        if let Some(o) = no_key.as_object_mut() {
+            o.insert("invertedAxes".into(), json!([]));
+        }
+        let b = engine::run(&cps(stem), &no_key, &probe_stream()).expect("posts");
+        assert_eq!(a.program, b.program, "{stem}: an empty inverted list is a standard machine");
+    }
+    let records = probe_records();
+    assert_eq!(invert::translate(records.clone(), invert::Flip::default()), Ok(records));
+}
+
+#[test]
+fn the_mirror_states_the_inverted_axes_only_when_there_are_any() {
+    let axis = |n: &str, d| AxisLimits { name: n.into(), direction: d, ..Default::default() };
+    let mut m = Machine {
+        model: "Flip 1".into(),
+        axes: vec![
+            axis("X", AxisDirection::Standard),
+            axis("Y", AxisDirection::Standard),
+            axis("Z", AxisDirection::Standard),
+        ],
+        ..Default::default()
+    };
+    assert!(camcraft_app::post::machine::mirror(&m).get("invertedAxes").is_none());
+    m.axes[1].direction = AxisDirection::Inverted;
+    assert_eq!(camcraft_app::post::machine::mirror(&m)["invertedAxes"], json!(["Y"]));
+}
+
+#[test]
+fn the_stock_box_and_origin_mirror() {
+    let f = invert::Flip { x: true, y: false, z: false };
+    let out = invert::translate(probe_records(), f).expect("translates");
+    let get = |k: &str| {
+        out.iter()
+            .find_map(|r| match r {
+                Record::Param { name, value } if name == k => value.as_f64(),
+                _ => None,
+            })
+            .unwrap_or(f64::NAN)
+    };
+    assert_eq!((get("StockXYLeft"), get("StockXYRight")), (-80.0, 0.0), "the box's edges swap as they flip");
+    assert_eq!((get("StockXYFront"), get("StockXYBack")), (0.0, 60.0), "a standard Y is untouched");
+    assert_eq!((get("OriginX"), get("OriginY")), (-10.0, 20.0), "the work-offset origin follows the sign rule");
+}
+
+// ---------------------------------------------------------------- refusals
+
+fn refused(stem: &str, letters: &[&str], records: &[Record]) -> String {
+    match engine::run(&cps(stem), &machine(letters), &cnc::serialize(records)) {
+        Ok(out) => panic!("must refuse, posted:\n{}", out.program),
+        Err(e) => e.to_string(),
+    }
+}
+
+fn with(extra: Vec<Record>) -> Vec<Record> {
+    let mut r = vec![
+        Record::Param { name: "OperationName".into(), value: json!("Op1") },
+        Record::Section { begin: true },
+        mv(MoveKind::Rapid, [10.0, 10.0, 5.0], None),
+    ];
+    r.extend(extra);
+    r.push(Record::Section { begin: false });
+    r
+}
+
+#[test]
+fn a_helical_arc_refuses_by_name() {
+    let e = refused("fanuc", &["X"], &with(vec![arc([20.0, 10.0, 2.0], (15.0, 10.0), true, ArcPlane::Xy)]));
+    assert_eq!(
+        e,
+        "machine VMC 3-AXIS has an inverted X axis: operation Op1: a helical arc is not supported for an inverted axis yet"
+    );
+}
+
+#[test]
+fn a_tilted_move_refuses_by_name() {
+    let mut m = mv(MoveKind::Feed, [20.0, 10.0, 5.0], Some(100.0));
+    if let Record::Move(r) = &mut m {
+        r.abc = Some([0.0, 30.0, 0.0]);
+    }
+    let e = refused("fanuc", &["Y"], &with(vec![m]));
+    assert!(e.contains("inverted Y axis: operation Op1: a tilted (A/B/C rotary) move is not supported"), "{e}");
+}
+
+#[test]
+fn live_tooling_refuses_by_name() {
+    let e = refused("fanuc", &["X"], &with(vec![Record::Param { name: "LiveTool".into(), value: json!("radial") }]));
+    assert!(e.contains("C-axis live tooling (polar / G12.1 work) is not supported for an inverted axis"), "{e}");
