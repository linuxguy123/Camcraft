+fn serve_bytes(input: &[u8]) -> Vec<Value> {
+    let mut out = Vec::new();
+    mcp::serve(input, &mut out).expect("serve");
+    let text = String::from_utf8(out).expect("utf8");
+    text.lines().map(|l| serde_json::from_str(l).expect("one JSON object per line")).collect()
+}
