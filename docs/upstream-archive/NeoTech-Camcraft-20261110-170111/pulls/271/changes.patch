@@ -0,0 +1,145 @@
+//! The lathe control point at post time (#630): which operations post
+//! a nose-centre path, which nose contacts their cut needs, whether the
+//! tool's orientation can present them, and the converted path.
+//!
+//! The toolpath the generator caches stays the nose-centre truth - the
+//! verifier, the stock sim and the gouge laws judge it unchanged. Only
+//! the stream handed to the post is converted, here, once, for every
+//! lathe script: [`crate::post::nose_tip`] does the geometry.
+//!
+//! The contacts per operation family (the module law of
+//! `camcraft_tools::orientation`): an outside turn rides diameters
+//! from the -X side of the nose; facing cuts the free-end face from
+//! its -Z side and runs inward, leading with -X; boring rides the
+//! hole wall from the +X side. An orientation whose nose cannot
+//! present every contact is refused by name, listing the ones that
+//! fit - never posted as a cut that rubs or a tip touched off on the
+//! wrong corner. Threading and form gauges are not nose-centre paths
+//! (a V, a crown) and are posted as they always were.
+//!
+//! Grooving and parting (#641): the blade kernels' CL is the middle of
+//! the tip edge, and a blade is touched off on a CORNER of it
+//! (LinuxCNC Lathe User Information 4.2). The posted path is the CL
+//! moved along Z by half the blade's width toward the corner its
+//! orientation names (`orientation::blade_corner`; the tip line is
+//! already the CL's radius, so X does not move). A code that states no
+//! OD blade is refused by name.
+//!
+//! Provenance: LinuxCNC Lathe User Information (control point and
+//! tool orientation, public docs); behaviour of PathPilot's own
+//! orientation refusal, read as a syntax/behaviour reference only.
+//! Our own design otherwise.
+
+use std::borrow::Cow;
+
+use crate::cl::Toolpath;
+use crate::operation::OpParams;
+use crate::orientation::{self, Contact};
+use crate::tools::{Tool, ToolKind};
+
+/// The nose contacts an operation's cut needs, or None when the
+/// operation does not post a nose-centre path at all.
+#[must_use]
+pub fn nose_contacts(params: &OpParams, tool: &Tool) -> Option<&'static [Contact]> {
+    if !matches!(tool.kind, ToolKind::Turning | ToolKind::Bore) {
+        return None;
+    }
+    match params {
+        OpParams::Facing { .. } => Some(&[Contact::MinusZ, Contact::MinusX]),
+        OpParams::ProfileRough { .. }
+        | OpParams::ProfileFinish { .. }
+        | OpParams::Chamfering { .. }
+        | OpParams::TaperTurning { .. }
+        | OpParams::MultiPassTurning { .. } => Some(&[Contact::MinusX]),
+        OpParams::BoringTurning { .. } => Some(&[Contact::PlusX]),
+        _ => None,
+    }
+}
+
+/// The orientation `tool` posts `params` with, or a refusal by name
+/// when its nose cannot present the cut's contacts. Ok(None) for an
+/// operation that posts no nose centre.
+pub fn checked_orientation(params: &OpParams, tool_name: &str, tool: &Tool) -> Result<Option<u8>, String> {
+    let Some(need) = nose_contacts(params, tool) else { return Ok(None) };
+    let Some(q) = tool.lathe_orientation().filter(|q| orientation::is_valid(*q)) else {
+        return Err(format!("tool '{tool_name}' states no lathe orientation (1-9) - set it in the tool editor"));
+    };
+    if need.iter().all(|c| orientation::covers(q, *c)) {
+        return Ok(Some(q));
+    }
+    let needs: Vec<String> = need.iter().map(ToString::to_string).collect();
+    let fit: Vec<String> = orientation::fitting(need).iter().map(ToString::to_string).collect();
+    Err(format!(
+        "a {} cut needs the {} nose contact{}, which call for orientation [{}]; tool '{tool_name}' is orientation {q} - \
+         set the tool's orientation to match how it is mounted, or pick a tool that is",
+        params.kind(),
+        needs.join(" and "),
+        if need.len() > 1 { "s" } else { "" },
+        fit.join(", "),
+    ))
+}
+
+/// Whether `params` posts a blade's tip edge (#641): grooving and
+/// parting, cut with a grooving blade.
+#[must_use]
+pub fn is_blade_cut(params: &OpParams, tool: &Tool) -> bool {
+    tool.kind == ToolKind::Groove
+        && matches!(params, OpParams::GrooveRough { .. } | OpParams::GrooveFinish { .. } | OpParams::Part { .. })
+}
+
+/// The blade's touched-off corner as (orientation, Z shift in mm from
+/// the middle of the tip edge), or a refusal by name when the code
+/// states no OD blade or the width is no width. Ok(None) for a cut
+/// that is not a blade's.
+pub fn checked_blade_corner(params: &OpParams, tool_name: &str, tool: &Tool) -> Result<Option<(u8, f64)>, String> {
+    if !is_blade_cut(params, tool) {
+        return Ok(None);
+    }
+    let Some(q) = tool.lathe_orientation() else {
+        return Err(format!("blade '{tool_name}' states no touched-off corner - set its lathe orientation in the tool editor"));
+    };
+    let Some(side) = orientation::blade_corner(q) else {
+        let fit: Vec<String> = orientation::BLADE_FITTING.iter().map(ToString::to_string).collect();
+        return Err(format!(
+            "a {} plunges an OD blade toward the axis, touched off on a corner or the centre of its tip edge, which \
+             call for orientation [{}]; blade '{tool_name}' is orientation {q} (an ID or face blade) - set the \
+             orientation to the corner it was touched off on, or pick a blade that is",
+            params.kind(),
+            fit.join(", "),
+        ));
+    };
+    let w = tool.width;
+    if !w.is_finite() || w <= 0.0 {
+        return Err(format!("blade '{tool_name}' has no usable width to find its corner by"));
+    }
+    Ok(Some((q, side * w * 0.5)))
+}
+
+/// The path the post is handed, and the orientation it was converted
+/// for: the control-point path for a nose-centre operation, the
+/// touched-off corner's path for a blade's (#641), the cached path
+/// itself for every other one.
+pub fn posted_path<'a>(
+    params: &OpParams,
+    tool_name: &str,
+    tool: &Tool,
+    path: &'a Toolpath,
+    origin: [f64; 3],
+) -> Result<(Cow<'a, Toolpath>, Option<u8>), String> {
+    if let Some((q, dz)) = checked_blade_corner(params, tool_name, tool)? {
+        let posted = crate::post::nose_tip::control_point_path(path, (0.0, dz), origin)
+            .map_err(|e| format!("the touched-off corner for orientation {q}: {e}"))?;
+        return Ok((Cow::Owned(posted), Some(q)));
+    }
+    let Some(q) = checked_orientation(params, tool_name, tool)? else {
+        return Ok((Cow::Borrowed(path), None));
+    };
+    let (ox, oz) = orientation::tip_offset(q).unwrap_or((0.0, 0.0));
+    let r = tool.nose_radius;
+    if !r.is_finite() || r < 0.0 {
+        return Err(format!("tool '{tool_name}' has no usable nose radius"));
+    }
+    let posted = crate::post::nose_tip::control_point_path(path, (r * ox, r * oz), origin)
+        .map_err(|e| format!("the control point for orientation {q}: {e}"))?;
+    Ok((Cow::Owned(posted), Some(q)))
+}
diff --git a/crates/app/src/posting_per_op.rs b/crates/app/src/posting_per_op.rs
new file mode 100644
index 00000000..a79f1a3c
--- /dev/null
+++ b/crates/app/src/posting_per_op.rs
@@ -0,0 +1,192 @@
+//! One NC file per operation (#111): the program cut into standalone
+//! programs, one per operation, so an operator can rerun or prove out
+//! a single op on its own.
+//!
+//! Provenance: our own design (issue #111, RECOMMENDED.md); the gate is
+//! `posting`'s own, and each file's shape (header, tool change, safe
+//! start, end) is the dialect's whole-program shape from the shipped
+//! `.cps` scripts - public RS-274 / ISO 6983 behaviour only, per the
+//! Clean-Room Protocol.
+//!
+//! The law: every file is judged before any is written. The program
+//! gate (freshness, tools, gouge, limits, fixtures, probe) runs once
+//! over the same op list, each op's own post must come back with no
+//! counted warning, and only then are the files written - into a
+//! scratch folder first, then moved into place. A refusal anywhere
+//! writes nothing: never a folder with ops 1 and 3 but not 2.
+
+use super::{
+    machine_value_of, op_streams, options_value, post_options, script_of, script_source, verification_report, viewer_map,
+    Posted,
+};
+use crate::post::{cnc, engine};
+use flecs_ecs::prelude::World;
+use std::path::{Path, PathBuf};
+
+/// One written program of a per-operation post.
+#[derive(Debug)]
+pub struct PostedFile {
+    /// Where it was written.
+    pub path: PathBuf,
+    /// The operation it carries (entity name).
+    pub op: String,
+    /// The program as posted, the same evidence a whole-job post gives.
+    pub posted: Posted,
+}
+
+/// Longest sanitised operation name in a file name: a file system
+/// limit is never the reason a post fails.
+const NAME_MAX: usize = 48;
+
+/// A name cut to the portable file-name characters (ASCII letters,
+/// digits, `-`, `_`; everything else becomes `_`, runs collapse, ends
+/// are trimmed). Empty after that is `fallback`.
+pub(super) fn sanitise(name: &str, fallback: &str) -> String {
+    let mut out = String::with_capacity(name.len());
+    for c in name.chars() {
+        let c = if c.is_ascii_alphanumeric() || c == '-' { c } else { '_' };
+        if c == '_' && out.ends_with('_') {
+            continue;
+        }
+        out.push(c);
+    }
+    let cut: String = out.trim_matches('_').chars().take(NAME_MAX).collect();
+    let cut = cut.trim_end_matches('_');
+    if cut.is_empty() { fallback.to_owned() } else { cut.to_owned() }
+}
+
+/// The file stem of operation `index` (1-based, program order):
+/// `<program>_<nn>_<op>`, both names sanitised, `nn` at least two
+/// digits so a folder listing sorts in program order.
+#[must_use]
+pub fn file_stem(program: &str, index: usize, op_name: &str) -> String {
+    format!("{}_{index:02}_{}", sanitise(program, "program"), sanitise(op_name, "op"))
+}
+
+/// Post every program operation into `dir` as its own standalone
+/// program, each through its own setup's post for its own setup's
+/// machine (#388). See [`post_per_op_script`].
+pub fn post_per_op(world: &World, dir: &Path, program: &str) -> Result<Vec<PostedFile>, String> {
+    // Every mount's script first: a post that cannot be read refuses
+    // before anything is judged.
+    let mounts = crate::setup_mount::program_mounts(world, true);
+    if mounts.is_empty() {
+        script_source(world)?;
+    }
+    let mut scripts: Vec<(Vec<String>, String)> = Vec::with_capacity(mounts.len());
+    for m in mounts {
+        let text = script_of(&m.post)?.1;
+        scripts.push((m.setups, text));
+    }
+    post_per_op_with(world, dir, program, |setup| {
+        scripts.iter().find(|(s, _)| s.contains(&setup.to_owned())).map(|(_, t)| t.clone())
+    })
+}
+
+/// [`post_per_op`] at a given script. Suppressed ops write no file
+/// (`program_ops` leaves them out). Each op's stream posts alone, as
+/// program number 1, 2, 3... (the O-word a numbering dialect writes),
+/// so each file opens with the header and units, calls its own tool,
+/// states its work offset, spindle and coolant, and ends with the
+/// dialect's spindle stop, coolant off, home and program end.
+pub fn post_per_op_script(
+    world: &World,
+    dir: &Path,
+    program: &str,
+    cps: &str,
+) -> Result<Vec<PostedFile>, String> {
+    post_per_op_with(world, dir, program, |_| Some(cps.to_owned()))
+}
+
+/// The per-op post with each op's script chosen by its effective setup
+/// name (`""` for the implicit setup); the machine is always the op's
+/// own setup's (#388).
+fn post_per_op_with(
+    world: &World,
+    dir: &Path,
+    program: &str,
+    script: impl Fn(&str) -> Option<String>,
+) -> Result<Vec<PostedFile>, String> {
+    if !dir.is_dir() {
+        return Err(format!("{} is not a folder", dir.display()));
+    }
+    let streams = op_streams(world)?;
+    let report = verification_report(world);
+    if !report.problems.is_empty() {
+        return Err(format!("post blocked - {}", report.problems.join("; ")));
+    }
+    let options = options_value(post_options(world));
+    let mut files = Vec::with_capacity(streams.len());
+    for (k, (name, records)) in streams.iter().enumerate() {
+        let index = k + 1;
+        let number = u32::try_from(index).map_err(|_| "too many operations to number".to_owned())?;
+        let setup = crate::model::find_by_name(world, name)
+            .and_then(|e| crate::model::operation_of(world, &e))
+            .and_then(|op| op.setup);
+        let effective = crate::setup::effective(world, setup.as_deref()).unwrap_or_default();
+        let cps = script(&effective).ok_or_else(|| format!("{name}: no post resolved for its setup"))?;
+        let ext = engine::extension_of(&cps).map_err(|e| format!("post engine: {e}"))?;
+        let ext = sanitise(&ext, "nc");
+        let mch = machine_value_of(world, setup.as_deref());
+        let out = engine::run_numbered_with(&cps, &mch, &cnc::serialize(records), &options, number)
+            .map_err(|e| format!("{name}: post engine: {e}"))?;
+        if !out.warnings.is_empty() {
+            return Err(format!(
+                "post blocked - {name}: {} warning(s): {}",
+                out.warnings.len(),
+                out.warnings.join("; ")
+            ));
+        }
+        let line_pos = viewer_map(records, &out);
+        files.push(PostedFile {
+            path: dir.join(format!("{}.{ext}", file_stem(program, index, name))),
+            op: name.clone(),
+            posted: Posted {
+                ops: 1,
+                lines: out.program.lines().count(),
+                program: out.program,
+                line_pos,
+                blocks: out.blocks,
+                not_judged: report.not_judged.clone(),
+            },
+        });
+    }
+    let texts: Vec<(&Path, &str)> = files.iter().map(|f| (f.path.as_path(), f.posted.program.as_str())).collect();
+    write_all(dir, program, &texts)?;
+    Ok(files)
+}
+
+/// Write every file or none: all into a scratch folder beside the
+/// targets, then each renamed into place. A failed rename takes back
+/// the ones already moved, so a refusal leaves no partial set.
+pub(super) fn write_all(dir: &Path, program: &str, files: &[(&Path, &str)]) -> Result<(), String> {
+    let scratch = dir.join(format!(".{}.camcraft-post-{}", sanitise(program, "program"), std::process::id()));
+    if scratch.exists() {
+        std::fs::remove_dir_all(&scratch).map_err(|e| format!("cannot clear {}: {e}", scratch.display()))?;
+    }
+    std::fs::create_dir(&scratch).map_err(|e| format!("cannot write into {}: {e}", dir.display()))?;
+    let staged = files.iter().try_for_each(|(path, text)| {
+        let name = path.file_name().ok_or_else(|| format!("{}: no file name", path.display()))?;
+        std::fs::write(scratch.join(name), text.as_bytes()).map_err(|e| format!("cannot write {}: {e}", path.display()))
+    });
+    if let Err(err) = staged {
+        let _ = std::fs::remove_dir_all(&scratch);
+        return Err(err);
+    }
+    let mut moved: Vec<&Path> = Vec::with_capacity(files.len());
+    for (path, _) in files {
+        let Some(name) = path.file_name() else { continue };
+        if let Err(e) = std::fs::rename(scratch.join(name), path) {
+            for done in &moved {
+                let _ = std::fs::remove_file(done); // never a partial set
+            }
+            let _ = std::fs::remove_dir_all(&scratch);
+            return Err(format!("cannot write {}: {e}", path.display()));
+        }
+        moved.push(path);
+    }
+    // Every file is in place: an empty scratch folder left behind is
+    // untidy, not a wrong program - never a refusal after the write.
+    let _ = std::fs::remove_dir(&scratch);
+    Ok(())
+}
