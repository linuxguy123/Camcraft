diff --git a/crates/ui/src/path_lines.rs b/crates/ui/src/path_lines.rs
new file mode 100644
index 00000000..6cd9a34d
--- /dev/null
+++ b/crates/ui/src/path_lines.rs
@@ -0,0 +1,191 @@
+//! One cached path as overlay lines, with its warned moves marked
+//! (#261): moves a verify warning names draw in the palette's gouge
+//! colour instead of their kind colour, and each folded warning's first
+//! move gets a small 3-axis cross in the same colour, so a warned plunge
+//! (whose house red sits near the gouge red) still reads as warned.
+//! Provenance: our own display choice over our own warning list; split
+//! out of `interact::toolpath_lines` (the move loop, unchanged for a
+//! path with no warnings). No vendor material consulted.
+
+use camcraft_app::cl::MoveKind;
+use camcraft_app::schema::Toolpath;
+use camcraft_app::warned_moves::{move_focus, warned_mask};
+
+use crate::egui_app::colorvision::Semantic;
+use crate::interact::{MAX_OVERLAY_VERTICES, arc_segments, chevrons, push_line};
+use crate::operations::fold_warnings_located;
+
+/// The marker cross's half-arm, in chevron arms.
+const MARK_ARMS: f64 = 1.5;
+
+/// The colour one move draws in: the gouge colour when warned, else its
+/// kind's - scaled by `dim` (unselected paths under "show all").
+#[must_use]
+pub(crate) fn move_colour(pal: &Semantic, kind: MoveKind, warned: bool, dim: f32) -> [f32; 3] {
+    let base = if warned {
+        pal.gouge
+    } else {
+        match kind {
+            MoveKind::Rapid => pal.rapid,
+            MoveKind::Feed => pal.feed,
+            MoveKind::Plunge => pal.plunge,
+        }
+    };
+    [base[0] * dim, base[1] * dim, base[2] * dim]
+}
+
+fn over_budget(out: &mut Vec<[f32; 6]>) {
+    eprintln!(
+        "overlay: the cached paths outgrew the {MAX_OVERLAY_VERTICES}-vertex \
+         display budget; the rest is truncated (the full path still posts)"
+    );
+    out.truncate(out.len() & !1);
+}
+
+/// Append `cache`'s lines to `out`. Returns false once the vertex
+/// budget is spent (the caller stops drawing further paths); the
+/// truncation is logged, never silent.
+pub(crate) fn cache_lines(out: &mut Vec<[f32; 6]>, cache: &Toolpath, pal: &Semantic, dim: f32, arm: f64) -> bool {
+    let moves = &cache.path.moves;
+    let warned = warned_mask(&cache.warnings, moves.len());
+    for (i, m) in moves.iter().enumerate() {
+        let c = move_colour(pal, m.kind, warned.get(i).copied().unwrap_or(false), dim);
+        if m.arc.is_some() {
+            // Arcs draw as chords (one law, one tolerance story) and
+            // take no chevrons: the curve itself reads as direction.
+            let cs = arc_segments(m);
+            if out.len() + 2 * cs.len() + 2 > MAX_OVERLAY_VERTICES {
+                over_budget(out);
+                return false;
+            }
+            for (a, b) in cs {
+                push_line(out, a, b, c);
+            }
+            continue;
+        }
+        if out.len() + 10 > MAX_OVERLAY_VERTICES {
+            // A pathological cache (millions of file-loaded moves)
+            // must not allocate millions of segments either.
+            over_budget(out);
+            return false;
+        }
+        push_line(out, m.from, m.to, c);
+        if m.kind == MoveKind::Feed {
+            chevrons(out, m.from, m.to, c, arm);
+        }
+    }
+    if warned.is_empty() {
+        return true;
+    }
+    let c = move_colour(pal, MoveKind::Feed, true, dim);
+    let r = arm * MARK_ARMS;
+    for at in fold_warnings_located(&cache.warnings).into_iter().filter_map(|(_, at)| at) {
+        let Some(q) = move_focus(moves, at) else { continue };
+        if out.len() + 6 > MAX_OVERLAY_VERTICES {
+            over_budget(out);
+            return false;
+        }
+        for axis in 0..3 {
+            let (mut a, mut b) = (q, q);
+            match axis {
+                0 => (a.x, b.x) = (q.x - r, q.x + r),
+                1 => (a.y, b.y) = (q.y - r, q.y + r),
+                _ => (a.z, b.z) = (q.z - r, q.z + r),
+            }
+            push_line(out, a, b, c);
+        }
+    }
+    true
+}
+
+/// Where each folded warning line of `cache` looks (#261), aligned with
+/// [`crate::operations::fold_warnings`]: the midpoint of the group's
+/// first move, `None` for a line that locates nothing or names a move
+/// past the path's end.
+#[must_use]
+pub fn warning_focus(cache: &Toolpath) -> Vec<Option<[f64; 3]>> {
+    fold_warnings_located(&cache.warnings)
+        .into_iter()
+        .map(|(_, at)| at.and_then(|i| move_focus(&cache.path.moves, i)).map(|q| [q.x, q.y, q.z]))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use camcraft_app::cl::{Move, Toolpath as ClPath};
+    use camcraft_app::geometry::Point3;
+    use camcraft_app::verify::Warning;
+
+    fn p(x: f64, y: f64, z: f64) -> Point3 {
+        Point3::new(x, y, z)
+    }
+
+    /// Rapid in, plunge, two feeds, rapid out: five moves.
+    fn path() -> ClPath {
+        let moves = vec![
+            Move::new(MoveKind::Rapid, p(0.0, 0.0, 10.0), p(0.0, 0.0, 2.0), None),
+            Move::new(MoveKind::Plunge, p(0.0, 0.0, 2.0), p(0.0, 0.0, -1.0), Some(100.0)),
+            Move::new(MoveKind::Feed, p(0.0, 0.0, -1.0), p(30.0, 0.0, -1.0), Some(500.0)),
+            Move::new(MoveKind::Feed, p(30.0, 0.0, -1.0), p(30.0, 30.0, -1.0), Some(500.0)),
+            Move::new(MoveKind::Rapid, p(30.0, 30.0, -1.0), p(30.0, 30.0, 10.0), None),
+        ];
+        ClPath { moves, ..ClPath::default() }
+    }
+
+    /// The colour of the line whose first vertex sits at `a`.
+    fn colours_at(out: &[[f32; 6]], a: Point3) -> Vec<[f32; 3]> {
+        out.as_chunks::<2>().0.iter()
+            .filter(|l| l[0][0] == a.x as f32 && l[0][1] == a.y as f32 && l[0][2] == a.z as f32)
+            .map(|l| [l[0][3], l[0][4], l[0][5]])
+            .collect()
+    }
+
+    #[test]
+    fn a_clean_path_draws_exactly_as_before() {
+        let pal = &Semantic::OFF;
+        let mut out = Vec::new();
+        assert!(cache_lines(&mut out, &Toolpath::new(path(), Vec::new()), pal, 1.0, 0.6));
+        assert!(!out.iter().any(|v| v[3..6] == pal.gouge), "no gouge colour on a clean path");
+        assert_eq!(colours_at(&out, p(30.0, 0.0, -1.0)).first(), Some(&pal.feed));
+    }
+
+    #[test]
+    fn warned_moves_wear_the_gouge_colour_and_the_first_gets_a_cross() {
+        let pal = &Semantic::OFF;
+        // Move 3 is shank-hit; 99 (past the end) must be ignored, not indexed.
+        let w = vec![Warning::ShankHit { at: 3, part: false }, Warning::Gouge { at: 99 }];
+        let mut out = Vec::new();
+        assert!(cache_lines(&mut out, &Toolpath::new(path(), w), pal, 1.0, 0.6));
+        assert_eq!(colours_at(&out, p(30.0, 0.0, -1.0)).first(), Some(&pal.gouge), "move 3 is warned");
+        assert_eq!(colours_at(&out, p(0.0, 0.0, -1.0)).first(), Some(&pal.feed), "move 2 is not");
+        assert_eq!(colours_at(&out, p(0.0, 0.0, 2.0)).first(), Some(&pal.plunge));
+        // The cross at move 3's midpoint (30, 15, -1): its X arm starts
+        // 0.9 left of it (1.5 chevron arms of 0.6).
+        let x_arm = colours_at(&out, p(30.0 - 0.9, 15.0, -1.0));
+        assert_eq!(x_arm, vec![pal.gouge], "one cross, in the gouge colour");
+    }
+
+    #[test]
+    fn each_folded_line_frames_its_first_moves_midpoint() {
+        let w = vec![
+            Warning::ShankHit { at: 3, part: false },
+            Warning::ShankHit { at: 4, part: false },
+            Warning::RapidInStock { at: 0 },
+            Warning::Gouge { at: 99 },
+            Warning::RestUnjudged { at: 2, cells: 1, claims: 1 },
+        ];
+        let f = warning_focus(&Toolpath::new(path(), w));
+        assert_eq!(f, vec![Some([30.0, 15.0, -1.0]), Some([0.0, 0.0, 6.0]), None, None]);
+    }
+
+    #[test]
+    fn the_mark_follows_the_colour_vision_palette_and_the_dim() {
+        let pal = &Semantic::RED_GREEN;
+        let w = vec![Warning::Gouge { at: 2 }];
+        let mut out = Vec::new();
+        assert!(cache_lines(&mut out, &Toolpath::new(path(), w), pal, 0.5, 0.6));
+        let g = pal.gouge;
+        assert_eq!(colours_at(&out, p(0.0, 0.0, -1.0)).first(), Some(&[g[0] * 0.5, g[1] * 0.5, g[2] * 0.5]));
+    }
+}
diff --git a/crates/ui/src/plane_pick.rs b/crates/ui/src/plane_pick.rs
new file mode 100644
index 00000000..34e0762b
--- /dev/null
+++ b/crates/ui/src/plane_pick.rs
@@ -0,0 +1,79 @@
+//! The lay-on-a-plane pick draft (#330): while a Setups page row collects
+//! a pick, a viewport Face click lands here instead of in the open
+//! operation's geometry. One flat face; a click replaces it. #554: faces
+//! only - arming sets Face mode, so a click near an edge still takes the
+//! face, and an edge that arrives anyway is refused by name (an edge
+//! cannot set a plane; edges set an axis, `crate::axis_pick`). Ephemeral
+//! view state like the boundary draft - nothing here writes the world;
+//! Apply queues the undoable `AlignPartToSetup` through
+//! `CommandKind::LayPartOnPlane`.
+//!
+//! Provenance: our own UI over plain datum-face practice; no vendor
+//! material consulted.
+
+use camcraft_app::operation::{FeatureSel, GeoSel};
+
+use crate::state::{GeoPick, State};
+
+/// The pick being collected for one setup's lay-on-a-plane.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PlanePick {
+    /// The setup the pick will align.
+    pub setup: String,
+    pub picks: Vec<GeoSel>,
+    /// Viewport clicks land here; `false` is a paused draft (#664: its
+    /// page was left) - the picks stay, shown when the page is back.
+    pub picking: bool,
+}
+
+/// Start (or restart) collecting a face for `setup`: Face mode, so a
+/// click anywhere on a face - near its edge included - takes the face.
+/// A paused draft of the same setup resumes with its pick kept (#664).
+pub fn arm(state: &mut State, setup: &str) {
+    crate::axis_pick::disarm(state); // #557: one draft collects at a time
+    match state.plane_pick.as_mut().filter(|d| d.setup == setup) {
+        Some(d) => d.picking = true,
+        None => state.plane_pick = Some(PlanePick { setup: setup.to_owned(), picks: Vec::new(), picking: true }),
+    }
+    state.geo_pick = GeoPick::Face;
+    state.status = format!("{setup}: pick a flat face to lay on the plane");
+}
+
+/// Stop collecting; the draft is dropped.
+pub fn disarm(state: &mut State) {
+    state.plane_pick = None;
+}
+
+/// Stop collecting but keep the pick (#664: the page was left).
+pub fn pause(state: &mut State) {
+    if let Some(d) = state.plane_pick.as_mut() {
+        d.picking = false;
+    }
+}
+
+/// Is a Setups page row collecting a face for the plane?
+#[must_use]
+pub fn collecting(state: &State) -> bool {
+    state.plane_pick.as_ref().is_some_and(|d| d.picking)
+}
+
+/// One viewport pick into the draft: a face replaces it; anything else
+/// is refused by name and changes nothing.
+pub fn take(state: &mut State, pick: GeoSel) {
+    let Some(draft) = state.plane_pick.as_mut().filter(|d| d.picking) else { return };
+    let setup = draft.setup.clone();
+    state.status = match pick.feature {
+        FeatureSel::Face(_) => {
+            draft.picks = vec![pick];
+            format!("{setup}: face picked for the plane")
+        }
+        FeatureSel::Chain(_) => format!(
+            "{setup}: {} of '{}' is an edge - an edge cannot set a plane; pick a flat face \
+             (edges set an axis: Axes in the plane)",
+            pick.feature, pick.entity
+        ),
+        FeatureSel::Patch(_) | FeatureSel::Vertex(_) => {
+            format!("{setup}: {} of '{}' is not a flat face - pick a flat face", pick.feature, pick.entity)
+        }
+    };
+}
diff --git a/crates/ui/src/post_file.rs b/crates/ui/src/post_file.rs
new file mode 100644
index 00000000..b606e072
--- /dev/null
+++ b/crates/ui/src/post_file.rs
@@ -0,0 +1,152 @@
+//! #258 (part 1): where the Post dialog opens and the file it proposes.
+//!
+//! The dialog used to open with no folder and `program.nc` every time,
+//! so each post meant walking back to the job's folder and renaming.
+//! It now remembers this document's last post - the G-code viewer
+//! keeps that path, and a document switch retires it - and otherwise
+//! starts beside the saved project, named after it.
+//! Provenance: our own UI law; no vendor material consulted.
+
+use std::path::{Path, PathBuf};
+
+/// The name Post proposes when the document has neither posted nor been
+/// saved.
+pub const DEFAULT_PROGRAM: &str = "program.nc";
+/// The extension every shipped post writes (each `.cps` states `nc`).
+const PROGRAM_EXT: &str = "nc";
+
+/// Where the Post dialog starts, and the file name it fills in.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PostTarget {
+    /// The folder the dialog opens in; `None` leaves it to the OS.
+    pub dir: Option<PathBuf>,
+    pub file_name: String,
+}
+
+/// The dialog's start for a document whose last successful post wrote
+/// `last_post` and whose project file is `project` (either may be
+/// unknown). The last post wins both folder and name, so posting again
+/// proposes the same file; otherwise the project's folder and
+/// `<project name>.nc`; otherwise no folder and [`DEFAULT_PROGRAM`].
+#[must_use]
+pub fn post_target(last_post: Option<&Path>, project: Option<&Path>) -> PostTarget {
+    let dir = last_post
+        .and_then(Path::parent)
+        .or_else(|| project.and_then(Path::parent))
+        .filter(|d| !d.as_os_str().is_empty())
+        .map(Path::to_path_buf);
+    let file_name = last_post
+        .and_then(Path::file_name)
+        .and_then(|n| n.to_str())
+        .map(str::to_owned)
+        .or_else(|| {
+            project
+                .and_then(Path::file_stem)
+                .and_then(|s| s.to_str())
+                .map(|stem| format!("{stem}.{PROGRAM_EXT}"))
+        })
+        .unwrap_or_else(|| DEFAULT_PROGRAM.to_owned());
+    PostTarget { dir, file_name }
+}
+
+/// [`post_target`] for `state`'s document: its last successful post
+/// (the G-code viewer's file) and its saved project file.
+#[must_use]
+pub fn for_document(state: &crate::state::State) -> PostTarget {
+    post_target(
+        state.post_view.as_ref().map(|v| v.path.as_path()),
+        state.project_path.as_deref(),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn p(s: &str) -> PathBuf {
+        PathBuf::from(s)
+    }
+
+    #[test]
+    fn a_new_unsaved_document_proposes_program_nc_and_no_folder() {
+        assert_eq!(
+            post_target(None, None),
+            PostTarget {
+                dir: None,
+                file_name: DEFAULT_PROGRAM.to_owned()
+            }
+        );
+    }
+
+    #[test]
+    fn a_saved_project_proposes_its_own_name_in_its_folder() {
+        let project = p("jobs/bracket/bracket-v2.camproj");
+        assert_eq!(
+            post_target(None, Some(&project)),
+            PostTarget {
+                dir: Some(p("jobs/bracket")),
+                file_name: "bracket-v2.nc".to_owned()
+            }
+        );
+    }
+
+    #[test]
+    fn the_last_post_sets_both_the_folder_and_the_name() {
+        let project = p("jobs/bracket/bracket-v2.camproj");
+        let last = p("shop/out/op10.nc");
+        assert_eq!(
+            post_target(Some(&last), Some(&project)),
+            PostTarget {
+                dir: Some(p("shop/out")),
+                file_name: "op10.nc".to_owned()
+            }
+        );
+        assert_eq!(
+            post_target(Some(&last), None).dir,
+            Some(p("shop/out")),
+            "an unsaved document still remembers where it posted"
+        );
+    }
+
+    #[test]
+    fn a_documents_project_file_and_last_post_feed_the_dialog() {
+        let mut state = crate::state::State::new();
+        assert_eq!(
+            for_document(&state).file_name,
+            DEFAULT_PROGRAM,
+            "a fresh document"
+        );
+        state.project_path = Some(p("jobs/bracket/bracket-v2.camproj"));
+        assert_eq!(
+            for_document(&state).file_name,
+            "bracket-v2.nc",
+            "the saved project names it"
+        );
+        state.post_view = Some(crate::state::PostView {
+            path: p("shop/out/op10.nc"),
+            program: String::new(),
+            line_pos: Vec::new(),
+            open: false,
+            line: 0,
+            blocks: Vec::new(),
+            trace: false,
+            not_judged: None,
+        });
+        assert_eq!(
+            for_document(&state),
+            PostTarget {
+                dir: Some(p("shop/out")),
+                file_name: "op10.nc".to_owned()
+            },
+            "the viewer's file is the last post, even with its window closed"
+        );
+    }
+
+    #[test]
+    fn a_bare_file_name_opens_no_folder() {
+        // A relative path with no parent (a test's `PostProgramFile`)
+        // has an empty parent: no folder rather than "".
+        assert_eq!(post_target(Some(&p("p.nc")), None).dir, None);
+        assert_eq!(post_target(None, Some(&p("job.camproj"))).dir, None);
+    }
+}
diff --git a/crates/ui/src/setup_chip_tests.rs b/crates/ui/src/setup_chip_tests.rs
new file mode 100644
index 00000000..c016cee4
--- /dev/null
+++ b/crates/ui/src/setup_chip_tests.rs
@@ -0,0 +1,122 @@
+//! #329 in the viewport: the work-offset chip on a height plane and the
+//! plane's Z both read the SHOWN operation's own setup - two setups, two
+//! program zeros, never the first setup's word on the second's op.
+//!
+//! Provenance: our own test over RS-274 work-offset semantics.
+
+use camcraft_app::commands::{AddTool, CreateOperation};
+use camcraft_app::operation::{Height, HeightReference, OpParams, SrcRef};
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+
+use crate::interact::{height_planes, overlay_labels};
+use crate::state::{CommandKind, State};
+
+const TOOL: &str = "EM-0400-2FL";
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+fn face() -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        blend_turns: false,
+        tilt: None,
+        stepover: 3.0,
+        clearance_z: Height::of(HeightReference::WorkOffset, 25.0),
+        cut_z: Height::of(HeightReference::WorkOffset, 19.5),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+/// Place the active setup's one WCS (#342).
+fn place(state: &mut State, z: f64) {
+    let k = CommandKind::SetWcs { pos: [0.0, 0.0, z], roll_deg: 0.0, pitch_deg: 0.0, yaw_deg: 0.0 };
+    run(state, k);
+}
+
+/// A box stock for the ACTIVE setup.
+fn stock(state: &mut State) {
+    let shape = StockShape::Box { dx: 40.0, dy: 40.0, dz: 20.0 };
+    run(state, CommandKind::SetStock { shape, pos: [0.0; 3], yaw_deg: 0.0 });
+}
+
+fn create_in(state: &mut State, setup: &str, name: &str) {
+    run(state, CommandKind::ActivateSetup(Some(setup.into())));
+    let op = CreateOperation::new(&state.world, name, TOOL, SrcRef::Stock, face());
+    state.history.execute(&state.world, op.expect("operation"));
+}
+
+/// Setup1 posts at G54 (origin), Setup2 picked G55 placed 2 mm low; one
+/// face op in each, every height measured from the work offset.
+fn two_setups() -> State {
+    let mut state = State::new();
+    let em = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("catalog entry");
+    state.history.execute(&state.world, AddTool::new(&state.world, TOOL, em).expect("tool"));
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    let names = camcraft_app::setup::names(&state.world);
+    assert_eq!(names, ["Setup1", "Setup2"], "two setups");
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup1".into())));
+    stock(&mut state);
+    place(&mut state, 0.0);
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup2".into())));
+    stock(&mut state);
+    place(&mut state, -2.0);
+    run(&mut state, CommandKind::SetSetupWorkOffset { setup: "Setup2".into(), slot: Some(1) });
+    create_in(&mut state, "Setup1", "F1");
+    create_in(&mut state, "Setup2", "F2");
+    // Leave the OTHER setup active, so a chip reading the active (or the
+    // first) setup instead of the op's own would show the wrong word.
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup1".into())));
+    state
+}
+
+fn show(state: &mut State, name: &str) {
+    state.op_ui.name = name.into();
+    state.op_ui.tool = TOOL.into();
+    state.op_ui.params = face();
+    run(state, CommandKind::Select(Some(name.into())));
+}
+
+fn chips(state: &State) -> Vec<String> {
+    overlay_labels(state, 800.0 / 600.0).into_iter().map(|(_, _, t)| t).collect()
+}
+
+fn clearance_z(state: &State) -> Option<f64> {
+    height_planes(state).into_iter().find(|p| p.name == "Clearance").map(|p| p.z)
+}
+
+#[test]
+fn the_chip_and_planes_read_the_shown_operations_setup() {
+    let mut state = two_setups();
+    show(&mut state, "F2");
+    let texts = chips(&state);
+    assert!(texts.iter().any(|t| t == "F2 · Clearance 23.00 (WCS G55 +25.00)"), "Setup2's word: {texts:?}");
+    assert!(!texts.iter().any(|t| t.contains("G54")), "never Setup1's word on Setup2's op: {texts:?}");
+    assert_eq!(clearance_z(&state), Some(23.0), "the plane stands on Setup2's G55");
+
+    show(&mut state, "F1");
+    let texts = chips(&state);
+    assert!(texts.iter().any(|t| t == "F1 · Clearance 25.00 (WCS G54 +25.00)"), "Setup1's word: {texts:?}");
+    assert_eq!(clearance_z(&state), Some(25.0), "the plane stands on Setup1's G54");
+
+    // Activating Setup2 changes nothing for Setup1's op: the op's own
+    // setup wins over the active one.
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup2".into())));
+    assert!(chips(&state).iter().any(|t| t.contains("(WCS G54 ")), "F1 stays at G54");
+}
+
+#[test]
+fn a_draft_name_reads_the_active_setup() {
+    let mut state = two_setups();
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup2".into())));
+    state.op_ui.name = "Draft".into();
+    assert_eq!(crate::interact::shown_setup(&state).as_deref(), Some("Setup2"), "the active setup");
+}
