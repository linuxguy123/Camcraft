diff --git a/crates/ui/src/egui_app/recent_drop.rs b/crates/ui/src/egui_app/recent_drop.rs
new file mode 100644
index 00000000..03846108
--- /dev/null
+++ b/crates/ui/src/egui_app/recent_drop.rs
@@ -0,0 +1,209 @@
+//! The recent-files drop-downs (issue #662) under the ribbon's Open
+//! (projects) and Model (models) buttons. With a recent list on hand
+//! the button opens its list - the files newest first by name (full
+//! path on hover; a gone file greyed with "(missing)" and refused by
+//! name), "Clear recent", and "Browse…" for today's file dialog. With
+//! no recents (or the feature off) the button opens the dialog straight
+//! away, exactly as before. A pick queues `OpenRecent` / `ClearRecent`
+//! / the dialog command, so the unsaved-changes prompt and the import
+//! worker are Open's and Model's own; the door itself is view state.
+//! Provenance: our own code, the hand-drawn dropdown law of the Theme
+//! and View doors (theme_drop.rs, layout/mod.rs); no HSMWorks material.
+
+use camcraft_app::recent::{RecentEntry, RecentKind};
+use egui::{Rect, Sense, Ui, Vec2};
+
+use super::panes::{Cell, Cmd, DROP_GAP};
+use super::theme::Tokens;
+use crate::actions;
+use crate::state::{CommandKind, State};
+
+/// The list's width: wider than the other doors, file names run long.
+pub(super) const RECENT_W: f32 = 300.0;
+/// The bottom rows' captions (also their AccessKit labels).
+pub(super) const CLEAR: &str = "Clear recent";
+pub(super) const BROWSE: &str = "Browse…";
+
+/// One row of a recent-files list.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum RecentRow {
+    /// A remembered file.
+    Entry(RecentEntry),
+    /// Empty this list.
+    Clear,
+    /// Today's file dialog.
+    Browse,
+}
+
+impl RecentRow {
+    /// What the row reads (and its AccessKit label).
+    pub(super) fn label(&self) -> String {
+        match self {
+            RecentRow::Entry(e) if e.missing => format!("{} (missing)", e.name),
+            RecentRow::Entry(e) => e.name.clone(),
+            RecentRow::Clear => CLEAR.to_owned(),
+            RecentRow::Browse => BROWSE.to_owned(),
+        }
+    }
+
+    fn live(&self) -> bool {
+        !matches!(self, RecentRow::Entry(e) if e.missing)
+    }
+}
+
+/// Which list a ribbon cell carries.
+pub(super) fn kind_of(c: Cmd) -> Option<RecentKind> {
+    match c {
+        Cmd::Project => Some(RecentKind::Project),
+        Cmd::Model => Some(RecentKind::Model),
+        _ => None,
+    }
+}
+
+/// The cell a list hangs under.
+fn cmd_of(kind: RecentKind) -> Cmd {
+    match kind {
+        RecentKind::Project => Cmd::Project,
+        RecentKind::Model => Cmd::Model,
+    }
+}
+
+/// The dialog the Browse row (and an empty list's button) opens.
+fn browse(state: &mut State, kind: RecentKind) {
+    match kind {
+        RecentKind::Project => actions::open_project(state),
+        RecentKind::Model => actions::open_model_dialog(state),
+    }
+}
+
+/// The Open / Model button: toggle its list when it has entries, else
+/// the dialog as before. Opening a list closes every other door.
+pub(super) fn press(state: &mut State, kind: RecentKind) {
+    if state.recent.list(kind).is_empty() {
+        state.ribbon_recent_open = None;
+        browse(state, kind);
+        return;
+    }
+    if state.ribbon_recent_open == Some(kind) {
+        state.ribbon_recent_open = None;
+        return;
+    }
+    state.ribbon_recent_open = Some(kind);
+    state.ribbon_more = None;
+    state.ribbon_mode_open = false;
+    state.ribbon_view_open = false;
+    state.ribbon_theme_open = false;
+}
+
+/// The list's rows, pure geometry in the strip's global frame (the
+/// Theme door's law): hung under the button, pulled left so the list
+/// never runs off the strip's right edge. The tests click these rects.
+pub(super) fn rows_of(
+    state: &State,
+    kind: RecentKind,
+    button: Rect,
+    strip: Rect,
+    pal: &Tokens,
+) -> Vec<(RecentRow, Rect)> {
+    let mut rows: Vec<RecentRow> = state.recent_entries(kind).into_iter().map(RecentRow::Entry).collect();
+    rows.push(RecentRow::Clear);
+    rows.push(RecentRow::Browse);
+    let left = button.left().min(strip.right() - RECENT_W).max(strip.left());
+    rows.into_iter()
+        .enumerate()
+        .map(|(k, r)| {
+            let min = egui::Pos2::new(left, button.bottom() + DROP_GAP + k as f32 * pal.row_height);
+            (r, Rect::from_min_size(min, Vec2::new(RECENT_W, pal.row_height)))
+        })
+        .collect()
+}
+
+/// Draw the open list, if any, under its button in `cells`. A list
+/// whose button or entries are gone closes itself.
+pub(super) fn draw(ui: &mut Ui, state: &mut State, pal: &Tokens, id: egui::Id, cells: &[Cell], strip: Rect) {
+    let Some(kind) = state.ribbon_recent_open else { return };
+    let button = cells.iter().find(|c| c.cmd == cmd_of(kind)).map(|c| c.rect);
+    match button {
+        Some(button) if !state.recent.list(kind).is_empty() => {
+            let rows = rows_of(state, kind, button, strip, pal);
+            show(ui, state, kind, pal, id, button, &rows);
+        }
+        _ => state.ribbon_recent_open = None,
+    }
+}
+
+/// The open list: a foreground Area of rows. A press on a row acts and
+/// closes the list; an outside press closes it.
+fn show(
+    ui: &mut Ui,
+    state: &mut State,
+    kind: RecentKind,
+    pal: &Tokens,
+    id: egui::Id,
+    button: Rect,
+    rows: &[(RecentRow, Rect)],
+) {
+    let Some(top) = rows.first().map(|(_, r)| r.min) else {
+        state.ribbon_recent_open = None;
+        return;
+    };
+    let panel = Rect::from_min_size(top, Vec2::new(RECENT_W, rows.len() as f32 * pal.row_height));
+    let mut chose: Option<RecentRow> = None;
+    egui::Area::new(id)
+        .fixed_pos(panel.min)
+        .order(egui::Order::Foreground)
+        .movable(false)
+        .show(ui.ctx(), |ui| {
+            let p = ui.painter();
+            p.rect_filled(panel, pal.radius_menu, pal.ink);
+            p.rect_stroke(panel, pal.radius_menu, egui::Stroke::new(1.0, pal.border), egui::StrokeKind::Outside);
+            for (k, (row, r)) in rows.iter().enumerate() {
+                let resp = ui.interact(*r, id.with(("recent-row", k)), Sense::click());
+                let (label, live) = (row.label(), row.live());
+                resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, live, &label));
+                if resp.hovered() && live {
+                    p.rect_filled(*r, 0.0, pal.field_hover);
+                }
+                if matches!(row, RecentRow::Clear) {
+                    p.hline(r.x_range(), r.top(), egui::Stroke::new(1.0, pal.border));
+                }
+                p.with_clip_rect(r.shrink2(Vec2::new(4.0, 0.0))).text(
+                    r.left_center() + Vec2::new(8.0, 0.0),
+                    egui::Align2::LEFT_CENTER,
+                    &label,
+                    egui::FontId::proportional(pal.font_row),
+                    if live { pal.text } else { pal.text_faint },
+                );
+                let clicked = resp.clicked();
+                if let RecentRow::Entry(e) = row {
+                    resp.on_hover_text(e.path.display().to_string());
+                }
+                if clicked {
+                    chose = Some(row.clone());
+                }
+            }
+        });
+    match chose {
+        Some(row) => {
+            state.ribbon_recent_open = None;
+            match row {
+                // Refused by name, never a crash: the file is gone.
+                RecentRow::Entry(e) if e.missing => state.status = e.refusal(kind),
+                RecentRow::Entry(e) => state.pending.push_back(CommandKind::OpenRecent(kind, e.path)),
+                RecentRow::Clear => state.pending.push_back(CommandKind::ClearRecent(kind)),
+                RecentRow::Browse => browse(state, kind),
+            }
+        }
+        None => {
+            let outside = ui.input(|i| {
+                i.pointer.button_pressed(egui::PointerButton::Primary)
+                    && i.pointer.interact_pos().is_none_or(|p| {
+                        !button.expand(DROP_GAP).contains(p) && !rows.iter().any(|(_, r)| r.contains(p))
+                    })
+            });
+            if outside {
+                state.ribbon_recent_open = None;
+            }
+        }
+    }
+}
diff --git a/crates/ui/src/egui_app/ribbon_icon_tests.rs b/crates/ui/src/egui_app/ribbon_icon_tests.rs
new file mode 100644
index 00000000..2b0c7719
--- /dev/null
+++ b/crates/ui/src/egui_app/ribbon_icon_tests.rs
@@ -0,0 +1,46 @@
+//! Issue #207: on a fresh install (no pins) every ribbon cell wore its
+//! glyph except the operation-section doors and the machine door, so the
+//! whole Create run read as text - "missing icons" on Windows and Fedora.
+//! Every cell of every workspace's ribbon now names a glyph, except the
+//! View and Theme doors (lists captioned by their own words).
+//! Provenance: our own tests over our own ribbon.
+
+use super::panes::{Cmd, icon_of, ribbon_plan};
+use crate::state::{CommandKind, State};
+
+#[test]
+fn every_ribbon_cell_of_every_workspace_wears_a_glyph() {
+    for (kind, machine) in [
+        (camcraft_app::machine::Kind::Mill, "VMC 3-axis"),
+        (camcraft_app::machine::Kind::Lathe, "Lathe"),
+        (camcraft_app::machine::Kind::MillTurn, "Mill-turn"),
+    ] {
+        let mut state = State::new();
+        state.pending.push_back(CommandKind::LoadBuiltinMachine(machine.into()));
+        state.drain_actions();
+        assert_eq!(camcraft_app::machine::kind_of(&state.world), kind, "{machine} mounted");
+        for group in ribbon_plan(kind, &[]) {
+            for cell in group.cells {
+                if matches!(cell, Cmd::View | Cmd::Theme) {
+                    continue;
+                }
+                assert!(
+                    icon_of(cell, &state).is_some(),
+                    "{machine}: the {:?} cell in '{}' has no glyph",
+                    cell,
+                    group.title
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn the_machine_door_wears_its_workspace() {
+    let mut state = State::new();
+    let mill = icon_of(Cmd::Machine, &state);
+    state.pending.push_back(CommandKind::LoadBuiltinMachine("Lathe".into()));
+    state.drain_actions();
+    let lathe = icon_of(Cmd::Machine, &state);
+    assert!(mill.is_some() && lathe.is_some() && mill != lathe, "{mill:?} / {lathe:?}");
+}
diff --git a/crates/ui/src/egui_app/setup_align_pick.rs b/crates/ui/src/egui_app/setup_align_pick.rs
new file mode 100644
index 00000000..5c42f82c
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_align_pick.rs
@@ -0,0 +1,64 @@
+//! The Setups page's part-alignment control (#326): how the part sits on
+//! the table in one setup - flipped, turned, or as modelled - by a quick
+//! choice or by typed angles. Every change queues the undoable
+//! `AlignPartToSetup` (through `CommandKind::AlignPart`); nothing here
+//! writes the world. The work offset is a separate row (its own picker).
+//!
+//! Provenance: our own UI over plain shop practice (re-clamping a part
+//! face-down or turned); no vendor material consulted.
+
+use egui::{ComboBox, DragValue, Ui};
+
+use camcraft_app::setup_align::{self, AlignPreset};
+
+use crate::state::{CommandKind, State};
+
+/// The words and angles for a stored alignment live in the app (the
+/// setup sheet prints the same words); the page reads them from there.
+pub(crate) use camcraft_app::setup_align::{angles_of, describe as align_text};
+
+/// One setup row's control: the quick-choice combo, then the typed angles
+/// with an Apply button.
+pub(super) fn picker(ui: &mut Ui, state: &mut State, setup: &str) {
+    let current = setup_align::stored(&state.world, setup);
+    let mut queued: Option<[f64; 3]> = None;
+    ui.horizontal(|ui| {
+        ui.label("    Part alignment");
+        ComboBox::from_id_salt(("setup_align", setup))
+            .selected_text(align_text(current))
+            .show_ui(ui, |ui| {
+                for p in AlignPreset::ALL {
+                    let held = align_text(current) == p.label();
+                    if ui.selectable_label(held, p.label()).clicked() && !held {
+                        queued = Some(p.angles());
+                    }
+                }
+            })
+            .response
+            .on_hover_text(
+                "How the part sits on the table in this setup. The stock follows and is \
+                 rebuilt square to the table; the work offset is set separately below.",
+            );
+    });
+    let id = ui.id().with(("setup_align_draft", setup));
+    let mut draft: [f64; 3] = ui.data_mut(|d| *d.get_temp_mut_or_insert_with(id, || angles_of(current)));
+    ui.horizontal(|ui| {
+        ui.label("      Turn");
+        for (axis, v) in ["X", "Y", "Z"].into_iter().zip(draft.iter_mut()) {
+            ui.label(axis);
+            ui.add(DragValue::new(v).speed(1.0).range(-360.0..=360.0).suffix("°"));
+        }
+        if ui
+            .button("Apply")
+            .on_hover_text("Turn the part about X, then Y, then Z, about the centre of its bounds.")
+            .clicked()
+        {
+            queued = Some(draft);
+        }
+    });
+    if let Some(angles) = queued {
+        draft = angles;
+        state.pending.push_back(CommandKind::AlignPart { setup: setup.to_owned(), angles });
+    }
+    ui.data_mut(|d| d.insert_temp(id, draft));
+}
diff --git a/crates/ui/src/egui_app/setup_align_tests.rs b/crates/ui/src/egui_app/setup_align_tests.rs
new file mode 100644
index 00000000..76846c3d
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_align_tests.rs
@@ -0,0 +1,168 @@
+//! #326 in the surface: the Setups page's part-alignment control queues
+//! `AlignPart` (never a world poke), the drain lands it as one undo unit,
+//! Ctrl+Z / Ctrl+Y walk it, the typed angles reach the same command, and
+//! a refused choice pushes nothing. The work offset is not touched.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::accesskit::Role;
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::Queryable;
+use egui_kittest::Harness;
+
+use camcraft_app::commands::ImportModel;
+use camcraft_app::geometry::{Point3, cube, transform_point};
+use camcraft_app::setup_align::{self, AlignPreset};
+
+use crate::state::{CommandKind, State};
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+fn with_part() -> State {
+    let mut state = State::new();
+    let part = ImportModel::from_mesh("part", cube(Point3::new(-20.0, -10.0, 0.0), Point3::new(20.0, 10.0, 8.0)));
+    state.history.execute(&state.world, part);
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    state
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_align_pick::picker(ui, st, "Setup1");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+fn held(state: &State) -> String {
+    super::align_text(setup_align::stored(&state.world, "Setup1"))
+}
+
+#[test]
+fn the_alignment_control_turns_the_part_through_the_command() {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(600.0, 400.0))
+        .build_ui_state(frame, with_part());
+    h.run();
+    assert_eq!(held(h.state()), "As modelled");
+    assert!(h.state().pending.is_empty(), "drawing the control queues nothing");
+    h.get_by(|n| n.role() == Role::ComboBox && n.value().as_deref() == Some("As modelled")).click();
+    h.run();
+    h.get_by_label("Flip over X").click();
+    h.run();
+    assert_eq!(held(h.state()), "Flip over X", "the drain lands the flip");
+    assert_eq!(h.state().status, "Setup1 part alignment: Flip over X");
+    assert_eq!(camcraft_app::setup::work_offset(&h.state().world, "Setup1"), None, "the work offset is untouched");
+    key(&mut h, Key::Z);
+    assert_eq!(held(h.state()), "As modelled", "undo restores as modelled");
+    key(&mut h, Key::Y);
+    assert_eq!(held(h.state()), "Flip over X", "redo restores the flip");
+}
+
+#[test]
+fn typed_angles_reach_the_same_command_and_a_refusal_says_why() {
+    let mut state = with_part();
+    run(&mut state, CommandKind::AlignPart { setup: "Setup1".into(), angles: [0.0, 0.0, 90.0] });
+    assert_eq!(held(&state), AlignPreset::TurnZ90.label());
+    run(&mut state, CommandKind::AlignPart { setup: "Setup1".into(), angles: [30.0, 0.0, 0.0] });
+    assert_eq!(held(&state), "turned X 30°, Y 0°, Z 0°");
+    run(&mut state, CommandKind::AlignPart { setup: "Setup1".into(), angles: [30.0, 0.0, 0.0] });
+    assert!(state.status.contains("part alignment not changed"), "{}", state.status);
+    run(&mut state, CommandKind::AlignPart { setup: "Setup1".into(), angles: [f64::NAN, 0.0, 0.0] });
+    assert!(state.status.contains("finite"), "{}", state.status);
+    // Two turns landed, the refusals pushed nothing.
+    run(&mut state, CommandKind::Undo);
+    run(&mut state, CommandKind::Undo);
+    assert_eq!(held(&state), "As modelled");
+}
+
+/// The anchors of the active setup's "model bounds" box, at the bottom
+/// level: (SW, NE, C) points.
+fn model_anchors(state: &mut State) -> [[f64; 3]; 3] {
+    state.wcs_ui.anchor_source = 1;
+    state.wcs_ui.anchor_z = 0;
+    assert_eq!(crate::interact::anchor_reference(state).map(|(_, w)| w), Some("model bounds"));
+    let pts = crate::interact::anchor_points(state);
+    assert_eq!((pts[6].1, pts[2].1, pts[4].1), ("SW", "NE", "C"));
+    [pts[6].0, pts[2].0, pts[4].0]
+}
+
+/// The part's own eight corners carried through the stored alignment by
+/// plain transform math, boxed: what the operator sees on the table.
+fn aligned_corner_box(state: &State) -> ([f64; 3], [f64; 3]) {
+    let a = setup_align::stored(&state.world, "Setup1").unwrap_or_default();
+    let mut lo = [f64::MAX; 3];
+    let mut hi = [f64::MIN; 3];
+    for x in [-20.0, 20.0] {
+        for y in [-10.0, 10.0] {
+            for z in [0.0, 8.0] {
+                let p = transform_point(Point3::new(x, y, z), a.pos, a.rot);
+                for (i, v) in [p.x, p.y, p.z].into_iter().enumerate() {
+                    lo[i] = lo[i].min(v);
+                    hi[i] = hi[i].max(v);
+                }
+            }
+        }
+    }
+    (lo, hi)
+}
+
+fn near(a: [f64; 3], b: [f64; 3]) -> bool {
+    a.iter().zip(b).all(|(x, y)| (x - y).abs() < 1e-9)
+}
+
+/// Review of PR #341: the work-offset anchors read the part in the active
+/// setup's frame, so an aligned part's corner is the corner on the table,
+/// and a G54 placed on it lands there. An untouched setup is unchanged.
+#[test]
+fn model_bounds_anchors_follow_the_aligned_part() {
+    let mut state = with_part();
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup1"));
+    // As modelled: the 40 x 20 x 8 part's own corners, as before #326.
+    let plain = model_anchors(&mut state);
+    assert!(near(plain[0], [-20.0, -10.0, 0.0]) && near(plain[1], [20.0, 10.0, 0.0]), "{plain:?}");
+    assert!(near(plain[2], [0.0, 0.0, 0.0]), "{plain:?}");
+
+    // Flipped over X about its centre: the box keeps its footprint.
+    run(&mut state, CommandKind::AlignPart { setup: "Setup1".into(), angles: [180.0, 0.0, 0.0] });
+    let flipped = model_anchors(&mut state);
+    let (lo, hi) = aligned_corner_box(&state);
+    assert!(near(flipped[0], [lo[0], lo[1], lo[2]]) && near(flipped[1], [hi[0], hi[1], lo[2]]), "{flipped:?}");
+    assert!(near(flipped[0], [-20.0, -10.0, 0.0]), "{flipped:?}");
+
+    // Flipped AND quarter-turned: the part now runs 20 along X, 40 along Y.
+    for angles in [[0.0, 0.0, 90.0], [180.0, 0.0, 90.0]] {
+        run(&mut state, CommandKind::AlignPart { setup: "Setup1".into(), angles });
+        let turned = model_anchors(&mut state);
+        let (lo, hi) = aligned_corner_box(&state);
+        assert!(near(turned[0], [lo[0], lo[1], lo[2]]), "{angles:?} SW {turned:?} vs {lo:?}");
+        assert!(near(turned[1], [hi[0], hi[1], lo[2]]), "{angles:?} NE {turned:?} vs {hi:?}");
+        assert!(near(turned[0], [-10.0, -20.0, 0.0]), "{angles:?} SW pinned: {turned:?}");
+        assert!(near(turned[1], [10.0, 20.0, 0.0]), "{angles:?} NE pinned: {turned:?}");
+        assert!(near(turned[2], [0.0, 0.0, 0.0]), "{angles:?} C pinned: {turned:?}");
+    }
+
+    // A G54 placed on the SW corner lands on the turned part's corner.
+    let sw = model_anchors(&mut state)[0];
+    run(&mut state, CommandKind::SetWcs { pos: sw, roll_deg: 0.0, pitch_deg: 0.0, yaw_deg: 0.0 });
+    let g54 = camcraft_app::setup::wcs_entity(&state.world, Some("Setup1"))
+        .and_then(|e| camcraft_app::model::transform_of(&state.world, &e))
+        .map(|l| [l.pos.x, l.pos.y, l.pos.z]);
+    assert!(g54.is_some_and(|p| near(p, [-10.0, -20.0, 0.0])), "G54 at {g54:?}");
+
+    // Back to as modelled: the anchors are the untouched ones again.
+    run(&mut state, CommandKind::AlignPart { setup: "Setup1".into(), angles: [0.0, 0.0, 0.0] });
+    assert_eq!(model_anchors(&mut state), plain);
+}
diff --git a/crates/ui/src/egui_app/setup_axis_pick.rs b/crates/ui/src/egui_app/setup_axis_pick.rs
new file mode 100644
index 00000000..bee14331
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_axis_pick.rs
@@ -0,0 +1,142 @@
+//! The Setups page's "Axes in the plane" rows (#557): set the part's +Y
+//! and/or +X in the work plane from a straight edge or two points picked
+//! in the viewport, flip either, choose which one wins when both are
+//! picked, and Apply. The pick draft is view state (`crate::axis_pick`);
+//! Apply queues `CommandKind::TurnPartInPlane`, the undoable
+//! `AlignPartToSetup`. The app says whether the picks make a turn and,
+//! if not, why - shown on the disabled Apply. The work offset is not
+//! touched.
+//!
+//! Provenance: our own UI over plain fixture practice (indicate an edge
+//! along the table's travel); no vendor material consulted.
+
+use egui::{RichText, Ui};
+
+use camcraft_app::commands::AlignPartToSetup;
+use camcraft_app::pick::{self, InPlaneAxis};
+
+use crate::axis_pick::{self, AxisBy};
+use crate::state::{CommandKind, State};
+
+/// The rows of one setup.
+pub(super) fn rows(ui: &mut Ui, state: &mut State, setup: &str) {
+    state.axis_rows_shown = true;
+    if !state.setup_pick_rows.iter().any(|s| s == setup) {
+        state.setup_pick_rows.push(setup.to_owned()); // #664
+    }
+    ui.label("    Axes in the plane - pick an edge or two points for +Y and/or +X");
+    for axis in [InPlaneAxis::Y, InPlaneAxis::X] {
+        axis_row(ui, state, setup, axis);
+    }
+    let Some(d) = state.axis_pick.as_ref().filter(|d| d.setup == setup).cloned() else { return };
+    let axes = d.wanted();
+    if axes.y.is_none() && axes.x.is_none() {
+        return;
+    }
+    // The command's own check: a refused pick, or one that gives the
+    // alignment the setup already holds, greys Apply out with the why.
+    // Just applied, the same picks are a zero turn: say Flip re-applies
+    // rather than "already holds" (#557 hand check).
+    let turn = pick::in_plane_turn_deg(&state.world, setup, &axes).ok();
+    let held = d.applied && turn.is_some_and(|deg| deg.abs() < 1e-9);
+    let check = AlignPartToSetup::check_turn(&state.world, setup, &axes).map_err(|e| {
+        if held {
+            "applied - tick Flip +Y / Flip +X and Apply again to turn the part the other way".to_owned()
+        } else {
+            e.to_string()
+        }
+    });
+    ui.horizontal(|ui| {
+        ui.label("      Primary");
+        let mut primary = d.axes.primary;
+        for axis in [InPlaneAxis::Y, InPlaneAxis::X] {
+            ui.radio_value(&mut primary, axis, axis.label())
+                .on_hover_text("With both axes picked, this one is kept exactly; the other is made square to it.");
+        }
+        if primary != d.axes.primary {
+            axis_pick::draft_for(state, setup).axes.primary = primary;
+        }
+        let tip = match &check {
+            Ok(()) => "Turn the part about Z so the picks run along their axes.".to_owned(),
+            Err(why) => why.clone(),
+        };
+        if ui
+            .add_enabled(check.is_ok(), egui::Button::new("Apply axes"))
+            .on_hover_text(&tip)
+            .on_disabled_hover_text(&tip)
+            .clicked()
+        {
+            state.pending.push_back(CommandKind::TurnPartInPlane { setup: setup.to_owned(), axes: axes.clone() });
+        }
+        if ui.button("Clear axes").on_hover_text("Drop the axis picks.").clicked() {
+            state.axis_pick = None;
+        }
+    });
+    let words = match (turn, &check) {
+        (_, Err(why)) => why.clone(),
+        (Some(deg), Ok(())) => format!("turns the part {} about Z", deg_words(deg)),
+        (None, Ok(())) => String::new(),
+    };
+    if !words.is_empty() {
+        ui.label(RichText::new(format!("      {words}")).weak());
+    }
+}
+
+fn deg_words(deg: f64) -> String {
+    let r = (deg * 1000.0).round() / 1000.0;
+    format!("{}°", if r == 0.0 { 0.0 } else { r })
+}
+
+/// One axis: what it is picked by, the pick toggle, flip, and the picks.
+fn axis_row(ui: &mut Ui, state: &mut State, setup: &str, axis: InPlaneAxis) {
+    let draft = state.axis_pick.as_ref().filter(|d| d.setup == setup);
+    let by = draft.map_or(AxisBy::Edge, |d| d.by(axis));
+    let armed = draft.is_some_and(|d| d.picking == Some(axis));
+    let slot = draft.and_then(|d| match axis {
+        InPlaneAxis::Y => d.axes.y.clone(),
+        InPlaneAxis::X => d.axes.x.clone(),
+    });
+    let picks = slot.as_ref().map(|s| s.picks.clone()).unwrap_or_default();
+    let mut flip = slot.is_some_and(|s| s.flip);
+    let name = axis.label();
+    ui.horizontal(|ui| {
+        ui.label(format!("      {name}"));
+        for (b, text) in [(AxisBy::Edge, "Edge"), (AxisBy::Points, "Two points")] {
+            if ui
+                .selectable_label(by == b, format!("{name} by {text}"))
+                .on_hover_text(format!("Set {name} from {} - picks at once.", b.noun()))
+                .clicked()
+            {
+                // Choosing a mode arms its pick (#557 hand check).
+                axis_pick::set_by(state, setup, axis, b);
+            }
+        }
+        let what = match by {
+            AxisBy::Edge => "edge",
+            AxisBy::Points => "points",
+        };
+        let text = if armed { format!("Stop picking {name}") } else { format!("Pick {name} {what}") };
+        if ui
+            .selectable_label(armed, text)
+            .on_hover_text(format!("Click {} in the viewport; it runs along {name}.", by.noun()))
+            .clicked()
+        {
+            if armed {
+                axis_pick::disarm(state);
+            } else {
+                axis_pick::arm(state, setup, axis);
+            }
+        }
+        if ui
+            .checkbox(&mut flip, format!("Flip {name}"))
+            .on_hover_text("Take the pick the other way (end to start).")
+            .changed()
+        {
+            axis_pick::draft_for(state, setup).slot(axis).flip = flip;
+        }
+    });
+    // Its own line, so it is never cut short: what and where, in the
+    // document's units, never a feature id (#557 hand check).
+    let text = crate::axis_pick::picks_text(&state.world, &picks, camcraft_app::units::of(&state.world));
+    ui.label(RichText::new(format!("        {name}: {text}")).weak());
+}
diff --git a/crates/ui/src/egui_app/setup_axis_tests.rs b/crates/ui/src/egui_app/setup_axis_tests.rs
new file mode 100644
index 00000000..5401b8f9
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_axis_tests.rs
@@ -0,0 +1,282 @@
+//! #557 in the surface: the Setups page's "Axes in the plane" rows arm
+//! the axis draft (Edge mode for an edge, Vertex mode for two points), a
+//! pick lands in the draft (never in an operation), a face is refused by
+//! name, Apply queues `TurnPartInPlane` and the drain lands it as one
+//! undo unit. The work offset is not touched.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::{NodeT, Queryable};
+use egui_kittest::Harness;
+
+use camcraft_app::commands::ImportModel;
+use camcraft_app::geometry::{Point3, cube, feature, quat_rotate_point};
+use camcraft_app::model;
+use camcraft_app::operation::{FeatureSel, GeoSel};
+use camcraft_app::pick::InPlaneAxis;
+use camcraft_app::setup_align;
+
+use crate::axis_pick::AxisBy;
+use crate::state::{CommandKind, GeoPick, State};
+
+fn with_part() -> State {
+    let mut state = State::new();
+    let part = ImportModel::from_mesh("part", cube(Point3::new(0.0, 0.0, 0.0), Point3::new(20.0, 20.0, 10.0)));
+    state.history.execute(&state.world, part);
+    state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    state.drain_actions();
+    state
+}
+
+fn features(state: &State) -> std::sync::Arc<feature::Features> {
+    let e = model::find_by_name(&state.world, "part").expect("part");
+    model::features_of(&state.world, &e).expect("features")
+}
+
+/// The top front edge (local y = 0, z = 10), and its walk direction.
+fn front_top_edge(state: &State) -> (GeoSel, [f64; 3]) {
+    let f = features(state);
+    let (id, p) = feature::chains(&f)
+        .into_iter()
+        .find_map(|c| {
+            let p = feature::chain_points(&f, &c);
+            (p.len() == 2 && p.iter().all(|q| q[1] == 0.0 && q[2] == 10.0)).then_some((c.id, p))
+        })
+        .expect("a top edge");
+    (GeoSel { entity: "part".into(), feature: FeatureSel::Chain(id) }, [p[1][0] - p[0][0], 0.0, 0.0])
+}
+
+fn corner(state: &State, p: [f64; 3]) -> GeoSel {
+    let f = features(state);
+    let id = feature::corner_verts(&f)
+        .into_iter()
+        .find(|&vi| f.verts.get(vi as usize).is_some_and(|v| *v == p))
+        .and_then(|vi| feature::vertex_id(&f, vi))
+        .expect("a corner");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Vertex(id) }
+}
+
+fn top_face(state: &State) -> GeoSel {
+    let id = features(state).faces.iter().find(|f| f.normal[2] > 0.99).map(|f| f.id).expect("the top");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Face(id) }
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_axis_pick::rows(ui, st, "Setup1");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+/// A local direction of the part as Setup1 holds it.
+fn held_dir(state: &State, d: [f64; 3]) -> Option<[f64; 3]> {
+    let a = setup_align::stored(&state.world, "Setup1")?;
+    let v = quat_rotate_point(a.rot, Point3::new(d[0], d[1], d[2]));
+    let l = (v.x * v.x + v.y * v.y + v.z * v.z).sqrt();
+    Some([v.x / l, v.y / l, v.z / l])
+}
+
+fn harness() -> Harness<'static, State> {
+    let mut h = Harness::builder().with_size(Vec2::new(1000.0, 300.0)).build_ui_state(frame, with_part());
+    h.run();
+    h
+}
+
+fn apply_disabled(h: &Harness<'static, State>) -> bool {
+    h.get_by_label("Apply axes").accesskit_node().is_disabled()
+}
+
+#[test]
+fn an_edge_picked_for_y_turns_the_part_through_the_command_and_undoes() {
+    let mut h = harness();
+    assert!(h.state().pending.is_empty(), "drawing the rows queues nothing");
+    assert!(h.query_by_label_contains("pick an edge or two points").is_some(), "the rows say which pick they take");
+    h.get_by_label("Pick +Y edge").click();
+    h.run();
+    assert!(crate::axis_pick::collecting(h.state()), "the draft is armed");
+    assert_eq!(h.state().geo_pick, GeoPick::Edge, "an axis by edge picks edges");
+    // A face sets no direction: refused by name, nothing drafted.
+    let face = top_face(h.state());
+    crate::axis_pick::take(h.state_mut(), face);
+    assert!(h.state().status.contains("a face sets no direction"), "{}", h.state().status);
+    let (edge, d) = front_top_edge(h.state());
+    crate::axis_pick::take(h.state_mut(), edge);
+    h.run();
+    assert!(h.state().op_ui.geo.is_empty(), "a draft pick is not an operation pick");
+    assert!(h.query_by_label_contains("turns the part").is_some(), "the turn is shown before Apply");
+    assert!(!apply_disabled(&h));
+    h.get_by_label("Apply axes").click();
+    h.run();
+    let v = held_dir(h.state(), d).expect("Setup1 holds the part turned");
+    assert!((v[1] - 1.0).abs() < 1e-9, "the edge runs along +Y: {v:?}");
+    let kept = h.state().axis_pick.clone().expect("the picks stay after Apply, for Flip");
+    assert!(kept.picking.is_none() && kept.applied, "a landed turn stops collecting, the picks kept");
+    assert!(apply_disabled(&h), "the same picks again are no turn");
+    assert!(h.query_by_label_contains("tick Flip").is_some(), "the greyed Apply says Flip re-applies");
+    assert!(h.state().status.contains("turned in the plane"), "{}", h.state().status);
+    assert_eq!(camcraft_app::setup::work_offset(&h.state().world, "Setup1"), None, "the work offset is untouched");
+    key(&mut h, Key::Z);
+    assert_eq!(setup_align::stored(&h.state().world, "Setup1"), None, "undo restores as modelled");
+    key(&mut h, Key::Y);
+    assert!(held_dir(h.state(), d).is_some(), "redo turns it again");
+}
+
+#[test]
+fn two_points_for_x_pick_vertices_and_flip_reverses_them() {
+    let mut h = harness();
+    h.get_by_label("+X by Two points").click();
+    h.run();
+    assert_eq!(h.state().geo_pick, GeoPick::Vertex, "two points pick vertices");
+    let (edge, _) = front_top_edge(h.state());
+    crate::axis_pick::take(h.state_mut(), edge);
+    assert!(h.state().status.contains("is an edge"), "{}", h.state().status);
+    // The front-left corner, then the back-left one: local +Y as +X.
+    let a = corner(h.state(), [0.0, 0.0, 0.0]);
+    let b = corner(h.state(), [0.0, 20.0, 0.0]);
+    crate::axis_pick::take(h.state_mut(), a);
+    crate::axis_pick::take(h.state_mut(), b);
+    h.run();
+    let d = h.state().axis_pick.clone().expect("draft");
+    assert_eq!(d.by(InPlaneAxis::X), AxisBy::Points);
+    assert_eq!(d.wanted().x.map(|p| p.picks.len()), Some(2), "two points kept");
+    h.get_by_label("Flip +X").click();
+    h.run();
+    h.get_by_label("Apply axes").click();
+    h.run();
+    let v = held_dir(h.state(), [0.0, 1.0, 0.0]).expect("turned");
+    assert!((v[0] + 1.0).abs() < 1e-9, "flipped, local +Y runs along -X: {v:?}");
+}
+
+#[test]
+fn an_upright_edge_greys_apply_out_with_the_reason() {
+    let mut h = harness();
+    h.get_by_label("Pick +Y edge").click();
+    h.run();
+    let f = features(h.state());
+    let id = feature::chains(&f)
+        .into_iter()
+        .find(|c| {
+            let p = feature::chain_points(&f, c);
+            p.len() == 2 && p[0][0] == p[1][0] && p[0][1] == p[1][1]
+        })
+        .map(|c| c.id)
+        .expect("an upright edge");
+    crate::axis_pick::take(h.state_mut(), GeoSel { entity: "part".into(), feature: FeatureSel::Chain(id) });
+    h.run();
+    assert!(apply_disabled(&h), "an upright edge sets no in-plane direction");
+    assert!(h.query_by_label_contains("along the work plane's normal").is_some(), "the reason is shown");
+    // Arming the plane row stops the axis pick: one draft collects.
+    crate::plane_pick::arm(h.state_mut(), "Setup1");
+    assert!(!crate::axis_pick::collecting(h.state()));
+}
+
+#[test]
+fn choosing_a_by_mode_arms_its_pick() {
+    let mut h = harness();
+    h.get_by_label("+Y by Two points").click();
+    h.run();
+    let d = h.state().axis_pick.clone().expect("draft");
+    assert_eq!(d.picking, Some(InPlaneAxis::Y), "choosing Two points arms +Y");
+    assert_eq!(h.state().geo_pick, GeoPick::Vertex);
+    assert!(h.query_by_label("Stop picking +Y").is_some(), "the toggle shows armed");
+    assert!(h.state().status.contains("pick two points for +Y"), "{}", h.state().status);
+    // Re-choosing the current mode (Edge is the default) arms too.
+    h.get_by_label("+X by Edge").click();
+    h.run();
+    assert_eq!(h.state().axis_pick.as_ref().and_then(|d| d.picking), Some(InPlaneAxis::X), "one axis collects");
+    assert_eq!(h.state().geo_pick, GeoPick::Edge);
+    assert!(h.query_by_label("Stop picking +X").is_some() && h.query_by_label("Pick +Y points").is_some());
+}
+
+#[test]
+fn a_stray_feature_click_with_nothing_armed_says_what_to_do() {
+    let mut h = harness();
+    assert!(h.state().axis_rows_shown, "the rows say they are on screen");
+    h.get_by_label("+X by Two points").click();
+    h.run();
+    h.get_by_label("Stop picking +X").click();
+    h.run();
+    assert!(!crate::axis_pick::collecting(h.state()));
+    assert!(crate::axis_pick::hint_stray(h.state_mut()), "a stray click is swallowed");
+    let status = h.state().status.clone();
+    assert!(status.contains("click Pick +Y edge or Pick +X points first"), "{status}");
+    assert!(!status.contains("open an operation"), "{status}");
+    // Armed, the click feeds the axis and no hint fires.
+    h.get_by_label("Pick +X points").click();
+    h.run();
+    assert!(!crate::axis_pick::hint_stray(h.state_mut()));
+}
+
+#[test]
+fn the_picked_rows_name_points_and_edges_in_document_units() {
+    let mut h = harness();
+    h.get_by_label("+X by Two points").click();
+    h.run();
+    let a = corner(h.state(), [0.0, 0.0, 0.0]);
+    crate::axis_pick::take(h.state_mut(), a);
+    h.run();
+    assert!(h.query_by_label_contains("+X: 1 of 2 points on 'part' (0.000, 0.000, 0.000) mm").is_some());
+    let b = corner(h.state(), [0.0, 20.0, 0.0]);
+    crate::axis_pick::take(h.state_mut(), b);
+    h.get_by_label("+Y by Edge").click();
+    h.run();
+    let (edge, _) = front_top_edge(h.state());
+    crate::axis_pick::take(h.state_mut(), edge);
+    h.run();
+    let label = |h: &Harness<'static, State>, head: &str| {
+        h.query_all_by_label_contains(head).find_map(|n| n.accesskit_node().label().or_else(|| n.accesskit_node().value())).unwrap_or_default()
+    };
+    let pts = label(&h, "+X: 2 points");
+    assert_eq!(pts, "        +X: 2 points on 'part' (0.000, 0.000, 0.000) -> (0.000, 20.000, 0.000) mm");
+    let e = label(&h, "+Y: edge");
+    assert!(e.contains("edge on 'part', 20.000 mm long, along ("), "{e}");
+    for t in [&pts, &e] {
+        assert!(!t.contains("0x") && !t.contains("vertex") && !t.contains("chain"), "no feature id: {t}");
+    }
+    h.state_mut().pending.push_back(CommandKind::SetUnits(camcraft_app::units::Unit::Inches));
+    h.run();
+    let pts = label(&h, "+X: 2 points");
+    assert!(pts.ends_with("(0.00000, 0.00000, 0.00000) -> (0.00000, 0.78740, 0.00000) in"), "{pts}");
+    let e = label(&h, "+Y: edge");
+    assert!(e.contains("0.78740 in long"), "{e}");
+}
+
+#[test]
+fn flip_after_apply_re_applies_as_its_own_undo_step() {
+    let mut h = harness();
+    h.get_by_label("+Y by Edge").click();
+    h.run();
+    let (edge, d) = front_top_edge(h.state());
+    crate::axis_pick::take(h.state_mut(), edge);
+    h.run();
+    h.get_by_label("Apply axes").click();
+    h.run();
+    let along = |h: &Harness<'static, State>| held_dir(h.state(), d).map(|v| v[1]);
+    assert!(along(&h).is_some_and(|y| (y - 1.0).abs() < 1e-9), "applied: the edge runs +Y");
+    assert!(apply_disabled(&h));
+    h.get_by_label("Flip +Y").click();
+    h.run();
+    assert!(!apply_disabled(&h), "Flip after Apply offers Apply again");
+    assert!(h.query_by_label_contains("turns the part 180° about Z").is_some(), "the flip is a half turn");
+    h.get_by_label("Apply axes").click();
+    h.run();
+    assert!(along(&h).is_some_and(|y| (y + 1.0).abs() < 1e-9), "flipped: the edge runs -Y");
+    key(&mut h, Key::Z);
+    assert!(along(&h).is_some_and(|y| (y - 1.0).abs() < 1e-9), "one undo takes back only the flip");
+    key(&mut h, Key::Y);
+    assert!(along(&h).is_some_and(|y| (y + 1.0).abs() < 1e-9), "redo flips it again");
+    key(&mut h, Key::Z);
+    key(&mut h, Key::Z);
+    assert_eq!(setup_align::stored(&h.state().world, "Setup1"), None, "a second undo restores as modelled");
+}
diff --git a/crates/ui/src/egui_app/setup_pages.rs b/crates/ui/src/egui_app/setup_pages.rs
new file mode 100644
index 00000000..b32e82ea
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_pages.rs
@@ -0,0 +1,230 @@
+//! A setup's own pages, opened from its browser nodes (#343): the setup's
+//! settings (active radio, stock source, part alignment, WCS label), its
+//! Machine and Post (own, or following the document's), its Fixtures and
+//! its Tool list. Every change is a queued command - `ActivateSetup`,
+//! `SetupOwnMachine` / `SetupOwnPost`, the machine and post verbs (routed
+//! to the setup's own mount, `state::setup_mount`), the fixture verbs -
+//! so undo walks each one back.
+//!
+//! The mounted machine and post are the ACTIVE setup's (the one-mount
+//! law, `camcraft_app::setup_mount`): a page of an inactive setup edits
+//! nothing until it is activated, so no click can change a setup the
+//! page does not name. (The browser activates a setup before it opens
+//! one of its nodes, so this guard only shows after a later radio click.)
+//!
+//! Provenance: our own page law (issue #343, the maintainer's per-node
+//! behaviour); no HSMWorks material consulted.
+
+use egui::{RichText, Ui};
+
+use camcraft_app::{model, setup, setup_mount, tool_numbers};
+
+use crate::state::{CommandKind, SetupPage, State};
+
+use super::pages;
+use super::panes::kind_name;
+
+/// Draw the page of `name`'s `page` node (`""` - the implicit context).
+pub(super) fn page(ui: &mut Ui, state: &mut State, name: &str, page: SetupPage) {
+    let ctx = (!name.is_empty()).then_some(name);
+    let title = ctx.unwrap_or("Setup");
+    match page {
+        SetupPage::Settings => {
+            ui.heading(title);
+            ui.separator();
+            settings(ui, state, ctx);
+        }
+        SetupPage::Machine => {
+            ui.heading(format!("Machine - {title}"));
+            ui.separator();
+            if editable(ui, state, ctx) {
+                ownership(ui, state, ctx, Mount::Machine);
+                pages::machine_section(ui, state);
+            }
+        }
+        SetupPage::Post => {
+            ui.heading(format!("Post - {title}"));
+            ui.separator();
+            if editable(ui, state, ctx) {
+                ownership(ui, state, ctx, Mount::Post);
+                pages::post_section(ui, state);
+                hint(ui, "The post options above apply to the whole document.");
+            }
+        }
+        SetupPage::Fixtures => {
+            ui.heading(format!("Fixtures - {title}"));
+            ui.separator();
+            if editable(ui, state, ctx) {
+                pages::fixtures_section(ui, state, ctx);
+            }
+        }
+        SetupPage::Tools => {
+            ui.heading(format!("Tool list - {title}"));
+            ui.separator();
+            tool_table(ui, state, ctx);
+            ui.separator();
+            pages::tool_list_section(ui, state, ctx);
+            pages::sheet_footer(ui, state);
+        }
+    }
+}
+
+fn hint(ui: &mut Ui, text: &str) {
+    ui.label(RichText::new(text).weak());
+}
+
+/// Whether `ctx` is the active setup (or the implicit one): the pages
+/// that edit the mounted steel draw their editors only then.
+fn editable(ui: &mut Ui, state: &mut State, ctx: Option<&str>) -> bool {
+    let Some(name) = ctx else {
+        return true;
+    };
+    if setup::active(&state.world).as_deref() == Some(name) {
+        return true;
+    }
+    ui.label(format!("{name} is not the active setup - activate it to edit its machine, post and fixtures."));
+    if ui.button(format!("Activate {name}")).clicked() {
+        state.pending.push_back(CommandKind::ActivateSetup(Some(name.to_owned())));
+    }
+    false
+}
+
+#[derive(Clone, Copy)]
+enum Mount {
+    Machine,
+    Post,
+}
+
+/// The own / follow-the-document choice of a setup's machine or post.
+fn ownership(ui: &mut Ui, state: &mut State, ctx: Option<&str>, which: Mount) {
+    let Some(name) = ctx else {
+        hint(ui, "A document without setups uses the document's machine and post.");
+        return;
+    };
+    let w = &state.world;
+    let (owns, doc) = match which {
+        Mount::Machine => (
+            setup_mount::own_machine(w, Some(name)).is_some(),
+            setup_mount::machine_label(&setup_mount::document_machine(w)),
+        ),
+        Mount::Post => (
+            setup_mount::own_post(w, Some(name)).is_some(),
+            camcraft_app::posting::post_ref_label(&setup_mount::document_post(w)),
+        ),
+    };
+    let word = match which {
+        Mount::Machine => "machine",
+        Mount::Post => "post",
+    };
+    let mut pick = owns;
+    ui.radio_value(&mut pick, false, format!("Use the document's {word} ({doc})"));
+    ui.radio_value(&mut pick, true, format!("This setup has its own {word}"));
+    if pick != owns {
+        let setup = name.to_owned();
+        state.pending.push_back(match which {
+            Mount::Machine => CommandKind::SetupOwnMachine { setup, own: pick },
+            Mount::Post => CommandKind::SetupOwnPost { setup, own: pick },
+        });
+    }
+    hint(ui, &format!(
+        "Setups with different {word}s post one at a time: a program is written by one post for one machine."
+    ));
+    ui.separator();
+}
+
+/// The setup's settings: which setup is active, where its stock comes
+/// from, how the part sits, and the word its WCS posts as.
+fn settings(ui: &mut Ui, state: &mut State, ctx: Option<&str>) {
+    let Some(name) = ctx else {
+        ui.label("No setups in this document: the one stock and the one WCS act as the first setup.");
+        if ui.button("Create first setup").clicked() {
+            state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+        }
+        return;
+    };
+    let is_active = setup::active(&state.world).as_deref() == Some(name);
+    if ui.radio(is_active, "Active setup - new operations and furniture join it").clicked() && !is_active {
+        state.pending.push_back(CommandKind::ActivateSetup(Some(name.to_owned())));
+    }
+    ui.separator();
+    super::setup_stock_pick::picker(ui, state, name);
+    ui.separator();
+    if let Some(def) = setup::def_of(&state.world, name) {
+        let mut line = format!("Stock entity {}", def.stock);
+        if !def.datum_from.is_empty() {
+            line.push_str(&format!(", datum from {}", def.datum_from));
+        }
+        ui.label(line);
+    }
+    super::setup_align_pick::picker(ui, state, name);
+    super::setup_relative_pick::picker(ui, state, name);
+    super::setup_plane_pick::row(ui, state, name);
+    super::setup_axis_pick::rows(ui, state, name);
+    super::setup_wcs_pick::picker(ui, state, name);
+    ui.separator();
+    if ui.button(format!("Delete {name}")).clicked() {
+        state.pending.push_back(CommandKind::DeleteSetup(name.to_owned()));
+    }
+}
+
+/// The tools this setup's operations use, in program order: number,
+/// size, kind, how many operations - and the editor one click away.
+/// Tools live in the document's library (decision #343 (b)), so the note
+/// says plainly that an edit reaches every setup using the tool.
+fn tool_table(ui: &mut Ui, state: &mut State, ctx: Option<&str>) {
+    let used = tools_of(state, ctx);
+    if used.is_empty() {
+        ui.label("No operation in this setup uses a tool yet.");
+        return;
+    }
+    hint(ui, "Tools live in the document's tool library: editing one here edits it in every setup that uses it.");
+    let mut open: Option<String> = None;
+    egui::Grid::new("setup_tool_table").striped(true).show(ui, |ui| {
+        for h in ["T", "Tool", "Size", "Ops", ""] {
+            ui.label(RichText::new(h).strong());
+        }
+        ui.end_row();
+        for (tool, ops) in &used {
+            let number = tool_numbers::number_of(&state.world, tool).map_or_else(|| "?".to_owned(), |n| n.to_string());
+            ui.label(number);
+            ui.label(tool);
+            let size = model::find_by_name(&state.world, tool)
+                .and_then(|e| model::tool_of(&state.world, &e))
+                .map_or_else(|| "missing".to_owned(), |t| format!("Ø{} {}", t.diameter, kind_name(t.kind)));
+            ui.label(size);
+            ui.label(ops.to_string());
+            if ui.small_button("Edit").clicked() {
+                open = Some(tool.clone());
+            }
+            ui.end_row();
+        }
+    });
+    let names: Vec<String> = used.iter().map(|(t, _)| t.clone()).collect();
+    if let Some(why) = tool_numbers::clash(&state.world, &names) {
+        let ink = super::colorvision::text_inks(ui, &state.world).error;
+        ui.colored_label(ink, why);
+    }
+    if let Some(tool) = open {
+        crate::actions::open_tool_editor(state, &tool);
+    }
+}
+
+/// (tool, operation count) for the setup's operations, in program order.
+fn tools_of(state: &State, ctx: Option<&str>) -> Vec<(String, usize)> {
+    let mut out: Vec<(String, usize)> = Vec::new();
+    for (_, e) in setup::operation_order(&state.world) {
+        let Some(op) = model::operation_of(&state.world, &e) else {
+            continue;
+        };
+        if let Some(name) = ctx
+            && !setup::belongs(&state.world, op.setup.as_deref(), name)
+        {
+            continue;
+        }
+        match out.iter_mut().find(|(t, _)| *t == op.tool) {
+            Some((_, n)) => *n += 1,
+            None => out.push((op.tool.clone(), 1)),
+        }
+    }
+    out
+}
diff --git a/crates/ui/src/egui_app/setup_plane_pick.rs b/crates/ui/src/egui_app/setup_plane_pick.rs
new file mode 100644
index 00000000..5d0ab886
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_plane_pick.rs
@@ -0,0 +1,104 @@
+//! The Setups page's "Lay on a plane" row (#330): pick one flat face in
+//! the viewport (#554: a face only - an edge cannot set a plane; edges
+//! set an axis in the "Axes in the plane" rows), choose G17 (XY), G18
+//! (ZX) or G19 (YZ), flip it, optionally set the face onto the plane's
+//! level, and Apply. The pick draft is view state (`crate::plane_pick`); Apply queues
+//! `CommandKind::LayPartOnPlane`, the undoable `AlignPartToSetup`. The
+//! app says whether the picks make a plane and, if not, why - shown on
+//! the disabled Apply. The work offset is not touched.
+//!
+//! Provenance: our own UI over plain datum-face practice; no vendor
+//! material consulted.
+
+use egui::{ComboBox, RichText, Ui};
+
+use camcraft_app::cl::ArcPlane;
+use camcraft_app::commands::AlignPartToSetup;
+use camcraft_app::pick::{self, PlaneLay};
+
+use crate::state::{CommandKind, State};
+
+const PLANES: [ArcPlane; 3] = [ArcPlane::Xy, ArcPlane::Xz, ArcPlane::Yz];
+
+/// The row's options, kept between frames (view state).
+#[derive(Clone, Copy)]
+struct Draft {
+    plane: ArcPlane,
+    flip: bool,
+    place: bool,
+}
+
+impl Default for Draft {
+    fn default() -> Self {
+        Draft { plane: ArcPlane::Xy, flip: false, place: true }
+    }
+}
+
+/// One setup row's control.
+pub(super) fn row(ui: &mut Ui, state: &mut State, setup: &str) {
+    let id = ui.id().with(("setup_plane_draft", setup));
+    let mut d: Draft = ui.data_mut(|m| *m.get_temp_mut_or_insert_with(id, Draft::default));
+    if !state.setup_pick_rows.iter().any(|s| s == setup) {
+        state.setup_pick_rows.push(setup.to_owned()); // #664
+    }
+    let mine = state.plane_pick.as_ref().is_some_and(|p| p.setup == setup);
+    let armed = mine && crate::plane_pick::collecting(state);
+    ui.horizontal(|ui| {
+        ui.label("    Lay on a plane - pick a face");
+        let pick_text = if armed { "Stop picking" } else { "Pick a face" };
+        if ui
+            .selectable_label(armed, pick_text)
+            .on_hover_text("Click one flat face in the viewport; it is laid on the plane.")
+            .clicked()
+        {
+            if armed {
+                crate::plane_pick::disarm(state);
+            } else {
+                crate::plane_pick::arm(state, setup);
+            }
+        }
+        ComboBox::from_id_salt(("setup_plane", setup))
+            .selected_text(pick::plane_label(d.plane))
+            .show_ui(ui, |ui| {
+                for p in PLANES {
+                    ui.selectable_value(&mut d.plane, p, pick::plane_label(p));
+                }
+            })
+            .response
+            .on_hover_text("The plane the picked face is laid on.");
+        ui.checkbox(&mut d.flip, "Flip")
+            .on_hover_text("Face the other way: down (-Z) for G17, -Y for G18, -X for G19.");
+        ui.checkbox(&mut d.place, "Face to plane level")
+            .on_hover_text("Set the picked face onto the plane (e.g. Z 0 for G17); off keeps the part where it is.");
+    });
+    if mine {
+        let picks = state.plane_pick.as_ref().map(|p| p.picks.clone()).unwrap_or_default();
+        let lay = PlaneLay { plane: d.plane, flip: d.flip, place: d.place };
+        // The command's own check: a refused pick, or one that gives the
+        // alignment the setup already holds, greys Apply out with the why.
+        let check = AlignPartToSetup::check_lay(&state.world, setup, &picks, lay).map_err(|e| e.to_string());
+        let side = pick::plane_side(&state.world, &picks).ok();
+        ui.horizontal(|ui| {
+            let words: Vec<String> = picks.iter().map(|g| format!("{} of '{}'", g.feature, g.entity)).collect();
+            let text = if words.is_empty() { "nothing picked yet".to_owned() } else { words.join(", ") };
+            ui.label(RichText::new(format!("      Picked: {text}")).weak());
+            let tip = match &check {
+                Ok(()) => format!("Turn the part so the pick lies on {}.", pick::plane_label(d.plane)),
+                Err(why) => why.clone(),
+            };
+            if ui
+                .add_enabled(check.is_ok(), egui::Button::new("Apply"))
+                .on_hover_text(&tip)
+                .on_disabled_hover_text(&tip)
+                .clicked()
+            {
+                state.pending.push_back(CommandKind::LayPartOnPlane { setup: setup.to_owned(), picks, lay });
+            }
+        });
+        if let Some(side) = &side {
+            ui.label(RichText::new(format!("      {side}")).weak())
+                .on_hover_text("The side of the pick taken as its outside: it faces the plane's axis (or away, with Flip).");
+        }
+    }
+    ui.data_mut(|m| m.insert_temp(id, d));
+}
diff --git a/crates/ui/src/egui_app/setup_plane_tests.rs b/crates/ui/src/egui_app/setup_plane_tests.rs
new file mode 100644
index 00000000..a4409efa
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_plane_tests.rs
@@ -0,0 +1,168 @@
+//! #330 in the surface: the Setups page's "Lay on a plane" row arms the
+//! pick draft, a Face pick lands in the draft (never in an operation),
+//! Apply queues `LayPartOnPlane` and the drain lands it as one undo unit;
+//! picks that set no plane leave Apply disabled and push nothing. #554:
+//! the row takes faces only - it arms Face mode, and an edge is refused
+//! by name. The work offset is not touched.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::accesskit::Role;
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::{NodeT, Queryable};
+use egui_kittest::Harness;
+
+use camcraft_app::commands::ImportModel;
+use camcraft_app::geometry::{Point3, cube, feature, quat_rotate_point};
+use camcraft_app::model;
+use camcraft_app::operation::{FeatureSel, GeoSel};
+use camcraft_app::setup_align;
+
+use crate::state::{CommandKind, GeoPick, State};
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+fn with_part() -> State {
+    let mut state = State::new();
+    let part = ImportModel::from_mesh("part", cube(Point3::new(0.0, 0.0, 0.0), Point3::new(20.0, 20.0, 10.0)));
+    state.history.execute(&state.world, part);
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    state
+}
+
+fn features(state: &State) -> std::sync::Arc<feature::Features> {
+    let e = model::find_by_name(&state.world, "part").expect("part");
+    model::features_of(&state.world, &e).expect("features")
+}
+
+/// The front wall (local y = 0).
+fn front_wall(state: &State) -> GeoSel {
+    let id = features(state)
+        .faces
+        .iter()
+        .find(|f| f.normal[1].abs() > 0.99 && f.offset.abs() < 1e-9)
+        .map(|f| f.id)
+        .expect("the front wall");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Face(id) }
+}
+
+fn top_edge(state: &State, y: f64) -> GeoSel {
+    let f = features(state);
+    let id = feature::chains(&f)
+        .into_iter()
+        .find(|c| {
+            let p = feature::chain_points(&f, c);
+            p.len() == 2 && p.iter().all(|q| q[1] == y && q[2] == 10.0)
+        })
+        .map(|c| c.id)
+        .expect("a top edge");
+    GeoSel { entity: "part".into(), feature: FeatureSel::Chain(id) }
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_plane_pick::row(ui, st, "Setup1");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+fn wall_normal(state: &State) -> Option<[f64; 3]> {
+    let a = setup_align::stored(&state.world, "Setup1")?;
+    let v = quat_rotate_point(a.rot, Point3::new(0.0, -1.0, 0.0));
+    Some([v.x, v.y, v.z])
+}
+
+#[test]
+fn the_row_picks_a_face_and_lays_it_on_g17_through_the_command() {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(700.0, 300.0))
+        .build_ui_state(frame, with_part());
+    h.run();
+    assert!(h.state().pending.is_empty(), "drawing the row queues nothing");
+    h.get_by_label("Pick a face").click();
+    h.run();
+    assert!(h.state().plane_pick.is_some(), "the draft is armed");
+    assert_eq!(h.state().geo_pick, GeoPick::Face, "#554: faces only, no edge snapping");
+    let wall = front_wall(h.state());
+    crate::plane_pick::take(h.state_mut(), wall);
+    h.run();
+    assert!(h.state().op_ui.geo.is_empty(), "a draft pick is not an operation pick");
+    h.get_by(|n| n.role() == Role::Button && n.label().as_deref() == Some("Apply")).click();
+    h.run();
+    let n = wall_normal(h.state()).expect("Setup1 holds the part laid");
+    assert!(n[2] > 1.0 - 1e-9, "the wall faces up: {n:?}");
+    assert!(h.state().plane_pick.is_none(), "a landed lay ends the pick");
+    assert!(h.state().status.contains("laid on G17 (XY)"), "{}", h.state().status);
+    assert_eq!(camcraft_app::setup::work_offset(&h.state().world, "Setup1"), None, "the work offset is untouched");
+    key(&mut h, Key::Z);
+    assert_eq!(setup_align::stored(&h.state().world, "Setup1"), None, "undo restores as modelled");
+    key(&mut h, Key::Y);
+    assert!(wall_normal(h.state()).is_some(), "redo lays it again");
+}
+
+/// #554: an edge that reaches the plane draft (the user switched to Edge
+/// mode by hand) is refused by name and leaves the face in place; edges
+/// sent to the command are refused by the app's own name too.
+#[test]
+fn an_edge_is_refused_by_name_and_the_face_stays() {
+    let mut state = with_part();
+    crate::plane_pick::arm(&mut state, "Setup1");
+    let (front, back) = (top_edge(&state, 0.0), top_edge(&state, 20.0));
+    let wall = front_wall(&state);
+    crate::plane_pick::take(&mut state, wall.clone());
+    crate::plane_pick::take(&mut state, front.clone());
+    assert!(state.status.contains("an edge cannot set a plane"), "{}", state.status);
+    let picks = state.plane_pick.as_ref().map(|p| p.picks.clone()).unwrap_or_default();
+    assert_eq!(picks, vec![wall], "the edge is not drafted; the face stays");
+    let lay = camcraft_app::pick::PlaneLay { plane: camcraft_app::cl::ArcPlane::Xy, flip: false, place: false };
+    run(&mut state, CommandKind::LayPartOnPlane { setup: "Setup1".into(), picks: vec![front, back], lay });
+    assert!(state.status.contains("an edge cannot set a plane"), "{}", state.status);
+    assert_eq!(setup_align::stored(&state.world, "Setup1"), None, "a refusal writes nothing");
+    assert!(state.plane_pick.is_some(), "a refusal keeps the draft to re-pick");
+}
+
+/// The row names the side taken as the pick's outside before Apply, and
+/// a re-pick that gives the alignment the setup already holds greys Apply
+/// out (the command's own check) instead of refusing after the click.
+#[test]
+fn the_side_is_shown_and_a_pick_that_changes_nothing_greys_apply_out() {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(1000.0, 300.0))
+        .build_ui_state(frame, with_part());
+    h.run();
+    h.get_by_label("Pick a face").click();
+    h.run();
+    let wall = front_wall(h.state());
+    crate::plane_pick::take(h.state_mut(), wall.clone());
+    h.run();
+    let side = |h: &Harness<'static, State>| {
+        h.query_by_label_contains("outside: -Y in the model").is_some()
+    };
+    assert!(side(&h), "the wall's outside (-Y) is shown before Apply");
+    let apply = h.get_by(|n| n.role() == Role::Button && n.label().as_deref() == Some("Apply"));
+    assert!(!apply.accesskit_node().is_disabled(), "the wall lays the part differently");
+    apply.click();
+    h.run();
+    assert!(wall_normal(h.state()).is_some(), "Setup1 holds the part laid");
+    // The same pick again: nothing would change.
+    h.get_by_label("Pick a face").click();
+    h.run();
+    crate::plane_pick::take(h.state_mut(), wall);
+    h.run();
+    let apply = h.get_by(|n| n.role() == Role::Button && n.label().as_deref() == Some("Apply"));
+    assert!(apply.accesskit_node().is_disabled(), "the setup already holds the part that way");
+    assert!(side(&h), "the side is still shown");
+}
diff --git a/crates/ui/src/egui_app/setup_relative_pick.rs b/crates/ui/src/egui_app/setup_relative_pick.rs
new file mode 100644
index 00000000..d86f7338
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_relative_pick.rs
@@ -0,0 +1,88 @@
+//! The setup page's "relative to the previous setup" control (#316):
+//! place this setup as a re-clamp of the setup before it - the same way
+//! up, flipped, turned, or by typed angles - or unlink it. Every change
+//! queues the undoable `SetSetupRelative` (through
+//! `CommandKind::SetSetupRelative`); nothing here writes the world. The
+//! turn is on the part; the work offset is its own row.
+//!
+//! Provenance: our own UI over plain shop practice (flipping a part for
+//! its second operation); no vendor material consulted.
+
+use egui::{ComboBox, DragValue, Ui};
+
+use camcraft_app::setup;
+use camcraft_app::setup_align::AlignPreset;
+use camcraft_app::setup_relative;
+
+use crate::state::{CommandKind, State};
+
+/// The choice's words: "Same as Setup1" for no turn, else the preset's.
+fn choice_label(p: AlignPreset, prev: &str) -> String {
+    match p {
+        AlignPreset::AsModelled => format!("Same as {prev}"),
+        other => format!("{} from {prev}", other.label()),
+    }
+}
+
+/// One setup's control. Shown only when there is a setup before it.
+pub(super) fn picker(ui: &mut Ui, state: &mut State, name: &str) {
+    let names = setup::names(&state.world);
+    let Some(prev) = names.iter().position(|n| n == name).and_then(|i| i.checked_sub(1)).and_then(|i| names.get(i))
+    else {
+        return;
+    };
+    let prev = prev.clone();
+    let linked = setup_relative::relative_to(&state.world, name);
+    let shown = setup_relative::describe(&state.world, name).unwrap_or_else(|| "Not linked".to_owned());
+    let mut queued: Option<CommandKind> = None;
+    ui.horizontal(|ui| {
+        ui.label("    Relative to previous setup");
+        ComboBox::from_id_salt(("setup_relative", name))
+            .selected_text(&shown)
+            .show_ui(ui, |ui| {
+                if ui.selectable_label(linked.is_none(), "Not linked").clicked() && linked.is_some() {
+                    queued = Some(CommandKind::SetSetupRelative { setup: name.to_owned(), to: None, angles: [0.0; 3] });
+                }
+                for p in AlignPreset::ALL {
+                    let words = choice_label(p, &prev);
+                    if ui.selectable_label(shown == words, &words).clicked() && shown != words {
+                        queued = Some(CommandKind::SetSetupRelative {
+                            setup: name.to_owned(),
+                            to: Some(prev.clone()),
+                            angles: p.angles(),
+                        });
+                    }
+                }
+            })
+            .response
+            .on_hover_text(format!(
+                "This setup is {prev} re-clamped: the part is turned from how {prev} holds it, about the \
+                 centre of its bounds. While linked, changing how {prev} holds the part moves this setup's \
+                 part (and its stock) with it. The work offset is not changed."
+            ));
+    });
+    let id = ui.id().with(("setup_relative_draft", name));
+    let held = setup_relative::angles(&state.world, name);
+    let mut draft: [f64; 3] = ui.data_mut(|d| *d.get_temp_mut_or_insert_with(id, || held));
+    ui.horizontal(|ui| {
+        ui.label("      Turn from previous");
+        for (axis, v) in ["X", "Y", "Z"].into_iter().zip(draft.iter_mut()) {
+            ui.label(axis);
+            ui.add(DragValue::new(v).speed(1.0).range(-360.0..=360.0).suffix("°"));
+        }
+        if ui
+            .button("Apply")
+            .on_hover_text(format!("Place this setup as {prev} turned about X, then Y, then Z."))
+            .clicked()
+        {
+            queued = Some(CommandKind::SetSetupRelative { setup: name.to_owned(), to: Some(prev.clone()), angles: draft });
+        }
+    });
+    if let Some(k) = queued {
+        if let CommandKind::SetSetupRelative { angles, .. } = &k {
+            draft = *angles;
+        }
+        state.pending.push_back(k);
+    }
+    ui.data_mut(|d| d.insert_temp(id, draft));
+}
diff --git a/crates/ui/src/egui_app/setup_relative_tests.rs b/crates/ui/src/egui_app/setup_relative_tests.rs
new file mode 100644
index 00000000..537b1eb3
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_relative_tests.rs
@@ -0,0 +1,98 @@
+//! #316 in the surface: the setup page's "relative to previous setup"
+//! control queues `SetSetupRelative` (never a world poke), the drain
+//! lands it as one undo unit, Ctrl+Z / Ctrl+Y walk it, the first setup
+//! shows no control, and a refused link pushes nothing. The work offset
+//! is not touched.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::accesskit::Role;
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::Queryable;
+use egui_kittest::Harness;
+
+use camcraft_app::commands::ImportModel;
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::setup_relative;
+
+use crate::state::{CommandKind, State};
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+fn two_setups() -> State {
+    let mut state = State::new();
+    let part = ImportModel::from_mesh("part", cube(Point3::new(-20.0, -10.0, 0.0), Point3::new(20.0, 10.0, 8.0)));
+    state.history.execute(&state.world, part);
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: Some("Setup1".into()) });
+    state
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_relative_pick::picker(ui, st, "Setup1");
+    super::setup_relative_pick::picker(ui, st, "Setup2");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+fn shown(state: &State) -> Option<String> {
+    setup_relative::describe(&state.world, "Setup2")
+}
+
+#[test]
+fn the_relative_control_links_the_setup_through_the_command() {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(700.0, 400.0))
+        .build_ui_state(frame, two_setups());
+    h.run();
+    assert!(h.state().pending.is_empty(), "drawing the control queues nothing");
+    let combos = h.query_all_by(|n| n.role() == Role::ComboBox).count();
+    assert_eq!(combos, 1, "the first setup has no previous setup to be relative to");
+    h.get_by(|n| n.role() == Role::ComboBox && n.value().as_deref() == Some("Not linked")).click();
+    h.run();
+    h.get_by_label("Flip over X from Setup1").click();
+    h.run();
+    assert_eq!(shown(h.state()).as_deref(), Some("Flip over X from Setup1"), "the drain lands the link");
+    assert_eq!(h.state().status, "Setup2: Flip over X from Setup1");
+    assert_eq!(camcraft_app::setup::work_offset(&h.state().world, "Setup2"), None, "the work offset is untouched");
+    key(&mut h, Key::Z);
+    assert_eq!(shown(h.state()), None, "undo unlinks");
+    key(&mut h, Key::Y);
+    assert_eq!(shown(h.state()).as_deref(), Some("Flip over X from Setup1"), "redo links again");
+}
+
+#[test]
+fn typed_turns_unlinking_and_refusals_go_through_the_drain() {
+    let mut state = two_setups();
+    let link = |angles| CommandKind::SetSetupRelative { setup: "Setup2".into(), to: Some("Setup1".into()), angles };
+    run(&mut state, link([0.0, 0.0, 90.0]));
+    assert_eq!(shown(&state).as_deref(), Some("Turn 90° about Z from Setup1"));
+    run(&mut state, link([0.0, 0.0, 90.0]));
+    assert!(state.status.contains("setup not re-placed"), "{}", state.status);
+    run(&mut state, link([f64::NAN, 0.0, 0.0]));
+    assert!(state.status.contains("finite"), "{}", state.status);
+    run(&mut state, CommandKind::SetSetupRelative { setup: "Setup1".into(), to: Some("Setup2".into()), angles: [0.0; 3] });
+    assert!(state.status.contains("loop"), "{}", state.status);
+    run(&mut state, CommandKind::SetSetupRelative { setup: "Setup2".into(), to: None, angles: [0.0; 3] });
+    assert_eq!(shown(&state), None);
+    assert_eq!(state.status, "Setup2 is no longer placed relative to another setup");
+    // One link and one unlink landed; the refusals pushed nothing.
+    run(&mut state, CommandKind::Undo);
+    run(&mut state, CommandKind::Undo);
+    assert_eq!(shown(&state), None);
+    assert_eq!(camcraft_app::setup_align::stored(&state.world, "Setup2"), None);
+}
diff --git a/crates/ui/src/egui_app/setup_stock_pick.rs b/crates/ui/src/egui_app/setup_stock_pick.rs
new file mode 100644
index 00000000..f8aef6ff
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_stock_pick.rs
@@ -0,0 +1,90 @@
+//! The setup page's stock source (#320): "Its own stock" or "What
+//! <previous setup> leaves behind", and the incoming stock that second
+//! choice brings - the carried body's box and volume. A pick queues the
+//! undoable `SetSetupStockSource` (`CommandKind::SetSetupStockSource`);
+//! nothing here writes the world. The first setup shows no choice, and a
+//! carry the sim refuses shows its reason and cannot be picked.
+//!
+//! Provenance: our own page law (issue #320, #343's per-node behaviour);
+//! no HSMWorks material consulted.
+
+use egui::{RichText, Ui};
+
+use camcraft_app::setup_stock::{self, Incoming, StockSource};
+use camcraft_app::units;
+
+use crate::state::{CommandKind, State};
+
+/// Draw the stock-source choice of setup `name`.
+pub(super) fn picker(ui: &mut Ui, state: &mut State, name: &str) {
+    ui.label("Stock");
+    let (Some(prev), Some(now)) = (setup_stock::previous(&state.world, name), setup_stock::effective(&state.world, name))
+    else {
+        let _ = ui.radio(true, "Its own stock (the Stock node)");
+        ui.label(RichText::new("The first setup has no setup before it to take stock from.").weak());
+        return;
+    };
+    let refusal = setup_stock::carry_refusal(&state.world, name);
+    let mut pick = None;
+    if ui.radio(now == StockSource::Own, "Its own stock (the Stock node)").clicked() && now != StockSource::Own {
+        pick = Some(StockSource::Own);
+    }
+    let carried = ui
+        .add_enabled(
+            refusal.is_none(),
+            egui::RadioButton::new(now == StockSource::FromPrevious, format!("What {prev} leaves behind")),
+        )
+        .on_disabled_hover_text(refusal.clone().unwrap_or_default());
+    if carried.clicked() && now != StockSource::FromPrevious {
+        pick = Some(StockSource::FromPrevious);
+    }
+    if let Some(source) = pick {
+        state.pending.push_back(CommandKind::SetSetupStockSource { setup: name.to_owned(), source });
+    }
+    match (&refusal, now) {
+        (Some(why), StockSource::FromPrevious) => {
+            let ink = super::colorvision::text_inks(ui, &state.world).error;
+            ui.colored_label(ink, format!("The program sim cannot carry the stock: {why}. Pick its own stock to simulate a new block."));
+        }
+        (Some(why), StockSource::Own) => {
+            ui.label(RichText::new(format!("Cannot take what {prev} leaves behind: {why}")).weak());
+        }
+        (None, StockSource::FromPrevious) => incoming(ui, state, name, &prev),
+        (None, StockSource::Own) => {}
+    }
+}
+
+/// The incoming stock's box and volume, measured once per document
+/// version (the program sim is not run every frame).
+fn incoming(ui: &mut Ui, state: &State, name: &str, prev: &str) {
+    let id = egui::Id::new(("setup_incoming_stock", name.to_owned(), state.doc_version));
+    let cached: Option<Result<Incoming, String>> = ui.ctx().data(|d| d.get_temp(id));
+    let got = cached.unwrap_or_else(|| {
+        let v = setup_stock::incoming(&state.world, name);
+        ui.ctx().data_mut(|d| d.insert_temp(id, v.clone()));
+        v
+    });
+    match got {
+        Ok(i) => {
+            let u = state.units();
+            ui.label(format!(
+                "Incoming from {prev}: X {} .. {}, Y {} .. {}, Z {} .. {} {}",
+                units::len(i.min[0], u, 3),
+                units::len(i.max[0], u, 3),
+                units::len(i.min[1], u, 3),
+                units::len(i.max[1], u, 3),
+                units::len(i.min[2], u, 3),
+                units::len(i.max[2], u, 3),
+                u.suffix()
+            ));
+            ui.label(format!(
+                "Incoming volume: {} {} (this setup's Stock node is not cut from)",
+                units::vol(i.volume, u, 1),
+                u.vol_suffix()
+            ));
+        }
+        Err(why) => {
+            ui.label(RichText::new(format!("Incoming stock not known yet: {why}")).weak());
+        }
+    }
+}
diff --git a/crates/ui/src/egui_app/setup_stock_tests.rs b/crates/ui/src/egui_app/setup_stock_tests.rs
new file mode 100644
index 00000000..c46b931c
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_stock_tests.rs
@@ -0,0 +1,152 @@
+//! #320 in the surface: the setup page's stock source. The first setup
+//! shows no choice; a later one offers "Its own stock" and "What Setup1
+//! leaves behind", a click queues `SetSetupStockSource` (never a world
+//! poke), Ctrl+Z / Ctrl+Y walk it, the incoming stock's box and volume
+//! show once it is picked, and a carry the sim refuses disables the
+//! option with its reason.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::accesskit::Role;
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::{NodeT, Queryable};
+use egui_kittest::Harness;
+
+use camcraft_app::commands::{
+    AddTool, AlignPartToSetup, CreateOperation, CreateSetup, GenerateOperation, ImportModel, SetStock,
+};
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::setup_stock::{self, StockSource};
+use camcraft_app::stock::StockShape;
+use camcraft_app::stock_sim::CARRY_TURN_REFUSAL;
+
+use crate::state::State;
+
+const TOOL: &str = "EM-0400-2FL";
+
+fn face(cut_z: f64) -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        tilt: None,
+        blend_turns: false,
+        stepover: 3.0,
+        clearance_z: Height::fixed(30.0),
+        cut_z: Height::fixed(cut_z),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+fn add_face(state: &mut State, name: &str) {
+    let op = CreateOperation::new(&state.world, name, TOOL, SrcRef::Stock, face(16.0)).expect("create");
+    state.history.execute(&state.world, op);
+    let gen_op = GenerateOperation::new(&state.world, name).expect("generate");
+    state.history.execute(&state.world, gen_op);
+}
+
+/// A 60 x 60 x 16 part in a stock Z -2..18, Setup1 facing the top, and
+/// Setup2 (from Setup1's datum, holding the part alike) facing too.
+fn two_setups() -> State {
+    let mut state = State::new();
+    let w = &state.world;
+    let part = ImportModel::from_mesh("part", cube(Point3::new(-30.0, -30.0, 0.0), Point3::new(30.0, 30.0, 16.0)));
+    state.history.execute(w, part);
+    let at = Location { pos: Point3::new(0.0, 0.0, -2.0), ..Default::default() };
+    let stock = SetStock::new(w, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, at).expect("stock");
+    state.history.execute(w, stock);
+    let tool = camcraft_app::tools::catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("tool");
+    let add = AddTool::new(w, TOOL, tool).expect("add tool");
+    state.history.execute(w, add);
+    let s1 = CreateSetup::new(w, None, None).expect("Setup1");
+    state.history.execute(w, s1);
+    add_face(&mut state, "Face1");
+    let s2 = CreateSetup::new(&state.world, None, Some("Setup1")).expect("Setup2");
+    state.history.execute(&state.world, s2);
+    add_face(&mut state, "Face2");
+    state
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_stock_pick::picker(ui, st, "Setup2");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+fn harness(state: State) -> Harness<'static, State> {
+    Harness::builder().with_size(Vec2::new(900.0, 400.0)).build_ui_state(frame, state)
+}
+
+#[test]
+fn the_first_setup_offers_no_choice() {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(900.0, 300.0))
+        .build_ui_state(|ui, st: &mut State| super::setup_stock_pick::picker(ui, st, "Setup1"), two_setups());
+    h.run();
+    assert_eq!(h.query_all_by(|n| n.role() == Role::RadioButton).count(), 1, "only its own stock");
+    assert!(h.query_by_label_contains("leaves behind").is_none());
+    assert!(h.query_by_label_contains("no setup before it").is_some());
+}
+
+#[test]
+fn picking_what_setup1_leaves_shows_the_incoming_stock_and_undoes() {
+    let mut h = harness(two_setups());
+    h.run();
+    assert!(h.state().pending.is_empty(), "drawing the choice queues nothing");
+    assert_eq!(setup_stock::effective(&h.state().world, "Setup2"), Some(StockSource::Own), "same hold: its own stock");
+    assert!(h.query_by_label_contains("Incoming from").is_none(), "no incoming stock for its own block");
+    h.get_by_label("What Setup1 leaves behind").click();
+    h.run();
+    assert_eq!(setup_stock::stored(&h.state().world, "Setup2"), Some(StockSource::FromPrevious), "the drain lands the pick");
+    assert_eq!(h.state().status, "Setup2 stock: What Setup1 leaves behind");
+    h.run();
+    assert!(
+        h.query_by_label_contains("Incoming stock not known yet: Face2").is_some(),
+        "the pick moved Face2's inputs: the page says so rather than guess"
+    );
+    let regen = GenerateOperation::new(&h.state().world, "Face2").expect("regenerate");
+    let st = h.state_mut();
+    st.history.execute(&st.world, regen);
+    st.doc_version += 1;
+    h.run();
+    // Setup1 faced the block (Z -2..18) to 16: 60 x 60 x 18 reaches Setup2.
+    assert!(h.query_by_label_contains("Z -2.000 .. 16.000 mm").is_some(), "the incoming box");
+    assert!(h.query_by_label_contains("Incoming volume: 64800.0").is_some(), "the incoming volume");
+    key(&mut h, Key::Z); // the regeneration
+    key(&mut h, Key::Z); // the pick
+    assert_eq!(setup_stock::stored(&h.state().world, "Setup2"), None, "undo restores the unpicked default");
+    key(&mut h, Key::Y);
+    assert_eq!(setup_stock::stored(&h.state().world, "Setup2"), Some(StockSource::FromPrevious), "redo picks again");
+}
+
+#[test]
+fn a_refused_carry_disables_the_option_with_its_reason() {
+    let mut state = two_setups();
+    let skew = AlignPartToSetup::angles(&state.world, "Setup2", [0.0, 0.0, 30.0]).expect("30 degrees about Z");
+    state.history.execute(&state.world, skew);
+    let mut h = harness(state);
+    h.run();
+    let carried =
+        h.get_by(|n| n.role() == Role::RadioButton && n.label().as_deref() == Some("What Setup1 leaves behind"));
+    assert!(carried.accesskit_node().is_disabled(), "a turn the lattice cannot carry cannot be picked");
+    assert!(h.query_by_label_contains(CARRY_TURN_REFUSAL).is_some(), "the reason is named on the page");
+    h.get_by_label("Its own stock (the Stock node)").click();
+    h.run();
+    assert_eq!(setup_stock::stored(&h.state().world, "Setup2"), Some(StockSource::Own), "a new block can still be picked");
+    assert!(h.query_by_label_contains("Cannot take what Setup1 leaves behind").is_some());
+}
diff --git a/crates/ui/src/egui_app/setup_wcs_pick.rs b/crates/ui/src/egui_app/setup_wcs_pick.rs
new file mode 100644
index 00000000..0af2fc86
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_wcs_pick.rs
@@ -0,0 +1,56 @@
+//! The Setups page's work-offset picker (#196, #342): which `G54`..`G59`
+//! word the post writes for the setup's one WCS. It is only the label -
+//! the WCS origin, and every height measured from it, stay put.
+//! An unset setup IS `G54` - one `G54` entry, stored unset, so the file
+//! format is unchanged (#329). A pick queues the undoable
+//! `SetSetupWorkOffset`; nothing here writes the world.
+//!
+//! Provenance: our own UI over RS-274 / ISO 6983 work-offset selection;
+//! no vendor material consulted.
+
+use egui::{ComboBox, Ui};
+
+use camcraft_app::schema::WCS_SLOTS;
+
+use crate::state::{CommandKind, State};
+
+/// The combo text for a stored pick: the setup's word, plain - unset
+/// reads `G54`, exactly like an explicit `G54`.
+#[must_use]
+pub(super) fn pick_text(slot: Option<usize>) -> &'static str {
+    WCS_SLOTS.get(slot.unwrap_or(0)).copied().unwrap_or("G54")
+}
+
+/// A stored pick in the combo's terms: `G54` (slot 0) and unset are one
+/// entry, so both read `None` and choosing `G54` on either queues nothing.
+fn normalized(slot: Option<usize>) -> Option<usize> {
+    slot.filter(|i| *i != 0)
+}
+
+/// One setup row's picker: label, combo, and the queued command when the
+/// user picks a different entry.
+pub(super) fn picker(ui: &mut Ui, state: &mut State, setup: &str) {
+    let current = normalized(camcraft_app::setup::work_offset(&state.world, setup));
+    let mut chosen = current;
+    ui.horizontal(|ui| {
+        ui.label("    Work offset");
+        ComboBox::from_id_salt(("setup_wcs", setup))
+            .selected_text(pick_text(current))
+            .show_ui(ui, |ui| {
+                for (i, w) in WCS_SLOTS.iter().enumerate() {
+                    ui.selectable_value(&mut chosen, normalized(Some(i)), *w);
+                }
+            })
+            .response
+            .on_hover_text(
+                "The G-word the post writes for this setup's WCS. It only names the \
+                 controller register - the WCS origin stays where it is placed.",
+            );
+    });
+    if chosen != current {
+        state.pending.push_back(CommandKind::SetSetupWorkOffset {
+            setup: setup.to_owned(),
+            slot: chosen,
+        });
+    }
+}
diff --git a/crates/ui/src/egui_app/setup_wcs_tests.rs b/crates/ui/src/egui_app/setup_wcs_tests.rs
new file mode 100644
index 00000000..81dc9736
--- /dev/null
+++ b/crates/ui/src/egui_app/setup_wcs_tests.rs
@@ -0,0 +1,121 @@
+//! #196 in the surface: the Setups page's work-offset picker queues
+//! `SetSetupWorkOffset` (never a world poke), the drain lands it as one
+//! undo unit, Ctrl+Z / Ctrl+Y walk it, and a refused pick pushes nothing.
+//! Provenance: our own page law; no vendor material consulted.
+
+use egui::accesskit::Role;
+use egui::{Event, Key, Modifiers, Vec2};
+use egui_kittest::kittest::Queryable;
+use egui_kittest::Harness;
+
+use crate::state::{CommandKind, State};
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+fn with_setup() -> State {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    state
+}
+
+fn pick(state: &State) -> Option<usize> {
+    camcraft_app::setup::work_offset(&state.world, "Setup1")
+}
+
+fn frame(ui: &mut egui::Ui, st: &mut State) {
+    super::panes::shortcuts(ui, st);
+    st.drain_actions();
+    super::setup_wcs_pick::picker(ui, st, "Setup1");
+}
+
+fn key(h: &mut Harness<'static, State>, k: Key) {
+    h.input_mut().events.push(Event::ModifiersChanged(Modifiers::COMMAND));
+    h.input_mut().events.push(Event::Key {
+        key: k,
+        physical_key: None,
+        pressed: true,
+        repeat: false,
+        modifiers: Modifiers::COMMAND,
+    });
+    h.run_steps(2);
+}
+
+#[test]
+fn the_picker_sets_the_setups_work_offset_through_the_command() {
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(500.0, 400.0))
+        .build_ui_state(frame, with_setup());
+    h.run();
+    assert_eq!(pick(h.state()), None, "a fresh setup is unset - it reads G54");
+    assert!(h.state().pending.is_empty(), "drawing the picker queues nothing");
+    let auto = super::setup_wcs_pick::pick_text(None);
+    h.get_by(|n| n.role() == Role::ComboBox && n.value().as_deref() == Some(auto)).click();
+    h.run();
+    h.get_by_label("G55").click();
+    h.run();
+    assert_eq!(pick(h.state()), Some(1), "the drain lands G55");
+    assert_eq!(h.state().status, "Setup1 WCS posts as G55");
+    key(&mut h, Key::Z);
+    assert_eq!(pick(h.state()), None, "undo restores G54 (unset)");
+    key(&mut h, Key::Y);
+    assert_eq!(pick(h.state()), Some(1), "redo restores G55");
+}
+
+#[test]
+fn a_refused_pick_changes_nothing_and_says_why() {
+    let mut state = with_setup();
+    run(&mut state, CommandKind::SetSetupWorkOffset { setup: "Setup1".into(), slot: Some(9) });
+    assert_eq!(pick(&state), None);
+    assert!(state.status.contains("work offset not changed"), "{}", state.status);
+    // The refusal pushed nothing: the one undo unit is the CreateSetup.
+    run(&mut state, CommandKind::Undo);
+    assert!(camcraft_app::setup::names(&state.world).is_empty());
+    assert!(!state.history.can_undo());
+}
+
+/// #329: the Heights page's Work offset reference offers no slot of its
+/// own - one combo (From), and the setup's offset shown read-only with
+/// the pointer to the Setups page. Picking G55 on the setup changes what
+/// the row shows; the height itself is untouched.
+#[test]
+fn the_heights_page_shows_the_setups_offset_with_no_wcs_choice() {
+    use camcraft_app::operation::{Height, HeightReference};
+    let frame = |ui: &mut egui::Ui, st: &mut (State, Height)| {
+        let (state, height) = st;
+        super::heights_page::height_editor(ui, "Cut Z", &state.world, Some("Setup1"), height, "t.cut");
+    };
+    let height = Height::of(HeightReference::WorkOffset, 0.0);
+    let combos = |h: &Harness<'static, (State, Height)>| {
+        h.query_all_by(|n| n.role() == Role::ComboBox).count()
+    };
+    let shown = |h: &Harness<'static, (State, Height)>, text: &str| {
+        h.query_all_by(|n| {
+            n.label().is_some_and(|l| l.contains(text)) || n.value().is_some_and(|v| v.contains(text))
+        })
+        .count()
+            > 0
+    };
+    let mut h = Harness::builder()
+        .with_size(Vec2::new(500.0, 300.0))
+        .build_ui_state(frame, (with_setup(), height));
+    h.run();
+    assert_eq!(combos(&h), 1, "only the From combo - no per-height WCS choice");
+    assert!(shown(&h, "WCS (G54)  (from setup Setup1)"), "an unset setup reads G54");
+    run(&mut h.state_mut().0, CommandKind::SetSetupWorkOffset { setup: "Setup1".into(), slot: Some(1) });
+    h.run();
+    assert_eq!(combos(&h), 1);
+    assert!(shown(&h, "WCS (G55)  (from setup Setup1)"), "follows the setup's pick");
+    assert_eq!(h.state().1, Height::of(HeightReference::WorkOffset, 0.0), "the height is untouched");
+}
+
+/// #329: unset and an explicit G54 are one entry, spelled plainly.
+#[test]
+fn an_unset_setup_reads_plain_g54() {
+    use super::setup_wcs_pick::pick_text;
+    assert_eq!(pick_text(None), "G54");
+    assert_eq!(pick_text(Some(0)), "G54");
+    assert_eq!(pick_text(Some(1)), "G55");
+}
