+#[test]
+fn a_face_job_on_the_built_in_770mx_passes_the_gate_and_posts_inch() {
+    use camcraft_app::commands::{
+        AddTool, CreateOperation, GenerateOperation, History, ImportModel, LoadMachine, SelectPost,
+        SetStock,
+    };
+    use camcraft_app::geometry::{Point3, cube};
+    use camcraft_app::operation::{Height, OpParams, SrcRef};
+    use camcraft_app::schema::{Location, PostRef};
+    use camcraft_app::stock::StockShape;
+    use camcraft_app::tools::catalog;
+
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    h.execute(
+        &world,
+        LoadMachine::builtin(&world, "Tormach 770MX").expect("built-in machine"),
+    );
+    h.execute(
+        &world,
+        SelectPost::new(&world, PostRef::Named("Tormach PathPilot".into())).expect("post"),
+    );
+    let stock = SetStock::new(
+        &world,
+        StockShape::Box {
+            dx: 60.0,
+            dy: 60.0,
+            dz: 20.0,
+        },
+        Location::default(),
+    );
+    h.execute(&world, stock.expect("stock"));
+    h.execute(
+        &world,
+        ImportModel::from_mesh(
+            "part",
+            cube(Point3::new(0.0, 0.0, 0.0), Point3::new(40.0, 40.0, 19.0)),
+        ),
+    );
+    // The catalog's 12000 rpm is over the 770MX's 10000 - a separate
+    // gate refusal; this test is about travel, so run within the spindle.
+    let mut tool = catalog()
+        .into_iter()
+        .find(|(n, _)| *n == "EM-0400-2FL")
+        .map(|(_, t)| t)
+        .expect("tool");
+    tool.rpm = 8000.0;
+    h.execute(
+        &world,
+        AddTool::new(&world, "EM-0400-2FL", tool).expect("add tool"),
+    );
+    // G54 is unplaced (the world origin, the stock's floor): clearance at
+    // Z 25 mm and the cut at Z 19.5 both stand ABOVE G54 Z0.
+    let face = OpParams::Face {
+        holes: Default::default(),
+        blend_turns: false,
+        tilt: None,
+        stepover: 3.0,
+        clearance_z: Height::fixed(25.0),
+        cut_z: Height::fixed(19.5),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    };
+    h.execute(
+        &world,
+        CreateOperation::new(&world, "Face1", "EM-0400-2FL", SrcRef::Stock, face).expect("face"),
+    );
+    h.execute(
+        &world,
+        GenerateOperation::new(&world, "Face1").expect("generate"),
+    );
+    let path =
+        std::env::temp_dir().join(format!("camcraft_tormach_face_{}.nc", std::process::id()));
+    let posted = camcraft_app::posting::post_setup(&world, &path);
+    let _ = std::fs::remove_file(&path);
+    let posted =
+        posted.unwrap_or_else(|e| panic!("the 770MX gate must pass a plain face job: {e}"));
+    assert!(
+        posted.program.contains("G20 G17 G90 G91.1 G94"),
+        "{}",
+        posted.program
+    );
+}

From 85baabe7bf8fa6b5736f2eb9f500e914c3d5b03d Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sat, 7 Nov 2026 16:49:47 -0800
Subject: [PATCH 6/6] fix(post): rapid to the start height before the first
 Tormach feed

Found on the 770MX: a Face's first move is a plunge FEED from its
clearance start. After the tool change (G53 G0 Z0, G30) Z stands at the
top of travel, so the posted program fed the whole stroke at the plunge
rate (11.81 in/min). Once X Y are positioned, the post now rapids Z down
to the stream's start height - where the generator says the tool already
stands - and the feed runs only the stretch it planned. A program with
this line added by hand ran correctly on the machine.

Pinned by tormach_post::a_face_job_on_the_built_in_770mx_passes_the_gate_and_posts_inch
(fails without the fix). face_square_40x40's golden gains the rapid.

Refs #131

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 assets/posts/tormach.cps                      | 11 ++++++++++
 .../golden/nc/tormach/face_square_40x40.nc    |  1 +
 crates/app/tests/tormach_post.rs              | 21 +++++++++++++++++++
 3 files changed, 33 insertions(+)

diff --git a/assets/posts/tormach.cps b/assets/posts/tormach.cps
index b589a76b..0c99a24f 100644
--- a/assets/posts/tormach.cps
+++ b/assets/posts/tormach.cps
@@ -236,9 +236,20 @@ function xyFirst(x, y) {
   block(["G0", wo("X", x, orgX), wo("Y", y, orgY)]);
   xyUnknown = false;
 }
+// A feed or arc as the first move after a tool change starts, in the
+// stream, from the generator's own start point - its clearance height
+// (a face plunges from START). After the G30 the tool stands at the top
+// of Z travel, so feeding from there would crawl the whole stroke at the
+// plunge rate. Once X Y are positioned, a rapid takes Z down to that
+// start height - where the generator says the tool already is - and the
+// feed runs only the stretch it planned (proven on the 770MX, #131).
 function startXY(p) {
+  if (!xyUnknown) return;
   if (has(p.StartX) && has(p.StartY)) xyFirst(p.StartX, p.StartY);
   else xyFirst(p.X, p.Y);
+  if (!xyUnknown && has(p.StartZ) && has(p.Z) && p.StartZ > p.Z) {
+    block(["G0", wo("Z", p.StartZ, orgZ)]);
+  }
 }
 
