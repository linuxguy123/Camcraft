diff --git a/crates/app/src/operation/stamp_stock.rs b/crates/app/src/operation/stamp_stock.rs
new file mode 100644
index 00000000..f4509537
--- /dev/null
+++ b/crates/app/src/operation/stamp_stock.rs
@@ -0,0 +1,131 @@
+//! The stock term of an operation's stamp (issue #156): which operations
+//! read the setup's stock while generating and verifying, and the digest
+//! of the stock they read (shape kind, size, placement, mesh).
+//!
+//! Provenance: our own staleness model (M3.1, `stamp.rs`), specced from
+//! the Prime Directive - a verdict judged against a stock that has since
+//! moved is a verdict nobody gave, so the op must read Stale and the
+//! post refuse it. No vendor material.
+
+use std::hash::Hasher;
+
+use flecs_ecs::prelude::{Entity, World};
+
+use super::SrcRef;
+use crate::model;
+use crate::stock::StockShape;
+
+/// Whether an operation's generation reads the setup's stock beyond its
+/// own source - the explicit set the stock term is written for.
+///
+/// The stock reaches the generators through ONE seam: `collect_job`
+/// hands every kind whose source is not the stock itself the stock's
+/// world facets and box. From there it feeds the clearance top
+/// (`stock_top_z`), the stock region the reach and entry laws widen
+/// into, the rapid-in-stock column (#96) and footprint rings (#106),
+/// the prior acquittal, the plunge-solid law of the 3D and multi-axis
+/// kinds, the cross-drill standoff (#77), the axial drill's reach and
+/// R-plane laws (#91) and the lathe meridian's bar (`revolved_bar`).
+/// Every kind passes that seam, so every kind with a non-stock source
+/// reads it. A stock-sourced op digests the stock as its source
+/// already (the `SrcRef::Stock` arm), so it needs no second term.
+#[must_use]
+pub fn reads_setup_stock(src: &SrcRef) -> bool {
+    !matches!(src, SrcRef::Stock)
+}
+
+fn w(h: &mut impl Hasher, v: f64) {
+    h.write(&v.to_bits().to_le_bytes());
+}
+
+fn write_placement(world: &World, entity: &Entity, h: &mut impl Hasher) {
+    let loc = model::transform_of(world, entity).unwrap_or_default();
+    for v in [loc.pos.x, loc.pos.y, loc.pos.z, loc.rot[0], loc.rot[1], loc.rot[2], loc.rot[3]] {
+        w(h, v);
+    }
+}
+
+/// The stock as a SOURCE: placement, then the shape's own parameters,
+/// and for stock from a model the copied mesh's signature. These bytes
+/// are the pre-#156 `SrcRef::Stock` arm's, unchanged, so no stock-
+/// sourced op churns. `None` when the entity carries no stock.
+pub(super) fn write_stock_source(world: &World, entity: &Entity, h: &mut impl Hasher) -> Option<()> {
+    write_placement(world, entity, h);
+    match model::stock_def_of(world, entity)? {
+        StockShape::Box { dx, dy, dz } => {
+            h.write_u8(0);
+            for v in [dx, dy, dz] {
+                w(h, v);
+            }
+        }
+        StockShape::Cylinder { diameter, height } => {
+            h.write_u8(1);
+            w(h, diameter);
+            w(h, height);
+        }
+        StockShape::FromModel { source } => {
+            h.write_u8(2);
+            h.write(source.as_bytes());
+            // M3.1 B: the name is provenance; what gets milled is the
+            // stock's own copy, so the copy is what the digest reads.
+            // UpdateModel re-derives the copy inside the update command
+            // (the propagation law), so an update to the source lands
+            // here as a moved signature - and a stock whose source was
+            // deleted stays honestly Ok, because the material it
+            // describes never changed. (M5.3 A: via the per-entity memo.)
+            h.write_u64(model::geometry_signature(world, entity)?);
+        }
+    }
+    Some(())
+}
+
+/// The setup's stock as an op READS it beside its source (#77, #91,
+/// generalised to every kind by #156): absent or present; placement;
+/// the mesh signature, which the command layer mirrors from the shape
+/// (so a box's size and a cylinder's diameter move it), and covers a
+/// mesh stock's own copy; then the shape's kind and parameters, so the
+/// term names the stock's definition, not only its tessellation.
+/// `None` when a present stock has no geometry left to digest - an
+/// unresolvable stamp, which reads Stale.
+pub(super) fn write_setup_stock(world: &World, setup: Option<&str>, h: &mut impl Hasher) -> Option<()> {
+    h.write_u8(b'X');
+    match model::find_by_name(world, &crate::setup::stock_entity_name(world, setup)) {
+        None => h.write_u8(0),
+        Some(e) => {
+            h.write_u8(1);
+            write_placement(world, &e, h);
+            h.write_u64(model::geometry_signature(world, &e)?);
+            match model::stock_def_of(world, &e) {
+                None => h.write_u8(0xff),
+                Some(StockShape::Box { dx, dy, dz }) => {
+                    h.write_u8(0);
+                    for v in [dx, dy, dz] {
+                        w(h, v);
+                    }
+                }
+                Some(StockShape::Cylinder { diameter, height }) => {
+                    h.write_u8(1);
+                    w(h, diameter);
+                    w(h, height);
+                }
+                Some(StockShape::FromModel { source }) => {
+                    h.write_u8(2);
+                    h.write(source.as_bytes());
+                }
+            }
+        }
+    }
+    Some(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_non_stock_source_reads_the_setup_stock() {
+        assert!(!reads_setup_stock(&SrcRef::Stock));
+        assert!(reads_setup_stock(&SrcRef::Entity("part".into())));
+        assert!(reads_setup_stock(&SrcRef::Selection(Vec::new())));
+    }
+}
diff --git a/crates/app/tests/stock_stamp.rs b/crates/app/tests/stock_stamp.rs
new file mode 100644
index 00000000..03ea5c81
--- /dev/null
+++ b/crates/app/tests/stock_stamp.rs
@@ -0,0 +1,125 @@
+//! Issue #156: an op's verdict reads the setup's stock (the rapid-in-
+//! stock laws, the prior acquittal), so its stamp digests that stock - a
+//! stock edit after generation marks it Stale and the post refuses until
+//! it is regenerated; an edit the verdict never read stales nothing, and
+//! undoing the stock edit returns the op to Ok.
+//!
+//! Provenance: our own fixtures (vertical_rapid_stock's 10 x 10 x 5 box
+//! under a contour, in a 100 x 100 block), specced from the Prime
+//! Directive and the shop rule "never traverse through uncut stock"; no
+//! vendor material.
+//!
+//! Gate map (#156): covers camcraft_app::operation (stamp, stamp_stock),
+//! camcraft_app::posting (the stale gate).
+//! Lane shape: all tests here run in seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{
+    AddTool, CreateOperation, GenerateOperation, History, ImportModel, SetStock, SetWorkMaterial,
+};
+use camcraft_app::geometry::{Point3, cube};
+use camcraft_app::machining2d::{Lead, Side};
+use camcraft_app::model;
+use camcraft_app::operation::{self, Height, OpParams, OpStatus, SrcRef};
+use camcraft_app::posting;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::{WorkMaterial, catalog};
+
+/// A contour of the 5 mm box: top 5, clearance 10, retract 8 - the
+/// plunge-height rapid lands at Z 7, beside the box.
+fn contour() -> OpParams {
+    OpParams::Contour {
+        tilt: None,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(10.0),
+        retract_z: Height::fixed(8.0),
+        top_z: Height::fixed(5.0),
+        bottom_z: Height::fixed(0.0),
+        stepdown: 2.5,
+        feed: 800.0,
+        plunge_feed: 200.0,
+        climb: true,
+        side: Side::Auto,
+        lead: Lead::None,
+        tolerance: 0.01,
+        tab_count: 0,
+        tab_width: 0.0,
+        tab_height: 0.0,
+        entry: camcraft_app::machining3d::Entry3D::Plunge,
+        helix_radius: 1.0,
+        blend_turns: false,
+        links: camcraft_app::links::Links::PLANAR,
+    }
+}
+
+fn block(dz: f64) -> StockShape {
+    StockShape::Box { dx: 100.0, dy: 100.0, dz }
+}
+
+/// The contour generated clean beside a block standing to its top.
+fn generated() -> (World, History) {
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    h.execute(&world, SetStock::new(&world, block(5.0), Default::default()).expect("box stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == "EM-0600-4FL").map(|(_, t)| t).expect("catalog");
+    h.execute(&world, AddTool::new(&world, "EM-0600-4FL", tool).expect("tool"));
+    h.execute(&world, ImportModel::from_mesh("part", cube(Point3::ZERO, Point3::new(10.0, 10.0, 5.0))));
+    let cmd = CreateOperation::new(&world, "Contour1", "EM-0600-4FL", SrcRef::Entity("part".into()), contour());
+    h.execute(&world, cmd.expect("create contour"));
+    h.execute(&world, GenerateOperation::new(&world, "Contour1").expect("generate"));
+    assert_eq!(status(&world), OpStatus::Ok, "the fixture generates Ok");
+    (world, h)
+}
+
+fn status(world: &World) -> OpStatus {
+    let e = model::find_by_name(world, "Contour1").expect("op");
+    operation::status_of(world, &e)
+}
+
+fn post(world: &World, tag: &str) -> Result<(), String> {
+    let p = std::env::temp_dir().join(format!("camcraft-stockstamp-{tag}-{}.nc", std::process::id()));
+    let _ = std::fs::remove_file(&p);
+    let r = posting::post_setup(world, &p).map(|_| ());
+    let _ = std::fs::remove_file(&p);
+    r
+}
+
+#[test]
+fn enlarging_the_stock_over_a_contours_dive_stales_it_and_blocks_the_post() {
+    let (world, mut h) = generated();
+    assert!(post(&world, "before").is_ok(), "the clean contour posts");
+    // The block grows to Z 10: the rapid 10 -> 7 beside the box now
+    // dives through 3 mm of uncut stock the cached verdict never saw.
+    h.execute(&world, SetStock::new(&world, block(10.0), Default::default()).expect("taller stock"));
+    assert_eq!(status(&world), OpStatus::Stale, "the verdict was judged against the old stock");
+    match post(&world, "grown") {
+        Ok(()) => panic!("a contour judged against the old stock posted"),
+        Err(e) => assert!(e.contains("Contour1") && e.contains("regenerate"), "refused, but not as stale: {e}"),
+    }
+}
+
+#[test]
+fn moving_the_stock_stales_the_contour() {
+    let (world, mut h) = generated();
+    let at = camcraft_app::schema::Location { pos: Point3::new(5.0, 0.0, 0.0), ..Default::default() };
+    h.execute(&world, SetStock::new(&world, block(5.0), at).expect("moved stock"));
+    assert_eq!(status(&world), OpStatus::Stale, "a moved stock is a moved input");
+}
+
+#[test]
+fn undoing_the_stock_edit_returns_the_contour_to_ok() {
+    let (world, mut h) = generated();
+    h.execute(&world, SetStock::new(&world, block(10.0), Default::default()).expect("taller stock"));
+    assert_eq!(status(&world), OpStatus::Stale);
+    assert!(h.undo(&world), "the stock edit undoes");
+    assert_eq!(status(&world), OpStatus::Ok, "the stock the verdict read is back");
+    assert!(post(&world, "undone").is_ok(), "and the program posts again");
+}
+
+#[test]
+fn the_work_material_is_not_a_stock_input() {
+    let (world, mut h) = generated();
+    h.execute(&world, SetWorkMaterial::new(&world, Some(WorkMaterial::MildSteel)).expect("material"));
+    assert_eq!(status(&world), OpStatus::Ok, "the material name never reached the verdict");
+}
