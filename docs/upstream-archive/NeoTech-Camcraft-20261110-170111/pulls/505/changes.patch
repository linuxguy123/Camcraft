diff --git a/assets/posts/tormach.cps b/assets/posts/tormach.cps
index 9fe9893a..583f2fc5 100644
--- a/assets/posts/tormach.cps
+++ b/assets/posts/tormach.cps
@@ -178,6 +178,50 @@ function onOpen() {
   block(["(" + nm + ")"]);
   block([inch ? "G20" : "G21", "G17", "G90", "G91.1", "G94", "G40", "G49", "G80"]);
   block(["G64", inch ? "P0.001" : "P0.025"]);
+  var z = safeZ();
