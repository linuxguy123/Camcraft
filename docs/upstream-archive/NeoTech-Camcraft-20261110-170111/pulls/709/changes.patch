+/// [`feature_graph_cached`] for a mounted mesh, memoized by its shared
+/// allocation first - what the per-frame hover pick calls for every body.
+#[must_use]
+pub fn feature_graph_shared(tris: &Arc<[Triangle]>) -> Arc<FeatureGraph> {
