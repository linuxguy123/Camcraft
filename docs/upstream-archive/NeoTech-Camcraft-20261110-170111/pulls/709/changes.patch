+    }
+    let g = feature_graph_cached(tris);
+    SHARED_CACHE.with(|cache| {
+        let mut cache = cache.borrow_mut();
+        if cache.len() >= SHARED_CAP {
+            cache.remove(0);
+        }
+        cache.push((key, g.clone()));
+    });
