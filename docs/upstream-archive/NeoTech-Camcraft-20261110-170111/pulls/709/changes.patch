+#[test]
+fn degenerate_input_picks_nothing_and_never_panics() {
+    let down = query([0.5, 0.5, 10.0], [0.0, 0.0, -1.0], Projection::Ortho, PickKinds::ALL);
+    assert_eq!(pick_bodies(&[], &down), None, "no bodies");
+    let empty = body("empty", Vec::new());
