    "node_id": "C_kwDOVVonwNoAKGM1NjVhYzdmNTJkNmIxOTcwZmI3Y2YzYjEwMWVmZWRiODczYTYyNTM",
    "commit": {
      "author": {
        "name": "NeoTech",
        "email": "andreas@roughedge.se",
