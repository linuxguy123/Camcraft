From a10081ac8f098d5c16387f6077cee342d83e96af Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Sat, 7 Nov 2026 13:25:23 -0800
Subject: [PATCH] fix(post): the Heidenhain DIN/ISO post declares the TNC's .I
 extension

A TNC ISO program carries the .I extension (HEIDENHAIN "TNC 640 User's
Manual, ISO programming", ID 892909-25, p. 143), but heidenhain.cps
still declared "nc". The engine never reads the manifest's extension,
so the posted text is unchanged; the value only matters when the file
reaches the control.

conformance.rs pins every shipped post's declared extension
(every_builtin_declares_its_controls_file_extension), so a new post
must name its own and a wrong one fails the suite.

Fixes #52

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqD6HVxwP41tn4T9DktF
---
 assets/posts/heidenhain.cps     |  4 +++-
 crates/app/tests/conformance.rs | 36 +++++++++++++++++++++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/assets/posts/heidenhain.cps b/assets/posts/heidenhain.cps
index 6fdd8c38..5d1fa430 100644
--- a/assets/posts/heidenhain.cps
+++ b/assets/posts/heidenhain.cps
@@ -14,7 +14,9 @@ vendor = "CamCraft (independent, unaffiliated)";
 legal = "Original clean-room work; public documentation only";
 certificationLevel = 1;
 minimumRevision = 1;
-extension = "nc";
+// TNC 640 User's Manual, ISO programming (ID 892909-25) p. 143: an
+// ISO program carries the .I extension (#52).
+extension = "I";
 setCodePage = "utf-8";
 capabilities = 1; // reference contract: integer feature mask (bit 1 = milling)
 
diff --git a/crates/app/tests/conformance.rs b/crates/app/tests/conformance.rs
index 14dff5b0..de1ccfab 100644
--- a/crates/app/tests/conformance.rs
+++ b/crates/app/tests/conformance.rs
@@ -339,3 +339,39 @@ fn every_builtin_registry_entry_compiles() {
         );
     }
 }
+
+/// (.cps file, the file extension its manifest declares). The engine
+/// never reads `extension`, so nothing else would catch a wrong one:
+/// #52 - a TNC ISO program is a `.I` file (HEIDENHAIN "TNC 640 User's
+/// Manual, ISO programming", ID 892909-25, p. 143); the rest write `.nc`.
+const EXTENSIONS: &[(&str, &str)] = &[
+    ("fanuc", "nc"),
+    ("haas", "nc"),
+    ("sinumerik", "nc"),
+    ("heidenhain", "I"),
+    ("mazak", "nc"),
+    ("fanuc-lathe", "nc"),
+];
+
+/// The top-level `extension = "..."` manifest line's value.
+fn declared_extension(script: &str) -> Option<&str> {
+    script
+        .lines()
+        .find_map(|l| l.strip_prefix("extension = \"")?.split_once('"').map(|(e, _)| e))
+}
+
+#[test]
+fn every_builtin_declares_its_controls_file_extension() {
+    let mut stems: Vec<&str> = POSTS.iter().map(|(_, s, _)| *s).collect();
+    stems.extend(LATHE_POSTS.iter().map(|(_, s)| *s));
+    let pinned: Vec<&str> = EXTENSIONS.iter().map(|(s, _)| *s).collect();
+    assert_eq!(pinned, stems, "every shipped post has its extension pinned");
+    for (stem, want) in EXTENSIONS {
+        let cps = read(&format!("assets/posts/{stem}.cps"));
+        assert_eq!(
+            declared_extension(&cps),
+            Some(*want),
+            "{stem}.cps declares the .{want} extension"
+        );
+    }
+}
