    "sha": "8768053fd23f31719a90f8b2d08628dc97e4a311",
    "node_id": "C_kwDOVVonwNoAKDg3NjgwNTNmZDIzZjMxNzE5YTkwZjhiMmQwODYyOGRjOTdlNGEzMTE",
    "commit": {
      "author": {
        "name": "NeoTech",
        "email": "andreas@roughedge.se",
