+/// Closest approach of a segment to the spindle in XY.
+fn approach(a: Point3, b: Point3) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let ll = dx * dx + dy * dy;
+    let t = if ll <= 0.0 { 0.0 } else { (-(a.x * dx + a.y * dy) / ll).clamp(0.0, 1.0) };
+    (a.x + t * dx).hypot(a.y + t * dy)
+}
