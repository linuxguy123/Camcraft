 crates/app/src/operation/generate.rs       |   8 +-
 crates/app/tests/drilling_cross_spindle.rs |   9 +-
 crates/app/tests/drilling_cross_stock.rs   |   7 +-
 crates/app/tests/lathe_cross_drill.rs      | 188 +++++++++++++++++++++
