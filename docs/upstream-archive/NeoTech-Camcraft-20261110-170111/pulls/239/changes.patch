+        for start in 0..n {
+            for step in [1, n - 1] {
+                let walk: Vec<_> = (0..n).map(|k| ring[(start + k * step) % n]).collect();
+                if best.as_ref().is_none_or(|old| walk < *old) {
+                    best = Some(walk);
+                }
+            }
+        }
+        best.unwrap_or_default()
+    }
