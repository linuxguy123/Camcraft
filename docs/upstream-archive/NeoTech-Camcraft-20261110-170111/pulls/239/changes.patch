+
+fn minimum_rotation(ring: &[(i64, i64)]) -> usize {
+    let n = ring.len();
+    let (mut i, mut j, mut k) = (0, 1, 0);
+    while i < n && j < n && k < n {
+        match ring[(i + k) % n].cmp(&ring[(j + k) % n]) {
+            std::cmp::Ordering::Equal => k += 1,
+            std::cmp::Ordering::Greater => {
+                i += k + 1;
+                if i <= j {
+                    i = j + 1;
+                }
+                k = 0;
+            }
+            std::cmp::Ordering::Less => {
+                j += k + 1;
+                if j <= i {
+                    j = i + 1;
+                }
+                k = 0;
+            }
+        }
+    }
+    i.min(j) % n
+}
