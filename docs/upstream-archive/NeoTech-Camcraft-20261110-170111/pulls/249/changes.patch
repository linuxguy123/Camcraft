From 72e784c151c9590c363588a857e63225d64e4af6 Mon Sep 17 00:00:00 2001
From: bherbruck <brennen.herbruck@gmail.com>
Date: Sat, 7 Nov 2026 20:28:31 -0500
Subject: [PATCH] fix(motion): a D-flat that faces the axis vouches for its
 roundness

Since #223 the axis fit's roundness readings use only facets whose
normal lines meet the axis within the concurrency tolerance, which
keeps an off-axis boss from lending its bearings - but a D-flat's facets
miss that line by part of the flat's width, so a single-band D-flat bar
read "share no rotation axis" and rotary_dflat went red on main. A facet
square to the axis whose line misses by less than half its own size
faces the axis (the foot of the axis is on the face): its normal now
counts in the coarseness gate and the point-share pencil check.

Fixes #246

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 RECOMMENDED.md                                | 22 +++++++++
 crates/motion/src/multiaxis/axis.rs           |  9 +++-
 crates/motion/src/multiaxis/axis_point.rs     | 27 +++++++++-
 .../motion/src/multiaxis/axis_point_tests.rs  | 49 +++++++++++++++++++
 4 files changed, 105 insertions(+), 2 deletions(-)

diff --git a/RECOMMENDED.md b/RECOMMENDED.md
index 0d1b65f2..6a29f328 100644
--- a/RECOMMENDED.md
+++ b/RECOMMENDED.md
@@ -13828,3 +13828,25 @@ inside, and they wrap as before.
   refusal under Adaptive and Offset rings.
 - Not done (follow-up worth an issue): rotate the development's branch to an azimuth
   where the work is turned, so a D-flat bar wraps whatever its placement.
+
+## #246 - a flat facing the axis is a bearing of the envelope (2026-11-08)
+
+- **Chosen:** `axis_point::faces_axis` - a facet square to the axis
+  (|n . u| < 0.05) whose centroid's normal line misses it by less than
+  half the facet's own size (`sqrt(area) / 2`) faces the axis: the foot
+  of the axis falls on the face (a D-flat). Its normal now counts in both
+  of #223's roundness readings - the coarseness gate's "facets that meet
+  the axis" and the point-share rule's pencil skip.
+- **Why:** #223 (rightly) stopped an off-axis boss lending its bearings,
+  by reading only facets whose lines meet the axis within the
+  concurrency tolerance. A D-flat's facets sit at the flat's width off
+  that line (0.2-0.4 mm on the rotary_dflat bar), so they were set aside
+  too, and a single-band D-flat bar - one wall pencil with a ~39 degree
+  skip at the flat - read "share no rotation axis". `rotary_dflat::
+  a_d_flat_bar_wraps_in_every_placement` was red on main from #223.
+- **Why the boss stays out:** a boss's facets miss the part's axis by
+  their offset (millimetres), far more than half their own size; every
+  #208/#223 boss/prism pin stays green.
+- **Dropped:** widening the concurrency tolerance (lets every outlier
+  vouch); exempting flats from the point-share rule wholesale (a prism's
+  faces are flats too - they must still not certify a 45 degree line).
diff --git a/crates/motion/src/multiaxis/axis.rs b/crates/motion/src/multiaxis/axis.rs
index 1caa3d5f..a6bd0694 100644
--- a/crates/motion/src/multiaxis/axis.rs
+++ b/crates/motion/src/multiaxis/axis.rs
@@ -320,7 +320,14 @@ pub(super) fn judge(data: &[Datum], ax: Axis, rho: f64, a_total: f64) -> Option<
     use super::axis_point::{borne_out, skip_budget, widest_skip};
     // Only the facets that MEET the axis may vouch for its roundness:
     // an outlier boss lent its bearings to a prism (review of PR #223).
-    let meets = data.iter().filter(|d| super::axis_robust::dist(d, ax).is_some_and(|e| e <= tol));
+    // #246: a flat that faces the axis squarely (a D-flat) meets it too -
+    // its centroid's line may miss by part of the flat's own width, but
+    // the foot of the axis lies on the face. Admitted: a facet square to
+    // the axis whose line misses by less than half its own size. An
+    // off-axis boss's facets miss by far more than their size.
+    let meets = data.iter().filter(|d| {
+        super::axis_robust::dist(d, ax).is_some_and(|e| e <= tol) || super::axis_point::faces_axis(d, ax)
+    });
     if widest_skip(meets.map(|d| d.n), u)? > skip_budget() {
         return None;
     }
diff --git a/crates/motion/src/multiaxis/axis_point.rs b/crates/motion/src/multiaxis/axis_point.rs
index a0618513..0d5d2f2f 100644
--- a/crates/motion/src/multiaxis/axis_point.rs
+++ b/crates/motion/src/multiaxis/axis_point.rs
@@ -71,6 +71,22 @@ const LAT_WIDE: f64 = 0.05;
 /// pencil counts as off its cones: far above a mesh's rounding.
 const LAT_FLOOR: f64 = 2e-3;
 
+/// A facet counts as square to the axis when its normal's axial
+/// component stays under this (#246).
+const FLAT_SQUARE: f64 = 0.05;
+
+/// Does `d` face the axis squarely - a flat (a D-flat, a square plate's
+/// side) whose plane the axis's foot falls on (#246)? Its centroid's
+/// normal line may miss the axis by part of the flat's own width, so the
+/// concurrency tolerance sets it aside; but the flat's normal IS a
+/// bearing the revolve's envelope shows, and the coarseness readings must
+/// see it. Admitted: a facet square to the axis whose line misses by less
+/// than half its own size. An off-axis boss's facets miss by far more
+/// than their size, so they still lend nothing (review of PR #223).
+pub(super) fn faces_axis(d: &Datum, ax: Axis) -> bool {
+    d.n.dot(ax.dir).abs() < FLAT_SQUARE && dist(d, ax).is_some_and(|e| e <= 0.5 * d.a.max(0.0).sqrt())
+}
+
 /// The widest empty skip (radians) between the bearings about `u` of
 /// the normals `ns`; `None` when too few bear an azimuth to call
 /// anything round. `sqrt(8 * REL_TOL)` is the chord-sagitta budget in
@@ -104,6 +120,11 @@ pub(super) fn skip_budget() -> f64 {
 /// inliers must also pass the coarseness gate by itself.
 pub(super) fn borne_out(data: &[Datum], ax: Axis, tol: f64) -> bool {
     let mut rest: Vec<&Datum> = data.iter().filter(|d| dist(d, ax).is_some_and(|e| e <= tol)).collect();
+    let flats: Vec<Point3> = data
+        .iter()
+        .filter(|d| dist(d, ax).is_some_and(|e| e > tol) && faces_axis(d, ax))
+        .map(|d| d.n)
+        .collect();
     let a_in: f64 = rest.iter().map(|d| d.a).sum();
     if a_in <= 0.0 || !a_in.is_finite() {
         return true; // judge's share gate speaks for an empty set
@@ -118,7 +139,11 @@ pub(super) fn borne_out(data: &[Datum], ax: Axis, tol: f64) -> bool {
         if near.len() < 3 || a_near < MIN_PENCIL * a_in {
             break;
         }
-        if a_near >= POINT_SHARE * a_in && widest_skip(near.iter().map(|d| d.n), ax.dir).is_none_or(|g| g > skip_budget()) {
+        // The pencil's bearings, plus the flats that face the axis (#246):
+        // a single-band D-flat bar's wall is one pencil whose skip at the
+        // flat is the flat's own width - the flat's normal fills it.
+        let skip = widest_skip(near.iter().map(|d| d.n).chain(flats.iter().copied()), ax.dir);
+        if a_near >= POINT_SHARE * a_in && skip.is_none_or(|g| g > skip_budget()) {
             return false;
         }
         biased += off_cone(&near, ax.dir).unwrap_or(1.0) * a_near + ringless(&near, ax.dir);
diff --git a/crates/motion/src/multiaxis/axis_point_tests.rs b/crates/motion/src/multiaxis/axis_point_tests.rs
index a40c8921..fdaccd83 100644
--- a/crates/motion/src/multiaxis/axis_point_tests.rs
+++ b/crates/motion/src/multiaxis/axis_point_tests.rs
@@ -285,3 +285,52 @@ fn a_square_plate_with_a_centred_bore_reads_its_axis() {
         assert!((ax.origin.x.powi(2) + ax.origin.y.powi(2)).sqrt() < 1e-6, "bore r{r} t{t}: {ax:?}");
     }
 }
+
+/// A single-band bar of radius 6 over z -20..20, 64 round, with a D-flat
+/// ground through both ends at depth `d` along `phi` (ring points past
+/// the flat's plane pushed onto it), capped by fans.
+fn dflat_bar(phi: f64, d: f64) -> Vec<Triangle> {
+    let ring = |z: f64| -> Vec<Point3> {
+        (0..64)
+            .map(|j| {
+                let th = std::f64::consts::TAU * j as f64 / 64.0;
+                let (mut x, mut y) = (6.0 * th.cos(), 6.0 * th.sin());
+                let over = x * phi.cos() + y * phi.sin() - d;
+                if over > 0.0 {
+                    x -= over * phi.cos();
+                    y -= over * phi.sin();
+                }
+                Point3::new(x, y, z)
+            })
+            .collect()
+    };
+    let (a, b) = (ring(-20.0), ring(20.0));
+    let same = |p: Point3, q: Point3| (p - q).dot(p - q) < 1e-24;
+    let mut f = Vec::new();
+    let mut tri = |p: Point3, q: Point3, r: Point3| {
+        if !(same(p, q) || same(q, r) || same(r, p)) {
+            f.push(Triangle::new(p, q, r));
+        }
+    };
+    for j in 0..64 {
+        let k = (j + 1) % 64;
+        tri(a[j], a[k], b[k]);
+        tri(a[j], b[k], b[j]);
+        tri(Point3::new(0.0, 0.0, -20.0), a[k], a[j]);
+        tri(Point3::new(0.0, 0.0, 20.0), b[j], b[k]);
+    }
+    f
+}
+
+#[test]
+fn a_single_band_d_flat_bar_reads_its_axis() {
+    // Issue #246: the flat's facets miss the axis by part of the flat's
+    // width, so #223's coarseness readings set them aside and the single
+    // wall pencil's skip at the flat (~39 degrees) refused the true axis.
+    // A flat that faces the axis squarely is a bearing of the envelope.
+    for phi in [0.0, std::f64::consts::FRAC_PI_2, -std::f64::consts::FRAC_PI_2, 2.3] {
+        let r = fit_report(&dflat_bar(phi, 5.8)).unwrap_or_else(|e| panic!("phi {phi}: {e}"));
+        let d = r.axis.dir;
+        assert!(d.x.abs() < 1e-6 && d.y.abs() < 1e-6, "phi {phi}: {r:?}");
+    }
+}
