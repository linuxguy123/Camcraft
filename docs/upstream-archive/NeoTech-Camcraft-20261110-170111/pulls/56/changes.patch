From 2475d9cb2b59a65211da88449ebee2f3800b5121 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 7 Nov 2026 10:21:19 +0100
Subject: [PATCH 1/2] docs(agents): main is protected - PR only (admins too),
 no force-push or deletion, merge commits only

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 AGENTS.md | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/AGENTS.md b/AGENTS.md
index bcc9e043..300016b5 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -430,6 +430,16 @@ a tag"):
    start the cut again from step 2 on a fresh release branch. Comment
    `shipped in vX.Y.Z` on every issue the cut closed.
 
+**`main` is protected on GitHub** (user, 2026-11-07: "so we don't get
+unauthorized pushes into main instead they follow the rules"): every change
+reaches it through a PR (0 approvals required - the agent and the user push
+as the same account, which cannot approve its own PR; the review is the
+subagent's), admins included; no force-push, no deletion; open review
+conversations must be resolved before a merge; the repo allows merge
+commits only (squash and rebase merging are off). A direct `git push origin
+main` is refused by GitHub - the legacy direct cut is gone. Tags are not
+covered and are pushed as before (step 4).
+
 Docs-, process- and CI-only PRs (no behaviour, no release) merge once
 reviewed by a subagent that did not write them, without waiting for a cut;
 the main session merges them (`gh pr merge --merge --delete-branch`),

From 506113afbd0dc567a10d532dbd8470949d499220 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 7 Nov 2026 10:21:53 +0100
Subject: [PATCH 2/2] build(release): release.ps1 requires -NoTag - main is
 protected, so the direct tagging cut is refused up front

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/release.ps1 | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/scripts/release.ps1 b/scripts/release.ps1
index a4e22d8b..8782ad2f 100644
--- a/scripts/release.ps1
+++ b/scripts/release.ps1
@@ -74,7 +74,7 @@ if ($LASTEXITCODE -ne 0) { Fail "git rev-parse failed" }
 # Branch/PR flow: the bump is committed on release/vX.Y.Z (-NoTag), never on
 # main; a tagging run is the legacy direct cut and belongs on main only.
 if ($NoTag -and $branchNow -eq "main") { Fail "-NoTag runs on a release/v$Version branch, not on main" }
-if (-not $NoTag -and $branchNow -ne "main") { Fail "a tagging cut runs on main; on $branchNow use -NoTag (tag main after the release PR merges)" }
+if (-not $NoTag) { Fail "main is branch-protected (PR only): cut on release/v$Version with -NoTag and tag main after the release PR merges" }
 $existing = git tag --list $tag
 if ($LASTEXITCODE -ne 0) { Fail "git tag failed" }
 if ($existing) { Fail "tag $tag already exists" }
@@ -223,7 +223,7 @@ if ($NoTag) {
     Write-Host "      record tip=`$(git rev-parse $branch) before merging; after it merges: git switch main; git pull --ff-only;"
     Write-Host "      git diff `$tip main must be empty, then git tag -a $tag -m 'CamCraft $Version' main; git push origin $tag"
 } else {
-    Write-Host "Legacy direct cut (only when the user directs it): git push origin main && git push origin $tag"
+    Write-Host "main is branch-protected: a direct push is refused. Cut on release/v$Version with -NoTag (AGENTS.md 'A cut goes PR review')."
 }
 Write-Host "NOTHING WAS PUSHED. Pushing is left to you."
 exit 0
