diff --git a/assets/posts/fanuc.cps b/assets/posts/fanuc.cps
index f85b8e96..9afe94b3 100644
--- a/assets/posts/fanuc.cps
+++ b/assets/posts/fanuc.cps
@@ -54,6 +54,16 @@ function fu(v) {  // mm at three decimals, trailing zeros trimmed
   if (s.indexOf(".") >= 0) s = s.replace(/0+$/, "").replace(/\.$/, "");
   return s === "-0" ? "0" : s;
 }
+// #377: `expr - v` as a macro-B expression with v's sign folded into the
+// operator, so a negative v never writes a doubled sign (`#100--15`).
+// Macro B's arithmetic form is `#i=#j-#k` / `#i=#j+#k` (Fanuc custom
+// macro B, published operator documentation); a value that formats to 0
+// (including -0 and anything under half a micron) adds no term.
+function minusU(expr, v) {
+  var s = fu(v);
+  if (s === "0") return expr;
+  return s.charAt(0) === "-" ? expr + "+" + s.substring(1) : expr + "-" + s;
+}
 function ff(v) { return has(v) && v > 0 ? String(Math.round(v)) : "0"; }
 function w(letter, v) { return has(v) ? letter + fu(v) : ""; }
 function fw(v) { return has(v) ? "F" + ff(v) : ""; }
@@ -469,7 +479,7 @@ function onProbeMove() {
   var d = [Math.abs(p.X - p.ExpectX), Math.abs(p.Y - p.ExpectY), Math.abs(p.Z - p.ExpectZ)];
   var ai = d[0] >= d[1] && d[0] >= d[2] ? 0 : (d[1] >= d[2] ? 1 : 2);
   var tgt = [p.X - orgX, p.Y - orgY, p.Z - orgZ][ai];
-  block(["IF[ABS[#" + (5061 + ai) + "-" + fu(tgt) + "]LT0.001]THEN#3000=2(PROBE NO CONTACT)"]);
+  block(["IF[ABS[" + minusU("#" + (5061 + ai), tgt) + "]LT0.001]THEN#3000=2(PROBE NO CONTACT)"]);
   if (has(p.Measure) && p.Measure >= 0) {
     var b = probeBase + 3 * p.Measure;
     block(["#" + b + "=#5061"]);
@@ -497,7 +507,7 @@ function onProbeResult() {
     var sum = [];
     for (var k = 0; k < a.Measures.length; k++) sum.push("#" + (probeBase + 3 * a.Measures[k] + ai));
     var mean = a.Measures.length > 1 ? "[[" + sum.join("+") + "]/" + a.Measures.length + "]" : sum[0];
-    block(["#" + (dev + i) + "=" + mean + "-" + fu(a.Expected - org[ai])]);
+    block(["#" + (dev + i) + "=" + minusU(mean, a.Expected - org[ai])]);
     block(["IF[ABS[#" + (dev + i) + "]GT" + fu(p.Tolerance) + "]THEN#3000=1(PROBE " + a.Axis + " OUT OF TOLERANCE)"]);
   }
   if (has(p.SetWorkOffset) && p.SetWorkOffset >= 0) {
diff --git a/crates/app/tests/fanuc_post.rs b/crates/app/tests/fanuc_post.rs
index b0bbd872..09acdc74 100644
--- a/crates/app/tests/fanuc_post.rs
+++ b/crates/app/tests/fanuc_post.rs
@@ -4,9 +4,14 @@
 //! either changes meaning, this test says so, and the diff is the
 //! review (UPDATE workflow per tests/golden/CLAUDE.md).
 //!
-//! Gate map (M4.4): covers app::post.
+//! Gate map (M4.4): covers app::post, motion::probing (probe result
+//! arithmetic, #377).
 
-use camcraft_app::post::{cnc, engine};
+mod common;
+
+use camcraft_app::geometry::Point3;
+use camcraft_app::post::{self, cnc, engine};
+use camcraft_app::probing::{probe_cycle, ProbeDir, ProbeMode, ProbeParams};
 use std::path::{Path, PathBuf};
 
 fn repo(rel: &str) -> PathBuf {
@@ -269,3 +274,80 @@ fn non_rtcp_dialects_refuse_a_tilted_stream() {
         );
     }
 }
+
+// ------------------------------------------------------------ #377
+// A probe result's deviation is `found - expected`. Edge and outside-corner
+// probes whose expected value is negative in the work offset once wrote a
+// doubled sign (`#190=#100--15`); the sign now folds into the operator
+// (`#190=#100+15`), the arithmetic form Fanuc's published custom macro B
+// documentation gives (`#i=#j+#k`, `#i=#j-#k`).
+
+fn probe(mode: ProbeMode, target: Point3) -> ProbeParams {
+    ProbeParams {
+        mode,
+        dir: ProbeDir::XPos,
+        dir_y: ProbeDir::YPos,
+        target,
+        radius: 0.0,
+        ball_diameter: 4.0,
+        approach: 5.0,
+        overtravel: 5.0,
+        backoff: 1.0,
+        fast_feed: 300.0,
+        slow_feed: 30.0,
+        depth: 3.0,
+        inset: 5.0,
+        clearance_z: 50.0,
+    }
+}
+
+/// Posts a probe cycle through the whole seam (dump -> stream -> fanuc.cps)
+/// setting G54, and refuses any doubled sign on any line.
+fn post_probe(p: &ProbeParams) -> String {
+    let t = probe_cycle(p).expect("probe cycle");
+    let d = post::Dump {
+        op_name: "Probe1",
+        tool_number: 7,
+        tool_name: "PROBE-4",
+        tool_diameter: 4.0,
+        clearance_z: 50.0,
+        retract_z: 50.0,
+        probe_result: Some(post::probe_rec::ProbeResult { set_wcs: Some(0), tol_mm: 0.5 }),
+        ..post::Dump::default()
+    };
+    let stream = cnc::serialize(&post::dump(&t, &d));
+    let out = engine::run(&read("assets/posts/fanuc.cps"), &serde_json::Value::Null, &stream).expect("post");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    for l in out.program.lines() {
+        assert!(!l.contains("--") && !l.contains("+-") && !l.contains("-+"), "doubled sign in `{l}`");
+    }
+    out.program
+}
+
+#[test]
+fn edge_probe_at_negative_x_folds_the_sign() {
+    let nc = post_probe(&probe(ProbeMode::Edge, Point3::new(-15.0, 5.0, 20.0)));
+    // The nominal trip is the ball centre, a radius short of the edge: -17.
+    assert!(nc.lines().any(|l| l == "#190=#100+17"), "{nc}");
+    assert!(nc.contains("IF[ABS[#5061+12]"), "the no-contact check folds a negative target too: {nc}");
+    common::write_golden("nc/fanuc/probe_edge_negative_x.nc", &nc);
+}
+
+#[test]
+fn corner_probe_at_negative_xy_folds_both_signs() {
+    let nc = post_probe(&probe(ProbeMode::Corner, Point3::new(-15.0, -10.0, 20.0)));
+    assert!(nc.lines().any(|l| l == "#190=#100+17"), "{nc}");
+    assert!(nc.lines().any(|l| l == "#191=#104+12"), "{nc}");
+    common::write_golden("nc/fanuc/probe_corner_negative.nc", &nc);
+}
+
+#[test]
+fn edge_probe_at_zero_writes_the_bare_mean() {
+    // An edge at X 2 trips the 4 mm ball's centre at X 0: expected 0 adds
+    // no `-0` / `+0` term, just the measured value. A hair under it
+    // (formats to -0) does the same.
+    let nc = post_probe(&probe(ProbeMode::Edge, Point3::new(2.0, 5.0, 20.0)));
+    assert!(nc.lines().any(|l| l == "#190=#100"), "{nc}");
+    let nc = post_probe(&probe(ProbeMode::Edge, Point3::new(2.0 - 1e-7, 5.0, 20.0)));
+    assert!(nc.lines().any(|l| l == "#190=#100"), "{nc}");
+}
