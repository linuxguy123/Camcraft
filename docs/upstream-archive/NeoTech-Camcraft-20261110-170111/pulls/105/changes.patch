+fn mv(kind: MoveKind, z0: f64, z1: f64) -> Move {
+    Move {
+        kind,
+        from: Point3::new(0.0, 0.0, z0),
+        to: Point3::new(0.0, 0.0, z1),
+        feed: if kind == MoveKind::Rapid { None } else { Some(80.0) },
+        arc: None,
+        axis: None,
+    }
+}
+
+/// `moves` on a drill over a stock box whose top is Z 25, clearance 35.
+fn judge(moves: Vec<Move>) -> Vec<Warning> {
+    let p = Toolpath { moves, cycles: Vec::new(), notes: Vec::new(), comps: Vec::new() };
+    let region = rect();
+    let tool = ToolGeom {
+        radius: 2.0,
+        nose_radius: 0.0,
+        flute_len: 30.0,
+        shank_radius: 2.0,
+        shank_len: 20.0,
+        holder_radius: 2.0,
+        holder_len: 1.0,
+    };
+    let cx = VerifyContext {
+        region: &region,
+        stock: Some(&region),
+        model: None,
+        tool: &tool,
+        cutter: None,
+        mode: Mode::Area,
+        stock_top_z: 25.0,
+        clearance_z: 35.0,
+        stock_to_leave: 0.0,
+        gouge_tol: 0.01,
+        z_tol: 1e-3,
+        finish_tol: None,
+        fixtures: &[],
+        spindle: None,
+    };
+    verify(&p, &cx)
+}
