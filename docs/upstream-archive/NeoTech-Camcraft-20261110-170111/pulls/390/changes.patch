+                .map_err(|e| CommandError::Invalid(format!("post script {path} does not run: {e}")))?;
+        }
+        PostRef::Named(name) => {
+            if !posting::BUILTINS.iter().any(|(n, _)| n == name) {
+                return Err(CommandError::Invalid(format!(
+                    "built-in post {name} is not in the registry"
+                )));
+            }
+        }
+        PostRef::Builtin => {}
+    }
