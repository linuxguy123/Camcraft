-                    format!("{label} (current)")
-                } else if armed {
-                    format!("Confirm change to {label}")
-                } else {
-                    (*label).to_owned()
-                };
-                p.text(
-                    r.left_center() + Vec2::new(8.0, 0.0),
-                    egui::Align2::LEFT_CENTER,
-                    &text,
-                    egui::FontId::proportional(pal.font_row),
-                    match item {
-                        None => pal.text_dim,
