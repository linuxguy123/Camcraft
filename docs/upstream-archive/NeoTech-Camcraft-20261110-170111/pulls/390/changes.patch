diff --git a/crates/ui/src/egui_app/tests/setup_tree.rs b/crates/ui/src/egui_app/tests/setup_tree.rs
new file mode 100644
index 00000000..bacd0f15
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/setup_tree.rs
@@ -0,0 +1,166 @@
+//! #343 in the browser: each setup is a node with a radio (the active
+//! setup) and its own WCS, Stock, Machine, Post, Fixtures (each fixture a
+//! child), Tool list and Operations; a document without setups shows the
+//! same children for its implicit setup. The radio activates undoably;
+//! each node opens its page - activating its setup first, so no editor
+//! ever edits a setup the node does not belong to; the machine and post
+//! verbs land on the active setup's own mount when it has one.
+//! Provenance: our own tests over our own shell; no HSMWorks material.
+
+use super::*;
+use crate::state::SetupPage;
+use camcraft_app::posting;
+use camcraft_app::schema::PostRef;
+use super::super::browser_pane;
+use super::super::browser_tree::Leaf;
+
+fn run(state: &mut State, k: CommandKind) {
+    state.pending.push_back(k);
+    state.drain_actions();
+}
+
+/// (label, depth, leaf) for every row.
+fn tree(state: &State) -> Vec<(String, usize, Leaf)> {
+    let (rows, leaves) = panes::browser_rows(state);
+    rows.iter().zip(leaves).map(|(r, l)| (r.label.clone(), r.depth, l)).collect()
+}
+
+/// The labels of `setup`'s children, in order, from its node to the next
+/// row at its own depth.
+fn children(state: &State, setup: &str) -> Vec<String> {
+    let rows = tree(state);
+    let Some(at) = rows.iter().position(|(_, _, l)| *l == Leaf::Setup(setup.to_owned())) else {
+        return Vec::new();
+    };
+    let depth = rows[at].1;
+    rows[at + 1..].iter().take_while(|(_, d, _)| *d > depth).filter(|(_, d, _)| *d == depth + 1).map(|(n, _, _)| n.clone()).collect()
+}
+
+const NODES: [&str; 7] = ["WCS", "Stock", "Machine", "Post", "Fixtures", "Tool list", "Operations"];
+
+#[test]
+fn every_setup_owns_its_nodes_in_order() {
+    let mut state = State::new();
+    // No setups: the implicit setup's nodes stand straight under Setup.
+    let rows = tree(&state);
+    let flat: Vec<&str> = rows.iter().filter(|(_, d, _)| *d == 1).map(|(n, _, _)| n.as_str()).collect();
+    assert_eq!(&flat[..9], ["Setups", "WCS", "Stock", "Machine", "Post", "Fixtures", "Tool list", "Operations", "(no models yet)"]);
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    for s in ["Setup1", "Setup2"] {
+        assert_eq!(children(&state, s), NODES, "{s}'s nodes");
+    }
+    let (rows, leaves) = panes::browser_rows(&state);
+    let node = |s: &str| leaves.iter().position(|l| *l == Leaf::Setup(s.to_owned())).expect("setup node");
+    assert_eq!(rows[node("Setup2")].kind, painted::Kind::Setup(true), "the last created is active");
+    assert_eq!(rows[node("Setup1")].kind, painted::Kind::Setup(false));
+    assert!(!rows.iter().any(|r| r.label == "Operations" && r.depth == 0), "no document-wide Operations section");
+}
+
+#[test]
+fn operations_and_fixtures_sit_under_their_own_setup() {
+    let mut shell = ShellUi::seeded();
+    let state = &mut shell.state;
+    run(state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(state, CommandKind::CreateSetup { name: None, datum_from: None });
+    let source = model::find_by_name(&state.world, "Contour1").expect("seed op");
+    let def = model::operation_of(&state.world, &source).expect("definition");
+    run(state, CommandKind::CreateOperation { name: "Contour2".into(), tool: def.tool, src: def.src, params: def.params });
+    let rows = tree(state);
+    let op = |n: &str| rows.iter().position(|(_, _, l)| *l == Leaf::Op(n.to_owned())).expect("op row");
+    let node = |s: &str| rows.iter().position(|(_, _, l)| *l == Leaf::Setup(s.to_owned())).expect("node");
+    assert!(node("Setup1") < op("Contour1") && op("Contour1") < node("Setup2"), "Contour1 is Setup1's");
+    assert!(op("Contour2") > node("Setup2"), "Contour2 joined the active Setup2");
+    assert_eq!(rows[op("Contour1")].1, 3, "setup / Operations / op");
+    // Setup1's tool list counts the seed's tool.
+    let (r, l) = panes::browser_rows(state);
+    let tools = l.iter().position(|x| *x == Leaf::Page("Setup1".into(), SetupPage::Tools)).expect("tool list");
+    assert_eq!(r[tools].suffix, "1 tool");
+}
+
+#[test]
+fn the_radio_activates_a_setup_undoably() {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup2"));
+    browser_pane::focus(&mut state, "Setup1");
+    state.drain_actions();
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup1"));
+    browser_pane::focus(&mut state, "Setup1");
+    assert!(state.pending.is_empty(), "the active setup's radio queues nothing");
+    run(&mut state, CommandKind::Undo);
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup2"), "undo restores");
+}
+
+#[test]
+fn each_node_opens_its_page_and_activates_its_setup_first() {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    for (leaf, want) in [
+        (Leaf::Wcs("Setup1".into()), UiTarget::Wcs),
+        (Leaf::Stock("Setup1".into()), UiTarget::Stock),
+        (Leaf::Page("Setup1".into(), SetupPage::Machine), UiTarget::SetupNode("Setup1".into(), SetupPage::Machine)),
+        (Leaf::Page("Setup1".into(), SetupPage::Post), UiTarget::SetupNode("Setup1".into(), SetupPage::Post)),
+        (Leaf::Page("Setup1".into(), SetupPage::Fixtures), UiTarget::SetupNode("Setup1".into(), SetupPage::Fixtures)),
+        (Leaf::Page("Setup1".into(), SetupPage::Tools), UiTarget::SetupNode("Setup1".into(), SetupPage::Tools)),
+    ] {
+        run(&mut state, CommandKind::ActivateSetup(Some("Setup2".into())));
+        browser_pane::click(&mut state, leaf.clone());
+        state.drain_actions();
+        assert_eq!(state.pane_target(), want, "{leaf:?}");
+        assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup1"), "{leaf:?} activates Setup1");
+    }
+    // The setup row opens its settings and activates nothing.
+    browser_pane::click(&mut state, Leaf::Setup("Setup2".into()));
+    state.drain_actions();
+    assert_eq!(state.pane_target(), UiTarget::SetupNode("Setup2".into(), SetupPage::Settings));
+    assert_eq!(camcraft_app::setup::active(&state.world).as_deref(), Some("Setup1"));
+}
+
+#[test]
+fn the_machine_and_post_pages_render_for_a_setup() {
+    let mut harness = shell_harness();
+    harness.state_mut().state.pending.push_back(CommandKind::CreateSetup { name: None, datum_from: None });
+    harness.run_steps(2);
+    for (page, heading) in [
+        (SetupPage::Machine, "Machine - Setup1"),
+        (SetupPage::Post, "Post - Setup1"),
+        (SetupPage::Fixtures, "Fixtures - Setup1"),
+        (SetupPage::Tools, "Tool list - Setup1"),
+        (SetupPage::Settings, "Setup1"),
+    ] {
+        crate::actions::target(&mut harness.state_mut().state, UiTarget::SetupNode("Setup1".into(), page));
+        harness.run_steps(2);
+        assert!(harness.query_by_label(heading).is_some(), "{heading}");
+    }
+    assert!(harness.query_by_label_contains("This setup has its own post").is_none(), "settings page shows no mount radio");
+}
+
+#[test]
+fn machine_and_post_verbs_land_on_the_active_setups_own_mount() {
+    let mut state = State::new();
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    run(&mut state, CommandKind::CreateSetup { name: None, datum_from: None });
+    // Setup2 (active) takes its own post: the post verbs now edit only it.
+    run(&mut state, CommandKind::SetupOwnPost { setup: "Setup2".into(), own: true });
+    assert_eq!(camcraft_app::setup_mount::own_post(&state.world, Some("Setup2")), Some(PostRef::Builtin));
+    run(&mut state, CommandKind::SelectPostNamed("Haas".into()));
+    assert_eq!(camcraft_app::setup_mount::own_post(&state.world, Some("Setup2")), Some(PostRef::Named("Haas".into())));
+    assert_eq!(posting::document_post_of(&state.world), PostRef::Builtin, "the document's post is untouched");
+    assert_eq!(camcraft_app::setup_mount::post_of(&state.world, Some("Setup1")), PostRef::Builtin);
+    // The machine verbs the same way.
+    run(&mut state, CommandKind::SetupOwnMachine { setup: "Setup2".into(), own: true });
+    run(&mut state, CommandKind::LoadBuiltinMachine("Lathe".into()));
+    assert_eq!(camcraft_app::machine::kind_of(&state.world), camcraft_app::machine::Kind::Lathe);
+    assert!(camcraft_app::machine::document_of(&state.world).1.is_none(), "the document mounts nothing still");
+    run(&mut state, CommandKind::ActivateSetup(Some("Setup1".into())));
+    assert_eq!(camcraft_app::machine::kind_of(&state.world), camcraft_app::machine::Kind::Mill, "Setup1 follows the document");
+    // Undo walks every step back: Setup2 follows the document again.
+    for _ in 0..5 {
+        run(&mut state, CommandKind::Undo);
+    }
+    assert_eq!(camcraft_app::setup_mount::own_post(&state.world, Some("Setup2")), None);
+    assert_eq!(camcraft_app::setup_mount::own_machine(&state.world, Some("Setup2")), None);
+}
diff --git a/crates/ui/src/egui_app/tree_glyphs.rs b/crates/ui/src/egui_app/tree_glyphs.rs
new file mode 100644
index 00000000..12668efe
--- /dev/null
+++ b/crates/ui/src/egui_app/tree_glyphs.rs
@@ -0,0 +1,100 @@
+//! The browser tree's painted marks (split from `painted`, #343): the
+//! ~9-px per-kind glyphs - the no-GPU twins of the bundled PNGs - and the
+//! eye. Original geometry.
+//! Provenance: our own drawings; no vendor material consulted.
+
+use egui::{Color32, Pos2, Rect, Shape, Stroke, Vec2};
+
+use super::painted::Kind;
+use super::theme::Tokens;
+
+/// The ~9-px marks, per kind: original geometry, one stroke family.
+pub(super) fn glyph(shapes: &mut Vec<Shape>, c: Pos2, kind: Kind, pal: &Tokens) {
+    let s = Stroke::new(1.0, pal.text_dim);
+    match kind {
+        Kind::Parent(expanded) => {
+            let points = if expanded {
+                vec![c + Vec2::new(-4.0, -2.0), c + Vec2::new(4.0, -2.0), c + Vec2::new(0.0, 3.0)]
+            } else {
+                vec![c + Vec2::new(-2.0, -4.0), c + Vec2::new(3.0, 0.0), c + Vec2::new(-2.0, 4.0)]
+            };
+            shapes.push(Shape::convex_polygon(points, pal.text_dim, Stroke::NONE));
+        }
+        Kind::Section => {
+            // Open folder: a body with a back-tab.
+            let body = Rect::from_min_size(c + Vec2::new(-5.0, -3.0), Vec2::new(10.0, 7.0));
+            shapes.push(Shape::rect_stroke(body, 1.0, s, egui::StrokeKind::Middle));
+            shapes.push(Shape::rect_filled(
+                Rect::from_min_size(body.left_top() + Vec2::new(1.0, -2.5), Vec2::new(4.0, 2.5)),
+                0.0,
+                pal.text_dim,
+            ));
+        }
+        Kind::Model => {
+            let r = Rect::from_center_size(c, Vec2::new(9.0, 7.0));
+            shapes.push(Shape::rect_stroke(r, 0.0, s, egui::StrokeKind::Middle));
+        }
+        Kind::Fixture => {
+            // The vise: two parallel jaws, the screw shaft running from
+            // the movable one, a solid knob. The PNG twin's geometry at
+            // tree scale, drawn from what it names - original.
+            let jaw = Vec2::Y * 3.5;
+            for dx in [-4.0, -0.5] {
+                let p = c + Vec2::X * dx;
+                shapes.push(Shape::line_segment([p - jaw, p + jaw], s));
+            }
+            shapes.push(Shape::line_segment(
+                [c + Vec2::X * -0.5, c + Vec2::X * 2.8],
+                s,
+            ));
+            shapes.push(Shape::circle_filled(c + Vec2::X * 4.0, 1.3, pal.text_dim));
+        }
+        Kind::Stock => {
+            let r = Rect::from_center_size(c, Vec2::new(9.0, 8.0));
+            shapes.push(Shape::rect_stroke(r, 0.0, s, egui::StrokeKind::Middle));
+            shapes.push(Shape::line_segment([r.left_top(), r.right_bottom()], s));
+        }
+        Kind::Wcs => {
+            shapes.push(Shape::line_segment([c - Vec2::X * 4.5, c + Vec2::X * 4.5], s));
+            shapes.push(Shape::line_segment([c - Vec2::Y * 4.5, c + Vec2::Y * 4.5], s));
+        }
+        Kind::Tool => {
+            shapes.push(Shape::circle_stroke(c, 4.0, s));
+        }
+        Kind::Setup(active) => {
+            shapes.push(Shape::circle_stroke(c, 5.0, Stroke::new(1.5, pal.text_dim)));
+            if active {
+                shapes.push(Shape::circle_filled(c, 2.8, pal.accent));
+            }
+        }
+        Kind::Op => {
+            // A play-triangle in a square frame: "this op owns a path",
+            // drawn from what it names, original.
+            let r = Rect::from_center_size(c, Vec2::new(9.0, 9.0));
+            shapes.push(Shape::rect_stroke(r, 1.0, s, egui::StrokeKind::Middle));
+            shapes.push(Shape::convex_polygon(
+                vec![
+                    Pos2::new(c.x - 1.8, c.y - 3.0),
+                    Pos2::new(c.x + 3.0, c.y),
+                    Pos2::new(c.x - 1.8, c.y + 3.0),
+                ],
+                Color32::TRANSPARENT,
+                Stroke::new(1.0, pal.text_dim),
+            ));
+        }
+    }
+}
+
+/// The browser eye: an outlined lid-rect with a pupil, or crossed when
+/// hidden (display state - the row click still selects, the eye never
+/// destroys).
+pub(super) fn eye_glyph(shapes: &mut Vec<Shape>, r: Rect, hidden: bool, pal: &Tokens) {
+    let s = Stroke::new(1.0, if hidden { pal.text_faint } else { pal.text_dim });
+    shapes.push(Shape::rect_stroke(r, 4.0, s, egui::StrokeKind::Middle));
+    if hidden {
+        shapes.push(Shape::line_segment([r.left_top(), r.right_bottom()], s));
+        shapes.push(Shape::line_segment([r.left_bottom(), r.right_top()], s));
+    } else {
+        shapes.push(Shape::circle_filled(r.center(), 2.2, pal.text_dim));
+    }
+}
diff --git a/crates/ui/src/egui_app/tree_menu.rs b/crates/ui/src/egui_app/tree_menu.rs
new file mode 100644
index 00000000..d7fa1008
--- /dev/null
+++ b/crates/ui/src/egui_app/tree_menu.rs
@@ -0,0 +1,259 @@
+//! The browser's operation menu (split from `panes`, #343): a right-click
+//! on an operation row - or on a setup's Operations row, for Paste - opens
+//! the verbs and the retype list; every row is one undoable command.
+//! Provenance: our own port of the imgui tree menu (our code); no HSMWorks
+//! material consulted.
+
+use egui::{Rect, Sense, Ui, Vec2};
+
+use camcraft_app::model;
+use camcraft_app::operation;
+
+use crate::actions;
+use crate::state::{CommandKind, State, TreeMenuTarget, UiTarget};
+
+use super::browser_tree::Leaf;
+use super::panes::{DROP_GAP, DROP_W};
+use super::theme::Tokens;
+
+/// The tree menu's verb rows, keyed past every kind ordinal.
+const MENU_CLEAR: usize = usize::MAX;
+const MENU_DELETE: usize = usize::MAX - 1;
+const MENU_RENAME: usize = usize::MAX - 2;
+const MENU_COPY: usize = usize::MAX - 3;
+const MENU_PASTE: usize = usize::MAX - 4;
+/// #110: suppress / unsuppress, and the after-action row that steps
+/// through `AfterOperation::ALL`.
+const MENU_SUPPRESS: usize = usize::MAX - 5;
+const MENU_AFTER: usize = usize::MAX - 6;
+
+/// The after-action row's text: what happens now; a click steps on.
+fn after_row_label(a: operation::AfterOperation) -> &'static str {
+    match a {
+        operation::AfterOperation::None => "After: continue (click to change)",
+        operation::AfterOperation::OptionalStop => "After: optional stop (M1)",
+        operation::AfterOperation::ProgramStop => "After: program stop (M0)",
+        operation::AfterOperation::GoHome => "After: go home",
+    }
+}
+
+/// The operation's retype menu (M9.1): what replaced the page's Type
+/// combo. Grouping is the retired combo's law restated once -
+/// `Section::ORDER` headers, `KindInfo::admits` hiding a section none
+/// of whose kinds the machine can run (M13.5 B: the lathe's Drilling
+/// header fronts the axial Drill alone, every other row of it dark),
+/// and the current kind's section staying listed even when the
+/// machine says no, so a mid-edit machine swap never erases the
+/// operation's own name. A kind row needs a second click before it queues
+/// `ChangeOperationKind` - one undo unit, the numbers carried by the
+/// one retype law below; a dark row is queued too, because the refusal
+/// belongs at the command door (`family_gate`), where it names itself
+/// on the status line - never a silent dead pixel. Hand-drawn like the
+/// ribbon's dropdowns (the panel is geometry, not a Widget): an Area
+/// at Foreground order, so a press on a row belongs to the row, never
+/// to the tree behind it; any other primary press closes it.
+pub(super) fn tree_menu(ui: &mut Ui, state: &mut State, pal: &Tokens, rect: Rect, leaves: &[Leaf]) {
+    let Some(target) = state.tree_menu.clone() else {
+        return;
+    };
+    // A setup's Operations row anchors Paste: the active setup's (the
+    // menu's click activated it), else - for the frame its activation is
+    // still queued - the first one.
+    let active = camcraft_app::setup::active(&state.world).unwrap_or_default();
+    let row_ix = leaves.iter().position(|leaf| match (&target, leaf) {
+        (TreeMenuTarget::Operation(name), Leaf::Op(row)) => name == row,
+        (TreeMenuTarget::Operations, Leaf::SetupOps(setup)) => *setup == active,
+        _ => false,
+    }).or_else(|| match target {
+        TreeMenuTarget::Operations => leaves.iter().position(|leaf| matches!(leaf, Leaf::SetupOps(_))),
+        TreeMenuTarget::Operation(_) => None,
+    });
+    let Some(ix) = row_ix else {
+        state.tree_menu = None;
+        state.retype_confirm = None;
+        return;
+    };
+    let name = match &target {
+        TreeMenuTarget::Operation(name) => {
+            if model::find_by_name(&state.world, name)
+                .and_then(|entity| model::operation_of(&state.world, &entity))
+                .is_none()
+            {
+                state.tree_menu = None;
+                state.retype_confirm = None;
+                return;
+            }
+            Some(name.as_str())
+        }
+        TreeMenuTarget::Operations => None,
+    };
+    let here = name.and_then(|name| model::find_by_name(&state.world, name))
+        .and_then(|entity| model::operation_of(&state.world, &entity))
+        .map(|op| op.params.kind().ordinal());
+    // #110: the op's suppression and after-action, for the menu rows.
+    let flow = name.and_then(|name| model::find_by_name(&state.world, name))
+        .and_then(|entity| model::operation_of(&state.world, &entity))
+        .map(|op| (op.suppressed, op.after));
+    let machine = camcraft_app::machine::kind_of(&state.world);
+    // The rows: section headers and kinds, in registry order, read
+    // from the same taxonomy as the ribbon's cells - never a list.
+    let mut lines: Vec<(&'static str, bool, Option<usize>)> = Vec::new();
+    // The row's verbs first: clearing the generated path (keeps the
+    // operation) and deleting the operation are two different asks,
+    // and the menu names both - each one undoable command.
+    lines.push(("Operation", false, None));
+    if name.is_some() {
+        lines.push(("Rename operation", true, Some(MENU_RENAME)));
+        lines.push(("Copy operation", true, Some(MENU_COPY)));
+    }
+    lines.push(("Paste operation", state.operation_clipboard.is_some(), Some(MENU_PASTE)));
+    if name.is_some() {
+        lines.push(("Clear toolpath", true, Some(MENU_CLEAR)));
+        lines.push(("Delete operation (undoable)", true, Some(MENU_DELETE)));
+        // #110: beside the verbs, so they stay on screen however long
+        // the kind list below runs.
+        let suppressed = flow.is_some_and(|(s, _)| s);
+        lines.push((if suppressed { "Unsuppress operation" } else { "Suppress operation" }, true, Some(MENU_SUPPRESS)));
+        // One row that steps through the after-actions (a click is one
+        // undoable edit), so the menu grows by two rows, not six.
+        lines.push((after_row_label(flow.map_or(operation::AfterOperation::None, |(_, a)| a)), true, Some(MENU_AFTER)));
+    }
+    let here_section = here.and_then(|index| operation::KindInfo::ALL.get(index).map(|k| k.section));
+    for s in operation::Section::ORDER.into_iter().filter(|_| name.is_some()) {
+        // The current kind's own section keeps every row (dark where
+        // the machine says no); any other section lists only what the
+        // door admits, and leaves the menu when that is nothing.
+        let rows = if here_section == Some(s) {
+            s.kinds()
+        } else {
+            s.kinds_for(machine)
+        };
+        if rows.is_empty() {
+            continue;
+        }
+        lines.push((s.label(), false, None));
+        for i in rows {
+            if let Some(k) = operation::KindInfo::ALL.get(i) {
+                lines.push((k.label, k.admits(machine), Some(i)));
+            }
+        }
+    }
+    let anchor = egui::Pos2::new(
+        rect.left(),
+        rect.top() + (ix + 1) as f32 * pal.row_height + DROP_GAP,
+    );
+    let panel = Rect::from_min_size(
+        anchor,
+        Vec2::new(DROP_W, lines.len() as f32 * pal.row_height),
+    );
+    let mut chosen: Option<usize> = None;
+    egui::Area::new(ui.id().with(("tree-menu", ix)))
+        .fixed_pos(anchor)
+        .order(egui::Order::Foreground)
+        .movable(false)
+        .show(ui.ctx(), |ui| {
+            let p = ui.painter();
+            p.rect_filled(panel, pal.radius_menu, pal.ink);
+            p.rect_stroke(
+                panel,
+                pal.radius_menu,
+                egui::Stroke::new(1.0, pal.border),
+                egui::StrokeKind::Outside,
+            );
+            for (k, (label, runnable, item)) in lines.iter().enumerate() {
+                let r = Rect::from_min_size(
+                    egui::Pos2::new(anchor.x, anchor.y + k as f32 * pal.row_height),
+                    Vec2::new(DROP_W, pal.row_height),
+                );
+                let is_current = item.is_some_and(|i| Some(i) == here);
+                if is_current {
+                    p.rect_filled(r, 0.0, pal.selection_bg);
+                }
+                let resp = item.map(|_| {
+                    ui.interact(r, ui.id().with(("tree-menu-row", k)), Sense::click())
+                });
+                if let Some(resp) = &resp
+                    && resp.hovered()
+                    && !is_current
+                {
+                    p.rect_filled(r, 0.0, pal.field_hover);
+                }
+                let armed = name.is_some_and(|name| state.retype_confirm.as_ref()
+                    .is_some_and(|(pending_name, pending_kind)|
+                        pending_name == name && *item == Some(*pending_kind)));
+                let text = if is_current {
+                    format!("{label} (current)")
+                } else if armed {
+                    format!("Confirm change to {label}")
+                } else {
+                    (*label).to_owned()
+                };
+                p.text(
+                    r.left_center() + Vec2::new(8.0, 0.0),
+                    egui::Align2::LEFT_CENTER,
+                    &text,
+                    egui::FontId::proportional(pal.font_row),
+                    match item {
+                        None => pal.text_dim,
+                        Some(_) if !runnable || is_current => pal.text_faint,
+                        Some(_) => pal.text,
+                    },
+                );
+                if let Some(resp) = resp
+                    && resp.clicked()
+                    && (*runnable || *item != Some(MENU_PASTE))
+                {
+                    chosen = *item;
+                }
+            }
+        });
+    if let Some(i) = chosen {
+        if i == MENU_PASTE {
+            actions::paste_operation(state);
+        } else if let Some(name) = name {
+            if i == MENU_RENAME {
+                let label = model::find_by_name(&state.world, name)
+                    .map(|e| model::operation_label(&state.world, name, &e))
+                    .unwrap_or_else(|| name.to_owned());
+                state.rename_draft = Some((name.to_owned(), label));
+                actions::target(state, UiTarget::Operation(name.to_owned()));
+            } else if i == MENU_COPY {
+                actions::copy_operation(state, name);
+            } else if i == MENU_CLEAR {
+                state.pending.push_back(CommandKind::ClearToolpath(name.to_owned()));
+            } else if i == MENU_DELETE {
+                state.pending.push_back(CommandKind::DeleteOperation(name.to_owned()));
+            } else if i == MENU_SUPPRESS {
+                let suppressed = !flow.is_some_and(|(s, _)| s);
+                state.pending.push_back(CommandKind::SuppressOperation { name: name.to_owned(), suppressed });
+            } else if i == MENU_AFTER {
+                let all = operation::AfterOperation::ALL;
+                let now = flow.map_or(operation::AfterOperation::None, |(_, a)| a);
+                let k = all.iter().position(|a| *a == now).unwrap_or(0);
+                let after = all.get((k + 1) % all.len()).copied().unwrap_or_default();
+                state.pending.push_back(CommandKind::EditOperationAfter { name: name.to_owned(), after });
+            } else if Some(i) != here {
+                let choice = (name.to_owned(), i);
+                if state.retype_confirm.as_ref() == Some(&choice) {
+                    state.pending.push_back(CommandKind::ChangeOperationKind {
+                        name: name.to_owned(), kind: i,
+                    });
+                } else {
+                    state.retype_confirm = Some(choice);
+                    return;
+                }
+            }
+        }
+        state.tree_menu = None;
+        state.retype_confirm = None;
+    } else if ui.input(|i| {
+        i.pointer.button_pressed(egui::PointerButton::Primary)
+            && i.pointer.hover_pos().is_none_or(|pos| !panel.contains(pos))
+    }) {
+        // The dropdowns' close law: a primary press that is nobody's
+        // row is the menu's - it never stacks and never stalks a
+        // document the user has moved on from.
+        state.tree_menu = None;
+        state.retype_confirm = None;
+    }
+}
