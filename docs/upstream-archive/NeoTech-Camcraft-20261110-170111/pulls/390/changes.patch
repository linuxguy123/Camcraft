diff --git a/crates/app/src/setup_mount.rs b/crates/app/src/setup_mount.rs
new file mode 100644
index 00000000..c49da894
--- /dev/null
+++ b/crates/app/src/setup_mount.rs
@@ -0,0 +1,156 @@
+//! Each setup's machine and post (#343): which `.mch` a setup is clamped
+//! on and which post script writes its program. A setup either owns its
+//! mount (`SetupDef::machine` / `SetupDef::post` set) or follows the
+//! document's (`None` - every file before v55), so an untouched document
+//! mounts and posts byte for byte as before.
+//!
+//! ## The one-mount law (this slice)
+//!
+//! The whole app reads ONE mounted machine and ONE post at a time - the
+//! ACTIVE setup's ([`crate::machine::of`], [`crate::posting::post_of`]):
+//! the ribbon, the kind gates, generation, the limit checker and the
+//! post all see the same steel. Work that would cross mounts is refused
+//! by name instead of being judged against the wrong machine:
+//!
+//! - generating an operation whose setup mounts another machine or post
+//!   than the active one ([`generation_problem`]) - activate its setup;
+//! - posting a program with an operation in such a setup
+//!   ([`program_problems`]) - a program is written by one post for one
+//!   machine; setups with different mounts post one at a time (one file
+//!   per post is a follow-up).
+//!
+//! With no setup owning a mount (the default) neither refusal can fire.
+//!
+//! Provenance: our own design; a setup being one clamping on one
+//! machine, posted by that machine's post, is general machine-shop
+//! practice - no vendor implementation inspected.
+
+use flecs_ecs::core::WorldGet;
+use flecs_ecs::prelude::World;
+
+use crate::machine::Machine;
+use crate::model;
+use crate::schema::{MachineDef, PostRef};
+use crate::setup;
+
+/// The document's machine as stored (the singleton), what setups that
+/// own no machine follow. `("", None)` when none was ever loaded.
+#[must_use]
+pub fn document_machine(world: &World) -> (String, Option<Machine>) {
+    world
+        .try_get::<&MachineDef>(|d| (d.path.clone(), d.machine.clone()))
+        .unwrap_or_default()
+}
+
+/// The document's post as stored (the singleton).
+#[must_use]
+pub fn document_post(world: &World) -> PostRef {
+    world.try_get::<&PostRef>(|p| p.clone()).unwrap_or_default()
+}
+
+/// The machine a declared setup context mounts: its own, else the
+/// document's. `None` resolves to the first setup (the implicit-setup
+/// law); a document without setups mounts the document's machine.
+#[must_use]
+pub fn machine_of(world: &World, declared: Option<&str>) -> (String, Option<Machine>) {
+    match own_machine(world, declared) {
+        Some(m) => (m.path, m.machine),
+        None => document_machine(world),
+    }
+}
+
+/// The post a declared setup context runs: its own, else the document's.
+#[must_use]
+pub fn post_of(world: &World, declared: Option<&str>) -> PostRef {
+    own_post(world, declared).unwrap_or_else(|| document_post(world))
+}
+
+/// The setup's own machine, `None` when it follows the document.
+#[must_use]
+pub fn own_machine(world: &World, declared: Option<&str>) -> Option<MachineDef> {
+    let name = setup::effective(world, declared)?;
+    setup::def_of(world, &name)?.machine
+}
+
+/// The setup's own post, `None` when it follows the document.
+#[must_use]
+pub fn own_post(world: &World, declared: Option<&str>) -> Option<PostRef> {
+    let name = setup::effective(world, declared)?;
+    setup::def_of(world, &name)?.post
+}
+
+/// A machine's display name: the file's model, else its path, else
+/// "no machine".
+#[must_use]
+pub fn machine_label(m: &(String, Option<Machine>)) -> String {
+    match &m.1 {
+        Some(def) if !def.model.is_empty() => def.model.clone(),
+        _ if !m.0.is_empty() => m.0.clone(),
+        Some(_) => "unnamed machine".to_owned(),
+        None => "no machine".to_owned(),
+    }
+}
+
+/// Why a declared setup context cannot be worked while the active setup
+/// is mounted: it mounts another machine or post. `None` when they agree
+/// (always, unless a setup owns its mount).
+#[must_use]
+pub fn mount_problem(world: &World, declared: Option<&str>) -> Option<String> {
+    let here = setup::effective(world, declared)?;
+    let active = setup::active(world)?;
+    if here == active {
+        return None;
+    }
+    let (m_here, m_active) = (machine_of(world, Some(&here)), machine_of(world, Some(&active)));
+    if m_here != m_active {
+        return Some(format!(
+            "setup '{here}' is machined on {} but the active setup '{active}' mounts {} - activate '{here}' first",
+            machine_label(&m_here),
+            machine_label(&m_active),
+        ));
+    }
+    let (p_here, p_active) = (post_of(world, Some(&here)), post_of(world, Some(&active)));
+    if p_here != p_active {
+        return Some(format!(
+            "setup '{here}' posts with {} but the active setup '{active}' posts with {} - activate '{here}' first",
+            crate::posting::post_ref_label(&p_here),
+            crate::posting::post_ref_label(&p_active),
+        ));
+    }
+    None
+}
+
+/// The generation door's mount clause: an operation is generated against
+/// the mounted (active) machine only when its own setup mounts it too.
+#[must_use]
+pub fn generation_problem(world: &World, op: &crate::schema::Operation) -> Option<String> {
+    mount_problem(world, op.setup.as_deref())
+}
+
+/// The post's mount clause: one program, one post, one machine. Every
+/// unsuppressed operation's setup must mount what the active setup
+/// mounts; each disagreeing setup is named once.
+#[must_use]
+pub fn program_problems(world: &World) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    let mut seen: Vec<String> = Vec::new();
+    for (_, e) in setup::operation_order(world) {
+        let Some(op) = model::operation_of(world, &e) else {
+            continue;
+        };
+        if op.suppressed {
+            continue;
+        }
+        let Some(here) = setup::effective(world, op.setup.as_deref()) else {
+            continue;
+        };
+        if seen.contains(&here) {
+            continue;
+        }
+        if let Some(why) = mount_problem(world, Some(&here)) {
+            out.push(format!("{why} (one program is written by one post for one machine)"));
+        }
+        seen.push(here);
+    }
+    out
+}
diff --git a/crates/app/tests/setup_mount.rs b/crates/app/tests/setup_mount.rs
new file mode 100644
index 00000000..d3e88929
--- /dev/null
+++ b/crates/app/tests/setup_mount.rs
@@ -0,0 +1,202 @@
+//! #343: each setup's own machine and post. A setup follows the
+//! document's mount until it is given its own (`SetSetupMachine` /
+//! `SetSetupPost`, undoable); the mounted machine and post are the
+//! active setup's. A v54 file opens with every setup following the
+//! document and posts byte-identically; a v55 file round-trips the own
+//! mounts. Work that crosses mounts is refused by name: generating an
+//! op of a setup mounting other steel than the active one, and posting
+//! a program whose setups disagree on machine or post.
+//! Provenance: our own fixtures over our own commands; no vendor material.
+//!
+//! Gate map (#343): covers app::setup_mount, app::commands
+//! (SetSetupMachine, SetSetupPost, CreateSetup datum transfer),
+//! app::machine (of, document_of, kind_of), app::posting (post_of,
+//! post_setup, verification_report), app::project (SetupDto v55).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use flecs_ecs::prelude::World;
+use serde_json::{Value, json};
+
+use camcraft_app::commands::{
+    ActivateSetup, AddTool, CreateOperation, CreateSetup, GenerateOperation, History,
+    SetSetupMachine, SetSetupPost, SetStock,
+};
+use camcraft_app::operation::{Height, OpParams, SrcRef};
+use camcraft_app::project;
+use camcraft_app::schema::PostRef;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::world::new_world;
+use camcraft_app::{machine, posting, setup_mount};
+
+const TOOL: &str = "EM-0400-2FL";
+
+fn face() -> OpParams {
+    OpParams::Face {
+        holes: Default::default(),
+        blend_turns: false,
+        tilt: None,
+        stepover: 3.0,
+        clearance_z: Height::fixed(25.0),
+        cut_z: Height::fixed(19.5),
+        top_z: None,
+        stepdown: None,
+        feed: 1200.0,
+        plunge_feed: 300.0,
+        climb: true,
+    }
+}
+
+/// Stock, tool, no document machine (the face sits above a VMC's
+/// machine-coordinate stroke), `setups` setups (0 = none), one
+/// generated face per setup.
+fn doc(setups: usize) -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    let stock = SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Default::default());
+    h.execute(&world, stock.expect("box stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == TOOL).map(|(_, t)| t).expect("tool");
+    h.execute(&world, AddTool::new(&world, TOOL, tool).expect("add tool"));
+    if setups == 0 {
+        face_op(&world, &mut h, "Face1");
+    }
+    for i in 1..=setups {
+        h.execute(&world, CreateSetup::new(&world, None, None).expect("setup"));
+        if i > 1 {
+            let stock = SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 60.0, dz: 20.0 }, Default::default());
+            h.execute(&world, stock.expect("setup stock"));
+        }
+        face_op(&world, &mut h, &format!("Face{i}"));
+    }
+    (world, h)
+}
+
+fn face_op(world: &World, h: &mut History, name: &str) {
+    let op = CreateOperation::new(world, name, TOOL, SrcRef::Stock, face());
+    h.execute(world, op.expect("create"));
+    h.execute(world, GenerateOperation::new(world, name).expect("generate"));
+}
+
+fn tmp(tag: &str, ext: &str) -> std::path::PathBuf {
+    let mut path = std::env::temp_dir();
+    path.push(format!("camcraft-343-{tag}-{}.{ext}", std::process::id()));
+    path
+}
+
+fn saved(world: &World, tag: &str) -> String {
+    let path = tmp(tag, "ccam");
+    project::save(world, &path).expect("save");
+    let text = std::fs::read_to_string(&path).expect("read");
+    let _ = std::fs::remove_file(&path);
+    text
+}
+
+fn post(world: &World, tag: &str) -> Result<String, String> {
+    let path = tmp(tag, "nc");
+    let out = posting::post_setup(world, &path).map(|p| p.program);
+    let _ = std::fs::remove_file(&path);
+    out
+}
+
+#[test]
+fn a_v54_file_follows_the_document_mount_and_posts_byte_identically() {
+    for setups in [0, 1] {
+        let (world, _) = doc(setups);
+        let expected = post(&world, &format!("v54-now-{setups}")).expect("posts");
+        let now = saved(&world, &format!("v54-{setups}"));
+        assert!(!now.contains("\"post\": \"builtin\""), "no own mount is written: {now}");
+        let mut v: Value = serde_json::from_str(&now).expect("json");
+        v["version"] = json!(54);
+        let w = new_world();
+        project::open(&w, &serde_json::to_string_pretty(&v).expect("text")).expect("a v54 file opens");
+        if setups == 1 {
+            assert_eq!(setup_mount::own_machine(&w, Some("Setup1")), None, "follows the document");
+            assert_eq!(setup_mount::own_post(&w, Some("Setup1")), None);
+        }
+        assert_eq!(machine::of(&w), machine::document_of(&w));
+        assert_eq!(post(&w, &format!("v54-old-{setups}")).expect("posts"), expected, "byte-identical");
+        assert_eq!(saved(&w, &format!("v54-resave-{setups}")), now, "saves as it was, at v55");
+    }
+}
+
+#[test]
+fn a_setups_own_machine_and_post_round_trip_and_undo() {
+    let (world, mut h) = doc(1);
+    let expected = post(&world, "rt-before").expect("posts");
+    h.execute(&world, SetSetupMachine::builtin(&world, "Setup1", "Tormach 770M").expect("own machine"));
+    h.execute(&world, SetSetupPost::new(&world, "Setup1", Some(PostRef::Builtin)).expect("own post"));
+    assert_eq!(machine::of(&world).0, posting::builtin_path("Tormach 770M"), "the active setup's machine is mounted");
+    assert_eq!(machine::document_of(&world), (String::new(), None), "the document keeps its own");
+    let text = saved(&world, "rt");
+    assert!(text.contains("\"post\": \"builtin\""), "{text}");
+    let w = new_world();
+    project::open(&w, &text).expect("a v55 file opens");
+    assert_eq!(machine::of(&w).0, posting::builtin_path("Tormach 770M"));
+    assert_eq!(setup_mount::own_post(&w, Some("Setup1")), Some(PostRef::Builtin));
+    assert_eq!(saved(&w, "rt-resave"), text);
+    // Undo both: the setup follows the document again, posting as before.
+    h.undo(&world);
+    h.undo(&world);
+    assert_eq!(setup_mount::own_machine(&world, Some("Setup1")), None);
+    assert_eq!(setup_mount::own_post(&world, Some("Setup1")), None);
+    assert_eq!(post(&world, "rt-after").expect("posts"), expected);
+    // A repeat is refused by name, never a silent no-op in the history.
+    let again = SetSetupPost::new(&world, "Setup1", None);
+    assert!(again.is_err_and(|e| e.to_string().contains("already follows the document's post")));
+    let ghost = SetSetupMachine::builtin(&world, "Setup1", "No such mill");
+    assert!(ghost.is_err_and(|e| e.to_string().contains("not in the built-in library")));
+    let bad = SetSetupPost::new(&world, "Setup1", Some(PostRef::Named("Nope".into())));
+    assert!(bad.is_err_and(|e| e.to_string().contains("not in the registry")));
+}
+
+#[test]
+fn two_setups_on_different_posts_are_refused_by_name() {
+    let (world, mut h) = doc(2);
+    let both = post(&world, "two-same").expect("one mount posts");
+    h.execute(&world, SetSetupPost::new(&world, "Setup2", Some(PostRef::Named("Haas".into()))).expect("Setup2 posts Haas"));
+    // Setup2 is active (the last created): Setup1 follows the Fanuc default.
+    let why = post(&world, "two-diff").expect_err("refused");
+    assert!(why.contains("setup 'Setup1' posts with") && why.contains("activate 'Setup1'"), "{why}");
+    assert!(why.contains("one program is written by one post for one machine"), "{why}");
+    // Generating Setup1's op while Setup2 is mounted is refused too.
+    let refused = GenerateOperation::new(&world, "Face1");
+    assert!(refused.is_err_and(|e| e.to_string().contains("activate 'Setup1' first")));
+    h.execute(&world, ActivateSetup::new(&world, Some("Setup1")).expect("activate"));
+    let why = post(&world, "two-diff-1").expect_err("refused from the other side too");
+    assert!(why.contains("setup 'Setup2' posts with Haas (built-in)"), "{why}");
+    // Giving it back to the document posts the same program as before.
+    h.execute(&world, SetSetupPost::new(&world, "Setup2", None).expect("follow the document"));
+    assert_eq!(post(&world, "two-back").expect("posts"), both);
+}
+
+#[test]
+fn two_setups_on_different_machines_are_refused_by_name_and_kinds_follow_the_active() {
+    let (world, mut h) = doc(2);
+    h.execute(&world, SetSetupMachine::builtin(&world, "Setup2", "Lathe").expect("Setup2 on a lathe"));
+    assert_eq!(machine::kind_of(&world), machine::Kind::Lathe, "Setup2 is active: the ribbon reads a lathe");
+    let why = post(&world, "mach-diff").expect_err("refused");
+    assert!(why.contains("setup 'Setup1' is machined on") && why.contains("activate 'Setup1'"), "{why}");
+    h.execute(&world, ActivateSetup::new(&world, Some("Setup1")).expect("activate"));
+    assert_eq!(machine::kind_of(&world), machine::Kind::Mill);
+    assert!(posting::verification_gate(&world).iter().any(|p| p.contains("setup 'Setup2' is machined on")));
+}
+
+#[test]
+fn the_same_own_post_on_every_setup_posts_like_the_document() {
+    let (world, mut h) = doc(2);
+    let expected = post(&world, "same-before").expect("posts");
+    for s in ["Setup1", "Setup2"] {
+        h.execute(&world, SetSetupPost::new(&world, s, Some(PostRef::Builtin)).expect("own post"));
+    }
+    assert_eq!(post(&world, "same-after").expect("one mount posts"), expected);
+}
+
+#[test]
+fn a_datum_transfer_keeps_the_source_setups_mount() {
+    let (world, mut h) = doc(1);
+    h.execute(&world, SetSetupPost::new(&world, "Setup1", Some(PostRef::Named("Haas".into()))).expect("own post"));
+    h.execute(&world, CreateSetup::new(&world, None, Some("Setup1")).expect("datum transfer"));
+    assert_eq!(setup_mount::own_post(&world, Some("Setup2")), Some(PostRef::Named("Haas".into())));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("fresh setup"));
+    assert_eq!(setup_mount::own_post(&world, Some("Setup3")), None, "a fresh setup follows the document");
+}
diff --git a/crates/ui/src/egui_app/browser_pane.rs b/crates/ui/src/egui_app/browser_pane.rs
new file mode 100644
index 00000000..25ccc64e
--- /dev/null
+++ b/crates/ui/src/egui_app/browser_pane.rs
@@ -0,0 +1,185 @@
+//! The browser pane (#343, split from `panes`): the global view toggles,
+//! then the painted tree with its click law. A setup node's radio queues
+//! `ActivateSetup` (undoable); its row opens the setup's settings. Every
+//! node UNDER a setup opens that setup's page - and when the setup is not
+//! the active one it is activated first (the same undoable command), so
+//! the Stock, WCS, Machine, Post and Fixtures editors - which edit the
+//! active setup's furniture and mount - never edit a setup the clicked
+//! node does not belong to.
+//! Provenance: our own port of the imgui browser (our code) and the
+//! maintainer's per-node behaviour (#343); no HSMWorks material consulted.
+
+use egui::{Rect, Sense, Ui, Vec2};
+
+use camcraft_app::{model, setup};
+
+use crate::actions;
+use crate::state::{CommandKind, DisplayMode, SetupPage, State, TreeMenuTarget, UiTarget};
+
+use super::browser_tree::{Leaf, browser_rows};
+use super::icons::IconSet;
+use super::painted;
+use super::theme::Tokens;
+
+/// The browser pane.
+pub fn browser(ui: &mut Ui, state: &mut State, pal: &Tokens, icons: Option<&IconSet>) {
+    ui.checkbox(&mut state.show_world_axes, "Show world origin axes");
+    let mut show_all_paths = state.show_all_paths;
+    if ui.checkbox(&mut show_all_paths, "Show all toolpaths").changed() {
+        if show_all_paths {
+            state.show_all_toolpaths();
+        } else {
+            state.hide_all_toolpaths();
+        }
+    }
+    // The display mode is view state (a direct field flip, never a command).
+    ui.horizontal(|ui| {
+        ui.label("Solids");
+        ui.radio_value(&mut state.display, DisplayMode::ShadedEdges, "Shaded");
+        ui.radio_value(&mut state.display, DisplayMode::Wireframe, "Wireframe");
+    });
+    ui.separator();
+    let (rows, leaves) = browser_rows(state);
+    let rect = Rect::from_min_size(
+        ui.cursor().min,
+        Vec2::new(ui.available_width(), rows.len() as f32 * pal.row_height),
+    );
+    let hit = painted::tree(ui, rect, &rows, pal, icons);
+    drag_ops(ui, state, pal, rect, &leaves, hit.drag_started);
+    if let Some(ix) = hit.radio
+        && let Some(Leaf::Setup(name)) = leaves.get(ix)
+    {
+        focus(state, name);
+    }
+    if let Some(leaf) = hit.eye.and_then(|ix| leaves.get(ix)) {
+        eye(state, leaf);
+    }
+    if let Some(leaf) = hit.row.and_then(|ix| leaves.get(ix)).cloned() {
+        click(state, leaf);
+    }
+    // Operation rows offer the operation verbs; a setup's Operations row
+    // offers Paste even when it has no operation rows yet (activating
+    // the setup, so the menu anchors on the row that was clicked).
+    if let Some(ix) = hit.menu {
+        let target = match leaves.get(ix) {
+            Some(Leaf::Op(name)) => Some(TreeMenuTarget::Operation(name.clone())),
+            Some(Leaf::SetupOps(setup)) => {
+                focus(state, setup);
+                Some(TreeMenuTarget::Operations)
+            }
+            _ => None,
+        };
+        state.tree_menu = target.filter(|target| state.tree_menu.as_ref() != Some(target));
+        state.retype_confirm = None;
+    }
+    super::tree_menu::tree_menu(ui, state, pal, rect, &leaves);
+    ui.allocate_rect(rect, Sense::hover());
+}
+
+/// Make `setup` the active setup (one undoable `ActivateSetup`) unless it
+/// already is, or it is the implicit setup of a setup-free document.
+pub(super) fn focus(state: &mut State, name: &str) {
+    if name.is_empty() || setup::active(&state.world).as_deref() == Some(name) {
+        return;
+    }
+    state.pending.push_back(CommandKind::ActivateSetup(Some(name.to_owned())));
+}
+
+fn ctx(name: &str) -> Option<&str> {
+    (!name.is_empty()).then_some(name)
+}
+
+fn eye(state: &mut State, leaf: &Leaf) {
+    match leaf {
+        Leaf::Model(n) => State::toggle_visibility(&mut state.hidden_models, n),
+        Leaf::Stock(s) => {
+            let name = setup::stock_entity_name(&state.world, ctx(s));
+            State::toggle_visibility(&mut state.hidden_stocks, &name);
+        }
+        Leaf::Wcs(s) => {
+            let name = setup::wcs_entity_name(&state.world, ctx(s));
+            State::toggle_visibility(&mut state.hidden_offsets, &name);
+        }
+        Leaf::Op(n) => State::toggle_visibility(&mut state.hidden_paths, n),
+        _ => {}
+    }
+}
+
+pub(super) fn click(state: &mut State, leaf: Leaf) {
+    match leaf {
+        Leaf::Section => {}
+        Leaf::Parent(section) => {
+            let expanded = &mut state.browser_expanded[section.index()];
+            *expanded = !*expanded;
+        }
+        // Target-only, like the Tool rows: browsing setups never arms Del.
+        Leaf::Setups => actions::target(state, UiTarget::Setups),
+        Leaf::Setup(name) => actions::target(state, UiTarget::SetupNode(name, SetupPage::Settings)),
+        Leaf::Stock(s) => {
+            focus(state, &s);
+            actions::target(state, UiTarget::Stock);
+            let name = setup::stock_entity_name(&state.world, ctx(&s));
+            if model::find_by_name(&state.world, &name).is_some() {
+                state.pending.push_back(CommandKind::Select(Some(name)));
+            }
+        }
+        Leaf::Wcs(s) => {
+            focus(state, &s);
+            actions::target(state, UiTarget::Wcs);
+            let name = setup::wcs_entity_name(&state.world, ctx(&s));
+            if model::find_by_name(&state.world, &name).is_some() {
+                state.pending.push_back(CommandKind::Select(Some(name)));
+            }
+        }
+        Leaf::Page(s, page) => {
+            focus(state, &s);
+            actions::target(state, UiTarget::SetupNode(s, page));
+        }
+        Leaf::SetupOps(s) => focus(state, &s),
+        Leaf::Model(n) => {
+            actions::target(state, UiTarget::Model(n.clone()));
+            state.pending.push_back(CommandKind::Select(Some(n)));
+        }
+        // Target only: no Select, so browsing tools never arms Del.
+        Leaf::Tool(n) => actions::target(state, UiTarget::Tool(n)),
+        Leaf::Op(n) => {
+            actions::target(state, UiTarget::Operation(n.clone()));
+            state.pending.push_back(CommandKind::Select(Some(n)));
+        }
+    }
+}
+
+/// Drag an operation row onto another of the SAME setup: the insertion
+/// line and the `ReorderOperation` command use the same target row.
+fn drag_ops(ui: &mut Ui, state: &mut State, pal: &Tokens, rect: Rect, leaves: &[Leaf], started: Option<usize>) {
+    if let Some(ix) = started
+        && let Some(Leaf::Op(name)) = leaves.get(ix)
+    {
+        state.dragging_op = Some(name.clone());
+    }
+    let Some(source) = state.dragging_op.clone() else {
+        return;
+    };
+    let (released, pointer) = ui.input(|i| (i.pointer.any_released(), i.pointer.hover_pos()));
+    let drop = pointer.filter(|p| rect.contains(*p)).and_then(|p| {
+        let ix = ((p.y - rect.top()) / pal.row_height) as usize;
+        let Leaf::Op(target) = leaves.get(ix)? else { return None };
+        let setup_of = |name: &str| {
+            model::find_by_name(&state.world, name)
+                .and_then(|e| model::operation_of(&state.world, &e))
+                .and_then(|op| setup::effective(&state.world, op.setup.as_deref()))
+        };
+        let after = p.y > rect.top() + (ix as f32 + 0.5) * pal.row_height;
+        (source != *target && setup_of(&source) == setup_of(target)).then_some((ix, target.clone(), after))
+    });
+    if let Some((ix, target, after)) = drop {
+        let y = rect.top() + (ix + usize::from(after)) as f32 * pal.row_height;
+        ui.painter().hline(rect.x_range(), y, egui::Stroke::new(2.0, pal.accent));
+        if released {
+            state.pending.push_back(CommandKind::ReorderOperation { name: source, target, after });
+        }
+    }
+    if released {
+        state.dragging_op = None;
+    }
+}
diff --git a/crates/ui/src/egui_app/browser_tree.rs b/crates/ui/src/egui_app/browser_tree.rs
new file mode 100644
index 00000000..6c832472
--- /dev/null
+++ b/crates/ui/src/egui_app/browser_tree.rs
@@ -0,0 +1,314 @@
+//! The browser tree's rows (#343, split from `panes`): each setup is a
+//! node with a radio (the active setup) and its own children, in order -
+//! WCS, Stock, Machine, Post, Fixtures (each fixture a child), Tool list,
+//! Operations (its 1+n operations, in machining order). A document without
+//! setups shows the same children straight under the Setup section, for
+//! its implicit setup. Models and the document's tool library follow.
+//! Rows are pure data (`painted::Row` plus a parallel `Leaf`), so the
+//! tree's shape is testable without a harness; the click law is
+//! `browser_pane`.
+//! Provenance: our own tree layout (issue #343, the maintainer's node
+//! list); no HSMWorks material consulted.
+
+use camcraft_app::model;
+use camcraft_app::operation;
+use camcraft_app::schema::WCS_SLOTS;
+use camcraft_app::tools::ToolKind;
+use camcraft_app::{setup, setup_mount};
+
+use crate::state::{SetupPage, State, UiTarget};
+
+use super::icons::Icon;
+use super::painted;
+use super::panes::op_icon;
+
+/// The tree's collapsible top-level sections.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum BrowserSection {
+    Setup,
+    Models,
+    Tools,
+}
+
+impl BrowserSection {
+    pub(super) const fn index(self) -> usize {
+        self as usize
+    }
+}
+
+/// What a browser row's click means. Parallel to the painted Row list.
+/// Setup-scoped rows carry their setup's name (`""` - the implicit setup
+/// of a document without setups).
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum Leaf {
+    Section,
+    Parent(BrowserSection),
+    /// The Setups manager row (M3.2 A, #322): target-only, never arms Del.
+    Setups,
+    /// A setup node: the radio activates it, the row opens its settings.
+    Setup(String),
+    Wcs(String),
+    Stock(String),
+    /// The Machine / Post / Fixtures / Tool list nodes.
+    Page(String, SetupPage),
+    /// A setup's Operations node: the menu row for Paste.
+    SetupOps(String),
+    Model(String),
+    Tool(String),
+    Op(String),
+}
+
+/// Append one tree row and its parallel leaf. `icon` is the bundled glyph
+/// for the row's subject, `None` for headers (and the setup radio).
+#[allow(clippy::too_many_arguments)]
+fn push_row(
+    rows: &mut Vec<painted::Row>,
+    leaves: &mut Vec<Leaf>,
+    label: String,
+    suffix: String,
+    kind: painted::Kind,
+    icon: Option<Icon>,
+    selected: bool,
+    hidden: bool,
+    depth: usize,
+    leaf: Leaf,
+) {
+    rows.push(painted::Row { label, suffix, kind, icon, selected, hidden, depth });
+    leaves.push(leaf);
+}
+
+/// What a Models row says about its model (M3.2 B): the fixture marker
+/// rides the suffix column ahead of the hidden marker, and the kind/icon
+/// pair picks the vise glyph for steel the program must dodge.
+pub(crate) fn model_row_marks(is_fixture: bool, hidden: bool) -> (String, painted::Kind, Icon) {
+    let mut suffix = String::new();
+    if is_fixture {
+        suffix.push_str(" (fixture)");
+    }
+    if hidden {
+        suffix.push_str(" (hidden)");
+    }
+    (
+        suffix,
+        if is_fixture { painted::Kind::Fixture } else { painted::Kind::Model },
+        if is_fixture { Icon::Fixture } else { Icon::Model },
+    )
+}
+
+pub(crate) fn kind_name(k: ToolKind) -> &'static str {
+    match k {
+        ToolKind::EndMill => "end mill",
+        ToolKind::BallNose => "ball nose",
+        ToolKind::BullNose => "bull nose",
+        ToolKind::Drill => "drill",
+        ToolKind::Tap => "tap",
+        ToolKind::Bore => "boring bar",
+        ToolKind::Turning => "turning insert",
+        ToolKind::Groove => "grooving blade",
+        ToolKind::Thread => "threading insert",
+        ToolKind::Form => "form gauge",
+        ToolKind::Taper => "chamfer mill",
+        ToolKind::Probe => "touch probe",
+    }
+}
+
+/// The whole tree: the Setup section (the manager row, then one node per
+/// setup - or the implicit setup's children), Models, and the document's
+/// tool library. Empty lists show a faint placeholder row.
+pub(crate) fn browser_rows(state: &State) -> (Vec<painted::Row>, Vec<Leaf>) {
+    let mut rows = Vec::new();
+    let mut leaves = Vec::new();
+    let t = state.pane_target();
+
+    let setup_open = state.browser_expanded[BrowserSection::Setup.index()];
+    push_row(&mut rows, &mut leaves, "Setup".into(), String::new(), painted::Kind::Parent(setup_open), None, false, false, 0, Leaf::Parent(BrowserSection::Setup));
+    if setup_open {
+        // The manager row stands whenever the section is open (#322): its
+        // page is where the FIRST setup is created.
+        push_row(&mut rows, &mut leaves, "Setups".to_owned(), String::new(), painted::Kind::Section, Some(Icon::Fixture), matches!(t, UiTarget::Setups), false, 1, Leaf::Setups);
+        let names = setup::names(&state.world);
+        if names.is_empty() {
+            setup_children(state, &t, "", 1, &mut rows, &mut leaves);
+        }
+        let active = setup::active(&state.world);
+        for name in names {
+            let is_active = active.as_deref() == Some(name.as_str());
+            let selected = matches!(&t, UiTarget::SetupNode(n, SetupPage::Settings) if *n == name);
+            let suffix = if is_active { "active".to_owned() } else { String::new() };
+            push_row(&mut rows, &mut leaves, name.clone(), suffix, painted::Kind::Setup(is_active), None, selected, false, 1, Leaf::Setup(name.clone()));
+            setup_children(state, &t, &name, 2, &mut rows, &mut leaves);
+        }
+    }
+
+    let models_open = state.browser_expanded[BrowserSection::Models.index()];
+    push_row(&mut rows, &mut leaves, "Models".into(), String::new(), painted::Kind::Parent(models_open), None, false, false, 0, Leaf::Parent(BrowserSection::Models));
+    if models_open {
+        let entities = model::model_entities(&state.world);
+        if entities.is_empty() {
+            push_row(&mut rows, &mut leaves, "(no models yet)".into(), String::new(), painted::Kind::Section, None, false, true, 1, Leaf::Section);
+        }
+        for (name, entity) in entities {
+            let selected = model::is_selected(&state.world, &entity);
+            let hidden = state.hidden_models.contains(&name);
+            let (suffix, kind, icon) = model_row_marks(model::is_fixture(&state.world, &entity), hidden);
+            let target = matches!(&t, UiTarget::Model(n) if *n == name) || selected;
+            push_row(&mut rows, &mut leaves, name.clone(), suffix, kind, Some(icon), target, hidden, 1, Leaf::Model(name));
+        }
+    }
+
+    // The document's tool LIBRARY (decision #343 (b)): every setup's Tool
+    // list is a view over these entries.
+    let tools_open = state.browser_expanded[BrowserSection::Tools.index()];
+    push_row(&mut rows, &mut leaves, "Tools".into(), String::new(), painted::Kind::Parent(tools_open), None, false, false, 0, Leaf::Parent(BrowserSection::Tools));
+    if tools_open {
+        let tools: Vec<(String, camcraft_app::tools::Tool)> = model::named_entities(&state.world)
+            .into_iter()
+            .filter(|(_, e)| model::is_tool(&state.world, e))
+            .filter_map(|(name, e)| model::tool_of(&state.world, &e).map(|t| (name, t)))
+            .collect();
+        if tools.is_empty() {
+            push_row(&mut rows, &mut leaves, "(no tools yet)".into(), String::new(), painted::Kind::Section, None, false, true, 1, Leaf::Section);
+        }
+        for (name, tool) in tools {
+            let suffix = format!("Ø{} {}", tool.diameter, kind_name(tool.kind));
+            let selected = matches!(&t, UiTarget::Tool(n) if *n == name);
+            push_row(&mut rows, &mut leaves, name.clone(), suffix, painted::Kind::Tool, Some(Icon::Tools), selected, false, 1, Leaf::Tool(name));
+        }
+    }
+    (rows, leaves)
+}
+
+/// One setup's children at `depth` (`name` `""` - the implicit setup).
+fn setup_children(
+    state: &State,
+    t: &UiTarget,
+    name: &str,
+    depth: usize,
+    rows: &mut Vec<painted::Row>,
+    leaves: &mut Vec<Leaf>,
+) {
+    let w = &state.world;
+    let ctx = (!name.is_empty()).then_some(name);
+    let is_active = ctx.is_none() || setup::active(w).as_deref() == ctx;
+    let page_open = |p: SetupPage| matches!(t, UiTarget::SetupNode(n, q) if n == name && *q == p);
+    // #342: one WCS per setup - plain "WCS", the word its post writes beside it.
+    let word = WCS_SLOTS.get(setup::wcs_slot(w, ctx)).copied().unwrap_or("G54");
+    let wcs_hidden = state.hidden_offsets.contains(&setup::wcs_entity_name(w, ctx));
+    push_row(rows, leaves, "WCS".to_owned(), word.to_owned(), painted::Kind::Wcs, Some(Icon::WorkOffset), is_active && matches!(t, UiTarget::Wcs), wcs_hidden, depth, Leaf::Wcs(name.to_owned()));
+    let stock_hidden = state.hidden_stocks.contains(&setup::stock_entity_name(w, ctx));
+    push_row(rows, leaves, "Stock".to_owned(), String::new(), painted::Kind::Stock, Some(Icon::Stock), is_active && matches!(t, UiTarget::Stock), stock_hidden, depth, Leaf::Stock(name.to_owned()));
+    let own = |owns: bool| if owns { "  (own)" } else { "" };
+    let machine = format!(
+        "{}{}",
+        setup_mount::machine_label(&setup_mount::machine_of(w, ctx)),
+        own(setup_mount::own_machine(w, ctx).is_some()),
+    );
+    push_row(rows, leaves, "Machine".to_owned(), machine, painted::Kind::Section, Some(Icon::Simulate), page_open(SetupPage::Machine), false, depth, Leaf::Page(name.to_owned(), SetupPage::Machine));
+    let post = format!(
+        "{}{}",
+        camcraft_app::posting::post_ref_label(&setup_mount::post_of(w, ctx)),
+        own(setup_mount::own_post(w, ctx).is_some()),
+    );
+    push_row(rows, leaves, "Post".to_owned(), post, painted::Kind::Section, Some(Icon::Post), page_open(SetupPage::Post), false, depth, Leaf::Page(name.to_owned(), SetupPage::Post));
+    let fixtures = camcraft_app::fixture::tagged(w, ctx);
+    push_row(rows, leaves, "Fixtures".to_owned(), count(fixtures.len(), "fixture"), painted::Kind::Section, Some(Icon::Fixture), page_open(SetupPage::Fixtures), false, depth, Leaf::Page(name.to_owned(), SetupPage::Fixtures));
+    for (fixture, entity) in fixtures {
+        let hidden = state.hidden_models.contains(&fixture);
+        let selected = matches!(t, UiTarget::Model(n) if *n == fixture) || model::is_selected(w, &entity);
+        let suffix = if hidden { " (hidden)".to_owned() } else { String::new() };
+        push_row(rows, leaves, fixture.clone(), suffix, painted::Kind::Fixture, Some(Icon::Fixture), selected, hidden, depth + 1, Leaf::Model(fixture));
+    }
+    let ops = setup_ops(state, ctx);
+    let tools = count(distinct_tools(state, &ops), "tool");
+    push_row(rows, leaves, "Tool list".to_owned(), tools, painted::Kind::Section, Some(Icon::Tools), page_open(SetupPage::Tools), false, depth, Leaf::Page(name.to_owned(), SetupPage::Tools));
+    push_row(rows, leaves, "Operations".to_owned(), String::new(), painted::Kind::Section, Some(Icon::Generate), false, false, depth, Leaf::SetupOps(name.to_owned()));
+    if ops.is_empty() {
+        push_row(rows, leaves, "(no operations yet)".into(), String::new(), painted::Kind::Section, None, false, true, depth + 1, Leaf::Section);
+    }
+    for (key, entity) in ops {
+        op_row(state, t, &key, &entity, depth + 1, rows, leaves);
+    }
+}
+
+fn count(n: usize, word: &str) -> String {
+    match n {
+        0 => String::new(),
+        1 => format!("1 {word}"),
+        n => format!("{n} {word}s"),
+    }
+}
+
+/// The setup's operations in program order (`None` - every operation).
+fn setup_ops(state: &State, ctx: Option<&str>) -> Vec<(String, flecs_ecs::prelude::Entity)> {
+    setup::operation_order(&state.world)
+        .into_iter()
+        .filter(|(_, e)| {
+            ctx.is_none_or(|s| {
+                model::operation_of(&state.world, e).is_some_and(|op| setup::belongs(&state.world, op.setup.as_deref(), s))
+            })
+        })
+        .collect()
+}
+
+fn distinct_tools(state: &State, ops: &[(String, flecs_ecs::prelude::Entity)]) -> usize {
+    let mut seen: Vec<String> = Vec::new();
+    for (_, e) in ops {
+        if let Some(op) = model::operation_of(&state.world, e)
+            && !seen.contains(&op.tool)
+        {
+            seen.push(op.tool);
+        }
+    }
+    seen.len()
+}
+
+/// One operation row: kind, generation tag, warnings, flow marks, and a
+/// BLOCKED reason when the tool law refuses it.
+fn op_row(
+    state: &State,
+    t: &UiTarget,
+    name: &str,
+    entity: &flecs_ecs::prelude::Entity,
+    depth: usize,
+    rows: &mut Vec<painted::Row>,
+    leaves: &mut Vec<Leaf>,
+) {
+    let w = &state.world;
+    let (kind, icon) = model::operation_of(w, entity)
+        .map(|op| {
+            let k = op.params.kind();
+            (k.to_string(), op_icon(k))
+        })
+        .unwrap_or_else(|| (String::new(), Icon::Generate));
+    let tag = match operation::status_of(w, entity) {
+        operation::OpStatus::Never => "never",
+        operation::OpStatus::Ok => "ok",
+        operation::OpStatus::Stale => "STALE",
+    };
+    let warns = model::toolpath_of(w, entity).map_or(0, |tp| tp.warnings.len());
+    let warn_text = match warns {
+        0 => String::new(),
+        1 => "  1 warning".to_owned(),
+        n => format!("  {n} warnings"),
+    };
+    // #110: a suppressed op and a stop / home after it say so on the row.
+    let flow = model::operation_of(w, entity).map_or_else(String::new, |op| {
+        let mut s = String::new();
+        if op.suppressed {
+            s.push_str("  SUPPRESSED");
+        }
+        if !op.after.is_default() {
+            s.push_str("  then ");
+            s.push_str(op.after.label());
+        }
+        s
+    });
+    let suffix = match operation::tool_gate::tool_problem_of(w, entity) {
+        Some(why) => format!("{kind}  BLOCKED{warn_text}{flow}  {why}"),
+        None => format!("{kind}  {tag}{warn_text}{flow}"),
+    };
+    let hidden = state.hidden_paths.iter().any(|p| p == name);
+    let selected = matches!(t, UiTarget::Operation(n) if n == name);
+    let label = model::operation_label(w, name, entity);
+    push_row(rows, leaves, label, suffix, painted::Kind::Op, Some(icon), selected, hidden, depth, Leaf::Op(name.to_owned()));
+}
