-        .fixed_pos(anchor)
-        .order(egui::Order::Foreground)
-        .movable(false)
-        .show(ui.ctx(), |ui| {
-            let p = ui.painter();
-            p.rect_filled(panel, pal.radius_menu, pal.ink);
