+    mal(p, "itself");
+    let mut p = plate(true);
+    p.cuts[0].parent = None;
+    mal(p, "no parent");
+    let mut p = plate(true);
+    p.cuts[1].contour = 2;
+    mal(p, "twice");
+    let mut p = plate(true);
