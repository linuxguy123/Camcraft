+    let face_e = model::find_by_name(&world, "Op1Face").expect("face");
+    let cached = model::toolpath_of(&world, &face_e).expect("cache");
+    let rebuilt = camcraft_app::schema::Toolpath::new(cached.path.clone(), Vec::new());
