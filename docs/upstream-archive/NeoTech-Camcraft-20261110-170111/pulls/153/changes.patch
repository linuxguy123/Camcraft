index dfe42a22..369d6978 100644
--- a/RECOMMENDED.md
+++ b/RECOMMENDED.md
@@ -13289,3 +13289,37 @@ revolved (follow-up material if users hit it with long keyways).
   (a flat point credits MORE); the DrillAhead doc says so.
 - **S2** (a pilot deleted after the bore leaves it Ok) is #109's - a
   lathe pin was added there, not fixed here.
+
+### #109: a verdict that reads earlier ops digests them
+
+- **Chosen: the stamp, not a live re-check at the post.** Every op whose
+  verdict reads the program ahead now writes the existing rest digest
+  (`rest::prior_digest`, the same term Pocket3D and Drill already wrote)
+  into its generation stamp, so editing, regenerating, deleting or
+  reordering an earlier op of its setup marks it Stale, and the post
+  gate - which already refuses Stale - refuses it. Which ops: Pocket3D,
+  Drill and every op with no 3+2 frame (`drill_prior::reads_prior`) -
+  exactly the set `job::collect_job` hands `verify_prior` (the prior
+  acquittal) and the turned family's pilot/facing credits ride. The
+  stale reason names the moved predecessor, the same story as Pocket3D's.
+- **Dropped: re-running `acquit_by_prior` / `judge_axial_rapids` live at
+  the post.** It would keep stamps unchurned, but the post would cut the
+  prior grid (the costly half) for every op every post, and two
+  readings of one verdict could disagree; the stamp is the one source.
+- **Cost, accepted:** every non-first op of a saved project reads Stale
+  once on load and clears on regenerate (release notes say so). A posed
+  (3+2) op reads no prior and keeps its stamp bit-for-bit. The digest
+  reads predecessors' cached paths, so an edited-but-not-regenerated
+  predecessor is its own Stale (the post refuses it first), and the
+  dependent goes Stale when it is regenerated.
+- **RegenerateAll takes two rounds** when a later op reads an earlier
+  one being regenerated in the same batch (the batch stages every op
+  against the frozen world, so the dependent is stamped against the
+  predecessor's old path) - the M3.1 C convergence Pocket3D already had,
+  now reached by face-then-contour jobs too. Honest (the leftover reads
+  Stale, the post refuses), but a second click; a one-round batch is a
+  follow-up, not done here.
+- Pins: `a_face_regenerated_shallower_marks_the_acquitted_contour_stale`
+  (vertical_rapid_stock), `a_pilot_deleted_or_made_shallower_after_the_bore_marks_it_stale`
+  (turning_bore). turning_bore's fixture moved to `tests/common/bore.rs`
+  to keep the suite under the 400-line law.
diff --git a/crates/app/src/operation/drill_prior.rs b/crates/app/src/operation/drill_prior.rs
index 3c36f9ab..1abb7996 100644
--- a/crates/app/src/operation/drill_prior.rs
+++ b/crates/app/src/operation/drill_prior.rs
@@ -16,6 +16,15 @@ use crate::geo2d::Point2;
 use crate::rest::PriorPlan;
 use crate::stock_sim::Dexel;
 
+/// Whether an operation's verdict reads the program ahead, so its stamp
+/// must digest it (issue #109): Pocket3D's rest and the Drill laws, and
+/// every unposed op - verify's prior acquittal and the turned family's
+/// pilot and facing credits are read exactly when no 3+2 frame stands
+/// (`job::collect_job`'s `verify_prior`). A posed op reads none of it.
+pub(crate) fn reads_prior(params: &super::OpParams) -> bool {
+    matches!(params.kind(), super::OpType::Pocket3D | super::OpType::Drill) || params.tilt().is_none()
+}
+
 /// The plan, simulated on first [`PriorCell::get`]. A plan that cannot
 /// be cut (a posed predecessor the column grid refuses) is logged and
 /// read as unknown - the raw stock, never air.
diff --git a/crates/app/src/operation/stamp.rs b/crates/app/src/operation/stamp.rs
index 82d71c65..ab956c93 100644
--- a/crates/app/src/operation/stamp.rs
+++ b/crates/app/src/operation/stamp.rs
@@ -259,11 +259,10 @@ pub fn current_stamp(
     // is written: first operations' and other kinds' stamps are
     // bit-for-bit what they were before stage D (the inert-data law).
     // Issue #89: an axial Drill's reach, R-plane and holder laws read
-    // what the program ahead removed, so its stamp carries the same
-    // digest - a drill judged against an earlier pocket goes Stale
-    // when that pocket's recorded path moves. Only Drill joins here
-    // (#109 owns the general case for every other kind).
-    if matches!(params.kind(), OpType::Pocket3D | OpType::Drill)
+    // what the program ahead removed. Issue #109: so does every
+    // unposed op's rapid law (prior acquittal, pilot and facing
+    // credits) - each carries the digest (one-time Stale, by design).
+    if super::drill_prior::reads_prior(params)
         && let Some(digest) = crate::rest::prior_digest(world, op_name, setup)
     {
         h.write_u8(b'R');
@@ -390,7 +389,7 @@ pub fn stale_reason(
     // clean while the stamp still mismatches, so a cutting
     // predecessor's recorded path is what moved - whatever its own
     // status reads.
-    if matches!(op.params.kind(), OpType::Pocket3D | OpType::Drill)
+    if super::drill_prior::reads_prior(&op.params)
         && let Some(name) = model::name_of(world, entity)
         && let Some(why) = crate::rest::prior_stale(world, &name, op.setup.as_deref())
     {
diff --git a/crates/app/tests/common/bore.rs b/crates/app/tests/common/bore.rs
new file mode 100644
index 00000000..123b5526
--- /dev/null
+++ b/crates/app/tests/common/bore.rs
@@ -0,0 +1,193 @@
+//! The boring suites' shared document (#109 split it out of
+//! turning_bore.rs, which stood at the 400-line law): a bored bar and a
+//! plain wall on a mounted lathe, the lathe steel on the rack, and the
+//! axial pilot drill a boring bar's approach runs down (#103).
+//!
+//! Provenance: our own fixtures, specced from the turning kernel's
+//! design notes; no vendor material consulted.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, ImportModel, LoadMachine, SetStock};
+use camcraft_app::drilling::{CycleChoice, Hole};
+use camcraft_app::geo2d::Point2;
+use camcraft_app::geometry::{Mesh, Point3, Triangle};
+use camcraft_app::machine::Machine;
+use camcraft_app::model;
+use camcraft_app::operation::{Height, OpParams, OpStatus, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::tools::{catalog, Tool};
+use camcraft_app::world::new_world;
+
+pub const TAU: f64 = std::f64::consts::TAU;
+pub const BLANK: f64 = 10.0;
+pub const WALL: f64 = 6.0;
+pub const FLOOR: f64 = -20.0;
+pub const D: f64 = 0.4;
+
+pub fn catalog_tool(name: &str) -> Tool {
+    catalog()
+        .into_iter()
+        .find(|(n, _)| *n == name)
+        .map(|(_, t)| t)
+        .expect("catalog entry")
+}
+
+pub fn add_tool(world: &World, history: &mut History, name: &str) {
+    let cmd = AddTool::new(world, name, catalog_tool(name));
+    history.execute(world, cmd.expect("catalog tool"));
+}
+
+pub fn status(world: &World, name: &str) -> OpStatus {
+    let e = model::find_by_name(world, name).expect("entity exists");
+    camcraft_app::operation::status_of(world, &e)
+}
+
+pub fn cache(world: &World, name: &str) -> Option<camcraft_app::schema::Toolpath> {
+    model::find_by_name(world, name).and_then(|e| model::toolpath_of(world, &e))
+}
+
+pub fn rho(q: Point3) -> f64 {
+    (q.x * q.x + q.y * q.y).sqrt()
+}
+
+/// The closed-solid revolve the turning suites share.
+pub fn revolve(meridian: &[(f64, f64)]) -> Mesh {
+    let v = |j: usize, r: f64, z: f64| {
+        let th = TAU * j as f64 / 16.0;
+        Point3::new(r * th.cos(), r * th.sin(), z)
+    };
+    let mut facets = Vec::new();
+    for seg in meridian.windows(2) {
+        let ((ra, za), (rb, zb)) = (seg[0], seg[1]);
+        for j in 0..16 {
+            let (a1, a2, b1, b2) = (v(j, ra, za), v(j + 1, ra, za), v(j, rb, zb), v(j + 1, rb, zb));
+            if ra <= 1e-12 {
+                facets.push(Triangle::new(a1, b2, b1));
+            } else if rb <= 1e-12 {
+                facets.push(Triangle::new(a1, a2, b2));
+            } else {
+                facets.push(Triangle::new(a1, a2, b2));
+                facets.push(Triangle::new(a1, b2, b1));
+            }
+        }
+    }
+    Mesh::from_facets(facets)
+}
+
+/// The bored bar: OD 10, an open hole of radius 6 from the top down
+/// to a floor at -20, on a bar long past the hole so the axis fit
+/// reads a revolve, not a dome.
+pub fn bored() -> Mesh {
+    revolve(&[
+        (0.0, -50.0),
+        (BLANK, -50.0),
+        (BLANK, 50.0),
+        (WALL, 50.0),
+        (WALL, FLOOR),
+        (0.0, FLOOR),
+    ])
+}
+
+/// The plain bar the hole-existence door must refuse.
+pub fn wall() -> Mesh {
+    revolve(&[(0.0, -50.0), (BLANK, -50.0), (BLANK, 50.0), (0.0, 50.0)])
+}
+
+pub fn machine(word: &str) -> Machine {
+    Machine {
+        model: format!("TestBench {word}"),
+        kind: Some(word.to_string()),
+        ..Default::default()
+    }
+}
+
+/// A document the boring kind lives in: the bored bar AND a smooth
+/// wall in bar-sized stock, the lathe mounted, the catalog boring
+/// bar (and the other lathe steel) on the rack.
+pub fn bore_world() -> (World, History) {
+    let world = new_world();
+    let mut history = History::default();
+    history.execute(
+        &world,
+        SetStock::new(
+            &world,
+            // Bar-sized stock (#103): the blank's own diameter over
+            // its Z span - the turning kernels never cut stock beyond
+            // the part (#130), so a wider blank is a real crash.
+            camcraft_app::stock::StockShape::Cylinder { diameter: 2.0 * BLANK, height: 100.0 },
+            Location { pos: Point3::new(0.0, 0.0, -50.0), ..Location::default() },
+        )
+        .expect("bar stock"),
+    );
+    let cmd = LoadMachine::new(&world, "lathe.mch".into(), Some(machine("lathe")));
+    history.execute(&world, cmd.expect("lathe"));
+    add_tool(&world, &mut history, "BR-1000");
+    add_tool(&world, &mut history, "TN-1600-0R8");
+    add_tool(&world, &mut history, "EM-0400-2FL");
+    // The pilots' long-series drills: 70 mm of flute for the 62 mm
+    // hole - a Ø11 that clears the bar's Ø10 body (#103 review B1), and
+    // a Ø4 it cannot pass.
+    let mut long = catalog_tool("DR-0400");
+    long.flute_len = 70.0;
+    history.execute(&world, AddTool::new(&world, "DR-0400-L", long.clone()).expect("a sane drill"));
+    long.diameter = 11.0;
+    long.shank_d = 11.0;
+    history.execute(&world, AddTool::new(&world, "DR-1100-L", long).expect("a sane drill"));
+    history.execute(&world, ImportModel::from_mesh("bar", bored()));
+    history.execute(&world, ImportModel::from_mesh("wall", wall()));
+    (world, history)
+}
+
+pub fn bore_params() -> OpParams {
+    OpParams::BoringTurning {
+        tolerance: 0.05,
+        clearance_z: Height::fixed(60.0),
+        top_z: Height::fixed(40.0),
+        bottom_z: Height::fixed(-10.0),
+        feed: 120.0,
+        plunge_feed: 40.0,
+    }
+}
+
+pub fn create_on(world: &World, history: &mut History, name: &str, tool: &str, src: &str, params: OpParams) {
+    history.execute(
+        world,
+        CreateOperation::new(world, name, tool, SrcRef::Entity(src.into()), params)
+            .expect("create"),
+    );
+    history.execute(world, GenerateOperation::new(world, name).expect("generate"));
+}
+
+pub fn create(world: &World, history: &mut History, name: &str, params: OpParams) {
+    create_on(world, history, name, "BR-1000", "bar", params);
+}
+
+/// The pilot a boring bar needs (#103): an axial drill ahead (AX0 -
+/// program order reads names, so it sorts ahead of BR1 and ST), Ø11
+/// down the bar's axis from its top to Z -16 - its point clear under the ride's -10
+/// window, over the model's -20 floor, wide enough for the bar's Ø10
+/// body. The bar stock is solid; the bar's approach runs down this
+/// hole, and the rapid law credits it.
+pub fn pilot(world: &World, history: &mut History) {
+    pilot_of(world, history, "DR-1100-L", 5.55);
+}
+
+pub fn pilot_of(world: &World, history: &mut History, drill: &str, radius: f64) {
+    let hole = Hole { xy: Point2::new(0.0, 0.0), radius, entry_z: 50.0, floor_z: -16.0, through: false, stepped: false };
+    let params = OpParams::Drill {
+        clearance_z: Height::fixed(60.0),
+        retract_z: None,
+        top_z: Height::fixed(50.0),
+        bottom_z: None,
+        cycle: CycleChoice::Auto,
+        peck: 0.0,
+        dwell: 0.0,
+        feed: 120.0,
+        plunge_feed: 80.0,
+        holes: vec![hole],
+        cross: vec![],
+    };
+    create_on(world, history, "AX0", drill, "bar", params);
+    assert_eq!(status(world, "AX0"), OpStatus::Ok, "the pilot drills");
+}
