  {
    "sha": "9ad0fb52121b1be6286e7eb7579e4d1a51dfe55a",
    "node_id": "C_kwDOVVonwNoAKDlhZDBmYjUyMTIxYjFiZTYyODZlN2ViNzU3OWU0ZDFhNTFkZmU1NWE",
    "commit": {
      "author": {
        "name": "NeoTech",
        "email": "andreas@roughedge.se",
        "date": "2026-11-07T21:39:06Z"
      },
      "committer": {
        "name": "NeoTech",
