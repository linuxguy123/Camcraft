From fc7ad1b2675bbb715ae9a923ad01316e42e84fad Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 8 Nov 2026 11:16:03 +0100
Subject: [PATCH] feat(build): sign the Inno-embedded uninstaller when a
 certificate is configured

installer.ps1 asks sign.ps1 -Status whether CAMCRAFT_SIGN_* configures a
certificate. If so it passes /DSignToolName=camcraft, which turns on
SignTool=camcraft and SignedUninstaller=yes in camcraft.iss, and defines
that sign tool as a sign.ps1 call (/Scamcraft=...), so ISCC signs the
embedded uninstaller and the setup exe with the same signtool command and
timestamp server as the release exes. Without a certificate nothing is
passed and the build is the unsigned one it was, named in the log.

The separate sign.ps1 pass on the setup exe in release.ps1 and
release.yml is dropped (ISCC signs it now); release.yml's installer step
gains the CAMCRAFT_SIGN_CERT_PASSWORD env it was missing.

Fixes #29

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/release.yml         |  9 ++++---
 docs/decisions/29-sign-uninstaller.md | 28 ++++++++++++++++++++
 scripts/README.md                     | 16 ++++++++---
 scripts/installer.ps1                 | 38 ++++++++++++++++++++++++---
 scripts/installer/camcraft.iss        | 11 ++++++++
 scripts/release.ps1                   |  9 ++++---
 scripts/sign.ps1                      | 15 ++++++++++-
 7 files changed, 111 insertions(+), 15 deletions(-)
 create mode 100644 docs/decisions/29-sign-uninstaller.md

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 91b422b5..2c4251d7 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -221,13 +221,16 @@ jobs:
       - name: Build installer (Inno Setup, same staged tree as the zip)
         shell: pwsh
         # windows-latest ships Inno Setup 6; -Required makes a missing ISCC
-        # an error here (locally it is a named skip).
+        # an error here (locally it is a named skip). With the certificate
+        # secret set, installer.ps1 has ISCC sign the setup exe and the
+        # uninstaller it embeds through sign.ps1 (CAMCRAFT_SIGN_CERT_PATH
+        # comes from GITHUB_ENV, the password from this step's env).
+        env:
+          CAMCRAFT_SIGN_CERT_PASSWORD: ${{ secrets.CAMCRAFT_SIGN_CERT_PASSWORD }}
         run: |
           $ErrorActionPreference = "Stop"
           & scripts/installer.ps1 -Version $env:CAMCRAFT_VERSION -Required
           if ($LASTEXITCODE -ne 0) { throw "installer.ps1 exited with $LASTEXITCODE" }
-          & scripts/sign.ps1 -Path "dist/camcraft-$env:CAMCRAFT_VERSION-win-x64-setup.exe"
-          if ($LASTEXITCODE -ne 0) { throw "sign.ps1 exited with $LASTEXITCODE" }
           Get-ChildItem dist
       - name: Remove the signing certificate from the runner
         if: always()
diff --git a/docs/decisions/29-sign-uninstaller.md b/docs/decisions/29-sign-uninstaller.md
new file mode 100644
index 00000000..ff123b0f
--- /dev/null
+++ b/docs/decisions/29-sign-uninstaller.md
@@ -0,0 +1,28 @@
+## #29 - Sign the Inno-embedded uninstaller (2026-11-08)
+
+- **Chosen:** ISCC signs both the setup exe and the embedded uninstaller
+  through Inno Setup's named sign tool. `installer.ps1` asks
+  `sign.ps1 -Status` whether a certificate is configured; if so it passes
+  `/DSignToolName=camcraft` (the `.iss` turns on `SignTool=` and
+  `SignedUninstaller=yes` only under that define) and
+  `/Scamcraft=powershell.exe -NoProfile -ExecutionPolicy Bypass -File
+  $q<sign.ps1>$q -Path $f`. `sign.ps1` stays the only reader of
+  `CAMCRAFT_SIGN_*` and the only place holding the signtool command and
+  the timestamp URL; secrets reach the ISCC child through the inherited
+  environment, never its command line.
+- **Without a certificate:** no `/D`, no `/S`; the compile is the same
+  command as before plus a named log line ("installer signing: off").
+- **Dropped:** the separate `sign.ps1 -Path <setup.exe>` pass after
+  ISCC in `release.ps1` and `release.yml`. ISCC now signs the setup exe
+  itself; a second pass would re-sign (a second timestamp request) for
+  nothing. `installer.ps1` checks the setup exe carries a signature when
+  signing is on, so an ISCC that skipped the tool fails the build.
+- **Also fixed in passing:** `release.yml`'s installer step had no
+  `CAMCRAFT_SIGN_CERT_PASSWORD` in its env (only the earlier sign step
+  had it), so with the secret set its `sign.ps1` call would have failed
+  as half-configured. The step now carries it.
+- **Considered and dropped:** a sign tool defined in the `.iss`
+  (`SignTool=signtool ...`): it would duplicate the signtool command and
+  the certificate selection in a second file. A `$p`-parameterised tool
+  passing thumbprint/PFX args from installer.ps1: same duplication, and
+  it would put the PFX password on ISCC's command line.
diff --git a/scripts/README.md b/scripts/README.md
index 2d9f190e..ef1589e0 100644
--- a/scripts/README.md
+++ b/scripts/README.md
@@ -95,8 +95,17 @@ writes `dist/camcraft-<ver>-win-x64-setup.exe` beside the zip.
 
 `sign.ps1` signs exes and the installer with `signtool` (SHA-256 digest,
 RFC-3161 timestamp so signatures outlive the certificate). It is called by
-`release.ps1` after the build and before the zip, and again on the
-installer; `release.yml` does the same.
+`release.ps1` after the build and before the zip; `release.yml` does the
+same.
+
+The installer and the uninstaller Inno Setup embeds in it are signed by
+ISCC itself, through `sign.ps1`: when `sign.ps1 -Status` reports a
+certificate, `installer.ps1` passes `/DSignToolName=camcraft` (which turns
+on `SignTool=camcraft` and `SignedUninstaller=yes` in `camcraft.iss`) and
+`/Scamcraft=powershell.exe ... sign.ps1 -Path $f`, so ISCC runs the same
+signtool command on the uninstaller and on the setup exe. Without a
+certificate neither switch is passed (`installer signing: off ...` in the
+log) and the build is the unsigned one it always was.
 
 With no certificate configured it prints `unsigned: no certificate
 configured` and exits 0: the unsigned release is a legitimate release, as
@@ -120,5 +129,4 @@ an unsigned release, not a failed one.
 
 Obtaining a certificate: buy an OV or EV code-signing certificate from any
 public CA (EV ones live on hardware tokens or a cloud signing service, which
-is the local-thumbprint route). Known follow-on: the uninstaller embedded by
-Inno Setup is not signed yet (Inno's `SignTool` directive is the hook).
+is the local-thumbprint route).
diff --git a/scripts/installer.ps1 b/scripts/installer.ps1
index fa46c4c6..510c2759 100644
--- a/scripts/installer.ps1
+++ b/scripts/installer.ps1
@@ -1,6 +1,8 @@
 # Installer build (M13.3): compiles scripts/installer/camcraft.iss with
 # Inno Setup against an already-staged dist tree (the zip's) and writes
-# dist/camcraft-<ver>-win-x64-setup.exe beside the zip.
+# dist/camcraft-<ver>-win-x64-setup.exe beside the zip. With a certificate
+# configured (CAMCRAFT_SIGN_*, scripts/sign.ps1) ISCC signs the setup exe
+# and its embedded uninstaller; without one both stay unsigned, as before.
 #
 # Usage: powershell -File scripts/installer.ps1 -Version 0.8.0 `
 #            [-Stage dist/camcraft-0.8.0-win-x64] [-OutDir dist] [-Required]
@@ -53,12 +55,42 @@ $stageAbs = (Resolve-Path $Stage).Path
 $outAbs = (Resolve-Path $OutDir).Path
 $iss = Join-Path $PSScriptRoot "installer\camcraft.iss"
 
-# ---- 3. Compile ---------------------------------------------------------
-$isccArgs = @("/Qp", "/DAppVersion=$Version", "/DStageDir=$stageAbs", "/DOutDir=$outAbs", $iss)
+# ---- 3. Signing: sign.ps1 decides, ISCC calls it ------------------------
+# sign.ps1 -Status is the one reader of CAMCRAFT_SIGN_*. Configured, ISCC
+# gets a sign tool named "camcraft" that runs sign.ps1 on each file it
+# signs ($f = the quoted file, $q = a quote; Inno Setup SignTool syntax),
+# and the .iss turns on SignTool + SignedUninstaller, so the setup exe AND
+# the uninstaller embedded in it are signed by the same signtool command
+# and timestamp server as the release exes. Not configured, no sign tool
+# is passed and the build is byte-for-byte today's unsigned one.
+$signScript = Join-Path $PSScriptRoot "sign.ps1"
+& powershell -NoProfile -ExecutionPolicy Bypass -File $signScript -Status
+$signStatus = $LASTEXITCODE
+$signArgs = @()
+if ($signStatus -eq 0) {
+    # Single-quoted: $q and $f are ISCC's placeholders, not PowerShell's.
+    $tool = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File $q' + $signScript + '$q -Path $f'
+    $signArgs = @("/DSignToolName=camcraft", "/Scamcraft=$tool")
+    Write-Host "installer signing: on (setup exe and embedded uninstaller, via sign.ps1)"
+} elseif ($signStatus -eq 10) {
+    Write-Host "installer signing: off (no certificate configured); setup and uninstaller ship unsigned"
+} else {
+    Fail "sign.ps1 -Status exited with $signStatus (signing half-configured)"
+}
+
+# ---- 4. Compile ---------------------------------------------------------
+$isccArgs = @("/Qp", "/DAppVersion=$Version", "/DStageDir=$stageAbs", "/DOutDir=$outAbs") + $signArgs + @($iss)
 Write-Host "> ISCC $($isccArgs -join ' ')"
 & $iscc @isccArgs
 if ($LASTEXITCODE -ne 0) { Fail "ISCC exited with $LASTEXITCODE" }
 $setup = Join-Path $outAbs "camcraft-$Version-win-x64-setup.exe"
 if (-not (Test-Path $setup)) { Fail "ISCC succeeded but $setup is missing" }
+if ($signArgs.Count -gt 0) {
+    # sign.ps1 already ran signtool verify on each file ISCC handed it; this
+    # catches an ISCC that silently skipped the sign tool.
+    $sig = Get-AuthenticodeSignature $setup
+    if (-not $sig.SignerCertificate) { Fail "signing is configured but $setup carries no signature" }
+    Write-Host "setup signed by: $($sig.SignerCertificate.Subject)"
+}
 Write-Host "Installer: $setup"
 exit 0
diff --git a/scripts/installer/camcraft.iss b/scripts/installer/camcraft.iss
index ff22370e..5d929e4c 100644
--- a/scripts/installer/camcraft.iss
+++ b/scripts/installer/camcraft.iss
@@ -11,6 +11,12 @@
 ;   ISCC.exe /DAppVersion=0.8.0 /DStageDir=dist\camcraft-0.8.0-win-x64 ^
 ;            /DOutDir=dist scripts\installer\camcraft.iss
 ; Every /D below has a default so the script also compiles from the IDE.
+;
+; Signing: when a certificate is configured (CAMCRAFT_SIGN_*, see
+; scripts/sign.ps1) installer.ps1 adds /DSignToolName=camcraft and defines
+; that sign tool with /Scamcraft=<sign.ps1 call>. ISCC then signs both the
+; setup exe and the uninstaller it embeds. Without it nothing is signed and
+; the script compiles exactly as an unsigned build always has.
 
 #ifndef AppVersion
   #define AppVersion "0.0.0"
@@ -51,6 +57,11 @@ WizardStyle=modern
 UninstallDisplayName={#AppName} {#AppVersion}
 UninstallDisplayIcon={app}\{#AppExe}
 ShowLanguageDialog=no
+#ifdef SignToolName
+; Named sign tool, defined on the ISCC command line by installer.ps1.
+SignTool={#SignToolName}
+SignedUninstaller=yes
+#endif
 ; The uninstaller removes what the installer wrote; user data in the install
 ; dir (projects, exported NC) is left alone - it is listed, never deleted.
 
diff --git a/scripts/release.ps1 b/scripts/release.ps1
index df150be5..9c6e2832 100644
--- a/scripts/release.ps1
+++ b/scripts/release.ps1
@@ -217,11 +217,12 @@ if (-not $Installer) {
 } else {
     $installerScript = Join-Path $PSScriptRoot "installer.ps1"
     Run "powershell" @("-NoProfile", "-ExecutionPolicy", "Bypass", "-File", $installerScript, "-Version", $Version, "-Stage", $stage, "-OutDir", (Join-Path $root "dist"))
+    # installer.ps1 signs the setup exe and its embedded uninstaller through
+    # ISCC's SignTool when a certificate is configured (sign.ps1 decides), so
+    # no separate sign.ps1 pass on the setup exe here.
     if ($DryRun) {
-        Write-Host "[dry-run] sign.ps1 -Path $setup (if ISCC produced it)"
-    } elseif (Test-Path $setup) {
-        Run "powershell" @("-NoProfile", "-ExecutionPolicy", "Bypass", "-File", $signScript, "-Path", $setup)
-    } else {
+        Write-Host "[dry-run] installer.ps1 signs setup + uninstaller via ISCC SignTool if CAMCRAFT_SIGN_* is set"
+    } elseif (-not (Test-Path $setup)) {
         Write-Host "no installer produced (ISCC.exe missing); the zip is the release"
     }
 }
diff --git a/scripts/sign.ps1 b/scripts/sign.ps1
index 5c57106b..0b86aae8 100644
--- a/scripts/sign.ps1
+++ b/scripts/sign.ps1
@@ -11,11 +11,21 @@
 #   CAMCRAFT_SIGN_TIMESTAMP_URL   optional RFC-3161 server override
 #
 # Usage: powershell -File scripts/sign.ps1 -Path a.exe, b.exe
+#        powershell -File scripts/sign.ps1 -Status   (configured? see below)
+#
+# -Status answers "is a certificate configured?" without signing anything:
+# exit 0 configured, exit 10 not configured (prints the unsigned line), exit
+# 1 half-configured. installer.ps1 asks it before wiring Inno Setup's
+# SignTool, so this file stays the one place that reads CAMCRAFT_SIGN_*.
+# Inno Setup calls this script as its sign tool for the setup exe AND the
+# uninstaller it embeds (installer.ps1, /Scamcraft=...), so the signtool
+# command and the timestamp server below are the only ones in the repo.
 # Exit 0 when unsigned-by-configuration or signed and verified; exit 1 when a
 # certificate IS configured but signing cannot proceed (missing signtool,
 # missing file, signtool failure) - a configured-but-broken setup is an error.
 param(
-    [Parameter(Mandatory = $true)][string[]]$Path,
+    [string[]]$Path = @(),
+    [switch]$Status,
     [string]$Description = "camcraft",
     [string]$TimestampUrl = ""
 )
@@ -43,8 +53,11 @@ if ($thumb) {
 } else {
     Write-Host "unsigned: no certificate configured"
     Write-Host "  (set CAMCRAFT_SIGN_THUMBPRINT, or CAMCRAFT_SIGN_CERT_PATH + CAMCRAFT_SIGN_CERT_PASSWORD; see scripts/README.md)"
+    if ($Status) { exit 10 }
     exit 0
 }
+if ($Status) { exit 0 }
+if ($Path.Count -eq 0) { Fail "-Path is required (the files to sign)" }
 
 # ---- 2. Find signtool ---------------------------------------------------
 # PATH first (the GitHub runner and a Developer Command Prompt have it),
