index 455746e1..ca142979 100644
--- a/crates/app/src/setup_sheet/mod.rs
+++ b/crates/app/src/setup_sheet/mod.rs
@@ -107,7 +107,7 @@ pub fn render(world: &World, setup_name: Option<&str>) -> Result<String, String>
