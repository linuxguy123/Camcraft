From a9aa8324d7b0d58bf1b1ef97801722c4eaa7d503 Mon Sep 17 00:00:00 2001
From: bherbruck <brennen.herbruck@gmail.com>
Date: Sat, 7 Nov 2026 17:46:06 -0500
Subject: [PATCH 1/3] fix(app): a new operation posts after its setup's
 existing ones, not in name order

CreateOperation now pins its op at the end of the setup's program order
with an explicit order index, the same append PasteOperation already
did (shared as append_position). Siblings without a stored position
(older projects) are pinned at their current name-order position, so
nothing already in a program moves; undo restores their unpinned meta.
Previously a 'Finish' created after a 'Rough' posted first, and since
#103/#109 that order decides the prior laws' verdicts.

Fixes #167

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/src/commands/operation/create.rs | 83 +++++++++++++--------
 crates/app/tests/operation_metadata.rs      | 42 +++++++++++
 2 files changed, 95 insertions(+), 30 deletions(-)

diff --git a/crates/app/src/commands/operation/create.rs b/crates/app/src/commands/operation/create.rs
index 382c048b..2ace5d39 100644
--- a/crates/app/src/commands/operation/create.rs
+++ b/crates/app/src/commands/operation/create.rs
@@ -21,6 +21,49 @@ use super::gates::{area_gate, check_tool, family_gate, heights_gate, tool_gate,
 pub struct CreateOperation {
     name: String,
     operation: Operation,
+    /// The op's explicit position: the end of its setup's program order
+    /// (#167), so the post and the tree run it after every sibling.
+    meta: OperationMeta,
+    /// Siblings whose positions were made explicit (before, after).
+    reordered: Reordered,
+}
+
+/// `(key, before, after)` for each sibling whose position an append pins.
+type Reordered = Vec<(String, OperationMeta, OperationMeta)>;
+
+/// Pin every operation of the setup `context` resolves to at its current
+/// program position (0..n) and return those changes with the next free
+/// index `n` - so a new op lands last even when an older project's
+/// siblings carry no stored order (their name order is kept, made explicit).
+fn append_position(world: &World, context: Option<&str>) -> Result<(Reordered, u32), CommandError> {
+    let effective = setup::effective(world, context);
+    let siblings: Vec<_> = setup::operation_order(world)
+        .into_iter()
+        .filter(|(_, entity)| {
+            model::operation_of(world, entity)
+                .and_then(|op| setup::effective(world, op.setup.as_deref())) == effective
+        })
+        .collect();
+    let mut reordered = Vec::with_capacity(siblings.len());
+    for (index, (sibling, entity)) in siblings.into_iter().enumerate() {
+        let order = u32::try_from(index)
+            .map_err(|_| CommandError::Invalid("too many operations".into()))?;
+        let before = model::operation_meta_of(world, &entity);
+        let mut after = before.clone();
+        after.order = Some(order);
+        reordered.push((sibling, before, after));
+    }
+    let order = u32::try_from(reordered.len())
+        .map_err(|_| CommandError::Invalid("too many operations".into()))?;
+    Ok((reordered, order))
+}
+
+fn set_metas(world: &World, rows: &Reordered, after: bool) {
+    for (name, before, next) in rows {
+        if let Some(entity) = model::find_by_name(world, name) {
+            entity.entity_view(world).set(if after { next.clone() } else { before.clone() });
+        }
+    }
 }
 
 impl CreateOperation {
@@ -61,8 +104,11 @@ impl CreateOperation {
         family_gate(world, &params)?;
         tool_gate(world, &params, tool)?;
         area_gate(world, setup.as_deref(), &src, &params)?;
+        let (reordered, order) = append_position(world, setup.as_deref())?;
         Ok(CreateOperation {
             name: name.to_string(),
+            meta: OperationMeta { label: None, order: Some(order) },
+            reordered,
             operation: Operation {
                 tool: tool.to_string(),
                 src,
@@ -77,17 +123,20 @@ impl CreateOperation {
 
 impl Command for CreateOperation {
     fn apply(&self, world: &World) {
+        set_metas(world, &self.reordered, true);
         let entity = match model::find_by_name(world, &self.name) {
             Some(entity) => entity,
             None => model::spawn(world, &self.name),
         };
         entity.entity_view(world).set(self.operation.clone());
+        entity.entity_view(world).set(self.meta.clone());
     }
 
     fn invert(&self, world: &World) {
         if let Some(entity) = model::find_by_name(world, &self.name) {
             model::remove(world, &entity);
         }
+        set_metas(world, &self.reordered, false);
     }
 }
 
@@ -98,7 +147,7 @@ pub struct PasteOperation {
     name: String,
     operation: Operation,
     meta: OperationMeta,
-    reordered: Vec<(String, OperationMeta, OperationMeta)>,
+    reordered: Reordered,
 }
 
 impl PasteOperation {
@@ -126,25 +175,7 @@ impl PasteOperation {
         area_gate(world, context, &operation.src, &operation.params)?;
         operation.stamp = None;
 
-        let effective = setup::effective(world, context);
-        let siblings: Vec<_> = setup::operation_order(world)
-            .into_iter()
-            .filter(|(_, entity)| {
-                model::operation_of(world, entity)
-                    .and_then(|op| setup::effective(world, op.setup.as_deref())) == effective
-            })
-            .collect();
-        let mut reordered = Vec::with_capacity(siblings.len());
-        for (index, (sibling, entity)) in siblings.into_iter().enumerate() {
-            let order = u32::try_from(index)
-                .map_err(|_| CommandError::Invalid("too many operations".into()))?;
-            let before = model::operation_meta_of(world, &entity);
-            let mut after = before.clone();
-            after.order = Some(order);
-            reordered.push((sibling, before, after));
-        }
-        let order = u32::try_from(reordered.len())
-            .map_err(|_| CommandError::Invalid("too many operations".into()))?;
+        let (reordered, order) = append_position(world, context)?;
         Ok(Self {
             name: name.to_owned(),
             operation,
@@ -156,11 +187,7 @@ impl PasteOperation {
 
 impl Command for PasteOperation {
     fn apply(&self, world: &World) {
-        for (name, _, after) in &self.reordered {
-            if let Some(entity) = model::find_by_name(world, name) {
-                entity.entity_view(world).set(after.clone());
-            }
-        }
+        set_metas(world, &self.reordered, true);
         if model::find_by_name(world, &self.name).is_none() {
             let entity = model::spawn(world, &self.name);
             entity.entity_view(world).set(self.operation.clone());
@@ -172,11 +199,7 @@ impl Command for PasteOperation {
         if let Some(entity) = model::find_by_name(world, &self.name) {
             model::remove(world, &entity);
         }
-        for (name, before, _) in &self.reordered {
-            if let Some(entity) = model::find_by_name(world, name) {
-                entity.entity_view(world).set(before.clone());
-            }
-        }
+        set_metas(world, &self.reordered, false);
     }
 }
 
diff --git a/crates/app/tests/operation_metadata.rs b/crates/app/tests/operation_metadata.rs
index 2353017f..1dd93d5e 100644
--- a/crates/app/tests/operation_metadata.rs
+++ b/crates/app/tests/operation_metadata.rs
@@ -117,6 +117,14 @@ fn version_49_operations_keep_legacy_name_order() {
     let mut file: serde_json::Value = serde_json::from_slice(&std::fs::read(&path).expect("file"))
         .expect("JSON");
     file["version"] = serde_json::json!(49);
+    // A real v49 file never carried positions: strip the ones #167 stores.
+    if let Some(entities) = file["entities"].as_array_mut() {
+        for entity in entities {
+            if let Some(op) = entity.get_mut("operation").and_then(|o| o.as_object_mut()) {
+                op.remove("order");
+            }
+        }
+    }
     std::fs::write(&path, serde_json::to_vec_pretty(&file).expect("JSON")).expect("downgrade fixture");
     let loaded = new_world();
     project::load(&loaded, &path).expect("v49 migration");
@@ -124,3 +132,37 @@ fn version_49_operations_keep_legacy_name_order() {
     assert_eq!(keys(&loaded), ["A_Face", "Z_Face"]);
     assert_eq!(label(&loaded, "A_Face"), "A_Face");
 }
+
+#[test]
+fn created_operations_post_in_creation_order_not_name_order() {
+    let (world, mut history) = seed();
+    add(&world, &mut history, "Rough");
+    add(&world, &mut history, "Finish");
+    assert_eq!(keys(&world), ["Rough", "Finish"], "#167: creation order, not name order");
+    add(&world, &mut history, "B");
+    add(&world, &mut history, "A");
+    assert_eq!(keys(&world), ["Rough", "Finish", "B", "A"]);
+    history.undo(&world);
+    assert_eq!(keys(&world), ["Rough", "Finish", "B"]);
+    history.redo(&world);
+    assert_eq!(keys(&world), ["Rough", "Finish", "B", "A"]);
+}
+
+#[test]
+fn creating_after_legacy_unordered_ops_keeps_their_name_order() {
+    let (world, mut history) = seed();
+    add(&world, &mut history, "Z_Face");
+    add(&world, &mut history, "A_Face");
+    // An older project's ops carry no stored position: they read in name order.
+    for name in ["Z_Face", "A_Face"] {
+        let entity = model::find_by_name(&world, name).expect("op");
+        entity.entity_view(&world).set(camcraft_app::schema::OperationMeta::default());
+    }
+    assert_eq!(keys(&world), ["A_Face", "Z_Face"]);
+    add(&world, &mut history, "M_Face");
+    assert_eq!(keys(&world), ["A_Face", "Z_Face", "M_Face"], "legacy order kept, new op last");
+    history.undo(&world);
+    assert_eq!(keys(&world), ["A_Face", "Z_Face"]);
+    let legacy = model::find_by_name(&world, "Z_Face").expect("op");
+    assert_eq!(model::operation_meta_of(&world, &legacy).order, None, "undo restores the unpinned position");
+}

From 7274f156b3bf1e4691b6227e015153abf557d953 Mon Sep 17 00:00:00 2001
From: bherbruck <brennen.herbruck@gmail.com>
