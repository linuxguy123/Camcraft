+## #230 - a snug cylinder fit (2026-11-08)
+
+- **Chosen:** Fit to Models' cylinder takes its radius from the models'
+  largest horizontal distance from the fit's vertical axis through the
+  bounds' XY centre (`model::solid_world_radius_about`) plus the margin
+  (`stock::fit_cylinder_about`), instead of the padded footprint's
+  diagonal. For a turned part standing on its axis that is its revolved
+  max radius: a round R part gets an R + allowance bar, not ~1.41 R.
+- **Why it is safe for every cylinder fit (mill too):** the radius is the
+  farthest vertex from the axis, so the cylinder still contains the whole
+  model; it is never larger than the old diagonal bound.
+- **Changes for existing documents:** none on load - a stock already
+  fitted keeps its explicit numbers; only a new Fit (cylinder) is snugger.
+- **Dropped:** fitting about the spindle axis of a lathe's G54 instead of
+  the bounds' centre (a part off the origin is refused by the lathe
+  spindle law anyway, and the fit has always centred on the models).
diff --git a/crates/app/src/model.rs b/crates/app/src/model.rs
index 1c2007cf..b3cce289 100644
--- a/crates/app/src/model.rs
+++ b/crates/app/src/model.rs
@@ -301,6 +301,31 @@ pub fn entity_world_aabb(world: &World, entity: &Entity) -> Option<Aabb> {
     })
 }
 
+/// The models' largest horizontal distance from the vertical line through
+/// `c` (world XY) - for a turned part standing on its axis there, its
+/// revolved max radius (#230's snug cylinder fit). Stock and WCS are
+/// excluded as in [`solid_world_aabb`]; `None` with no model geometry.
+#[must_use]
+pub fn solid_world_radius_about(world: &World, c: [f64; 2]) -> Option<f64> {
+    let mut r_max: Option<f64> = None;
+    for (_, entity) in model_entities(world) {
+        let Some(tris) = facets_of(world, &entity) else {
+            continue;
+        };
+        let loc = transform_of(world, &entity).unwrap_or_default();
+        for t in tris.iter() {
+            for p in [t.a, t.b, t.c] {
+                let p = transform_point(p, loc.pos, loc.rot);
+                let r = (p.x - c[0]).hypot(p.y - c[1]);
+                if r.is_finite() {
+                    r_max = Some(r_max.map_or(r, |m| m.max(r)));
+                }
+            }
+        }
+    }
+    r_max
+}
+
 /// World-space bounding box of all model geometry. Stock and WCS are excluded
 /// on purpose: fitting stock to a set that contains the stock would grow
 /// forever on repeated Fit.
diff --git a/crates/geometry/src/geometry/stock.rs b/crates/geometry/src/geometry/stock.rs
index 7f1e7b17..a37cf981 100644
--- a/crates/geometry/src/geometry/stock.rs
+++ b/crates/geometry/src/geometry/stock.rs
@@ -140,9 +140,43 @@ pub fn fit_cylinder(bounds: &Aabb, margin: f64) -> Option<(StockShape, Point3)>
     }, pos))
 }
 
+/// Cylinder stock about the vertical axis through `bounds`' XY centre
+/// whose radius is `r_max` - the models' largest horizontal distance from
+/// that axis (a turned part's revolved max radius) - plus `margin`, the
+/// height spanning z plus margins (#230). Snug: it contains every vertex
+/// yet never exceeds [`fit_cylinder`]'s padded diagonal. `None` for a
+/// non-finite or negative radius or margin, or degenerate bounds.
+#[must_use]
+pub fn fit_cylinder_about(bounds: &Aabb, r_max: f64, margin: f64) -> Option<(StockShape, Point3)> {
+    if !(r_max.is_finite() && r_max >= 0.0) {
+        return None;
+    }
+    let ([_, _, wz], pos) = fit_measures(bounds, margin)?;
+    let diameter = 2.0 * (r_max + margin);
+    if !positive(diameter) {
+        return None;
+    }
+    Some((StockShape::Cylinder { diameter, height: wz }, pos))
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    #[test]
+    fn a_snug_cylinder_is_the_revolved_radius_plus_the_allowance() {
+        // A round part of radius 10, z 0..30, centred on the origin.
+        let b = Aabb { min: Point3::new(-10.0, -10.0, 0.0), max: Point3::new(10.0, 10.0, 30.0) };
+        let (shape, pos) = fit_cylinder_about(&b, 10.0, 2.0).expect("fits");
+        assert_eq!(shape, StockShape::Cylinder { diameter: 24.0, height: 34.0 }, "R + allowance, not 1.41 R");
+        assert_eq!(pos, Point3::new(0.0, 0.0, -2.0));
+        let (loose, _) = fit_cylinder(&b, 2.0).expect("the diagonal fit");
+        let (StockShape::Cylinder { diameter: dl, .. }, StockShape::Cylinder { diameter: ds, .. }) = (loose, shape) else {
+            panic!("cylinders");
+        };
+        assert!(ds < dl, "snugger than the diagonal: {ds} vs {dl}");
+        assert!(fit_cylinder_about(&b, f64::NAN, 2.0).is_none() && fit_cylinder_about(&b, -1.0, 2.0).is_none());
+    }
     use crate::geometry::Mesh;
 
     #[test]
