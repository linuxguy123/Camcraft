From 3761f682eafbe66b84ea2f451058b0a440203e89 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Fri, 27 Nov 2026 02:52:44 -0800
Subject: [PATCH] test: follow the LinuxCNC preamble (#4196) and Tormach G54.1
 P offsets (#4299)

Two posts changed on purpose and three suites on main still read the old
output:

- #4196 writes G92.1 G97 in the LinuxCNC preamble. The mirror trace model
  refused both codes ("G92.1 is not modelled"), and the flipped-x golden
  had the old line. G92.1 clears G92 offsets (the trace models none) and
  G97 sets rpm mode; neither moves the tool. The golden diff is exactly
  that preamble line.
- #4299 raised Tormach's offsets to 500 (G54.1 P10-P500). wcs_index and
  the UI combo test still expected nine. The setup command keeps its own
  bound (MAX_SLOT + 1 = 255), so the combo lists 255 entries.

No product code changes.

Fixes #4322

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/wcs_index.rs                   | 10 ++++++----
 crates/post/tests/golden/wcs_flip/linuxcnc_x.nc |  2 +-
 crates/post/tests/mirror_trace/mod.rs           |  1 +
 crates/ui/src/egui_app/setup_wcs_tests.rs       | 11 +++++++----
 4 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/crates/app/tests/wcs_index.rs b/crates/app/tests/wcs_index.rs
index 26e71eb51a..36719a5f6d 100644
--- a/crates/app/tests/wcs_index.rs
+++ b/crates/app/tests/wcs_index.rs
@@ -137,8 +137,9 @@ fn the_command_refuses_an_offset_the_setups_post_cannot_express() {
     let msg = err.to_string();
     assert!(msg.contains("setup Setup1 uses work offset 7") && msg.contains("1-6"), "{msg}");
     set_post(&world, &mut h, Some(TORMACH));
-    assert!(SetSetupWorkOffset::new(&world, "Setup1", Some(8)).is_ok(), "Tormach has nine");
-    assert!(SetSetupWorkOffset::new(&world, "Setup1", Some(9)).is_err(), "but not ten");
+    // Tormach states 500 offsets (G54.1 P10-P500, #4299); the setup command
+    // still stops at its own sanity bound (MAX_SLOT + 1 = 255).
+    assert!(SetSetupWorkOffset::new(&world, "Setup1", Some(setup_offsets::MAX_SLOT - 1)).is_ok(), "Tormach goes past nine");
     assert!(SetSetupWorkOffset::new(&world, "Setup1", Some(setup_offsets::MAX_SLOT + 1)).is_err(), "the sanity bound");
 }
 
@@ -146,10 +147,11 @@ fn the_command_refuses_an_offset_the_setups_post_cannot_express() {
 fn the_setups_post_names_its_offsets() {
     let (world, mut h) = faced_block(Some(TORMACH));
     let t = setup::work_offset_names(&world, Some("Setup1"));
-    assert_eq!(t.max, 9);
+    assert_eq!(t.max, 500);
     assert_eq!(setup::offset_name(&world, Some("Setup1"), 1), "G54");
     assert_eq!(setup::offset_name(&world, Some("Setup1"), 7), "G59.1");
-    assert_eq!(setup::offset_name(&world, Some("Setup1"), 10), "work offset 10", "never another offset's name");
+    assert_eq!(setup::offset_name(&world, Some("Setup1"), 10), "G54.1 P10");
+    assert_eq!(setup::offset_name(&world, Some("Setup1"), 501), "work offset 501", "never another offset's name");
     set_post(&world, &mut h, None);
     assert_eq!(setup::work_offset_names(&world, Some("Setup1")).max, 6, "the document's Fanuc");
 }
diff --git a/crates/post/tests/golden/wcs_flip/linuxcnc_x.nc b/crates/post/tests/golden/wcs_flip/linuxcnc_x.nc
index 522c6b1981..e28e214e2b 100644
--- a/crates/post/tests/golden/wcs_flip/linuxcnc_x.nc
+++ b/crates/post/tests/golden/wcs_flip/linuxcnc_x.nc
@@ -1,5 +1,5 @@
 (VMC 3-AXIS)
-G21 G17 G90 G91.1 G94 G40 G49 G80
+G21 G17 G90 G91.1 G94 G40 G49 G80 G92.1 G97
 G64 P0.025
 (SAFE RETRACT G53 Z0 - STATED BY THE MACHINE)
 (OPERATION: Probe - G54)
diff --git a/crates/post/tests/mirror_trace/mod.rs b/crates/post/tests/mirror_trace/mod.rs
index 88730df431..95a9328145 100644
--- a/crates/post/tests/mirror_trace/mod.rs
+++ b/crates/post/tests/mirror_trace/mod.rs
@@ -155,6 +155,7 @@ const KNOWN_G: &[u32] = &[
     540, 550, 560, 570, 580, 590, 610, 640, // work offsets, exact stop / blending
     730, 800, 810, 820, 830, 850, 860, 890, 980, 990, // canned cycles and their return level
     900, 911, 940, // absolute positions, incremental arc centres, feed per minute
+    921, 970, // G92 offsets cleared (none are modelled), constant spindle rpm: no motion
 ];
 
 /// The centre of an R-word arc (RS-274: a positive R is the arc of 180
diff --git a/crates/ui/src/egui_app/setup_wcs_tests.rs b/crates/ui/src/egui_app/setup_wcs_tests.rs
index 3921caff46..f957fa3156 100644
--- a/crates/ui/src/egui_app/setup_wcs_tests.rs
+++ b/crates/ui/src/egui_app/setup_wcs_tests.rs
@@ -154,10 +154,13 @@ fn the_combo_lists_the_setups_post_range_by_its_names() {
 
     run(h.state_mut(), CommandKind::SelectPostNamed("Tormach PathPilot".into()));
     h.run();
-    let nine = entries(&mut h);
-    assert_eq!(nine.len(), 9, "{nine:?}");
-    assert_eq!(nine.get(6).map(String::as_str), Some("Work offset 7 (G59.1)"), "{nine:?}");
-    assert_eq!(nine.last().map(String::as_str), Some("Work offset 9 (G59.3)"), "{nine:?}");
+    // Tormach states G54-G59.3 and G54.1 P10-P500 (#4299); the combo stops
+    // at the setup command's own bound (MAX_SLOT + 1 = 255).
+    let tormach = entries(&mut h);
+    assert_eq!(tormach.len(), 255, "{tormach:?}");
+    assert_eq!(tormach.get(6).map(String::as_str), Some("Work offset 7 (G59.1)"), "{tormach:?}");
+    assert_eq!(tormach.get(8).map(String::as_str), Some("Work offset 9 (G59.3)"), "{tormach:?}");
+    assert_eq!(tormach.get(9).map(String::as_str), Some("Work offset 10 (G54.1 P10)"), "{tormach:?}");
 }
 
