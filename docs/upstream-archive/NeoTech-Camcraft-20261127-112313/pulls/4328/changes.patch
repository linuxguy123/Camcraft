+//! #3752: the 2D Pocket through the real generate path with the planner
+//! engine given (`GenerateOperation::new_on`, `operation::generate_on`;
+//! #4055: a test passes the engine, it never sets the process setting).
+//! Under "new" the path kernel plans the pocket: it generates, the
+//! verifier finds nothing that blocks the post, and it posts on a shipped
+//! machine post. Under the default engine the op is the old planner's,
+//! unchanged. The options that the first recipe does not plan are refused
+//! by name, and each other phase-1 kind is still refused under "new".
+
+use super::{EM8, PassStart, PocketStrategy, R8, fig8_world, horizontal_face, model, sel};
+use crate::motion_common::law_measure::{EntryKind as MeasuredEntry, Readings, Spec, measure};
+use camcraft_app::geo2d::{Loop, Point2, Region};
+use crate::area_support::*;
+use crate::pocket_support::{block_with_pocket, rounded_rect};
+use camcraft_app::commands::{CreateOperation, GenerateOperation, ImportModel};
+use camcraft_app::machining2d::{KERNEL_POCKET_NOTE, RestParams, RestSource};
+use camcraft_app::machining3d::Entry3D;
+use camcraft_app::operation::{HeightReference, KERNEL_KINDS, OpType, PHASE1_KINDS, check_engine, generate_on};
+use camcraft_app::pathkernel::PlannerEngine;
+use camcraft_app::pathkernel::entry::NO_SAFE_ENTRY;
+use camcraft_app::posting;
+
+/// A 60 x 40 x 20 block with a 20 x 20 pocket 10 mm deep, EM-0800-4FL.
+fn block_world() -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", block_with_pocket(30.0, 20.0, &rounded_rect(10.0, 10.0, 0.0, 1), 10.0, 20.0)));
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 60.0, dy: 40.0, dz: 20.0 }, Default::default()).expect("stock"));
+    let tool = catalog().into_iter().find(|(n, _)| *n == EM8).map(|(_, t)| t).expect("catalog tool");
+    h.execute(&world, AddTool::new(&world, EM8, tool).expect("tool"));
+    (world, h)
+}
+
+/// A Waterline pocket on the floor of the block pocket: two levels of 5 mm,
+/// the entry `entry`.
+fn block_op(world: &World, h: &mut History, name: &str, entry: Entry3D, strategy: PocketStrategy) {
+    let src = sel("part", horizontal_face(world, "part", 10.0));
+    let mut p = pocket(20.0, 10.0);
+    if let OpParams::Pocket { clearance_z, top_z, bottom_z, stepdown, stepover, strategy: s, entry: en, helix_radius, .. } = &mut p {
+        *clearance_z = Height { reference: HeightReference::TopOfStock, offset: 5.0 };
+        *top_z = Height { reference: HeightReference::TopOfStock, offset: 0.0 };
+        *bottom_z = Height { reference: HeightReference::BottomOfSelection, offset: 0.0 };
+        *stepdown = 5.0;
+        *stepover = 3.0;
+        *s = strategy;
+        *en = entry;
+        *helix_radius = 2.0;
+    }
+    h.execute(world, CreateOperation::new(world, name, EM8, src, p).expect("create"));
+}
+
+fn op_of(world: &World, name: &str) -> Operation {
+    let e = model::find_by_name(world, name).expect("op");
+    model::operation_of(world, &e).expect("operation")
+}
+
+#[test]
+fn kernel_route_pocket_generates_verifies_and_posts() {
+    let (world, mut h) = block_world();
+    block_op(&world, &mut h, "K1", Entry3D::Helix, PocketStrategy::Waterline);
+    let (path, warns) = generate_on(&world, &op_of(&world, "K1"), "K1", PlannerEngine::New).expect("the kernel plans the pocket");
+    eprintln!("kernel: {} moves, notes {:?}, warnings {warns:?}", path.moves.len(), path.notes);
+    assert!(path.notes.iter().any(|n| n == KERNEL_POCKET_NOTE), "the status line names the kernel");
+    let blocking: Vec<_> = warns.iter().filter(|w| w.blocks_post()).collect();
+    assert!(blocking.is_empty(), "the verifier blocks the kernel pocket: {blocking:?}");
+    h.execute(&world, GenerateOperation::new_on(&world, "K1", PlannerEngine::New).expect("generate on the kernel"));
+    let dir = std::env::temp_dir().join(format!("camcraft-3752-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("temp dir");
+    let cps = posting::builtin_post_text("Fanuc").expect("built-in post");
+    let posted = posting::post_script(&world, &dir.join("prog.nc"), cps).map(|p| p.program);
+    let _ = std::fs::remove_dir_all(&dir);
+    let nc = posted.expect("the kernel pocket posts");
+    assert!(nc.contains("G1") || nc.contains("G01"), "the program cuts: {nc}");
+}
+
+#[test]
+fn kernel_route_default_engine_keeps_the_old_pocket() {
+    let (world, mut h) = block_world();
+    block_op(&world, &mut h, "K1", Entry3D::Helix, PocketStrategy::Waterline);
+    let op = op_of(&world, "K1");
+    let (old, _) = generate_on(&world, &op, "K1", PlannerEngine::Old).expect("the old planner");
+    let (default, _) = generate_on(&world, &op, "K1", PlannerEngine::default()).expect("the default");
+    h.execute(&world, GenerateOperation::new(&world, "K1").expect("generate"));
+    let cached = model::toolpath_of(&world, &model::find_by_name(&world, "K1").expect("op")).expect("cached").path.clone();
+    assert!(!old.notes.iter().any(|n| n == KERNEL_POCKET_NOTE), "the default is the old planner");
+    assert_eq!(old.moves, default.moves, "the default engine is the old planner");
+    assert_eq!(old.moves, cached.moves, "the command reads the default engine");
+}
+
+#[test]
+fn kernel_route_refuses_what_the_recipe_does_not_plan() {
+    let (world, mut h) = block_world();
+    block_op(&world, &mut h, "Plunge", Entry3D::Plunge, PocketStrategy::Waterline);
+    let e = generate_on(&world, &op_of(&world, "Plunge"), "Plunge", PlannerEngine::New).expect_err("refused by name");
+    assert!(e.to_string().contains(NO_SAFE_ENTRY), "a closed pocket with no hole and no helix or ramp: {e}");
+    // A document written past the door of the command (Adaptive is refused at creation).
+    let mut op = op_of(&world, "Plunge");
+    if let OpParams::Pocket { strategy, entry, .. } = &mut op.params {
+        *strategy = PocketStrategy::Adaptive;
+        *entry = Entry3D::Helix;
+    }
+    let e = generate_on(&world, &op, "Plunge", PlannerEngine::New).expect_err("refused by name");
+    assert!(e.to_string().contains("Adaptive"), "{e}");
+    block_op(&world, &mut h, "Rest", Entry3D::Helix, PocketStrategy::Waterline);
+    let mut op = op_of(&world, "Rest");
+    if let OpParams::Pocket { rest, .. } = &mut op.params {
+        *rest = Some(RestParams {
+            source: RestSource::EnteredTool,
+            previous_tool_diameter: 12.0,
+            previous_corner_radius: 0.0,
+            previous_stock_to_leave: 0.0,
+            allowance: 0.0,
+        });
+    }
+    let e = generate_on(&world, &op, "Rest", PlannerEngine::New).expect_err("refused by name");
+    assert!(e.to_string().contains("rest machining") && e.to_string().contains("#3753"), "{e}");
+    for kind in PHASE1_KINDS.into_iter().filter(|k| !KERNEL_KINDS.contains(k)) {
+        let e = check_engine(kind, PlannerEngine::New).expect_err("still refused under new");
+        assert!(e.to_string().contains("does not plan"), "{kind}: {e}");
+    }
+    assert_eq!(check_engine(OpType::Pocket, PlannerEngine::New), Ok(()), "the 2D Pocket passes under new");
+}
+
+/// The law readings (#4154) of the fig8 pocket, Waterline with a helix,
+/// on the old planner and on the kernel: (old, new).
+fn fig8_readings(start: PassStart) -> (Readings, Readings) {
+    let (world, mut h, name, stock) = fig8_world();
+    let zmin = stock.0.z;
+    let src = sel(&name, horizontal_face(&world, &name, zmin));
+    let mut p = pocket(zmin + 20.0, zmin);
+    if let OpParams::Pocket { clearance_z, top_z, bottom_z, stepdown, stepover, strategy, pass_start, entry, helix_radius, .. } = &mut p {
+        *clearance_z = Height { reference: HeightReference::TopOfStock, offset: 10.0 };
+        *top_z = Height { reference: HeightReference::TopOfStock, offset: 0.0 };
+        *bottom_z = Height { reference: HeightReference::BottomOfSelection, offset: 1.5 };
+        *stepdown = 10.0;
+        *stepover = 3.0;
+        *strategy = PocketStrategy::Waterline;
+        *pass_start = start;
+        *entry = Entry3D::Helix;
+        *helix_radius = 2.0;
+    }
+    let area = AreaControls { containment: Some(Containment::Outside), ..Default::default() };
+    h.execute(&world, CreateOperation::new(&world, "P1", EM8, src, p.clone()).expect("create"));
+    h.execute(&world, EditOperationParams::with_area(&world, "P1", p, area).expect("area"));
+    let op = op_of(&world, "P1");
+    let (old, _) = generate_on(&world, &op, "P1", PlannerEngine::Old).expect("the old planner plans fig8");
+    let (new, warns) = generate_on(&world, &op, "P1", PlannerEngine::New).expect("the kernel plans fig8");
+    eprintln!("fig8 {start:?} kernel: {} moves, verifier {warns:?}", new.moves.len());
+    assert!(warns.iter().all(|w| !w.blocks_post()), "the verifier blocks the fig8 pocket: {warns:?}");
+    let (lo, hi) = stock;
+    let pts = vec![Point2::new(lo.x, lo.y), Point2::new(hi.x, lo.y), Point2::new(hi.x, hi.y), Point2::new(lo.x, hi.y)];
+    let st = Region::new(vec![Loop::new(pts).expect("loop")]).expect("stock");
+    let mut spec = Spec::new(R8, st, hi.z, (1.0 - 3.0 / R8).acos().to_degrees());
+    spec.asked_entry = Some(MeasuredEntry::Helix);
+    let read = |t: &Toolpath| measure(t, &spec).expect("measured");
+    let (ro, rn) = (read(&old), read(&new));
+    eprintln!("fig8 {start:?} old: {} | breaks {}", ro.row(), ro.breaks(false));
+    eprintln!("fig8 {start:?} new: {} | breaks {}", rn.row(), rn.breaks(false));
+    (ro, rn)
+}
+
+/// #3752 pin on fig8: each lift of the kernel's pocket has a named reason,
+/// and the kernel lifts less than the old planner.
+#[test]
+#[ignore = "heavy lane: app heavy: pocket_pass_start (#3752: six fig8 generations run past the 60 s debug budget)"]
+fn fig8_kernel_pocket_lifts_are_named() {
+    for start in PassStart::ALL {
+        let (old, new) = fig8_readings(start);
+        assert_eq!(new.named_lifts, new.lifts.count, "fig8 {start:?}: each lift has a named reason");
+        assert!(new.lifts.count <= old.lifts.count, "fig8 {start:?}: the kernel lifts no more than the old planner");
+    }
+}
+
+/// Light twin of `fig8_kernel_pocket_lifts_are_named`: the Auto start only.
+#[test]
+#[ignore = "light lane: the Auto start of the full test only (#3752); the full test is fig8_kernel_pocket_lifts_are_named"]
+fn fig8_kernel_pocket_lifts_are_named_light() {
+    let (old, new) = fig8_readings(PassStart::Auto);
+    assert_eq!(new.named_lifts, new.lifts.count, "fig8 Auto: each lift has a named reason");
+    assert!(new.lifts.count <= old.lifts.count, "fig8 Auto: the kernel lifts no more than the old planner");
+}
diff --git a/crates/motion/src/machining2d/kernel_level.rs b/crates/motion/src/machining2d/kernel_level.rs
new file mode 100644
index 0000000000..eb43a0aabd
--- /dev/null
+++ b/crates/motion/src/machining2d/kernel_level.rs
@@ -0,0 +1,137 @@
+//! One level of a path kernel recipe (#3752, K6 of #4023): the stages in
+//! the record's order - guide, order, load, then the cuts with a proved
+//! link between each two, an entry after each lift and before the first
+//! cut, and the exit after the last cut. The caller gives the region of
+//! the level, the recipe and the stage state of the level (its stock
+//! reader and its cleared area). The stage verdicts are kept as text for
+//! the status line: each fallback and each note of a stage. A gap of an
+//! incomplete verdict is kept too: the caller refuses the level, because
+//! only a done verdict can reach the post.
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! ("Data flow", "Common result types") and the stage order of the law kit
+//! (`crates/pathkernel/tests/laws/kit.rs`).
+
+use crate::geo2d::{Point2, Region};
+use camcraft_pathkernel::entry::{EntryPlanner, EntryStage};
+use camcraft_pathkernel::guide::{GuidePlanner, Guides};
+use camcraft_pathkernel::link::{Hop, Level, LinkProof, LinkStage, LinkTally};
+use camcraft_pathkernel::load::{LoadPlanner, LoadStage, StockRead};
+use camcraft_pathkernel::order::{OrderPlanner, OrderStage};
+use camcraft_pathkernel::plan::{Cut, Plan, Step};
+use camcraft_pathkernel::{Fallback, Gap, KernelRegion, Note, Recipe, Refusal, Stage, Verdict};
+
+/// The tolerance (mm) that the level gives to the guide stage.
+pub const GUIDE_TOL: f64 = 1e-3;
+
+/// Refusal reason: a region that is not planar.
+pub const LEVEL_NOT_PLANAR: &str = "the kernel level plans planar regions only";
+
+/// The stage state of one level: the entry and exit planner with the
+/// heights of the level, the load planner with its stated limit, the stock
+/// that stands at the depth of the level, and the area where no stock
+/// stands down to that depth.
+pub struct LevelStages<'a> {
+    pub entry: &'a EntryStage,
+    pub load: &'a LoadStage,
+    pub stock: &'a dyn StockRead,
+    pub cleared: &'a Region,
+}
+
+/// The plan of one level, the status line texts of its stage verdicts and
+/// the gaps that an incomplete verdict named.
+#[derive(Clone, Debug)]
+pub struct PlannedLevel {
+    pub plan: Plan,
+    pub tally: LinkTally,
+    pub notes: Vec<String>,
+    pub gaps: Vec<Gap>,
+}
+
+/// The status line text of a fallback: the word "instead" lets the law
+/// measures and the reader see that a behaviour was substituted (law 4).
+#[must_use]
+pub fn fallback_text(f: &Fallback) -> String {
+    format!("{}: {} instead of {} - {}", stage_name(f.stage()), f.used(), f.asked(), f.reason())
+}
+
+/// The name of a stage on the status line.
+#[must_use]
+pub fn stage_name(s: Stage) -> &'static str {
+    match s {
+        Stage::Recipe => "kernel recipe",
+        Stage::Region => "kernel region",
+        Stage::Guide => "kernel guide",
+        Stage::Order => "kernel order",
+        Stage::Load => "kernel load",
+        Stage::Link => "kernel link",
+        Stage::Entry => "kernel entry",
+        Stage::Exit => "kernel exit",
+        _ => "kernel",
+    }
+}
+
+/// The status line texts of the verdict `v` go to `notes`, its gaps to
+/// `gaps`; the output comes back. A refused verdict is the error.
+fn take<T: Clone>(v: Verdict<T>, notes: &mut Vec<String>, gaps: &mut Vec<Gap>) -> Result<T, Refusal> {
+    let push = |notes: &mut Vec<String>, n: &[Note]| {
+        for t in n.iter().map(|n| n.text().to_string()) {
+            if !notes.contains(&t) {
+                notes.push(t);
+            }
+        }
+    };
+    match v {
+        Verdict::Done { out, fallbacks, notes: n } => {
+            for t in fallbacks.iter().map(fallback_text) {
+                if !notes.contains(&t) {
+                    notes.push(t);
+                }
+            }
+            push(notes, &n);
+            Ok(out)
+        }
+        Verdict::Incomplete { out, gaps: g, notes: n } => {
+            push(notes, &n);
+            gaps.extend(g.list().iter().copied());
+            Ok(out)
+        }
+        Verdict::Refused(r) => Err(r),
+    }
+}
+
+/// The plan of one level of `recipe` in `region` with the stage state `s`.
+pub fn plan_level(region: &KernelRegion, recipe: &Recipe, s: &LevelStages<'_>) -> Result<PlannedLevel, Refusal> {
+    let tool_r = region.planar().ok_or_else(|| Refusal::new(Stage::Region, LEVEL_NOT_PLANAR))?.tool().radius();
+    let (mut notes, mut gaps) = (Vec::new(), Vec::new());
+    let gs = take(Guides.guide(region, &recipe.guide(), GUIDE_TOL)?, &mut notes, &mut gaps)?;
+    let os = take(OrderStage.order(gs, region, &recipe.order(), None)?, &mut notes, &mut gaps)?;
+    let cs = take(s.load.control(os, region, s.stock, &recipe.load(), tool_r)?, &mut notes, &mut gaps)?;
+    let cuts = cs.set().curves().iter().map(|c| Cut::new(c.clone(), None)).collect::<Result<Vec<_>, _>>()?;
+    let mut tally = LinkTally::default();
+    let mut links: Vec<Vec<Point2>> = Vec::new();
+    let mut steps = Vec::with_capacity(cuts.len().saturating_mul(2).saturating_add(2));
+    for (i, cut) in cuts.iter().enumerate() {
+        let lifted = match i.checked_sub(1).and_then(|j| cuts.get(j)) {
+            None => true,
+            Some(prev) => {
+                let level = Level::new(cuts.get(..i).unwrap_or_default(), cuts.get(i..).unwrap_or_default()).with_links(&links);
+                let hop = LinkStage.link(prev, cut, region, level, recipe.link(), &mut tally);
+                if let Hop::Stay(path) = &hop {
+                    links.push(path.points());
+                }
+                let lift = matches!(hop, Hop::Lift(_));
+                steps.push(Step::Link(hop));
+                lift
+            }
+        };
+        if lifted {
+            let e = take(s.entry.entry(cut, region, s.cleared, recipe.entry())?, &mut notes, &mut gaps)?;
+            steps.push(Step::Entry(e));
+        }
+        steps.push(Step::Cut(cut.clone()));
+    }
+    if let Some(last) = cuts.last() {
+        steps.push(Step::Exit(s.entry.exit(last, region, s.cleared)?));
+    }
+    Ok(PlannedLevel { plan: Plan::new(steps)?, tally, notes, gaps })
+}
diff --git a/crates/motion/src/machining2d/kernel_pocket.rs b/crates/motion/src/machining2d/kernel_pocket.rs
new file mode 100644
index 0000000000..da43edc16c
--- /dev/null
+++ b/crates/motion/src/machining2d/kernel_pocket.rs
@@ -0,0 +1,276 @@
+//! 2D Pocket on the path kernel (#3752, the first recipe of K6, #4023):
+//! the op's parameters become one choice for each stage, each Z level is
+//! planned by the stages with that level's heights and stock state
+//! (`kernel_level`), and the converter (`kernel_emit`) makes the plans of
+//! the levels into one toolpath. Only the planner switch calls it; with
+//! the switch at its default the old pocket planner runs, unchanged.
+//!
+//! The recipe (record "Map of the present operations"):
+//! - Waterline: rings of the boundary at the stepover, no load control
+//!   (each cut above the stated load is named).
+//! - Offset rings: rings at the load step, constant engagement on the
+//!   rings (passes inserted where a ring cuts above the load).
+//! - Zigzag: refused by name (#3753): the rows of the kernel and their
+//!   closing ring cross (the verifier reads 30 crossings on a square pocket).
+//! - Auto: Waterline or Zigzag by the outline, the rule of the old planner.
+//! - Adaptive: refused (the 2D Pocket retired it; the stock reach of the
+//!   load stage is the HSM planner's, not this recipe's).
+//!
+//! Provenance: our own design record `docs/decisions/4024-path-kernel-design.md`
+//! ("The strategy is a recipe", the map row of 2D Pocket) and
+//! `docs/decisions/3752-kernel-pocket-recipe.md`; offset pocketing as in
+//! Held (1991). No vendor material consulted.
+
+use crate::cl::Toolpath;
+use crate::entry::Entry3D;
+use crate::geo2d::{Point2, Region};
+use crate::geometry::Point3;
+use crate::kernel_emit::{EmitFeeds, EmitHeights, LevelPlan, emit_levels};
+use crate::links::Link;
+use camcraft_pathkernel::entry::{ArcChoice, EntryChoice, EntryKind, EntryStage, Heights, Hole, MaterialChoice};
+use camcraft_pathkernel::guide::{GuideChoice, RingRef, RingsChoice};
+use camcraft_pathkernel::link::LinkPolicy;
+use camcraft_pathkernel::load::{LoadControl, LoadStage, Reach, StockRead};
+use camcraft_pathkernel::order::{Direction, OrderChoice, StartSide as KernelSide};
+use camcraft_pathkernel::{AxisControl, Recipe, Refusal, ToolShape, WorkPlane};
+
+use super::arcs::ARC_FIT_TOL;
+use super::equal_steps::cut_levels_for;
+use super::face::GenError;
+use super::kernel_level::{LevelStages, PlannedLevel, plan_level};
+use super::kernel_region::{bounds_of, pocket_region};
+use super::pass_start::{PassStart, StartSide};
+use super::pocket::{PocketParams, PocketStrategy};
+use super::predrilled::PreHole;
+
+/// The status line note of each 2D Pocket that the path kernel planned.
+pub const KERNEL_POCKET_NOTE: &str = "planner: the path kernel planned this 2D Pocket (CAMCRAFT_PLANNER=new)";
+/// Refusal: the Adaptive strategy on the kernel route.
+pub const KERNEL_POCKET_ADAPTIVE: &str = "the path kernel does not plan the 2D Pocket Adaptive strategy: the 2D Pocket retired it - use the 2D Adaptive operation";
+/// Refusal: the Zigzag strategy on the kernel route (#3753 plans the rows).
+pub const KERNEL_POCKET_ZIGZAG: &str = "the new path planner does not plan the 2D Pocket Zigzag strategy yet (#3753): its rows and their closing ring cross - select Waterline or Offset rings, or unset CAMCRAFT_PLANNER";
+/// Refusal: a level that the stages planned only in part.
+pub const KERNEL_POCKET_INCOMPLETE: &str = "the path kernel planned this level only in part: an area stays uncut";
+/// Note: the corner blends are not planned by the kernel yet.
+pub const KERNEL_NO_BLEND: &str =
+    "kernel recipe: sharp corners instead of the blended turns - the path kernel does not blend corners yet";
+/// The chord tolerance (mm) of the entry stage: the arc leads and helices are chords.
+const ENTRY_CHORD_TOL: f64 = 0.01;
+/// The height (mm) above the material where a descent starts, when the op sets none.
+const DEFAULT_CLEAR: f64 = 1.0;
+
+/// The stock that stands at the depth of a level: the pocket area. A 2D
+/// pocket has vertical walls, so each level reads the same area; the cut
+/// of the level above stops at its own depth and clears nothing below it.
+struct AreaStock<'a>(&'a Region);
+
+impl StockRead for AreaStock<'_> {
+    fn material_at(&self, p: Point2) -> Option<bool> {
+        Some(self.0.contains(p))
+    }
+}
+
+fn refusal(e: &Refusal, z: f64) -> GenError {
+    let msg = format!("2D Pocket on the path kernel: {e}");
+    match e.place() {
+        Some(p) => GenError::invalid_at(msg, Point3::new(p.x, p.y, z)),
+        None => GenError::Invalid(msg),
+    }
+}
+
+/// The strategy that the pocket cuts: Auto takes the rule of the old
+/// planner (the outermost loop decides, holes and islands never do).
+#[must_use]
+pub fn resolved_strategy(region: &Region, p: &PocketParams) -> PocketStrategy {
+    match p.strategy {
+        PocketStrategy::Auto => {
+            let outer = region
+                .loops()
+                .iter()
+                .max_by(|a, b| a.area().abs().total_cmp(&b.area().abs()))
+                .map(|l| l.points())
+                .unwrap_or(&[]);
+            p.strategy.resolve(outer, p.stepover, p.tool_diameter, ARC_FIT_TOL)
+        }
+        s => s,
+    }
+}
+
+/// The guide, the load choice and the stated load limit (ae/D) of a strategy.
+fn guide_and_load(strategy: PocketStrategy, p: &PocketParams) -> Result<(GuideChoice, LoadControl, f64), GenError> {
+    let k = |e: Refusal| refusal(&e, p.top_z);
+    let per_d = |s: f64| (s / p.tool_diameter).clamp(1e-6, 1.0);
+    match strategy {
+        PocketStrategy::Waterline | PocketStrategy::Auto => {
+            let g = RingsChoice::new(RingRef::Boundary, 0.0, p.stepover, None, None).map_err(k)?;
+            Ok((GuideChoice::Rings(g), LoadControl::None, per_d(p.stepover)))
+        }
+        PocketStrategy::OffsetRings => {
+            let step = p.tiling_step();
+            let g = RingsChoice::new(RingRef::Boundary, 0.0, step, None, None).map_err(k)?;
+            let load = LoadControl::constant(p.optimal_load.clamp(1e-6, 1.0), Reach::Rings).map_err(k)?;
+            Ok((GuideChoice::Rings(g), load, per_d(step)))
+        }
+        PocketStrategy::Zigzag if p.strategy == PocketStrategy::Auto => Err(GenError::Invalid(format!("{KERNEL_POCKET_ZIGZAG} (Auto chose Zigzag for this outline)"))),
+        PocketStrategy::Zigzag => Err(GenError::Invalid(KERNEL_POCKET_ZIGZAG.into())),
+        PocketStrategy::Adaptive => Err(GenError::Invalid(KERNEL_POCKET_ADAPTIVE.into())),
+    }
+}
+
+/// The kernel's start side of a pass start (the start side reaches the
+/// curves only through the order stage, law 3).
+#[must_use]
+pub fn kernel_side(start: PassStart) -> KernelSide {
+    match start {
+        PassStart::Auto => KernelSide::Auto,
+        PassStart::Inside => KernelSide::Inside,
+        PassStart::Outside => KernelSide::Outside,
+    }
+}
+
+/// The link policy of the op: the rings stay at depth where a link is
+/// proved, and lift with a named reason elsewhere. Only a pass link to the
+/// clearance height is the user's own retract between cuts.
+#[must_use]
+pub fn link_policy(pass: Link) -> LinkPolicy {
+    match pass {
+        Link::Clearance => LinkPolicy::Retract,
+        Link::Retract | Link::KeepDown => LinkPolicy::StayWhereProved,
+    }
+}
+
+/// The descent angle (degrees) of a helix entry: the op's angle, else the
+/// angle of its pitch at the helix radius, else the old law of one turn
+/// per helix diameter of drop (atan(1 / pi), 17.7 degrees).
+fn helix_angle(p: &PocketParams) -> f64 {
+    let a = &p.links.approach;
+    let deg = if a.helix_angle > 0.0 {
+        a.helix_angle
+    } else if a.helix_pitch > 0.0 {
+        (a.helix_pitch / (std::f64::consts::TAU * p.helix_radius)).atan().to_degrees()
+    } else {
+        std::f64::consts::FRAC_1_PI.atan().to_degrees()
+    };
+    deg.clamp(0.1, 89.0)
+}
+
+/// The descent angle (degrees) of a ramp entry.
+fn ramp_angle(p: &PocketParams) -> f64 {
+    let a = &p.links.approach;
+    let deg = if a.ramp_angle > 0.0 { a.ramp_angle } else { p.links.ramp_angle };
+    if deg > 0.0 { deg.clamp(0.1, 89.0) } else { camcraft_pathkernel::entry::DEFAULT_DESCENT_ANGLE }
+}
+
+/// The entry choice of a level for the op's entry `e` and the holes open
+/// down to the depth `z`. A plunge into material is not offered: the op
+/// asks for an entry outside material (air, a hole, a cleared column),
+/// and a closed pocket without one is refused by name. A helix or a ramp
+/// that the user selected is used where the tool must enter material.
+fn entry_choice(e: Entry3D, p: &PocketParams, holes: &[PreHole], z: f64) -> Result<EntryChoice, Refusal> {
+    let r = 0.5 * p.tool_diameter;
+    let open: Vec<Hole> = holes
+        .iter()
+        .filter(|h| h.at.x.is_finite() && h.at.y.is_finite() && h.floor.is_finite() && h.floor <= z + 1e-6)
+        .map(|h| Hole::new(h.at, r))
+        .collect::<Result<_, _>>()?;
+    let (asked, material) = match e {
+        Entry3D::Helix => (EntryKind::Helix, MaterialChoice::new(helix_angle(p), Some(p.helix_radius))?),
+        Entry3D::Ramp => (EntryKind::Ramp, MaterialChoice::new(ramp_angle(p), None)?),
+        Entry3D::Arc => (EntryKind::ArcLead, MaterialChoice::default()),
+        Entry3D::Plunge => (EntryKind::Air, MaterialChoice::default()),
+    };
+    Ok(EntryChoice::new(asked, p.links.approach.approach_distance.max(0.0), open)?.with_material(material))
+}
+
+/// The plans of a 2D Pocket on the path kernel: one for each Z level with
+/// its work plane, and the status line notes of the recipe and the stages.
+#[derive(Clone, Debug)]
+pub struct KernelPocketPlan {
+    pub levels: Vec<(PlannedLevel, WorkPlane)>,
+    pub notes: Vec<String>,
+    pub strategy: PocketStrategy,
+    heights: EmitHeights,
+    feeds: EmitFeeds,
+}
+
+/// The 2D Pocket of `region` (the material to remove; its holes are
+/// islands) on the path kernel, with the pass start and the stock of `side`
+/// and the holes that the caller proved open (`holes`, read only when the
+/// op asks for pre-drilled entries).
+pub fn pocket_on_kernel(region: &Region, p: &PocketParams, holes: &[PreHole], side: &StartSide) -> Result<Toolpath, GenError> {
+    let plan = pocket_kernel_plans(region, p, holes, side)?;
+    let levels: Vec<LevelPlan<'_>> = plan.levels.iter().map(|(l, plane)| LevelPlan { plan: &l.plan, plane: *plane }).collect();
+    let mut path = emit_levels(&levels, plan.heights, plan.feeds)
+        .map_err(|e| GenError::Invalid(format!("2D Pocket on the path kernel: {e}")))?
+        .path;
+    for n in plan.notes {
+        if !path.notes.contains(&n) {
+            path.notes.push(n);
+        }
+    }
+    Ok(path)
+}
+
+/// The plans of [`pocket_on_kernel`], level by level, before the converter.
+pub fn pocket_kernel_plans(region: &Region, p: &PocketParams, holes: &[PreHole], side: &StartSide) -> Result<KernelPocketPlan, GenError> {
+    p.validate()?;
+    if region.is_empty() {
+        return Err(GenError::Empty("empty pocket region".into()));
+    }
+    let strategy = resolved_strategy(region, p);
+    let (guide, load, limit) = guide_and_load(strategy, p)?;
+    let a = &p.links.approach;
+    let top = [Some(p.top_z), a.stock_top, a.material_top].into_iter().flatten().fold(f64::NEG_INFINITY, f64::max);
+    let k = |e: Refusal| refusal(&e, top);
+    let r = 0.5 * p.tool_diameter;
+    let tool = ToolShape::disc(r, 0.0, a.center_cutting, (top - p.bottom_z).max(0.0) + r).map_err(k)?;
+    let bounds = bounds_of(side, Region::empty(), top, p.bottom_z).map_err(k)?;
+    let order = OrderChoice { start: kernel_side(side.start), direction: if p.climb { Direction::Climb } else { Direction::Conventional } };
+    let stage_load = LoadStage::new(limit).map_err(k)?;
+    let arc_r = if a.arc_radius > 0.0 { a.arc_radius } else { r };
+    let arc = ArcChoice::new(arc_r, if a.arc_sweep > 0.0 { a.arc_sweep.min(180.0) } else { 90.0 }).map_err(k)?;
+    let clear = if a.plunge_height > 0.0 { a.plunge_height } else { DEFAULT_CLEAR };
+    let retract = p.retract_z.unwrap_or(p.clearance_z).max(top);
+    let stock = AreaStock(region);
+    let cleared = Region::empty();
+    let zs = cut_levels_for(p.top_z, a, p.bottom_z, p.stepdown)?;
+    let mut planned: Vec<(PlannedLevel, WorkPlane)> = Vec::with_capacity(zs.len());
+    for (i, &z) in zs.iter().enumerate() {
+        let kz = |e: Refusal| refusal(&e, z);
+        let plane = WorkPlane::setup_xy(z).map_err(kz)?;
+        let kr = pocket_region(region, side, &bounds, plane, tool, p.stock_to_leave).map_err(kz)?;
+        let asked = if i == 0 { p.entry } else { p.links.transition.unwrap_or(p.entry) };
+        let entry = entry_choice(asked, p, holes, z).map_err(kz)?;
+        let recipe = Recipe::new(plane, AxisControl::Normal, guide, load, order, link_policy(p.links.pass), entry).map_err(kz)?;
+        let heights = Heights::new(top - z, clear, retract - z).map_err(kz)?;
+        let es = EntryStage::new(heights, arc, ENTRY_CHORD_TOL).map_err(kz)?;
+        let level = plan_level(&kr, &recipe, &LevelStages { entry: &es, load: &stage_load, stock: &stock, cleared: &cleared }).map_err(kz)?;
+        if let Some(g) = level.gaps.iter().max_by(|a, b| a.area_mm2().total_cmp(&b.area_mm2())) {
+            let msg = format!(
+                "{KERNEL_POCKET_INCOMPLETE} ({} gap(s), the largest {:.3} mm2) at Z {z:.3}",
+                level.gaps.len(),
+                g.area_mm2()
+            );
+            return Err(GenError::invalid_at(msg, Point3::new(g.at().x, g.at().y, z)));
+        }
+        planned.push((level, plane));
+    }
+    let heights = EmitHeights::new(p.clearance_z, top).map_err(|e| GenError::Invalid(e.to_string()))?;
+    let feeds = EmitFeeds::new(p.feed, p.plunge_feed).map_err(|e| GenError::Invalid(e.to_string()))?;
+    let mut notes = vec![KERNEL_POCKET_NOTE.to_owned()];
+    if p.blend_turns {
+        notes.push(KERNEL_NO_BLEND.to_owned());
+    }
+    if p.links.max_stay_down > 0.0 {
+        notes.push(format!(
+            "kernel link: a keep-down link of any proved length instead of the limit {:.3} mm - the link stage has no length limit yet",
+            p.links.max_stay_down
+        ));
+    }
+    for n in planned.iter().flat_map(|(l, _)| l.notes.iter()) {
+        if !notes.contains(n) {
+            notes.push(n.clone());
+        }
+    }
+    Ok(KernelPocketPlan { levels: planned, notes, strategy, heights, feeds })
+}
