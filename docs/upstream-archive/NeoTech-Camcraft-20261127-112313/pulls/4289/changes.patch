From a048f804732664d405e76a9893f0bf88c63debb2 Mon Sep 17 00:00:00 2001
From: JSwetz <Johnswetz1982@gmail.com>
Date: Thu, 26 Nov 2026 22:57:16 -0500
Subject: [PATCH 1/2] feat(post): Mach3 extended work offsets with G59 P

Fixes #4149
---
 assets/posts/mach3.cps                        | 22 ++++--
 crates/post/tests/mach3_post.rs               | 68 +++++++++++++++++++
 .../4149-mach3-extended-work-offsets.md       | 19 ++++++
 3 files changed, 105 insertions(+), 4 deletions(-)
 create mode 100644 docs/decisions/4149-mach3-extended-work-offsets.md

diff --git a/assets/posts/mach3.cps b/assets/posts/mach3.cps
index a8e650ad0..368faf2a8 100644
--- a/assets/posts/mach3.cps
+++ b/assets/posts/mach3.cps
@@ -19,7 +19,7 @@ setCodePage = "utf-8";
 capabilities = 1; // reference contract: integer feature mask (bit 1 = milling)
 axisInversion = true; // verified on the engine's mirrored stream for a flipped WCS X/Y and an inverted machine X/Y (#2475): trace equivalence test + golden
 workOffsetIndex = true; // reads the 1-based WorkOffset number (#1385)
-workOffsetMax = 6;      // G54..G59 (the post writes no G59 P extension)
+workOffsetMax = 255;    // G54..G59 (1-6), G59 P7..P255 (#4149)
 coolantModes = true; // reads PARAM Coolant (#112/#150)
 afterModes = true;   // reads PARAM AfterOperation (#110)
 programUnits = "mm inch"; // #902: writes the document's unit (postOptions.Units), G21 / G20
@@ -392,8 +392,22 @@ function onRadiusCompensation() {
   msg("control cutter compensation (G41/G42) is not supported by the Mach3 post - choose In computer");
 }
 
-// #1385: the engine validates the offset index before this script receives it.
-function workOffsetName(n) { return "G" + (53 + n); }
+// #1385, #4149: the engine validates the offset index before this script receives it.
+// Mach3 supports G54..G59 for offsets 1..6, and extended offsets G59 P7..P255.
+function workOffsetName(n) {
+  if (n !== Math.floor(n) || n < 1 || n > workOffsetMax) return "";
+  if (n <= 6) return "G" + (53 + n);
+  return "G59 P" + n;
+}
+
+function offsetWord(value) {
+  var n = Number(value), w = workOffsetName(n);
+  if (!w) {
+    msg("work offset " + value + " - this post expresses work offsets 1-" + workOffsetMax + " only");
+    return wcsWord;
+  }
+  return w;
+}
 
 function onParameter(name, value) {
   commentParam(name, value);
@@ -403,7 +417,7 @@ function onParameter(name, value) {
   if (name === "SetupChange") { setupNext = clean(value); return; }
   if (name === "Smoothing") { smoothTol = Number(value) || 0; return; }
   if (name === "SmoothingMode") { smoothMode = String(value || ""); return; }
-  if (name === "WorkOffset" && value) wcsWord = workOffsetName(Number(value));
+  if (name === "WorkOffset" && value) wcsWord = offsetWord(value);
   else if (name === "OriginX" && has(value)) orgX = Number(value);
   else if (name === "OriginY" && has(value)) orgY = Number(value);
   else if (name === "OriginZ" && has(value)) orgZ = Number(value);
diff --git a/crates/post/tests/mach3_post.rs b/crates/post/tests/mach3_post.rs
index 22820db98..b6c17b583 100644
--- a/crates/post/tests/mach3_post.rs
+++ b/crates/post/tests/mach3_post.rs
@@ -1,4 +1,5 @@
 //! Issue #4148: Mach3 sequence numbers and G64 path mode.
+//! Issue #4149: Mach3 extended work offsets with G59 P.
 //!
 //! Provenance: public Mach3 G-code and programming manual (machsupport.com);
 //! no vendor materials consulted. Original clean-room tests.
@@ -93,3 +94,70 @@ fn mach3_sequence_numbers_cap_and_refuse_over_99999() {
         out_over.program
     );
 }
+
+#[test]
+fn mach3_work_offsets_g54_through_g59_and_extended_g59_p() {
+    let cps = mach3_post();
+    let mch = default_vmc();
+
+    // 1-6 post as G54-G59
+    let expected_standard = [
+        (1, "G54"),
+        (2, "G55"),
+        (3, "G56"),
+        (4, "G57"),
+        (5, "G58"),
+        (6, "G59"),
+    ];
+    for (offset, word) in expected_standard {
+        let stream = format!(
+            "PARAM SetupName Fixture\nPARAM OperationName Op1\nPARAM OperationKind Contour\n{}",
+            SIMPLE_STREAM.replace("PARAM WorkOffset 1", &format!("PARAM WorkOffset {offset}"))
+        );
+        let out = engine::run(&cps, &mch, &stream).expect("mach3 runs");
+        assert!(out.warnings.is_empty(), "offset {offset} warnings: {:?}", out.warnings);
+        assert!(
+            out.program.contains(&format!("G17 G90 {word} G40 G80")),
+            "offset {offset} must emit {word} in preamble:\n{}",
+            out.program
+        );
+        assert!(
+            out.program.contains(&format!("(OPERATION: Op1 - CONTOUR - {word})")),
+            "offset {offset} must name {word} in operation note:\n{}",
+            out.program
+        );
+    }
+
+    // Extended offsets: 7 posts as G59 P7, 255 posts as G59 P255
+    for offset in [7, 8, 54, 100, 254, 255] {
+        let stream = format!(
+            "PARAM SetupName Fixture\nPARAM OperationName Op1\nPARAM OperationKind Contour\n{}",
+            SIMPLE_STREAM.replace("PARAM WorkOffset 1", &format!("PARAM WorkOffset {offset}"))
+        );
+        let out = engine::run(&cps, &mch, &stream).expect("mach3 runs");
+        assert!(out.warnings.is_empty(), "offset {offset} warnings: {:?}", out.warnings);
+        let expected_word = format!("G59 P{offset}");
+        assert!(
+            out.program.contains(&format!("G17 G90 {expected_word} G40 G80")),
+            "offset {offset} must emit {expected_word} in preamble:\n{}",
+            out.program
+        );
+        assert!(
+            out.program.contains(&format!("(OPERATION: Op1 - CONTOUR - {expected_word})")),
+            "offset {offset} must name {expected_word} in operation note:\n{}",
+            out.program
+        );
+    }
+
+    // Offsets above 255 are refused
+    let stream_over = SIMPLE_STREAM.replace("PARAM WorkOffset 1", "PARAM WorkOffset 256");
+    let out_over = engine::run(&cps, &mch, &stream_over).expect("mach3 runs");
+    assert!(
+        out_over
+            .warnings
+            .iter()
+            .any(|w| w.contains("work offset 256") || w.contains("uses work offset 256")),
+        "must refuse offset > 255: {:?}",
+        out_over.warnings
+    );
+}
diff --git a/docs/decisions/4149-mach3-extended-work-offsets.md b/docs/decisions/4149-mach3-extended-work-offsets.md
new file mode 100644
index 000000000..e0cbe3ea7
--- /dev/null
+++ b/docs/decisions/4149-mach3-extended-work-offsets.md
@@ -0,0 +1,19 @@
+## #4149 - Mach3 post: extended work offsets with G59 P
+
+**Decision:** Increase `workOffsetMax` to 255 in `assets/posts/mach3.cps`.
+Format work offset numbers 1 to 6 as standard G-code words `G54` to `G59`.
+Format work offset numbers 7 to 255 as extended G-code words `G59 P7` to `G59 P255`.
+Refuse work offset numbers less than 1 or greater than 255 with an explicit error.
+Update operation comment notes to display `G59 P<n>` for extended offsets.
+
+**Why:** Mach3 supports 254 work coordinate systems. Offsets 1 to 6 map to `G54` through `G59`.
+Offsets 7 and above use the `G59 P<n>` syntax up to `P255`.
+The post previously stopped at `workOffsetMax = 6`. This prevented users from using extended fixtures.
+
+**Considered and dropped:**
+- Do not emit `G54.1 P<n>`. Fanuc controls use `G54.1 P<n>`, but standard Mach3 expects `G59 P<n>`.
+- Do not wrap around or clamp offset numbers greater than 255. Refusing invalid values prevents machining collisions.
+- Do not change engine behavior. `camcraft_post` already supports `MAX_BOUND = 255`.
+
+**Cost to change later:** Minimal. `mach3.cps` isolates the formatting logic in helper functions.
+Updating the syntax or range requires only local changes in `mach3.cps` and its unit tests.

