+        let h = 1.0_f64.hypot(cot);
+        let s_tan = if c > 0.0 { c * (1.0 + cot / h) } else { 0.0 };
+        let r_tan = if c > 0.0 { r - c + c / h } else { r };
+        Self { r, c, cot, h, s_tan, r_tan }
+    }
