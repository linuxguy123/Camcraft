+        if self.c <= 0.0 {
+            return (self.r - s * self.cot).max(0.0);
+        }
+        if s <= self.s_tan {
+            let e = s - self.c;
+            (self.r - self.c + (self.c * self.c - e * e).max(0.0).sqrt()).max(0.0)
+        } else {
+            self.flank_rho(s).max(0.0)
+        }
+    }
