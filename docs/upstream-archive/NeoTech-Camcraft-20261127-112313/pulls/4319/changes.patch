+// The map callback and deterministic tests share this completion path.
+fn complete(
+    tx: &Sender<ShotDone>,
+    in_flight: &Arc<AtomicBool>,
+    tokens: Vec<UserData>,
+    image: Option<Arc<ColorImage>>,
