diff --git a/crates/app/src/sim_machine_view.rs b/crates/app/src/sim_machine_view.rs
new file mode 100644
index 0000000000..731f82c215
--- /dev/null
+++ b/crates/app/src/sim_machine_view.rs
@@ -0,0 +1,126 @@
+//! The machine-frame view of the sim playback (#4266): what a
+//! work-turning rotary's indexed pose draws. A rotary that turns the
+//! WORK (`turns_part`, the machine editor's flag) swings the part, the
+//! stock and the steel about the stated rotary axis line while the
+//! tool stays upright - the kinematics the gate judges the posed steel
+//! with, so the picture trains the same eye the verdict answers to.
+//!
+//! The turn that stands a pose upright about the line is the gate's
+//! own reading (`verify::posed_steel::upright_turn`, `turn_about`):
+//! mirrored here, not imported, because those helpers are private to
+//! the verify module and the display must not reach into it. Same
+//! Rodrigues turn, same convention: the signed turn about the line
+//! carrying the pose onto machine +Z is unique for a pose in the
+//! plane normal to a level line, whatever the controller's sign.
+//!
+//! A tool-turning rotary (a head) has no gauge-line pivot stated in
+//! the machine file, so the playback keeps today's tip-relative draw
+//! for it - the fallback, noted in #4266's PR rather than guessed.
+//!
+//! Display only: nothing here writes the world or feeds a verdict.
+//! A degenerate line, a non-finite number or a pose that cannot stand
+//! upright (a leaning line, a pose out of the turn's plane) reads as
+//! `None`: the fallback draw, never a wrong picture.
+//!
+//! Provenance: our own reading of machine-tool kinematics (a table
+//! rotary turns the work about its centreline; the programmed pose
+//! rides the rotating frame) and our own gate math; no vendor
+//! material consulted.
+
+use crate::sim::WorkTurn;
+
+/// A pose out of the turn's plane, or a direction this level off the
+/// horizontal: the rotary alone cannot stand it upright - the same
+/// tolerance the gate reads the plane with.
+const PLANE_TOL: f64 = 1e-6;
+
+/// The unit direction of `dir`, or `None` when it is no direction.
+fn unit(dir: [f64; 3]) -> Option<[f64; 3]> {
+    let l = (dir[0] * dir[0] + dir[1] * dir[1] + dir[2] * dir[2]).sqrt();
+    (l.is_finite() && l > 1e-12).then_some([dir[0] / l, dir[1] / l, dir[2] / l])
+}
+
+/// The signed turn about the line's direction carrying the unit pose
+/// `axis` onto machine +Z (`None` when the line leans, is degenerate,
+/// or the pose will not stand upright under it: a pose with a part
+/// along the line, or a non-horizontal line). The turn any controller
+/// makes - unique for a pose lying in the plane normal to a level
+/// line, the gate's own reading.
+#[must_use]
+pub fn upright_turn(dir: [f64; 3], axis: [f64; 3]) -> Option<f64> {
+    let d = unit(dir)?;
+    let a = unit(axis)?;
+    let dot_ad = a[0] * d[0] + a[1] * d[1] + a[2] * d[2];
+    if d[2].abs() > PLANE_TOL || dot_ad.abs() > PLANE_TOL {
+        return None;
+    }
+    // dot(d, cross(a, z)) and dot(a, z) for z the machine vertical:
+    // the sine and the cosine of the turn about d standing a onto z.
+    let t = (d[0] * a[1] - d[1] * a[0]).atan2(a[2]);
+    t.is_finite().then_some(t)
+}
+
+/// `p` turned by `t` about the line `origin + s*dir` (Rodrigues'
+/// formula), world frame.
+#[must_use]
+pub fn turn_point(origin: [f64; 3], dir: [f64; 3], p: [f64; 3], t: f64) -> [f64; 3] {
+    let Some(d) = unit(dir) else { return p };
+    let w = [p[0] - origin[0], p[1] - origin[1], p[2] - origin[2]];
+    let (s, c) = t.sin_cos();
+    let k = [d[1] * w[2] - d[2] * w[1], d[2] * w[0] - d[0] * w[2], d[0] * w[1] - d[1] * w[0]];
+    let e = (d[0] * w[0] + d[1] * w[1] + d[2] * w[2]) * (1.0 - c);
+    [
+        origin[0] + w[0] * c + k[0] * s + d[0] * e,
+        origin[1] + w[1] * c + k[1] * s + d[1] * e,
+        origin[2] + w[2] * c + k[2] * s + d[2] * e,
+    ]
+}
+
+/// The playhead's work turn: the angle about `work`'s line that stands
+/// the frame's tool axis upright, or `None` (the fallback draw) when
+/// there is no line or the axis will not stand upright under it.
+#[must_use]
+pub fn frame_turn(work: &WorkTurn, axis: [f64; 3]) -> Option<f64> {
+    upright_turn(work.dir, axis)
+}
+
+/// The tool as the playhead draws it under a work turn: the tip
+/// carried rigidly about the line and the axis stood upright - the
+/// machine turns the work, the spindle stays vertical. `None` (draw
+/// `tip`/`axis` as given, today's picture) when the pose will not
+/// stand upright: the fallback, never a guess.
+#[must_use]
+pub fn posed_tool(tip: [f64; 3], axis: [f64; 3], work: &WorkTurn) -> Option<([f64; 3], [f64; 3])> {
+    let t = frame_turn(work, axis)?;
+    Some((turn_point(work.origin, work.dir, tip, t), [0.0, 0.0, 1.0]))
+}
+
+/// The work-side vertices (`[x, y, z]`, display space) turned by `t`
+/// about the line, in place - the part, the stock and the steel ride
+/// the rotary table. A degenerate direction leaves them as they are.
+pub fn turn_verts(verts: &mut [[f32; 3]], origin: [f64; 3], dir: [f64; 3], t: f64) {
+    let Some(d) = unit(dir) else { return };
+    let (s, c) = t.sin_cos();
+    let k = |w: [f32; 3]| -> [f32; 3] {
+        let w = [w[0] as f64, w[1] as f64, w[2] as f64];
+        [
+            (d[1] * w[2] - d[2] * w[1]) as f32,
+            (d[2] * w[0] - d[0] * w[2]) as f32,
+            (d[0] * w[1] - d[1] * w[0]) as f32,
+        ]
+    };
+    let e = |w: [f32; 3]| -> f32 {
+        let w = [w[0] as f64, w[1] as f64, w[2] as f64];
+        ((d[0] * w[0] + d[1] * w[1] + d[2] * w[2]) * (1.0 - c)) as f32
+    };
+    let o = [origin[0] as f32, origin[1] as f32, origin[2] as f32];
+    for v in verts.iter_mut() {
+        let w = [v[0] - o[0], v[1] - o[1], v[2] - o[2]];
+        let kv = k(w);
+        *v = [o[0] + w[0] * c as f32 + kv[0] * s as f32 + d[0] as f32 * e(w), o[1] + w[1] * c as f32 + kv[1] * s as f32 + d[1] as f32 * e(w), o[2] + w[2] * c as f32 + kv[2] * s as f32 + d[2] as f32 * e(w)];
+    }
+}
+
+#[cfg(test)]
+#[path = "sim_machine_view_tests.rs"]
+mod tests;
diff --git a/crates/app/src/sim_machine_view_tests.rs b/crates/app/src/sim_machine_view_tests.rs
new file mode 100644
index 0000000000..be1723fc6f
--- /dev/null
+++ b/crates/app/src/sim_machine_view_tests.rs
@@ -0,0 +1,101 @@
+//! The pose-composition proofs for the machine-frame view (#4266):
+//! the work turns about the line and the tool stands upright; the
+//! fallback (no line, or a pose that will not stand upright) draws
+//! exactly what the playback drew before. Provenance: our own gate
+//! math mirrored (`verify::posed_steel`); no vendor material consulted.
+
+use super::{frame_turn, posed_tool, turn_point, turn_verts, upright_turn};
+
+use crate::sim::WorkTurn;
+
+/// An A rotary about +X through the WCS origin, the reporter's mill-turn.
+fn line() -> WorkTurn {
+    WorkTurn { origin: [0.0, 0.0, 0.0], dir: [1.0, 0.0, 0.0] }
+}
+
+/// A pose pointing along -Y: the tipped state the issue reports.
+fn tipped() -> [f64; 3] {
+    [0.0, -1.0, 0.0]
+}
+
+#[test]
+fn upright_turn_stands_a_tipped_pose_vertical() {
+    let t = upright_turn(line().dir, tipped()).expect("a level line and a pose in its plane stand upright");
+    // The gate's own sign: -Y stands upright under the minus quarter
+    // turn about +X (`posed_steel::upright_turn` reads the same).
+    assert!((t + std::f64::consts::FRAC_PI_2).abs() < 1e-12, "{t}");
+    // And the turn does stand the pose onto machine +Z.
+    let stood = turn_point([0.0; 3], line().dir, tipped(), t);
+    assert!(stood[0].abs() < 1e-12 && stood[1].abs() < 1e-12 && (stood[2] - 1.0).abs() < 1e-12, "{stood:?}");
+}
+
+#[test]
+fn upright_turn_refuses_what_the_rotary_cannot_stand() {
+    // A vertical (C) line never tilts a pose.
+    assert_eq!(upright_turn([0.0, 0.0, 1.0], tipped()), None);
+    // A pose already along the line.
+    assert_eq!(upright_turn(line().dir, [1.0, 0.0, 0.0]), None);
+    // A degenerate direction.
+    assert_eq!(upright_turn([0.0, 0.0, 0.0], tipped()), None);
+    // A vertical pose is home: zero turn.
+    let t = upright_turn(line().dir, [0.0, 0.0, 1.0]).expect("vertical stands upright");
+    assert!(t.abs() < 1e-12, "{t}");
+}
+
+#[test]
+fn the_work_turn_rotates_points_about_the_line() {
+    let t = std::f64::consts::FRAC_PI_2;
+    // A point on the line does not move.
+    let p = turn_point(line().origin, line().dir, [3.0, 0.0, 0.0], t);
+    assert!((p[0] - 3.0).abs() < 1e-12 && p[1].abs() < 1e-12 && p[2].abs() < 1e-12, "{p:?}");
+    // +Y goes to +Z under the quarter turn about +X; the radius holds.
+    let p = turn_point(line().origin, line().dir, [0.0, 5.0, 0.0], t);
+    assert!(p[0].abs() < 1e-12 && p[1].abs() < 1e-12 && (p[2] - 5.0).abs() < 1e-12, "{p:?}");
+    // An off-origin line carries the point rigidly with it.
+    let moved = WorkTurn { origin: [0.0, 0.0, 10.0], dir: [1.0, 0.0, 0.0] };
+    let p = turn_point(moved.origin, moved.dir, [0.0, 5.0, 10.0], t);
+    assert!(p[0].abs() < 1e-12 && p[1].abs() < 1e-12 && (p[2] - 15.0).abs() < 1e-12, "{p:?}");
+}
+
+#[test]
+fn the_tool_stands_upright_at_its_carried_station() {
+    // The issue's picture: a tool tipped to -Y at a tip on the work.
+    let tip = [0.0, 5.0, 0.0];
+    let (tip2, axis2) = posed_tool(tip, tipped(), &line()).expect("the tipped pose stands upright");
+    assert_eq!(axis2, [0.0, 0.0, 1.0], "the spindle is vertical - the work turned, not the head");
+    let t = upright_turn(line().dir, tipped()).unwrap();
+    let want = turn_point(line().origin, line().dir, tip, t);
+    assert!((tip2[0] - want[0]).abs() < 1e-12 && (tip2[1] - want[1]).abs() < 1e-12 && (tip2[2] - want[2]).abs() < 1e-12);
+    // The tip rides rigidly with the work: turning the tip's own pose
+    // by the same turn about the same line is where the tool stands.
+    assert!((tip2[0] - 0.0).abs() < 1e-12 && (tip2[1] - 0.0).abs() < 1e-12 && (tip2[2] + 5.0).abs() < 1e-12);
+}
+
+#[test]
+fn the_fallback_draws_what_the_playback_drew_before() {
+    let tip = [1.0, 2.0, 3.0];
+    // No line, or a pose the rotary cannot stand: unchanged.
+    assert_eq!(frame_turn(&WorkTurn { origin: [0.0; 3], dir: [0.0, 0.0, 1.0] }, tipped()), None);
+    assert_eq!(posed_tool(tip, tipped(), &WorkTurn { origin: [0.0; 3], dir: [0.0, 0.0, 1.0] }), None);
+    assert_eq!(posed_tool(tip, tipped(), &WorkTurn { origin: [0.0; 3], dir: [0.0; 3] }), None);
+}
+
+#[test]
+fn work_vertices_turn_about_the_line_in_place() {
+    let mut verts: Vec<[f32; 3]> = vec![[0.0, 5.0, 0.0], [3.0, 0.0, 0.0]];
+    turn_verts(&mut verts, [0.0; 3], [1.0, 0.0, 0.0], std::f64::consts::FRAC_PI_2);
+    let (a, b) = (verts[0], verts[1]);
+    assert!(a[0].abs() < 1e-4 && a[1].abs() < 1e-4 && (a[2] - 5.0).abs() < 1e-4, "{a:?}");
+    assert!((b[0] - 3.0).abs() < 1e-4 && b[1].abs() < 1e-4 && b[2].abs() < 1e-4, "{b:?}");
+    // A degenerate direction turns nothing (the fallback draw).
+    let mut same: Vec<[f32; 3]> = vec![[1.0, 2.0, 3.0]];
+    turn_verts(&mut same, [0.0; 3], [0.0; 3], 1.0);
+    assert_eq!(same[0], [1.0, 2.0, 3.0]);
+}
+
+#[test]
+fn frame_turn_reads_the_playhead_angle_off_the_frame_axis() {
+    let w = line();
+    assert!((frame_turn(&w, tipped()).unwrap() + std::f64::consts::FRAC_PI_2).abs() < 1e-12);
+    assert!(frame_turn(&w, [0.0, 0.0, 1.0]).unwrap().abs() < 1e-12);
+}
