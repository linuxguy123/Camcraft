@@ -203,6 +223,7 @@ impl ViewPrefs {
                 skip_tool_holders,
                 ai_offline_only,
                 cadmpeg_path,
+                language,
                 check_for_updates,
                 last_update_check_utc,
             },
@@ -211,6 +232,18 @@ impl ViewPrefs {
     }
 }
 
+/// A loose BCP 47 shape check (`zh-CN`, `en`, `zh_Hans`): the surface decides
