+fn valid_language_tag(tag: &str) -> bool {
+    let t = tag.trim();
+    !t.is_empty()
+        && t.len() <= 35
+        && t.split(['-', '_']).all(|part| {
+            !part.is_empty() && part.chars().all(|c| c.is_ascii_alphanumeric())
+        })
+}
