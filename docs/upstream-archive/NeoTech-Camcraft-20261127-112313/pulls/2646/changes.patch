+fn tapping_modes_and_rigid_tapping_guard() {
+    let rh = engine::run(&cps(), &vm10i(), &cycle_stream(CycleKind::Tap, 0.0, 0.0, 1, false)).expect("RH rigid tap");
+    assert!(rh.warnings.is_empty(), "{:?}", rh.warnings);
