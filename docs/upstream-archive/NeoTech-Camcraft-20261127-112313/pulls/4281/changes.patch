From 7ad46d9a24ecd6d623158f91e90d1fce00cedcf9 Mon Sep 17 00:00:00 2001
From: tbrasselle <tbrasselle@gmail.com>
Date: Thu, 26 Nov 2026 21:46:09 -0500
Subject: [PATCH] test(motion): pin the dead-end ramp fallback notes in their
 current form

The two review notes of d41c2b76a on PR #3577, adapted to the #3748 and
#3884 wording on main:

- the start-side fallback note counts once in pass_start_fallbacks, so
  the op names the cause FallbackCause::PassStart, never "Adaptive fell
  back" (the_fallback_note_counts_once_as_the_pass_start_cause);
- the band path with the user's Helix entry names the entry exactly one
  time - the advice note once, no helix stand-in beside it
  (the_replaced_helix_entry_is_named_once_on_the_band_path).

Refs #3734
---
 crates/motion/src/machining2d/pass_start.rs  | 12 ++++++++++++
 crates/motion/tests/pass_start_engagement.rs | 18 ++++++++++++++++--
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/crates/motion/src/machining2d/pass_start.rs b/crates/motion/src/machining2d/pass_start.rs
index 5c3dd2169..75f7a10d5 100644
--- a/crates/motion/src/machining2d/pass_start.rs
+++ b/crates/motion/src/machining2d/pass_start.rs
@@ -231,6 +231,18 @@ mod tests {
         assert_eq!(rings_fallbacks(std::slice::from_ref(&core)), 0, "{core}");
     }
 
+    /// #3734 pin (the first review note of d41c2b76a on PR #3577): the
+    /// start-side fallback note counts one time in `pass_start_fallbacks`,
+    /// so the op names the cause `FallbackCause::PassStart`, never
+    /// "Adaptive fell back" - and it counts once, not once per counter or
+    /// per prefix a caller adds.
+    #[test]
+    fn the_fallback_note_counts_once_as_the_pass_start_cause() {
+        let note = StartSide::from(PassStart::Outside).fallback_note(1.0);
+        assert_eq!(pass_start_fallbacks(std::slice::from_ref(&note)), 1, "{note}");
+        assert_eq!(pass_start_fallbacks(&[note.clone(), note]), 2, "two notes count two");
+    }
+
     #[test]
     fn auto_says_nothing_and_each_wall_case_is_named() {
         assert_eq!(PassStart::default(), PassStart::Auto);
diff --git a/crates/motion/tests/pass_start_engagement.rs b/crates/motion/tests/pass_start_engagement.rs
index 8aee1dad3..1e7edc876 100644
--- a/crates/motion/tests/pass_start_engagement.rs
+++ b/crates/motion/tests/pass_start_engagement.rs
@@ -235,8 +235,7 @@ fn start_side_pass_has_no_automatic_ramp() {
 /// #3748 pin 1: a selected Helix, Ramp or Plunge on Outside is used as
 /// selected, and the path names it exactly once, with the recommended Arc.
 #[test]
-fn a_selected_entry_is_kept_and_named_once() {
-    for kind in [Entry3D::Helix, Entry3D::Ramp, Entry3D::Plunge] {
+fn a_selected_entry_is_kept_and_named_once() {    for kind in [Entry3D::Helix, Entry3D::Ramp, Entry3D::Plunge] {
         let (path, _, p) = start_side_path(PassStart::Outside, kind);
         let Some(advice) = entry_advice(PassStart::Outside, kind) else { panic!("{kind:?}: no advice") };
         let named = path.notes.iter().filter(|n| n.contains(advice)).count();
@@ -355,3 +354,18 @@ fn outside_pocket_selected_entry_keeps_one_warning() {
         assert_eq!(named_warnings(&path, entry), 1, "{entry:?}: {:?}", path.notes);
     }
 }
+
+/// #3734 pin (the second review note of d41c2b76a on PR #3577, on the
+/// #3748/#3884 wording): the band path with the user's Helix entry names
+/// the entry exactly one time - the advice note once, and no stand-in
+/// note ("helix entry instead") beside it. A replacement of the selected
+/// entry would be named, and here there is none to name.
+#[test]
+fn the_replaced_helix_entry_is_named_once_on_the_band_path() {
+    let (path, _, _) = start_side_path(PassStart::Outside, Entry3D::Helix);
+    let advice = entry_advice(PassStart::Outside, Entry3D::Helix).expect("the Helix advice");
+    let named = path.notes.iter().filter(|n| n.contains(advice)).count();
+    assert_eq!(named, 1, "the entry is named {named} time(s): {:?}", path.notes);
+    let stand_ins = path.notes.iter().filter(|n| n.contains(" - helix entry instead")).count();
+    assert_eq!(stand_ins, 0, "a helix stand-in is named: {:?}", path.notes);
+}
