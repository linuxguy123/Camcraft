+}
+function onLinear() {
+  startPreamble();
+  seeZ(properties.Z); seeZ(properties.StartZ);
+  if (!tiltOk(properties)) return;
+  if (spindleStopped("feed move G1")) return;
+  if (!startXY(properties)) return;  // #1682: refused - the move is not written
