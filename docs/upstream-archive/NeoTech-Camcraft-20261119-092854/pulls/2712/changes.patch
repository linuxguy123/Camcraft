     let mut v = vec![mv.from, mv.to];
-    // XZ / YZ (M11.2 A): the same four quarters, in the arc's plane.
-    if let Some(arc) = mv.arc.filter(|a| !a.plane.is_xy()) {
-        let pl = arc.plane;
-        let (cu, cv) = pl.center_uv(arc.center);
