diff --git a/crates/motion/tests/contour_tab_necks.rs b/crates/motion/tests/contour_tab_necks.rs
new file mode 100644
index 000000000..9013b6899
--- /dev/null
+++ b/crates/motion/tests/contour_tab_necks.rs
@@ -0,0 +1,162 @@
+//! 2D Contour tabs against every cut of their level (#2561): the neck of each
+//! tab, read from the material that the posted moves leave (shape mask), for
+//! a tab beside a U-turn of its own ring and a tab beside a second ring.
+//!
+//! Gate map (M4.4): covers camcraft_motion::machining2d (contour, tab_bridge, tab_clear).
+
+mod common;
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::links::Links;
+use camcraft_motion::machining2d::{ContourParams, Lead, Side, contour};
+use common::tab_neck::{Neck, tab_necks};
+
+const D: f64 = 6.0;
+const W: f64 = 4.0;
+const BOTTOM: f64 = -4.0;
+const TAB_H: f64 = 1.0;
+const CELL: f64 = 0.1;
+
+fn lp(pts: &[(f64, f64)]) -> Loop {
+    Loop::new(pts.iter().map(|&(x, y)| Point2::new(x, y)).collect()).unwrap()
+}
+
+fn params(count: u32) -> ContourParams {
+    ContourParams {
+        tool_diameter: D,
+        stock_to_leave: 0.0,
+        clearance_z: 5.0,
+        retract_z: 2.0,
+        top_z: 0.0,
+        bottom_z: BOTTOM,
+        stepdown: 2.0,
+        feed: 500.0,
+        plunge_feed: 100.0,
+        climb: true,
+        side: Side::Outside,
+        lead: Lead::None,
+        tolerance: 0.01,
+        tab_count: count,
+        tab_width: W,
+        tab_height: TAB_H,
+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+        blend_turns: false,
+        links: Links::PLANAR,
+    }
+}
+
+fn necks(part: &Region, t: &Toolpath) -> Vec<Neck> {
+    tab_necks(part, t, D, BOTTOM + TAB_H, CELL).unwrap()
+}
+
+/// A 60 x 40 part with a notch `g` wide and 25 deep in its top edge.
+fn notched(g: f64) -> Region {
+    let (a, b) = (30.0 - g * 0.5, 30.0 + g * 0.5);
+    Region::new(vec![lp(&[(0.0, 0.0), (60.0, 0.0), (60.0, 40.0), (b, 40.0), (b, 15.0), (a, 15.0), (a, 40.0), (0.0, 40.0)])]).unwrap()
+}
+
+/// Two parts `g` apart: 30 x 30, and 30 x 50 beside it.
+fn pair(g: f64) -> Region {
+    Region::new(vec![
+        lp(&[(0.0, 0.0), (30.0, 0.0), (30.0, 30.0), (0.0, 30.0)]),
+        lp(&[(30.0 + g, 0.0), (60.0 + g, 0.0), (60.0 + g, 50.0), (30.0 + g, 50.0)]),
+    ])
+    .unwrap()
+}
+
+/// The meter reads the tab width to about one cell.
+const TOL: f64 = 0.25;
+
+/// A loop is held: the note names the cut that reaches its tab.
+fn held(t: &Toolpath) -> usize {
+    t.notes.iter().filter(|s| s.starts_with("tabs:") && s.contains("cuts into it") && s.contains("cut nothing on this loop")).count()
+}
+
+/// The number of tabs, each with a neck of the tab width or more.
+fn all_hold(part: &Region, t: &Toolpath, what: &str) -> usize {
+    let n = necks(part, t);
+    for k in &n {
+        assert!(k.width >= W - TOL, "{what}: the tab at ({:.2}, {:.2}) has a neck of {:.3} mm, under the tab width {W}: {:?}", k.at.x, k.at.y, k.width, t.notes);
+    }
+    n.len()
+}
+
+/// Nothing is cut under the tab top.
+fn cuts_nothing_at_the_tabs(t: &Toolpath) -> bool {
+    t.moves.iter().all(|m| m.kind == MoveKind::Rapid || m.from.z.min(m.to.z) >= BOTTOM + TAB_H - 1e-9)
+}
+
+#[test]
+fn the_meter_reads_the_tab_width_on_a_plain_part() {
+    let part = Region::new(vec![lp(&[(0.0, 0.0), (40.0, 0.0), (40.0, 40.0), (0.0, 40.0)])]).unwrap();
+    let t = contour(&part, &params(4)).unwrap();
+    assert_eq!(all_hold(&part, &t, "plain"), 4);
+    assert!(necks(&part, &t).iter().all(|k| k.width <= W + TOL), "the tabs are not wider than asked");
+    assert!(t.notes.iter().all(|s| !s.starts_with("tabs:")), "{:?}", t.notes);
+}
+
+/// The notched part with two tabs, the second one on the notch wall.
+fn notch_path(g: f64) -> (Region, Toolpath) {
+    let part = notched(g);
+    let mut p = params(2);
+    p.links.approach.start_point = Some(Point2::new(30.0 - g * 0.5 - D * 0.5, 30.0));
+    let t = contour(&part, &p).unwrap();
+    (part, t)
+}
+
+#[test]
+fn a_tab_that_a_u_turn_of_its_ring_cuts_into_holds_the_loop() {
+    // A 10 mm notch and a 6 mm cutter: the ring goes down the notch and
+    // comes back 4 mm beside itself. The return run cut the tab on the
+    // notch wall off its stock (a neck of 0), with no note.
+    let (part, t) = notch_path(10.0);
+    assert_eq!(held(&t), 1, "{:?} necks {:?}", t.notes, necks(&part, &t));
+    assert!(t.notes.iter().any(|s| s.contains("passes 4.000 mm from the tab")), "{:?}", t.notes);
+    assert!(cuts_nothing_at_the_tabs(&t), "a held loop cuts nothing under the tab top");
+}
+
+#[test]
+fn a_tab_beside_a_narrow_strip_is_named() {
+    // A 14 mm notch: the two runs are 8 mm apart, so 2 mm of stock stands
+    // between the kerfs. The tab keeps its width; the strip beside it is
+    // narrower, and a note says so.
+    let (part, t) = notch_path(14.0);
+    assert_eq!(held(&t), 0, "{:?}", t.notes);
+    assert!(t.notes.iter().any(|s| s.starts_with("tabs:") && s.contains("leaves only 2.000 mm of material beside it")), "{:?}", t.notes);
+    let n = necks(&part, &t);
+    assert_eq!(n.len(), 2, "{n:?}");
+    let narrow = n.iter().map(|k| k.width).fold(f64::INFINITY, f64::min);
+    assert!((narrow - 2.0).abs() <= TOL, "the strip is the neck: {n:?}");
+}
+
+#[test]
+fn a_tab_with_room_beside_it_has_no_note() {
+    // A 20 mm notch: 8 mm of stock between the kerfs, the tab width twice.
+    let (part, t) = notch_path(20.0);
+    assert_eq!(all_hold(&part, &t, "wide notch"), 2);
+    assert!(t.notes.iter().all(|s| !s.starts_with("tabs:")), "{:?}", t.notes);
+    let both = pair(20.0);
+    let t = contour(&both, &params(4)).unwrap();
+    assert_eq!(all_hold(&both, &t, "wide pair"), 8);
+    assert!(t.notes.iter().all(|s| !s.starts_with("tabs:")), "{:?}", t.notes);
+}
+
+#[test]
+fn a_tab_that_a_second_ring_cuts_into_holds_the_loop() {
+    // Two parts 10 mm apart: each ring passes 4 mm from a tab of the other
+    // one and cut it off (a neck of 0), with no note. Both loops are held.
+    let both = pair(10.0);
+    let t = contour(&both, &params(4)).unwrap();
+    assert_eq!(held(&t), 2, "{:?} necks {:?}", t.notes, necks(&both, &t));
+    assert!(cuts_nothing_at_the_tabs(&t), "held loops cut nothing under the tab top");
+    // 14 mm apart: 2 mm of stock between the kerfs, named for each loop.
+    let both = pair(14.0);
+    let t = contour(&both, &params(4)).unwrap();
+    assert_eq!(held(&t), 0, "{:?}", t.notes);
+    let named = t.notes.iter().filter(|s| s.starts_with("tabs:") && s.contains("leaves only 2.000 mm of material beside it")).count();
+    assert_eq!(named, 2, "{:?}", t.notes);
+    assert_eq!(necks(&both, &t).len(), 8);
+}
diff --git a/docs/decisions/2561-tab-bridge-all-cuts.md b/docs/decisions/2561-tab-bridge-all-cuts.md
new file mode 100644
index 000000000..b0e24193c
--- /dev/null
+++ b/docs/decisions/2561-tab-bridge-all-cuts.md
@@ -0,0 +1,61 @@
+## #2561 - a contour tab is checked against every cut of its level
+
+**Decided.** After `tab_bridge::fit_tabs` fits each ring, the new
+`tab_clear` reads each tab's line on the ring against every other cut of
+the tabbed levels: the other keeps of the same ring, the far part of the
+two keeps beside the tab, and every other ring.
+
+- Another cut nearer than the tool diameter `D` cuts into the tab. The
+  loop is held: its tabbed levels cut nothing, and a `tabs:` note names
+  the tab and the distance. This is the response that `fit_tabs` already
+  gives when no bridge fits.
+- Another cut between `D` and `W + D` away leaves the tab at its width,
+  with less than the tab width of material beside it. The loop is cut as
+  before, and a `tabs:` note names the tab and the width of the strip.
+- A picked start that a grown tab covers gets a `tabs:` note that names
+  the pick and the point where the tabbed levels start instead.
+- `SLACK` stays `1e-6` with no margin for the chord error. A test reads
+  the bridge on the posted arcs in chords of `1e-5` mm and pins it to
+  `1e-4` mm.
+
+**Why.** The shape-mask measurement on main found tabs with a neck of
+0 mm and no note: a tab on the wall of a notch 10 mm wide (6 mm cutter),
+and a tab that faces a second part 10 mm away. The return run, or the
+other ring, passes 4 mm from the tab and removes it from its stock. A
+part can then come free with fewer tabs than the user asked for (Prime
+Directive: correct, or refused by name).
+
+The strip case is a note and not a hold. The strip between two kerfs has
+the full cut depth, and the tab has only the tab height, so the strip is
+not the weak point. The same reading also occurs across a thin wall of
+the part itself, which is not a tab defect. A hold there would refuse
+common nests.
+
+**Dropped.**
+
+- Move the tab away from the other cut. This changes where the user's
+  tabs are, and needs a placement law. Not in this fix.
+- Hold only the loops that have no good tab left. The user asked for a
+  count; fewer tabs without a refusal is the silent case again.
+- Remove a held ring's cuts before the other rings are checked. The
+  check uses all cuts as first fitted. This is conservative: a hold only
+  removes cuts.
+- A margin on `SLACK`. A margin of some microns grows each tab window
+  on a straight wall and moves the recorded router example program. The
+  measured error on the posted arcs is under `1e-6` mm on the fixtures of
+  the test. The flatten step (0.05 mm, 8 samples or more for each arc)
+  limits the sagitta to about 0.005 mm in the worst case; the tests
+  already accept 0.02 mm.
+- The meter in `shape_mask.rs`. That file has 409 lines, so the meter is
+  `crates/motion/tests/common/tab_neck.rs`.
+
+**Limits.** The check is local to the tab's line on the ring. It does
+not follow the stock strip farther along (a strip that narrows away from
+the tab). The two keeps beside a tab count only from where they have
+left the tab (`W + D` of walk, then the first point `W + D` from the
+line); `tab_bridge` owns the part before that. Tabs of two rings that
+face each other at the same place join the two parts and not the stock:
+this reads as "cuts into" only when the other ring cuts there.
+
+**Cost to change.** `tab_clear::fit_band` is one function with two
+thresholds. A later placement law (move the tab) replaces the hold arm.

From 57756c69a65af25691c2094b61ed6d58a6c528b0 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Thu, 19 Nov 2026 08:58:42 +0100
Subject: [PATCH 2/2] fix(2d): read a turn-back beside a tab and only the rings
 of its levels

Review of PR #2705 (head edb566d33):

- tab_clear::departed drops only the monotonic exit of a keep beside the
  tab. A piece that comes back toward the tab line counts, also before the
  keep is W + D away (a U-turn in a shallow notch gave a neck of 0 mm with
  no note). With one keep, its lead-in and lead-out are read the same way.
- tab_clear::fit_loops takes the tabbed levels of each loop from the depth
  ladder. A ring is read against a tab only when it is cut at a tabbed
  level of that tab's ring (a ring that stops on a shelf above the tabs
  held the deep island falsely).

Pinned by a_tab_that_a_u_turn_in_a_shallow_notch_cuts_into_holds_the_loop
and a_ring_that_stops_above_the_tabs_does_not_hold_another_loop; both fail
on edb566d33.

Refs #2561

