+//! Nesting building blocks: the CPU raster filter of the raster nest (#2525).
+//!
+//! Provenance: the raster ("no-fit raster") method of the nesting literature -
+//! Bennell and Oliveira, "The geometry of nesting problems: a tutorial", EJOR
+//! 2008 - and the conservative-coverage rules of research comment 2 on #2525.
+//! Nothing here reaches posted output or a verdict: a raster only filters
+//! candidates, and the exact `geo2d` check decides.
+
+pub mod raster;
diff --git a/crates/geometry/src/nesting/raster.rs b/crates/geometry/src/nesting/raster.rs
new file mode 100644
index 000000000..2cc896450
--- /dev/null
+++ b/crates/geometry/src/nesting/raster.rs
@@ -0,0 +1,261 @@
+//! Conservative bit-packed rasteriser for `geo2d::Region` (#2612, slice 1 of
+//! the raster nest #2525).
+//!
+//! Provenance: scanline polygon fill (even-odd parity at cell centres) and
+//! conservative coverage (each cell that a boundary edge touches), from
+//! Bennell and Oliveira (EJOR 2008) and the general computer-graphics
+//! literature on scan conversion. Integer arithmetic only.
+//!
+//! Two outputs, both safe for a first filter:
+//! - [`rasterize_over`] (parts): a bit is set for each cell whose closed
+//!   square touches the closed region. Each point of the region is in a set
+//!   cell.
+//! - [`rasterize_free`] (usable sheet): a bit is set only for a cell whose
+//!   closed square lies fully in the open interior of the region. Holes are
+//!   not free.
+//!
+//! Units are `geo2d` integer units ([`crate::geo2d::SCALE`] per mm, 1 um).
+//! No float enters the decision of a cell: region vertices are quantized
+//! with the same rule as the Clipper bridge, then all tests are exact
+//! `i128` arithmetic. A raster value never reaches posted output or a
+//! verdict; the exact vector check decides (#2525).
+
+use thiserror::Error;
+
+use crate::geo2d::{GeoError, Region};
+
+mod scan;
+
+/// Default cell size in units: 1 mm (research comment 2 on #2525, the
+/// coarse level of the coarse-to-fine search).
+pub const DEFAULT_CELL_UNITS: i64 = 1_000_000;
+
+/// Upper limit of cells in one grid: 4096 x 4096 (one fine tile of #2525).
+/// A 3000 x 1500 mm sheet at 1 mm (4.5e6 cells) fits.
+pub const MAX_CELLS: u64 = 1 << 24;
+
+/// Upper limit of cells on one side of a grid.
+pub const MAX_SIDE: u32 = 1 << 16;
+
+/// Why a raster was refused. Each variant names its reason.
+#[derive(Clone, Debug, Error, PartialEq, Eq)]
+pub enum RasterError {
+    #[error("raster cell size must be positive, got {0} units")]
+    NonPositiveCellSize(i64),
+    #[error("raster cell size is not a finite number")]
+    NonFiniteCellSize,
+    #[error("raster grid of {width} x {height} cells exceeds the limit ({MAX_CELLS} cells, {MAX_SIDE} on a side)")]
+    GridTooLarge { width: u64, height: u64 },
+    #[error("raster grid must have at least one cell on each side")]
+    EmptyGrid,
+    #[error("raster input has a non-finite coordinate")]
+    NonFinite,
+    #[error("raster input coordinates are outside the supported range")]
+    OutOfRange,
+    #[error("raster needs a region, but the region is empty")]
+    EmptyRegion,
+    #[error("region does not fit in the raster grid; an over-approximation must not be clipped")]
+    RegionExceedsGrid,
+}
+
+impl From<GeoError> for RasterError {
+    fn from(e: GeoError) -> Self {
+        match e {
+            GeoError::OutOfRange => RasterError::OutOfRange,
+            GeoError::Invalid(_) => RasterError::NonFinite,
+        }
+    }
+}
+
+/// Converts a cell size in mm to units (rounded to the nearest unit).
+/// Refuses a non-finite, non-positive or out-of-range value.
+pub fn cell_units_from_mm(mm: f64) -> Result<i64, RasterError> {
+    if !mm.is_finite() {
+        return Err(RasterError::NonFiniteCellSize);
+    }
+    let units = crate::geo2d::quantize(mm)?;
+    if units <= 0 {
+        return Err(RasterError::NonPositiveCellSize(units));
+    }
+    Ok(units)
+}
+
+/// A square-cell lattice. Cell `(i, j)` is the closed square
+/// `[ox + i*c, ox + (i+1)*c] x [oy + j*c, oy + (j+1)*c]` in units.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RasterGrid {
+    origin_x: i64,
+    origin_y: i64,
+    cell: i64,
+    width: u32,
+    height: u32,
+}
+
+impl RasterGrid {
+    /// A grid with an explicit origin (units), cell size (units) and size
+    /// (cells). Refuses a non-positive cell, an empty or too large grid,
+    /// and a far corner that does not fit in `i64`.
+    pub fn new(
+        origin_x: i64,
+        origin_y: i64,
+        cell: i64,
+        width: u32,
+        height: u32,
+    ) -> Result<Self, RasterError> {
+        if cell <= 0 {
+            return Err(RasterError::NonPositiveCellSize(cell));
+        }
+        check_size(u64::from(width), u64::from(height))?;
+        for (o, n) in [(origin_x, width), (origin_y, height)] {
+            let far = i128::from(o) + i128::from(cell) * i128::from(n);
+            if i64::try_from(far).is_err() {
+                return Err(RasterError::OutOfRange);
+            }
+        }
+        Ok(RasterGrid { origin_x, origin_y, cell, width, height })
+    }
+
+    /// The smallest grid on the global lattice (origin a multiple of the
+    /// cell size) whose closed extent contains the region. Refuses an
+    /// empty region and a grid over the limit.
+    pub fn covering(region: &Region, cell: i64) -> Result<Self, RasterError> {
+        if cell <= 0 {
+            return Err(RasterError::NonPositiveCellSize(cell));
+        }
+        let (lo, hi) = scan::unit_bounds(region)?.ok_or(RasterError::EmptyRegion)?;
+        let c = i128::from(cell);
+        let ox = scan::floor_div(i128::from(lo.0), c) * c;
+        let oy = scan::floor_div(i128::from(lo.1), c) * c;
+        let w = scan::ceil_div(i128::from(hi.0) - ox, c).max(1);
+        let h = scan::ceil_div(i128::from(hi.1) - oy, c).max(1);
+        let w = u64::try_from(w).map_err(|_| RasterError::OutOfRange)?;
+        let h = u64::try_from(h).map_err(|_| RasterError::OutOfRange)?;
+        check_size(w, h)?;
+        let ox = i64::try_from(ox).map_err(|_| RasterError::OutOfRange)?;
+        let oy = i64::try_from(oy).map_err(|_| RasterError::OutOfRange)?;
+        // check_size proved both sides fit in u32.
+        Self::new(ox, oy, cell, w as u32, h as u32)
+    }
+
+    pub fn origin(&self) -> (i64, i64) {
+        (self.origin_x, self.origin_y)
+    }
+
+    pub fn cell(&self) -> i64 {
+        self.cell
+    }
+
+    pub fn width(&self) -> u32 {
+        self.width
+    }
+
+    pub fn height(&self) -> u32 {
+        self.height
+    }
+
+    /// `u32` words for one row: `ceil(width / 32)`.
+    pub fn words_per_row(&self) -> usize {
+        (self.width as usize).div_ceil(32)
+    }
+
+    /// Closed square of cell `(i, j)` in units, `(x0, y0, x1, y1)`; `None`
+    /// outside the grid.
+    pub fn cell_rect(&self, i: u32, j: u32) -> Option<(i64, i64, i64, i64)> {
+        if i >= self.width || j >= self.height {
+            return None;
+        }
+        // `new` proved the far corner fits in i64.
+        let x0 = self.origin_x + i64::from(i) * self.cell;
+        let y0 = self.origin_y + i64::from(j) * self.cell;
+        Some((x0, y0, x0 + self.cell, y0 + self.cell))
+    }
+}
+
+fn check_size(w: u64, h: u64) -> Result<(), RasterError> {
+    if w == 0 || h == 0 {
+        return Err(RasterError::EmptyGrid);
+    }
+    let too_large = w > u64::from(MAX_SIDE)
+        || h > u64::from(MAX_SIDE)
+        || w.checked_mul(h).is_none_or(|n| n > MAX_CELLS);
+    if too_large {
+        return Err(RasterError::GridTooLarge { width: w, height: h });
+    }
+    Ok(())
+}
+
+/// Bits of a grid. Row `j` is the words `[j*wpr, (j+1)*wpr)`; cell `i` is
+/// bit `i % 32` (least significant bit first) of word `i / 32`. Padding
+/// bits past the width are always zero.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct BitRaster {
+    grid: RasterGrid,
+    words: Vec<u32>,
+}
+
+impl BitRaster {
+    pub(crate) fn zeroed(grid: RasterGrid) -> Self {
+        let n = grid.words_per_row() * grid.height as usize;
+        BitRaster { grid, words: vec![0; n] }
+    }
+
+    pub fn grid(&self) -> &RasterGrid {
+        &self.grid
+    }
+
+    pub fn words(&self) -> &[u32] {
+        &self.words
+    }
+
+    pub(crate) fn words_mut(&mut self) -> &mut [u32] {
+        &mut self.words
+    }
+
+    /// Bit of cell `(i, j)`; `false` outside the grid.
+    pub fn get(&self, i: u32, j: u32) -> bool {
+        if i >= self.grid.width || j >= self.grid.height {
+            return false;
+        }
+        let idx = j as usize * self.grid.words_per_row() + (i / 32) as usize;
+        self.words.get(idx).is_some_and(|w| (w >> (i % 32)) & 1 == 1)
+    }
+
+    /// Number of set cells.
+    pub fn count_ones(&self) -> u64 {
+        self.words.iter().map(|w| u64::from(w.count_ones())).sum()
+    }
+}
+
+/// Over-approximate raster (parts): set each cell whose closed square
+/// touches the closed region. Refuses a region that does not fit in the
+/// grid, because a clipped part raster is no longer an over-approximation.
+/// An empty region gives an all-zero raster.
+pub fn rasterize_over(region: &Region, grid: &RasterGrid) -> Result<BitRaster, RasterError> {
+    let edges = scan::unit_edges(region)?;
+    if let Some((lo, hi)) = scan::unit_bounds(region)?
+        && !scan::fits(grid, lo, hi)
+    {
+        return Err(RasterError::RegionExceedsGrid);
+    }
+    let inside = scan::centre_fill(&edges, grid)?;
+    let mut out = scan::edge_touch(&edges, grid)?;
+    for (o, i) in out.words_mut().iter_mut().zip(inside.words()) {
+        *o |= *i;
+    }
+    Ok(out)
+}
+
+/// Under-approximate raster (usable sheet): set a cell (free) only when its
+/// closed square is inside the open region: the centre is inside and no
+/// boundary edge touches the square. The grid may extend past the region;
+/// a cell outside the region is never free. An empty region gives an
+/// all-zero raster.
+pub fn rasterize_free(region: &Region, grid: &RasterGrid) -> Result<BitRaster, RasterError> {
+    let edges = scan::unit_edges(region)?;
+    let mut out = scan::centre_fill(&edges, grid)?;
+    let touched = scan::edge_touch(&edges, grid)?;
+    for (o, t) in out.words_mut().iter_mut().zip(touched.words()) {
+        *o &= !*t;
+    }
+    Ok(out)
+}
diff --git a/crates/geometry/src/nesting/raster/scan.rs b/crates/geometry/src/nesting/raster/scan.rs
new file mode 100644
index 000000000..376339476
--- /dev/null
+++ b/crates/geometry/src/nesting/raster/scan.rs
@@ -0,0 +1,229 @@
+//! Integer scan conversion for the raster filter: centre parity fill and
+//! conservative edge coverage.
+//!
+//! Provenance: scanline polygon fill with the half-open edge rule and
+//! conservative (supercover) segment traversal, from the general
+//! computer-graphics literature (scan conversion of polygons and lines) and
+//! Bennell and Oliveira (EJOR 2008). Our own integer formulation.
+//!
+//! All values are `i128`. Input units are below 1e18 in magnitude (the
+//! `geo2d` coordinate limit), so a product of two differences is below
+//! about 2e37, far inside the `i128` range (1.7e38). The checked helpers
+//! still refuse an overflow by name instead of wrapping.
+
+use super::{BitRaster, RasterError, RasterGrid};
+use crate::geo2d::{Region, quantize};
+
+/// One boundary edge in units, `(ax, ay, bx, by)`.
+pub(super) type Edge = (i128, i128, i128, i128);
+
+pub(super) fn floor_div(a: i128, b: i128) -> i128 {
+    let q = a / b;
+    if a % b != 0 && ((a < 0) != (b < 0)) { q - 1 } else { q }
+}
+
+pub(super) fn ceil_div(a: i128, b: i128) -> i128 {
+    let q = a / b;
+    if a % b != 0 && ((a < 0) == (b < 0)) { q + 1 } else { q }
+}
+
+fn mul(a: i128, b: i128) -> Result<i128, RasterError> {
+    a.checked_mul(b).ok_or(RasterError::OutOfRange)
+}
+
+fn add(a: i128, b: i128) -> Result<i128, RasterError> {
+    a.checked_add(b).ok_or(RasterError::OutOfRange)
+}
+
+/// All boundary edges of the region, quantized to units with the
+/// Clipper-bridge rule.
+pub(super) fn unit_edges(region: &Region) -> Result<Vec<Edge>, RasterError> {
+    let mut edges = Vec::new();
+    for l in region.loops() {
+        let pts = l
+            .points()
+            .iter()
+            .map(|p| Ok((i128::from(quantize(p.x)?), i128::from(quantize(p.y)?))))
+            .collect::<Result<Vec<_>, RasterError>>()?;
+        for (k, a) in pts.iter().enumerate() {
+            let b = pts[(k + 1) % pts.len()];
+            if *a != b {
+                edges.push((a.0, a.1, b.0, b.1));
+            }
+        }
+    }
+    Ok(edges)
+}
+
+/// Integer box `((xmin, ymin), (xmax, ymax))` in units.
+pub(super) type UnitBox = ((i64, i64), (i64, i64));
+
+/// Integer bounds of the region; `None` for an empty region.
+pub(super) fn unit_bounds(region: &Region) -> Result<Option<UnitBox>, RasterError> {
+    let mut out: Option<UnitBox> = None;
+    for l in region.loops() {
+        for p in l.points() {
+            let (x, y) = (quantize(p.x)?, quantize(p.y)?);
+            out = Some(match out {
+                None => ((x, y), (x, y)),
+                Some((lo, hi)) => ((lo.0.min(x), lo.1.min(y)), (hi.0.max(x), hi.1.max(y))),
+            });
+        }
+    }
+    Ok(out)
+}
+
+/// True when the closed box `lo..hi` lies in the closed grid extent.
+pub(super) fn fits(grid: &RasterGrid, lo: (i64, i64), hi: (i64, i64)) -> bool {
+    let c = i128::from(grid.cell);
+    let (ox, oy) = (i128::from(grid.origin_x), i128::from(grid.origin_y));
+    let (ex, ey) = (ox + c * i128::from(grid.width), oy + c * i128::from(grid.height));
+    i128::from(lo.0) >= ox && i128::from(lo.1) >= oy && i128::from(hi.0) <= ex && i128::from(hi.1) <= ey
+}
+
+/// Set bits `lo..=hi` of one row.
+fn set_range(row: &mut [u32], lo: usize, hi: usize) {
+    let (wl, wh) = (lo / 32, hi / 32);
+    for w in wl..=wh {
+        let from = if w == wl { lo % 32 } else { 0 };
+        let to = if w == wh { hi % 32 } else { 31 };
+        let mask = (u32::MAX >> (31 - (to - from))) << from;
+        if let Some(word) = row.get_mut(w) {
+            *word |= mask;
+        }
+    }
+}
+
+/// Closed index range `[lo, hi]` of cells along one axis that a closed
+/// coordinate interval `[a, b]` touches, clamped to `[0, n)`. `None` when
+/// it misses the grid. A value on a cell line touches both cells.
+fn touch_range(a: i128, b: i128, origin: i128, cell: i128, n: u32) -> Option<(usize, usize)> {
+    let mut lo = floor_div(a - origin, cell);
+    if (a - origin) % cell == 0 {
+        lo -= 1;
+    }
+    let hi = floor_div(b - origin, cell);
+    let last = i128::from(n) - 1;
+    if hi < 0 || lo > last {
+        return None;
+    }
+    // Both values are now inside [0, n) with n <= MAX_SIDE.
+    Some((lo.max(0) as usize, hi.min(last) as usize))
+}
+
+/// Floor and ceiling of `x(y)` on the edge, for a non-horizontal edge.
+fn x_at(e: &Edge, y: i128) -> Result<(i128, i128), RasterError> {
+    let (ax, ay, bx, by) = *e;
+    let num = mul(y - ay, bx - ax)?;
+    let den = by - ay;
+    Ok((add(ax, floor_div(num, den))?, add(ax, ceil_div(num, den))?))
+}
+
+/// Cells whose closed square touches a closed boundary edge.
+pub(super) fn edge_touch(edges: &[Edge], grid: &RasterGrid) -> Result<BitRaster, RasterError> {
+    let mut out = BitRaster::zeroed(*grid);
+    let wpr = grid.words_per_row();
+    let c = i128::from(grid.cell);
+    let (ox, oy) = (i128::from(grid.origin_x), i128::from(grid.origin_y));
+    for e in edges {
+        let (ax, ay, bx, by) = *e;
+        let (ylo, yhi) = (ay.min(by), ay.max(by));
+        let Some((jlo, jhi)) = touch_range(ylo, yhi, oy, c, grid.height) else {
+            continue;
+        };
+        for j in jlo..=jhi {
+            // Slab of row j, clipped to the edge's y extent.
+            let y0 = oy + c * j as i128;
+            let (ya, yb) = (ylo.max(y0), yhi.min(y0 + c));
+            if ya > yb {
+                continue;
+            }
+            let (xmin, xmax) = if ay == by {
+                (ax.min(bx), ax.max(bx))
+            } else {
+                let (fa, ca) = x_at(e, ya)?;
+                let (fb, cb) = x_at(e, yb)?;
+                (fa.min(fb), ca.max(cb))
+            };
+            if let Some((ilo, ihi)) = touch_range(xmin, xmax, ox, c, grid.width) {
+                let row = &mut out.words_mut()[j * wpr..(j + 1) * wpr];
+                set_range(row, ilo, ihi);
+            }
+        }
+    }
+    Ok(out)
+}
+
+/// Cells whose centre is inside the region by even-odd parity of a ray to
+/// +x, with the half-open edge rule of `geo2d` (an edge counts when the
+/// centre y is in `[ylo, yhi)`). Doubled coordinates keep the centre exact.
+pub(super) fn centre_fill(edges: &[Edge], grid: &RasterGrid) -> Result<BitRaster, RasterError> {
+    let mut diff = BitRaster::zeroed(*grid);
+    let wpr = grid.words_per_row();
+    let c = i128::from(grid.cell);
+    let (ox2, oy2) = (2 * i128::from(grid.origin_x), 2 * i128::from(grid.origin_y));
+    let last_row = i128::from(grid.height) - 1;
+    let w = i128::from(grid.width);
+    for e in edges {
+        let (ax, ay, bx, by) = *e;
+        if ay == by {
+            continue;
+        }
+        let (ylo, yhi) = (ay.min(by), ay.max(by));
+        // Rows j with ylo <= Yc_j < yhi, where 2*Yc_j = 2*oy + (2j+1)*c.
+        let jfrom = ceil_div(2 * ylo - oy2 - c, 2 * c).max(0);
+        let jto = (ceil_div(2 * yhi - oy2 - c, 2 * c) - 1).min(last_row);
+        if jfrom > jto {
+            continue;
+        }
+        // Signed denominator made positive for the rational crossing.
+        let (sign, den) = if by > ay { (1, by - ay) } else { (-1, ay - by) };
+        for j in jfrom..=jto {
+            let y2 = oy2 + (2 * j + 1) * c;
+            // Cell i flips when its doubled centre X_i = 2*ox + (2i+1)*c is
+            // left of the doubled crossing 2*ax + (y2 - 2*ay)*(bx-ax)/(by-ay),
+            // that is 2*i*c*den < num with the num below.
+            let lean = mul(sign * (y2 - 2 * ay), bx - ax)?;
+            let num = add(add(mul(2 * ax - ox2, den)?, lean)?, -mul(c, den)?)?;
+            let k = if num <= 0 { 0 } else { ceil_div(num, mul(2 * c, den)?) };
+            if k == 0 {
+                continue;
+            }
+            // Flip cells [0, k): toggle the difference bits at 0 and k.
+            let row = &mut diff.words_mut()[j as usize * wpr..(j as usize + 1) * wpr];
+            row[0] ^= 1;
+            if k < w {
+                let k = k as usize;
+                row[k / 32] ^= 1 << (k % 32);
+            }
+        }
+    }
+    prefix_xor_rows(&mut diff, wpr, grid.width);
+    Ok(diff)
+}
+
+/// Turn each row of difference bits into parity: bit i becomes the XOR of
+/// bits 0..=i. Padding bits are cleared.
+fn prefix_xor_rows(r: &mut BitRaster, wpr: usize, width: u32) {
+    let tail = width % 32;
+    let pad_mask = if tail == 0 { u32::MAX } else { (1u32 << tail) - 1 };
+    for row in r.words_mut().chunks_mut(wpr.max(1)) {
+        let mut carry = false;
+        for word in row.iter_mut() {
+            let mut v = *word;
+            v ^= v << 1;
+            v ^= v << 2;
+            v ^= v << 4;
+            v ^= v << 8;
+            v ^= v << 16;
+            if carry {
+                v = !v;
+            }
+            carry = v >> 31 == 1;
+            *word = v;
+        }
+        if let Some(last) = row.last_mut() {
+            *last &= pad_mask;
+        }
+    }
+}
diff --git a/crates/geometry/tests/nesting_raster.rs b/crates/geometry/tests/nesting_raster.rs
new file mode 100644
index 000000000..8fda8d4d3
--- /dev/null
+++ b/crates/geometry/tests/nesting_raster.rs
@@ -0,0 +1,304 @@
+//! Conservative raster tests (#2612): the over-approximation covers every
+//! point of the region, a free cell lies fully inside the sheet, the bits
+//! are deterministic, and each refusal names its reason.
+//!
+//! Gate map: covers camcraft_geometry::nesting::raster.
+
+use camcraft_geometry::geo2d::{Loop, Point2, Region, SCALE};
+use camcraft_geometry::nesting::raster::{
+    BitRaster, DEFAULT_CELL_UNITS, RasterError, RasterGrid, cell_units_from_mm, rasterize_free,
+    rasterize_over,
+};
+
+const MM: i64 = 1_000_000;
+
+fn poly(pts: &[(f64, f64)]) -> Loop {
+    Loop::new(pts.iter().map(|&(x, y)| Point2::new(x, y)).collect()).expect("test loop")
+}
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Loop {
+    poly(&[(x0, y0), (x1, y0), (x1, y1), (x0, y1)])
+}
+
+fn region(loops: Vec<Loop>) -> Region {
+    Region::new(loops).expect("test region")
+}
+
+fn rotated_rect(cx: f64, cy: f64, w: f64, h: f64, deg: f64) -> Loop {
+    let (s, c) = deg.to_radians().sin_cos();
+    let corners = [(-w / 2.0, -h / 2.0), (w / 2.0, -h / 2.0), (w / 2.0, h / 2.0), (-w / 2.0, h / 2.0)];
+    poly(&corners.map(|(x, y)| (cx + x * c - y * s, cy + x * s + y * c)))
+}
+
+fn ngon(cx: f64, cy: f64, r: f64, n: usize) -> Loop {
+    let pts: Vec<(f64, f64)> = (0..n)
+        .map(|k| {
+            let a = k as f64 * std::f64::consts::TAU / n as f64;
+            (cx + r * a.cos(), cy + r * a.sin())
+        })
+        .collect();
+    poly(&pts)
+}
+
+fn units(mm: f64) -> i128 {
+    (mm * SCALE).round() as i128
+}
+
+/// Cell indices on one axis whose closed interval holds `v` (two on a line).
+fn axis_cells(v: i128, origin: i64, cell: i64) -> Vec<i128> {
+    let d = v - i128::from(origin);
+    let c = i128::from(cell);
+    let i = d.div_euclid(c);
+    if d.rem_euclid(c) == 0 { vec![i - 1, i] } else { vec![i] }
+}
+
+fn point_in_marked_cell(r: &BitRaster, x: i128, y: i128) -> bool {
+    let g = r.grid();
+    let (ox, oy) = g.origin();
+    axis_cells(x, ox, g.cell()).iter().any(|&i| {
+        axis_cells(y, oy, g.cell()).iter().any(|&j| {
+            i >= 0 && j >= 0 && r.get(i as u32, j as u32)
+        })
+    })
+}
+
+/// Over-approximation law on a dense sample: every vertex and every sample
+/// point that the exact region contains lies in a marked cell.
+fn assert_over_covers(reg: &Region, cell: i64, step_mm: f64) -> BitRaster {
+    let grid = RasterGrid::covering(reg, cell).expect("grid");
+    let r = rasterize_over(reg, &grid).expect("over raster");
+    for l in reg.loops() {
+        for p in l.points() {
+            assert!(point_in_marked_cell(&r, units(p.x), units(p.y)), "vertex {p:?} not covered");
+        }
+    }
+    let (lo, hi) = reg.bounds().expect("bounds");
+    let mut checked = 0;
+    let mut y = lo.y + step_mm * 0.37;
+    while y <= hi.y {
+        let mut x = lo.x + step_mm * 0.61;
+        while x <= hi.x {
+            let p = Point2::new(x, y);
+            if reg.contains(p) {
+                checked += 1;
+                assert!(point_in_marked_cell(&r, units(x), units(y)), "point {p:?} not covered");
+            }
+            x += step_mm;
+        }
+        y += step_mm;
+    }
+    assert!(checked > 0, "sample found no point inside");
+    r
+}
+
+/// Exact test: does the closed segment touch the closed axis box?
+fn segment_touches_box(a: (i128, i128), b: (i128, i128), bx: (i128, i128, i128, i128)) -> bool {
+    let (x0, y0, x1, y1) = bx;
+    if a.0.max(b.0) < x0 || a.0.min(b.0) > x1 || a.1.max(b.1) < y0 || a.1.min(b.1) > y1 {
+        return false;
+    }
+    let side = |p: (i128, i128)| (b.0 - a.0) * (p.1 - a.1) - (b.1 - a.1) * (p.0 - a.0);
+    let s = [side((x0, y0)), side((x1, y0)), side((x1, y1)), side((x0, y1))];
+    !(s.iter().all(|&v| v > 0) || s.iter().all(|&v| v < 0))
+}
+
+/// Under-approximation law: each free cell has its corners and centre in
+/// the region, and no region edge touches the closed cell.
+fn assert_free_inside(reg: &Region, r: &BitRaster) -> u64 {
+    let g = r.grid();
+    let edges: Vec<((i128, i128), (i128, i128))> = reg
+        .loops()
+        .iter()
+        .flat_map(|l| {
+            let p = l.points();
+            (0..p.len()).map(move |k| {
+                let (a, b) = (p[k], p[(k + 1) % p.len()]);
+                ((units(a.x), units(a.y)), (units(b.x), units(b.y)))
+            })
+        })
+        .collect();
+    let mut free = 0;
+    for j in 0..g.height() {
+        for i in 0..g.width() {
+            if !r.get(i, j) {
+                continue;
+            }
+            free += 1;
+            let (x0, y0, x1, y1) = g.cell_rect(i, j).expect("cell");
+            let mm = |v: i64| v as f64 / SCALE;
+            let xc = (x0 as f64 + x1 as f64) / 2.0 / SCALE;
+            let yc = (y0 as f64 + y1 as f64) / 2.0 / SCALE;
+            for (x, y) in [(mm(x0), mm(y0)), (mm(x1), mm(y0)), (mm(x1), mm(y1)), (mm(x0), mm(y1)), (xc, yc)] {
+                assert!(reg.contains(Point2::new(x, y)), "free cell ({i},{j}) has ({x},{y}) outside");
+            }
+            let bx = (i128::from(x0), i128::from(y0), i128::from(x1), i128::from(y1));
+            for (a, b) in &edges {
+                assert!(!segment_touches_box(*a, *b, bx), "edge crosses free cell ({i},{j})");
+            }
+        }
+    }
+    free
+}
+
+#[test]
+fn raster_over_square_golden_and_cover() {
+    let reg = region(vec![rect(0.0, 0.0, 10.0, 10.0)]);
+    let grid = RasterGrid::new(-2 * MM, -2 * MM, MM, 14, 14).expect("grid");
+    let over = rasterize_over(&reg, &grid).expect("over");
+    // Cells -1..=10 touch the closed square (the lines x=0 and x=10 touch
+    // two cells each): 12 x 12.
+    assert_eq!(over.count_ones(), 144);
+    let free = rasterize_free(&reg, &grid).expect("free");
+    // Cells 1..=8 are clear of the boundary: 8 x 8.
+    assert_eq!(free.count_ones(), 64);
+    assert_free_inside(&reg, &free);
+    assert_over_covers(&region(vec![rect(0.3, 0.7, 10.3, 9.9)]), MM, 0.13);
+}
+
+#[test]
+fn raster_over_part_with_hole_covers_and_keeps_hole_open() {
+    let reg = region(vec![rect(0.0, 0.0, 20.0, 20.0), rect(6.0, 6.0, 14.0, 14.0)]);
+    let r = assert_over_covers(&reg, MM, 0.11);
+    // Cell [9,10] x [9,10] is deep in the hole: no part material touches it.
+    assert!(!r.get(9, 9), "hole cell marked");
+    assert!(r.get(6, 6) && r.get(5, 9), "hole rim cells must be marked");
+}
+
+#[test]
+fn raster_over_thin_sliver_covers() {
+    let reg = region(vec![rect(5.4, 0.2, 5.45, 30.1)]);
+    let r = assert_over_covers(&reg, MM, 0.007);
+    assert_eq!(r.grid().width(), 1, "a 0.05 mm sliver inside one column");
+    // Rotated sliver: crosses many cells diagonally.
+    let reg = region(vec![rotated_rect(10.0, 10.0, 25.0, 0.03, 37.0)]);
+    assert_over_covers(&reg, MM / 2, 0.01);
+}
+
+#[test]
+fn raster_over_rotated_part_covers() {
+    let reg = region(vec![rotated_rect(3.3, -7.1, 12.0, 5.0, 30.0), ngon(20.0, 4.0, 3.7, 17)]);
+    assert_over_covers(&reg, MM, 0.09);
+    assert_over_covers(&reg, 333_333, 0.05);
+}
+
+#[test]
+fn raster_free_sheet_cells_inside_and_holes_not_free() {
+    let sheet = region(vec![
+        rect(0.0, 0.0, 100.0, 50.0),
+        ngon(30.0, 25.0, 10.0, 24),
+        rotated_rect(75.0, 20.0, 15.0, 6.0, 20.0),
+    ]);
+    // A grid larger than the sheet: cells outside are never free.
+    let grid = RasterGrid::new(-5 * MM, -5 * MM, MM, 112, 62).expect("grid");
+    let free = rasterize_free(&sheet, &grid).expect("free");
+    let n = assert_free_inside(&sheet, &free);
+    assert!(n > 3500 && n < 4704, "free cells {n}");
+    // Cell holding the hole centre (30, 25) is not free.
+    assert!(!free.get(35, 30), "hole centre cell must not be free");
+    // Cell [50,51] x [40,41] is plain sheet: free.
+    assert!(free.get(55, 45));
+    // Fine cell size not on the mm lattice.
+    let grid = RasterGrid::new(0, 0, 777_777, 129, 65).expect("grid");
+    assert_free_inside(&sheet, &rasterize_free(&sheet, &grid).expect("free"));
+}
+
+#[test]
+fn raster_same_input_same_bits() {
+    let reg = region(vec![rotated_rect(3.3, -7.1, 12.0, 5.0, 30.0), ngon(20.0, 4.0, 3.7, 17)]);
+    let grid = RasterGrid::covering(&reg, 250_000).expect("grid");
+    let a = rasterize_over(&reg, &grid).expect("a");
+    let b = rasterize_over(&reg.clone(), &grid).expect("b");
+    assert_eq!(a.words(), b.words());
+    assert_eq!(rasterize_free(&reg, &grid), rasterize_free(&reg, &grid));
+}
+
+#[test]
+fn raster_packing_rows_and_padding() {
+    let reg = region(vec![rect(0.0, 0.0, 40.0, 3.0)]);
+    let grid = RasterGrid::new(-MM, -MM, MM, 45, 5).expect("grid");
+    assert_eq!(grid.words_per_row(), 2);
+    let r = rasterize_over(&reg, &grid).expect("over");
+    assert_eq!(r.words().len(), 10);
+    for row in r.words().chunks(2) {
+        assert_eq!(row[1] >> 13, 0, "padding bits past width 45 must be zero");
+    }
+    // Row 1 (y in [0,1]): cells 0..=41 are set (x from -1 to 41 mm).
+    assert_eq!(r.words()[2], u32::MAX);
+    assert_eq!(r.words()[3], (1 << 10) - 1);
+}
+
+#[test]
+fn raster_refusals_name_their_reason() {
+    let reg = region(vec![rect(0.0, 0.0, 10.0, 10.0)]);
+    assert_eq!(RasterGrid::new(0, 0, 0, 4, 4), Err(RasterError::NonPositiveCellSize(0)));
+    assert_eq!(RasterGrid::covering(&reg, -5), Err(RasterError::NonPositiveCellSize(-5)));
+    assert_eq!(RasterGrid::new(0, 0, MM, 0, 4), Err(RasterError::EmptyGrid));
+    assert!(matches!(RasterGrid::new(0, 0, 1, 5000, 5000), Err(RasterError::GridTooLarge { .. })));
+    assert!(matches!(RasterGrid::new(0, 0, 1, 70_000, 1), Err(RasterError::GridTooLarge { .. })));
+    assert!(matches!(RasterGrid::covering(&reg, 1), Err(RasterError::GridTooLarge { .. })));
+    assert_eq!(RasterGrid::new(i64::MAX - 10, 0, MM, 4, 4), Err(RasterError::OutOfRange));
+    assert_eq!(RasterGrid::covering(&Region::empty(), MM), Err(RasterError::EmptyRegion));
+    assert_eq!(cell_units_from_mm(f64::NAN), Err(RasterError::NonFiniteCellSize));
+    assert_eq!(cell_units_from_mm(f64::INFINITY), Err(RasterError::NonFiniteCellSize));
+    assert_eq!(cell_units_from_mm(-1.0), Err(RasterError::NonPositiveCellSize(-1_000_000)));
+    assert_eq!(cell_units_from_mm(1e-9), Err(RasterError::NonPositiveCellSize(0)));
+    assert_eq!(cell_units_from_mm(1e13), Err(RasterError::OutOfRange));
+    assert_eq!(cell_units_from_mm(1.0), Ok(DEFAULT_CELL_UNITS));
+    // A part that does not fit is refused, never clipped.
+    let small = RasterGrid::new(0, 0, MM, 5, 5).expect("grid");
+    assert_eq!(rasterize_over(&reg, &small), Err(RasterError::RegionExceedsGrid));
+    for e in [RasterError::RegionExceedsGrid, RasterError::EmptyRegion, RasterError::NonFinite] {
+        assert!(!e.to_string().is_empty());
+    }
+}
+
+#[test]
+fn raster_degenerate_input_is_clean() {
+    // Region outside the grid: the sheet raster has no free cell.
+    let reg = region(vec![rect(500.0, 500.0, 510.0, 510.0)]);
+    let grid = RasterGrid::new(0, 0, MM, 20, 20).expect("grid");
+    assert_eq!(rasterize_free(&reg, &grid).expect("free").count_ones(), 0);
+    assert_eq!(rasterize_over(&reg, &grid), Err(RasterError::RegionExceedsGrid));
+    // Empty region: all-zero rasters.
+    assert_eq!(rasterize_over(&Region::empty(), &grid).expect("over").count_ones(), 0);
+    assert_eq!(rasterize_free(&Region::empty(), &grid).expect("free").count_ones(), 0);
+    // Zero-area sliver: a collinear loop is refused or normalized away.
+    let line = vec![Point2::new(0.0, 0.0), Point2::new(5.0, 5.0), Point2::new(9.0, 9.0)];
+    if let Ok(l) = Loop::new(line)
+        && let Ok(z) = Region::new(vec![l])
+    {
+        assert!(z.is_empty(), "a zero-area loop normalizes to an empty region");
+        assert_eq!(rasterize_over(&z, &grid).expect("over").count_ones(), 0);
+        assert_eq!(RasterGrid::covering(&z, MM), Err(RasterError::EmptyRegion));
+    }
+    // NaN never reaches a region.
+    assert!(Loop::new(vec![Point2::new(f64::NAN, 0.0), Point2::new(1.0, 0.0), Point2::new(0.0, 1.0)]).is_err());
+    // Huge coordinates: a 1 mm part far out still rasterizes on its own grid.
+    let far = region(vec![rect(9e11, -9e11, 9e11 + 1.0, -9e11 + 1.0)]);
+    let g = RasterGrid::covering(&far, MM).expect("far grid");
+    assert!(rasterize_over(&far, &g).expect("far over").count_ones() >= 1);
+    // Huge part at a fine cell: refused by the limit, not a hang.
+    let big = region(vec![rect(-9e11, -9e11, 9e11, 9e11)]);
+    assert!(matches!(RasterGrid::covering(&big, MM), Err(RasterError::GridTooLarge { .. })));
+    let edge_grid = RasterGrid::new(0, 0, MM, 30, 30).expect("grid");
+    assert_eq!(rasterize_free(&big, &edge_grid).expect("free").count_ones(), 900);
+}
+
+#[test]
+fn raster_reading_typical_sizes() {
+    let part = region(vec![ngon(0.0, 0.0, 50.0, 256), ngon(0.0, 0.0, 20.0, 64)]);
+    let t = std::time::Instant::now();
+    let g = RasterGrid::covering(&part, MM / 10).expect("grid");
+    let r = rasterize_over(&part, &g).expect("over");
+    let part_ms = t.elapsed().as_secs_f64() * 1e3;
+    let sheet = region(vec![rect(0.0, 0.0, 3000.0, 1500.0)]);
+    let t = std::time::Instant::now();
+    let sg = RasterGrid::covering(&sheet, DEFAULT_CELL_UNITS).expect("sheet grid");
+    let s = rasterize_free(&sheet, &sg).expect("free");
+    let sheet_ms = t.elapsed().as_secs_f64() * 1e3;
+    eprintln!(
+        "reading: part {}x{} cells, {} set, {part_ms:.1} ms; sheet {}x{} cells, {} free, {sheet_ms:.1} ms",
+        g.width(), g.height(), r.count_ones(), sg.width(), sg.height(), s.count_ones()
+    );
+    assert_eq!(s.count_ones(), 2998 * 1498);
+}
diff --git a/docs/decisions/2612-nesting-raster.md b/docs/decisions/2612-nesting-raster.md
new file mode 100644
index 000000000..9295a7e4a
--- /dev/null
+++ b/docs/decisions/2612-nesting-raster.md
@@ -0,0 +1,55 @@
+## #2612 - Nesting raster 1: conservative bit-packed rasteriser
+
+**Decided (unattended, issue-worker-high):**
+
+- **Place.** `camcraft_geometry::nesting::raster` (`crates/geometry/src/nesting/raster.rs`
+  and `raster/scan.rs`). No new crate, no new crate edge, no new external
+  dependency.
+- **Integer decisions.** Region vertices are quantized with the `geo2d`
+  Clipper-bridge rule (`geo2d::quantize`, 1 unit = 1 um). All cell tests
+  are exact `i128` arithmetic with checked multiply and add. No float takes
+  part in a cell decision.
+- **One algorithm, two outputs.** Two integer passes: (1) "touched" - each
+  cell whose closed square touches a closed boundary edge (row slabs, with
+  the x extent of the edge in the slab rounded outward: floor of the
+  minimum, ceiling of the maximum); (2) "centre inside" - even-odd parity of
+  a +x ray at each cell centre, with the half-open edge rule of
+  `geo2d::Loop::contains_xy`, in doubled coordinates so that the centre is
+  an integer. Over = touched OR centre inside. Free = centre inside AND NOT
+  touched. Why this is safe: a closed square that meets the region but no
+  boundary edge is fully in the interior, so its centre is inside; a square
+  that no edge touches and whose centre is inside is fully in the interior.
+- **Rounding direction.** Always outward for "touched": a value on a cell
+  line touches the two cells; the x extent in a slab is widened to whole
+  units. This can mark one extra cell, never one fewer.
+- **Cell packing.** Rows of `u32` words, `ceil(width / 32)` words for each
+  row. Cell `i` is bit `i % 32` (least significant bit first) of word
+  `i / 32`. Padding bits are always zero. `u32` matches a WGSL storage
+  buffer word for the later GPU slice.
+- **Grid origin.** `RasterGrid::covering` snaps the origin down to a multiple
+  of the cell size (the global lattice), so that part and sheet rasters at
+  the same cell size share one lattice and a placement moves in whole cells
+  (research comment 2 on #2525, rule 3). `RasterGrid::new` takes any origin.
+- **Cell-size default.** `DEFAULT_CELL_UNITS` = 1 mm (the coarse level of
+  the coarse-to-fine search of #2525).
+- **Cell limit.** `MAX_CELLS` = 2^24 (4096 x 4096, one fine tile of #2525)
+  and `MAX_SIDE` = 2^16 on a side. A 3000 x 1500 mm sheet at 1 mm (4.5e6
+  cells) fits. A larger grid is `RasterError::GridTooLarge`.
+- **A part that does not fit is refused.** `rasterize_over` returns
+  `RasterError::RegionExceedsGrid` when the region bounds are not in the
+  closed grid extent: a clipped part raster is no longer an
+  over-approximation. `rasterize_free` clips freely: a cell outside the
+  region is never free, which is the safe side.
+- **Empty region.** `RasterGrid::covering` refuses it (`EmptyRegion`); the
+  two rasterize functions return an all-zero raster for it.
+
+**Dropped:**
+
+- Float scanline with an epsilon: not exact, and an epsilon can lose a
+  touched cell.
+- Rasterize the Minkowski-inflated part here: the spacing inflation belongs
+  to the placer slice; this slice takes the region that it is given.
+- `u64` words: `u32` is the native word of a WGSL storage buffer.
+
+**Cost to change later:** the bit layout is internal to the raster and the
+later slices; a change touches only `nesting::raster` and its tests.
