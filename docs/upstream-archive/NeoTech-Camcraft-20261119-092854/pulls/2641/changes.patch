+        );
+        let err = parse_controller_table(ToolTableFormat::Hurco, &bad, Unit::Millimeters).unwrap_err();
+        assert!(err.contains(&format!("Tool{code}")) && err.contains(label), "{code}: {err}");
+    }
+}
