-                    }
-                    report.skipped.push(name);
-                }
-                (Some(_), Some(prev)) if mode != ImportMode::Add => {
-                    if let Some(why) = change_refusal(world, &name, &prev, &tool, body.as_ref()) {
-                        return Err(CommandError::Invalid(why));
-                    }
-                    match mode {
