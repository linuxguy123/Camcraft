@@ -0,0 +1,230 @@
+//! Machine tool-table import and export dispatcher (#2566): one
+//! shared model over CamCraft native libraries and machine controller
+//! tables (Tormach PathPilot `.csv`, Hurco WinMax `.TCM`); clean-room
+//! implementation from public documentation and user-recorded files.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use camcraft_geometry::geometry::units::{MM_PER_INCH, Unit};
+
+use crate::catalog_fields::ToolCatalog;
+use crate::cutting::ToolMaterial;
+use crate::thread_hand::ThreadHand;
+use crate::tools::{Tool, ToolKind};
+
+/// Supported tool-library / controller tool-table formats.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ToolTableFormat {
+    /// CamCraft's native JSON envelope (`.camtools` / `.json`).
+    CamTools,
+    /// Tormach PathPilot mill tool table (`.csv`).
+    PathPilot,
+    /// Hurco WinMax tool library XML (`.TCM`).
+    Hurco,
+}
+
+impl ToolTableFormat {
+    /// Parse `"auto"` (returns `None`) or an explicit format name.
+    pub fn parse_opt(text: &str) -> Result<Option<Self>, String> {
+        match text.trim().to_ascii_lowercase().as_str() {
+            "" | "auto" => Ok(None),
+            "camtools" | "camcraft" | "json" => Ok(Some(Self::CamTools)),
+            "pathpilot" | "tormach" | "csv" => Ok(Some(Self::PathPilot)),
+            "hurco" | "winmax" | "tcm" => Ok(Some(Self::Hurco)),
+            other => Err(format!(
+                "unknown tool library format '{other}' (use auto, camtools, pathpilot or hurco)"
+            )),
+        }
+    }
+
+    /// Canonical wire name for reports, MCP, and scripts.
+    #[must_use]
+    pub const fn label(self) -> &'static str {
+        match self {
+            Self::CamTools => "camtools",
+            Self::PathPilot => "pathpilot",
+            Self::Hurco => "hurco",
+        }
+    }
+}
+
+/// Detect format from path extension first, then optionally from file content.
+#[must_use]
+pub fn detect_format(path: &Path, content: Option<&str>) -> Option<ToolTableFormat> {
+    if let Some(ext) = path.extension().and_then(|e| e.to_str()) {
+        match ext.to_ascii_lowercase().as_str() {
+            "csv" => return Some(ToolTableFormat::PathPilot),
+            "tcm" => return Some(ToolTableFormat::Hurco),
+            "camtools" | "json" => return Some(ToolTableFormat::CamTools),
+            _ => {}
+        }
+    }
+    let text = content?.trim_start_matches('\u{FEFF}').trim_start();
+    if text.starts_with("Mill Tool Table,") {
+        Some(ToolTableFormat::PathPilot)
+    } else if text.contains("<Hurco_Document") {
+        Some(ToolTableFormat::Hurco)
+    } else if text.starts_with('{') || text.starts_with('[') {
+        Some(ToolTableFormat::CamTools)
+    } else {
+        None
+    }
+}
+
+/// Parse an explicit length unit string (`"mm"` or `"inch"`).
+pub fn parse_unit(text: &str) -> Result<Unit, String> {
+    match text.trim().to_ascii_lowercase().as_str() {
+        "mm" | "millimeter" | "millimeters" | "millimetre" | "millimetres" => Ok(Unit::Millimeters),
+        "in" | "inch" | "inches" => Ok(Unit::Inches),
+        other => Err(format!("unknown units '{other}' (use mm or inch)")),
+    }
+}
+
+/// One imported tool row from a controller tool table.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ToolTableEntry {
+    pub number: u32,
+    pub name: String,
+    pub tool: Tool,
+}
+
+/// One tool to write into a controller tool table.
+#[derive(Clone, Copy, Debug)]
+pub struct ToolTableExportRow<'a> {
+    pub number: u32,
+    pub name: &'a str,
+    pub tool: &'a Tool,
+    /// Optional measured holder gauge length (mm) from a modelled body/holder.
+    pub gauge_len: Option<f64>,
+}
+
+/// Convert a length value from `unit` into millimetres.
+#[must_use]
+pub(crate) fn to_mm(value: f64, unit: Unit) -> f64 {
+    match unit {
+        Unit::Millimeters => value,
+        Unit::Inches => value * MM_PER_INCH,
+    }
+}
+
+/// Convert a length value from millimetres into `unit`.
+#[must_use]
+pub(crate) fn from_mm(value: f64, unit: Unit) -> f64 {
+    match unit {
+        Unit::Millimeters => value,
+        Unit::Inches => value / MM_PER_INCH,
+    }
+}
+
+/// Build a baseline `Tool` in mm with valid defaults for fields the
+/// controller tool table does not record.
+#[must_use]
+pub(crate) fn base_tool(kind: ToolKind, diameter_mm: f64) -> Tool {
+    let flute_len = (diameter_mm * 3.0).max(10.0);
+    let shank_len = (flute_len * 1.5).max(15.0);
+    let corner_r = match kind {
+        ToolKind::BallNose | ToolKind::Probe => diameter_mm * 0.5,
+        _ => 0.0,
+    };
+    let tip_angle = match kind {
+        ToolKind::Drill => 118.0,
+        ToolKind::Taper => 90.0,
+        ToolKind::ThreadMill | ToolKind::ThreadMillSingle => 60.0,
+        _ => 0.0,
+    };
+    let pitch = match kind {
+        ToolKind::Tap => 1.0,
+        ToolKind::ThreadMill | ToolKind::ThreadMillSingle => {
+            let max_safe = (diameter_mm * 0.5) / (crate::thread_mill::EXTERNAL_DEPTH_PER_PITCH * 1.5);
+            1.0_f64.min(max_safe).max(0.2)
+        }
+        _ => 0.0,
+    };
+    let pitch_min = if kind == ToolKind::ThreadMillSingle { pitch } else { 0.0 };
+    let rpm = if kind == ToolKind::Probe { 1.0 } else { 3000.0 };
+    let feed = if kind == ToolKind::Probe { 300.0 } else { 500.0 };
+    let center_cutting = kind != ToolKind::Probe;
+    Tool {
+        kind,
+        diameter: diameter_mm,
+        corner_r,
+        tip_angle,
+        pitch,
+        pitch_min,
+        thread_hand: ThreadHand::Right,
+        nose_radius: 0.0,
+        width: 0.0,
+        flute_len,
+        shank_d: diameter_mm,
+        shank_len,
+        holder_d: (diameter_mm * 2.0).max(20.0),
+        holder_len: 35.0,
+        material_group: if kind == ToolKind::Probe { String::new() } else { "aluminum".into() },
+        rpm,
+        feed,
+        tool_material: None::<ToolMaterial>,
+        flutes: None,
+        center_cutting,
+        orientation: None,
+        catalog: ToolCatalog::default(),
+        cutting: Vec::new(),
+        outline: Vec::new(),
+        turning: None,
+    }
+}
+
+/// Ensure imported entries have unique names (disambiguating clashes with ` (T<number>)`).
+pub(crate) fn disambiguate_names(entries: &mut [ToolTableEntry]) {
+    let mut counts: HashMap<String, usize> = HashMap::new();
+    for e in entries.iter() {
+        *counts.entry(e.name.clone()).or_insert(0) += 1;
+    }
+    let mut used: HashMap<String, usize> = HashMap::new();
+    for e in entries.iter_mut() {
+        let base = e.name.clone();
+        if counts.get(&base).copied().unwrap_or(0) > 1 {
+            let candidate = format!("{base} (T{})", e.number);
+            if !counts.contains_key(&candidate) && !used.contains_key(&candidate) {
+                e.name = candidate;
+            } else {
+                let n = used.entry(base.clone()).or_insert(1);
+                *n += 1;
+                e.name = format!("{base} ({n})");
+            }
+        }
+        used.entry(e.name.clone()).or_insert(1);
+    }
+}
+
+/// Parse a controller tool-table file (`PathPilot` or `Hurco`).
+pub fn parse_controller_table(
+    format: ToolTableFormat,
+    text: &str,
+    unit: Unit,
+) -> Result<Vec<ToolTableEntry>, String> {
+    let mut entries = match format {
+        ToolTableFormat::PathPilot => crate::tool_table_pathpilot::parse(text, unit)?,
+        ToolTableFormat::Hurco => crate::tool_table_hurco::parse(text, unit)?,
+        ToolTableFormat::CamTools => {
+            return Err("internal error: camtools JSON is parsed by app::tool_library".into());
+        }
+    };
+    disambiguate_names(&mut entries);
+    Ok(entries)
+}
+
+/// Format document tools into a controller tool-table file (`PathPilot` or `Hurco`).
+pub fn export_controller_table(
+    format: ToolTableFormat,
+    rows: &[ToolTableExportRow<'_>],
+    unit: Unit,
+) -> Result<String, String> {
+    match format {
+        ToolTableFormat::PathPilot => crate::tool_table_pathpilot::export(rows, unit),
+        ToolTableFormat::Hurco => crate::tool_table_hurco::export(rows, unit),
+        ToolTableFormat::CamTools => {
+            Err("internal error: camtools JSON is exported by app::tool_library".into())
+        }
+    }
+}
diff --git a/crates/tools/src/tool_table_hurco.rs b/crates/tools/src/tool_table_hurco.rs
new file mode 100644
index 000000000..c1c80d7fd
--- /dev/null
+++ b/crates/tools/src/tool_table_hurco.rs
@@ -0,0 +1,394 @@
+//! Hurco WinMax tool library (.TCM) XML reader and writer (#2566);
+//! specced from Hurco public WinMax documentation (#30001 ToolType table)
+//! and user-recorded .TCM structure.
+
+use std::collections::HashSet;
+
+use camcraft_geometry::geometry::units::Unit;
+
+use crate::catalog_fields::MAX_SHORT;
+use crate::tool_table::{ToolTableEntry, ToolTableExportRow, base_tool, from_mm, to_mm};
+use crate::tool_table_xml::{XmlNode, escape_xml, parse_xml};
+use crate::tools::{Tool, ToolKind};
+
+/// Strip optional `Tool.` / `FileInfo.` / `SpeedFeed.` prefixes so both
+/// `<Name>` and `<Tool.Name>` shapes read identically.
+fn field_name(tag: &str) -> &str {
+    tag.split_once('.').map_or(tag, |(_, rest)| rest)
+}
+
+fn find_field<'a>(node: &'a XmlNode, wanted: &str) -> Option<&'a XmlNode> {
+    node.children.iter().find(|c| field_name(&c.tag) == wanted)
+}
+
+fn text_of(node: &XmlNode, wanted: &str) -> Option<String> {
+    find_field(node, wanted)
+        .map(|n| n.text.trim().to_owned())
+        .filter(|s| !s.is_empty())
+}
+
+pub(crate) fn parse(text: &str, unit: Unit) -> Result<Vec<ToolTableEntry>, String> {
+    let root = parse_xml(text).map_err(|e| format!("not a Hurco WinMax .TCM file: {e}"))?;
+    if root.tag != "Hurco_Document" {
+        return Err(format!(
+            "not a Hurco WinMax .TCM file: root element is '<{}>', expected 'Hurco_Document'",
+            root.tag
+        ));
+    }
+    let tools_node = root
+        .child("Tools")
+        .ok_or("not a Hurco WinMax .TCM file: missing <Tools> element")?;
+    let mut seen_numbers: HashSet<u32> = HashSet::new();
+    let mut entries: Vec<ToolTableEntry> = Vec::new();
+    for child in &tools_node.children {
+        if child.tag != "Tool" {
+            continue;
+        }
+        entries.push(parse_tool_node(child, unit, &mut seen_numbers)?);
+    }
+    if entries.is_empty() {
+        return Err("the Hurco .TCM file holds no tools".into());
+    }
+    Ok(entries)
+}
+
+fn parse_tool_node(
+    node: &XmlNode,
+    unit: Unit,
+    seen_numbers: &mut HashSet<u32>,
+) -> Result<ToolTableEntry, String> {
+    let num_str = text_of(node, "Number")
+        .ok_or("Hurco .TCM tool entry is missing <Number>")?;
+    let number: u32 = num_str
+        .parse()
+        .map_err(|_| format!("Hurco .TCM tool entry has invalid <Number> '{num_str}'"))?;
+    if number == 0 || number > 99_999 {
+        return Err(format!(
+            "Hurco .TCM tool T{number}: number is outside 1-99999"
+        ));
+    }
+    if !seen_numbers.insert(number) {
+        return Err(format!("Hurco .TCM tool number T{number} appears twice"));
+    }
+
+    let name = text_of(node, "Name")
+        .ok_or_else(|| format!("Hurco .TCM tool T{number} has no <Name>"))?;
+
+    let type_str = text_of(node, "ToolType")
+        .ok_or_else(|| format!("tool '{name}' (T{number}): missing Hurco <ToolType>"))?;
+    let type_code: i32 = type_str.parse().map_err(|_| {
+        format!("tool '{name}' (T{number}): invalid Hurco ToolType '{type_str}'")
+    })?;
+    let (kind, center_cutting, default_spot_angle) = map_hurco_type(type_code, &name, number)?;
+
+    let dia_val = req_f64(node, "Diameter", &name, number)?;
+    if dia_val <= 0.0 {
+        return Err(format!(
+            "tool '{name}' (T{number}): diameter {dia_val} must be over 0"
+        ));
+    }
+    let dia_mm = to_mm(dia_val, unit);
+    let mut tool = base_tool(kind, dia_mm);
+    tool.center_cutting = center_cutting;
+    if let Some(angle) = default_spot_angle {
+        tool.tip_angle = angle;
+    }
+
+    if let Some(shank_val) = opt_f64(node, "ShankDiameter", &name, number)?
+        && shank_val > 0.0
+    {
+        tool.shank_d = to_mm(shank_val, unit);
+    }
+    let tool_len_mm = opt_f64(node, "ToolLength", &name, number)?
+        .filter(|&v| v > 0.0)
+        .map(|v| to_mm(v, unit));
+    let flute_len_mm = opt_f64(node, "FluteLength", &name, number)?
+        .filter(|&v| v > 0.0)
+        .map(|v| to_mm(v, unit));
+
+    if let Some(fl) = flute_len_mm {
+        tool.flute_len = fl;
+        tool.shank_len = tool_len_mm
+            .map_or((fl * 1.5).max(15.0), |tl| (tl - fl).max(0.0));
+    } else if let Some(tl) = tool_len_mm {
+        tool.flute_len = tl;
+        tool.shank_len = 0.0;
+    }
+    if kind == ToolKind::Probe && tool.flute_len < dia_mm {
+        tool.flute_len = dia_mm;
+    }
+
+    if let Some(abs_gauge) = opt_f64(node, "AbsoluteGaugeLength", &name, number)?
+        && abs_gauge > 0.0
+    {
+        tool.holder_len = to_mm(abs_gauge, unit);
+        tool.holder_d = (tool.shank_d * 2.0).max(20.0);
+    } else {
+        tool.holder_len = 0.0;
+        tool.holder_d = 0.0;
+    }
+
+    if let Some(flutes_str) = text_of(node, "NumberOfFlutes") {
+        let z: u32 = flutes_str.parse().map_err(|_| {
+            format!("tool '{name}' (T{number}): invalid NumberOfFlutes '{flutes_str}'")
+        })?;
+        if (1..=32).contains(&z) {
+            tool.flutes = Some(z);
+        }
+    }
+    if kind == ToolKind::BullNose
+        && let Some(r_val) = opt_f64(node, "TipRadius", &name, number)?
+        && r_val >= 0.0
+    {
+        tool.corner_r = to_mm(r_val, unit);
+    }
+    if let Some(angle_val) = opt_f64(node, "Angle", &name, number)?
+        && angle_val > 0.0
+        && matches!(
+            kind,
+            ToolKind::Taper
+                | ToolKind::Drill
+                | ToolKind::ThreadMill
+                | ToolKind::ThreadMillSingle
+        )
+    {
+        tool.tip_angle = angle_val;
+    }
+    if let Some(pitch_val) = opt_f64(node, "ThreadPitch", &name, number)?
+        && pitch_val > 0.0
+        && matches!(
+            kind,
+            ToolKind::Tap | ToolKind::ThreadMill | ToolKind::ThreadMillSingle
+        )
+    {
+        let pitch_mm = to_mm(pitch_val, unit);
+        tool.pitch = pitch_mm;
+        if kind == ToolKind::ThreadMillSingle {
+            tool.pitch_min = pitch_mm;
+        }
+        if kind == ToolKind::ThreadMill && tool.flute_len < pitch_mm {
+            tool.flute_len = pitch_mm;
+        }
+    }
+    if let Some(vendor) = text_of(node, "Manufacturer") {
+        let trimmed: String = vendor.trim().chars().take(MAX_SHORT).collect();
+        if !trimmed.is_empty() {
+            tool.catalog.vendor = Some(trimmed);
+        }
+    }
+    apply_speed_feeds(node, &mut tool, unit);
+
+    if let Some(why) = tool.why_not_sane() {
+        return Err(format!("tool '{name}' (T{number}): {why}"));
+    }
+    Ok(ToolTableEntry { number, name, tool })
+}
+
+fn req_f64(node: &XmlNode, field: &str, name: &str, number: u32) -> Result<f64, String> {
+    let raw = text_of(node, field)
+        .ok_or_else(|| format!("tool '{name}' (T{number}): missing <{field}>"))?;
+    let v: f64 = raw.parse().map_err(|_| {
+        format!("tool '{name}' (T{number}): invalid <{field}> '{raw}'")
+    })?;
+    if !v.is_finite() {
+        return Err(format!("tool '{name}' (T{number}): non-finite <{field}>"));
+    }
+    Ok(v)
+}
+
+fn opt_f64(node: &XmlNode, field: &str, name: &str, number: u32) -> Result<Option<f64>, String> {
+    let Some(raw) = text_of(node, field) else {
+        return Ok(None);
+    };
+    let v: f64 = raw.parse().map_err(|_| {
+        format!("tool '{name}' (T{number}): invalid <{field}> '{raw}'")
+    })?;
+    if !v.is_finite() {
+        return Err(format!("tool '{name}' (T{number}): non-finite <{field}>"));
+    }
+    Ok(Some(v))
+}
+
+fn apply_speed_feeds(node: &XmlNode, tool: &mut Tool, unit: Unit) {
+    let Some(sfs) = find_field(node, "SpeedFeeds") else { return };
+    let (mut got_rpm, mut got_feed) = (false, false);
+    for sf in &sfs.children {
+        if !got_rpm
+            && let Some(rpm) = text_of(sf, "Speed").and_then(|s| s.parse::<f64>().ok())
+            && rpm.is_finite()
+            && rpm > 0.0
+        {
+            tool.rpm = rpm;
+            got_rpm = true;
+        }
+        if !got_feed {
+            for key in ["FeedRate", "FeedPerMinute", "Feed"] {
+                if let Some(f) = text_of(sf, key).and_then(|s| s.parse::<f64>().ok())
+                    && f.is_finite()
+                    && f > 0.0
+                {
+                    tool.feed = to_mm(f, unit);
+                    got_feed = true;
+                    break;
+                }
+            }
+        }
+        if got_rpm && got_feed {
+            break;
+        }
+    }
+}
+
+/// Map Hurco WinMax `#30001` ToolType codes to CamCraft `ToolKind`; refuse
+/// every Hurco type that CamCraft has no kind for by name, never guessing.
+fn map_hurco_type(
+    code: i32,
+    name: &str,
+    number: u32,
+) -> Result<(ToolKind, bool, Option<f64>), String> {
+    match code {
+        0 => Ok((ToolKind::BullNose, true, None)),
+        2 => Ok((ToolKind::Taper, true, None)),
+        7 => Ok((ToolKind::Taper, true, Some(60.0))),
+        11 => Ok((ToolKind::Drill, true, None)),
+        12 => Ok((ToolKind::Tap, true, None)),
+        13 => Ok((ToolKind::Bore, true, None)),
+        14 => Ok((ToolKind::EndMill, true, None)),
+        15 => Ok((ToolKind::EndMill, false, None)),
+        16 => Ok((ToolKind::BallNose, true, None)),
+        18 => Ok((ToolKind::Probe, false, None)),
+        20 => Ok((ToolKind::Drill, true, Some(90.0))),
+        21 => Ok((ToolKind::Tap, true, None)),
+        22 => Ok((ToolKind::ThreadMill, true, None)),
+        26 => Ok((ToolKind::ThreadMillSingle, true, None)),
+        other => {
+            let label = hurco_unsupported_label(other);
+            Err(format!(
+                "tool '{name}' (T{number}): Hurco tool type {other} ({label}) has no CamCraft tool kind"
+            ))
+        }
+    }
+}
+
+fn hurco_unsupported_label(code: i32) -> &'static str {
+    match code {
+        1 => "Center Drill",
+        3 => "Corner Round Mill",
+        4 => "Counter Bore",
+        5 => "Counter Sink",
+        6 => "Dove Tail Mill",
+        8 => "Keyseat Mill",
+        9 => "Ream",
+        10 => "Custom Tool",
+        17 => "Back Spotface",
+        19 => "Gun Drill",
+        23 => "Taper Radius End Mill",
+        _ => "unsupported Hurco tool type",
+    }
+}
+
+fn camcraft_to_hurco_type(tool: &Tool) -> Result<i32, String> {
+    match tool.kind {
+        ToolKind::BullNose => Ok(0),
+        ToolKind::Taper => Ok(2),
+        ToolKind::Drill => Ok(11),
+        ToolKind::Tap => Ok(12),
+        ToolKind::Bore => Ok(13),
+        ToolKind::EndMill => Ok(if tool.center_cutting { 14 } else { 15 }),
+        ToolKind::BallNose => Ok(16),
+        ToolKind::Probe => Ok(18),
+        ToolKind::ThreadMill => Ok(22),
+        ToolKind::ThreadMillSingle => Ok(26),
+        other => Err(format!("{other} cannot be exported to a Hurco .TCM tool library")),
+    }
+}
+
+pub(crate) fn export(rows: &[ToolTableExportRow<'_>], unit: Unit) -> Result<String, String> {
+    if rows.is_empty() {
+        return Err("the document has no tools to export".into());
+    }
+    let mut out = String::from("\u{FEFF}<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n");
+    out.push_str("<Hurco_Document Version=\"1.1\">\r\n");
+    out.push_str("  <FileInfo>\r\n");
+    out.push_str("    <Language>English</Language>\r\n");
+    out.push_str("  </FileInfo>\r\n");
+    out.push_str("  <Tools>\r\n");
+    for row in rows {
+        let type_code = camcraft_to_hurco_type(row.tool)
+            .map_err(|why| format!("tool '{}': {why}", row.name))?;
+        let id = deterministic_guid(row.number, row.name);
+        let dia = from_mm(row.tool.diameter, unit);
+        let flute_len = from_mm(row.tool.flute_len, unit);
+        let tool_len = from_mm(row.tool.flute_len + row.tool.shank_len, unit);
+        let shank_d = from_mm(row.tool.shank_d, unit);
+        let gauge_len = row
+            .gauge_len
+            .unwrap_or(row.tool.holder_len)
+            .max(0.0);
+
+        out.push_str(&format!("    <Tool Id=\"{id}\">\r\n"));
+        let mut elem = |tag: &str, val: &str| {
+            out.push_str(&format!("      <{tag}>{val}</{tag}>\r\n"));
+        };
+        elem("Name", &escape_xml(row.name));
+        elem("Number", &row.number.to_string());
+        elem("Diameter", &fmt_num(dia));
+        elem("ToolLength", &fmt_num(tool_len));
+        if shank_d > 0.0 {
+            elem("ShankDiameter", &fmt_num(shank_d));
+        }
+        elem("FluteLength", &fmt_num(flute_len));
+        if gauge_len > 0.0 {
+            elem("AbsoluteGaugeLength", &fmt_num(from_mm(gauge_len, unit)));
+        }
+        elem("ToolType", &type_code.to_string());
+        if let Some(z) = row.tool.flutes {
+            elem("NumberOfFlutes", &z.to_string());
+        }
+        if matches!(row.tool.kind, ToolKind::Tap | ToolKind::ThreadMill | ToolKind::ThreadMillSingle)
+            && row.tool.pitch > 0.0
+        {
+            elem("ThreadPitch", &fmt_num(from_mm(row.tool.pitch, unit)));
+        }
+        if matches!(
+            row.tool.kind,
+            ToolKind::Taper | ToolKind::Drill | ToolKind::ThreadMill | ToolKind::ThreadMillSingle
+        ) && row.tool.tip_angle > 0.0
+        {
+            elem("Angle", &fmt_num(row.tool.tip_angle));
+        }
+        if row.tool.kind == ToolKind::BullNose && row.tool.corner_r > 0.0 {
+            elem("TipRadius", &fmt_num(from_mm(row.tool.corner_r, unit)));
+        }
+        if let Some(vendor) = row.tool.catalog.vendor.as_deref() {
+            elem("Manufacturer", &escape_xml(vendor));
+        }
+        out.push_str("    </Tool>\r\n");
+    }
+    out.push_str("  </Tools>\r\n");
+    out.push_str("</Hurco_Document>\r\n");
+    Ok(out)
+}
+
+fn fmt_num(v: f64) -> String {
+    let rounded = (v * 1_000_000.0).round() / 1_000_000.0;
+    let s = format!("{rounded}");
+    if s == "-0" { "0".into() } else { s }
+}
+
+fn deterministic_guid(number: u32, name: &str) -> String {
+    let mut a: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut b: u64 = 0xaf63_bd4c_8601_b7df;
+    for byte in number.to_le_bytes().iter().chain(name.as_bytes()) {
+        a ^= u64::from(*byte);
+        a = a.wrapping_mul(0x100_0000_01b3);
+        b ^= u64::from(*byte).wrapping_add(0x9e);
+        b = b.wrapping_mul(0x100_0000_01b3);
+    }
+    let b1 = (a >> 32) as u32;
+    let b2 = ((a >> 16) & 0xffff) as u16;
+    let b3 = (((a & 0xffff) as u16) & 0x0fff) | 0x4000;
+    let b4 = (((b >> 48) as u16) & 0x3fff) | 0x8000;
+    let b5 = b & 0x0000_ffff_ffff_ffff;
+    format!("{b1:08x}-{b2:04x}-{b3:04x}-{b4:04x}-{b5:012x}")
+}
diff --git a/crates/tools/src/tool_table_pathpilot.rs b/crates/tools/src/tool_table_pathpilot.rs
new file mode 100644
index 000000000..e278bfcd2
--- /dev/null
+++ b/crates/tools/src/tool_table_pathpilot.rs
@@ -0,0 +1,276 @@
+//! Tormach PathPilot mill tool-table CSV reader and writer (#2566);
+//! specced from Tormach 770MX manual UM10587 §7.6.4 and recorded PathPilot
+//! export column layout.
+
+use std::collections::HashSet;
+
+use camcraft_geometry::geometry::units::Unit;
+
+use crate::tool_table::{ToolTableEntry, ToolTableExportRow, from_mm, to_mm};
+use crate::tool_table_pathpilot_desc::tool_from_description;
+use crate::tools::ToolKind;
+
+/// PathPilot mill tool table accepts tool numbers 1-1000.
+pub const MAX_TOOL_NUMBER: u32 = 1000;
+
+const ROW1_PREFIX: &str = "Mill Tool Table";
+const ROW1_MARKER: &str = "This must be the first row - do not edit";
+const EXPORT_ROW1: &str =
+    "Mill Tool Table,2026-11-18 00:00:00 - v1,This must be the first row - do not edit";
+const HEADER_ROW: &str =
+    "Tool number,Description,Z offset,Diameter,Z offset wear,Diameter wear,Max RPM";
+
+struct Columns {
+    count: usize,
+    number: usize,
+    description: usize,
+    diameter: usize,
+    z_offset: Option<usize>,
+    z_wear: Option<usize>,
+    d_wear: Option<usize>,
+    max_rpm: Option<usize>,
+}
+
+pub(crate) fn parse(text: &str, unit: Unit) -> Result<Vec<ToolTableEntry>, String> {
+    let clean = text.strip_prefix('\u{FEFF}').unwrap_or(text);
+    let mut raw_lines: Vec<(usize, &str)> = Vec::new();
+    for (idx, line) in clean.lines().enumerate() {
+        let trimmed = line.trim_end_matches('\r');
+        if !trimmed.is_empty() {
+            raw_lines.push((idx + 1, trimmed));
+        }
+    }
+    if raw_lines.len() < 2 {
+        return Err(
+            "not a PathPilot mill tool table: expected the marker row and column header row".into(),
+        );
+    }
+    let row1 = parse_csv_row(raw_lines[0].1).map_err(|e| format!("PathPilot row 1: {e}"))?;
+    if row1.first().map(|s| s.trim()) != Some(ROW1_PREFIX)
+        || row1.get(2).map(|s| s.trim()) != Some(ROW1_MARKER)
+    {
+        return Err(
+            "not a PathPilot mill tool table: row 1 must start with 'Mill Tool Table' and end with 'This must be the first row - do not edit'".into(),
+        );
+    }
+    let header = parse_csv_row(raw_lines[1].1)
+        .map_err(|e| format!("PathPilot row {}: {e}", raw_lines[1].0))?;
+    let cols = locate_columns(&header)?;
+
+    let mut seen_numbers: HashSet<u32> = HashSet::new();
+    let mut entries: Vec<ToolTableEntry> = Vec::new();
+    for &(line_no, raw) in &raw_lines[2..] {
+        let fields = parse_csv_row(raw).map_err(|e| format!("PathPilot row {line_no}: {e}"))?;
+        if fields.len() < cols.count {
+            return Err(format!(
+                "PathPilot row {line_no}: expected {expected} columns, got {got}",
+                expected = cols.count,
+                got = fields.len()
+            ));
+        }
+        if let Some(entry) = parse_data_row(line_no, &fields, &cols, unit, &mut seen_numbers)? {
+            entries.push(entry);
+        }
+    }
+    if entries.is_empty() {
+        return Err("the PathPilot tool table holds no tools".into());
+    }
+    Ok(entries)
+}
+
+fn locate_columns(header: &[String]) -> Result<Columns, String> {
+    let find = |want: &str| {
+        header
+            .iter()
+            .position(|h| h.trim().eq_ignore_ascii_case(want))
+    };
+    let number = find("Tool number")
+        .ok_or("not a PathPilot mill tool table: missing 'Tool number' column")?;
+    let description = find("Description")
+        .ok_or("not a PathPilot mill tool table: missing 'Description' column")?;
+    let diameter = find("Diameter")
+        .ok_or("not a PathPilot mill tool table: missing 'Diameter' column")?;
+    Ok(Columns {
+        count: header.len().max(number + 1).max(description + 1).max(diameter + 1),
+        number,
+        description,
+        diameter,
+        z_offset: find("Z offset"),
+        z_wear: find("Z offset wear"),
+        d_wear: find("Diameter wear"),
+        max_rpm: find("Max RPM"),
+    })
+}
+
+fn parse_data_row(
+    line_no: usize,
+    fields: &[String],
+    cols: &Columns,
+    unit: Unit,
+    seen_numbers: &mut HashSet<u32>,
+) -> Result<Option<ToolTableEntry>, String> {
+    let num_raw = fields[cols.number].trim();
+    let number: u32 = num_raw
+        .parse()
+        .map_err(|_| format!("PathPilot row {line_no}: invalid tool number '{num_raw}'"))?;
+    if !(1..=MAX_TOOL_NUMBER).contains(&number) {
+        return Err(format!(
+            "PathPilot row {line_no}: tool number T{number} is outside 1-{MAX_TOOL_NUMBER}"
+        ));
+    }
+    if !seen_numbers.insert(number) {
+        return Err(format!("PathPilot row {line_no}: tool number T{number} appears twice"));
+    }
+
+    let desc = fields[cols.description].trim();
+    let label = if desc.is_empty() { format!("T{number}") } else { format!("T{number} ('{desc}')") };
+    let dia_raw = fields[cols.diameter].trim();
+    let dia_val = parse_finite_f64(dia_raw, "Diameter", &label, line_no)?;
+    if dia_val < 0.0 {
+        return Err(format!("PathPilot row {line_no} tool {label}: negative diameter {dia_val}"));
+    }
+    for (name, idx) in [
+        ("Z offset", cols.z_offset),
+        ("Z offset wear", cols.z_wear),
+        ("Diameter wear", cols.d_wear),
+        ("Max RPM", cols.max_rpm),
+    ] {
+        if let Some(i) = idx {
+            let v = fields[i].trim();
+            if !v.is_empty() {
+                parse_finite_f64(v, name, &label, line_no)?;
+            }
+        }
+    }
+    if desc.is_empty() && dia_val == 0.0 {
+        return Ok(None);
+    }
+    if dia_val == 0.0 {
+        return Err(format!("PathPilot row {line_no} tool {label}: diameter must be over 0"));
+    }
+    let dia_mm = to_mm(dia_val, unit);
+    let max_rpm = cols
+        .max_rpm
+        .and_then(|i| fields[i].trim().parse::<f64>().ok())
+        .unwrap_or(0.0);
+
+    let name = if desc.is_empty() { format!("Tool T{number}") } else { desc.to_owned() };
+    let tool = tool_from_description(&name, dia_mm, max_rpm, unit, line_no)?;
+    if let Some(why) = tool.why_not_sane() {
+        return Err(format!("PathPilot row {line_no} tool '{name}': {why}"));
+    }
+    Ok(Some(ToolTableEntry { number, name, tool }))
+}
+
+fn parse_finite_f64(raw: &str, col: &str, label: &str, line_no: usize) -> Result<f64, String> {
+    let val: f64 = raw
+        .parse()
+        .map_err(|_| format!("PathPilot row {line_no} tool {label}: invalid {col} '{raw}'"))?;
+    if !val.is_finite() {
+        return Err(format!("PathPilot row {line_no} tool {label}: non-finite {col} '{raw}'"));
+    }
+    Ok(val)
+}
+
+pub(crate) fn export(rows: &[ToolTableExportRow<'_>], unit: Unit) -> Result<String, String> {
+    if rows.is_empty() {
+        return Err("the document has no tools to export".into());
+    }
+    let mut out = String::new();
+    out.push_str(EXPORT_ROW1);
+    out.push_str("\r\n");
+    out.push_str(HEADER_ROW);
+    out.push_str("\r\n");
+    for row in rows {
+        if !is_mill_table_kind(row.tool.kind) {
+            return Err(format!(
+                "tool '{}': {} cannot be exported to a PathPilot mill tool table",
+                row.name, row.tool.kind
+            ));
+        }
+        if !(1..=MAX_TOOL_NUMBER).contains(&row.number) {
+            return Err(format!(
+                "tool '{}': tool number T{} exceeds PathPilot's 1-{MAX_TOOL_NUMBER} tool table",
+                row.name, row.number
+            ));
+        }
+        let dia = from_mm(row.tool.diameter, unit);
+        let desc = csv_escape(row.name);
+        out.push_str(&format!(
+            "{},{},0.0000000,{:.7},0.0000000,0.0000000,0.0\r\n",
+            row.number, desc, dia
+        ));
+    }
+    Ok(out)
+}
+
+fn is_mill_table_kind(kind: ToolKind) -> bool {
+    matches!(
+        kind,
+        ToolKind::EndMill
+            | ToolKind::BallNose
+            | ToolKind::BullNose
+            | ToolKind::Drill
+            | ToolKind::Tap
+            | ToolKind::Bore
+            | ToolKind::Taper
+            | ToolKind::Probe
+            | ToolKind::ThreadMill
+            | ToolKind::ThreadMillSingle
+    )
+}
+
+fn csv_escape(field: &str) -> String {
+    if field.contains([',', '"', '\r', '\n']) {
+        let mut s = String::with_capacity(field.len() + 2);
+        s.push('"');
+        for ch in field.chars() {
+            if ch == '"' {
+                s.push_str("\"\"");
+            } else {
+                s.push(ch);
+            }
+        }
+        s.push('"');
+        s
+    } else {
+        field.to_owned()
+    }
+}
+
+fn parse_csv_row(line: &str) -> Result<Vec<String>, String> {
+    let mut fields = Vec::new();
+    let mut cur = String::new();
+    let mut chars = line.chars().peekable();
+    let mut in_quotes = false;
+    let mut field_start = true;
+    while let Some(ch) = chars.next() {
+        if in_quotes {
+            if ch == '"' {
+                if chars.peek() == Some(&'"') {
+                    chars.next();
+                    cur.push('"');
+                } else {
+                    in_quotes = false;
+                }
+            } else {
+                cur.push(ch);
+            }
+            field_start = false;
+        } else if ch == '"' && field_start {
+            in_quotes = true;
+            field_start = false;
+        } else if ch == ',' {
+            fields.push(std::mem::take(&mut cur));
+            field_start = true;
+        } else {
+            cur.push(ch);
+            field_start = false;
+        }
+    }
+    if in_quotes {
+        return Err("unclosed quote in CSV row".into());
+    }
+    fields.push(cur);
+    Ok(fields)
+}
diff --git a/crates/tools/src/tool_table_pathpilot_desc.rs b/crates/tools/src/tool_table_pathpilot_desc.rs
new file mode 100644
index 000000000..8aa9c26a4
--- /dev/null
+++ b/crates/tools/src/tool_table_pathpilot_desc.rs
@@ -0,0 +1,170 @@
+//! PathPilot tool-description parser (#2566): extracts optional tool
+//! kind, corner radius `R:`, length of cut `loc:`, flute count `<n>FL`,
+//! tool material, and Tormach `[part]` number from a PathPilot CSV
+//! Description string.
+
+use camcraft_geometry::geometry::units::Unit;
+
+use crate::catalog_fields::MAX_SHORT;
+use crate::cutting::ToolMaterial;
+use crate::tool_table::{base_tool, to_mm};
+use crate::tools::{Tool, ToolKind};
+
+pub(crate) fn tool_from_description(
+    desc: &str,
+    diameter_mm: f64,
+    max_rpm: f64,
+    unit: Unit,
+    line_no: usize,
+) -> Result<Tool, String> {
+    let lower = desc.to_ascii_lowercase();
+    let (mut kind, center_cutting) = infer_kind(&lower);
+    let mut tool = base_tool(kind, diameter_mm);
+    tool.center_cutting = center_cutting;
+
+    // Negative Max RPM (such as -2.0 on T99 probes) is a PathPilot marker, not a speed.
+    if max_rpm.is_finite() && max_rpm > 0.0 {
+        tool.rpm = max_rpm;
+    }
+    if let Some(flutes) = parse_flutes(&lower) {
+        tool.flutes = Some(flutes);
+    }
+    if lower.contains("carbide") {
+        tool.tool_material = Some(ToolMaterial::Carbide);
+    } else if lower.contains("hss") {
+        tool.tool_material = Some(ToolMaterial::Hss);
+    }
+    if let Some(part) = parse_part_number(desc) {
+        tool.catalog.part_number = Some(part);
+    }
+    if let Some(loc_val) = parse_tagged_number(&lower, "loc:") {
+        let loc_mm = to_mm(loc_val, unit);
+        if loc_mm < 0.0 {
+            return Err(format!("PathPilot row {line_no} tool '{desc}': negative loc:{loc_val}"));
+        }
+        if loc_mm > 0.0 {
+            tool.flute_len = loc_mm;
+            tool.shank_len = (loc_mm * 1.5).max(15.0);
+        }
+    }
+    if let Some(r_val) = parse_tagged_number(&lower, "r:") {
+        let r_mm = to_mm(r_val, unit);
+        if r_mm < 0.0 {
+            return Err(format!("PathPilot row {line_no} tool '{desc}': negative R:{r_val}"));
+        }
+        if r_mm > 0.0 {
+            if kind == ToolKind::EndMill {
+                kind = ToolKind::BullNose;
+                tool.kind = ToolKind::BullNose;
+            }
+            if matches!(kind, ToolKind::BullNose | ToolKind::BallNose) {
+                tool.corner_r = r_mm;
+            }
+        }
+    }
+    if kind == ToolKind::Probe && tool.flute_len < diameter_mm {
+        tool.flute_len = diameter_mm;
+    }
+    Ok(tool)
+}
+
+fn infer_kind(lower: &str) -> (ToolKind, bool) {
+    if lower.contains("probe") {
+        (ToolKind::Probe, false)
+    } else if lower.contains("ball") {
+        (ToolKind::BallNose, true)
+    } else if lower.contains("bull") {
+        (ToolKind::BullNose, true)
+    } else if lower.contains("chamfer")
+        || lower.contains("engrav")
+        || lower.contains("v-bit")
+        || lower.contains("vbit")
+    {
+        (ToolKind::Taper, true)
+    } else if lower.contains("thread mill") || lower.contains("threadmill") {
+        if lower.contains("single") {
+            (ToolKind::ThreadMillSingle, true)
+        } else {
+            (ToolKind::ThreadMill, true)
+        }
+    } else if has_word(lower, "tap") {
+        (ToolKind::Tap, true)
+    } else if lower.contains("boring") || has_word(lower, "bore") {
+        (ToolKind::Bore, true)
+    } else if lower.contains("drill") {
+        (ToolKind::Drill, true)
+    } else if lower.contains("slitting saw")
+        || lower.contains("face mill")
+        || lower.contains("facemill")
+        || lower.contains("shell mill")
+    {
+        (ToolKind::EndMill, false)
+    } else {
+        (ToolKind::EndMill, true)
+    }
+}
+
+fn has_word(haystack: &str, word: &str) -> bool {
+    haystack
+        .split(|c: char| !c.is_ascii_alphanumeric())
+        .any(|tok| tok == word)
+}
+
+fn parse_tagged_number(lower: &str, tag: &str) -> Option<f64> {
+    let mut start = 0;
+    while let Some(pos) = lower[start..].find(tag) {
+        let abs = start + pos;
+        let boundary_ok = abs == 0
+            || lower[..abs]
+                .chars()
+                .next_back()
+                .is_some_and(|c| c.is_whitespace() || c == ',');
+        let after = &lower[abs + tag.len()..];
+        if boundary_ok {
+            let num_str: String = after
+                .chars()
+                .take_while(|c| c.is_ascii_digit() || matches!(c, '.' | '-' | '+'))
+                .collect();
+            if let Ok(v) = num_str.parse::<f64>()
+                && v.is_finite()
+            {
+                return Some(v);
+            }
+        }
+        start = abs + tag.len();
+    }
+    None
+}
+
+fn parse_flutes(lower: &str) -> Option<u32> {
+    for tok in lower.split_whitespace() {
+        let clean = tok.trim_matches(|c: char| !c.is_ascii_alphanumeric());
+        if let Some(num) = clean.strip_suffix("fl")
+            && !num.is_empty()
+            && num.chars().all(|c| c.is_ascii_digit())
+            && let Ok(n) = num.parse::<u32>()
+            && (1..=32).contains(&n)
+        {
+            return Some(n);
+        }
+    }
+    None
+}
+
+fn parse_part_number(desc: &str) -> Option<String> {
+    let mut last: Option<String> = None;
+    let mut rest = desc;
+    while let Some(open) = rest.find('[') {
+        let after = &rest[open + 1..];
+        let Some(close) = after.find(']') else { break };
+        let inner = after[..close].trim();
+        if !inner.is_empty()
+            && inner.len() <= MAX_SHORT
+            && inner.chars().all(|c| c.is_ascii_digit())
+        {
+            last = Some(inner.to_owned());
+        }
+        rest = &after[close + 1..];
+    }
+    last
+}
diff --git a/crates/tools/src/tool_table_xml.rs b/crates/tools/src/tool_table_xml.rs
new file mode 100644
index 000000000..eda92c57e
--- /dev/null
+++ b/crates/tools/src/tool_table_xml.rs
@@ -0,0 +1,187 @@
+//! Minimal pure-Rust XML tree reader and text escaper for Hurco `.TCM`
+//! files (#2566); implemented directly from the W3C XML 1.0 grammar with
+//! no external dependencies.
+
+/// One XML element with its tag name, text content, and children.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct XmlNode {
+    pub tag: String,
+    pub text: String,
+    pub children: Vec<XmlNode>,
+}
+
+impl XmlNode {
+    pub(crate) fn child(&self, name: &str) -> Option<&XmlNode> {
+        self.children.iter().find(|c| c.tag == name)
+    }
+}
+
+pub(crate) fn escape_xml(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for ch in s.chars() {
+        match ch {
+            '&' => out.push_str("&amp;"),
+            '<' => out.push_str("&lt;"),
+            '>' => out.push_str("&gt;"),
+            '"' => out.push_str("&quot;"),
+            '\'' => out.push_str("&apos;"),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+fn decode_entities(raw: &str) -> Result<String, String> {
+    let mut out = String::with_capacity(raw.len());
+    let mut rest = raw;
+    while let Some(amp) = rest.find('&') {
+        out.push_str(&rest[..amp]);
+        let after = &rest[amp + 1..];
+        let Some(semi) = after.find(';') else {
+            return Err(format!("unterminated XML entity near '{}'", &rest[amp..rest.len().min(amp + 20)]));
+        };
+        let entity = &after[..semi];
+        match entity {
+            "amp" => out.push('&'),
+            "lt" => out.push('<'),
+            "gt" => out.push('>'),
+            "quot" => out.push('"'),
+            "apos" => out.push('\''),
+            _ if entity.starts_with("#x") || entity.starts_with("#X") => {
+                let code = u32::from_str_radix(&entity[2..], 16)
+                    .map_err(|_| format!("invalid XML numeric entity '&{entity};'"))?;
+                let ch = char::from_u32(code)
+                    .ok_or_else(|| format!("invalid XML character code '&{entity};'"))?;
+                out.push(ch);
+            }
+            _ if entity.starts_with('#') => {
+                let code: u32 = entity[1..]
+                    .parse()
+                    .map_err(|_| format!("invalid XML numeric entity '&{entity};'"))?;
+                let ch = char::from_u32(code)
+                    .ok_or_else(|| format!("invalid XML character code '&{entity};'"))?;
+                out.push(ch);
+            }
+            other => return Err(format!("unsupported XML entity '&{other};'")),
+        }
+        rest = &after[semi + 1..];
+    }
+    out.push_str(rest);
+    Ok(out)
+}
+
+/// Parse one root XML element, skipping BOM, declarations, comments, and whitespace.
+pub(crate) fn parse_xml(input: &str) -> Result<XmlNode, String> {
+    let mut pos = input.strip_prefix('\u{FEFF}').unwrap_or(input);
+    loop {
+        pos = pos.trim_start();
+        if pos.starts_with("<?") {
+            let Some(end) = pos.find("?>") else {
+                return Err("unterminated XML processing instruction".into());
+            };
+            pos = &pos[end + 2..];
+        } else if pos.starts_with("<!--") {
+            let Some(end) = pos.find("-->") else {
+                return Err("unterminated XML comment".into());
+            };
+            pos = &pos[end + 3..];
+        } else {
+            break;
+        }
+    }
+    if !pos.starts_with('<') {
+        return Err("not an XML file (missing root '<' element)".into());
+    }
+    let (node, rest) = parse_element(pos)?;
+    if !rest.trim().is_empty() && !rest.trim_start().starts_with("<!--") {
+        return Err("unexpected trailing content after root XML element".into());
+    }
+    Ok(node)
+}
+
+fn parse_element(input: &str) -> Result<(XmlNode, &str), String> {
+    let after_lt = input.strip_prefix('<').ok_or("expected '<'")?;
+    let (tag, mut rest) = take_name(after_lt)?;
+    loop {
+        rest = rest.trim_start();
+        if let Some(after_self) = rest.strip_prefix("/>") {
+            return Ok((
+                XmlNode { tag: tag.to_owned(), text: String::new(), children: Vec::new() },
+                after_self,
+            ));
+        }
+        if let Some(after_gt) = rest.strip_prefix('>') {
+            rest = after_gt;
+            break;
+        }
+        let (key, r1) = take_name(rest)?;
+        let r1 = r1.trim_start();
+        let r1 = r1
+            .strip_prefix('=')
+            .ok_or_else(|| format!("expected '=' after attribute '{key}' on <{tag}>"))?
+            .trim_start();
+        let quote = r1
+            .chars()
+            .next()
+            .filter(|c| *c == '"' || *c == '\'')
+            .ok_or_else(|| format!("expected quoted value for attribute '{key}' on <{tag}>"))?;
+        let after_q = &r1[1..];
+        let Some(end_q) = after_q.find(quote) else {
+            return Err(format!("unclosed attribute '{key}' on <{tag}>"));
+        };
+        let _ = decode_entities(&after_q[..end_q])?;
+        rest = &after_q[end_q + 1..];
+    }
+
+    let mut text = String::new();
+    let mut children = Vec::new();
+    loop {
+        let Some(lt) = rest.find('<') else {
+            return Err(format!("unclosed XML element <{tag}>"));
+        };
+        if lt > 0 {
+            text.push_str(&decode_entities(&rest[..lt])?);
+        }
+        rest = &rest[lt..];
+        if let Some(after_close) = rest.strip_prefix("</") {
+            let (close_tag, after_name) = take_name(after_close)?;
+            let after_ws = after_name.trim_start();
+            let after_gt = after_ws
+                .strip_prefix('>')
+                .ok_or_else(|| format!("expected '>' in closing tag </{close_tag}>"))?;
+            if close_tag != tag {
+                return Err(format!("mismatched XML closing tag </{close_tag}> for <{tag}>"));
+            }
+            return Ok((XmlNode { tag: tag.to_owned(), text, children }, after_gt));
+        }
+        if rest.starts_with("<!--") {
+            let Some(end) = rest.find("-->") else {
+                return Err("unterminated XML comment".into());
+            };
+            rest = &rest[end + 3..];
+            continue;
+        }
+        if let Some(after_cdata) = rest.strip_prefix("<![CDATA[") {
+            let Some(end) = after_cdata.find("]]>") else {
+                return Err("unterminated XML CDATA section".into());
+            };
+            text.push_str(&after_cdata[..end]);
+            rest = &after_cdata[end + 3..];
+            continue;
+        }
+        let (child, after_child) = parse_element(rest)?;
+        children.push(child);
+        rest = after_child;
+    }
+}
+
+fn take_name(s: &str) -> Result<(&str, &str), String> {
+    let end = s
+        .char_indices()
+        .find(|(_, c)| c.is_whitespace() || matches!(c, '>' | '/' | '=' | '<'))
+        .map_or(s.len(), |(i, _)| i);
+    if end == 0 {
+        return Err("missing XML tag or attribute name".into());
+    }
+    Ok((&s[..end], &s[end..]))
+}
diff --git a/crates/tools/tests/tool_table.rs b/crates/tools/tests/tool_table.rs
new file mode 100644
index 000000000..41382d676
--- /dev/null
+++ b/crates/tools/tests/tool_table.rs
@@ -0,0 +1,203 @@
+//! #2566: pure unit/integration tests for Tormach PathPilot (.csv) and
+//! Hurco WinMax (.TCM) tool tables in `camcraft_tools`.
+//!
+//! Provenance: our own tests over the documented PathPilot CSV and
+//! Hurco WinMax .TCM formats.
+
+use camcraft_geometry::geometry::units::Unit;
+use camcraft_tools::cutting::ToolMaterial;
+use camcraft_tools::tool_table::{
+    ToolTableExportRow, ToolTableFormat, detect_format, export_controller_table,
+    parse_controller_table, parse_unit,
+};
+use camcraft_tools::tools::{Tool, ToolKind};
+use std::path::Path;
+
+const PATHPILOT_SAMPLE: &str = "\
+Mill Tool Table,2026-11-18 19:09:05 - v1,This must be the first row - do not edit\r\n\
+Tool number,Description,Z offset,Diameter,Z offset wear,Diameter wear,Max RPM\r\n\
+1,endmill [1/8] 2FL R:0.000 loc:0.375 carbide dia:0.125 [37368],1.0000000,0.1250000,0.0000000,0.0000000,0.0\r\n\
+2,,0.0000000,0.0000000,0.0000000,0.0000000,0.0\r\n\
+8,Slitting Saw [1/8] 30FL R:0.000 uncoated carbide dia:3.000 [34993],5.0000000,3.0000000,0.0000000,0.0000000,0.0\r\n\
+10,drill dia:0.500,2.0000000,0.5000000,0.0000000,0.0000000,0.0\r\n\
+99,,3.0000000,0.0000000,0.0000000,0.0000000,-2.0\r\n";
+
+#[test]
+fn detects_formats_by_extension_and_content() {
+    assert_eq!(detect_format(Path::new("tools.csv"), None), Some(ToolTableFormat::PathPilot));
+    assert_eq!(detect_format(Path::new("atc_mtc.TCM"), None), Some(ToolTableFormat::Hurco));
+    assert_eq!(detect_format(Path::new("shop.camtools"), None), Some(ToolTableFormat::CamTools));
+    assert_eq!(
+        detect_format(Path::new("unknown.txt"), Some(PATHPILOT_SAMPLE)),
+        Some(ToolTableFormat::PathPilot)
+    );
+    assert_eq!(
+        detect_format(Path::new("unknown.xml"), Some("<Hurco_Document Version=\"1.1\"/>")),
+        Some(ToolTableFormat::Hurco)
+    );
+    assert_eq!(parse_unit("inch"), Ok(Unit::Inches));
+    assert_eq!(parse_unit("mm"), Ok(Unit::Millimeters));
+    assert!(parse_unit("furlongs").is_err());
+}
+
+#[test]
+fn pathpilot_parses_sample_and_ignores_placeholder_z_offset_and_negative_probe_marker() {
+    let entries = parse_controller_table(ToolTableFormat::PathPilot, PATHPILOT_SAMPLE, Unit::Inches)
+        .expect("sample parses");
+    assert_eq!(entries.len(), 3);
+
+    assert_eq!(entries[0].number, 1);
+    assert_eq!(entries[0].name, "endmill [1/8] 2FL R:0.000 loc:0.375 carbide dia:0.125 [37368]");
+    assert_eq!(entries[0].tool.kind, ToolKind::EndMill);
+    assert!((entries[0].tool.diameter - 3.175).abs() < 1e-9);
+    assert!((entries[0].tool.flute_len - 0.375 * 25.4).abs() < 1e-9);
+    assert_eq!(entries[0].tool.flutes, Some(2));
+    assert_eq!(entries[0].tool.tool_material, Some(ToolMaterial::Carbide));
+    assert_eq!(entries[0].tool.catalog.part_number.as_deref(), Some("37368"));
+    // Z offset 1.0 in must not become stick-out (flute_len stays 0.375 in).
+    assert!((entries[0].tool.flute_len - 25.4).abs() > 1.0);
+
+    assert_eq!(entries[1].number, 8);
+    assert_eq!(entries[1].tool.flutes, Some(30));
+    assert!(!entries[1].tool.center_cutting);
+    assert_eq!(entries[1].tool.catalog.part_number.as_deref(), Some("34993"));
+
+    assert_eq!(entries[2].number, 10);
+    assert_eq!(entries[2].tool.kind, ToolKind::Drill);
+    assert!((entries[2].tool.diameter - 12.7).abs() < 1e-9);
+
+    // A configured probe with a non-empty description and -2.0 Max RPM parses cleanly.
+    let probe_csv = "\
+Mill Tool Table,2026-11-18 - v1,This must be the first row - do not edit\n\
+Tool number,Description,Z offset,Diameter,Z offset wear,Diameter wear,Max RPM\n\
+99,Passive Probe,3.0000000,0.1574803,0.0,0.0,-2.0\n";
+    let probe = parse_controller_table(ToolTableFormat::PathPilot, probe_csv, Unit::Inches)
+        .expect("probe parses");
+    assert_eq!(probe[0].tool.kind, ToolKind::Probe);
