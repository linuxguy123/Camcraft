+    // Every Hurco type without a CamCraft kind must refuse by name, never guess.
+    for (code, label) in [(1, "Center Drill"), (3, "Corner Round"), (6, "Dove Tail"), (8, "Keyseat"), (9, "Ream"), (17, "Back Spotface")] {
+        let bad = format!(
