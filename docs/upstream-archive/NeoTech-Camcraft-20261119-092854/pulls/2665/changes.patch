diff --git a/crates/app/src/prefs.rs b/crates/app/src/prefs.rs
index 2a74b2e2d..5498ecd89 100644
--- a/crates/app/src/prefs.rs
+++ b/crates/app/src/prefs.rs
@@ -172,3 +172,220 @@ pub fn save(path: &Path, prefs: &ViewPrefs) -> Result<(), String> {
