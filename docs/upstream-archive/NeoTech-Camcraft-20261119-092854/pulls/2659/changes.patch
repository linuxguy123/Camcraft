@@ -233,6 +233,24 @@ fn assert_counterbore_at(path: &camcraft_motion::cl::Toolpath, z: f64, extent: f
     assert!((length - 8.0 * extent).abs() < 0.1, "Z {z}: expected one complete bore lap, got {length}");
