-            })
-        };
-        edges(region).any(|e| walled(e) && near(e))
+        edges(region).any(|e| section.is_some_and(|s| edge_is_wall(e.0, e.1, s)) && near(e))
     } else {
         !crosses_rim(trace, region) && edges(region).any(near)
     }
@@ -349,4 +357,40 @@ mod tests {
