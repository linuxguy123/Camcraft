From 6fd41c6ac42fe770a90b41bc2668871507e2ff7e Mon Sep 17 00:00:00 2001
From: mechatronics-studio
 <67246298+mechatronics-studio@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:37:47 -0700
Subject: [PATCH] fix(ui): the link check reads the clock seam, so the browser
 build compiles

model_link_watch.rs (#2463) took std::time::Instant, but State passes
camcraft_app::clock::Instant, which is web_time::Instant on
wasm32-unknown-unknown: web/build-app-wasm.sh failed with E0308 at
state.rs:3130. The check now reads the clock seam like the rest of the UI.

Fixes #2708

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MLU9aif5zm7mure23AKftd
---
 crates/ui/src/model_link_watch.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/crates/ui/src/model_link_watch.rs b/crates/ui/src/model_link_watch.rs
index de1b313fc..6749fef48 100644
--- a/crates/ui/src/model_link_watch.rs
+++ b/crates/ui/src/model_link_watch.rs
@@ -10,8 +10,10 @@
 
 use std::collections::{HashMap, HashSet};
 use std::path::Path;
-use std::time::{Duration, Instant, SystemTime};
+use std::time::{Duration, SystemTime};
 
+// The clock seam (#31): std's Instant panics in the browser build.
+use camcraft_app::clock::Instant;
 use camcraft_app::model;
 use flecs_ecs::prelude::World;
 
