+#[test]
+fn leaving_the_page_drops_a_located_draft() {
+    SHOW_FORM.with(|c| c.set(true));
+    let mut h = Harness::builder().with_size(Vec2::new(700.0, 600.0)).build_ui_state(swept_frame, with_vise());
