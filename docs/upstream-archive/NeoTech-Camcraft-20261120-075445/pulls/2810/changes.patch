+
+impl UncutRest {
+    pub(super) fn worse(a: Option<Self>, b: Option<Self>) -> Option<Self> {
+        match (a, b) {
+            (Some(x), Some(y)) => Some(if y.depth > x.depth { y } else { x }),
+            (x, y) => x.or(y),
+        }
+    }
