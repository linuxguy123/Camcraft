diff --git a/crates/app/tests/example_catalog.rs b/crates/app/tests/example_catalog.rs
index beaf42c98..44b9e2f89 100644
--- a/crates/app/tests/example_catalog.rs
+++ b/crates/app/tests/example_catalog.rs
@@ -227,3 +227,45 @@ fn every_catalog_case_rebuilds_from_camscript() {
 
     let _ = fs::remove_dir_all(&scratch);
 }
+
+/// The G word and the Z word of each motion block of a posted program.
+fn motion_blocks(nc: &str) -> Vec<(&str, f64)> {
+    nc.lines()
+        .filter_map(|line| {
+            let mut words = line.split_whitespace();
+            let g = words.next().filter(|w| matches!(*w, "G00" | "G01" | "G02" | "G03"))?;
+            let z = words.find_map(|w| w.strip_prefix('Z'))?.parse::<f64>().ok()?;
+            Some((g, z))
+        })
+        .collect()
+}
+
+/// #2859: the case 2d/contour-tabs posts what its README says. Each cut
+/// run has a lead-in arc and a linear lead-out. The levels are Z4, Z2 (the
+/// tab top) and Z0. The Z0 level lifts over each of the four tabs.
+#[test]
+fn contour_tabs_case_posts_the_lead_moves_and_the_tab_lifts() {
+    let nc_path = repo("examples/catalog/2d/contour-tabs/contour-tabs.nc");
+    let nc = fs::read_to_string(&nc_path)
+        .unwrap_or_else(|e| panic!("case 2d/contour-tabs must hold {}: {e}", nc_path.display()));
+    let blocks = motion_blocks(&nc);
+
+    // The outline is cut clockwise (G02 corners). Only a lead-in arc turns
+    // the other way (G03).
+    let lead_ins = |z: f64| blocks.iter().filter(|b| b.0 == "G03" && b.1 == z).count();
+    assert_eq!(lead_ins(4.0), 1, "one lead-in arc on the whole ring at Z4");
+    assert_eq!(lead_ins(2.0), 1, "one lead-in arc on the whole ring at Z2, the tab top");
+    assert_eq!(lead_ins(0.0), 4, "one lead-in arc for each run between two tabs at Z0");
+
+    // A lift goes from a cut level to a height above the stock top (Z6).
+    // The block before it is the end of the linear lead-out.
+    let lifts: Vec<usize> =
+        (1..blocks.len()).filter(|&i| blocks[i - 1].1 <= 4.0 && blocks[i].1 > 6.0).collect();
+    assert_eq!(lifts.len(), 6, "two whole rings and four tab runs each end with a lift");
+    for &i in &lifts {
+        assert_eq!(blocks[i - 1].0, "G01", "the block before lift {i} is the linear lead-out");
+    }
+    let tab_lifts = lifts.iter().filter(|&&i| blocks[i - 1].1 == 0.0).count();
+    assert_eq!(tab_lifts, 4, "the Z0 level lifts four times: one lift for each tab");
+    assert!(!blocks.iter().any(|b| b.1 < 0.0), "no block goes below the stock bottom (Z0)");
+}
diff --git a/docs/decisions/2859-contour-tabs-example.md b/docs/decisions/2859-contour-tabs-example.md
new file mode 100644
index 000000000..ac5cba01e
--- /dev/null
+++ b/docs/decisions/2859-contour-tabs-example.md
@@ -0,0 +1,44 @@
+## #2859 - Example case 2d/contour-tabs: one plate, one 2D Contour
+
+**What was decided.** The case `examples/catalog/2d/contour-tabs` is a
+90 x 50 x 6 mm plate with four 10 mm corner chamfers, in a 120 x 80 x 6 mm
+sheet. One 2D Contour cuts the outside with a 6 mm flat end mill. The lead-in
+is a 3 mm arc. The lead-out is a 4 mm line. There are four tabs, 8 mm wide
+and 2 mm high. The stepdown is 2 mm, so the levels are Z4, Z2 and Z0.
+
+**Why.**
+
+- One operation keeps the program short (104 lines). A reader sees each lead
+  move and each tab lift without a search.
+- The outline has only straight edges. Each `G03` block is then a lead-in,
+  and each `G02` block is a corner roll. The pinning test counts them.
+- An arc lead-in and a linear lead-out are two different shapes. The program
+  shows that the two parameters are independent.
+- The sheet is as thick as the plate. The contour goes to the sheet bottom,
+  and the tabs are the only material that holds the plate. This is the usual
+  cut-out job.
+- The stepdown equals the tab height. The tab top (Z2) is a level of the
+  stepdown ladder, and no extra level is added (#2579).
+- The model is a prism that the generator script writes. No outside geometry
+  is used (Clean-Room Protocol).
+
+**Considered and dropped.**
+
+- A plate with holes and a Drill operation. The seed case `2d/first-part`
+  shows Drill. A second operation hides the lead moves and the tab lifts.
+- A rectangle. The chamfers give corners that are not 90 degrees and make
+  the geometry original for this case.
+- A stock top above the plate top with a Face operation. It adds levels and
+  an operation that this case does not show.
+- A lead-in written as `lead: { arc: { radius: 3.0 } }`. `add_operation`
+  refuses it: the patch merges with the seeded linear lead, and the result
+  has two shapes. The script writes `linear: null` with the arc. The refusal
+  message does not name the cause; #2876 is the bug for it.
+
+**Cost to change later.** Small. Change `build.camscript`, run
+`cargo xtask catalog --case 2d/contour-tabs`, and update the counts in the
+test `contour_tabs_case_posts_the_lead_moves_and_the_tab_lifts`.
+
+**Pinned by.** `crates/app/tests/example_catalog.rs`:
+`contour_tabs_case_posts_the_lead_moves_and_the_tab_lifts`, and the two
+catalog tests that read each case.
