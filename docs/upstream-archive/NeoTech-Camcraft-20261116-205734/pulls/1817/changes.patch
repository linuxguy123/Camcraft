diff --git a/crates/app/src/operation/rest_op.rs b/crates/app/src/operation/rest_op.rs
new file mode 100644
index 000000000..a9715de02
--- /dev/null
+++ b/crates/app/src/operation/rest_op.rs
@@ -0,0 +1,55 @@
+//! Rest machining on the 2D Pocket (#1489): the parameter door's
+//! refusals, said in the generator's own words (`machining2d::rest2d`,
+//! #1446), so an edit is refused when it is made, never first at
+//! Generate.
+//!
+//! Provenance: our own operation laws over this project's rest
+//! generator; no other CAM product's code, text or output consulted.
+
+use crate::machining2d::{GenError, RestParams, rest_strategy};
+
+use super::OpParams;
+
+/// Rest machining beside pre-drilled entry: the rest pass enters its
+/// own areas and does not read the holes yet, so one of them is turned
+/// off rather than one silently dropped.
+pub const REST_PREDRILLED: &str =
+    "rest machining does not use pre-drilled entry yet - turn off one of the two on this Pocket";
+
+/// The generator's refusal text, without its "invalid machining
+/// parameters" heading.
+fn said(e: GenError) -> String {
+    match e {
+        GenError::Invalid(s) | GenError::Empty(s) => s,
+        other => other.to_string(),
+    }
+}
+
+/// The rest group of `p`, when it is a 2D Pocket with rest machining on.
+pub fn rest_of(p: &OpParams) -> Option<&RestParams> {
+    match p {
+        OpParams::Pocket { rest: Some(r), .. } => Some(r),
+        _ => None,
+    }
+}
+
+/// The refusal of a Pocket's rest group that needs no tool: values the
+/// generator refuses, a strategy it does not run, pre-drilled entry.
+pub fn rest_refusal(p: &OpParams) -> Option<String> {
+    let OpParams::Pocket { rest: Some(r), strategy, links, .. } = p else {
+        return None;
+    };
+    if let Err(e) = r.validate_alone() {
+        return Some(said(e));
+    }
+    if let Err(e) = rest_strategy(*strategy) {
+        return Some(said(e));
+    }
+    links.approach.predrilled.then(|| REST_PREDRILLED.to_string())
+}
+
+/// The refusal of a Pocket's rest group against the tool it mounts: the
+/// previous tool must be larger than `tool_diameter`.
+pub fn rest_tool_refusal(p: &OpParams, tool_diameter: f64) -> Option<String> {
+    rest_of(p).and_then(|r| r.validate(tool_diameter).err()).map(said)
+}
diff --git a/crates/app/src/operation/rest_op_tests.rs b/crates/app/src/operation/rest_op_tests.rs
new file mode 100644
index 000000000..e36ef95b1
--- /dev/null
+++ b/crates/app/src/operation/rest_op_tests.rs
@@ -0,0 +1,59 @@
+//! #1489: the 2D Pocket's rest group in the operation stamp - written
+//! only when on (a pocket without it writes no byte for it), and every
+//! value of the group moves it, so a cached path is never served to
+//! another previous tool.
+
+use std::hash::Hasher;
+
+use crate::machining2d::{PocketStrategy, RestParams};
+use crate::machining3d::Entry3D;
+use crate::operation::{Height, OpParams};
+
+fn pocket(rest: Option<RestParams>) -> OpParams {
+    OpParams::Pocket {
+        rest,
+        blend_radius: None,
+        links: crate::links::Links::PLANAR,
+        tilt: None,
+        stepover: 1.5,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(5.0),
+        retract_z: None,
+        top_z: Height::fixed(0.0),
+        bottom_z: Height::fixed(-4.0),
+        stepdown: 2.0,
+        feed: 400.0,
+        plunge_feed: 80.0,
+        climb: true,
+        strategy: PocketStrategy::Waterline,
+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+        optimal_load: crate::load::DEFAULT_OPTIMAL_LOAD,
+        blend_turns: false,
+    }
+}
+
+const PREV: RestParams =
+    RestParams { previous_tool_diameter: 12.0, previous_corner_radius: 0.0, previous_stock_to_leave: 0.0, allowance: 0.0 };
+
+#[test]
+fn the_rest_group_moves_the_stamp() {
+    let world = crate::world::new_world();
+    let digest = |p: &OpParams| {
+        let mut h = std::hash::DefaultHasher::new();
+        p.stamp_with(&world, None, None, &mut h);
+        h.finish()
+    };
+    let off = digest(&pocket(None));
+    let on = digest(&pocket(Some(PREV)));
+    assert_ne!(off, on, "rest machining on must not share the plain pocket's stamp");
+    for other in [
+        RestParams { previous_tool_diameter: 10.0, ..PREV },
+        RestParams { previous_corner_radius: 1.0, ..PREV },
+        RestParams { previous_stock_to_leave: 0.2, ..PREV },
+        RestParams { allowance: 0.1, ..PREV },
+    ] {
+        assert_ne!(on, digest(&pocket(Some(other))), "{other:?} must move the stamp");
+    }
+    assert_eq!(on, digest(&pocket(Some(PREV))), "the stamp is a function");
+}
