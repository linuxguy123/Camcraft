     pub fn is_sane(&self) -> bool {
-        self.a_deg.is_finite()
-            && self.b_deg.is_finite()
-            && (-90.0..=90.0).contains(&self.a_deg)
-            && (-180.0..=180.0).contains(&self.b_deg)
-            && self.origin.iter().all(|v| v.is_finite() && v.abs() < 1e9)
+        self.refusal().is_none()
     }
 }
 
