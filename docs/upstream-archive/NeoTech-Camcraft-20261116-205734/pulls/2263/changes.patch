From 018aef2b4c24e8820cc8802728d05eedfdfe7c72 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 16 Nov 2026 20:32:01 +0100
Subject: [PATCH 1/2] fix(test): build CuttingRow with plain() in the wire tool
 tests

PR #2140 added two tests that build a CuttingRow literal with a bare
WorkMaterial and no step fields. PR #2101 made `material` an Option and
added `stepdown` and `stepover`. Each PR built alone; after the two
merges the batch build of main failed in camcraft-tools (lib test) and
camcraft-app (test wire_tool). Both tests now use CuttingRow::plain and
keep their "EDM conditions" assertions.

Fixes #2244

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/wire_tool.rs | 7 +------
 crates/tools/src/wire.rs      | 2 +-
 2 files changed, 2 insertions(+), 7 deletions(-)

diff --git a/crates/app/tests/wire_tool.rs b/crates/app/tests/wire_tool.rs
index 7c1a5f7a0..d42596d8c 100644
--- a/crates/app/tests/wire_tool.rs
+++ b/crates/app/tests/wire_tool.rs
@@ -103,12 +103,7 @@ fn wire_tool_command_refuses_bad_rpm_diameter_corner_and_cutting_rows_by_name()
     let err = AddTool::new(&world, "BadCorner", rounded).err().expect("corner refused").to_string();
     assert!(err.contains("corner radius"), "{err}");
 
-    let row = camcraft_app::tool_cutting_rows::CuttingRow {
-        material: tools::WorkMaterial::MildSteel,
-        rpm: 0.0,
-        feed: 50.0,
-        waterjet: None,
-    };
+    let row = camcraft_app::tool_cutting_rows::CuttingRow::plain(Some(tools::WorkMaterial::MildSteel), 0.0, 50.0);
     let with_rows = Tool { cutting: vec![row], ..valid };
     let err = AddTool::new(&world, "BadRows", with_rows).err().expect("cutting rows refused").to_string();
     assert!(err.contains("EDM conditions"), "{err}");
diff --git a/crates/tools/src/wire.rs b/crates/tools/src/wire.rs
index 763d0b9a6..fac739b9e 100644
--- a/crates/tools/src/wire.rs
+++ b/crates/tools/src/wire.rs
@@ -100,7 +100,7 @@ mod tests {
         assert!(round.torch_refusal().is_some_and(|s| s.contains("corner radius")));
 
         let row = Tool {
-            cutting: vec![CuttingRow { material: WorkMaterial::MildSteel, rpm: 0.0, feed: 100.0, waterjet: None }],
+            cutting: vec![CuttingRow::plain(Some(WorkMaterial::MildSteel), 0.0, 100.0)],
             ..w
         };
         assert!(!row.is_sane());

From 84605711c04cc90775792267e84d86e241b0d319 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 16 Nov 2026 21:33:18 +0100
Subject: [PATCH 2/2] test(kernel): pin the STEP agreement row of fig8.step

PR #2215 added testdata/models/fig8.step without a row in the STEP
agreement bench, so step_files_agree_or_refuse_by_name fails on main.
The new row pins the reading: solidcore refuses the file at a pcurve
(as fillet_corner.step), truck reads it. A per-file test is added.

Fixes #2244

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/kernel/tests/step_agreement.rs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/crates/kernel/tests/step_agreement.rs b/crates/kernel/tests/step_agreement.rs
index 47b26131a..7422a4701 100644
--- a/crates/kernel/tests/step_agreement.rs
+++ b/crates/kernel/tests/step_agreement.rs
@@ -99,6 +99,15 @@ const ROWS: &[Row] = &[
         import: "agree",
         mesh: "watertight, within tolerance",
     },
+    // #2209 (PR #2215): two curved faces that meet at one smooth crease.
+    // As fillet_corner: solidcore has no exact pcurve for a face of it;
+    // truck reads the file (#2244 pinned the reading).
+    Row {
+        file: "fig8.step",
+        mm_per_unit: 1.0,
+        import: "solidcore refuses: #14 at read: pcurves failed on",
+        mesh: "no exact solid to judge against",
+    },
     // solidcore has no exact pcurve of a NURBS on a spline surface (the
     // corner blend); truck meshes the corner.
     Row {
@@ -433,6 +442,7 @@ per_file! {
     step_bspline_discontinuous => "bspline_discontinuous.step",
     step_bspline_dome => "bspline_dome.step",
     step_empty_list => "empty_list.step",
+    step_fig8 => "fig8.step",
     step_fillet_corner => "fillet_corner.step",
     step_lathe_holder_offset => "lathe_holder_offset.step",
     step_modular_clamp_unit => "modular_clamp_unit.step",
