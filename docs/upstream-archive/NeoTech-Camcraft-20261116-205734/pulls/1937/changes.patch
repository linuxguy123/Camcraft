+//! Bounded ASCII DXF import. Coordinates stay in drawing units; callers must resolve units.
+//! Provenance: Autodesk's published DXF Reference; original implementation, no vendor code.
+//!
+//! Only planar, zero-width model-space geometry is accepted. Arcs remain analytic.
+//! This module performs no file I/O and has no dependency on the application or ECS.
+
+mod entities;
+mod pairs;
+mod polyline;
+mod reader;
+mod types;
+mod units;
+
+pub use reader::{parse, parse_with_limits};
+pub use types::*;
+pub use units::{Unit, Units};
diff --git a/crates/geometry/src/dxf/pairs.rs b/crates/geometry/src/dxf/pairs.rs
new file mode 100644
index 000000000..d99dbb892
--- /dev/null
+++ b/crates/geometry/src/dxf/pairs.rs
@@ -0,0 +1,169 @@
+//! Provenance: Autodesk DXF ASCII code/value pairs and record delimiters.
+use super::types::{DxfError, error};
+
+#[derive(Clone, Copy)]
+pub(super) struct Pair<'a> {
+    pub code: u16,
+    pub value: &'a str,
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Pairs<'a> {
+    pub rest: &'a str,
+}
+
+impl<'a> Pairs<'a> {
+    fn line(&mut self) -> Option<&'a str> {
+        if self.rest.is_empty() {
+            return None;
+        }
+        let (line, rest) = self.rest.split_once('\n').unwrap_or((self.rest, ""));
+        self.rest = rest;
+        Some(line.trim_end_matches('\r'))
+    }
+
+    pub fn next(&mut self) -> Result<Option<Pair<'a>>, DxfError> {
+        loop {
+            let Some(code) = self.line() else {
+                return Ok(None);
+            };
+            let value = self
+                .line()
+                .ok_or_else(|| error("stream", "truncated group pair"))?;
+            let code = code
+                .trim()
+                .parse::<u16>()
+                .map_err(|_| error("stream", "malformed group code"))?;
+            if code > 1071 {
+                return Err(error("stream", "group code outside DXF range"));
+            }
+            if code != 999 {
+                return Ok(Some(Pair { code, value }));
+            }
+        }
+    }
+
+    /// Borrow a record body without collecting its group pairs.
+    pub fn record(&mut self) -> Result<Option<Record<'a>>, DxfError> {
+        let Some(first) = self.next()? else {
+            return Ok(None);
+        };
+        if first.code != 0 {
+            return Err(error("stream", "expected group 0 record"));
+        }
+        let start = self.rest;
+        let mut scan = *self;
+        loop {
+            let before = scan.rest;
+            match scan.next()? {
+                Some(pair) if pair.code == 0 => {
+                    self.rest = before;
+                    break;
+                }
+                None => {
+                    self.rest = "";
+                    break;
+                }
+                _ => {}
+            }
+        }
+        let body = &start[..start.len() - self.rest.len()];
+        Ok(Some(Record {
+            kind: first.value.trim(),
+            body,
+        }))
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Record<'a> {
+    pub kind: &'a str,
+    pub body: &'a str,
+}
+
+impl<'a> Record<'a> {
+    pub fn pairs(self) -> Pairs<'a> {
+        Pairs { rest: self.body }
+    }
+
+    pub fn field(self, code: u16) -> Result<Option<&'a str>, DxfError> {
+        let mut result = None;
+        let mut pairs = self.pairs();
+        while let Some(pair) = pairs.next()? {
+            if pair.code == code {
+                if result.is_some() {
+                    return Err(error(self.kind, &format!("duplicate group {code}")));
+                }
+                result = Some(pair.value);
+            }
+        }
+        Ok(result)
+    }
+
+    pub fn required(self, code: u16) -> Result<&'a str, DxfError> {
+        self.field(code)?
+            .ok_or_else(|| error(self.kind, &format!("missing group {code}")))
+    }
+
+    pub fn number(self, code: u16, default: Option<f64>) -> Result<f64, DxfError> {
+        match self.field(code)? {
+            Some(value) => number(value, self.kind),
+            None => default.ok_or_else(|| error(self.kind, &format!("missing group {code}"))),
+        }
+    }
+
+    pub fn integer(self, code: u16, default: i32) -> Result<i32, DxfError> {
+        match self.field(code)? {
+            Some(value) => integer(value, self.kind),
+            None => Ok(default),
+        }
+    }
+
+    pub fn empty(self) -> Result<(), DxfError> {
+        if self.pairs().next()?.is_some() {
+            return Err(error(self.kind, "unexpected fields"));
+        }
+        Ok(())
+    }
+
+    /// Reject application data that can shadow geometry fields. Do not interpret it as geometry.
+    pub fn validate(self) -> Result<(), DxfError> {
+        let mut pairs = self.pairs();
+        while let Some(pair) = pairs.next()? {
+            if pair.code == 102 {
+                return Err(error(
+                    self.kind,
+                    "application-defined group 102 is unsupported",
+                ));
+            }
+            if matches!(pair.code, 10..=59 | 110..=149 | 210..=239 | 460..=469 | 1010..=1059) {
+                number(pair.value, self.kind).map_err(|e| {
+                    if matches!(pair.code, 210 | 220 | 230) {
+                        error(self.kind, &format!("invalid extrusion: {e}"))
+                    } else {
+                        e
+                    }
+                })?;
+            }
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn number(value: &str, kind: &str) -> Result<f64, DxfError> {
+    let value = value
+        .trim()
+        .parse::<f64>()
+        .map_err(|_| error(kind, "invalid numeric value"))?;
+    if !value.is_finite() {
+        return Err(error(kind, "non-finite numeric value"));
+    }
+    Ok(value)
+}
+
+pub(super) fn integer(value: &str, kind: &str) -> Result<i32, DxfError> {
+    value
+        .trim()
+        .parse::<i32>()
+        .map_err(|_| error(kind, "invalid integer value"))
+}
diff --git a/crates/geometry/src/dxf/polyline.rs b/crates/geometry/src/dxf/polyline.rs
new file mode 100644
index 000000000..29a8567e8
--- /dev/null
+++ b/crates/geometry/src/dxf/polyline.rs
@@ -0,0 +1,236 @@
+//! Provenance: Autodesk DXF LWPOLYLINE/POLYLINE/VERTEX records and group-42 bulges.
+use super::entities::{common, coordinate, layer, point, segment};
+use super::pairs::{Pairs, Record, integer, number};
+use super::types::{DxfError, State, error};
+use crate::geo2d::Point2;
+
+#[derive(Clone, Copy)]
+struct Vertex {
+    point: Point2,
+    bulge: f64,
+}
+
+#[derive(Default)]
+struct Chain {
+    first: Option<Vertex>,
+    previous: Option<Vertex>,
+    count: usize,
+}
+
+impl Chain {
+    fn push(
+        &mut self,
+        vertex: Vertex,
+        kind: &str,
+        layer: &str,
+        state: &mut State,
+    ) -> Result<(), DxfError> {
+        if let Some(previous) = self.previous {
+            state.push(
+                layer,
+                segment(previous.point, vertex.point, previous.bulge, kind)?,
+            );
+        } else {
+            self.first = Some(vertex);
+        }
+        self.previous = Some(vertex);
+        self.count += 1;
+        Ok(())
+    }
+
+    fn finish(
+        self,
+        closed: bool,
+        kind: &str,
+        layer: &str,
+        state: &mut State,
+    ) -> Result<(), DxfError> {
+        if self.count < 2 {
+            return Err(error(kind, "fewer than two vertices"));
+        }
+        if closed && let (Some(last), Some(first)) = (self.previous, self.first) {
+            state.push(layer, segment(last.point, first.point, last.bulge, kind)?);
+        }
+        Ok(())
+    }
+}
+
+fn closed(record: Record<'_>) -> Result<bool, DxfError> {
+    let flags = record.integer(70, 0)?;
+    if flags & !129 != 0 {
+        return Err(error(
+            record.kind,
+            "3D, mesh or fitted polyline flags are unsupported",
+        ));
+    }
+    Ok(flags & 1 != 0)
+}
+
+fn zero(value: f64, kind: &str, name: &str) -> Result<(), DxfError> {
+    if value != 0.0 {
+        return Err(error(kind, &format!("nonzero {name} is unsupported")));
+    }
+    Ok(())
+}
+
+#[derive(Default)]
+struct Pending {
+    x: Option<f64>,
+    y: Option<f64>,
+    bulge: Option<f64>,
+}
+
+impl Pending {
+    fn take(&mut self, kind: &str) -> Result<Vertex, DxfError> {
+        let x = self
+            .x
+            .take()
+            .ok_or_else(|| error(kind, "vertex has no X coordinate"))?;
+        let y = self
+            .y
+            .take()
+            .ok_or_else(|| error(kind, "vertex has no Y coordinate"))?;
+        let bulge = self.bulge.take().unwrap_or(0.0);
+        Ok(Vertex {
+            point: Point2::new(x, y),
+            bulge,
+        })
+    }
+}
+
+pub(super) fn lightweight(record: Record<'_>, state: &mut State) -> Result<(), DxfError> {
+    common(record)?;
+    let layer = layer(record)?;
+    let closed = closed(record)?;
+    let expected = integer(record.required(90)?, record.kind)?;
+    let expected =
+        usize::try_from(expected).map_err(|_| error(record.kind, "negative vertex count"))?;
+    if expected
+        > state
+            .limits
+            .max_vertices
+            .saturating_sub(state.doc.summary.vertices)
+    {
+        return Err(error(record.kind, "vertex count exceeds limit"));
+    }
+    let z = coordinate(record.number(38, Some(0.0))?, record.kind)?;
+    state.elevation(record.kind, z)?;
+    let mut chain = Chain::default();
+    let mut vertex = Pending::default();
+    let mut pairs = record.pairs();
+    while let Some(pair) = pairs.next()? {
+        match pair.code {
+            10 => {
+                if vertex.x.is_some() {
+                    chain.push(vertex.take(record.kind)?, record.kind, layer, state)?;
+                }
+                state.vertex(record.kind)?;
+                vertex.x = Some(coordinate(number(pair.value, record.kind)?, record.kind)?);
+            }
+            20 | 42 => {
+                if vertex.x.is_none() {
+                    return Err(error(record.kind, "vertex field before X coordinate"));
+                }
+                let slot = if pair.code == 20 {
+                    &mut vertex.y
+                } else {
+                    &mut vertex.bulge
+                };
+                if slot.is_some() {
+                    return Err(error(record.kind, "duplicate vertex field"));
+                }
+                let value = number(pair.value, record.kind)?;
+                *slot = Some(if pair.code == 20 {
+                    coordinate(value, record.kind)?
+                } else {
+                    value
+                });
+            }
+            40 | 41 | 43 => zero(number(pair.value, record.kind)?, record.kind, "width")?,
+            30 => {
+                return Err(error(
+                    record.kind,
+                    "vertex Z is unsupported; use elevation group 38",
+                ));
+            }
+            _ => {}
+        }
+    }
+    if vertex.x.is_some() {
+        chain.push(vertex.take(record.kind)?, record.kind, layer, state)?;
+    }
+    if chain.count != expected {
+        return Err(error(record.kind, "vertex count does not match group 90"));
+    }
+    chain.finish(closed, record.kind, layer, state)
+}
+
+pub(super) fn legacy(
+    record: Record<'_>,
+    input: &mut Pairs<'_>,
+    state: &mut State,
+) -> Result<(), DxfError> {
+    common(record)?;
+    let layer = layer(record)?;
+    let closed = closed(record)?;
+    for code in [40, 41] {
+        zero(record.number(code, Some(0.0))?, record.kind, "width")?;
+    }
+    for code in [10, 20] {
+        zero(
+            record.number(code, Some(0.0))?,
+            record.kind,
+            "dummy coordinate",
+        )?;
+    }
+    if record.integer(75, 0)? != 0 {
+        return Err(error(record.kind, "fitted surface is unsupported"));
+    }
+    let z = coordinate(record.number(30, Some(0.0))?, record.kind)?;
+    state.elevation(record.kind, z)?;
+    let mut chain = Chain::default();
+    loop {
+        let vertex = input
+            .record()?
+            .ok_or_else(|| error("POLYLINE", "missing SEQEND"))?;
+        match vertex.kind {
+            "SEQEND" => {
+                state.entity("SEQEND")?;
+                common(vertex)?;
+                break;
+            }
+            "VERTEX" => {
+                state.entity("VERTEX")?;
+                state.vertex("POLYLINE VERTEX")?;
+                common(vertex)?;
+                if vertex.integer(70, 0)? != 0 {
+                    return Err(error(
+                        "POLYLINE VERTEX",
+                        "3D, mesh or fitted vertex flags are unsupported",
+                    ));
+                }
+                for code in [40, 41] {
+                    zero(vertex.number(code, Some(0.0))?, "POLYLINE VERTEX", "width")?;
+                }
+                zero(vertex.number(30, Some(0.0))?, "POLYLINE VERTEX", "Z")?;
+                if let Some(name) = vertex.field(8)?
+                    && name != layer
+                    && name != "0"
+                {
+                    return Err(error("POLYLINE VERTEX", "layer differs from POLYLINE"));
+                }
+                chain.push(
+                    Vertex {
+                        point: point(vertex, 10, 20)?,
+                        bulge: vertex.number(42, Some(0.0))?,
+                    },
+                    "POLYLINE",
+                    layer,
+                    state,
+                )?;
+            }
+            _ => return Err(error("POLYLINE", "expected VERTEX or SEQEND")),
+        }
+    }
+    chain.finish(closed, record.kind, layer, state)
+}
diff --git a/crates/geometry/src/dxf/reader.rs b/crates/geometry/src/dxf/reader.rs
new file mode 100644
index 000000000..37c1e7ec1
--- /dev/null
+++ b/crates/geometry/src/dxf/reader.rs
@@ -0,0 +1,202 @@
+//! Provenance: Autodesk DXF SECTION, HEADER, TABLES and ENTITIES structure.
+use super::Units;
+use super::entities::{layer_name, simple};
+use super::pairs::{Pairs, Record, integer};
+use super::polyline::{legacy, lightweight};
+use super::types::{Document, DxfError, Layer, Limits, State, error};
+use std::collections::BTreeSet;
+
+pub fn parse(bytes: &[u8]) -> Result<Document, DxfError> {
+    parse_with_limits(bytes, Limits::default())
+}
+
+/// Parse an in-memory ASCII DXF. Callers must also cap file reads before calling this API.
+pub fn parse_with_limits(bytes: &[u8], limits: Limits) -> Result<Document, DxfError> {
+    if bytes.starts_with(b"AutoCAD Binary DXF") {
+        return Err(error("Binary DXF", "unsupported; use ASCII DXF"));
+    }
+    if bytes.len() > limits.max_bytes {
+        return Err(error("file", "size exceeds limit"));
+    }
+    let text = std::str::from_utf8(bytes).map_err(|_| error("text", "invalid UTF-8 ASCII DXF"))?;
+    let mut input = Pairs { rest: text };
+    let mut state = State {
+        doc: Document::default(),
+        limits,
+    };
+    let mut sections = BTreeSet::new();
+    loop {
+        let record = input
+            .record()?
+            .ok_or_else(|| error("stream", "missing EOF"))?;
+        match record.kind {
+            "EOF" => {
+                record.empty()?;
+                if input.next()?.is_some() {
+                    return Err(error("EOF", "data after EOF"));
+                }
+                return Ok(state.doc);
+            }
+            "SECTION" => {
+                let mut fields = record.pairs();
+                let name = fields
+                    .next()?
+                    .ok_or_else(|| error("SECTION", "missing name"))?;
+                if name.code != 2 {
+                    return Err(error("SECTION", "expected name in group 2"));
+                }
+                let name = name.value.trim();
+                if !sections.insert(name) {
+                    return Err(error(name, "duplicate SECTION"));
+                }
+                if name == "HEADER" {
+                    header(fields, &mut state.doc)?;
+                    end_section(&mut input, "HEADER")?;
+                } else {
+                    if fields.next()?.is_some() {
+                        return Err(error(name, "unexpected SECTION fields"));
+                    }
+                    match name {
+                        "ENTITIES" => entities(&mut input, &mut state)?,
+                        "TABLES" => tables(&mut input, &mut state)?,
+                        "BLOCKS" => end_section(&mut input, "BLOCK")?,
+                        _ => return Err(error(name, "unsupported SECTION")),
+                    }
+                }
+            }
+            _ => return Err(error(record.kind, "expected SECTION or EOF")),
+        }
+    }
+}
+
+fn end_section(input: &mut Pairs<'_>, context: &str) -> Result<(), DxfError> {
+    let record = input
+        .record()?
+        .ok_or_else(|| error(context, "missing ENDSEC"))?;
+    if record.kind != "ENDSEC" {
+        return Err(error(
+            context,
+            "expected ENDSEC; section content is unsupported",
+        ));
+    }
+    record.empty()
+}
+
+fn header(mut fields: Pairs<'_>, doc: &mut Document) -> Result<(), DxfError> {
+    let mut seen_units = false;
+    let mut variable = None;
+    let mut units_value = false;
+    while let Some(pair) = fields.next()? {
+        if pair.code == 9 {
+            if variable == Some("$INSUNITS") && !units_value {
+                return Err(error("$INSUNITS", "missing group 70 value"));
+            }
+            variable = Some(pair.value.trim());
+            if variable == Some("$INSUNITS") {
+                if seen_units {
+                    return Err(error("$INSUNITS", "duplicate header variable"));
+                }
+                seen_units = true;
+            }
+        } else if variable == Some("$INSUNITS") {
+            if pair.code != 70 {
+                return Err(error("$INSUNITS", "expected group 70"));
+            }
+            if units_value {
+                return Err(error("$INSUNITS", "duplicate group 70 value"));
+            }
+            doc.units = Units::from_code(integer(pair.value, "$INSUNITS")?);
+            units_value = true;
+        } else if variable.is_none() {
+            return Err(error("HEADER", "value without a header variable"));
+        }
+    }
+    if seen_units && !units_value {
+        return Err(error("$INSUNITS", "missing group 70 value"));
+    }
+    Ok(())
+}
+
+fn entities(input: &mut Pairs<'_>, state: &mut State) -> Result<(), DxfError> {
+    loop {
+        let record = input
+            .record()?
+            .ok_or_else(|| error("ENTITIES", "missing ENDSEC"))?;
+        if record.kind == "ENDSEC" {
+            return record.empty();
+        }
+        state.entity(record.kind)?;
+        match record.kind {
+            "LINE" | "ARC" | "CIRCLE" => simple(record, state)?,
+            "LWPOLYLINE" => lightweight(record, state)?,
+            "POLYLINE" => legacy(record, input, state)?,
+            "TEXT" | "MTEXT" | "DIMENSION" | "HATCH" => {
+                record.validate()?;
+                *state
+                    .doc
+                    .summary
+                    .skipped
+                    .entry(record.kind.into())
+                    .or_default() += 1;
+            }
+            "EOF" | "SECTION" => return Err(error("ENTITIES", "missing ENDSEC")),
+            _ => return Err(error(record.kind, "unsupported entity")),
+        }
+    }
+}
+
+fn tables(input: &mut Pairs<'_>, state: &mut State) -> Result<(), DxfError> {
+    let mut table = None;
+    let mut names = BTreeSet::new();
+    loop {
+        let record = input
+            .record()?
+            .ok_or_else(|| error("TABLES", "missing ENDSEC"))?;
+        match record.kind {
+            "ENDSEC" => {
+                if table.is_some() {
+                    return Err(error("TABLES", "missing ENDTAB"));
+                }
+                return record.empty();
+            }
+            "TABLE" => {
+                if table.is_some() {
+                    return Err(error("TABLES", "nested TABLE"));
+                }
+                table = Some(record.required(2)?);
+            }
+            "ENDTAB" => {
+                if table.take().is_none() {
+                    return Err(error("TABLES", "unexpected ENDTAB"));
+                }
+                record.empty()?;
+            }
+            "EOF" | "SECTION" => return Err(error("TABLES", "missing ENDSEC")),
+            kind => {
+                if table != Some(kind) {
+                    return Err(error(kind, "entry does not match TABLE"));
+                }
+                if kind == "LAYER" {
+                    if state.doc.layers.len() >= state.limits.max_entities {
+                        return Err(error("LAYER", "entity count exceeds limit"));
+                    }
+                    let name = record.required(2)?;
+                    layer_name(name, "LAYER")?;
+                    if !names.insert(name) {
+                        return Err(error("LAYER", "duplicate layer name"));
+                    }
+                    state.doc.layers.push(read_layer(record, name)?);
+                }
+            }
+        }
+    }
+}
+
+fn read_layer(record: Record<'_>, name: &str) -> Result<Layer, DxfError> {
+    Ok(Layer {
+        name: name.into(),
+        flags: record.integer(70, 0)?,
+        color: record.integer(62, 7)?,
+        line_type: record.field(6)?.unwrap_or("CONTINUOUS").into(),
+    })
+}
diff --git a/crates/geometry/src/dxf/types.rs b/crates/geometry/src/dxf/types.rs
new file mode 100644
index 000000000..c67fb3ba7
--- /dev/null
+++ b/crates/geometry/src/dxf/types.rs
@@ -0,0 +1,119 @@
+//! Provenance: neutral import values for Autodesk's public DXF entity definitions.
+use super::Units;
+use crate::geo2d::Point2;
+use std::collections::BTreeMap;
+
+#[derive(Clone, Debug, PartialEq, thiserror::Error)]
+#[error("DXF {0}")]
+pub struct DxfError(pub String);
+
+pub(super) fn error(context: &str, message: &str) -> DxfError {
+    DxfError(format!("{context}: {message}"))
+}
+
+/// Limits are checked before collecting records or vertices. No input count is a capacity.
+#[derive(Clone, Copy, Debug)]
+pub struct Limits {
+    pub max_bytes: usize,
+    pub max_entities: usize,
+    pub max_vertices: usize,
+}
+
+impl Default for Limits {
+    fn default() -> Self {
+        Self {
+            max_bytes: 16 * 1024 * 1024,
+            max_entities: 100_000,
+            max_vertices: 1_000_000,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum Primitive {
+    Line {
+        start: Point2,
+        end: Point2,
+    },
+    /// Radians, counterclockwise positive. A full circle uses `Circle`.
+    Arc {
+        center: Point2,
+        radius: f64,
+        start_angle: f64,
+        sweep_angle: f64,
+    },
+    Circle {
+        center: Point2,
+        radius: f64,
+    },
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct LayeredPrimitive {
+    pub layer: String,
+    pub primitive: Primitive,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Layer {
+    pub name: String,
+    pub flags: i32,
+    pub color: i32,
+    pub line_type: String,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ImportSummary {
+    /// Includes POLYLINE's VERTEX and SEQEND records, and skipped entities.
+    pub entities: usize,
+    pub vertices: usize,
+    pub skipped: BTreeMap<String, usize>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Document {
+    pub units: Units,
+    pub layers: Vec<Layer>,
+    pub primitives: Vec<LayeredPrimitive>,
+    /// Common Z of the extracted geometry, in drawing units.
+    pub elevation: Option<f64>,
+    pub summary: ImportSummary,
+}
+
+pub(super) struct State {
+    pub doc: Document,
+    pub limits: Limits,
+}
+
+impl State {
+    pub fn entity(&mut self, kind: &str) -> Result<(), DxfError> {
+        if self.doc.summary.entities >= self.limits.max_entities {
+            return Err(error(kind, "entity count exceeds limit"));
+        }
+        self.doc.summary.entities += 1;
+        Ok(())
+    }
+
+    pub fn vertex(&mut self, kind: &str) -> Result<(), DxfError> {
+        if self.doc.summary.vertices >= self.limits.max_vertices {
+            return Err(error(kind, "vertex count exceeds limit"));
+        }
+        self.doc.summary.vertices += 1;
+        Ok(())
+    }
+
+    pub fn elevation(&mut self, kind: &str, z: f64) -> Result<(), DxfError> {
+        if self.doc.elevation.is_some_and(|old| old != z) {
+            return Err(error(kind, "varying Z heights are not planar"));
+        }
+        self.doc.elevation = Some(z);
+        Ok(())
+    }
+
+    pub fn push(&mut self, layer: &str, primitive: Primitive) {
+        self.doc.primitives.push(LayeredPrimitive {
+            layer: layer.into(),
+            primitive,
+        });
+    }
+}
diff --git a/crates/geometry/src/dxf/units.rs b/crates/geometry/src/dxf/units.rs
new file mode 100644
index 000000000..483e7ff4e
--- /dev/null
+++ b/crates/geometry/src/dxf/units.rs
@@ -0,0 +1,104 @@
+//! Provenance: Autodesk DXF HEADER $INSUNITS codes and standard length conversions.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Units {
+    Known(Unit),
+    #[default]
+    MissingOrUnitless,
+    Unsupported(i32),
+}
+
+/// DXF drawing units, separate from the application's two display units.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Unit {
+    Inches,
+    Feet,
+    Miles,
+    Millimeters,
+    Centimeters,
+    Meters,
+    Kilometers,
+    Microinches,
+    Mils,
+    Yards,
+    Angstroms,
+    Nanometers,
+    Microns,
+    Decimeters,
+    Decameters,
+    Hectometers,
+    Gigameters,
+    AstronomicalUnits,
+    LightYears,
+    Parsecs,
+    UsSurveyFeet,
+    UsSurveyInches,
+    UsSurveyYards,
+    UsSurveyMiles,
+}
+
+impl Units {
+    pub(super) fn from_code(code: i32) -> Self {
+        let unit = match code {
+            0 => return Self::MissingOrUnitless,
+            1 => Unit::Inches,
+            2 => Unit::Feet,
+            3 => Unit::Miles,
+            4 => Unit::Millimeters,
+            5 => Unit::Centimeters,
+            6 => Unit::Meters,
+            7 => Unit::Kilometers,
+            8 => Unit::Microinches,
+            9 => Unit::Mils,
+            10 => Unit::Yards,
+            11 => Unit::Angstroms,
+            12 => Unit::Nanometers,
+            13 => Unit::Microns,
+            14 => Unit::Decimeters,
+            15 => Unit::Decameters,
+            16 => Unit::Hectometers,
+            17 => Unit::Gigameters,
+            18 => Unit::AstronomicalUnits,
+            19 => Unit::LightYears,
+            20 => Unit::Parsecs,
+            21 => Unit::UsSurveyFeet,
+            22 => Unit::UsSurveyInches,
+            23 => Unit::UsSurveyYards,
+            24 => Unit::UsSurveyMiles,
+            _ => return Self::Unsupported(code),
+        };
+        Self::Known(unit)
+    }
+}
+
+impl Unit {
+    /// Metadata only. Scaling geometry is a caller decision and needs another range check.
+    pub fn millimeters_per_unit(self) -> f64 {
+        match self {
+            Self::Inches => 25.4,
+            Self::Feet => 304.8,
+            Self::Miles => 1_609_344.0,
+            Self::Millimeters => 1.0,
+            Self::Centimeters => 10.0,
+            Self::Meters => 1000.0,
+            Self::Kilometers => 1_000_000.0,
+            Self::Microinches => 0.0000254,
+            Self::Mils => 0.0254,
+            Self::Yards => 914.4,
+            Self::Angstroms => 1e-7,
+            Self::Nanometers => 1e-6,
+            Self::Microns => 0.001,
+            Self::Decimeters => 100.0,
+            Self::Decameters => 10_000.0,
+            Self::Hectometers => 100_000.0,
+            Self::Gigameters => 1e12,
+            Self::AstronomicalUnits => 149_597_870_700_000.0,
+            Self::LightYears => 9_460_730_472_580_800_000.0,
+            Self::Parsecs => 149_597_870_700_000.0 * 648_000.0 / std::f64::consts::PI,
+            Self::UsSurveyFeet => 1_200_000.0 / 3937.0,
+            Self::UsSurveyInches => 100_000.0 / 3937.0,
+            Self::UsSurveyYards => 3_600_000.0 / 3937.0,
+            Self::UsSurveyMiles => 6_336_000_000.0 / 3937.0,
+        }
+    }
+}
