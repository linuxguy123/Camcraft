+//! Minimal clean-room uncompressed RGB PNG encoder (RFC 1950 zlib + RFC 1951 stored blocks, ISO/IEC 15948).
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+const PNG_SIG: [u8; 8] = [0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a];
+
+pub fn default_diff_dir() -> PathBuf {
+    std::env::var_os("CARGO_TARGET_TMPDIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| std::env::temp_dir().join("camcraft-shape-masks"))
+        .join("shape-mask-diffs")
+}
+
+pub fn write_diff_mask(
+    dir: &Path,
+    name: &str,
+    size: (usize, usize),
+    expected: &[bool],
+    expected_d1: &[bool],
+    swept: &[bool],
+    highlight: Option<(usize, usize)>,
+) -> Result<PathBuf, String> {
+    let (w, h) = size;
+    let mut rgb = vec![24u8; w * h * 3];
+    for i in 0..w * h {
+        let color = match (expected[i], swept[i], expected_d1[i]) {
+            (_, true, false) => [220, 48, 48],     // Red: overcut
+            (true, false, _) => [52, 132, 224],   // Blue: uncut leftover
+            (true, true, _) => [68, 172, 108],    // Green: covered as expected
+            (false, true, true) => [216, 176, 56], // Amber: 1-cell border halo
+            (false, false, _) => [24, 26, 32],    // Dark charcoal: outside
+        };
+        let base = i * 3;
+        rgb[base..base + 3].copy_from_slice(&color);
+    }
+    if let Some((cx, cy)) = highlight {
+        for ny in cy.saturating_sub(2)..=(cy + 2).min(h - 1) {
+            for nx in cx.saturating_sub(2)..=(cx + 2).min(w - 1) {
+                let base = (ny * w + nx) * 3;
+                rgb[base..base + 3].copy_from_slice(&[255, 255, 64]);
+            }
+        }
+    }
+    let clean: String = name
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '_' { c } else { '_' })
+        .collect();
+    let path = dir.join(format!("{clean}.png"));
+    write_rgb(&path, w, h, &rgb)?;
+    Ok(path)
+}
+
+pub fn write_rgb(path: &Path, width: usize, height: usize, rgb: &[u8]) -> Result<(), String> {
+    let bytes = encode_rgb(width, height, rgb)?;
+    if let Some(parent) = path.parent()
+        && !parent.as_os_str().is_empty()
+    {
+        fs::create_dir_all(parent).map_err(|e| format!("create png dir {}: {e}", parent.display()))?;
+    }
+    fs::write(path, &bytes).map_err(|e| format!("write png {}: {e}", path.display()))
+}
+
+pub fn encode_rgb(width: usize, height: usize, rgb: &[u8]) -> Result<Vec<u8>, String> {
+    if width == 0 || height == 0 {
+        return Err("png dimensions must be positive".into());
+    }
+    let expected_len = width
+        .checked_mul(height)
+        .and_then(|n| n.checked_mul(3))
+        .ok_or_else(|| "png byte count overflow".to_string())?;
+    if rgb.len() != expected_len {
+        return Err(format!("expected {expected_len} RGB bytes, got {}", rgb.len()));
+    }
+    let w32 = u32::try_from(width).map_err(|_| "png width exceeds u32".to_string())?;
+    let h32 = u32::try_from(height).map_err(|_| "png height exceeds u32".to_string())?;
+
+    let row_bytes = width * 3;
+    let mut raw = Vec::with_capacity((row_bytes + 1) * height);
+    for y in 0..height {
+        raw.push(0); // filter type 0 (None)
+        let row = &rgb[y * row_bytes..(y + 1) * row_bytes];
+        raw.extend_from_slice(row);
+    }
+
+    let mut ihdr = Vec::with_capacity(13);
+    ihdr.extend_from_slice(&w32.to_be_bytes());
+    ihdr.extend_from_slice(&h32.to_be_bytes());
+    ihdr.extend_from_slice(&[8, 2, 0, 0, 0]); // 8-bit RGB, deflate, filter 0, no interlace
+
+    let idat = zlib_stored(&raw);
+    let mut out = Vec::with_capacity(PNG_SIG.len() + 25 + idat.len() + 24);
+    out.extend_from_slice(&PNG_SIG);
+    push_chunk(&mut out, b"IHDR", &ihdr)?;
+    push_chunk(&mut out, b"IDAT", &idat)?;
+    push_chunk(&mut out, b"IEND", &[])?;
+    Ok(out)
+}
+
+fn push_chunk(out: &mut Vec<u8>, tag: &[u8; 4], data: &[u8]) -> Result<(), String> {
+    let len = u32::try_from(data.len()).map_err(|_| "png chunk exceeds u32".to_string())?;
+    out.extend_from_slice(&len.to_be_bytes());
+    out.extend_from_slice(tag);
+    out.extend_from_slice(data);
+    let crc = crc32(tag, data);
+    out.extend_from_slice(&crc.to_be_bytes());
+    Ok(())
+}
+
+fn zlib_stored(raw: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(raw.len() + 16 + (raw.len() / 65535) * 5);
+    out.extend_from_slice(&[0x78, 0x01]);
+    let mut offset = 0usize;
+    while offset < raw.len() {
+        let end = (offset + 65535).min(raw.len());
+        let is_final = end == raw.len();
+        let len = (end - offset) as u16;
+        out.push(u8::from(is_final));
+        out.extend_from_slice(&len.to_le_bytes());
+        out.extend_from_slice(&(!len).to_le_bytes());
+        out.extend_from_slice(&raw[offset..end]);
+        offset = end;
+    }
+    let adler = adler32(raw);
+    out.extend_from_slice(&adler.to_be_bytes());
+    out
+}
+
+fn crc32(tag: &[u8; 4], data: &[u8]) -> u32 {
+    let mut crc = 0xffff_ffffu32;
+    for &b in tag.iter().chain(data.iter()) {
+        crc ^= u32::from(b);
+        for _ in 0..8 {
+            let mask = (crc & 1).wrapping_neg();
+            crc = (crc >> 1) ^ (0xedb8_8320 & mask);
+        }
+    }
+    !crc
+}
+
+fn adler32(data: &[u8]) -> u32 {
+    let mut s1 = 1u32;
+    let mut s2 = 0u32;
+    for &b in data {
+        s1 = (s1 + u32::from(b)) % 65521;
+        s2 = (s2 + s1) % 65521;
+    }
+    (s2 << 16) | s1
+}
diff --git a/crates/motion/tests/common/shape_mask.rs b/crates/motion/tests/common/shape_mask.rs
new file mode 100644
index 000000000..5524e36b5
--- /dev/null
+++ b/crates/motion/tests/common/shape_mask.rs
@@ -0,0 +1,398 @@
+//! 2D toolpath shape-mask verifier and PNG diff reporter (#1768).
+//! Provenance: compares the expected 2D Region mask against the toolpath's swept disc
+//! footprint on a fixed planar grid, checking overcut, leftover, progressive rim engagement,
+//! symmetry and stock-extension laws, and writing a pure-Rust RGB difference PNG on failure.
+
+use std::path::{Path, PathBuf};
+
+use camcraft_motion::cl::{ArcMove, MoveKind, Toolpath};
+use camcraft_motion::geo2d::{Point2, Region};
+use camcraft_motion::geometry::Point3;
+
+use super::mask_grid::{CHORD_TOL, Grid, Z_EPS};
+use super::png;
+
+#[derive(Clone, Copy, Debug)]
+pub enum CutDepth {
+    AllCut,
+    AtOrBelow(f64),
+    NearZ { z: f64, tol: f64 },
+}
+
+impl CutDepth {
+    fn includes(self, a: Point3, b: Point3) -> bool {
+        let zmin = a.z.min(b.z);
+        let zmax = a.z.max(b.z);
+        match self {
+            CutDepth::AllCut => true,
+            CutDepth::AtOrBelow(z) => zmin <= z + Z_EPS,
+            CutDepth::NearZ { z, tol } => (0.5 * (a.z + b.z) - z).abs() <= tol || (zmin <= z && zmax >= z),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum Symmetry {
+    MirrorX(f64),
+    MirrorY(f64),
+    Rotate180(f64, f64),
+}
+
+impl Symmetry {
+    fn reflect(self, p: Point2) -> Point2 {
+        match self {
+            Symmetry::MirrorX(cx) => Point2::new(2.0 * cx - p.x, p.y),
+            Symmetry::MirrorY(cy) => Point2::new(p.x, 2.0 * cy - p.y),
+            Symmetry::Rotate180(cx, cy) => Point2::new(2.0 * cx - p.x, 2.0 * cy - p.y),
+        }
+    }
+}
+
+pub struct MaskSpec<'a> {
+    pub name: &'a str,
+    pub expected: &'a Region,
+    pub path: &'a Toolpath,
+    pub tool_diameter: f64,
+    pub cell: f64,
+    pub depth: CutDepth,
+    pub diff_dir: Option<&'a Path>,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct MaskMetrics {
+    pub expected_cells: usize,
+    pub swept_cells: usize,
+    pub overcut_cells: usize,
+    pub uncut_cells: usize,
+    pub uncut_area: f64,
+    pub interior_uncut_cells: usize,
+    pub out_of_grid_moves: usize,
+    pub max_cut_width: f64,
+    pub worst_cut_point: Option<Point2>,
+}
+
+pub struct ShapeMask {
+    name: String,
+    diff_dir: PathBuf,
+    grid: Grid,
+    expected: Vec<bool>,
+    expected_d1: Vec<bool>,
+    expected_interior: Vec<bool>,
+    swept: Vec<bool>,
+    out_of_grid_moves: usize,
+    first_out_point: Option<Point2>,
+    max_cut_width: f64,
+    worst_cut_point: Option<Point2>,
+}
+
+impl ShapeMask {
+    pub fn evaluate(spec: &MaskSpec<'_>) -> Result<Self, String> {
+        if !spec.tool_diameter.is_finite() || spec.tool_diameter <= 0.0 {
+            return Err("tool_diameter must be finite and positive".into());
+        }
+        let r = 0.5 * spec.tool_diameter;
+        let pad = (r + 6.0 * spec.cell).max(spec.tool_diameter + 4.0 * spec.cell);
+        let grid = Grid::for_region(spec.expected, spec.cell, pad)?;
+        let expected = grid.rasterize_region(spec.expected);
+        let expected_d1 = grid.dilate1(&expected);
+        let expected_interior = grid.erode1(&expected);
+
+        let mut swept = vec![false; grid.len()];
+        let mut swept_z = vec![f64::INFINITY; grid.len()];
+        let mut out_of_grid_moves = 0usize;
+        let mut first_out_point = None;
+        let mut max_cut_width = 0.0f64;
+        let mut worst_cut_point = None;
+        let mut helix_segs: Vec<(Point2, Point2, bool)> = Vec::new();
+        let mut helix_sweep = 0.0f64;
+        let mut helix_z = f64::INFINITY;
+
+        for mv in &spec.path.moves {
+            if mv.kind == MoveKind::Rapid {
+                flush_helix(&grid, r, &mut helix_segs, &mut helix_sweep, helix_z, &mut swept, &mut swept_z);
+                continue;
+            }
+            let is_helix_arc = mv.kind == MoveKind::Feed
+                && mv.arc.is_some_and(|a| a.plane.is_xy())
+                && mv.from.z > mv.to.z + Z_EPS;
+            if is_helix_arc {
+                if let Some(arc) = mv.arc {
+                    helix_sweep += arc_sweep_angle(
+                        Point2::new(mv.from.x, mv.from.y),
+                        Point2::new(mv.to.x, mv.to.y),
+                        arc.center,
+                        arc.ccw,
+                    );
+                }
+                helix_z = mv.to.z;
+            } else {
+                flush_helix(&grid, r, &mut helix_segs, &mut helix_sweep, helix_z, &mut swept, &mut swept_z);
+            }
+
+            let is_planar_feed = mv.kind == MoveKind::Feed && (mv.from.z - mv.to.z).abs() <= Z_EPS;
+            for (pa, pb) in mv.segments3(CHORD_TOL) {
+                let p2a = Point2::new(pa.x, pa.y);
+                let p2b = Point2::new(pb.x, pb.y);
+                if !grid.segment_in_bounds(p2a, p2b, r) {
+                    out_of_grid_moves += 1;
+                    if first_out_point.is_none() {
+                        first_out_point = Some(if grid.cell_of(p2a).is_none() { p2a } else { p2b });
+                    }
+                }
+                let in_depth = spec.depth.includes(pa, pb);
+                let len = (p2b.x - p2a.x).hypot(p2b.y - p2a.y);
+                if is_planar_feed && len > 1e-9 {
+                    let steps = (len / grid.cell).ceil().max(1.0) as usize;
+                    let dir = (p2b.x - p2a.x, p2b.y - p2a.y);
+                    let z = 0.5 * (pa.z + pb.z);
+                    let mut prev = p2a;
+                    for s in 1..=steps {
+                        let t = s as f64 / steps as f64;
+                        let cur = Point2::new(p2a.x + dir.0 * t, p2a.y + dir.1 * t);
+                        let tan = move_tangent(mv.arc, cur, dir);
+                        let w = grid.contact_width(cur, tan, z, r, &expected, &swept_z);
+                        if w > max_cut_width {
+                            max_cut_width = w;
+                            worst_cut_point = Some(cur);
+                        }
+                        grid.sweep_capsule((prev, cur), r, z, in_depth, &mut swept, &mut swept_z);
+                        prev = cur;
+                    }
+                } else {
+                    let z = pa.z.min(pb.z);
+                    if is_helix_arc {
+                        helix_segs.push((p2a, p2b, in_depth));
+                    }
+                    grid.sweep_capsule((p2a, p2b), r, z, in_depth, &mut swept, &mut swept_z);
+                }
+            }
+        }
+        flush_helix(&grid, r, &mut helix_segs, &mut helix_sweep, helix_z, &mut swept, &mut swept_z);
+
+        let diff_dir = spec.diff_dir.map_or_else(png::default_diff_dir, Path::to_path_buf);
+        Ok(Self {
+            name: spec.name.to_string(),
+            diff_dir,
+            grid,
+            expected,
+            expected_d1,
+            expected_interior,
+            swept,
+            out_of_grid_moves,
+            first_out_point,
+            max_cut_width,
+            worst_cut_point,
+        })
+    }
+
+    pub fn metrics(&self) -> MaskMetrics {
+        let cell_area = self.grid.cell * self.grid.cell;
+        let expected_cells = self.expected.iter().filter(|&&b| b).count();
+        let swept_cells = self.swept.iter().filter(|&&b| b).count();
+        let overcut_cells = self
+            .swept
+            .iter()
+            .zip(&self.expected_d1)
+            .filter(|&(&s, &ed)| s && !ed)
+            .count();
+        let uncut_cells = self
+            .expected
+            .iter()
+            .zip(&self.swept)
+            .filter(|&(&e, &s)| e && !s)
+            .count();
+        let interior_uncut_cells = self
+            .expected_interior
+            .iter()
+            .zip(&self.swept)
+            .filter(|&(&ei, &s)| ei && !s)
+            .count();
+        MaskMetrics {
+            expected_cells,
+            swept_cells,
+            overcut_cells,
+            uncut_cells,
+            uncut_area: uncut_cells as f64 * cell_area,
+            interior_uncut_cells,
+            out_of_grid_moves: self.out_of_grid_moves,
+            max_cut_width: self.max_cut_width,
+            worst_cut_point: self.worst_cut_point,
+        }
+    }
+
+    pub fn assert_no_overcut(&self) {
+        let m = self.metrics();
+        if m.out_of_grid_moves > 0 || m.overcut_cells > 0 {
+            self.fail_with_png(
+                None,
+                &format!(
+                    "overcut: {} overcut cell(s), {} out-of-grid segment(s) (first at {:?})",
+                    m.overcut_cells, m.out_of_grid_moves, self.first_out_point
+                ),
+            );
+        }
+    }
+
+    pub fn assert_bounded_leftover(&self, max_uncut_area: f64, allowed: Option<&Region>) {
+        let m = self.metrics();
+        let allowed_d1 = allowed.map(|reg| self.grid.dilate1(&self.grid.rasterize_region(reg)));
+        let mut disallowed = 0usize;
+        let mut sample_at = None;
+        for iy in 0..self.grid.h {
+            for ix in 0..self.grid.w {
+                let i = self.grid.idx(ix, iy);
+                if self.expected_interior[i] && !self.swept[i] {
+                    let permitted = allowed_d1.as_ref().is_some_and(|a| a[i]);
+                    if !permitted {
+                        disallowed += 1;
+                        if sample_at.is_none() {
+                            sample_at = Some(self.grid.center(ix, iy));
+                        }
+                    }
+                }
+            }
+        }
+        if m.uncut_area > max_uncut_area || disallowed > 0 {
+            self.fail_with_png(
+                None,
+                &format!(
+                    "leftover exceeded: uncut_area={:.2} mm2 (limit {max_uncut_area:.2}), disallowed interior uncut cells={disallowed} (first at {sample_at:?})",
+                    m.uncut_area
+                ),
+            );
+        }
+    }
+
+    pub fn assert_max_engagement(&self, max_stepover: f64) {
+        let limit = max_stepover + 1.5 * self.grid.cell;
+        if self.max_cut_width > limit {
+            self.fail_with_png(
+                self.worst_cut_point,
+                &format!(
+                    "engagement exceeded: max cut width {:.3} mm > limit {:.3} mm (stepover {max_stepover:.3} + 1.5*cell) at {:?}",
+                    self.max_cut_width, limit, self.worst_cut_point
+                ),
+            );
+        }
+    }
+
+    pub fn assert_symmetric(&self, sym: Symmetry) {
+        let swept_d1 = self.grid.dilate1(&self.swept);
+        let expected_sym_miss = count_symmetry_mismatch(&self.grid, &self.expected, &self.expected_d1, sym);
+        if expected_sym_miss > 0 {
+            self.fail_with_png(
+                None,
+                &format!("expected region is not symmetric under {sym:?}: {expected_sym_miss} asymmetric cell(s)"),
+            );
+        }
+        let swept_sym_miss = count_symmetry_mismatch(&self.grid, &self.swept, &swept_d1, sym);
+        if swept_sym_miss > 0 {
+            self.fail_with_png(
+                None,
+                &format!("swept cut is not symmetric under {sym:?}: {swept_sym_miss} asymmetric cell(s)"),
+            );
+        }
+    }
+
+    pub fn assert_within_stock_extension(&self, stock: &Region, ext: f64) {
+        let allowed_reg = if ext == 0.0 {
+            stock.clone()
+        } else {
+            match stock.offset_sharp(ext) {
+                Ok(r) => r,
+                Err(e) => panic!("shape_mask '{}': failed to offset stock by {ext}: {e}", self.name),
+            }
+        };
+        let allowed_d1 = self.grid.dilate1(&self.grid.rasterize_region(&allowed_reg));
+        let outside = self
+            .swept
+            .iter()
+            .zip(&allowed_d1)
+            .filter(|&(&s, &a)| s && !a)
+            .count();
+        if self.out_of_grid_moves > 0 || outside > 0 {
+            self.fail_with_png(
+                None,
+                &format!(
+                    "exceeded stock + {ext:.2} mm extension: {outside} swept cell(s) outside, {} out-of-grid segment(s)",
+                    self.out_of_grid_moves
+                ),
+            );
+        }
+    }
+
+    fn fail_with_png(&self, highlight: Option<Point2>, msg: &str) -> ! {
+        let cell = highlight.and_then(|pt| self.grid.cell_of(pt));
+        match png::write_diff_mask(
+            &self.diff_dir,
+            &self.name,
+            (self.grid.w, self.grid.h),
+            &self.expected,
+            &self.expected_d1,
+            &self.swept,
+            cell,
+        ) {
+            Ok(p) => panic!("shape_mask '{}': {msg}\ndiff mask PNG written to {}", self.name, p.display()),
+            Err(e) => panic!("shape_mask '{}': {msg}\n(failed to write diff PNG: {e})", self.name),
+        }
+    }
+}
+
+fn count_symmetry_mismatch(grid: &Grid, src: &[bool], target_d1: &[bool], sym: Symmetry) -> usize {
+    let mut miss = 0usize;
+    for iy in 0..grid.h {
+        for ix in 0..grid.w {
+            let i = grid.idx(ix, iy);
+            if !src[i] {
+                continue;
+            }
+            let reflected = sym.reflect(grid.center(ix, iy));
+            match grid.cell_of(reflected) {
+                Some((rx, ry)) if target_d1[grid.idx(rx, ry)] => {}
+                _ => miss += 1,
+            }
+        }
+    }
+    miss
+}
+
+fn arc_sweep_angle(from: Point2, to: Point2, center: Point2, ccw: bool) -> f64 {
+    let a0 = (from.y - center.y).atan2(from.x - center.x);
+    let a1 = (to.y - center.y).atan2(to.x - center.x);
+    let mut d = if ccw { a1 - a0 } else { a0 - a1 };
+    while d <= 1e-9 {
+        d += std::f64::consts::TAU;
+    }
+    d.min(std::f64::consts::TAU)
+}
+
+fn flush_helix(
+    grid: &Grid,
+    r: f64,
+    segs: &mut Vec<(Point2, Point2, bool)>,
+    sweep: &mut f64,
+    z_end: f64,
+    swept: &mut [bool],
+    swept_z: &mut [f64],
+) {
+    if *sweep >= std::f64::consts::TAU - 0.05 {
+        for &(a, b, in_depth) in segs.iter() {
+            grid.sweep_capsule((a, b), r, z_end, in_depth, swept, swept_z);
+        }
+    }
+    segs.clear();
+    *sweep = 0.0;
+}
+
+fn move_tangent(arc: Option<ArcMove>, cur: Point2, chord: (f64, f64)) -> (f64, f64) {
+    if let Some(a) = arc
+        && a.plane.is_xy()
+    {
+        let rx = cur.x - a.center.x;
+        let ry = cur.y - a.center.y;
+        if rx * rx + ry * ry > 1e-12 {
+            return if a.ccw { (-ry, rx) } else { (ry, -rx) };
+        }
+    }
+    chord
+}
diff --git a/crates/motion/tests/shape_masks.rs b/crates/motion/tests/shape_masks.rs
new file mode 100644
index 000000000..02a9038a6
--- /dev/null
+++ b/crates/motion/tests/shape_masks.rs
@@ -0,0 +1,331 @@
+//! Integration and unit tests for the 2D toolpath shape-mask verifier (#1768).
+//! Gate map: covers camcraft_motion::machining2d (adaptive, pocket, pocket_hsm, slots, slot_ends, trochoid_slot).
+
+mod common;
+
+use std::fs;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::PathBuf;
+
+use camcraft_motion::cl::{MoveKind, PathBuilder, Toolpath};
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::geometry::Point3;
+use camcraft_motion::links::Links;
+use camcraft_motion::machining2d::{
+    PocketParams, PocketStrategy, SlotParams, pocket, slot, slot_extended_ends,
+};
+use common::shape_mask::{CutDepth, MaskSpec, ShapeMask, Symmetry};
+
+fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Region {
+    let lp = Loop::new(vec![
+        Point2::new(x0, y0),
+        Point2::new(x1, y0),
+        Point2::new(x1, y1),
+        Point2::new(x0, y1),
+    ]);
+    let Ok(lp) = lp else { panic!("rect loop") };
+    let Ok(reg) = Region::new(vec![lp]) else { panic!("rect region") };
+    reg
+}
+
+fn scratch_dir(tag: &str) -> PathBuf {
+    let base = std::env::var_os("CARGO_TARGET_TMPDIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(std::env::temp_dir);
+    let dir = base.join("shape-mask-unit-diffs").join(tag);
+    let _ = fs::remove_dir_all(&dir);
+    dir
+}
+
+fn line_path(pts: &[(f64, f64, f64)]) -> Toolpath {
+    let mut b = PathBuilder::approached(Point3::new(pts[0].0, pts[0].1, 5.0));
+    b.push(MoveKind::Rapid, Point3::new(pts[0].0, pts[0].1, 5.0), None);
+    b.push(MoveKind::Plunge, Point3::new(pts[0].0, pts[0].1, pts[0].2), Some(200.0));
+    for &(x, y, z) in &pts[1..] {
+        b.push(MoveKind::Feed, Point3::new(x, y, z), Some(600.0));
+    }
+    b.push(MoveKind::Rapid, Point3::new(pts[pts.len() - 1].0, pts[pts.len() - 1].1, 5.0), None);
+    b.finish()
+}
+
+#[test]
+fn shape_mask_catches_overcut_and_writes_diff_png() {
+    let expected = rect(-10.0, -5.0, 10.0, 5.0);
+    // D=6 (r=3): y=0 keeps edges inside [-3, 3], y=4 extends edge to y=7 (2 mm outside [-5, 5]).
+    let path = line_path(&[(-7.0, 0.0, -2.0), (7.0, 0.0, -2.0), (7.0, 4.0, -2.0)]);
+    let dir = scratch_dir("overcut");
+    let spec = MaskSpec {
+        name: "overcut_unit",
+        expected: &expected,
+        path: &path,
+        tool_diameter: 6.0,
+        cell: 0.25,
+        depth: CutDepth::AllCut,
+        diff_dir: Some(&dir),
+    };
+    let Ok(mask) = ShapeMask::evaluate(&spec) else { panic!("evaluate") };
+    assert!(mask.metrics().overcut_cells > 0);
+    let res = catch_unwind(AssertUnwindSafe(|| mask.assert_no_overcut()));
+    assert!(res.is_err(), "expected overcut assertion to fail");
+    let png_path = dir.join("overcut_unit.png");
+    let Ok(bytes) = fs::read(&png_path) else { panic!("expected diff png at {png_path:?}") };
+    assert!(bytes.starts_with(b"\x89PNG\r\n\x1a\n"), "invalid PNG signature");
+    assert!(bytes.windows(4).any(|w| w == b"IHDR"));
+    assert!(bytes.windows(4).any(|w| w == b"IDAT"));
+    assert!(bytes.windows(4).any(|w| w == b"IEND"));
+    let _ = fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn shape_mask_catches_out_of_grid_escape_without_oom() {
+    let expected = rect(-10.0, -10.0, 10.0, 10.0);
+    let path = line_path(&[(0.0, 0.0, -1.0), (50_000.0, 0.0, -1.0)]);
+    let dir = scratch_dir("oob");
+    let spec = MaskSpec {
+        name: "escape_unit",
+        expected: &expected,
+        path: &path,
+        tool_diameter: 6.0,
+        cell: 0.25,
+        depth: CutDepth::AllCut,
+        diff_dir: Some(&dir),
+    };
+    let Ok(mask) = ShapeMask::evaluate(&spec) else { panic!("evaluate should handle escape without OOM") };
+    assert!(mask.metrics().out_of_grid_moves > 0);
+    assert!(catch_unwind(AssertUnwindSafe(|| mask.assert_no_overcut())).is_err());
+    let _ = fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn shape_mask_catches_disallowed_interior_leftover_and_allows_stated_corners() {
+    // 20x20 square pocket, cutter diameter 6 (r=3): pass covers top/bottom bands leaving center strip uncut,
+    // plus small sharp-corner cusps.
+    let expected = rect(-10.0, -10.0, 10.0, 10.0);
+    let mut b = PathBuilder::approached(Point3::new(-7.0, -7.0, 5.0));
+    b.push(MoveKind::Rapid, Point3::new(-7.0, -7.0, 5.0), None);
+    b.push(MoveKind::Plunge, Point3::new(-7.0, -7.0, -1.0), Some(200.0));
+    b.push(MoveKind::Feed, Point3::new(7.0, -7.0, -1.0), Some(600.0));
+    b.push(MoveKind::Feed, Point3::new(7.0, 7.0, -1.0), Some(600.0));
+    b.push(MoveKind::Feed, Point3::new(-7.0, 7.0, -1.0), Some(600.0));
+    b.push(MoveKind::Feed, Point3::new(-7.0, -7.0, -1.0), Some(600.0));
+    b.push(MoveKind::Rapid, Point3::new(-7.0, -7.0, 5.0), None);
+    let path = b.finish();
+    let dir = scratch_dir("leftover");
+    let spec = MaskSpec {
+        name: "leftover_unit",
+        expected: &expected,
+        path: &path,
+        tool_diameter: 6.0,
+        cell: 0.25,
+        depth: CutDepth::AllCut,
+        diff_dir: Some(&dir),
+    };
