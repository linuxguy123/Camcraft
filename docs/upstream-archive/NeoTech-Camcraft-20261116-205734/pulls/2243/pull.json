  "title": "fix(ui): compute a chain selection's geometry once, not on each frame",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
