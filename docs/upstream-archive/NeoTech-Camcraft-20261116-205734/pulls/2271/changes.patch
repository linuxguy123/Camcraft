From 5b5b5d6c8b606ee730a98ac34fafeea7249fa7a2 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Mon, 16 Nov 2026 12:52:04 -0800
Subject: [PATCH 1/2] fix(test): give the section-mode test's Tilt its
 basis_version

PR #2157 added the required field Tilt::basis_version; PR #2245 added a
unit test with the old Tilt literal. Each built alone; together the test
build fails (E0063). Use basis_version: 1, as every other new literal does.

Fixes #2270

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/src/posting_section_mode.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/app/src/posting_section_mode.rs b/crates/app/src/posting_section_mode.rs
index 9323976bf..24b1c1574 100644
--- a/crates/app/src/posting_section_mode.rs
+++ b/crates/app/src/posting_section_mode.rs
@@ -130,7 +130,7 @@ mod tests {
         assert_eq!(classify(&sample_face(None), &empty), Some(SectionMode::ThreeAxis));
         assert_eq!(
             classify(
-                &sample_face(Some(Tilt { a_deg: 0.0, b_deg: 45.0, origin: [0.0; 3] })),
+                &sample_face(Some(Tilt { basis_version: 1, a_deg: 0.0, b_deg: 45.0, origin: [0.0; 3] })),
                 &empty
             ),
             Some(SectionMode::Indexed3Plus2)

