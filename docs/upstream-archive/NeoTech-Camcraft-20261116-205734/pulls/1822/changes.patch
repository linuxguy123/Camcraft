+fn tabbed(pick: Option<Point2>) -> ContourParams {
+    // The -4 level stands below the 1 mm tab top; -2 stands above it.
+    ContourParams { tab_count: 2, tab_width: 4.0, tab_height: 1.0, ..params(pick) }
+}
