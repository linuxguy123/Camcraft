diff --git a/crates/app/src/mcp/provider.rs b/crates/app/src/mcp/provider.rs
new file mode 100644
index 000000000..35201e3c5
--- /dev/null
+++ b/crates/app/src/mcp/provider.rs
@@ -0,0 +1,127 @@
+//! Provider-neutral schemas for the live MCP tool table (#1943).
+//! Provenance: public Anthropic Messages, OpenAI function calling and Gemini FunctionDeclaration documentation.
+
+use super::tools as registry;
+use serde_json::{Value, json};
+
+pub use super::fallback::{FallbackMode, PendingCall, parse_prompt, prompt_context, qa_context};
+pub use super::provider_calls::{ToolCall, parse_calls, tool_result};
+
+/// Select the wire format by endpoint, including Responses-only models.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Provider {
+    Anthropic,
+    OpenAiChat,
+    OpenAiResponses,
+    Gemini,
+}
+
+/// The `tools` request field. Read the registry on every request, without a cache.
+/// OpenAI stays non-strict: MCP has optional fields and typed additional properties.
+#[must_use]
+pub fn tools(provider: Provider) -> Vec<Value> {
+    let rows: Vec<Value> = registry::list()
+        .into_iter()
+        .map(|tool| {
+            let name = &tool["name"];
+            let description = &tool["description"];
+            let schema = &tool["inputSchema"];
+            match provider {
+                Provider::Anthropic => json!({"name":name,"description":description,"input_schema":schema}),
+                Provider::OpenAiChat => json!({"type":"function","function":{
+                    "name":name,"description":description,"parameters":schema,"strict":false
+                }}),
+                Provider::OpenAiResponses => json!({"type":"function","name":name,
+                "description":description,"parameters":schema,"strict":false}),
+                Provider::Gemini => json!({"name":name,"description":description,
+                "parametersJsonSchema":gemini_schema(schema)}),
+            }
+        })
+        .collect();
+    if provider == Provider::Gemini {
+        vec![json!({"functionDeclarations":rows})]
+    } else {
+        rows
+    }
+}
+
+/// Walk schema locations only: names and literal enum/default values are data.
+fn gemini_schema(schema: &Value) -> Value {
+    let Value::Object(source) = schema else {
+        return schema.clone();
+    };
+    let mut out = source.clone();
+    out.remove("$schema");
+    if let Some(Value::Array(types)) = out.remove("type") {
+        // Keep sibling constraints; JSON Schema applies them only to relevant types.
+        let union = json!({"anyOf":types.iter().map(|t| json!({"type":t})).collect::<Vec<_>>()});
+        if out.contains_key("anyOf") {
+            let mut all = out
+                .remove("allOf")
+                .and_then(|v| v.as_array().cloned())
+                .unwrap_or_default();
+            all.push(union);
+            out.insert("allOf".into(), json!(all));
+        } else {
+            out.insert("anyOf".into(), union["anyOf"].clone());
+        }
+    } else if let Some(kind) = source.get("type") {
+        out.insert("type".into(), kind.clone());
+    }
+    for key in ["properties", "$defs", "definitions", "patternProperties"] {
+        if let Some(Value::Object(properties)) = out.get_mut(key) {
+            for value in properties.values_mut() {
+                *value = gemini_schema(value);
+            }
+        }
+    }
+    for key in ["items", "additionalProperties", "not", "contains", "if", "then", "else"] {
+        if let Some(value) = out.get_mut(key) {
+            *value = gemini_schema(value);
+        }
+    }
+    for key in ["anyOf", "oneOf", "allOf", "prefixItems"] {
+        if let Some(Value::Array(rows)) = out.get_mut(key) {
+            for row in rows {
+                *row = gemini_schema(row);
+            }
+        }
+    }
+    Value::Object(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn gemini_normalization_strips_schema_keywords_and_preserves_literal_data() {
+        let literal = json!({"$schema":"literal","type":["literal","values"]});
+        let schema = json!({"$schema":"https://json-schema.org/draft/2020-12/schema",
+            "type":"object","properties":{
+                "$schema":{"type":"string","default":"literal"},
+                "choice":{"$schema":"nested","type":["object","null"],"enum":[literal],"default":literal}
+            },"additionalProperties":{"$schema":"nested","type":["number","null"]}});
+        let mapped = gemini_schema(&schema);
+        assert!(mapped.get("$schema").is_none());
+        assert_eq!(mapped["properties"]["$schema"], schema["properties"]["$schema"]);
+        let choice = &mapped["properties"]["choice"];
+        assert!(choice.get("$schema").is_none());
+        assert!(choice.get("type").is_none());
+        assert_eq!(choice["anyOf"], json!([{"type":"object"},{"type":"null"}]));
+        assert_eq!(choice["enum"], json!([literal]));
+        assert_eq!(choice["default"], literal);
+        assert_eq!(mapped["additionalProperties"], json!({"anyOf":[{"type":"number"},{"type":"null"}]}));
+    }
+
+    #[test]
+    fn gemini_type_union_preserves_existing_combinators() {
+        let schema = json!({"type":["string","null"],"anyOf":[{"enum":["a",null]}],"allOf":[{"description":"existing"}]});
+        let mapped = gemini_schema(&schema);
+        assert_eq!(mapped["anyOf"], schema["anyOf"]);
+        assert_eq!(mapped["allOf"], json!([
+            {"description":"existing"},{"anyOf":[{"type":"string"},{"type":"null"}]}
+        ]));
+        assert!(mapped.get("type").is_none());
+    }
+}
diff --git a/crates/app/src/mcp/provider_calls.rs b/crates/app/src/mcp/provider_calls.rs
new file mode 100644
index 000000000..0b9465ae9
--- /dev/null
+++ b/crates/app/src/mcp/provider_calls.rs
@@ -0,0 +1,104 @@
+//! Translate provider call and result envelopes without executing a tool.
+//! Provenance: public Anthropic tool_use/tool_result, OpenAI function calling and Gemini functionCall/functionResponse formats.
+
+use super::{provider::Provider, schema_validation};
+use serde_json::{Value, json};
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ToolCall {
+    pub id: String,
+    pub name: String,
+    pub arguments: Value,
+}
+
+/// Parse a complete, non-streaming response. Select the first completion/candidate.
+/// The caller retains the original envelope for reasoning items and thought signatures.
+/// This function validates arguments but does not dispatch or grant permission.
+pub fn parse_calls(provider: Provider, response: &Value) -> Result<Vec<ToolCall>, String> {
+    if !response.is_object() || response.get("error").is_some() {
+        return Err("provider response must be an object without an API error".into());
+    }
+    let blocks = match provider {
+        Provider::Anthropic => array(&response["content"], "content")?,
+        Provider::OpenAiResponses => array(&response["output"], "output")?,
+        Provider::OpenAiChat => array(&response["choices"][0]["message"]["tool_calls"], "tool_calls")?,
+        Provider::Gemini => array(&response["candidates"][0]["content"]["parts"], "parts")?,
+    };
+    let mut calls: Vec<ToolCall> = Vec::new();
+    for block in blocks {
+        let (raw, id_key, args_key, encoded) = match provider {
+            Provider::Anthropic if block["type"] == "tool_use" => (block, "id", "input", false),
+            Provider::OpenAiResponses if block["type"] == "function_call" => (block, "call_id", "arguments", true),
+            Provider::OpenAiChat => {
+                if block["type"] != "function" {
+                    return Err("tool_calls.type must be function".into());
+                }
+                (&block["function"], "id", "arguments", true)
+            }
+            Provider::Gemini if block.get("functionCall").is_some() => (&block["functionCall"], "id", "args", false),
+            _ => continue,
+        };
+        let name = string(raw, "name")?;
+        let id_source = if provider == Provider::OpenAiChat { block } else { raw };
+        let id = if provider == Provider::Gemini && id_source.get(id_key).is_none() {
+            String::new()
+        } else {
+            string(id_source, id_key)?.to_owned()
+        };
+        let arguments = if encoded {
+            serde_json::from_str(string(raw, args_key)?).map_err(|e| format!("{name}.{args_key}: {e}"))?
+        } else if provider == Provider::Gemini {
+            raw.get(args_key).cloned().unwrap_or_else(|| json!({}))
+        } else {
+            raw.get(args_key)
+                .cloned()
+                .ok_or_else(|| format!("{name}.{args_key} is required"))?
+        };
+        schema_validation::arguments(name, &arguments)?;
+        if !id.is_empty() && calls.iter().any(|c| c.id == id) {
+            return Err(format!("duplicate tool call id '{id}'"));
+        }
+        calls.push(ToolCall {
+            id,
+            name: name.to_owned(),
+            arguments,
+        });
+    }
+    Ok(calls)
+}
+
+fn array<'a>(value: &'a Value, field: &str) -> Result<&'a [Value], String> {
+    match value {
+        Value::Null => Ok(&[]),
+        Value::Array(rows) => Ok(rows),
+        _ => Err(format!("provider {field} must be an array")),
+    }
+}
+
+fn string<'a>(value: &'a Value, field: &str) -> Result<&'a str, String> {
+    value
+        .get(field)
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty())
+        .ok_or_else(|| format!("provider {field} must be a nonempty string"))
+}
+
+/// A result block (Anthropic), message (Chat), input item (Responses) or part
+/// (Gemini). Pass the MCP result including `isError`; never erase a refusal.
+#[must_use]
+pub fn tool_result(provider: Provider, call: &ToolCall, result: &Value) -> Value {
+    let content = result.to_string();
+    match provider {
+        Provider::Anthropic => json!({"type":"tool_result","tool_use_id":call.id,
+            "content":content,"is_error":result["isError"].as_bool().unwrap_or(false)}),
+        Provider::OpenAiChat => json!({"role":"tool","tool_call_id":call.id,"content":content}),
+        Provider::OpenAiResponses => json!({"type":"function_call_output","call_id":call.id,"output":content}),
+        Provider::Gemini => {
+            let mut response = json!({"name":call.name,"response":result});
+            if !call.id.is_empty() {
+                response["id"] = json!(call.id);
+            }
+            json!({"functionResponse":response})
+        }
+    }
+}
diff --git a/crates/app/src/mcp/schema_validation.rs b/crates/app/src/mcp/schema_validation.rs
new file mode 100644
index 000000000..ca6f5c15e
--- /dev/null
+++ b/crates/app/src/mcp/schema_validation.rs
@@ -0,0 +1,184 @@
+//! Validate provider arguments against the live MCP schema before dispatch.
+//! Provenance: JSON Schema validation vocabulary (json-schema.org); the subset used by our MCP registry.
+
+use super::tools;
+use serde_json::Value;
+
+pub(super) fn arguments(name: &str, args: &Value) -> Result<(), String> {
+    let tool = tools::list()
+        .into_iter()
+        .find(|t| t["name"].as_str() == Some(name))
+        .ok_or_else(|| format!("unknown tool '{name}'"))?;
+    if !args.is_object() {
+        return Err(format!("{name}.arguments must be an object"));
+    }
+    validate(&tool["inputSchema"], args, &format!("{name}.arguments"))
+}
+
+fn validate(schema: &Value, value: &Value, path: &str) -> Result<(), String> {
+    if schema == &Value::Bool(true) {
+        return Ok(());
+    }
+    if schema == &Value::Bool(false) {
+        return Err(format!("{path} is not allowed"));
+    }
+    let fields = schema
+        .as_object()
+        .ok_or_else(|| format!("{path}: invalid tool schema"))?;
+    // New validation keywords must be implemented before they can authorize a local edit.
+    for key in fields.keys() {
+        if !matches!(
+            key.as_str(),
+            "type"
+                | "properties"
+                | "required"
+                | "additionalProperties"
+                | "items"
+                | "enum"
+                | "minimum"
+                | "maximum"
+                | "minItems"
+                | "maxItems"
+                | "anyOf"
+                | "allOf"
+                | "oneOf"
+                | "description"
+                | "title"
+                | "default"
+                | "$schema"
+                | "$comment"
+                | "examples"
+        ) {
+            return Err(format!("{path}: unsupported schema keyword '{key}'"));
+        }
+    }
+    if let Some(types) = fields.get("type") {
+        let valid = match types {
+            Value::String(kind) => has_type(value, kind),
+            Value::Array(kinds) => kinds.iter().any(|t| t.as_str().is_some_and(|t| has_type(value, t))),
+            _ => false,
+        };
+        if !valid {
+            return Err(format!("{path} must have type {types}"));
+        }
+    }
+    if let Some(choices) = fields.get("enum").and_then(Value::as_array)
+        && !choices.contains(value)
+    {
+        return Err(format!("{path} must be one of {}", Value::Array(choices.clone())));
+    }
+    for key in ["anyOf", "oneOf", "allOf"] {
+        if let Some(branches) = fields.get(key).and_then(Value::as_array) {
+            let passed = branches.iter().filter(|s| validate(s, value, path).is_ok()).count();
+            let valid = match key {
+                "anyOf" => passed > 0,
+                "oneOf" => passed == 1,
+                _ => passed == branches.len(),
+            };
+            if !valid {
+                return Err(format!("{path} does not satisfy {key}"));
+            }
+        }
+    }
+    if let Some(number) = value.as_f64() {
+        for (key, lower) in [("minimum", true), ("maximum", false)] {
+            if let Some(limit) = fields.get(key).and_then(Value::as_f64)
+                && ((lower && number < limit) || (!lower && number > limit))
+            {
+                return Err(format!("{path} violates {key} {limit}"));
+            }
+        }
+    }
+    if let Some(array) = value.as_array() {
+        for (key, lower) in [("minItems", true), ("maxItems", false)] {
+            if let Some(limit) = fields.get(key).and_then(Value::as_u64)
+                && ((lower && (array.len() as u64) < limit) || (!lower && (array.len() as u64) > limit))
+            {
+                return Err(format!("{path} violates {key} {limit}"));
+            }
+        }
+        if let Some(item_schema) = fields.get("items") {
+            for (index, item) in array.iter().enumerate() {
+                validate(item_schema, item, &format!("{path}[{index}]"))?;
+            }
+        }
+    }
+    if let Some(object) = value.as_object() {
+        if let Some(required) = fields.get("required").and_then(Value::as_array) {
+            for key in required.iter().filter_map(Value::as_str) {
+                if !object.contains_key(key) {
+                    return Err(format!("{path}.{key} is required"));
+                }
+            }
+        }
+        for (key, value) in object {
+            let child = format!("{path}.{key}");
+            if let Some(property) = fields.get("properties").and_then(|p| p.get(key)) {
+                validate(property, value, &child)?;
+            } else if let Some(extra) = fields.get("additionalProperties") {
+                validate(extra, value, &child)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn has_type(value: &Value, kind: &str) -> bool {
+    match kind {
+        "null" => value.is_null(),
+        "string" => value.is_string(),
+        "boolean" => value.is_boolean(),
+        "object" => value.is_object(),
+        "array" => value.is_array(),
+        "number" => value.is_number(),
+        "integer" => value.as_f64().is_some_and(|n| n.fract() == 0.0),
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn boolean_schemas_and_invalid_schema_shapes_refuse_by_name() {
+        assert!(validate(&json!(true), &json!({}), "argument").is_ok());
+        let error = validate(&json!(false), &json!({}), "argument").expect_err("false refuses");
+        assert!(error.contains("argument is not allowed"), "{error}");
+        for schema in [Value::Null, json!("invalid"), json!([])] {
+            let error = validate(&schema, &json!({}), "argument").expect_err("invalid schema refuses");
+            assert!(error.contains("argument: invalid tool schema"), "{error}");
+        }
+    }
+
+    #[test]
+    fn new_schema_keywords_refuse_authorization_by_name() {
+        let error = validate(&json!({"type":"string","pattern":"^safe$"}), &json!("unsafe"), "test.argument")
+            .expect_err("unimplemented keyword must refuse");
+        assert!(error.contains("pattern"), "{error}");
+        assert!(error.contains("test.argument"), "{error}");
+    }
+
+    #[test]
+    fn schema_combinators_enforce_their_distinct_match_counts() {
+        for (schema, accepted, refused) in [
+            (json!({"anyOf":[{"type":"string"},{"type":"number"}]}), json!(3), json!(true)),
+            (json!({"allOf":[{"type":"number"},{"minimum":2}]}), json!(3), json!(1)),
+            (json!({"oneOf":[{"type":"number"},{"enum":[2]}]}), json!(3), json!(2)),
+        ] {
+            assert!(validate(&schema, &accepted, "test.argument").is_ok(), "{schema}");
+            assert!(validate(&schema, &refused, "test.argument").is_err(), "{schema}");
+        }
+    }
+
+    #[test]
+    fn nullable_types_keep_the_literal_enum_constraint() {
+        let schema = json!({"type":["string","null"],"enum":["steel"]});
+        assert!(validate(&schema, &json!("steel"), "material").is_ok());
+        assert!(validate(&schema, &Value::Null, "material").is_err());
+        assert!(validate(&json!({"type":["number","null"]}), &Value::Null, "number").is_ok());
+        assert!(validate(&json!({"type":["number","null"]}), &json!(3.5), "number").is_ok());
+        assert!(validate(&json!({"type":["number","null"]}), &json!("3.5"), "number").is_err());
+    }
+}
