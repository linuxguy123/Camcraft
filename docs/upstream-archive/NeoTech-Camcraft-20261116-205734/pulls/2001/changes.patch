+    let result = machine::check_ops(&w, &machine(), &[("Cached".into(), e)]).unwrap();
+    assert!(result.problems.iter().any(|p| p.contains("rotary axis")), "{result:?}");
+    assert!(result.problems.iter().any(|p| p.contains("requires a waterjet tool")), "{result:?}");
+}
