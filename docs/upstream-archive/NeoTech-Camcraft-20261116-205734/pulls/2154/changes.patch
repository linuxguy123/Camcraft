+    anchor_first_pass(&mut passes, &plan, p);
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, p.clearance_z));
+    notes.into_iter().for_each(|n| b.note(n));
+    emit_pocket_passes(
+        b,
+        p,
+        PocketWalks {
+            center: &plan.center,
+            links_center: &cut_center,
+            strategy: p.strategy,
+            passes,
+            room: None,
+            joins: Vec::new(),
+            hold_crossings: true,
+            holes: &[],
+        },
+    )
