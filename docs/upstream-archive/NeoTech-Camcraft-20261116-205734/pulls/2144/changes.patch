+    ));
+    let moves = [Move::new(
+        MoveKind::Feed,
+        Point3::new(-3.0, 8.2, 2.0),
+        Point3::new(15.0, 8.2, 2.0),
+        Some(300.0),
+    )];
+    stock
+        .simulate(&[SimOp { moves: &moves, radius: 2.0, ball: false, cone: None, corner: None }])
