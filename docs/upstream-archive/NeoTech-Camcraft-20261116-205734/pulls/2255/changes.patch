+#[must_use]
+pub fn fill_of(region: &Region) -> Option<Fill> {
+    let _s = crate::frame_cost::span("ui/properties.boundary.preview.triangulate");
+    region.triangles().ok().filter(|t| !t.is_empty()).map(Arc::from)
+}
