diff --git a/crates/motion/src/machining2d/adaptive/raster/conservative.rs b/crates/motion/src/machining2d/adaptive/raster/conservative.rs
new file mode 100644
index 000000000..54ac547cb
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/raster/conservative.rs
@@ -0,0 +1,85 @@
+//! The in-process stock read from a region that only BOUNDS the
+//! material (issue 2031): the remaining stock earlier operations left
+//! is known as a superset, so a cell stands as material wherever that
+//! superset may reach it. Provenance: conservative rasterization - a
+//! cell is covered when the shape, grown by the cell's half diagonal,
+//! holds its center (the Minkowski-sum reading of overestimated
+//! conservative rasterization, Hasselgren, Akenine-Moller and Ohlsson,
+//! "Conservative Rasterization", GPU Gems 2, 2005). The growth and the
+//! queries are ours.
+
+use crate::geo2d::{Point2, Region};
+
+use super::Raster;
+
+/// Slack added to the half diagonal (mm): two polygon-offset arc
+/// tolerances, so the offset's own flats cannot lose a cell.
+const GROW_SLACK: f64 = 0.01;
+
+impl Raster {
+    /// How far a bound on the material is grown before it is sampled at
+    /// cell centers, so every cell it touches stands as material.
+    pub(in crate::machining2d::adaptive) fn conservative_growth(&self) -> f64 {
+        self.h * std::f64::consts::FRAC_1_SQRT_2 + GROW_SLACK
+    }
+
+    /// Keep material only in the cells whose centers lie inside
+    /// `material` (already grown by [`Self::conservative_growth`]); the
+    /// walls stay what the grid was built with.
+    pub(in crate::machining2d::adaptive) fn keep(&mut self, material: &Region) {
+        let mut inside = vec![false; self.cells.len()];
+        let mut xs: Vec<f64> = Vec::new();
+        for iy in 0..self.ny {
+            let y = self.y0 + (iy as f64 + 0.5) * self.h;
+            xs.clear();
+            for l in material.loops() {
+                let pts = l.points();
+                let n = pts.len();
+                for i in 0..n {
+                    let (a, b) = (pts[i], pts[(i + 1) % n]);
+                    let (ylo, yhi) = if a.y <= b.y { (a.y, b.y) } else { (b.y, a.y) };
+                    if y >= ylo && y < yhi {
+                        xs.push(a.x + (y - a.y) * (b.x - a.x) / (b.y - a.y));
+                    }
+                }
+            }
+            xs.sort_by(f64::total_cmp);
+            for pair in xs.as_chunks::<2>().0 {
+                let i0 = ((pair[0] - self.x0) / self.h - 0.5).ceil().max(0.0) as usize;
+                let i1 = ((pair[1] - self.x0) / self.h - 0.5).floor();
+                if i1 < 0.0 {
+                    continue;
+                }
+                let i1 = (i1 as usize).min(self.nx - 1);
+                for ix in i0..=i1 {
+                    inside[ix + iy * self.nx] = true;
+                }
+            }
+        }
+        for (c, keep) in self.cells.iter_mut().zip(inside) {
+            *c &= keep;
+        }
+    }
+
+    /// Does the capsule of radius `rad` about `a -> b` hold no material
+    /// cell (walls aside)? Off the grid nothing is proved: `false`.
+    pub(in crate::machining2d::adaptive) fn air(&self, a: Point2, b: Point2, rad: f64) -> bool {
+        self.capsule_free(a, b, rad, false)
+    }
+
+    /// Does material stand between `inner` and `outer` of `p`, read on
+    /// four rings all round? (What a cutter standing at `p` would cut,
+    /// where its center is known to stand `inner` or more off the
+    /// material's outline.)
+    pub(in crate::machining2d::adaptive) fn touches(&self, p: Point2, inner: f64, outer: f64) -> bool {
+        const RING: usize = 180;
+        let step = std::f64::consts::TAU / RING as f64;
+        (0..4).any(|k| {
+            let rad = outer - (outer - inner) * f64::from(k) / 3.0;
+            (0..RING).any(|i| {
+                let a = i as f64 * step;
+                self.mat(Point2::new(p.x + rad * a.cos(), p.y + rad * a.sin()))
+            })
+        })
+    }
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/canon.rs b/crates/motion/src/machining2d/adaptive/rest/canon.rs
new file mode 100644
index 000000000..252bce976
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/rest/canon.rs
@@ -0,0 +1,233 @@
+//! The walls of the legal center area as ONE fixed vertex list (issue
+//! 2031). Every rest pass that rides a wall rides it on these vertices,
+//! so two passes over the same stretch of wall share their chords
+//! exactly and can never cross by a rounding (the verifier's crossing
+//! law reads exact signs; a shared end point or a collinear retrace is
+//! no crossing, a chord a nanometre off another's line is one).
+//! Provenance: our own bookkeeping over the polygon clipper's output
+//! (its intersection vertices are snapped to a 1 nm lattice and its
+//! offsets rebuild a curved wall on other chords, which is what makes a
+//! re-derived wall vertex stand off the wall's line); the
+//! bucket grid is the textbook uniform-grid proximity query (de Berg et
+//! al., "Computational Geometry", 3rd ed., Springer 2008).
+
+use crate::geo2d::{Point2, Region};
+
+use std::collections::HashMap;
+
+use super::super::front::dist;
+
+/// A room vertex this close to a wall chord (mm) stands on the wall:
+/// past the 5 um flats the polygon offsets leave on a wall they rebuild
+/// (an opened room's walls are the same walls, cut into other chords).
+const ON_WALL: f64 = 0.05;
+
+/// A wall vertex: (loop, vertex index).
+pub(super) type WallAt = (usize, usize);
+
+/// A point of a pass: on the wall or off it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Vtx {
+    pub p: Point2,
+    pub at: Option<WallAt>,
+}
+
+/// The wall loops, densified once, with their arc lengths and a bucket
+/// grid of their chords.
+pub(super) struct Canon {
+    loops: Vec<Vec<Point2>>,
+    /// Per loop: arc length at each vertex, the total last.
+    s: Vec<Vec<f64>>,
+    x0: f64,
+    y0: f64,
+    c: f64,
+    nx: usize,
+    ny: usize,
+    cells: Vec<Vec<(u32, u32)>>,
+    /// Each wall vertex by its exact coordinates.
+    index: HashMap<(u64, u64), (usize, usize)>,
+}
+
+/// A loop with points put on its edges so no chord is longer than
+/// `seg`; the loop's own vertices stay exactly as they are.
+fn cut_edges(pts: &[Point2], seg: f64) -> Vec<Point2> {
+    let n = pts.len();
+    let mut out = Vec::with_capacity(n * 2);
+    for i in 0..n {
+        let (a, b) = (pts[i], pts[(i + 1) % n]);
+        out.push(a);
+        let k = ((dist(a, b) / seg).ceil() as usize).clamp(1, 4096);
+        for j in 1..k {
+            let t = j as f64 / k as f64;
+            out.push(Point2::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t));
+        }
+    }
+    out
+}
+
+impl Canon {
+    /// The walls of `center`, no chord longer than `seg`.
+    pub(super) fn new(center: &Region, seg: f64) -> Self {
+        let loops: Vec<Vec<Point2>> =
+            center.loops().iter().map(|l| cut_edges(l.points(), seg.max(1e-6))).filter(|l| l.len() >= 3).collect();
+        let mut index = HashMap::new();
+        for (l, lp) in loops.iter().enumerate() {
+            for (k, p) in lp.iter().enumerate() {
+                index.insert((p.x.to_bits(), p.y.to_bits()), (l, k));
+            }
+        }
+        let s = loops
+            .iter()
+            .map(|l| {
+                let mut s = Vec::with_capacity(l.len() + 1);
+                s.push(0.0);
+                for i in 0..l.len() {
+                    s.push(s[i] + dist(l[i], l[(i + 1) % l.len()]));
+                }
+                s
+            })
+            .collect();
+        let (lo, hi) = center.bounds().unwrap_or((Point2::new(0.0, 0.0), Point2::new(1.0, 1.0)));
+        let span = (hi.x - lo.x).max(hi.y - lo.y).max(1e-6);
+        let c = (2.0 * seg).max(span / 512.0).max(1e-6);
+        let nx = ((hi.x - lo.x) / c).floor() as usize + 3;
+        let ny = ((hi.y - lo.y) / c).floor() as usize + 3;
+        let mut canon = Canon { loops, s, x0: lo.x - c, y0: lo.y - c, c, nx, ny, cells: vec![Vec::new(); nx * ny], index };
+        for l in 0..canon.loops.len() {
+            let n = canon.loops[l].len();
+            for k in 0..n {
+                let (a, b) = (canon.loops[l][k], canon.loops[l][(k + 1) % n]);
+                let (i0, j0) = canon.cell(a.x.min(b.x) - ON_WALL, a.y.min(b.y) - ON_WALL);
+                let (i1, j1) = canon.cell(a.x.max(b.x) + ON_WALL, a.y.max(b.y) + ON_WALL);
+                for j in j0..=j1 {
+                    for i in i0..=i1 {
+                        canon.cells[i + j * nx].push((l as u32, k as u32));
+                    }
+                }
+            }
+        }
+        canon
+    }
+
+    fn cell(&self, x: f64, y: f64) -> (usize, usize) {
+        let i = ((x - self.x0) / self.c).floor().clamp(0.0, (self.nx - 1) as f64) as usize;
+        let j = ((y - self.y0) / self.c).floor().clamp(0.0, (self.ny - 1) as f64) as usize;
+        (i, j)
+    }
+
+    /// Is `a -> b` a chord of a wall itself: two wall vertices next to
+    /// each other on one loop? (Legal by construction; a point put on a
+    /// slanted wall stands an ulp off its line, where a segment test
+    /// against that same wall is noise.)
+    pub(super) fn wall_chord(&self, a: Point2, b: Point2) -> bool {
+        let at = |p: Point2| self.index.get(&(p.x.to_bits(), p.y.to_bits())).copied();
+        match (at(a), at(b)) {
+            (Some((la, ka)), Some((lb, kb))) if la == lb => {
+                let n = self.loops[la].len();
+                (ka + 1) % n == kb || (kb + 1) % n == ka
+            }
+            _ => false,
+        }
+    }
+
+    /// The wall vertex `k` of loop `l`.
+    pub(super) fn point(&self, (l, k): (usize, usize)) -> Point2 {
+        self.loops.get(l).and_then(|lp| lp.get(k)).copied().unwrap_or_default()
+    }
+
+    /// The vertex `step` (+1 / -1) along loop `l` from `k`.
+    pub(super) fn next(&self, (l, k): (usize, usize), step: isize) -> (usize, usize) {
+        let n = self.loops.get(l).map_or(1, Vec::len).max(1);
+        (l, (k as isize + step).rem_euclid(n as isize) as usize)
+    }
+
+    /// Where `p` stands on the walls: (loop, vertex index + fraction
+    /// along the chord to the next vertex), or `None` off them.
+    fn locate(&self, p: Point2) -> Option<(usize, f64)> {
+        if !(p.x.is_finite() && p.y.is_finite()) {
+            return None;
+        }
+        let (i, j) = self.cell(p.x, p.y);
+        let mut best: Option<(f64, usize, f64)> = None;
+        for &(l, k) in &self.cells[i + j * self.nx] {
+            let (l, k) = (l as usize, k as usize);
+            let n = self.loops[l].len();
+            let (a, b) = (self.loops[l][k], self.loops[l][(k + 1) % n]);
+            let (dx, dy) = (b.x - a.x, b.y - a.y);
+            let dd = dx * dx + dy * dy;
+            let t = if dd > 0.0 { (((p.x - a.x) * dx + (p.y - a.y) * dy) / dd).clamp(0.0, 1.0) } else { 0.0 };
+            let d = (p.x - a.x - t * dx).hypot(p.y - a.y - t * dy);
+            if d <= ON_WALL && best.is_none_or(|b| d < b.0) {
+                best = Some((d, l, k as f64 + t));
+            }
+        }
+        best.map(|(_, l, x)| (l, x))
+    }
+
+    /// Arc length along loop `l` forward from position `a` to `b`.
+    fn fwd(&self, l: usize, a: f64, b: f64) -> f64 {
+        let s = &self.s[l];
+        let n = s.len() - 1;
+        let at = |x: f64| {
+            let i = (x.floor().max(0.0) as usize).min(n - 1);
+            s[i] + (x - i as f64).clamp(0.0, 1.0) * (s[i + 1] - s[i])
+        };
+        (at(b) - at(a)).rem_euclid(s[n].max(1e-12))
+    }
+
+    /// A closed room loop with every wall stretch replaced by the wall's
+    /// own vertices. A vertex where the room's boundary leaves or meets
+    /// the wall (a clipper intersection, a nanometre off the chord) is
+    /// dropped: the pass leaves the wall at a wall vertex. Every chord of
+    /// a pass is proved inside the center area afterwards (`peel`).
+    pub(super) fn snap(&self, pts: &[Point2]) -> Vec<Vtx> {
+        let n = pts.len();
+        let pos: Vec<Option<(usize, f64)>> = pts.iter().map(|&p| self.locate(p)).collect();
+        // Is the room edge i -> i+1 a stretch of wall?
+        let links: Vec<bool> = (0..n)
+            .map(|i| match (pos[i], pos[(i + 1) % n]) {
+                (Some((la, a)), Some((lb, b))) if la == lb => {
+                    self.fwd(la, a, b) <= dist(pts[i], pts[(i + 1) % n]) * 1.01 + 1e-5
+                }
+                _ => false,
+            })
+            .collect();
+        let wall = |l: usize, k: usize| Vtx { p: self.loops[l][k], at: Some((l, k)) };
+        let Some(gap) = links.iter().position(|&l| !l) else {
+            // The room's loop IS a wall loop.
+            return pos.first().copied().flatten().map_or(Vec::new(), |(l, _)| (0..self.loops[l].len()).map(|k| wall(l, k)).collect());
+        };
+        let i0 = (gap + 1) % n;
+        let mut out = Vec::with_capacity(n);
+        let mut i = 0;
+        while i < n {
+            let a = (i0 + i) % n;
+            let Some((l, xa)) = pos[a] else {
+                out.push(Vtx { p: pts[a], at: None });
+                i += 1;
+                continue;
+            };
+            let mut j = i;
+            while j + 1 < n && links[(i0 + j) % n] {
+                j += 1;
+            }
+            let xb = pos[(i0 + j) % n].map_or(xa, |q| q.1);
+            let m = self.loops[l].len();
+            // The wall vertices from the first at or after `xa` to the
+            // last at or before `xb`, forward (the stretch may pass the
+            // loop's seam).
+            let first = (xa - 1e-9).ceil().max(0.0) as usize;
+            let mut last = (xb + 1e-9).floor().max(0.0) as usize;
+            if j > i && xb < xa {
+                last += m;
+            }
+            // (A lone wall vertex stays only when it is one of the
+            // wall's own: then `first == last`.)
+            for k in first..=last.min(first + m) {
+                out.push(wall(l, k % m));
+            }
+            i = j + 1;
+        }
+        out
+    }
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/entry.rs b/crates/motion/src/machining2d/adaptive/rest/entry.rs
new file mode 100644
index 000000000..d43e55268
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/rest/entry.rs
@@ -0,0 +1,82 @@
+//! Where a rest Adaptive pass may plunge (issue 2031): only where the
+//! whole cutter footprint, with a margin, is proved clear of the stock
+//! the earlier operations left - by the stock as it was given, never by
+//! what this operation's own passes have cut since (a column they
+//! cleared at this depth says nothing about the levels above it).
+//!
+//! Provenance: the clearance of a disc against a region is the region
+//! grown by the disc's radius (Minkowski sum; M. Held, "On the
+//! Computational Geometry of Pocket Machining", LNCS 500, Springer
+//! 1991). The proof is asked twice, of the polygon and of the
+//! conservative raster; the margin is ours. A clear tool AXIS proves
+//! nothing: issue 1490 measured rest plunges whose axis stood on
+//! cleared floor while the rim touched the corner's rest material.
+
+use crate::geo2d::{Point2, Region};
+use crate::machining2d::GenError;
+
+use super::super::front::{densify, dist};
+use super::super::link::inside;
+use super::super::raster::Raster;
+
+/// The proved-clear plunge positions of one cut depth.
+pub(super) struct Entries<'a> {
+    center: &'a Region,
+    /// Centers NOT proved clear: the stock's material grown by the tool
+    /// radius and half the margin.
+    blocked: Region,
+    /// The stock as it was given (conservative), never cut.
+    stock: Raster,
+    /// The footprint the raster proof asks clear.
+    footprint: f64,
+    /// Vertices of the proved-clear center area's boundary (a full
+    /// margin off the material).
+    spots: Vec<Point2>,
+    /// The entry guard (`stock::Guards::entry`).
+    on: bool,
+}
+
+impl<'a> Entries<'a> {
+    /// `material` is the bound on the stock's material at this depth,
+    /// `grow` the conservative growth the raster was built with.
+    pub(super) fn new(
+        center: &'a Region,
+        material: &Region,
+        stock: Raster,
+        (r, grow, margin, seg): (f64, f64, f64, f64),
+        on: bool,
+    ) -> Result<Self, GenError> {
+        let blocked = material.offset(grow + r + 0.5 * margin)?;
+        let free = center.difference(&material.offset(grow + r + margin)?)?;
+        let spots = free.loops().iter().flat_map(|l| densify(l.points(), seg.max(1e-6), true)).collect();
+        Ok(Entries { center, blocked, stock, footprint: r + 0.25 * margin, spots, on })
+    }
+
+    /// Is a plunge at `p` proved clear: a legal center, outside the
+    /// grown material, with no material cell under the footprint?
+    pub(super) fn proved(&self, p: Point2) -> bool {
+        if !self.on {
+            return true;
+        }
+        inside(self.center, p) && !self.blocked.contains(p) && self.stock.air(p, p, self.footprint)
+    }
+
+    /// Is any position proved at all?
+    pub(super) fn any(&self) -> bool {
+        !self.on || self.spots.iter().any(|&q| self.proved(q))
+    }
+
+    /// The `count` proved positions nearest any of `to`, nearest first.
+    pub(super) fn near(&self, to: &[Point2], count: usize) -> Vec<Point2> {
+        if !self.on {
+            // (With the guard off every position counts as proved, so
+            // the nearest is the asked one itself.)
+            return to.iter().take(count).copied().collect();
+        }
+        let d = |q: Point2| to.iter().map(|&t| dist(q, t)).fold(f64::INFINITY, f64::min);
+        let mut all: Vec<(f64, Point2)> = self.spots.iter().map(|&q| (d(q), q)).collect();
+        all.sort_by(|a, b| a.0.total_cmp(&b.0));
+        all.dedup_by(|a, b| dist(a.1, b.1) < 1e-9);
+        all.into_iter().map(|(_, q)| q).filter(|&q| self.proved(q)).take(count).collect()
+    }
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/leads.rs b/crates/motion/src/machining2d/adaptive/rest/leads.rs
new file mode 100644
index 000000000..1c3263916
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/rest/leads.rs
@@ -0,0 +1,257 @@
+//! How a rest pass is reached (issue 2031): a stay-down feed from where
+//! the last pass ended, or a retract and a plunge at a proved-clear
+//! position (`entry`) with a feed lead onto the run.
+//!
+//! A run that starts on a wall is led in ALONG that wall, on the wall's
+//! own vertices (`canon`), and a run of an area cut before is stretched
+//! along the walls to where that area's earlier passes started and
+//! ended: the way in, the way out and the link between them are then
+//! the very chords walked before, and a retrace is no crossing where a
+//! fresh chord a few microns off an earlier one would be. A closed run
+//! is reached on the chord most nearly tangent to it.
+//!
+//! Provenance: tangential lead-in of peripheral milling (machining
+//! handbooks; the roll-in of M. Otkur and I. Lazoglu, "Trochoidal
+//! milling", Int. J. Machine Tools and Manufacture 47, 2007, read as
+//! arriving along the cut, not square onto it). The candidates and
+//! their order are ours.
+
+use crate::geo2d::Point2;
+use crate::machining2d::chord_clears;
+
+use super::super::front::{dist, unit};
+use super::canon::{Vtx, WallAt};
+use super::peel::Peel;
+use super::runs::Run;
+
+/// A stay-down link is at most this many tool diameters long; past it
+/// the pass is reached by a retract and a rapid.
+const STAY_PER_D: f64 = 4.0;
+
+/// A wall lead looks for a proved position at most this many tool
+/// diameters back along the wall.
+const WALK_PER_D: f64 = 8.0;
+
+/// A run is stretched to an earlier pass's start or end at most this
+/// many tool diameters along the wall (the same corner, the same mouth
+/// of a neck - not the next one).
+const ANCHOR_PER_D: f64 = 3.0;
+
+/// Proved positions tried for one run.
+const SPOTS: usize = 6;
+
+/// One way to reach and cut a run.
+pub(super) struct Lead {
+    /// The feed, from where the tool stands or plunges.
+    pub pts: Vec<Point2>,
+    /// Reached by a retract and a plunge at `pts[0]`.
+    pub hop: bool,
+    /// How many points lead up to the run itself (every way of reaching
+    /// a run ends in the same run).
+    pub own: usize,
+    /// The wall vertices the feed lands on and leaves from, if any.
+    pub start: Option<WallAt>,
+    pub end: Option<WallAt>,
+}
+
+/// Where an earlier pass of the depth landed on a wall, and the proved
+/// position it plunged at (when it did).
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Anchor {
+    pub start: WallAt,
+    pub entry: Option<Point2>,
+}
+
+impl Peel<'_> {
+    /// The ways to reach and cut `run`, best first.
+    pub(super) fn leads(&self, run: &Run) -> Vec<Lead> {
+        let (r, center) = (self.lv.r, self.lv.center);
+        let Some(&first) = run.v.first() else { return Vec::new() };
+        let mut out: Vec<Lead> = Vec::new();
+        let stay = STAY_PER_D * 2.0 * r;
+        if run.closed {
+            let body: Vec<Point2> = run.v.iter().map(|v| v.p).collect();
+            let ring = |from: Point2| seat(&body, from, |q| chord_clears(center, from, q));
+            let lead = |from: Point2, hop: bool| Lead { pts: std::iter::once(from).chain(ring(from)).collect(), hop, own: 1, start: None, end: None };
+            if let Some(cur) = self.cur
+                && ring(cur).first().is_some_and(|&s| dist(cur, s) <= stay && chord_clears(center, cur, s))
+            {
+                out.push(lead(cur, false));
+            }
+            let samples: Vec<Point2> = body.iter().step_by((body.len() / 16).max(1)).copied().collect();
+            for e in self.entries.near(&samples, SPOTS) {
+                if ring(e).first().is_some_and(|&s| chord_clears(center, e, s)) {
+                    out.push(lead(e, true));
+                }
+            }
+            return out;
+        }
+        // Stretched along the walls to where the area was entered and
+        // left before.
+        let (pre, anchor) = self.back_to_anchor(first);
+        let mut v: Vec<Vtx> = pre;
+        v.extend(run.v.iter().copied());
+        if let Some(&last) = run.v.last() {
+            v.extend(self.on_to_end(last));
+        }
+        let body: Vec<Point2> = v.iter().map(|q| q.p).collect();
+        let (Some(&head), end) = (v.first(), v.last().and_then(|q| q.at)) else { return out };
+        let with = |lead: Vec<Point2>, hop: bool, start: Option<WallAt>| Lead {
+            own: lead.len(),
+            pts: lead.into_iter().chain(body.iter().skip(1).copied()).collect(),
+            hop,
+            start,
+            end,
+        };
+        if let Some(cur) = self.cur {
+            // Landing further back along the wall where there is no
+            // earlier landing to share.
+            let backs: &[f64] = if anchor.is_some() || head.at.is_none() { &[0.0] } else { &[0.0, r, 2.0 * r, 4.0 * r] };
+            for &back in backs {
+                let (walk, at) = self.walk_back(head, back);
+                let Some(&t) = walk.first() else { continue };
+                if dist(cur, t) <= stay && chord_clears(center, cur, t) {
+                    out.push(with(std::iter::once(cur).chain(walk).collect(), false, at));
+                }
+            }
+        }
+        // The plunge the area's earlier passes used, onto the same landing.
+        if let Some(e) = anchor.and_then(|a| a.entry) {
+            out.push(with(vec![e, head.p], true, head.at));
+        }
+        if let Some((walk, at)) = self.walk_to_proved(head) {
+            out.push(with(walk, true, at));
+        }
+        // From a proved position a little back along the wall, so the
+        // feed meets the wall at a shallow angle, never square onto it.
+        if head.at.is_some() {
+            for back in [2.0 * r, r, 4.0 * r] {
+                let Some(&t) = self.walk_back(head, back).0.first() else { continue };
+                for e in self.entries.near(&[t], 2) {
+                    if chord_clears(center, e, head.p) {
+                        out.push(with(vec![e, head.p], true, head.at));
+                    }
+                }
+            }
+        }
+        for e in self.entries.near(&[head.p], SPOTS) {
+            if dist(e, head.p) <= 1e-9 {
+                out.push(with(vec![head.p], true, head.at));
+            } else if chord_clears(center, e, head.p) {
+                out.push(with(vec![e, head.p], true, head.at));
+            }
+        }
+        out
+    }
+
+    /// The wall step that runs AGAINST the travel of a run.
+    fn back_step(&self) -> isize {
+        if self.lv.climb { -1 } else { 1 }
+    }
+
+    /// The wall vertices from the nearest earlier landing back along the
+    /// wall up to (not including) `first`, in travel order, and that
+    /// landing; nothing when `first` is off the wall or none is near.
+    fn back_to_anchor(&self, first: Vtx) -> (Vec<Vtx>, Option<Anchor>) {
+        let Some(mut at) = first.at else { return (Vec::new(), None) };
+        let mut out: Vec<Vtx> = Vec::new();
+        let (mut gone, mut p) = (0.0, first.p);
+        let max = ANCHOR_PER_D * 2.0 * self.lv.r;
+        while gone <= max && out.len() < 4096 {
+            if let Some(a) = self.anchors.iter().find(|a| a.start == at) {
+                out.reverse();
+                return (out, Some(*a));
+            }
+            at = self.canon.next(at, self.back_step());
+            let q = self.canon.point(at);
+            gone += dist(p, q);
+            p = q;
+            out.push(Vtx { p: q, at: Some(at) });
+        }
+        (Vec::new(), None)
+    }
+
+    /// The wall vertices after `last` on to the nearest earlier end,
+    /// in travel order; nothing when `last` is off the wall or none is
+    /// near.
+    fn on_to_end(&self, last: Vtx) -> Vec<Vtx> {
+        let Some(mut at) = last.at else { return Vec::new() };
+        let mut out: Vec<Vtx> = Vec::new();
+        let (mut gone, mut p) = (0.0, last.p);
+        let max = ANCHOR_PER_D * 2.0 * self.lv.r;
+        while gone <= max && out.len() < 4096 {
+            if self.ends.contains(&at) {
+                return out;
+            }
+            at = self.canon.next(at, -self.back_step());
+            let q = self.canon.point(at);
+            gone += dist(p, q);
+            p = q;
+            out.push(Vtx { p: q, at: Some(at) });
+        }
+        Vec::new()
+    }
+
+    /// The wall vertices from at least `len` back along the wall up to
+    /// `first`, in travel order (`first` alone when it is off the
+    /// wall), and the wall vertex the walk starts on.
+    fn walk_back(&self, first: Vtx, len: f64) -> (Vec<Point2>, Option<WallAt>) {
+        let mut out = vec![first.p];
+        let Some(mut at) = first.at else { return (out, None) };
+        let mut gone = 0.0;
+        while gone < len && out.len() < 4096 {
+            at = self.canon.next(at, self.back_step());
+            let p = self.canon.point(at);
+            gone += dist(p, out[out.len() - 1]);
+            out.push(p);
+        }
+        out.reverse();
+        (out, Some(at))
+    }
+
+    /// The wall lead from the nearest proved position back along the
+    /// wall up to `first`, in travel order; `None` when `first` is off
+    /// the wall or no position within reach is proved.
+    fn walk_to_proved(&self, first: Vtx) -> Option<(Vec<Point2>, Option<WallAt>)> {
+        let mut at = first.at?;
+        let mut out = vec![first.p];
+        let mut gone = 0.0;
+        let max = WALK_PER_D * 2.0 * self.lv.r;
+        loop {
+            let p = out[out.len() - 1];
+            if self.entries.proved(p) {
+                out.reverse();
+                return Some((out, Some(at)));
+            }
+            if gone > max || out.len() >= 4096 {
+                return None;
+            }
+            at = self.canon.next(at, self.back_step());
+            let q = self.canon.point(at);
+            gone += dist(p, q);
+            out.push(q);
+        }
+    }
+}
+
+/// A closed ring (first point repeated last) turned to start at the
+/// vertex the chord from `from` meets most nearly along the ring's own
+/// heading, among the vertices `legal` allows; the nearest vertex when
+/// none of the best is legal.
+fn seat(ring: &[Point2], from: Point2, legal: impl Fn(Point2) -> bool) -> Vec<Point2> {
+    let n = ring.len().saturating_sub(1);
+    if n < 2 {
+        return ring.to_vec();
+    }
+    let reach = ring.iter().map(|&q| dist(from, q)).fold(f64::INFINITY, f64::min).max(1e-9);
+    // Along the heading is best; a long chord costs a little.
+    let score = |k: usize| {
+        let (h, c) = (unit(ring[k], ring[k + 1]), unit(from, ring[k]));
+        h.x * c.x + h.y * c.y - 0.05 * dist(from, ring[k]) / reach
+    };
+    let mut order: Vec<usize> = (0..n).collect();
+    order.sort_by(|&a, &b| score(b).total_cmp(&score(a)));
+    let nearest = (0..n).min_by(|&a, &b| dist(from, ring[a]).total_cmp(&dist(from, ring[b]))).unwrap_or(0);
+    let k = order.into_iter().take(8).find(|&k| legal(ring[k])).unwrap_or(nearest);
+    (0..=n).map(|j| ring[(k + j) % n]).collect()
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/mod.rs b/crates/motion/src/machining2d/adaptive/rest/mod.rs
new file mode 100644
index 000000000..f99e59768
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/rest/mod.rs
@@ -0,0 +1,128 @@
+//! 2D rest machining with the Adaptive strategy (issue 2031, part of
+//! issue 1490): the material earlier operations left in a pocket, cut
+//! from the space they are PROVED to have cleared, with the load held
+//! on that remaining stock at every cut depth.
+//!
+//! The plain Adaptive plan (`adaptive`, `pocket_hsm`) starts from a full
+//! pocket and its own entry bore. Here nothing is assumed cut: the
+//! planner is given, per cut depth, a legal cutter-center area and a
+//! conservative bound on the material that still stands ([`RestStock`]),
+//! plunges only where the stock proves the whole cutter footprint and
+//! its approach clear (`entry`), and peels the material from the
+//! cleared side one engagement front at a time (`peel`, `runs`), each
+//! pass read on a stock raster that never reads the material small.
+//!
+//! Provenance: pocket geometry as offset regions (M. Held, "On the
+//! Computational Geometry of Pocket Machining", LNCS 500, Springer
+//! 1991); the material a larger cutter leaves a smaller one (Z. Yao, S.
+//! K. Gupta and D. S. Nau, "Algorithms for selecting cutters in
+//! multi-part milling problems", Computer-Aided Design 35(9), 2003);
+//! the engagement front of the in-process stock (J. A. Stori and P. K.
+//! Wright, J. Manufacturing Systems 19(3), 2000). The clearance and
+//! stock-proof contract, the guards and every refusal are this
+//! project's own. No other CAM product's code or output was consulted.
+//!
+//! Prime Directive: refused by name, never guessed - stock that is not
+//! proved, a cut depth below every proved floor, an entry without
+//! proved clearance, a load or a coverage that cannot be proved, a plan
+//! past its work budget. Every move below the retract plane is a feed
+//! or a plunge; every plunge stands where the stock proves it clear.
+
+mod canon;
+mod entry;
+mod leads;
+mod pass;
+mod peel;
+mod post;
+mod runs;
+mod stock;
+#[cfg(test)]
+mod tests;
+
+use crate::cl::Toolpath;
+use crate::geo2d::Region;
+use crate::machining2d::levels::cut_levels;
+use crate::machining2d::pocket::{PocketParams, PocketStrategy};
+use crate::machining2d::GenError;
+
+use peel::{Level, LevelPlan};
+use stock::Guards;
+pub use stock::{REST_STOCK_FILM, RestStock, StockFloor};
+
+/// Pocket `region` with the tool of `p`, cutting only the material
+/// `stock` says the earlier operations left, by Adaptive passes whose
+/// load is held on that material.
+///
+/// Read from `p`: the tool, the stock to leave, the planes, the cut
+/// depths, the feeds, the cut direction and the optimal load. The entry
+/// is always a plunge into space the stock proves clear (the `entry`
+/// family and the pocket's links describe entries into material, which
+/// a rest pass never makes).
+///
+/// Refused by name: stock with no proved floor; a cut depth below every
+/// proved floor; rest material with no proved-clear entry; a pass whose
+/// load cannot be held; coverage that cannot be proved; a plan past its
+/// budget; nothing left to cut.
+pub fn rest_adaptive(region: &Region, p: &PocketParams, stock: &RestStock) -> Result<Toolpath, GenError> {
+    guarded(region, p, stock, Guards::ALL)
+}
+
+/// [`rest_adaptive`] under `guards` (all on outside the unit tests).
+fn guarded(region: &Region, p: &PocketParams, stock: &RestStock, guards: Guards) -> Result<Toolpath, GenError> {
+    PocketParams { strategy: PocketStrategy::Adaptive, ..*p }.validate()?;
+    if region.is_empty() {
+        return Err(GenError::Empty("empty pocket region".into()));
+    }
+    let r = p.tool_diameter * 0.5;
+    let center = region.offset(-(r + p.stock_to_leave))?;
+    if center.is_empty() {
+        return Err(GenError::Invalid("pocket is narrower than the tool".into()));
+    }
+    let reach = center.offset(r)?;
+    // One plan per answer of the stock: depths whose material bound is
+    // the same region share it.
+    let mut plans: Vec<(Region, LevelPlan)> = Vec::new();
+    let mut levels: Vec<(f64, usize)> = Vec::new();
+    let zs = cut_levels(p.top_z, p.bottom_z, p.stepdown)?;
+    // The depth guard speaks first, for every depth, before anything is
+    // planned (`stock`).
+    let materials = zs.iter().map(|&z| stock.material_at(z, guards)).collect::<Result<Vec<Region>, GenError>>()?;
+    for (z, material) in zs.into_iter().zip(materials) {
+        let at = match plans.iter().position(|(m, _)| same(m, &material)) {
+            Some(i) => i,
+            None => {
+                let lv = Level {
+                    center: &center,
+                    reach: &reach,
+                    material: &material,
+                    film: stock.film(),
+                    r,
+                    load: p.optimal_load,
+                    climb: p.climb,
+                    z,
+                    guards,
+                };
+                let plan = peel::plan(&lv)?;
+                plans.push((material, plan));
+                plans.len() - 1
+            }
+        };
+        levels.push((z, at));
+    }
+    if levels.iter().all(|&(_, i)| plans[i].1.chains.is_empty()) {
+        return Err(GenError::Empty(
+            "no rest material: the remaining stock leaves nothing in this tool's reach in this pocket".into(),
+        ));
+    }
+    let path = post::post(p, &levels, &plans, stock);
+    if !path.all_finite() {
+        return Err(GenError::Invalid("path left the finite horizon".into()));
+    }
+    Ok(path)
+}
+
+/// Do two regions cover the same area (whatever their vertex order)?
+fn same(a: &Region, b: &Region) -> bool {
+    let empty = |r: Result<Region, crate::geo2d::GeoError>| r.is_ok_and(|r| r.is_empty());
+    a == b || (empty(a.difference(b)) && empty(b.difference(a)))
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/pass.rs b/crates/motion/src/machining2d/adaptive/rest/pass.rs
new file mode 100644
index 000000000..a2c16db5b
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/rest/pass.rs
@@ -0,0 +1,203 @@
+//! One rest pass on trial (issue 2031): reached each way `leads`
+//! offers, proved inside the legal center area, asked the verifier's
+//! crossing law against the depth's earlier feeds, then WALKED on the
+//! stock raster - kept only if the whole feed read at most the optimal
+//! load and it cut something. Provenance: the measured-not-asserted law
+//! of the Adaptive planner (`adaptive`, `raster`; the contact angle of
+//! Y. Altintas, "Manufacturing Automation", 2nd ed., Cambridge 2012,
+//! ch. 2); the trial order and the refusals are ours.
+
+use crate::geo2d::{Point2, Region};
+use crate::geometry::Point3;
+use crate::load::load_at_rim;
+use crate::machining2d::{GenError, chord_clears};
+
+use super::super::front::len;
+use super::super::guard::first_crossing;
+use super::super::raster::Raster;
+use super::super::tidy;
+use super::leads::{Anchor, Lead};
+use super::peel::Peel;
+use super::runs::Run;
+
+/// A pass that clears fewer cells than this cut nothing worth a pass.
+const MIN_CELLS: usize = 4;
+
+/// Why a run could not be kept, most serious last.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum Fail {
+    /// Held the load but cut nothing: crumbs, not a refusal.
+    Idle,
+    Crossing(Point2),
+    Entry(Point2),
+    Load(f64, Point2),
+}
+
+impl Fail {
+    fn rank(&self) -> u8 {
+        match self {
+            Fail::Idle => 0,
+            Fail::Crossing(_) => 1,
+            Fail::Entry(_) => 2,
+            Fail::Load(..) => 3,
+        }
+    }
+
+    /// The more serious of two; of two overloads, the lighter (what the
+    /// ladder could do at best).
+    pub(super) fn worse(self, other: Fail) -> Fail {
+        match (self, other) {
+            (Fail::Load(a, _), Fail::Load(b, _)) if b < a => other,
+            (Fail::Load(..), Fail::Load(..)) => self,
+            _ if other.rank() > self.rank() => other,
+            _ => self,
+        }
+    }
+}
+
+/// A pass on trial that held: its feed, the stock it leaves, its worst
+/// reading.
+pub(super) struct Trial {
+    lead: Lead,
+    ras: Raster,
+    goal: Raster,
+    worst: f64,
+    start: Point2,
+}
+
+impl Peel<'_> {
+    /// Try `run` with each way of reaching it; the first whose whole
+    /// feed is legal, crosses nothing, holds the load and cuts is kept.
+    pub(super) fn attempt(&mut self, run: &Run) -> Result<Trial, Fail> {
+        let r = self.lv.r;
+        let Some(start) = run.v.first().map(|v| v.p) else { return Err(Fail::Idle) };
+        let mut fail = Fail::Entry(start);
+        for lead in self.leads(run) {
+            let pts = &lead.pts;
+            // Legal: every chord inside the center area (a chord of a
+            // wall is, by construction).
+            let legal = |w: &[Point2]| self.canon.wall_chord(w[0], w[1]) || chord_clears(self.lv.center, w[0], w[1]);
+            if let Some(w) = pts.windows(2).find(|w| !legal(w)) {
+                fail = fail.worse(Fail::Entry(w[1]));
+                continue;
+            }
+            if let Some(x) = self.crossing(pts) {
+                fail = fail.worse(Fail::Crossing(x));
+                continue;
+            }
+            let mut ras = self.ras.clone();
+            self.work += len(pts);
+            let (deg, at) = ras.walk_until(pts, (r, self.rim, r / 10.0), self.bound);
+            if deg > self.bound {
+                fail = fail.worse(Fail::Load(deg, at));
+                // Overloaded on the run itself: no other way of reaching
+                // it changes that.
+                let lead = &pts[..lead.own.min(pts.len())];
+                if lead.windows(2).all(|w| seg_dist(at, w[0], w[1]) > 0.25 * r) {
+                    break;
+                }
+                continue;
+            }
+            let mut goal = self.goal.clone();
+            pts.windows(2).for_each(|w| goal.cut(w[0], w[1], r));
+            if self.goal.standing().saturating_sub(goal.standing()) < MIN_CELLS {
+                return Err(Fail::Idle);
+            }
+            return Ok(Trial { lead, ras, goal, worst: deg, start });
+        }
+        Err(fail)
+    }
+
+    /// Where the feed `pts` would cross itself or an earlier feed of
+    /// this depth (the verifier's crossing law, asked first).
+    fn crossing(&self, pts: &[Point2]) -> Option<Point2> {
+        let bb = bounds(pts);
+        // (A feed that starts where an earlier one ended shares that end
+        // point with it, which the law reads as a touch.)
+        let mut walks: Vec<Vec<Point2>> =
+            self.plan.chains.iter().filter(|c| overlap(bounds(c), bb)).cloned().collect();
+        walks.push(pts.to_vec());
+        first_crossing(&walks)
+    }
+
+    pub(super) fn commit(&mut self, t: Trial) -> Result<(), GenError> {
+        let h = self.ras.h;
+        let Lead { pts, hop, start, end, .. } = t.lead;
+        let sw = Region::sweep(std::slice::from_ref(&pts), self.lv.r)?;
+        self.mat = tidy::tidy(&self.mat.difference(&sw)?, 0.25 * h, 0.1 * h, 4.0 * h * h)?;
+        self.ras = t.ras;
+        self.goal = t.goal;
+        self.worst_deg = self.worst_deg.max(t.worst);
+        self.cur = pts.last().copied();
+        self.anchor = Some(t.start);
+        self.plan.passes += 1;
+        // Where this pass landed on a wall and left it: later passes of
+        // the area retrace both (`leads`).
+        if let Some(at) = start
+            && !self.anchors.iter().any(|a| a.start == at)
+        {
+            self.anchors.push(Anchor { start: at, entry: hop.then(|| pts.first().copied()).flatten() });
+        }
+        if let Some(at) = end
+            && !self.ends.contains(&at)
+        {
+            self.ends.push(at);
+        }
+        match self.plan.chains.last_mut() {
+            Some(last) if !hop => last.extend(pts.into_iter().skip(1)),
+            _ => self.plan.chains.push(pts),
+        }
+        Ok(())
+    }
+
+    /// The named refusal of a run no step could cut (crumbs are none).
+    pub(super) fn refusal(&self, why: Fail) -> Option<GenError> {
+        let (d, z) = (2.0 * self.lv.r, self.lv.z);
+        let (msg, at) = match why {
+            Fail::Idle => return None,
+            Fail::Load(deg, at) => (
+                format!(
+                    "rest Adaptive cannot hold the optimal load at ({:.2}, {:.2}), Z{z:.3}: the lightest step still loads the tool to {:.0}% of its diameter against {:.0}% - choose Waterline or Offset rings",
+                    at.x,
+                    at.y,
+                    load_at_rim(deg, d, self.rim) * 100.0,
+                    self.lv.load * 100.0
+                ),
+                at,
+            ),
+            Fail::Entry(at) => (
+                format!(
+                    "rest Adaptive has no entry with proved clearance for the rest material at ({:.2}, {:.2}), Z{z:.3}: the remaining stock does not prove the cutter's whole footprint and its approach clear near it",
+                    at.x, at.y
+                ),
+                at,
+            ),
+            Fail::Crossing(at) => (
+                format!(
+                    "rest Adaptive's plan would cross itself at ({:.2}, {:.2}), Z{z:.3} - choose Waterline or Offset rings",
+                    at.x, at.y
+                ),
+                at,
+            ),
+        };
+        Some(GenError::invalid_at(msg, Point3::new(at.x, at.y, z)))
+    }
+}
+
+fn bounds(pts: &[Point2]) -> (Point2, Point2) {
+    pts.iter().fold(
+        (Point2::new(f64::INFINITY, f64::INFINITY), Point2::new(f64::NEG_INFINITY, f64::NEG_INFINITY)),
+        |(lo, hi), p| (Point2::new(lo.x.min(p.x), lo.y.min(p.y)), Point2::new(hi.x.max(p.x), hi.y.max(p.y))),
+    )
+}
+
+fn overlap(a: (Point2, Point2), b: (Point2, Point2)) -> bool {
+    a.0.x <= b.1.x && b.0.x <= a.1.x && a.0.y <= b.1.y && b.0.y <= a.1.y
+}
+
+fn seg_dist(q: Point2, a: Point2, b: Point2) -> f64 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    let dd = dx * dx + dy * dy;
+    let t = if dd > 0.0 { (((q.x - a.x) * dx + (q.y - a.y) * dy) / dd).clamp(0.0, 1.0) } else { 0.0 };
+    (q.x - a.x - t * dx).hypot(q.y - a.y - t * dy)
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/peel.rs b/crates/motion/src/machining2d/adaptive/rest/peel.rs
new file mode 100644
index 000000000..d85eebb64
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/rest/peel.rs
@@ -0,0 +1,323 @@
+//! One cut depth of rest Adaptive (issue 2031): the remaining material
+//! peeled from the cleared side, area by area, one engagement front at
+//! a time, every pass walked on the conservative stock raster BEFORE it
+//! is kept (`pass`).
+//!
+//! Provenance: the engagement front of the in-process stock - the
+//! cutter centers that bite exactly the step (J. A. Stori and P. K.
+//! Wright, "Constant engagement tool path generation for convex
+//! geometries", J. Manufacturing Systems 19(3), 2000), taken as offsets
+//! of the remaining material inside the legal center area (M. Held, "On
+//! the Computational Geometry of Pocket Machining", LNCS 500, Springer
+//! 1991); the material a larger cutter leaves a smaller one after Z.
+//! Yao, S. K. Gupta and D. S. Nau, Computer-Aided Design 35(9), 2003.
+//! The contact angle is the immersion angle of peripheral milling (Y.
+//! Altintas, "Manufacturing Automation", 2nd ed., Cambridge 2012, ch.
+//! 2), read on the raster as `quality` reads it. The step ladder, the
+//! phases, the budget and every refusal are ours; no other CAM
+//! product's code or output was consulted.
+//!
+//! Prime Directive: a pass is kept only when its whole feed - lead and
+//! link included - read at most the optimal load on stock that is never
+//! read small, stays inside the legal center area and crosses no
+//! earlier feed of the depth. Where that cannot be had the depth is
+//! refused by name; nothing is cut on a guess.
+
+use crate::geo2d::{Point2, Region};
+use crate::load::{deg_at_rim, load_at_rim};
+use crate::machining2d::GenError;
+use crate::machining2d::pocket_hsm::{PLAN_TOL, components};
+
+use super::super::front::dist;
+use super::super::raster::Raster;
+use super::super::{BITE_LOAD, GRID_PER_D, STEPS};
+use super::canon::Canon;
+use super::entry::Entries;
+use super::leads::Anchor;
+use super::pass::Fail;
+use super::runs::{Run, RunSpec, runs};
+use super::stock::Guards;
+
+/// Most passes one depth may hold (the Prime Directive's "never hang").
+pub(super) const PASSES_MAX: usize = 2000;
+
+/// Most feed length (tool radii) one depth's trials may walk.
+pub(super) const WORK_MAX: f64 = 60_000.0;
+
+/// Most runs one phase of one area may give up on before it moves on.
+const DEAD_MAX: usize = 256;
+
+/// The share of the rest material one depth may leave standing in
+/// reach (grid crumbs) before its coverage is refused.
+pub(super) const COVER_MAX: f64 = 0.02;
+
+/// A plunge is proved clear this far (mm) past the cutter, or four grid
+/// cells where that is more.
+pub(super) const ENTRY_MARGIN: f64 = 0.1;
+
+/// One cut depth to plan.
+pub(super) struct Level<'a> {
+    /// The legal cutter-center area.
+    pub center: &'a Region,
+    /// What the cutter covers from it.
+    pub reach: &'a Region,
+    /// The bound on the material standing at this depth (`stock`).
+    pub material: &'a Region,
+    /// Residue thinner than this is not planned for (`RestStock::film`).
+    pub film: f64,
+    pub r: f64,
+    /// Optimal load, ae/D.
+    pub load: f64,
+    pub climb: bool,
+    pub z: f64,
+    pub guards: Guards,
+}
+
+/// The plan of one depth: feed polylines, each entered by a plunge at
+/// its first point and left by a retract after its last.
+#[derive(Clone, Debug, Default)]
+pub(super) struct LevelPlan {
+    pub chains: Vec<Vec<Point2>>,
+    /// Rest material planned on (mm^2, read large).
+    pub area: f64,
+    /// Share of it left standing in reach.
+    pub left: f64,
+    /// Worst load a kept pass read (ae/D).
+    pub worst: f64,
+    pub passes: usize,
+    /// Rest material left (mm^2, within the coverage bound) where no
+    /// step held the load, and where: said on the path, never cut over
+    /// the load.
+    pub held_back: Option<(f64, Point2)>,
+}
+
+pub(super) struct Peel<'a> {
+    pub(super) lv: &'a Level<'a>,
+    pub(super) canon: Canon,
+    pub(super) entries: Entries<'a>,
+    /// Where the last kept pass ended (the tool stands there, down).
+    pub(super) cur: Option<Point2>,
+    /// Where earlier passes landed on a wall, and where they left one.
+    pub(super) anchors: Vec<Anchor>,
+    pub(super) ends: Vec<super::canon::WallAt>,
+    /// The stock, read large: what every load reading stands on.
+    pub(super) ras: Raster,
+    /// What is still to cut: the stock less its film.
+    pub(super) goal: Raster,
+    /// The same, as a region, cut as the passes are kept.
+    pub(super) mat: Region,
+    pub(super) rim: f64,
+    pub(super) bound: f64,
+    seg: f64,
+    /// Where the last kept pass started (the same front, one step on).
+    pub(super) anchor: Option<Point2>,
+    pub(super) plan: LevelPlan,
+    pub(super) worst_deg: f64,
+    pub(super) work: f64,
+    /// The most serious reason a run of a last phase was not cut.
+    unheld: Option<Fail>,
+}
+
+/// The radii the room is opened by, phase by phase, widest first: from
+/// `widest` down by 15% a phase - at most a step and a half of the
+/// optimal width `w`, so the arc that peels a corner never bites much
+/// deeper than the phase before - to an eighth of the tool radius, then
+/// sharp (which is what clears a corner).
+pub(super) fn radii(r: f64, w: f64, widest: f64) -> Vec<f64> {
+    let mut out = Vec::new();
+    let mut rho = widest;
+    while rho > r / 8.0 && out.len() < 256 {
+        out.push(rho);
+        rho -= (0.15 * rho).min(1.5 * w).max(1e-6);
+    }
+    out.push(0.0);
+    out
+}
+
+/// Plan one depth. No material in reach is an empty plan.
+pub(super) fn plan(lv: &Level<'_>) -> Result<LevelPlan, GenError> {
+    let d = 2.0 * lv.r;
+    let mut ras = Raster::from_region(lv.reach, d / GRID_PER_D, lv.r)?;
+    // Only what the cutter can touch: beyond its reach stand the walls.
+    let bound = lv.material.intersect(lv.reach)?;
+    // Conservative: every cell the bound touches stands (`raster::conservative`).
+    let grow = ras.conservative_growth();
+    let mut goal = ras.clone();
+    ras.keep(&bound.offset(grow)?.intersect(lv.reach)?);
+    // What the passes are planned to cut: the bound less its film (an
+    // opening by half the film), read large the same way.
+    let half = 0.5 * lv.film.clamp(0.0, 0.25 * lv.r);
+    let body = if half > 0.0 { bound.offset(-half)?.offset(half)? } else { bound.clone() };
+    let mat = body.offset(grow)?.intersect(lv.reach)?;
+    goal.keep(&mat);
+    let initial = goal.standing();
+    if initial == 0 {
+        return Ok(LevelPlan::default());
+    }
+    let areas = components(&mat)?;
+    let (h, seg) = (ras.h, lv.r / 8.0);
+    let rim = crate::quality::rim_for(d, h);
+    let margin = ENTRY_MARGIN.max(4.0 * h);
+    let entries = Entries::new(lv.center, &bound, ras.clone(), (lv.r, grow, margin, seg), lv.guards.entry)?;
+    if !entries.any() {
+        return Err(GenError::Invalid(format!(
+            "rest Adaptive has no entry with proved clearance at Z{:.3}: the remaining stock proves no position clear for the cutter's whole footprint",
+            lv.z
+        )));
+    }
+    let mut p = Peel {
+        lv,
+        canon: Canon::new(lv.center, seg),
+        entries,
+        cur: None,
+        anchors: Vec::new(),
+        ends: Vec::new(),
+        ras,
+        goal,
+        mat,
+        rim,
+        // The plain Adaptive's planning margin: it covers the grid phase.
+        bound: deg_at_rim(lv.load * (1.0 + PLAN_TOL), d, rim),
+        seg,
+        anchor: None,
+        plan: LevelPlan { area: initial as f64 * h * h, ..LevelPlan::default() },
+        worst_deg: 0.0,
+        work: 0.0,
+        unheld: None,
+    };
+    // Area by area, the nearest next: an area is finished before the
+    // tool leaves it. An area is the box of one piece of the material,
+    // grown by the tool diameter; a piece that stands free of the walls
+    // has no wall to roll off, and its rooms are not opened.
+    let mut todo: Vec<(Point2, Point2, bool)> = Vec::new();
+    for a in &areas {
+        let Some((lo, hi)) = a.bounds() else { continue };
+        let free = a.offset(2.0 * h)?.difference(lv.reach)?.is_empty();
+        todo.push((Point2::new(lo.x - d, lo.y - d), Point2::new(hi.x + d, hi.y + d), free));
+    }
+    while !todo.is_empty() {
+        let from = p.cur.or_else(|| lv.center.bounds().map(|b| b.0)).unwrap_or_default();
+        let far = |a: &(Point2, Point2, bool)| dist(from, Point2::new(0.5 * (a.0.x + a.1.x), 0.5 * (a.0.y + a.1.y)));
+        let Some(k) = (0..todo.len()).min_by(|&a, &b| far(&todo[a]).total_cmp(&far(&todo[b]))) else { break };
+        let (lo, hi, free) = todo.swap_remove(k);
+        p.rounds((lo, hi), free)?;
+    }
+    p.plan.left = p.goal.standing() as f64 / initial as f64;
+    p.plan.worst = load_at_rim(p.worst_deg, d, rim);
+    if p.plan.left > COVER_MAX {
+        // What stopped a run names the refusal; else the coverage does.
+        return Err(p.unheld.and_then(|why| p.refusal(why)).unwrap_or_else(|| {
+            GenError::Invalid(format!(
+                "rest Adaptive cannot prove its coverage at Z{:.3}: {:.0}% of the rest material in reach would be left standing - choose Waterline or Offset rings",
+                lv.z,
+                p.plan.left * 100.0
+            ))
+        }));
+    }
+    if let Some(Fail::Load(_, at)) = p.unheld {
+        p.plan.held_back = Some((p.goal.standing() as f64 * h * h, at));
+    }
+    Ok(p.plan)
+}
+
+impl Peel<'_> {
+    /// The rounds of one area: per phase, the nearest run that still
+    /// bites, at the widest step of the ladder that holds the load.
+    fn rounds(&mut self, area: (Point2, Point2), free: bool) -> Result<(), GenError> {
+        let r = self.lv.r;
+        // No wider than the center area can hold a disc of.
+        let widest = self.lv.center.bounds().map_or(r, |(lo, hi)| 0.5 * (hi.x - lo.x).min(hi.y - lo.y)).min(16.0 * r);
+        let phases = if free { vec![0.0] } else { radii(r, 2.0 * r * self.lv.load, widest) };
+        for (phase, &rho) in phases.iter().enumerate() {
+            // Runs no step could cut in this phase: never offered again
+            // in it (the plan cannot spin on them).
+            let mut dead: Vec<Point2> = Vec::new();
+            let mut failed: Option<Fail> = None;
+            loop {
+                if self.plan.passes >= PASSES_MAX || self.work > WORK_MAX * r {
+                    return Err(GenError::Invalid(format!(
+                        "rest Adaptive ran past its planning budget at Z{:.3} ({} passes kept, {:.0} mm of trial feed) - choose Waterline or Offset rings",
+                        self.lv.z, self.plan.passes, self.work
+                    )));
+                }
+                if self.mat.is_empty() {
+                    return Ok(());
+                }
+                if dead.len() >= DEAD_MAX {
+                    break;
+                }
+                let mut kept = None;
+                let mut tried: Option<(Point2, Fail)> = None;
+                for f in STEPS {
+                    let e = r - 2.0 * r * self.lv.load * f;
+                    let sp = RunSpec {
+                        center: self.lv.center,
+                        canon: &self.canon,
+                        ras: &self.goal,
+                        r,
+                        graze: 2.0 * r * BITE_LOAD,
+                        seg: self.seg,
+                        margin: 0.5 * r,
+                        ride: 0.0,
+                        rho,
+                        climb: self.lv.climb,
+                    };
+                    // (A narrower step bites a subset: none at the widest, none at all.)
+                    let here = |run: &Run| run.v.iter().any(|v| v.p.x >= area.0.x && v.p.x <= area.1.x && v.p.y >= area.0.y && v.p.y <= area.1.y);
+                    let cands: Vec<Run> = runs(&self.mat, e, &sp)?.into_iter().filter(here).collect();
+                    let Some(run) = self.nearest(cands, &dead) else { break };
+                    let Some(start) = run.v.first().map(|v| v.p) else { continue };
+                    match self.attempt(&run) {
+                        Ok(t) => {
+                            kept = Some(t);
+                            break;
+                        }
+                        Err(why) => {
+                            tried = Some((tried.map_or(start, |t| t.0), tried.map_or(why, |t| t.1.worse(why))));
+                            // (A narrower step cuts a subset of nothing.)
+                            if why == Fail::Idle {
+                                break;
+                            }
+                        }
+                    }
+                }
+                match (kept, tried) {
+                    (Some(t), _) => self.commit(t)?,
+                    (None, Some((start, why))) => {
+                        dead.push(start);
+                        failed = Some(failed.map_or(why, |f| f.worse(why)));
+                    }
+                    // Nothing bites any more at this radius.
+                    (None, None) => break,
+                }
+            }
+            // What the last (sharp) phase could not cut is left standing:
+            // the coverage bound judges it (`plan`).
+            if phase + 1 == phases.len()
+                && let Some(why) = failed
+            {
+                self.unheld = Some(self.unheld.map_or(why, |u| u.worse(why)));
+            }
+        }
+        Ok(())
+    }
+
+    /// The run to cut next: the one starting nearest where the last
+    /// pass started (the same front, one step on) and where the tool
+    /// stands; none of the dead ones.
+    fn nearest(&self, cands: Vec<Run>, dead: &[Point2]) -> Option<Run> {
+        let r = self.lv.r;
+        let origin = self.lv.center.bounds().map_or(Point2::new(0.0, 0.0), |b| b.0);
+        let (anchor, cur) = (self.anchor.unwrap_or(origin), self.cur.unwrap_or(origin));
+        let near = |run: &Run, q: Point2| {
+            let pts = run.v.iter().take(if run.closed { usize::MAX } else { 1 });
+            pts.map(|v| dist(v.p, q)).fold(f64::INFINITY, f64::min)
+        };
+        cands
+            .into_iter()
+            .filter(|run| run.v.len() >= 2 && !dead.iter().any(|&d| near(run, d) < 0.5 * r))
+            .map(|run| (near(&run, anchor) + 0.25 * near(&run, cur), run))
+            .min_by(|a, b| a.0.total_cmp(&b.0))
+            .map(|b| b.1)
+    }
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/post.rs b/crates/motion/src/machining2d/adaptive/rest/post.rs
new file mode 100644
index 000000000..57f32866c
--- /dev/null
+++ b/crates/motion/src/machining2d/adaptive/rest/post.rs
@@ -0,0 +1,68 @@
+//! The moves of a rest Adaptive plan (issue 2031): per cut depth, per
+//! chain - a rapid on a travel plane to the proved-clear position, a
+//! plunge down the proved-clear column, the chain's feeds, a rapid
+//! straight up. Provenance: RS-274 / ISO 6983 motion vocabulary (G0
+//! positioning on a clearance or retract plane, G1 for everything
+//! below it); the planes are the pocket ladder's own (`levels`). Ours.
+//!
+//! Prime Directive: no rapid ends or runs below the top of the cut
+//! except straight up out of where the tool has just cut; the chords
+//! are posted exactly as they were measured (no arc is fitted over
+//! them, so the posted path is the path that was read).
+
+use crate::cl::{MoveKind, PathBuilder, Toolpath};
+use crate::geo2d::Region;
+use crate::geometry::Point3;
+use crate::machining2d::pocket::PocketParams;
+
+use super::peel::LevelPlan;
+use super::stock::RestStock;
+
+pub(super) fn post(p: &PocketParams, levels: &[(f64, usize)], plans: &[(Region, LevelPlan)], stock: &RestStock) -> Toolpath {
+    let clearance = p.clearance_z;
+    let hop = p.retract_z.unwrap_or(clearance).min(clearance);
+    let mut b = PathBuilder::approached(Point3::new(0.0, 0.0, clearance));
+    b.note(format!(
+        "rest Adaptive is planned on the remaining stock of the earlier operations, proved down to Z{:.3} ({} floor(s)); it plunges only where that stock proves the cutter's footprint clear",
+        stock.deepest(),
+        stock.floors().len()
+    ));
+    let mut said: Vec<usize> = Vec::new();
+    for &(z, at) in levels {
+        let Some((_, plan)) = plans.get(at) else { continue };
+        if !said.contains(&at) && !plan.chains.is_empty() {
+            said.push(at);
+            b.note(format!(
+                "rest Adaptive from Z{z:.3}: {:.1} mm2 of rest material in {} passes, worst planned load {:.1}% of D against {:.1}%",
+                plan.area,
+                plan.passes,
+                plan.worst * 100.0,
+                p.optimal_load * 100.0
+            ));
+        }
+        if let Some((mm2, at)) = plan.held_back {
+            b.note_once(&format!(
+                "rest Adaptive leaves {mm2:.2} mm2 of rest material where no pass holds the optimal load (near ({:.2}, {:.2})): a finishing pass takes it",
+                at.x, at.y
+            ));
+        }
+        for (ci, chain) in plan.chains.iter().enumerate() {
+            let Some((e, rest)) = chain.split_first() else { continue };
+            // A depth is reached over the clearance plane, a chain of
+            // the same depth over the retract plane.
+            let cur = b.at();
+            let travel = cur.z.max(if ci == 0 { clearance } else { hop });
+            b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, travel), None);
+            b.push(MoveKind::Rapid, Point3::new(e.x, e.y, travel), None);
+            let above = (p.top_z + p.links.approach.plunge_height.max(0.0)).min(travel).max(z);
+            b.push(MoveKind::Rapid, Point3::new(e.x, e.y, above), None);
+            b.push(MoveKind::Plunge, Point3::new(e.x, e.y, z), Some(p.plunge_feed));
+            for q in rest {
+                b.push(MoveKind::Feed, Point3::new(q.x, q.y, z), Some(p.feed));
+            }
+        }
+    }
+    let cur = b.at();
+    b.push(MoveKind::Rapid, Point3::new(cur.x, cur.y, clearance), None);
+    b.finish()
+}
diff --git a/crates/motion/src/machining2d/adaptive/rest/runs.rs b/crates/motion/src/machining2d/adaptive/rest/runs.rs
