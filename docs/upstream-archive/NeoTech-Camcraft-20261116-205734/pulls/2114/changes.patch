diff --git a/crates/motion/tests/rest_adaptive/main.rs b/crates/motion/tests/rest_adaptive/main.rs
new file mode 100644
index 000000000..f3caccee9
--- /dev/null
+++ b/crates/motion/tests/rest_adaptive/main.rs
@@ -0,0 +1,240 @@
+//! 2D rest machining with the Adaptive strategy (issue 2031): planned on
+//! the remaining stock earlier operations are PROVED to have left, read
+//! here against an independent simulation of those operations. The rest
+//! passes never rapid or plunge into material the simulation still
+//! holds, pass the verifier, hold the optimal load at every requested
+//! depth on the simulated stock, and cover the rest material in reach.
+//! Unsupported stock, depth, entry and load cases are refused by name;
+//! degenerate input errors instead of crashing.
+//!
+//! Gate map (issue 2031): covers camcraft_motion::machining2d::adaptive
+//! (rest: stock, entry, peel, pass, runs, leads, canon, post;
+//! raster::conservative), camcraft_motion::quality.
+
+mod sim;
+
+use camcraft_motion::cl::MoveKind;
+use camcraft_motion::geo2d::{Point2, Region};
+use camcraft_motion::machining2d::{rest_adaptive, GenError, PocketParams, RestStock, StockFloor, REST_STOCK_FILM};
+use camcraft_motion::quality::rest_area;
+
+use sim::{
+    assert_load_held, check, disc, filleted, poly, read, read_leaving, rect, refusal, rest_params, roughed, Sim, BOTTOM, FIRST, R,
+    TOP,
+};
+
+/// Two 30 x 30 bays joined by a neck `w` wide and 10 long, inside
+/// corners rounded to 3 mm.
+fn bays(w: f64) -> Region {
+    let (lo, hi) = (15.0 - w * 0.5, 15.0 + w * 0.5);
+    let outline = [
+        (0.0, 0.0), (30.0, 0.0), (30.0, lo), (40.0, lo), (40.0, 0.0), (70.0, 0.0),
+        (70.0, 30.0), (40.0, 30.0), (40.0, hi), (30.0, hi), (30.0, 30.0), (0.0, 30.0),
+    ];
+    filleted(&poly(&outline), 2.9)
+}
+
+#[test]
+fn four_corner_residues_are_cut_from_proved_stock_within_the_load() {
+    // A 60 x 40 pocket with 3 mm corners: the 12 mm tool leaves four
+    // corner residues (23 mm2 in all), at both depths.
+    let region = filleted(&rect(0.0, 0.0, 60.0, 40.0), 3.0);
+    let mut sim = Sim::new(&region);
+    let stock = roughed(&region, &mut sim, BOTTOM);
+    let before = rest_area(&sim.dex, &region, BOTTOM).unwrap();
+    assert!(before > 20.0, "the fixture has residue to cut ({before:.1} mm2)");
+    let p = rest_params();
+    let path = rest_adaptive(&region, &p, &stock).unwrap();
+    let r = read(&path, &region, &mut sim);
+    assert_load_held(&r);
+    assert!(r.left < 0.05, "{:.3} mm2 of rest material in reach is left standing", r.left);
+    // One entry per corner and depth: a corner is finished before the
+    // tool leaves it.
+    assert_eq!(r.plunges, 8, "plunges");
+    // The passes stay at the corners: no feed crosses the pocket's middle.
+    for m in path.moves.iter().filter(|m| m.kind == MoveKind::Feed) {
+        let (dx, dy) = (m.to.x.min(60.0 - m.to.x), m.to.y.min(40.0 - m.to.y));
+        assert!(dx < 14.0 && dy < 14.0, "a feed at ({}, {}) is outside the corners", m.to.x, m.to.y);
+    }
+    assert!(path.notes.iter().any(|n| n.contains("planned on the remaining stock of the earlier operations")));
+    assert!(path.notes.iter().any(|n| n.contains("worst planned load")));
+}
+
+#[test]
+fn a_conventional_cut_leaving_stock_on_the_walls_keeps_every_law() {
+    // The same corners cut the other way round, 0.3 mm left on the
+    // walls, hopping at the clearance plane (no retract plane set). (3.5
+    // mm corners: the cutter's center still turns on a 1.2 mm arc.)
+    let region = filleted(&rect(0.0, 0.0, 60.0, 40.0), 3.5);
+    let mut sim = Sim::new(&region);
+    let stock = roughed(&region, &mut sim, BOTTOM);
+    let p = PocketParams { climb: false, stock_to_leave: 0.3, retract_z: None, ..rest_params() };
+    let path = rest_adaptive(&region, &p, &stock).unwrap();
+    let r = read_leaving(&path, &region, &mut sim, 0.3);
+    assert_load_held(&r);
+    assert!(r.left < 0.05, "{:.3} mm2 of rest material in reach is left standing", r.left);
+    // Nothing nearer the walls than the tool radius and the stock to leave.
+    let legal = region.offset(-(R + 0.3 - 0.01)).unwrap();
+    for m in path.moves.iter().filter(|m| m.kind != MoveKind::Rapid) {
+        assert!(legal.contains(Point2::new(m.to.x, m.to.y)), "a move at ({}, {}) cuts into the stock to leave", m.to.x, m.to.y);
+    }
+    // The climb plan travels each corner the other way.
+    let climb = rest_adaptive(&region, &PocketParams { climb: true, ..p }, &stock).unwrap();
+    assert_ne!(climb.moves, path.moves);
+}
+
+#[test]
+fn an_island_and_disconnected_rest_areas_are_each_entered_from_proved_space() {
+    // A 70 x 50 pocket round a 14 x 14 island; besides the four corner
+    // residues, two pillars the earlier operations left standing in
+    // cleared floor (rest areas that touch no wall).
+    let island = rect(28.0, 18.0, 42.0, 32.0);
+    let region = filleted(&rect(0.0, 0.0, 70.0, 50.0), 3.0).difference(&island).unwrap();
+    let mut sim = Sim::new(&region);
+    let rough = roughed(&region, &mut sim, BOTTOM);
+    let pillars = [(Point2::new(14.0, 25.0), 2.5), (Point2::new(56.0, 25.0), 1.5)];
+    let floors = rough
+        .floors()
+        .iter()
+        .map(|f| {
+            let mut remaining = f.remaining.clone();
+            for &(at, rad) in &pillars {
+                remaining = remaining.union(&disc(at, rad + 0.05)).unwrap();
+            }
+            StockFloor { remaining, ..f.clone() }
+        })
+        .collect();
+    for &(at, rad) in &pillars {
+        sim.stand(at, rad);
+    }
+    let stock = RestStock::from_verified(floors).unwrap();
+    let path = rest_adaptive(&region, &rest_params(), &stock).unwrap();
+    let r = read(&path, &region, &mut sim);
+    assert_load_held(&r);
+    assert!(r.left < 0.05, "{:.3} mm2 of rest material in reach is left standing", r.left);
+    // No feed enters the island's own keep-out (the island grown by the
+    // tool radius), and both pillars are gone.
+    let keep_out = island.offset(R - 0.01).unwrap();
+    for m in path.moves.iter().filter(|m| m.kind != MoveKind::Rapid) {
+        assert!(!keep_out.contains(Point2::new(m.to.x, m.to.y)), "a move at ({}, {}) gouges the island", m.to.x, m.to.y);
+    }
+    for &(at, _) in &pillars {
+        assert!(sim.top_under(at, 0.5) <= BOTTOM + 1e-6, "the pillar at ({}, {}) still stands", at.x, at.y);
+    }
+}
+
+#[test]
+fn a_neck_the_earlier_tool_could_not_pass_is_cut_through_within_the_load() {
+    // Two bays joined by a 10 mm neck: the 12 mm tool never entered it.
+    let region = bays(10.0);
+    let mut sim = Sim::new(&region);
+    let stock = roughed(&region, &mut sim, BOTTOM);
+    assert!(sim.top_under(Point2::new(35.0, 15.0), 0.5) >= TOP - 1e-9, "the fixture's neck is uncut");
+    let path = rest_adaptive(&region, &rest_params(), &stock).unwrap();
+    let r = read(&path, &region, &mut sim);
+    assert_load_held(&r);
+    assert!(r.left < 0.05, "{:.3} mm2 of rest material in reach is left standing", r.left);
+    for x in [31.0, 35.0, 39.0] {
+        for y in [11.0, 15.0, 19.0] {
+            assert!(sim.top_under(Point2::new(x, y), 0.3) <= BOTTOM + 1e-6, "the neck still stands at ({x}, {y})");
+        }
+    }
+}
+
+#[test]
+fn a_neck_too_narrow_to_hold_the_load_is_refused_by_name() {
+    // A 6 mm neck for a 4 mm tool: every pass through it wraps the
+    // cutter. Not slotted - refused, with the place.
+    let region = bays(6.0);
+    let mut sim = Sim::new(&region);
+    let stock = roughed(&region, &mut sim, BOTTOM);
+    let err = rest_adaptive(&region, &rest_params(), &stock);
+    assert!(err.as_ref().is_err_and(|e| e.location().is_some()), "the refusal names its place");
+    let msg = refusal(err);
+    assert!(msg.contains("cannot hold the optimal load at (") && msg.contains("choose Waterline or Offset rings"), "{msg}");
+}
+
+#[test]
+fn a_pocket_corner_too_sharp_to_turn_in_within_the_load_is_refused_by_name() {
+    // Square corners: the cutter's center turns on the spot in each, and
+    // the last sliver wraps a quarter of it however thin it is.
+    let region = rect(0.0, 0.0, 60.0, 40.0);
+    let mut sim = Sim::new(&region);
+    let stock = roughed(&region, &mut sim, BOTTOM);
+    let msg = refusal(rest_adaptive(&region, &rest_params(), &stock));
+    assert!(msg.contains("cannot hold the optimal load at ("), "{msg}");
+}
+
+#[test]
+fn a_roughing_pass_that_stops_above_the_rest_floor_is_refused_by_name() {
+    let region = filleted(&rect(0.0, 0.0, 60.0, 40.0), 3.0);
+    let mut sim = Sim::new(&region);
+    // Roughed to Z-2 only; the rest pass is asked down to Z-4.
+    let stock = roughed(&region, &mut sim, FIRST);
+    assert_eq!(stock.deepest(), FIRST);
+    let msg = refusal(rest_adaptive(&region, &rest_params(), &stock));
+    assert!(msg.contains("not proved at Z-4.000") && msg.contains("proved down to Z-2.000 only"), "{msg}");
+    // Down to the proved floor it plans, and holds every law there.
+    let shallow = PocketParams { bottom_z: FIRST, ..rest_params() };
+    let path = rest_adaptive(&region, &shallow, &stock).unwrap();
+    assert!(path.moves.iter().all(|m| m.to.z >= FIRST - 1e-9));
+    assert_eq!(check(&path, &region), Vec::new());
+}
+
+#[test]
+fn stock_that_is_not_proved_is_refused_by_name() {
+    let region = filleted(&rect(0.0, 0.0, 60.0, 40.0), 3.0);
+    let p = rest_params();
+    // No floor at all.
+    match RestStock::from_verified(Vec::new()) {
+        Err(GenError::Invalid(s)) => assert!(s.contains("no proved floor was given"), "{s}"),
+        other => panic!("expected a refusal, got {other:?}"),
+    }
+    let floor = |z: f64, remaining: Region, uncertain: Region| StockFloor { z, remaining, uncertain };
+    // A floor at no depth.
+    assert!(RestStock::from_verified(vec![floor(f64::NAN, Region::empty(), Region::empty())]).is_err());
+    // A film that is no length.
+    let corner = rect(0.0, 0.0, 5.0, 5.0).intersect(&region).unwrap();
+    let ok = RestStock::from_verified(vec![floor(BOTTOM, corner.clone(), Region::empty())]).unwrap();
+    assert_eq!(ok.film(), REST_STOCK_FILM);
+    assert!(ok.clone().with_film(-0.1).is_err() && ok.clone().with_film(f64::INFINITY).is_err());
+    // Uncertain everywhere: no position is proved clear, so no entry.
+    let doubt = RestStock::from_verified(vec![floor(BOTTOM, corner, region.clone())]).unwrap();
+    let msg = refusal(rest_adaptive(&region, &p, &doubt));
+    assert!(msg.contains("no entry with proved clearance"), "{msg}");
+    // Nothing left: said, not posted as an empty path.
+    let clean = RestStock::from_verified(vec![floor(BOTTOM, Region::empty(), Region::empty())]).unwrap();
+    match rest_adaptive(&region, &p, &clean) {
+        Err(GenError::Empty(s)) => assert!(s.contains("no rest material"), "{s}"),
+        other => panic!("expected Empty, got {other:?}"),
+    }
+}
+
+#[test]
+fn degenerate_input_errors_and_never_panics() {
+    let p = rest_params();
+    let some = |region: &Region| {
+        RestStock::from_verified(vec![StockFloor { z: BOTTOM, remaining: region.clone(), uncertain: Region::empty() }]).unwrap()
+    };
+    // Narrower than the tool.
+    let sliver = rect(0.0, 0.0, 20.0, 3.0);
+    assert!(refusal(rest_adaptive(&sliver, &p, &some(&sliver))).contains("narrower than the tool"));
+    // An empty pocket, a bad parameter.
+    assert!(rest_adaptive(&Region::empty(), &p, &some(&sliver)).is_err());
+    let region = filleted(&rect(0.0, 0.0, 30.0, 20.0), 3.0);
+    for bad in [
+        PocketParams { optimal_load: 0.0, ..p },
+        PocketParams { tool_diameter: f64::NAN, ..p },
+        PocketParams { stepdown: 0.0, ..p },
+        PocketParams { feed: -1.0, ..p },
+    ] {
+        assert!(rest_adaptive(&region, &bad, &some(&region)).is_err(), "{bad:?}");
+    }
+    // Sub-micron and barely-fitting shapes, stock that lies outside the
+    // pocket: any answer but a panic or a hang.
+    for (w, h) in [(1e-4, 1e-4), (4.0 + 1e-7, 30.0), (4.2, 4.2)] {
+        let tiny = rect(0.0, 0.0, w, h);
+        let _ = rest_adaptive(&tiny, &p, &some(&tiny));
+    }
+    let _ = rest_adaptive(&region, &p, &some(&rect(100.0, 100.0, 110.0, 110.0)));
+}
diff --git a/crates/motion/tests/rest_adaptive/sim.rs b/crates/motion/tests/rest_adaptive/sim.rs
new file mode 100644
index 000000000..1a3581751
--- /dev/null
+++ b/crates/motion/tests/rest_adaptive/sim.rs
@@ -0,0 +1,296 @@
+//! The independent reading of a rest Adaptive path (issue 2031): the
+//! earlier operation simulated on a column stock, the stock it proves,
+//! and the laws a rest path is held to against that simulation.
+
+use camcraft_motion::cl::{Move, MoveKind, Toolpath};
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::load::{load_at_rim, DEFAULT_OPTIMAL_LOAD};
+use camcraft_motion::machining2d::{pocket, GenError, PocketParams, PocketStrategy, RestStock, StockFloor};
+use camcraft_motion::quality::{measure, rest_area, stock_for, QualitySpec};
+use camcraft_motion::stock_sim::{Columns, Stock};
+use camcraft_motion::verify::{verify, Mode, ToolGeom, VerifyContext, Warning};
+
+/// The earlier (roughing) tool and this operation's tool.
+pub const PREV_D: f64 = 12.0;
+pub const TOOL_D: f64 = 4.0;
+pub const R: f64 = TOOL_D * 0.5;
+/// The stock's top, and the two cut depths both operations run.
+pub const TOP: f64 = 0.0;
+pub const FIRST: f64 = -2.0;
+pub const BOTTOM: f64 = -4.0;
+/// The measured load may read this far over the optimal load: the
+/// planner's own margin (`pocket_hsm::PLAN_TOL`). The stock is measured
+/// on the planner's grid (D/120, the heavy lane's): the contact angle is
+/// read on a rim a cell and a half outside the cutter, which in a
+/// concave corner stands in more wall the coarser the grid is (the same
+/// paths read up to 17.4% of D on the default D/80 grid, 12.5 to 14.7%
+/// on this one - the planner's own numbers to a tenth of a percent).
+pub const LOAD_SLACK: f64 = 0.05;
+
+pub fn poly(pts: &[(f64, f64)]) -> Region {
+    Region::new(vec![Loop::new(pts.iter().map(|&(x, y)| Point2::new(x, y)).collect()).unwrap()]).unwrap()
+}
+
+/// `region` with its inside corners rounded to `cr`.
+pub fn filleted(region: &Region, cr: f64) -> Region {
+    region.offset(-cr).unwrap().offset(cr).unwrap()
+}
+
+pub fn rect(x0: f64, y0: f64, x1: f64, y1: f64) -> Region {
+    poly(&[(x0, y0), (x1, y0), (x1, y1), (x0, y1)])
+}
+
+pub fn disc(c: Point2, r: f64) -> Region {
+    let pts: Vec<(f64, f64)> = (0..128)
+        .map(|k| {
+            let a = f64::from(k) * std::f64::consts::TAU / 128.0;
+            (c.x + r * a.cos(), c.y + r * a.sin())
+        })
+        .collect();
+    poly(&pts)
+}
+
+pub fn pp(d: f64, strategy: PocketStrategy, bottom: f64) -> PocketParams {
+    PocketParams {
+        blend_radius: None,
+        links: camcraft_motion::links::Links::PLANAR,
+        tool_diameter: d,
+        stepover: d * 0.4,
+        stock_to_leave: 0.0,
+        clearance_z: 5.0,
+        retract_z: Some(1.0),
+        top_z: FIRST,
+        bottom_z: bottom,
+        stepdown: 2.0,
+        feed: 400.0,
+        plunge_feed: 80.0,
+        climb: true,
+        strategy,
+        entry: Entry3D::Plunge,
+        helix_radius: 1.0,
+        optimal_load: DEFAULT_OPTIMAL_LOAD,
+        blend_turns: false,
+    }
+}
+
+pub fn rest_params() -> PocketParams {
+    pp(TOOL_D, PocketStrategy::Adaptive, BOTTOM)
+}
+
+pub fn dist(a: Point2, b: Point2) -> f64 {
+    (b.x - a.x).hypot(b.y - a.y)
+}
+
+/// The independent stock: a column grid of the pocket, cut by whatever
+/// path it is handed.
+pub struct Sim {
+    pub dex: Stock,
+    pub spec: QualitySpec,
+}
+
+impl Sim {
+    pub fn new(region: &Region) -> Sim {
+        // (The part outside the pocket stands as wall, a millimeter under
+        // the floor, the way `quality::stock_for` builds it; the grid is
+        // the planner's, see `LOAD_SLACK`.)
+        let spec = QualitySpec { wall_below: Some(BOTTOM - 0.5), cell: TOOL_D / 120.0, ..QualitySpec::new(TOOL_D) };
+        Sim { dex: stock_for(region, TOP, BOTTOM, 1.0, &spec).unwrap(), spec }
+    }
+
+    pub fn cut(&mut self, path: &Toolpath, r: f64) {
+        for m in path.moves.iter().filter(|m| m.kind != MoveKind::Rapid) {
+            for (a, b) in m.segments3(0.005) {
+                self.dex.cut_chord(a, b, r).unwrap();
+            }
+        }
+    }
+
+    /// A pillar the earlier operations left standing (put back).
+    pub fn stand(&mut self, at: Point2, r: f64) {
+        self.dex.set_tops(|_, c, top| if dist(c, at) <= r { TOP } else { top }).unwrap();
+    }
+
+    /// The highest stock under a disc of radius `rad` at `q`.
+    pub fn top_under(&self, q: Point2, rad: f64) -> f64 {
+        let cols: Columns<'_> = self.dex.columns().unwrap();
+        let cell = cols.cell();
+        let o = cols.origin();
+        let span = |v: f64, o: f64, n: usize| {
+            let lo = (((v - rad - o) / cell).floor().max(0.0) as usize).min(n.saturating_sub(1));
+            let hi = (((v + rad - o) / cell).ceil().max(0.0) as usize).min(n.saturating_sub(1));
+            lo..=hi
+        };
+        let mut top = f64::NEG_INFINITY;
+        for iy in span(q.y, o.y, cols.ny()) {
+            for ix in span(q.x, o.x, cols.nx()) {
+                if dist(cols.center(ix, iy), q) <= rad {
+                    top = top.max(cols.top_at(ix, iy));
+                }
+            }
+        }
+        top
+    }
+}
+
+/// The roughing pass of the earlier tool, cut into `sim`, and the stock
+/// it PROVES: per roughing depth, the pocket less what its feeds at that
+/// depth or deeper swept (the sweep read a hundredth small, so chord
+/// error only adds material). Checked against the simulation: nothing
+/// the simulation still holds stands outside the proved bound.
+pub fn roughed(region: &Region, sim: &mut Sim, bottom: f64) -> RestStock {
+    let rough = pocket(region, &pp(PREV_D, PocketStrategy::Waterline, bottom)).unwrap();
+    sim.cut(&rough, PREV_D * 0.5);
+    let flat = |m: &&Move| m.kind == MoveKind::Feed && (m.from.z - m.to.z).abs() < 1e-9;
+    let mut zs: Vec<f64> = rough.moves.iter().filter(flat).map(|m| m.to.z).collect();
+    zs.sort_by(f64::total_cmp);
+    zs.dedup();
+    let floors: Vec<StockFloor> = zs
+        .iter()
+        .map(|&z| {
+            let walks: Vec<Vec<Point2>> = rough
+                .moves
+                .iter()
+                .filter(flat)
+                .filter(|m| m.to.z <= z + 1e-9)
+                .flat_map(|m| m.chords(0.002))
+                .map(|(a, b)| vec![a, b])
+                .collect();
+            let cleared = Region::sweep(&walks, PREV_D * 0.5 - 0.01).unwrap();
+            StockFloor { z, remaining: region.difference(&cleared).unwrap(), uncertain: Region::empty() }
+        })
+        .collect();
+    let cols = sim.dex.columns().unwrap();
+    let inside = region.offset(-0.1).unwrap();
+    for f in &floors {
+        let bound = f.remaining.offset(0.1).unwrap();
+        let mut outside = 0usize;
+        for iy in 0..cols.ny() {
+            for ix in 0..cols.nx() {
+                let c = cols.center(ix, iy);
+                if cols.top_at(ix, iy) > f.z + 1e-3 && inside.contains(c) && !bound.contains(c) {
+                    outside += 1;
+                }
+            }
+        }
+        assert_eq!(outside, 0, "the proved stock at Z{} reads smaller than the simulated stock", f.z);
+    }
+    RestStock::from_verified(floors).unwrap()
+}
+
+pub fn check(path: &Toolpath, region: &Region) -> Vec<Warning> {
+    let t = ToolGeom {
+        radius: R,
+        nose_radius: 0.0,
+        flute_len: 30.0,
+        shank_radius: R,
+        shank_len: 40.0,
+        holder_radius: 20.0,
+        holder_len: 60.0,
+    };
+    let cx = VerifyContext {
+        region,
+        stock: None,
+        model: None,
+        tool: &t,
+        cutter: None,
+        mode: Mode::Area,
+        stock_top_z: TOP,
+        clearance_z: 5.0,
+        stock_to_leave: 0.0,
+        gouge_tol: 0.01,
+        z_tol: 1e-6,
+        finish_tol: None,
+        fixtures: &[],
+        spindle: None,
+        ..Default::default()
+    };
+    verify(path, &cx)
+}
+
+/// The only rapid allowed below the top of the stock: straight up, out
+/// of where the tool has just cut.
+pub fn lifts_out(m: &Move) -> bool {
+    m.from.x == m.to.x && m.from.y == m.to.y && m.to.z > m.from.z
+}
+
+/// What a rest path did, read on the simulated stock the earlier
+/// operations left (`sim`, which this cuts).
+pub struct Reading {
+    /// Worst load (ae/D) of the planar cuts at each requested depth.
+    pub load: Vec<(f64, f64)>,
+    /// Stock left standing above the bottom inside the tool's reach (mm^2).
+    pub left: f64,
+    pub plunges: usize,
+}
+
+/// The laws every rest Adaptive path is held to: the verifier passes;
+/// no rapid meets material; every plunge goes down a column the EARLIER
+/// operations cleared for the whole cutter footprint (this operation's
+/// own cuts are not credited); the load holds at every depth.
+pub fn read(path: &Toolpath, region: &Region, sim: &mut Sim) -> Reading {
+    read_leaving(path, region, sim, 0.0)
+}
+
+/// [`read`] for a path that leaves `leave` mm on the walls.
+pub fn read_leaving(path: &Toolpath, region: &Region, sim: &mut Sim, leave: f64) -> Reading {
+    assert_eq!(check(path, region), Vec::new(), "verifier");
+    assert!(path.is_chained() && path.all_finite());
+    let mut plunges = 0;
+    for (k, m) in path.moves.iter().enumerate() {
+        match m.kind {
+            MoveKind::Rapid if lifts_out(m) => {}
+            MoveKind::Rapid => {
+                let low = m.from.z.min(m.to.z);
+                assert!(low >= TOP - 1e-9, "move {k}: a rapid below the top of the stock: {m:?}");
+                for (a, b) in m.chords(0.5) {
+                    for q in [a, b] {
+                        assert!(sim.top_under(q, R + 0.05) <= low + 1e-6, "move {k}: a rapid over stock that stands higher");
+                    }
+                }
+            }
+            MoveKind::Plunge => {
+                plunges += 1;
+                assert!(m.from.x == m.to.x && m.from.y == m.to.y, "move {k}: a plunge that is not straight down");
+                let at = Point2::new(m.to.x, m.to.y);
+                let under = sim.top_under(at, R + 0.05);
+                assert!(under <= m.to.z + 0.01, "move {k}: a plunge to Z{} over stock standing to Z{under} under the cutter", m.to.z);
+            }
+            MoveKind::Feed => assert!((m.from.z - m.to.z).abs() < 1e-9, "move {k}: a feed that is not planar"),
+        }
+    }
+    let q = measure(path, &mut sim.dex, &sim.spec).unwrap();
+    assert_eq!(q.descents, 0, "a descent bit stock");
+    assert!(q.entry_max_deg < 1.0, "a plunge read {} degrees of contact", q.entry_max_deg);
+    assert_eq!(q.slot_len, 0.0, "slotting");
+    let load = [FIRST, BOTTOM]
+        .iter()
+        .map(|&z| {
+            let at_depth = path.moves.iter().zip(&q.move_max).filter(|(m, _)| m.kind == MoveKind::Feed && (m.to.z - z).abs() < 1e-9);
+            let deg = at_depth.map(|(_, &d)| d).fold(0.0f64, f64::max);
+            (z, load_at_rim(deg, TOOL_D, q.rim))
+        })
+        .collect();
+    // In reach: what a 4 mm tool's edge gets to, a tenth short of it.
+    let reach = region.offset(-(R + leave)).unwrap().offset(R - 0.1).unwrap();
+    Reading { load, left: rest_area(&sim.dex, &reach, BOTTOM).unwrap(), plunges }
+}
+
+pub fn assert_load_held(r: &Reading) {
+    for &(z, load) in &r.load {
+        assert!(load > 0.02, "Z{z}: nothing was cut (worst load {:.1}% of D)", load * 100.0);
+        assert!(
+            load <= DEFAULT_OPTIMAL_LOAD * (1.0 + LOAD_SLACK),
+            "Z{z}: the measured load {:.1}% of D is past the optimal {:.1}%",
+            load * 100.0,
+            DEFAULT_OPTIMAL_LOAD * 100.0
+        );
+    }
+}
+
+pub fn refusal(r: Result<Toolpath, GenError>) -> String {
+    match r {
+        Err(e @ (GenError::Invalid(_) | GenError::At { .. })) => e.to_string(),
+        other => panic!("expected a named refusal, got {other:?}"),
+    }
+}
diff --git a/docs/decisions/2031-rest-adaptive.md b/docs/decisions/2031-rest-adaptive.md
new file mode 100644
index 000000000..61278e1ec
--- /dev/null
+++ b/docs/decisions/2031-rest-adaptive.md
@@ -0,0 +1,140 @@
+## #2031 - 2D rest Adaptive: plan engagement from proved remaining stock
+
+**What was decided**
+
+1. **A generator of its own, in the motion crate.**
+   `camcraft_motion::machining2d::rest_adaptive(region, params, stock)`
+   (`crates/motion/src/machining2d/adaptive/rest/`). It takes the pocket,
+   the pocket's own parameters and a `RestStock`. The operation's
+   parameter door (`rest2d::rest_strategy`) still refuses Adaptive by
+   name: the operation only has an entered previous tool, which is no
+   proof. Lifting that refusal is the work of the task that derives the
+   stock from the earlier operations (#2033): it builds a `RestStock`
+   and calls this generator.
+
+2. **The stock contract.** A `RestStock` is a list of proved floors. A
+   floor at depth `z` claims: inside the pocket, at and above `z`,
+   material stands only inside `remaining` or `uncertain`. Below `z` it
+   says nothing. For a cut depth, every floor at least that deep speaks,
+   and the bound is the intersection of what they allow. There is no
+   constructor from a tool diameter.
+
+3. **Three guards, each with a pinning test that fails without it**
+   (`adaptive/rest/tests.rs` runs the planner with one guard off):
+   - stock: `uncertain` stands as material;
+   - depth: a cut depth below every proved floor is refused by name
+     before anything is planned;
+   - entry: a plunge needs the whole footprint, plus a margin (0.1 mm or
+     four grid cells), proved clear by the stock as it was given. What
+     this operation's own passes cleared is never credited to a plunge:
+     a column cleared at this depth says nothing about the depths above.
+     The proof is asked twice, of the polygon and of the raster.
+
+4. **Conservative raster.** The stock bound is grown by a cell's half
+   diagonal (plus two offset tolerances) before it is sampled at cell
+   centers, so every cell the bound touches stands
+   (`adaptive/raster/conservative.rs`). Every load reading stands on this
+   raster.
+
+5. **A film is safety material, not a target.** A bound read large keeps
+   a thin band along every wall the earlier tool rode. Residue thinner
+   than `RestStock::film()` (default 0.02 mm, `rest2d`'s film) gets no
+   pass planned for it. It still stands for every load reading and no
+   plunge lands on it. Without this the planner laps every wall.
+
+6. **The passes: the opened room.** The room is the legal center area
+   minus the material grown by the tool radius less the step. It is
+   opened (eroded, then dilated) by a disc whose radius falls phase by
+   phase, by at most 15% and at most a step and a half, down to an eighth
+   of the tool radius, then zero. A pass is the room's boundary where it
+   bites. In a corner this gives arcs tangent to both walls; across a
+   neck it gives half loops (trochoidal motion); a piece of material that
+   touches no wall is not opened and is cut by closed rings.
+   The first design rode the wall into the corner's wedge with a fixed
+   0.5 r blend. It was dropped on measurement: a wedge 0.03 mm thick
+   already reads 25 degrees of contact, and the second pass of a corner
+   read past the bound at every step of the ladder.
+
+7. **The load is proved or the pass is not cut.** Each candidate feed
+   (lead and link included) is walked on the raster before it is kept.
+   The bound is the optimal load plus the plain Adaptive's 5% planning
+   margin (`PLAN_TOL`). There is no overload fallback (the plain Adaptive
+   cuts up to twice the load and says so; the issue asks for a refusal).
+   What the last, sharp phase cannot cut is left standing; if that is
+   more than 2% of the rest material in reach, the operation is refused
+   and the refusal names the load and the place. Under 2% it is said in a
+   note.
+
+8. **No crossing by construction, then checked.** The verifier reads a
+   feed-feed crossing by exact signs. Passes that ride a wall ride it on
+   one fixed vertex list (`canon.rs`), room vertices within 0.05 mm of a
+   wall are snapped to it, and a pass in an area cut before is stretched
+   along the walls to where the earlier passes of that area landed and
+   left. The way in, the way out and the link between are then retraced
+   chord for chord. Each candidate is still asked the crossing law
+   against the depth's earlier feeds; a crossing candidate is not kept.
+
+9. **Chords, no arc fit.** The posted moves are the chords that were
+   measured. The plain Adaptive fits arcs and gives 5% of margin for it;
+   here the measured path is the posted path.
+
+10. **The entry is always a plunge** into proved air. The `entry` family
+    and the pocket's links describe entries into material, and are not
+    read.
+
+**Why**
+
+The issue's contract: separate legal-center and remaining-material
+regions per depth, cleared space derived from verified stock, engagement
+initialised from the remaining material, the whole footprint and approach
+proved before an entry, named refusals, a conservative raster, a bounded
+budget.
+
+**Known limits (each a named refusal, pinned by a test)**
+
+- A pocket corner the cutter's center has to turn in on an arc under
+  about 0.35 tool radii (a pocket fillet under about 1.35 tool radii plus
+  the stock to leave): the last sliver wraps a quarter of the cutter
+  however thin it is. Refused: "cannot hold the optimal load at (x, y)".
+  Follow-up issue filed (leave corner rest with a note, or cut it over
+  the load by name - the maintainer's call).
+- A neck under about 2.5 tool diameters wide. The 10 mm neck of the test
+  is cut by a 4 mm tool; the 6 mm one is refused.
+- One entry per area and depth is the aim; a neck takes more (37 per
+  depth on the test's 10 mm neck), because a half loop whose way back
+  would cross an earlier feed is reached by a retract.
+
+**Readings** (debug build, 4 mm tool after a 12 mm tool, two depths)
+
+| Fixture | Passes a depth | Plunges a depth | Worst planned load | Measured (D/120 grid) | Cut / air feed / rapid (mm) | Planning time |
+|---|---|---|---|---|---|---|
+| 60 x 40, 3 mm corners | 40 | 4 | 14.4% | 13.1% of D | 224 / 967 / 360 | 3.6 s |
+| 70 x 50 with a 14 x 14 island | 36 | 4 | 13.4% | 13.5% | 250 / 955 / 450 | 4.9 s |
+| two bays, 10 mm neck | 128 | 37 | 15.4% | 15.1% | 954 / 3445 / 1337 | 19 s |
+
+Optimal load 14.6% of D. The measuring stock is on the planner's grid
+(D/120, the heavy lane's): on the default D/80 grid the same paths read
+up to 17.4% in a concave corner, because the yardstick's rim stands a
+cell and a half outside the cutter and takes in more wall there.
+
+The air feed is high (about four times the cut length): every pass of an
+area rides the wall in from the area's first landing and out to its first
+exit, and returns on one chord. That is the price of retracing instead of
+crossing (point 8). The plain Adaptive holds its plans to 1.5 times; this
+one is not held to that budget yet (named in the follow-up issue).
+
+**Considered and dropped**
+
+- Reusing the plain Adaptive's `open_rounds`: it assumes its own bore,
+  re-enters wherever a cut starts, cuts over the load up to a cap and
+  laps the whole wall.
+- A stay-down return on Dubins links: fresh links a few microns from an
+  earlier feed cross it under the exact-sign law.
+- Planning all areas phase by phase: one retract per pass (31 a depth on
+  the corner fixture, against 4).
+
+**Cost to change later**
+
+The stock contract (`RestStock`, `StockFloor`) is the public surface; the
+planner behind it can be replaced. Changing what a floor claims changes
+#2033's producer with it.

