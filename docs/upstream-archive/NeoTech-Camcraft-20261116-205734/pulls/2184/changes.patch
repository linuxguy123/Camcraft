diff --git a/crates/app/src/fixture_locate_land.rs b/crates/app/src/fixture_locate_land.rs
new file mode 100644
index 000000000..5c6efe097
--- /dev/null
+++ b/crates/app/src/fixture_locate_land.rs
@@ -0,0 +1,182 @@
+//! Does a located stock land on its mates (#2173)? A stock locate moves
+//! the part and lets its stock follow; a square stock re-fits round a
+//! turned part, so the follow can leave the picked stock faces off the
+//! fixture planes they were mated to. Each picked face is judged on the
+//! body the follow builds: facets that face the way the picked face must
+//! (1 - cos of their angle within [`NORMAL_TOL`]) and lie on the mate plane (within
+//! [`LEN_TOL_MM`]) must cover the face's whole footprint there. A
+//! picked vertex must be a corner of the followed stock. The box of the
+//! two bodies must also agree. Anything else is refused by name.
+//!
+//! Provenance: plane and point datums of 3-2-1 fixturing (machine-tool
+//! and fixture-design handbooks); triangle area and barycentric
+//! containment are standard computational geometry. Our own code, no
+//! vendor material.
+
+use flecs_ecs::prelude::World;
+
+use super::{LEN_TOL_MM, LocateSpec, NORMAL_TOL, Plan, stock_carried};
+use crate::geometry::{Point3, Triangle, feature, transform_point};
+use crate::model;
+use crate::operation::{FeatureSel, GeoSel};
+
+/// The share of a picked face's area that the followed stock may lack on
+/// the mate plane (rounding of the re-fit sizes only).
+pub const FACE_AREA_REL_TOL: f64 = 1e-3;
+
+type V = [f64; 3];
+
+fn v(p: Point3) -> V {
+    [p.x, p.y, p.z]
+}
+fn sub(a: V, b: V) -> V {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+fn dot(a: V, b: V) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+fn cross(a: V, b: V) -> V {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+fn norm(a: V) -> f64 {
+    dot(a, a).sqrt()
+}
+/// Twice the triangle's vector area (its normal times twice its area).
+fn area2(t: &Triangle) -> V {
+    cross(sub(v(t.b), v(t.a)), sub(v(t.c), v(t.a)))
+}
+
+/// A stock locate lands only where the followed stock meets every mate.
+/// `stocks` are the moved stock bodies (setup frame) of the part write;
+/// the rigid carry of the stock by the plan is where the mates put it.
+pub fn stock_lands(world: &World, spec: &LocateSpec, plan: &Plan, stocks: &[(String, Vec<Triangle>)]) -> Result<(), String> {
+    let name = crate::setup::stock_entity_name(world, plan.setup.as_deref());
+    let carried = stock_carried(world, plan);
+    let want = carried.iter().find(|(n, _)| *n == name).map(|(_, t)| t.as_slice());
+    let got = stocks.iter().find(|(n, _)| *n == name).map(|(_, t)| t.as_slice());
+    let not_following =
+        || format!("the stock '{name}' does not follow the part - set the stock round the part, or locate the part");
+    let (Some(want), Some(got)) = (want, got) else {
+        return Err(not_following());
+    };
+    let (Some(wb), Some(gb)) = (box_of(want), box_of(got)) else {
+        return Err(not_following());
+    };
+    let off = (0..3).any(|k| (wb.0[k] - gb.0[k]).abs() > LEN_TOL_MM || (wb.1[k] - gb.1[k]).abs() > LEN_TOL_MM);
+    if off {
+        return Err(format!(
+            "the stock '{name}' stays square round the part and would not land on the mates - locate it without a turn, or locate the part"
+        ));
+    }
+    // A rigid carry (a stock that does not re-fit) lands by construction.
+    let same = want.len() == got.len()
+        && want.iter().zip(got).all(|(a, b)| [(a.a, b.a), (a.b, b.b), (a.c, b.c)].into_iter().all(|(p, q)| norm(sub(v(p), v(q))) <= LEN_TOL_MM));
+    if same {
+        return Ok(());
+    }
+    let e = model::find_by_name(world, &name).ok_or_else(not_following)?;
+    let features = model::features_of(world, &e).ok_or_else(not_following)?;
+    let pose = model::transform_of(world, &e).unwrap_or_default();
+    for (i, m) in spec.mates.iter().enumerate() {
+        let k = i + 1;
+        let missed = |what: &str| {
+            format!(
+                "mate {k}: {} of the stock '{name}' {what} {} of '{}' - the stock keeps its upright shape round the turned part, so that face does not meet the fixture; locate it without a turn, or locate the part",
+                m.part.feature, m.fixture.feature, m.fixture.entity
+            )
+        };
+        match m.part.feature {
+            FeatureSel::Face(fid) => {
+                let f = features.faces.iter().find(|f| f.id == fid).ok_or_else(|| gone(&m.part))?;
+                let face: Vec<Triangle> = f.facets.iter().filter_map(|&i| want.get(i as usize).copied()).collect();
+                if face.len() != f.facets.len() {
+                    return Err(gone(&m.part));
+                }
+                if !face_lands(&face, got) {
+                    return Err(missed("would stand across the plane of, not flat on,"));
+                }
+            }
+            FeatureSel::Vertex(id) => {
+                let p = feature::resolve_vertex(&features, id)
+                    .and_then(|vi| features.verts.get(vi as usize))
+                    .map(|q| transform_point(Point3::new(q[0], q[1], q[2]), pose.pos, pose.rot))
+                    .map(|q| v(transform_point(q, plan.delta.pos, plan.delta.rot)))
+                    .ok_or_else(|| gone(&m.part))?;
+                let corner = got.iter().flat_map(|t| [t.a, t.b, t.c]).any(|q| norm(sub(v(q), p)) <= LEN_TOL_MM);
+                if !corner {
+                    return Err(missed("would not touch"));
+                }
+            }
+            // `plan` refuses edges and curved patches before this runs.
+            FeatureSel::Patch(_) | FeatureSel::Chain(_) => {}
+        }
+    }
+    Ok(())
+}
+
+fn gone(g: &GeoSel) -> String {
+    format!("{} of '{}' is gone - re-pick it", g.feature, g.entity)
+}
+
+/// Does the face `face` (where the mates put it) lie on the followed
+/// body `got`? The face's plane is its
+/// area-weighted normal through its first corner. `got` must hold
+/// facets on that plane that face the same way (parallel within
+/// [`NORMAL_TOL`]), covering the face's area and each of its facet
+/// centres. Both bodies come from one mesher, so a facet's winding says
+/// which way it faces.
+fn face_lands(face: &[Triangle], got: &[Triangle]) -> bool {
+    let sum = face.iter().map(area2).fold([0.0; 3], |a, b| [a[0] + b[0], a[1] + b[1], a[2] + b[2]]);
+    let (len, area) = (norm(sum), face.iter().map(|t| 0.5 * norm(area2(t))).sum::<f64>());
+    let Some(first) = face.first() else { return false };
+    if !(len.is_finite() && len > 0.0 && area > 0.0) {
+        return false;
+    }
+    let n = [sum[0] / len, sum[1] / len, sum[2] / len];
+    let at = v(first.a);
+    let d = |p: Point3| dot(sub(v(p), at), n);
+    let on: Vec<&Triangle> = got
+        .iter()
+        .filter(|t| [t.a, t.b, t.c].into_iter().all(|p| d(p).abs() <= LEN_TOL_MM))
+        .filter(|t| {
+            let a = area2(t);
+            let l = norm(a);
+            l > 0.0 && (1.0 - dot(a, n) / l) <= NORMAL_TOL
+        })
+        .collect();
+    let covered: f64 = on.iter().map(|t| 0.5 * norm(area2(t))).sum();
+    if covered < area * (1.0 - FACE_AREA_REL_TOL) {
+        return false;
+    }
+    face.iter().all(|t| {
+        let c = [(t.a.x + t.b.x + t.c.x) / 3.0, (t.a.y + t.b.y + t.c.y) / 3.0, (t.a.z + t.b.z + t.c.z) / 3.0];
+        on.iter().any(|g| inside(g, c))
+    })
+}
+
+/// Is `p` (on the triangle's plane) inside `t`, edges included?
+fn inside(t: &Triangle, p: V) -> bool {
+    let (a, b, c) = (v(t.a), v(t.b), v(t.c));
+    let n = cross(sub(b, a), sub(c, a));
+    let nn = dot(n, n);
+    if nn.is_nan() || nn <= 0.0 {
+        return false;
+    }
+    let tol = LEN_TOL_MM * nn.sqrt();
+    [(a, b), (b, c), (c, a)].into_iter().all(|(s, e)| dot(cross(sub(e, s), sub(p, s)), n) >= -tol * norm(sub(e, s)))
+}
+
+/// The (min, max) box of a body; `None` when empty or not finite.
+fn box_of(tris: &[Triangle]) -> Option<(V, V)> {
+    let (mut lo, mut hi) = ([f64::INFINITY; 3], [f64::NEG_INFINITY; 3]);
+    for p in tris.iter().flat_map(|t| [t.a, t.b, t.c]) {
+        for (k, x) in v(p).into_iter().enumerate() {
+            if !x.is_finite() {
+                return None;
+            }
+            lo[k] = lo[k].min(x);
+            hi[k] = hi[k].max(x);
+        }
+    }
+    (lo[0] <= hi[0]).then_some((lo, hi))
+}
diff --git a/crates/app/tests/fixture_locate_stock_cylinder.rs b/crates/app/tests/fixture_locate_stock_cylinder.rs
new file mode 100644
index 000000000..31bd0d562
--- /dev/null
+++ b/crates/app/tests/fixture_locate_stock_cylinder.rs
@@ -0,0 +1,160 @@
+//! #2173 review: a stock locate judges the picked stock face itself, not
+//! the box of the stock. A cylinder stock re-fits upright round a turned
+//! part, so its picked cap would stand across the mate plane while the
+//! box of the stock still matches: refused by name. The same cap mated on
+//! the vise floor lands flat, at the right height, and the fixture
+//! collision check reads the stock where it lands.
+//! Provenance: our own fixtures over plain vise practice (machine-tool
+//! handbooks); no vendor material consulted.
+//!
+//! Gate map (#2173): covers app::fixture_locate (stock_lands and its
+//! face check in fixture_locate_land.rs), app::commands::locate,
+//! app::fixture_clash (after_fixture_move).
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use flecs_ecs::prelude::World;
+
+use camcraft_app::commands::{CreateSetup, History, ImportModel, LocatePart, SetStock, TagFixture};
+use camcraft_app::fixture_clash;
+use camcraft_app::fixture_locate::{self, LocateBody, LocateOffset, LocateSpec, Mate};
+use camcraft_app::geometry::{Mesh, Point3, Triangle, cube};
+use camcraft_app::model;
+use camcraft_app::operation::{FeatureSel, GeoSel};
+use camcraft_app::pick::{MateDatum, facets_centroid};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::world::new_world;
+
+fn p(x: f64, y: f64, z: f64) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+/// Floor top at Z 0 (+Z), fixed jaw face at Y -1 (+Y), stop face at X -1 (+X).
+fn vise() -> Vec<Triangle> {
+    let mut t: Vec<Triangle> = cube(p(0.0, 0.0, -10.0), p(100.0, 60.0, 0.0)).facets.to_vec();
+    t.extend(cube(p(0.0, -20.0, 0.5), p(100.0, -1.0, 40.0)).facets.iter());
+    t.extend(cube(p(-20.0, 0.0, 0.5), p(-1.0, 60.0, 30.0)).facets.iter());
+    t
+}
+
+/// The reviewer's case (a 10 mm cube part, a D20 x H20 cylinder stock
+/// 5 mm under it and centred on it), moved to [40, 30, 0] over the
+/// middle of the vise floor so the legal twin stands clear of the jaws.
+fn document() -> (World, History) {
+    let world = new_world();
+    let mut h = History::default();
+    h.execute(&world, ImportModel::from_mesh("part", cube(p(40.0, 30.0, 0.0), p(50.0, 40.0, 10.0))));
+    h.execute(&world, ImportModel::from_mesh("vise", Mesh { facets: vise().into() }));
+    h.execute(&world, TagFixture::new(&world, "vise", None).expect("mark the vise"));
+    h.execute(&world, CreateSetup::new(&world, None, None).expect("Setup1"));
+    let shape = StockShape::Cylinder { diameter: 20.0, height: 20.0 };
+    let at = Location { pos: p(45.0, 35.0, -5.0), ..Location::default() };
+    h.execute(&world, SetStock::new(&world, shape, at).expect("cylinder stock"));
+    (world, h)
+}
+
+fn stock_name(world: &World) -> String {
+    camcraft_app::setup::stock_entity_name(world, Some("Setup1"))
+}
+
+/// The vise face whose facets centre on the point `c` (vise local = world).
+fn vise_face(world: &World, c: [f64; 3]) -> GeoSel {
+    let e = model::find_by_name(world, "vise").expect("vise");
+    let f = model::features_of(world, &e).expect("features");
+    let tris = model::facets_of(world, &e).expect("facets");
+    let id = f
+        .faces
+        .iter()
+        .find(|f| {
+            facets_centroid(&tris, f.facets.iter().map(|&i| i as usize))
+                .is_some_and(|m| (0..3).all(|k| (m[k] - c[k]).abs() < 1e-6))
+        })
+        .map(|f| f.id)
+        .unwrap_or_else(|| panic!("the vise has a face centred on {c:?}"));
+    GeoSel { entity: "vise".into(), feature: FeatureSel::Face(id) }
+}
+
+/// The stock's bottom cap (outward normal -Z), read where the locate reads it.
+fn bottom_cap(world: &World) -> GeoSel {
+    let name = stock_name(world);
+    let e = model::find_by_name(world, &name).expect("stock");
+    let f = model::features_of(world, &e).expect("stock features");
+    f.faces
+        .iter()
+        .map(|f| GeoSel { entity: name.clone(), feature: FeatureSel::Face(f.id) })
+        .find(|g| {
+            matches!(fixture_locate::read_pick(world, "vise", g),
+                Ok(MateDatum::Plane { normal, .. }) if (normal[2] + 1.0).abs() < 1e-9)
+        })
+        .unwrap_or_else(|| panic!("the cylinder stock has a bottom cap"))
+}
+
+/// One face mate: the stock's bottom cap on the vise face centred on `c`.
+fn cap_on(world: &World, c: [f64; 3]) -> LocateSpec {
+    let mates = vec![Mate { part: bottom_cap(world), fixture: vise_face(world, c) }];
+    LocateSpec { part: "part".into(), fixture: "vise".into(), body: LocateBody::Stock, mates, offset: LocateOffset::default() }
+}
+
+fn bounds(world: &World, name: &str) -> ([f64; 3], [f64; 3]) {
+    let e = model::find_by_name(world, name).expect("entity");
+    let b = model::entity_world_aabb(world, &e).expect("bounds");
+    ([b.min.x, b.min.y, b.min.z], [b.max.x, b.max.y, b.max.z])
+}
+
+/// The reviewer's repro: the cap on the stop face (normal +X) needs a
+/// quarter turn; the upright re-fit keeps the cap at -Z, perpendicular
+/// to the stop, with the same box. Refused at the command, by name.
+#[test]
+fn a_cylinder_cap_mated_across_its_plane_is_refused() {
+    let (world, _h) = document();
+    let before = (bounds(&world, &stock_name(&world)), bounds(&world, "part"));
+    let spec = cap_on(&world, [-1.0, 30.0, 15.25]);
+    let cap = spec.mates[0].part.feature.to_string();
+    let stop = spec.mates[0].fixture.feature.to_string();
+    let Err(e) = LocatePart::new(&world, &spec) else { panic!("the cap would stand across the stop face") };
+    let e = e.to_string();
+    assert!(e.contains(&format!("mate 1: {cap} of the stock '{}'", stock_name(&world))), "names the stock face: {e}");
+    assert!(e.contains(&format!("the plane of, not flat on, {stop} of 'vise'")), "names the fixture plane: {e}");
+    assert_eq!((bounds(&world, &stock_name(&world)), bounds(&world, "part")), before, "a refusal moves nothing");
+}
+
+/// The legal twin: the cap on the floor (normal +Z) needs no turn. The
+/// stock lands flat at Z 0, keeps its 20 mm height, the part keeps its
+/// 5 mm above the cap, and the collision check reads the landed stock.
+#[test]
+fn a_cylinder_cap_mated_on_the_floor_lands_at_the_right_height() {
+    let (world, mut h) = document();
+    let c = LocatePart::new(&world, &cap_on(&world, [50.0, 30.0, 0.0])).expect("the cap lands on the floor");
+    h.execute(&world, c);
+    let name = stock_name(&world);
+    let (lo, hi) = bounds(&world, &name);
+    assert!(lo[2].abs() < 1e-6, "the cap on the floor at Z 0: {lo:?}");
+    assert!((hi[2] - 20.0).abs() < 1e-6, "the stock keeps its 20 mm height: {hi:?}");
+    assert!((hi[0] - lo[0] - 20.0).abs() < 1e-6, "the stock stays upright, D20: {lo:?} {hi:?}");
+    let (plo, phi) = bounds(&world, "part");
+    assert!((plo[2] - 5.0).abs() < 1e-6 && (phi[2] - 15.0).abs() < 1e-6, "the part keeps its place: {plo:?}");
+    assert!((plo[0] - lo[0] - 5.0).abs() < 1e-6 && (plo[1] - lo[1] - 5.0).abs() < 1e-6, "centred in the stock: {plo:?} {lo:?}");
+    // The collision check reads the stock where it landed: flush is clear,
+    // and a 2 mm lower stock (the part 3 mm above the floor) sinks in.
+    assert_eq!(fixture_clash::after_fixture_move(&world, "vise", Location::default()), None, "flush on the floor");
+    h.undo(&world);
+    let mut sunk = cap_on(&world, [50.0, 30.0, 0.0]);
+    sunk.offset.dz = -2.0;
+    h.execute(&world, LocatePart::new(&world, &sunk).expect("built"));
+    let w = fixture_clash::after_fixture_move(&world, "vise", Location::default()).expect("the check reads the landed stock");
+    assert!(w.contains(&format!("'{name}'")), "{w}");
+}
+
+/// A cap on the floor with a quarter turn about the floor normal: the
+/// stock re-fits upright with other facets than the turned rigid body,
+/// so the face check itself (not the rigid shortcut) must accept it.
+#[test]
+fn a_turned_cylinder_cap_on_the_floor_is_judged_by_its_face_and_lands() {
+    let (world, mut h) = document();
+    let mut spec = cap_on(&world, [50.0, 30.0, 0.0]);
+    spec.offset.turn_deg = 90.0;
+    let c = LocatePart::new(&world, &spec).expect("the turned cap still lands flat on the floor");
+    h.execute(&world, c);
+    let (lo, hi) = bounds(&world, &stock_name(&world));
+    assert!(lo[2].abs() < 1e-6 && (hi[2] - 20.0).abs() < 1e-6, "flat on the floor, 20 mm high: {lo:?} {hi:?}");
+}
