+fn tmp_nc(tag: &str) -> PathBuf {
+    let mut p = std::env::temp_dir();
+    p.push(format!("camcraft-760-ctl-{tag}-{}.nc", std::process::id()));
+    let _ = fs::remove_file(&p);
+    p
+}
