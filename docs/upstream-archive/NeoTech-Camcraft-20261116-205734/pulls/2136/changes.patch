+        return None;
+    }
+    Some(format!(
+        "3-2-1 WCS Z would tilt {:.1} deg off the machine's Z - on a mill the tool always cuts along \
+         machine +Z; turn the part with Part alignment on the Setup page instead",
+        angle.to_degrees()
+    ))
+}
