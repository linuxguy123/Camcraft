new file mode 100644
index 000000000..75acf9e7b
--- /dev/null
+++ b/crates/post/src/post/wcs_rotate.rs
@@ -0,0 +1,243 @@
+//! Carry a Z-rotated work offset (`WcsYaw`) into the CNC record stream (#760).
+//! Provenance: standard 2D frame rotation in the XY plane about OriginX/Y.
+
+use serde_json::{Value, json};
+
+use super::PostError;
+use super::cnc::Record;
+use super::js::Script;
+
+const TOL_RAD: f64 = 1e-9;
+
+fn rotate_xy(x: f64, y: f64, ox: f64, oy: f64, s_y: f64, c_y: f64) -> (f64, f64) {
+    let dx = x - ox;
+    let dy = y - oy;
+    (ox + dx * c_y + dy * s_y, oy - dx * s_y + dy * c_y)
+}
+
+fn read_finite(v: &Value, name: &str) -> Result<f64, PostError> {
+    v.as_f64()
+        .filter(|x| x.is_finite())
+        .ok_or_else(|| PostError::Refused(format!("stream parameter {name} must be a finite number")))
+}
+
+fn chunk_bounds(records: &[Record]) -> Vec<(usize, usize)> {
+    let mut spans = Vec::new();
+    let mut start = 0usize;
+    for (i, r) in records.iter().enumerate() {
+        if matches!(r, Record::Section { begin: false }) {
+            spans.push((start, i + 1));
+            start = i + 1;
+        }
+    }
+    if start < records.len() {
+        spans.push((start, records.len()));
+    }
+    spans
+}
+
+fn check_section_supported(chunk: &[Record]) -> Result<(), PostError> {
+    for r in chunk {
+        match r {
+            Record::Touch(_) | Record::Guard(_) | Record::Retreat(_) | Record::Found(_) => {
+                return Err(PostError::Refused(
+                    "probing on a rotated work offset is not supported yet - post probing from an unrotated setup".into(),
+                ));
+            }
+            Record::Thread(_) => {
+                return Err(PostError::Refused(
+                    "lathe threading on a rotated work offset is not supported - use an unrotated setup".into(),
+                ));
+            }
+            Record::Param { name, .. } if name == "EdmCondition" || name == "SinkerCondition" => {
+                return Err(PostError::Refused(
+                    "EDM on a rotated work offset is not supported yet - use an unrotated setup".into(),
+                ));
+            }
+            Record::Param { name, .. } if name == "LiveTool" => {
+                return Err(PostError::Refused(
+                    "C-axis live-tool work on a rotated work offset is not supported yet - use an unrotated setup".into(),
+                ));
+            }
+            Record::Move(m) if m.abc.is_some() => {
+                return Err(PostError::Refused(
+                    "5-axis / rotary ABC moves inside a rotated work offset are not supported yet - use an unrotated setup".into(),
+                ));
+            }
+            Record::Move(m) if m.center.is_some() && !m.plane.is_xy() => {
+                return Err(PostError::Refused(
+                    "an XZ/YZ (G18/G19) arc inside a rotated work offset cannot rotate in XY".into(),
+                ));
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+fn check_control_capabilities(mch: &Value, s: &Script) -> Result<(), PostError> {
+    let mch_ok = mch.get("coordinateRotation").and_then(Value::as_bool) == Some(true);
+    if !mch_ok {
+        let model = mch.get("name").and_then(Value::as_str).unwrap_or("mounted machine");
+        return Err(PostError::Refused(format!(
+            "WcsRotation Control (G68 / ROT) requires controller.coordinate_rotation: true in '{model}' - choose Bake into XY or declare coordinate_rotation in the machine file"
+        )));
+    }
+    if !s.voices_wcs_rotation() {
+        return Err(PostError::Refused(
+            "WcsRotation Control (G68 / ROT) requires a post script declaring wcsRotation = true - choose Bake into XY or use Fanuc, Haas, Mazak, Doosan DNM, or Sinumerik".into(),
+        ));
+    }
+    let has_inverted = mch
+        .get("invertedAxes")
+        .and_then(Value::as_array)
+        .is_some_and(|a| !a.is_empty());
+    if has_inverted {
+        return Err(PostError::Refused(
+            "WcsRotation Control (G68 / ROT) is not supported with inverted machine axes - choose Bake into XY".into(),
+        ));
+    }
+    Ok(())
+}
+
+fn parse_mode(param_mode: Option<&Value>, options: &Value) -> Result<bool, PostError> {
+    let word = match param_mode {
+        Some(v) => v
+            .as_str()
+            .ok_or_else(|| PostError::Refused(format!("WcsRotationMode must be a string, got {v}")))?,
+        None => match options.get("WcsRotation") {
+            None | Some(Value::Null) => return Ok(false),
+            Some(v) => v
+                .as_str()
+                .ok_or_else(|| PostError::Refused(format!("WcsRotation option must be a string, got {v}")))?,
+        },
+    };
+    match word {
+        "bake" => Ok(false),
+        "control" => Ok(true),
+        other => Err(PostError::Refused(format!(
+            "unknown WCS rotation mode {other:?} - expected \"bake\" or \"control\""
+        ))),
+    }
+}
+
+/// Transform every Control-mode section carrying `PARAM WcsYaw` from Setup/Table
+/// coordinates into its rotated WCS XY frame about modal `OriginX`/`OriginY`
+/// (`p' = O + Rz(-yaw) * (p - O)`), keeping record count and indices intact
+/// for `viewer_map`. Bake mode checks safety and keeps Setup/Table coordinates
+/// untouched so a translation-only control drives the same physical table path.
+pub fn apply(mut records: Vec<Record>, mch: &Value, s: &Script, options: &Value) -> Result<Vec<Record>, PostError> {
+    let mut org_x = 0.0_f64;
+    let mut org_y = 0.0_f64;
+    let spans = chunk_bounds(&records);
+    for (start, end) in spans {
+        let chunk = &mut records[start..end];
+        let mut yaw_deg: Option<f64> = None;
+        let mut param_mode: Option<Value> = None;
+        let mut start_x: Option<f64> = None;
+        let mut start_y: Option<f64> = None;
+        let mut stock = [None::<f64>; 4];
+        for r in chunk.iter() {
+            if let Record::Param { name, value } = r {
+                match name.as_str() {
+                    "OriginX" => org_x = read_finite(value, "OriginX")?,
+                    "OriginY" => org_y = read_finite(value, "OriginY")?,
+                    "WcsYaw" => yaw_deg = Some(read_finite(value, "WcsYaw")?),
+                    "WcsRotationMode" => param_mode = Some(value.clone()),
+                    "StartX" => start_x = Some(read_finite(value, "StartX")?),
+                    "StartY" => start_y = Some(read_finite(value, "StartY")?),
+                    "StockXYLeft" => stock[0] = Some(read_finite(value, "StockXYLeft")?),
+                    "StockXYRight" => stock[1] = Some(read_finite(value, "StockXYRight")?),
+                    "StockXYFront" => stock[2] = Some(read_finite(value, "StockXYFront")?),
+                    "StockXYBack" => stock[3] = Some(read_finite(value, "StockXYBack")?),
+                    _ => {}
+                }
+            }
+        }
+        let Some(deg) = yaw_deg else {
+            continue;
+        };
+        let rad = deg.to_radians();
+        if rad.abs() <= TOL_RAD {
+            continue;
+        }
+        let control = parse_mode(param_mode.as_ref(), options)?;
+        check_section_supported(chunk)?;
+        if !control {
+            continue;
+        }
+        check_control_capabilities(mch, s)?;
+
+        let (s_y, c_y) = rad.sin_cos();
+        let rot_start = start_x.zip(start_y).map(|(x, y)| rotate_xy(x, y, org_x, org_y, s_y, c_y));
+        let rot_stock = match stock {
+            [Some(l), Some(r), Some(f), Some(b)] => {
+                let corners = [(l, f), (r, f), (r, b), (l, b)];
+                let (mut lx, mut rx, mut fy, mut by) = (f64::INFINITY, f64::NEG_INFINITY, f64::INFINITY, f64::NEG_INFINITY);
+                for (cx, cy) in corners {
+                    let (ux, uy) = rotate_xy(cx, cy, org_x, org_y, s_y, c_y);
+                    lx = lx.min(ux);
+                    rx = rx.max(ux);
+                    fy = fy.min(uy);
+                    by = by.max(uy);
+                }
+                Some([lx, rx, fy, by])
+            }
+            _ => None,
+        };
+
+        for r in chunk.iter_mut() {
+            match r {
+                Record::Param { name, value } => match name.as_str() {
+                    "StartX" if rot_start.is_some() => {
+                        if let Some((x, _)) = rot_start {
+                            *value = json!(x);
+                        }
+                    }
+                    "StartY" if rot_start.is_some() => {
+                        if let Some((_, y)) = rot_start {
+                            *value = json!(y);
+                        }
+                    }
+                    "StockXYLeft" if rot_stock.is_some() => {
+                        if let Some(st) = rot_stock {
+                            *value = json!(st[0]);
+                        }
+                    }
+                    "StockXYRight" if rot_stock.is_some() => {
+                        if let Some(st) = rot_stock {
+                            *value = json!(st[1]);
+                        }
+                    }
+                    "StockXYFront" if rot_stock.is_some() => {
+                        if let Some(st) = rot_stock {
+                            *value = json!(st[2]);
+                        }
+                    }
+                    "StockXYBack" if rot_stock.is_some() => {
+                        if let Some(st) = rot_stock {
+                            *value = json!(st[3]);
+                        }
+                    }
+                    _ => {}
+                },
+                Record::Move(m) => {
+                    let (nx, ny) = rotate_xy(m.x, m.y, org_x, org_y, s_y, c_y);
+                    m.x = nx;
+                    m.y = ny;
+                    if let Some((cx, cy)) = m.center {
+                        let (ncx, ncy) = rotate_xy(cx, cy, org_x, org_y, s_y, c_y);
+                        m.center = Some((ncx, ncy));
+                    }
+                }
+                Record::Cycle(c) => {
+                    let (nx, ny) = rotate_xy(c.x, c.y, org_x, org_y, s_y, c_y);
+                    c.x = nx;
+                    c.y = ny;
+                }
+                _ => {}
+            }
+        }
+    }
+    Ok(records)
+}
diff --git a/crates/post/tests/wcs_rotate.rs b/crates/post/tests/wcs_rotate.rs
new file mode 100644
index 000000000..581d4b552
--- /dev/null
+++ b/crates/post/tests/wcs_rotate.rs
@@ -0,0 +1,229 @@
+//! #760: post::wcs_rotate transforms XY coordinates/arcs/cycles about
+//! OriginX/Y into a Z-rotated WCS frame (Bake by default, G68/ROT in
+//! Control mode when both machine and script declare support) and refuses
+//! unverified cases by name.
+//!
+//! Provenance: RS-274 G68/G69 and DIN/ISO 840D ROT RPL coordinate rotation
+//! conventions; synthetic test streams are our own.
+//!
+//! Gate map (M4.4): covers post::wcs_rotate, post::engine, post::machine,
+//! assets/posts/{fanuc,haas,mazak,doosan-dnm,sinumerik}.cps.
+
+mod inverted_support;
+
+use camcraft_post::cl::{ArcPlane, CycleKind, MoveKind};
+use camcraft_post::machine::parse_mch;
+use camcraft_post::post::cnc::{self, CycleRec, MoveRec, Record};
+use camcraft_post::post::{engine, machine as post_machine, probe_rec};
+use inverted_support::{arc, cps, mv};
+use serde_json::{Value, json};
+
+fn mch_with_rotation(allow: Option<bool>) -> Value {
+    let mut raw: Value =
+        serde_json::from_str(include_str!("../../../assets/machines/3axis-vmc.mch")).expect("mch");
+    if let Some(yes) = allow
+        && let Some(obj) = raw.as_object_mut()
+    {
+        obj.insert("coordinateRotation".into(), json!(yes));
+    }
+    raw
+}
+
+fn rotated_square_stream(yaw_deg: f64, control_mode: bool) -> String {
+    let mut recs = vec![
+        Record::Param { name: "OperationName".into(), value: json!("RotTest") },
+        Record::Param { name: "SpindleSpeed".into(), value: json!(5000.0) },
+        Record::Param { name: "WorkOffset".into(), value: json!(1.0) },
+        Record::Param { name: "OriginX".into(), value: json!(10.0) },
+        Record::Param { name: "OriginY".into(), value: json!(5.0) },
+        Record::Param { name: "OriginZ".into(), value: json!(0.0) },
+        Record::Param { name: "ClearancePlane".into(), value: json!(25.0) },
+        Record::Param { name: "RetractPlane".into(), value: json!(15.0) },
+        Record::Param { name: "WcsYaw".into(), value: json!(yaw_deg) },
+    ];
+    if control_mode {
+        recs.push(Record::Param { name: "WcsRotationMode".into(), value: json!("control") });
+    }
+    recs.extend([
+        Record::Tool { number: 1, name: "EM".into() },
+        Record::Section { begin: true },
+        mv(MoveKind::Rapid, [10.0, 5.0, 25.0], None),
+        // Setup (10, 25) is +20 along Setup +Y from Origin (10, 5) => WCS (20, 0) under +90 deg yaw.
+        mv(MoveKind::Feed, [10.0, 25.0, -1.0], Some(600.0)),
+        Record::Section { begin: false },
+    ]);
+    cnc::serialize(&recs)
+}
+
+#[test]
+fn bake_keeps_setup_table_coordinates_without_g68() {
+    let mut recs = vec![
+        Record::Param { name: "OperationName".into(), value: json!("Bake") },
+        Record::Param { name: "SpindleSpeed".into(), value: json!(5000.0) },
+        Record::Param { name: "WorkOffset".into(), value: json!(1.0) },
+        Record::Param { name: "OriginX".into(), value: json!(10.0) },
+        Record::Param { name: "OriginY".into(), value: json!(5.0) },
+        Record::Param { name: "OriginZ".into(), value: json!(0.0) },
+        Record::Param { name: "ClearancePlane".into(), value: json!(25.0) },
+        Record::Param { name: "RetractPlane".into(), value: json!(15.0) },
+        Record::Param { name: "WcsYaw".into(), value: json!(90.0) },
+        Record::Tool { number: 1, name: "EM".into() },
+        Record::Section { begin: true },
+        mv(MoveKind::Rapid, [10.0, 15.0, 25.0], None), // Setup (10, 15) rel to Origin (10, 5) => table (0, 10)
+        mv(MoveKind::Feed, [10.0, 15.0, -1.0], Some(600.0)),
+        arc([0.0, 25.0, -1.0], (0.0, 15.0), true, ArcPlane::Xy), // center (0,15) rel (10,5) => I-10. J0.
+        Record::Section { begin: false },
+    ];
+    let stream = cnc::serialize(&recs);
+    let out = engine::run(&cps("fanuc"), &mch_with_rotation(None), &stream).expect("posts");
+    assert!(out.warnings.is_empty(), "{:?}", out.warnings);
+    assert!(
+        out.program.contains("X0. Y10."),
+        "Bake emits table coordinates rel to Origin without G68:\n{}",
+        out.program
+    );
+    assert!(
+        out.program.contains("G03 X-10. Y20. Z-1. I-10. J0."),
+        "Bake keeps Setup table arc coordinates directly:\n{}",
+        out.program
+    );
+    assert!(!out.program.contains("G68"), "Bake writes no G68:\n{}", out.program);
+
+    recs.pop();
+    recs.push(Record::Cycle(CycleRec {
+        kind: CycleKind::Drill,
+        x: 30.0,
+        y: 5.0, // rel Origin (10, 5) => table (20, 0)
+        r_z: 2.0,
+        bottom_z: -5.0,
+        entry_z: 5.0,
+        peck: 0.0,
+        dwell: 0.0,
+        first_move: 0,
+        feed: Some(300.0),
+    }));
+    let cyc_stream = cnc::serialize(&recs);
+    let cyc_out = engine::run(&cps("fanuc"), &mch_with_rotation(None), &cyc_stream).expect("posts");
+    assert!(
+        cyc_out.program.contains("G81") && cyc_out.program.contains("X20. Y0."),
+        "Bake drilled hole uses table coords:\n{}",
+        cyc_out.program
+    );
+
+    // Switching the exact same arc + cycle stream to Control emits G68 R90. + WCS coords (X10 Y0 / G03 X20 Y10 I0 J10 / X0 Y-20).
+    let opts = json!({ "WcsRotation": "control" });
+    let ctl_out = engine::run_with(&cps("fanuc"), &mch_with_rotation(Some(true)), &cyc_stream, &opts).expect("Control posts");
+    assert!(ctl_out.program.contains("G68 X0. Y0. R90."), "{}", ctl_out.program);
+    assert!(ctl_out.program.contains("G03 X20. Y10. Z-1. I0. J10."), "{}", ctl_out.program);
+    assert!(ctl_out.program.contains("X0. Y-20."), "{}", ctl_out.program);
+}
+
+#[test]
+fn control_mode_emits_g68_or_rot_only_when_machine_and_post_declare_it() {
+    let stream = rotated_square_stream(30.0, true);
+    let opts = json!({ "WcsRotation": "control" });
+    let no_cap_err = engine::run_with(&cps("fanuc"), &mch_with_rotation(None), &stream, &opts)
+        .expect_err("machine without coordinateRotation must refuse Control mode");
+    assert!(
+        no_cap_err.to_string().contains("coordinate"),
+        "expected named refusal for missing machine capability, got: {no_cap_err}"
+    );
+
+    let unsupported_post_err =
+        engine::run_with(&cps("grblhal"), &mch_with_rotation(Some(true)), &stream, &opts)
+            .expect_err("post without wcsRotation must refuse Control mode");
+    assert!(
+        unsupported_post_err.to_string().contains("wcsRotation")
+            || unsupported_post_err.to_string().contains("rotation"),
+        "expected named refusal for unsupported post, got: {unsupported_post_err}"
+    );
+
+    for stem in ["fanuc", "haas", "mazak", "doosan-dnm"] {
+        let out = engine::run_with(&cps(stem), &mch_with_rotation(Some(true)), &stream, &opts)
+            .unwrap_or_else(|e| panic!("{stem}: {e}"));
+        assert!(out.warnings.is_empty(), "{stem}: {:?}", out.warnings);
+        assert!(out.program.contains("G68 X0. Y0. R30."), "{stem}:\n{}", out.program);
+        assert!(out.program.contains("G69"), "{stem}:\n{}", out.program);
+        assert!(out.program.contains("X10. Y17.321"), "{stem}:\n{}", out.program);
+    }
+
+    let sinu = engine::run_with(&cps("sinumerik"), &mch_with_rotation(Some(true)), &stream, &opts)
+        .expect("sinumerik posts");
+    assert!(sinu.warnings.is_empty(), "{:?}", sinu.warnings);
+    assert!(sinu.program.contains("ROT RPL=30"), "sinumerik:\n{}", sinu.program);
+    assert!(sinu.program.contains("X10 Y17.321"), "sinumerik:\n{}", sinu.program);
+    // ROT cancel block must appear before spindle stop / M30 / end.
+    assert!(
+        sinu.program.lines().any(|l| l.ends_with(" ROT")),
+        "sinumerik must cancel with bare ROT:\n{}",
+        sinu.program
+    );
+}
