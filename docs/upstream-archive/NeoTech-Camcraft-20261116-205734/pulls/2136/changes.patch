+    assert!((dtp.path.cycles[0].xy.y - center.y).abs() < 1e-4, "{:?}", dtp.path.cycles[0]);
+    let path = tmp_nc("multi");
+    let posted = posting::post_setup(&world, &path).expect("multi-op Bake post succeeds");
+    let _ = fs::remove_file(&path);
