From d0fe7738139677dd497e5843a3e5365edeb54f68 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Mon, 16 Nov 2026 15:36:20 +0100
Subject: [PATCH] fix(ui): keep an Auto input manual while the user types a
 value that reads as 0

The shared auto_value widget read Auto from "value == 0". Typing "0",
"0." or "0.5" passes through 0, so the toggle flipped back to Auto and the
typed text was lost. The widget now holds the manual state while the edit
field has focus.

Fixes #2178

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 crates/ui/src/egui_app/layout/form.rs         | 18 +++-
 crates/ui/src/egui_app/tests.rs               |  1 +
 .../src/egui_app/tests/auto_input_manual.rs   | 99 +++++++++++++++++++
 3 files changed, 116 insertions(+), 2 deletions(-)
 create mode 100644 crates/ui/src/egui_app/tests/auto_input_manual.rs

diff --git a/crates/ui/src/egui_app/layout/form.rs b/crates/ui/src/egui_app/layout/form.rs
index 3fe6f01a3..ebcb38be0 100644
--- a/crates/ui/src/egui_app/layout/form.rs
+++ b/crates/ui/src/egui_app/layout/form.rs
@@ -221,14 +221,28 @@ pub fn auto_value(
 ) -> bool {
     let before = *v;
     prop_row(ui, label, |ui| {
-        let mut auto = *v == 0.0;
-        if ui.checkbox(&mut auto, toggle).changed() {
+        // The model's 0 is the Auto sentinel, and the keys "0", "0." and
+        // "0.5" all read as 0 on the way to a value (#2178). While the
+        // user types in the edit field, a 0 therefore stays manual: the
+        // hold lasts until the field loses focus.
+        let hold = ui.make_persistent_id(("camcraft.auto_value_hold", label));
+        let held: bool = ui.data(|d| d.get_temp(hold)).unwrap_or(false);
+        let mut auto = *v == 0.0 && !held;
+        let toggle_resp = ui.checkbox(&mut auto, toggle);
+        if toggle_resp.changed() {
             *v = if auto { 0.0 } else { seed };
+            ui.data_mut(|d| d.remove_temp::<bool>(hold));
         }
         if auto {
             ui.add_enabled(false, Label::new(RichText::new(derived).weak()));
         } else {
             edit(ui, v);
+            let editing = ui.memory(|m| m.focused()).is_some_and(|f| f != toggle_resp.id);
+            if editing {
+                ui.data_mut(|d| d.insert_temp(hold, true));
+            } else {
+                ui.data_mut(|d| d.remove_temp::<bool>(hold));
+            }
         }
     });
     *v != before
diff --git a/crates/ui/src/egui_app/tests.rs b/crates/ui/src/egui_app/tests.rs
index b9778e258..e9ac8cedf 100644
--- a/crates/ui/src/egui_app/tests.rs
+++ b/crates/ui/src/egui_app/tests.rs
@@ -112,6 +112,7 @@ mod waterjet_recipe;
 mod catalog_filters;
 mod cycle_combo;
 mod radial_step_field;
+mod auto_input_manual;
 // #1509: 2D Adaptive's Method choice on the Passes tab.
 mod adaptive_method;
 // #661: every operation kind wears its own SVG-mastered glyph.
diff --git a/crates/ui/src/egui_app/tests/auto_input_manual.rs b/crates/ui/src/egui_app/tests/auto_input_manual.rs
new file mode 100644
index 000000000..0f5cd9297
--- /dev/null
+++ b/crates/ui/src/egui_app/tests/auto_input_manual.rs
@@ -0,0 +1,99 @@
+//! #2178: an `Auto` input stays manual while the user types a value whose
+//! first keys read as 0 ("0", "0.", "0.5"). The model's 0 is the Auto
+//! sentinel, so the toggle must not read it back from the value mid-edit.
+//! Provenance: our own page law; asserted structurally (no pixels).
+
+use super::super::dialog_tests::{opened, page};
+use super::*;
+use camcraft_app::machining2d::PocketStrategy;
+use camcraft_app::machining3d::Entry3D;
+use camcraft_app::operation::Height;
+use egui::accesskit::Role;
+
+fn helix_pocket() -> OpParams {
+    OpParams::Pocket {
+        rest: None,
+        blend_radius: None,
+        links: camcraft_app::links::Links::PLANAR,
+        tilt: None,
+        stepover: 1.0,
+        stock_to_leave: 0.0,
+        clearance_z: Height::fixed(25.0),
+        retract_z: None,
+        top_z: Height::fixed(12.0),
+        bottom_z: Height::fixed(9.0),
+        stepdown: 1.0,
+        feed: 800.0,
+        plunge_feed: 200.0,
+        climb: true,
+        strategy: PocketStrategy::Zigzag,
+        entry: Entry3D::Helix,
+        helix_radius: 1.0,
+        optimal_load: camcraft_app::load::DEFAULT_OPTIMAL_LOAD,
+        blend_turns: false,
+    }
+}
+
+fn pitch(h: &Harness<'static, State>) -> f64 {
+    match &h.state().op_ui.params {
+        OpParams::Pocket { links, .. } => links.approach.helix_pitch,
+        _ => f64::NAN,
+    }
+}
+
+fn row_node<'a>(h: &'a Harness<'static, State>, label: &str, role: Role) -> egui_kittest::Node<'a> {
+    let lab = h.get_by_label(label).rect();
+    h.query_all_by(move |n| n.role() == role)
+        .find(|n| {
+            let c = n.rect().center().y;
+            c >= lab.top() - 2.0 && c <= lab.bottom() + 2.0
+        })
+        .expect("a control on the label's row")
+}
+
+#[test]
+fn typing_over_an_auto_off_input_keeps_it_manual() {
+    let mut state = opened(helix_pocket());
+    state.op_tab = super::super::op_tabs::SEC_LEADS;
+    let mut h = page(state);
+    h.run();
+    // Auto is on (0). Turn it off: the seed 1.0 appears as a number field.
+    row_node(&h, "Helix pitch", Role::CheckBox).click();
+    h.run();
+    assert_eq!(pitch(&h), 1.0, "Auto off seeds a value");
+    row_node(&h, "Helix pitch", Role::SpinButton).click();
+    h.run();
+    // Replace the text with "0.5" one key at a time, a frame each.
+    for ch in ["0", ".", "5"] {
+        row_node(&h, "Helix pitch", Role::SpinButton).type_text(ch);
+        h.run();
+        h.run();
+        assert!(
+            h.query_by_label("1 turn / helix Ø").is_none(),
+            "Auto must stay off after typing {ch:?}"
+        );
+        assert!(
+            h.query_all_by(|n| n.role() == Role::SpinButton).count() > 0,
+            "the number field stays after typing {ch:?}"
+        );
+    }
+    assert!((pitch(&h) - 0.5).abs() < 1e-9, "the draft holds the typed 0.5 ({})", pitch(&h));
+    // Apply commits it through the command history; one undo restores Auto (0).
+    h.get_by_label("Apply").click();
+    h.run();
+    h.state_mut().drain_actions();
+    assert!((live_pitch(h.state()) - 0.5).abs() < 1e-9, "Apply wrote the manual value");
+    let st = h.state_mut();
+    st.history.undo(&st.world);
+    assert_eq!(live_pitch(h.state()), 0.0, "one undo step restores Auto");
+}
+
+fn live_pitch(state: &State) -> f64 {
+    model::find_by_name(&state.world, "Op")
+        .and_then(|e| model::operation_of(&state.world, &e))
+        .map(|o| match o.params {
+            OpParams::Pocket { links, .. } => links.approach.helix_pitch,
+            _ => f64::NAN,
+        })
+        .unwrap_or(f64::NAN)
+}
