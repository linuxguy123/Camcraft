diff --git a/crates/ui/src/egui_app/tests/file_drop.rs b/crates/ui/src/egui_app/tests/file_drop.rs
index ec007d9de..8365b92d9 100644
--- a/crates/ui/src/egui_app/tests/file_drop.rs
+++ b/crates/ui/src/egui_app/tests/file_drop.rs
@@ -93,3 +93,133 @@ fn several_files_at_once_are_refused_and_change_nothing() {
     assert!(h.state().state.status.contains("2 files were dropped"), "{}", h.state().state.status);
