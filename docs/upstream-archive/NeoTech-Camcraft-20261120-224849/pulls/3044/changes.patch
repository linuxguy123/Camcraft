diff --git a/crates/app/tests/example_catalog/contract.rs b/crates/app/tests/example_catalog/contract.rs
index a2e517b38..6569745dc 100644
--- a/crates/app/tests/example_catalog/contract.rs
+++ b/crates/app/tests/example_catalog/contract.rs
@@ -38,8 +38,15 @@ fn two_broken_cases_report_both_names_and_times() {
             format!("catalog_2d_first_part::{action}"),
             format!("catalog_2d_contour_tabs::{action}"),
         ];
+        // One test thread (#3043): the two cases run in order, so the panic
+        // message of one case cannot fall into the timing line of the other.
         let output = Command::new(std::env::current_exe().expect("test executable"))
-            .args([names[0].as_str(), names[1].as_str(), "--nocapture"])
+            .args([
+                names[0].as_str(),
+                names[1].as_str(),
+                "--nocapture",
+                "--test-threads=1",
+            ])
             .env("CAMCRAFT_TEST_CATALOG_ROOT", &scratch)
             .output()
             .expect("run two broken cases");
diff --git a/crates/app/tests/example_catalog/support.rs b/crates/app/tests/example_catalog/support.rs
index 650cc8c64..b24403641 100644
--- a/crates/app/tests/example_catalog/support.rs
+++ b/crates/app/tests/example_catalog/support.rs
@@ -286,12 +286,11 @@ pub(super) fn within(label: &str, budget: std::time::Duration, f: impl FnOnce()
     });
     let result = rx.recv_timeout(budget.saturating_sub(start.elapsed()));
     // Direct stderr keeps successful timings visible with libtest capture on.
-    let _ = writeln!(
-        std::io::stderr(),
-        "catalog {label} elapsed={:.3}s budget={:.3}s",
-        start.elapsed().as_secs_f64(),
-        budget.as_secs_f64()
-    );
+    // One write for the whole line (#3043): stderr has no buffer, so a
+    // formatted write goes out in pieces, and the panic message of a parallel
+    // case thread can split the line between those pieces.
+    let line = timing_line(label, start.elapsed(), budget);
+    let _ = std::io::stderr().lock().write_all(line.as_bytes());
     match result {
         Ok(Ok(())) => {}
         Ok(Err(payload)) => resume_unwind(payload),
@@ -299,6 +298,19 @@ pub(super) fn within(label: &str, budget: std::time::Duration, f: impl FnOnce()
     }
 }
 
+// The full timing line of one case, with its newline, for one stderr write.
+fn timing_line(
+    label: &str,
+    elapsed: std::time::Duration,
+    budget: std::time::Duration,
+) -> String {
+    format!(
+        "catalog {label} elapsed={:.3}s budget={:.3}s\n",
+        elapsed.as_secs_f64(),
+        budget.as_secs_f64()
+    )
+}
+
 pub(super) fn run_case(family: &str, name: &str, action: &str, run: fn(&CatalogCase)) {
     let root = std::env::var_os("CAMCRAFT_TEST_CATALOG_ROOT")
         .map(PathBuf::from)
@@ -339,3 +351,17 @@ fn a_case_over_its_budget_fails_by_name() {
     );
     assert!(message.contains("app heavy: example_catalog"), "{message}");
 }
+
+#[test]
+fn timing_line_is_one_whole_line() {
+    let line = timing_line(
+        "2d/first-part regenerates",
+        std::time::Duration::from_millis(1234),
+        std::time::Duration::from_secs(60),
+    );
+    assert_eq!(
+        line,
+        "catalog 2d/first-part regenerates elapsed=1.234s budget=60.000s\n"
+    );
+    assert_eq!(line.matches('\n').count(), 1, "{line:?}");
+}
