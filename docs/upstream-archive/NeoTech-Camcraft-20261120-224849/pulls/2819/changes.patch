+//! Provenance: the glyph table of our own single-line engraving font (issue 2679). Each glyph
+//! was drawn from scratch for this project on a 4 x 6 grid, with straight strokes and cut
+//! corners. No font file, no vendor letter shape and no other stroke font was consulted.
+//!
+//! Drawing rules, which keep each stroke a clean chain (`sketch_chains`: a chain cannot branch):
+//! - An end of a stroke meets a different stroke only inside one of its segments, never at a
+//!   corner or an end. Where three lines would meet at a corner, one line runs through.
+//! - Only a closed stroke repeats its first point as its last point.
+//! - The cap height is `CAP` units, the baseline is y = 0, and x starts at 0.
+
+/// A point in font units.
+pub(super) type P = (f64, f64);
+
+pub(super) struct Glyph {
+    pub ch: char,
+    /// The advance width in font units, without the gap to the next glyph.
+    pub width: f64,
+    pub strokes: &'static [&'static [P]],
+}
+
+/// The cap height in font units.
+pub(super) const CAP: f64 = 6.0;
+/// The gap between two glyphs in font units.
+pub(super) const GAP: f64 = 2.0;
+
+/// The closed eight-corner ring that O, Q and 0 share.
+const RING: &[P] = &[(1., 0.), (3., 0.), (4., 1.), (4., 5.), (3., 6.), (1., 6.), (0., 5.), (0., 1.), (1., 0.)];
+/// The bowl and stem that P and R share; the bowl ends inside the stem.
+const P_STROKE: &[P] = &[(0., 0.), (0., 6.), (3., 6.), (4., 5.), (4., 4.), (3., 3.), (0., 3.)];
+
+const fn g(ch: char, width: f64, strokes: &'static [&'static [P]]) -> Glyph {
+    Glyph { ch, width, strokes }
+}
+
+pub(super) const GLYPHS: &[Glyph] = &[
+    g(' ', 3., &[]),
+    g('A', 4., &[&[(0., 0.), (2., 6.), (4., 0.)], &[(1., 3.), (3., 3.)]]),
+    // The bar runs past the waist, so the lower bowl ends inside it.
+    g('B', 4., &[&[(0., 3.), (3.5, 3.), (4., 3.5), (4., 5.), (3., 6.), (0., 6.), (0., 0.), (3., 0.), (4., 1.), (4., 2.), (3., 3.)]]),
+    g('C', 4., &[&[(4., 1.), (3., 0.), (1., 0.), (0., 1.), (0., 5.), (1., 6.), (3., 6.), (4., 5.)]]),
+    g('D', 4., &[&[(0., 0.), (0., 6.), (3., 6.), (4., 5.), (4., 1.), (3., 0.), (0., 0.)]]),
+    g('E', 4., &[&[(4., 6.), (0., 6.), (0., 0.), (4., 0.)], &[(0., 3.), (3., 3.)]]),
+    g('F', 4., &[&[(4., 6.), (0., 6.), (0., 0.)], &[(0., 3.), (3., 3.)]]),
+    g('G', 4., &[&[(4., 5.), (3., 6.), (1., 6.), (0., 5.), (0., 1.), (1., 0.), (3., 0.), (4., 1.), (4., 3.), (2., 3.)]]),
+    g('H', 4., &[&[(0., 0.), (0., 6.)], &[(4., 0.), (4., 6.)], &[(0., 3.), (4., 3.)]]),
+    g('I', 2., &[&[(1., 0.), (1., 6.)]]),
+    g('J', 4., &[&[(0., 1.), (1., 0.), (3., 0.), (4., 1.), (4., 6.)]]),
+    g('K', 4., &[&[(0., 0.), (0., 6.)], &[(4., 6.), (0., 3.), (4., 0.)]]),
+    g('L', 4., &[&[(0., 6.), (0., 0.), (4., 0.)]]),
+    g('M', 4., &[&[(0., 0.), (0., 6.), (2., 2.), (4., 6.), (4., 0.)]]),
+    g('N', 4., &[&[(0., 0.), (0., 6.), (4., 0.), (4., 6.)]]),
+    g('O', 4., &[RING]),
+    g('P', 4., &[P_STROKE]),
+    g('Q', 4., &[RING, &[(2.5, 1.5), (4., 0.)]]),
+    g('R', 4., &[P_STROKE, &[(2., 3.), (4., 0.)]]),
+    g('S', 4., &[&[(4., 5.), (3., 6.), (1., 6.), (0., 5.), (0., 4.), (1., 3.), (3., 3.), (4., 2.), (4., 1.), (3., 0.), (1., 0.), (0., 1.)]]),
+    g('T', 4., &[&[(0., 6.), (4., 6.)], &[(2., 6.), (2., 0.)]]),
+    g('U', 4., &[&[(0., 6.), (0., 1.), (1., 0.), (3., 0.), (4., 1.), (4., 6.)]]),
+    g('V', 4., &[&[(0., 6.), (2., 0.), (4., 6.)]]),
+    g('W', 4., &[&[(0., 6.), (1., 0.), (2., 4.), (3., 0.), (4., 6.)]]),
+    g('X', 4., &[&[(0., 0.), (4., 6.)], &[(0., 6.), (4., 0.)]]),
+    // The arms meet on a short flat, so the stem ends inside it.
+    g('Y', 4., &[&[(0., 6.), (1.5, 3.), (2.5, 3.), (4., 6.)], &[(2., 3.), (2., 0.)]]),
+    g('Z', 4., &[&[(0., 6.), (4., 6.), (0., 0.), (4., 0.)]]),
+    // A slashed zero, so a part number does not confuse 0 and O.
+    g('0', 4., &[RING, &[(1., 1.5), (3., 4.5)]]),
+    g('1', 4., &[&[(1., 5.), (2., 6.), (2., 0.)], &[(1., 0.), (3., 0.)]]),
+    g('2', 4., &[&[(0., 5.), (1., 6.), (3., 6.), (4., 5.), (4., 4.), (0., 0.), (4., 0.)]]),
+    // The upper bowl ends in a bar, and the lower bowl starts inside that bar.
+    g('3', 4., &[&[(0., 5.), (1., 6.), (3., 6.), (4., 5.), (4., 3.5), (3.5, 3.), (1.5, 3.)], &[(3., 3.), (4., 2.), (4., 1.), (3., 0.), (1., 0.), (0., 1.)]]),
+    g('4', 4., &[&[(3., 0.), (3., 6.), (0., 2.), (4., 2.)]]),
+    g('5', 4., &[&[(4., 6.), (0., 6.), (0., 3.5), (3., 3.5), (4., 2.5), (4., 1.), (3., 0.), (1., 0.), (0., 1.)]]),
+    g('6', 4., &[&[(4., 5.), (3., 6.), (1., 6.), (0., 5.), (0., 1.), (1., 0.), (3., 0.), (4., 1.), (4., 2.5), (3., 3.5), (1., 3.5), (0., 2.5)]]),
+    g('7', 4., &[&[(0., 6.), (4., 6.), (1.5, 0.)]]),
+    // A closed lower loop; the upper bowl starts and ends inside the top side of that loop.
+    g('8', 4., &[&[(1., 0.), (3., 0.), (4., 1.), (4., 2.), (3., 3.), (1., 3.), (0., 2.), (0., 1.), (1., 0.)], &[(1.5, 3.), (0.5, 4.), (0.5, 5.), (1.5, 6.), (2.5, 6.), (3.5, 5.), (3.5, 4.), (2.5, 3.)]]),
+    g('9', 4., &[&[(0., 1.), (1., 0.), (3., 0.), (4., 1.), (4., 5.), (3., 6.), (1., 6.), (0., 5.), (0., 3.5), (1., 2.5), (3., 2.5), (4., 3.5)]]),
+    g('-', 4., &[&[(0.5, 3.), (3.5, 3.)]]),
+    g('_', 4., &[&[(0., 0.), (4., 0.)]]),
+    g('.', 1., &[&[(0.5, 0.), (0.5, 0.5)]]),
+    g(':', 1., &[&[(0.5, 1.), (0.5, 1.5)], &[(0.5, 4.), (0.5, 4.5)]]),
+    g('/', 4., &[&[(0., 0.), (4., 6.)]]),
+    g('#', 4., &[&[(1., 0.), (1., 6.)], &[(3., 0.), (3., 6.)], &[(0., 2.), (4., 2.)], &[(0., 4.), (4., 4.)]]),
+    g('+', 4., &[&[(0.5, 3.), (3.5, 3.)], &[(2., 1.5), (2., 4.5)]]),
+    g('=', 4., &[&[(0.5, 2.), (3.5, 2.)], &[(0.5, 4.), (3.5, 4.)]]),
+    g('(', 2., &[&[(1.5, 6.), (0.5, 5.), (0.5, 1.), (1.5, 0.)]]),
+    g(')', 2., &[&[(0.5, 6.), (1.5, 5.), (1.5, 1.), (0.5, 0.)]]),
+];
