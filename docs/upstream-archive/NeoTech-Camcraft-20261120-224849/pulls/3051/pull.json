  "locked": false,
  "title": "fix(chamfer): take a wall's lean from the frame, not from the sections",
  "user": {
    "login": "mkinney",
    "id": 2219838,
    "node_id": "MDQ6VXNlcjIyMTk4Mzg=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2219838?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/mkinney",
