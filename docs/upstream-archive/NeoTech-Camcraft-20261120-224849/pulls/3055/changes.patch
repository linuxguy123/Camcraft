From 009623a593093aa826a941aad0f15ee8d21d8f84 Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Fri, 20 Nov 2026 18:59:30 +0000
Subject: [PATCH] fix(post): a symlinked executable finds the assets beside the
 real file

DataFiles::from_process now resolves a symbolic link of the executable
path (real_exe) before the assets lookup. On macOS and Windows,
current_exe gives the link path, so a camcraft-cli on the PATH through a
link looked for assets/posts beside the link and could not post. Only a
link is resolved: a plain path keeps its form (no \\?\ prefix on
Windows).

The refusal of a copy of the executable now ends with COPY_HINT: start
the program from its install folder, or through a symbolic link.

Pinned by data_dir::tests::a_symlinked_exe_finds_the_assets_beside_the_real_file
and data_dir::tests::a_copied_exe_is_refused_with_the_fix.

Fixes #3028

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/post/src/data_dir.rs              | 36 +++++++++++++--
 crates/post/src/data_dir_tests.rs        | 56 ++++++++++++++++++++++++
 docs/decisions/3028-symlink-exe-posts.md | 42 ++++++++++++++++++
 3 files changed, 130 insertions(+), 4 deletions(-)
 create mode 100644 docs/decisions/3028-symlink-exe-posts.md

diff --git a/crates/post/src/data_dir.rs b/crates/post/src/data_dir.rs
index 69f98ff86..4697ff59a 100644
--- a/crates/post/src/data_dir.rs
+++ b/crates/post/src/data_dir.rs
@@ -15,6 +15,11 @@
 //! 4. `<this crate>/../../assets/<kind>` - the source tree, for the test
 //!    binaries in `target/*/deps/` (a path, not a compiled-in copy).
 //!
+//! The exe path is the real file: a symbolic link to the exe (a
+//! `camcraft-cli` on the PATH, the usual macOS set-up) is resolved first,
+//! so the walk starts in the install folder, not in the link's folder
+//! (#3028). A copy of the exe is not a link and finds nothing.
+//!
 //! Candidates 3 and 4 apply only when the exe is in a cargo build tree
 //! of the old or the new cargo build-dir layout ([`cargo_profile_dir`]).
 //! An installed exe without its `assets/<kind>` folder
@@ -100,11 +105,33 @@ pub fn resolve(kind: &str, exe: Option<&Path>, manifest: Option<&Path>, is_dir:
     }
     let looked: Vec<String> = all.iter().map(|p| p.display().to_string()).collect();
     Err(format!(
-        "no {kind} folder found - the program needs its assets/{kind} directory beside the executable (looked in: {})",
+        "no {kind} folder found - the program needs its assets/{kind} directory beside the executable (looked in: {}). {COPY_HINT}",
         if looked.is_empty() { "nowhere: no executable path".to_owned() } else { looked.join(", ") }
     ))
 }
 
+/// The fix that the refusal names (#3028). No setting or environment
+/// variable points at an assets folder: a copy of the exe does not take
+/// its assets with it.
+pub const COPY_HINT: &str = "Start the program from its install folder, or through a symbolic link to the \
+     installed executable: a copy of the executable has no assets beside it.";
+
+/// The real file of `exe` (#3028). A symbolic link is resolved, so the
+/// lookup starts beside the installed exe and not beside the link.
+/// `current_exe` gives the link path on macOS and Windows; Linux reads
+/// `/proc/self/exe`, which is already the real file. Only a link is
+/// resolved: a plain path stays as it is (on Windows `canonicalize` would
+/// add the `\\?\` prefix to each message). A link that does not resolve
+/// stays the link path, and the refusal names its folder.
+#[must_use]
+pub fn real_exe(exe: PathBuf) -> PathBuf {
+    let is_link = std::fs::symlink_metadata(&exe).is_ok_and(|m| m.file_type().is_symlink());
+    if !is_link {
+        return exe;
+    }
+    std::fs::canonicalize(&exe).unwrap_or(exe)
+}
+
 /// One kind's directory and its read cache. A file is read once; later
 /// calls (and failures) come from the cache, so no caller reads per frame.
 #[derive(Debug)]
@@ -120,11 +147,12 @@ impl DataFiles {
         Self { dir, cache: Mutex::new(HashMap::new()) }
     }
 
-    /// [`resolve`] wired to the running process: the real exe path, and
-    /// this crate's source tree as the last resort of a cargo build tree.
+    /// [`resolve`] wired to the running process: the real exe path (a
+    /// link resolved, [`real_exe`]), and this crate's source tree as the
+    /// last resort of a cargo build tree.
     #[must_use]
     pub fn from_process(kind: &str) -> Self {
-        let exe = std::env::current_exe().ok();
+        let exe = std::env::current_exe().ok().map(real_exe);
         let manifest = Path::new(env!("CARGO_MANIFEST_DIR"));
         Self::new(resolve(kind, exe.as_deref(), Some(manifest), Path::is_dir))
     }
diff --git a/crates/post/src/data_dir_tests.rs b/crates/post/src/data_dir_tests.rs
index a67b8685a..958c55a69 100644
--- a/crates/post/src/data_dir_tests.rs
+++ b/crates/post/src/data_dir_tests.rs
@@ -168,3 +168,59 @@ fn a_file_over_the_size_cap_is_refused_by_name() {
     assert!(why.starts_with("over.cps in ") && why.contains("byte limit - refused"), "{why}");
     let _ = std::fs::remove_dir_all(dir);
 }
+
+/// #3028: an install folder with the exe and `assets/posts`, and a
+/// `bin` folder beside it, for the link and the copy.
+fn install_tree(tag: &str) -> (PathBuf, PathBuf, PathBuf) {
+    let root = scratch(tag);
+    let install = root.join("install");
+    std::fs::create_dir_all(install.join("assets").join("posts")).expect("assets/posts");
+    let exe = install.join("camcraft-cli");
+    std::fs::write(&exe, b"exe").expect("exe file");
+    let bin = root.join("bin");
+    std::fs::create_dir_all(&bin).expect("bin dir");
+    (root, exe, bin)
+}
+
+/// #3028: `camcraft-cli` on the PATH through a symbolic link finds the
+/// posts beside the real file, not beside the link.
+#[cfg(unix)]
+#[test]
+fn a_symlinked_exe_finds_the_assets_beside_the_real_file() {
+    let (root, exe, bin) = install_tree("symlink");
+    let link = bin.join("camcraft-cli");
+    std::os::unix::fs::symlink(&exe, &link).expect("symlink");
+    let real = real_exe(link.clone());
+    assert_eq!(real, std::fs::canonicalize(&exe).expect("real exe"), "the link resolves to the installed file");
+    let want = std::fs::canonicalize(exe.with_file_name("assets").join("posts")).expect("assets/posts");
+    assert_eq!(resolve("posts", Some(&real), None, Path::is_dir), Ok(want));
+    // Before the fix: the link path itself looks only beside the link.
+    let why = resolve("posts", Some(&link), None, Path::is_dir).expect_err("nothing beside the link");
+    assert!(why.contains(&bin.join("assets").join("posts").display().to_string()), "{why}");
+    // A chain of links resolves to the end.
+    let link2 = root.join("camcraft-cli-2");
+    std::os::unix::fs::symlink(&link, &link2).expect("second symlink");
+    assert_eq!(real_exe(link2), real);
+    // A link that does not resolve stays the link path: the refusal names its folder.
+    let dangling = bin.join("gone");
+    std::os::unix::fs::symlink(root.join("no-such-exe"), &dangling).expect("dangling symlink");
+    assert_eq!(real_exe(dangling.clone()), dangling);
+    let _ = std::fs::remove_dir_all(root);
+}
+
+/// #3028: a plain copy of the exe is not a link, finds no assets, and the
+/// refusal says how to start the program instead.
+#[test]
+fn a_copied_exe_is_refused_with_the_fix() {
+    let (root, exe, bin) = install_tree("copy");
+    let copy = bin.join("camcraft-cli");
+    std::fs::copy(&exe, &copy).expect("copy exe");
+    assert_eq!(real_exe(copy.clone()), copy, "a plain file stays as it is");
+    assert_eq!(real_exe(exe.clone()), exe, "the installed file stays as it is");
+    let why = resolve("posts", Some(&copy), None, Path::is_dir).expect_err("no assets beside the copy");
+    assert!(why.starts_with("no posts folder found"), "{why}");
+    assert!(why.contains(&bin.join("assets").join("posts").display().to_string()), "{why}");
+    assert!(why.ends_with(COPY_HINT), "{why}");
+    assert!(COPY_HINT.contains("install folder") && COPY_HINT.contains("symbolic link"), "{COPY_HINT}");
+    let _ = std::fs::remove_dir_all(root);
+}
