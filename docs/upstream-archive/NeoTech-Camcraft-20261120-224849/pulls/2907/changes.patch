From 3c10ae6af0f26dde1179ba51affa6dc6d0fc2b40 Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Fri, 20 Nov 2026 00:13:55 -0800
Subject: [PATCH] test: give the corner_relief app suites their Gate map lines

The three suites PR #2833 added had no Gate map, so
gate_maps_tests::no_gate_map_names_a_moved_module_as_app failed on main
and the quick tier could not select them.

Fixes #2905

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/tests/corner_relief.rs               | 2 ++
 crates/app/tests/corner_relief_safety.rs        | 2 ++
 crates/app/tests/corner_relief_serialization.rs | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/crates/app/tests/corner_relief.rs b/crates/app/tests/corner_relief.rs
index f5f046c1f..c9ce304b5 100644
--- a/crates/app/tests/corner_relief.rs
+++ b/crates/app/tests/corner_relief.rs
@@ -1,4 +1,6 @@
 //! Provenance: independent corner-relief cutting, simulation and golden CL tests.
+//! Gate map (#2400): covers app::operation::corner_relief, app::operation::corner_relief_sim,
+//! app::commands (CreateOperation, GenerateOperation with corner relief).
 
 mod common;
 mod corner_relief_support;
diff --git a/crates/app/tests/corner_relief_safety.rs b/crates/app/tests/corner_relief_safety.rs
index 04b159b2f..ae4c785f6 100644
--- a/crates/app/tests/corner_relief_safety.rs
+++ b/crates/app/tests/corner_relief_safety.rs
@@ -1,4 +1,6 @@
 //! Provenance: independent corner-relief reachability and boundary refusal tests.
+//! Gate map (#2400): covers app::operation::corner_relief (reachability and boundary refusals),
+//! app::commands (CreateOperation, ImportModel).
 
 mod corner_relief_support;
 mod pocket_support;
diff --git a/crates/app/tests/corner_relief_serialization.rs b/crates/app/tests/corner_relief_serialization.rs
index 8376c1da4..8b1f87a79 100644
--- a/crates/app/tests/corner_relief_serialization.rs
+++ b/crates/app/tests/corner_relief_serialization.rs
@@ -1,4 +1,6 @@
 //! Provenance: corner-relief project and MCP round trips through public app APIs.
+//! Gate map (#2400): covers app::project (corner-relief round trip), app::mcp (corner-relief
+//! parameters), app::operation::corner_relief.
 
 mod corner_relief_support;
 mod pocket_support;
