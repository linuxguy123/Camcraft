diff --git a/crates/ui/src/egui_app/op_page/header.rs b/crates/ui/src/egui_app/op_page/header.rs
new file mode 100644
index 000000000..58d5798e6
--- /dev/null
+++ b/crates/ui/src/egui_app/op_page/header.rs
@@ -0,0 +1,144 @@
+//! Provenance: original operation header controls from our own UI design.
+
+use egui::Ui;
+use camcraft_app::{model, schema::Operation};
+use crate::state::{CommandKind, State};
+use super::super::fields::combo_owned;
+
+/// Tool, Source and Setup as label | control rows of the header grid.
+pub(super) fn header_rows(ui: &mut Ui, state: &mut State, target: &str, live: Option<&Operation>, exists: bool) {
+    // #535: a kind that mounts no library tool (the wire EDM's) has no
+    // Tool row - and must not adopt the rack's first tool into its draft.
+    let toolless = !state.op_ui.params.kind().info().mounts_tool();
+    let mut tools = state.tool_names();
+    if toolless {
+        tools.clear();
+    } else if !state.op_ui.tool.is_empty() && !tools.contains(&state.op_ui.tool) {
+        tools.push(state.op_ui.tool.clone());
+    } else if state.op_ui.tool.is_empty()
+        && let Some(first) = tools.first()
+    {
+        state.op_ui.tool = first.clone();
+    }
+    if toolless {
+        // no row: the wire is the machine's
+    } else if tools.is_empty() {
+        ui.label("Tool");
+        ui.label("none").on_hover_text("no tools in the document - the Tools page has a catalog");
+    } else {
+        ui.label("Tool");
+        let mut t_idx = tools.iter().position(|t| *t == state.op_ui.tool).unwrap_or(0);
+        let before = t_idx;
+        ui.horizontal(|ui| { super::super::tool_icons::named_glyph(ui, &state.world, &state.op_ui.tool); super::super::tool_icons::tool_combo(ui, &state.world, "op_tool", &mut t_idx, &tools); });
+        if t_idx != before
+            && let Some(t) = tools.get(t_idx)
+        {
+            state.op_ui.tool = t.clone();
+            if exists {
+                state.pending.push_back(CommandKind::EditOperationLinks {
+                    name: target.to_owned(),
+                    tool: Some(state.op_ui.tool.clone()),
+                    src: None,
+                });
+            }
+        }
+    }
+    if !toolless {
+        ui.end_row();
+    }
+    // #535: a wire EDM flushes with dielectric, which no coolant code
+    // of the machine states - no coolant row (the post ignores it).
+    if state.op_ui.params.kind().info().family() != camcraft_app::operation::Family::WireEdm {
+        coolant_row(ui, state, target, live);
+    }
+
+    // Source: the stock or one of the user's parts - never a work
+    // offset (G54...), a setup or a fixture (user review 2026-11-06).
+    let models: Vec<String> = model::model_entities(&state.world)
+        .into_iter()
+        .filter(|(_, e)| !model::is_fixture(&state.world, e))
+        .map(|(n, _)| n)
+        .collect();
+    ui.label("Source");
+    let mut src_items: Vec<String> = vec!["Stock".to_owned()];
+    src_items.extend(models.iter().cloned());
+    let mut s_idx: usize = if state.op_ui.src_kind == 2 {
+        src_items.push("Selection".to_owned());
+        src_items.len() - 1
+    } else if state.op_ui.src_kind != 0 && !state.op_ui.src_name.is_empty() {
+        match models.iter().position(|m| *m == state.op_ui.src_name) {
+            Some(p) => 1 + p,
+            None => {
+                state.op_ui.src_kind = 0;
+                state.op_ui.src_name.clear();
+                0
+            }
+        }
+    } else {
+        0
+    };
+    let before = s_idx;
+    combo_owned(ui, "op_src", &mut s_idx, &src_items);
+    if s_idx != before {
+        match s_idx.checked_sub(1).and_then(|i| models.get(i)) {
+            None => {
+                state.op_ui.src_kind = 0;
+                state.op_ui.src_name.clear();
+            }
+            Some(m) => {
+                state.op_ui.src_kind = 1;
+                state.op_ui.src_name = m.clone();
+            }
+        }
+        if exists {
+            state.pending.push_back(CommandKind::EditOperationLinks {
+                name: target.to_owned(),
+                tool: None,
+                src: Some(state.op_ui.src()),
+            });
+        }
+    }
+    ui.end_row();
+
+    // Setup membership (M3.2 A): moving is never a stamp edit -
+    // SetOperationSetup keeps the stamp and lets the resolved-Z digest
+    // say whether the op went Stale.
+    ui.label("Setup");
+    let setups = camcraft_app::setup::names(&state.world);
+    if setups.is_empty() {
+        ui.label("global (no setups)").on_hover_text("this document has no setups yet - the global stock and offsets apply");
+    } else {
+        let cur = live.and_then(|o| o.setup.clone()).or_else(|| setups.first().cloned());
+        let mut s_idx = setups.iter().position(|n| Some(n) == cur.as_ref()).unwrap_or(0);
+        let before = s_idx;
+        combo_owned(ui, "op_setup", &mut s_idx, &setups);
+        if s_idx != before
+            && let Some(n) = setups.get(s_idx)
+        {
+            state.pending.push_back(CommandKind::SetOperationSetup { name: target.to_owned(), setup: Some(n.clone()) });
+        }
+    }
+    ui.end_row();
+}
+
+/// The Coolant row (#112), under the tool it feeds: the fluid the post
+/// switches on for this operation. A committed operation only - a draft
+/// takes the default (Flood) at creation and offers the row once it
+/// exists, so the row never edits a value no command would carry.
+fn coolant_row(ui: &mut Ui, state: &mut State, target: &str, live: Option<&Operation>) {
+    let Some(op) = live else { return };
+    use camcraft_app::operation::CoolantMode;
+    ui.label("Coolant").on_hover_text(
+        "the cutting fluid the post switches on for this operation - the machine's own code for it; a choice the machine states no code for blocks the post by name",
+    );
+    let labels: Vec<String> = CoolantMode::ALL.iter().map(|m| m.label().to_owned()).collect();
+    let mut idx = CoolantMode::ALL.iter().position(|m| *m == op.coolant).unwrap_or(1);
+    let before = idx;
+    combo_owned(ui, "op_coolant", &mut idx, &labels);
+    if idx != before
+        && let Some(m) = CoolantMode::ALL.get(idx)
+    {
+        state.pending.push_back(CommandKind::EditOperationCoolant { name: target.to_owned(), coolant: *m });
+    }
+    ui.end_row();
+}
diff --git a/crates/ui/src/egui_app/tests/geo_row_hover.rs b/crates/ui/src/egui_app/tests/geo_row_hover.rs
index c58ae3c85..7f06bf7d0 100644
--- a/crates/ui/src/egui_app/tests/geo_row_hover.rs
+++ b/crates/ui/src/egui_app/tests/geo_row_hover.rs
@@ -156,3 +156,59 @@ fn viewport_hover_over_a_picked_face_marks_its_row() {
     harness.run_steps(2);
     assert!(harness.state().state.geo_row_marked.is_empty(), "leaving the face clears the mark");
 }
+
+/// #2982: the header must name the saved selection after a face or edge pick.
+#[test]
+fn source_dropdown_shows_selection_for_face_and_edge_picks() {
+    let mut harness = shell_harness();
+    harness.run_steps(2);
+    let face = harness.state().state.op_ui.geo[0].clone();
+    let chain = {
+        let st = &harness.state().state;
+        let block = model::find_by_name(&st.world, "Block").expect("seed has Block");
+        let features = model::features_of(&st.world, &block).expect("Block has features");
+        camcraft_app::geometry::feature::chains(&features).into_iter().next().expect("an edge").id
+    };
+    for pick in [face, camcraft_app::operation::GeoSel { entity: "Block".into(), feature: FeatureSel::Chain(chain) }] {
+        harness.state_mut().state.pending.push_back(CommandKind::SetOperationGeometry {
+            name: "Contour1".into(), items: vec![pick.clone()],
+        });
+        harness.run_steps(3);
+        assert_eq!(harness.state().state.op_ui.src(), SrcRef::Selection(vec![pick]));
+        assert!(harness.query_by(|n| n.role() == egui::accesskit::Role::ComboBox
+            && n.value().as_deref() == Some("Selection")).is_some(), "the source dropdown must display Selection");
+        assert!(harness.state().state.pending.is_empty(), "displaying the source queues no edit");
+    }
+
+    // Explicit source changes still use history, including a return to the picks.
+    for (from, to, source) in [
+        ("Selection", "Stock", SrcRef::Stock),
+        ("Stock", "Block", SrcRef::Entity("Block".into())),
+    ] {
+        let before = harness.state().state.op_ui.src();
+        harness.state_mut().state.pending.push_back(CommandKind::EditOperationLinks {
+            name: "Contour1".into(), tool: None, src: Some(source.clone()),
+        });
+        harness.run_steps(3);
+        assert_eq!(harness.state().state.op_ui.src(), source);
+        assert_saved_source(&harness, &source);
+        harness.state_mut().state.pending.push_back(CommandKind::Undo);
+        harness.run_steps(3);
+        assert_eq!(harness.state().state.op_ui.src(), before);
+        assert_saved_source(&harness, &before);
+        assert!(harness.query_by(|n| n.role() == egui::accesskit::Role::ComboBox
+            && n.value().as_deref() == Some(from)).is_some(), "undo restores the source label");
+        harness.state_mut().state.pending.push_back(CommandKind::Redo);
+        harness.run_steps(3);
+        assert_eq!(harness.state().state.op_ui.src(), source);
+        assert_saved_source(&harness, &source);
+        assert!(harness.query_by(|n| n.role() == egui::accesskit::Role::ComboBox
+            && n.value().as_deref() == Some(to)).is_some(), "redo restores the source label");
+    }
+}
+
+fn assert_saved_source(harness: &Harness<'static, ShellUi>, source: &SrcRef) {
+    let st = &harness.state().state;
+    let operation = model::find_by_name(&st.world, "Contour1").expect("seed has Contour1");
+    assert_eq!(&model::operation_of(&st.world, &operation).expect("an operation").src, source);
+}
diff --git a/docs/decisions/2982-geometry-source.md b/docs/decisions/2982-geometry-source.md
