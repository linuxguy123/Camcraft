+            let mut points = profile.points().to_vec();
+            points.rotate_left(shift);
+            if reverse {
+                points.reverse();
+            }
+            Loop::new(points).expect("the same closed profile")
+        };
+        for widening in [WireWidening::Uniform, WireWidening::PerRuling] {
+            asymmetric_profiles(
