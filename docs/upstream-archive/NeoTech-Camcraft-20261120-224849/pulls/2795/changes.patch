From 34117a1ef22242500c7aaf931f098ad7d9026278 Mon Sep 17 00:00:00 2001
From: sn3ro <zak.darek@gmail.com>
Date: Thu, 19 Nov 2026 08:12:30 +0000
Subject: [PATCH] test(app): drop the needless drop of a borrowing closure in
 import_step_thread

clippy 0.1.98 refuses drop(point) (clippy::drop_non_drop): the closure
borrows ent mutably, and that borrow ends at its last call anyway.

Fixes #2794

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/app/tests/import_step_thread.rs | 1 -
 1 file changed, 1 deletion(-)

diff --git a/crates/app/tests/import_step_thread.rs b/crates/app/tests/import_step_thread.rs
index dc27b0dec..c39bb7ddd 100644
--- a/crates/app/tests/import_step_thread.rs
+++ b/crates/app/tests/import_step_thread.rs
@@ -130,7 +130,6 @@ fn flank_step(turns: usize) -> String {
     // Corners: (0, 0), (1, CAP), (1, 1), (0, 1 - CAP).
     let corners = [cap_start[0], cap_start[CAP_POINTS], cap_end[0], cap_end[CAP_POINTS]];
     let v: Vec<String> = corners.iter().map(|p| point(&mut out, *p)).collect();
-    drop(point);
     let mut e = |body: String| ent(&mut out, body);
     let surface = e(format!(
         "( BOUNDED_SURFACE() B_SPLINE_SURFACE(1, 2, (({}), ({})), .UNSPECIFIED., .F., .F., .F.) \
