  "title": "fix(ui): an undersize-hole warning no longer hides a shank avoid hit",
  "user": {
    "login": "sn3ro",
    "id": 51385282,
    "node_id": "MDQ6VXNlcjUxMzg1Mjgy",
    "avatar_url": "https://avatars.githubusercontent.com/u/51385282?v=4",
    "gravatar_id": "",
