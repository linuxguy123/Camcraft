 }
 
 /// The ride of a ball of radius `d` INSIDE a hole whose wall is
@@ -224,7 +230,7 @@ pub fn profile_offset_in(
         prev = here;
     }
     out.dedup();
-    Ok(out)
+    Ok(thin(out, tol * MIN_GAP_SHARE))
 }
 
 /// Bisect a candidate gap until its chord stands within `tol` of
@@ -258,3 +264,36 @@ fn settle<F: Fn(f64) -> f64 + Copy>(
     }
     Ok(())
 }
+
+/// Drop every sample that stands closer than `min_gap` to the last
+/// kept one (issue #2882): the bisection toward a vertical tangent
+/// leaves runs of samples far below any output resolution. The first
+/// and the last sample always survive (the window's ends); a kept
+/// sample within `min_gap` of the last one gives way to it. Every
+/// dropped sample stands within `min_gap` of a kept one (within
+/// `2 * min_gap` of the last, after a give-way), so no chord moves by
+/// more than `2 * min_gap`: the ride keeps its chord bound plus that.
+fn thin(pts: Vec<SR>, min_gap: f64) -> Vec<SR> {
+    if pts.len() <= 2 {
+        return pts;
+    }
+    let gap = |a: SR, b: SR| (a.0 - b.0).hypot(a.1 - b.1);
+    let last_idx = pts.len() - 1;
+    let mut out: Vec<SR> = vec![pts[0]];
+    for &p in &pts[1..last_idx] {
+        if out.last().is_some_and(|&l| gap(l, p) >= min_gap) {
+            out.push(p);
+        }
+    }
+    let e = pts[last_idx];
+    while out.len() > 1 {
+        match out.last() {
+            Some(&l) if gap(l, e) < min_gap => {
+                out.pop();
+            }
+            _ => break,
+        }
+    }
+    out.push(e);
+    out
+}
diff --git a/crates/motion/tests/turning_offset_spacing.rs b/crates/motion/tests/turning_offset_spacing.rs
new file mode 100644
index 000000000..8e2c871ae
--- /dev/null
+++ b/crates/motion/tests/turning_offset_spacing.rs
@@ -0,0 +1,170 @@
+//! Pins issue #2882: the ride of a ball outside or inside a turned profile.
+//! It has no move shorter than half the chord share, keeps both window
+//! ends, keeps every sample on the nose (distance d from the profile), and
+//! keeps each chord within 2 * tol of the true curve.
+//!
+//! Gate map (M4.4): covers camcraft_motion::turning::offset (ride
+//! sample spacing) with literal (station, radius) profiles.
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use camcraft_motion::turning::offset::{profile_offset, profile_offset_in};
+
+const NOSE: f64 = 0.8;
+const TOLS: [f64; 3] = [1e-2, 2.5e-3, 1e-4];
+
+const OD_STEP: &[(f64, f64)] = &[(-16.0, 6.0), (2.0, 6.0), (2.0, 5.0), (16.0, 5.0)];
+const OD_COLLAR: &[(f64, f64)] = &[
+    (-16.0, 5.0),
+    (-2.0, 5.0),
+    (-2.0, 7.0),
+    (2.0, 7.0),
+    (2.0, 5.0),
+    (16.0, 5.0),
+];
+const ID_WALL: &[(f64, f64)] = &[(-16.0, 3.0), (0.0, 3.0), (0.0, 4.0), (16.0, 4.0)];
+
+/// Least Euclidean distance from (s, r) to the segments of a polyline.
+fn dist_to(s: f64, r: f64, pts: &[(f64, f64)]) -> f64 {
+    pts.windows(2)
+        .map(|w| {
+            let (ax, ay) = w[0];
+            let (bx, by) = w[1];
+            let (dx, dy) = (bx - ax, by - ay);
+            let len2 = dx * dx + dy * dy;
+            let t = if len2 > 0.0 {
+                (((s - ax) * dx + (r - ay) * dy) / len2).clamp(0.0, 1.0)
+            } else {
+                0.0
+            };
+            (ax + t * dx - s).hypot(ay + t * dy - r)
+        })
+        .fold(f64::INFINITY, f64::min)
+}
+
+/// Least consecutive hypot distance of a ride, and the index of its first sample.
+fn min_gap(cl: &[(f64, f64)]) -> (f64, usize) {
+    cl.windows(2)
+        .enumerate()
+        .map(|(i, w)| ((w[1].0 - w[0].0).hypot(w[1].1 - w[0].1), i))
+        .fold((f64::INFINITY, 0), |best, cur| {
+            if cur.0 < best.0 {
+                cur
+            } else {
+                best
+            }
+        })
+}
+
+fn check_ends_and_nose(
+    name: &str,
+    cl: &[(f64, f64)],
+    pts: &[(f64, f64)],
+    s_lo: f64,
+    s_hi: f64,
+    tol: f64,
+) {
+    let first = cl.first().expect("a ride has samples");
+    let last = cl.last().expect("a ride has samples");
+    assert!(
+        (first.0 - s_lo).abs() < 1e-12,
+        "{name}: tol {tol}, first station {}, want {s_lo}",
+        first.0
+    );
+    assert!(
+        (last.0 - s_hi).abs() < 1e-12,
+        "{name}: tol {tol}, last station {}, want {s_hi}",
+        last.0
+    );
+    for &(s, r) in cl {
+        let d = dist_to(s, r, pts);
+        assert!(
+            (d - NOSE).abs() < 1e-6,
+            "{name}: tol {tol}, sample at station {s}, distance {d}"
+        );
+    }
+}
+
+fn check_chords(name: &str, cl: &[(f64, f64)], pts: &[(f64, f64)], tol: f64) {
+    let bound = NOSE - 2.0 * tol - 1e-9;
+    for w in cl.windows(2) {
+        for k in 1..=9 {
+            let t = f64::from(k) / 10.0;
+            let s = w[0].0 + t * (w[1].0 - w[0].0);
+            let r = w[0].1 + t * (w[1].1 - w[0].1);
+            let d = dist_to(s, r, pts);
+            assert!(
+                d >= bound,
+                "{name}: tol {tol}, chord point at station {s}, distance {d}, bound {bound}"
+            );
+        }
+    }
+}
+
+#[test]
+fn od_ride_has_no_move_shorter_than_half_the_share() {
+    for (name, pts) in [("OD stepped bar", OD_STEP), ("OD collar", OD_COLLAR)] {
+        for tol in TOLS {
+            let cl = profile_offset(pts, NOSE, tol, -16.0, 16.0).expect("a ride");
+            let (gap, i) = min_gap(&cl);
+            assert!(
+                gap >= 0.5 * tol * (1.0 - 1e-9),
+                "{name}: tol {tol}, gap {gap}, index {i}"
+            );
+        }
+    }
+}
+
+#[test]
+fn a_window_end_next_to_a_candidate_keeps_the_gap() {
+    // The window stops 1e-7 past the candidate station 2 - nose (the
+    // step corner's s - d): the sample there and the window's end
+    // stand a hair apart. The end always survives, so the give-way
+    // at the end (not the forward pass) must keep the gap.
+    let s_hi = 2.0 - NOSE + 1e-7;
+    for tol in TOLS {
+        let cl = profile_offset(OD_STEP, NOSE, tol, -16.0, s_hi).expect("a ride");
+        let (gap, i) = min_gap(&cl);
+        assert!(
+            gap >= 0.5 * tol * (1.0 - 1e-9),
+            "window end at {s_hi}: tol {tol}, gap {gap}, index {i} of {}",
+            cl.len()
+        );
+        check_ends_and_nose("OD stepped bar to 1.2", &cl, OD_STEP, -16.0, s_hi, tol);
+        check_chords("OD stepped bar to 1.2", &cl, OD_STEP, tol);
+    }
+}
+
+#[test]
+fn id_ride_has_no_move_shorter_than_half_the_share() {
+    for tol in TOLS {
+        let cl = profile_offset_in(ID_WALL, NOSE, tol, -15.0, 15.0).expect("a ride");
+        let (gap, i) = min_gap(&cl);
+        assert!(
+            gap >= 0.5 * tol * (1.0 - 1e-9),
+            "ID stepped hole wall: tol {tol}, gap {gap}, index {i}"
+        );
+    }
+}
+
+#[test]
+fn thinning_keeps_the_window_ends_and_the_nose() {
+    for tol in TOLS {
+        let od = profile_offset(OD_STEP, NOSE, tol, -16.0, 16.0).expect("a ride");
+        check_ends_and_nose("OD stepped bar", &od, OD_STEP, -16.0, 16.0, tol);
+
+        let id = profile_offset_in(ID_WALL, NOSE, tol, -15.0, 15.0).expect("a ride");
+        check_ends_and_nose("ID stepped hole wall", &id, ID_WALL, -15.0, 15.0, tol);
+    }
+}
+
+#[test]
+fn thinned_chords_stay_within_the_bound() {
+    for tol in TOLS {
+        for (name, pts) in [("OD stepped bar", OD_STEP), ("OD collar", OD_COLLAR)] {
+            let cl = profile_offset(pts, NOSE, tol, -16.0, 16.0).expect("a ride");
+            check_chords(name, &cl, pts, tol);
+        }
+        let id = profile_offset_in(ID_WALL, NOSE, tol, -15.0, 15.0).expect("a ride");
+        check_chords("ID stepped hole wall", &id, ID_WALL, tol);
+    }
+}
diff --git a/docs/decisions/2882-ride-min-spacing.md b/docs/decisions/2882-ride-min-spacing.md
new file mode 100644
index 000000000..130da5623
--- /dev/null
+++ b/docs/decisions/2882-ride-min-spacing.md
@@ -0,0 +1,29 @@
+## #2882 - Thin turning profile samples that are closer than half the chord share
+
+**What was decided:**
+- Add a private `thin` step in `crates/motion/src/turning/offset.rs`.
+- `thin` drops each sample that lies closer than `MIN_GAP_SHARE * share` to the last kept sample. `MIN_GAP_SHARE` is `0.5`.
+- `thin` always keeps the first sample and the last sample. The window ends stay.
+- `profile_offset` and `profile_offset_in` both run the outside ride and the inside ride through `thin`.
+
+**Why:**
+- Near a vertical tangent of the offset curve, the chord bisection places samples less than 1 micrometre apart. The lathe posts then write runs of identical G01 blocks. The Fanuc example wrote 408 identical blocks in one cone-thread program.
+- `out.dedup()` removes only exact duplicates, so it does not fix this case.
+- Thinning at the source fixes every turning ride. This covers profile rough, profile finish, contour and boring. It also covers every lathe post.
+- Each kept sample is still an exact point of the offset curve. No kept sample gouges.
+- Each dropped sample lies within the gap of a kept sample. At the window end, a kept sample can give way to the last sample, so a dropped sample lies within two gaps of a kept one. A chord therefore moves by at most two gaps. The chord bound becomes `2 * share`.
+- The callers pass a quarter of the user tolerance as the share. The ride therefore stays within half of the user tolerance.
+- At a tolerance of 0.01 mm, the share is 0.0025 mm. The least gap is then 0.00125 mm. That gap is more than the posted resolution of 0.001 mm.
+
+**What was considered and dropped:**
+- Drop repeated feed blocks in each lathe post (`assets/posts/fanuc-lathe.cps` and `assets/posts/tormach-lathe.cps`), when a block has the same words as the last block.
+  - Dropped because it hides the cause in each post.
+  - Dropped because it changes posted output in two dialects.
+  - Dropped because the project file still keeps the dense samples.
+- Use a fixed absolute gap, for example 1 micrometre.
+  - Dropped because a fixed gap does not scale with the tolerance that the user sets.
+
+**Cost to change later:**
+- Low. The change is one private function and one constant in `offset.rs`. The pinning test is `crates/motion/tests/turning_offset_spacing.rs`.
+- Changing `MIN_GAP_SHARE` changes the chord bound. Keep the bound at `2 * share`, or update the tolerance claim in this entry.
+- Known limit: at a very small user tolerance, for example 0.001 mm, the gap is below the posted resolution. Two rounded blocks can then still be equal. This is rare and it costs no position.

