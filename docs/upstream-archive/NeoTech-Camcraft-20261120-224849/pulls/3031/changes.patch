new file mode 100644
index 000000000..4e1574a91
--- /dev/null
+++ b/crates/ui/src/draw_list.rs
@@ -0,0 +1,152 @@
+//! The viewport's draw list (#2818): which pipeline draws which index range,
+//! in which order, for each display mode. Pure arithmetic on the counts that
+//! `View3D::set_document` already cached, so a frame builds no geometry and a
+//! test can read the list without a GPU.
+//! Provenance: our own pass order, moved out of `View3D::render_with`; the
+//! hidden-edge pass is the reversed depth test of published hidden-line
+//! practice (Foley, van Dam et al., "Computer Graphics: Principles and
+//! Practice"). No vendor material.
+
+use std::ops::Range;
+
+use crate::state::DisplayMode;
+
+/// One pipeline of the 3D pass.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Pipe {
+    /// Lit model faces.
+    Faces,
+    /// Model faces to the depth buffer only: the hidden-line prepass.
+    FacesDepthOnly,
+    /// Feature edges in front of the faces.
+    Edges,
+    /// Feature edges behind the faces, in a lighter tone.
+    HiddenEdges,
+    /// Translucent stock faces.
+    Stock,
+    /// The traced (machined) stock, drawn by its own pass.
+    TracedStock,
+    /// Translucent cut-region fills.
+    Region,
+}
+
+impl Pipe {
+    /// True when the step reads the edge index buffer, not the face one.
+    #[must_use]
+    pub const fn uses_edge_buffer(self) -> bool {
+        matches!(self, Pipe::Edges | Pipe::HiddenEdges)
+    }
+}
+
+/// One draw call: a pipeline and the index range that it draws.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Step {
+    pub pipe: Pipe,
+    pub range: Range<u32>,
+}
+
+/// The cached partition of the document's index buffers.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Counts {
+    /// All face indices: models, then stock, then region fills.
+    pub index_count: u32,
+    pub model_index_count: u32,
+    pub stock_index_end: u32,
+    /// Start of the overlay stock (the incoming stock) in the stock range.
+    pub overlay_index_start: u32,
+    /// All edge indices: model edges, then stock edges.
+    pub edge_count: u32,
+    pub model_edge_count: u32,
+}
+
+/// The most steps that one frame can hold.
+const MAX_STEPS: usize = 8;
+
+/// A fixed-size draw list: no allocation on a frame.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Plan {
+    steps: [Option<Step>; MAX_STEPS],
+    len: usize,
+}
+
+impl Plan {
+    fn new() -> Self {
+        Plan { steps: [const { None }; MAX_STEPS], len: 0 }
+    }
+
+    /// Add a step. An empty range draws nothing and is not listed.
+    fn push(&mut self, pipe: Pipe, range: Range<u32>) {
+        if range.start >= range.end && pipe != Pipe::TracedStock {
+            return;
+        }
+        if let Some(slot) = self.steps.get_mut(self.len) {
+            *slot = Some(Step { pipe, range });
+            self.len += 1;
+        }
+    }
+
+    /// The steps in draw order.
+    pub fn steps(&self) -> impl Iterator<Item = &Step> {
+        self.steps.iter().take(self.len).flatten()
+    }
+
+    /// The pipelines in draw order: what a test reads.
+    #[must_use]
+    pub fn pipes(&self) -> Vec<Pipe> {
+        self.steps().map(|s| s.pipe).collect()
+    }
+}
+
+/// The draw list of one frame. `traced` says that the caller has a traced
+/// stock to draw in the stock slot; only the shaded modes use it.
+///
+/// - Shaded, with edges: faces, edges, stock, stock edges, regions.
+/// - Shaded: the same without the edges of the model and of the stock.
+/// - Wireframe: depth-only faces, edges, stock edges, regions. No stock
+///   faces: the stock is a volume and its full wire reads truer.
+/// - Shaded, with hidden edges: as "with edges", and the model edges draw a
+///   second time behind the faces.
+/// - Wireframe, see-through (#2636): edges, stock edges, regions. No face
+///   step at all, so the depth buffer stays empty and each edge draws.
+#[must_use]
+pub fn plan(display: DisplayMode, c: &Counts, traced: bool) -> Plan {
+    let mut p = Plan::new();
+    if c.index_count == 0 {
+        return p;
+    }
+    let wireframe = display.is_wireframe();
+    let models = 0..c.model_index_count;
+    let model_edges = 0..c.model_edge_count;
+    // See-through writes no depth: a depth prepass would hide the far edges,
+    // the stock wire and the toolpath lines behind the model.
+    if !display.sees_through() {
+        p.push(if wireframe { Pipe::FacesDepthOnly } else { Pipe::Faces }, models);
+    }
+    // "Shaded" draws no wire: not on the model and not on the stock.
+    let wire = display != DisplayMode::Shaded;
+    if wire {
+        p.push(Pipe::Edges, model_edges.clone());
+    }
+    if display == DisplayMode::ShadedHiddenEdges {
+        p.push(Pipe::HiddenEdges, model_edges);
+    }
+    let traced = traced && !wireframe;
+    if traced {
+        p.push(Pipe::TracedStock, 0..0);
+        // The overlay stock is not the traced stock's to replace.
+        p.push(Pipe::Stock, c.overlay_index_start..c.stock_index_end);
+    } else {
+        if !wireframe {
+            p.push(Pipe::Stock, c.model_index_count..c.stock_index_end);
+        }
+        if wire {
+            p.push(Pipe::Edges, c.model_edge_count..c.edge_count);
+        }
+    }
+    p.push(Pipe::Region, c.stock_index_end..c.index_count);
+    p
+}
+
+#[cfg(test)]
+#[path = "draw_list_tests.rs"]
+mod tests;
diff --git a/crates/ui/src/draw_list_tests.rs b/crates/ui/src/draw_list_tests.rs
new file mode 100644
index 000000000..72d369309
--- /dev/null
+++ b/crates/ui/src/draw_list_tests.rs
@@ -0,0 +1,104 @@
+//! The draw list of each display mode (#2818 "Done means": a test shows the
+//! draw list for each display mode).
+//! Provenance: our own tests over our own pass order.
+//! Gate map: covers ui::draw_list.
+
+use super::{Counts, Pipe, Step, plan};
+use crate::state::DisplayMode;
+
+/// A model, a stock and one region fill: each range is not empty.
+fn scene() -> Counts {
+    Counts {
+        index_count: 90,
+        model_index_count: 36,
+        stock_index_end: 72,
+        overlay_index_start: 72,
+        edge_count: 48,
+        model_edge_count: 24,
+    }
+}
+
+#[test]
+fn shaded_with_edges_draws_faces_then_edges() {
+    let p = plan(DisplayMode::ShadedEdges, &scene(), false);
+    assert_eq!(p.pipes(), [Pipe::Faces, Pipe::Edges, Pipe::Stock, Pipe::Edges, Pipe::Region]);
+    let steps: Vec<Step> = p.steps().cloned().collect();
+    assert_eq!(steps[0].range, 0..36, "the model faces");
+    assert_eq!(steps[1].range, 0..24, "the model edges");
+    assert_eq!(steps[2].range, 36..72, "the stock faces");
+    assert_eq!(steps[3].range, 24..48, "the stock edges");
+    assert_eq!(steps[4].range, 72..90, "the region fills");
+}
+
+#[test]
+fn shaded_draws_faces_and_no_edges() {
+    // The mode applies to the model and to the stock in the same way.
+    let p = plan(DisplayMode::Shaded, &scene(), false);
+    assert_eq!(p.pipes(), [Pipe::Faces, Pipe::Stock, Pipe::Region]);
+    assert!(!p.pipes().contains(&Pipe::Edges), "no wire on the model or on the stock");
+    assert!(!p.pipes().contains(&Pipe::HiddenEdges));
+}
+
+#[test]
+fn wireframe_draws_depth_only_faces_and_each_edge() {
+    let p = plan(DisplayMode::Wireframe, &scene(), false);
+    assert_eq!(p.pipes(), [Pipe::FacesDepthOnly, Pipe::Edges, Pipe::Edges, Pipe::Region]);
+    assert!(!p.pipes().contains(&Pipe::Faces), "no lit faces");
+    assert!(!p.pipes().contains(&Pipe::Stock), "no stock faces");
+}
+
+#[test]
+fn shaded_with_hidden_edges_draws_the_model_edges_two_times() {
+    let p = plan(DisplayMode::ShadedHiddenEdges, &scene(), false);
+    assert_eq!(
+        p.pipes(),
+        [Pipe::Faces, Pipe::Edges, Pipe::HiddenEdges, Pipe::Stock, Pipe::Edges, Pipe::Region]
+    );
+    let hidden = p.steps().find(|s| s.pipe == Pipe::HiddenEdges).cloned();
+    assert_eq!(hidden.map(|s| s.range), Some(0..24), "the same cached model edge list");
+}
+
+#[test]
+fn the_traced_stock_takes_the_stock_slot_in_the_shaded_modes_only() {
+    let mut c = scene();
+    c.overlay_index_start = 54;
+    for mode in [DisplayMode::ShadedEdges, DisplayMode::Shaded, DisplayMode::ShadedHiddenEdges] {
+        let p = plan(mode, &c, true);
+        let pipes = p.pipes();
+        assert!(pipes.contains(&Pipe::TracedStock), "{mode:?}");
+        let stock = p.steps().find(|s| s.pipe == Pipe::Stock).cloned();
+        assert_eq!(stock.map(|s| s.range), Some(54..72), "{mode:?}: only the overlay stock");
+        let stock_wire = p.steps().any(|s| s.pipe == Pipe::Edges && s.range == (24..48));
+        assert!(!stock_wire, "{mode:?}: the traced stock replaces the stock wire");
+    }
+    let p = plan(DisplayMode::Wireframe, &c, true);
+    assert!(!p.pipes().contains(&Pipe::TracedStock), "wireframe draws the stock wire");
+}
+
+#[test]
+fn an_empty_document_draws_nothing_and_empty_ranges_are_not_listed() {
+    for mode in DisplayMode::ALL {
+        assert!(plan(mode, &Counts::default(), true).pipes().is_empty(), "{mode:?}");
+    }
+    // A model only: no stock, no region, no stock edges.
+    let c = Counts { index_count: 36, model_index_count: 36, stock_index_end: 36, overlay_index_start: 36, edge_count: 24, model_edge_count: 24 };
+    assert_eq!(plan(DisplayMode::ShadedEdges, &c, false).pipes(), [Pipe::Faces, Pipe::Edges]);
+    assert_eq!(plan(DisplayMode::Shaded, &c, false).pipes(), [Pipe::Faces]);
+}
+
+/// #2636: "Wireframe, see-through" draws each edge, front and back. No face
+/// goes to the color buffer or to the depth buffer, so the model hides
+/// nothing behind it: not the stock, not a fixture, not a toolpath.
+#[test]
+fn see_through_wireframe_draws_each_edge_and_no_face() {
+    let mode = DisplayMode::WireframeSeeThrough;
+    let p = plan(mode, &scene(), false);
+    assert_eq!(p.pipes(), [Pipe::Edges, Pipe::Edges, Pipe::Region]);
+    assert!(!p.pipes().contains(&Pipe::FacesDepthOnly), "no depth prepass: nothing is hidden");
+    let steps: Vec<Step> = p.steps().cloned().collect();
+    assert_eq!(steps[0].range, 0..24, "the cached model edges");
+    assert_eq!(steps[1].range, 24..48, "the cached stock edges");
+    // The traced stock is a shaded surface: this mode draws the stock wire.
+    let traced = plan(mode, &scene(), true);
+    assert_eq!(traced.pipes(), [Pipe::Edges, Pipe::Edges, Pipe::Region]);
+}
