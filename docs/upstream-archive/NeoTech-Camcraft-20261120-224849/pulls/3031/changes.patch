+//! A runaway face divided again over its boundary nodes only (#2844).
+//! solidcore-tess plans a long thin strip (a thread flank) isotropically:
+//! hundreds of thousands of triangles where the strip's own edge nodes
+//! already describe it. Here such a face gets the Delaunay fill of its
+//! boundary loop, with no node inside, and keeps it only when
+//! [`mesh_deviation::measure_within`] proves it inside the tolerance. The
+//! shared edge nodes stay as they are, so the neighbouring faces still
+//! meet it point for point.
+//! Provenance: our own seam design over the public API of solidcore-tess
+//! (`FacePlan`, `TessPlan`; Apache-2.0) and the polygon fill of
+//! `mesh_redivide_fill`. No HSMWorks material consulted.
+
+use std::collections::HashSet;
+
+use solidcore::kernel::CancelToken;
+use solidcore_record::brep::Brep;
+use solidcore_tess::{EvalSurface, FacePlan, TessPlan};
+
+use crate::mesh_deviation;
+use crate::mesh_redivide_fill::{area2, fill};
+use crate::mesh_weld::SNAP_MOVE_MM;
+
+/// Only a face the planner gave at least this many triangles is divided
+/// again: a face under it is cheap as planned and stays the planner's.
+pub const REDIVIDE_MIN_TRIANGLES: usize = 10_000;
+
+/// Only a face with this many planned triangles for each boundary node is
+/// divided again (the boundary alone makes about one triangle a node).
+pub const REDIVIDE_RATIO: usize = 16;
+
+/// Every runaway face of `plan` (see the constants) divided over its
+/// boundary nodes where that division measures inside `tol_mm`; each one
+/// named in the returned notes. A face it cannot divide, or whose division
+/// measures over the tolerance, keeps the planner's triangles.
+pub(crate) fn redivide(plan: &mut TessPlan, record: &Brep, tol_mm: f64, stop: &CancelToken) -> Vec<String> {
+    let mut notes = Vec::new();
+    for i in 0..plan.faces.len() {
+        if stop.is_cancelled() {
+            break;
+        }
+        let Some(f) = plan.faces.get(i) else { continue };
+        let planned = f.triangles.len();
+        if planned < REDIVIDE_MIN_TRIANGLES || planned / REDIVIDE_RATIO < f.fixed.len() {
+            continue;
+        }
+        let Some((index, s)) = f.surface.and_then(|k| Some((k, plan.surfaces.get(k as usize)?))) else { continue };
+        let Some(triangles) = boundary_division(f, s) else { continue };
+        let Some(uv) = f.uv.get(..f.fixed.len()) else { continue };
+        let candidate = FacePlan {
+            face: f.face,
+            surface: Some(0),
+            uv: uv.to_vec(),
+            fixed: f.fixed.clone(),
+            normals: Vec::new(),
+            flip: f.flip,
+            triangles,
+            poles: Vec::new(),
+        };
+        let mut alone = TessPlan { surfaces: vec![s.clone()], faces: vec![candidate], ..TessPlan::default() };
+        let Ok(deviation) = mesh_deviation::measure_within(&alone, record, tol_mm, stop) else { continue };
+        let judged = deviation.largest() + SNAP_MOVE_MM;
+        if judged.is_nan() || judged > tol_mm {
+            continue;
+        }
+        let (Some(mut kept), Some(slot)) = (alone.faces.pop(), plan.faces.get_mut(i)) else { continue };
+        kept.surface = Some(index);
+        notes.push(format!(
+            "face {}: divided over its {} boundary nodes ({} triangles for the planner's {planned})",
+            kept.face,
+            kept.fixed.len(),
+            kept.triangles.len()
+        ));
+        *slot = kept;
+    }
+    notes
+}
+
+/// The sides of `triangles` that no neighbour runs back along, each in its
+/// triangle's direction. `None`: a side used twice in one direction.
+fn boundary_sides(triangles: &[[u32; 3]]) -> Option<HashSet<(u32, u32)>> {
+    let mut all = HashSet::with_capacity(triangles.len().saturating_mul(3));
+    for t in triangles {
+        for side in [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])] {
+            if !all.insert(side) {
+                return None;
+            }
+        }
+    }
+    Some(all.iter().copied().filter(|(a, b)| !all.contains(&(*b, *a))).collect())
+}
+
+/// The triangles of `f` over its boundary nodes alone, wound as the
+/// planner's. `None` where the face is not a plain region of its (u, v)
+/// plane inside one loop of its shared edge nodes (a pole, a hole, a
+/// triangle turned over across a period, a boundary node that is not a
+/// shared one, a pinched boundary), or where the fill does not keep that
+/// boundary.
+fn boundary_division(f: &FacePlan, s: &EvalSurface) -> Option<Vec<[u32; 3]>> {
+    let n = f.fixed.len();
+    if n < 3 || f.uv.len() < n || !f.poles.is_empty() || !f.normals.is_empty() {
+        return None;
+    }
+    // One sense for every planned triangle in (u, v): the face is flat there.
+    let (mut ccw, mut cw) = (false, false);
+    for t in &f.triangles {
+        let [a, b, c] = [f.uv.get(t[0] as usize)?, f.uv.get(t[1] as usize)?, f.uv.get(t[2] as usize)?];
+        let area = area2(*a, *b, *c);
+        ccw |= area > 0.0;
+        cw |= area < 0.0;
+    }
+    if ccw == cw {
+        return None;
+    }
+    let boundary = boundary_sides(&f.triangles)?;
+    // Each boundary node is a shared one and leaves along one side only.
+    let mut next: Vec<Option<u32>> = vec![None; n];
+    for (a, b) in &boundary {
+        let slot = next.get_mut(*a as usize)?;
+        if slot.is_some() || *b as usize >= n {
+            return None;
+        }
+        *slot = Some(*b);
+    }
+    // A shared node inside the face (not on its boundary) cannot be kept.
+    if f.triangles.iter().flatten().any(|i| next.get(*i as usize).is_some_and(Option::is_none)) {
+        return None;
+    }
+    // The fill's plane: (u, v) scaled to the surface's mean lengths, so
+    // that near in the plane is near on the surface; u mirrored for a face
+    // the planner wound clockwise.
+    let (mut su, mut sv, mut count) = (0.0_f64, 0.0_f64, 0.0_f64);
+    for uv in f.uv.iter().take(n) {
+        let (_, du, dv) = s.derivs(uv[0], uv[1])?;
+        su += (du.x * du.x + du.y * du.y + du.z * du.z).sqrt();
+        sv += (dv.x * dv.x + dv.y * dv.y + dv.z * dv.z).sqrt();
+        count += 1.0;
+    }
+    let (su, sv) = (if ccw { su / count } else { -su / count }, sv / count);
+    if !(su.is_finite() && sv.is_finite() && su != 0.0 && sv > 0.0) {
+        return None;
+    }
+    // The one loop, from its lowest node (one result for one plan).
+    let start = next.iter().position(Option::is_some)?;
+    let (mut ring, mut node) = (Vec::with_capacity(boundary.len()), start);
+    loop {
+        ring.push(u32::try_from(node).ok()?);
+        node = (*next.get(node)?)? as usize;
+        if node == start {
+            break;
+        }
+        if ring.len() > boundary.len() {
+            return None;
+        }
+    }
+    if ring.len() != boundary.len() {
+        return None;
+    }
+    let points: Vec<[f64; 2]> =
+        ring.iter().map(|i| f.uv.get(*i as usize).map(|uv| [uv[0] * su, uv[1] * sv])).collect::<Option<_>>()?;
+    let out: Vec<[u32; 3]> = fill(&points)?
+        .iter()
+        .map(|t| Some([*ring.get(t[0] as usize)?, *ring.get(t[1] as usize)?, *ring.get(t[2] as usize)?]))
+        .collect::<Option<_>>()?;
+    // Counter-clockwise in the fill's plane (so wound as the planner's,
+    // in the mirrored plane too) with the planner's boundary: they cover
+    // the face once.
+    (boundary_sides(&out)? == boundary).then_some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use solidcore_record::Vec3;
+
+    fn plane() -> EvalSurface {
+        EvalSurface::Plane {
+            origin: solidcore_tess::vec3(Vec3::new(0.0, 0.0, 0.0)),
+            du: solidcore_tess::vec3(Vec3::new(1.0, 0.0, 0.0)),
+            dv: solidcore_tess::vec3(Vec3::new(0.0, 1.0, 0.0)),
+        }
+    }
+
+    /// A 4 x 4 square of cells, 100 x 1 in (u, v): the 16 boundary nodes
+    /// first (the shared ones), then the 9 inside; two triangles a cell.
+    fn grid(clockwise: bool) -> FacePlan {
+        let cell = |i: usize, j: usize| [i as f64 * 25.0, j as f64 * 0.25];
+        let on_rim = |i: usize, j: usize| i == 0 || j == 0 || i == 4 || j == 4;
+        let all: Vec<(usize, usize)> = (0..5).flat_map(|j| (0..5).map(move |i| (i, j))).collect();
+        let mut nodes: Vec<(usize, usize)> = all.iter().copied().filter(|(i, j)| on_rim(*i, *j)).collect();
+        nodes.extend(all.iter().copied().filter(|(i, j)| !on_rim(*i, *j)));
+        let id = |i: usize, j: usize| nodes.iter().position(|n| *n == (i, j)).unwrap() as u32;
+        let mut triangles = Vec::new();
+        for j in 0..4 {
+            for i in 0..4 {
+                triangles.push([id(i, j), id(i + 1, j), id(i + 1, j + 1)]);
+                triangles.push([id(i, j), id(i + 1, j + 1), id(i, j + 1)]);
+            }
+        }
+        if clockwise {
+            triangles.iter_mut().for_each(|t| t.swap(1, 2));
+        }
+        let uv: Vec<[f64; 2]> = nodes.iter().map(|(i, j)| cell(*i, *j)).collect();
+        let fixed = uv.iter().take(16).map(|p| Vec3::new(p[0], p[1], 0.0)).collect();
+        FacePlan { face: 0, surface: Some(0), uv, fixed, flip: clockwise, triangles, ..FacePlan::default() }
+    }
+
+    #[test]
+    fn a_face_is_divided_over_its_boundary_nodes_with_the_same_boundary_and_sense() {
+        for clockwise in [false, true] {
+            let f = grid(clockwise);
+            let out = boundary_division(&f, &plane()).expect("a plain region divides");
+            assert_eq!(out.len(), 14, "16 boundary nodes make 14 triangles");
+            assert!(out.iter().flatten().all(|i| *i < 16), "no inside node is used");
+            assert_eq!(boundary_sides(&out), boundary_sides(&f.triangles));
+            let area: f64 = out.iter().map(|t| area2(f.uv[t[0] as usize], f.uv[t[1] as usize], f.uv[t[2] as usize])).sum();
+            assert_eq!(area, if clockwise { -200.0 } else { 200.0 }, "the whole face, wound as planned");
+        }
+    }
+
+    #[test]
+    fn a_face_that_is_not_a_plain_region_of_its_shared_nodes_is_not_divided() {
+        // A boundary node that is not a shared edge node.
+        let mut f = grid(false);
+        f.fixed.truncate(15);
+        assert_eq!(boundary_division(&f, &plane()), None);
+        // A shared node inside the face.
+        let mut f = grid(false);
+        f.fixed.push(Vec3::new(25.0, 0.25, 0.0));
+        assert_eq!(boundary_division(&f, &plane()), None);
+        // A triangle turned over against the others.
+        let mut f = grid(false);
+        f.triangles[5].swap(1, 2);
+        assert_eq!(boundary_division(&f, &plane()), None);
+        // A pole node.
+        let mut f = grid(false);
+        f.poles.push(solidcore_tess::PoleNode { node: 0, rule: solidcore_tess::PoleRule::Limit { along: 0, reach: 0.0 } });
+        assert_eq!(boundary_division(&f, &plane()), None);
+    }
+}
diff --git a/crates/kernel/src/mesh_redivide_fill.rs b/crates/kernel/src/mesh_redivide_fill.rs
new file mode 100644
index 000000000..5a4eabcea
--- /dev/null
+++ b/crates/kernel/src/mesh_redivide_fill.rs
@@ -0,0 +1,203 @@
+//! The triangles of one simple polygon over its own vertices (#2844): ear
+//! clipping, then side flips until every inside side is locally Delaunay,
+//! so a long strip gets short sides across it and no fan along it. No
+//! point is added, and a boundary side is never flipped.
+//! Provenance: textbook computational geometry - ear clipping by the two
+//! ears theorem (Meisters, "Polygons Have Ears", Amer. Math. Monthly 82,
+//! 1975), the flip algorithm of Lawson ("Software for C1 surface
+//! interpolation", 1977) and the in-circle determinant (de Berg et al.,
+//! "Computational Geometry", ch. 9). No HSMWorks material consulted.
+
+use std::collections::HashMap;
+
+/// The most vertices a polygon may have here: ear clipping is quadratic.
+pub const MAX_FILL_VERTICES: usize = 8192;
+
+/// Twice the signed area of the triangle `a b c`.
+pub(crate) fn area2(a: [f64; 2], b: [f64; 2], c: [f64; 2]) -> f64 {
+    (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+}
+
+/// The triangles of the counter-clockwise simple polygon `p`, each
+/// counter-clockwise, as indices into `p`: `p.len() - 2` of them. `None`
+/// for a polygon past [`MAX_FILL_VERTICES`], one with a point that is not
+/// finite, and one where no ear is found (it crosses or touches itself).
+pub(crate) fn fill(p: &[[f64; 2]]) -> Option<Vec<[u32; 3]>> {
+    let n = p.len();
+    if !(3..=MAX_FILL_VERTICES).contains(&n) || p.iter().flatten().any(|x| !x.is_finite()) {
+        return None;
+    }
+    let mut triangles = clip_ears(p)?;
+    flip_to_delaunay(p, &mut triangles);
+    Some(triangles)
+}
+
+/// Ear clipping: a corner that turns left and holds no other vertex of
+/// what is left of the polygon is cut off, until a triangle is left.
+fn clip_ears(p: &[[f64; 2]]) -> Option<Vec<[u32; 3]>> {
+    let n = p.len();
+    let at = |i: usize| p.get(i).copied();
+    let mut prev: Vec<usize> = (0..n).map(|i| (i + n - 1) % n).collect();
+    let mut next: Vec<usize> = (0..n).map(|i| (i + 1) % n).collect();
+    let id = |i: usize| u32::try_from(i).ok();
+    let mut out = Vec::with_capacity(n.saturating_sub(2));
+    let (mut left, mut cur, mut misses) = (n, 0_usize, 0_usize);
+    while left > 3 {
+        let (a, c) = (*prev.get(cur)?, *next.get(cur)?);
+        let (pa, pb, pc) = (at(a)?, at(cur)?, at(c)?);
+        let mut ear = area2(pa, pb, pc) > 0.0;
+        let mut v = *next.get(c)?;
+        while ear && v != a {
+            let q = at(v)?;
+            ear = !(area2(pa, pb, q) >= 0.0 && area2(pb, pc, q) >= 0.0 && area2(pc, pa, q) >= 0.0);
+            v = *next.get(v)?;
+        }
+        if ear {
+            out.push([id(a)?, id(cur)?, id(c)?]);
+            *next.get_mut(a)? = c;
+            *prev.get_mut(c)? = a;
+            left -= 1;
+            misses = 0;
+        } else {
+            misses += 1;
+            if misses > left {
+                return None;
+            }
+        }
+        cur = c;
+    }
+    let (a, c) = (*prev.get(cur)?, *next.get(cur)?);
+    out.push([id(a)?, id(cur)?, id(c)?]);
+    // What is left turns left too, or the polygon was not a simple one.
+    (area2(at(a)?, at(cur)?, at(c)?) >= 0.0).then_some(out)
+}
+
+/// `d` lies inside the circle through the counter-clockwise `a b c`, by
+/// more than rounding: the determinant against the size of its terms.
+fn in_circle(a: [f64; 2], b: [f64; 2], c: [f64; 2], d: [f64; 2]) -> bool {
+    let row = |q: [f64; 2]| {
+        let (x, y) = (q[0] - d[0], q[1] - d[1]);
+        [x, y, x * x + y * y]
+    };
+    let (r, s, t) = (row(a), row(b), row(c));
+    let terms = [
+        r[0] * (s[1] * t[2] - s[2] * t[1]),
+        -r[1] * (s[0] * t[2] - s[2] * t[0]),
+        r[2] * (s[0] * t[1] - s[1] * t[0]),
+    ];
+    let size: f64 = terms.iter().map(|x| x.abs()).sum();
+    terms.iter().sum::<f64>() > 1e-12 * size
+}
+
+/// Lawson's flips: an inside side whose far corner lies in its triangle's
+/// circle is turned to the other diagonal, where the two triangles make a
+/// convex quad. Bounded: at most `n * n` flips (the textbook bound).
+fn flip_to_delaunay(p: &[[f64; 2]], triangles: &mut [[u32; 3]]) {
+    let at = |i: u32| p.get(i as usize).copied();
+    let mut owner: HashMap<(u32, u32), usize> = HashMap::with_capacity(triangles.len().saturating_mul(3));
+    let mut stack: Vec<(u32, u32)> = Vec::new();
+    for (k, t) in triangles.iter().enumerate() {
+        for side in [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])] {
+            owner.insert(side, k);
+            stack.push(side);
+        }
+    }
+    // The corner of triangle `k` that is not on its side `a b`.
+    let apex = |triangles: &[[u32; 3]], k: usize, a: u32, b: u32| {
+        triangles.get(k).and_then(|t| t.iter().copied().find(|i| *i != a && *i != b))
+    };
+    let mut budget = p.len().saturating_mul(p.len());
+    while let Some((a, b)) = stack.pop() {
+        let (Some(&k1), Some(&k2)) = (owner.get(&(a, b)), owner.get(&(b, a))) else { continue };
+        let (Some(c), Some(d)) = (apex(triangles, k1, a, b), apex(triangles, k2, a, b)) else { continue };
+        let (Some(pa), Some(pb), Some(pc), Some(pd)) = (at(a), at(b), at(c), at(d)) else { continue };
+        if !in_circle(pa, pb, pc, pd) || area2(pa, pd, pc) <= 0.0 || area2(pd, pb, pc) <= 0.0 {
+            continue;
+        }
+        if budget == 0 {
+            return;
+        }
+        budget -= 1;
+        if let Some(t) = triangles.get_mut(k1) {
+            *t = [a, d, c];
+        }
+        if let Some(t) = triangles.get_mut(k2) {
+            *t = [d, b, c];
+        }
+        owner.remove(&(a, b));
+        owner.remove(&(b, a));
+        owner.insert((d, c), k1);
+        owner.insert((c, d), k2);
+        owner.insert((a, d), k1);
+        owner.insert((b, c), k2);
+        stack.extend([(a, d), (d, b), (b, c), (c, a)]);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A strip 100 long and 1 wide, `n` nodes on each long side, the far
+    /// side shifted half a step.
+    fn strip(n: usize) -> Vec<[f64; 2]> {
+        let step = 100.0 / (n - 1) as f64;
+        let mut p: Vec<[f64; 2]> = (0..n).map(|i| [i as f64 * step, 0.0]).collect();
+        p.extend((0..n).rev().map(|i| [(i as f64 * step + 0.5 * step).min(100.0), 1.0]));
+        p
+    }
+
+    fn checked(p: &[[f64; 2]]) -> Vec<[u32; 3]> {
+        let t = fill(p).expect("a simple polygon fills");
+        assert_eq!(t.len(), p.len() - 2);
+        let area = |t: &[u32; 3]| area2(p[t[0] as usize], p[t[1] as usize], p[t[2] as usize]);
+        assert!(t.iter().all(|t| area(t) >= 0.0), "every triangle counter-clockwise");
+        let whole: f64 = (1..p.len() - 1).map(|i| area2(p[0], p[i], p[i + 1])).sum();
+        let sum: f64 = t.iter().map(area).sum();
+        assert!((sum - whole).abs() < 1e-9 * whole.abs(), "the triangles cover the polygon: {sum} of {whole}");
+        t
+    }
+
+    #[test]
+    fn a_long_strip_is_filled_with_short_sides_across_it() {
+        let p = strip(200);
+        let t = checked(&p);
+        let longest = t
+            .iter()
+            .flat_map(|t| [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])])
+            .map(|(a, b)| (p[a as usize][0] - p[b as usize][0]).hypot(p[a as usize][1] - p[b as usize][1]))
+            .fold(0.0, f64::max);
+        assert!(longest < 1.5, "no side runs along the strip: {longest}");
+    }
+
+    #[test]
+    fn collinear_runs_and_a_notch_keep_every_boundary_side() {
+        // An L with collinear nodes on each side: 5 reflex-free runs and
+        // one reflex corner.
+        let mut p = Vec::new();
+        p.extend((0..8).map(|i| [i as f64, 0.0]));
+        p.extend((0..4).map(|j| [8.0, j as f64]));
+        p.extend((0..4).map(|i| [8.0 - i as f64, 4.0]));
+        p.extend((0..4).map(|j| [4.0, 4.0 + j as f64]));
+        p.extend((0..4).map(|i| [4.0 - i as f64, 8.0]));
+        p.extend((0..8).map(|j| [0.0, 8.0 - j as f64]));
+        let t = checked(&p);
+        let n = p.len() as u32;
+        for i in 0..n {
+            let side = (i, (i + 1) % n);
+            assert!(
+                t.iter().any(|t| [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])].contains(&side)),
+                "boundary side {side:?} is a triangle's side"
+            );
+        }
+    }
+
+    #[test]
+    fn a_polygon_that_cannot_be_filled_is_refused() {
+        // A bow tie: its sides cross.
+        assert_eq!(fill(&[[0.0, 0.0], [2.0, 2.0], [2.0, 0.0], [0.0, 2.0]]), None);
+        assert_eq!(fill(&[[0.0, 0.0], [1.0, 0.0]]), None);
+        assert_eq!(fill(&[[0.0, 0.0], [1.0, 0.0], [f64::NAN, 1.0]]), None);
+        assert_eq!(fill(&vec![[0.0, 0.0]; MAX_FILL_VERTICES + 1]), None);
+    }
+}
diff --git a/crates/kernel/tests/machining_mesh_redivide.rs b/crates/kernel/tests/machining_mesh_redivide.rs
new file mode 100644
index 000000000..58bc4ef43
--- /dev/null
+++ b/crates/kernel/tests/machining_mesh_redivide.rs
@@ -0,0 +1,43 @@
+//! #2844 at the kernel: the seam divides a runaway face over its boundary
+//! nodes only where that division measures inside the tolerance. A wide
+//! twisted face needs its inside nodes: its boundary division stands
+//! millimetres off the surface, so it keeps the planner's triangles and
+//! the mesh says nothing about a new division. (The face that does take
+//! the boundary division, a thread flank, is pinned where its fixture is
+//! made: `crates/app/tests/import_step_thread.rs`.)
+//! Fixture (our own, testdata/models/): `twisted_flank.step`, a closed
+//! solid over the 40 x 40 mm patch z = 3xy/80.
+//! Provenance: our own test design.
+//!
+//! Gate map (M12.1): covers camcraft_kernel::mesh_redivide,
+//! camcraft_kernel::machining_mesh.
+
+use std::path::PathBuf;
+
+use camcraft_kernel::machining_mesh::machining_mesh;
+use camcraft_kernel::mesh_redivide::{REDIVIDE_MIN_TRIANGLES, REDIVIDE_RATIO};
+use camcraft_kernel::solidcore_impl::SolidcoreKernel;
+use camcraft_kernel::solidcore_step::import_step;
+use solidcore::kernel::CancelToken;
+
+/// Fine enough that the planner gives the twisted patch a runaway count.
+const TOL: f64 = 1e-3;
+
+#[test]
+fn a_wide_twisted_face_keeps_the_planner_division() {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../testdata/models/twisted_flank.step");
+    let bytes = std::fs::read(path).expect("twisted_flank.step");
+    let stop = CancelToken::new();
+    let mut import = import_step(&mut SolidcoreKernel::default(), &bytes, &stop).expect("the solid imports");
+    let solid = import.solids.remove(0);
+    let mesh = machining_mesh(&solid, TOL, &stop).expect("the solid meshes inside the tolerance");
+    let mut per_face = vec![0_usize; mesh.report.faces];
+    mesh.tri_face.iter().for_each(|f| per_face[*f as usize] += 1);
+    let most = per_face.iter().copied().max().unwrap_or(0);
+    // The patch is a candidate (so the measure, not the count, kept it):
+    // a runaway count on a boundary of four straight sides.
+    assert!(most >= REDIVIDE_MIN_TRIANGLES * 2, "the twisted patch holds {most} triangles: {per_face:?}");
+    assert!(most / REDIVIDE_RATIO >= 64, "far more triangles than its boundary needs: {most}");
+    assert!(mesh.report.notes.iter().all(|n| !n.contains("divided over")), "{:?}", mesh.report.notes);
+    assert!(mesh.report.deviation.largest() <= TOL, "{:?}", mesh.report.deviation);
+}
diff --git a/crates/sim/src/verify/first_traverse.rs b/crates/sim/src/verify/first_traverse.rs
new file mode 100644
index 000000000..1d97351ac
--- /dev/null
+++ b/crates/sim/src/verify/first_traverse.rs
@@ -0,0 +1,105 @@
+//! #2901: the first traverse of a milling operation, from an X/Y the machine does not know after a tool change, must ride above the whole start stock and every fixture - our own reading of the shop rule "never traverse through uncut stock or steel" (machine-tool handbooks), no vendor material consulted.
+//!
+//! After a tool change the control does not know where the tool stands
+//! in X/Y. The post sends Z to the plane the path starts on, then X/Y
+//! at that plane: that one traverse can cross any point of the setup.
+//! No line of it is known, so no swept law can judge it. The law here
+//! judges the plane instead: the path's start height must stand at or
+//! over the top of the start stock (the full block, never the
+//! in-process stock, because the line is not known) and the top of each
+//! fixture, all read in the path's own frame (a 3+2 plane reads heights
+//! along its tool axis). A start under either top is one blocking
+//! verdict at move 0 that names both heights.
+
+use super::types::Warning;
+use crate::cl::Toolpath;
+use crate::fixture::FixtureBox;
+use crate::geometry::Point3;
+
+/// The highest point of `b` along the frame's height `z_of` (the
+/// largest of its eight corners: an affine map takes its max there).
+#[must_use]
+pub fn box_top(b: &FixtureBox, z_of: impl Fn(Point3) -> f64) -> f64 {
+    (0..8)
+        .map(|i| {
+            z_of(Point3::new(
+                [b.min.x, b.max.x][(i >> 2) & 1],
+                [b.min.y, b.max.y][(i >> 1) & 1],
+                [b.min.z, b.max.z][i & 1],
+            ))
+        })
+        .fold(f64::NEG_INFINITY, f64::max)
+}
+
+/// The first-traverse law: `stock_top` is the top of the start stock in
+/// the path's frame (`-inf` when there is none), `steel` the fixtures'
+/// boxes in the world, `z_of` the world-to-frame height (`|p| p.z` for
+/// an upright path). `None` when the path's start stands at or over
+/// both tops within `z_tol`, or when the path is empty or its start is
+/// not finite (the non-finite law names that).
+#[must_use]
+pub fn first_traverse_low(
+    path: &Toolpath,
+    stock_top: f64,
+    steel: &[FixtureBox],
+    z_of: impl Fn(Point3) -> f64,
+    z_tol: f64,
+) -> Option<Warning> {
+    let start = path.start()?;
+    if !start.z.is_finite() {
+        return None;
+    }
+    let fixture_top = steel.iter().map(|b| box_top(b, &z_of)).filter(|z| z.is_finite()).fold(f64::NEG_INFINITY, f64::max);
+    let stock_top = if stock_top.is_finite() { stock_top } else { f64::NEG_INFINITY };
+    let (top, fixture) = if fixture_top > stock_top { (fixture_top, true) } else { (stock_top, false) };
+    (top.is_finite() && start.z < top - z_tol).then_some(Warning::FirstTraverseLow { at: 0, height_mm: start.z, top_mm: top, fixture })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::cl::{MoveKind, PathBuilder};
+
+    fn opening(z: f64) -> Toolpath {
+        let mut b = PathBuilder::new(Point3::new(5.0, 5.0, z));
+        b.push(MoveKind::Rapid, Point3::new(5.0, 5.0, 1.0), None);
+        b.push(MoveKind::Plunge, Point3::new(5.0, 5.0, -1.0), Some(100.0));
+        b.finish()
+    }
+
+    fn clamp(top: f64) -> FixtureBox {
+        FixtureBox { min: Point3::new(200.0, 200.0, 0.0), max: Point3::new(210.0, 210.0, top) }
+    }
+
+    #[test]
+    fn a_start_under_the_stock_top_is_named_with_both_heights() {
+        let w = first_traverse_low(&opening(8.0), 10.0, &[], |p| p.z, 1e-6);
+        assert_eq!(w, Some(Warning::FirstTraverseLow { at: 0, height_mm: 8.0, top_mm: 10.0, fixture: false }));
+        assert!(w.is_some_and(|w| w.blocks_post()));
+    }
+
+    #[test]
+    fn a_far_fixture_taller_than_the_start_is_named() {
+        let w = first_traverse_low(&opening(15.0), 10.0, &[clamp(12.0), clamp(20.0)], |p| p.z, 1e-6);
+        assert_eq!(w, Some(Warning::FirstTraverseLow { at: 0, height_mm: 15.0, top_mm: 20.0, fixture: true }));
+    }
+
+    #[test]
+    fn a_start_at_or_over_every_top_passes() {
+        assert_eq!(first_traverse_low(&opening(25.0), 10.0, &[clamp(20.0)], |p| p.z, 1e-6), None);
+        assert_eq!(first_traverse_low(&opening(10.0), 10.0, &[clamp(10.0)], |p| p.z, 1e-6), None);
+        assert_eq!(first_traverse_low(&opening(5.0), f64::NEG_INFINITY, &[], |p| p.z, 1e-6), None);
+        assert_eq!(first_traverse_low(&Toolpath::new(Vec::new()), 10.0, &[], |p| p.z, 1e-6), None);
+        assert_eq!(first_traverse_low(&opening(f64::NAN), 10.0, &[], |p| p.z, 1e-6), None);
+    }
+
+    #[test]
+    fn a_tilted_frame_reads_the_highest_corner_along_its_axis() {
+        // A frame whose height runs along world +X: the clamp's far
+        // face (x 210) is its top there, whatever its Z.
+        let along_x = |p: Point3| p.x;
+        assert_eq!(box_top(&clamp(1.0), along_x), 210.0);
+        let w = first_traverse_low(&opening(150.0), 100.0, &[clamp(1.0)], along_x, 1e-6);
+        assert_eq!(w, Some(Warning::FirstTraverseLow { at: 0, height_mm: 150.0, top_mm: 210.0, fixture: true }));
+    }
+}
