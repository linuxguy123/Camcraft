diff --git a/xtask/tests/example_line_endings.rs b/xtask/tests/example_line_endings.rs
index 662adcb15..617d31bd5 100644
--- a/xtask/tests/example_line_endings.rs
+++ b/xtask/tests/example_line_endings.rs
@@ -79,3 +79,99 @@ fn all_example_nc_files_keep_lf_with_autocrlf() {
         "example NC checkout must preserve LF bytes with core.autocrlf=true: {changed:?}"
     );
 }
+
+#[test]
+fn all_golden_and_fixture_files_have_eol_lf() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap();
+    let patterns = [
+        "crates/*/tests/golden/**",
+        "crates/*/tests/recorded/**",
+        "crates/*/tests/**/*.mch",
+        "assets/machines/**/*.mch",
+        "testdata/**/*.step",
+        "testdata/**/*.stp",
+        ".claude/**",
+        ".github/**",
+    ];
+    let mut args = vec!["ls-files", "-z", "--"];
+    args.extend_from_slice(&patterns);
+    let tracked = git(root, &args);
+    let files: Vec<_> = std::str::from_utf8(&tracked)
+        .unwrap()
+        .split('\0')
+        .filter(|path| !path.is_empty())
+        .collect();
+    assert!(!files.is_empty(), "no tracked golden or fixture files found");
+
+    let mut missing_lf = Vec::new();
+    for file in &files {
+        let attr_out = git(root, &["check-attr", "eol", "--", file]);
+        let line = std::str::from_utf8(&attr_out).unwrap();
+        if !line.ends_with(": eol: lf\n") && !line.ends_with(": eol: lf\r\n") {
+            missing_lf.push((*file, line.trim().to_string()));
+        }
+    }
+    assert!(
+        missing_lf.is_empty(),
+        "golden and fixture files must have 'eol: lf' attribute: {missing_lf:?}"
+    );
+}
+
+#[test]
+fn golden_and_fixture_files_keep_lf_with_autocrlf() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap();
+    let fixtures = [
+        "crates/post/tests/golden/explain/fanuc.nc",
+        "crates/post/tests/golden/explain/haas.nc",
+        "crates/post/tests/golden/explain/mazak.nc",
+        "crates/post/tests/golden/explain/doosan-dnm.nc",
+        "crates/post/tests/golden/explain/fanuc-lathe.nc",
+        "crates/app/tests/edm/wire-iso-fixture.mch",
+        "crates/app/tests/edm/sinker-edm.mch",
+        "assets/machines/vmc.mch",
+        "assets/machines/haas-vf2.mch",
+        "testdata/models/box.step",
+        "testdata/models/Milling-test.step",
+        "testdata/models/sample_ap214.step",
+        ".claude/agents/PR-reviewer.md",
+        ".github/workflows/post-merge.yml",
+    ];
+    let stamp = SystemTime::now()
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let checkout = Checkout(std::env::temp_dir().join(format!(
+        "camcraft-fixture-lf-{}-{stamp}",
+        std::process::id()
+    )));
+    fs::create_dir(&checkout.0).unwrap();
+    git(&checkout.0, &["init", "--quiet", "--template="]);
+    fs::copy(
+        root.join(".gitattributes"),
+        checkout.0.join(".gitattributes"),
+    )
+    .unwrap();
+    for fixture in &fixtures {
+        let target = checkout.0.join(fixture);
+        fs::create_dir_all(target.parent().unwrap()).unwrap();
+        fs::copy(root.join(fixture), &target).unwrap();
+    }
+    git(&checkout.0, &["add", "."]);
+    for fixture in &fixtures {
+        fs::remove_file(checkout.0.join(fixture)).unwrap();
+    }
+    git(&checkout.0, &["checkout-index", "--all", "--force"]);
+
+    let mut changed = Vec::new();
+    for fixture in fixtures {
+        let actual = fs::read(checkout.0.join(fixture)).unwrap();
+        let indexed = git(&checkout.0, &["show", &format!(":{fixture}")]);
+        if actual.contains(&b'\r') || actual != indexed {
+            changed.push(fixture);
+        }
+    }
+    assert!(
+        changed.is_empty(),
+        "fixture checkout must preserve LF bytes with core.autocrlf=true: {changed:?}"
+    );
+}

From cf9242d611b9ce1ab883d5283bd9af48dbeab5e7 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Fri, 20 Nov 2026 18:50:42 +0100
Subject: [PATCH 3/3] test(xtask): check the fixture, STL and OBJ eol rules too

The eol=lf attribute test now covers crates/*/tests/fixtures/**,
testdata/**/*.stl and testdata/**/*.obj, the three rules that it did
not check. A comment in .gitattributes says that the STL rule is for
ASCII STL only. Both come from the review notes on PR #2910.

Refs #2840

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .gitattributes                      | 2 ++
 xtask/tests/example_line_endings.rs | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/.gitattributes b/.gitattributes
index 0c4da7366..166aec6f1 100644
--- a/.gitattributes
+++ b/.gitattributes
@@ -9,6 +9,8 @@ crates/*/tests/**/*.mch text eol=lf
 assets/machines/**/*.mch text eol=lf
 
 # 3D models and test fixtures are parsed with LF line ends.
+# The STL rule is for ASCII STL only: a binary STL fixture needs its own
+# later `-text` line, or Git changes its bytes on `git add`.
 testdata/**/*.step text eol=lf
 testdata/**/*.stp text eol=lf
 testdata/**/*.stl text eol=lf
diff --git a/xtask/tests/example_line_endings.rs b/xtask/tests/example_line_endings.rs
index 617d31bd5..c823944a1 100644
--- a/xtask/tests/example_line_endings.rs
+++ b/xtask/tests/example_line_endings.rs
@@ -86,10 +86,13 @@ fn all_golden_and_fixture_files_have_eol_lf() {
     let patterns = [
         "crates/*/tests/golden/**",
         "crates/*/tests/recorded/**",
+        "crates/*/tests/fixtures/**",
         "crates/*/tests/**/*.mch",
         "assets/machines/**/*.mch",
         "testdata/**/*.step",
         "testdata/**/*.stp",
+        "testdata/**/*.stl",
+        "testdata/**/*.obj",
         ".claude/**",
         ".github/**",
     ];
