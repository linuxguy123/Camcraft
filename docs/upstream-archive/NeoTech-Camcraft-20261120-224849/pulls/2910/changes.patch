+#910=SURFACE_STYLE_FILL_AREA(#911);
+#911=FILL_AREA_STYLE('Aluminum - Satin',(#912));
+#912=FILL_AREA_STYLE_COLOUR('Aluminum - Satin',#913);
+#913=COLOUR_RGB('Aluminum - Satin',0.96078431372549,0.96078431372549,0.964705882352941);
+ENDSEC;
