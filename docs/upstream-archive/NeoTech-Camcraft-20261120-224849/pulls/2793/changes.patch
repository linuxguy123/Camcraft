+            "{}\nfunction onOpen() {{ block([\"{word}\"]); }}\nfunction onClose() {{}}\n",
+            script("tormach-plasma")
+        );
+        let out = engine::run_with(&cps, &Value::Null, "", &json!({"Explain": true}))
+            .expect("plasma word");
