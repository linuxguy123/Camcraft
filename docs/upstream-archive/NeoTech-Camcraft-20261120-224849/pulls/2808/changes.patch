+//! Integer grid primitives and Hertel-Mehlhorn convex polygon decomposition.
+//! Provenance: Hertel-Mehlhorn convex merging over triangulated regions (`Region::triangles`).
+
+use super::types::NestError;
+use crate::geo2d::{Point2, Region, SCALE};
+use std::cmp::Ordering;
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub(crate) struct IPoint {
+    pub x: i64,
+    pub y: i64,
+}
+
+impl IPoint {
+    pub fn from_point2(p: Point2) -> Result<Self, NestError> {
+        if !(p.x.is_finite() && p.y.is_finite()) {
+            return Err(NestError::InvalidInput("non-finite coordinate".into()));
+        }
+        let sx = (p.x * SCALE).round();
+        let sy = (p.y * SCALE).round();
+        if sx.abs() >= (i64::MAX / 4) as f64 || sy.abs() >= (i64::MAX / 4) as f64 {
+            return Err(NestError::OutOfRange(
+                "coordinate exceeds integer grid range".into(),
+            ));
+        }
+        Ok(IPoint {
+            x: sx as i64,
+            y: sy as i64,
+        })
+    }
+
+    pub fn to_point2(self) -> Point2 {
+        Point2::new(self.x as f64 / SCALE, self.y as f64 / SCALE)
+    }
+
+    pub fn add(self, o: Self) -> Result<Self, NestError> {
+        let x = self
+            .x
+            .checked_add(o.x)
+            .ok_or_else(|| NestError::OutOfRange("x overflow".into()))?;
+        let y = self
+            .y
+            .checked_add(o.y)
+            .ok_or_else(|| NestError::OutOfRange("y overflow".into()))?;
+        Ok(IPoint { x, y })
+    }
+
+    pub fn neg(self) -> Result<Self, NestError> {
+        let x = self
+            .x
+            .checked_neg()
+            .ok_or_else(|| NestError::OutOfRange("x overflow".into()))?;
+        let y = self
+            .y
+            .checked_neg()
+            .ok_or_else(|| NestError::OutOfRange("y overflow".into()))?;
+        Ok(IPoint { x, y })
+    }
+}
+
+pub(crate) fn cross_i128(o: IPoint, a: IPoint, b: IPoint) -> i128 {
+    let ax = (a.x as i128) - (o.x as i128);
+    let ay = (a.y as i128) - (o.y as i128);
+    let bx = (b.x as i128) - (o.x as i128);
+    let by = (b.y as i128) - (o.y as i128);
+    ax * by - ay * bx
+}
+
+fn upper_half(dx: i64, dy: i64) -> bool {
+    dy > 0 || (dy == 0 && dx > 0)
+}
+
+pub(crate) fn cmp_edge_angle(e1: (i64, i64), e2: (i64, i64)) -> Ordering {
+    let u1 = upper_half(e1.0, e1.1);
+    let u2 = upper_half(e2.0, e2.1);
+    if u1 != u2 {
+        return if u1 {
+            Ordering::Less
+        } else {
+            Ordering::Greater
+        };
+    }
+    let c = (e1.0 as i128) * (e2.1 as i128) - (e1.1 as i128) * (e2.0 as i128);
+    if c > 0 {
+        Ordering::Less
+    } else if c < 0 {
+        Ordering::Greater
+    } else {
+        Ordering::Equal
+    }
+}
+
+pub(crate) fn clean_ccw_ring(raw: &[IPoint]) -> Vec<IPoint> {
+    let mut pts: Vec<IPoint> = Vec::with_capacity(raw.len());
+    for &p in raw {
+        if pts.last() != Some(&p) {
+            pts.push(p);
+        }
+    }
+    if pts.len() > 1 && pts.first() == pts.last() {
+        pts.pop();
+    }
+    let mut changed = true;
+    while changed && pts.len() >= 3 {
+        changed = false;
+        let mut next_pts = Vec::with_capacity(pts.len());
+        let n = pts.len();
+        for i in 0..n {
+            let a = pts[(i + n - 1) % n];
+            let b = pts[i];
+            let c = pts[(i + 1) % n];
+            let dot = (b.x as i128 - a.x as i128) * (c.x as i128 - b.x as i128)
+                + (b.y as i128 - a.y as i128) * (c.y as i128 - b.y as i128);
+            if cross_i128(a, b, c) == 0 && dot >= 0 {
+                changed = true;
+            } else {
+                next_pts.push(b);
+            }
+        }
+        pts = next_pts;
+    }
+    if pts.len() < 3 {
+        return Vec::new();
+    }
+    let area2: i128 = (0..pts.len())
+        .map(|i| {
+            let a = pts[i];
+            let b = pts[(i + 1) % pts.len()];
+            (a.x as i128) * (b.y as i128) - (b.x as i128) * (a.y as i128)
+        })
+        .sum();
+    if area2 == 0 {
+        return Vec::new();
+    }
+    if area2 < 0 {
+        pts.reverse();
+    }
+    pts
+}
+
+fn is_simple_convex_ccw(pts: &[IPoint]) -> bool {
+    let n = pts.len();
+    if n < 3 {
+        return false;
+    }
+    let uniq: BTreeSet<IPoint> = pts.iter().copied().collect();
+    if uniq.len() != n {
+        return false;
+    }
+    let mut wraps = 0usize;
+    for i in 0..n {
+        let a = pts[i];
+        let b = pts[(i + 1) % n];
+        let c = pts[(i + 2) % n];
+        if cross_i128(a, b, c) < 0 {
+            return false;
+        }
+        let e1 = (b.x - a.x, b.y - a.y);
+        let e2 = (c.x - b.x, c.y - b.y);
+        if e1 == (0, 0) || e2 == (0, 0) {
+            return false;
+        }
+        if cmp_edge_angle(e1, e2) == Ordering::Greater {
+            wraps += 1;
+        }
+    }
+    wraps == 1
+}
+
+/// Decompose a `Region` into non-overlapping CCW convex polygons on the micron grid.
+pub(crate) fn convex_decompose(region: &Region) -> Result<Vec<Vec<IPoint>>, NestError> {
+    if region.is_empty() {
+        return Ok(Vec::new());
+    }
+    if region.loops().len() == 1 {
+        let raw: Vec<IPoint> = region.loops()[0]
+            .points()
+            .iter()
+            .map(|&p| IPoint::from_point2(p))
+            .collect::<Result<_, _>>()?;
+        let ring = clean_ccw_ring(&raw);
+        if is_simple_convex_ccw(&ring) {
+            return Ok(vec![ring]);
+        }
+    }
+
+    let tris = match region.triangles() {
+        Ok(tris) => {
+            let mut out = Vec::with_capacity(tris.len());
+            for tri in tris {
+                let raw = [
+                    IPoint::from_point2(tri[0])?,
+                    IPoint::from_point2(tri[1])?,
+                    IPoint::from_point2(tri[2])?,
+                ];
+                let cleaned = clean_ccw_ring(&raw);
+                if is_simple_convex_ccw(&cleaned) {
+                    out.push(Some(cleaned));
+                }
+            }
+            out
+        }
+        Err(_) => slab_decompose(region)?,
+    };
+    let mut polys: Vec<Option<Vec<IPoint>>> = tris;
+
+    let mut edge_owner: BTreeMap<(IPoint, IPoint), usize> = BTreeMap::new();
+    for (idx, poly) in polys.iter().enumerate() {
+        if let Some(pts) = poly {
+            for k in 0..pts.len() {
+                edge_owner.insert((pts[k], pts[(k + 1) % pts.len()]), idx);
+            }
+        }
+    }
+
+    let mut i = 0usize;
+    while i < polys.len() {
+        let Some(pi) = polys[i].clone() else {
+            i += 1;
+            continue;
+        };
+        let mut merged_any = false;
+        for k in 0..pi.len() {
+            let u = pi[k];
+            let v = pi[(k + 1) % pi.len()];
+            let Some(&j) = edge_owner.get(&(v, u)) else {
+                continue;
+            };
+            if j == i {
+                continue;
+            }
+            let Some(pj) = polys[j].as_ref() else {
+                continue;
+            };
+            let Some(pos_j) = pj
+                .windows(2)
+                .position(|w| w[0] == v && w[1] == u)
+                .or_else(|| {
+                    if pj.last() == Some(&v) && pj.first() == Some(&u) {
+                        Some(pj.len() - 1)
+                    } else {
+                        None
+                    }
+                })
+            else {
+                continue;
+            };
+            let mut combined = Vec::with_capacity(pi.len() + pj.len());
+            for step in 1..pi.len() {
+                combined.push(pi[(k + 1 + step) % pi.len()]);
+            }
+            for step in 1..pj.len() {
+                combined.push(pj[(pos_j + 1 + step) % pj.len()]);
+            }
+            let cleaned = clean_ccw_ring(&combined);
+            if !is_simple_convex_ccw(&cleaned) {
+                continue;
+            }
+            for e in 0..pi.len() {
+                edge_owner.remove(&(pi[e], pi[(e + 1) % pi.len()]));
+            }
+            for e in 0..pj.len() {
+                edge_owner.remove(&(pj[e], pj[(e + 1) % pj.len()]));
+            }
+            for e in 0..cleaned.len() {
+                edge_owner.insert((cleaned[e], cleaned[(e + 1) % cleaned.len()]), i);
+            }
+            polys[i] = Some(cleaned);
+            polys[j] = None;
+            merged_any = true;
+            break;
+        }
+        if !merged_any {
+            i += 1;
+        }
+    }
+
+    Ok(polys.into_iter().flatten().collect())
+}
+
+/// Robust horizontal-slab trapezoidation fallback for multi-hole or pinched regions
+/// where bridge ear-clipping cannot pick a bridge chord.
+fn slab_decompose(region: &Region) -> Result<Vec<Option<Vec<IPoint>>>, NestError> {
+    struct Edge {
+        lo: IPoint,
+        hi: IPoint,
+    }
+    let mut edges = Vec::new();
+    let mut ys = Vec::new();
+    for l in region.loops() {
+        let pts = l.points();
+        let n = pts.len();
+        for i in 0..n {
+            let a = IPoint::from_point2(pts[i])?;
+            let b = IPoint::from_point2(pts[(i + 1) % n])?;
+            ys.push(a.y);
+            if a.y < b.y {
+                edges.push(Edge { lo: a, hi: b });
+            } else if b.y < a.y {
+                edges.push(Edge { lo: b, hi: a });
+            }
+        }
+    }
+    ys.sort_unstable();
+    ys.dedup();
+    let x_at = |e: &Edge, y: f64| -> f64 {
+        let dy = (e.hi.y - e.lo.y) as f64;
+        (e.lo.x as f64) + ((y - (e.lo.y as f64)) / dy) * ((e.hi.x - e.lo.x) as f64)
+    };
+    let x_int = |e: &Edge, y: i64| -> i64 {
+        if y == e.lo.y {
+            e.lo.x
+        } else if y == e.hi.y {
+            e.hi.x
+        } else {
+            x_at(e, y as f64).round() as i64
+        }
+    };
+
+    let mut out = Vec::new();
+    for w in ys.windows(2) {
+        let (y0, y1) = (w[0], w[1]);
+        if y0 >= y1 {
+            continue;
+        }
+        let y_mid = (y0 as f64 + y1 as f64) * 0.5;
+        let mut active: Vec<&Edge> = edges
+            .iter()
+            .filter(|e| e.lo.y <= y0 && e.hi.y >= y1)
+            .collect();
+        active.sort_by(|a, b| x_at(a, y_mid).total_cmp(&x_at(b, y_mid)));
+        for &[left, right] in active.as_chunks::<2>().0 {
+            let mut bl_x = x_int(left, y0);
+            let mut br_x = x_int(right, y0);
+            let mut tl_x = x_int(left, y1);
+            let mut tr_x = x_int(right, y1);
+            if bl_x > br_x {
+                let mid = bl_x + (br_x - bl_x) / 2;
+                bl_x = mid;
+                br_x = mid;
+            }
+            if tl_x > tr_x {
+                let mid = tl_x + (tr_x - tl_x) / 2;
+                tl_x = mid;
+                tr_x = mid;
+            }
+            let quad = [
+                IPoint { x: bl_x, y: y0 },
+                IPoint { x: br_x, y: y0 },
+                IPoint { x: tr_x, y: y1 },
+                IPoint { x: tl_x, y: y1 },
+            ];
+            let cleaned = clean_ccw_ring(&quad);
+            if is_simple_convex_ccw(&cleaned) {
+                out.push(Some(cleaned));
+            }
+        }
+    }
+    Ok(out)
+}
diff --git a/crates/geometry/src/nesting/inflate.rs b/crates/geometry/src/nesting/inflate.rs
new file mode 100644
index 000000000..c590f4795
--- /dev/null
+++ b/crates/geometry/src/nesting/inflate.rs
@@ -0,0 +1,341 @@
+//! Orientation transforms and kerf/gap inflation for 2D nesting parts.
+//! Provenance: kerf/gap inflation rules from CamCraft plasma/router geometry specs (#2156, #2158).
+
+use super::decompose::{IPoint, clean_ccw_ring};
+use super::nfp::region_ibbox;
+use super::types::{ClearanceMode, CutSide, NestError, PartInput, SheetInput};
+use super::validate::{
+    MIN_AREA, candidate_angles, part_err, validate_closed_loops, validate_open_chains,
+};
+use crate::geo2d::{Loop, Point2, Region};
+use std::collections::BTreeSet;
+use std::f64::consts::PI;
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) struct ShapeKey(Vec<Vec<IPoint>>);
+
+#[derive(Clone, Debug)]
+pub(crate) struct PreparedOrientation {
+    pub ori_index: usize,
+    pub angle_deg: f64,
+    pub mirrored: bool,
+    pub outer: Option<Loop>,
+    pub holes: Vec<Loop>,
+    pub open_chains: Vec<Vec<Point2>>,
+    pub net_area: f64,
+    pub cut_footprint: Region,
+    pub sheet_fit_bbox: (IPoint, IPoint),
+    pub inflated_footprint: Region,
+    pub obstacle_footprint: Region,
+    pub hole_usables: Vec<Region>,
+    pub shape_key: ShapeKey,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct PreparedPart {
+    pub id: String,
+    pub quantity: usize,
+    pub sort_area: f64,
+    pub orientations: Vec<PreparedOrientation>,
+}
+
+fn cos_sin_deg(angle_deg: f64) -> (f64, f64) {
+    let rem = angle_deg.rem_euclid(360.0);
+    if (rem - 0.0).abs() < 1e-12 || (rem - 360.0).abs() < 1e-12 {
+        (1.0, 0.0)
+    } else if (rem - 90.0).abs() < 1e-12 {
+        (0.0, 1.0)
+    } else if (rem - 180.0).abs() < 1e-12 {
+        (-1.0, 0.0)
+    } else if (rem - 270.0).abs() < 1e-12 {
+        (0.0, -1.0)
+    } else {
+        let rad = rem * PI / 180.0;
+        (rad.cos(), rad.sin())
+    }
+}
+
+pub(crate) fn transform_point(p: Point2, mirrored: bool, angle_deg: f64) -> Point2 {
+    let mx = if mirrored { -p.x } else { p.x };
+    let (c, s) = cos_sin_deg(angle_deg);
+    Point2::new(mx * c - p.y * s, mx * s + p.y * c)
+}
+
+fn transform_loop(l: &Loop, mirrored: bool, angle_deg: f64) -> Result<Loop, NestError> {
+    let mut pts: Vec<Point2> = l
+        .points()
+        .iter()
+        .map(|&p| transform_point(p, mirrored, angle_deg))
+        .collect();
+    if mirrored {
+        pts.reverse();
+    }
+    Ok(Loop::new(pts)?)
+}
+
+fn distances_for_mode(sheet: &SheetInput, cut_side: CutSide) -> (f64, f64, f64, f64, f64) {
+    let kw = sheet.cut_width;
+    let gap = sheet.part_gap;
+    let outer_cut = match cut_side {
+        CutSide::Outside => kw,
+        CutSide::OnLine => kw * 0.5,
+        CutSide::Inside => 0.0,
+    };
+    let open_cut = match cut_side {
+        CutSide::OnLine => kw * 0.5,
+        CutSide::Outside | CutSide::Inside => kw,
+    };
+    match sheet.clearance_mode {
+        ClearanceMode::SeparateCuts => {
+            let outer_inf = outer_cut + gap * 0.5;
+            let hole_inf = match cut_side {
+                CutSide::OnLine => kw * 0.5 + gap * 0.5,
+                CutSide::Outside | CutSide::Inside => kw + gap * 0.5,
+            };
+            let open_inf = open_cut + gap * 0.5;
+            (outer_cut, outer_inf, hole_inf, open_cut, open_inf)
+        }
+        ClearanceMode::RouterSingleSlot => {
+            let half_gap = gap * 0.5;
+            let open_inf = match cut_side {
+                CutSide::OnLine => half_gap,
+                CutSide::Outside | CutSide::Inside => kw.max(half_gap),
+            };
+            (outer_cut, half_gap, half_gap, open_cut, open_inf)
+        }
+    }
+}
+
+fn canonical_shape_key(region: &Region) -> Result<ShapeKey, NestError> {
+    let Some((lo, _)) = region_ibbox(region)? else {
+        return Ok(ShapeKey(Vec::new()));
+    };
+    let mut loops = Vec::with_capacity(region.loops().len());
+    for l in region.loops() {
+        let mut pts = Vec::with_capacity(l.points().len());
+        for &p in l.points() {
+            let ip = IPoint::from_point2(p)?;
+            pts.push(IPoint {
+                x: ip.x - lo.x,
+                y: ip.y - lo.y,
+            });
+        }
+        let ring = clean_ccw_ring(&pts);
+        if !ring.is_empty() {
+            let min_pos = ring
+                .iter()
+                .enumerate()
+                .min_by_key(|&(_, q)| *q)
+                .map_or(0, |(i, _)| i);
+            let mut rot = Vec::with_capacity(ring.len());
+            rot.extend_from_slice(&ring[min_pos..]);
+            rot.extend_from_slice(&ring[..min_pos]);
+            loops.push(rot);
+        }
+    }
+    loops.sort();
+    Ok(ShapeKey(loops))
+}
+
+fn open_chains_ibbox(chains: &[Vec<Point2>]) -> Result<Option<(IPoint, IPoint)>, NestError> {
+    let mut it = chains.iter().flat_map(|c| c.iter());
+    let Some(&first) = it.next() else {
+        return Ok(None);
+    };
+    let mut lo = IPoint::from_point2(first)?;
+    let mut hi = lo;
+    for &p in it {
+        let ip = IPoint::from_point2(p)?;
+        lo.x = lo.x.min(ip.x);
+        lo.y = lo.y.min(ip.y);
+        hi.x = hi.x.max(ip.x);
+        hi.y = hi.y.max(ip.y);
+    }
+    Ok(Some((lo, hi)))
+}
+
+pub(crate) fn prepare_part(
+    part: &PartInput,
+    sheet: &SheetInput,
+) -> Result<PreparedPart, NestError> {
+    if part.id.trim().is_empty() {
+        return Err(NestError::InvalidInput("part id cannot be empty".into()));
+    }
+    if part.outer.is_none() && part.open_chains.is_empty() {
+        return Err(part_err(
+            &part.id,
+            "part has neither an outer loop nor open chains",
+        ));
+    }
+    if part.outer.is_none() && !part.holes.is_empty() {
+        return Err(part_err(&part.id, "part has holes without an outer loop"));
+    }
+    let clean_chains = validate_open_chains(&part.id, &part.open_chains)?;
+    let (outer_cut, outer_inf, hole_inf, open_cut, open_inf) =
+        distances_for_mode(sheet, part.cut_side);
+    if !clean_chains.is_empty() && open_inf <= 0.0 {
+        return Err(part_err(
+            &part.id,
+            "open chains require positive cut_width or part_gap",
+        ));
+    }
+
+    let (base_outer_area, has_closed) = if part.outer.is_some() {
+        let (outer_reg, _) = validate_closed_loops(part)?;
+        (outer_reg.area().abs(), true)
+    } else {
+        (0.0, false)
+    };
+
+    let angles = candidate_angles(&part.id, part.rotation_mode)?;
+    let mirrors: &[bool] = if part.allow_mirror {
+        &[false, true]
+    } else {
+        &[false]
+    };
+    let mut seen_keys: BTreeSet<(ShapeKey, ShapeKey)> = BTreeSet::new();
+    let mut orientations = Vec::new();
+    let mut sort_area = base_outer_area;
+
+    for &mirrored in mirrors {
+        for &angle_deg in &angles {
+            let t_chains: Vec<Vec<Point2>> = clean_chains
+                .iter()
+                .map(|c| {
+                    c.iter()
+                        .map(|&p| transform_point(p, mirrored, angle_deg))
+                        .collect()
+                })
+                .collect();
+            let swept_cut = if !t_chains.is_empty() && open_cut > 0.0 {
+                Region::sweep(&t_chains, open_cut)?
+            } else {
+                Region::empty()
+            };
+            let swept_inf = if !t_chains.is_empty() {
+                Region::sweep(&t_chains, open_inf)?
+            } else {
+                Region::empty()
+            };
+
+            let (t_outer, t_holes, net_area, cut_fp, inf_fp, obs_fp, hole_usables) = if has_closed {
+                let outer_ref = part
+                    .outer
+                    .as_ref()
+                    .ok_or_else(|| part_err(&part.id, "missing outer"))?;
+                let lo = transform_loop(outer_ref, mirrored, angle_deg)?;
+                let lh: Vec<Loop> = part
+                    .holes
+                    .iter()
+                    .map(|h| transform_loop(h, mirrored, angle_deg))
+                    .collect::<Result<_, _>>()?;
+                let mut all_loops = Vec::with_capacity(1 + lh.len());
+                all_loops.push(lo.clone());
+                all_loops.extend(lh.iter().cloned());
+                let nominal = Region::new(all_loops)?;
+                let outer_only = Region::new(vec![lo.clone()])?;
+                let net_area = nominal.area().abs();
+
+                let closed_cut = if outer_cut > 0.0 {
+                    nominal.offset_sharp(outer_cut)?
+                } else {
+                    nominal.clone()
+                };
+                let cut_fp = if swept_cut.is_empty() {
+                    closed_cut
+                } else {
+                    closed_cut.union(&swept_cut)?
+                };
+
+                let outer_filled_inf = if outer_inf > 0.0 {
+                    outer_only.offset_sharp(outer_inf)?
+                } else {
+                    outer_only
+                };
+                let obs_fp = if swept_inf.is_empty() {
+                    outer_filled_inf.clone()
+                } else {
+                    outer_filled_inf.union(&swept_inf)?
+                };
+
+                let mut usable_holes = Vec::new();
+                let mut all_holes_usable = Region::empty();
+                for h in &lh {
+                    let hr = Region::new(vec![h.clone()])?;
+                    let shrunk = if hole_inf > 0.0 {
+                        hr.offset_sharp(-hole_inf)?
+                    } else {
+                        hr
+                    };
+                    let hu = if swept_inf.is_empty() || shrunk.is_empty() {
+                        shrunk
+                    } else {
+                        shrunk.difference(&swept_inf)?
+                    };
+                    if !hu.is_empty() && hu.area() > MIN_AREA {
+                        all_holes_usable = all_holes_usable.union(&hu)?;
+                        if sheet.allow_parts_in_holes {
+                            usable_holes.push(hu);
+                        }
+                    }
+                }
+                let closed_inf = if all_holes_usable.is_empty() {
+                    outer_filled_inf
+                } else {
+                    outer_filled_inf.difference(&all_holes_usable)?
+                };
+                let inf_fp = if swept_inf.is_empty() {
+                    closed_inf
+                } else {
+                    closed_inf.union(&swept_inf)?
+                };
+                (Some(lo), lh, net_area, cut_fp, inf_fp, obs_fp, usable_holes)
+            } else {
+                sort_area = sort_area.max(swept_inf.area());
+                (
+                    None,
+                    Vec::new(),
+                    0.0,
+                    swept_cut,
+                    swept_inf.clone(),
+                    swept_inf,
+                    Vec::new(),
+                )
+            };
+
+            let sheet_fit_bbox = if let Some(b) = region_ibbox(&cut_fp)? {
+                b
+            } else if let Some(b) = open_chains_ibbox(&t_chains)? {
+                b
+            } else {
+                (IPoint { x: 0, y: 0 }, IPoint { x: 0, y: 0 })
+            };
+            let key_pair = (canonical_shape_key(&obs_fp)?, canonical_shape_key(&cut_fp)?);
+            if !seen_keys.insert(key_pair.clone()) {
+                continue;
+            }
+            orientations.push(PreparedOrientation {
+                ori_index: orientations.len(),
+                angle_deg,
+                mirrored,
+                outer: t_outer,
+                holes: t_holes,
+                open_chains: t_chains,
+                net_area,
+                cut_footprint: cut_fp,
+                sheet_fit_bbox,
+                inflated_footprint: inf_fp,
+                obstacle_footprint: obs_fp,
+                hole_usables,
+                shape_key: key_pair.0,
+            });
+        }
+    }
+
+    Ok(PreparedPart {
+        id: part.id.clone(),
+        quantity: part.quantity,
+        sort_area,
+        orientations,
+    })
+}
diff --git a/crates/geometry/src/nesting/nfp.rs b/crates/geometry/src/nesting/nfp.rs
new file mode 100644
index 000000000..7cbd3b363
--- /dev/null
+++ b/crates/geometry/src/nesting/nfp.rs
@@ -0,0 +1,370 @@
+//! Exact NFP/IFP computation on the geo2d::SCALE integer grid via convex Minkowski sums.
+//! Provenance: Minkowski sum over convex decompositions (Bennell & Oliveira, EJOR 2008; Burke et al., EJOR 2007).
+
+use super::decompose::{IPoint, clean_ccw_ring, cmp_edge_angle, convex_decompose, cross_i128};
+use super::types::NestError;
+use crate::geo2d::{Loop, Point2, Region};
+use std::cmp::Ordering;
+
+#[derive(Clone, Debug)]
+pub(crate) struct NfpWithSeams {
+    pub region: Region,
+    /// Exact zero-slack fit vertices/segments swallowed inside merged Minkowski pieces.
+    pub seam_points: Vec<IPoint>,
+    pub seam_segments: Vec<(IPoint, IPoint)>,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct IfpResult {
+    /// Positive-area feasible interior (empty when exact-fit collapses to 1D/0D).
+    pub region: Region,
+    /// Bounding-box IFP `[rx0..=rx1] x [ry0..=ry1]` on the micron grid.
+    pub bbox: (IPoint, IPoint),
+    pub seam_points: Vec<IPoint>,
+    pub seam_segments: Vec<(IPoint, IPoint)>,
+}
+
+fn rotate_min_yx(pts: &[IPoint]) -> Vec<IPoint> {
+    let min_idx = pts
+        .iter()
+        .enumerate()
+        .min_by_key(|&(_, p)| (p.y, p.x))
+        .map_or(0, |(idx, _)| idx);
+    let mut out = Vec::with_capacity(pts.len());
+    out.extend_from_slice(&pts[min_idx..]);
+    out.extend_from_slice(&pts[..min_idx]);
+    out
+}
+
+/// Exact Minkowski sum `P + Q` of two CCW convex integer polygons.
+fn minkowski_convex(p_raw: &[IPoint], q_raw: &[IPoint]) -> Result<Vec<IPoint>, NestError> {
+    let p = rotate_min_yx(p_raw);
+    let q = rotate_min_yx(q_raw);
+    let (m, n) = (p.len(), q.len());
+    let mut out = Vec::with_capacity(m + n);
+    let (mut i, mut j) = (0usize, 0usize);
+    while i < m || j < n {
+        out.push(p[i % m].add(q[j % n])?);
+        if i == m {
+            j += 1;
+        } else if j == n {
+            i += 1;
+        } else {
+            let ep = (p[(i + 1) % m].x - p[i % m].x, p[(i + 1) % m].y - p[i % m].y);
+            let eq = (q[(j + 1) % n].x - q[j % n].x, q[(j + 1) % n].y - q[j % n].y);
+            match cmp_edge_angle(ep, eq) {
+                Ordering::Less => i += 1,
+                Ordering::Greater => j += 1,
+                Ordering::Equal => {
+                    i += 1;
+                    j += 1;
+                }
+            }
+        }
+    }
+    Ok(clean_ccw_ring(&out))
+}
+
+fn ring_to_loop(ring: &[IPoint]) -> Result<Loop, NestError> {
+    Ok(Loop::new(ring.iter().map(|p| p.to_point2()).collect())?)
+}
+
+fn ring_bbox(ring: &[IPoint]) -> (IPoint, IPoint) {
+    let mut lo = ring[0];
+    let mut hi = lo;
+    for &p in &ring[1..] {
+        lo.x = lo.x.min(p.x);
+        lo.y = lo.y.min(p.y);
+        hi.x = hi.x.max(p.x);
+        hi.y = hi.y.max(p.y);
+    }
+    (lo, hi)
+}
+
+fn boxes_touch_or_overlap(a: (IPoint, IPoint), b: (IPoint, IPoint)) -> bool {
+    a.1.x >= b.0.x && b.1.x >= a.0.x && a.1.y >= b.0.y && b.1.y >= a.0.y
+}
+
+fn strictly_inside_convex_ccw(ring: &[IPoint], p: IPoint) -> bool {
+    let n = ring.len();
+    for i in 0..n {
+        if cross_i128(ring[i], ring[(i + 1) % n], p) <= 0 {
+            return false;
+        }
+    }
+    true
+}
+
+pub(crate) fn segment_intersections(
+    a0: IPoint,
+    a1: IPoint,
+    b0: IPoint,
+    b1: IPoint,
+    out: &mut Vec<IPoint>,
+) {
+    if a0.x.max(a1.x) < b0.x.min(b1.x)
+        || b0.x.max(b1.x) < a0.x.min(a1.x)
+        || a0.y.max(a1.y) < b0.y.min(b1.y)
+        || b0.y.max(b1.y) < a0.y.min(a1.y)
+    {
+        return;
+    }
+    let rx = (a1.x as i128) - (a0.x as i128);
+    let ry = (a1.y as i128) - (a0.y as i128);
+    let sx = (b1.x as i128) - (b0.x as i128);
+    let sy = (b1.y as i128) - (b0.y as i128);
+    let denom = rx * sy - ry * sx;
+    let qpx = (b0.x as i128) - (a0.x as i128);
+    let qpy = (b0.y as i128) - (a0.y as i128);
+    let t_num = qpx * sy - qpy * sx;
+    let u_num = qpx * ry - qpy * rx;
+
+    if denom == 0 {
+        if u_num != 0 {
+            return;
+        }
+        let on_box = |p: IPoint, u: IPoint, v: IPoint| {
+            p.x >= u.x.min(v.x) && p.x <= u.x.max(v.x) && p.y >= u.y.min(v.y) && p.y <= u.y.max(v.y)
+        };
+        for p in [a0, a1] {
+            if on_box(p, b0, b1) {
+                out.push(p);
+            }
+        }
+        for p in [b0, b1] {
+            if on_box(p, a0, a1) {
+                out.push(p);
+            }
+        }
+        return;
+    }
+
+    let in_01 = |num: i128| {
+        if denom > 0 {
+            num >= 0 && num <= denom
+        } else {
+            num <= 0 && num >= denom
+        }
+    };
+    if !in_01(t_num) || !in_01(u_num) {
+        return;
+    }
+    if t_num == 0 {
+        out.push(a0);
+    } else if t_num == denom {
+        out.push(a1);
+    } else if u_num == 0 {
+        out.push(b0);
+    } else if u_num == denom {
+        out.push(b1);
+    } else {
+        let t = (t_num as f64) / (denom as f64);
+        let x = a0.x + (t * (rx as f64)).round() as i64;
+        let y = a0.y + (t * (ry as f64)).round() as i64;
+        out.push(IPoint { x, y });
+    }
+}
+
+fn find_internal_seams(
+    rings: &[Vec<IPoint>],
+    nfp: &Region,
+) -> (Vec<IPoint>, Vec<(IPoint, IPoint)>) {
+    if rings.len() <= 1 || nfp.is_empty() {
+        return (Vec::new(), Vec::new());
+    }
+    let boxes: Vec<(IPoint, IPoint)> = rings.iter().map(|r| ring_bbox(r)).collect();
+    let mut raw_pts = Vec::new();
+    let mut seam_segs = Vec::new();
+
+    for i in 0..rings.len() {
+        for &p in &rings[i] {
+            raw_pts.push(p);
+        }
+        for j in (i + 1)..rings.len() {
+            if !boxes_touch_or_overlap(boxes[i], boxes[j]) {
+                continue;
+            }
+            let ri = &rings[i];
+            let rj = &rings[j];
+            for ei in 0..ri.len() {
+                let (a0, a1) = (ri[ei], ri[(ei + 1) % ri.len()]);
+                for ej in 0..rj.len() {
+                    let (b0, b1) = (rj[ej], rj[(ej + 1) % rj.len()]);
+                    let before = raw_pts.len();
+                    segment_intersections(a0, a1, b0, b1, &mut raw_pts);
+                    // Opposite-direction collinear overlap creates a potential zero-width seam.
+                    let ax = (a1.x as i128) - (a0.x as i128);
+                    let ay = (a1.y as i128) - (a0.y as i128);
+                    let bx = (b1.x as i128) - (b0.x as i128);
+                    let by = (b1.y as i128) - (b0.y as i128);
+                    if ax * by - ay * bx == 0
+                        && ax * bx + ay * by < 0
+                        && raw_pts.len() >= before + 2
+                    {
+                        let mut seg_pts = raw_pts[before..].to_vec();
+                        seg_pts.sort_unstable();
+                        seg_pts.dedup();
+                        if seg_pts.len() >= 2 {
+                            let p_lo = seg_pts[0];
+                            let p_hi = seg_pts[seg_pts.len() - 1];
+                            let mid = IPoint {
+                                x: p_lo.x + (p_hi.x - p_lo.x) / 2,
+                                y: p_lo.y + (p_hi.y - p_lo.y) / 2,
+                            };
+                            if !rings.iter().enumerate().any(|(k, r)| {
+                                boxes[k].0.x <= mid.x
+                                    && boxes[k].1.x >= mid.x
+                                    && boxes[k].0.y <= mid.y
+                                    && boxes[k].1.y >= mid.y
+                                    && strictly_inside_convex_ccw(r, mid)
+                            }) {
+                                seam_segs.push((p_lo, p_hi));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    raw_pts.sort_unstable();
+    raw_pts.dedup();
+    raw_pts.retain(|&p| {
+        if !nfp.contains(p.to_point2()) {
+            return false;
+        }
+        !rings.iter().enumerate().any(|(k, r)| {
+            boxes[k].0.x < p.x
+                && boxes[k].1.x > p.x
+                && boxes[k].0.y < p.y
+                && boxes[k].1.y > p.y
+                && strictly_inside_convex_ccw(r, p)
+        })
+    });
+    (raw_pts, seam_segs)
+}
+
+/// Exact No-Fit Polygon `NFP(A, B) = A + (-B)` on the micron grid, preserving zero-width seams.
+pub(crate) fn compute_nfp(a: &Region, b: &Region) -> Result<NfpWithSeams, NestError> {
+    if a.is_empty() || b.is_empty() {
+        return Ok(NfpWithSeams {
+            region: Region::empty(),
+            seam_points: Vec::new(),
+            seam_segments: Vec::new(),
+        });
+    }
+    let pa = convex_decompose(a)?;
+    let pb = convex_decompose(b)?;
+    let mut neg_b = Vec::with_capacity(pb.len());
+    for piece in &pb {
+        let mut neg = Vec::with_capacity(piece.len());
+        for &pt in piece {
+            neg.push(pt.neg()?);
+        }
+        neg_b.push(clean_ccw_ring(&neg));
+    }
+    let mut sum_rings = Vec::with_capacity(pa.len() * neg_b.len());
+    let mut loops = Vec::with_capacity(pa.len() * neg_b.len());
+    for ca in &pa {
+        for cb in &neg_b {
+            let sum = minkowski_convex(ca, cb)?;
+            if sum.len() >= 3 {
+                loops.push(ring_to_loop(&sum)?);
+                sum_rings.push(sum);
+            }
+        }
+    }
+    if loops.is_empty() {
+        return Ok(NfpWithSeams {
+            region: Region::empty(),
+            seam_points: Vec::new(),
+            seam_segments: Vec::new(),
+        });
+    }
+    let region = Region::union_all(loops)?;
+    let (seam_points, seam_segments) = find_internal_seams(&sum_rings, &region);
+    Ok(NfpWithSeams {
+        region,
+        seam_points,
+        seam_segments,
+    })
+}
+
+pub(crate) fn region_ibbox(r: &Region) -> Result<Option<(IPoint, IPoint)>, NestError> {
+    let Some((lo, hi)) = r.bounds() else {
+        return Ok(None);
+    };
+    Ok(Some((IPoint::from_point2(lo)?, IPoint::from_point2(hi)?)))
+}
+
+pub(crate) fn rect_region_from_ipoints(lo: IPoint, hi: IPoint) -> Result<Region, NestError> {
+    let (a, b) = (lo.to_point2(), hi.to_point2());
+    Ok(Region::new(vec![Loop::new(vec![
+        Point2::new(a.x, a.y),
+        Point2::new(b.x, a.y),
+        Point2::new(b.x, b.y),
+        Point2::new(a.x, b.y),
+    ])?])?)
+}
+
+/// Inner-Fit Polygon `IFP(container, part)` returning feasible reference positions.
+pub(crate) fn compute_ifp(
+    container: &Region,
+    part: &Region,
+    is_rect_container: bool,
+) -> Result<Option<IfpResult>, NestError> {
+    let Some((c0, c1)) = region_ibbox(container)? else {
+        return Ok(None);
+    };
+    let Some((p0, p1)) = region_ibbox(part)? else {
+        return Ok(None);
+    };
+    let rx0 = c0.x - p0.x;
+    let rx1 = c1.x - p1.x;
+    let ry0 = c0.y - p0.y;
+    let ry1 = c1.y - p1.y;
+    if rx0 > rx1 || ry0 > ry1 {
+        return Ok(None);
+    }
+    let bbox = (IPoint { x: rx0, y: ry0 }, IPoint { x: rx1, y: ry1 });
+    if is_rect_container {
+        let region = if rx0 < rx1 && ry0 < ry1 {
+            rect_region_from_ipoints(bbox.0, bbox.1)?
+        } else {
+            Region::empty()
+        };
+        return Ok(Some(IfpResult {
+            region,
+            bbox,
+            seam_points: Vec::new(),
+            seam_segments: Vec::new(),
+        }));
+    }
+
+    let pw = p1.x - p0.x;
+    let ph = p1.y - p0.y;
+    let pad = pw.max(ph).saturating_add(10_000_000);
+    let frame = rect_region_from_ipoints(
+        IPoint {
+            x: c0.x.saturating_sub(pad),
+            y: c0.y.saturating_sub(pad),
+        },
+        IPoint {
+            x: c1.x.saturating_add(pad),
+            y: c1.y.saturating_add(pad),
+        },
+    )?;
+    let comp = frame.difference(container)?;
+    let nfp_comp = compute_nfp(&comp, part)?;
+    let region = if rx0 < rx1 && ry0 < ry1 {
+        rect_region_from_ipoints(bbox.0, bbox.1)?.difference(&nfp_comp.region)?
+    } else {
+        Region::empty()
+    };
+    Ok(Some(IfpResult {
+        region,
+        bbox,
+        seam_points: nfp_comp.seam_points,
+        seam_segments: nfp_comp.seam_segments,
+    }))
+}
diff --git a/crates/geometry/src/nesting/types.rs b/crates/geometry/src/nesting/types.rs
new file mode 100644
index 000000000..f9cc54f6b
--- /dev/null
+++ b/crates/geometry/src/nesting/types.rs
@@ -0,0 +1,203 @@
+//! Public input, error, and report types for 2D true-shape nesting.
+//! Provenance: our own domain types specced for #2158 from published nesting literature (Bennell & Oliveira 2008; Burke et al. 2006).
+
+use crate::geo2d::{GeoError, Loop, Point2, Region};
+use std::collections::BTreeMap;
+use thiserror::Error;
+
+/// Spacing rule between adjacent cuts on a sheet.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ClearanceMode {
+    /// Separate kerf per part: uncut material between adjacent cut edges is at least `part_gap`.
+    #[default]
+    SeparateCuts,
+    /// Router single-slot mode (`part_gap >= cut_width`): adjacent `Outside` profiles share a single cutter-width channel.
+    RouterSingleSlot,
+}
+
+/// Default side on which the cutter runs relative to a profile loop.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum CutSide {
+    #[default]
+    Outside,
+    OnLine,
+    Inside,
+}
+
+/// Allowed rotation angles for placing a part.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub enum RotationMode {
+    /// Keep 0 degrees only (e.g. grain direction or printed face).
+    Locked,
+    /// Allow 0, 90, 180, and 270 degree orientations.
+    #[default]
+    Orthogonal,
+    /// Allow increments of `deg` degrees in `[0, 360)`.
+    FixedStep(f64),
+}
+
+/// Rectangular sheet specification and cut-clearance parameters (millimetres).
+#[derive(Clone, Debug, PartialEq)]
+pub struct SheetInput {
+    pub width: f64,
+    pub height: f64,
+    pub edge_margin: f64,
+    /// Kerf width (waterjet/plasma/laser) or cutter diameter (router).
+    pub cut_width: f64,
+    pub part_gap: f64,
+    pub allow_parts_in_holes: bool,
+    pub clearance_mode: ClearanceMode,
+}
+
+impl Default for SheetInput {
+    fn default() -> Self {
+        SheetInput {
+            width: 0.0,
+            height: 0.0,
+            edge_margin: 0.0,
+            cut_width: 0.0,
+            part_gap: 0.0,
+            allow_parts_in_holes: true,
+            clearance_mode: ClearanceMode::SeparateCuts,
+        }
+    }
+}
+
+/// One 2D part definition with quantity, geometry, cut side, and orientation rules.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PartInput {
+    pub id: String,
+    pub quantity: usize,
+    pub outer: Option<Loop>,
+    pub holes: Vec<Loop>,
+    pub open_chains: Vec<Vec<Point2>>,
+    pub cut_side: CutSide,
+    pub rotation_mode: RotationMode,
+    pub allow_mirror: bool,
+}
+
+impl PartInput {
+    /// Create a closed part with an outer loop and optional hole loops.
+    pub fn closed(id: impl Into<String>, quantity: usize, outer: Loop, holes: Vec<Loop>) -> Self {
+        PartInput {
+            id: id.into(),
+            quantity,
+            outer: Some(outer),
+            holes,
+            open_chains: Vec::new(),
+            cut_side: CutSide::Outside,
+            rotation_mode: RotationMode::Orthogonal,
+            allow_mirror: false,
+        }
+    }
+
+    /// Create a standalone open-chain part with no closed outer loop.
+    pub fn open(id: impl Into<String>, quantity: usize, open_chains: Vec<Vec<Point2>>) -> Self {
+        PartInput {
+            id: id.into(),
+            quantity,
+            outer: None,
+            holes: Vec::new(),
+            open_chains,
+            cut_side: CutSide::OnLine,
+            rotation_mode: RotationMode::Orthogonal,
+            allow_mirror: false,
+        }
+    }
+
+    pub fn with_cut_side(mut self, cut_side: CutSide) -> Self {
+        self.cut_side = cut_side;
+        self
+    }
+
+    pub fn with_rotation(mut self, rotation_mode: RotationMode) -> Self {
+        self.rotation_mode = rotation_mode;
+        self
+    }
+
+    pub fn with_mirror(mut self, allow_mirror: bool) -> Self {
+        self.allow_mirror = allow_mirror;
+        self
+    }
+
+    pub fn with_open_chains(mut self, open_chains: Vec<Vec<Point2>>) -> Self {
+        self.open_chains = open_chains;
+        self
+    }
+}
+
+#[derive(Clone, Error, Debug, PartialEq)]
+pub enum NestError {
+    #[error("invalid nesting input: {0}")]
+    InvalidInput(String),
+    #[error("nesting input out of machinable range: {0}")]
+    OutOfRange(String),
+    #[error("invalid part '{part_id}': {reason}")]
+    InvalidPart { part_id: String, reason: String },
+    #[error("nesting geometry error: {0}")]
+    Geometry(#[from] GeoError),
+    #[error("unplaced parts remain: {0}")]
+    Unplaced(String),
+}
+
+/// One placed instance on a sheet.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PlacedPart {
+    pub part_id: String,
+    pub instance_index: usize,
+    pub tx: f64,
+    pub ty: f64,
+    pub angle_deg: f64,
+    pub mirrored: bool,
+    /// Set when placed inside a closed hole of another placed part `(host_id, host_instance)`.
+    pub container_part: Option<(String, usize)>,
+    pub net_area: f64,
+    pub outer: Option<Loop>,
+    pub holes: Vec<Loop>,
+    pub open_chains: Vec<Vec<Point2>>,
+    pub cut_footprint: Region,
+    pub inflated_footprint: Region,
+}
+
+/// Nesting output for one physical sheet.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SheetPlacement {
+    pub sheet_index: usize,
+    pub placements: Vec<PlacedPart>,
+    pub placed_counts: BTreeMap<String, usize>,
+    pub utilization_pct: f64,
+    pub waste_region: Region,
+    pub used_bounds: Option<(Point2, Point2)>,
+    pub usable_sheet: Region,
+}
+
+/// Summary of parts that could not fit on any sheet, with named reasons.
+#[derive(Clone, Debug, PartialEq)]
+pub struct UnplacedPart {
+    pub part_id: String,
+    pub quantity: usize,
+    pub reason: String,
+}
+
+/// Full deterministic nesting report across all allocated sheets.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct NestReport {
+    pub sheet_count: usize,
+    pub sheets: Vec<SheetPlacement>,
+    pub total_requested: usize,
+    pub total_placed: usize,
+    pub requested_counts: BTreeMap<String, usize>,
+    pub placed_counts: BTreeMap<String, usize>,
+    pub overall_utilization_pct: f64,
+    pub unplaced: Vec<UnplacedPart>,
+}
+
+impl NestReport {
+    /// Return `Err(NestError::Unplaced)` naming the first unplaced part if any remain.
+    pub fn strict(self) -> Result<Self, NestError> {
+        if let Some(first) = self.unplaced.first() {
+            return Err(NestError::Unplaced(first.reason.clone()));
+        }
+        Ok(self)
+    }
+}
