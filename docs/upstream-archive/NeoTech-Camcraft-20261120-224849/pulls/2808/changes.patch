diff --git a/crates/geometry/src/nesting.rs b/crates/geometry/src/nesting.rs
index 0929a31db..c358c14e6 100644
--- a/crates/geometry/src/nesting.rs
+++ b/crates/geometry/src/nesting.rs
@@ -1,9 +1,338 @@
-//! Nesting building blocks: the CPU raster filter of the raster nest (#2525).
-//!
-//! Provenance: the raster ("no-fit raster") method of the nesting literature -
-//! Bennell and Oliveira, "The geometry of nesting problems: a tutorial", EJOR
-//! 2008 - and the conservative-coverage rules of research comment 2 on #2525.
-//! Nothing here reaches posted output or a verdict: a raster only filters
-//! candidates, and the exact `geo2d` check decides.
+//! Deterministic 2D true-shape nesting kernel (NFP/IFP and bottom-left-fill, #2158).
+//! Provenance: Bennell & Oliveira (EJOR 2008); Burke, Hellier, Kendall & Whitwell (OR 2006, EJOR 2007).
 
 pub mod raster;
+
+mod blf;
+mod candidates;
+mod decompose;
+mod inflate;
+mod nfp;
+pub mod types;
+mod validate;
+
+pub use types::*;
+
+use crate::geo2d::{Point2, Region};
+use blf::{NfpCache, PlacementHit, find_best_placement};
+use candidates::{ContainerKind, Obstacle, translate_loop, translate_region};
+use decompose::IPoint;
+use inflate::{PreparedOrientation, PreparedPart, prepare_part};
+use nfp::region_ibbox;
+use std::collections::{BTreeMap, BTreeSet};
+use validate::{SheetSpec, validate_sheet};
+
+struct HoleSlot {
+    host_id: String,
+    host_instance: usize,
+    region: Region,
+    obstacles: Vec<Obstacle>,
+}
+
+struct ActiveSheet {
+    usable_bbox: (IPoint, IPoint),
+    outer_obstacles: Vec<Obstacle>,
+    holes: Vec<HoleSlot>,
+    placements: Vec<PlacedPart>,
+    placed_counts: BTreeMap<String, usize>,
+    cut_footprints: Vec<Region>,
+    net_area_sum: f64,
+}
+
+impl ActiveSheet {
+    fn new(spec: &SheetSpec) -> Self {
+        ActiveSheet {
+            usable_bbox: spec.usable_bbox,
+            outer_obstacles: Vec::new(),
+            holes: Vec::new(),
+            placements: Vec::new(),
+            placed_counts: BTreeMap::new(),
+            cut_footprints: Vec::new(),
+            net_area_sum: 0.0,
+        }
+    }
+}
+
+fn record_placed(
+    sheet: &mut ActiveSheet,
+    part_id: &str,
+    instance_index: usize,
+    ori: &PreparedOrientation,
+    offset: IPoint,
+    container_part: Option<(String, usize)>,
+) -> Result<(), NestError> {
+    let shift = offset.to_point2();
+    let outer = ori
+        .outer
+        .as_ref()
+        .map(|l| translate_loop(l, offset))
+        .transpose()?;
+    let holes = ori
+        .holes
+        .iter()
+        .map(|h| translate_loop(h, offset))
+        .collect::<Result<Vec<_>, _>>()?;
+    let open_chains: Vec<Vec<Point2>> = ori
+        .open_chains
+        .iter()
+        .map(|c| {
+            c.iter()
+                .map(|p| Point2::new(p.x + shift.x, p.y + shift.y))
+                .collect()
+        })
+        .collect();
+    let cut_footprint = translate_region(&ori.cut_footprint, offset)?;
+    let inflated_footprint = translate_region(&ori.inflated_footprint, offset)?;
+
+    for hu in &ori.hole_usables {
+        let shifted_hu = translate_region(hu, offset)?;
+        if !shifted_hu.is_empty() {
+            sheet.holes.push(HoleSlot {
+                host_id: part_id.to_string(),
+                host_instance: instance_index,
+                region: shifted_hu,
+                obstacles: Vec::new(),
+            });
+        }
+    }
+
+    if !cut_footprint.is_empty() {
+        sheet.cut_footprints.push(cut_footprint.clone());
+    }
+    sheet.net_area_sum += ori.net_area;
+    *sheet.placed_counts.entry(part_id.to_string()).or_insert(0) += 1;
+    sheet.placements.push(PlacedPart {
+        part_id: part_id.to_string(),
+        instance_index,
+        tx: shift.x,
+        ty: shift.y,
+        angle_deg: ori.angle_deg,
+        mirrored: ori.mirrored,
+        container_part,
+        net_area: ori.net_area,
+        outer,
+        holes,
+        open_chains,
+        cut_footprint,
+        inflated_footprint,
+    });
+    Ok(())
+}
+
+fn make_obstacle(ori: &PreparedOrientation, offset: IPoint) -> Result<Obstacle, NestError> {
+    let base = &ori.obstacle_footprint;
+    let placed_region = translate_region(base, offset)?;
+    let placed_bbox = region_ibbox(&placed_region)?.unwrap_or((offset, offset));
+    Ok(Obstacle {
+        shape_key: ori.shape_key.clone(),
+        base_region: base.clone(),
+        placed_offset: offset,
+        placed_region,
+        placed_bbox,
+    })
+}
+
+fn fits_empty_sheet(
+    part: &PreparedPart,
+    spec: &SheetSpec,
+    cache: &mut NfpCache,
+) -> Result<Option<PlacementHit>, NestError> {
+    find_best_placement(
+        &part.orientations,
+        ContainerKind::RectSheet {
+            usable_bbox: spec.usable_bbox,
+        },
+        &[],
+        cache,
+    )
+}
+
+fn oversized_reason(part: &PreparedPart, spec: &SheetSpec) -> String {
+    let uw = (spec.usable_bbox.1.x - spec.usable_bbox.0.x) as f64 / crate::geo2d::SCALE;
+    let uh = (spec.usable_bbox.1.y - spec.usable_bbox.0.y) as f64 / crate::geo2d::SCALE;
+    if let Some(first) = part.orientations.first() {
+        let pw = (first.sheet_fit_bbox.1.x - first.sheet_fit_bbox.0.x) as f64 / crate::geo2d::SCALE;
+        let ph = (first.sheet_fit_bbox.1.y - first.sheet_fit_bbox.0.y) as f64 / crate::geo2d::SCALE;
+        format!(
+            "part '{}' ({pw:.3} x {ph:.3} mm with cut clearance) exceeds usable sheet ({uw:.3} x {uh:.3} mm) in all allowed orientations",
+            part.id
+        )
+    } else {
+        format!(
+            "part '{}' has no feasible orientation on usable sheet ({uw:.3} x {uh:.3} mm)",
+            part.id
+        )
+    }
+}
+
+fn union_all_cuts(cuts: &[Region]) -> Result<Region, NestError> {
+    match cuts.len() {
+        0 => Ok(Region::empty()),
+        1 => Ok(cuts[0].clone()),
+        n => {
+            let (l, r) = cuts.split_at(n / 2);
+            let ul = union_all_cuts(l)?;
+            let ur = union_all_cuts(r)?;
+            Ok(ul.union(&ur)?)
+        }
+    }
+}
+
+/// Nest 2D parts onto rectangular sheets using exact NFP/IFP and deterministic bottom-left-fill.
+/// Refuses requests above 10,000 total instances to bound placement work and report allocation.
+pub fn nest(sheet: &SheetInput, parts: &[PartInput]) -> Result<NestReport, NestError> {
+    let spec = validate_sheet(sheet)?;
+    let mut seen_ids = BTreeSet::new();
+    let mut prepared = Vec::with_capacity(parts.len());
+    let mut requested_counts = BTreeMap::new();
+    let mut total_requested = 0usize;
+
+    for p in parts {
+        if !seen_ids.insert(p.id.clone()) {
+            return Err(NestError::InvalidInput(format!(
+                "duplicate part id '{}'",
+                p.id
+            )));
+        }
+        total_requested = total_requested.checked_add(p.quantity).ok_or_else(|| {
+            NestError::InvalidInput(format!(
+                "part '{}' quantity overflows requested total",
+                p.id
+            ))
+        })?;
+        if total_requested > 10_000 {
+            return Err(NestError::InvalidInput(format!(
+                "part '{}' quantity exceeds the nesting limit of 10000 requested instances",
+                p.id
+            )));
+        }
+        let prep = prepare_part(p, sheet)?;
+        requested_counts.insert(prep.id.clone(), prep.quantity);
+        prepared.push(prep);
+    }
+
+    // Sort decreasing by outer footprint area, then by part id for deterministic ordering.
+    prepared.sort_by(|a, b| {
+        b.sort_area
+            .total_cmp(&a.sort_area)
+            .then_with(|| a.id.cmp(&b.id))
+    });
+
+    let mut cache = NfpCache::default();
+    let mut sheets: Vec<ActiveSheet> = Vec::new();
+    let mut placed_counts = BTreeMap::new();
+    let mut unplaced = Vec::new();
+    let mut total_placed = 0usize;
+
+    for part in &prepared {
+        if part.quantity == 0 {
+            continue;
+        }
+        let Some(empty_hit) = fits_empty_sheet(part, &spec, &mut cache)? else {
+            unplaced.push(UnplacedPart {
+                part_id: part.id.clone(),
+                quantity: part.quantity,
+                reason: oversized_reason(part, &spec),
+            });
+            continue;
+        };
+
+        for inst in 0..part.quantity {
+            let mut placed = false;
+
+            if sheet.allow_parts_in_holes {
+                'hole_search: for s in &mut sheets {
+                    for hole in &mut s.holes {
+                        if let Some(hit) = find_best_placement(
+                            &part.orientations,
+                            ContainerKind::Hole {
+                                region: &hole.region,
+                            },
+                            &hole.obstacles,
+                            &mut cache,
+                        )? {
+                            let ori = &part.orientations[hit.ori_index];
+                            hole.obstacles.push(make_obstacle(ori, hit.offset)?);
+                            let host = (hole.host_id.clone(), hole.host_instance);
+                            record_placed(s, &part.id, inst, ori, hit.offset, Some(host))?;
+                            placed = true;
+                            break 'hole_search;
+                        }
+                    }
+                }
+            }
+
+            if !placed {
+                for s in &mut sheets {
+                    if let Some(hit) = find_best_placement(
+                        &part.orientations,
+                        ContainerKind::RectSheet {
+                            usable_bbox: s.usable_bbox,
+                        },
+                        &s.outer_obstacles,
+                        &mut cache,
+                    )? {
+                        let ori = &part.orientations[hit.ori_index];
+                        s.outer_obstacles.push(make_obstacle(ori, hit.offset)?);
+                        record_placed(s, &part.id, inst, ori, hit.offset, None)?;
+                        placed = true;
+                        break;
+                    }
+                }
+            }
+
+            if !placed {
+                let mut s = ActiveSheet::new(&spec);
+                let ori = &part.orientations[empty_hit.ori_index];
+                s.outer_obstacles
+                    .push(make_obstacle(ori, empty_hit.offset)?);
+                record_placed(&mut s, &part.id, inst, ori, empty_hit.offset, None)?;
+                sheets.push(s);
+            }
+
+            *placed_counts.entry(part.id.clone()).or_insert(0) += 1;
+            total_placed += 1;
+        }
+    }
+
+    let mut out_sheets = Vec::with_capacity(sheets.len());
+    let mut total_net_area = 0.0f64;
+    for (idx, s) in sheets.into_iter().enumerate() {
+        let cut_union = union_all_cuts(&s.cut_footprints)?;
+        let used_bounds = cut_union.bounds();
+        let waste_region = if cut_union.is_empty() {
+            spec.sheet_region.clone()
+        } else {
+            spec.sheet_region.difference(&cut_union)?
+        };
+        let utilization_pct = (s.net_area_sum / spec.area) * 100.0;
+        total_net_area += s.net_area_sum;
+        out_sheets.push(SheetPlacement {
+            sheet_index: idx,
+            placements: s.placements,
+            placed_counts: s.placed_counts,
+            utilization_pct,
+            waste_region,
+            used_bounds,
+            usable_sheet: spec.usable_sheet.clone(),
+        });
+    }
+
+    let sheet_count = out_sheets.len();
+    let overall_utilization_pct = if sheet_count > 0 {
+        (total_net_area / (sheet_count as f64 * spec.area)) * 100.0
+    } else {
+        0.0
+    };
+
+    Ok(NestReport {
+        sheet_count,
+        sheets: out_sheets,
+        total_requested,
+        total_placed,
+        requested_counts,
+        placed_counts,
+        overall_utilization_pct,
+        unplaced,
+    })
+}
diff --git a/crates/geometry/src/nesting/blf.rs b/crates/geometry/src/nesting/blf.rs
new file mode 100644
index 000000000..c95ec8b11
--- /dev/null
+++ b/crates/geometry/src/nesting/blf.rs
@@ -0,0 +1,216 @@
+//! Deterministic Bottom-Left-Fill (BLF) placement engine and NFP cache.
+//! Provenance: BLF placement heuristic over exact NFPs (Burke et al., Operations Research 2006).
+
+use super::candidates::{
+    ContainerKind, Obstacle, collect_candidates, translate_region, verify_with_nudge,
+};
+use super::decompose::IPoint;
+use super::inflate::{PreparedOrientation, ShapeKey};
+use super::nfp::{
+    IfpResult, NfpWithSeams, compute_ifp, compute_nfp, rect_region_from_ipoints, region_ibbox,
+};
+use super::types::NestError;
+use crate::geo2d::Region;
+use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) struct PlacementScore {
+    pub max_y: i64,
+    pub min_y: i64,
+    pub min_x: i64,
+    pub max_x: i64,
+    pub ori_index: usize,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct PlacementHit {
+    pub ori_index: usize,
+    pub offset: IPoint,
+    pub score: PlacementScore,
+}
+
+#[derive(Default)]
+pub(crate) struct NfpCache {
+    entries: BTreeMap<(ShapeKey, ShapeKey), NfpWithSeams>,
+}
+
+impl NfpCache {
+    fn get_translated(
+        &mut self,
+        obs: &Obstacle,
+        part_base: &Region,
+        part_key: &ShapeKey,
+    ) -> Result<NfpWithSeams, NestError> {
+        let Some((obs_lo, _)) = region_ibbox(&obs.base_region)? else {
+            return Ok(NfpWithSeams {
+                region: Region::empty(),
+                seam_points: Vec::new(),
+                seam_segments: Vec::new(),
+            });
+        };
+        let Some((part_lo, _)) = region_ibbox(part_base)? else {
+            return Ok(NfpWithSeams {
+                region: Region::empty(),
+                seam_points: Vec::new(),
+                seam_segments: Vec::new(),
+            });
+        };
+        let key = (obs.shape_key.clone(), part_key.clone());
+        let nfp_zero = if let Some(cached) = self.entries.get(&key) {
+            cached.clone()
+        } else {
+            let obs_zero = translate_region(
+                &obs.base_region,
+                IPoint {
+                    x: -obs_lo.x,
+                    y: -obs_lo.y,
+                },
+            )?;
+            let part_zero = translate_region(
+                part_base,
+                IPoint {
+                    x: -part_lo.x,
+                    y: -part_lo.y,
+                },
+            )?;
+            let computed = compute_nfp(&obs_zero, &part_zero)?;
+            self.entries.insert(key, computed.clone());
+            computed
+        };
+        let shift = IPoint {
+            x: obs.placed_offset.x + obs_lo.x - part_lo.x,
+            y: obs.placed_offset.y + obs_lo.y - part_lo.y,
+        };
+        let region = translate_region(&nfp_zero.region, shift)?;
+        let seam_points = nfp_zero
+            .seam_points
+            .iter()
+            .map(|p| p.add(shift))
+            .collect::<Result<Vec<_>, _>>()?;
+        let seam_segments = nfp_zero
+            .seam_segments
+            .iter()
+            .map(|&(a, b)| Ok((a.add(shift)?, b.add(shift)?)))
+            .collect::<Result<Vec<_>, NestError>>()?;
+        Ok(NfpWithSeams {
+            region,
+            seam_points,
+            seam_segments,
+        })
+    }
+}
+
+fn union_regions(regions: &[&Region]) -> Result<Region, NestError> {
+    match regions.len() {
+        0 => Ok(Region::empty()),
+        1 => Ok(regions[0].clone()),
+        n => {
+            let (left, right) = regions.split_at(n / 2);
+            let ul = union_regions(left)?;
+            let ur = union_regions(right)?;
+            if ul.is_empty() {
+                Ok(ur)
+            } else if ur.is_empty() {
+                Ok(ul)
+            } else {
+                Ok(ul.union(&ur)?)
+            }
+        }
+    }
+}
+
+/// Find the deterministic best BLF placement across all allowed orientations inside a container.
+pub(crate) fn find_best_placement(
+    orientations: &[PreparedOrientation],
+    container: ContainerKind<'_>,
+    obstacles: &[Obstacle],
+    cache: &mut NfpCache,
+) -> Result<Option<PlacementHit>, NestError> {
+    let (container_reg, is_rect) = match container {
+        ContainerKind::RectSheet { usable_bbox } => {
+            let r = rect_region_from_ipoints(usable_bbox.0, usable_bbox.1)?;
+            (r, true)
+        }
+        ContainerKind::Hole { region } => (region.clone(), false),
+    };
+
+    let mut best: Option<PlacementHit> = None;
+    for ori in orientations {
+        let ifp = if is_rect && ori.cut_footprint.is_empty() {
+            let (lo, hi) = match container {
+                ContainerKind::RectSheet { usable_bbox } => usable_bbox,
+                ContainerKind::Hole { .. } => continue,
+            };
+            let rx0 = lo.x - ori.sheet_fit_bbox.0.x;
+            let rx1 = hi.x - ori.sheet_fit_bbox.1.x;
+            let ry0 = lo.y - ori.sheet_fit_bbox.0.y;
+            let ry1 = hi.y - ori.sheet_fit_bbox.1.y;
+            if rx0 > rx1 || ry0 > ry1 {
+                continue;
+            }
+            let bbox = (IPoint { x: rx0, y: ry0 }, IPoint { x: rx1, y: ry1 });
+            let region = if rx0 < rx1 && ry0 < ry1 {
+                rect_region_from_ipoints(bbox.0, bbox.1)?
+            } else {
+                Region::empty()
+            };
+            IfpResult {
+                region,
+                bbox,
+                seam_points: Vec::new(),
+                seam_segments: Vec::new(),
+            }
+        } else {
+            let fit_fp = if is_rect {
+                &ori.cut_footprint
+            } else {
+                &ori.inflated_footprint
+            };
+            let Some(ifp) = compute_ifp(&container_reg, fit_fp, is_rect)? else {
+                continue;
+            };
+            ifp
+        };
+
+        let part_fp = &ori.obstacle_footprint;
+        let mut nfp_list = Vec::with_capacity(obstacles.len());
+        for obs in obstacles {
+            let nfp = cache.get_translated(obs, part_fp, &ori.shape_key)?;
+            if !nfp.region.is_empty() {
+                nfp_list.push(nfp);
+            }
+        }
+        let nfp_refs: Vec<&Region> = nfp_list.iter().map(|n| &n.region).collect();
+        let obs_union = union_regions(&nfp_refs)?;
+        let cands = collect_candidates(&ifp, &obs_union, &nfp_list, is_rect)?;
+        let part_box = ori.sheet_fit_bbox;
+
+        for cand in cands {
+            let cand_max_y = part_box.1.y + cand.y;
+            if let Some(ref b) = best
+                && cand_max_y > b.score.max_y + 1000
+            {
+                break;
+            }
+            let Some(offset) = verify_with_nudge(ori, cand, container, obstacles, false)? else {
+                continue;
+            };
+            let score = PlacementScore {
+                max_y: part_box.1.y + offset.y,
+                min_y: part_box.0.y + offset.y,
+                min_x: part_box.0.x + offset.x,
+                max_x: part_box.1.x + offset.x,
+                ori_index: ori.ori_index,
+            };
+            if best.as_ref().is_none_or(|b| score < b.score) {
+                best = Some(PlacementHit {
+                    ori_index: ori.ori_index,
+                    offset,
+                    score,
+                });
+            }
+            break;
+        }
+    }
+    Ok(best)
+}
diff --git a/crates/geometry/src/nesting/candidates.rs b/crates/geometry/src/nesting/candidates.rs
