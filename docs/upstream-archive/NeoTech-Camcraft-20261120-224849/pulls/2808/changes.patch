+#[test]
+fn refuses_requested_quantity_sum_overflow() {
+    let sheet = SheetInput {
+        width: 100.0,
+        height: 100.0,
+        ..SheetInput::default()
+    };
+    let first = PartInput::closed("first", 10_000, rect_loop(0.0, 0.0, 200.0, 200.0), vec![]);
+    let second = PartInput::closed(
+        "second",
+        usize::MAX,
+        rect_loop(0.0, 0.0, 200.0, 200.0),
+        vec![],
