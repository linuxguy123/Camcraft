  {
    "sha": "cd29299fe0e2731eb0e8ca11cfc647beb16dc6d9",
    "node_id": "C_kwDOVoU8JdoAKGNkMjkyOTlmZTBlMjczMWViMGU4Y2ExMWNmYzY0N2JlYjE2ZGM2ZDk",
    "commit": {
      "author": {
        "name": "NeoTech",
        "email": "andreas@roughedge.se",
        "date": "2026-11-20T20:21:29Z"
      },
      "committer": {
        "name": "NeoTech",
