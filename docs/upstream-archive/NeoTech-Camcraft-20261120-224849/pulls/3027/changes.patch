 .../golden/sinker-iso/sinker_side_burn.nc     |  24 +++
 crates/post/tests/script_sinker_iso.rs        |   6 +-
 crates/post/tests/script_sinker_side.rs       | 195 ++++++++++++++++++
 docs/CNC-INTERMEDIATE.md                      |   2 +-
 docs/decisions/3001-sinker-side-burn.md       |  27 +++
 8 files changed, 311 insertions(+), 17 deletions(-)
