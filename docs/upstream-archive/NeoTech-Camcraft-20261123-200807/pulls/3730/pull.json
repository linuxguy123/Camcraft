  "title": "fix(xtask): the quick submodule filter reads trait impls and scoped pub as shared",
  "user": {
    "login": "NeoTech",
    "id": 168627,
    "node_id": "MDQ6VXNlcjE2ODYyNw==",
    "avatar_url": "https://avatars.githubusercontent.com/u/168627?v=4",
