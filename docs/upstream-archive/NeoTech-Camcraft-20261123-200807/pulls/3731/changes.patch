From 9e311f317c9d45376f94a578327da05d834908ce Mon Sep 17 00:00:00 2001
From: mkinney <mike.kinney@gmail.com>
Date: Mon, 23 Nov 2026 18:20:29 +0100
Subject: [PATCH] fix(post): preserve Mach4 tap feed precision

Write G84 feeds at three metric or four inch decimals.
Refuse a tap when the written F/S pitch differs by more than 0.01 percent.
Pin exact feed words and named pitch refusals.

Co-Authored-By: Codex <noreply@openai.com>

Fixes #3701
---
 assets/posts/mach4.cps                   | 17 ++++-
 crates/post/tests/mach4_feed_decimals.rs | 96 ++++++++++++++++++++++++
 docs/decisions/3701-mach4-tap-feed.md    | 20 +++++
 3 files changed, 132 insertions(+), 1 deletion(-)
 create mode 100644 crates/post/tests/mach4_feed_decimals.rs
 create mode 100644 docs/decisions/3701-mach4-tap-feed.md

diff --git a/assets/posts/mach4.cps b/assets/posts/mach4.cps
index a1fcf1f23..26a6d82c2 100644
--- a/assets/posts/mach4.cps
+++ b/assets/posts/mach4.cps
@@ -102,6 +102,20 @@ function fu(mm) { return trimDec(inch ? mm / 25.4 : mm, inch ? 4 : 3, true); }
 function fa(deg) { return trimDec(deg, 3, true); }
 function ff(mmMin) { return "F" + trimDec(inch ? mmMin / 25.4 : mmMin, inch ? 2 : 1, false); }
 function fn(mm) { return trimDec(inch ? mm / 25.4 : mm, inch ? 4 : 3, false); }
+// #3701: compare the tap pitch with the F/S words the control reads.
+function tapPitchHolds(feed) {
+  var speed = Math.round(sRpm);
+  var writtenFeed = Number(fn(feed)) * (inch ? 25.4 : 1);
+  var want = feed / sRpm;
+  var got = speed > 0 ? writtenFeed / speed : 0;
+  var error = Math.abs(got - want) / want;
+  if (!(error <= 1e-4)) {
+    msg(who() + "canned cycle G84 (tap) feed " + feed + " mm/min at " + sRpm + " rpm posts as F" + fn(feed) + " S" + speed +
+      " - refused: the written pitch differs by more than 0.01 percent");
+    return false;
+  }
+  return true;
+}
 function eps() { return inch ? "0.0005" : "0.005"; }
 function minusU(expr, mm) {
   var v = Number(fn(mm));
@@ -808,6 +822,7 @@ function onCycle() {
     return;
   }
   if (spindleStopped("canned cycle " + g)) return;
+  if (g === "G84" && !tapPitchHolds(Number(p.FeedRate))) return;
   var pose = preparePose(p, true);
   if (!pose) return;
   var cfg = trunnionCfg;
@@ -824,7 +839,7 @@ function onCycle() {
     var ws = [g, "X" + fu(qBot[0]), "Y" + fu(qBot[1]), "Z" + fu(qBot[2]), "R" + fu(qR[2])];
     if ((p.CycleType === "PECK" || p.CycleType === "DEEP") && has(p.Q) && Number(p.Q) > 0) ws.push("Q" + fu(Number(p.Q)));
     if (secDwell > 0 && (g === "G82" || g === "G89")) ws.push("P" + trimDec(secDwell, 3, false));
-    ws.push(ff(Number(p.FeedRate)));
+    ws.push(g === "G84" ? "F" + fn(Number(p.FeedRate)) : ff(Number(p.FeedRate)));
     block(ws);
     cycleSig = sig;
   }
diff --git a/crates/post/tests/mach4_feed_decimals.rs b/crates/post/tests/mach4_feed_decimals.rs
new file mode 100644
index 000000000..3a3f3a045
--- /dev/null
+++ b/crates/post/tests/mach4_feed_decimals.rs
@@ -0,0 +1,96 @@
+//! Provenance: our own Mach4 post and CL stream tests for tap pitch precision (#3701).
+//! Gate map: covers assets/posts/mach4.cps, camcraft_post::post::engine.
+
+use camcraft_post::post::engine;
+use serde_json::json;
+use std::path::Path;
+
+struct Posted {
+    program: String,
+    warnings: Vec<String>,
+}
+
+fn post_tap(feed_um: u64, rpm: &str, units: &str) -> Result<Posted, String> {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let cps = std::fs::read_to_string(root.join("assets/posts/mach4.cps")).expect("Mach4 post");
+    let machine = serde_json::from_str(
+        &std::fs::read_to_string(root.join("assets/machines/3axis-vmc.mch")).expect("VMC machine"),
+    )
+    .expect("VMC machine JSON");
+    let stream = format!(
+        "PARAM WorkOffset G54\nPARAM ClearancePlane 25\nPARAM RetractPlane 5\n\
+         TOOL 1 \"6MM TOOL\"\nPARAM SpindleSpeed {rpm}\nPARAM OperationName TapPrecision\nSECTION TapPrecision\n\
+         Rapid X 0 Y 0 Z 5000\n\
+         CYCLE TAP X 0 Y 0 R 2000 Z -10000 Q 2000 P 0 F {feed_um}\n\
+         Rapid X 0 Y 0 Z 2000\nPlunge X 0 Y 0 Z -10000 F {feed_um}\n\
+         Rapid X 0 Y 0 Z 2000\nENDSECTION\n"
+    );
+    let out = engine::run_with(&cps, &machine, &stream, &json!({ "Units": units }))
+        .map_err(|e| e.to_string())?;
+    Ok(Posted {
+        program: out.program,
+        warnings: out.warnings.iter().map(|w| w.to_string()).collect(),
+    })
+}
+
+fn g84_feed(program: &str) -> Option<&str> {
+    program
+        .lines()
+        .find(|line| line.split_whitespace().any(|word| word == "G84"))
+        .and_then(|line| line.split_whitespace().find(|word| word.starts_with('F')))
+}
+
+#[test]
+fn mach4_g84_keeps_two_and_three_mm_feed_decimals() {
+    for (feed, word) in [(34_560, "F34.56"), (34_561, "F34.561")] {
+        let out = post_tap(feed, "115", "mm").expect("tap posts");
+        assert!(out.warnings.is_empty(), "{word}: {:?}", out.warnings);
+        assert_eq!(g84_feed(&out.program), Some(word), "{}", out.program);
+        assert!(out.program.contains("S115 M3"), "{}", out.program);
+    }
+}
+
+#[test]
+fn mach4_g84_keeps_four_inch_feed_decimals() {
+    for (feed, word) in [(34_560, "F1.3606"), (133_200, "F5.2441")] {
+        let out = post_tap(feed, "115", "inch").expect("inch tap posts");
+        assert!(out.warnings.is_empty(), "{word}: {:?}", out.warnings);
+        assert!(out.program.contains("G20"), "{}", out.program);
+        assert_eq!(g84_feed(&out.program), Some(word), "{}", out.program);
+    }
+}
+
+fn assert_tap_refused(feed_um: u64, rpm: &str, units: &str) {
+    match post_tap(feed_um, rpm, units) {
+        Err(error) => assert!(error.contains("G84 (tap)"), "{error}"),
+        Ok(out) => {
+            assert!(
+                out.warnings
+                    .iter()
+                    .any(|w| w.contains("G84 (tap)") && w.contains("TapPrecision")),
+                "tap pitch must be refused by operation name: {:?}\n{}",
+                out.warnings,
+                out.program
+            );
+            assert!(
+                g84_feed(&out.program).is_none(),
+                "refused tap writes no G84:\n{}",
+                out.program
+            );
+        }
+    }
+}
+
+#[test]
+fn mach4_refuses_tap_feed_rounding_that_changes_pitch() {
+    // F0.0787 is more than 0.01 percent below 2 / 25.4 in/min.
+    assert_tap_refused(2_000, "100", "inch");
+    // A positive feed below the smallest inch step must not become F0.
+    assert_tap_refused(1, "100", "inch");
+}
+
+#[test]
+fn mach4_refuses_tap_speed_rounding_that_changes_pitch() {
+    // S115 changes the pitch of 34.56 mm/min at a requested 115.4 rpm.
+    assert_tap_refused(34_560, "115.4", "mm");
+}
