From add906302f2e779892f63668e687ce772a9fe46d Mon Sep 17 00:00:00 2001
From: Mike Kinney <mike.kinney@gmail.com>
Date: Mon, 23 Nov 2026 06:55:11 -0800
Subject: [PATCH] fix(app): cut recipes cover the multi-axis deburr (main does
 not build)

PR #3283 added OpParams::MultiAxisDeburr; PR #3399, merged right after
from a review on an older main, added the exhaustive match in
recipe.rs::has_saved_geometry without it (E0004 on main). The multi-axis
deburr's exclude_edges are source picks like the 3-axis deburr's, so it
shares that arm.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CUsqDAAAJyAPrC37zBzbbX
---
 crates/app/src/commands/operation/recipe.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/app/src/commands/operation/recipe.rs b/crates/app/src/commands/operation/recipe.rs
index 55ff4d309..87e9144cd 100644
--- a/crates/app/src/commands/operation/recipe.rs
+++ b/crates/app/src/commands/operation/recipe.rs
@@ -79,7 +79,7 @@ fn has_saved_geometry(params: &OpParams) -> bool {
         OpParams::Drill { holes, cross, .. } => !holes.is_empty() || !cross.is_empty(),
         OpParams::Bore { holes, .. } | OpParams::Thread { holes, .. } => !holes.is_empty(),
         OpParams::Contour { chain_overrides, .. } => !chain_overrides.is_empty(),
-        OpParams::Deburr { exclude_edges, .. } => !exclude_edges.is_empty(),
+        OpParams::Deburr { exclude_edges, .. } | OpParams::MultiAxisDeburr { exclude_edges, .. } => !exclude_edges.is_empty(),
         OpParams::Circular { .. }
         | OpParams::Slot { .. }
         | OpParams::TrochoidalSlot { .. }
