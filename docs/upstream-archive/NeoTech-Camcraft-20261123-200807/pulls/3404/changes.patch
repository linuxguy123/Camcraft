From 863fae5ba738d1426e0d47d4ef6c5553cc19decc Mon Sep 17 00:00:00 2001
From: paulsvc <paulsvc02@gmail.com>
Date: Sun, 22 Nov 2026 12:47:55 +0100
Subject: [PATCH] build(release): generate and publish SHA256SUMS.txt

Generate dist/SHA256SUMS.txt with basenames over collected release assets in the publish job, verify it with sha256sum -c, and upload it alongside the release assets.

Refs #2428
---
 .github/workflows/release.yml | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 43c59f837..8a4bc164a 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -419,6 +419,21 @@ jobs:
             exit 1
           fi
           printf '%s\n' "${assets[@]}"
+      - name: Generate SHA256SUMS.txt
+        shell: bash
+        run: |
+          set -euo pipefail
+          (
+            cd dist
+            shopt -s nullglob
+            assets=(*.zip *-setup.exe *.tar.gz *.deb *.rpm *.dmg *.AppImage *.snap *.flatpak *.pkg.tar.zst)
+            if [ ${#assets[@]} -eq 0 ]; then
+              echo "::error::no release assets found in dist/ for SHA256SUMS.txt"
+              exit 1
+            fi
+            sha256sum "${assets[@]}" > SHA256SUMS.txt
+            sha256sum -c SHA256SUMS.txt
+          )
       - name: Publish GitHub Release
         uses: softprops/action-gh-release@v2
         with:
@@ -433,6 +448,7 @@ jobs:
             dist/*.snap
             dist/*.flatpak
             dist/*.pkg.tar.zst
+            dist/SHA256SUMS.txt
           body_path: dist/release-body.md
           # A failed platform leaves its globs empty; the step above already
           # refused a release with no asset at all.
