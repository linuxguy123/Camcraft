+    c2.ok("set_stock", json!({ "box": { "dx": 80.0, "dy": 80.0, "dz": 24.0 } }));
+    c2.ok("add_tool", json!({ "catalog": "EM-0400-2FL", "name": "SteppedMill" }));
+    let tower_top = top_face_id(&mut c2, "tower", 24.0);
+
+    let op_live = c2.ok("add_operation", json!({
