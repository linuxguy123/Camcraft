+            "top_z": { "reference": "fixed", "offset": 24.0 },
+            "bottom_z": { "reference": "fixed", "offset": 23.7 },
+            "clearance_z": { "reference": "fixed", "offset": 35.0 },
+            "retract_z": { "reference": "fixed", "offset": 26.0 }
+        }
