From 5ed8d86ece795d89703dc915c8507b420fc37c23 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sun, 22 Nov 2026 21:20:56 +0000
Subject: [PATCH] test(2d): port the offset engagement pins

Port three engagement pins from PR #3439 onto main's Pass start law
(level_rings / level_order). Each pin passes. Two PR pins are not ported:
one fails on main's law and one repeats main's existing coverage.

Kept:
- outside_on_a_figure_eight_band_never_slots: Outside on a synthetic
  figure-eight band never cuts wider than 1.5 stepovers over any 3 tool
  radii of floor feed. Main has this law only in an ignored heavy app
  test, so this pin gives default-suite coverage.
- inside_on_the_band_clears_the_whole_band: Inside on the round-part
  band leaves less than 0.5 mm2 of stock off the part wall, for both
  climb directions.
- auto_on_the_band_slots_so_the_measure_sees_a_slot: Auto (core first)
  on the same band slots, so the width measure has a positive control.

Dropped:
- outside_entries_after_the_first_land_in_cleared_stock: fails on main.
  The later entries cut 332.88 mm2 of uncut stock. Main's law does not
  lead a re-entry from cleared stock.
- outside_on_a_split_band_never_slots: main's
  outside_band_split_by_the_part_cuts_no_move_at_full_width already pins
  the same Outside split-band law.

Refs #3316

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 crates/motion/tests/pass_start_engagement.rs | 245 +++++++++++++++++++
 1 file changed, 245 insertions(+)
 create mode 100644 crates/motion/tests/pass_start_engagement.rs

diff --git a/crates/motion/tests/pass_start_engagement.rs b/crates/motion/tests/pass_start_engagement.rs
new file mode 100644
index 000000000..e7b6bbfc5
--- /dev/null
+++ b/crates/motion/tests/pass_start_engagement.rs
@@ -0,0 +1,245 @@
+//! #3316: "Pass starts at" Outside / Inside must cut each pass at one
+//! stepover, along the whole level - not only at its first and last
+//! move. The cases are the second read's hand trace on PR #3353: a band
+//! around a round part of radius 15, tool D8, stepover 4, whose rings
+//! split, and a figure-eight part whose band splits at its lobe tips.
+//! A ring order of whole closed loops then cuts full slots along the
+//! part-side arcs of the split pieces.
+//!
+//! The check is a 2-D material sim on a 0.25 mm grid: each feed below
+//! the stock top removes the cells under the tool disc, and the planar
+//! feeds at the floor are measured by the width they remove, averaged
+//! over every window of 3 tool radii of path. A full slot removes 8 mm;
+//! one stepover removes 4 mm.
+//!
+//! Gate map: covers camcraft_motion::machining2d (pass_start,
+//! level_rings, level_order, waterscan, pocket). Provenance: our own
+//! regression of the review of PR #3353; the radial-engagement measure of
+//! the public milling handbooks; no vendor material consulted.
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::links::Links;
+use camcraft_motion::load::DEFAULT_OPTIMAL_LOAD;
+use camcraft_motion::machining2d::{CornerRelief, PassStart, PocketParams, PocketStrategy, pocket_started};
+
+const R: f64 = 4.0;
+const STEP: f64 = 4.0;
+const CELL: f64 = 0.25;
+const PART: f64 = 15.0;
+
+fn lp(pts: Vec<Point2>) -> Loop {
+    let Ok(l) = Loop::new(pts) else { panic!("fixture loop") };
+    l
+}
+
+fn rect(hx: f64, hy: f64) -> Loop {
+    lp(vec![Point2::new(-hx, -hy), Point2::new(hx, -hy), Point2::new(hx, hy), Point2::new(-hx, hy)])
+}
+
+fn circle(r: f64) -> Loop {
+    let n = 256;
+    lp((0..n)
+        .map(|k| {
+            let a = f64::from(k) * std::f64::consts::TAU / f64::from(n);
+            Point2::new(r * a.cos(), r * a.sin())
+        })
+        .collect())
+}
+
+fn params(climb: bool) -> PocketParams {
+    PocketParams {
+        blend_radius: None,
+        tool_diameter: 2.0 * R,
+        stepover: STEP,
+        stock_to_leave: 0.0,
+        clearance_z: 10.0,
+        retract_z: None,
+        top_z: 0.0,
+        bottom_z: -3.0,
+        stepdown: 5.0,
+        feed: 1000.0,
+        plunge_feed: 300.0,
+        climb,
+        strategy: PocketStrategy::Waterline,
+        entry: Entry3D::Helix,
+        helix_radius: 1.6,
+        optimal_load: DEFAULT_OPTIMAL_LOAD,
+        blend_turns: false,
+        links: Links::PLANAR,
+    }
+}
+
+/// The material grid: true where stock still stands.
+struct Grid {
+    lo: Point2,
+    nx: usize,
+    ny: usize,
+    cells: Vec<bool>,
+}
+
+impl Grid {
+    fn new(stock: &Region) -> Grid {
+        let Some((lo, hi)) = stock.bounds() else { panic!("stock bounds") };
+        let nx = ((hi.x - lo.x) / CELL).ceil() as usize + 1;
+        let ny = ((hi.y - lo.y) / CELL).ceil() as usize + 1;
+        let mut cells = vec![false; nx * ny];
+        for j in 0..ny {
+            for i in 0..nx {
+                let p = Point2::new(lo.x + (i as f64 + 0.5) * CELL, lo.y + (j as f64 + 0.5) * CELL);
+                cells[j * nx + i] = stock.contains(p);
+            }
+        }
+        Grid { lo, nx, ny, cells }
+    }
+
+    /// Clear the disc at `c`; returns the area removed (mm^2).
+    fn cut(&mut self, c: Point2) -> f64 {
+        let i0 = (((c.x - R - self.lo.x) / CELL).floor().max(0.0)) as usize;
+        let j0 = (((c.y - R - self.lo.y) / CELL).floor().max(0.0)) as usize;
+        let i1 = ((((c.x + R - self.lo.x) / CELL).ceil()).max(0.0) as usize).min(self.nx);
+        let j1 = ((((c.y + R - self.lo.y) / CELL).ceil()).max(0.0) as usize).min(self.ny);
+        let mut n = 0usize;
+        for j in j0..j1 {
+            for i in i0..i1 {
+                let p = Point2::new(self.lo.x + (i as f64 + 0.5) * CELL, self.lo.y + (j as f64 + 0.5) * CELL);
+                if (p.x - c.x).hypot(p.y - c.y) <= R && self.cells[j * self.nx + i] {
+                    self.cells[j * self.nx + i] = false;
+                    n += 1;
+                }
+            }
+        }
+        n as f64 * CELL * CELL
+    }
+}
+
+/// The worst width of cut (mm) over any window of `3 R` of planar floor
+/// feed, where that window ends, and the stock area (mm^2) left standing
+/// off the part wall when the path is done.
+fn worst_width(path: &Toolpath, stock: &Region, floor: f64, top: f64) -> (f64, Point2, f64) {
+    let mut g = Grid::new(stock);
+    // (path length so far, area so far) at each floor sample.
+    let mut trail: Vec<(f64, f64, Point2)> = vec![(0.0, 0.0, Point2::new(0.0, 0.0))];
+    let (mut len, mut area) = (0.0, 0.0);
+    for m in path.moves.iter().filter(|m| m.kind != MoveKind::Rapid) {
+        // A move that reaches below the stock top cuts (a plunge or a
+        // helix from above included): the 2-D grid has one slab.
+        if m.from.z.min(m.to.z) >= top - 1e-9 {
+            continue;
+        }
+        let planar = (m.from.z - floor).abs() < 1e-9 && (m.to.z - floor).abs() < 1e-9;
+        for (a, b) in m.chords(0.005) {
+            let d = (b.x - a.x).hypot(b.y - a.y);
+            let n = (d / (CELL * 0.5)).ceil().max(1.0) as usize;
+            for s in 1..=n {
+                let t = s as f64 / n as f64;
+                let p = Point2::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t);
+                let got = g.cut(p);
+                if planar {
+                    len += d / n as f64;
+                    area += got;
+                    trail.push((len, area, p));
+                }
+            }
+        }
+    }
+    let win = 3.0 * R;
+    let mut worst = (0.0, Point2::new(0.0, 0.0), 0.0);
+    let mut lo = 0;
+    for hi in 0..trail.len() {
+        while trail[hi].0 - trail[lo].0 > win {
+            lo += 1;
+        }
+        let span = trail[hi].0 - trail[lo].0;
+        if span >= win - CELL {
+            let w = (trail[hi].1 - trail[lo].1) / span;
+            if w > worst.0 {
+                worst = (w, trail[hi].2, 0.0);
+            }
+        }
+    }
+    // The stock still standing more than half a cell row off the part.
+    let mut left = 0usize;
+    for j in 0..g.ny {
+        for i in 0..g.nx {
+            let p = Point2::new(g.lo.x + (i as f64 + 0.5) * CELL, g.lo.y + (j as f64 + 0.5) * CELL);
+            if g.cells[j * g.nx + i] && p.x.hypot(p.y) > PART + 2.0 * CELL {
+                left += 1;
+            }
+        }
+    }
+    worst.2 = left as f64 * CELL * CELL;
+    worst
+}
+
+fn band() -> (Region, Region) {
+    // The machining region reaches one tool radius past the stock, as an
+    // Outside containment's area does; the part is the hole.
+    let Ok(region) = Region::new(vec![rect(50.0 + R, 20.0 + R), circle(PART)]) else { panic!("region") };
+    let Ok(stock) = Region::new(vec![rect(50.0, 20.0), circle(PART)]) else { panic!("stock") };
+    (region, stock)
+}
+
+fn run(start: PassStart, climb: bool) -> (f64, Point2, f64) {
+    let (region, stock) = band();
+    let p = params(climb);
+    let path = match pocket_started(&region, &p, &[], &CornerRelief::default(), start) {
+        Ok(t) => t,
+        Err(e) => panic!("{start:?}: {e:?}"),
+    };
+    worst_width(&path, &stock, p.bottom_z, p.top_z)
+}
+
+/// A figure-eight part (two lobes of radius 20, 36 apart, so a waist)
+/// in a box 5 mm past it: the shape of the maintainer's fig8. The band
+/// splits at the lobe tips; Outside still never slots.
+#[test]
+fn outside_on_a_figure_eight_band_never_slots() {
+    let lobe = |cx: f64| {
+        let n = 128;
+        lp((0..n)
+            .map(|k| {
+                let a = f64::from(k) * std::f64::consts::TAU / f64::from(n);
+                Point2::new(cx + 20.0 * a.cos(), 20.0 * a.sin())
+            })
+            .collect())
+    };
+    let Ok(part) = Region::new(vec![lobe(-18.0), lobe(18.0)]) else { panic!("part") };
+    let Some((lo, hi)) = part.bounds() else { panic!("bounds") };
+    let (hx, hy) = (hi.x.max(-lo.x) + 5.0, hi.y.max(-lo.y) + 5.0);
+    let Ok(outer) = Region::new(vec![rect(hx + R, hy + R)]) else { panic!("outer") };
+    let Ok(boxed) = Region::new(vec![rect(hx, hy)]) else { panic!("box") };
+    let (Ok(region), Ok(stock)) = (outer.difference(&part), boxed.difference(&part)) else { panic!("band") };
+    let t0 = std::time::Instant::now();
+    let p = PocketParams { bottom_z: -20.0, stepdown: 10.0, ..params(true) };
+    let path = match pocket_started(&region, &p, &[], &CornerRelief::default(), PassStart::Outside) {
+        Ok(t) => t,
+        Err(e) => panic!("{e:?}"),
+    };
+    let took = t0.elapsed();
+    let (w, at, _) = worst_width(&path, &stock, p.bottom_z, p.top_z);
+    assert!(w <= 1.5 * STEP, "Outside cuts {w:.2} mm wide near {at:?}");
+    assert!(took.as_secs_f64() < 20.0, "the plan took {took:?}");
+}
+
+/// Inside on the band starts on the part wall (a full-width cut that no
+/// order avoids; the app names it in a note) and still clears the whole
+/// band: the open pieces of the grown part leave no stock between them.
+#[test]
+fn inside_on_the_band_clears_the_whole_band() {
+    for climb in [true, false] {
+        let (_, _, left) = run(PassStart::Inside, climb);
+        assert!(left < 0.5, "climb {climb}: Inside leaves {left:.2} mm^2 of stock off the part wall");
+    }
+}
+
+/// The measure itself: Auto (core first) on the same band starts each
+/// level in the middle of the uncut stock, so it does slot - the sim
+/// sees the defect the option exists for.
+#[test]
+fn auto_on_the_band_slots_so_the_measure_sees_a_slot() {
+    let (w, at, left) = run(PassStart::Auto, true);
+    assert!(w > 1.8 * STEP, "Auto cuts only {w:.2} mm wide near {at:?}");
+    assert!(left < 0.5, "Auto leaves {left:.2} mm^2 of stock off the part wall");
+}
