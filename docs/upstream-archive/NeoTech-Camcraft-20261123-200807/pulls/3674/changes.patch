 //! law; axis lettering per RS-274 / ISO 6983 convention. No vendor
 //! material consulted.
 
+use crate::geometry::Triangle;
 use crate::machine::AxisLimits;
 use crate::machining2d::GenError;
 
@@ -63,6 +64,32 @@ pub(super) fn rotary_letter(
