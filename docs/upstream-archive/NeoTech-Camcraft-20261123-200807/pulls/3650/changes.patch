diff --git a/crates/motion/src/multiaxis/rotary/halves.rs b/crates/motion/src/multiaxis/rotary/halves.rs
new file mode 100644
index 000000000..35cab3484
--- /dev/null
+++ b/crates/motion/src/multiaxis/rotary/halves.rs
@@ -0,0 +1,262 @@
+//! Rotary Parallel's two halves (#2970). The laid raster is a 3-axis
+//! finish of the bar from above: its raster rides the top, its rings
+//! the flanks, and nothing reaches the underside - a quarter of the
+//! turn and more stayed uncut. The bar turns, so the generator plans
+//! it twice: once in the laid frame (half A) and once in that frame
+//! turned half a turn about the axis (half B). Each half keeps only
+//! the cut whose ball CENTER stands in its own upper half, and half B
+//! is carried back into half A's frame by the same rigid half turn.
+//! A ball sphere that touched the model nowhere stays so under a
+//! rotation; the radial pose that follows keeps every center.
+//!
+//! Provenance: our own design; a rigid half turn about a line and
+//! clipping a segment at a plane are elementary geometry.
+
+use crate::cl::{Move, MoveKind, Toolpath};
+use crate::geometry::{Point3, Triangle};
+use crate::machining2d::ARC_FIT_TOL;
+
+/// Half A (`a`, planned in the laid frame over `local`) and half B
+/// (`b`, planned in that frame turned half a turn) as one base path in
+/// A's frame. The seam: A keeps the centers down to half a ball radius
+/// under the axis plane (its first ring past the equator), B only those
+/// strictly under A's lowest kept center on each side, read over the
+/// turned surface. Each seam pass is cut once, and no seam step is
+/// wider than a ring step of the ladder. B is held to the Bottom
+/// ([`over_bottom`]).
+pub(super) fn both(a: &Toolpath, b: &Toolpath, local: &[Triangle], r: f64, bottom: f64, tol: f64) -> Toolpath {
+    let (x0, x1, rho) = local.iter().flat_map(|t| [t.a, t.b, t.c]).fold(
+        (f64::INFINITY, f64::NEG_INFINITY, 0.0f64),
+        |(l, h, rho), p| (l.min(p.x), h.max(p.x), rho.max((p.y * p.y + p.z * p.z).sqrt())),
+    );
+    let seat = Seat { reach: 0.5 * rho, x0: x0 + r, x1: x1 - r };
+    let (a, lo) = upper(a, r, [-0.5 * r; 2], false, &seat);
+    // B's side y >= 0 is A's y <= 0: the half turn swaps them.
+    let (b, _) = upper(b, r, [-lo[1], -lo[0]], true, &seat);
+    let b = over_bottom(&turned(&b, r), r, bottom, tol);
+    let under = b.moves.iter().any(|m| m.kind == MoveKind::Feed);
+    let mut path = joined(a, b);
+    if under {
+        path.notes.push(UNDER.into());
+    }
+    path
+}
+
+/// Half B alone (half A found no surface): turned into A's frame and
+/// held to the Bottom, with the note when it cuts.
+pub(super) fn only_b(b: &Toolpath, r: f64, bottom: f64, tol: f64) -> Toolpath {
+    let mut path = over_bottom(&turned(b, r), r, bottom, tol);
+    if path.moves.iter().any(|m| m.kind == MoveKind::Feed) {
+        path.notes.push(UNDER.into());
+    }
+    path
+}
+
+/// The note a path that cuts under the axis carries: the machine must
+/// turn the part, and the Bottom is how to keep to the upper arc.
+const UNDER: &str = "Rotary Parallel: the passes go all the way round the bar - the machine must turn the part on a rotary axis through the whole turn; set Bottom above the axis to cut only the upper arc";
+
+/// The lowest ball center a half keeps, on each side of the frame's
+/// vertical plane through the axis: `[y >= 0, y < 0]`. The two sides
+/// are the two seams of the turn; a ladder's levels need not match on
+/// both, so each seam reads its own.
+type Floor = [f64; 2];
+
+/// Where a seam may be read: off the vertical plane by `reach`, between
+/// the model's end stations.
+struct Seat {
+    reach: f64,
+    x0: f64,
+    x1: f64,
+}
+
+impl Seat {
+    fn holds(&self, p: Point3) -> bool {
+        p.y.abs() >= self.reach && p.x > self.x0 && p.x < self.x1
+    }
+}
+
+fn side(p: Point3) -> usize {
+    usize::from(p.y < 0.0)
+}
+
+/// `base` (laid-frame raster, vertical-ball tips: the center stands
+/// `r` above the tip) with every cutting move kept where its ball
+/// center stands at local z >= the `floor` of its side (z > it when
+/// `strict`). Beside the path stands the lowest center of a chord kept
+/// whole, on each side (+infinity where none is), read only over the
+/// turned surface: the center stands `seat.reach` or more off the
+/// vertical plane and strictly between the model's end stations
+/// `seat.x0..seat.x1`. The seams lie out on the turned surface; a ring
+/// round an end face, beside it, is no seam. A piece cut at the plane
+/// ends there by construction, so it never reads as a pass of the
+/// ladder.
+fn upper(base: &Toolpath, r: f64, floor: Floor, strict: bool, seat: &Seat) -> (Toolpath, Floor) {
+    let keeps = move |p: Point3| {
+        let lim = floor[side(p)] - r; // the tip of the lowest kept center
+        if strict { p.z > lim } else { p.z >= lim }
+    };
+    let mut lo = [f64::INFINITY; 2];
+    for m in base.moves.iter().filter(|m| m.kind == MoveKind::Feed) {
+        for (a, b) in chords(m) {
+            if keeps(a) && keeps(b) {
+                for p in [a, b].into_iter().filter(|p| seat.holds(*p)) {
+                    lo[side(p)] = lo[side(p)].min(p.z + r);
+                }
+            }
+        }
+    }
+    (kept(base, &keeps), lo)
+}
+
+fn chords(m: &Move) -> Vec<(Point3, Point3)> {
+    match m.arc {
+        None => vec![(m.from, m.to)],
+        Some(_) => m.segments3(ARC_FIT_TOL),
+    }
+}
+
+/// `base` with every cutting move kept where `keeps` holds. Links pass
+/// through: the radial relink rebuilds them from the cut runs. Where
+/// the cut leaves the kept region and comes back, a plunge marker
+/// stands between the two pieces, so the relink reads two runs and
+/// links them over the retract cylinder, never with a feed across the
+/// part.
+fn kept(base: &Toolpath, keeps: &dyn Fn(Point3) -> bool) -> Toolpath {
+    let mut out: Vec<Move> = Vec::with_capacity(base.moves.len());
+    let mut cut_end: Option<Point3> = None;
+    for m in &base.moves {
+        if m.kind != MoveKind::Feed {
+            out.push(*m);
+            cut_end = None;
+            continue;
+        }
+        let cs = chords(m);
+        let whole = cs.iter().all(|(a, b)| keeps(*a) && keeps(*b));
+        let pieces: Vec<(Point3, Point3)> = if whole {
+            vec![(m.from, m.to)]
+        } else {
+            cs.into_iter().filter_map(|(a, b)| part(a, b, keeps)).collect()
+        };
+        for (a, b) in pieces {
+            if let Some(e) = cut_end
+                && e != a
+            {
+                out.push(Move::new(MoveKind::Plunge, e, a, m.feed));
+            }
+            out.push(if whole { *m } else { Move { from: a, to: b, arc: None, ..*m } });
+            cut_end = Some(b);
+        }
+    }
+    let mut path = Toolpath::new(out);
+    path.notes = base.notes.clone();
+    path
+}
+
+/// The part of the segment `a..b` that `keeps`, when one end is kept
+/// and the other not: the crossing found by bisection (both kept
+/// regions here are bounded by one smooth surface, crossed once by a
+/// chord far shorter than the bar). None when neither end is kept, or
+/// only a point is.
+fn part(a: Point3, b: Point3, keeps: &dyn Fn(Point3) -> bool) -> Option<(Point3, Point3)> {
+    let (ina, inb) = (keeps(a), keeps(b));
+    if ina && inb {
+        return Some((a, b));
+    }
+    if !ina && !inb {
+        return None;
+    }
+    let at = |t: f64| Point3::new(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
+    // The kept end at t = 0 of the search, the other at t = 1.
+    let (mut lo, mut hi) = (0.0f64, 1.0f64);
+    let kept_at = |t: f64| keeps(at(if ina { t } else { 1.0 - t }));
+    for _ in 0..48 {
+        let mid = 0.5 * (lo + hi);
+        if kept_at(mid) {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    let q = at(if ina { lo } else { 1.0 - lo });
+    let (p, e) = if ina { (a, q) } else { (q, b) };
+    (p != e).then_some((p, e))
+}
+
+/// `base` (in A's frame, vertical-ball tips) kept where a radially
+/// posed ball touches a round bar at world height `bottom - tol` or
+/// above: the contact stands `r` in from the center along the radial.
+/// Half B is held to the operation's Bottom this way - its own frame's
+/// ladder law reads the Bottom upside down - so a Bottom over the
+/// axis keeps the cut to the upper arc, and a Bottom at the bar's
+/// underside lets the passes go all the way round.
+fn over_bottom(base: &Toolpath, r: f64, bottom: f64, tol: f64) -> Toolpath {
+    let keeps = move |t: Point3| {
+        let (cy, cz) = (t.y, t.z + r);
+        let rho = (cy * cy + cz * cz).sqrt();
+        let contact = if rho > 1e-12 { cz - r * cz / rho } else { cz };
+        contact >= bottom - tol
+    };
+    kept(base, &keeps)
+}
+
+/// Half B's path in half A's frame: the frames share the axis line
+/// (local x) and differ by half a turn about it, so a ball center
+/// (x, y, z) of B is (x, -y, -z) of A. Tips are carried as their
+/// centers (`r` up their own frame's z) and set back `r` below the
+/// center in A. Arcs ride as their chords at `ARC_FIT_TOL`: the pose
+/// that follows flattens them the same way. B's lifts off a pass
+/// (straight up B's z into a rapid) run DOWN A's z once turned, where
+/// the radial relink no longer reads them as lifts: they ride as the
+/// links they are, rapids, and the relink rebuilds them radially.
+fn turned(base: &Toolpath, r: f64) -> Toolpath {
+    let t = |p: Point3| Point3::new(p.x, -p.y, -p.z - 2.0 * r);
+    let ms = &base.moves;
+    let mut out: Vec<Move> = Vec::with_capacity(ms.len());
+    for (i, m) in ms.iter().enumerate() {
+        let lift = m.kind == MoveKind::Feed
+            && m.arc.is_none()
+            && m.from.x == m.to.x
+            && m.from.y == m.to.y
+            && m.to.z > m.from.z
+            && ms.get(i + 1).is_some_and(|n| n.kind == MoveKind::Rapid);
+        if lift {
+            out.push(Move::new(MoveKind::Rapid, t(m.from), t(m.to), None));
+            continue;
+        }
+        match m.arc {
+            None => out.push(Move { from: t(m.from), to: t(m.to), ..*m }),
+            Some(_) => out.extend(
+                m.segments3(ARC_FIT_TOL)
+                    .into_iter()
+                    .map(|(a, b)| Move { from: t(a), to: t(b), arc: None, ..*m }),
+            ),
+        }
+    }
+    let mut path = Toolpath::new(out);
+    path.notes = base.notes.clone();
+    path
+}
+
+/// Half A, then half B, as one base path. The step between them is a
+/// rapid: the radial relink turns it into a link over the retract
+/// cylinder like every other lift. A note both halves raise is
+/// stated once.
+fn joined(a: Toolpath, b: Toolpath) -> Toolpath {
+    let mut moves = a.moves;
+    if let (Some(last), Some(first)) = (moves.last().copied(), b.moves.first())
+        && last.to != first.from
+    {
+        moves.push(Move::new(MoveKind::Rapid, last.to, first.from, None));
+    }
+    moves.extend(b.moves);
+    let mut notes = a.notes;
+    for n in b.notes {
+        if !notes.contains(&n) {
+            notes.push(n);
+        }
+    }
+    let mut path = Toolpath::new(moves);
+    path.notes = notes;
+    path
+}
diff --git a/crates/motion/tests/rotary_coverage.rs b/crates/motion/tests/rotary_coverage.rs
new file mode 100644
index 000000000..7890182a4
--- /dev/null
+++ b/crates/motion/tests/rotary_coverage.rs
@@ -0,0 +1,212 @@
+//! #2970 Rotary Parallel coverage law: on a plain bar laid along the
+//! rotary axis, the passes go all the way round - every sector of the
+//! circle holds a cutting move on the turned surface, at a coarse and
+//! at a fine stepover. Angles are about the bar's axis (+x) in the
+//! world frame: 90 degrees is the top (+z), 270 the bottom (-z).
+//!
+//! Gate map (M4.4): covers camcraft_motion::multiaxis (rotary
+//! parallel) on this crate's own fixtures.
+//! Lane shape (M4.4): all tests here run in seconds.
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::finishing3d::{Finish3DParams, FinishPattern, GapLink};
+use camcraft_motion::geometry::{Point3, Triangle};
+use camcraft_motion::multiaxis::{rotary_parallel, AxisControl};
+
+const TAU: f64 = std::f64::consts::TAU;
+/// The bar: radius and length along +x.
+const R: f64 = 3.0;
+const LEN: f64 = 20.0;
+/// The ball's radius (a 2 mm ball nose).
+const BALL: f64 = 1.0;
+const SECTOR_DEG: f64 = 30.0;
+
+/// A closed round bar laid along +x, wound outward, `n` facets round.
+fn bar(n: usize) -> Vec<Triangle> {
+    let v = |j: usize, r: f64, x: f64| {
+        let th = TAU * j as f64 / n as f64;
+        Point3::new(x, r * th.cos(), r * th.sin())
+    };
+    let mut t = Vec::new();
+    for j in 0..n {
+        // Foot cap at x = 0 (normal -x), wall, crown cap at x = LEN (+x).
+        t.push(Triangle::new(v(0, 0.0, 0.0), v(j + 1, R, 0.0), v(j, R, 0.0)));
+        let (a1, a2, b1, b2) = (v(j, R, 0.0), v(j + 1, R, 0.0), v(j, R, LEN), v(j + 1, R, LEN));
+        t.push(Triangle::new(a1, a2, b2));
+        t.push(Triangle::new(a1, b2, b1));
+        t.push(Triangle::new(v(0, 0.0, LEN), v(j, R, LEN), v(j + 1, R, LEN)));
+    }
+    t
+}
+
+fn params(stepover: f64) -> Finish3DParams {
+    Finish3DParams {
+        gap_link: GapLink::Jump,
+        pattern: FinishPattern::Parallel,
+        stepover: Some(stepover),
+        tool_diameter: 2.0 * BALL,
+        tolerance: 0.05,
+        clearance_z: R + 6.0,
+        retract_z: None,
+        top_z: R,
+        bottom_z: -R,
+        feed: 800.0,
+        plunge_feed: 200.0,
+        climb: true,
+        ramp: false,
+        min_step: None,
+        ramp_angle: 45.0,
+        entry_ramp: false,
+        steep_stepover: None,
+        pencil_reference: None,
+    }
+}
+
+/// The angle (degrees, 0..360) about +x of each cutting ball center
+/// that stands on the turned surface: away from the end faces, at one
+/// ball radius off the wall within the tolerance.
+fn cut_angles(path: &Toolpath) -> Vec<f64> {
+    path.moves
+        .iter()
+        .filter(|m| m.kind == MoveKind::Feed)
+        .filter_map(|m| {
+            let a = m.axis.unwrap_or([0.0, 0.0, 1.0]);
+            let c = Point3::new(m.to.x + BALL * a[0], m.to.y + BALL * a[1], m.to.z + BALL * a[2]);
+            let rho = (c.y * c.y + c.z * c.z).sqrt();
+            let on_wall = c.x > 1.0 && c.x < LEN - 1.0 && (rho - (R + BALL)).abs() < 0.1;
+            on_wall.then(|| c.z.atan2(c.y).to_degrees().rem_euclid(360.0))
+        })
+        .collect()
+}
+
+/// The sectors (start angle, degrees) that hold no cutting move, and
+/// the widest angular gap between neighbouring cutting moves.
+fn coverage(angles: &[f64]) -> (Vec<f64>, f64) {
+    let n = (360.0 / SECTOR_DEG) as usize;
+    let mut hit = vec![false; n];
+    for a in angles {
+        let k = ((a / SECTOR_DEG) as usize).min(n - 1);
+        hit[k] = true;
+    }
+    let empty = (0..n).filter(|k| !hit[*k]).map(|k| k as f64 * SECTOR_DEG).collect();
+    let mut s: Vec<f64> = angles.to_vec();
+    s.sort_by(f64::total_cmp);
+    let mut gap = 360.0f64;
+    if let (Some(first), Some(last)) = (s.first(), s.last()) {
+        gap = s.windows(2).map(|w| w[1] - w[0]).fold(first + 360.0 - last, f64::max);
+    }
+    (empty, gap)
+}
+
+/// The passes (distinct angles, 0.1 degree apart or more) whose angle
+/// lies within `half` degrees of `at`, as signed offsets from it, each
+/// with the number of cutting moves that stand on it.
+fn passes_near(angles: &[f64], at: f64, half: f64) -> Vec<(f64, usize)> {
+    let mut d: Vec<f64> = angles
+        .iter()
+        .map(|a| (a - at + 540.0).rem_euclid(360.0) - 180.0)
+        .filter(|d| d.abs() <= half)
+        .collect();
+    d.sort_by(f64::total_cmp);
+    let mut out: Vec<(f64, usize)> = Vec::new();
+    for x in d {
+        match out.last_mut() {
+            Some((a, n)) if x - *a < 0.1 => *n += 1,
+            _ => out.push((x, 1)),
+        }
+    }
+    out
+}
+
+fn widest_step(p: &[(f64, usize)]) -> f64 {
+    p.windows(2).map(|w| w[1].0 - w[0].0).fold(0.0, f64::max)
+}
+
+fn check(stepover: f64) {
+    let got = rotary_parallel(&bar(48), &params(stepover), &AxisControl { lead_deg: 0.0, lag_deg: 0.0, max_tilt_deg: None })
+        .expect("a laid bar takes passes");
+    let angles = cut_angles(&got);
+    let (empty, gap) = coverage(&angles);
+    eprintln!(
+        "stepover {stepover}: {} cutting moves on the wall, widest gap {gap:.1} deg, empty sectors {empty:?}, notes {:?}",
+        angles.len(),
+        got.notes
+    );
+    assert!(got.notes.iter().any(|n| n.starts_with("Rotary Parallel: the passes go all the way round")), "{:?}", got.notes);
+    assert!(
+        empty.is_empty(),
+        "stepover {stepover}: the passes leave sectors {empty:?} uncut (widest gap {gap:.1} deg; 270 is the bottom)"
+    );
+    // The two seams (0 and 180 degrees, where the half turned below
+    // meets the half planned from above) step no wider than the rings
+    // on the flank above them, and no ring there is cut twice: each
+    // pass at a seam carries fewer moves than two flank rings do (the
+    // median flank pass is one ring; a raster line carries many more).
+    let flank = passes_near(&angles, 150.0, 20.0);
+    let mut counts: Vec<usize> = flank.iter().map(|p| p.1).collect();
+    counts.sort_unstable();
+    let ring_moves = counts.get(counts.len() / 2).copied().unwrap_or(0);
+    for seam in [0.0, 180.0] {
+        let at = passes_near(&angles, seam, 20.0);
+        eprintln!("seam {seam}: passes {at:?}; flank {flank:?}");
+        assert!(
+            widest_step(&at) <= widest_step(&flank) + 0.5,
+            "seam {seam}: a step of {:.1} deg, the flank's widest is {:.1}",
+            widest_step(&at),
+            widest_step(&flank)
+        );
+        for (d, n) in &at {
+            assert!(*n < 2 * ring_moves, "seam {seam}: the pass at {d:.1} deg has {n} moves, a flank ring {ring_moves} - cut twice");
+        }
+    }
+    // No cutting move is emitted twice.
+    let feeds: Vec<_> = got.moves.iter().filter(|m| m.kind == MoveKind::Feed).collect();
+    for (i, m) in feeds.iter().enumerate() {
+        assert!(!feeds[..i].iter().any(|n| n.from == m.from && n.to == m.to), "a cutting move twice: {m:?}");
+    }
+}
+
+#[test]
+fn the_rotary_parallel_goes_all_the_way_round_a_laid_bar() {
+    check(0.8);
+}
+
+#[test]
+fn the_rotary_parallel_goes_all_the_way_round_at_a_fine_stepover() {
+    check(0.25);
+}
+
+
+
+/// The raster's and the rings' notes (what they refused, reported not
+/// cut) reach the Rotary Parallel path: the ladder run deep under the
+/// bar refuses a ring entry, and the path says so.
+#[test]
+fn the_rotary_parallel_keeps_the_ladder_notes() {
+    let p = Finish3DParams { bottom_z: -R - 2.0 * BALL, ..params(0.8) };
+    let got = rotary_parallel(&bar(48), &p, &AxisControl { lead_deg: 0.0, lag_deg: 0.0, max_tilt_deg: None })
+        .expect("a laid bar takes passes");
+    assert!(got.notes.iter().any(|n| n.starts_with("rings: ")), "{:?}", got.notes);
+}
+
+/// A Bottom over the axis keeps the cut to the upper arc, as before
+/// #2970: no ball touches the bar under that height, and the path does
+/// not say it goes all the way round. This is how a machine whose
+/// rotary travel cannot turn the part a full turn keeps to what it
+/// reaches.
+#[test]
+fn a_bottom_over_the_axis_keeps_the_cut_to_the_upper_arc() {
+    let p = Finish3DParams { bottom_z: 1.0, ..params(0.8) };
+    let got = rotary_parallel(&bar(48), &p, &AxisControl { lead_deg: 0.0, lag_deg: 0.0, max_tilt_deg: None })
+        .expect("a laid bar takes passes");
+    let cuts: Vec<_> = got.moves.iter().filter(|m| m.kind == MoveKind::Feed).collect();
+    assert!(cuts.len() > 20, "the upper arc is cut: {}", cuts.len());
+    for m in cuts {
+        let rho = (m.to.y * m.to.y + m.to.z * m.to.z).sqrt();
+        if rho < R + 0.1 {
+            // A tip on the bar is the contact: never under the Bottom.
+            assert!(m.to.z >= 1.0 - 0.05 - 1e-9, "a contact under the Bottom: {m:?}");
+        }
+    }
+    assert!(got.notes.iter().all(|n| !n.contains("all the way round")), "{:?}", got.notes);
+}
diff --git a/docs/decisions/2970-rotary-parallel-halves.md b/docs/decisions/2970-rotary-parallel-halves.md
new file mode 100644
index 000000000..7747e981e
--- /dev/null
+++ b/docs/decisions/2970-rotary-parallel-halves.md
@@ -0,0 +1,78 @@
+## #2970 - Rotary Parallel plans the bar in two halves
+
+**Cause (measured).** Rotary Parallel ran the 3-axis swarf raster once,
+in a frame that lays the rotary axis down with local z up. That raster
+finishes the bar from above only. On a laid bar of radius 3 with a 1 mm
+ball, 126 degrees of the turn stayed uncut, centred on the bottom, at a
+stepover of 0.8 mm and of 0.25 mm alike. Two stages lose the band:
+
+1. The ring ladder stops at `bottom_z`, read as a tip height in the laid
+   frame. With `bottom_z = -R` the last ring has its ball centre 30
+   degrees under the horizontal.
+2. With `bottom_z` lower, the rings stop 45 degrees under the
+   horizontal. `build_sups` flips each facet normal to the sky, so the
+   bottom quadrant counts as shallow (raster) ground. The raster takes
+   the top tangent and never reaches it, and the rings skip shallow-only
+   loops. On the example part (`bottom_z` 9.525 mm under the axis) stage
+   2 holds: about 90 degrees, a quarter of the turn.
+
+A third fault hid it: the path dropped the raster and ring notes on the
+default path (only the ramp's own notes survived).
+
+**Decided.** The rotary path plans the bar twice. Half A is the laid
+frame as before. Half B is the same frame turned half a turn about the
+axis. Each half keeps only the cut whose ball centre stands in its own
+upper half. Half B is carried back into A's frame by the same rigid half
+turn (a centre (x, y, z) of B is (x, -y, -z) of A). The seam: A keeps
+centres down to half a ball radius under the axis plane, and B keeps
+only centres strictly under A's lowest kept centre on each side (read
+over the turned surface, not round the end faces). So no pass is cut
+twice, and no seam step is wider than a ring step of the flank. Then the
+existing held-end clip, picked-face clip, radial relink and radial pose
+run as before. All base notes now reach the path.
+
+Stage 1 is moot after the fix: each half needs centres only down to the
+axis plane. Half A keeps its old ladder law (vertical tips not under
+Bottom, in the laid frame). Half B is held to Bottom where the radially
+posed ball touches the bar: the contact is not under Bottom (within the
+tolerance). So a Bottom at the bar's underside (the example: -0.375 in)
+cuts the full turn, and a Bottom above the axis keeps the cut to the
+upper arc, as before. A path that cuts under the axis carries the note
+"Rotary Parallel: the passes go all the way round the bar - ...".
+
+**Maintainer decisions (owner's standing word 2026-11-22: choose the
+recommended option while he sleeps), taken by the coordinator.**
+1. The example program and project are regenerated with the test's own
+   tool (`WRITE_GOLDEN=1`). Dropped: hand edits.
+2. `operations::rotary_parallel_generates_radial_axes_and_verifies_clean`
+   now reads the Bottom law for each half in its own frame, and it also
+   asserts that each 30-degree sector holds a pass. Dropped: keeping the
+   old one-frame law, which pinned the band.
+3. On a machine whose rotary travel cannot turn the tool under the bar
+   (`tilthead.mch`, B -120..120), a full-turn path is refused by the
+   machine check: axis, angle and travel are named, and nothing posts.
+   The way to the reachable arc is a Bottom above the axis (the existing
+   fixture keeps posting clean). Dropped: clipping the cut to the
+   machine's reach inside the generator (the generator does not know the
+   machine). A follow-up issue asks for an angular-range parameter.
+
+**Why.** A ball sphere clear of the model stays clear under a rigid
+rotation, and the radial pose keeps every ball centre. So each half is
+as safe as today's single run. The change stays in
+`crates/motion/src/multiaxis/rotary.rs` and its new child
+`rotary/halves.rs`. No shared finishing helper changes.
+
+**Dropped.**
+- The reporter's plan: classify with the unflipped normal in
+  `build_sups`. That function has 15+ callers (every 3D finishing
+  pattern), and the split would then depend on the mesh winding: an
+  inward-wound mesh would mark its top steep. Not allowed here.
+- A true radial drop-cutter for Rotary Parallel (passes spaced in angle,
+  not in local y). That is a new algorithm (effort:max). The two halves
+  reuse the proved 3-axis ladder.
+- More than two frames (quarters). Two halves are the least that covers
+  the turn; more frames add seams.
+
+**Cost to change later.** A radial drop-cutter would replace
+`rotary/halves.rs` and the second `swarf` call; nothing else depends on
+them. The planning time of Rotary Parallel is about twice what it was.
