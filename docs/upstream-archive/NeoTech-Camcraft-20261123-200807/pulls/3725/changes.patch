From 2df88e26270f1663358f8351f7ab672f3d5d5f3f Mon Sep 17 00:00:00 2001
From: tsoiks <tsoiks@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:34:23 +0100
Subject: [PATCH 2/3] feat(build): arch-generic appimage packaging

---
 scripts/package-appimage.sh | 22 ++++++++++++++--------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/scripts/package-appimage.sh b/scripts/package-appimage.sh
index 49481b14a..f76b39210 100755
--- a/scripts/package-appimage.sh
+++ b/scripts/package-appimage.sh
@@ -5,10 +5,16 @@ set -euo pipefail
 
 root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
 cd "$root"
-if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
-    echo "package-appimage: Linux x86_64 is required" >&2
-    exit 1
-fi
+arch=$(uname -m)
+case "$(uname -s):$arch" in
+    Linux:x86_64|Linux:aarch64) ;;
+    *)
+        echo "package-appimage: Linux x86_64 or aarch64 is required (got $(uname -s) $arch)" >&2
+        exit 1
+        ;;
+esac
+# On aarch64, point LINUXDEPLOY at linuxdeploy-aarch64.AppImage from the same
+# linuxdeploy release; the bundled appimagetool below then runs natively.
 linuxdeploy=${LINUXDEPLOY:-}
 if [[ -z $linuxdeploy || ! -x $linuxdeploy ]]; then
     echo "package-appimage: set LINUXDEPLOY to an executable linuxdeploy AppImage" >&2
@@ -78,12 +84,12 @@ if [[ ! -x $appimagetool ]]; then
     echo "package-appimage: pinned linuxdeploy has no bundled appimagetool" >&2
     exit 1
 fi
-ARCH=x86_64 "$appimagetool" "$appdir" \
-    "$dist/camcraft-$version-linux-x86_64.AppImage" --no-appstream
+ARCH="$arch" "$appimagetool" "$appdir" \
+    "$dist/camcraft-$version-linux-$arch.AppImage" --no-appstream
 after=$(sha256sum "$appdir/usr/bin/camcraft-ui" | awk '{print $1}')
 if [[ $before != "$after" ]]; then
     echo "package-appimage: appimagetool modified camcraft-ui; refusing broken image" >&2
     exit 1
 fi
-test -s "$dist/camcraft-$version-linux-x86_64.AppImage"
-echo "AppImage: $dist/camcraft-$version-linux-x86_64.AppImage"
+test -s "$dist/camcraft-$version-linux-$arch.AppImage"
+echo "AppImage: $dist/camcraft-$version-linux-$arch.AppImage"

From 24a281a06e644a1b7328f522a6d26dd36785bcf0 Mon Sep 17 00:00:00 2001
From: tsoiks <tsoiks@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:34:23 +0100
Subject: [PATCH 3/3] fix(build): patch flecs_ecs for aarch64 c_char

---
 Cargo.lock |  9 +++------
 Cargo.toml | 10 ++++++++++
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 2952df271..ebf11ad53 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1762,8 +1762,7 @@ dependencies = [
 [[package]]
 name = "flecs_ecs"
 version = "0.2.2"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "933ab0b8128b5046f73e3d3ce2e5fda35f7e442a4b295799ebc0ad0371fac56a"
+source = "git+https://github.com/Indra-db/Flecs-Rust?rev=e7464a8f2d681c6463169b46b20313ee4e337898#e7464a8f2d681c6463169b46b20313ee4e337898"
 dependencies = [
  "bitflags 2.13.2",
  "compact_str",
@@ -1777,8 +1776,7 @@ dependencies = [
 [[package]]
 name = "flecs_ecs_derive"
 version = "0.2.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "d34bf29a398f71f37df33f3f5aee3c6bf35dda641697168f19f9f1cb653593c4"
+source = "git+https://github.com/Indra-db/Flecs-Rust?rev=e7464a8f2d681c6463169b46b20313ee4e337898#e7464a8f2d681c6463169b46b20313ee4e337898"
 dependencies = [
  "proc-macro2",
  "quote",
@@ -1788,8 +1786,7 @@ dependencies = [
 [[package]]
 name = "flecs_ecs_sys"
 version = "0.2.1"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "417e54ea6e57e52834dbf99bf7f7b123e901b9373d94ba3c3b892759846552d6"
+source = "git+https://github.com/Indra-db/Flecs-Rust?rev=e7464a8f2d681c6463169b46b20313ee4e337898#e7464a8f2d681c6463169b46b20313ee4e337898"
 dependencies = [
  "bindgen",
  "cc",
diff --git a/Cargo.toml b/Cargo.toml
index e0b78d958..803196ac1 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -137,3 +137,13 @@ debug = "line-tables-only"
 [profile.dev.package."*"]
 opt-level = 1
 debug = false
+
+# aarch64 (any platform where c_char is unsigned): crates.io flecs_ecs 0.2.2
+# hardcodes one cast to `*const i8` in flecs_ecs/src/addons/module/world.rs, so
+# the crate only compiles where c_char == i8 (x86_64). The fix is merged upstream
+# (Indra-db/Flecs-Rust#286, `as *const _`) but unreleased on crates.io; upstream
+# still declares version = "0.2.2", so pinning the fix commit here satisfies the
+# `=0.2.2` pin above unchanged - same pattern as the old ruststep pin. Drop this
+# patch once a flecs_ecs release > 0.2.2 contains the fix.
+[patch.crates-io]
+flecs_ecs = { git = "https://github.com/Indra-db/Flecs-Rust", rev = "e7464a8f2d681c6463169b46b20313ee4e337898" }
