+fn waterjet_post_keeps_a_small_positive_feed_or_refuses_it() {
+    let stream = |f: u32| format!("WATERJET\nSECTION\nRapid X 0 Y 0 Z 0\nJET ON C0 OUTER\nFeed X 1000 Y 0 Z 0 F{f}\nJET OFF C0\nENDSECTION\n");
