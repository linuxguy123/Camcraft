    "node_id": "C_kwDOV1WsOtoAKGI3MDg2MGU0OWUzNTQ2MDU2YjFlODYxMDM2MzkwM2M2YWRmNTBkYTc",
    "commit": {
      "author": {
        "name": "Quintin Smits",
        "email": "qd.smits@gmail.com",
        "date": "2026-11-23T07:51:20Z"
