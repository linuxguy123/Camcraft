diff --git a/examples/catalog/3d/rough-finish/README.md b/examples/catalog/3d/rough-finish/README.md
new file mode 100644
index 000000000..3f8559143
--- /dev/null
+++ b/examples/catalog/3d/rough-finish/README.md
@@ -0,0 +1,49 @@
+# Rough and Finish (3D Pocket, 3D Finish Parallel and Waterline)
+
+A 50 x 50 x 8 mm clean-room aluminum plate with a spherical dome on top
+(36 mm base diameter, 10 mm high, top at `Z18`). The stock is a
+50 x 50 x 22 mm box, so 4 mm of material is above the dome.
+
+## What it shows
+
+1. **3D Pocket (`3D Pocket1`, `EM-0600-4FL`):** Roughs the stock down to the
+   plate top (`Z8`) in 2 mm levels, with a helical entry. It leaves 0.5 mm
+   of stock on the dome and the plate.
+2. **3D Finish, Parallel (`3D Finish Parallel`, `BN-0600`):** A raster of
+   parallel passes along +X (direction angle 0) with a 1.5 mm stepover and a
+   0.1 mm tolerance. The ball follows the dome and the plate top.
+3. **3D Finish, Waterline (`3D Finish Waterline`, `BN-0600`):** Constant-Z
+   loops around the dome. The step between the loops comes from the
+   0.1 mm tolerance and the 3 mm ball radius.
+
+## What to look at
+
+- The roughing levels stop above the dome by the stock to leave. The steps
+  that they leave on the dome are what the two finish passes remove.
+- The parallel passes are close on the flat top of the dome and far apart
+  on its steep sides. The waterline loops are the opposite: close on the
+  steep sides and far apart near the top. The two patterns together give
+  an even finish.
+- `cam.verify()` must report no finding before the post. The script stops
+  if it does.
+
+## Files
+
+- `model/gen_rough_finish_obj.py` — parametric watertight height-field
+  generator for the test solid.
+- `model/rough-finish.obj` — generated triangle mesh imported by
+  `build.camscript`.
+- `build.camscript` — headless script that builds `rough-finish.camproj`
+  and posts `rough-finish.nc` through CamCraft's undoable commands.
+- `rough-finish.camproj` — committed project with generated toolpaths.
+- `rough-finish.nc` — committed Fanuc NC program, verified byte for byte in
+  `crates/app/tests/example_catalog.rs`.
+
+## Rebuild and verify
+
+From the repository root:
+
+```sh
+cargo xtask catalog --case 3d/rough-finish
+cargo test -p camcraft-app --test example_catalog catalog_3d_rough_finish
+```
diff --git a/examples/catalog/3d/rough-finish/build.camscript b/examples/catalog/3d/rough-finish/build.camscript
new file mode 100644
index 000000000..e0babd951
--- /dev/null
+++ b/examples/catalog/3d/rough-finish/build.camscript
@@ -0,0 +1,80 @@
+// Example catalog case: 3d/rough-finish (#2866).
+// Builds rough-finish.camproj and posts rough-finish.nc headlessly through
+// CamCraft's undoable command verbs: a 3D Pocket roughs the dome, then two
+// 3D Finish operations (Parallel and Waterline) finish it.
+// Run with CWD = this case directory:
+//   camcraft-cli script build.camscript
+
+cam.import("model/rough-finish.obj", "rough-finish");
+
+cam.call("set_stock", {
+  box: { dx: 50.0, dy: 50.0, dz: 22.0 }
+});
+
+cam.call("add_tool", { catalog: "EM-0600-4FL", holder: "none" });
+cam.call("add_tool", { catalog: "BN-0600", holder: "none" });
+
+cam.call("add_operation", {
+  kind: "3D Pocket",
+  name: "3D Pocket1",
+  tool: "EM-0600-4FL",
+  source: "rough-finish",
+  params: {
+    stepover: 3.0,
+    stock_to_leave: 0.5,
+    clearance_z: { reference: "top_of_stock", offset: 25.0 },
+    top_z: { reference: "top_of_stock", offset: 0.0 },
+    bottom_z: { reference: "top_of_model", offset: -10.0 },
+    stepdown: 2.0,
+    feed: 1200.0,
+    plunge_feed: 300.0,
+    climb: true,
+    strategy: "auto",
+    entry: "helix",
+    helix_radius: 1.2
+  }
+});
+
+cam.call("add_operation", {
+  kind: "3D Finish",
+  name: "3D Finish Parallel",
+  tool: "BN-0600",
+  source: "rough-finish",
+  params: {
+    pattern: "parallel",
+    stepover: 1.5,
+    tolerance: 0.1,
+    clearance_z: { reference: "top_of_stock", offset: 25.0 },
+    top_z: { reference: "top_of_model", offset: 0.0 },
+    bottom_z: { reference: "top_of_model", offset: -10.0 },
+    feed: 1500.0,
+    plunge_feed: 300.0,
+    climb: true
+  }
+});
+
+cam.call("add_operation", {
+  kind: "3D Finish",
+  name: "3D Finish Waterline",
+  tool: "BN-0600",
+  source: "rough-finish",
+  params: {
+    pattern: "waterline",
+    tolerance: 0.1,
+    clearance_z: { reference: "top_of_stock", offset: 25.0 },
+    top_z: { reference: "top_of_model", offset: 0.0 },
+    bottom_z: { reference: "top_of_model", offset: -10.0 },
+    feed: 1500.0,
+    plunge_feed: 300.0,
+    climb: true
+  }
+});
+
+cam.generate();
+var verdict = cam.verify();
+if (!verdict.ok) {
+  throw new Error("catalog verify failed: " + JSON.stringify(verdict));
+}
+cam.save("rough-finish.camproj");
+cam.post({ to: "rough-finish.nc" });
+cam.report();
