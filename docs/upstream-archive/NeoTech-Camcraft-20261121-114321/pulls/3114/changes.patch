-    ContourParams {
-        tool_diameter: 10.0,
-        stock_to_leave: 0.0,
-        clearance_z: 15.0,
-        retract_z: 5.0,
-        top_z: 0.0,
-        bottom_z: -12.0,
-        stepdown: 3.0,
-        feed: 500.0,
-        plunge_feed: 100.0,
-        climb,
-        side: Side::Outside,
-        lead: Lead::Linear { length: 8.0 },
-        tolerance: 0.01,
-        tab_count,
-        tab_width: 3.0,
-        tab_height: 1.0,
-        entry: Entry3D::Plunge,
-        helix_radius: 1.0,
-        blend_turns: false,
-        links: Links::PLANAR,
-    }
-}
-
-/// The moves of each crossing pair, for the failure message.
-fn dump(t: &Toolpath, pairs: &[[usize; 2]]) -> String {
-    let mut s = String::new();
-    for i in pairs.iter().flatten() {
-        let m = &t.moves[*i];
-        s += &format!(
-            "\n#{i} {:?} ({:.3}, {:.3}, {:.3}) -> ({:.3}, {:.3}, {:.3})",
-            m.kind, m.from.x, m.from.y, m.from.z, m.to.x, m.to.y, m.to.z
-        );
