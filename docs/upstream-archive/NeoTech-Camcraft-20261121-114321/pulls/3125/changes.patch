diff --git a/crates/app/tests/first_traverse_posed.rs b/crates/app/tests/first_traverse_posed.rs
new file mode 100644
index 000000000..e7dcd7eb8
--- /dev/null
+++ b/crates/app/tests/first_traverse_posed.rs
@@ -0,0 +1,238 @@
+//! #3084: the first traverse over work that the machine's own
+//! work-turning rotaries can leave at any pose. The post sends Z, then
+//! X/Y, then the move with the rotary words, so the X/Y traverse runs
+//! with each work-turning rotary where the previous program left it.
+//!
+//! - Two rotaries turn the work (A and B on the table): a rotary kind
+//!   reads its stock on the sphere about the WCS origin, where the lines
+//!   meet. The laid square bar's stock corner stands 18.815 from it, so
+//!   a clearance of 12 (over the 9.899 of the one fitted axis) is held
+//!   by name; 20 passes.
+//! - The table tilts the work (A on the table, B in the head): a 5-axis
+//!   kind reads its stock swept a full turn about A, not in the part
+//!   frame. The dome's 40 x 40 x 12 stock turns up to 23.324, so a
+//!   clearance of 20 (over the block's top 12) is held; 25 passes.
+//! - A work-turning rotary that states no line refuses by name.
+//!
+//! Provenance: our own machine files and fixtures (the rotary suite's
+//! turned bar, the first-traverse suite's dome); the shop rule "never
+//! traverse through uncut stock or steel" (machine-tool handbooks). No
+//! vendor material.
+//!
+//! Gate map (#3084): covers app::operation (first_traverse_posed,
+//! generate, stamp), sim::verify (first_traverse_posed).
+
+mod common;
+
+use camcraft_app::commands::{AddTool, CreateOperation, GenerateOperation, History, ImportModel, LoadMachine, SetStock, SetWcsOrigin};
+use camcraft_app::geometry::{Mesh, Point3, Triangle, IDENTITY_Q};
+use camcraft_app::machine::parse_mch;
+use camcraft_app::operation::{Height, OpParams, OpStatus, SrcRef};
+use camcraft_app::schema::Location;
+use camcraft_app::stock::StockShape;
+use camcraft_app::tools::catalog;
+use camcraft_app::verify::Warning;
+use camcraft_app::{model, posting};
+use flecs_ecs::prelude::World;
+
+const BALL: &str = "BN-0600";
+
+/// Which rotaries turn the work.
+#[derive(Clone, Copy)]
+enum Rig {
+    /// A and B on the table: both turn the work.
+    TwoWork,
+    /// A on the table turns the work; B rides the head.
+    TableA,
+    /// A rotary Q on the table turns the work about no stated line; B
+    /// rides the head.
+    Unlined,
+}
+
+fn machine_text(rig: Rig) -> String {
+    let rot = |id: &str, name: &str, axis: &str, inner: &str| {
+        format!(r#"{{ "id": "{id}", "name": "{name}", "type": "rotary"{axis}, "travel": {{ "min": -120.0, "max": 120.0 }}{inner} }}"#)
+    };
+    let head = r#"{ "id": "hed", "name": "head", "type": "head", "spindle": { "min_speed": 50.0, "max_speed": 15000.0 } }"#;
+    let x = r#", "axis": [1.0, 0.0, 0.0]"#;
+    let y = r#", "axis": [0.0, 1.0, 0.0]"#;
+    let head_b = rot("rb", "B", y, &format!(r#", "parts": [ {head} ]"#));
+    let (z_parts, table) = match rig {
+        Rig::TwoWork => (head.to_string(), rot("ra", "A", x, &format!(r#", "parts": [ {} ]"#, rot("rb", "B", y, "")))),
+        Rig::TableA => (head_b, rot("ra", "A", x, "")),
+        Rig::Unlined => (head_b, rot("rq", "Q", "", "")),
+    };
+    let first = if matches!(rig, Rig::Unlined) { "Q" } else { "A" };
+    format!(
+        r#"{{
+  "general": {{ "model": "TEST POSED", "vendor": "Camcraft", "kind": "mill" }},
+  "kinematics": {{ "default": {{
+    "units": {{ "length": "mm", "angle": "degrees" }},
+    "parts": [
+      {{ "id": "base", "name": "table", "type": "table", "parts": [
+        {{ "id": "crl", "name": "X", "type": "linear", "travel": {{ "min": -200.0, "max": 200.0 }}, "parts": [
+          {{ "id": "sld", "name": "Y", "type": "linear", "travel": {{ "min": -200.0, "max": 200.0 }} }} ] }},
+        {{ "id": "col", "name": "Z", "type": "linear", "travel": {{ "min": -100.0, "max": 300.0 }}, "safe_retract": 0.0, "parts": [ {z_parts} ] }},
+        {table}
+      ] }}
+    ] }} }},
+  "controller": {{ "synced_configuration": {{ "parts": {{
+    "X": {{ "coordinate": 0 }}, "Y": {{ "coordinate": 1 }}, "Z": {{ "coordinate": 2 }},
+    "{first}": {{ "coordinate": 3 }}, "B": {{ "coordinate": 4 }}
+  }} }} }},
+  "tooling": {{ "number_of_tools": 24 }}
+}}"#
+    )
+}
+
+fn world_on(rig: Rig) -> (World, History) {
+    let world = camcraft_app::world::new_world();
+    let mut h = History::default();
+    let m = parse_mch(&machine_text(rig)).unwrap_or_else(|e| panic!("test machine: {e}"));
+    h.execute(&world, LoadMachine::new(&world, "test-posed.mch".into(), Some(m)).expect("machine"));
+    h.execute(&world, SetWcsOrigin::new(&world, Location { pos: Point3::ZERO, rot: IDENTITY_Q }).expect("G54 on the lines"));
+    let t = catalog().into_iter().find(|(n, _)| *n == BALL).map(|(_, t)| t).expect("catalog");
+    h.execute(&world, AddTool::new(&world, BALL, t).expect("tool"));
+    (world, h)
+}
+
+/// Generate "OP" from `src` and read its status and verdicts.
+fn generate(world: &World, h: &mut History, src: &str, p: OpParams) -> (OpStatus, Vec<Warning>) {
+    h.execute(world, CreateOperation::new(world, "OP", BALL, SrcRef::Entity(src.into()), p).expect("create"));
+    h.execute(world, GenerateOperation::new(world, "OP").expect("generate"));
+    let e = model::find_by_name(world, "OP").expect("op");
+    let cached = model::toolpath_of(world, &e).expect("cached path");
+    (camcraft_app::operation::status_of(world, &e), cached.warnings.clone())
+}
+
+fn first_low(warns: &[Warning]) -> Option<(f64, f64, bool)> {
+    warns.iter().find_map(|w| match *w {
+        Warning::FirstTraverseLow { height_mm, top_mm, fixture, .. } => Some((height_mm, top_mm, fixture)),
+        _ => None,
+    })
+}
+
+/// The rotary suite's turned bar laid along X in a 32 x 14 x 14 square
+/// bar of stock (x +-16, y +-7, z +-7), on the two-rotary table.
+fn laid_bar_on_two_rotaries(clearance: f64) -> (World, OpStatus, Vec<Warning>) {
+    let (world, mut h) = world_on(Rig::TwoWork);
+    let at = Location { pos: Point3::new(0.0, 0.0, -7.0), rot: IDENTITY_Q };
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 32.0, dy: 14.0, dz: 14.0 }, at).expect("stock"));
+    h.execute(&world, ImportModel::from_mesh("bar", Mesh::from_facets(common::rotary_bar::laid())));
+    let p = OpParams::RotaryParallel {
+        tolerance: 0.1,
+        stepover: Some(2.0),
+        clearance_z: Height::fixed(clearance),
+        retract_z: None,
+        top_z: Height::fixed(6.0),
+        bottom_z: Height::fixed(1.0),
+        feed: 500.0,
+        plunge_feed: 100.0,
+        climb: true,
+        lead_deg: 0.0,
+        lag_deg: 0.0,
+        max_tilt_deg: 60.0,
+    };
+    let (status, warns) = generate(&world, &mut h, "bar", p);
+    (world, status, warns)
+}
+
+#[test]
+fn two_work_turning_rotaries_read_the_rotary_kinds_stock_on_its_sphere() {
+    // The stock corner (16, 7, 7) from the WCS origin: sqrt(354).
+    let sphere = 354f64.sqrt();
+    let (world, status, warns) = laid_bar_on_two_rotaries(12.0);
+    assert_eq!(status, OpStatus::Ok);
+    let (height, top, fixture) = first_low(&warns).unwrap_or_else(|| panic!("clearance 12: no first-traverse verdict in {warns:?}"));
+    assert!((top - sphere).abs() < 1e-6 && !fixture, "the stock corner on the sphere: {top}, want {sphere}");
+    assert!((height - 12.0).abs() < 1e-6, "the post traverses at the clearance: {height}");
+    let n = warns.iter().filter(|w| matches!(w, Warning::FirstTraverseLow { .. })).count();
+    assert_eq!(n, 1, "one verdict names the highest top: {warns:?}");
+    assert!(warns.iter().any(Warning::blocks_post));
+    assert!(posting::post_setup_unwritten(&world).is_err(), "the program must not post");
+
+    let (_, status, warns) = laid_bar_on_two_rotaries(20.0);
+    assert_eq!(status, OpStatus::Ok);
+    assert_eq!(first_low(&warns), None, "clearance 20 stands over the sphere: {warns:?}");
+}
+
+/// A spherical cap (radius 12, to 60 degrees off the pole) on z = 0.
+fn dome() -> Mesh {
+    const TAU: f64 = std::f64::consts::TAU;
+    let (radius, polar_max, n_lat, n_lon) = (12.0, std::f64::consts::FRAC_PI_3, 6usize, 24usize);
+    let ring = |k: usize| -> Vec<Point3> {
+        let ph = polar_max * k as f64 / n_lat as f64;
+        let (z, rr) = (radius * ph.cos(), radius * ph.sin());
+        (0..n_lon).map(|j| Point3::new(rr * (TAU * j as f64 / n_lon as f64).cos(), rr * (TAU * j as f64 / n_lon as f64).sin(), z)).collect()
+    };
+    let apex = Point3::new(0.0, 0.0, radius);
+    let first = ring(1);
+    let mut f: Vec<Triangle> = (0..n_lon).map(|j| Triangle::new(apex, first[j], first[(j + 1) % n_lon])).collect();
+    for k in 1..n_lat {
+        let (a, b) = (ring(k), ring(k + 1));
+        for j in 0..n_lon {
+            let n = (j + 1) % n_lon;
+            f.push(Triangle::new(a[j], b[j], b[n]));
+            f.push(Triangle::new(a[j], b[n], a[n]));
+        }
+    }
+    Mesh::from_facets(f)
+}
+
+/// A 5-Axis Contour over the dome in a 40 x 40 x 12 block (x, y +-20,
+/// z 0..12) on `rig`.
+fn contour5d_on(rig: Rig, clearance: f64) -> Result<(World, OpStatus, Vec<Warning>), String> {
+    let (world, mut h) = world_on(rig);
+    let at = Location { pos: Point3::ZERO, rot: IDENTITY_Q };
+    h.execute(&world, SetStock::new(&world, StockShape::Box { dx: 40.0, dy: 40.0, dz: 12.0 }, at).expect("stock"));
+    h.execute(&world, ImportModel::from_mesh("dome", dome()));
+    let p = OpParams::Contour5D {
+        tolerance: 0.1,
+        clearance_z: Height::fixed(clearance),
+        retract_z: None,
+        top_z: Height::fixed(11.0),
+        bottom_z: Height::fixed(7.0),
+        feed: 500.0,
+        plunge_feed: 100.0,
+        climb: true,
+        lead_deg: 15.0,
+        lag_deg: 0.0,
+        max_tilt_deg: 60.0,
+        shank_avoid: false,
+    };
+    h.execute(&world, CreateOperation::new(&world, "OP", BALL, SrcRef::Entity("dome".into()), p).expect("create"));
+    let cmd = GenerateOperation::new(&world, "OP").map_err(|e| format!("{e:?}"))?;
+    h.execute(&world, cmd);
+    let e = model::find_by_name(&world, "OP").expect("op");
+    let cached = model::toolpath_of(&world, &e).ok_or_else(|| format!("no path: {:?}", camcraft_app::operation::status_of(&world, &e)))?;
+    let (status, warns) = (camcraft_app::operation::status_of(&world, &e), cached.warnings.clone());
+    Ok((world, status, warns))
+}
+
+#[test]
+fn a_tilting_table_reads_a_5_axis_kinds_stock_swept_about_its_line() {
+    // The stock's top edge (x, 20, 12) turns about A on radius sqrt(544);
+    // the part frame reads only the block's top, Z12.
+    let swept = 544f64.sqrt();
+    let (world, status, warns) = contour5d_on(Rig::TableA, 20.0).unwrap_or_else(|e| panic!("{e}"));
+    assert_eq!(status, OpStatus::Ok);
+    let (height, top, fixture) = first_low(&warns).unwrap_or_else(|| panic!("clearance 20: no first-traverse verdict in {warns:?}"));
+    assert!((top - swept).abs() < 1e-6 && !fixture, "the stock edge turned up: {top}, want {swept}");
+    assert!((height - 20.0).abs() < 1e-6, "{height}");
+    assert!(posting::post_setup_unwritten(&world).is_err(), "the program must not post");
+
+    let (_, status, warns) = contour5d_on(Rig::TableA, 25.0).unwrap_or_else(|e| panic!("{e}"));
+    assert_eq!(status, OpStatus::Ok);
+    assert_eq!(first_low(&warns), None, "clearance 25 stands over the swept stock: {warns:?}");
+}
+
+#[test]
+fn a_work_turning_rotary_with_no_line_refuses_by_name() {
+    let refused = match contour5d_on(Rig::Unlined, 25.0) {
+        Err(e) => e,
+        Ok((_, status, warns)) => panic!("no refusal: {status:?} {warns:?}"),
+    };
+    for text in ["work-turning rotary Q", "first traverse", "cannot be judged"] {
+        assert!(refused.contains(text), "{text}: {refused}");
+    }
+}
diff --git a/crates/sim/src/verify/first_traverse_posed.rs b/crates/sim/src/verify/first_traverse_posed.rs
new file mode 100644
index 000000000..b6486eec3
--- /dev/null
+++ b/crates/sim/src/verify/first_traverse_posed.rs
@@ -0,0 +1,167 @@
+//! #3084: the first traverse over work that the machine's own work-turning rotaries can leave at any pose (two rotaries that turn the work, or a multi-axis kind on a machine whose table tilts) - our own reading of the shop rule "never traverse through uncut stock or steel" (machine-tool handbooks) and plain rotation geometry, no vendor material consulted.
+//!
+//! After a tool change the post sends Z, then X/Y at that height, and
+//! the rotary words come only in the move after it. So the X/Y traverse
+//! runs with each work-turning rotary at the angle the previous program
+//! left, which this program does not know. The law reads the work, and
+//! the steel that rides it, through every such pose:
+//! - one work-turning rotary: a full turn about its line ([`PosedTurn::
+//!   Line`]); a point runs a circle about its foot on the line;
+//! - two or more: each turn moves the other's line, so the only figure
+//!   that every pose keeps is the distance from the point where the
+//!   lines meet ([`PosedTurn::About`]); a point stays on that sphere.
+//!
+//! A full turn and a full sphere contain every stated turning range,
+//! so the read is never lower than the true top. Heights are read along
+//! the frame's unit height `up` from `base` (`up = +Z`, `base = 0` for
+//! an upright path).
+
+use super::first_traverse::box_top;
+use super::types::Warning;
+use crate::fixture::FixtureBox;
+use crate::geometry::Point3;
+
+/// Where every pose of the work-turning rotaries keeps a point.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum PosedTurn {
+    /// One rotary turns the work about the line through `origin` along
+    /// `dir` (not unit: normalized here).
+    Line { origin: Point3, dir: [f64; 3] },
+    /// Two or more turn it; every line passes through `origin`.
+    About { origin: Point3 },
+}
+
+/// The work that turns, read in one frame: the start stock's and the
+/// part's points, and the tagged steel that rides the rotaries.
+#[derive(Clone, Copy, Debug)]
+pub struct PosedWork<'a> {
+    pub turn: PosedTurn,
+    pub rides: &'a [Point3],
+    pub steel: &'a [FixtureBox],
+}
+
+fn unit(v: [f64; 3]) -> Option<[f64; 3]> {
+    let n = (v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt();
+    (n.is_finite() && n > 1e-12).then(|| [v[0] / n, v[1] / n, v[2] / n])
+}
+
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn sub(a: Point3, b: Point3) -> [f64; 3] {
+    [a.x - b.x, a.y - b.y, a.z - b.z]
+}
+
+/// The highest height along unit `up` (from `base`) that `q` reaches in
+/// any pose of `turn`. A line circle's top stands `r * sqrt(1 - (up .
+/// d)^2)` over its foot; a sphere's top stands its radius over its
+/// centre. A line with no direction reads as the sphere (the wider set).
+#[must_use]
+pub fn posed_top(q: Point3, turn: &PosedTurn, up: [f64; 3], base: Point3) -> f64 {
+    let up = unit(up).unwrap_or([0.0, 0.0, 1.0]);
+    match *turn {
+        PosedTurn::Line { origin, dir } if unit(dir).is_some() => {
+            let d = unit(dir).unwrap_or([0.0, 0.0, 1.0]);
+            let w = sub(q, origin);
+            let along = dot(w, d);
+            let perp = [w[0] - along * d[0], w[1] - along * d[1], w[2] - along * d[2]];
+            let r = dot(perp, perp).sqrt();
+            let c = dot(up, d);
+            dot(sub(origin, base), up) + along * c + r * (1.0 - c * c).max(0.0).sqrt()
+        }
+        PosedTurn::Line { origin, .. } | PosedTurn::About { origin } => {
+            let w = sub(q, origin);
+            dot(sub(origin, base), up) + dot(w, w).sqrt()
+        }
+    }
+}
+
+/// The posed first-traverse law (#3084): the traverse runs at `height`
+/// (along `up` from `base`: the height the post sends before X/Y) over
+/// `work` read through every pose ([`posed_top`] of each point, and of
+/// each box corner: the distance to a point or a line is convex, so a
+/// box's top over all poses is at a corner). `None` when `height` stands
+/// at or over both tops within `z_tol`, or is not finite. A hit names
+/// the higher top, as [`Warning::FirstTraverseLow`] does.
+#[must_use]
+pub fn first_traverse_low_posed(height: f64, work: &PosedWork<'_>, up: [f64; 3], base: Point3, z_tol: f64) -> Option<Warning> {
+    if !height.is_finite() {
+        return None;
+    }
+    let top = |q: Point3| posed_top(q, &work.turn, up, base);
+    let finite_max = |it: &mut dyn Iterator<Item = f64>| it.filter(|z| z.is_finite()).fold(f64::NEG_INFINITY, f64::max);
+    let stock = finite_max(&mut work.rides.iter().map(|q| top(*q)));
+    let steel = finite_max(&mut work.steel.iter().map(|b| box_top(b, top)));
+    let (top, fixture) = if steel > stock { (steel, true) } else { (stock, false) };
+    (top.is_finite() && height < top - z_tol).then_some(Warning::FirstTraverseLow { at: 0, height_mm: height, top_mm: top, fixture })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const UP: [f64; 3] = [0.0, 0.0, 1.0];
+    const O: Point3 = Point3 { x: 0.0, y: 0.0, z: 0.0 };
+
+    /// A 100 x 100 x 50 block on a trunnion table, the lines through the
+    /// WCS origin at the table face's centre.
+    fn block() -> Vec<Point3> {
+        (0..8).map(|i| Point3::new([-50.0, 50.0][(i >> 2) & 1], [-50.0, 50.0][(i >> 1) & 1], [0.0, 50.0][i & 1])).collect()
+    }
+
+    #[test]
+    fn two_work_turning_rotaries_read_the_block_on_its_sphere() {
+        let about = PosedWork { turn: PosedTurn::About { origin: O }, rides: &block(), steel: &[] };
+        let r = (3.0f64 * 2500.0).sqrt();
+        // Upright the block's top is Z50: Z60 clears it. Tilted 90 deg
+        // with C turned, a top corner stands at its radius 86.603.
+        let Some(Warning::FirstTraverseLow { height_mm, top_mm, fixture: false, .. }) = first_traverse_low_posed(60.0, &about, UP, O, 1e-6) else {
+            panic!("a start under the sphere top must be named");
+        };
+        assert!((height_mm - 60.0).abs() < 1e-12 && (top_mm - r).abs() < 1e-9, "{top_mm}");
+        assert_eq!(first_traverse_low_posed(r + 0.01, &about, UP, O, 1e-6), None);
+        assert_eq!(first_traverse_low_posed(f64::NAN, &about, UP, O, 1e-6), None);
+    }
+
+    #[test]
+    fn one_tilting_table_reads_a_full_turn_about_its_line() {
+        let a = PosedTurn::Line { origin: O, dir: [3.0, 0.0, 0.0] };
+        // About X a corner (x, 50, 50) turns on radius 70.711.
+        let r = 50.0 * 2f64.sqrt();
+        assert!((posed_top(Point3::new(50.0, 50.0, 50.0), &a, UP, O) - r).abs() < 1e-12);
+        let work = PosedWork { turn: a, rides: &block(), steel: &[] };
+        assert!(first_traverse_low_posed(70.0, &work, UP, O, 1e-6).is_some());
+        assert_eq!(first_traverse_low_posed(71.0, &work, UP, O, 1e-6), None);
+        // A vertical line keeps every height; a line with no direction
+        // reads as the sphere.
+        let c = PosedTurn::Line { origin: O, dir: [0.0, 0.0, 1.0] };
+        assert_eq!(posed_top(Point3::new(50.0, 50.0, 50.0), &c, UP, O), 50.0);
+        let none = PosedTurn::Line { origin: O, dir: [0.0, 0.0, 0.0] };
+        assert!((posed_top(Point3::new(0.0, 30.0, 40.0), &none, UP, O) - 50.0).abs() < 1e-12);
+    }
+
+    #[test]
+    fn steel_that_rides_the_table_is_read_at_its_farthest_corner() {
+        let vise = FixtureBox { min: Point3::new(-80.0, -20.0, 0.0), max: Point3::new(-60.0, 20.0, 30.0) };
+        let work = PosedWork { turn: PosedTurn::About { origin: O }, rides: &[], steel: &[vise] };
+        let far = (80.0f64 * 80.0 + 20.0 * 20.0 + 30.0 * 30.0).sqrt();
+        let Some(Warning::FirstTraverseLow { top_mm, fixture: true, .. }) = first_traverse_low_posed(50.0, &work, UP, O, 1e-6) else {
+            panic!("the vise sweeps over Z50");
+        };
+        assert!((top_mm - far).abs() < 1e-9, "{top_mm}");
+    }
+
+    #[test]
+    fn a_tilted_frame_reads_its_heights_along_its_own_axis() {
+        // Heights along +X from x = 10: the sphere's top there is the
+        // centre's offset (-10) plus the radius.
+        let work = PosedWork { turn: PosedTurn::About { origin: O }, rides: &[Point3::new(0.0, 0.0, 40.0)], steel: &[] };
+        let base = Point3::new(10.0, 0.0, 0.0);
+        let Some(Warning::FirstTraverseLow { top_mm, .. }) = first_traverse_low_posed(20.0, &work, [2.0, 0.0, 0.0], base, 1e-6) else {
+            panic!("the sphere top along +X is 30");
+        };
+        assert!((top_mm - 30.0).abs() < 1e-12, "{top_mm}");
+        assert_eq!(first_traverse_low_posed(30.0, &work, [1.0, 0.0, 0.0], base, 1e-6), None);
+    }
+}
