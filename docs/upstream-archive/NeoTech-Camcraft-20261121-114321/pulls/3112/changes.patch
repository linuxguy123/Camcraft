@@ -0,0 +1,163 @@
+//! #3109: a flat Circular with several rings and a helix entry. The
+//! helix of each later ring must not touch the helix of the ring
+//! before it, so that the crossing law finds no pair.
+//!
+//! Provenance: our own tests over the kernel's helix entry (standard
+//! helical entry, RS-274 G2/G3) and the crossing law; no vendor
+//! material consulted.
+//!
+//! Gate map: covers camcraft_motion::machining2d (circular).
+
+use camcraft_motion::cl::{MoveKind, Toolpath};
+use camcraft_motion::entry::Entry3D;
+use camcraft_motion::geo2d::{Loop, Point2, Region};
+use camcraft_motion::links::Links;
+use camcraft_motion::machining2d::{CircularParams, circular};
+use camcraft_motion::verify::{Mode, ToolGeom, VerifyContext, Warning, crossed_pairs, verify};
+
+fn region(c: Point2) -> Region {
+    let sq = |x, y| Point2::new(c.x + x, c.y + y);
+    Region::new(vec![Loop::new(vec![sq(-12.0, -12.0), sq(12.0, -12.0), sq(12.0, 12.0), sq(-12.0, 12.0)]).unwrap()])
+        .unwrap()
+}
+
+/// The job of #2898 with the helix entry of #3109: R10, a Ø6 cutter,
+/// stepover 2, stepdown 2, Z20 to Z0, helix radius 1.
+fn params(center: Point2, climb: bool, stepover: f64, helix_radius: f64) -> CircularParams {
+    CircularParams {
+        links: Links::PLANAR,
+        center,
+        radius: 10.0,
+        vault: false,
+        bottom_z: 0.0,
+        top_z: 20.0,
+        tool_diameter: 6.0,
+        stock_to_leave: 0.0,
+        stepover,
+        stepdown: 2.0,
+        clearance_z: 30.0,
+        retract_z: None,
+        feed: 500.0,
+        plunge_feed: 250.0,
+        climb,
+        entry: Entry3D::Helix,
+        helix_radius,
+    }
+}
+
+fn path(p: &CircularParams) -> Toolpath {
+    circular(&region(p.center), p)
+        .unwrap_or_else(|e| panic!("stepover {} helix {} climb {}: {e:?}", p.stepover, p.helix_radius, p.climb))
+}
+
+/// The issue's repro: no feed pair crosses at a shared depth, in both
+/// directions and off the origin. Before #3109 the helix of ring k-1
+/// touched the helix of ring k at the start of ring k.
+#[test]
+fn a_multi_ring_helix_circular_has_no_crossing() {
+    for center in [Point2::new(0.0, 0.0), Point2::new(30.0, 30.0)] {
+        for climb in [true, false] {
+            for (stepover, helix) in [(2.0, 1.0), (1.0, 1.0), (2.0, 0.5), (1.0, 0.5), (0.5, 0.25)] {
+                let p = params(center, climb, stepover, helix);
+                let t = path(&p);
+                let pairs = crossed_pairs(&t, 0.01);
+                assert!(
+                    pairs.is_empty(),
+                    "center {center:?} climb {climb} stepover {stepover} helix {helix}: crossings {pairs:?}"
+                );
+            }
+        }
+    }
+}
+
+/// Where no start keeps the helices apart (orbits as wide as the
+/// cutter in a small circle), the ring is refused by name - never a
+/// program that verification blocks without a cause. Every other
+/// helix size still generates without a crossing.
+#[test]
+fn a_helix_that_cannot_stand_apart_is_refused_by_name() {
+    let c = Point2::new(30.0, 30.0);
+    for climb in [true, false] {
+        let p = params(c, climb, 3.0, 3.0);
+        match circular(&region(c), &p) {
+            Ok(t) => panic!("climb {climb}: generated with crossings {:?}", crossed_pairs(&t, 0.01)),
+            Err(e) => assert!(format!("{e:?}").contains("helix entry: the descent"), "climb {climb}: {e:?}"),
+        }
+        for (stepover, helix) in [(2.0, 1.5), (3.0, 1.0), (1.5, 2.0), (0.25, 0.1)] {
+            let p = params(c, climb, stepover, helix);
+            match circular(&region(c), &p) {
+                Ok(t) => assert!(crossed_pairs(&t, 0.01).is_empty(), "stepover {stepover} helix {helix}"),
+                Err(e) => assert!(format!("{e:?}").contains("helix entry: the descent"), "{stepover}/{helix}: {e:?}"),
+            }
+        }
+    }
+}
+
+/// Each ring still cuts its full circle: the path reaches every ring's
+/// radius at the floor, so the turn of the start changes no material.
+#[test]
+fn every_ring_still_reaches_the_floor() {
+    let c = Point2::new(30.0, 30.0);
+    let p = params(c, true, 2.0, 1.0);
+    let t = path(&p);
+    let rc = 10.0 - 3.0;
+    let mut k = 0;
+    loop {
+        let rho = rc - 2.0 * k as f64;
+        if rho <= 0.0 {
+            break;
+        }
+        let hit = t.moves.iter().any(|m| {
+            m.kind == MoveKind::Feed
+                && m.arc.is_some()
+                && m.from.z.abs() < 1e-9
+                && m.to.z.abs() < 1e-9
+                && ((m.to.x - c.x).hypot(m.to.y - c.y) - rho).abs() < 1e-6
+        });
+        assert!(hit, "ring {k} (radius {rho}) has no arc at the floor");
+        k += 1;
+    }
+}
+
+/// The whole verdict on the issue's job: the turned starts add no
+/// crossing, gouge or other warning of their own.
+#[test]
+fn the_issue_job_verifies_without_crossings() {
+    let c = Point2::new(0.0, 0.0);
+    let n = 512;
+    let disk: Vec<Point2> = (0..n)
+        .map(|k| {
+            let t = std::f64::consts::TAU * k as f64 / n as f64;
+            Point2::new(c.x + 10.0 * t.cos(), c.y + 10.0 * t.sin())
+        })
+        .collect();
+    let disk = Region::new(vec![Loop::new(disk).unwrap()]).unwrap();
+    let tool = ToolGeom {
+        radius: 3.0,
+        nose_radius: 0.0,
+        flute_len: 25.0,
+        shank_radius: 3.0,
+        shank_len: 10.0,
+        holder_radius: 15.0,
+        holder_len: 30.0,
+    };
+    for climb in [true, false] {
+        let p = params(c, climb, 2.0, 1.0);
+        let t = path(&p);
+        let cx = VerifyContext {
+            region: &disk,
+            tool: &tool,
+            mode: Mode::Area,
+            stock_top_z: p.top_z,
+            clearance_z: p.clearance_z,
+            gouge_tol: 0.01,
+            z_tol: 0.05,
+            ..VerifyContext::default()
+        };
+        // The rapids between rings through stock are #2898's (the ring
+        // links); they stood there before #3109 and are not read here.
+        let w: Vec<Warning> =
+            verify(&t, &cx).into_iter().filter(|x| !matches!(x, Warning::RapidInStock { .. })).collect();
+        assert!(w.is_empty(), "climb {climb}: {w:?}");
+    }
+}
diff --git a/docs/decisions/3109-circular-helix-stagger.md b/docs/decisions/3109-circular-helix-stagger.md
new file mode 100644
index 000000000..2310ddaf4
--- /dev/null
+++ b/docs/decisions/3109-circular-helix-stagger.md
@@ -0,0 +1,63 @@
+## #3109 - Circular: keep the helix entries of the rings apart
+
+**Decided.** A flat Circular with a helix entry (or a helix level
+transition) turns the start of each later ring to a vertex of that ring's
+own polygon. At that vertex, the predicted helix orbit keeps 0.01 mm from
+every helix orbit that the earlier rings flew. The prediction uses the
+same first rule as the descent: the first of the eight compass offsets
+whose disc the cutter-center disk holds. After each ring, the kernel reads
+the descents (feeds that change Z) that the ring really flew. It reads
+them with the crossing law itself (`verify::crossed_pairs`, at 0.01 mm and
+0.001 mm chords) against the earlier rings' descents whose box and band
+meet them. If a pair crosses, the kernel refuses the operation by name
+("helix entry: the descent at ... crosses the descent of an earlier
+ring ...").
+
+**Why.**
+- All rings of a flat Circular run the same level ladder. Thus the helix
+  of each ring at a level shares its depth band with the helix of each
+  other ring at that level, not only the ring before it.
+- A helix makes a full turn at least, so a clear orbit circle is a clear
+  helix. The circle test is a safe, cheap prediction.
+- The reading uses the law that verification uses. The refusal therefore
+  fires only where verification would block the post. A first version
+  read orbit circles only. It refused a table row that verifies clean
+  (`circular_arcs` repro): two half-turn arcs can share a band and still
+  miss the points where their circles meet.
+- The first ring, and any ring with no conflict, keeps vertex 0. Plunge
+  entry, ramp entry and the vault mode do not change. No golden file
+  moves.
+- A helix that has no clear start is refused by name. The issue permits
+  this outcome. Examples: a helix as wide as the cutter in a small circle,
+  and three rows of the `circular_arcs` table (helix radius 0.5, radius 4
+  and radius 6). Before this change, Crossing warnings held each of these
+  rows: 30, 154 and 350 warnings.
+
+**Dropped.**
+- The pocket's z-major order (tried on #2898): it removed the crossings,
+  but the inner rings then started with an axial plunge that no note
+  named. Four ramp-entry tests went red.
+- A refusal before generation for `stepover <= 2 * helix_radius`: it is
+  simple, but it refuses the common job of the issue (stepover 2, helix
+  radius 1). The stagger generates that job.
+- A trial generation of each candidate start on a copy of the path
+  builder: exact, but the copy grows with the path. The cost is quadratic
+  in the ring count.
+- A change to the crossing law: the law is a safety check under the
+  safety floor, and the issue does not ask for it.
+- The stagger in the vault mode: vault rings descend in separate bands,
+  so their helices do not share a depth.
+
+**Test change.** `crates/app/tests/circular_arcs.rs`: the three rows
+above now expect the named refusal. The radius 4 and 6 rows were also the
+table's gouge check. They are judged again with a plunge entry, and they
+must still gouge.
+
+**Cost to change later.** Low. The logic is in
+`crates/motion/src/machining2d/circular_helix.rs`. `circular.rs` calls
+it at two points: the start vertex before each ring, and the reading
+after it.
+
+**Also.** The test module of `circular.rs` moved to `circular_tests.rs`
+(the `#[path]` pattern of `multiaxis/`). This keeps `circular.rs` under
+the 400-line law.
