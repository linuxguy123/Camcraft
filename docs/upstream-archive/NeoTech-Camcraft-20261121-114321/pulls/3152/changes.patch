From 2c2b4bcbbbd6963a493456d796beae483a734711 Mon Sep 17 00:00:00 2001
From: NeoTech <andreas@roughedge.se>
Date: Sat, 21 Nov 2026 11:37:31 +0100
Subject: [PATCH] fix(test): run the wide-pocket parallel-lane test in the
 motion heavy lane

The debug run of wide_rectangular_pocket_is_cleared_by_parallel_lanes took
36-145 s on unchanged motion code and failed its 90 s wall-time budget on
the loaded post-merge runner. Mark it `heavy lane:` so that the release
tier and `gate heavy` run it with --ignored; keep its two pockets, its
shape asserts and its 90 s budget as a release guard. Add the light twin
`_light` (the 30x24 D6 pocket only, release). Record the decision in
docs/decisions/3141-parallel-lane-heavy.md.

Fixes #3141

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../motion/tests/adaptive_troch_parallel.rs   | 11 +++++-
 docs/decisions/3141-parallel-lane-heavy.md    | 35 +++++++++++++++++++
 2 files changed, 45 insertions(+), 1 deletion(-)
 create mode 100644 docs/decisions/3141-parallel-lane-heavy.md

diff --git a/crates/motion/tests/adaptive_troch_parallel.rs b/crates/motion/tests/adaptive_troch_parallel.rs
index 926f5973a..0fb22801a 100644
--- a/crates/motion/tests/adaptive_troch_parallel.rs
+++ b/crates/motion/tests/adaptive_troch_parallel.rs
@@ -7,7 +7,9 @@ mod fixtures;
 use fixtures::*;
 use camcraft_motion::machining2d::PocketParams;
 
+// #3141: 64-145 s in debug on a loaded runner, so the full case and its wall-time budget run in release only.
 #[test]
+#[ignore = "heavy lane: release --ignored (the 30x24 D6 and 44x36 D10 pockets and their 90 s budget; 36-145 s debug)"]
 fn wide_rectangular_pocket_is_cleared_by_parallel_lanes() {
     let started = std::time::Instant::now();
     let p = PocketParams { bottom_z: -3.0, ..params() };
@@ -15,7 +17,14 @@ fn wide_rectangular_pocket_is_cleared_by_parallel_lanes() {
     check_cleared("wide 30x24 D6", &r, &p);
     // A D10 tool needs a short side above 32.36 mm to keep parallel lanes.
     check_cleared("wide 44x36 D10", &rect(0.0, 0.0, 44.0, 36.0), &PocketParams { tool_diameter: 10.0, ..p });
-    assert!(started.elapsed().as_secs_f64() <= 90.0, "wide pocket debug fixture exceeds 90 seconds: {:?}", started.elapsed());
+    assert!(started.elapsed().as_secs_f64() <= 90.0, "wide pocket release fixture exceeds 90 seconds: {:?}", started.elapsed());
+}
+
+#[test]
+#[ignore = "light lane: the 30x24 D6 pocket of the full test only (release)"]
+fn wide_rectangular_pocket_is_cleared_by_parallel_lanes_light() {
+    let p = PocketParams { bottom_z: -3.0, ..params() };
+    check_cleared("wide 30x24 D6", &rect(0.0, 0.0, 30.0, 24.0), &p);
 }
 
 #[test]
diff --git a/docs/decisions/3141-parallel-lane-heavy.md b/docs/decisions/3141-parallel-lane-heavy.md
new file mode 100644
index 000000000..1286505cc
--- /dev/null
+++ b/docs/decisions/3141-parallel-lane-heavy.md
@@ -0,0 +1,35 @@
+## #3141 - Move the wide-pocket parallel-lane test to the motion heavy lane
+
+**What was decided.** Mark
+`wide_rectangular_pocket_is_cleared_by_parallel_lanes` in
+`crates/motion/tests/adaptive_troch_parallel.rs` with
+`#[ignore = "heavy lane: ..."]`. The release tier and `cargo xtask gate
+heavy` run it with `--ignored` in the step `motion heavy:
+adaptive_troch_parallel`. The test keeps its two pockets (30 x 24 mm D6 and
+44 x 36 mm D10), all its shape assertions and its 90-second budget. The
+budget is now a guard on the release run. Add the light twin
+`wide_rectangular_pocket_is_cleared_by_parallel_lanes_light`, which checks
+the 30 x 24 mm D6 pocket only, in release. This replaces the rule of
+decision #2990 "Apply this assertion in every run" for this test.
+
+**Why.** The debug test ran in 36, 64, 106, 140 and 145 seconds on
+unchanged motion code (#3116, #3141). The post-merge runner was loaded on
+the red runs. Wall time on a loaded runner is not a function of the code,
+so the debug budget made main red with no defect. AGENTS.md "Testing" says
+that a test above about 60 s in debug moves to the heavy lane. In release
+the same work is much faster, so the 90-second budget still catches a real
+slowdown of the planner. The light twin keeps one parallel-lane shape check
+at review and merge time. The `corner_cleanup_reduces_34x16_rest_to_at_most_hsm_rest`
+test stays in the default debug run.
+
+**Considered and dropped.**
+- A larger debug budget. Any number can fail on a loaded runner, and a
+  large number does not catch a slowdown.
+- A smaller fixture. Decision #2990 already measured the smaller D10
+  rectangles: a 38 x 33 mm pocket failed the rest-area assertion. A smaller
+  pocket weakens the case that a D10 tool needs a short side above 32.36 mm.
+- Removing the budget. It is the only guard on the planner time of this case.
+
+**Cost to change later.** The batch gate no longer runs the two wide-pocket
+checks in debug. If the planner becomes fast enough in debug, remove the
+ignore and keep the budget only with measured evidence from a loaded run.
