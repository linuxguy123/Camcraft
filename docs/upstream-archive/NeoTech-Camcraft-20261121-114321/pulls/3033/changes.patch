@@ -0,0 +1,196 @@
+//! #1944: compact MCP read modes keep a CAM job inside a model's context
+//! window. `get_job` with `summary` drops the machine definition and the
+//! operation fields that still hold their defaults; `list_operation_types`
+//! filters by kind or section; `list_features` with `compact` lists short
+//! rows under a chat-sized default limit; and `provider::tools_in` offers a
+//! core tool subset for small local models. Each reply fits a budget.
+//!
+//! Gate map (#1944): covers camcraft_app::mcp (compact, job, features,
+//! provider, tools).
+//!
+//! Provenance: our own fixtures (common::solid_part); no vendor material.
+
+mod common;
+
+use camcraft_app::geometry::Triangle;
+use camcraft_app::mcp::provider::{self, Provider, ToolSet};
+use camcraft_app::mcp::Server;
+use common::solid_part::{circle, plate, rect};
+use serde_json::{json, Value};
+
+fn call(s: &mut Server, id: i64, name: &str, args: Value) -> (bool, Value) {
+    let msg = json!({ "jsonrpc": "2.0", "id": id, "method": "tools/call", "params": { "name": name, "arguments": args } });
+    let reply = s.handle(&msg).expect("a request gets a response");
+    let result = &reply["result"];
+    let err = result["isError"] == json!(true);
+    (err, if err { result["content"][0]["text"].clone() } else { result["structuredContent"].clone() })
+}
+
+fn ok(s: &mut Server, id: i64, name: &str, args: Value) -> Value {
+    let (err, body) = call(s, id, name, args);
+    assert!(!err, "{name} refused: {body}");
+    body
+}
+
+fn chars(v: &Value) -> usize {
+    v.to_string().chars().count()
+}
+
+/// A 60 x 40 plate, z 0..10, with eight round holes: many faces and chains.
+fn write_plate_stl(dir: &std::path::Path) -> std::path::PathBuf {
+    let mut f: Vec<Triangle> = Vec::new();
+    plate(&rect(-30.0, -20.0, 30.0, 20.0), None, 0.0, 10.0, &mut f);
+    for i in 0..8 {
+        let x = -24.0 + 6.0 * f64::from(i);
+        plate(&circle((x, 0.0), 2.0, 24), None, 10.0, 12.0, &mut f);
+    }
+    let mut s = String::from("solid plate\n");
+    for t in &f {
+        s.push_str(" facet normal 0 0 0\n  outer loop\n");
+        for p in [t.a, t.b, t.c] {
+            s.push_str(&format!("   vertex {} {} {}\n", p.x, p.y, p.z));
+        }
+        s.push_str("  endloop\n endfacet\n");
+    }
+    s.push_str("endsolid plate\n");
+    let path = dir.join("plate.stl");
+    std::fs::write(&path, s).expect("write stl");
+    path
+}
+
+fn temp_dir(tag: &str) -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!("camcraft-1944-{tag}-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).expect("temp dir");
+    dir
+}
+
+/// A job with a machine, a stock, two tools and three operations.
+fn job(s: &mut Server) {
+    ok(s, 1, "load_machine", json!({ "builtin": "VMC 3-axis" }));
+    ok(s, 2, "set_stock", json!({ "box": { "dx": 60, "dy": 40, "dz": 10 } }));
+    ok(s, 3, "add_tool", json!({ "catalog": "EM-1000-4FL" }));
+    ok(s, 4, "add_tool", json!({ "catalog": "EM-0600-4FL" }));
+    ok(s, 5, "add_operation", json!({ "kind": "face", "tool": "EM-1000-4FL", "name": "F1" }));
+    ok(s, 6, "add_operation", json!({ "kind": "face", "tool": "EM-0600-4FL", "name": "F2", "params": { "stepover": 2.5 } }));
+    ok(s, 7, "add_operation", json!({ "kind": "pocket", "tool": "EM-0600-4FL", "name": "P1" }));
+}
+
+#[test]
+fn get_job_summary_drops_the_machine_definition_and_default_fields() {
+    let mut s = Server::new();
+    job(&mut s);
+    let full = ok(&mut s, 10, "get_job", json!({}));
+    let short = ok(&mut s, 11, "get_job", json!({ "summary": true }));
+
+    assert!(full["machine"]["definition"].is_object(), "the full job keeps the machine: {}", full["machine"]);
+    assert!(short["machine"].get("definition").is_none(), "{}", short["machine"]);
+    assert_eq!(short["machine"]["definition_omitted"], json!(true));
+    assert_eq!(short["summary"], json!(true));
+
+    // F2 changed its stepover: the summary keeps that field and drops the rest.
+    let ops = short["operations"].as_array().expect("operations");
+    assert_eq!(ops.len(), 3);
+    let f2 = ops.iter().find(|o| o["name"] == json!("F2")).expect("F2");
+    let changed = f2["params"]["face"].as_object().expect("face params");
+    assert_eq!(changed.get("stepover"), Some(&json!(2.5)), "{f2}");
+    assert!(changed.len() < 4, "only the changed fields remain: {f2}");
+    let full_f2 = full["operations"].as_array().and_then(|o| o.iter().find(|o| o["name"] == json!("F2"))).expect("F2");
+    assert!(full_f2["params"]["face"].as_object().map_or(0, |m| m.len()) > changed.len());
+
+    // No null rows outside params: a summary says only what is set.
+    assert!(f2.get("checks_against").is_none() && f2.get("needs_review").is_none(), "{f2}");
+
+    // The budget: the summary is at most two thirds of the full reply and fits 2500 characters.
+    assert!(chars(&short) * 3 <= chars(&full) * 2, "summary {} vs full {}", chars(&short), chars(&full));
+    assert!(chars(&short) <= 2_500, "summary is {} characters", chars(&short));
+}
+
+#[test]
+fn get_job_summary_refuses_a_non_boolean() {
+    let mut s = Server::new();
+    let (err, body) = call(&mut s, 1, "get_job", json!({ "summary": "yes" }));
+    assert!(err, "{body}");
+    assert!(body.as_str().is_some_and(|t| t.contains("\"summary\"")), "{body}");
+}
+
+#[test]
+fn list_operation_types_filters_by_kind_and_by_section() {
+    let mut s = Server::new();
+    let all = ok(&mut s, 1, "list_operation_types", json!({}));
+    let n_all = all["kinds"].as_array().map_or(0, Vec::len);
+
+    let face = ok(&mut s, 2, "list_operation_types", json!({ "kind": "face" }));
+    let kinds = face["kinds"].as_array().expect("kinds");
+    assert_eq!(kinds.len(), 1, "{face}");
+    assert_eq!(kinds[0]["key"], json!("face"));
+    let by_label = ok(&mut s, 3, "list_operation_types", json!({ "kind": "Face" }));
+    assert_eq!(by_label["kinds"], face["kinds"], "a label matches like a key");
+
+    let drilling = ok(&mut s, 4, "list_operation_types", json!({ "section": "drilling" }));
+    let rows = drilling["kinds"].as_array().expect("kinds");
+    assert!(!rows.is_empty() && rows.len() < n_all, "{} of {n_all}", rows.len());
+    assert!(rows.iter().all(|k| k["section"] == json!("Drilling")), "{drilling}");
+    assert!(rows.iter().any(|k| k["key"] == json!("drill")), "{drilling}");
+
+    // The budget: one kind fits 4000 characters; the whole table does not.
+    assert!(chars(&face) <= 4_000, "one kind is {} characters", chars(&face));
+    assert!(chars(&all) > 4_000);
+
+    let (err, body) = call(&mut s, 5, "list_operation_types", json!({ "kind": "laser" }));
+    assert!(err && body.as_str().is_some_and(|t| t.contains("laser")), "{body}");
+    let (err, body) = call(&mut s, 6, "list_operation_types", json!({ "section": "Sawing" }));
+    assert!(err && body.as_str().is_some_and(|t| t.contains("Mill2D")), "{body}");
+}
+
+#[test]
+fn list_features_compact_rows_are_short_and_the_default_limit_is_chat_sized() {
+    let dir = temp_dir("features");
+    let stl = write_plate_stl(&dir);
+    let mut s = Server::new();
+    ok(&mut s, 1, "import_model", json!({ "name": "plate", "path": stl.display().to_string() }));
+    let full = ok(&mut s, 2, "list_features", json!({ "model": "plate" }));
+    let short = ok(&mut s, 3, "list_features", json!({ "model": "plate", "compact": true }));
+    let _ = std::fs::remove_dir_all(&dir);
+
+    assert_eq!(short["compact"], json!(true));
+    let face = &short["faces"][0];
+    assert!(face["id"].is_string(), "{face}");
+    assert!(face.get("loops").is_none() && face.get("bounds").is_none(), "{face}");
+    assert!(face["loops_count"].is_number(), "{face}");
+    let chain = &short["chains"][0];
+    assert!(chain["id"].is_string() && chain.get("bounds").is_none(), "{chain}");
+    assert_eq!(short["faces_total"], full["faces_total"], "totals stay whole");
+
+    // The chat default: 25 rows per kind, and `truncated` says so.
+    let rows = short["chains"].as_array().map_or(0, Vec::len);
+    let total = short["chains_total"].as_u64().unwrap_or(0) as usize;
+    assert_eq!(rows, total.min(25), "{rows} of {total}");
+    assert!(total > 25, "the fixture has more chains than one compact page: {total}");
+    assert_eq!(short["truncated"], json!(true));
+
+    // The budget: the compact listing fits 12000 characters.
+    assert!(chars(&short) <= 12_000, "compact is {} characters", chars(&short));
+    assert!(chars(&short) * 2 < chars(&full), "compact {} vs full {}", chars(&short), chars(&full));
+}
+
+#[test]
+fn the_core_tool_set_is_a_small_subset_of_the_full_table() {
+    let full = provider::tools_in(Provider::Anthropic, ToolSet::Full);
+    let core = provider::tools_in(Provider::Anthropic, ToolSet::Core);
+    assert_eq!(full, provider::tools(Provider::Anthropic), "Full is today's table");
+    assert!((20..=25).contains(&core.len()), "core has {} tools", core.len());
+    let names: Vec<&str> = full.iter().filter_map(|t| t["name"].as_str()).collect();
+    for t in &core {
+        let name = t["name"].as_str().expect("name");
+        assert!(names.contains(&name), "{name} is not a live tool");
+    }
+    for must in ["get_job", "add_operation", "generate", "verify", "post", "undo"] {
+        assert!(core.iter().any(|t| t["name"] == json!(must)), "core lacks {must}");
+    }
+    // The budget: the core schemas are under a third of the full table.
+    let size = |v: &Vec<Value>| serde_json::to_string(v).map_or(0, |s| s.len());
+    assert!(size(&core) * 3 < size(&full), "core {} vs full {}", size(&core), size(&full));
+    // Gemini wraps its declarations: the core set does the same.
+    let gemini = provider::tools_in(Provider::Gemini, ToolSet::Core);
+    assert_eq!(gemini[0]["functionDeclarations"].as_array().map(Vec::len), Some(core.len()));
+}
diff --git a/crates/ui/src/egui_app/ai_chat/budget.rs b/crates/ui/src/egui_app/ai_chat/budget.rs
new file mode 100644
index 000000000..ee2e99c02
--- /dev/null
+++ b/crates/ui/src/egui_app/ai_chat/budget.rs
@@ -0,0 +1,200 @@
+//! Context budgets of the chat worker loop (#1944): a character cap on each
+//! tool reply with a truncation hint, a cap on attached viewport images, a
+//! cap on tool rounds, the core tool set for local models, and rolling
+//! history that keeps the latest `get_job` reply when it drops old turns.
+//! Provenance: our own limits over our own chat transcript; no vendor material involved.
+
+use camcraft_app::mcp::provider::ToolSet;
+use serde_json::{Value, json};
+
+use super::transport::{EndpointKind, TurnMessage};
+use super::turn::ChatTurn;
+use super::worker::ToolCardStatus;
+
+/// The most characters of one tool reply that go back to the model.
+pub(crate) const MAX_TOOL_REPLY_CHARS: usize = 12_000;
+/// The most viewport images that one request carries (the newest win).
+pub(crate) const MAX_IMAGES_PER_REQUEST: usize = 1;
+/// The most model rounds of one turn before it stops without an answer.
+pub(crate) const MAX_TOOL_ROUNDS: usize = 12;
+/// The most earlier turns that one request carries (the newest win).
+pub(crate) const MAX_PRIOR_TURNS: usize = 6;
+
+/// A local model gets the core tool set; a cloud model the whole table.
+#[must_use]
+pub(super) fn tool_set_for(kind: EndpointKind) -> ToolSet {
+    match kind {
+        EndpointKind::Local => ToolSet::Core,
+        EndpointKind::Cloud => ToolSet::Full,
+    }
+}
+
+/// Characters one `char` takes in a JSON string (the provider sends the
+/// tool result as serialized JSON text).
+fn json_width(c: char) -> usize {
+    match c {
+        '"' | '\\' | '\n' | '\r' | '\t' => 2,
+        c if (c as u32) < 0x20 => 6,
+        _ => 1,
+    }
+}
+
+/// The longest start of `text` whose JSON form is at most `max`
+/// characters (never a split character), and whether it was cut.
+fn head(text: &str, max: usize) -> (&str, bool) {
+    let mut used = 0usize;
+    for (at, c) in text.char_indices() {
+        used = used.saturating_add(json_width(c));
+        if used > max {
+            return (&text[..at], true);
+        }
+    }
+    (text, false)
+}
+
+/// `text` cut to `max` characters with a hint that says what to ask for.
+#[must_use]
+pub(super) fn cut_with_hint(text: &str, max: usize) -> String {
+    let (kept, cut) = head(text, max);
+    if !cut {
+        return text.to_owned();
+    }
+    format!(
+        "{kept}\n[truncated by the chat: {} of {} characters shown. Ask for less: \
+         get_job {{\"summary\":true}}, list_operation_types {{\"kind\":...}}, \
+         list_features {{\"compact\":true}}.]",
+        kept.chars().count(),
+        text.chars().count()
+    )
+}
+
+/// Cap one MCP tool result before it goes back to the model. A result
+/// over the cap becomes one text block (the structured copy is dropped)
+/// that ends with the truncation hint; the error flag stays.
+#[must_use]
+pub(super) fn cap_tool_reply(result: Value, text: String) -> (Value, String) {
+    if result.to_string().chars().count() <= MAX_TOOL_REPLY_CHARS {
+        return (result, text);
+    }
+    let cut = cut_with_hint(&text, MAX_TOOL_REPLY_CHARS);
+    let is_error = result.get("isError").and_then(Value::as_bool).unwrap_or(false);
+    (json!({ "content": [{ "type": "text", "text": cut }], "isError": is_error }), cut)
+}
+
+/// Keep the newest `MAX_IMAGES_PER_REQUEST` screenshots; drop the older ones.
+pub(super) fn cap_images(messages: &mut [TurnMessage]) {
+    let mut seen = 0usize;
+    for m in messages.iter_mut().rev() {
+        if m.screenshot.is_some() {
+            seen += 1;
+            if seen > MAX_IMAGES_PER_REQUEST {
+                m.screenshot = None;
+            }
+        }
+    }
+}
+
+/// The earlier turns that a request carries, and - when older turns were
+/// dropped - the latest successful `get_job` reply of all earlier turns,
+/// cut to the reply cap, so the model keeps the state of the job.
+#[must_use]
+pub(super) fn prior_window(prior: &[ChatTurn]) -> (&[ChatTurn], Option<String>) {
+    let skip = prior.len().saturating_sub(MAX_PRIOR_TURNS);
+    let kept = prior.get(skip..).unwrap_or(&[]);
+    if skip == 0 {
+        return (kept, None);
+    }
+    let job = prior
+        .iter()
+        .rev()
+        .flat_map(|t| t.tool_cards.iter().rev())
+        .find(|c| c.name == "get_job" && c.status == ToolCardStatus::Succeeded && !c.summary.is_empty())
+        .map(|c| {
+            format!(
+                "[Context: {skip} earlier turns were dropped. The latest get_job reply follows.]\n{}\n\n",
+                cut_with_hint(&c.summary, MAX_TOOL_REPLY_CHARS)
+            )
+        });
+    (kept, job)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::transport::ScreenshotAttachment;
+    use super::super::turn::build_turn_messages;
+    use super::super::worker::ToolCard;
+    use super::*;
+    use camcraft_app::commands::History;
+
+    fn shot() -> Option<ScreenshotAttachment> {
+        Some(ScreenshotAttachment { mime_type: "image/png".into(), data_base64: "AAAA".into() })
+    }
+
+    fn turn(id: u64, with_job: Option<&str>) -> ChatTurn {
+        let mut t = ChatTurn::running(id, format!("prompt {id}"), &History::default(), None, shot());
+        t.assistant_text = format!("answer {id}");
+        if let Some(text) = with_job {
+            t.tool_cards.push(ToolCard {
+                id: format!("c{id}"),
+                name: "get_job".into(),
+                arguments: json!({}),
+                status: ToolCardStatus::Succeeded,
+                summary: text.into(),
+            });
+        }
+        t
+    }
+
+    #[test]
+    fn a_cut_keeps_whole_characters_and_says_how_much_was_shown() {
+        let text = "é".repeat(30);
+        let cut = cut_with_hint(&text, 10);
+        assert!(cut.starts_with(&"é".repeat(10)));
+        assert!(cut.contains("10 of 30 characters shown"), "{cut}");
+        assert_eq!(cut_with_hint("short", 10), "short");
+    }
+
+    #[test]
+    fn a_small_reply_passes_and_a_long_one_is_one_capped_text_block() {
+        let small = json!({ "content": [{ "type": "text", "text": "ok" }], "structuredContent": {}, "isError": false });
+        assert_eq!(cap_tool_reply(small.clone(), "ok".into()).0, small);
+
+        let long = "x".repeat(MAX_TOOL_REPLY_CHARS * 3);
+        let big = json!({ "content": [{ "type": "text", "text": long }], "structuredContent": { "a": long }, "isError": true });
+        let (capped, text) = cap_tool_reply(big, long.clone());
+        assert!(capped.get("structuredContent").is_none());
+        assert_eq!(capped["isError"], json!(true));
+        assert_eq!(capped["content"][0]["text"], json!(text));
+        assert!(text.contains("truncated"));
+        assert!(capped.to_string().chars().count() < MAX_TOOL_REPLY_CHARS + 400);
+    }
+
+    #[test]
+    fn only_the_newest_image_goes_with_a_request() {
+        let prior = vec![turn(1, None), turn(2, None)];
+        let messages = build_turn_messages(&prior, "now", None, shot());
+        let images = messages.iter().filter(|m| m.screenshot.is_some()).count();
+        assert_eq!(images, MAX_IMAGES_PER_REQUEST);
+        assert!(messages.last().is_some_and(|m| m.screenshot.is_some()), "the current prompt keeps its image");
+    }
+
+    #[test]
+    fn old_turns_are_dropped_and_the_latest_get_job_reply_is_kept() {
+        let mut prior: Vec<ChatTurn> = (1..=MAX_PRIOR_TURNS as u64 + 3).map(|i| turn(i, None)).collect();
+        prior[0] = turn(1, Some("{\"old\":true}"));
+        prior[1] = turn(2, Some("{\"latest_job\":true}"));
+        let messages = build_turn_messages(&prior, "now", None, None);
+        // Each kept turn is a prompt and an answer; then the current prompt.
+        assert_eq!(messages.len(), MAX_PRIOR_TURNS * 2 + 1);
+        assert!(!messages.iter().any(|m| m.text.ends_with("prompt 1") || m.text == "answer 3"));
+        let first = &messages[0];
+        assert!(first.text.contains("latest_job"), "{}", first.text);
+        assert!(!first.text.contains("\"old\""));
+        assert!(first.text.ends_with(&format!("prompt {}", 4)), "{}", first.text);
+
+        // Few turns: nothing is dropped and no context note is added.
+        let few = build_turn_messages(&prior[..2], "now", None, None);
+        assert_eq!(few.len(), 5);
+        assert_eq!(few[0].text, "prompt 1");
+    }
+}
