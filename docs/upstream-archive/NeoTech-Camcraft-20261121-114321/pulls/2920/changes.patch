+fn sketch_chains_view(
+    w: &World,
+    name: &str,
+    sketch: &crate::schema::Sketch,
+    pose: &Location,
+    limit: usize,
+) -> (Vec<Value>, usize) {
+    let all: Vec<_> = sketch.data.chains().all().collect();
