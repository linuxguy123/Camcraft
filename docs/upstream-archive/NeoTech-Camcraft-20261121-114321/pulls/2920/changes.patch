diff --git a/crates/app/src/operation/contour_sketch.rs b/crates/app/src/operation/contour_sketch.rs
new file mode 100644
index 000000000..557d17fdf
--- /dev/null
+++ b/crates/app/src/operation/contour_sketch.rs
@@ -0,0 +1,299 @@
+//! #1864: 2D Contour resolution, open-chain safety checks, per-chain side/direction overrides,
+//! and XY-transformed toolpath generation for DXF sketch profiles.
+//!
+//! Provenance: clean-room 2D contouring over `geometry::sketch_chains`; closed loops honour per-chain
+//! `ChainSide` overrides or operation `Side` (`Auto` reads `ClosedChain::nesting` outer-vs-hole); open
+//! chains cut along centerline under `Side::Auto` and refuse any side/control compensation by name.
+
+use std::collections::HashSet;
+
+use flecs_ecs::prelude::World;
+
+use crate::cl::Toolpath;
+use crate::geo2d::{Loop, Point2, Region};
+use crate::geometry::sketch_chains::ChainId;
+use crate::machining2d::{self, ContourParams, GenError, Side};
+
+use super::contour_sketch_pick::collect_chains;
+pub(super) use super::contour_sketch_pick::sketch_z_range;
+use super::wcs_yaw::Rot2;
+use super::{AreaCtx, OpParams, SrcRef, apply_area_controls, stitch};
+
+#[derive(Clone, Debug)]
+pub(super) struct ResolvedSketchChain {
+    pub(super) chain_id: ChainId,
+    pub(super) label: String,
+    pub(super) closed: bool,
+    pub(super) pts: Vec<Point2>,
+    pub(super) parent: Option<ChainId>,
+    pub(super) eff_side: Option<Side>,
+    pub(super) eff_climb: bool,
+    pub(super) natural_auto: bool,
+    pub(super) open_side_err: Option<String>,
+    pub(super) auto_role_err: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct SketchContourPlan {
+    pub(super) items: Vec<ResolvedSketchChain>,
+    pub(super) region_loops: Vec<Loop>,
+    pub(super) notes: Vec<String>,
+}
+
+impl SketchContourPlan {
+    pub(super) fn rotate_xy(&mut self, rot: &Rot2) -> Result<(), GenError> {
+        for item in &mut self.items {
+            for p in &mut item.pts {
+                *p = rot.p2(*p);
+            }
+        }
+        self.region_loops = self
+            .region_loops
+            .iter()
+            .map(|l| rot.loop2(l))
+            .collect::<Result<Vec<_>, _>>()?;
+        Ok(())
+    }
+
+    pub(super) fn open_chains(&self) -> Vec<Vec<Point2>> {
+        self.items
+            .iter()
+            .filter(|i| !i.closed)
+            .map(|i| i.pts.clone())
+            .collect()
+    }
+
+    pub(super) fn region(&self) -> Result<Option<Region>, GenError> {
+        if self.region_loops.is_empty() {
+            Ok(None)
+        } else {
+            Ok(Some(Region::new(self.region_loops.clone())?))
+        }
+    }
+}
+
+/// True when `params` is a `2D Contour` and `src` names at least one DXF sketch profile.
+#[must_use]
+pub(crate) fn is_sketch_contour(world: &World, src: &SrcRef, params: &OpParams) -> bool {
+    matches!(params, OpParams::Contour { .. }) && !crate::sketch_model::source_profiles(world, src).is_empty()
+}
+
+pub(super) fn resolve_plan(
+    world: &World,
+    src: &SrcRef,
+    params: &OpParams,
+) -> Result<SketchContourPlan, GenError> {
+    let OpParams::Contour {
+        tolerance,
+        side,
+        climb,
+        chain_overrides,
+        ..
+    } = params
+    else {
+        return Err(GenError::Invalid("not a 2D Contour operation".into()));
+    };
+    let items = collect_chains(world, src, *tolerance, *side, *climb, chain_overrides)?;
+    let mut region_loops = Vec::new();
+    let mut closed_outer = 0usize;
+    let mut closed_inside = 0usize;
+    let mut open_count = 0usize;
+    for item in &items {
+        if item.closed {
+            region_loops.push(Loop::new(item.pts.clone())?);
+            match item.eff_side {
+                Some(Side::Inside) => closed_inside += 1,
+                _ => closed_outer += 1,
+            }
+        } else {
+            open_count += 1;
+        }
+    }
+    let mut notes = Vec::new();
+    if closed_outer + closed_inside > 0 || open_count > 0 {
+        notes.push(format!(
+            "DXF sketch contour: {closed_outer} outside, {closed_inside} inside, {open_count} open centerline"
+        ));
+    }
+    Ok(SketchContourPlan {
+        items,
+        region_loops,
+        notes,
+    })
+}
+
+fn validate_plan(plan: &SketchContourPlan, control_comp: bool, comp_name: &str) -> Result<(), GenError> {
+    for item in &plan.items {
+        if let Some(why) = &item.open_side_err {
+            return Err(GenError::Invalid(why.clone()));
+        }
+        if !item.closed && control_comp {
+            return Err(GenError::Invalid(format!(
+                "{comp_name} compensation does not ride open sketch chain {} - choose In computer",
+                item.label
+            )));
+        }
+        if item.closed
+            && item.eff_side.is_none()
+            && let Some(why) = &item.auto_role_err
+        {
+            return Err(GenError::Invalid(why.clone()));
+        }
+    }
+    Ok(())
+}
+
+/// Summary notes + early-door refusal for UI property pages (`selection_account` / `selection_memo`).
+pub(super) fn account(
+    world: &World,
+    src: &SrcRef,
+    params: &OpParams,
+) -> (Vec<String>, Option<String>, Option<bool>) {
+    match resolve_plan(world, src, params) {
+        Ok(plan) => {
+            let comp = params.links().is_some_and(|l| l.approach.compensation.in_control());
+            let label = params
+                .links()
+                .map(|l| l.approach.compensation.label())
+                .unwrap_or("Control");
+            let refusal = validate_plan(&plan, comp, label).err().map(|e| e.to_string());
+            let inside = uniform_inside(&plan);
+            (plan.notes, refusal, inside)
+        }
+        Err(e) => (Vec::new(), Some(e.to_string()), None),
+    }
+}
+
+fn uniform_inside(plan: &SketchContourPlan) -> Option<bool> {
+    let mut closed = plan.items.iter().filter(|i| i.closed);
+    let first = closed.next()?.eff_side?;
+    let all_same = closed.all(|i| i.eff_side == Some(first));
+    all_same.then_some(first == Side::Inside)
+}
+
+pub(super) fn auto_side(world: &World, src: &SrcRef, params: &OpParams) -> Option<bool> {
+    let plan = resolve_plan(world, src, params).ok()?;
+    uniform_inside(&plan)
+}
+
+/// True when all closed chains form an unmodified natural nesting (every Hole's parent is
+/// also present, same climb, and natural Auto sides). In that case one unified `Region::new`
+/// cuts holes Inside and outers Outside together in a single level-by-level contour pass.
+fn can_group_natural(closed: &[&ResolvedSketchChain], op_climb: bool) -> bool {
+    if closed.is_empty() {
+        return false;
+    }
+    let ids: HashSet<ChainId> = closed.iter().map(|c| c.chain_id).collect();
+    closed.iter().all(|c| {
+        c.natural_auto
+            && c.eff_climb == op_climb
+            && c.parent.is_none_or(|p| ids.contains(&p))
+    })
+}
+
+fn append_notes(dst: &mut Vec<String>, src: Vec<String>) {
+    for n in src {
+        if !dst.contains(&n) {
+            dst.push(n);
+        }
+    }
+}
+
+/// Generate the `2D Contour` toolpath for a validated `SketchContourPlan` and its verification region.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn generate_plan(
+    plan: SketchContourPlan,
+    cp: &ContourParams,
+    op_side: Side,
+    op_climb: bool,
+    mut area: Option<AreaCtx>,
+    d: f64,
+    comp_name: &str,
+    carried_top: &mut dyn FnMut(&Region, &Toolpath) -> Option<f64>,
+) -> Result<(Region, Toolpath, Option<f64>), GenError> {
+    let control_comp = cp.links.approach.compensation.in_control();
+    validate_plan(&plan, control_comp, comp_name)?;
+    if plan.region_loops.is_empty() && area.is_some() {
+        return Err(GenError::Invalid(
+            "the Boundary settings shape an area, and these picks are open sketch chains the cutter rides - reset them, or pick closed chains".into(),
+        ));
+    }
+
+    let closed_items: Vec<&ResolvedSketchChain> = plan.items.iter().filter(|i| i.closed).collect();
+    let verify_region = if plan.region_loops.is_empty() {
+        Region::empty()
+    } else {
+        Region::new(plan.region_loops.clone())?
+    };
+
+    let mut path = Toolpath::new(Vec::new());
+    let mut max_carried: Option<f64> = None;
+    append_notes(&mut path.notes, plan.notes.clone());
+
+    if !closed_items.is_empty() {
+        if can_group_natural(&closed_items, op_climb) {
+            let mut g_cp = *cp;
+            g_cp.side = Side::Outside;
+            g_cp.climb = op_climb;
+            let mut ctx = area.take();
+            if let Some(c) = &mut ctx {
+                c.contour_side(false);
+            }
+            let reg = apply_area_controls(verify_region.clone(), ctx.as_ref())?;
+            let mut sub = machining2d::contour(&reg, &g_cp)?;
+            if let Some(m) = carried_top(&super::top_stock::contour_reach(&reg, false, d), &sub) {
+                g_cp.links.approach.material_top = Some(m);
+                max_carried = Some(max_carried.map_or(m, |p| p.max(m)));
+                sub = machining2d::contour(&reg, &g_cp)?;
+            }
+            let notes = std::mem::take(&mut sub.notes);
+            path = if path.moves.is_empty() { sub } else { stitch(path, sub) };
+            append_notes(&mut path.notes, notes);
+        } else {
+            // Order holes (Inside or nested children) before outer chains so scraps are freed last.
+            let mut ordered = closed_items;
+            ordered.sort_by_key(|c| usize::from(c.eff_side != Some(Side::Inside)));
+            let area_ctx = area.take();
+            for item in ordered {
+                let eff_side = item.eff_side.unwrap_or(match op_side {
+                    Side::Inside => Side::Inside,
+                    _ => Side::Outside,
+                });
+                let single_raw = Region::new(vec![Loop::new(item.pts.clone())?])?;
+                let mut local_ctx = area_ctx.clone();
+                if let Some(c) = &mut local_ctx {
+                    c.contour_side(eff_side == Side::Inside);
+                }
+                let reg = apply_area_controls(single_raw, local_ctx.as_ref())?;
+                let mut c_cp = *cp;
+                c_cp.side = eff_side;
+                c_cp.climb = item.eff_climb;
+                let mut sub = machining2d::contour(&reg, &c_cp)?;
+                if let Some(m) = carried_top(
+                    &super::top_stock::contour_reach(&reg, eff_side == Side::Inside, d),
+                    &sub,
+                ) {
+                    c_cp.links.approach.material_top = Some(m);
+                    max_carried = Some(max_carried.map_or(m, |p| p.max(m)));
+                    sub = machining2d::contour(&reg, &c_cp)?;
+                }
+                let notes = std::mem::take(&mut sub.notes);
+                path = if path.moves.is_empty() { sub } else { stitch(path, sub) };
+                append_notes(&mut path.notes, notes);
+            }
+        }
+    }
+
+    for item in plan.items.iter().filter(|i| !i.closed) {
+        let mut o_cp = *cp;
+        o_cp.side = Side::Auto;
+        o_cp.climb = item.eff_climb;
+        let next = machining2d::contour_along_chain(&item.pts, &o_cp)
+            .map_err(|e| e.after_moves(&path.moves))?;
+        let notes = next.notes.clone();
+        path = if path.moves.is_empty() { next } else { stitch(path, next) };
+        append_notes(&mut path.notes, notes);
+    }
+
+    Ok((verify_region, path, max_carried))
+}
diff --git a/crates/app/src/operation/contour_sketch_pick.rs b/crates/app/src/operation/contour_sketch_pick.rs
new file mode 100644
index 000000000..abec65529
--- /dev/null
+++ b/crates/app/src/operation/contour_sketch_pick.rs
@@ -0,0 +1,286 @@
+//! #1864: Enumerate and resolve DXF sketch chains from `SrcRef` selections and compute
+//! sketch Z bounds and UI per-chain descriptors.
+//!
+//! Provenance: clean-room enumeration of `geometry::sketch_chains` entities mapped through
+//! `sketch::world_pose`; original CamCraft code, no vendor material consulted.
+
+use std::collections::HashSet;
+
+use flecs_ecs::prelude::World;
+
+use crate::geo2d::Point2;
+use crate::geometry::sketch_chains::{ChainId, LoopRole, SketchChainRef};
+use crate::geometry::{Point3, transform_point};
+use crate::machining2d::{GenError, Side};
+use crate::schema::Location;
+
+use super::contour_sketch::ResolvedSketchChain;
+use super::{ChainOverride, ChainSide, FeatureSel, GeoSel, SrcRef};
+
+/// Read-only UI descriptor for one cuttable chain in a contour operation's DXF source.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SketchChainInfo {
+    pub entity: String,
+    pub chain: ChainId,
+    pub label: String,
+    pub layer: String,
+    pub closed: bool,
+    /// Natural `Side::Auto` side (`Some(Outside | Inside)`) for unambiguous closed chains,
+    /// `None` for open chains or ambiguous closed chains.
+    pub auto_side: Option<Side>,
+}
+
+fn transform_chain_pts(pose: Location, pts: &[Point2]) -> Result<Vec<Point2>, GenError> {
+    let mut out = Vec::with_capacity(pts.len());
+    for p in pts {
+        let w = transform_point(Point3::new(p.x, p.y, 0.0), pose.pos, pose.rot);
+        if !(w.x.is_finite() && w.y.is_finite()) {
+            return Err(GenError::Invalid(
+                "the DXF profile transforms to non-finite coordinates".into(),
+            ));
+        }
+        out.push(Point2::new(w.x, w.y));
+    }
+    Ok(out)
+}
+
+/// (min_z, max_z) across every selected DXF sketch entity or chain in world space.
+pub(crate) fn sketch_z_range(
+    world: &World,
+    src: &SrcRef,
+) -> Option<Result<(f64, f64), &'static str>> {
+    let profiles = crate::sketch_model::source_profiles(world, src);
+    if profiles.is_empty() {
+        return None;
+    }
+    let mut lo = f64::INFINITY;
+    let mut hi = f64::NEG_INFINITY;
+    for name in profiles {
+        let Some((entity, sketch)) = crate::sketch::find(world, &name) else {
+            return Some(Err("the DXF profile is gone"));
+        };
+        let Some(pose) = crate::sketch::world_pose(world, &entity) else {
+            return Some(Err("the DXF profile has no stock to lie on - set up stock first"));
+        };
+        for chain in sketch.data.chains().all() {
+            for p in chain.sample(0.1) {
+                let w = transform_point(Point3::new(p.x, p.y, 0.0), pose.pos, pose.rot);
+                lo = lo.min(w.z);
+                hi = hi.max(w.z);
+            }
+        }
+    }
+    if lo.is_finite() && hi.is_finite() && lo <= hi {
+        Some(Ok((lo, hi)))
+    } else {
+        Some(Err("the DXF profile has no finite height"))
+    }
+}
+
+fn side_word(s: ChainSide) -> &'static str {
+    match s {
+        ChainSide::Inside => "Inside",
+        ChainSide::Outside => "Outside",
+    }
+}
+
+fn visit_src_chains(
+    world: &World,
+    src: &SrcRef,
+    mut f: impl FnMut(&str, Option<Location>, SketchChainRef<'_>, String) -> Result<(), GenError>,
+) -> Result<(), GenError> {
+    let mut seen: HashSet<(String, ChainId)> = HashSet::new();
+    let mut emit = |entity_name: &str,
+                    pose: Option<Location>,
+                    chain: SketchChainRef<'_>|
+     -> Result<(), GenError> {
+        let chain_id = chain.id();
+        if !seen.insert((entity_name.to_owned(), chain_id)) {
+            return Ok(());
+        }
+        let label = crate::pick::geo_label(
+            world,
+            &GeoSel {
+                entity: entity_name.to_owned(),
+                feature: FeatureSel::SketchChain(chain_id),
+            },
+        );
+        f(entity_name, pose, chain, label)
+    };
+
+    match src {
+        SrcRef::Entity(name) => {
+            let Some((entity, sketch)) = crate::sketch::find(world, name) else {
+                return Err(GenError::Invalid(format!("no DXF profile named '{name}'")));
+            };
+            let pose = crate::sketch::world_pose(world, &entity);
+            for chain in sketch.data.chains().all() {
+                emit(name, pose, chain)?;
+            }
+        }
+        SrcRef::Selection(items) => {
+            for g in items {
+                let Some((entity, sketch)) = crate::sketch::find(world, &g.entity) else {
+                    return Err(GenError::Invalid(format!(
+                        "the selection names '{}', which is not a DXF profile",
+                        g.entity
+                    )));
+                };
+                let pose = crate::sketch::world_pose(world, &entity);
+                let label = crate::pick::geo_label(world, g);
+                match &g.feature {
+                    FeatureSel::SketchChain(id) => {
+                        let Some(chain) = sketch.data.chains().find(*id) else {
+                            return Err(GenError::Invalid(format!(
+                                "{label} is no longer in DXF profile '{}' - re-pick it",
+                                g.entity
+                            )));
+                        };
+                        emit(&g.entity, pose, chain)?;
+                    }
+                    FeatureSel::SketchLayer(layer) => {
+                        if !sketch.data.layers().iter().any(|l| l == layer) {
+                            return Err(GenError::Invalid(format!(
+                                "layer '{layer}' is no longer in DXF profile '{}' - re-pick it",
+                                g.entity
+                            )));
+                        }
+                        for chain in sketch.data.chains().by_layer(layer) {
+                            emit(&g.entity, pose, chain)?;
+                        }
+                    }
+                    _ => {
+                        return Err(GenError::Invalid(format!(
+                            "{label}: '{}' is a DXF profile - pick a sketch chain or layer",
+                            g.entity
+                        )));
+                    }
+                }
+            }
+        }
+        SrcRef::Stock => {
+            return Err(GenError::Invalid("stock source is not a DXF profile".into()));
+        }
+    }
+    Ok(())
+}
+
+/// UI metadata list for every cuttable DXF sketch chain named by `src`.
+/// Returns an empty list if `src` names no placed DXF profiles or cannot be resolved cleanly.
+#[must_use]
+pub fn sketch_chain_infos(world: &World, src: &SrcRef) -> Vec<SketchChainInfo> {
+    if crate::sketch_model::source_profiles(world, src).is_empty() {
+        return Vec::new();
+    }
+    let mut infos = Vec::new();
+    let _ = visit_src_chains(world, src, |entity_name, _, chain, label| {
+        let auto_side = chain.nesting().and_then(|res| {
+            res.as_ref().ok().map(|n| match n.role {
+                LoopRole::Outer => Side::Outside,
+                LoopRole::Hole => Side::Inside,
+            })
+        });
+        infos.push(SketchChainInfo {
+            entity: entity_name.to_owned(),
+            chain: chain.id(),
+            label,
+            layer: chain.layer().to_owned(),
+            closed: chain.is_closed(),
+            auto_side,
+        });
+        Ok(())
+    });
+    infos
+}
+
+pub(super) fn collect_chains(
+    world: &World,
+    src: &SrcRef,
+    tolerance: f64,
+    op_side: Side,
+    op_climb: bool,
+    overrides: &[ChainOverride],
+) -> Result<Vec<ResolvedSketchChain>, GenError> {
+    let mut out: Vec<ResolvedSketchChain> = Vec::new();
+    visit_src_chains(world, src, |entity_name, pose_opt, chain, label| {
+        let Some(pose) = pose_opt else {
+            return Err(GenError::Invalid(format!(
+                "DXF profile '{entity_name}' has no stock to lie on - set up stock first"
+            )));
+        };
+        let chain_id = chain.id();
+        let closed = chain.is_closed();
+        let pts = transform_chain_pts(pose, &chain.sample(tolerance))?;
+        if (closed && pts.len() < 3) || (!closed && pts.len() < 2) {
+            return Err(GenError::Invalid(format!(
+                "{label} has too few points to machine"
+            )));
+        }
+        let ov = overrides
+            .iter()
+            .find(|o| o.entity == entity_name && o.chain == chain_id);
+        let eff_climb = op_climb ^ ov.is_some_and(|o| o.reverse);
+        let mut parent = None;
+        let mut eff_side = None;
+        let mut natural_auto = false;
+        let mut open_side_err = None;
+        let mut auto_role_err = None;
+        if !closed {
+            if let Some(s) = ov.and_then(|o| o.side) {
+                open_side_err = Some(format!(
+                    "{label} is an open sketch chain - per-chain {} side compensation is not allowed; clear its side override to cut along the centerline",
+                    side_word(s)
+                ));
+            } else if op_side != Side::Auto {
+                let word = if op_side == Side::Inside { "Inside" } else { "Outside" };
+                open_side_err = Some(format!(
+                    "{label} is an open sketch chain - {word} side compensation is not allowed on open chains; choose Side 'Auto' or pick closed chains"
+                ));
+            }
+        } else if let Some(s) = ov.and_then(|o| o.side) {
+            eff_side = Some(match s {
+                ChainSide::Inside => Side::Inside,
+                ChainSide::Outside => Side::Outside,
+            });
+        } else if op_side != Side::Auto {
+            eff_side = Some(op_side);
+        } else {
+            natural_auto = true;
+            if let Some(nest) = chain.nesting() {
+                match nest {
+                    Ok(n) => {
+                        parent = n.parent;
+                        eff_side = Some(match n.role {
+                            LoopRole::Outer => Side::Outside,
+                            LoopRole::Hole => Side::Inside,
+                        });
+                    }
+                    Err(e) => {
+                        auto_role_err = Some(format!(
+                            "{label}: cannot determine inside vs outside automatically ({e}) - set a per-chain side override"
+                        ));
+                    }
+                }
+            }
+        }
+        out.push(ResolvedSketchChain {
+            chain_id,
+            label,
+            closed,
+            pts,
+            parent,
+            eff_side,
+            eff_climb,
+            natural_auto,
+            open_side_err,
+            auto_role_err,
+        });
+        Ok(())
+    })?;
+    if out.is_empty() {
+        return Err(GenError::Empty(
+            "the DXF profile selection contains no cuttable closed or open chains".into(),
+        ));
+    }
+    Ok(out)
+}
