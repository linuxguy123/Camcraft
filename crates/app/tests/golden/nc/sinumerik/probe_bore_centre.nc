N580 MSG("PROBE NO CONTACT")
N590 SETAL(65000)
N600 M0
N610 ENDIF
N620 R56=$AA_MW[X]
N630 R57=$AA_MW[Y]
N640 R58=$AA_MW[Z]
N650 G91 G1 X0 Y-8 Z0 F300
N660 G90
N670 MEAS=1 G1 X30 Y17 Z15 F300
N680 IF $AC_MEA[1]==0
N690 MSG("PROBE NO CONTACT")
N700 SETAL(65000)
N710 M0
N720 ENDIF
N730 G91 G1 X0 Y1 Z0 F300
