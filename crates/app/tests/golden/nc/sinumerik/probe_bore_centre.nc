; CAMCRAFT
; OPERATION: Probe1 - G54
N10 G17 G90 G54 G40 G80
; T7 PROBE-4 - D4
N20 T7 D7 M6
N30 G0 X30 Y30 Z50
N40 MEAS=1 G1 X30 Y30 Z25 F300
N50 IF $AC_MEA[1]==1
N60 MSG("PROBE HIT ON POSITIONING")
N70 SETAL(65002)
N80 M0
N90 ENDIF
N100 MEAS=1 G1 X30 Y30 Z15 F300
N110 IF $AC_MEA[1]==1
N120 MSG("PROBE HIT ON POSITIONING")
N130 SETAL(65002)
N140 M0
N150 ENDIF
N160 MEAS=1 G1 X43 Y30 Z15 F300
N170 IF $AC_MEA[1]==0
N180 MSG("PROBE NO CONTACT")
N190 SETAL(65000)
N200 M0
N210 ENDIF
N220 G91 G1 X-1 Y0 Z0 F300
N230 G90
N240 MEAS=1 G1 X43 Y30 Z15 F30
N250 IF $AC_MEA[1]==0
N260 MSG("PROBE NO CONTACT")
N270 SETAL(65000)
N280 M0
N290 ENDIF
N300 R50=$AA_MW[X]
N310 R51=$AA_MW[Y]
N320 R52=$AA_MW[Z]
N330 G91 G1 X-8 Y0 Z0 F300
N340 G90
N350 MEAS=1 G1 X17 Y30 Z15 F300
N360 IF $AC_MEA[1]==0
N370 MSG("PROBE NO CONTACT")
N380 SETAL(65000)
N390 M0
N400 ENDIF
N410 G91 G1 X1 Y0 Z0 F300
N420 G90
N430 MEAS=1 G1 X17 Y30 Z15 F30
N440 IF $AC_MEA[1]==0
N450 MSG("PROBE NO CONTACT")
N460 SETAL(65000)
N470 M0
N480 ENDIF
N490 R53=$AA_MW[X]
N500 R54=$AA_MW[Y]
N510 R55=$AA_MW[Z]
N520 G91 G1 X8 Y0 Z0 F300
N530 G90
N540 MEAS=1 G1 X30 Y43 Z15 F300
N550 IF $AC_MEA[1]==0
N560 MSG("PROBE NO CONTACT")
N570 SETAL(65000)
N580 M0
N590 ENDIF
N600 G91 G1 X0 Y-1 Z0 F300
N610 G90
N620 MEAS=1 G1 X30 Y43 Z15 F30
N630 IF $AC_MEA[1]==0
N640 MSG("PROBE NO CONTACT")
N650 SETAL(65000)
N660 M0
N670 ENDIF
N680 R56=$AA_MW[X]
N690 R57=$AA_MW[Y]
N700 R58=$AA_MW[Z]
N710 G91 G1 X0 Y-8 Z0 F300
N720 G90
N730 MEAS=1 G1 X30 Y17 Z15 F300
N740 IF $AC_MEA[1]==0
N750 MSG("PROBE NO CONTACT")
N760 SETAL(65000)
N770 M0
N780 ENDIF
N790 G91 G1 X0 Y1 Z0 F300
N800 G90
N810 MEAS=1 G1 X30 Y17 Z15 F30
N820 IF $AC_MEA[1]==0
N830 MSG("PROBE NO CONTACT")
N840 SETAL(65000)
N850 M0
N860 ENDIF
N870 R59=$AA_MW[X]
N880 R60=$AA_MW[Y]
N890 R61=$AA_MW[Z]
N900 G91 G1 X0 Y8 Z0 F300
N910 G90
N920 MEAS=1 G1 X30 Y30 Z50 F300
N930 IF $AC_MEA[1]==1
N940 MSG("PROBE HIT ON POSITIONING")
N950 SETAL(65002)
N960 M0
N970 ENDIF
N980 R90=(R50+R53)/2-30
N990 IF ABS(R90)>0.5
N1000 MSG("PROBE X OUT OF TOLERANCE")
N1010 SETAL(65001)
N1020 M0
N1030 ENDIF
N1040 R91=(R57+R60)/2-30
N1050 IF ABS(R91)>0.5
N1060 MSG("PROBE Y OUT OF TOLERANCE")
N1070 SETAL(65001)
N1080 M0
N1090 ENDIF
N1100 $P_UIFR[2,X,TR]=$P_UIFR[1,X,TR]+R90
N1110 $P_UIFR[2,X,FI]=$P_UIFR[1,X,FI]
N1120 $P_UIFR[2,Y,TR]=$P_UIFR[1,Y,TR]+R91
N1130 $P_UIFR[2,Y,FI]=$P_UIFR[1,Y,FI]
N1140 G54
N1150 M5
N1160 G53 Z0
N1170 M2
